+.good-to-know {
+  margin-top: 33px;
+  padding: 25px 0;
+  border-top: 1px solid var(--line);
+  border-bottom: 1px solid var(--line);
+  display: grid;
+  grid-template-columns: 36% 1fr;
+  gap: 25px;
+}
+.good-to-know-title .small-label {
+  font-size: 7px;
+  letter-spacing: 1.5px;
+  color: #979a8c;
+}
+.good-to-know-title h3 {
