+}
+.name-label > span {
+  font-size: 9px;
+  font-weight: 400;
+  color: #9b9f92;
+  display: block;
+  text-align: right;
+}
+.dialog-buttons {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 25px;
+}
+.secondary-button {
+  color: #7e8672 !important;
+  background: white;
+  border: 1px solid #dce0d5;
+}
+.secondary-button:hover {
+  background: #f6f7f2;
+}
+.danger-button {
+  background: #9b5141;
+  border-color: #9b5141;
+}
+.danger-button:hover {
+  background: #824033;
+}
+.last-key-note {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 12px;
+  background: #f7f3e9;
+  border: 1px solid #eee5cf;
+  border-radius: 4px;
+  color: #9a8759;
+  font-size: 10px;
+  line-height: 1.7;
+}
