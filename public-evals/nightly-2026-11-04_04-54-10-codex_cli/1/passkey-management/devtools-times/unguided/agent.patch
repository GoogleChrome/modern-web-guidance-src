+  letter-spacing: -0.4px;
+  font-weight: 400;
+  margin: 9px 0 13px;
+}
+.passkey-dialog form > p:not(.eyebrow) {
+  font-size: 12px;
+  color: #828776;
+  line-height: 1.9;
+  margin: 0 0 23px;
+}
+.name-label {
+  display: block;
+  font-size: 11px;
+  font-weight: 550;
+  margin-top: 24px;
+}
+.name-label input {
+  display: block;
+  width: 100%;
+  border: 1px solid #d5dbcb;
+  border-radius: 4px;
+  padding: 12px;
+  margin: 9px 0 5px;
+  background: #fff;
