+}
+.good-to-know-title p {
+  font-size: 9px;
+  color: #979a8d;
+  line-height: 1.7;
+  margin: 0;
+}
+.faq-list details {
+  border-bottom: 1px solid var(--line);
+}
+.faq-list details:last-child {
+  border: 0;
+}
+.faq-list summary {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  font-size: 10px;
+  font-weight: 500;
+  cursor: pointer;
+  list-style: none;
+  padding: 16px 0;
+}
+.faq-list summary::-webkit-details-marker {
+  display: none;
+}
+.faq-list summary svg {
+  width: 13px;
+  height: 13px;
+  color: #8d9381;
+}
+.faq-list details[open] summary svg {
+  transform: rotate(45deg);
+}
+.faq-list details > p {
+  font-size: 10px;
+  color: #828979;
+  line-height: 1.8;
+  margin: 0 15px 17px 0;
+}
+.security-bottom {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 22px;
+  color: #a0a394;
+  font-size: 8px;
+}
+.security-bottom > svg {
+  width: 12px;
+  height: 12px;
+}
+.security-bottom p {
+  margin: 0;
+}
+.security-bottom a {
+  margin-left: auto;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: #828e73;
+}
+.security-bottom a svg {
+  width: 11px;
+  height: 11px;
+}
+.account-footer {
+  max-width: 1392px;
