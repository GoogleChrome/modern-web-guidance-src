diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..535377a
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,124 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { randomBytes } from "node:crypto";
+
+export type Reader = { username: string; userId: string };
+export type StoredPasskey = {
+  id: string;
+  username: string;
+  rpId: string;
+  name: string;
+  publicKey: string;
+  counter: number;
+  transports: string;
+  backedUp: number;
+  createdAt: string;
+  lastUsedAt: string | null;
+};
+
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = resolve(
+      process.env.PASSKEY_DATABASE_PATH || ".data/passkeys.sqlite",
+    );
+    mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode=WAL;
+      CREATE TABLE IF NOT EXISTS readers (username TEXT PRIMARY KEY, userId TEXT UNIQUE NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, username TEXT NOT NULL, rpId TEXT NOT NULL, name TEXT NOT NULL,
+        publicKey TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL,
+        backedUp INTEGER NOT NULL, createdAt TEXT NOT NULL, lastUsedAt TEXT
+      );`);
+  }
+  return database;
+}
+
+export function getReader(username: string): Reader {
+  db()
+    .prepare("INSERT OR IGNORE INTO readers VALUES (?, ?)")
+    .run(username, randomBytes(32).toString("base64url"));
+  return db()
+    .prepare("SELECT * FROM readers WHERE username = ?")
+    .get(username) as Reader;
+}
+export function listPasskeys(username: string, rpId: string) {
+  return db()
+    .prepare(
+      "SELECT * FROM passkeys WHERE username = ? AND rpId = ? ORDER BY createdAt DESC",
+    )
+    .all(username, rpId) as StoredPasskey[];
+}
+export function getPasskey(id: string, rpId: string) {
+  return db()
+    .prepare("SELECT * FROM passkeys WHERE id = ? AND rpId = ?")
+    .get(id, rpId) as StoredPasskey | undefined;
+}
+export function addPasskey(key: StoredPasskey) {
+  db()
+    .prepare("INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)")
+    .run(
+      key.id,
+      key.username,
+      key.rpId,
+      key.name,
+      key.publicKey,
+      key.counter,
+      key.transports,
+      key.backedUp,
+      key.createdAt,
+      key.lastUsedAt,
+    );
+}
+export function renamePasskey(
+  username: string,
+  rpId: string,
+  id: string,
+  name: string,
+) {
+  return db()
+    .prepare(
+      "UPDATE passkeys SET name = ? WHERE id = ? AND username = ? AND rpId = ?",
+    )
+    .run(name, id, username, rpId).changes;
+}
+export function removePasskey(username: string, rpId: string, id: string) {
+  return db()
+    .prepare("DELETE FROM passkeys WHERE id = ? AND username = ? AND rpId = ?")
+    .run(id, username, rpId).changes;
+}
+export function recordAuthentication(id: string, counter: number) {
+  db()
+    .prepare("UPDATE passkeys SET counter = ?, lastUsedAt = ? WHERE id = ?")
+    .run(counter, new Date().toISOString(), id);
+}
+export function publicPasskeys(username: string, rpId: string) {
+  return listPasskeys(username, rpId).map(
+    ({ id, name, backedUp, createdAt, lastUsedAt, transports }) => ({
+      id,
+      name,
+      backedUp: Boolean(backedUp),
+      createdAt,
+      lastUsedAt,
+      transports: JSON.parse(transports) as string[],
+    }),
+  );
+}
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+}
+export function sameOrigin(request: Request) {
+  return request.headers.get("origin") === new URL(request.url).origin;
+}
+export function relyingParty(request: Request) {
+  const origin = process.env.WEBAUTHN_ORIGIN || new URL(request.url).origin;
+  return { origin, rpId: new URL(origin).hostname };
+}
