+    { id: "newsletters", label: "Newsletters", icon: BellIcon },
+    { id: "reading", label: "Saved articles", icon: BookmarkIcon },
+  ];
+
+  return (
+    <div className="account-app">
+      <header className="account-header">
+        <div className="masthead-row">
+          <a className="back-to-news" href={baseUrl}>
+            <ArrowLeftIcon /> <span>Back to the news</span>
+          </a>
+          <a href={baseUrl} className="account-wordmark">
+            The DevTools Times<span>INDEPENDENT MINDS. INFORMED READERS.</span>
+          </a>
+          <a className="header-account" href={`${baseUrl}account/settings`}>
+            <span className="avatar">
+              {reader ? (
+                reader.username.slice(0, 1).toUpperCase()
+              ) : (
+                <UserCircleIcon />
+              )}
+            </span>
+            <span>My account</span>
+            <ChevronDownIcon />
+          </a>
+        </div>
+        <nav className="editorial-nav" aria-label="News sections">
+          {[
+            "Latest",
+            "World",
+            "Politics",
+            "Business",
+            "Science & Tech",
+            "Culture",
+            "Lifestyle",
+            "Sports",
+          ].map((item) => (
+            <a
+              key={item}
+              href={
+                item === "Latest"
+                  ? baseUrl
+                  : `${baseUrl}category/${encodeURIComponent(item === "Science & Tech" ? "science" : item.toLowerCase())}`
+              }
+            >
+              {item}
+            </a>
+          ))}
+          <span className="nav-edition">
+            <GlobeAltIcon /> U.S. edition
+          </span>
+        </nav>
+      </header>
+
+      <div className="account-shell">
+        <div className="account-breadcrumb">
+          <a href={baseUrl}>Home</a>
+          <ChevronRightIcon />
+          <span>My account</span>
+        </div>
+        <div className="account-title-row">
+          <div>
+            <p className="eyebrow">YOUR TIMES, YOUR WAY</p>
+            <h1>
+              Account settings<span>.</span>
+            </h1>
+            <p>
+              Make yourself at home. Manage your account and how you sign in.
+            </p>
+          </div>
+          <span className="private-label">
+            <LockClosedIcon /> PRIVATE & SECURE
+          </span>
+        </div>
+
+        <div className="account-columns">
+          <aside className="account-sidebar">
+            <div className="reader-card">
+              <span className="avatar reader-avatar">
+                {reader ? (
+                  reader.username.slice(0, 1).toUpperCase()
+                ) : (
+                  <UserCircleIcon />
+                )}
+              </span>
+              <div>
+                <strong>{reader?.username || "Your reader account"}</strong>
+                <span>
+                  {reader ? "Times reader" : "A little more personal."}
+                </span>
+              </div>
+            </div>
+            <button
+              className="mobile-settings-toggle"
+              onClick={() => setMobileMenu(!mobileMenu)}
