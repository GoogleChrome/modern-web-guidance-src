+.dialog-close svg {
+  width: 18px;
+  height: 18px;
+}
+.dialog-icon {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: #eef2e6;
+  color: #74895b;
+  border-radius: 12px;
+  width: 49px;
+  height: 49px;
+  margin: 0 0 23px;
+}
