+import { useEffect, useRef, useState } from "react";
+import { startRegistration } from "@simplewebauthn/browser";
+import {
+  ArrowLeftIcon,
+  ArrowRightIcon,
+  ArrowRightStartOnRectangleIcon,
+  Bars3Icon,
+  BellIcon,
+  BookmarkIcon,
+  CheckIcon,
+  CheckCircleIcon,
+  ChevronDownIcon,
+  ChevronRightIcon,
+  ComputerDesktopIcon,
+  DevicePhoneMobileIcon,
+  FingerPrintIcon,
+  GlobeAltIcon,
+  KeyIcon,
+  LockClosedIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  QuestionMarkCircleIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  UserCircleIcon,
+  XMarkIcon,
+} from "@heroicons/react/24/outline";
+
+type Passkey = {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  backedUp: boolean;
+  transports: string[];
+};
+type Reader = { username: string; userId: string };
+type AccountData = { reader: Reader; rpId: string; passkeys: Passkey[] };
+type Props = { reader?: Reader; baseUrl: string };
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+};
+const date = (value: string) =>
+  new Date(value).toLocaleDateString("en-US", {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+  });
+
+export default function AccountSettings({ reader, baseUrl }: Props) {
+  const [keys, setKeys] = useState<Passkey[]>([]);
+  const [loading, setLoading] = useState(Boolean(reader));
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [sync, setSync] = useState<
+    "idle" | "pending" | "sent" | "unsupported" | "failed"
+  >("idle");
+  const [modal, setModal] = useState<{
+    type: "rename" | "remove" | "add";
+    key?: Passkey;
+  } | null>(null);
+  const [name, setName] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [tab, setTab] = useState("security");
+  const [mobileMenu, setMobileMenu] = useState(false);
+  const [loadFailed, setLoadFailed] = useState(false);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const trigger = useRef<HTMLElement | null>(null);
+
+  async function request(path: string, options?: RequestInit) {
+    const response = await fetch(`${baseUrl}api/${path}`, {
+      ...options,
+      headers: { "Content-Type": "application/json", ...options?.headers },
+    });
+    const data = await response.json();
+    if (!response.ok)
+      throw new Error(data.error || "Something went wrong. Please try again.");
+    return data;
+  }
+
+  async function syncAuthenticator(data: AccountData) {
+    const api = window.PublicKeyCredential as unknown as SignalAPI | undefined;
+    if (!window.isSecureContext || !api?.signalAllAcceptedCredentials) {
+      setSync("unsupported");
+      return;
+    }
+    setSync("pending");
+    try {
+      await api.signalAllAcceptedCredentials({
+        rpId: data.rpId,
+        userId: data.reader.userId,
+        allAcceptedCredentialIds: data.passkeys.map((key) => key.id),
+      });
+      setSync("sent");
+    } catch {
+      setSync("failed");
+    }
+  }
+
+  async function load() {
+    setLoading(true);
+    setError("");
+    setLoadFailed(false);
+    try {
+      const data: AccountData = await request("passkeys");
+      setKeys(data.passkeys);
+      void syncAuthenticator(data);
+    } catch (err) {
+      setError((err as Error).message);
+      setLoadFailed(true);
+    } finally {
+      setLoading(false);
+    }
+  }
+  useEffect(() => {
+    if (reader) void load();
+  }, []);
+  useEffect(() => {
+    if (modal) dialog.current?.showModal();
+    else if (dialog.current?.open) dialog.current.close();
+  }, [modal]);
+
+  function open(type: "rename" | "remove" | "add", key?: Passkey) {
+    if (!reader) {
+      window.location.href = `${baseUrl}signin`;
+      return;
+    }
+    trigger.current = document.activeElement as HTMLElement;
+    setName(key?.name || "");
+    setError("");
+    setNotice("");
+    setModal({ type, key });
+  }
+  function close() {
