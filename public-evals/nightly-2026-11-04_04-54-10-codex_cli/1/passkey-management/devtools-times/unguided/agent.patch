diff --git a/src/pages/api/auth/passkey.ts b/src/pages/api/auth/passkey.ts
new file mode 100644
index 0000000..91cdc66
--- /dev/null
+++ b/src/pages/api/auth/passkey.ts
@@ -0,0 +1,66 @@
+import type { APIRoute } from "astro";
+import {
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import {
+  getPasskey,
+  getReader,
+  json,
+  recordAuthentication,
+  relyingParty,
+  sameOrigin,
+} from "../../../lib/passkeys";
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session)
+    return json({ error: "Sign-in is temporarily unavailable." }, 503);
+  const { origin, rpId } = relyingParty(request);
+  try {
+    const body = await request.json();
+    if (body.action === "options") {
+      const options = await generateAuthenticationOptions({
+        rpID: rpId,
+        userVerification: "required",
+      });
+      await session.set("authentication", {
+        challenge: options.challenge,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    const challenge = (await session.get("authentication")) as
+      { challenge: string; expires: number } | undefined;
+    await session.delete("authentication");
+    if (!challenge || challenge.expires < Date.now())
+      return json({ error: "The request expired. Please try again." }, 400);
+    const key = getPasskey(body.credential?.id, rpId);
+    if (!key)
+      return json({ error: "This passkey is no longer registered." }, 401);
+    const result = await verifyAuthenticationResponse({
+      response: body.credential,
+      expectedChallenge: challenge.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpId,
+      credential: {
+        id: key.id,
+        publicKey: new Uint8Array(Buffer.from(key.publicKey, "base64url")),
+        counter: key.counter,
+      },
+      requireUserVerification: true,
+    });
+    if (!result.verified)
+      return json({ error: "Unable to verify this passkey." }, 401);
+    recordAuthentication(key.id, result.authenticationInfo.newCounter);
+    await session.regenerate();
+    await session.set("reader", getReader(key.username));
+    return json({ success: true });
+  } catch {
+    return json(
+      { error: "Unable to sign in with this passkey. Please try again." },
+      400,
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..c2adf39
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,70 @@
+import type { APIRoute } from "astro";
+import {
+  json,
+  publicPasskeys,
+  relyingParty,
+  renamePasskey,
+  removePasskey,
+  sameOrigin,
+  type Reader,
+} from "../../../lib/passkeys";
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const reader = (await session?.get("reader")) as Reader | undefined;
+  if (!reader)
+    return json({ error: "Please sign in to manage your passkeys." }, 401);
+  const { rpId } = relyingParty(request);
+  return json({
+    reader,
+    rpId,
+    passkeys: publicPasskeys(reader.username, rpId),
+  });
+};
+
+const mutate: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  const reader = (await session?.get("reader")) as Reader | undefined;
+  if (!reader)
+    return json(
+      { error: "Your session has expired. Please sign in again." },
+      401,
+    );
+  try {
+    const { id, name } = await request.json();
+    if (typeof id !== "string")
+      return json({ error: "Select a passkey." }, 400);
+    const { rpId } = relyingParty(request);
+    if (
+      request.method === "PATCH" &&
+      (typeof name !== "string" || !name.trim() || name.trim().length > 64)
+    ) {
+      return json({ error: "Use a name between 1 and 64 characters." }, 400);
+    }
+    const changed =
+      request.method === "PATCH"
+        ? renamePasskey(reader.username, rpId, id, name.trim())
+        : removePasskey(reader.username, rpId, id);
+    if (!changed)
+      return json(
+        {
+          error:
+            "This passkey no longer exists. Refresh the list and try again.",
+        },
+        404,
+      );
+    // The complete, authoritative list is returned only after the database commit.
+    return json({
+      reader,
+      rpId,
+      passkeys: publicPasskeys(reader.username, rpId),
+    });
+  } catch {
+    return json(
+      { error: "The change could not be saved. Please try again." },
+      500,
+    );
+  }
+};
+export const PATCH = mutate;
+export const DELETE = mutate;
