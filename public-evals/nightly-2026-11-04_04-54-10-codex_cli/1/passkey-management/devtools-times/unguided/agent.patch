+          : modal.type === "rename"
+            ? "Passkey name updated."
+            : "Your new passkey is ready to use.",
+      );
+      // Friendly key labels are local metadata, not the authenticator's account display name.
+      if (modal.type !== "rename") void syncAuthenticator(data);
+      setModal(null);
+      trigger.current?.focus();
+    } catch (err) {
+      setError(
+        (err as Error).name === "NotAllowedError"
+          ? "The request was canceled or timed out. You can try again."
+          : (err as Error).message,
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function signOut() {
+    setBusy(true);
+    try {
+      await request("auth/logout", { method: "POST" });
+      window.location.href = `${baseUrl}signin`;
+    } catch (err) {
+      setError((err as Error).message);
+      setBusy(false);
+    }
+  }
