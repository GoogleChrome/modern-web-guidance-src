+          body: JSON.stringify({ credential, name: name.trim() }),
+        });
+      } else {
+        data = await request("passkeys", {
+          method: modal.type === "remove" ? "DELETE" : "PATCH",
+          body: JSON.stringify({ id: modal.key!.id, name: name.trim() }),
+        });
+      }
