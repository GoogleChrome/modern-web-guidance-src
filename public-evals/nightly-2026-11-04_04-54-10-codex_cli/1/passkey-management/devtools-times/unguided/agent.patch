@@ -0,0 +1,91 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from "@simplewebauthn/server";
+import {
+  addPasskey,
+  json,
+  listPasskeys,
+  publicPasskeys,
+  relyingParty,
+  sameOrigin,
+  type Reader,
+} from "../../../lib/passkeys";
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  const reader = (await session?.get("reader")) as Reader | undefined;
+  if (!reader || !session)
+    return json({ error: "Please sign in to add a passkey." }, 401);
+  const { origin, rpId } = relyingParty(request);
+  try {
+    const body = await request.json();
+    if (body.action === "options") {
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID: rpId,
+        userName: reader.username,
+        userID: new Uint8Array(Buffer.from(reader.userId, "base64url")),
+        attestationType: "none",
+        authenticatorSelection: {
+          residentKey: "required",
+          userVerification: "required",
+        },
+        excludeCredentials: listPasskeys(reader.username, rpId).map((key) => ({
+          id: key.id,
+        })),
+      });
+      await session.set("registration", {
+        challenge: options.challenge,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    const challenge = (await session.get("registration")) as
+      { challenge: string; expires: number } | undefined;
+    await session.delete("registration");
+    if (!challenge || challenge.expires < Date.now())
+      return json({ error: "The request expired. Please try again." }, 400);
+    if (
+      typeof body.name !== "string" ||
+      !body.name.trim() ||
+      body.name.trim().length > 64
+    ) {
+      return json({ error: "Use a name between 1 and 64 characters." }, 400);
+    }
+    const result = await verifyRegistrationResponse({
+      response: body.credential,
+      expectedChallenge: challenge.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpId,
+      requireUserVerification: true,
+    });
+    if (!result.verified)
+      return json({ error: "The passkey could not be verified." }, 400);
+    const { credential, credentialBackedUp } = result.registrationInfo;
+    addPasskey({
+      id: credential.id,
+      username: reader.username,
+      rpId,
+      name: body.name.trim(),
+      publicKey: Buffer.from(credential.publicKey).toString("base64url"),
+      counter: credential.counter,
+      transports: JSON.stringify(credential.transports || []),
+      backedUp: Number(credentialBackedUp),
+      createdAt: new Date().toISOString(),
+      lastUsedAt: null,
+    });
+    return json({
+      reader,
+      rpId,
+      passkeys: publicPasskeys(reader.username, rpId),
+    });
+  } catch {
+    return json(
+      { error: "Unable to register this passkey. Please try again." },
+      400,
+    );
+  }
+};
