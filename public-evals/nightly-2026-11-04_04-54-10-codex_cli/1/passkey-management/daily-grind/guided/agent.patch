@@ -0,0 +1,273 @@
+import { createRepository, syncAcceptedCredentials, validateName, providerName } from './passkeys.mjs';
+
+const $ = id => document.getElementById(id);
+const config = window.DAILY_GRIND_ACCOUNT || {};
+let storage;
+try { storage = window.localStorage; } catch { /* Storage may be blocked; use memory. */ }
+let repository;
+let snapshot;
+let activeId;
+let busy = false;
+let toastTimer;
+const formatDate = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('class', 'icon');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS(svg.namespaceURI, 'use');
+  use.setAttribute('href', `#i-${name}`);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function notify(message) {
+  clearTimeout(toastTimer);
+  $('toast').textContent = message;
+  toastTimer = setTimeout(() => { $('toast').textContent = ''; }, 6500);
+}
+function error(id, message) {
+  $(id).textContent = message;
+  $(id).hidden = !message;
+}
+function dateLabel(epoch) {
+  if (epoch == null) return 'Not used yet';
+  const day = new Date(epoch).toDateString();
+  if (day === new Date().toDateString()) return 'Today';
+  if (day === new Date(Date.now() - 86400000).toDateString()) return 'Yesterday';
+  return formatDate.format(epoch);
+}
+function render() {
+  const list = $('passkey-list');
+  const focused = document.activeElement;
+  const focusId = focused?.dataset.credentialId;
+  const focusAction = focused?.dataset.action;
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+  $('passkey-count').textContent = snapshot.credentials.length;
+  $('demo-label').hidden = !repository.demo;
+  $('profile-name').textContent = snapshot.user.displayName;
+  $('detail-name').textContent = snapshot.user.displayName;
+  $('avatar').textContent = snapshot.user.displayName.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join('').toUpperCase();
+  if (!repository.demo) {
+    $('profile-caption').textContent = 'Your Daily Grind account';
+    $('detail-account').textContent = snapshot.user.name || 'Signed in';
+    $('sign-out').hidden = true;
+  }
+  const latest = Math.max(...snapshot.credentials.map(item => item.lastUsedAt || 0));
+  for (const credential of snapshot.credentials) {
+    const row = element('li', 'passkey-row');
+    const device = element('span', 'device-icon');
+    device.append(icon(['laptop', 'phone', 'usb'].includes(credential.kind) ? credential.kind : 'key'));
+    const details = element('div', 'device-details');
+    const title = element('div', 'device-title');
+    title.append(element('h5', '', credential.name || 'Unnamed passkey'));
+    if (credential.lastUsedAt && credential.lastUsedAt === latest) {
+      const tag = element('span', 'recent-tag');
+      tag.append(element('span', 'small-dot'), document.createTextNode('Most recently used'));
+      title.append(tag);
+    }
+    const dates = element('p', 'device-dates');
+    dates.append(element('span', '', `Added ${formatDate.format(credential.registeredAt)}`),
+      element('span', '', credential.lastUsedAt == null ? 'Not used yet' : `Last used ${dateLabel(credential.lastUsedAt)}`));
+    details.append(title, element('p', 'device-provider', providerName(credential)), dates);
+    const actions = element('div', 'row-actions');
+    const rename = element('button', 'rename-button');
+    rename.type = 'button';
+    rename.dataset.action = 'rename';
+    rename.dataset.credentialId = credential.id;
+    rename.setAttribute('aria-label', `Rename ${credential.name}`);
+    rename.append(icon('edit'), document.createTextNode('Rename'));
+    const remove = element('button', 'remove-button');
+    remove.type = 'button';
+    remove.dataset.action = 'delete';
+    remove.dataset.credentialId = credential.id;
+    remove.setAttribute('aria-label', `Remove ${credential.name}`);
+    remove.append(icon('trash'));
+    actions.append(rename, remove);
+    row.append(device, details, actions);
+    list.append(row);
+  }
+  if (!snapshot.credentials.length) {
+    const empty = element('li', 'empty-state');
+    empty.append(icon('key'), element('strong', '', 'A fresh start for your sign-in.'),
+      element('span', '', 'No passkeys are registered to this account. Use your other sign-in method.'));
+    if (repository.demo) {
+      const reset = element('button', 'text-button', 'Restore sample passkeys');
+      reset.dataset.action = 'reset';
+      empty.append(document.createElement('br'), reset);
+    }
+    list.append(empty);
+  }
+  // If a list refresh replaces a focused row, retain the corresponding action.
+  if (focusId) {
+    const replacement = [...list.querySelectorAll('button')].find(button => button.dataset.credentialId === focusId && button.dataset.action === focusAction);
+    (replacement || list.querySelector('button') || $('page-title')).focus();
+  }
+}
+
+async function synchronize() {
+  if (!snapshot || !repository) return;
+  $('sync-retry').hidden = true;
+  const status = await syncAcceptedCredentials(snapshot, {
+    demo: repository.demo, credentialAPI: window.PublicKeyCredential, secureContext: window.isSecureContext,
+  });
+  const messages = {
+    demo: repository.persistent ? 'Sample passkeys only. Changes are saved in this browser; your real passkeys stay untouched.' : 'Sample passkeys only. Changes last for this visit; your real passkeys stay untouched.',
+    synced: 'Your browser has been notified of the passkeys accepted by your account.',
+    unsupported: 'This browser cannot sync passkey changes. Remove unused keys from your password manager manually.',
+    failed: 'Your account is updated, but we could not notify your browser. Retry or remove the key from your password manager.',
+  };
+  $('sync-message').textContent = messages[status];
+  $('sync-retry').hidden = status !== 'failed';
+  document.querySelector('.sync-icon').replaceChildren(icon(status === 'failed' || status === 'unsupported' ? 'info' : 'check'));
+}
+
+async function load() {
+  $('passkey-list').setAttribute('aria-busy', 'true');
+  error('list-error', '');
+  try {
+    snapshot = await repository.list();
+    render();
+    await synchronize();
+  } catch (cause) {
+    snapshot = undefined; // Never sync an empty or stale list after a failed request.
+    $('passkey-list').replaceChildren();
+    $('passkey-list').setAttribute('aria-busy', 'false');
+    $('passkey-count').textContent = '—';
+    error('list-error', cause.message);
+    const row = element('li', 'empty-state');
+    const retry = element('button', 'outline-button', 'Try again');
+    retry.dataset.action = 'reload';
+    row.append(retry);
+    $('passkey-list').append(row);
+    $('sync-message').textContent = 'Browser sync will resume once your account details can be loaded.';
+  }
+}
+
+function showPage(page) {
+  const panel = $(`${page}-panel`);
+  if (!panel) return;
+  for (const item of document.querySelectorAll('.page-panel')) item.hidden = item !== panel;
+  for (const button of document.querySelectorAll('.account-nav button')) {
+    button.classList.toggle('selected', button.dataset.page === page);
+    if (button.dataset.page === page) button.setAttribute('aria-current', 'page');
+    else button.removeAttribute('aria-current');
+  }
+  const title = panel.querySelector('h2').textContent;
+  $('breadcrumb-current').textContent = title;
+  document.title = `${page === 'security' ? 'Passkeys' : title} · My Account | The Daily Grind`;
+}
+
+document.addEventListener('click', async event => {
+  const button = event.target.closest('button');
+  if (!button || busy) return;
+  if (button.dataset.page) return showPage(button.dataset.page);
+  if (button.dataset.open) return $(button.dataset.open).showModal();
+  if (button.hasAttribute('data-close')) return button.closest('dialog').close();
+  const action = button.dataset.action;
+  if (action === 'reload') return load();
+  if (action === 'reset') {
+    snapshot = await repository.reset();
+    render();
+    await synchronize();
+    $('page-title').focus();
+    return notify('Sample passkeys restored.');
+  }
+  if (!snapshot || !['rename', 'delete'].includes(action)) return;
+  activeId = button.dataset.credentialId;
+  const credential = snapshot.credentials.find(item => item.id === activeId);
+  if (!credential) return;
+  error(`${action}-error`, '');
+  if (action === 'rename') {
+    $('passkey-name').value = credential.name;
+    $('passkey-name').setCustomValidity('');
+    $('rename-dialog').showModal();
+    $('passkey-name').select();
+  } else {
+    $('delete-name').textContent = credential.name;
+    $('last-key-warning').hidden = snapshot.credentials.length !== 1;
+    $('delete-dialog').showModal();
+  }
+});
+
+$('passkey-name').addEventListener('input', () => $('passkey-name').setCustomValidity(''));
+for (const action of ['rename', 'delete']) {
+  const form = $(`${action}-form`);
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    let name;
+    if (action === 'rename') {
+      try { name = validateName($('passkey-name').value); }
+      catch (cause) {
+        $('passkey-name').setCustomValidity(cause.message);
+        $('passkey-name').reportValidity();
+        return;
+      }
+    }
+    busy = true;
+    const submit = form.querySelector('[type="submit"]');
+    const oldLabel = submit.textContent;
+    submit.textContent = action === 'rename' ? 'Saving…' : 'Removing…';
+    for (const control of form.elements) control.disabled = true;
+    error(`${action}-error`, '');
+    try {
+      // Each mutation returns the complete latest list, never a client-filtered list.
+      const updated = await (action === 'rename' ? repository.rename(activeId, name) : repository.remove(activeId));
+      if (updated.user.id !== snapshot.user.id || updated.rpId !== snapshot.rpId) throw new Error('Your account changed. Refresh the page before continuing.');
+      snapshot = updated;
+      $(`${action}-dialog`).close();
+      render();
+      if (action === 'delete') {
+        // The deleted invoker no longer exists. Give focus a meaningful successor.
+        ($('passkey-list').querySelector('button') || $('page-title')).focus();
+        await synchronize();
+      } else if (repository.demo) await synchronize();
+      notify(action === 'rename' ? 'Passkey renamed. A little easier to recognize.' : 'Passkey removed from your account.');
+    } catch (cause) {
+      error(`${action}-error`, cause.message);
+    } finally {
+      busy = false;
+      submit.textContent = oldLabel;
+      for (const control of form.elements) control.disabled = false;
+    }
+  });
+  // The server operation cannot be canceled by closing the dialog mid-request.
+  $(`${action}-dialog`).addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+}
+$('sync-retry').addEventListener('click', async () => {
+  if (busy) return;
+  busy = true;
+  try { await load(); } finally { busy = false; }
+});
+window.addEventListener('storage', event => {
+  if (repository?.demo && event.key?.startsWith('daily-grind.demo-passkeys') && !busy) {
+    // Other tabs can change demo storage; reload to avoid presenting stale rows.
+    window.location.reload();
+  }
+});
+try {
+  repository = createRepository({ ...config, storage });
+  $('demo-label').hidden = !repository.demo;
+  if (!repository.demo) {
+    $('profile-name').textContent = 'My account';
+    $('profile-caption').textContent = 'Loading your details…';
+    $('avatar').textContent = '—';
+    $('detail-name').textContent = '—';
+    $('detail-account').textContent = '—';
+    $('passkey-count').textContent = '—';
+    $('sign-out').hidden = true;
+  }
+  await load();
+} catch (cause) {
+  error('list-error', cause.message);
+  $('passkey-list').replaceChildren();
+  $('passkey-list').setAttribute('aria-busy', 'false');
+  $('passkey-count').textContent = '—';
+}
