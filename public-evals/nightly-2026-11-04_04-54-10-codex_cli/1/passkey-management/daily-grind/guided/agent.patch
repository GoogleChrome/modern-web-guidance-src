+    await credentialAPI.signalAllAcceptedCredentials({
+      rpId: snapshot.rpId,
+      userId: snapshot.user.id,
+      allAcceptedCredentialIds: snapshot.credentials.map(item => item.id),
+    });
+    return 'synced';
+  } catch { return 'failed'; }
+}
