+// Credential management only. Authentication and registration belong to the server.
+export const DEMO_STORAGE_KEY = 'daily-grind.demo-passkeys.v1';
+const encodedId = value => typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value) && value.length % 4 !== 1;
+const clone = value => JSON.parse(JSON.stringify(value));
+// Display hints only; AAGUID metadata is never used for access decisions.
+const providers = {
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'Apple Passwords',
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+};
+export function providerName(credential) {
+  const aaguid = typeof credential.aaguid === 'string' ? credential.aaguid.toLowerCase() : '';
+  return providers[aaguid] || (typeof credential.provider === 'string' && credential.provider) || 'Unknown passkey provider';
+}
+
+export function validateSnapshot(value) {
+  if (!value || !encodedId(value.user?.id) || typeof value.user.displayName !== 'string' ||
+      typeof value.rpId !== 'string' || !value.rpId || !Array.isArray(value.credentials)) {
+    throw new Error('Your passkey details could not be loaded. Please try again.');
+  }
+  const ids = new Set();
+  for (const credential of value.credentials) {
+    if (!encodedId(credential.id) || ids.has(credential.id) || typeof credential.name !== 'string' ||
+        !Number.isFinite(credential.registeredAt) || credential.registeredAt < 0 || credential.registeredAt > 8640000000000000 ||
+        (credential.lastUsedAt != null && (!Number.isFinite(credential.lastUsedAt) || credential.lastUsedAt < 0 || credential.lastUsedAt > 8640000000000000))) {
+      throw new Error('The passkey list is incomplete or invalid. Please try again.');
+    }
+    ids.add(credential.id);
+  }
+  return value;
+}
+
+export function validateName(value) {
+  const name = value.trim();
+  if (!name || name.length > 50) throw new Error('Choose a name between 1 and 50 characters.');
+  return name;
+}
+
+export function demoSnapshot(now = Date.now()) {
+  return {
+    user: { id: 'ZGVtby11c2Vy', displayName: 'Alex Morgan', name: 'alex@example.com' },
+    rpId: 'demo.invalid',
+    credentials: [
+      { id: 'bWFjYm9vaw', name: 'MacBook Pro', aaguid: 'dd4ec289-e01d-41c9-bb89-70fa845d4bf2', kind: 'laptop', registeredAt: Date.UTC(2026, 0, 14), lastUsedAt: now - 1200000 },
+      { id: 'aXBob25l', name: 'iPhone 15', aaguid: 'dd4ec289-e01d-41c9-bb89-70fa845d4bf2', kind: 'phone', registeredAt: Date.UTC(2026, 1, 2), lastUsedAt: now - 86400000 },
+      { id: 'c2VjdXJpdHkta2V5', name: 'YubiKey', provider: 'Hardware security key', kind: 'usb', registeredAt: Date.UTC(2026, 2, 18), lastUsedAt: Date.UTC(2026, 9, 12) },
+    ],
+  };
+}
+
+export function createRepository({ apiBase, csrfToken, storage, fetchImpl = globalThis.fetch } = {}) {
+  const demo = !apiBase;
+  // Only relative same-origin API paths are permitted; never send a CSRF token to another origin.
+  if (!demo && (!/^\/[a-zA-Z0-9/_-]+$/.test(apiBase) || apiBase.includes('//'))) {
+    throw new Error('The account API must use a same-origin path.');
+  }
+  let memory;
+  const repository = { demo, persistent: Boolean(storage), list, rename, remove, reset };
+
+  async function request(path = '', options = {}) {
+    let response;
+    try {
+      response = await fetchImpl(`${apiBase.replace(/\/$/, '')}${path}`, {
+        ...options,
+        credentials: 'same-origin', cache: 'no-store', redirect: 'error',
+        headers: { Accept: 'application/json', ...(options.body ? { 'Content-Type': 'application/json' } : {}),
+          ...(options.method ? { 'X-CSRF-Token': csrfToken || '' } : {}) },
+      });
+    } catch {
+      throw new Error('We could not reach your account. Check your connection and try again.');
+    }
+    if (response.status === 401) throw new Error('Please sign in again to manage your passkeys.');
+    if (response.status === 403) throw new Error('Your session could not be verified. Refresh the page and try again.');
+    if (response.status === 404) throw new Error('This passkey no longer exists. Refresh your list and try again.');
+    if (!response.ok) throw new Error('We could not update your passkeys. Please try again.');
+    try { return validateSnapshot(await response.json()); }
+    catch { throw new Error('We could not confirm the latest passkey list. Refresh before trying again.'); }
+  }
+
+  function readDemo() {
+    if (memory) return clone(memory);
+    try {
+      const stored = storage?.getItem(DEMO_STORAGE_KEY);
+      memory = stored ? validateSnapshot(JSON.parse(stored)) : demoSnapshot();
+    } catch {
+      // A corrupt demo cache never substitutes for a failed authenticated API request.
+      memory = demoSnapshot();
+    }
+    return clone(memory);
+  }
+
+  function saveDemo(snapshot) {
+    try { storage?.setItem(DEMO_STORAGE_KEY, JSON.stringify(snapshot)); }
+    catch { repository.persistent = false; }
+    memory = clone(snapshot);
+    return clone(snapshot);
+  }
+
+  async function list() {
+    return demo ? readDemo() : request();
+  }
+
+  async function rename(id, value) {
+    const name = validateName(value);
+    if (!demo) return request(`/${encodeURIComponent(id)}`, { method: 'PUT', body: JSON.stringify({ name }) });
+    const snapshot = readDemo();
+    const credential = snapshot.credentials.find(item => item.id === id);
+    if (!credential) throw new Error('This passkey no longer exists. Refresh and try again.');
+    credential.name = name;
+    return saveDemo(snapshot);
+  }
+
+  async function remove(id) {
+    if (!demo) return request(`/${encodeURIComponent(id)}`, { method: 'DELETE' });
+    const snapshot = readDemo();
+    snapshot.credentials = snapshot.credentials.filter(item => item.id !== id);
+    return saveDemo(snapshot);
+  }
+
+  async function reset() {
+    if (!demo) throw new Error('Only sample passkeys can be reset.');
+    return saveDemo(demoSnapshot());
+  }
+  return repository;
+}
+
+// Only signal a complete, authoritative server snapshot for an authenticated user.
+// A local nickname change does not change the authenticator's account identity.
+export async function syncAcceptedCredentials(snapshot, { demo = true, credentialAPI, secureContext = false } = {}) {
+  if (demo) return 'demo';
+  if (!secureContext || typeof credentialAPI?.signalAllAcceptedCredentials !== 'function') return 'unsupported';
