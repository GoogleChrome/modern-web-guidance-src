+import { createHash } from 'node:crypto';
+import { resolveTxt, lookup } from 'node:dns/promises';
+import { isIP } from 'node:net';
+import https from 'node:https';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const ALGORITHMS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalize = algorithm => algorithm === 'Ed25519' ? 'EdDSA' : algorithm;
+const hasher = (data, algorithm) => {
+  if (algorithm !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+
+// Discovery and keys are untrusted network destinations. Validate DNS again at
+// socket creation, with no redirects, so DNS rebinding cannot reach local services.
+export function isPublicAddress(address) {
+  if (isIP(address) === 6) return /^[23][0-9a-f]{3}:/i.test(address) && !/^2001:(db8|0):/i.test(address);
+  if (isIP(address) !== 4) return false;
+  const [a, b] = address.split('.').map(Number);
+  return !(a === 0 || a === 10 || a === 127 || a >= 224 ||
+    (a === 100 && b >= 64 && b <= 127) || (a === 169 && b === 254) ||
+    (a === 172 && b >= 16 && b <= 31) || (a === 192 && (b === 168 || b === 0 || b === 2)) ||
+    (a === 198 && (b === 18 || b === 19 || b === 51)) || (a === 203 && b === 0));
+}
+async function publicJson(location) {
+  const url = new URL(location);
+  if (url.protocol !== 'https:' || url.username || url.password || (url.port && url.port !== '443') ||
+      isIP(url.hostname.replace(/^\[|\]$/g, '')) || url.hostname === 'localhost') throw new Error('Unsafe URL');
+  return new Promise((resolve, reject) => {
+    const req = https.get(url, { agent: false, timeout: 5000, lookup(host, options, callback) {
+      lookup(host, { all: true }).then(addresses => {
+        if (!addresses.length || addresses.some(item => !isPublicAddress(item.address))) throw new Error('Non-public issuer address');
+        callback(null, options.all ? addresses : addresses[0].address, addresses[0].family);
+      }).catch(callback);
+    } }, res => {
+      if (res.statusCode !== 200) { res.resume(); reject(new Error('Issuer HTTP error')); return; }
+      let body = ''; let size = 0;
+      res.on('data', chunk => {
+        size += chunk.length;
+        if (size > 128 * 1024) req.destroy(new Error('Issuer response too large'));
+        else body += chunk;
+      });
+      res.on('error', reject);
+      res.on('end', () => { try { resolve(JSON.parse(body)); } catch (error) { reject(error); } });
+    });
+    req.on('timeout', () => req.destroy(new Error('Issuer timeout')));
+    req.on('error', reject);
+  });
+}
+export async function loadIssuerKeys(issuer, domain) {
+  const url = new URL(issuer);
+  if (url.protocol !== 'https:' || url.origin !== issuer || url.hostname === 'localhost' || isIP(url.hostname) || url.username || url.password || url.port) throw new Error('Invalid issuer origin');
+  const records = await resolveTxt(`_email-verification.${domain}`);
+  if (!records.some(parts => {
+    const record = parts.join('');
+    return record.startsWith('iss=') && `https://${record.slice(4).trim()}` === issuer;
+  })) throw new Error('Issuer not delegated by email domain');
+  const metadata = await publicJson(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid issuer metadata');
+  return createLocalJWKSet(await publicJson(metadata.jwks_uri));
+}
+
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }, dependencies = {}) {
+  if (!expectedNonce || !rawToken || rawToken.length > 32768) throw new Error('Missing or oversized verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const payload = decoded.jwt.payload;
+  if (!decoded.kbJwt || typeof payload.iss !== 'string' || payload.email_verified !== true ||
+      typeof payload.email !== 'string' || payload.email.toLowerCase() !== submittedEmail.toLowerCase()) throw new Error('Invalid email claims');
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1);
+  if (!/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$/i.test(domain)) throw new Error('Invalid email domain');
+  const jwks = await (dependencies.loadIssuerKeys || loadIssuerKeys)(payload.iss, domain);
+  const options = { typ: 'ev+sd-jwt', issuer: payload.iss, algorithms: ALGORITHMS, maxTokenAge: '5m', clockTolerance: 60, requiredClaims: ['iat', 'exp'] };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, signature) => {
+      const compact = `${data}.${signature}`;
+      try { await jwtVerify(compact, jwks, options); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let verified = false;
+        for await (const key of error) {
+          try { await jwtVerify(compact, key, options); verified = true; break; } catch { /* Try next matching key. */ }
+        }
+        if (!verified) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature) => {
+      const jwk = payload.cnf?.jwk;
+      const algorithm = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || !ALGORITHMS.includes(jwk.alg) || !ALGORITHMS.includes(algorithm) || normalize(jwk.alg) !== normalize(algorithm)) throw new Error('Invalid holder key');
+      await jwtVerify(`${data}.${signature}`, await importJWK(jwk, algorithm), {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [algorithm], maxTokenAge: '5m', clockTolerance: 60, requiredClaims: ['iat', 'aud', 'nonce', 'sd_hash'],
+      });
+      return true;
+    },
+  });
+  await sdJwt.verify(rawToken, { requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: expectedNonce, expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60 });
+  return { email: submittedEmail };
+}
