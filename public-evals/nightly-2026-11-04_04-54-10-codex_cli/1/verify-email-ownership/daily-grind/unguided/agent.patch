diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..7376889
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,71 @@
+import express from 'express';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { readFileSync, mkdirSync } from 'node:fs';
+import { DatabaseSync } from 'node:sqlite';
+import { fileURLToPath } from 'node:url';
+import { verifyEmailVerificationToken } from './lib/verify-email.mjs';
+
+const app = express();
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.APP_ORIGIN || `http://localhost:${port}`).origin;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) throw new Error('Set APP_ORIGIN to the public HTTPS origin');
+const secure = origin.startsWith('https://');
+const cookieName = secure ? '__Host-dg_signup' : 'dg_signup';
+const dataDir = process.env.DATA_DIR || fileURLToPath(new URL('./data', import.meta.url));
+mkdirSync(dataDir, { recursive: true, mode: 0o700 });
+const db = new DatabaseSync(`${dataDir}/rewards.sqlite`);
+db.exec(`PRAGMA journal_mode=WAL;
+  CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, nonce TEXT, expires INTEGER NOT NULL, message TEXT, error INTEGER);
+  CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY, email TEXT NOT NULL COLLATE NOCASE UNIQUE, first_name TEXT NOT NULL, last_name TEXT NOT NULL, updates INTEGER NOT NULL, verified_at TEXT NOT NULL);`);
+const template = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+const escape = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
+const sessionId = req => req.headers.cookie?.split(';').map(part => part.trim()).find(part => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+function createSession(res, message = null, error = false) {
+  db.prepare('DELETE FROM sessions WHERE expires < ?').run(Date.now());
+  if (db.prepare('SELECT count(*) AS n FROM sessions').get().n > 20000) throw new Error('Session capacity reached');
+  const id = randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?, ?)').run(id, nonce, Date.now() + 600000, message, Number(error));
+  res.cookie(cookieName, id, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 600000 });
+  return nonce;
+}
+app.disable('x-powered-by');
+app.use((req, res, next) => {
+  res.set({ 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'strict-origin-when-cross-origin', 'X-Frame-Options': 'DENY', 'Cache-Control': 'no-store', 'Content-Security-Policy': "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" });
+  if (secure) res.set('Strict-Transport-Security', 'max-age=31536000');
+  if (process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN) res.set('Origin-Trial', process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN);
+  next();
+});
+app.use('/public', express.static(fileURLToPath(new URL('./public', import.meta.url)), { dotfiles: 'deny' }));
+app.use(express.urlencoded({ extended: false, limit: '40kb', parameterLimit: 12 }));
+app.get('/', (req, res) => {
+  const previous = db.prepare('DELETE FROM sessions WHERE id = ? RETURNING *').get(sessionId(req) || '');
+  const nonce = createSession(res);
+  const message = previous?.expires > Date.now() ? previous.message : '';
+  let html = template.replace('SERVER_NONCE', nonce).replace('<!--FORM_MESSAGE-->', message ? escape(message) : '');
+  if (previous?.error && message) html = html.replace('class="form-message"', 'class="form-message error"');
+  res.type('html').send(html);
+});
+app.post('/api/verify-email', async (req, res) => {
+  if (req.headers.origin !== origin) return res.status(403).type('text').send('Please submit the form from the Daily Grind homepage.');
+  // DELETE RETURNING consumes the expected nonce atomically before any async work.
+  const session = db.prepare('DELETE FROM sessions WHERE id = ? RETURNING *').get(sessionId(req) || '');
+  const result = (message, error = true) => { createSession(res, message, error); res.redirect(303, '/#join'); };
+  if (!session?.nonce || session.expires < Date.now()) return result('Your sign-up session expired. Please try again using the fresh form below.');
+  const { firstName, lastName, email, token, updates } = req.body || {};
+  if ([firstName, lastName, email].some(value => typeof value !== 'string') || !firstName.trim() || !lastName.trim() || firstName.length > 80 || lastName.length > 80 || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) return result('Please enter your name and a valid email address.');
+  if (typeof token !== 'string' || !token.trim()) return result('Your browser could not verify this email. Use a supported browser and sign in to your email provider in the same browser, then try again. No account was created and no email was sent.');
+  try {
+    await verifyEmailVerificationToken({ rawToken: token, submittedEmail: email.trim(), expectedNonce: session.nonce, expectedAudience: origin });
+  } catch {
+    return result('We couldn’t securely verify your email. Please check your email provider sign-in and try again. No account was created and no email was sent.');
+  }
+  const inserted = db.prepare('INSERT INTO members VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT(email) DO NOTHING').run(randomUUID(), email.trim(), firstName.trim(), lastName.trim(), Number(updates === 'yes'), new Date().toISOString());
+  return result(inserted.changes ? `You're in, ${firstName.trim()}! Your email is verified and your Daily Grind rewards account is ready. Welcome to the community.` : 'Your email is verified. You already have a Daily Grind rewards account — welcome back!', false);
+});
+app.use((error, req, res, next) => {
+  console.error('Request failed:', error.type || error.code || 'internal_error');
+  if (res.headersSent) return next(error);
+  res.status(error.status === 413 ? 413 : 500).type('text').send('We couldn’t process this request. Return to the homepage and try again.');
+});
+app.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
diff --git a/test/verify-email.test.mjs b/test/verify-email.test.mjs
new file mode 100644
index 0000000..a0b1066
--- /dev/null
+++ b/test/verify-email.test.mjs
@@ -0,0 +1,69 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { generateKeyPair, exportJWK, SignJWT, createLocalJWKSet } from 'jose';
+import { verifyEmailVerificationToken, isPublicAddress } from '../lib/verify-email.mjs';
+
+const issuer = await generateKeyPair('ES256');
+const holder = await generateKeyPair('ES256');
+const publicIssuer = await exportJWK(issuer.publicKey);
+const holderJwk = { ...await exportJWK(holder.publicKey), alg: 'ES256' };
+const audience = 'https://dailygrind.example';
+const nonce = 'server-random-single-use-nonce';
+const now = Math.floor(Date.now() / 1000);
+async function presentation({ claims = {}, binding = {}, signingKey = issuer.privateKey, holderKey = holder.privateKey } = {}) {
