+});
+test('wrong submitted email is rejected', async () => {
+  await assert.rejects(verify(await presentation(), { submittedEmail: 'other@example.com' }));
+});
+test('unverified email is rejected', async () => {
+  await assert.rejects(verify(await presentation({ claims: { email_verified: false } })));
+});
+test('incorrect nonce, audience, and SD hash are rejected', async () => {
