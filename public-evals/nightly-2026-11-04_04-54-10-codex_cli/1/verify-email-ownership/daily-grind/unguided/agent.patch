+    .setProtectedHeader({ alg: 'ES256', typ: 'ev+sd-jwt' }).setIssuer('https://issuer.example').setIssuedAt(claims.iat ?? now).setExpirationTime(claims.exp ?? now + 300).sign(signingKey);
