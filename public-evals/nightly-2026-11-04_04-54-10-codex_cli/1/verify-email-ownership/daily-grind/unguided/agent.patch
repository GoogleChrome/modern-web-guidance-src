+}
+const dependencies = { loadIssuerKeys: async () => createLocalJWKSet({ keys: [publicIssuer] }) };
+const verify = (rawToken, changes = {}, deps = dependencies) => verifyEmailVerificationToken({ rawToken, submittedEmail: 'alex@EXAMPLE.com', expectedNonce: nonce, expectedAudience: audience, ...changes }, deps);
+
+test('valid issuer and holder signatures verify case-insensitive email', async () => {
