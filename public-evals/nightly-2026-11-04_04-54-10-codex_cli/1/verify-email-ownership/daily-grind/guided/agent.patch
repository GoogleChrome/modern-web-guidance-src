+import { createServer } from 'node:http';
+import { readFile, mkdir } from 'node:fs/promises';
+import { createApp } from './server/app.mjs';
+import { createStore } from './server/store.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+if (process.env.NODE_ENV === 'production' && (!process.env.APP_ORIGIN || !origin.startsWith('https://'))) {
+  throw new Error('Production requires an HTTPS APP_ORIGIN');
+}
+await mkdir('data', { recursive: true, mode: 0o700 });
+const store = createStore(process.env.DATABASE_PATH || 'data/rewards.sqlite');
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const script = await readFile(new URL('./public/rewards.js', import.meta.url), 'utf8');
+const handle = createApp({ store, template, origin, originTrialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN });
+
+createServer(async (request, response) => {
+  try {
+    if (request.url === '/rewards.js' && request.method === 'GET') {
+      response.writeHead(200, { 'Content-Type': 'text/javascript; charset=utf-8', 'X-Content-Type-Options': 'nosniff' });
+      response.end(script);
+      return;
+    }
+    let length = 0;
+    const chunks = [];
+    for await (const chunk of request) {
+      length += chunk.length;
+      if (length > 65536) { response.writeHead(413); response.end('Form too large'); return; }
+      chunks.push(chunk);
+    }
+    // Configured origin, never an untrusted Host or forwarded header, defines the audience.
+    const url = new URL(request.url, origin);
+    const result = await handle(new Request(url, {
+      method: request.method, headers: request.headers,
+      ...(request.method !== 'GET' && request.method !== 'HEAD' ? { body: Buffer.concat(chunks) } : {}),
+    }), request.socket.remoteAddress);
+    response.writeHead(result.status, Object.fromEntries(result.headers));
+    response.end(await result.text());
+  } catch (error) {
+    console.error('Rewards request failed:', error.name);
+    response.writeHead(500, { 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
+    response.end('We could not complete your request. Return to the homepage and try again.');
+  }
+}).listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
diff --git a/server/app.mjs b/server/app.mjs
new file mode 100644
index 0000000..80c43f1
--- /dev/null
+++ b/server/app.mjs
@@ -0,0 +1,76 @@
+import { randomBytes, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './verify-email.mjs';
+
+const deriveKey = promisify(scrypt);
+const escapeHtml = value => String(value).replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
+const emailPattern = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
+
+export function createApp({ store, template, origin, originTrialToken = '', verify = verifyEmailVerificationToken }) {
+  const audience = new URL(origin).origin;
+  if (audience !== origin) throw new Error('APP_ORIGIN must be an origin with no trailing slash');
+  const secure = audience.startsWith('https:');
+  const cookieName = secure ? '__Host-dg-session' : 'dg-session';
+  function render(session, { status = 200, message = '', success = false, name = '', email = '' } = {}) {
+    const challenge = store.issue(session);
+    const replacements = {
+      '__FORM_ID__': challenge.id, '__FORM_NONCE__': challenge.nonce,
+      '__STATUS__': escapeHtml(message), '__NAME__': escapeHtml(name), '__EMAIL__': escapeHtml(email),
+      '__SUCCESS__': success ? 'disabled' : '',
+    };
+    let html = template.replace(/__FORM_ID__|__FORM_NONCE__|__STATUS__|__NAME__|__EMAIL__|__SUCCESS__/g, marker => replacements[marker]);
+    if (originTrialToken) html = html.replace('</head>', `<meta http-equiv="origin-trial" content="${escapeHtml(originTrialToken)}"></head>`);
+    return new Response(html, {
+      status,
+      headers: {
+        'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store',
+        'Set-Cookie': `${cookieName}=${session}; HttpOnly; SameSite=Lax; Path=/; Max-Age=3600${secure ? '; Secure' : ''}`,
+        'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin',
+        'Content-Security-Policy': "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
+      },
+    });
+  }
+
+  return async function handle(request, clientIp = 'unknown') {
+    const path = new URL(request.url).pathname;
+    if (path !== '/' && path !== '/api/verify-email') return new Response('Not found', { status: 404 });
+    const sessionCookie = request.headers.get('cookie')?.split(';').map(part => part.trim()).find(part => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    const session = /^[A-Za-z0-9_-]{43}$/.test(sessionCookie ?? '') ? sessionCookie : randomBytes(32).toString('base64url');
+    if (path === '/' && request.method === 'GET') {
+      if (!store.allow(`page:${clientIp}`, 120)) return new Response('Too many requests. Please try again later.', { status: 429 });
+      return render(session);
+    }
+    if (path !== '/api/verify-email' || request.method !== 'POST') return new Response('Method not allowed', { status: 405, headers: { Allow: path === '/' ? 'GET' : 'POST' } });
+    if (request.headers.get('origin') !== audience || request.headers.get('sec-fetch-site') === 'cross-site') {
+      return new Response('Please submit the form from the Daily Grind homepage.', { status: 403 });
+    }
+    if (!store.allow(`signup:${clientIp}`, 20)) return render(session, { status: 429, message: 'Too many attempts. Please try again in 10 minutes.' });
+    if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) {
+      return render(session, { status: 415, message: 'Please use the rewards form to sign up.' });
+    }
+    const body = await request.text();
+    if (Buffer.byteLength(body) > 65536) return new Response('Form too large', { status: 413 });
+    const form = new URLSearchParams(body);
+    const challenge = store.consume(form.get('form_id') ?? '', session);
+    const name = (form.get('name') ?? '').trim();
+    const email = (form.get('email') ?? '').trim();
+    const password = form.get('password') ?? '';
+    const retry = (message, status = 422) => render(session, { status, message, name, email });
+    if (!challenge || challenge.expires < Date.now()) return retry('Your sign-up session expired. Your details are saved below; please try again.');
+    if (!name || name.length > 120 || email.length > 254 || !emailPattern.test(email) || password.length < 12 || password.length > 128) {
+      return retry('Enter your name, a valid email address, and a password of 12–128 characters.');
+    }
+    const rawToken = form.get('token') ?? '';
+    if (!rawToken) return retry('Your browser could not verify this email. Use a supported Chrome browser, sign in to your email provider in the same browser, then re-enter your email and try again. No email was sent and no account was created.');
+    try {
+      await verify({ rawToken, submittedEmail: email, expectedNonce: challenge.nonce, expectedAudience: audience });
+    } catch {
+      return retry('We could not verify ownership of this email. Re-enter your email and try again with a supported browser and email provider. No email was sent and no account was created.');
+    }
+    const salt = randomBytes(16).toString('base64url');
+    const key = await deriveKey(password, salt, 64);
+    const created = store.register({ name, email, passwordHash: `scrypt:${salt}:${key.toString('base64url')}` });
+    if (!created) return retry('A rewards account already exists for this verified email address.', 409);
+    return render(session, { status: 201, success: true, message: 'Welcome to Daily Grind Rewards! Your email is verified and your account is ready.' });
+  };
+}
diff --git a/server/store.mjs b/server/store.mjs
new file mode 100644
index 0000000..480255d
--- /dev/null
+++ b/server/store.mjs
@@ -0,0 +1,34 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+
+export function createStore(filename) {
+  const db = new DatabaseSync(filename);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, session TEXT NOT NULL, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, email TEXT NOT NULL COLLATE NOCASE UNIQUE, name TEXT NOT NULL, password_hash TEXT NOT NULL, verified_at TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+  return {
+    db,
+    issue(session) {
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+      const challenge = { id: randomBytes(24).toString('base64url'), nonce: randomBytes(32).toString('base64url') };
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?)').run(challenge.id, session, challenge.nonce, Date.now() + 600000);
+      return challenge;
+    },
+    consume(id, session) {
+      // One atomic statement: simultaneous requests cannot reuse the challenge.
+      return db.prepare('DELETE FROM challenges WHERE id = ? AND session = ? RETURNING nonce, expires').get(id, session);
+    },
+    allow(key, maximum) {
+      const now = Date.now();
+      db.prepare('DELETE FROM limits WHERE expires < ?').run(now);
+      const row = db.prepare(`INSERT INTO limits VALUES (?, 1, ?) ON CONFLICT(key) DO UPDATE SET count = count + 1 RETURNING count`).get(key, now + 600000);
+      return row.count <= maximum;
+    },
+    register({ name, email, passwordHash }) {
+      const id = randomUUID();
+      const result = db.prepare('INSERT INTO accounts VALUES (?, ?, ?, ?, ?) ON CONFLICT(email) DO NOTHING').run(id, email, name, passwordHash, new Date().toISOString());
+      return result.changes === 1;
+    },
+  };
+}
