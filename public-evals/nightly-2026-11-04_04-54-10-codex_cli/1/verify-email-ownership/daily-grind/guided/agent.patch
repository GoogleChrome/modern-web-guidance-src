+import { createHash } from 'node:crypto';
+import { lookup, resolveTxt } from 'node:dns/promises';
+import { Agent, fetch } from 'undici';
+import ipaddr from 'ipaddr.js';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const ALGORITHMS = ['Ed25519', 'EdDSA', 'ES256'];
+const hasher = (data, alg) => {
+  if (alg !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+
+// Pin connections to public DNS answers, including after metadata discovery.
+// DNS delegation alone does not protect against attacker-controlled private hosts.
+export async function publicLookup(hostname, options, callback) {
+  try {
+    const addresses = await lookup(hostname, { all: true });
+    if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) {
+      throw new Error('Private network destination rejected');
+    }
+    callback(null, options.all ? addresses : addresses[0].address, addresses[0].family);
+  } catch (error) { callback(error); }
+}
+
+const dispatcher = new Agent({ connect: { lookup: publicLookup, timeout: 5000 } });
+export async function fetchPublicJson(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || (url.port && url.port !== '443')) {
+    throw new Error('Invalid HTTPS endpoint');
+  }
+  // Literal IPs bypass the connector's DNS lookup hook entirely.
+  if (ipaddr.isValid(url.hostname.replace(/^\[|\]$/g, ''))) throw new Error('IP literal destination rejected');
+  const response = await fetch(url, {
+    dispatcher, redirect: 'error', signal: AbortSignal.timeout(5000),
+    headers: { accept: 'application/json' },
+  });
+  if (!response.ok) { await response.body?.cancel(); throw new Error('Discovery failed'); }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of response.body) {
+    size += chunk.length;
+    if (size > 131072) throw new Error('Discovery response too large');
+    chunks.push(chunk);
+  }
+  return JSON.parse(Buffer.concat(chunks).toString('utf8'));
+}
+
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }, {
+  txtLookup = resolveTxt, getJson = fetchPublicJson,
+} = {}) {
+  if (!expectedNonce || !rawToken || rawToken.length > 32768) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evt = decoded.jwt.payload;
+  const kb = decoded.kbJwt;
+  if (!kb || !ALGORITHMS.includes(decoded.jwt.header.alg) || !ALGORITHMS.includes(kb.header.alg)) {
+    throw new Error('Missing binding or unsupported algorithm');
+  }
+  if (!['evt+jwt', 'ev+sd-jwt'].includes(decoded.jwt.header.typ)) throw new Error('Invalid token type');
+  if (evt.email_verified !== true || typeof evt.email !== 'string' || evt.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Email mismatch');
+  }
+  const issuer = new URL(evt.iss);
+  if (issuer.protocol !== 'https:' || issuer.origin !== evt.iss || issuer.port || issuer.username || issuer.password) {
+    throw new Error('Invalid issuer');
+  }
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1);
+  const records = await txtLookup(`_email-verification.${domain}`);
+  if (!records.some(parts => `https://${parts.join('').trim().replace(/^iss=/, '')}` === evt.iss && parts.join('').trim().startsWith('iss='))) {
+    throw new Error('Issuer not delegated by email domain');
+  }
+  const metadata = await getJson(`${evt.iss}/.well-known/email-verification`);
+  if (metadata.issuer !== evt.iss || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid metadata');
+  const jwksData = await getJson(metadata.jwks_uri);
+  if (!Array.isArray(jwksData.keys) || jwksData.keys.length > 50) throw new Error('Invalid key set');
+  const keys = createLocalJWKSet(jwksData);
+  const options = { issuer: evt.iss, algorithms: ALGORITHMS, maxTokenAge: '5m', clockTolerance: 60 };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, signature) => {
+      try { await jwtVerify(`${data}.${signature}`, keys, options); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let matched = false;
+        for await (const key of error) {
+          try { await jwtVerify(`${data}.${signature}`, key, options); matched = true; break; } catch {}
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature, payload) => {
+      const jwk = payload.cnf?.jwk;
+      const alg = kb.header.alg;
+      const normalize = value => value === 'Ed25519' ? 'EdDSA' : value;
+      if (!jwk || jwk.d || jwk.k || !['EC', 'OKP'].includes(jwk.kty) ||
+        (jwk.alg && normalize(jwk.alg) !== normalize(alg))) throw new Error('Invalid holder key');
+      await jwtVerify(`${data}.${signature}`, await importJWK(jwk, alg), {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [alg], maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  const result = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified', 'iat', 'exp', 'cnf'],
+    expectedIssuer: evt.iss, maxAgeSeconds: 300, skewSeconds: 60,
+    allowedIssuerAlgorithms: ALGORITHMS, allowedKeyBindingAlgorithms: ALGORITHMS,
+    keyBindingNonce: expectedNonce, expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300,
+  });
+  if (result.payload.email_verified !== true || result.payload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Verified email mismatch');
+  }
+  return result.payload;
+}
diff --git a/tests/rewards.test.mjs b/tests/rewards.test.mjs
new file mode 100644
index 0000000..01c27d8
--- /dev/null
+++ b/tests/rewards.test.mjs
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { SignJWT, exportJWK, generateKeyPair } from 'jose';
+import { verifyEmailVerificationToken, fetchPublicJson } from '../server/verify-email.mjs';
+import { createStore } from '../server/store.mjs';
+import { createApp } from '../server/app.mjs';
+
+const origin = 'https://daily-grind.example';
+const issuer = 'https://accounts.example.com';
+const email = 'coffee@example.com';
+const template = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+const issuerKeys = await generateKeyPair('ES256', { extractable: true });
+const otherKeys = await generateKeyPair('ES256', { extractable: true });
+const rogueKeys = await generateKeyPair('ES256', { extractable: true });
+const publicIssuerKey = await exportJWK(issuerKeys.publicKey);
+const dependencies = {
+  txtLookup: async () => [['iss=accounts.', 'example.com']],
+  getJson: async url => url.endsWith('/.well-known/email-verification')
+    ? { issuer, jwks_uri: `${issuer}/keys` }
+    : { keys: [await exportJWK(otherKeys.publicKey), publicIssuerKey] },
+};
+
+async function proof({ nonce = 'test-nonce', audience = origin, claims = {}, kbClaims = {}, signingKey = issuerKeys.privateKey, holderAlg = 'ES256', typ = 'evt+jwt' } = {}) {
+  const holder = await generateKeyPair(holderAlg, { extractable: true });
+  const now = Math.floor(Date.now() / 1000);
+  const evt = await new SignJWT({
+    iss: issuer, iat: now, exp: now + 300, email, email_verified: true,
+    cnf: { jwk: { ...await exportJWK(holder.publicKey), alg: holderAlg } }, ...claims,
+  }).setProtectedHeader({ alg: 'ES256', typ }).sign(signingKey);
+  const prefix = `${evt}~`;
+  const kb = await new SignJWT({
+    aud: audience, nonce, iat: now,
+    sd_hash: createHash('sha256').update(prefix).digest('base64url'), ...kbClaims,
+  }).setProtectedHeader({ alg: holderAlg, typ: 'kb+jwt' }).sign(holder.privateKey);
+  return `${prefix}${kb}`;
+}
+const verify = (rawToken, overrides = {}, deps = dependencies) => verifyEmailVerificationToken({
+  rawToken, submittedEmail: email, expectedNonce: 'test-nonce', expectedAudience: origin, ...overrides,
+}, deps);
+
+test('verifies signatures with multiple issuer keys and no kid', async () => {
+  assert.equal((await verify(await proof())).email, email);
+});
+
+test('accepts browser Ed25519 and transitional EdDSA holder bindings', async () => {
+  for (const holderAlg of ['Ed25519', 'EdDSA']) assert.equal((await verify(await proof({ holderAlg }))).email_verified, true);
+});
+
+test('rejects forged signatures, email mismatch, missing verification, and unsupported token types', async () => {
+  for (const options of [
+    { signingKey: rogueKeys.privateKey }, { claims: { email: 'someone@example.com' } },
+    { claims: { email_verified: false } }, { typ: 'JWT' },
+  ]) await assert.rejects(verify(await proof(options)));
+});
+
+test('rejects missing binding, wrong nonce, wrong audience and substituted SD hash', async () => {
+  const token = await proof();
+  await assert.rejects(verify(token.slice(0, token.indexOf('~') + 1)));
+  for (const options of [{ nonce: 'replayed' }, { audience: 'https://evil.example' }, { kbClaims: { sd_hash: 'substituted' } }]) {
+    await assert.rejects(verify(await proof(options)));
+  }
+});
+
+test('rejects expired and future-dated issuer and key binding tokens', async () => {
+  const now = Math.floor(Date.now() / 1000);
+  for (const options of [
+    { claims: { exp: now - 120 } }, { claims: { iat: now + 120 } },
+    { claims: { iat: now - 500 } }, { kbClaims: { iat: now - 500 } },
+    { kbClaims: { iat: now + 120 } }, { claims: { exp: undefined } },
+  ]) await assert.rejects(verify(await proof(options)));
+});
+
+test('rejects an undelegated issuer before fetching metadata', async () => {
+  let fetched = false;
+  await assert.rejects(verify(await proof(), {}, {
+    txtLookup: async () => [['iss=evil.example']], getJson: async () => { fetched = true; },
+  }));
+  assert.equal(fetched, false);
+});
+
+test('rejects mismatched metadata and private network discovery', async () => {
+  await assert.rejects(verify(await proof(), {}, { ...dependencies, getJson: async () => ({ issuer: 'https://evil.example' }) }));
+  await assert.rejects(fetchPublicJson('http://example.com/keys'));
+  await assert.rejects(fetchPublicJson('https://127.0.0.1/keys'), /IP literal destination rejected/);
+  await assert.rejects(fetchPublicJson('https://[::1]/keys'), /IP literal destination rejected/);
+});
+
+function setup(t) {
+  const store = createStore(':memory:');
+  t.after(() => store.db.close());
+  const handle = createApp({ store, template, origin, verify: args => verifyEmailVerificationToken(args, dependencies), originTrialToken: 'test-trial-token' });
+  return { store, handle };
+}
+async function page(handle, cookie) {
+  const response = await handle(new Request(origin, { headers: cookie ? { cookie } : {} }));
+  const html = await response.text();
+  return {
+    response, html, cookie: response.headers.get('set-cookie').split(';')[0],
+    id: html.match(/name="form_id" value="([^"]+)"/)[1],
+    nonce: html.match(/nonce="([^"]+)"/)[1],
+  };
+}
+function submit(handle, rendered, fields = {}, requestOrigin = origin) {
+  return handle(new Request(`${origin}/api/verify-email`, {
+    method: 'POST', headers: { cookie: rendered.cookie, origin: requestOrigin, 'content-type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({ form_id: rendered.id, name: 'Coffee Lover', email, password: 'a long coffee passphrase', ...fields }),
+  }));
+}
+
+test('homepage renders session-bound fresh nonces, autofill fields and trial token', async t => {
+  const { handle } = setup(t);
+  const first = await page(handle);
+  const second = await page(handle, first.cookie);
+  assert.notEqual(first.nonce, second.nonce);
+  assert.equal(first.response.headers.get('cache-control'), 'no-store');
+  assert.match(first.response.headers.get('set-cookie'), /HttpOnly; SameSite=Lax; Path=\/; Max-Age=3600; Secure/);
+  assert.match(first.html, /autocomplete="email-verification-token"/);
+  assert.match(first.html, /autocomplete="new-password"/);
+  assert.match(first.html, /http-equiv="origin-trial" content="test-trial-token"/);
+  assert.doesNotMatch(first.html, /__FORM_|__STATUS__|__NAME__|__EMAIL__/);
+});
+
+test('empty or invalid proof does not create an account and preserves escaped details', async t => {
+  const { handle, store } = setup(t);
+  const rendered = await page(handle);
+  const response = await submit(handle, rendered, { name: '<script>bad</script>' });
+  const html = await response.text();
+  assert.equal(response.status, 422);
+  assert.match(html, /No email was sent and no account was created/);
+  assert.match(html, /value="&lt;script&gt;bad&lt;\/script&gt;"/);
+  assert.equal(store.db.prepare('SELECT COUNT(*) AS count FROM accounts').get().count, 0);
+  const next = await page(handle, rendered.cookie);
+  assert.equal((await submit(handle, next, { token: 'forged-token' })).status, 422);
+});
+
+test('valid proof persists one verified account with a salted hash, then rejects replay and duplicates', async t => {
+  const { handle, store } = setup(t);
+  const rendered = await page(handle);
+  const token = await proof({ nonce: rendered.nonce });
+  const response = await submit(handle, rendered, { token });
+  assert.equal(response.status, 201);
+  assert.match(await response.text(), /Your email is verified and your account is ready/);
+  const account = store.db.prepare('SELECT * FROM accounts').get();
+  assert.equal(account.email, email);
+  assert.match(account.password_hash, /^scrypt:/);
+  assert.ok(account.verified_at);
+  assert.doesNotMatch(account.password_hash, /coffee/);
+  assert.equal((await submit(handle, rendered, { token })).status, 422);
+  const again = await page(handle, rendered.cookie);
+  assert.equal((await submit(handle, again, { token: await proof({ nonce: again.nonce }) })).status, 409);
+  assert.equal(store.db.prepare('SELECT COUNT(*) AS count FROM accounts').get().count, 1);
+});
+
+test('challenges are bound to a session, expire, and support independent tabs', async t => {
+  const { handle, store } = setup(t);
+  const first = await page(handle);
+  const otherSession = await page(handle);
+  assert.equal((await submit(handle, { ...first, cookie: otherSession.cookie }, { token: await proof({ nonce: first.nonce }) })).status, 422);
+  const second = await page(handle, first.cookie);
+  assert.equal((await submit(handle, first, { token: await proof({ nonce: first.nonce }) })).status, 201);
+  store.db.prepare('UPDATE challenges SET expires = 0 WHERE id = ?').run(second.id);
+  assert.equal((await submit(handle, second, { token: await proof({ nonce: second.nonce }) })).status, 422);
+});
+
+test('rejects cross-origin requests and invalid input, and limits repeated attempts', async t => {
+  const { handle } = setup(t);
+  const rendered = await page(handle);
+  assert.equal((await submit(handle, rendered, {}, 'https://evil.example')).status, 403);
+  assert.equal((await submit(handle, rendered, { password: 'short' })).status, 422);
+  for (let attempt = 0; attempt < 20; attempt++) await submit(handle, rendered);
+  assert.equal((await submit(handle, rendered)).status, 429);
+});
