+    /* Contact form: validate the whole field wrapper after interaction. */
+    .contact {
+      max-width: 640px;
+      margin: 60px auto 0;
+    }
+
+    .contact h2,
+    .contact > p {
+      text-align: center;
+    }
+
+    .contact-form {
+      display: grid;
+      gap: 16px;
+      margin-top: 24px;
+    }
+
+    .contact-field {
+      padding: 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      min-height: 48px;
+      padding: 10px 12px;
+      border: 1px solid #8d7973;
+      border-radius: 4px;
+      color: var(--text);
+      background: var(--light);
+      font: inherit;
+      font-size: 1rem;
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+    }
+
+    .contact-form :focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .contact-field:has(:user-invalid) {
+      border-color: #b3261e;
+    }
+
+    .contact-error {
+      display: none;
+      margin-top: 6px;
+      color: #b3261e;
+      font-size: 0.875rem;
+    }
+
+    .contact-field :user-invalid ~ .contact-error {
+      display: block;
+    }
+
+    .contact-form .btn {
+      justify-self: start;
+      min-height: 48px;
+      margin-top: 0;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
     footer {
