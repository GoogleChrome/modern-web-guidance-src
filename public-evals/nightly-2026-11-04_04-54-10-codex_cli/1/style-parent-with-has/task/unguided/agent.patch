+    /* Contact form */
+    .contact {
+      max-width: 640px;
+    }
+
+    .contact h2,
+    .contact > p {
+      text-align: center;
+    }
+
+    .contact form {
+      display: grid;
+      gap: 16px;
+      margin-top: 20px;
+    }
+
+    .contact-field {
+      padding: 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+    }
+
+    .contact-field input:focus-visible,
+    .contact-field textarea:focus-visible,
+    .contact button:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    /* Highlight the whole wrapper after interaction or a submit attempt. */
+    .contact-field:has(:user-invalid) {
+      border-color: #b3261e;
+    }
+
+    .contact button {
+      justify-self: start;
+      margin-top: 0;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
