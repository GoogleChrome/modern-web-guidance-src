+<body>
+<div class="app">
+  <aside class="sidebar">
+    <a class="logo" href="./" aria-label="Typeform home"><span class="logo-mark">tf</span>typeform<span style="color:#a899c3">.</span></a>
+    <div class="workspace">WORKSPACE</div>
+    <nav aria-label="Main navigation">
+      <a href="#playground" class="nav-item active" data-nav="playground"><span class="nav-icon">▦</span> Playground</a>
+      <a href="#properties" class="nav-item" data-nav="properties"><span class="nav-icon">≡</span> CSS properties</a>
+      <a href="#guide" class="nav-item" data-nav="guide"><span class="nav-icon">▤</span> Quick guide <span style="margin-left:auto;font-size:11px">↗</span></a>
+    </nav>
+    <div class="sidebar-bottom"><div class="note"><strong>A little type. A lot of harmony.</strong>Small CSS details that make<br>your typography feel just right.<span style="display:block;color:#a38dc3;font-size:17px;margin-top:9px">✳</span></div><div class="version"><span class="dot"></span> CSS, moving forward. <span style="margin-left:auto">v1.0</span></div></div>
+  </aside>
+  <div class="content">
+    <header class="topbar"><div class="crumb">Workspace <b class="slash">/</b><span id="breadcrumb">Playground</span></div><div class="top-actions"><a class="github" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">CSS reference <span>↗</span></a><div class="avatar" aria-label="Personal workspace">JD</div></div></header>
+    <main>
+      <div class="eyebrow">THE TYPOGRAPHY PLAYGROUND</div>
+      <div class="heading"><h1>Different fonts. Same rhythm.</h1><span class="badge">CSS LAB</span></div>
+      <p class="intro">Bring mixed fonts into balance with <code>font-size-adjust</code>.<br>A little consistency goes a long way.</p>
+      <div class="toolbar"><div class="tabs" role="tablist" aria-label="Playground view"><button class="tab selected" role="tab" aria-selected="true" data-tab="preview">Preview</button><button class="tab" role="tab" aria-selected="false" data-tab="code">Code</button></div><div class="live"><span class="dot"></span> Live playground</div></div>
+      <section id="playground-view">
+        <section class="panel mixed" aria-label="Mixed font preview">
+          <div class="panel-top"><div class="panel-label"><span class="number">01</span><div><div class="panel-title">A little mix, a perfect match</div><div class="sub">Two font families. One visual height.</div></div></div><span class="chip">from-font</span></div>
+          <div class="specimen"><p id="mixed-fonts-container">Good typography makes <code>great code</code><br>feel right at home.</p><div class="specimen-note" id="alignment-note">X-HEIGHT, ALL ALIGNED</div></div>
+          <div class="controls"><span>Text <span class="font-tag">DM Sans</span></span><span>Code <span class="font-tag">DM Mono</span></span><label class="switch-label"><input type="checkbox" class="switch" id="normalize" checked> Normalize font height</label></div>
+        </section>
+        <div class="lower">
+          <section class="panel"><div class="panel-top"><div class="panel-label"><span class="number">02</span><div><div class="panel-title">A theme of its own</div><div class="sub">Independent by design.</div></div></div><span class="chip">0.52</span></div><div class="theme-body"><div id="independent-theme-container"><span class="theme-kicker">THE INDEPENDENT THEME</span><div><p class="theme-sample">Room to be<br>different.</p><div class="theme-copy">Its own character. Its own proportions.<br>Even when a little <code>code</code> joins in.</div></div><div class="theme-bottom"><span>font-size-adjust: 0.52</span><span>4 : 3 ↗</span></div></div></div><div class="theme-footer"><span>A fixed ratio. A flexible personality.</span><div class="swatches" aria-label="Theme colors"><button class="swatch lavender active" data-theme="lavender" aria-label="Lavender theme" aria-pressed="true"></button><button class="swatch sage" data-theme="sage" aria-label="Sage theme" aria-pressed="false"></button><button class="swatch peach" data-theme="peach" aria-label="Peach theme" aria-pressed="false"></button></div></div></section>
+          <section class="panel code-panel" id="code-panel"><div class="code-head"><span class="file"><span class="file-icon">{ }</span> styles.css</span><button class="copy" id="copy-code" aria-label="Copy CSS"><span>▢</span><span id="copy-label">Copy</span></button></div><pre class="code-block"><code><span class="comment">/* Make different fonts feel equal */</span>
+<span class="selector">#mixed-fonts-container</span> {
+  <span class="property">font-size-adjust</span>: <span class="value">from-font</span>;
+}
+
+<span class="comment">/* Give this theme its own rules */</span>
+<span class="selector">#independent-theme-container</span> {
+  <span class="property">font-size-adjust</span>: <span class="value">0.52</span>;
+  <span class="property">aspect-ratio</span>: <span class="value">4 / 3</span>;
+}</code></pre><div class="code-info"><span class="info-icon">i</span><span>Less tweaking. More harmony.<br>Let the browser do the measuring.</span></div></section>
+        </div>
+      </section>
+      <section id="reference-view" class="panel reference hidden"></section>
+      <footer class="footer"><span>Made for the details. Built with modern CSS.</span><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Explore font-size-adjust <span>↗</span></a></footer>
+    </main>
+  </div>
+</div>
+<script>
+ const mixed = document.getElementById('mixed-fonts-container');
+ document.getElementById('normalize').addEventListener('change', event => {
+   mixed.style.fontSizeAdjust = event.target.checked ? 'from-font' : 'none';
+   document.getElementById('alignment-note').textContent = event.target.checked ? 'X-HEIGHT, ALL ALIGNED' : 'ORIGINAL FONT PROPORTIONS';
+ });
+ const colors = {lavender:['#f0ebfa','#e4dbf3','#675180'],sage:['#eaf0eb','#d8e4da','#506d59'],peach:['#faf0e9','#efdfd3','#8b6650']};
+ document.querySelectorAll('.swatch').forEach(button => button.addEventListener('click', () => {
+   document.querySelectorAll('.swatch').forEach(item => {item.classList.remove('active');item.setAttribute('aria-pressed','false')});
+   button.classList.add('active');button.setAttribute('aria-pressed','true');
+   const theme = document.getElementById('independent-theme-container');const color = colors[button.dataset.theme];
+   theme.style.background = color[0];theme.style.borderColor = color[1];theme.querySelector('.theme-sample').style.color = color[2];
+ }));
+ const cssText = '#mixed-fonts-container {\n  font-size-adjust: from-font;\n}\n\n#independent-theme-container {\n  font-size-adjust: 0.52;\n  aspect-ratio: 4 / 3;\n}';
+ document.getElementById('copy-code').addEventListener('click', async () => {
+   try {await navigator.clipboard.writeText(cssText);document.getElementById('copy-label').textContent='Copied!';setTimeout(()=>document.getElementById('copy-label').textContent='Copy',2000)}
+   catch {document.getElementById('copy-label').textContent='Select to copy';const range=document.createRange();range.selectNodeContents(document.querySelector('.code-block'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range)}
+ });
+ const reference = document.getElementById('reference-view');const preview = document.getElementById('playground-view');
+ function showView(view) {
+   document.querySelectorAll('.nav-item').forEach(item=>item.classList.toggle('active',item.dataset.nav===view));
+   document.getElementById('breadcrumb').textContent = view==='playground'?'Playground':view==='properties'?'CSS properties':'Quick guide';
+   preview.classList.toggle('hidden',view!=='playground');reference.classList.toggle('hidden',view==='playground');
+   if(view==='properties') reference.innerHTML='<h2>Small properties. Thoughtful typography.</h2><p><code>font-size-adjust: from-font</code> uses the first font’s aspect value to maintain a consistent perceived size when mixing font families.</p><p><code>font-size-adjust: 0.52</code> sets an independent x-height to font-size ratio for the theme.</p><p><code>aspect-ratio: 4 / 3</code> sets the theme container’s preferred width-to-height ratio.</p>';
+   if(view==='guide') reference.innerHTML='<h2>Find your font harmony.</h2><p>1. Compare regular text with inline code in the preview.</p><p>2. Toggle “Normalize font height” to compare original and adjusted proportions.</p><p>3. Try a theme color, then copy the CSS into your project.</p>';
+ }
+ document.querySelectorAll('[data-nav]').forEach(link=>link.addEventListener('click',()=>showView(link.dataset.nav)));
+ document.querySelectorAll('[data-tab]').forEach(button=>button.addEventListener('click',()=>{
+   showView('playground');
+   document.querySelectorAll('[data-tab]').forEach(tab=>{tab.classList.toggle('selected',tab===button);tab.setAttribute('aria-selected',String(tab===button))});
+   document.querySelector('.mixed').classList.toggle('hidden',button.dataset.tab==='code');
+   document.querySelector('.lower > section:first-child').classList.toggle('hidden',button.dataset.tab==='code');
+   document.querySelector('.lower').style.gridTemplateColumns=button.dataset.tab==='code'?'1fr':'';
+ }));
+</script>
+</body>
+</html>
