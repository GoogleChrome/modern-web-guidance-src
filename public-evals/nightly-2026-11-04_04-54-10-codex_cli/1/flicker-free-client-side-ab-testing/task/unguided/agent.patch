+  <script>
+    // SDK integration contract: mutate only #experiment-offer, then invoke
+    // window.formeExperiment.ready() or dispatch `experiment:ready` with
+    // detail: { experimentId: 'first-order-offer' }. Async variant work must
+    // finish before signalling. A successful network load is not readiness.
+    (() => {
+      let completed = false;
+      window.formeExperiment = Object.freeze({
+        target: '#experiment-offer',
+        ready() {
+          if (completed) return;
+          const reveal = () => {
+            const region = document.getElementById('experiment-offer');
+            if (!region) return;
+            completed = true;
+            region.dataset.state = 'ready';
+            region.removeAttribute('aria-busy');
+            region.removeAttribute('inert');
+          };
+          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal, {once:true});
+          else reveal();
+        }
+      });
+      window.addEventListener('experiment:ready', event => {
+        if (event.detail?.experimentId === 'first-order-offer') window.formeExperiment.ready();
+      });
+      window.addEventListener('DOMContentLoaded', () => {
+        const sdk = document.createElement('script');
+        sdk.src = 'https://cdn.example.com/experiment-sdk.js';
+        sdk.async = true;
+        sdk.dataset.experimentTarget = '#experiment-offer';
+        sdk.addEventListener('error', () => {
+          if (!completed) document.getElementById('experiment-offer').dataset.state = 'unavailable';
+        }, {once:true});
+        document.head.appendChild(sdk);
+      }, {once:true});
+    })();
