     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const mailingEmail = document.getElementById('mailing-email');
+    const emailErrorText = document.getElementById('mailing-email-error-text');
+    const signupStatus = document.getElementById('mailing-list-status');
+
+    function syncEmailError() {
+      if (mailingEmail.matches(':user-invalid')) {
+        emailErrorText.textContent = mailingEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.';
+        mailingEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        mailingEmail.removeAttribute('aria-invalid');
+      }
+    }
+
+    // Let the browser update its interaction-aware state before syncing ARIA.
+    for (const event of ['blur', 'focus', 'invalid']) {
+      mailingEmail.addEventListener(event, () => requestAnimationFrame(syncEmailError));
+    }
+
+    mailingEmail.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      syncEmailError();
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing-list provider here before accepting subscriptions.
+      signupStatus.textContent = 'Online signup is not available yet. Please try again later.';
+    });
+  </script>
+
