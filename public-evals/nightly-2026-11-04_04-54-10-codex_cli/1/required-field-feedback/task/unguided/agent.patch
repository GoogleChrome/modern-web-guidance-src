@@ -206,7 +279,53 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const signupForm = document.querySelector('#mailing-list-form');
+    const signupEmail = document.querySelector('#mailing-list-email');
+    const signupError = document.querySelector('#mailing-list-error');
+    const signupStatus = document.querySelector('#mailing-list-status');
+    let emailTouched = false;
+
+    function validateEmail() {
+      const message = signupEmail.validity.valueMissing
+        ? 'Please enter your email address.'
+        : signupEmail.validity.typeMismatch
+          ? 'Please enter a valid email address.'
+          : '';
+
+      signupError.textContent = emailTouched ? message : '';
+      if (emailTouched && message) {
+        signupEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        signupEmail.removeAttribute('aria-invalid');
+      }
+      return !message;
+    }
+
+    signupEmail.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    signupEmail.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      validateEmail();
+    });
+
+    signupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signupStatus.textContent = '';
+      if (!validateEmail()) {
+        signupEmail.focus();
+        return;
+      }
+
+      // Connect a mailing-list service here before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
