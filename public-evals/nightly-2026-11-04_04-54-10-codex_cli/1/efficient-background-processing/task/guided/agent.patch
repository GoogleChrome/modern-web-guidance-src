+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const beans = Array.from({ length: 42 }, () => ({
+        x: Math.random() * canvas.width,
+        y: 35 + Math.random() * (canvas.height - 70),
+        angle: Math.random() * Math.PI * 2,
+        speed: 25 + Math.random() * 45,
+        shade: Math.floor(75 + Math.random() * 45)
+      }));
+      let inView = false;
+      let renderingSkipped = false;
+      let running = false;
+      let frameId = null;
+      let intervalId = null;
+      let lastFrame = null;
+      let roastTime = 0;
+
+      function drawBeans(delta) {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        for (const bean of beans) {
+          bean.x = (bean.x + bean.speed * delta) % (canvas.width + 40);
+          bean.angle += delta * 1.2;
+          context.save();
+          context.translate(bean.x - 20, bean.y + Math.sin(bean.angle) * 12);
+          context.rotate(bean.angle);
+          context.fillStyle = `rgb(${bean.shade + 45}, ${bean.shade}, ${bean.shade - 25})`;
+          context.beginPath();
+          context.ellipse(0, 0, 18, 11, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#321c12';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-12, 0);
+          context.bezierCurveTo(-4, -5, 4, 5, 12, 0);
+          context.stroke();
+          context.restore();
+        }
+      }
+
+      function animate(timestamp) {
+        frameId = null;
+        if (!running || reducedMotion.matches) return;
+        const delta = lastFrame === null ? 0 : Math.min((timestamp - lastFrame) / 1000, 0.05);
+        lastFrame = timestamp;
+        drawBeans(delta);
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function stopSimulation() {
+        running = false;
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = null;
+        intervalId = null;
+        lastFrame = null;
+      }
+
+      function syncSimulation() {
+        const shouldRun = inView && !renderingSkipped && !document.hidden;
+        if (!shouldRun) {
+          stopSimulation();
+          return;
+        }
+        if (running) return;
+        running = true;
+        drawBeans(0);
+        if (context && !reducedMotion.matches) frameId = requestAnimationFrame(animate);
+        intervalId = setInterval(() => {
+          roastTime += 1;
+          temperature.textContent = Math.round(180 + 25 * (1 - Math.cos(roastTime / 20)));
+        }, 1000);
+      }
+
+      // Attach directly: rendering-state events do not consistently bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncSimulation();
+        });
+      }
+
+      // Also enforce actual viewport visibility: native rendering may begin offscreen.
+      // This observer doubles as the fallback when rendering-state events are absent.
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inView = entries[entries.length - 1].isIntersecting;
+          syncSimulation();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Older browsers without either API still stop both tasks offscreen.
+        const checkVisibility = () => {
+          const rect = widget.getBoundingClientRect();
+          inView = rect.bottom > 0 && rect.top < window.innerHeight &&
+            rect.right > 0 && rect.left < window.innerWidth;
+          syncSimulation();
+        };
+        window.addEventListener('scroll', checkVisibility, { passive: true, capture: true });
+        window.addEventListener('resize', checkVisibility, { passive: true });
+        window.addEventListener('pageshow', checkVisibility);
+        checkVisibility();
+      }
+
+      document.addEventListener('visibilitychange', syncSimulation);
+      window.addEventListener('pagehide', stopSimulation);
+      window.addEventListener('pageshow', syncSimulation);
+      const handleMotionChange = () => {
+        stopSimulation();
+        syncSimulation();
+      };
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', handleMotionChange);
+      } else {
+        reducedMotion.addListener(handleMotionChange);
+      }
+    })();
+  </script>
+
 </body>
 
