+            target.querySelectorAll('[role="menuitemcheckbox"]').forEach(item => item.setAttribute('aria-checked', 'false'));
+            updateCard(slug); announce(`${drink.name} customizations reset.`);
+          })
+        ], { className: 'btn', heading: drink.name }));
+        target.querySelector('.btn').setAttribute('aria-label', `Make ${drink.name} yours`);
+        updateCard(slug);
+      });
+
+      document.addEventListener('focusin', event => {
+        for (const panel of menus.keys()) {
+          const root = rootOf(panel);
+          if (open(root) && !root.contains(event.target) && event.target !== menus.get(root).trigger) close(root);
+        }
+      });
+      document.addEventListener('keydown', event => {
+        if (event.key === 'Escape' || event.key === 'Tab') {
+          for (const panel of menus.keys()) {
+            if (open(panel) && !panel.parentElement.closest('.menu-panel')) close(panel, event.key === 'Escape');
+          }
+        }
+      });
+      if (!nativePopover) document.addEventListener('click', event => {
+        for (const panel of menus.keys()) if (open(panel) && !panel.contains(event.target) && !menus.get(panel).trigger.contains(event.target)) close(panel);
+      });
+      const reposition = () => { for (const panel of menus.keys()) if (open(panel)) position(panel); };
+      window.addEventListener('resize', reposition);
+      window.addEventListener('scroll', reposition, true);
+    })();
+  </script>
