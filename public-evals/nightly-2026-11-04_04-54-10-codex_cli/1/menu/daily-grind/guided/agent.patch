+          selected.setAttribute('aria-checked', String(state.extras.has(value)));
+          updateCard(slug); announce(`${value} ${state.extras.has(value) ? 'added to' : 'removed from'} ${drink.name}.`);
+        }, { role: 'menuitemcheckbox', checked: false }));
+        target.append(submenu('Make it yours', [
+          link('View drink details', `/menu/${slug === 'maple' ? 'seasonal' : slug}`),
+          button('Add to order', () => {
+            order.push({ id: ++nextOrderId, name: drink.name, description: description(state), price: priceFor(slug) });
+            renderOrder(); document.querySelector('.order-summary').hidden = false;
+            announce(`${drink.name} added to your order. ${description(state)}. ${money(priceFor(slug))}.`);
+          }),
+          submenu('Customize drink', [
+            submenu('Size', [radios('size', 'Size', ['Small', 'Medium', 'Large'])], { heading: 'Medium +$0.50 · Large +$1.00' }),
+            submenu('Milk', [radios('milk', 'Milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk'])]),
+            submenu('Extras', extras, { heading: 'Make it extra · +$0.75 each' })
+          ]),
+          separator(),
+          button('Reset customizations', () => {
+            state.size = 'Small'; state.milk = drink.milk; state.extras.clear();
