+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host { display: block; }
+    :host([hidden]) { display: none; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      color: var(--text, #3e2723);
+    }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .featured { color: var(--primary, #4e342e); font-weight: bold; }
+    .price { margin-top: 10px; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+    [hidden] { display: none; }
+  </style>
+  <article part="card" aria-labelledby="name">
+    <p class="featured" hidden>Seasonal favorite</p>
+    <h3 id="name" part="name"></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a part="link">View Details</a>
+  </article>
+`;
+
+/** Autonomous coffee card. Attributes are the source of truth for its public API. */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  #name;
+  #description;
+  #price;
+  #featured;
+  #link;
+  #connection;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#name = root.querySelector('h3');
+    this.#description = root.querySelector('.description');
+    this.#price = root.querySelector('.price');
+    this.#featured = root.querySelector('.featured');
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Recover values assigned while this tag was still an unknown HTMLElement.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+
+    this.#render();
+    this.#connection?.abort();
+    this.#connection = new AbortController();
+    this.#link.addEventListener('click', () => {
+      this.dispatchEvent(new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        detail: { name: this.name, href: this.href, price: this.price, featured: this.featured },
+      }));
+    }, { signal: this.#connection.signal });
+  }
+
+  disconnectedCallback() {
+    this.#connection?.abort();
+    this.#connection = undefined;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#reflectString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#reflectString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#reflectString('href', value); }
+
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    this.setAttribute('price', String(Number.isFinite(number) && number >= 0 ? number : 0));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  #reflectString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  #render() {
+    this.#name.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#featured.hidden = !this.featured;
+    this.#price.hidden = !this.hasAttribute('price');
+    this.#price.textContent = `$${this.price.toFixed(2)}`;
+
+    // Keep native link behavior, but do not accept executable URL schemes.
+    let safeHref = false;
+    try {
+      safeHref = ['http:', 'https:'].includes(new URL(this.href, this.baseURI).protocol);
+    } catch {
+      // Invalid URLs render as an inert link label.
+    }
+    if (this.href && safeHref) this.#link.setAttribute('href', this.href);
+    else this.#link.removeAttribute('href');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
