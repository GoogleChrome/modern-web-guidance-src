+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const actionClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded'
+    };
+
+    function applyCommand(command) {
+      if (command === '--reset') {
+        actionTarget.classList.remove(...Object.values(actionClasses));
+      } else if (Object.hasOwn(actionClasses, command)) {
+        actionTarget.classList.toggle(actionClasses[command]);
+      }
+    }
+
+    actionTarget.addEventListener('command', (event) => {
+      applyCommand(event.command);
+    });
+
+    // Support browsers that do not yet dispatch declarative button commands.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.querySelectorAll('button[commandfor="action-target"]').forEach((button) => {
+        button.addEventListener('click', () => applyCommand(button.getAttribute('command')));
+      });
+    }
+  </script>
+
