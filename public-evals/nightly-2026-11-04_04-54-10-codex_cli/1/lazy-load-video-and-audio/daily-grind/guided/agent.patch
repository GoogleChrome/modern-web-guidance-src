diff --git a/tests/media-loading.test.cjs b/tests/media-loading.test.cjs
new file mode 100644
index 0000000..b7e80f4
--- /dev/null
+++ b/tests/media-loading.test.cjs
@@ -0,0 +1,122 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+
+const html = readFileSync(path.join(__dirname, '../index.html'), 'utf8');
+const script = readFileSync(path.join(__dirname, '../media.js'), 'utf8');
+
+function setup({ native = false, intersection = true } = {}) {
+  const players = [...html.matchAll(/<(?:video|audio)\b[^>]*loading="lazy"[^>]*>/g)].map(([tag]) => {
+    const attributes = new Map([...tag.matchAll(/([\w-]+)="([^"]*)"/g)].map(([, key, value]) => [key, value]));
+    const events = {};
+    return {
+      attributes, events,
+      hasAttribute: (key) => attributes.has(key),
+      getAttribute: (key) => attributes.get(key),
+      setAttribute: (key, value) => attributes.set(key, value),
+      removeAttribute: (key) => attributes.delete(key),
+      querySelectorAll: () => [],
+      addEventListener: (name, callback) => { events[name] = callback; },
+    };
+  });
+  let observer;
+  class MediaElement {}
+  if (native) Object.defineProperty(MediaElement.prototype, 'loading', { value: 'eager' });
+  class Observer {
+    constructor(callback, options) {
+      this.callback = callback;
+      this.options = options;
+      this.observed = new Set();
+      observer = this;
+    }
+    observe(player) { this.observed.add(player); }
+    unobserve(player) { this.observed.delete(player); }
+  }
+  const window = intersection ? { IntersectionObserver: Observer } : {};
+  vm.runInNewContext(script, {
+    document: { querySelectorAll: () => players },
+    HTMLMediaElement: MediaElement,
+    window,
+    ...(intersection ? { IntersectionObserver: Observer } : {}),
+  });
+  return { players, observer };
+}
+
+test('initial HTML keeps offscreen posters, media, and captions inert', () => {
+  const lazyTags = [...html.matchAll(/<(video|audio)\b[^>]*loading="lazy"[^>]*>/g)];
+  assert.equal(lazyTags.length, 2);
+  for (const [tag, type] of lazyTags) {
+    assert.doesNotMatch(tag, /\s(?:src|poster)="/);
+    assert.match(tag, /\spreload="none"/);
+    assert.match(tag, /\sdata-src="https:/);
+    assert.match(tag, /\scontrols\b/);
+    if (type === 'video') {
+      assert.match(tag, /width="\d+"/);
+      assert.match(tag, /height="\d+"/);
+      assert.match(tag, /data-poster="https:/);
+    }
+  }
+  const roasting = html.match(/<video[^>]*loading="lazy"[\s\S]*?<\/video>/)[0];
+  assert.doesNotMatch(roasting, /\ssrc="/);
+  assert.doesNotMatch(html, /<link[^>]+(?:4676|hpr3563)/);
+  assert.equal((html.match(/<noscript>/g) || []).length, 2);
+});
+
+test('hero remains eager and reserves its layout space', () => {
+  const hero = html.match(/<video\b[^>]*>/)[0];
+  assert.doesNotMatch(hero, /loading="lazy"/);
+  assert.match(hero, /\ssrc="https:/);
+  assert.match(hero, /\sposter="https:/);
+  assert.match(hero, /width="1280" height="720"/);
+  assert.doesNotMatch(html, /\sautoplay\b/);
+});
+
+test('fallback makes no offscreen resources fetchable on startup', () => {
+  const { players, observer } = setup();
+  assert.equal(observer.options.rootMargin, '200px 0px');
+  assert.equal(observer.observed.size, 2);
+  observer.callback(players.map((target) => ({ target, isIntersecting: false })));
+  for (const player of players) {
+    assert.equal(player.hasAttribute('src'), false);
+    assert.equal(player.hasAttribute('poster'), false);
+    assert.equal(player.getAttribute('preload'), 'none');
+  }
+});
+
+test('approaching one player activates only its resources and unobserves it', () => {
+  const { players, observer } = setup();
+  const [video, audio] = players;
+  observer.callback([{ target: video, isIntersecting: true }]);
+  assert.match(video.getAttribute('src'), /4676-720.mp4$/);
+  assert.match(video.getAttribute('poster'), /4676-thumb-720-0.jpg$/);
+  assert.equal(video.getAttribute('preload'), 'metadata');
+  assert.equal(video.hasAttribute('data-src'), false);
+  assert.equal(observer.observed.has(video), false);
+  assert.equal(audio.hasAttribute('src'), false);
+  observer.callback([{ target: audio, isIntersecting: true }]);
+  assert.match(audio.getAttribute('src'), /hpr3563.mp3$/);
+  assert.equal(audio.getAttribute('preload'), 'metadata');
+  assert.equal(observer.observed.size, 0);
+});
+
+test('native media lazy loading receives URLs without losing loading hints', () => {
+  const { players, observer } = setup({ native: true });
+  assert.equal(observer, undefined);
+  for (const player of players) {
+    assert.equal(player.getAttribute('loading'), 'lazy');
+    assert.equal(player.getAttribute('preload'), 'metadata');
+    assert.equal(player.hasAttribute('src'), true);
+  }
+});
+
+test('without IntersectionObserver, media stays deferred until pointer or keyboard intent', () => {
+  const { players } = setup({ intersection: false });
+  for (const player of players) assert.equal(player.hasAttribute('src'), false);
+  players[0].events.pointerdown();
+  assert.equal(players[0].hasAttribute('src'), true);
+  assert.equal(players[1].hasAttribute('src'), false);
+  players[1].events.focusin();
+  assert.equal(players[1].hasAttribute('src'), true);
+});
