diff --git a/media.js b/media.js
new file mode 100644
index 0000000..63bacae
--- /dev/null
+++ b/media.js
@@ -0,0 +1,48 @@
+(() => {
+  const players = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"]');
+  const supportsLazyMedia = Object.hasOwn(HTMLMediaElement.prototype, 'loading');
+
+  function activate(player) {
+    if (!player.hasAttribute('data-src')) return;
+
+    // Restore the poster and preload hint before selecting the media resource.
+    for (const attribute of ['poster', 'preload', 'src']) {
+      if (player.hasAttribute(`data-${attribute}`)) {
+        player.setAttribute(attribute, player.getAttribute(`data-${attribute}`));
+        player.removeAttribute(`data-${attribute}`);
+      }
+    }
+    for (const track of player.querySelectorAll('track[data-src]')) {
+      track.src = track.dataset.src;
+      delete track.dataset.src;
+    }
+    // Assigning src starts resource selection. Native lazy loading gates it;
+    // the fallback only assigns it after intersection or explicit interaction.
+  }
+
+  if (supportsLazyMedia) {
+    players.forEach(activate);
+    return;
+  }
+
+  const observer = 'IntersectionObserver' in window
+    ? new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: '200px 0px' })
+    : null;
+
+  for (const player of players) {
+    observer?.observe(player);
+    // Keep players usable even when IntersectionObserver is unavailable.
+    const activateOnIntent = () => {
+      activate(player);
+      observer?.unobserve(player);
+    };
+    player.addEventListener('pointerdown', activateOnIntent, { once: true });
+    player.addEventListener('focusin', activateOnIntent, { once: true });
+  }
+})();
