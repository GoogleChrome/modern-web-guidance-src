diff --git a/media.js b/media.js
new file mode 100644
index 0000000..b0311db
--- /dev/null
+++ b/media.js
@@ -0,0 +1,72 @@
+(() => {
+  const players = document.querySelectorAll('[data-lazy-media]');
+  const pending = new Set(players);
+  const proximity = 300;
+
+  function activate(player) {
+    if (!pending.delete(player)) return;
+
+    // Keep URLs inert until near the viewport: preload="none" alone does
+    // not prevent poster downloads, and browsers may override preload hints.
+    if (player.dataset.poster) {
+      player.setAttribute('poster', player.dataset.poster);
+      delete player.dataset.poster;
+    }
+
+    const showError = () => {
+      const message = player.parentElement.querySelector('.media-error');
+      if (message) message.hidden = false;
+    };
+    player.addEventListener('error', showError, { once: true });
+    player.querySelectorAll('source[data-src]').forEach(source => {
+      source.addEventListener('error', showError, { once: true });
+      source.setAttribute('src', source.dataset.src);
+      delete source.dataset.src;
+    });
+    player.preload = 'metadata';
+    player.load();
+  }
+
+  // Keyboard and pointer interaction should work even before an observer
+  // callback, including when a player is reached by tabbing down the page.
+  players.forEach(player => {
+    player.addEventListener('focusin', () => activate(player), { once: true });
+    player.addEventListener('pointerdown', () => activate(player), { once: true });
+  });
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver(entries => {
+      entries.forEach(entry => {
+        if (!entry.isIntersecting) return;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      });
+    }, { rootMargin: `${proximity}px 0px`, threshold: 0 });
+    players.forEach(player => observer.observe(player));
+  } else {
+    // Older browsers still defer offscreen assets instead of loading all
+    // players eagerly when IntersectionObserver is unavailable.
+    let scheduled = false;
+    function checkProximity() {
+      scheduled = false;
+      pending.forEach(player => {
+        const bounds = player.getBoundingClientRect();
+        if (bounds.top <= window.innerHeight + proximity && bounds.bottom >= -proximity) {
+          activate(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', scheduleCheck);
+        window.removeEventListener('resize', scheduleCheck);
+      }
+    }
+    function scheduleCheck() {
+      if (scheduled) return;
+      scheduled = true;
+      window.requestAnimationFrame(checkProximity);
+    }
+    window.addEventListener('scroll', scheduleCheck, { passive: true });
+    window.addEventListener('resize', scheduleCheck);
+    checkProximity();
+  }
+})();
