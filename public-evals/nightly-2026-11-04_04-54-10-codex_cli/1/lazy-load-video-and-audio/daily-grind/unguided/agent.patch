diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..f99135f
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,109 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const script = readFileSync('media.js', 'utf8');
+
+function setup(useObserver = true) {
+  const makePlayer = (top, poster) => {
+    const source = {
+      dataset: { src: 'https://example.com/media' },
+      addEventListener() {},
+      setAttribute(key, value) { this[key] = value; },
+    };
+    return {
+      dataset: poster ? { poster: 'https://example.com/poster.jpg' } : {},
+      source, top, loads: 0, events: {}, preload: 'none',
+      parentElement: { querySelector: () => null },
+      querySelectorAll: () => [source],
+      addEventListener(event, callback) { this.events[event] = callback; },
+      setAttribute(key, value) { this[key] = value; },
+      getBoundingClientRect() { return { top: this.top, bottom: this.top + 200 }; },
+      load() { this.loads++; },
+    };
+  };
+  const players = [makePlayer(100, true), makePlayer(2000, true), makePlayer(3000, false)];
+  const listeners = {};
+  let callback, options;
+  const unobserved = [];
+  const window = {
+    innerHeight: 800,
+    addEventListener(name, fn) { listeners[name] = fn; },
+    removeEventListener(name) { delete listeners[name]; },
+    requestAnimationFrame(fn) { fn(); },
+  };
+  class Observer {
+    constructor(cb, opts) { callback = cb; options = opts; }
+    observe() {}
+    unobserve(player) { unobserved.push(player); }
+  }
+  if (useObserver) window.IntersectionObserver = Observer;
+  runInNewContext(script, {
+    document: { querySelectorAll: () => players },
+    window, IntersectionObserver: useObserver ? Observer : undefined,
+  });
+  return { players, listeners, options, unobserved, intersect: entries => callback(entries) };
+}
+
+test('offscreen posters, video sources, and audio sources remain inert', () => {
+  const { players, intersect, options } = setup();
+  assert.equal(options.rootMargin, '300px 0px');
+  intersect(players.map(target => ({ target, isIntersecting: false })));
+  for (const player of players) {
+    assert.equal(player.source.src, undefined);
+    assert.equal(player.poster, undefined);
+    assert.equal(player.preload, 'none');
+    assert.equal(player.loads, 0);
+  }
+});
+
+test('approaching players receive their poster, source, and metadata exactly once', () => {
+  const { players, intersect, unobserved } = setup();
+  for (const target of players) {
+    intersect([{ target, isIntersecting: true }]);
+    assert.equal(target.source.src, 'https://example.com/media');
+    assert.equal(target.preload, 'metadata');
+    assert.equal(target.loads, 1);
+    target.events.focusin();
+    target.events.pointerdown();
+    assert.equal(target.loads, 1);
+  }
+  assert.equal(players[0].poster, 'https://example.com/poster.jpg');
+  assert.equal(players[1].poster, 'https://example.com/poster.jpg');
+  assert.equal(unobserved.length, 3);
+});
+
+test('fallback loads only nearby players and responds to scrolling', () => {
+  const { players, listeners } = setup(false);
+  assert.deepEqual(players.map(p => p.loads), [1, 0, 0]);
+  players[1].top = 1050;
+  listeners.scroll();
+  assert.deepEqual(players.map(p => p.loads), [1, 1, 0]);
+  players[2].top = 800;
+  listeners.resize();
+  assert.deepEqual(players.map(p => p.loads), [1, 1, 1]);
+  assert.equal(listeners.scroll, undefined);
+  assert.equal(listeners.resize, undefined);
+});
+
+test('keyboard interaction activates a player before the observer callback', () => {
+  const { players } = setup();
+  players[2].events.focusin();
+  assert.equal(players[2].loads, 1);
+  assert.equal(players[1].loads, 0);
+});
+
+test('homepage markup exposes no eager media sources or posters', () => {
+  const html = readFileSync('index.html', 'utf8');
+  const mediaTags = html.match(/<(?:video|audio|source)\b[^>]*>/g);
+  assert.equal(mediaTags.length, 6);
+  for (const tag of mediaTags) {
+    assert.doesNotMatch(tag, /\s(?:src|poster|autoplay)\s*=/);
+    if (!tag.startsWith('<source')) {
+      assert.match(tag, /preload="none"/);
+      assert.match(tag, /data-lazy-media/);
+    }
+  }
+  assert.doesNotMatch(html, /<link\b[^>]*rel="preload"/);
+});
