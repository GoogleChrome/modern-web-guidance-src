+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <!-- Keep initial theme/layout scripts in the head; async or module scripts
+       that affect the first frame must also use blocking="render". -->
+  <link rel="stylesheet" blocking="render" href="/assets/site.css">
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&amp;fit=crop&amp;w=1350&amp;q=80" fetchpriority="high">
+  <link rel="expect" blocking="render" href="#site-header-ready">
+  <link rel="expect" blocking="render" href="#hero-ready">
+  <link rel="expect" blocking="render" href="#main-content-ready">
+</head>
+
+<body>
+
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/" aria-label="The Daily Grind homepage">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+    <span id="site-header-ready" hidden></span>
+  </nav>
+
+  <header class="hero">
+    <h1>Your Neighborhood Coffee Break</h1>
+    <p>A good day starts with your local Daily Grind.</p>
+    <a href="/" class="btn">Back to Home</a>
+    <span id="hero-ready" hidden></span>
+  </header>
+
+  <main class="container">
+    <section aria-labelledby="locations-heading">
+      <h2 id="locations-heading" class="section-title">Visit The Daily Grind</h2>
+      <div class="grid">
+        <article class="card">
+          <h3>Find Your Local Shop</h3>
+          <p>Get in touch for our current shop locations, opening hours, and accessibility information.</p>
+          <a href="/contact" class="btn">Contact Us</a>
+        </article>
+        <article class="card">
+          <h3>Something for Every Coffee Break</h3>
+          <p>Explore our coffee and seasonal favorites before your visit.</p>
+          <a href="/menu/" class="btn">Explore the Menu</a>
+        </article>
+      </div>
+    </section>
+    <!-- End marker waits for the complete section, without waiting for the footer. -->
+    <span id="main-content-ready" hidden></span>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
