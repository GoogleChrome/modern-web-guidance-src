index 0000000..1c8bca1
--- /dev/null
+++ b/seasonal-favorites.js
@@ -0,0 +1,50 @@
+(() => {
+  'use strict';
+
+  const container = document.getElementById('seasonal-favorites');
+  if (!container) return;
+
+  // Fail closed if the sanitizer cannot load or does not support this browser.
+  if (!window.DOMPurify?.isSupported) {
+    container.textContent = 'Seasonal favorites are temporarily unavailable.';
+    return;
+  }
+
+  const cards = [
+    `<div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>`,
+    `<div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>`,
+    `<div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>`,
+  ];
+
+  const sanitize = (html) => window.DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: ['div', 'h3', 'p', 'a'],
+    ALLOWED_ATTR: ['class', 'href'],
+    ALLOW_DATA_ATTR: false,
+    ALLOW_ARIA_ATTR: false,
+    // createHTML callbacks must return strings, not TrustedHTML.
+    RETURN_TRUSTED_TYPE: false,
+  });
+
+  // There is deliberately no default policy: other raw-string sink writes are
+  // rejected by CSP in browsers with Trusted Types support. DOMPurify's own
+  // policy is also allowed so it can parse input in its inert document.
+  const policy = window.trustedTypes?.createPolicy('daily-grind', {
+    createHTML: sanitize,
+  });
+
+  const html = cards.join('');
+  // Sanitize in every browser, including those without Trusted Types support.
+  container.innerHTML = policy ? policy.createHTML(html) : sanitize(html);
+})();
