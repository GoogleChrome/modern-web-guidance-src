@@ -0,0 +1,149 @@
+import { useEffect, useRef, useState } from 'react';
+import type { FormEvent, ReactNode } from 'react';
+import './diagnostics.css';
+
+type Kind = 'device' | 'cli';
+type Status = 'idle' | 'connecting' | 'connected' | 'error';
+type Connection = { status: Status; message: string; latency?: number; checked?: string };
+type Entry = { id: number; time: string; kind: Kind; message: string; error?: boolean };
+const initial: Connection = { status: 'idle', message: 'Ready when you are. Enter your endpoint to get started.' };
+const config = {
+  device: { name: 'Hardware test device', label: 'Device endpoint', address: 'http://192.168.1.100:8080/health', space: 'local', permission: 'local-network' },
+  cli: { name: 'Local companion CLI', label: 'CLI endpoint', address: 'http://127.0.0.1:3001/health', space: 'loopback', permission: 'loopback-network' },
+} as const;
+
+function Icon({ name, size = 20 }: { name: string; size?: number }) {
+  const paths: Record<string, ReactNode> = {
+    device: <><rect x="5" y="5" width="14" height="14" rx="3"/><path d="M9 9h6v6H9zM9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3"/></>,
+    cli: <><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 9 3 3-3 3m6 0h4"/></>,
+    arrow: <path d="M4 12h16m-6-6 6 6-6 6"/>,
+    shield: <><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></>,
+    help: <><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-1.5 1-1.5 1-1.5 3m0 3h.01"/></>,
+    plug: <><path d="M9 3v5m6-5v5M6 8h12v3a6 6 0 0 1-12 0V8Zm6 9v4"/></>,
+    activity: <path d="M2 12h5l3-8 4 16 3-8h5"/>,
+    lock: <><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></>,
+  };
+  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{paths[name] || paths.plug}</svg>;
+}
+
+// Keep each endpoint in its intended address space, including on browsers without LNA support.
+export function validateEndpoint(value: string, kind: Kind): URL {
+  let url: URL;
+  try { url = new URL(value.trim()); } catch { throw new Error('Enter a full endpoint URL, including http:// or https://.'); }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const octets = host.split('.').map(Number);
+  const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+  const privateIP = ipv4 && (octets[0] === 10 || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) || (octets[0] === 192 && octets[1] === 168) || (octets[0] === 169 && octets[1] === 254));
+  const privateIPv6 = /^\[f[cd][0-9a-f]{2}:/.test(host) || /^\[fe[89ab][0-9a-f]:/.test(host);
+  if (kind === 'cli' && !loopback) throw new Error('Use 127.0.0.1, localhost, or [::1] for the companion on this machine.');
+  if (kind === 'device' && !(privateIP || privateIPv6 || host.endsWith('.local'))) {
+    throw new Error('Use a private LAN IP (such as 192.168.1.100) or a .local device hostname.');
+  }
+  return url;
+}
+
+export default function DeveloperDiagnostics() {
+  const [tab, setTab] = useState<'connections' | 'activity'>('connections');
+  const [help, setHelp] = useState(false);
+  const [addresses, setAddresses] = useState({ device: config.device.address as string, cli: config.cli.address as string });
+  const [connections, setConnections] = useState<Record<Kind, Connection>>({ device: initial, cli: initial });
+  const [entries, setEntries] = useState<Entry[]>([]);
+  const controllers = useRef<Partial<Record<Kind, AbortController>>>({});
+  const sequence = useRef(0);
+  useEffect(() => () => { Object.values(controllers.current).forEach(c => c?.abort()); controllers.current = {}; }, []);
+  const log = (kind: Kind, message: string, error = false) => setEntries(old => [{ id: ++sequence.current, time: new Date().toLocaleTimeString(), kind, message, error }, ...old].slice(0, 50));
+  const update = (kind: Kind, value: Connection) => setConnections(old => ({ ...old, [kind]: value }));
+
+  async function connect(event: FormEvent, kind: Kind) {
+    event.preventDefault();
+    const controller = new AbortController();
+    controllers.current[kind]?.abort();
+    controllers.current[kind] = controller;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let timedOut = false;
+    try {
+      const url = validateEndpoint(addresses[kind], kind);
+      if (!window.isSecureContext) throw new Error('Open this site over HTTPS to enable local connections.');
+      update(kind, { status: 'connecting', message: 'Waiting for your endpoint. Allow browser access if prompted.' });
+      log(kind, `Connecting to ${url.origin}${url.pathname}`);
+      // Unsupported permission names are expected in some browsers; the request remains user initiated.
+      let permission: PermissionState | undefined;
+      try { permission = (await navigator.permissions.query({ name: config[kind].permission as PermissionName })).state; } catch { /* Try the standard request below. */ }
+      if (controllers.current[kind] !== controller) return;
+      if (permission === 'denied') throw new Error('Access is blocked. Allow local network or loopback access in your browser’s site settings, then retry.');
+      timer = setTimeout(() => { timedOut = true; controller.abort(); }, 15000);
+      const start = performance.now();
+      const options: RequestInit & { targetAddressSpace: 'local' | 'loopback' } = {
+        method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store', redirect: 'error',
+        referrerPolicy: 'no-referrer', signal: controller.signal, targetAddressSpace: config[kind].space,
+      };
+      const response = await fetch(url.href, options);
+      if (!response.ok) throw new Error(`Endpoint returned HTTP ${response.status}. Check the health endpoint and retry.`);
+      const latency = Math.round(performance.now() - start);
+      // A readable, successful response confirms reachability; no specific payload is required.
+      await response.body?.cancel();
+      if (controllers.current[kind] !== controller) return;
+      update(kind, { status: 'connected', message: `Endpoint responded successfully (HTTP ${response.status}).`, latency, checked: new Date().toLocaleTimeString() });
+      log(kind, `Connection verified · HTTP ${response.status} · ${latency} ms`);
+    } catch (error) {
+      if (controllers.current[kind] !== controller) return;
+      const message = timedOut ? 'No response after 15 seconds. Check the address, service, and network, then retry.'
+        : error instanceof TypeError ? 'Could not reach the endpoint. Check the service, browser site permissions, and CORS configuration.'
+        : error instanceof Error ? error.message : 'Connection failed. Please retry.';
+      update(kind, { status: 'error', message });
+      log(kind, message, true);
+    } finally { if (timer) clearTimeout(timer); }
+  }
+  function disconnect(kind: Kind) {
+    controllers.current[kind]?.abort();
+    delete controllers.current[kind];
+    update(kind, { status: 'idle', message: 'Disconnected. You can connect again at any time.' });
+    log(kind, 'Disconnected');
+  }
+  const count = Object.values(connections).filter(c => c.status === 'connected').length;
+
+  return <section className="diagnostics" aria-labelledby="diagnostics-title">
+    <div className="diag-eyebrow"><span><span className="diag-tiny-square"/> THE DEVELOPER WORKBENCH</span><span className="diag-edition">TOOLS FOR THE CURIOUS</span></div>
+    <div className="diag-heading"><div><h1 id="diagnostics-title">A closer look, <em>connected.</em></h1><p>Your hardware. Your local tools. One place to see what’s happening.</p></div><span className="diag-lab-badge"><span/> DEVELOPER DIAGNOSTICS</span></div>
+    <div className="diag-workspace">
+      <div className="diag-toolbar"><div className="diag-tabs" role="tablist" aria-label="Diagnostics views" onKeyDown={event => {
+        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+        event.preventDefault();
+        const next = event.key === 'Home' ? 'connections' : event.key === 'End' ? 'activity' : tab === 'connections' ? 'activity' : 'connections';
+        setTab(next);
+        event.currentTarget.querySelector<HTMLButtonElement>(`#${next}-tab`)?.focus();
+      }}>
+        <button id="connections-tab" role="tab" tabIndex={tab === 'connections' ? 0 : -1} aria-selected={tab === 'connections'} aria-controls="connections-panel" onClick={() => setTab('connections')}><Icon name="plug" size={16}/> Connections <span className="diag-count">{count}/2</span></button>
+        <button id="activity-tab" role="tab" tabIndex={tab === 'activity' ? 0 : -1} aria-selected={tab === 'activity'} aria-controls="activity-panel" onClick={() => setTab('activity')}><Icon name="activity" size={16}/> Activity log {entries.length > 0 && <span className="diag-count">{entries.length}</span>}</button>
+      </div><button className="diag-help-button" aria-expanded={help} aria-controls="diag-setup" onClick={() => setHelp(!help)}><Icon name="help" size={16}/><span>Setup guide</span></button></div>
+      <div id="connections-panel" role="tabpanel" aria-labelledby="connections-tab" hidden={tab !== 'connections'}>
+        <div className="diag-intro"><div><h2>Make a local connection</h2><p>Connect to a test device or companion service to check its availability.</p></div><span className="diag-session"><span/> {count ? `${count} of 2 verified` : 'No active connections'}</span></div>
+        <div className="diag-cards">{(['device', 'cli'] as Kind[]).map((kind, index) => {
+          const state = connections[kind];
+          return <form className={`diag-card diag-card-${kind} diag-card-${state.status}`} key={kind} onSubmit={e => connect(e, kind)}>
+            <div className="diag-card-top"><div className={`diag-icon diag-icon-${kind}`}><Icon name={kind} size={25}/></div><span className={`diag-status ${state.status}`}><span/>{({idle: 'Not connected', connecting: 'Connecting', connected: 'Connected', error: 'Connection failed'})[state.status]}</span></div>
+            <div className="diag-card-title"><h3>{config[kind].name}</h3><span>0{index + 1}</span></div>
+            <p className="diag-card-description">{kind === 'device' ? 'Reach a hardware device on your private Wi-Fi network.' : 'Reach the companion service running on this computer.'}</p>
+            <div className="diag-network"><span className="diag-network-line"/><span>{kind === 'device' ? 'PRIVATE NETWORK' : 'THIS MACHINE'}</span><code>{kind === 'device' ? '192.168.x.x' : '127.0.0.1'}</code></div>
+            <label htmlFor={`endpoint-${kind}`}>{config[kind].label}</label>
+            <div className="diag-input-wrap"><Icon name={kind === 'device' ? 'device' : 'cli'} size={16}/><input id={`endpoint-${kind}`} type="url" required spellCheck={false} autoCapitalize="none" autoComplete="off" value={addresses[kind]} disabled={state.status === 'connecting' || state.status === 'connected'} onChange={e => { setAddresses(old => ({ ...old, [kind]: e.target.value })); update(kind, initial); }} aria-describedby={`hint-${kind} message-${kind}`} /></div>
+            <p id={`hint-${kind}`} className="diag-input-hint">{kind === 'device' ? 'Use the address and health path provided by your device.' : 'Use the port and health path configured in your CLI.'}</p>
+            {state.status === 'connected' ? <div className="diag-connected-actions"><button type="submit" className="diag-connect">Check again <Icon name="activity" size={16}/></button><button type="button" className="diag-disconnect" onClick={() => disconnect(kind)}>Disconnect</button></div>
+              : state.status === 'connecting' ? <button className="diag-connect" type="button" onClick={() => disconnect(kind)}><span className="diag-spinner"/> Cancel connection</button>
+              : <button className="diag-connect" type="submit">{state.status === 'error' ? 'Retry connection' : kind === 'device' ? 'Connect to device' : 'Connect to CLI'}<Icon name="arrow" size={18}/></button>}
+            <div id={`message-${kind}`} className={`diag-card-message ${state.status === 'error' ? 'diag-error-message' : ''}`} role="status">{state.status === 'idle' ? <><Icon name="lock" size={13}/> {kind === 'device' ? 'Your browser may ask for local network access.' : 'Your browser may ask for access to this machine.'}</> : state.message}{state.checked && <small>Last checked {state.checked} · {state.latency} ms</small>}</div>
+          </form>;
+        })}</div>
+        <div className="diag-privacy"><Icon name="shield" size={19}/><div><strong>Local by design.</strong> Connections go directly from your browser to your endpoints. <span>Only the endpoints you connect to are contacted.</span></div></div>
+      </div>
+      <div id="activity-panel" role="tabpanel" aria-labelledby="activity-tab" hidden={tab !== 'activity'} className="diag-activity"><div className="diag-intro"><div><h2>Connection activity</h2><p>Recent checks from this session. The latest event appears first.</p></div><button className="diag-text-button" disabled={!entries.length} onClick={() => setEntries([])}>Clear log</button></div>{entries.length ? <ol>{entries.map(entry => <li key={entry.id} className={entry.error ? 'diag-log-error' : ''}><time>{entry.time}</time><strong>{entry.kind === 'device' ? 'DEVICE' : 'CLI'}</strong><span>{entry.message}</span></li>)}</ol> : <div className="diag-empty"><Icon name="activity" size={32}/><h3>A fresh start.</h3><p>Connect to an endpoint and your activity will appear here.</p><button onClick={() => setTab('connections')} className="diag-text-button">Go to connections →</button></div>}</div>
+      {help && <div className="diag-setup" id="diag-setup"><h2>A little setup goes a long way.</h2><div><section><h3>01 / Prepare your endpoints</h3><p>Join the same Wi-Fi as your test device. Start your companion CLI’s HTTP service on this computer. Replace the example URLs with each service’s actual health endpoint; a successful GET response confirms availability.</p></section><section><h3>02 / Allow the connection</h3><p>Use this site over HTTPS. Allow local network or loopback access when your browser asks. Each endpoint must allow this site’s origin with the <code>Access-Control-Allow-Origin</code> response header. If blocked, review browser site permissions and your endpoint’s CORS settings.</p></section></div><p className="diag-setup-foot">Checks are on demand, with a 15-second timeout. “Connected” means the last check succeeded; it does not open a persistent stream. Browser support varies. <a href="https://developer.chrome.com/docs/modern-web-guidance/guides/security/local-network-access" target="_blank" rel="noreferrer">About browser network access ↗</a></p></div>}
+      <div className="diag-workspace-footer"><span><span className="diag-footer-dot"/> BROWSER → LOCAL ENDPOINT</span><span>Built for your debugging workflow.</span></div>
+    </div>
+    <div className="diag-bottom"><span>GOOD TO KNOW</span><p>Two connections. Independent permissions. You’re in control of both.</p><button onClick={() => setHelp(!help)}>How it works <span>↗</span></button></div>
+  </section>;
+}
