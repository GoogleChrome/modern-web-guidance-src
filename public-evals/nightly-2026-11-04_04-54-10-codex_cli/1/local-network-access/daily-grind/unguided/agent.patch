+(() => {
+  const forms = [...document.querySelectorAll('.device')];
+  const active = new Map();
+  const defaults = {
+    brewer: 'Join the same Wi-Fi network as your brewer.',
+    helper: 'Open the brewing helper on this computer first.'
+  };
+
+  function validateEndpoint(value, kind) {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS endpoint without credentials or a fragment.');
+    }
+    const parts = url.hostname.split('.');
+    const ipv4 = parts.length === 4 && parts.every(part => /^\d+$/.test(part) && Number(part) <= 255);
+    const octets = parts.map(Number);
+    const privateIP = ipv4 && (octets[0] === 10 || (octets[0] === 192 && octets[1] === 168) || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31));
+    const loopback = url.hostname === 'localhost' || url.hostname === '[::1]' || (ipv4 && octets[0] === 127);
+    if (kind === 'brewer' && !privateIP) throw new Error('Enter your brewer’s private LAN IP, such as http://192.168.1.100/health.');
+    if (kind === 'helper' && !loopback) throw new Error('Use this computer’s address: 127.0.0.1, localhost, or [::1].');
+    return url;
+  }
+
+  function render(form, state, message) {
+    form.dataset.state = state;
+    form.querySelector('.status-text').textContent = {idle: 'Not connected', connecting: 'Connecting', connected: 'Connected', error: 'Connection failed'}[state];
+    form.querySelector('.button-text').textContent = state === 'connecting' ? 'Cancel connection' : state === 'connected' ? 'Disconnect' : `${state === 'error' ? 'Retry' : 'Connect'} ${form.dataset.kind}`;
+    form.querySelector('input').disabled = ['connecting', 'connected'].includes(state);
+    form.querySelector('.device-message').textContent = message;
+    const count = forms.filter(item => item.dataset.state === 'connected').length;
+    document.querySelector('#connection-count').textContent = `${count} of 2 connected`;
+    document.querySelector('#session-dot').style.background = count ? '#54865c' : '';
+  }
+
+  for (const form of forms) {
+    // Cancel and disconnect must remain usable while the address input is disabled.
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      const kind = form.dataset.kind;
+      if (['connecting', 'connected'].includes(form.dataset.state)) {
+        const current = active.get(kind);
+        active.delete(kind);
+        if (current) { clearTimeout(current.timer); current.controller.abort(); }
+        render(form, 'idle', defaults[kind]);
+        return;
+      }
+      const input = form.querySelector('input');
+      let url;
+      try { url = validateEndpoint(input.value.trim(), kind); }
+      catch (error) { render(form, 'error', error instanceof TypeError ? 'Enter a complete endpoint beginning with http:// or https://.' : error.message); input.focus(); return; }
+      const controller = new AbortController();
+      const request = {controller, timer: null};
+      active.set(kind, request);
+      render(form, 'connecting', 'Checking your endpoint… Allow local access if your browser asks.');
+      request.timer = setTimeout(() => controller.abort(), 20000);
+      try {
+        const response = await fetch(url.href, {
+          method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+          redirect: 'error', signal: controller.signal,
+          targetAddressSpace: kind === 'brewer' ? 'local' : 'loopback'
+        });
+        // The response body is not needed; cancel it to avoid downloading device data.
+        if (response.body) await response.body.cancel();
+        if (active.get(kind) !== request) return;
+        if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check its status path and access settings.`);
+        render(form, 'connected', `Endpoint responded successfully · checked at ${new Date().toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'})}.`);
+      } catch (error) {
+        if (active.get(kind) !== request) return;
+        const message = error.name === 'AbortError'
+          ? 'No response within 20 seconds. Check the address, service, and browser permissions.'
+          : error instanceof TypeError
+            ? 'Couldn’t reach the endpoint. Check the service, network, browser permission, and CORS settings. See connection help below.'
+            : error.message;
+        render(form, 'error', message);
+      } finally {
+        clearTimeout(request.timer);
+        if (active.get(kind) === request) active.delete(kind);
+      }
+    });
+    form.querySelector('input').addEventListener('input', () => {
+      if (form.dataset.state === 'error') render(form, 'idle', defaults[form.dataset.kind]);
+    });
+  }
+  document.querySelector('#help-toggle').addEventListener('click', event => {
+    const button = event.currentTarget;
+    const expanded = button.getAttribute('aria-expanded') === 'true';
+    button.setAttribute('aria-expanded', String(!expanded));
+    document.querySelector('#connection-help').hidden = expanded;
+  });
+  window.addEventListener('pagehide', () => {
+    for (const request of active.values()) { clearTimeout(request.timer); request.controller.abort(); }
+    active.clear();
+  });
+})();
