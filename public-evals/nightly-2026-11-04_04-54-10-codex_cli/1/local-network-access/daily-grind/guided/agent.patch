+.input-hint { font-size: .7rem; color: var(--muted); margin: 7px 0 19px; }
+.connect-button { width: 100%; display: flex; align-items: center; justify-content: space-between; border: 1px solid #304a37; background: #304a37; color: #fff; padding: 12px 15px; border-radius: 6px; font: 600 .83rem 'Segoe UI', sans-serif; cursor: pointer; }
+.connect-button:hover { background: #233b29; }
