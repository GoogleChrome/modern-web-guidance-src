+@media (max-width: 760px) { .equipment { padding: 23px; } .equipment-heading { align-items: flex-start; flex-direction: column; gap: 12px; } .equipment-grid { grid-template-columns: 1fr; } nav { flex-wrap: wrap; gap: 12px; } nav ul { flex-wrap: wrap; gap: 10px 15px; } nav ul li { margin-left: 0; } .hero h1 { font-size: 2.4rem; } }
diff --git a/equipment.js b/equipment.js
new file mode 100644
index 0000000..29730fe
--- /dev/null
+++ b/equipment.js
@@ -0,0 +1,132 @@
+(() => {
+  'use strict';
+
+  const secure = window.isSecureContext;
+  document.querySelector('#secure-context-note').hidden = secure;
+
+  // Separate permissions protect the LAN brewer and the on-device companion.
+  document.querySelectorAll('[data-device]').forEach((form) => {
+    const isBrewer = form.dataset.device === 'brewer';
+    const permissionName = isBrewer ? 'local-network' : 'loopback-network';
+    const input = form.elements.endpoint;
+    const connect = form.querySelector('.connect-button');
+    const disconnect = form.querySelector('.disconnect-button');
+    const badge = form.querySelector('.device-status');
+    const feedback = form.querySelector('.connection-feedback');
+    const permissionLabel = form.querySelector('.permission-note span');
+    let permissionStatus;
+    let controller;
+    let state = 'idle';
+
+    function render(next, message) {
+      state = next;
+      badge.dataset.state = next;
+      badge.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection issue' }[next];
+      feedback.textContent = message;
+      input.disabled = next === 'connecting' || next === 'connected';
+      connect.disabled = !secure || next === 'connecting' || next === 'connected';
+      disconnect.hidden = next !== 'connecting' && next !== 'connected';
+      disconnect.textContent = next === 'connecting' ? 'Cancel connection' : 'Disconnect';
+      form.setAttribute('aria-busy', String(next === 'connecting'));
+    }
+
+    function blockedMessage() {
+      return `Access is blocked. Open this site’s browser settings, allow ${isBrewer ? 'Local network' : 'Loopback network'} access, then connect again.`;
+    }
+
+    async function checkPermission() {
+      try {
+        if (!permissionStatus) {
+          permissionStatus = await navigator.permissions.query({ name: permissionName });
+          permissionStatus.addEventListener('change', () => {
+            permissionLabel.textContent = permissionStatus.state;
+            if (permissionStatus.state === 'denied') {
+              controller?.abort();
+              controller = undefined;
+              render('error', blockedMessage());
+            } else if (state === 'error') {
+              render('idle', 'Permission updated. Press Connect to try again.');
+            }
+          });
+        }
+        permissionLabel.textContent = permissionStatus.state;
+        return permissionStatus.state;
+      } catch {
+        // Unsupported permission descriptors must not prevent a user-initiated try.
+        permissionLabel.textContent = 'Managed by your browser';
+        return 'prompt';
+      }
+    }
+
+    function endpoint() {
+      const url = new URL(input.value.trim());
+      if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+        throw new Error('Use an HTTP or HTTPS status URL without a username, password, or fragment.');
+      }
+      const host = url.hostname.toLowerCase();
+      const parts = host.split('.').map(Number);
+      const ipv4 = parts.length === 4 && parts.every((n) => Number.isInteger(n) && n >= 0 && n <= 255);
+      const loopback = (ipv4 && parts[0] === 127) || host === 'localhost' || host.endsWith('.localhost') || host === '[::1]';
+      const local = (ipv4 && (parts[0] === 10 || (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) || (parts[0] === 192 && parts[1] === 168) || (parts[0] === 169 && parts[1] === 254))) || host.endsWith('.local');
+      if (isBrewer ? !local : !loopback) {
+        throw new Error(isBrewer ? 'Enter a private LAN IPv4 address (such as 192.168.1.100) or a .local hostname.' : 'Enter a loopback address: 127.0.0.1, localhost, or [::1], with your helper’s port and health path.');
+      }
+      return url.href;
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!secure || state === 'connecting' || state === 'connected') return;
+      let url;
+      try { url = endpoint(); } catch (error) {
+        render('error', error.message);
+        input.focus();
+        return;
+      }
+      const attempt = new AbortController();
+      controller = attempt;
+      render('connecting', 'Waiting for your browser and equipment. Allow network access if prompted.');
+      let timer;
+      let timedOut = false;
+      try {
+        const permission = await checkPermission();
+        if (attempt.signal.aborted) return;
+        if (permission === 'denied') {
+          render('error', blockedMessage());
+          return;
+        }
+        timer = setTimeout(() => { timedOut = true; attempt.abort(); }, 20000);
+        const response = await fetch(url, {
+          method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+          redirect: 'error', targetAddressSpace: isBrewer ? 'local' : 'loopback',
+          signal: attempt.signal,
+        });
+        if (!response.ok) throw new Error(`Equipment returned HTTP ${response.status}. Check the status endpoint and try again.`);
+        // A readable successful response verifies reachability; no brewing command is sent.
+        await response.body?.cancel();
+        if (controller !== attempt) return;
+        render('connected', `Status endpoint reached at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. Connection checked; no live monitoring.`);
+      } catch (error) {
+        if (controller !== attempt) return;
+        const permission = await checkPermission();
+        if (controller !== attempt) return;
+        const advice = isBrewer ? 'Check the brewer’s power, address, and shop Wi-Fi.' : 'Start the helper on this computer and check its port.';
+        render('error', permission === 'denied' ? blockedMessage() : timedOut ? `Connection timed out. ${advice} Allow browser network access, then retry.` : error instanceof TypeError ? `Couldn’t reach the endpoint. ${advice} Check browser network permissions and the service’s CORS settings. Your browser may require a trusted HTTPS endpoint.` : error.message);
+      } finally {
+        clearTimeout(timer);
+        if (controller === attempt) controller = undefined;
+      }
+    });
+
+    disconnect.addEventListener('click', () => {
+      controller?.abort();
+      controller = undefined;
+      render('idle', 'Disconnected. Press Connect whenever you’re ready.');
+    });
+
+    connect.disabled = !secure;
+    checkPermission().then((permission) => {
+      if (permission === 'denied' && state === 'idle') render('error', blockedMessage());
+    });
+  });
+})();
