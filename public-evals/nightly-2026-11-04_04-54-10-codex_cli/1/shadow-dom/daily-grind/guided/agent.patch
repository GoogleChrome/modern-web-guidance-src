diff --git a/seasonal-card.js b/seasonal-card.js
new file mode 100644
index 0000000..38ff09c
--- /dev/null
+++ b/seasonal-card.js
@@ -0,0 +1,95 @@
+const template = document.createElement('template');
+
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+
+    article {
+      height: 100%;
+      margin: 0;
+      padding: 20px;
+      border-radius: 8px;
+      background: white;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      color: #3e2723;
+      font: 1rem / 1.6 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      text-align: center;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      color: #4e342e;
+      font-size: 1.17em;
+    }
+
+    p {
+      margin: 0;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    ::slotted([slot="action"]) {
+      display: inline-block;
+      margin-top: 15px;
+      padding: 10px 20px;
+      border-radius: 5px;
+      background: #4e342e;
+      color: white;
+      text-decoration: none;
+      transition: background 0.3s;
+    }
+
+    ::slotted([slot="action"]:hover) {
+      background: #3e2723;
+    }
+
+    ::slotted([slot="action"]:focus-visible) {
+      outline: 2px solid #4e342e;
+      outline-offset: 3px;
+    }
+  </style>
+  <article>
+    <div class="badge" hidden><slot name="badge"></slot></div>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+class SeasonalCard extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+
+    const badge = root.querySelector('.badge');
+    const badgeSlot = root.querySelector('slot[name="badge"]');
+
+    // Also fires for initial assignment, including children parsed after upgrade.
+    badgeSlot.addEventListener('slotchange', () => {
+      badge.hidden = badgeSlot.assignedElements().length === 0;
+    });
+  }
+}
+
+customElements.define('seasonal-card', SeasonalCard);
