+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const name = item.querySelector('h3').textContent;
+      const hadFocus = item.contains(document.activeElement);
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging', 'is-ready');
+      item.classList.add('is-removing');
+      item.querySelector('button').disabled = true;
+      content.style.transform = `translateX(${direction * 100}%)`;
+
+      const remaining = [...cartList.children].filter(row => !row.classList.contains('is-removing'));
+      document.getElementById('cart-count').textContent = `${remaining.length} ${remaining.length === 1 ? 'item' : 'items'}`;
+      document.getElementById('cart-total').textContent = new Intl.NumberFormat('en-US', {
+        style: 'currency', currency: 'USD'
+      }).format(remaining.reduce((total, row) => total + Number(row.dataset.price), 0));
+      document.querySelector('.cart-empty').hidden = remaining.length > 0;
+      document.getElementById('cart-status').textContent = `${name} removed. ${remaining.length} items in your cart.`;
+      if (hadFocus) (remaining[0]?.querySelector('button') || document.getElementById('cart-title')).focus();
+
+      // Let the swipe finish before collapsing the row's measured height.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(() => item.remove(), reducedMotion.matches ? 0 : 280);
+      }, reducedMotion.matches ? 0 : 220);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(120, track.clientWidth * 0.3);
+
+      track.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, offset: 0, horizontal: false };
+      });
+
+      track.addEventListener('pointermove', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { gesture = null; return; }
+          gesture.horizontal = true;
+          track.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.offset = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+
+      function finishGesture(event) {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const completed = event.type === 'pointerup' && gesture.horizontal && Math.abs(gesture.offset) >= threshold();
+        const direction = Math.sign(gesture.offset) || -1;
+        gesture = null;
+        if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
+        item.classList.remove('is-dragging', 'is-ready');
+        if (completed) removeCartItem(item, direction);
+        else content.style.transform = '';
+      }
+
+      track.addEventListener('pointerup', finishGesture);
+      track.addEventListener('pointercancel', finishGesture);
+      track.addEventListener('lostpointercapture', finishGesture);
+      track.querySelector('button').addEventListener('click', () => removeCartItem(item));
+    });
+  </script>
+
