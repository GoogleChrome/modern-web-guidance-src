+  <script>
+    const form = document.querySelector('#coffee-preferences');
+    const fields = [...form.querySelectorAll('.content-sized')];
+    const status = document.querySelector('#save-status');
+    const context = document.createElement('canvas').getContext('2d');
+
+    function sizeField(field) {
+      const style = getComputedStyle(field);
+      context.font = style.font;
+      const content = field.tagName === 'SELECT'
+        ? field.selectedOptions[0].text
+        : field.value || field.placeholder || ' ';
+      const textWidth = Math.max(...content.split('\n').map(line => context.measureText(line).width));
+      const extra = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+        + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      field.style.width = `${Math.ceil(Math.max(80, textWidth) + extra + 4)}px`;
+      if (field.tagName === 'TEXTAREA') {
+        field.style.height = 'auto';
+        field.style.height = `${field.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+      }
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        fields.forEach(field => {
+          if (typeof saved[field.name] === 'string' &&
+              (field.tagName !== 'SELECT' || [...field.options].some(option => option.value === saved[field.name]))) {
+            field.value = saved[field.name];
+          }
+        });
+      }
+    } catch { /* Fields remain usable when browser storage is unavailable. */ }
+
+    fields.forEach(field => {
+      ['input', 'change'].forEach(event => field.addEventListener(event, () => {
+        sizeField(field);
+        status.textContent = '';
+      }));
+      sizeField(field);
+    });
+    new ResizeObserver(() => fields.forEach(sizeField)).observe(form);
+    document.fonts.ready.then(() => fields.forEach(sizeField));
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your coffee preferences are saved. See you for your next cup!';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please enable local storage and try again.';
+      }
+    });
+  </script>
