+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        for (const field of ['name', 'coffee', 'notes']) {
+          if (typeof saved[field] === 'string') {
+            preferencesForm.elements.namedItem(field).value = saved[field];
+          }
+        }
+      }
+    } catch {
+      // The form remains usable when browser storage is unavailable.
+    }
+
+    preferencesForm.addEventListener('input', () => {
+      preferencesStatus.textContent = '';
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(new FormData(preferencesForm))));
+        preferencesStatus.textContent = 'Your coffee preferences are saved in this browser.';
+      } catch {
+        preferencesStatus.textContent = 'This browser could not save your preferences. You can still edit them here.';
+      }
+    });
+  </script>
+
