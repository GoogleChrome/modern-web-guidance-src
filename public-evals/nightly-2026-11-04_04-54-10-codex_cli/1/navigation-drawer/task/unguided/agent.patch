+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.drawer');
+    const drawerScroll = document.querySelector('.drawer-scroll');
+    const drawerPanel = document.querySelector('.drawer-panel');
+    let scrollTimer;
+    let previousOverflow;
+
+    menuButton.addEventListener('click', () => {
+      previousOverflow = document.documentElement.style.overflow;
+      document.documentElement.style.overflow = 'hidden';
+      drawer.showModal();
+      drawerScroll.scrollLeft = drawerScroll.scrollWidth - drawerScroll.clientWidth;
+      menuButton.setAttribute('aria-expanded', 'true');
+    });
+
+    document.querySelector('.close-menu').addEventListener('click', () => drawer.close());
+    drawer.addEventListener('click', (event) => {
+      if (!drawerPanel.contains(event.target)) drawer.close();
+    });
+    drawer.querySelectorAll('a').forEach((link) => {
+      link.addEventListener('click', () => drawer.close());
+    });
+
+    // The browser handles the swipe and snapping; close after it reaches the empty snap point.
+    const closeAfterSwipe = () => {
+      if (drawer.open && drawerScroll.scrollLeft <= 1) drawer.close();
+    };
+    drawerScroll.addEventListener('scrollend', closeAfterSwipe);
+    drawerScroll.addEventListener('scroll', () => {
+      clearTimeout(scrollTimer);
+      scrollTimer = setTimeout(closeAfterSwipe, 180);
+    });
+
+    // Native dialog dismissal also handles Escape and restores focus to the opener.
+    drawer.addEventListener('close', () => {
+      clearTimeout(scrollTimer);
+      document.documentElement.style.overflow = previousOverflow;
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+  </script>
