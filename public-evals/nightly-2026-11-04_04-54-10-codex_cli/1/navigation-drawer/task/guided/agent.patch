+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const closeButton = drawer.querySelector('.drawer-close');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const pageContent = document.getElementById('page-content');
+    let state = 'closed';
+    let hasEntered = false;
+
+    function finishClosing() {
+      observer.disconnect();
+      state = 'closed';
+      drawer.hidePopover();
+      pageContent.inert = false;
+      document.documentElement.classList.remove('drawer-open');
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus();
+    }
+
+    // Observe the sheet so native swipes and button dismissals share cleanup.
+    const observer = new IntersectionObserver((entries) => {
+      const entry = entries.at(-1);
+      if (state === 'closed') return;
+      if (entry.isIntersecting && entry.intersectionRatio > 0) hasEntered = true;
+      if (entry.intersectionRatio === 0 && (hasEntered || state === 'closing')) {
+        finishClosing();
+      } else if (entry.intersectionRatio >= 0.999 && state === 'opening') {
+        state = 'open';
+        closeButton.focus();
+      }
+    }, { root: scroller, threshold: [0, 0.001, 0.999, 1] });
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasEntered = false;
+      drawer.showPopover();
+      pageContent.inert = true;
+      document.documentElement.classList.add('drawer-open');
+      openButton.setAttribute('aria-expanded', 'true');
+      drawer.focus();
+
+      // Reset on every open, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
+      await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state !== 'opening') return;
+      observer.observe(sheet);
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      const closedPosition = scroller.scrollWidth - scroller.clientWidth;
+      if (scroller.scrollLeft >= closedPosition - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: closedPosition, behavior: 'auto' });
+      }
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target)) closeDrawer();
+      if (event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', (event) => {
+      if (state === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      if (event.key === 'Tab') {
+        const lastLink = sheet.querySelector('li:last-child a');
+        if (event.shiftKey && (document.activeElement === closeButton || document.activeElement === drawer)) {
+          event.preventDefault();
+          lastLink.focus();
+        } else if (!event.shiftKey && (document.activeElement === lastLink || document.activeElement === drawer)) {
+          event.preventDefault();
+          closeButton.focus();
+        }
+      }
+    });
+
+    if (!CSS.supports('animation-timeline: scroll()') || !CSS.supports('timeline-scope: --drawer-fade')) {
+      scroller.addEventListener('scroll', () => {
+        const distance = scroller.scrollWidth - scroller.clientWidth;
+        const progress = distance ? 1 - scroller.scrollLeft / distance : 0;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, progress)));
+      }, { passive: true });
+    }
+  </script>
