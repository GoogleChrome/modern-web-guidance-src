+  <script type="module">
+    const button = document.getElementById('summarize-journal');
+    const status = document.getElementById('journal-status');
+    const summary = document.getElementById('journal-summary');
+    const points = document.getElementById('journal-summary-points');
+    const article = document.getElementById('journal-text');
+    const options = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          const progress = Math.round(event.loaded * 100);
+          status.textContent = progress < 100
+            ? `Downloading the browser's AI model: ${progress}%…`
+            : 'Model ready. Preparing your summary…';
+        });
+      }
+    };
+
+    async function checkSupport() {
+      if (!window.isSecureContext || !('Summarizer' in self)) {
+        status.textContent = 'Native AI summaries are unavailable in this browser. Try a supported desktop browser on HTTPS; you can still read the full journal above.';
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          status.textContent = 'Your browser cannot run native AI summaries on this device. The full journal is available above.';
+          return;
+        }
+        button.disabled = false;
+        status.textContent = availability === 'available'
+          ? 'Get a short AI summary, generated on your device.'
+          : 'Your browser needs to download its AI model first. Select Summarize to begin; this may take a few minutes.';
+      } catch {
+        status.textContent = 'Could not check native AI support. Reload the page to try again, or read the full journal above.';
+      }
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      button.textContent = 'Summarizing…';
+      summary.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing your browser’s AI model…';
+      let summarizer;
+
+      try {
+        // Create directly from the click to preserve activation for model downloads.
+        summarizer = await Summarizer.create(options);
+        status.textContent = 'Summarizing the journal on your device…';
+        const text = await summarizer.summarize(article.innerText);
+        const bullets = text.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+        if (!bullets.length) throw new Error('Empty summary');
+
+        points.replaceChildren(...bullets.map((text) => {
+          const item = document.createElement('li');
+          item.textContent = text;
+          return item;
+        }));
+        summary.hidden = false;
+        status.textContent = 'Your AI summary is ready below. Read the full journal for all the details.';
+      } catch {
+        status.textContent = 'The browser could not finish the summary. Please try again; if a model download was interrupted, check your connection.';
+      } finally {
+        summarizer?.destroy();
+        summary.setAttribute('aria-busy', 'false');
+        button.disabled = false;
+        button.textContent = 'Summarize';
+      }
+    });
+
+    checkSupport();
+  </script>
