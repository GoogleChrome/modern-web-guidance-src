+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summaries aren’t available in this browser. Try a supported desktop browser, such as Chrome, over HTTPS or localhost. You can still read the full journal above.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI… First use may take a little longer.';
+      let summarizer;
+
+      try {
+        // Create directly within the click handler to preserve user activation
+        // when the browser needs permission to download its local model.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading your browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+            });
+          }
+        });
+
+        journalStatus.textContent = 'Turning our sourcing story into a few key points…';
+        const summary = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+
+        if (!points.length) throw new Error('Empty summary');
+
+        // Treat model output as text, never as HTML.
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI-generated key points are ready below. Read the full journal for the complete story.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotAllowedError'
+          ? 'Your browser didn’t allow the AI summary. Check its AI permissions, then try again.'
+          : error.name === 'NotSupportedError'
+            ? 'Your browser’s AI model isn’t available on this device. You can still read the full journal above.'
+            : 'We couldn’t create a summary. Check your connection if the model needs to download, then try again.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        summaryPanel.setAttribute('aria-busy', 'false');
+      }
+    });
+  </script>
+
