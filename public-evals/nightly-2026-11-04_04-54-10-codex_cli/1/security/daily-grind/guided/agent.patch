+const policy = [
+  "default-src 'none'",
+  // This site has no scripts, workers, embeds, or dynamic HTML sinks.
+  "script-src 'none' 'report-sample'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  "form-action 'self'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+  'report-uri /security-reports',
+  'report-to security',
+].join('; ');
+
+function securityHeaders(env = process.env) {
+  const reportOnly = env.SECURITY_POLICY_MODE === 'report-only';
+  const headers = {
+    'Content-Security-Policy': reportOnly
+      ? "object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
+      : policy,
+    'X-Frame-Options': 'DENY',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    Vary: 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+  };
+  if (reportOnly) headers['Content-Security-Policy-Report-Only'] = policy;
+  // Configure the public HTTPS origin explicitly; never derive it from Host.
+  if (env.SECURITY_REPORT_ORIGIN) {
+    const origin = new URL(env.SECURITY_REPORT_ORIGIN);
+    if (origin.protocol !== 'https:' || origin.username || origin.password ||
+        origin.pathname !== '/' || origin.search || origin.hash) {
+      throw new Error('SECURITY_REPORT_ORIGIN must be a public HTTPS origin');
+    }
+    headers['Reporting-Endpoints'] = `security="${origin.origin}/security-reports"`;
+  }
+  // Enable only after HTTPS is configured on the public deployment.
+  if (env.ENABLE_HSTS === 'true') headers['Strict-Transport-Security'] = 'max-age=300';
+  return headers;
+}
+
+// Reports are attacker-controlled. Never log URLs, samples, cookies, or headers.
+const directives = new Set([
+  'default-src', 'script-src', 'script-src-elem', 'script-src-attr',
+  'style-src', 'style-src-elem', 'style-src-attr', 'img-src', 'connect-src',
+  'font-src', 'media-src', 'frame-src', 'worker-src', 'manifest-src',
+  'object-src', 'base-uri', 'frame-ancestors', 'form-action',
+  'require-trusted-types-for', 'trusted-types',
+]);
+
+function summarizeReports(payload) {
+  const reports = Array.isArray(payload) ? payload.slice(0, 20) : [payload];
+  return reports.flatMap((report) => {
+    const body = report?.['csp-report'] ||
+      (report?.type === 'csp-violation' ? report.body : null);
+    if (!body || typeof body !== 'object') return [];
+    const directive = body['effective-directive'] || body.effectiveDirective;
+    if (!directives.has(directive)) return [];
+    return [{
+      directive,
+      disposition: ['enforce', 'report'].includes(body.disposition) ? body.disposition : 'unknown',
+    }];
+  });
+}
+
+module.exports = { securityHeaders, summarizeReports };
