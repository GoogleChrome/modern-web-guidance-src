@@ -0,0 +1,87 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const { createHandler } = require('../request-handler');
+const { securityHeaders } = require('../security');
+
+async function request(url, { method = 'GET', headers = {}, body = '', env = {} } = {}) {
+  const req = Readable.from(body ? [Buffer.from(body)] : []);
+  Object.assign(req, { url, method, headers });
+  const logs = [];
+  const res = {
+    headers: {},
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, values = {}) {
+      this.status = status;
+      for (const [name, value] of Object.entries(values)) this.setHeader(name, value);
+    },
+    end(body) { this.body = body?.toString() || ''; },
+  };
+  await createHandler({ env, log: (...args) => logs.push(args) })(req, res);
+  return { ...res, logs };
+}
+
+test('HTML and CSS remain usable under enforced policy without inline exceptions', async () => {
+  for (const route of ['/', '/menu', '/account']) {
+    const res = await request(route);
+    assert.equal(res.status, 200);
+    assert.match(res.headers['content-security-policy'], /script-src 'none'/);
+    assert.match(res.headers['content-security-policy'], /require-trusted-types-for 'script'/);
+    assert.match(res.headers['content-security-policy'], /trusted-types 'none'/);
+    assert.doesNotMatch(res.headers['content-security-policy'], /unsafe-inline|unsafe-eval/);
+    assert.doesNotMatch(res.body, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+    assert.match(res.body, /href="\/styles.css"/);
+    assert.equal(res.headers['x-frame-options'], 'DENY');
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+  }
+  const css = await request('/styles.css');
+  assert.equal(css.headers['content-type'], 'text/css; charset=utf-8');
+  assert.match(css.body, /https:\/\/images.unsplash.com\//);
+  const head = await request('/styles.css', { method: 'HEAD' });
+  assert.equal(head.body, '');
+});
+
+test('rollout mode reports strict policy and retains enforced framing protection', () => {
+  const headers = securityHeaders({ SECURITY_POLICY_MODE: 'report-only', SECURITY_REPORT_ORIGIN: 'https://coffee.example' });
+  assert.match(headers['Content-Security-Policy-Report-Only'], /require-trusted-types-for/);
+  assert.match(headers['Content-Security-Policy'], /frame-ancestors 'none'/);
+  assert.equal(headers['Reporting-Endpoints'], 'security="https://coffee.example/security-reports"');
+  assert.equal(headers['Strict-Transport-Security'], undefined);
+  assert.equal(securityHeaders({ ENABLE_HSTS: 'true' })['Strict-Transport-Security'], 'max-age=300');
+  assert.throws(() => securityHeaders({ SECURITY_REPORT_ORIGIN: 'http://coffee.example' }));
+});
+
+test('legacy and Reporting API reports retain only bounded, allowlisted metadata', async () => {
+  const secret = 'private-token@example.com';
+  for (const [type, payload] of [
+    ['application/csp-report', { 'csp-report': { 'effective-directive': 'script-src-elem', disposition: 'enforce', 'document-uri': secret, 'script-sample': secret } }],
+    ['application/reports+json', [{ type: 'csp-violation', url: secret, body: { effectiveDirective: 'script-src-elem', disposition: 'enforce', sample: secret } }]],
+  ]) {
+    const res = await request('/security-reports', { method: 'POST', headers: { 'content-type': type }, body: JSON.stringify(payload) });
+    assert.equal(res.status, 204);
+    assert.deepEqual(res.logs, [['security-policy-violation', [{ directive: 'script-src-elem', disposition: 'enforce' }]]]);
+    assert.ok(!JSON.stringify(res.logs).includes(secret));
+  }
+});
+
+test('report ingestion rejects unsupported, malformed, oversized, and wrong-method requests', async () => {
+  assert.equal((await request('/security-reports')).status, 405);
+  assert.equal((await request('/security-reports', { method: 'POST' })).status, 415);
+  const options = { method: 'POST', headers: { 'content-type': 'application/csp-report' } };
+  assert.equal((await request('/security-reports', { ...options, body: '{' })).status, 400);
+  assert.equal((await request('/security-reports', { ...options, body: 'x'.repeat(16385) })).status, 413);
+});
+
+test('Fetch Metadata rejects cross-site subresources but permits incoming links and legacy clients', async () => {
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'no-cors', 'sec-fetch-dest': 'image' } })).status, 403);
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } })).status, 200);
+  assert.equal((await request('/')).status, 200);
+  assert.equal((await request('/', { method: 'POST' })).status, 405);
+});
+
+test('logout clears browser state and cannot be cached', async () => {
+  const res = await request('/logout');
+  assert.equal(res.headers['clear-site-data'], '"cookies", "storage", "cache"');
+  assert.equal(res.headers['cache-control'], 'no-store');
+  assert.equal(res.body, 'Logged out');
+});
