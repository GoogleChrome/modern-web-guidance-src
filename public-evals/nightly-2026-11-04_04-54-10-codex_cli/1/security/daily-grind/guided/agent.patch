--- /dev/null
+++ b/request-handler.js
@@ -0,0 +1,85 @@
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders, summarizeReports } = require('./security');
+
+// This module can be checked without importing the listening server entrypoint.
+function createHandler({ env = process.env, log = console.info } = {}) {
+  const headers = securityHeaders(env);
+  return async function handleRequest(req, res) {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, text, type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : text);
+    };
+    let pathname;
+    try {
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'Bad request');
+      return;
+    }
+
+    if (pathname === '/security-reports') {
+      res.setHeader('Cache-Control', 'no-store');
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        send(405, 'Method not allowed');
+        return;
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim();
+      if (!['application/csp-report', 'application/reports+json'].includes(type)) {
+        send(415, 'Unsupported report type');
+        return;
+      }
+      let size = 0;
+      const chunks = [];
+      try {
+        for await (const chunk of req) {
+          size += Buffer.byteLength(chunk);
+          if (size > 16384) {
+            send(413, 'Report too large');
+            return;
+          }
+          chunks.push(Buffer.from(chunk));
+        }
+        const summaries = summarizeReports(JSON.parse(Buffer.concat(chunks).toString('utf8')));
+        if (summaries.length) log('security-policy-violation', summaries);
+      } catch {
+        send(400, 'Invalid report');
+        return;
+      }
+      res.writeHead(204);
+      res.end();
+      return;
+    }
+
+    // Cross-site links remain usable; cross-site subresource loads are denied.
+    if (req.headers['sec-fetch-site'] === 'cross-site' &&
+        !(req.headers['sec-fetch-mode'] === 'navigate' &&
+          req.headers['sec-fetch-dest'] === 'document' &&
+          ['GET', 'HEAD'].includes(req.method))) {
+      send(403, 'Forbidden');
+      return;
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'Method not allowed');
+      return;
+    }
+    if (pathname === '/logout' || pathname === '/logout/') {
+      res.setHeader('Cache-Control', 'no-store');
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      send(200, 'Logged out');
+      return;
+    }
+    const isStylesheet = pathname === '/styles.css';
+    try {
+      const data = await fs.readFile(path.join(__dirname, isStylesheet ? 'styles.css' : 'index.html'));
+      send(200, data, isStylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler, handleRequest: createHandler() };
