@@ -0,0 +1,36 @@
+const policy = [
+  "default-src 'none'",
+  "script-src 'none'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+function securityHeaders({ mode = 'enforce', reportUri } = {}) {
+  if (!['enforce', 'report-only'].includes(mode)) {
+    throw new Error('CSP_MODE must be enforce or report-only');
+  }
+  if (reportUri) {
+    const url = new URL(reportUri);
+    if (url.protocol !== 'https:' || url.username || url.password || /[\s;]/.test(reportUri)) {
+      throw new Error('CSP_REPORT_URI must be an HTTPS URL without credentials, whitespace or semicolons');
+    }
+  }
+
+  return {
+    [mode === 'enforce' ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only']:
+      policy + (reportUri ? `; report-uri ${reportUri}` : ''),
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'no-referrer',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+  };
+}
+
+module.exports = { securityHeaders };
