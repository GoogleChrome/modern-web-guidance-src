+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders } = require('./security');
+
+// Separate from the listening entrypoint so checks never need to start a server.
+function createHandler(options = {}) {
+  const headers = securityHeaders(options);
+
+  return async (req, res) => {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+
+    function send(status, type, body) {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    }
+
+    let pathname;
+    try {
+      // A fixed base avoids trusting the request's Host header during parsing.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'text/plain; charset=utf-8', 'Bad request');
+      return;
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'text/plain; charset=utf-8', 'Method not allowed');
+      return;
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      res.setHeader('Cache-Control', 'no-store');
+      send(200, 'text/plain; charset=utf-8', 'Logged out');
+      return;
+    }
+
+    const isStylesheet = pathname === '/styles.css';
+    try {
+      const data = await fs.readFile(path.join(__dirname, isStylesheet ? 'styles.css' : 'index.html'));
+      send(200, isStylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8', data);
+    } catch {
+      send(500, 'text/plain; charset=utf-8', 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
