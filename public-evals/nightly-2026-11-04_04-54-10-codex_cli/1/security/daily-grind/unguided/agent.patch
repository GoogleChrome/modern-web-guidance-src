+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..1b3f21c
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,92 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const { createHandler } = require('../app');
+const { securityHeaders } = require('../security');
+
+async function request(url, method = 'GET', options) {
+  const response = {
+    headers: {},
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      for (const [name, value] of Object.entries(headers)) this.setHeader(name, value);
+    },
+    end(body) { this.body = body?.toString(); },
+  };
+  await createHandler(options)({ url, method }, response);
+  return response;
+}
+
+test('all page, asset and logout responses carry enforced security headers', async () => {
+  for (const url of ['/', '/menu', '/account', '/styles.css?v=1', '/logout', '/logout/']) {
+    const response = await request(url);
+    assert.equal(response.status, 200);
+    assert.equal(response.headers['content-security-policy'], securityHeaders()['Content-Security-Policy']);
+    assert.equal(response.headers['x-content-type-options'], 'nosniff');
+    assert.equal(response.headers['x-frame-options'], 'DENY');
+    assert.equal(response.headers['referrer-policy'], 'no-referrer');
+    assert.match(response.headers['permissions-policy'], /camera=\(\)/);
+  }
+});
+
+test('markup needs no inline execution and the stylesheet is served with its correct MIME type', async () => {
+  const page = await request('/');
+  assert.doesNotMatch(page.body, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(page.body, /<link rel="stylesheet" href="\/styles.css">/);
+  const css = await request('/styles.css');
+  assert.equal(css.headers['content-type'], 'text/css; charset=utf-8');
+  assert.match(css.body, /\.hero\s*\{/);
+  assert.match(css.body, /https:\/\/images\.unsplash\.com\//);
+  assert.doesNotMatch(css.body, /@import/i);
+  const csp = page.headers['content-security-policy'];
+  assert.match(csp, /script-src 'none'/);
+  assert.match(csp, /style-src 'self'/);
+  assert.match(csp, /img-src 'self' https:\/\/images\.unsplash\.com/);
+  assert.match(csp, /base-uri 'none'/);
+  assert.match(csp, /object-src 'none'/);
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|\*/);
+});
+
+test('report-only rollout uses the same policy without enforcing it', async () => {
+  const response = await request('/', 'GET', {
+    mode: 'report-only', reportUri: 'https://reports.example.com/csp',
+  });
+  assert.equal(response.headers['content-security-policy'], undefined);
+  assert.equal(response.headers['content-security-policy-report-only'],
+    securityHeaders()['Content-Security-Policy'] + '; report-uri https://reports.example.com/csp');
+  assert.equal(response.headers['x-frame-options'], 'DENY');
+});
+
+test('invalid rollout settings fail before serving requests', () => {
+  assert.throws(() => createHandler({ mode: 'disabled' }));
+  for (const reportUri of ['http://reports.example.com', 'https://user:pass@example.com',
+    'https://example.com/;script-src', 'https://example.com/\r\nX-Evil: yes']) {
+    assert.throws(() => createHandler({ reportUri }));
+  }
+});
+
+test('HEAD returns headers without a response body', async () => {
+  for (const url of ['/', '/styles.css', '/logout']) {
+    const response = await request(url, 'HEAD');
+    assert.equal(response.status, 200);
+    assert.equal(response.body, undefined);
+  }
+});
+
+test('invalid URLs and unsupported methods keep security headers', async () => {
+  for (const [url, method, status] of [['http://[', 'GET', 400], ['/', 'POST', 405]]) {
+    const response = await request(url, method);
+    assert.equal(response.status, status);
+    assert.ok(response.headers['content-security-policy']);
+    assert.equal(response.headers['content-type'], 'text/plain; charset=utf-8');
+  }
+});
+
+test('file read errors keep security headers and hide internal details', async (t) => {
+  t.mock.method(fs, 'readFile', async () => { throw new Error('private path'); });
+  const response = await request('/');
+  assert.equal(response.status, 500);
+  assert.equal(response.body, 'Server error');
+  assert.ok(response.headers['content-security-policy']);
+});
