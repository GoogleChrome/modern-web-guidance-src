diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..0ba66f4
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,169 @@
+// A single form control: shadow radios provide keyboard interaction, while
+// ElementInternals owns the submitted value and constraint validation.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #radios;
+  #status;
+  #error;
+  #descriptions = ['Poor', 'Fair', 'Good', 'Great', 'Excellent'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; color: #4e342e; }
+        fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
+        .sr-only, input {
+          position: absolute; width: 1px; height: 1px; padding: 0;
+          margin: -1px; overflow: hidden; clip-path: inset(50%);
+          white-space: nowrap; border: 0;
+        }
+        .stars { display: flex; gap: 5px; flex-wrap: wrap; }
+        label {
+          display: grid; place-items: center; width: 48px; height: 48px;
+          border: 1px solid #ad9e90; border-radius: 6px;
+          background: #fffdfa; cursor: pointer;
+        }
+        svg { width: 28px; height: 28px; fill: none; stroke: #8d6a48; stroke-width: 1.4; }
+        label.filled { background: #f4e6c9; border-color: #a67b3d; }
+        label.filled svg { fill: #a76c24; stroke: #a76c24; }
+        label:hover { background: #eee0c9; }
+        input:focus-visible + label { outline: 3px solid #875130; outline-offset: 3px; }
+        :host(:disabled) { opacity: 0.55; }
+        input:disabled + label { cursor: not-allowed; }
+        .hint { font: 0.8rem/1.5 'Segoe UI', sans-serif; color: #71645b; margin: 9px 0 0; }
+        .error { font: 0.8rem/1.5 'Segoe UI', sans-serif; color: #a22d21; margin: 7px 0 0; }
+        .error:empty { display: none; }
+      </style>
+      <fieldset aria-describedby="rating-hint rating-error">
+        <legend class="sr-only">Your coffee rating (required when marked *)</legend>
+        <div class="stars">
+          ${this.#descriptions.map((description, index) => `
+            <input type="radio" name="stars" id="star-${index + 1}" value="${index + 1}">
+            <label for="star-${index + 1}">
+              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9Z"/></svg>
+              <span class="sr-only">${index + 1} ${index === 0 ? 'star' : 'stars'} — ${description}</span>
+            </label>`).join('')}
+        </div>
+        <p class="hint" id="rating-hint">Choose 1–5 stars</p>
+        <p class="error" id="rating-error" aria-live="polite"></p>
+      </fieldset>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#status = root.querySelector('.hint');
+    this.#error = root.querySelector('.error');
+
+    // Keep internal events private; consumers receive one input/change pair
+    // from the form-associated control, just as for native selection controls.
+    root.addEventListener('input', (event) => event.stopPropagation());
+    root.addEventListener('change', (event) => {
+      event.stopPropagation();
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#error.textContent = this.validationMessage;
+    });
+  }
+
+  connectedCallback() {
+    // Reconnecting must not erase a user's selection or restored browser state.
+    if (!this.#dirty) this.#setValue(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value' && !this.#dirty) this.#setValue(newValue);
+    else this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#setValue(value);
+  }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value)); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // The browser includes ancestor fieldsets in this effective state. Never
+    // reflect it to the host attribute: that would prevent re-enabling it.
+    for (const radio of this.#radios) radio.disabled = disabled;
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #setValue(value) {
+    this.#value = /^[1-5]$/.test(String(value)) ? String(value) : '';
+    this.#sync();
+  }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.nextElementSibling.classList.toggle('filled', Number(radio.value) <= Number(this.#value));
+    }
+    this.#status.textContent = this.#value
+      ? `${this.#value} of 5 — ${this.#descriptions[Number(this.#value) - 1]}`
+      : 'Choose 1–5 stars';
+    this.#error.textContent = '';
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a coffee rating.' : '',
+      this.#radios[0],
+    );
+  }
+}
+
+customElements.define('star-rating', StarRating);
+
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+
+form.addEventListener('submit', (event) => {
+  // The browser has already validated all controls, including <star-rating>.
+  event.preventDefault();
+  const data = new FormData(form);
+  try {
+    localStorage.setItem('daily-grind-feedback', JSON.stringify({
+      ...Object.fromEntries(data),
+      savedAt: new Date().toISOString(),
+    }));
+    status.textContent = `Thanks for sharing! Your ${data.get('rating')}-star feedback is saved on this device.`;
+  } catch {
+    status.textContent = 'Your browser couldn’t save this feedback. Please allow local storage and try again.';
+  }
+});
+
+form.addEventListener('reset', () => { status.textContent = ''; });
+form.addEventListener('input', () => { status.textContent = ''; });
