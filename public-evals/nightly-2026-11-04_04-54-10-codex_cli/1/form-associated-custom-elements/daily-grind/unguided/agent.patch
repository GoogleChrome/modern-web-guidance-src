@@ -0,0 +1,143 @@
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+  #radios;
+  #error;
+  #summary;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; gap: 8px; width: fit-content; }
+        label { position: relative; display: grid; place-items: center; width: 50px; height: 54px; cursor: pointer; }
+        input { position: absolute; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
+        svg { width: 40px; height: 40px; fill: transparent; stroke: #94785e; stroke-width: 1.4; transition: fill .15s, transform .15s; pointer-events: none; }
+        label.filled svg { fill: #bb8034; stroke: #bb8034; }
+        label:hover svg { transform: translateY(-2px); }
+        label:has(input:focus-visible) { outline: 2px solid #4e342e; outline-offset: 2px; border-radius: 5px; }
+        :host([data-disabled]) { opacity: .45; }
+        :host([data-disabled]) label { cursor: not-allowed; }
+        p { margin: 8px 0 0; font: inherit; font-size: .85rem; color: #786757; }
+        .error { color: #a22f27; }
+        [hidden] { display: none; }
+        @media (prefers-reduced-motion: reduce) { svg { transition: none; } }
+      </style>
+      <div class="stars">
+        ${Array.from({ length: 5 }, (_, index) => `
+          <label>
+            <input type="radio" name="stars" value="${index + 1}" aria-label="${index + 1} ${index === 0 ? 'star' : 'stars'}" aria-describedby="rating-error">
+            <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m20 3 5.2 10.5 11.6 1.7-8.4 8.2 2 11.6L20 29.5 9.6 35l2-11.6-8.4-8.2 11.6-1.7Z"/></svg>
+          </label>`).join('')}
+      </div>
+      <p id="summary">Select your rating</p>
+      <p id="rating-error" class="error" aria-live="polite" hidden>Please select a star rating.</p>
+    `;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#error = root.querySelector('#rating-error');
+    this.#summary = root.querySelector('#summary');
+    root.addEventListener('input', event => event.stopPropagation());
+    root.addEventListener('change', event => {
+      event.stopPropagation();
+      this.value = event.target.value;
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#sync();
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) {
+      this.#value = this.#normalize(this.getAttribute('value'));
+    }
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get name() { return this.getAttribute('name') || ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  get labels() { return this.#internals.labels; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formDisabledCallback(disabled) {
+    // Includes disabled ancestor fieldsets, not just the host's attribute.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#showError = false;
+    this.#value = this.#normalize(state);
+    this.#sync();
+  }
+
+  #normalize(value) {
+    const string = String(value ?? '');
+    return /^[1-5]$/.test(string) ? string : '';
+  }
+
+  #sync() {
+    const disabled = this.#disabled || this.disabled;
+    const missing = this.required && !this.#value && !disabled;
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please select a star rating.' : '',
+      this.#radios[0],
+    );
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(disabled);
+    this.#internals.ariaInvalid = String(missing && this.#showError);
+    this.toggleAttribute('data-disabled', disabled);
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = disabled;
+      radio.tabIndex = radio.value === (this.#value || '1') ? 0 : -1;
+      radio.parentElement.classList.toggle('filled', Number(radio.value) <= Number(this.#value));
+    }
+    this.#summary.textContent = this.#value ? `${this.#value} out of 5 stars` : 'Select your rating';
+    this.#error.hidden = !(missing && this.#showError);
+  }
+}
+
+customElements.define('star-rating', StarRating);
