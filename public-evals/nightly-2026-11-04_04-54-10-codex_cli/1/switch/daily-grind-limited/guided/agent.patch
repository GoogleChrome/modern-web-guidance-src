+  <script>
+    const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const darkMode = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+    const deviceScheme = window.matchMedia('(prefers-color-scheme: dark)');
+    const storageKey = 'daily-grind-color-scheme';
+
+    function syncPreference() {
+      darkMode.checked = schemeMeta.content === 'dark' ||
+        (schemeMeta.content === 'light dark' && deviceScheme.matches);
+      darkModeState.textContent = darkMode.checked ? 'On' : 'Off';
+    }
+
+    darkMode.addEventListener('change', () => {
+      const target = darkMode.checked ? 'dark' : 'light';
+      const followsDevice = darkMode.checked === deviceScheme.matches;
+      schemeMeta.content = followsDevice ? 'light dark' : target;
+      syncPreference();
+      try {
+        if (followsDevice) localStorage.removeItem(storageKey);
+        else localStorage.setItem(storageKey, target);
+      } catch { /* The preference still applies for this visit. */ }
+    });
+
+    deviceScheme.addEventListener('change', syncPreference);
+    window.addEventListener('storage', (event) => {
+      if (event.key !== storageKey && event.key !== null) return;
+      schemeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+        ? event.newValue : 'light dark';
+      syncPreference();
+    });
+
+    syncPreference();
+    document.getElementById('preferences').hidden = false;
+  </script>
+
