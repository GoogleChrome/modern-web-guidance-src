+      border: 2px solid var(--primary);
+      border-radius: 20px;
+      background: var(--secondary);
+      cursor: pointer;
+    }
+
+    #compact-view::before {
+      content: '';
+      display: block;
+      width: 18px;
+      height: 18px;
+      margin: 2px;
+      border-radius: 50%;
+      background: var(--primary);
+    }
+
+    #compact-view:checked {
+      background: var(--primary);
+    }
+
+    #compact-view:checked::before {
+      transform: translateX(18px);
+      background: white;
+    }
+
+    #compact-view:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .preference-state {
+      min-width: 2ch;
+    }
+
+    .preference-on,
+    .view-preference:has(input:checked) .preference-off {
+      display: none;
+    }
+
+    .view-preference:has(input:checked) .preference-on {
+      display: inline;
+    }
+
+    section:has(#compact-view:checked) .grid {
+      gap: 10px;
+      margin-top: 10px;
+    }
+
+    section:has(#compact-view:checked) .card {
