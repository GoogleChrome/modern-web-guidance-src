+
+    section:has(#compact-view:checked) .card .btn {
+      margin-top: 8px;
+      padding: 6px 16px;
+    }
+
+    @media (forced-colors: active) {
+      #compact-view {
+        appearance: auto;
+      }
+
+      #compact-view::before {
