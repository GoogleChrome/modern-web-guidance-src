+  <script>
+    (() => {
+      const definitions = {
+        checkout: { name: 'Checkout', priority: 0, label: 'Urgent', slices: 35 },
+        menu: { name: 'Menu update', priority: 1, label: 'Standard', slices: 70 },
+        telemetry: { name: 'Telemetry log', priority: 2, label: 'Background', slices: 100 }
+      };
+      const queue = [];
+      const queueList = document.getElementById('queue-list');
+      const activityList = document.getElementById('activity-list');
+      const announcement = document.getElementById('queue-announcement');
+      let nextId = 0;
+      let completed = 0;
+      let scheduled = false;
+      let activeId = null;
+
+      function log(message) {
+        if (!activityList.dataset.started) {
+          activityList.replaceChildren();
+          activityList.dataset.started = 'true';
+        }
+        const item = document.createElement('li');
+        const time = document.createElement('time');
+        time.dateTime = new Date().toISOString();
+        time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        item.append(time, document.createTextNode(message));
+        activityList.prepend(item);
+        while (activityList.children.length > 20) activityList.lastElementChild.remove();
+        announcement.textContent = message;
+      }
+
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} ${queue.length === 1 ? 'task' : 'tasks'}`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        if (!queue.length) {
+          queueList.innerHTML = '<li class="queue-empty">All caught up.<br>The counter is ready for the next task.</li>';
+          return;
+        }
+        queueList.innerHTML = queue.map(task => {
+          const percent = Math.round(task.done / task.slices * 100);
+          const state = task.id === activeId ? 'Running' : task.done ? 'Paused for higher priority' : 'Queued';
+          return `<li class="task-row ${task.id === activeId ? 'running' : ''}">
+            <div class="task-heading"><strong>${task.name} #${task.id}</strong><span class="priority priority-${task.priority}">${task.label}</span></div>
+            <div class="task-meta"><span>${state}</span><span>${percent}%</span></div>
+            <progress value="${task.done}" max="${task.slices}" aria-label="${task.name} #${task.id} progress"></progress>
+          </li>`;
+        }).join('');
+      }
+
+      function schedule() {
+        if (scheduled || !queue.length) return;
+        scheduled = true;
+        // A fresh event-loop turn for every slice lets clicks and painting proceed.
+        window.setTimeout(runSlice, 20);
+      }
+
+      function runSlice() {
+        scheduled = false;
+        const task = queue[0];
+        if (!task) return;
+        if (activeId !== task.id) {
+          if (activeId !== null && queue.some(item => item.id === activeId)) {
+            log(`Higher priority work arrived; ${task.done ? 'resumed' : 'started'} ${task.name.toLowerCase()} #${task.id}.`);
+          } else {
+            log(`${task.done ? 'Resumed' : 'Started'} ${task.name.toLowerCase()} #${task.id}.`);
+          }
+          activeId = task.id;
+        }
+        // Simulate CPU work with a strict time budget, never a long blocking loop.
+        const deadline = performance.now() + 3;
+        while (performance.now() < deadline) {
+          task.work = Math.sqrt((task.work || 1) + 123.456);
+        }
+        task.done++;
+        if (task.done === task.slices) {
+          queue.shift();
+          completed++;
+          log(`Completed ${task.name.toLowerCase()} #${task.id}.`);
+          activeId = null;
+        }
+        render();
+        schedule();
+      }
+
+      function enqueue(type) {
+        const task = { ...definitions[type], id: ++nextId, done: 0 };
+        queue.push(task);
+        // FIFO within each priority; reselect after each slice to allow preemption.
+        queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+        log(`Queued ${task.name.toLowerCase()} #${task.id}.`);
+        render();
+        schedule();
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue(button.dataset.task));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        // Deliberately enqueue out of order to demonstrate priority selection.
+        ['telemetry', 'menu', 'checkout'].forEach(enqueue);
+      });
+    })();
+  </script>
