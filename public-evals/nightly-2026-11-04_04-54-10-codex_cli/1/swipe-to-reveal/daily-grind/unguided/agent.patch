+  <script>
+    const drinkCards = document.querySelectorAll('.drink-card');
+
+    function setActionsOpen(card, open) {
+      const actions = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.actions-toggle');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      actions.hidden = !open;
+      actions.inert = !open;
+      toggle.setAttribute('aria-expanded', String(open));
+    }
+
+    drinkCards.forEach((card) => {
+      const content = card.querySelector('.drink-content');
+      const toggle = card.querySelector('.actions-toggle');
+      const favorite = card.querySelector('.favorite-button');
+      let gesture = null;
+      let suppressClick = false;
+
+      function openActions(open) {
+        if (open) drinkCards.forEach((other) => {
+          if (other !== card) setActionsOpen(other, false);
+        });
+        setActionsOpen(card, open);
+      }
+
+      toggle.addEventListener('click', () => {
+        openActions(!card.classList.contains('is-open'));
+      });
+
+      favorite.addEventListener('click', () => {
+        const selected = favorite.getAttribute('aria-pressed') !== 'true';
+        favorite.setAttribute('aria-pressed', String(selected));
+        favorite.textContent = selected ? 'Favorited' : 'Favorite';
+      });
+
+      content.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0) return;
+        suppressClick = false;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, axis: null };
+      });
+
+      content.addEventListener('pointermove', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.axis && Math.max(Math.abs(dx), Math.abs(dy)) > 10) {
+          gesture.axis = Math.abs(dx) > Math.abs(dy) ? 'horizontal' : 'vertical';
+          if (gesture.axis === 'horizontal') content.setPointerCapture(event.pointerId);
+        }
+        if (gesture.axis === 'horizontal') suppressClick = true;
+      });
+
+      content.addEventListener('pointerup', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (gesture.axis !== 'vertical' && Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) {
+          suppressClick = true;
+          openActions(dx < 0);
+        }
+        gesture = null;
+      });
+
+      content.addEventListener('pointercancel', () => { gesture = null; });
+      content.addEventListener('lostpointercapture', () => { gesture = null; });
+      content.addEventListener('click', (event) => {
+        if (!suppressClick) return;
+        event.preventDefault();
+        event.stopPropagation();
+        suppressClick = false;
+      }, true);
+
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') openActions(false);
+      });
+    });
+
+    document.addEventListener('click', (event) => {
+      if (!event.target.closest('.drink-card')) {
+        drinkCards.forEach((card) => setActionsOpen(card, false));
+      }
+    });
+  </script>
+
