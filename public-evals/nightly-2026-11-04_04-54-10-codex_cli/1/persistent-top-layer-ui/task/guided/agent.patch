+  <button type="button" class="feedback-launcher" id="open-feedback" aria-haspopup="dialog"
+    aria-controls="feedback-dialog">Share feedback</button>
+
+  <!-- Both hosts stay connected so moveBefore can preserve the dialog's top-layer state. -->
+  <div id="feedback-left"></div>
+  <div id="feedback-right">
+    <dialog id="feedback-dialog" class="feedback-dialog" aria-labelledby="feedback-title"
+      aria-describedby="feedback-description">
+      <form method="dialog">
+        <p class="feedback-eyebrow">A little coffee talk</p>
+        <div class="feedback-heading">
+          <h2 id="feedback-title">How are we doing?</h2>
+          <button type="submit" class="feedback-close" aria-label="Close feedback" value="close">&times;</button>
+        </div>
+        <p class="feedback-description" id="feedback-description">Make yourself comfortable. Leave a note, move this window, and keep right on writing.</p>
+        <label for="feedback-notes">Your feedback</label>
+        <textarea id="feedback-notes" name="feedback" placeholder="What could make your next visit better?" autofocus></textarea>
+        <p class="feedback-status" id="feedback-status" role="status">Your draft stays here until you reload the page.</p>
+        <div class="feedback-actions">
+          <button type="button" class="feedback-move" id="move-feedback">Move to left &larr;</button>
+          <button type="submit" class="btn" value="done">Done</button>
+        </div>
+      </form>
+    </dialog>
+  </div>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackNotes = document.getElementById('feedback-notes');
+    const feedbackMove = document.getElementById('move-feedback');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    document.getElementById('open-feedback').addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const movingLeft = feedbackDialog.parentElement.id === 'feedback-right';
+      const target = document.getElementById(movingLeft ? 'feedback-left' : 'feedback-right');
+
+      if (typeof target.moveBefore === 'function') {
+        // Atomic reparenting preserves modality, top-layer membership and focus.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const wasModal = feedbackDialog.matches(':modal');
+        const focused = feedbackDialog.contains(document.activeElement) ? document.activeElement : null;
+        const returnValue = feedbackDialog.returnValue;
+        const dialogScroll = feedbackDialog.scrollTop;
+        const notesScroll = feedbackNotes.scrollTop;
+        const { selectionStart, selectionEnd, selectionDirection } = feedbackNotes;
+
+        // Closing explicitly clears the open attribute and restores the original
+        // invoker before reopening, so showModal() establishes modality again.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+        }
+        feedbackDialog.returnValue = returnValue;
+        if (focused && wasOpen) focused.focus({ preventScroll: true });
+        feedbackNotes.setSelectionRange(selectionStart, selectionEnd, selectionDirection);
+        feedbackNotes.scrollTop = notesScroll;
+        feedbackDialog.scrollTop = dialogScroll;
+      }
+
+      feedbackMove.textContent = movingLeft ? 'Move to right →' : 'Move to left ←';
+      feedbackStatus.textContent = `Moved to the ${movingLeft ? 'left' : 'right'}. Your draft is still here.`;
+    });
+  </script>
+
