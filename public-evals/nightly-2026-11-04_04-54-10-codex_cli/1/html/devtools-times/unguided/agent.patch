diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..70ee64d
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,43 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  labelledBy: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ labelledBy, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    dialog.showModal();
+    dialog.querySelector<HTMLElement>('[data-modal-initial-focus]')?.focus();
+    return () => {
+      dialog.close();
+      if (trigger?.isConnected) trigger.focus();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={labelledBy}
+      className="modal bg-white shadow-xl w-full max-w-2xl"
+      onClose={onClose}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <button type="button" aria-label="Close dialog" onClick={() => dialogRef.current?.close()} className="absolute top-2 right-2 bg-white rounded-full p-1 text-gray-500 hover:text-amber-700">
+        <span aria-hidden="true" className="text-2xl leading-none">×</span>
+      </button>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NavigationPopover.tsx b/src/components/NavigationPopover.tsx
new file mode 100644
index 0000000..06e90d8
--- /dev/null
+++ b/src/components/NavigationPopover.tsx
@@ -0,0 +1,32 @@
+import { useId, useState, type ReactNode } from 'react';
+
+export default function NavigationPopover({ label, children }: { label: string; children: ReactNode }) {
+  const id = useId();
+  const [open, setOpen] = useState(false);
+  const [top, setTop] = useState(0);
+
+  return (
+    <>
+      <button
+        type="button"
+        popoverTarget={id}
+        aria-expanded={open}
+        aria-controls={id}
+        className="flex items-center gap-1 hover:text-gray-600 whitespace-nowrap h-full"
+        onClick={event => setTop(event.currentTarget.getBoundingClientRect().bottom)}
+      >
+        {label}<span aria-hidden="true">⌄</span>
+      </button>
+      <div
+        id={id}
+        popover="auto"
+        aria-label={label}
+        className="navigation-popover bg-white border border-gray-300 shadow-lg"
+        style={{ top }}
+        onToggle={event => setOpen(event.newState === 'open')}
+      >
+        {children}
+      </div>
+    </>
+  );
+}
