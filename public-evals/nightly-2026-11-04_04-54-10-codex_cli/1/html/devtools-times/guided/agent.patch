diff --git a/src/components/DisclosurePopover.tsx b/src/components/DisclosurePopover.tsx
new file mode 100644
index 0000000..55f3f01
--- /dev/null
+++ b/src/components/DisclosurePopover.tsx
@@ -0,0 +1,19 @@
+import { useEffect, useId, useState, type ReactNode } from 'react';
+
+export default function DisclosurePopover({ label, children }: { label: string; children: ReactNode }) {
+  const id = useId();
+  const [supported, setSupported] = useState(false);
+  useEffect(() => setSupported('popover' in HTMLElement.prototype), []);
+  // Native disclosure keeps navigation available before hydration and in older browsers.
+  if (!supported) return <details className="relative">
+    <summary className="cursor-pointer whitespace-nowrap p-2">{label}</summary>
+    <div className="disclosure-fallback">{children}</div>
+  </details>;
+  return <>
+    <button type="button" popoverTarget={id} className="whitespace-nowrap p-2 hover:text-gray-600">{label} <span aria-hidden="true">⌄</span></button>
+    <div id={id} popover="auto" className="navigation-popover">
+      <button type="button" popoverTarget={id} popoverTargetAction="hide" className="float-right p-2" aria-label={`Close ${label}`}>✕</button>
+      {children}
+    </div>
+  </>;
+}
