+      .then(response => { if (!response.ok) throw new Error(); return response.json(); })
+      .then(data => { setArticles(data); setStatus(''); })
+      .catch(() => { if (!controller.signal.aborted) setStatus('Unable to load articles. Please reopen search to try again.'); });
+    return () => controller.abort();
+  }, []);
+  const query = term.trim().toLowerCase();
+  const results = query ? articles.filter(a => `${a.title} ${a.summary}`.toLowerCase().includes(query)) : articles.slice(0, 3);
+  return <div className="p-4">
+    <search>
+      <form onSubmit={event => event.preventDefault()}>
+        <label htmlFor={id} className="block font-semibold mb-2">Search for articles</label>
+        <input id={id} name="q" type="search" autoFocus autoComplete="on" autoCapitalize="off" autoCorrect="off" spellCheck={false} enterKeyHint="search"
+          className="w-full p-2 border border-gray-300 rounded-md" value={term} onChange={e => setTerm(e.target.value)} />
+      </form>
+    </search>
+    <p role="status" className="my-3 text-sm text-gray-600">{status || (query ? `${results.length} results found.` : 'Featured articles')}</p>
+    <ul className="space-y-2">{results.map(article => <li key={article.slug}>
+      <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block p-3 hover:bg-gray-100 rounded-md">
+        <h3 className="font-bold">{article.title}</h3><p className="text-sm text-gray-600">{article.summary}</p>
+      </a>
+    </li>)}</ul>
+  </div>;
 }
