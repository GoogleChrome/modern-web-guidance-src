new file mode 100644
index 0000000..e3b4cf6
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,47 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from 'react';
+
+/** The dialog stays mounted so native dismissal can restore focus to its invoker. */
+export default function Modal({ title, trigger, children }: {
+  title: string;
+  trigger: ReactNode;
+  children: ReactNode;
+}) {
+  const id = useId();
+  const ref = useRef<HTMLDialogElement>(null);
+  const [opened, setOpened] = useState(false);
+
+  useEffect(() => {
+    const dialog = ref.current;
+    if (!dialog || 'closedBy' in HTMLDialogElement.prototype) return;
+    const outside = (event: PointerEvent) => {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
+    };
+    let pressedOutside = false;
+    const down = (event: PointerEvent) => { pressedOutside = outside(event); };
+    const up = (event: PointerEvent) => { if (pressedOutside && outside(event)) dialog.close(); pressedOutside = false; };
+    dialog.addEventListener('pointerdown', down);
+    dialog.addEventListener('pointerup', up);
+    return () => {
+      dialog.removeEventListener('pointerdown', down);
+      dialog.removeEventListener('pointerup', up);
+    };
+  }, []);
+
+  return <>
+    <button type="button" aria-label={title} aria-haspopup="dialog" aria-controls={id}
+      commandFor={id} command="show-modal" className="p-1 text-gray-700 hover:text-amber-600"
+      onClick={() => {
+        setOpened(true);
+        if (!('commandForElement' in HTMLButtonElement.prototype)) ref.current?.showModal();
+      }}>{trigger}</button>
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} closedBy="any"
+      className="overlay-dialog" onClose={() => setOpened(false)}>
+      <header className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <form method="dialog"><button type="submit" autoFocus className="p-2" aria-label={`Close ${title}`}>✕</button></form>
+      </header>
+      {opened && children}
+    </dialog>
+  </>;
+}
