diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,79 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const modelContext = document.modelContext;
+
+    if (typeof modelContext?.registerTool === 'function') {
+      let registrationController;
+
+      const getMenuItems = () => Array.from(document.querySelectorAll('.grid .card'), (card) => ({
+        name: card.querySelector('h3').textContent.trim(),
+        description: card.querySelector('p').textContent.trim(),
+        detailsUrl: card.querySelector('a').href,
+      }));
+
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+
+      async function registerMenuTool() {
+        if (registrationController) return;
+
+        const controller = new AbortController();
+        registrationController = controller;
+
+        try {
+          await modelContext.registerTool({
+            name: 'get_menu_item',
+            description: 'Look up a menu item and return its name, description, and details page URL. Use when a user asks about a drink on the menu.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                itemName: {
+                  type: 'string',
+                  minLength: 1,
+                  description: 'The menu item name to look up, matched without regard to capitalization or surrounding whitespace.',
+                },
+              },
+              required: ['itemName'],
+              additionalProperties: false,
+            },
+            execute(input) {
+              const menuItems = getMenuItems();
+              const availableItems = menuItems.map((item) => item.name);
+
+              if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+                return { error: 'Provide a non-empty menu item name.', availableItems };
+              }
+
+              const item = menuItems.find((entry) => normalizeName(entry.name) === normalizeName(input.itemName));
+              return item ?? {
+                error: `Menu item "${input.itemName}" not found.`,
+                availableItems,
+              };
+            },
+            annotations: { readOnlyHint: true },
+          }, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          if (registrationController === controller) registrationController = undefined;
+          if (error?.name !== 'AbortError') console.warn('Menu lookup tool registration failed.', error);
+        }
+      }
+
+      // pagehide also covers navigation into the back/forward cache.
+      window.addEventListener('pagehide', () => {
+        registrationController?.abort();
+        registrationController = undefined;
+      });
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) void registerMenuTool();
+      });
+
+      void registerMenuTool();
+    }
+  </script>
+
 </body>
 
 </html>
