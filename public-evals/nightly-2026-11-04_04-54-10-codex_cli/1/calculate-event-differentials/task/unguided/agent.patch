+  <script>
+    (() => {
+      const promotion = document.getElementById('maple-promotion');
+      const countdown = document.getElementById('maple-countdown');
+      const elapsed = document.getElementById('maple-elapsed');
+      const hour = 60 * 60 * 1000;
+
+      function formatDuration(milliseconds) {
+        const hours = Math.floor(Math.max(0, milliseconds) / hour);
+        const days = Math.floor(hours / 24);
+        const remainingHours = hours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${remainingHours} ${remainingHours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotion() {
+        // Component dates use the visitor's local zone; months are zero-based.
+        const end = new Date(2026, 2, 1, 0, 0, 0).getTime();
+        const now = Date.now();
+        countdown.textContent = now >= end
+          ? 'Offer ended · 0 days and 0 hours left'
+          : `${formatDuration(end - now)} left`;
+
+        // Set data-start to the confirmed local start, e.g. YYYY-MM-DDTHH:mm:ss.
+        // Do not infer a promotion start from the visitor's first page load.
+        const start = promotion.dataset.start
+          ? new Date(promotion.dataset.start).getTime()
+          : NaN;
+        if (!Number.isFinite(start) || start >= end) {
+          elapsed.textContent = 'Elapsed time unavailable: promotion start date not set.';
+        } else if (now < start) {
+          elapsed.textContent = 'Promotion has not started yet.';
+        } else {
+          elapsed.textContent = `${formatDuration(now - start)} since the promotion started.`;
+        }
+      }
+
+      updatePromotion();
+      window.setInterval(updatePromotion, 60 * 1000);
+      window.addEventListener('pageshow', updatePromotion);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotion();
+      });
+    })();
+  </script>
+
 </body>
 
