+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    let tourOpen = true;
+
+    // Keep normal link behavior available once the tour has been dismissed.
+    for (const eventName of ['click', 'auxclick']) {
+      rewardsLink.addEventListener(eventName, (event) => {
+        if (tourOpen) event.preventDefault();
+      });
+    }
+
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      if (!supportsPopover) tourStep.hidden = true;
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (supportsPopover) tourStep.showPopover();
+
+    if (!CSS.supports('anchor-name: --rewards-link') || !CSS.supports('top: anchor(bottom)')) {
+      // Follow scrolling, resizing, and layout shifts where CSS anchors are unavailable.
+      function trackRewards() {
+        if (!tourOpen) return;
+        const rect = rewardsLink.getBoundingClientRect();
+        const left = Math.max(12, Math.min(
+          rect.left + rect.width / 2 - tourStep.offsetWidth / 2,
+          document.documentElement.clientWidth - tourStep.offsetWidth - 12
+        ));
+        tourStep.style.top = `${rect.bottom + 12}px`;
+        tourStep.style.left = `${left}px`;
+        requestAnimationFrame(trackRewards);
+      }
+      trackRewards();
+    }
+
+    closeTour.focus({ preventScroll: true });
+  </script>
 </body>
 
