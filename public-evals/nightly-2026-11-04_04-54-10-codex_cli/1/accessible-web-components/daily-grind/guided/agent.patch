@@ -0,0 +1,64 @@
+// Reuse with <favorite-toggle drink-name="Drink name" favorite>.
+// The optional boolean `favorite` attribute also reflects the JS property.
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['favorite', 'drink-name'];
+
+  #button;
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    if (!this.#button) {
+      this.#button = document.createElement('button');
+      this.#button.type = 'button';
+      this.#button.innerHTML = `
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
+        </svg>
+        <span></span>
+      `;
+      this.append(this.#button);
+    }
+
+    this.#sync();
+    this.#button.addEventListener('click', this.#toggle);
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#toggle);
+  }
+
+  attributeChangedCallback() {
+    this.#sync();
+  }
+
+  #toggle = () => {
+    this.favorite = !this.favorite;
+    this.dispatchEvent(new CustomEvent('change', {
+      bubbles: true,
+      detail: {
+        favorite: this.favorite,
+        drinkName: this.getAttribute('drink-name'),
+      },
+    }));
+  };
+
+  #sync() {
+    if (!this.#button) return;
+
+    const drinkName = this.getAttribute('drink-name');
+    this.#button.setAttribute('aria-label', drinkName ? `Favorite ${drinkName}` : 'Favorite drink');
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+    this.#button.querySelector('span').textContent = this.favorite ? 'Favorited' : 'Favorite';
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
