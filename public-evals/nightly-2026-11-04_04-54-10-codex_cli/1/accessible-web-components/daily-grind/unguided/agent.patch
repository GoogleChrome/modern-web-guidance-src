+// Reuse with a stable drink-id and a human-readable drink-name.
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['checked', 'drink-name'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host { display: block; margin-top: 16px; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 16px;
+          border: 1px solid var(--secondary, #d7ccc8);
+          border-radius: 24px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+        button:hover { border-color: currentColor; }
+        button[aria-pressed="true"] {
+          background: var(--primary, #4e342e);
+          border-color: var(--primary, #4e342e);
+          color: white;
+        }
+        button:focus-visible {
+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 3px;
+        }
+        svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
+        button[aria-pressed="true"] svg { fill: currentColor; }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
+        </svg>
+        <span>Favorite</span>
+      </button>
+    `;
+    this.button = root.querySelector('button');
+    this.label = root.querySelector('span');
+    this.button.addEventListener('click', () => {
+      this.checked = !this.checked;
+      try {
+        if (this.storageKey) {
+          localStorage.setItem(this.storageKey, String(this.checked));
+        }
+      } catch {
+        // The toggle still works when browser storage is unavailable.
+      }
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkId: this.getAttribute('drink-id'), checked: this.checked },
+      }));
+    });
+  }
+
+  get storageKey() {
+    const id = this.getAttribute('drink-id');
+    return id ? `daily-grind:favorite:${id}` : null;
+  }
+
+  get checked() {
+    return this.hasAttribute('checked');
+  }
+
+  set checked(value) {
+    this.toggleAttribute('checked', Boolean(value));
+  }
+
+  connectedCallback() {
+    try {
+      const saved = this.storageKey && localStorage.getItem(this.storageKey);
+      if (saved !== null) this.checked = saved === 'true';
+    } catch {
+      // Keep the initial state if browser storage is unavailable.
+    }
+    this.render();
+  }
+
+  attributeChangedCallback() {
+    this.render();
+  }
+
+  render() {
+    this.button.setAttribute('aria-pressed', String(this.checked));
+    this.button.setAttribute('aria-label', `Favorite ${this.getAttribute('drink-name') || 'drink'}`);
+    this.label.textContent = this.checked ? 'Favorited' : 'Favorite';
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
