+    #promo-alert {
+      position: relative;
+      background: var(--accent);
+      block-size: auto;
+      overflow: clip;
+      /* Visibility switches at the end so the banner can finish shrinking. */
+      transition: block-size 0.4s ease, opacity 0.4s ease,
