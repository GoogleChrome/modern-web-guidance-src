+      visibility: hidden;
+    }
+
+    .promo-message {
+      padding: 20px calc(5% + 56px) 20px 5%;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      inset-block-start: 10px;
+      inset-inline-end: 5%;
+      display: grid;
+      place-items: center;
+      inline-size: 44px;
+      block-size: 44px;
+      border-radius: 5px;
+      font-size: 1.5rem;
+      cursor: pointer;
+      list-style: none;
+    }
+
+    #promo-alert::details-content {
+      transition: content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    .faq-section {
+      margin-block-start: 40px;
+    }
+
+    .faq {
+      margin-block-start: 20px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      overflow: clip;
+    }
+
+    #faq-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      padding: 20px;
+      font-weight: 600;
+      cursor: pointer;
+      list-style: none;
+    }
+
+    #faq-trigger::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+    }
+
+    .faq[open] > #faq-trigger::after {
+      content: '−';
+    }
+
+    #faq-trigger::-webkit-details-marker,
+    #alert-dismiss::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger:hover,
+    #alert-dismiss:hover {
+      background: var(--secondary);
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    /* Unsupported browsers retain the native, instant disclosure behavior. */
+    .faq::details-content {
+      block-size: 0;
+      overflow: clip;
+      transition: block-size 0.4s ease, content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    .faq[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-content {
+      padding: 0 20px 20px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      #promo-alert::details-content,
+      .faq::details-content {
+        transition: none;
+      }
+    }
