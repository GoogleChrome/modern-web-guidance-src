+  <script>
+    const order = new Map();
+    const summary = document.querySelector('.order-summary');
+    const items = document.querySelector('#order-items');
+    const count = document.querySelector('#order-count');
+
+    function renderOrder() {
+      items.replaceChildren();
+      let total = 0;
+      for (const item of order.values()) {
+        const row = document.createElement('li');
+        row.textContent = `${item.quantity} × ${item.size} ${item.drink}`;
+        items.append(row);
+        total += item.quantity;
+      }
+      count.textContent = `(${total} ${total === 1 ? 'drink' : 'drinks'})`;
+      summary.hidden = total === 0;
+    }
+
+    document.querySelectorAll('.drink-form').forEach((form) => {
+      const status = form.closest('.drink-content').querySelector('.order-status');
+      form.addEventListener('change', () => { status.textContent = ''; });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        if (!['small', 'medium', 'large'].includes(size)) return;
+        const drink = form.dataset.drink;
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        status.textContent = `Added ${size} ${drink}. ${item.quantity} in your order.`;
+      });
+    });
+
+    document.querySelector('.clear-order').addEventListener('click', () => {
+      order.clear();
+      renderOrder();
+      document.querySelectorAll('.order-status').forEach((status) => {
+        status.textContent = '';
+      });
+      document.querySelector('.drink-form button').focus();
+    });
+  </script>
 </body>
 
