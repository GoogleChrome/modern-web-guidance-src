+  <script>
+    const order = new Map();
+    const summary = document.querySelector('.order-summary');
+    const items = document.querySelector('#order-items');
+    const count = document.querySelector('#order-count');
+    const status = document.querySelector('#order-status');
+
+    function renderOrder() {
+      items.replaceChildren();
+      let total = 0;
+      for (const item of order.values()) {
+        const row = document.createElement('li');
+        row.textContent = `${item.quantity} × ${item.drink} — ${item.size}`;
+        items.append(row);
+        total += item.quantity;
+      }
+      count.textContent = total;
+      summary.hidden = total === 0;
+      return total;
+    }
+
+    document.querySelectorAll('.drink-order').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        const drink = form.dataset.drink;
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        const total = renderOrder();
+        status.textContent = `Added ${size} ${drink} to your order. ${total} ${total === 1 ? 'drink' : 'drinks'} in your order.`;
+      });
+    });
+
+    document.querySelector('#clear-order').addEventListener('click', () => {
+      order.clear();
+      renderOrder();
+      document.querySelector('.drink-order button').focus();
+      status.textContent = 'Your order has been cleared.';
+    });
+  </script>
