+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = [...navList.querySelectorAll('[data-nav-item]')];
+    let activeItem = navItems.find(item =>
+      location.pathname === item.pathname || location.pathname.startsWith(`${item.pathname}/`)
+    ) || navItems[0];
+
+    function positionIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const itemBounds = activeItem.getBoundingClientRect();
+      navList.style.setProperty('--indicator-left', `${itemBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-width', `${itemBounds.width}px`);
+    }
+
+    function selectItem(item) {
+      activeItem = item;
+      navItems.forEach(link => {
+        if (link === activeItem) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+      });
+      positionIndicator();
+    }
+
+    navItems.forEach(item => {
+      item.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectItem(item);
+      });
+    });
+
+    selectItem(activeItem);
+    // Establish the initial position before enabling movement between items.
+    requestAnimationFrame(() => requestAnimationFrame(() => {
+      navList.classList.add('indicator-ready');
+    }));
+    new ResizeObserver(positionIndicator).observe(navList);
+    document.fonts.ready.then(positionIndicator);
+  </script>
 </body>
 
