+  <script>
+    const navigation = document.querySelector('nav');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let cancelNavigation = () => {};
+
+    navigation.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+      cancelNavigation();
+      document.querySelectorAll('.navigation-arrival').forEach((element) => {
+        element.classList.remove('navigation-arrival');
+      });
+
+      const offset = navigation.getBoundingClientRect().height + 20;
+      document.documentElement.style.setProperty('--navigation-offset', `${offset}px`);
+      const destination = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - offset,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      const controller = new AbortController();
+      const { signal } = controller;
+      let frame;
+      let previousY = window.scrollY;
+      let settledSince = performance.now();
+      const startedAt = settledSince;
+
+      const cleanup = () => {
+        controller.abort();
+        cancelAnimationFrame(frame);
+      };
+      cancelNavigation = cleanup;
+
+      const arrive = () => {
+        // An interrupted scroll must never activate the destination.
+        if (Math.abs(window.scrollY - destination) > 2) return;
+        cleanup();
+        if (window.location.hash !== link.hash) {
+          history.pushState(null, '', link.hash);
+        }
+        target.focus({ preventScroll: true });
+        if (!reducedMotion.matches) {
+          target.classList.add('navigation-arrival');
+          target.addEventListener('animationend', () => {
+            target.classList.remove('navigation-arrival');
+          }, { once: true });
+        }
+      };
+
+      // Native completion is supplemented for browsers without scrollend and
+      // for destinations already at the current scroll position.
+      document.addEventListener('scrollend', arrive, { signal });
+      const watchScroll = (now) => {
+        if (window.scrollY !== previousY) {
+          previousY = window.scrollY;
+          settledSince = now;
+        }
+        if (now - settledSince >= 160 && Math.abs(window.scrollY - destination) <= 2) {
+          arrive();
+          return;
+        }
+        if (now - startedAt > 5000) {
+          cleanup();
+          return;
+        }
+        frame = requestAnimationFrame(watchScroll);
+      };
+
+      for (const type of ['wheel', 'touchstart', 'pointerdown']) {
+        window.addEventListener(type, cleanup, { passive: true, signal });
+      }
+      window.addEventListener('keydown', (keyEvent) => {
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp',
+             'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(keyEvent.key)) cleanup();
+      }, { signal });
+
+      window.scrollTo({ top: destination, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      frame = requestAnimationFrame(watchScroll);
+    });
+  </script>
