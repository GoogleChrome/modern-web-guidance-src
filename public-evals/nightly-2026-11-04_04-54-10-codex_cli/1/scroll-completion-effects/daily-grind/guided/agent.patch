+  <script>
+    const navigation = document.querySelector('nav');
+    let navigationRequest = 0;
+    let pendingScroll;
+
+    async function scrollToSection(top, behavior, signal) {
+      // Arm the fallback before scrolling, including for instant/no-op scrolls.
+      let finish;
+      let idleTimer;
+      const settled = new Promise((resolve) => { finish = resolve; });
+      const onScroll = () => {
+        clearTimeout(idleTimer);
+        idleTimer = setTimeout(finish, 120);
+      };
+      window.addEventListener('scrollend', finish, { once: true });
+      window.addEventListener('scroll', onScroll, { passive: true });
+      signal.addEventListener('abort', finish, { once: true });
+
+      try {
+        const result = window.scrollTo({ top, behavior });
+        onScroll();
+        // Use native completion promises where available. The idle/event
+        // fallback handles older browsers and destinations already in view.
+        if (result && typeof result.then === 'function') {
+          await result;
+        } else {
+          await settled;
+        }
+      } finally {
+        clearTimeout(idleTimer);
+        window.removeEventListener('scrollend', finish);
+        window.removeEventListener('scroll', onScroll);
+        signal.removeEventListener('abort', finish);
+      }
+    }
+
+    navigation.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+
+      const request = ++navigationRequest;
+      pendingScroll?.abort();
+      pendingScroll = new AbortController();
+      document.querySelectorAll('.navigation-arrival').forEach((element) => {
+        element.classList.remove('navigation-arrival');
+      });
+
+      const top = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - navigation.offsetHeight - 16,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        ? 'instant' : 'smooth';
+      await scrollToSection(top, behavior, pendingScroll.signal);
+
+      // Superseded or manually interrupted navigation must not steal focus.
+      if (request !== navigationRequest || Math.abs(window.scrollY - top) > 2) return;
+      if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+      target.focus({ preventScroll: true });
+      target.classList.add('navigation-arrival');
+    });
+  </script>
