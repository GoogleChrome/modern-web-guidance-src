+      };
+
+      async function loadVerifiedAsset(name, asset) {
+        try {
+          const response = await fetch(asset.url, {
+            integrity: asset.integrity,
+            mode: 'cors',
+            credentials: 'omit',
+            referrerPolicy: 'no-referrer',
+          });
+          if (!response.ok) throw new Error(`HTTP ${response.status}`);
+          if (name === 'font') {
+            const font = new FontFace('Inter', await response.arrayBuffer(), {
+              weight: '400', style: 'normal', display: 'swap',
+            });
+            document.fonts.add(await font.load());
+          } else {
+            const objectURL = URL.createObjectURL(await response.blob());
+            const target = document.querySelector(name === 'hero' ? '.hero' : `.photo-${name}`);
+            const property = name === 'hero' ? '--hero-image' : '--card-image';
+            target.style.setProperty(property, `url("${objectURL}")`);
+            // Keep blobs alive while displayed, including across back/forward cache restores.
+            window.addEventListener('pagehide', (event) => {
+              if (!event.persisted) URL.revokeObjectURL(objectURL);
+            });
+          }
+        } catch (error) {
+          // Fail closed: retain the system font or solid image placeholder on any failure.
+          console.warn(`Could not load verified ${name} asset.`, error);
+        }
+      }
+
+      for (const [name, asset] of Object.entries(assets)) loadVerifiedAsset(name, asset);
+    }
