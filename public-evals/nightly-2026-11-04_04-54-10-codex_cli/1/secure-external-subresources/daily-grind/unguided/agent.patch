+  <script>
+    // <img> and CSS font/background URLs do not enforce SRI themselves.
+    // Fetch checks the exact bytes before they reach an image or FontFace.
+    // Do not add direct remote src/url fallbacks: they bypass verification.
+    async function fetchVerified(url, integrity) {
+      const response = await fetch(url, {
+        integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadVerifiedImage(img) {
+      let objectURL;
+      try {
+        const response = await fetchVerified(img.dataset.src, img.dataset.integrity);
+        objectURL = URL.createObjectURL(await response.blob());
+        img.addEventListener('load', () => {
+          img.hidden = false;
+          URL.revokeObjectURL(objectURL);
+        }, { once: true });
+        img.addEventListener('error', () => {
+          URL.revokeObjectURL(objectURL);
+          img.removeAttribute('src');
+        }, { once: true });
+        img.src = objectURL;
+      } catch (error) {
+        if (objectURL) URL.revokeObjectURL(objectURL);
+        console.warn('Verified image unavailable; keeping the text fallback.', error);
+      }
+    }
+
+    async function loadVerifiedFont() {
+      try {
+        const response = await fetchVerified(
+          "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.0.18/files/lora-latin-400-normal.woff2",
+          "sha384-l9U4hpuXvD+l+EFv6G1yCdXR5QTgqh3KTS7oWKueUdtbW2OoySBd6//69e9OA7ro"
+        );
+        const font = new FontFace('Lora', await response.arrayBuffer(), {
+          weight: '400', style: 'normal', display: 'swap'
+        });
+        document.fonts.add(await font.load());
+      } catch (error) {
+        console.warn('Verified font unavailable; using the system serif font.', error);
+      }
+    }
+
+    document.querySelectorAll('img[data-src][data-integrity]').forEach(loadVerifiedImage);
+    loadVerifiedFont();
+    document.addEventListener('DOMContentLoaded', () => {
+      if (typeof window.dayjs === 'function') {
+        document.getElementById('copyright-year').textContent = window.dayjs().format('YYYY');
+      }
+    });
+  </script>
