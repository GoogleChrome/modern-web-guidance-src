@@ -0,0 +1,84 @@
+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+// Demo recipients exist only in this page's memory. A real service must supply
+// authenticated recipient PUBLIC keys and keep the private keys off the client.
+const recipients = new Map();
+const encoder = new TextEncoder();
+const kems = { hybrid: ml_kem768_x25519, quantum: ml_kem768 };
+export const modeNames = { classical: 'Standard · X25519', hybrid: 'Hybrid · X25519 + ML-KEM-768', quantum: 'Post-quantum · ML-KEM-768' };
+const base64 = bytes => btoa(String.fromCharCode(...bytes));
+const unbase64 = value => Uint8Array.from(atob(value), char => char.charCodeAt(0));
+
+function requireCrypto() {
+  if (!globalThis.isSecureContext || !globalThis.crypto?.subtle) {
+    throw new Error('Encryption needs a secure connection. Open this page over HTTPS or localhost.');
+  }
+}
+async function getRecipient(mode) {
+  if (!Object.hasOwn(modeNames, mode)) throw new Error('Choose a supported protection option.');
+  if (!recipients.has(mode)) {
+    const keys = mode === 'classical' ? (() => {
+      const secretKey = x25519.utils.randomSecretKey();
+      return { secretKey, publicKey: x25519.getPublicKey(secretKey) };
+    })() : kems[mode].keygen();
+    const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', keys.publicKey));
+    recipients.set(mode, { ...keys, id: base64(digest) });
+  }
+  return recipients.get(mode);
+}
+async function deriveKey(secret, salt, mode, usage) {
+  try {
+    const material = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+    return await crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt, info: encoder.encode(`daily-grind/delivery-note/v1/${mode}/AES-256-GCM`) }, material, { name: 'AES-GCM', length: 256 }, false, [usage]);
+  } finally {
+    secret.fill(0);
+  }
+}
+export async function encryptNote(plaintext, mode) {
+  requireCrypto();
+  if (!plaintext.trim() || plaintext.length > 500) throw new Error('Add a note between 1 and 500 characters.');
+  const recipient = await getRecipient(mode);
+  let sharedSecret, encapsulation;
+  if (mode === 'classical') {
+    const ephemeral = x25519.utils.randomSecretKey();
