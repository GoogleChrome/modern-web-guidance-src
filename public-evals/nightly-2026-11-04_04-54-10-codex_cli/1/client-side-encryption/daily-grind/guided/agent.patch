@@ -0,0 +1,28 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, encryptNote, decryptNote } from './crypto.js';
+
+for (const suite of ['hybrid', 'pq', 'classical']) {
+  test(`${suite}: round trip, fresh randomness, and tampering rejection`, async () => {
+    const recipient = createRecipient(suite);
+    const payload = { note: 'Gate code 1234. Café door ☕', delivery: 'Leave at the door' };
+    const envelope = await encryptNote(recipient.publicKey, suite, payload);
+    assert.deepEqual(await decryptNote(recipient, envelope), payload);
+    assert.ok(!JSON.stringify(envelope).includes('1234'));
+    const second = await encryptNote(recipient.publicKey, suite, payload);
+    assert.notEqual(second.iv, envelope.iv);
+    assert.notEqual(second.capsule, envelope.capsule);
+    for (const field of ['ciphertext', 'capsule', 'salt', 'iv']) {
+      const bytes = Uint8Array.from(atob(envelope[field]), c => c.charCodeAt(0));
+      bytes[0] ^= 1;
+      const changed = { ...envelope, [field]: btoa(String.fromCharCode(...bytes)) };
+      await assert.rejects(() => decryptNote(recipient, changed));
+    }
+    for (const changed of [{ id: 'another-order' }, { version: 2 }, { suite: 'unknown' }, { recipient: 'another-recipient' }]) {
+      await assert.rejects(() => decryptNote(recipient, { ...envelope, ...changed }));
+    }
+    const wrongRecipient = createRecipient(suite);
+    await assert.rejects(() => decryptNote(wrongRecipient, envelope));
+    wrongRecipient.secretKey.fill(0); recipient.secretKey.fill(0);
+  });
+}
diff --git a/src/main.js b/src/main.js
new file mode 100644
index 0000000..05830ae
--- /dev/null
+++ b/src/main.js
@@ -0,0 +1,81 @@
+import { createRecipient, encryptNote, decryptNote } from './crypto.js';
+
+const $ = (id) => document.getElementById(id);
+const form = $('notes-form'), fields = $('note-fields'), note = $('note');
+const result = $('encrypted-result'), preview = $('decrypted-note');
+let recipient = null, envelope = null;
+function status(message, error = false) {
+  $('status').textContent = message;
+  $('status').classList.toggle('error', error);
+}
+function destroyDraft() {
+  recipient?.secretKey.fill(0);
+  recipient = null; envelope = null;
+  $('envelope').textContent = '';
+  preview.textContent = ''; preview.hidden = true;
+  $('reveal-note').textContent = 'Decrypt & preview';
+  result.hidden = true;
+}
+note.addEventListener('input', () => {
+  $('note-count').textContent = `${note.value.length.toLocaleString()} / 1,000`;
+  note.setCustomValidity('');
+});
+form.addEventListener('change', () => {
+  const suite = new FormData(form).get('suite');
+  $('suite-summary').textContent = { hybrid: 'Hybrid protection', pq: 'Post-quantum protection', classical: 'Classical protection' }[suite];
+});
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!note.value.trim()) { note.setCustomValidity('Please add a delivery note.'); note.reportValidity(); return; }
+  const data = new FormData(form);
+  fields.disabled = true;
+  status('Establishing a shared secret and encrypting your note…');
+  let nextRecipient;
+  try {
+    // Each draft gets an independent local recipient; the sender uses only its public key.
+    nextRecipient = createRecipient(data.get('suite'));
+    const nextEnvelope = await encryptNote(nextRecipient.publicKey, nextRecipient.suite,
+      { note: data.get('note').trim(), delivery: data.get('delivery') });
+    destroyDraft();
+    recipient = nextRecipient; envelope = nextEnvelope;
+    $('envelope').textContent = JSON.stringify(envelope, null, 2);
+    result.hidden = false;
+    note.value = ''; $('note-count').textContent = '0 / 1,000';
+    status('Encrypted draft ready. Nothing was sent. This draft lasts only until you leave or refresh this tab.');
+  } catch {
+    nextRecipient?.secretKey.fill(0);
+    status('We couldn’t encrypt this note. Your text has not been sent. Please try again.', true);
+  } finally { fields.disabled = false; }
+});
+$('reveal-note').addEventListener('click', async () => {
+  if (!preview.hidden) {
+    preview.textContent = ''; preview.hidden = true;
+    $('reveal-note').textContent = 'Decrypt & preview'; return;
+  }
+  const currentEnvelope = envelope, currentRecipient = recipient;
+  try {
+    const decoded = await decryptNote(currentRecipient, currentEnvelope);
+    if (envelope !== currentEnvelope) return;
+    preview.textContent = `${decoded.delivery}\n\n${decoded.note}`;
+    preview.hidden = false; $('reveal-note').textContent = 'Hide decrypted note';
+    status('Decrypted and authenticated successfully in this tab.');
+  } catch { status('Unable to authenticate this draft. Its contents or key may have changed.', true); }
+});
+$('copy-envelope').addEventListener('click', async () => {
+  try {
+    if (!envelope) return;
+    await navigator.clipboard.writeText(JSON.stringify(envelope, null, 2));
+    status('Encrypted envelope copied. The private recipient key remains in this tab.');
+  } catch { status('Clipboard access is unavailable. You can select and copy the encrypted envelope above.', true); }
+});
+$('clear-note').addEventListener('click', () => {
+  destroyDraft(); status('Encrypted draft and recipient key deleted.'); note.focus();
+});
+window.addEventListener('pagehide', () => {
+  destroyDraft(); note.value = ''; $('note-count').textContent = '0 / 1,000'; status('');
+});
+if (globalThis.isSecureContext && globalThis.crypto?.subtle) {
+  fields.disabled = false; status('');
+} else {
+  status('Encryption requires a secure HTTPS connection and Web Crypto support. No note can be submitted here.', true);
+}
