+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+
+export const SUITES = Object.freeze({
+  hybrid: { name: 'ML-KEM-768 + X25519', kem: ml_kem768_x25519 },
+  pq: { name: 'ML-KEM-768', kem: ml_kem768 },
+  classical: { name: 'X25519', kem: null },
+});
+const utf8 = new TextEncoder();
+export const toBase64 = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+const fromBase64 = (value) => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+const random = (length) => crypto.getRandomValues(new Uint8Array(length));
+
+export function createRecipient(suite) {
+  if (!Object.hasOwn(SUITES, suite)) throw new Error('Unsupported encryption suite');
+  return { suite, ...(SUITES[suite].kem ?? x25519).keygen() };
+}
+async function fingerprint(publicKey) {
+  return toBase64(await crypto.subtle.digest('SHA-256', publicKey));
+}
+async function deriveKey(secret, salt, context) {
+  try {
+    const base = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+    return await crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt,
+      info: utf8.encode(`daily-grind/delivery-notes/v1/${context}`) }, base,
+      { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+  } finally { secret.fill(0); }
+}
+function headerBytes(envelope) {
+  // Fixed field order binds all routing and protocol metadata to the GCM tag.
+  return utf8.encode(JSON.stringify({ version: envelope.version, suite: envelope.suite,
+    cipher: envelope.cipher, id: envelope.id, recipient: envelope.recipient,
+    capsule: envelope.capsule, salt: envelope.salt, iv: envelope.iv }));
+}
+export async function encryptNote(publicKey, suite, note) {
+  if (!Object.hasOwn(SUITES, suite)) throw new Error('Unsupported encryption suite');
+  let capsule, sharedSecret;
+  if (suite === 'classical') {
+    const ephemeral = x25519.keygen();
+    try { sharedSecret = x25519.getSharedSecret(ephemeral.secretKey, publicKey); capsule = ephemeral.publicKey; }
+    finally { ephemeral.secretKey.fill(0); }
+  } else {
+    const result = SUITES[suite].kem.encapsulate(publicKey);
+    capsule = result.cipherText;
+    sharedSecret = result.sharedSecret;
+  }
+  const salt = random(32), iv = random(12);
+  const key = await deriveKey(sharedSecret, salt, suite);
+  const envelope = { version: 1, suite, cipher: 'AES-256-GCM', id: crypto.randomUUID(),
+    recipient: await fingerprint(publicKey), capsule: toBase64(capsule),
+    salt: toBase64(salt), iv: toBase64(iv) };
+  const plaintext = utf8.encode(JSON.stringify(note));
+  try {
+    envelope.ciphertext = toBase64(await crypto.subtle.encrypt({ name: 'AES-GCM', iv,
+      tagLength: 128, additionalData: headerBytes(envelope) }, key, plaintext));
+    return envelope;
+  } finally { plaintext.fill(0); }
+}
+export async function decryptNote(recipient, envelope) {
+  if (envelope.version !== 1 || envelope.cipher !== 'AES-256-GCM' ||
+      recipient.suite !== envelope.suite || envelope.recipient !== await fingerprint(recipient.publicKey)) {
+    throw new Error('Envelope does not match this recipient or protocol');
+  }
+  const capsule = fromBase64(envelope.capsule);
+  const secret = recipient.suite === 'classical'
+    ? x25519.getSharedSecret(recipient.secretKey, capsule)
+    : SUITES[recipient.suite].kem.decapsulate(capsule, recipient.secretKey);
+  const key = await deriveKey(secret, fromBase64(envelope.salt), envelope.suite);
+  const plaintext = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM',
+    iv: fromBase64(envelope.iv), tagLength: 128, additionalData: headerBytes(envelope) },
+    key, fromBase64(envelope.ciphertext)));
+  try { return JSON.parse(new TextDecoder().decode(plaintext)); }
+  finally { plaintext.fill(0); }
+}
