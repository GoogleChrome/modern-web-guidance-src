+  <aside class="coffee-cart" id="coffee-cart" aria-label="Quick coffee order">
+    <div class="cart-header">
+      <div class="drag-handle" id="cart-handle" tabindex="0" role="button" aria-label="Move coffee cart. Drag or use arrow keys; hold Shift for larger steps.">
