+      </div>
+      <div class="quantity-row"><span id="quantity-label">How many?</span><div class="stepper" role="group" aria-labelledby="quantity-label"><button id="decrease" aria-label="Decrease quantity" disabled>−</button><output id="quantity" aria-live="polite">1</output><button id="increase" aria-label="Increase quantity">+</button></div></div>
+      <div class="cart-total"><div>Subtotal<small>Taxes calculated at checkout</small></div><strong id="total" aria-live="polite">$5.50</strong></div>
+      <button class="order-button" id="prepare-order"><span>Prepare pickup order</span><span aria-hidden="true">↗</span></button>
+      <p class="order-summary" id="order-summary" role="status" hidden></p>
+      <p class="cart-footnote">Locally roasted. Always made with love.</p>
+    </div>
