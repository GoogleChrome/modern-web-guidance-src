+  <script>
+    (() => {
+      const cart = document.getElementById('coffee-cart');
+      const handle = document.getElementById('cart-handle');
+      const body = document.getElementById('cart-body');
+      const collapse = document.getElementById('collapse-cart');
+      const drink = document.getElementById('drink');
+      const sizes = [...document.querySelectorAll('[data-size]')];
+      const decrease = document.getElementById('decrease');
+      const increase = document.getElementById('increase');
+      const summary = document.getElementById('order-summary');
+      const prices = { latte: 5.5, espresso: 3.5, coldbrew: 4.5 };
+      const sizePrices = { small: -0.75, regular: 0, large: 0.75 };
+      let quantity = 1;
+      let size = 'regular';
+      let drag = null;
+      let moved = false;
+      const money = value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
+      const total = () => (prices[drink.value] + sizePrices[size]) * quantity;
+      function update() {
+        document.getElementById('quantity').value = quantity;
+        document.getElementById('total').textContent = money(total());
+        decrease.disabled = quantity === 1;
+        increase.disabled = quantity === 20;
+        summary.hidden = true;
+      }
+      drink.addEventListener('change', update);
+      sizes.forEach(button => button.addEventListener('click', () => {
+        size = button.dataset.size;
+        sizes.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+        update();
+      }));
+      decrease.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); update(); });
+      increase.addEventListener('click', () => { quantity = Math.min(20, quantity + 1); update(); });
+      document.getElementById('prepare-order').addEventListener('click', () => {
+        summary.textContent = `${quantity} × ${size} ${drink.selectedOptions[0].text} — ${money(total())}. Your order summary is ready. Online checkout is coming soon; please place your order at the café.`;
+        summary.hidden = false;
+        keepInView();
+      });
+      function moveTo(x, y) {
+        const bounds = cart.getBoundingClientRect();
+        cart.style.left = `${Math.max(12, Math.min(x, window.innerWidth - bounds.width - 12))}px`;
+        cart.style.top = `${Math.max(12, Math.min(y, window.innerHeight - bounds.height - 12))}px`;
+        cart.style.right = 'auto';
+        cart.style.bottom = 'auto';
+      }
+      function keepInView() {
+        const bounds = cart.getBoundingClientRect();
+        moveTo(bounds.left, bounds.top);
+      }
+      collapse.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        collapse.setAttribute('aria-expanded', String(!body.hidden));
+        collapse.setAttribute('aria-label', body.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        collapse.textContent = body.hidden ? '+' : '−';
+        keepInView();
+      });
+      handle.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        const bounds = cart.getBoundingClientRect();
+        drag = { x: event.clientX - bounds.left, y: event.clientY - bounds.top };
+        handle.setPointerCapture(event.pointerId);
+        handle.focus({ preventScroll: true });
+      });
+      handle.addEventListener('pointermove', event => {
+        if (!drag) return;
+        moved = true;
+        moveTo(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      const endDrag = () => { drag = null; };
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', endDrag);
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+        if (!directions[event.key]) return;
+        event.preventDefault();
+        const bounds = cart.getBoundingClientRect();
+        const step = event.shiftKey ? 40 : 10;
+        moved = true;
+        moveTo(bounds.left + directions[event.key][0] * step, bounds.top + directions[event.key][1] * step);
+      });
+      window.addEventListener('resize', () => { if (moved || cart.style.left) keepInView(); });
+      // Start compact on small screens so the homepage remains easy to browse.
+      if (window.matchMedia('(max-width: 760px)').matches) collapse.click();
+    })();
+  </script>
