+      </fieldset>
+      <div class="cart-purchase">
+        <div><span class="cart-label">Quantity</span><div class="quantity"><button id="decrease" type="button" aria-label="Decrease quantity" disabled>−</button><output id="quantity" aria-label="Quantity">1</output><button id="increase" type="button" aria-label="Increase quantity">+</button></div></div>
+        <div><span class="cart-label">Subtotal</span><output class="selection-total" id="selection-total" aria-live="polite">$5.50</output></div>
+      </div>
+      <button class="add-coffee" id="add-coffee" type="button">Add to my bag <span aria-hidden="true">↗</span></button>
+      <p class="cart-footnote">Freshly roasted. Made for your daily ritual.</p>
+      <p class="cart-status" role="status" id="cart-status"></p>
+      <section class="bag" id="bag" aria-labelledby="bag-title" hidden>
+        <h3 id="bag-title">Your coffee bag</h3>
+        <ul id="bag-items"></ul>
+        <p class="bag-total"><span>Bag total</span><output id="bag-total">$0.00</output></p>
