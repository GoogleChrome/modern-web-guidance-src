+
+  <script>
+    (() => {
+      const cart = document.querySelector('.coffee-cart');
+      const handle = cart.querySelector('.drag-handle');
+      const toggle = cart.querySelector('.cart-toggle');
+      const body = document.getElementById('cart-body');
+      let positioned = false;
+      let offsetX = 0;
+      let offsetY = 0;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - cart.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - cart.offsetHeight);
+        cart.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        cart.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        cart.style.right = 'auto';
+        cart.style.bottom = 'auto';
+        positioned = true;
+      }
+      function keepInView() {
+        if (!positioned) return;
+        const rect = cart.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+      handle.classList.add('drag-enabled');
+      handle.tabIndex = 0;
+      handle.setAttribute('role', 'group');
+      handle.setAttribute('aria-label', 'Move coffee cart. Drag or use arrow keys to reposition.');
+      handle.title = 'Drag to move · Arrow keys when focused';
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || !event.isPrimary) return;
+        const rect = cart.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('dragging');
+      });
+      handle.addEventListener('pointermove', (event) => {
+        if (handle.hasPointerCapture(event.pointerId)) moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      function endDrag(event) {
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+        handle.classList.remove('dragging');
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', () => handle.classList.remove('dragging'));
+      handle.addEventListener('keydown', (event) => {
+        const directions = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        const delta = directions[event.key];
+        if (!delta) return;
+        event.preventDefault();
+        const rect = cart.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+      window.addEventListener('resize', keepInView);
+      new ResizeObserver(keepInView).observe(cart);
+      toggle.style.display = 'block';
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        toggle.textContent = body.hidden ? '+' : '−';
+        keepInView();
+      });
+
+      const coffees = {
+        latte: { name: 'Maple Oat Latte', price: 550, note: 'Oat milk, real maple, a little everyday magic.' },
+        espresso: { name: 'Dark Roast Espresso', price: 350, note: 'Rich, bold espresso with a smooth, smoky finish.' },
+        coldbrew: { name: 'Cold Brew', price: 450, note: 'Slow-steeped for 18 hours. Always served iced.' }
+      };
+      const choice = document.getElementById('coffee-choice');
+      const decrease = document.getElementById('decrease');
+      const increase = document.getElementById('increase');
+      const status = document.getElementById('cart-status');
+      const hot = document.querySelector('input[value="Hot"]');
+      const iced = document.querySelector('input[value="Iced"]');
+      let quantity = 1;
+      const bag = new Map();
+      const money = (cents) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+      function updateSelection() {
+        const coffee = coffees[choice.value];
+        document.getElementById('quantity').value = quantity;
+        document.getElementById('selection-total').value = money(coffee.price * quantity);
+        document.getElementById('coffee-note').textContent = coffee.note;
+        decrease.disabled = quantity === 1;
+        increase.disabled = quantity === 20;
+        hot.disabled = choice.value === 'coldbrew';
+        if (hot.disabled) iced.checked = true;
+      }
+      decrease.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateSelection(); });
+      increase.addEventListener('click', () => { quantity = Math.min(20, quantity + 1); updateSelection(); });
+      choice.addEventListener('change', () => { status.textContent = ''; updateSelection(); });
+      function renderBag() {
+        let count = 0;
+        let total = 0;
+        const list = document.getElementById('bag-items');
+        list.replaceChildren();
+        for (const [key, item] of bag) {
+          count += item.quantity;
+          total += item.quantity * item.price;
+          const row = document.createElement('li');
+          const text = document.createElement('span');
+          text.textContent = `${item.quantity} × ${item.temperature} ${item.name} · ${money(item.quantity * item.price)}`;
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${item.temperature} ${item.name} from bag`);
+          remove.addEventListener('click', () => {
+            bag.delete(key);
+            renderBag();
+            status.textContent = `${item.name} removed from your bag.`;
+            document.getElementById('add-coffee').focus();
+          });
+          row.append(text, remove);
+          list.append(row);
+        }
+        document.getElementById('bag-count').textContent = `Bag · ${count}`;
+        document.getElementById('bag-total').value = money(total);
+        document.getElementById('bag').hidden = count === 0;
+      }
+      document.getElementById('add-coffee').addEventListener('click', () => {
+        const coffee = coffees[choice.value];
+        const temperature = document.querySelector('input[name="temperature"]:checked').value;
+        const key = `${choice.value}-${temperature}`;
+        const existing = bag.get(key);
+        bag.set(key, { ...coffee, temperature, quantity: quantity + (existing?.quantity || 0) });
+        renderBag();
+        status.textContent = `${quantity} ${temperature.toLowerCase()} ${coffee.name} added to your bag.`;
+      });
+    })();
+  </script>
 </body>
 
