+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateCurrentSection() {
+      const panelTop = panel.getBoundingClientRect().top + panel.clientTop;
+      const closest = sections.reduce((nearest, section) =>
+        Math.abs(section.getBoundingClientRect().top - panelTop) <
+        Math.abs(nearest.getBoundingClientRect().top - panelTop) ? section : nearest
+      );
+
+      links.forEach(link => {
+        if (link.hash === `#${closest.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    links.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const top = sections[index].getBoundingClientRect().top -
+          panel.getBoundingClientRect().top - panel.clientTop + panel.scrollTop;
+        panel.scrollTo({ top, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      });
+    });
+
+    let pendingFrame = false;
+    panel.addEventListener('scroll', () => {
+      if (pendingFrame) return;
+      pendingFrame = true;
+      requestAnimationFrame(() => {
+        updateCurrentSection();
+        pendingFrame = false;
+      });
+    }, { passive: true });
+    panel.addEventListener('scrollend', updateCurrentSection);
+    window.addEventListener('resize', updateCurrentSection);
+    updateCurrentSection();
+  </script>
