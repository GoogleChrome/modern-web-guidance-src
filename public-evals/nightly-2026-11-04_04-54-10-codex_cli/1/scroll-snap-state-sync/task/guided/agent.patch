+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setCurrent(id) {
+      links.forEach(link => {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncCurrent() {
+      const top = panel.getBoundingClientRect().top + panel.clientTop;
+      const nearest = headings.reduce((closest, heading) =>
+        Math.abs(heading.getBoundingClientRect().top - top) <
+        Math.abs(closest.getBoundingClientRect().top - top) ? heading : closest
+      );
+      setCurrent(nearest.id);
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = headings.find(item => `#${item.id}` === link.hash);
+        heading.focus({ preventScroll: true });
+        panel.scrollTo({
+          top: panel.scrollTop + heading.getBoundingClientRect().top -
+            panel.getBoundingClientRect().top - panel.clientTop,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (event.snapTargetBlock) setCurrent(event.snapTargetBlock.id);
+      });
+    } else {
+      // Track headers relative to this panel, rather than the page viewport.
+      const observer = new IntersectionObserver(syncCurrent, {
+        root: panel,
+        threshold: [0, 1]
+      });
+      headings.forEach(heading => observer.observe(heading));
+      // Also synchronize when a scroll ends between header visibility changes.
+      let scrollTimer;
+      panel.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(syncCurrent, 120);
+      }, { passive: true });
+    }
+    syncCurrent();
+  </script>
