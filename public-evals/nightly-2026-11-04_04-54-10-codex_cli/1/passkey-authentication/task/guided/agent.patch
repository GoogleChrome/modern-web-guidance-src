+  <script type="module">
+    const form = document.querySelector('#signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeController;
+    let explicitPending = false;
+    let authenticated = false;
+
+    const supported = window.isSecureContext && window.PublicKeyCredential && navigator.credentials?.get;
+    // Bundle the compatibility helpers locally so signing in needs no third-party requests.
+    const ready = supported ? import('./assets/webauthn-polyfills.js') : Promise.resolve();
+    // Handle initialization failures even if no user clicks the button.
+    ready.catch(() => {
+      status.textContent = 'Passkey support could not be loaded. Please reload and try again.';
+    });
+
+    async function authenticate(conditional, controller) {
+      await ready;
+      if (controller.signal.aborted) return;
+      const response = await fetch('/api/login/options', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({}),
+        cache: 'no-store',
+        signal: controller.signal,
+      });
+      if (!response.ok) throw new Error('Unable to start passkey sign-in. Please try again.');
+      // The server issues and stores the challenge and expected user-verification policy.
+      const options = await response.json();
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+      if (controller.signal.aborted) return;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: controller.signal,
+          mediation: conditional ? 'conditional' : 'required',
+        });
+      } catch (error) {
+        if (error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) status.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+          return;
+        }
+        throw error;
+      }
+      if (!credential || controller.signal.aborted) return;
+
+      button.disabled = true;
+      status.textContent = 'Verifying your passkey…';
+      const encoded = credential.toJSON();
+      // Only successful server verification establishes an authenticated session.
+      const verification = await fetch('/api/login/verify', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+        signal: controller.signal,
+      });
+      if (!verification.ok) {
+        if (verification.status === 404 && !authenticated && PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId || location.hostname,
+              credentialId: encoded.id,
+            });
+          } catch {
+            // Provider synchronization is optional; preserve the verification error.
+          }
+        }
+        throw new Error('Your passkey could not be verified. Please try again.');
+      }
+      authenticated = true;
+      status.textContent = 'Successfully signed in with your passkey.';
+    }
+
+    async function startAutofill() {
+      if (!supported || authenticated || explicitPending || activeController) return;
+      const controller = new AbortController();
+      activeController = controller;
+      try {
+        await ready;
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (controller.signal.aborted || !capabilities.conditionalGet) return;
+        await authenticate(true, controller);
+      } catch (error) {
+        if (!controller.signal.aborted) status.textContent = error.message;
+      } finally {
+        if (activeController === controller) {
+          activeController = undefined;
+          button.disabled = authenticated;
+        }
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!supported || explicitPending || authenticated) return;
+      explicitPending = true;
+      activeController?.abort();
+      const controller = new AbortController();
+      activeController = controller;
+      button.disabled = true;
+      status.textContent = 'Use your device to confirm your passkey.';
+      try {
+        await authenticate(false, controller);
+      } catch (error) {
+        if (!controller.signal.aborted) status.textContent = error.message;
+      } finally {
+        if (activeController === controller) activeController = undefined;
+        explicitPending = false;
+        button.disabled = authenticated;
+        if (!authenticated) void startAutofill();
+      }
+    });
+
+    if (supported) {
+      // Register silently on load so focusing the username opens native passkey autofill.
+      void startAutofill();
+      document.querySelector('#username').addEventListener('focus', () => void startAutofill());
+    } else {
+      button.disabled = true;
+      status.textContent = 'Passkeys require a supported browser and HTTPS (or localhost).';
+    }
+  </script>
