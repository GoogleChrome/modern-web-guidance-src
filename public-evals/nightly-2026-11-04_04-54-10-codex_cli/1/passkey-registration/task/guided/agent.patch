+  <script type="module">
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const status = document.querySelector('#register-status');
+    let registrationInProgress = false;
+
+    async function initializePasskeys() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+        status.textContent = 'Passkeys require a supported browser and a secure connection.';
+        return;
+      }
+
+      try {
+        // Bundle the compatibility layer locally; no third-party scripts run on this page.
+        await import('./assets/webauthn-polyfills.js');
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities.conditionalGet || !capabilities.passkeyPlatformAuthenticator) {
+          status.textContent = 'Passkey creation is unavailable on this device. You can keep using your current sign-in method.';
+          return;
+        }
+        registerButton.disabled = false;
+        status.textContent = '';
+      } catch {
+        status.textContent = 'Unable to check passkey support. You can keep using your current sign-in method.';
+      }
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled || registrationInProgress) return;
+      registrationInProgress = true;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      status.textContent = 'Follow your device’s instructions to create a passkey.';
+
+      try {
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify({ promotion: true }),
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey registration. Please try again.');
+
+        // Keep the server's challenge, RP ID, and authenticator policy intact.
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential) throw new Error('Passkey creation was cancelled. You can try again.');
+        const encodedResponse = credential.toJSON();
+
+        status.textContent = 'Verifying your passkey…';
+        // Only verification failures signal an orphaned credential, never prompt cancellations.
+        try {
+          const verificationResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            cache: 'no-store',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify(encodedResponse),
+          });
+          if (!verificationResponse.ok) throw new Error('Passkey verification failed. Please try again.');
+        } catch (verificationError) {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rp.id || window.location.hostname,
+                credentialId: encodedResponse.id,
+              });
+            } catch {
+              // A synchronization error must not hide the original verification failure.
+            }
+          }
+          throw verificationError;
+        }
+
+        status.textContent = 'Passkey created successfully.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this device.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey creation requires a secure connection and a correctly configured domain.',
+        };
+        status.textContent = messages[error.name] || 'Unable to register your passkey. Please try again.';
+      } finally {
+        registrationInProgress = false;
+        registerButton.disabled = false;
+        registerButton.removeAttribute('aria-busy');
+      }
+    });
+
+    initializePasskeys();
+  </script>
 </body>
 
