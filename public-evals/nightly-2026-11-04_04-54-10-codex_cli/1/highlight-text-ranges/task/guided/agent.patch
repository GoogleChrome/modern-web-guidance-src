   </footer>
 
+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menu = document.getElementById('seasonal-menu');
+    const supportsHighlights = typeof CSS !== 'undefined' && 'highlights' in CSS
+      && typeof Highlight !== 'undefined';
+
+    function collectMenuText() {
+      return Array.from(menu.querySelectorAll('.card')).flatMap((card) => {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+        return nodes;
+      });
+    }
+
+    let textNodes = collectMenuText();
+
+    searchInput.addEventListener('input', () => {
+      if (supportsHighlights) {
+        CSS.highlights.delete('menu-search');
+      } else {
+        menu.querySelectorAll('mark.menu-search-match').forEach((mark) => {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        menu.normalize();
+        textNodes = collectMenuText();
+      }
+
+      const query = searchInput.value;
+      if (!query.trim()) return;
+
+      // Treat punctuation as literal text, not regular-expression syntax.
+      const pattern = new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
+      const ranges = [];
+
+      for (const node of textNodes) {
+        const matches = Array.from(node.textContent.matchAll(pattern));
+        if (supportsHighlights) {
+          for (const match of matches) {
+            const range = document.createRange();
+            range.setStart(node, match.index);
+            range.setEnd(node, match.index + match[0].length);
+            ranges.push(range);
+          }
+        } else if (matches.length) {
+          const fragment = document.createDocumentFragment();
+          let offset = 0;
+          for (const match of matches) {
+            fragment.append(node.textContent.slice(offset, match.index));
+            const mark = document.createElement('mark');
+            mark.className = 'menu-search-match';
+            mark.textContent = match[0];
+            fragment.append(mark);
+            offset = match.index + match[0].length;
+          }
+          fragment.append(node.textContent.slice(offset));
+          node.replaceWith(fragment);
+        }
+      }
+
+      if (supportsHighlights) {
+        CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+    });
+  </script>
+
 </body>
 
