diff --git a/src/utils/form-tools.ts b/src/utils/form-tools.ts
new file mode 100644
index 0000000..05d9371
--- /dev/null
+++ b/src/utils/form-tools.ts
@@ -0,0 +1,55 @@
+export interface FormResult {
+  success: boolean;
+  message: string;
+}
+
+// Experimental WebMCP members are not yet included in lib.dom types.
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<FormResult>) => void;
+};
+
+export function respondToAgent(event: AgentSubmitEvent, result: Promise<FormResult>) {
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(result);
+  }
+}
+
+export async function submitCredentials(
+  action: 'login' | 'register',
+  fields: FormData,
+): Promise<FormResult> {
+  const username = fields.get('username');
+  const password = fields.get('password');
+  if (typeof username !== 'string' || !username || typeof password !== 'string' || !password) {
+    return { success: false, message: 'Username and password are required.' };
+  }
+
+  try {
+    const response = await fetch(
+      `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password }),
+      },
+    );
+    const data = await response.json();
+    if (!response.ok) {
+      const reason = typeof data?.error === 'string' ? data.error : 'Unknown error';
+      return {
+        success: false,
+        message: `${action === 'login' ? 'Login' : 'Registration'} failed: ${reason}`,
+      };
+    }
+    // Return the outcome only; never expose credentials or authentication tokens.
+    return {
+      success: true,
+      message: action === 'login'
+        ? 'Login successful!'
+        : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return { success: false, message: 'An unexpected error occurred. Please try again later.' };
+  }
+}
diff --git a/tests/form-tools.test.mjs b/tests/form-tools.test.mjs
new file mode 100644
index 0000000..02aff73
--- /dev/null
+++ b/tests/form-tools.test.mjs
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { respondToAgent, submitCredentials } from '../src/utils/form-tools.ts';
+
+function credentials() {
+  const fields = new FormData();
+  fields.set('username', 'reader');
+  fields.set('password', 'password123');
+  return fields;
+}
+
+test('both tools submit named fields and return only the outcome', async (t) => {
+  for (const action of ['login', 'register']) {
+    await t.test(action, async (t) => {
+      t.mock.method(globalThis, 'fetch', async (url, options) => {
+        assert.ok(url.endsWith(`/api/${action}`));
+        assert.equal(options.method, 'POST');
+        assert.deepEqual(JSON.parse(options.body), { username: 'reader', password: 'password123' });
+        return Response.json({ token: 'private-token', username: 'reader' });
+      });
+      const result = await submitCredentials(action, credentials());
+      assert.equal(result.success, true);
+      assert.deepEqual(Object.keys(result).sort(), ['message', 'success']);
+      assert.ok(!JSON.stringify(result).includes('private-token'));
+    });
+  }
+});
+
+test('missing fields do not send requests', async (t) => {
+  const fetch = t.mock.method(globalThis, 'fetch', () => assert.fail('Unexpected request'));
+  const result = await submitCredentials('login', new FormData());
+  assert.equal(result.success, false);
+  assert.match(result.message, /required/);
+  assert.equal(fetch.mock.callCount(), 0);
+});
+
+test('API failures, network errors, and invalid JSON return usable errors', async (t) => {
+  for (const action of ['login', 'register']) {
+    const mock = t.mock.method(globalThis, 'fetch', async () => Response.json({ error: 'APP_ERR_1001' }, { status: 400 }));
+    assert.match((await submitCredentials(action, credentials())).message, /failed: APP_ERR_1001/);
+    mock.mock.restore();
+  }
+  for (const response of [() => { throw new Error('offline'); }, () => new Response('invalid json')]) {
+    const mock = t.mock.method(globalThis, 'fetch', response);
+    const result = await submitCredentials('login', credentials());
+    assert.equal(result.success, false);
+    assert.match(result.message, /unexpected error/);
+    mock.mock.restore();
+  }
+});
+
+test('agent submissions receive the same asynchronous result; regular submits need no WebMCP', async () => {
+  const result = Promise.resolve({ success: true, message: 'Login successful!' });
+  let received;
+  respondToAgent({ agentInvoked: true, respondWith(value) { received = value; } }, result);
+  assert.equal(received, result);
+  assert.equal((await received).success, true);
+  respondToAgent({}, result);
+  respondToAgent({ agentInvoked: true }, result);
+  respondToAgent({ agentInvoked: false, respondWith() { assert.fail('Manual submit'); } }, result);
+});
