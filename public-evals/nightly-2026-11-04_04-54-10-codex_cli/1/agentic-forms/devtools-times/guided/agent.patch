new file mode 100644
index 0000000..c26adb2
--- /dev/null
+++ b/src/types/webmcp.ts
@@ -0,0 +1,5 @@
+// Experimental declarative WebMCP extensions are absent in standard DOM typings.
+export interface WebMCPSubmitEvent extends SubmitEvent {
+  readonly agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+}
