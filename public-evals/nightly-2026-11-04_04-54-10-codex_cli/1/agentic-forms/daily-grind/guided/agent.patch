@@ -0,0 +1,97 @@
+const coffeeFinder = document.getElementById('coffee-finder-form');
+const finderStatus = document.getElementById('finder-status');
+const finderResults = document.getElementById('finder-results');
+
+// This catalog mirrors the seasonal favorites displayed on the homepage.
+const coffees = [
+  {
+    name: 'Maple Oat Latte',
+    temperature: 'hot',
+    flavor: 'sweet',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    menuUrl: '/menu/seasonal',
+  },
+  {
+    name: 'Dark Roast Espresso',
+    temperature: 'hot',
+    flavor: 'bold',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    menuUrl: '/menu/espresso',
+  },
+  {
+    name: 'Cold Brew',
+    temperature: 'iced',
+    flavor: 'smooth',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    menuUrl: '/menu/cold-brew',
+  },
+];
+
+function findCoffee() {
+  const data = new FormData(coffeeFinder);
+  const preferences = {
+    temperature: data.get('temperature'),
+    flavor: data.get('flavor'),
+  };
+  const validTemperature = ['any', 'hot', 'iced'].includes(preferences.temperature);
+  const validFlavor = ['any', 'sweet', 'bold', 'smooth'].includes(preferences.flavor);
+
+  if (!validTemperature || !validFlavor) {
+    finderResults.replaceChildren();
+    finderStatus.textContent = 'Choose a temperature and flavor from the available options, then try again.';
+    coffeeFinder.reportValidity();
+    return { status: 'error', message: finderStatus.textContent };
+  }
+
+  const matches = coffees.filter((coffee) =>
+    (preferences.temperature === 'any' || coffee.temperature === preferences.temperature) &&
+    (preferences.flavor === 'any' || coffee.flavor === preferences.flavor)
+  );
+
+  const cards = matches.map((coffee) => {
+    const card = document.createElement('article');
+    card.className = 'card';
+    const heading = document.createElement('h3');
+    heading.textContent = coffee.name;
+    const description = document.createElement('p');
+    description.textContent = coffee.description;
+    const link = document.createElement('a');
+    link.href = coffee.menuUrl;
+    link.textContent = `Explore ${coffee.name}`;
+    card.append(heading, description, link);
+    return card;
+  });
+
+  finderResults.replaceChildren(...cards);
+  finderStatus.textContent = matches.length
+    ? `${matches.length === 1 ? 'Your coffee match' : `${matches.length} coffees to explore`} — ${preferences.temperature === 'any' ? 'any temperature' : preferences.temperature}, ${preferences.flavor === 'any' ? 'any flavor' : preferences.flavor}.`
+    : 'No seasonal coffees match this combination. Try “Either way” or “Surprise me” to explore more options.';
+
+  return {
+    status: matches.length ? 'success' : 'no_matches',
+    message: finderStatus.textContent,
+    preferences,
+    matches,
+  };
+}
+
+coffeeFinder.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const result = findCoffee();
+  // Ordinary browsers use the same handler and simply ignore WebMCP attributes.
+  // Return only after both the result cards and status have been updated.
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(Promise.resolve(result));
+  }
+});
+
+// Honor GET submissions when the page is revisited with finder preferences.
+const finderQuery = new URLSearchParams(window.location.search);
+if (finderQuery.has('temperature') || finderQuery.has('flavor')) {
+  for (const input of coffeeFinder.querySelectorAll('input[type="radio"]')) {
+    if (finderQuery.has(input.name)) {
+      input.checked = input.value === finderQuery.get(input.name);
+    }
+  }
+  findCoffee();
+}
