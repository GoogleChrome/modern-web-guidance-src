index 0000000..f82e9e6
--- /dev/null
+++ b/coffee-finder.js
@@ -0,0 +1,79 @@
+(() => {
+  const coffees = [
+    {
+      name: 'Maple Oat Latte',
+      flavor: 'sweet',
+      temperature: 'hot',
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    },
+    {
+      name: 'Dark Roast Espresso',
+      flavor: 'bold',
+      temperature: 'hot',
+      description: 'Bold, smoky, and perfect for a morning boost.',
+    },
+    {
+      name: 'Cold Brew',
+      flavor: 'smooth',
+      temperature: 'iced',
+      description: 'Steeped for 18 hours for maximum smoothness.',
+    },
+  ];
+
+  const form = document.getElementById('coffee-finder-form');
+  const results = document.getElementById('finder-results');
+
+  function respond(event, result) {
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(result));
+    }
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) {
+      respond(event, { error: 'Choose a valid flavor and serving temperature.' });
+      return;
+    }
+
+    const data = new FormData(form);
+    const flavor = data.get('flavor');
+    const temperature = data.get('temperature');
+    // Validate enumerations as well as native constraints for agent submissions.
+    if (!['any', 'sweet', 'bold', 'smooth'].includes(flavor) ||
+        !['any', 'hot', 'iced'].includes(temperature)) {
+      const message = 'Choose a valid flavor and serving temperature, then try again.';
+      results.textContent = message;
+      respond(event, { error: message });
+      return;
+    }
+
+    const matches = coffees.filter((coffee) =>
+      (flavor === 'any' || coffee.flavor === flavor) &&
+      (temperature === 'any' || coffee.temperature === temperature));
+    const message = matches.length
+      ? `Found ${matches.length} ${matches.length === 1 ? 'coffee' : 'coffees'} for you.`
+      : 'No featured coffees match both preferences. Try another flavor or choose either temperature.';
+
+    const summary = document.createElement('p');
+    summary.textContent = message;
+    results.replaceChildren(summary);
+    if (matches.length) {
+      const list = document.createElement('ul');
+      for (const coffee of matches) {
+        const item = document.createElement('li');
+        const name = document.createElement('strong');
+        name.textContent = `${coffee.name} · ${coffee.temperature === 'hot' ? 'Hot' : 'Iced'}`;
+        const description = document.createElement('p');
+        description.textContent = coffee.description;
+        item.append(name, description);
+        list.append(item);
+      }
+      results.append(list);
+    }
+
+    respond(event, { filters: { flavor, temperature }, count: matches.length, matches, message });
+  });
+
+  form.addEventListener('reset', () => results.replaceChildren());
+})();
