+    /* CSS selects the icon; these component hooks also work without style queries.
+       Customize size, color, spacing, or alignment on any component/ancestor.
+       All current icons repeat visible text, so their generated alt is empty.
+       For future informative icons, keep their meaning in visible HTML; name
+       icon-only controls in HTML with aria-label. */
+    :where(nav a, .card h3, .btn)::before {
+      content: "";
+      content: "" / "";
+      display: inline-block;
+      inline-size: var(--icon-style-size, 1em);
+      block-size: var(--icon-style-size, 1em);
+      margin-inline-end: var(--icon-style-spacing, 0.4em);
+      vertical-align: var(--icon-style-voffset, -0.125em);
+      background-color: var(--icon-style-color, currentColor);
+      -webkit-mask: var(--icon) no-repeat center / contain;
+      mask: var(--icon) no-repeat center / contain;
+      pointer-events: none;
+      forced-color-adjust: none;
+    }
+
+    nav a[href="/menu"] { --icon: var(--icon-cup); }
+    nav a[href="/locations"] { --icon: var(--icon-pin); }
