+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="close-button" id="close-dialog-btn" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Confirm logout</a>
+    </div>
+  </dialog>
+
+  <aside class="ordering-notice" id="ordering-notice" aria-label="Online ordering information" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" class="close-button" id="dismiss-notice-btn" aria-label="Dismiss ordering information">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+
+    // Keep overlays visible until their exit animation completes.
+    function animateDismiss(element, onDismiss) {
+      if (element.classList.contains('is-closing')) return;
+      element.classList.add('is-closing');
+      function finish(event) {
+        if (event.target !== element || event.animationName !== 'overlay-exit') return;
+        element.removeEventListener('animationend', finish);
+        onDismiss();
+        element.classList.remove('is-closing');
+      }
+      element.addEventListener('animationend', finish);
+    }
+
+    function closeLogoutDialog() {
+      animateDismiss(logoutDialog, () => logoutDialog.close());
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+    logoutDialog.addEventListener('click', (event) => {
+      const bounds = logoutDialog.getBoundingClientRect();
+      if (event.target === logoutDialog &&
+          (event.clientX < bounds.left || event.clientX > bounds.right ||
+           event.clientY < bounds.top || event.clientY > bounds.bottom)) {
+        closeLogoutDialog();
+      }
+    });
+
+    orderButton.addEventListener('click', () => {
+      orderingNotice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    function dismissNotice() {
+      if (orderingNotice.hidden) return;
+      animateDismiss(orderingNotice, () => {
+        if (orderingNotice.contains(document.activeElement)) orderButton.focus();
+        orderingNotice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+      });
+    }
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open) dismissNotice();
+    });
+  </script>
