+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out of your account?</h2>
+    <p id="logout-description">Are you sure you want to log out?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <section id="ordering-notice" class="overlay" popover="manual" hidden aria-label="Ordering information">
+    <button type="button" id="dismiss-ordering-btn" class="overlay-close" aria-label="Dismiss ordering information">&times;</button>
+    <p role="status">online ordering is currently offline</p>
+  </section>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderingButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep overlays in place until their CSS exit animations finish. This also
+    // handles browsers without discrete display or top-layer exit transitions.
+    async function dismissOverlay(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      await Promise.allSettled(
+        element.getAnimations({ subtree: true }).map(animation => animation.finished)
+      );
+      finish();
+    }
+
+    function closeLogoutDialog() {
+      return dismissOverlay(logoutDialog, () => logoutDialog.close());
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      logoutDialog.removeAttribute('data-closing');
+      logoutDialog.showModal();
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+
+    function dismissOrderingNotice() {
+      return dismissOverlay(orderingNotice, () => {
+        const returnFocus = orderingNotice.contains(document.activeElement);
+        if (supportsPopover) orderingNotice.hidePopover();
+        orderingNotice.hidden = true;
+        orderingButton.setAttribute('aria-expanded', 'false');
+        if (returnFocus) orderingButton.focus();
+      });
+    }
+
+    orderingButton.addEventListener('click', () => {
+      if (orderingButton.getAttribute('aria-expanded') === 'true') {
+        dismissOrderingNotice();
+        return;
+      }
+      orderingNotice.removeAttribute('data-closing');
+      orderingNotice.hidden = false;
+      if (supportsPopover) orderingNotice.showPopover();
+      orderingButton.setAttribute('aria-expanded', 'true');
+    });
+
+    document.getElementById('dismiss-ordering-btn').addEventListener('click', dismissOrderingNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderingNotice.hidden) {
+        dismissOrderingNotice();
+      }
+    });
+  </script>
