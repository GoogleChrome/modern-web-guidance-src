+    .toast {
+      /* Toasts are prepended as body siblings, so their index is their stack slot. */
+      position: fixed;
+      inset: auto max(1rem, env(safe-area-inset-right))
+        calc(max(1rem, env(safe-area-inset-bottom)) + (sibling-index() - 1) * 5rem) auto;
+      margin: 0;
+      width: min(21rem, calc(100vw - 2rem));
+      height: 4rem;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 0.2);
+      opacity: 0;
+      transform: translateX(1rem);
+      transition: opacity 200ms ease, transform 200ms ease,
+        bottom 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open:not([data-closing]) {
+        opacity: 0;
+        transform: translateX(1rem);
+      }
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2.5rem;
+      height: 2.5rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 0.15);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      overflow: hidden;
+      clip-path: inset(50%);
