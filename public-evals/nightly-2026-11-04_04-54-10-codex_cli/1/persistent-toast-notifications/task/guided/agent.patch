+  <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" id="cart-status"></div>
+
+  <script>
+    let toastId = 0;
+    const cartStatus = document.getElementById('cart-status');
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.id = `cart-toast-${++toastId}`;
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.textContent = 'added to cart!';
+
+        const closeButton = document.createElement('button');
+        closeButton.type = 'button';
+        closeButton.className = 'toast-close';
+        closeButton.textContent = '×';
+        closeButton.setAttribute('aria-label', 'Close notification');
+        closeButton.setAttribute('popovertarget', toast.id);
+        closeButton.setAttribute('popovertargetaction', 'hide');
+        toast.append(message, closeButton);
+
+        // No layout wrapper: each toast independently enters the native top layer.
+        document.body.prepend(toast);
+        toast.showPopover();
+        cartStatus.textContent = '';
+        requestAnimationFrame(() => { cartStatus.textContent = 'added to cart!'; });
+
+        let dismissTimer;
+        async function dismissToast() {
+          if (toast.hasAttribute('data-closing')) return;
+          clearTimeout(dismissTimer);
+          toast.setAttribute('data-closing', '');
+          // Animate while still open so exits also work without overlay transitions.
+          await Promise.allSettled(toast.getAnimations().map((animation) => animation.finished));
+          if (toast.contains(document.activeElement)) trigger.focus({ preventScroll: true });
+          toast.hidePopover();
+          toast.remove();
+        }
+
+        closeButton.addEventListener('click', (event) => {
+          event.preventDefault();
+          dismissToast();
+        });
+        dismissTimer = setTimeout(dismissToast, 3000);
+      });
+    });
+  </script>
