+    /* Each toast is its own non-modal top-layer popover. Keep toasts as
+       the last body children so later siblings are always other toasts. */
+    .toast {
+      position: fixed;
+      inset: auto 1rem 1rem auto;
+      bottom: calc(1rem + (sibling-count() - sibling-index()) * 5.25rem);
+      margin: 0;
+      width: min(22rem, calc(100vw - 2rem));
+      height: 4.5rem;
+      padding: 1rem 1.25rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      opacity: 0;
+      transform: translateX(calc(100% + 2rem));
+      transition: opacity 220ms ease, transform 220ms ease,
+        bottom 220ms ease, display 220ms allow-discrete,
+        overlay 220ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      line-height: 1;
+      padding: 0.4rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(calc(100% + 2rem));
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0s;
+      }
+    }
+
