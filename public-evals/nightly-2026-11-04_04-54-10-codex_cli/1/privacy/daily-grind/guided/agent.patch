+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'">
+  <title>Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/">Back to home</a>
+  </nav>
+  <main class="container privacy-policy">
+    <h1>Your privacy at The Daily Grind</h1>
+    <p>Last updated: November 4, 2026</p>
+    <h2>Browse without tracking</h2>
+    <p>These informational pages do not collect personal information through forms, run client-side scripts, or use analytics, advertising trackers, cookies, browser storage, or device fingerprinting. You can read them without creating an account.</p>
+    <h2>Images and third parties</h2>
+    <p>We serve the coffee photo and stylesheet from this website. Opening these pages does not load resources from Unsplash, social networks, font providers, or other third-party services.</p>
+    <h2>Delivering these pages</h2>
+    <p>Your browser sends network information, including your IP address and requested page, to our hosting provider to deliver the site. The website code does not store that information. Hosting access logs and their retention are controlled by the hosting operator; this page cannot promise that no server logs exist.</p>
+    <h2>Accounts, orders, and contact</h2>
+    <p>This static website does not implement account registration, checkout, or authentication. The menu, rewards, account, order, and logout links are navigation placeholders. No account or order records are stored by these pages.</p>
+    <p>For privacy questions, use our <a href="/contact">contact page</a> when available. Please do not include passwords, payment details, or other sensitive information in a message or a page URL.</p>
+    <h2>If our services change</h2>
+    <p>Before introducing data collection or third-party services, we will update this notice to explain the purpose, necessary fields, recipients, retention, and available access, correction, and deletion options. Optional tracking must remain off until you choose it.</p>
+  </main>
+  <footer><a href="/">Return to The Daily Grind</a></footer>
+</body>
+</html>
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..1112fdf
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { mkdir, readFile, readdir, copyFile, rm, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('../', import.meta.url);
+const headers = JSON.parse(await readFile(new URL('security-headers.json', root), 'utf8'));
+const pages = ['index.html', 'privacy-policy.html'];
+const assets = (await readdir(new URL('assets/', root))).map(name => `assets/${name}`);
+const files = [...pages, ...assets];
+const metaPolicy = headers['Content-Security-Policy'].replace("; frame-ancestors 'none'", '');
+
+// A deliberately script-free site: changes to this boundary require a privacy review.
+for (const file of files) {
+  assert(/\.(html|css|jpg)$/.test(file), `Unreviewed public asset: ${file}`);
+  if (!/\.(html|css)$/.test(file)) continue;
+  const source = await readFile(new URL(file, root), 'utf8');
+  assert(!/<\s*(script|iframe|object|embed|form|input|textarea|select|base)\b/i.test(source), `${file}: active content or data collection requires review`);
+  assert(!/\bon[\w]+\s*=|\bstyle\s*=|javascript:|@import\b/i.test(source), `${file}: inline execution, styles, or CSS imports require review`);
+  assert(!/https?:|\/\/|data:|blob:|@font-face/i.test(source), `${file}: remote or embedded resources require review`);
+  assert(!/\b(?:srcset|ping|srcdoc)\s*=/i.test(source), `${file}: additional resource channels require review`);
+  for (const match of source.matchAll(/(?:\b(?:src|href|action)\s*=\s*["']([^"']+)["']|url\(\s*["']?([^\s"')]+))/gi)) {
+    const target = match[1] ?? match[2];
+    assert(target.startsWith('/') && !target.startsWith('//') && !/[\\&]/.test(target), `${file}: unexpected resource or navigation URL`);
+    if (target.startsWith('/assets/') || target.endsWith('.html')) {
+      assert(files.includes(target.slice(1)), `${file}: missing local resource ${target}`);
+    }
+  }
+  if (file.endsWith('.html')) {
+    assert(source.includes(`<meta name="referrer" content="no-referrer">`), `${file}: missing referrer fallback`);
+    assert(source.includes(`<meta http-equiv="Content-Security-Policy" content="${metaPolicy}">`), `${file}: CSP fallback differs from response policy`);
+  }
+}
+
+for (const [name, value] of Object.entries(headers)) {
+  assert(!/[\r\n]/.test(name + value), 'Invalid header configuration');
+}
+
+const output = new URL('dist/', root);
+await rm(output, { recursive: true, force: true });
+await mkdir(new URL('assets/', output), { recursive: true });
+for (const file of files) {
+  await copyFile(new URL(file, root), new URL(file, output));
+}
+await writeFile(new URL('_headers', output), `/*\n${Object.entries(headers).map(([name, value]) => `  ${name}: ${value}`).join('\n')}\n`);
+console.log(`Privacy audit passed. Built ${files.length} static files and HTTP header rules in ${fileURLToPath(output)}`);
