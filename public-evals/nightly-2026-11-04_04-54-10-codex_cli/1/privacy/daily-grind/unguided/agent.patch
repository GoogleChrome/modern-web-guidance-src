new file mode 100644
index 0000000..27d8ed0
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,11 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import { audit, publishedPaths } from './privacy-audit.mjs';
+
+await audit();
+const output = new URL('../dist/', import.meta.url);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+for (const relative of publishedPaths) {
+  await cp(new URL(`../${relative}`, import.meta.url), new URL(relative, output), { recursive: true });
+}
+console.log('Built static site in dist/ with deployment headers.');
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..028d857
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+export const publishedPaths = ['index.html', 'privacy-policy', 'assets', '_headers'];
+
+// Deliberately conservative checks for this small, script-free static site.
+// Changes that need exceptions require a documented privacy review first.
+export function auditMarkup(source, filename) {
+  assert(!/<\s*(script|iframe|frame|object|embed|form|input|textarea|select|video|audio|source)\b/i.test(source), `${filename}: active content or collection requires review`);
+  assert(!/\bon[a-z]+\s*=|\bstyle\s*=|<\s*style\b/i.test(source), `${filename}: inline code or styles are forbidden`);
+  assert(!/\b(ping|srcdoc|srcset|background|action|formaction|manifest)\s*=/i.test(source), `${filename}: unreviewed request attribute`);
+  for (const match of source.matchAll(/\b(?:src|href)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))/gi)) {
+    const value = match[1] ?? match[2] ?? match[3];
+    assert(/^\/(?!\/)[a-z0-9/._-]*$/i.test(value) || /^#[a-z0-9_-]+$/i.test(value), `${filename}: only local paths without identifiers or query strings are allowed: ${value}`);
+  }
+  assert(!/\brel\s*=\s*["'][^"']*(?:preconnect|dns-prefetch|prefetch|prerender)/i.test(source), `${filename}: speculative connections are forbidden`);
+  assert(!/<meta\b[^>]*http-equiv\s*=\s*["']?refresh/i.test(source), `${filename}: automatic redirects require review`);
+  assert(source.includes('<meta name="referrer" content="no-referrer">'), `${filename}: missing referrer policy`);
+  const csp = source.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/)?.[1];
+  assert(csp, `${filename}: missing fallback CSP`);
+  for (const directive of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "form-action 'none'", "base-uri 'none'", "style-src 'self'", "img-src 'self'"]) {
+    assert(csp.split(';').map(s => s.trim()).includes(directive), `${filename}: missing ${directive}`);
+  }
+}
+
+export function auditStyles(source, filename) {
+  assert(!/@import|\\|https?:|\/\//i.test(source), `${filename}: external or escaped CSS requires review`);
+  for (const match of source.matchAll(/url\(\s*['"]?([^\s'"\)]+)/gi)) {
+    assert(/^\/assets\/[a-z0-9/._-]+$/i.test(match[1]), `${filename}: only local assets are allowed`);
+  }
+}
+
+async function inspect(relative) {
+  const absolute = path.join(root, relative);
+  if (!path.extname(relative)) {
+    for (const name of await readdir(absolute)) await inspect(path.join(relative, name));
+    return;
+  }
+  if (relative.endsWith('.html')) auditMarkup(await readFile(absolute, 'utf8'), relative);
+  else if (relative.endsWith('.css')) auditStyles(await readFile(absolute, 'utf8'), relative);
+  else assert(/\.(jpg|png|webp|ico)$/.test(relative), `${relative}: unreviewed public file type`);
+}
+
+export async function audit() {
+  const pkg = JSON.parse(await readFile(path.join(root, 'package.json'), 'utf8'));
+  assert(!Object.keys({ ...pkg.dependencies, ...pkg.devDependencies }).length, 'New dependencies require a third-party privacy review');
+  for (const relative of publishedPaths.filter(p => p !== '_headers')) await inspect(relative);
+  const headers = await readFile(path.join(root, '_headers'), 'utf8');
+  assert(headers.startsWith('/*\n'), 'Headers must cover every route');
+  for (const header of [
+    "frame-ancestors 'none'", "connect-src 'none'", "script-src 'none'", "form-action 'none'",
+    'Referrer-Policy: no-referrer', 'X-Content-Type-Options: nosniff', 'X-Frame-Options: DENY',
+    'Strict-Transport-Security: max-age=31536000', 'Cache-Control: no-store',
+    'Cross-Origin-Opener-Policy: same-origin', 'Cross-Origin-Resource-Policy: same-origin',
+    'camera=()', 'microphone=()', 'geolocation=()', 'payment=()', 'browsing-topics=()',
+  ]) assert(headers.includes(header), `Missing security header policy: ${header}`);
+  console.log('Privacy audit passed: local resources, no client scripts or collection, no dependencies, restrictive headers.');
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await audit();
