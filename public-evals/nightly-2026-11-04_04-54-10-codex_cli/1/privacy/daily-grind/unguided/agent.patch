+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { auditMarkup, auditStyles } from './privacy-audit.mjs';
+
+const page = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+test('current page and local stylesheet pass', async () => {
+  auditMarkup(page, 'index.html');
+  auditStyles(await readFile(new URL('../assets/styles.css', import.meta.url), 'utf8'), 'styles.css');
+});
+test('tracking, data collection, and active content are rejected', () => {
+  for (const fragment of [
+    '<script src="/tracker.js"></script>', '<img src="https://tracker.example/pixel">',
+    '<img src="//tracker.example/pixel">', '<img src="/pixel?email=person">',
+    '<a href="/" ping="https://tracker.example">Home</a>', '<form action="/subscribe"></form>',
+    '<iframe src="/embed"></iframe>', '<img src="/assets/coffee.jpg" onload="collect()">',
+    '<img src="/assets/coffee.jpg" srcset="https://tracker.example/a 2x">',
+    '<meta http-equiv="refresh" content="0;url=https://tracker.example">',
+  ]) assert.throws(() => auditMarkup(page.replace('</body>', `${fragment}</body>`), 'fixture.html'));
+});
+test('third-party CSS requests are rejected', () => {
+  for (const css of ['@import "/extra.css";', 'a { background: url(https://tracker.example/pixel) }', 'a { background: url(//tracker.example/pixel) }', 'a { background: url(data:image/png;base64,abc) }']) {
+    assert.throws(() => auditStyles(css, 'fixture.css'));
+  }
+});
+test('weakened markup policy is rejected', () => {
+  assert.throws(() => auditMarkup(page.replace("connect-src 'none'", "connect-src *"), 'fixture.html'));
+  assert.throws(() => auditMarkup(page.replace('content="no-referrer"', 'content="unsafe-url"'), 'fixture.html'));
+});
