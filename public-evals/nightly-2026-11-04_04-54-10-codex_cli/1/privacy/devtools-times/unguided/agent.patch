+export default function AccountPrivacyNotice() {
+  return (
+    <div id="account-privacy" className="text-sm text-gray-600 space-y-2">
+      <p>
+        This is a demo. Use a made-up username and a password you do not use elsewhere.
+        No email address or real name is needed.
+      </p>
+      <p>
+        When you submit, your username and password are sent over HTTPS to our
+        authentication service at us-central1-web-devrel-apps.cloudfunctions.net
+        to process your request. This page does not save your credentials in browser storage.
+      </p>
+      <p>
+        Read our <a className="underline" href={`${import.meta.env.BASE_URL}legal/privacy#accounts`}>privacy notice</a>
+        {' '}for details, including what we cannot verify about service retention.
+      </p>
+    </div>
+  );
+}
