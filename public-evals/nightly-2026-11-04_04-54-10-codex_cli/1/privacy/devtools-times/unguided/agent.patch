diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..240c8f0 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -1,13 +1,13 @@
 
 import { defineMiddleware } from 'astro:middleware';
 
-export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
-    }
-  }
-  return next();
+export const onRequest = defineMiddleware(async (_context, next) => {
+  // Sessions are written only when a visitor changes their reading list.
+  const response = await next();
+  response.headers.set('Referrer-Policy', 'no-referrer');
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), browsing-topics=()');
+  // Pages can include session-specific reading-list state; never share cached responses.
+  response.headers.set('Cache-Control', 'no-store');
+  return response;
 });
