+  <script>
+    // Keep CSS geometry in sync with the actual items, including later DOM edits.
+    function updateCollections() {
+      document.querySelectorAll('.card').forEach(card => card.classList.add('spectrum-card'));
+      const spectrumGroups = new Set(
+        [...document.querySelectorAll('.spectrum-card')].map(card => card.parentElement)
+      );
+      const collections = [
+        ...[...spectrumGroups].map(parent => [parent, '.spectrum-card']),
+        ...[...document.querySelectorAll('.fan-container')].map(parent => [parent, '.fan-card']),
+        ...[...document.querySelectorAll('.circle-container')].map(parent => [parent, '.circle-orb'])
+      ];
+      for (const [parent, selector] of collections) {
+        const items = [...parent.children].filter(item => item.matches(selector));
+        parent.style.setProperty('--count', items.length);
+        items.forEach((item, index) => {
+          item.style.setProperty('--index', index);
+          item.style.setProperty('--count', items.length);
+        });
+      }
+    }
+
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.body, {
+      childList: true,
+      subtree: true
+    });
+  </script>
 </body>
 
