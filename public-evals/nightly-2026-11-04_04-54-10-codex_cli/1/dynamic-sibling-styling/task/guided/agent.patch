+  <script>
+    // Older browsers get the same live counts without replacing native CSS.
+    if (!CSS.supports('top: calc(sibling-index() * sibling-count() * 1px)')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const update = () => {
+        const groups = new Set([...document.querySelectorAll(selector)].map(item => item.parentElement));
+        groups.forEach(group => {
+          const children = [...group.children];
+          children.forEach((item, index) => {
+            if (item.matches(selector)) {
+              item.style.setProperty('--sibling-index', index + 1);
+              item.style.setProperty('--sibling-count', children.length);
+            }
+          });
+        });
+      };
+      update();
+      new MutationObserver(update).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true
+      });
+    }
+  </script>
