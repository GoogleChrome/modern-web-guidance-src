+        } while (ctx.measureText(cupName).width > 172 && fontSize > 10);
+        ctx.fillStyle = '#4e342e';
+        ctx.fillText(cupName, 0, 57);
+        ctx.font = '11px "Segoe UI", sans-serif';
+        ctx.fillStyle = '#80624c';
+        ctx.fillText('BREWED JUST FOR YOU', 0, 84);
+        ctx.restore();
+      }
