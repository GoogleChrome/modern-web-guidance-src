+      }
+
+      function drawCup() {
+        const { width, height, stacked } = layout;
+        // All drawing positions are CSS pixels; the backing store handles DPI.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
