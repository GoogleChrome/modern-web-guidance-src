+        ctx.moveTo(-124, -60);
+        ctx.lineTo(-102, 105);
+        ctx.quadraticCurveTo(0, 158, 102, 105);
+        ctx.lineTo(124, -60);
+        ctx.closePath();
+        ctx.fill();
+        ctx.fillStyle = '#fffcf6';
+        ctx.beginPath();
+        ctx.ellipse(0, -60, 124, 39, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = { whole: '#bf936c', oat: '#bb8b5f', almond: '#b58255', soy: '#c19a73', none: '#493024' }[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(0, -60, 112, 29, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = { maple: '#80502d', vanilla: '#eccea1', caramel: '#a5682e', hazelnut: '#724a30' }[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(0, -60, 63, 14, -0.08, 0, Math.PI * 1.8);
+          ctx.stroke();
+          ctx.beginPath();
+          ctx.ellipse(0, -60, 36, 7, -0.08, 0, Math.PI * 1.8);
+          ctx.stroke();
+        }
+        ctx.strokeStyle = '#c6b49d';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        for (const x of [-32, 0, 32]) {
