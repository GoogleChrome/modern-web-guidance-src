+        ctx.scale(scale, scale);
+
+        ctx.fillStyle = '#e3d6c5';
+        ctx.beginPath();
+        ctx.ellipse(5, 146, 145, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+        // Ceramic handle, body, and coffee surface.
+        ctx.lineWidth = 19;
+        ctx.strokeStyle = '#d5c4ae';
+        ctx.beginPath();
+        ctx.ellipse(112, 12, 47, 53, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        ctx.strokeStyle = '#fffbf2';
+        ctx.lineWidth = 12;
+        ctx.stroke();
+        const ceramic = ctx.createLinearGradient(-125, 0, 120, 0);
+        ceramic.addColorStop(0, '#e3d3be');
+        ceramic.addColorStop(0.4, '#fffbf2');
+        ceramic.addColorStop(1, '#e8d9c5');
+        ctx.fillStyle = ceramic;
