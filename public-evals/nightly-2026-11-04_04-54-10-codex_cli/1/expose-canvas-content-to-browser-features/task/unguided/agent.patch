+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const studio = document.getElementById('coffee-studio');
+      const ctx = canvas.getContext('2d');
+      const controls = document.getElementById('coffee-controls');
+      const lettering = document.getElementById('cup-lettering');
+      const caption = document.getElementById('coffee-caption');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const layers = [lettering, caption, controls];
+      const positions = new Map();
+      let nativeHTML = Boolean(ctx && 'drawElementImage' in ctx &&
+        'requestPaint' in canvas && ('content' in canvas || 'layoutSubtree' in canvas));
+      let width = 0;
+      let height = 0;
+      let cupX = 0;
+      let cupY = 0;
+      let cupScale = 1;
+      let pendingFrame = 0;
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.removeAttribute('content');
+        canvas.removeAttribute('layoutsubtree');
+        layers.forEach(element => studio.appendChild(element));
+        // Keep the actual controls exposed to assistive technology in the fallback.
+        canvas.setAttribute('aria-hidden', 'true');
+      }
+
+      if (!nativeHTML) useOverlay();
+
+      function place(element, x, y, layerWidth) {
+        element.style.width = `${layerWidth}px`;
+        positions.set(element, { x, y });
+        // Native drawElementImage supplies hit-test geometry; the fallback uses
+        // exactly the same CSS-pixel coordinates for the real DOM controls.
+        element.style.left = nativeHTML ? '0px' : `${x}px`;
+        element.style.top = nativeHTML ? '0px' : `${y}px`;
+      }
+
+      function layout() {
+        width = studio.clientWidth;
+        if (!width) return;
+        const stacked = width < 650;
+        const formWidth = stacked ? width - 40 : Math.min(420, width * 0.45);
+        const formX = stacked ? 20 : width - formWidth - 32;
+        const formY = stacked ? 370 : 28;
+        place(controls, formX, formY, formWidth);
+        height = Math.ceil(Math.max(stacked ? 0 : 460, formY + controls.offsetHeight + 28));
+        studio.style.height = `${height}px`;
+        cupX = stacked ? width / 2 : formX / 2;
+        cupY = stacked ? 0 : (height - 460) / 2 + 24;
+        cupScale = Math.min(1, (stacked ? width : formX) / 350);
+        lettering.style.setProperty('--cup-scale', cupScale);
+        lettering.style.setProperty('--name-size', `${(name.value.trim().length > 10 ? 17 : 25) * cupScale}px`);
+        place(lettering, cupX - 68 * cupScale, cupY + 218 * cupScale, 136 * cupScale);
+        place(caption, stacked ? 16 : 20, cupY + 337 * cupScale, stacked ? width - 32 : formX - 40);
+
+        // Drawing coordinates remain in CSS pixels, independently of backing
+        // resolution, so controls and artwork stay aligned at every pixel ratio.
+        const dpr = window.devicePixelRatio || 1;
+        const pixelWidth = Math.max(1, Math.round(width * dpr));
+        const pixelHeight = Math.max(1, Math.round(height * dpr));
+        if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
+        if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
+        requestDraw();
+      }
+
+      function ellipse(x, y, rx, ry, fill) {
+        ctx.beginPath();
+        ctx.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2);
+        ctx.fillStyle = fill;
+        ctx.fill();
+      }
+
+      function draw() {
+        if (!ctx || !width) return;
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+        ctx.save();
+        ctx.translate(cupX, cupY);
+        ctx.scale(cupScale, cupScale);
+
+        ellipse(0, 205, 143, 143, '#ece1d1');
+        ellipse(0, 317, 106, 13, '#4e342e15');
+
+        // A few quiet steam curls above the open cup.
+        ctx.strokeStyle = '#b8a18a';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        [-30, 0, 30].forEach((x, i) => {
+          ctx.beginPath();
+          ctx.moveTo(x, 89);
+          ctx.bezierCurveTo(x - 14, 76, x + 14, 64, x, 50 - i * 4);
+          ctx.stroke();
+        });
+
+        const paper = ctx.createLinearGradient(-90, 0, 90, 0);
+        paper.addColorStop(0, '#e5d6bf');
+        paper.addColorStop(0.35, '#fffaf0');
+        paper.addColorStop(1, '#ecdfcb');
+        ctx.beginPath();
+        ctx.moveTo(-88, 140);
+        ctx.lineTo(88, 140);
+        ctx.lineTo(65, 304);
+        ctx.quadraticCurveTo(0, 326, -65, 304);
+        ctx.closePath();
+        ctx.fillStyle = paper;
+        ctx.fill();
+
+        // The drink surface changes with the selected milk.
+        ellipse(0, 140, 89, 23, '#fffaf0');
+        const milkColors = { whole: '#c69a6d', oat: '#bb8c5f', almond: '#b07b50', none: '#482b20' };
+        ellipse(0, 140, 80, 17, milkColors[milk.value]);
+        if (milk.value !== 'none') {
+          ellipse(-16, 136, 37, 8, '#f4e5cc');
+          ellipse(13, 141, 25, 6, '#efdbb9');
+        }
+        const syrupColors = { maple: '#a9692e', vanilla: '#f3d9a4', caramel: '#c58235', hazelnut: '#855132' };
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = syrupColors[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.moveTo(-37, 137);
+          ctx.bezierCurveTo(-8, 124, 36, 137, 11, 144);
+          ctx.bezierCurveTo(-9, 150, -25, 139, 6, 135);
+          ctx.stroke();
+        }
+
+        ctx.beginPath();
+        ctx.moveTo(-81, 199);
+        ctx.quadraticCurveTo(0, 212, 81, 199);
+        ctx.lineTo(71, 271);
+        ctx.quadraticCurveTo(0, 288, -71, 271);
+        ctx.closePath();
+        ctx.fillStyle = '#77513b';
+        ctx.fill();
+        ctx.restore();
+
+        if (nativeHTML) {
+          try {
+            layers.forEach(element => {
+              const { x, y } = positions.get(element);
+              // This also maps clicks, selection, and focus to the drawn bounds.
+              ctx.drawElementImage(element, x, y);
+            });
+          } catch (error) {
+            // Partial implementations still get fully usable, aligned controls.
+            useOverlay();
+            layout();
+          }
+        }
+      }
+
+      function requestDraw() {
+        if (nativeHTML) {
+          canvas.requestPaint();
+        } else if (!pendingFrame) {
+          pendingFrame = requestAnimationFrame(() => {
+            pendingFrame = 0;
+            draw();
+          });
+        }
+      }
+
+      function updateOrder() {
+        const cupName = name.value.trim() || 'Your cup';
+        document.getElementById('cup-display-name').textContent = cupName;
+        const milkLabel = milk.selectedOptions[0].text;
+        const syrupLabel = syrup.value === 'none' ? 'No syrup' : `${syrup.selectedOptions[0].text} syrup`;
+        document.getElementById('coffee-summary').textContent = `${cupName} · ${milkLabel} · ${syrupLabel}`;
+        layout();
+      }
+
+      canvas.addEventListener('paint', draw);
+      controls.addEventListener('input', updateOrder);
+      controls.addEventListener('change', updateOrder);
+      controls.addEventListener('submit', event => event.preventDefault());
+      const observer = new ResizeObserver(layout);
+      observer.observe(studio);
+      observer.observe(controls);
+      window.addEventListener('resize', layout);
+
+      // Zoom or moving between monitors can change DPR without a CSS resize.
+      function watchPixelRatio() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          layout();
+          watchPixelRatio();
+        }, { once: true });
+      }
+      watchPixelRatio();
+      layout();
+      updateOrder();
+      document.fonts.ready.then(layout);
+    })();
+  </script>
+
