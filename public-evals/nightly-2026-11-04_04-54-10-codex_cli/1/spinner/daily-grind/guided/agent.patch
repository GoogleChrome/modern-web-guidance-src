+  <script>
+    const loadingLinks = document.querySelectorAll('a[data-loading]');
+
+    function resetLoadingStates() {
+      for (const link of loadingLinks) {
+        link.setAttribute('aria-busy', 'false');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('progress').hidden = true;
+        link.querySelector('.btn-label').textContent = link.dataset.idleLabel;
+      }
+    }
+
+    for (const link of loadingLinks) {
+      const label = link.querySelector('.btn-label');
+      link.dataset.idleLabel = label.textContent;
+
+      link.addEventListener('click', (event) => {
+        // Leave new tabs, downloads, and canceled navigation untouched.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey ||
+            (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('progress').hidden = false;
+        label.textContent = link.dataset.loading;
+        // The link's native navigation remains responsible for loading the page.
+      });
+    }
+
+    // Restore controls when returning from the browser's back/forward cache.
+    window.addEventListener('pageshow', resetLoadingStates);
+  </script>
