+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-message]');
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+
+    function resetLoading() {
+      loadingLinks.forEach((link) => {
+        link.classList.remove('is-loading');
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        const label = link.querySelector('.btn-label');
+        if (link.dataset.originalLabel) {
+          label.textContent = link.dataset.originalLabel;
+        }
+      });
+      seasonalFavorites.removeAttribute('aria-busy');
+      loadingStatus.textContent = '';
+    }
+
+    loadingLinks.forEach((link) => {
+      const label = link.querySelector('.btn-label');
+      link.dataset.originalLabel = label.textContent;
+
+      link.addEventListener('click', (event) => {
+        // Leave new-tab, download, and modified-click navigation to the browser.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') ||
+            (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.classList.add('is-loading');
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        label.textContent = link.closest('#seasonal-favorites') ? 'Loading details…' : 'Starting order…';
+        if (seasonalFavorites.contains(link)) {
+          seasonalFavorites.setAttribute('aria-busy', 'true');
+        }
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+    });
+
+    // A page restored from the back/forward cache must be usable again.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
+
