+  <dialog id="drink-dialog" aria-labelledby="drink-title" aria-describedby="drink-description" closedby="any">
+    <div class="dialog-header">
+      <h2 id="drink-title" tabindex="-1">Choose your coffee</h2>
+      <button type="button" class="dialog-close">Close</button>
+    </div>
+    <p id="drink-description"></p>
+    <form id="order-form" class="order-options">
+      <label for="drink-choice">Drink
+        <select id="drink-choice" name="drink">
+          <option value="maple">Maple Oat Latte</option>
+          <option value="espresso">Dark Roast Espresso</option>
+          <option value="cold-brew">Cold Brew</option>
+        </select>
+      </label>
+      <label for="drink-size">Size
+        <select id="drink-size" name="size"></select>
+      </label>
+      <label for="drink-temperature">Preparation
+        <select id="drink-temperature" name="temperature"></select>
+      </label>
+      <label for="drink-quantity">Quantity
+        <input id="drink-quantity" name="quantity" type="number" min="1" max="10" value="1" required>
+      </label>
+      <p>Review your choices here. Online checkout is not available on this page.</p>
+      <button type="submit" class="btn">Review order</button>
+    </form>
+    <p id="order-summary" role="status" aria-live="polite" aria-atomic="true"></p>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Hot', 'Iced']
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey dark roast espresso, perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot'],
+        preparations: ['Hot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness, served over ice.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Iced']
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const title = document.getElementById('drink-title');
+    const description = document.getElementById('drink-description');
+    const form = document.getElementById('order-form');
+    const drinkChoice = document.getElementById('drink-choice');
+    const size = document.getElementById('drink-size');
+    const temperature = document.getElementById('drink-temperature');
+    const quantity = document.getElementById('drink-quantity');
+    const summary = document.getElementById('order-summary');
+    let opener;
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      title.textContent = drink.name;
+      description.textContent = drink.description;
+      size.replaceChildren(...drink.sizes.map(value => new Option(value, value)));
+      temperature.replaceChildren(...drink.preparations.map(value => new Option(value, value)));
+      summary.textContent = '';
+    }
+
+    document.querySelectorAll('[data-order]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        form.reset();
+        drinkChoice.value = button.dataset.order || 'maple';
+        updateDrink();
+        // showModal makes the rest of the page inert and contains keyboard focus.
+        dialog.showModal();
+        (button.dataset.order ? title : drinkChoice).focus();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    form.addEventListener('input', () => { summary.textContent = ''; });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      summary.textContent = `${quantity.value} × ${drinks[drinkChoice.value].name}, ${size.value}, ${temperature.value.toLowerCase()}. Your choices are ready to review; no order has been placed.`;
+    });
+
+    dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      summary.textContent = '';
+      if (opener?.isConnected) opener.focus();
+    });
+
+    // Escape and platform close requests use the dialog's native cancel behavior.
+    // Also support backdrop dismissal where closedby="any" is unavailable.
+    function isBackdrop(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.target === dialog &&
+        (event.clientX < bounds.left || event.clientX > bounds.right ||
+         event.clientY < bounds.top || event.clientY > bounds.bottom);
+    }
+
+    let backdropPointer = null;
+    dialog.addEventListener('pointerdown', event => {
+      backdropPointer = event.isPrimary && event.button === 0 && isBackdrop(event)
+        ? event.pointerId : null;
+    });
+    dialog.addEventListener('pointerup', event => {
+      if (backdropPointer === event.pointerId && isBackdrop(event)) dialog.close();
+      backdropPointer = null;
+    });
+    dialog.addEventListener('pointercancel', () => { backdropPointer = null; });
+  </script>
+
 </body>
 
 </html>
