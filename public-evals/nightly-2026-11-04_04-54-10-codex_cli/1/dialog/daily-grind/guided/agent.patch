+  <script>
+    const drinkDialog = document.getElementById('drink-dialog');
+    const drinkChoice = document.getElementById('drink-choice');
+    const drinkSize = document.getElementById('drink-size');
+    const drinkTemperature = document.getElementById('drink-temperature');
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large'],
+        temperatures: ['Hot', 'Iced']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'A bold, smokey dark roast espresso, served hot for a morning boost.',
+        sizes: ['Single', 'Double'],
+        temperatures: ['Hot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness, served over ice.',
+        sizes: ['Small', 'Medium', 'Large'],
+        temperatures: ['Iced']
+      }
+    };
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      drinkSize.replaceChildren(...drink.sizes.map(size => new Option(size, size.toLowerCase())));
+      drinkTemperature.replaceChildren(...drink.temperatures.map(temperature => new Option(temperature, temperature.toLowerCase())));
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        document.getElementById('drink-order').reset();
+        drinkChoice.value = button.dataset.drink;
+        updateDrink();
+        // Some platforms do not focus buttons on pointer activation. Establish
+        // the invoker so native dialog focus restoration returns to this button.
+        button.focus();
+        drinkDialog.showModal();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+
+    // Native modal behavior handles focus containment and platform close requests.
+    // Add light dismissal only where closedby is not supported.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = event => {
+        const rect = drinkDialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let outsidePointer = null;
+      drinkDialog.addEventListener('pointerdown', event => {
+        outsidePointer = event.isPrimary && event.button === 0 && outside(event) ? event.pointerId : null;
+      });
+      drinkDialog.addEventListener('pointerup', event => {
+        if (event.pointerId === outsidePointer && outside(event)) drinkDialog.close();
+        outsidePointer = null;
+      });
+      drinkDialog.addEventListener('pointercancel', () => { outsidePointer = null; });
+      drinkDialog.addEventListener('close', () => { outsidePointer = null; });
+    }
+  </script>
+
