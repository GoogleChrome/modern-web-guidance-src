+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const animations = new WeakMap();
+    let promoCount = 0;
+    let featuredHidden = false;
+
+    function animateCard(card, visible, onFinish = () => {}) {
+      // Capture the current frame so rapid clicks reverse smoothly.
+      const style = getComputedStyle(card);
+      const from = { opacity: style.opacity, transform: style.transform };
+      animations.get(card)?.cancel();
+      const animation = card.animate([
+        from,
+        { opacity: visible ? 1 : 0, transform: visible ? 'scale(1)' : 'scale(0.9)' }
+      ], {
+        duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280,
+        easing: 'ease-in-out',
+        fill: 'forwards'
+      });
+      animations.set(card, animation);
+      animation.onfinish = () => {
+        onFinish();
+        animation.cancel();
+        animations.delete(card);
+      };
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const title = document.createElement('h3');
+      title.textContent = `Coffee Break Special ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover your next favorite cup from our locally roasted selection.';
+      card.append(title, description);
+      card.style.opacity = '0';
+      card.style.transform = 'scale(0.9)';
+      domContainer.append(card);
+      animateCard(card, true, () => {
+        card.style.removeProperty('opacity');
+        card.style.removeProperty('transform');
+      });
+      removeBtn.disabled = false;
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const card = domContainer.lastElementChild;
+      if (!card || card.dataset.removing) return;
+      card.dataset.removing = 'true';
+      if (card === toggleCard) toggleBtn.disabled = true;
+      animateCard(card, false, () => {
+        card.remove();
+        removeBtn.disabled = !domContainer.childElementCount;
+      });
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (!toggleCard.isConnected || toggleCard.dataset.removing) return;
+      featuredHidden = !featuredHidden;
+      toggleBtn.setAttribute('aria-expanded', String(!featuredHidden));
+      if (!featuredHidden && toggleCard.hidden) {
+        toggleCard.hidden = false;
+        toggleCard.style.opacity = '0';
+        toggleCard.style.transform = 'scale(0.9)';
+      }
+      animateCard(toggleCard, !featuredHidden, () => {
+        toggleCard.hidden = featuredHidden;
+        toggleCard.style.removeProperty('opacity');
+        toggleCard.style.removeProperty('transform');
+      });
+    });
+  </script>
+
