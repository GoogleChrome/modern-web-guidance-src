+  <script>
+    const previews = [...document.querySelectorAll('.drink-preview')];
+    const dismissPreviews = new Map();
+
+    previews.forEach((preview) => {
+      const trigger = preview.querySelector('.preview-trigger');
+      const panel = preview.querySelector('.hovercard');
+      let closeTimer;
+      let dismissed = false;
+
+      const close = () => {
+        clearTimeout(closeTimer);
+        panel.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+      };
+      dismissPreviews.set(preview, close);
+
+      const open = () => {
+        clearTimeout(closeTimer);
+        if (dismissed) return;
+        // Keep a keyboard user's active preview available until focus leaves it.
+        previews.forEach((other) => {
+          if (other !== preview && !other.contains(document.activeElement)) {
+            dismissPreviews.get(other)();
+          }
+        });
+        panel.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        panel.style.marginLeft = '0px';
+        const bounds = panel.getBoundingClientRect();
+        const shift = Math.max(16 - bounds.left, Math.min(0, innerWidth - 16 - bounds.right));
+        panel.style.marginLeft = `${shift}px`;
+      };
+
+      const scheduleClose = () => {
+        clearTimeout(closeTimer);
+        closeTimer = setTimeout(() => {
+          if (!preview.contains(document.activeElement) && !preview.matches(':hover')) close();
+        }, 180);
+      };
+
+      preview.addEventListener('pointerenter', (event) => {
+        if (event.pointerType === 'touch') return;
+        dismissed = false;
+        open();
+      });
+      preview.addEventListener('pointerleave', scheduleClose);
+      preview.addEventListener('focusin', () => {
+        if (!dismissed) open();
+      });
+      preview.addEventListener('focusout', () => {
+        // A new focus visit should be able to open a previously dismissed card.
+        queueMicrotask(() => {
+          if (!preview.contains(document.activeElement)) dismissed = false;
+          scheduleClose();
+        });
+      });
+
+      const dismiss = () => {
+        dismissed = true;
+        if (panel.contains(document.activeElement)) trigger.focus();
+        close();
+      };
+      preview.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !panel.hidden) {
+          event.preventDefault();
+          event.stopPropagation();
+          dismiss();
+        }
+      });
+      panel.querySelector('.preview-close').addEventListener('click', dismiss);
+      window.addEventListener('resize', () => {
+        if (!panel.hidden) open();
+      });
+    });
+  </script>
+
