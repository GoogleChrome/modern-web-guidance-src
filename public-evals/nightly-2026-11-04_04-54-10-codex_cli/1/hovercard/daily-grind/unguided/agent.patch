+      left: 50%;
+      transform: translateX(-50%);
+      width: min(320px, calc(100vw - 32px));
+      padding: 22px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      box-shadow: 0 12px 36px rgba(62, 39, 35, 0.2);
+      text-align: left;
+      z-index: 10;
+    }
+
+    .hovercard[hidden] {
+      display: none;
+    }
+
+    .hovercard::after {
