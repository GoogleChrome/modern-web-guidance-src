@@ -120,6 +120,141 @@
       color: var(--primary);
     }
 
+    /* Native inputs cover each label; the artwork only reflects their state. */
+    .customizations {
+      min-width: 0;
+      margin-top: 22px;
+      padding: 16px 0 0;
+      border: 0;
+      border-top: 1px solid var(--secondary);
+      text-align: left;
+    }
+
+    .customizations legend {
+      padding-right: 10px;
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+    }
+
+    .customization {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      min-height: 48px;
+      margin-top: 8px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      isolation: isolate;
+    }
+
+    .customization input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 2;
+    }
+
+    .option-background {
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      border: 1px solid var(--secondary);
+      border-radius: inherit;
+      background: #faf7f5;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .check-icon {
+      flex: 0 0 24px;
+      width: 24px;
+      height: 24px;
+      padding: 3px;
+      border: 2px solid #8d6e63;
+      border-radius: 7px;
+      color: var(--primary);
+      background: white;
+      transition: background-color 180ms ease, border-color 180ms ease,
+        transform 180ms ease;
+    }
+
+    .check-icon path {
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 24;
+      stroke-dashoffset: 24;
+      opacity: 0;
+      transition: stroke-dashoffset 200ms ease, opacity 150ms ease;
+    }
+
+    .option-text {
+      font-size: 0.9rem;
+      font-weight: 600;
+    }
+
+    .customization:hover .option-background {
+      border-color: #8d6e63;
+    }
+
+    .customization input:checked ~ .option-background {
+      background: #fff0d9;
+      border-color: #a36620;
+    }
+
+    .customization input:checked ~ .check-icon {
+      background: var(--accent);
+      border-color: var(--primary);
+      transform: rotate(-5deg);
+    }
+
+    .customization input:checked ~ .check-icon path {
+      stroke-dashoffset: 0;
+      opacity: 1;
+    }
+
+    .customization input:focus-visible ~ .option-background {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization .option-background,
+      .customization .check-icon,
+      .customization .check-icon path {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization input {
+        opacity: 1;
+        inset: auto;
+        left: 12px;
+        width: 24px;
+        height: 24px;
+        appearance: auto;
+      }
+
+      .customization .check-icon {
+        visibility: hidden;
+      }
+
+      .customization input:focus-visible ~ .option-background {
+        outline-color: Highlight;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
