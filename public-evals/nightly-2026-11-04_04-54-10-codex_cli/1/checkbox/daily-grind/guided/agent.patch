+    /* Native checkboxes, with a little maple warmth. */
+    .customizations {
+      min-inline-size: 0;
+      margin-block-start: 1.25rem;
+      padding: 0;
+      border: 0;
+      text-align: start;
+    }
+
+    .customizations legend {
+      margin-block-end: 0.5rem;
+      padding: 0;
+      color: var(--primary);
+      font-size: 0.875rem;
+      font-weight: 600;
+    }
+
+    .customizations legend span {
+      font-weight: 400;
+    }
+
+    .customization-option {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-block-size: 48px;
+      margin-block-start: 0.5rem;
+      padding: 0.625rem 0.75rem;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      cursor: pointer;
+      overflow-wrap: anywhere;
+    }
+
+    .customization-option:hover:not(:has(:disabled)) {
+      border-color: var(--primary);
+      background: var(--customization-surface);
+    }
+
+    .customization-option:has(:checked) {
+      border-color: var(--primary);
+      background: var(--customization-surface);
+    }
+
+    .customization-option input {
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      flex: 0 0 auto;
+      inline-size: 1.375em;
+      block-size: 1.375em;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 0.25em;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      cursor: inherit;
+    }
+
+    .customization-option input::before {
+      content: "";
+      inline-size: 0.875em;
+      block-size: 0.875em;
+      background: currentColor;
+      mask: var(--icon-check) no-repeat center / contain;
+      transform: scale(0) rotate(-20deg);
+      opacity: 0;
+    }
+
+    .customization-option input:is(:checked, :indeterminate) {
+      background: var(--accent);
+    }
+
+    .customization-option input:indeterminate::before {
+      mask-image: var(--icon-dash);
+    }
+
+    .customization-option input:is(:checked, :indeterminate)::before {
+      transform: scale(1) rotate(0deg);
+      opacity: 1;
+    }
+
+    .customization-option input:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .customization-option:has(:disabled) {
+      opacity: 0.55;
+      cursor: not-allowed;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .customization-option,
+      .customization-option input {
+        transition: background-color 180ms ease, border-color 180ms ease;
+      }
+
+      .customization-option input::before {
+        transition: transform 160ms ease-in, opacity 160ms ease;
+      }
+
+      .customization-option input:is(:checked, :indeterminate)::before {
+        transition-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1.4), ease;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization-option input {
+        appearance: auto;
+      }
+
+      .customization-option input::before {
+        display: none;
+      }
+
+      .customization-option:has(:checked) {
+        border-color: Highlight;
+      }
+
+      .customization-option input:focus-visible {
+        outline-color: Highlight;
+      }
+    }
+
