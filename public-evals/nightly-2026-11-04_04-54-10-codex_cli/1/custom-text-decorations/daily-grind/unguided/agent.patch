+    /* The transparent text copy gives native decorations real glyphs to skip.
+       Clip only that copy so line end insets never cut into the visible text. */
+    .decorated {
+      --line-color: var(--accent);
+      --line-offset: 0.22em;
+      --line-start: 0.08em;
+      --line-end: 0.08em;
+      --line-thickness: 2px;
+      --line-style: solid;
+      --line-position: underline;
+      position: relative;
+      display: inline-block;
+    }
+
+    .line-ink {
+      position: absolute;
+      inset: 0;
+      color: transparent;
+      pointer-events: none;
+      user-select: none;
+      white-space: nowrap;
+      text-decoration-line: var(--line-position);
+      text-decoration-style: var(--line-style);
+      text-decoration-color: var(--line-color);
+      text-decoration-thickness: var(--line-thickness);
+      text-underline-offset: var(--line-offset);
+      text-decoration-skip-ink: auto;
+      /* Extra vertical room preserves waves and offset lines. */
+      clip-path: inset(-0.6em var(--line-end) -0.6em var(--line-start));
+      animation: reveal-line 850ms cubic-bezier(0.22, 1, 0.36, 1) both;
+      animation-delay: var(--line-delay, 0ms);
+      transition: clip-path 350ms ease, text-decoration-color 250ms ease;
+    }
+
+    @keyframes reveal-line {
+      from {
+        clip-path: inset(-0.6em calc(100% - var(--line-start)) -0.6em var(--line-start));
+      }
+      to {
+        clip-path: inset(-0.6em var(--line-end) -0.6em var(--line-start));
+      }
+    }
+
+    nav a .line-ink,
+    .footer-links a .line-ink {
+      animation: none;
+      clip-path: inset(-0.6em calc(100% - var(--line-start)) -0.6em var(--line-start));
+    }
+
+    nav a:is(:hover, :focus-visible) .line-ink,
+    .footer-links a:is(:hover, :focus-visible) .line-ink {
+      clip-path: inset(-0.6em var(--line-end) -0.6em var(--line-start));
+    }
+
+    nav a:focus-visible,
