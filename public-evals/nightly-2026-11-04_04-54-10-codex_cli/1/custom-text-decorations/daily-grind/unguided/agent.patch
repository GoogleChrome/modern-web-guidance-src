+      --line-start: 0.35em;
+      --line-end: 0.35em;
+    }
+
+    .card h3 .decorated {
+      --line-color: #b66b25;
+      --line-offset: 0.25em;
+      --line-start: 0.15em;
+      --line-end: 0.15em;
+      --line-delay: 150ms;
+    }
+
+    .card:nth-child(2) h3 .decorated {
+      --line-style: double;
+      --line-thickness: 1px;
+      --line-offset: 0.3em;
+      --line-delay: 300ms;
+    }
+
+    .card:nth-child(3) h3 .decorated {
