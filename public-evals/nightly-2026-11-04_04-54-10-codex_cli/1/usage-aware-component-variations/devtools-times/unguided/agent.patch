+++ b/src/components/ContextStudio.tsx
@@ -0,0 +1,68 @@
+import { useState } from 'react';
+import { Squares2X2Icon, CubeIcon, SwatchIcon, AdjustmentsHorizontalIcon, BookOpenIcon, ArrowUpRightIcon, ChevronDownIcon, ChevronRightIcon, PlusIcon, CheckIcon, ArrowRightIcon, ArrowDownTrayIcon, CommandLineIcon, SunIcon, MoonIcon, ComputerDesktopIcon, MagnifyingGlassIcon, BellIcon, EllipsisHorizontalIcon, CheckCircleIcon, InformationCircleIcon, ExclamationTriangleIcon, XMarkIcon, ArrowPathIcon, CodeBracketIcon, ClipboardIcon, BoltIcon, SparklesIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+
+const contexts = {
+  Success: { color: '#328467', tint: '#edf7f1', title: 'Looking good!', message: 'Your changes have been saved successfully.', badge: 'Completed', action: 'Save changes', icon: CheckCircleIcon },
+  Information: { color: '#527db0', tint: '#edf3fb', title: 'A little heads up', message: 'A new update is available for your workspace.', badge: 'In progress', action: 'View details', icon: InformationCircleIcon },
+  Warning: { color: '#b37b26', tint: '#fff7e8', title: 'A quick reminder', message: 'Please review your changes before continuing.', badge: 'Needs review', action: 'Review changes', icon: ExclamationTriangleIcon },
+  Danger: { color: '#c56561', tint: '#fdf0ee', title: 'Something needs attention', message: 'We couldn’t save your changes. Please try again.', badge: 'Failed', action: 'Try again', icon: ExclamationTriangleIcon },
+  Neutral: { color: '#72736e', tint: '#f1f1ee', title: 'You’re all caught up', message: 'There are no new updates in your workspace.', badge: 'Draft', action: 'Continue', icon: InformationCircleIcon },
+};
+type Context = keyof typeof contexts;
+const componentItems = ['Overview', 'Buttons', 'Alerts', 'Badges', 'Cards', 'Inputs', 'Avatars'];
+
+export default function ContextStudio() {
+  const [context, setContext] = useState<Context>('Success');
+  const [active, setActive] = useState('Overview');
+  const [tab, setTab] = useState('Preview');
+  const [theme, setTheme] = useState('Light');
+  const [systemDark] = useState(() => typeof window !== 'undefined' && window.matchMedia('(prefers-color-scheme: dark)').matches);
+  const [radius, setRadius] = useState('Medium');
+  const [density, setDensity] = useState('Comfortable');
+  const [showAlert, setShowAlert] = useState(true);
+  const [saved, setSaved] = useState(false);
+  const [toast, setToast] = useState('');
+  const [search, setSearch] = useState('');
+  const [section, setSection] = useState('Components');
+  const semantic = contexts[context];
+  const SemanticIcon = semantic.icon;
+  const notify = (message: string) => { setToast(message); setTimeout(() => setToast(''), 3500); };
+  const code = `<Button context="${context.toLowerCase()}" variant="solid">\n  ${semantic.action}\n</Button>\n\n<Alert context="${context.toLowerCase()}" title="${semantic.title}">\n  ${semantic.message}\n</Alert>`;
+  const exportTokens = () => {
+    const blob = new Blob([JSON.stringify({context: context.toLowerCase(), color: semantic.color, background: semantic.tint, radius, density, theme}, null, 2)], {type:'application/json'});
+    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'forma-tokens.json'; a.click(); URL.revokeObjectURL(a.href); notify('Theme tokens exported');
+  };
+  return <div className={`studio ${theme === 'Dark' || (theme === 'System' && systemDark) ? 'dark' : ''}`} style={{'--semantic':semantic.color,'--semantic-tint':semantic.tint,'--component-radius':radius === 'Small' ? '4px' : radius === 'Large' ? '16px' : '8px'} as React.CSSProperties}>
+    <aside className="sidebar">
+      <a href="/" className="brand"><span className="brand-mark"><span/><span/><span/></span>forma<span className="brand-period">.</span></a>
+      <button className="workspace" onClick={() => notify('You’re in your personal workspace')}><span className="workspace-avatar">F</span><span>Personal workspace<small>Free plan</small></span><ChevronDownIcon/></button>
+      <div className="nav-caption">WORKSPACE</div>
+      <nav className="main-nav">{[['Overview',Squares2X2Icon],['Components',CubeIcon],['Foundations',SwatchIcon],['Theme builder',AdjustmentsHorizontalIcon]].map(([name, Icon]: any) => <button key={name} className={section === name ? 'selected' : ''} onClick={() => {setSection(name); if(name === 'Overview') setActive('Overview');}}><Icon/>{name}{name === 'Components' && <span className="nav-count">24</span>}</button>)}</nav>
+      <div className="component-navigation"><div className="nav-caption">COMPONENTS <span>⌘ K</span></div><label className="component-search"><MagnifyingGlassIcon/><input placeholder="Find a component…" value={search} onChange={e => setSearch(e.target.value)}/></label><nav className="component-nav">{componentItems.filter(item => item.toLowerCase().includes(search.toLowerCase())).map(item => <button className={active === item ? 'active' : ''} key={item} onClick={() => {setActive(item); setSection('Components'); setTab('Preview')}}><span className="nav-dot"/>{item}{item === 'Overview' && <span className="tiny-dot"/>}</button>)}{componentItems.filter(item => item.toLowerCase().includes(search.toLowerCase())).length === 0 && <p className="no-results">No components found</p>}</nav></div>
+      <div className="sidebar-bottom"><div className="upgrade-card"><span className="upgrade-icon"><SparklesIcon/></span><h4>A little more possibility.</h4><p>More components. More freedom.<br/>Meet Forma Pro.</p><button onClick={() => notify('Forma Pro is coming soon. Stay tuned!')}>Explore Pro <ArrowUpRightIcon/></button></div><button className="documentation" onClick={() => {setSection('Documentation'); setTab('Code')}}><BookOpenIcon/>Documentation<ArrowUpRightIcon/></button><button className="profile" onClick={() => notify('Alex Morgan · Personal workspace')}><span className="profile-avatar">AM</span><span>Alex Morgan<small>Personal account</small></span><ChevronDownIcon/></button></div>
+    </aside>
+    <div className="main-shell">
+      <header className="topbar"><div className="breadcrumbs"><CubeIcon/><span>{section}</span><ChevronRightIcon/><strong>{active}</strong></div><div className="topbar-right"><span className="version">v1.4.0 <span>Latest</span></span><span className="topbar-divider"/><a href="https://github.com" target="_blank" rel="noreferrer" className="github-link"><CodeBracketIcon/>Star on GitHub<ArrowUpRightIcon/></a><button className="icon-button" aria-label="Notifications" onClick={() => notify('You’re all caught up. No new notifications.')}><BellIcon/><i/></button></div></header>
+      <main className="main-content">
+        <div className="page-heading"><div><div className="eyebrow"><span/>THE COMPONENT PLAYGROUND</div><h1>{section === 'Components' ? active === 'Overview' ? 'Built to fit the moment.' : `${active}, with context.` : section === 'Foundations' ? 'A thoughtful foundation.' : section === 'Theme builder' ? 'Make it feel like you.' : section === 'Documentation' ? 'A system that makes sense.' : 'Built to fit the moment.'}</h1><p>Thoughtful components. Meaningful context. One cohesive system.</p></div><button className="export-button" onClick={exportTokens}><ArrowDownTrayIcon/>Export theme</button></div>
+        <section className="intro-strip"><span className="intro-icon"><CubeIcon/></span><div><strong>Good design understands context.</strong><p>Components that adapt their colors, tone, and behavior to what they mean.</p></div><span className="semantic-label"><span/>Semantic by design</span></section>
+        <div className="workspace-grid">
+          <section className="playground"><div className="panel-heading"><div className="tabs">{['Preview','Code'].map(t => <button key={t} onClick={() => setTab(t)} className={tab === t ? 'active' : ''}>{t === 'Preview' ? <Squares2X2Icon/> : <CodeBracketIcon/>}{t}</button>)}</div><div className="preview-tools"><span><span/>Live preview</span><button className="icon-button" aria-label="Reset preview" onClick={() => {setContext('Success');setShowAlert(true);setSaved(false);setRadius('Medium');setDensity('Comfortable')}}><ArrowPathIcon/></button><button className="icon-button" aria-label="Copy component code" onClick={() => {navigator.clipboard?.writeText(code);notify('Component code copied')}}><ClipboardIcon/></button></div></div>
+          {tab === 'Code' ? <div className="code-preview"><div><span>React / JSX</span><button onClick={() => {navigator.clipboard?.writeText(code);notify('Code copied')}}><ClipboardIcon/>Copy code</button></div><pre><code>{code}</code></pre><p>Semantic tokens keep every component in sync with your selected context.</p></div> : <div className={`preview-canvas ${density === 'Compact' ? 'compact' : ''}`}>
+            <div className="canvas-label"><span>COMPONENT COLLECTION</span><span className="context-tag"><span/>{context} context</span></div>
+            {(active === 'Overview' || active === 'Buttons') && <div className="sample-section"><div className="sample-label">Buttons<span>01</span></div><div className="button-examples"><button className="semantic-button solid" onClick={() => {setSaved(true);notify(context === 'Success' ? 'Changes saved successfully' : semantic.message)}}><CheckIcon/>{saved ? 'Changes saved' : semantic.action}</button><button className="semantic-button outlined" onClick={() => notify('Your changes are ready to review')}>View changes<ArrowUpRightIcon/></button><button className="semantic-button ghost" onClick={() => {setSaved(false);notify('Changes discarded')}}>Dismiss</button><button className="semantic-square" aria-label="Add item" onClick={() => notify('New item added')}><PlusIcon/></button></div></div>}
+            {(active === 'Overview' || active === 'Alerts') && <div className="sample-section"><div className="sample-label">Alerts<span>02</span></div>{showAlert ? <div className="semantic-alert"><SemanticIcon/><div><strong>{semantic.title}</strong><p>{semantic.message}</p></div><button aria-label="Dismiss alert" onClick={() => setShowAlert(false)}><XMarkIcon/></button></div> : <button className="restore-alert" onClick={() => setShowAlert(true)}>Show alert again <ArrowPathIcon/></button>}</div>}
+            {(active === 'Overview' || active === 'Badges') && <div className="sample-section"><div className="sample-label">Badges<span>03</span></div><div className="badge-examples"><span className="badge filled"><span/>{semantic.badge}</span><span className="badge soft"><CheckIcon/>{semantic.badge}</span><span className="badge bordered">{semantic.badge}</span><span className="badge neutral">Neutral</span></div></div>}
+            {(active === 'Overview' || active === 'Cards') && <div className="sample-section card-section"><div className="sample-label">Cards<span>04</span></div><div className="example-card"><div className="example-card-top"><span className="card-icon"><ShieldCheckIcon/></span><span className="badge soft"><span/>{context === 'Success' ? 'System healthy' : semantic.badge}</span><button className="icon-button" aria-label="Card details" onClick={() => notify('All 24 components are using the current semantic theme')}><EllipsisHorizontalIcon/></button></div><h3>Everything is in sync.</h3><p>Your components share the same language.<br/>Consistent by default, flexible by nature.</p><div className="example-card-bottom"><span><span className="avatars"><i>JD</i><i>MK</i><i>AL</i></span><span>Made for your team</span></span><button onClick={() => notify('Workspace is up to date')}>View details<ArrowRightIcon/></button></div></div></div>}
+            {active === 'Inputs' && <div className="sample-section"><div className="sample-label">Inputs<span>05</span></div><label className="demo-input">Workspace name<input placeholder="Your workspace" onChange={() => setSaved(false)}/></label><button className="semantic-button solid" onClick={() => notify('Workspace name updated')}><CheckIcon/>Save changes</button></div>}
+            {active === 'Avatars' && <div className="sample-section"><div className="sample-label">Avatars<span>06</span></div><div className="avatar-examples">{['AM','JD','MK','AL'].map(n => <span key={n}>{n}</span>)}</div></div>}
+            <div className="canvas-footer"><span><span/>One context. Every component.</span><span>Powered by semantic tokens<ArrowUpRightIcon/></span></div>
+          </div>}</section>
+          <aside className="controls"><div className="controls-heading"><AdjustmentsHorizontalIcon/><h2>Make it contextual</h2></div><p className="controls-description">Change the meaning. Watch it adapt.</p><div className="control-section"><div className="control-label">Semantic context<InformationCircleIcon/></div><div className="context-options">{(Object.keys(contexts) as Context[]).map(name => {const Icon = contexts[name].icon; return <button key={name} className={context === name ? 'chosen' : ''} style={{'--option-color':contexts[name].color,'--option-tint':contexts[name].tint} as React.CSSProperties} onClick={() => {setContext(name);setSaved(false);setShowAlert(true)}}><Icon/>{name}<span className="radio">{context === name && <span/>}</span></button>})}</div></div><div className="control-section theme-section"><div className="control-label">Appearance</div><div className="segmented">{[['Light',SunIcon],['Dark',MoonIcon],['System',ComputerDesktopIcon]].map(([name,Icon]: any) => <button key={name} className={theme === name ? 'active' : ''} onClick={() => {setTheme(name)}}><Icon/>{name}</button>)}</div></div><div className="control-section"><div className="control-label">Corner radius<span>{radius}</span></div><div className="segmented radius-controls">{['Small','Medium','Large'].map(r => <button key={r} className={radius === r ? 'active' : ''} onClick={() => setRadius(r)}><span style={{borderRadius:r === 'Small' ? 2 : r === 'Medium' ? 5 : 9}}/>{r}</button>)}</div></div><div className="control-section density-section"><div className="control-label">Density</div><button className="density-select" onClick={() => setDensity(density === 'Comfortable' ? 'Compact' : 'Comfortable')}><AdjustmentsHorizontalIcon/>{density}<ChevronDownIcon/></button></div><div className="tip"><BoltIcon/><p><strong>Meaning, not just color.</strong><br/>Context flows through every token, so your UI always feels intentional.</p></div></aside>
+        </div>
+        <div className="bottom-features"><div><span className="feature-icon"><SwatchIcon/></span><span><strong>One source of truth</strong><p>A shared language, from token to screen.</p></span></div><div><span className="feature-icon"><CubeIcon/></span><span><strong>Composable by nature</strong><p>Mix, match, and make it your own.</p></span></div><div><span className="feature-icon"><CheckCircleIcon/></span><span><strong>Accessible at the core</strong><p>Built for everyone. In every context.</p></span></div></div>
+        <footer><span>A little structure. A lot of possibility.</span><span>Crafted with intention <span className="footer-star">✳</span></span></footer>
+      </main>
+    </div>{toast && <div className="toast" role="status"><CheckCircleIcon/>{toast}<button aria-label="Close notification" onClick={() => setToast('')}><XMarkIcon/></button></div>}
+  </div>;
+}
