diff --git a/browser-tools.js b/browser-tools.js
new file mode 100644
index 0000000..f9b05dc
--- /dev/null
+++ b/browser-tools.js
@@ -0,0 +1,148 @@
+(() => {
+  // Read the visible menu so agent results and the page share a source of truth.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const orders = new Map();
+  const status = document.getElementById('order-status');
+  const orderList = document.getElementById('order-items');
+  const clearButton = document.getElementById('clear-order');
+  const drinkIds = menu.map(drink => drink.id);
+  const drinkSchema = {
+    type: 'string', enum: drinkIds, description: 'The seasonal drink to act on.',
+  };
+
+  function validate(input, allowed) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      return { error: 'Provide an object containing the tool arguments.' };
+    }
+    if (Object.keys(input).some(key => !allowed.includes(key))) {
+      return { error: 'Unknown argument.', allowedArguments: allowed };
+    }
+    return null;
+  }
+
+  function renderOrder(message) {
+    orderList.replaceChildren(...[...orders].map(([id, quantity]) => {
+      const item = document.createElement('li');
+      item.textContent = `${quantity} × ${menu.find(drink => drink.id === id).name}`;
+      return item;
+    }));
+    clearButton.disabled = orders.size === 0;
+    status.textContent = message;
+  }
+
+  function orderDrink(input) {
+    const error = validate(input, ['drinkId', 'quantity']);
+    if (error) return error;
+    const { drinkId, quantity = 1 } = input;
+    const drink = menu.find(item => item.id === drinkId);
+    if (!drink) return { error: 'Choose a seasonal drink.', availableDrinkIds: drinkIds };
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) {
+      return { error: 'Quantity must be an integer from 1 to 20.' };
+    }
+    const total = (orders.get(drinkId) || 0) + quantity;
+    if (total > 20) return { error: 'An order can contain at most 20 of each drink.' };
+    orders.set(drinkId, total);
+    renderOrder(`Added ${quantity} × ${drink.name} to your local order.`);
+    return {
+      status: 'added_to_local_order',
+      items: [...orders].map(([id, count]) => ({ drinkId: id, quantity: count })),
+      message: 'No purchase has been placed. This order lasts only in this tab.',
+    };
+  }
+
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Daily Grind Seasonal Favorites menu to find drinks and their details.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { query: { type: 'string', description: 'Words to match in drink names or descriptions.', default: '' } },
+      },
+      execute(input) {
+        const error = validate(input, ['query']);
+        if (error) return error;
+        const { query = '' } = input;
+        if (typeof query !== 'string') return { error: 'Query must be text.' };
+        const search = query.trim().toLowerCase();
+        return { section: 'Seasonal Favorites', drinks: menu.filter(drink =>
+          `${drink.name} ${drink.description}`.toLowerCase().includes(search)) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible, tab-local order planner. No purchase is placed.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          drinkId: drinkSchema,
+          quantity: { type: 'integer', minimum: 1, maximum: 20, default: 1, description: 'Number of drinks to add.' },
+        },
+        required: ['drinkId'],
+      },
+      execute: orderDrink,
+      annotations: { readOnlyHint: false, consequentialHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight a seasonal drink on the page and bring it into view for the user.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { drinkId: drinkSchema }, required: ['drinkId'],
+      },
+      execute(input) {
+        const error = validate(input, ['drinkId']);
+        if (error) return error;
+        const selected = cards.find(card => card.dataset.drinkId === input.drinkId);
+        if (!selected) return { error: 'Choose a seasonal drink.', availableDrinkIds: drinkIds };
+        cards.forEach(card => card.classList.toggle('is-highlighted', card === selected));
+        selected.scrollIntoView({ block: 'center', behavior: 'instant' });
+        selected.focus({ preventScroll: true });
+        return { status: 'highlighted', drinkId: input.drinkId };
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  document.querySelectorAll('[data-order-drink]').forEach(button => {
+    button.addEventListener('click', () => {
+      const result = orderDrink({ drinkId: button.dataset.orderDrink });
+      if (result.error) status.textContent = result.error;
+    });
+  });
+  clearButton.addEventListener('click', () => {
+    orders.clear();
+    renderOrder('Your order is empty.');
+  });
+
+  // Progressive enhancement: the ordinary UI works without the experimental API.
+  // Abort registrations on navigation and re-register on back/forward restoration.
+  let registration;
+  async function registerTools() {
+    if (!document.modelContext?.registerTool || registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of tools) {
+        if (controller.signal.aborted) return;
+        await document.modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      if (registration === controller) registration = undefined;
+      console.warn('Daily Grind browser tools could not be registered.', error);
+    }
+  }
+  window.addEventListener('pagehide', () => {
+    registration?.abort();
+    registration = undefined;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
