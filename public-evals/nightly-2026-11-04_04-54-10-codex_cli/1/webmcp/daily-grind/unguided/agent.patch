+# Daily Grind browser tools
+
+The static homepage registers four WebMCP tools using `document.modelContext`
+(or the earlier `navigator.modelContext` API when present):
+
+| Tool | Inputs | Effect |
+| --- | --- | --- |
+| `get_seasonal_menu` | Optional `query` string | Read the visible Seasonal Favorites menu. |
+| `order_drink` | `drinkId`, optional integer `quantity` (1–10, default 1) | Add a visible page-session order and highlight its drink. |
+| `highlight_drink` | `drinkId` | Scroll to, focus, and highlight a drink card. |
+| `get_orders` | None | Read current orders and total drink quantity. |
+
+Native WebMCP requires a supporting browser and a secure context. The page also
+exposes a fallback without replacing browser APIs:
+
+```js
+window.dailyGrind.listTools(); // Names, descriptions, annotations, JSON Schemas
+await window.dailyGrind.callTool('get_seasonal_menu', { query: 'oat' });
+await window.dailyGrind.callTool('order_drink', {
+  drinkId: 'maple-oat-latte', quantity: 2
+});
+await window.dailyGrind.callTool('get_orders');
+await window.dailyGrind.callTool('highlight_drink', { drinkId: 'cold-brew' });
+```
+
+The fallback returns JSON objects; native tool results contain the same JSON in
+a text content block. Invalid arguments return an `error` without mutating the
+page. Menu data comes from the cards on the homepage. Visitors can use View
+Details to open a drink dialog and add orders through the same ordering logic.
+Orders are a local demo: no backend, payment, or café submission; reloading clears
+them. Repeating `order_drink` adds another order.
+
+API reference: [Chrome WebMCP guidance](https://developer.chrome.com/docs/modern-web-guidance/guides/webmcp/agentic-javascript-tools).
diff --git a/browser-tools.js b/browser-tools.js
new file mode 100644
index 0000000..979444c
--- /dev/null
+++ b/browser-tools.js
@@ -0,0 +1,141 @@
+(() => {
+  'use strict';
+
+  // Read the visible cards so the agent and visitor always see the same menu.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+  }));
+  const orders = [];
+  const dialog = document.querySelector('#drink-dialog');
+  const quantityInput = document.querySelector('#drink-quantity');
+  const status = document.querySelector('#order-status');
+  let selectedDrinkId;
+
+  function findDrink(drinkId) {
+    return menu.find(drink => drink.id === drinkId);
+  }
+
+  function highlightDrink(drinkId) {
+    cards.forEach(card => card.classList.toggle('is-highlighted', card.dataset.drinkId === drinkId));
+    const card = cards.find(card => card.dataset.drinkId === drinkId);
+    card.scrollIntoView({ block: 'center', behavior: 'instant' });
+    card.focus({ preventScroll: true });
+  }
+
+  function orderDrink(drinkId, quantity) {
+    const drink = findDrink(drinkId);
+    const order = { id: `order-${orders.length + 1}`, drinkId, name: drink.name, quantity };
+    orders.push(order);
+    const row = document.createElement('li');
+    row.textContent = `${quantity} × ${drink.name} — ${order.id}`;
+    document.querySelector('#orders').append(row);
+    document.querySelector('#empty-orders').hidden = true;
+    status.textContent = `Added ${quantity} × ${drink.name} to your page order.`;
+    highlightDrink(drinkId);
+    return { ...order };
+  }
+
+  document.querySelectorAll('[data-order-drink]').forEach(button => {
+    button.addEventListener('click', () => {
+      selectedDrinkId = button.dataset.orderDrink;
+      const drink = findDrink(selectedDrinkId);
+      document.querySelector('#drink-title').textContent = drink.name;
+      document.querySelector('#drink-description').textContent = drink.description;
+      quantityInput.value = '1';
+      dialog.showModal();
+    });
+  });
+  document.querySelector('#close-dialog').addEventListener('click', () => dialog.close());
+  document.querySelector('#drink-order-form').addEventListener('submit', event => {
+    event.preventDefault();
+    if (!event.currentTarget.reportValidity()) return;
+    const quantity = Number(quantityInput.value);
+    if (!findDrink(selectedDrinkId) || !Number.isInteger(quantity) || quantity < 1 || quantity > 10) return;
+    dialog.close();
+    orderDrink(selectedDrinkId, quantity);
+  });
+
+  const drinkIdSchema = {
+    type: 'string', enum: menu.map(drink => drink.id),
+    description: 'The exact drink ID from get_seasonal_menu.',
+  };
+  const definitions = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Daily Grind Seasonal Favorites. Returns drink IDs, names, and descriptions. Optionally filter by name or description.',
+      inputSchema: { type: 'object', properties: { query: { type: 'string', maxLength: 200 } }, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      run: ({ query = '' }) => ({
+        section: 'Seasonal Favorites',
+        drinks: menu.filter(drink => `${drink.name} ${drink.description}`.toLowerCase().includes(query.toLowerCase())).map(drink => ({ ...drink })),
+      }),
+    },
+    {
+      name: 'order_drink',
+      description: 'Add 1–10 of a seasonal drink to the visible page order and highlight its card. This is a local demo order, with no payment or café submission. Each call adds a new order.',
+      inputSchema: { type: 'object', properties: { drinkId: drinkIdSchema, quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1 } }, required: ['drinkId'], additionalProperties: false },
+      annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: false },
+      run: ({ drinkId, quantity = 1 }) => ({ order: orderDrink(drinkId, quantity), scope: 'page-session' }),
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight, scroll to, and focus a Seasonal Favorites drink card without ordering it.',
+      inputSchema: { type: 'object', properties: { drinkId: drinkIdSchema }, required: ['drinkId'], additionalProperties: false },
+      annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true },
+      run: ({ drinkId }) => {
+        highlightDrink(drinkId);
+        status.textContent = `Selected ${findDrink(drinkId).name}.`;
+        return { highlightedDrinkId: drinkId };
+      },
+    },
+    {
+      name: 'get_orders',
+      description: 'Read the current page-session drink orders and total number of drinks.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      run: () => ({ orders: orders.map(order => ({ ...order })), totalQuantity: orders.reduce((total, order) => total + order.quantity, 0), scope: 'page-session' }),
+    },
+  ];
+
+  // Validate at execution time too: native implementations may not enforce schemas.
+  function execute(definition, input = {}) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) return { error: 'Input must be an object.' };
+    const schema = definition.inputSchema;
+    if (Object.keys(input).some(key => !Object.hasOwn(schema.properties, key))) return { error: 'Unknown input property.' };
+    if ((schema.required || []).some(key => !Object.hasOwn(input, key))) return { error: 'drinkId is required. Use get_seasonal_menu to find valid IDs.' };
+    if (Object.hasOwn(input, 'drinkId') && !findDrink(input.drinkId)) return { error: 'Unknown drinkId. Use get_seasonal_menu to find valid IDs.' };
+    if (Object.hasOwn(input, 'quantity') && (!Number.isInteger(input.quantity) || input.quantity < 1 || input.quantity > 10)) return { error: 'quantity must be an integer from 1 to 10.' };
+    if (Object.hasOwn(input, 'query') && (typeof input.query !== 'string' || input.query.length > 200)) return { error: 'query must be a string of at most 200 characters.' };
+    return definition.run(input);
+  }
+
+  // A discoverable fallback for agents in browsers without native WebMCP.
+  window.dailyGrind = Object.freeze({
+    listTools: () => definitions.map(({ run, ...definition }) => JSON.parse(JSON.stringify(definition))),
+    callTool: async (name, input = {}) => {
+      const definition = definitions.find(tool => tool.name === name);
+      return definition ? execute(definition, input) : { error: `Unknown tool: ${name}` };
+    },
+  });
+
+  // Prefer the current API; support earlier browser implementations as well.
+  const modelContext = document.modelContext || navigator.modelContext;
+  if (typeof modelContext?.registerTool === 'function') {
+    for (const { run, ...definition } of definitions) {
+      try {
+        Promise.resolve(modelContext.registerTool({
+          ...definition,
+          execute: async (input = {}) => {
+            const result = execute(definitions.find(tool => tool.name === definition.name), input);
+            return { content: [{ type: 'text', text: JSON.stringify(result) }], ...(result.error ? { isError: true } : {}) };
+          },
+        })).catch(error => console.warn(`Could not register ${definition.name}`, error));
+      } catch (error) {
+        console.warn(`Could not register ${definition.name}`, error);
+      }
+    }
+  }
+})();
