@@ -0,0 +1,41 @@
+/** Optional WebMCP extensions; ordinary form submission works without them. */
+export type ToolSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export function respondToTool(event: Event, result: Promise<unknown>) {
+  const submit = event as ToolSubmitEvent;
+  if (submit.agentInvoked && submit.respondWith) submit.respondWith(result);
+}
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function fetchArticles(): Promise<Article[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`);
+  if (!response.ok) throw new Error(`Unable to load articles (${response.status}).`);
+  return response.json();
+}
+
+export async function getReadingList(): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`);
+  if (!response.ok) throw new Error(`Unable to load reading list (${response.status}).`);
+  return (await response.json()).readingList;
+}
+
+export async function toggleBookmark(slug: string): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  if (!response.ok) throw new Error(`Unable to update reading list (${response.status}).`);
+  const { readingList } = await response.json();
+  window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: readingList }));
+  return readingList;
+}
