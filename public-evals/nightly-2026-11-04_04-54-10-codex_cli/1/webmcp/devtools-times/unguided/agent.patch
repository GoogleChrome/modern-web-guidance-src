diff --git a/src/scripts/browser-tools.ts b/src/scripts/browser-tools.ts
new file mode 100644
index 0000000..42ac9e7
--- /dev/null
+++ b/src/scripts/browser-tools.ts
@@ -0,0 +1,100 @@
+interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint: boolean };
+  execute: (input: Record<string, unknown>) => Promise<unknown>;
+}
+interface ModelContext {
+  registerTool: (tool: BrowserTool, options: { signal: AbortSignal }) => void | Promise<void>;
+}
+
+let controller: AbortController | undefined;
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+
+async function registerTools() {
+  controller?.abort();
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext;
+  if (!context) return;
+  const current = new AbortController();
+  controller = current;
+  const tools: BrowserTool[] = [
+    ...(['search', 'reading-list'] as const).map(kind => ({
+      name: kind === 'search' ? 'open_search' : 'open_reading_list',
+      description: kind === 'search'
+        ? 'Open the article search form to discover and invoke search_articles.'
+        : 'Open your reading list to view saved articles and use the update_reading_list form.',
+      inputSchema: emptySchema,
+      execute: async () => {
+        const button = document.querySelector<HTMLButtonElement>(`[data-open-${kind}]`);
+        if (!button) throw new Error('The page is still loading. Try again shortly.');
+        const island = button.closest('astro-island');
+        if (island?.hasAttribute('ssr')) {
+          await new Promise<void>((resolve, reject) => {
+            const timeout = window.setTimeout(() => {
+              island.removeEventListener('astro:hydrate', hydrated);
+              reject(new Error('The page is still loading. Try again shortly.'));
+            }, 10000);
+            function hydrated() { window.clearTimeout(timeout); resolve(); }
+            island.addEventListener('astro:hydrate', hydrated, { once: true });
+          });
+        }
+        const name = kind === 'search' ? 'search_articles' : 'update_reading_list';
+        await new Promise<void>((resolve, reject) => {
+          const ready = () => !!document.querySelector(`form[toolname="${name}"]`);
+          if (ready()) { resolve(); return; }
+          const observer = new MutationObserver(() => {
+            if (ready()) { observer.disconnect(); window.clearTimeout(timeout); resolve(); }
+          });
+          const timeout = window.setTimeout(() => {
+            observer.disconnect();
+            reject(new Error('Unable to open the form. Please try again.'));
+          }, 10000);
+          observer.observe(document.body, { childList: true, subtree: true });
+          button.click();
+        });
+        return { opened: kind, tool: name };
+      },
+    })),
+  ];
+
+  const slug = document.querySelector<HTMLElement>('[data-article-slug]')?.dataset.articleSlug;
+  const utilities: Record<string, { name: string; endpoint: string; description: string }> = {
+    'coastal-pulse': { name: 'get_tide_levels', endpoint: 'tide-levels', description: 'Request tide levels for the coastal article, including redirect and HTTP error details.' },
