diff --git a/src/lib/article-client.ts b/src/lib/article-client.ts
new file mode 100644
index 0000000..834ab62
--- /dev/null
+++ b/src/lib/article-client.ts
@@ -0,0 +1,66 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const readingListChanged = 'reading-list-changed';
+let readingListSnapshot: string[] | undefined;
+
+// Lazy-hydrated bookmarks may mount after an agent has already changed the list.
+export function getReadingListSnapshot() {
+  return readingListSnapshot;
+}
+
+async function request<T>(path: string, options?: RequestInit): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+  return response.json();
+}
+
+export function getArticles(signal?: AbortSignal) {
+  return request<Article[]>('articles.json', { signal });
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  );
+}
+
+export function getReadingList(signal?: AbortSignal) {
+  return request<{ readingList: string[] }>('reading-list.json', { signal });
+}
+
+export async function toggleReadingList(slug: string, signal?: AbortSignal) {
+  if (typeof slug !== 'string' || !slug.trim()) throw new Error('Provide an article slug.');
+  const articles = await getArticles(signal);
+  if (!articles.some(article => article.slug === slug)) throw new Error(`Article "${slug}" was not found.`);
+  const result = await request<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  signal?.throwIfAborted();
+  readingListSnapshot = result.readingList;
+  window.dispatchEvent(new CustomEvent(readingListChanged, { detail: result.readingList }));
+  return result;
+}
+
+// Experimental form extensions are absent in browsers without declarative WebMCP.
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<unknown>) => void;
+};
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submit = event as AgentSubmitEvent;
+  if (submit.agentInvoked && submit.respondWith) submit.respondWith(result);
+}
+
+export function errorMessage(error: unknown) {
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
