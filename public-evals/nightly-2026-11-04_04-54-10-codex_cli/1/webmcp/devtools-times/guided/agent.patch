diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..c346047
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,89 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { errorMessage, getArticles, getReadingList, searchArticles, toggleReadingList } from '../lib/article-client';
+
+// One instance in the shared header; the hook unregisters tools on navigation.
+export default function ArticleTools() {
+  useWebMCP({
+    name: 'find_articles',
+    description: 'Find articles by words in their titles or summaries and return article metadata.',
+    inputSchema: {
+      type: 'object',
+      properties: { query: { type: 'string', description: 'Words to find in article titles and summaries.' } },
+      required: ['query'],
+      additionalProperties: false,
+    },
+    async execute({ query }, { signal }) {
+      if (typeof query !== 'string' || !query.trim()) return { error: 'Provide search words.' };
+      try {
+        return { articles: searchArticles(await getArticles(signal), query) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_article',
+    description: 'Look up an article and its reading URL by its slug.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'The article identifier returned by article search.' } },
+      required: ['slug'],
+      additionalProperties: false,
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) return { error: 'Provide an article slug.' };
+      try {
+        const article = (await getArticles(signal)).find(article => article.slug === slug);
+        return article
+          ? { ...article, url: new URL(`${import.meta.env.BASE_URL}articles/${encodeURIComponent(article.slug)}`, window.location.origin).href }
+          : { error: `Article "${slug}" was not found.` };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: 'Retrieve the articles saved in the current session’s reading list.',
+    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+    async execute(_input, { signal }) {
+      try {
+        const [articles, { readingList }] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+        return { articles: articles.filter(article => readingList.includes(article.slug)) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'toggle_reading_list',
+    description: 'Save an article to the reading list, or remove it if it is already saved.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'The article identifier returned by article search.' } },
+      required: ['slug'],
+      additionalProperties: false,
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string') return { error: 'Provide an article slug.' };
+      try {
+        const result = await toggleReadingList(slug, signal);
+        return { ...result, saved: result.readingList.includes(slug) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: false },
+  });
+  return null;
+}
