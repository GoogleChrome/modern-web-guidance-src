+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = heroHeading.querySelectorAll(':scope > span > span');
+    let previousHeadingWidth = 0;
+
+    function fitHeadingLines() {
+      const width = heroHeading.clientWidth;
+      if (!width) return;
+
+      headingLines.forEach((line) => {
+        line.style.fontSize = '100px';
+        const naturalWidth = line.getBoundingClientRect().width;
+        if (naturalWidth) line.style.fontSize = `${100 * width / naturalWidth}px`;
+      });
+      previousHeadingWidth = width;
+    }
+
+    fitHeadingLines();
+    document.fonts.ready.then(fitHeadingLines);
+    const headingObserver = new ResizeObserver(() => {
+      if (heroHeading.clientWidth !== previousHeadingWidth) fitHeadingLines();
+    });
+    headingObserver.observe(heroHeading);
+  </script>
