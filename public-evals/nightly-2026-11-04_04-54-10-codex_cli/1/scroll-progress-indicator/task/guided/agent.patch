+  <script>
+    (() => {
+      const progress = document.querySelector('.scroll-progress');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeTimeline = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      let pendingFrame = false;
+
+      function updateProgress() {
+        pendingFrame = false;
+        if (nativeTimeline && !reducedMotion.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        const root = document.documentElement;
+        const scrollable = root.scrollHeight - root.clientHeight;
+        const fraction = scrollable > 0 ? window.scrollY / scrollable : 0;
+        const clamped = Math.max(0, Math.min(1, fraction));
+        // Direct updates avoid easing or extra motion for reduced-motion users.
+        progress.style.transform = `scaleX(${clamped})`;
+      }
+
+      function scheduleUpdate() {
+        if (nativeTimeline && !reducedMotion.matches) return;
+        if (!pendingFrame) {
+          pendingFrame = true;
+          window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', updateProgress);
+      } else {
+        reducedMotion.addListener(updateProgress);
+      }
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.body);
+      }
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
