+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const detailImage = document.getElementById('detail-image');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const favorites = new Map(thumbnails.map(card => [card.dataset.favorite, card]));
+    const stories = {
+      'maple-oat-latte': 'Our signature espresso meets velvety steamed oat milk and Vermont maple syrup. A gently sweet, comforting cup for crisp seasonal mornings.',
+      'dark-roast-espresso': 'Our locally roasted beans deliver a rich, full-bodied espresso with a deep roasted finish. Enjoy it slowly and savor every bold sip.',
+      'cold-brew': 'A patient 18-hour steep brings out a mellow, rounded flavor. Served over ice for a refreshing cup with a smooth finish.'
+    };
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let activeFavorite = null;
+    let listScroll = 0;
+    let transition = null;
+    let navigation = Promise.resolve();
+
+    function routeFavorite() {
+      const key = location.hash.slice('#favorite/'.length);
+      return location.hash.startsWith('#favorite/') && favorites.has(key) ? key : null;
+    }
+
+    function updateView(key) {
+      if (key) {
+        const card = favorites.get(key);
+        title.textContent = card.querySelector('.title').textContent;
+        detailImage.src = card.querySelector('img').src;
+        document.getElementById('detail-description').textContent = card.closest('.card').querySelector('.card-description').textContent;
+        document.getElementById('detail-story').textContent = stories[key];
+      }
+      listPage.hidden = Boolean(key);
+      detailPage.hidden = !key;
+      document.title = key ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+      activeFavorite = key;
+      window.scrollTo({ top: key ? 0 : listScroll, behavior: 'instant' });
+    }
+
+    function cleanUp() {
+      thumbnails.forEach(card => card.classList.remove('selected'));
+      hero.classList.remove('selected');
+      title.classList.remove('selected');
+    }
+
+    async function navigate(key) {
+      if (key === activeFavorite) return;
+      if (!activeFavorite) listScroll = window.scrollY;
+      const card = favorites.get(key || activeFavorite);
+      const focusHeading = () => (key ? title : document.getElementById('list-heading')).focus({ preventScroll: true });
+      if (!document.startViewTransition || reducedMotion.matches) {
+        updateView(key);
+        cleanUp();
+        focusHeading();
+        return;
+      }
+      card.classList.add('selected');
+      hero.classList.add('selected');
+      title.classList.add('selected');
+      try {
+        transition = document.startViewTransition(() => updateView(key));
+        // Snapshot failures still commit the DOM update; consume their rejection.
+        transition.ready.catch(() => {});
+        await transition.finished;
+      } catch {
+        if (activeFavorite !== key) updateView(key);
+      } finally {
+        transition = null;
+        cleanUp();
+        focusHeading();
+      }
+    }
+
+    function queueNavigation() {
+      transition?.skipTransition();
+      navigation = navigation.then(() => navigate(routeFavorite()));
+    }
+
+    document.addEventListener('click', event => {
+      const link = event.target.closest('.thumbnail, .back-link');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      history.pushState(null, '', link.getAttribute('href'));
+      queueNavigation();
+    });
+    window.addEventListener('popstate', queueNavigation);
+    window.addEventListener('hashchange', queueNavigation);
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) transition?.skipTransition();
+    });
+    history.scrollRestoration = 'manual';
+    if (routeFavorite()) {
+      updateView(routeFavorite());
+      title.focus({ preventScroll: true });
+    }
+  </script>
