+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const intro = document.querySelector('header.hero');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const root = document.documentElement;
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const favorites = new Map([...document.querySelectorAll('.thumbnail')].map(card => [card.dataset.favorite, card]));
+    const descriptions = {
+      'maple-oat-latte': 'Creamy oat milk with a hint of Vermont maple syrup. Our seasonal latte pairs freshly pulled espresso with gently steamed oat milk for a warm, comforting cup.',
+      'dark-roast-espresso': 'Bold, smokey, and perfect for a morning boost. Our dark roast brings a rich body and a lingering finish to every freshly pulled shot.',
+      'cold-brew': 'Steeped for 18 hours for maximum smoothness. Slowly brewed and served over ice, this refreshing favorite has a mellow, full-bodied flavor.'
+    };
+    let currentId = null;
+    let transition = null;
+    let navigation = 0;
+    let listScroll = 0;
+    const namedElements = new Set();
+
+    function measureTitle(element, phase) {
+      const bounds = element.getBoundingClientRect();
+      root.style.setProperty(`--${phase}-title-width`, `${bounds.width}px`);
+      root.style.setProperty(`--${phase}-title-height`, `${bounds.height}px`);
+    }
+
+    function nameElements(imageElement, titleElement) {
+      imageElement.style.viewTransitionName = 'favorite-image';
+      titleElement.style.viewTransitionName = 'favorite-title';
+      namedElements.add(imageElement);
+      namedElements.add(titleElement);
+    }
+
+    function cleanup() {
+      for (const element of namedElements) {
+        element.style.removeProperty('view-transition-name');
+      }
+      namedElements.clear();
+      for (const phase of ['old', 'new']) {
+        for (const dimension of ['width', 'height']) {
+          root.style.removeProperty(`--${phase}-title-${dimension}`);
+        }
+      }
+    }
+
+    async function navigate(initial = false) {
+      const request = ++navigation;
+      if (transition) {
+        transition.skipTransition();
+        await transition.finished.catch(() => {});
+      }
+      if (request !== navigation) return;
+      const id = location.hash.slice(1);
+      const nextId = favorites.has(id) ? id : null;
+      if (!initial && nextId === currentId) return;
+      const selected = favorites.get(nextId || currentId);
+      const previousId = currentId;
+      if (!currentId && nextId) listScroll = window.scrollY;
+      const animate = !initial && selected && !reducedMotion.matches && document.startViewTransition;
+      const update = () => {
+        cleanup();
+        currentId = nextId;
+        listPage.hidden = !!nextId;
+        intro.hidden = !!nextId;
+        detailPage.hidden = !nextId;
+        if (nextId) {
+          const card = favorites.get(nextId);
+          const source = card.querySelector('img');
+          document.querySelector('#detail-image').src = source.src;
+          document.querySelector('#detail-image').alt = source.alt;
+          title.textContent = card.querySelector('.title').textContent;
+          document.querySelector('#description').textContent = descriptions[nextId];
+        }
+        document.title = nextId ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+        if (!initial) window.scrollTo({ top: nextId ? 0 : listScroll, behavior: 'instant' });
+        if (animate) {
+          const destinationTitle = nextId ? title : selected.querySelector('.title');
+          nameElements(nextId ? hero : selected, destinationTitle);
+          // Reapply the old dimensions: cleanup removed the outgoing names and properties.
+          root.style.setProperty('--old-title-width', `${oldBounds.width}px`);
+          root.style.setProperty('--old-title-height', `${oldBounds.height}px`);
+          measureTitle(destinationTitle, 'new');
+        }
+        (nextId ? title : document.querySelector('#list-heading')).focus({ preventScroll: true });
+      };
+      let oldBounds;
+      if (animate) {
+        const outgoingTitle = previousId ? title : selected.querySelector('.title');
+        oldBounds = outgoingTitle.getBoundingClientRect();
+        nameElements(previousId ? hero : selected, outgoingTitle);
+        transition = document.startViewTransition(update);
+        transition.ready.catch(() => {});
+        try {
+          await transition.finished;
+        } catch {
+          // A skipped or unsupported snapshot still applies the DOM update.
+        } finally {
+          cleanup();
+          transition = null;
+        }
+      } else {
+        update();
+      }
+    }
+
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) transition?.skipTransition();
+    });
+    window.addEventListener('hashchange', () => navigate());
+    navigate(true);
+  </script>
