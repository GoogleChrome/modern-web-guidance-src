index 0000000..85e823f
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,211 @@
+/* Later layers take precedence without increasing selector specificity. */
+@layer reset, tokens, base, layout, components;
+
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    --color-brand: #4e342e;
+    --color-secondary: #d7ccc8;
+    --color-accent: #ffab40;
+    --color-text: #3e2723;
+    --color-page: #fafafa;
+    --color-surface: #fff;
+    --color-on-dark: #fff;
+    --color-brand-hover: var(--color-text);
+    --color-hero-overlay: rgb(0 0 0 / 50%);
+
+    --font-family-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-body: 1.6;
+    --font-weight-bold: 700;
+    --letter-spacing-logo: 1px;
+
+    --space-1: 5px;
+    --space-2: 10px;
+    --space-3: 12px;
+    --space-4: 15px;
+    --space-5: 1rem;
+    --space-6: 20px;
+    --space-7: 40px;
+
+    --radius-small: 4px;
+    --radius-button: 5px;
+    --radius-card: 8px;
+    --border-width: 1px;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --transition-duration: 0.3s;
+    --transition-easing: ease;
+
+    --content-max-inline-size: 1100px;
+    --page-gutter: var(--space-6);
+    --nav-gutter: 5%;
+    --card-min-inline-size: 250px;
+    --hero-min-block-size: 60vh;
+    --z-index-sticky: 1000;
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-family-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(.site-nav, .footer-links) a,
+  .btn {
+    text-decoration: none;
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max-inline-size);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min-inline-size)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+
+  :where(.hero, .card, .section-title, .site-footer) {
+    text-align: center;
+  }
+}
+
+@layer components {
+  /* Navigation */
+  .site-nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--z-index-sticky);
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-5) var(--space-6);
+    padding-block: var(--space-5);
+    padding-inline: var(--nav-gutter);
+    background: var(--color-brand);
+    color: var(--color-on-dark);
+  }
+
+  .logo {
+    font-size: var(--font-size-logo);
+    font-weight: var(--font-weight-bold);
+    letter-spacing: var(--letter-spacing-logo);
+  }
+
+  .site-nav :where(ul) {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: var(--space-6);
+    list-style: none;
+  }
+
+  .site-nav :where(a) {
+    color: var(--color-on-dark);
+    font-size: var(--font-size-nav);
+    transition: color var(--transition-duration) var(--transition-easing);
+  }
+
+  .site-nav :where(a):is(:hover, :focus-visible) {
+    color: var(--color-accent);
+  }
+
+  .logout-link {
+    border: var(--border-width) solid var(--color-accent);
+    padding-block: var(--space-1);
+    padding-inline: var(--space-3);
+    border-radius: var(--radius-small);
+  }
+
+  /* Hero */
+  .hero {
+    min-block-size: var(--hero-min-block-size);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    padding-inline: var(--page-gutter);
+    background-image: linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)), var(--hero-image);
+    background-size: cover;
+    background-position: center;
+    color: var(--color-on-dark);
+  }
+
+  .hero :where(h1) {
+    font-size: var(--font-size-hero);
+    margin-block-end: var(--space-5);
+  }
+
+  /* Cards and shared actions */
+  .card {
+    background: var(--color-surface);
+    padding-block: var(--space-6);
+    padding-inline: var(--space-6);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+  }
+
+  .card :where(h3) {
+    margin-block-end: var(--space-2);
+    color: var(--color-brand);
+  }
+
+  .btn {
+    display: inline-block;
+    background: var(--color-brand);
+    color: var(--color-on-dark);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-6);
+    border-radius: var(--radius-button);
+    margin-block-start: var(--space-4);
+    transition: background-color var(--transition-duration) var(--transition-easing);
+  }
+
+  .btn:is(:hover, :focus-visible) {
+    background-color: var(--color-brand-hover);
+  }
+
+  /* Footer */
+  .site-footer {
+    background: var(--color-secondary);
+    padding-block: var(--space-7);
+    padding-inline: var(--page-gutter);
+    margin-block-start: var(--space-7);
+  }
+
+  .footer-links {
+    margin-block-end: var(--space-6);
+  }
+
+  .footer-links :where(a) {
+    margin-inline: var(--space-2);
+    color: var(--color-text);
+    font-size: var(--font-size-small);
+  }
+}
