     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const error = document.getElementById('newsletter-error');
+    let hasInteracted = false;
+
+    // Use one visible live region as the source of the error announcement.
+    // Disable native popups only once custom validation is ready.
+    newsletter.noValidate = true;
+
+    function updateEmailError() {
+      const showError = hasInteracted && !email.validity.valid;
+      const message = showError
+        ? (email.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.')
+        : '';
+
+      email.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        email.setAttribute('aria-describedby', error.id);
+      } else {
+        email.removeAttribute('aria-describedby');
+      }
+      // Avoid repeated announcements while the same error remains visible.
+      if (error.textContent !== message) error.textContent = message;
+    }
+
+    email.addEventListener('blur', () => {
+      hasInteracted = true;
+      updateEmailError();
+    });
+    email.addEventListener('input', updateEmailError);
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      hasInteracted = true;
+      updateEmailError();
+      if (!email.validity.valid) email.focus();
+    });
+  </script>
+
 </body>
 
 </html>
