+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    function syncNewsletterError() {
+      // Use the same post-interaction state as the visual input styling.
+      const showError = newsletterEmail.matches(':user-invalid');
+      newsletterEmail.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        newsletterEmail.setAttribute('aria-describedby', 'newsletter-error');
+      } else {
+        newsletterEmail.removeAttribute('aria-describedby');
+      }
+
+      const message = showError ? 'Please enter a valid email address.' : '';
+      // Leave the live region mounted and avoid repeating unchanged announcements.
+      if (newsletterError.textContent !== message) {
+        newsletterError.textContent = message;
+      }
+    }
+
+    function syncAfterInteraction() {
+      syncNewsletterError();
+      // Some native validation transitions finish after the event dispatch.
+      requestAnimationFrame(syncNewsletterError);
+    }
+
+    for (const eventName of ['focus', 'blur', 'input', 'change']) {
+      newsletterEmail.addEventListener(eventName, syncAfterInteraction);
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterEmail.addEventListener('invalid', (event) => {
+      // Use the inline error instead of a second browser validation popup.
+      event.preventDefault();
+      newsletterStatus.textContent = '';
+      newsletterEmail.focus();
+      syncAfterInteraction();
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterStatus.textContent = '';
+      requestAnimationFrame(syncNewsletterError);
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncNewsletterError();
+      // Replace this notice when a newsletter service is connected.
+      newsletterStatus.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
