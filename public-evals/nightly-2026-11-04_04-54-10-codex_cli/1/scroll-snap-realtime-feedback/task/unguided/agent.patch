+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const items = [...gallery.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+      const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+      const supportsScrollEnd = 'onscrollend' in gallery;
+      let settleTimer;
+      let pointerDown = false;
+
+      // Compare actual positions so gaps and responsive slide widths are included.
+      const nearestIndex = () => {
+        const start = gallery.getBoundingClientRect().left;
+        return items.reduce((closest, item, index) =>
+          Math.abs(item.getBoundingClientRect().left - start) <
+          Math.abs(items[closest].getBoundingClientRect().left - start) ? index : closest, 0);
+      };
+
+      const markPending = (index) => {
+        thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+      };
+
+      const commitSelection = () => {
+        clearTimeout(settleTimer);
+        const index = nearestIndex();
+        thumbnails.forEach((thumbnail, i) => {
+          thumbnail.classList.remove('pending');
+          thumbnail.classList.toggle('active', i === index);
+          if (i === index) thumbnail.setAttribute('aria-current', 'true');
+          else thumbnail.removeAttribute('aria-current');
+        });
+      };
+
+      // This event exposes the browser's intended snap target before scrolling ends.
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const index = items.indexOf(event.snapTargetInline);
+        if (index !== -1) markPending(index);
+      });
+
+      const scheduleCommit = () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => {
+          if (!pointerDown) commitSelection();
+        }, 180);
+      };
+
+      gallery.addEventListener('scroll', () => {
+        if (!supportsSnapChanging) markPending(nearestIndex());
+        if (!supportsScrollEnd) scheduleCommit();
+      }, { passive: true });
+      gallery.addEventListener('scrollend', commitSelection);
+      gallery.addEventListener('pointerdown', () => { pointerDown = true; }, { passive: true });
+      const releasePointer = () => {
+        if (!pointerDown) return;
+        pointerDown = false;
+        if (!supportsScrollEnd) scheduleCommit();
+      };
+      window.addEventListener('pointerup', releasePointer, { passive: true });
+      window.addEventListener('pointercancel', releasePointer, { passive: true });
+
+      const showItem = (index) => {
+        const offset = items[index].getBoundingClientRect().left - gallery.getBoundingClientRect().left;
+        if (Math.abs(offset) < 1) {
+          commitSelection();
+          return;
+        }
+        markPending(index);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + offset,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      };
+
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.addEventListener('click', () => showItem(index));
+      });
+      gallery.addEventListener('keydown', (event) => {
+        let index = nearestIndex();
+        if (event.key === 'ArrowRight') index = Math.min(index + 1, items.length - 1);
+        else if (event.key === 'ArrowLeft') index = Math.max(index - 1, 0);
+        else if (event.key === 'Home') index = 0;
+        else if (event.key === 'End') index = items.length - 1;
+        else return;
+        event.preventDefault();
+        showItem(index);
+      });
+    })();
+  </script>
