+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const controls = document.querySelector('.gallery-thumbnails');
+    const thumbnails = [...controls.querySelectorAll('.thumbnail')];
+    const needsFocusFallback = !('focusGroup' in HTMLElement.prototype);
+    let frame = null;
+    let settleTimer;
+
+    function syncTabStops() {
+      if (!needsFocusFallback) return;
+      const focused = thumbnails.indexOf(document.activeElement);
+      const current = thumbnails.findIndex(thumb => thumb.classList.contains('active'));
+      thumbnails.forEach((thumb, index) => {
+        thumb.tabIndex = index === (focused < 0 ? current : focused) ? 0 : -1;
+      });
+    }
+
+    function showPending(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumb, i) => thumb.classList.toggle('pending', i === index));
+    }
+
+    function showActive(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumb, i) => {
+        thumb.classList.remove('pending');
+        thumb.classList.toggle('active', i === index);
+        if (i === index) thumb.setAttribute('aria-current', 'true');
+        else thumb.removeAttribute('aria-current');
+      });
+      syncTabStops();
+    }
+
+    function closestItemIndex() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      return items.reduce((closest, item, index) => {
+        const distance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        const previous = items[closest];
+        return distance < Math.abs(previous.offsetLeft + previous.offsetWidth / 2 - center)
+          ? index : closest;
+      }, 0);
+    }
+
+    function settle() {
+      clearTimeout(settleTimer);
+      cancelAnimationFrame(frame);
+      frame = null;
+      showActive(closestItemIndex());
+    }
+
+    gallery.addEventListener('scrollsnapchanging', event => {
+      showPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', event => {
+      showActive(items.indexOf(event.snapTargetInline));
+    });
+    // Also clear pending when a gesture ends on its original snap target.
+    gallery.addEventListener('scrollend', settle);
+
+    const hasSnapPrediction = 'onscrollsnapchanging' in gallery;
+    const hasScrollEnd = 'onscrollend' in gallery;
+    if (!hasSnapPrediction || !hasScrollEnd) {
+      gallery.addEventListener('scroll', () => {
+        if (!hasSnapPrediction && frame === null) {
+          frame = requestAnimationFrame(() => {
+            frame = null;
+            showPending(closestItemIndex());
+          });
+        }
+        if (!hasScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 180);
+        }
+      }, { passive: true });
+    }
+
+    thumbnails.forEach((thumb, index) => {
+      thumb.addEventListener('click', () => {
+        const item = items[index];
+        gallery.scrollTo({
+          left: item.offsetLeft + item.offsetWidth / 2 - gallery.clientWidth / 2,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if (needsFocusFallback) {
+      controls.setAttribute('role', 'toolbar');
+      controls.addEventListener('focusin', syncTabStops);
+      controls.addEventListener('keydown', event => {
+        const index = thumbnails.indexOf(document.activeElement);
+        if (index < 0) return;
+        let next;
+        if (event.key === 'ArrowRight') next = (index + 1) % thumbnails.length;
+        else if (event.key === 'ArrowLeft') next = (index - 1 + thumbnails.length) % thumbnails.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = thumbnails.length - 1;
+        else return;
+        event.preventDefault();
+        thumbnails[next].focus({ preventScroll: true });
+      });
+    }
+
+    settle();
+    window.addEventListener('load', settle, { once: true });
+    window.addEventListener('pageshow', settle);
+  </script>
