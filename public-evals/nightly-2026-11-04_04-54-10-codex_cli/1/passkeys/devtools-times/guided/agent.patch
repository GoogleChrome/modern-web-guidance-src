diff --git a/tests/auth-store.test.ts b/tests/auth-store.test.ts
new file mode 100644
index 0000000..3d7b3ea
--- /dev/null
+++ b/tests/auth-store.test.ts
@@ -0,0 +1,116 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { AuthStore, randomId, tokenHash, type StoredPasskey } from '../src/lib/auth-store.ts';
+
+const keyFor = (userId: string, id = randomId()): StoredPasskey => ({
+  id, userId, publicKey: 'test-public-key', counter: 1, transports: ['internal'], deviceType: 'multiDevice',
+  backedUp: true, aaguid: '00000000-0000-0000-0000-000000000000', name: 'My passkey',
+  provider: 'Unknown passkey provider', registeredAt: Date.now(), lastUsedAt: null,
+});
+
+test('password-confirmed users keep a stable opaque WebAuthn user ID', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const first = store.verifiedPasswordUser('reader');
+    assert.deepEqual(store.verifiedPasswordUser('reader'), first);
+    assert.equal(Buffer.from(first.id, 'base64url').length, 32);
+    assert.notEqual(store.verifiedPasswordUser('other').id, first.id);
+  } finally { store.close(); }
+});
+
+test('session cookies contain random tokens, and storage uses hashes', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const user = store.verifiedPasswordUser('reader');
+    const { token, session } = store.createSession(user.id, Date.now());
+    assert.equal(session.id, tokenHash(token));
+    assert.notEqual(session.id, token);
+    assert.equal(store.session(token)?.userId, user.id);
+    assert.equal(store.session('forged-cookie'), undefined);
+    store.deleteSession(session.id);
+    assert.equal(store.session(token), undefined);
+  } finally { store.close(); }
+});
+
+test('challenges are session-bound, expire, and are consumed only once', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const first = store.createSession().session;
+    const second = store.createSession().session;
+    const request = { id: randomId(), sessionId: first.id, userId: null, kind: 'authenticate' as const, challenge: randomId(), expiresAt: Date.now() + 300000, requireUV: false };
+    store.saveChallenge(request);
+    assert.equal(store.consumeChallenge(request.id, second.id, 'authenticate'), undefined);
+    assert.deepEqual(store.consumeChallenge(request.id, first.id, 'authenticate'), request);
+    assert.equal(store.consumeChallenge(request.id, first.id, 'authenticate'), undefined);
+    store.saveChallenge({ ...request, id: 'expired', expiresAt: Date.now() - 1 });
+    assert.equal(store.consumeChallenge('expired', first.id, 'authenticate'), undefined);
+  } finally { store.close(); }
+});
+
+test('registration challenges cannot be reused as reauthentication challenges', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const user = store.verifiedPasswordUser('reader');
+    const { session } = store.createSession(user.id);
+    store.saveChallenge({ id: 'request', sessionId: session.id, userId: user.id, kind: 'register', challenge: randomId(), expiresAt: Date.now() + 300000, requireUV: false });
+    assert.equal(store.consumeChallenge('request', session.id, 'reauthenticate'), undefined);
+    assert.equal(store.consumeChallenge('request', session.id, 'register'), undefined);
+  } finally { store.close(); }
+});
+
+test('signing out invalidates pending challenges through the session foreign key', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const { session } = store.createSession();
+    store.saveChallenge({ id: 'request', sessionId: session.id, userId: null, kind: 'authenticate', challenge: randomId(), expiresAt: Date.now() + 300000, requireUV: false });
+    store.deleteSession(session.id);
+    assert.equal(store.consumeChallenge('request', session.id, 'authenticate'), undefined);
+  } finally { store.close(); }
+});
+
+test('passkey metadata survives a database restart and profile changes preserve user IDs', () => {
+  const directory = mkdtempSync(join(tmpdir(), 'times-auth-'));
+  const path = join(directory, 'auth.sqlite');
+  let store = new AuthStore(path);
+  try {
+    const user = store.verifiedPasswordUser('reader');
+    const key = keyFor(user.id);
+    store.insertPasskey(key);
+    store.renameUser(user.id, 'News Reader');
+    store.close();
+    store = new AuthStore(path);
+    assert.deepEqual(store.passkeys(user.id), [key]);
+    assert.equal(store.user(user.id)?.displayName, 'News Reader');
+    assert.equal(store.user(user.id)?.username, 'reader');
+  } finally { store.close(); rmSync(directory, { recursive: true, force: true }); }
+});
+
+test('duplicate credentials cannot be attached to another account', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const first = store.verifiedPasswordUser('first');
+    const second = store.verifiedPasswordUser('second');
+    const key = keyFor(first.id);
+    store.insertPasskey(key);
+    assert.throws(() => store.insertPasskey({ ...key, userId: second.id }));
+    assert.equal(store.passkey(key.id)?.userId, first.id);
+    assert.deepEqual(store.passkeys(second.id), []);
+    store.deletePasskey(key.id, second.id);
+    assert.ok(store.passkey(key.id));
+  } finally { store.close(); }
+});
+
+test('an assertion cannot overwrite a counter changed by another assertion', () => {
+  const store = new AuthStore(':memory:');
+  try {
+    const user = store.verifiedPasswordUser('reader');
+    const key = keyFor(user.id);
+    store.insertPasskey(key);
+    store.updatePasskey({ ...key, counter: 2, lastUsedAt: Date.now() }, 1);
+    assert.throws(() => store.updatePasskey({ ...key, counter: 2 }, 1));
+    assert.equal(store.passkey(key.id)?.counter, 2);
+  } finally { store.close(); }
+});
diff --git a/tests/passkey-verification.test.ts b/tests/passkey-verification.test.ts
new file mode 100644
index 0000000..3adc000
--- /dev/null
+++ b/tests/passkey-verification.test.ts
@@ -0,0 +1,73 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { randomId, type Challenge, type StoredPasskey } from '../src/lib/auth-store.ts';
+import { verifyPasskeyAssertion } from '../src/lib/passkey-verification.ts';
+
+// A signed virtual-authenticator fixture: no browser, HTTP listener, or server entrypoint.
+function fixture({ userVerified = true, kind = 'authenticate', counter = 2 }:
+  { userVerified?: boolean; kind?: Challenge['kind']; counter?: number } = {}) {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const cose = new Map<number, number | Uint8Array>([
+    [1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')],
+  ]);
+  const userId = randomId();
+  const passkey: StoredPasskey = { id: randomId(), userId, publicKey: Buffer.from(isoCBOR.encode(cose)).toString('base64url'),
+    counter: 1, transports: ['internal'], deviceType: 'singleDevice', backedUp: false,
+    aaguid: '00000000-0000-0000-0000-000000000000', name: 'Test passkey', provider: 'Test', registeredAt: Date.now(), lastUsedAt: null };
+  const challenge: Challenge = { id: randomId(), sessionId: randomId(), userId: kind === 'reauthenticate' ? userId : null,
+    kind, challenge: randomId(), expiresAt: Date.now() + 300000, requireUV: kind === 'reauthenticate' };
+  const origin = 'https://news.example.com';
+  const rpId = 'news.example.com';
+  const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge: challenge.challenge, origin, crossOrigin: false }));
+  const authenticatorData = Buffer.alloc(37);
+  createHash('sha256').update(rpId).digest().copy(authenticatorData);
+  authenticatorData[32] = userVerified ? 5 : 1; // UP, optionally UV.
+  authenticatorData.writeUInt32BE(counter, 33);
+  const signature = sign('sha256', Buffer.concat([authenticatorData, createHash('sha256').update(clientData).digest()]), privateKey);
+  const response: AuthenticationResponseJSON = { id: passkey.id, rawId: passkey.id, type: 'public-key', clientExtensionResults: {},
+    response: { clientDataJSON: clientData.toString('base64url'), authenticatorData: authenticatorData.toString('base64url'), signature: signature.toString('base64url'), userHandle: userId } };
+  return { response, challenge, passkey, sessionUserId: kind === 'reauthenticate' ? userId : null, origin, rpId };
+}
+
+test('a correctly signed assertion authenticates and advances its counter', async () => {
+  const result = await verifyPasskeyAssertion(fixture());
+  assert.equal(result.verified, true);
+  assert.equal(result.authenticationInfo.newCounter, 2);
+});
+
+test('preferred user verification permits a valid assertion without UV', async () => {
+  const result = await verifyPasskeyAssertion(fixture({ userVerified: false }));
+  assert.equal(result.verified, true);
+  assert.equal(result.authenticationInfo.userVerified, false);
+});
+
+test('reauthentication requires user verification', async () => {
+  await assert.rejects(verifyPasskeyAssertion(fixture({ kind: 'reauthenticate', userVerified: false })), { status: 400 });
+  assert.equal((await verifyPasskeyAssertion(fixture({ kind: 'reauthenticate' }))).verified, true);
+});
+
+test('a valid passkey for another account cannot reauthenticate the current session', async () => {
+  const input = fixture({ kind: 'reauthenticate' });
+  await assert.rejects(verifyPasskeyAssertion({ ...input, sessionUserId: randomId() }), { status: 403 });
+  await assert.rejects(verifyPasskeyAssertion({ ...input, challenge: { ...input.challenge, userId: randomId() } }), { status: 403 });
+});
+
+test('a mismatched user handle is rejected', async () => {
+  const input = fixture();
+  input.response.response.userHandle = randomId();
+  await assert.rejects(verifyPasskeyAssertion(input), { status: 403 });
+});
+
+test('wrong challenge, origin, RP ID, signature, and replay counter are rejected', async () => {
+  const input = fixture();
+  await assert.rejects(verifyPasskeyAssertion({ ...input, challenge: { ...input.challenge, challenge: randomId() } }), { status: 400 });
+  await assert.rejects(verifyPasskeyAssertion({ ...input, origin: 'https://other.example.com' }), { status: 400 });
+  await assert.rejects(verifyPasskeyAssertion({ ...input, rpId: 'other.example.com' }), { status: 400 });
+  await assert.rejects(verifyPasskeyAssertion(fixture({ counter: 1 })), { status: 400 });
+  input.response.response.signature = randomId();
+  await assert.rejects(verifyPasskeyAssertion(input), { status: 400 });
+});
