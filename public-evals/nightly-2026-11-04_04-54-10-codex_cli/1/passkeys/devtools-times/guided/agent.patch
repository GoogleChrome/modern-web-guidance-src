+import type { AccountState } from './auth-types';
+
+export const accountUrl = `${import.meta.env.BASE_URL}account`;
+export class ApiError extends Error {
+  constructor(public status: number, message: string) { super(message); }
+}
+export async function authApi<T = AccountState>(action: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin', cache: 'no-store',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body), signal,
+  });
+  const data = await response.json();
+  if (!response.ok) throw new ApiError(response.status, data.error || 'Unable to complete this request. Please try again.');
+  return data;
+}
+
+type ModernCredential = typeof PublicKeyCredential & {
+  getClientCapabilities(): Promise<Record<string, boolean>>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+const webauthn = () => PublicKeyCredential as ModernCredential;
+
+export async function passkeyCapabilities(): Promise<Record<string, boolean> | null> {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return null;
+  await import('webauthn-polyfills');
+  const capabilities = await webauthn().getClientCapabilities();
+  // Older browsers' capability polyfill cannot detect hybrid support, but can
+  // still positively identify a local authenticator.
+  return { ...capabilities, passkeyPlatformAuthenticator: capabilities.passkeyPlatformAuthenticator ?? capabilities.userVerifyingPlatformAuthenticator };
+}
+
+// Signal API failures must never turn a successful server operation into a UI failure.
+async function unknownCredential(rpId: string, credentialId: string) {
+  try { await webauthn().signalUnknownCredential?.({ rpId, credentialId }); } catch { /* Optional vault synchronization. */ }
+}
+export async function syncPasskeys(state: AccountState) {
+  if (!window.PublicKeyCredential || !state.user) return;
+  try {
+    await webauthn().signalAllAcceptedCredentials?.({ rpId: state.rpId, userId: state.user.id, allAcceptedCredentialIds: state.passkeys.map(key => key.id) });
+  } catch { /* The server list remains authoritative. */ }
+}
+export async function syncUser(state: AccountState) {
+  if (!window.PublicKeyCredential || !state.user) return;
+  try {
+    await webauthn().signalCurrentUserDetails?.({ rpId: state.rpId, userId: state.user.id, name: state.user.username, displayName: state.user.displayName });
+  } catch { /* Unsupported managers can retain their existing display label. */ }
+}
+
+export async function registerPasskey(promotion = false, signal?: AbortSignal) {
+  const { options, requestId } = await authApi<{ options: PublicKeyCredentialCreationOptionsJSON; requestId: string }>('passkeys/register/options', { promotion }, signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  const encoded = credential.toJSON();
+  try {
+    const state = await authApi('passkeys/register/verify', { requestId, credential: encoded });
+    await syncPasskeys(state);
+    return state;
+  } catch (error) {
+    await unknownCredential(options.rp.id!, encoded.id);
+    throw error;
+  }
+}
+
+export async function authenticatePasskey(signal: AbortSignal, conditional = false, reauthenticate = false) {
+  const kind = reauthenticate ? 'reauthenticate' : 'authenticate';
+  const { options, requestId } = await authApi<{ options: PublicKeyCredentialRequestOptionsJSON; requestId: string }>(`passkeys/${kind}/options`, {}, signal);
+  if (reauthenticate && !options.allowCredentials?.length) throw new Error('No passkeys found. Use your password to verify your identity.');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  const credential = await navigator.credentials.get({ publicKey, signal, ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  const encoded = credential.toJSON();
+  try {
+    await authApi(`passkeys/${kind}/verify`, { requestId, credential: encoded });
+  } catch (error) {
+    // Only a definitive unknown-credential response may hide a saved sign-in passkey.
+    if (!reauthenticate && error instanceof ApiError && error.status === 404) await unknownCredential(options.rpId!, encoded.id);
+    throw error;
+  }
+}
+
+export function authError(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. Try again, or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Use it to sign in or choose another provider.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable for this website address. Please use your password.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled.';
+  }
+  return error instanceof Error ? error.message : 'Unable to complete this request. Please try again.';
+}
