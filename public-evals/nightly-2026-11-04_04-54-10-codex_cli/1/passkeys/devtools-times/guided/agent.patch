diff --git a/src/lib/passkey-verification.ts b/src/lib/passkey-verification.ts
new file mode 100644
index 0000000..1b400e3
--- /dev/null
+++ b/src/lib/passkey-verification.ts
@@ -0,0 +1,28 @@
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { AuthError } from './auth-errors.ts';
+import type { Challenge, StoredPasskey } from './auth-store.ts';
+
+export async function verifyPasskeyAssertion({ response, challenge, passkey, sessionUserId, origin, rpId }: {
+  response: AuthenticationResponseJSON;
+  challenge: Challenge;
+  passkey: StoredPasskey;
+  sessionUserId: string | null;
+  origin: string;
+  rpId: string;
+}) {
+  if (challenge.kind === 'reauthenticate' && (!sessionUserId || challenge.userId !== sessionUserId || passkey.userId !== sessionUserId)) {
+    throw new AuthError(403, 'Use a passkey belonging to your signed-in account.');
+  }
+  if (response.response?.userHandle && response.response.userHandle !== passkey.userId) {
+    throw new AuthError(403, 'This passkey belongs to a different account.');
+  }
+  try {
+    const result = await verifyAuthenticationResponse({
+      response, expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpId,
+      credential: { id: passkey.id, publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64url')), counter: passkey.counter, transports: passkey.transports },
+      requireUserVerification: challenge.requireUV,
+    });
+    if (!result.verified) throw new Error('Signature verification failed');
+    return result;
+  } catch { throw new AuthError(400, 'We could not verify this passkey. Please try again or use your password.'); }
+}
