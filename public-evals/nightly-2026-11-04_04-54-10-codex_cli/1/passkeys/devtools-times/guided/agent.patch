index 0000000..04f7baa
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,145 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { authApi, authenticatePasskey, authError, passkeyCapabilities, registerPasskey, syncPasskeys, syncUser } from '../lib/auth-client';
+import type { AccountState } from '../lib/auth-types';
+import PasskeyIcon from './PasskeyIcon';
+
+type Change = { type: 'add' } | { type: 'delete'; id: string; name: string } | { type: 'rename'; id: string; name: string } | { type: 'profile'; displayName: string };
+const date = (timestamp: number | null) => timestamp ? new Date(timestamp).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not used yet';
+
+export default function AccountSettings() {
+  const [state, setState] = useState<AccountState | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [message, setMessage] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [pending, setPending] = useState<Change | null>(null);
+  const [password, setPassword] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [nickname, setNickname] = useState('');
+  const controller = useRef<AbortController | null>(null);
+  const verifyHeading = useRef<HTMLHeadingElement>(null);
+  const mounted = useRef(false);
+
+  async function load() {
+    setError(null);
+    try {
+      const next = await authApi('me');
+      if (!mounted.current) return;
+      setState(next);
+      setDisplayName(next.user?.displayName || '');
+      await syncPasskeys(next);
+    } catch (error) { if (mounted.current) setError(authError(error)); }
+  }
+  useEffect(() => {
+    mounted.current = true;
+    void load();
+    void passkeyCapabilities().then(value => {
+      if (!mounted.current) return;
+      setSupported(!!value);
+      setCanCreate(!!value?.passkeyPlatformAuthenticator && !!value?.conditionalGet);
+    }).catch(() => {});
+    return () => { mounted.current = false; controller.current?.abort(); };
+  }, []);
+  useEffect(() => { if (pending) verifyHeading.current?.focus(); }, [pending]);
+
+  function requestChange(change: Change) {
+    setError(null);
+    setMessage(null);
+    setPassword('');
+    setPending(change);
+  }
+  async function perform(change: Change, signal: AbortSignal) {
+    let next: AccountState;
+    if (change.type === 'add') next = await registerPasskey(false, signal);
+    else if (change.type === 'profile') {
+      next = await authApi('profile', { displayName: change.displayName });
+      await syncUser(next);
+    } else {
+      next = await authApi(`passkeys/${change.type}`, { id: change.id, ...(change.type === 'rename' ? { name: change.name } : {}) });
+      if (change.type === 'delete') await syncPasskeys(next);
+    }
+    if (!mounted.current) return;
+    setState(next);
+    setPending(null);
+    setEditing(null);
+    setMessage(change.type === 'add' ? 'Your passkey is ready to use.' : change.type === 'delete' ? 'Passkey removed. Remove it from your password manager too if it still appears there.' : 'Your changes have been saved.');
+  }
+  async function verify(usePasskey: boolean, event?: FormEvent) {
+    event?.preventDefault();
+    if (!pending || busy) return;
+    setError(null);
+    setBusy(true);
+    const active = new AbortController();
+    controller.current = active;
+    try {
+      if (usePasskey) await authenticatePasskey(active.signal, false, true);
+      else await authApi('password/reauthenticate', { password }, active.signal);
+      setPassword('');
+      if (!active.signal.aborted) await perform(pending, active.signal);
+    } catch (error) { if (mounted.current && !active.signal.aborted) setError(authError(error)); }
+    finally { if (mounted.current) setBusy(false); }
+  }
+  function cancel() {
+    controller.current?.abort();
+    setPending(null);
+    setPassword('');
+    setError(null);
+  }
+  async function signOut() {
+    setBusy(true);
+    try {
+      await authApi('logout', {});
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    } catch (error) { setError(authError(error)); setBusy(false); }
+  }
+
+  if (!state) return <section className="settings-card" aria-live="polite">{error ? <><p role="alert" className="auth-error">{error}</p><button className="auth-link" onClick={load}>Try again</button></> : 'Loading your account…'}</section>;
+  if (!state.user) return <section className="auth-card"><h1 className="auth-title">Your account</h1><p className="auth-description">Sign in to manage your profile and passkeys.</p><a className="auth-button auth-button-primary" href={`${import.meta.env.BASE_URL}signin`}>Sign in</a></section>;
+
+  return <div className="account-settings">
+    <div className="settings-heading"><div><p className="auth-eyebrow">THE DEVTOOLS TIMES / YOUR ACCOUNT</p><h1 className="auth-title">Account settings</h1><p className="auth-description">Your details. Your way to sign in.</p></div><button className="auth-link" type="button" disabled={busy} onClick={signOut}>Sign out</button></div>
+    {error && <p role="alert" className="auth-error">{error}</p>}
+    {message && <p role="status" className="auth-success">{message}</p>}
+
+    {pending && <section className="settings-card verification-panel" aria-labelledby="verify-title">
+      <p className="auth-eyebrow">SECURITY CHECK</p>
+      <h2 id="verify-title" ref={verifyHeading} tabIndex={-1}>{pending.type === 'delete' ? `Remove “${pending.name}”?` : 'Confirm it’s you'}</h2>
+      <p>{pending.type === 'delete' ? 'This passkey will no longer sign you in. Your password and other passkeys will still work.' : 'Verify your identity to continue with this account change.'}</p>
+      {supported && state.passkeys.length > 0 && <button className="auth-button auth-button-primary" type="button" disabled={busy} onClick={() => verify(true)}><PasskeyIcon />{busy ? 'Verifying and saving…' : 'Verify with a passkey'}</button>}
+      <form className="auth-form" onSubmit={event => verify(false, event)}>
+        <div><label htmlFor="verify-password">{state.passkeys.length ? 'Or use your current password' : 'Current password'}</label><input id="verify-password" type="password" name="password" autoComplete="current-password" value={password} onChange={event => setPassword(event.target.value)} required disabled={busy} /></div>
+        <button className="auth-button auth-button-secondary" type="submit" disabled={busy}>{busy ? 'Verifying and saving…' : pending.type === 'delete' ? 'Verify and remove passkey' : 'Verify and continue'}</button>
+      </form>
+      <button className="auth-link" type="button" onClick={cancel}>Cancel</button>
+    </section>}
+
+    <section className="settings-card" aria-labelledby="profile-title">
+      <h2 id="profile-title">Profile</h2><p className="settings-muted">Signed in as <strong>{state.user.username}</strong></p>
+      <form className="auth-form" onSubmit={event => { event.preventDefault(); requestChange({ type: 'profile', displayName: displayName.trim() }); }}>
+        <div><label htmlFor="display-name">Display name</label><input id="display-name" name="displayName" autoComplete="nickname" value={displayName} onChange={event => setDisplayName(event.target.value)} maxLength={100} required disabled={busy || !!pending} /></div>
+        <button className="auth-button auth-button-secondary settings-fit" type="submit" disabled={busy || !!pending || !displayName.trim() || displayName.trim() === state.user.displayName}>Save profile</button>
+      </form>
+    </section>
+
+    <section className="settings-card" aria-labelledby="passkeys-title">
+      <div className="settings-heading"><div><div className="settings-title-row"><PasskeyIcon /><h2 id="passkeys-title">Passkeys</h2><span className="settings-count">{state.passkeys.length}</span></div><p className="settings-muted">A faster, safer way to sign in. No password to remember.</p></div>
+        {canCreate && <button className="auth-button auth-button-primary settings-fit" type="button" disabled={busy || !!pending} onClick={() => requestChange({ type: 'add' })}>+ Add a passkey</button>}
+      </div>
+      {!canCreate && <p className="auth-hint">To create a passkey, use a supported browser on a device with a screen lock. You can still manage existing passkeys and verify with your password.</p>}
+      {state.passkeys.length === 0 ? <div className="passkey-empty"><PasskeyIcon className="w-10 h-10" /><h3>No passkeys yet</h3><p>Add a passkey to sign in with your fingerprint, face, device PIN, or security key.</p></div> : <ul className="passkey-list">{state.passkeys.map(key => <li key={key.id} className="passkey-row">
+        <div className="provider-icon">{key.providerIcon ? <img src={key.providerIcon} width="28" height="28" alt="" /> : <PasskeyIcon className="w-7 h-7" />}</div>
+        <div className="passkey-details"><h3>{key.name}</h3><p>{key.provider} · {key.backedUp ? 'Backed up' : 'Not backed up'}</p><p>Added {date(key.registeredAt)} · Last used: {date(key.lastUsedAt)}</p>
+          {editing === key.id && <form className="rename-form" onSubmit={event => { event.preventDefault(); requestChange({ type: 'rename', id: key.id, name: nickname.trim() }); }}>
+            <label htmlFor={`name-${key.id}`}>Passkey name</label><input id={`name-${key.id}`} value={nickname} onChange={event => setNickname(event.target.value)} maxLength={64} required disabled={busy || !!pending} autoFocus />
+            <button className="auth-link" type="submit" disabled={busy || !!pending || !nickname.trim()}>Save name</button><button className="auth-link" type="button" onClick={() => setEditing(null)} disabled={busy}>Cancel</button>
+          </form>}
+        </div>
+        <div className="passkey-actions"><button type="button" className="auth-link" aria-label={`Rename ${key.name}`} disabled={busy || !!pending} onClick={() => { setEditing(key.id); setNickname(key.name); }}>Rename</button><button type="button" className="auth-link danger-link" aria-label={`Remove ${key.name}`} disabled={busy || !!pending} onClick={() => requestChange({ type: 'delete', id: key.id, name: key.name })}>Remove</button></div>
+      </li>)}</ul>}
+      <div className="settings-note"><strong>Keep a way back in.</strong><p>Your password remains available as a backup. Passkeys can be saved in a password manager or on a security key. Your fingerprint and face data are never shared with The Times.</p></div>
+    </section>
+    <a className="auth-link" href={import.meta.env.BASE_URL}>← Back to the news</a>
+  </div>;
+}
