diff --git a/src/pages/api/auth/[...action].ts b/src/pages/api/auth/[...action].ts
new file mode 100644
index 0000000..a2a2674
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,143 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions } from '@simplewebauthn/server';
+import { accountState, AuthError, currentSession, passwordRequest, relyingParty, requireRecentVerification, requireUser, setSession, sessionCookie } from '../../../lib/auth-server';
+import { authStore, randomId } from '../../../lib/auth-store';
+import providers from '../../../data/aaguids.json';
+import { verifyPasskeyAssertion } from '../../../lib/passkey-verification';
+
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', 'Vary': 'Cookie' },
+});
+const text = (value: unknown, max = 100) => {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) throw new AuthError(400, 'Please check the information you entered.');
+  return value.trim();
+};
+
+export const ALL: APIRoute = async (context) => {
+  const { request, params, cookies, url } = context;
+  const store = authStore();
+  const action = params.action;
+  const { rpId, origin } = relyingParty(url);
+  try {
+    if (request.method === 'GET' && action === 'me') return json(accountState(context));
+    if (request.method !== 'POST') return json({ error: 'Method not allowed.' }, 405);
+    // Astro's global origin check is disabled in this sample, so protect every auth mutation here.
+    if (request.headers.get('Origin') !== origin) throw new AuthError(403, 'This request must come from this website.');
+    if (!request.headers.get('Content-Type')?.startsWith('application/json')) throw new AuthError(415, 'JSON is required.');
+    const raw = await request.text();
+    if (raw.length > 65536) throw new AuthError(413, 'Request too large.');
+    let body: Record<string, any>;
+    try { body = JSON.parse(raw); } catch { throw new AuthError(400, 'Invalid JSON.'); }
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new AuthError(400, 'Invalid request.');
+
+    if (action === 'login' || action === 'register') {
+      const username = text(body.username);
+      const password = typeof body.password === 'string' ? body.password : '';
+      if (!password || password.length > 1024) throw new AuthError(400, 'Enter your password.');
+      if (action === 'register') {
+        if (password.length < 8 || !/\d/.test(password)) throw new AuthError(400, 'Use at least 8 characters and a number.');
+        await passwordRequest('register', username, password);
+      }
+      // Only an authenticated password response may establish an account/session.
+      try { await passwordRequest('login', username, password); }
+      catch (error) {
+        if (action === 'register') throw new AuthError(409, 'Your account was created. Please sign in to continue and add a passkey.');
+        throw error;
+      }
+      const user = store.verifiedPasswordUser(username);
+      setSession(context, user.id, Date.now());
+      return json({ user });
+    }
+    if (action === 'logout') {
+      const session = currentSession(cookies);
+      if (session) store.deleteSession(session.id);
+      cookies.delete(sessionCookie, { path: import.meta.env.BASE_URL });
+      return json({ success: true });
+    }
+    if (action === 'password/reauthenticate') {
+      const { user, session } = requireUser(cookies);
+      if (typeof body.password !== 'string' || body.password.length > 1024) throw new AuthError(400, 'Enter your current password.');
+      await passwordRequest('login', user.username, body.password);
+      store.verifySession(session.id);
+      return json({ verified: true });
+    }
+    if (action === 'passkeys/register/options') {
+      const { user, session } = requireUser(cookies);
+      requireRecentVerification(session.verifiedAt);
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID: rpId,
+        userID: Buffer.from(user.id, 'base64url'), userName: user.username, userDisplayName: user.displayName,
+        attestationType: 'none',
+        excludeCredentials: store.passkeys(user.id).map(({ id, transports }) => ({ id, transports })),
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred', ...(body.promotion === true ? { authenticatorAttachment: 'platform' as const } : {}) },
+      });
+      const requestId = randomId();
+      store.saveChallenge({ id: requestId, sessionId: session.id, userId: user.id, kind: 'register', challenge: options.challenge, expiresAt: Date.now() + 300000, requireUV: false });
+      return json({ options, requestId });
+    }
+    if (action === 'passkeys/register/verify') {
+      const { user, session } = requireUser(cookies);
+      requireRecentVerification(session.verifiedAt);
+      const challenge = store.consumeChallenge(text(body.requestId), session.id, 'register');
+      if (!challenge || challenge.userId !== user.id) throw new AuthError(400, 'The passkey request expired. Please try again.');
+      let result;
+      try {
+        result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: challenge.requireUV });
+      } catch { throw new AuthError(400, 'We could not verify this passkey. Please try again.'); }
+      if (!result.verified || !result.registrationInfo) throw new AuthError(400, 'Passkey verification failed.');
+      const { credential, credentialDeviceType, credentialBackedUp, aaguid } = result.registrationInfo;
+      if (store.passkey(credential.id)) throw new AuthError(409, 'This passkey is already registered.');
+      const provider = aaguid === '00000000-0000-0000-0000-000000000000' ? undefined : (providers as Record<string, { name: string; icon_light?: string }>)[aaguid];
+      store.insertPasskey({ id: credential.id, userId: user.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+        transports: credential.transports || [], deviceType: credentialDeviceType, backedUp: credentialBackedUp,
+        name: provider?.name || 'My passkey', provider: provider?.name || 'Unknown passkey provider', providerIcon: provider?.icon_light,
+        aaguid, registeredAt: Date.now(), lastUsedAt: null });
+      return json(accountState(context));
+    }
+    const authenticationKind = action?.startsWith('passkeys/reauthenticate/') ? 'reauthenticate' : 'authenticate';
+    if (action === `passkeys/${authenticationKind}/options`) {
+      const active = authenticationKind === 'reauthenticate' ? requireUser(cookies) : undefined;
+      const session = active?.session || currentSession(cookies) || setSession(context);
+      const credentials = active ? store.passkeys(active.user.id) : [];
+      if (active && !credentials.length) throw new AuthError(400, 'No passkeys found. Verify with your password instead.');
+      const options = await generateAuthenticationOptions({ rpID: rpId,
+        allowCredentials: credentials.map(({ id, transports }) => ({ id, transports })),
+        userVerification: active ? 'required' : 'preferred',
+      });
+      const requestId = randomId();
+      store.saveChallenge({ id: requestId, sessionId: session.id, userId: active?.user.id || null, kind: authenticationKind, challenge: options.challenge, expiresAt: Date.now() + 300000, requireUV: !!active });
+      return json({ options, requestId });
+    }
+    if (action === `passkeys/${authenticationKind}/verify`) {
+      const session = currentSession(cookies);
+      if (!session) throw new AuthError(401, 'Your session expired. Please try again.');
+      const challenge = store.consumeChallenge(text(body.requestId), session.id, authenticationKind);
+      if (!challenge) throw new AuthError(400, 'The passkey request expired. Please try again.');
+      const id = text(body.credential?.id, 2048);
+      const passkey = store.passkey(id);
+      if (!passkey) throw new AuthError(404, 'This passkey is no longer registered. Sign in with your password and add a new passkey.');
+      const result = await verifyPasskeyAssertion({ response: body.credential, challenge, passkey, sessionUserId: session.userId, origin, rpId });
+      store.updatePasskey({ ...passkey, counter: result.authenticationInfo.newCounter, backedUp: result.authenticationInfo.credentialBackedUp, lastUsedAt: Date.now() }, passkey.counter);
+      if (authenticationKind === 'reauthenticate') store.verifySession(session.id);
+      else setSession(context, passkey.userId, result.authenticationInfo.userVerified ? Date.now() : 0);
+      return json({ verified: true, user: store.user(passkey.userId) });
+    }
+    if (action === 'passkeys/rename' || action === 'passkeys/delete' || action === 'profile') {
+      const { user, session } = requireUser(cookies);
+      requireRecentVerification(session.verifiedAt);
+      if (action === 'profile') store.renameUser(user.id, text(body.displayName));
+      else {
+        const passkey = store.passkey(text(body.id, 2048));
+        if (!passkey || passkey.userId !== user.id) throw new AuthError(404, 'Passkey not found.');
+        if (action === 'passkeys/delete') store.deletePasskey(passkey.id, user.id);
+        else store.updatePasskey({ ...passkey, name: text(body.name, 64) });
+      }
+      return json(accountState(context));
+    }
+    return json({ error: 'Not found.' }, 404);
+  } catch (error) {
+    if (error instanceof AuthError) return json({ error: error.message }, error.status);
+    console.error('Authentication operation failed', error instanceof Error ? error.name : 'UnknownError');
+    return json({ error: 'We could not complete this request. Please try again.' }, 500);
+  }
+};
