diff --git a/src/components/usePasskeySignIn.ts b/src/components/usePasskeySignIn.ts
new file mode 100644
index 0000000..7366248
--- /dev/null
+++ b/src/components/usePasskeySignIn.ts
@@ -0,0 +1,48 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { accountUrl, authenticatePasskey, authError, passkeyCapabilities } from '../lib/auth-client';
+
+export default function usePasskeySignIn() {
+  const [supported, setSupported] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const controller = useRef<AbortController | null>(null);
+  const capabilities = useRef<Record<string, boolean> | null>(null);
+  const mounted = useRef(false);
+  const startAutofill = useCallback(() => {
+    if (!mounted.current || !capabilities.current?.conditionalGet) return;
+    controller.current?.abort();
+    const active = new AbortController();
+    controller.current = active;
+    void authenticatePasskey(active.signal, true).then(() => {
+      if (!active.signal.aborted && mounted.current) window.location.assign(accountUrl);
+    }).catch(error => {
+      if (!active.signal.aborted && mounted.current && !(error instanceof DOMException && ['NotAllowedError', 'AbortError'].includes(error.name))) setError(authError(error));
+    });
+  }, []);
+  useEffect(() => {
+    mounted.current = true;
+    void passkeyCapabilities().then(value => {
+      if (!mounted.current) return;
+      capabilities.current = value;
+      setSupported(!!value);
+      startAutofill();
+    }).catch(() => { /* Password sign-in remains available. */ });
+    return () => { mounted.current = false; controller.current?.abort(); };
+  }, [startAutofill]);
+  function cancel() { controller.current?.abort(); }
+  async function signIn() {
+    cancel();
+    const active = new AbortController();
+    controller.current = active;
+    setLoading(true);
+    setError(null);
+    try {
+      await authenticatePasskey(active.signal);
+      if (!active.signal.aborted && mounted.current) window.location.assign(accountUrl);
+    } catch (error) {
+      if (mounted.current) setError(authError(error));
+      startAutofill();
+    } finally { if (mounted.current) setLoading(false); }
+  }
+  return { supported, loading, error, setError, signIn, cancel, startAutofill };
+}
