diff --git a/src/lib/auth-server.ts b/src/lib/auth-server.ts
new file mode 100644
index 0000000..1d93d1f
--- /dev/null
+++ b/src/lib/auth-server.ts
@@ -0,0 +1,58 @@
+import type { APIContext } from 'astro';
+import { authStore } from './auth-store';
+import { AuthError } from './auth-errors';
+export { AuthError } from './auth-errors';
+
+export const sessionCookie = 'devtools_session';
+export function relyingParty(url: URL) {
+  const origin = process.env.WEBAUTHN_ORIGIN || (url.hostname === 'localhost' ? url.origin : new URL(import.meta.env.SITE!).origin);
+  const rpId = process.env.WEBAUTHN_RP_ID || new URL(origin).hostname;
+  return { origin, rpId };
+}
+export function currentSession(cookies: APIContext['cookies']) {
+  const token = cookies.get(sessionCookie)?.value;
+  return token ? authStore().session(token) : undefined;
+}
+export function currentUser(cookies: APIContext['cookies']) {
+  const session = currentSession(cookies);
+  return session?.userId ? authStore().user(session.userId) : undefined;
+}
+export function setSession(context: Pick<APIContext, 'cookies' | 'url'>, userId: string | null = null, verifiedAt = 0) {
+  const old = currentSession(context.cookies);
+  const created = authStore().createSession(userId, verifiedAt);
+  context.cookies.set(sessionCookie, created.token, {
+    path: import.meta.env.BASE_URL, httpOnly: true, sameSite: 'lax',
+    secure: relyingParty(context.url).origin.startsWith('https:'), maxAge: 7 * 86400,
+  });
+  if (old) authStore().deleteSession(old.id);
+  return created.session;
+}
+export function requireUser(cookies: APIContext['cookies']) {
+  const session = currentSession(cookies);
+  const user = session?.userId ? authStore().user(session.userId) : undefined;
+  if (!session || !user) throw new AuthError(401, 'Please sign in to manage your account.');
+  return { session, user };
+}
+export function requireRecentVerification(verifiedAt: number) {
+  if (Date.now() - verifiedAt > 5 * 60000) throw new AuthError(403, 'Please verify your identity again before making this change.');
+}
+export function accountState(context: Pick<APIContext, 'cookies' | 'url'>) {
+  const user = currentUser(context.cookies);
+  const passkeys = user ? authStore().passkeys(user.id).map(({ publicKey, counter, userId, transports, deviceType, ...summary }) => summary) : [];
+  return { user: user || null, passkeys, rpId: relyingParty(context.url).rpId };
+}
+
+export async function passwordRequest(action: 'login' | 'register', username: string, password: string) {
+  let response: Response;
+  try {
+    response = await fetch(`https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+  } catch { throw new AuthError(503, 'The password service is unavailable. Please try again.'); }
+  if (!response.ok) {
+    throw new AuthError(action === 'login' ? 401 : 400, action === 'login'
+      ? 'The username or password was not accepted. Please try again.'
+      : 'Unable to create this account. Try another username and a password with at least 8 characters and a number.');
+  }
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..c2f197a
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,111 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { createHash, randomBytes } from 'node:crypto';
+import type { AccountUser, PasskeySummary } from './auth-types.ts';
+
+export interface StoredPasskey extends PasskeySummary {
+  userId: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: string;
+}
+export interface AuthSession {
+  id: string;
+  userId: string | null;
+  verifiedAt: number;
+  expiresAt: number;
+}
+export interface Challenge {
+  id: string;
+  sessionId: string;
+  userId: string | null;
+  kind: 'register' | 'authenticate' | 'reauthenticate';
+  challenge: string;
+  expiresAt: number;
+  requireUV: boolean;
+}
+
+export const randomId = () => randomBytes(32).toString('base64url');
+export const tokenHash = (token: string) => createHash('sha256').update(token).digest('hex');
+
+// Open lazily: building the application never opens or creates an auth database.
+export class AuthStore {
+  private db: DatabaseSync;
+  constructor(path: string) {
+    if (path !== ':memory:') mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    this.db = new DatabaseSync(path);
+    this.db.exec(`
+      PRAGMA journal_mode=WAL;
+      PRAGMA foreign_keys=ON;
+      PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, userId TEXT REFERENCES users(id), verifiedAt INTEGER NOT NULL, expiresAt INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), data TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(userId);
+      CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, sessionId TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE, data TEXT NOT NULL, expiresAt INTEGER NOT NULL);
+    `);
+  }
+  close() { this.db.close(); }
+  user(id: string): AccountUser | undefined {
+    return this.db.prepare('SELECT * FROM users WHERE id = ?').get(id) as unknown as AccountUser | undefined;
+  }
+  verifiedPasswordUser(username: string): AccountUser {
+    // Called only after the existing password service confirms this exact username.
+    this.db.prepare('INSERT OR IGNORE INTO users VALUES (?, ?, ?)').run(randomId(), username, username);
+    return this.db.prepare('SELECT * FROM users WHERE username = ?').get(username) as unknown as AccountUser;
+  }
+  renameUser(id: string, displayName: string) {
+    this.db.prepare('UPDATE users SET displayName = ? WHERE id = ?').run(displayName, id);
+  }
+  session(token: string): AuthSession | undefined {
+    return this.db.prepare('SELECT * FROM sessions WHERE id = ? AND expiresAt > ?').get(tokenHash(token), Date.now()) as unknown as AuthSession | undefined;
+  }
+  createSession(userId: string | null = null, verifiedAt = 0) {
+    const token = randomId();
+    const session: AuthSession = { id: tokenHash(token), userId, verifiedAt, expiresAt: Date.now() + 7 * 86400000 };
+    this.db.prepare('DELETE FROM challenges WHERE expiresAt <= ?').run(Date.now());
+    this.db.prepare('DELETE FROM sessions WHERE expiresAt <= ?').run(Date.now());
+    this.db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?)').run(session.id, userId, verifiedAt, session.expiresAt);
+    return { token, session };
+  }
+  deleteSession(id: string) { this.db.prepare('DELETE FROM sessions WHERE id = ?').run(id); }
+  verifySession(id: string) { this.db.prepare('UPDATE sessions SET verifiedAt = ? WHERE id = ?').run(Date.now(), id); }
+  saveChallenge(challenge: Challenge) {
+    this.db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?)').run(challenge.id, challenge.sessionId, JSON.stringify(challenge), challenge.expiresAt);
+  }
+  consumeChallenge(id: string, sessionId: string, kind: Challenge['kind']): Challenge | undefined {
+    // DELETE RETURNING consumes even invalid/expired attempts, preventing replay.
+    const row = this.db.prepare('DELETE FROM challenges WHERE id = ? AND sessionId = ? RETURNING data').get(id, sessionId) as { data: string } | undefined;
+    if (!row) return;
+    const challenge: Challenge = JSON.parse(row.data);
+    if (challenge.kind !== kind || challenge.expiresAt <= Date.now()) return;
+    return challenge;
+  }
+  passkey(id: string): StoredPasskey | undefined {
+    const row = this.db.prepare('SELECT data FROM passkeys WHERE id = ?').get(id) as { data: string } | undefined;
+    return row ? JSON.parse(row.data) : undefined;
+  }
+  passkeys(userId: string): StoredPasskey[] {
+    const rows = this.db.prepare('SELECT data FROM passkeys WHERE userId = ?').all(userId) as { data: string }[];
+    return rows.map(row => JSON.parse(row.data));
+  }
+  insertPasskey(passkey: StoredPasskey) {
+    this.db.prepare('INSERT INTO passkeys VALUES (?, ?, ?)').run(passkey.id, passkey.userId, JSON.stringify(passkey));
+  }
+  updatePasskey(passkey: StoredPasskey, expectedCounter?: number) {
+    // Compare the old record to avoid concurrent assertions overwriting a newer counter.
+    if (expectedCounter !== undefined) {
+      const result = this.db.prepare("UPDATE passkeys SET data = ? WHERE id = ? AND json_extract(data, '$.counter') = ?")
+        .run(JSON.stringify(passkey), passkey.id, expectedCounter);
+      if (!result.changes) throw new Error('Passkey changed; please try again.');
+    } else this.db.prepare('UPDATE passkeys SET data = ? WHERE id = ? AND userId = ?').run(JSON.stringify(passkey), passkey.id, passkey.userId);
+  }
+  deletePasskey(id: string, userId: string) {
+    this.db.prepare('DELETE FROM passkeys WHERE id = ? AND userId = ?').run(id, userId);
+  }
+}
+
+let store: AuthStore | undefined;
+export const authStore = () => store ??= new AuthStore(process.env.AUTH_DB_PATH || './data/auth.sqlite');
