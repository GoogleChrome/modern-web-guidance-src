@@ -0,0 +1,27 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export type AccountView = { username: string; created: string; hasPassword: boolean; passkeys: { id: string; name: string; created: string; lastUsed?: string; backedUp: boolean }[] };
+export async function authRequest(action: string, body?: unknown) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, { method: body === undefined ? 'GET' : 'POST', headers: { 'Content-Type': 'application/json' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  const result = await response.json();
+  if (!response.ok) throw new Error(result.error || 'Something went wrong. Please try again.');
+  return result;
+}
+export const supportsPasskeys = () => window.isSecureContext && browserSupportsWebAuthn();
+export async function authenticate(reauthenticate = false) {
+  const optionsJSON = await authRequest('authenticate-options', { reauthenticate });
+  const credential = await startAuthentication({ optionsJSON });
+  return authRequest('authenticate-verify', { credential });
+}
+export async function registerPasskey(username: string, name = 'My passkey') {
+  const optionsJSON = await authRequest('register-options', { username });
+  const credential = await startRegistration({ optionsJSON });
+  return authRequest('register-verify', { credential, name });
+}
+export function authError(error: unknown) {
+  if (error instanceof Error) {
+    if (error.name === 'NotAllowedError' || error.message.includes('timed out') || error.message.includes('cancelled')) return 'The passkey request was canceled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey for this account already exists on this device. Try signing in.';
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..ba5169b
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,35 @@
+import { mkdir, readFile, writeFile, rename } from 'node:fs/promises';
+import { randomUUID, scryptSync, timingSafeEqual } from 'node:crypto';
+import { resolve } from 'node:path';
+
+export type Passkey = { id: string; publicKey: string; counter: number; transports?: any[]; name: string; created: string; lastUsed?: string; backedUp: boolean };
+export type Account = { id: string; username: string; password?: string; created: string; passkeys: Passkey[] };
+const directory = resolve(process.env.AUTH_DATA_DIR || '.data');
+const file = resolve(directory, 'accounts.json');
+let queue: Promise<unknown> = Promise.resolve();
+export async function accounts(): Promise<Account[]> {
+  try { return JSON.parse(await readFile(file, 'utf8')); }
+  catch (error: any) { if (error.code === 'ENOENT') return []; throw error; }
+}
+export function updateAccounts<T>(change: (users: Account[]) => T | Promise<T>): Promise<T> {
+  const task = queue.then(async () => {
+    const users = await accounts();
+    const result = await change(users);
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const temporary = `${file}.${randomUUID()}.tmp`;
+    await writeFile(temporary, JSON.stringify(users), { mode: 0o600 });
+    await rename(temporary, file);
+    return result;
+  });
+  queue = task.catch(() => {});
+  return task;
+}
+export function hashPassword(password: string) {
+  const salt = randomUUID();
+  return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`;
+}
+export function checkPassword(password: string, stored?: string) {
+  if (!stored) return false;
+  const [salt, hash] = stored.split(':');
+  return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(hash, 'hex'));
+}
