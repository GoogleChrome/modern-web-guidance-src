+  return username ? <a className="header-account" href={`${import.meta.env.BASE_URL}account/settings`}><UserRound size={14} /> My account</a> : <><a href={`${import.meta.env.BASE_URL}signup`} data-skip-tracking="true" className="header-signup">Sign up</a><a href={`${import.meta.env.BASE_URL}signin`} data-skip-tracking="true" className="header-signin">Sign in <span aria-hidden="true">↗</span></a></>;
