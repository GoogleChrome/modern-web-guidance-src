@@ -0,0 +1,53 @@
+import { useEffect, useState } from 'react';
+import { ArrowRight, Check, ChevronRight, Eye, EyeOff, Fingerprint, KeyRound, LockKeyhole, ShieldCheck, Sparkles } from 'lucide-react';
+import { authenticate, authError, authRequest, registerPasskey, supportsPasskeys } from '../lib/auth-client';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [method, setMethod] = useState<'passkey' | 'password'>('passkey');
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [showPassword, setShowPassword] = useState(false);
+  const [supported, setSupported] = useState(true);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => { if (!supportsPasskeys()) { setSupported(false); setMethod('password'); } }, []);
+  async function submit(event: React.FormEvent) {
+    event.preventDefault(); setError(''); setLoading(true);
+    try {
+      if (method === 'passkey') signup ? await registerPasskey(username) : await authenticate();
+      else await authRequest('password', { username, password, register: signup });
+      window.location.assign(`${import.meta.env.BASE_URL}account/settings${signup ? '?welcome=1' : ''}`);
+    } catch (error) { setError(authError(error)); setLoading(false); }
+  }
+  return <div className="auth-page">
+    <div className="auth-breadcrumb"><a href={import.meta.env.BASE_URL}>Home</a><ChevronRight size={12} /><span>{signup ? 'Create an account' : 'Sign in'}</span></div>
+    <div className="auth-grid">
+      <aside className="auth-story">
+        <span className="eyebrow"><span className="tiny-line" /> YOUR WORLD. IN PERSPECTIVE.</span>
+        <h1>Good journalism.<br />One less<br /><em>password.</em></h1>
+        <p>A fresh perspective starts here. Get closer to the stories that matter, with a simpler, safer way to sign in.</p>
+        <div className="passkey-art" aria-hidden="true"><div className="art-orbit orbit-one" /><div className="art-orbit orbit-two" /><span className="art-spark spark-one">✦</span><span className="art-spark spark-two">✦</span><div className="fingerprint-tile"><Fingerprint strokeWidth={1.25} /><span className="art-check"><Check size={19} strokeWidth={3} /></span></div><span className="art-caption"><ShieldCheck size={14} /> A little less friction. A lot more security.</span></div>
+        <div className="story-note"><LockKeyhole size={16} /><span>Your fingerprint and face stay yours.<br /><strong>They’re never shared with us.</strong></span></div>
+      </aside>
+      <section className="auth-panel" aria-labelledby="auth-title">
+        <div className="auth-panel-top"><span className="small-label">THE DEVTOOLS TIMES ACCOUNT</span><span className="secure-label"><LockKeyhole size={11} /> Secure sign-in</span></div>
+        <h2 id="auth-title">{signup ? 'Make yourself at home.' : 'Welcome back.'}</h2>
+        <p className="auth-subtitle">{signup ? 'Your next great read is just around the corner.' : 'Your daily perspective is waiting for you.'}</p>
+        <div className="auth-tabs" aria-label="Sign-in method"><button type="button" aria-pressed={method === 'passkey'} disabled={!supported || loading} className={method === 'passkey' ? 'selected' : ''} onClick={() => { setMethod('passkey'); setError(''); }}><Fingerprint size={17} /> Passkey <span>RECOMMENDED</span></button><button type="button" aria-pressed={method === 'password'} disabled={loading} className={method === 'password' ? 'selected' : ''} onClick={() => { setMethod('password'); setError(''); }}><KeyRound size={16} /> Password</button></div>
+        {!supported && <p className="notice">Passkeys aren’t available in this browser. You can continue with a password.</p>}
+        {error && <div className="error-message" role="alert">{error}</div>}
+        <form onSubmit={submit} className="auth-form">
+          {(signup || method === 'password') && <label className="field-label" htmlFor="username">Username<input id="username" autoComplete="username" value={username} onChange={e => setUsername(e.target.value)} placeholder="Choose your username" minLength={3} maxLength={100} required disabled={loading} /></label>}
+          {method === 'passkey' ? <div className="passkey-intro"><span className="round-icon"><Fingerprint size={29} strokeWidth={1.5} /></span><h3>{signup ? 'Your account. Your key.' : 'You are your password.'}</h3><p>{signup ? 'Create a passkey to sign in with your fingerprint, face, or device PIN. No password to create or remember.' : 'Use your fingerprint, face, or device PIN to sign in. No password to remember, nothing to type.'}</p></div> : <label className="field-label" htmlFor="password">Password<div className="password-field"><input id="password" type={showPassword ? 'text' : 'password'} autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={e => setPassword(e.target.value)} minLength={signup ? 8 : undefined} maxLength={256} placeholder={signup ? 'Create a strong password' : 'Enter your password'} disabled={loading} required /><button type="button" aria-label={showPassword ? 'Hide password' : 'Show password'} onClick={() => setShowPassword(!showPassword)}>{showPassword ? <EyeOff size={17} /> : <Eye size={17} />}</button></div>{signup && <small>At least 8 characters, including a number.</small>}</label>}
+          <button className="primary-button" disabled={loading} data-skip-tracking="true" type="submit">{method === 'passkey' && <Fingerprint size={19} />}{loading ? 'Waiting for verification…' : method === 'passkey' ? (signup ? 'Create account with a passkey' : 'Sign in with a passkey') : signup ? 'Create account' : 'Sign in'}{!loading && <ArrowRight size={17} />}</button>
+          {method === 'passkey' && <p className="device-note"><LockKeyhole size={12} /> Your device will ask you to confirm it’s you.</p>}
+        </form>
+        <div className="auth-divider" />
+        <p className="auth-switch">{signup ? 'Already part of the story?' : 'New to The DevTools Times?'} <a href={`${import.meta.env.BASE_URL}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} <ArrowRight size={13} /></a></p>
+        <div className="passkey-explainer"><ShieldCheck size={20} /><div><strong>A smarter way to keep your account safe.</strong><p>Passkeys are encrypted, resistant to phishing, and securely stored in your password manager.</p><details><summary>How do passkeys work? <ChevronRight size={12} /></summary><p>Your device creates a unique key for this site. Unlock it with your fingerprint, face, or PIN. You can also use a security key or a passkey from your phone.</p></details></div></div>
+        <p className="auth-terms">By continuing, you agree to our <a href={`${import.meta.env.BASE_URL}legal/terms`}>Terms of Service</a><br />and acknowledge our <a href={`${import.meta.env.BASE_URL}legal/privacy`}>Privacy Policy</a>.</p>
+      </section>
+    </div>
+    <div className="auth-bottom"><span>Independent thinking. Informed reading.</span><span><ShieldCheck size={14} /> Your privacy comes first.</span></div>
+  </div>;
+}
