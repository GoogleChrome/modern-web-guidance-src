+.secure-label { display:flex; align-items:center; gap:4px; font-size:8px; color:#777f72; white-space:nowrap; }
+.auth-panel h2 { font-family:Georgia,'Times New Roman',serif; font-weight:400; font-size:31px; line-height:1.2; letter-spacing:-.8px; margin:0 0 9px; }
+.auth-subtitle { font-size:11px; color:#7b7d75; margin-bottom:26px; }
+.auth-tabs { display:flex; gap:4px; border:1px solid #e6e6e0; border-radius:6px; padding:4px; background:#f7f8f5; margin-bottom:21px; }
+.auth-tabs button { display:flex; justify-content:center; align-items:center; gap:6px; flex:1; padding:9px 4px; font-size:11px; border:1px solid transparent; border-radius:4px; color:#6e726a; cursor:pointer; }
+.auth-tabs .selected { background:white; color:#34543e; border-color:#dedfd7; box-shadow:0 1px 3px #00000009; }
+.auth-tabs button>span { font-size:6px; font-weight:700; letter-spacing:.3px; padding:3px 4px; background:#eaf0e4; color:#66795a; border-radius:3px; }
+.passkey-intro { text-align:center; padding:0 10px 21px; }.round-icon { display:inline-flex; justify-content:center; align-items:center; width:55px; height:55px; background:#f0f3e9; border:1px solid #e4e9db; border-radius:50%; color:#57704b; }
+.passkey-intro h3 { font-family:Georgia,'Times New Roman',serif; font-weight:400; font-size:20px; margin:13px 0 8px; }
+.passkey-intro p { font-size:11px; color:#7b7d75; line-height:1.8; max-width:280px; margin:auto; }
+.primary-button,.secondary-button { width:100%; display:flex; justify-content:center; align-items:center; gap:9px; font-size:11px; font-weight:600; padding:13px 15px; border-radius:4px; background:var(--account-green); color:white; border:1px solid var(--account-green); cursor:pointer; transition:background .15s; }
+.primary-button:hover { background:#173d2d; }.primary-button>svg:last-child { margin-left:auto; }.primary-button>svg:first-child:not(:last-child) { margin-left:auto; }
+button:disabled { opacity:.5; cursor:not-allowed; }.device-note { display:flex; align-items:center; justify-content:center; gap:5px; font-size:9px; color:#898c82; margin-top:11px; }
+.auth-divider { height:1px; background:#e9e9e3; margin:24px 0 20px; }.auth-switch { font-size:10px; text-align:center; color:#7a7c74; }.auth-switch a { display:inline-flex; align-items:center; gap:3px; color:#35523b; font-weight:600; }.auth-switch a:hover { text-decoration:underline; }
+.passkey-explainer { display:flex; align-items:flex-start; gap:9px; background:#f8f9f5; border:1px solid #e9ece1; border-radius:5px; padding:14px 12px; margin-top:23px; color:#6c7c5d; }.passkey-explainer>svg { flex-shrink:0; }.passkey-explainer strong { font-size:9px; color:#515e48; font-weight:600; }.passkey-explainer p { font-size:9px; line-height:1.8; color:#85897b; margin-top:4px; }.passkey-explainer summary { display:flex; gap:3px; align-items:center; font-size:9px; font-weight:600; margin-top:7px; cursor:pointer; }.passkey-explainer details[open] summary svg { transform:rotate(90deg); }
+.auth-terms { font-size:8px; line-height:1.8; color:#9a9b94; text-align:center; margin-top:21px; }.auth-terms a { text-decoration:underline; text-underline-offset:2px; color:#767a6e; }
+.auth-bottom { display:flex; justify-content:space-between; padding:0 0 32px; font-size:10px; color:#9b9d94; }.auth-bottom>span:last-child { display:flex; align-items:center; gap:6px; }
+.field-label { display:block; font-size:11px; color:#50594b; font-weight:600; margin-bottom:18px; }.field-label input { display:block; width:100%; padding:12px; background:white; border:1px solid #dce0d5; border-radius:4px; margin-top:7px; font-size:12px; color:#273622; font-weight:400; outline:none; }.field-label input:focus { border-color:#718a62; box-shadow:0 0 0 3px #718a621a; }.field-label input::placeholder { color:#a4a79c; }.field-label small { display:block; color:#8c9183; font-weight:400; font-size:9px; margin-top:7px; }.password-field { position:relative; }.password-field input { padding-right:40px; }.password-field button { position:absolute; top:12px; right:12px; color:#85907c; cursor:pointer; }
+.error-message,.notice,.success-message { font-size:11px; line-height:1.6; padding:12px; border-radius:5px; margin-bottom:16px; }.error-message { background:#fff0ec; border:1px solid #efd5cd; color:#984d3b; }.notice { color:#7b6a3e; background:#faf6e9; }.success-message { display:flex; align-items:center; gap:10px; color:#416143; background:#f1f6eb; border:1px solid #dce8d2; }.success-message button { margin-left:auto; cursor:pointer; }
+.header-signup,.header-signin,.header-account { font-size:10px; padding:7px 13px; border-radius:3px; font-weight:600; }.header-signup { background:#274735; color:white; }.header-signin { border:1px solid #d7dbd2; color:#4d5948; }.header-signin span { margin-left:7px; }.header-account { display:flex; gap:6px; align-items:center; background:#eef2e9; color:#35543c; }
+.settings-page { padding-bottom:48px; }.settings-heading { display:flex; justify-content:space-between; align-items:center; margin:14px 0 32px; }.settings-heading .eyebrow { color:#7d886e; font-size:8px; }.settings-heading h1 { font:36px Georgia,serif; letter-spacing:-1px; margin:11px 0; }.settings-heading p { font-size:12px; color:#888c80; }.back-link { display:flex; gap:7px; align-items:center; font-size:10px; color:#6e7e63; }
+.settings-grid { display:grid; grid-template-columns:195px 1fr; gap:33px; }.settings-nav { display:flex; flex-direction:column; align-items:flex-start; padding:8px 22px 0 0; border-right:1px solid #eaede4; }.account-avatar { border-radius:50%; width:45px; height:45px; background:#eef0e5; color:#697b56; font:24px Georgia,serif; display:grid; place-items:center; margin-bottom:13px; }.settings-nav>strong { font-size:13px; word-break:break-word; }.settings-nav>span { font-size:10px; color:#969a8c; margin:7px 0 26px; }.settings-nav>a,.settings-nav>button { display:flex; gap:9px; align-items:center; padding:13px 10px; border-radius:4px; font-size:11px; width:100%; text-align:left; color:#7a8170; cursor:pointer; }.settings-nav .active { background:#f0f3e9; color:#47603a; font-weight:600; }.settings-nav>a>svg:last-child:not(:first-child) { margin-left:auto; }.nav-note { border-top:1px solid #e6e9df; width:100%; display:flex; align-items:center; gap:9px; margin-top:35px; padding-top:21px; color:#929b82; font-size:10px; line-height:1.8; }
+.settings-content { min-width:0; }.settings-card { border:1px solid #e1e5d9; padding:25px; border-radius:6px; margin-bottom:21px; }.section-title { display:flex; align-items:center; gap:9px; color:#657557; padding-bottom:20px; border-bottom:1px solid #e9ece3; margin-bottom:23px; }.section-title h2 { color:#343c2c; font:21px Georgia,serif; }.secure-badge { display:flex; align-items:center; gap:4px; font-size:8px; border-radius:20px; background:#eff4e8; padding:5px 8px; color:#668350; margin-left:auto; }.profile-detail { display:flex; gap:70px; }.profile-detail strong { display:block; font-size:12px; font-weight:400; margin-top:9px; }.passkey-section-header { display:flex; align-items:center; gap:12px; }.passkey-section-header .round-icon { height:45px; width:45px; }.passkey-section-header h3 { font-size:15px; font-weight:600; }.passkey-section-header p { font-size:10px; color:#959b8b; margin-top:4px; }.count-badge { font-size:9px; color:#7b866f; background:#f4f6f0; border-radius:4px; padding:5px 8px; margin-left:auto; }.section-description { font-size:11px; color:#8b9281; line-height:1.8; margin-top:17px; }.empty-passkeys { display:flex; flex-direction:column; align-items:center; padding:29px 12px; background:#fafbf7; border:1px dashed #dce2d2; border-radius:5px; margin:22px 0 17px; color:#8b9c7a; }.empty-passkeys h4 { color:#5c6c4e; font-size:12px; margin:12px 0 6px; }.empty-passkeys p { font-size:10px; color:#959d89; }.add-passkey { width:auto; padding:11px 17px; font-size:10px; }.security-tip { display:flex; gap:9px; align-items:flex-start; margin-top:21px; padding:13px; background:#f6f8f1; border-radius:4px; color:#91a079; }.security-tip svg { flex-shrink:0; }.security-tip p { font-size:9px; line-height:1.8; color:#8b957e; }.security-tip strong { color:#6d7a5d; font-weight:600; }.password-status { display:flex; align-items:center; gap:12px; margin-top:25px; border-top:1px solid #e5e9de; padding-top:22px; color:#7b876a; }.password-status strong { font-size:12px; color:#55614a; font-weight:600; }.password-status p { font-size:10px; line-height:1.6; margin-top:4px; color:#8d9681; }.password-status>span { font-size:9px; margin-left:auto; }.settings-help { display:flex; justify-content:center; align-items:center; gap:9px; color:#9aa38e; font-size:9px; line-height:1.8; }.passkey-list { margin:17px 0; }.passkey-item { display:flex; align-items:center; gap:12px; padding:17px 0; border-bottom:1px solid #e9ece3; }.key-device { background:#f5f7f0; border:1px solid #e8ecde; border-radius:7px; padding:10px; color:#788967; }.passkey-item strong { display:block; font-size:12px; font-weight:600; word-break:break-word; }.passkey-item div>span,.passkey-item small { display:block; font-size:9px; margin-top:5px; color:#909985; }.key-actions { margin-left:auto; display:flex; gap:6px; }.key-actions button { padding:7px; color:#8b967c; cursor:pointer; border-radius:4px; }.key-actions button:hover { background:#f2f5eb; color:#4c6340; }
+.guest-card { max-width:480px; text-align:center; padding:48px 25px; margin:30px auto 60px; border:1px solid #e3e8da; border-radius:7px; }.guest-card h2 { font:26px Georgia,serif; margin:20px 0 13px; }.guest-card p { font-size:12px; color:#8a947b; line-height:1.8; margin:15px 0; }.guest-card .primary-button { width:260px; max-width:100%; margin:25px auto; }.guest-card p>a { text-decoration:underline; color:#526c43; }
+.account-dialog { margin:auto; max-width:420px; width:calc(100% - 32px); border:1px solid #e2e7d9; padding:34px; border-radius:10px; box-shadow:0 20px 100px #18201425; color:#38442e; }.account-dialog::backdrop { background:#18201466; backdrop-filter:blur(3px); }.dialog-close { position:absolute; right:14px; top:14px; color:#8e9881; cursor:pointer; }.account-dialog h2 { font:25px Georgia,serif; margin:20px 0 12px; }.account-dialog>p { font-size:12px; line-height:1.8; color:#8c957f; margin-bottom:22px; }.account-dialog .field-label { margin-bottom:20px; }.cancel-button { width:100%; margin-top:17px; font-size:11px; color:#8b957e; cursor:pointer; }.secondary-button { color:#5b714b; background:white; border-color:#dce4d1; }.verification-options>form { margin-top:22px; }.danger-button { background:#9a4d3e; border-color:#9a4d3e; }.danger-button:hover { background:#803e32; }
+button:focus-visible,a:focus-visible,summary:focus-visible { outline:2px solid #748c60; outline-offset:4px; }
+@media (min-width:1100px) { .auth-page { padding:0 74px; }.auth-story { padding:45px 43px 28px; }.auth-panel { padding:38px 38px 28px; } }
+@media (max-width:800px) { .auth-page,.settings-page { padding-left:24px; padding-right:24px; }.auth-story { padding:35px 25px 25px; }.auth-story h1 { font-size:45px; }.auth-panel { padding:32px 23px 25px; }.auth-panel-top { flex-wrap:wrap; }.auth-tabs button>span { display:none; }.settings-grid { grid-template-columns:150px 1fr; gap:20px; }.settings-nav { padding-right:12px; }.settings-card { padding:20px; }.profile-detail { gap:30px; }.key-device { display:none; } }
+@media (max-width:600px) { .auth-breadcrumb { padding:19px 0; }.auth-grid { grid-template-columns:1fr; }.auth-story { padding:25px; }.auth-story h1 { font-size:38px; margin:20px 0 12px; }.auth-story h1 br { display:none; }.auth-story h1 br::after { content:' '; }.auth-story h1 em { display:block; }.auth-story>p { max-width:none; font-size:12px; }.passkey-art,.story-note { display:none; }.auth-panel { padding:29px 25px; }.auth-panel-top { margin-bottom:21px; }.auth-bottom { font-size:8px; gap:15px; }.auth-tabs button>span { display:block; }.settings-heading { display:block; }.settings-heading h1 { font-size:31px; }.back-link { margin-top:20px; }.settings-grid { display:block; }.settings-nav { border:0; display:flex; flex-direction:row; flex-wrap:wrap; gap:5px; padding:0 0 15px; margin-bottom:20px; border-bottom:1px solid #e6ebdc; align-items:center; }.account-avatar { width:30px; height:30px; font-size:18px; margin:0 7px 0 0; }.settings-nav>span,.nav-note { display:none; }.settings-nav>strong { width:calc(100% - 50px); }.settings-nav>a,.settings-nav>button { width:auto; font-size:10px; padding:10px; margin-top:10px; }.profile-detail { gap:25px; flex-wrap:wrap; }.passkey-item { gap:6px; }.key-actions { gap:0; }.settings-card { padding:18px; }.settings-help { justify-content:flex-start; }.settings-help br { display:none; }.settings-heading p { line-height:1.7; }.password-status { gap:8px; }.password-status>span { font-size:8px; }.secure-badge { font-size:7px; }.section-title h2 { font-size:19px; } }
+@media (prefers-reduced-motion:reduce) { * { transition:none!important; } }
