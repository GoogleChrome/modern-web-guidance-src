+  const [password, setPassword] = useState('');
+  const [dialogError, setDialogError] = useState('');
+  const dialog = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    setSupported(supportsPasskeys());
+    authRequest('session').then(data => setAccount(data.account)).catch(e => setError(authError(e))).finally(() => setReady(true));
+    if (new URLSearchParams(window.location.search).has('welcome')) setNotice('Your account is ready. Welcome to The DevTools Times.');
+  }, []);
+  useEffect(() => { if (action) dialog.current?.showModal(); else dialog.current?.close(); }, [action]);
+  function open(next: Action) { setAction(next); setStep('edit'); setName(next.name || 'My passkey'); setPassword(''); setDialogError(''); }
+  async function execute() {
+    if (!action || !account) return;
+    if (action.type === 'add') { const result = await registerPasskey(account.username, name); setAccount(result.account); }
+    else { const result = await authRequest(action.type, { id: action.id, name }); setAccount(result.account); }
+    setNotice(action.type === 'add' ? 'Passkey added. Your next sign-in just got simpler.' : action.type === 'rename' ? 'Passkey name updated.' : 'Passkey removed from your account.');
+    setAction(null);
