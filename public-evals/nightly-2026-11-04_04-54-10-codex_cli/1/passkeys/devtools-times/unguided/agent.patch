+    <div className="settings-heading"><div><span className="eyebrow">YOUR DEVTOOLS TIMES</span><h1>Account settings</h1><p>A little housekeeping for a better reading experience.</p></div><a className="back-link" href={import.meta.env.BASE_URL}><ArrowLeft size={15} /> Back to the news</a></div>
+    {error && <p className="error-message" role="alert">{error}</p>}
+    {notice && <div className="success-message" role="status"><CheckCircle2 size={18} />{notice}<button aria-label="Dismiss message" onClick={() => setNotice('')}><X size={15} /></button></div>}
+    {!ready ? <div className="settings-card">Loading your account…</div> : !account ? <div className="guest-card"><span className="round-icon"><UserRound size={28} /></span><h2>Your account, all in one place.</h2><p>Sign in to manage your profile, passkeys, and account security.</p><a className="primary-button" href={`${import.meta.env.BASE_URL}signin`}>Sign in to your account <ArrowRight size={17} /></a><p>New here? <a href={`${import.meta.env.BASE_URL}signup`}>Create an account</a></p></div> : <div className="settings-grid">
+      <aside className="settings-nav"><div className="account-avatar">{account.username.charAt(0).toUpperCase()}</div><strong>{account.username}</strong><span>DevTools Times reader</span><a href="#profile"><UserRound size={17} /> Profile</a><a className="active" href="#security"><ShieldCheck size={17} /> Sign-in & security <ChevronRight size={14} /></a><button onClick={logout} disabled={busy}><LogOut size={17} /> Sign out</button><div className="nav-note"><LockKeyhole size={17} /><p>A secure account.<br />Peace of mind.</p></div></aside>
+      <div className="settings-content">
