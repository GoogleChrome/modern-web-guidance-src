index 0000000..95abd3e
--- /dev/null
+++ b/src/pages/api/auth/[action].ts
@@ -0,0 +1,139 @@
+import type { APIRoute } from 'astro';
+import { randomUUID } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { accounts, updateAccounts, hashPassword, checkPassword, type Account } from '../../../lib/auth-store';
+
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+const publicAccount = (account: Account) => ({ username: account.username, created: account.created, hasPassword: !!account.password, passkeys: account.passkeys.map(({ publicKey, counter, ...key }) => key) });
+export const ALL: APIRoute = async ({ request, session, params, url }) => {
+  if (!session) return json({ error: 'Account sessions are unavailable. Please try again.' }, 503);
+  const action = params.action;
+  try {
+    const users = await accounts();
+    const userId = await session.get('accountId') as string | undefined;
+    const user = users.find(u => u.id === userId);
+    if (request.method === 'GET' && action === 'session') return json({ account: user ? publicAccount(user) : null });
+    if (request.method !== 'POST') return json({ error: 'Method not allowed' }, 405);
+    if (request.headers.get('origin') !== url.origin) return json({ error: 'Invalid request origin.' }, 403);
+    const body = await request.json();
+    const origin = process.env.AUTH_ORIGIN || url.origin;
+    const rpID = new URL(origin).hostname;
+    const requireUser = () => { if (!user) throw new Error('Please sign in to continue.'); return user; };
+    const requireRecent = async () => { requireUser(); if (Date.now() - Number(await session.get('verifiedAt') || 0) > 300_000) throw new Error('Please verify your identity again.'); };
+    const signIn = async (account: Account) => {
+      await session.regenerate();
+      await session.set('accountId', account.id);
+      await session.set('verifiedAt', Date.now());
+      return json({ account: publicAccount(account) });
+    };
+    if (action === 'logout') { await session.destroy(); return json({ ok: true }); }
+    if (action === 'password') {
+      const attempts = await session.get('attempts') as { count: number; time: number } | undefined;
+      const active = attempts && Date.now() - attempts.time < 60_000 ? attempts : { count: 0, time: Date.now() };
+      if (active.count >= 8) return json({ error: 'Too many attempts. Please wait a minute.' }, 429);
+      await session.set('attempts', { ...active, count: active.count + 1 });
+      const username = String(body.username || '').trim().toLowerCase();
+      const password = String(body.password || '');
+      if (body.register) {
+        if (!/^[a-z0-9._@+-]{3,100}$/.test(username)) throw new Error('Use 3–100 letters, numbers, or email characters for your username.');
+        if (password.length < 8 || password.length > 256 || !/\d/.test(password)) throw new Error('Use at least 8 characters, including a number.');
+        const account = await updateAccounts(list => {
+          if (list.some(u => u.username === username)) throw new Error('That username is already taken. Try signing in.');
+          const account: Account = { id: randomUUID(), username, password: hashPassword(password), created: new Date().toISOString(), passkeys: [] };
+          list.push(account); return account;
+        });
+        return signIn(account);
+      }
+      let account = body.reauthenticate ? requireUser() : users.find(u => u.username === username);
+      // Existing Times readers can bring their account into the passkey-enabled store
+      // only after the original identity service has verified their password.
+      if (!account && !body.reauthenticate && username && password && password.length <= 256) {
+        const legacyResponse = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+          method: 'POST', headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(10_000),
+        }).catch(() => null);
+        if (legacyResponse?.ok) {
+          account = await updateAccounts(list => {
+            const existing = list.find(u => u.username === username);
+            if (existing) return existing;
+            const migrated: Account = { id: randomUUID(), username, password: hashPassword(password), created: new Date().toISOString(), passkeys: [] };
+            list.push(migrated); return migrated;
+          });
+        }
+      }
+      if (!account || password.length > 256 || !checkPassword(password, account.password)) throw new Error('The username or password is incorrect.');
+      if (body.reauthenticate) { await session.set('verifiedAt', Date.now()); return json({ ok: true }); }
+      return signIn(account);
+    }
+    if (action === 'register-options') {
+      let pendingUser = user;
+      if (user) await requireRecent();
+      else {
+        const username = String(body.username || '').trim().toLowerCase();
+        if (!/^[a-z0-9._@+-]{3,100}$/.test(username)) throw new Error('Enter a username with at least 3 characters.');
+        if (users.some(u => u.username === username)) throw new Error('That username is already taken. Try signing in.');
+        pendingUser = { id: randomUUID(), username, created: new Date().toISOString(), passkeys: [] };
+      }
+      const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID, userName: pendingUser!.username, userID: new TextEncoder().encode(pendingUser!.id), attestationType: 'none', excludeCredentials: pendingUser!.passkeys, authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+      await session.set('ceremony', { challenge: options.challenge, type: 'register', expires: Date.now() + 300_000, account: pendingUser });
+      return json(options);
+    }
+    if (action === 'authenticate-options') {
+      const account = body.reauthenticate ? requireUser() : undefined;
+      const options = await generateAuthenticationOptions({ rpID, userVerification: 'required', ...(account ? { allowCredentials: account.passkeys } : {}) });
+      await session.set('ceremony', { challenge: options.challenge, type: 'authenticate', expires: Date.now() + 300_000, userId: account?.id });
+      return json(options);
+    }
+    if (action === 'register-verify' || action === 'authenticate-verify') {
+      const ceremony = await session.get('ceremony') as any;
+      await session.delete('ceremony');
+      if (!ceremony || ceremony.expires < Date.now() || ceremony.type !== (action === 'register-verify' ? 'register' : 'authenticate')) throw new Error('This request expired. Please try again.');
+      if (action === 'register-verify') {
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: ceremony.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true });
+        if (!result.verified || !result.registrationInfo) throw new Error('Your passkey could not be verified.');
+        const info = result.registrationInfo;
+        const account = await updateAccounts(list => {
+          let account = list.find(u => u.id === ceremony.account.id);
+          if (account) { if (account.id !== user?.id) throw new Error('Please sign in again.'); }
+          else { if (list.some(u => u.username === ceremony.account.username)) throw new Error('That username is already taken.'); account = ceremony.account; list.push(account!); }
+          if (list.some(u => u.passkeys.some(k => k.id === info.credential.id))) throw new Error('This passkey is already registered.');
+          account!.passkeys.push({ ...info.credential, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'), name: String(body.name || 'My passkey').trim().slice(0, 60), created: new Date().toISOString(), backedUp: info.credentialBackedUp });
+          return account!;
+        });
+        return signIn(account);
+      }
+      const account = users.find(u => u.passkeys.some(k => k.id === body.credential.id));
+      const key = account?.passkeys.find(k => k.id === body.credential.id);
+      if (!account || !key || (ceremony.userId && ceremony.userId !== account.id)) throw new Error('This passkey is not recognized for this account.');
+      const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: ceremony.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true, credential: { ...key, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')) } });
+      if (!result.verified) throw new Error('Your passkey could not be verified.');
+      await updateAccounts(list => {
+        const saved = list.find(u => u.id === account.id)!.passkeys.find(k => k.id === key.id)!;
+        saved.counter = result.authenticationInfo.newCounter; saved.lastUsed = new Date().toISOString();
+      });
+      if (ceremony.userId) { await session.set('verifiedAt', Date.now()); return json({ ok: true }); }
+      return signIn(account);
+    }
+    if (action === 'rename' || action === 'remove') {
+      await requireRecent();
+      const account = await updateAccounts(list => {
+        const account = list.find(u => u.id === user!.id)!;
+        const key = account.passkeys.find(k => k.id === body.id);
+        if (!key) throw new Error('Passkey not found. Refresh and try again.');
+        if (action === 'remove') {
+          if (!account.password && account.passkeys.length === 1) throw new Error('Add another passkey before removing your last sign-in method.');
+          account.passkeys = account.passkeys.filter(k => k.id !== body.id);
+        } else {
+          const name = String(body.name || '').trim();
+          if (!name || name.length > 60) throw new Error('Use a name between 1 and 60 characters.');
+          key.name = name;
+        }
+        return account;
+      });
+      return json({ account: publicAccount(account) });
+    }
+    return json({ error: 'Unknown action.' }, 404);
+  } catch (error) {
+    return json({ error: error instanceof Error && !error.message.includes('Unexpected') ? error.message : 'Something went wrong. Please try again.' }, 400);
+  }
+};
