+        <button className={`primary-button ${action.type === 'remove' ? 'danger-button' : ''}`} type="submit">{action.type === 'remove' ? 'Continue to remove' : 'Continue'}<ArrowRight size={16} /></button>
+      </form> : <div className="verification-options">{!!account?.passkeys.length && supported && <button className="primary-button" disabled={busy} onClick={() => verify('passkey')}><Fingerprint size={18} />{busy ? 'Verifying…' : 'Verify with a passkey'}</button>}{account?.hasPassword && <form onSubmit={e => { e.preventDefault(); verify('password'); }}><label className="field-label">{account.passkeys.length ? 'Or use your password' : 'Confirm your password'}<input type="password" autoComplete="current-password" value={password} onChange={e => setPassword(e.target.value)} required disabled={busy} maxLength={256} autoFocus /></label><button className="secondary-button" disabled={busy} type="submit">{busy ? 'Verifying…' : 'Confirm with password'}<ArrowRight size={16} /></button></form>}{!account?.hasPassword && !supported && <p className="notice">Open this page in a browser that supports passkeys to verify your identity.</p>}</div>}
