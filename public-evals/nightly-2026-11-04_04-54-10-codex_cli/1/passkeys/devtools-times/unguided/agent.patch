+        <section className="settings-card" id="security"><div className="section-title"><ShieldCheck size={21} /><h2>Sign-in & security</h2><span className="secure-badge"><Check size={12} /> Protected</span></div><div className="passkey-section-header"><span className="round-icon"><Fingerprint size={25} /></span><div><h3>Passkeys</h3><p>A simpler, safer way to sign in.</p></div><span className="count-badge">{account.passkeys.length} added</span></div><p className="section-description">Skip the password. Use your fingerprint, face, or device PIN to securely access your account.</p>
+          {account.passkeys.length === 0 ? <div className="empty-passkeys"><KeyRound size={25} /><h4>Your next sign-in could be easier.</h4><p>Add your first passkey and leave passwords behind.</p></div> : <div className="passkey-list">{account.passkeys.map(key => <div className="passkey-item" key={key.id}><span className="key-device"><Monitor size={21} /></span><div><strong>{key.name}</strong><span>{key.backedUp ? 'Synced passkey' : 'Device passkey'} <span aria-hidden="true">·</span> Added {new Date(key.created).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span><small>{key.lastUsed ? `Last used ${new Date(key.lastUsed).toLocaleDateString()}` : 'Not used to sign in yet'}</small></div><div className="key-actions"><button aria-label={`Rename ${key.name}`} title="Rename passkey" onClick={() => open({ type: 'rename', id: key.id, name: key.name })}><Pencil size={16} /></button><button aria-label={`Remove ${key.name}`} title="Remove passkey" onClick={() => open({ type: 'remove', id: key.id, name: key.name })}><Trash2 size={16} /></button></div></div>)}</div>}
+          <button className="primary-button add-passkey" disabled={!supported || busy} onClick={() => open({ type: 'add' })}><Plus size={17} /> Add a passkey</button>{!supported && <p className="notice">Use a browser that supports passkeys over HTTPS to add a passkey.</p>}
