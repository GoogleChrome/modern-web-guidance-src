+import 'webauthn-polyfills';
+
+const $ = selector => document.querySelector(selector);
+const $$ = selector => [...document.querySelectorAll(selector)];
+const icon = name => `<svg class="icon" aria-hidden="true"><use href="#i-${name}"/></svg>`;
+const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
+const dialog = $('#account-dialog');
+const dialogContent = $('#dialog-content');
+let account = { user: null, passkeys: [], csrf: null, rpID: location.hostname };
+let available = false;
+let capabilities = {};
+let serviceAvailable = true;
+let currentPanel = 'security';
+let dialogType = '';
+let controller;
+let autofillController;
+let busy = false;
+let pendingAction;
+let toastTimer;
+
+async function api(path, body, method = 'POST', signal) {
+  let response;
+  try {
+    response = await fetch(`/api/${path}`, { method, credentials: 'same-origin', cache: 'no-store', signal, headers: { 'Content-Type': 'application/json', ...(account.csrf ? { 'X-CSRF-Token': account.csrf } : {}) }, ...(method === 'GET' ? {} : { body: JSON.stringify(body || {}) }) });
+  } catch (error) {
+    if (error.name === 'AbortError') throw error;
+    throw new Error('We couldn’t reach your account. Check your connection and try again.');
+  }
+  let result;
+  try { result = await response.json(); }
+  catch { throw new Error('The account service is unavailable. Please try again later.'); }
+  if (!response.ok) throw Object.assign(new Error(result.error || 'Something went wrong. Please try again.'), { status: response.status, code: result.code });
+  return result;
+}
+function toast(message, error = false) {
+  const element = $('#toast');
+  clearTimeout(toastTimer);
+  element.querySelector('p').textContent = message;
+  element.classList.toggle('error', error);
+  element.hidden = false;
+  toastTimer = setTimeout(() => { element.hidden = true; }, error ? 10000 : 6000);
+}
+function errorMessage(error) {
+  if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. You can try again whenever you’re ready.';
+  if (error.name === 'InvalidStateError') return 'A passkey for this account is already saved with this provider. Try a different device or security key.';
+  if (error.name === 'SecurityError') return 'Passkeys need a secure connection and the correct site address. Please check the URL and try again.';
+  if (error.name === 'NotSupportedError') return 'This device can’t create this passkey. Try a different browser, phone, or security key.';
+  return error.message || 'Something went wrong. Please try again.';
+}
+function showError(error) {
+  if (error.name === 'AbortError') return;
+  if (dialog.open) {
+    $('#dialog-error').textContent = errorMessage(error);
+    $('#dialog-error').hidden = false;
+  } else toast(errorMessage(error), true);
+}
+function setBusy(value) {
+  busy = value;
+  dialog.setAttribute('aria-busy', String(value));
+  dialog.querySelectorAll('button:not(.dialog-close),input').forEach(element => { element.disabled = value; });
+  dialog.querySelectorAll('button[type=submit]').forEach(button => {
+    if (value) { button.dataset.original = button.innerHTML; button.textContent = 'One moment…'; }
+    else if (button.dataset.original) { button.innerHTML = button.dataset.original; delete button.dataset.original; }
+  });
+}
+function stopPrompts() {
+  controller?.abort();
+  autofillController?.abort();
+}
+function openDialog(type, markup) {
+  stopPrompts();
+  setBusy(false);
+  dialogType = type;
+  dialogContent.innerHTML = markup;
+  dialogContent.querySelector('h2').id = 'dialog-title';
+  const initialControl = dialogContent.querySelector('input:not([type=checkbox])') || dialogContent.querySelector('button');
+  initialControl?.setAttribute('autofocus', '');
+  $('#dialog-error').hidden = true;
+  if (!dialog.open) dialog.showModal();
+  // showModal handles focus trapping; focus the first editable field on content switches.
+  initialControl?.focus();
+}
+function closeDialog() {
+  stopPrompts();
+  pendingAction = null;
+  dialog.close();
+}
+dialog.querySelector('.dialog-close').addEventListener('click', closeDialog);
+dialog.addEventListener('cancel', () => { stopPrompts(); pendingAction = null; });
+dialog.addEventListener('close', () => { stopPrompts(); dialogType = ''; dialog.returnValue = ''; setBusy(false); });
+$('#toast .icon-button').addEventListener('click', () => { $('#toast').hidden = true; });
+
+async function signalAccepted() {
+  if (!account.user || !window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try { await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpID, userId: account.user.id, allAcceptedCredentialIds: account.passkeys.map(key => key.id) }); } catch { /* Vault synchronization is best effort. */ }
+}
+async function signalProfile() {
+  if (!account.user || !window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try { await PublicKeyCredential.signalCurrentUserDetails({ rpId: account.rpID, userId: account.user.id, name: account.user.email, displayName: account.user.displayName }); } catch { /* Saving a profile must not depend on Signal API support. */ }
