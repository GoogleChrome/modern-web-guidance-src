+function applyAccount(next) {
+  account = next;
+  renderAccount();
+}
+const date = value => value ? new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value)) : 'Not used yet';
+function renderPasskeys() {
+  $('#passkey-count').textContent = account.passkeys.length;
+  if (!account.user || !account.passkeys.length) {
+    $('#passkey-list').innerHTML = `<div class="empty-state"><span class="empty-icon">${icon('key')}</span><div><h4>${account.user ? 'Your first passkey starts here.' : 'A fresh start for your sign-in.'}</h4><p>${account.user ? 'Add a passkey for a simpler, safer way to sign in.' : 'Sign in to see your saved passkeys,<br>or create an account to add your first one.'}</p></div></div>`;
+    return;
+  }
+  $('#passkey-list').innerHTML = account.passkeys.map(key => `<div class="passkey-row"><span class="provider-tile">${key.providerIcon ? `<img src="${escapeHTML(key.providerIcon)}" width="22" height="22" alt="">` : icon('key')}</span><div class="passkey-details"><strong>${escapeHTML(key.name)}</strong><span>${escapeHTML(key.provider)}${key.backedUp ? ' · Synced' : ''}<br>Added ${date(key.registeredAt)} · ${key.lastUsedAt ? `Last used ${date(key.lastUsedAt)}` : 'Not used yet'}</span></div><div class="row-actions"><button class="icon-button" data-rename="${escapeHTML(key.id)}" aria-label="Rename ${escapeHTML(key.name)}">${icon('edit')}</button><button class="icon-button danger-icon" data-delete="${escapeHTML(key.id)}" aria-label="Remove ${escapeHTML(key.name)}">${icon('trash')}</button></div></div>`).join('');
+}
+function renderAccount() {
+  const user = account.user;
+  const signedIn = !!user;
+  $('#sidebar-name').textContent = signedIn ? `Hello, ${user.displayName.split(' ')[0]}.` : 'Hello, coffee lover.';
+  $('#sidebar-subtitle').textContent = signedIn ? 'Make it a good daily.' : 'Your daily starts here.';
+  $('#avatar').innerHTML = signedIn ? escapeHTML(user.displayName.split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase()) : icon('user');
+  $('#sidebar-auth span').textContent = signedIn ? 'Sign out' : 'Sign in to your account';
+  $('#access-status').textContent = signedIn ? 'SIGNED IN SECURELY' : 'WELCOME IN';
+  if (signedIn) {
+    $('#access-content').innerHTML = `<div class="signedin-summary"><div><strong>${escapeHTML(user.displayName)}</strong><span>${escapeHTML(user.email)}</span></div><button class="text-button" data-action="signout">Sign out ${icon('logout')}</button></div><p>You’re all set. Your passkeys keep your account protected, without another password to remember.</p><div class="button-row"><button class="button" data-go="profile">${icon('user')}Update personal details</button><button class="button button-secondary" data-action="verify">${icon('shield')}Verify identity</button></div>`;
+  } else {
+    $('#access-content').innerHTML = `<p>Sign in with a passkey for a little less typing and a lot more peace of mind. New around here? Make yourself an account.</p><div class="button-row"><button class="button" id="signin-button" data-action="signin">${icon('key')}Sign in with a passkey</button><button class="button button-secondary" id="signup-button" data-action="signup">Create an account${icon('arrow')}</button></div>`;
+  }
+  renderPasskeys();
+  $('#profile-form').hidden = !signedIn;
+  $('#profile-gate').hidden = signedIn;
+  $('#profile-name').value = user?.displayName || '';
+  $('#profile-email').value = user?.email || '';
+  let preferences = {};
+  try { preferences = JSON.parse(user?.preferences || '{}'); } catch { /* Default to opt-out. */ }
+  $('#pref-news').checked = preferences.news === true;
+  $('#pref-offers').checked = preferences.offers === true;
+  $('#preferences-note').hidden = signedIn;
+  $('#overview-greeting').textContent = signedIn ? `Good to see you, ${user.displayName.split(' ')[0]}.` : 'Good things start here.';
+  const overviewButton = $('.overview-welcome button');
+  overviewButton.innerHTML = signedIn ? `Find your next favorite ${icon('arrow')}` : `Make yourself at home ${icon('arrow')}`;
+  overviewButton.dataset.action = signedIn ? 'menu' : 'signin';
+}
+function showPanel(name) {
+  currentPanel = name;
+  $$('.account-main>.panel').forEach(panel => { panel.hidden = panel.id !== `panel-${name}`; });
+  $$('.account-nav button').forEach(button => {
+    button.classList.toggle('active', button.dataset.panel === name);
