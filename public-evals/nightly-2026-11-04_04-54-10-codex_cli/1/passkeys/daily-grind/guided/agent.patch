+async function signalUnknown(id) {
+  if (!window.PublicKeyCredential?.signalUnknownCredential) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId: account.rpID, credentialId: id }); } catch { /* Browsers without the Signal API retain the provider entry. */ }
