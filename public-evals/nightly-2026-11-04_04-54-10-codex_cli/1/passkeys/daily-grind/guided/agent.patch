+        if (!key) fail(404, 'This passkey is no longer saved. Please use another passkey.');
+        if (kind === 'reauth' && (key.userId !== user.id || pending.userId !== user.id)) fail(403, 'Please use a passkey belonging to this account.');
+        if (body.credential.response?.userHandle && body.credential.response.userHandle !== key.userId) fail(403, 'This passkey belongs to a different account.');
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: pending.challenge, expectedOrigin: origin, expectedRPID: rpID, credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports }, requireUserVerification: pending.userVerification === 'required' });
+        requireLiveSession();
+        if (!result.verified) fail(401, 'Your identity could not be verified. Please try again.');
+        // Conditional update prevents concurrent assertions from rolling counters backward.
+        const current = credentialByID(key.id);
+        if (!current || current.counter !== key.counter) fail(409, 'Another sign-in completed. Please try again.');
+        saveKey({ ...current, counter: result.authenticationInfo.newCounter, credentialBackedUp: result.authenticationInfo.credentialBackedUp, lastUsedAt: now });
+        session.userId = key.userId; session.currentCredential = key.id; session.verifiedAt = result.authenticationInfo.userVerified ? now : 0;
+        rotate(); return send(snapshot());
+      }
+      if (req.method === 'PUT' && path === '/api/profile') {
+        requireFresh();
+        const displayName = text(body.displayName);
+        const address = email(body.email);
+        const existing = db.prepare('SELECT id FROM users WHERE email=?').get(address);
+        if (existing && existing.id !== user.id) fail(409, 'That email is already registered.');
+        db.prepare('UPDATE users SET email=?,displayName=? WHERE id=?').run(address, displayName, user.id);
+        return send(snapshot());
+      }
+      if (req.method === 'PUT' && path === '/api/preferences') {
+        requireUser();
+        const preferences = { news: body.news === true, offers: body.offers === true };
+        db.prepare('UPDATE users SET preferences=? WHERE id=?').run(JSON.stringify(preferences), user.id);
+        return send(snapshot());
+      }
+      const credentialRoute = /^\/api\/credentials\/([A-Za-z0-9_-]+)$/.exec(path);
+      if (credentialRoute && ['PUT', 'DELETE'].includes(req.method)) {
+        requireFresh();
+        const key = credentialByID(credentialRoute[1]);
+        if (!key || key.userId !== user.id) fail(404, 'Passkey not found.');
+        if (req.method === 'PUT') saveKey({ ...key, name: text(body.name, 60) });
+        else {
+          if (keysFor(user.id).length <= 1) fail(409, 'Add another passkey before removing your last one so you can still sign in.');
+          db.prepare('DELETE FROM credentials WHERE id=? AND userId=?').run(key.id, user.id);
+        }
+        return send(snapshot());
+      }
+      fail(404, 'This account endpoint was not found.');
+    } catch (error) {
+      if (!error.status) console.error('Account request failed:', error.message);
+      send({ error: error.status ? error.message : 'We could not verify this request. Please try again.', code: error.code }, error.status || 400);
+    }
+  };
+}
