+}
+function requirePasskeys() {
+  if (!serviceAvailable) { toast('The account service is unavailable. Please try again later.', true); return false; }
+  if (!available) { toast(window.isSecureContext ? 'Passkeys aren’t available in this browser. Try a current browser on your phone or computer.' : 'Passkeys need HTTPS or localhost. Open this site using a secure connection.', true); return false; }
+  return true;
+}
+function signInDialog() {
+  if (!requirePasskeys()) return;
+  if (account.user) { toast('You’re already signed in. Make yourself at home.'); return; }
+  openDialog('signin', `<p class="eyebrow">YOUR DAILY STARTS HERE</p><h2>Welcome back.</h2><p class="dialog-description">A familiar face. A favorite cup. Sign in with a passkey saved on your device or password manager.</p><form id="signin-form"><label for="signin-email">Email address <span class="optional">(optional)</span></label><input id="signin-email" name="username" type="email" autocomplete="username webauthn" placeholder="you@example.com"><p class="input-note">Choose a saved passkey below, or use autofill to find your account. No password needed.</p><button class="button" type="submit">${icon('key')}Sign in with a passkey</button></form><p class="dialog-switch">New to the neighborhood? <button type="button" data-dialog="signup">Create an account</button></p><p class="dialog-note">${icon('lock')}Your face and fingerprint stay on your device.</p>`);
+  $('#signin-form').addEventListener('submit', event => { event.preventDefault(); void explicitSignIn(); });
+  void startAutofill();
+}
+function signupDialog() {
