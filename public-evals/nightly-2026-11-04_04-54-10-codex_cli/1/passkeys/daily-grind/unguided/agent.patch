+/* Standalone, browser-local account implementation. See README.md for deployment scope. */
+(() => {
+  'use strict';
+  const STORAGE_KEY = 'daily-grind.accounts.v1';
+  const $ = (selector) => document.querySelector(selector);
+  const icon = (name) => `<svg aria-hidden="true"><use href="#i-${name}"/></svg>`;
+  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
+  const encode = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  const decode = value => Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/')), char => char.charCodeAt(0));
+  const random = () => crypto.getRandomValues(new Uint8Array(32));
+  const normalizeEmail = value => value.trim().toLowerCase();
+  const date = value => new Intl.DateTimeFormat(undefined, { month:'short', day:'numeric', year:'numeric' }).format(new Date(value));
+  let currentUser = null;
+  let section = 'overview';
+  let busy = false;
+  let dialogAction = null;
+  let verifiedAt = null;
+  let storageVersion = 0;
+
+  function readAccounts() {
+    let data;
+    try { data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
+    catch { throw new Error('Your browser account storage is unavailable or unreadable. Enable local storage, then try again.'); }
+    if (!Array.isArray(data) || data.some(user => !user || typeof user.id !== 'string' || typeof user.name !== 'string' || typeof user.email !== 'string' || !Array.isArray(user.passkeys) || user.passkeys.some(key => !key || typeof key.id !== 'string' || typeof key.publicKey !== 'string' || typeof key.name !== 'string'))) {
+      throw new Error('Your saved account data could not be read. Restore your browser data before continuing.');
+    }
+    return data;
+  }
+
+  function writeAccounts(accounts) {
+    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(accounts)); }
+    catch { throw new Error('Your changes could not be saved. Make sure browser storage is enabled and has free space.'); }
+  }
+
+  function updateUser(change) {
+    if (!currentUser) throw new Error('Please sign in again to continue.');
+    const accounts = readAccounts();
+    const user = accounts.find(account => account.id === currentUser.id);
+    if (!user) throw new Error('This account is no longer saved in this browser. Please sign in again.');
+    change(user, accounts);
+    writeAccounts(accounts);
+    currentUser = user;
+  }
+
+  function notice(message, error = false) {
+    $('#notice').textContent = message;
+    $('#notice').classList.toggle('error', error);
+    $('#notice').hidden = false;
+  }
+
+  function clearNotice() { $('#notice').hidden = true; }
+
+  function friendlyError(error) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was canceled or timed out. You can try again when you’re ready.';
+    if (error.name === 'InvalidStateError') return 'This passkey is already registered. Try signing in or use another authenticator.';
+    if (error.name === 'SecurityError') return 'Passkeys require HTTPS or localhost and a valid site domain. Open this page in a secure context.';
+    if (error.name === 'NotSupportedError') return 'Your browser or authenticator does not support the passkey options needed here. Try a current browser or another device.';
+    return error.message || 'Something went wrong. Please try again.';
+  }
+
+  async function runTask(task, inDialog = false) {
+    if (busy) return;
+    busy = true;
+    const buttons = [...document.querySelectorAll('button')].map(button => [button, button.disabled]);
+    buttons.forEach(([button]) => { button.disabled = true; });
+    const activeForm = inDialog ? $('#dialog-form') : (currentUser ? $('#member-view') : $('#auth-view'));
+    activeForm.setAttribute('aria-busy', 'true');
+    const submit = inDialog ? $('#confirm-dialog') : (currentUser ? activeForm.querySelector('button[type="submit"]') : activeForm.querySelector('[role="tabpanel"]:not([hidden])')?.querySelector('button[type="submit"]'));
+    const originalLabel = submit?.innerHTML;
+    if (submit) submit.textContent = 'Waiting for your device…';
+    clearNotice();
+    $('#dialog-error').hidden = true;
+    try { await task(); }
+    catch (error) {
+      if (inDialog && $('#action-dialog').open) {
+        $('#dialog-error').textContent = friendlyError(error);
+        $('#dialog-error').hidden = false;
+      } else notice(friendlyError(error), true);
+    } finally {
+      busy = false;
+      buttons.forEach(([button, disabled]) => { button.disabled = disabled; });
+      activeForm.removeAttribute('aria-busy');
+      if (submit?.isConnected) submit.innerHTML = originalLabel;
+    }
+  }
+
+  function ensurePasskeys() {
+    if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create || !crypto.subtle) {
+      throw new Error('Passkeys aren’t available here. Use a browser that supports passkeys over HTTPS or localhost.');
+    }
+  }
+
+  function verifyClientData(response, type, challenge) {
+    const client = JSON.parse(new TextDecoder().decode(response.clientDataJSON));
+    if (client.type !== type || client.challenge !== encode(challenge) || client.origin !== location.origin || client.crossOrigin === true) {
+      throw new Error('The passkey response could not be verified. Please try again from this site.');
+    }
+  }
+
+  async function verifyAuthenticatorData(buffer) {
+    const bytes = new Uint8Array(buffer);
+    const expectedHash = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(location.hostname)));
+    if (bytes.length < 37 || !expectedHash.every((byte, index) => byte === bytes[index]) || (bytes[32] & 5) !== 5) {
+      throw new Error('Your authenticator did not verify your identity. Please use a fingerprint, face, or device PIN.');
+    }
+  }
+
+  // WebAuthn ES256 signatures use ASN.1 DER; Web Crypto expects a 64-byte r || s pair.
+  function rawSignature(signature) {
+    const bytes = new Uint8Array(signature);
+    if (bytes[0] !== 0x30 || bytes[1] !== bytes.length - 2 || bytes[2] !== 0x02) throw new Error('Invalid passkey signature.');
+    const rLength = bytes[3];
+    const sOffset = 4 + rLength;
+    if (bytes[sOffset] !== 0x02) throw new Error('Invalid passkey signature.');
+    const sLength = bytes[sOffset + 1];
+    if (sOffset + 2 + sLength !== bytes.length) throw new Error('Invalid passkey signature.');
+    const result = new Uint8Array(64);
+    [bytes.slice(4, sOffset), bytes.slice(sOffset + 2)].forEach((part, index) => {
+      if (part.length === 33 && part[0] === 0) part = part.slice(1);
+      if (!part.length || part.length > 32) throw new Error('Invalid passkey signature.');
+      result.set(part, index * 32 + 32 - part.length);
+    });
+    return result;
+  }
+
+  async function createPasskey(user, name) {
+    ensurePasskeys();
+    const version = storageVersion;
+    const challenge = random();
+    const credential = await navigator.credentials.create({publicKey: {
+      challenge,
+      rp: { name:'The Daily Grind', id:location.hostname },
+      user: { id:decode(user.id), name:user.email, displayName:user.name },
+      pubKeyCredParams: [{type:'public-key', alg:-7}],
+      authenticatorSelection: { residentKey:'required', userVerification:'required' },
+      excludeCredentials: user.passkeys.map(key => ({type:'public-key', id:decode(key.id), transports:key.transports})),
+      timeout:60000,
+      attestation:'none'
+    }});
+    if (!credential) throw new Error('No passkey was created. Please try again.');
+    verifyClientData(credential.response, 'webauthn.create', challenge);
+    const response = credential.response;
+    if (!response.getPublicKey || !response.getAuthenticatorData || response.getPublicKeyAlgorithm?.() !== -7) {
+      throw new Error('This browser cannot export the public key needed to verify sign-ins. Please use a current browser.');
+    }
+    await verifyAuthenticatorData(response.getAuthenticatorData());
+    const publicKey = response.getPublicKey();
+    if (!publicKey) throw new Error('Your device did not return a usable public key. Please try another authenticator.');
+    if (version !== storageVersion) throw new Error('Account data changed in another tab. Please try again.');
+    return { id:encode(credential.rawId), publicKey:encode(publicKey), name, transports:response.getTransports?.() || [], createdAt:Date.now(), lastUsedAt:null };
+  }
+
+  async function authenticate(user = null, email = '') {
+    ensurePasskeys();
+    const version = storageVersion;
+    const accounts = readAccounts();
+    const candidates = user ? accounts.filter(account => account.id === user.id) : email ? accounts.filter(account => account.email === email) : accounts;
+    if (!candidates.length) throw new Error(email ? 'No account with that email is saved in this browser. Create an account here first.' : 'No account is saved in this browser yet. Create an account to get started.');
+    const challenge = random();
+    const credential = await navigator.credentials.get({ publicKey: {
+      challenge, rpId:location.hostname, userVerification:'required', timeout:60000,
+      allowCredentials:candidates.flatMap(account => account.passkeys.map(key => ({type:'public-key', id:decode(key.id), transports:key.transports})))
+    }});
+    if (!credential) throw new Error('No passkey was returned. Please try again.');
+    const id = encode(credential.rawId);
+    const owner = candidates.find(account => account.passkeys.some(key => key.id === id));
+    const saved = owner?.passkeys.find(key => key.id === id);
+    if (!saved) throw new Error('This passkey does not belong to an account saved in this browser.');
+    verifyClientData(credential.response, 'webauthn.get', challenge);
+    await verifyAuthenticatorData(credential.response.authenticatorData);
+    if (credential.response.userHandle && encode(credential.response.userHandle) !== owner.id) throw new Error('The passkey account could not be verified.');
+    const key = await crypto.subtle.importKey('spki', decode(saved.publicKey), {name:'ECDSA', namedCurve:'P-256'}, false, ['verify']);
+    const authData = new Uint8Array(credential.response.authenticatorData);
+    const clientHash = new Uint8Array(await crypto.subtle.digest('SHA-256', credential.response.clientDataJSON));
+    const signedData = new Uint8Array(authData.length + clientHash.length);
+    signedData.set(authData); signedData.set(clientHash, authData.length);
+    const valid = await crypto.subtle.verify({name:'ECDSA', hash:'SHA-256'}, key, rawSignature(credential.response.signature), signedData);
+    if (!valid) throw new Error('The passkey signature could not be verified. Please try another saved passkey.');
+    if (version !== storageVersion) throw new Error('Account data changed in another tab. Please sign in again.');
+    // Reload before writing so unrelated account changes from another tab are retained.
+    const latest = readAccounts();
+    const latestOwner = latest.find(account => account.id === owner.id);
+    const latestKey = latestOwner?.passkeys.find(passkey => passkey.id === id && passkey.publicKey === saved.publicKey);
+    if (!latestKey) throw new Error('This passkey was removed while signing in. Please try again.');
+    latestKey.lastUsedAt = Date.now();
+    writeAccounts(latest);
+    verifiedAt = Date.now();
+    return latestOwner;
+  }
+
+  function authTab(tab) {
