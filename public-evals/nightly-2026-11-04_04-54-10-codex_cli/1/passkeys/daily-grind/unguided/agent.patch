+    } else {
+      $('#member-view').innerHTML = `<section class="member-card"><div class="card-heading"><div><div class="member-eyebrow">A LITTLE PEACE OF MIND</div><h3>Passkeys & security.</h3></div><button class="primary-button" data-action="add">${icon('plus')}Add a passkey</button></div><p class="muted">Your keys to a better morning. Keep a backup for peace of mind.</p><ul class="passkey-list">${currentUser.passkeys.map(key => `<li class="passkey-row">${icon('key')}<div class="passkey-meta"><strong>${escapeHtml(key.name)}</strong><small>Added ${date(key.createdAt)} · ${key.lastUsedAt ? `Used ${date(key.lastUsedAt)}` : 'Not used yet'}</small></div><div class="passkey-controls"><button data-action="rename" data-id="${escapeHtml(key.id)}" aria-label="Rename ${escapeHtml(key.name)}">Rename</button><button data-action="remove" data-id="${escapeHtml(key.id)}" ${currentUser.passkeys.length === 1 ? 'disabled title="Add another passkey before removing your last one"' : ''} aria-label="Remove ${escapeHtml(key.name)}">Remove</button></div></li>`).join('')}</ul><p class="small-note">Keep at least one passkey to access your account. Removing a passkey here revokes its access to this browser account; you can also delete it from your device’s password manager.</p><button class="secondary-button" data-action="reauth">${icon('shield')}Verify your identity</button></section>`;
+    }
+  }
+
+  function openDialog({ title, description, fields = '', confirm = 'Continue', action }) {
+    if (busy) return;
+    $('#dialog-title').textContent = title;
+    $('#dialog-description').textContent = description;
