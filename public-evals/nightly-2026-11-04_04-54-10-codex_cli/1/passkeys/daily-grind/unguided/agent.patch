diff --git a/tests/account.test.cjs b/tests/account.test.cjs
new file mode 100644
index 0000000..8f7c8c9
--- /dev/null
+++ b/tests/account.test.cjs
@@ -0,0 +1,180 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { webcrypto } = require('node:crypto');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const source = readFileSync(require('node:path').join(__dirname, '../account.js'), 'utf8');
+const b64 = value => Buffer.from(value).toString('base64url');
+const hash = value => webcrypto.subtle.digest('SHA-256', value);
+function derSignature(raw) {
+  const integer = bytes => {
+    while (bytes.length > 1 && bytes[0] === 0) bytes = bytes.slice(1);
+    if (bytes[0] & 128) bytes = Buffer.concat([Buffer.from([0]), bytes]);
+    return Buffer.concat([Buffer.from([2, bytes.length]), bytes]);
+  };
+  const pair = Buffer.concat([integer(Buffer.from(raw).subarray(0, 32)), integer(Buffer.from(raw).subarray(32))]);
+  return Buffer.concat([Buffer.from([48, pair.length]), pair]);
+}
+
+class Element {
+  constructor() { this.listeners = {}; this.attributes = {}; this.dataset = {}; this.hidden = false; this.disabled = false; this.value = ''; this.textContent = ''; this.innerHTML = ''; this.isConnected = true; this.open = false; this.classList = { toggle() {} }; }
+  addEventListener(type, callback) { (this.listeners[type] ||= []).push(callback); }
+  setAttribute(key, value) { this.attributes[key] = value; }
+  removeAttribute(key) { delete this.attributes[key]; }
+  querySelector() { return new Element(); }
+  showModal() { this.open = true; }
+  close() { this.open = false; }
+  focus() {}
+  reset() {}
+  closest() { return this; }
+  dispatch(type, extra = {}) { for (const callback of this.listeners[type] || []) callback({ preventDefault() {}, target: this, ...extra }); }
+}
+
+function harness() {
+  const elements = new Map();
+  const el = selector => { if (!elements.has(selector)) elements.set(selector, new Element()); return elements.get(selector); };
+  const authTabs = ['signin', 'register'].map(name => Object.assign(el(`#${name}-tab`), { dataset: { auth:name } }));
+  const sections = ['overview', 'passkeys', 'profile'].map(name => Object.assign(new Element(), { dataset: { section:name } }));
+  const switchButton = Object.assign(new Element(), { dataset:{switch:'register'} });
+  const data = new Map();
+  const credentials = new Map();
+  const windowEvents = {};
+  let corruption = null;
+  const authenticators = {
+    async create({ publicKey: options }) {
+      const pair = await webcrypto.subtle.generateKey({name:'ECDSA', namedCurve:'P-256'}, true, ['sign', 'verify']);
+      const rawId = webcrypto.getRandomValues(new Uint8Array(32));
+      const publicKey = await webcrypto.subtle.exportKey('spki', pair.publicKey);
+      const authData = new Uint8Array(37);
+      authData.set(new Uint8Array(await hash(new TextEncoder().encode('coffee.example'))));
+      authData[32] = 5;
+      credentials.set(b64(rawId), { pair, options, rawId });
+      return { rawId, response:{
+        clientDataJSON:new TextEncoder().encode(JSON.stringify({type:'webauthn.create', challenge:b64(options.challenge), origin:'https://coffee.example'})),
+        getPublicKey:() => publicKey,
+        getPublicKeyAlgorithm:() => -7,
+        getAuthenticatorData:() => authData,
+        getTransports:() => ['internal']
+      }};
+    },
+    async get({ publicKey: options }) {
+      if (corruption === 'cancel') { const error = new Error(); error.name = 'NotAllowedError'; throw error; }
+      const record = options.allowCredentials.map(key => credentials.get(b64(key.id))).find(Boolean);
+      assert.ok(record, 'a registered credential must be requested');
+      const clientDataJSON = new TextEncoder().encode(JSON.stringify({type:'webauthn.get', challenge:corruption === 'challenge' ? 'wrong' : b64(options.challenge), origin:corruption === 'origin' ? 'https://attacker.example' : 'https://coffee.example'}));
+      const authData = new Uint8Array(37);
+      authData.set(new Uint8Array(await hash(new TextEncoder().encode(corruption === 'rp' ? 'attacker.example' : 'coffee.example'))));
+      authData[32] = corruption === 'verification' ? 1 : 5;
+      const signedData = Buffer.concat([Buffer.from(authData), Buffer.from(await hash(clientDataJSON))]);
+      const signature = derSignature(await webcrypto.subtle.sign({name:'ECDSA', hash:'SHA-256'}, record.pair.privateKey, signedData));
+      if (corruption === 'signature') signature[signature.length - 1] ^= 1;
+      return {rawId:record.rawId, response:{clientDataJSON, authenticatorData:authData, signature, userHandle:corruption === 'user' ? new Uint8Array(32) : record.options.user.id}};
+    }
+  };
+  const context = {
+    document: {
+      querySelector:el,
+      querySelectorAll:selector => selector === '[data-auth]' ? authTabs : selector === '[data-section]' ? sections : selector === '[data-switch]' ? [switchButton] : [...elements.values()]
+    },
+    window: {isSecureContext:true, PublicKeyCredential:class {}, addEventListener:(type, fn) => { windowEvents[type] = fn; }},
+    navigator:{ credentials:authenticators },
+    location:{hostname:'coffee.example', origin:'https://coffee.example'},
+    localStorage:{getItem:key => data.get(key) || null, setItem:(key, value) => data.set(key, value)},
+    crypto:webcrypto, TextEncoder, TextDecoder, Uint8Array, Date, Intl, JSON,
+    btoa:value => Buffer.from(value, 'binary').toString('base64'),
+    atob:value => Buffer.from(value, 'base64').toString('binary')
+  };
+  vm.runInNewContext(source, context);
+  const settle = async () => {
+    const deadline = Date.now() + 3000;
+    while ([...elements.values()].some(element => element.attributes['aria-busy'])) {
+      if (Date.now() > deadline) throw new Error('Operation did not finish');
+      await new Promise(resolve => setImmediate(resolve));
+    }
+  };
+  const clickMember = async (action, id) => {
+    const button = Object.assign(new Element(), {dataset:{action, id}});
+    el('#member-view').dispatch('click', {target:button});
+    await settle();
+  };
+  const confirm = async () => { el('#dialog-form').dispatch('submit'); await settle(); };
+  const accounts = () => JSON.parse(data.get('daily-grind.accounts.v1') || '[]');
+  const register = async () => {
+    el('#register-name').value = 'Alex Morgan';
+    el('#register-email').value = 'Alex@Example.com';
+    el('#register-key-name').value = 'My laptop';
+    el('#register-form').dispatch('submit'); await settle();
+    assert.equal(accounts().length, 1);
+  };
+  const signout = () => el('#signout').dispatch('click');
+  const signin = async () => { el('#signin-form').dispatch('submit'); await settle(); };
+  return { el, accounts, register, signin, signout, clickMember, confirm, settle, sections, windowEvents, corrupt:value => {corruption = value;} };
+}
+
+test('registration, verified sign-in, profile updates, passkey management, reauthentication, and sign-out', async () => {
+  const app = harness();
+  await app.register();
+  assert.equal(app.accounts()[0].email, 'alex@example.com');
+  assert.equal(app.el('#auth-view').hidden, true);
+  app.signout();
+  assert.equal(app.el('#member-view').hidden, true);
+  await app.signin();
+  assert.equal(app.el('#member-view').hidden, false);
+  assert.ok(app.accounts()[0].passkeys[0].lastUsedAt);
+  await app.clickMember('add');
+  app.el('#key-name').value = 'My phone';
+  await app.confirm();
+  assert.equal(app.accounts()[0].passkeys.length, 2);
+  const secondId = app.accounts()[0].passkeys[1].id;
+  await app.clickMember('rename', secondId);
+  app.el('#key-name').value = 'Backup key';
+  await app.confirm();
+  assert.equal(app.accounts()[0].passkeys[1].name, 'Backup key');
+  app.sections[2].dispatch('click');
+  app.el('#profile-name').value = 'Alex Updated';
+  app.el('#profile-email').value = 'new@example.com';
+  app.el('#member-view').dispatch('submit', {target:{id:'profile-form'}});
+  await app.confirm();
+  assert.equal(app.accounts()[0].name, 'Alex Updated');
+  assert.equal(app.accounts()[0].email, 'new@example.com');
+  await app.clickMember('reauth'); await app.confirm();
+  assert.match(app.el('#notice').textContent, /Identity confirmed/);
+  await app.clickMember('remove', secondId); await app.confirm();
+  assert.equal(app.accounts()[0].passkeys.length, 1);
+  await app.clickMember('remove', app.accounts()[0].passkeys[0].id);
+  assert.match(app.el('#notice').textContent, /Add another passkey/);
+  assert.equal(app.accounts()[0].passkeys.length, 1);
+  app.signout(); await app.signin();
+  assert.equal(app.el('#member-view').hidden, false);
+  app.windowEvents.storage({key:'daily-grind.accounts.v1'});
+  assert.equal(app.el('#member-view').hidden, true);
+});
+
+for (const corruption of ['challenge', 'origin', 'rp', 'verification', 'signature', 'user', 'cancel']) {
+  test(`rejects ${corruption} failures without signing in`, async () => {
+    const app = harness(); await app.register(); app.signout(); app.corrupt(corruption);
+    await app.signin();
+    assert.equal(app.el('#member-view').hidden, true);
+    assert.equal(app.el('#notice').hidden, false);
+    assert.equal(app.accounts()[0].passkeys[0].lastUsedAt, null);
+  });
+}
+
+test('canceled reauthentication leaves a profile unchanged and allows retry', async () => {
+  const app = harness(); await app.register();
+  app.el('#profile-name').value = 'Changed'; app.el('#profile-email').value = 'changed@example.com';
+  app.el('#member-view').dispatch('submit', {target:{id:'profile-form'}});
+  app.corrupt('cancel'); await app.confirm();
+  assert.equal(app.accounts()[0].name, 'Alex Morgan');
+  assert.equal(app.el('#action-dialog').open, true);
+  app.corrupt(null); await app.confirm();
+  assert.equal(app.accounts()[0].name, 'Changed');
+});
+
+test('duplicate registration does not overwrite the saved account', async () => {
+  const app = harness(); await app.register(); app.signout();
+  app.el('#register-form').dispatch('submit'); await app.settle();
+  assert.equal(app.accounts().length, 1);
+  assert.match(app.el('#notice').textContent, /already saved/);
+});
