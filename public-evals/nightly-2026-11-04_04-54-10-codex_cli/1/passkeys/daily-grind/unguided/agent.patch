+  $('#learn-passkeys').addEventListener('click', () => openDialog({title:'A familiar gesture. A safer sign-in.', description:'A passkey replaces a password with a cryptographic key. Your device or password manager keeps the private key; this browser stores only the public key. Use your face, fingerprint, or PIN to sign in. This standalone site stores account details locally, so an existing account can only be accessed in the browser where it was created. Clearing site data removes that account. A production service would need a server to share accounts across browsers.', confirm:'Got it'}));
+  $('#dialog-form').addEventListener('submit', event => { event.preventDefault(); if (!dialogAction) { closeDialog(); return; } runTask(dialogAction, true); });
+  $('#close-dialog').addEventListener('click', closeDialog);
+  $('#cancel-dialog').addEventListener('click', closeDialog);
+  $('#action-dialog').addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  window.addEventListener('storage', event => {
+    if (event.key !== STORAGE_KEY && event.key !== null) return;
+    storageVersion += 1;
+    if (currentUser) {
+      // A different tab changed account security state. End the in-memory session.
+      currentUser = null; verifiedAt = null;
+      $('#action-dialog').close(); render();
+      notice('Account data changed in another tab. Please sign in again.', true);
+    }
+  });
+  try { readAccounts(); ensurePasskeys(); }
+  catch (error) { $('#support-warning').textContent = friendlyError(error); $('#support-warning').hidden = false; }
+  render();
+})();
