+  <script>
+    // Keep the scroll hints available in browsers without scroll-state queries.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.reviews-scroller');
+      const topSentinel = scroller.querySelector('.sentinel-top');
+      const bottomSentinel = scroller.querySelector('.sentinel-bottom');
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          const className = entry.target === topSentinel
+            ? 'scrolled-down'
+            : 'can-scroll-down';
+          scroller.classList.toggle(className, entry.intersectionRatio < 1);
+        }
+      }, { root: scroller, threshold: [0, 1] });
+
+      observer.observe(topSentinel);
+      observer.observe(bottomSentinel);
+    }
+  </script>
