@@ -26,8 +26,72 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+      container-name: page-scroll;
+      padding-bottom: 6rem;
+    }
+
+    .scroll-sentinel {
+      width: 0;
+      height: 0;
+      visibility: hidden;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: 1.25rem;
+      bottom: 1.25rem;
+      z-index: 1001;
+      border: 0;
+      border-radius: 999px;
+      padding: 0.85rem 1.25rem;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      box-shadow: 0 4px 14px rgb(0 0 0 / 20%);
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition: visibility 0.3s, opacity 0.3s ease, translate 0.3s ease;
+    }
+
+    .back-to-top:hover {
+      background: var(--text);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @container page-scroll scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    .scroller.scrolled .back-to-top {
+      visibility: visible;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        translate: none;
+        transition: none;
+      }
+    }
