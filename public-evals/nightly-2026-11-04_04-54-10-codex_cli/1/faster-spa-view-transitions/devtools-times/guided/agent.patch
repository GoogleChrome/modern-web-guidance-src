diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..d1bddf7
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,132 @@
+import type {
+  TransitionBeforePreparationEvent,
+  TransitionBeforeSwapEvent,
+} from "astro:transitions/client";
+
+// Article URLs are unbounded; retain at most five views, including the active one.
+const MAX_VIEWS = 5;
+const PERSIST_ATTRIBUTE = "data-astro-transition-persist";
+const STYLE_SELECTOR = 'style, link[rel="stylesheet"]';
+type CachedView = { element: HTMLElement; styles: Element[] };
+const views = new Map<string, CachedView>();
+const submittedDocuments = new WeakSet<Document>();
+let nextId = 0;
+
+// Fragments share a view, while query strings can represent different content.
+const viewKey = (url: URL) => url.origin + url.pathname + url.search;
+const captureStyles = (doc: Document) =>
+  Array.from(doc.head.querySelectorAll(STYLE_SELECTOR), (style) =>
+    style.cloneNode(true) as Element,
+  );
+
+function setActive(element: HTMLElement, active: boolean) {
+  element.inert = !active;
+  if (active) element.removeAttribute("aria-hidden");
+  else element.setAttribute("aria-hidden", "true");
+}
+
+function retainStyles(doc: Document) {
+  const styles = Array.from(doc.head.querySelectorAll(STYLE_SELECTOR));
+  for (const view of views.values()) {
+    for (const style of view.styles) {
+      if (styles.some((existing) => existing.isEqualNode(style))) continue;
+      const copy = style.cloneNode(true) as Element;
+      doc.head.append(copy);
+      styles.push(copy);
+    }
+  }
+}
+
+// A server-handled form must show its fresh response and invalidate older views.
+document.addEventListener("astro:before-preparation", (event) => {
+  const preparation = event as TransitionBeforePreparationEvent;
+  if (!preparation.formData) return;
+  const load = preparation.loader;
+  preparation.loader = async () => {
+    await load();
+    submittedDocuments.add(preparation.newDocument);
+  };
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  const stack = document.querySelector<HTMLElement>("[data-spa-view-stack]");
+  const incomingStack = navigation.newDocument.querySelector<HTMLElement>(
+    "[data-spa-view-stack]",
+  );
+  const incoming = incomingStack?.querySelector<HTMLElement>("[data-spa-view]");
+  const swap = navigation.swap;
+  if (!stack || !incomingStack || !incoming) {
+    navigation.swap = () => {
+      views.clear();
+      swap();
+    };
+    return;
+  }
+
+  navigation.swap = () => {
+    const from = viewKey(navigation.from);
+    const to = viewKey(navigation.to);
+    if (!views.size) {
+      const current = stack.querySelector<HTMLElement>("[data-spa-view]");
+      if (current) {
+        current.setAttribute(PERSIST_ATTRIBUTE, `cached-view-${nextId++}`);
+        views.set(from, { element: current, styles: captureStyles(document) });
+      }
+    }
+
+    // Do not turn an explicit refresh or a form response into a stale cache hit.
+    const invalidate = submittedDocuments.has(navigation.newDocument);
+    for (const [key, view] of views) {
+      if (invalidate || (key === to && from === to)) {
+        view.element.remove();
+        views.delete(key);
+      }
+    }
+
+    const cached = views.get(to);
+    views.delete(to);
+    const target = cached ?? {
+      element: incoming,
+      styles: captureStyles(navigation.newDocument),
+    };
+    if (!cached) incoming.setAttribute(PERSIST_ATTRIBUTE, `cached-view-${nextId++}`);
+    // Reinsertion updates Map order, making eviction least-recently-used.
+    views.set(to, target);
+    while (views.size > MAX_VIEWS) {
+      const oldest = views.keys().next().value!;
+      views.get(oldest)!.element.remove();
+      views.delete(oldest);
+    }
+
+    // Astro transfers matching persistent nodes without replacing their contents.
+    // Keep the active view first so fragment lookup resolves inside it first.
+    if (cached) {
+      const placeholder = navigation.newDocument.createElement("main");
+      placeholder.setAttribute(
+        PERSIST_ATTRIBUTE,
+        cached.element.getAttribute(PERSIST_ATTRIBUTE)!,
+      );
+      incoming.replaceWith(placeholder);
+    }
+    for (const view of views.values()) {
+      setActive(view.element, view === target);
+      if (view.element === incoming) continue;
+      // These scripts belong to already mounted views and must not run again.
+      view.element.querySelectorAll("script").forEach((script) => {
+        script.dataset.astroExec = "";
+      });
+      if (view === target) continue;
+      const placeholder = navigation.newDocument.createElement("main");
+      placeholder.setAttribute(
+        PERSIST_ATTRIBUTE,
+        view.element.getAttribute(PERSIST_ATTRIBUTE)!,
+      );
+      incomingStack.append(placeholder);
+    }
+    retainStyles(navigation.newDocument);
+    swap();
+    // Leave history, scroll restoration, head metadata, and script loading to Astro.
+    target.element.focus({ preventScroll: true });
+  };
+});
