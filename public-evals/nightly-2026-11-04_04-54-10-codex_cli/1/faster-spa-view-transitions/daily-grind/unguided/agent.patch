+const host = document.querySelector('#views');
+const views = new Map([['/', { element: host.querySelector('[data-view]'), scroll: 0 }]]);
+const routes = new Map([
+  ['/', 'Home'],
+  ['/menu', 'Menu'],
+  ['/locations', 'Locations'],
+  ['/rewards', 'Rewards'],
+  ['/account', 'My Account'],
+]);
+let activeRoute;
+
+if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+function mount(route) {
+  if (views.has(route)) return views.get(route);
+
+  const fragment = document.querySelector(`#view-${route.slice(1)}`).content.cloneNode(true);
+  const element = fragment.querySelector('[data-view]');
+  element.hidden = true;
+  host.append(fragment);
+  const view = { element, scroll: 0 };
+  views.set(route, view);
+
+  // Initialize each view once. Its nodes and listeners stay mounted on navigation.
+  if (route === '/menu') {
+    element.querySelector('select').addEventListener('change', (event) => {
+      element.querySelectorAll('[data-category]').forEach((card) => {
+        card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+      });
+    });
+  }
+  if (route === '/locations') {
+    element.querySelector('input').addEventListener('input', (event) => {
+      const search = event.target.value.trim().toLowerCase();
+      const cards = [...element.querySelectorAll('[data-location]')];
+      cards.forEach((card) => { card.hidden = !card.dataset.location.includes(search); });
+      element.querySelector('#location-empty').hidden = cards.some((card) => !card.hidden);
+    });
+  }
+  return view;
+}
+
+function render() {
+  const requested = location.hash.slice(1) || '/';
+  const route = routes.has(requested) ? requested : '/';
+  if (route === activeRoute) return;
+
+  const previous = views.get(activeRoute);
+  if (previous) {
+    previous.scroll = window.scrollY;
+    previous.element.hidden = true;
+  }
+  const next = mount(route);
+  next.element.hidden = false;
+  activeRoute = route;
+  document.title = `${routes.get(route)} | The Daily Grind`;
+  document.querySelectorAll('nav a').forEach((link) => {
+    if (link.getAttribute('href') === `#${route}`) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  });
+  if (previous) {
+    const heading = next.element.querySelector('h1');
+    heading.setAttribute('tabindex', '-1');
+    heading.focus({ preventScroll: true });
+  }
+  window.scrollTo(0, next.scroll);
+}
+
+document.addEventListener('click', (event) => {
+  const link = event.target.closest('a');
+  if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+  const href = link.getAttribute('href');
+  if (!href?.startsWith('#') || !routes.has(href.slice(1))) return;
+  event.preventDefault();
+  if (location.hash !== href) history.pushState(null, '', href);
+  render();
+});
+
+window.addEventListener('popstate', render);
+window.addEventListener('hashchange', render);
+render();
