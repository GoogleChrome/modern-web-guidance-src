@@ -0,0 +1,64 @@
+(() => {
+  const host = document.getElementById('views');
+  // This bounded cache contains only the home view and four navigation views.
+  // Never remove or replace a visited view: inputs, disclosures, and listeners survive.
+  const views = new Map([['/', document.getElementById('view-home')]]);
+  const routes = new Map([
+    ['/', 'Home'],
+    ['/menu', 'Menu'],
+    ['/locations', 'Locations'],
+    ['/rewards', 'Rewards'],
+    ['/account', 'My Account'],
+  ]);
+  const scrollPositions = new Map();
+  let currentRoute;
+
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+  function render() {
+    const requestedRoute = location.hash.slice(1) || '/';
+    const route = routes.has(requestedRoute) ? requestedRoute : '/';
+    if (route === currentRoute) return;
+
+    if (currentRoute !== undefined) {
+      scrollPositions.set(currentRoute, window.scrollY);
+    }
+
+    let nextView = views.get(route);
+    if (!nextView) {
+      const template = document.getElementById(`template-${route.slice(1)}`);
+      nextView = template.content.firstElementChild.cloneNode(true);
+      nextView.classList.add('inactive');
+      nextView.inert = true;
+      host.append(nextView);
+      views.set(route, nextView);
+    }
+
+    // Release focus before making its former ancestor inert/aria-hidden.
+    if (currentRoute !== undefined && host.contains(document.activeElement)) {
+      document.activeElement.blur();
+    }
+    for (const [viewRoute, view] of views) {
+      const inactive = viewRoute !== route;
+      view.classList.toggle('inactive', inactive);
+      view.inert = inactive;
+      view.setAttribute('aria-hidden', String(inactive));
+    }
+
+    for (const link of document.querySelectorAll('nav a[href^="#/"]')) {
+      if (link.getAttribute('href') === `#${route}`) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+    document.title = `${routes.get(route)} | The Daily Grind`;
+    if (currentRoute !== undefined) nextView.focus();
+    currentRoute = route;
+    window.scrollTo({ top: scrollPositions.get(route) || 0, behavior: 'instant' });
+  }
+
+  // Native hash links retain modified-click behavior and browser Back/Forward.
+  window.addEventListener('hashchange', render);
+  render();
+})();
