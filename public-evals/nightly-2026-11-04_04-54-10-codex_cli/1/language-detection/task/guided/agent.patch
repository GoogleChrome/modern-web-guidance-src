   </footer>
 
+  <script>
+    const feedbackForm = document.querySelector('#feedback-form');
+    const feedbackMessage = document.querySelector('#feedback-message');
+    const detectButton = document.querySelector('#detect-button');
+    const feedbackStatus = document.querySelector('#feedback-status');
+    const modelDownload = document.querySelector('#model-download');
+    const downloadProgress = document.querySelector('#download-progress');
+    const downloadPercentage = document.querySelector('#download-percentage');
+    let busy = false;
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Built-in language detection is not supported in this browser. Try a supported browser over HTTPS or localhost.';
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          feedbackStatus.textContent = 'Language detection is currently unavailable on this device.';
+          return;
+        }
+        detectButton.disabled = false;
+        feedbackStatus.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'The language model needs to download. Click Detect to begin.';
+      } catch {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || detectButton.disabled) return;
+
+      const message = feedbackMessage.value.trim();
+      if (!message) {
+        feedbackStatus.textContent = 'Enter a message before detecting its language.';
+        feedbackMessage.focus();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      feedbackMessage.readOnly = true;
+      feedbackForm.setAttribute('aria-busy', 'true');
+      feedbackStatus.textContent = 'Preparing language detection…';
+      let detector;
+
+      try {
+        // Create directly in the submit gesture so a needed download is allowed.
+        detector = await LanguageDetector.create({
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+              modelDownload.hidden = false;
+              downloadProgress.value = percentage;
+              downloadProgress.textContent = `${percentage}%`;
+              downloadPercentage.textContent = `${percentage}%`;
+              feedbackStatus.textContent = 'Downloading the language model…';
+            });
+          },
+        });
+        modelDownload.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const [result] = await detector.detect(message);
+        if (!result || result.detectedLanguage === 'und') {
+          feedbackStatus.textContent = 'Could not identify a language. Try a longer message with a few complete sentences.';
+          return;
+        }
+
+        let languageName = result.detectedLanguage;
+        try {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(result.detectedLanguage) || languageName;
+        } catch {
+          // Keep the language code if display names are unavailable.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(result.confidence);
+        feedbackStatus.textContent = `Language: ${languageName}. AI confidence: ${confidence}.`;
+      } catch {
+        feedbackStatus.textContent = 'Language detection failed. Check your connection if a model download is needed, then click Detect to try again.';
+      } finally {
+        detector?.destroy();
+        modelDownload.hidden = true;
+        downloadProgress.value = 0;
+        downloadPercentage.textContent = '0%';
+        busy = false;
+        detectButton.disabled = false;
+        feedbackMessage.readOnly = false;
+        feedbackForm.removeAttribute('aria-busy');
+      }
+    });
+
+    feedbackMessage.addEventListener('input', () => {
+      if (!detectButton.disabled) {
+        feedbackStatus.textContent = 'Ready to detect your message’s language.';
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
+
 </body>
 
