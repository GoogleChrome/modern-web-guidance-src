+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const detectionStatus = document.getElementById('detection-status');
+    const modelProgress = document.getElementById('model-progress');
+    let detector;
+
+    const supportsDetection = 'LanguageDetector' in window
+      && typeof window.LanguageDetector.availability === 'function'
+      && typeof window.LanguageDetector.create === 'function';
+
+    if (!supportsDetection) {
+      detectButton.disabled = true;
+      detectionStatus.textContent = 'Built-in language detection is not available in this browser. Try a browser that supports the Language Detector API.';
+    }
+
+    messageInput.addEventListener('input', () => {
+      if (supportsDetection) {
+        detectionStatus.textContent = 'Your message is processed on your device.';
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!supportsDetection || detectButton.disabled) return;
+
+      const message = messageInput.value.trim();
+      if (!message) {
+        detectionStatus.textContent = 'Enter a message before detecting its language.';
+        messageInput.focus();
+        return;
+      }
+
+      detectButton.disabled = true;
+      messageInput.disabled = true;
+      feedbackForm.setAttribute('aria-busy', 'true');
+      modelProgress.hidden = true;
+      detectionStatus.textContent = 'Checking language detection availability…';
+
+      try {
+        if (!detector) {
+          const availability = await window.LanguageDetector.availability();
+          if (!['available', 'downloadable', 'downloading'].includes(availability)) {
+            detectionStatus.textContent = 'Language detection is unavailable on this device right now. Please try again later.';
+            return;
+          }
+
+          if (availability !== 'available') {
+            modelProgress.value = 0;
+            modelProgress.hidden = false;
+            detectionStatus.textContent = 'Downloading language detection model: 0%';
+          }
+
+          detector = await window.LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (progress) => {
+                const percentage = Math.round(Math.min(1, Math.max(0, progress.loaded)) * 100);
+                modelProgress.hidden = false;
+                modelProgress.value = percentage;
+                detectionStatus.textContent = `Downloading language detection model: ${percentage}%`;
+              });
+            }
+          });
+        }
+
+        modelProgress.hidden = true;
+        detectionStatus.textContent = 'Detecting language…';
+        const [result] = await detector.detect(message);
+        if (!result || !result.detectedLanguage || result.detectedLanguage === 'und') {
+          detectionStatus.textContent = 'The language could not be determined. Try a longer message.';
+          return;
+        }
+
+        let languageName = result.detectedLanguage;
+        try {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(result.detectedLanguage);
+        } catch {
+          // Keep the language code if display names are unavailable.
+        }
+        const confidence = (result.confidence * 100).toFixed(1);
+        detectionStatus.textContent = `Language: ${languageName}. AI confidence: ${confidence}%.`;
+      } catch (error) {
+        detector?.destroy();
+        detector = undefined;
+        detectionStatus.textContent = error.name === 'NotAllowedError'
+          ? 'Language detection was not allowed. Check your browser permissions and click Detect to try again.'
+          : 'Language detection failed. Check your connection if the model needs downloading, then try again.';
+      } finally {
+        modelProgress.hidden = true;
+        detectButton.disabled = false;
+        messageInput.disabled = false;
+        feedbackForm.removeAttribute('aria-busy');
+      }
+    });
+  </script>
+
 </body>
 
