+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('strength-value');
+    const strengthNote = document.getElementById('strength-note');
+    const strengths = [
+      { name: 'Mild', note: 'Light and mellow. A gentle start to your day.' },
+      { name: 'Smooth', note: 'Soft and easygoing, with a little more depth.' },
+      { name: 'Balanced', note: 'A smooth, rounded cup with just the right kick.' },
+      { name: 'Rich', note: 'Full-bodied and rich, for a more intense cup.' },
+      { name: 'Bold', note: 'Deep and robust. For those who like a little extra kick.' }
+    ];
+
+    function updateStrength() {
+      const value = Number(strengthSlider.value);
+      const strength = strengths[value - 1];
+      const progress = (value - Number(strengthSlider.min)) /
+        (Number(strengthSlider.max) - Number(strengthSlider.min)) * 100;
+      strengthSlider.style.setProperty('--progress', `${progress}%`);
+      strengthSlider.setAttribute('aria-valuetext', `${strength.name}, ${value} of 5`);
+      strengthValue.value = `${strength.name} · ${value}/5`;
+      strengthNote.textContent = strength.note;
+    }
+
+    strengthSlider.addEventListener('input', updateStrength);
+    updateStrength();
+  </script>
