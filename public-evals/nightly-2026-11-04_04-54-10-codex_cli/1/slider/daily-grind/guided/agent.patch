+  <script>
+    const brewStrength = document.getElementById('brew-strength');
+    const brewValue = document.getElementById('brew-strength-value');
+    const strengthNames = ['Mellow', 'Smooth', 'Balanced', 'Bold', 'Intense'];
+
+    function syncBrewStrength() {
+      const value = brewStrength.valueAsNumber;
+      const min = Number(brewStrength.min);
+      const max = Number(brewStrength.max);
+      // Compute a percentage here so fill also works without CSS attr()/progress().
+      const progress = ((value - min) / (max - min)) * 100;
+      const label = `${strengthNames[value - min]} · ${value} / ${max}`;
+      brewStrength.style.setProperty('--slider-progress', `${progress}%`);
+      brewStrength.setAttribute('aria-valuetext', `${strengthNames[value - min]}, ${value} of ${max}`);
+      brewValue.textContent = label;
+    }
+
+    syncBrewStrength();
+    brewStrength.classList.add('is-enhanced');
+    brewValue.hidden = false;
+    brewStrength.addEventListener('input', syncBrewStrength);
+    window.addEventListener('pageshow', syncBrewStrength);
+  </script>
+
