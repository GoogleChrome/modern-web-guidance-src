+<script>
+    const themeSelect = document.getElementById('theme-select');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function applyTheme(value) {
+      const theme = value === 'light' || value === 'dark' ? value : 'system';
+      if (theme === 'system') {
+        delete document.documentElement.dataset.theme;
+      } else {
+        document.documentElement.dataset.theme = theme;
+      }
+      document.querySelector('meta[name="color-scheme"]').content =
+        theme === 'system' ? 'light dark' : theme;
+      themeSelect.value = theme;
+    }
+
+    function describeSystemTheme() {
+      themeSelect.querySelector('[value="system"]').textContent =
+        `System default (${systemTheme.matches ? 'dark' : 'light'})`;
+    }
+
+    applyTheme(document.documentElement.dataset.theme);
+    describeSystemTheme();
+    systemTheme.addEventListener('change', describeSystemTheme);
+
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      try {
+        if (themeSelect.value === 'system') {
+          localStorage.removeItem('daily-grind-theme');
+        } else {
+          localStorage.setItem('daily-grind-theme', themeSelect.value);
+        }
+      } catch {} // The selected theme still works when storage is unavailable.
+    });
+
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'daily-grind-theme' || event.key === null) {
+        applyTheme(event.newValue);
+      }
+    });
+
+    document.getElementById('special-category').addEventListener('change', (event) => {
+      document.querySelectorAll('.special').forEach((special) => {
+        special.hidden = event.target.value !== 'all' &&
+          special.dataset.category !== event.target.value;
+      });
+      document.getElementById('specials-list').scrollTop = 0;
+    });
+  </script>
