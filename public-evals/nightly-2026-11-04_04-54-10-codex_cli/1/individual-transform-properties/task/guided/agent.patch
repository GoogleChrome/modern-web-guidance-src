+
+    .target {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 104px;
+      height: 104px;
+      padding: 12px;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.85rem;
+      font-weight: bold;
+      line-height: 1.3;
+      text-align: center;
+      /* Identity transforms keep the stacking context stable before hover. */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.15;
+    }
+
+    @keyframes promo-spin {
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -18px 0; }
+      to { translate: 18px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation-duration: 120s, 30s;
+        transition: none;
+      }
+    }
