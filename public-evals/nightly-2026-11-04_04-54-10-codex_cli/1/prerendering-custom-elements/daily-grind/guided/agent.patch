diff --git a/seasonal-drink.js b/seasonal-drink.js
new file mode 100644
index 0000000..10acaae
--- /dev/null
+++ b/seasonal-drink.js
@@ -0,0 +1,53 @@
+// Modules run after HTML parsing, so declarative shadow roots are ready to reuse.
+class SeasonalDrink extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #button;
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    // Connections can repeat when a card moves. Keep its original DOM/listener.
+    if (this.#button) return;
+
+    // Older browsers can adopt the same server template without recreating it.
+    if (!this.shadowRoot) {
+      const template = this.querySelector('template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open' }).append(template.content);
+      template.remove();
+    }
+
+    this.#button = this.shadowRoot.querySelector('button');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drink: this.dataset.drink, favorite: this.favorite },
+      }));
+    });
+    this.#syncFavorite();
+    this.#button.disabled = false;
+  }
+
+  attributeChangedCallback() {
+    this.#syncFavorite();
+  }
+
+  #syncFavorite() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorite));
+  }
+}
+
+if (!customElements.get('seasonal-drink')) {
+  customElements.define('seasonal-drink', SeasonalDrink);
+}
