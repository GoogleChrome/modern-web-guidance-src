diff --git a/test/drink-card.test.cjs b/test/drink-card.test.cjs
new file mode 100644
index 0000000..19093b1
--- /dev/null
+++ b/test/drink-card.test.cjs
@@ -0,0 +1,109 @@
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { test } = require('node:test');
+const { runInNewContext } = require('node:vm');
+
+const source = readFileSync(new URL('../drink-card.js', `file://${__filename}`), 'utf8');
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+
+// A small DOM stand-in checks lifecycle behavior without a browser or server.
+function createCardClass() {
+  let Card;
+  class HTMLElement {
+    button = Object.assign(new EventTarget(), {
+      disabled: true,
+      pressed: 'false',
+      getAttribute(name) {
+        assert.equal(name, 'aria-pressed');
+        return this.pressed;
+      },
+      setAttribute(name, value) {
+        assert.equal(name, 'aria-pressed');
+        this.pressed = value;
+      },
+    });
+
+    querySelector(selector) {
+      assert.equal(selector, '[data-favorite]');
+      return this.button;
+    }
+
+    set innerHTML(value) {
+      assert.fail('Hydration must preserve the server-rendered DOM');
+    }
+
+    attachShadow() {
+      assert.fail('Hydration must preserve the styled light DOM');
+    }
+
+    replaceChildren() {
+      assert.fail('Hydration must preserve the server-rendered children');
+    }
+  }
+
+  runInNewContext(source, {
+    HTMLElement,
+    customElements: {
+      define(name, value) {
+        assert.equal(name, 'drink-card');
+        Card = value;
+      },
+    },
+  });
+  return Card;
+}
+
+test('HTML delivers all three cards, styles, links, and toggle states before JavaScript', () => {
+  const cards = [...html.matchAll(/<drink-card class="card">([\s\S]*?)<\/drink-card>/g)];
+  assert.equal(cards.length, 3);
+  for (const [, content] of cards) {
+    assert.match(content, /<h3>.+<\/h3>/);
+    assert.match(content, /<p>.+<\/p>/);
+    assert.match(content, /<a href="\/menu\/.+?" class="btn">View Details<\/a>/);
+    assert.match(content, /<button type="button"[^>]*aria-pressed="false" disabled>/);
+  }
+  assert.match(html, /\.card\s*\{\s*display: block;/);
+  assert.match(html, /<script type="module" src="\/drink-card.js"><\/script>/);
+  assert.ok(html.indexOf('</style>') < html.indexOf('<drink-card'));
+});
+
+test('upgrade preserves the existing button and toggles its pressed state', () => {
+  const Card = createCardClass();
+  const card = new Card();
+  const button = card.button;
+  card.connectedCallback();
+  assert.equal(card.button, button);
+  assert.equal(button.disabled, false);
+  assert.equal(button.pressed, 'false');
+  button.dispatchEvent(new Event('click'));
+  assert.equal(button.pressed, 'true');
+  button.dispatchEvent(new Event('click'));
+  assert.equal(button.pressed, 'false');
+});
+
+test('favorite state is independent for each card', () => {
+  const Card = createCardClass();
+  const first = new Card();
+  const second = new Card();
+  first.connectedCallback();
+  second.connectedCallback();
+  first.button.dispatchEvent(new Event('click'));
+  assert.equal(first.button.pressed, 'true');
+  assert.equal(second.button.pressed, 'false');
+});
+
+test('disconnect removes the listener and reconnect preserves state without duplicate toggles', () => {
+  const Card = createCardClass();
+  const card = new Card();
+  card.connectedCallback();
+  card.button.dispatchEvent(new Event('click'));
+  card.disconnectedCallback();
+  assert.equal(card.button.disabled, true);
+  card.button.dispatchEvent(new Event('click'));
+  assert.equal(card.button.pressed, 'true');
+  card.connectedCallback();
+  assert.equal(card.button.disabled, false);
+  assert.equal(card.button.pressed, 'true');
+  card.button.dispatchEvent(new Event('click'));
+  assert.equal(card.button.pressed, 'false');
+});
