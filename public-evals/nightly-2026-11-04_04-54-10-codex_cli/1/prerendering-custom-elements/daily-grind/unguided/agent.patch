+// Content and styles arrive in the HTML. Upgrading only attaches behavior to
+// existing light-DOM nodes, preserving their identity and initial appearance.
+class DrinkCard extends HTMLElement {
+  #button;
+
+  #toggleFavorite = () => {
+    const pressed = this.#button.getAttribute('aria-pressed') === 'true';
+    this.#button.setAttribute('aria-pressed', String(!pressed));
+  };
+
+  connectedCallback() {
+    this.#button = this.querySelector('[data-favorite]');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    if (!this.#button) return;
+
+    this.#button.removeEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = true;
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
