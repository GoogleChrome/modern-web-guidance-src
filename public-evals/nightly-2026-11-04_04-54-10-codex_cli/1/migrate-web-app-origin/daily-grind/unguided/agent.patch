+const $ = (id) => document.getElementById(id);
+const origin = location.origin;
+const ownPrefix = 'origin-transfer:';
+const dialog = $('transfer-dialog');
+let transferPackage;
+let toastTimer;
+const escapeHTML = (value) => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const displayOrigin = value => value.replace(/^https?:\/\//, '');
+$('current-origin').textContent = origin;
+$('route-current').textContent = displayOrigin(origin);
+if (/Mac/i.test(navigator.platform)) $('platform').value = 'mac';
+else if (/Linux/i.test(navigator.platform)) $('platform').value = 'linux';
+function toast(message) { $('toast').textContent = message; $('toast').classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => $('toast').classList.remove('visible'), 4500); }
+function destination(showError = false) {
+  let error = '';
+  let url;
+  try {
+    url = new URL($('destination').value.trim());
+    if (url.protocol !== 'https:') error = 'Enter a secure origin beginning with https://.';
+    else if (url.username || url.password || url.pathname !== '/' || url.search || url.hash) error = 'Enter only the origin, without credentials, paths, or query parameters.';
+    else if (url.origin === origin) error = 'Choose a different origin from your current app.';
+  } catch { error = 'Enter a valid origin, such as https://app.example.com.'; }
+  $('route-new').textContent = error ? 'Your new home' : displayOrigin(url.origin);
+  $('input-status').textContent = error ? '↗' : '✓';
+  if (showError) {
+    $('url-hint').textContent = error || 'Your new origin is ready for review.';
+    $('url-hint').classList.toggle('error', !!error);
+  }
+  return error ? null : url.origin;
+}
+$('destination').addEventListener('input', () => destination($('url-hint').classList.contains('error')));
+$('destination-form').addEventListener('submit', e => { e.preventDefault(); review(); });
+$('shortcut-toggle').addEventListener('change', () => { $('platform').disabled = !$('shortcut-toggle').checked; });
+function showDialog(html) { $('dialog-content').innerHTML = html; if (!dialog.open) dialog.showModal(); }
+function closeDialog() { dialog.close(); if (!$('step-three').classList.contains('current')) { $('step-one').classList.add('current'); $('step-two').classList.remove('current'); } }
+document.querySelector('.dialog-close').addEventListener('click', closeDialog);
+dialog.addEventListener('cancel', () => { $('step-one').classList.add('current'); $('step-two').classList.remove('current'); });
+dialog.addEventListener('click', e => { if (e.target === dialog) { const rect = dialog.getBoundingClientRect(); if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) closeDialog(); } });
+function collectSettings() {
+  const settings = Object.create(null);
+  for (let i = 0; i < localStorage.length; i++) { const key = localStorage.key(i); if (!key.startsWith(ownPrefix)) settings[key] = localStorage.getItem(key); }
+  return settings;
+}
+function review() {
+  const target = destination(true);
+  if (!target) { $('destination').focus(); return; }
+  try {
+    const settings = $('config-toggle').checked ? collectSettings() : null;
+    transferPackage = { format: 'origin-transfer', version: 1, app: 'The Daily Grind', sourceOrigin: origin, targetOrigin: target, createdAt: new Date().toISOString(), settings, shortcut: $('shortcut-toggle').checked ? { name: 'The Daily Grind', url: target, platform: $('platform').value } : null };
+  } catch { toast('Local storage is unavailable. Allow storage access or turn off user configuration.'); return; }
+  $('step-one').classList.remove('current'); $('step-two').classList.add('current'); $('step-three').classList.remove('current');
+  showDialog(`<div class="dialog-icon">⇄</div><h2>A quick look before the move.</h2><p>Your transfer file will hold the selected settings. Import it with Origin at the new address to restore them.</p><div class="review-detail"><div><span>From</span><strong>${escapeHTML(origin)}</strong></div><div><span>To</span><strong>${escapeHTML(target)}</strong></div><div><span>Configuration</span><strong>${transferPackage.settings ? `${Object.keys(transferPackage.settings).length} saved entries` : 'Not included'}</strong></div><div><span>Shortcut</span><strong>${transferPackage.shortcut ? escapeHTML($('platform').selectedOptions[0].textContent) : 'Not included'}</strong></div></div><p>Only this origin’s local storage is included. Accounts, cookies, IndexedDB, and permissions need to be set up at the destination. Existing OS shortcuts must be replaced manually.</p><div class="dialog-actions"><button class="secondary-button" id="back-button">Back</button><button class="primary-button" id="export-button">Create transfer <span>↓</span></button></div>`);
+  $('back-button').onclick = closeDialog;
+  $('export-button').onclick = exportTransfer;
+}
+$('review-button').onclick = review;
+function download(content, filename, type) {
+  const url = URL.createObjectURL(new Blob([content], { type }));
+  const link = document.createElement('a'); link.href = url; link.download = filename; document.body.append(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 10000);
+}
+function exportTransfer() {
+  download(JSON.stringify(transferPackage, null, 2), 'daily-grind-transfer.json', 'application/json');
+  try {
+    const history = JSON.parse(localStorage.getItem(ownPrefix + 'history') || '[]');
+    history.unshift({ target: transferPackage.targetOrigin, date: transferPackage.createdAt });
+    localStorage.setItem(ownPrefix + 'history', JSON.stringify(history.slice(0, 30)));
+  } catch { /* Download remains available when storage is blocked. */ }
+  $('step-two').classList.remove('current'); $('step-three').classList.add('current');
+  showDialog(`<div class="success-icon">✓</div><h2>Your move is ready.</h2><p>Your transfer file has been prepared for download. Finish these steps to settle into your new origin.</p><ol><li>Keep <strong>daily-grind-transfer.json</strong> somewhere safe. It may contain private settings.</li><li>Open Origin at <strong>${escapeHTML(transferPackage.targetOrigin)}</strong> and use <strong>My apps → Import configuration</strong>.</li>${transferPackage.shortcut ? '<li>Download your new shortcut below, then replace your existing OS shortcut.</li>' : '<li>Install the app at the new origin using your browser’s install menu.</li>'}</ol><p>The destination needs to serve this transfer tool to import the file. Keep the original app until you have restored your settings.</p><div class="dialog-actions"><button class="secondary-button" id="done-button">Done</button>${transferPackage.shortcut ? '<button class="primary-button" id="shortcut-download">Download shortcut <span>↓</span></button>' : ''}</div>`);
+  $('done-button').onclick = closeDialog;
+  if ($('shortcut-download')) $('shortcut-download').onclick = downloadShortcut;
+}
+function downloadShortcut() {
+  const { url, platform } = transferPackage.shortcut;
+  if (platform === 'mac') download(`<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict><key>URL</key><string>${url.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</string></dict></plist>`, 'The Daily Grind.webloc', 'application/xml');
+  else if (platform === 'linux') download(`[Desktop Entry]\nVersion=1.0\nType=Link\nName=The Daily Grind\nURL=${url}\nIcon=web-browser\n`, 'The Daily Grind.desktop', 'application/x-desktop');
+  else download(`[InternetShortcut]\nURL=${url}\n`, 'The Daily Grind.url', 'application/internet-shortcut');
+  toast('Shortcut prepared. Save it to your desktop or preferred location.');
+}
+$('reset-button').onclick = () => { $('destination-form').reset(); $('config-toggle').checked = true; $('shortcut-toggle').checked = true; $('platform').disabled = false; $('url-hint').textContent = 'Use a secure URL, including https://. Just the origin, no paths.'; $('url-hint').classList.remove('error'); destination(); document.querySelectorAll('.step').forEach(el => el.classList.remove('current')); $('step-one').classList.add('current'); toast('Transfer options reset.'); };
+function guide() {
+  showDialog('<div class="dialog-icon">↗</div><h2>A little preparation. A smooth move.</h2><ol><li>Make sure the app is available at its new HTTPS origin.</li><li>Choose your configuration and shortcut format, then review your transfer.</li><li>Download the configuration file and import it using this tool at the new origin.</li><li>Download and place the new shortcut on your desktop. Remove the old shortcut once you have checked the new app.</li></ol><p>Origin exports local storage for the current site. Browser security keeps other sites’ storage private. Reinstall the destination app for a standalone window; downloaded shortcuts open in your default browser.</p><div class="dialog-actions"><button class="primary-button" id="guide-close">Got it</button></div>');
+  $('guide-close').onclick = closeDialog;
+}
+$('guide-button').onclick = guide; $('checklist-button').onclick = guide;
+$('profile-button').onclick = () => toast('Your personal workspace is stored on this device. No sign-in needed.');
+function navigate(view) {
+  document.querySelectorAll('nav button').forEach(b => b.classList.toggle('active', b.dataset.view === view));
+  $('transfer-view').hidden = view !== 'transfer'; $('alternate-view').hidden = view === 'transfer';
+  const titles = { transfer: ['Transfer an app', 'New origin. Same everything.', 'Move your web app to a new address. Bring the familiar with you.'], apps: ['My apps', 'Your app. Your setup.', 'Manage your current app and restore configuration from a previous origin.'], history: ['Transfer history', 'Every move, in one place.', 'Transfer files prepared in this workspace, on this device.'] };
+  $('breadcrumb').textContent = titles[view][0]; $('page-title').textContent = titles[view][1]; $('page-description').textContent = titles[view][2];
+  if (view === 'apps') {
+    $('alternate-view').innerHTML = `<div class="app-detail"><div class="coffee-icon">☕</div><div><h3>The Daily Grind</h3><p>${escapeHTML(origin)}</p></div></div><button class="primary-button" id="app-transfer">Transfer this app <span>→</span></button><div class="import-box"><h3>Import configuration</h3><p>At your new origin? Select your Origin transfer file to restore saved settings. Matching keys will be replaced; other settings remain intact.</p><button class="secondary-button" id="import-button">Choose transfer file</button><input class="file-input" type="file" accept=".json,application/json" id="import-file"></div>`;
+    $('app-transfer').onclick = () => navigate('transfer'); $('import-button').onclick = () => $('import-file').click(); $('import-file').onchange = importFile;
+  } else if (view === 'history') {
+    let history = []; try { const stored = JSON.parse(localStorage.getItem(ownPrefix + 'history') || '[]'); if (Array.isArray(stored)) history = stored.filter(item => item && typeof item.target === 'string' && typeof item.date === 'string'); } catch {}
+    $('alternate-view').innerHTML = '<h2>Prepared transfers</h2>' + (history.length ? history.map(item => `<div class="history-item"><div>The Daily Grind → ${escapeHTML(item.target)}<small>${escapeHTML(new Date(item.date).toLocaleString())}</small></div><span>File prepared</span></div>`).join('') : '<p>No transfers yet. Your next chapter starts with a new origin.</p><button class="primary-button" id="first-transfer">Transfer an app →</button>');
+    if ($('first-transfer')) $('first-transfer').onclick = () => navigate('transfer');
+  }
+}
+document.querySelectorAll('nav button').forEach(button => button.onclick = () => navigate(button.dataset.view));
+async function importFile(e) {
+  const file = e.target.files[0]; if (!file) return;
+  try {
+    if (file.size > 10 * 1024 * 1024) throw new Error('This file is too large. Choose an Origin transfer file under 10 MB.');
+    const data = JSON.parse(await file.text());
+    if (data.format !== 'origin-transfer' || data.version !== 1 || typeof data.targetOrigin !== 'string' || !data.settings || typeof data.settings !== 'object' || Array.isArray(data.settings)) throw new Error('This file does not contain valid Origin configuration.');
+    if (data.targetOrigin !== origin) throw new Error(`This transfer belongs to ${data.targetOrigin}. Open Origin at that address to restore it.`);
+    const entries = Object.entries(data.settings);
+    if (entries.some(([key, value]) => key.startsWith(ownPrefix) || typeof value !== 'string')) throw new Error('The transfer contains unsupported settings.');
+    showDialog(`<div class="dialog-icon">↓</div><h2>Restore your familiar setup.</h2><p>Restore ${entries.length} local configuration entries from <strong>${escapeHTML(data.sourceOrigin)}</strong>? Existing values for matching keys will be replaced.</p><div class="dialog-actions"><button class="secondary-button" id="cancel-import">Cancel</button><button class="primary-button" id="confirm-import">Restore configuration</button></div>`);
+    $('cancel-import').onclick = closeDialog;
+    $('confirm-import').onclick = () => {
+      const previous = new Map();
+      try {
+        for (const [key] of entries) previous.set(key, localStorage.getItem(key));
+        for (const [key, value] of entries) localStorage.setItem(key, value);
+        closeDialog(); toast(`${entries.length} configuration entries restored. Reopen your app to apply them.`);
+      } catch {
+        for (const [key, value] of previous) { try { if (value === null) localStorage.removeItem(key); else localStorage.setItem(key, value); } catch {} }
+        toast('Restore failed. Check browser storage permissions and available space.');
+      }
+    };
+  } catch (err) { toast(err instanceof SyntaxError ? 'That file is not valid JSON. Choose an Origin transfer file.' : err.message); }
+  e.target.value = '';
+}
