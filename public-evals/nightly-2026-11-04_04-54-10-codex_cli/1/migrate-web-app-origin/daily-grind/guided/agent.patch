diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..2bebb19
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,65 @@
+import { mkdir, readFile, writeFile, copyFile, rm } from 'node:fs/promises';
+import { getDomain } from 'tldts';
+import { Script } from 'node:vm';
+
+const root = new URL('../', import.meta.url);
+const read = (name) => readFile(new URL(name, root), 'utf8');
+const config = JSON.parse(await read('migration.config.json'));
+// Parse client scripts without executing browser code or importing a server.
+new Script(await read('migration.js'), { filename: 'migration.js' });
+
+function origin(value, label) {
+  if (!value) throw new Error(`Set ${label} in migration.config.json or the environment.`);
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
+    throw new Error(`${label} must be an HTTPS origin with no credentials, path, query or fragment.`);
+  }
+  return url.origin;
+}
+
+config.oldOrigin = origin(process.env.OLD_ORIGIN || config.oldOrigin, 'OLD_ORIGIN');
+config.newOrigin = origin(process.env.NEW_ORIGIN || config.newOrigin, 'NEW_ORIGIN');
+const domain = (value) => getDomain(new URL(value).hostname, { allowPrivateDomains: true });
+if (!domain(config.oldOrigin) || domain(config.oldOrigin) !== domain(config.newOrigin)) {
+  throw new Error('Origins must share a registrable domain (including private suffix boundaries).');
+}
+if (config.oldOrigin === config.newOrigin) throw new Error('Set distinct old and new origins.');
+for (const side of ['old', 'new']) {
+  const id = config[`${side}Id`];
+  if (typeof id !== 'string' || !id) throw new Error(`${side}Id is required.`);
+  const url = new URL(id, config[`${side}Origin`]);
+  if (url.origin !== config[`${side}Origin`] || url.hash || url.username || url.password) {
+    throw new Error(`${side}Id must identify an app on its configured origin without a fragment.`);
+  }
+  config[`${side}Id`] = url.href;
+}
+if (!Array.isArray(config.localStorageKeys) || !config.localStorageKeys.length ||
+    config.localStorageKeys.some((key) => typeof key !== 'string' || !key) ||
+    new Set(config.localStorageKeys).size !== config.localStorageKeys.length) {
+  throw new Error('List unique, nonempty configuration keys in localStorageKeys. Never include credentials.');
+}
+
+const base = JSON.parse(await read('manifest.json'));
+// Always generate separate origin bundles; never authorize a destination on the new origin.
+for (const side of ['old', 'new']) {
+  const destination = new URL(`dist/${side}/`, root);
+  await rm(destination, { recursive: true, force: true });
+  await mkdir(destination, { recursive: true });
+  for (const name of ['index.html', 'transfer.html', 'migration.js', 'icon.svg']) {
+    await copyFile(new URL(name, root), new URL(name, destination));
+  }
+  const manifest = { ...base, id: config[`${side}Id`] };
+  if (side === 'old') {
+    // The current manifest incubation defines migrate_to as an object, not an array.
+    manifest.migrate_to = { id: config.newId, install_url: `${config.newOrigin}/` };
+    await mkdir(new URL('.well-known/', destination));
+    await writeFile(new URL('.well-known/web-app-origin-association', destination),
+      JSON.stringify({ [config.newId]: { allow_migration: true } }, null, 2) + '\n');
+  } else {
+    manifest.migrate_from = [{ id: config.oldId, install_url: `${config.oldOrigin}/`, behavior: 'suggest' }];
+  }
+  await writeFile(new URL('manifest.json', destination), JSON.stringify(manifest, null, 2) + '\n');
+  await writeFile(new URL('migration-config.js', destination),
+    `window.dailyGrindMigration = ${JSON.stringify(config)};\n`);
+}
+console.log('Built dist/old and dist/new. Deploy each bundle to its configured origin.');
