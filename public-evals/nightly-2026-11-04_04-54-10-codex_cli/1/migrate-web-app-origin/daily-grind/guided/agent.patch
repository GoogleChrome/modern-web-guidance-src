+(() => {
+  'use strict';
+  const config = window.dailyGrindMigration;
+  if (!config || ![config.oldOrigin, config.newOrigin].includes(location.origin)) return;
+  const status = document.getElementById('migration-status');
+  const report = (message) => { status.textContent = message; };
+  const maxSize = 128 * 1024;
+  const isSettings = (entries) => Array.isArray(entries) &&
+    entries.length <= config.localStorageKeys.length &&
+    entries.every((entry) => Array.isArray(entry) && entry.length === 2 &&
+      config.localStorageKeys.includes(entry[0]) && typeof entry[1] === 'string') &&
+    new Set(entries.map(([key]) => key)).size === entries.length &&
+    JSON.stringify(entries).length <= maxSize;
+
+  // Runs on the old origin in a user-opened popup, so storage is first-party.
+  if (document.body.hasAttribute('data-settings-transfer')) {
+    const nonce = new URLSearchParams(location.hash.slice(1)).get('nonce');
+    if (location.origin !== config.oldOrigin || !window.opener || !/^[a-f0-9]{32}$/.test(nonce || '')) return;
+    history.replaceState(null, '', location.pathname);
+    const target = window.opener;
+    const button = document.getElementById('transfer-send');
+    document.getElementById('transfer-description').textContent =
+      `Copy your saved preferences to ${config.newOrigin}. Existing preferences there will be kept. Your originals stay here.`;
+    button.hidden = false;
+    let awaitingReply = false;
+    let timer;
+    window.addEventListener('message', (event) => {
+      if (!awaitingReply || event.origin !== config.newOrigin || event.source !== target ||
+          event.data?.type !== 'daily-grind:settings-received' || event.data.nonce !== nonce) return;
+      clearTimeout(timer);
+      awaitingReply = false;
+      report('Settings copied. You can close this window and return to the new app.');
+      button.hidden = true;
+    });
+    button.addEventListener('click', () => {
+      try {
+        const entries = config.localStorageKeys.flatMap((key) => {
+          const value = localStorage.getItem(key);
+          return value === null ? [] : [[key, value]];
+        });
+        if (!isSettings(entries)) throw new Error('Settings are too large.');
+        awaitingReply = true;
+        button.disabled = true;
+        target.postMessage({ type: 'daily-grind:settings', nonce, entries }, config.newOrigin);
+        report('Waiting for the new app to save your settings…');
+        timer = setTimeout(() => {
+          awaitingReply = false;
+          button.disabled = false;
+          report('The new app did not confirm the copy. Return there and try again. Your originals are safe.');
+        }, 10000);
+      } catch {
+        report('Could not read your saved settings. Allow site storage, then try again. Your originals are safe.');
+      }
+    });
+    return;
+  }
+
+  const panel = document.getElementById('app-migration');
+  if (!panel) return;
+  panel.hidden = false;
+  const description = document.getElementById('migration-description');
+  if (location.origin === config.oldOrigin) {
+    description.textContent =
+      'Visit our new home to copy your saved settings. If your browser offers an app update, accept it to keep your installed shortcuts. Otherwise, install the new site from your browser after copying your settings.';
+    const link = document.getElementById('migration-link');
+    link.href = `${config.newOrigin}/`;
+    link.hidden = false;
+    return;
+  }
+
+  document.getElementById('migration-heading').textContent = 'Welcome to our new home';
+  description.textContent =
+    'Bring your saved preferences from the previous site. Existing preferences here will be kept. A window will ask you to approve the copy. If your browser offers an app update, accept it to keep your shortcuts; otherwise install this site from your browser. You may need to sign in and grant permissions again.';
+  const button = document.getElementById('migration-copy');
+  button.hidden = false;
+  button.addEventListener('click', () => {
+    const nonce = Array.from(crypto.getRandomValues(new Uint8Array(16)),
+      (byte) => byte.toString(16).padStart(2, '0')).join('');
+    let popup;
+    let timer;
+    const cleanup = () => {
+      clearTimeout(timer);
+      window.removeEventListener('message', receive);
+      button.disabled = false;
+    };
+    const receive = (event) => {
+      if (event.origin !== config.oldOrigin || event.source !== popup ||
+          event.data?.type !== 'daily-grind:settings' || event.data.nonce !== nonce) return;
+      if (!isSettings(event.data.entries)) {
+        report('The settings could not be validated. Your existing settings were kept.');
+        cleanup();
+        return;
+      }
+      const written = [];
+      try {
+        // Never overwrite preferences already saved on the destination.
+        for (const [key, value] of event.data.entries) {
+          if (localStorage.getItem(key) === null) {
+            localStorage.setItem(key, value);
+            written.push(key);
+          }
+        }
+        popup.postMessage({ type: 'daily-grind:settings-received', nonce }, config.oldOrigin);
+        report(`Settings transfer complete. Copied ${written.length} saved preference group(s); existing preferences were kept.`);
+      } catch {
+        // Roll back partial writes on quota or storage errors; retain the old copy.
+        for (const key of written) {
+          try { localStorage.removeItem(key); } catch { /* Storage may have been disabled. */ }
+        }
+        report('Could not save your settings. Allow site storage and try again. The originals remain on the previous site.');
+      }
+      cleanup();
+    };
+    window.addEventListener('message', receive);
+    // An opener is deliberately retained for the origin-checked handoff.
+    popup = window.open(`${config.oldOrigin}/transfer.html#nonce=${nonce}`, '_blank', 'popup,width=520,height=420');
+    if (!popup) {
+      cleanup();
+      report('Allow popups for this site, then select Copy saved settings again.');
+      return;
+    }
+    button.disabled = true;
+    report('Approve the copy in the window from the previous site.');
+    timer = setTimeout(() => {
+      cleanup();
+      report('The copy timed out or the window was closed. You can try again; the originals remain on the previous site.');
+    }, 120000);
+  });
+})();
