+  <script>
+    (() => {
+      // Authentication API contract (same origin, HTTPS in production):
+      // GET  /api/auth/session -> { authenticated: boolean }
+      // POST /api/auth/password { username, password } -> { authenticated: true }
+      // POST /api/auth/passkey/options {} -> PublicKeyCredentialRequestOptions JSON
+      // POST /api/auth/passkey/verify <assertion JSON> -> { authenticated: true }
+      // The server must issue a fresh challenge tied to the session, verify the
+      // assertion's challenge, origin, RP ID, signature and user verification,
+      // and set a Secure, HttpOnly, SameSite session cookie on verified success.
+      // Authentication endpoints must enforce same-origin/CSRF protections and
+      // rate limits. Never treat a browser credential alone as a verified login.
+      const panel = document.querySelector('#signin');
+      const form = document.querySelector('#signin-form');
+      const title = document.querySelector('#signin-title');
+      const description = document.querySelector('#signin-description');
+      const username = document.querySelector('#signin-username');
+      const password = document.querySelector('#signin-password');
+      const passwordButton = document.querySelector('#password-signin');
+      const passkeyButton = document.querySelector('#passkey-signin');
+      const status = document.querySelector('#signin-status');
+      const continueLink = document.querySelector('#signin-continue');
+      const signinLink = document.querySelector('#signin-link');
+      const logoutLink = document.querySelector('#logout-link');
+      let authenticated = false;
+      let busy = false;
+      let controller;
+      let conditionalAvailable = false;
+      let destination;
+      let opener;
+
+      function message(text, error = false) {
+        status.textContent = text;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        passwordButton.disabled = value;
+        passkeyButton.disabled = value;
+        form.setAttribute('aria-busy', String(value));
+      }
+
+      async function api(path, data, signal) {
+        let response;
+        try {
+          response = await fetch('/api/auth/' + path, {
+            method: data === undefined ? 'GET' : 'POST',
+            credentials: 'same-origin',
+            headers: { 'Accept': 'application/json', ...(data === undefined ? {} : { 'Content-Type': 'application/json' }) },
+            body: data === undefined ? undefined : JSON.stringify(data),
+            cache: 'no-store',
+            signal,
+            redirect: 'error'
+          });
+        } catch (error) {
+          if (error.name === 'AbortError') throw error;
+          throw new Error('We couldn’t reach sign-in. Please try again in a moment.');
+        }
+        if (response.status === 401 || response.status === 403) {
+          throw new Error('We couldn’t sign you in. Check your details or try another sign-in method.');
+        }
+        if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function stopPasskey() {
+        const previous = controller;
+        controller = undefined;
+        previous?.abort();
+      }
+
+      function signedIn(result) {
+        if (result.authenticated !== true) throw new Error('We couldn’t confirm your sign-in. Please try again.');
+        authenticated = true;
+        stopPasskey();
+        password.value = '';
+        form.hidden = true;
+        signinLink.hidden = true;
+        logoutLink.hidden = false;
+        title.textContent = 'Welcome back. You’re signed in.';
+        description.textContent = 'Your rewards, favorites, and next coffee are ready when you are.';
+        message('Signed in successfully. Keep browsing, or continue when you’re ready.');
+        if (destination) {
+          continueLink.href = destination.href;
+          continueLink.textContent = 'Continue to ' + destination.label;
+          continueLink.hidden = false;
+        }
+      }
+
+      function openSignIn(trigger) {
+        opener = trigger;
+        panel.hidden = false;
+        panel.scrollIntoView({ block: 'center' });
+        if (authenticated) title.focus({ preventScroll: true });
+        else {
+          username.focus({ preventScroll: true });
+          startConditional();
+        }
+      }
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          // Preserve open-in-new-tab and other native link gestures.
+          if (authenticated || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          event.preventDefault();
+          destination = { href: link.href, label: link.dataset.signin };
+          description.textContent = 'Sign in to continue to ' + destination.label + '. We’ll keep your place here.';
+          openSignIn(link);
+        });
+      });
+      signinLink.addEventListener('click', event => {
+        event.preventDefault();
+        openSignIn(signinLink);
+      });
+      document.querySelector('#dismiss-signin').addEventListener('click', () => {
+        if (busy) return;
+        stopPasskey();
+        panel.hidden = true;
+        (opener && !opener.hidden ? opener : (authenticated ? logoutLink : signinLink)).focus({ preventScroll: true });
+      });
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (busy) return;
+        stopPasskey();
+        setBusy(true);
+        message('Signing you in…');
+        try {
+          signedIn(await api('password', { username: username.value, password: password.value }));
+        } catch (error) {
+          message(error.message, true);
+        } finally {
+          setBusy(false);
+          if (!authenticated) startConditional();
+        }
+      });
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64 + '='.repeat((4 - base64.length % 4) % 4)), char => char.charCodeAt(0));
+      }
+
+      function encode(value) {
+        return btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function assertionJSON(credential) {
+        return {
+          id: credential.id,
+          rawId: encode(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encode(credential.response.clientDataJSON),
+            authenticatorData: encode(credential.response.authenticatorData),
+            signature: encode(credential.response.signature),
+            userHandle: credential.response.userHandle ? encode(credential.response.userHandle) : null
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+      }
+
+      async function passkeySignIn(conditional = false) {
+        stopPasskey();
+        const request = new AbortController();
+        controller = request;
+        if (!conditional) {
+          setBusy(true);
+          message('Choose a saved passkey in your browser.');
+        }
+        try {
+          const options = await api('passkey/options', {}, request.signal);
+          const publicKey = { ...options, challenge: decode(options.challenge) };
+          if (options.allowCredentials) {
+            publicKey.allowCredentials = options.allowCredentials.map(item => ({ ...item, id: decode(item.id) }));
+          }
+          // Conditional UI discovers credentials without requiring a username.
+          if (conditional) publicKey.allowCredentials = [];
+          const credential = await navigator.credentials.get({
+            publicKey,
+            ...(conditional ? { mediation: 'conditional' } : {}),
+            signal: request.signal
+          });
+          if (!credential || request.signal.aborted) return;
+          setBusy(true);
+          message('Checking your passkey…');
+          signedIn(await api('passkey/verify', assertionJSON(credential), request.signal));
+        } catch (error) {
+          if (request.signal.aborted || error.name === 'AbortError') return;
+          if (!conditional || busy) {
+            message(error.name === 'NotAllowedError'
+              ? 'No passkey selected. Try again, or sign in with your password.'
+              : error.message, true);
+          }
+        } finally {
+          // A replaced conditional request must not reset an active sign-in.
+          if (controller === request) {
+            controller = undefined;
+            setBusy(false);
+            if (!conditional && !authenticated) startConditional();
+          }
+        }
+      }
+
+      function startConditional() {
+        if (conditionalAvailable && !controller && !busy && !authenticated && !panel.hidden) {
+          void passkeySignIn(true);
+        }
+      }
+
+      passkeyButton.addEventListener('click', () => {
+        if (!busy) void passkeySignIn();
+      });
+      username.addEventListener('focus', startConditional);
+      window.addEventListener('pagehide', () => controller?.abort());
+      window.addEventListener('pageshow', () => {
+        if (controller?.signal.aborted) controller = undefined;
+        startConditional();
+      });
+
+      async function initialize() {
+        try {
+          const session = await api('session');
+          if (session.authenticated === true) signedIn(session);
+        } catch {
+          // Browsing and password autofill remain available if the API is offline.
+        }
+        if (authenticated) return;
+        if (window.isSecureContext && window.PublicKeyCredential && navigator.credentials) {
+          passkeyButton.hidden = false;
+          document.querySelector('#signin-help').textContent = 'Use your browser’s saved password or a passkey. Your browser will guide you.';
+          try {
+            conditionalAvailable = typeof PublicKeyCredential.isConditionalMediationAvailable === 'function'
+              && await PublicKeyCredential.isConditionalMediationAvailable();
+            startConditional();
+          } catch {
+            // The explicit passkey button and password form remain available.
+          }
+        }
+      }
+      void initialize();
+    })();
+  </script>
 </body>
 
