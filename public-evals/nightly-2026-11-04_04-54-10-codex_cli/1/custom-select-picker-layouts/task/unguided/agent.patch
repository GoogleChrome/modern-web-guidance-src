+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+    let selectedIndex = 1;
+    let activeIndex = selectedIndex;
+
+    function setActive(index) {
+      activeIndex = index;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === index));
+      trigger.setAttribute('aria-activedescendant', options[index].id);
+    }
+
+    function setOpen(open) {
+      menu.hidden = !open;
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) setActive(selectedIndex);
+      else trigger.removeAttribute('aria-activedescendant');
+    }
+
+    function selectRoast(index) {
+      selectedIndex = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      document.getElementById('roast-value').textContent = options[index].querySelector('strong').textContent + ' roast';
+      document.getElementById('order-now').href = '/order-online?roast=' + options[index].dataset.value;
+      setOpen(false);
+      trigger.focus();
+    }
+
+    trigger.addEventListener('click', () => setOpen(menu.hidden));
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(index));
+      option.addEventListener('pointerenter', () => setActive(index));
+    });
+
+    trigger.addEventListener('keydown', (event) => {
+      const arrows = ['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'];
+      if (arrows.includes(event.key)) {
+        event.preventDefault();
+        if (menu.hidden) setOpen(true);
+        else setActive((activeIndex + (['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1) + options.length) % options.length);
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault();
+        if (menu.hidden) setOpen(true);
+        setActive(event.key === 'Home' ? 0 : options.length - 1);
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        if (menu.hidden) setOpen(true);
+        else selectRoast(activeIndex);
+      } else if (event.key === 'Escape' || event.key === 'Tab') {
+        setOpen(false);
+      } else {
+        const match = options.findIndex((option) => option.dataset.value.startsWith(event.key.toLowerCase()));
+        if (event.key.length === 1 && match !== -1) {
+          event.preventDefault();
+          if (menu.hidden) setOpen(true);
+          setActive(match);
+        }
+      }
+    });
+
+    document.addEventListener('click', (event) => {
+      if (!picker.contains(event.target)) setOpen(false);
+    });
+    picker.addEventListener('focusout', (event) => {
+      if (!picker.contains(event.relatedTarget)) setOpen(false);
+    });
+  </script>
