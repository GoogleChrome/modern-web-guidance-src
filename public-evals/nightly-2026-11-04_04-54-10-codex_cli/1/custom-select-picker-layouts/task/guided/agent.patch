+  <script>
+    // Keep the rich three-column picker in browsers without customizable select.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('roast');
+      const fallback = document.createElement('div');
+      fallback.className = 'roast-fallback';
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.textContent = select.selectedOptions[0].dataset.title;
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-menu');
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.hidden = true;
+      menu.setAttribute('role', 'radiogroup');
+      menu.setAttribute('aria-labelledby', 'roast-label');
+
+      function closePicker(restoreFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+
+      for (const option of select.options) {
+        const card = document.createElement('label');
+        card.className = 'roast-card';
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roast-choice';
+        radio.value = option.value;
+        radio.checked = option.selected;
+        const image = document.createElement('img');
+        image.className = 'roast-photo';
+        image.src = option.dataset.image;
+        image.alt = '';
+        image.width = 120;
+        image.height = 78;
+        const title = document.createElement('strong');
+        title.textContent = option.dataset.title;
+        const note = document.createElement('span');
+        note.className = 'roast-note';
+        note.textContent = option.dataset.note;
+        card.append(radio, image, title, note);
+        menu.append(card);
+        radio.addEventListener('change', () => {
+          select.value = radio.value;
+          trigger.textContent = option.dataset.title;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+        radio.addEventListener('click', () => closePicker(true));
+        radio.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            radio.click();
+          }
+        });
+      }
+
+      trigger.addEventListener('click', () => {
+        if (!menu.hidden) return closePicker();
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        menu.querySelector('input:checked').focus();
+      });
+      fallback.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closePicker(true);
+        }
+      });
+      fallback.addEventListener('focusout', (event) => {
+        if (!fallback.contains(event.relatedTarget)) closePicker();
+      });
+      document.addEventListener('click', (event) => {
+        if (!fallback.contains(event.target)) closePicker();
+      });
+      fallback.append(trigger, menu);
+      select.after(fallback);
+      select.hidden = true;
+      document.getElementById('roast-label').htmlFor = trigger.id;
+      // The original select supplies the order query parameter in both paths.
+      select.form.addEventListener('formdata', (event) => {
+        event.formData.delete('roast-choice');
+      });
+    }
+  </script>
