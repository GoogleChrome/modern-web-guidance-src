+  <script>
+    const form = document.getElementById('subscription-form');
+    const roast = document.getElementById('roast');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const count = document.getElementById('setup-count');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const frequencyNames = { weekly: 'every week', fortnightly: 'every 2 weeks', monthly: 'every month' };
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    function updateSetup() {
+      const name = roastNames[Number(roast.value) - 1];
+      roastValue.value = name;
+      roast.setAttribute('aria-valuetext', name);
+      roast.style.setProperty('--fill', `${(Number(roast.value) - 1) * 25}%`);
+      const completed = 1 + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      progress.value = completed;
+      progress.textContent = `${completed * 50}%`;
+      count.textContent = `${completed} of 2 preferences set`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        const frequency = Array.from(form.elements.frequency).find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        document.getElementById('receive-emails').checked = saved.receiveEmails === true;
+      }
+    } catch {
+      // Storage may be unavailable or contain invalid data; the form still works.
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const preferences = {
+        frequency: form.elements.frequency.value,
+        roast: Number(roast.value),
+        receiveEmails: document.getElementById('receive-emails').checked
+      };
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        status.textContent = `Preferences saved in this browser: ${roastNames[preferences.roast - 1]} roast, delivered ${frequencyNames[preferences.frequency]}. No subscription has been ordered.`;
+      } catch {
+        status.textContent = 'Your preferences are ready, but this browser could not save them. Allow browser storage and try again. No subscription has been ordered.';
+      }
+    });
+    updateSetup();
+  </script>
