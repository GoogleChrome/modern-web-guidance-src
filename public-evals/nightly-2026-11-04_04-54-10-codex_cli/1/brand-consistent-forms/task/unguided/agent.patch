+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressCount = document.getElementById('progress-count');
+    const review = document.getElementById('subscription-review');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const complete = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      progress.value = complete;
+      progress.textContent = `${complete} of 3 complete`;
+      progressCount.textContent = `${complete} of 3 complete`;
+      document.getElementById('setup-hint').textContent = complete === 3
+        ? 'All set. Your preferences are ready to review.'
+        : 'Choose your roast, enter a valid email, and select a delivery frequency.';
+      review.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const updates = document.getElementById('email-updates').checked ? 'requested' : 'not requested';
+      review.textContent = `Your preferences: ${roastNames[Number(roast.value) - 1]} roast, delivered ${frequency.toLowerCase()}. Email updates: ${updates}. Your choices have not been submitted; no subscription has been created.`;
+    });
+  </script>
