diff --git a/rewards-widget.html b/rewards-widget.html
new file mode 100644
index 0000000..7205864
--- /dev/null
+++ b/rewards-widget.html
@@ -0,0 +1,28 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Daily Grind rewards</title>
+  <style>
+    body { margin: 0; padding: 16px; font: 16px 'Segoe UI', sans-serif; color: #3e2723; }
+    button { padding: 10px 20px; border: 0; border-radius: 5px; background: #4e342e; color: white; cursor: pointer; }
+  </style>
+</head>
+<body>
+  <button type="button">Discover a seasonal favorite</button>
+  <script>
+    // document.referrer identifies the embedder; no sensitive data is sent.
+    // Referrer policy may omit it, in which case the widget stays inactive.
+    try {
+      const parentOrigin = new URL(document.referrer).origin;
+      if (parentOrigin !== 'null') {
+        parent.postMessage({ type: 'init' }, parentOrigin);
+        document.querySelector('button').addEventListener('click', () => {
+          parent.postMessage({ type: 'reward-selected', reward: 'seasonal-favorites' }, parentOrigin);
+        });
+      }
+    } catch { /* No valid embedder. */ }
+  </script>
+</body>
+</html>
