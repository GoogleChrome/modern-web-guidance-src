new file mode 100644
index 0000000..5377a32
--- /dev/null
+++ b/README.md
@@ -0,0 +1,35 @@
+# The Daily Grind
+
+The static page loads `daily-grind.mjs` for ordering messages, navigation checks,
+and the sandboxed rewards widget. No build step is required.
+
+Before connecting an ordering service, replace `TRUSTED_ORDERING_ORIGIN` in
+`origin-validation.mjs` with its exact HTTPS origin. The reserved
+`https://orders.dailygrind.example` is a deployment placeholder. Only that origin
+may send `{ type: 'order-status', message: string }` or
+`{ type: 'redirect', url: string }`. Status text is limited to 500 characters;
+redirects must be HTTP(S), credential-free and schemefully same-site with the page.
+Relative destinations resolve against the page URL.
+
+Where supported, `Origin` supplies browser Public Suffix List comparisons and
+opaque sender identities. Without it, URL parsing supplies exact origin checks.
+Cross-subdomain navigation is allowed only for the explicitly configured private
+`CONTROLLED_SITE_DOMAIN` (update it to a registrable domain you control at deployment).
+Elsewhere the fallback allows only the same scheme and exact hostname, across ports;
+it deliberately rejects other subdomains rather than guessing a registrable domain.
+
+The rewards iframe uses `sandbox="allow-scripts"`. Its window is captured before
+loading the widget. Only its first `init` message can pin its opaque origin;
+subsequent messages must match both the window and pinned origin. Browsers without
+`Origin` enforce the captured window identity instead; those browsers cannot detect
+an opaque-origin change after navigation of that same window. The iframe must
+therefore remain on the controlled widget document. Synthetic `null` origin events
+cannot substitute for native opaque origins when the API is available.
+
+Links are parsed as URLs, classified by the same site policy, and checked again on
+activation. Invalid or non-HTTP(S) links are blocked; external links remain usable
+and receive `noopener noreferrer`. No untrusted text is inserted as HTML.
+
+Run the security regression checks with `npm test`. These Node tests cover tuple
+origin and URL fallbacks and use an explicit test double for native opaque origin
+identity; they do not claim to verify browser implementation behavior.
diff --git a/daily-grind.mjs b/daily-grind.mjs
new file mode 100644
index 0000000..b5ff60b
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,55 @@
+import {
+  createWidgetValidator,
+  isAllowedSameSiteUrl,
+  isTrustedOrderingMessage,
+  parseWebUrl,
+} from './origin-validation.mjs';
+
+const status = document.querySelector('#order-status');
+const widget = document.querySelector('#rewards-widget');
+const acceptWidgetMessage = createWidgetValidator(widget.contentWindow);
+const pageUrl = window.location.href;
+
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+  if (isTrustedOrderingMessage(event)) {
+    if (data.type === 'order-status' && typeof data.message === 'string' && data.message.length <= 500) {
+      status.textContent = data.message;
+    } else if (data.type === 'redirect' && typeof data.url === 'string' &&
+      isAllowedSameSiteUrl(data.url, pageUrl)) {
+      window.location.assign(parseWebUrl(data.url, pageUrl).href);
+    }
+    return;
+  }
+
+  if (acceptWidgetMessage(event) && data.type === 'reward-selected' &&
+    data.reward === 'seasonal-favorites') {
+    status.textContent = 'Explore our seasonal favorites with your next coffee.';
+  }
+});
+
+function validateLink(link) {
+  const url = parseWebUrl(link.getAttribute('href'), pageUrl);
+  if (!url) return false;
+  const external = !isAllowedSameSiteUrl(url, pageUrl);
+  link.toggleAttribute('data-external', external);
+  if (external || link.target === '_blank') {
+    link.relList.add('noopener', 'noreferrer');
+  }
+  return true;
+}
+
+document.querySelectorAll('a[href]').forEach(validateLink);
+// Revalidate at activation time, including dynamically added or modified links.
+function validateLinkActivation(event) {
+  const link = event.target.closest?.('a[href]');
+  if (link && !validateLink(link)) event.preventDefault();
+}
+document.addEventListener('click', validateLinkActivation);
+document.addEventListener('auxclick', validateLinkActivation);
+
+// Load only after the receiver and expected window have been captured, so init
+// cannot race the listener. The sandbox deliberately omits allow-same-origin.
+widget.src = './rewards-widget.html';
