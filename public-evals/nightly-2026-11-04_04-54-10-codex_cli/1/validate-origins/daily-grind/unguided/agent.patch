@@ -0,0 +1,24 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Coffee order updates</title>
+  <style>
+    body { margin: 12px 0; color: #3e2723; font: 16px 'Segoe UI', sans-serif; }
+    button { padding: 10px 16px; border: 0; border-radius: 5px; background: #4e342e; color: white; cursor: pointer; }
+  </style>
+</head>
+<body>
+  <p>Ready for your next coffee?</p>
+  <button type="button" id="order-help">How to order</button>
+  <script>
+    // An opaque-origin sandbox cannot derive a trustworthy parent origin.
+    // These messages contain only public display text; the parent pins source.
+    parent.postMessage({ type: 'widget:ready' }, '*');
+    document.getElementById('order-help').addEventListener('click', () => {
+      parent.postMessage({ type: 'widget:status', status: 'Choose Order Now to start your coffee order.' }, '*');
+    });
+  </script>
+</body>
+</html>
