+    /* Determinate rewards and indeterminate order progress */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: 28px;
+      background: #fff8ef;
+      border: 1px solid #e8d9ca;
+      border-radius: 12px;
+    }
+
+    .progress-panel > p {
+      margin-top: 4px;
+      color: #715b52;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 24px;
+      margin-top: 24px;
+    }
+
+    .progress-card {
+      padding: 20px;
+      background: white;
+      border: 1px solid #ede3dc;
+      border-radius: 8px;
+    }
+
+    .progress-heading {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      flex-wrap: wrap;
+      gap: 4px 12px;
+      margin-bottom: 12px;
+    }
+
+    .progress-heading h3 {
+      font-size: 1rem;
+    }
+
+    .progress-status {
+      color: #79502c;
+      font-size: 0.85rem;
+      font-weight: 600;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      background: #eee5df;
+      border-radius: 999px;
+    }
+
+    .progress-fill {
+      height: 100%;
+      border-radius: inherit;
+      background: linear-gradient(90deg, #a9652c, var(--accent));
+    }
+
+    .progress-fill--rewards {
+      width: 60%;
+    }
+
+    .progress-track--indeterminate .progress-fill {
+      width: 40%;
+      animation: brewing-progress 1.8s ease-in-out infinite;
+    }
+
+    .progress-description {
+      margin-top: 10px;
+      color: #715b52;
+      font-size: 0.85rem;
+    }
+
+    @keyframes brewing-progress {
+      from { transform: translateX(-100%); }
+      to { transform: translateX(250%); }
+    }
+
+    @media (max-width: 640px) {
+      .progress-panel { padding: 20px; }
+      .progress-grid { grid-template-columns: 1fr; gap: 16px; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-track--indeterminate .progress-fill {
+        animation: none;
+        transform: translateX(75%);
+      }
+    }
+
