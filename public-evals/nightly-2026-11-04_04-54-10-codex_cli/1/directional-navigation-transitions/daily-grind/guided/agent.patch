+  <script>
+    const slides = [...document.querySelectorAll('#seasonal-slides .card')];
+    const position = document.getElementById('seasonal-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentIndex = 0;
+    let activeTransition = null;
+
+    async function stepFavorite(direction) {
+      if (activeTransition) return;
+
+      const updateSlide = (animateEntry = false) => {
+        slides[currentIndex].hidden = true;
+        slides[currentIndex].classList.remove('enter-next', 'enter-previous');
+        currentIndex = (currentIndex + direction + slides.length) % slides.length;
+        slides[currentIndex].hidden = false;
+        if (animateEntry) {
+          slides[currentIndex].classList.add(direction > 0 ? 'enter-next' : 'enter-previous');
+        }
+        position.textContent = `${currentIndex + 1} of ${slides.length}`;
+      };
+
+      if (reducedMotion.matches) {
+        updateSlide();
+        return;
+      }
+
+      // Older browsers still get a directional entry animation using CSS.
+      if (!document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))')) {
+        updateSlide(true);
+        return;
+      }
+
+      activeTransition = document.startViewTransition({
+        update: () => updateSlide(),
+        types: [direction > 0 ? 'forward' : 'backward']
+      });
+      try {
+        await activeTransition.finished;
+      } finally {
+        activeTransition = null;
+      }
+    }
+
+    reducedMotion.addEventListener('change', (event) => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => stepFavorite(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => stepFavorite(1));
+  </script>
 </body>
 
