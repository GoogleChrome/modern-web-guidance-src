+  <script>
+    const seasonalSlides = Array.from(document.querySelectorAll('#seasonal-slides .card'));
+    const seasonalPosition = document.getElementById('seasonal-position');
+    let seasonalIndex = 0;
+
+    function showSeasonalSlide(direction) {
+      const outgoing = seasonalSlides[seasonalIndex];
+      outgoing.hidden = true;
+      outgoing.classList.remove('slide-next', 'slide-previous');
+
+      seasonalIndex = (seasonalIndex + direction + seasonalSlides.length) % seasonalSlides.length;
+      const incoming = seasonalSlides[seasonalIndex];
+      incoming.hidden = false;
+      incoming.classList.add(direction > 0 ? 'slide-next' : 'slide-previous');
+      seasonalPosition.textContent = `${seasonalIndex + 1} of ${seasonalSlides.length}`;
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalSlide(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalSlide(1));
+  </script>
