+  $('preview-status').replaceChildren(); const icon = document.createElement('span'); icon.textContent = '◇'; const text = document.createElement('div'); const title = document.createElement('strong'); title.textContent = 'Ready for your signature'; const subtitle = document.createElement('small'); subtitle.textContent = 'A little proof that it’s the real deal.'; text.append(title,subtitle); $('preview-status').append(icon,text);
