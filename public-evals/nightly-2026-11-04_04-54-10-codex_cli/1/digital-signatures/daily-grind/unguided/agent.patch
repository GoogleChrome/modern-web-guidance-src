+  try { download({ format:'daily-grind-public-key-v1', algorithm:'ECDSA-P256-SHA256', fingerprint:keyId, publicKey:await crypto.subtle.exportKey('jwk',pair.publicKey) },'daily-grind-public-key.json'); notify('Public key downloaded. Share it through a trusted channel.'); } catch { notify('Could not export the public key.'); }
+});
+async function readFile(file) { if (!file || file.size > 1048576) throw Error('Please choose a JSON file smaller than 1 MB.'); return file.text(); }
+$('import-key').addEventListener('change',async event => {
