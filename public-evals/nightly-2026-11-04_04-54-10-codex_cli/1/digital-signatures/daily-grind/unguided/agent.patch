+    database = await new Promise((resolve,reject) => { const request = indexedDB.open('daily-grind-signing',1); request.onupgradeneeded = () => request.result.createObjectStore('keys'); request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error); request.onblocked = () => reject(Error('Close other Daily Grind tabs and reload to set up your keys.')); });
