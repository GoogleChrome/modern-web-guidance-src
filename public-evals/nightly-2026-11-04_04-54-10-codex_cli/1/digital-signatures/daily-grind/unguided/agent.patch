new file mode 100644
index 0000000..4fc4252
--- /dev/null
+++ b/signing.mjs
@@ -0,0 +1,35 @@
+export const algorithm = { name: 'ECDSA', namedCurve: 'P-256' };
+const signingAlgorithm = { name: 'ECDSA', hash: 'SHA-256' };
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+const bytes = value => new TextEncoder().encode(canonical(value));
+export const toBase64 = buffer => btoa(String.fromCharCode(...new Uint8Array(buffer)));
+export const fromBase64 = value => Uint8Array.from(atob(value), character => character.charCodeAt(0));
+export async function fingerprint(key) {
+  const raw = await crypto.subtle.exportKey('spki', key);
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', raw)), b => b.toString(16).padStart(2, '0')).join('');
+}
+export function validateDocument(document) {
+  if (!document || document.version !== 1 || document.algorithm !== 'ECDSA-P256-SHA256' || !/^[a-f0-9]{64}$/.test(document.keyId) || typeof document.signature !== 'string' || !/^[A-Za-z0-9+/]{86}==$/.test(document.signature)) throw Error('This is not a supported signed Daily Grind document.');
+  if (Object.keys(document).sort().join(',') !== 'algorithm,keyId,payload,signature,version') throw Error('Unexpected document fields.');
+  const p = document.payload;
+  if (!p || !['receipt', 'voucher'].includes(p.type) || p.issuer !== 'The Daily Grind' || typeof p.reference !== 'string' || !p.reference.trim() || p.reference.length > 60 || typeof p.customer !== 'string' || !p.customer.trim() || p.customer.length > 100 || !/^\d{4}-\d{2}-\d{2}$/.test(p.date) || !Number.isFinite(Date.parse(p.date)) || !Number.isFinite(Date.parse(p.signedAt)) || p.currency !== 'USD' || !Number.isSafeInteger(p.amountCents) || p.amountCents < 1 || p.amountCents > 100000000) throw Error('The document details are incomplete or invalid.');
+  if (p.type === 'receipt' && (typeof p.item !== 'string' || !p.item || !Number.isInteger(p.quantity) || p.quantity < 1 || p.quantity > 99)) throw Error('Invalid order details.');
+  if (p.type === 'voucher' && (typeof p.sender !== 'string' || p.sender.length > 100 || typeof p.note !== 'string' || p.note.length > 300)) throw Error('Invalid gift voucher details.');
+}
+export async function signDocument(payload, keyPair) {
+  const unsigned = { version: 1, algorithm: 'ECDSA-P256-SHA256', keyId: await fingerprint(keyPair.publicKey), payload };
+  const signature = toBase64(await crypto.subtle.sign(signingAlgorithm, keyPair.privateKey, bytes(unsigned)));
+  const document = { ...unsigned, signature };
+  validateDocument(document);
+  return document;
+}
+export async function verifyDocument(document, publicKey) {
+  validateDocument(document);
+  if (await fingerprint(publicKey) !== document.keyId) throw Error('Unknown signer. Import this signer’s public key from a trusted source in Your keys.');
+  const { signature, ...unsigned } = document;
+  return crypto.subtle.verify(signingAlgorithm, publicKey, fromBase64(signature), bytes(unsigned));
+}
