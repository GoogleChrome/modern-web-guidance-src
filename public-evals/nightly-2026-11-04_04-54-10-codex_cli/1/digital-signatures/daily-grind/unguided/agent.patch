--- /dev/null
+++ b/signing.test.mjs
@@ -0,0 +1,43 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { algorithm, canonical, signDocument, verifyDocument, fingerprint } from './signing.mjs';
+if (!globalThis.crypto) globalThis.crypto = webcrypto;
+const receipt = { issuer:'The Daily Grind',type:'receipt',reference:'DG-42',customer:'Alex Morgan',date:'2026-11-04',currency:'USD',amountCents:550,signedAt:'2026-11-04T12:00:00.000Z',item:'Maple Oat Latte',quantity:1 };
+test('receipts and vouchers verify using a nonextractable private key', async () => {
+  const pair = await crypto.subtle.generateKey(algorithm,false,['sign','verify']);
+  assert.equal(pair.privateKey.extractable,false);
+  await assert.rejects(crypto.subtle.exportKey('jwk',pair.privateKey));
+  const signed = await signDocument(receipt,pair);
+  assert.equal(await verifyDocument(JSON.parse(JSON.stringify(signed)),pair.publicKey),true);
+  const voucher = { ...receipt,type:'voucher',sender:'Sam',note:'Enjoy your next coffee!',amountCents:2500 };
+  assert.equal(await verifyDocument(await signDocument(voucher,pair),pair.publicKey),true);
+  const restored = await crypto.subtle.importKey('jwk',await crypto.subtle.exportKey('jwk',pair.publicKey),algorithm,true,['verify']);
+  assert.equal(await fingerprint(restored),signed.keyId);
+  assert.equal(await verifyDocument(signed,restored),true);
+});
+test('tampering with any signed payload field invalidates its signature',async () => {
+  const pair = await crypto.subtle.generateKey(algorithm,false,['sign','verify']);
+  const signed = await signDocument(receipt,pair);
+  for (const [field,value] of Object.entries({...receipt,customer:'Mallory',amountCents:1,reference:'other',date:'2026-11-05',signedAt:'2026-11-05T12:00:00.000Z',item:'Cold Brew',quantity:2})) {
+    if(value === receipt[field]) continue;
+    const changed = structuredClone(signed); changed.payload[field] = value;
+    assert.equal(await verifyDocument(changed,pair.publicKey),false,field);
+  }
+  const changedSignature = structuredClone(signed); changedSignature.signature = (signed.signature[0] === 'A' ? 'B' : 'A') + signed.signature.slice(1);
+  assert.equal(await verifyDocument(changedSignature,pair.publicKey),false);
+});
+test('untrusted keys and malformed documents are rejected',async () => {
+  const pair = await crypto.subtle.generateKey(algorithm,false,['sign','verify']);
+  const stranger = await crypto.subtle.generateKey(algorithm,false,['sign','verify']);
+  const signed = await signDocument(receipt,pair);
+  await assert.rejects(verifyDocument(signed,stranger.publicKey),/Unknown signer/);
+  await assert.rejects(verifyDocument({...signed,algorithm:'none'},pair.publicKey));
+  await assert.rejects(verifyDocument({...signed,signature:''},pair.publicKey));
+  await assert.rejects(verifyDocument({...signed,extra:'unsigned'},pair.publicKey));
+  await assert.rejects(verifyDocument({payload:null},pair.publicKey));
+  await assert.rejects(signDocument({...receipt,amountCents:-1},pair));
+});
+test('object ordering does not affect canonical signed content',() => {
+  assert.equal(canonical({b:{z:2,a:1},a:3}),canonical({a:3,b:{a:1,z:2}}));
+});
