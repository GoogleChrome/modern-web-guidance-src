+    await ready; if (!database) throw Error('Key storage is unavailable in this browser.');
+    const imported = JSON.parse(await readFile(event.target.files[0]));
+    if (imported.format !== 'daily-grind-public-key-v1' || imported.algorithm !== 'ECDSA-P256-SHA256' || !imported.publicKey || imported.publicKey.d) throw Error('Choose an exported ECDSA P-256 public key file.');
