+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generateSigner, signDocument, verifyDocument, publicIdentity, importIdentity, toBase64, fingerprint } from '../signing.mjs';
+
+const signer = await generateSigner();
+const identity = publicIdentity(signer);
+const input = { type: 'receipt', description: '2 × Maple Oat Latte', amountCents: 1100 };
+
+test('receipts and vouchers verify after a JSON round-trip', async () => {
+  for (const type of ['receipt', 'voucher']) {
+    const document = await signDocument(signer, { ...input, type });
+    const payload = await verifyDocument(JSON.parse(JSON.stringify(document)), identity);
+    assert.equal(payload.type, type);
+    assert.equal(payload.amountCents, 1100);
+  }
+  assert.equal(signer.keys.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('pkcs8', signer.keys.privateKey));
+});
+
+test('modified content, purpose, metadata, signature, and unknown fields fail', async () => {
+  const document = await signDocument(signer, input);
+  const mutations = [
+    d => { d.payload.amountCents = 1; },
+    d => { d.payload.type = 'voucher'; },
+    d => { d.payload.description = 'Forged order'; },
+    d => { d.payload.issuedAt = new Date(0).toISOString(); },
+    d => { d.payload.id = crypto.randomUUID(); },
+    d => { d.signature = toBase64(new Uint8Array(64)); },
+    d => { d.payload.paid = true; },
+    d => { d.publicKey = identity.publicKey; },
+    d => { d.version = 2; },
+    d => { d.suite = 'HMAC'; },
+    d => { d.suite = 'toString'; },
+  ];
+  for (const mutate of mutations) {
+    const modified = structuredClone(document);
+    mutate(modified);
+    await assert.rejects(verifyDocument(modified, identity));
+  }
+});
+
+test('a different signing key is never trusted implicitly', async () => {
+  const attacker = await generateSigner();
+  const document = await signDocument(attacker, input);
+  await assert.rejects(verifyDocument(document, identity), /Unknown signer/);
+  document.keyId = identity.keyId;
+  await assert.rejects(verifyDocument(document, identity), /verification failed/);
+});
+
+test('key exports can be imported and fingerprints must match', async () => {
+  const imported = await importIdentity(JSON.parse(JSON.stringify(identity)));
+  assert.equal(imported.key.usages.join(), 'verify');
+  await assert.rejects(importIdentity({ ...identity, keyId: 'forged' }), /fingerprint/);
+  await assert.rejects(importIdentity({ ...identity, publicKey: 'invalid!' }));
+});
+
+test('both classical fallbacks sign, verify, and bind the document purpose', async () => {
+  for (const suite of ['Ed25519', 'ECDSA-P256-SHA256']) {
+    const generation = suite === 'Ed25519' ? suite : { name: 'ECDSA', namedCurve: 'P-256' };
+    const keys = await crypto.subtle.generateKey(generation, false, ['sign', 'verify']);
+    const publicKey = toBase64(await crypto.subtle.exportKey('raw', keys.publicKey));
+    const fallback = { suite, keys, publicKey, keyId: await fingerprint(publicKey) };
+    const document = await signDocument(fallback, input);
+    await verifyDocument(document, publicIdentity(fallback));
+    document.payload.type = 'voucher';
+    await assert.rejects(verifyDocument(document, publicIdentity(fallback)));
+  }
+});
+
+test('reordering JSON fields is safe; malformed documents are rejected', async () => {
+  const document = await signDocument(signer, input);
+  document.payload = Object.fromEntries(Object.entries(document.payload).reverse());
+  await verifyDocument(document, identity);
+  for (const invalid of [null, {}, { ...document, payload: null }]) {
+    await assert.rejects(verifyDocument(invalid, identity));
+  }
+  await assert.rejects(signDocument(signer, { ...input, amountCents: -100 }));
+  await assert.rejects(signDocument(signer, { ...input, description: ' ' }));
+});
