diff --git a/receipts.mjs b/receipts.mjs
new file mode 100644
index 0000000..85f2890
--- /dev/null
+++ b/receipts.mjs
@@ -0,0 +1,218 @@
+import { generateSigner, publicIdentity, importIdentity, signDocument, verifyDocument } from './signing.mjs';
+
+const $ = id => document.getElementById(id);
+let signer;
+let trustedIdentity;
+let signedDocument;
+let initialization;
+
+function status(id, message, state = '') {
+  $(id).textContent = message;
+  $(id).dataset.state = state;
+}
+
+function requestResult(request) {
+  return new Promise((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+async function loadSigner() {
+  if (!globalThis.isSecureContext || !globalThis.crypto?.subtle) {
+    throw new Error('Digital signing requires HTTPS and a browser with Web Crypto support.');
+  }
+  const request = indexedDB.open('daily-grind-signing', 1);
+  request.onupgradeneeded = () => request.result.createObjectStore('keys');
+  const database = await requestResult(request);
+  try {
+    const existing = await requestResult(database.transaction('keys').objectStore('keys').get('issuer'));
+    if (existing) return existing;
+    const generated = await generateSigner();
+    // add() preserves the first key if another tab initialized at the same time.
+    try {
+      await new Promise((resolve, reject) => {
+        const transaction = database.transaction('keys', 'readwrite');
+        transaction.objectStore('keys').add(generated, 'issuer');
+        transaction.oncomplete = resolve;
+        transaction.onabort = () => reject(transaction.error);
+        transaction.onerror = () => {};
+      });
+      return generated;
+    } catch (error) {
+      if (error.name !== 'ConstraintError') throw error;
+      return await requestResult(database.transaction('keys').objectStore('keys').get('issuer'));
+    }
+  } finally {
+    database.close();
+  }
+}
+
+function ready() {
+  if (!initialization) initialization = loadSigner().then(value => {
+    signer = value;
+    trustedIdentity = publicIdentity(signer);
+    $('algorithm').textContent = signer.suite === 'ML-DSA-65' ? 'ML-DSA-65 · Quantum-resistant' : `${signer.suite} · Classical`;
+    $('key-fingerprint').textContent = signer.keyId;
+    $('trusted-fingerprint').textContent = signer.keyId;
+    $('export-key').disabled = false;
+    return signer;
+  }).catch(error => {
+    $('algorithm').textContent = 'Unavailable';
+    $('key-fingerprint').textContent = 'Unavailable';
+    if (!trustedIdentity) $('trusted-fingerprint').textContent = 'No trusted key selected';
+    status('key-status', `Signing unavailable: ${error.message} Allow browser storage and reload to try again.`, 'error');
+    throw error;
+  });
+  return initialization;
+}
+
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+function clearSigned() {
+  signedDocument = undefined;
+  $('signed-actions').hidden = true;
+  status('sign-status', 'Your document is signed only when you choose Create signed document.');
+}
+
+$('document-form').addEventListener('input', clearSigned);
+$('document-type').addEventListener('change', () => {
+  const voucher = $('document-type').value === 'voucher';
+  $('description').value = voucher ? 'A little coffee, on me. Enjoy your next Daily Grind visit!' : '2 × Maple Oat Latte';
+  $('amount').value = voucher ? '25.00' : '11.00';
+  $('description-label').textContent = voucher ? 'Gift message' : 'Order details';
+  clearSigned();
+});
+
+$('document-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const button = $('sign-document');
+  button.disabled = true;
+  $('signed-actions').hidden = true;
+  signedDocument = undefined;
+  status('sign-status', 'Creating your digital signature…');
+  try {
+    const type = $('document-type').value;
+    const description = $('description').value.trim();
+    const amountCents = Math.round(Number($('amount').value) * 100);
+    const key = await ready();
+    const result = await signDocument(key, { type, description, amountCents });
+    // Do not expose a signature for form values changed during the async operation.
+    if (type !== $('document-type').value || description !== $('description').value.trim()
+        || amountCents !== Math.round(Number($('amount').value) * 100)) {
+      status('sign-status', 'Details changed. Create a new signature for the updated document.');
+      return;
+    }
+    signedDocument = result;
+    $('signed-actions').hidden = false;
+    status('sign-status', `Signed ${type === 'receipt' ? 'receipt' : 'gift voucher'} · $${(amountCents / 100).toFixed(2)} USD. Ready to download or verify.`, 'success');
+  } catch (error) {
+    status('sign-status', error.message, 'error');
+  } finally {
+    button.disabled = false;
+  }
+});
+
+$('download-document').addEventListener('click', () => {
+  if (signedDocument) download(signedDocument, `daily-grind-${signedDocument.payload.type}-${signedDocument.payload.id}.json`);
+});
+$('use-document').addEventListener('click', () => {
+  if (!signedDocument) return;
+  $('verification-document').value = JSON.stringify(signedDocument, null, 2);
+  $('verification-document').dispatchEvent(new Event('input'));
+  $('verification-document').focus();
+});
+$('export-key').addEventListener('click', () => {
+  if (signer) download(publicIdentity(signer), 'daily-grind-public-key.json');
+});
+
+$('verification-document').addEventListener('input', () => {
+  status('verify-status', 'Ready to check. Verification will use the trusted key shown below.');
+});
+
+async function readFile(input) {
+  const file = input.files[0];
+  if (!file) return null;
+  if (file.size > 64000) throw new Error('Choose a JSON file smaller than 64 KB.');
+  return await file.text();
+}
+
+$('document-file').addEventListener('change', async event => {
+  try {
+    const text = await readFile(event.target);
+    if (text !== null) {
+      $('verification-document').value = text;
+      $('verification-document').dispatchEvent(new Event('input'));
+    }
+  } catch (error) { status('verify-status', error.message, 'error'); }
+  event.target.value = '';
+});
+
+let pendingIdentity;
+$('public-key-file').addEventListener('change', async event => {
+  pendingIdentity = undefined;
+  $('trust-key').disabled = true;
+  status('verify-status', 'Public key selection changed. Verify the document again after confirming a key.');
+  try {
+    const text = await readFile(event.target);
+    if (text === null) return;
+    const imported = await importIdentity(JSON.parse(text));
+    pendingIdentity = publicIdentity(imported);
+    $('pending-fingerprint').textContent = pendingIdentity.keyId;
+    $('pending-key').hidden = false;
+    $('trust-key').disabled = false;
+  } catch (error) {
+    $('pending-key').hidden = true;
+    status('verify-status', `Cannot load public key: ${error.message}`, 'error');
+  }
+  event.target.value = '';
+});
+$('trust-key').addEventListener('click', () => {
+  if (!pendingIdentity) return;
+  trustedIdentity = pendingIdentity;
+  $('trusted-fingerprint').textContent = trustedIdentity.keyId;
+  $('pending-key').hidden = true;
+  pendingIdentity = undefined;
+  status('verify-status', 'Public key selected for this session. Verify the document to check its signature.');
+});
+$('own-key').addEventListener('click', async () => {
+  try {
+    await ready();
+    trustedIdentity = publicIdentity(signer);
+    $('trusted-fingerprint').textContent = signer.keyId;
+    $('pending-key').hidden = true;
+    pendingIdentity = undefined;
+    status('verify-status', 'Using this browser’s public key. Verify the document to check its signature.');
+  } catch (error) { status('verify-status', error.message, 'error'); }
+});
+
+$('verify-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const text = $('verification-document').value;
+  const button = $('verify-document');
+  button.disabled = true;
+  status('verify-status', 'Checking the signature…');
+  try {
+    if (text.length > 64000) throw new Error('The document must be smaller than 64 KB.');
+    const document = JSON.parse(text);
+    if (!trustedIdentity) await ready();
+    const identity = trustedIdentity;
+    const payload = await verifyDocument(document, identity);
+    if (text !== $('verification-document').value || identity !== trustedIdentity) {
+      status('verify-status', 'Document or key changed. Verify again to check the current selection.');
+      return;
+    }
+    status('verify-status', `Valid signature · ${payload.type === 'receipt' ? 'Receipt' : 'Gift voucher'} · $${(payload.amountCents / 100).toFixed(2)} USD. The signed details are unchanged and match the selected trusted key. This does not confirm payment or voucher redemption.`, 'success');
+  } catch (error) {
+    status('verify-status', error instanceof SyntaxError ? 'Invalid JSON. Paste or upload a complete signed document.' : error.message, 'error');
+  } finally { button.disabled = false; }
+});
+
+ready().catch(() => {});
diff --git a/signing.mjs b/signing.mjs
new file mode 100644
index 0000000..3b128de
--- /dev/null
+++ b/signing.mjs
@@ -0,0 +1,113 @@
+const encoder = new TextEncoder();
+const suites = {
+  'ML-DSA-65': { generation: 'ML-DSA-65', operation: 'ML-DSA-65', format: 'raw-public' },
+  Ed25519: { generation: 'Ed25519', operation: 'Ed25519', format: 'raw' },
+  'ECDSA-P256-SHA256': {
+    generation: { name: 'ECDSA', namedCurve: 'P-256' },
+    operation: { name: 'ECDSA', hash: 'SHA-256' }, format: 'raw',
+  },
+};
+
+export function toBase64(bytes) {
+  return btoa(String.fromCharCode(...new Uint8Array(bytes)));
+}
+
+function fromBase64(value) {
+  if (typeof value !== 'string' || value.length > 16000 || !/^[A-Za-z0-9+/]+={0,2}$/.test(value)) {
+    throw new Error('Invalid signature or public key encoding.');
+  }
+  return Uint8Array.from(atob(value), char => char.charCodeAt(0));
+}
+
+function suiteFor(name) {
+  if (!Object.hasOwn(suites, name)) throw new Error('This signing algorithm is not supported.');
+  return suites[name];
+}
+
+// Sign a fixed, domain-separated representation; JSON whitespace and key order do not matter.
+function signedBytes(document) {
+  if (!document || typeof document !== 'object' || Array.isArray(document)) {
+    throw new Error('Invalid receipt or voucher. Expected a signed JSON document.');
+  }
+  const { payload } = document;
+  if (document.version !== 1 || !payload || !['receipt', 'voucher'].includes(payload.type)
+      || payload.issuer !== 'The Daily Grind — local issuer'
+      || typeof payload.id !== 'string' || !/^[a-f0-9-]{36}$/i.test(payload.id)
+      || typeof payload.issuedAt !== 'string' || !Number.isFinite(Date.parse(payload.issuedAt))
+      || typeof payload.description !== 'string' || !payload.description.trim() || payload.description.length > 240
+      || !Number.isSafeInteger(payload.amountCents) || payload.amountCents < 1 || payload.amountCents > 1000000
+      || payload.currency !== 'USD') {
+    throw new Error('Invalid receipt or voucher. Check the document fields.');
+  }
+  const expected = ['amountCents', 'currency', 'description', 'id', 'issuedAt', 'issuer', 'type'];
+  if (JSON.stringify(Object.keys(payload).sort()) !== JSON.stringify(expected)
+      || JSON.stringify(Object.keys(document).sort()) !== JSON.stringify(['keyId', 'payload', 'signature', 'suite', 'version'])) {
+    throw new Error('The document contains unexpected or missing fields.');
+  }
+  suiteFor(document.suite);
+  return encoder.encode(JSON.stringify([
+    'daily-grind-signed-document-v1', document.version, document.suite, document.keyId,
+    payload.type, payload.issuer, payload.id, payload.issuedAt, payload.description,
+    payload.amountCents, payload.currency,
+  ]));
+}
+
+export async function fingerprint(publicKey) {
+  const hash = await crypto.subtle.digest('SHA-256', fromBase64(publicKey));
+  return Array.from(new Uint8Array(hash), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+
+export async function generateSigner() {
+  const candidates = [];
+  if (globalThis.SubtleCrypto?.supports?.('sign', 'ML-DSA-65')
+      && globalThis.SubtleCrypto.supports('verify', 'ML-DSA-65')) candidates.push('ML-DSA-65');
+  candidates.push('Ed25519', 'ECDSA-P256-SHA256');
+  for (const suite of candidates) {
+    try {
+      const options = suiteFor(suite);
+      const keys = await crypto.subtle.generateKey(options.generation, false, ['sign', 'verify']);
+      const publicKey = toBase64(await crypto.subtle.exportKey(options.format, keys.publicKey));
+      return { suite, keys, publicKey, keyId: await fingerprint(publicKey) };
+    } catch (error) {
+      if (error.name !== 'NotSupportedError') throw error;
+    }
+  }
+  throw new Error('No supported digital signature algorithm is available in this browser.');
+}
+
+export function publicIdentity(signer) {
+  return { version: 1, suite: signer.suite, publicKey: signer.publicKey, keyId: signer.keyId };
+}
+
+export async function importIdentity(identity) {
+  if (!identity || identity.version !== 1) throw new Error('Invalid public key file.');
+  const options = suiteFor(identity.suite);
+  if (await fingerprint(identity.publicKey) !== identity.keyId) throw new Error('Public key fingerprint does not match.');
+  const key = await crypto.subtle.importKey(options.format, fromBase64(identity.publicKey), options.generation, true, ['verify']);
+  return { ...identity, key };
+}
+
+export async function signDocument(signer, { type, description, amountCents }) {
+  const document = {
+    version: 1, suite: signer.suite, keyId: signer.keyId,
+    payload: {
+      type, issuer: 'The Daily Grind — local issuer', id: crypto.randomUUID(),
+      issuedAt: new Date().toISOString(), description, amountCents, currency: 'USD',
+    },
+    signature: '',
+  };
+  const bytes = signedBytes(document);
+  document.signature = toBase64(await crypto.subtle.sign(suiteFor(signer.suite).operation, signer.keys.privateKey, bytes));
+  return document;
+}
+
+export async function verifyDocument(document, identity) {
+  const bytes = signedBytes(document);
+  if (document.keyId !== identity.keyId || document.suite !== identity.suite) {
+    throw new Error('Unknown signer. Select a trusted public key matching this document’s fingerprint.');
+  }
+  const imported = await importIdentity(identity);
+  const valid = await crypto.subtle.verify(suiteFor(document.suite).operation, imported.key, fromBase64(document.signature), bytes);
+  if (!valid) throw new Error('Signature verification failed. This document has been changed or its signature is invalid.');
+  return document.payload;
+}
diff --git a/tests/signing.test.mjs b/tests/signing.test.mjs
