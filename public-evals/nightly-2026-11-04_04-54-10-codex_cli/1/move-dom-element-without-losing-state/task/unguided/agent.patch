+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const heroSlot = document.getElementById('hero-video-slot');
+      const home = document.getElementById('video-home');
+      const section = document.querySelector('.roasting-section');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.getElementById('theater-toggle');
+      const canMove = typeof heroSlot.moveBefore === 'function';
+      let theater = false;
+      let pendingFrame = null;
+
+      function positionLegacyPlayer() {
+        if (canMove || !theater) return;
+        const bounds = heroSlot.getBoundingClientRect();
+        player.style.left = `${bounds.left + window.scrollX}px`;
+        player.style.top = `${bounds.top + window.scrollY}px`;
+        player.style.width = `${bounds.width}px`;
+        const height = `${player.getBoundingClientRect().height}px`;
+        if (heroSlot.style.height !== height) heroSlot.style.height = height;
+      }
+
+      function schedulePosition() {
+        if (pendingFrame !== null) return;
+        pendingFrame = requestAnimationFrame(() => {
+          pendingFrame = null;
+          positionLegacyPlayer();
+        });
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        theater = !theater;
+        heroSlot.hidden = !theater;
+        hero.classList.toggle('is-theater', theater);
+        section.classList.toggle('is-theater', theater);
+
+        if (canMove) {
+          // Atomic moves preserve the iframe's browsing context and playback.
+          // Moving its wrapper also keeps the toggle alongside the video.
+          const destination = theater ? heroSlot : home;
+          destination.moveBefore(player, null);
+        } else {
+          // appendChild/insertBefore would reload the iframe. Leave it attached
+          // to its original parent and position it over the hero's reserved slot.
+          player.classList.toggle('is-positioned', theater);
+          if (!theater) {
+            player.style.removeProperty('left');
+            player.style.removeProperty('top');
+            player.style.removeProperty('width');
+            heroSlot.style.removeProperty('height');
+          }
+        }
+
+        toggle.setAttribute('aria-pressed', String(theater));
+        toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        positionLegacyPlayer();
+        // Keep the relocated control and player in view in either direction.
+        player.scrollIntoView({ block: 'nearest', behavior: 'instant' });
+      });
+
+      if (!canMove) {
+        window.addEventListener('resize', schedulePosition);
+        window.addEventListener('scroll', schedulePosition, { passive: true });
+        window.addEventListener('load', schedulePosition);
+        if (typeof ResizeObserver === 'function') {
+          const observer = new ResizeObserver(schedulePosition);
+          observer.observe(document.body);
+          observer.observe(heroSlot);
+          observer.observe(player);
+        }
+      }
+    })();
+  </script>
