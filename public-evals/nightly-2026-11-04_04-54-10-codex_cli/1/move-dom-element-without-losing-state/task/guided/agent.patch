+  <script>
+    const hero = document.querySelector('.hero');
+    const toggle = document.getElementById('theater-toggle');
+    const video = document.getElementById('roasting-video');
+    const home = document.getElementById('main-video-slot');
+    const theater = document.getElementById('hero-video-slot');
+    const status = document.getElementById('video-status');
+    const canMove = typeof theater.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionVideo() {
+      if (canMove || !theaterMode) return;
+      const bounds = theater.getBoundingClientRect();
+      video.style.top = `${bounds.top + window.scrollY}px`;
+      video.style.left = `${bounds.left + window.scrollX}px`;
+      video.style.width = `${bounds.width}px`;
+      video.style.height = `${bounds.height}px`;
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', () => {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+      theater.hidden = !theaterMode;
+
+      if (canMove) {
+        // Atomic moves keep the same iframe browsing context and playback state.
+        (theaterMode ? theater : home).moveBefore(video, null);
+        home.hidden = theaterMode;
+      } else {
+        // Traditional reparenting reloads iframes. Keep it connected to its
+        // original parent and visually place it over the hero slot instead.
+        // Keep the home ancestor rendered so playback is never suspended.
+        home.style.height = theaterMode ? '0px' : '';
+        home.style.aspectRatio = theaterMode ? 'auto' : '';
+        video.classList.toggle('is-positioned', theaterMode);
+        if (theaterMode) {
+          positionVideo();
+        } else {
+          ['top', 'left', 'width', 'height'].forEach(property => {
+            video.style.removeProperty(property);
+          });
+        }
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      status.textContent = theaterMode
+        ? 'Video is now in the hero section.'
+        : 'Video is back in the main content.';
+    });
+
+    if (!canMove) {
+      window.addEventListener('resize', positionVideo);
+      window.addEventListener('load', positionVideo);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionVideo);
+        observer.observe(hero);
+        observer.observe(theater);
+      }
+      if (document.fonts) document.fonts.ready.then(positionVideo);
+    }
+  </script>
