+  <script>
+    const shopSelect = document.getElementById('local-shop');
+
+    // Wait for interaction or native submission validation before showing errors.
+    const updateShopValidation = () => {
+      shopSelect.setAttribute('aria-invalid', String(!shopSelect.validity.valid));
+    };
+
+    shopSelect.addEventListener('blur', updateShopValidation);
+    shopSelect.addEventListener('change', updateShopValidation);
+    shopSelect.addEventListener('input', updateShopValidation);
+    // An invalid required field blocks submission before the submit event fires.
+    shopSelect.addEventListener('invalid', updateShopValidation);
+  </script>
