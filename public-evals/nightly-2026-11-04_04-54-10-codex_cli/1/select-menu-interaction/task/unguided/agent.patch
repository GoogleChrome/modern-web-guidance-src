+  <script>
+    const orderForm = document.getElementById('order-form');
+    const shopSelect = document.getElementById('shop');
+    const shopError = document.getElementById('shop-error');
+    let shopTouched = false;
+    let submitAttempted = false;
+
+    function updateShopValidation() {
+      const showError = (shopTouched || submitAttempted) && !shopSelect.validity.valid;
+      shopError.hidden = !showError;
+      if (showError) {
+        shopSelect.setAttribute('aria-invalid', 'true');
+        shopSelect.setAttribute('aria-describedby', 'shop-error');
+      } else {
+        shopSelect.removeAttribute('aria-invalid');
+        shopSelect.removeAttribute('aria-describedby');
+      }
+    }
+
+    // Keep native required validation available when JavaScript is disabled.
+    orderForm.noValidate = true;
+
+    for (const eventName of ['blur', 'change']) {
+      shopSelect.addEventListener(eventName, () => {
+        shopTouched = true;
+        updateShopValidation();
+      });
+    }
+
+    orderForm.addEventListener('submit', (event) => {
+      submitAttempted = true;
+      updateShopValidation();
+      if (!orderForm.checkValidity()) {
+        event.preventDefault();
+        shopSelect.focus();
+      }
+    });
+  </script>
+
 </body>
 
