+  <script>
+    const seasonalPages = [
+      [
+        ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+        ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+        ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew']
+      ],
+      [
+        ['Pumpkin Spice Latte', 'Espresso with pumpkin, warming spices, and steamed milk.', '/menu/seasonal'],
+        ['Caramel Cappuccino', 'Rich caramel and espresso topped with airy milk foam.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Slow-steeped coffee finished with vanilla cream.', '/menu/cold-brew']
+      ],
+      [
+        ['Cinnamon Oat Latte', 'Cozy cinnamon and espresso blended with creamy oat milk.', '/menu/seasonal'],
+        ['Mocha Espresso', 'Dark chocolate paired with our bold espresso roast.', '/menu/espresso'],
+        ['Maple Cold Brew', 'Smooth cold brew sweetened with a touch of maple.', '/menu/cold-brew']
+      ]
+    ];
+    const requestedPage = Number(new URL(location.href).searchParams.get('page') || 1);
+    const page = Number.isInteger(requestedPage)
+      ? Math.max(1, Math.min(seasonalPages.length, requestedPage)) : 1;
+
+    document.querySelectorAll('.grid .card').forEach((card, index) => {
+      const [name, description, href] = seasonalPages[page - 1][index];
+      card.querySelector('h3').textContent = name;
+      card.querySelector('p').textContent = description;
+      card.querySelector('a').href = href;
+    });
+    document.getElementById('page-status').textContent = `Page ${page} of ${seasonalPages.length}`;
+
+    for (const [id, destination] of [['previous', page - 1], ['next', page + 1]]) {
+      const link = document.getElementById(id);
+      if (destination < 1 || destination > seasonalPages.length) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      } else {
+        const url = new URL(location.href);
+        url.searchParams.set('page', destination);
+        link.href = url.pathname + url.search + url.hash;
+        link.removeAttribute('aria-disabled');
+      }
+    }
+  </script>
+
 </body>
 
