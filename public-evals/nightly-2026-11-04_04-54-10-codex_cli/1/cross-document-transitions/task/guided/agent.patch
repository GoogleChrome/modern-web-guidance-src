+      @keyframes page-in-right { from { transform: translateX(20%); opacity: 0; } }
+      @keyframes page-out-right { to { transform: translateX(20%); opacity: 0; } }
+      @keyframes page-in-left { from { transform: translateX(-20%); opacity: 0; } }
