   </style>
+  <script>
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+        // Check again in case the preference changed while this page was cached.
+        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+          event.viewTransition.skipTransition();
+          return;
+        }
+
+        const from = window.navigation?.activation?.from?.url || document.referrer;
+        if (!from || !event.viewTransition.types) return;
+        const previousURL = new URL(from, location.href);
+        const currentURL = new URL(location.href);
+        if (previousURL.origin !== currentURL.origin || previousURL.pathname !== currentURL.pathname) return;
+
+        const previousPage = Number(previousURL.searchParams.get('page') || 1);
+        const currentPage = Number(currentURL.searchParams.get('page') || 1);
+        if (currentPage > previousPage) event.viewTransition.types.add('next');
+        if (currentPage < previousPage) event.viewTransition.types.add('previous');
+      });
+    }
+  </script>
 </head>
 
