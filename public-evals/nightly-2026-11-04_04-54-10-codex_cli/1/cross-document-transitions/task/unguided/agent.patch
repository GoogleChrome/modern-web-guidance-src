+  <script src="/transitions.js"></script>
   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root) {
+        animation: 300ms ease-in both page-fade-out;
+      }
+
+      ::view-transition-new(root) {
+        animation: 300ms ease-out both page-fade-in;
+      }
+
+      html:active-view-transition-type(next) {
+        --page-exit: -100%;
+        --page-enter: 100%;
+      }
+
+      html:active-view-transition-type(previous) {
+        --page-exit: 100%;
+        --page-enter: -100%;
+      }
+
+      html:active-view-transition-type(next)::view-transition-old(root),
+      html:active-view-transition-type(previous)::view-transition-old(root) {
+        animation: 350ms ease-in-out both page-slide-out;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(root),
+      html:active-view-transition-type(previous)::view-transition-new(root) {
+        animation: 350ms ease-in-out both page-slide-in;
+      }
+    }
+
+    @keyframes page-fade-out {
+      to { opacity: 0; }
+    }
+
+    @keyframes page-fade-in {
+      from { opacity: 0; }
+    }
+
+    @keyframes page-slide-out {
+      to { transform: translateX(var(--page-exit)); opacity: 0; }
+    }
+
+    @keyframes page-slide-in {
+      from { transform: translateX(var(--page-enter)); opacity: 0; }
+    }
+
