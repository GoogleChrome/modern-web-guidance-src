+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = [...list.querySelectorAll('[role="option"]')];
+    const selection = document.getElementById('roast-selection');
+    const orderButton = document.getElementById('order-button');
+
+    function closePicker(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openPicker(index = options.findIndex(option => option.getAttribute('aria-selected') === 'true')) {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function chooseRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      selection.replaceChildren(...[...option.querySelector('.roast-copy').children].map(child => child.cloneNode(true)));
+      trigger.querySelector('.roast-icon').replaceWith(option.querySelector('svg').cloneNode(true));
+      orderButton.href = '/order-online?roast=' + encodeURIComponent(option.dataset.roast);
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+        event.preventDefault();
+        openPicker(event.key === 'ArrowDown' ? 0 : options.length - 1);
+      }
+    });
+
+    options.forEach(option => option.addEventListener('click', () => chooseRoast(option)));
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        chooseRoast(options[index]);
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        closePicker(true);
+      } else if (event.key.length === 1) {
+        const match = options.find(option => option.querySelector('.roast-title').textContent.toLowerCase().startsWith(event.key.toLowerCase()));
+        if (match) { event.preventDefault(); match.focus(); }
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
