+    .roast-selector {
+      position: relative;
+      width: min(260px, 100%);
+      margin-top: 20px;
+      color: var(--accent);
+      text-align: left;
+    }
+
+    .roast-selector summary {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      padding: 10px 16px;
+      list-style: none;
+      cursor: pointer;
+      background: var(--primary);
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+    }
+
+    .roast-selector summary::-webkit-details-marker {
+      display: none;
+    }
+
+    .roast-arrow {
+      width: 9px;
+      height: 9px;
+      border-right: 2px solid var(--accent);
+      border-bottom: 2px solid var(--accent);
+      transform: translateY(-2px) rotate(45deg);
+    }
+
+    .roast-selector[open] .roast-arrow {
+      transform: translateY(2px) rotate(225deg);
+    }
+
+    .roast-options {
+      position: absolute;
+      top: calc(100% + 6px);
+      left: 0;
+      right: 0;
+      z-index: 10;
+      padding: 6px;
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+      background: var(--primary);
+    }
+
+    .roast-option {
+      position: relative;
+      display: block;
+      cursor: pointer;
+    }
+
+    .roast-option input {
+      position: absolute;
+      opacity: 0;
+      width: 1px;
+      height: 1px;
+    }
+
+    .roast-option span {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 8px 10px;
+      border-radius: 3px;
+      color: var(--accent);
+      background: var(--primary);
+    }
+
+    .roast-option input:checked + span,
+    .roast-option:hover span {
+      color: var(--primary);
+      background: var(--accent);
+    }
+
+    .roast-option input:checked + span::after {
+      content: '';
+      width: 7px;
+      height: 12px;
+      border-right: 2px solid var(--primary);
+      border-bottom: 2px solid var(--primary);
+      transform: translateY(-2px) rotate(45deg);
+    }
+
+    .roast-selector summary:focus-visible,
+    .roast-option input:focus-visible + span {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
