+  <script>
+    const roastSelector = document.querySelector('.roast-selector');
+    const roastSummary = roastSelector.querySelector('summary');
+
+    roastSelector.addEventListener('change', (event) => {
+      document.getElementById('selected-roast').textContent =
+        event.target.nextElementSibling.textContent;
+    });
+
+    roastSelector.querySelectorAll('input').forEach((input) => {
+      input.addEventListener('click', () => {
+        roastSelector.open = false;
+        roastSummary.focus();
+      });
+    });
+
+    document.addEventListener('click', (event) => {
+      if (!roastSelector.contains(event.target)) roastSelector.open = false;
+    });
+
+    roastSelector.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        roastSelector.open = false;
+        roastSummary.focus();
+      }
+    });
+  </script>
