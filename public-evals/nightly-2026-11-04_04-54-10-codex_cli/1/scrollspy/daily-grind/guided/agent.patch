+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.getAttribute('href')));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function setCurrent(currentLink) {
+      links.forEach(link => {
+        const active = link === currentLink;
+        link.classList.toggle('target-current', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function updateCurrent() {
+      if (nativeTracking) {
+        setCurrent(nav.querySelector('a:target-current'));
+        return;
+      }
+
+      // Pick the section with the most content visible below the sticky bar.
+      let currentLink = null;
+      let largestVisibleHeight = 0;
+      const navBottom = nav.getBoundingClientRect().bottom;
+      sections.forEach((section, index) => {
+        const bounds = section.getBoundingClientRect();
+        const visibleHeight = Math.max(0,
+          Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, navBottom));
+        if (visibleHeight > largestVisibleHeight) {
+          largestVisibleHeight = visibleHeight;
+          currentLink = links[index];
+        }
+      });
+      setCurrent(currentLink);
+    }
+
+    let observer;
+    function updateNavHeight() {
+      const height = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${height}px`);
+      if (!nativeTracking) {
+        observer?.disconnect();
+        observer = new IntersectionObserver(updateCurrent, {
+          rootMargin: `-${height}px 0px 0px 0px`,
+          threshold: Array.from({ length: 21 }, (_, index) => index / 20)
+        });
+        sections.forEach(section => observer.observe(section));
+      }
+      requestAnimationFrame(updateCurrent);
+    }
+
+    // CSS tracks the visual state natively; mirror it for assistive technology.
+    if (nativeTracking) {
+      let scheduled = false;
+      document.addEventListener('scroll', () => {
+        if (scheduled) return;
+        scheduled = true;
+        requestAnimationFrame(() => {
+          updateCurrent();
+          scheduled = false;
+        });
+      }, { passive: true });
+    }
+
+    new ResizeObserver(updateNavHeight).observe(nav);
+    window.addEventListener('resize', updateNavHeight);
+    window.addEventListener('pageshow', updateNavHeight);
+    window.addEventListener('hashchange', () => requestAnimationFrame(updateCurrent));
+    updateNavHeight();
+  </script>
+
