+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+
+    // Keep anchor destinations below the bar, including when its links wrap.
+    const updateNavHeight = () => {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.getBoundingClientRect().height}px`);
+    };
+    updateNavHeight();
+    new ResizeObserver(updateNavHeight).observe(navigation);
+
+    // CSS tracks the visible target; mirror that state for assistive technology.
+    const syncCurrentLink = () => {
+      const currentLink = navigation.querySelector('a:target-current');
+      sectionLinks.forEach(link => {
+        if (link === currentLink) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    };
+
+    let pendingFrame = false;
+    const scheduleSync = () => {
+      if (pendingFrame) return;
+      pendingFrame = true;
+      requestAnimationFrame(() => {
+        syncCurrentLink();
+        pendingFrame = false;
+      });
+    };
+    document.addEventListener('scroll', scheduleSync, { passive: true });
+    document.addEventListener('scrollend', scheduleSync);
+    window.addEventListener('resize', scheduleSync);
+    window.addEventListener('hashchange', scheduleSync);
+    window.addEventListener('pageshow', scheduleSync);
+    scheduleSync();
+  </script>
+
 </body>
 
