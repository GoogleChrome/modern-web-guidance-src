+  <script>
+    const tabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+    const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));
+
+    function selectTab(selectedIndex) {
+      tabs.forEach((tab, index) => {
+        const selected = index === selectedIndex;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panels[index].removeAttribute('hidden');
+        } else {
+          panels[index].setAttribute('hidden', 'until-found');
+        }
+      });
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => selectTab(index));
+      tab.addEventListener('keydown', event => {
+        let nextIndex;
+        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
+        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
+        else if (event.key === 'Home') nextIndex = 0;
+        else if (event.key === 'End') nextIndex = tabs.length - 1;
+        else return;
+        event.preventDefault();
+        selectTab(nextIndex);
+        tabs[nextIndex].focus();
+      });
+      // Native search and fragment navigation must also select the matching tab.
+      panels[index].addEventListener('beforematch', () => selectTab(index));
+    });
+
+    const couponButton = document.getElementById('reveal-coupon');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'Coupon revealed';
+      couponButton.disabled = true;
+    }
+
+    couponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+    couponPanel.addEventListener('beforematch', revealCoupon);
+
+    // Synchronize controls if fragment navigation revealed content during parsing.
+    const fragmentPanel = panels.findIndex(panel => '#' + panel.id === location.hash);
+    if (fragmentPanel !== -1) selectTab(fragmentPanel);
+    if (!couponPanel.hasAttribute('hidden') || location.hash === '#coupon-panel') revealCoupon();
+  </script>
