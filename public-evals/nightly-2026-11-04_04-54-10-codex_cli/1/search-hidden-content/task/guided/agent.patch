+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    // Both button activation and native search permanently reveal the panel.
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.setAttribute('aria-disabled', 'true');
+    }
+
+    couponButton.addEventListener('click', () => {
+      if (couponButton.getAttribute('aria-disabled') === 'true') return;
+      revealCoupon();
+      couponPanel.focus();
+    });
+
+    // Let find-in-page manage scrolling and focus when it discovers a match.
+    couponPanel.addEventListener('beforematch', revealCoupon);
+
+    // Preserve searchability on browsers without hidden="until-found" support.
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      revealCoupon();
+    }
+  </script>
+
 </body>
 
