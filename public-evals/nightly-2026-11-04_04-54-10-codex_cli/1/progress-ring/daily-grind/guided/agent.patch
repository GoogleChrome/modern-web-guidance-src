+    /* Loyalty Rewards */
+    .loyalty-rewards {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 32px;
+      margin-top: 40px;
+      padding: 32px;
+      border-radius: 8px;
+      background: var(--primary);
+      color: var(--light);
+    }
+
+    .loyalty-copy {
+      max-width: 480px;
+    }
+
+    .loyalty-eyebrow {
+      margin-bottom: 8px;
+      color: var(--accent);
+      font-size: 0.8rem;
+      font-weight: 600;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+    }
+
+    .loyalty-copy h2 {
+      margin-bottom: 12px;
+    }
+
+    .loyalty-rewards .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .loyalty-rewards .btn:hover {
+      background: var(--secondary);
+    }
+
+    .loyalty-rewards .btn:focus-visible {
+      outline: 2px solid var(--light);
+      outline-offset: 4px;
+    }
+
+    .rewards-ring {
+      --ring-thickness: 12px;
+      /* Keep this percentage in sync with the native progress value/max. */
+      --progress: 70%;
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 224px;
+      height: 224px;
+      flex-shrink: 0;
+      text-align: center;
+    }
+
+    .rewards-ring::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      border: var(--ring-thickness) solid transparent;
+      border-radius: 50%;
+      background: conic-gradient(var(--accent) var(--progress), var(--secondary) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+    }
+
+    @supports not (background-clip: border-area) {
+      .rewards-ring::before {
+        border: 0;
+        mask-image: radial-gradient(
+          circle closest-side,
+          transparent calc(100% - var(--ring-thickness)),
+          black calc(100% - var(--ring-thickness) + 0.5px)
+        );
+      }
+    }
+
+    .rewards-ring-content {
+      position: relative;
+      max-width: 170px;
+    }
+
+    .rewards-total {
+      font-size: 1rem;
+      color: var(--secondary);
+    }
+
+    .rewards-total strong {
+      color: var(--accent);
+      font-size: 3rem;
+      line-height: 1.2;
+    }
+
+    .rewards-ring-content small {
+      display: block;
+      margin-top: 8px;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    @media (max-width: 600px) {
+      .loyalty-rewards {
+        flex-direction: column;
+        padding: 24px;
+        text-align: center;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
