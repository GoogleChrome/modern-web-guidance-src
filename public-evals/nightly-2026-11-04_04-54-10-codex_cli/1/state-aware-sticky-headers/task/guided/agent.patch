+  <script>
+    // Match the actual navigation height, including wrapped links and font changes.
+    // The document remains the scroll root; no inner scrolling is introduced.
+    const navigation = document.querySelector('nav');
+    const updateNavigationHeight = () => {
+      document.documentElement.style.setProperty(
+        '--site-nav-height', `${navigation.getBoundingClientRect().height}px`
+      );
+    };
+    updateNavigationHeight();
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+  </script>
