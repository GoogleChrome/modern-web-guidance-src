+  <script>
+    const navigation = document.querySelector('nav');
+    const headers = [...document.querySelectorAll('.sticky-container')];
+    const needsStickyFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let framePending = false;
+
+    function updateStuckHeaders() {
+      framePending = false;
+      for (const header of headers) {
+        const bounds = header.getBoundingClientRect();
+        const sectionBounds = header.closest('section').getBoundingClientRect();
+        header.classList.toggle('is-stuck',
+          bounds.top <= navigationHeight &&
+          sectionBounds.bottom > navigationHeight + bounds.height);
+      }
+    }
+
+    function scheduleStickyUpdate() {
+      if (!framePending) {
+        framePending = true;
+        requestAnimationFrame(updateStuckHeaders);
+      }
+    }
+
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      if (needsStickyFallback) scheduleStickyUpdate();
+    }).observe(navigation);
+
+    if (needsStickyFallback) {
+      // The document is the scroll root; no nested scrolling container is used.
+      window.addEventListener('scroll', scheduleStickyUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStickyUpdate);
+      scheduleStickyUpdate();
+    }
+  </script>
+
