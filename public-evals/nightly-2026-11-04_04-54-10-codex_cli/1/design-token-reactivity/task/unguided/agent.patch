+  <script>
+    const densityToggle = document.getElementById('toggle-spacious');
+    const densityContainer = document.getElementById('target-container');
+
+    densityToggle.addEventListener('click', () => {
+      const spacious = densityToggle.getAttribute('aria-pressed') !== 'true';
+      densityContainer.style.setProperty('--layout-density', spacious ? 'spacious' : 'compact');
+      densityToggle.setAttribute('aria-pressed', String(spacious));
+    });
