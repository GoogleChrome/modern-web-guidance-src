index 0000000..2aba543
--- /dev/null
+++ b/components/daily-grind.js
@@ -0,0 +1,246 @@
+// Templates are parsed once, then cloned for each independent instance.
+const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+`;
+
+const actionStyles = `
+  ::slotted(a[slot="action"]) {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 44px;
+    margin-top: 15px;
+    padding: 10px 20px;
+    border-radius: 5px;
+    background: var(--primary, #4e342e);
+    color: white;
+    text-decoration: none;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+  ::slotted(a[slot="action"]:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
+
+function template(markup) {
+  const result = document.createElement('template');
+  // Only developer-owned static markup is passed here; content stays in slots.
+  result.innerHTML = markup;
+  return result;
+}
+
+const cardTemplate = template(`
+  <style>
+    ${baseStyles}
+    ${actionStyles}
+    :host { min-width: 0; }
+    article {
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 20px;
+      border-radius: 8px;
+      background: var(--coffee-card-background, white);
+      box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+      text-align: center;
+      overflow-wrap: anywhere;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+    }
+    ::slotted(p) { margin: 0; }
+    .description { flex: 1; }
+  </style>
+  <article part="card">
+    <slot name="heading"></slot>
+    <div class="description"><slot></slot></div>
+    <slot name="action"></slot>
+  </article>
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(cardTemplate.content.cloneNode(true));
+  }
+}
+
+const heroTemplate = template(`
+  <style>
+    ${baseStyles}
+    ${actionStyles}
+    header {
+      min-height: 60vh;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      padding: 40px 20px;
+      background-image: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+        var(--grind-hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+      background-size: cover;
+      background-position: center;
+      background-color: var(--primary, #4e342e);
+      color: white;
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+    ::slotted(p) { margin: 0; }
+  </style>
+  <header part="hero">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </header>
+`);
+
+export class GrindHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(heroTemplate.content.cloneNode(true));
+  }
+}
+
+const navigationTemplate = template(`
+  <style>
+    ${baseStyles}
+    :host { position: sticky; top: 0; z-index: 1000; }
+    nav {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      padding: 1rem 5%;
+      background: var(--primary, #4e342e);
+      color: white;
+    }
+    .links { display: flex; align-items: center; gap: 20px; }
+    .links[hidden] { display: none; }
+    ::slotted(a) {
+      display: inline-flex;
+      align-items: center;
+      min-height: 44px;
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+    }
+    ::slotted(a[slot="brand"]) {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+    ::slotted(a:hover) { color: var(--accent, #ffab40); }
+    ::slotted(.logout-link) {
+      border: 1px solid var(--accent, #ffab40);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+    button {
+      min-height: 44px;
+      padding: 8px 14px;
+      border: 1px solid var(--accent, #ffab40);
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      cursor: pointer;
+    }
+    button[hidden] { display: none; }
+    button:focus-visible, ::slotted(a:focus-visible) {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 4px;
+    }
+    @media (max-width: 48rem) {
+      nav { flex-wrap: wrap; }
+      .links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 4px; }
+      ::slotted(a[slot="brand"]) { font-size: 1.15rem; }
+    }
+  </style>
+  <nav aria-label="Primary" part="navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="navigation-links" hidden>Menu</button>
+    <div class="links" id="navigation-links"><slot></slot></div>
+  </nav>
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(navigationTemplate.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('.links');
+  }
+
+  connectedCallback() {
+    // A fresh controller makes disconnect/reconnect safe without duplicate listeners.
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const { signal } = this.#controller;
+    this.#media = window.matchMedia('(max-width: 48rem)');
+    this.#media.addEventListener('change', () => this.#syncLayout(), { signal });
+    this.#button.addEventListener('click', () => {
+      this.#setOpen(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        event.preventDefault();
+        this.#setOpen(false);
+        this.#button.focus();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      const link = event.composedPath().find(node => node instanceof HTMLAnchorElement);
+      if (link && link.slot !== 'brand' && this.#media.matches) {
+        this.#setOpen(false);
+        this.#button.focus();
+      }
+    }, { signal });
+    this.#syncLayout();
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #setOpen(open) {
+    this.#button.setAttribute('aria-expanded', String(open));
+    this.#links.hidden = !open;
+  }
+
+  #syncLayout() {
+    const focused = this.shadowRoot.activeElement ?? document.activeElement;
+    const wasInLinks = this.contains(focused) && focused?.slot !== 'brand';
+    if (this.#media.matches) {
+      this.#button.hidden = false;
+      this.#setOpen(false);
+      if (wasInLinks) this.#button.focus();
+    } else {
+      this.#setOpen(true);
+      if (focused === this.#button) {
+        this.querySelector('a:not([slot="brand"])')?.focus();
+      }
+      this.#button.hidden = true;
+    }
+  }
+}
+
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard],
+  ['grind-hero', GrindHero],
+  ['grind-navigation', GrindNavigation],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
