diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..f12e158
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,81 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+body {
+  margin: 0;
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--light);
+}
+
+.skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  z-index: 1001;
+  padding: 10px 20px;
+  background: white;
+  color: var(--primary);
+  transform: translateY(-150%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+  scroll-margin-top: 6rem;
+}
+
+#seasonal-heading { text-align: center; }
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  display: flex;
+  justify-content: center;
+  flex-wrap: wrap;
+  gap: 0 20px;
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  color: var(--text);
+  font-size: 0.85rem;
+  text-underline-offset: 3px;
+}
+
+.footer-links a:focus-visible {
+  outline: 3px solid var(--primary);
+  outline-offset: 3px;
+}
+
+/* Unupgraded content remains readable and links remain usable without JS. */
+grind-navigation:not(:defined), grind-hero:not(:defined), coffee-card:not(:defined) {
+  display: block;
+  padding: 20px;
+}
+
+grind-navigation:not(:defined) a { display: inline-block; margin: 8px; }
