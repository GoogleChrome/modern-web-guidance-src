+const sharedStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 5px;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    *, ::slotted(*) { transition: none !important; }
+  }
+`;
+
+// Templates contain only static markup; page content stays in named slots.
+class GrindElement extends HTMLElement {
+  mount(markup) {
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = markup;
+    return root;
+  }
+}
+
+class CoffeeCard extends GrindElement {
+  constructor() {
+    super();
+    this.mount(`
+      <style>
+        ${sharedStyles}
+        :host { height: 100%; }
+        article {
+          height: 100%; padding: 20px; background: white; border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 10%); text-align: center;
+          display: flex; flex-direction: column; align-items: center;
+        }
+        ::slotted([slot="title"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        ::slotted([slot="description"]) { margin: 0 0 auto; }
+        ::slotted([slot="action"]) {
+          display: inline-block; margin-top: 15px; padding: 10px 20px;
+          background: var(--primary, #4e342e); color: white;
+          text-decoration: none; border-radius: 5px; transition: background .3s;
+        }
+        ::slotted([slot="action"]:hover) { background: #3e2723; }
+      </style>
+      <article>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </article>
+    `);
+  }
+}
+
+class CoffeeCollection extends GrindElement {
+  constructor() {
+    super();
+    this.mount(`
+      <style>
+        ${sharedStyles}
+        ::slotted([slot="heading"]) { margin: 0; text-align: center; }
+        .grid {
+          display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+          gap: 20px; margin-top: 20px;
+        }
+      </style>
+      <slot name="heading"></slot>
+      <div class="grid"><slot></slot></div>
+    `);
+  }
+}
+
+class CoffeeHero extends GrindElement {
+  constructor() {
+    super();
+    this.mount(`
+      <style>
+        ${sharedStyles}
+        :host {
+          --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+        }
+        .hero {
+          min-height: 60vh; padding: 50px 20px;
+          background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)), var(--hero-image);
+          background-size: cover; background-position: center;
+          display: flex; flex-direction: column; justify-content: center; align-items: center;
+          color: white; text-align: center;
+        }
+        ::slotted([slot="heading"]) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+        ::slotted([slot="description"]) { margin: 0; }
+        ::slotted([slot="action"]) {
+          display: inline-block; background: var(--primary, #4e342e); color: white;
+          padding: 10px 20px; text-decoration: none; border-radius: 5px;
+          margin-top: 15px; transition: background .3s;
+        }
+        ::slotted([slot="action"]:hover) { background: #3e2723; }
+      </style>
+      <div class="hero">
+        <slot name="heading"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </div>
+    `);
+  }
+}
+
+class GrindNavigation extends GrindElement {
+  constructor() {
+    super();
+    const root = this.mount(`
+      <style>
+        ${sharedStyles}
+        :host { position: sticky; top: 0; z-index: 1000; }
+        nav {
+          background: var(--primary, #4e342e); color: white; padding: 1rem 5%;
+          display: flex; justify-content: space-between; align-items: center; gap: 20px;
+        }
+        ::slotted([slot="brand"]) {
+          color: white; text-decoration: none; font-size: 1.5rem;
+          font-weight: bold; letter-spacing: 1px;
+        }
+        .links { display: flex; align-items: center; gap: 20px; }
+        .links[hidden], button[hidden] { display: none; }
+        ::slotted([slot="link"]) {
+          color: white; text-decoration: none; font-size: .9rem; transition: color .3s;
+        }
+        ::slotted([slot="link"]:hover) { color: var(--accent, #ffab40); }
+        ::slotted([slot="link"][data-outlined]) {
+          border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px;
+        }
+        button {
+          background: transparent; color: white; border: 1px solid var(--accent, #ffab40);
+          border-radius: 4px; padding: 10px 14px; font: inherit; cursor: pointer;
+          min-height: 44px;
+        }
+        @media (max-width: 760px) {
+          nav { flex-wrap: wrap; }
+          ::slotted([slot="brand"]) { font-size: 1.2rem; }
+          .links { flex: 1 0 100%; flex-direction: column; align-items: stretch; gap: 0; }
+          ::slotted([slot="link"]) { padding: 12px; }
+        }
+      </style>
+      <nav aria-label="Primary">
+        <slot name="brand"></slot>
+        <button type="button" aria-expanded="false" aria-controls="navigation-links" hidden>Menu</button>
+        <div class="links" id="navigation-links"><slot name="link"></slot></div>
+      </nav>
+    `);
+    this.toggle = root.querySelector('button');
+    this.links = root.querySelector('.links');
+    this.mobile = window.matchMedia('(max-width: 760px)');
+    this.onViewportChange = () => {
+      this.toggle.hidden = !this.mobile.matches;
+      this.setOpen(false);
+    };
+    this.onToggle = () => this.setOpen(this.toggle.getAttribute('aria-expanded') !== 'true');
+    this.onKeydown = (event) => {
+      if (event.key === 'Escape' && this.toggle.getAttribute('aria-expanded') === 'true') {
+        this.setOpen(false);
+        this.toggle.focus();
+      }
+    };
+    this.onLinkClick = (event) => {
+      if (event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.setOpen(false);
+      }
+    };
+  }
+
+  setOpen(open) {
+    this.toggle.setAttribute('aria-expanded', String(open));
+    this.links.hidden = this.mobile.matches && !open;
+  }
+
+  connectedCallback() {
+    this.onViewportChange();
+    this.mobile.addEventListener('change', this.onViewportChange);
+    this.toggle.addEventListener('click', this.onToggle);
+    this.addEventListener('keydown', this.onKeydown);
+    this.links.addEventListener('click', this.onLinkClick);
+  }
+
+  disconnectedCallback() {
+    this.mobile.removeEventListener('change', this.onViewportChange);
+    this.toggle.removeEventListener('click', this.onToggle);
+    this.removeEventListener('keydown', this.onKeydown);
+    this.links.removeEventListener('click', this.onLinkClick);
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+customElements.define('coffee-collection', CoffeeCollection);
+customElements.define('coffee-hero', CoffeeHero);
+customElements.define('grind-navigation', GrindNavigation);
