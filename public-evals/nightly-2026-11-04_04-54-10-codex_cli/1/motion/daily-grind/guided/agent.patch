+  <script>
+    (() => {
+      // Prefer the exact animation supplied by the event, including pseudo-elements.
+      // Older browsers still report a useful lifecycle state without guessing an object.
+      const eventStates = {
+        animationstart: 'running', animationiteration: 'running',
+        animationend: 'finished', animationcancel: 'idle',
+        transitionrun: 'running', transitionstart: 'running',
+        transitionend: 'finished', transitioncancel: 'idle',
+      };
+      const inspectAnimation = (event) => {
+        const animation = event.animation;
+        document.body.dataset.lastAnimationState = animation?.playState ?? eventStates[event.type];
+      };
+      Object.keys(eventStates).forEach((type) => {
+        document.addEventListener(type, inspectAnimation);
+      });
+
+      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const banner = document.querySelector('.roast-banner');
+      const motionToggle = document.querySelector('.motion-toggle');
+      let userPaused = false;
+      function updateBanner() {
+        const reduced = motionPreference.matches;
+        const paused = reduced || userPaused;
+        banner.dataset.paused = String(paused);
+        motionToggle.disabled = reduced;
+        motionToggle.textContent = reduced ? 'Motion off' : paused ? 'Resume' : 'Pause';
+        motionToggle.setAttribute('aria-pressed', String(paused));
+        motionToggle.setAttribute('aria-label', reduced
+          ? 'Daily roast animation off: reduced motion preference'
+          : `${paused ? 'Resume' : 'Pause'} daily roast animation`);
+      }
+      motionToggle.addEventListener('click', () => {
+        userPaused = !userPaused;
+        updateBanner();
+      });
+      motionPreference.addEventListener('change', updateBanner);
+      updateBanner();
+
+      const drinks = {
+        seasonal: {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup. A cozy blend of espresso, velvety oat milk, and gentle maple sweetness.',
+          notes: 'Tasting notes: maple, toasted oats, and a smooth espresso finish. Contains oats.',
+        },
+        espresso: {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost. Our dark roast brings rich, full-bodied flavor to every small, carefully pulled cup.',
+          notes: 'Tasting notes: dark chocolate, toasted nuts, and a lingering roasted finish.',
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness. Slowly brewed and served over ice for a refreshing, mellow coffee moment.',
+          notes: 'Tasting notes: cocoa, subtle sweetness, and a clean, smooth finish.',
+        },
+      };
+      const dialog = document.querySelector('#drink-details');
+      document.querySelectorAll('[data-drink]').forEach((button) => {
+        button.addEventListener('click', () => {
+          const drink = drinks[button.dataset.drink];
+          document.querySelector('#drink-title').textContent = drink.name;
+          document.querySelector('#drink-description').textContent = drink.description;
+          document.querySelector('#drink-notes').textContent = drink.notes;
+          dialog.showModal();
+        });
+      });
+
+      let displayTransitionsSupported;
+      function supportsTopLayerExit() {
+        if (!window.CSS?.supports('overlay', 'auto') ||
+            !CSS.supports('transition-behavior', 'allow-discrete')) return false;
+        if (displayTransitionsSupported === undefined) {
+          // Parsing allow-discrete alone does not guarantee display transitions work.
+          const probe = document.createElement('div');
+          probe.style.cssText = 'position:fixed;visibility:hidden;transition:display 1s allow-discrete !important;display:block';
+          document.body.append(probe);
+          getComputedStyle(probe).display;
+          probe.style.display = 'none';
+          displayTransitionsSupported = getComputedStyle(probe).display === 'block';
+          probe.remove();
+        }
+        return displayTransitionsSupported;
+      }
+
+      async function closeDetails() {
+        if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+        if (supportsTopLayerExit()) {
+          dialog.close();
+          return;
+        }
+        // Keep the modal and backdrop in the top layer until the exit finishes.
+        dialog.setAttribute('data-closing', '');
+        const animations = dialog.getAnimations({ subtree: true });
+        let timeout;
+        try {
+          await Promise.race([
+            Promise.allSettled(animations.map((animation) => animation.finished)),
+            new Promise((resolve) => { timeout = setTimeout(resolve, 600); }),
+          ]);
+          dialog.close();
+        } finally {
+          clearTimeout(timeout);
+          dialog.removeAttribute('data-closing');
+        }
+      }
+      document.querySelector('#close-details').addEventListener('click', closeDetails);
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        closeDetails();
+      });
+      const outsideDialog = (event) => {
+        const bounds = dialog.getBoundingClientRect();
+        return event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (event) => {
+        pressedOutside = outsideDialog(event);
+      });
+      dialog.addEventListener('pointerup', (event) => {
+        if (pressedOutside && outsideDialog(event)) closeDetails();
+        pressedOutside = false;
+      });
+      dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+    })();
+  </script>
