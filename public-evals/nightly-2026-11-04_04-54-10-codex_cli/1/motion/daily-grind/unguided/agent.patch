+    // Playback events expose the Animation itself as currentTarget. CSS events
+    // expose names instead; resolve the matching object only for those events.
+    function inspectAnimation(event) {
+      const animation = event.animation ??
+        (event.currentTarget instanceof Animation ? event.currentTarget :
+          event.target.getAnimations?.().find(candidate =>
+            (event.animationName && candidate.animationName === event.animationName) ||
+            (event.propertyName && candidate.transitionProperty === event.propertyName)));
+      document.body.dataset.lastAnimationState = animation?.playState ??
+        (event.type.endsWith('cancel') ? 'idle' :
+          event.type.endsWith('end') || event.type === 'finish' ? 'finished' : 'running');
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, inspectAnimation);
+    }
+    function observePlayback(animation) {
+      animation.addEventListener('finish', inspectAnimation);
+      animation.addEventListener('cancel', inspectAnimation);
+      document.body.dataset.lastAnimationState = animation.playState;
+      return animation;
+    }
+    function setRoastPaused(paused) {
+      roastTrack.style.animationPlayState = paused ? 'paused' : 'running';
+      roastControl.textContent = paused ? 'Resume' : 'Pause';
+      roastControl.setAttribute('aria-pressed', String(paused));
+      roastControl.setAttribute('aria-label', `${paused ? 'Resume' : 'Pause'} daily roast animation`);
+      const animation = roastTrack.getAnimations()[0];
+      if (animation) document.body.dataset.lastAnimationState = animation.playState;
+    }
+    setRoastPaused(motionPreference.matches);
+    roastControl.addEventListener('click', () => {
+      setRoastPaused(roastControl.getAttribute('aria-pressed') !== 'true');
+    });
+
+    const drinks = {
