+  <script>
+    const favorites = [
+      {
+        id: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        story: 'Our signature espresso meets steamed oat milk and a touch of maple sweetness. A cozy cup for crisp mornings, finished with a delicate layer of foam.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1400&q=85'
+      },
+      {
+        id: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        story: 'Carefully roasted beans bring deep cocoa notes and a rich, lingering finish. Pulled fresh for a full-bodied espresso with a golden crema.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1400&q=85'
+      },
+      {
+        id: 'cold-brew',
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        story: 'Slow-steeped coffee served over ice for a mellow, refreshing cup. Enjoy its naturally rounded flavor on its own or add a splash of your favorite milk.',
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1400&q=85'
+      }
+    ];
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('favorites');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let activeId = null;
+    let listScroll = 0;
+    let currentTransition = null;
+    let navigation = Promise.resolve();
+
+    for (const favorite of favorites) {
+      const card = document.createElement('a');
+      card.className = 'thumbnail';
+      card.href = `#seasonal/${favorite.id}`;
+      card.dataset.id = favorite.id;
+      card.style.setProperty('--coffee-image', `url("${favorite.image}")`);
+      const heading = document.createElement('h2');
+      heading.className = 'title';
+      heading.textContent = favorite.title;
+      const hint = document.createElement('span');
+      hint.className = 'detail-hint';
+      hint.textContent = 'View Details →';
+      card.append(heading, hint);
+      grid.append(card);
+    }
+
+    function routeId() {
+      const id = location.hash.startsWith('#seasonal/') ? location.hash.slice(10) : null;
+      return favorites.some(favorite => favorite.id === id) ? id : null;
+    }
+
+    async function showView(id) {
+      if (id === activeId) return;
+      const favorite = favorites.find(item => item.id === id);
+      const selectedId = id || activeId;
+      const card = grid.querySelector(`[data-id="${selectedId}"]`);
+      const cardTitle = card.querySelector('.title');
+      if (!activeId) listScroll = window.scrollY;
+      const update = () => {
+        if (favorite) {
+          title.textContent = favorite.title;
+          hero.style.setProperty('--coffee-image', `url("${favorite.image}")`);
+          document.getElementById('description').textContent = favorite.description;
+          document.getElementById('story').textContent = favorite.story;
+        }
+        listPage.hidden = Boolean(id);
+        detailPage.hidden = !id;
+        activeId = id;
+        document.title = favorite ? `${favorite.title} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+        window.scrollTo({ top: id ? 0 : listScroll, behavior: 'instant' });
+      };
+      const cleanup = () => {
+        for (const element of [card, cardTitle, hero, title]) {
+          element.style.removeProperty('view-transition-name');
+        }
+        currentTransition = null;
+        (id ? title : listHeading).focus({ preventScroll: true });
+      };
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        cleanup();
+        return;
+      }
+      card.style.viewTransitionName = hero.style.viewTransitionName = 'coffee-hero';
+      cardTitle.style.viewTransitionName = title.style.viewTransitionName = 'coffee-title';
+      try {
+        currentTransition = document.startViewTransition(update);
+        await currentTransition.finished;
+      } catch (error) {
+        // A skipped or failed capture must still complete navigation.
+        if (activeId !== id) update();
+      } finally {
+        cleanup();
+      }
+    }
+
+    function navigate(id) {
+      // Serialize captures so rapid clicks and history changes cannot reuse names.
+      navigation = navigation.then(() => showView(id));
+      return navigation;
+    }
+
+    grid.addEventListener('click', event => {
+      const card = event.target.closest('.thumbnail');
+      if (!card || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      if (routeId() === card.dataset.id) return;
+      history.pushState({ seasonalFromList: true }, '', card.href);
+      navigate(card.dataset.id);
+    });
+    document.getElementById('back-button').addEventListener('click', () => {
+      if (history.state?.seasonalFromList) {
+        history.back();
+      } else {
+        history.replaceState(null, '', '#list-heading');
+        navigate(null);
+      }
+    });
+    window.addEventListener('popstate', () => navigate(routeId()));
+    window.addEventListener('hashchange', () => navigate(routeId()));
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) currentTransition?.skipTransition();
+    });
+    // Direct detail links use the same route, without an initial animation.
+    const initialId = routeId();
+    if (initialId) {
+      // Initial rendering has no previous view to morph from.
+      const favorite = favorites.find(item => item.id === initialId);
+      title.textContent = favorite.title;
+      hero.style.setProperty('--coffee-image', `url("${favorite.image}")`);
+      document.getElementById('description').textContent = favorite.description;
+      document.getElementById('story').textContent = favorite.story;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      activeId = initialId;
+      document.title = `${favorite.title} | The Daily Grind`;
+      title.focus({ preventScroll: true });
+    }
+  </script>
