+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = newsletter.elements.email;
+    const status = newsletter.querySelector('.newsletter-status');
+
+    // Use native email constraints, with feedback deferred until the field blurs.
+    newsletter.noValidate = true;
+    email.addEventListener('blur', () => {
+      email.setAttribute('aria-invalid', String(!email.validity.valid));
+    });
+    email.addEventListener('focus', () => {
+      email.removeAttribute('aria-invalid');
+    });
+    email.addEventListener('input', () => {
+      status.textContent = '';
+    });
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!email.validity.valid) {
+        email.focus();
+        return;
+      }
+
+      // Replace this message with a signup request when a service is configured.
+      status.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
