new file mode 100644
index 0000000..c733251
--- /dev/null
+++ b/src/scripts/playground.ts
@@ -0,0 +1,152 @@
+const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = $<HTMLCanvasElement>('render-canvas');
+const context = canvas.getContext('2d');
+const preview = $('preview');
+const samples = $<HTMLSelectElement>('samples');
+const resolution = $<HTMLSelectElement>('resolution');
+const randomize = $<HTMLButtonElement>('randomize');
+const download = $<HTMLButtonElement>('download');
+const status = $('render-status');
+const progress = document.querySelector<HTMLElement>('[role="progressbar"]')!;
+const defaults = [[.37,.54,.32], [.73,.41,.27], [.999,.999,.999], [.999,.999,.999], [.75,.75,.68]];
+const names = ['Left wall', 'Right wall', 'Mirror sphere', 'Glass sphere', 'Floor'];
+let colors = defaults.map(color => [...color]);
+let worker: Worker | null = null;
+let finished = false;
+let rendering = false;
+let renderedSamples = 32;
+let renderedWidth = 640;
+let sceneSeed = 42;
+
+function palette() {
+  $('palette').replaceChildren(...colors.map((color, i) => {
+    const swatch = document.createElement('span');
+    swatch.className = 'swatch';
+    const hex = '#' + color.map(c => Math.round(c * 255).toString(16).padStart(2, '0')).join('');
+    swatch.style.backgroundColor = hex;
+    swatch.title = `${names[i]}: ${hex}`;
+    swatch.setAttribute('aria-label', `${names[i]}: ${hex}`);
+    return swatch;
+  }));
+}
+
+function setProgress(value: number) {
+  $('progress-fill').style.width = `${value * 100}%`;
+  progress.setAttribute('aria-valuenow', String(Math.round(value * 100)));
+}
+
+function showError(message: string) {
+  rendering = false;
+  $('status-dot').classList.remove('busy');
+  status.textContent = 'Render failed — try again';
+  status.title = message;
+  $('viewport-status').textContent = 'RENDER UNAVAILABLE';
+  randomize.querySelector('span')!.textContent = 'Retry render';
+  download.disabled = !finished;
+  worker?.terminate();
+  worker = null;
+  console.error('smallpt:', message);
+}
+
+function render() {
+  if (!context || !('WebAssembly' in window) || !('Worker' in window)) {
+    showError('This renderer needs WebAssembly, Web Workers, and a 2D canvas.');
+    return;
+  }
+  // Terminating a previous worker gives immediate cancellation, even in native code.
+  worker?.terminate();
+  rendering = true;
+  finished = false;
+  renderedWidth = Number(resolution.value);
+  renderedSamples = Number(samples.value);
+  canvas.width = renderedWidth;
+  canvas.height = renderedWidth * 3 / 4;
+  context.fillStyle = '#171c17';
+  context.fillRect(0, 0, canvas.width, canvas.height);
+  const image = preview as HTMLImageElement;
+  if (image.complete && image.naturalWidth) context.drawImage(image, 0, 0, canvas.width, canvas.height);
+  canvas.classList.add('visible');
+  setProgress(0);
+  download.disabled = true;
+  $('status-dot').classList.add('busy');
+  status.textContent = 'Starting render…';
+  $('viewport-status').textContent = 'TRACING LIGHT';
+  randomize.querySelector('span')!.textContent = 'Randomize & restart';
+  $('render-meta').replaceChildren(document.createTextNode(`${canvas.width} × ${canvas.height}  ·  ${renderedSamples} samples / pixel`));
+  try {
+    worker = new Worker('/wasm/render-worker.js', { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'progress') {
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), canvas.width, data.rows), 0, data.row);
+        setProgress(data.progress);
+        status.textContent = `Rendering ${Math.round(data.progress * 100)}% · ${(data.elapsed / 1000).toFixed(1)}s`;
+      } else if (data.type === 'done') {
+        rendering = false;
+        finished = true;
+        preview.classList.add('hidden');
+        setProgress(1);
+        status.textContent = `Render complete · ${(data.elapsed / 1000).toFixed(1)}s`;
+        $('status-dot').classList.remove('busy');
+        $('viewport-status').textContent = 'RENDER COMPLETE';
+        randomize.querySelector('span')!.textContent = 'Randomize & render';
+        download.disabled = false;
+        worker?.terminate();
+        worker = null;
+      } else if (data.type === 'error') showError(data.message);
+    };
+    worker.onerror = event => showError(event.message || 'The rendering worker could not load.');
+    worker.postMessage({ width: canvas.width, height: canvas.height, samples: renderedSamples, seed: sceneSeed, colors });
+  } catch (error) {
+    showError(String(error));
+  }
+}
+
+randomize.addEventListener('click', () => {
+  const random = new Uint32Array(16);
+  crypto.getRandomValues(random);
+  const value = (i: number) => random[i] / 0xffffffff;
+  colors = colors.map((_, i) => Array.from({ length: 3 }, (_, j) => {
+    // Light tints preserve reflective and transmissive paths in the two spheres.
+    return i === 2 || i === 3 ? .55 + value(i * 3 + j) * .449 : .2 + value(i * 3 + j) * .6;
+  }));
+  sceneSeed = random[15];
+  palette();
+  render();
+});
+$('reset').addEventListener('click', () => {
+  colors = defaults.map(color => [...color]);
+  sceneSeed = 42;
+  palette();
+  render();
+});
+samples.addEventListener('change', render);
+resolution.addEventListener('change', render);
+download.addEventListener('click', () => {
+  if (!finished || rendering) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.download = `smallpt-${sceneSeed}-${renderedWidth}px-${renderedSamples}spp.png`;
+    link.href = url;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+$('expand').addEventListener('click', async () => {
+  const viewport = $('viewport');
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else if (viewport.requestFullscreen) await viewport.requestFullscreen();
+    else {
+      const url = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = 'smallpt-expanded.png';
+      link.click();
+    }
+  } catch (error) { console.warn('Fullscreen unavailable:', error); }
+});
+window.addEventListener('pagehide', () => worker?.terminate());
+palette();
+void (preview as HTMLImageElement).decode().catch(() => undefined).then(render);
