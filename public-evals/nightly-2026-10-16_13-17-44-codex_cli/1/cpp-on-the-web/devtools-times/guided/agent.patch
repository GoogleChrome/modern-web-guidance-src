@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ native/smallpt.cpp -O3 -flto -fno-exceptions -nostdlib++ --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sENVIRONMENT=web,worker \
+  -sSTRICT=1 -sALLOW_MEMORY_GROWTH=1 -sASSERTIONS=1 -sSTACK_SIZE=5242880 -sSTACK_OVERFLOW_CHECK=2 \
+  -sINCOMING_MODULE_JS_API='["wasmBinary"]' -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -sEXPORTED_FUNCTIONS='["_init_scene","_set_color","_render_rows","_get_pixels"]' \
+  -o public/wasm/smallpt.js
diff --git a/scripts/test-wasm.mjs b/scripts/test-wasm.mjs
new file mode 100644
index 0000000..2a41389
--- /dev/null
+++ b/scripts/test-wasm.mjs
@@ -0,0 +1,57 @@
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+// Execute the actual browser module in an isolated worker-like JS context.
+// No browser, DOM, or alternative native implementation is used.
+const source = await readFile(new URL('../public/wasm/smallpt.js', import.meta.url), 'utf8');
+const createSmallpt = vm.runInNewContext(source
+  .replaceAll('import.meta.url', JSON.stringify('https://localhost/wasm/smallpt.js'))
+  .replace('export default Module;', 'Module;'), {
+    console, URL, WebAssembly, WorkerGlobalScope: class {},
+    TextDecoder, TextEncoder, setTimeout, clearTimeout,
+  });
+
+const binary = await readFile(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+const module = await createSmallpt({ wasmBinary: binary });
+const colors = [[.37,.54,.32],[.73,.41,.27],[.999,.999,.999],[.999,.999,.999],[.75,.75,.68]];
+function render(width, height, samples, seed, palette = colors, batch = height) {
+  module._init_scene(width, height, samples, seed);
+  [0,1,6,7,4].forEach((sphere,i) => module._set_color(sphere, ...palette[i]));
+  for (let row=0; row<height; row+=batch) module._render_rows(row, Math.min(batch,height-row));
+  const pointer=module._get_pixels();
+  return module.HEAPU8.slice(pointer,pointer+width*height*4);
+}
+const original = render(40,30,16,42);
+assert.equal(original.length,40*30*4);
+assert.ok(original.some((n,i) => i%4!==3 && n>50), 'Rendered image must contain visible light');
+assert.ok(original.every((n,i) => i%4!==3 || n===255), 'All pixels must be opaque');
+assert.deepEqual(render(40,30,16,42,colors,4),original,'Batched rendering must match a full-frame render');
+assert.deepEqual(render(40,30,16,42),original,'A repeated seed must reproduce the image');
+const tinted=colors.map(c => [...c]);
+tinted[2]=[.6,.9,.65]; tinted[3]=[.9,.65,.6];
+assert.notDeepEqual(render(40,30,16,42,tinted),original,'Changing only the sphere colors must change the rendered image');
+assert.notDeepEqual(render(40,30,16,73),original,'New seeds must change sampling');
+const frame = render(320,240,16,42,colors,4);
+assert.equal(frame.length,320*240*4);
+assert.ok(frame.every((n,i) => i%4!==3 || n===255));
+const messages = [];
+const workerSelf = { postMessage: message => messages.push(message) };
+const workerSource = await readFile(new URL('../public/wasm/render-worker.js', import.meta.url), 'utf8');
+vm.runInNewContext(workerSource.replace("import createSmallpt from './smallpt.js';", ''), {
+  self: workerSelf, createSmallpt: () => createSmallpt({ wasmBinary: binary }), performance,
+});
+await workerSelf.onmessage({ data: {width:40,height:30,samples:16,seed:42,colors} });
+assert.equal(messages.at(-1).type, 'done', 'Worker must finish successfully');
+const assembled = new Uint8Array(40*30*4);
+for (const message of messages.filter(m => m.type === 'progress')) {
+  assembled.set(message.pixels, message.row*40*4);
+}
+assert.deepEqual(assembled, new Uint8Array(original), 'Worker protocol must deliver the same rendered pixels');
+assert.equal(messages.at(-2).progress, 1, 'Worker must report 100% progress');
+console.log('WASM checks passed: RGBA, row batches, seeds, sphere colors, a 320×240 frame, and the worker progress protocol.');
+if(process.argv.includes('--preview')) {
+  const sharp = (await import('sharp')).default;
+  const pixels = render(800,600,128,42);
+  await sharp(Buffer.from(pixels), {raw:{width:800,height:600,channels:4}}).png().toFile('public/render-preview.png');
+  console.log('Saved preview rendered by the compiled WASM module.');
+}
