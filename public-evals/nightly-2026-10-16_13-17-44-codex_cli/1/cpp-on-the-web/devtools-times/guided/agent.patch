@@ -0,0 +1,28 @@
+import createSmallpt from './smallpt.js';
+
+let renderer;
+let rendering = false;
+self.onmessage = async ({ data }) => {
+  if (rendering) return;
+  rendering = true;
+  try {
+    renderer ||= await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    renderer._init_scene(width, height, samples, seed);
+    [0, 1, 6, 7, 4].forEach((sphere, i) => renderer._set_color(sphere, ...colors[i]));
+    const start = performance.now();
+    // Small batches keep progress updates frequent without copying the full frame.
