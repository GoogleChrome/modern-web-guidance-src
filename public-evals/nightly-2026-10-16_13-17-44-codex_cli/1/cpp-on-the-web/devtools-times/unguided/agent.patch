+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm public/renderer
+cp renderer/smallpt.cpp renderer/LICENSE.txt public/renderer/
+emcc renderer/smallpt.cpp -O3 --no-entry \
+  -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node \
+  -s ALLOW_MEMORY_GROWTH=1 -s FILESYSTEM=0 -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -s EXPORTED_FUNCTIONS='["_init","_set_color","_buffer","_render_rows","_finish_pass"]' \
+  -o public/wasm/smallpt.js
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..869e561
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/wasm/smallpt.js';
+const module = await createSmallpt();
+function frame(color, seed = 42) {
+  module._init(32, 24, seed);
+  module._set_color(6, ...color);
+  module._set_color(7, ...color);
+  module._render_rows(0, 24);
+  module._finish_pass();
+  return module.HEAPU8.slice(module._buffer(), module._buffer() + 32 * 24 * 4);
+}
+const neutral = frame([.98, .98, .98]);
+assert(neutral.some((value, i) => i % 4 !== 3 && value > 0), 'Rendered RGB pixels must contain light');
+assert(neutral.every((value, i) => i % 4 !== 3 || value === 255), 'All pixels must be opaque');
+assert.deepEqual(frame([.98, .98, .98]), neutral, 'Resetting the same seed must reproduce the image');
+assert.notDeepEqual(frame([.9, .3, .3]), neutral, 'Changing sphere colors must change the rendered output');
+console.log('WebAssembly check passed: nonempty render, opaque pixels, deterministic reset, and working color changes.');
