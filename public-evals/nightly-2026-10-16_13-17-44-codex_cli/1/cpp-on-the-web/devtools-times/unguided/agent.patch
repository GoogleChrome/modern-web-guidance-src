new file mode 100644
index 0000000..ae2407b
--- /dev/null
+++ b/src/scripts/playground.ts
@@ -0,0 +1,115 @@
+const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = $<HTMLCanvasElement>('render-canvas');
+const ctx = canvas.getContext('2d')!;
+const samples = $<HTMLSelectElement>('samples');
+const resolution = $<HTMLSelectElement>('resolution');
+const colorInputs = [$<HTMLInputElement>('mirror'), $<HTMLInputElement>('glass')];
+const renderButton = $<HTMLButtonElement>('render-button');
+let worker: Worker | undefined;
+let running = false;
+let hasFrame = false;
+let requestId = 0;
+function setRunning(value: boolean) {
+  running = value;
+  renderButton.querySelector('span')!.textContent = value ? 'Stop rendering' : 'Render scene';
+  renderButton.querySelector('path')!.setAttribute('d', value ? 'M6 6h12v12H6z' : 'm8 5 11 7-11 7z');
+  document.querySelector('.render-status')!.classList.toggle('is-rendering', value);
+}
+function stop() {
+  worker?.terminate();
+  worker = undefined;
+  requestId++;
+  setRunning(false);
+}
+function render() {
+  stop();
+  const id = requestId;
+  const width = Number(resolution.value), height = width * .75;
+  const target = Number(samples.value);
+  setRunning(true);
+  $('status-text').textContent = 'Tracing light…';
+  $('progress').style.width = '0%';
+  $('current-samples').textContent = '0';
+  $('elapsed').textContent = '0.0 sec';
+  worker = new Worker('/wasm/render-worker.js', { type: 'module' });
+  const fail = () => {
+    if (id !== requestId) return;
+    stop();
+    $('status-text').textContent = 'Could not load renderer. Try again.';
+  };
+  worker.onerror = fail;
+  worker.onmessage = ({ data }) => {
+    if (id !== requestId) return;
+    if (data.type === 'frame') {
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width; canvas.height = data.height;
+      }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      canvas.style.opacity = '1'; hasFrame = true;
+      $('dimensions').textContent = `${data.width} × ${data.height}`;
+      $('current-samples').textContent = String(data.samples);
+      $('elapsed').textContent = `${data.elapsed.toFixed(1)} sec`;
+      $('progress').style.width = `${data.progress * 100}%`;
+      $('status-text').textContent = `Rendering · ${Math.round(data.progress * 100)}%`;
+    } else if (data.type === 'done') {
+      setRunning(false);
+      $('status-text').textContent = 'Render complete';
+      worker?.terminate(); worker = undefined;
+    } else if (data.type === 'error') fail();
+  };
+  worker.postMessage({ width, height, samples: target, seed: crypto.getRandomValues(new Uint32Array(1))[0],
+    colors: colorInputs.map(input => [1, 3, 5].map(i => parseInt(input.value.slice(i, i + 2), 16) / 255)) });
+}
+renderButton.addEventListener('click', () => {
+  if (running) { stop(); $('status-text').textContent = 'Render stopped'; } else render();
+});
+function updateColors() {
+  colorInputs.forEach(input => $(`${input.id}-hex`).textContent = input.value.toUpperCase());
+}
+colorInputs.forEach(input => input.addEventListener('input', updateColors));
+$('randomize').addEventListener('click', () => {
+  colorInputs.forEach(input => {
+    // Bright tints keep the reflective and refractive materials readable.
+    const rgb = crypto.getRandomValues(new Uint8Array(3));
+    input.value = '#' + [...rgb].map(v => (135 + Math.floor(v * 120 / 255)).toString(16).padStart(2, '0')).join('');
+  });
+  updateColors(); render();
+});
+$('reset').addEventListener('click', () => {
+  colorInputs.forEach(input => input.value = '#fafafa');
+  samples.value = '64'; resolution.value = '640'; updateColors(); render();
+});
+$('download').addEventListener('click', async () => {
+  const link = document.createElement('a');
+  link.download = 'smallpt-render.png';
+  if (hasFrame) link.href = canvas.toDataURL('image/png');
+  else {
+    const response = await fetch('/images/smallpt-preview.png');
+    link.href = URL.createObjectURL(await response.blob());
+  }
+  link.click();
+  if (!hasFrame) setTimeout(() => URL.revokeObjectURL(link.href), 1000);
+});
+$('expand').addEventListener('click', async () => {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else await $('render-stage').requestFullscreen();
+  } catch { $('status-text').textContent = 'Fullscreen unavailable in this view'; }
+});
+let sourceLoaded = false;
+document.querySelectorAll<HTMLButtonElement>('.tab').forEach(tab => tab.addEventListener('click', async () => {
+  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t === tab));
+  const source = tab.dataset.tab === 'source';
+  $('render-stage').style.display = source ? 'none' : 'flex';
+  $('source-stage').hidden = !source;
+  if (source && !sourceLoaded) {
+    try {
+      const response = await fetch('/renderer/smallpt.cpp');
+      if (!response.ok) throw new Error('Source unavailable');
+      $('source-code').textContent = await response.text(); sourceLoaded = true;
+    } catch { $('source-code').textContent = 'Unable to load source. Please try again.'; }
+  }
+}));
+window.addEventListener('pagehide', stop);
+// Start a real client-side render; the bundled native render provides an immediate first image.
+render();
