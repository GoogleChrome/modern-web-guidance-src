diff --git a/public/render-worker.js b/public/render-worker.js
new file mode 100644
index 0000000..75643d9
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,15 @@
+importScripts('smallpt.js');
+const ready = createSmallpt();
+self.onmessage = async ({data}) => {
+  try {
+    const module = await ready;
+    const {width,height,samples,seed,colors} = data;
+    module._setup(width,height,seed,...colors.flat());
+    const start=performance.now();
+    for(let pass=0;pass<samples/4;pass++) {
+      const ptr=module._render_pass();
+      const pixels=module.HEAPU8.slice(ptr,ptr+width*height*4);
+      self.postMessage({pixels,width,height,samples:(pass+1)*4,elapsed:(performance.now()-start)/1000,done:(pass+1)*4===samples},[pixels.buffer]);
+    }
+  } catch(error) { self.postMessage({error:String(error)}); }
+};
