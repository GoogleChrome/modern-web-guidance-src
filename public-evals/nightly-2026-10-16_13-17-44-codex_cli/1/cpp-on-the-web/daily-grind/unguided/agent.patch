+const $ = id => document.getElementById(id);
+const canvas=$('render'),ctx=canvas.getContext('2d');
+let worker, experiment=1, currentColors=[[.999,.999,.999],[.999,.999,.999]], hasImage=false, started=false;
+const preview=new Image();
+preview.onload=()=>{if(!started){ctx.drawImage(preview,0,0,canvas.width,canvas.height);hasImage=true;$('download').disabled=false;}};
+preview.src='public/preview.png';
+const hex=color=>'#'+color.map(v=>Math.round(v*255).toString(16).padStart(2,'0')).join('').toUpperCase();
+function updateMaterials(){
+  ['mirror','glass'].forEach((name,i)=>{
+    const color=hex(currentColors[i]);$(name+'-color').textContent=color;
+    $(name+'-orb').style.background=`radial-gradient(circle at 32% 24%, #ffffff, ${color} 24%, #1b2318 62%, ${color} 95%)`;
+  });
+}
+function fail(message){$('status').textContent=message;$('status-dot').classList.remove('busy');$('randomize').disabled=false;$('randomize').title='Try rendering again';}
+function render(){
+  if(worker) worker.terminate();
+  $('randomize').disabled=false;$('status').textContent='Tracing light paths…';$('status-dot').classList.add('busy');$('progress').style.width='0%';$('spp').textContent='0';$('elapsed').textContent='0.0s';
+  try {worker=new Worker('public/render-worker.js');}catch(error){fail('WebAssembly renderer unavailable');return;}
+  const samples=Number($('quality').value);
+  worker.onerror=()=>fail('Could not load renderer. Try again.');
+  worker.onmessage=({data})=>{
+    if(data.error){console.error(data.error);fail('Render failed. Try again.');return;}
+    started=true;hasImage=true;ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer),data.width,data.height),0,0);
+    $('download').disabled=false;$('spp').textContent=data.samples;$('elapsed').textContent=data.elapsed.toFixed(1)+'s';$('progress').style.width=(data.samples/samples*100)+'%';
+    if(data.done){$('status').textContent='Render complete';$('status-dot').classList.remove('busy');$('randomize').disabled=false;worker.terminate();worker=null;}
+  };
+  worker.postMessage({width:canvas.width,height:canvas.height,samples,seed:crypto.getRandomValues(new Uint32Array(1))[0],colors:currentColors});
+}
+$('randomize').addEventListener('click',()=>{
+  // Bright tints retain multiple bounces through the mirror and glass materials.
+  currentColors=Array.from({length:2},()=>{const hue=Math.random()*360;const rgb=[0,8,4].map(n=>{const k=(n+hue/30)%12;return .96-.4*Math.max(-1,Math.min(k-3,9-k,1));});return rgb.map(v=>Math.min(.999,v));});
+  experiment++;$('experiment-number').textContent=String(experiment).padStart(3,'0');updateMaterials();render();
+});
+$('quality').addEventListener('change',render);
+$('download').addEventListener('click',()=>{
+ if(!hasImage)return;
+ canvas.toBlob(blob=>{if(!blob)return;const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`smallpt-${String(experiment).padStart(3,'0')}.png`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);},'image/png');
+});
+render();
