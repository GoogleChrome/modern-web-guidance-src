+const fs = require('node:fs');
+const zlib = require('node:zlib');
+const createSmallpt = require('../public/smallpt.js');
+function crc32(b) { let c=0xffffffff; for(const n of b) {c^=n; for(let i=0;i<8;i++) c=(c>>>1)^((c&1)?0xedb88320:0);} return (c^0xffffffff)>>>0; }
+function chunk(type,data) {const t=Buffer.from(type), len=Buffer.alloc(4), crc=Buffer.alloc(4);len.writeUInt32BE(data.length);crc.writeUInt32BE(crc32(Buffer.concat([t,data])));return Buffer.concat([len,t,data,crc]);}
+(async()=>{
+ const m=await createSmallpt(); const w=640,h=480;
+ m._setup(w,h,42,.999,.999,.999,.999,.999,.999);
+ let ptr; for(let i=0;i<32;i++) {ptr=m._render_pass();if(i%8===0) console.log(`${(i+1)*4} spp`);}
+ const data=Buffer.from(m.HEAPU8.subarray(ptr,ptr+w*h*4));
+ const scan=Buffer.alloc((w*4+1)*h);for(let y=0;y<h;y++) data.copy(scan,y*(w*4+1)+1,y*w*4,(y+1)*w*4);
+ const header=Buffer.alloc(13);header.writeUInt32BE(w);header.writeUInt32BE(h,4);header[8]=8;header[9]=6;
+ fs.writeFileSync('public/preview.png',Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',header),chunk('IDAT',zlib.deflateSync(scan)),chunk('IEND',Buffer.alloc(0))]));
+ console.log('Saved preview from compiled WebAssembly.');
+})();
