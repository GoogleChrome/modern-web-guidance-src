+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/renderer.cpp -O3 --no-entry -Wno-return-type -Wno-c++11-narrowing -Wno-dangling-else -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=worker,node -s EXPORTED_FUNCTIONS='["_setup","_render_pass"]' -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s ALLOW_MEMORY_GROWTH=1 -s FILESYSTEM=0 -s STACK_SIZE=5242880 -o public/smallpt.js
diff --git a/scripts/check.cjs b/scripts/check.cjs
new file mode 100644
index 0000000..c59667c
--- /dev/null
+++ b/scripts/check.cjs
@@ -0,0 +1,16 @@
+const assert=require('node:assert/strict');
+const createSmallpt=require('../public/smallpt.js');
+(async()=>{
+ const m=await createSmallpt();const width=80,height=60;
+ function frame(colors,seed=42){m._setup(width,height,seed,...colors);const ptr=m._render_pass();return Buffer.from(m.HEAPU8.slice(ptr,ptr+width*height*4));}
+ const neutral=[.999,.999,.999,.999,.999,.999];
+ const original=frame(neutral);
+ assert.equal(original.length,width*height*4);
+ assert(original.some((value,i)=>i%4!==3&&value>50),'Image must contain illuminated pixels');
+ assert(original.some((value,i)=>i%4!==3&&value<30),'Image must contain shadows');
+ assert(original.every((value,i)=>i%4!==3||value===255),'Image must be opaque');
+ assert.deepEqual(frame(neutral),original,'Resetting the seed must reproduce output');
+ assert.notDeepEqual(frame([.6,.95,.6,.95,.6,.8]),original,'Sphere tints must change rendered output');
+ assert.notDeepEqual(frame(neutral,43),original,'New seeds must change sample paths');
+ console.log('WASM checks passed: valid RGBA, light and shadows, repeatability, color randomization, sample seeds.');
+})().catch(error=>{console.error(error);process.exitCode=1;});
