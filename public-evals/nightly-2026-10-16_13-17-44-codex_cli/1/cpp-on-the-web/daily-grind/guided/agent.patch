+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ src/renderer.cpp -O3 -flto -fno-exceptions -Wno-c++11-narrowing -Wno-dangling-else -Wno-return-type --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sSTRICT=1 \
+  -sENVIRONMENT=web,worker -sALLOW_MEMORY_GROWTH=1 -sASSERTIONS=1 \
+  -sINCOMING_MODULE_JS_API='["wasmBinary"]' -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -sEXPORTED_FUNCTIONS='["_initialize","_set_color","_framebuffer","_render_rows"]' \
+  -o public/smallpt.js
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..05f9fc7
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,29 @@
+import { readFileSync } from 'node:fs';
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/smallpt.js';
+// Exercise the browser-only build in Node without adding Node runtime code to the payload.
+const nodeProcess = globalThis.process;
+globalThis.process = undefined;
+globalThis.window = {};
+const engine = await createSmallpt({ wasmBinary: readFileSync(new URL('../public/smallpt.wasm', import.meta.url)) });
+globalThis.process = nodeProcess;
+delete globalThis.window;
+function render(randomized) {
+  assert.equal(engine._initialize(32,24,42),1);
+  if(randomized) { engine._set_color(6,.8,.3,.1); engine._set_color(7,.2,.7,.4); }
+  let progress=0;
+  while(progress<24*4) progress=engine._render_rows(8);
+  const ptr=engine._framebuffer();
+  return engine.HEAPU8.slice(ptr,ptr+32*24*4);
+}
+const original=render(false);
+assert(original.some((v,i)=>i%4!==3 && v>0), 'Renderer must produce light');
+assert(original.every((v,i)=>i%4!==3 || v===255), 'All pixels must be opaque');
+assert.notDeepEqual(render(true), original, 'Sphere colors must affect output');
+assert.deepEqual(render(false), original, 'Reset must restore original scene');
+assert.equal(engine._initialize(0,24,1),0);
+assert.equal(engine._initialize(1024,768,42),1);
+assert(engine.HEAPU8.length > 64 * 1024 * 1024, 'Memory must grow for larger resolutions');
+assert.equal(engine._render_rows(1),1);
+assert.deepEqual(render(false),original, 'Renderer must survive memory growth');
+console.log('WASM smoke checks passed: rendering, color changes, reset, dimensions, memory growth.');
