diff --git a/public/render-worker.js b/public/render-worker.js
new file mode 100644
index 0000000..e4cda48
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,42 @@
+import createSmallpt from './smallpt.js';
+
+let engine;
+let active = 0;
+let paused = false;
+let wake;
+const ready = createSmallpt().then(module => { engine = module; });
+self.onmessage = async ({ data }) => {
+  if (data.type === 'pause') { paused = data.paused; if (!paused && wake) wake(); return; }
+  if (data.type !== 'render') return;
+  const token = ++active;
+  paused = false;
+  if (wake) wake();
+  try {
+    await ready;
+    if (token !== active) return;
+    const { width, height, samples, colors, seed, id } = data;
+    if (!engine._initialize(width, height, seed)) throw new Error('Unsupported image size.');
+    for (const [index, color] of Object.entries(colors)) engine._set_color(Number(index), ...color);
+    const total = height * samples / 4;
+    let progress = 0;
+    let lastFrame = 0;
+    const started = performance.now();
+    while (progress < total && token === active) {
+      if (paused) await new Promise(resolve => { wake = resolve; });
+      if (token !== active) return;
+      progress = engine._render_rows(8);
+      const now = performance.now();
+      if (now - lastFrame > 110 || progress >= total) {
+        const pointer = engine._framebuffer();
+        const frame = engine.HEAPU8.slice(pointer, pointer + width * height * 4);
+        self.postMessage({ type: 'frame', id, frame, progress: progress / total,
+          samples: Math.floor(progress / height) * 4, elapsed: now - started,
+          complete: progress >= total }, [frame.buffer]);
+        lastFrame = now;
+      }
+      await new Promise(resolve => setTimeout(resolve, 0));
+    }
+  } catch (error) {
+    self.postMessage({ type: 'error', id: data.id, message: error.message });
+  }
+};
