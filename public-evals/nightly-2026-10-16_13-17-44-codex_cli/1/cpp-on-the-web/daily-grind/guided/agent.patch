new file mode 100644
index 0000000..ad4aac2
--- /dev/null
+++ b/app.js
@@ -0,0 +1,142 @@
+const $ = id => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d', { alpha: false });
+const original = { 0: [.75, .25, .25], 1: [.25, .25, .75], 6: [.999, .999, .999], 7: [.999, .999, .999] };
+let colors = structuredClone(original);
+let samples = 64;
+let renderId = 0;
+let paused = false;
+let finished = false;
+let receivedFrame = false;
+let worker;
+let renderWidth = 640;
+let renderHeight = 480;
+
+// A render from the same C++ code provides a useful view while Wasm initializes.
+const preview = new Image();
+preview.src = './public/preview.png';
+preview.onload = () => { if (!receivedFrame) context.drawImage(preview, 0, 0, canvas.width, canvas.height); };
+function status(text, state = 'running') {
+  $('render-status').replaceChildren();
+  const dot = document.createElement('i');
+  dot.className = 'live-dot';
+  if (state === 'error') dot.style.background = '#dc9b72';
+  $('render-status').append(dot, document.createTextNode(text));
+}
+function startRender() {
+  if (!worker) return;
+  renderId++;
+  paused = false;
+  finished = false;
+  renderWidth = Number($('resolution').value);
+  renderHeight = renderWidth * 3 / 4;
+  $('pause').disabled = false;
+  $('pause').textContent = 'Ⅱ';
+  $('pause').setAttribute('aria-label', 'Pause render');
+  $('pause').title = 'Pause render';
+  $('sample-stat').innerHTML = `0 / ${samples} <small>SPP</small>`;
+  $('time-stat').innerHTML = '0.0 <small>SEC</small>';
+  $('progress-fill').style.width = '0%';
+  status('Tracing light');
+  $('announcement').textContent = 'Rendering started.';
+  worker.postMessage({ type: 'render', id: renderId, width: renderWidth, height: renderHeight,
+    samples, colors, seed: crypto.getRandomValues(new Uint32Array(1))[0] });
+}
+try {
+  if (!('WebAssembly' in window) || !('Worker' in window)) throw new Error('WebAssembly and Web Workers are required.');
+  worker = new Worker(new URL('./public/render-worker.js', import.meta.url), { type: 'module' });
+  worker.onmessage = ({ data }) => {
+    if (data.id !== renderId) return;
+    if (data.type === 'error') { showError(data.message); return; }
+    if (data.type !== 'frame') return;
+    // Keep the previous render until the first full image is available.
+    if (data.samples >= 4) {
+      receivedFrame = true;
+      if (canvas.width !== renderWidth || canvas.height !== renderHeight) {
+        canvas.width = renderWidth;
+        canvas.height = renderHeight;
+      }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.frame), renderWidth, renderHeight), 0, 0);
+    }
+    $('progress-fill').style.width = `${Math.min(100, data.progress * 100)}%`;
+    $('sample-stat').innerHTML = `${Math.min(data.samples, samples)} / ${samples} <small>SPP</small>`;
+    $('time-stat').innerHTML = `${(data.elapsed / 1000).toFixed(1)} <small>SEC</small>`;
+    if (data.complete) {
+      finished = true;
+      $('pause').disabled = true;
+      status('Render complete', 'complete');
+      $('announcement').textContent = `Render complete. ${samples} samples per pixel.`;
+    }
+  };
+  worker.onerror = event => showError(event.message || 'Could not load the rendering engine.');
+  startRender();
+} catch (error) { showError(error.message); }
+function showError(message) {
+  status('Renderer unavailable', 'error');
+  $('announcement').textContent = message;
+  $('render-status').title = message;
+  $('pause').disabled = true;
+  $('randomize').disabled = true;
+  $('reset').disabled = true;
+  document.querySelector('.engine-badge').textContent = 'ENGINE UNAVAILABLE';
+}
+function updatePalette(randomized) {
+  for (const [id, color] of Object.entries(colors)) {
+    $( `swatch-${id}`).style.setProperty('--swatch', `rgb(${color.map(v => Math.round(v * 255)).join(',')})`);
+  }
+  $('palette-label').textContent = randomized ? 'REMIXED' : 'ORIGINAL';
+}
+function colorful(min = .2, range = .7) {
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] / 2 ** 32 * Math.PI * 2;
+  return [0, 2 * Math.PI / 3, 4 * Math.PI / 3].map(offset => min + range * (.5 + .5 * Math.cos(hue + offset)));
+}
+$('randomize').addEventListener('click', () => {
+  colors = { 0: colorful(.15, .65), 1: colorful(.15, .65), 6: colorful(.55, .44), 7: colorful(.7, .299) };
+  updatePalette(true);
+  startRender();
+});
+$('reset').addEventListener('click', () => { colors = structuredClone(original); updatePalette(false); startRender(); });
+$('resolution').addEventListener('change', startRender);
+document.querySelectorAll('[data-samples]').forEach(button => {
+  if (!button.classList.contains('selected')) button.setAttribute('aria-pressed', 'false');
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    document.querySelectorAll('[data-samples]').forEach(item => {
+      item.classList.toggle('selected', item === button);
+      item.setAttribute('aria-pressed', String(item === button));
+    });
+    $('quality-label').textContent = `${samples} SPP`;
+    startRender();
+  });
+});
+$('pause').addEventListener('click', () => {
+  if (finished || !worker) return;
+  paused = !paused;
+  worker.postMessage({ type: 'pause', paused });
+  $('pause').textContent = paused ? '▷' : 'Ⅱ';
+  const label = paused ? 'Resume render' : 'Pause render';
+  $('pause').setAttribute('aria-label', label);
+  $('pause').title = label;
+  status(paused ? 'Render paused' : 'Tracing light');
+});
+$('download').addEventListener('click', () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${canvas.width}x${canvas.height}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+$('expand').addEventListener('click', async () => {
+  const panel = $('viewport-panel');
+  if (document.fullscreenElement) { await document.exitFullscreen(); return; }
+  if (panel.classList.contains('expanded')) { panel.classList.remove('expanded'); return; }
+  try {
+    if (panel.requestFullscreen) await panel.requestFullscreen();
+    else panel.classList.add('expanded');
+  } catch { panel.classList.add('expanded'); }
+});
+document.addEventListener('keydown', event => { if (event.key === 'Escape') $('viewport-panel').classList.remove('expanded'); });
