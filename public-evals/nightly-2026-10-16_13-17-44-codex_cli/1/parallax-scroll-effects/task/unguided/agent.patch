+    /* Only transforms animate; no scroll listeners or permanent GPU hints.
+       A named section timeline keeps all three layers in sync. */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-story__background,
+        .coffee-story__ring,
+        .coffee-story__photo {
+          animation: coffee-parallax linear both;
+          animation-timeline: --coffee-depth;
+          animation-range: cover 0% cover 100%;
+        }
+
+        .coffee-story__background { --travel: 70px; }
+        .coffee-story__ring { --travel: -45px; }
+        .coffee-story__photo { --travel: -85px; }
+      }
+    }
+
+    @keyframes coffee-parallax {
+      from { transform: translateY(calc(-1 * var(--travel))); }
+      to { transform: translateY(var(--travel)); }
+    }
