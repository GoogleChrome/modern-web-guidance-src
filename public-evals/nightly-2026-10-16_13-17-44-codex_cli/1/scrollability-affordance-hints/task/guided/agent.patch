+  <script>
+    // Keep the scroll hints available in browsers without scroll-state queries.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.reviews-scroll');
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          const className = entry.target.classList.contains('sentinel-top')
+            ? 'scrolled-down' : 'can-scroll-down';
+          scroller.classList.toggle(className, entry.intersectionRatio < 1);
+        }
+      }, { root: scroller, threshold: [0, 1] });
+
+      scroller.querySelectorAll('.scroll-sentinel').forEach((sentinel) => {
+        observer.observe(sentinel);
+      });
+    }
+  </script>
+
