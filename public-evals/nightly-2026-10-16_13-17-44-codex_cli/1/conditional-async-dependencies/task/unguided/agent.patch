+  <script type="module">
+    const popover = document.getElementById('rewards-popover');
+    const trigger = document.querySelector('.rewards-trigger');
+
+    // Modern browsers make no additional script requests.
+    if (!('showPopover' in HTMLElement.prototype)) {
+      const { setupRewardsFallback } = await import('./rewards-popover-fallback.js');
+      setupRewardsFallback(popover, trigger);
+    } else {
+      popover.addEventListener('toggle', (event) => {
+        trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      });
+    }
+  </script>
