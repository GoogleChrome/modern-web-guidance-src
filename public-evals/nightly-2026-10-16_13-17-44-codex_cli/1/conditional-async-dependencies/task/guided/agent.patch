+  <script type="module">
+    const rewards = document.getElementById('rewards-popover');
+    const trigger = document.getElementById('rewards-toggle');
+
+    // The invoker polyfill does not synchronize expanded state itself.
+    rewards.addEventListener('toggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+    });
+
+    async function initializeRewards() {
+      // Invoker commands depend on the Popover API. Finish installing it first.
+      // Native browsers take neither branch and download no fallback scripts.
+      if (!('popover' in HTMLElement.prototype)) {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js');
+      }
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        await import('https://unpkg.com/invokers-polyfill@1.0.4/invoker.min.js');
+      }
+    }
+
+    initializeRewards().catch((error) => {
+      console.error('Unable to load rewards compatibility support:', error);
+    });
+  </script>
