+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const name = item.querySelector('h3').textContent;
+      const button = item.querySelector('button');
+      const hadFocus = item.contains(document.activeElement);
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-removing');
+      button.disabled = true;
+      content.style.transform = `translateX(${direction * 100}%)`;
+
+      const remaining = [...cartList.children].filter(row => !row.classList.contains('is-removing'));
+      document.querySelector('.cart-count').textContent = `${remaining.length} item${remaining.length === 1 ? '' : 's'}`;
+      document.querySelector('.cart-empty').hidden = remaining.length !== 0;
+      document.querySelector('#cart-status').textContent = `${name} removed. ${remaining.length} items in your cart.`;
+      if (hadFocus) {
+        const nextButton = remaining[0]?.querySelector('button');
+        if (nextButton) nextButton.focus();
+        else {
+          const title = document.querySelector('#cart-title');
+          title.tabIndex = -1;
+          title.focus();
+        }
+      }
+
+      // Reveal the action color before collapsing the entire row, including its spacing.
+      setTimeout(() => {
+        item.style.height = '0px';
+        item.style.paddingBottom = '0px';
+        item.style.opacity = '0';
+        setTimeout(() => item.remove(), reducedMotion.matches ? 0 : 280);
+      }, reducedMotion.matches ? 0 : 180);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const action = item.querySelector('.swipe-action');
+      let gesture = null;
+      const threshold = () => Math.min(96, track.clientWidth * 0.3);
+
+      function reset() {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready', 'swiping-right');
+        content.style.transform = '';
+        action.textContent = 'Remove';
+      }
+
+      track.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0, dragging: false };
+      });
+
+      track.addEventListener('pointermove', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            reset();
+            return;
+          }
+          if (Math.abs(dx) < 8) return;
+          gesture.dragging = true;
+          track.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.distance = dx;
+        const ready = Math.abs(dx) >= threshold();
+        item.classList.toggle('is-ready', ready);
+        item.classList.toggle('swiping-right', dx > 0);
+        action.textContent = ready ? 'Release to remove' : 'Remove';
+        content.style.transform = `translateX(${dx}px)`;
+      });
+
+      track.addEventListener('pointerup', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const { distance, dragging } = gesture;
+        gesture = null;
+        if (dragging && Math.abs(distance) >= threshold()) removeCartItem(item, Math.sign(distance));
+        else reset();
+      });
+      track.addEventListener('pointercancel', reset);
+      track.addEventListener('lostpointercapture', () => {
+        if (gesture) reset();
+      });
+      item.querySelector('button').addEventListener('click', () => removeCartItem(item));
+    });
+  </script>
+
