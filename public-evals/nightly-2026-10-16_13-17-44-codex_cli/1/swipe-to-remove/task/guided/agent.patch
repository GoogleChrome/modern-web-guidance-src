+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const handles = new WeakMap();
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+      for (const { target } of entries) target.scrollLeft = target.clientWidth;
+    }) : null;
+
+    const viewportObserver = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (item.classList.contains('is-removing')) continue;
+        if (entry.isIntersecting) {
+          const handle = handles.get(item) || setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          handles.get(item)?.observer.unobserve(handles.get(item).content);
+        }
+      }
+    });
+
+    async function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const height = item.getBoundingClientRect().height;
+      const contentRect = content.getBoundingClientRect();
+      const offset = contentRect.x - track.getBoundingClientRect().x;
+      const distance = direction > 0 ? contentRect.width - offset : -contentRect.width - offset;
+      const hadFocus = item.contains(document.activeElement);
+
+      viewportObserver.unobserve(item);
+      handles.get(item)?.observer.disconnect();
+      resizeObserver?.unobserve(track);
+      item.classList.add('is-removing');
+      if (hadFocus) {
+        const remaining = [...list.children].filter(row => !row.classList.contains('is-removing'));
+        const next = remaining.find(row => item.compareDocumentPosition(row) & Node.DOCUMENT_POSITION_FOLLOWING)
+          || remaining.at(-1);
+        (next?.querySelector('.cart-remove') || document.querySelector('#cart-title')).focus({ preventScroll: true });
+      }
+      item.inert = true;
+
+      const options = {
+        duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300,
+        easing: 'ease',
+        fill: 'forwards'
+      };
+      await Promise.allSettled([
+        item.animate([{ height: `${height}px` }, { height: '0px' }], options).finished,
+        content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${distance}px)` }], options).finished
+      ]);
+
+      const count = list.querySelectorAll('.SwipeableList-item:not(.is-removing)').length;
+      document.querySelector('.cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+      document.querySelector('.cart-status').textContent = `${item.dataset.name} removed.${count ? '' : ' Your cart is empty.'}`;
+
+      // Let Safari finish its scroll momentum before removing the collapsed node,
+      // so the next row cannot inherit the gesture and remove itself.
+      if (globalThis.GestureEvent) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        resizeObserver.observe(track);
+      }
+      const observer = new IntersectionObserver(entries => {
+        const entry = entries.at(-1);
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        if (entry.intersectionRatio < 0.2) {
+          removeItem(item, offset > 0 ? 1 : -1);
+          return;
+        }
+        item.classList.toggle('is-activating', entry.intersectionRatio < 0.8);
+      }, { root: track, threshold: [0.2, 0.8] });
+      const handle = { observer, content };
+      handles.set(item, handle);
+      return handle;
+    }
+
+    for (const item of list.children) viewportObserver.observe(item);
+    list.addEventListener('click', event => {
+      const button = event.target.closest('.cart-remove');
+      if (button) removeItem(button.closest('.SwipeableList-item'));
+    });
+  </script>
