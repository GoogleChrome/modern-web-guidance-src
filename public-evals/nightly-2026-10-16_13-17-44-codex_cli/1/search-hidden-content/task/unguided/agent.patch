+  <script>
+    const tabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+
+    function activateTab(activeTab) {
+      tabs.forEach((tab) => {
+        const selected = tab === activeTab;
+        const panel = document.getElementById(tab.getAttribute('aria-controls'));
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panel.removeAttribute('hidden');
+        } else {
+          // Plain `hidden` or display:none would exclude this text from browser search.
+          panel.setAttribute('hidden', 'until-found');
+        }
+      });
+    }
+
+    tabs.forEach((tab, index) => {
+      const panel = document.getElementById(tab.getAttribute('aria-controls'));
+      tab.addEventListener('click', () => activateTab(tab));
+      // Browser search must also synchronize the selected tab and close its sibling.
+      panel.addEventListener('beforematch', () => activateTab(tab));
+      tab.addEventListener('keydown', (event) => {
+        let nextIndex;
+        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
+        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
+        else if (event.key === 'Home') nextIndex = 0;
+        else if (event.key === 'End') nextIndex = tabs.length - 1;
+        else return;
+        event.preventDefault();
+        activateTab(tabs[nextIndex]);
+        tabs[nextIndex].focus();
+      });
+    });
+
+    const couponButton = document.getElementById('reveal-coupon');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'Coupon revealed';
+      couponButton.disabled = true;
+    }
+
+    couponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+    couponPanel.addEventListener('beforematch', revealCoupon);
+  </script>
+
