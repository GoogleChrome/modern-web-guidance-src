+  <div class="drawer" id="navigation-drawer" popover="manual" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
+    <div class="drawer-scroller">
+      <div class="drawer-sheet" tabindex="-1">
+        <div class="drawer-heading">
+          <h2 id="drawer-title">Explore the Grind</h2>
+          <button class="drawer-close" type="button" aria-label="Close navigation menu">Close</button>
+        </div>
+        <nav aria-label="Main navigation">
+          <ul>
+            <li><a href="/menu">Menu</a></li>
+            <li><a href="/locations">Locations</a></li>
+            <li><a href="/rewards">Rewards</a></li>
+            <li><a href="/account">My Account</a></li>
