+
+  <script type="module">
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let state = 'closed';
+
+    function finishClosing() {
+      observer.disconnect();
+      drawer.hidePopover();
+      state = 'closed';
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    // Observe the sheet so native swipes and button dismissals share cleanup.
+    const observer = new IntersectionObserver((entries) => {
+      const entry = entries.at(-1);
+      if (state === 'closed') return;
+      if (entry.intersectionRatio > 0 && state === 'opening') state = 'open';
+      if (entry.intersectionRatio < 0.001 && state !== 'opening') finishClosing();
+    }, { root: scroller, threshold: [0.001, 1] });
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      drawer.showPopover();
+      page.inert = true;
+      openButton.setAttribute('aria-expanded', 'true');
+      sheet.focus({ preventScroll: true });
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: scroller.scrollWidth, behavior: 'instant' });
+      }
+      // Commit the closed snap position before starting the entrance scroll.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state !== 'opening') return;
+      observer.observe(sheet);
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      if (scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 1) {
+        finishClosing();
+        return;
+      }
+      scroller.scrollTo({ left: scroller.scrollWidth, behavior: 'auto' });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    drawer.querySelector('.drawer-close').addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target) || event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && state !== 'closed') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      if (event.key === 'Tab' && state !== 'closed') {
+        const controls = [...sheet.querySelectorAll('button, a[href]')];
+        const first = controls[0];
+        const last = controls.at(-1);
+        if (event.shiftKey && (document.activeElement === first || document.activeElement === sheet)) {
+          event.preventDefault();
+          last.focus({ preventScroll: true });
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus({ preventScroll: true });
+        }
+      }
+    });
+
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const progress = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, progress)));
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+  </script>
