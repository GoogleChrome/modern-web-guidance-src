+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('menu-open');
+    const closeButton = document.getElementById('menu-close');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let phase = 'closed';
+    let sheetWasVisible = false;
+
+    function finishClose() {
+      if (phase === 'closed') return;
+      phase = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      document.documentElement.classList.remove('drawer-open');
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    function openDrawer() {
+      if (phase !== 'closed') return;
+      phase = 'opening';
+      sheetWasVisible = false;
+      drawer.showPopover();
+      page.inert = true;
+      document.documentElement.classList.add('drawer-open');
+      openButton.setAttribute('aria-expanded', 'true');
+      // Start off-screen on every open, including browsers without
+      // scroll-initial-target. The browser animates and handles all swipes.
+      scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
+      closeButton.focus({ preventScroll: true });
+      requestAnimationFrame(() => requestAnimationFrame(() => {
+        if (phase === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+      }));
+    }
+
+    function closeDrawer() {
+      if (phase === 'closed') return;
+      phase = 'closing';
+      const closedPosition = scroller.scrollWidth - scroller.clientWidth;
+      if (scroller.scrollLeft >= closedPosition - 1) {
+        finishClose();
+      } else {
+        scroller.scrollTo({ left: closedPosition, behavior: 'auto' });
+      }
+    }
+
+    // All dismissal paths meet here once the sheet is fully off-screen.
+    // Ignore the initial off-screen position while the entrance is starting.
+    new IntersectionObserver((entries) => {
+      if (phase === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRatio > 0) sheetWasVisible = true;
+      if (entry.intersectionRatio === 1 && phase === 'opening') phase = 'open';
+      if (entry.intersectionRatio === 0 && (sheetWasVisible || phase === 'closing')) finishClose();
+    }, { root: scroller, threshold: [0, 1] }).observe(sheet);
+
+    if (!(CSS.supports('animation-timeline: scroll()') && CSS.supports('timeline-scope: --drawer-fade'))) {
+      scroller.addEventListener('scroll', () => {
+        const distance = scroller.scrollWidth - scroller.clientWidth;
+        const opacity = distance ? 1 - scroller.scrollLeft / distance : 0;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, opacity)));
+      }, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target) || event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', (event) => {
+      if (phase === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      if (event.key === 'Tab') {
+        const controls = [...sheet.querySelectorAll('button, a[href]')];
+        const first = controls[0];
+        const last = controls.at(-1);
+        if (event.shiftKey && (document.activeElement === first || !controls.includes(document.activeElement))) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && (document.activeElement === last || !controls.includes(document.activeElement))) {
+          event.preventDefault();
+          first.focus();
+        }
+      }
+    });
+  </script>
