+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.querySelector('#roast-trigger');
+    const list = document.querySelector('#roast-options');
+    const value = document.querySelector('#roast-value');
+    const options = [...list.querySelectorAll('[role="option"]')];
+
+    function closeRoasts(restoreFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    trigger.addEventListener('click', () => {
+      if (list.hidden) openRoasts();
+      else closeRoasts();
+    });
+
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      value.textContent = option.textContent.trim();
+      closeRoasts(true);
+    }
+
+    options.forEach(option => {
+      option.addEventListener('click', () => selectRoast(option));
+      option.addEventListener('keydown', event => {
+        const index = options.indexOf(option);
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowUp') next = (index + options.length - 1) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) {
+          event.preventDefault();
+          options[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(option);
+        } else if (/^[a-z]$/i.test(event.key)) {
+          const match = options.find(item => item.dataset.value.startsWith(event.key.toLowerCase()));
+          if (match) match.focus();
+        }
+      });
+    });
+
+    selector.addEventListener('keydown', event => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      }
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+  </script>
