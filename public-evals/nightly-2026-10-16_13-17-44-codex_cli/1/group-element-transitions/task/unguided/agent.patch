+  <script>
+    const beanForm = document.querySelector('#bean-form');
+    const beanInput = document.querySelector('#bean-name');
+    const beanList = document.querySelector('#bean-list');
+    const beanStatus = document.querySelector('#bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let customBeanCount = 0;
+    let activeTransition;
+    let mutationQueue = Promise.resolve();
+
+    function updateBeans(change) {
+      // Finish pending DOM updates before capturing the next snapshot, without
+      // waiting for animations or disabling the controls during rapid clicks.
+      mutationQueue = mutationQueue.then(async () => {
+        activeTransition?.skipTransition();
+        if (reducedMotion.matches || !document.startViewTransition) {
+          change();
+          return;
+        }
+        activeTransition = document.startViewTransition(change);
+        await activeTransition.updateCallbackDone;
+      });
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim() || `Custom Blend ${++customBeanCount}`;
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+
+      const details = document.createElement('div');
+      const title = document.createElement('strong');
+      title.textContent = name;
+      const subtitle = document.createElement('small');
+      subtitle.textContent = 'Your custom selection';
+      details.append(title, subtitle);
+
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-bean';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      item.append(details, remove);
+
+      beanInput.value = '';
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added. ${beanList.children.length} bean selections.`;
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const item = button.closest('.item');
+      const name = item.querySelector('strong').textContent;
+      updateBeans(() => {
+        if (!item.isConnected) return;
+        if (item.contains(document.activeElement)) {
+          const nextItem = item.nextElementSibling || item.previousElementSibling;
+          (nextItem?.querySelector('button') || beanInput).focus({ preventScroll: true });
+        }
+        item.remove();
+        beanStatus.textContent = `${name} removed. ${beanList.children.length} bean selections.`;
+      });
+    });
+  </script>
