+  <script>
+    const beanForm = document.getElementById('bean-form');
+    const beanInput = document.getElementById('bean-name');
+    const beanList = document.getElementById('bean-list');
+    const beanStatus = document.getElementById('bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let customBeanCount = 0;
+    let activeTransition;
+
+    function updateBeans(update) {
+      // Finish an in-flight animation so repeated clicks stay responsive.
+      activeTransition?.skipTransition();
+      if (reducedMotion.matches || !document.startViewTransition) {
+        update();
+        return;
+      }
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+      // Skipped or unsupported snapshots must not create unhandled rejections.
+      transition.ready.catch(() => {});
+      transition.finished.finally(() => {
+        if (activeTransition === transition) activeTransition = undefined;
+      });
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim() || `Custom Blend ${++customBeanCount}`;
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const removeButton = document.createElement('button');
+      removeButton.type = 'button';
+      removeButton.className = 'remove-bean';
+      removeButton.textContent = 'Remove';
+      removeButton.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, removeButton);
+      beanInput.value = '';
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added. ${beanList.children.length} selections.`;
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const item = button.closest('.item');
+      const name = item.querySelector('span').textContent;
+      updateBeans(() => {
+        if (item.contains(document.activeElement)) {
+          const adjacentItem = item.nextElementSibling || item.previousElementSibling;
+          (adjacentItem?.querySelector('button') || beanInput).focus();
+        }
+        item.remove();
+        beanStatus.textContent = `${name} removed. ${beanList.children.length} selections.`;
+      });
+    });
+  </script>
