--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,23 @@
+import { navigate } from 'astro:transitions/client';
+import { getArticles, getReadingList, setBookmark } from '../utils/news-client';
+import { registerNewsTools, type NewsModelContext } from '../utils/webmcp-tools';
+
+const context = (document as Document & { modelContext?: NewsModelContext }).modelContext;
+
+// These tools are route-independent. Astro's ClientRouter preserves the document,
+// so register once rather than registering duplicates after each page swap.
+if (context?.registerTool) {
+  const controller = new AbortController();
+  const articleUrl = (slug: string) => `${import.meta.env.BASE_URL}articles/${encodeURIComponent(slug)}`;
+  void registerNewsTools(context, {
+    getArticles,
+    getReadingList,
+    setBookmark,
+    articleUrl,
+    openArticle: slug => navigate(articleUrl(slug)),
+  }, controller.signal).catch(error => {
+    controller.abort();
+    console.warn('Could not register WebMCP news tools:', error);
+  });
+  if (import.meta.hot) import.meta.hot.dispose(() => controller.abort());
+}
