+++ b/tests/webmcp.test.ts
@@ -0,0 +1,97 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createNewsTools, registerNewsTools, type NewsActions, type NewsTool } from '../src/utils/webmcp-tools.ts';
+
+function fixture() {
+  const articles = [
+    { slug: 'coffee', title: 'Coffee Alchemy', summary: 'The perfect brew' },
+    { slug: 'cycling', title: 'City Cycling', summary: 'New routes' },
+  ];
+  let readingList: string[] = [];
+  const opened: string[] = [];
+  const actions: NewsActions = {
+    getArticles: async () => articles,
+    getReadingList: async () => readingList,
+    setBookmark: async (slug, saved) => {
+      readingList = readingList.filter(item => item !== slug);
+      if (saved) readingList.push(slug);
+      return readingList;
+    },
+    openArticle: async slug => { opened.push(slug); },
+    articleUrl: slug => `/devtools-times/articles/${slug}`,
+  };
+  const tools = createNewsTools(actions);
+  const call = (name: string, input = {}, signal?: AbortSignal) => tools.find(tool => tool.name === name)!.execute(input, { signal });
+  return { actions, opened, tools, call };
+}
+
+test('search matches titles and summaries, trims queries, and returns usable base-aware URLs', async () => {
+  const { call } = fixture();
+  const result = await call('search_articles', { query: ' BREW ' }) as { articles: { slug: string; url: string }[]; count: number };
+  assert.equal(result.count, 1);
+  assert.equal(result.articles[0].slug, 'coffee');
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee');
+  assert.equal((await call('search_articles') as { count: number }).count, 2);
+  assert.equal((await call('search_articles', { query: 'missing' }) as { count: number }).count, 0);
+});
+
+test('bookmarks can be saved, listed, repeatedly saved, and removed', async () => {
+  const { call } = fixture();
+  assert.deepEqual(await call('set_article_bookmark', { slug: 'coffee', saved: true }), { slug: 'coffee', saved: true, readingList: ['coffee'] });
+  await call('set_article_bookmark', { slug: 'coffee', saved: true });
+  assert.equal((await call('get_reading_list') as { count: number }).count, 1);
+  await call('set_article_bookmark', { slug: 'coffee', saved: false });
+  await call('set_article_bookmark', { slug: 'coffee', saved: false });
+  assert.deepEqual(await call('get_reading_list'), { articles: [], count: 0 });
+});
+
+test('invalid arguments and unknown slugs report actionable errors without navigating or saving', async () => {
+  const { call, opened } = fixture();
+  for (const [name, input] of [
+    ['search_articles', { query: 42 }],
+    ['set_article_bookmark', { slug: 'coffee', saved: 'true' }],
+    ['set_article_bookmark', { slug: 'missing', saved: true }],
+    ['open_article', { slug: '../signin' }],
+    ['open_article', {}],
+  ] as const) {
+    assert.equal(typeof (await call(name, input) as { error: string }).error, 'string');
+  }
+  assert.deepEqual(opened, []);
+  assert.deepEqual(await call('get_reading_list'), { articles: [], count: 0 });
+  await call('open_article', { slug: 'cycling' });
+  assert.deepEqual(opened, ['cycling']);
+});
+
+test('network errors are returned to agents and execution cancellation reaches requests', async () => {
+  const { actions } = fixture();
+  const controller = new AbortController();
+  let receivedSignal: AbortSignal | undefined;
+  actions.getArticles = async signal => {
+    receivedSignal = signal;
+    throw new Error('Request failed (503). Please retry.');
+  };
+  const search = createNewsTools(actions)[0];
+  assert.deepEqual(await search.execute({}, { signal: controller.signal }), { error: 'Request failed (503). Please retry.' });
+  assert.equal(receivedSignal, controller.signal);
+  controller.abort();
+  assert.match((await search.execute({}, { signal: controller.signal }) as { error: string }).error, /abort/i);
+});
+
+test('registration uses a single abort signal to release tools and stops after cancellation', async () => {
+  const { actions } = fixture();
+  const tools = new Map<string, NewsTool>();
+  const context = {
+    async registerTool(tool: NewsTool, { signal }: { signal: AbortSignal }) {
+      assert.equal(tools.has(tool.name), false);
+      tools.set(tool.name, tool);
+      signal.addEventListener('abort', () => tools.delete(tool.name), { once: true });
+    },
+  };
+  const controller = new AbortController();
+  await registerNewsTools(context, actions, controller.signal);
+  assert.equal(tools.size, 4);
+  controller.abort();
+  assert.equal(tools.size, 0);
+  await registerNewsTools(context, actions, controller.signal);
+  assert.equal(tools.size, 0);
+});
