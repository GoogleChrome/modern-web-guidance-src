+export function searchArticles<T extends { title: string; summary: string }>(articles: T[], query: string): T[] {
+  const term = query.trim().toLowerCase();
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term));
+}
diff --git a/src/utils/news-client.ts b/src/utils/news-client.ts
new file mode 100644
index 0000000..1f3a729
--- /dev/null
+++ b/src/utils/news-client.ts
@@ -0,0 +1,46 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+export const READING_LIST_CHANGED = 'reading-list-changed';
+let latestReadingList: string[] | undefined;
+
+export function subscribeReadingList(callback: (slugs: string[]) => void) {
+  const listener = (event: Event) => callback((event as CustomEvent<string[]>).detail);
+  window.addEventListener(READING_LIST_CHANGED, listener);
+  if (latestReadingList) callback(latestReadingList);
+  return () => window.removeEventListener(READING_LIST_CHANGED, listener);
+}
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please retry.`);
+  return response.json();
+}
+
+export function getArticles(signal?: AbortSignal) {
+  return request<Article[]>('api/articles.json', { signal });
+}
+
+export async function getReadingList(signal?: AbortSignal) {
+  const data = await request<{ readingList: string[] }>('api/reading-list.json', { signal });
+  latestReadingList = data.readingList;
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
+
+// Explicit state makes retries safe, unlike toggling a bookmark.
+export async function setBookmark(slug: string, saved: boolean, signal?: AbortSignal) {
+  const data = await request<{ readingList: string[] }>('api/reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, saved }),
+    signal,
+  });
+  latestReadingList = data.readingList;
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
diff --git a/src/utils/webmcp-tools.ts b/src/utils/webmcp-tools.ts
new file mode 100644
index 0000000..e2f04f8
--- /dev/null
+++ b/src/utils/webmcp-tools.ts
@@ -0,0 +1,92 @@
+import { searchArticles } from './article-search.ts';
+
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+export interface NewsActions {
+  getArticles(signal?: AbortSignal): Promise<Article[]>;
+  getReadingList(signal?: AbortSignal): Promise<string[]>;
+  setBookmark(slug: string, saved: boolean, signal?: AbortSignal): Promise<string[]>;
+  openArticle(slug: string): Promise<void>;
+  articleUrl(slug: string): string;
+}
+
+export interface NewsTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations: { readOnlyHint: boolean };
+  execute(input: Record<string, unknown>, options?: { signal?: AbortSignal }): Promise<unknown>;
+}
+
+export interface NewsModelContext {
+  registerTool(tool: NewsTool, options: { signal: AbortSignal }): Promise<void>;
+}
+
+export function createNewsTools(actions: NewsActions): NewsTool[] {
+  const schema = (properties = {}, required: string[] = []) => ({
+    type: 'object', properties, required, additionalProperties: false,
+  });
+  const slugProperty = { slug: { type: 'string', minLength: 1, description: 'Article slug returned by search_articles or get_reading_list.' } };
+  const describe = (article: Article) => ({ ...article, url: actions.articleUrl(article.slug) });
+  const tool = (name: string, description: string, inputSchema: Record<string, unknown>, readOnlyHint: boolean,
+    run: NewsTool['execute']): NewsTool => ({
+    name, description, inputSchema, annotations: { readOnlyHint },
+    async execute(input, options = {}) {
+      try {
+        if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('Expected an input object.');
+        options.signal?.throwIfAborted();
+        return await run(input, options);
+      } catch (error) {
+        return { error: error instanceof Error ? error.message : 'The operation failed. Please retry.' };
+      }
+    },
+  });
+  const findArticle = async (slug: unknown, signal?: AbortSignal) => {
+    if (typeof slug !== 'string' || !slug.trim()) throw new Error('Provide a non-empty article slug.');
+    const article = (await actions.getArticles(signal)).find(article => article.slug === slug);
+    if (!article) throw new Error('Article not found. Use search_articles to find a valid slug.');
+    return article;
+  };
+
+  return [
+    tool('search_articles', 'Search article titles and summaries. An empty query lists all articles. Returns article slugs, summaries, and URLs.',
+      schema({ query: { type: 'string', description: 'Case-insensitive title or summary text. Defaults to all articles.' } }), true,
+      async ({ query = '' }, { signal } = {}) => {
+        if (typeof query !== 'string') throw new Error('query must be a string.');
+        const articles = searchArticles(await actions.getArticles(signal), query);
+        return { articles: articles.map(describe), count: articles.length };
+      }),
+    tool('get_reading_list', 'Get the articles saved in the current browser session reading list.', schema(), true,
+      async (_input, { signal } = {}) => {
+        const slugs = await actions.getReadingList(signal);
+        const articles = (await actions.getArticles(signal)).filter(article => slugs.includes(article.slug));
+        return { articles: articles.map(describe), count: articles.length };
+      }),
+    tool('set_article_bookmark', 'Save an article to, or remove it from, the current session reading list. Repeating the same request preserves the requested state.',
+      schema({ ...slugProperty, saved: { type: 'boolean', description: 'true to save; false to remove.' } }, ['slug', 'saved']), false,
+      async ({ slug, saved }, { signal } = {}) => {
+        if (typeof saved !== 'boolean') throw new Error('saved must be a boolean.');
+        const article = await findArticle(slug, signal);
+        const readingList = await actions.setBookmark(article.slug, saved, signal);
+        return { slug: article.slug, saved: readingList.includes(article.slug), readingList };
+      }),
+    tool('open_article', 'Navigate the visible application to an article using its slug.', schema(slugProperty, ['slug']), false,
+      async ({ slug }, { signal } = {}) => {
+        const article = await findArticle(slug, signal);
+        signal?.throwIfAborted();
+        await actions.openArticle(article.slug);
+        return { article: describe(article) };
+      }),
+  ];
+}
+
+export async function registerNewsTools(context: NewsModelContext, actions: NewsActions, signal: AbortSignal) {
+  for (const tool of createNewsTools(actions)) {
+    if (signal.aborted) return;
+    await context.registerTool(tool, { signal });
+  }
+}
