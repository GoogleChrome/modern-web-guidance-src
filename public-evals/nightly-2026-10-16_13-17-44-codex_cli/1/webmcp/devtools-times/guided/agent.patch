diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..ae7f139
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,56 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+// Both the UI and agent tools use the same session and publish the same updates.
+export function createNewsClient(baseUrl: string) {
+  const changes = new EventTarget();
+  let latestReadingList: string[] | undefined;
+
+  async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+    const response = await fetch(`${baseUrl}${path}`, { ...options, credentials: 'same-origin' });
+    if (!response.ok) throw new Error(`Request failed (${response.status}). Please retry.`);
+    return response.json();
+  }
+
+  function publish(readingList: string[]) {
+    latestReadingList = readingList;
+    changes.dispatchEvent(new CustomEvent('change', { detail: readingList }));
+    return readingList;
+  }
+
+  return {
+    articleUrl: (slug: string) => `${baseUrl}articles/${encodeURIComponent(slug)}`,
+    getArticles: (signal?: AbortSignal) => request<Article[]>('api/articles.json', { signal }),
+    async getReadingList(signal?: AbortSignal) {
+      const data = await request<{ readingList: string[] }>('api/reading-list.json', { signal });
+      signal?.throwIfAborted();
+      return publish(data.readingList);
+    },
+    async setBookmark(slug: string, bookmarked: boolean, signal?: AbortSignal) {
+      const data = await request<{ readingList: string[] }>('api/reading-list.json', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug, bookmarked }),
+        signal,
+      });
+      signal?.throwIfAborted();
+      return publish(data.readingList);
+    },
+    subscribe(listener: (readingList: string[]) => void) {
+      const handler = (event: Event) => listener((event as CustomEvent<string[]>).detail);
+      changes.addEventListener('change', handler);
+      let active = true;
+      queueMicrotask(() => { if (active && latestReadingList) listener(latestReadingList); });
+      return () => {
+        active = false;
+        changes.removeEventListener('change', handler);
+      };
+    },
+  };
+}
+
+export type NewsClient = ReturnType<typeof createNewsClient>;
