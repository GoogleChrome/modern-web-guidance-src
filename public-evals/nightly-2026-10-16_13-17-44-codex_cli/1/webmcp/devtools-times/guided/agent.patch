diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..089696e
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,88 @@
+import type { NewsClient } from './news-client';
+
+const slugProperty = { type: 'string', minLength: 1, description: 'Article identifier returned by article search or the reading list.' };
+const schema = (properties: Record<string, object>, required: string[] = []) => ({
+  type: 'object', properties, required, additionalProperties: false,
+});
+
+export function createNewsTools(news: NewsClient, openArticle: (url: string) => Promise<void>): WebMCP.ModelContextTool[] {
+  const tools: WebMCP.ModelContextTool[] = [
+    {
+      name: 'search_articles',
+      description: 'Find news articles by words in their title or summary. Returns article details and links for reading or bookmarking.',
+      inputSchema: schema({ query: { type: 'string', minLength: 1, description: 'Words to find in article titles and summaries.' } }, ['query']),
+      async execute(input, { signal }) {
+        if (typeof input.query !== 'string' || !input.query.trim()) return { error: 'Provide a non-empty search query.' };
+        const query = input.query.trim().toLowerCase();
+        const articles = (await news.getArticles(signal)).filter(article =>
+          article.title.toLowerCase().includes(query) || article.summary.toLowerCase().includes(query));
+        return { articles: articles.map(article => ({ ...article, url: news.articleUrl(article.slug) })), total: articles.length };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Retrieve the articles saved in the current user session for later reading.',
+      inputSchema: schema({}),
+      async execute(_input, { signal }) {
+        const [articles, saved] = await Promise.all([news.getArticles(signal), news.getReadingList(signal)]);
+        return { articles: articles.filter(article => saved.includes(article.slug)).map(article => ({ ...article, url: news.articleUrl(article.slug) })) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'set_article_bookmark',
+      description: 'Save an article to the reading list or remove it, updating the visible bookmark buttons and reading list.',
+      inputSchema: schema({ slug: slugProperty, bookmarked: { type: 'boolean', description: 'Whether the article should be saved for later reading.' } }, ['slug', 'bookmarked']),
+      async execute(input, { signal }) {
+        if (typeof input.slug !== 'string' || !input.slug.trim() || typeof input.bookmarked !== 'boolean') {
+          return { error: 'Provide an article slug and a boolean bookmarked value.' };
+        }
+        const articles = await news.getArticles(signal);
+        if (!articles.some(article => article.slug === input.slug)) return { error: 'Article not found. Search for an article to get its slug.' };
+        const readingList = await news.setBookmark(input.slug, input.bookmarked, signal);
+        return { slug: input.slug, bookmarked: readingList.includes(input.slug), readingList };
+      },
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'open_article',
+      description: 'Navigate to a news article so the user can read it.',
+      inputSchema: schema({ slug: slugProperty }, ['slug']),
+      async execute(input, { signal }) {
+        if (typeof input.slug !== 'string' || !input.slug.trim()) return { error: 'Provide an article slug from search results.' };
+        const articles = await news.getArticles(signal);
+        if (!articles.some(article => article.slug === input.slug)) return { error: 'Article not found. Search for an article to get its slug.' };
+        signal.throwIfAborted();
+        const url = news.articleUrl(input.slug);
+        await openArticle(url);
+        return { url };
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  return tools.map(tool => ({
+    ...tool,
+    async execute(input, options) {
+      try {
+        options.signal.throwIfAborted();
+        if (!input || typeof input !== 'object' || Array.isArray(input)) return { error: 'Tool input must be an object.' };
+        const allowed = Object.keys((tool.inputSchema as { properties: object }).properties);
+        if (Object.keys(input).some(key => !allowed.includes(key))) return { error: `Supported fields: ${allowed.join(', ') || 'none'}.` };
+        return await tool.execute(input, options);
+      } catch (error) {
+        if (options.signal.aborted) throw error;
+        return { error: error instanceof Error ? error.message : 'The action failed. Please retry.' };
+      }
+    },
+  }));
+}
+
+export async function registerNewsTools(context: WebMCP.ModelContext | undefined, tools: WebMCP.ModelContextTool[], signal: AbortSignal) {
+  if (!context || signal.aborted) return;
+  for (const tool of tools) {
+    if (signal.aborted) return;
+    await context.registerTool(tool, { signal });
+  }
+}
