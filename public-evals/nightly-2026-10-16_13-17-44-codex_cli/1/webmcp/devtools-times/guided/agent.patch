diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..96e6b02
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,28 @@
+import { navigate } from 'astro:transitions/client';
+import { news } from '../lib/news';
+import { createNewsTools, registerNewsTools } from '../lib/webmcp';
+
+let registration: AbortController | undefined;
+function cleanup() {
+  registration?.abort();
+  registration = undefined;
+}
+
+function setup() {
+  cleanup();
+  if (!window.isSecureContext || !document.modelContext) return;
+  const controller = new AbortController();
+  registration = controller;
+  const tools = createNewsTools(news, async url => { await navigate(url); });
+  // Route cleanup unregisters tools. Each execution uses its own cancellation signal.
+  void registerNewsTools(document.modelContext, tools, controller.signal).catch(error => {
+    controller.abort();
+    if (registration === controller) registration = undefined;
+    console.warn('Could not register news tools with WebMCP:', error);
+  });
+}
+
+document.addEventListener('astro:page-load', setup);
+document.addEventListener('astro:before-swap', cleanup);
+window.addEventListener('pagehide', cleanup);
+window.addEventListener('pageshow', event => { if (event.persisted) setup(); });
diff --git a/tests/webmcp.test.ts b/tests/webmcp.test.ts
new file mode 100644
index 0000000..32433e0
--- /dev/null
+++ b/tests/webmcp.test.ts
@@ -0,0 +1,111 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createNewsClient } from '../src/lib/news-client.ts';
+import { createNewsTools, registerNewsTools } from '../src/lib/webmcp.ts';
+
+const articles = [{ slug: 'coffee-alchemy', title: 'Coffee Alchemy', summary: 'A better brew', image: '/coffee.jpg' }];
+
+function fixture() {
+  const requests: { url: string; options: RequestInit }[] = [];
+  let saved: string[] = [];
+  const fetcher: typeof fetch = async (url, options = {}) => {
+    requests.push({ url: String(url), options });
+    options.signal?.throwIfAborted();
+    if (String(url).endsWith('articles.json')) return Response.json(articles);
+    if (options.method === 'POST') {
+      const { slug, bookmarked } = JSON.parse(options.body as string);
+      saved = saved.filter(item => item !== slug);
+      if (bookmarked) saved.push(slug);
+    }
+    return Response.json({ readingList: saved });
+  };
+  const news = createNewsClient('/devtools-times/');
+  const opened: string[] = [];
+  const tools = createNewsTools(news, async url => { opened.push(url); });
+  const signal = new AbortController().signal;
+  const call = (name: string, input = {}) => tools.find(tool => tool.name === name)!.execute(input, { signal });
+  return { fetcher, requests, news, tools, signal, call, opened };
+}
+
+test('search uses title and summary and respects the application base path', async t => {
+  const f = fixture();
+  t.mock.method(globalThis, 'fetch', f.fetcher);
+  const result = await f.call('search_articles', { query: ' BREW ' }) as { articles: { url: string }[]; total: number };
+  assert.equal(result.total, 1);
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee-alchemy');
+  assert.equal(f.requests[0].options.signal, f.signal);
+  assert.deepEqual(await f.call('search_articles', { query: 'nothing matches' }), { articles: [], total: 0 });
+});
+
+test('invalid input and unknown slugs never mutate or navigate', async t => {
+  const f = fixture();
+  t.mock.method(globalThis, 'fetch', f.fetcher);
+  for (const [name, input] of [
+    ['search_articles', { query: '' }],
+    ['search_articles', { query: 3 }],
+    ['get_reading_list', { unexpected: true }],
+    ['set_article_bookmark', { slug: 'coffee-alchemy', bookmarked: 'yes' }],
+    ['set_article_bookmark', { slug: 'missing', bookmarked: true }],
+    ['open_article', { slug: 'https://example.com/' }],
+  ] as const) {
+    assert.ok((await f.call(name, input) as { error: string }).error);
+  }
+  assert.equal(f.requests.filter(request => request.options.method === 'POST').length, 0);
+  assert.deepEqual(f.opened, []);
+});
+
+test('bookmark calls set explicit state and publish updates before returning', async t => {
+  const f = fixture();
+  t.mock.method(globalThis, 'fetch', f.fetcher);
+  let visibleList: string[] = [];
+  const unsubscribe = f.news.subscribe(list => { visibleList = list; });
+  for (let i = 0; i < 2; i++) {
+    await f.call('set_article_bookmark', { slug: 'coffee-alchemy', bookmarked: true });
+    assert.deepEqual(visibleList, ['coffee-alchemy']);
+  }
+  const list = await f.call('get_reading_list') as { articles: unknown[] };
+  assert.equal(list.articles.length, 1);
+  await f.call('set_article_bookmark', { slug: 'coffee-alchemy', bookmarked: false });
+  assert.deepEqual(visibleList, []);
+  assert.equal(f.requests.at(-1)!.options.credentials, 'same-origin');
+  unsubscribe();
+});
+
+test('article navigation completes before the tool returns', async t => {
+  const f = fixture();
+  t.mock.method(globalThis, 'fetch', f.fetcher);
+  assert.deepEqual(await f.call('open_article', { slug: 'coffee-alchemy' }), { url: '/devtools-times/articles/coffee-alchemy' });
+  assert.deepEqual(f.opened, ['/devtools-times/articles/coffee-alchemy']);
+});
+
+test('network failures are actionable and cancellation propagates', async t => {
+  const f = fixture();
+  t.mock.method(globalThis, 'fetch', async () => new Response('', { status: 503 }));
+  assert.match((await f.call('search_articles', { query: 'coffee' }) as { error: string }).error, /503/);
+  t.mock.method(globalThis, 'fetch', (_url, options) => new Promise((_resolve, reject) => {
+    options?.signal?.addEventListener('abort', () => reject(options.signal!.reason), { once: true });
+  }));
+  const controller = new AbortController();
+  const execution = f.tools[0].execute({ query: 'coffee' }, { signal: controller.signal });
+  controller.abort();
+  await assert.rejects(Promise.resolve(execution), { name: 'AbortError' });
+});
+
+test('registration supports absent APIs and uses signals for route cleanup', async () => {
+  const f = fixture();
+  const controller = new AbortController();
+  const registered = new Map();
+  const context = {
+    async registerTool(tool, { signal }) {
+      registered.set(tool.name, tool);
+      signal.addEventListener('abort', () => registered.delete(tool.name));
+    },
+  } as unknown as WebMCP.ModelContext;
+  await registerNewsTools(undefined, f.tools, controller.signal);
+  await registerNewsTools(context, f.tools, controller.signal);
+  assert.equal(registered.size, 4);
+  controller.abort();
+  assert.equal(registered.size, 0);
+  await registerNewsTools(context, f.tools, controller.signal);
+  assert.equal(registered.size, 0);
+});
