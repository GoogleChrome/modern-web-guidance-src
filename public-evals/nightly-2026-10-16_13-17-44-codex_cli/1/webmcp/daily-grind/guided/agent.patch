index 0000000..15572e8
--- /dev/null
+++ b/tests/webmcp.test.cjs
@@ -0,0 +1,130 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+const script = readFileSync(new URL('../webmcp.js', `file://${__filename}`), 'utf8');
+const textNode = (textContent) => ({ textContent });
+
+// A small DOM adapter over the real page markup; no browser or network required.
+function pageDOM() {
+  const links = Array.from(html.matchAll(/<a\b([^>]*)>([^<]*)<\/a>/g), ([, attributes, label]) => ({
+    textContent: label,
+    dataset: { toolDestination: attributes.match(/data-tool-destination="([^"]+)"/)?.[1] },
+    getAttribute: (name) => attributes.match(new RegExp(`${name}="([^"]+)"`))?.[1],
+    closest() { return this.card; },
+  }));
+  const cards = Array.from(html.matchAll(/<div class="card">([\s\S]*?)<\/div>/g), ([, content]) => {
+    const link = links.find((entry) => entry.getAttribute('href') === content.match(/href="([^"]+)"/)[1]);
+    const card = { querySelector(selector) {
+      if (selector.startsWith('a')) return link;
+      return textNode(content.match(new RegExp(`<${selector}>(.*?)<\/${selector}>`))[1]);
+    } };
+    link.card = card;
+    return card;
+  });
+  return { links, querySelectorAll(selector) {
+    if (selector === 'a[data-tool-destination]') return links.filter((link) => link.dataset.toolDestination);
+    assert.equal(selector, '#seasonal-favorites .card');
+    return cards;
+  } };
+}
+
+async function harness({ supported = true, secure = true, failAt = -1 } = {}) {
+  const document = pageDOM();
+  const tools = new Map();
+  const listeners = {};
+  const navigations = [];
+  const warnings = [];
+  let attempts = 0;
+  if (supported) document.modelContext = { async registerTool(tool, { signal }) {
+    if (attempts++ === failAt) throw new Error('Registration failed');
+    assert.equal(signal.aborted, false);
+    assert.equal(tools.has(tool.name), false, 'Tool names must be unique');
+    tools.set(tool.name, tool);
+    signal.addEventListener('abort', () => tools.delete(tool.name), { once: true });
+  } };
+  const window = {
+    isSecureContext: secure,
+    location: {
+      href: 'https://daily-grind.example/', origin: 'https://daily-grind.example',
+      assign: (url) => navigations.push(url),
+    },
+    addEventListener: (name, listener) => { listeners[name] = listener; },
+  };
+  runInNewContext(script, { document, window, URL, AbortController, console: { warn: (...args) => warnings.push(args) } });
+  const flush = () => new Promise((resolve) => setImmediate(resolve));
+  await flush();
+  return { document, window, tools, navigations, warnings, flush, emit: (name, event = {}) => listeners[name]?.(event) };
+}
+
+test('registers tools with schemas and reads the real homepage content', async () => {
+  const { tools } = await harness();
+  assert.equal(tools.size, 3);
+  for (const tool of tools.values()) {
+    assert.equal(tool.inputSchema.type, 'object');
+    assert.equal(tool.inputSchema.additionalProperties, false);
+  }
+  const favorites = tools.get('get_seasonal_favorites');
+  assert.equal(favorites.annotations.readOnlyHint, true);
+  const { items } = favorites.execute({});
+  assert.equal(items.length, 3);
+  assert.equal(items[0].name, 'Maple Oat Latte');
+  assert.match(items[0].description, /Vermont maple syrup/);
+  const { destinations } = tools.get('list_site_destinations').execute({});
+  assert.equal(destinations.length, 12);
+  for (const item of items) assert.ok(destinations.some(({ id }) => id === item.destination));
+  assert.ok(!destinations.some(({ url }) => url.includes('/logout')));
+  assert.equal(destinations.find(({ id }) => id === 'espresso').label, 'Dark Roast Espresso');
+  assert.match(html, /<script src="\/webmcp.js" defer><\/script>/);
+});
+
+test('navigation accepts only a known destination and rejects malformed inputs', async () => {
+  const { tools, navigations } = await harness();
+  const navigate = tools.get('navigate_to_destination');
+  for (const input of [undefined, null, [], 'menu', {}, { destination: 7 },
+    { destination: 'logout' }, { destination: 'https://evil.example' },
+    { destination: 'menu', url: '/logout' }, { destination: '__proto__' }]) {
+    assert.ok(navigate.execute(input).error);
+  }
+  assert.equal(navigations.length, 0);
+  assert.equal(navigate.execute({ destination: 'menu' }).status, 'navigation_started');
+  assert.deepEqual(navigations, ['https://daily-grind.example/menu']);
+  for (const name of ['get_seasonal_favorites', 'list_site_destinations']) {
+    for (const input of [null, [], 'query', { extra: true }]) assert.ok(tools.get(name).execute(input).error);
+  }
+});
+
+test('rejects external links and returns an actionable error when navigation is blocked', async () => {
+  const { document, tools, window } = await harness();
+  const menu = document.links.find((link) => link.dataset.toolDestination === 'menu');
+  menu.getAttribute = () => 'https://evil.example/menu';
+  assert.ok(tools.get('navigate_to_destination').execute({ destination: 'menu' }).error);
+  window.location.assign = () => { throw new Error('Blocked'); };
+  assert.match(tools.get('navigate_to_destination').execute({ destination: 'espresso' }).error, /blocked/);
+});
+
+test('does nothing when the API is unavailable or the context is insecure', async () => {
+  for (const options of [{ supported: false }, { secure: false }]) {
+    const { tools, warnings } = await harness(options);
+    assert.equal(tools.size, 0);
+    assert.equal(warnings.length, 0);
+  }
+});
+
+test('unregisters on pagehide and restores once on back/forward cache return', async () => {
+  const { tools, emit, flush } = await harness();
+  emit('pagehide');
+  assert.equal(tools.size, 0);
+  emit('pageshow', { persisted: true });
+  emit('pageshow', { persisted: true });
+  await flush();
+  assert.equal(tools.size, 3);
+});
+
+test('rolls back partial registration and handles the failure', async () => {
+  const { tools, warnings } = await harness({ failAt: 1 });
+  assert.equal(tools.size, 0);
+  assert.equal(warnings.length, 1);
+});
diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..1c4c4b2
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,107 @@
+(() => {
+  'use strict';
+
+  // Progressive enhancement: ordinary links work without WebMCP.
+  const modelContext = document.modelContext;
+  if (!window.isSecureContext || typeof modelContext?.registerTool !== 'function') return;
+
+  const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+  const isObject = (value) => value !== null && typeof value === 'object' && !Array.isArray(value);
+  const hasNoArguments = (input) => isObject(input) && Object.keys(input).length === 0;
+
+  function destinations() {
+    return Array.from(document.querySelectorAll('a[data-tool-destination]')).flatMap((link) => {
+      const url = new URL(link.getAttribute('href'), window.location.href);
+      if (url.origin !== window.location.origin || !['https:', 'http:'].includes(url.protocol)) return [];
+      return [{
+        id: link.dataset.toolDestination,
+        label: link.closest('.card')?.querySelector('h3')?.textContent.trim() || link.textContent.trim(),
+        url: url.href,
+      }];
+    });
+  }
+
+  function createTools() {
+    return [
+      {
+        name: 'get_seasonal_favorites',
+        description: 'Read the featured coffees and their descriptions from the homepage to help choose a drink.',
+        inputSchema: emptySchema,
+        execute(input = {}) {
+          if (!hasNoArguments(input)) return { error: 'Pass an empty object; this tool takes no arguments.' };
+          return { items: Array.from(document.querySelectorAll('#seasonal-favorites .card')).map((card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            destination: card.querySelector('a[data-tool-destination]').dataset.toolDestination,
+          })) };
+        },
+        annotations: { readOnlyHint: true },
+      },
+      {
+        name: 'list_site_destinations',
+        description: 'Discover the pages linked from the homepage, including product details, ordering, and store information.',
+        inputSchema: emptySchema,
+        execute(input = {}) {
+          if (!hasNoArguments(input)) return { error: 'Pass an empty object; this tool takes no arguments.' };
+          return { destinations: destinations() };
+        },
+        annotations: { readOnlyHint: true },
+      },
+      {
+        name: 'navigate_to_destination',
+        description: 'Follow a homepage link in the current tab. Use to open the page the user wants to visit.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            destination: {
+              type: 'string',
+              enum: destinations().map(({ id }) => id),
+              description: 'The destination ID returned by the homepage discovery tools.',
+            },
+          },
+          required: ['destination'],
+          additionalProperties: false,
+        },
+        execute(input) {
+          const available = destinations();
+          if (!isObject(input) || typeof input.destination !== 'string' ||
+              Object.keys(input).some((key) => key !== 'destination')) {
+            return { error: 'Pass only a destination ID.', availableDestinations: available.map(({ id }) => id) };
+          }
+          const target = available.find(({ id }) => id === input.destination);
+          if (!target) return { error: 'Unknown destination.', availableDestinations: available.map(({ id }) => id) };
+          try {
+            window.location.assign(target.url);
+            return { status: 'navigation_started', destination: target.id, url: target.url };
+          } catch {
+            return { error: 'Navigation was blocked. Open the destination link directly.', url: target.url };
+          }
+        },
+        annotations: { readOnlyHint: false },
+      },
+    ];
+  }
+
+  let controller;
+  async function registerTools() {
+    if (controller && !controller.signal.aborted) return;
+    const registration = new AbortController();
+    controller = registration;
+    try {
+      for (const tool of createTools()) {
+        if (registration.signal.aborted) return;
+        await modelContext.registerTool(tool, { signal: registration.signal });
+      }
+    } catch (error) {
+      const wasAborted = registration.signal.aborted;
+      registration.abort(); // Roll back a partial registration without affecting other scripts' tools.
+      if (!wasAborted) console.warn('Daily Grind WebMCP tools could not be registered.', error);
+    }
+  }
+
+  window.addEventListener('pagehide', () => controller?.abort());
+  window.addEventListener('pageshow', (event) => {
+    if (event.persisted) void registerTools(); // Restore registrations after back/forward cache navigation.
+  });
+  void registerTools();
+})();
