index 0000000..7d9a7ca
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,121 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { createServer } = require('../server');
+
+async function fixture(t, options = {}) {
+  const server = createServer(options);
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  return (path = '/', { method = 'GET', headers = {}, body } = {}) =>
+    new Promise((resolve, reject) => {
+      const req = http.request({ hostname: '127.0.0.1', port: server.address().port,
+        path, method, headers, agent: false }, (res) => {
+        const chunks = [];
+        res.on('data', (chunk) => chunks.push(chunk));
+        res.on('end', () => resolve({ status: res.statusCode, headers: res.headers,
+          body: Buffer.concat(chunks).toString() }));
+      });
+      req.on('error', reject);
+      req.end(body);
+    });
+}
+
+const reportHeaders = { 'Content-Type': 'application/csp-report' };
+const reportBody = JSON.stringify({ 'csp-report': {
+  'effective-directive': 'script-src-elem', disposition: 'report',
+  'document-uri': 'https://example.test/?secret=password',
+  'blocked-uri': 'https://attacker.test/?token=secret', 'script-sample': 'private',
+} });
+
+test('all response paths carry baseline headers and the candidate policy', async (t) => {
+  const request = await fixture(t);
+  for (const path of ['/', '/styles.css', '/logout', '/missing']) {
+    const res = await request(path);
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'DENY');
+    assert.equal(res.headers['referrer-policy'], 'no-referrer');
+    assert.match(res.headers['permissions-policy'], /camera=\(\)/);
+    assert.equal(res.headers['cache-control'], 'no-store');
+    assert.equal(res.headers['strict-transport-security'], undefined);
+    assert.equal(res.headers['content-security-policy'], undefined);
+    const policy = res.headers['content-security-policy-report-only'];
+    for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+      "base-uri 'none'", "frame-ancestors 'none'", 'report-uri /csp-report']) {
+      assert.ok(policy.includes(directive));
+    }
+    assert.doesNotMatch(policy, /unsafe-inline|unsafe-eval|\*/);
+  }
+});
+
+test('enforcement and HTTPS-only HSTS are explicit deployment options', async (t) => {
+  const request = await fixture(t, { cspMode: 'enforce', hsts: true });
+  const res = await request();
+  assert.ok(res.headers['content-security-policy']);
+  assert.equal(res.headers['content-security-policy-report-only'], undefined);
+  assert.equal(res.headers['strict-transport-security'], 'max-age=86400');
+  assert.throws(() => createServer({ cspMode: 'disabled' }), /CSP_MODE/);
+});
+
+test('existing links and assets remain accessible without inline styles', async (t) => {
+  const request = await fixture(t);
+  const home = await request();
+  assert.doesNotMatch(home.body, /<style\b|\sstyle=|<script\b/i);
+  assert.match(home.body, /href="\/styles.css"/);
+  for (const [, path] of home.body.matchAll(/href="([^"]+)"/g)) {
+    assert.equal((await request(path)).status, 200, path);
+  }
+  const css = await request('/styles.css');
+  assert.match(css.headers['content-type'], /text\/css/);
+  assert.match(css.body, /https:\/\/images\.unsplash\.com\//);
+  const head = await request('/', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(head.body, '');
+});
+
+test('unknown routes, unsupported methods and malformed targets are rejected', async (t) => {
+  const request = await fixture(t);
+  for (const path of ['/server.js', '/package.json', '/.git/config', '/missing']) {
+    assert.equal((await request(path)).status, 404);
+  }
+  for (const path of ['//evil.test/', '/%zz', '/bad\\path']) {
+    assert.equal((await request(path)).status, 400);
+  }
+  const post = await request('/', { method: 'POST' });
+  assert.equal(post.status, 405);
+  assert.equal(post.headers.allow, 'GET, HEAD');
+  assert.equal((await request('/', { headers: { Host: '[malformed' } })).status, 200);
+});
+
+test('report ingestion logs only sanitized metadata', async (t) => {
+  const reports = [];
+  const request = await fixture(t, { onReport: (r) => reports.push(r) });
+  assert.equal((await request('/csp-report', { method: 'POST', headers: reportHeaders,
+    body: reportBody })).status, 204);
+  assert.deepEqual(reports, [{ directive: 'script-src-elem', disposition: 'report' }]);
+});
+
+test('report ingestion rejects wrong methods, types, invalid JSON and oversized bodies', async (t) => {
+  const request = await fixture(t, { onReport: () => assert.fail('Invalid report logged') });
+  assert.equal((await request('/csp-report')).status, 405);
+  assert.equal((await request('/csp-report', { method: 'POST' })).status, 415);
+  for (const body of ['{', 'null', '{}', '{"csp-report":[]}']) {
+    assert.equal((await request('/csp-report', { method: 'POST', headers: reportHeaders, body })).status, 400);
+  }
+  assert.equal((await request('/csp-report', { method: 'POST', headers: reportHeaders,
+    body: 'x'.repeat(16385) })).status, 413);
+});
+
+test('report volume is bounded and does not block page requests', async (t) => {
+  let count = 0;
+  const request = await fixture(t, { onReport: () => count++ });
+  for (let i = 0; i < 60; i++) {
+    assert.equal((await request('/csp-report', { method: 'POST', headers: reportHeaders,
+      body: reportBody })).status, 204);
+  }
+  const limited = await request('/csp-report', { method: 'POST', headers: reportHeaders, body: reportBody });
+  assert.equal(limited.status, 429);
+  assert.equal(limited.headers['retry-after'], '60');
+  assert.equal(count, 60);
+  assert.equal((await request()).status, 200);
+});
