+test('reports support both formats and log only allowlisted fields', async t => {
+  const logs = [];
+  const request = await fixture(t, {}, line => logs.push(line));
+  const send = (body, type = 'application/csp-report') => request('/security-reports', {
+    method: 'POST', headers: { 'content-type': type }, body: JSON.stringify(body),
+  });
+  assert.equal((await send({ 'csp-report': { 'effective-directive': 'script-src', 'document-uri': 'https://coffee.example/?token=SECRET', 'script-sample': 'SECRET' } })).status, 204);
+  assert.equal((await send([{ type: 'csp-violation', url: 'SECRET', body: { effectiveDirective: 'style-src', blockedURL: 'SECRET' } }], 'application/reports+json')).status, 204);
+  assert.equal((await send({ 'csp-report': { 'effective-directive': 'SECRET\nforged' } })).status, 204);
+  assert.deepEqual(logs.map(JSON.parse), [
+    { event: 'csp-violation', directive: 'script-src' },
+    { event: 'csp-violation', directive: 'style-src' },
+    { event: 'csp-violation', directive: 'other' },
+  ]);
+  assert.equal((await send({})).status, 400);
+  assert.equal((await send(Array(21).fill({}), 'application/reports+json')).status, 400);
+  assert.equal((await send({}, 'text/plain')).status, 415);
+  assert.equal((await request('/security-reports')).status, 405);
+  assert.equal((await request('/security-reports', { method: 'POST', headers: { 'content-type': 'application/csp-report' }, body: '{' })).status, 400);
+  assert.equal((await send({ x: 'x'.repeat(17 * 1024) })).status, 413);
+  assert.equal((await request('/security-reports', { method: 'POST', headers: { 'content-type': 'application/csp-report', 'transfer-encoding': 'chunked' }, body: 'x'.repeat(17 * 1024) })).status, 413);
+});
