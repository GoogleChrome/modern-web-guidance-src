+test('report collector limits flood volume', async t => {
+  const request = await fixture(t);
+  for (let i = 0; i < 60; i++) {
+    assert.equal((await request('/security-reports', { method: 'POST' })).status, 415);
+  }
+  const limited = await request('/security-reports', { method: 'POST' });
+  assert.equal(limited.status, 429);
+  assert.equal(limited.headers['retry-after'], '60');
+});
