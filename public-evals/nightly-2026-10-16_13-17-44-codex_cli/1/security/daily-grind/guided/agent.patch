+test('routing rejects malformed requests, unsupported methods, and file probes', async t => {
+  const request = await fixture(t);
+  for (const path of ['/%ZZ', '//attacker.example/path', 'http://attacker.example/']) {
+    assert.equal((await request(path)).status, 400);
+  }
+  for (const path of ['/server.js', '/package.json', '/.env', '/%2e%2e/server.js', '/unknown']) {
+    assert.equal((await request(path)).status, 404);
+  }
+  assert.equal((await request('/', { headers: { host: '[invalid' } })).status, 200);
+  const post = await request('/', { method: 'POST' });
+  assert.equal(post.status, 405);
+  assert.equal(post.headers.allow, 'GET, HEAD');
+  const head = await request('/', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(head.text, '');
+  assert.equal((await request('/')).status, 200);
+});
