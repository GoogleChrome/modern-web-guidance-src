+test('fetch metadata allows inbound links but blocks cross-site subresource reads', async t => {
+  const request = await fixture(t);
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'no-cors', 'sec-fetch-dest': 'iframe' } })).status, 403);
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } })).status, 200);
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'object' } })).status, 403);
+  assert.match((await request('/')).headers.vary, /Sec-Fetch-Site/);
