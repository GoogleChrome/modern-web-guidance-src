+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsStuckFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = navigation.getBoundingClientRect().height;
+
+    // The document is the scroll root; section bounds release each header at its end.
+    function updateStuckHeaders() {
+      if (!needsStuckFallback) return;
+      stickyContainers.forEach(container => {
+        const section = container.parentElement.getBoundingClientRect();
+        const header = container.getBoundingClientRect();
+        container.classList.toggle('is-stuck',
+          section.top < navigationHeight && header.top >= navigationHeight - 0.5);
+      });
+    }
+
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--navigation-height', `${navigationHeight}px`);
+      updateStuckHeaders();
+    }).observe(navigation);
+
+    if (needsStuckFallback) {
+      let framePending = false;
+      window.addEventListener('scroll', () => {
+        if (framePending) return;
+        framePending = true;
+        requestAnimationFrame(() => {
+          updateStuckHeaders();
+          framePending = false;
+        });
+      }, { passive: true });
+      window.addEventListener('resize', updateStuckHeaders);
+      updateStuckHeaders();
+    }
+  </script>
+
