+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded'
+    };
+
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command === '--reset') {
+        actionTarget.classList.remove(...Object.values(commandClasses));
+      } else if (Object.hasOwn(commandClasses, event.command)) {
+        actionTarget.classList.toggle(commandClasses[event.command]);
+      } else {
+        return;
+      }
+
+      document.querySelectorAll('button[commandfor="action-target"][aria-pressed]').forEach((button) => {
+        button.setAttribute('aria-pressed', actionTarget.classList.contains(commandClasses[button.getAttribute('command')]));
+      });
+    });
+  </script>
+
