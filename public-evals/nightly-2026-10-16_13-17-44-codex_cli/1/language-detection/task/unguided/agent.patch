+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const message = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-button');
+      const status = document.getElementById('detection-status');
+      const download = document.getElementById('download-progress');
+      const progress = document.getElementById('model-progress');
+      const downloadLabel = document.getElementById('download-label');
+      const result = document.getElementById('detection-result');
+      let detector;
+      let busy = false;
+
+      async function checkAvailability() {
+        if (!('LanguageDetector' in window)) {
+          status.textContent = 'Language detection is not supported in this browser. Try a browser with built-in language detection, such as desktop Chrome.';
+          return;
+        }
+
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            status.textContent = 'Language detection is unavailable on this device.';
+            return;
+          }
+          status.textContent = availability === 'available'
+            ? 'Ready to detect your message’s language.'
+            : 'Your browser needs to download a language model. Click Detect to continue.';
+          button.disabled = false;
+        } catch (error) {
+          status.textContent = 'Could not check language detection availability. Reload the page to try again.';
+        }
+      }
+
+      message.addEventListener('input', () => {
+        message.setCustomValidity('');
+        result.hidden = true;
+      });
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (busy || button.disabled) return;
+        const text = message.value.trim();
+        if (!text) {
+          message.setCustomValidity('Please enter a message to detect its language.');
+          message.reportValidity();
+          return;
+        }
+
+        busy = true;
+        button.disabled = true;
+        message.readOnly = true;
+        form.setAttribute('aria-busy', 'true');
+        result.hidden = true;
+        status.textContent = 'Preparing language detection…';
+
+        try {
+          if (!detector) {
+            // Create within the user's submit gesture so model downloads are permitted.
+            detector = await LanguageDetector.create({
+              monitor(monitor) {
+                monitor.addEventListener('downloadprogress', (event) => {
+                  const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                  download.hidden = false;
+                  progress.value = percentage;
+                  downloadLabel.textContent = `Downloading language model: ${percentage}%`;
+                  status.textContent = 'Downloading the language model…';
+                });
+              }
+            });
+          }
+
+          download.hidden = true;
+          status.textContent = 'Detecting language…';
+          const results = await detector.detect(text);
+          const best = results[0];
+          if (!best || !best.detectedLanguage || best.detectedLanguage === 'und' || !Number.isFinite(best.confidence)) {
+            status.textContent = 'Could not identify a language. Try a longer message.';
+            return;
+          }
+
+          let language = best.detectedLanguage;
+          try {
+            language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+          } catch (error) {
+            // Keep the language code if display names are unavailable.
+          }
+          const confidence = (Math.min(1, Math.max(0, best.confidence)) * 100).toFixed(1);
+          result.textContent = `Language: ${language} · AI confidence: ${confidence}%`;
+          result.hidden = false;
+          status.textContent = 'Detection complete. Confidence is an estimate; short or mixed-language messages may be less accurate.';
+        } catch (error) {
+          if (detector) detector.destroy();
+          detector = undefined;
+          status.textContent = 'Language detection failed. Check your connection if the model needs downloading, then click Detect to try again.';
+        } finally {
+          busy = false;
+          button.disabled = false;
+          message.readOnly = false;
+          form.setAttribute('aria-busy', 'false');
+          download.hidden = true;
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
 </body>
 
