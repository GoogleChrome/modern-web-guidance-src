     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-button');
+    const status = document.getElementById('detection-status');
+    const download = document.getElementById('model-download');
+    const progress = document.getElementById('download-progress');
+    const percentage = document.getElementById('download-percentage');
+    let detector;
+    let availability = 'unavailable';
+    let busy = false;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Built-in language detection is not supported in this browser. Try a browser with Language Detector support.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        button.disabled = false;
+        status.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and analyze your message.';
+      } catch {
+        status.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || availability === 'unavailable') return;
+      const text = message.value.trim();
+      if (!text) {
+        status.textContent = 'Enter a message before detecting its language.';
+        message.focus();
+        return;
+      }
+
+      busy = true;
+      button.disabled = true;
+      message.readOnly = true;
+      form.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing language detection…';
+
+      try {
+        if (!detector) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            download.hidden = false;
+            progress.value = 0;
+            percentage.textContent = '0%';
+            status.textContent = 'Downloading language model…';
+          }
+          // Create directly from the user action so model downloads are permitted.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const value = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                download.hidden = false;
+                progress.value = value;
+                percentage.textContent = `${value}%`;
+              });
+            }
+          });
+          availability = 'available';
+        }
+
+        download.hidden = true;
+        status.textContent = 'Detecting language…';
+        const [result] = await detector.detect(text);
+        if (!result || result.detectedLanguage === 'und') {
+          status.textContent = 'Could not identify a language. Try a longer message with a few complete sentences.';
+          return;
+        }
+        const language = new Intl.DisplayNames(['en'], { type: 'language' }).of(result.detectedLanguage);
+        const confidence = new Intl.NumberFormat('en', { style: 'percent', maximumFractionDigits: 1 }).format(result.confidence);
+        status.textContent = `Language: ${language}. AI confidence: ${confidence}.`;
+      } catch {
+        detector?.destroy();
+        detector = undefined;
+        status.textContent = 'Language detection failed. Please try again. If a download is needed, check your connection.';
+      } finally {
+        busy = false;
+        button.disabled = false;
+        message.readOnly = false;
+        form.removeAttribute('aria-busy');
+        download.hidden = true;
+      }
+    });
+
+    checkAvailability();
+  </script>
 </body>
 
