+  <script>
+    const newsletter = document.querySelector('#newsletter');
+    const newsletterEmail = document.querySelector('#newsletter-email');
+
+    const syncNewsletterAria = () => {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    };
+
+    const updateNewsletterState = () => {
+      syncNewsletterAria();
+      // Recheck after the browser finishes updating its native interaction state.
+      requestAnimationFrame(syncNewsletterAria);
+    };
+
+    for (const event of ['blur', 'input', 'change', 'focus', 'invalid']) {
+      newsletterEmail.addEventListener(event, updateNewsletterState);
+    }
+
+    newsletter.addEventListener('reset', () => requestAnimationFrame(syncNewsletterAria));
+    newsletter.addEventListener('submit', (event) => {
+      // Keep the email on this page until a newsletter service is connected.
+      event.preventDefault();
+      updateNewsletterState();
+    });
+  </script>
+
