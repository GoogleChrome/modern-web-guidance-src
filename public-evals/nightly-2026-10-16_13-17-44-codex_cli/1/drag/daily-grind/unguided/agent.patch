@@ -207,6 +247,73 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <aside class="floating-card" aria-label="Coffee break">
+    <button class="drag-handle" type="button" aria-label="Move coffee card. Drag or use arrow keys; hold Shift for larger steps.">
+      <span>Drag to move</span>
+      <span aria-hidden="true">⠿</span>
+    </button>
+    <div class="floating-card-content">
+      <h3>A little pick-me-up</h3>
+      <p>Your next favorite cup is waiting. Make time for a coffee break.</p>
+      <a href="/order-online" class="btn">Find your coffee</a>
+    </div>
+  </aside>
+
+  <script>
+    const floatingCard = document.querySelector('.floating-card');
+    const dragHandle = floatingCard.querySelector('.drag-handle');
+    let drag = null;
+
+    function moveCard(left, top) {
+      const maxLeft = Math.max(0, window.innerWidth - floatingCard.offsetWidth);
+      const maxTop = Math.max(0, window.innerHeight - floatingCard.offsetHeight);
+      floatingCard.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+      floatingCard.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      floatingCard.style.right = 'auto';
+      floatingCard.style.bottom = 'auto';
+    }
+
+    dragHandle.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || drag) return;
+      const rect = floatingCard.getBoundingClientRect();
+      drag = { pointerId: event.pointerId, x: event.clientX - rect.left, y: event.clientY - rect.top };
+      dragHandle.setPointerCapture(event.pointerId);
+      dragHandle.classList.add('is-dragging');
+    });
+
+    dragHandle.addEventListener('pointermove', (event) => {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      moveCard(event.clientX - drag.x, event.clientY - drag.y);
+    });
+
+    function endDrag(event) {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      drag = null;
+      dragHandle.classList.remove('is-dragging');
+      if (dragHandle.hasPointerCapture(event.pointerId)) {
+        dragHandle.releasePointerCapture(event.pointerId);
+      }
+    }
+
+    dragHandle.addEventListener('pointerup', endDrag);
+    dragHandle.addEventListener('pointercancel', endDrag);
+    dragHandle.addEventListener('lostpointercapture', endDrag);
+    dragHandle.addEventListener('keydown', (event) => {
+      const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+      const direction = directions[event.key];
+      if (!direction) return;
+      event.preventDefault();
+      const rect = floatingCard.getBoundingClientRect();
+      const step = event.shiftKey ? 40 : 10;
+      moveCard(rect.left + direction[0] * step, rect.top + direction[1] * step);
+    });
+
+    window.addEventListener('resize', () => {
+      const rect = floatingCard.getBoundingClientRect();
+      moveCard(rect.left, rect.top);
+    });
+  </script>
+
 </body>
 
