+const $ = (selector) => document.querySelector(selector);
+const storageKey = 'daily-grind-demo-passkeys-v1';
+const seedPasskeys = [
+  { id: 'macbook', name: 'MacBook Pro', type: 'laptop', provider: 'iCloud Keychain', created: '2026-09-24T09:30:00Z', lastUsed: '2026-10-16T08:42:00Z', current: true },
+  { id: 'iphone', name: 'iPhone 15', type: 'phone', provider: 'iCloud Keychain', created: '2026-09-24T09:35:00Z', lastUsed: '2026-10-15T14:10:00Z', current: false },
+  { id: 'yubikey', name: 'YubiKey 5C NFC', type: 'key', provider: 'Security key', created: '2026-10-02T10:00:00Z', lastUsed: '2026-10-09T11:20:00Z', current: false }
+];
+let passkeys = structuredClone(seedPasskeys);
+let storageAvailable = true;
+try {
+  const saved = localStorage.getItem(storageKey);
+  if (saved !== null) {
+    const parsed = JSON.parse(saved);
+    if (Array.isArray(parsed) && parsed.every(p => p && typeof p.id === 'string' && typeof p.name === 'string' && typeof p.provider === 'string' && ['laptop','phone','key'].includes(p.type) && Number.isFinite(Date.parse(p.created)) && (p.lastUsed === null || Number.isFinite(Date.parse(p.lastUsed))))) passkeys = parsed;
+  }
+} catch { storageAvailable = false; }
+const escapeHTML = (value) => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const date = value => new Date(value).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'});
+const lastUsed = p => p.id === 'macbook' ? 'Just now' : p.id === 'iphone' ? 'Yesterday' : p.id === 'yubikey' ? '7 days ago' : p.lastUsed ? date(p.lastUsed) : 'Not used yet';
+let toastTimer;
+function notify(message) {
+  $('#toast').textContent = message;
+  $('#toast').classList.add('visible');
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => $('#toast').classList.remove('visible'), 3500);
+}
+function save(next) {
+  try { localStorage.setItem(storageKey, JSON.stringify(next)); storageAvailable = true; }
+  catch { storageAvailable = false; }
+  passkeys = next;
+  render();
+}
+function render() {
+  $('#tab-count').textContent = String(passkeys.length);
+  $('#list-count').textContent = String(passkeys.length);
+  $('#passkey-list').innerHTML = passkeys.length ? passkeys.map(p => `<article class="passkey-row" data-id="${escapeHTML(p.id)}">
+    <span class="device-icon"><svg aria-hidden="true"><use href="#${p.type}"/></svg></span>
+    <div class="device-info"><div class="device-title"><strong>${escapeHTML(p.name)}</strong>${p.current ? '<span class="current-badge">This device</span>' : ''}</div><p class="provider">${escapeHTML(p.provider)}</p><p>Added ${date(p.created)}</p></div>
+    <div class="device-recency">${lastUsed(p)}<span>Last used</span></div>
+    <div class="menu-container"><button class="more-button" aria-label="Manage ${escapeHTML(p.name)}" aria-expanded="false" aria-controls="menu-${escapeHTML(p.id)}">···</button><div class="row-menu" id="menu-${escapeHTML(p.id)}" hidden><button data-action="details">View details</button><button data-action="rename">Rename passkey</button><button data-action="remove">Remove passkey</button></div></div></article>`).join('') : '<div class="empty-state"><svg aria-hidden="true"><use href="#key"/></svg><h3>A fresh start for your sign-in</h3><p>You haven’t added any passkeys.<br>Add one to keep your next sign-in simple.</p></div>';
+}
+function closeMenus(returnFocus = false) {
+  document.querySelectorAll('.more-button[aria-expanded="true"]').forEach(button => {
+    button.setAttribute('aria-expanded', 'false');
+    button.nextElementSibling.hidden = true;
+    if (returnFocus) button.focus();
+  });
+}
+const dialog = $('#manage-dialog');
