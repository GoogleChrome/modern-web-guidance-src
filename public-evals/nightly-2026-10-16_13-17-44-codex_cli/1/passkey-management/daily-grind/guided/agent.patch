+  }
+  const action = event.target.closest('[data-action]');
+  if (action) showDialog(action.dataset.action, action.closest('[data-id]').dataset.id);
+});
+document.addEventListener('click', event => { if (!event.target.closest('.menu-container')) closeMenus(); });
+document.addEventListener('keydown', event => { if (event.key === 'Escape' && !dialog.open) closeMenus(true); });
+document.addEventListener('focusin', event => { if (!event.target.closest('.menu-container') && !dialog.open) closeMenus(); });
