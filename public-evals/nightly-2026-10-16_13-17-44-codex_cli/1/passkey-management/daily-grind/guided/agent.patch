--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,99 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { Window } from 'happy-dom';
+
+const html = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const script = readFileSync(new URL('../app.js', import.meta.url), 'utf8');
+const key = 'daily-grind-demo-passkeys-v1';
+function setup(saved) {
+  const window = new Window({ url:'http://localhost:11222', settings:{disableCSSFileLoading:true,disableJavaScriptFileLoading:true} });
+  window.structuredClone = structuredClone;
+  window.document.write(html);
+  if (saved !== undefined) window.localStorage.setItem(key, saved);
+  window.eval(script);
+  const $ = s => window.document.querySelector(s);
+  const submit = () => $('#manage-form').dispatchEvent(new window.Event('submit',{cancelable:true,bubbles:true}));
+  const manage = (id, action) => { $(`[data-id="${id}"] .more-button`).click(); $(`[data-id="${id}"] [data-action="${action}"]`).click(); };
+  return {window,$,submit,manage};
+}
+test('shows saved devices and opens details with a native modal', () => {
+  const {window,$,manage} = setup();
+  assert.equal($('#list-count').textContent,'3');
+  manage('macbook','details');
+  assert.equal($('#manage-dialog').open,true);
+  assert.equal($('#dialog-title').textContent,'MacBook Pro');
+  assert.match($('#dialog-fields').textContent,/iCloud Keychain/);
+  window.happyDOM.abort();
+});
+test('rename persists safely and rejects blank or duplicate names', () => {
+  const {window,$,manage,submit} = setup();
+  manage('macbook','rename');
+  $('#passkey-name').value = '   ';
+  submit();
+  assert.match($('#form-error').textContent,/Enter a name/);
+  $('#passkey-name').value = 'iPhone 15';
+  submit();
+  assert.match($('#form-error').textContent,/different name/);
+  $('#passkey-name').value = '<b>Work laptop</b>';
+  submit();
+  assert.equal($('[data-id="macbook"] strong').textContent,'<b>Work laptop</b>');
+  assert.equal($('[data-id="macbook"] strong b'),null);
+  const saved = window.localStorage.getItem(key);
+  const reloaded = setup(saved);
+  assert.equal(reloaded.$('[data-id="macbook"] strong').textContent,'<b>Work laptop</b>');
+  window.happyDOM.abort(); reloaded.window.happyDOM.abort();
+});
+test('add flow clearly identifies demo registration and updates counts', () => {
+  const {window,$,submit} = setup();
+  $('#add-passkey').click();
+  assert.match($('#dialog-description').textContent,/does not register a sign-in credential/);
+  $('#passkey-name').value = 'Backup phone';
+  $('#passkey-type').value = 'phone';
+  submit();
+  assert.equal($('#list-count').textContent,'4');
+  assert.equal($('#tab-count').textContent,'4');
+  const saved = JSON.parse(window.localStorage.getItem(key));
+  assert.equal(saved[3].name,'Backup phone');
+  assert.equal(saved[3].type,'phone');
+  window.happyDOM.abort();
+});
+test('removal requires confirmation and supports cancel, last-device warning and empty state', () => {
+  const {window,$,manage,submit} = setup();
+  manage('macbook','remove');
+  $('.dialog-actions .close-button').click();
+  assert.equal($('#list-count').textContent,'3');
+  for (const id of ['macbook','iphone']) { manage(id,'remove'); submit(); }
+  manage('yubikey','remove');
+  assert.match($('#dialog-description').textContent,/last passkey/);
+  submit();
+  assert.equal($('#list-count').textContent,'0');
+  assert.ok($('.empty-state'));
+  assert.equal(window.localStorage.getItem(key),'[]');
+  const reloaded = setup('[]');
+  assert.equal(reloaded.$('#list-count').textContent,'0');
+  window.happyDOM.abort(); reloaded.window.happyDOM.abort();
+});
+test('invalid stored data falls back safely to the sample account', () => {
+  for (const saved of ['invalid-json','{}','[{"name":"broken"}]']) {
+    const {window,$} = setup(saved);
+    assert.equal($('#list-count').textContent,'3');
+    window.happyDOM.abort();
+  }
+});
+test('tabs, navigation and preference persistence work', () => {
+  const {window,$} = setup();
+  $('[data-tab="sessions"]').click();
+  assert.equal($('#passkey-panel').hidden,true);
+  assert.match($('#other-tab-panel').textContent,/no authenticated sessions/);
+  $('[data-return-passkeys]').click();
+  assert.equal($('#passkey-panel').hidden,false);
+  $('[data-section="Preferences"]').click();
+  $('#news-preference').checked = true;
+  $('#save-preferences').click();
+  assert.equal(JSON.parse(window.localStorage.getItem('daily-grind-preferences')).news,true);
+  $('[data-section="Security & sign-in"]').click();
+  assert.equal($('#security-content').hidden,false);
+  assert.equal($('#page-title').textContent,'Security & sign-in');
+  window.happyDOM.abort();
+});
