+    submit.hidden = true;
+    $('.dialog-actions .close-button').textContent = 'Done';
+  } else if (action === 'help') {
+    title.textContent = 'A little help with passkeys';
+    description.textContent = 'Use the three-dot menu beside a passkey to view its details, rename it, or remove it. Keep a second passkey or your password available in case you lose a device. This is a demo account; changes are saved only in this browser.';
+    submit.hidden = true;
+    $('.dialog-actions .close-button').textContent = 'Got it';
+  } else if (action === 'signout') {
+    title.textContent = 'You’re in a demo account';
+    description.textContent = 'There’s no active sign-in session to end. You can reset this preview to restore the sample devices and clear your local changes.';
+    submit.textContent = 'Reset demo account';
+  } else return;
+  dialog.showModal();
+  if (action === 'remove') $('.dialog-actions .close-button').focus();
+}
+$('#manage-form').addEventListener('submit', event => {
+  event.preventDefault();
+  const p = passkeys.find(item => item.id === selectedId);
+  if (['rename','add'].includes(dialogAction)) {
+    const name = $('#passkey-name').value.trim();
+    if (!name) { $('#form-error').textContent = 'Enter a name for this passkey.'; $('#passkey-name').focus(); return; }
+    if (passkeys.some(item => item.id !== selectedId && item.name.toLowerCase() === name.toLowerCase())) { $('#form-error').textContent = 'Choose a different name so you can tell your passkeys apart.'; return; }
+    if (dialogAction === 'rename' && p) save(passkeys.map(item => item.id === p.id ? {...item,name} : item));
+    if (dialogAction === 'add') {
+      const type = $('#passkey-type').value;
+      save([...passkeys,{id:crypto.randomUUID(),name,type,provider:type === 'key' ? 'Security key' : 'Device passkey',created:new Date().toISOString(),lastUsed:null,current:false}]);
+    }
+    notify(storageAvailable ? (dialogAction === 'add' ? 'Demo passkey added.' : 'Passkey name updated.') : 'Updated for this visit. Browser storage is unavailable.');
+  } else if (dialogAction === 'remove' && p) {
+    save(passkeys.filter(item => item.id !== p.id));
+    notify(storageAvailable ? 'Passkey removed from the demo account.' : 'Removed for this visit. Browser storage is unavailable.');
+  } else if (dialogAction === 'signout') { save(structuredClone(seedPasskeys)); notify('Demo account restored.'); }
+  dialog.close();
+});
+document.querySelectorAll('.close-button').forEach(button => button.addEventListener('click', () => dialog.close()));
+dialog.addEventListener('close', () => {
+  if (dialogOpener?.isConnected) dialogOpener.focus();
+  else if (selectedId && document.querySelector(`[data-id="${selectedId}"] .more-button`)) document.querySelector(`[data-id="${selectedId}"] .more-button`).focus();
+  else $('#add-passkey').focus();
+});
+$('#add-passkey').addEventListener('click', () => showDialog('add'));
+$('#help-button').addEventListener('click', () => showDialog('help'));
+$('#signout').addEventListener('click', () => showDialog('signout'));
+$('#passkey-list').addEventListener('click', event => {
+  const more = event.target.closest('.more-button');
+  if (more) {
