diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..2463dc6
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { json, sameOrigin } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  try {
+    const { username, password } = await request.json();
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'The username or password is incorrect.' }, 401);
+    if (!session) return json({ error: 'Sessions are unavailable. Please try again.' }, 503);
+    await session.regenerate();
+    await session.set('account', username);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to sign in right now. Please try again.' }, 503);
+  }
+};
diff --git a/src/pages/api/passkeys/authenticate.ts b/src/pages/api/passkeys/authenticate.ts
