diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..aab3e17
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,33 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { createHash } from 'node:crypto';
+
+let database: DatabaseSync;
+export function db() {
+  if (!database) {
+    const directory = process.env.ACCOUNT_DATA_DIR || './.data';
+    mkdirSync(directory, { recursive: true, mode: 0o700 });
+    database = new DatabaseSync(join(directory, 'accounts.sqlite'));
+    database.exec(`PRAGMA journal_mode=WAL;
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, account TEXT NOT NULL, name TEXT NOT NULL,
+        public_key TEXT NOT NULL, counter INTEGER NOT NULL,
+        transports TEXT NOT NULL, backed_up INTEGER NOT NULL,
+        created_at TEXT NOT NULL, last_used_at TEXT
+      );`);
+  }
+  return database;
+}
+export function accountID(username: string) {
+  return createHash('sha256').update(username).digest();
+}
+export function listPasskeys(account: string) {
+  return db().prepare('SELECT id, name, created_at AS createdAt, last_used_at AS lastUsedAt, backed_up AS backedUp FROM passkeys WHERE account = ? ORDER BY created_at DESC').all(account);
+}
+export function json(data: unknown, status = 200) {
+  return Response.json(data, { status, headers: { 'Cache-Control': 'no-store' } });
+}
+export function sameOrigin(request: Request) {
+  return request.headers.get('origin') === new URL(request.url).origin;
+}
