@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions, verifyAuthenticationResponse, type WebAuthnCredential } from '@simplewebauthn/server';
+import { db, json, sameOrigin } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sessions are unavailable.' }, 503);
+  const url = new URL(request.url);
+  try {
+    const body = await request.json();
+    if (body.action === 'options') {
+      const options = await generateAuthenticationOptions({ rpID: url.hostname, userVerification: 'required' });
+      await session.set('passkeyLoginChallenge', { challenge: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    const challenge = await session.get('passkeyLoginChallenge') as { challenge: string; expires: number } | undefined;
+    await session.delete('passkeyLoginChallenge');
+    if (!challenge || challenge.expires < Date.now()) return json({ error: 'Your request expired. Please try again.' }, 400);
+    const key = db().prepare('SELECT * FROM passkeys WHERE id = ?').get(body.credential?.id) as {
+      id: string; account: string; public_key: string; counter: number; transports: string;
+    } | undefined;
+    if (!key) return json({ error: 'This passkey is no longer registered. Please sign in with your password.' }, 401);
+    const credential: WebAuthnCredential = { id: key.id, publicKey: new Uint8Array(Buffer.from(key.public_key, 'base64url')), counter: key.counter, transports: JSON.parse(key.transports) };
+    const verification = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: challenge.challenge,
+      expectedOrigin: url.origin, expectedRPID: url.hostname, credential, requireUserVerification: true });
+    if (!verification.verified) return json({ error: 'Unable to verify this passkey.' }, 401);
+    const result = db().prepare('UPDATE passkeys SET counter = ?, last_used_at = ?, backed_up = ? WHERE id = ? AND counter = ?').run(
+      verification.authenticationInfo.newCounter, new Date().toISOString(), Number(verification.authenticationInfo.credentialBackedUp), key.id, key.counter);
+    if (!result.changes) return json({ error: 'This passkey changed. Please try again.' }, 401);
+    await session.regenerate();
+    await session.set('account', key.account);
+    return json({ success: true });
+  } catch { return json({ error: 'Unable to sign in with this passkey. Please try again or use your password.' }, 400); }
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..076a531
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { db, json, listPasskeys, sameOrigin } from '../../../lib/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const account = await session?.get('account');
+  if (typeof account !== 'string') return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  return json({ passkeys: listPasskeys(account) });
+};
+const mutate: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  const account = await session?.get('account');
+  if (typeof account !== 'string') return json({ error: 'Please sign in again.' }, 401);
+  try {
+    const { id, name } = await request.json();
+    if (typeof id !== 'string') return json({ error: 'Choose a passkey.' }, 400);
+    if (request.method === 'PATCH' && (typeof name !== 'string' || !name.trim() || name.trim().length > 60)) {
+      return json({ error: 'Use a name between 1 and 60 characters.' }, 400);
+    }
+    const result = request.method === 'DELETE'
+      ? db().prepare('DELETE FROM passkeys WHERE id = ? AND account = ?').run(id, account)
+      : db().prepare('UPDATE passkeys SET name = ? WHERE id = ? AND account = ?').run(name.trim(), id, account);
+    if (!result.changes) return json({ error: 'This passkey could not be found. Refresh and try again.' }, 404);
+    return json({ passkeys: listPasskeys(account) });
+  } catch { return json({ error: 'Unable to save this change. Please try again.' }, 400); }
+};
+export const PATCH = mutate;
+export const DELETE = mutate;
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..7cc706e
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,39 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { accountID, db, json, listPasskeys, sameOrigin } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  const account = await session?.get('account');
+  if (typeof account !== 'string' || !session) return json({ error: 'Please sign in again.' }, 401);
+  const url = new URL(request.url);
+  try {
+    const body = await request.json();
+    if (body.action === 'options') {
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID: url.hostname, userName: account,
+        userID: new Uint8Array(accountID(account)),
+        attestationType: 'none',
+        excludeCredentials: listPasskeys(account).map(key => ({ id: String(key.id) })),
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+      });
+      await session.set('passkeyChallenge', { challenge: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    const challenge = await session.get('passkeyChallenge') as { challenge: string; expires: number } | undefined;
+    await session.delete('passkeyChallenge');
+    if (!challenge || challenge.expires < Date.now()) return json({ error: 'Your request expired. Please try again.' }, 400);
+    if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 60) return json({ error: 'Enter a passkey name of up to 60 characters.' }, 400);
+    const result = await verifyRegistrationResponse({ response: body.credential,
+      expectedChallenge: challenge.challenge, expectedOrigin: url.origin, expectedRPID: url.hostname,
+      requireUserVerification: true,
+    });
+    if (!result.verified || !result.registrationInfo) return json({ error: 'The passkey could not be verified.' }, 400);
+    const { credential, credentialBackedUp } = result.registrationInfo;
+    db().prepare(`INSERT INTO passkeys (id, account, name, public_key, counter, transports, backed_up, created_at)
+      VALUES (?, ?, ?, ?, ?, ?, ?, ?)`).run(credential.id, account, body.name.trim(),
+        Buffer.from(credential.publicKey).toString('base64url'), credential.counter,
+        JSON.stringify(credential.transports || []), Number(credentialBackedUp), new Date().toISOString());
+    return json({ passkeys: listPasskeys(account) }, 201);
+  } catch { return json({ error: 'Unable to register this passkey. Please try again.' }, 400); }
+};
