+      </li>)}</ul> : <div className="empty-passkeys"><div className="empty-key-icon"><KeyIcon /></div><h3>{signedIn ? 'Your next sign-in, simplified.' : 'A safer way to sign in starts here.'}</h3><p>{signedIn ? 'Add your first passkey to keep your account secure with your fingerprint, face, or screen lock.' : 'Sign in to see your registered passkeys, give them a name, or remove the ones you no longer use.'}</p>{signedIn && <button disabled={!supported} className="text-button" onClick={() => open({ type: 'add' })}>Add your first passkey <ArrowRightIcon /></button>}</div>}
+      <div className="card-footnote"><ShieldCheckIcon /><span>Your biometric information stays on your device. It’s never shared with us.</span></div>
+    </section>
+    <dialog ref={dialog} className="passkey-dialog" aria-labelledby="passkey-dialog-title" onCancel={e => { if (busy) e.preventDefault(); }} onClose={() => setAction(null)}>
+      <form onSubmit={save}><button type="button" className="dialog-close" aria-label="Close dialog" disabled={busy} onClick={close}><XMarkIcon /></button>
+        <div className="dialog-icon"><KeyIcon /></div>
+        <h2 id="passkey-dialog-title">{action?.type === 'add' ? 'Add a passkey' : action?.type === 'rename' ? 'Rename passkey' : 'Remove this passkey?'}</h2>
+        {action?.type === 'remove' ? <p>“{action.key.name}” will no longer work for your account. You can still sign in with your password. This won’t delete the passkey from your device or password manager.</p> : <><p>{action?.type === 'add' ? 'Give your passkey a name you’ll recognize. Your device will then guide you through creating it.' : 'Choose a name that helps you recognize this passkey.'}</p><label htmlFor="passkey-name">Passkey name</label><input id="passkey-name" autoFocus required maxLength={60} value={name} onChange={e => setName(e.target.value)} placeholder="e.g. Personal MacBook" disabled={busy} /></>}
+        {modalError && <p className="modal-error" role="alert">{modalError}</p>}
+        <div className="dialog-actions"><button type="button" className="secondary-button" disabled={busy} onClick={close}>Cancel</button><button type="submit" className={action?.type === 'remove' ? 'danger-button' : 'primary-button'} disabled={busy || (action?.type !== 'remove' && !name.trim())}>{busy ? 'Please wait…' : action?.type === 'add' ? 'Create passkey' : action?.type === 'rename' ? 'Save changes' : 'Remove passkey'}</button></div>
+      </form>
