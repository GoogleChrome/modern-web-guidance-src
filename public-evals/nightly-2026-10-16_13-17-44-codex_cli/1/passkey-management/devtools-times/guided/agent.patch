diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..fd0cf6e
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { db } from '../src/lib/passkeys';
+import { GET, PATCH, DELETE } from '../src/pages/api/passkeys/index';
+import { POST as register } from '../src/pages/api/passkeys/register';
+import { POST as authenticate } from '../src/pages/api/passkeys/authenticate';
+import { POST as login } from '../src/pages/api/auth/login';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-passkeys-'));
+process.env.ACCOUNT_DATA_DIR = directory;
+function session(account?: string) {
+  const values = new Map<string, unknown>(account ? [['account', account]] : []);
+  return { get: async (key: string) => values.get(key), set: async (key: string, value: unknown) => { values.set(key, value); },
+    delete: async (key: string) => { values.delete(key); }, regenerate: async () => { values.clear(); } };
+}
+function context(method: string, body: unknown, account?: string, origin = 'https://times.test', state = session(account)) {
+  return { session: state, request: new Request('https://times.test/devtools-times/api/passkeys/', {
+    method, headers: { Origin: origin, 'Content-Type': 'application/json' }, ...(method !== 'GET' ? { body: JSON.stringify(body) } : {}),
+  }) } as any;
+}
+function seed(id: string, account: string) {
+  db().prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)').run(id, account, 'Laptop', 'AA', 0, '[]', 0, new Date().toISOString(), null);
+}
+test('passkey APIs enforce authentication, ownership, validation and one-time challenges', async () => {
+  try {
+    assert.equal((await GET(context('GET', null))).status, 401);
+    assert.equal((await register(context('POST', { action: 'options' }))).status, 401);
+    assert.equal((await DELETE(context('DELETE', { id: 'a' }, 'alice', 'https://evil.test'))).status, 403);
+    seed('a', 'alice'); seed('b', 'bob');
+    let response = await GET(context('GET', null, 'alice'));
+    const data = await response.json();
+    assert.deepEqual(data.passkeys.map((key: any) => key.id), ['a']);
+    assert.equal(data.passkeys[0].public_key, undefined);
+    assert.equal(response.headers.get('Cache-Control'), 'no-store');
+    assert.equal((await PATCH(context('PATCH', { id: 'b', name: 'Stolen' }, 'alice'))).status, 404);
+    assert.equal((await DELETE(context('DELETE', { id: 'b' }, 'alice'))).status, 404);
+    assert.equal((await PATCH(context('PATCH', { id: 'a', name: '  ' }, 'alice'))).status, 400);
+    assert.equal((await PATCH(context('PATCH', { id: 'a', name: 'x'.repeat(61) }, 'alice'))).status, 400);
+    response = await PATCH(context('PATCH', { id: 'a', name: ' Home laptop ' }, 'alice'));
+    assert.equal((await response.json()).passkeys[0].name, 'Home laptop');
+    const state = session('alice');
+    response = await register(context('POST', { action: 'options' }, 'alice', 'https://times.test', state));
+    const options = await response.json();
+    assert.equal(options.rp.id, 'times.test');
+    assert.equal(options.authenticatorSelection.userVerification, 'required');
+    assert.equal(options.excludeCredentials[0].id, 'a');
+    assert.ok(await state.get('passkeyChallenge'));
+    assert.equal((await register(context('POST', { name: 'Forged', credential: {} }, 'alice', 'https://times.test', state))).status, 400);
+    assert.equal(await state.get('passkeyChallenge'), undefined);
+    assert.equal((await authenticate(context('POST', { credential: {} }))).status, 400);
+    assert.equal((await DELETE(context('DELETE', { id: 'a' }, 'alice'))).status, 200);
+    assert.equal((await (await GET(context('GET', null, 'alice'))).json()).passkeys.length, 0);
+    assert.equal((await (await GET(context('GET', null, 'bob'))).json()).passkeys.length, 1);
+  } finally { db().close(); rmSync(directory, { recursive: true, force: true }); }
+});
+test('password login only establishes an account after upstream authentication succeeds', async () => {
+  const original = globalThis.fetch;
+  const state = session();
+  try {
+    globalThis.fetch = async () => Response.json({ error: 'incorrect' }, { status: 401 });
+    assert.equal((await login(context('POST', { username: 'alice', password: 'wrong' }, undefined, 'https://times.test', state))).status, 401);
+    assert.equal(await state.get('account'), undefined);
+    globalThis.fetch = async () => Response.json({ success: true });
+    assert.equal((await login(context('POST', { username: 'alice', password: 'valid' }, undefined, 'https://times.test', state))).status, 200);
+    assert.equal(await state.get('account'), 'alice');
+  } finally { globalThis.fetch = original; }
+});
