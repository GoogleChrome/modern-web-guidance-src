@@ -0,0 +1,95 @@
+import { useEffect, useRef, useState } from 'react';
+import { ArrowLeftIcon, ArrowRightIcon, ArrowUpRightIcon, BookOpenIcon, CheckIcon, ChevronDownIcon, ChevronRightIcon, CreditCardIcon, ComputerDesktopIcon, DevicePhoneMobileIcon, EllipsisHorizontalIcon, EnvelopeIcon, FingerPrintIcon, InformationCircleIcon, KeyIcon, LockClosedIcon, PlusIcon, QuestionMarkCircleIcon, ShieldCheckIcon, UserCircleIcon, UserIcon, XMarkIcon } from '@heroicons/react/24/outline';
+
+type Passkey = { id: string; name: string; device: string; created: string; used: string; current?: boolean };
+const initial: Passkey[] = [
+  { id: 'macbook', name: 'MacBook Pro', device: 'iCloud Keychain', created: 'October 12, 2025', used: 'Today, 9:41 AM', current: true },
+  { id: 'iphone', name: 'iPhone 15', device: 'iCloud Keychain', created: 'October 12, 2025', used: 'Yesterday, 6:24 PM' },
+];
+const navigation = [ ['Overview', UserCircleIcon], ['Personal information', UserIcon], ['Sign-in & security', ShieldCheckIcon], ['Subscription & billing', CreditCardIcon], ['Email preferences', EnvelopeIcon], ['Reading list', BookOpenIcon] ] as const;
+const faqs = [
+  ['What is a passkey?', 'A passkey is a secure alternative to a password. It lets you sign in using your fingerprint, face, or device screen lock. Your biometric information stays on your device.'],
+  ['Can I use a passkey on another device?', 'If your passkeys sync through a provider such as iCloud Keychain or Google Password Manager, you can use them on your other supported devices. You can also use your phone to sign in by scanning a QR code.'],
+  ['What happens if I lose my device?', 'You can sign in with a synced passkey on another device or use your password. Once signed in, remove the passkey for the lost device from this page.'],
+];
+const base = import.meta.env.BASE_URL;
+
+export default function AccountSettings() {
+  const [passkeys, setPasskeys] = useState(initial);
+  const [ready, setReady] = useState(false);
+  const [active, setActive] = useState('Sign-in & security');
+  const [tab, setTab] = useState('Passkeys');
+  const [menu, setMenu] = useState<string | null>(null);
+  const [modal, setModal] = useState<{ type: 'rename' | 'remove' | 'add'; key?: Passkey } | null>(null);
+  const [name, setName] = useState('');
+  const [notice, setNotice] = useState('');
+  const [profile, setProfile] = useState(false);
+  const [storageError, setStorageError] = useState(false);
+  const dialog = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    try {
+      const saved = localStorage.getItem('times-demo-passkeys');
+      if (saved) {
+        const parsed = JSON.parse(saved);
+        if (Array.isArray(parsed) && parsed.every(p => typeof p.id === 'string' && typeof p.name === 'string' && typeof p.device === 'string' && typeof p.created === 'string' && typeof p.used === 'string')) setPasskeys(parsed);
+      }
+    } catch { setStorageError(true); }
+    setReady(true);
+  }, []);
+  useEffect(() => {
+    if (ready) { try { localStorage.setItem('times-demo-passkeys', JSON.stringify(passkeys)); } catch { setStorageError(true); } }
+  }, [passkeys, ready]);
+  useEffect(() => { if (modal) dialog.current?.showModal(); else dialog.current?.close(); }, [modal]);
+  useEffect(() => {
+    if (!menu) return;
+    const close = () => setMenu(null);
+    window.addEventListener('click', close);
+    return () => window.removeEventListener('click', close);
+  }, [menu]);
+  function open(type: 'rename' | 'remove' | 'add', key?: Passkey) { setMenu(null); setName(key?.name ?? ''); setModal({ type, key }); }
+  function submit(e: React.FormEvent) {
+    e.preventDefault();
+    if (!modal) return;
+    if (modal.type !== 'remove' && !name.trim()) return;
+    if (modal.type === 'remove') { setPasskeys(passkeys.filter(p => p.id !== modal.key?.id)); setNotice('Passkey removed. You can still sign in with your other sign-in methods.'); }
+    else if (modal.type === 'rename') { setPasskeys(passkeys.map(p => p.id === modal.key?.id ? { ...p, name: name.trim() } : p)); setNotice('Passkey name updated.'); }
+    else { setPasskeys([...passkeys, { id: crypto.randomUUID(), name: name.trim(), device: 'Demo device', created: new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }), used: 'Not used yet' }]); setNotice('Demo passkey added to this preview.'); }
+    setModal(null);
+  }
+  return <>
+    <header className="account-header">
+      <div className="masthead"><a href={`${base}news`} className="brand"><img src={`${base}logo.svg`} alt="The DevTools Times" /></a><span className="header-divider" /><span className="account-label">My Account</span>
+        <div className="header-actions"><a className="back-news" href={`${base}news`}>Back to the news <ArrowUpRightIcon /></a><div className="profile-wrap"><button className="profile-button" aria-expanded={profile} aria-label="Account menu" onClick={() => setProfile(!profile)}><span className="avatar">JD</span><ChevronDownIcon /></button>{profile && <div className="profile-menu"><strong>Jamie Davis</strong><span>jamie.davis@gmail.com</span><a href={`${base}signin`}>Sign in to another account <ArrowRightIcon /></a></div>}</div></div>
+      </div>
+    </header>
+    <div className="account-shell">
+      <aside className="account-sidebar">
+        <div className="member"><span className="avatar large">JD</span><h2>Jamie Davis</h2><p>jamie.davis@gmail.com</p><span className="subscriber"><span />Digital subscriber</span></div>
+        <nav aria-label="Account settings">{navigation.map(([label, Icon]) => <button key={label} onClick={() => { if(label === 'Reading list') { window.location.href = `${base}news`; return; } setActive(label); }} className={`side-link ${active === label ? 'selected' : ''}`} aria-current={active === label ? 'page' : undefined}><Icon /><span>{label}</span>{active === label && <ChevronRightIcon className="nav-arrow" />}</button>)}</nav>
+        <div className="sidebar-help"><QuestionMarkCircleIcon /><h3>A little help?</h3><p>We're here for you.</p><a href="mailto:support@devtoolstimes.com">Contact support <ArrowUpRightIcon /></a></div>
+        <a className="sidebar-back" href={`${base}news`}><ArrowLeftIcon /> Back to The Times</a>
+      </aside>
+      <main className="settings-main">
+        <div className="breadcrumb">My account <ChevronRightIcon /> {active}</div>
+        <div className="page-heading"><span className="eyebrow">YOUR ACCOUNT, PROTECTED</span><h1>{active}</h1><p>{active === 'Sign-in & security' ? 'Manage how you sign in and keep your account secure.' : 'Your details and preferences, all in one place.'}</p></div>
+        {active === 'Sign-in & security' ? <>
+          <nav className="security-tabs" aria-label="Security settings">{['Password', 'Passkeys', 'Active sessions'].map(t => <button key={t} className={tab === t ? 'active' : ''} onClick={() => setTab(t)}>{t}{t === 'Passkeys' && <span className="tab-count">{passkeys.length}</span>}</button>)}</nav>
+          {tab === 'Passkeys' ? <>
+            <section className="passkey-intro"><div className="intro-copy"><span className="icon-tile"><FingerPrintIcon /></span><div><h2>A simpler, safer way to sign in.</h2><p>Skip the password. Use your fingerprint, face, or screen lock<br className="desktop-break" /> to sign in securely on any of your devices.</p><a href="#passkey-questions">Get to know passkeys <ArrowUpRightIcon /></a></div></div><div className="key-art" aria-hidden="true"><div className="art-orbit orbit-one"/><div className="art-orbit orbit-two"/><div className="art-spark spark-one">+</div><div className="art-spark spark-two">+</div><div className="art-key"><KeyIcon /></div><span className="art-check"><CheckIcon /></span></div></section>
+            <section className="passkeys-section" aria-labelledby="passkeys-title"><div className="section-heading"><div><h2 id="passkeys-title">Your passkeys <span>{passkeys.length}</span></h2><p>Manage the passkeys you've added to your account.</p></div><button className="primary-button" onClick={() => open('add')}><PlusIcon /> Add a passkey</button></div>
+              {notice && <div className="status-notice" role="status"><CheckIcon />{notice}<button aria-label="Dismiss notification" onClick={() => setNotice('')}><XMarkIcon /></button></div>}
+              {storageError && <p role="alert" className="storage-error">Changes cannot be saved in this browser. They will last only while this page is open.</p>}
+              <div className="passkey-list">{passkeys.map(key => <article className="passkey-row" key={key.id}><span className="device-icon">{key.id === 'iphone' ? <DevicePhoneMobileIcon /> : <ComputerDesktopIcon />}</span><div className="device-details"><div className="device-title"><h3>{key.name}</h3>{key.current && <span className="current-device">This device</span>}</div><p>{key.device}<span className="dot">·</span>Added {key.created}</p><span className="last-used">Last used: {key.used}</span></div><div className="row-action"><button className="more-button" aria-label={`Manage ${key.name}`} aria-expanded={menu === key.id} onClick={e => { e.stopPropagation(); setMenu(menu === key.id ? null : key.id); }}><EllipsisHorizontalIcon /></button>{menu === key.id && <div className="action-menu"><button onClick={() => open('rename', key)}>Rename passkey</button><button className="danger-text" onClick={() => open('remove', key)}>Remove passkey</button></div>}</div></article>)}{passkeys.length === 0 && <div className="empty-passkeys"><KeyIcon /><h3>No passkeys yet</h3><p>Add a passkey for a simpler way to sign in.</p></div>}</div>
+              <div className="security-note"><LockClosedIcon /><p>Your passkeys are encrypted and never shared with The DevTools Times.</p></div>
+            </section>
+            <section className="good-to-know"><span className="info-icon"><InformationCircleIcon /></span><div><h3>A few things to know</h3><p>You can add multiple passkeys to your account. We recommend adding a passkey on<br className="desktop-break" /> another device, so you always have a way to sign in.</p><p>Your password will still work if you need it.</p></div></section>
+            <section className="faq-section" id="passkey-questions"><h2>A little more about passkeys</h2>{faqs.map(([question, answer]) => <details key={question}><summary>{question}<PlusIcon /></summary><p>{answer}</p></details>)}</section>
+          </> : <section className="alternate-panel"><span className="icon-tile">{tab === 'Password' ? <LockClosedIcon /> : <ComputerDesktopIcon />}</span><h2>{tab === 'Password' ? 'Your password' : 'Your active sessions'}</h2><p>{tab === 'Password' ? 'Your password remains available when you need another way to sign in. Password changes require a connected account service.' : 'Session details will appear here when you sign in to a connected account.'}</p><button className="secondary-button" onClick={() => setTab('Passkeys')}>Manage passkeys <ArrowRightIcon /></button></section>}
+        </> : <section className="alternate-panel"><h2>{active === 'Overview' ? 'Welcome back, Jamie.' : active}</h2>{active === 'Personal information' || active === 'Overview' ? <><p>Manage your personal details and account security.</p><dl><dt>Name</dt><dd>Jamie Davis</dd><dt>Email address</dt><dd>jamie.davis@gmail.com</dd></dl></> : active === 'Subscription & billing' ? <><p>Digital subscriber</p><p>Unlimited access to The DevTools Times.</p></> : <p>Contact support to update newsletter preferences for this preview account.</p>}<button className="secondary-button" onClick={() => { setActive('Sign-in & security'); setTab('Passkeys'); }}>Manage account security <ArrowRightIcon /></button></section>}
+        <div className="settings-help">Need help with your account? <a href="mailto:support@devtoolstimes.com">Visit our Help Center <ArrowUpRightIcon /></a></div>
+      </main>
+    </div>
+    <footer className="account-footer"><span>© {new Date().getFullYear()} The DevTools Times Company</span><div><a href={`${base}legal/privacy`}>Privacy Policy</a><a href={`${base}legal/terms`}>Terms of Service</a><a href="mailto:support@devtoolstimes.com">Contact Us</a></div><span className="footer-lock"><LockClosedIcon /> Your trust. Our commitment.</span></footer>
+    <dialog ref={dialog} className="passkey-dialog" aria-labelledby="passkey-dialog-title" onCancel={() => setModal(null)} onClick={e => { if(e.target === dialog.current) setModal(null); }}><form onSubmit={submit}><button type="button" className="dialog-close" aria-label="Close dialog" onClick={() => setModal(null)}><XMarkIcon /></button><span className="icon-tile"><KeyIcon /></span><h2 id="passkey-dialog-title">{modal?.type === 'remove' ? 'Remove this passkey?' : modal?.type === 'rename' ? 'Rename your passkey' : 'Add a passkey'}</h2>{modal?.type === 'remove' ? <p>“{modal.key?.name}” will be removed from this preview. You can continue using your password or another passkey.</p> : <><p>{modal?.type === 'add' ? 'This is a demo account. Add a sample device to explore passkey management. No real sign-in credential will be created.' : 'Choose a name that helps you recognize this device.'}</p><label htmlFor="passkey-name">Passkey name</label><input autoFocus id="passkey-name" placeholder="e.g. My personal laptop" value={name} onChange={e => setName(e.target.value)} required maxLength={60} /></>}<div className="dialog-actions"><button type="button" className="secondary-button" onClick={() => setModal(null)}>Cancel</button><button type="submit" disabled={modal?.type !== 'remove' && !name.trim()} className={modal?.type === 'remove' ? 'danger-button' : 'primary-button'}>{modal?.type === 'remove' ? 'Remove passkey' : modal?.type === 'rename' ? 'Save changes' : 'Add demo passkey'}</button></div></form></dialog>
+  </>;
+}
