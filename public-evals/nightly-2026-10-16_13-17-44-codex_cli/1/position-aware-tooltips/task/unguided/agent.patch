     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      anchor-name: --latte-info;
+      display: inline-grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      border: 1px solid var(--secondary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1.1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: #efebe9;
+      border-color: var(--primary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .latte-tooltip {
+      position: fixed;
+      position-anchor: --latte-info;
+      position-area: top;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      inset: auto;
+      width: min(18rem, calc(100vw - 2rem));
+      margin: 0;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      text-align: left;
+      font-size: 0.875rem;
+    }
+
+    /* Style the inner surface so it can query its anchored parent. */
+    .latte-tooltip-content {
+      position: relative;
+      margin: 0 0 12px;
+      padding: 14px 16px;
+      border-radius: 12px 12px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 14px rgb(62 39 35 / 20%);
+    }
+
+    .latte-tooltip-content::after {
+      content: "";
+      position: absolute;
+      left: 50%;
+      top: 100%;
+      border: 7px solid transparent;
+      border-bottom: 0;
+      border-top-color: var(--primary);
+      transform: translateX(-50%);
+    }
+
+    @container anchored(fallback: flip-block) {
+      .latte-tooltip-content {
+        margin: 12px 0 0;
+        border-radius: 4px 4px 12px 12px;
+      }
+
+      .latte-tooltip-content::after {
+        top: auto;
+        bottom: 100%;
+        border-top: 0;
+        border-bottom: 7px solid var(--primary);
+      }
+    }
+
     footer {
