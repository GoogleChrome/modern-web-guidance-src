+  <script>
+    function updateCardExpiration(now = new Date()) {
+      // A card marked 12/2027 remains valid through December 31.
+      const expirationDay = Date.UTC(2028, 0, 1);
+      // Compare local calendar dates at UTC midnight to avoid DST shifts.
+      // Date.UTC accounts for actual month lengths, including leap days.
+      const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
+      const daysRemaining = Math.max(0, (expirationDay - today) / 86400000);
+
+      document.getElementById('card-expiration').textContent = daysRemaining > 0
+        ? `Your credit card expires in ${daysRemaining} ${daysRemaining === 1 ? 'day' : 'days'} (December 2027).`
+        : 'Your credit card expired in December 2027.';
+    }
+
+    updateCardExpiration();
+    setInterval(updateCardExpiration, 60000);
+  </script>
