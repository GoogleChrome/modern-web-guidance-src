+    <!-- Wait for the page content, including the slotted route, to be parsed. -->
+    <link rel="expect" href="#page-ready" blocking="render" />
+
+    <!-- Register before first paint, even when hydration takes longer than parsing. -->
+    <script is:inline blocking="render">
+      window.addEventListener("pagereveal", (event) => {
+        if (!event.viewTransition) return;
+
+        const pendingInitialIslands = Array.from(
+          document.querySelectorAll('astro-island[ssr]'),
+        ).some((island) => {
+          if (island.getAttribute("client") === "load") return true;
+
+          // Astro islands use display: contents, so inspect their rendered children.
+          return Array.from(island.querySelectorAll("*")).some((element) => {
+            const { top, bottom, left, right, width, height } = element.getBoundingClientRect();
+            return width > 0 && height > 0 && bottom > 0 && right > 0 &&
+              top < window.innerHeight && left < window.innerWidth;
+          });
+        });
+
+        // Hydration and web fonts can outlast the native render blockers. Show
+        // the page normally instead of animating an unfinished initial view.
+        if (pendingInitialIslands || document.fonts.status !== "loaded") {
+          event.viewTransition.skipTransition();
+        }
+      });
+    </script>
+
