@@ -92,8 +92,87 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .store-select {
+      width: min(300px, 100%);
+      margin-top: 22px;
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      color: var(--primary);
+      font: inherit;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    /* Opt into the browser's customizable native select and picker. */
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 8px;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        background: var(--light);
+        color: var(--primary);
+        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
+        opacity: 0;
+        transition: opacity 220ms ease,
+          display 220ms allow-discrete,
+          overlay 220ms allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+        }
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 220ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select option {
+        padding: 12px 16px;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        background: #efebe9;
+        font-weight: 600;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
