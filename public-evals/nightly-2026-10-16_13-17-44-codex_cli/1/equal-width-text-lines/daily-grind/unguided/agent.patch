+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const heroLines = [...heroHeading.querySelectorAll('span')];
+
+    function fitHeroHeading() {
+      const targetWidth = heroHeading.getBoundingClientRect().width;
+      // Measure the rendered font, then size each line without changing spacing.
+      heroLines.forEach(line => { line.style.fontSize = '100px'; });
+      const widths = heroLines.map(line => line.getBoundingClientRect().width);
+      heroLines.forEach((line, index) => {
+        line.style.fontSize = `${100 * targetWidth / widths[index]}px`;
+      });
+    }
+
+    fitHeroHeading();
+    new ResizeObserver(fitHeroHeading).observe(heroHeading);
+    document.fonts.ready.then(fitHeroHeading);
+  </script>
