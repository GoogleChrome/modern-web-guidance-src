     </section>
   </main>
 
   <footer>
+    <section class="mailing-list" aria-labelledby="mailing-list-heading">
+      <h2 id="mailing-list-heading">Join our mailing list</h2>
+      <p>Get fresh coffee news, seasonal favorites, and special offers.</p>
