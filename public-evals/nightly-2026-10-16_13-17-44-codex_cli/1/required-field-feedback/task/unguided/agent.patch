@@ -206,7 +275,50 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('email-error');
+    const mailingListStatus = document.getElementById('mailing-list-status');
+    let emailTouched = false;
+
+    function validateEmail() {
+      const message = emailInput.validity.valueMissing
+        ? 'Please enter your email address.'
+        : emailInput.validity.typeMismatch
+          ? 'Please enter a valid email address.'
+          : '';
+
+      emailError.textContent = message;
+      emailError.hidden = !message;
+      emailInput.setAttribute('aria-invalid', String(Boolean(message)));
+      return !message;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    emailInput.addEventListener('input', () => {
+      mailingListStatus.hidden = true;
+      if (emailTouched) validateEmail();
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!emailInput.validity.valid) {
+        if (emailTouched) validateEmail();
+        emailInput.focus();
+        return;
+      }
+
+      mailingListStatus.textContent = 'Online signups are coming soon. Please contact us to join our mailing list.';
+      mailingListStatus.hidden = false;
+    });
+  </script>
+
 </body>
 
 </html>
