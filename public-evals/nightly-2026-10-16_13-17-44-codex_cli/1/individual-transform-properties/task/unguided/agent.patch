+      background: var(--accent);
+      color: var(--text);
+      text-align: center;
+      text-decoration: none;
+      font-weight: bold;
+      line-height: 1.3;
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.18);
+      isolation: isolate;
+      /* Separate motion properties keep the hover transition independent. */
+      transform: scale(1);
+      transition: transform 0.3s ease;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 2.5s ease-in-out infinite alternate;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      transform: scale(1.15);
+    }
+
+    .target:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -20px 0; }
+      to { translate: 20px 0; }
+    }
