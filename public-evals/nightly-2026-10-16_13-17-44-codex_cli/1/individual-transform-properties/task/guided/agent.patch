@@ -106,8 +106,58 @@
       gap: 20px;
       margin-top: 20px;
     }
 
+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      min-height: 160px;
+    }
+
+    .target {
+      display: grid;
+      place-content: center;
+      width: 96px;
+      height: 96px;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      box-shadow: 0 4px 12px rgb(78 52 46 / 18%);
+      text-align: center;
+      font-size: 0.85rem;
+      font-weight: 700;
+      line-height: 1.3;
+      /* Identity transforms establish a stacking context before hover. */
+      translate: 0 0;
+      rotate: 0deg;
+      scale: 1;
+      --promo-travel: 24px;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 250ms ease;
+
+      @media (prefers-reduced-motion: reduce) {
+        --promo-travel: 4px;
+        animation-duration: 60s, 12s;
+      }
+    }
+
+    .target:hover {
+      scale: 1.12;
+    }
+
+    /* Each effect owns a property, so hover cannot replace either animation. */
+    @keyframes promo-spin {
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: calc(-1 * var(--promo-travel)) 0; }
+      to { translate: var(--promo-travel) 0; }
+    }
+
