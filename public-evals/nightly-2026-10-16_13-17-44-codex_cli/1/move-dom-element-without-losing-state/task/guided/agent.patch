+  <script>
+    const player = document.getElementById('roasting-player');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const exitTheater = document.getElementById('exit-theater');
+    let theaterMode = false;
+
+    function toggleTheaterMode() {
+      const nextMode = !theaterMode;
+      const destination = nextMode ? heroSlot : mainSlot;
+
+      // Keep both parents connected and visible during the atomic move.
+      heroSlot.hidden = false;
+      mainSlot.hidden = false;
+      if (typeof destination.moveBefore === 'function') {
+        // Unlike remove/insert, this preserves the iframe's browsing context.
+        destination.moveBefore(player, null);
+      } else {
+        // Older browsers still support theater mode, but may reload the player.
+        destination.insertBefore(player, null);
+      }
+
+      theaterMode = nextMode;
+      hero.classList.toggle('theater-active', theaterMode);
+      heroSlot.hidden = !theaterMode;
+      mainSlot.hidden = theaterMode;
+      theaterToggle.setAttribute('aria-pressed', String(theaterMode));
+      theaterToggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+      const activeControl = theaterMode ? exitTheater : theaterToggle;
+      activeControl.focus({ preventScroll: true });
+      (theaterMode ? heroSlot : mainSlot).scrollIntoView({ block: 'center' });
+    }
+
+    theaterToggle.hidden = false;
+    theaterToggle.addEventListener('click', toggleTheaterMode);
+    exitTheater.addEventListener('click', toggleTheaterMode);
+  </script>
