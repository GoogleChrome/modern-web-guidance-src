+  <script>
+    (function () {
+      const hero = document.querySelector('.hero');
+      const heroPlayer = document.getElementById('hero-player');
+      const heroSlot = document.getElementById('hero-video-slot');
+      const mainSlot = document.getElementById('main-video-slot');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.getElementById('theater-toggle');
+      const exit = document.getElementById('exit-theater');
+      let theater = false;
+      const atomicMove = typeof heroSlot.moveBefore === 'function';
+      let pendingFrame = 0;
+
+      // Legacy DOM insertion reloads iframes. Keep the player connected in its
+      // original parent and position it over the hero slot on those browsers.
+      function positionFallback() {
+        if (!theater || atomicMove) return;
+        const rect = heroSlot.getBoundingClientRect();
+        Object.assign(player.style, {
+          position: 'fixed',
+          top: rect.top + 'px',
+          left: rect.left + 'px',
+          width: rect.width + 'px',
+          height: rect.height + 'px',
+          right: 'auto',
+          bottom: 'auto',
+          zIndex: '10'
+        });
+      }
+
+      function schedulePosition() {
+        if (!theater || atomicMove || pendingFrame) return;
+        pendingFrame = requestAnimationFrame(function () {
+          pendingFrame = 0;
+          positionFallback();
+        });
+      }
+
+      function setTheater(enabled) {
+        theater = enabled;
+        hero.classList.toggle('is-theater', enabled);
+        heroPlayer.hidden = !enabled;
+        mainSlot.classList.toggle('is-away', enabled);
+
+        if (atomicMove) {
+          // Both parents stay connected. Never use appendChild/insertBefore
+          // here: removing and reinserting the player resets its iframe.
+          (enabled ? heroSlot : mainSlot).moveBefore(player, null);
+        }
+        if (!atomicMove) {
+          if (enabled) positionFallback();
+          else player.removeAttribute('style');
+        }
+
+        toggle.setAttribute('aria-pressed', String(enabled));
+        toggle.textContent = enabled ? 'Exit theater mode' : 'Theater mode';
+        (enabled ? hero : document.querySelector('.roasting')).scrollIntoView({ block: 'start' });
+        if (!atomicMove) positionFallback();
+        (enabled ? exit : toggle).focus({ preventScroll: true });
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', function () { setTheater(!theater); });
+      exit.addEventListener('click', function () { setTheater(false); });
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && theater) setTheater(false);
+      });
+      window.addEventListener('scroll', schedulePosition, { passive: true, capture: true });
+      window.addEventListener('resize', schedulePosition);
+      if (typeof ResizeObserver === 'function') {
+        new ResizeObserver(schedulePosition).observe(heroSlot);
+      }
+    }());
+  </script>
