+    @supports not (font-size-adjust:from-font){#mixed-fonts-container{line-height:1.8}#mixed-fonts-container code{font-size:.92em}#independent-theme-container{line-height:1.7}}
+    @media(min-width:1500px){main{padding-top:75px}.workbench{margin-top:45px}.preview,.theme-preview{min-height:300px}}
+    @media(max-width:750px){.wrap{padding:0 22px}header{height:76px}.nav{gap:16px}.edition{display:none}main{padding-top:35px}.hero-bottom{display:block}.native{margin-top:16px}.workbench{grid-template-columns:1fr;margin-top:25px}.editor{flex-wrap:wrap;gap:12px}.editor textarea{order:3}.reset{margin-left:auto}.card-head{padding:0 20px}h1{letter-spacing:-1.4px}footer{gap:20px}.footer-right{font-size:8px}}
+  </style>
+</head>
+<body>
+<div class="wrap">
+  <header>
+    <a class="brand" href="./" style="text-decoration:none;color:inherit" aria-label="Typeform home"><span class="brand-icon" aria-hidden="true">Tt</span>typeform<span style="color:#8f9d7e">.</span></a>
+    <nav class="nav" aria-label="Main navigation"><a class="active" href="#playground">Playground</a><a class="external" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener noreferrer">The CSS <span aria-hidden="true">↗</span></a><span class="edition">VOL. 001</span></nav>
+  </header>
+  <main id="playground">
+    <div class="eyebrow"><span class="dot"></span>A typography experiment</div>
+    <h1>Different fonts. Same rhythm.</h1>
+    <div class="hero-bottom"><p class="intro">Give every font a common ground. Explore how <code>font-size-adjust</code><br> brings a little harmony to mixed type and independent themes.</p><div class="native"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3 20 6v6c0 5-8 9-8 9s-8-4-8-9V6z"/><path d="m8 12 3 3 5-6"/></svg>Native CSS. Naturally balanced.</div></div>
+    <div class="workbench">
+      <section class="card" aria-labelledby="mixed-title">
+        <div class="card-head"><div class="title" id="mixed-title"><span class="number">01</span> Mixed fonts</div><span class="badge">AUTOMATIC</span></div>
+        <div class="preview"><div class="preview-label"><span>THE PREVIEW</span><span><i class="tiny-dot"></i>LIVE</span></div>
+          <p id="mixed-fonts-container">Good typography makes <code>hello, world</code> feel right at home.</p>
+          <div class="baseline" id="mixed-caption">Different families, a shared x-height.</div>
+        </div>
+        <div class="settings"><div class="setting-row"><div class="switch-label"><button class="toggle" id="normalize" type="button" role="switch" aria-checked="true" aria-label="Normalize font height"></button><span>Normalize font height</span></div><label><span class="sr-only" hidden>Inline code font</span><select id="code-font" aria-label="Inline code font"><option value="'DM Mono', monospace">DM Mono</option><option value="'Courier New', monospace">Courier New</option><option value="monospace">System Mono</option></select></label></div>
+          <div class="snippet"><span>.mixed-fonts {</span><br>&nbsp; <span class="property">font-size-adjust</span>: <span class="value" id="mixed-value">from-font</span>;<br>}<button class="copy" data-copy="mixed" aria-label="Copy mixed fonts CSS" title="Copy CSS">▢</button></div>
+        </div>
+      </section>
+      <section class="card" aria-labelledby="theme-title">
+        <div class="card-head"><div class="title" id="theme-title"><span class="number">02</span> Independent theme</div><span class="badge">EXPLICIT</span></div>
+        <div class="theme-preview"><div class="preview-label"><span>A WORLD OF ITS OWN</span><span id="theme-name">SAGE</span></div>
+          <div id="independent-theme-container"><div class="theme-kicker">THE SLOW JOURNAL</div><h2 class="theme-heading">A quieter kind of clarity.</h2><p class="theme-body">A different voice, with the same sense of balance.<br>Beautiful proportions, wherever type takes you.</p></div>
+          <div class="theme-footer"><span>Its own font. Its own proportions.</span><div class="swatches" role="group" aria-label="Theme color"><button class="swatch" style="--swatch:#c9d4b8" aria-label="Sage theme" aria-pressed="true" data-theme="sage"></button><button class="swatch" style="--swatch:#dec5b4" aria-label="Clay theme" aria-pressed="false" data-theme="clay"></button><button class="swatch" style="--swatch:#c3cad9" aria-label="Mist theme" aria-pressed="false" data-theme="mist"></button></div></div>
+        </div>
+        <div class="settings"><div class="setting-row"><label for="aspect">Font aspect ratio</label><div class="ratio"><input id="aspect" type="range" min="0.35" max="0.7" value="0.5" step="0.01"><output for="aspect" id="aspect-output">0.50</output></div></div><div class="snippet"><span>.independent-theme {</span><br>&nbsp; <span class="property">font-size-adjust</span>: <span class="value" id="theme-value">0.5</span>;<br>}<button class="copy" data-copy="theme" aria-label="Copy independent theme CSS" title="Copy CSS">▢</button></div></div>
+      </section>
+    </div>
+    <div class="editor"><label class="editor-label" for="sample">Make it your own<span>Wrap inline code in backticks.</span></label><textarea id="sample" rows="1" spellcheck="false">Good typography makes `hello, world` feel right at home.</textarea><button class="reset" id="reset"><span aria-hidden="true">↺</span> Reset</button></div>
+    <div class="note"><span class="note-icon" aria-hidden="true">i</span><p><strong>A small property. A noticeable difference.</strong><br><code>from-font</code> reads the primary font’s x-height automatically. A numeric value sets an independent ratio.<br>Both keep your type feeling consistent, even when the font family changes.</p></div>
+    <div id="toast" role="status" aria-live="polite"></div>
+  </main>
+  <footer><span>A little playground for better typography.</span><span class="footer-right"><span class="dot"></span>MADE WITH CURIOSITY & CSS</span></footer>
+</div>
+<script>
+  const $ = (id) => document.getElementById(id);
+  const mixed = $('mixed-fonts-container');
+  const theme = $('independent-theme-container');
+  const original = $('sample').value;
+  let normalized = true;
+  let codeFont = $('code-font').value;
+  function renderSample(){
+    const pieces = $('sample').value.split(/(`[^`]+`)/g);
+    mixed.replaceChildren(...pieces.map(piece => {
+      if(piece.startsWith('`') && piece.endsWith('`')){
+        const code = document.createElement('code');
+        code.textContent = piece.slice(1,-1);
+        code.style.fontFamily = codeFont;
+        return code;
+      }
+      return document.createTextNode(piece);
+    }));
+  }
+  $('sample').addEventListener('input', renderSample);
+  $('code-font').addEventListener('change',event=>{codeFont=event.target.value;renderSample()});
+  function setNormalized(value){
+    normalized=value;
+    $('normalize').setAttribute('aria-checked',String(value));
+    mixed.style.fontSizeAdjust=value?'from-font':'none';
+    $('mixed-value').textContent=value?'from-font':'none';
+    $('mixed-caption').textContent=value?'Different families, a shared x-height.':'Natural font sizes, without normalization.';
+  }
+  $('normalize').addEventListener('click',()=>setNormalized(!normalized));
+  function setRatio(value){
+    theme.style.fontSizeAdjust=value;
+    $('aspect-output').value=Number(value).toFixed(2);
+    $('theme-value').textContent=String(Number(value));
+  }
+  $('aspect').addEventListener('input',event=>setRatio(event.target.value));
+  const themes={sage:['#e9eddf','#3e5036'],clay:['#f0e2d7','#624a3d'],mist:['#e4e8f0','#414f65']};
+  function setTheme(name){
+    theme.style.background=themes[name][0];theme.style.color=themes[name][1];
+    $('theme-name').textContent=name.toUpperCase();
+    document.querySelectorAll('[data-theme]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.theme===name)));
+  }
+  document.querySelectorAll('[data-theme]').forEach(button=>button.addEventListener('click',()=>setTheme(button.dataset.theme)));
+  $('reset').addEventListener('click',()=>{
+    $('sample').value=original;$('code-font').selectedIndex=0;codeFont=$('code-font').value;
+    renderSample();setNormalized(true);$('aspect').value='0.5';setRatio('0.5');setTheme('sage');
+    $('toast').textContent='Playground reset.';
+  });
+  document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{
+    const isMixed=button.dataset.copy==='mixed';
+    const css=`#${isMixed?'mixed-fonts-container':'independent-theme-container'} {\n  font-size-adjust: ${isMixed?(normalized?'from-font':'none'):Number($('aspect').value)};\n}`;
+    try{await navigator.clipboard.writeText(css);$('toast').textContent='CSS copied to clipboard.'}
+    catch{$('toast').textContent='Clipboard unavailable. Select and copy the CSS above.'}
+  }));
+</script>
+</body>
+</html>
