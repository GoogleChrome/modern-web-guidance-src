+    .theme-preview{padding:17px 24px 20px;min-height:278px}#independent-theme-container{font-size-adjust:0.5;font-family:'Lora',Georgia,serif;background:#e9eddf;border:1px solid #dce2d0;border-radius:8px;margin-top:16px;padding:24px 23px 21px;color:#3e5036;transition:background .2s,color .2s}.theme-kicker{font-family:var(--mono);font-size:8px;letter-spacing:1.5px;opacity:.65}.theme-heading{font-size:28px;line-height:1.25;letter-spacing:-1px;margin:12px 0}.theme-body{font-size:12px;line-height:1.8;opacity:.8;margin:0;max-width:300px}.theme-footer{display:flex;align-items:center;justify-content:space-between;margin-top:13px;font-size:9px;color:#8a927d}.swatches{display:flex;gap:6px}.swatch{border:2px solid transparent;width:15px;height:15px;border-radius:50%;background:var(--swatch);padding:0}.swatch[aria-pressed=true]{outline:1px solid #7a886b;outline-offset:2px}.ratio{display:flex;gap:8px;align-items:center}.ratio input{accent-color:#47633c;width:72px;height:3px;cursor:pointer}.ratio output{font-family:var(--mono);font-size:10px;min-width:25px;color:#536a47}
