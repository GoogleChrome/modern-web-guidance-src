x}.code-label{font-size:8px;letter-spacing:1px;color:#aaa3b3;margin-bottom:12px}.copy{position:absolute;right:20px;top:17px;border:0;background:none;color:#aaa3b3;font-size:11px;display:flex;gap:5px}.code-block pre{font:11px/1.9 'IBM Plex Mono',monospace;color:#817a8e;margin:0;white-space:pre-wrap}.selector{color:#6d5691}.property{color:#817a8e}.value{color:#ba8260}.card-footer{display:flex;align-items:center;justify-content:space-between;padding:15px 23px;border-top:1px solid #eeedf2;font-size:10px;color:#8a8495}.switch{display:flex;align-items:center;gap:8px;cursor:pointer}.switch input{position:absolute;opacity:0;width:1px}.track{width:27px;height:16px;border-radius:20px;background:#c9c5d1;position:relative;transition:background .2s}.track:after{content:'';position:absolute;top:3px;left:3px;width:10px;height:10px;background:white;border-radius:50%;transition:transform .2s}.switch input:checked+.track{background:var(--purple)}.switch input:checked+.track:after{transform:translateX(11px)}.switch input:focus-visible+.track{outline:3px solid #baa8ed;outline-offset:3px}.foot-value{font:9px 'IBM Plex Mono',monospace;color:#a29aaa}.info{display:flex;align-items:flex-start;gap:12px;border:1px solid #e7e3ef;border-radius:9px;background:#f4f1fa;padding:18px 20px;margin-top:25px}.info-icon{width:16px;height:16px;border:1px solid #b4a4cf;border-radius:50%;color:#9079b0;display:grid;place-items:center;font:11px Georgia,serif;flex-shrink:0}.info h3{font-size:11px;font-weight:600;margin:1px 0 6px;color:#635776}.info p{font-size:11px;color:#958a9f;line-height:1.7;margin:0}.info code{font-size:10px;color:#7c649b}.info a{color:#80609f;white-space:nowrap;margin-left:auto;font-size:10px;padding-top:2px}footer{display:flex;justify-content:space-between;margin-top:30px;padding-top:21px;border-top:1px solid var(--border);color:#aaa5b1;font-size:10px}.footer-right{display:flex;align-items:center;gap:6px}.status-dot{height:5px;width:5px;border-radius:50%;background:#89ad99}.full-code{margin:0;padding:24px;min-height:256px;background:#fafafd;font:11px/1.9 'IBM Plex Mono',monospace;white-space:pre-wrap;color:#746285}.hidden{display:none!important}@media(min-width:1450px){main{padding-top:65px}}@media(max-width:850px){header{padding:0 25px}nav{gap:20px}.hero-glyph{display:none}.tools-left{gap:13px}.control{gap:8px}.toolbar{flex-wrap:wrap}.grid{gap:16px}.card-top{padding:20px 17px;gap:8px}.pill{font-size:8px}.preview{padding:17px}.sample{padding:20px 17px;min-height:210px}.card-footer{padding:15px 17px}}@media(max-width:650px){header{height:70px}.brand{font-size:20px}nav{gap:18px;font-size:11px}nav a:last-of-type,.version{display:none}main{padding:35px 18px 22px}h1{font-size:35px;max-width:340px}.intro{font-size:13px}.tools-left{flex-wrap:wrap;gap:16px}.toolbar{padding:15px;gap:10px}.control{flex-wrap:wrap}.divider{display:none}.control select{max-width:145px}.grid{grid-template-columns:1fr;gap:22px}.sample{min-height:185px}.info{flex-wrap:wrap}.info>div{flex:1}.info a{margin-left:28px}.card-top{padding:21px}.pill{font-size:9px}footer{gap:15px;font-size:9px}}
+</style>
+</head>
+<body>
+<header><a class="brand" href="./" aria-label="Type Lab home"><span class="brand-icon">Tt</span>type<span>/</span>lab</a><nav aria-label="Main navigation"><a class="active" href="./" aria-current="page">Playground</a><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Documentation <span class="external">↗</span></a><span class="version">v.01</span></nav></header>
+<main>
+<section class="hero"><div class="eyebrow">Small details. Better typography.</div><h1>A little harmony for your type.</h1><p class="intro">Different fonts, same visual rhythm. Explore how modern CSS brings balance<br class="desktop-break"> to mixed typefaces, and gives independent themes a consistent voice.</p><div class="hero-glyph" aria-hidden="true">A<span>a</span></div></section>
+<section class="toolbar" aria-label="Typography controls"><div class="tools-left"><div class="control select-wrap"><label for="font-family">Base font</label><select id="font-family"><option value="'DM Sans', sans-serif">DM Sans</option><option value="Arial, sans-serif">Arial</option><option value="Verdana, sans-serif">Verdana</option><option value="Georgia, serif">Georgia</option></select></div><span class="divider"></span><div class="control"><label for="font-size">Font size</label><input id="font-size" type="range" min="18" max="30" value="24"><output id="size-output" for="font-size">24 px</output></div></div><button class="reset" id="reset"><span aria-hidden="true">↺</span> Reset playground</button></section>
+<div class="grid">
+<section class="card" aria-labelledby="mixed-title"><div class="card-top"><div class="card-symbol" aria-hidden="true">Aa</div><div><h2 id="mixed-title">Mixed fonts, in sync.</h2><p class="subtitle">One paragraph. A shared visual height.</p></div><span class="pill">from-font</span></div><div class="tabs" role="tablist" aria-label="Mixed font views"><button class="tab selected" role="tab" aria-selected="true" aria-controls="mixed-preview" id="mixed-preview-tab" data-panel="mixed-preview">Preview</button><button class="tab" role="tab" aria-selected="false" aria-controls="mixed-source" id="mixed-source-tab" data-panel="mixed-source" tabindex="-1">HTML & CSS</button><span class="live">Live preview</span></div>
+<div id="mixed-preview" role="tabpanel" aria-labelledby="mixed-preview-tab"><div class="preview"><div class="sample"><div class="sample-label">The everyday paragraph</div><p id="mixed-fonts-container">Good design is in the details.<br>Even a little <code>inline code</code><br>should feel right at home.</p></div><p class="preview-note"><span class="check">✓</span> Automatically balanced to the base font’s x-height</p></div></div><pre id="mixed-source" class="full-code hidden" role="tabpanel" aria-labelledby="mixed-source-tab">&lt;p id="mixed-fonts-container"&gt;
+  Good design is in the details.
+  Even a little &lt;code&gt;inline code&lt;/code&gt;
+  should feel right at home.
+&lt;/p&gt;
+
+#mixed-fonts-container {
+  font-family: 'DM Sans', sans-serif;
+  font-size-adjust: from-font;
+}
+#mixed-fonts-container code {
+  font-family: 'IBM Plex Mono', monospace;
+}</pre>
+<div class="code-block"><div class="code-label">THE MAGIC LINE</div><button class="copy" data-copy="mixed" aria-label="Copy mixed font CSS">▢ <span>Copy</span></button><pre><span class="selector">#mixed-fonts-container</span> {
+  <span class="property">font-size-adjust</span>: <span class="value">from-font</span>;
+}</pre></div><div class="card-footer"><label class="switch"><input id="normalize" type="checkbox" checked><span class="track"></span>Normalize font height</label><span class="foot-value" id="mixed-value">auto / from-font</span></div></section>
+<section class="card" aria-labelledby="theme-title"><div class="card-top"><div class="card-symbol dark" aria-hidden="true">◈</div><div><h2 id="theme-title">A theme of its own.</h2><p class="subtitle">Independent style. Intentional proportions.</p></div><span class="pill neutral">0.5</span></div><div class="tabs" role="tablist" aria-label="Theme views"><button class="tab selected" role="tab" aria-selected="true" aria-controls="theme-preview" id="theme-preview-tab" data-panel="theme-preview">Preview</button><button class="tab" role="tab" aria-selected="false" aria-controls="theme-source" id="theme-source-tab" data-panel="theme-source" tabindex="-1">HTML & CSS</button><span class="live">Live preview</span></div>
+<div id="theme-preview" role="tabpanel" aria-labelledby="theme-preview-tab"><div class="preview"><div id="independent-theme-container" class="sample"><div class="sample-label">The independent theme</div><p>A different look.<br>The same attention to <code>detail</code>.<br>Beautifully in proportion.</p></div><p class="preview-note"><span class="check">✓</span> A fixed aspect value, independent of the base font</p></div></div><pre id="theme-source" class="full-code hidden" role="tabpanel" aria-labelledby="theme-source-tab">&lt;div id="independent-theme-container"&gt;
+  A different look.
+  The same attention to &lt;code&gt;detail&lt;/code&gt;.
+  Beautifully in proportion.
+&lt;/div&gt;
+
+#independent-theme-container {
+  font-family: Georgia, serif;
+  font-size-adjust: 0.5;
+}
+#independent-theme-container code {
+  font-family: 'IBM Plex Mono', monospace;
+}</pre>
+<div class="code-block"><div class="code-label">THE MAGIC LINE</div><button class="copy" data-copy="theme" aria-label="Copy independent theme CSS">▢ <span>Copy</span></button><pre><span class="selector">#independent-theme-container</span> {
+  <span class="property">font-size-adjust</span>: <span class="value">0.5</span>;
+}</pre></div><div class="card-footer"><label class="switch"><input id="lock-theme" type="checkbox" checked><span class="track"></span>Lock aspect value</label><span class="foot-value" id="theme-value">fixed / 0.5</span></div></section>
+</div>
+<aside class="info"><span class="info-icon" aria-hidden="true">i</span><div><h3>Same size doesn’t always look the same.</h3><p>Fonts have different x-heights. <code>font-size-adjust</code> keeps their perceived size consistent, so your text feels cohesive—even when the typefaces change.</p></div><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Meet the property <span class="external">↗</span></a></aside>
+<footer><span>A small experiment in better web typography.</span><span class="footer-right"><span class="status-dot"></span><span id="support-status">Made for the modern web</span></span></footer>
+</main>
+<script>
+const mixed=document.getElementById('mixed-fonts-container');
+const theme=document.getElementById('independent-theme-container');
+const family=document.getElementById('font-family');
+const size=document.getElementById('font-size');
+const normalize=document.getElementById('normalize');
+const lock=document.getElementById('lock-theme');
+function update(){mixed.style.fontFamily=family.value;document.documentElement.style.setProperty('--sample-size',size.value+'px');document.getElementById('size-output').value=size.value+' px';mixed.style.fontSizeAdjust=normalize.checked?'from-font':'none';theme.style.fontSizeAdjust=lock.checked?'0.5':'none';document.getElementById('mixed-value').textContent=normalize.checked?'auto / from-font':'none';document.getElementById('theme-value').textContent=lock.checked?'fixed / 0.5':'none';}
+[family,size,normalize,lock].forEach(control=>control.addEventListener('input',update));
+document.getElementById('reset').addEventListener('click',()=>{family.selectedIndex=0;size.value=24;normalize.checked=true;lock.checked=true;update();document.querySelectorAll('.tabs').forEach(tabs=>tabs.querySelector('.tab').click());});
+document.querySelectorAll('.tab').forEach(tab=>{tab.addEventListener('click',()=>{const card=tab.closest('.card');card.querySelectorAll('.tab').forEach(item=>{const active=item===tab;item.classList.toggle('selected',active);item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;document.getElementById(item.dataset.panel).classList.toggle('hidden',!active);});});tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();const tabs=[...tab.parentElement.querySelectorAll('.tab')];const next=event.key==='Home'?tabs[0]:event.key==='End'?tabs.at(-1):tabs.find(item=>item!==tab);next.click();next.focus();}});});
+document.querySelectorAll('.copy').forEach(button=>button.addEventListener('click',async()=>{const isMixed=button.dataset.copy==='mixed';const text=isMixed?'#mixed-fonts-container {\n  font-size-adjust: from-font;\n}':'#independent-theme-container {\n  font-size-adjust: 0.5;\n}';const label=button.querySelector('span');try{await navigator.clipboard.writeText(text);label.textContent='Copied!';}catch{label.textContent='Copy unavailable';}setTimeout(()=>label.textContent='Copy',2000);}));
+if(!CSS.supports('font-size-adjust','from-font'))document.getElementById('support-status').textContent='Your browser may not support automatic adjustment';
+</script>
+</body>
+</html>
