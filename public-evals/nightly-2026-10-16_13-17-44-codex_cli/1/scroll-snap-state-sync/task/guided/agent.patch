+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+
+    function setActiveSection(section) {
+      links.forEach(link => {
+        if (link.hash === `#${section.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncNearestSection() {
+      const snapTop = panel.getBoundingClientRect().top + panel.clientTop + 24;
+      const nearest = sections.reduce((closest, section) => {
+        const distance = Math.abs(section.querySelector('header').getBoundingClientRect().top - snapTop);
+        return distance < closest.distance ? { section, distance } : closest;
+      }, { section: sections[0], distance: Infinity });
+      setActiveSection(nearest.section);
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        // Preserve native behavior for modified clicks and opening links in a new tab.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = sections.find(section => `#${section.id}` === link.hash);
+        panel.scrollTo({
+          top: section.offsetTop,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) setActiveSection(section);
+      });
+    } else {
+      const observer = new IntersectionObserver(syncNearestSection, {
+        root: panel,
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+    syncNearestSection();
+  </script>
