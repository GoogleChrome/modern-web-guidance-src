+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function sectionTop(section) {
+      return section.getBoundingClientRect().top - panel.getBoundingClientRect().top
+        - panel.clientTop + panel.scrollTop;
+    }
+
+    function updateCurrentSection() {
+      const closest = sections.reduce((current, section) =>
+        Math.abs(sectionTop(section) - panel.scrollTop)
+          < Math.abs(sectionTop(current) - panel.scrollTop) ? section : current
+      );
+      tocLinks.forEach(link => {
+        if (link.hash === '#' + closest.id) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    let scrollFrame;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame) return;
+      scrollFrame = requestAnimationFrame(() => {
+        scrollFrame = null;
+        updateCurrentSection();
+      });
+    }, { passive: true });
+    panel.addEventListener('scrollend', updateCurrentSection);
+
+    tocLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = sections.find(section => '#' + section.id === link.hash);
+        section.querySelector('h3').focus({ preventScroll: true });
+        panel.scrollTo({
+          top: sectionTop(section),
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    new ResizeObserver(updateCurrentSection).observe(panel);
+    updateCurrentSection();
+  </script>
