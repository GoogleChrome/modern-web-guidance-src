diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..d27cb4d
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,229 @@
+/* Later layers win without increasing selector specificity. */
+@layer reset, tokens, base, layout, components;
+
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    /* Palette and semantic colors */
+    --color-coffee-900: #3e2723;
+    --color-coffee-800: #4e342e;
+    --color-coffee-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-neutral-50: #fafafa;
+    --color-text: var(--color-coffee-900);
+    --color-text-inverse: var(--color-white);
+    --color-brand: var(--color-coffee-800);
+    --color-accent: var(--color-amber-400);
+    --color-page: var(--color-neutral-50);
+    --color-surface: var(--color-white);
+    --color-footer: var(--color-coffee-200);
+    --color-button-hover: var(--color-coffee-900);
+
+    /* Typography */
+    --font-family-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-brand: 1.5rem;
+    --font-size-hero: 3rem;
+    --font-weight-bold: 700;
+    --line-height-body: 1.6;
+    --letter-spacing-brand: 1px;
+
+    /* Spacing, shape, and layout */
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --border-width: 1px;
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --nav-gutter: 5%;
+    --hero-height: 60vh;
+    --layer-sticky: 10;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --hero-overlay: rgb(0 0 0 / 50%);
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    --duration-interaction: 0.3s;
+    --ease-interaction: ease;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :root {
+      --duration-interaction: 0s;
+    }
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-family-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a):focus-visible {
+    outline: 2px solid currentColor;
+    outline-offset: var(--space-1);
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--space-6);
+  }
+}
+
+@layer components {
+  /* Nest descendants and states inside their owning component. */
+  .site-nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-5) var(--space-6);
+    padding-block: var(--space-5);
+    padding-inline: var(--nav-gutter);
+    color: var(--color-text-inverse);
+    background: var(--color-brand);
+
+    & .site-nav__brand {
+      font-size: var(--font-size-brand);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: var(--letter-spacing-brand);
+    }
+
+    & .site-nav__links {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-2) var(--space-6);
+      list-style: none;
+    }
+
+    & :where(a) {
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction) var(--ease-interaction);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+    }
+
+    & .site-nav__logout {
+      display: inline-block;
+      border: var(--border-width) solid var(--color-accent);
+      padding: var(--space-1) var(--space-3);
+      border-radius: var(--radius-small);
+    }
+  }
+
+  .hero {
+    min-block-size: var(--hero-height);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    padding: var(--space-7) var(--space-6);
+    color: var(--color-text-inverse);
+    text-align: center;
+    background-image: linear-gradient(var(--hero-overlay), var(--hero-overlay)), var(--hero-image);
+    background-size: cover;
+    background-position: center;
+
+    & .hero__title {
+      font-size: clamp(2rem, 6vw, var(--font-size-hero));
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .favorites {
+    & .favorites__title {
+      text-align: center;
+    }
+
+    & .favorites__grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+      gap: var(--space-6);
+      margin-block-start: var(--space-6);
+    }
+  }
+
+  .coffee-card {
+    padding: var(--space-6);
+    border-radius: var(--radius-card);
+    background: var(--color-surface);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & .coffee-card__title {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  /* Shared component: independent of its placement in a hero or card. */
+  .button {
+    display: inline-block;
+    margin-block-start: var(--space-4);
+    padding: var(--space-2) var(--space-6);
+    border-radius: var(--radius-button);
+    background: var(--color-brand);
+    color: var(--color-text-inverse);
+    text-decoration: none;
+    transition: background-color var(--duration-interaction) var(--ease-interaction);
+
+    &:is(:hover, :focus-visible) {
+      background-color: var(--color-button-hover);
+    }
+  }
+
+  .site-footer {
+    margin-block-start: var(--space-7);
+    padding: var(--space-7) var(--space-6);
+    background: var(--color-footer);
+    text-align: center;
+
+    & .site-footer__links {
+      margin-block-end: var(--space-6);
+    }
+
+    & :where(a) {
+      display: inline-block;
+      margin-inline: var(--space-2);
+      color: var(--color-text);
+      text-decoration: none;
+      font-size: var(--font-size-small);
+
+      &:hover {
+        text-decoration: underline;
+      }
+    }
+  }
+}
