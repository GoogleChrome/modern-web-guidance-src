new file mode 100644
index 0000000..b34329f
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,227 @@
+/* Later layers take precedence without increasing selector specificity. */
+@layer tokens, base, layout, components, utilities;
+
+@layer tokens {
+  :root {
+    /* Palette primitives. */
+    --color-coffee-900: #3e2723;
+    --color-coffee-800: #4e342e;
+    --color-coffee-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-gray-50: #fafafa;
+
+    /* Semantic roles let the palette evolve independently of components. */
+    --color-brand: var(--color-coffee-800);
+    --color-brand-hover: var(--color-coffee-900);
+    --color-accent: var(--color-amber-400);
+    --color-text: var(--color-coffee-900);
+    --color-on-brand: var(--color-white);
+    --color-page: var(--color-gray-50);
+    --color-surface: var(--color-white);
+    --color-surface-muted: var(--color-coffee-200);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-brand: 1.5rem;
+    --font-size-hero: clamp(2rem, 5vw, 3rem);
+    --line-height-body: 1.6;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --duration-interaction: 300ms;
+    --layer-sticky: 10;
+  }
+}
+
+@layer base {
+  /* Inherit sizing so an embedded component can choose its own box model. */
+  html {
+    box-sizing: border-box;
+  }
+
+  :where(body, nav, header, main, section, footer, div, ul, li, a, h1, h2, h3, p) {
+    box-sizing: inherit;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+  }
+
+  body {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a):focus-visible {
+    outline: 2px solid currentColor;
+    outline-offset: 4px;
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--space-6);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  .site-nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-5) var(--space-6);
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    padding-block: var(--space-5);
+    padding-inline: 5%;
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+
+    & > :where(ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-2) var(--space-6);
+      padding: 0;
+      list-style: none;
+    }
+
+    & > :where(ul) > :where(li) > :where(a) {
+      display: inline-block;
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:where(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+    }
+  }
+
+  .logo {
+    font-size: var(--font-size-brand);
+    font-weight: bold;
+    letter-spacing: 0.0625rem;
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-accent);
+    padding-block: var(--space-1);
+    padding-inline: var(--space-3);
+    border-radius: var(--radius-small);
+  }
+
+  .hero {
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-block-size: 60vh;
+    padding: var(--space-7) var(--space-6);
+    color: var(--color-on-brand);
+    background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)), var(--hero-image) center / cover;
+    text-align: center;
+
+    & > :where(h1) {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .section-heading {
+    text-align: center;
+  }
+
+  .card {
+    padding: var(--space-6);
+    background: var(--color-surface);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & > :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  .btn {
+    /* Override these locally for a button variant without selector escalation. */
+    --button-bg: var(--color-brand);
+    --button-bg-hover: var(--color-brand-hover);
+    --button-color: var(--color-on-brand);
+    display: inline-block;
+    margin-block-start: var(--space-4);
+    padding: var(--space-2) var(--space-6);
+    color: var(--button-color);
+    background: var(--button-bg);
+    border-radius: var(--radius-button);
+    text-decoration: none;
+    transition: background-color var(--duration-interaction);
+
+    &:where(:hover, :focus-visible) {
+      background-color: var(--button-bg-hover);
+    }
+  }
+
+  .site-footer {
+    margin-block-start: var(--space-7);
+    padding: var(--space-7) var(--space-6);
+    background: var(--color-surface-muted);
+    text-align: center;
+  }
+
+  .footer-links {
+    margin-block-end: var(--space-6);
+
+    & > :where(a) {
+      display: inline-block;
+      margin-inline: var(--space-2);
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-small);
+
+      &:where(:hover, :focus-visible) {
+        text-decoration: underline;
+      }
+    }
+  }
+}
+
+@layer utilities {
+  @media (prefers-reduced-motion: reduce) {
+    :where(.btn, .site-nav > ul > li > a) {
+      transition: none;
+    }
+  }
+}
