+
+    .promo-button:hover {
+      background: #ffbc66;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* The browser derives concentric curves from the radius and padding. */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
+    @media (max-width: 640px) {
+      .showcase-grid {
+        grid-template-columns: minmax(0, 1fr);
+      }
+    }
