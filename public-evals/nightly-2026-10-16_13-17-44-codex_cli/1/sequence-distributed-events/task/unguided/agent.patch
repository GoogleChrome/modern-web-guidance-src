+  <script>
+    const orders = [];
+    let completed = 0;
+    let pending = 0;
+    const formatNs = value => BigInt(value).toLocaleString('en-US');
+    document.getElementById('simulate-order').addEventListener('click', async () => {
+      const status = document.getElementById('telemetry-status');
+      pending++;
+      status.textContent = `Sequencing ${pending} pending order${pending === 1 ? '' : 's'}…`;
+      try {
+        const response = await fetch('/api/orders', { method: 'POST' });
+        if (!response.ok) throw new Error('Order service unavailable');
+        const trace = await response.json();
+        console.log('Coffee order telemetry', trace);
+        completed++;
+        orders.push(trace);
+        orders.sort((a, b) => a.sequence - b.sequence);
+        if (orders.length > 100) orders.splice(0, orders.length - 100);
+        const latest = orders[orders.length - 1];
+        document.getElementById('order-count').textContent = completed;
+        document.getElementById('latest-order').textContent = latest.orderId;
+        document.getElementById('click-delta').textContent = latest.deltaNs === null ? 'First order' : `${formatNs(latest.deltaNs)} ns`;
+        const events = orders.flatMap(order => order.events.map(event => ({ ...event, order })));
+        events.sort((a, b) => BigInt(a.timestampNs) < BigInt(b.timestampNs) ? -1 : BigInt(a.timestampNs) > BigInt(b.timestampNs) ? 1 : a.order.sequence - b.order.sequence);
+        const body = document.getElementById('trace-body');
+        body.replaceChildren(...events.map(event => {
+          const row = document.createElement('tr');
+          [event.order.orderId, event.operation, event.timestampNs, event.operation === 'gateway.received' ? (event.order.deltaNs === null ? '—' : formatNs(event.order.deltaNs)) : '—'].forEach(value => {
+            const cell = document.createElement('td');
+            cell.textContent = value;
+            row.appendChild(cell);
+          });
+          return row;
+        }));
+        const scroll = document.querySelector('.trace-scroll');
+        scroll.scrollTop = scroll.scrollHeight;
+        status.textContent = `${trace.orderId} queued. Three operations recorded.`;
+      } catch (error) {
+        status.textContent = 'Could not record this order. Please try again.';
+        console.error('Coffee order telemetry failed', error);
+      } finally {
+        pending--;
+        if (pending > 0) status.textContent += ` ${pending} still pending.`;
+      }
+    });
+  </script>
