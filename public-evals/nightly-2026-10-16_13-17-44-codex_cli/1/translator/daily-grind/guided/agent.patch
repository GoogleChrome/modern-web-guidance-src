diff --git a/translation.mjs b/translation.mjs
new file mode 100644
index 0000000..8034054
--- /dev/null
+++ b/translation.mjs
@@ -0,0 +1,75 @@
+// MyMemory limits each request to 500 UTF-8 bytes. Keep a little headroom.
+export function splitText(text) {
+  const chunks = [];
+  let chunk = '';
+  const encoder = new TextEncoder();
+  for (const token of text.match(/\S+\s*|\s+/gu) ?? []) {
+    for (const character of token) {
+      if (encoder.encode(chunk + character).length > 450) {
+        const boundary = chunk.search(/\s+\S*$/u);
+        if (boundary > 0) {
+          chunks.push(chunk.slice(0, boundary));
+          chunk = chunk.slice(boundary);
+        } else {
+          chunks.push(chunk);
+          chunk = '';
+        }
+        if (encoder.encode(chunk + character).length > 450) {
+          chunks.push(chunk);
+          chunk = '';
+        }
+      }
+      chunk += character;
+    }
+  }
+  if (chunk) chunks.push(chunk);
+  return chunks;
+}
+
+export async function translateText(text, sourceLanguage, targetLanguage, {
+  signal, fetcher = globalThis.fetch, native = globalThis.Translator,
+} = {}) {
+  if (!text.trim()) throw new Error('Enter some text to translate.');
+  if (text.length > 1000) throw new Error('Please use 1,000 characters or fewer.');
+  signal?.throwIfAborted();
+  if (sourceLanguage === targetLanguage) return { text, provider: 'Same language — original text shown.' };
+  const options = { sourceLanguage, targetLanguage };
+  if (native) {
+    let translator;
+    try {
+      // Only use ready models, so translation never triggers a large download.
+      if (await native.availability(options) === 'available') {
+        translator = await native.create({ ...options, monitor() {} });
+        signal?.throwIfAborted();
+        const result = await translator.translate(text, { signal });
+        signal?.throwIfAborted();
+        if (result?.trim()) return { text: result, provider: 'Translated on your device.' };
+      }
+    } catch (error) {
+      if (signal?.aborted) throw error;
+      // A browser policy or model failure should not prevent online translation.
+    } finally {
+      translator?.destroy();
+    }
+  }
+  signal?.throwIfAborted();
+  const translated = [];
+  for (const chunk of splitText(text)) {
+    signal?.throwIfAborted();
+    const content = chunk.trim();
+    if (!content) { translated.push(chunk); continue; }
+    const url = new URL('https://api.mymemory.translated.net/get');
+    url.search = new URLSearchParams({ q: content, langpair: `${sourceLanguage}|${targetLanguage}` });
+    const response = await fetcher(url, { signal, credentials: 'omit', referrerPolicy: 'no-referrer' });
+    if (!response.ok) throw new Error('The translation service is unavailable. Please try again later.');
+    const data = await response.json();
+    if (data.quotaFinished || Number(data.responseStatus) === 429) {
+      throw new Error('The online translation limit has been reached. Please try again later.');
+    }
+    if (Number(data.responseStatus) !== 200 || typeof data.responseData?.translatedText !== 'string' || !data.responseData.translatedText.trim()) {
+      throw new Error('Translation is unavailable for this language pair. Please try another language or try again later.');
+    }
+    translated.push((chunk.match(/^\s*/u)?.[0] ?? '') + data.responseData.translatedText + (chunk.match(/\s*$/u)?.[0] ?? ''));
+  }
+  return { text: translated.join(''), provider: 'Translated with MyMemory.' };
+}
diff --git a/translation.test.mjs b/translation.test.mjs
new file mode 100644
index 0000000..c22385b
--- /dev/null
+++ b/translation.test.mjs
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { splitText, translateText } from './translation.mjs';
+
+test('chunks preserve Unicode text and respect the service byte limit', () => {
+  for (const text of ['hello world '.repeat(80), '日本語☕🙂'.repeat(100), 'x '.repeat(400), 'a ' + '界'.repeat(200), '  Hello\n\nworld  ']) {
+    const chunks = splitText(text);
+    assert.equal(chunks.join(''), text);
+    assert.ok(chunks.every(chunk => new TextEncoder().encode(chunk).length <= 450));
+  }
+});
+
+test('blank input is rejected; identical languages avoid network calls', async () => {
+  await assert.rejects(translateText('  ', 'en', 'es'), /Enter some text/);
+  const result = await translateText('Hello', 'en', 'en', { fetcher: () => assert.fail('unexpected network request') });
+  assert.equal(result.text, 'Hello');
+});
+
+test('ready native translation uses matching language options and releases the model', async () => {
+  let destroyed = false;
+  const native = {
+    availability: async options => { assert.deepEqual(options, { sourceLanguage: 'en', targetLanguage: 'es' }); return 'available'; },
+    create: async options => {
+      assert.equal(options.targetLanguage, 'es');
+      return { translate: async () => 'Hola', destroy: () => { destroyed = true; } };
+    },
+  };
+  assert.equal((await translateText('Hello', 'en', 'es', { native })).text, 'Hola');
+  assert.equal(destroyed, true);
+});
+
+test('unavailable native model uses the online service with encoded language pair', async () => {
+  const result = await translateText(' Hello & coffee? ', 'en', 'es', {
+    native: { availability: async () => 'downloadable', create: () => assert.fail('must not download') },
+    fetcher: async (url, options) => {
+      assert.equal(url.searchParams.get('q'), 'Hello & coffee?');
+      assert.equal(url.searchParams.get('langpair'), 'en|es');
+      assert.equal(options.credentials, 'omit');
+      return { ok: true, json: async () => ({ responseStatus: 200, responseData: { translatedText: 'Hola y café?' } }) };
+    },
+  });
+  assert.equal(result.text, ' Hola y café? ');
+});
+
+test('quota, HTTP, and malformed service responses produce usable errors', async () => {
+  for (const [response, message] of [
+    [{ ok: false }, /unavailable/],
+    [{ ok: true, json: async () => ({ quotaFinished: true }) }, /limit/],
+    [{ ok: true, json: async () => ({ responseStatus: 403 }) }, /language pair/],
+  ]) {
+    await assert.rejects(translateText('Hello', 'en', 'es', { native: null, fetcher: async () => response }), message);
+  }
+});
+
+test('canceled requests never call the translation service', async () => {
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(translateText('Hello', 'en', 'es', { signal: controller.signal, fetcher: () => assert.fail('unexpected fetch') }), { name: 'AbortError' });
+});
diff --git a/translator-ui.js b/translator-ui.js
new file mode 100644
index 0000000..6a430bd
--- /dev/null
+++ b/translator-ui.js
@@ -0,0 +1,114 @@
+import { translateText } from './translation.mjs';
+
+const languages = [
+  ['ar', 'Arabic'], ['zh', 'Chinese'], ['nl', 'Dutch'], ['en', 'English'],
+  ['fr', 'French'], ['de', 'German'], ['hi', 'Hindi'], ['it', 'Italian'],
+  ['ja', 'Japanese'], ['ko', 'Korean'], ['pt', 'Portuguese'], ['ru', 'Russian'],
+  ['es', 'Spanish'], ['tr', 'Turkish'], ['uk', 'Ukrainian'], ['vi', 'Vietnamese'],
+];
+const form = document.querySelector('#translation-form');
+const source = document.querySelector('#source-language');
+const target = document.querySelector('#target-language');
+const input = document.querySelector('#source-text');
+const output = document.querySelector('#translated-text');
+const submit = document.querySelector('#translate-button');
+const copy = document.querySelector('#copy-translation');
+const status = document.querySelector('#translation-status');
+const count = document.querySelector('#character-count');
+let activeRequest;
+let revision = 0;
+
+for (const [code, name] of languages) {
+  source.add(new Option(name, code));
+  target.add(new Option(name, code));
+}
+source.value = 'en';
+target.value = 'es';
+
+function setStatus(message = '', isError = false) {
+  status.textContent = message;
+  status.dataset.error = String(isError);
+}
+
+function invalidate() {
+  revision++;
+  activeRequest?.abort();
+  activeRequest = undefined;
+  output.value = '';
+  copy.disabled = true;
+  submit.disabled = false;
+  submit.textContent = 'Translate text';
+  output.setAttribute('aria-busy', 'false');
+  count.textContent = `${input.value.length.toLocaleString()} / 1,000 characters`;
+  input.lang = source.value;
+  output.lang = target.value;
+  setStatus();
+}
+
+input.addEventListener('input', invalidate);
+source.addEventListener('change', invalidate);
+target.addEventListener('change', invalidate);
+
+document.querySelector('#swap-languages').addEventListener('click', () => {
+  [source.value, target.value] = [target.value, source.value];
+  if (output.value) input.value = output.value;
+  invalidate();
+});
+
+document.querySelector('#clear-translation').addEventListener('click', () => {
+  input.value = '';
+  invalidate();
+  input.focus();
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  invalidate();
+  if (!input.value.trim()) {
+    setStatus('Enter some text to translate.', true);
+    input.focus();
+    return;
+  }
+  const requestRevision = revision;
+  const controller = new AbortController();
+  activeRequest = controller;
+  const timeout = setTimeout(() => controller.abort(new DOMException('Translation timed out.', 'TimeoutError')), 30000);
+  submit.disabled = true;
+  submit.textContent = 'Translating…';
+  output.setAttribute('aria-busy', 'true');
+  setStatus('Translating your text…');
+  try {
+    const result = await translateText(input.value, source.value, target.value, { signal: controller.signal });
+    if (revision !== requestRevision) return;
+    // Render service responses as plain text, never HTML.
+    output.value = result.text;
+    copy.disabled = false;
+    setStatus(result.provider);
+  } catch (error) {
+    if (revision !== requestRevision) return;
+    setStatus(controller.signal.aborted ? 'Translation took too long. Please try again.' : error instanceof TypeError ? 'Could not connect to the translation service. Check your connection and try again.' : error.message, true);
+  } finally {
+    clearTimeout(timeout);
+    if (revision === requestRevision) {
+      activeRequest = undefined;
+      submit.disabled = false;
+      submit.textContent = 'Translate text';
+      output.setAttribute('aria-busy', 'false');
+    }
+  }
+});
+
+copy.addEventListener('click', async () => {
+  const currentRevision = revision;
+  try {
+    await navigator.clipboard.writeText(output.value);
+    if (revision === currentRevision) setStatus('Translation copied.');
+  } catch {
+    if (revision !== currentRevision) return;
+    output.focus();
+    output.select();
+    setStatus('Copy is unavailable here. The translation is selected so you can copy it manually.');
+  }
+});
+
+invalidate();
