diff --git a/translator.js b/translator.js
new file mode 100644
index 0000000..8ba93d4
--- /dev/null
+++ b/translator.js
@@ -0,0 +1,125 @@
+export const languages = {
+  en: 'English', es: 'Spanish', fr: 'French', de: 'German',
+  it: 'Italian', pt: 'Portuguese', nl: 'Dutch', ar: 'Arabic',
+  hi: 'Hindi', ja: 'Japanese', ko: 'Korean', zh: 'Chinese'
+};
+
+export async function translateText(text, from, to, fetcher = fetch) {
+  const input = text.trim();
+  if (!input) throw new Error('Enter some text to translate.');
+  if (text.length > 500) throw new Error('Please keep your text to 500 characters.');
+  if (!languages[from] || !languages[to]) throw new Error('Choose a supported language.');
+  if (from === to) return input;
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 15000);
+  try {
+    const params = new URLSearchParams({ q: input, langpair: `${from}|${to}` });
+    const response = await fetcher(`https://api.mymemory.translated.net/get?${params}`, { signal: controller.signal });
+    if (!response.ok) throw new Error('The translation service is unavailable. Please try again.');
+    const data = await response.json();
+    if (Number(data.responseStatus) !== 200 || !data.responseData?.translatedText) {
+      throw new Error(Number(data.responseStatus) === 429 || data.quotaFinished
+        ? 'The translation service’s daily limit has been reached. Please try again later.'
+        : 'The translation service could not translate this text. Please try again later.');
+    }
+    return data.responseData.translatedText;
+  } catch (error) {
+    if (error.name === 'AbortError') throw new Error('Translation took too long. Please try again.');
+    if (error instanceof TypeError) throw new Error('Unable to connect. Check your internet connection and try again.');
+    throw error;
+  } finally {
+    clearTimeout(timeout);
+  }
+}
+
+if (typeof document !== 'undefined') {
+  const form = document.querySelector('#translation-form');
+  const source = document.querySelector('#source-text');
+  const output = document.querySelector('#translated-text');
+  const from = document.querySelector('#source-language');
+  const to = document.querySelector('#target-language');
+  const submit = document.querySelector('#translate-button');
+  const copy = document.querySelector('#copy-translation');
+  const swap = document.querySelector('#swap-languages');
+  const status = document.querySelector('#translation-status');
+  let revision = 0;
+  let busy = false;
+
+  for (const [code, name] of Object.entries(languages)) {
+    from.add(new Option(name, code));
+    to.add(new Option(name, code));
+  }
+  from.value = 'en';
+  to.value = 'es';
+
+  function update() {
+    revision++;
+    document.querySelector('#character-count').textContent = `${source.value.length} / 500`;
+    output.value = '';
+    copy.disabled = true;
+    status.textContent = '';
+    status.classList.remove('error');
+    submit.disabled = busy || !source.value.trim();
+  }
+  source.addEventListener('input', update);
+  from.addEventListener('change', update);
+  to.addEventListener('change', update);
+  document.querySelector('#clear-text').addEventListener('click', () => {
+    source.value = '';
+    update();
+    source.focus();
+  });
+  swap.addEventListener('click', () => {
+    [from.value, to.value] = [to.value, from.value];
+    if (output.value) source.value = output.value;
+    update();
+  });
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    const requestRevision = revision;
+    busy = true;
+    submit.disabled = true;
+    swap.disabled = true;
+    copy.disabled = true;
+    submit.textContent = 'Translating…';
+    form.setAttribute('aria-busy', 'true');
+    status.classList.remove('error');
+    status.textContent = 'Translating your text…';
+    try {
+      const result = await translateText(source.value, from.value, to.value);
+      if (revision !== requestRevision) return;
+      // The service can return HTML entities. Decode them without inserting HTML into the page.
+      const decoder = document.createElement('textarea');
+      decoder.innerHTML = result.replace(/</g, '&lt;').replace(/>/g, '&gt;');
+      output.value = decoder.value;
+      output.lang = to.value;
+      output.dir = to.value === 'ar' ? 'rtl' : 'auto';
+      copy.disabled = false;
+      status.textContent = 'Translation ready.';
+    } catch (error) {
+      if (revision !== requestRevision) return;
+      status.textContent = error.message;
+      status.classList.add('error');
+    } finally {
+      busy = false;
+      submit.disabled = !source.value.trim();
+      swap.disabled = false;
+      submit.textContent = 'Translate text';
+      form.setAttribute('aria-busy', 'false');
+    }
+  });
+  copy.addEventListener('click', async () => {
+    try {
+      await navigator.clipboard.writeText(output.value);
+      status.classList.remove('error');
+      status.textContent = 'Translation copied to clipboard.';
+    } catch {
+      output.focus();
+      output.select();
+      status.textContent = 'Select and copy the translation using your keyboard or device menu.';
+    }
+  });
+  update();
+}
diff --git a/translator.test.js b/translator.test.js
new file mode 100644
index 0000000..a6a71c9
--- /dev/null
+++ b/translator.test.js
@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { translateText } from './translator.js';
+
+test('requests the selected language pair and safely encodes input', async () => {
+  const result = await translateText(' Hello & welcome! ', 'en', 'es', async (url, options) => {
+    const parsed = new URL(url);
+    assert.equal(parsed.searchParams.get('q'), 'Hello & welcome!');
+    assert.equal(parsed.searchParams.get('langpair'), 'en|es');
+    assert.ok(options.signal instanceof AbortSignal);
+    return { ok: true, json: async () => ({ responseStatus: 200, responseData: { translatedText: '¡Hola y bienvenidos!' } }) };
+  });
+  assert.equal(result, '¡Hola y bienvenidos!');
+});
+
+test('rejects empty, oversized and unsupported inputs before making a request', async () => {
+  const noFetch = () => assert.fail('must not fetch');
+  await assert.rejects(translateText(' ', 'en', 'es', noFetch), /Enter some text/);
+  await assert.rejects(translateText('a'.repeat(501), 'en', 'es', noFetch), /500 characters/);
+  await assert.rejects(translateText('hello', 'xx', 'es', noFetch), /supported language/);
+  assert.equal(await translateText(' hello ', 'en', 'en', noFetch), 'hello');
+});
+
+test('reports service, quota, malformed response, connection and timeout failures', async () => {
+  await assert.rejects(translateText('Hello', 'en', 'es', async () => ({ ok: false })), /unavailable/);
+  for (const data of [
+    { responseStatus: 429 },
+    { responseStatus: 403, quotaFinished: true },
+  ]) {
+    await assert.rejects(translateText('Hello', 'en', 'es', async () => ({ ok: true, json: async () => data })), /daily limit/);
+  }
+  await assert.rejects(translateText('Hello', 'en', 'es', async () => ({ ok: true, json: async () => ({ responseStatus: 200 }) })), /could not translate/);
+  await assert.rejects(translateText('Hello', 'en', 'es', async () => { throw new TypeError('Failed to fetch'); }), /internet connection/);
+  await assert.rejects(translateText('Hello', 'en', 'es', async () => { throw new DOMException('aborted', 'AbortError'); }), /too long/);
+});
