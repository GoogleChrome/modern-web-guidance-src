+---
+import Layout from '../layouts/Layout.astro';
+import TextTranslator from '../components/TextTranslator';
+---
+
+<Layout title="Translate text | The DevTools Times">
+  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
+    <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-3">Reader tools</p>
+    <h1 class="font-brand text-4xl md:text-5xl text-gray-900 mb-3">Translate text</h1>
+    <p class="text-gray-600 max-w-2xl mb-8">A different language. A new perspective. Paste a passage and translate it into your preferred language.</p>
+    <TextTranslator client:load />
+    <noscript><p class="mt-4 text-gray-700">Enable JavaScript to use the translation tool.</p></noscript>
+  </section>
+</Layout>
diff --git a/src/types/translator.ts b/src/types/translator.ts
new file mode 100644
index 0000000..1ea9538
--- /dev/null
+++ b/src/types/translator.ts
@@ -0,0 +1,24 @@
+export interface TranslationOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+export interface LocalTranslator {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+}
+
+export interface TranslatorAPI {
+  availability(options: TranslationOptions): Promise<'unavailable' | 'downloadable' | 'downloading' | 'available'>;
+  create(options: TranslationOptions & {
+    monitor(monitor: {
+      addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void;
+    }): void;
+  }): Promise<LocalTranslator>;
+}
+
+declare global {
+  interface Window {
+    Translator?: TranslatorAPI;
+  }
+}
