+++ b/src/pages/api/translate.ts
@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { languages } from '../../components/translator/languages';
+const json = (data: object, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+export const POST: APIRoute = async ({ request }) => {
+  let input;
+  try { input = await request.json(); } catch { return json({ error: 'Please send valid text.' }, 400); }
+  const { text, source, target } = input ?? {};
+  if (typeof text !== 'string' || !text.trim() || text.length > 5000) return json({ error: 'Enter between 1 and 5,000 characters.' }, 400);
+  if (![source, target].every(code => languages.some(l => l.code === code))) return json({ error: 'Choose a supported language.' }, 400);
+  if (source === target) return json({ translation: text });
+  // MyMemory accepts a maximum of 500 UTF-8 bytes per segment.
+  const chunks: string[] = []; let chunk = '';
+  for (const char of text) {
+    if (new TextEncoder().encode(chunk + char).length > 480) {
+      const boundary = chunk.search(/\s+\S*$/u);
+      if (boundary > 0) {
+        chunks.push(chunk.slice(0, boundary));
+        chunk = chunk.slice(boundary).trimStart();
+      } else { chunks.push(chunk); chunk = ''; }
+    }
+    chunk += char;
+  }
+  if (chunk) chunks.push(chunk);
+  try {
+    const translated: string[] = [];
+    for (const q of chunks) {
+      const params = new URLSearchParams({ q, langpair: `${source}|${target}` });
+      const response = await fetch(`https://api.mymemory.translated.net/get?${params}`, { signal: AbortSignal.timeout(15000) });
+      if (!response.ok) throw new Error('unavailable');
+      const data = await response.json();
+      if (Number(data.responseStatus) === 429) return json({ error: 'The translation service has reached its daily limit. Please try again later.' }, 429);
+      if (Number(data.responseStatus) !== 200 || typeof data.responseData?.translatedText !== 'string') throw new Error('unavailable');
+      translated.push(data.responseData.translatedText);
+    }
+    return json({ translation: translated.join(' ') });
+  } catch { return json({ error: 'Translation is unavailable right now. Please try again in a moment.' }, 502); }
+};
