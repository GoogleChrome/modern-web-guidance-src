+  <script>
+    const steepingForm = document.getElementById('steepingForm');
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const locale = navigator.languages?.length ? navigator.languages : navigator.language;
+    const units = {
+      hours: new Intl.NumberFormat(locale, { style: 'unit', unit: 'hour', unitDisplay: 'long' }),
+      minutes: new Intl.NumberFormat(locale, { style: 'unit', unit: 'minute', unitDisplay: 'long' })
+    };
+    const list = new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' });
+
+    function updateDuration() {
+      const hours = hoursInput.value === '' ? 0 : hoursInput.valueAsNumber;
+      const minutes = minutesInput.value === '' ? 0 : minutesInput.valueAsNumber;
+      const totalMinutes = hours * 60 + minutes;
+
+      if (!hoursInput.validity.valid || !minutesInput.validity.valid ||
+          !Number.isSafeInteger(totalMinutes) || totalMinutes < 0) {
+        humanValue.textContent = 'Enter valid, non-negative whole hours and minutes.';
+        return;
+      }
+
+      if (steepingForm.elements.largestUnit.value === 'minutes') {
+        humanValue.textContent = units.minutes.format(totalMinutes);
+        return;
+      }
+
+      const parts = [];
+      const wholeHours = Math.floor(totalMinutes / 60);
+      const remainingMinutes = totalMinutes % 60;
+      if (wholeHours) parts.push(units.hours.format(wholeHours));
+      if (remainingMinutes || !wholeHours) parts.push(units.minutes.format(remainingMinutes));
+      humanValue.textContent = list.format(parts);
+    }
+
+    steepingForm.addEventListener('input', updateDuration);
+    steepingForm.addEventListener('change', updateDuration);
+    steepingForm.addEventListener('submit', event => event.preventDefault());
+    updateDuration();
+  </script>
+
