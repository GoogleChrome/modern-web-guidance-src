+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingPreview = document.getElementById('shipping-preview');
+    const shippingPreviewText = document.getElementById('shipping-preview-text');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const address = new FormData(shippingForm);
+      shippingPreviewText.textContent = [
+        address.get('full_name'),
+        address.get('street_address'),
+        address.get('city'),
+        address.get('region'),
+        address.get('postal_code'),
+        address.get('country')
+      ].map((value) => value.trim()).filter(Boolean).join('\n');
+      shippingPreview.hidden = false;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingPreview.hidden = true;
+      shippingPreviewText.textContent = '';
+    });
+
+    shippingForm.querySelector('button[type="submit"]').disabled = false;
+  </script>
