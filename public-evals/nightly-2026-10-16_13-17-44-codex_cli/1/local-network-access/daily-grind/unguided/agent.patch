+++ b/server.mjs
@@ -0,0 +1,16 @@
+import statikk from 'statikk';
+import { fileURLToPath } from 'node:url';
+
+const { url } = await statikk({
+  root: fileURLToPath(new URL('.', import.meta.url)),
+  port: process.env.PORT || 11222,
+  setHeaders(response) {
+    // Keep the legacy directive for browsers predating the split permissions.
+    response.setHeader(
+      'Permissions-Policy',
+      'local-network=(self), loopback-network=(self), local-network-access=(self)',
+    );
+  },
+});
+
+console.log(`The Daily Grind is available at ${url}`);
