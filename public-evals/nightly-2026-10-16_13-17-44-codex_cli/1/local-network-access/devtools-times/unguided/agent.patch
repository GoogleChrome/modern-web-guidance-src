--- a/README.md
+++ b/README.md
@@ -9,6 +9,13 @@ pnpm install && pnpm run start
 
 The application will now be running on `http://localhost:11224`.
 
+The app sends a `Permissions-Policy` header allowing its own origin to request
+local-network and loopback access. Deployed pages must use HTTPS, and users must
+grant access when prompted by their browser. Local services must allow the app's
+origin through CORS when it reads cross-origin responses. If the app is embedded
+in a cross-origin iframe, the parent must also delegate `local-network`,
+`loopback-network`, and (for older browsers) `local-network-access` to the frame.
+
 ## Tech Stack
 
 - **[Astro](https://astro.build/)**: The web framework for building content-driven websites.
diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..bc4f4ba 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -9,5 +9,12 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+  const response = await next();
+  // Allow this app to request LAN and loopback access, including in browsers
+  // that still use the combined local-network-access permission.
+  response.headers.set(
+    'Permissions-Policy',
+    'local-network=(self), loopback-network=(self), local-network-access=(self)',
+  );
+  return response;
 });
