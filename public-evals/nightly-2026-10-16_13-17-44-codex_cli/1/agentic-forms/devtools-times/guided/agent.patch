diff --git a/src/utils/agenticForms.ts b/src/utils/agenticForms.ts
new file mode 100644
index 0000000..907df50
--- /dev/null
+++ b/src/utils/agenticForms.ts
@@ -0,0 +1,21 @@
+import type { FormEvent } from 'react';
+
+// WebMCP extends the native event, rather than React's synthetic event.
+type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+};
+
+export function submitAgenticForm(
+  event: FormEvent<HTMLFormElement>,
+  submit: (data: FormData) => Promise<string>,
+) {
+  event.preventDefault();
+  // Read the actual controls: agents may populate them without React onChange.
+  const result = submit(new FormData(event.currentTarget));
+  const nativeEvent = event.nativeEvent as AgentSubmitEvent;
+  if (nativeEvent.agentInvoked && typeof nativeEvent.respondWith === 'function') {
+    // respondWith must be called synchronously during submit dispatch.
+    nativeEvent.respondWith(result);
+  }
+}
