@@ -0,0 +1,14 @@
+import 'react';
+
+// Experimental WebMCP declarative attributes are not yet in React's types.
+declare module 'react' {
+  interface FormHTMLAttributes<T> {
+    toolname?: string;
+    tooldescription?: string;
+    toolautosubmit?: '';
+  }
+
+  interface InputHTMLAttributes<T> {
+    toolparamdescription?: string;
+  }
+}
diff --git a/src/utils/formTools.ts b/src/utils/formTools.ts
new file mode 100644
index 0000000..dece284
--- /dev/null
+++ b/src/utils/formTools.ts
@@ -0,0 +1,13 @@
+interface AgentSubmitEvent extends Event {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+}
+
+// Called synchronously after preventDefault; the promise settles after the
+// existing form handler has updated the UI. Ordinary submissions need no API.
+export function respondToAgent(event: Event, result: Promise<unknown>): void {
+  const agentEvent = event as AgentSubmitEvent;
+  if (agentEvent.agentInvoked && typeof agentEvent.respondWith === 'function') {
+    agentEvent.respondWith(result);
+  }
+}
