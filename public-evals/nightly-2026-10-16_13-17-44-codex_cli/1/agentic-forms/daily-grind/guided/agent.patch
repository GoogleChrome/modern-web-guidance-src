@@ -0,0 +1,68 @@
+// The displayed menu is the source of truth for both people and agents.
+const cards = [...document.querySelectorAll('[data-coffee]')];
+const coffees = cards.map(card => ({
+  id: card.dataset.coffee,
+  name: card.querySelector('h3').textContent,
+  description: card.querySelector('p').textContent,
+}));
+const searchForm = document.getElementById('search-coffees');
+const detailsForm = document.getElementById('get-coffee-details');
+const searchStatus = document.getElementById('search-status');
+const details = document.getElementById('coffee-details');
+
+function respond(event, result) {
+  // Ordinary SubmitEvents do not implement the experimental WebMCP API.
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(Promise.resolve(result));
+  }
+}
+
+searchForm.addEventListener('submit', event => {
+  event.preventDefault();
+  const query = new FormData(searchForm).get('query').trim();
+  if (!searchForm.checkValidity() || query.length > 120) {
+    const error = 'Please enter a search of at most 120 characters.';
+    searchStatus.textContent = error;
+    respond(event, { error });
+    return;
+  }
+
+  const words = query.toLowerCase().split(/\s+/).filter(Boolean);
+  const matches = coffees.filter(coffee => {
+    const text = `${coffee.name} ${coffee.description}`.toLowerCase();
+    return words.every(word => text.includes(word));
+  });
+  cards.forEach(card => {
+    card.hidden = !matches.some(coffee => coffee.id === card.dataset.coffee);
+  });
+  searchStatus.textContent = matches.length
+    ? `Showing ${matches.length} featured coffee${matches.length === 1 ? '' : 's'}.`
+    : 'No featured coffees match. Try another search or leave the search blank.';
+  respond(event, { query, count: matches.length, coffees: matches });
+});
+
+detailsForm.addEventListener('submit', event => {
+  event.preventDefault();
+  const id = new FormData(detailsForm).get('coffee');
+  const coffee = coffees.find(item => item.id === id);
+  if (!detailsForm.checkValidity() || !coffee) {
+    const error = 'Please select a featured coffee.';
+    details.textContent = error;
+    respond(event, { error });
+    return;
+  }
+
+  const heading = document.createElement('h3');
+  heading.textContent = coffee.name;
+  const description = document.createElement('p');
+  description.textContent = coffee.description;
+  details.replaceChildren(heading, description);
+  respond(event, { coffee });
+});
+
+document.querySelectorAll('[data-details]').forEach(link => {
+  link.addEventListener('click', () => {
+    detailsForm.elements.coffee.value = link.dataset.details;
+    detailsForm.requestSubmit();
+  });
+});
