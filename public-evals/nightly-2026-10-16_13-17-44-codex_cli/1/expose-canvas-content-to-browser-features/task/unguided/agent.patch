+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('coffee-form');
+      const name = document.getElementById('coffee-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = document.getElementById('blend-summary');
+      const status = document.getElementById('blend-status');
+      const context = canvas.getContext('2d');
+
+      function drawCup() {
+        if (!context) return; // The HTML form also works without canvas support.
+        const bounds = stage.getBoundingClientRect();
+        const content = form.getBoundingClientRect();
+        if (!bounds.width || !bounds.height) return;
+        const ratio = window.devicePixelRatio || 1;
+        canvas.width = Math.round(bounds.width * ratio);
+        canvas.height = Math.round(bounds.height * ratio);
+        // Draw in CSS pixels while keeping the backing bitmap at device resolution.
+        context.setTransform(canvas.width / bounds.width, 0, 0,
+          canvas.height / bounds.height, 0, 0);
+        const x = content.left - bounds.left - 18;
+        const y = content.top - bounds.top - 20;
+        const width = content.width + 36;
+        const bottom = content.bottom - bounds.top + 24;
+        const height = bottom - y;
+        const handleWidth = Math.min(54, bounds.width - x - width - 8);
+
+        context.strokeStyle = '#b99a84';
+        context.lineWidth = 14;
+        context.beginPath();
+        context.ellipse(x + width - 2, y + height * 0.44,
+          handleWidth, height * 0.23, 0, -Math.PI / 2, Math.PI / 2);
+        context.stroke();
+
+        context.fillStyle = '#dfd0c2';
+        context.beginPath();
+        context.ellipse(x + width / 2, bottom + 18, width * 0.62, 12, 0, 0, Math.PI * 2);
+        context.fill();
+
+        context.fillStyle = '#fffaf2';
+        context.strokeStyle = '#b99a84';
+        context.lineWidth = 2;
+        context.beginPath();
+        context.moveTo(x, y);
+        context.lineTo(x + width, y);
+        context.lineTo(x + width, bottom - 26);
+        context.quadraticCurveTo(x + width, bottom + 4, x + width / 2, bottom + 4);
+        context.quadraticCurveTo(x, bottom + 4, x, bottom - 26);
+        context.closePath();
+        context.fill();
+        context.stroke();
+
+        context.beginPath();
+        context.ellipse(x + width / 2, y, width / 2, 18, 0, 0, Math.PI * 2);
+        const coffeeColors = { whole: '#bd8a60', oat: '#c49a70', almond: '#c7a481', none: '#533125' };
+        context.fillStyle = coffeeColors[milk.value];
+        context.fill();
+        context.stroke();
+        if (syrup.value !== 'none') {
+          context.strokeStyle = { vanilla: '#f2d8a7', maple: '#965321', caramel: '#b86b27' }[syrup.value];
+          context.lineWidth = 3;
+          context.beginPath();
+          context.ellipse(x + width / 2, y, width * 0.32, 9, 0, 0, Math.PI * 1.7);
+          context.stroke();
+        }
+      }
+
+      form.addEventListener('input', () => {
+        summary.textContent = `Your latte: ${milk.selectedOptions[0].textContent} · ${syrup.selectedOptions[0].textContent}`;
+        status.textContent = '';
+        drawCup();
+      });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.textContent = name.value.trim()
+          ? `Blend selected for ${name.value.trim()}! Your cup is ready to order.`
+          : 'Blend selected! Your cup is ready to order.';
+      });
+
+      // Measure the actual HTML box, including changes from translated text,
+      // font sizes, and wrapping, so the cup always frames its controls.
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(drawCup);
+        observer.observe(stage);
+        observer.observe(form);
+      }
+      window.addEventListener('resize', drawCup);
+      // Moving between screens can change DPR without changing CSS dimensions.
+      function watchResolution() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          drawCup();
+          watchResolution();
+        }, { once: true });
+      }
+      watchResolution();
+      drawCup();
+    })();
+  </script>
+
