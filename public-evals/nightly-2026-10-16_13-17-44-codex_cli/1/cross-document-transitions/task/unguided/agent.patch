+  <script>
+    // Register early so the incoming page can set its type before it is revealed.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const pageNumber = (url) => {
+        const value = Number(new URL(url).searchParams.get('page') || 1);
+        return Number.isInteger(value) && value >= 1 && value <= 3 ? value : 1;
+      };
+
+      const applyTransitionType = (event, from, to) => {
+        if (!event.viewTransition) return;
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          event.viewTransition.skipTransition();
+          return;
+        }
+        if (!event.viewTransition.types || !from?.url || !to?.url) return;
+        const fromURL = new URL(from.url);
+        const toURL = new URL(to.url);
+        if (fromURL.origin !== toURL.origin || fromURL.pathname !== toURL.pathname) return;
+        const difference = pageNumber(to.url) - pageNumber(from.url);
+        if (difference !== 0) {
+          event.viewTransition.types.add(difference > 0 ? 'next' : 'previous');
+        }
+      };
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event, event.activation?.from, event.activation?.entry);
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        const activation = window.navigation?.activation;
+        applyTransitionType(event, activation?.from, activation?.entry);
+      });
+    }
+  </script>
 </head>
 
