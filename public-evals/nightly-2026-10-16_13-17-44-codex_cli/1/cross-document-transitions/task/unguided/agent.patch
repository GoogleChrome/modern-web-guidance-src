+  <script>
+    const seasonalPages = [
+      null, // The first page is already rendered in the HTML.
+      [
+        ['Pumpkin Spice Latte', 'Espresso with warming pumpkin spice and silky steamed milk.', '/menu/pumpkin-spice'],
+        ['Salted Caramel Mocha', 'Rich chocolate and caramel finished with a touch of sea salt.', '/menu/caramel-mocha'],
+        ['Honey Cinnamon Cappuccino', 'A cozy blend of honey, cinnamon, and airy milk foam.', '/menu/honey-cappuccino']
+      ],
+      [
+        ['Toasted Hazelnut Latte', 'Nutty hazelnut and freshly pulled espresso with steamed milk.', '/menu/hazelnut-latte'],
+        ['Spiced Chai', 'Fragrant black tea with warming spices and creamy milk.', '/menu/spiced-chai'],
+        ['Vanilla Sweet Cream Cold Brew', 'Our slow-steeped cold brew topped with vanilla sweet cream.', '/menu/vanilla-cold-brew']
+      ]
+    ];
+    const requestedPage = Number(new URL(window.location.href).searchParams.get('page') || 1);
+    const currentPage = Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= seasonalPages.length
+      ? requestedPage : 1;
+
+    if (currentPage > 1) {
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = seasonalPages[currentPage - 1][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = href;
+      });
+    }
+
+    document.getElementById('page-status').textContent = `Page ${currentPage} of ${seasonalPages.length}`;
+    for (const [id, target] of [['previous', currentPage - 1], ['next', currentPage + 1]]) {
+      const link = document.getElementById(id);
+      if (target >= 1 && target <= seasonalPages.length) {
+        const url = new URL(window.location.href);
+        url.searchParams.set('page', target);
+        link.href = url.pathname + url.search + url.hash;
+        link.removeAttribute('aria-disabled');
+        link.removeAttribute('tabindex');
+      } else {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+        link.setAttribute('tabindex', '-1');
+      }
+    }
+  </script>
