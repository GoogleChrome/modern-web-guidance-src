+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+export const encode = bytes => btoa(String.fromCharCode(...bytes));
+export const decode = value => Uint8Array.from(atob(value), c=>c.charCodeAt(0));
+export async function exchange(mode){
+ let publicKey, secretKey, cipherText, alice, bob;
+ if(mode==='classical'){
+  const recipient=x25519.keygen(), sender=x25519.keygen();
+  publicKey=recipient.publicKey;secretKey=recipient.secretKey;cipherText=sender.publicKey;
+  alice=x25519.getSharedSecret(recipient.secretKey,sender.publicKey);
+  bob=x25519.getSharedSecret(sender.secretKey,recipient.publicKey);
+ } else {
+  const kem=mode==='hybrid'?ml_kem768_x25519:ml_kem768;
+  ({publicKey,secretKey}=kem.keygen());
+  const encapsulated=kem.encapsulate(publicKey);cipherText=encapsulated.cipherText;bob=encapsulated.sharedSecret;
+  alice=kem.decapsulate(cipherText,secretKey);
+ }
+ if(!alice.every((b,i)=>b===bob[i]))throw Error('Shared secrets did not match.');
+ const material=await crypto.subtle.importKey('raw',alice,'HKDF',false,['deriveKey']);
+ const salt=crypto.getRandomValues(new Uint8Array(32));
+ const key=await crypto.subtle.deriveKey({name:'HKDF',hash:'SHA-256',salt,info:new TextEncoder().encode(`cipher-workspace/v1/${mode}`)},material,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
+ const fingerprint=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',publicKey))).slice(0,16).map(b=>b.toString(16).padStart(2,'0')).join(':');
+ alice.fill(0);bob.fill(0);secretKey.fill(0);
+ return {key,publicKey,cipherText,fingerprint,salt,mode};
+}
+export async function encrypt(session,text,aad=''){
+ const iv=crypto.getRandomValues(new Uint8Array(12));
+ const data=await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:new TextEncoder().encode(aad),tagLength:128},session.key,new TextEncoder().encode(text));
+ return JSON.stringify({v:1,algorithm:'AES-256-GCM',iv:encode(iv),aad,ciphertext:encode(new Uint8Array(data))},null,2);
+}
+export async function decrypt(session,envelope){
+ const p=JSON.parse(envelope);if(p.v!==1||p.algorithm!=='AES-256-GCM')throw Error('Unsupported encrypted envelope.');
+ const result=await crypto.subtle.decrypt({name:'AES-GCM',iv:decode(p.iv),additionalData:new TextEncoder().encode(p.aad||''),tagLength:128},session.key,decode(p.ciphertext));
+ return new TextDecoder().decode(result);
+}
