+import { createIcons, icons } from 'lucide';
+import { exchange, encrypt, decrypt, encode } from './crypto.js';
+const $=s=>document.querySelector(s);
+const icon=(name,cls='')=>`<i data-lucide="${name}" class="icon ${cls}"></i>`;
+const configs={classical:{title:'Classical',algorithm:'X25519',description:'Fast, proven elliptic-curve key agreement.',tag:'Established',keySize:'32 bytes',security:'128-bit classical'},hybrid:{title:'Hybrid',algorithm:'X25519 + ML-KEM-768',description:'Classical trust meets post-quantum resilience.',tag:'Quantum-ready',keySize:'1,216 bytes',security:'NIST Level 3'},pq:{title:'Post-quantum',algorithm:'ML-KEM-768',description:'Built for a world with quantum computers.',tag:'Quantum-ready',keySize:'1,184 bytes',security:'NIST Level 3'}};
+let mode='hybrid',tab='exchange',view='playground',sessions=[],operations=[],current=null,output='',formMode='encrypt',label='',toastTimer;
+function refreshIcons(){createIcons({icons,attrs:{'stroke-width':1.7}})}
+function toast(message){$('.toast')?.remove();const el=document.createElement('div');el.className='toast';el.setAttribute('role','status');el.textContent=message;document.body.append(el);clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.remove(),4500)}
+function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function addOp(type,algorithm){operations.unshift({type,algorithm,time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}),id:crypto.randomUUID()});}
+function render(){
+$('#app').innerHTML=`<aside class="sidebar"><a class="brand" href="/">${icon('fingerprint','brand-mark')}<span>cipher<span class="version">v1.0</span></span></a><div class="workspace-switch"><div class="workspace-avatar">${icon('box')}</div><span>Personal workspace</span>${icon('chevrons-up-down')}</div><nav><div class="nav-label">WORKSPACE</div>${[['overview','layout-dashboard','Overview'],['playground','blocks','Playground'],['vault','key-round','Key vault'],['activity','clock-3','Activity log']].map(([v,i,t])=>`<button class="nav-item ${view===v?'active':''}" data-view="${v}">${icon(i)}<span>${t}</span>${v==='vault'?`<span class="badge">${sessions.length}</span>`:''}</button>`).join('')}</nav><div class="side-bottom"><button class="nav-item" data-dialog="guide">${icon('book-open')}<span>Documentation</span>${icon('arrow-up-right')}</button><button class="nav-item" data-dialog="settings">${icon('settings-2')}<span>Settings</span></button><div class="local-note"><strong>${icon('shield-check')} Private by design</strong><p>Everything happens in your browser. Your keys never leave.</p></div><div class="profile"><div class="avatar">JD</div><div><div class="profile-name">Jamie Davis</div><div class="profile-sub">Personal account</div></div>${icon('chevrons-up-down')}</div></div></aside><main class="main"><header class="topbar"><div class="breadcrumbs">Workspace ${icon('chevron-right')} <strong>${view==='playground'?'Playground':view==='vault'?'Key vault':view==='activity'?'Activity log':'Overview'}</strong></div><div class="top-actions"><span class="environment"><span class="dot"></span> Browser environment</span><a href="https://github.com/paulmillr/noble-post-quantum" target="_blank" rel="noopener">${icon('github')} GitHub ${icon('arrow-up-right')}</a><button aria-label="Help" data-dialog="guide">${icon('circle-help')}</button></div></header><div class="main-content"><div class="page-heading"><div><h1>${view==='playground'?'Cryptography playground':view==='vault'?'Your key vault':view==='activity'?'Activity log':'Workspace overview'}</h1><p class="subtitle">${view==='playground'?'Establish trust. Protect your data. All in your browser.':view==='vault'?'Ephemeral sessions, kept safely in this browser tab.':view==='activity'?'A local record of your cryptographic operations.':'Your private space for modern cryptography.'}</p></div><button class="button" data-dialog="guide">${icon('book-open')} Quick guide ${icon('arrow-up-right')}</button></div>${view==='playground'?`<div class="tabs"><button class="tab ${tab==='exchange'?'active':''}" data-tab="exchange">${icon('arrow-left-right')} Key exchange</button><button class="tab ${tab==='encrypt'?'active':''}" data-tab="encrypt">${icon('lock-keyhole')} Encrypt / Decrypt</button><button class="tab ${tab==='sessions'?'active':''}" data-tab="sessions">${icon('layers')} Sessions <span class="small-count">${sessions.length}</span></button></div>${tab==='exchange'?exchangeUI():tab==='encrypt'?encryptionUI():vaultUI()}`:view==='vault'?vaultUI():view==='activity'?activityUI(true):overviewUI()}${view==='playground'&&tab==='exchange'?activityUI():''}<footer class="footer"><span>${icon('shield-check')} Local execution. Zero data transmitted.</span><div class="footer-links"><a href="https://www.w3.org/TR/WebCryptoAPI/" target="_blank" rel="noopener">Web Crypto API ${icon('arrow-up-right')}</a><span>Cipher v1.0.0</span></div></footer></div></main><dialog id="dialog"><button class="dialog-close" aria-label="Close dialog">${icon('x')}</button><div id="dialog-content"></div></dialog>`;
