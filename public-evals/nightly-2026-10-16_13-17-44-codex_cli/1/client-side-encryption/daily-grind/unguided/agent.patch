+}
+function exchangeUI(){const c=configs[mode];return `<div class="section-line"><span class="eyebrow">CHOOSE YOUR PROTECTION</span><span class="helper">${icon('circle-info')} A stronger foundation for every connection</span></div><div class="protocols">${Object.entries(configs).map(([m,c])=>`<button class="protocol ${mode===m?'selected':''}" data-mode="${m}">${m==='hybrid'?'<span class="recommend">RECOMMENDED</span>':''}<div class="protocol-top"><div class="protocol-symbol">${icon(m==='classical'?'key-round':m==='hybrid'?'combine':'atom')}</div><span class="protocol-title">${c.title}</span><span class="radio"></span></div><p>${c.description}</p><div class="protocol-bottom"><span class="mono">${c.algorithm}</span><span class="tag ${m!=='classical'?'purple':''}">${c.tag}</span></div></button>`).join('')}</div><div class="work-grid"><section class="panel"><div class="panel-heading"><h2>${icon('sliders-horizontal')} Configure key exchange</h2><span class="step-chip">01 / 02</span></div><div class="panel-body"><label class="field-label" for="session-name">Session name <span class="optional">Optional</span></label><input class="input" id="session-name" placeholder="e.g. Secure channel with Alice" value="${esc(label)}" maxlength="64"><div class="field-hint">Give this exchange a name to find it later.</div><div class="two-fields"><div><label class="field-label">Key derivation function</label><div class="read-field"><span class="mono">HKDF-SHA-256</span>${icon('lock-keyhole')}</div></div><div><label class="field-label">Encryption algorithm</label><div class="read-field"><span class="mono">AES-256-GCM</span>${icon('lock-keyhole')}</div></div></div><div class="notice">${icon('shield-check')}<div><strong>${mode==='hybrid'?'The best of both worlds.':mode==='pq'?'Ready for what comes next.':'A proven foundation.'}</strong> ${mode==='hybrid'?'Combines elliptic-curve key agreement with a post-quantum KEM for defense in depth.':mode==='pq'?'Establishes a shared secret using ML-KEM-768 post-quantum encapsulation.':'Establishes a shared secret using X25519 elliptic-curve key agreement.'}</div></div><button class="button primary generate" id="generate">${icon('key-round')} Generate shared secret ${icon('arrow-right')}</button><div class="panel-foot">${icon('lock-keyhole')} Keys are generated locally and never sent to a server</div>${current?`<div class="result"><div class="result-title">${icon('circle-check')} Shared secret established · ${esc(current.name)}</div><div class="field-hint">Public key fingerprint</div><div class="result-code mono">${current.fingerprint}</div><div class="result-actions"><button class="button" id="copy-key">${icon('copy')} Copy public key</button><button class="button primary" data-tab="encrypt">Encrypt data ${icon('arrow-right')}</button></div></div>`:''}</div></section><aside class="flow"><div class="flow-heading"><span>How the exchange works</span><span class="live-chip"><span class="dot"></span> ${current?'ESTABLISHED':'LOCAL PREVIEW'}</span></div><div class="diagram"><div><div class="party-box">${icon('monitor')}<strong>Alice</strong><span>Recipient</span></div><div class="flow-line"></div><div class="flow-small">Public + private key</div></div><div class="exchange-arrows">${icon('arrow-left-right')}</div><div><div class="party-box">${icon('monitor')}<strong>Bob</strong><span>Sender</span></div><div class="flow-line"></div><div class="flow-small">${mode==='classical'?'Ephemeral key pair':'Encapsulated key'}</div></div><div class="joint"></div><div class="secret-box">${icon('key-round')} Shared secret</div></div><div class="flow-caption">Two parties. One secret. Never transmitted.</div><div class="flow-footer"><span>${icon('shield-check')} ${mode==='classical'?'Classical protection':'Post-quantum protected'}</span><span>${mode==='classical'?'X25519': 'NIST FIPS 203'}</span></div></aside></div>`}
+function activityUI(full=false){return `<section class="activity"><div class="activity-top"><h2>${full?'All operations':'Recent activity'}</h2><button class="text-button" ${full?'id="clear-log"':'data-view="activity"'}>${full?'Clear log':'View all activity'} ${icon(full?'trash-2':'arrow-right')}</button></div><div class="panel"><table><thead><tr><th>OPERATION</th><th>ALGORITHM</th><th>STATUS</th><th>TIME</th><th></th></tr></thead><tbody>${operations.length?operations.slice(0,full?100:3).map(o=>`<tr><td><span class="op-name">${icon(o.type==='Key exchange'?'arrow-left-right':o.type==='Encryption'?'lock-keyhole':'lock-keyhole-open')}${esc(o.type)}</span></td><td class="mono">${o.algorithm}</td><td><span class="success">${icon('check')} Completed</span></td><td>${o.time}</td><td><button class="text-button" data-operation="${o.id}" aria-label="View operation">${icon('arrow-up-right')}</button></td></tr>`).join(''):'<tr><td colspan="5" class="empty">Your activity starts here. Generate a shared secret to begin.</td></tr>'}</tbody></table></div></section>`}
