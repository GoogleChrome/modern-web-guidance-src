+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { exchange, encrypt, decrypt } from './crypto.js';
+for(const mode of ['classical','hybrid','pq']){
+ test(`${mode}: establish a secret and round-trip authenticated encryption`,async()=>{
+  const session=await exchange(mode);
+  assert.equal(session.key.extractable,false);
+  assert.ok(session.publicKey.length>0);
+  const message='Private message 🔐 — café';
+  const first=await encrypt(session,message,'document:42');
+  const second=await encrypt(session,message,'document:42');
+  assert.notEqual(JSON.parse(first).iv,JSON.parse(second).iv);
+  assert.equal(await decrypt(session,first),message);
+  const changed=JSON.parse(first);changed.aad='document:43';
+  await assert.rejects(()=>decrypt(session,JSON.stringify(changed)));
+  const tampered=JSON.parse(first);const bytes=Uint8Array.from(atob(tampered.ciphertext),c=>c.charCodeAt(0));bytes[0]^=1;tampered.ciphertext=btoa(String.fromCharCode(...bytes));
+  await assert.rejects(()=>decrypt(session,JSON.stringify(tampered)));
+  const different=await exchange(mode);
+  await assert.rejects(()=>decrypt(different,first));
+ });
+}
