+++ b/crypto.js
@@ -0,0 +1,95 @@
+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+const encoder = new TextEncoder();
+export const hex = bytes => Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
+export const base64 = bytes => btoa(Array.from(bytes, b => String.fromCharCode(b)).join(''));
+const unbase64 = value => {
+  if (typeof value !== 'string' || value.length > 3_000_000 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) throw new Error('Invalid payload encoding.');
+  return Uint8Array.from(atob(value), c => c.charCodeAt(0));
+};
+const concat = (...arrays) => {
+  const result = new Uint8Array(arrays.reduce((length, a) => length + a.length, 0));
+  let offset = 0;
+  for (const array of arrays) { result.set(array, offset); offset += array.length; }
+  return result;
+};
+async function derive(secret, salt, info) {
+  const key = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveBits']);
+  return new Uint8Array(await crypto.subtle.deriveBits({ name: 'HKDF', hash: 'SHA-256', salt, info }, key, 256));
+}
+export async function establish(mode) {
+  if (!['classical', 'pq', 'hybrid'].includes(mode)) throw new Error('Unknown protection mode.');
+  let aliceRaw, bobRaw, publicKey, peerKey, label;
+  if (mode === 'classical') {
+    const alice = x25519.keygen();
+    const bob = x25519.keygen();
+    try {
+      aliceRaw = x25519.getSharedSecret(alice.secretKey, bob.publicKey);
+      bobRaw = x25519.getSharedSecret(bob.secretKey, alice.publicKey);
+      publicKey = alice.publicKey;
+      peerKey = bob.publicKey;
+      label = 'X25519';
+    } finally { alice.secretKey.fill(0); bob.secretKey.fill(0); }
+  } else {
+    const kem = mode === 'hybrid' ? ml_kem768_x25519 : ml_kem768;
+    const receiver = kem.keygen();
+    try {
+      const encapsulation = kem.encapsulate(receiver.publicKey);
+      aliceRaw = encapsulation.sharedSecret;
+      bobRaw = kem.decapsulate(encapsulation.cipherText, receiver.secretKey);
+      publicKey = receiver.publicKey;
+      peerKey = encapsulation.cipherText;
+      label = mode === 'hybrid' ? 'X25519 + ML-KEM-768' : 'ML-KEM-768';
+    } finally { receiver.secretKey.fill(0); }
+  }
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  // Bind both public contributions and the suite into the local demo's KDF context.
+  const transcript = concat(encoder.encode(`cipher/local-exchange/v1/${mode}/`), publicKey, peerKey);
+  const info = new Uint8Array(await crypto.subtle.digest('SHA-256', transcript));
+  let aliceSecret, bobSecret;
+  try {
+    [aliceSecret, bobSecret] = await Promise.all([derive(aliceRaw, salt, info), derive(bobRaw, salt, info)]);
+  } finally { aliceRaw.fill(0); bobRaw.fill(0); }
+  let difference = 0;
+  for (let i = 0; i < aliceSecret.length; i++) difference |= aliceSecret[i] ^ bobSecret[i];
+  if (difference) { aliceSecret.fill(0); bobSecret.fill(0); throw new Error('The shared secrets did not match. Please try again.'); }
+  const encryptionInfo = encoder.encode('cipher/local-exchange/v1/aes-256-gcm');
+  const [aliceBits, bobBits] = await Promise.all([derive(aliceSecret, salt, encryptionInfo), derive(bobSecret, salt, encryptionInfo)]);
+  const [aliceKey, bobKey] = await Promise.all([
+    crypto.subtle.importKey('raw', aliceBits, 'AES-GCM', false, ['encrypt']),
+    crypto.subtle.importKey('raw', bobBits, 'AES-GCM', false, ['decrypt']),
+  ]);
+  aliceBits.fill(0); bobBits.fill(0);
+  return { id: crypto.randomUUID(), mode, label, aliceSecret, bobSecret, aliceKey, bobKey, publicKey, peerKey, created: new Date() };
+}
+const additionalData = payload => encoder.encode(JSON.stringify({ v: payload.v, algorithm: payload.algorithm, exchangeId: payload.exchangeId, aad: payload.aad }));
+export async function encrypt(exchange, plaintext, aad = '') {
+  if (!exchange) throw new Error('Establish a shared secret first.');
+  if (!plaintext.trim()) throw new Error('Enter a message to encrypt.');
+  if (encoder.encode(plaintext).length > 1_000_000) throw new Error('Please use a message smaller than 1 MB.');
+  const nonce = crypto.getRandomValues(new Uint8Array(12));
+  const payload = { v: 1, algorithm: 'AES-256-GCM', exchangeId: exchange.id, nonce: base64(nonce), aad };
+  const encrypted = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: nonce, additionalData: additionalData(payload), tagLength: 128 }, exchange.aliceKey, encoder.encode(plaintext));
+  return { ...payload, ciphertext: base64(new Uint8Array(encrypted)) };
+}
+export async function decrypt(exchange, serialized) {
+  if (!exchange) throw new Error('Establish a shared secret first.');
+  let payload;
+  try { payload = JSON.parse(serialized); } catch { throw new Error('Paste a valid JSON payload to decrypt.'); }
+  if (!payload || payload.v !== 1 || payload.algorithm !== 'AES-256-GCM' || typeof payload.aad !== 'string' || typeof payload.exchangeId !== 'string') throw new Error('This payload format is not supported.');
+  if (payload.exchangeId !== exchange.id) throw new Error('This payload belongs to a different exchange. Use the current session’s payload.');
+  const nonce = unbase64(payload.nonce);
+  const ciphertext = unbase64(payload.ciphertext);
+  if (nonce.length !== 12 || ciphertext.length < 16) throw new Error('The nonce or ciphertext length is invalid.');
+  try {
+    const plaintext = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: nonce, additionalData: additionalData(payload), tagLength: 128 }, exchange.bobKey, ciphertext);
+    return new TextDecoder('utf-8', { fatal: true }).decode(plaintext);
+  } catch { throw new Error('Authentication failed. The payload was changed or the key is incorrect.'); }
+}
+export function dispose(exchange) {
+  if (!exchange) return;
+  exchange.aliceSecret.fill(0); exchange.bobSecret.fill(0);
+  exchange.aliceKey = null; exchange.bobKey = null;
+}
diff --git a/crypto.test.js b/crypto.test.js
new file mode 100644
index 0000000..dff6391
--- /dev/null
+++ b/crypto.test.js
@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { establish, encrypt, decrypt, dispose } from './crypto.js';
+
+for (const mode of ['classical', 'pq', 'hybrid']) {
+  test(`${mode}: independently derived secrets agree and authenticated encryption round-trips`, async () => {
+    const session = await establish(mode);
+    assert.deepEqual(session.aliceSecret, session.bobSecret);
+    assert.equal(session.aliceSecret.length, 32);
+    assert.equal(session.aliceKey.extractable, false);
+    const message = 'Sensitive data 🔐 — こんにちは';
+    const payload = await encrypt(session, message, 'context:message-1');
+    assert.equal(await decrypt(session, JSON.stringify(payload)), message);
+    const second = await encrypt(session, message, 'context:message-1');
+    assert.notEqual(payload.nonce, second.nonce);
+    assert.notEqual(payload.ciphertext, second.ciphertext);
+    const tamperedBytes = Uint8Array.from(atob(payload.ciphertext), c => c.charCodeAt(0));
+    tamperedBytes[0] ^= 1;
+    const ciphertext = btoa(String.fromCharCode(...tamperedBytes));
+    await assert.rejects(decrypt(session, JSON.stringify({ ...payload, ciphertext })), /Authentication failed/);
+    await assert.rejects(decrypt(session, JSON.stringify({ ...payload, aad: 'modified' })), /Authentication failed/);
+    await assert.rejects(decrypt(session, JSON.stringify({ ...payload, exchangeId: 'another-exchange' })), /different exchange/);
+    dispose(session);
+    assert.ok(session.aliceSecret.every(b => b === 0));
+    assert.equal(session.aliceKey, null);
+  });
+}
+test('fresh exchanges use unique key material and reject another session’s payload', async () => {
+  const one = await establish('hybrid');
+  const two = await establish('hybrid');
+  assert.notDeepEqual(one.aliceSecret, two.aliceSecret);
+  const payload = await encrypt(one, 'Secret');
+  await assert.rejects(decrypt(two, JSON.stringify(payload)), /different exchange/);
+  dispose(one); dispose(two);
+});
+test('missing sessions and malformed inputs fail clearly', async () => {
+  await assert.rejects(encrypt(null, 'hello'), /Establish/);
+  await assert.rejects(decrypt(null, '{}'), /Establish/);
+  await assert.rejects(establish('unknown'), /Unknown/);
+  const session = await establish('classical');
+  await assert.rejects(encrypt(session, '  '), /Enter a message/);
+  await assert.rejects(decrypt(session, 'not json'), /valid JSON/);
+  await assert.rejects(decrypt(session, 'null'), /not supported/);
+  const payload = await encrypt(session, 'hello');
+  await assert.rejects(decrypt(session, JSON.stringify({ ...payload, nonce: '!!!' })), /encoding/);
+  await assert.rejects(decrypt(session, JSON.stringify({ ...payload, nonce: 'YQ==' })), /length/);
+  dispose(session);
+});
