+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-description').value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--range-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const completed = 1 + Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      const percentage = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percentage}%`;
+      document.getElementById('setup-count').textContent = `${completed} of 3 complete · ${percentage}%`;
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const updates = document.getElementById('subscription-emails').checked;
+      status.textContent = `Your preferences: ${roastNames[Number(roast.value) - 1]} roast, delivered ${frequency.toLowerCase()}. Email: ${email.value}. Coffee emails: ${updates ? 'yes' : 'no'}. Your choices are ready to review; no subscription has been created.`;
+    });
+    updateSetup();
+  </script>
