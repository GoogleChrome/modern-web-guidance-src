+  <script>
+    (() => {
+      const progress = document.querySelector('.scroll-progress');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeScroll = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      let pending = false;
+
+      function updateProgress() {
+        pending = false;
+        if (nativeScroll && !reducedMotion.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        // Direct position updates also keep the indicator usable with reduced motion.
+        const root = document.scrollingElement || document.documentElement;
+        const scrollable = root.scrollHeight - root.clientHeight;
+        const fraction = scrollable > 0 ? root.scrollTop / scrollable : 0;
+        progress.style.transform = `scaleX(${Math.min(1, Math.max(0, fraction))})`;
+      }
+
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          requestAnimationFrame(updateProgress);
+        }
+      }
+
+      if (!nativeScroll) {
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      } else {
+        window.addEventListener('scroll', () => {
+          if (reducedMotion.matches) scheduleUpdate();
+        }, { passive: true });
+      }
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+        observer.observe(document.documentElement);
+      }
+      updateProgress();
+    })();
+  </script>
+
