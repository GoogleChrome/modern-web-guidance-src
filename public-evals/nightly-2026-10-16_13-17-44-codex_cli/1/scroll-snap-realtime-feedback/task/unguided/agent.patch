+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+    const supportsSnapEvents = 'onscrollsnapchanging' in gallery;
+    let settleTimer;
+
+    function nearestItem() {
+      const galleryBounds = gallery.getBoundingClientRect();
+      const center = galleryBounds.left + gallery.clientWidth / 2;
+      return items.reduce((nearest, item) => {
+        const distance = (element) => {
+          const bounds = element.getBoundingClientRect();
+          return Math.abs(bounds.left + bounds.width / 2 - center);
+        };
+        return distance(item) < distance(nearest) ? item : nearest;
+      });
+    }
+
+    function markPending(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.toggle('pending', items[index] === item);
+      });
+    }
+
+    function selectItem(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        const selected = items[index] === item;
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', selected);
+        if (selected) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      if (event.snapTargetInline) markPending(event.snapTargetInline);
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      if (event.snapTargetInline) selectItem(event.snapTargetInline);
+    });
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapEvents) markPending(nearestItem());
+      // Older browsers may support neither snap events nor scrollend.
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => selectItem(nearestItem()), 180);
+      }
+    }, { passive: true });
+
+    gallery.addEventListener('scrollend', () => {
+      clearTimeout(settleTimer);
+      selectItem(nearestItem());
+    });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const item = items[index];
+        const offset = item.getBoundingClientRect().left - gallery.getBoundingClientRect().left;
+        if (Math.abs(offset) < 1) {
+          selectItem(item);
+          return;
+        }
+        markPending(item);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + offset,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
+
