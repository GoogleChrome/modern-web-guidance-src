+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    let pendingFrame = null;
+    let scrollTimeout;
+
+    function closestItemIndex() {
+      // Start-aligned slides; gallery is their positioned offset parent.
+      return items.reduce((closest, item, index) =>
+        Math.abs(item.offsetLeft - gallery.scrollLeft) <
+        Math.abs(items[closest].offsetLeft - gallery.scrollLeft) ? index : closest, 0);
+    }
+
+    function markPending(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    }
+
+    function markActive(index) {
+      if (!thumbnails[index]) return;
+      cancelAnimationFrame(pendingFrame);
+      pendingFrame = null;
+      clearTimeout(scrollTimeout);
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      markPending(items.indexOf(event.snapTargetInline));
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      markActive(items.indexOf(event.snapTargetInline));
+    });
+
+    const hasSnapChanging = 'onscrollsnapchanging' in gallery;
+    const hasScrollEnd = 'onscrollend' in gallery;
+    const settle = () => markActive(closestItemIndex());
+
+    gallery.addEventListener('scroll', () => {
+      if (!hasSnapChanging && pendingFrame === null) {
+        pendingFrame = requestAnimationFrame(() => {
+          pendingFrame = null;
+          markPending(closestItemIndex());
+        });
+      }
+      if (!hasScrollEnd) {
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(settle, 160);
+      }
+    }, { passive: true });
+
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', settle);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        gallery.scrollTo({
+          left: items[index].offsetLeft,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    settle();
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('load', settle, { once: true });
+  </script>
+
