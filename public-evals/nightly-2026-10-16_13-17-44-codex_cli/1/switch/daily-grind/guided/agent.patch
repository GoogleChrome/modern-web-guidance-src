diff --git a/app.js b/app.js
new file mode 100644
index 0000000..b1e8f17
--- /dev/null
+++ b/app.js
@@ -0,0 +1,31 @@
+const toggle = document.querySelector('#dark-mode');
+const themeColor = document.querySelector('meta[name="theme-color"]');
+const status = document.querySelector('#theme-status');
+
+function applyTheme(dark, announce = false) {
+  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+  toggle.checked = dark;
+  themeColor.content = dark ? '#17251e' : '#f7f5ef';
+  if (announce) status.textContent = `${dark ? 'Dark' : 'Light'} mode enabled.`;
+}
+
+applyTheme(document.documentElement.dataset.theme === 'dark');
+toggle.addEventListener('change', () => {
+  applyTheme(toggle.checked, true);
+  try {
+    localStorage.setItem('daily-grind-theme', toggle.checked ? 'dark' : 'light');
+  } catch {
+    // The switch still works when browser storage is unavailable.
+  }
+});
+
+window.addEventListener('storage', (event) => {
+  if (event.key === 'daily-grind-theme' || event.key === null) {
+    applyTheme(event.newValue === 'dark');
+  }
+});
+
+// Keep Safari's native switch; enhance the checkbox in other browsers.
+if (!('switch' in HTMLInputElement.prototype)) {
+  import('./vendor/input-switch-polyfill/input-switch-polyfill.js');
+}
