+  <script>
+    const shop = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+    let shopTouched = false;
+
+    function updateShopError() {
+      const showError = shopTouched && !shop.validity.valid;
+      shopError.hidden = !showError;
+      if (showError) {
+        shop.setAttribute('aria-invalid', 'true');
+        shop.setAttribute('aria-describedby', shopError.id);
+      } else {
+        shop.removeAttribute('aria-invalid');
+        shop.removeAttribute('aria-describedby');
+      }
+    }
+
+    function touchShop() {
+      shopTouched = true;
+      updateShopError();
+    }
+
+    shop.addEventListener('blur', touchShop);
+    shop.addEventListener('change', touchShop);
+    shop.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      touchShop();
+      shop.focus();
+    });
+  </script>
+
