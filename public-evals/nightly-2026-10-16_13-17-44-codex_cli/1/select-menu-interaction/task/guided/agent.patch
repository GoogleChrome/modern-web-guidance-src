+  <script>
+    const shopSelect = document.querySelector('#local-shop');
+
+    // Mark an unanswered field only after interaction or a submit attempt.
+    // Native required validation still prevents submitting an empty selection.
+    const updateShopError = () => {
+      if (shopSelect.validity.valid) {
+        shopSelect.removeAttribute('aria-invalid');
+      } else {
+        shopSelect.setAttribute('aria-invalid', 'true');
+      }
+    };
+
+    shopSelect.addEventListener('blur', updateShopError);
+    shopSelect.addEventListener('change', updateShopError);
+    shopSelect.addEventListener('invalid', updateShopError);
+  </script>
