+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const listbox = document.getElementById('roast-options');
+    const options = [...listbox.querySelectorAll('[role="option"]')];
+    let selected = 0;
+
+    function closeRoasts(returnFocus = false) {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts(index = selected) {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function chooseRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      const option = options[index];
+      document.getElementById('roast-value').replaceChildren(option.querySelector('.roast-copy').cloneNode(true));
+      trigger.querySelector('.roast-icon').replaceWith(option.querySelector('svg').cloneNode(true));
+      document.getElementById('order-button').href = '/order-online?roast=' + encodeURIComponent(option.dataset.roast);
+      closeRoasts(true);
+    }
+
+    trigger.addEventListener('click', () => listbox.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => chooseRoast(index));
+      option.addEventListener('keydown', event => {
+        let next = index;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        else if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = options.length - 1;
+        else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          chooseRoast(index);
+          return;
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closeRoasts(true);
+          return;
+        } else if (event.key.length === 1 && /\S/.test(event.key)) {
+          const match = options.findIndex(item => item.querySelector('strong').textContent.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match === -1) return;
+          next = match;
+        } else return;
+        event.preventDefault();
+        options[next].focus();
+      });
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closeRoasts();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
