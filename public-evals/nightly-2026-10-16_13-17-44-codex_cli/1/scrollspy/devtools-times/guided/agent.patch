@@ -0,0 +1,139 @@
+<nav class="section-nav" aria-label="On this page">
+    <span class="section-nav-label" aria-hidden="true">On this page</span>
+    <div class="section-nav-links">
+        <a href="#latest">Latest</a>
+        <a href="#top-news">Top News</a>
+        <a href="#world">World</a>
+        <a href="#politics">Politics</a>
+    </div>
+</nav>
+
+<style>
+    .section-nav {
+        position: sticky;
+        top: 0;
+        z-index: 30;
+        display: flex;
+        align-items: center;
+        gap: 1.5rem;
+        padding-inline: clamp(1rem, 3vw, 1.5rem);
+        background: white;
+        border-bottom: 1px solid #d1d5db;
+    }
+
+    .section-nav-label {
+        flex-shrink: 0;
+        color: #6b7280;
+        font-size: 0.6875rem;
+        font-weight: 600;
+        letter-spacing: 0.08em;
+        text-transform: uppercase;
+    }
+
+    .section-nav-links {
+        display: flex;
+        gap: clamp(1rem, 4vw, 2rem);
+        overflow-x: auto;
+        scroll-target-group: auto;
+    }
+
+    .section-nav a {
+        flex-shrink: 0;
+        padding: 1rem 0 0.8125rem;
+        border-bottom: 3px solid transparent;
+        color: #4b5563;
+        font-size: 0.875rem;
+        font-weight: 600;
+        text-decoration: none;
+    }
+
+    .section-nav a:hover {
+        color: #111827;
+    }
+
+    .section-nav a:focus-visible {
+        outline: 2px solid #92400e;
+        outline-offset: -2px;
+    }
+
+    .section-nav a:is(:target-current, .is-current) {
+        color: #92400e;
+        border-bottom-color: #d97706;
+    }
+
+    @media (max-width: 420px) {
+        .section-nav-label {
+            display: none;
+        }
+    }
+</style>
+
+<script>
+    let cleanup: (() => void) | undefined;
+
+    function initSectionNav() {
+        cleanup?.();
+        const nav = document.querySelector<HTMLElement>('.section-nav');
+        if (!nav) return;
+
+        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
+        const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+        const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+            CSS.supports('selector(:target-current)');
+        let frame = 0;
+
+        function syncCurrent() {
+            let current: HTMLAnchorElement | undefined;
+            if (nativeTracking) {
+                current = links.find(link => link.matches(':target-current'));
+            } else {
+                // Keep the preceding section active through advertisements and gaps.
+                const activationLine = Math.max(nav!.getBoundingClientRect().bottom + 24, innerHeight * 0.35);
+                current = links[0];
+                sections.forEach((section, index) => {
+                    if (section && section.getBoundingClientRect().top <= activationLine) {
+                        current = links[index];
+                    }
+                });
+                if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) {
+                    current = links.at(-1);
+                }
+            }
+
+            links.forEach(link => {
+                const active = link === current;
+                if (active) link.setAttribute('aria-current', 'location');
+                else link.removeAttribute('aria-current');
+                link.classList.toggle('is-current', !nativeTracking && active);
+            });
+        }
+
+        function scheduleSync() {
+            cancelAnimationFrame(frame);
+            frame = requestAnimationFrame(syncCurrent);
+        }
+
+        // IntersectionObserver provides tracking where CSS scroll targets are unavailable.
+        const observer = !nativeTracking ? new IntersectionObserver(scheduleSync, {
+            rootMargin: '0px 0px -65% 0px',
+            threshold: [0, 1],
+        }) : undefined;
+        sections.forEach(section => { if (section) observer?.observe(section); });
+
+        document.addEventListener('scrollend', scheduleSync);
+        window.addEventListener('resize', scheduleSync);
+        window.addEventListener('hashchange', scheduleSync);
+        scheduleSync();
+
+        cleanup = () => {
+            cancelAnimationFrame(frame);
+            observer?.disconnect();
+            document.removeEventListener('scrollend', scheduleSync);
+            window.removeEventListener('resize', scheduleSync);
+            window.removeEventListener('hashchange', scheduleSync);
+        };
+    }
+
+    document.addEventListener('astro:page-load', initSectionNav);
+    document.addEventListener('astro:before-swap', () => cleanup?.());
+</script>
