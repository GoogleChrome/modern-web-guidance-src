+  <script>
+    const navigation = document.querySelector('nav');
+    const links = [...navigation.querySelectorAll('a:not(.logout-link)')];
+    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
+    const pageLink = links.find((link) => {
+      const path = new URL(link.href).pathname;
+      return currentPath === path || currentPath.startsWith(`${path}/`);
+    });
+
+    function highlightLink(activeLink, current = 'page') {
+      links.forEach((link) => {
+        if (link === activeLink) {
+          link.setAttribute('aria-current', current);
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    highlightLink(pageLink);
+
+    // On the landing page, follow content visible below the sticky navigation.
+    if (currentPath === '/' || currentPath === '/index.html') {
+      const sections = [...document.querySelectorAll('section[data-nav]')];
+      let scheduled = false;
+
+      function updateVisibleSection() {
+        scheduled = false;
+        const contentTop = navigation.getBoundingClientRect().bottom;
+        let activeSection;
+        let largestVisibleHeight = 0;
+
+        sections.forEach((section) => {
+          const bounds = section.getBoundingClientRect();
+          const visibleHeight = Math.max(0,
+            Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, contentTop));
+          if (visibleHeight > largestVisibleHeight) {
+            largestVisibleHeight = visibleHeight;
+            activeSection = section;
+          }
+        });
+
+        const activeLink = activeSection && links.find((link) =>
+          new URL(link.href).pathname === activeSection.dataset.nav);
+        highlightLink(activeLink, 'location');
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          requestAnimationFrame(updateVisibleSection);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      updateVisibleSection();
+    }
+  </script>
 </body>
 
