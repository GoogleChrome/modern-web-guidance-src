+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function setCurrent(currentLink) {
+      links.forEach(link => {
+        const active = link === currentLink;
+        link.classList.toggle('is-current', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function syncNativeCurrent() {
+      setCurrent(nav.querySelector('a:target-current'));
+    }
+
+    let observer;
+    function observeSections() {
+      const navHeight = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navHeight}px`);
+      if (nativeTracking) {
+        syncNativeCurrent();
+        return;
+      }
+
+      observer?.disconnect();
+      const visible = new Map();
+      observer = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          if (entry.isIntersecting) visible.set(entry.target, entry.intersectionRatio);
+          else visible.delete(entry.target);
+        });
+        const current = sections.reduce((best, section) =>
+          (visible.get(section) ?? 0) > (visible.get(best) ?? 0) ? section : best, null);
+        setCurrent(links[sections.indexOf(current)]);
+      }, {
+        rootMargin: `-${navHeight}px 0px 0px 0px`,
+        threshold: Array.from({ length: 21 }, (_, index) => index / 20)
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    new ResizeObserver(observeSections).observe(nav);
+    if (nativeTracking) {
+      // Native CSS handles the highlight; mirror its state for assistive technology.
+      document.addEventListener('scrollend', syncNativeCurrent);
+      window.addEventListener('hashchange', () => requestAnimationFrame(syncNativeCurrent));
+      window.addEventListener('pageshow', syncNativeCurrent);
+    }
+    observeSections();
+  </script>
+
