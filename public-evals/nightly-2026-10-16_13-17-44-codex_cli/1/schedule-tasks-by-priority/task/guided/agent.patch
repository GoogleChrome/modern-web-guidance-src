+<script>
+    (() => {
+      const definitions = {
+        checkout: { label: 'Checkout', priority: 'user-blocking', rank: 0, budget: 360, urgency: 'Urgent' },
+        menu: { label: 'Menu update', priority: 'user-visible', rank: 1, budget: 600, urgency: 'Standard' },
+        telemetry: { label: 'Telemetry logging', priority: 'background', rank: 2, budget: 900, urgency: 'Background' }
+      };
+      const queue = [];
+      let sequence = 0;
+      let completed = 0;
+      let pumping = false;
+      let previousTask = null;
+      let hasActivity = false;
+      const status = document.getElementById('queue-status');
+      const list = document.getElementById('task-list');
+      const log = document.getElementById('activity-log');
+      const pendingCount = document.getElementById('pending-count');
+      const completedCount = document.getElementById('completed-count');
+      const empty = document.getElementById('queue-empty');
+      const compare = (a, b) => a.rank - b.rank || a.id - b.id;
+
+      function record(message) {
+        if (!hasActivity) { log.replaceChildren(); hasActivity = true; }
+        const entry = document.createElement('li');
+        entry.textContent = `${new Date().toLocaleTimeString()} · ${message}`;
+        log.prepend(entry);
+        while (log.children.length > 50) log.lastElementChild.remove();
+      }
+
+      function render() {
+        queue.sort(compare);
+        pendingCount.textContent = queue.length;
+        completedCount.textContent = completed;
+        empty.hidden = queue.length > 0;
+        empty.textContent = completed ? 'All caught up. Every task has been completed.' : 'The counter is clear. Choose a task to get started.';
+        status.textContent = queue.length ? `Running · ${queue[0].label} #${queue[0].id}` : completed ? 'All tasks complete' : 'Ready to run';
+        status.dataset.active = String(queue.length > 0);
+        list.replaceChildren(...queue.map((task, index) => {
+          const row = document.createElement('li');
+          row.className = 'task-row';
+          const heading = document.createElement('div');
+          heading.className = 'task-heading';
+          const name = document.createElement('strong');
+          name.textContent = `${task.label} #${task.id}`;
+          const meta = document.createElement('span');
+          meta.className = 'task-meta';
+          meta.textContent = `${task.urgency} · ${index === 0 ? 'Running' : task.work > 0 ? 'Paused' : 'Queued'} · ${Math.floor(task.work / task.budget * 100)}%`;
+          const progress = document.createElement('progress');
+          progress.max = task.budget;
+          progress.value = task.work;
+          progress.setAttribute('aria-label', `${task.label} #${task.id} progress`);
+          heading.append(name, meta);
+          row.append(heading, progress);
+          return row;
+        }));
+      }
+
+      // The local queue also provides priority scheduling in browsers without postTask.
+      // Select the next task inside the callback so newly arrived urgent work wins.
+      function scheduleChunk(callback) {
+        if (typeof globalThis.scheduler?.postTask === 'function') {
+          return globalThis.scheduler.postTask(callback, { priority: queue[0].priority });
+        }
+        return new Promise((resolve, reject) => setTimeout(() => {
+          try { resolve(callback()); } catch (error) { reject(error); }
+        }, 0));
+      }
+
+      function yieldToBrowser() {
+        return typeof globalThis.scheduler?.yield === 'function'
+          ? globalThis.scheduler.yield()
+          : new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      async function runQueue() {
+        if (pumping) return;
+        pumping = true;
+        try {
+          while (queue.length) {
+            queue.sort(compare);
+            await scheduleChunk(() => {
+              queue.sort(compare);
+              const task = queue[0];
+              if (task !== previousTask) {
+                if (previousTask && queue.includes(previousTask)) record(`Paused ${previousTask.label} #${previousTask.id} for urgent work`);
+                record(`${task.work ? 'Resumed' : 'Started'} ${task.label} #${task.id} (${task.urgency.toLowerCase()})`);
+                previousTask = task;
+              }
+              // Simulated CPU work stays within a 6ms slice, well below a long task.
+              const start = performance.now();
+              const deadline = start + Math.min(6, task.budget - task.work);
+              while (performance.now() < deadline) {
+                task.checksum = (task.checksum * 1664525 + 1013904223) >>> 0;
+              }
+              task.work = Math.min(task.budget, task.work + performance.now() - start);
+              if (task.work >= task.budget) {
+                queue.shift();
+                completed++;
+                previousTask = null;
+                record(`Completed ${task.label} #${task.id}`);
+              }
+              render();
+            });
+            await yieldToBrowser();
+          }
+        } catch (error) {
+          record('Queue interrupted. Add a task to retry pending work.');
+          status.textContent = 'Queue interrupted';
+          console.error('Operations queue failed:', error);
+        } finally {
+          pumping = false;
+        }
+      }
+
+      function enqueue(kinds) {
+        for (const kind of kinds) {
+          const task = { ...definitions[kind], id: ++sequence, work: 0, checksum: 1 };
+          queue.push(task);
+          record(`Queued ${task.label} #${task.id}`);
+        }
+        render();
+        void runQueue();
+      }
+
+      document.querySelectorAll('.operation-button').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.kind]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        enqueue(['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu']);
+      });
+    })();
+  </script>
 </body>
 
