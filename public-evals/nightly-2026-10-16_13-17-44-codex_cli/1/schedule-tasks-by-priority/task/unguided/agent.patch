+  <script>
+    (() => {
+      const types = {
+        checkout: { name: 'Checkout', priority: 0, label: 'Urgent', slices: 35 },
+        menu: { name: 'Menu update', priority: 1, label: 'Standard', slices: 65 },
+        telemetry: { name: 'Telemetry log', priority: 2, label: 'Background', slices: 95 }
+      };
+      const queue = [];
+      let sequence = 0, completed = 0, scheduled = false, activeId = null;
+      const queueEl = document.getElementById('task-queue');
+      const logEl = document.getElementById('activity-log');
+      const statusEl = document.getElementById('queue-status');
+      function log(message) {
+        if (!logEl.querySelector('.activity-entry')) logEl.replaceChildren();
+        const entry = document.createElement('li');
+        entry.className = 'activity-entry';
+        const time = document.createElement('time');
+        time.dateTime = new Date().toISOString();
+        time.textContent = new Date().toLocaleTimeString([], { hour12: false });
+        const text = document.createElement('span');
+        text.textContent = message;
+        entry.append(time, text);
+        logEl.prepend(entry);
+        while (logEl.children.length > 60) logEl.lastElementChild.remove();
+      }
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} pending`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        if (!queue.length) {
+          queueEl.innerHTML = '<div class="empty-state"><div class="empty-symbol" aria-hidden="true">✓</div><strong>All caught up</strong><p>Every task served. Ready for the next rush.</p></div>';
+          statusEl.textContent = 'UI responsive · Queue idle';
+          return;
+        }
+        queueEl.innerHTML = queue.map((task, index) => {
+          const progress = Math.round(task.done / task.slices * 100);
+          const state = index === 0 ? 'Running' : task.done ? 'Paused for higher priority' : 'Waiting';
+          return `<div class="queue-item"><div class="queue-item-top"><span class="queue-item-name">${task.name} <span style="color:#a99b8f">#${task.id}</span></span><span class="priority-tag priority-${task.priority}">${task.label}</span></div><div class="queue-item-status"><span>${state}</span><span>${progress}%</span></div><div class="progress-track" role="progressbar" aria-label="${task.name} ${task.id}" aria-valuenow="${progress}" aria-valuemin="0" aria-valuemax="100"><div class="progress-fill" style="width:${progress}%"></div></div></div>`;
+        }).join('');
+      }
+      function schedule() {
+        if (scheduled) return;
+        scheduled = true;
+        setTimeout(runSlice, 24);
+      }
+      function addTasks(keys) {
+        for (const key of keys) {
+          const task = { ...types[key], id: ++sequence, done: 0 };
+          queue.push(task);
+          log(`${task.name} #${task.id} queued · ${task.label.toLowerCase()}`);
+        }
+        // FIFO within each priority; reselect after every short slice.
+        queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+        render();
+        schedule();
+      }
+      function runSlice() {
+        scheduled = false;
+        if (!queue.length) return;
+        const task = queue[0];
+        if (activeId !== task.id) {
+          if (activeId !== null && queue.some(item => item.id === activeId)) {
+            log(`Task #${activeId} paused for ${task.label.toLowerCase()} work`);
+          }
+          log(`${task.name} #${task.id} ${task.done ? 'resumed' : 'started'}`);
+          activeId = task.id;
+          statusEl.textContent = `UI responsive · Running ${task.name.toLowerCase()}`;
+        }
+        // Simulate CPU work for at most 4ms, then release the main thread
+        // for input, rendering, and any newly queued urgent operations.
+        const deadline = performance.now() + 4;
+        while (performance.now() < deadline) Math.sqrt(Math.random() * 10000);
+        task.done++;
+        if (task.done >= task.slices) {
+          queue.shift();
+          completed++;
+          activeId = null;
+          log(`${task.name} #${task.id} completed`);
+        }
+        render();
+        if (queue.length) schedule();
+      }
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => addTasks([button.dataset.task]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        log('Mixed batch added · 6 tasks');
+        addTasks(['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu']);
+      });
+    })();
+  </script>
+
