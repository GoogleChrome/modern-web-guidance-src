+  <script>
+    const accordionToggle = document.getElementById('accordion-toggle');
+    const accordionContent = document.getElementById('sourcing-content');
+
+    // Keep the fallback's natural block size current as text or available space changes.
+    if (!CSS.supports('block-size', 'calc-size(auto, size + 2rem)')) {
+      const sourcingCopy = accordionContent.querySelector('.sourcing-copy');
+      const updateContentSize = () => {
+        accordionContent.style.setProperty('--sourcing-content-size', getComputedStyle(sourcingCopy).blockSize);
+      };
+      updateContentSize();
+      new ResizeObserver(updateContentSize).observe(sourcingCopy);
+    }
+
+    accordionToggle.addEventListener('click', () => {
+      const expanded = accordionToggle.getAttribute('aria-expanded') !== 'true';
+      accordionToggle.setAttribute('aria-expanded', String(expanded));
+      accordionContent.setAttribute('aria-hidden', String(!expanded));
+      accordionContent.inert = !expanded;
+      accordionContent.classList.toggle('is-expanded', expanded);
+    });
+  </script>
+
