+<script>
+  // Readiness contract: the SDK must dispatch `experiment:ready` after its
+  // DOM updates finish, or resolve window.folioExperimentReady (a Promise).
+  // Loading the script alone does not mean an asynchronous variant is ready.
+  (() => {
+    const root = document.querySelector('[data-experiment-root]');
+    let settled = false;
+    let deadline;
+    let sdk;
+    const controller = new AbortController();
+    function reveal() {
+      if (settled) return;
+      settled = true;
+      clearTimeout(deadline);
+      root.setAttribute('aria-busy', 'false');
+      document.documentElement.classList.remove('experiment-pending');
+    }
+    function fallback() {
+      if (settled) return;
+      // Replace the controlled region before revealing; never expose baseline.
+      // Remove it from the SDK's reach so late changes cannot flash a variant.
+      const replacement = document.createElement('div');
+      replacement.dataset.experimentState = 'fallback';
+      replacement.innerHTML = '<h1>A little less scattered.<br><em>A lot more you.</em></h1><p class="description">Your notes, projects, and next big thing.<br>All together in a workspace that feels like a deep breath.</p><button class="primary" data-signup>Find your flow <span class="arrow">↗</span></button>';
+      replacement.setAttribute('aria-busy', 'false');
+      root.replaceWith(replacement);
+      controller.abort();
+      if (sdk) sdk.remove();
+      reveal();
+    }
+    window.addEventListener('experiment:ready', reveal, { once: true, signal: controller.signal });
+    deadline = setTimeout(fallback, 3500);
+    sdk = document.createElement('script');
+    sdk.src = 'https://cdn.example.com/experiment-sdk.js';
+    sdk.async = true;
+    sdk.onerror = fallback;
+    sdk.onload = () => {
+      if (window.folioExperimentReady && typeof window.folioExperimentReady.then === 'function') {
+        window.folioExperimentReady.then(reveal, fallback);
+      }
+    };
+    document.head.appendChild(sdk);
+  })();
+  const modal = document.getElementById('signup');
+  document.addEventListener('click', event => {
+    if (event.target.closest('[data-signup]')) { event.preventDefault(); modal.showModal(); }
+  });
+  modal.querySelector('.close').addEventListener('click', () => modal.close());
+  modal.addEventListener('click', event => { if (event.target === modal) { const r=modal.getBoundingClientRect(); if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom) modal.close(); } });
+  document.getElementById('signup-form').addEventListener('submit', event => {
