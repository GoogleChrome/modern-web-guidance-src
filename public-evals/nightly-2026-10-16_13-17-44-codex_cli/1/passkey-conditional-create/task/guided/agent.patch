+  <script type="module">
+    // Load compatibility helpers without delaying or preventing password sign-in.
+    const webauthnReady = import('./node_modules/webauthn-polyfills/esm/index.js')
+      .catch(() => {});
+
+    async function promotePasskey() {
+      try {
+        await webauthnReady;
+        if (!window.PublicKeyCredential ||
+            typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+            !navigator.credentials?.create) return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        // Never fall back to an interactive registration ceremony.
+        if (capabilities.conditionalCreate !== true) return;
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const options = await optionsResponse.json();
+        // Preserve server-provided excludeCredentials to prevent duplicates.
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options.publicKey ?? options);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const registration = credential.toJSON();
+        try {
+          // The authenticated server must bind the conditional ceremony to the
+          // session and relax UP/UV checks only for this automatic registration.
+          const verification = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ ...registration, conditional: true })
+          });
+          if (!verification.ok) throw new Error('Registration rejected');
+          if (verification.status !== 204) {
+            const result = await verification.json();
+            if (result.verified === false || result.success === false) {
+              throw new Error('Registration rejected');
+            }
+          }
+        } catch {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id ?? window.location.hostname,
+              credentialId: registration.id
+            });
+          }
+        }
+      } catch {
+        // Promotion is best effort: unsupported providers, cancellation, and
+        // network or verification failures must never affect sign-in or its UI.
+      }
+    }
+
+    const form = document.querySelector('#signin-form');
+    const button = form.querySelector('[data-testid="signin-button"]');
+    const status = document.querySelector('#signin-status');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (button.disabled) return;
+      button.disabled = true;
+      status.textContent = 'Signing in…';
+      try {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: form.elements.username.value,
+            password: form.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+        const result = await response.json();
+        // /api/login must return success only after all required factors finish.
+        if (result.success !== true) throw new Error('Sign-in failed');
+
+        status.textContent = 'You’re signed in. Welcome back!';
+        form.elements.password.value = '';
+        form.hidden = true;
+        void promotePasskey();
+      } catch {
+        status.textContent = 'Unable to sign in. Check your details and try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
