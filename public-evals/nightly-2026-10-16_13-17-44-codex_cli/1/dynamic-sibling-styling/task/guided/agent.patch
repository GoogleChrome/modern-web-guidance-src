+  <script>
+    // Native sibling functions react to DOM changes without JavaScript.
+    // Older browsers receive the same live index/count values via custom properties.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach(group => {
+        const updateSiblings = () => {
+          Array.from(group.children).forEach((item, index) => {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', group.children.length);
+          });
+        };
+        updateSiblings();
+        new MutationObserver(updateSiblings).observe(group, { childList: true });
+      });
+    }
+  </script>
