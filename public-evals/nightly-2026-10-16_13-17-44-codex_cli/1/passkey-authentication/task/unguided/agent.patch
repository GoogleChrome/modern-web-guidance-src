+  <script>
+    const form = document.querySelector('#sign-in-form');
+    const username = document.querySelector('[data-testid="username-field"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let explicitSignIn = false;
+    let authenticated = false;
+
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+      return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function serializeCredential(credential) {
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        clientExtensionResults: credential.getClientExtensionResults(),
+        response: {
+          clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+          authenticatorData: encodeBase64url(credential.response.authenticatorData),
+          signature: encodeBase64url(credential.response.signature),
+          userHandle: credential.response.userHandle === null
+            ? null : encodeBase64url(credential.response.userHandle)
+        }
+      };
+    }
+
+    async function signIn(conditional) {
+      if (authenticated || (conditional && (activeRequest || explicitSignIn))) return;
+      // Stop autofill before opening an explicit authentication prompt.
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+
+      try {
+        // This endpoint must issue a fresh challenge tied to the user's session.
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal: controller.signal
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = { ...(options.publicKey || options) };
+        publicKey.challenge = decodeBase64url(publicKey.challenge);
+        if (conditional) {
+          // An empty allow-list lets the browser offer any registered discoverable passkey.
+          publicKey.allowCredentials = [];
+        } else if (publicKey.allowCredentials) {
+          publicKey.allowCredentials = publicKey.allowCredentials.map(credential => ({
+            ...credential,
+            id: decodeBase64url(credential.id)
+          }));
+        }
+        publicKey.userVerification = 'required';
+        if (controller.signal.aborted) return;
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal: controller.signal
+        });
+        if (!credential || controller.signal.aborted) return;
+
+        authButton.disabled = true;
+        authStatus.textContent = 'Verifying your passkey…';
+        const verification = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(serializeCredential(credential)),
+          signal: controller.signal
+        });
+        if (!verification.ok) throw new Error('Passkey verification failed. Please try again.');
+        const result = await verification.json();
+        if (result.success === false || result.verified === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        if (controller.signal.aborted) return;
+        authenticated = true;
+        authStatus.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (controller.signal.aborted || error.name === 'AbortError') return;
+        if (!conditional || error.name !== 'NotAllowedError') {
+          authStatus.textContent = error.name === 'NotAllowedError'
+            ? 'Passkey sign-in was canceled or timed out. Please try again.'
+            : 'Unable to sign in. ' + error.message;
+        }
+      } finally {
+        if (activeRequest === controller) {
+          activeRequest = undefined;
+          authButton.disabled = authenticated;
+        }
+      }
+    }
+
+    async function startAutofill() {
+      if (typeof window.PublicKeyCredential?.isConditionalMediationAvailable !== 'function') return;
+      try {
+        if (await PublicKeyCredential.isConditionalMediationAvailable()) await signIn(true);
+      } catch {
+        // Explicit passkey sign-in remains available if autofill is unsupported.
+      }
+    }
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (explicitSignIn || authenticated || authButton.disabled) return;
+      explicitSignIn = true;
+      authButton.disabled = true;
+      authStatus.textContent = 'Use your device to confirm your passkey.';
+      try {
+        await signIn(false);
+      } finally {
+        explicitSignIn = false;
+        if (!authenticated) void startAutofill();
+      }
+    });
+
+    if (window.PublicKeyCredential && navigator.credentials) {
+      username.addEventListener('focus', startAutofill);
+      void startAutofill();
+    } else {
+      authButton.disabled = true;
+      authStatus.textContent = 'Passkey sign-in is not supported in this browser.';
+    }
+  </script>
+
 </body>
 
