+  <script type="module">
+    const form = document.querySelector('#signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let authenticated = false;
+    let explicitPending = false;
+
+    const supported = window.isSecureContext && !!window.PublicKeyCredential && !!navigator.credentials?.get;
+    // Bundle the installed polyfill locally so sign-in does not depend on a CDN.
+    const ready = supported
+      ? import('/assets/webauthn-polyfills.js')
+      : Promise.resolve();
+    // Keep initialization errors handled even before the first interaction.
+    ready.catch(() => {
+      status.textContent = 'Passkey sign-in could not be initialized. Please reload and try again.';
+    });
+
+    async function authenticate(conditional) {
+      if (authenticated || (conditional && explicitPending)) return;
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+
+      try {
+        await ready;
+        if (conditional) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities.conditionalGet) return;
+        }
+        if (controller.signal.aborted) return;
+
+        // The server must generate and retain the challenge in the login session.
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal: controller.signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+        // Discoverable credentials let the browser offer registered accounts.
+        publicKey.allowCredentials = [];
+        if (controller.signal.aborted) return;
+
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: controller.signal,
+            ...(conditional ? { mediation: 'conditional' } : {}),
+          });
+        } catch (error) {
+          if (error.name === 'AbortError') return;
+          if (error.name === 'NotAllowedError') {
+            if (!conditional) status.textContent = 'Passkey sign-in was cancelled or timed out. Please try again.';
+            return;
+          }
+          throw error;
+        }
+        if (!credential || controller.signal.aborted) return;
+
+        status.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+          signal: controller.signal,
+        });
+        if (!response.ok) {
+          if (response.status === 404 && !authenticated && PublicKeyCredential.signalUnknownCredential) {
+            // Only an explicit unknown-credential response may remove a stale suggestion.
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId || location.hostname,
+                credentialId: encoded.id,
+              });
+            } catch { /* Synchronization is optional; preserve the sign-in error. */ }
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        if (controller.signal.aborted) return;
+        authenticated = true;
+        button.disabled = true;
+        status.textContent = 'Successfully signed in with your passkey.';
+      } catch (error) {
+        if (controller.signal.aborted || error.name === 'AbortError') return;
+        status.textContent = error.message || 'Unable to sign in with a passkey. Please try again.';
+      } finally {
+        if (activeRequest === controller) activeRequest = undefined;
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!supported || authenticated || explicitPending) return;
+      explicitPending = true;
+      button.disabled = true;
+      status.textContent = 'Follow your device’s instructions to sign in.';
+      // authenticate() cancels autofill before opening the explicit passkey prompt.
+      try {
+        await authenticate(false);
+      } finally {
+        explicitPending = false;
+        button.disabled = authenticated;
+        if (!authenticated) void authenticate(true);
+      }
+    });
+
+    if (supported) {
+      void authenticate(true);
+    } else {
+      button.disabled = true;
+      status.textContent = 'Passkey sign-in requires a supported browser and a secure connection.';
+    }
+  </script>
