+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation" autofocus>&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary">Cancel</button>
+      <a href="/logout" id="confirm-logout-btn" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" popover="manual" aria-labelledby="ordering-title" hidden>
+    <button type="button" id="close-notice-btn" class="overlay-close" aria-label="Dismiss ordering notice">&times;</button>
+    <h2 id="ordering-title">Ordering update</h2>
+    <p role="status" id="ordering-status"></p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('ordering-notice');
+    const noticeStatus = document.getElementById('ordering-status');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep overlays open while CSS exits finish, including in browsers that
+    // cannot transition display or retain the native top layer during an exit.
+    const closing = new WeakMap();
+    function closeOverlay(element, finish) {
+      if (closing.has(element)) return closing.get(element);
+      element.setAttribute('data-closing', '');
+      const done = (async () => {
+        const animations = element.getAnimations({ subtree: true });
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => setTimeout(resolve, 500))
+        ]);
+        finish();
+        element.removeAttribute('data-closing');
+        closing.delete(element);
+      })();
+      closing.set(element, done);
+      return done;
+    }
+
+    const closeDialog = () => closeOverlay(logoutDialog, () => logoutDialog.close());
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+    document.getElementById('confirm-logout-btn').addEventListener('click', async event => {
+      event.preventDefault();
+      await closeDialog();
+      window.location.assign(logoutLink.href);
+    });
+
+    function dismissNotice() {
+      return closeOverlay(notice, () => {
+        const focusWasInside = notice.contains(document.activeElement);
+        if (hasPopover) notice.hidePopover();
+        notice.removeAttribute('data-visible');
+        notice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+        noticeStatus.textContent = '';
+        if (focusWasInside) orderButton.focus();
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      if (closing.has(notice)) return;
+      if (!notice.hidden) {
+        dismissNotice();
+        return;
+      }
+      notice.hidden = false;
+      if (hasPopover) notice.showPopover();
+      else notice.setAttribute('data-visible', '');
+      orderButton.setAttribute('aria-expanded', 'true');
+      noticeStatus.textContent = 'online ordering is currently offline';
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !notice.hidden && !logoutDialog.open) {
+        event.preventDefault();
+        dismissNotice();
+      }
+    });
+    document.addEventListener('click', event => {
+      if (!notice.hidden && !notice.contains(event.target) && !orderButton.contains(event.target)) {
+        dismissNotice();
+      }
+    });
+  </script>
+
