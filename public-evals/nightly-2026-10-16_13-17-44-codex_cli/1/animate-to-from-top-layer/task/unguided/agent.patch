+  <dialog id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout" autofocus>Cancel</button>
+      <button type="button" class="btn" id="confirm-logout">Log out</button>
+    </div>
+  </dialog>
+
+  <aside id="order-notice" class="order-notice" aria-label="Ordering information" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" id="dismiss-notice" class="close-button" aria-label="Dismiss ordering information">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('order-notice');
+
+    // Keep elements visible until their CSS exit animations have finished.
+    async function animateOut(element, finish) {
+      if (element.classList.contains('is-closing')) return;
+      element.classList.add('is-closing');
+      await Promise.allSettled(element.getAnimations().map(animation => animation.finished));
+      finish();
+      element.classList.remove('is-closing');
+    }
+
+    function closeDialog(logout = false) {
+      animateOut(dialog, () => {
+        dialog.close();
+        if (logout) window.location.assign(logoutLink.href);
+      });
+    }
+
+    function dismissNotice() {
+      if (notice.hidden) return;
+      if (notice.contains(document.activeElement)) orderButton.focus();
+      notice.inert = true;
+      orderButton.setAttribute('aria-expanded', 'false');
+      animateOut(notice, () => { notice.hidden = true; });
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (!dialog.open) dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeDialog());
+    document.getElementById('cancel-logout').addEventListener('click', () => closeDialog());
+    document.getElementById('confirm-logout').addEventListener('click', () => closeDialog(true));
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDialog();
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (notice.classList.contains('is-closing')) return;
+      if (!notice.hidden) return dismissNotice();
+      notice.inert = false;
+      notice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('dismiss-notice').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !dialog.open) dismissNotice();
+    });
+  </script>
+
