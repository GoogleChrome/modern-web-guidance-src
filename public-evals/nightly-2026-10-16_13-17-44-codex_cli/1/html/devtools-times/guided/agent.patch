diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..2d4939b
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,55 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+  opener: HTMLButtonElement | null;
+}
+
+export default function Modal({ id, title, onClose, children, opener }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+  const startedOnBackdrop = useRef(false);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    const invoker = opener ?? document.activeElement;
+    // Set the native autofocus target before showModal, avoiding React's mount-time focus.
+    dialog.querySelector<HTMLElement>('[data-initial-focus]')?.setAttribute('autofocus', '');
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (invoker instanceof HTMLElement && invoker.isConnected) invoker.focus();
+    };
+  }, [opener]);
+
+  const outside = (event: React.PointerEvent<HTMLDialogElement> | React.MouseEvent<HTMLDialogElement>) => {
+    const rect = event.currentTarget.getBoundingClientRect();
+    return event.target === event.currentTarget &&
+      (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom);
+  };
+
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} {...{ closedby: 'any' }}
+      className="app-dialog bg-white text-gray-900 shadow-xl"
+      onClose={onClose}
+      onPointerDown={event => { startedOnBackdrop.current = outside(event); }}
+      onClick={event => {
+        // Preserve light-dismiss on browsers without closedby, but never dismiss a drag from inside.
+        if (!('closedBy' in event.currentTarget) && startedOnBackdrop.current && outside(event)) ref.current?.close();
+      }}>
+      <header className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <form method="dialog">
+          <button type="submit" aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700">
+            <svg aria-hidden="true" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" d="M6 18 18 6M6 6l12 12" />
+            </svg>
+          </button>
+        </form>
+      </header>
+      {children}
+    </dialog>
+  );
+}
