+import type { HTMLAttributes } from 'astro/types';
+
+interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> {
+  src: ImageMetadata | string;
+  alt: string;
+  width: number;
+  height: number;
+  widths: number[];
+  sizes: string;
+  format?: 'webp';
+  quality?: number;
+}
+
+const { src, width, height, widths, sizes, format = 'webp', quality, ...attributes } = Astro.props;
+const image = await getImage({ src, width, height, widths, sizes, format, quality });
+---
+<img {...image.attributes} {...attributes} src={image.src} srcset={image.srcSet.attribute} sizes={sizes} />
