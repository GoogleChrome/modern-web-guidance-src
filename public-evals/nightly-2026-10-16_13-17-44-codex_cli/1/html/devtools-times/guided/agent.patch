diff --git a/src/components/BottomNav.astro b/src/components/BottomNav.astro
new file mode 100644
index 0000000..346e2c4
--- /dev/null
+++ b/src/components/BottomNav.astro
@@ -0,0 +1,88 @@
+---
+import type { CollectionEntry } from 'astro:content';
+interface Props {
+  categories: string[];
+  articles: CollectionEntry<'articles'>[];
+  reports: CollectionEntry<'reports'>[];
+  multimedia: CollectionEntry<'multimedia'>[];
+}
+const { categories, articles, reports, multimedia } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+const groups = {
+  'News & Politics': ['news', 'national', 'politics', 'economy', 'labor', 'business'],
+  'Arts & Culture': ['culture', 'media'],
+  'Science & Tech': ['science'],
+  'Lifestyle & Sports': ['lifestyle', 'sports', 'urban development', 'pets'],
+};
+const topStories = [...articles].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
+---
+<nav aria-label="Sections" class="section-nav border-y border-gray-900">
+  <ul class="container mx-auto px-4 flex justify-start md:justify-center items-center text-sm font-semibold gap-6 h-10 overflow-x-auto">
+    {Object.entries(groups).map(([name, members], index) => {
+      const id = `section-popover-${index}`;
+      const sections = categories.filter(category => members.includes(category.toLowerCase()));
+      const groupReports = reports.filter(report => report.data.category === name);
+      const groupMedia = multimedia.filter(item => item.data.category === name);
+      return (
+        <li>
+          <button type="button" popovertarget={id} aria-controls={id} class="flex items-center gap-1 hover:text-gray-600 whitespace-nowrap">
+            {name}
+            <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
+              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
+            </svg>
+          </button>
+          <div id={id} popover="auto" class="section-popover bg-white border border-gray-300 shadow-lg p-6" aria-label={name}>
+            <div class="flex justify-end mb-3">
+              <button type="button" popovertarget={id} popovertargetaction="hide" aria-label={`Close ${name} sections`} class="p-2 underline">Close</button>
+            </div>
+            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
+              <div>
+                <h2 class="text-xs uppercase tracking-wider text-gray-600 mb-3">Sections</h2>
+                <ul class="space-y-2">
+                  {sections.map(category => <li><a href={`${baseUrl}category/${encodeURIComponent(category.toLowerCase())}`} class="hover:underline capitalize">{category}</a></li>)}
+                </ul>
+              </div>
+              <div>
+                <h2 class="text-xs uppercase tracking-wider text-gray-600 mb-3">Top stories</h2>
+                <ul class="space-y-2">
+                  {topStories.map(article => <li><a href={`${baseUrl}articles/${article.id}`} class="hover:underline">{article.data.title}</a></li>)}
+                </ul>
+              </div>
+              <div>
+                <h2 class="text-xs uppercase tracking-wider text-gray-600 mb-3">Reports</h2>
+                <ul class="space-y-2">
+                  {groupReports.map(report => <li><a href={`${baseUrl}reports#${report.id}`} class="hover:underline">{report.data.title}</a></li>)}
+                  <li><a href={`${baseUrl}reports`} class="hover:underline">See all reports</a></li>
+                </ul>
+              </div>
+              <div>
+                <h2 class="text-xs uppercase tracking-wider text-gray-600 mb-3">Multimedia</h2>
+                <ul class="space-y-2">
+                  {groupMedia.map(item => <li><a href={`${baseUrl}multimedia#${item.id}`} class="hover:underline">{item.data.title}</a></li>)}
+                  <li><a href={`${baseUrl}multimedia`} class="hover:underline">See all multimedia</a></li>
+                </ul>
+              </div>
+            </div>
+          </div>
+        </li>
+      );
+    })}
+  </ul>
+</nav>
+<script>
+  // Native popovers supply Escape, light-dismiss, focus order, and expanded state.
+  if (!('popover' in HTMLElement.prototype)) {
+    import('@oddbird/popover-polyfill');
+  }
+
+  function positionMenus() {
+    document.querySelectorAll<HTMLElement>('.section-nav').forEach(nav => {
+      const top = Math.max(8, nav.getBoundingClientRect().bottom);
+      nav.style.setProperty('--popover-top', `${top}px`);
+    });
+  }
+  document.addEventListener('beforetoggle', positionMenus, true);
+  document.addEventListener('astro:page-load', positionMenus);
+  window.addEventListener('resize', positionMenus);
+  window.addEventListener('scroll', positionMenus, { passive: true });
+</script>
