+}
+
+.skip-link {
+  position: fixed;
+  top: 0.5rem;
+  left: 0.5rem;
+  padding: 0.75rem 1rem;
+  background: white;
+  color: #111827;
+  z-index: 100;
+  transform: translateY(-200%);
+}
+.skip-link:focus { transform: translateY(0); }
+
+.app-dialog {
+  width: min(42rem, calc(100% - 2rem));
+  max-height: calc(100dvh - 2rem);
+  margin: auto;
+  padding: 0;
+  border: 0;
+  overflow: auto;
+}
+.app-dialog::backdrop {
+  background: rgb(17 24 39 / 45%);
+}
+html:has(.app-dialog[open]) { overflow: hidden; }
+
+.section-popover {
+  position: fixed;
+  inset: var(--popover-top, 12rem) 1rem auto;
+  width: min(72rem, calc(100% - 2rem));
+  max-height: calc(100dvh - var(--popover-top, 12rem) - 1rem);
+  margin: 0 auto;
+  overflow: auto;
+  font-weight: 400;
+}
+/* Keep the polyfill's open-state selector valid in browsers without :popover-open. */
+.section-popover:not(:is(:popover-open, .\:popover-open)) { display: none; }
+.section-popover:is(:popover-open, .\:popover-open) { display: block; }
