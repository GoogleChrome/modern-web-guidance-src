diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..1336d50
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,44 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+  restoreFocusTo?: HTMLElement | null;
+}
+
+/** Native modal behavior supplies inert background content and keyboard focus containment. */
+export default function Modal({ id, title, onClose, children, restoreFocusTo }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    const opener = restoreFocusTo ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
+    dialog.showModal();
+    dialog.querySelector<HTMLElement>('[data-autofocus]')?.focus();
+    return () => {
+      dialog.close();
+      if (opener?.isConnected) opener.focus({ preventScroll: true });
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} className="overlay-dialog bg-white shadow-xl w-full max-w-2xl"
+      onClose={onClose}
+      onClick={event => {
+        if (event.target === event.currentTarget) {
+          const bounds = event.currentTarget.getBoundingClientRect();
+          if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+            event.currentTarget.close();
+          }
+        }
+      }}>
+      <header className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <button type="button" aria-label={`Close ${title.toLowerCase()}`} onClick={() => ref.current?.close()} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+      </header>
+      {children}
+    </dialog>
+  );
+}
