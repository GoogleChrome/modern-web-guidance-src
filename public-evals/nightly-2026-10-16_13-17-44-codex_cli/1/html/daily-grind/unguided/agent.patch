+++ b/app.js
@@ -0,0 +1,95 @@
+const drinks = {
+  maple: {
+    name: "Maple Oat Latte",
+    description:
+      "Espresso meets creamy oat milk and a hint of Vermont maple syrup. A comforting seasonal favorite, made with care.",
+    note: "Contains oats. Ask our team about ingredients, allergens, and available customizations.",
+  },
+  espresso: {
+    name: "Dark Roast Espresso",
+    description:
+      "A bold, smoky espresso with a rich finish. Locally roasted beans make this small cup the perfect start to your morning.",
+    note: "Served as espresso. Ask our team about milk options and available customizations.",
+  },
+  cold: {
+    name: "Cold Brew",
+    description:
+      "Slowly steeped for 18 hours for maximum smoothness. Served over ice for a refreshingly simple daily ritual.",
+    note: "Served over ice. Ask our team about milk options and available customizations.",
+  },
+};
+const details = document.querySelector("#drink-dialog");
+const order = document.querySelector("#order-dialog");
+const form = document.querySelector("#coffee-form");
+const status = document.querySelector("#list-status");
+const openers = new WeakMap();
+let selectedDrink;
+let listOpener;
+
+function openDialog(dialog, trigger) {
+  // Close any open popover before moving into the modal's focus scope.
+  document
+    .querySelectorAll("[popover]:popover-open")
+    .forEach((popover) => popover.hidePopover());
+  openers.set(dialog, trigger);
+  if (dialog === order) status.textContent = "";
+  dialog.showModal();
+}
+
+for (const trigger of document.querySelectorAll("[data-open]")) {
+  trigger.addEventListener("click", () =>
+    openDialog(document.getElementById(trigger.dataset.open), trigger),
+  );
+}
+for (const trigger of document.querySelectorAll("[data-drink]")) {
+  trigger.addEventListener("click", () => {
+    selectedDrink = trigger.dataset.drink;
+    const drink = drinks[selectedDrink];
+    document.querySelector("#drink-dialog-title").textContent = drink.name;
+    document.querySelector("#drink-description").textContent =
+      drink.description;
+    document.querySelector("#drink-note").textContent = drink.note;
+    openDialog(details, trigger);
+  });
+}
+for (const dialog of document.querySelectorAll("dialog")) {
+  dialog
+    .querySelector("[data-close]")
+    .addEventListener("click", () => dialog.close());
+  // Native dialogs handle Escape, focus containment, and background inertness.
+  dialog.addEventListener("close", () => {
+    if (!document.querySelector("dialog[open]")) openers.get(dialog)?.focus();
+  });
+}
+document.querySelector("#add-drink").addEventListener("click", () => {
+  const input = form.elements.namedItem(selectedDrink);
+  input.value = Math.min(20, (Number(input.value) || 0) + 1);
+  listOpener = openers.get(details);
+  details.close();
+  openDialog(order, listOpener);
+});
+form.addEventListener("input", () => {
+  status.textContent = "";
+});
+form.addEventListener("submit", (event) => {
+  event.preventDefault();
+  const total = Object.keys(drinks).reduce(
+    (sum, key) => sum + Number(form.elements.namedItem(key).value),
+    0,
+  );
+  status.textContent = total
+    ? `${total} ${total === 1 ? "drink" : "drinks"} on your list. Ready for your next visit! Orders are placed in store.`
+    : "Add at least one drink to start your coffee list.";
+});
+for (const popover of document.querySelectorAll("[popover]")) {
+  popover.querySelectorAll("a").forEach((link) =>
+    link.addEventListener("click", () => {
+      popover.hidePopover();
+      const target = document.querySelector(link.hash);
+      if (target) {
+        target.setAttribute("tabindex", "-1");
+        target.focus({ preventScroll: true });
+      }
+    }),
+  );
+}
