index 0000000..738f25c
--- /dev/null
+++ b/src/lib/signup.ts
@@ -0,0 +1,36 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LIFETIME = 10 * 60 * 1000;
+export const RESEND_DELAY = 30 * 1000;
+export type PhoneChallenge = {
+  phone: string;
+  hash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+};
+
+export function normalizePhone(value: string): string | null {
+  const phone = value.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(phone) ? phone : null;
+}
+
+export function hashCode(code: string): string {
+  return createHash('sha256').update(code).digest('hex');
+}
+
+export function matchesCode(code: string, hash: string): boolean {
+  return /^[0-9]{6}$/.test(code) && timingSafeEqual(Buffer.from(hashCode(code), 'hex'), Buffer.from(hash, 'hex'));
+}
+
+export function createChallenge(phone: string, now = Date.now()) {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  return {
+    code,
+    challenge: { phone, hash: hashCode(code), expiresAt: now + CODE_LIFETIME, sentAt: now, attempts: 0 } satisfies PhoneChallenge,
+  };
+}
+
+export function smsMessage(hostname: string, code: string) {
+  return `Your DevTools Times verification code is ${code}. It expires in 10 minutes.\n\n@${hostname} #${code}`;
+}
diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..c882b3c
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,65 @@
+import type { APIRoute } from 'astro';
+import { CODE_LIFETIME, RESEND_DELAY, createChallenge, matchesCode, normalizePhone, smsMessage, type PhoneChallenge } from '../../lib/signup';
+
+const json = (data: object, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // This endpoint sets a session cookie and must only accept same-origin requests.
+  const origin = request.headers.get('origin');
+  if (!origin || origin !== new URL(request.url).origin) return json({ error: 'Please submit this form from this website.' }, 403);
+  if (!session) return json({ error: 'Verification is temporarily unavailable.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const challenge = await session.get('signupChallenge') as PhoneChallenge | undefined;
+
+  if (body.action === 'send') {
+    const phone = typeof body.phone === 'string' ? normalizePhone(body.phone) : null;
+    if (!phone) return json({ error: 'Enter a phone number with its country code, such as +1 202 555 0123.' }, 400);
+    if (challenge && Date.now() - challenge.sentAt < RESEND_DELAY) {
+      return json({ error: 'Please wait 30 seconds before requesting another code.' }, 429);
+    }
+    const account = process.env.TWILIO_ACCOUNT_SID;
+    const token = process.env.TWILIO_AUTH_TOKEN;
+    const from = process.env.TWILIO_FROM_NUMBER;
+    if (!account || !token || !from) return json({ error: 'SMS verification is not configured. Please try again later.' }, 503);
+    const { code, challenge: next } = createChallenge(phone);
+    // Reserve the cooldown before delivery, including failed delivery attempts.
+    await session.set('signupChallenge', { ...next, hash: '', expiresAt: 0 });
+    try {
+      const result = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(account)}/Messages.json`, {
+        method: 'POST',
+        headers: { Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`, 'Content-Type': 'application/x-www-form-urlencoded' },
+        body: new URLSearchParams({ To: phone, From: from, Body: smsMessage(new URL(request.url).hostname, code) }),
+        signal: AbortSignal.timeout(15000),
+      });
+      if (!result.ok) return json({ error: 'We could not send your code. Check the phone number and try again in 30 seconds.' }, 502);
+      await session.set('signupChallenge', next);
+      return json({ phone, expiresIn: CODE_LIFETIME / 1000 });
+    } catch { return json({ error: 'SMS delivery is unavailable. Please try again in 30 seconds.' }, 502); }
+  }
+
+  if (body.action !== 'register') return json({ error: 'Invalid request.' }, 400);
+  if (!challenge || challenge.expiresAt <= Date.now() || challenge.attempts >= 5) {
+    return json({ error: 'Your code has expired or reached its attempt limit. Request a new code.', newCodeRequired: true }, 400);
+  }
+  if (typeof body.code !== 'string' || !matchesCode(body.code, challenge.hash)) {
+    await session.set('signupChallenge', { ...challenge, attempts: challenge.attempts + 1 });
+    return json({ error: 'That code is incorrect. Please check your message and try again.' }, 400);
+  }
+  if (typeof body.username !== 'string' || !body.username.trim() || body.username.length > 100 || typeof body.password !== 'string' || body.password.length < 8 || !/[0-9]/.test(body.password)) {
+    return json({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+  }
+  try {
+    const result = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!result.ok) return json({ error: 'Registration failed. Check your account details or try another username.' }, 400);
+    await session.delete('signupChallenge');
+    return json({ success: true });
+  } catch { return json({ error: 'Registration is unavailable. Please try again.' }, 502); }
+};
