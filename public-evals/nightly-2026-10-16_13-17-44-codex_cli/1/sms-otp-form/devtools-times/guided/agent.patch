+++ b/tests/signup.test.ts
@@ -0,0 +1,104 @@
+import assert from 'node:assert/strict';
+import { afterEach, test } from 'node:test';
+import { POST } from '../src/pages/api/signup';
+import { createChallenge, matchesCode, normalizePhone, smsMessage } from '../src/lib/signup';
+
+const originalFetch = globalThis.fetch;
+const oldEnv = { ...process.env };
+afterEach(() => { globalThis.fetch = originalFetch; process.env = { ...oldEnv }; });
+
+function context(body: object, origin = 'https://news.example') {
+  const store = new Map<string, unknown>();
+  const session = {
+    get: async (key: string) => store.get(key),
+    set: async (key: string, value: unknown) => { store.set(key, value); },
+    delete: async (key: string) => { store.delete(key); },
+  };
+  const call = (payload = body) => POST({
+    request: new Request('https://news.example/devtools-times/api/signup', {
+      method: 'POST', headers: { 'Content-Type': 'application/json', Origin: origin }, body: JSON.stringify(payload),
+    }), session,
+  } as never);
+  return { store, call };
+}
+
+test('normalizes international phone numbers and rejects ambiguous local numbers', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), '+12025550123');
+  for (const phone of ['2025550123', '+0123456789', '+123', '+1202abc5550123']) assert.equal(normalizePhone(phone), null);
+});
+
+test('codes preserve leading zeros and SMS is bound to the host on its final line', () => {
+  const { code, challenge } = createChallenge('+12025550123', 100);
+  assert.match(code, /^[0-9]{6}$/);
+  assert.equal(matchesCode(code, challenge.hash), true);
+  assert.equal(matchesCode('abc123', challenge.hash), false);
+  assert.equal(smsMessage('news.example', '012345').split('\n').at(-1), '@news.example #012345');
+  assert.equal(challenge.expiresAt, 600100);
+});
+
+test('rejects cross-origin requests before contacting the SMS provider', async () => {
+  const { call } = context({ action: 'send', phone: '+12025550123' }, 'https://other.example');
+  assert.equal((await call()).status, 403);
+});
+
+test('reports missing SMS configuration without pretending to send', async () => {
+  delete process.env.TWILIO_ACCOUNT_SID;
+  const { call, store } = context({ action: 'send', phone: '+12025550123' });
+  assert.equal((await call()).status, 503);
+  assert.equal(store.has('signupChallenge'), false);
+});
+
+test('sends an origin-bound SMS, stores only its hash, and enforces cooldown', async () => {
+  process.env.TWILIO_ACCOUNT_SID = 'test';
+  process.env.TWILIO_AUTH_TOKEN = 'test';
+  process.env.TWILIO_FROM_NUMBER = '+12025550000';
+  let text = '';
+  globalThis.fetch = (async (_url, options) => {
+    text = (options?.body as URLSearchParams).get('Body')!;
+    return new Response('{}', { status: 201 });
+  }) as typeof fetch;
+  const { call, store } = context({ action: 'send', phone: '+1 (202) 555-0123' });
+  const response = await call();
+  assert.equal(response.status, 200);
+  const data = await response.json();
+  assert.deepEqual(Object.keys(data).sort(), ['expiresIn', 'phone']);
+  const code = text.match(/#([0-9]{6})$/)![1];
+  const challenge = store.get('signupChallenge') as ReturnType<typeof createChallenge>['challenge'];
+  assert.equal(matchesCode(code, challenge.hash), true);
+  assert.equal(JSON.stringify(challenge).includes(`"code"`), false);
+  assert.equal((await call()).status, 429);
+});
+
+test('blocks expired codes and locks verification after five wrong attempts', async () => {
+  const { call, store } = context({ action: 'register', code: 'bad' });
+  store.set('signupChallenge', createChallenge('+12025550123', 0).challenge);
+  assert.equal((await (await call()).json()).newCodeRequired, true);
+  store.set('signupChallenge', createChallenge('+12025550123').challenge);
+  for (let i = 0; i < 5; i++) assert.equal((await call()).status, 400);
+  assert.equal((await (await call()).json()).newCodeRequired, true);
+});
+
+test('registers only with the verified session phone and consumes the challenge', async () => {
+  const { code, challenge } = createChallenge('+12025550123');
+  const payload = { action: 'register', code, username: 'reader', password: 'password1', phone: '+19999999999' };
+  const { call, store } = context(payload);
+  store.set('signupChallenge', challenge);
+  let sent: Record<string, string> | undefined;
+  globalThis.fetch = (async (_url, options) => {
+    sent = JSON.parse(options?.body as string);
+    return new Response('{}');
+  }) as typeof fetch;
+  assert.equal((await call()).status, 200);
+  assert.equal(sent?.phone, challenge.phone);
+  assert.equal(store.has('signupChallenge'), false);
+  assert.equal((await call()).status, 400);
+});
+
+test('registration service failures preserve the challenge for retry', async () => {
+  const { code, challenge } = createChallenge('+12025550123');
+  const { call, store } = context({ action: 'register', code, username: 'reader', password: 'password1' });
+  store.set('signupChallenge', challenge);
+  globalThis.fetch = (async () => new Response('{}', { status: 500 })) as typeof fetch;
+  assert.equal((await call()).status, 400);
+  assert.equal(store.has('signupChallenge'), true);
+});
