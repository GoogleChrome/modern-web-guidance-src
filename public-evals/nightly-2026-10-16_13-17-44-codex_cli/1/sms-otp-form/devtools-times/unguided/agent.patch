diff --git a/tests/signup.test.mjs b/tests/signup.test.mjs
new file mode 100644
index 0000000..9cadfd6
--- /dev/null
+++ b/tests/signup.test.mjs
@@ -0,0 +1,152 @@
+import { test, afterEach } from "node:test";
+import assert from "node:assert/strict";
+import { POST } from "../src/pages/api/signup.ts";
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+});
+const goodAccount = {
+  action: "register",
+  username: "reader",
+  password: "password123",
+  code: "123456",
+};
+function fixture(initial) {
+  const state = new Map(initial ? [["signupChallenge", initial]] : []);
+  return {
+    state,
+    call: (body, origin = "https://times.test") =>
+      POST({
+        url: new URL("https://times.test/devtools-times/api/signup"),
+        request: new Request("https://times.test/devtools-times/api/signup", {
+          method: "POST",
+          headers: { origin, "Content-Type": "application/json" },
+          body: JSON.stringify(body),
+        }),
+        session: {
+          get: async (key) => state.get(key),
+          set: async (key, value) => {
+            state.set(key, value);
+          },
+          delete: async (key) => {
+            state.delete(key);
+          },
+        },
+      }),
+  };
+}
+const challenge = (overrides = {}) => ({
+  phone: "+14155550123",
+  sentAt: Date.now() - 31000,
+  expiresAt: Date.now() + 600000,
+  attempts: 0,
+  sends: 1,
+  verified: false,
+  ...overrides,
+});
+function provider(handler) {
+  process.env.TWILIO_ACCOUNT_SID = "ACtest";
+  process.env.TWILIO_AUTH_TOKEN = "test";
+  process.env.TWILIO_VERIFY_SERVICE_SID = "VAtest";
+  globalThis.fetch = handler;
+}
+
+test("rejects cross-origin requests and unverified registration without contacting a provider", async () => {
+  provider(async () => {
+    throw new Error("Unexpected request");
+  });
+  assert.equal(
+    (await fixture().call(goodAccount, "https://other.test")).status,
+    403,
+  );
+  assert.equal((await fixture().call(goodAccount)).status, 400);
+});
+test("normalizes phone numbers, requests SMS, and enforces the resend cooldown", async () => {
+  let calls = 0;
+  provider(async (_url, options) => {
+    calls++;
+    assert.equal(new URLSearchParams(options?.body).get("To"), "+14155550123");
+    assert.equal(new URLSearchParams(options?.body).get("Channel"), "sms");
+    return Response.json({ status: "pending" });
+  });
+  const f = fixture();
+  assert.equal(
+    (await f.call({ action: "send", phone: "+1 (415) 555-0123" })).status,
+    200,
+  );
+  assert.equal(
+    (await f.call({ action: "send", phone: "+14155550123" })).status,
+    429,
+  );
+  assert.equal(calls, 1);
+});
+test("rejects invalid phones, expired challenges, and exhausted attempts", async () => {
+  provider(async () => {
+    throw new Error("Unexpected request");
+  });
+  assert.equal(
+    (await fixture().call({ action: "send", phone: "4155550123" })).status,
+    400,
+  );
+  assert.equal(
+    (await fixture(challenge({ expiresAt: 0 })).call(goodAccount)).status,
+    400,
+  );
+  assert.equal(
+    (await fixture(challenge({ attempts: 5 })).call(goodAccount)).status,
+    429,
+  );
+});
+test("a wrong SMS code never registers an account", async () => {
+  let calls = 0;
+  provider(async (url) => {
+    calls++;
+    assert.match(String(url), /VerificationCheck$/);
+    return Response.json({ status: "pending" });
+  });
+  assert.equal((await fixture(challenge()).call(goodAccount)).status, 400);
+  assert.equal(calls, 1);
+});
+test("registers only after provider approval, uses the server phone, and consumes the challenge", async () => {
+  const calls = [];
+  provider(async (url, options) => {
+    calls.push(String(url));
+    if (calls.length === 1) return Response.json({ status: "approved" });
+    assert.equal(JSON.parse(options?.body).phone, "+14155550123");
+    return Response.json({ success: true });
+  });
+  const f = fixture(challenge());
+  assert.equal(
+    (await f.call({ ...goodAccount, phone: "+442079460000" })).status,
+    200,
+  );
