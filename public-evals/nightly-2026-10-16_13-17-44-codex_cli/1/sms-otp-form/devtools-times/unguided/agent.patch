--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,199 @@
+import type { APIRoute } from "astro";
+
+type Challenge = {
+  phone: string;
+  sentAt: number;
+  expiresAt: number;
+  attempts: number;
+  sends: number;
+  verified: boolean;
+};
+const reply = (body: object, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+async function verifyRequest(resource: string, fields: Record<string, string>) {
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) throw new Error("SMS_UNAVAILABLE");
+  const response = await fetch(
+    `https://verify.twilio.com/v2/Services/${encodeURIComponent(service)}/${resource}`,
+    {
+      method: "POST",
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString("base64")}`,
+        "Content-Type": "application/x-www-form-urlencoded",
+      },
+      body: new URLSearchParams(fields),
+      signal: AbortSignal.timeout(15000),
+    },
+  );
+  const data = await response.json();
+  return { ok: response.ok, status: response.status, data };
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (request.headers.get("origin") !== url.origin)
+    return reply({ error: "Please submit this form from our website." }, 403);
+  if (!session)
+    return reply(
+      { error: "Your session is unavailable. Please reload and try again." },
+      503,
+    );
+  try {
+    const body = await request.json();
+    if (!body || typeof body !== "object")
+      return reply({ error: "Invalid request." }, 400);
+    const now = Date.now();
+    const previous = (await session.get("signupChallenge")) as
+      Challenge | undefined;
+    if (body.action === "send") {
+      const phone =
+        typeof body.phone === "string"
+          ? body.phone.replace(/[\s().-]/g, "")
+          : "";
+      if (!/^\+[1-9]\d{7,14}$/.test(phone))
+        return reply(
+          { error: "Enter a valid phone number with its country code." },
+          400,
+        );
+      if (previous && now - previous.sentAt < 30000)
+        return reply(
+          { error: "Please wait 30 seconds before requesting another code." },
+          429,
+        );
+      if (previous && previous.sends >= 5 && previous.expiresAt > now)
+        return reply(
+          { error: "Too many SMS requests. Please try again in 10 minutes." },
+          429,
+        );
+      // Persist the cooldown before contacting the provider, including failed delivery attempts.
+      const challenge: Challenge = {
+        phone,
+        sentAt: now,
+        expiresAt: now + 600000,
+        attempts: 0,
+        sends: previous && previous.expiresAt > now ? previous.sends + 1 : 1,
+        verified: false,
+      };
+      await session.set("signupChallenge", challenge, { ttl: 600 });
+      const result = await verifyRequest("Verifications", {
+        To: phone,
+        Channel: "sms",
+        ...(process.env.TWILIO_VERIFY_TEMPLATE_SID
+          ? { TemplateSid: process.env.TWILIO_VERIFY_TEMPLATE_SID }
+          : {}),
+      });
+      if (!result.ok || result.data.status !== "pending")
+        return reply(
+          {
+            error:
+              result.status === 429
+                ? "Too many requests. Please try again later."
+                : "We couldn’t send a code to this number. Check it and try again.",
+          },
+          result.status === 429 ? 429 : 502,
+        );
+      return reply({ sent: true, retryAfter: 30 });
+    }
+    if (body.action !== "register")
+      return reply({ error: "Unknown request." }, 400);
+    const { username, password, code } = body;
+    if (
+      typeof username !== "string" ||
+      !username.trim() ||
+      username.length > 100 ||
+      typeof password !== "string" ||
+      password.length < 8 ||
+      !/\d/.test(password)
+    ) {
+      return reply(
+        {
+          error:
+            "Enter a username and a password with at least 8 characters and a number.",
+        },
+        400,
+      );
+    }
+    if (!previous || previous.expiresAt <= now)
+      return reply(
+        { error: "Your code has expired. Request a new code and try again." },
+        400,
+      );
+    if (!previous.verified) {
+      if (typeof code !== "string" || !/^\d{6}$/.test(code))
+        return reply(
+          { error: "Enter the 6-digit code from your text message." },
+          400,
+        );
+      if (previous.attempts >= 5)
+        return reply(
+          { error: "Too many attempts. Request a new code to continue." },
+          429,
+        );
+      previous.attempts += 1;
+      await session.set("signupChallenge", previous, {
+        ttl: Math.max(1, Math.ceil((previous.expiresAt - Date.now()) / 1000)),
+      });
+      const result = await verifyRequest("VerificationCheck", {
+        To: previous.phone,
+        Code: code,
+      });
+      if (!result.ok || result.data.status !== "approved")
+        return reply(
+          {
+            error:
+              result.status === 404
+                ? "Your code has expired. Request a new code."
+                : "That code could not be verified. Check the code or request a new one.",
+          },
+          400,
+        );
+      previous.verified = true;
+      await session.set("signupChallenge", previous, {
+        ttl: Math.max(1, Math.ceil((previous.expiresAt - Date.now()) / 1000)),
+      });
+    }
+    const response = await fetch(
+      "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register",
+      {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          username: username.trim(),
+          password,
+          phone: previous.phone,
+        }),
+        signal: AbortSignal.timeout(15000),
+      },
+    );
+    if (!response.ok)
+      return reply(
+        {
+          error:
+            "Your phone is verified, but we couldn’t create your account. Try another username or try again later.",
+        },
+        400,
+      );
+    await session.delete("signupChallenge");
+    return reply({ registered: true });
+  } catch (error) {
+    if (error instanceof SyntaxError)
+      return reply({ error: "Invalid request." }, 400);
+    return reply(
+      {
+        error:
+          error instanceof Error && error.message === "SMS_UNAVAILABLE"
+            ? "Phone verification is temporarily unavailable. Please try again later."
+            : "We couldn’t complete your request. Please try again.",
+      },
+      503,
+    );
+  }
+};
