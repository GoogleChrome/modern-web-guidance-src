+    }
+
+    .nutrition-tooltip:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .nutrition-tooltip strong,
+    .nutrition-tooltip small {
+      display: block;
+    }
+
+    .nutrition-tooltip strong {
+      color: var(--accent);
+    }
+
+    .nutrition-tooltip small {
+      margin-top: 6px;
+    }
+
+    @position-try --tooltip-below {
+      top: anchor(bottom);
+      left: anchor(center);
+      margin: 8px 0 0 -115px;
+    }
+
+    @media (max-width: 600px) {
+      .nutrition-tooltip {
+        top: anchor(bottom);
+        left: anchor(center);
+        margin: 8px 0 0 -115px;
+        position-try-fallbacks: flip-block;
+      }
+    }
