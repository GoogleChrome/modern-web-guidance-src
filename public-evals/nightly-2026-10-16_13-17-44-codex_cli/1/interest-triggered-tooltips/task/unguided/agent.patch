+      line-height: 1.5;
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    /* Keep the tooltip reachable across the gap above the button. */
+    .details-tooltip::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 0;
+      width: 100%;
+      height: 8px;
+    }
+
+    .details-tooltip strong,
+    .details-tooltip span {
+      display: block;
+    }
+
+    .details-trigger:not(.is-dismissed):hover .details-tooltip,
+    .details-trigger:not(.is-dismissed):focus-within .details-tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .details-trigger .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
