+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let promoCount = 0;
+
+    async function animateCard(card, entering) {
+      const frames = [
+        { opacity: 0, transform: 'scale(0.9)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const animation = card.animate(entering ? frames : frames.slice().reverse(), {
+        duration: reducedMotion.matches ? 0 : 260,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+      await animation.finished;
+      return animation;
+    }
+
+    async function updatePromos(action) {
+      addBtn.disabled = removeBtn.disabled = toggleBtn.disabled = true;
+      try {
+        await action();
+      } finally {
+        addBtn.disabled = false;
+        removeBtn.disabled = !domContainer.lastElementChild;
+        toggleBtn.disabled = !domContainer.contains(toggleCard);
+      }
+    }
+
+    addBtn.addEventListener('click', () => updatePromos(async () => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover your next favorite cup, freshly roasted and made with care.';
+      card.append(heading, description);
+      domContainer.append(card);
+      const animation = await animateCard(card, true);
+      animation.cancel();
+    }));
+
+    removeBtn.addEventListener('click', () => updatePromos(async () => {
+      const card = domContainer.lastElementChild;
+      if (!card) return;
+      const animation = card.hidden ? null : await animateCard(card, false);
+      card.remove();
+      animation?.cancel();
+    }));
+
+    toggleBtn.addEventListener('click', () => updatePromos(async () => {
+      if (toggleCard.hidden) {
+        toggleCard.hidden = false;
+        const animation = await animateCard(toggleCard, true);
+        animation.cancel();
+      } else {
+        const animation = await animateCard(toggleCard, false);
+        toggleCard.hidden = true;
+        animation.cancel();
+      }
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+    }));
+  </script>
+
 </body>
 
