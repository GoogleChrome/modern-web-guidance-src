diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,98 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="A considered everyday essential. Discover the Everyday Chair by Form.">
+  <title>Form — Everyday Chair</title>
+  <style>
+    * { box-sizing: border-box; }
+    body { margin: 0; background: #faf9f6; color: #242923; font: 16px/1.6 system-ui, sans-serif; }
+    a { color: inherit; text-underline-offset: 4px; }
+    header, main, footer { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
+    header { display: flex; justify-content: space-between; align-items: center; padding-block: 24px; }
+    .wordmark { font-size: 24px; font-weight: 650; letter-spacing: -1px; text-decoration: none; }
+    nav { position: relative; }
+    summary, button { cursor: pointer; }
+    summary { padding: 8px; }
+    .menu { position: absolute; right: 0; z-index: 1; width: min(300px, 80vw); padding: 20px; background: #fff; border: 1px solid #dedfd7; }
+    .menu a { display: block; margin-bottom: 16px; }
+    img { display: block; max-width: 100%; height: auto; background: #e9e8e1; color: #52594c; }
+    .intro { padding: 40px 0 28px; }
+    .eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: 2px; }
+    h1 { margin: 10px 0; font-size: clamp(36px, 6vw, 64px); line-height: 1.1; font-weight: 450; letter-spacing: -2px; }
+    .intro p:last-child { margin-bottom: 0; color: #63685f; }
+    .hero { width: 100%; aspect-ratio: 1.85; object-fit: cover; }
+    .gallery { max-width: 480px; padding-top: 80px; }
+    h2 { font-size: 26px; font-weight: 450; letter-spacing: -.5px; }
+    .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
+    [hidden] { display: none !important; }
+    button { margin-top: 16px; padding: 11px 18px; background: transparent; border: 1px solid #93998d; border-radius: 2px; color: inherit; font: inherit; }
+    button:hover { background: #eeeee7; }
+    :focus-visible { outline: 2px solid #365b3b; outline-offset: 4px; }
+    .notes { max-width: 540px; margin-block: 120px 180px; }
+    .notes p { color: #63685f; }
+    footer { border-top: 1px solid #dedfd7; padding-block: 32px; color: #63685f; font-size: 13px; }
+    footer img { margin-bottom: 20px; }
+    @media (max-width: 600px) {
+      .intro { padding-top: 20px; }
+      .hero { aspect-ratio: 4 / 3; }
+      .gallery { padding-top: 48px; }
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <a class="wordmark" href="#" aria-label="Form home">form.</a>
+    <nav aria-label="Main navigation">
+      <details>
+        <summary>Explore</summary>
+        <div class="menu">
+          <a href="#gallery">The Everyday Chair</a>
+          <img src="mega-menu-promo.jpg" alt="Explore the Form collection" width="260" height="180" loading="lazy" fetchpriority="low">
+        </div>
+      </details>
+    </nav>
+  </header>
+  <main>
+    <section aria-labelledby="product-title">
+      <div class="intro">
+        <p class="eyebrow">Made for the everyday</p>
+        <h1 id="product-title">A little less. A little better.</h1>
+        <p>The Everyday Chair. Simple lines, lasting comfort.</p>
+      </div>
+      <img class="hero" src="hero-lcp.jpg" alt="The Everyday Chair in a calm, light-filled interior" width="1440" height="780" loading="eager" fetchpriority="high">
+    </section>
+    <section class="gallery" id="gallery" aria-labelledby="gallery-title">
+      <p class="eyebrow">The Everyday Chair</p>
+      <h2 id="gallery-title">Considered from every angle.</h2>
+      <!-- Reuse the supplied hero file for the first gallery view. -->
+      <img id="gallery-main" src="hero-lcp.jpg" alt="Everyday Chair, main view" width="640" height="480">
+      <img id="gallery-alt" src="gallery-alt.jpg" alt="Everyday Chair, alternate view" width="640" height="480" loading="lazy" fetchpriority="low" hidden>
+      <button type="button" id="gallery-toggle" aria-controls="gallery-alt" aria-expanded="false">Show alternate view</button>
+    </section>
+    <section class="notes" aria-labelledby="notes-title">
+      <p class="eyebrow">Room to breathe</p>
+      <h2 id="notes-title">Only what you need.</h2>
+      <p>A quiet addition to the places you spend your day. Thoughtful proportions and an effortless silhouette, made to feel at home.</p>
+      <a href="#gallery">Take a closer look</a>
+    </section>
+  </main>
+  <footer>
+    <img src="footer-logo.png" alt="Form" width="120" height="40" loading="lazy">
+    <span>Objects for everyday living.</span>
+  </footer>
+  <script>
+    const toggle = document.getElementById('gallery-toggle');
+    const mainImage = document.getElementById('gallery-main');
+    const alternateImage = document.getElementById('gallery-alt');
+    toggle.addEventListener('click', () => {
+      const showAlternate = alternateImage.hidden;
+      alternateImage.hidden = !showAlternate;
+      mainImage.hidden = showAlternate;
+      toggle.setAttribute('aria-expanded', String(showAlternate));
+      toggle.textContent = showAlternate ? 'Show main view' : 'Show alternate view';
+    });
+  </script>
+</body>
+</html>
