+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const preferencesKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(preferencesKey));
+      if (saved && typeof saved === 'object') {
+        for (const name of ['name', 'coffee', 'notes']) {
+          if (typeof saved[name] === 'string') {
+            preferencesForm.elements.namedItem(name).value = saved[name];
+          }
+        }
+      }
+    } catch {
+      // The form remains usable when browser storage is unavailable.
+    }
+
+    preferencesForm.addEventListener('input', () => {
+      preferencesStatus.textContent = '';
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        const preferences = Object.fromEntries(new FormData(preferencesForm));
+        localStorage.setItem(preferencesKey, JSON.stringify(preferences));
+        preferencesStatus.textContent = 'Preferences saved on this device. Your next cup is one step closer.';
+      } catch {
+        preferencesStatus.textContent = 'Your browser could not save these preferences. You can still edit them here.';
+      }
+    });
+  </script>
