+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+
+    function closePicker(restoreFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker() {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      document.getElementById('roast-value').textContent = option.querySelector('strong').textContent;
+      document.getElementById('roast-notes').textContent = option.dataset.notes;
+      document.getElementById('order-link').href = '/order-online?roast=' + option.dataset.roast;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => menu.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(event.key)) {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(option));
+      option.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index + options.length - 1) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) {
+          event.preventDefault();
+          options[next].focus();
+        }
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(option);
+        }
+      });
+    });
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !menu.hidden) {
+        event.preventDefault();
+        closePicker(true);
+      }
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+    document.addEventListener('pointerdown', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+  </script>
