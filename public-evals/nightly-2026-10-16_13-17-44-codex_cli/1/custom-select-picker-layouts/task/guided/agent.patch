+  <script>
+    const roastSelect = document.querySelector('#roast');
+    const orderLink = document.querySelector('#order-now');
+    const updateOrder = () => {
+      const url = new URL(orderLink.href);
+      url.searchParams.set('roast', roastSelect.value);
+      orderLink.href = url.pathname + url.search;
+    };
+    roastSelect.addEventListener('change', updateOrder);
+    updateOrder();
+
+    // Keep the rich grid available when native customizable selects are unsupported.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const field = document.querySelector('.roast-field');
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.className = 'roast-trigger';
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.hidden = true;
+      menu.setAttribute('role', 'listbox');
+      menu.setAttribute('aria-labelledby', 'roast-label');
+      menu.setAttribute('aria-orientation', 'horizontal');
+      trigger.setAttribute('aria-controls', menu.id);
+      const options = Array.from(roastSelect.options);
+      const cards = options.map(option => {
+        const card = document.createElement('button');
+        card.type = 'button';
+        card.className = 'roast-option';
+        card.setAttribute('role', 'option');
+        card.setAttribute('aria-label', option.getAttribute('aria-label'));
+        card.tabIndex = -1;
+        const image = document.createElement('img');
+        image.className = 'roast-photo';
+        image.src = 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=280&q=80';
+        image.alt = '';
+        image.style.objectPosition = option.dataset.position;
+        const title = document.createElement('span');
+        title.className = 'roast-title';
+        title.textContent = option.getAttribute('aria-label');
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(image, title, notes);
+        card.addEventListener('click', () => {
+          roastSelect.value = option.value;
+          roastSelect.dispatchEvent(new Event('change', { bubbles: true }));
+          close(true);
+        });
+        menu.append(card);
+        return card;
+      });
+      function sync() {
+        trigger.textContent = options[roastSelect.selectedIndex].getAttribute('aria-label') + ' ▾';
+        cards.forEach((card, index) => card.setAttribute('aria-selected', String(index === roastSelect.selectedIndex)));
+      }
+      function close(restoreFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function open() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[roastSelect.selectedIndex].focus();
+      }
+      trigger.addEventListener('click', () => menu.hidden ? open() : close());
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp'].includes(event.key)) { event.preventDefault(); open(); }
+      });
+      menu.addEventListener('keydown', event => {
+        const index = cards.indexOf(document.activeElement);
+        const direction = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
+        if (direction || event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? 2 : (index + direction + cards.length) % cards.length;
+          cards[next].focus();
+        }
+        if (event.key === 'Escape') { event.preventDefault(); close(true); }
+        const match = options.findIndex(option => option.value.startsWith(event.key.toLowerCase()));
+        if (event.key.length === 1 && match !== -1) cards[match].focus();
+      });
+      document.addEventListener('pointerdown', event => { if (!field.contains(event.target)) close(); });
+      field.addEventListener('focusout', event => { if (!field.contains(event.relatedTarget)) close(); });
+      roastSelect.addEventListener('change', sync);
+      roastSelect.hidden = true;
+      document.querySelector('#roast-label').htmlFor = trigger.id;
+      field.append(trigger, menu);
+      sync();
+    }
+  </script>
