+const $ = s => document.querySelector(s);
+let account = { user: null, passkeys: [] }, authMode = 'register', manageKey, manageAction, busy = false;
+const icons = () => lucide.createIcons();
+const escape = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const authDialog = $('#auth-dialog'), manageDialog = $('#manage-dialog');
+async function api(path, body, method = 'POST') {
+  const response = await fetch('/api/' + path, { method, headers: { 'Content-Type':'application/json', 'X-Requested-With':'DailyGrind' }, ...(body !== undefined ? { body: JSON.stringify(body) } : {}) });
+  const result = await response.json();
+  if (!response.ok) { const error = new Error(result.error || 'Something went wrong. Please try again.'); error.reauthenticate = result.reauthenticate; throw error; }
+  return result;
+}
+let toastTimer;
+function toast(message) { $('#toast').textContent = message; $('#toast').hidden = false; clearTimeout(toastTimer); toastTimer = setTimeout(() => $('#toast').hidden = true, 5500); }
+function friendly(error) {
+  if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey prompt was canceled or timed out. You can try again whenever you’re ready.';
+  if (error.name === 'InvalidStateError') return 'This device already has that passkey. Try another device or security key.';
+  if (error.name === 'SecurityError') return 'Passkeys need a secure connection and a matching website address. Please use HTTPS (or localhost).';
+  return error.message || 'We couldn’t complete that request. Please try again.';
+}
+function checkSupport() {
+  if (!window.isSecureContext) throw new Error('Passkeys need a secure connection. Please open this site using HTTPS (or localhost).');
+  if (!window.PublicKeyCredential || !window.SimpleWebAuthnBrowser) throw new Error('This browser does not support passkeys. Please try a current version of Safari, Chrome, Edge, or Firefox.');
+}
+async function refresh() {
+  account = await api('account', undefined, 'GET');
+  $('#key-count').textContent = account.passkeys.length;
+  $('#signout span').textContent = account.user ? 'Sign out' : 'Sign in to your account';
+  $('#signout').querySelector('svg')?.setAttribute('data-lucide', account.user ? 'log-out' : 'log-in');
+  $('#hero-add').innerHTML = `<i data-lucide="plus"></i>${account.user ? 'Add a passkey' : 'Create a passkey'}<i data-lucide="arrow-right"></i>`;
+  if (account.passkeys.length) {
+    $('#passkey-list').innerHTML = account.passkeys.map(key => `<div class="passkey-row"><span class="empty-icon"><i data-lucide="${key.synced ? 'cloud-check' : 'key-round'}"></i></span><div><strong>${escape(key.name)}</strong><p>${key.synced ? 'Synced passkey' : 'Device passkey'} · Added ${new Date(key.created).toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' })}${key.lastUsed ? ' · Last used ' + new Date(key.lastUsed).toLocaleDateString(undefined,{month:'short', day:'numeric'}) : ''}</p></div><div class="row-actions"><button class="icon-button" aria-label="Rename ${escape(key.name)}" data-key="${escape(key.id)}" data-action="rename"><i data-lucide="pencil"></i></button><button class="icon-button" aria-label="Remove ${escape(key.name)}" data-key="${escape(key.id)}" data-action="remove"><i data-lucide="trash-2"></i></button></div></div>`).join('');
+  } else $('#passkey-list').innerHTML = '<div class="empty-passkeys"><span class="empty-icon"><i data-lucide="key-round"></i></span><div><strong>Your next sign-in could be a little easier.</strong><p>Add your first passkey to get started. It only takes a moment.</p></div><span class="outline-tag">NO PASSKEYS YET</span></div>';
+  $('#session-description').textContent = account.user ? `You’re signed in as ${account.user.email} on this browser. Your session expires after seven days. Confirm your identity again whenever you need to make sensitive changes.` : 'Sign in to see your account’s active session.';
+  $('#reauthenticate').textContent = account.user ? 'Confirm my identity' : 'Sign in with a passkey';
+  icons();
+}
+function showAuth(mode) {
+  authMode = mode;
+  const register = mode === 'register', add = mode === 'add';
+  $('#dialog-title').textContent = register ? 'Make yourself at home.' : add ? 'Another way to get in.' : 'Welcome back.';
+  $('#dialog-description').textContent = register ? 'Create your account with a passkey. No password to remember.' : add ? 'Add a device or security key as a backup for your daily ritual.' : 'A familiar face. A simple touch. Sign in securely with your passkey.';
+  $('#registration-fields').hidden = !register;
+  $('#registration-fields').querySelectorAll('input').forEach(input => input.required = register);
+  $('#passkey-name-field').hidden = !(register || add);
+  $('#auth-submit span').textContent = register ? 'Create account with passkey' : add ? 'Create passkey' : 'Sign in with a passkey';
+  $('#auth-switch').hidden = add;
+  $('#auth-switch').textContent = register ? 'Already part of the grind? Sign in' : 'New here? Create an account';
+  $('#form-error').textContent = '';
+  if (!authDialog.open) authDialog.showModal();
+}
+async function authenticate(reauthenticate = false) {
+  checkSupport();
+  const optionsJSON = await api('authenticate/options', { reauthenticate });
+  const credential = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON });
+  await api('authenticate/verify', { credential });
+  await refresh();
+}
