+  res.json({ verified: true });
+});
+app.patch('/api/passkeys/:id', requireUser, fresh, (req, res) => {
+  const name = req.body.name;
+  if (typeof name !== 'string' || !name.trim() || name.length > 60) return res.status(400).json({ error: 'Use a passkey name between 1 and 60 characters.' });
+  const result = db.prepare('UPDATE credentials SET name = ? WHERE id = ? AND user_id = ?').run(name.trim(), req.params.id, req.session.user_id);
+  res.status(result.changes ? 200 : 404).json(result.changes ? { updated: true } : { error: 'Passkey not found.' });
+});
+app.delete('/api/passkeys/:id', requireUser, fresh, (req, res) => {
+  if (credentials(req.session.user_id).length < 2) return res.status(400).json({ error: 'Add another passkey before removing your last one so you can still sign in.' });
+  const result = db.prepare('DELETE FROM credentials WHERE id = ? AND user_id = ?').run(req.params.id, req.session.user_id);
+  res.status(result.changes ? 200 : 404).json(result.changes ? { removed: true } : { error: 'Passkey not found.' });
+});
+app.post('/api/logout', (req, res) => {
+  db.prepare('DELETE FROM sessions WHERE id = ?').run(req.session.id);
+  challenges.delete(req.session.id);
+  res.clearCookie('grind_session'); res.json({ ok: true });
