+const db = new DatabaseSync(`${process.env.DATA_DIR || './data'}/accounts.sqlite`);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+ CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT UNIQUE, name TEXT);
+ CREATE TABLE IF NOT EXISTS credentials (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), public_key BLOB, counter INTEGER, transports TEXT, name TEXT, created TEXT, last_used TEXT, backed_up INTEGER);
