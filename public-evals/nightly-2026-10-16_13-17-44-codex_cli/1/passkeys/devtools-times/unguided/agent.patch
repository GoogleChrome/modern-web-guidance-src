index 0000000..8c73faa
--- /dev/null
+++ b/src/components/AccountSecurity.tsx
@@ -0,0 +1,461 @@
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import {
+  FingerPrintIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  ArrowRightOnRectangleIcon,
+  KeyIcon,
+  CheckCircleIcon,
+  ComputerDesktopIcon,
+  ArrowLeftIcon,
+} from "@heroicons/react/24/outline";
+import {
+  api,
+  authenticatePasskey,
+  errorMessage,
+  registerPasskey,
+  RequestError,
+  supportsPasskeys,
+} from "../lib/auth-client";
+type Passkey = {
+  id: string;
+  name: string;
+  createdAt: number;
+  lastUsed: number | null;
+  backedUp: boolean;
+};
+type Account = {
+  user: { username: string; hasPassword: boolean };
+  recent: boolean;
+  passkeys: Passkey[];
+};
+const date = (value: number) =>
+  new Date(value).toLocaleDateString(undefined, {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+  });
+
+export default function AccountSecurity() {
+  const [account, setAccount] = useState<Account>();
+  const [supported, setSupported] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [modal, setModal] = useState<
+    "add" | "rename" | "delete" | "verify" | null
+  >(null);
+  const [selected, setSelected] = useState<Passkey>();
+  const [name, setName] = useState("");
+  const [password, setPassword] = useState("");
+  const dialog = useRef<HTMLDialogElement>(null);
+  async function refresh() {
+    const data = await api<Account>("account");
+    if (!data.user) {
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+      return;
+    }
+    setAccount(data);
+  }
+  useEffect(() => {
+    setSupported(supportsPasskeys());
+    void refresh().catch((e) => setError(errorMessage(e)));
+  }, []);
+  useEffect(() => {
+    if (modal) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [modal]);
+  async function run(
+    action: () => Promise<unknown>,
+    message: string,
+    close = true,
+  ) {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      await action();
+      await refresh();
+      setNotice(message);
+      if (close) setModal(null);
+    } catch (error) {
+      if (error instanceof RequestError && error.code === "REAUTH_REQUIRED") {
+        setModal("verify");
+        setPassword("");
+      }
+      setError(errorMessage(error));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function signOut() {
+    setBusy(true);
+    setError("");
+    try {
+      await api("logout", {});
+      window.location.assign(import.meta.env.BASE_URL);
+    } catch (error) {
+      setError(errorMessage(error));
+      setBusy(false);
+    }
+  }
+  function open(kind: typeof modal, key?: Passkey) {
+    setError("");
+    setNotice("");
+    setSelected(key);
+    setName(kind === "add" ? "" : key?.name || "");
+    setPassword("");
+    setModal(kind);
+  }
+  function submit(event: FormEvent) {
+    event.preventDefault();
+    if (modal === "add")
+      void run(
+        () => registerPasskey(undefined, name.trim()),
+        "Passkey added. You can use it the next time you sign in.",
+      );
+    if (modal === "rename")
+      void run(
+        () => api("passkeys/rename", { id: selected?.id, name }),
+        "Passkey renamed.",
+      );
+    if (modal === "delete")
+      void run(
+        () => api("passkeys/delete", { id: selected?.id }),
+        "Passkey removed from your account.",
+      );
+    if (modal === "verify")
+      void run(
+        () => api("reauthentication/password", { password }),
+        "Identity verified. You can now manage your passkeys.",
+      );
+  }
+  return (
+    <div className="security-page">
+      <a className="back-link" href={import.meta.env.BASE_URL}>
+        <ArrowLeftIcon width={15} /> Back to the news
+      </a>
+      <div className="security-heading">
+        <div>
+          <p className="auth-eyebrow">YOUR ACCOUNT</p>
+          <h1>Account & security</h1>
+          <p className="auth-description">
+            A little peace of mind for everything you read.
+          </p>
+        </div>
+        <button
+          className="text-button"
+          disabled={busy}
+          onClick={() => void signOut()}
+        >
+          <ArrowRightOnRectangleIcon width={18} /> Sign out
+        </button>
+      </div>
+      {error && !modal && (
+        <div className="auth-alert" role="alert">
+          {error}
+        </div>
+      )}
+      {notice && (
+        <div className="auth-notice" role="status">
+          <CheckCircleIcon width={19} />
+          {notice}
+        </div>
+      )}
+      {!account ? (
+        <p role="status">
+          {error
+            ? "Your account could not be loaded."
+            : "Loading your account…"}
+          {error && (
+            <button
+              className="text-button"
+              onClick={() => void run(refresh, "")}
+            >
+              Try again
+            </button>
+          )}
+        </p>
+      ) : (
+        <>
+          <section className="account-summary">
+            <div className="account-avatar">
+              {account.user.username.slice(0, 1).toUpperCase()}
+            </div>
+            <div>
+              <p className="auth-label">{account.user.username}</p>
+              <p className="auth-hint">The DevTools Times reader</p>
+            </div>
+            <span className="account-badge">
+              <ShieldCheckIcon width={15} /> Signed in
+            </span>
+          </section>
+          <section className="security-panel">
+            <div className="panel-heading">
+              <div className="panel-title">
+                <div className="panel-icon">
+                  <FingerPrintIcon width={25} />
+                </div>
+                <div>
+                  <h2>Passkeys</h2>
+                  <p>A simpler, safer way to sign in.</p>
+                </div>
+              </div>
+              <span className="count-badge">
+                {account.passkeys.length}{" "}
+                {account.passkeys.length === 1 ? "passkey" : "passkeys"}
+              </span>
+            </div>
+            <div className="passkey-intro">
+              <ShieldCheckIcon width={21} />
+              <p>
+                Use your fingerprint, face, or device screen lock to sign in.
+                Your biometric information stays on your device.
+              </p>
+            </div>
+            {account.passkeys.length ? (
+              <ul className="passkey-list">
+                {account.passkeys.map((key) => (
+                  <li key={key.id} className="passkey-row">
+                    <div className="device-icon">
+                      <ComputerDesktopIcon width={24} />
+                    </div>
+                    <div className="passkey-details">
+                      <h3>{key.name}</h3>
+                      <p>
+                        Added {date(key.createdAt)}
+                        <span aria-hidden="true"> · </span>
+                        {key.lastUsed
+                          ? `Last used ${date(key.lastUsed)}`
+                          : "Not used yet"}
+                      </p>
+                      <span className="auth-hint">
+                        {key.backedUp
+                          ? "Backed up by your passkey provider"
+                          : "Keep this passkey available for sign-in"}
+                      </span>
+                    </div>
+                    <div className="row-actions">
+                      <button
+                        className="text-button"
+                        disabled={busy}
+                        onClick={() => open("rename", key)}
+                      >
+                        Rename
+                      </button>
+                      <button
+                        className="text-button danger"
+                        disabled={
+                          busy ||
+                          (!account.user.hasPassword &&
+                            account.passkeys.length === 1)
+                        }
+                        onClick={() => open("delete", key)}
+                        title={
+                          !account.user.hasPassword &&
+                          account.passkeys.length === 1
+                            ? "Add another passkey before removing your last sign-in method"
+                            : undefined
+                        }
+                      >
+                        Remove
+                      </button>
+                    </div>
+                  </li>
+                ))}
+              </ul>
+            ) : (
+              <div className="passkey-empty">
+                <FingerPrintIcon width={35} />
+                <h3>Your next sign-in, simplified.</h3>
+                <p>
+                  Add your first passkey to sign in securely without typing a
+                  password.
+                </p>
+              </div>
+            )}
+            <div className="panel-bottom">
+              <button
+                className="auth-button primary compact"
+                disabled={busy || !supported}
+                onClick={() => open("add")}
+              >
+                <PlusIcon width={18} /> Add a passkey
+              </button>
+              <p className="auth-hint">
+                {!supported
+                  ? "Passkeys require a supported browser and HTTPS or localhost."
+                  : "You can add multiple devices or security keys."}
+              </p>
+            </div>
+          </section>
+          <section className="verification-panel">
+            <div className="panel-title">
+              <div className="panel-icon">
+                <KeyIcon width={22} />
+              </div>
+              <div>
+                <h2>Verify it’s you</h2>
+                <p>Confirm your identity before making security changes.</p>
+              </div>
+            </div>
+            <button
+              className="auth-button secondary compact"
+              disabled={busy}
+              onClick={() => open("verify")}
+            >
+              <ShieldCheckIcon width={18} /> Verify identity
+            </button>
+          </section>
+          {!account.user.hasPassword && (
+            <p className="security-note">
+              Keep a backup passkey on another device or security key. Your last
+              passkey cannot be removed without another sign-in method.
+            </p>
+          )}
+          <p className="security-note">
+            For your protection, security changes require verification within
+            the last 5 minutes.
+          </p>
+        </>
+      )}
+      <dialog
+        ref={dialog}
+        className="security-dialog"
+        aria-labelledby="security-dialog-title"
+        onCancel={(event) => {
+          if (busy) event.preventDefault();
+          else setModal(null);
+        }}
+      >
+        <form onSubmit={submit}>
+          <div className="dialog-heading">
+            <h2 id="security-dialog-title">
+              {modal === "add"
+                ? "Add a passkey"
+                : modal === "rename"
+                  ? "Rename passkey"
+                  : modal === "delete"
+                    ? "Remove passkey?"
+                    : "Verify your identity"}
+            </h2>
+            <button
+              aria-label="Close dialog"
+              className="close-button"
+              type="button"
+              disabled={busy}
+              onClick={() => setModal(null)}
+            >
+              ×
+            </button>
+          </div>
+          {error && (
+            <div className="auth-alert" role="alert">
+              {error}
+            </div>
+          )}
+          {(modal === "add" || modal === "rename") && (
+            <>
+              <p className="auth-description">
+                Give this passkey a name you’ll recognize, like “Personal
+                laptop” or “Security key”.
+              </p>
+              <label className="auth-label" htmlFor="passkey-name">
+                Passkey name
+              </label>
+              <input
+                autoFocus
+                className="auth-input"
+                id="passkey-name"
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                required
+                maxLength={64}
+                disabled={busy}
+                placeholder="e.g. Personal laptop"
+              />
+              <button
+                className="auth-button primary"
+                disabled={busy || !name.trim()}
+              >
+                {busy
+                  ? "Please wait…"
+                  : modal === "add"
+                    ? "Continue to create passkey"
+                    : "Save name"}
+              </button>
+            </>
+          )}
+          {modal === "delete" && (
+            <>
+              <p className="auth-description">
+                Remove <strong>{selected?.name}</strong> from your account? It
+                will no longer work for signing in. You may also need to remove
+                it from your device’s passkey manager.
+              </p>
+              <button className="auth-button destructive" disabled={busy}>
+                {busy ? "Removing…" : "Remove passkey"}
+              </button>
+            </>
+          )}
+          {modal === "verify" && (
+            <>
+              <p className="auth-description">
+                Use a passkey or your password to confirm it’s you. Verification
+                is valid for 5 minutes.
+              </p>
+              {account?.passkeys.length ? (
+                <button
+                  type="button"
+                  className="auth-button primary"
+                  disabled={busy || !supported}
+                  onClick={() =>
+                    void run(
+                      () => authenticatePasskey(true),
+                      "Identity verified. You can now manage your passkeys.",
+                    )
+                  }
+                >
+                  <FingerPrintIcon width={20} />
+                  {busy ? "Verifying…" : "Verify with a passkey"}
+                </button>
+              ) : null}
+              {account?.user.hasPassword && (
+                <>
+                  <label className="auth-label" htmlFor="verify-password">
+                    Current password
+                  </label>
+                  <input
+                    className="auth-input"
+                    id="verify-password"
+                    type="password"
+                    autoComplete="current-password"
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    required
+                    maxLength={256}
+                    disabled={busy}
+                  />
+                  <button
+                    className="auth-button secondary"
+                    disabled={busy || !password}
+                  >
+                    {busy ? "Verifying…" : "Verify with password"}
+                  </button>
+                </>
+              )}
+            </>
+          )}
+          <button
+            type="button"
+            className="dialog-cancel"
+            disabled={busy}
+            onClick={() => setModal(null)}
+          >
+            Cancel
+          </button>
+        </form>
+      </dialog>
+    </div>
+  );
+}
diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..911b3b2
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,163 @@
+import { useEffect, useState, type FormEvent } from "react";
+import {
+  FingerPrintIcon,
+  ArrowRightIcon,
+  ShieldCheckIcon,
+} from "@heroicons/react/24/outline";
+import {
+  accountURL,
+  api,
+  authenticatePasskey,
+  errorMessage,
+  registerPasskey,
+  supportsPasskeys,
+} from "../lib/auth-client";
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [supported, setSupported] = useState(false);
+  const [ready, setReady] = useState(false);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    setSupported(supportsPasskeys());
+    setReady(true);
+  }, []);
+  async function submit(kind: "passkey" | "password") {
+    setError("");
+    setBusy(kind);
+    try {
+      if (kind === "passkey") {
+        if (signup) await registerPasskey(username);
+        else await authenticatePasskey();
+      } else
+        await api(`password/${signup ? "register" : "login"}`, {
+          username,
+          password,
+        });
+      window.location.assign(accountURL);
+    } catch (error) {
+      setError(errorMessage(error));
+    } finally {
+      setBusy(null);
+    }
+  }
+  function passwordSubmit(event: FormEvent) {
+    event.preventDefault();
+    void submit("password");
+  }
+  return (
+    <div className="auth-card">
+      <div className="auth-symbol">
+        <FingerPrintIcon width={30} />
+      </div>
+      <p className="auth-eyebrow">YOUR DEVTOOLS TIMES ACCOUNT</p>
+      <h1>{signup ? "Make yourself at home." : "Welcome back."}</h1>
+      <p className="auth-description">
+        {signup
+          ? "Your next great read starts here. Create an account with a passkey or password."
+          : "Sign in to keep your reading list close and your curiosity going."}
+      </p>
+      {error && (
+        <div className="auth-alert" role="alert">
+          {error}
+        </div>
+      )}
+      <form onSubmit={passwordSubmit}>
+        <label className="auth-label" htmlFor="username">
+          Username
+        </label>
+        <input
+          className="auth-input"
+          id="username"
+          name="username"
+          autoComplete="username webauthn"
+          value={username}
+          onChange={(e) => setUsername(e.target.value)}
+          required
+          minLength={3}
+          maxLength={64}
+          pattern="[a-zA-Z0-9_.\-]+"
+          disabled={!!busy}
+          placeholder="Your username"
+        />
+        {signup && (
+          <p className="auth-hint">
+            3–64 letters, numbers, dots, underscores, or hyphens.
+          </p>
+        )}
+        <button
+          className="auth-button primary"
+          type="button"
+          disabled={
+            !supported ||
+            !!busy ||
+            (signup && !/^[a-zA-Z0-9_.-]{3,64}$/.test(username.trim()))
+          }
+          onClick={() => void submit("passkey")}
+        >
+          <FingerPrintIcon width={20} />
+          {busy === "passkey"
+            ? "Waiting for your device…"
+            : signup
+              ? "Create account with a passkey"
+              : "Sign in with a passkey"}
+          <ArrowRightIcon width={17} />
+        </button>
+        <p className="auth-hint centered">
+          {ready && !supported
+            ? "Passkeys need a supported browser and HTTPS or localhost. You can use a password below."
+            : "Use your fingerprint, face, screen lock, or security key."}
+        </p>
+        <div className="auth-divider">
+          <span>or use a password</span>
+        </div>
+        <label className="auth-label" htmlFor="password">
+          Password
+        </label>
+        <input
+          className="auth-input"
+          id="password"
+          name="password"
+          type="password"
+          autoComplete={signup ? "new-password" : "current-password"}
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          required
+          minLength={signup ? 8 : undefined}
+          maxLength={256}
+          disabled={!!busy}
+          placeholder={signup ? "Create a password" : "Your password"}
+        />
+        {signup && (
+          <p className="auth-hint">
+            At least 8 characters, including a number.
+          </p>
+        )}
+        <button
+          className="auth-button secondary"
+          type="submit"
+          disabled={!!busy}
+        >
+          {busy === "password"
+            ? "Please wait…"
+            : signup
+              ? "Create account with a password"
+              : "Sign in with a password"}
+        </button>
+      </form>
+      <p className="auth-switch">
+        {signup ? "Already have an account?" : "New to The DevTools Times?"}{" "}
+        <a href={`${import.meta.env.BASE_URL}${signup ? "signin" : "signup"}`}>
+          {signup ? "Sign in" : "Create an account"}{" "}
+          <span aria-hidden="true">↗</span>
+        </a>
+      </p>
+      <div className="auth-footer">
+        <ShieldCheckIcon width={16} />
+        <span>Passkeys keep your account secure, without a password.</span>
+      </div>
+    </div>
+  );
+}
