diff --git a/tests/auth-store.test.ts b/tests/auth-store.test.ts
new file mode 100644
index 0000000..5a5682d
--- /dev/null
+++ b/tests/auth-store.test.ts
@@ -0,0 +1,64 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  AuthStore,
+  hashPassword,
+  checkPassword,
+  digest,
+} from "../src/lib/server/auth-store";
+
+test("passwords are salted, checked, and never stored as plaintext", async () => {
+  const first = await hashPassword("test-password-123");
+  const second = await hashPassword("test-password-123");
+  assert.notEqual(first, second);
+  assert.ok(!first.includes("test-password-123"));
+  assert.equal(await checkPassword("test-password-123", first), true);
+  assert.equal(await checkPassword("wrong-password", first), false);
+  assert.equal(await checkPassword("test-password-123", null), false);
+});
+
+test("sessions expire and challenges are purpose-bound, single-use, and expire", () => {
+  const store = new AuthStore(":memory:");
+  const raw = store.createSession();
+  const id = digest(raw);
+  assert.ok(store.session(id));
+  assert.equal(store.session(raw), undefined);
+  const challenge = {
+    session_id: id,
+    purpose: "reauth",
+    challenge: "random",
+    user_id: "user",
+    username: null,
+    expires: Date.now() + 300000,
+  };
+  store.saveChallenge(challenge);
+  assert.equal(store.consumeChallenge(id, "login"), undefined);
+  assert.equal(store.consumeChallenge(id, "reauth"), undefined);
+  store.saveChallenge(challenge);
+  assert.equal(store.consumeChallenge(id, "reauth")?.challenge, "random");
+  assert.equal(store.consumeChallenge(id, "reauth"), undefined);
+  store.saveChallenge({ ...challenge, expires: Date.now() - 1 });
+  assert.equal(store.consumeChallenge(id, "reauth"), undefined);
+  store.db.prepare("UPDATE sessions SET expires = 0").run();
+  assert.equal(store.session(id), undefined);
+  store.cleanup();
+  assert.equal(store.db.prepare("SELECT * FROM sessions").all().length, 0);
+  store.db.close();
+});
+
+test("rate limiting and transaction rollback preserve invariants", () => {
+  const store = new AuthStore(":memory:");
+  assert.equal(store.rateLimit("address", 2), true);
+  assert.equal(store.rateLimit("address", 2), true);
+  assert.equal(store.rateLimit("address", 2), false);
+  assert.throws(() =>
+    store.transaction(() => {
+      store.db
+        .prepare("INSERT INTO users VALUES (?, ?, NULL)")
+        .run("1", "reader");
+      throw new Error("rollback");
+    }),
+  );
+  assert.equal(store.byUsername("reader"), undefined);
+  store.db.close();
+});
diff --git a/tests/auth.integration.test.ts b/tests/auth.integration.test.ts
new file mode 100644
index 0000000..b5e8801
--- /dev/null
+++ b/tests/auth.integration.test.ts
@@ -0,0 +1,487 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  createHash,
+  generateKeyPairSync,
+  randomBytes,
+  sign,
+} from "node:crypto";
+import { DatabaseSync } from "node:sqlite";
+
+// Minimal CBOR encoder for the authenticator's COSE key and "none" attestation.
+function cbor(value: any): Buffer {
+  function header(major: number, length: number) {
+    if (length < 24) return Buffer.from([(major << 5) | length]);
+    if (length < 256) return Buffer.from([(major << 5) | 24, length]);
+    return Buffer.from([(major << 5) | 25, length >> 8, length & 255]);
+  }
+  if (typeof value === "number")
+    return header(value < 0 ? 1 : 0, value < 0 ? -value - 1 : value);
+  if (typeof value === "string") {
+    const b = Buffer.from(value);
+    return Buffer.concat([header(3, b.length), b]);
+  }
+  if (Buffer.isBuffer(value))
+    return Buffer.concat([header(2, value.length), value]);
+  if (value instanceof Map)
+    return Buffer.concat([
+      header(5, value.size),
+      ...[...value].flatMap(([k, v]) => [cbor(k), cbor(v)]),
+    ]);
+  throw new Error("Unsupported fixture value");
+}
+const hash = (v: string | Buffer) => createHash("sha256").update(v).digest();
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync("ec", {
+    namedCurve: "prime256v1",
+  });
+  const jwk = publicKey.export({ format: "jwk" });
+  const cose = cbor(
+    new Map<any, any>([
+      [1, 2],
+      [3, -7],
+      [-1, 1],
+      [-2, Buffer.from(jwk.x!, "base64url")],
+      [-3, Buffer.from(jwk.y!, "base64url")],
+    ]),
+  );
+  const idBytes = randomBytes(32);
+  const id = idBytes.toString("base64url");
+  let userHandle: string;
+  let counter = 0;
+  return {
+    id,
+    register(options: any, origin: string, flags = 0x45) {
+      userHandle = options.user.id;
+      const client = Buffer.from(
+        JSON.stringify({
+          type: "webauthn.create",
+          challenge: options.challenge,
+          origin,
+        }),
+      );
+      const data = Buffer.concat([
+        hash("localhost"),
+        Buffer.from([flags]),
+        Buffer.alloc(4),
+        Buffer.alloc(16),
+        Buffer.from([0, idBytes.length]),
+        idBytes,
+        cose,
+      ]);
+      const object = cbor(
+        new Map<any, any>([
+          ["fmt", "none"],
+          ["attStmt", new Map()],
+          ["authData", data],
+        ]),
+      );
+      return {
+        id,
+        rawId: id,
+        type: "public-key",
+        clientExtensionResults: {},
+        response: {
+          clientDataJSON: client.toString("base64url"),
+          attestationObject: object.toString("base64url"),
+          transports: ["internal"],
+        },
+      };
+    },
+    authenticate(options: any, origin: string, flags = 5) {
+      const client = Buffer.from(
+        JSON.stringify({
+          type: "webauthn.get",
+          challenge: options.challenge,
+          origin,
+        }),
+      );
+      const count = Buffer.alloc(4);
+      count.writeUInt32BE(++counter);
+      const data = Buffer.concat([
+        hash("localhost"),
+        Buffer.from([flags]),
+        count,
+      ]);
+      const signature = sign(
+        "sha256",
+        Buffer.concat([data, hash(client)]),
+        privateKey,
+      );
+      return {
+        id,
+        rawId: id,
+        type: "public-key",
+        clientExtensionResults: {},
+        response: {
+          clientDataJSON: client.toString("base64url"),
+          authenticatorData: data.toString("base64url"),
+          signature: signature.toString("base64url"),
+          userHandle,
+        },
+      };
+    },
+  };
+}
+
+test(
+  "HTTP passkey lifecycle with real signed WebAuthn responses",
+  { timeout: 60000 },
+  async (t) => {
+    const folder = mkdtempSync(join(tmpdir(), "times-auth-"));
+    const dbPath = join(folder, "auth.sqlite");
+    const port = 22000 + Math.floor(Math.random() * 10000);
+    const origin = `http://localhost:${port}`;
+    const base = `${origin}/devtools-times/`;
+    const server = spawn(process.execPath, ["dist/server/entry.mjs"], {
+      env: {
+        ...process.env,
+        HOST: "127.0.0.1",
+        PORT: String(port),
+        AUTH_DB_PATH: dbPath,
+        AUTH_ORIGIN: origin,
+      },
+      stdio: "pipe",
+    });
+    let output = "";
+    server.stderr.on("data", (chunk) => {
+      output += chunk;
+    });
+    t.after(async () => {
+      server.kill();
+      await new Promise((resolve) => server.once("exit", resolve));
+      rmSync(folder, { recursive: true, force: true });
+    });
+    let started = false;
+    for (let i = 0; i < 100; i++) {
+      try {
+        const res = await fetch(`${base}api/auth/account`);
+        if (res.ok) {
+          started = true;
+          break;
+        }
+      } catch {}
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    assert.ok(started, `Server did not start: ${output}`);
+    const db = new DatabaseSync(dbPath);
+    t.after(() => db.close());
+    function client() {
+      let cookie = "";
+      return async (action: string, body?: any, requestOrigin = origin) => {
+        const res = await fetch(`${base}api/auth/${action}`, {
+          method: body === undefined ? "GET" : "POST",
+          headers: {
+            cookie,
+            origin: requestOrigin,
+            "Content-Type": "application/json",
+          },
+          ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+        });
+        const nextCookie = res.headers
+          .getSetCookie()
+          .find((value) => value.startsWith("times_auth="))
+          ?.split(";")[0];
+        if (nextCookie?.startsWith("times_auth=")) cookie = nextCookie;
+        return {
+          status: res.status,
+          body: await res.json(),
+          cookie,
+          headers: res.headers,
+        };
+      };
+    }
+    await t.test(
+      "renders passkey entry points and protects the management page",
+      async () => {
+        const signin = await fetch(`${base}signin`);
+        assert.equal(signin.status, 200);
+        assert.match(await signin.text(), /Sign in with a passkey/);
+        const signup = await fetch(`${base}signup`);
+        assert.equal(signup.status, 200);
+        assert.match(await signup.text(), /Create account with a passkey/);
+        const security = await fetch(`${base}account/security`, {
+          redirect: "manual",
+        });
+        assert.equal(security.status, 302);
+        assert.match(security.headers.get("location")!, /signin$/);
+      },
+    );
+    const request = client();
+    const key = authenticator();
+    await t.test(
+      "registers a discoverable UV-required passkey and authenticates the account",
+      async () => {
+        const options = await request("registration/options", {
+          username: "reader",
+        });
+        assert.equal(options.status, 200);
+        assert.equal(
+          options.body.authenticatorSelection.residentKey,
+          "required",
+        );
+        assert.equal(
+          options.body.authenticatorSelection.userVerification,
+          "required",
+        );
+        assert.match(options.headers.get("set-cookie")!, /HttpOnly/i);
+        const result = await request("registration/verify", {
+          credential: key.register(options.body, origin),
+          name: "Laptop",
+        });
+        assert.equal(result.status, 200, JSON.stringify(result.body));
+        assert.equal((await request("account")).body.user.username, "reader");
+        assert.equal(
+          (await request("account")).body.passkeys[0].name,
+          "Laptop",
+        );
+        assert.equal(
+          db
+            .prepare("SELECT password FROM users WHERE username = ?")
+            .get("reader")!.password,
+          null,
+        );
+      },
+    );
+    await t.test(
+      "renames a passkey and prevents removing the last sign-in method",
+      async () => {
+        assert.equal(
+          (
+            await request("passkeys/rename", {
+              id: key.id,
+              name: "Work laptop",
+            })
+          ).status,
+          200,
+        );
+        assert.equal(
+          (await request("passkeys/delete", { id: key.id })).status,
+          409,
+        );
+      },
+    );
+    const backup = authenticator();
+    await t.test("adds a backup passkey and removes it", async () => {
+      const options = await request("registration/options", {});
+      assert.equal(options.body.excludeCredentials[0].id, key.id);
+      assert.equal(
+        (
+          await request("registration/verify", {
+            credential: backup.register(options.body, origin),
+            name: "Backup",
+          })
+        ).status,
+        200,
+      );
+      assert.equal((await request("account")).body.passkeys.length, 2);
+      assert.equal(
+        (await request("passkeys/delete", { id: backup.id })).status,
+        200,
+      );
+    });
+    await t.test(
+      "requires reauthentication for security changes after five minutes",
+      async () => {
+        db.prepare("UPDATE sessions SET verified_at = 0").run();
+        assert.equal(
+          (await request("passkeys/rename", { id: key.id, name: "Blocked" }))
+            .body.code,
+          "REAUTH_REQUIRED",
+        );
+        assert.equal(
+          (await request("registration/options", {})).body.code,
+          "REAUTH_REQUIRED",
+        );
+        const options = await request("reauthentication/options", {});
+        assert.equal(options.body.allowCredentials[0].id, key.id);
+        const proof = key.authenticate(options.body, origin);
+        assert.equal(
+          (await request("reauthentication/verify", { credential: proof }))
+            .status,
+          200,
+        );
+        assert.equal(
+          (
+            await request("passkeys/rename", {
+              id: key.id,
+              name: "Verified laptop",
+            })
+          ).status,
+          200,
+        );
+        assert.equal(
+          (await request("reauthentication/verify", { credential: proof }))
+            .status,
+          400,
+        );
+      },
+    );
+    await t.test(
+      "signs out, signs in without a username, rotates sessions, and rejects replay",
+      async () => {
+        await request("logout", {});
+        assert.equal((await request("account")).body.user, null);
+        const options = await request("authentication/options", {});
+        assert.ok(!options.body.allowCredentials?.length);
+        const oldCookie = options.cookie;
+        const proof = key.authenticate(options.body, origin);
+        const result = await request("authentication/verify", {
+          credential: proof,
+        });
+        assert.equal(result.status, 200);
+        assert.notEqual(result.cookie, oldCookie);
+        assert.equal(
+          (await request("authentication/verify", { credential: proof }))
+            .status,
+          400,
+        );
+        assert.ok((await request("account")).body.passkeys[0].lastUsed);
+      },
+    );
+    await t.test(
+      "rejects cross-origin requests, wrong authenticator origins, missing UV, and invalid signatures",
+      async () => {
+        assert.equal(
+          (await request("authentication/options", {}, "https://evil.example"))
+            .status,
+          403,
+        );
+        for (const variant of [
+          "origin",
+          "uv",
+          "signature",
+          "challenge",
+          "handle",
+        ]) {
+          const options = await request("authentication/options", {});
+          const proof = key.authenticate(
+            variant === "challenge"
+              ? { challenge: "wrong-challenge" }
+              : options.body,
+            variant === "origin" ? "https://evil.example" : origin,
+            variant === "uv" ? 1 : 5,
+          );
+          if (variant === "signature")
+            proof.response.signature = randomBytes(72).toString("base64url");
+          if (variant === "handle")
+            proof.response.userHandle =
+              Buffer.from("another-user").toString("base64url");
+          assert.ok(
+            (await request("authentication/verify", { credential: proof }))
+              .status >= 400,
+            variant,
+          );
+        }
+      },
+    );
+    await t.test(
+      "rejects expired challenges and requires registration user verification",
+      async () => {
+        const options = await request("authentication/options", {});
+        db.prepare("UPDATE challenges SET expires = 0").run();
+        assert.equal(
+          (
+            await request("authentication/verify", {
+              credential: key.authenticate(options.body, origin),
+            })
+          ).status,
+          400,
+        );
+        const badKey = authenticator();
+        const registration = await request("registration/options", {});
+        assert.equal(
+          (
+            await request("registration/verify", {
+              credential: badKey.register(registration.body, origin, 0x41),
+              name: "Unverified",
+            })
+          ).status,
+          400,
+        );
+      },
+    );
+    const other = client();
+    await t.test(
+      "password accounts support sign-in, password reauthentication, and credential ownership",
+      async () => {
+        assert.equal(
+          (
+            await other("password/register", {
+              username: "other",
+              password: "Password123",
+            })
+          ).status,
+          200,
+        );
+        assert.equal(
+          (await other("passkeys/rename", { id: key.id, name: "Stolen" }))
+            .status,
+          404,
+        );
+        const options = await other("authentication/options", {});
+        assert.equal(
+          (
+            await other("reauthentication/verify", {
+              credential: key.authenticate(options.body, origin),
+            })
+          ).status,
+          400,
+        );
+        db.prepare("UPDATE sessions SET verified_at = 0").run();
+        assert.equal(
+          (await other("reauthentication/password", { password: "wrong" }))
+            .status,
+          401,
+        );
+        assert.equal(
+          (
+            await other("reauthentication/password", {
+              password: "Password123",
+            })
+          ).status,
+          200,
+        );
+        await other("logout", {});
+        assert.equal(
+          (
+            await other("password/login", {
+              username: "OTHER",
+              password: "Password123",
+            })
+          ).status,
+          200,
+        );
+        assert.equal((await other("account")).body.user.username, "other");
+      },
+    );
+    await t.test(
+      "rejects attempts to attach a new account to an existing username",
+      async () => {
+        const stranger = client();
+        assert.equal(
+          (await stranger("registration/options", { username: "reader" }))
+            .status,
+          409,
+        );
+        assert.equal(
+          (
+            await stranger("password/register", {
+              username: "reader",
+              password: "Password123",
+            })
+          ).status,
+          409,
+        );
+        assert.equal(
+          (await stranger("passkeys/delete", { id: key.id })).status,
+          401,
+        );
+      },
+    );
+  },
+);
