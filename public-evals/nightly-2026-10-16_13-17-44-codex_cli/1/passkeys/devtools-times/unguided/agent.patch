@@ -0,0 +1,58 @@
+import {
+  browserSupportsWebAuthn,
+  startRegistration,
+  startAuthentication,
+} from "@simplewebauthn/browser";
+export const accountURL = `${import.meta.env.BASE_URL}account/security`;
+export class RequestError extends Error {
+  constructor(
+    message: string,
+    public code?: string,
+  ) {
+    super(message);
+  }
+}
+export async function api<T = any>(action: string, body?: unknown): Promise<T> {
+  const response = await fetch(
+    `${import.meta.env.BASE_URL}api/auth/${action}`,
+    body === undefined
+      ? { cache: "no-store" }
+      : {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(body),
+        },
+  );
+  const data = await response.json();
+  if (!response.ok)
+    throw new RequestError(data.error || "Please try again.", data.code);
+  return data;
+}
+export function supportsPasskeys() {
+  return window.isSecureContext && browserSupportsWebAuthn();
+}
+export async function registerPasskey(username?: string, name = "My passkey") {
+  const optionsJSON = await api("registration/options", { username });
+  const credential = await startRegistration({ optionsJSON });
+  return api("registration/verify", { credential, name });
+}
+export async function authenticatePasskey(reauth = false) {
+  const route = reauth ? "reauthentication" : "authentication";
+  const optionsJSON = await api(`${route}/options`, {});
+  const credential = await startAuthentication({ optionsJSON });
+  return api(`${route}/verify`, { credential });
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof Error) {
+    if (
+      error.name === "NotAllowedError" ||
+      error.name === "AbortError" ||
+      ("code" in error && error.code === "ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY")
+    )
+      return "The passkey request was canceled or timed out. You can try again.";
+    if (error.name === "InvalidStateError")
+      return "This device already has a passkey for your account. Try another device or security key.";
+    return error.message;
+  }
+  return "Something went wrong. Please try again.";
+}
diff --git a/src/lib/server/auth-store.ts b/src/lib/server/auth-store.ts
new file mode 100644
index 0000000..6d95e85
--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,171 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync, chmodSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import {
+  randomBytes,
+  createHash,
+  scrypt as derive,
+  timingSafeEqual,
+} from "node:crypto";
+import { promisify } from "node:util";
+
+const scrypt = promisify(derive);
+export const token = () => randomBytes(32).toString("base64url");
+export const digest = (value: string) =>
+  createHash("sha256").update(value).digest("hex");
+export type User = { id: string; username: string; password: string | null };
+export type Session = {
+  id: string;
+  user_id: string | null;
+  verified_at: number;
+  expires: number;
+};
+export type Passkey = {
+  id: string;
+  user_id: string;
+  public_key: Uint8Array;
+  counter: number;
+  transports: string;
+  name: string;
+  created_at: number;
+  last_used: number | null;
+  backed_up: number;
+};
+export type Challenge = {
+  session_id: string;
+  purpose: string;
+  challenge: string;
+  user_id: string | null;
+  username: string | null;
+  expires: number;
+};
+
+export class AuthStore {
+  db: DatabaseSync;
+  constructor(path: string) {
+    if (path !== ":memory:")
+      mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    this.db = new DatabaseSync(path);
+    if (path !== ":memory:") chmodSync(path, 0o600);
+    this.db
+      .exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON; PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE COLLATE NOCASE, password TEXT);
+      CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), verified_at INTEGER NOT NULL DEFAULT 0, expires INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, created_at INTEGER NOT NULL, last_used INTEGER, backed_up INTEGER NOT NULL);
+      CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(user_id);
+      CREATE TABLE IF NOT EXISTS challenges (session_id TEXT PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE, purpose TEXT NOT NULL, challenge TEXT NOT NULL, user_id TEXT, username TEXT, expires INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS rate_limits (id TEXT PRIMARY KEY, attempts INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+  }
+  transaction<T>(fn: () => T): T {
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const result = fn();
+      this.db.exec("COMMIT");
+      return result;
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+  user(id: string) {
+    return this.db.prepare("SELECT * FROM users WHERE id = ?").get(id) as
+      User | undefined;
+  }
+  byUsername(username: string) {
+    return this.db
+      .prepare("SELECT * FROM users WHERE username = ?")
+      .get(username) as User | undefined;
+  }
+  keys(userId: string) {
+    return this.db
+      .prepare(
+        "SELECT * FROM passkeys WHERE user_id = ? ORDER BY created_at DESC",
+      )
+      .all(userId) as Passkey[];
+  }
+  key(id: string) {
+    return this.db.prepare("SELECT * FROM passkeys WHERE id = ?").get(id) as
+      Passkey | undefined;
+  }
+  session(id: string) {
+    return this.db
+      .prepare("SELECT * FROM sessions WHERE id = ? AND expires > ?")
+      .get(id, Date.now()) as Session | undefined;
+  }
+  createSession(userId: string | null = null) {
+    const raw = token();
+    this.db
+      .prepare("INSERT INTO sessions VALUES (?, ?, ?, ?)")
+      .run(
+        digest(raw),
+        userId,
+        userId ? Date.now() : 0,
+        Date.now() + (userId ? 7 * 86400000 : 600000),
+      );
+    return raw;
+  }
+  saveChallenge(value: Challenge) {
+    this.db
+      .prepare("INSERT OR REPLACE INTO challenges VALUES (?, ?, ?, ?, ?, ?)")
+      .run(
+        value.session_id,
+        value.purpose,
+        value.challenge,
+        value.user_id,
+        value.username,
+        value.expires,
+      );
+  }
+  consumeChallenge(sessionId: string, purpose: string) {
+    const challenge = this.db
+      .prepare("DELETE FROM challenges WHERE session_id = ? RETURNING *")
+      .get(sessionId) as Challenge | undefined;
+    return challenge &&
+      challenge.purpose === purpose &&
+      challenge.expires > Date.now()
+      ? challenge
+      : undefined;
+  }
+  rateLimit(id: string, maximum: number) {
+    const now = Date.now();
+    this.db.prepare("DELETE FROM rate_limits WHERE expires <= ?").run(now);
+    const row = this.db
+      .prepare(
+        `INSERT INTO rate_limits VALUES (?, 1, ?) ON CONFLICT(id) DO UPDATE SET attempts = attempts + 1 RETURNING attempts`,
+      )
+      .get(id, now + 60000) as { attempts: number };
+    return row.attempts <= maximum;
+  }
+  cleanup() {
+    this.db.prepare("DELETE FROM sessions WHERE expires <= ?").run(Date.now());
+    this.db
+      .prepare("DELETE FROM challenges WHERE expires <= ?")
+      .run(Date.now());
+  }
+}
+let instance: AuthStore;
+export const getStore = () =>
+  (instance ??= new AuthStore(
+    resolve(process.env.AUTH_DB_PATH || ".data/auth.sqlite"),
+  ));
+export async function hashPassword(password: string) {
+  const salt = token();
+  const key = (await scrypt(password, salt, 64)) as Buffer;
+  return `${salt}:${key.toString("hex")}`;
+}
+// Use an equal-cost derivation even when an account has no password or does not exist.
+export async function checkPassword(
+  password: string,
+  encoded: string | null | undefined,
+) {
+  const [salt, hex] = (encoded || `${"0".repeat(43)}:${"0".repeat(128)}`).split(
+    ":",
+  );
+  const actual = (await scrypt(password, salt, 64)) as Buffer;
+  const expected = Buffer.from(hex, "hex");
+  return (
+    Boolean(encoded) &&
+    actual.length === expected.length &&
+    timingSafeEqual(actual, expected)
+  );
+}
diff --git a/src/lib/server/auth.ts b/src/lib/server/auth.ts
new file mode 100644
index 0000000..e5ead0b
--- /dev/null
+++ b/src/lib/server/auth.ts
@@ -0,0 +1,86 @@
+import type { APIContext } from "astro";
+import { digest, getStore, type Session } from "./auth-store";
+export class AuthError extends Error {
+  constructor(
+    message: string,
+    public status = 400,
+    public code = "AUTH_ERROR",
+  ) {
+    super(message);
+  }
+}
+export function configuration(context: Pick<APIContext, "url">) {
+  const origin = new URL(process.env.AUTH_ORIGIN || context.url.origin).origin;
+  const url = new URL(origin);
+  if (
+    url.protocol !== "https:" &&
+    !["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)
+  ) {
+    throw new AuthError("Passkeys require HTTPS (or localhost).", 400);
+  }
+  return { origin, rpID: url.hostname };
+}
+export function currentSession(context: Pick<APIContext, "cookies">) {
+  const raw = context.cookies.get("times_auth")?.value;
+  return raw ? getStore().session(digest(raw)) : undefined;
+}
+export function requireSession(context: Pick<APIContext, "cookies">) {
+  const session = currentSession(context);
+  if (!session?.user_id)
+    throw new AuthError("Please sign in to continue.", 401);
+  return session;
+}
+export function requireRecent(session: Session) {
+  if (session.verified_at < Date.now() - 300000)
+    throw new AuthError(
+      "Verify your identity to continue.",
+      403,
+      "REAUTH_REQUIRED",
+    );
+}
+export function setSessionCookie(
+  context: Pick<APIContext, "cookies" | "url">,
+  raw: string,
+) {
+  context.cookies.set("times_auth", raw, {
+    httpOnly: true,
+    secure: configuration(context).origin.startsWith("https:"),
+    sameSite: "lax",
+    path: import.meta.env.BASE_URL,
+    maxAge: 7 * 86400,
+  });
+}
+export function rotateSession(
+  context: APIContext,
+  previous: Session | undefined,
+  userId: string,
+) {
+  const store = getStore();
+  const raw = store.transaction(() => {
+    if (previous)
+      store.db.prepare("DELETE FROM sessions WHERE id = ?").run(previous.id);
+    return store.createSession(userId);
+  });
+  setSessionCookie(context, raw);
+}
+export function usernameInput(value: unknown) {
+  if (typeof value !== "string" || !/^[a-zA-Z0-9_.-]{3,64}$/.test(value.trim()))
+    throw new AuthError(
+      "Use 3–64 letters, numbers, dots, underscores, or hyphens for your username.",
+    );
+  return value.trim().toLowerCase();
+}
+export function nameInput(value: unknown) {
+  if (typeof value !== "string" || !value.trim() || value.trim().length > 64)
+    throw new AuthError("Enter a passkey name between 1 and 64 characters.");
+  return value.trim();
+}
+export function json(value: unknown, status = 200) {
+  return new Response(JSON.stringify(value), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+}
