index 0000000..10f987a
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,372 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import {
+  getStore,
+  token,
+  hashPassword,
+  checkPassword,
+  type Session,
+} from "../../../lib/server/auth-store";
+import {
+  AuthError,
+  configuration,
+  currentSession,
+  requireSession,
+  requireRecent,
+  setSessionCookie,
+  rotateSession,
+  usernameInput,
+  nameInput,
+  json,
+} from "../../../lib/server/auth";
+
+export const ALL: APIRoute = async (context) => {
+  const { request, params } = context;
+  const store = getStore();
+  try {
+    const { origin, rpID } = configuration(context);
+    const action = params.action;
+    if (request.method === "GET" && action === "account") {
+      const session = currentSession(context);
+      const user = session?.user_id ? store.user(session.user_id) : undefined;
+      return json(
+        user
+          ? {
+              user: {
+                username: user.username,
+                hasPassword: Boolean(user.password),
+              },
+              recent: session!.verified_at > Date.now() - 300000,
+              passkeys: store
+                .keys(user.id)
+                .map((key) => ({
+                  id: key.id,
+                  name: key.name,
+                  createdAt: key.created_at,
+                  lastUsed: key.last_used,
+                  backedUp: Boolean(key.backed_up),
+                })),
+            }
+          : { user: null },
+      );
+    }
+    if (request.method !== "POST")
+      throw new AuthError("Method not allowed.", 405);
+    if (request.headers.get("origin") !== origin)
+      throw new AuthError("Request origin is not allowed.", 403);
+    if (!request.headers.get("content-type")?.startsWith("application/json"))
+      throw new AuthError("JSON is required.", 415);
+    // Limit expensive password operations and WebAuthn attempts by client address, not cookies.
+    let address: string;
+    try {
+      address = context.clientAddress;
+    } catch {
+      address = "local";
+    }
+    if (
+      !store.rateLimit(address, 60) ||
+      ((action?.startsWith("password/") ||
+        action === "reauthentication/password") &&
+        !store.rateLimit(`password:${address}`, 10))
+    )
+      throw new AuthError(
+        "Too many attempts. Please try again in a minute.",
+        429,
+      );
+    if (Number(request.headers.get("content-length")) > 65536)
+      throw new AuthError("Request too large.", 413);
+    const text = await request.text();
+    if (text.length > 65536) throw new AuthError("Request too large.", 413);
+    let body;
+    try {
+      body = JSON.parse(text);
+    } catch {
+      throw new AuthError("Invalid JSON.");
+    }
+    if (!body || typeof body !== "object" || Array.isArray(body))
+      throw new AuthError("Invalid request.");
+    store.cleanup();
+    let session = currentSession(context);
+    const anonymous = (): Session => {
+      if (!session) {
+        const raw = store.createSession();
+        setSessionCookie(context, raw);
+        session = currentSession(context);
+      }
+      return session!;
+    };
+    if (action === "password/register" || action === "password/login") {
+      const username = usernameInput(body.username);
+      if (typeof body.password !== "string" || body.password.length > 256)
+        throw new AuthError("Enter a valid password (up to 256 characters).");
+      if (action === "password/register") {
+        if (body.password.length < 8 || !/\d/.test(body.password))
+          throw new AuthError(
+            "Your password must have at least 8 characters and a number.",
+          );
+        const password = await hashPassword(body.password);
+        const id = token();
+        store.transaction(() => {
+          if (store.byUsername(username))
+            throw new AuthError("That username is unavailable.", 409);
+          store.db
+            .prepare("INSERT INTO users VALUES (?, ?, ?)")
+            .run(id, username, password);
+        });
+        rotateSession(context, session, id);
+      } else {
+        const user = store.byUsername(username);
+        if (!(await checkPassword(body.password, user?.password)))
+          throw new AuthError("Incorrect username or password.", 401);
+        rotateSession(context, session, user!.id);
+      }
+      return json({ verified: true });
+    }
+    if (action === "logout") {
+      if (session)
+        store.db.prepare("DELETE FROM sessions WHERE id = ?").run(session.id);
+      context.cookies.delete("times_auth", { path: import.meta.env.BASE_URL });
+      return json({ ok: true });
+    }
+    if (action === "registration/options") {
+      const existing = session?.user_id
+        ? store.user(session.user_id)
+        : undefined;
+      if (existing) requireRecent(session!);
+      const username = existing?.username || usernameInput(body.username);
+      if (!existing && store.byUsername(username))
+        throw new AuthError(
+          "That username is unavailable. Sign in to add a passkey to an existing account.",
+          409,
+        );
+      const userId = existing?.id || token();
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID,
+        userName: username,
+        userID: new TextEncoder().encode(userId),
+        attestationType: "none",
+        authenticatorSelection: {
+          residentKey: "required",
+          userVerification: "required",
+        },
+        excludeCredentials: existing
+          ? store
+              .keys(userId)
+              .map((key) => ({
+                id: key.id,
+                transports: JSON.parse(key.transports),
+              }))
+          : [],
+      });
+      const active = anonymous();
+      store.saveChallenge({
+        session_id: active.id,
+        purpose: existing ? "add" : "register",
+        challenge: options.challenge,
+        user_id: userId,
+        username,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (action === "registration/verify") {
+      const active = anonymous();
+      const purpose = active.user_id ? "add" : "register";
+      const challenge = store.consumeChallenge(active.id, purpose);
+      if (
+        !challenge ||
+        (purpose === "add" && challenge.user_id !== active.user_id)
+      )
+        throw new AuthError("Registration expired. Please try again.");
+      if (purpose === "add") requireRecent(active);
+      const name = nameInput(body.name || "My passkey");
+      const result = await verifyRegistrationResponse({
+        response: body.credential,
+        expectedChallenge: challenge.challenge,
+        expectedOrigin: origin,
+        expectedRPID: rpID,
+        requireUserVerification: true,
+      });
+      if (!result.verified) throw new AuthError("Passkey verification failed.");
+      const info = result.registrationInfo;
+      store.transaction(() => {
+        if (purpose === "register") {
+          if (store.byUsername(challenge.username!))
+            throw new AuthError("That username is unavailable.", 409);
+          store.db
+            .prepare("INSERT INTO users VALUES (?, ?, NULL)")
+            .run(challenge.user_id, challenge.username);
+        }
+        if (store.key(info.credential.id))
+          throw new AuthError("This passkey is already registered.", 409);
+        store.db
+          .prepare("INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, NULL, ?)")
+          .run(
+            info.credential.id,
+            challenge.user_id,
+            info.credential.publicKey,
+            info.credential.counter,
+            JSON.stringify(info.credential.transports || []),
+            name,
+            Date.now(),
+            Number(info.credentialBackedUp),
+          );
+      });
+      if (purpose === "register")
+        rotateSession(context, active, challenge.user_id!);
+      return json({ verified: true });
+    }
+    if (
+      action === "authentication/options" ||
+      action === "reauthentication/options"
+    ) {
+      const reauth = action.startsWith("reauthentication");
+      const active = reauth ? requireSession(context) : anonymous();
+      const keys = reauth ? store.keys(active.user_id!) : [];
+      if (reauth && !keys.length)
+        throw new AuthError("Add a passkey before using passkey verification.");
+      const options = await generateAuthenticationOptions({
+        rpID,
+        userVerification: "required",
+        ...(reauth
+          ? {
+              allowCredentials: keys.map((key) => ({
+                id: key.id,
+                transports: JSON.parse(key.transports),
+              })),
+            }
+          : {}),
+      });
+      store.saveChallenge({
+        session_id: active.id,
+        purpose: reauth ? "reauth" : "login",
+        challenge: options.challenge,
+        user_id: reauth ? active.user_id : null,
+        username: null,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (
+      action === "authentication/verify" ||
+      action === "reauthentication/verify"
+    ) {
+      const reauth = action.startsWith("reauthentication");
+      const active = reauth ? requireSession(context) : anonymous();
+      const challenge = store.consumeChallenge(
+        active.id,
+        reauth ? "reauth" : "login",
+      );
+      if (!challenge)
+        throw new AuthError("Verification expired. Please try again.");
+      const key =
+        typeof body.credential?.id === "string"
+          ? store.key(body.credential.id)
+          : undefined;
+      if (
+        !key ||
+        (reauth &&
+          (key.user_id !== active.user_id ||
+            challenge.user_id !== active.user_id))
+      )
+        throw new AuthError("This passkey could not be verified.", 401);
+      const userHandle = body.credential.response?.userHandle;
+      if (
+        (!reauth && !userHandle) ||
+        (userHandle &&
+          userHandle !== Buffer.from(key.user_id).toString("base64url"))
+      )
+        throw new AuthError("This passkey could not be verified.", 401);
+      const result = await verifyAuthenticationResponse({
+        response: body.credential,
+        expectedChallenge: challenge.challenge,
+        expectedOrigin: origin,
+        expectedRPID: rpID,
+        requireUserVerification: true,
+        credential: {
+          id: key.id,
+          publicKey: new Uint8Array(key.public_key),
+          counter: key.counter,
+          transports: JSON.parse(key.transports),
+        },
+      });
+      if (!result.verified)
+        throw new AuthError("Passkey verification failed.", 401);
+      const updated = store.db
+        .prepare(
+          "UPDATE passkeys SET counter = ?, last_used = ?, backed_up = ? WHERE id = ? AND counter = ?",
+        )
+        .run(
+          result.authenticationInfo.newCounter,
+          Date.now(),
+          Number(result.authenticationInfo.credentialBackedUp),
+          key.id,
+          key.counter,
+        );
+      if (!updated.changes)
+        throw new AuthError(
+          "Passkey changed during verification. Please try again.",
+          409,
+        );
+      rotateSession(context, active, key.user_id);
+      return json({ verified: true });
+    }
+    if (action === "reauthentication/password") {
+      const active = requireSession(context);
+      const user = store.user(active.user_id!)!;
+      if (
+        typeof body.password !== "string" ||
+        body.password.length > 256 ||
+        !(await checkPassword(body.password, user.password))
+      )
+        throw new AuthError("Incorrect password.", 401);
+      rotateSession(context, active, user.id);
+      return json({ verified: true });
+    }
+    if (action === "passkeys/rename" || action === "passkeys/delete") {
+      const active = requireSession(context);
+      requireRecent(active);
+      if (typeof body.id !== "string") throw new AuthError("Choose a passkey.");
+      store.transaction(() => {
+        const key = store.key(body.id);
+        if (!key || key.user_id !== active.user_id)
+          throw new AuthError("Passkey not found.", 404);
+        if (action.endsWith("rename"))
+          store.db
+            .prepare("UPDATE passkeys SET name = ? WHERE id = ?")
+            .run(nameInput(body.name), key.id);
+        else {
+          if (
+            !store.user(active.user_id!)!.password &&
+            store.keys(active.user_id!).length <= 1
+          )
+            throw new AuthError(
+              "Add another passkey before removing your last sign-in method.",
+              409,
+            );
+          store.db.prepare("DELETE FROM passkeys WHERE id = ?").run(key.id);
+        }
+      });
+      return json({ ok: true });
+    }
+    throw new AuthError("Not found.", 404);
+  } catch (error) {
+    if (error instanceof AuthError)
+      return json({ error: error.message, code: error.code }, error.status);
+    // Never send authenticator internals, credentials, or database errors to the client.
+    console.error(
+      "Authentication request failed:",
+      error instanceof Error ? error.name : "UnknownError",
+    );
+    return json(
+      { error: "Verification could not be completed. Please try again." },
+      400,
+    );
+  }
+};
