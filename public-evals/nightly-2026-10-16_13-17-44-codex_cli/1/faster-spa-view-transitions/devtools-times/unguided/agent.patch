diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..59e545b
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,81 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Hash changes share a view; query strings may represent different content.
+export function viewKey(url: URL): string {
+  return url.origin + url.pathname + url.search;
+}
+
+export class ViewCache {
+  private views = new Map<string, HTMLElement>();
+  private active: HTMLElement;
+  private host: HTMLElement;
+  private limit: number;
+
+  constructor(
+    host: HTMLElement,
+    initialView: HTMLElement,
+    initialUrl: URL,
+    limit = 6,
+  ) {
+    this.host = host;
+    this.limit = Math.max(1, limit);
+    this.active = initialView;
+    this.remember(viewKey(initialUrl), initialView);
+  }
+
+  private remember(key: string, view: HTMLElement) {
+    if (view.dataset.cacheView === "false") return;
+    this.views.delete(key);
+    this.views.set(key, view);
+  }
+
+  activate(url: URL, incoming: HTMLElement) {
+    const key = viewKey(url);
+    const view = this.views.get(key) ?? incoming;
+
+    if (this.active !== view) {
+      this.active.hidden = true;
+      this.active.inert = true;
+      if (this.active.dataset.cacheView === "false") this.active.remove();
+    }
+
+    view.hidden = false;
+    view.inert = false;
+    if (view.parentElement !== this.host) this.host.append(view);
+    this.active = view;
+    this.remember(key, view);
+
+    // Bound retained DOM using least recently used eviction.
+    while (this.views.size > this.limit) {
+      const oldest = this.views.keys().next().value!;
+      this.views.get(oldest)!.remove();
+      this.views.delete(oldest);
+    }
+  }
+}
+
+export function installViewCache() {
+  const host = document.querySelector<HTMLElement>("[data-view-cache]");
+  const initial = host?.querySelector<HTMLElement>(":scope > main");
+  if (!host || !initial) return;
+
+  const cache = new ViewCache(host, initial, new URL(location.href));
+
+  document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
+    const incoming = event.newDocument.querySelector<HTMLElement>("[data-view-cache] > main");
+    if (!incoming) return;
+
+    const swap = event.swap;
+    event.swap = () => {
+      // Do not let Astro restore focus into a view that is about to be hidden.
+      const focused = document.activeElement;
+      if (focused instanceof HTMLElement && host.contains(focused)) focused.blur();
+
+      // Astro retains the host, updates the head, and handles history/scroll as usual.
+      // Activate before astro:after-swap so retained islands stay mounted and new
+      // islands and page scripts participate in the normal hydration lifecycle.
+      swap();
+      cache.activate(event.to, incoming);
+    };
+  });
+}
diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..f6268a4
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,159 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+import { ViewCache, installViewCache, viewKey } from '../src/scripts/view-cache.ts';
+
+const url = (path) => new URL(path, 'https://example.com/devtools-times/');
+
+function setup(limit = 6) {
+  const window = new Window({ url: url('').href });
+  const { document } = window;
+  const host = document.createElement('div');
+  host.dataset.viewCache = '';
+  document.body.append(host);
+  const initial = document.createElement('main');
+  initial.innerHTML = '<input><button>Save</button>';
+  host.append(initial);
+  const cache = new ViewCache(host, initial, url(''), limit);
+  const makeView = () => document.createElement('main');
+  return { window, document, host, initial, cache, makeView };
+}
+
+test('return navigation preserves exact nodes, input values, and event listeners', () => {
+  const { cache, initial, host, makeView } = setup();
+  const input = initial.querySelector('input');
+  input.value = 'Keep this value';
+  let clicks = 0;
+  const button = initial.querySelector('button');
+  button.addEventListener('click', () => clicks++);
+
+  const article = makeView();
+  cache.activate(url('articles/example'), article);
+  assert.equal(initial.isConnected, true);
+  assert.equal(initial.hidden, true);
+  assert.equal(initial.inert, true);
+
+  const replacement = makeView();
+  cache.activate(url(''), replacement);
+  assert.equal(initial.querySelector('input'), input);
+  assert.equal(input.value, 'Keep this value');
+  button.click();
+  assert.equal(clicks, 1);
+  assert.equal(replacement.isConnected, false);
+  assert.equal(initial.hidden, false);
+  assert.equal(initial.inert, false);
+  assert.equal(article.hidden, true);
+  assert.equal(host.querySelectorAll('main:not([hidden])').length, 1);
+});
+
+test('keys separate query strings and share hash-only destinations', () => {
+  const { cache, initial, makeView } = setup();
+  assert.equal(viewKey(url('#section')), viewKey(url('')));
+  assert.notEqual(viewKey(url('?page=1')), viewKey(url('?page=2')));
+  const filtered = makeView();
+  cache.activate(url('?page=1'), filtered);
+  cache.activate(url('#section'), makeView());
+  assert.equal(initial.hidden, false);
+  assert.equal(filtered.hidden, true);
+  cache.activate(url('?page=1#details'), makeView());
+  assert.equal(filtered.hidden, false);
+});
+
+test('eviction removes the least recently used view and allows a fresh visit', () => {
+  const { cache, initial, host, makeView } = setup(2);
+  const second = makeView();
+  cache.activate(url('second'), second);
+  cache.activate(url(''), makeView());
+  cache.activate(url('third'), makeView());
+  assert.equal(second.isConnected, false);
+  assert.equal(initial.isConnected, true);
+  assert.equal(host.children.length, 2);
+
+  const freshSecond = makeView();
+  cache.activate(url('second'), freshSecond);
+  assert.equal(freshSecond.isConnected, true);
+  assert.equal(initial.isConnected, false);
+  assert.equal(host.children.length, 2);
+});
+
+test('excluded views are removed on departure and recreated on return', () => {
+  const { cache, initial, makeView } = setup();
+  const signIn = makeView();
+  signIn.dataset.cacheView = 'false';
+  cache.activate(url('signin'), signIn);
+  cache.activate(url(''), makeView());
+  assert.equal(signIn.isConnected, false);
+  assert.equal(initial.hidden, false);
+
+  const freshSignIn = makeView();
+  freshSignIn.dataset.cacheView = 'false';
+  cache.activate(url('signin'), freshSignIn);
+  assert.equal(freshSignIn.isConnected, true);
+  assert.equal(signIn.isConnected, false);
+});
+
+test('an initially excluded view is never retained', () => {
+  const { host, initial, makeView } = setup();
+  initial.dataset.cacheView = 'false';
+  const cache = new ViewCache(host, initial, url('signin'));
+  cache.activate(url(''), makeView());
+  assert.equal(initial.isConnected, false);
+});
+
+test('Astro swap hook activates views before after-swap and keeps the default swap', () => {
+  const { window, document, host, initial } = setup();
+  const globals = ['document', 'location', 'HTMLElement'];
+  const previous = globals.map((name) => Object.getOwnPropertyDescriptor(globalThis, name));
+  for (const name of globals) {
+    Object.defineProperty(globalThis, name, { configurable: true, value: window[name] });
+  }
+  try {
+    installViewCache();
+    let swaps = 0;
+    function navigate(path) {
+      const next = document.implementation.createHTMLDocument('Next page');
+      const nextHost = next.createElement('div');
+      nextHost.dataset.viewCache = '';
+      const main = next.createElement('main');
+      nextHost.append(main);
+      next.body.append(nextHost);
+      const event = new window.Event('astro:before-swap');
+      event.to = url(path);
+      event.newDocument = next;
+      event.swap = () => {
+        swaps++;
+        // Model Astro's transition:persist host movement during its body swap.
+        nextHost.replaceWith(host);
+        document.body.replaceWith(next.body);
+      };
+      document.dispatchEvent(event);
+      event.swap();
+      document.dispatchEvent(new window.Event('astro:after-swap'));
+      return main;
+    }
+
+    initial.querySelector('input').focus();
+    const article = navigate('articles/example');
+    assert.equal(initial.hidden, true);
+    assert.notEqual(document.activeElement, initial.querySelector('input'));
+    assert.equal(article.isConnected, true);
+    const discarded = navigate('');
+    assert.equal(initial.hidden, false);
+    assert.equal(initial.isConnected, true);
+    assert.equal(discarded.isConnected, false);
+    assert.equal(swaps, 2);
+
+    const unmatched = new window.Event('astro:before-swap');
+    unmatched.newDocument = document.implementation.createHTMLDocument('Other layout');
+    const originalSwap = () => {};
+    unmatched.swap = originalSwap;
+    document.dispatchEvent(unmatched);
+    assert.equal(unmatched.swap, originalSwap);
+  } finally {
+    globals.forEach((name, index) => {
+      if (previous[index]) Object.defineProperty(globalThis, name, previous[index]);
+      else delete globalThis[name];
+    });
+    window.happyDOM.abort();
+  }
+});
