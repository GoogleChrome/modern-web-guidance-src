diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..4e5627e
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,56 @@
+import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
+
+// Includes the active view. Article routes must not grow the DOM indefinitely.
+const MAX_VIEWS = 5;
+const keyFor = (url: URL) => url.pathname + url.search;
+
+export function installViewCache(doc: Document) {
+  const host = doc.querySelector<HTMLElement>('[data-view-cache]');
+  const initial = host?.querySelector<HTMLElement>('[data-cached-view]');
+  if (!host || !initial) return;
+
+  const views = new Map<string, HTMLElement>([
+    [keyFor(new URL(doc.URL)), initial],
+  ]);
+  let focusTarget: HTMLElement | undefined;
+
+  doc.addEventListener('astro:before-swap', (rawEvent) => {
+    const event = rawEvent as TransitionBeforeSwapEvent;
+    const incoming = event.newDocument.querySelector<HTMLElement>('[data-cached-view]');
+    if (!incoming || !event.newDocument.querySelector('[data-view-cache]')) return;
+
+    const swap = event.swap;
+    event.swap = () => {
+      const key = keyFor(event.to);
+      const next = views.get(key) ?? incoming;
+
+      // Let Astro update the head, scripts, history and persistent shell normally.
+      // Its transition:persist host keeps cached islands connected after the swap.
+      swap();
+      if (next === incoming) host.append(next);
+      views.delete(key);
+      views.set(key, next); // Move the active view to the most-recent end.
+
+      for (const view of views.values()) {
+        const inactive = view !== next;
+        view.classList.toggle('is-inactive', inactive);
+        view.inert = inactive;
+        if (inactive) view.setAttribute('aria-hidden', 'true');
+        else view.removeAttribute('aria-hidden');
+      }
+
+      while (views.size > MAX_VIEWS) {
+        const oldest = views.keys().next().value!;
+        views.get(oldest)!.remove();
+        views.delete(oldest);
+      }
+      focusTarget = next;
+    };
+  });
+
+  doc.addEventListener('astro:after-swap', () => {
+    // Run after Astro restores focus and scroll, so focus cannot stay in an inert view.
+    focusTarget?.focus({ preventScroll: true });
+    focusTarget = undefined;
+  });
+}
