diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..3942360
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,95 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+import { installViewCache } from '../src/scripts/view-cache.ts';
+
+function setup() {
+  const window = new Window({ url: 'https://example.com/devtools-times/' });
+  const doc = window.document;
+  const markup = '<div data-view-cache><main data-cached-view tabindex="-1"><input></main></div>';
+  doc.body.innerHTML = markup;
+  installViewCache(doc);
+  const host = doc.querySelector('[data-view-cache]');
+  function prepare(path) {
+    const newDocument = new window.DOMParser().parseFromString(markup, 'text/html');
+    const event = new window.Event('astro:before-swap');
+    event.to = new URL(path, window.location.href);
+    event.newDocument = newDocument;
+    event.swap = () => {
+      // Model Astro's body swap with transition:persist on the cache host.
+      newDocument.querySelector('[data-view-cache]').replaceWith(host);
+      doc.body.replaceChildren(...newDocument.body.childNodes);
+    };
+    doc.dispatchEvent(event);
+    return event;
+  }
+  function navigate(path) {
+    prepare(path).swap();
+    doc.dispatchEvent(new window.Event('astro:after-swap'));
+    return host.querySelector('[data-cached-view]:not(.is-inactive)');
+  }
+  return { window, doc, host, prepare, navigate };
+}
+
+test('return navigation reuses DOM identity, input values and event handlers', () => {
+  const { doc, navigate } = setup();
+  const initial = doc.querySelector('main');
+  const input = initial.querySelector('input');
+  input.value = 'unfinished draft';
+  let clicks = 0;
+  input.addEventListener('click', () => clicks++);
+  navigate('/devtools-times/reports');
+  assert.equal(initial.isConnected, true);
+  assert.equal(navigate('/devtools-times/'), initial);
+  assert.equal(input.value, 'unfinished draft');
+  input.click();
+  assert.equal(clicks, 1);
+});
+
+test('inactive views are inert and excluded from accessibility; focus follows navigation', () => {
+  const { doc, navigate } = setup();
+  const initial = doc.querySelector('main');
+  initial.querySelector('input').focus();
+  const next = navigate('/devtools-times/reports');
+  assert.equal(initial.inert, true);
+  assert.equal(initial.getAttribute('aria-hidden'), 'true');
+  assert.equal(initial.classList.contains('is-inactive'), true);
+  assert.equal(doc.activeElement, next);
+  navigate('/devtools-times/');
+  assert.equal(initial.inert, false);
+  assert.equal(initial.hasAttribute('aria-hidden'), false);
+  assert.equal(doc.activeElement, initial);
+});
+
+test('cache distinguishes query strings while sharing hash variants', () => {
+  const { navigate } = setup();
+  const first = navigate('/devtools-times/reports?q=one');
+  const second = navigate('/devtools-times/reports?q=two');
+  assert.notEqual(first, second);
+  assert.equal(navigate('/devtools-times/reports?q=one#section'), first);
+});
+
+test('LRU eviction bounds connected views and rebuilds evicted routes', () => {
+  const { host, navigate } = setup();
+  const first = navigate('/devtools-times/articles/first');
+  const second = navigate('/devtools-times/articles/second');
+  navigate('/devtools-times/articles/third');
+  navigate('/devtools-times/articles/fourth');
+  navigate('/devtools-times/articles/fifth');
+  navigate('/devtools-times/articles/first'); // Touch first, making second oldest.
+  navigate('/devtools-times/articles/sixth');
+  assert.equal(host.children.length, 5);
+  assert.equal(first.isConnected, true);
+  assert.equal(second.isConnected, false);
+  assert.notEqual(navigate('/devtools-times/articles/second'), second);
+  assert.equal(host.children.length, 5);
+});
+
+test('preparation without a completed swap leaves current state untouched', () => {
+  const { doc, host, prepare } = setup();
+  const initial = doc.querySelector('main');
+  prepare('/devtools-times/reports');
+  assert.equal(host.children.length, 1);
+  assert.equal(initial.inert, false);
+  assert.equal(initial.classList.contains('is-inactive'), false);
+});
