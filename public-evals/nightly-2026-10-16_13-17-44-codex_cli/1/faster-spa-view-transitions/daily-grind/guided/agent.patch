+++ b/app.js
@@ -0,0 +1,136 @@
+const outlet = document.querySelector('#views');
+const home = outlet.querySelector('[data-route="/"]');
+const cards = [...home.querySelectorAll('.card')];
+const products = new Map(cards.map(card => [
+  new URL(card.querySelector('a').href).pathname,
+  card,
+]));
+
+// Only these five fixed routes are cached, so memory use cannot grow with URLs.
+const routes = new Map([
+  ['/', 'Home'],
+  ['/menu', 'Menu'],
+  ...[...products].map(([path, card]) => [path, card.querySelector('h3').textContent]),
+]);
+const cache = new Map([['/', home]]);
+const scrollPositions = new Map();
+let activePath = '/';
+
+function routePath(pathname) {
+  return pathname.replace(/\/+$/, '') || '/';
+}
+
+function createView(path) {
+  const view = document.createElement('section');
+  view.className = 'spa-view inactive';
+  view.dataset.route = path;
+  view.tabIndex = -1;
+  view.inert = true;
+  view.setAttribute('aria-hidden', 'true');
+  view.setAttribute('aria-label', routes.get(path));
+
+  const container = document.createElement('div');
+  container.className = 'container';
+  const heading = document.createElement('h1');
+  heading.textContent = routes.get(path);
+  container.append(heading);
+
+  if (path === '/menu') {
+    const label = document.createElement('label');
+    label.textContent = 'Find a seasonal favorite';
+    const search = document.createElement('input');
+    search.type = 'search';
+    search.className = 'menu-search';
+    label.append(search);
+    const grid = document.createElement('div');
+    grid.className = 'grid';
+    const menuCards = cards.map(card => card.cloneNode(true));
+    grid.append(...menuCards);
+    const empty = document.createElement('p');
+    empty.textContent = 'No drinks match your search.';
+    empty.hidden = true;
+    search.addEventListener('input', () => {
+      const query = search.value.trim().toLowerCase();
+      menuCards.forEach(card => {
+        card.hidden = !card.textContent.toLowerCase().includes(query);
+      });
+      empty.hidden = menuCards.some(card => !card.hidden);
+    });
+    container.append(label, grid, empty);
+  } else {
+    const description = products.get(path).querySelector('p').cloneNode(true);
+    const back = document.createElement('a');
+    back.href = '/menu';
+    back.className = 'btn';
+    back.textContent = 'Back to Menu';
+    container.append(description, back);
+  }
+
+  view.append(container);
+  outlet.append(view);
+  cache.set(path, view);
+  return view;
+}
+
+function showView(path, { focus = true, restoreScroll = false } = {}) {
+  const next = cache.get(path) || createView(path);
+  next.classList.remove('inactive');
+  next.inert = false;
+  next.removeAttribute('aria-hidden');
+  if (focus) next.focus({ preventScroll: true });
+
+  for (const [cachedPath, view] of cache) {
+    if (cachedPath === path) continue;
+    view.inert = true;
+    view.setAttribute('aria-hidden', 'true');
+    view.classList.add('inactive');
+  }
+
+  activePath = path;
+  document.title = `${routes.get(path)} | The Daily Grind`;
+  document.querySelectorAll('a[href]').forEach(link => {
+    const url = new URL(link.href);
+    if (url.origin === location.origin && routePath(url.pathname) === path) {
+      link.setAttribute('aria-current', 'page');
+    } else {
+      link.removeAttribute('aria-current');
+    }
+  });
+  if (focus) {
+    const position = restoreScroll ? scrollPositions.get(path) : null;
+    window.scrollTo({ left: position?.x ?? 0, top: position?.y ?? 0, behavior: 'instant' });
+  }
+}
+
+document.addEventListener('click', event => {
+  if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+      event.ctrlKey || event.shiftKey || event.altKey) return;
+  const link = event.target.closest('a[href]');
+  if (!link || link.hasAttribute('download') ||
+      (link.target && link.target !== '_self')) return;
+  const url = new URL(link.href);
+  const path = routePath(url.pathname);
+  if (url.origin !== location.origin || url.search || url.hash || !routes.has(path)) return;
+
+  event.preventDefault();
+  if (path === activePath) return;
+  scrollPositions.set(activePath, { x: window.scrollX, y: window.scrollY });
+  history.pushState(null, '', url.pathname);
+  showView(path, { restoreScroll: true });
+});
+
+window.addEventListener('popstate', () => {
+  const path = routePath(location.pathname);
+  if (!routes.has(path)) {
+    location.reload();
+    return;
+  }
+  scrollPositions.set(activePath, { x: window.scrollX, y: window.scrollY });
+  showView(path, { restoreScroll: true });
+});
+
+const initialPath = routePath(location.pathname);
+if (routes.has(initialPath)) {
+  history.scrollRestoration = 'manual';
+  showView(initialPath, { focus: false });
+}
