+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-live="polite" aria-atomic="true">added to cart!</span>
+      <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.querySelector('#toast-template');
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+        let dismissTimer;
+        let closing = false;
+
+        function dismiss() {
+          if (closing) return;
+          closing = true;
+          clearTimeout(dismissTimer);
+          if (toast.contains(document.activeElement)) {
+            trigger.focus({ preventScroll: true });
+          }
+          toast.classList.add('is-closing');
+
+          function remove() {
+            clearTimeout(cleanupTimer);
+            toast.hidePopover();
+            toast.remove();
+          }
+
+          toast.addEventListener('animationend', remove, { once: true });
+          // Also clean up if animations are disabled by a user stylesheet.
+          const cleanupTimer = setTimeout(remove, 250);
+        }
+
+        toast.querySelector('.toast-close').addEventListener('click', dismiss);
+        document.body.append(toast);
+        toast.showPopover();
+        dismissTimer = setTimeout(dismiss, 3000);
+      });
+    });
+  </script>
+
