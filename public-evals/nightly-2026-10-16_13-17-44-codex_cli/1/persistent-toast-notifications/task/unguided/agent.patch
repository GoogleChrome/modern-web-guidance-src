+    .toast {
+      /* Every toast is its own top-layer popover. The previous toast is
+         the last eligible anchor; the first uses the viewport fallback. */
+      position: fixed;
+      inset: auto;
+      margin: 0;
+      anchor-name: --toast;
+      position-anchor: --toast;
+      bottom: calc(anchor(--toast top, env(safe-area-inset-bottom, 0px)) + 16px);
+      right: max(16px, env(safe-area-inset-right, 0px));
+      width: min(320px, calc(100vw - 32px));
+      padding: 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
+      animation: toast-in 200ms ease-out both;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast.is-closing {
+      pointer-events: none;
+      animation: toast-out 200ms ease-in both;
+    }
+
+    .toast-close {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 24px;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @keyframes toast-in {
+      from { opacity: 0; transform: translateX(20px); }
+      to { opacity: 1; transform: translateX(0); }
+    }
+
+    @keyframes toast-out {
+      from { opacity: 1; transform: translateX(0); }
+      to { opacity: 0; transform: translateX(20px); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast,
+      .toast.is-closing {
+        animation-duration: 1ms;
+      }
+    }
