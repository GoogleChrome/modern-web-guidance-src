+  <script>
+    let toastId = 0;
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.id = `toast-${++toastId}`;
+        toast.className = 'toast';
+        // Manual popovers coexist without light dismissal or modal focus trapping.
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.setAttribute('role', 'status');
+        message.setAttribute('aria-atomic', 'true');
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Close notification');
+        close.setAttribute('popovertarget', toast.id);
+        close.setAttribute('popovertargetaction', 'hide');
+        close.textContent = '×';
+
+        toast.append(message, close);
+        document.body.append(toast);
+        toast.showPopover();
+        // Update the live region after it has entered the document.
+        requestAnimationFrame(() => { message.textContent = 'added to cart!'; });
+
+        const timer = setTimeout(() => toast.hidePopover(), 3000);
+        toast.addEventListener('beforetoggle', (event) => {
+          if (event.newState !== 'closed') return;
+          clearTimeout(timer);
+          // Keep the element mounted through its top-layer exit transition.
+          setTimeout(() => toast.remove(), 230);
+        });
+      });
+    });
+  </script>
+
