diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..3c5a581
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,74 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+// Explicit routes prevent serving source, dotfiles, or arbitrary filesystem paths.
+const files = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['public/privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['public/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['public/assets/coffee.jpg', 'image/jpeg']],
+]);
+
+const headers = {
+  'Content-Security-Policy': "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'",
+  'Referrer-Policy': 'no-referrer',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), browsing-topics=(), focus-without-user-activation=()',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cache-Control': 'no-store',
+  'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+};
+
+export function createApp({ production = process.env.NODE_ENV === 'production' } = {}) {
+  return createServer({ maxHeaderSize: 16384, requestTimeout: 10000, headersTimeout: 10000 }, async (req, res) => {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    // Production runs behind an HTTPS-terminating proxy. Never trust client-supplied forwarded headers.
+    if (production) res.setHeader('Strict-Transport-Security', 'max-age=300');
+    res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+    const reply = (status, body) => {
+      res.statusCode = status;
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    const site = req.headers['sec-fetch-site'];
+    const navigation = req.headers['sec-fetch-mode'] === 'navigate' && req.headers['sec-fetch-dest'] === 'document';
+    if (site && !['same-origin', 'none'].includes(site) && !(navigation && ['GET', 'HEAD'].includes(req.method))) {
+      return reply(403, 'Forbidden');
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return reply(405, 'Method not allowed');
+    }
+    let pathname;
+    try {
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return reply(400, 'Bad request');
+    }
+    // No sessions exist today; clear any legacy browser state without persisting request data.
+    if (pathname === '/logout') {
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      res.setHeader('Location', '/');
+      return reply(303, 'Return to home');
+    }
+    const file = files.get(pathname);
+    if (!file) return reply(404, 'Not found');
+    try {
+      const body = await readFile(new URL(file[0], import.meta.url));
+      res.setHeader('Content-Type', file[1]);
+      res.setHeader('Content-Length', body.length);
+      reply(200, body);
+    } catch {
+      // Never log request URLs, IP addresses, cookies, headers, or raw errors.
+      reply(500, 'Unable to serve this resource');
+    }
+  });
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const server = createApp();
+  server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
+}
