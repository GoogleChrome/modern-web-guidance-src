+++ b/test/privacy.test.mjs
@@ -0,0 +1,102 @@
+import test from 'node:test';
+import { get } from 'node:http';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createApp } from '../server.mjs';
+
+async function withServer(run, production = false) {
+  const server = createApp({ production });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  try {
+    await run(`http://127.0.0.1:${server.address().port}`);
+  } finally {
+    await new Promise(resolve => server.close(resolve));
+  }
+}
+
+test('all public resources, errors, and logout receive protective headers', async () => {
+  await withServer(async base => {
+    for (const [path, status, type] of [
+      ['/', 200, 'text/html'], ['/privacy-policy', 200, 'text/html'],
+      ['/styles.css', 200, 'text/css'], ['/assets/coffee.jpg', 200, 'image/jpeg'],
+      ['/missing', 404, 'text/plain'], ['/logout', 303, 'text/plain'],
+    ]) {
+      const res = await fetch(base + path, { redirect: 'manual' });
+      assert.equal(res.status, status);
+      assert.ok(res.headers.get('content-type').startsWith(type));
+      assert.match(res.headers.get('content-security-policy'), /script-src 'none'/);
+      assert.match(res.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+      assert.match(res.headers.get('content-security-policy'), /require-trusted-types-for 'script'/);
+      assert.equal(res.headers.get('referrer-policy'), 'no-referrer');
+      assert.match(res.headers.get('permissions-policy'), /geolocation=\(\)/);
+      assert.equal(res.headers.get('x-content-type-options'), 'nosniff');
+      assert.equal(res.headers.get('x-frame-options'), 'DENY');
+      assert.equal(res.headers.get('cross-origin-resource-policy'), 'same-origin');
+      assert.equal(res.headers.get('cross-origin-opener-policy'), 'same-origin-allow-popups');
+      assert.equal(res.headers.get('cache-control'), 'no-store');
+      assert.equal(res.headers.get('set-cookie'), null);
+      assert.equal(res.headers.get('access-control-allow-origin'), null);
+      if (path === '/logout') {
+        assert.equal(res.headers.get('clear-site-data'), '"cookies", "storage", "cache"');
+        assert.equal(res.headers.get('location'), '/');
+      }
+      await res.arrayBuffer();
+    }
+  });
+});
+
+test('private files and arbitrary write requests are rejected', async () => {
+  await withServer(async base => {
+    for (const path of ['/server.mjs', '/package.json', '/.git/config', '/%2e%2e/package.json', '/assets/../server.mjs']) {
+      assert.equal((await fetch(base + path)).status, 404);
+    }
+    const res = await fetch(base + '/', { method: 'POST', body: 'email=private@example.com' });
+    assert.equal(res.status, 405);
+    assert.equal(res.headers.get('allow'), 'GET, HEAD');
+    assert.equal(await res.text(), 'Method not allowed');
+    const head = await fetch(base + '/', { method: 'HEAD' });
+    assert.equal(head.status, 200);
+    assert.equal(await head.text(), '');
+  });
+});
+
+test('cross-site subresources are blocked while incoming document links work', async () => {
+  await withServer(async base => {
+    const res = await fetch(base + '/styles.css', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-dest': 'style' } });
+    assert.equal(res.status, 403);
+    assert.match(res.headers.get('vary'), /Sec-Fetch-Site/);
+    // Node fetch overwrites Sec-Fetch-Mode, so use HTTP to model a browser navigation.
+    const status = await new Promise((resolve, reject) => {
+      get(base + '/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } }, res => {
+        res.resume();
+        res.on('end', () => resolve(res.statusCode));
+      }).on('error', reject);
+    });
+    assert.equal(status, 200);
+  });
+});
+
+test('HSTS uses a short production rollout and does not trust forwarded headers', async () => {
+  await withServer(async base => {
+    const res = await fetch(base, { headers: { 'x-forwarded-proto': 'https' } });
+    assert.equal(res.headers.get('strict-transport-security'), null);
+  });
+  await withServer(async base => {
+    assert.equal((await fetch(base)).headers.get('strict-transport-security'), 'max-age=300');
+  }, true);
+});
+
