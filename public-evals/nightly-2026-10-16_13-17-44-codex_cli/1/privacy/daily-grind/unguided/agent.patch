@@ -0,0 +1,60 @@
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+export const securityHeaders = {
+  'Content-Security-Policy': "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'none'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
+  'Referrer-Policy': 'no-referrer',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cache-Control': 'no-store',
+};
+
+// Explicit public routes prevent accidental exposure of source, logs, or secrets.
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy/', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+export function createServer({ httpsOnly = process.env.HTTPS_ONLY === 'true' } = {}) {
+  return http.createServer(async (req, res) => {
+    for (const [name, value] of Object.entries(securityHeaders)) res.setHeader(name, value);
+    // Enable only behind a TLS-terminating proxy that enforces HTTPS redirects.
+    // Never trust a client-supplied X-Forwarded-Proto header.
+    if (httpsOnly) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.writeHead(405, { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Method not allowed');
+      return;
+    }
+    const route = routes.get((req.url ?? '').split('?')[0]);
+    if (!route) {
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end(req.method === 'HEAD' ? undefined : 'Page not found');
+      return;
+    }
+    try {
+      const body = await readFile(new URL(route[0], import.meta.url));
+      res.writeHead(200, { 'Content-Type': route[1], 'Content-Length': body.length });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    } catch {
+      // Do not expose filesystem paths, request data, or stack traces.
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end(req.method === 'HEAD' ? undefined : 'Unable to load page');
+    }
+  });
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const server = createServer();
+  server.requestTimeout = 15_000;
+  server.headersTimeout = 10_000;
+  server.listen(Number(process.env.PORT ?? 11222), '0.0.0.0');
+}
