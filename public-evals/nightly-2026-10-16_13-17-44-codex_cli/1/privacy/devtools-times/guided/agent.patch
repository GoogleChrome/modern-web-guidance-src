diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..e02793d
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createHash } from 'node:crypto';
+import { spawn } from 'node:child_process';
+import createSessionDriver from '../src/lib/session-driver.mjs';
+
+const origin = 'http://127.0.0.1:14329';
+const base = `${origin}/devtools-times/`;
+const server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+  env: { ...process.env, HOST: '127.0.0.1', PORT: '14329' }, stdio: 'ignore',
+});
+const request = (path, options = {}) => fetch(`${base}${path}`, options);
+const post = (body, headers = {}) => request('api/reading-list.json', {
+  method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json', ...headers }, body,
+});
+
+test('privacy boundaries and reading list lifecycle over HTTP', async (t) => {
+  t.after(() => server.kill());
+  let ready = false;
+  for (let i = 0; i < 100; i++) {
+    try { await request(''); ready = true; break; } catch { await new Promise(r => setTimeout(r, 50)); }
+  }
+  assert.ok(ready, 'server started');
+  const page = await request('');
+  assert.equal(page.status, 200);
+  assert.equal(page.headers.get('set-cookie'), null, 'anonymous reading creates no session');
+  assert.equal(page.headers.get('referrer-policy'), 'no-referrer');
+  assert.equal(page.headers.get('x-frame-options'), 'DENY');
+  assert.equal(page.headers.get('x-content-type-options'), 'nosniff');
+  assert.match(page.headers.get('permissions-policy'), /camera=\(\)/);
+  assert.match(page.headers.get('cache-control'), /no-store/);
+  const csp = page.headers.get('content-security-policy');
+  assert.match(csp, /connect-src 'self'/);
+  assert.match(csp, /frame-ancestors 'none'/);
+  assert.match(csp, /strict-dynamic/);
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+  const html = await page.text();
+  assert.doesNotMatch(html, /fonts\.google|cloudfunctions\.net|i\.imgur\.com|cinemai-/);
+  // Every inline executable script must be covered by a framework-generated hash.
+  for (const script of html.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)) {
+    if (/\bsrc=|application\/json/.test(script[1])) continue;
+    const hash = createHash('sha256').update(script[2]).digest('base64');
+    assert.ok(csp.includes(`'sha256-${hash}'`), 'inline script authorized by CSP');
+  }
+  for (const route of ['signin', 'signup', 'legal/privacy', 'articles/silent-architects']) {
+    const response = await request(route);
+    assert.equal(response.status, 200, route);
+    assert.equal(response.headers.get('set-cookie'), null);
+    const content = await response.text();
+    assert.doesNotMatch(content, /type="password"|document\.cookie\s*=/);
+  }
+  const empty = await request('api/reading-list.json');
+  assert.equal(empty.headers.get('set-cookie'), null);
+  assert.deepEqual(await empty.json(), { readingList: [] });
+  assert.equal((await post('{')).status, 400);
+  assert.equal((await post(JSON.stringify({ slug: 10 }))).status, 400);
+  assert.equal((await post(JSON.stringify({ slug: 'coffee-alchemy', email: 'unnecessary' }))).status, 400);
+  assert.equal((await post(JSON.stringify({ slug: 'does-not-exist' }))).status, 404);
+  assert.equal((await post('x'.repeat(513))).status, 413);
+  assert.equal((await post('{}', { 'Content-Type': 'text/plain' })).status, 415);
+  assert.equal((await post('{}', { Origin: 'https://attacker.example' })).status, 403);
+  assert.equal((await request('api/reading-list.json', { headers: { 'Sec-Fetch-Site': 'cross-site' } })).status, 403);
+  assert.equal((await request('api/reading-list.json', { method: 'DELETE' })).status, 403);
+  const saved = await post(JSON.stringify({ slug: 'coffee-alchemy' }));
+  assert.equal(saved.status, 200);
+  assert.deepEqual(await saved.json(), { readingList: ['coffee-alchemy'] });
+  const setCookie = saved.headers.get('set-cookie');
+  assert.match(setCookie, /HttpOnly/i);
+  assert.match(setCookie, /Secure/i);
+  assert.match(setCookie, /SameSite=Lax/i);
+  assert.match(setCookie, /Max-Age=86400/i);
+  const cookie = setCookie.split(';')[0];
+  const exported = await request('api/reading-list.json', { headers: { Cookie: cookie } });
+  assert.deepEqual(await exported.json(), { readingList: ['coffee-alchemy'] });
+  const isolated = await request('api/reading-list.json');
+  assert.deepEqual(await isolated.json(), { readingList: [] });
+  const deleted = await request('api/reading-list.json', { method: 'DELETE', headers: { Origin: origin, Cookie: cookie } });
+  assert.equal(deleted.status, 200);
+  assert.match(deleted.headers.get('set-cookie'), /Expires=Thu, 01 Jan 1970/i);
+  const after = await request('api/reading-list.json', { headers: { Cookie: cookie } });
+  assert.deepEqual(await after.json(), { readingList: [] }, 'old cookie cannot recover deleted data');
+});
+
+test('session storage physically expires records without access and supports deletion', async () => {
+  const driver = createSessionDriver({ retentionMs: 20 });
+  await driver.setItem('a', 'article IDs');
+  assert.equal(await driver.getItem('a'), 'article IDs');
+  await new Promise(r => setTimeout(r, 40));
+  assert.equal(await driver.getItem('a'), null);
+  await driver.setItem('b', 'data');
+  await driver.removeItem('b');
+  assert.equal(await driver.getItem('b'), null);
+});
