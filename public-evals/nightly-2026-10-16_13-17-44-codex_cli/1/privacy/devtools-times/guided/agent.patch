+++ b/src/components/PrivacyControls.tsx
@@ -0,0 +1,45 @@
+import { useState } from 'react';
+
+export default function PrivacyControls() {
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  const manageData = async (action: 'export' | 'delete') => {
+    setBusy(true);
+    setMessage('');
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+        method: action === 'delete' ? 'DELETE' : 'GET',
+        cache: 'no-store',
+      });
+      if (!response.ok) throw new Error();
+      const data = await response.json();
+      if (action === 'export') {
+        const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+        const link = document.createElement('a');
+        link.href = url;
+        link.download = 'devtools-times-reading-list.json';
+        link.click();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+        setMessage('Your reading list has been exported.');
+      } else {
+        window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: [] }));
+        setMessage('Your saved reading list and its session have been deleted.');
+      }
+    } catch {
+      setMessage('Unable to complete your request. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return <div className="my-6 border border-gray-200 rounded-lg p-5">
+    <h3 className="font-bold text-lg mb-2">Manage your reading list</h3>
+    <p className="text-sm mb-4">Export or delete the reading list saved in this browser. No account is needed.</p>
+    <div className="flex flex-wrap gap-3">
+      <button disabled={busy} onClick={() => manageData('export')} className="border rounded px-4 py-2 disabled:opacity-50">Export my data</button>
+      <button disabled={busy} onClick={() => manageData('delete')} className="bg-gray-900 text-white rounded px-4 py-2 disabled:opacity-50">Delete my reading list</button>
+    </div>
+    <p role="status" className="text-sm mt-3">{message}</p>
+  </div>;
+}
