new file mode 100644
index 0000000..42822c8
--- /dev/null
+++ b/src/lib/session-driver.mjs
@@ -0,0 +1,30 @@
+const RETENTION_MS = 24 * 60 * 60 * 1000;
+const MAX_SESSIONS = 10000;
+
+// This sample runs in one process. Nothing is written to disk or backups.
+export default function createSessionDriver({ retentionMs = RETENTION_MS } = {}) {
+  const sessions = new Map();
+  const remove = (key) => {
+    clearTimeout(sessions.get(key)?.timer);
+    sessions.delete(key);
+  };
+  return {
+    async getItem(key) {
+      const entry = sessions.get(key);
+      if (!entry) return null;
+      if (entry.expires <= Date.now()) {
+        remove(key);
+        return null;
+      }
+      return entry.value;
+    },
+    async setItem(key, value) {
+      remove(key);
+      if (sessions.size >= MAX_SESSIONS) remove(sessions.keys().next().value);
+      const timer = setTimeout(() => remove(key), retentionMs);
+      timer.unref();
+      sessions.set(key, { value, timer, expires: Date.now() + retentionMs });
+    },
+    async removeItem(key) { remove(key); },
+  };
+}
