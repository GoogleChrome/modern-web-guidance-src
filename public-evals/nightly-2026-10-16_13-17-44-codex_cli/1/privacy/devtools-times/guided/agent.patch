diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..5d0b9ac
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,26 @@
+import { readdir, readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+
+// Inventory external origins in source; SVG namespaces and ordinary outbound links
+// are not integrations. Each new origin requires a recorded review before approval.
+const allowedOrigins = new Set(['http://www.w3.org', 'https://developer.chrome.com']);
+const findings = [];
+async function scan(directory) {
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const path = `${directory}/${entry.name}`;
+    if (entry.isDirectory()) await scan(path);
+    else {
+      const source = await readFile(path, 'utf8');
+      for (const match of source.matchAll(/https?:\/\/[^\s"'<>`)}]+/g)) {
+        const origin = new URL(match[0]).origin;
+        if (!allowedOrigins.has(origin)) findings.push(`${path}: ${origin}`);
+      }
+      if (/document\.cookie\s*=|localStorage|sessionStorage|navigator\.userAgent|getHighEntropyValues|sendBeacon/.test(source)) {
+        findings.push(`${path}: browser storage, fingerprinting or telemetry API needs review`);
+      }
+    }
+  }
+}
+await scan('src');
+assert.deepEqual(findings, [], `Unreviewed privacy-sensitive integrations:\n${findings.join('\n')}`);
+console.log('Privacy source audit passed: no unreviewed external origins or sensitive browser APIs.');
