+import { useState } from 'react';
+
+export default function PrivacyControls() {
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  async function clearData() {
+    setBusy(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+        method: 'DELETE', credentials: 'same-origin', cache: 'no-store',
+      });
+      if (!response.ok) throw new Error();
+      setMessage('Your reading list and its session cookie have been deleted.');
+      window.dispatchEvent(new Event('reading-list-changed'));
+    } catch {
+      setMessage('Your data could not be deleted. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  }
+  return <div>
+    <button type="button" disabled={busy} onClick={clearData}
+      className="px-4 py-2 rounded bg-gray-900 text-white disabled:opacity-60">
+      {busy ? 'Deleting…' : 'Delete my reading list'}
+    </button>
+    <p role="status" aria-live="polite">{message}</p>
+  </div>;
+}
