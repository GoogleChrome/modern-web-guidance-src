+export const onRequest = defineMiddleware(async ({ request, url }, next) => {
+  // Require an exact origin for every mutation, including JSON and DELETE.
+  const unsafe = !['GET', 'HEAD', 'OPTIONS'].includes(request.method);
+  const forbidden = unsafe && (
+    request.headers.get('origin') !== url.origin ||
+    request.headers.get('sec-fetch-site') === 'cross-site'
+  );
+  const response = forbidden
+    ? Response.json({ error: 'Request origin is not allowed.' }, { status: 403 })
+    : await next();
+
+  // Preserve Astro's generated script/style hashes on rendered pages.
+  // APIs and early errors receive a deny-by-default policy.
+  const csp = response.headers.get('Content-Security-Policy') ||
+    "default-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'";
+  response.headers.set('Content-Security-Policy', `${csp}; frame-ancestors 'none'`);
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('X-Frame-Options', 'DENY');
+  response.headers.set('Referrer-Policy', 'no-referrer');
+  response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()');
+  response.headers.set('X-DNS-Prefetch-Control', 'off');
+  // HTML contains session-specific bookmark state. Never share it via caches.
+  response.headers.set('Cache-Control', 'private, no-store');
+  if (url.protocol === 'https:') {
+    response.headers.set('Strict-Transport-Security', 'max-age=31536000');
   }
