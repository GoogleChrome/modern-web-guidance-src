diff --git a/scripts/privacy.test.mjs b/scripts/privacy.test.mjs
new file mode 100644
index 0000000..7b046e8
--- /dev/null
+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,157 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:net';
+import { createHash } from 'node:crypto';
+import { setTimeout as delay } from 'node:timers/promises';
+
+let server, origin, base;
+let serverOutput = '';
+before(async () => {
+  const socket = createServer();
+  await new Promise(resolve => socket.listen(0, '127.0.0.1', resolve));
+  const port = socket.address().port;
+  await new Promise(resolve => socket.close(resolve));
+  origin = `http://127.0.0.1:${port}`;
+  base = `${origin}/devtools-times/`;
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+    env: { ...process.env, HOST: '127.0.0.1', PORT: String(port), NODE_ENV: 'production' },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  server.stdout.on('data', data => { serverOutput += data; });
+  server.stderr.on('data', data => { serverOutput += data; });
+  for (let i = 0; i < 100; i++) {
+    try { if ((await fetch(base)).ok) return; } catch { /* Wait for startup. */ }
+    await delay(100);
+  }
+  throw new Error(`Server did not start: ${serverOutput}`);
+});
+after(async () => {
+  if (server && server.exitCode === null) {
+    const stopped = new Promise(resolve => server.once('exit', resolve));
+    server.kill('SIGTERM');
+    await stopped;
+  }
+});
+
+function mutate(body, extra = {}) {
+  return fetch(`${base}api/reading-list.json`, {
+    method: 'POST', headers: { origin, 'content-type': 'application/json', ...extra },
+    body: typeof body === 'string' ? body : JSON.stringify(body),
+  });
+}
+
+function checkHeaders(response) {
+  assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+  assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+  assert.equal(response.headers.get('x-frame-options'), 'DENY');
+  assert.equal(response.headers.get('cache-control'), 'private, no-store');
+  assert.match(response.headers.get('permissions-policy'), /geolocation=\(\)/);
+  assert.match(response.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+}
+
+function checkHtmlPolicy(html, response) {
+  const policy = response.headers.get('content-security-policy');
+  assert.match(policy, /default-src 'self'/);
+  assert.match(policy, /connect-src 'self'/);
+  assert.doesNotMatch(policy, /unsafe-inline|unsafe-eval/);
+  // Every executable inline script must be covered by a generated CSP hash.
+  for (const match of html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/g)) {
+    if (/\bsrc=|type="application\/(?:ld\+)?json"/.test(match[1]) || !match[2].trim()) continue;
+    const hash = createHash('sha256').update(match[2]).digest('base64');
+    assert.ok(policy.includes(`sha256-${hash}`), 'Inline script has a CSP hash');
+  }
+  for (const match of html.matchAll(/<(?:script|img|link|iframe)\b[^>]*(?:src|href)="([^"]+)"/g)) {
+    assert.ok(!/^https?:|^\/\//.test(match[1]), `No third-party resource: ${match[1]}`);
+  }
+}
+
+test('browsing, searching, and account pages do not create sessions or load third parties', async () => {
+  for (const path of ['', 'legal/privacy', 'signin', 'signup', 'articles/silent-architects', 'articles/super-bowl-lx']) {
+    const response = await fetch(`${base}${path}`);
+    assert.equal(response.status, 200, path);
+    checkHeaders(response);
+    assert.equal(response.headers.get('set-cookie'), null, path);
+    const html = await response.text();
+    checkHtmlPolicy(html, response);
+    assert.doesNotMatch(html, /document\.cookie|analytics-client|fonts\.googleapis|use-credentials/);
+    if (['signin', 'signup'].includes(path)) assert.doesNotMatch(html, /<input/);
+  }
+  const response = await fetch(`${base}api/articles.json`);
+  assert.equal(response.headers.get('set-cookie'), null);
+  assert.match(response.headers.get('content-type'), /application\/json/);
+});
+
+test('reading lists are opt-in, minimal, isolated, and fully deletable', async () => {
+  const empty = await fetch(`${base}api/reading-list.json`);
+  assert.deepEqual(await empty.json(), { readingList: [] });
+  assert.equal(empty.headers.get('set-cookie'), null);
+  const saved = await mutate({ slug: 'coffee-alchemy' });
+  assert.equal(saved.status, 200);
+  checkHeaders(saved);
+  assert.deepEqual(await saved.json(), { readingList: ['coffee-alchemy'] });
+  const setCookie = saved.headers.get('set-cookie');
+  assert.match(setCookie, /HttpOnly/i);
+  assert.match(setCookie, /Secure/i);
+  assert.match(setCookie, /SameSite=Strict/i);
+  assert.match(setCookie, /Path=\/devtools-times\//i);
+  assert.match(setCookie, /Max-Age=86400/i);
+  const cookie = setCookie.split(';')[0];
+  const own = await fetch(`${base}api/reading-list.json`, { headers: { cookie } });
+  assert.deepEqual(await own.json(), { readingList: ['coffee-alchemy'] });
+  const other = await fetch(`${base}api/reading-list.json`);
+  assert.deepEqual(await other.json(), { readingList: [] });
+  const removed = await fetch(`${base}api/reading-list.json`, {
+    method: 'DELETE', headers: { origin, cookie },
+  });
+  assert.equal(removed.status, 200);
+  assert.match(removed.headers.get('set-cookie'), /(?:Max-Age=0|Expires=Thu, 01 Jan 1970)/i);
+  // Replaying the old session ID cannot recover deleted data.
+  const replay = await fetch(`${base}api/reading-list.json`, { headers: { cookie } });
+  assert.deepEqual(await replay.json(), { readingList: [] });
+  const again = await mutate({ slug: 'coffee-alchemy' });
+  const secondCookie = again.headers.get('set-cookie').split(';')[0];
+  const toggled = await mutate({ slug: 'coffee-alchemy' }, { cookie: secondCookie });
+  assert.deepEqual(await toggled.json(), { readingList: [] });
+  assert.match(toggled.headers.get('set-cookie'), /(?:Max-Age=0|Expires=Thu, 01 Jan 1970)/i);
+});
+
+test('rejects cross-origin, malformed, oversized, and unnecessary data without sessions', async () => {
+  for (const headers of [{ origin: 'https://attacker.example' }, { origin: 'null' }, { origin, 'sec-fetch-site': 'cross-site' }]) {
+    const response = await mutate({ slug: 'coffee-alchemy' }, headers);
+    assert.equal(response.status, 403);
+    checkHeaders(response);
+    assert.equal(response.headers.get('set-cookie'), null);
+  }
+  const missingOrigin = await fetch(`${base}api/reading-list.json`, { method: 'DELETE' });
+  assert.equal(missingOrigin.status, 403);
+  for (const body of ['{', 'null', '[]', '{}', { slug: [] }, { slug: 'unknown' }, { slug: 'coffee-alchemy', email: 'unneeded@example.com' }]) {
+    const response = await mutate(body);
+    assert.equal(response.status, 400);
+    assert.equal(response.headers.get('set-cookie'), null);
+  }
+  const oversized = await mutate({ slug: 'a'.repeat(600) });
+  assert.equal(oversized.status, 413);
+  const chunked = await fetch(`${base}api/reading-list.json`, {
+    method: 'POST', headers: { origin, 'content-type': 'application/json' },
+    duplex: 'half',
+    body: (async function* () { yield 'a'.repeat(300); yield 'b'.repeat(300); })(),
+  });
+  assert.equal(chunked.status, 413, 'Size limit applies without Content-Length');
+  const wrongType = await mutate('{}', { 'content-type': 'text/plain' });
+  assert.equal(wrongType.status, 415);
+  const blockedDelete = await fetch(`${base}api/reading-list.json`, { method: 'DELETE', headers: { origin: 'https://attacker.example' } });
+  assert.equal(blockedDelete.status, 403);
+});
+
+test('security headers also cover errors and trusted HTTPS requests', async () => {
+  const response = await fetch(`${base}missing-page`);
+  assert.equal(response.status, 404);
+  checkHeaders(response);
+  const secure = await fetch(base, { headers: {
+    'x-forwarded-proto': 'https',
+    'x-forwarded-host': 'astro-news-pytrpecapa-uc.a.run.app',
+  } });
+  assert.equal(secure.status, 200);
+  assert.equal(secure.headers.get('strict-transport-security'), 'max-age=31536000');
+});
