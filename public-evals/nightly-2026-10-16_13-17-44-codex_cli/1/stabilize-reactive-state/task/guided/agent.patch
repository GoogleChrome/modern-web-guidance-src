+  <script type="importmap">
+    {
+      "imports": {
+        "@js-temporal/polyfill": "https://esm.sh/@js-temporal/polyfill@0.5.1"
+      }
+    }
+  </script>
+  <script type="module">
+    const extendButton = document.getElementById('extend-temporal-btn');
+    const dateValue = document.getElementById('temporal-value');
+    const referenceChanged = document.getElementById('temporal-ref-changed');
+    const renderCountValue = document.getElementById('temporal-render-count');
+
+    try {
+      const Temporal = globalThis.Temporal ?? (await import('@js-temporal/polyfill')).Temporal;
+      let state = Object.freeze({
+        deadline: Temporal.Now.plainDateISO().add({ days: 7 }),
+        referenceChanged: false,
+      });
+      let renderCount = 0;
+
+      function render() {
+        const deadline = state.deadline.toString();
+        dateValue.textContent = deadline;
+        dateValue.dateTime = deadline;
+        referenceChanged.textContent = state.referenceChanged ? 'Yes' : 'No';
+        renderCountValue.textContent = String(++renderCount);
+      }
+
+      function setState(nextState) {
+        if (Object.is(state, nextState)) return;
+        state = nextState;
+        render();
+      }
+
+      extendButton.addEventListener('click', () => {
+        const nextDeadline = state.deadline.add({ days: 1 });
+        setState(Object.freeze({
+          deadline: nextDeadline,
+          referenceChanged: nextDeadline !== state.deadline,
+        }));
+      });
+
+      render();
+      extendButton.disabled = false;
+    } catch (error) {
+      dateValue.textContent = 'Deadline unavailable';
+      document.getElementById('temporal-status').textContent =
+        'The deadline tracker could not load. Please reload to try again.';
+      console.error('Failed to initialize the deadline tracker:', error);
+    }
+  </script>
+
 </body>
 
