+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    const supportsAnchors = CSS.supports('anchor-name: --rewards') &&
+      CSS.supports('top: anchor(bottom)') &&
+      CSS.supports('left: clamp(16px, calc(anchor(center) - 160px), 100vw)');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Keep the fallback tethered even when fonts, layout, or scrolling move the link.
+    function trackRewards() {
+      if (!tourOpen) return;
+      const target = rewardsLink.getBoundingClientRect();
+      const width = tourStep.getBoundingClientRect().width;
+      tourStep.style.top = `${target.bottom + 18}px`;
+      tourStep.style.left = `${Math.max(16, Math.min(target.left + target.width / 2 - width / 2, window.innerWidth - width - 16))}px`;
+      trackingFrame = requestAnimationFrame(trackRewards);
+    }
+
+    if (supportsPopover) {
+      tourStep.showPopover();
+    } else {
+      tourStep.classList.add('tour-fallback');
+    }
+    if (!supportsAnchors) trackRewards();
+    closeTourButton.focus({ preventScroll: true });
+
+    function preventTourNavigation(event) {
+      if (tourOpen) event.preventDefault();
+    }
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+
+    closeTourButton.addEventListener('click', (event) => {
+      event.preventDefault();
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (supportsPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      rewardsLink.removeAttribute('aria-describedby');
+      rewardsLink.focus({ preventScroll: true });
+    });
+  </script>
 </body>
 
