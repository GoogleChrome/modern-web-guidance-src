+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const summaryOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en'
+    };
+
+    async function checkSummarizer() {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Local AI summaries are not supported in this browser. You can still enjoy the full journal above.';
+        return;
+      }
+
+      try {
+        const availability = await window.Summarizer.availability(summaryOptions);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Local AI summaries are unavailable on this device. The full journal is ready to read above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Get a few key points using AI on your device.'
+          : 'Your browser needs to download its AI model first. Select Summarize to begin; this may take a few minutes.';
+      } catch {
+        journalStatus.textContent = 'Could not check local AI availability. Reload the page to try again, or read the full journal above.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s local AI…';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to preserve user activation for model downloads.
+        summarizer = await window.Summarizer.create({
+          ...summaryOptions,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const progress = event.total > 0
+                ? ` ${Math.round((event.loaded / event.total) * 100)}%`
+                : '';
+              journalStatus.textContent = `Downloading your browser’s AI model…${progress}`;
+            });
+          }
+        });
+        journalStatus.textContent = 'Turning the journal into a few key points…';
+        const summary = await summarizer.summarize(
+          document.getElementById('journal-copy').innerText
+        );
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣▪–—]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your summary is ready below. Generated locally on your device.';
+      } catch {
+        journalStatus.textContent = 'The local AI could not create a summary. Please try again. The full journal remains available above.';
+      } finally {
+        summarizer?.destroy();
+        summaryPanel.removeAttribute('aria-busy');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkSummarizer();
+  </script>
+
