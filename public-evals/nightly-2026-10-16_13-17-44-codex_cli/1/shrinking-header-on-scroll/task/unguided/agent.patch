+  <script>
+    (function () {
+      // Match the CSS feature query so exactly one implementation is active.
+      if (window.CSS && CSS.supports &&
+          CSS.supports('animation-timeline: scroll()') &&
+          CSS.supports('animation-range: 0px 180px')) return;
+
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var narrowScreen = window.matchMedia('(max-width: 700px)');
+      var scheduled = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateNav() {
+        scheduled = false;
+        if (reducedMotion.matches) {
+          nav.style.height = '';
+          logo.style.fontSize = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 180, 1));
+        var expandedHeight = narrowScreen.matches ? 104 : 72;
+        var shrink = narrowScreen.matches ? 24 : 20;
+        nav.style.height = (expandedHeight - shrink * progress) + 'px';
+        logo.style.fontSize = (24 - 4 * progress) + 'px';
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          requestFrame.call(window, updateNav);
+        }
+      }
+
+      // The handler only schedules work, so it is safe on browsers predating
+      // passive event listeners as well as those without scroll timelines.
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('resize', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else if (reducedMotion.addListener) {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      updateNav();
+    }());
+  </script>
