+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    let positionFrame;
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const left = viewport?.offsetLeft ?? 0;
+      const top = viewport?.offsetTop ?? 0;
+      const width = viewport?.width ?? document.documentElement.clientWidth;
+      const height = viewport?.height ?? document.documentElement.clientHeight;
+      const right = left + width;
+      const bottom = top + height;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${width}px`;
+      panel.style.maxHeight = `${height}px`;
+      const natural = panel.getBoundingClientRect();
+      const below = Math.max(0, bottom - anchor.bottom);
+      const above = Math.max(0, anchor.top - top);
+      const flipUp = natural.height > below && above > below;
+      const availableHeight = Math.min(height, flipUp ? above : below);
+      panel.style.maxHeight = `${availableHeight}px`;
+
+      const size = panel.getBoundingClientRect();
+      // Prefer left alignment; flip to right alignment on a collision.
+      let x = anchor.left;
+      if (x + size.width > right) x = anchor.right - size.width;
+      const y = flipUp ? anchor.top - size.height : anchor.bottom;
+      panel.style.left = `${Math.max(left, Math.min(x, right - size.width))}px`;
+      panel.style.top = `${Math.max(top, Math.min(y, bottom - size.height))}px`;
+      panel.dataset.positioned = '';
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      const open = event.newState === 'open';
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) schedulePosition();
+      else {
+        cancelAnimationFrame(positionFrame);
+        delete panel.dataset.positioned;
+      }
+    });
+
+    // Recalculate for scrolling ancestors, resizing, zoom and layout changes.
+    window.addEventListener('scroll', schedulePosition, true);
+    window.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const observer = new ResizeObserver(schedulePosition);
+    observer.observe(trigger);
+    observer.observe(document.querySelector('nav'));
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-destination]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.destination);
+    });
+  </script>
