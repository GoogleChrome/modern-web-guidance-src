+  <script type="module">
+    const form = document.querySelector('#coffee-preferences');
+    const reminder = document.querySelector('#pickup-reminder');
+    const anniversary = document.querySelector('#coffee-anniversary');
+    const saveButton = document.querySelector('#save-preferences');
+    const status = document.querySelector('#preferences-status');
+    const storageKey = 'daily-grind.coffee-preferences';
+
+    try {
+      // Plain types carry no time zone. Never convert these values to Date,
+      // an instant, or UTC, even when persisting or restoring them.
+      const temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+
+      function plainPreferences(time, date) {
+        if (typeof time !== 'string' || typeof date !== 'string' ||
+            (time && !/^\d{2}:\d{2}$/.test(time)) ||
+            (date && !/^\d{4,}-\d{2}-\d{2}$/.test(date))) {
+          throw new RangeError('Invalid coffee preferences');
+        }
+        return {
+          pickupReminderTime: time
+            ? temporal.PlainTime.from(time).toString({ smallestUnit: 'minute' }) : '',
+          coffeeAnniversaryDate: date ? temporal.PlainDate.from(date).toString() : ''
+        };
+      }
+
+      try {
+        const stored = localStorage.getItem(storageKey);
+        if (stored !== null) {
+          const saved = JSON.parse(stored);
+          const preferences = plainPreferences(saved.pickupReminderTime, saved.coffeeAnniversaryDate);
+          reminder.value = preferences.pickupReminderTime;
+          anniversary.value = preferences.coffeeAnniversaryDate;
+        }
+        status.textContent = '';
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          const preferences = plainPreferences(reminder.value, anniversary.value);
+          // Persist only ISO calendar and clock strings, never timestamps.
+          localStorage.setItem(storageKey, JSON.stringify(preferences));
+          status.textContent = 'Preferences saved on this device.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Check your selections and allow browser storage, then try again.';
+        }
+      });
+      saveButton.disabled = false;
+    } catch {
+      status.textContent = 'Preferences could not be initialized. Please reload to try again.';
+    }
+  </script>
+
 </body>
 
