+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const pickup = document.getElementById('pickup-reminder');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are floating calendar values, never instants in time. Keep the
+      // native input strings intact: no Date, UTC, or timezone conversions.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminder === 'string' && /^([01]\d|2[0-3]):[0-5]\d$/.test(saved.pickupReminder)) {
+            pickup.value = saved.pickupReminder;
+          }
+          if (typeof saved.coffeeAnniversary === 'string' && /^\d{4,}-\d{2}-\d{2}$/.test(saved.coffeeAnniversary)) {
+            // The date input rejects invalid calendar dates itself.
+            anniversary.value = saved.coffeeAnniversary;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still choose your time and date.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminder: pickup.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your time and date will stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved in this browser. Please allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
