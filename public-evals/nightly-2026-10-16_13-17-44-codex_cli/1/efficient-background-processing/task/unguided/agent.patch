+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var temperature = document.getElementById('roast-temp-value');
+      var context = canvas.getContext('2d');
+      var frameId = null;
+      var intervalId = null;
+      var inView = false;
+      var renderingSkipped = false;
+      var pageActive = true;
+      var running = false;
+      var lastTime = null;
+      var roastTime = 0;
+      var width = 0;
+      var height = 0;
+      var requestFrame = window.requestAnimationFrame
+        ? window.requestAnimationFrame.bind(window)
+        : function (callback) { return window.setTimeout(function () { callback(Date.now()); }, 33); };
+      var cancelFrame = window.cancelAnimationFrame
+        ? window.cancelAnimationFrame.bind(window) : window.clearTimeout.bind(window);
+      var beans = [];
+
+      for (var i = 0; i < 42; i++) {
+        beans.push({ phase: Math.random() * Math.PI * 2, radius: 0.3 + Math.random() * 0.65,
+          speed: 0.5 + Math.random() * 0.6, size: 7 + Math.random() * 5 });
+      }
+
+      function draw(time) {
+        if (!running) return;
+        if (lastTime !== null) roastTime += Math.min(time - lastTime, 50) / 1000;
+        lastTime = time;
+        var nextWidth = canvas.clientWidth;
+        var nextHeight = canvas.clientHeight;
+        var ratio = Math.min(window.devicePixelRatio || 1, 2);
+        if (width !== nextWidth || height !== nextHeight || canvas.width !== Math.round(nextWidth * ratio)) {
+          width = nextWidth;
+          height = nextHeight;
+          canvas.width = Math.round(width * ratio);
+          canvas.height = Math.round(height * ratio);
+          context.setTransform(ratio, 0, 0, ratio, 0, 0);
+        }
+        context.clearRect(0, 0, width, height);
+        context.fillStyle = '#382720';
+        context.beginPath();
+        context.ellipse(width / 2, height / 2, width * 0.46, height * 0.46, 0, 0, Math.PI * 2);
+        context.fill();
+        beans.forEach(function (bean) {
+          var angle = bean.phase + roastTime * bean.speed;
+          context.save();
+          context.translate(width / 2 + Math.cos(angle) * width * 0.4 * bean.radius,
+            height / 2 + Math.sin(angle) * height * 0.38 * bean.radius);
+          context.rotate(angle * 2);
+          context.fillStyle = '#a5673c';
+          context.beginPath();
+          context.ellipse(0, 0, bean.size, bean.size * 0.65, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#492b20';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-bean.size * 0.65, 0);
+          context.bezierCurveTo(-2, -4, 2, 4, bean.size * 0.65, 0);
+          context.stroke();
+          context.restore();
+        });
+        frameId = requestFrame(draw);
+      }
+
+      function syncActivity() {
+        var shouldRun = inView && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        if (running) {
+          lastTime = null;
+          if (context) frameId = requestFrame(draw);
+          intervalId = window.setInterval(function () {
+            temperature.textContent = String(185 + Math.round(12 * Math.sin(roastTime / 15) + Math.random() * 2));
+          }, 1000);
+        } else {
+          if (frameId !== null) cancelFrame(frameId);
+          if (intervalId !== null) window.clearInterval(intervalId);
+          frameId = null;
+          intervalId = null;
+          lastTime = null;
+        }
+      }
+
+      function checkViewport() {
+        var rect = widget.getBoundingClientRect();
+        inView = rect.bottom > 0 && rect.right > 0 &&
+          rect.top < (window.innerHeight || document.documentElement.clientHeight) &&
+          rect.left < (window.innerWidth || document.documentElement.clientWidth);
+        syncActivity();
+      }
+
+      // Native content-visibility rendering state, where supported.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          renderingSkipped = event.skipped;
+          checkViewport();
+        });
+      }
+
+      // Viewport checks also pause work in the browser's offscreen rendering margin.
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            inView = entry.isIntersecting && entry.intersectionRatio > 0;
+          });
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Older browsers: event-driven checks, with no background polling timer.
+        window.addEventListener('scroll', checkViewport, true);
+        window.addEventListener('resize', checkViewport);
+      }
+      document.addEventListener('visibilitychange', checkViewport);
+      window.addEventListener('pagehide', function () { pageActive = false; syncActivity(); });
+      window.addEventListener('pageshow', function () { pageActive = true; checkViewport(); });
+      checkViewport();
+    }());
+  </script>
