diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..7697b0c
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,105 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+  articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+{articles.length > 0 && (
+  <top-stories-slider class="block bg-white border-b border-gray-300">
+    <section
+      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4"
+      aria-label="Top Stories"
+      aria-roledescription="carousel"
+    >
+      <div class="overflow-hidden" aria-live="polite" aria-atomic="true">
+        {articles.map((article, index) => (
+          <div
+            data-story
+            hidden={index !== 0}
+            role="group"
+            aria-roledescription="slide"
+            aria-label={`${index + 1} of ${articles.length}`}
+          >
+            <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+              <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+            </a>
+            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+          </div>
+        ))}
+      </div>
+      <div class="mt-3 flex items-center gap-3" data-controls hidden>
+        <button type="button" data-previous class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">
+          Previous
+        </button>
+        <span data-position class="text-xs text-gray-500" aria-hidden="true">1 / {articles.length}</span>
+        <button type="button" data-next class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">
+          Next
+        </button>
+      </div>
+    </section>
+  </top-stories-slider>
+)}
+
+<style>
+  [hidden] {
+    display: none;
+  }
+
+  [data-direction='next'] {
+    animation: slide-from-right 300ms ease-out;
+  }
+
+  [data-direction='previous'] {
+    animation: slide-from-left 300ms ease-out;
+  }
+
+  @keyframes slide-from-right {
+    from { transform: translateX(100%); }
+    to { transform: translateX(0); }
+  }
+
+  @keyframes slide-from-left {
+    from { transform: translateX(-100%); }
+    to { transform: translateX(0); }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    [data-story] {
+      animation: none;
+    }
+  }
+</style>
+
+<script>
+  class TopStoriesSlider extends HTMLElement {
+    connectedCallback() {
+      if (this.dataset.initialized) return;
+      this.dataset.initialized = 'true';
+
+      const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+      const controls = this.querySelector<HTMLElement>('[data-controls]');
+      const position = this.querySelector<HTMLElement>('[data-position]');
+      let current = 0;
+
+      if (stories.length < 2 || !controls || !position) return;
+      controls.hidden = false;
+
+      const changeStory = (direction: 'next' | 'previous') => {
+        stories[current].hidden = true;
+        current = (current + (direction === 'next' ? 1 : -1) + stories.length) % stories.length;
+        stories[current].dataset.direction = direction;
+        stories[current].hidden = false;
+        position.textContent = `${current + 1} / ${stories.length}`;
+      };
+
+      this.querySelector('[data-previous]')?.addEventListener('click', () => changeStory('previous'));
+      this.querySelector('[data-next]')?.addEventListener('click', () => changeStory('next'));
+    }
+  }
+
+  customElements.define('top-stories-slider', TopStoriesSlider);
+</script>
