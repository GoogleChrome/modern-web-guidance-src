+  <script>
+    const seasonalItems = Array.from(document.querySelectorAll('#seasonal-items .card'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    let seasonalIndex = 0;
+
+    function showSeasonalItem(direction) {
+      seasonalItems.forEach((item) => {
+        item.hidden = true;
+        item.classList.remove('enter-next', 'enter-previous');
+      });
+      seasonalIndex = (seasonalIndex + direction + seasonalItems.length) % seasonalItems.length;
+      const item = seasonalItems[seasonalIndex];
+      item.hidden = false;
+      item.classList.add(direction === 1 ? 'enter-next' : 'enter-previous');
+      seasonalStatus.textContent = `${seasonalIndex + 1} of ${seasonalItems.length} — ${item.querySelector('h3').textContent}`;
+    }
+
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalItem(1));
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalItem(-1));
+  </script>
