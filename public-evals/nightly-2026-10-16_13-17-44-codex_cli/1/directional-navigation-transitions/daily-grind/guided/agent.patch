+  <script>
+    const slides = Array.from(document.querySelectorAll('.seasonal-slides .card'));
+    const controls = document.querySelector('.seasonal-controls');
+    const previous = document.getElementById('seasonal-previous');
+    const next = document.getElementById('seasonal-next');
+    const status = document.getElementById('seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentIndex = 0;
+    let transitioning = false;
+
+    controls.hidden = false;
+
+    async function showSlide(step) {
+      if (transitioning) return;
+
+      const update = () => {
+        slides[currentIndex].hidden = true;
+        currentIndex = (currentIndex + step + slides.length) % slides.length;
+        slides[currentIndex].hidden = false;
+        status.textContent = `${currentIndex + 1} of ${slides.length}: ${slides[currentIndex].querySelector('h3').textContent}`;
+      };
+
+      if (reducedMotion.matches || !document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))')) {
+        update();
+        return;
+      }
+
+      transitioning = true;
+      previous.disabled = next.disabled = true;
+      try {
+        const transition = document.startViewTransition({
+          update,
+          types: [step > 0 ? 'forward' : 'backward']
+        });
+        await transition.finished;
+      } finally {
+        transitioning = false;
+        previous.disabled = next.disabled = false;
+      }
+    }
+
+    previous.addEventListener('click', () => showSlide(-1));
+    next.addEventListener('click', () => showSlide(1));
+  </script>
