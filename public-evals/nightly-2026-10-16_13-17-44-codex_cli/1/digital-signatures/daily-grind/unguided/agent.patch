+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+export const encode = (bytes) => { let s=''; for (const byte of bytes) s+=String.fromCharCode(byte); return btoa(s); };
+export const decode = (text) => Uint8Array.from(atob(text.trim()), c=>c.charCodeAt(0));
+export async function generate(algorithm) {
+  if(algorithm==='ML-DSA-65') return {algorithm,...ml_dsa65.keygen()};
+  const params=algorithm==='ECDSA'?{name:'ECDSA',namedCurve:'P-256'}:{name:'Ed25519'};
+  const pair=await crypto.subtle.generateKey(params,true,['sign','verify']);
+  return {algorithm,privateKey:pair.privateKey,publicKey:pair.publicKey};
+}
+export async function sign(key,data) {
+  if(!key.privateKey&&!key.secretKey) throw new Error('This is a public key. Choose a key pair to sign.');
+  if(key.algorithm==='ML-DSA-65') return ml_dsa65.sign(data,key.secretKey);
+  return new Uint8Array(await crypto.subtle.sign(key.algorithm==='ECDSA'?{name:'ECDSA',hash:'SHA-256'}:'Ed25519',key.privateKey,data));
+}
+export async function verify(key,data,signature) {
+  if(key.algorithm==='ML-DSA-65') return ml_dsa65.verify(signature,data,key.publicKey);
+  return crypto.subtle.verify(key.algorithm==='ECDSA'?{name:'ECDSA',hash:'SHA-256'}:'Ed25519',key.publicKey,signature,data);
+}
+export async function exportKey(key,includePrivate=false){
+  const output={format:'signet-key-v1',name:key.name,algorithm:key.algorithm};
+  if(key.algorithm==='ML-DSA-65'){
+    output.publicKey=encode(key.publicKey);
+    if(includePrivate&&key.secretKey) output.secretKey=encode(key.secretKey);
+  }else{
+    output.publicKey=await crypto.subtle.exportKey('jwk',key.publicKey);
+    if(includePrivate&&key.privateKey) output.privateKey=await crypto.subtle.exportKey('jwk',key.privateKey);
+  }
+  return output;
+}
+export async function importKey(input){
+  if(input.format!=='signet-key-v1'||!['Ed25519','ECDSA','ML-DSA-65'].includes(input.algorithm)) throw new Error('Choose a valid Signet key export.');
+  const key={algorithm:input.algorithm,name:String(input.name||'Imported key').slice(0,60)};
+  if(input.algorithm==='ML-DSA-65'){
+    key.publicKey=decode(input.publicKey);
+    if(key.publicKey.length!==1952)throw new Error('Invalid ML-DSA-65 public key.');
+    if(input.secretKey){key.secretKey=decode(input.secretKey);if(key.secretKey.length!==4032)throw new Error('Invalid private key.');}
+  }else{
+    const params=input.algorithm==='ECDSA'?{name:'ECDSA',namedCurve:'P-256'}:{name:'Ed25519'};
+    key.publicKey=await crypto.subtle.importKey('jwk',input.publicKey,params,true,['verify']);
+    if(input.privateKey)key.privateKey=await crypto.subtle.importKey('jwk',input.privateKey,params,true,['sign']);
+  }
+  if(key.secretKey||key.privateKey){const challenge=crypto.getRandomValues(new Uint8Array(32));if(!await verify(key,challenge,await sign(key,challenge)))throw new Error('The public and private keys do not match.');}
+  return key;
+}
+export async function fingerprint(key){
+  const bytes=key.algorithm==='ML-DSA-65'?key.publicKey:new Uint8Array(await crypto.subtle.exportKey('raw',key.publicKey));
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),n=>n.toString(16).padStart(2,'0')).join('');
+}
