diff --git a/crypto.mjs b/crypto.mjs
new file mode 100644
index 0000000..6e929b8
--- /dev/null
+++ b/crypto.mjs
@@ -0,0 +1,46 @@
+export const encoder = new TextEncoder();
+export const encode = value => encoder.encode(value);
+export function toBase64(bytes) {
+  let binary = '';
+  for (let i = 0; i < bytes.length; i += 8192) binary += String.fromCharCode(...bytes.subarray(i, i + 8192));
+  return btoa(binary);
+}
+export const fromBase64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+export function parameters(algorithm) {
+  return algorithm === 'ECDSA' ? { name: 'ECDSA', namedCurve: 'P-256' } : algorithm;
+}
+function operation(algorithm, context) {
+  return algorithm === 'ECDSA' ? { name: 'ECDSA', hash: 'SHA-256' } : algorithm.startsWith('ML-DSA') ? { name: algorithm, context } : algorithm;
+}
+function framed(bytes, context) {
+  const result = new Uint8Array(1 + context.length + bytes.length);
+  result[0] = context.length;
+  result.set(context, 1);
+  result.set(bytes, context.length + 1);
+  return result;
+}
+function contextBytes(context) {
+  const bytes = encode(context);
+  if (bytes.length > 255) throw new Error('Context must be no longer than 255 UTF-8 bytes.');
+  return bytes;
+}
+export async function generateKey(algorithm) {
+  return crypto.subtle.generateKey(parameters(algorithm), false, ['sign', 'verify']);
+}
+export async function publicKeyBytes(pair, algorithm) {
+  return new Uint8Array(await crypto.subtle.exportKey(algorithm.startsWith('ML-DSA') ? 'raw-public' : 'raw', pair.publicKey));
+}
+export async function fingerprint(bytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+  return [...digest.subarray(0, 12)].map(n => n.toString(16).padStart(2, '0')).join(':');
+}
+export async function signData(pair, algorithm, bytes, context = '') {
+  const ctx = contextBytes(context);
+  return new Uint8Array(await crypto.subtle.sign(operation(algorithm, ctx), pair.privateKey, algorithm.startsWith('ML-DSA') ? bytes : framed(bytes, ctx)));
+}
+export async function verifyData(bundle, bytes, context = bundle.context || '') {
+  if (bundle.version !== 1 || !['Ed25519', 'ECDSA', 'ML-DSA-44', 'ML-DSA-65', 'ML-DSA-87'].includes(bundle.algorithm) || typeof bundle.publicKey !== 'string' || typeof bundle.signature !== 'string') throw new Error('This is not a supported Signet signature bundle.');
+  const ctx = contextBytes(context);
+  const key = await crypto.subtle.importKey(bundle.algorithm.startsWith('ML-DSA') ? 'raw-public' : 'raw', fromBase64(bundle.publicKey), parameters(bundle.algorithm), false, ['verify']);
+  return crypto.subtle.verify(operation(bundle.algorithm, ctx), key, fromBase64(bundle.signature), bundle.algorithm.startsWith('ML-DSA') ? bytes : framed(bytes, ctx));
+}
