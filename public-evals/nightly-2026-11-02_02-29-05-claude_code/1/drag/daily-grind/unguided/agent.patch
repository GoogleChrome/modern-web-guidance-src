+  <aside class="quick-order" id="quickOrder" aria-label="Quick order cart">
+    <div class="qo-header" id="qoHandle" tabindex="0" role="toolbar"
+      aria-label="Quick order panel. Drag, or use arrow keys to move.">
+      <span><span class="qo-grip" aria-hidden="true">&#8942;&#8942;</span><span class="qo-title">Quick Order</span><span
+          class="qo-badge" id="qoBadge">0</span></span>
+      <button type="button" class="qo-toggle" id="qoToggle" aria-expanded="true" aria-controls="qoBody"
+        aria-label="Collapse quick order panel">&minus;</button>
+    </div>
+    <div class="qo-body" id="qoBody">
+      <div id="qoItems"></div>
+      <label class="qo-pickup">
+        <input type="checkbox" id="qoPickup"> Pick up in store (skip the line)
+      </label>
+      <div class="qo-total"><span>Total</span><span id="qoTotal">$0.00</span></div>
+      <div class="qo-actions">
+        <button type="button" class="qo-clear" id="qoClear">Clear</button>
+        <button type="button" class="qo-checkout" id="qoCheckout" disabled>Checkout</button>
+      </div>
+      <p class="qo-hint">Drag the header to move this panel. Double-click it to reset.</p>
+    </div>
+  </aside>
+
+  <script>
+    (function () {
+      var MENU = [
+        { id: 'maple-oat-latte', name: 'Maple Oat Latte', price: 5.25 },
+        { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', price: 3.50 },
+        { id: 'cold-brew', name: 'Cold Brew', price: 4.75 }
+      ];
+      var SIZES = { S: 0, M: 0.5, L: 1.0 };
+      var MAX_QTY = 9;
+      var STORAGE_KEY = 'dailyGrindQuickOrder';
+      var MARGIN = 8;
+
+      var panel = document.getElementById('quickOrder');
+      var handle = document.getElementById('qoHandle');
+      var toggle = document.getElementById('qoToggle');
+      var itemsEl = document.getElementById('qoItems');
+      var badge = document.getElementById('qoBadge');
+      var totalEl = document.getElementById('qoTotal');
+      var pickup = document.getElementById('qoPickup');
+      var checkout = document.getElementById('qoCheckout');
+
+      var state = { cart: {}, pickup: false, collapsed: false, pos: null };
+      try {
+        var saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (saved && typeof saved === 'object') {
+          state.cart = saved.cart || {};
+          state.pickup = !!saved.pickup;
+          state.collapsed = !!saved.collapsed;
+          state.pos = saved.pos || null;
+        }
+      } catch (e) { /* ignore corrupt or unavailable storage */ }
+
+      MENU.forEach(function (item) {
+        var c = state.cart[item.id];
+        if (!c || !(c.size in SIZES)) c = { qty: 0, size: 'M' };
+        c.qty = Math.max(0, Math.min(MAX_QTY, parseInt(c.qty, 10) || 0));
+        state.cart[item.id] = c;
+      });
+
+      function save() {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { }
+      }
+
+      function money(n) { return '$' + n.toFixed(2); }
+      function unitPrice(item) { return item.price + SIZES[state.cart[item.id].size]; }
+
+      // ---- Cart rendering ----
+      function buildItems() {
+        MENU.forEach(function (item) {
+          var row = document.createElement('div');
+          row.className = 'qo-item';
+          row.innerHTML =
+            '<span class="qo-item-name"></span>' +
+            '<div class="qo-stepper">' +
+            '<button type="button" data-step="-1">&minus;</button>' +
+            '<span class="qo-qty" aria-live="polite"></span>' +
+            '<button type="button" data-step="1">+</button>' +
+            '</div>' +
+            '<div class="qo-options">' +
+            '<select aria-label="Size"><option value="S">Small</option><option value="M">Medium</option><option value="L">Large</option></select>' +
+            '<span class="qo-item-price"></span>' +
+            '</div>';
+          row.querySelector('.qo-item-name').textContent = item.name;
+          row.querySelector('[data-step="-1"]').setAttribute('aria-label', 'Remove one ' + item.name);
+          row.querySelector('[data-step="1"]').setAttribute('aria-label', 'Add one ' + item.name);
+          row.querySelector('select').setAttribute('aria-label', item.name + ' size');
+
+          row.querySelectorAll('[data-step]').forEach(function (btn) {
+            btn.addEventListener('click', function () {
+              changeQty(item.id, parseInt(btn.dataset.step, 10));
+            });
+          });
+          row.querySelector('select').addEventListener('change', function (e) {
+            state.cart[item.id].size = e.target.value;
+            update();
+          });
+          item.row = row;
+          itemsEl.appendChild(row);
+        });
+      }
+
+      function changeQty(id, delta) {
+        var c = state.cart[id];
+        c.qty = Math.max(0, Math.min(MAX_QTY, c.qty + delta));
+        update();
+      }
+
+      function update() {
+        var count = 0, total = 0;
+        MENU.forEach(function (item) {
+          var c = state.cart[item.id];
+          var row = item.row;
+          row.querySelector('.qo-qty').textContent = c.qty;
+          row.querySelector('select').value = c.size;
+          row.querySelector('.qo-item-price').textContent = money(unitPrice(item)) + ' ea';
+          row.querySelector('[data-step="-1"]').disabled = c.qty === 0;
+          row.querySelector('[data-step="1"]').disabled = c.qty >= MAX_QTY;
+          count += c.qty;
+          total += c.qty * unitPrice(item);
+        });
+        badge.textContent = count;
+        totalEl.textContent = money(total);
+        checkout.disabled = count === 0;
+        pickup.checked = state.pickup;
+        save();
+      }
+
+      // ---- Collapse ----
+      function applyCollapsed() {
+        panel.classList.toggle('collapsed', state.collapsed);
+        toggle.setAttribute('aria-expanded', String(!state.collapsed));
+        toggle.setAttribute('aria-label', (state.collapsed ? 'Expand' : 'Collapse') + ' quick order panel');
+        toggle.innerHTML = state.collapsed ? '+' : '&minus;';
+      }
+
+      toggle.addEventListener('click', function () {
+        state.collapsed = !state.collapsed;
+        applyCollapsed();
+        clampToViewport();
+        save();
+      });
+
+      // ---- Dragging ----
+      function setPos(x, y) {
+        var maxX = Math.max(MARGIN, window.innerWidth - panel.offsetWidth - MARGIN);
+        var maxY = Math.max(MARGIN, window.innerHeight - panel.offsetHeight - MARGIN);
+        x = Math.min(Math.max(MARGIN, x), maxX);
+        y = Math.min(Math.max(MARGIN, y), maxY);
+        panel.style.left = x + 'px';
+        panel.style.top = y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        state.pos = { x: x, y: y };
+      }
+
+      function clampToViewport() {
+        if (state.pos) setPos(state.pos.x, state.pos.y);
+      }
+
+      function resetPos() {
+        state.pos = null;
+        panel.style.left = panel.style.top = panel.style.right = panel.style.bottom = '';
+        save();
+      }
+
+      var drag = null;
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.button !== 0 || e.target.closest('button')) return;
+        var rect = panel.getBoundingClientRect();
+        drag = { id: e.pointerId, dx: e.clientX - rect.left, dy: e.clientY - rect.top };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        setPos(e.clientX - drag.dx, e.clientY - drag.dy);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('dragging');
+        if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+        save();
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      handle.addEventListener('dblclick', function (e) {
+        if (!e.target.closest('button')) resetPos();
+      });
+
+      // Keyboard moving for users who can't drag
+      handle.addEventListener('keydown', function (e) {
+        if (e.target !== handle) return;
+        var step = e.shiftKey ? 50 : 10;
+        var moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+        if (moves[e.key]) {
+          var rect = panel.getBoundingClientRect();
+          setPos(rect.left + moves[e.key][0], rect.top + moves[e.key][1]);
+          save();
+          e.preventDefault();
+        } else if (e.key === 'Home') {
+          resetPos();
+          e.preventDefault();
+        }
+      });
+
+      window.addEventListener('resize', clampToViewport);
+
+      // ---- Other controls ----
+      pickup.addEventListener('change', function () {
+        state.pickup = pickup.checked;
+        save();
+      });
+
+      document.getElementById('qoClear').addEventListener('click', function () {
+        MENU.forEach(function (item) { state.cart[item.id].qty = 0; });
+        update();
+      });
+
+      checkout.addEventListener('click', function () {
+        var params = new URLSearchParams();
+        MENU.forEach(function (item) {
+          var c = state.cart[item.id];
+          if (c.qty > 0) params.append('item', item.id + ':' + c.size + ':' + c.qty);
+        });
+        if (state.pickup) params.set('pickup', '1');
+        window.location.href = '/order-online?' + params.toString();
+      });
+
+      document.querySelectorAll('[data-add]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          if (!state.cart[btn.dataset.add]) return;
+          changeQty(btn.dataset.add, 1);
+          if (state.collapsed) {
+            state.collapsed = false;
+            applyCollapsed();
+            clampToViewport();
+            save();
+          }
+        });
+      });
+
+      buildItems();
+      applyCollapsed();
+      update();
+      if (state.pos) setPos(state.pos.x, state.pos.y);
+    })();
+  </script>
+
 </body>
 
 </html>
