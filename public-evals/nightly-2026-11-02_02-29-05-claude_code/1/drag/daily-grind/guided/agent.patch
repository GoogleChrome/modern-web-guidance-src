+  <aside class="quick-order" id="quick-order" aria-labelledby="qo-title">
+    <div class="qo-header">
+      <button type="button" class="qo-grip" hidden
+        aria-label="Move quick order panel. Use arrow keys to reposition.">&#x2807;</button>
+      <h2 id="qo-title">&#9749; Quick Order</h2>
+      <button type="button" class="qo-toggle" aria-expanded="true" aria-controls="qo-body"
+        aria-label="Collapse quick order panel">&minus;</button>
+    </div>
+    <form class="qo-body" id="qo-body" action="/order-online" method="get">
+      <label>Drink
+        <select name="drink" id="qo-drink">
+          <option value="maple-oat-latte" data-price="5.25">Maple Oat Latte</option>
+          <option value="dark-roast-espresso" data-price="3.50">Dark Roast Espresso</option>
+          <option value="cold-brew" data-price="4.75">Cold Brew</option>
+          <option value="cappuccino" data-price="4.50">Cappuccino</option>
+          <option value="chai-latte" data-price="4.95">Chai Latte</option>
+        </select>
+      </label>
+      <fieldset>
+        <legend>Size</legend>
+        <div class="qo-sizes">
+          <label><input type="radio" name="size" value="small" data-extra="0"> Small</label>
+          <label><input type="radio" name="size" value="medium" data-extra="0.50" checked> Medium</label>
+          <label><input type="radio" name="size" value="large" data-extra="1.00"> Large</label>
+        </div>
+      </fieldset>
+      <label>Milk
+        <select name="milk" id="qo-milk">
+          <option value="whole" data-extra="0">Whole milk</option>
+          <option value="oat" data-extra="0.60">Oat milk (+$0.60)</option>
+          <option value="almond" data-extra="0.60">Almond milk (+$0.60)</option>
+          <option value="none" data-extra="0">No milk</option>
+        </select>
+      </label>
+      <div class="qo-row">
+        <label for="qo-qty">Quantity</label>
+        <div class="qo-stepper">
+          <button type="button" data-step="-1" aria-label="Decrease quantity">&minus;</button>
+          <input type="number" name="qty" id="qo-qty" value="1" min="1" max="10" inputmode="numeric">
+          <button type="button" data-step="1" aria-label="Increase quantity">+</button>
+        </div>
+      </div>
+      <button type="submit" class="qo-add">Add to Cart &middot; <output id="qo-price" for="qo-drink qo-milk qo-qty">$5.75</output></button>
+      <section class="qo-cart" aria-labelledby="qo-cart-title">
+        <h3 id="qo-cart-title">Your Cart</h3>
+        <ul id="qo-cart-list"></ul>
+        <p class="qo-empty" id="qo-empty">Your cart is empty.</p>
+        <p class="qo-total" aria-live="polite">Total: <span id="qo-total">$0.00</span></p>
+      </section>
+      <a href="/order-online" class="qo-checkout" id="qo-checkout">Checkout</a>
+    </form>
+  </aside>
+
+  <script>
+    (() => {
+      const panel = document.getElementById('quick-order');
+      const header = panel.querySelector('.qo-header');
+      const grip = panel.querySelector('.qo-grip');
+      const toggle = panel.querySelector('.qo-toggle');
+      const form = document.getElementById('qo-body');
+      const drinkEl = document.getElementById('qo-drink');
+      const milkEl = document.getElementById('qo-milk');
+      const qtyEl = document.getElementById('qo-qty');
+      const priceEl = document.getElementById('qo-price');
+      const listEl = document.getElementById('qo-cart-list');
+      const emptyEl = document.getElementById('qo-empty');
+      const totalEl = document.getElementById('qo-total');
+      const checkoutEl = document.getElementById('qo-checkout');
+      const POS_KEY = 'dg-quick-order-pos';
+      const CART_KEY = 'dg-quick-order-cart';
+      const KEY_STEP = 15;
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      /* ---------- Dragging ---------- */
+      header.classList.add('drag-handle');
+      grip.hidden = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        const x = Math.max(0, Math.min(left, maxLeft));
+        const y = Math.max(0, Math.min(top, maxTop));
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        return { x, y };
+      }
+
+      function savePosition() {
+        const rect = panel.getBoundingClientRect();
+        try { localStorage.setItem(POS_KEY, JSON.stringify({ x: rect.left, y: rect.top })); } catch {}
+      }
+
+      function reclamp() {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(POS_KEY));
+        if (saved) moveTo(saved.x, saved.y);
+      } catch {}
+
+      let offsetX = 0, offsetY = 0, startX = 0, startY = 0;
+
+      header.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('button:not(.qo-grip), input, select, textarea, a')) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        header.setPointerCapture(event.pointerId);
+      });
+
+      header.addEventListener('pointermove', (event) => {
+        if (!header.hasPointerCapture(event.pointerId)) return;
+        if (!header.classList.contains('dragging')) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
+          header.classList.add('dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      header.addEventListener('lostpointercapture', () => {
+        if (header.classList.contains('dragging')) savePosition();
+        header.classList.remove('dragging');
+      });
+
+      grip.addEventListener('keydown', (event) => {
+        const deltas = {
+          ArrowLeft: [-KEY_STEP, 0], ArrowRight: [KEY_STEP, 0],
+          ArrowUp: [0, -KEY_STEP], ArrowDown: [0, KEY_STEP],
+        };
+        const delta = deltas[event.key];
+        if (!delta) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+        savePosition();
+      });
+
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      /* ---------- Collapse ---------- */
+      toggle.addEventListener('click', () => {
+        const expanded = toggle.getAttribute('aria-expanded') === 'true';
+        toggle.setAttribute('aria-expanded', String(!expanded));
+        toggle.setAttribute('aria-label', `${expanded ? 'Expand' : 'Collapse'} quick order panel`);
+        toggle.innerHTML = expanded ? '+' : '&minus;';
+        form.hidden = expanded;
+      });
+
+      /* ---------- Order builder ---------- */
+      const clampQty = (n) => Math.max(1, Math.min(10, Number.isFinite(n) ? Math.round(n) : 1));
+
+      function currentItem() {
+        const drink = drinkEl.selectedOptions[0];
+        const size = form.querySelector('input[name="size"]:checked');
+        const milk = milkEl.selectedOptions[0];
+        const qty = clampQty(qtyEl.valueAsNumber);
+        const unit = Number(drink.dataset.price) + Number(size.dataset.extra) + Number(milk.dataset.extra);
+        return {
+          id: [drink.value, size.value, milk.value].join('|'),
+          name: drink.textContent,
+          size: size.value,
+          milk: milk.value,
+          qty,
+          unit,
+        };
+      }
+
+      function updatePrice() {
+        const item = currentItem();
+        priceEl.value = money(item.unit * item.qty);
+      }
+
+      form.addEventListener('input', updatePrice);
+      form.addEventListener('change', () => {
+        qtyEl.value = clampQty(qtyEl.valueAsNumber);
+        updatePrice();
+      });
+
+      panel.querySelectorAll('[data-step]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          qtyEl.value = clampQty((qtyEl.valueAsNumber || 1) + Number(btn.dataset.step));
+          updatePrice();
+        });
+      });
+
+      /* ---------- Cart ---------- */
+      let cart = [];
+      try { cart = JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch {}
+
+      function renderCart() {
+        listEl.replaceChildren(...cart.map((item, i) => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.qty}× ${item.name} (${item.size}, ${item.milk})`;
+          const price = document.createElement('span');
+          price.textContent = money(item.unit * item.qty);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'qo-remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${item.name} from cart`);
+          remove.addEventListener('click', () => {
+            cart.splice(i, 1);
+            saveCart();
+            renderCart();
+            (listEl.querySelector('.qo-remove') || drinkEl).focus();
+          });
+          li.append(label, price, remove);
+          return li;
+        }));
+        const total = cart.reduce((sum, item) => sum + item.unit * item.qty, 0);
+        totalEl.textContent = money(total);
+        emptyEl.hidden = cart.length > 0;
+        checkoutEl.setAttribute('aria-disabled', String(cart.length === 0));
+      }
+
+      function saveCart() {
+        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch {}
+      }
+
+      function addToCart(item) {
+        const existing = cart.find((c) => c.id === item.id);
+        if (existing) existing.qty = Math.min(99, existing.qty + item.qty);
+        else cart.push(item);
+        saveCart();
+        renderCart();
+      }
+
+      checkoutEl.addEventListener('click', (event) => {
+        if (cart.length === 0) event.preventDefault();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        addToCart(currentItem());
+        qtyEl.value = 1;
+        updatePrice();
+      });
+
+      document.querySelectorAll('.card-quick-add').forEach((btn) => {
+        btn.hidden = false;
+        btn.addEventListener('click', () => {
+          drinkEl.value = btn.dataset.drink;
+          updatePrice();
+          if (form.hidden) toggle.click();
+          drinkEl.focus();
+        });
+      });
+
+      updatePrice();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
