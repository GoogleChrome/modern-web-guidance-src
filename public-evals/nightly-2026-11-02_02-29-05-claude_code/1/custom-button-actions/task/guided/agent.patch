+  <script>
+    // Load the Invoker Commands polyfill only in browsers without native support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      (async () => {
+        try {
+          await import('https://esm.run/invokers-polyfill');
+        } catch (err) {
+          console.error('Error loading invokers polyfill:', err);
+        }
+      })();
+    }
+
+    const toggleCommands = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    // The command event does not bubble, so listen on the target itself
+    document.getElementById('action-target').addEventListener('command', (event) => {
+      const target = event.target;
+      const className = toggleCommands[event.command];
+
+      if (className) {
+        const isOn = target.classList.toggle(className);
+        event.source?.setAttribute('aria-pressed', isOn);
+      } else if (event.command === '--reset') {
+        target.classList.remove(...Object.values(toggleCommands));
+        document.querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`).forEach((btn) => {
+          btn.setAttribute('aria-pressed', 'false');
+        });
+      }
+    });
+  </script>
