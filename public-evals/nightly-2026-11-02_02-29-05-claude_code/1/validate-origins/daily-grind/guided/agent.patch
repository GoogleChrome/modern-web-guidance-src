+  <script>
+    // Trusted ordering service allowed to post order updates to this page
+    const ORDERING_ORIGIN = 'https://order.thedailygrind.com';
+    const hasOriginApi = 'Origin' in globalThis;
+
+    // Prefer the browser-dispatched origin on MessageEvents (keeps opaque origins distinct);
+    // synthetic events only carry the serialized event.origin string.
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (candidate instanceof MessageEvent) return candidate.origin;
+      return candidate?.href ?? '';
+    }
+
+    function isTrustedOrderingMessage(event) {
+      try {
+        if (hasOriginApi) {
+          return extractOrigin(event).isSameOrigin(Origin.from(ORDERING_ORIGIN));
+        }
+        const senderOrigin = new URL(extractUrlString(event)).origin;
+        return senderOrigin !== 'null' && senderOrigin === new URL(ORDERING_ORIGIN).origin;
+      } catch {
+        return false;
+      }
+    }
+
+    // Same-site check (schemeful, Public Suffix List aware) against this page's own origin.
+    // Without the Origin API there is no PSL access, so fall back to a strict same-origin match.
+    function isSameSiteUrl(candidate) {
+      try {
+        if (hasOriginApi) {
+          const target = typeof candidate === 'string' ? new URL(candidate, location.href) : candidate;
+          return extractOrigin(target).isSameSite(Origin.from(self));
+        }
+        const targetOrigin = new URL(extractUrlString(candidate), location.href).origin;
+        return targetOrigin !== 'null' && targetOrigin === location.origin;
+      } catch {
+        return false;
+      }
+    }
+
+    function safeRedirect(target) {
+      if (isSameSiteUrl(target)) {
+        location.assign(new URL(target, location.href).href);
+      }
+    }
+
+    // Honor ?returnTo= only when it points back to our own site
+    const returnTo = new URLSearchParams(location.search).get('returnTo');
+    if (returnTo) {
+      safeRedirect(returnTo);
+    }
+
+    // Open off-site links in a new tab without handing them a reference to this window
+    for (const link of document.querySelectorAll('a[href]')) {
