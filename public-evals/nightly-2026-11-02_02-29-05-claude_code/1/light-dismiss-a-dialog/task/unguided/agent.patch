+  <script>
+    (function () {
+      const trigger = document.querySelector('.test-dialog-trigger');
+      const dialog = document.getElementById('logout-dialog');
+      if (!trigger || !dialog || typeof dialog.showModal !== 'function') return;
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      // Close when clicking the backdrop (outside the dialog box). The dialog has
+      // no padding, so clicks inside land on its content, not the dialog itself.
+      dialog.addEventListener('click', function (event) {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        const inside =
+          event.clientX >= rect.left && event.clientX <= rect.right &&
+          event.clientY >= rect.top && event.clientY <= rect.bottom;
+        if (!inside) dialog.close();
+      });
+    })();
+  </script>
