+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      const supportsScrollEnd = 'onscrollend' in window;
+
+      let pendingIndex = -1;
+      let lockedTarget = null; // set while a thumbnail-initiated scroll is in flight
+      let lastScrollLeft = gallery.scrollLeft;
+      let endTimer;
+
+      const viewCenter = () => gallery.scrollLeft + gallery.clientWidth / 2;
+      const itemCenter = (el) => el.offsetLeft + el.offsetWidth / 2;
+
+      function nearestIndex() {
+        const c = viewCenter();
+        let best = 0;
+        items.forEach((el, i) => {
+          if (Math.abs(itemCenter(el) - c) < Math.abs(itemCenter(items[best]) - c)) best = i;
+        });
+        return best;
+      }
+
+      // The item the user is moving towards, based on scroll direction.
+      function targetIndex(direction) {
+        const c = viewCenter();
+        let i = 0;
+        while (i < items.length - 1 && itemCenter(items[i + 1]) <= c + 1) i++;
+        if (Math.abs(itemCenter(items[i]) - c) < 1) return i;
+        return direction > 0 ? Math.min(i + 1, items.length - 1) : i;
+      }
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        thumbs[pendingIndex]?.classList.remove('pending');
+        thumbs[index]?.classList.add('pending');
+        pendingIndex = index;
+      }
+
+      function setActive(index) {
+        pendingIndex = -1;
+        thumbs.forEach((thumb, i) => {
+          const selected = i === index;
+          thumb.classList.remove('pending');
+          thumb.classList.toggle('active', selected);
+          if (selected) thumb.setAttribute('aria-current', 'true');
+          else thumb.removeAttribute('aria-current');
+        });
+      }
+
+      function onScrollEnd() {
+        clearTimeout(endTimer);
+        lockedTarget = null;
+        lastScrollLeft = gallery.scrollLeft;
+        setActive(nearestIndex());
+      }
+
+      gallery.addEventListener('scroll', () => {
+        const delta = gallery.scrollLeft - lastScrollLeft;
+        lastScrollLeft = gallery.scrollLeft;
+        if (lockedTarget === null && delta !== 0) setPending(targetIndex(Math.sign(delta)));
+        if (!supportsScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(onScrollEnd, 150);
+        }
+      }, { passive: true });
+
+      if (supportsScrollEnd) gallery.addEventListener('scrollend', onScrollEnd);
+
+      // If the user grabs the gallery mid-way through a thumbnail jump, follow them instead.
+      ['pointerdown', 'wheel', 'touchstart'].forEach((type) =>
+        gallery.addEventListener(type, () => { lockedTarget = null; }, { passive: true }));
+
+      thumbs.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          const left = itemCenter(items[i]) - gallery.clientWidth / 2;
+          const maxLeft = gallery.scrollWidth - gallery.clientWidth;
+          if (Math.abs(Math.min(Math.max(left, 0), maxLeft) - gallery.scrollLeft) < 1) {
+            setActive(i);
+            return;
+          }
+          lockedTarget = i;
+          setPending(i);
+          gallery.scrollTo({ left });
+        });
+      });
+
+      setActive(nearestIndex());
+    })();
+  </script>
