+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+
+    function setActive(id) {
+      for (const link of links) {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function scrollToSection(section) {
+      const top = section.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      // Scroll only the panel (not the page); smoothness comes from CSS scroll-behavior,
+      // which is disabled for users who prefer reduced motion.
+      panel.scrollTo({ top });
+      section.focus({ preventScroll: true });
+    }
+
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (!section) return;
+        event.preventDefault();
+        setActive(section.id);
+        scrollToSection(section);
+      });
+    }
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const target = event.snapTargetBlock?.closest('.drink-section');
+        if (target) setActive(target.id);
+      });
+    } else {
+      // Fallback: pick the visible section whose top is nearest the panel's top edge.
+      const observer = new IntersectionObserver(() => {
+        const panelTop = panel.getBoundingClientRect().top;
+        let closest;
+        let closestDistance = Infinity;
+        for (const section of sections) {
+          const { top, bottom } = section.getBoundingClientRect();
+          if (bottom <= panelTop + 1) continue;
+          const distance = Math.abs(top - panelTop);
+          if (distance < closestDistance) {
+            closest = section;
+            closestDistance = distance;
+          }
+        }
+        if (closest) setActive(closest.id);
+      }, { root: panel, threshold: [0, 0.25, 0.5, 0.75, 1] });
+
+      sections.forEach((section) => observer.observe(section));
+    }
+  </script>
+
