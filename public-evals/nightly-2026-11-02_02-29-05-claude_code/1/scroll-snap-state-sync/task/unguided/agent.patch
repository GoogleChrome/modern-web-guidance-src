+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var pendingTarget = null;
+      var ticking = false;
+
+      function linkFor(id) {
+        return links.find(function (link) { return link.getAttribute('href') === '#' + id; });
+      }
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          var active = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('is-active', active);
+          if (active) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Offset of a section's top edge within the panel's scrollable content
+      function offsetOf(section) {
+        return section.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      }
+
+      function currentSection() {
+        var atBottom = panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 2;
+        if (atBottom) return sections[sections.length - 1];
+        var current = sections[0];
+        var probe = panel.scrollTop + panel.clientHeight * 0.3;
+        sections.forEach(function (section) {
+          if (offsetOf(section) <= probe) current = section;
+        });
+        return current;
+      }
+
+      function update() {
+        ticking = false;
+        // While a TOC-initiated smooth scroll is in flight, keep the clicked link highlighted
+        if (pendingTarget) return;
+        setActive(currentSection().id);
+      }
+
+      panel.addEventListener('scroll', function () {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      }, { passive: true });
+
+      function finishPending() {
+        if (!pendingTarget) return;
+        pendingTarget = null;
+        update();
+      }
+
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', finishPending);
+      }
+
+      function scrollToSection(section) {
+        pendingTarget = section;
+        setActive(section.id);
+        panel.scrollTo({
+          top: offsetOf(section),
+          behavior: reduceMotion.matches ? 'auto' : 'smooth'
+        });
+        // Fallback for browsers without scrollend, or when no scroll was needed
+        clearTimeout(scrollToSection.timer);
+        scrollToSection.timer = setTimeout(finishPending, 1000);
+
+        var heading = section.querySelector('h3');
+        if (heading) heading.focus({ preventScroll: true });
+        if (history.replaceState) history.replaceState(null, '', '#' + section.id);
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var section = document.getElementById(link.getAttribute('href').slice(1));
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          scrollToSection(section);
+        });
+      });
+
+      // Honor a deep link like /#cold-brew on load
+      var initial = location.hash && document.getElementById(location.hash.slice(1));
+      if (initial && panel.contains(initial) && linkFor(initial.id)) {
+        panel.scrollTop = offsetOf(initial);
+        setActive(initial.id);
+      } else {
+        update();
+      }
+    })();
+  </script>
+
