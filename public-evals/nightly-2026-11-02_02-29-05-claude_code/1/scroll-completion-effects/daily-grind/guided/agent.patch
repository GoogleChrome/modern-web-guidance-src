+  <script>
+    const nav = document.querySelector('nav');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let currentScrollId = 0;
+
+    // Resolves once the scroll has finished. Uses the Promise returned by
+    // scroll methods where supported, otherwise falls back to scrollend
+    // (with an idle timeout for when no scrolling happens at all).
+    function scrollToAsync(options) {
+      const result = window.scrollTo(options);
+      if (result instanceof Promise) return result;
+
+      return new Promise((resolve) => {
+        let timeoutId;
+        const finish = () => {
+          clearTimeout(timeoutId);
+          window.removeEventListener('scrollend', finish);
+          window.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+        window.addEventListener('scrollend', finish, { once: true });
+        window.addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    async function navigateTo(target) {
+      const scrollId = ++currentScrollId;
+      document.querySelectorAll('.nav-target.arrived')
+        .forEach((el) => el.classList.remove('arrived'));
+
+      // window.scrollTo rather than scrollIntoView: Chrome resolves the
+      // scrollIntoView promise too early when the root scroller is scrolling.
+      const top = target.getBoundingClientRect().top + window.scrollY - nav.offsetHeight;
+      await scrollToAsync({ top, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+
+      // A newer navigation superseded this one
+      if (scrollId !== currentScrollId) return;
+
+      target.querySelector('h2')?.focus({ preventScroll: true });
+      void target.offsetWidth; // restart the animation if re-targeting the same section
+      target.classList.add('arrived');
+    }
+
+    document.querySelectorAll('nav a[href^="#"]').forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const target = document.querySelector(link.hash);
+        if (!target) return;
+        event.preventDefault();
+        history.pushState(null, '', link.hash);
+        navigateTo(target);
+      });
+    });
+
+    document.querySelectorAll('.nav-target').forEach((section) => {
+      section.addEventListener('animationend', (event) => {
+        if (event.target === section) section.classList.remove('arrived');
+      });
+    });
+  </script>
