+          var lastY = window.scrollY;
+          var stableFrames = 0;
+          var maxWait = setTimeout(finish, 2000);
+
+          function finish() {
+            if (done) return;
+            done = true;
+            clearTimeout(maxWait);
+            window.removeEventListener('scrollend', finish);
+            resolve();
+          }
+
+          if (supportsScrollEnd) {
+            window.addEventListener('scrollend', finish, { once: true });
+          }
+
+          (function check() {
+            if (done) return;
+            var y = window.scrollY;
+            stableFrames = y === lastY ? stableFrames + 1 : 0;
+            lastY = y;
+            // Without scrollend, rely on stability; with it, only use this to
+            // catch the case where no scroll occurs and scrollend never fires.
+            if (stableFrames >= (supportsScrollEnd ? 10 : 6)) {
