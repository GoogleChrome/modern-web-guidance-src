+  <script>
+    const beans = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Light roast · jasmine, lemon, bergamot', price: 18, roast: '#a1714f' },
+      { id: 'colombia', name: 'Colombia Huila', notes: 'Medium roast · caramel, red apple, cocoa', price: 16, roast: '#7b4a2d' },
+      { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Medium roast · milk chocolate, toffee, spice', price: 17, roast: '#6d3f25' },
+      { id: 'kenya', name: 'Kenya AA', notes: 'Light-medium roast · blackcurrant, grapefruit', price: 19, roast: '#8d5b3a' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Dark roast · cedar, dark chocolate, earth', price: 17, roast: '#3e2418' },
+      { id: 'house', name: 'Daily Grind House Blend', notes: 'Medium-dark roast · hazelnut, brown sugar', price: 15, roast: '#4e2c1c' },
+    ];
+
+    const catalog = document.getElementById('bean-catalog');
+    const selectedList = document.getElementById('selected-beans');
+    const emptyState = document.getElementById('bean-empty');
+    const summary = document.getElementById('bean-summary');
+    const selectionHeading = document.getElementById('selection-heading');
+    const selected = [];
+
+    function beanItem(bean, buttonLabel, buttonClass) {
+      const li = document.createElement('li');
+      li.className = 'bean';
+      li.dataset.id = bean.id;
+      li.innerHTML = `
+        <span class="bean-swatch" style="--roast: ${bean.roast}" aria-hidden="true"></span>
+        <span class="bean-info"><strong></strong><span></span></span>
+        <button type="button" class="${buttonClass}"></button>`;
+      li.querySelector('strong').textContent = `${bean.name} — $${bean.price}`;
+      li.querySelector('.bean-info span').textContent = bean.notes;
+      const button = li.querySelector('button');
+      button.textContent = buttonLabel;
+      button.setAttribute('aria-label', `${buttonLabel} ${bean.name}`);
+      return li;
+    }
+
+    function renderCatalog() {
+      catalog.replaceChildren(...beans.map((bean) => {
+        const li = beanItem(bean, 'Add', 'add-bean');
+        li.querySelector('button').disabled = selected.includes(bean.id);
+        return li;
+      }));
+    }
+
+    function renderSelection() {
+      selectedList.replaceChildren(...selected.map((id) => {
+        const li = beanItem(beans.find((bean) => bean.id === id), 'Remove', 'remove-bean');
+        // Each tracked element needs a unique name; the shared animation comes from view-transition-class
+        li.style.viewTransitionName = `bean-${id}`;
+        return li;
+      }));
+      emptyState.hidden = selected.length > 0;
+      const total = selected.reduce((sum, id) => sum + beans.find((bean) => bean.id === id).price, 0);
+      summary.textContent = selected.length
+        ? `${selected.length} bag${selected.length === 1 ? '' : 's'} selected · $${total}`
+        : '';
+    }
+
+    function updateBeans(change, focusAfter) {
+      const update = () => {
+        change();
+        renderCatalog();
+        renderSelection();
+        focusAfter?.();
+      };
+      if (!document.startViewTransition) {
+        update();
+        return;
+      }
+      document.startViewTransition(update);
+    }
+
+    catalog.addEventListener('click', (event) => {
+      const button = event.target.closest('.add-bean');
+      if (!button || button.disabled) return;
+      const id = button.closest('.bean').dataset.id;
+      updateBeans(
+        () => selected.push(id),
+        () => selectedList.querySelector(`[data-id="${id}"] button`).focus(),
+      );
+    });
+
+    selectedList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const id = button.closest('.bean').dataset.id;
+      const index = selected.indexOf(id);
+      updateBeans(
+        () => selected.splice(index, 1),
+        () => {
+          // Keep keyboard focus nearby once the removed item is gone
+          const next = selectedList.children[Math.min(index, selected.length - 1)];
+          (next?.querySelector('button') ?? selectionHeading).focus();
+        },
+      );
+    });
+
+    renderCatalog();
+    renderSelection();
+  </script>
+
 </body>
 
