+  <script>
+    (() => {
+      const beans = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Light roast · jasmine, lemon, honey', roast: '#a1887f' },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Medium roast · caramel, red apple', roast: '#795548' },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Medium roast · cocoa, toasted almond', roast: '#6d4c41' },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Light roast · blackcurrant, grapefruit', roast: '#8d6e63' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Dark roast · cedar, dark chocolate', roast: '#3e2723' },
+        { id: 'brazil', name: 'Brazil Cerrado', notes: 'Medium-dark roast · peanut, molasses', roast: '#5d4037' },
+      ];
+
+      const lists = {
+        available: document.getElementById('bean-available'),
+        selected: document.getElementById('bean-selected'),
+      };
+      const counts = {
+        available: document.getElementById('bean-available-count'),
+        selected: document.getElementById('bean-selected-count'),
+      };
+      const status = document.getElementById('bean-status');
+      const selected = new Set(['colombia']);
+      const items = new Map();
+
+      for (const bean of beans) {
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        // Each bean needs a unique name so it can be tracked between lists;
+        // the shared `bean` class (set in CSS) gives them one animation.
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.innerHTML = `
+          <span class="bean-swatch" style="--roast: ${bean.roast}" aria-hidden="true"></span>
+          <span class="bean-info">
+            <span class="bean-name"></span><br>
+            <span class="bean-notes"></span>
+          </span>
+          <button type="button" class="bean-toggle"></button>`;
+        li.querySelector('.bean-name').textContent = bean.name;
+        li.querySelector('.bean-notes').textContent = bean.notes;
+        li.querySelector('.bean-toggle').addEventListener('click', () => toggle(bean));
+        items.set(bean.id, li);
+      }
+
+      function render() {
+        // Re-append in canonical order so items keep a stable position in each list.
+        for (const bean of beans) {
+          const isSelected = selected.has(bean.id);
+          const li = items.get(bean.id);
+          const button = li.querySelector('.bean-toggle');
+          button.textContent = isSelected ? '−' : '+';
+          button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+          (isSelected ? lists.selected : lists.available).append(li);
+        }
+        counts.available.textContent = `(${beans.length - selected.size})`;
+        counts.selected.textContent = `(${selected.size})`;
+      }
+
+      function toggle(bean) {
+        const adding = !selected.has(bean.id);
+        const update = () => {
+          adding ? selected.add(bean.id) : selected.delete(bean.id);
+          render();
+          items.get(bean.id).querySelector('.bean-toggle').focus();
+          status.textContent = `${bean.name} ${adding ? 'added to' : 'removed from'} your selection.`;
+        };
+
+        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+        if (!document.startViewTransition || reduceMotion) {
+          update();
+          return;
+        }
+        document.startViewTransition(update);
+      }
+
+      render();
+    })();
+  </script>
