       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Drink Customization Checkboxes */
+    .customize {
+      border: 1px dashed var(--secondary);
+      border-radius: 8px;
+      padding: 12px 14px 14px;
+      margin-top: 15px;
+      text-align: left;
+    }
+
+    .customize legend {
+      padding: 0 6px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      padding: 8px 10px;
+      margin-top: 6px;
+      border: 1px solid transparent;
+      border-radius: 6px;
+      cursor: pointer;
+      transition: background-color 0.25s, border-color 0.25s;
+    }
+
+    .option:hover {
+      background: #f5efec;
+    }
+
+    /* The native input stays in the accessibility tree and keeps its full
+       click/keyboard behavior; it's simply laid transparently over the row. */
+    .option input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: inherit;
+      z-index: 1;
+    }
+
+    .option-box {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      border: 2px solid var(--primary);
+      border-radius: 6px;
+      background: white;
+      transition: background-color 0.25s, border-color 0.25s, transform 0.15s;
+    }
+
+    .option-box svg {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: white;
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .option-box .check {
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.25s ease-in;
+    }
+
+    .option-box .dash {
+      stroke-dasharray: 12;
+      stroke-dashoffset: 12;
+      transition: stroke-dashoffset 0.2s ease-in;
+    }
+
+    .option-icon {
+      flex: none;
+      width: 30px;
+      height: 30px;
+      padding: 6px;
+      border-radius: 50%;
+      background: var(--secondary);
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 1.8;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      transition: background-color 0.25s, stroke 0.25s, transform 0.3s;
+    }
+
+    .option-text {
+      flex: 1;
+      font-size: 0.9rem;
+    }
+
+    .option-price {
+      font-size: 0.8rem;
+      color: #8d6e63;
+    }
+
+    /* Pressed */
+    .option input:active + .option-box {
+      transform: scale(0.88);
+    }
+
+    /* Checked */
+    .option:has(input:checked) {
+      background: #fff6ea;
+      border-color: var(--accent);
+    }
+
+    .option input:checked + .option-box {
+      background: var(--primary);
+      border-color: var(--primary);
+      animation: box-pop 0.35s ease-out;
+    }
+
+    .option input:checked + .option-box .check {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.3s 0.08s ease-out;
+    }
+
+    .option input:checked ~ .option-icon {
+      background: var(--accent);
+      stroke: var(--text);
+      transform: rotate(-12deg) scale(1.08);
+    }
+
+    /* Indeterminate (set via script) */
+    .option input:indeterminate + .option-box {
+      background: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .option input:indeterminate + .option-box .dash {
+      stroke-dashoffset: 0;
+    }
+
+    /* Keyboard focus */
+    .option input:focus-visible + .option-box {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Disabled */
+    .option:has(input:disabled) {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+
+    .option:has(input:disabled):hover {
+      background: transparent;
+    }
+
+    @keyframes box-pop {
+      0% { transform: scale(0.8); }
+      60% { transform: scale(1.15); }
+      100% { transform: scale(1); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option *,
+      .option-box .check,
+      .option-box .dash {
+        animation: none !important;
+        transition: none !important;
+      }
+
+      .option input:checked ~ .option-icon {
+        transform: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep the custom box visible */
+    @media (forced-colors: active) {
+      .option-box {
+        border-color: CanvasText;
+      }
+
+      .option input:checked + .option-box,
+      .option input:indeterminate + .option-box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option-box svg {
+        stroke: HighlightText;
+      }
+
+      .option input:focus-visible + .option-box {
+        outline-color: Highlight;
+      }
+
+      .option-icon {
+        stroke: CanvasText;
+      }
+    }
   </style>
