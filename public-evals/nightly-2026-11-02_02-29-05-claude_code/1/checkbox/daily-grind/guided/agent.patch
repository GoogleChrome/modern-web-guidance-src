+    /* Drink Customization Checkboxes */
+    :root {
+      --icon-check: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg>");
+    }
+
+    .customize {
+      border: 0;
+      margin: 15px 0 0;
+      padding: 15px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+    }
+
+    .customize legend {
+      float: left;
+      width: 100%;
+      margin-bottom: 8px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .customize ul {
+      clear: both;
+      display: grid;
+      gap: 6px;
+      list-style: none;
+    }
+
+    .option {
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+      min-block-size: 44px;
+      padding: 6px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background-color 0.3s, border-color 0.3s;
+    }
+
+    .option:hover {
+      border-color: var(--primary);
+    }
+
+    .option:has(.checkbox:checked) {
+      background-color: #efebe9;
+      border-color: var(--primary);
+    }
+
+    .option-icon {
+      flex: none;
+      inline-size: 1.25em;
+      aspect-ratio: 1;
+      color: var(--primary);
+    }
+
+    .option-text {
+      flex: 1;
+    }
+
+    .option-price {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .checkbox {
+      --checkbox-size: 1.3em;
+      --checkbox-icon-size: 0.8em;
+
+      appearance: none;
+      flex: none;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 4px;
+      background-color: white;
+      color: var(--accent);
+      cursor: pointer;
+    }
+
+    .checkbox::before {
+      content: "";
+      inline-size: var(--checkbox-icon-size);
+      aspect-ratio: 1;
+      background-color: currentColor;
+      mask: var(--icon-check) no-repeat center / contain;
+      scale: 0;
+      rotate: -45deg;
+    }
+
+    .checkbox:checked {
+      background-color: var(--primary);
+    }
+
+    .checkbox:checked::before {
+      scale: 1;
+      rotate: 0deg;
+    }
+
+    .checkbox:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .checkbox:disabled,
+    .option:has(.checkbox:disabled) {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .checkbox {
+        transition: background-color 0.2s ease, scale 0.15s ease;
+      }
+
+      .checkbox:active {
+        scale: 0.85;
+      }
+
+      .checkbox::before {
+        transition: scale 0.15s ease-in, rotate 0.15s ease-in;
+      }
+
+      .checkbox:checked::before {
+        /* Springy overshoot when checking, quick fade-out when unchecking */
+        transition: scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), rotate 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+      }
+    }
+
+    @media (forced-colors: active) {
+      .checkbox::before {
+        background-color: CanvasText;
+      }
+    }
+
