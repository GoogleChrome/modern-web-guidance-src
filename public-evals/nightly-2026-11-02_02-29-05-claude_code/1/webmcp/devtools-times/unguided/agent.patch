diff --git a/src/pages/search.astro b/src/pages/search.astro
new file mode 100644
index 0000000..6463953
--- /dev/null
+++ b/src/pages/search.astro
@@ -0,0 +1,83 @@
+---
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+import { searchArticles } from '../utils/articleSearch';
+
+const baseUrl = import.meta.env.BASE_URL;
+const query = Astro.url.searchParams.get('q')?.trim() ?? '';
+const category = Astro.url.searchParams.get('category') ?? '';
+
+const articles = (await getCollection('articles')).map(article => ({
+    slug: article.id,
+    title: article.data.title,
+    summary: article.data.summary,
+    author: article.data.author,
+    category: article.data.category,
+    date: article.data.date.toISOString().slice(0, 10),
+}));
+const categories = [...new Set(articles.map(article => article.category.toLowerCase()))].sort();
+const hasSearched = Astro.url.searchParams.has('q');
+const results = hasSearched ? searchArticles(articles, { query, category }) : [];
+const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
+---
+
+<Layout title={query ? `Search: ${query} | The DevTools Times` : 'Search | The DevTools Times'}>
+    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+        <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Search</h1>
+
+        <form
+            role="search"
+            method="get"
+            action={`${baseUrl}search`}
+            class="flex flex-col sm:flex-row gap-3 mb-8"
+            toolname="search_articles"
+            tooldescription="Search The DevTools Times articles by keyword, optionally limited to one category. Returns matching articles with slug, title, summary, author, category, date and URL."
+            toolautosubmit
+            data-agent-handler="search"
+        >
+            <label for="search-query" class="sr-only">Search terms</label>
+            <input
+                id="search-query"
+                type="search"
+                name="q"
+                value={query}
+                placeholder="Search for articles..."
+                class="flex-grow p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
+                toolparamdescription="Keywords to look for in article titles, summaries, authors and categories. Every word must match."
+            />
+            <label for="search-category" class="sr-only">Category</label>
+            <select
+                id="search-category"
+                name="category"
+                class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400"
+                toolparamdescription="Only return articles from this category. Leave empty to search all categories."
+            >
+                <option value="">All categories</option>
+                {categories.map(c => <option value={c} selected={c === category}>{capitalize(c)}</option>)}
+            </select>
+            <button type="submit" class="bg-gray-800 text-white text-sm font-semibold py-2 px-4 rounded hover:bg-gray-700">
+                Search
+            </button>
+        </form>
+
+        {hasSearched && (
+            <p class="text-sm text-gray-500 mb-4">
+                {results.length} {results.length === 1 ? 'result' : 'results'}{query && <> for "<span class="font-semibold text-gray-700">{query}</span>"</>}{category && <> in {capitalize(category)}</>}
+            </p>
+        )}
+        {hasSearched && results.length === 0 && (
+            <p class="text-gray-500 text-center py-8">No results found.</p>
+        )}
+        <ul class="space-y-2">
+            {results.map(article => (
+                <li>
+                    <a href={`${baseUrl}articles/${article.slug}`} class="block hover:bg-gray-100 p-4 rounded-md transition-colors">
+                        <span class="text-xs text-amber-800 font-brand tracking-widest">{capitalize(article.category)}</span>
+                        <h2 class="font-bold text-lg text-gray-800">{article.title}</h2>
+                        <p class="text-sm text-gray-600">{article.summary}</p>
+                    </a>
+                </li>
+            ))}
+        </ul>
+    </div>
+</Layout>
