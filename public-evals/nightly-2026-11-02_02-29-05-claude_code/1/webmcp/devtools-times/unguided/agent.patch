+                        <h2 class="font-bold text-lg text-gray-800">{article.data.title}</h2>
+                        <p class="text-sm text-gray-600">{article.data.summary}</p>
+                    </a>
+                    <form method="post" action={`${baseUrl}api/reading-list.json`}>
+                        <input type="hidden" name="slug" value={article.id} />
+                        <input type="hidden" name="action" value="remove" />
+                        <input type="hidden" name="redirect" value={redirectTo} />
+                        <button type="submit" class="p-2 text-gray-500 hover:text-amber-400" aria-label={`Remove ${article.data.title} from reading list`}>
+                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
