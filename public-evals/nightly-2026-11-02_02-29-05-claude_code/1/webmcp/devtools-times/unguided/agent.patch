+---
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+
+const baseUrl = import.meta.env.BASE_URL;
+const articles = (await getCollection('articles')).sort((a, b) => a.data.title.localeCompare(b.data.title));
+const readingList: string[] = await Astro.session?.get('readingList') || [];
+const savedArticles = readingList
+    .map(slug => articles.find(article => article.id === slug))
+    .filter(article => article !== undefined);
+const redirectTo = `${baseUrl}reading-list`;
+---
+
+<Layout title="Reading List | The DevTools Times">
+    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+        <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Your Reading List</h1>
+
+        <form
+            method="post"
+            action={`${baseUrl}api/reading-list.json`}
+            class="flex flex-col sm:flex-row gap-3 mb-8 p-4 bg-gray-50 border border-gray-200"
+            toolname="update_reading_list"
+            tooldescription="Add an article to, or remove it from, the reader's reading list. Returns the updated reading list."
+            toolautosubmit
+            data-agent-handler="readingList"
+        >
+            <input type="hidden" name="redirect" value={redirectTo} />
+            <label for="reading-list-slug" class="sr-only">Article</label>
+            <select
+                id="reading-list-slug"
+                name="slug"
+                required
+                class="flex-grow p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400"
+                toolparamdescription="The article to add or remove."
+            >
+                <option value="">Choose an article...</option>
+                {articles.map(article => <option value={article.id}>{article.data.title}</option>)}
+            </select>
+            <label for="reading-list-action" class="sr-only">Action</label>
+            <select
+                id="reading-list-action"
+                name="action"
+                class="p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400"
+                toolparamdescription="Whether to add the article to the reading list or remove it."
+            >
+                <option value="add">Add</option>
+                <option value="remove">Remove</option>
+            </select>
+            <button type="submit" class="bg-gray-800 text-white text-sm font-semibold py-2 px-4 rounded hover:bg-gray-700">
+                Update
+            </button>
+        </form>
+
+        {savedArticles.length === 0 && (
+            <p class="text-gray-500 text-center py-8">Your reading list is empty.</p>
+        )}
+        <ul class="space-y-2">
+            {savedArticles.map(article => (
