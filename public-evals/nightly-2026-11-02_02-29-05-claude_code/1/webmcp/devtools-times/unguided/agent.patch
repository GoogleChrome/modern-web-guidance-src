+++ b/src/scripts/readingList.ts
@@ -0,0 +1,29 @@
+const endpoint = () => `${import.meta.env.BASE_URL}api/reading-list.json`;
+
+export const READING_LIST_CHANGED = 'reading-list-changed';
+
+export type ReadingListAction = 'add' | 'remove' | 'toggle';
+
+export async function fetchReadingList(): Promise<string[]> {
+  const response = await fetch(endpoint());
+  const data = await response.json();
+  return data.readingList;
+}
+
+// Updates the session reading list and lets every mounted component
+// (bookmark buttons, flyout) know, no matter who triggered the change.
+export async function updateReadingList(slug: string, action: ReadingListAction = 'toggle'): Promise<string[]> {
+  const response = await fetch(endpoint(), {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify({ slug, action }),
+  });
+  const data = await response.json();
+  if (!response.ok) {
+    throw new Error(data.error || `Reading list update failed (${response.status})`);
+  }
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..e4367ca
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,301 @@
+// WebMCP integration for The DevTools Times.
+//
+// Declarative tools: forms annotated with `toolname` (search page, reading list
+// page, article bookmark) are exposed by the browser automatically. When an agent
+// submits one of the forms tagged with `data-agent-handler`, we answer with a
+// structured result via `SubmitEvent.respondWith()` instead of a full navigation.
+//
+// Imperative tools: client-side article utilities registered through
+// `navigator.modelContext.registerTool()`.
+import { navigate } from 'astro:transitions/client';
+import { searchArticles, type ArticleSummary } from '../utils/articleSearch';
+import { fetchReadingList, updateReadingList, type ReadingListAction } from './readingList';
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+let articlesPromise: Promise<ArticleSummary[]> | undefined;
+
+function getArticles(): Promise<ArticleSummary[]> {
+  articlesPromise ??= fetch(`${BASE_URL}api/articles.json`)
+    .then(response => {
+      if (!response.ok) throw new Error(`Failed to load articles (${response.status})`);
+      return response.json();
+    })
+    .catch(error => {
+      articlesPromise = undefined;
+      throw error;
+    });
+  return articlesPromise;
+}
+
+const articleUrl = (slug: string) => new URL(`${BASE_URL}articles/${slug}`, location.origin).toString();
+
+const toResult = (article: ArticleSummary) => ({
+  slug: article.slug,
+  title: article.title,
+  summary: article.summary,
+  author: article.author,
+  category: article.category,
+  date: article.date,
+  readingTimeMinutes: article.readingTime,
+  url: articleUrl(article.slug),
+});
+
+async function describeReadingList(readingList: string[]) {
+  const articles = await getArticles();
+  return readingList.map(slug => {
+    const article = articles.find(a => a.slug === slug);
+    return article ? toResult(article) : { slug, url: articleUrl(slug) };
+  });
+}
+
+async function requireArticle(slug: string) {
+  const article = (await getArticles()).find(a => a.slug === slug);
+  if (!article) throw new Error(`Unknown article slug "${slug}". Use list_articles to find valid slugs.`);
+  return article;
+}
+
+function currentArticleSlug(): string | undefined {
+  return document.querySelector<HTMLElement>('[data-article-slug]')?.dataset.articleSlug;
+}
+
+// Reads the full article from a rendered article page (the current one, or a fetched one).
+function readArticleFromDocument(doc: Document) {
+  const root = doc.querySelector<HTMLElement>('[data-article-slug]');
+  const body = doc.querySelector<HTMLElement>('[data-article-body]');
+  if (!root || !body) return undefined;
+
+  const text = (body.textContent ?? '').replace(/\s+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
+  const wordCount = text.split(/\s+/).filter(Boolean).length;
+  const outline = [...body.querySelectorAll('h2, h3, h4')].map(heading => ({
+    level: Number(heading.tagName[1]),
+    text: heading.textContent?.trim() ?? '',
+  }));
+
+  return {
+    slug: root.dataset.articleSlug,
+    title: root.dataset.articleTitle,
+    summary: root.dataset.articleSummary,
+    author: root.dataset.articleAuthor,
+    category: root.dataset.articleCategory,
+    date: root.dataset.articleDate,
+    url: articleUrl(root.dataset.articleSlug!),
+    wordCount,
+    estimatedReadingTimeMinutes: Math.max(1, Math.round(wordCount / 230)),
+    outline,
+    text,
+  };
+}
+
+async function getFullArticle(slug: string) {
+  if (slug === currentArticleSlug()) return readArticleFromDocument(document);
+  await requireArticle(slug);
+  const response = await fetch(articleUrl(slug));
+  if (!response.ok) throw new Error(`Failed to load article "${slug}" (${response.status})`);
+  const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
+  return readArticleFromDocument(doc);
+}
+
+const textResult = (data: unknown): WebMCPToolResult => ({
+  content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+});
+
+function registerTool(tool: WebMCPTool, signal?: AbortSignal) {
+  const modelContext = navigator.modelContext;
+  if (!modelContext) return;
+  try {
+    modelContext.registerTool(tool, { signal });
+  } catch (error) {
+    console.warn(`[WebMCP] Could not register tool "${tool.name}"`, error);
+    return;
+  }
+  // Older implementations ignore the signal and expect an explicit unregister.
+  signal?.addEventListener('abort', () => {
+    try {
+      modelContext.unregisterTool?.(tool.name);
+    } catch {
+      // Already removed via the abort signal.
+    }
+  }, { once: true });
+}
+
+// --- Imperative tools available on every page -------------------------------
+
+const globalTools: WebMCPTool[] = [
+  {
+    name: 'list_articles',
+    description: 'List or search articles published in The DevTools Times. Returns slugs, titles, summaries, authors, categories and dates, newest/most relevant first. Omit all arguments to list everything.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Optional keywords matched against title, summary, author and category. All words must match.' },
+        category: { type: 'string', description: 'Optional category to filter by, e.g. "sports", "science", "lifestyle".' },
+        limit: { type: 'integer', minimum: 1, maximum: 50, description: 'Maximum number of articles to return.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ query, category, limit } = {}) {
+      const articles = await getArticles();
+      const results = searchArticles(articles, { query, category, limit });
+      const categories = [...new Set(articles.map(a => a.category?.toLowerCase()).filter(Boolean))].sort();
+      return textResult({ total: results.length, categories, articles: results.map(toResult) });
+    },
+  },
+  {
+    name: 'get_article',
+    description: 'Get the full text of an article together with its metadata, section outline, word count and estimated reading time. Defaults to the article currently open in the browser.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Article slug (from list_articles). Omit to read the article currently on screen.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ slug } = {}) {
+      const target = slug || currentArticleSlug();
+      if (!target) throw new Error('No article is open. Pass a slug (use list_articles to find one).');
+      const article = await getFullArticle(target);
+      if (!article) throw new Error(`Could not read article "${target}".`);
+      return textResult(article);
+    },
+  },
+  {
+    name: 'open_article',
+    description: 'Navigate the browser to an article so the user can read it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Article slug (from list_articles).' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }) {
+      const article = await requireArticle(slug);
+      navigate(articleUrl(article.slug));
+      return textResult(`Opened "${article.title}".`);
+    },
+  },
+  {
+    name: 'get_reading_list',
+    description: "Get the articles saved in the reader's reading list for this browser session.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const articles = await describeReadingList(await fetchReadingList());
+      return textResult({ total: articles.length, articles });
+    },
+  },
+  {
+    name: 'set_reading_list_status',
+    description: "Save an article to, or remove it from, the reader's reading list.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Article slug (from list_articles).' },
+        saved: { type: 'boolean', description: 'true to save the article, false to remove it.' },
+      },
+      required: ['slug', 'saved'],
+    },
+    async execute({ slug, saved }) {
+      const article = await requireArticle(slug);
+      const readingList = await updateReadingList(article.slug, saved ? 'add' : 'remove');
+      return textResult({
+        message: `"${article.title}" ${saved ? 'saved to' : 'removed from'} the reading list.`,
+        readingList: await describeReadingList(readingList),
+      });
+    },
+  },
+];
+
+// --- Imperative tools that only make sense on an article page ---------------
+
+const articlePageTools: WebMCPTool[] = [
+  {
+    name: 'scroll_to_article_section',
+    description: 'Scroll the open article to a section heading. Use get_article to see the available headings.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        heading: { type: 'string', description: 'Text (or part of the text) of the section heading to scroll to.' },
+      },
+      required: ['heading'],
+    },
+    async execute({ heading }) {
+      const wanted = String(heading).trim().toLowerCase();
+      const headings = [...document.querySelectorAll<HTMLElement>('[data-article-body] :is(h2, h3, h4)')];
+      const match = headings.find(h => h.textContent?.trim().toLowerCase() === wanted)
+        ?? headings.find(h => h.textContent?.toLowerCase().includes(wanted));
+      if (!match) {
+        throw new Error(`No section matching "${heading}". Available sections: ${headings.map(h => h.textContent?.trim()).join(', ') || 'none'}.`);
+      }
+      match.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      return textResult(`Scrolled to "${match.textContent?.trim()}".`);
+    },
+  },
+];
+
+// --- Declarative form handlers ----------------------------------------------
+
+const formHandlers: Record<string, (form: HTMLFormElement) => Promise<unknown>> = {
+  async search(form) {
+    const formData = new FormData(form);
+    const query = formData.get('q')?.toString().trim() ?? '';
+    const category = formData.get('category')?.toString() ?? '';
+    const results = searchArticles(await getArticles(), { query, category });
+
+    // Show the same results to the user once the agent has its answer.
+    const url = new URL(form.action, location.href);
+    url.search = new URLSearchParams({ q: query, ...(category && { category }) }).toString();
+    setTimeout(() => navigate(url.toString()));
+
+    return { query, category: category || 'all', total: results.length, articles: results.map(toResult) };
+  },
+  async readingList(form) {
+    const formData = new FormData(form);
+    const slug = formData.get('slug')?.toString() ?? '';
+    const action = (formData.get('action')?.toString() || 'toggle') as ReadingListAction;
+    const article = await requireArticle(slug);
+    const readingList = await updateReadingList(article.slug, action);
+
+    // Refresh the server-rendered list on the page.
+    setTimeout(() => navigate(location.href, { history: 'replace' }));
+
+    return {
+      message: `"${article.title}" is ${readingList.includes(article.slug) ? 'now' : 'no longer'} in the reading list.`,
+      readingList: await describeReadingList(readingList),
+    };
+  },
+};
+
+function handleAgentSubmit(event: Event) {
+  const submitEvent = event as AgentSubmitEvent;
+  const form = submitEvent.target;
+  if (!submitEvent.agentInvoked || !(form instanceof HTMLFormElement)) return;
+  const handler = formHandlers[form.dataset.agentHandler ?? ''];
+  if (!handler) return;
+
+  // Runs in the capture phase so the ClientRouter (which skips prevented events)
+  // doesn't turn the submission into a page navigation first.
+  submitEvent.preventDefault();
+  submitEvent.respondWith?.(handler(form).then(result => JSON.stringify(result, null, 2)));
+}
+
+// --- Setup ------------------------------------------------------------------
+
+let pageToolsController: AbortController | undefined;
+
+function registerPageTools() {
+  pageToolsController?.abort();
+  pageToolsController = new AbortController();
+  if (currentArticleSlug()) {
+    articlePageTools.forEach(tool => registerTool(tool, pageToolsController!.signal));
+  }
+}
+
+if (!window.__devtoolsTimesWebMCP) {
+  window.__devtoolsTimesWebMCP = true;
+  document.addEventListener('submit', handleAgentSubmit, true);
+  globalTools.forEach(tool => registerTool(tool));
+  // Fires on the initial load and after every ClientRouter navigation.
+  document.addEventListener('astro:page-load', registerPageTools);
+}
