diff --git a/src/utils/articleSearch.ts b/src/utils/articleSearch.ts
new file mode 100644
index 0000000..922eb07
--- /dev/null
+++ b/src/utils/articleSearch.ts
@@ -0,0 +1,42 @@
+export interface ArticleSummary {
+    slug: string;
+    title: string;
+    summary: string;
+    image?: string;
+    author?: string;
+    category?: string;
+    date?: string;
+    readingTime?: number;
+}
+
+export interface SearchOptions {
+    query?: string;
+    category?: string;
+    limit?: number;
+}
+
+// Shared by the server-rendered /search page and the client-side WebMCP tools,
+// so agents and humans get the same results for the same query.
+export function searchArticles<T extends ArticleSummary>(articles: T[], { query = '', category = '', limit }: SearchOptions = {}): T[] {
+    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+    const wantedCategory = category.trim().toLowerCase();
+
+    const scored = articles
+        .filter(article => !wantedCategory || article.category?.toLowerCase() === wantedCategory)
+        .map(article => {
+            const title = article.title.toLowerCase();
+            const haystack = [article.summary, article.author, article.category].join(' ').toLowerCase();
+            let score = 0;
+            for (const term of terms) {
+                if (title.includes(term)) score += 3;
+                else if (haystack.includes(term)) score += 1;
+                else return { article, score: -1 };
+            }
+            return { article, score };
+        })
+        .filter(({ score }) => score >= 0)
+        .sort((a, b) => b.score - a.score || (b.article.date ?? '').localeCompare(a.article.date ?? ''));
+
+    const results = scored.map(({ article }) => article);
+    return limit ? results.slice(0, limit) : results;
+}
