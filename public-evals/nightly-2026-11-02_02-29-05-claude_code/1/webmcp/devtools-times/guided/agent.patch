diff --git a/src/utils/articles.ts b/src/utils/articles.ts
new file mode 100644
index 0000000..0c072fc
--- /dev/null
+++ b/src/utils/articles.ts
@@ -0,0 +1,30 @@
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function fetchArticles(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Failed to load articles (HTTP ${response.status}).`);
+  return response.json();
+}
+
+export function searchArticles<T extends ArticleSummary>(articles: T[], term: string): T[] {
+  const needle = term.trim().toLowerCase();
+  if (!needle) return [];
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(needle) ||
+    article.summary.toLowerCase().includes(needle)
+  );
+}
+
+export function articleUrl(slug: string): string {
+  return new URL(`${import.meta.env.BASE_URL}articles/${slug}`, window.location.origin).href;
+}
+
+// Shape returned to AI agents: no image paths, absolute URLs.
+export function toAgentArticle({ slug, title, summary }: ArticleSummary) {
+  return { slug, title, summary, url: articleUrl(slug) };
+}
diff --git a/src/utils/readingList.ts b/src/utils/readingList.ts
new file mode 100644
index 0000000..adb123e
--- /dev/null
+++ b/src/utils/readingList.ts
@@ -0,0 +1,28 @@
+const READING_LIST_URL = `${import.meta.env.BASE_URL}api/reading-list.json`;
+
+// Fired on window whenever the reading list changes, so every island
+// showing reading-list state (bookmark icons, flyout) stays in sync.
+export const READING_LIST_CHANGE_EVENT = 'readinglistchange';
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(READING_LIST_URL, { signal });
+  if (!response.ok) throw new Error(`Failed to load reading list (HTTP ${response.status}).`);
+  const data = await response.json();
+  return data.readingList;
+}
+
+// The API toggles: it adds the slug if missing and removes it if present.
+export async function toggleReadingListItem(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(READING_LIST_URL, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Failed to update reading list (HTTP ${response.status}).`);
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent<string[]>(READING_LIST_CHANGE_EVENT, { detail: data.readingList }));
+  return data.readingList;
+}
