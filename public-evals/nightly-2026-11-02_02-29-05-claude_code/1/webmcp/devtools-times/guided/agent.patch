diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..058baf5
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,93 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { fetchArticles, toAgentArticle, articleUrl } from '../utils/articles';
+import { fetchReadingList, toggleReadingListItem } from '../utils/readingList';
+
+interface CurrentArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+}
+
+interface Props {
+  // The article being read, when on an article page.
+  article?: CurrentArticle;
+}
+
+const READING_LIST_ACTIONS = ['add', 'remove'];
+const WORDS_PER_MINUTE = 230;
+
+// Registers WebMCP tools that let AI agents work with articles and the
+// reader's reading list. Renders nothing.
+export default function ArticleTools({ article }: Props) {
+  useWebMCP({
+    name: 'list_articles',
+    description: 'Lists every article published in The DevTools Times. Use to browse the catalog or look up an article slug.',
+    async execute(_input, { signal }) {
+      const articles = await fetchArticles(signal);
+      return articles.map(toAgentArticle);
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: "Returns the articles saved to the reader's reading list.",
+    async execute(_input, { signal }) {
+      const [articles, readingList] = await Promise.all([fetchArticles(signal), fetchReadingList(signal)]);
+      return articles.filter(item => readingList.includes(item.slug)).map(toAgentArticle);
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ slug?: unknown; action?: unknown }>({
+    name: 'update_reading_list',
+    description: "Saves an article to the reader's reading list or removes it from the list.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Slug of the article, as returned by list_articles or search_articles.' },
+        action: { type: 'string', enum: READING_LIST_ACTIONS, description: 'Whether to save the article or remove it.' },
+      },
+      required: ['slug', 'action'],
+    },
+    async execute({ slug, action }, { signal }) {
+      if (typeof slug !== 'string' || typeof action !== 'string' || !READING_LIST_ACTIONS.includes(action)) {
+        throw new Error('Pass an article slug and an action of "add" or "remove".');
+      }
+      const [articles, readingList] = await Promise.all([fetchArticles(signal), fetchReadingList(signal)]);
+      if (!articles.some(item => item.slug === slug)) {
+        throw new Error(`No article with slug "${slug}". Use list_articles to find valid slugs.`);
+      }
+      // The API toggles, so only call it when the state needs to change.
+      const shouldBeSaved = action === 'add';
+      const updated = readingList.includes(slug) === shouldBeSaved
+        ? readingList
+        : await toggleReadingListItem(slug, signal);
+      return { slug, saved: updated.includes(slug), readingListSize: updated.length };
+    },
+  });
+
+  useWebMCP({
+    name: 'get_current_article',
+    description: 'Returns the article the reader is currently viewing, including its full text and estimated reading time. Use to summarize or answer questions about it.',
+    enabled: Boolean(article),
+    execute() {
+      if (!article) throw new Error('The reader is not viewing an article.');
+      const text = document.querySelector<HTMLElement>('[data-article-body]')?.innerText.trim() ?? '';
+      const wordCount = text ? text.split(/\s+/).length : 0;
+      return {
+        ...article,
+        url: articleUrl(article.slug),
+        wordCount,
+        readingTimeMinutes: Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        text,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
