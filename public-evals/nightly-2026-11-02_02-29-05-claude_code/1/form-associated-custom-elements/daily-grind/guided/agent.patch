+  <script type="module" src="star-rating.js"></script>
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const fields = document.getElementById('feedback-fields');
+    const status = document.getElementById('feedback-status');
+    const summary = document.getElementById('feedback-summary');
+    const taste = document.getElementById('taste');
+    const tasteError = document.getElementById('taste-error');
+
+    await customElements.whenDefined('star-rating');
+
+    const showTasteError = () => {
+      tasteError.textContent = form.hasAttribute('data-submitted') ? taste.validationMessage : '';
+    };
+
+    // Only flag errors once the user has tried to submit.
+    form.addEventListener('invalid', () => {
+      form.setAttribute('data-submitted', '');
+      showTasteError();
+    }, true);
+    taste.addEventListener('change', showTasteError);
+
+    form.addEventListener('reset', () => {
+      form.removeAttribute('data-submitted');
+      tasteError.textContent = '';
+    });
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const labels = { drink: 'Drink', taste: 'Taste', service: 'Service', comments: 'Comments' };
+
+      summary.replaceChildren(...[...data].filter(([, value]) => value !== '').map(([key, value]) => {
+        const item = document.createElement('li');
+        const shown = form.elements[key].localName === 'star-rating' ? `${value} / 5 stars`
+          : form.elements[key].localName === 'select' ? form.elements[key].selectedOptions[0].text
+          : value;
+        item.textContent = `${labels[key] ?? key}: ${shown}`;
+        return item;
+      }));
+
+      // Disabling the fieldset disables every control in it, star ratings included.
+      fields.disabled = true;
+      status.hidden = false;
+      document.getElementById('feedback-again').focus();
+    });
+
+    document.getElementById('feedback-again').addEventListener('click', () => {
+      form.reset();
+      fields.disabled = false;
+      status.hidden = true;
+      document.getElementById('drink').focus();
+    });
+  </script>
+
