     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product card spotlight reveal */
+    @property --mouse-x {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --mouse-y {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      overflow: hidden;
+      padding-top: 44px;
+      /* Only the spotlight size animates; position updates are instant */
+      transition: --inner-size 0.35s ease-out, --outer-size 0.35s ease-out;
+    }
+
+    .product-card:hover,
+    .product-card:focus-within {
+      --inner-size: 90px;
+      --outer-size: 130px;
+    }
+
+    .product-card > :not(.spotlight-overlay) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      pointer-events: none;
+      display: flex;
+      justify-content: space-between;
+      align-items: flex-start;
+      gap: 12px;
+      padding: 12px 16px;
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      color: var(--primary);
+      background: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          rgba(255, 171, 64, 0.35), rgba(215, 204, 200, 0.45));
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
