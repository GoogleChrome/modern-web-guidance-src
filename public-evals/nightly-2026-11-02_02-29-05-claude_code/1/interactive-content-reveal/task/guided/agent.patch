+    /* Spotlight reveal on product cards */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
