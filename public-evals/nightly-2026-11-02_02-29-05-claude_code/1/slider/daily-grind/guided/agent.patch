+  <script>
+    const strengthSlider = document.querySelector('#brew-strength');
+    const strengthOutput = document.querySelector('#brew-strength-output');
+    const strengthNote = document.querySelector('#brew-strength-note');
+    const strengthLevels = [
+      { label: 'Mild', note: 'Try a Maple Oat Latte with an extra splash of oat milk.' },
+      { label: 'Smooth', note: 'Our Cold Brew is mellow and easygoing.' },
+      { label: 'Balanced', note: 'Our Maple Oat Latte hits the sweet spot.' },
+      { label: 'Bold', note: 'A double shot of Dark Roast Espresso will do the trick.' },
+      { label: 'Intense', note: 'Go all in: Dark Roast Espresso, triple shot.' },
+    ];
+
+    function syncStrength() {
+      const value = Number(strengthSlider.value);
+      const level = strengthLevels[value - 1];
+      strengthSlider.style.setProperty('--attr-min', strengthSlider.min || 0);
+      strengthSlider.style.setProperty('--attr-max', strengthSlider.max || 100);
+      strengthSlider.style.setProperty('--control-value', value);
+      strengthSlider.setAttribute('aria-valuetext', `${value} of ${strengthSlider.max}, ${level.label}`);
+      strengthOutput.textContent = level.label;
+      strengthNote.textContent = level.note;
+    }
+
+    syncStrength();
+    strengthSlider.addEventListener('input', syncStrength);
+  </script>
+
 </body>
 
