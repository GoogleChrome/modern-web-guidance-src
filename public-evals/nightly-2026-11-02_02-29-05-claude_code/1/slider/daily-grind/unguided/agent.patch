+  <script>
+    (function () {
+      var slider = document.getElementById('brew-strength');
+      var output = document.getElementById('brew-strength-output');
+      var description = document.getElementById('brew-strength-description');
+      var levels = {
+        1: ['Extra Mild', 'Light and delicate with bright, fruity notes.'],
+        2: ['Mild', 'Gentle body with a hint of sweetness.'],
+        3: ['Medium', 'Balanced and smooth — our house favorite.'],
+        4: ['Strong', 'Rich and full-bodied with deep cocoa tones.'],
+        5: ['Extra Bold', 'Intense, smokey, and built for early mornings.']
+      };
+
+      function update() {
+        var min = Number(slider.min);
+        var max = Number(slider.max);
+        var value = Number(slider.value);
+        var level = levels[value];
+        slider.style.setProperty('--fill', (value - min) / (max - min));
+        slider.setAttribute('aria-valuetext', level[0]);
+        output.textContent = level[0];
+        description.textContent = level[1];
+      }
+
+      slider.addEventListener('input', update);
+      update();
+    })();
+  </script>
