+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var origins = scroller.querySelectorAll('.origin');
+      var isScrolling = false;
+      var endTimer = null;
+      var supportsScrollEnd = 'onscrollend' in window;
+
+      function mostVisibleOrigin() {
+        var view = scroller.getBoundingClientRect();
+        var best = null;
+        var bestVisible = -1;
+        for (var i = 0; i < origins.length; i++) {
+          var r = origins[i].getBoundingClientRect();
+          var visible = Math.min(r.bottom, view.bottom) - Math.max(r.top, view.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = origins[i];
+          }
+        }
+        return best ? best.dataset.origin : 'None';
+      }
+
+      function onScrollEnd() {
+        isScrolling = false;
+        endTimer = null;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Kept minimal: only touches the DOM once per scroll gesture, no layout reads.
+      scroller.addEventListener('scroll', function () {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!supportsScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(onScrollEnd, 150);
+        }
+      }, { passive: true });
+
+      if (supportsScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
