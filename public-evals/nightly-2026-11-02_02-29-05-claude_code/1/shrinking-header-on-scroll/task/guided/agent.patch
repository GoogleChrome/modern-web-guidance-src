+  <script>
+    // Fallback for browsers without scroll-driven animations: mirror the
+    // native effect by exposing scroll progress as a CSS custom property.
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsScrollTimeline) return;
+
+      var nav = document.querySelector('nav');
+      var root = document.documentElement;
+      var distance = parseFloat(getComputedStyle(root).getPropertyValue('--nav-shrink-distance')) || 32;
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var progress = Math.min(1, Math.max(0, window.pageYOffset / distance));
+        nav.style.setProperty('--nav-progress', progress);
+      }
+
+      window.addEventListener('scroll', function () {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }, { passive: true });
+
+      update();
+    })();
+  </script>
+
 </body>
 
