+  <script>
+    /* Fallback for browsers without CSS scroll-driven animations: interpolate
+       the same values from the scroll position in JS (ES5, no custom
+       properties, so it works in older browsers too). */
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll()');
+      if (supportsScrollTimeline) return;
+
+      var nav = document.getElementById('site-nav');
+      var logo = nav.querySelector('.logo');
+      var RANGE = 150; // px of scroll over which the nav shrinks
+      var ticking = false;
+
+      function lerp(from, to, p) {
+        return from + (to - from) * p;
+      }
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var p = Math.min(Math.max(y / RANGE, 0), 1);
+        var pad = lerp(1, 0.4, p) + 'rem';
+        nav.style.paddingTop = pad;
+        nav.style.paddingBottom = pad;
+        nav.style.boxShadow = '0 ' + lerp(0, 2, p) + 'px ' + lerp(0, 8, p) +
+          'px rgba(0, 0, 0, ' + lerp(0, 0.3, p) + ')';
+        logo.style.fontSize = lerp(1.5, 1.15, p) + 'rem';
+      }
+
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
+      }
+
+      window.addEventListener('scroll', onScroll, false);
+      window.addEventListener('resize', onScroll, false);
+      update();
+    })();
+  </script>
+
 </body>
 
