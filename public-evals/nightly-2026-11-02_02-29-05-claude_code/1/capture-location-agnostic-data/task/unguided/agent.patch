+  <script>
+    // Both values are stored as plain wall-clock strings ("HH:MM" and "YYYY-MM-DD")
+    // with no time zone attached, so they read back exactly as selected no matter
+    // where the user travels. They are never converted to timestamps or parsed with
+    // `new Date(string)`, which would treat a date-only string as UTC midnight.
+    (function () {
+      var STORAGE_KEYS = { time: 'dailyGrind.pickupTime', date: 'dailyGrind.anniversaryDate' };
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('anniversary-date');
+      var timeDisplay = document.getElementById('pickup-time-display');
+      var dateDisplay = document.getElementById('anniversary-date-display');
+
+      function load(key) {
+        try { return localStorage.getItem(key) || ''; } catch (e) { return ''; }
+      }
+
+      function save(key, value) {
+        try {
+          if (value) localStorage.setItem(key, value); else localStorage.removeItem(key);
+        } catch (e) { /* storage unavailable; keep in-page value only */ }
+      }
+
+      function formatTime(value) {
+        var m = TIME_RE.exec(value);
+        if (!m) return '';
+        var h = Number(m[1]);
+        return 'Reminder every day at ' + (h % 12 || 12) + ':' + m[2] + (h < 12 ? ' AM' : ' PM') +
+          ' local time, wherever you are.';
+      }
+
+      function formatDate(value) {
+        var m = DATE_RE.exec(value);
+        if (!m) return '';
+        var month = Number(m[2]), day = Number(m[3]);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return '';
+        return 'Celebrating every ' + MONTHS[month - 1] + ' ' + day + ' (since ' + m[1] + ').';
+      }
+
+      function render() {
+        timeDisplay.textContent = formatTime(timeInput.value);
+        dateDisplay.textContent = formatDate(dateInput.value);
+      }
+
+      var savedTime = load(STORAGE_KEYS.time);
+      var savedDate = load(STORAGE_KEYS.date);
+      if (TIME_RE.test(savedTime)) timeInput.value = savedTime;
+      if (DATE_RE.test(savedDate)) dateInput.value = savedDate;
+      render();
+
+      timeInput.addEventListener('change', function () {
+        save(STORAGE_KEYS.time, TIME_RE.test(timeInput.value) ? timeInput.value : '');
+        render();
+      });
+      dateInput.addEventListener('change', function () {
+        save(STORAGE_KEYS.date, DATE_RE.test(dateInput.value) ? dateInput.value : '');
+        render();
+      });
+    })();
+  </script>
+
 </body>
 
