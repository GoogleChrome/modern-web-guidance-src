+  <script>
+    // Coupon: reveal once via the sidebar button or find-in-page; never re-hidden.
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    function markCouponRevealed() {
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.disabled = true;
+      couponButton.textContent = 'Coupon Revealed';
+    }
+
+    couponButton.addEventListener('click', () => {
+      couponPanel.removeAttribute('hidden');
+      markCouponRevealed();
+      couponPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    });
+
+    // Browser removes hidden="until-found" itself on a find-in-page match.
+    couponPanel.addEventListener('beforematch', markCouponRevealed);
+
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      // No hidden="until-found" support: show the coupon so it stays searchable.
+      couponPanel.removeAttribute('hidden');
+      markCouponRevealed();
+    }
+
+    // Tabs: keep one tab open by ignoring clicks on the already-open tab.
+    document.querySelectorAll('.wholesale-tab summary').forEach((summary) => {
+      summary.addEventListener('click', (e) => {
+        if (summary.parentElement.open) e.preventDefault();
+      });
+    });
+  </script>
+
