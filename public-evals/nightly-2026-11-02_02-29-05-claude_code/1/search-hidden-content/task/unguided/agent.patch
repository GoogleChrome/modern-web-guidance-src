+  <script>
+    (function () {
+      var panel = document.getElementById('coupon-panel');
+      var button = document.querySelector('.coupon-btn');
+
+      // One-way: once revealed (by click or find-in-page), the panel stays visible.
+      function markRevealed() {
+        button.disabled = true;
+        button.textContent = 'Coupon Revealed';
+        button.setAttribute('aria-expanded', 'true');
+      }
+
+      button.addEventListener('click', function () {
+        panel.hidden = false;
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      });
+
+      // Fired when the browser's find-in-page reveals the hidden="until-found" panel.
+      panel.addEventListener('beforematch', markRevealed);
+    })();
+  </script>
