+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+    }
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@1");
+    }
+
+    // Anchor positioning fallback: place each hovercard below its link,
+    // flipping above / to the left when it would overflow the viewport.
+    if (!CSS.supports("position-area", "block-end span-inline-end")) {
+      for (const card of document.querySelectorAll(".hovercard")) {
+        const trigger = document.querySelector(`[interestfor="${card.id}"]`);
+        card.addEventListener("toggle", (event) => {
+          if (event.newState !== "open") return;
+          const gap = 8;
+          const anchor = trigger.getBoundingClientRect();
+          const { width, height } = card.getBoundingClientRect();
+          let top = anchor.bottom + gap;
+          if (top + height > innerHeight && anchor.top - gap - height >= 0) {
+            top = anchor.top - gap - height;
+          }
+          let left = anchor.left;
+          if (left + width > innerWidth) left = Math.max(gap, anchor.right - width);
+          Object.assign(card.style, { inset: "auto", margin: "0", top: `${top}px`, left: `${left}px` });
+        });
+      }
+    }
+  </script>
+
