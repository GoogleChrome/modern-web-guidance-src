+  <script>
+    (function () {
+      const OPEN_DELAY = 300;
+      const CLOSE_DELAY = 200;
+      const GAP = 10;
+      const MARGIN = 8;
+      let active = null;
+
+      function position(trigger, card) {
+        const t = trigger.getBoundingClientRect();
+        const w = card.offsetWidth;
+        const h = card.offsetHeight;
+        const placeTop = window.innerHeight - t.bottom < h + GAP + MARGIN && t.top > h + GAP + MARGIN;
+        const center = t.left + t.width / 2;
+        const left = Math.min(Math.max(center - w / 2, MARGIN), window.innerWidth - w - MARGIN);
+        const top = placeTop ? t.top - h - GAP : t.bottom + GAP;
+
+        card.dataset.placement = placeTop ? 'top' : 'bottom';
+        card.style.left = left + 'px';
+        card.style.top = top + 'px';
+        const arrow = card.querySelector('.hovercard-arrow');
+        arrow.style.left = Math.min(Math.max(center - left - 6, 14), w - 26) + 'px';
+      }
+
+      function reposition() {
+        if (active) position(active.trigger, active.card);
+      }
+
+      function setupHovercard(trigger) {
+        const card = document.getElementById(trigger.dataset.hovercard);
+        if (!card) return;
+        const hc = { trigger, card, timer: null, hovered: false, suppressFocus: false };
+
+        trigger.setAttribute('aria-haspopup', 'dialog');
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.setAttribute('aria-controls', card.id);
+
+        function open() {
+          clearTimeout(hc.timer);
+          if (active === hc) return;
+          if (active) active.close();
+          active = hc;
+          card.hidden = false;
+          position(trigger, card);
+          requestAnimationFrame(() => card.classList.add('is-open'));
+          trigger.setAttribute('aria-expanded', 'true');
+        }
+
+        function close() {
+          clearTimeout(hc.timer);
+          if (active !== hc) return;
+          active = null;
+          card.classList.remove('is-open');
+          card.hidden = true;
+          trigger.setAttribute('aria-expanded', 'false');
+        }
+        hc.close = close;
+
+        function schedule(fn, delay) {
+          clearTimeout(hc.timer);
+          hc.timer = setTimeout(fn, delay);
+        }
+
+        function contains(node) {
+          return node && (trigger.contains(node) || card.contains(node));
+        }
+
+        [trigger, card].forEach((el) => {
+          el.addEventListener('pointerenter', (e) => {
+            if (e.pointerType === 'touch') return;
+            hc.hovered = true;
+            if (active === hc) clearTimeout(hc.timer);
+            else schedule(open, OPEN_DELAY);
+          });
+          el.addEventListener('pointerleave', (e) => {
+            if (e.pointerType === 'touch') return;
+            hc.hovered = false;
+            if (!contains(document.activeElement) || document.activeElement === trigger) {
+              schedule(close, CLOSE_DELAY);
+            }
+          });
+          el.addEventListener('focusout', (e) => {
+            if (!contains(e.relatedTarget) && !hc.hovered) close();
+          });
+        });
+
+        trigger.addEventListener('focus', () => {
+          if (hc.suppressFocus) {
+            hc.suppressFocus = false;
+            return;
+          }
+          if (trigger.matches(':focus-visible')) open();
+        });
+
+        card.addEventListener('keydown', handleEscape);
+        trigger.addEventListener('keydown', handleEscape);
+
+        function handleEscape(e) {
+          if (e.key !== 'Escape' || active !== hc) return;
+          e.preventDefault();
+          const focusInCard = card.contains(document.activeElement);
+          close();
+          if (focusInCard) {
+            hc.suppressFocus = true;
+            trigger.focus({ preventScroll: true });
+          }
+        }
+      }
+
+      document.querySelectorAll('[data-hovercard]').forEach(setupHovercard);
+      window.addEventListener('scroll', reposition, { passive: true });
+      window.addEventListener('resize', reposition);
+    })();
+  </script>
+
