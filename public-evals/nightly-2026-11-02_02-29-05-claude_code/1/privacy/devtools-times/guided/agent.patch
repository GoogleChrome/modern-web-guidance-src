diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..2b01251 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -1,13 +1,53 @@
-
 import { defineMiddleware } from 'astro:middleware';
 
+// Pages that handle credentials. They are rendered without third-party
+// scripts (see Layout.astro) and must never be stored in shared caches.
+const PRIVACY_SENSITIVE_PATHS = ['/signin', '/signup'];
+
+const PRIVACY_HEADERS: Record<string, string> = {
+  // Never leak full URLs (paths, query strings) to other origins.
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  // The site uses none of these powerful features, so deny them to every
+  // origin, including embedded third parties. `browsing-topics=()` opts the
+  // site out of the Topics API interest-based advertising signal.
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'magnetometer=()',
+    'microphone=()',
+    'payment=()',
+    'usb=()',
+  ].join(', '),
+};
+
 export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
+  // Note: the reading list session is intentionally not created here. A
+  // session (and its cookie) is only started once a visitor actually saves an
+  // article; every reader falls back to an empty list when none exists.
+  const response = await next();
+
+  try {
+    for (const [name, value] of Object.entries(PRIVACY_HEADERS)) {
+      response.headers.set(name, value);
     }
+
+    const isHtml = response.headers.get('Content-Type')?.includes('text/html');
+    if (isHtml) {
+      // Layout.astro omits analytics when the browser sends Global Privacy Control.
+      response.headers.append('Vary', 'Sec-GPC');
+    }
+
+    const path = context.url.pathname.replace(/\/$/, '');
+    if (PRIVACY_SENSITIVE_PATHS.some((p) => path.endsWith(p))) {
+      response.headers.set('Cache-Control', 'no-store');
+    }
+  } catch {
+    // Some responses (e.g. Response.redirect()) have immutable headers.
   }
-  return next();
+
+  return response;
 });
