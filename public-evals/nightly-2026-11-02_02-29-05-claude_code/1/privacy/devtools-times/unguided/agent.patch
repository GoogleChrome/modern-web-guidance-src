diff --git a/src/components/PrivacyConsent.tsx b/src/components/PrivacyConsent.tsx
new file mode 100644
index 0000000..432ade5
--- /dev/null
+++ b/src/components/PrivacyConsent.tsx
@@ -0,0 +1,130 @@
+import React, { useEffect, useState } from 'react';
+
+// Analytics is opt-in: nothing is loaded until the reader explicitly agrees,
+// and it is never loaded on pages that handle credentials.
+const CONSENT_KEY = 'dt-privacy-consent';
+const ANALYTICS_SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+const ANALYTICS_EXCLUDED_PATHS = ['/signin', '/signup'];
+
+type Consent = 'granted' | 'denied';
+
+function readConsent(): Consent | null {
+  try {
+    const value = localStorage.getItem(CONSENT_KEY);
+    return value === 'granted' || value === 'denied' ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function writeConsent(value: Consent) {
+  try {
+    localStorage.setItem(CONSENT_KEY, value);
+  } catch {
+    // Storage unavailable: the choice applies to this page view only.
+  }
+}
+
+// Honor browser-level opt-out signals (Global Privacy Control / Do Not Track).
+function hasOptOutSignal(): boolean {
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+  return nav.globalPrivacyControl === true || nav.doNotTrack === '1';
+}
+
+function isExcludedPage(): boolean {
+  const path = window.location.pathname.replace(/\/$/, '');
+  return ANALYTICS_EXCLUDED_PATHS.some((excluded) => path.endsWith(excluded));
+}
+
+function loadAnalytics() {
+  if (isExcludedPage() || document.querySelector(`script[src="${ANALYTICS_SRC}"]`)) return;
+  const script = document.createElement('script');
+  script.src = ANALYTICS_SRC;
+  script.defer = true;
+  script.referrerPolicy = 'no-referrer';
+  document.head.appendChild(script);
+}
+
+export default function PrivacyConsent() {
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    const consent = readConsent();
+    if (consent === 'granted') {
+      loadAnalytics();
+    } else if (consent === null && !hasOptOutSignal()) {
+      setOpen(true);
+    }
+
+    // Any element with data-privacy-preferences (e.g. the footer link) reopens the dialog.
+    const onClick = (event: MouseEvent) => {
+      const trigger = (event.target as Element | null)?.closest('[data-privacy-preferences]');
+      if (!trigger) return;
+      event.preventDefault();
+      setOpen(true);
+    };
+    document.addEventListener('click', onClick);
+    return () => document.removeEventListener('click', onClick);
+  }, []);
+
+  const choose = (value: Consent) => {
+    const previous = readConsent();
+    writeConsent(value);
+    setOpen(false);
+    if (value === 'granted') {
+      loadAnalytics();
+    } else if (previous === 'granted') {
+      // The analytics script cannot be unloaded once running; reload to stop it.
+      window.location.reload();
+    }
+  };
+
+  if (!open) return null;
+
+  return (
+    <div
+      role="dialog"
+      aria-labelledby="privacy-consent-title"
+      aria-describedby="privacy-consent-description"
+      className="fixed inset-x-0 bottom-0 z-[60] p-4"
+    >
+      <div className="max-w-3xl mx-auto bg-white border border-gray-300 rounded-lg shadow-lg p-5 text-sm text-gray-700">
+        <h2 id="privacy-consent-title" className="text-base font-bold text-gray-900 mb-2">
+          Your privacy choices
+        </h2>
+        <p id="privacy-consent-description" className="mb-4">
+          With your permission, we use a third-party analytics service to count which links and
+          buttons are clicked (the element's label and a timestamp). It is never active on the
+          sign-in or sign-up pages, and we don't use it for advertising. You can change your choice
+          at any time via "Manage Privacy Preferences" in the footer. See our{' '}
+          <a
+            href={`${import.meta.env.BASE_URL}legal/privacy`}
+            data-skip-tracking="true"
+            className="underline"
+          >
+            Privacy Policy
+          </a>{' '}
+          for details.
+        </p>
+        <div className="flex flex-wrap gap-3 justify-end">
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => choose('denied')}
+            className="py-2 px-4 rounded-md text-sm font-medium border border-gray-900 text-white bg-gray-900 hover:bg-gray-800"
+          >
+            Reject analytics
+          </button>
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => choose('granted')}
+            className="py-2 px-4 rounded-md text-sm font-medium border border-gray-900 text-white bg-gray-900 hover:bg-gray-800"
+          >
+            Allow analytics
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
