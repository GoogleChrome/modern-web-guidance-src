@@ -0,0 +1,66 @@
+// Privacy audit for ./public: fails if the site references an origin that hasn't been reviewed,
+// or uses inline code that would force the CSP to be loosened.
+// Usage: node scripts/audit-third-parties.mjs
+import { readdir, readFile } from 'node:fs/promises';
+import { extname, join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('../public', import.meta.url));
+
+// Origins that passed review (see "Third-party audit" in PRIVACY.md). Add an entry here only
+// together with a PRIVACY.md row describing what data the origin receives and why.
+// Outbound links (plain <a href>) still count: they leak the visit via the Referer/timing.
+const ALLOWED_ORIGINS = new Set([]);
+
+const SCANNED = new Set(['.html', '.css', '.js', '.json', '.svg', '.txt']);
+const URL_PATTERN = /(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?/gi;
+
+const INLINE_CHECKS = [
+  { pattern: /<script(?![^>]*\bsrc=)[^>]*>/gi, message: 'inline <script> (CSP blocks it; move to /js)' },
+  { pattern: /<style[\s>]/gi, message: 'inline <style> (CSP blocks it; move to /css)' },
+  { pattern: /\sstyle\s*=/gi, message: 'inline style attribute (CSP blocks it; use a class)' },
+  { pattern: /\son[a-z]+\s*=/gi, message: 'inline event handler (CSP blocks it; use addEventListener)' },
+  { pattern: /javascript:/gi, message: 'javascript: URL' },
+  { pattern: /<a\b(?=[^>]*target=["']?_blank)(?![^>]*rel=["'][^"']*noopener)[^>]*>/gi, message: 'target=_blank without rel="noopener noreferrer"' },
+  { pattern: /<form\b(?=[^>]*method=["']?get)[^>]*>[\s\S]*?type=["']?password/gi, message: 'password field in a GET form (leaks into URLs/logs)' },
+];
+
+async function* walk(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const path = join(dir, entry.name);
+    if (entry.isDirectory()) yield* walk(path);
+    else if (SCANNED.has(extname(entry.name).toLowerCase())) yield path;
+  }
+}
+
+function lineOf(text, index) {
+  return text.slice(0, index).split('\n').length;
+}
+
+const problems = [];
+
+for await (const file of walk(ROOT)) {
+  const text = await readFile(file, 'utf8');
+  const rel = relative(process.cwd(), file);
+
+  for (const match of text.matchAll(URL_PATTERN)) {
+    const origin = new URL(match[0].startsWith('//') ? `https:${match[0]}` : match[0]).origin;
+    if (!ALLOWED_ORIGINS.has(origin)) {
+      problems.push(`${rel}:${lineOf(text, match.index)}  unaudited third-party origin ${origin}`);
+    }
+  }
+
+  if (extname(file) === '.html') {
+    for (const { pattern, message } of INLINE_CHECKS) {
+      for (const match of text.matchAll(pattern)) {
+        problems.push(`${rel}:${lineOf(text, match.index)}  ${message}`);
+      }
+    }
+  }
+}
+
+if (problems.length) {
+  console.error(`Privacy audit failed with ${problems.length} problem(s):\n  ${problems.join('\n  ')}`);
+  process.exit(1);
+}
+console.log('Privacy audit passed: no third-party origins or inline code found in public/.');
