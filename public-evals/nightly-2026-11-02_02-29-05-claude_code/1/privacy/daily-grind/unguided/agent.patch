@@ -0,0 +1,263 @@
+/**
+ * The Daily Grind — client-side privacy controls.
+ *
+ * Principles:
+ *  - Nothing optional is persisted until the visitor opts in (privacy by default).
+ *  - Global Privacy Control / Do Not Track are honoured as an automatic opt-out.
+ *  - Everything we persist is namespaced, minimal, and expires.
+ *  - Nothing in this file sends data anywhere; diagnostics stay in the local console.
+ *  - DOM is only touched via textContent/properties so Trusted Types can stay locked down.
+ */
+(function () {
+  'use strict';
+
+  var NAMESPACE = 'dg:';
+  var CONSENT_KEY = NAMESPACE + 'consent';
+  var CONSENT_VERSION = 1;
+  var DAY_MS = 24 * 60 * 60 * 1000;
+  var CONSENT_TTL_DAYS = 180;
+  var CATEGORIES = ['preferences'];
+
+  var optOutSignal =
+    navigator.globalPrivacyControl === true ||
+    navigator.doNotTrack === '1' ||
+    window.doNotTrack === '1';
+
+  // ---- Low-level storage (localStorage can throw in private modes / when disabled) ----
+
+  function readRecord(key) {
+    try {
+      var raw = window.localStorage.getItem(key);
+      if (!raw) return null;
+      var record = JSON.parse(raw);
+      if (!record || typeof record.exp !== 'number' || record.exp <= Date.now()) {
+        window.localStorage.removeItem(key);
+        return null;
+      }
+      return record;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  function writeRecord(key, value, ttlDays) {
+    try {
+      window.localStorage.setItem(key, JSON.stringify({ v: value, exp: Date.now() + ttlDays * DAY_MS }));
+      return true;
+    } catch (e) {
+      return false;
+    }
+  }
+
+  function removeNamespaced() {
+    try {
+      for (var i = window.localStorage.length - 1; i >= 0; i--) {
+        var key = window.localStorage.key(i);
+        if (key && key.indexOf(NAMESPACE) === 0) window.localStorage.removeItem(key);
+      }
+    } catch (e) { /* storage unavailable: nothing to remove */ }
+  }
+
+  function purgeExpired() {
+    try {
+      for (var i = window.localStorage.length - 1; i >= 0; i--) {
+        var key = window.localStorage.key(i);
+        if (key && key.indexOf(NAMESPACE) === 0) readRecord(key);
+      }
+    } catch (e) { /* storage unavailable */ }
+  }
+
+  // ---- Consent ----
+
+  function defaultConsent() {
+    var consent = {};
+    CATEGORIES.forEach(function (c) { consent[c] = false; });
+    return consent;
+  }
+
+  function loadConsent() {
+    var consent = defaultConsent();
+    if (optOutSignal) return consent;
+    var record = readRecord(CONSENT_KEY);
+    if (!record || !record.v || record.v.version !== CONSENT_VERSION) return consent;
+    CATEGORIES.forEach(function (c) { consent[c] = record.v[c] === true; });
+    return consent;
+  }
+
+  var consent = loadConsent();
+  var memoryStore = new Map();
+
+  function hasConsent(category) {
+    return consent[category] === true;
+  }
+
+  function saveConsent(choices) {
+    var next = defaultConsent();
+    if (!optOutSignal) {
+      CATEGORIES.forEach(function (c) { next[c] = choices[c] === true; });
+    }
+    consent = next;
+
+    var anyGranted = CATEGORIES.some(function (c) { return next[c]; });
+    if (!anyGranted) {
+      // Withdrawing consent removes what was stored under it — no "no thanks" record kept.
+      removeNamespaced();
+      return;
+    }
+
+    // Promote session-only values now that the visitor has opted in.
+    memoryStore.forEach(function (entry, key) {
+      writeRecord(NAMESPACE + key, entry.v, entry.ttlDays);
+    });
+    memoryStore.clear();
+
+    var record = { version: CONSENT_VERSION };
+    CATEGORIES.forEach(function (c) { record[c] = next[c]; });
+    writeRecord(CONSENT_KEY, record, CONSENT_TTL_DAYS);
+  }
+
+  // ---- Consent-aware store for feature code ----
+  // Values persist only with "preferences" consent; otherwise they live in memory for this page view.
+
+  var store = Object.freeze({
+    get: function (key) {
+      if (memoryStore.has(key)) return memoryStore.get(key).v;
+      if (!hasConsent('preferences')) return null;
+      var record = readRecord(NAMESPACE + key);
+      return record ? record.v : null;
+    },
+    set: function (key, value, options) {
+      var ttlDays = Math.min((options && options.ttlDays) || 30, CONSENT_TTL_DAYS);
+      if (hasConsent('preferences') && writeRecord(NAMESPACE + key, value, ttlDays)) return;
+      memoryStore.set(key, { v: value, ttlDays: ttlDays });
+    },
+    remove: function (key) {
+      memoryStore.delete(key);
+      try { window.localStorage.removeItem(NAMESPACE + key); } catch (e) { /* ignore */ }
+    }
+  });
+
+  // ---- Erasure ----
+
+  function expireReadableCookies() {
+    // HttpOnly cookies can't be touched from JS; the server clears them with Clear-Site-Data on logout.
+    document.cookie.split(';').forEach(function (cookie) {
+      var name = cookie.split('=')[0].trim();
+      if (name) document.cookie = name + '=; Max-Age=0; Path=/; Secure; SameSite=Strict';
+    });
+  }
+
+  function eraseLocalData() {
+    memoryStore.clear();
+    consent = defaultConsent();
+    try { window.localStorage.clear(); } catch (e) { /* ignore */ }
+    try { window.sessionStorage.clear(); } catch (e) { /* ignore */ }
+    expireReadableCookies();
+    if (window.caches && typeof window.caches.keys === 'function') {
+      return window.caches.keys()
+        .then(function (keys) { return Promise.all(keys.map(function (k) { return window.caches.delete(k); })); })
+        .catch(function () { /* ignore */ });
+    }
+    return Promise.resolve();
+  }
+
+  // ---- Local-only diagnostics: surface third-party requests and CSP violations to developers ----
+
+  function watchThirdPartyRequests() {
+    if (!('PerformanceObserver' in window)) return;
+    function check(entries) {
+      entries.forEach(function (entry) {
+        try {
+          var origin = new URL(entry.name).origin;
+          if (origin !== window.location.origin && origin !== 'null') {
+            console.warn('[privacy] Third-party request detected (not on the audited allowlist):', origin);
+          }
+        } catch (e) { /* data:/blob: URLs etc. */ }
+      });
+    }
+    try {
+      check(performance.getEntriesByType('resource'));
+      new PerformanceObserver(function (list) { check(list.getEntries()); })
+        .observe({ type: 'resource', buffered: false });
+    } catch (e) { /* unsupported */ }
+  }
+
+  document.addEventListener('securitypolicyviolation', function (event) {
+    // Deliberately not reported to any endpoint: the blocked URL may contain personal data.
+    console.warn('[privacy] Blocked by Content-Security-Policy:', event.effectiveDirective, event.blockedURI || '(inline)');
+  });
+
+  // ---- UI wiring ----
+
+  function initUi() {
+    var dialog = document.getElementById('privacy-dialog');
+    var openButton = document.querySelector('[data-privacy-open]');
+    var form = document.querySelector('[data-privacy-form]');
+    var status = document.querySelector('[data-privacy-status]');
+    var eraseButton = document.querySelector('[data-privacy-erase]');
+    var gpcNotice = document.querySelector('[data-gpc-notice]');
+    var logoutForm = document.querySelector('[data-logout]');
+
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        eraseLocalData().then(function () { logoutForm.submit(); });
+      });
+    }
+
+    if (!dialog || !openButton || !form || typeof dialog.showModal !== 'function') return;
+
+    var toggles = form.querySelectorAll('[data-consent]');
+
+    function syncForm() {
+      toggles.forEach(function (input) {
+        input.checked = hasConsent(input.getAttribute('data-consent'));
+        input.disabled = optOutSignal;
+      });
+      if (gpcNotice) gpcNotice.hidden = !optOutSignal;
+      if (status) status.textContent = '';
+    }
+
+    openButton.hidden = false;
+    openButton.addEventListener('click', function () {
+      syncForm();
+      dialog.showModal();
+    });
+
+    form.addEventListener('submit', function (event) {
+      if (event.submitter && event.submitter.value !== 'save') return;
+      var choices = {};
+      toggles.forEach(function (input) { choices[input.getAttribute('data-consent')] = input.checked; });
+      saveConsent(choices);
+    });
+
+    if (eraseButton) {
+      eraseButton.addEventListener('click', function () {
+        eraseLocalData().then(function () {
+          syncForm();
+          if (status) status.textContent = 'Data stored by this site on this device has been deleted.';
+        });
+      });
+    }
+  }
+
+  purgeExpired();
+  watchThirdPartyRequests();
+
+  Object.defineProperty(window, 'DailyGrindPrivacy', {
+    value: Object.freeze({
+      optOutSignal: optOutSignal,
+      hasConsent: hasConsent,
+      store: store,
+      eraseLocalData: eraseLocalData
+    }),
+    writable: false,
+    configurable: false
+  });
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initUi);
+  } else {
+    initUi();
+  }
+})();
