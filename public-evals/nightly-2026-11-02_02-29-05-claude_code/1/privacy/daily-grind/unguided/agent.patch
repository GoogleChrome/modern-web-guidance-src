diff --git a/public/css/styles.css b/public/css/styles.css
new file mode 100644
index 0000000..4286a90
--- /dev/null
+++ b/public/css/styles.css
@@ -0,0 +1,268 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('/images/hero.jpg');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Logout is a POST form so it can't be triggered by a cross-site link or prefetch */
+.logout-form {
+  display: inline;
+}
+
+.logout-link {
+  background: none;
+  color: white;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: color 0.3s;
+}
+
+.logout-link:hover {
+  color: var(--accent);
+}
+
+.link-button {
+  background: none;
+  border: none;
+  color: var(--text);
+  font: inherit;
+  font-size: 0.85rem;
+  margin: 0 10px;
+  cursor: pointer;
+}
+
+.link-button:hover,
+.footer-links a:hover {
+  text-decoration: underline;
+}
+
+/* Privacy choices dialog */
+.privacy-dialog {
+  max-width: 480px;
+  width: calc(100% - 40px);
+  margin: auto;
+  border: none;
+  border-radius: 8px;
+  padding: 24px;
+  color: var(--text);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+}
+
+.privacy-dialog::backdrop {
+  background: rgba(0, 0, 0, 0.5);
+}
+
+.privacy-dialog h2 {
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.privacy-dialog p,
+.privacy-dialog fieldset {
+  margin-bottom: 15px;
+  font-size: 0.9rem;
+}
+
+.privacy-dialog fieldset {
+  border: 1px solid var(--secondary);
+  border-radius: 6px;
+  padding: 12px;
+}
+
+.privacy-dialog label {
+  display: flex;
+  gap: 10px;
+  align-items: flex-start;
+}
+
+.privacy-dialog label + label {
+  margin-top: 10px;
+}
+
+.privacy-dialog input[type="checkbox"] {
+  margin-top: 5px;
+}
+
+.privacy-notice {
+  background: #fff3e0;
+  border-left: 4px solid var(--accent);
+  padding: 8px 12px;
+}
+
+.privacy-status {
+  min-height: 1.6em;
+  font-weight: bold;
+}
+
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  justify-content: flex-end;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+  border: none;
+  font: inherit;
+  cursor: pointer;
+}
+
+.btn-secondary {
+  background: var(--secondary);
+  color: var(--text);
+}
+
+.btn-secondary:hover {
+  background: #bcaaa4;
+}
+
+[hidden] {
+  display: none !important;
+}
