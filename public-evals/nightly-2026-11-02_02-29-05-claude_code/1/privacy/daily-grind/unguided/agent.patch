+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <!--
+    Fallback policies for hosts that don't send our HTTP headers (see server.mjs).
+    Every asset is first-party; keep it that way — run `npm run audit:privacy` after changes.
+  -->
+  <meta http-equiv="Content-Security-Policy"
+    content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests">
+  <meta name="referrer" content="same-origin">
+  <meta http-equiv="x-dns-prefetch-control" content="off">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="stylesheet" href="/css/styles.css">
+  <script src="/js/privacy.js" defer></script>
+</head>
+
+<body>
+
+  <nav aria-label="Main">
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li>
+        <form class="logout-form" method="post" action="/logout" data-logout>
+          <button type="submit" class="logout-link">Logout</button>
+        </form>
+      </li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a> |
+      <button type="button" class="link-button" data-privacy-open hidden>Privacy Choices</button>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <!-- Nothing optional is stored until the visitor opts in here. -->
+  <dialog class="privacy-dialog" id="privacy-dialog" aria-labelledby="privacy-dialog-title">
+    <form method="dialog" data-privacy-form>
+      <h2 id="privacy-dialog-title">Your Privacy Choices</h2>
+      <p>
+        We don't use advertising, analytics, or third-party trackers, and we don't load
+        anything from outside our own site. You decide whether we store anything else.
+      </p>
+      <p class="privacy-notice" data-gpc-notice hidden>
+        Your browser is sending a Global Privacy Control signal, so optional storage stays off.
+      </p>
+      <fieldset>
+        <legend>Stored on this device</legend>
+        <label>
+          <input type="checkbox" checked disabled>
+          <span><strong>Essential</strong> — needed for sign-in and checkout. Always on.</span>
+        </label>
+        <label>
+          <input type="checkbox" name="preferences" data-consent="preferences">
+          <span><strong>Preferences</strong> — remember choices like your usual store on this device.
+            Expires after 180 days. Off by default.</span>
+        </label>
+      </fieldset>
+      <p class="privacy-status" role="status" aria-live="polite" data-privacy-status></p>
+      <div class="dialog-actions">
+        <button type="button" class="btn btn-secondary" data-privacy-erase>Delete data on this device</button>
+        <button type="submit" class="btn" value="save">Save choices</button>
+      </div>
+    </form>
+  </dialog>
+
+</body>
+
+</html>
