diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..943151d
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,25 @@
+// Client-side privacy hardening for The Daily Grind.
+// This file must stay first-party and dependency-free: the CSP only allows
+// scripts from our own origin and blocks string writes to DOM sinks (Trusted Types).
+
+(() => {
+  'use strict';
+
+  // Ad and campaign tracking parameters we never need. Removing them keeps them
+  // out of bookmarks, shared links, and browser history.
+  const TRACKING_PARAMS = [
+    /^utm_/i,
+    /^(fbclid|gclid|gbraid|wbraid|dclid|msclkid|ttclid|twclid|li_fat_id|igshid|yclid)$/i,
+    /^(mc_cid|mc_eid|_hsenc|_hsmi|mkt_tok|oly_anon_id|oly_enc_id|vero_id|_ga|_gl)$/i,
+  ];
+
+  const url = new URL(window.location.href);
+  const tracked = [...url.searchParams.keys()].filter((key) =>
+    TRACKING_PARAMS.some((pattern) => pattern.test(key)),
+  );
+
+  if (tracked.length > 0) {
+    tracked.forEach((key) => url.searchParams.delete(key));
+    window.history.replaceState(window.history.state, '', url);
+  }
+})();
