+# Security and privacy headers (Netlify / Cloudflare Pages `_headers` format).
+# If you deploy elsewhere, set the same headers in the server or CDN config.
+# index.html carries <meta> fallbacks for the CSP and Referrer-Policy.
+# HSTS starts with a short max-age. Raise it to 31536000 once HTTPS works on every subdomain.
+
+/*
+  Content-Security-Policy: default-src 'none'; script-src 'self' 'report-sample'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-to csp
+  Reporting-Endpoints: csp="/api/csp-reports"
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), focus-without-user-activation=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(self), serial=(), usb=(), xr-spatial-tracking=()
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: DENY
+  Cross-Origin-Opener-Policy: same-origin
+  Cross-Origin-Resource-Policy: same-origin
+  Strict-Transport-Security: max-age=300; includeSubDomains
+
+# Never cache personal pages in shared or browser caches.
+/account/*
+  Cache-Control: no-store
+
+/account
+  Cache-Control: no-store
+
+# On logout, delete all cookies and local storage for this origin.
+# "cache" is left out on purpose: clearing it on a navigation response can block rendering on slow devices.
+/logout
+  Clear-Site-Data: "cookies", "storage"
+  Cache-Control: no-store
