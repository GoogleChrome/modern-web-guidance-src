+  <!-- Announces busy state to assistive tech; kept outside any aria-busy region -->
+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var buttons = document.querySelectorAll('.btn[data-loading-text]');
+
+      function setLoading(btn, loading) {
+        var label = btn.querySelector('.btn-label');
+        var card = btn.closest('.card');
+        if (loading) {
+          btn.dataset.originalText = label.textContent;
+          label.textContent = btn.dataset.loadingText;
+          btn.classList.add('is-loading');
+          btn.setAttribute('aria-disabled', 'true');
+          if (card) card.setAttribute('aria-busy', 'true');
+          var heading = card && card.querySelector('h3');
+          status.textContent = heading
+            ? 'Loading ' + heading.textContent + ' details…'
+            : 'Starting your order…';
+        } else if (btn.classList.contains('is-loading')) {
+          label.textContent = btn.dataset.originalText;
+          btn.classList.remove('is-loading');
+          btn.removeAttribute('aria-disabled');
+          if (card) card.removeAttribute('aria-busy');
+        }
+      }
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          // Let new-tab/window clicks through without a busy state
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (btn.classList.contains('is-loading')) {
+            e.preventDefault();
+            return;
+          }
+          setLoading(btn, true);
+        });
+      });
+
+      // Reset when returning via back/forward cache
+      window.addEventListener('pageshow', function (e) {
+        if (!e.persisted) return;
+        buttons.forEach(function (btn) { setLoading(btn, false); });
+        status.textContent = '';
+      });
+    })();
+  </script>
+
