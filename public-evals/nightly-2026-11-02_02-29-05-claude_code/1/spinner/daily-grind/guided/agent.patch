+  <div id="loading-status" class="visually-hidden" role="status"></div>
+
+  <script>
+    const status = document.getElementById('loading-status');
+
+    function resetLoading(link) {
+      link.removeAttribute('aria-busy');
+      link.removeAttribute('aria-disabled');
+      link.querySelector('.loading-spinner')?.remove();
+    }
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-loading-label]');
+      if (!link) return;
+
+      // Let new-tab/new-window clicks through without a loading state
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      // Ignore repeat clicks while navigation is already underway
+      if (link.getAttribute('aria-busy') === 'true') {
+        event.preventDefault();
+        return;
+      }
+
+      const label = link.dataset.loadingLabel;
+      const spinner = document.createElement('progress');
+      spinner.className = 'loading-spinner';
+      spinner.setAttribute('aria-label', label);
+
+      link.setAttribute('aria-busy', 'true');
+      link.setAttribute('aria-disabled', 'true');
+      link.append(spinner);
+      status.textContent = `${label}…`;
+    });
+
+    // Clear stale spinners when the page is restored from the back/forward cache
+    window.addEventListener('pageshow', (event) => {
+      if (!event.persisted) return;
+      document.querySelectorAll('a[data-loading-label][aria-busy]').forEach(resetLoading);
+      status.textContent = '';
+    });
+  </script>
+
