@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { errorResponse, getSignedInUser, json, unauthorized } from '../../../lib/http';
+import { createChallenge, getAccount, getRelyingParty } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  try {
+    const account = await getAccount(user.username);
+    const rp = getRelyingParty(url);
+    const challenge = createChallenge();
+    session?.set('passkeyChallenge', challenge);
+
+    return json({
+      challenge: challenge.challenge,
+      rp: { id: rp.rpId, name: rp.name },
+      user: { id: account.userHandle, name: user.username, displayName: user.username },
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -8 },
+        { type: 'public-key', alg: -7 },
+        { type: 'public-key', alg: -257 },
+      ],
+      excludeCredentials: account.passkeys.map((p) => ({ type: 'public-key', id: p.id, transports: p.transports })),
+      authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+      attestation: 'none',
+      timeout: 5 * 60 * 1000,
+    });
+  } catch (err) {
+    return errorResponse(err);
+  }
+};
