@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { json } from '../../../lib/http';
+
+const UPSTREAM_LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Proxies the upstream login so the server can trust who is signed in before
+// exposing account settings such as passkey management.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM_LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Login service unavailable' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json(data, upstream.status);
+  }
+
+  session?.regenerate();
+  session?.set('user', { username });
+  return json({ ...data, username });
+};
