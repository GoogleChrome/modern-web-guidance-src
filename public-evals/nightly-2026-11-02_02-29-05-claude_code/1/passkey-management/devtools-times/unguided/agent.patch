index 0000000..6b26a36
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,209 @@
+import { createHash, randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  name: string;
+  publicKey: string; // base64url SPKI
+  algorithm: number;
+  transports: string[];
+  aaguid: string;
+  backedUp: boolean;
+  createdAt: string;
+}
+
+interface StoredUser {
+  userHandle: string; // base64url WebAuthn user.id
+  passkeys: StoredPasskey[];
+}
+
+type Store = Record<string, StoredUser>;
+
+export type PublicPasskey = Pick<StoredPasskey, 'id' | 'name' | 'transports' | 'backedUp' | 'createdAt'>;
+
+export const PASSKEY_NAME_MAX_LENGTH = 64;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+const STORE_PATH = process.env.PASSKEY_STORE_PATH ?? path.join(process.cwd(), '.data', 'passkeys.json');
+
+// Serialize all read-modify-write cycles so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function readStore(): Promise<Store> {
+  try {
+    return JSON.parse(await readFile(STORE_PATH, 'utf8'));
+  } catch (err: any) {
+    if (err?.code === 'ENOENT') return {};
+    throw err;
+  }
+}
+
+async function writeStore(store: Store) {
+  await mkdir(path.dirname(STORE_PATH), { recursive: true });
+  const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(store, null, 2));
+  await rename(tmp, STORE_PATH);
+}
+
+function withStore<T>(fn: (store: Store) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await readStore();
+    const before = JSON.stringify(store);
+    const result = await fn(store);
+    if (JSON.stringify(store) !== before) await writeStore(store);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+function ensureUser(store: Store, username: string): StoredUser {
+  store[username] ??= { userHandle: randomBytes(32).toString('base64url'), passkeys: [] };
+  return store[username];
+}
+
+export function toPublicPasskey({ id, name, transports, backedUp, createdAt }: StoredPasskey): PublicPasskey {
+  return { id, name, transports, backedUp, createdAt };
+}
+
+export function normalizePasskeyName(name: unknown): string | null {
+  if (typeof name !== 'string') return null;
+  const trimmed = name.trim().replace(/\s+/g, ' ');
+  if (!trimmed || trimmed.length > PASSKEY_NAME_MAX_LENGTH) return null;
+  return trimmed;
+}
+
+export function getAccount(username: string) {
+  return withStore((store) => {
+    const user = ensureUser(store, username);
+    return { userHandle: user.userHandle, passkeys: user.passkeys };
+  });
+}
+
+export function addPasskey(username: string, passkey: Omit<StoredPasskey, 'name' | 'createdAt'>) {
+  return withStore((store) => {
+    const user = ensureUser(store, username);
+    if (Object.values(store).some((u) => u.passkeys.some((p) => p.id === passkey.id))) {
+      throw new PasskeyError('This passkey is already registered.', 409);
+    }
+    const stored: StoredPasskey = {
+      ...passkey,
+      name: `Passkey ${user.passkeys.length + 1}`,
+      createdAt: new Date().toISOString(),
+    };
+    user.passkeys.push(stored);
+    return stored;
+  });
+}
+
+export function renamePasskey(username: string, id: string, name: string) {
+  return withStore((store) => {
+    const passkey = store[username]?.passkeys.find((p) => p.id === id);
+    if (!passkey) throw new PasskeyError('Passkey not found.', 404);
+    passkey.name = name;
+    return passkey;
+  });
+}
+
+export function removePasskey(username: string, id: string) {
+  return withStore((store) => {
+    const user = store[username];
+    if (!user?.passkeys.some((p) => p.id === id)) throw new PasskeyError('Passkey not found.', 404);
+    user.passkeys = user.passkeys.filter((p) => p.id !== id);
+    return user.passkeys;
+  });
+}
+
+export class PasskeyError extends Error {
+  status: number;
+
+  constructor(message: string, status = 400) {
+    super(message);
+    this.status = status;
+  }
+}
+
+// --- WebAuthn registration -------------------------------------------------
+
+export function createChallenge() {
+  return { challenge: randomBytes(32).toString('base64url'), expiresAt: Date.now() + CHALLENGE_TTL_MS };
+}
+
+export function isChallengeValid(stored: { challenge: string; expiresAt: number } | undefined, challenge: string) {
+  return !!stored && stored.expiresAt > Date.now() && stored.challenge === challenge;
+}
+
+export interface RegistrationResponse {
+  id: string;
+  rawId: string;
+  type: string;
+  response: {
+    clientDataJSON: string;
+    authenticatorData: string;
+    publicKey: string | null;
+    publicKeyAlgorithm: number;
+    transports: string[];
+  };
+}
+
+const FLAG_USER_PRESENT = 0x01;
+const FLAG_BACKUP_STATE = 0x10;
+const FLAG_ATTESTED_CREDENTIAL_DATA = 0x40;
+
+/**
+ * Verifies a registration made with `attestation: 'none'`. The browser hands us the
+ * authenticator data and SPKI public key directly, so no CBOR decoding is needed.
+ */
+export function verifyRegistration(
+  credential: RegistrationResponse,
+  { expectedChallenge, expectedOrigin, rpId }: { expectedChallenge: { challenge: string; expiresAt: number } | undefined; expectedOrigin: string; rpId: string },
+): Omit<StoredPasskey, 'name' | 'createdAt'> {
+  const { response } = credential ?? {};
+  if (credential?.type !== 'public-key' || !response?.clientDataJSON || !response.authenticatorData) {
+    throw new PasskeyError('Malformed credential.');
+  }
+  if (credential.id !== credential.rawId) throw new PasskeyError('Credential ID mismatch.');
+
+  let clientData: { type?: string; challenge?: string; origin?: string };
+  try {
+    clientData = JSON.parse(Buffer.from(response.clientDataJSON, 'base64url').toString('utf8'));
+  } catch {
+    throw new PasskeyError('Malformed client data.');
+  }
+  if (clientData.type !== 'webauthn.create') throw new PasskeyError('Unexpected ceremony type.');
+  if (!clientData.challenge || !isChallengeValid(expectedChallenge, clientData.challenge)) {
+    throw new PasskeyError('The registration request expired. Please try again.');
+  }
+  if (clientData.origin !== expectedOrigin) throw new PasskeyError('Origin mismatch.');
+
+  const authData = Buffer.from(response.authenticatorData, 'base64url');
+  if (authData.length < 37 + 18) throw new PasskeyError('Malformed authenticator data.');
+  const rpIdHash = createHash('sha256').update(rpId).digest();
+  if (!authData.subarray(0, 32).equals(rpIdHash)) throw new PasskeyError('Relying party mismatch.');
+
+  const flags = authData[32];
+  if (!(flags & FLAG_USER_PRESENT)) throw new PasskeyError('User presence is required.');
+  if (!(flags & FLAG_ATTESTED_CREDENTIAL_DATA)) throw new PasskeyError('Missing credential data.');
+
+  const aaguid = authData.subarray(37, 53).toString('hex');
+  const credIdLength = authData.readUInt16BE(53);
+  const credId = authData.subarray(55, 55 + credIdLength).toString('base64url');
+  if (credId !== credential.rawId) throw new PasskeyError('Credential ID mismatch.');
+
+  if (!response.publicKey) throw new PasskeyError('This authenticator uses an unsupported key type.');
+  if (![-7, -8, -257].includes(response.publicKeyAlgorithm)) throw new PasskeyError('Unsupported key algorithm.');
+
+  return {
+    id: credId,
+    publicKey: response.publicKey,
+    algorithm: response.publicKeyAlgorithm,
+    transports: Array.isArray(response.transports) ? response.transports.filter((t) => typeof t === 'string') : [],
+    aaguid,
+    backedUp: !!(flags & FLAG_BACKUP_STATE),
+  };
+}
+
+export function getRelyingParty(url: URL) {
+  return { rpId: url.hostname, origin: url.origin, name: 'The DevTools Times' };
+}
