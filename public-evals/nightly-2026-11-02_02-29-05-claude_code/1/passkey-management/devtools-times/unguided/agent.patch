diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..c3c007c
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,370 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { CheckIcon, CloudIcon, KeyIcon, PencilSquareIcon, PlusIcon, TrashIcon, XMarkIcon } from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  transports: string[];
+  backedUp: boolean;
+  createdAt: string;
+}
+
+interface Account {
+  rpId: string;
+  userHandle: string;
+  username: string;
+  passkeys: Passkey[];
+}
+
+// WebAuthn Signals API — not yet in TypeScript's DOM lib.
+type SignalingPublicKeyCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+const API = `${import.meta.env.BASE_URL}api/passkeys`;
+const NAME_MAX_LENGTH = 64;
+
+const toBase64Url = (buffer: ArrayBuffer) =>
+  btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+const fromBase64Url = (value: string) => {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  return Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
+};
+
+const webAuthnSupported = () => typeof window !== 'undefined' && 'PublicKeyCredential' in window;
+
+const getSignals = () => (webAuthnSupported() ? (window.PublicKeyCredential as SignalingPublicKeyCredential) : undefined);
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
+  return data;
+}
+
+/** Tells the browser's passkey provider which credentials the server still accepts. */
+async function syncAcceptedCredentials(rpId: string, userHandle: string, ids: string[]) {
+  const signals = getSignals();
+  if (!signals?.signalAllAcceptedCredentials) return false;
+  await signals.signalAllAcceptedCredentials({ rpId, userId: userHandle, allAcceptedCredentialIds: ids });
+  return true;
+}
+
+async function syncUserDetails(rpId: string, userHandle: string, username: string) {
+  const signals = getSignals();
+  if (!signals?.signalCurrentUserDetails) return false;
+  await signals.signalCurrentUserDetails({ rpId, userId: userHandle, name: username, displayName: username });
+  return true;
+}
+
+const formatDate = (iso: string) =>
+  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmingId, setConfirmingId] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [signalsSupported, setSignalsSupported] = useState(false);
+
+  const sync = useCallback(async (acct: Account) => {
+    try {
+      await syncAcceptedCredentials(acct.rpId, acct.userHandle, acct.passkeys.map((p) => p.id));
+      await syncUserDetails(acct.rpId, acct.userHandle, acct.username);
+    } catch (err) {
+      console.warn('Failed to sync passkeys with the authenticator', err);
+    }
+  }, []);
+
+  useEffect(() => {
+    setSignalsSupported(!!getSignals()?.signalAllAcceptedCredentials);
+    request<Account>(API)
+      .then((acct) => {
+        setAccount(acct);
+        // Reconcile on load too, so passkeys removed from another device disappear here.
+        sync(acct);
+      })
+      .catch((err) => setError(err.message))
+      .finally(() => setLoading(false));
+  }, [sync]);
+
+  const resetMessages = () => {
+    setError(null);
+    setNotice(null);
+  };
+
+  const handleAdd = async () => {
+    if (!account) return;
+    resetMessages();
+    setAdding(true);
+    try {
+      const options = await request<any>(`${API}/registration-options`, { method: 'POST' });
+      const credential = (await navigator.credentials.create({
+        publicKey: {
+          ...options,
+          challenge: fromBase64Url(options.challenge),
+          user: { ...options.user, id: fromBase64Url(options.user.id) },
+          excludeCredentials: options.excludeCredentials.map((c: any) => ({ ...c, id: fromBase64Url(c.id) })),
+        },
+      })) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created.');
+
+      const response = credential.response as AuthenticatorAttestationResponse;
+      const publicKey = response.getPublicKey();
+      const { passkey } = await request<{ passkey: Passkey }>(API, {
+        method: 'POST',
+        body: JSON.stringify({
+          id: credential.id,
+          rawId: toBase64Url(credential.rawId),
+          type: credential.type,
+          response: {
+            clientDataJSON: toBase64Url(response.clientDataJSON),
+            authenticatorData: toBase64Url(response.getAuthenticatorData()),
+            publicKey: publicKey ? toBase64Url(publicKey) : null,
+            publicKeyAlgorithm: response.getPublicKeyAlgorithm(),
+            transports: response.getTransports?.() ?? [],
+          },
+        }),
+      });
+      setAccount({ ...account, passkeys: [...account.passkeys, passkey] });
+      setNotice(`“${passkey.name}” was added. Give it a name you’ll recognize.`);
+      setEditingId(passkey.id);
+      setDraftName(passkey.name);
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') setError('Passkey creation was cancelled.');
+      else if (err?.name === 'InvalidStateError') setError('This device already has a passkey for your account.');
+      else setError(err?.message ?? 'Could not add passkey.');
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const startEditing = (passkey: Passkey) => {
+    resetMessages();
+    setConfirmingId(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    if (!account) return;
+    const name = draftName.trim();
+    if (name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    resetMessages();
+    setBusyId(passkey.id);
+    try {
+      const { passkey: updated } = await request<{ passkey: Passkey }>(`${API}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PATCH',
+        body: JSON.stringify({ name }),
+      });
+      setAccount({ ...account, passkeys: account.passkeys.map((p) => (p.id === updated.id ? updated : p)) });
+      setEditingId(null);
+      setNotice('Passkey name updated.');
+    } catch (err: any) {
+      setError(err.message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleRemove = async (passkey: Passkey) => {
+    if (!account) return;
+    resetMessages();
+    setBusyId(passkey.id);
+    try {
+      const { acceptedCredentialIds } = await request<{ acceptedCredentialIds: string[] }>(
+        `${API}/${encodeURIComponent(passkey.id)}`,
+        { method: 'DELETE' },
+      );
+      setAccount({ ...account, passkeys: account.passkeys.filter((p) => acceptedCredentialIds.includes(p.id)) });
+      setConfirmingId(null);
+
+      let synced = false;
+      try {
+        synced = await syncAcceptedCredentials(account.rpId, account.userHandle, acceptedCredentialIds);
+      } catch (err) {
+        console.warn('Failed to sync passkeys with the authenticator', err);
+      }
+      setNotice(
+        synced
+          ? `“${passkey.name}” was removed and your password manager was asked to delete it.`
+          : `“${passkey.name}” was removed. You may also want to delete it from your password manager.`,
+      );
+    } catch (err: any) {
+      setError(err.message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="border border-gray-200 rounded-lg">
+      <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 p-6 border-b border-gray-200">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+            Passkeys
+          </h2>
+          <p className="mt-1 text-sm text-gray-600 max-w-xl">
+            Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password. Changes here are
+            {signalsSupported
+              ? ' shared with your browser’s password manager so it only offers passkeys that still work.'
+              : ' saved to your account; your browser doesn’t support syncing them to its password manager.'}
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleAdd}
+          disabled={adding || loading || !account || !webAuthnSupported()}
+          className="inline-flex items-center justify-center gap-1.5 shrink-0 py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+        >
+          <PlusIcon className="h-4 w-4" aria-hidden="true" />
+          {adding ? 'Waiting for device…' : 'Add a passkey'}
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="mx-6 mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && <div className="mx-6 mt-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      {loading ? (
+        <p className="p-6 text-sm text-gray-500">Loading passkeys…</p>
+      ) : account && account.passkeys.length === 0 ? (
+        <div className="p-6 text-center">
+          <KeyIcon className="h-8 w-8 mx-auto text-gray-400" aria-hidden="true" />
+          <p className="mt-2 text-sm font-medium text-gray-900">No passkeys yet</p>
+          <p className="text-sm text-gray-500">Add one to sign in faster and more securely.</p>
+        </div>
+      ) : (
+        <ul className="divide-y divide-gray-200">
+          {account?.passkeys.map((passkey) => {
+            const busy = busyId === passkey.id;
+            const inputId = `passkey-name-${passkey.id}`;
+            return (
+              <li key={passkey.id} className="flex flex-col sm:flex-row sm:items-center gap-3 px-6 py-4">
+                <KeyIcon className="hidden sm:block h-6 w-6 text-gray-500 shrink-0" aria-hidden="true" />
+
+                {editingId === passkey.id ? (
+                  <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-1 flex-wrap items-center gap-2">
+                    <label htmlFor={inputId} className="sr-only">
+                      Passkey name
+                    </label>
+                    <input
+                      id={inputId}
+                      type="text"
+                      value={draftName}
+                      onChange={(e) => setDraftName(e.target.value)}
+                      onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                      maxLength={NAME_MAX_LENGTH}
+                      required
+                      autoFocus
+                      disabled={busy}
+                      className="flex-1 min-w-0 px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                    />
+                    <button
+                      type="submit"
+                      disabled={busy || !draftName.trim()}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+                    >
+                      <CheckIcon className="h-4 w-4" aria-hidden="true" />
+                      {busy ? 'Saving…' : 'Save'}
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setEditingId(null)}
+                      disabled={busy}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                    >
+                      <XMarkIcon className="h-4 w-4" aria-hidden="true" />
+                      Cancel
+                    </button>
+                  </form>
+                ) : (
+                  <>
+                    <div className="flex-1 min-w-0">
+                      <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                      <p className="flex flex-wrap items-center gap-x-3 text-xs text-gray-500">
+                        <span>Added {formatDate(passkey.createdAt)}</span>
+                        {passkey.backedUp && (
+                          <span className="inline-flex items-center gap-1">
+                            <CloudIcon className="h-3.5 w-3.5" aria-hidden="true" />
+                            Synced across devices
+                          </span>
+                        )}
+                      </p>
+                    </div>
+
+                    {confirmingId === passkey.id ? (
+                      <div className="flex items-center gap-2 text-sm">
+                        <span className="text-gray-700">Remove this passkey?</span>
+                        <button
+                          type="button"
+                          onClick={() => handleRemove(passkey)}
+                          disabled={busy}
+                          className="py-1.5 px-3 rounded-md font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-60"
+                        >
+                          {busy ? 'Removing…' : 'Remove'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setConfirmingId(null)}
+                          disabled={busy}
+                          className="py-1.5 px-3 rounded-md font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    ) : (
+                      <div className="flex items-center gap-2">
+                        <button
+                          type="button"
+                          onClick={() => startEditing(passkey)}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                          aria-label={`Rename ${passkey.name}`}
+                        >
+                          <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                          Rename
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            resetMessages();
+                            setEditingId(null);
+                            setConfirmingId(passkey.id);
+                          }}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-red-700 border border-red-200 hover:bg-red-50"
+                          aria-label={`Remove ${passkey.name}`}
+                        >
+                          <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                          Remove
+                        </button>
+                      </div>
+                    )}
+                  </>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+}
