+import type { APIRoute } from 'astro';
+import { errorResponse, getSignedInUser, json, unauthorized } from '../../../lib/http';
+import {
+  PASSKEY_NAME_MAX_LENGTH,
+  normalizePasskeyName,
+  removePasskey,
+  renamePasskey,
+  toPublicPasskey,
+} from '../../../lib/passkeys';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const { name } = await request.json().catch(() => ({}));
+  const normalized = normalizePasskeyName(name);
+  if (!normalized) {
+    return json({ error: `Name must be between 1 and ${PASSKEY_NAME_MAX_LENGTH} characters.` }, 400);
+  }
+
+  try {
+    const passkey = await renamePasskey(user.username, params.id!, normalized);
+    return json({ passkey: toPublicPasskey(passkey) });
+  } catch (err) {
+    return errorResponse(err);
+  }
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  try {
+    const remaining = await removePasskey(user.username, params.id!);
+    // The client forwards this list to PublicKeyCredential.signalAllAcceptedCredentials().
+    return json({ acceptedCredentialIds: remaining.map((p) => p.id) });
+  } catch (err) {
+    return errorResponse(err);
+  }
+};
