+import type { APIRoute } from 'astro';
+import { errorResponse, getSignedInUser, json, unauthorized } from '../../../lib/http';
+import { addPasskey, getAccount, getRelyingParty, toPublicPasskey, verifyRegistration } from '../../../lib/passkeys';
+
+// Returns the reader's passkeys plus the identifiers the client needs to keep
+// the browser's authenticator in sync via the WebAuthn Signals API.
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  try {
+    const account = await getAccount(user.username);
+    return json({
+      rpId: getRelyingParty(url).rpId,
+      userHandle: account.userHandle,
+      username: user.username,
+      passkeys: account.passkeys.map(toPublicPasskey),
+    });
+  } catch (err) {
+    return errorResponse(err);
+  }
+};
+
+// Completes passkey registration started via registration-options.
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const expectedChallenge = await session?.get('passkeyChallenge');
+  session?.delete('passkeyChallenge');
+
+  try {
+    const rp = getRelyingParty(url);
+    const credential = await request.json().catch(() => null);
+    const verified = verifyRegistration(credential, { expectedChallenge, expectedOrigin: rp.origin, rpId: rp.rpId });
+    const passkey = await addPasskey(user.username, verified);
+    return json({ passkey: toPublicPasskey(passkey) }, 201);
+  } catch (err) {
+    return errorResponse(err);
+  }
+};
