diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..fa19ce0
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,385 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import type { PublicPasskey } from '../lib/passkeys/store';
+
+interface Props {
+  rpId: string;
+  userId: string; // Base64URL-encoded WebAuthn user handle
+  username: string;
+  initialDisplayName: string;
+}
+
+const API = `${import.meta.env.BASE_URL}api/account`;
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+
+// Signal API methods are newer than the TS DOM lib in some setups.
+type SignalingPublicKeyCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+function webauthn(): SignalingPublicKeyCredential | null {
+  return typeof window !== 'undefined' && window.PublicKeyCredential
+    ? (window.PublicKeyCredential as SignalingPublicKeyCredential)
+    : null;
+}
+
+async function readError(response: Response, fallback: string) {
+  const data = await response.json().catch(() => null);
+  return data?.error ?? fallback;
+}
+
+export default function PasskeyManager({ rpId, userId, username, initialDisplayName }: Props) {
+  const [passkeys, setPasskeys] = useState<PublicPasskey[] | null>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<PublicPasskey | null>(null);
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [savingName, setSavingName] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const displayNameId = useId();
+
+  // Tell the password manager exactly which passkeys the server still accepts,
+  // so it can hide ones that were removed here or on another device.
+  const syncAcceptedCredentials = async (list: PublicPasskey[]) => {
+    const pkc = webauthn();
+    if (!pkc?.signalAllAcceptedCredentials) return;
+    try {
+      await pkc.signalAllAcceptedCredentials({
+        rpId,
+        userId,
+        allAcceptedCredentialIds: list.map((p) => p.id),
+      });
+    } catch (e) {
+      console.error('signalAllAcceptedCredentials failed:', e);
+    }
+  };
+
+  const loadPasskeys = async () => {
+    const response = await fetch(`${API}/passkeys`);
+    if (!response.ok) throw new Error(await readError(response, 'Could not load your passkeys.'));
+    const list: PublicPasskey[] = await response.json();
+    setPasskeys(list);
+    return list;
+  };
+
+  useEffect(() => {
+    (async () => {
+      const pkc = webauthn();
+      if (pkc) {
+        // Fills in parseCreationOptionsFromJSON, toJSON and getClientCapabilities where missing.
+        await import('webauthn-polyfills');
+        const caps = await PublicKeyCredential.getClientCapabilities();
+        setCanCreate(Boolean(caps.passkeyPlatformAuthenticator));
+      }
+      try {
+        await syncAcceptedCredentials(await loadPasskeys());
+      } catch (e) {
+        setError((e as Error).message);
+        setPasskeys([]);
+      }
+    })();
+  }, []);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (pendingDelete && !dialog.open) dialog.showModal();
+    if (!pendingDelete && dialog.open) dialog.close();
+  }, [pendingDelete]);
+
+  const announce = (message: string) => {
+    setError(null);
+    setStatus(message);
+  };
+
+  const createPasskey = async () => {
+    setError(null);
+    setStatus(null);
+    setCreating(true);
+    try {
+      const optionsResponse = await fetch(`${API}/passkeys/register-options`, { method: 'POST' });
+      if (!optionsResponse.ok) throw new Error(await readError(optionsResponse, 'Could not start passkey creation.'));
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+      let credential: PublicKeyCredential;
+      try {
+        credential = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential;
+      } catch (e) {
+        const name = (e as DOMException).name;
+        if (name === 'InvalidStateError') setError('A passkey from this provider is already registered.');
+        else if (name === 'SecurityError') setError('Passkeys are not available on this domain.');
+        // NotAllowedError / AbortError: the reader cancelled, nothing to report.
+        return;
+      }
+
+      const encoded = credential.toJSON();
+      let verified = false;
+      try {
+        const verifyResponse = await fetch(`${API}/passkeys/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+        verified = verifyResponse.ok;
+        if (!verified) setError(await readError(verifyResponse, 'Passkey could not be saved.'));
+      } catch {
+        setError('Passkey could not be saved. Please try again.');
+      }
+
+      if (!verified) {
+        // The authenticator created a credential the server never stored; ask it to drop it.
+        await webauthn()?.signalUnknownCredential?.({ rpId, credentialId: encoded.id }).catch(() => {});
+        return;
+      }
+
+      await loadPasskeys();
+      announce('Passkey created.');
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const renamePasskey = async (e: React.FormEvent<HTMLFormElement>, passkey: PublicPasskey) => {
+    e.preventDefault();
+    const name = String(new FormData(e.currentTarget).get('name') ?? '').trim();
+    if (!name || name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    const response = await fetch(`${API}/passkeys/${encodeURIComponent(passkey.id)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+    if (!response.ok) {
+      setError(await readError(response, 'Could not rename passkey.'));
+      return;
+    }
+    // A passkey nickname is a server-side label only; no Signal API call needed.
+    const updated: PublicPasskey = await response.json();
+    setPasskeys((list) => list?.map((p) => (p.id === updated.id ? updated : p)) ?? null);
+    setEditingId(null);
+    announce(`Passkey renamed to “${updated.name}”.`);
+  };
+
+  const confirmDelete = async () => {
+    if (!pendingDelete) return;
+    const target = pendingDelete;
+    setPendingDelete(null);
+    const response = await fetch(`${API}/passkeys/${encodeURIComponent(target.id)}`, { method: 'DELETE' });
+    if (!response.ok) {
+      setError(await readError(response, 'Could not remove passkey.'));
+      return;
+    }
+    const remaining = await loadPasskeys();
+    await syncAcceptedCredentials(remaining);
+    announce(`“${target.name}” was removed.`);
+  };
+
+  const saveDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSavingName(true);
+    try {
+      const response = await fetch(`${API}/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      if (!response.ok) {
+        setError(await readError(response, 'Could not update display name.'));
+        return;
+      }
+      const user = await response.json();
+      setDisplayName(user.displayName);
+      // Update the account name shown in the password manager's passkey picker.
+      await webauthn()
+        ?.signalCurrentUserDetails?.({ rpId, userId, name: user.name, displayName: user.displayName })
+        .catch((err) => console.error('signalCurrentUserDetails failed:', err));
+      announce('Display name updated.');
+    } finally {
+      setSavingName(false);
+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      <div aria-live="polite" className="empty:hidden">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {!error && status && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{status}</div>}
+      </div>
+
+      <section className="bg-white border border-gray-200 rounded-lg shadow-sm p-6" aria-labelledby="profile-heading">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-800 mb-1">Profile</h2>
+        <p className="text-sm text-gray-600 mb-4">
+          Signed in as <span className="font-semibold">{username}</span>. Your display name is shown alongside your
+          passkeys in your password manager.
+        </p>
+        <form onSubmit={saveDisplayName} className="flex flex-col sm:flex-row gap-3 sm:items-end">
+          <div className="flex-1">
+            <label htmlFor={displayNameId} className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id={displayNameId}
+              type="text"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              autoComplete="name"
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={savingName}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+          >
+            {savingName ? 'Saving…' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      <section className="bg-white border border-gray-200 rounded-lg shadow-sm p-6" aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800 mb-1">Passkeys</h2>
+            <p className="text-sm text-gray-600">
+              Passkeys let you sign in with your fingerprint, face, screen lock or a security key.
+            </p>
+          </div>
+          {canCreate && (
+            <button
+              type="button"
+              onClick={createPasskey}
+              disabled={creating}
+              className="inline-flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+            >
+              <KeyIcon className="size-4" aria-hidden="true" />
+              {creating ? 'Creating…' : 'Create passkey'}
+            </button>
+          )}
+        </div>
+
+        {passkeys === null ? (
+          <p className="text-sm text-gray-500">Loading passkeys…</p>
+        ) : passkeys.length === 0 ? (
+          <p className="text-sm text-gray-500 border border-dashed border-gray-300 rounded-md p-6 text-center">
+            No passkeys found.
+            {!canCreate && ' This browser does not support creating passkeys.'}
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="flex flex-wrap items-center gap-4 p-4">
+                {passkey.providerIcon ? (
+                  <img src={passkey.providerIcon} alt="" width={32} height={32} className="size-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="size-8 shrink-0 text-gray-500" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-48">
+                  {editingId === passkey.id ? (
+                    <form onSubmit={(e) => renamePasskey(e, passkey)} className="flex gap-2">
+                      <input
+                        name="name"
+                        defaultValue={passkey.name}
+                        aria-label="Passkey name"
+                        required
+                        maxLength={64}
+                        autoFocus
+                        onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                        className="flex-1 px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button type="submit" className="px-3 py-1 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800">
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-900">
+                      {passkey.name}
+                      {passkey.credentialBackedUp && (
+                        <span className="ml-2 align-middle text-xs font-medium text-gray-600 bg-gray-100 rounded px-1.5 py-0.5">
+                          Synced
+                        </span>
+                      )}
+                    </p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-1">
+                    Created {dateFormat.format(passkey.registeredAt)} ·{' '}
+                    {passkey.lastUsedAt ? `Last used ${dateFormat.format(passkey.lastUsedAt)}` : 'Not used yet'}
+                  </p>
+                </div>
+
+                {editingId !== passkey.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      onClick={() => setEditingId(passkey.id)}
+                      className="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                    >
+                      <PencilSquareIcon className="size-4" aria-hidden="true" />
+                      Rename<span className="sr-only"> {passkey.name}</span>
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setPendingDelete(passkey)}
+                      className="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-sm font-medium text-red-700 border border-red-200 hover:bg-red-50"
+                    >
+                      <TrashIcon className="size-4" aria-hidden="true" />
+                      Remove<span className="sr-only"> {passkey.name}</span>
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        onClose={() => setPendingDelete(null)}
+        aria-labelledby="delete-passkey-heading"
+        className="m-auto max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-black/40"
+      >
+        <h2 id="delete-passkey-heading" className="text-lg font-bold text-gray-900 mb-2">Remove passkey?</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          You will no longer be able to sign in with “{pendingDelete?.name}”. Supported browsers will also remove it from
+          your password manager.
+        </p>
+        <form method="dialog" className="flex justify-end gap-2">
+          <button className="px-4 py-2 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50">
+            Cancel
+          </button>
+          <button
+            type="button"
+            onClick={confirmDelete}
+            className="px-4 py-2 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800"
+          >
+            Remove
+          </button>
+        </form>
+      </dialog>
+    </div>
+  );
+}
