@@ -0,0 +1,126 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID
+  passkeyUserId: string; // Base64URL-encoded WebAuthn user handle of the owner
+  credentialPublicKey: string; // Base64URL-encoded COSE public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export interface AccountUser {
+  id: string; // Base64URL-encoded WebAuthn user handle
+  name: string; // Username used to sign in
+  displayName: string;
+}
+
+export type PublicPasskey = ReturnType<typeof toPublicPasskey>;
+
+// Public keys and counters stay on the server; the UI only needs display fields.
+export function toPublicPasskey(cred: StoredPasskeyCredential) {
+  const { id, name, providerIcon, aaguid, credentialBackedUp, registeredAt, lastUsedAt } = cred;
+  return { id, name, providerIcon, aaguid, credentialBackedUp, registeredAt, lastUsedAt };
+}
+
+interface StoreData {
+  users: Record<string, AccountUser>; // keyed by username
+  credentials: Record<string, StoredPasskeyCredential>; // keyed by credential ID
+}
+
+const DATA_FILE = path.resolve(process.env.PASSKEY_STORE_FILE ?? '.data/passkeys.json');
+
+let cache: StoreData | null = null;
+// Serialize writes so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as StoreData;
+  } catch {
+    cache = { users: {}, credentials: {} };
+  }
+  return cache;
+}
+
+async function persist(data: StoreData) {
+  await mkdir(path.dirname(DATA_FILE), { recursive: true });
+  const tmp = `${DATA_FILE}.tmp`;
+  await writeFile(tmp, JSON.stringify(data, null, 2));
+  await rename(tmp, DATA_FILE);
+}
+
+function mutate<T>(fn: (data: StoreData) => T): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await load();
+    const result = fn(data);
+    await persist(data);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export async function getOrCreateUser(username: string): Promise<AccountUser> {
+  const existing = (await load()).users[username];
+  if (existing) return existing;
+  return mutate((data) => {
+    data.users[username] ??= {
+      id: randomBytes(16).toString('base64url'),
+      name: username,
+      displayName: username,
+    };
+    return data.users[username];
+  });
+}
+
+export function updateUser(username: string, changes: Pick<AccountUser, 'displayName'>) {
+  return mutate((data) => {
+    const user = data.users[username];
+    if (!user) return null;
+    user.displayName = changes.displayName;
+    return user;
+  });
+}
+
+export async function listCredentials(userId: string): Promise<StoredPasskeyCredential[]> {
+  const data = await load();
+  return Object.values(data.credentials)
+    .filter((cred) => cred.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export function saveCredential(credential: StoredPasskeyCredential) {
+  return mutate((data) => {
+    data.credentials[credential.id] = credential;
+    return credential;
+  });
+}
+
+export function renameCredential(userId: string, id: string, name: string) {
+  return mutate((data) => {
+    const cred = data.credentials[id];
+    if (!cred || cred.passkeyUserId !== userId) return null;
+    cred.name = name;
+    return cred;
+  });
+}
+
+export function deleteCredential(userId: string, id: string) {
+  return mutate((data) => {
+    const cred = data.credentials[id];
+    if (!cred || cred.passkeyUserId !== userId) return false;
+    delete data.credentials[id];
+    return true;
+  });
+}
