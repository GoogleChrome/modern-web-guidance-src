@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { json } from '../../lib/auth';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Establishes a local session after the reader signs in. The credentials are
+// re-checked against the upstream login API so the session can't be forged.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const upstream = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  }).catch(() => null);
+
+  if (!upstream?.ok) {
+    return json({ error: 'Invalid credentials' }, 401);
+  }
+
+  await session?.regenerate();
+  session?.set('username', username);
+  return json({ username });
+};
