+import type { APIRoute } from 'astro';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { updateUser } from '../../../lib/passkeys/store';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getSessionUser(session);
+  return user ? json(user) : unauthorized();
+};
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const { displayName } = await request.json().catch(() => ({}));
+  const trimmed = typeof displayName === 'string' ? displayName.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return json({ error: 'Display name must be 1–64 characters' }, 400);
+  }
+
+  return json(await updateUser(user.name, { displayName: trimmed }));
+};
