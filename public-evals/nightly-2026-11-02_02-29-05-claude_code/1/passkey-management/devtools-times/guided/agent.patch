@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, unauthorized } from '../../../../lib/auth';
+import { deleteCredential, renameCredential, toPublicPasskey } from '../../../../lib/passkeys/store';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return json({ error: 'Passkey name must be 1–64 characters' }, 400);
+  }
+
+  const cred = await renameCredential(user.id, params.id!, trimmed);
+  return cred ? json(toPublicPasskey(cred)) : json({ error: 'Passkey not found' }, 404);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const deleted = await deleteCredential(user.id, params.id!);
+  return deleted ? json({ success: true }) : json({ error: 'Passkey not found' }, 404);
+};
