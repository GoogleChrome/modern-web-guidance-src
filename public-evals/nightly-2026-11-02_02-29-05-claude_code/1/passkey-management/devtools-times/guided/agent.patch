+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getRelyingParty, getSessionUser, json, RP_NAME, unauthorized } from '../../../../lib/auth';
+import { listCredentials } from '../../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const existing = await listCredentials(user.id);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRelyingParty(url).rpID,
+    userID: isoBase64URL.toBuffer(user.id),
+    userName: user.name,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map(({ id, transports }) => ({ id, transports })),
+    // No authenticatorAttachment: from settings, security keys are welcome too.
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+  });
+
+  session?.set('registrationChallenge', options.challenge);
+  return json(options);
+};
