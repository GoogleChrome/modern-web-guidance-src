index 0000000..e359123
--- /dev/null
+++ b/src/pages/api/account/passkeys/register-verify.ts
@@ -0,0 +1,56 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getRelyingParty, getSessionUser, json, unauthorized } from '../../../../lib/auth';
+import { lookupProvider } from '../../../../lib/passkeys/aaguid';
+import { saveCredential, toPublicPasskey } from '../../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const expectedChallenge = await session?.get('registrationChallenge');
+  session?.delete('registrationChallenge');
+  if (!expectedChallenge) {
+    return json({ error: 'No registration in progress' }, 400);
+  }
+
+  const { rpID, origin } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: await request.json(),
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserPresence: true,
+      // Options asked for 'preferred' UV, so don't reject authenticators without it.
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+
+  if (!verification.verified) {
+    return json({ error: 'Passkey could not be verified' }, 400);
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const provider = await lookupProvider(aaguid);
+  const saved = await saveCredential({
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.icon,
+    name: provider.name,
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  });
+
+  return json(toPublicPasskey(saved));
+};
