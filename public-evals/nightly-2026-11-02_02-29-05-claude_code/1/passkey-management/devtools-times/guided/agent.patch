diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..ff8bf13
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,25 @@
+import { getOrCreateUser, type AccountUser } from './passkeys/store';
+
+type SessionLike = { get(key: string): Promise<any> } | undefined;
+
+export const RP_NAME = 'The DevTools Times';
+
+/** Returns the signed-in reader's account, or null when nobody is signed in. */
+export async function getSessionUser(session: SessionLike): Promise<AccountUser | null> {
+  const username = await session?.get('username');
+  return typeof username === 'string' && username ? getOrCreateUser(username) : null;
+}
+
+/** The RP ID is the host the reader is on, so passkeys work on every deployment domain. */
+export function getRelyingParty(url: URL) {
+  return { rpID: url.hostname, origin: url.origin };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export const unauthorized = () => json({ error: 'Not signed in' }, 401);
diff --git a/src/lib/passkeys/aaguid.ts b/src/lib/passkeys/aaguid.ts
new file mode 100644
index 0000000..0ad258c
--- /dev/null
+++ b/src/lib/passkeys/aaguid.ts
@@ -0,0 +1,28 @@
+// Community-maintained mapping of authenticator AAGUIDs to provider names/icons.
+// Used purely as a UX hint in the passkey list, never for security decisions.
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registry: Promise<Registry> | null = null;
+
+function loadRegistry(): Promise<Registry> {
+  registry ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then((res) => (res.ok ? (res.json() as Promise<Registry>) : {}))
+    .catch(() => {
+      registry = null; // retry on the next registration
+      return {};
+    });
+  return registry;
+}
+
+export async function lookupProvider(aaguid: string): Promise<{ name: string; icon?: string }> {
+  if (aaguid !== ZERO_AAGUID) {
+    const provider = (await loadRegistry())[aaguid];
+    if (provider) return { name: provider.name, icon: provider.icon_light };
+  }
+  return { name: 'Passkey' };
+}
diff --git a/src/lib/passkeys/store.ts b/src/lib/passkeys/store.ts
