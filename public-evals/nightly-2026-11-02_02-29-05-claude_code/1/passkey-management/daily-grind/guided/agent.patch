+
+  <script type="module">
+    /*
+     * Expected backend contract (session-cookie authenticated):
+     *   GET    /api/user                       -> { id, name, displayName }  (id is the Base64URL WebAuthn user handle)
+     *   PUT    /api/user                       { displayName } -> updated user
+     *   GET    /api/credentials                -> [{ id, name, aaguid, providerIcon?, registeredAt, lastUsedAt? }]
+     *   PUT    /api/credential/:id             { name } -> updated credential
+     *   DELETE /api/credential/:id
+     *   POST   /api/passkey/register/options   -> PublicKeyCredentialCreationOptionsJSON
+     *   POST   /api/passkey/register/verify    credential.toJSON() -> stored credential
+     * All endpoints must only touch the signed-in user's own records.
+     */
+
+    // Must match the RP ID configured on the server.
+    const RP_ID = location.hostname;
+
+    const FALLBACK_ICON = 'data:image/svg+xml,' + encodeURIComponent(
+      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#4e342e"><path d="M12.65 10A6 6 0 1 0 12.65 14H17v4h4v-4h2v-4zM7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>'
+    );
+
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      try {
+        await import('https://esm.run/invokers-polyfill');
+      } catch (e) {
+        console.error('Failed to load invoker commands polyfill:', e);
+      }
+    }
+    if (window.PublicKeyCredential && (!PublicKeyCredential.parseCreationOptionsFromJSON || !PublicKeyCredential.getClientCapabilities)) {
+      try {
+        await import('https://unpkg.com/webauthn-polyfills');
+      } catch (e) {
+        console.error('Failed to load WebAuthn polyfills:', e);
+      }
+    }
+
+    const $ = (id) => document.getElementById(id);
+    const list = $('passkey-list');
+    const rowTemplate = $('passkey-row');
+    const renameDialog = $('rename-dialog');
+    const deleteDialog = $('delete-dialog');
+    const createButton = $('create-passkey');
+
+    const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+    let currentUser = null;
+    let credentials = [];
+    let pendingCredential = null;
+
+    async function api(path, { method = 'GET', body } = {}) {
+      const response = await fetch(path, {
+        method,
+        credentials: 'same-origin',
+        headers: body ? { 'Content-Type': 'application/json' } : undefined,
+        body: body ? JSON.stringify(body) : undefined,
+      });
+      if (response.status === 401) {
+        location.href = '/login?next=' + encodeURIComponent(location.pathname);
+        throw new Error('Not signed in');
+      }
+      if (!response.ok) throw new Error(`${method} ${path} failed (${response.status})`);
+      return response.status === 204 ? null : response.json();
+    }
+
+    function setStatus(id, message, isError = false) {
+      const el = $(id);
+      el.textContent = message;
+      el.classList.toggle('error', isError);
+    }
+
+    // ---- Signal API sync ----
+
+    async function syncAcceptedCredentials() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials || !currentUser) return;
+      try {
+        await PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId: RP_ID,
+          userId: currentUser.id,
+          allAcceptedCredentialIds: credentials.map((c) => c.id),
+        });
+      } catch (e) {
+        console.error('signalAllAcceptedCredentials failed:', e);
+      }
+    }
+
+    async function syncUserDetails() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails || !currentUser) return;
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: RP_ID,
+          userId: currentUser.id,
+          name: currentUser.name,
+          displayName: currentUser.displayName,
+        });
+      } catch (e) {
+        console.error('signalCurrentUserDetails failed:', e);
+      }
+    }
+
+    // ---- Rendering ----
+
+    function renderPasskeys() {
+      const rows = credentials.map((cred) => {
+        const row = rowTemplate.content.firstElementChild.cloneNode(true);
+        const name = cred.name || 'Unknown passkey provider';
+        row.dataset.id = cred.id;
+        row.querySelector('.passkey-icon').src = cred.providerIcon || FALLBACK_ICON;
+        row.querySelector('.passkey-name').textContent = name;
+        row.querySelector('.passkey-created').textContent = `Created ${dateFormat.format(new Date(cred.registeredAt))}`;
+        row.querySelector('.passkey-used').textContent = cred.lastUsedAt
+          ? `Last used ${dateFormat.format(new Date(cred.lastUsedAt))}`
+          : 'Never used';
+        for (const button of row.querySelectorAll('button')) {
+          button.dataset.id = cred.id;
+          button.setAttribute('aria-label', `${button.textContent} ${name}`);
+        }
+        return row;
+      });
+      list.replaceChildren(...rows);
+      list.setAttribute('aria-busy', 'false');
+      $('passkey-empty').hidden = credentials.length > 0;
+    }
+
+    async function loadPasskeys() {
+      credentials = await api('/api/credentials');
+      renderPasskeys();
+    }
+
+    // ---- Profile ----
+
+    $('profile-form').addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const displayName = $('display-name').value.trim();
+      if (!displayName || displayName === currentUser.displayName) return;
+      setStatus('profile-status', 'Saving…');
+      try {
+        currentUser = await api('/api/user', { method: 'PUT', body: { displayName } });
+        $('display-name').value = currentUser.displayName;
+        setStatus('profile-status', 'Display name updated.');
+        await syncUserDetails();
+      } catch (e) {
+        console.error(e);
+        setStatus('profile-status', "We couldn't update your display name. Please try again.", true);
+      }
+    });
+
+    // ---- Rename (server-side label only, no signal needed) ----
+
+    renameDialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      pendingCredential = credentials.find((c) => c.id === event.source?.dataset.id) ?? null;
+      $('rename-input').value = pendingCredential?.name ?? '';
+    });
+
+    renameDialog.addEventListener('close', async () => {
+      const choice = renameDialog.returnValue;
+      renameDialog.returnValue = '';
+      const cred = pendingCredential;
+      pendingCredential = null;
+      const newName = $('rename-input').value.trim();
+      if (choice !== 'save' || !cred || !newName || newName === cred.name) return;
+
+      setStatus('passkey-status', 'Renaming passkey…');
+      try {
+        await api(`/api/credential/${encodeURIComponent(cred.id)}`, { method: 'PUT', body: { name: newName } });
+        await loadPasskeys();
+        setStatus('passkey-status', `Passkey renamed to “${newName}”.`);
+      } catch (e) {
+        console.error(e);
+        setStatus('passkey-status', "We couldn't rename that passkey. Please try again.", true);
+      }
+    });
+
+    // ---- Delete (server, then sync the authenticator) ----
+
+    deleteDialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      pendingCredential = credentials.find((c) => c.id === event.source?.dataset.id) ?? null;
+      $('delete-name').textContent = pendingCredential?.name || 'this passkey';
+      $('delete-last-warning').hidden = credentials.length > 1;
+    });
+
+    deleteDialog.addEventListener('close', async () => {
+      const choice = deleteDialog.returnValue;
+      deleteDialog.returnValue = '';
+      const cred = pendingCredential;
+      pendingCredential = null;
+      if (choice !== 'delete' || !cred) return;
+
+      setStatus('passkey-status', 'Deleting passkey…');
+      try {
+        await api(`/api/credential/${encodeURIComponent(cred.id)}`, { method: 'DELETE' });
+        await loadPasskeys();
+        setStatus('passkey-status', `“${cred.name || 'Passkey'}” was deleted.`);
+        await syncAcceptedCredentials();
+      } catch (e) {
+        console.error(e);
+        setStatus('passkey-status', "We couldn't delete that passkey. Please try again.", true);
+      }
+    });
+
+    // ---- Create passkey ----
+
+    async function setUpCreateButton() {
+      let supported = false;
+      if (window.PublicKeyCredential?.getClientCapabilities) {
+        try {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          supported = Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+        } catch (e) {
+          console.error('getClientCapabilities failed:', e);
+        }
+      }
+      createButton.hidden = !supported;
+      $('passkey-unsupported').hidden = supported;
+    }
+
+    async function signalUnknown(credentialId) {
+      if (!PublicKeyCredential.signalUnknownCredential) return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId: RP_ID, credentialId });
+      } catch (e) {
+        console.error('signalUnknownCredential failed:', e);
+      }
+    }
+
+    createButton.addEventListener('click', async () => {
+      createButton.disabled = true;
+      setStatus('passkey-status', '');
+      try {
+        // Management flow: the server omits authenticatorAttachment so security keys work too.
+        const optionsJSON = await api('/api/passkey/register/options', { method: 'POST' });
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+        let credential;
+        try {
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (err) {
+          if (err.name === 'InvalidStateError') {
+            setStatus('passkey-status', 'You already have a passkey for this account in that password manager.', true);
+          } else if (err.name === 'SecurityError') {
+            console.error('RP ID or secure context misconfiguration:', err);
+            setStatus('passkey-status', "Passkeys aren't available on this page right now.", true);
+          } else if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
