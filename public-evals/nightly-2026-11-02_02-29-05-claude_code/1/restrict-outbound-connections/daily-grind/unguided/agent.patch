@@ -0,0 +1,65 @@
+'use strict';
+
+(function () {
+  var form = document.getElementById('newsletter-form');
+  var status = document.getElementById('newsletter-status');
+  if (!form || !status) return;
+
+  var input = form.elements.email;
+  var button = form.querySelector('button[type="submit"]');
+  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+  function showStatus(message, kind) {
+    status.textContent = message;
+    status.className = 'newsletter-status ' + kind;
+    status.hidden = false;
+  }
+
+  // Requests blocked by the Content-Security-Policy (e.g. to a host other than
+  // our own server) never reach the network; tell the customer instead of failing silently.
+  document.addEventListener('securitypolicyviolation', function (event) {
+    if (event.effectiveDirective === 'connect-src' || event.effectiveDirective === 'form-action') {
+      showStatus('Sorry, that request was blocked and could not go through. Please try again later.', 'error');
+    }
+  });
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    var email = input.value.trim();
+    if (!EMAIL_RE.test(email)) {
+      showStatus('Please enter a valid email address.', 'error');
+      input.focus();
+      return;
+    }
+
+    button.disabled = true;
+    status.hidden = true;
+
+    fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ email: email }),
+      credentials: 'same-origin'
+    })
+      .then(function (res) {
+        return res.json().catch(function () { return {}; }).then(function (data) {
+          if (!res.ok) {
+            throw new Error(data.error || 'Request failed');
+          }
+          showStatus(data.message || 'Thanks for subscribing!', 'success');
+          form.reset();
+        });
+      })
+      .catch(function (err) {
+        // A TypeError means the request never completed (offline, server down, or blocked).
+        var message = err instanceof TypeError
+          ? 'Sorry, we couldn’t reach our server. Please check your connection and try again.'
+          : err.message;
+        showStatus(message, 'error');
+      })
+      .finally(function () {
+        button.disabled = false;
+      });
+  });
+})();
