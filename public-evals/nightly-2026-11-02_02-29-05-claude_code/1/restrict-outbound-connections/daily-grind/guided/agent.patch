+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section class="newsletter" aria-labelledby="newsletter-title">
+      <h2 id="newsletter-title">Join the Daily Grind Newsletter</h2>
+      <p>New roasts, seasonal drinks, and member-only offers, about twice a month.</p>
+      <form id="newsletter-form" class="newsletter-form" action="/api/newsletter" method="POST">
+        <div class="field">
+          <label for="newsletter-email">Email address</label>
+          <span id="newsletter-email-hint" class="hint">Format: you@example.com</span>
+          <div class="newsletter-row">
+            <input type="email" id="newsletter-email" name="email" required maxlength="254"
+              autocomplete="email" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="send"
+              aria-describedby="newsletter-email-hint" aria-errormessage="newsletter-email-error">
+            <button type="submit" class="btn">Subscribe</button>
+          </div>
+          <div id="newsletter-email-error" class="error-msg">
+            <span aria-hidden="true">&#10060;</span> Please enter a valid email address.
+          </div>
+        </div>
+        <p id="newsletter-status" class="form-status" role="status" aria-live="polite"></p>
+      </form>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
