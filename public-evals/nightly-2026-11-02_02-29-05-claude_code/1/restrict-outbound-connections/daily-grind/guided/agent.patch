@@ -0,0 +1,252 @@
+// Small dependency-free server for the Daily Grind homepage.
+// It serves the static site, accepts newsletter signups, and sets the response
+// headers that limit which servers the page is allowed to talk to.
+import { createServer } from 'node:http';
+import { appendFile, mkdir, readFile } from 'node:fs/promises';
+import { extname, join, normalize, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const PUBLIC_DIR = resolve(ROOT, 'public');
+const DATA_DIR = resolve(ROOT, 'data');
+const SUBSCRIBERS_FILE = join(DATA_DIR, 'subscribers.ndjson');
+const PORT = Number(process.env.PORT) || 11222;
+const HOST = process.env.HOST || '0.0.0.0';
+
+// The only third-party origin the page may contact (hero photo).
+const PHOTO_ORIGIN = 'https://images.unsplash.com';
+const REPORT_ENDPOINT = 'security';
+const MAX_SIGNUP_BYTES = 4 * 1024;
+const MAX_REPORT_BYTES = 64 * 1024;
+
+const SECURITY_HEADERS = {
+  'Reporting-Endpoints': `${REPORT_ENDPOINT}="/api/security-reports"`,
+  // Network-layer allowlist for every outbound connection (fetch, beacons,
+  // subresources, navigations, preconnect, WebRTC, ...). Supported in Chromium.
+  'Connection-Allowlist': `(response-origin "${PHOTO_ORIGIN}"); report-to=${REPORT_ENDPOINT}`,
+  // Fallback for browsers without Connection-Allowlist. No 'unsafe-inline':
+  // styles and scripts are served as same-origin files.
+  'Content-Security-Policy': [
+    "default-src 'self'",
+    "script-src 'self'",
+    "style-src 'self'",
+    `img-src 'self' ${PHOTO_ORIGIN}`,
+    "connect-src 'self'",
+    "font-src 'self'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "frame-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    `report-to ${REPORT_ENDPOINT}`,
+  ].join('; '),
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-Content-Type-Options': 'nosniff',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+};
+
+const CONTENT_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+};
+
+// Pragmatic email check; the browser's type="email" check is client-side only.
+const EMAIL_PATTERN = /^[^\s@<>"]+@[^\s@<>".]+(\.[^\s@<>".]+)+$/;
+
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function send(res, status, body, contentType, extraHeaders = {}) {
+  res.writeHead(status, {
+    ...SECURITY_HEADERS,
+    'Content-Type': contentType,
+    'Content-Length': Buffer.byteLength(body),
+    ...extraHeaders,
+  });
+  res.end(body);
+}
+
+function sendJson(res, status, data) {
+  send(res, status, JSON.stringify(data), 'application/json; charset=utf-8', { 'Cache-Control': 'no-store' });
+}
+
+function escapeHtml(text) {
+  return text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+// Response page for signups submitted without JavaScript.
+function sendSignupPage(res, status, message) {
+  const html = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Newsletter | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container newsletter">
+    <h1>${status < 400 ? 'Thanks for subscribing!' : "We couldn't sign you up"}</h1>
+    <p>${escapeHtml(message)}</p>
+    <a href="/" class="btn">Back to the homepage</a>
+  </main>
+</body>
+</html>`;
+  send(res, status, html, 'text/html; charset=utf-8', { 'Cache-Control': 'no-store' });
+}
+
+function readBody(req, limit) {
+  return new Promise((resolveBody, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > limit) {
+        reject(new HttpError(413, 'Request is too large.'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolveBody(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+// Reject cross-site submissions so other sites can't post on a customer's behalf.
+function assertSameOrigin(req) {
+  const fetchSite = req.headers['sec-fetch-site'];
+  if (fetchSite && fetchSite !== 'same-origin' && fetchSite !== 'none') {
+    throw new HttpError(403, 'Cross-site requests are not allowed.');
+  }
+  const origin = req.headers.origin;
+  if (origin && origin !== 'null') {
+    let originHost;
+    try {
+      originHost = new URL(origin).host;
+    } catch {
+      throw new HttpError(403, 'Cross-site requests are not allowed.');
+    }
+    if (originHost !== req.headers.host) {
+      throw new HttpError(403, 'Cross-site requests are not allowed.');
+    }
+  }
+}
+
+function parseSignup(req, raw) {
+  const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  if (type === 'application/json') {
+    try {
+      return JSON.parse(raw);
+    } catch {
+      throw new HttpError(400, 'Request body is not valid JSON.');
+    }
+  }
+  if (type === 'application/x-www-form-urlencoded') {
+    return Object.fromEntries(new URLSearchParams(raw));
+  }
+  throw new HttpError(415, 'Unsupported content type.');
+}
+
+async function handleSignup(req, res) {
+  const wantsJson = (req.headers.accept || '').includes('application/json');
+  try {
+    assertSameOrigin(req);
+    const body = parseSignup(req, await readBody(req, MAX_SIGNUP_BYTES));
+    const email = typeof body?.email === 'string' ? body.email.trim().toLowerCase() : '';
+    if (email.length > 254 || !EMAIL_PATTERN.test(email)) {
+      throw new HttpError(422, 'Please enter a valid email address.');
+    }
+
+    await mkdir(DATA_DIR, { recursive: true });
+    await appendFile(SUBSCRIBERS_FILE, `${JSON.stringify({ email, subscribedAt: new Date().toISOString() })}\n`);
+
+    const message = "You're on the list! Look out for our next newsletter in your inbox.";
+    if (wantsJson) sendJson(res, 201, { ok: true, message });
+    else sendSignupPage(res, 201, message);
+  } catch (error) {
+    const status = error instanceof HttpError ? error.status : 500;
+    const message = status < 500 ? error.message : "Something went wrong on our end. Please try again later.";
+    if (status >= 500) console.error('Newsletter signup failed:', error);
+    if (wantsJson) sendJson(res, status, { ok: false, error: message });
+    else sendSignupPage(res, status, message);
+  }
+}
+
+// Receives Connection-Allowlist and CSP violation reports from the browser.
+async function handleSecurityReport(req, res) {
+  try {
+    const raw = await readBody(req, MAX_REPORT_BYTES);
+    console.warn('Security policy violation report:', raw);
+    res.writeHead(204, SECURITY_HEADERS);
+    res.end();
+  } catch (error) {
+    sendJson(res, error instanceof HttpError ? error.status : 400, { ok: false });
+  }
+}
+
+async function serveStatic(req, res, pathname) {
+  let filePath;
+  try {
+    const relative = normalize(decodeURIComponent(pathname === '/' ? '/index.html' : pathname));
+    filePath = resolve(PUBLIC_DIR, `.${relative}`);
+  } catch {
+    throw new HttpError(400, 'Bad request');
+  }
+  if (!filePath.startsWith(PUBLIC_DIR + sep)) throw new HttpError(404, 'Not found');
+
+  let data;
+  try {
+    data = await readFile(filePath);
+  } catch {
+    throw new HttpError(404, 'Not found');
+  }
+  const contentType = CONTENT_TYPES[extname(filePath)] || 'application/octet-stream';
+  res.writeHead(200, {
+    ...SECURITY_HEADERS,
+    'Content-Type': contentType,
+    'Content-Length': data.length,
+    'Cache-Control': contentType.startsWith('text/html') ? 'no-cache' : 'public, max-age=3600',
+  });
+  res.end(req.method === 'HEAD' ? undefined : data);
+}
+
+const server = createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, 'http://localhost');
+  try {
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') throw new HttpError(405, 'Method not allowed');
+      return await handleSignup(req, res);
+    }
+    if (pathname === '/api/security-reports') {
+      if (req.method !== 'POST') throw new HttpError(405, 'Method not allowed');
+      return await handleSecurityReport(req, res);
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') throw new HttpError(405, 'Method not allowed');
+    return await serveStatic(req, res, pathname);
+  } catch (error) {
+    const status = error instanceof HttpError ? error.status : 500;
+    if (status >= 500) console.error(error);
+    if (!res.headersSent) {
+      send(res, status, status >= 500 ? 'Internal server error' : error.message, 'text/plain; charset=utf-8',
+        status === 405 ? { Allow: pathname.startsWith('/api/') ? 'POST' : 'GET, HEAD' } : {});
+    } else {
+      res.destroy();
+    }
+  }
+});
+
+server.listen(PORT, HOST, () => {
+  console.log(`Daily Grind running at http://localhost:${PORT}`);
+});
