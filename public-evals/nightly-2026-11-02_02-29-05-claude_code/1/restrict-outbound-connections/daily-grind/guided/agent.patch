index 0000000..bcd4cde
--- /dev/null
+++ b/public/newsletter.js
@@ -0,0 +1,90 @@
+// Newsletter signup: submits to our own server and tells the customer when a
+// request can't go through (offline, blocked by the page's connection policy,
+// timed out, or rejected by the server).
+const REQUEST_TIMEOUT_MS = 10000;
+
+const MESSAGES = {
+  pending: 'Signing you up…',
+  success: "You're on the list! Look out for our next newsletter in your inbox.",
+  offline: "You appear to be offline. Please check your connection and try again.",
+  network: "We couldn't reach our server, so your signup didn't go through. Please try again in a moment.",
+  timeout: 'Our server took too long to respond, so your signup may not have gone through. Please try again.',
+  server: 'Something went wrong on our end and your signup didn\'t go through. Please try again later.',
+};
+
+const form = document.getElementById('newsletter-form');
+const emailInput = document.getElementById('newsletter-email');
+const status = document.getElementById('newsletter-status');
+const submitButton = form.querySelector('button[type="submit"]');
+
+function setStatus(state, message) {
+  status.dataset.state = state;
+  status.textContent = message;
+}
+
+// Keep aria-invalid in sync with the visual :user-invalid state.
+function syncAriaInvalid() {
+  if (emailInput.matches(':user-invalid')) {
+    emailInput.setAttribute('aria-invalid', 'true');
+  } else {
+    emailInput.removeAttribute('aria-invalid');
+  }
+}
+
+emailInput.addEventListener('blur', syncAriaInvalid);
+emailInput.addEventListener('input', () => {
+  if (emailInput.hasAttribute('aria-invalid')) syncAriaInvalid();
+});
+emailInput.addEventListener('invalid', syncAriaInvalid);
+
+async function readServerMessage(response) {
+  try {
+    const data = await response.json();
+    return typeof data.error === 'string' ? data.error : null;
+  } catch {
+    return null;
+  }
+}
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+
+  if (!navigator.onLine) {
+    setStatus('error', MESSAGES.offline);
+    return;
+  }
+
+  submitButton.disabled = true;
+  setStatus('pending', MESSAGES.pending);
+
+  try {
+    const response = await fetch(form.action, {
+      method: 'POST',
+      headers: { Accept: 'application/json' },
+      body: new URLSearchParams(new FormData(form)),
+      credentials: 'same-origin',
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+
+    if (!response.ok) {
+      // 4xx responses carry a customer-facing reason (e.g. invalid email).
+      const reason = response.status < 500 ? await readServerMessage(response) : null;
+      setStatus('error', reason ?? MESSAGES.server);
+      return;
+    }
+
+    setStatus('success', MESSAGES.success);
+    form.reset();
+    emailInput.removeAttribute('aria-invalid');
+  } catch (error) {
+    // fetch() rejects with a TypeError when the request is blocked by
+    // Connection-Allowlist/CSP or the network is down.
+    if (error.name === 'TimeoutError') {
+      setStatus('error', MESSAGES.timeout);
+    } else {
+      setStatus('error', navigator.onLine ? MESSAGES.network : MESSAGES.offline);
+    }
+  } finally {
+    submitButton.disabled = false;
+  }
+});
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..873936c
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,259 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-top: 40px;
+  padding: 30px 20px;
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 0.5rem;
+}
+
+.newsletter-form {
+  max-width: 480px;
+  margin: 20px auto 0;
+  text-align: start;
+}
+
+.newsletter-form label {
+  display: block;
+  font-weight: 600;
+}
+
+.hint {
+  display: block;
+  color: #5d4037;
+  font-size: 0.85rem;
+  margin-bottom: 0.25rem;
+}
+
+.newsletter-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+
+.newsletter-row input {
+  flex: 1 1 220px;
+  font-size: 1rem;
+  min-height: 48px;
+  padding: 0.75rem;
+  border: 1px solid #8d6e63;
+  border-radius: 5px;
+}
+
+.newsletter-row input:focus-visible,
+.newsletter-row .btn:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.newsletter-row .btn {
+  margin-top: 0;
+  min-height: 48px;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-row .btn:disabled {
+  opacity: 0.7;
+  cursor: progress;
+}
+
+.error-msg {
+  display: none;
+  color: #b3261e;
+  font-size: 0.875rem;
+  margin-top: 0.25rem;
+}
+
+.newsletter-row input:user-invalid {
+  border-color: #b3261e;
+  background-color: #fce8e6;
+}
+
+.field:has(input:user-invalid) .error-msg {
+  display: block;
+}
+
+.form-status:empty {
+  display: none;
+}
+
+.form-status {
+  margin-top: 1rem;
+  padding: 0.75rem 1rem;
+  border-radius: 5px;
+  border-inline-start: 4px solid currentColor;
+}
+
+.form-status[data-state="success"] {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.form-status[data-state="error"] {
+  background: #fce8e6;
+  color: #b3261e;
+}
+
+.form-status[data-state="pending"] {
+  background: var(--secondary);
+  color: var(--text);
+}
