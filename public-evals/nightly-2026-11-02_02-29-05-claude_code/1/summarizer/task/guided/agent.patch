+  <script type="module">
+    const button = document.getElementById('summarize-btn');
+    const status = document.getElementById('summary-status');
+    const list = document.getElementById('summary-list');
+    const journalText = document.getElementById('journal-body').innerText;
+
+    // Options must match between availability() and create()
+    const options = {
+      sharedContext: "A coffee roaster's journal entry about how they source their beans",
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    let summarizer;
+
+    function renderBullets(text) {
+      const items = text
+        .split('\n')
+        .map((line) => line.replace(/^\s*(?:[-*\u2022]|\d+[.)])\s*/, '').trim())
+        .filter(Boolean);
+      list.replaceChildren(...items.map((item) => {
+        const li = document.createElement('li');
+        li.textContent = item;
+        return li;
+      }));
+    }
+
+    async function init() {
+      if (!('Summarizer' in self)) {
+        status.textContent = 'On-device summarization is not supported in this browser.';
+        return;
+      }
+      const availability = await Summarizer.availability(options);
+      if (availability === 'unavailable') {
+        status.textContent = 'On-device summarization is unavailable on this device.';
+        return;
+      }
+      if (availability !== 'available') {
+        status.textContent = 'The first summary will download an on-device AI model.';
+      }
+      button.disabled = false;
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      list.replaceChildren();
+      try {
+        // create() must run inside the click handler so a model download has a user gesture
+        summarizer ??= await Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading AI model… ${Math.round((e.loaded / e.total) * 100)}%`;
+            });
+          },
+        });
+        status.textContent = 'Summarizing…';
+        let summary = '';
+        for await (const chunk of summarizer.summarizeStreaming(journalText)) {
+          summary += chunk;
+          renderBullets(summary);
+        }
+        status.textContent = '';
+        button.textContent = 'Summarize again';
+      } catch (err) {
+        console.error(err);
+        status.textContent = 'Sorry, the summary could not be generated.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    init().catch((err) => {
+      console.error(err);
+      status.textContent = 'On-device summarization is unavailable.';
+    });
+  </script>
+
 </body>
 
