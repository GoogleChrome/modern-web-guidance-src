+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const output = document.getElementById('summary-output');
+      const source = document.getElementById('journal-text');
+      const options = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: "A coffee roaster's blog post about how they source their beans.",
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+      let summarizerPromise;
+
+      if (!('Summarizer' in self)) {
+        button.disabled = true;
+        status.textContent = "Your browser doesn't support on-device AI summaries yet.";
+        return;
+      }
+
+      Summarizer.availability(options).then((availability) => {
+        if (availability === 'unavailable') {
+          button.disabled = true;
+          status.textContent = "On-device AI summaries aren't available on this device.";
+        }
+      });
+
+      function getSummarizer() {
+        // create() must run inside the click handler since it may need user activation to download the model.
+        summarizerPromise ??= Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading AI model… ${Math.round(e.loaded * 100)}%`;
+            });
+          }
+        }).catch((err) => {
+          summarizerPromise = undefined;
+          throw err;
+        });
+        return summarizerPromise;
+      }
+
+      function renderPoints(markdown) {
+        const points = markdown
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+\.)\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').trim())
+          .filter(Boolean);
+        output.replaceChildren(...points.map((point) => {
+          const li = document.createElement('li');
+          li.textContent = point;
+          return li;
+        }));
+        output.hidden = points.length === 0;
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        status.textContent = 'Summarizing…';
+        try {
+          const summarizer = await getSummarizer();
+          status.textContent = 'Summarizing…';
+          const text = source.innerText.replace(/\s+/g, ' ').trim();
+          renderPoints(await summarizer.summarize(text));
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          status.textContent = "Sorry, we couldn't summarize this right now.";
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
