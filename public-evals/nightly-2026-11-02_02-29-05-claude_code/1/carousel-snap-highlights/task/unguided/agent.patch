+  <script>
+    // Mark the carousel item closest to the center as snapped
+    document.querySelectorAll('.carousel').forEach((carousel) => {
+      const items = [...carousel.querySelectorAll('.carousel-item')];
+      let frame = null;
+
+      const updateSnapped = () => {
+        frame = null;
+        const rect = carousel.getBoundingClientRect();
+        const center = rect.left + rect.width / 2;
+        let closest = null;
+        let closestDistance = Infinity;
+        items.forEach((item) => {
+          const itemRect = item.getBoundingClientRect();
+          const distance = Math.abs(itemRect.left + itemRect.width / 2 - center);
+          if (distance < closestDistance) {
+            closestDistance = distance;
+            closest = item;
+          }
+        });
+        items.forEach((item) => item.classList.toggle('is-snapped', item === closest));
+      };
+
+      const scheduleUpdate = () => {
+        if (frame === null) frame = requestAnimationFrame(updateSnapped);
+      };
+
+      carousel.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      updateSnapped();
+    });
+  </script>
+
