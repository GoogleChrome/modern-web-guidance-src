+    /* Main layout: Seasonal Favorites + Loyalty Rewards */
+    .main-layout {
+      display: grid;
+      grid-template-columns: minmax(0, 1fr) 300px;
+      gap: 30px;
+      align-items: start;
+    }
+
+    @media (max-width: 900px) {
+      .main-layout {
+        grid-template-columns: 1fr;
+      }
+    }
+
+    /* Loyalty Rewards */
+    .rewards {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      border-top: 4px solid var(--accent);
+      padding: 25px 20px;
+      text-align: center;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+    }
+
+    .rewards-intro {
+      font-size: 0.9rem;
+      margin-bottom: 20px;
+    }
+
+    .ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: fit-content;
+      margin: 0 auto;
+    }
+
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    progress.progress-ring {
+      --size: 190px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--primary);
+      --value: attr(value type(<number>));
+      --max: attr(max type(<number>));
+      appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) / var(--max) * 100%),
+        var(--track-color) 0
+      );
+      background-clip: border-area;
+      background-origin: border-box;
+      border: var(--thickness) solid transparent;
+      transition: --value 0s ease-in-out;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition-duration: 0.6s;
+      }
+
+      @supports not (background-clip: border-area) {
+        mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+        border: 0;
+      }
+    }
+
+    progress.progress-ring::-webkit-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    .ring-content {
+      position: absolute;
+      display: grid;
+      line-height: 1.2;
+      color: var(--text);
+    }
+
+    .ring-count {
+      font-size: 2.25rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .ring-count span {
+      font-size: 1.1rem;
+      font-weight: normal;
+      color: var(--text);
+    }
+
+    .ring-label {
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+    }
+
+    .ring-remaining {
+      margin-top: 6px;
+      font-size: 0.8rem;
+      font-weight: bold;
+      color: #b26a00;
+    }
+
+    .rewards-note {
+      margin-top: 20px;
+      font-size: 0.85rem;
+    }
+
