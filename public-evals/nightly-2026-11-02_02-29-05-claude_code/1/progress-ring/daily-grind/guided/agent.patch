+  <script>
+    // Fallback for browsers without CSS attr() typed values: mirror value/max into custom properties.
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      document.querySelectorAll("progress.progress-ring").forEach((progress) => {
+        const sync = () => {
+          progress.style.setProperty("--value", progress.getAttribute("value"));
+          progress.style.setProperty("--max", progress.getAttribute("max"));
+        };
+        sync();
+        new MutationObserver(sync).observe(progress, {
+          attributes: true,
+          attributeFilter: ["value", "max"],
+        });
+      });
+    }
+  </script>
