+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.75rem;
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      display: grid;
+      gap: 20px;
+      align-content: start;
+    }
+
+    #animated section {
+      aspect-ratio: 4 / 5;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    @keyframes story-in {
+      from {
+        opacity: 0;
+        scale: 0.9;
+        translate: 0 40px;
+      }
+    }
+
+    @keyframes story-out {
+      to {
+        opacity: 0;
+        scale: 1.05;
+      }
+    }
+
+    @keyframes story-fade-in {
+      from {
+        opacity: 0;
+      }
+    }
+
+    @keyframes story-fade-out {
+      to {
+        opacity: 0;
+      }
+    }
+
+    /* Progressive enhancement: without scroll-driven animation support,
+       the images simply render in normal flow beside the text. */
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      /* Hoist the timeline names so the sibling #animated branch can use them */
+      .story-layout {
+        timeline-scope: --story-1, --story-2, --story-3, --story-4;
+      }
+
+      #tracked section {
+        /* Collapse the tracking area to a line across the middle of the
+           viewport, so each timeline covers exactly the time its text
+           section crosses the center and timelines hand off seamlessly. */
+        view-timeline-inset: 50% 50%;
+      }
+
+      #tracked section:nth-child(1) { view-timeline-name: --story-1; }
+      #tracked section:nth-child(2) { view-timeline-name: --story-2; }
+      #tracked section:nth-child(3) { view-timeline-name: --story-3; }
+      #tracked section:nth-child(4) { view-timeline-name: --story-4; }
+
+      #animated {
+        position: sticky;
+        top: 90px;
+        align-self: start;
+        height: min(70vh, calc(100vh - 120px));
+        grid-template-rows: 100%;
+      }
+
+      #animated section {
+        grid-area: 1 / 1;
+        aspect-ratio: auto;
+        animation: story-in auto linear both, story-out auto linear both;
+        animation-range: cover 0% cover 15%, cover 85% cover 100%;
+        backface-visibility: hidden;
+
+        /* Crossfade only, no movement */
+        @media (prefers-reduced-motion: reduce) {
+          animation-name: story-fade-in, story-fade-out;
+        }
+      }
+
+      /* Keep the first image visible before the story starts,
+         and the last one visible after it ends */
+      #animated section:first-child { animation-name: none, story-out; }
+      #animated section:last-child { animation-name: story-in, none; }
+
+      @media (prefers-reduced-motion: reduce) {
+        #animated section:first-child { animation-name: none, story-fade-out; }
+        #animated section:last-child { animation-name: story-fade-in, none; }
+      }
+
+      /* Declared after the animation shorthand so it isn't reset */
+      #animated section:nth-child(1) { animation-timeline: --story-1; }
+      #animated section:nth-child(2) { animation-timeline: --story-2; }
+      #animated section:nth-child(3) { animation-timeline: --story-3; }
+      #animated section:nth-child(4) { animation-timeline: --story-4; }
+    }
+
+    @media (max-width: 700px) {
+      .story-layout {
+        grid-template-columns: 1fr;
+      }
+
+      #animated {
+        grid-row: 1;
+      }
+
+      @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+        #animated {
+          top: 70px;
+          height: 35vh;
+          z-index: 1;
+        }
+
+        #tracked section {
+          /* Track a line below the sticky image instead of the center */
+          view-timeline-inset: 65% 35%;
+          min-height: 50vh;
+          justify-content: flex-start;
+          padding-top: 5vh;
+        }
+      }
+    }
+
