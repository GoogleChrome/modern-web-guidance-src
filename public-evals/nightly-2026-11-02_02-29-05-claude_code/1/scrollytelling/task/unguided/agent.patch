+    #tracked section:nth-child(3) { view-timeline-name: --step-3; }
+    #tracked section:nth-child(4) { view-timeline-name: --step-4; }
+
+    #tracked .step-label {
+      color: var(--accent);
+      font-size: 0.8rem;
+      font-weight: bold;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.8rem;
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      display: grid;
+      gap: 20px;
+      align-content: start;
+    }
+
+    #animated section {
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
+      aspect-ratio: 4 / 3;
+      background: var(--secondary);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    @supports (timeline-scope: --a) and (animation-timeline: view()) {
+      #animated {
+        position: sticky;
+        top: calc(20vh + 30px); /* vertically centred below the sticky nav */
+        height: 60vh;
+        display: block;
+      }
+
+      #animated section {
+        position: absolute;
+        inset: 0;
+        aspect-ratio: auto;
+        opacity: 0;
+        /* Only opacity/transform: compositor-friendly, no layout or paint */
+        will-change: opacity, transform;
+        animation: reveal linear both;
+        animation-range: cover 0% cover 100%;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --step-1; }
+      #animated section:nth-child(2) { animation-timeline: --step-2; }
+      #animated section:nth-child(3) { animation-timeline: --step-3; }
+      #animated section:nth-child(4) { animation-timeline: --step-4; }
+
+      @keyframes reveal {
+        0%, 20% {
+          opacity: 0;
+          transform: translateY(40px) scale(0.95);
+        }
+        40%, 60% {
+          opacity: 1;
+          transform: none;
+        }
+        80%, 100% {
+          opacity: 0;
+          transform: translateY(-40px) scale(0.95);
+        }
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        @keyframes reveal {
+          0%, 25% { opacity: 0; }
+          40%, 60% { opacity: 1; }
+          75%, 100% { opacity: 0; }
+        }
+      }
+    }
+
+    @media (max-width: 760px) {
+      .scrolly {
+        grid-template-columns: 1fr;
+        gap: 0;
+      }
+
+      #animated {
+        grid-row: 1;
+      }
+
+      #tracked {
+        grid-row: 2;
+      }
+
+      @supports (timeline-scope: --a) and (animation-timeline: view()) {
+        #animated {
+          top: 70px;
+          height: 35vh;
+          z-index: 1;
+        }
+
+        #tracked {
+          /* Let the text flow up beneath the sticky media panel */
+          margin-top: -35vh;
+        }
+
+        #tracked section {
+          min-height: 90vh;
+          justify-content: flex-end;
+          padding-bottom: 15vh;
+        }
+
+        #tracked section > * {
+          position: relative;
+          z-index: 2;
+        }
+
+        #tracked section div {
+          background: rgba(250, 250, 250, 0.95);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        }
+      }
+    }
   </style>
