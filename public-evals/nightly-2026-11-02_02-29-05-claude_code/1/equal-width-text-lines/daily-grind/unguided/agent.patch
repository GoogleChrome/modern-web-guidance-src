+  <script>
+    // Scale each lockup line's font-size so its text width matches the heading width.
+    (function () {
+      var REF = 100;
+
+      function fit(lockup) {
+        var target = lockup.clientWidth;
+        if (!target) return;
+        lockup.dataset.fitWidth = target;
+        lockup.querySelectorAll('.line').forEach(function (line) {
+          line.style.fontSize = REF + 'px';
+          var natural = line.getBoundingClientRect().width;
+          if (natural) line.style.fontSize = (REF * target / natural) + 'px';
+        });
+      }
+
+      function fitAll() {
+        document.querySelectorAll('.lockup').forEach(fit);
+      }
+
+      fitAll();
+      if (document.fonts) document.fonts.ready.then(fitAll);
+      if ('ResizeObserver' in window) {
+        // Only refit on width changes; refitting itself changes the height.
+        var ro = new ResizeObserver(function (entries) {
+          entries.forEach(function (entry) {
+            if (String(entry.target.clientWidth) !== entry.target.dataset.fitWidth) fit(entry.target);
+          });
+        });
+        document.querySelectorAll('.lockup').forEach(function (el) { ro.observe(el); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+    })();
+  </script>
+
 </body>
 
