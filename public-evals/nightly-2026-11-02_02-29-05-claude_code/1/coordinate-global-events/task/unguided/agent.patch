+  <script type="module">
+    // Uses the native Temporal API. Browsers that don't ship it yet get a
+    // spec-compliant polyfill loaded on demand.
+    if (typeof globalThis.Temporal === 'undefined') {
+      await import('https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/global.min.js');
+    }
+    const { Temporal } = globalThis;
+
+    const TARGET_ZONES = Object.freeze([
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ]);
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    // Built from Temporal fields so output is "3:00 AM" regardless of engine Intl quirks.
+    const formatTime = ({ hour, minute }) =>
+      `${hour % 12 || 12}:${String(minute).padStart(2, '0')} ${hour < 12 ? 'AM' : 'PM'}`;
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Defaults: today in the visitor's zone, and their zone as host if we list it.
+    const localZone = Temporal.Now.timeZoneId();
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+    if ([...hostTzSelect.options].some((o) => o.value === localZone)) {
+      hostTzSelect.value = localZone;
+    }
+
+    /**
+     * Resolve a wall-clock date-time in a zone, detecting DST gaps and overlaps.
+     * Temporal objects are immutable; each step below returns a fresh object.
+     */
+    function resolveHostTime(plainDateTime, timeZone) {
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      // 'compatible' matches legacy behaviour: earlier offset in overlaps, shift forward in gaps.
+      const resolved = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+
+      if (earlier.epochNanoseconds === later.epochNanoseconds) {
+        return { resolved, conflict: null };
+      }
+
+      const requestedIsReal = Temporal.PlainDateTime.compare(earlier.toPlainDateTime(), plainDateTime) === 0
+        && Temporal.PlainDateTime.compare(later.toPlainDateTime(), plainDateTime) === 0;
+
+      return {
+        resolved,
+        conflict: {
+          type: requestedIsReal ? 'overlap' : 'gap',
+          earlier,
+          later,
+        },
+      };
+    }
+
+    function describeConflict(conflict, requested, resolved, timeZone) {
+      const reqTime = formatTime(requested);
+      const reqDate = requested.toPlainDate().toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
+      const resTime = formatTime(resolved);
+
+      if (conflict.type === 'gap') {
+        const mins = Math.round(
+          Number(conflict.later.epochNanoseconds - conflict.earlier.epochNanoseconds) / 6e10);
+        return `<strong>Nonexistent time:</strong> ${reqTime} on ${reqDate} doesn't exist in ${timeZone} &mdash; `
+          + `clocks spring forward ${mins} minutes for daylight saving time, skipping over it. `
+          + `The tasting has been moved forward to <strong>${resTime}</strong> (UTC${resolved.offset}), `
+          + `the same moment the clock would have read ${reqTime} without the change.`;
+      }
+
+      const repeatMins = Math.round(
+        Number(conflict.later.epochNanoseconds - conflict.earlier.epochNanoseconds) / 6e10);
+      return `<strong>Ambiguous time:</strong> ${reqTime} on ${reqDate} occurs twice in ${timeZone} because clocks `
+        + `fall back at the end of daylight saving time. We've used the <strong>first occurrence</strong> `
+        + `(UTC${conflict.earlier.offset}). The clock reads ${reqTime} again ${repeatMins} minutes later `
+        + `(UTC${conflict.later.offset}), so double-check with your guests which one they're joining.`;
+    }
+
+    function renderCard({ id, label }, zoned, hostZone, hostDate) {
+      const card = document.createElement('div');
+      card.className = 'card tz-card' + (id === hostZone ? ' is-host' : '');
+
+      const dayDiff = zoned.toPlainDate().since(hostDate, { largestUnit: 'day' }).days;
+      const dayNote = dayDiff === 0 ? '' : ` (${dayDiff > 0 ? '+' : ''}${dayDiff} day${Math.abs(dayDiff) === 1 ? '' : 's'})`;
+
+      card.innerHTML = `
+        <h3></h3>
+        <div class="tz-time"></div>
+        <div class="tz-meta"></div>
+        ${id === hostZone ? '<span class="tz-badge">Host</span>' : ''}
+      `;
+      card.querySelector('h3').textContent = label;
+      card.querySelector('.tz-time').textContent = formatTime(zoned);
+      card.querySelector('.tz-meta').textContent =
+        `${zoned.toPlainDate().toLocaleString('en-US', dateFmt)}${dayNote} · UTC${zoned.offset}`;
+      return card;
+    }
+
+    function update() {
+      const hostZone = hostTzSelect.value;
+      let requested;
+      try {
+        requested = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      } catch {
+        grid.replaceChildren();
+        hostWarning.hidden = true;
+        return;
+      }
+
+      const { resolved, conflict } = resolveHostTime(requested, hostZone);
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(conflict, requested, resolved, hostZone);
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      const hostDate = resolved.toPlainDate();
+      // withTimeZone returns a new ZonedDateTime for the same instant; `resolved` is never mutated.
+      const cards = TARGET_ZONES.map((zone) =>
+        renderCard(zone, resolved.withTimeZone(zone.id), hostZone, hostDate));
+      grid.replaceChildren(...cards);
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
