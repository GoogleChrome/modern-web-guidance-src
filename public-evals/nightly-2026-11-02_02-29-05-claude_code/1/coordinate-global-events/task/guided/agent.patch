+  <script type="module">
+    // Load the Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const TARGET_ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dateFormat = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+    // Inspect the requested wall-clock time in the host zone. Every Temporal
+    // object here is immutable: each disambiguation produces a new ZonedDateTime.
+    function resolveHostTime(plainDateTime, timeZone) {
+      const resolved = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+
+      try {
+        plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'reject' });
+        return { resolved, conflict: null };
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+      }
+
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      // In an overlap both candidates keep the requested wall-clock time; in a gap they cannot.
+      const type = resolved.toPlainDateTime().equals(plainDateTime) ? 'overlap' : 'gap';
+      return { resolved, conflict: { type, earlier, later } };
+    }
+
+    function describeConflict(plainDateTime, timeZone, { type, earlier, later }, resolved) {
+      const requested = plainDateTime.toPlainTime().toLocaleString('en-US', timeFormat);
+      const zoneName = hostTzSelect.selectedOptions[0].textContent;
+
+      if (type === 'gap') {
+        return `<strong>Heads up: ${requested} doesn't exist in ${zoneName} on this date.</strong> ` +
+          `Clocks spring forward for daylight saving time (UTC${earlier.offset} &rarr; UTC${later.offset}), ` +
+          `skipping that hour entirely. We've moved the tasting forward by the length of the gap to ` +
+          `<strong>${resolved.toLocaleString('en-US', timeFormat)}</strong> (UTC${resolved.offset}).`;
+      }
+
+      return `<strong>Heads up: ${requested} happens twice in ${zoneName} on this date.</strong> ` +
+        `Clocks fall back for the end of daylight saving time, so the hour repeats ` +
+        `(first at UTC${earlier.offset}, then again at UTC${later.offset}). ` +
+        `We've scheduled the tasting for the <strong>first occurrence</strong> (UTC${resolved.offset}); ` +
+        `the second would be ${later.toInstant().since(earlier.toInstant()).total('minutes')} minutes later.`;
+    }
+
+    function renderCard({ id, label }, zoned, hostZone) {
+      const card = document.createElement('article');
+      card.className = 'card tz-card';
+      if (id === hostZone) card.classList.add('is-host');
+
+      const heading = document.createElement('h3');
+      heading.textContent = label;
+
+      const time = document.createElement('p');
+      time.className = 'tz-time';
+      time.textContent = zoned.toLocaleString('en-US', timeFormat);
+
+      const date = document.createElement('p');
+      date.className = 'tz-date';
+      date.textContent = `${zoned.toPlainDate().toLocaleString('en-US', dateFormat)} · UTC${zoned.offset}`;
+
+      card.append(heading, time, date);
+
+      if (id === hostZone) {
+        const badge = document.createElement('span');
+        badge.className = 'tz-badge';
+        badge.textContent = 'Host';
+        card.append(badge);
+      }
+      return card;
+    }
+
+    function update() {
+      const timeZone = hostTzSelect.value;
+      hostWarning.hidden = true;
+      hostWarning.innerHTML = '';
+
+      if (!dateInput.value || !timeInput.value) {
+        grid.replaceChildren();
+        return;
+      }
+
+      let plainDateTime;
+      try {
+        plainDateTime = Temporal.PlainDate.from(dateInput.value)
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value));
+      } catch {
+        grid.replaceChildren();
+        return;
+      }
+
+      const { resolved, conflict } = resolveHostTime(plainDateTime, timeZone);
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(plainDateTime, timeZone, conflict, resolved);
+        hostWarning.hidden = false;
+      }
+
+      // withTimeZone() returns a new ZonedDateTime for the same instant; `resolved` is never mutated.
+      grid.replaceChildren(
+        ...TARGET_ZONES.map((zone) => renderCard(zone, resolved.withTimeZone(zone.id), timeZone))
+      );
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+
+    update();
+  </script>
+
