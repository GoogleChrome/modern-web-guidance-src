+        supported: () => supportsStatic('sign', 'Ed25519') ?? probeGenerate('Ed25519'),
+      },
+      'ECDSA-P256': {
+        label: 'ECDSA P-256 / SHA-256 (classical)',
+        keyAlg: { name: 'ECDSA', namedCurve: 'P-256' },
+        publicFormat: 'raw',
+        nativeContext: false,
