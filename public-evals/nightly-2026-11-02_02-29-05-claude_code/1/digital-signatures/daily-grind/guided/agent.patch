+        setStatus($('output-status'), 'bad', `Signing failed: ${err.message}`);
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    $('receipt-form').addEventListener('submit', (event) => issue(event, 'receipt', (data) => {
+      const item = MENU[data.get('item')];
+      const quantity = Number(data.get('quantity'));
+      return {
+        orderId: randomId('ORD'),
+        customer: data.get('customer').trim(),
+        item: item.name,
+        quantity,
+        unitCents: item.cents,
+        totalCents: item.cents * quantity,
+        issuedAt: new Date().toISOString(),
+      };
+    }));
+
+    $('voucher-form').addEventListener('submit', (event) => issue(event, 'voucher', (data) => {
+      const issued = new Date();
+      const expires = new Date(issued);
+      expires.setFullYear(expires.getFullYear() + 1);
+      return {
+        code: randomId('GIFT', 8),
+        recipient: data.get('recipient').trim(),
+        amountCents: Number(data.get('amount')) * 100,
+        message: data.get('message').trim(),
+        issuedAt: issued.toISOString(),
+        expiresAt: expires.toISOString(),
+      };
+    }));
+
+    $('download-doc').addEventListener('click', () => {
+      download(signedOutput.dataset.filename, signedOutput.value);
+    });
+
+    $('copy-doc').addEventListener('click', async () => {
+      try {
+        await navigator.clipboard.writeText(signedOutput.value);
+        setStatus($('output-status'), 'ok', 'Copied to clipboard.');
+      } catch {
+        signedOutput.select();
+        setStatus($('output-status'), 'warn', 'Clipboard unavailable — the text is selected, copy it manually.');
+      }
+    });
+
+    $('send-to-verify').addEventListener('click', () => {
+      verifyInput.value = signedOutput.value;
+      setStatus($('verify-status'));
+      verifyInput.focus();
+    });
+
+    $('verify-file').addEventListener('change', async (event) => {
+      const file = event.target.files[0];
+      if (file) verifyInput.value = await file.text();
+    });
+
+    verifyInput.addEventListener('input', () => setStatus($('verify-status')));
+
+    $('verify-form').addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const status = $('verify-status');
+      let doc;
+      try {
+        doc = JSON.parse(verifyInput.value);
+      } catch {
+        setStatus(status, 'bad', '✗ This is not valid JSON.');
+        return;
+      }
+      try {
+        const result = await verifyDocument(doc);
+        if (!result.valid) {
+          setStatus(status, 'bad', '✗ Invalid signature — this document has been altered or was not signed by this key.');
+          return;
+        }
+        const rows = [...describe(result.data), ['Algorithm', SUITES[doc.alg].label], ['Signer', result.fingerprint]];
+        const expired = result.data.type === 'voucher' && new Date(result.data.expiresAt) < new Date();
+        if (!signer || result.fingerprint !== signer.fingerprint) {
+          setStatus(status, 'warn',
+            '⚠ The signature is mathematically valid, but it was made with a key that is not The Daily Grind\'s. Do not accept it.',
+            rows);
+        } else if (expired) {
+          setStatus(status, 'warn', '⚠ Authentic voucher, but it has expired.', rows);
+        } else {
+          setStatus(status, 'ok', `✓ Authentic ${result.data.type} — signed by The Daily Grind and unaltered.`, rows);
+        }
+      } catch (err) {
+        setStatus(status, 'bad', `✗ Could not verify: ${err.message}`);
+      }
+    });
+
+    init();
+  </script>
