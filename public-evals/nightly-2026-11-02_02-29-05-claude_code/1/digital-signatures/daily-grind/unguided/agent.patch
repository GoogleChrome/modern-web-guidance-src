new file mode 100644
index 0000000..3b34fd2
--- /dev/null
+++ b/js/keystore.js
@@ -0,0 +1,112 @@
+// Browser persistence for the shop's signing key and the trusted public keyring.
+//
+// The signing key lives in IndexedDB:
+//   - WebCrypto keys (ES256, Ed25519) are stored as non-extractable CryptoKey
+//     objects, so the raw private key never leaves the browser's crypto engine.
+//   - The ML-DSA-65 seed is encrypted with a non-extractable AES-GCM key that is
+//     stored alongside it, so the seed is never written to disk in the clear.
+// The trusted keyring only holds public keys, so localStorage is sufficient.
+
+import { importMlDsaSeed, toBase64Url, fromBase64Url } from './signing.js';
+
+const DB_NAME = 'daily-grind-signing';
+const STORE = 'keys';
+const SIGNING_KEY_ID = 'signing-key';
+const KEYRING_STORAGE_KEY = 'dailyGrind.trustedKeys.v1';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function withStore(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+export async function saveSigningKey(key) {
+  const record = { alg: key.alg, kid: key.kid, publicKey: key.publicKey, createdAt: new Date().toISOString() };
+  if (key.seed) {
+    const wrapKey = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const additionalData = new TextEncoder().encode(key.kid);
+    record.wrapKey = wrapKey;
+    record.iv = iv;
+    record.wrappedSeed = new Uint8Array(
+      await crypto.subtle.encrypt({ name: 'AES-GCM', iv, additionalData }, wrapKey, key.seed),
+    );
+  } else {
+    record.privateKey = key.privateKey;
+  }
+  await withStore('readwrite', (s) => s.put(record, SIGNING_KEY_ID));
+  return record.createdAt;
+}
+
+export async function loadSigningKey() {
+  const record = await withStore('readonly', (s) => s.get(SIGNING_KEY_ID));
+  if (!record) return null;
+  if (record.wrappedSeed) {
+    const additionalData = new TextEncoder().encode(record.kid);
+    const seed = new Uint8Array(
+      await crypto.subtle.decrypt({ name: 'AES-GCM', iv: record.iv, additionalData }, record.wrapKey, record.wrappedSeed),
+    );
+    const key = await importMlDsaSeed(seed);
+    if (key.kid !== record.kid) throw new Error('Stored ML-DSA key is corrupted');
+    return { ...key, createdAt: record.createdAt };
+  }
+  return {
+    alg: record.alg,
+    kid: record.kid,
+    publicKey: record.publicKey,
+    privateKey: record.privateKey,
+    seed: null,
+    createdAt: record.createdAt,
+  };
+}
+
+export async function deleteSigningKey() {
+  await withStore('readwrite', (s) => s.delete(SIGNING_KEY_ID));
+}
+
+// ---------- trusted keyring ----------
+
+export function loadTrustedKeys() {
+  try {
+    const raw = JSON.parse(localStorage.getItem(KEYRING_STORAGE_KEY) || '[]');
+    return raw.map((k) => ({ ...k, publicKey: fromBase64Url(k.publicKey) }));
+  } catch {
+    return [];
+  }
+}
+
+function storeTrustedKeys(keys) {
+  const raw = keys.map((k) => ({ ...k, publicKey: toBase64Url(k.publicKey) }));
+  localStorage.setItem(KEYRING_STORAGE_KEY, JSON.stringify(raw));
+}
+
+export function addTrustedKey({ alg, kid, label, publicKey }) {
+  const keys = loadTrustedKeys().filter((k) => k.kid !== kid);
+  keys.push({ alg, kid, label, publicKey, addedAt: new Date().toISOString() });
+  storeTrustedKeys(keys);
+  return keys;
+}
+
+export function removeTrustedKey(kid) {
+  const keys = loadTrustedKeys().filter((k) => k.kid !== kid);
+  storeTrustedKeys(keys);
+  return keys;
+}
