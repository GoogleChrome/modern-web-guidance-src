+  const { subtotalCents, taxCents, totalCents } = receiptTotals(receiptItems());
+  $('sig-receipt-total').textContent =
+    `Subtotal ${money(subtotalCents)} · Tax ${money(taxCents)} · Total ${money(totalCents)}`;
