+function buildPayload(type) {
+  if (type === 'receipt') {
+    const items = receiptItems().map(({ name, qty, unitCents }) => ({ name, qty, unitCents }));
+    if (!items.length) throw new Error('Add at least one item to the order.');
+    return {
+      store: SHOP_NAME,
+      orderId: 'DG-' + randomCode(2),
+      customer: $('sig-customer').value.trim().slice(0, 80) || 'Guest',
+      items,
+      ...receiptTotals(items),
+      currency: 'USD',
