+  return document.querySelector('input[name="sig-doc-type"]:checked').value;
+}
+
+function renderDocTypeForms() {
+  const type = currentDocType();
+  $('sig-receipt-form').hidden = type !== 'receipt';
+  $('sig-voucher-form').hidden = type !== 'voucher';
