+// Daily Grind document signing core.
+//
+// Signs and verifies coffee receipts and gift vouchers with asymmetric keys,
+// entirely in the browser. Three algorithms are supported:
+//   - ES256     ECDSA P-256 / SHA-256 (WebCrypto)
+//   - Ed25519   EdDSA (WebCrypto, where the browser supports it)
+//   - ML-DSA-65 FIPS 204 lattice signatures, quantum-resistant (vendored noble-post-quantum)
+//
+// A signed document is a compact token: "DG1." + base64url(JSON envelope).
+// The signature covers a domain-separated, canonical encoding of every
+// envelope field except the signature itself, so the algorithm, key id,
+// document type, issue time and payload are all bound together.
+
+const TOKEN_PREFIX = 'DG1.';
+const PUBKEY_PREFIX = 'DGPK1.';
+const SIGNING_DOMAIN = 'DailyGrind-Signed-Document/v1\n';
+const KID_DOMAIN = 'DailyGrind-Key-Id/v1\n';
+const MLDSA_URL = new URL('../vendor/noble-post-quantum-0.5.2-ml-dsa.js', import.meta.url).href;
+
+export const DOC_TYPES = ['receipt', 'voucher'];
+
+export const ALGORITHMS = {
+  ES256: {
+    label: 'ECDSA P-256 (classical)',
+    publicKeyLength: 65,
+    signatureLength: 64,
+    quantumResistant: false,
+  },
+  Ed25519: {
+    label: 'Ed25519 (classical)',
+    publicKeyLength: 32,
+    signatureLength: 64,
+    quantumResistant: false,
+  },
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 / FIPS 204 (quantum-resistant)',
+    publicKeyLength: 1952,
+    signatureLength: 3309,
+    quantumResistant: true,
+  },
+};
+
+const enc = new TextEncoder();
+const dec = new TextDecoder('utf-8', { fatal: true });
+
+// ---------- encoding helpers ----------
+
+export function toBase64Url(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function fromBase64Url(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url data');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (str.length % 4)) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+// Deterministic JSON: object keys sorted, no whitespace. Only plain data is
+// allowed so that signer and verifier always produce identical bytes.
+export function canonicalJson(value) {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isSafeInteger(value)) throw new Error('Only safe integers may be signed');
+    return String(value);
+  }
+  if (Array.isArray(value)) {
+    return '[' + value.map(canonicalJson).join(',') + ']';
+  }
+  if (typeof value === 'object' && Object.getPrototypeOf(value) === Object.prototype) {
+    const keys = Object.keys(value).sort();
+    return '{' + keys.map((k) => JSON.stringify(k) + ':' + canonicalJson(value[k])).join(',') + '}';
+  }
+  throw new Error('Unsupported value in signed document');
+}
+
+function concatBytes(...parts) {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let off = 0;
+  for (const p of parts) {
+    out.set(p, off);
+    off += p.length;
+  }
+  return out;
+}
+
+function bytesEqual(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+function assertAlgorithm(alg) {
+  if (!Object.prototype.hasOwnProperty.call(ALGORITHMS, alg)) {
+    throw new Error(`Unsupported algorithm: ${String(alg)}`);
+  }
+}
+
+// ---------- algorithm backends ----------
+
+let mldsaPromise;
+function loadMlDsa() {
+  mldsaPromise ??= import(MLDSA_URL).then((m) => m.ml_dsa65);
+  return mldsaPromise;
+}
+
+let ed25519Support;
+export async function isAlgorithmSupported(alg) {
+  assertAlgorithm(alg);
+  if (alg !== 'Ed25519') return true;
+  ed25519Support ??= crypto.subtle
+    .generateKey({ name: 'Ed25519' }, false, ['sign', 'verify'])
+    .then(() => true, () => false);
+  return ed25519Support;
+}
+
+const WEBCRYPTO = {
+  ES256: {
+    keyParams: { name: 'ECDSA', namedCurve: 'P-256' },
+    signParams: { name: 'ECDSA', hash: 'SHA-256' },
+  },
+  Ed25519: {
+    keyParams: { name: 'Ed25519' },
+    signParams: { name: 'Ed25519' },
+  },
+};
+
+/**
+ * Generate a signing key pair.
+ * WebCrypto private keys are created non-extractable. For ML-DSA the private
+ * key is derived from a 32-byte seed which the caller must protect.
+ * Returns { alg, kid, publicKey: Uint8Array, privateKey: CryptoKey | null, seed: Uint8Array | null }.
+ */
+export async function generateSigningKey(alg) {
+  assertAlgorithm(alg);
+  if (alg === 'ML-DSA-65') {
+    const seed = crypto.getRandomValues(new Uint8Array(32));
+    return importMlDsaSeed(seed);
+  }
+  const { keyParams } = WEBCRYPTO[alg];
+  const pair = await crypto.subtle.generateKey(keyParams, false, ['sign', 'verify']);
+  const publicKey = new Uint8Array(await crypto.subtle.exportKey('raw', pair.publicKey));
+  return { alg, kid: await keyId(alg, publicKey), publicKey, privateKey: pair.privateKey, seed: null };
+}
+
+/** Rebuild an ML-DSA-65 signing key from its seed. */
+export async function importMlDsaSeed(seed) {
+  const mldsa = await loadMlDsa();
+  const { publicKey, secretKey } = mldsa.keygen(seed);
+  const alg = 'ML-DSA-65';
+  return { alg, kid: await keyId(alg, publicKey), publicKey, privateKey: null, seed, secretKey };
+}
+
+async function rawSign(key, message) {
+  if (key.alg === 'ML-DSA-65') {
+    const mldsa = await loadMlDsa();
+    const secretKey = key.secretKey ?? mldsa.keygen(key.seed).secretKey;
+    return mldsa.sign(message, secretKey);
+  }
+  const sig = await crypto.subtle.sign(WEBCRYPTO[key.alg].signParams, key.privateKey, message);
+  return new Uint8Array(sig);
+}
+
+async function rawVerify(alg, publicKey, message, signature) {
+  if (alg === 'ML-DSA-65') {
+    const mldsa = await loadMlDsa();
+    return mldsa.verify(signature, message, publicKey);
+  }
+  const { keyParams, signParams } = WEBCRYPTO[alg];
+  const key = await crypto.subtle.importKey('raw', publicKey, keyParams, false, ['verify']);
+  return crypto.subtle.verify(signParams, key, signature, message);
+}
+
+/** Key id: first 16 bytes of SHA-256 over a domain tag, the algorithm and the raw public key. */
+export async function keyId(alg, publicKey) {
+  const digest = await crypto.subtle.digest(
+    'SHA-256',
+    concatBytes(enc.encode(KID_DOMAIN + alg + '\n'), publicKey),
+  );
+  return toBase64Url(new Uint8Array(digest).subarray(0, 16));
+}
+
+// ---------- documents ----------
+
+function signingInput({ v, alg, kid, type, issuedAt, payload }) {
+  return enc.encode(SIGNING_DOMAIN + canonicalJson({ v, alg, kid, type, issuedAt, payload }));
+}
+
+/** Sign a receipt or voucher payload and return a DG1 token. */
+export async function signDocument(key, type, payload) {
+  if (!DOC_TYPES.includes(type)) throw new Error(`Unknown document type: ${type}`);
+  const body = {
+    v: 1,
+    alg: key.alg,
+    kid: key.kid,
+    type,
+    issuedAt: new Date().toISOString(),
+    payload,
+  };
+  const signature = await rawSign(key, signingInput(body));
+  const envelope = { ...body, pub: toBase64Url(key.publicKey), sig: toBase64Url(signature) };
+  return TOKEN_PREFIX + toBase64Url(enc.encode(JSON.stringify(envelope)));
+}
+
+/** Parse a DG1 token into its envelope without verifying it. Throws on malformed input. */
+export function parseToken(token) {
+  const trimmed = String(token).replace(/\s+/g, '');
+  if (!trimmed.startsWith(TOKEN_PREFIX)) throw new Error('Not a Daily Grind signed document (missing DG1 prefix)');
+  let env;
+  try {
+    env = JSON.parse(dec.decode(fromBase64Url(trimmed.slice(TOKEN_PREFIX.length))));
+  } catch {
+    throw new Error('Signed document is corrupted and cannot be decoded');
+  }
+  if (!env || typeof env !== 'object' || env.v !== 1) throw new Error('Unsupported signed document version');
+  assertAlgorithm(env.alg);
+  if (!DOC_TYPES.includes(env.type)) throw new Error('Unknown document type');
+  for (const f of ['kid', 'issuedAt', 'pub', 'sig']) {
+    if (typeof env[f] !== 'string') throw new Error(`Signed document is missing "${f}"`);
+  }
+  if (!env.payload || typeof env.payload !== 'object' || Array.isArray(env.payload)) {
+    throw new Error('Signed document has no payload');
+  }
+  return env;
+}
+
