+// Homepage UI for signing and verifying receipts and gift vouchers.
+// All untrusted text (pasted tokens, imported keys) is rendered with
+// textContent only — never innerHTML.
+
+import {
+  ALGORITHMS,
+  generateSigningKey,
+  isAlgorithmSupported,
+  signDocument,
+  verifyToken,
+  parseToken,
+  exportPublicKey,
+  importPublicKey,
+  toBase64Url,
+  fromBase64Url,
+} from './signing.js';
+import {
+  saveSigningKey,
+  loadSigningKey,
+  deleteSigningKey,
+  loadTrustedKeys,
+  addTrustedKey,
+  removeTrustedKey,
+} from './keystore.js';
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitCents: 575 },
+  { name: 'Dark Roast Espresso', unitCents: 350 },
+  { name: 'Cold Brew', unitCents: 495 },
+  { name: 'Butter Croissant', unitCents: 325 },
+];
+const TAX_RATE_BPS = 825; // 8.25%
+const SHOP_NAME = 'The Daily Grind';
+
+const $ = (id) => document.getElementById(id);
+const money = (cents) => '$' + (cents / 100).toFixed(2);
+
+let signingKey = null;
+let trustedKeys = [];
+
+function el(tag, props = {}, children = []) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') node.className = v;
+    else if (k === 'text') node.textContent = v;
+    else node.setAttribute(k, v);
+  }
+  for (const c of [].concat(children)) node.append(c);
+  return node;
+}
+
+function flash(target, message, isError = false) {
+  target.textContent = message;
+  target.classList.toggle('sig-error', isError);
+}
+
+async function copyText(text, statusEl) {
+  try {
+    await navigator.clipboard.writeText(text);
+    flash(statusEl, 'Copied to clipboard.');
+  } catch {
+    flash(statusEl, 'Copy failed — select the text and copy it manually.', true);
+  }
+}
+
+function download(filename, text) {
+  const url = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
+  const a = el('a', { href: url, download: filename });
+  document.body.append(a);
+  a.click();
+  a.remove();
+  URL.revokeObjectURL(url);
+}
+
+function randomCode(groups = 3) {
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+  const bytes = crypto.getRandomValues(new Uint8Array(groups * 4));
+  const chars = Array.from(bytes, (b) => alphabet[b & 31]);
+  return Array.from({ length: groups }, (_, i) => chars.slice(i * 4, i * 4 + 4).join('')).join('-');
+}
+
+// ---------- signing key panel ----------
+
+async function initAlgorithmSelect() {
+  const select = $('sig-alg');
+  for (const [alg, spec] of Object.entries(ALGORITHMS)) {
+    const supported = await isAlgorithmSupported(alg);
+    const opt = el('option', { value: alg, text: spec.label + (supported ? '' : ' — not supported here') });
+    if (!supported) opt.disabled = true;
+    select.append(opt);
+  }
+}
+
+function renderSigningKey() {
+  const info = $('sig-key-info');
+  info.replaceChildren();
+  const hasKey = Boolean(signingKey);
+  $('sig-export-key').disabled = !hasKey;
+  $('sig-delete-key').disabled = !hasKey;
+  $('sig-sign').disabled = !hasKey;
+  if (!hasKey) {
+    info.append(el('p', { class: 'sig-muted', text: 'No signing key yet. Generate one to start issuing signed documents.' }));
+    return;
+  }
+  const spec = ALGORITHMS[signingKey.alg];
+  info.append(
+    el('dl', { class: 'sig-dl' }, [
+      el('dt', { text: 'Algorithm' }),
+      el('dd', {}, [
+        signingKey.alg + ' ',
+        el('span', {
+          class: 'sig-badge ' + (spec.quantumResistant ? 'sig-badge-pq' : 'sig-badge-classic'),
+          text: spec.quantumResistant ? 'Quantum-resistant' : 'Classical',
+        }),
+      ]),
+      el('dt', { text: 'Key ID' }),
+      el('dd', { class: 'sig-mono', text: signingKey.kid }),
+      el('dt', { text: 'Created' }),
+      el('dd', { text: new Date(signingKey.createdAt).toLocaleString() }),
+    ]),
+  );
+}
+
+async function onGenerateKey() {
+  const status = $('sig-key-status');
+  const alg = $('sig-alg').value;
+  if (signingKey && !confirm('Replace the current signing key? Documents it signed will still verify if its public key stays in your keyring.')) {
+    return;
+  }
+  flash(status, `Generating ${alg} key…`);
+  try {
+    const key = await generateSigningKey(alg);
+    const createdAt = await saveSigningKey(key);
+    signingKey = { ...key, createdAt };
+    trustedKeys = addTrustedKey({
+      alg: key.alg,
+      kid: key.kid,
+      label: `${SHOP_NAME} (${key.alg})`,
+      publicKey: key.publicKey,
+    });
+    renderSigningKey();
+    renderKeyring();
+    $('sig-pubkey-out').value = '';
+    flash(status, 'New signing key created and added to your trusted keyring.');
+  } catch (err) {
+    flash(status, 'Key generation failed: ' + err.message, true);
+  }
+}
+
+async function onDeleteKey() {
+  if (!confirm('Delete the signing key from this browser? This cannot be undone. Its public key stays in your trusted keyring.')) return;
+  await deleteSigningKey();
+  signingKey = null;
+  renderSigningKey();
+  $('sig-pubkey-out').value = '';
+  flash($('sig-key-status'), 'Signing key deleted.');
+}
+
+function onExportKey() {
+  const out = $('sig-pubkey-out');
