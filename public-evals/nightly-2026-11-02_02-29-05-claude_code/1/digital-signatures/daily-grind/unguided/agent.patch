+  const subtotalCents = items.reduce((n, i) => n + i.unitCents * i.qty, 0);
+  const taxCents = Math.round((subtotalCents * TAX_RATE_BPS) / 10000);
+  return { subtotalCents, taxCents, totalCents: subtotalCents + taxCents };
+}
+
