 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
 
+// Placeholder in index.html that is replaced with the per-request CSP nonce.
+// index.html is a trusted static template containing no user data, so only
+// developer-authored tags carry this token.
+const NONCE_PLACEHOLDER = '{{CSP_NONCE}}';
+const REPORT_PATH = '/csp-reports';
+const MAX_REPORT_BYTES = 64 * 1024;
+
+// Headers sent on every response (companion policies).
+const BASE_SECURITY_HEADERS = {
+  // Start HSTS with a short max-age; ramp to 31536000 (+ preload) once HTTPS is verified everywhere.
+  'Strict-Transport-Security': 'max-age=300; includeSubDomains',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy':
+    'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), focus-without-user-activation=()',
+  'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Reporting-Endpoints': `csp-endpoint="${REPORT_PATH}", default="${REPORT_PATH}"`,
+  Vary: 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+};
+
+function buildCsp(nonce) {
+  return [
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'nonce-${nonce}' 'report-sample'`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "form-action 'self'",
+    "require-trusted-types-for 'script'",
+    // The page creates no Trusted Types policies; list names here if one is added.
+    "trusted-types 'none'",
+    'report-to csp-endpoint',
+    `report-uri ${REPORT_PATH}`,
+  ].join('; ');
