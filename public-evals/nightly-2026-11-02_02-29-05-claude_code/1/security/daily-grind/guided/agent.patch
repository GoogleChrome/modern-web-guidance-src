+
+// Resource allowlist dry-run: collect violations before enforcing default-src.
+function buildReportOnlyCsp(nonce) {
+  return [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'nonce-${nonce}' 'report-sample'`,
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "font-src 'self'",
+    "manifest-src 'self'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "form-action 'self'",
+    'report-to csp-endpoint',
+    `report-uri ${REPORT_PATH}`,
+  ].join('; ');
+}
+
+// Fetch Metadata resource isolation: reject cross-site requests that are not
+// top-level GET navigations, before any other handling.
+function isAllowedByFetchMetadata(req) {
+  const site = req.headers['sec-fetch-site'];
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+
+  if (!site) return true; // Legacy browsers don't send Fetch Metadata.
+  if (['same-origin', 'same-site', 'none'].includes(site)) return true;
+
+  return (
+    mode === 'navigate' &&
+    (req.method === 'GET' || req.method === 'HEAD') &&
+    !['object', 'embed', 'iframe', 'frame'].includes(dest)
+  );
+}
+
+// Strip query strings and fragments so tokens/PII never reach the logs.
+function redactUrl(value) {
+  if (typeof value !== 'string') return value;
+  try {
+    const url = new URL(value);
+    return `${url.origin}${url.pathname}`;
+  } catch {
+    return value.split(/[?#]/)[0];
+  }
+}
+
+function logReport(report) {
+  const body = report['csp-report'] || report.body || report;
+  console.warn('[security-report]', JSON.stringify({
+    type: report.type || 'csp-violation',
+    documentURL: redactUrl(body.documentURL || body['document-uri']),
+    blockedURL: redactUrl(body.blockedURL || body['blocked-uri']),
+    directive: body.effectiveDirective || body['effective-directive'] || body['violated-directive'],
+    disposition: body.disposition,
+    sample: body.sample || body['script-sample'],
+  }));
+}
+
+function handleReport(req, res) {
+  const contentType = (req.headers['content-type'] || '').split(';')[0].trim();
+  if (req.method !== 'POST' ||
+      !['application/reports+json', 'application/csp-report', 'application/json'].includes(contentType)) {
+    res.writeHead(405, { Allow: 'POST' });
+    res.end();
+    return;
+  }
+
+  let size = 0;
+  const chunks = [];
+  req.on('data', (chunk) => {
+    size += chunk.length;
+    if (size > MAX_REPORT_BYTES) {
+      res.writeHead(413);
+      res.end();
+      req.destroy();
+      return;
+    }
+    chunks.push(chunk);
+  });
+  req.on('end', () => {
+    if (res.writableEnded) return;
+    try {
+      const parsed = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      (Array.isArray(parsed) ? parsed : [parsed]).forEach(logReport);
+    } catch {
+      // Ignore malformed reports.
+    }
+    res.writeHead(204);
+    res.end();
+  });
+}
