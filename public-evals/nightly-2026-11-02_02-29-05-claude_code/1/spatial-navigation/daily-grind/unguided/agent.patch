+  <script>
+    (function () {
+      'use strict';
+
+      var grid = document.querySelector('[data-spatial-nav]');
+      if (!grid) return;
+
+      var DIRECTIONS = {
+        ArrowUp: { x: 0, y: -1 },
+        ArrowDown: { x: 0, y: 1 },
+        ArrowLeft: { x: -1, y: 0 },
+        ArrowRight: { x: 1, y: 0 }
+      };
+
+      // Penalty applied to off-axis distance so that items in the same row/column win
+      // over items that are nearer diagonally.
+      var ORTHOGONAL_WEIGHT = 2;
+      // Small tolerance in px so sub-pixel rounding doesn't disqualify neighbours.
+      var EPSILON = 1;
+
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function getCards() {
+        return Array.prototype.filter.call(grid.querySelectorAll('.card'), function (card) {
+          // Skip cards that are hidden (display: none, hidden attribute, etc.).
+          return card.getClientRects().length > 0;
+        });
+      }
+
+      function setActive(card, moveFocus) {
+        getCards().forEach(function (c) {
+          c.tabIndex = c === card ? 0 : -1;
+        });
+        if (moveFocus) {
+          card.focus({ preventScroll: true });
+          card.scrollIntoView({
+            block: 'nearest',
+            inline: 'nearest',
+            behavior: reducedMotion.matches ? 'auto' : 'smooth'
+          });
+        }
+      }
+
+      // Ensure exactly one visible card is in the tab order.
+      function ensureTabStop() {
+        var cards = getCards();
+        if (!cards.length) return;
+        var current = cards.filter(function (c) { return c.tabIndex === 0; })[0];
+        setActive(current || cards[0], false);
+      }
+
+      // Find the closest card in the given visual direction using on-screen geometry,
+      // so it works for any column count, list layout, wrapping, or RTL text direction.
+      function findNeighbor(from, dir, cards) {
+        var a = from.getBoundingClientRect();
+        var best = null;
+        var bestScore = Infinity;
+
+        cards.forEach(function (card) {
+          if (card === from) return;
+          var b = card.getBoundingClientRect();
+          var primary, orthogonal, overlaps;
+
+          if (dir.x !== 0) {
+            // Horizontal: candidate must lie entirely beyond the current card's edge.
+            primary = dir.x > 0 ? b.left - a.right : a.left - b.right;
+            overlaps = b.top < a.bottom - EPSILON && b.bottom > a.top + EPSILON;
+            orthogonal = overlaps ? 0 : Math.abs((b.top + b.bottom) / 2 - (a.top + a.bottom) / 2);
+          } else {
+            primary = dir.y > 0 ? b.top - a.bottom : a.top - b.bottom;
+            overlaps = b.left < a.right - EPSILON && b.right > a.left + EPSILON;
+            orthogonal = overlaps ? 0 : Math.abs((b.left + b.right) / 2 - (a.left + a.right) / 2);
+          }
+
+          if (primary < -EPSILON) return;
+
+          var score = Math.max(primary, 0) + orthogonal * ORTHOGONAL_WEIGHT;
+          // Items aligned with the current row/column always beat diagonal ones.
+          if (!overlaps) score += 1e6;
+
+          if (score < bestScore) {
+            bestScore = score;
+            best = card;
+          }
+        });
+
+        return best;
+      }
+
+      grid.addEventListener('keydown', function (event) {
+        if (event.altKey || event.metaKey) return;
+
+        var current = event.target.closest('.card');
+        if (!current || !grid.contains(current)) return;
+        var cards = getCards();
+        if (!cards.length) return;
+
+        var target = null;
+        var dir = DIRECTIONS[event.key];
+
+        if (dir) {
+          if (event.ctrlKey || event.shiftKey) return;
+          target = findNeighbor(current, dir, cards);
+          // At an edge: consume the key anyway so the page doesn't scroll unexpectedly.
+          event.preventDefault();
+          if (!target) return;
+        } else if (event.key === 'Home') {
+          target = cards[0];
+        } else if (event.key === 'End') {
+          target = cards[cards.length - 1];
+        } else if ((event.key === 'Enter' || event.key === ' ') && event.target === current) {
+          var link = current.querySelector('a[href]');
+          if (link) {
+            event.preventDefault();
+            link.click();
+          }
+          return;
+        } else {
+          return;
+        }
+
+        event.preventDefault();
+        setActive(target, true);
+      });
+
+      // Keep the roving tab stop in sync with mouse clicks / programmatic focus.
+      grid.addEventListener('focusin', function (event) {
+        var card = event.target.closest('.card');
+        if (card && grid.contains(card) && card.tabIndex !== 0) setActive(card, false);
+      });
+
+      // Re-validate the tab stop if cards are added, removed, or hidden.
+      new MutationObserver(ensureTabStop).observe(grid, {
+        childList: true,
+        subtree: true,
+        attributes: true,
+        attributeFilter: ['hidden', 'class', 'style']
+      });
+
+      // Layout mode toggle (grid / list).
+      var STORAGE_KEY = 'dailyGrind.cardLayout';
+      var buttons = document.querySelectorAll('.layout-toggle [data-layout]');
+
+      function applyLayout(layout) {
+        grid.classList.toggle('is-list', layout === 'list');
+        Array.prototype.forEach.call(buttons, function (btn) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.layout === layout));
+        });
+      }
+
+      Array.prototype.forEach.call(buttons, function (btn) {
+        btn.addEventListener('click', function () {
+          applyLayout(btn.dataset.layout);
+          try { localStorage.setItem(STORAGE_KEY, btn.dataset.layout); } catch (e) { /* storage unavailable */ }
+        });
+      });
+
+      var saved = null;
+      try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) { /* storage unavailable */ }
+      if (saved === 'list' || saved === 'grid') applyLayout(saved);
+
+      ensureTabStop();
+    })();
+  </script>
+
