+  <script>
+    // <img>, CSS backgrounds and @font-face have no integrity attribute, so fetch those
+    // assets with fetch()'s `integrity` option and only use the bytes if the hash matches.
+    (function () {
+      var fetchOptions = {
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      };
+
+      function fetchVerified(url, integrity) {
+        return fetch(url, Object.assign({ integrity: integrity }, fetchOptions)).then(function (res) {
+          if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + url);
+          return res;
+        });
+      }
+
+      function verifiedObjectUrl(url, integrity) {
+        return fetchVerified(url, integrity)
+          .then(function (res) { return res.blob(); })
+          .then(function (blob) { return URL.createObjectURL(blob); });
+      }
+
+      function warn(err) {
+        console.warn('Skipped unverified third-party asset:', err);
+      }
+
+      var cdn = 'https://cdn.jsdelivr.net/npm/@fontsource/';
+      var fonts = [
+        {
+          family: 'Lato', weight: '400',
+          url: cdn + 'lato@5.3.0/files/lato-latin-400-normal.woff2',
+          integrity: 'sha384-+chn3xqCWRPSXDBtVEFQn+0J9Gb0SYR2FO1WrXo+L/arnyr8lXLVX2p0BqZIUemc'
+        },
+        {
+          family: 'Lato', weight: '700',
+          url: cdn + 'lato@5.3.0/files/lato-latin-700-normal.woff2',
+          integrity: 'sha384-VMhSnqoWTuTbzD+C/VKMAuMX6GpE7X2E+BiHN4Swi68wjoKZnNf8k07Z2L+ZYHcS'
+        },
+        {
+          family: 'Playfair Display', weight: '700',
+          url: cdn + 'playfair-display@5.3.0/files/playfair-display-latin-700-normal.woff2',
+          integrity: 'sha384-ngy5vAWiKv+bGTtacF7MguI7ndABbcib4yL2Khr7l9yYjAIMgregUPB9hQ0mihCX'
+        }
+      ];
+
+      if (window.FontFace && document.fonts) {
+        fonts.forEach(function (font) {
+          fetchVerified(font.url, font.integrity)
+            .then(function (res) { return res.arrayBuffer(); })
+            .then(function (data) {
+              var face = new FontFace(font.family, data, { weight: font.weight, display: 'swap' });
+              return face.load();
+            })
+            .then(function (face) { document.fonts.add(face); })
+            .catch(warn);
+        });
+      }
+
+      verifiedObjectUrl(
+        'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1600&q=80',
+        'sha384-tuL/1QLAa5KjoiExRLPluWMXSbJJ4U2j9YQYXBZg0T6B1NKvfyN8dmfAs12O6ORw'
+      ).then(function (objectUrl) {
+        document.querySelector('.hero').style.setProperty('--hero-image', 'url("' + objectUrl + '")');
+      }).catch(warn);
+
+      document.querySelectorAll('img[data-verified-src]').forEach(function (img) {
+        verifiedObjectUrl(img.dataset.verifiedSrc, img.dataset.integrity).then(function (objectUrl) {
+          img.addEventListener('load', function () { URL.revokeObjectURL(objectUrl); }, { once: true });
+          img.src = objectUrl;
+        }).catch(warn);
+      });
+
+      // Only opt cards into AOS animations once the verified script has actually run;
+      // otherwise aos.css would leave them stuck at opacity: 0.
+      window.addEventListener('DOMContentLoaded', function () {
+        if (!window.AOS) return;
+        document.querySelectorAll('.card').forEach(function (card, i) {
+          card.setAttribute('data-aos', 'fade-up');
+          card.setAttribute('data-aos-delay', String(i * 100));
+        });
+        AOS.init({
+          once: true,
+          duration: 600,
+          disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        });
+      });
+    })();
+  </script>
