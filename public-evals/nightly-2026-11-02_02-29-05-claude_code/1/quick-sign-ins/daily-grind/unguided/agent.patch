+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title">
+    <form id="signin-form" method="post" action="/login" novalidate>
+      <button type="button" class="btn-close" data-close aria-label="Close">&times;</button>
+      <h2 id="signin-title">Welcome back</h2>
+      <p class="signin-intro">Sign in to continue &mdash; you'll stay right where you are.</p>
+      <label>
+        Email
+        <input type="email" name="username" id="signin-username" autocomplete="username webauthn" required>
+      </label>
+      <label>
+        Password
+        <input type="password" name="password" id="signin-password" autocomplete="current-password" required>
+      </label>
+      <p class="signin-error" id="signin-error" role="alert"></p>
+      <button type="submit" class="btn-primary">Sign In</button>
+      <p class="divider">or</p>
+      <button type="button" class="btn-passkey" id="signin-passkey">Sign in with a passkey</button>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      // Backend endpoints. The server issues WebAuthn challenges and verifies
+      // assertions/passwords, then sets the session cookie.
+      const API = {
+        session: '/api/auth/session',
+        passkeyOptions: '/api/auth/passkey/options',
+        passkeyVerify: '/api/auth/passkey/verify',
+        password: '/api/auth/login',
+        logout: '/logout',
+      };
+
+      const dialog = document.getElementById('signin-dialog');
+      const form = document.getElementById('signin-form');
+      const errorEl = document.getElementById('signin-error');
+      const authLink = document.querySelector('[data-auth-link]');
+
+      let signedIn = false;
+      let pendingHref = null;
+      let conditionalAbort = null;
+
+      const hasWebAuthn = 'PublicKeyCredential' in window && !!navigator.credentials;
+
+      // --- Session state ---------------------------------------------------
+
+      function setSignedIn(value) {
+        signedIn = value;
+        authLink.textContent = value ? 'Logout' : 'Sign In';
+        authLink.href = value ? API.logout : '/login';
+      }
+
+      async function checkSession() {
+        try {
+          const res = await fetch(API.session, { credentials: 'same-origin' });
+          if (!res.ok) return false;
+          const data = await res.json();
+          return !!data.authenticated;
+        } catch {
+          return false;
+        }
+      }
+
+      function onSignedIn() {
+        setSignedIn(true);
+        abortConditional();
+        if (dialog.open) dialog.close();
+        const href = pendingHref;
+        pendingHref = null;
+        if (href) window.location.assign(href);
+      }
+
+      // --- WebAuthn helpers ------------------------------------------------
+
+      const b64urlToBuf = (s) => {
+        const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+      const bufToB64url = (buf) =>
+        btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      async function fetchPasskeyOptions() {
+        const res = await fetch(API.passkeyOptions, { method: 'POST', credentials: 'same-origin' });
+        if (!res.ok) throw new Error('Could not start passkey sign-in.');
+        const json = await res.json();
+        if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuf(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map((c) => ({ ...c, id: b64urlToBuf(c.id) })),
+        };
+      }
+
+      function credentialToJSON(cred) {
+        if (typeof cred.toJSON === 'function') return cred.toJSON();
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment,
+          clientExtensionResults: cred.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufToB64url(r.clientDataJSON),
+            authenticatorData: bufToB64url(r.authenticatorData),
+            signature: bufToB64url(r.signature),
+            userHandle: r.userHandle ? bufToB64url(r.userHandle) : null,
+          },
+        };
+      }
+
+      // --- Credential verification ----------------------------------------
+
+      async function postJSON(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body),
+        });
+        return res.ok;
+      }
+
+      async function completeCredential(cred) {
+        if (!cred) return false;
+        if (cred.type === 'public-key') {
+          return postJSON(API.passkeyVerify, credentialToJSON(cred));
+        }
+        if (cred.type === 'password') {
+          return postJSON(API.password, { username: cred.id, password: cred.password });
+        }
+        return false;
+      }
+
+      // --- Sign-in flows ---------------------------------------------------
+
+      function abortConditional() {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      }
+
+      async function supportsImmediate() {
+        if (!hasWebAuthn || !PublicKeyCredential.getClientCapabilities) return false;
+        try {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          return !!caps.immediateGet;
+        } catch {
+          return false;
+        }
+      }
+
+      // Immediate mediation: the browser shows its own inline account picker
+      // over the current page with any saved passkeys and passwords for this
+      // site, or rejects right away if there are none.
+      async function tryImmediateSignIn() {
+        if (!(await supportsImmediate())) return false;
+        try {
+          const publicKey = await fetchPasskeyOptions();
+          const cred = await navigator.credentials.get({ publicKey, password: true, mediation: 'immediate' });
+          return await completeCredential(cred);
+        } catch {
+          // NotAllowedError means no saved credentials or the user dismissed it.
+          return false;
+        }
+      }
+
+      // Conditional mediation: saved passkeys appear in the email field's
+      // autofill suggestions alongside saved passwords.
+      async function startConditionalPasskey() {
+        if (!hasWebAuthn || !PublicKeyCredential.isConditionalMediationAvailable) return;
+        if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+        abortConditional();
+        const controller = new AbortController();
+        conditionalAbort = controller;
+        try {
+          const publicKey = await fetchPasskeyOptions();
+          const cred = await navigator.credentials.get({ publicKey, mediation: 'conditional', signal: controller.signal });
+          if (await completeCredential(cred)) onSignedIn();
+          else errorEl.textContent = 'That passkey could not be verified. Please try again.';
+        } catch (err) {
+          if (err.name !== 'AbortError' && !controller.signal.aborted) {
+            console.warn('Passkey autofill unavailable:', err);
+          }
+        } finally {
+          if (conditionalAbort === controller) conditionalAbort = null;
+        }
+      }
+
+      function openDialog() {
+        errorEl.textContent = '';
+        form.reset();
+        dialog.showModal();
+        document.getElementById('signin-username').focus();
+        startConditionalPasskey();
+      }
+
+      async function requestSignIn(href) {
+        pendingHref = href;
+        if (await tryImmediateSignIn()) {
+          onSignedIn();
+          return;
+        }
+        openDialog();
+      }
+
+      // --- Event wiring ----------------------------------------------------
+
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const link = e.target.closest('a[data-requires-auth], a[data-auth-link]');
+        if (!link) return;
+        if (link.matches('[data-auth-link]')) {
+          if (signedIn) return; // let Logout navigate normally
+          e.preventDefault();
+          requestSignIn(null);
+          return;
+        }
+        if (signedIn) return;
+        e.preventDefault();
+        requestSignIn(link.href);
+      });
+
+      document.getElementById('signin-passkey').addEventListener('click', async () => {
+        errorEl.textContent = '';
+        abortConditional();
+        try {
+          const publicKey = await fetchPasskeyOptions();
+          const cred = await navigator.credentials.get({ publicKey });
+          if (await completeCredential(cred)) onSignedIn();
+          else errorEl.textContent = 'That passkey could not be verified. Please try again.';
+        } catch (err) {
+          if (err.name !== 'NotAllowedError') errorEl.textContent = err.message || 'Passkey sign-in failed.';
+        }
+        if (dialog.open && !signedIn) startConditionalPasskey();
+      });
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        errorEl.textContent = '';
+        const username = form.username.value.trim();
+        const password = form.password.value;
+        if (!username || !password) {
+          errorEl.textContent = 'Please enter your email and password.';
+          return;
+        }
+        if (await postJSON(API.password, { username, password })) {
+          // Offer to save/update the password in the browser's manager.
+          if (window.PasswordCredential) {
+            try {
+              await navigator.credentials.store(new PasswordCredential({ id: username, password }));
+            } catch { /* ignore */ }
+          }
+          onSignedIn();
+        } else {
+          errorEl.textContent = 'Incorrect email or password.';
+        }
+      });
+
+      dialog.addEventListener('click', (e) => {
+        if (e.target === dialog || e.target.closest('[data-close]')) dialog.close();
+      });
+
+      dialog.addEventListener('close', () => {
+        abortConditional();
+        if (!signedIn) pendingHref = null;
+      });
+
+      setSignedIn(false);
+      checkSession().then(setSignedIn);
+    })();
+  </script>
+
 </body>
 
