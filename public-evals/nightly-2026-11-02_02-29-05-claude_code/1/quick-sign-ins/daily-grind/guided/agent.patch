+  <script type="module">
+    // Normalizes getClientCapabilities / parseRequestOptionsFromJSON / toJSON across browsers.
+    // If the CDN is unreachable, links simply navigate as plain links.
+    if (window.PublicKeyCredential) {
+      await import('https://esm.sh/webauthn-polyfills@0.1.7').catch(() => {});
+    }
+
+    const dialog = document.getElementById('signin-dialog');
+    const form = document.getElementById('signin-form');
+    const errorEl = document.getElementById('signin-error');
+    const passkeyButton = document.getElementById('passkey-signin');
+    const intro = dialog.querySelector('.signin-intro');
+
+    // Where to send the user once signed in (null = stay on this page)
+    let pendingDestination = null;
+    let isAuthenticating = false;
+    let conditionalAbort = null;
+
+    const isSignedIn = () => document.body.dataset.signedIn === 'true';
+
+    async function getCapabilities() {
+      if (!window.PublicKeyCredential?.getClientCapabilities) return {};
+      try {
+        return (await PublicKeyCredential.getClientCapabilities()) ?? {};
+      } catch {
+        return {};
+      }
+    }
+
+    async function fetchRequestOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST' });
+      if (!res.ok) throw new Error('Failed to fetch authentication options');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    async function verifyPasskey(cred, publicKey) {
+      const encoded = cred.toJSON();
+      const res = await postJSON('/api/login/verify', encoded);
+      if (res.status === 404) {
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId || location.hostname,
+            credentialId: encoded.id,
+          });
+        }
+        throw new Error('That passkey is no longer recognized. Please sign in another way.');
+      }
+      if (!res.ok) throw new Error('Passkey sign-in failed. Please try again.');
+      return res.json();
+    }
+
+    async function verifyPassword(username, password) {
+      const res = await postJSON('/api/login/password', { username, password });
+      if (!res.ok) throw new Error('Incorrect email or password.');
+      return res.json();
+    }
+
+    // One-tap sign-in with credentials saved on this device. Rejects with
+    // NotAllowedError when unsupported, nothing is saved, or the user dismisses it.
+    async function authenticateWithImmediateUi() {
+      const { immediateGet } = await getCapabilities();
+      if (!immediateGet) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+      const publicKey = await fetchRequestOptions();
+      // No signal and no allowCredentials: both make immediate mode reject
+      const cred = await navigator.credentials.get({ password: true, publicKey, uiMode: 'immediate' });
+      if (!cred) throw new DOMException('No credential returned', 'NotAllowedError');
+
+      if (cred.type === 'public-key') return verifyPasskey(cred, publicKey);
+      if (cred.type === 'password') return verifyPassword(cred.id, cred.password);
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    function completeSignIn(user) {
+      const destination = pendingDestination;
+      document.body.dataset.signedIn = 'true';
+      if (dialog.open) dialog.close();
+      if (destination) {
+        location.assign(destination);
+        return;
+      }
+      const accountLink = document.querySelector('a[href="/account"]');
+      if (user?.name && accountLink) accountLink.textContent = `Hi, ${user.name}`;
+    }
+
+    // Passkey suggestions in the email field's autofill dropdown
+    async function startConditionalUi() {
+      const { conditionalGet } = await getCapabilities();
+      if (!conditionalGet) return;
+      conditionalAbort?.abort();
+      conditionalAbort = new AbortController();
+      try {
+        const publicKey = await fetchRequestOptions();
+        const cred = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: conditionalAbort.signal,
+        });
+        completeSignIn(await verifyPasskey(cred, publicKey));
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        errorEl.textContent = err.message;
+      }
+    }
+
+    async function openSignInDialog(message = '') {
+      intro.textContent = pendingDestination
+        ? 'Sign in to continue — you’ll pick up right where you left off.'
+        : 'Sign in to collect rewards and order ahead.';
+      errorEl.textContent = message;
+      passkeyButton.hidden = !window.PublicKeyCredential;
+      dialog.showModal();
+      startConditionalUi();
+    }
+
+    async function handleAuthClick(event, destination) {
+      if (isSignedIn()) return; // follow the link normally
+      event.preventDefault();
+      if (isAuthenticating) return;
+
+      isAuthenticating = true;
+      pendingDestination = destination;
+      try {
+        completeSignIn(await authenticateWithImmediateUi());
+      } catch (err) {
+        // No local credentials (or dismissed): stay on the page with the inline form
+        openSignInDialog(err.name === 'NotAllowedError' ? '' : err.message);
+      } finally {
+        isAuthenticating = false;
+      }
+    }
+
+    for (const link of document.querySelectorAll('a[data-requires-auth]')) {
+      link.addEventListener('click', (event) => handleAuthClick(event, link.href));
+    }
+    for (const link of document.querySelectorAll('a[data-signin-trigger]')) {
+      link.addEventListener('click', (event) => handleAuthClick(event, null));
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      errorEl.textContent = '';
+      const username = form.email.value;
+      const password = form.password.value;
+      try {
+        const user = await verifyPassword(username, password);
+        // Save to the browser's password manager so next visit can be one tap
+        if ('PasswordCredential' in window) {
+          await navigator.credentials
+            .store(new PasswordCredential({ id: username, password, name: user?.name }))
+            .catch(() => {});
+        }
+        completeSignIn(user);
+      } catch (err) {
+        errorEl.textContent = err.message;
+      }
+    });
+
+    // Modal passkey prompt: also offers phones (QR) and security keys
+    passkeyButton.addEventListener('click', async () => {
+      conditionalAbort?.abort();
+      errorEl.textContent = '';
+      try {
+        const publicKey = await fetchRequestOptions();
+        const cred = await navigator.credentials.get({ publicKey });
+        completeSignIn(await verifyPasskey(cred, publicKey));
+      } catch (err) {
+        if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+          errorEl.textContent = err.message;
+        }
+        startConditionalUi();
+      }
+    });
+
+    document.getElementById('show-password').addEventListener('change', (event) => {
+      form.password.type = event.target.checked ? 'text' : 'password';
+    });
+
+    dialog.addEventListener('close', () => {
+      conditionalAbort?.abort();
+      pendingDestination = null;
+    });
+
+    // Light-dismiss fallback where <dialog closedby> isn't supported
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+  </script>
+
