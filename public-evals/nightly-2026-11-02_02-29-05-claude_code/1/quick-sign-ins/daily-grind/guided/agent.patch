+    <p class="signin-intro">Sign in to collect rewards and order ahead.</p>
+    <form id="signin-form" action="/signin" method="post">
+      <label for="email">Email</label>
+      <input type="email" id="email" name="email" autocomplete="username webauthn" spellcheck="false" enterkeyhint="next" required autofocus>
+      <label for="password">Password</label>
