diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,26 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Fetch</title>
+</head>
+<body>
+  <button id="go" type="button">Load</button>
+  <script>
+    document.getElementById('go').addEventListener('click', () => {
+      // Critical data: high priority so it wins any bandwidth contention.
+      fetch('/api/data', { priority: 'high' });
+
+      // Analytics: low priority so it doesn't slow down the critical request.
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true
+      });
+    });
+  </script>
+</body>
+</html>
