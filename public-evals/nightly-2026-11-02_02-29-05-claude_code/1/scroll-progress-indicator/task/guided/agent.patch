@@ -151,13 +151,48 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Scroll Progress Indicator */
+    .scroll-progress {
+      display: none;
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform-origin: 0 50%;
+      transform: scaleX(0);
+      z-index: 1001;
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: scroll()) {
+        @keyframes grow-progress {
+          from { transform: scaleX(0); }
+          to { transform: scaleX(1); }
+        }
+
+        .scroll-progress {
+          display: block;
+          animation: grow-progress auto linear;
+          animation-timeline: scroll(root block);
+        }
+      }
+
+      .scroll-progress.is-fallback {
+        display: block;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroll-progress" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +241,34 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without scroll-driven animations (e.g. Firefox)
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      const progress = document.querySelector('.scroll-progress');
+      let ticking = false;
+
+      const update = () => {
+        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
+        const ratio = scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 0;
+        progress.style.transform = `scaleX(${ratio})`;
+        ticking = false;
+      };
+
+      const requestUpdate = () => {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      };
+
+      progress.classList.add('is-fallback');
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      update();
+    }
+  </script>
+
 </body>
 
 </html>
