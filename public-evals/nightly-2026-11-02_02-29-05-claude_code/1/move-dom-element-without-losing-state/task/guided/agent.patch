+  <script>
+    (() => {
+      const video = document.getElementById('roast-video');
+      const toggle = document.getElementById('theater-toggle');
+      const hero = document.querySelector('.hero');
+      const theaterSlot = document.getElementById('theater-slot');
+      const homeSlot = document.getElementById('video-section');
+      const homeNext = toggle; // the iframe lives just before the button
+      const YT_ORIGIN = 'https://www.youtube.com';
+      const canMoveAtomically = 'moveBefore' in Element.prototype;
+
+      // Fallback: without moveBefore(), moving the iframe reloads it. Track the
+      // player's time/state via the YouTube embed postMessage protocol so the
+      // reloaded player can resume where it left off.
+      const player = { currentTime: 0, playerState: -1 };
+      if (!canMoveAtomically) {
+        const listen = () => video.contentWindow.postMessage(
+          JSON.stringify({ event: 'listening', id: video.id, channel: 'widget' }), YT_ORIGIN);
+        video.addEventListener('load', listen);
+        listen();
+        window.addEventListener('message', (e) => {
+          if (e.origin !== YT_ORIGIN || e.source !== video.contentWindow) return;
+          let data;
+          try { data = JSON.parse(e.data); } catch { return; }
+          if (data && data.info && typeof data.info === 'object') {
+            if (typeof data.info.currentTime === 'number') player.currentTime = data.info.currentTime;
+            if (typeof data.info.playerState === 'number') player.playerState = data.info.playerState;
+          }
+        });
+      }
+
+      function moveVideo(parent, before) {
+        if (canMoveAtomically) {
+          // Atomic move: keeps the iframe's browsing context, so playback continues.
+          parent.moveBefore(video, before);
+          return;
+        }
+        const url = new URL(video.src);
+        url.searchParams.set('start', String(Math.floor(player.currentTime)));
+        // 1 = playing, 3 = buffering
+        url.searchParams.set('autoplay', [1, 3].includes(player.playerState) ? '1' : '0');
+        video.remove(); // detach first so changing src doesn't trigger an extra load
+        video.src = url.href;
+        parent.insertBefore(video, before);
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+        if (entering) {
+          theaterSlot.hidden = false;
+          moveVideo(theaterSlot, null);
+          hero.classList.add('theater');
+          window.scrollTo({ top: 0, behavior: 'smooth' }); // hero sits at the top, under the sticky nav
+        } else {
+          moveVideo(homeSlot, homeNext);
+          theaterSlot.hidden = true;
+          hero.classList.remove('theater');
+        }
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit Theater Mode' : 'Theater Mode';
+      });
+    })();
+  </script>
