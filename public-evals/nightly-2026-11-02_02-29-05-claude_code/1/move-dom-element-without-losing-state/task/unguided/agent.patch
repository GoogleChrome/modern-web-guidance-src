+  <script>
+    (function () {
+      var frame = document.getElementById('roasting-video');
+      var toggle = document.getElementById('theater-toggle');
+      var hero = document.querySelector('.hero');
+      var section = document.getElementById('roasting');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+
+      // Element.moveBefore() keeps an iframe's browsing context alive across a move.
+      // Plain appendChild() detaches the iframe, which makes it reload from scratch.
+      var canMoveAtomically = typeof Element.prototype.moveBefore === 'function';
+
+      // The fallback path uses the YouTube IFrame API to read the playback position
+      // before a move and restore it after the reload.
+      var player = null;
+      if (!canMoveAtomically) {
+        window.onYouTubeIframeAPIReady = function () {
+          player = new YT.Player(frame);
+        };
+        var api = document.createElement('script');
+        api.src = 'https://www.youtube.com/iframe_api';
+        document.head.appendChild(api);
+      }
+
+      function moveFrame(slot) {
+        if (frame.parentNode === slot) return;
+
+        if (canMoveAtomically) {
+          try {
+            slot.moveBefore(frame, null);
+            return;
+          } catch (e) {
+            // moveBefore() throws if the move isn't allowed (e.g. across documents).
+            // Fall through to the reload path.
+          }
+        }
+
+        var resumeAt = 0;
+        var wasPlaying = false;
+        if (player && typeof player.getCurrentTime === 'function') {
+          resumeAt = player.getCurrentTime() || 0;
+          wasPlaying = player.getPlayerState() === YT.PlayerState.PLAYING;
+        }
+
+        slot.appendChild(frame); // the iframe reloads here
+
+        if (window.YT && YT.Player) {
+          // The old player is bound to the discarded document, so attach a new one.
+          player = new YT.Player(frame, {
+            events: {
+              onReady: function (e) {
+                if (resumeAt > 0) e.target.seekTo(resumeAt, true);
+                if (wasPlaying) {
+                  e.target.playVideo();
+                } else if (resumeAt > 0) {
+                  e.target.pauseVideo();
+                }
+              }
+            }
+          });
+        }
+      }
+
+      toggle.addEventListener('click', function () {
+        var entering = frame.parentNode !== heroSlot;
+        moveFrame(entering ? heroSlot : mainSlot);
+        hero.classList.toggle('theater', entering);
+        section.classList.toggle('theater', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit Theater Mode' : 'Theater Mode';
+        (entering ? hero : section).scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    })();
+  </script>
