+  <script>
+    const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+    document.getElementById("theme-toggle").addEventListener("click", () => {
+      const system = systemDark.matches ? "dark" : "light";
+      const rendered = colorSchemeMeta.content === "light dark" ? system : colorSchemeMeta.content;
+      const target = rendered === "dark" ? "light" : "dark";
+      // Toggling back to the system scheme clears the override instead of pinning it
+      const override = target === system ? null : target;
+
+      colorSchemeMeta.content = override ?? "light dark";
+      try {
+        if (override) {
+          localStorage.setItem("color-scheme", override);
+        } else {
+          localStorage.removeItem("color-scheme");
+        }
+      } catch {}
+    });
+
+    // Keep other open tabs in sync
+    addEventListener("storage", (event) => {
+      if (event.key === "color-scheme" || event.key === null) {
+        colorSchemeMeta.content = event.newValue ?? "light dark";
+      }
+    });
+  </script>
+
