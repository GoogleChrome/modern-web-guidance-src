+
+    /* Icon system
+       Add class="icon" plus an icon-* class to any element; the glyph is drawn in a
+       ::before pseudo-element, so it is purely presentational and never announced by
+       screen readers (the element's own text provides the accessible name).
+       Customise per element with --icon (which glyph), --icon-size and color. */
+    .icon {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.45em;
+    }
+
+    .icon::before {
+      content: "";
+      flex-shrink: 0;
+      width: var(--icon-size, 1.1em);
+      height: var(--icon-size, 1.1em);
+      background-color: currentColor;
+      -webkit-mask: var(--icon) center / contain no-repeat;
+      mask: var(--icon) center / contain no-repeat;
+    }
+
+    /* Place the icon after the label instead of before it */
+    .icon-trailing::before {
+      order: 1;
+    }
+
+    .icon-coffee { --icon: var(--icon-coffee); }
+    .icon-map-pin { --icon: var(--icon-map-pin); }
+    .icon-gift { --icon: var(--icon-gift); }
+    .icon-user { --icon: var(--icon-user); }
+    .icon-log-out { --icon: var(--icon-log-out); }
+    .icon-bag { --icon: var(--icon-bag); }
+    .icon-arrow-right { --icon: var(--icon-arrow-right); }
+    .icon-leaf { --icon: var(--icon-leaf); }
+    .icon-flame { --icon: var(--icon-flame); }
+    .icon-snowflake { --icon: var(--icon-snowflake); }
+
+    /* Keep icons visible in Windows High Contrast / forced-colors mode */
+    @media (forced-colors: active) {
+      .icon::before {
+        forced-color-adjust: none;
+        background-color: CanvasText;
+      }
+
+      a.icon::before {
+        background-color: LinkText;
+      }
+    }
+
+    .btn.icon-arrow-right::before {
+      transition: transform 0.2s;
+    }
+
+    .btn.icon-arrow-right:hover::before {
+      transform: translateX(3px);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn.icon-arrow-right:hover::before {
+        transform: none;
+      }
+    }
