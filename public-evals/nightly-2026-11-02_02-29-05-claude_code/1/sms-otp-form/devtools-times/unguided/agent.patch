@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_LENGTH,
+  OTP_MAX_ATTEMPTS,
+  json,
+  otpMatches,
+  type PendingOtp,
+  type VerifiedPhone,
+} from '../../../utils/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const code = typeof body?.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== OTP_LENGTH) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code we sent you.` }, 400);
+  }
+
+  const pending = (await session.get('pendingOtp')) as PendingOtp | undefined;
+  if (!pending) {
+    return json({ error: 'No verification in progress. Please request a new code.', expired: true }, 400);
+  }
+
+  if (Date.now() > pending.expiresAt) {
+    session.delete('pendingOtp');
+    return json({ error: 'This code has expired. Please request a new one.', expired: true }, 400);
+  }
+
+  if (!otpMatches(pending, code)) {
+    const attempts = pending.attempts + 1;
+    if (attempts >= OTP_MAX_ATTEMPTS) {
+      session.delete('pendingOtp');
+      return json({ error: 'Too many incorrect attempts. Please request a new code.', expired: true }, 429);
+    }
+    await session.set('pendingOtp', { ...pending, attempts });
+    const remaining = OTP_MAX_ATTEMPTS - attempts;
+    return json(
+      { error: `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} remaining.` },
+      400,
+    );
+  }
+
+  session.delete('pendingOtp');
+  const verified: VerifiedPhone = { phone: pending.phone, verifiedAt: Date.now() };
+  await session.set('verifiedPhone', verified);
+
+  return json({ verified: true });
+};
