@@ -0,0 +1,72 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_MAX_SENDS,
+  OTP_RESEND_COOLDOWN_MS,
+  OTP_TTL_MS,
+  formatOtpMessage,
+  generateOtp,
+  hashOtp,
+  json,
+  maskPhone,
+  normalizePhone,
+  sendSms,
+  type PendingOtp,
+} from '../../../utils/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const phone = normalizePhone(body?.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including the country code, e.g. +1 555 123 4567.' }, 400);
+  }
+
+  const now = Date.now();
+  const previous = (await session.get('pendingOtp')) as PendingOtp | undefined;
+  const samePhone = previous?.phone === phone;
+
+  if (samePhone && previous) {
+    const retryAfterMs = previous.lastSentAt + OTP_RESEND_COOLDOWN_MS - now;
+    if (retryAfterMs > 0) {
+      const retryAfter = Math.ceil(retryAfterMs / 1000);
+      return json(
+        { error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter },
+        429,
+        { 'Retry-After': String(retryAfter) },
+      );
+    }
+    if (previous.sendCount >= OTP_MAX_SENDS) {
+      return json({ error: 'Too many codes requested. Please try again later.' }, 429);
+    }
+  }
+
+  const code = generateOtp();
+  const pending: PendingOtp = {
+    phone,
+    codeHash: hashOtp(phone, code),
+    expiresAt: now + OTP_TTL_MS,
+    lastSentAt: now,
+    sendCount: samePhone && previous ? previous.sendCount + 1 : 1,
+    attempts: 0,
+  };
+
+  try {
+    const host = process.env.OTP_ORIGIN_HOST || url.host;
+    await sendSms(phone, formatOtpMessage(code, host));
+  } catch (err) {
+    console.error('Failed to send verification SMS', err);
+    return json({ error: 'We could not send a text message right now. Please try again later.' }, 502);
+  }
+
+  await session.set('pendingOtp', pending);
+  session.delete('verifiedPhone');
+
+  return json({
+    phone: maskPhone(phone),
+    expiresIn: OTP_TTL_MS / 1000,
+    resendIn: OTP_RESEND_COOLDOWN_MS / 1000,
+  });
+};
