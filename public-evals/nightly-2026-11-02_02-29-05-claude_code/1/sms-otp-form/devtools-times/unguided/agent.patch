@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { VERIFIED_PHONE_TTL_MS, json, type VerifiedPhone } from '../../utils/phoneVerification';
+
+const REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  const verified = (await session.get('verifiedPhone')) as VerifiedPhone | undefined;
+  if (!verified || Date.now() - verified.verifiedAt > VERIFIED_PHONE_TTL_MS) {
+    session.delete('verifiedPhone');
+    return json({ error: 'Please verify your phone number before signing up.', phoneUnverified: true }, 403);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const { username, password } = body ?? {};
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  const upstream = await fetch(REGISTER_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password, phone: verified.phone }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+
+  if (upstream.ok) {
+    session.delete('verifiedPhone');
+  }
+
+  return json(data, upstream.status);
+};
