+import type { APIRoute } from 'astro';
+import { OTP_LENGTH, OTP_MAX_ATTEMPTS, json, otpMatches, type PendingOtp } from '../../../lib/sms-otp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are not available.' }, 500);
+  }
+
+  const { code } = await request.json().catch(() => ({}));
+  if (typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code from the text message.` }, 400);
+  }
+
+  const pending = (await session.get('pendingOtp')) as PendingOtp | undefined;
+  if (!pending) {
+    return json({ error: 'No verification code is pending. Request a new code.' }, 400);
+  }
+  if (Date.now() > pending.expiresAt) {
+    session.delete('pendingOtp');
+    return json({ error: 'That code has expired. Request a new code.' }, 410);
+  }
+  if (pending.attempts >= OTP_MAX_ATTEMPTS) {
+    session.delete('pendingOtp');
+    return json({ error: 'Too many incorrect attempts. Request a new code.' }, 429);
+  }
+
+  if (!otpMatches(code, pending.codeHash)) {
+    const attempts = pending.attempts + 1;
+    session.set('pendingOtp', { ...pending, attempts });
+    const remaining = OTP_MAX_ATTEMPTS - attempts;
+    return json({
+      error: remaining > 0
+        ? `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} left.`
+        : 'Too many incorrect attempts. Request a new code.',
+    }, 400);
+  }
+
+  session.delete('pendingOtp');
+  session.set('verifiedPhone', pending.phone);
+  return json({ phone: pending.phone, verified: true });
+};
