@@ -0,0 +1,7 @@
+// Shared by the client and server, so it must not import Node built-ins.
+// Accepts common human formatting ("+1 (555) 010-0000") and returns E.164, or null.
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const stripped = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(stripped) ? stripped : null;
+}
diff --git a/src/lib/sms-otp.ts b/src/lib/sms-otp.ts
new file mode 100644
index 0000000..72deb6c
--- /dev/null
+++ b/src/lib/sms-otp.ts
@@ -0,0 +1,49 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export { normalizePhone } from './phone';
+
+export const OTP_LENGTH = 6;
+export const OTP_TTL_MS = 5 * 60 * 1000;
+export const OTP_RESEND_COOLDOWN_MS = 30 * 1000;
+export const OTP_MAX_ATTEMPTS = 5;
+
+export interface PendingOtp {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+export function generateOtp(): string {
+  return randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+}
+
+export function hashOtp(code: string): string {
+  return createHash('sha256').update(code).digest('hex');
+}
+
+export function otpMatches(code: string, codeHash: string): boolean {
+  const a = Buffer.from(hashOtp(code), 'hex');
+  const b = Buffer.from(codeHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+// The last line must be "@<host> #<code>" so WebOTP and iOS/macOS one-time-code
+// autofill can bind the code to this origin.
+export function composeOtpMessage(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+export async function sendSms(to: string, body: string): Promise<void> {
+  // TODO: Wire up an SMS provider (e.g. Twilio, Vonage). Until then, log the
+  // message so the flow can be exercised in development.
+  console.info(`[sms] to=${to}\n${body}`);
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
