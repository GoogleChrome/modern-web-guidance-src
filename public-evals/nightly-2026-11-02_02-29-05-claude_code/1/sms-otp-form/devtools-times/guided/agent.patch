+import type { APIRoute } from 'astro';
+import {
+  OTP_RESEND_COOLDOWN_MS,
+  OTP_TTL_MS,
+  composeOtpMessage,
+  generateOtp,
+  hashOtp,
+  json,
+  normalizePhone,
+  sendSms,
+  type PendingOtp,
+} from '../../../lib/sms-otp';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are not available.' }, 500);
+  }
+
+  const { phone: rawPhone } = await request.json().catch(() => ({}));
+  const phone = normalizePhone(rawPhone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including the country code, e.g. +1 555 010 0000.' }, 400);
+  }
+
+  const now = Date.now();
+  const pending = (await session.get('pendingOtp')) as PendingOtp | undefined;
+  if (pending && pending.phone === phone && now - pending.sentAt < OTP_RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((OTP_RESEND_COOLDOWN_MS - (now - pending.sentAt)) / 1000);
+    return json({ error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter }, 429);
+  }
+
+  const code = generateOtp();
+  const next: PendingOtp = {
+    phone,
+    codeHash: hashOtp(code),
+    expiresAt: now + OTP_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  };
+  session.set('pendingOtp', next);
+  session.delete('verifiedPhone');
+
+  try {
+    await sendSms(phone, composeOtpMessage(code, url.hostname));
+  } catch {
+    session.delete('pendingOtp');
+    return json({ error: 'We could not send a text message to that number. Please try again.' }, 502);
+  }
+
+  return json({ phone, expiresIn: OTP_TTL_MS / 1000, resendIn: OTP_RESEND_COOLDOWN_MS / 1000 });
+};
