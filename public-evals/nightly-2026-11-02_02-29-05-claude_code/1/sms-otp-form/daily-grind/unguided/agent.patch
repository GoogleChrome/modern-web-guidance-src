+  <script>
+    (function () {
+      var form = document.getElementById('otp-form');
+      var input = document.getElementById('otp-code');
+      var message = document.getElementById('otp-message');
+      var submitBtn = document.getElementById('otp-submit');
+      var resendBtn = document.getElementById('otp-resend');
+      var resendStatus = document.getElementById('otp-resend-status');
+      var CODE_LENGTH = 6;
+      var RESEND_COOLDOWN = 30;
+      var otpAbort = null;
+
+      function setMessage(text, type) {
+        message.textContent = text;
+        message.className = 'otp-message' + (type ? ' ' + type : '');
+      }
+
+      function selectedPurpose() {
+        return form.querySelector('input[name="purpose"]:checked').value;
+      }
+
+      // Keep only digits so pasted values like "123-456" or "Code: 123456" still work.
+      input.addEventListener('input', function () {
+        var digits = input.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (digits !== input.value) input.value = digits;
+        if (input.getAttribute('aria-invalid') === 'true') {
+          input.setAttribute('aria-invalid', 'false');
+          setMessage('');
+        }
+        // Auto-submit once a full code arrives (typed, pasted, or autofilled).
+        if (digits.length === CODE_LENGTH) form.requestSubmit();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var code = input.value;
+        if (!/^\d{6}$/.test(code)) {
+          input.setAttribute('aria-invalid', 'true');
+          setMessage('Please enter the 6-digit code from your text message.', 'error');
+          input.focus();
+          return;
+        }
+        if (otpAbort) otpAbort.abort();
+
+        submitBtn.disabled = true;
+        setMessage('Verifying…');
+
+        fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ code: code, purpose: selectedPurpose() })
+        })
+          .then(function (res) {
+            if (!res.ok) throw new Error('invalid');
+            return res.json().catch(function () { return {}; });
+          })
+          .then(function (data) {
+            setMessage('Verified! Redirecting…', 'success');
+            var fallback = selectedPurpose() === 'order' ? '/order-online' : '/rewards';
+            window.location.assign(data.redirect || fallback);
+          })
+          .catch(function () {
+            input.setAttribute('aria-invalid', 'true');
+            setMessage('That code didn’t work. Check your text message and try again, or request a new code.', 'error');
+            input.select();
+            input.focus();
+          })
+          .finally(function () {
+            submitBtn.disabled = false;
+          });
+      });
+
+      // WebOTP API: reads the code from an incoming SMS on supported browsers (e.g. Chrome on Android).
+      // The SMS must end with a domain-bound line such as:
+      //   Your Daily Grind code is 123456.
+      //
+      //   @dailygrind.com #123456
+      function listenForSmsCode() {
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        if (otpAbort) otpAbort.abort();
+        otpAbort = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: otpAbort.signal })
+          .then(function (otp) {
+            if (!otp || !otp.code) return;
+            input.value = otp.code;
+            input.dispatchEvent(new Event('input', { bubbles: true }));
+          })
+          .catch(function () { /* Aborted, timed out, or declined — manual entry still works. */ });
+      }
+
+      function startResendCooldown() {
+        var remaining = RESEND_COOLDOWN;
+        resendBtn.disabled = true;
+        resendBtn.textContent = 'Resend code (' + remaining + 's)';
+        var timer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(timer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+            resendStatus.textContent = 'You can now request a new code.';
+          } else {
+            resendBtn.textContent = 'Resend code (' + remaining + 's)';
+          }
+        }, 1000);
+      }
+
+      resendBtn.addEventListener('click', function () {
+        startResendCooldown();
+        fetch('/send-otp', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ purpose: selectedPurpose() })
+        })
+          .then(function (res) {
+            if (!res.ok) throw new Error('failed');
+            input.value = '';
+            input.setAttribute('aria-invalid', 'false');
+            setMessage('A new code is on its way.', 'success');
+            listenForSmsCode();
+            input.focus();
+          })
+          .catch(function () {
+            setMessage('We couldn’t send a new code right now. Please try again shortly.', 'error');
+          });
+      });
+
+      listenForSmsCode();
+    })();
+  </script>
+
 </body>
 
