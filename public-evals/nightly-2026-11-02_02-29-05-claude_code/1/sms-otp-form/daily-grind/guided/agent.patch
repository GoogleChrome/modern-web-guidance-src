+  <script>
+    (() => {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneError = document.getElementById('phone-error');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpError = document.getElementById('otp-error');
+      const otpPhone = document.getElementById('otp-phone');
+      const otpPurpose = document.getElementById('otp-purpose');
+      const otpPhoneDisplay = document.getElementById('otp-phone-display');
+      const resendBtn = document.getElementById('resend-btn');
+      const changeNumberBtn = document.getElementById('change-number-btn');
+      const status = document.getElementById('verify-status');
+
+      const messages = {
+        phone: 'Enter a valid mobile number, using digits and an optional leading +.',
+        otp: 'Enter the 6-digit code from your text message.',
+      };
+
+      let otpAbortController = null;
+
+      // Script handles validation messaging; native validation remains the no-JS fallback.
+      phoneForm.noValidate = true;
+      otpForm.noValidate = true;
+
+      function validate(input, errorEl, message) {
+        const valid = input.checkValidity();
+        errorEl.textContent = valid ? '' : message;
+        input.setAttribute('aria-invalid', String(!valid));
+        return valid;
+      }
+
+      function clearError(input, errorEl) {
+        errorEl.textContent = '';
+        input.removeAttribute('aria-invalid');
+      }
+
+      phoneInput.addEventListener('blur', () => {
+        if (phoneInput.value) validate(phoneInput, phoneError, messages.phone);
+      });
+      phoneInput.addEventListener('input', () => clearError(phoneInput, phoneError));
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value) validate(otpInput, otpError, messages.otp);
+      });
+      otpInput.addEventListener('input', () => clearError(otpInput, otpError));
+
+      async function post(form) {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          body: new FormData(form),
+          headers: { Accept: 'application/json' },
+        });
+        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
+        return response;
+      }
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return;
+
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp) return;
+          otpInput.value = otp.code;
+          clearError(otpInput, otpError);
+          otpForm.requestSubmit();
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP verification error:', err);
+        }
+      }
+
+      async function sendCode() {
+        await post(phoneForm);
+        otpPhone.value = phoneInput.value.trim();
+        otpPurpose.value = new FormData(phoneForm).get('purpose');
+        otpPhoneDisplay.textContent = otpPhone.value;
+        startSmsOtpListener();
+      }
+
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (!validate(phoneInput, phoneError, messages.phone)) {
+          phoneInput.focus();
+          return;
+        }
+
+        const submitBtn = phoneForm.querySelector('[type="submit"]');
+        submitBtn.disabled = true;
+        status.textContent = 'Sending your code…';
+        try {
+          await sendCode();
+          phoneForm.hidden = true;
+          otpForm.hidden = false;
+          otpInput.value = '';
+          otpInput.focus();
+          status.textContent = 'Code sent. Check your text messages.';
+        } catch (err) {
+          status.textContent = "We couldn't send a code right now. Please try again.";
+        } finally {
+          submitBtn.disabled = false;
+        }
+      });
+
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        stopSmsOtpListener();
+        if (!validate(otpInput, otpError, messages.otp)) {
+          otpInput.focus();
+          return;
+        }
+
+        const submitBtn = otpForm.querySelector('[type="submit"]');
+        submitBtn.disabled = true;
+        status.textContent = 'Verifying…';
+        try {
+          await post(otpForm);
+          status.textContent = 'Verified! Redirecting…';
+          window.location.assign(otpPurpose.value === 'order' ? '/order-online' : '/rewards');
+        } catch (err) {
+          submitBtn.disabled = false;
+          otpError.textContent = "That code didn't work. Check it and try again, or request a new code.";
+          otpInput.setAttribute('aria-invalid', 'true');
+          status.textContent = '';
+          otpInput.focus();
+          startSmsOtpListener();
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        resendBtn.disabled = true;
+        status.textContent = 'Sending a new code…';
+        try {
+          await sendCode();
+          otpInput.value = '';
+          clearError(otpInput, otpError);
+          status.textContent = 'A new code is on its way.';
+        } catch (err) {
+          status.textContent = "We couldn't send a new code right now. Please try again.";
+        } finally {
+          resendBtn.disabled = false;
+          otpInput.focus();
+        }
+      });
+
+      changeNumberBtn.addEventListener('click', () => {
+        stopSmsOtpListener();
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        clearError(otpInput, otpError);
+        status.textContent = '';
+        phoneInput.focus();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
