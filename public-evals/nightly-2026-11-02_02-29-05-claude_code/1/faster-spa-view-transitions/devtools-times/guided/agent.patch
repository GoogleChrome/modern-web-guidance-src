+}
+/* Previously visited views kept alive by src/scripts/view-cache.ts */
+.spa-view.inactive {
+  /* Skip layout/paint but keep the cached rendering state */
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
