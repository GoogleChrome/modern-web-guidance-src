+
+  <script>
+    (function () {
+      const app = document.getElementById('app');
+      const BASE_TITLE = 'The Daily Grind';
+
+      const MENU = [
+        { name: 'Maple Oat Latte', cat: 'espresso', price: 5.75, desc: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+        { name: 'Dark Roast Espresso', cat: 'espresso', price: 3.5, desc: 'Bold, smokey, and perfect for a morning boost.' },
+        { name: 'Flat White', cat: 'espresso', price: 4.75, desc: 'Velvety microfoam over a double ristretto.' },
+        { name: 'House Drip', cat: 'brewed', price: 2.95, desc: 'Our rotating single-origin, brewed fresh every 30 minutes.' },
+        { name: 'Pour Over', cat: 'brewed', price: 4.5, desc: 'Hand-poured to order. Ask about today’s beans.' },
+        { name: 'Chai Latte', cat: 'brewed', price: 5.25, desc: 'House-spiced black tea with steamed milk.' },
+        { name: 'Cold Brew', cat: 'cold', price: 4.95, desc: 'Steeped for 18 hours for maximum smoothness.' },
+        { name: 'Nitro Cold Brew', cat: 'cold', price: 5.5, desc: 'Nitrogen-infused for a creamy, stout-like pour.' },
+        { name: 'Iced Mocha', cat: 'cold', price: 5.5, desc: 'Espresso, dark chocolate, and cold milk over ice.' },
+        { name: 'Butter Croissant', cat: 'bakery', price: 3.25, desc: 'Flaky, golden, baked every morning.' },
+        { name: 'Blueberry Muffin', cat: 'bakery', price: 3.5, desc: 'Bursting with wild Maine blueberries.' },
+        { name: 'Cinnamon Roll', cat: 'bakery', price: 4.25, desc: 'Brown-butter glaze, best enjoyed warm.' }
+      ];
+
+      const LOCATIONS = [
+        { name: 'Pearl District', address: '1120 NW Couch St, Portland, OR 97209', hours: '6am – 8pm daily' },
+        { name: 'Hawthorne', address: '3530 SE Hawthorne Blvd, Portland, OR 97214', hours: '6:30am – 7pm daily' },
+        { name: 'Capitol Hill', address: '415 E Pine St, Seattle, WA 98122', hours: '6am – 9pm daily' },
+        { name: 'Ballard', address: '5300 Ballard Ave NW, Seattle, WA 98107', hours: '7am – 6pm daily' },
+        { name: 'Mission', address: '2899 Valencia St, San Francisco, CA 94110', hours: '6am – 7pm daily' },
+        { name: 'South Congress', address: '1400 S Congress Ave, Austin, TX 78704', hours: '6am – 10pm daily' }
+      ];
+
+      const REWARDS = [
+        { name: 'Extra Shot or Syrup', cost: 25 },
+        { name: 'Any Bakery Item', cost: 75 },
+        { name: 'Handcrafted Drink', cost: 150 },
+        { name: 'Bag of House Beans', cost: 400 }
+      ];
+
+      const TIERS = [
+        { name: 'Bean', min: 0 },
+        { name: 'Roast', min: 300 },
+        { name: 'Reserve', min: 1000 }
+      ];
+
+      const el = (tag, cls, text) => {
+        const node = document.createElement(tag);
+        if (cls) node.className = cls;
+        if (text != null) node.textContent = text;
+        return node;
+      };
+
+      // Each route: title + optional init(root) run once when the view is first built.
+      const ROUTES = {
+        home: { title: 'Artisanal Coffee' },
+        menu: {
+          title: 'Menu',
+          init(root) {
+            const grid = root.querySelector('[data-menu-grid]');
+            const cards = MENU.map(item => {
+              const card = el('div', 'card');
+              card.dataset.cat = item.cat;
+              card.append(el('h3', null, item.name), el('p', null, item.desc), el('span', 'price', '$' + item.price.toFixed(2)));
+              grid.append(card);
+              return card;
+            });
+            const buttons = root.querySelectorAll('[data-filter]');
+            root.querySelector('.tabs').addEventListener('click', e => {
+              const btn = e.target.closest('[data-filter]');
+              if (!btn) return;
+              const f = btn.dataset.filter;
+              buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
+              cards.forEach(c => { c.hidden = f !== 'all' && c.dataset.cat !== f; });
+            });
+          }
+        },
+        locations: {
+          title: 'Locations',
+          init(root) {
+            const grid = root.querySelector('[data-location-grid]');
+            const empty = root.querySelector('[data-location-empty]');
+            const cards = LOCATIONS.map(loc => {
+              const card = el('div', 'card left');
+              card.append(el('h3', null, loc.name), el('p', null, loc.address), el('p', 'muted', loc.hours));
+              card.dataset.search = (loc.name + ' ' + loc.address).toLowerCase();
+              grid.append(card);
+              return card;
+            });
+            root.querySelector('#location-search').addEventListener('input', e => {
+              const q = e.target.value.trim().toLowerCase();
+              let shown = 0;
+              cards.forEach(c => {
+                c.hidden = !c.dataset.search.includes(q);
+                if (!c.hidden) shown++;
+              });
+              empty.hidden = shown > 0;
+            });
+          }
+        },
+        rewards: {
+          title: 'Rewards',
+          init(root) {
+            let points = 420;
+            const grid = root.querySelector('[data-reward-grid]');
+            const buttons = REWARDS.map(r => {
+              const card = el('div', 'card');
+              const btn = el('button', 'btn', 'Redeem');
+              btn.type = 'button';
+              btn.addEventListener('click', () => {
+                if (points < r.cost) return;
+                points -= r.cost;
+                btn.textContent = 'Redeemed!';
+                btn.dataset.redeemed = '';
+                render();
+              });
+              card.append(el('h3', null, r.name), el('p', 'muted', r.cost + ' beans'), btn);
+              grid.append(card);
+              return { btn, cost: r.cost };
+            });
+            function render() {
+              const tier = TIERS.filter(t => points >= t.min).pop();
+              const next = TIERS.find(t => t.min > points);
+              root.querySelector('[data-points]').textContent = points;
+              root.querySelector('[data-tier]').textContent = tier.name;
+              root.querySelector('[data-progress]').style.width =
+                (next ? Math.round(((points - tier.min) / (next.min - tier.min)) * 100) : 100) + '%';
+              root.querySelector('[data-next-tier]').textContent = next
+                ? (next.min - points) + ' beans to ' + next.name + ' status'
+                : 'You’ve reached our top tier!';
+              buttons.forEach(b => { b.btn.disabled = 'redeemed' in b.btn.dataset || points < b.cost; });
+            }
+            render();
+          }
+        },
+        account: {
+          title: 'My Account',
+          init(root) {
+            const form = root.querySelector('[data-profile-form]');
+            const status = root.querySelector('[data-profile-status]');
+            form.addEventListener('submit', e => {
+              e.preventDefault();
+              status.textContent = 'Saved! Welcome back, ' + form.elements.name.value.trim() + '.';
+            });
+            form.addEventListener('input', () => { status.textContent = ''; });
+          }
+        }
+      };
+
+      // Cache of built views: name -> { root, scrollY }. Views are hidden, never destroyed.
+      const views = new Map();
+      views.set('home', { root: app.querySelector('[data-view="home"]'), scrollY: 0 });
+      let current = null;
+
+      function getView(name) {
+        let view = views.get(name);
+        if (view) return view;
+        const root = el('div', 'view');
+        root.dataset.view = name;
+        root.tabIndex = -1;
+        root.hidden = true;
+        root.append(document.getElementById('view-' + name).content.cloneNode(true));
+        ROUTES[name].init?.(root);
+        app.append(root);
+        view = { root, scrollY: 0 };
+        views.set(name, view);
+        return view;
+      }
+
+      function parseRoute() {
+        const name = location.hash.replace(/^#\/?/, '').split(/[/?]/)[0];
+        return ROUTES[name] ? name : 'home';
+      }
+
+      function show(name) {
+        if (name === current) return;
+        const prev = current && views.get(current);
+        if (prev) {
+          prev.scrollY = window.scrollY;
+          prev.root.hidden = true;
+        }
+        const next = getView(name);
+        next.root.hidden = false;
+        const isInitial = current === null;
+        current = name;
+
+        document.title = BASE_TITLE + ' | ' + ROUTES[name].title;
+        document.querySelectorAll('nav a[data-route]').forEach(a => {
+          if (a.dataset.route === name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        if (!isInitial) {
+          window.scrollTo(0, next.scrollY);
+          next.root.focus({ preventScroll: true });
+        }
+      }
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+      window.addEventListener('hashchange', () => show(parseRoute()));
+      show(parseRoute());
+
+      // Warm up unvisited views during idle time so even first visits are instant.
+      const idle = window.requestIdleCallback || (cb => setTimeout(cb, 200));
+      idle(() => Object.keys(ROUTES).forEach(getView));
+    })();
+  </script>
+
 </body>
 
