+  <template id="view-account">
+    <header class="page-header">
+      <h1>My Account</h1>
+      <p>Manage your profile and see recent orders.</p>
+    </header>
+    <main class="container">
+      <div class="grid">
+        <section class="card left">
+          <h3>Profile</h3>
+          <form class="form" data-profile-form>
+            <label>Name <input name="name" value="Alex Rivera" required></label>
+            <label>Email <input name="email" type="email" value="alex@example.com" required></label>
+            <label>Favorite drink
+              <select name="favorite">
