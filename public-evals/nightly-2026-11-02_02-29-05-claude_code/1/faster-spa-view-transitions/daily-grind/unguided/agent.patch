+              <select name="store">
+                <option>Pearl District</option>
+                <option>Hawthorne</option>
+                <option>Capitol Hill</option>
+                <option>Mission</option>
+              </select>
+            </label>
+            <button type="submit" class="btn">Save Changes</button>
+            <p class="status" role="status" data-profile-status></p>
+          </form>
+        </section>
+        <section class="card left">
+          <h3>Recent Orders</h3>
+          <table>
+            <thead>
+              <tr><th>Date</th><th>Item</th><th>Total</th></tr>
+            </thead>
+            <tbody>
+              <tr><td>Oct 31</td><td>Maple Oat Latte</td><td>$5.75</td></tr>
+              <tr><td>Oct 29</td><td>Cold Brew + Croissant</td><td>$8.25</td></tr>
+              <tr><td>Oct 27</td><td>Dark Roast Espresso</td><td>$3.50</td></tr>
+              <tr><td>Oct 24</td><td>Chai Latte</td><td>$5.25</td></tr>
+            </tbody>
+          </table>
+        </section>
