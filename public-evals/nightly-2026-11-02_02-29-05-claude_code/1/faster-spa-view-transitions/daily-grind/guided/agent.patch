+  <script>
+    const app = document.getElementById('app');
+    const navLinks = document.querySelectorAll('nav a[href^="#/"]');
+
+    const routes = {
+      home: { title: 'The Daily Grind | Artisanal Coffee' },
+      menu: { title: 'Menu | The Daily Grind', init: initMenu },
+      locations: { title: 'Locations | The Daily Grind', init: initLocations },
+      rewards: { title: 'Rewards | The Daily Grind', init: initRewards },
+      account: { title: 'My Account | The Daily Grind', init: initAccount },
+    };
+
+    // Views are created once and then kept in the DOM; inactive ones are hidden
+    // with content-visibility so their layout and state survive navigation.
+    const views = new Map([['home', app.querySelector('[data-view="home"]')]]);
+    const scrollPositions = new Map();
+    let currentView = null;
+
+    history.scrollRestoration = 'manual';
+
+    function routeFromHash() {
+      const name = location.hash.replace(/^#\/?/, '').split(/[/?]/)[0];
+      return Object.hasOwn(routes, name) ? name : 'home';
+    }
+
+    function getView(name) {
+      if (views.has(name)) return views.get(name);
+
+      const view = document.createElement('section');
+      view.className = 'spa-view inactive';
+      view.dataset.view = name;
+      view.tabIndex = -1;
+      view.inert = true;
+      view.append(document.getElementById(`view-${name}`).content.cloneNode(true));
+      view.querySelector('h1').id = `${name}-title`;
+      view.setAttribute('aria-labelledby', `${name}-title`);
+      app.append(view);
+      routes[name].init?.(view);
+      views.set(name, view);
+      return view;
+    }
+
+    function showView(name, { focus = true } = {}) {
+      if (name === currentView) return;
+
+      if (currentView) {
+        scrollPositions.set(currentView, window.scrollY);
+        const previous = views.get(currentView);
+        previous.classList.add('inactive');
+        previous.inert = true;
+      }
+
+      const view = getView(name);
+      view.classList.remove('inactive');
+      view.inert = false;
+      currentView = name;
+
+      document.title = routes[name].title;
+      navLinks.forEach((link) => {
+        if (link.hash === `#/${name}`) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+      });
+
+      window.scrollTo(0, scrollPositions.get(name) ?? 0);
+      if (focus) view.focus({ preventScroll: true });
+    }
+
+    window.addEventListener('hashchange', () => showView(routeFromHash()));
+    showView(routeFromHash(), { focus: false });
+
+    function initMenu(view) {
+      const chips = view.querySelectorAll('[data-filter]');
+      const items = view.querySelectorAll('[data-category]');
+      view.querySelector('.filters').addEventListener('click', (event) => {
+        const chip = event.target.closest('[data-filter]');
+        if (!chip) return;
+        const filter = chip.dataset.filter;
+        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
+        items.forEach((item) => {
+          item.hidden = filter !== 'all' && item.dataset.category !== filter;
+        });
+      });
+    }
+
+    function initLocations(view) {
+      const input = view.querySelector('.search');
+      const items = view.querySelectorAll('[data-search]');
+      const empty = view.querySelector('.empty');
+      input.addEventListener('input', () => {
+        const query = input.value.trim().toLowerCase();
+        let matches = 0;
+        items.forEach((item) => {
+          item.hidden = !item.dataset.search.includes(query);
+          if (!item.hidden) matches++;
+        });
+        empty.hidden = matches > 0;
+      });
+    }
+
+    function initRewards(view) {
+      let points = 240;
+      const status = view.querySelector('.status');
+      const buttons = view.querySelectorAll('[data-cost]');
+
+      function render() {
+        view.querySelector('[data-points]').textContent = points;
+        view.querySelector('[data-meter]').value = points;
+        view.querySelector('[data-next]').textContent = points >= 300
+          ? 'You can redeem any reward!'
+          : `${300 - points} points until a free handcrafted drink.`;
+        buttons.forEach((button) => {
+          button.disabled = points < Number(button.dataset.cost);
+        });
+      }
+
+      view.addEventListener('click', (event) => {
+        const button = event.target.closest('[data-cost]');
+        if (!button) return;
+        points -= Number(button.dataset.cost);
+        status.textContent = `Redeemed: ${button.closest('.card').querySelector('h3').textContent}. Show this screen at checkout.`;
+        render();
+      });
+
+      render();
+    }
+
+    function initAccount(view) {
+      const form = view.querySelector('form');
+      const status = form.querySelector('.status');
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.textContent = 'Your changes have been saved.';
+      });
+      form.addEventListener('input', () => {
+        status.textContent = '';
+      });
+    }
+  </script>
+
 </body>
 
