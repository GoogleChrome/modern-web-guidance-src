     .btn:hover {
       background: #3e2723;
     }
 
+    /* Layout density toggle */
+    .density-controls {
+      /* Probe value used only to feature-check style query support */
+      --style-query-probe: supported;
+      text-align: center;
+    }
+
+    #toggle-spacious {
+      display: none;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+    }
+
+    /* Only browsers that support style queries can match this, so the toggle
+       stays hidden wherever the density change would have no effect */
+    @container style(--style-query-probe: supported) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    #target-container {
+      --density: compact;
+      container-name: density;
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    @container density style(--density: spacious) {
+      #target-item {
+        padding: 48px 36px;
+      }
+    }
+
     footer {
