+  <script>
+    const toggleSpacious = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    toggleSpacious.addEventListener('click', () => {
+      const spacious = toggleSpacious.getAttribute('aria-pressed') !== 'true';
+      targetContainer.style.setProperty('--density', spacious ? 'spacious' : 'compact');
+      toggleSpacious.setAttribute('aria-pressed', String(spacious));
+      toggleSpacious.textContent = spacious ? 'Compact Layout' : 'Spacious Layout';
+    });
