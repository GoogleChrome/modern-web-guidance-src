+    /* Media Scroller */
+    .media-scroller {
+      position: relative;
+      height: 520px;
+      max-width: 640px;
+      margin: 20px auto 0;
+      overflow-y: auto;
+      scroll-behavior: auto;
+      overscroll-behavior: contain;
+      scroll-snap-type: y proximity;
+      scroll-padding: 20px;
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex-shrink: 0;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      scroll-snap-align: start;
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 600 / 400;
+      object-fit: cover;
+      background: var(--secondary);
+    }
+
+    .media-card .media-body {
+      padding: 15px 20px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 5px;
+    }
+
     footer {
       background: var(--secondary);
