+  <script>
+    // Defer offscreen media (sources and posters) until the player nears the viewport.
+    (function () {
+      var media = document.querySelectorAll('.lazy-media');
+
+      function hydrate(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          delete el.dataset.poster;
+        }
+        if (el.dataset.src) {
+          el.src = el.dataset.src;
+          delete el.dataset.src;
+        }
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+          delete source.dataset.src;
+        });
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        media.forEach(hydrate);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            observer.unobserve(entry.target);
+            hydrate(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      media.forEach(function (el) {
+        observer.observe(el);
+      });
+    })();
+
+    // Respect reduced-motion preferences for the autoplaying hero video.
+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      var heroVideo = document.querySelector('.hero-video');
+      heroVideo.removeAttribute('autoplay');
+      heroVideo.pause();
+    }
+  </script>
