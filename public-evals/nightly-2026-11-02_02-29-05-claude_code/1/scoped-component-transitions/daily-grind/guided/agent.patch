+  <script>
+    const SIZE_UPCHARGE = { Small: -0.5, Medium: 0, Large: 0.75 };
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    // Animate a DOM update scoped to one component subtree, so the rest of the
+    // page stays interactive and other components can transition concurrently.
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(updateDOM);
+      // Re-triggering on the same scope skips the active transition and rejects `ready`
+      transition.ready.catch(() => {});
+    }
+
+    function priceFor(card, size) {
+      return Number(card.dataset.price) + SIZE_UPCHARGE[size];
+    }
+
+    function selectedSize(card) {
+      return card.querySelector('.sizes [aria-pressed="true"]').dataset.size;
+    }
+
+    function renderCardPrice(card) {
+      card.querySelector('.price').textContent = currency.format(priceFor(card, selectedSize(card)));
+    }
+
+    // Menu cards
+    const grid = document.querySelector('.menu-layout .grid');
+    grid.querySelectorAll('.card').forEach(renderCardPrice);
+
+    grid.addEventListener('click', (event) => {
+      const card = event.target.closest('.card');
+      if (!card) return;
+
+      const sizeButton = event.target.closest('.sizes button');
+      if (sizeButton && sizeButton.getAttribute('aria-pressed') !== 'true') {
+        runScopedTransition(card, () => {
+          card.querySelectorAll('.sizes button').forEach((button) => {
+            button.setAttribute('aria-pressed', String(button === sizeButton));
+          });
+          renderCardPrice(card);
+        });
+        return;
+      }
+
+      const action = event.target.closest('[data-action]')?.dataset.action;
+      if (action === 'details') {
+        const toggle = event.target.closest('[data-action]');
+        const details = card.querySelector('.card-details');
+        runScopedTransition(card, () => {
+          const expanded = details.hidden;
+          details.hidden = !expanded;
+          toggle.setAttribute('aria-expanded', String(expanded));
+          toggle.textContent = expanded ? 'Less info' : 'More info';
+        });
+      } else if (action === 'add') {
+        addToOrder(card);
+      }
+    });
+
+    // Order panel
+    const order = document.querySelector('.order');
+    const orderList = order.querySelector('.order-list');
+    const orderEmpty = order.querySelector('.order-empty');
+    const orderTotal = order.querySelector('.total-amount');
+    const sortButton = order.querySelector('[data-action="sort"]');
+    const orderStatus = document.getElementById('order-status');
+    let sortAscending = true;
+
+    function lineTotal(li) {
+      return Number(li.dataset.unitPrice) * Number(li.dataset.qty);
+    }
+
+    function renderLine(li) {
+      const qty = Number(li.dataset.qty);
+      li.querySelector('.item-label small').textContent = `${li.dataset.size}${qty > 1 ? ` × ${qty}` : ''}`;
+      li.querySelector('.item-price').textContent = currency.format(lineTotal(li));
+    }
+
+    function renderOrderSummary() {
+      const items = [...orderList.children];
+      orderEmpty.hidden = items.length > 0;
+      sortButton.hidden = items.length < 2;
+      orderTotal.textContent = currency.format(items.reduce((sum, li) => sum + lineTotal(li), 0));
+    }
+
+    function createLine(card, size) {
+      const li = document.createElement('li');
+      li.dataset.id = `${card.dataset.item}-${size}`;
+      li.dataset.size = size;
+      li.dataset.qty = '0';
+      li.dataset.unitPrice = String(priceFor(card, size));
+
+      const label = document.createElement('span');
+      label.className = 'item-label';
+      label.append(card.dataset.name, document.createElement('small'));
+
+      const price = document.createElement('span');
+      price.className = 'item-price';
+
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove';
+      remove.textContent = '×';
+      remove.setAttribute('aria-label', `Remove ${card.dataset.name} (${size})`);
+
+      li.append(label, price, remove);
+      return li;
+    }
+
+    function addToOrder(card) {
+      const size = selectedSize(card);
+      const id = `${card.dataset.item}-${size}`;
+      runScopedTransition(order, () => {
+        let li = orderList.querySelector(`li[data-id="${id}"]`);
+        if (!li) {
+          li = createLine(card, size);
+          orderList.append(li);
+        }
+        li.dataset.qty = String(Number(li.dataset.qty) + 1);
+        renderLine(li);
+        renderOrderSummary();
+      });
+      orderStatus.textContent = `Added ${card.dataset.name} (${size}) to your order.`;
+    }
+
+    function removeLine(li) {
+      const hadFocus = li.contains(document.activeElement);
+      const nextFocusTarget =
+        li.nextElementSibling?.querySelector('.remove') ??
+        li.previousElementSibling?.querySelector('.remove') ??
+        grid.querySelector('[data-action="add"]');
+      const name = li.querySelector('.item-label').firstChild.textContent;
+
+      runScopedTransition(order, () => {
+        li.remove();
+        renderOrderSummary();
+        if (hadFocus) nextFocusTarget?.focus();
+      });
+      orderStatus.textContent = `Removed ${name} (${li.dataset.size}) from your order.`;
+    }
+
+    function sortOrder() {
+      // Move existing nodes so `match-element` can track each line's identity
+      const sorted = [...orderList.children].sort((a, b) =>
+        sortAscending ? lineTotal(a) - lineTotal(b) : lineTotal(b) - lineTotal(a));
+      runScopedTransition(orderList, () => {
+        orderList.append(...sorted);
+      });
+      sortAscending = !sortAscending;
+      sortButton.innerHTML = `Sort: price ${sortAscending ? '&uarr;' : '&darr;'}`;
+    }
+
+    order.addEventListener('click', (event) => {
+      const remove = event.target.closest('.remove');
+      if (remove) {
+        removeLine(remove.closest('li'));
+      } else if (event.target.closest('[data-action="sort"]')) {
+        sortOrder();
+      }
+    });
+
+    renderOrderSummary();
+  </script>
+
 </body>
 
