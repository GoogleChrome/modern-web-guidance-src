+      animation: vt-slide-in 300ms 80ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
+    }
+
+    ::view-transition-old(.part):only-child {
+      animation: vt-fade-out 150ms ease-in both;
+    }
+
+    /* Price ticker */
