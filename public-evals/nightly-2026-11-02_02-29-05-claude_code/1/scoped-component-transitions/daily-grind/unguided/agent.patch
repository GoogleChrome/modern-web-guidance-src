+    }
+
+    ::view-transition-old(.line):only-child {
+      animation: vt-line-out 250ms ease-in both;
+    }
+
+    @keyframes vt-pop-in {
+      from { opacity: 0; transform: scale(0.85); }
+    }
+
+    @keyframes vt-pop-out {
