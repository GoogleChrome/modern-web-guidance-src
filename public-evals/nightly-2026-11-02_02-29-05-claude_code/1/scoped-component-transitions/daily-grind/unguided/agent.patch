+        .finally(() => {
+          const count = activeTransitions.get(scope) - 1;
+          activeTransitions.set(scope, count);
+          if (count === 0) delete scope.dataset.vt;
+        });
+      return transition.updateCallbackDone;
+    }
+
+    const formatPrice = value => `$${value.toFixed(2)}`;
+
+    // Grid: filter and sort
+    const grid = document.getElementById('drink-grid');
+    const cards = [...grid.querySelectorAll('.card')];
+    const filterButtons = document.querySelectorAll('[data-filter]');
+    const sortButton = document.getElementById('sort-btn');
+    const sortModes = [
+      { label: 'Featured', compare: (a, b) => a.dataset.order - b.dataset.order },
+      { label: 'Price: Low to High', compare: (a, b) => a.dataset.price - b.dataset.price },
+      { label: 'Price: High to Low', compare: (a, b) => b.dataset.price - a.dataset.price },
+    ];
+    let sortIndex = 0;
+
+    filterButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        const filter = button.dataset.filter;
+        transitionWithin(grid, () => {
+          filterButtons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
+          cards.forEach(card => {
+            card.hidden = filter !== 'all' && card.dataset.temp !== filter;
+          });
+        });
+      });
+    });
+
+    sortButton.addEventListener('click', () => {
+      sortIndex = (sortIndex + 1) % sortModes.length;
+      const mode = sortModes[sortIndex];
+      transitionWithin(grid, () => {
+        sortButton.textContent = `Sort: ${mode.label}`;
+        [...cards].sort(mode.compare).forEach(card => grid.append(card));
+      });
+    });
+
+    // Cards: expand, choose size, add to order
+    function selectedSize(card) {
+      const input = card.querySelector('.sizes input:checked');
+      return { label: input.value, price: Number(card.dataset.price) + Number(input.dataset.delta) };
+    }
+
+    cards.forEach(card => {
+      const toggle = card.querySelector('.toggle-btn');
+      const extra = card.querySelector('.card-extra');
+      const price = card.querySelector('.price');
+      const addButton = card.querySelector('.add-btn');
+      let resetTimer;
+
+      toggle.addEventListener('click', () => {
+        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
+        transitionWithin(card, () => {
+          toggle.setAttribute('aria-expanded', String(expanded));
+          toggle.textContent = expanded ? 'Close' : 'Customize';
+          extra.hidden = !expanded;
+        });
+      });
+
+      card.querySelectorAll('.sizes input').forEach(input => {
+        input.addEventListener('change', () => {
+          transitionWithin(card, () => {
+            price.textContent = formatPrice(selectedSize(card).price);
+          });
+        });
+      });
+
+      addButton.addEventListener('click', () => {
+        const { label, price: linePrice } = selectedSize(card);
+        // Two independent scopes animate concurrently.
+        addToOrder(card.querySelector('h3').textContent, label, linePrice);
+        transitionWithin(card, () => {
+          addButton.textContent = 'Added ✓';
+          addButton.classList.add('added');
+        });
+        clearTimeout(resetTimer);
+        resetTimer = setTimeout(() => {
+          transitionWithin(card, () => {
+            addButton.textContent = 'Add to order';
+            addButton.classList.remove('added');
+          });
+        }, 1200);
+      });
+    });
+
+    // Order panel
+    const orderPanel = document.getElementById('order-panel');
+    const orderList = document.getElementById('order-list');
+    const orderEmpty = document.getElementById('order-empty');
+    const orderTotal = document.getElementById('order-total');
+
+    function renderOrderSummary() {
+      const lines = [...orderList.children];
+      const total = lines.reduce((sum, li) => sum + Number(li.dataset.price), 0);
+      orderEmpty.hidden = lines.length > 0;
+      orderTotal.textContent = formatPrice(total);
+    }
+
+    function addToOrder(name, size, price) {
+      const li = document.createElement('li');
+      li.dataset.price = price;
+      li.innerHTML = `
+        <span class="line-name"></span>
+        <span class="line-size"></span>
+        <span class="line-price"></span>
+        <button type="button" class="remove-btn" aria-label="Remove">&times;</button>`;
+      li.querySelector('.line-name').textContent = name;
+      li.querySelector('.line-size').textContent = size;
+      li.querySelector('.line-price').textContent = formatPrice(price);
+      li.querySelector('.remove-btn').setAttribute('aria-label', `Remove ${name} (${size})`);
+
+      transitionWithin(orderPanel, () => {
+        orderList.append(li);
+        renderOrderSummary();
+      });
+    }
+
+    orderList.addEventListener('click', event => {
+      const button = event.target.closest('.remove-btn');
+      if (!button) return;
+      transitionWithin(orderPanel, () => {
+        button.closest('li').remove();
+        renderOrderSummary();
+      });
+    });
+  </script>
+
 </body>
 
 </html>
