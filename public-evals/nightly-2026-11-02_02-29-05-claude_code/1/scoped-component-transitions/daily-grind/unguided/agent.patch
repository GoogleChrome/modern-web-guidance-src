+    }
+
+    .card[data-vt] .card-surface {
+      view-transition-name: match-element;
+      view-transition-class: surface;
+    }
+
+    .card[data-vt] .card-media,
+    .card[data-vt] .card-heading,
+    .card[data-vt] .card-actions,
+    .card[data-vt] .card-extra {
+      view-transition-name: match-element;
+      view-transition-class: part;
+    }
+
+    .card[data-vt] .price {
+      view-transition-name: match-element;
+      view-transition-class: price;
+    }
+
+    .order-panel[data-vt] .order-list li {
+      view-transition-name: match-element;
+      view-transition-class: line;
+    }
+
+    .order-panel[data-vt] .order-total,
+    .order-panel[data-vt] .order-empty,
+    .order-panel[data-vt] .order-panel-footer {
+      view-transition-name: match-element;
+      view-transition-class: part;
+    }
+
+    ::view-transition-group(*) {
+      animation-duration: 380ms;
+      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+    }
+
+    /* Cards entering / leaving the grid (filtering) */
+    ::view-transition-new(.card):only-child {
+      animation: vt-pop-in 380ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
+    }
+
+    ::view-transition-old(.card):only-child {
+      animation: vt-pop-out 220ms ease-in both;
+    }
+
+    /* The card surface stretches rather than cross-fading */
+    ::view-transition-old(.surface),
+    ::view-transition-new(.surface) {
+      height: 100%;
+      animation: none;
+    }
+
+    ::view-transition-old(.surface) {
+      display: none;
+    }
+
+    /* Expandable panel inside a card */
