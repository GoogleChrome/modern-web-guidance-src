+  <script>
+    const favorites = [
+      {
+        slug: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        tagline: 'Autumn in a cup.',
+        description: 'Our house espresso pulled over steamed oat milk and sweetened with pure Vermont maple syrup, finished with a dusting of cinnamon for a cozy, nutty sip that tastes like a crisp fall morning.',
+        price: '$5.75',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772',
+        alt: 'Milk being poured into a latte, forming latte art in a white cup',
+      },
+      {
+        slug: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        summary: 'Bold, smokey, and perfect for a morning boost.',
+        tagline: 'Small cup, big character.',
+        description: 'A double shot of our signature dark roast, slow-roasted in small batches to bring out notes of dark chocolate, toasted walnut, and a gentle smokiness. Rich crema, zero compromise.',
+        price: '$3.25',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04',
+        alt: 'Overhead view of espresso in a white cup on a dark slate surface',
+      },
+      {
+        slug: 'cold-brew',
+        name: 'Cold Brew',
+        summary: 'Steeped for 18 hours for maximum smoothness.',
+        tagline: 'Patience, poured over ice.',
+        description: 'Coarse-ground beans steeped in cold, filtered water for 18 hours, then served over ice. The result is naturally sweet, low in acidity, and impossibly smooth. Add a splash of cream if you like.',
+        price: '$4.50',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735',
+        alt: 'A tall glass of iced cold brew coffee with cream on a counter',
+      },
+    ];
+
+    const imageUrl = (base, width) => `${base}?auto=format&fit=crop&w=${width}&q=80`;
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('favorites');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    grid.innerHTML = favorites.map((item) => `
+      <a class="thumbnail" href="#/${item.slug}" data-slug="${item.slug}">
+        <img src="${imageUrl(item.image, 600)}" alt="" width="600" height="450">
+        <div class="thumbnail-body">
+          <h2 class="title">${item.name}</h2>
+          <p>${item.summary}</p>
+          <span class="btn" aria-hidden="true">View Details</span>
+        </div>
+      </a>
+    `).join('');
+
+    let currentSlug = null;
+    let listScrollY = 0;
+    let activeTransition = null;
+
+    const slugFromHash = () => location.hash.replace(/^#\/?/, '');
+    const findItem = (slug) => favorites.find((item) => item.slug === slug);
+
+    function render(item) {
+      currentSlug = item?.slug ?? null;
+      if (item) {
+        hero.src = imageUrl(item.image, 1350);
+        hero.alt = item.alt;
+        title.textContent = item.name;
+        document.getElementById('detail-tagline').textContent = item.tagline;
+        document.getElementById('detail-description').textContent = item.description;
+        document.getElementById('detail-price').textContent = item.price;
+        document.title = `${item.name} | The Daily Grind`;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        window.scrollTo(0, listScrollY);
+      }
+    }
+
+    function clearSelection() {
+      document.querySelectorAll('.thumbnail.selected')
+        .forEach((el) => el.classList.remove('selected'));
+    }
+
+    // Swap views, morphing the matching .thumbnail into #hero (and back).
+    function navigate(slug) {
+      const item = findItem(slug);
+      if ((item?.slug ?? null) === currentSlug) return;
+
+      const updateDOM = async () => {
+        render(item);
+        // Move focus to the new view's heading so it isn't left on a hidden element.
+        (item ? title : listHeading).focus({ preventScroll: true });
+        // Don't snapshot the detail view before the hero image is ready.
+        if (item) await hero.decode().catch(() => {});
+      };
+
+      activeTransition?.skipTransition();
+      clearSelection();
+      if (item) listScrollY = window.scrollY;
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        updateDOM();
+        return;
+      }
+
+      // Only the thumbnail involved in this navigation gets a transition name.
+      const morphSlug = item ? item.slug : currentSlug;
+      grid.querySelector(`.thumbnail[data-slug="${morphSlug}"]`)?.classList.add('selected');
+
+      const transition = document.startViewTransition(updateDOM);
+      activeTransition = transition;
+      transition.finished.finally(() => {
+        if (activeTransition !== transition) return;
+        activeTransition = null;
+        clearSelection();
+      });
+    }
+
+    history.scrollRestoration = 'manual';
+    window.addEventListener('hashchange', () => navigate(slugFromHash()));
+
+    grid.addEventListener('click', (event) => {
+      const thumbnail = event.target.closest('.thumbnail');
+      if (!thumbnail || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      history.pushState({ fromList: true }, '', thumbnail.getAttribute('href'));
+      navigate(thumbnail.dataset.slug);
+    });
+
+    // Return through history when we came from the list, so the in-page link
+    // and the browser back button behave the same way.
+    detailPage.querySelector('.back-link').addEventListener('click', (event) => {
+      if (history.state?.fromList) {
+        event.preventDefault();
+        history.back();
+      }
+    });
+
+    // Initial render (e.g. a deep link to a detail view) happens without animation.
+    render(findItem(slugFromHash()));
+  </script>
+
