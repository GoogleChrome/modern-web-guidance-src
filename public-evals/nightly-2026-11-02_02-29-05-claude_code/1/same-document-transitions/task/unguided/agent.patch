+  <script>
+    const favorites = [
+      {
+        slug: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        story: 'A double shot of our house espresso, steamed oat milk, and a drizzle of small-batch maple syrup from a family sugarhouse in Vermont. Finished with a dusting of cinnamon.',
+        facts: { Roast: 'Medium', Size: '12 oz / 16 oz', Caffeine: '150 mg', 'Best with': 'Pumpkin loaf' },
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Barista pouring latte art into a white cup',
+      },
+      {
+        slug: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        story: 'Our darkest roast, pulled short for a syrupy body with notes of cocoa, toasted walnut, and a lingering smoky finish.',
+        facts: { Roast: 'Dark', Size: 'Single / Double', Caffeine: '75 mg per shot', 'Best with': 'Almond biscotti' },
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Top-down view of an espresso in a white cup on slate',
+      },
+      {
+        slug: 'cold-brew',
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        story: 'Coarse-ground beans steeped cold for 18 hours, then served over ice for a naturally sweet, low-acid cup. Add a splash of cream if you like.',
+        facts: { Roast: 'Medium-dark', Size: '16 oz / 24 oz', Caffeine: '200 mg', 'Best with': 'Butter croissant' },
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Iced coffee with cream in a tall glass',
+      },
+    ];
+
+    const root = document.documentElement;
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('thumbnails');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const heroImg = hero.querySelector('img');
+    const titleEl = document.getElementById('title');
+    const descriptionEl = document.getElementById('detail-description');
+    const storyEl = document.getElementById('detail-story');
+    const factsEl = document.getElementById('detail-facts');
+    const backButton = document.getElementById('back-button');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    grid.innerHTML = favorites.map((item) => `
+      <a class="thumbnail" href="#/${item.slug}" data-slug="${item.slug}">
+        <img src="${item.image}" alt="" loading="lazy">
+        <div class="thumbnail-body">
+          <h2 class="title">${item.name}</h2>
+          <p>${item.description}</p>
+        </div>
+      </a>`).join('');
+
+    let currentSlug = null;
+    let listScrollY = 0;
+    let activeTransition = null;
+    let enteredFromList = false;
+    const morphTargets = new Set();
+
+    function parseRoute() {
+      const slug = location.hash.replace(/^#\/?/, '');
+      return favorites.some((item) => item.slug === slug) ? slug : null;
+    }
+
+    function thumbnailFor(slug) {
+      return grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+    }
+
+    function setMorphNames(container, title) {
+      container.style.viewTransitionName = 'hero';
+      title.style.viewTransitionName = 'title';
+      morphTargets.add(container).add(title);
+    }
+
+    function clearMorphNames() {
+      morphTargets.forEach((el) => el.style.removeProperty('view-transition-name'));
+      morphTargets.clear();
+    }
+
+    function clearTransitionState() {
+      clearMorphNames();
+      root.classList.remove('vt-forward', 'vt-back');
+    }
+
+    function render(slug) {
+      if (slug) {
+        const item = favorites.find((f) => f.slug === slug);
+        if (currentSlug === null) listScrollY = window.scrollY;
+        heroImg.src = item.image;
+        heroImg.alt = item.alt;
+        titleEl.textContent = item.name;
+        descriptionEl.textContent = item.description;
+        storyEl.textContent = item.story;
+        factsEl.replaceChildren(...Object.entries(item.facts).flatMap(([label, value]) => {
+          const dt = document.createElement('dt');
+          const dd = document.createElement('dd');
+          dt.textContent = label;
+          dd.textContent = value;
+          return [dt, dd];
+        }));
+        document.title = `${item.name} | The Daily Grind`;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        window.scrollTo(0, listScrollY);
+      }
+      currentSlug = slug;
+    }
+
+    function focusHeading(slug) {
+      (slug ? titleEl : listHeading).focus({ preventScroll: true });
+    }
+
+    // Don't capture the new state until the hero image is ready, otherwise the
+    // morph lands on an empty box. Capped so a slow network can't stall it.
+    function heroReady() {
+      return Promise.race([
+        heroImg.decode().catch(() => { }),
+        new Promise((resolve) => setTimeout(resolve, 500)),
+      ]);
+    }
+
+    function navigate() {
+      const to = parseRoute();
+      const from = currentSlug;
+      if (to === from) return;
+
+      activeTransition?.skipTransition();
+      clearTransitionState();
+
+      if (reducedMotion.matches || !document.startViewTransition) {
+        render(to);
+        focusHeading(to);
+        return;
+      }
+
+      // Only list <-> detail morphs; detail -> detail just cross-fades
+      const direction = from === null ? 'forward' : to === null ? 'back' : null;
+      const thumb = thumbnailFor(to ?? from);
+
+      if (direction === 'forward') setMorphNames(thumb, thumb.querySelector('.title'));
+      if (direction === 'back') setMorphNames(hero, titleEl);
+      if (direction) root.classList.add(`vt-${direction}`);
+
+      const transition = document.startViewTransition(async () => {
+        clearMorphNames();
+        render(to);
+        if (to) await heroReady();
+        if (direction === 'forward') setMorphNames(hero, titleEl);
+        if (direction === 'back') setMorphNames(thumb, thumb.querySelector('.title'));
+        focusHeading(to);
+      });
+      activeTransition = transition;
+
+      transition.finished
+        .finally(() => {
+          if (activeTransition !== transition) return;
+          activeTransition = null;
+          clearTransitionState();
+        })
+        .catch(() => { });
+    }
+
+    grid.addEventListener('click', (event) => {
+      if (event.target.closest('.thumbnail')) enteredFromList = true;
+    });
+
+    backButton.addEventListener('click', () => {
+      // Pop the history entry we pushed so the browser's back button stays sane
+      if (enteredFromList) {
+        enteredFromList = false;
+        history.back();
+      } else {
+        location.hash = '#/';
+      }
+    });
+
+    window.addEventListener('hashchange', navigate);
+
+    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+    if (parseRoute()) render(parseRoute());
+  </script>
+
 </body>
 
