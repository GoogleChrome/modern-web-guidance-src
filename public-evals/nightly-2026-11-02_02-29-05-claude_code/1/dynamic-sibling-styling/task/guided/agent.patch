+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count()
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const applySiblingVars = () => {
+        const parents = new Set(
+          [...document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb')].map((el) => el.parentElement)
+        );
+        parents.forEach((parent) => {
+          const children = [...parent.children];
+          children.forEach((child, index) => {
+            child.style.setProperty('--sibling-index', index + 1);
+            child.style.setProperty('--sibling-count', children.length);
+          });
+        });
+      };
+      applySiblingVars();
+      // Keep values in sync if items are added or removed later
+      new MutationObserver(applySiblingVars).observe(document.querySelector('main'), { childList: true, subtree: true });
+    }
+  </script>
