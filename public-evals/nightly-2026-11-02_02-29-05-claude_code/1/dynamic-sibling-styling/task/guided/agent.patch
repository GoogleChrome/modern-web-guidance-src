+    /* Dynamic sibling styling: index/count come from native sibling-index()/sibling-count()
+       when supported, otherwise from custom properties injected by the fallback script. */
+    .spectrum-card,
+    .fan-card,
+    .circle-orb {
+      --index: var(--sibling-index, 1);
+      --count: var(--sibling-count, 1);
+    }
+
+    @supports (top: calc(sibling-index() * 1px)) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        --index: sibling-index();
+        --count: sibling-count();
+      }
+    }
+
+    /* Spectrum cards: hues spread evenly around the color wheel */
+    .spectrum-card {
+      --hue: calc(360deg / var(--count) * (var(--index) - 1) + 30deg);
+      background-color: oklch(93% 0.06 var(--hue));
+      border-top: 4px solid oklch(60% 0.14 var(--hue));
+    }
+
+    .section-title {
+      text-align: center;
+      margin-top: 60px;
+    }
+
+    /* Fan of loyalty cards rotating symmetrically around the middle card */
+    .fan-container {
+      display: grid;
+      place-items: center;
+      height: 320px;
+      margin-top: 20px;
+    }
+
+    .fan-card {
+      --center: calc((var(--count) + 1) / 2);
+      /* Total spread stays bounded as cards are added */
+      --step: min(15deg, calc(80deg / var(--count)));
+      --offset: calc(var(--index) - var(--center));
+      grid-area: 1 / 1;
+      width: 150px;
+      aspect-ratio: 5 / 7;
+      padding: 16px;
+      border-radius: 12px;
+      color: white;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      background: linear-gradient(160deg,
+          oklch(55% 0.1 calc(30deg + var(--offset) * 12deg)),
+          oklch(30% 0.06 calc(40deg + var(--offset) * 12deg)));
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      transform-origin: 50% 120%;
+      transform: rotate(calc(var(--step) * var(--offset)));
+      transition: transform 0.3s ease;
+    }
+
+    .fan-card:hover {
+      transform: rotate(calc(var(--step) * var(--offset))) translateY(-20px);
+    }
+
+    .fan-card strong {
+      font-size: 1.1rem;
+    }
+
+    .fan-card small {
+      font-size: 0.75rem;
+      opacity: 0.85;
+    }
+
+    /* Coffee origin badges evenly spaced around a circle */
+    .circle-container {
+      --size: min(380px, 85vw);
+      --orb-size: 90px;
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: var(--size);
+      aspect-ratio: 1;
+      margin: 40px auto 0;
+      border-radius: 50%;
+      background: radial-gradient(circle, var(--secondary) 0 25%, transparent 25.5%);
+    }
+
+    .circle-container::before {
+      content: "Origins";
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .circle-orb {
+      /* Start at 12 o'clock and go clockwise */
+      --angle: calc(360deg / var(--count) * (var(--index) - 1) - 90deg);
+      --radius: calc(var(--size) / 2 - var(--orb-size) / 2);
+      position: absolute;
+      width: var(--orb-size);
+      aspect-ratio: 1;
+      border-radius: 50%;
+      display: grid;
+      place-items: center;
+      text-align: center;
+      font-size: 0.8rem;
+      font-weight: bold;
+      line-height: 1.2;
+      color: white;
+      background: oklch(45% 0.1 calc(360deg / var(--count) * (var(--index) - 1)));
+      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
+      transform: translate(calc(cos(var(--angle)) * var(--radius)),
+          calc(sin(var(--angle)) * var(--radius)));
+    }
