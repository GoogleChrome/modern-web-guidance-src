+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count():
+    // set --i/--n on each item and keep them in sync as items change.
+    if (!CSS.supports('z-index: sibling-index()')) {
+      const index = (parent) => {
+        const items = parent.children;
+        for (let k = 0; k < items.length; k++) {
+          items[k].style.setProperty('--i', k + 1);
+          items[k].style.setProperty('--n', items.length);
+        }
+      };
+      const observer = new MutationObserver((records) => {
+        records.forEach((r) => index(r.target));
+      });
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach((parent) => {
+        index(parent);
+        observer.observe(parent, { childList: true });
+      });
+    }
+  </script>
 
