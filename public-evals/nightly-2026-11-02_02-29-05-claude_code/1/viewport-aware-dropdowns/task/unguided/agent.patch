+  <script>
+    (() => {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+
+      panel.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-href]');
+        if (!btn) return;
+        panel.hidePopover();
+        window.location.href = btn.dataset.href;
+      });
+
+      // Fallback positioning for browsers without CSS anchor positioning:
+      // place below the trigger, left-aligned, flipping on viewport collision.
+      if (CSS.supports('anchor-name', '--a')) return;
+
+      const GAP = 6;
+      const EDGE = 8;
+
+      function position() {
+        const t = trigger.getBoundingClientRect();
+        const w = panel.offsetWidth;
+        const h = panel.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        let top = t.bottom + GAP;
+        if (top + h > vh - EDGE && t.top - GAP - h >= EDGE) top = t.top - GAP - h;
+
+        let left = t.left;
+        if (left + w > vw - EDGE && t.right - w >= EDGE) left = t.right - w;
+
+        top = Math.max(EDGE, Math.min(top, vh - h - EDGE));
+        left = Math.max(EDGE, Math.min(left, vw - w - EDGE));
+
+        panel.style.margin = '0';
+        panel.style.top = `${top}px`;
+        panel.style.left = `${left}px`;
+      }
+
+      panel.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') {
+          position();
+          window.addEventListener('resize', position);
+          window.addEventListener('scroll', position, true);
+        } else {
+          window.removeEventListener('resize', position);
+          window.removeEventListener('scroll', position, true);
+        }
+      });
+    })();
+  </script>
