+  <script>
+    const STORAGE_KEY = 'color-scheme';
+    const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeSelect = document.getElementById('theme-select');
+    const systemOption = themeSelect.querySelector('option[value="light dark"]');
+    const systemDark = matchMedia('(prefers-color-scheme: dark)');
+
+    // The meta content is mapped to color-scheme on :root in CSS
+    function applyTheme(value) {
+      if (value !== 'light' && value !== 'dark') value = 'light dark';
+      colorSchemeMeta.content = value;
+      themeSelect.value = value;
+    }
+
+    function saveTheme(value) {
+      try {
+        if (value === 'light dark') localStorage.removeItem(STORAGE_KEY);
+        else localStorage.setItem(STORAGE_KEY, value);
+      } catch { }
+    }
+
+    function updateSystemLabel() {
+      systemOption.textContent = `System default (currently ${systemDark.matches ? 'dark' : 'light'})`;
+    }
+
+    applyTheme(colorSchemeMeta.content);
+    updateSystemLabel();
+
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      saveTheme(themeSelect.value);
+    });
+
+    systemDark.addEventListener('change', updateSystemLabel);
+
+    // Keep other open tabs in sync
+    window.addEventListener('storage', (event) => {
+      if (event.key === STORAGE_KEY) applyTheme(event.newValue);
+    });
+
+    // Late night specials filter
+    const lateNightFilter = document.getElementById('late-night-filter');
+    lateNightFilter.addEventListener('change', () => {
+      for (const special of document.querySelectorAll('.special')) {
+        special.hidden = lateNightFilter.value !== 'all' && special.dataset.category !== lateNightFilter.value;
+      }
+    });
+  </script>
+
 </body>
 
