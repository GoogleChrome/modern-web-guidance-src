+
+      var HISTORY_KEY = 'coffeeDialog';
+      var closingFromHistory = false;
+
+      function fill(id) {
+        var coffee = coffees[id];
+        var image = document.getElementById('coffee-dialog-image');
+        image.src = coffee.image;
+        image.alt = coffee.alt;
+        document.getElementById('coffee-dialog-title').textContent = coffee.name;
+        document.getElementById('coffee-dialog-price').textContent = coffee.price;
+        document.getElementById('coffee-dialog-description').textContent = coffee.description;
+        document.getElementById('coffee-dialog-sizes').textContent = coffee.sizes;
+        document.getElementById('coffee-dialog-notes').textContent = coffee.notes;
+        document.getElementById('coffee-dialog-calories').textContent = coffee.calories;
+        document.getElementById('coffee-dialog-menu').href = coffee.href;
+      }
+
+      function show(id) {
+        if (!coffees[id] || dialog.open) return;
+        fill(id);
+        dialog.showModal();
+        document.body.style.overflow = 'hidden';
+        dialog.querySelector('[data-close-dialog]').focus();
+      }
+
+      function openDialog(id) {
+        show(id);
+        // Add a history entry so the mobile back gesture/button closes the dialog
+        // instead of leaving the page.
+        var state = Object.assign({}, history.state);
+        state[HISTORY_KEY] = id;
+        history.pushState(state, '');
+      }
+
+      document.querySelectorAll('[data-coffee]').forEach(function (button) {
+        button.addEventListener('click', function () {
+          openDialog(button.dataset.coffee);
+        });
+      });
+
+      dialog.querySelector('[data-close-dialog]').addEventListener('click', function () {
+        dialog.close();
+      });
+
+      // Clicking the backdrop (outside the dialog box) closes it.
+      dialog.addEventListener('click', function (event) {
+        if (event.target !== dialog) return;
+        var rect = dialog.getBoundingClientRect();
+        var inside = event.clientX >= rect.left && event.clientX <= rect.right &&
+          event.clientY >= rect.top && event.clientY <= rect.bottom;
+        if (!inside) dialog.close();
+      });
+
+      // Escape key and Android back (via CloseWatcher) fire "cancel" then "close"
+      // natively; all close paths end up here.
+      dialog.addEventListener('close', function () {
+        document.body.style.overflow = '';
+        if (closingFromHistory) {
+          closingFromHistory = false;
+        } else if (history.state && history.state[HISTORY_KEY]) {
+          // Closed by Escape, close button, or backdrop: drop our history entry.
+          history.back();
+        }
+      });
+
+      window.addEventListener('popstate', function (event) {
+        var id = event.state && event.state[HISTORY_KEY];
+        if (id) {
+          // Navigated forward onto a dialog entry: reopen it.
+          show(id);
+        } else if (dialog.open) {
+          closingFromHistory = true;
+          dialog.close();
+        }
+      });
+
+      // Restore the dialog if the page was reloaded while it was open.
+      if (history.state && history.state[HISTORY_KEY]) {
+        show(history.state[HISTORY_KEY]);
+      }
+    })();
+  </script>
