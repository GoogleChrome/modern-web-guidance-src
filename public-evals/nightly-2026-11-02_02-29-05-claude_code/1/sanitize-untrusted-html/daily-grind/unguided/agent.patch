+  <script>
+    (() => {
+      'use strict';
+
+      const DRINKS = {
+        'maple-oat-latte': 'Maple Oat Latte',
+        'dark-roast-espresso': 'Dark Roast Espresso',
+        'cold-brew': 'Cold Brew'
+      };
+      const STORAGE_KEY = 'daily-grind-reviews';
+      const MAX_BODY_LENGTH = 2000;
+      const HTML_NS = 'http://www.w3.org/1999/xhtml';
+      const SAFE_URL_PROTOCOLS = new Set(['http:', 'https:', 'mailto:']);
+
+      // Allowlist shared by the native Sanitizer API and the fallback sanitizer.
+      // Keys are element names; values are the attributes permitted on them.
+      const ALLOWED = {
+        p: [], br: [], b: [], strong: [], i: [], em: [], u: [], s: [],
+        ul: [], ol: [], li: [], blockquote: [], code: [],
+        a: ['href', 'title']
+      };
+      // Disallowed elements whose content should be dropped rather than unwrapped.
+      const DROP_WITH_CONTENT = new Set([
+        'script', 'style', 'template', 'iframe', 'frame', 'frameset', 'object', 'embed',
+        'noscript', 'noembed', 'noframes', 'xmp', 'plaintext', 'title', 'textarea',
+        'select', 'option', 'head', 'meta', 'link', 'base', 'svg', 'math'
+      ]);
+
+      const SANITIZER_CONFIG = {
+        elements: Object.entries(ALLOWED).map(([name, attributes]) => ({ name, attributes })),
+        attributes: [],
+        comments: false,
+        dataAttributes: false
+      };
+
+      function isSafeUrl(value) {
+        try {
+          return SAFE_URL_PROTOCOLS.has(new URL(value, document.baseURI).protocol);
+        } catch {
+          return false;
+        }
+      }
+
+      // Final hardening applied to output from either sanitizer path.
+      function hardenLinks(root) {
+        for (const a of root.querySelectorAll('a')) {
+          const href = a.getAttribute('href');
+          if (href === null || !isSafeUrl(href.trim())) {
+            a.removeAttribute('href');
+          } else {
+            a.setAttribute('rel', 'nofollow noopener noreferrer ugc');
+            a.setAttribute('target', '_blank');
+          }
+        }
+      }
+
+      // Fallback for browsers without Element.setHTML(): parse into an inert
+      // document (scripts never run, resources never load) and rebuild an
+      // allowlisted copy node-by-node in the live document.
+      function copyAllowed(src, dest, depth) {
+        if (depth > 20) return;
+        for (const node of src.childNodes) {
+          if (node.nodeType === Node.TEXT_NODE) {
+            dest.appendChild(document.createTextNode(node.data));
+            continue;
+          }
+          if (node.nodeType !== Node.ELEMENT_NODE) continue; // drops comments, PIs, etc.
+          if (node.namespaceURI !== HTML_NS) continue;        // drops SVG / MathML
+          const tag = node.localName;
+          if (DROP_WITH_CONTENT.has(tag)) continue;
+          if (!Object.hasOwn(ALLOWED, tag)) {
+            copyAllowed(node, dest, depth + 1); // unwrap unknown element, keep its text
+            continue;
+          }
+          const el = document.createElement(tag);
+          for (const attr of ALLOWED[tag]) {
+            const value = node.getAttribute(attr);
+            if (value !== null) el.setAttribute(attr, value);
+          }
+          copyAllowed(node, el, depth + 1);
+          dest.appendChild(el);
+        }
+      }
+
+      function renderSafeHTML(target, html) {
+        target.replaceChildren();
+        if (typeof target.setHTML === 'function') {
+          try {
+            // Native HTML Sanitizer API: always strips script-capable markup,
+            // and our config narrows it further to the allowlist above.
+            target.setHTML(html, { sanitizer: SANITIZER_CONFIG });
+            hardenLinks(target);
+            return;
+          } catch {
+            target.replaceChildren();
+          }
+        }
+        const inert = new DOMParser().parseFromString(html, 'text/html');
+        const fragment = document.createDocumentFragment();
+        copyAllowed(inert.body, fragment, 0);
+        target.appendChild(fragment);
+        hardenLinks(target);
+      }
+
+      const SEED_REVIEWS = [
+        {
+          name: 'Priya', drink: 'maple-oat-latte', rating: 5, date: '2026-10-21',
+          body: '<p>The <strong>perfect</strong> fall drink. Not too sweet, and the oat milk is <em>so</em> creamy.</p>'
+        },
+        {
+          name: 'Marcus', drink: 'dark-roast-espresso', rating: 4, date: '2026-10-25',
+          body: '<p>Bold and smoky, just as advertised.</p><ul><li>Great crema</li><li>A touch bitter on its own</li></ul>'
+        },
+        {
+          name: 'Jo', drink: 'cold-brew', rating: 5, date: '2026-10-29',
+          body: '<blockquote>Steeped for 18 hours</blockquote><p>You can taste every one of them. My daily order now.</p>'
+        }
+      ];
+
+      function isValidReview(r) {
+        return r && typeof r === 'object'
+          && typeof r.name === 'string'
+          && Object.hasOwn(DRINKS, r.drink)
+          && Number.isInteger(r.rating) && r.rating >= 1 && r.rating <= 5
+          && typeof r.body === 'string'
+          && typeof r.date === 'string';
+      }
+
+      function loadReviews() {
+        try {
+          const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+          if (Array.isArray(stored)) return stored.filter(isValidReview);
+        } catch { /* fall through to seed data */ }
+        return SEED_REVIEWS.slice();
+      }
+
+      function saveReviews() {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+        } catch { /* storage unavailable; keep in memory only */ }
+      }
+
+      let reviews = loadReviews();
+      let activeFilter = 'all';
+
+      const list = document.getElementById('review-list');
+      const form = document.getElementById('review-form');
+      const bodyInput = document.getElementById('review-body');
+      const preview = document.getElementById('review-preview');
+      const errorEl = document.getElementById('review-error');
+      const filterGroup = document.getElementById('review-filter');
+
+      function renderReview(review) {
+        const li = document.createElement('li');
+        li.className = 'review';
+
+        const meta = document.createElement('div');
+        meta.className = 'review-meta';
+
+        const drink = document.createElement('span');
+        drink.className = 'drink';
+        drink.textContent = DRINKS[review.drink];
+
+        const stars = document.createElement('span');
+        stars.className = 'stars';
+        stars.setAttribute('aria-label', `${review.rating} out of 5 stars`);
+        stars.textContent = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
+
+        const byline = document.createElement('span');
+        byline.textContent = `${review.name} · ${review.date}`;
+
+        meta.append(drink, stars, byline);
+
+        const body = document.createElement('div');
+        body.className = 'review-body';
+        renderSafeHTML(body, review.body);
+
+        li.append(meta, body);
+        return li;
+      }
+
+      function render() {
+        const visible = reviews
+          .filter(r => activeFilter === 'all' || r.drink === activeFilter)
+          .slice()
+          .reverse();
+
+        if (visible.length === 0) {
+          const empty = document.createElement('li');
+          empty.className = 'review-empty';
+          empty.textContent = 'No reviews yet. Be the first!';
+          list.replaceChildren(empty);
+        } else {
+          list.replaceChildren(...visible.map(renderReview));
+        }
+
+        for (const btn of document.querySelectorAll('.review-count')) {
+          const count = reviews.filter(r => r.drink === btn.dataset.drink).length;
+          btn.textContent = `${count} review${count === 1 ? '' : 's'}`;
+        }
+        for (const btn of filterGroup.querySelectorAll('button')) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.filter === activeFilter));
+        }
+      }
+
+      function setFilter(filter) {
+        activeFilter = filter;
+        render();
+      }
+
+      filterGroup.addEventListener('click', e => {
+        const btn = e.target.closest('button[data-filter]');
+        if (btn) setFilter(btn.dataset.filter);
+      });
+
+      for (const btn of document.querySelectorAll('.review-count')) {
+        btn.addEventListener('click', () => {
+          setFilter(btn.dataset.drink);
+          document.getElementById('review-drink').value = btn.dataset.drink;
+          document.getElementById('reviews').scrollIntoView({ behavior: 'smooth' });
+        });
+      }
+
+      bodyInput.addEventListener('input', () => {
+        renderSafeHTML(preview, bodyInput.value.slice(0, MAX_BODY_LENGTH));
+      });
+
+      form.addEventListener('submit', e => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const name = String(data.get('name') || '').trim().slice(0, 40);
+        const drink = String(data.get('drink'));
+        const rating = Number.parseInt(data.get('rating'), 10);
+        const body = String(data.get('body') || '').slice(0, MAX_BODY_LENGTH);
+
+        // Reject reviews that are empty once sanitized (e.g. only a script tag).
+        const probe = document.createElement('div');
+        renderSafeHTML(probe, body);
+
+        const review = { name, drink, rating, body, date: new Date().toISOString().slice(0, 10) };
+        if (!name) {
+          errorEl.textContent = 'Please enter your name.';
+        } else if (!probe.textContent.trim()) {
+          errorEl.textContent = 'Please write a review.';
+        } else if (!isValidReview(review)) {
+          errorEl.textContent = 'Please choose a drink and rating.';
+        } else {
+          errorEl.textContent = '';
+          // Store the raw input; it is re-sanitized every time it is rendered.
+          reviews.push(review);
+          saveReviews();
+          form.reset();
+          preview.replaceChildren();
+          setFilter(drink);
+        }
+      });
+
+      render();
+    })();
+  </script>
+
