+  <script>
+    // Reviews are untrusted user input: they are only ever inserted via
+    // safeSetHTML(), never innerHTML, and re-sanitized every time they render.
+    const REVIEW_ELEMENTS = ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'ul', 'ol', 'li', 'blockquote', 'code'];
+    const REVIEW_ATTRIBUTES = [];
+    const STORAGE_KEY = 'daily-grind-reviews';
+
+    let domPurifyPromise;
+
+    // Only browsers without the native Sanitizer API download DOMPurify.
+    function loadDOMPurify() {
+      domPurifyPromise ??= new Promise((resolve, reject) => {
+        const script = document.createElement('script');
+        script.src = 'https://cdn.jsdelivr.net/npm/dompurify@3.3.0/dist/purify.min.js';
+        script.integrity = 'sha384-+qi1h9Ene5uYXijovnRnDpm2TZiNyVFgYjKIqjw6id8zLdWYt+tCPG9/1u6yLaNj';
+        script.crossOrigin = 'anonymous';
+        script.onload = () => resolve(window.DOMPurify);
+        script.onerror = () => {
+          domPurifyPromise = undefined;
+          reject(new Error('Could not load sanitizer'));
+        };
+        document.head.append(script);
+      });
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES } });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+          ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+          // Match the native Sanitizer: strip aria-*/data-* and disallowed element content
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    const seedReviews = [
+      { drink: 'Maple Oat Latte', name: 'Priya', body: '<p><strong>Autumn in a cup.</strong> Just sweet enough, and the oat milk is <em>so</em> creamy.</p>' },
+      { drink: 'Dark Roast Espresso', name: 'Marcus', body: '<p>Exactly what I need before a 7am shift:</p><ul><li>Bold</li><li>Smokey</li><li>Zero bitterness</li></ul>' },
+      { drink: 'Cold Brew', name: 'Jo', body: '<blockquote>Smoothest cold brew in town.</blockquote><p>Ask for it with a splash of oat milk.</p>' }
+    ];
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        return Array.isArray(stored) ? stored : seedReviews;
+      } catch {
+        return seedReviews;
+      }
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch {
+        // Storage may be unavailable (private mode, quota); reviews still show for this visit.
+      }
+    }
+
+    const form = document.getElementById('review-form');
+    const list = document.getElementById('review-list');
+    const status = document.getElementById('review-status');
+    let reviews = loadReviews();
+
+    async function createReviewItem({ drink, name, body }) {
+      const item = document.createElement('li');
+      item.className = 'review';
+
+      const header = document.createElement('header');
+      const author = document.createElement('strong');
+      author.textContent = name;
+      const tag = document.createElement('span');
+      tag.className = 'drink-tag';
+      tag.textContent = drink;
+      header.append(author, tag);
+
+      const content = document.createElement('div');
+      content.className = 'review-body';
+      await safeSetHTML(content, body);
+
+      item.append(header, content);
+      return item;
+    }
+
+    async function renderReviews() {
+      try {
+        const items = await Promise.all([...reviews].reverse().map(createReviewItem));
+        list.replaceChildren(...items);
+      } catch {
+        list.replaceChildren();
+        status.textContent = 'Reviews are unavailable right now. Please try again later.';
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const review = {
+        drink: data.get('drink'),
+        name: data.get('name').trim(),
+        body: data.get('body')
+      };
+
+      reviews = [...reviews, review];
+      saveReviews(reviews);
+      await renderReviews();
+
+      form.reset();
+      status.textContent = `Thanks, ${review.name}! Your review of the ${review.drink} was posted.`;
+    });
+
+    renderReviews();
+  </script>
+
 </body>
 
