diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..521e0fb
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,171 @@
+import React, { useState, useEffect, useRef } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  TARGET_LANGUAGES,
+  collectTextNodes,
+  detectLanguage,
+  getTranslatableRoots,
+  getTranslator,
+  getTranslatorAvailability,
+  isSameLanguage,
+  isTranslationSupported,
+  languageName,
+  restoreOriginal,
+  sampleText,
+  setRootsLanguage,
+  translateTextNodes,
+} from '../utils/translation';
+
+const STORAGE_KEY = 'devtools-times:translate-to';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'unsupported' }
+  | { kind: 'preparing' }
+  | { kind: 'downloading'; progress: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; source: string }
+  | { kind: 'same'; source: string }
+  | { kind: 'error'; message: string };
+
+export default function TranslateControl() {
+  const [target, setTarget] = useState('');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const abortRef = useRef<AbortController | null>(null);
+
+  const translateTo = async (language: string, { auto = false } = {}) => {
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+    const { signal } = controller;
+    const roots = getTranslatableRoots();
+
+    setTarget(language);
+    if (!language) {
+      restoreOriginal(roots);
+      localStorage.removeItem(STORAGE_KEY);
+      setStatus({ kind: 'idle' });
+      return;
+    }
+    if (roots.length === 0) {
+      setStatus({ kind: 'error', message: 'Nothing to translate on this page.' });
+      return;
+    }
+
+    try {
+      setStatus({ kind: 'preparing' });
+      const nodes = collectTextNodes(roots);
+      const source = await detectLanguage(sampleText(nodes), document.documentElement.lang || 'en');
+      if (signal.aborted) return;
+
+      if (isSameLanguage(source, language)) {
+        restoreOriginal(roots);
+        setStatus({ kind: 'same', source });
+        return;
+      }
+
+      const availability = await getTranslatorAvailability(source, language);
+      if (signal.aborted) return;
+      if (availability === 'unavailable') {
+        throw new Error(`${languageName(source)} to ${languageName(language)} isn't supported on this device.`);
+      }
+      // Model downloads need a user gesture, so automatic translation only uses ready models.
+      if (auto && availability !== 'available') {
+        setTarget('');
+        setStatus({ kind: 'idle' });
+        return;
+      }
+
+      const translator = await getTranslator(source, language, {
+        signal,
+        onDownloadProgress: (loaded) => setStatus({ kind: 'downloading', progress: loaded }),
+      });
+      setStatus({ kind: 'translating', done: 0, total: nodes.length });
+      await translateTextNodes(nodes, translator, {
+        sourceLanguage: source,
+        targetLanguage: language,
+        signal,
+        onProgress: (done, total) => setStatus({ kind: 'translating', done, total }),
+      });
+      if (signal.aborted) return;
+
+      setRootsLanguage(roots, language);
+      localStorage.setItem(STORAGE_KEY, language);
+      setStatus({ kind: 'translated', source });
+    } catch (error) {
+      if (signal.aborted) return;
+      restoreOriginal(roots);
+      setTarget('');
+      setStatus({ kind: 'error', message: error instanceof Error ? error.message : 'Translation failed.' });
+    }
+  };
+
+  useEffect(() => {
+    if (!isTranslationSupported()) {
+      setStatus({ kind: 'unsupported' });
+      return;
+    }
+    const saved = localStorage.getItem(STORAGE_KEY);
+    if (saved) translateTo(saved, { auto: true });
+    return () => abortRef.current?.abort();
+  }, []);
+
+  const busy = status.kind === 'preparing' || status.kind === 'downloading' || status.kind === 'translating';
+
+  let message: React.ReactNode = 'On-device translation';
+  switch (status.kind) {
+    case 'unsupported':
+      message = 'Translation needs a browser with the built-in Translator API';
+      break;
+    case 'preparing':
+      message = 'Preparing translation…';
+      break;
+    case 'downloading':
+      message = `Downloading language model… ${Math.round(status.progress * 100)}%`;
+      break;
+    case 'translating':
+      message = `Translating… ${status.done}/${status.total}`;
+      break;
+    case 'translated':
+      message = (
+        <>
+          Translated from {languageName(status.source)} ·{' '}
+          <button type="button" onClick={() => translateTo('')} className="underline hover:text-amber-400">
+            Show original
+          </button>
+        </>
+      );
+      break;
+    case 'same':
+      message = `Already in ${languageName(status.source)}`;
+      break;
+    case 'error':
+      message = status.message;
+      break;
+  }
+
+  return (
+    <div translate="no" className="flex flex-col items-end gap-1">
+      <label className="flex items-center gap-1.5 max-w-full">
+        <LanguageIcon className={`h-5 w-5 flex-shrink-0 ${busy ? 'text-amber-400 animate-pulse' : 'text-gray-600'}`} />
+        <span className="sr-only">Translate articles</span>
+        <select
+          value={target}
+          onChange={(event) => translateTo(event.target.value)}
+          disabled={status.kind === 'unsupported'}
+          className="max-w-full min-w-0 border border-gray-300 rounded bg-white py-1 px-2 text-xs font-semibold text-gray-800 disabled:opacity-50"
+        >
+          <option value="">Original language</option>
+          {TARGET_LANGUAGES.map((code) => (
+            <option key={code} value={code} lang={code}>
+              {languageName(code, code)}
+            </option>
+          ))}
+        </select>
+      </label>
+      <p aria-live="polite" className="text-[11px] font-normal text-gray-500">
+        {message}
+      </p>
+    </div>
+  );
+}
