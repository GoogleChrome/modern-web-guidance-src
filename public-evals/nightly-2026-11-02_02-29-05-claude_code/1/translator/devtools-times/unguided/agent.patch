diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..f08b890
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,216 @@
+// Helpers around Chrome's built-in, on-device Translator and LanguageDetector APIs.
+// See https://developer.chrome.com/docs/ai/translator-api
+
+export type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface DownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface CreateMonitor {
+  addEventListener(type: 'downloadprogress', listener: (event: DownloadProgressEvent) => void): void;
+}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<Availability>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    monitor?: (monitor: CreateMonitor) => void;
+    signal?: AbortSignal;
+  }): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string): Promise<{ detectedLanguage: string; confidence: number }[]>;
+  destroy(): void;
+}
+
+interface LanguageDetectorStatic {
+  availability(): Promise<Availability>;
+  create(): Promise<LanguageDetectorInstance>;
+}
+
+const builtInAI = globalThis as unknown as {
+  Translator?: TranslatorStatic;
+  LanguageDetector?: LanguageDetectorStatic;
+};
+
+export const TARGET_LANGUAGES = [
+  'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'uk', 'ru',
+  'tr', 'ar', 'hi', 'ja', 'ko', 'zh', 'zh-Hant', 'vi',
+];
+
+const RTL_LANGUAGES = new Set(['ar', 'he', 'fa', 'ur']);
+
+// Elements marked with this attribute (and their descendants) get translated.
+const ROOT_SELECTOR = '[data-translatable]';
+const SKIP_SELECTOR = '[translate="no"], script, style, noscript, code, pre, kbd, samp, svg, textarea';
+
+const originalText = new WeakMap<Text, string>();
+const originalRootAttrs = new WeakMap<HTMLElement, { lang: string | null; dir: string | null }>();
+// Keyed by "source>target", survives client-side navigations so revisited teasers translate instantly.
+const translationCache = new Map<string, Map<string, string>>();
+const translators = new Map<string, TranslatorInstance>();
+
+export function isTranslationSupported() {
+  return typeof builtInAI.Translator !== 'undefined';
+}
+
+export function languageName(code: string, displayLocale = 'en') {
+  try {
+    return new Intl.DisplayNames([displayLocale], { type: 'language' }).of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+export function isSameLanguage(a: string, b: string) {
+  if (a.toLowerCase() === b.toLowerCase()) return true;
+  // "en-US" and "en" are the same for our purposes, but Simplified and Traditional Chinese are not.
+  const [baseA, baseB] = [a, b].map((code) => code.split('-')[0].toLowerCase());
+  return baseA === baseB && baseA !== 'zh';
+}
+
+export function getTranslatableRoots(): HTMLElement[] {
+  const roots = [...document.querySelectorAll<HTMLElement>(ROOT_SELECTOR)];
+  return roots.filter((root) => !root.parentElement?.closest(ROOT_SELECTOR));
+}
+
+export function collectTextNodes(roots: HTMLElement[]): Text[] {
+  const nodes: Text[] = [];
+  for (const root of roots) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        const text = originalText.get(node as Text) ?? node.nodeValue ?? '';
+        if (!/\p{L}/u.test(text)) return NodeFilter.FILTER_REJECT;
+        if (node.parentElement?.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+        return NodeFilter.FILTER_ACCEPT;
+      },
+    });
+    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  }
+  return nodes;
+}
+
+function getOriginal(node: Text) {
+  return originalText.get(node) ?? node.data;
+}
+
+export function sampleText(nodes: Text[], maxLength = 2000) {
+  let sample = '';
+  for (const node of nodes) {
+    if (sample.length >= maxLength) break;
+    sample += getOriginal(node).trim() + ' ';
+  }
+  return sample.slice(0, maxLength);
+}
+
+/** Detects the language of the original content, falling back when the detector isn't ready. */
+export async function detectLanguage(sample: string, fallback: string): Promise<string> {
+  const LanguageDetector = builtInAI.LanguageDetector;
+  if (!LanguageDetector || !sample.trim()) return fallback;
+  try {
+    // Only use an already downloaded model, so detection never delays translation.
+    if ((await LanguageDetector.availability()) !== 'available') return fallback;
+    const detector = await LanguageDetector.create();
+    const [top] = await detector.detect(sample);
+    detector.destroy();
+    if (top && top.detectedLanguage !== 'und' && top.confidence >= 0.5) return top.detectedLanguage;
+  } catch {
+    // Fall through to the fallback language.
+  }
+  return fallback;
+}
+
+export function getTranslatorAvailability(sourceLanguage: string, targetLanguage: string) {
+  return builtInAI.Translator!.availability({ sourceLanguage, targetLanguage });
+}
+
+export async function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  { signal, onDownloadProgress }: { signal?: AbortSignal; onDownloadProgress?: (loaded: number) => void } = {},
+) {
+  const key = `${sourceLanguage}>${targetLanguage}`;
+  const cached = translators.get(key);
+  if (cached) return cached;
+  const translator = await builtInAI.Translator!.create({
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => onDownloadProgress?.(event.loaded));
+    },
+  });
+  translators.set(key, translator);
+  return translator;
+}
+
+/** Translates text nodes in place, always starting from the original text so languages can be switched freely. */
+export async function translateTextNodes(
+  nodes: Text[],
+  translator: TranslatorInstance,
+  {
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    onProgress,
+  }: { sourceLanguage: string; targetLanguage: string; signal: AbortSignal; onProgress?: (done: number, total: number) => void },
+) {
+  const key = `${sourceLanguage}>${targetLanguage}`;
+  let cache = translationCache.get(key);
+  if (!cache) translationCache.set(key, (cache = new Map()));
+
+  let done = 0;
+  await Promise.all(
+    nodes.map(async (node) => {
+      const original = getOriginal(node);
+      originalText.set(node, original);
+      const [, leading, core, trailing] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+
+      let translated = cache.get(core);
+      if (translated === undefined) {
+        translated = await translator.translate(core, { signal });
+        cache.set(core, translated);
+      }
+      if (signal.aborted) return;
+      node.data = leading + translated + trailing;
+      onProgress?.(++done, nodes.length);
+    }),
+  );
+}
+
+export function setRootsLanguage(roots: HTMLElement[], language: string) {
+  for (const root of roots) {
+    if (!originalRootAttrs.has(root)) {
+      originalRootAttrs.set(root, { lang: root.getAttribute('lang'), dir: root.getAttribute('dir') });
+    }
+    root.setAttribute('lang', language);
+    root.setAttribute('dir', RTL_LANGUAGES.has(language.split('-')[0]) ? 'rtl' : 'ltr');
+  }
+}
+
+export function restoreOriginal(roots: HTMLElement[]) {
+  for (const node of collectTextNodes(roots)) {
+    const original = originalText.get(node);
+    if (original !== undefined) {
+      node.data = original;
+      originalText.delete(node);
+    }
+  }
+  for (const root of roots) {
+    const attrs = originalRootAttrs.get(root);
+    if (!attrs) continue;
+    for (const [name, value] of Object.entries(attrs)) {
+      if (value === null) root.removeAttribute(name);
+      else root.setAttribute(name, value);
+    }
+    originalRootAttrs.delete(root);
+  }
+}
