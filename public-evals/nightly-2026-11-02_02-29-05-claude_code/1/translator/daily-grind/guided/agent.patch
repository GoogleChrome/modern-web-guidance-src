+  <script type="module">
+    const SOURCE_LANG = 'en';
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('lang-status');
+    const main = document.querySelector('main');
+    const targets = [...document.querySelectorAll('[data-translate]')];
+    const originals = new Map(targets.map((el) => [el, el.textContent]));
+    const translators = new Map();
+    let currentLang = SOURCE_LANG;
+    let requestId = 0;
+
+    function restoreOriginals() {
+      for (const [el, text] of originals) {
+        el.textContent = text;
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+
+      if (availability !== 'available') status.textContent = 'Downloading language pack…';
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+          });
+        },
+      });
+      translators.set(targetLanguage, translator);
+      return translator;
+    }
+
+    async function applyLanguage(lang) {
+      const id = ++requestId;
+      if (lang === SOURCE_LANG) {
+        restoreOriginals();
+        main.removeAttribute('aria-busy');
+        status.textContent = '';
+        currentLang = lang;
+        return;
+      }
+
+      main.setAttribute('aria-busy', 'true');
+      status.textContent = 'Translating…';
+      try {
+        const translator = await getTranslator(lang);
+        if (id !== requestId) return;
+        if (!translator) {
+          status.textContent = `${select.selectedOptions[0].text} isn't available on this device.`;
+          select.value = currentLang;
+          return;
+        }
+        const results = await Promise.all(
+          targets.map((el) => translator.translate(originals.get(el)))
+        );
+        if (id !== requestId) return;
+        targets.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = lang;
+          el.dir = 'auto';
+        });
+        currentLang = lang;
+        status.textContent = '';
+      } catch (err) {
+        if (id !== requestId) return;
+        console.error(err);
+        status.textContent = 'Translation failed. Please try again.';
+        select.value = currentLang;
+      } finally {
+        if (id === requestId) main.removeAttribute('aria-busy');
+      }
+    }
+
+    if ('Translator' in self) {
+      select.addEventListener('change', () => applyLanguage(select.value));
+    } else {
+      select.disabled = true;
+      status.textContent = 'On-device translation is not supported in this browser.';
+    }
+  </script>
+
