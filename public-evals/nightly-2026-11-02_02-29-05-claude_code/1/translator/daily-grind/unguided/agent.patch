+  <script>
+    // On-device translation using the browser's built-in Translator API
+    // (https://developer.chrome.com/docs/ai/translator-api). Text never leaves the device.
+    (() => {
+      const SOURCE_LANG = 'en';
+      const STORAGE_KEY = 'daily-grind-lang';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const elements = [...document.querySelectorAll('[data-translate]')];
+      const originals = new Map(elements.map((el) => [el, el.textContent.trim().replace(/\s+/g, ' ')]));
+      const translators = new Map();
+      let requestId = 0;
+
+      function setStatus(message) {
+        status.textContent = message;
+      }
+
+      function showOriginal() {
+        for (const [el, text] of originals) el.textContent = text;
+        document.documentElement.lang = SOURCE_LANG;
+      }
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser';
+        setStatus('On-device translation is not supported in this browser.');
+        return;
+      }
+
+      function getTranslator(lang) {
+        if (!translators.has(lang)) {
+          const pending = Translator.create({
+            sourceLanguage: SOURCE_LANG,
+            targetLanguage: lang,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+              });
+            },
+          });
+          // Don't cache failures, so the user can retry.
+          pending.catch(() => translators.delete(lang));
+          translators.set(lang, pending);
+        }
+        return translators.get(lang);
+      }
+
+      async function applyLanguage(lang) {
+        const id = ++requestId;
+        localStorage.setItem(STORAGE_KEY, lang);
+
+        if (lang === SOURCE_LANG) {
+          showOriginal();
+          setStatus('');
+          return;
+        }
+
+        const label = select.selectedOptions[0].textContent;
+        select.disabled = true;
+        setStatus(`Translating to ${label}…`);
+        try {
+          // Must be called synchronously within the user gesture so a model download is allowed.
+          const translator = await getTranslator(lang);
+          const results = await Promise.all(
+            [...originals.values()].map((text) => translator.translate(text))
+          );
+          if (id !== requestId) return; // A newer selection superseded this one.
+          elements.forEach((el, i) => { el.textContent = results[i]; });
+          document.documentElement.lang = lang;
+          setStatus(`Translated on your device to ${label}.`);
+        } catch (err) {
+          if (id !== requestId) return;
+          console.error(err);
+          showOriginal();
+          select.value = SOURCE_LANG;
+          localStorage.setItem(STORAGE_KEY, SOURCE_LANG);
+          setStatus(`Sorry, ${label} isn't available for on-device translation right now.`);
+        } finally {
+          if (id === requestId) select.disabled = false;
+        }
+      }
+
+      select.addEventListener('change', () => applyLanguage(select.value));
+
+      // Restore a previous choice, but only if the model is already on the device:
+      // downloads require a user gesture.
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved && saved !== SOURCE_LANG && select.querySelector(`option[value="${saved}"]`)) {
+        Translator.availability({ sourceLanguage: SOURCE_LANG, targetLanguage: saved })
+          .then((availability) => {
+            if (availability === 'available' && requestId === 0) {
+              select.value = saved;
+              applyLanguage(saved);
+            }
+          })
+          .catch(() => {});
+      }
+    })();
+  </script>
+
