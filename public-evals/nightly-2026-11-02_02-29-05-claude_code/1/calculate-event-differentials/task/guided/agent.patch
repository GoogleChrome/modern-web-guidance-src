+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const timer = document.getElementById('maple-timer');
+    const tz = Temporal.Now.timeZoneId();
+    const now = Temporal.Now.zonedDateTimeISO(tz);
+    // Promotion boundaries are midnight in the visitor's own time zone
+    const start = Temporal.PlainDate.from(timer.dataset.start).toZonedDateTime({ timeZone: tz });
+    const end = Temporal.PlainDate.from(timer.dataset.end).toZonedDateTime({ timeZone: tz });
+    const diffOptions = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+    const formatOptions = { style: 'long', hoursDisplay: 'always' };
+
+    const renderDuration = (el, prefix, duration, suffix = '') => {
+      const time = document.createElement('time');
+      time.dateTime = duration.toString();
+      time.textContent = duration.toLocaleString(undefined, formatOptions);
+      el.replaceChildren(prefix, time, suffix);
+    };
+
+    const remainingEl = timer.querySelector('.promo-remaining');
+    const elapsedEl = timer.querySelector('.promo-elapsed');
+
+    if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+      renderDuration(remainingEl, 'Offer starts in ', now.until(start, diffOptions));
+      elapsedEl.hidden = true;
+    } else if (Temporal.ZonedDateTime.compare(now, end) >= 0) {
+      remainingEl.textContent = 'This offer has ended.';
+      renderDuration(elapsedEl, 'Ran for ', start.until(end, diffOptions));
+    } else {
+      renderDuration(remainingEl, '', now.until(end, diffOptions), ' left');
+      renderDuration(elapsedEl, 'Running for ', now.since(start, diffOptions));
+    }
+  </script>
 </body>
 
