+    /* Store Picker */
+    .store-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+      margin-top: 1.5rem;
+    }
+
+    .store-picker label {
+      font-size: 0.9rem;
+      letter-spacing: 0.5px;
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      width: 280px;
+      padding: 0.6rem 1rem;
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .store-select:focus-visible {
+      outline: 2px solid white;
+      outline-offset: 2px;
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: rotate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    .store-select::picker(select) {
+      margin-top: 0.25rem;
+      padding: 0.25rem;
+      color: var(--text);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.25);
+      opacity: 0;
+      translate: 0 -0.5rem;
+      transition:
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete,
+        opacity 0.3s ease,
+        translate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        translate: 0 -0.5rem;
+      }
+    }
+
+    .store-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
