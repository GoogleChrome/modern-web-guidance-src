+  <script>
+    const MENU = [
+      { name: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup.', price: 5.75, temperature: ['hot', 'iced'], flavor: ['sweet', 'smooth'], milk: ['oat'], caffeine: 'regular' },
+      { name: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost.', price: 3.25, temperature: ['hot'], flavor: ['bold'], milk: ['none'], caffeine: 'extra' },
+      { name: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness.', price: 4.5, temperature: ['iced'], flavor: ['smooth', 'bold'], milk: ['none', 'dairy', 'oat', 'almond'], caffeine: 'extra' },
+      { name: 'Classic Cappuccino', description: 'Equal parts espresso, steamed milk and velvety foam.', price: 4.25, temperature: ['hot'], flavor: ['bold', 'smooth'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular' },
+      { name: 'Pumpkin Chai Latte', description: 'Black tea, warming spices and real pumpkin purée.', price: 5.5, temperature: ['hot', 'iced'], flavor: ['spiced', 'sweet'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular' },
+      { name: 'Caramel Macchiato', description: 'Vanilla, steamed milk and espresso finished with caramel drizzle.', price: 5.25, temperature: ['hot', 'iced'], flavor: ['sweet'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular' },
+      { name: 'Ethiopian Pour-Over', description: 'Single-origin light roast with notes of blueberry and jasmine.', price: 4.75, temperature: ['hot'], flavor: ['fruity'], milk: ['none'], caffeine: 'regular' },
+      { name: 'Decaf House Drip', description: 'Our medium house blend, Swiss Water decaffeinated.', price: 2.75, temperature: ['hot'], flavor: ['smooth'], milk: ['none', 'dairy', 'oat', 'almond'], caffeine: 'decaf' },
+      { name: 'Iced Almond Mocha', description: 'Espresso, dark chocolate and almond milk over ice.', price: 5.5, temperature: ['iced'], flavor: ['sweet', 'bold'], milk: ['almond'], caffeine: 'regular' },
+      { name: 'Cinnamon Decaf Latte', description: 'Decaf espresso with steamed milk and a dusting of cinnamon.', price: 4.75, temperature: ['hot', 'iced'], flavor: ['spiced', 'smooth'], milk: ['dairy', 'oat', 'almond'], caffeine: 'decaf' },
+    ];
+
+    const form = document.getElementById('coffee-finder-form');
+    const results = document.getElementById('finder-results');
+
+    function findCoffee(prefs) {
+      const maxPrice = parseFloat(prefs.max_price);
+      return MENU.filter((drink) =>
+        (prefs.temperature === 'any' || drink.temperature.includes(prefs.temperature)) &&
+        (prefs.flavor === 'any' || drink.flavor.includes(prefs.flavor)) &&
+        (prefs.milk === 'any' || drink.milk.includes(prefs.milk)) &&
+        (prefs.caffeine === 'any' || drink.caffeine === prefs.caffeine) &&
+        (Number.isNaN(maxPrice) || drink.price <= maxPrice)
+      );
+    }
+
+    function renderResults(matches) {
+      results.replaceChildren();
+
+      const summary = document.createElement('p');
+      summary.className = 'finder-summary';
+      summary.textContent = matches.length
+        ? `We found ${matches.length} drink${matches.length === 1 ? '' : 's'} for you:`
+        : 'No drinks match all of those preferences. Try loosening a filter or two.';
+      results.append(summary);
+
+      if (!matches.length) return;
+
+      const grid = document.createElement('div');
+      grid.className = 'grid';
+      for (const drink of matches) {
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        const title = document.createElement('h3');
+        title.textContent = drink.name;
+        const desc = document.createElement('p');
+        desc.textContent = drink.description;
+        const tags = document.createElement('p');
+        tags.className = 'tags';
+        tags.textContent = `${drink.temperature.join(' / ')} · ${drink.caffeine}`;
+        const price = document.createElement('p');
+        price.className = 'price';
+        price.textContent = `$${drink.price.toFixed(2)}`;
+        const order = document.createElement('a');
+        order.className = 'btn';
+        order.href = `/order-online?item=${encodeURIComponent(drink.name)}`;
+        order.textContent = 'Order This';
+
+        card.append(title, desc, tags, price, order);
+        grid.append(card);
+      }
+      results.append(grid);
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const prefs = Object.fromEntries(new FormData(form));
+      const matches = findCoffee(prefs);
+      renderResults(matches);
+
+      // When submitted by an AI agent via WebMCP, hand the matches back as the tool result.
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve({
+          count: matches.length,
+          drinks: matches.map(({ name, description, price, temperature, caffeine }) => ({
+            name,
+            description,
+            price_usd: price,
+            temperature,
+            caffeine,
+            order_url: new URL(`/order-online?item=${encodeURIComponent(name)}`, location.href).href,
+          })),
+        }));
+      }
+    });
+
+    form.addEventListener('reset', () => results.replaceChildren());
+  </script>
+
 </body>
 
