+  <script>
+    const MENU = [
+      { name: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup.', price: 5.75, temperature: ['hot', 'iced'], roast: 'medium', flavors: ['sweet', 'nutty'], dairyFree: true, decaf: true, url: '/menu/seasonal' },
+      { name: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost.', price: 3.25, temperature: ['hot'], roast: 'dark', flavors: ['chocolatey'], dairyFree: true, decaf: true, url: '/menu/espresso' },
+      { name: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness.', price: 4.50, temperature: ['iced'], roast: 'medium', flavors: ['chocolatey', 'nutty'], dairyFree: true, decaf: false, url: '/menu/cold-brew' },
+      { name: 'Ethiopian Pour-Over', description: 'Single-origin Yirgacheffe with bright blueberry and citrus notes.', price: 4.75, temperature: ['hot'], roast: 'light', flavors: ['fruity'], dairyFree: true, decaf: false, url: '/menu/pour-over' },
+      { name: 'Mocha', description: 'Espresso, steamed milk, and house-made dark chocolate sauce.', price: 5.25, temperature: ['hot', 'iced'], roast: 'dark', flavors: ['chocolatey', 'sweet'], dairyFree: false, decaf: true, url: '/menu/mocha' },
+      { name: 'Chai-Spiced Cortado', description: 'Equal parts espresso and milk with cinnamon, cardamom, and clove.', price: 4.95, temperature: ['hot'], roast: 'medium', flavors: ['spiced', 'sweet'], dairyFree: false, decaf: true, url: '/menu/cortado' },
+      { name: 'Hazelnut Iced Americano', description: 'Espresso over ice with a splash of toasted hazelnut syrup.', price: 4.25, temperature: ['iced'], roast: 'medium', flavors: ['nutty', 'sweet'], dairyFree: true, decaf: true, url: '/menu/americano' },
+      { name: 'Sparkling Citrus Espresso', description: 'Light-roast espresso over sparkling water and orange peel.', price: 5.00, temperature: ['iced'], roast: 'light', flavors: ['fruity'], dairyFree: true, decaf: false, url: '/menu/sparkling-espresso' },
+    ];
+
+    const form = document.getElementById('coffee-finder');
+    const status = document.getElementById('finder-status');
+    const results = document.getElementById('finder-results');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function findCoffee(data) {
+      const temperature = data.get('temperature');
+      const roast = data.get('roast');
+      const flavors = data.getAll('flavor');
+      const maxPrice = data.get('maxPrice') ? Number(data.get('maxPrice')) : Infinity;
+
+      return MENU.filter((drink) =>
+        (temperature === 'any' || drink.temperature.includes(temperature)) &&
+        (roast === 'any' || drink.roast === roast) &&
+        (flavors.length === 0 || flavors.some((f) => drink.flavors.includes(f))) &&
+        (!data.has('dairyFree') || drink.dairyFree) &&
+        (!data.has('decaf') || drink.decaf) &&
+        drink.price <= maxPrice
+      );
+    }
+
+    function renderResults(matches) {
+      results.replaceChildren(...matches.map((drink) => {
+        const li = document.createElement('li');
+        li.className = 'card';
+        const h3 = document.createElement('h3');
+        h3.textContent = drink.name;
+        const desc = document.createElement('p');
+        desc.textContent = drink.description;
+        const price = document.createElement('p');
+        price.className = 'price';
+        price.textContent = currency.format(drink.price);
+        const tags = document.createElement('p');
+        tags.className = 'tags';
+        tags.textContent = [`${drink.roast} roast`, drink.temperature.join(' / '), ...drink.flavors].join(' · ');
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = drink.url;
+        link.textContent = 'View Details';
+        li.append(h3, desc, price, tags, link);
+        return li;
+      }));
+      status.textContent = matches.length
+        ? `We found ${matches.length} drink${matches.length === 1 ? '' : 's'} for you.`
+        : 'No drinks match all of those preferences. Try loosening a filter.';
+    }
+
+    function describeForAgent(matches) {
+      if (!matches.length) {
+        return 'No drinks matched these preferences. Suggest the customer relax a filter (e.g. roast, flavor, or max price) and search again.';
+      }
+      return JSON.stringify({
+        count: matches.length,
+        drinks: matches.map(({ name, description, price, temperature, roast, flavors, dairyFree, decaf, url }) => ({
+          name, description, price: currency.format(price), temperature, roast, flavors, dairyFree, decafAvailable: decaf,
+          url: new URL(url, location.href).href,
+        })),
+      });
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const maxPrice = form.elements.maxPrice;
+      if (!maxPrice.checkValidity()) {
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(`Validation failed: maxPrice (${maxPrice.validationMessage})`));
+        }
+        return;
+      }
+
+      const matches = findCoffee(new FormData(form));
+      renderResults(matches);
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(describeForAgent(matches)));
+      }
+    });
+
+    form.addEventListener('reset', () => {
+      results.replaceChildren();
+      status.textContent = '';
+      form.elements.maxPrice.removeAttribute('aria-invalid');
+    });
+
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const syncAria = (el) => {
+      el.setAttribute?.('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+    form.addEventListener('blur', (e) => syncAria(e.target), true);
+    form.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+  </script>
+
 </body>
 
