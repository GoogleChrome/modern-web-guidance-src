diff --git a/src/hooks/useWebMCPTool.ts b/src/hooks/useWebMCPTool.ts
new file mode 100644
index 0000000..8b8f0f4
--- /dev/null
+++ b/src/hooks/useWebMCPTool.ts
@@ -0,0 +1,67 @@
+import { useEffect, useRef } from 'react';
+
+// Minimal typings for the WebMCP API (navigator.modelContext).
+// See https://github.com/webmachinelearning/webmcp
+export interface ToolResult {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+}
+
+export interface ToolDefinition<Input> {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: Input) => Promise<ToolResult> | ToolResult;
+}
+
+interface ModelContext {
+  registerTool: (tool: ToolDefinition<any>, options?: { signal?: AbortSignal }) => void;
+  unregisterTool?: (name: string) => void;
+}
+
+declare global {
+  interface Navigator {
+    modelContext?: ModelContext;
+  }
+}
+
+export const textResult = (text: string, isError = false): ToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError ? { isError: true } : {}),
+});
+
+/**
+ * Registers a WebMCP tool for as long as the calling component is mounted.
+ * No-op in browsers without navigator.modelContext.
+ */
+export function useWebMCPTool<Input>(tool: ToolDefinition<Input>) {
+  // Keep the latest execute callback so the tool is only registered once.
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = navigator.modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const controller = new AbortController();
+    try {
+      modelContext.registerTool(
+        { ...tool, execute: (input: Input) => executeRef.current(input) },
+        { signal: controller.signal },
+      );
+    } catch (err) {
+      console.error(`Failed to register WebMCP tool "${tool.name}":`, err);
+      return;
+    }
+
+    return () => {
+      controller.abort();
+      try {
+        modelContext.unregisterTool?.(tool.name);
+      } catch {
+        // Already unregistered via the abort signal.
+      }
+    };
+  }, [tool.name]);
+}
