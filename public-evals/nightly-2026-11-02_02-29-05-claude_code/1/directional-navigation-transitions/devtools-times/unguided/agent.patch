@@ -0,0 +1,72 @@
+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+interface Story {
+  id: string;
+  title: string;
+  href: string;
+  date: string;
+}
+
+interface Props {
+  stories: Story[];
+}
+
+type Direction = 'next' | 'prev';
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  // null on first render so the initial story doesn't animate in
+  const [direction, setDirection] = useState<Direction | null>(null);
+
+  if (stories.length === 0) return null;
+
+  const go = (dir: Direction) => {
+    setDirection(dir);
+    setIndex(i => (i + (dir === 'next' ? 1 : -1) + stories.length) % stories.length);
+  };
+
+  const story = stories[index];
+  const animationClass = direction === 'next' ? 'slide-in-from-right' : direction === 'prev' ? 'slide-in-from-left' : '';
+
+  return (
+    <section aria-roledescription="carousel" aria-label="Top stories" className="flex items-center gap-4">
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        className="p-1 rounded-full text-gray-500 hover:text-amber-400 hover:bg-gray-100"
+        aria-label="Previous story"
+      >
+        <ChevronLeftIcon className="h-5 w-5" />
+      </button>
+
+      <div className="flex-1 overflow-hidden" aria-live="polite">
+        <div
+          key={story.id}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${stories.length}`}
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+          </a>
+          <span className="text-xs text-gray-500">{story.date}</span>
+        </div>
+      </div>
+
+      <span className="text-xs text-gray-500 tabular-nums" aria-hidden="true">
+        {index + 1} / {stories.length}
+      </span>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        className="p-1 rounded-full text-gray-500 hover:text-amber-400 hover:bg-gray-100"
+        aria-label="Next story"
+      >
+        <ChevronRightIcon className="h-5 w-5" />
+      </button>
+    </section>
+  );
+}
