+  <script>
+    (() => {
+      const carousel = document.getElementById('seasonal-carousel');
+      const viewport = carousel.querySelector('.carousel-viewport');
+      const slides = [...carousel.querySelectorAll('.carousel-slide')];
+      const status = carousel.querySelector('.carousel-status');
+      const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+      let current = 0;
+
+      function show(index) {
+        slides[current].hidden = true;
+        current = (index + slides.length) % slides.length;
+        slides[current].hidden = false;
+        status.textContent = `${current + 1} / ${slides.length}`;
+        return slides[current];
+      }
+
+      function step(direction) {
+        const next = current + (direction === 'forward' ? 1 : -1);
+
+        if (supportsScopedTransition) {
+          const transition = viewport.startViewTransition({
+            update: () => show(next),
+            types: [direction],
+          });
+          // Rapid clicks skip the running transition; ignore the resulting rejection
+          transition.ready.catch(() => {});
+          return;
+        }
+
+        const slide = show(next);
+        slide.classList.remove('enter-forward', 'enter-backward');
+        void slide.offsetWidth; // restart the animation if the same class is reapplied
+        slide.classList.add(`enter-${direction}`);
+      }
+
+      carousel.querySelectorAll('[data-dir]').forEach((button) => {
+        button.addEventListener('click', () => step(button.dataset.dir));
+      });
+    })();
+  </script>
+
