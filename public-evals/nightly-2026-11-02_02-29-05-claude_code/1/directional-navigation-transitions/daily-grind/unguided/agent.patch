+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      var viewport = carousel.querySelector('.carousel-viewport');
+      var slides = carousel.querySelectorAll('.carousel-slide');
+      var status = carousel.querySelector('.carousel-status');
+      var current = 0;
+
+      function show(index, direction) {
+        var next = (index + slides.length) % slides.length;
+        if (next === current) return;
+
+        slides[current].hidden = true;
+        slides[current].classList.remove('slide-in-next', 'slide-in-prev');
+
+        var slide = slides[next];
+        slide.classList.remove('slide-in-next', 'slide-in-prev');
+        slide.hidden = false;
+        void slide.offsetWidth; // restart the animation on rapid clicks
+        slide.classList.add(direction === 'next' ? 'slide-in-next' : 'slide-in-prev');
+
+        current = next;
+        status.textContent = (current + 1) + ' / ' + slides.length;
+      }
+
+      slides.forEach(function (slide) {
+        slide.addEventListener('animationend', function () {
+          slide.classList.remove('slide-in-next', 'slide-in-prev');
+        });
+      });
+
+      carousel.querySelector('.carousel-next').addEventListener('click', function () {
+        show(current + 1, 'next');
+      });
+      carousel.querySelector('.carousel-prev').addEventListener('click', function () {
+        show(current - 1, 'prev');
+      });
+      viewport.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowRight') {
+          e.preventDefault();
+          show(current + 1, 'next');
+        } else if (e.key === 'ArrowLeft') {
+          e.preventDefault();
+          show(current - 1, 'prev');
+        }
+      });
+    })();
+  </script>
