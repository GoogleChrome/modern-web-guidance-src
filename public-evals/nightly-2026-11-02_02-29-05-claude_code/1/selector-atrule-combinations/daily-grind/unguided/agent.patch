       --light: #fafafa;
+
+      /*
+       * Theme tokens. Each is declared once with light-dark(), which resolves
+       * against the computed color-scheme below. Component rules only consume
+       * these tokens, so no themed rule is ever duplicated per theme.
+       */
+      --page-bg: light-dark(var(--light), #1b1412);
+      --page-text: light-dark(var(--text), #efe6e2);
+
+      --nav-bg: light-dark(var(--primary), #120d0b);
+      --nav-text: light-dark(#ffffff, #efe6e2);
+      --nav-link-hover: light-dark(var(--accent), #ffc77a);
+      --nav-border: light-dark(transparent, rgba(255, 171, 64, 0.25));
+      --nav-shadow: light-dark(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.6));
+
+      --hero-overlay-top: light-dark(rgba(0, 0, 0, 0.35), rgba(10, 6, 5, 0.65));
+      --hero-overlay-bottom: light-dark(rgba(78, 52, 46, 0.55), rgba(10, 6, 5, 0.85));
+      --hero-text: light-dark(#ffffff, #f5ece8);
+      --hero-subtext: light-dark(rgba(255, 255, 255, 0.9), #d7ccc8);
+
+      --card-bg: light-dark(#ffffff, #2a201c);
+      --card-text: light-dark(var(--text), #d7ccc8);
+      --card-heading: light-dark(var(--primary), var(--accent));
+      --card-border: light-dark(transparent, #3d2f29);
+      --card-shadow: light-dark(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.5));
+
+      --btn-bg: light-dark(var(--primary), var(--accent));
+      --btn-text: light-dark(#ffffff, #1b1412);
+      --btn-hover-bg: light-dark(#3e2723, #ffc77a);
+
+      --footer-bg: light-dark(var(--secondary), #120d0b);
+      --footer-text: light-dark(var(--text), #bcaaa4);
+
+      /* Follow the OS preference by default... */
+      color-scheme: light dark;
+    }
+
+    /* ...unless the root element opts into a theme via attribute or class. */
+    :root:is([data-theme="light"], [data-color-scheme="light"], .light, .theme-light) {
+      color-scheme: light;
+    }
+
+    :root:is([data-theme="dark"], [data-color-scheme="dark"], .dark, .theme-dark) {
+      color-scheme: dark;
     }
 
