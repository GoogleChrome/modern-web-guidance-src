diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..c68947b
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,95 @@
+---
+export interface Props {
+    sections: { id: string; title: string }[];
+}
+
+const { sections } = Astro.props;
+---
+<nav
+    aria-label="On this page"
+    data-section-nav
+    class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-200"
+>
+    <ul class="flex gap-6 overflow-x-auto px-4 md:px-6 text-sm font-semibold">
+        {sections.map(section => (
+            <li>
+                <a
+                    href={`#${section.id}`}
+                    aria-current="false"
+                    class="block py-3 border-b-2 border-transparent text-gray-600 whitespace-nowrap hover:text-gray-900 transition-colors"
+                >
+                    {section.title}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<style>
+    [data-section-nav] {
+        /* Natively tracks which fragment link's target is in view (Chromium 140+) */
+        scroll-target-group: auto;
+    }
+
+    /* :is() keeps the rule valid in browsers that don't recognise :target-current */
+    [data-section-nav] a:is(:target-current, .target-current) {
+        color: var(--color-gray-900);
+        border-bottom-color: var(--color-amber-400);
+    }
+</style>
+
+<script>
+    const supportsScrollTargetGroup = CSS.supports('scroll-target-group: auto');
+    let observer: IntersectionObserver | undefined;
+
+    const getLinks = () =>
+        document.querySelectorAll<HTMLAnchorElement>('[data-section-nav] a[href^="#"]');
+
+    const setCurrent = (current: Element | null) => {
+        getLinks().forEach(link => {
+            const isCurrent = link === current;
+            link.classList.toggle('target-current', isCurrent && !supportsScrollTargetGroup);
+            link.setAttribute('aria-current', String(isCurrent));
+        });
+    };
+
+    // Mirror the native :target-current state into aria-current for assistive tech
+    const syncAriaCurrent = () => {
+        setCurrent(document.querySelector('[data-section-nav] a:target-current'));
+    };
+
+    if (supportsScrollTargetGroup) {
+        document.addEventListener('scrollend', syncAriaCurrent);
+    }
+
+    const init = () => {
+        const links = getLinks();
+        if (links.length === 0) return;
+
+        if (supportsScrollTargetGroup) {
+            syncAriaCurrent();
+            return;
+        }
+
+        // Fallback: mark the section crossing the middle of the viewport as current
+        observer = new IntersectionObserver(entries => {
+            entries.forEach(entry => {
+                if (!entry.isIntersecting) return;
+                const link = [...getLinks()].find(l => l.hash === `#${entry.target.id}`);
+                setCurrent(link ?? null);
+            });
+        }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+        links.forEach(link => {
+            const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
+            if (section) observer!.observe(section);
+        });
+    };
+
+    // Re-run after each client-side navigation (ClientRouter)
+    document.addEventListener('astro:page-load', init);
+    document.addEventListener('astro:before-swap', () => {
+        observer?.disconnect();
+        observer = undefined;
+    });
+</script>
