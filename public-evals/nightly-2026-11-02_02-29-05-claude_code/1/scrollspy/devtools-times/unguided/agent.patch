 const { title } = Astro.props;
+
+// Give every <h2> an id so it can be linked to from the "On this page" navigation
+const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+const sections: { id: string; text: string }[] = [];
+const content = (await Astro.slots.render('default')).replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (match, attrs: string, inner: string) => {
+    if (/\sid=/.test(attrs)) return match;
+    const text = inner.replace(/<[^>]+>/g, '').trim();
+    let id = slugify(text) || 'section';
+    while (sections.some(section => section.id === id)) id += '-1';
+    sections.push({ id, text });
+    return `<h2${attrs} id="${id}">${inner}</h2>`;
+});
