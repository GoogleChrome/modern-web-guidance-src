+  <script type="module">
+    const navLinks = document.querySelectorAll('.nav-section-link');
+
+    const setCurrent = (currentLink) => {
+      navLinks.forEach((link) => {
+        const isCurrent = link === currentLink;
+        link.classList.toggle('target-current', isCurrent);
+        link.setAttribute('aria-current', isCurrent ? 'true' : 'false');
+      });
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native :target-current handles the visual state; mirror it to aria-current for assistive tech
+      const syncAriaCurrent = () => {
+        const currentLink = document.querySelector('.nav-section-link:target-current');
+        navLinks.forEach((link) => {
+          link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+        });
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: treat the section crossing the vertical middle of the viewport as current
+      const linkFor = new Map(
+        [...navLinks].map((link) => [document.querySelector(link.hash), link])
+      );
+      const firstSection = linkFor.keys().next().value;
+
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (entry.isIntersecting) {
+            setCurrent(linkFor.get(entry.target));
+          } else if (entry.target === firstSection && entry.boundingClientRect.top > 0) {
+            // Scrolled back up above the first section (into the hero)
+            setCurrent(null);
+          }
+        });
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      linkFor.forEach((_, section) => observer.observe(section));
+    }
+  </script>
+
