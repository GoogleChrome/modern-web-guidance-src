+  <script>
+    const board = document.querySelector('.board');
+    const statusRegion = document.getElementById('board-status');
+    const placeholder = document.createElement('li');
+    placeholder.className = 'drop-placeholder';
+    placeholder.setAttribute('aria-hidden', 'true');
+
+    let dragged = null;
+    let overColumn = null;
+    let pending = null;
+    let frame = 0;
+
+    // moveBefore() keeps focus and element state; fall back to insertBefore().
+    const moveCard = (list, card, ref = null) =>
+      list.moveBefore ? list.moveBefore(card, ref) : list.insertBefore(card, ref);
+
+    const columnTitle = (column) => column.querySelector('h3').textContent;
+
+    function updateCount(list) {
+      const count = list.childElementCount;
+      const badge = list.closest('.board-column').querySelector('.order-count');
+      badge.textContent = count;
+      badge.setAttribute('aria-label', `${count} orders`);
+    }
+
+    function announce(card) {
+      const list = card.parentElement;
+      const position = Array.prototype.indexOf.call(list.children, card) + 1;
+      statusRegion.textContent = `${card.querySelector('h4').textContent} in ${columnTitle(list.closest('.board-column'))}, position ${position} of ${list.childElementCount}`;
+    }
+
+    function setOverColumn(column) {
+      if (column === overColumn) return;
+      overColumn?.classList.remove('is-over');
+      column?.classList.add('is-over');
+      overColumn = column;
+    }
+
+    function clearIndicator() {
+      cancelAnimationFrame(frame);
+      frame = 0;
+      pending = null;
+      placeholder.remove();
+      setOverColumn(null);
+    }
+
+    // Runs at most once per frame: one geometry read, then at most one DOM write.
+    function updatePlaceholder() {
+      frame = 0;
+      if (!pending || !dragged) return;
+      const { column, target, y } = pending;
+      const list = column.querySelector('.order-list');
+      setOverColumn(column);
+
+      let ref = null;
+      if (target && target !== dragged && target.parentElement === list) {
+        const rect = target.getBoundingClientRect();
+        ref = y < rect.top + rect.height / 2 ? target : target.nextElementSibling;
+      } else if (target === dragged || placeholder.parentElement === list) {
+        return;
+      }
+
+      if (ref === placeholder) return;
+      if (placeholder.parentElement === list && placeholder.nextElementSibling === ref) return;
+      list.insertBefore(placeholder, ref);
+    }
+
+    board.addEventListener('dragstart', (event) => {
+      const card = event.target.closest('.order-list > .card');
+      if (!card) return;
+      dragged = card;
+      event.dataTransfer.effectAllowed = 'move';
+      event.dataTransfer.setData('text/plain', card.querySelector('h4').textContent);
+      // Fade after the browser has captured the drag image.
+      requestAnimationFrame(() => dragged?.classList.add('is-dragging'));
+    });
+
+    board.addEventListener('dragover', (event) => {
+      if (!dragged) return;
+      const column = event.target.closest('.board-column');
+      if (!column) return;
+      event.preventDefault();
+      event.dataTransfer.dropEffect = 'move';
+      pending = { column, target: event.target.closest('.card'), y: event.clientY };
+      if (!frame) frame = requestAnimationFrame(updatePlaceholder);
+    });
+
+    board.addEventListener('dragleave', (event) => {
+      if (dragged && !board.contains(event.relatedTarget)) clearIndicator();
+    });
+
+    board.addEventListener('drop', (event) => {
+      if (!dragged) return;
+      event.preventDefault();
+      if (frame) updatePlaceholder();
+      const target = placeholder.parentElement;
+      if (!target) return;
+      const source = dragged.parentElement;
+      moveCard(target, dragged, placeholder);
+      placeholder.remove();
+      updateCount(target);
+      if (source !== target) updateCount(source);
+      announce(dragged);
+    });
+
+    board.addEventListener('dragend', () => {
+      dragged?.classList.remove('is-dragging');
+      dragged = null;
+      clearIndicator();
+    });
+
+    board.addEventListener('keydown', (event) => {
+      const card = event.target.closest('.order-list > .card');
+      if (!card || event.altKey || event.ctrlKey || event.metaKey) return;
+      const list = card.parentElement;
+
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        const columns = [...board.querySelectorAll('.board-column')];
+        const index = columns.indexOf(list.closest('.board-column')) + (event.key === 'ArrowLeft' ? -1 : 1);
+        if (index < 0 || index >= columns.length) return;
+        const target = columns[index].querySelector('.order-list');
+        moveCard(target, card);
+        updateCount(list);
+        updateCount(target);
+      } else if (event.key === 'ArrowUp' && card.previousElementSibling) {
+        moveCard(list, card, card.previousElementSibling);
+      } else if (event.key === 'ArrowDown' && card.nextElementSibling) {
+        moveCard(list, card, card.nextElementSibling.nextElementSibling);
+      } else {
+        return;
+      }
+      event.preventDefault();
+      if (document.activeElement !== card) card.focus();
+      announce(card);
+    });
+
+    // Bulk-insert test tickets in a single DOM write.
+    const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Flat White', 'Chai Latte', 'Cortado', 'Mocha', 'Americano'];
+    const names = ['Alex', 'Jordan', 'Riley', 'Casey', 'Morgan', 'Taylor', 'Jamie', 'Avery'];
+    const sizes = ['8oz', '12oz', '16oz', '20oz'];
+    let nextOrder = 1044;
+
+    document.getElementById('simulate-rush').addEventListener('click', () => {
+      const queued = board.querySelector('[data-status="queued"] .order-list');
+      const fragment = document.createDocumentFragment();
+      for (let i = 0; i < 250; i++, nextOrder++) {
+        const card = document.createElement('li');
+        card.className = 'card';
+        card.draggable = true;
+        card.tabIndex = 0;
+        card.setAttribute('aria-describedby', 'board-help');
+        const title = document.createElement('h4');
+        title.textContent = drinks[nextOrder % drinks.length];
+        const meta = document.createElement('p');
+        meta.className = 'order-meta';
+        meta.textContent = `#${nextOrder} · ${names[nextOrder % names.length]} · ${sizes[nextOrder % sizes.length]}`;
+        card.append(title, meta);
+        fragment.append(card);
+      }
+      queued.append(fragment);
+      updateCount(queued);
+      statusRegion.textContent = `250 orders added to Queued`;
+    });
+  </script>
+
 </body>
 
