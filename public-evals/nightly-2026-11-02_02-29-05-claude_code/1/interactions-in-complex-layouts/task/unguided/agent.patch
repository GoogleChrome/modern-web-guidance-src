+  <script>
+    (() => {
+      const board = document.getElementById('order-board');
+      if (!board) return;
+
+      const DRAG_THRESHOLD = 4;
+      const AUTOSCROLL_EDGE = 40;
+      const AUTOSCROLL_SPEED = 12;
+
+      const columns = [...board.querySelectorAll('.board-column')].map((el) => {
+        const list = el.querySelector('.board-list');
+        return {
+          el,
+          list,
+          status: el.dataset.status,
+          countEl: el.querySelector('.board-count'),
+          count: list.children.length,
+          rect: null
+        };
+      });
+      const columnByList = new Map(columns.map((c) => [c.list, c]));
+
+      // A single reusable ghost element, moved only via transform (compositor-only).
+      const ghost = document.createElement('div');
+      ghost.className = 'drag-ghost';
+      ghost.hidden = true;
+      ghost.setAttribute('aria-hidden', 'true');
+      document.body.appendChild(ghost);
+
+      let pending = null; // pointerdown that hasn't crossed the drag threshold yet
+      let drag = null;    // active drag state
+      let rafId = 0;
+
+      function setCount(col, delta) {
+        col.count += delta;
+        col.countEl.textContent = col.count;
+        col.countEl.setAttribute('aria-label', col.count + ' orders');
+      }
+
+      function measureColumns() {
+        for (const col of columns) col.rect = col.list.getBoundingClientRect();
+      }
+
+      function hitColumn(x, y) {
+        for (const col of columns) {
+          const r = col.rect;
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return col;
+        }
+        return null;
+      }
+
+      // Read card midpoints for a column once, normalised to a layout without the
+      // placeholder, so later index lookups are pure arithmetic (no layout reads).
+      function measureTarget(col) {
+        const card = drag.card;
+        const cards = [];
+        const mids = [];
+        let afterPlaceholder = false;
+        for (const el of col.list.children) {
+          if (el === card) { afterPlaceholder = true; continue; }
+          const top = el.offsetTop - (afterPlaceholder ? drag.step : 0);
+          cards.push(el);
+          mids.push(top + el.offsetHeight / 2);
+        }
+        drag.target = { col, cards, mids };
+      }
+
+      function placeholderIndexIn(target) {
+        if (drag.card.parentNode !== target.col.list) return -1;
+        const i = target.cards.indexOf(drag.card.nextElementSibling);
+        return i === -1 ? target.cards.length : i;
+      }
+
+      function startDrag(e) {
+        const card = pending.card;
+        const rect = card.getBoundingClientRect();
+        measureColumns();
+
+        const fromCol = columnByList.get(card.parentNode);
+        drag = {
+          card,
+          fromCol,
+          fromNext: card.nextElementSibling,
+          pointerId: e.pointerId,
+          offsetX: pending.x - rect.left,
+          offsetY: pending.y - rect.top,
+          x: e.clientX,
+          y: e.clientY,
+          step: rect.height + 8, // card height + list gap
+          target: null,
+          overCol: null
+        };
+
+        ghost.innerHTML = card.innerHTML;
+        ghost.style.width = rect.width + 'px';
+        ghost.hidden = false;
+        card.classList.add('is-placeholder');
+        card.setAttribute('aria-grabbed', 'true');
+        document.body.classList.add('is-dragging');
+        pending = null;
+        schedule();
+      }
+
+      function schedule() {
+        if (!rafId) rafId = requestAnimationFrame(frame);
+      }
+
+      function frame() {
+        rafId = 0;
+        if (!drag) return;
+        const { x, y } = drag;
+
+        // --- reads ---
+        const col = hitColumn(x, y);
+        let index = -1;
+        let scrollDelta = 0;
+        if (col) {
+          if (!drag.target || drag.target.col !== col) measureTarget(col);
+          const t = drag.target;
+          const r = col.rect;
+          const localY = y - r.top + col.list.scrollTop;
+          const current = placeholderIndexIn(t);
+          index = 0;
+          for (let i = 0; i < t.mids.length; i++) {
+            const mid = t.mids[i] + (current !== -1 && i >= current ? drag.step : 0);
+            if (mid < localY) index = i + 1; else break;
+          }
+          if (y < r.top + AUTOSCROLL_EDGE) scrollDelta = -AUTOSCROLL_SPEED;
+          else if (y > r.bottom - AUTOSCROLL_EDGE) scrollDelta = AUTOSCROLL_SPEED;
+        }
+
+        // --- writes ---
+        ghost.style.transform =
+          `translate3d(${x - drag.offsetX}px, ${y - drag.offsetY}px, 0) rotate(2deg)`;
+
+        if (col !== drag.overCol) {
+          if (drag.overCol) drag.overCol.el.classList.remove('is-over');
+          if (col) col.el.classList.add('is-over');
+          drag.overCol = col;
+        }
+
+        if (col) {
+          const t = drag.target;
+          const ref = t.cards[index] || null;
+          if (drag.card.parentNode !== col.list || drag.card.nextElementSibling !== ref) {
+            col.list.insertBefore(drag.card, ref);
+          }
+          if (scrollDelta) {
+            col.list.scrollTop += scrollDelta;
+            schedule(); // keep auto-scrolling while held near the edge
+          }
+        }
+      }
+
+      function finishDrag(cancelled) {
+        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
+        const { card, fromCol, fromNext, overCol } = drag;
+        if (overCol) overCol.el.classList.remove('is-over');
+
+        if (cancelled) fromCol.list.insertBefore(card, fromNext);
+        const toCol = columnByList.get(card.parentNode);
+
+        ghost.hidden = true;
+        ghost.style.transform = '';
+        ghost.textContent = '';
+        card.classList.remove('is-placeholder');
+        card.removeAttribute('aria-grabbed');
+        document.body.classList.remove('is-dragging');
+        drag = null;
+
+        if (!cancelled) commitMove(card, fromCol, toCol, fromNext);
+      }
+
+      function commitMove(card, fromCol, toCol, fromNext) {
+        if (fromCol === toCol && card.nextElementSibling === fromNext) return;
+        if (fromCol !== toCol) {
+          setCount(fromCol, -1);
+          setCount(toCol, 1);
+        }
+        board.dispatchEvent(new CustomEvent('order:moved', {
+          detail: {
+            orderId: card.dataset.orderId,
+            from: fromCol.status,
+            to: toCol.status,
+            index: Array.prototype.indexOf.call(toCol.list.children, card)
+          }
+        }));
+      }
+
+      board.addEventListener('pointerdown', (e) => {
+        if (drag || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        const card = e.target.closest('.card');
+        if (!card || !board.contains(card)) return;
+        pending = { card, x: e.clientX, y: e.clientY, pointerId: e.pointerId };
+        board.setPointerCapture(e.pointerId);
+      });
+
+      board.addEventListener('pointermove', (e) => {
+        if (pending && e.pointerId === pending.pointerId) {
+          if (Math.abs(e.clientX - pending.x) + Math.abs(e.clientY - pending.y) < DRAG_THRESHOLD) return;
+          startDrag(e);
+        }
+        if (!drag || e.pointerId !== drag.pointerId) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        schedule();
+      }, { passive: true });
+
+      const endPointer = (cancelled) => (e) => {
+        if (pending && e.pointerId === pending.pointerId) pending = null;
+        if (drag && e.pointerId === drag.pointerId) finishDrag(cancelled);
+      };
+      board.addEventListener('pointerup', endPointer(false));
+      board.addEventListener('pointercancel', endPointer(true));
+      board.addEventListener('lostpointercapture', endPointer(false));
+
+      // Cached rects go stale if the page or a column scrolls mid-drag.
+      const invalidate = (e) => {
+        if (!drag) return;
+        if (e.target === document || !columnByList.has(e.target)) measureColumns();
+        schedule();
+      };
+      window.addEventListener('scroll', invalidate, { passive: true, capture: true });
+      window.addEventListener('resize', invalidate, { passive: true });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && drag) finishDrag(true);
+      });
+
+      // Keyboard support: arrows move the focused card between/within columns.
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || drag) return;
+        const fromCol = columnByList.get(card.parentNode);
+        const fromNext = card.nextElementSibling;
+        const i = columns.indexOf(fromCol);
+        let toCol = fromCol;
+
+        if (e.key === 'ArrowLeft' && i > 0) toCol = columns[i - 1];
+        else if (e.key === 'ArrowRight' && i < columns.length - 1) toCol = columns[i + 1];
+        else if (e.key === 'ArrowUp' && card.previousElementSibling) {
+          fromCol.list.insertBefore(card, card.previousElementSibling);
+        } else if (e.key === 'ArrowDown' && fromNext) {
+          fromCol.list.insertBefore(card, fromNext.nextElementSibling);
+        } else return;
+
+        e.preventDefault();
+        if (toCol !== fromCol) toCol.list.appendChild(card);
+        card.focus({ preventScroll: true });
+        card.scrollIntoView({ block: 'nearest' });
+        commitMove(card, fromCol, toCol, fromNext);
+      });
+    })();
+  </script>
+
