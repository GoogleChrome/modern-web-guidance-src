+  <script>
+    (() => {
+      const drawer = document.getElementById('nav-drawer');
+      const track = drawer.querySelector('.drawer-track');
+      const dismiss = drawer.querySelector('.drawer-dismiss');
+
+      // Swipe-to-close: the panel was scrolled fully away onto the dismiss snap point.
+      if ('onscrollsnapchange' in window) {
+        track.addEventListener('scrollsnapchange', (e) => {
+          if (e.snapTargetInline === dismiss) drawer.close();
+        });
+      } else {
+        track.addEventListener('scrollend', () => {
+          if (track.scrollLeft >= dismiss.offsetLeft - 1) drawer.close();
+        });
+      }
+
+      // The visible area beside the panel is part of the dialog, not its ::backdrop,
+      // so treat taps there as backdrop taps.
+      dismiss.addEventListener('click', () => drawer.close());
+
+      // Always reopen with the panel in view.
+      drawer.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') track.scrollLeft = 0;
+      });
+
+      // Fallbacks for browsers without invoker commands or dialog closedby.
+      if (!('command' in HTMLButtonElement.prototype)) {
+        document.querySelectorAll('button[commandfor="nav-drawer"]').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const command = btn.getAttribute('command');
+            if (command === 'show-modal') drawer.showModal();
+            else if (command === 'close') drawer.close();
+          });
+        });
+      }
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        drawer.addEventListener('click', (e) => {
+          if (e.target === drawer) drawer.close();
+        });
+      }
+    })();
+  </script>
+
