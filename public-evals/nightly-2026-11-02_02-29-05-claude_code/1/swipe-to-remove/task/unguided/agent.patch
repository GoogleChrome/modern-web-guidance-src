+  <script>
+    (function () {
+      // Fraction of the item's width the user must swipe past to remove it.
+      var THRESHOLD = 0.4;
+      // Horizontal movement (px) required before we treat the gesture as a swipe.
+      var DRAG_START = 8;
+
+      var list = document.querySelector('.SwipeableList');
+      var emptyMessage = document.querySelector('.cart-empty');
+      if (!list) return;
+
+      function removeItem(item) {
+        if (item.classList.contains('is-collapsing')) return;
+        var content = item.querySelector('.SwipeableList-content');
+        item.classList.add('is-armed');
+        content.style.transform = 'translateX(-100%)';
+
+        // Pin the current height so it can transition down to 0.
+        item.style.height = item.offsetHeight + 'px';
+        void item.offsetHeight;
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          var next = item.nextElementSibling || item.previousElementSibling;
+          item.remove();
+          if (!list.children.length) {
+            emptyMessage.hidden = false;
+          } else if (next && document.activeElement === document.body) {
+            next.querySelector('.SwipeableList-content').focus();
+          }
+        }
+
+        setTimeout(function () {
+          item.classList.add('is-collapsing');
+          item.addEventListener('transitionend', function (e) {
+            if (e.target === item && e.propertyName === 'height') finish();
+          });
+          // Fallback for reduced motion or missed transitionend.
+          setTimeout(finish, 400);
+        }, 200);
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(function (item) {
+        var content = item.querySelector('.SwipeableList-content');
+        var startX = 0;
+        var startY = 0;
+        var dx = 0;
+        var pointerId = null;
+        var dragging = false;
+
+        function reset() {
+          pointerId = null;
+          dragging = false;
+          item.classList.remove('is-swiping', 'is-armed');
+          content.style.transform = '';
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || e.button !== 0 || item.classList.contains('is-collapsing')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var moveX = e.clientX - startX;
+          var moveY = e.clientY - startY;
+
+          if (!dragging) {
+            // Let vertical scrolls through; only start once motion is mostly horizontal.
+            if (Math.abs(moveY) > DRAG_START && Math.abs(moveY) > Math.abs(moveX)) {
+              pointerId = null;
+              return;
+            }
+            if (Math.abs(moveX) < DRAG_START) return;
+            dragging = true;
+            content.setPointerCapture(pointerId);
+            item.classList.add('is-swiping');
+          }
+
+          // Only allow swiping left; resist slightly when dragged right.
+          dx = moveX < 0 ? moveX : moveX * 0.2;
+          content.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-armed', -dx > content.offsetWidth * THRESHOLD);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          var shouldRemove = dragging && e.type === 'pointerup' && -dx > content.offsetWidth * THRESHOLD;
+          if (shouldRemove) {
+            pointerId = null;
+            dragging = false;
+            item.classList.remove('is-swiping');
+            removeItem(item);
+          } else {
+            reset();
+          }
+        }
+
+        content.addEventListener('pointerup', end);
+        content.addEventListener('pointercancel', end);
+
+        content.addEventListener('keydown', function (e) {
+          if (e.key === 'Delete' || e.key === 'Backspace') {
+            e.preventDefault();
+            removeItem(item);
+          }
+        });
+      });
+    })();
+  </script>
+
