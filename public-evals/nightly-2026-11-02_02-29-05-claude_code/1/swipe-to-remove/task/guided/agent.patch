+  <script>
+    // Per-item handles, populated when an item is first lazily wired up.
+    const swipeObservers = new WeakMap();
+
+    // Browsers without `scroll-initial-target` need the track scrolled to the
+    // content manually (and re-applied when the track resizes).
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const trackResizeObserver = needsScrollWorkaround
+      ? new ResizeObserver((entries) => {
+          for (const entry of entries) {
+            entry.target.scrollLeft = entry.target.clientWidth;
+          }
+        })
+      : null;
+
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Lazily wire up items as they enter the viewport, and pause swipe
+    // tracking for items that leave it.
+    const viewportObserver = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (entry.isIntersecting) {
+          const handle = swipeObservers.get(item) ?? setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          const handle = swipeObservers.get(item);
+          if (handle) handle.observer.unobserve(handle.content);
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = track.querySelector('.SwipeableList-content');
+
+      // Turns the track into a snap container (see CSS).
+      item.classList.add('is-initialized');
+
+      // Must run after `.is-initialized` and before the inner observer is
+      // attached, or the initial scroll would register as a swipe.
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        trackResizeObserver.observe(track);
+      }
+
+      // Visible ratio below which the icon pops / the removal commits.
+      const activateThreshold = 0.8;
+      const commitThreshold = 0.2;
+
+      const observer = new IntersectionObserver((entries) => {
+        const entry = entries.at(-1);
+        const ratio = entry.intersectionRatio;
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        const direction = offset > 0 ? 'left' : 'right';
+
+        if (ratio < commitThreshold) {
+          dismiss(item, content, direction, entry.boundingClientRect, entry.rootBounds);
+          return;
+        }
+
+        item.classList.toggle('is-activating', ratio < activateThreshold);
+
+        // Hold the previous direction at rest so the icon's exit animation
+        // finishes on the side the user was swiping toward.
+        if (offset !== 0) {
+          item.dataset.swipeDirection = direction;
+        }
+      }, {
+        root: track,
+        threshold: [commitThreshold, activateThreshold],
+      });
+
+      // Accessible alternative to the swipe gesture.
+      item.querySelector('.cart-item-remove').addEventListener('click', () => {
+        dismiss(item, content, 'right', content.getBoundingClientRect(), track.getBoundingClientRect());
+      });
+
+      const handle = { observer, content, track };
+      swipeObservers.set(item, handle);
+      return handle;
+    }
+
+    function dismiss(item, content, direction, rect, rootBounds) {
+      if (item.classList.contains('is-removing')) return;
+      const handle = swipeObservers.get(item);
+      viewportObserver.unobserve(item);
+      handle.observer.disconnect();
+      if (needsScrollWorkaround) trackResizeObserver.unobserve(handle.track);
+      removeItem(item, content, direction, rect, rootBounds);
+    }
+
+    async function removeItem(item, content, direction, rect, rootBounds) {
+      const opts = {
+        duration: reducedMotion.matches ? 0 : 300,
+        easing: 'ease',
+        fill: 'forwards',
+      };
+
+      // Distance the content still has to travel to be fully off-screen.
+      const x = rect.x - rootBounds.x;
+      const translate = direction === 'left' ? rect.width - x : -(x + rect.width);
+
+      // Show the action color behind the row, then collapse its height. The
+      // translate keeps the content moving in case the snap hasn't finished.
+      item.classList.add('is-removing', 'is-activating');
+      item.dataset.swipeDirection = direction;
+      item.animate([{ height: `${rect.height}px` }, { height: '0px' }], opts);
+      content.animate([{ translate: `${translate}px` }], opts);
+      await Promise.allSettled(
+        item.getAnimations({ subtree: true }).map((a) => a.finished),
+      );
+
+      // Safari: removing the node while swipe momentum is still resolving
+      // makes the next row inherit the scroll, so defer removal there.
+      if (globalThis.GestureEvent) {
+        item.inert = true;
+        setTimeout(() => item.remove(), 5000);
+      } else {
+        item.remove();
+      }
+    }
+
+    function setupList(list) {
+      for (const item of list.children) {
+        if (item.matches('.SwipeableList-item')) {
+          viewportObserver.observe(item);
+        }
+      }
+
+      // Pick up items added to the cart later.
+      new MutationObserver((mutations) => {
+        for (const mutation of mutations) {
+          for (const node of mutation.addedNodes) {
+            if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+              viewportObserver.observe(node);
+            }
+          }
+        }
+      }).observe(list, { childList: true });
+    }
+
+    document.querySelectorAll('.SwipeableList').forEach(setupList);
+  </script>
