+  <script>
+    (() => {
+      const input = document.getElementById("search-input");
+      const grid = document.getElementById("menu-grid");
+      const supportsHighlights = "highlights" in CSS;
+
+      function getTextNodes() {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      }
+
+      // Menu content is static, so the text nodes can be collected once.
+      const textNodes = supportsHighlights ? getTextNodes() : null;
+
+      function findMatches(text, term) {
+        const positions = [];
+        const lower = text.toLowerCase();
+        let pos = lower.indexOf(term);
+        while (pos !== -1) {
+          positions.push(pos);
+          pos = lower.indexOf(term, pos + term.length);
+        }
+        return positions;
+      }
+
+      function highlightWithApi(term) {
+        CSS.highlights.delete("menu-search");
+        if (!term) return;
+        const ranges = [];
+        for (const node of textNodes) {
+          for (const pos of findMatches(node.textContent, term)) {
+            const range = new Range();
+            range.setStart(node, pos);
+            range.setEnd(node, pos + term.length);
+            ranges.push(range);
+          }
+        }
+        if (ranges.length) CSS.highlights.set("menu-search", new Highlight(...ranges));
+      }
+
+      function highlightWithMarks(term) {
+        for (const mark of grid.querySelectorAll("mark.menu-search")) {
+          const parent = mark.parentNode;
+          mark.replaceWith(...mark.childNodes);
+          parent.normalize();
+        }
+        if (!term) return;
+        for (const node of getTextNodes()) {
+          const text = node.textContent;
+          const positions = findMatches(text, term);
+          if (!positions.length) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (const pos of positions) {
+            frag.append(text.slice(last, pos));
+            const mark = document.createElement("mark");
+            mark.className = "menu-search";
+            mark.textContent = text.slice(pos, pos + term.length);
+            frag.append(mark);
+            last = pos + term.length;
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      }
+
+      input.addEventListener("input", () => {
+        const term = input.value.trim().toLowerCase();
+        (supportsHighlights ? highlightWithApi : highlightWithMarks)(term);
+      });
+    })();
+  </script>
+
 </body>
 
