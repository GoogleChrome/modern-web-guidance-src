+  <script>
+    // Fallback for browsers without VisibilityStateEntry (Firefox, Safari):
+    // accumulate visible time ourselves from visibilitychange events. This can
+    // miss time before the script ran, but it won't count background time.
+    const supportsVisibilityEntries = 'VisibilityStateEntry' in window;
+    let fallbackForegroundTime = 0;
+    let fallbackVisibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+    if (!supportsVisibilityEntries) {
+      document.addEventListener('visibilitychange', () => {
+        const now = performance.now();
+        if (document.visibilityState === 'hidden' && fallbackVisibleSince !== null) {
+          fallbackForegroundTime += now - fallbackVisibleSince;
+          fallbackVisibleSince = null;
+        } else if (document.visibilityState === 'visible' && fallbackVisibleSince === null) {
+          fallbackVisibleSince = now;
+        }
+      });
+    }
+
+    /**
+     * Calculates total time the page was in the visible (foreground) state.
+     *
+     * @returns {number} Total foreground time in milliseconds.
+     */
+    function getTotalForegroundTime() {
+      const entries = supportsVisibilityEntries
+        ? performance.getEntriesByType('visibility-state')
+        : [];
+
+      if (entries.length === 0) {
+        return fallbackForegroundTime +
+          (fallbackVisibleSince !== null ? performance.now() - fallbackVisibleSince : 0);
+      }
+
+      let totalForegroundTime = 0;
+
+      for (let i = 0; i < entries.length; i++) {
+        if (entries[i].name === 'visible') {
+          // A visible period ends at the next state change, or now if it's ongoing.
+          const end = i + 1 < entries.length ? entries[i + 1].startTime : performance.now();
+          totalForegroundTime += end - entries[i].startTime;
+        }
+      }
+
+      return totalForegroundTime;
+    }
+  </script>
+
