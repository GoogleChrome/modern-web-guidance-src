diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,28 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Staggered entrance: each card starts 100ms after the previous one */
+    .grid > .card {
+      --stagger-time: 100ms;
+      animation: card-in 0.5s ease-out backwards;
+      /* Fallback for browsers without sibling-index(); --sibling-index is set by script */
+      animation-delay: calc((var(--sibling-index, 1) - 1) * var(--stagger-time));
+      animation-delay: calc((sibling-index() - 1) * var(--stagger-time));
+
+      @media (prefers-reduced-motion: reduce) {
+        animation: none;
+      }
+    }
+
+    @keyframes card-in {
+      from {
+        opacity: 0;
+        translate: 0 20px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
@@ -206,7 +226,15 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    if (!CSS.supports('animation-delay: calc(sibling-index() * 0.1s)')) {
+      document.querySelectorAll('.grid').forEach((grid) => {
+        [...grid.children].forEach((el, index) => el.style.setProperty('--sibling-index', index + 1));
+      });
+    }
+  </script>
