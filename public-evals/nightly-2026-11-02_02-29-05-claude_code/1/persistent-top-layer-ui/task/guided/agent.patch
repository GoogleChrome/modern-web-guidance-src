+  <script>
+    const dialog = document.getElementById('feedback');
+    const form = document.getElementById('feedback-form');
+    const moveBtn = document.getElementById('move-feedback');
+    const locationLabel = document.getElementById('feedback-location');
+    const docks = [document.getElementById('dock-main'), document.getElementById('dock-footer')];
+
+    document.getElementById('open-feedback').addEventListener('click', () => dialog.showModal());
+
+    // Reparent an element; keeps an open modal open and focused.
+    function relocate(el, newParent, refNode = null) {
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: top-layer status, focus and selection are preserved.
+        newParent.moveBefore(el, refNode);
+        return;
+      }
+
+      // Fallback: insertBefore removes the node first, which drops it from the
+      // top layer, so capture state and restore it after re-inserting.
+      const wasModal = el.matches(':modal');
+      const active = el.contains(document.activeElement) ? document.activeElement : null;
+      const selection = active && 'selectionStart' in active && active.selectionStart !== null
+        ? [active.selectionStart, active.selectionEnd, active.selectionDirection]
+        : null;
+      const scrollTop = el.scrollTop;
+
+      newParent.insertBefore(el, refNode);
+
+      if (wasModal) {
+        // The open attribute survives removal but the dialog is no longer modal;
+        // showModal() throws on an open non-modal dialog, so clear it first.
+        el.removeAttribute('open');
+        el.showModal();
+        el.scrollTop = scrollTop;
+        if (active) {
+          active.focus({ preventScroll: true });
+          if (selection) active.setSelectionRange(...selection);
+        }
+      }
+    }
+
+    moveBtn.addEventListener('click', () => {
+      const current = dialog.parentElement;
+      const target = docks.find((dock) => dock !== current);
+      relocate(dialog, target);
+      locationLabel.textContent = target.dataset.dockName;
+      const next = docks.find((dock) => dock !== target);
+      moveBtn.textContent = next.id === 'dock-footer' ? 'Move to footer' : 'Move to main content';
+    });
+
+    dialog.addEventListener('close', () => {
+      // Ignore a stray close from the fallback relocation; it was reopened.
+      if (dialog.open) return;
+      if (dialog.returnValue === 'send') {
+        form.reset();
+      }
+      dialog.returnValue = '';
+    });
+  </script>
