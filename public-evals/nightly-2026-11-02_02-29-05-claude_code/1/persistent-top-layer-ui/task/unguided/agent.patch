+  <button type="button" class="feedback-trigger" data-dock-target="">Feedback</button>
+
+  <!-- Appended into a [data-dock] region on load (footer by default) and relocated from there. -->
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="fb-title">
+    <form id="feedback-form">
+      <h2 id="fb-title">Share your feedback</h2>
+      <p class="fb-context">About: <strong id="fb-context-label">Footer</strong></p>
+
+      <fieldset>
+        <legend>Move feedback to section</legend>
+        <div class="fb-moves">
+          <button type="button" data-move="hero" aria-pressed="false">Hero</button>
+          <button type="button" data-move="seasonal" aria-pressed="false">Seasonal</button>
+          <button type="button" data-move="footer" aria-pressed="false">Footer</button>
+        </div>
+      </fieldset>
+
+      <fieldset>
+        <legend>How was it?</legend>
+        <div class="fb-ratings">
+          <label><input type="radio" name="rating" value="1"> 1</label>
+          <label><input type="radio" name="rating" value="2"> 2</label>
+          <label><input type="radio" name="rating" value="3"> 3</label>
+          <label><input type="radio" name="rating" value="4"> 4</label>
+          <label><input type="radio" name="rating" value="5"> 5</label>
+        </div>
+      </fieldset>
+
+      <label for="fb-message">Comments</label>
+      <textarea id="fb-message" name="message" placeholder="Tell us what you think..."></textarea>
+
+      <p class="fb-status" id="fb-status" role="status" aria-live="polite"></p>
+
+      <div class="fb-actions">
+        <button type="button" id="fb-close">Close</button>
+        <button type="submit">Send feedback</button>
+      </div>
+    </form>
