+
+  <script>
+    (() => {
+      const STORAGE_KEY = 'daily-grind-feedback';
+      const dialog = document.getElementById('feedback-dialog');
+      const form = document.getElementById('feedback-form');
+      const message = document.getElementById('fb-message');
+      const status = document.getElementById('fb-status');
+      const contextLabel = document.getElementById('fb-context-label');
+      const moveButtons = dialog.querySelectorAll('[data-move]');
+
+      // ?nomovebefore forces the fallback path for testing.
+      const supportsMoveBefore = 'moveBefore' in Element.prototype &&
+        !new URLSearchParams(location.search).has('nomovebefore');
+
+      const docks = Object.fromEntries(
+        [...document.querySelectorAll('[data-dock]')].map((el) => [el.dataset.dock, el])
+      );
+
+      const currentDock = () => dialog.parentElement.closest('[data-dock]')?.dataset.dock;
+
+      // --- Draft persistence ---------------------------------------------------
+      const saveDraft = () => {
+        const rating = form.elements.rating.value;
+        localStorage.setItem(STORAGE_KEY, JSON.stringify({
+          dock: currentDock(),
+          rating,
+          message: message.value,
+          open: dialog.open,
+        }));
+      };
+
+      const loadDraft = () => {
+        try {
+          return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
+        } catch {
+          return {};
+        }
+      };
+
+      // --- Relocation ------------------------------------------------------------
+      const updateDockUi = () => {
+        const dock = currentDock();
+        contextLabel.textContent = docks[dock]?.dataset.dockLabel ?? '';
+        moveButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.move === dock)));
+      };
+
+      // Snapshot everything that a remove/insert would reset.
+      const captureState = () => {
+        const active = document.activeElement;
+        const focused = dialog.contains(active) ? active : null;
+        return {
+          open: dialog.open,
+          modal: dialog.matches(':modal'),
+          focused,
+          selection: focused && typeof focused.selectionStart === 'number'
+            ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection]
+            : null,
+          scrollTop: dialog.scrollTop,
+          textScrollTop: message.scrollTop,
+        };
+      };
+
+      const restoreState = (state) => {
+        if (state.open) {
+          if (state.modal) dialog.showModal();
+          else dialog.show();
+        }
+        dialog.scrollTop = state.scrollTop;
+        message.scrollTop = state.textScrollTop;
+        if (state.focused?.isConnected) {
+          state.focused.focus({ preventScroll: true });
+          if (state.selection) state.focused.setSelectionRange(...state.selection);
+        }
+      };
+
+      const relocate = (dockName) => {
+        const target = docks[dockName];
+        if (!target || target === dialog.parentElement) return;
+
+        let preserved = false;
+        if (supportsMoveBefore) {
+          try {
+            // Atomic move: keeps open/modal/top-layer state, focus and selection.
+            target.moveBefore(dialog, null);
+            preserved = true;
+          } catch {
+            // e.g. HierarchyRequestError in edge cases; fall through.
+          }
+        }
+
+        if (!preserved) {
+          // Removing a modal dialog drops it from the top layer and leaves it in a
+          // non-modal "open" state, so close it first and re-open after insertion.
+          const state = captureState();
+          if (state.open) dialog.close();
+          target.insertBefore(dialog, null);
+          restoreState(state);
+        }
+
+        updateDockUi();
+        saveDraft();
+        status.textContent = `Moved to ${target.dataset.dockLabel}` +
+          (preserved ? '.' : ' (state restored).');
+      };
+
+      const open = (dockName) => {
+        if (dockName) relocate(dockName);
+        if (!dialog.open) dialog.showModal();
+        status.textContent = '';
+        saveDraft();
+      };
+
+      // --- Events ----------------------------------------------------------------
+      document.querySelectorAll('[data-dock-target]').forEach((btn) => {
+        btn.addEventListener('click', () => open(btn.dataset.dockTarget));
+      });
+
+      moveButtons.forEach((btn) => {
+        btn.addEventListener('click', () => relocate(btn.dataset.move));
+      });
+
+      document.getElementById('fb-close').addEventListener('click', () => dialog.close());
+
+      // `close` is dispatched asynchronously, so a fallback close/re-open cycle
+      // arrives here with the dialog already open again; ignore those.
+      dialog.addEventListener('close', () => {
+        if (!dialog.open) saveDraft();
+      });
+
+      form.addEventListener('input', saveDraft);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.elements.rating.value && !message.value.trim()) {
+          status.textContent = 'Add a rating or a comment before sending.';
+          message.focus();
+          return;
+        }
+        form.reset();
+        status.textContent = `Thanks! Your feedback on the ${contextLabel.textContent} was sent.`;
+        saveDraft();
+      });
+
+      // --- Restore persisted draft ----------------------------------------------
+      const draft = loadDraft();
+      (docks[draft.dock] ?? docks.footer).append(dialog);
+      if (draft.message) message.value = draft.message;
+      if (draft.rating) {
+        const radio = form.querySelector(`input[name="rating"][value="${draft.rating}"]`);
+        if (radio) radio.checked = true;
+      }
+      updateDockUi();
+      if (draft.open) dialog.showModal();
+    })();
+  </script>
+
