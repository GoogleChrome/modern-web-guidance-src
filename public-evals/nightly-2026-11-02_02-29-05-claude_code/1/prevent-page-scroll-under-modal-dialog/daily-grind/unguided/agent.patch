@@ -231,9 +231,27 @@
   <script>
     const noticeDialog = document.getElementById("notice-dialog");
     if (noticeDialog) {
-      noticeDialog.show();
-      document.body.classList.add("modal-open");
-      document.body.style.overflow = "hidden";
+      const root = document.documentElement;
+
+      const lockScroll = () => {
+        // Keep layout from shifting when the scrollbar disappears
+        const scrollbarWidth = window.innerWidth - root.clientWidth;
+        root.style.paddingRight = scrollbarWidth ? `${scrollbarWidth}px` : "";
+        root.classList.add("modal-open");
+      };
+
+      const unlockScroll = () => {
+        root.classList.remove("modal-open");
+        root.style.paddingRight = "";
+      };
+
+      // "close" fires for the button, the Escape key, and form method="dialog"
+      noticeDialog.addEventListener("close", unlockScroll);
+      document.getElementById("close-notice")
+        ?.addEventListener("click", () => noticeDialog.close());
+
+      lockScroll();
+      noticeDialog.showModal();
     }
   </script>
 </body>
