+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const card = document.getElementById('export_element');
+      const messageEl = document.getElementById('gc_message');
+      const form = document.getElementById('gift_form');
+      const textInput = document.getElementById('gift_text');
+      const exportBtn = document.getElementById('gift_export');
+      const status = document.getElementById('gift_status');
+      const DEFAULT_MESSAGE = 'Enjoy a cup on me!';
+
+      // HTML-in-Canvas: <canvas layoutsubtree> + ctx.drawElementImage() + the canvas "paint" event.
+      const supportsHtmlInCanvas =
+        'layoutSubtree' in HTMLCanvasElement.prototype &&
+        'drawElementImage' in CanvasRenderingContext2D.prototype &&
+        'requestPaint' in HTMLCanvasElement.prototype;
+
+      const updateCard = () => {
+        messageEl.textContent = textInput.value.trim() || DEFAULT_MESSAGE;
+        const color = form.elements.gift_color.value;
+        card.style.setProperty('--card-bg', color);
+      };
+
+      textInput.addEventListener('input', updateCard);
+      form.addEventListener('change', updateCard);
+
+      const downloadBlob = (blob) => {
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement('a');
+        link.href = url;
+        link.download = 'daily-grind-gift-card.png';
+        document.body.appendChild(link);
+        link.click();
+        link.remove();
+        setTimeout(() => URL.revokeObjectURL(url), 0);
+      };
+
+      const toPngBlob = (target) => new Promise((resolve, reject) => {
+        target.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Canvas export failed')), 'image/png');
+      });
+
+      let renderToCanvas;
+
+      if (supportsHtmlInCanvas) {
+        const ctx = canvas.getContext('2d');
+
+        // Keep the backing store at device-pixel resolution so the export is crisp.
+        const resize = (width, height) => {
+          canvas.width = Math.max(1, Math.round(width));
+          canvas.height = Math.max(1, Math.round(height));
+          canvas.requestPaint();
+        };
+        const observer = new ResizeObserver(([entry]) => {
+          const box = entry.devicePixelContentBoxSize?.[0];
+          if (box) {
+            resize(box.inlineSize, box.blockSize);
+          } else {
+            const dpr = window.devicePixelRatio || 1;
+            resize(entry.contentRect.width * dpr, entry.contentRect.height * dpr);
+          }
+        });
+        try {
+          observer.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch {
+          observer.observe(canvas);
+        }
+
+        // The browser fires "paint" whenever the canvas children's rendering changes,
+        // so typing or picking a color redraws automatically.
+        canvas.addEventListener('paint', () => {
+          ctx.reset();
+          const transform = ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+          // Sync the DOM position with where it was drawn so hit testing / a11y line up.
+          if (transform) card.style.transform = transform.toString();
+        });
+
+        // Wait for a fresh paint so the export reflects the latest DOM state.
+        const nextPaint = () => new Promise((resolve) => {
+          const timer = setTimeout(resolve, 1000);
+          canvas.addEventListener('paint', () => {
+            clearTimeout(timer);
+            resolve();
+          }, { once: true });
+          canvas.requestPaint();
+        });
+
+        renderToCanvas = async () => {
+          await nextPaint();
+          return canvas;
+        };
+      } else {
+        // Fallback: show the card as regular DOM and redraw it with the 2D API on export.
+        const stage = document.createElement('div');
+        stage.className = 'gift-stage';
+        stage.appendChild(card);
+        canvas.replaceWith(stage);
+
+        const wrapLines = (ctx, text, maxWidth) => {
+          const lines = [];
+          let line = '';
+          for (const word of text.split(/\s+/)) {
+            const test = line ? `${line} ${word}` : word;
+            if (line && ctx.measureText(test).width > maxWidth) {
+              lines.push(line);
+              line = word;
+            } else {
+              line = test;
+            }
+          }
+          if (line) lines.push(line);
+          return lines;
+        };
+
+        renderToCanvas = async () => {
+          const rect = card.getBoundingClientRect();
+          const scale = Math.max(2, window.devicePixelRatio || 1);
+          const w = rect.width;
+          const h = rect.height;
+          const out = document.createElement('canvas');
+          out.width = Math.round(w * scale);
+          out.height = Math.round(h * scale);
+          const ctx = out.getContext('2d');
+          ctx.scale(scale, scale);
+
+          const bg = getComputedStyle(card).getPropertyValue('--card-bg').trim();
+          const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
+          const font = getComputedStyle(card).fontFamily;
+          const msgStyle = getComputedStyle(messageEl);
+          const msgSize = parseFloat(msgStyle.fontSize);
+
+          ctx.beginPath();
+          ctx.roundRect(0, 0, w, h, 16);
+          ctx.clip();
+          ctx.fillStyle = bg;
+          ctx.fillRect(0, 0, w, h);
+
+          const sheen = ctx.createLinearGradient(0, 0, w, h);
+          sheen.addColorStop(0, 'rgba(255,255,255,0.12)');
+          sheen.addColorStop(1, 'rgba(0,0,0,0.25)');
+          ctx.fillStyle = sheen;
+          ctx.fillRect(0, 0, w, h);
+
+          ctx.fillStyle = 'rgba(255,171,64,0.35)';
+          ctx.beginPath();
+          ctx.arc(w, 0, Math.hypot(w, h) * 0.22, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.fillStyle = 'rgba(255,255,255,0.18)';
+          ctx.beginPath();
+          ctx.arc(w * 0.85, h * 1.1, Math.hypot(w, h) * 0.28, 0, Math.PI * 2);
+          ctx.fill();
+
+          const padX = 28;
+          const padY = 24;
+          ctx.textBaseline = 'top';
+          ctx.fillStyle = 'white';
+          ctx.font = `bold 15px ${font}`;
+          ctx.letterSpacing = '2px';
+          ctx.fillText('THE DAILY GRIND', padX, padY);
+          ctx.textAlign = 'right';
+          ctx.fillStyle = accent;
+          ctx.font = `600 12px ${font}`;
+          ctx.fillText('GIFT CARD', w - padX, padY + 2);
+
+          ctx.textAlign = 'left';
+          ctx.letterSpacing = '0px';
+          ctx.fillStyle = 'white';
+          ctx.font = `600 ${msgSize}px ${font}`;
+          ctx.shadowColor = 'rgba(0,0,0,0.3)';
+          ctx.shadowBlur = 6;
+          ctx.shadowOffsetY = 2;
+          const lineHeight = msgSize * 1.25;
+          const lines = wrapLines(ctx, messageEl.textContent, w - padX * 2);
+          let y = (h - lines.length * lineHeight) / 2;
+          for (const l of lines) {
+            ctx.fillText(l, padX, y);
+            y += lineHeight;
+          }
+          ctx.shadowColor = 'transparent';
+
+          ctx.globalAlpha = 0.85;
+          ctx.textBaseline = 'bottom';
+          ctx.font = `12px ${font}`;
+          ctx.letterSpacing = '1px';
+          ctx.fillText('Ethically sourced · Locally roasted', padX, h - padY);
+
+          return out;
+        };
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        exportBtn.disabled = true;
+        status.textContent = 'Preparing your card…';
+        try {
+          await document.fonts.ready;
+          const target = await renderToCanvas();
+          downloadBlob(await toPngBlob(target));
+          status.textContent = 'Your gift card has been downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, we couldn’t export your card. Please try again.';
+        } finally {
+          exportBtn.disabled = false;
+        }
+      });
+
+      updateCard();
+    })();
+  </script>
+
 </body>
 
