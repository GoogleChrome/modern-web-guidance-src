+  <script>
+    (() => {
+      const canvas = document.getElementById('gift-canvas');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('gift-form');
+      const customColor = document.getElementById('gift-custom-color');
+      const exportBtn = document.getElementById('gift-export');
+      const status = document.getElementById('gift-status');
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      // Pick readable text for whatever background the user chooses.
+      function textColorFor(hex) {
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
+        const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        return luminance > 0.55 ? '#3e2723' : '#fafafa';
+      }
+
+      function setCardColor(hex) {
+        card.style.setProperty('--card-bg', hex);
+        card.style.setProperty('--card-fg', textColorFor(hex));
+      }
+
+      form.addEventListener('input', (event) => {
+        const { target } = event;
+        if (target.id === 'gift-name') {
+          document.getElementById('card-name').textContent = target.value.trim() || 'Coffee Lover';
+        } else if (target.id === 'gift-message') {
+          document.getElementById('card-message').textContent = target.value.trim();
+        } else if (target.name === 'color') {
+          setCardColor(target.value);
+        } else if (target === customColor) {
+          form.querySelectorAll('input[name="color"]').forEach((radio) => (radio.checked = false));
+          setCardColor(customColor.value);
+        }
+      });
+
+      if (!supportsHtmlInCanvas) {
+        // Canvas children are fallback content and never painted, so show the
+        // live card as regular DOM and explain why export is unavailable.
+        canvas.replaceWith(card);
+        exportBtn.disabled = true;
+        status.textContent =
+          'Downloading requires a browser with HTML-in-Canvas support (Chrome 157+). You can still preview your design here.';
+        return;
+      }
+
+      const ctx = canvas.getContext('2d');
+
+      // Paint the live HTML card into the canvas whenever the browser has a
+      // fresh snapshot (initial render, edits, or resize).
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(card, 0, 0);
+      };
+
+      // Keep the canvas backing store at device pixel resolution for a crisp export.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      exportBtn.addEventListener('click', () => {
+        canvas.toBlob((blob) => {
+          if (!blob) {
+            status.textContent = 'Sorry, the card could not be exported. Please try again.';
+            return;
+          }
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url));
+          status.textContent = 'Your gift card has been downloaded.';
+        }, 'image/png');
+      });
+    })();
+  </script>
+
