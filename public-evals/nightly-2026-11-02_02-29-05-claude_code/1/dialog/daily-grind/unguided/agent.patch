+  <script>
+    (function () {
+      var dialog = document.getElementById('drink-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') return; // Fall back to normal links.
+
+      var DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          alt: 'A latte with leaf-shaped foam art in a ceramic cup',
+          caffeine: '130 mg',
+          notes: 'Maple, toasted oat, caramel',
+          milk: true,
+          defaultMilk: 'oat',
+          sizes: { Small: 4.75, Medium: 5.25, Large: 5.75 },
+          href: '/menu/seasonal'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost. Pulled from our single-origin Sumatra dark roast.',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          alt: 'A shot of espresso with rich crema in a small cup',
+          caffeine: '75 mg per shot',
+          notes: 'Dark chocolate, smoke, molasses',
+          milk: false,
+          sizes: { Single: 2.75, Double: 3.50 },
+          href: '/menu/espresso'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness, served over ice. Add a splash of milk if you like.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=80',
+          alt: 'Iced coffee in a tall glass',
+          caffeine: '200 mg',
+          notes: 'Cocoa, cherry, low acidity',
+          milk: true,
+          defaultMilk: 'none',
+          sizes: { Medium: 4.50, Large: 5.25 },
+          href: '/menu/cold-brew'
+        }
+      };
+
+      var form = document.getElementById('order-form');
+      var title = document.getElementById('drink-dialog-title');
+      var sizeOptions = document.getElementById('size-options');
+      var milkField = document.getElementById('milk-field');
+      var milk = document.getElementById('milk');
+      var quantity = document.getElementById('quantity');
+      var total = document.getElementById('order-total');
+      var opener = null;
+
+      function money(n) {
+        return '$' + n.toFixed(2);
+      }
+
+      function currentDrink() {
+        return DRINKS[form.elements.drink.value];
+      }
+
+      function updateTotal() {
+        var drink = currentDrink();
+        var size = form.querySelector('input[name="size"]:checked');
+        var qty = Math.min(10, Math.max(1, parseInt(quantity.value, 10) || 1));
+        total.textContent = money(drink.sizes[size.value] * qty);
+      }
+
+      function showDrink(id, heading) {
+        var drink = DRINKS[id];
+        form.querySelector('input[name="drink"][value="' + id + '"]').checked = true;
+        title.textContent = heading || drink.name;
+
+        var img = document.getElementById('drink-image');
+        img.src = drink.image;
+        img.alt = drink.alt;
+        document.getElementById('drink-description').textContent = drink.description;
+        document.getElementById('drink-caffeine').textContent = drink.caffeine;
+        document.getElementById('drink-notes').textContent = drink.notes;
+        document.getElementById('drink-menu-link').href = drink.href;
+
+        var sizes = Object.keys(drink.sizes);
+        document.getElementById('drink-price').textContent = money(drink.sizes[sizes[0]]);
+        sizeOptions.innerHTML = '';
+        sizes.forEach(function (size, i) {
+          var label = document.createElement('label');
+          var input = document.createElement('input');
+          input.type = 'radio';
+          input.name = 'size';
+          input.value = size;
+          input.checked = i === 0;
+          label.appendChild(input);
+          label.appendChild(document.createTextNode(' ' + size + ' (' + money(drink.sizes[size]) + ')'));
+          sizeOptions.appendChild(label);
+        });
+
+        milkField.hidden = !drink.milk;
+        milk.disabled = !drink.milk; // Disabled fields aren't submitted.
+        if (drink.milk) milk.value = drink.defaultMilk;
+
+        updateTotal();
+      }
+
+      function openDialog(trigger) {
+        opener = trigger;
+        var id = trigger.getAttribute('data-drink');
+        form.reset();
+        showDrink(id || 'maple-oat-latte', id ? null : 'Start Your Order');
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+        // Move focus to the title so screen readers start at the top of the content.
+        title.focus();
+      }
+
+      dialog.addEventListener('close', function () {
+        document.body.classList.remove('dialog-open');
+        if (opener && document.contains(opener)) opener.focus();
+        opener = null;
+      });
+
+      // Light dismiss for browsers without closedby="any": a tap on the backdrop.
+      // Require press and release both on the backdrop so text selection drags don't close it.
+      var pressedBackdrop = false;
+      dialog.addEventListener('pointerdown', function (e) {
+        pressedBackdrop = e.target === dialog && isOutside(e);
+      });
+      dialog.addEventListener('click', function (e) {
+        if (pressedBackdrop && e.target === dialog && isOutside(e)) dialog.close();
+        pressedBackdrop = false;
+      });
+      function isOutside(e) {
+        var r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      }
+
+      dialog.querySelectorAll('[data-close-dialog]').forEach(function (btn) {
+        btn.addEventListener('click', function () { dialog.close(); });
+      });
+
+      form.addEventListener('change', function (e) {
+        if (e.target.name === 'drink') {
+          showDrink(e.target.value);
+        } else {
+          updateTotal();
+        }
+      });
+      quantity.addEventListener('input', updateTotal);
+
+      // Upgrade the links into buttons that open the dialog. Without JS (or <dialog>
+      // support) they remain plain links to their original pages.
+      document.querySelectorAll('a[data-order-dialog]').forEach(function (link) {
+        var btn = document.createElement('button');
+        btn.type = 'button';
+        btn.className = link.className;
+        btn.textContent = link.textContent;
+        btn.setAttribute('aria-haspopup', 'dialog');
+        if (link.hasAttribute('data-drink')) {
+          btn.setAttribute('data-drink', link.getAttribute('data-drink'));
+          btn.setAttribute('aria-label', link.textContent + ': ' + DRINKS[link.getAttribute('data-drink')].name);
+        }
+        btn.addEventListener('click', function () { openDialog(btn); });
+        link.replaceWith(btn);
+      });
+    })();
+  </script>
+
 </body>
 
