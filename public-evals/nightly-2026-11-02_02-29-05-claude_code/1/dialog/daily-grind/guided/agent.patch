+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1120&q=80',
+        alt: 'A latte with leaf-shaped foam art in a ceramic cup',
+        caffeine: '150 mg',
+        calories: '190',
+        served: 'Hot',
+        milk: 'Oat',
+        prices: { small: 4.5, medium: 5.25, large: 6 },
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1120&q=80',
+        alt: 'A shot of espresso with golden crema in a small cup',
+        caffeine: '125 mg',
+        calories: '5',
+        served: 'Hot',
+        milk: 'None',
+        prices: { small: 3, medium: 3.75, large: 4.5 },
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1120&q=80',
+        alt: 'Iced coffee in a tall glass',
+        caffeine: '200 mg',
+        calories: '15',
+        served: 'Over ice',
+        milk: 'None',
+        prices: { small: 4, medium: 4.75, large: 5.5 },
+      },
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-form');
+    const drinkSelect = document.getElementById('order-drink');
+    const status = document.getElementById('order-status');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function updateTotal() {
+      const drink = drinks[drinkSelect.value];
+      const size = form.elements.size.value;
+      const qty = Math.max(1, Number(form.elements.quantity.value) || 1);
+      document.getElementById('order-total').value = currency.format(drink.prices[size] * qty);
+    }
+
+    function showDrink(id) {
+      const drink = drinks[id];
+      drinkSelect.value = id;
+      document.getElementById('drink-dialog-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      document.getElementById('drink-caffeine').textContent = drink.caffeine;
+      document.getElementById('drink-calories').textContent = drink.calories;
+      document.getElementById('drink-served').textContent = drink.served;
+      const photo = document.getElementById('drink-photo');
+      photo.src = drink.image;
+      photo.alt = drink.alt;
+      form.elements.milk.value = drink.milk;
+      updateTotal();
+    }
+
+    // Fill in the dialog for whichever button opened it; "Order Now" has no drink and keeps the current one
+    dialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      const id = event.source?.dataset.drink ?? drinkSelect.value;
+      form.reset();
+      showDrink(id);
+    });
+
+    drinkSelect.addEventListener('change', () => showDrink(drinkSelect.value));
+    form.addEventListener('input', (event) => {
+      if (event.target !== drinkSelect) updateTotal();
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'order') {
+        const data = new FormData(form);
+        status.textContent = `Added ${data.get('quantity')} × ${data.get('size')} ${drinks[data.get('drink')].name} to your order.`;
+      }
+      dialog.returnValue = '';
+    });
+
+    // Light dismiss where closedby isn't supported (Esc and back gestures already work natively)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      // Test the pointer position, not event.target: the dialog is also the target for its own padding
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+  </script>
+
