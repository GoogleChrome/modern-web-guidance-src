+  <script type="module">
+    // A batch of order events as received from distributed backend services:
+    // out of order, with nanosecond-precision UTC timestamps. Several fall within
+    // the same millisecond, so Date-based parsing would collide and misorder them.
+    const ORDER_EVENT_BATCH = [
+      { service: 'pickup-svc', orderId: 'DG-1042', type: 'order.ready', ts: '2026-11-02T14:03:27.918204117Z' },
+      { service: 'payment-svc', orderId: 'DG-1042', type: 'payment.authorized', ts: '2026-11-02T14:03:05.412000981Z' },
+      { service: 'order-api', orderId: 'DG-1042', type: 'order.created', ts: '2026-11-02T14:03:05.411873002Z' },
+      { service: 'kitchen-svc', orderId: 'DG-1042', type: 'barista.assigned', ts: '2026-11-02T14:03:05.412000500Z' },
+      { service: 'payment-svc', orderId: 'DG-1043', type: 'payment.authorized', ts: '2026-11-02T14:03:05.412000981Z' },
+      { service: 'kitchen-svc', orderId: 'DG-1042', type: 'espresso.pulled', ts: '2026-11-02T14:03:19.007450333Z' },
+      { service: 'order-api', orderId: 'DG-1043', type: 'order.created', ts: '2026-11-02T14:03:05.411873450Z' },
+      { service: 'kitchen-svc', orderId: 'DG-1042', type: 'milk.steamed', ts: '2026-11-02T14:03:19.007450334Z' },
+      { service: 'notify-svc', orderId: 'DG-1042', type: 'customer.notified', ts: '2026-11-02T14:03:27.918977640Z' },
+      { service: 'kitchen-svc', orderId: 'DG-1043', type: 'barista.assigned', ts: '2026-11-02T14:03:05.412999999Z' },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+      }
+    }
+
+    // Simulates fetching the batch from the event collector.
+    async function loadOrderEvents() {
+      await ensureTemporal();
+      return ORDER_EVENT_BATCH.map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }));
+    }
+
+    function sequenceEvents(events) {
+      return [...events].sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+    }
+
+    function formatInterval(duration) {
+      if (duration.blank) return 'same instant';
+      try {
+        return duration.toLocaleString('en-US', { style: 'narrow' });
+      } catch {
+        return duration.toString();
+      }
+    }
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('events-status');
+    const output = document.getElementById('events-output');
+    const tbody = document.getElementById('events-body');
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Loading order events…';
+      try {
+        const sorted = sequenceEvents(await loadOrderEvents());
+        tbody.replaceChildren(...sorted.map((evt, i) => {
+          const prev = sorted[i - 1];
+          const row = document.createElement('tr');
+          if (prev && evt.instant.equals(prev.instant)) row.className = 'tie';
+          const cells = [
+            String(i + 1),
+            evt.instant.toString({ fractionalSecondDigits: 9 }),
+            evt.service,
+            evt.orderId,
+            evt.type,
+            prev ? formatInterval(evt.instant.since(prev.instant)) : '—',
+          ];
+          cells.forEach((text, col) => {
+            const td = document.createElement('td');
+            if (col === 1) td.className = 'ts';
+            td.textContent = text;
+            row.append(td);
+          });
+          return row;
+        }));
+        const total = sorted.at(-1).instant.since(sorted[0].instant);
+        status.textContent = `Sorted ${sorted.length} events spanning ${formatInterval(total)}.`;
+        output.hidden = false;
+      } catch (err) {
+        status.textContent = `Couldn't load order events: ${err.message}`;
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
