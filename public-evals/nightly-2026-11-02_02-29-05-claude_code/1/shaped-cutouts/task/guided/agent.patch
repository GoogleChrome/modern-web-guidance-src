+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+      text-align: center;
+    }
+
+    .shaped-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+      gap: 40px;
+      align-items: center;
+      margin-top: 20px;
+    }
+
+    .barista-feature h3 {
+      margin-top: 10px;
+      color: var(--primary);
+    }
+
+    .shaped-avatar {
+      width: 240px;
+      aspect-ratio: 1;
+      object-fit: cover;
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .unified-card {
+      display: flex;
+      text-align: left;
+      /* drop-shadow follows the masked outline, unlike box-shadow */
+      filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.25));
+    }
+
+    .card-body {
+      flex: 1;
+      background: var(--primary);
+      color: white;
+      padding: 24px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .card-accent {
+      width: 60px;
+      background: var(--primary);
+      border-radius: 0 16px 16px 0;
+      -webkit-mask-image: url(#accent-mask);
+      mask-image: url(#accent-mask);
+    }
+
+    .gradient-masked-card {
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: white;
+      padding: 48px 24px 24px;
+      border-radius: 16px;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+    }
+
+    .gradient-masked-card .btn {
+      background: white;
+      color: var(--primary);
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
