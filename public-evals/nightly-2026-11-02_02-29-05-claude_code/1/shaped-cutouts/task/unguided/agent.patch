+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section h2 {
+      text-align: center;
+    }
+
+    .shaped-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+      gap: 40px;
+      align-items: center;
+      margin-top: 30px;
+    }
+
+    .barista-feature {
+      text-align: center;
+    }
+
+    .barista-feature figcaption h3 {
+      color: var(--primary);
+      margin-top: 10px;
+    }
+
+    /* Clip path uses objectBoundingBox units, so the splat scales with the image */
+    .shaped-avatar {
+      display: block;
+      width: min(320px, 100%);
+      aspect-ratio: 4 / 5;
+      height: auto;
+      margin: 0 auto;
+      object-fit: cover;
+      -webkit-clip-path: url(#paint-splat);
+      clip-path: url(#paint-splat);
+    }
+
+    /* drop-shadow follows the combined (masked) silhouette of both children */
+    .unified-card {
+      display: flex;
+      filter: drop-shadow(0 10px 18px rgba(62, 39, 35, 0.25));
+    }
+
+    .unified-card .card-body {
+      flex: 1;
+      background: white;
+      padding: 24px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .unified-card .card-body h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .unified-card .card-accent {
+      flex: 0 0 120px;
+      background: linear-gradient(160deg, var(--accent), var(--primary));
+      border-radius: 0 16px 16px 0;
+      -webkit-mask: radial-gradient(56px 80px at 100% 50%, transparent 98%, #000 100%);
+      mask: radial-gradient(56px 80px at 100% 50%, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card {
+      background: var(--primary);
+      color: white;
+      text-align: center;
+      padding: 60px 24px 28px;
+      border-radius: 16px;
+      -webkit-mask: radial-gradient(circle 28px at 50% 0, transparent 98%, #000 100%);
+      mask: radial-gradient(circle 28px at 50% 0, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .gradient-masked-card .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
     .footer-links {
       margin-bottom: 20px;
     }
 
