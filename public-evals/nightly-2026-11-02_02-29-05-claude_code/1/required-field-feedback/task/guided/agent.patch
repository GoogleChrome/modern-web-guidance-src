+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state so screen
+    // readers only hear the error after the user has interacted with the field.
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+
+    const syncAriaInvalid = () => {
+      if (newsletterEmail.matches(':user-invalid')) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    newsletterEmail.addEventListener('blur', syncAriaInvalid);
+    newsletterEmail.addEventListener('input', () => {
+      if (newsletterEmail.hasAttribute('aria-invalid')) syncAriaInvalid();
+    });
+    // Submitting with an empty field flips it to :user-invalid; the browser fires
+    // "invalid" before focusing it, so sync once the state has settled.
+    newsletterEmail.addEventListener('invalid', () => requestAnimationFrame(syncAriaInvalid));
+  </script>
+
