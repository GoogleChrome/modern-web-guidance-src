@@ -0,0 +1,84 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <!-- Theme first, so the stored/system theme is applied before any paint or view-transition snapshot. -->
+  <script>
+    (function () {
+      var stored = null;
+      try { stored = localStorage.getItem('theme'); } catch (e) {}
+      var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+      document.documentElement.dataset.theme = theme;
+      document.addEventListener('click', function (e) {
+        if (!e.target.closest('.theme-toggle')) return;
+        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
+        document.documentElement.dataset.theme = next;
+        try { localStorage.setItem('theme', next); } catch (e) {}
+      });
+    })();
+  </script>
+  <!-- Critical styles (incl. @view-transition opt-in) are render-blocking. -->
+  <link rel="stylesheet" href="/css/site.css">
+  <!-- Hold first render (and the incoming view transition) until the hero and
+       main content are fully parsed; the footer is not waited on. -->
+  <link rel="expect" href="#above-the-fold" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" aria-label="Toggle dark mode">Theme</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--page hero--locations">
+    <h1>Find Your Grind</h1>
+    <p>Neighborhood cafés with fresh roasts and free Wi-Fi.</p>
+  </header>
+
+  <main id="above-the-fold" class="container page-content">
+    <section>
+      <h2 style="text-align: center;">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>120 Main Street<br>Mon&ndash;Fri 6am&ndash;8pm &middot; Sat&ndash;Sun 7am&ndash;6pm</p>
+          <a href="/locations/downtown" class="btn">Get Directions</a>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>48 Water Lane<br>Daily 7am&ndash;7pm</p>
+          <a href="/locations/riverside" class="btn">Get Directions</a>
+        </div>
+        <div class="card">
+          <h3>University District</h3>
+          <p>9 College Avenue<br>Daily 6:30am&ndash;10pm</p>
+          <a href="/locations/university" class="btn">Get Directions</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
