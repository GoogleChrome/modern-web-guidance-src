+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+  <!-- Theme first, so the stored/system theme is applied before any paint or view-transition snapshot. -->
+  <script>
+    (function () {
+      var stored = null;
+      try { stored = localStorage.getItem('theme'); } catch (e) {}
+      var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+      document.documentElement.dataset.theme = theme;
+      document.addEventListener('click', function (e) {
+        if (!e.target.closest('.theme-toggle')) return;
+        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
+        document.documentElement.dataset.theme = next;
+        try { localStorage.setItem('theme', next); } catch (e) {}
+      });
+    })();
+  </script>
+  <!-- Critical styles (incl. @view-transition opt-in) are render-blocking. -->
+  <link rel="stylesheet" href="/css/site.css">
+  <!-- Hold first render (and the incoming view transition) until the hero and
+       main content are fully parsed; the footer is not waited on. -->
+  <link rel="expect" href="#above-the-fold" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu" aria-current="page">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" aria-label="Toggle dark mode">Theme</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--page hero--menu">
+    <h1>Our Menu</h1>
+    <p>Espresso, brewed, and seasonal drinks, roasted in-house every week.</p>
+  </header>
+
+  <main id="above-the-fold" class="container page-content">
+    <section>
+      <h2 style="text-align: center;">Espresso &amp; Brewed</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <span class="price">$5.75</span>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <span class="price">$3.25</span>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <span class="price">$4.50</span>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>House Pour-Over</h3>
+          <p>Single-origin beans, brewed to order.</p>
+          <span class="price">$4.00</span>
+          <a href="/menu/pour-over" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
