diff --git a/js/theme.js b/js/theme.js
new file mode 100644
index 0000000..e5be013
--- /dev/null
+++ b/js/theme.js
@@ -0,0 +1,34 @@
+// Loaded with `blocking="render"` so the theme is applied before first paint
+// and before the incoming page of a view transition is snapshotted.
+(() => {
+  const root = document.documentElement;
+
+  let stored = null;
+  try {
+    stored = localStorage.getItem('theme');
+  } catch {}
+
+  root.dataset.theme =
+    stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+
+  const syncToggles = () => {
+    for (const toggle of document.querySelectorAll('[data-theme-toggle]')) {
+      toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
+    }
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', syncToggles);
+  } else {
+    syncToggles();
+  }
+
+  document.addEventListener('click', (event) => {
+    if (!event.target.closest('[data-theme-toggle]')) return;
+    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    try {
+      localStorage.setItem('theme', root.dataset.theme);
+    } catch {}
+    syncToggles();
+  });
+})();
diff --git a/locations/index.html b/locations/index.html
new file mode 100644
index 0000000..41469d4
--- /dev/null
+++ b/locations/index.html
@@ -0,0 +1,87 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Critical styles: a <head> stylesheet is render-blocking by default -->
+  <link rel="stylesheet" href="/css/styles.css">
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+
+  <!-- Apply the saved theme before the first paint / view transition snapshot -->
+  <script async blocking="render" src="/js/theme.js"></script>
+
+  <!-- Hold rendering until the above-the-fold content is parsed (the footer is not waited on) -->
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#store-list" blocking="render">
+
+  <!-- Prerender likely destinations so transitions start from a fully loaded page -->
+  <script type="speculationrules">
+    {
+      "prerender": [
+        {
+          "where": { "href_matches": ["/", "/menu", "/menu/", "/locations", "/locations/"] },
+          "eagerness": "moderate"
+        }
+      ]
+    }
+  </script>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">Dark mode</button></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--compact hero--locations" id="hero">
+    <h1>Find Your Daily Grind</h1>
+    <p>Neighborhood cafés with the same locally roasted coffee.</p>
+  </header>
+
+  <main class="container">
+    <section id="store-list">
+      <h2 class="section-title">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>128 Main Street</p>
+          <p class="price">Mon–Sun · 6am–8pm</p>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>42 Harbor Walk</p>
+          <p class="price">Mon–Sat · 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>University District</h3>
+          <p>900 College Avenue</p>
+          <p class="price">Mon–Fri · 6:30am–10pm</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
