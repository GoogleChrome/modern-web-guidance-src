+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+
+  <!-- Critical styles: a <head> stylesheet is render-blocking by default -->
+  <link rel="stylesheet" href="/css/styles.css">
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+
+  <!-- Apply the saved theme before the first paint / view transition snapshot -->
+  <script async blocking="render" src="/js/theme.js"></script>
+
+  <!-- Hold rendering until the above-the-fold content is parsed (the footer is not waited on) -->
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#menu-items" blocking="render">
+
+  <!-- Prerender likely destinations so transitions start from a fully loaded page -->
+  <script type="speculationrules">
+    {
+      "prerender": [
+        {
+          "where": { "href_matches": ["/", "/menu", "/menu/", "/locations", "/locations/"] },
+          "eagerness": "moderate"
+        }
+      ]
+    }
+  </script>
+</head>
+
