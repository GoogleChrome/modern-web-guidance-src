+
+      // ---- 3. Conversation Branching (clone + context tracking + cleanup) ----
+
+      const MAX_BRANCHES = 4;
+
+      const branching = {
+        sendBtn: $('branch-send'),
+        cloneBtn: $('clone-btn'),
+        input: $('branch-input'),
+        output: $('branch-output'),
+        status: $('branch-status'),
+        progress: $('branch-progress'),
+        list: $('branch-list'),
+        branches: [], // { id, name, session, lastUsed, transcript }
+        activeId: null,
+        nextId: 1,
+        controller: null,
+      };
+
+      const activeBranch = () => branching.branches.find((b) => b.id === branching.activeId) ?? null;
+
+      function addBranch(session, name, transcript = '') {
+        const branch = { id: branching.nextId++, name, session, lastUsed: Date.now(), transcript };
+        session.addEventListener?.('contextoverflow', () => onOverflow(branch));
+        session.addEventListener?.('quotaoverflow', () => onOverflow(branch));
+        branching.branches.push(branch);
+        branching.activeId = branch.id;
+        pruneBranches();
