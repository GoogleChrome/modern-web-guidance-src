+
+      const MENU_CONTEXT = `You are a friendly barista at The Daily Grind coffee shop.
+Only answer questions about these two drinks:
+- Maple Oat Latte: espresso with creamy oat milk and a hint of real Vermont maple syrup. Dairy-free by default. Served hot or iced.
+- Cold Brew: coffee steeped for 18 hours for maximum smoothness, low acidity, naturally sweet, higher caffeine than drip. Served over ice; can add oat milk or maple syrup.
+If asked about anything else, politely steer the guest back to these two drinks. Keep answers short (2-4 sentences).`;
+
+      const $ = (id) => document.getElementById(id);
+
+      // Every live session is tracked here so it can be destroyed on page exit.
+      const liveSessions = new Set();
+
+      function track(session) {
+        liveSessions.add(session);
+        return session;
+      }
+
+      function destroySession(session) {
+        if (!session) return;
+        liveSessions.delete(session);
+        try { session.destroy(); } catch { /* already destroyed */ }
+      }
+
+      // Spec renamed inputUsage/inputQuota -> contextUsage/contextWindow; support both.
+      function usageOf(session) {
+        const used = session.contextUsage ?? session.inputUsage ?? 0;
+        const total = session.contextWindow ?? session.inputQuota ?? 0;
+        return { used, total };
+      }
+
+      async function checkAvailability(statusEl) {
+        if (!('LanguageModel' in self)) {
+          statusEl.textContent = 'Built-in AI is not supported in this browser. Try a recent version of Chrome on desktop.';
+          return 'unavailable';
+        }
+        const availability = await LanguageModel.availability(LANG_OPTIONS);
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'The on-device model is unavailable on this device.';
+        }
+        return availability;
+      }
+
+      // Creates a session, surfacing model download progress if a download is needed.
+      // Must be called from a user gesture when the model is "downloadable".
+      async function createSession({ statusEl, progressEl, signal, initialPrompts }) {
+        const availability = await checkAvailability(statusEl);
+        if (availability === 'unavailable') return null;
+
+        if (availability !== 'available') {
+          statusEl.textContent = 'Downloading the on-device model…';
+          progressEl.hidden = false;
+          progressEl.removeAttribute('value'); // indeterminate until first event
+        }
+
+        try {
+          const session = await LanguageModel.create({
+            ...LANG_OPTIONS,
+            initialPrompts,
+            signal,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                progressEl.hidden = false;
+                progressEl.value = e.loaded;
+                statusEl.textContent = e.loaded >= 1
+                  ? 'Download complete, preparing model…'
+                  : `Downloading the on-device model… ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+          return track(session);
+        } finally {
+          progressEl.hidden = true;
+        }
+      }
+
+      function describeError(err) {
+        if (err?.name === 'AbortError') return 'Request cancelled.';
+        if (err?.name === 'NotAllowedError') return 'Please click the button again to allow the model to start.';
+        if (err?.name === 'QuotaExceededError') return 'That input is too long for the on-device model.';
+        if (err?.name === 'NotSupportedError') return 'This request is not supported by the on-device model.';
+        return `Something went wrong: ${err?.message ?? err}`;
+      }
+
+      // ---- 1. Ask the Barista (streaming) ----
+
+      const barista = {
+        btn: $('ask-the-barista'),
+        stopBtn: $('barista-stop'),
+        input: $('barista-question'),
+        output: $('barista-answer'),
+        status: $('barista-status'),
+        progress: $('barista-progress'),
+        // A pristine session holding only the system prompt; each question runs in a clone
+        // so answers stay independent and context never grows unbounded.
+        baseSession: null,
+        controller: null,
+      };
+
+      barista.btn.addEventListener('click', async () => {
+        const question = barista.input.value.trim();
+        if (!question) {
+          barista.status.textContent = 'Please type a question first.';
+          return;
+        }
+
+        barista.controller?.abort();
+        const controller = new AbortController();
+        barista.controller = controller;
+        const { signal } = controller;
+
+        barista.btn.disabled = true;
+        barista.stopBtn.hidden = false;
+        barista.output.textContent = '';
+        let turn = null;
+
+        try {
+          if (!barista.baseSession) {
+            barista.status.textContent = 'Checking on-device model availability…';
+            barista.baseSession = await createSession({
+              statusEl: barista.status,
+              progressEl: barista.progress,
+              signal,
+              initialPrompts: [{ role: 'system', content: MENU_CONTEXT }],
+            });
+            if (!barista.baseSession) return;
