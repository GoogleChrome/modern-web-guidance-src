+          const { used, total } = usageOf(branch.session);
+          const li = document.createElement('li');
+          li.classList.toggle('active', branch.id === branching.activeId);
+
+          const label = document.createElement('span');
+          label.textContent = `${branch.name}${branch.id === branching.activeId ? ' (active)' : ''}`;
+
+          const meter = document.createElement('meter');
+          meter.min = 0;
+          meter.max = total || 1;
+          meter.value = used;
+          meter.high = (total || 1) * 0.8;
+          meter.title = `${used} / ${total} tokens`;
+
+          const usage = document.createElement('small');
+          usage.textContent = total ? `${used} / ${total} tokens` : `${used} tokens`;
+
+          const switchBtn = document.createElement('button');
+          switchBtn.type = 'button';
+          switchBtn.className = 'btn secondary';
+          switchBtn.textContent = 'Switch';
+          switchBtn.disabled = branch.id === branching.activeId;
+          switchBtn.addEventListener('click', () => {
+            branching.activeId = branch.id;
+            branch.lastUsed = Date.now();
+            branching.output.textContent = branch.transcript;
