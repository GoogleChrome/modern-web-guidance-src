+      }
+
+      function onOverflow(branch) {
+        branching.status.textContent = `"${branch.name}" ran out of context; the oldest messages were dropped.`;
+      }
+
+      function removeBranch(id) {
+        const idx = branching.branches.findIndex((b) => b.id === id);
+        if (idx === -1) return;
+        const [branch] = branching.branches.splice(idx, 1);
