+
+      const sentiment = {
+        btn: $('sentiment-btn'),
+        input: $('feedback-input'),
+        output: $('sentiment-result'),
+        status: $('sentiment-status'),
+        progress: $('sentiment-progress'),
+        baseSession: null,
+        controller: null,
+      };
+
+      sentiment.btn.addEventListener('click', async () => {
+        const feedback = sentiment.input.value.trim();
+        if (!feedback) {
+          sentiment.status.textContent = 'Please paste some customer feedback first.';
+          return;
+        }
+
+        sentiment.controller?.abort();
+        const controller = new AbortController();
+        sentiment.controller = controller;
+        const { signal } = controller;
+
+        sentiment.btn.disabled = true;
+        sentiment.output.textContent = '';
