       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-down Search */
+    .search-bar {
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 10px;
+      max-width: 600px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      padding: 8px 12px;
