+      border-radius: 4px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .search-bar button:hover {
+      background: #3e2723;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
