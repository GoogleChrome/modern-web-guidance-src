diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13,8 +13,14 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    html {
+      /* Snap the search bar / nav into place near the top of the page;
+         proximity leaves the rest of the page free-scrolling. */
+      scroll-snap-type: y proximity;
+    }
