+  <script>
+    (() => {
+      const stage = document.getElementById('cup-stage');
+      const canvas = document.getElementById('canvas');
+      const form = document.getElementById('order-card');
+      const nameInput = document.getElementById('order-name');
+      const cupLabel = document.getElementById('cup-label');
+      const status = document.getElementById('order-status');
+      const ctx = canvas.getContext('2d');
+
+      // HTML-in-Canvas: <canvas layoutsubtree> lays out its children (keeping them
+      // accessible, find-in-page searchable and translatable) and drawElementImage()
+      // paints them into the bitmap.
+      const supportsHTMLInCanvas = typeof ctx.drawElementImage === 'function';
+
+      if (!supportsHTMLInCanvas) {
+        // Without support, canvas children are invisible fallback content, so move
+        // the form out and overlay it at the same coordinates we would draw it at.
+        canvas.removeAttribute('layoutsubtree');
+        stage.classList.add('no-html-canvas');
+        stage.appendChild(form);
+      }
+
+      const MILK = { none: '#3b2314', whole: '#8d5b3c', oat: '#9c6b45', almond: '#94643f' };
+      const SYRUP = { none: null, vanilla: '#f3e1a8', caramel: '#c27c2c', maple: '#a8552a' };
+
+      let geom = null;
+
+      // Compute cup geometry (CSS pixels) around the form's laid-out size.
+      function layout() {
+        const W = canvas.clientWidth;
+        if (!W) return;
+        const cx = W * 0.46;
+        const cupW = Math.min(W * 0.78, 440);
+        const rimRy = 18;
+        const rimY = 30;
+        const formW = Math.round(cupW * 0.86 - 32);
+        if (form.style.width !== formW + 'px') form.style.width = formW + 'px';
+
+        const formH = form.offsetHeight;
+        const formX = Math.round(cx - formW / 2);
+        const formY = Math.round(rimY + rimRy + 22);
+        const bodyBottom = formY + formH + 30;
+        const H = Math.ceil(bodyBottom + 46);
+        if (canvas.style.height !== H + 'px') canvas.style.height = H + 'px';
+
+        geom = { W, H, cx, cupW, rimY, rimRy, formX, formY, formW, formH, bodyBottom };
+      }
+
+      function drawCup(g) {
+        const { cx, cupW, rimY, rimRy, bodyBottom } = g;
+        const topHalf = cupW / 2;
+        const botHalf = topHalf * 0.86;
+        const bodyH = bodyBottom - rimY;
+
+        // Saucer
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.15)';
+        ctx.beginPath();
+        ctx.ellipse(cx, bodyBottom + 14, topHalf * 1.25, 22, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#efe6dc';
+        ctx.beginPath();
+        ctx.ellipse(cx, bodyBottom + 8, topHalf * 1.2, 20, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Handle
+        ctx.strokeStyle = '#e8ddd2';
+        ctx.lineWidth = Math.max(14, cupW * 0.05);
+        ctx.lineCap = 'round';
+        ctx.beginPath();
+        const hx = cx + topHalf * 0.93;
+        const hTop = rimY + bodyH * 0.18;
+        const hBot = rimY + bodyH * 0.62;
+        ctx.moveTo(hx, hTop);
+        ctx.bezierCurveTo(hx + cupW * 0.32, hTop, hx + cupW * 0.28, hBot, hx - 6, hBot);
+        ctx.stroke();
+
+        // Body
+        const grad = ctx.createLinearGradient(cx - topHalf, 0, cx + topHalf, 0);
+        grad.addColorStop(0, '#d9cbbd');
+        grad.addColorStop(0.35, '#fffaf4');
+        grad.addColorStop(1, '#cdbcab');
+        ctx.fillStyle = grad;
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalf, rimY);
+        ctx.lineTo(cx - botHalf, bodyBottom - 20);
+        ctx.quadraticCurveTo(cx - botHalf, bodyBottom, cx - botHalf + 20, bodyBottom);
+        ctx.lineTo(cx + botHalf - 20, bodyBottom);
+        ctx.quadraticCurveTo(cx + botHalf, bodyBottom, cx + botHalf, bodyBottom - 20);
+        ctx.lineTo(cx + topHalf, rimY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Rim and coffee surface, tinted by the current selection
+        ctx.fillStyle = '#fffaf4';
+        ctx.beginPath();
+        ctx.ellipse(cx, rimY, topHalf, rimRy, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+
+        const data = new FormData(form);
+        ctx.fillStyle = MILK[data.get('milk')] || MILK.whole;
+        ctx.beginPath();
+        ctx.ellipse(cx, rimY + 2, topHalf - 10, rimRy - 6, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        const syrup = SYRUP[data.get('syrup')];
+        if (syrup) {
+          ctx.strokeStyle = syrup;
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(cx, rimY + 2, (topHalf - 10) * 0.55, (rimRy - 6) * 0.5, 0, 0, Math.PI * 1.6);
+          ctx.stroke();
+        }
+      }
+
+      function draw() {
+        if (!geom) return;
+        // Map CSS pixels onto the device-pixel backing store for crisp output.
+        const sx = canvas.width / geom.W;
+        const sy = canvas.height / geom.H;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(sx, 0, 0, sy, 0, 0);
+
+        drawCup(geom);
+
+        if (supportsHTMLInCanvas) {
+          // drawElementImage returns the transform that maps the element's layout
+          // box to where it was drawn; applying it keeps hit testing, focus rings,
+          // caret placement and accessibility bounds aligned with the pixels.
+          const transform = ctx.drawElementImage(form, geom.formX, geom.formY);
+          form.style.transform = transform.toString();
+        } else {
+          form.style.transform = `translate(${geom.formX}px, ${geom.formY}px)`;
+        }
+      }
+
+      function scheduleDraw() {
+        if (supportsHTMLInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          requestAnimationFrame(draw);
+        }
+      }
+
+      // Repaint whenever the canvas children's rendering changes (typing, focus, etc.).
+      if (supportsHTMLInCanvas) canvas.addEventListener('paint', draw);
+
+      const observer = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.target !== canvas) continue;
+          // Size the backing store in exact device pixels to avoid blurriness.
+          let w, h;
+          if (entry.devicePixelContentBoxSize) {
+            w = entry.devicePixelContentBoxSize[0].inlineSize;
+            h = entry.devicePixelContentBoxSize[0].blockSize;
+          } else {
+            const dpr = window.devicePixelRatio || 1;
+            w = Math.round(entry.contentBoxSize[0].inlineSize * dpr);
+            h = Math.round(entry.contentBoxSize[0].blockSize * dpr);
+          }
+          if (canvas.width !== w) canvas.width = w;
+          if (canvas.height !== h) canvas.height = h;
+        }
+        layout();
+        draw();
+      });
+      try {
+        observer.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch {
+        observer.observe(canvas);
+      }
+      observer.observe(form);
+
+      function updateLabel() {
+        const data = new FormData(form);
+        const name = nameInput.value.trim();
+        const milk = data.get('milk');
+        const syrup = data.get('syrup');
+        const parts = [];
+        parts.push(milk === 'none' ? 'black' : `${milk} milk`);
+        if (syrup !== 'none') parts.push(`${syrup} syrup`);
+        cupLabel.textContent = `${name ? name + "'s" : 'Your'} coffee: ${parts.join(', ')}.`;
+        status.textContent = '';
+      }
+
+      form.addEventListener('input', () => {
+        updateLabel();
+        scheduleDraw();
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const name = nameInput.value.trim();
+        status.textContent = name
+          ? `Thanks, ${name}! Your coffee has been added to your order.`
+          : 'Your coffee has been added to your order.';
+        scheduleDraw();
+      });
+
+      updateLabel();
+      layout();
+      draw();
+    })();
+  </script>
+
