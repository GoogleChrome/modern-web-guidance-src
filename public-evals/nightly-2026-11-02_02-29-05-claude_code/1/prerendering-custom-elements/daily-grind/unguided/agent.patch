+  <script type="module">
+    // Hydrates server-rendered <drink-card> elements. The shadow root and its
+    // styles already exist from the declarative template, so we only attach
+    // behavior to it -- nothing is re-rendered.
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    const loadFavorites = () => {
+      try {
+        return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+      } catch {
+        return new Set();
+      }
+    };
+
+    const saveFavorites = (favorites) => {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota); favorites stay in-memory.
+      }
+    };
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorited'];
+
+      #internals = this.attachInternals();
+      #button = null;
+
+      connectedCallback() {
+        if (this.#button) return;
+
+        let root = this.#internals.shadowRoot;
+        if (!root) {
+          // Fallback for browsers without Declarative Shadow DOM support.
+          const template = this.querySelector(':scope > template[shadowrootmode]');
+          root = this.attachShadow({ mode: 'open' });
+          if (template) {
+            root.append(template.content);
+            template.remove();
+          }
+        }
+
+        this.#button = root.querySelector('.favorite');
+        this.#button.addEventListener('click', () => this.toggleFavorite());
+
+        if (loadFavorites().has(this.drinkId)) {
+          this.favorited = true;
+        }
+        this.#syncButton();
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id');
+      }
+
+      get name() {
+        return this.querySelector('[slot="title"]')?.textContent.trim() ?? '';
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      toggleFavorite() {
+        this.favorited = !this.favorited;
+
+        const favorites = loadFavorites();
+        if (this.favorited) {
+          favorites.add(this.drinkId);
+        } else {
+          favorites.delete(this.drinkId);
+        }
+        saveFavorites(favorites);
+
+        this.dispatchEvent(new CustomEvent('favorite-change', {
+          bubbles: true,
+          composed: true,
+          detail: { drinkId: this.drinkId, favorited: this.favorited },
+        }));
+      }
+
+      attributeChangedCallback() {
+        this.#syncButton();
+      }
+
+      #syncButton() {
+        if (!this.#button) return;
+        const on = this.favorited;
+        this.#button.setAttribute('aria-pressed', String(on));
+        this.#button.setAttribute('aria-label', `${on ? 'Remove' : 'Add'} ${this.name} ${on ? 'from' : 'to'} favorites`);
+        this.#button.textContent = on ? '\u2605' : '\u2606';
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
