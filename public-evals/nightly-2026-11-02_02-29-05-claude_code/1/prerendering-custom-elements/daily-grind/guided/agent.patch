+// Hydrates the server-rendered <drink-card> elements on the homepage.
+// Markup and styles ship in each card's declarative shadow root, so this
+// script only attaches behavior to the existing DOM — it never re-renders.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(favorites) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+  } catch {
+    // Storage unavailable (private mode, quota); keep the in-page state only.
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorited'];
+
+  #button;
+
+  constructor() {
+    super();
+
+    // Browsers without declarative shadow DOM leave the template inert;
+    // attach the same server markup imperatively so the card still renders.
+    if (!this.shadowRoot) {
+      const template = this.querySelector(':scope > template[shadowrootmode]');
+      if (template) {
+        this.attachShadow({ mode: 'open' }).append(template.content);
+        template.remove();
+      }
+    }
+
+    this.#button = this.shadowRoot?.querySelector('.fav');
+    this.#button?.addEventListener('click', () => this.toggle());
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id') ?? '';
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+
+  set favorited(on) {
+    this.toggleAttribute('favorited', !!on);
+  }
+
+  connectedCallback() {
+    if (this.drinkId) this.favorited = readFavorites().has(this.drinkId);
+    this.#sync();
+    if (this.#button) this.#button.disabled = false;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#sync();
+  }
+
+  toggle() {
+    this.favorited = !this.favorited;
+
+    if (this.drinkId) {
+      const favorites = readFavorites();
+      this.favorited ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #sync() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorited));
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
