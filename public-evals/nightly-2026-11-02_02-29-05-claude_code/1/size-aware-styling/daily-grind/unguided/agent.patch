+    /* Seasonal drink cards: layout responds to each card's own width */
+    .drink-grid {
+      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
+    }
+
+    .drink-grid .featured {
+      grid-column: 1 / -1;
+    }
+
+    .drink {
+      container: drink / inline-size;
+    }
+
+    .drink .card {
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      padding: 0;
+      overflow: hidden;
+    }
+
+    .drink-img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .drink-body {
+      display: flex;
+      flex: 1;
+      flex-direction: column;
+      align-items: center;
+      padding: 20px;
+    }
+
+    .drink-body .btn {
+      margin-top: auto;
+    }
+
+    .drink-body p {
+      margin-bottom: 15px;
+    }
+
+    /* Side-by-side once the card itself is wide enough */
+    @container drink (min-width: 480px) {
+      .drink .card {
+        flex-direction: row;
+        text-align: left;
+      }
+
+      .drink-img {
+        width: 45%;
+        aspect-ratio: auto;
+        min-height: 220px;
+      }
+
+      .drink-body {
+        align-items: flex-start;
+        justify-content: center;
+        padding: 24px 28px;
+      }
+
+      .drink-body .btn {
+        margin-top: 0;
+      }
+    }
+
+    @container drink (min-width: 760px) {
+      .drink-img {
+        width: 50%;
+        min-height: 300px;
+      }
+
+      .drink-body {
+        padding: 40px 48px;
+      }
+
+      .drink-body h3 {
+        font-size: 1.75rem;
+      }
+
+      .drink-body p {
+        font-size: 1.1rem;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
