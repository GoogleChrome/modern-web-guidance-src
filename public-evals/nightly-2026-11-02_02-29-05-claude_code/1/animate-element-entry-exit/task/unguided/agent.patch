+
+    .promo-badge {
+      position: absolute;
+      top: 10px;
+      left: 10px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.75rem;
+      font-weight: bold;
+      padding: 2px 10px;
+      border-radius: 999px;
+    }
+
+    /* Fade + scale in when inserted or un-hidden */
+    @starting-style {
+      .promo-card {
+        opacity: 0;
+        transform: scale(0.85);
+      }
+    }
+
+    /* Fade + scale out when hidden or being removed */
+    .promo-card[hidden],
+    .promo-card.is-leaving {
+      opacity: 0;
+      transform: scale(0.85);
+    }
+
+    .promo-card[hidden] {
+      display: none;
+    }
+
+    .promo-card.is-leaving {
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .promo-card {
+        transition: none;
+      }
+    }
