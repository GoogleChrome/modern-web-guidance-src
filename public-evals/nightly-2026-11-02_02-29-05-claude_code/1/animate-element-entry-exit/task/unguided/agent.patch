+  <script>
+    (function () {
+      const container = document.getElementById('domContainer');
+      const toggleCard = document.getElementById('toggleCard');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const promos = [
+        { title: 'Pastry Pairing', text: 'Add any pastry to a latte for just $2.', img: 'photo-1495474472287-4d71bcdd2085' },
+        { title: 'Double Stamp Day', text: 'Earn twice the rewards on every order today.', img: 'photo-1442512595331-e89e73853f31' },
+        { title: 'Cold Brew Growler', text: 'Refill your growler for 20% off this week.', img: 'photo-1461023058943-07fcbe16d735' },
+        { title: 'Beans to Go', text: 'Take $3 off any 12oz bag of whole beans.', img: 'photo-1447933601403-0c6688de566e' }
+      ];
+      let promoCount = 0;
+
+      function createPromoCard() {
+        const promo = promos[promoCount % promos.length];
+        promoCount++;
+
+        const card = document.createElement('div');
+        card.className = 'card promo-card';
+
+        const badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = 'Promo #' + promoCount;
+
+        const img = document.createElement('img');
+        img.src = 'https://images.unsplash.com/' + promo.img + '?auto=format&fit=crop&w=600&q=80';
+        img.alt = promo.title;
+
+        const title = document.createElement('h3');
+        title.textContent = promo.title;
+
+        const text = document.createElement('p');
+        text.textContent = promo.text;
+
+        card.append(badge, img, title, text);
+        return card;
+      }
+
+      document.getElementById('addBtn').addEventListener('click', function () {
+        // Entry fade/scale is handled by @starting-style in CSS.
+        container.appendChild(createPromoCard());
+      });
+
+      document.getElementById('removeBtn').addEventListener('click', function () {
+        const cards = container.querySelectorAll('.card:not(.is-leaving)');
+        const card = cards[cards.length - 1];
+        if (!card) return;
+
+        // Hidden cards are not visible, so there is nothing to animate.
+        if (reduceMotion.matches || card.hidden) {
+          card.remove();
+          return;
+        }
+
+        card.classList.add('is-leaving');
+        let done = false;
+        const finish = function () {
+          if (done) return;
+          done = true;
+          card.remove();
+        };
+        card.addEventListener('transitionend', function (e) {
+          if (e.target === card && e.propertyName === 'opacity') finish();
+        });
+        // Fallback in case transitionend never fires.
+        setTimeout(finish, 500);
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        // Fade/scale in both directions is driven by the [hidden] CSS rule.
+        toggleCard.toggleAttribute('hidden');
+        toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      });
+    })();
+  </script>
+
