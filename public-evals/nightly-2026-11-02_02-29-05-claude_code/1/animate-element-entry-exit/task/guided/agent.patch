+  <script>
+    const promos = [
+      {
+        title: 'Buy One, Get One Cold Brew',
+        text: 'Bring a friend &mdash; the second cold brew is on us.',
+        img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80',
+        alt: 'Iced coffee in a glass'
+      },
+      {
+        title: 'Double Rewards Weekend',
+        text: 'Earn 2x stars on every purchase Saturday and Sunday.',
+        img: 'https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=600&q=80',
+        alt: 'Coffee beans spilling from a cup'
+      },
+      {
+        title: 'Free Pastry Friday',
+        text: 'Get a free croissant with any large drink.',
+        img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80',
+        alt: 'Fresh croissants on a table'
+      }
+    ];
+
+    const container = document.getElementById('domContainer');
+    const toggleBtn = document.getElementById('toggleBtn');
+    let promoIndex = 0;
+
+    // Firefox parses allow-discrete but doesn't transition display, so probe for real support.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000))
+        ]);
+      }
+
+      // Skipped if showElement() cancelled the close mid-animation.
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      el.dataset.removing = '';
+      await hideElement(el);
+      el.remove();
+    }
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      const promo = promos[promoIndex++ % promos.length];
+      const card = document.createElement('article');
+      card.className = 'card promo-card';
+      card.innerHTML = `
+        <img src="${promo.img}" alt="${promo.alt}" width="600" height="400">
+        <span class="badge">Limited Time</span>
+        <h3>${promo.title}</h3>
+        <p>${promo.text}</p>`;
+      container.append(card);
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      const cards = container.querySelectorAll(':scope > .card:not([data-removing])');
+      const last = cards[cards.length - 1];
+      if (last) removeElement(last);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const card = document.getElementById('toggleCard');
+      if (!card || card.hasAttribute('data-removing')) return;
+      const isHidden = card.hidden || card.hasAttribute('data-closing');
+      if (isHidden) {
+        showElement(card);
+      } else {
+        hideElement(card);
+      }
+      toggleBtn.setAttribute('aria-expanded', String(isHidden));
+    });
+  </script>
+
