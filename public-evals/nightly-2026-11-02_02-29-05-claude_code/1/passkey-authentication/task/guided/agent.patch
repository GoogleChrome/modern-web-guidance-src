+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills"
+      }
+    }
+  </script>
+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const OPTIONS_URL = '/api/login/options';
+    const VERIFY_URL = '/api/login/verify';
+
+    const form = document.getElementById('signin-form');
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+
+    let autofillAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.className = `auth-status ${state}`.trim();
+    }
+
+    async function fetchLoginOptions() {
+      const response = await fetch(OPTIONS_URL, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Accept': 'application/json' },
+      });
+      if (!response.ok) throw new Error(`Failed to fetch sign-in options (${response.status})`);
+      return response.json();
+    }
+
+    // Returns true when the server accepted the assertion.
+    async function verifyCredential(credential, rpId) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await fetch(VERIFY_URL, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+
+        if (response.ok) {
+          const result = await response.json().catch(() => ({}));
+          const name = result.username || result.user?.name;
+          setStatus(name ? `Signed in as ${name}.` : 'Signed in successfully.', 'success');
+          return true;
+        }
+
+        if (response.status === 404) {
+          setStatus('This passkey is no longer registered with your account.', 'error');
+          // Tell the passkey provider to remove the stale credential.
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: encoded.id });
+          }
+        } else {
+          setStatus('We couldn’t verify your passkey. Please try again.', 'error');
+        }
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Sign-in failed due to a network error. Please try again.', 'error');
+      }
+      return false;
+    }
+
+    // Offer registered passkeys as autofill suggestions on the username field.
+    async function initializeConditionalAutofill() {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet !== true) return;
+
+      try {
+        const optionsJSON = await fetchLoginOptions();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+        const ok = await verifyCredential(credential, optionsJSON.rpId || location.hostname);
+        if (!ok) initializeConditionalAutofill();
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    // Explicit button: prompt for biometrics / screen lock directly.
+    async function triggerButtonAuthentication() {
+      // Abort any pending conditional request so the two prompts don't collide.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let optionsJSON;
+      let credential;
+      try {
+        optionsJSON = await fetchLoginOptions();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.');
+        } else if (err.name !== 'AbortError') {
+          console.error('Passkey sign-in error:', err);
+          setStatus('Passkey sign-in failed. Please try again.', 'error');
+        }
+        // Re-arm autofill suggestions after a cancelled or failed prompt.
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const ok = await verifyCredential(credential, optionsJSON.rpId || location.hostname);
+      if (!ok) initializeConditionalAutofill();
+    }
+
+    if (window.PublicKeyCredential) {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        triggerButtonAuthentication();
+      });
+      initializeConditionalAutofill();
+    } else {
+      form.addEventListener('submit', (event) => event.preventDefault());
+      setStatus('Passkeys aren’t supported in this browser.', 'error');
+    }
+  </script>
+
 </body>
 
