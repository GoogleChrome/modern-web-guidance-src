+  <script>
+    (() => {
+      const OPTIONS_URL = '/api/login/options';
+      const VERIFY_URL = '/api/login/verify';
+
+      const form = document.getElementById('signin-form');
+      const usernameField = document.getElementById('username');
+      const authButton = document.getElementById('passkey-button');
+      const statusEl = document.getElementById('auth-status');
+
+      let conditionalAbort = null;
+      let signedIn = false;
+
+      const setStatus = (message, state) => {
+        statusEl.textContent = message;
+        if (state) statusEl.dataset.state = state;
+        else statusEl.removeAttribute('data-state');
+      };
+
+      const supportsWebAuthn = () =>
+        window.PublicKeyCredential && navigator.credentials && navigator.credentials.get;
+
+      const toBuffer = (base64url) => {
+        const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        return Uint8Array.from(atob(padded), (c) => c.charCodeAt(0)).buffer;
+      };
+
+      const toBase64url = (buffer) => {
+        if (!buffer) return null;
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (const b of bytes) binary += String.fromCharCode(b);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      // Server returns PublicKeyCredentialRequestOptionsJSON (base64url-encoded binary fields).
+      const parseRequestOptions = (json) => {
+        const options = json.publicKey || json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+        }
+        return {
+          ...options,
+          challenge: toBuffer(options.challenge),
+          allowCredentials: (options.allowCredentials || []).map((c) => ({ ...c, id: toBuffer(c.id) })),
+        };
+      };
+
+      const serializeCredential = (credential) => {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (_) { /* fall through to manual encoding */ }
+        }
+        const r = credential.response;
+        return {
+          id: credential.id,
+          rawId: toBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: toBase64url(r.clientDataJSON),
+            authenticatorData: toBase64url(r.authenticatorData),
+            signature: toBase64url(r.signature),
+            userHandle: toBase64url(r.userHandle),
+          },
+        };
+      };
+
+      const fetchOptions = async () => {
+        const res = await fetch(OPTIONS_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({}),
+        });
+        if (!res.ok) throw new Error('Could not start sign-in. Please try again.');
+        return parseRequestOptions(await res.json());
+      };
+
+      const verify = async (credential) => {
+        const res = await fetch(VERIFY_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(serializeCredential(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty or non-JSON body */ }
+        if (!res.ok || data.verified === false || data.success === false) {
+          throw new Error(data.error || data.message || 'Passkey verification failed.');
+        }
+        return data;
+      };
+
+      const onSignedIn = (data) => {
+        signedIn = true;
+        const name = data.username || (data.user && (data.user.displayName || data.user.username || data.user.name)) || usernameField.value.trim();
+        setStatus(name ? `Signed in as ${name}` : 'Signed in successfully', 'success');
+        usernameField.disabled = true;
+        authButton.disabled = true;
+      };
+
+      const isAbort = (err) => err && err.name === 'AbortError';
+
+      // Autofill (conditional mediation): runs in the background so the browser lists
+      // passkeys when the username field is focused. Must be pending before focus.
+      const startConditionalUI = async () => {
+        if (signedIn || conditionalAbort || !supportsWebAuthn()) return;
+        if (typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+
+        // Claim the slot before any await so a focus event can't start a second request.
+        const controller = new AbortController();
+        conditionalAbort = controller;
+        try {
+          if (!(await PublicKeyCredential.isConditionalMediationAvailable())) {
+            controller.abort();
+            return;
+          }
+          const publicKey = await fetchOptions();
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: 'conditional',
+            signal: controller.signal,
+          });
+          if (!credential) return;
+          setStatus('Verifying passkey…');
+          onSignedIn(await verify(credential));
+        } catch (err) {
+          if (isAbort(err) || controller.signal.aborted) return;
+          setStatus(err.name === 'NotAllowedError' ? 'Passkey sign-in was cancelled.' : err.message, 'error');
+        } finally {
+          if (conditionalAbort === controller) conditionalAbort = null;
+        }
+        // Re-arm autofill after a failed or cancelled attempt.
+        if (!signedIn && !controller.signal.aborted) startConditionalUI();
+      };
+
+      const cancelConditionalUI = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      };
+
+      // Explicit button: modal prompt that asks for biometrics/device unlock directly.
+      const signInWithPasskey = async () => {
+        if (signedIn) return;
+        if (!supportsWebAuthn()) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+        cancelConditionalUI();
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+        try {
+          const publicKey = await fetchOptions();
+          publicKey.userVerification = 'required';
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'required' });
+          if (!credential) throw new Error('No passkey was selected.');
+          setStatus('Verifying passkey…');
+          onSignedIn(await verify(credential));
+        } catch (err) {
+          setStatus(err.name === 'NotAllowedError' ? 'Passkey sign-in was cancelled.' : err.message, 'error');
+        } finally {
+          if (!signedIn) {
+            authButton.disabled = false;
+            startConditionalUI();
+          }
+        }
+      };
+
+      authButton.addEventListener('click', signInWithPasskey);
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        signInWithPasskey();
+      });
+      // Safety net in case the background request was not armed yet (e.g. after an abort).
+      usernameField.addEventListener('focus', startConditionalUI);
+
+      startConditionalUI();
+    })();
+  </script>
+
