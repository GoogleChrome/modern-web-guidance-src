new file mode 100644
index 0000000..27946ec
--- /dev/null
+++ b/src/components/SmallptRender.tsx
@@ -0,0 +1,132 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ArrowPathIcon } from '@heroicons/react/24/outline';
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const MAX_PASSES = 16; // 4 samples per pixel each
+
+// Sphere indices in smallpt's scene (the Cornell box walls are huge spheres too).
+// The front wall (3) sits behind the camera and the light (8) is emissive, so
+// those keep their original values.
+const COLORED_SPHERES = [
+  { index: 0, name: 'Left wall' },
+  { index: 1, name: 'Right wall' },
+  { index: 2, name: 'Back wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror ball' },
+  { index: 7, name: 'Glass ball' },
+];
+
+type SphereColor = [index: number, r: number, g: number, b: number];
+
+function hslToRgb(h: number, s: number, l: number): [number, number, number] {
+  const k = (n: number) => (n + h * 12) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+  return [f(0), f(8), f(4)];
+}
+
+function randomColors(): SphereColor[] {
+  // Keep reflectance below 1 so smallpt's Russian roulette still terminates paths.
+  return COLORED_SPHERES.map(({ index }) => {
+    const [r, g, b] = hslToRgb(Math.random(), 0.35 + Math.random() * 0.55, 0.35 + Math.random() * 0.4);
+    return [index, r * 0.95, g * 0.95, b * 0.95];
+  });
+}
+
+const toCss = ([, r, g, b]: SphereColor) =>
+  `rgb(${Math.round(r * 255)}, ${Math.round(g * 255)}, ${Math.round(b * 255)})`;
+
+export default function SmallptRender() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobRef = useRef(0);
+  const [colors, setColors] = useState<SphereColor[]>([]); // empty = original scene
+  const [progress, setProgress] = useState({ spp: 0, elapsedMs: 0, done: false });
+
+  useEffect(() => {
+    const worker = new Worker(`${import.meta.env.BASE_URL}smallpt/worker.mjs`, { type: 'module' });
+    workerRef.current = worker;
+    const ctx = canvasRef.current!.getContext('2d')!;
+
+    worker.onmessage = ({ data }) => {
+      if (data.job !== jobRef.current) return; // stale frame from a superseded render
+      if (data.type === 'frame') {
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), WIDTH, HEIGHT), 0, 0);
+        setProgress({ spp: data.spp, elapsedMs: data.elapsedMs, done: false });
+      } else if (data.type === 'done') {
+        setProgress((p) => ({ ...p, done: true }));
+      }
+    };
+    render([]);
+
+    return () => worker.terminate();
+  }, []);
+
+  function render(sphereColors: SphereColor[]) {
+    const job = ++jobRef.current;
+    setColors(sphereColors);
+    setProgress({ spp: 0, elapsedMs: 0, done: false });
+    workerRef.current?.postMessage({
+      type: 'render',
+      job,
+      width: WIDTH,
+      height: HEIGHT,
+      maxPasses: MAX_PASSES,
+      colors: sphereColors,
+    });
+  }
+
+  return (
+    <section className="p-4 md:p-6">
+      <h2 className="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">Path Traced Live</h2>
+      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-center">
+        <div className="relative bg-black shadow-sm">
+          <canvas
+            ref={canvasRef}
+            width={WIDTH}
+            height={HEIGHT}
+            className="block w-full h-auto"
+            aria-label="Cornell box scene rendered by the smallpt path tracer"
+          />
+          <span className="absolute bottom-2 right-2 bg-black/60 text-white text-xs font-mono px-2 py-1">
+            {progress.spp === 0
+              ? 'Starting…'
+              : `${progress.spp} spp · ${(progress.elapsedMs / 1000).toFixed(1)}s${progress.done ? '' : ' · rendering'}`}
+          </span>
+        </div>
+        <div>
+          <span className="text-amber-400 font-semibold text-sm">Technology</span>
+          <h3 className="text-2xl font-bold text-gray-900 mt-2 mb-3">A 99-line path tracer, running in your browser</h3>
+          <p className="text-gray-700 mb-4">
+            This image is being computed right now on your device. It's{' '}
+            <a href="http://www.kevinbeason.com/smallpt/" className="underline hover:text-amber-400" target="_blank" rel="noopener">
+              smallpt
+            </a>
+            , Kevin Beason's tiny C++ global illumination renderer, compiled to WebAssembly and running in a Web Worker.
+            Every pass adds 4 more samples per pixel, so the noise clears up as you watch.
+          </p>
+          {colors.length > 0 && (
+            <ul className="flex flex-wrap gap-x-4 gap-y-2 mb-4 text-xs text-gray-600">
+              {colors.map((c, i) => (
+                <li key={c[0]} className="flex items-center gap-1.5">
+                  <span className="inline-block w-3 h-3 border border-gray-300" style={{ backgroundColor: toCss(c) }} />
+                  {COLORED_SPHERES[i].name}
+                </li>
+              ))}
+            </ul>
+          )}
+          <button
+            type="button"
+            onClick={() => render(randomColors())}
+            className="inline-flex items-center gap-2 bg-gray-900 text-white font-semibold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 transition-colors cursor-pointer"
+          >
+            <ArrowPathIcon className="w-5 h-5" />
+            Render with random colors
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
