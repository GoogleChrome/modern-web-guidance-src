--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Compiles smallpt to WebAssembly. Requires Emscripten (emcc) on PATH.
+# Output is committed to public/smallpt/ so the site build doesn't need emcc.
+set -euo pipefail
+cd "$(dirname "$0")"
+emcc -O3 -Wno-dangling-else smallpt.cpp -o ../public/smallpt/smallpt.mjs \
+  -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sFILESYSTEM=0 -sSTACK_SIZE=8MB \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
