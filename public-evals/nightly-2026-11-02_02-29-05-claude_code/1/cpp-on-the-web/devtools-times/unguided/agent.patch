diff --git a/public/smallpt/worker.mjs b/public/smallpt/worker.mjs
new file mode 100644
index 0000000..3d553cb
--- /dev/null
+++ b/public/smallpt/worker.mjs
@@ -0,0 +1,35 @@
+// Runs the smallpt WebAssembly build off the main thread.
+//
+// In:  { type: 'render', job, width, height, maxPasses, colors: [[sphereIndex, r, g, b], ...] }
+// Out: { type: 'frame', job, pixels: ArrayBuffer (RGBA8), spp, elapsedMs }
+//      { type: 'done', job }
+import createSmallpt from './smallpt.mjs';
+
+const modulePromise = createSmallpt();
+let currentJob = null;
+
+// Yield to the event loop so a newer 'render' message can preempt this job.
+const yieldToEvents = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+self.onmessage = async ({ data }) => {
+  if (data.type !== 'render') return;
+  const job = (currentJob = data.job);
+  const m = await modulePromise;
+  if (job !== currentJob) return;
+
+  const { width, height, maxPasses, colors } = data;
+  m._smallpt_reset_scene();
+  for (const [i, r, g, b] of colors) m._smallpt_set_color(i, r, g, b);
+  const ptr = m._smallpt_init(width, height);
+  const start = performance.now();
+
+  for (let pass = 0; pass < maxPasses; pass++) {
+    const spp = m._smallpt_render_pass();
+    // Copy out of wasm memory (which may grow and detach views) and transfer.
+    const pixels = m.HEAPU8.slice(ptr, ptr + width * height * 4).buffer;
+    self.postMessage({ type: 'frame', job, pixels, spp, elapsedMs: performance.now() - start }, [pixels]);
+    await yieldToEvents();
+    if (job !== currentJob) return;
+  }
+  self.postMessage({ type: 'done', job });
+};
