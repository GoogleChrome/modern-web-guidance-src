+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---------------------------------------------------------------------------
+// WebAssembly API
+//
+// Each call to smallpt_render_pass() traces one sample per 2x2 subpixel
+// (4 spp) into an accumulation buffer and writes the averaged, gamma-corrected
+// result to an RGBA8 buffer that JS can copy straight into ImageData.
+// ---------------------------------------------------------------------------
+static const int NUM_SPHERES = sizeof(spheres)/sizeof(Sphere);
+static Sphere default_spheres[NUM_SPHERES] = {
+  spheres[0], spheres[1], spheres[2], spheres[3], spheres[4],
+  spheres[5], spheres[6], spheres[7], spheres[8]
+};
+static int W = 0, H = 0, passes = 0;
+static Vec *accum = 0;
+static unsigned char *rgba = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int smallpt_num_spheres(){ return NUM_SPHERES; }
+
+EMSCRIPTEN_KEEPALIVE void smallpt_set_color(int i, double r, double g, double b){
+  if (i >= 0 && i < NUM_SPHERES) spheres[i].c = Vec(r, g, b);
+}
+
+EMSCRIPTEN_KEEPALIVE void smallpt_reset_scene(){
+  for (int i = 0; i < NUM_SPHERES; i++) spheres[i] = default_spheres[i];
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned char *smallpt_init(int w, int h){
+  delete[] accum; delete[] rgba;
+  W = w; H = h; passes = 0;
+  accum = new Vec[w*h*4]; // unclamped radiance sum per 2x2 subpixel
+  rgba = new unsigned char[w*h*4];
+  return rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE int smallpt_render_pass(){
+  int w = W, h = H;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+  passes++;
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    for (unsigned short x=0, Xi[3]={0,(unsigned short)passes,(unsigned short)(y*y*y)}; x<w; x++)
+      for (int sy=0, i=((h-y-1)*w+x)*4; sy<2; sy++)     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, i++){        // 2x2 subpixel cols
+          double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+          Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                  cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+          accum[i] = accum[i] + radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        }
+  }
+  double inv = 1./passes;
+  for (int i=0; i<w*h; i++){ // clamp each subpixel's mean, as main() did
+    Vec c;
+    for (int s=0; s<4; s++){
+      Vec r = accum[i*4+s]*inv;
+      c = c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+    }
+    rgba[i*4+0] = toInt(c.x);
+    rgba[i*4+1] = toInt(c.y);
+    rgba[i*4+2] = toInt(c.z);
+    rgba[i*4+3] = 255;
+  }
+  return passes*4; // total samples per pixel so far
+}
+
+}
