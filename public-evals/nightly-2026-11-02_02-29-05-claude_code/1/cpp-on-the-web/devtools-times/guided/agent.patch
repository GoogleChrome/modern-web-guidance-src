new file mode 100644
index 0000000..d29c2cf
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,29 @@
+// Renders bands of rows with the smallpt WebAssembly module (built by wasm/build.sh).
+// Message in:  { id, width, height, spp, y0, y1, colors: [[sphereIndex, r, g, b], ...] }
+// Message out: { id, y0, y1, pixels: Uint8ClampedArray (RGBA) } or { id, error }
+import initSmallpt from './smallpt.js';
+
+const ready = initSmallpt();
+let ptr = 0;
+let capacity = 0;
+
+self.onmessage = async ({ data }) => {
+  const { id, width, height, spp, y0, y1, colors } = data;
+  try {
+    const smallpt = await ready;
+    for (const [index, r, g, b] of colors) smallpt._set_sphere_color(index, r, g, b);
+
+    const byteLength = (y1 - y0) * width * 4;
+    if (byteLength > capacity) {
+      if (ptr) smallpt._free(ptr);
+      ptr = smallpt._malloc(byteLength);
+      capacity = byteLength;
+    }
+    smallpt._render_rows(ptr, width, height, spp, y0, y1);
+    // Read HEAPU8 after the call: memory growth would detach an earlier view.
+    const pixels = new Uint8ClampedArray(smallpt.HEAPU8.buffer, ptr, byteLength).slice();
+    self.postMessage({ id, y0, y1, pixels }, [pixels.buffer]);
+  } catch (error) {
+    self.postMessage({ id, error: String(error) });
+  }
+};
diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..10d56d3
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,199 @@
+---
+// Client-side path tracing with smallpt (http://www.kevinbeason.com/smallpt/),
+// compiled to WebAssembly by wasm/build.sh and run in a pool of Web Workers.
+const width = 480;
+const height = 360;
+const spp = 64;
+---
+<section class="p-4 md:p-6" data-smallpt data-width={width} data-height={height} data-spp={spp}>
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        Rendered in Your Browser
+    </h2>
+
+    <div class="grid md:grid-cols-3 gap-6">
+        <canvas
+            width={width}
+            height={height}
+            class="md:col-span-2 w-full h-auto bg-gray-900"
+            style={`aspect-ratio: ${width} / ${height}`}
+            role="img"
+            aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere"
+        ></canvas>
+
+        <div class="flex flex-col gap-4">
+            <p class="text-gray-700">
+                This image is computed right now on your device by
+                <a href="http://www.kevinbeason.com/smallpt/" class="underline hover:text-amber-400">smallpt</a>,
+                Kevin Beason's 99-line C++ global illumination path tracer, compiled to WebAssembly.
+                Every pixel averages {spp} random light paths bouncing around the scene.
+            </p>
+
+            <ul class="flex flex-wrap gap-2" data-swatches aria-label="Sphere colors"></ul>
+
+            <p class="text-sm text-gray-500" data-status role="status">Waiting to render…</p>
+
+            <button
+                type="button"
+                data-rerender
+                class="py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+            >
+                Render again with random colors
+            </button>
+        </div>
+    </div>
+</section>
+
+<script>
+    type Color = [number, number, number];
+
+    // Indices into smallpt's spheres[] array. The front wall (black, behind the
+    // camera) and the light are left alone.
+    const DEFAULT_SPHERES: { index: number; name: string; color: Color; tint: boolean }[] = [
+        { index: 0, name: 'Left wall', color: [0.75, 0.25, 0.25], tint: false },
+        { index: 1, name: 'Right wall', color: [0.25, 0.25, 0.75], tint: false },
+        { index: 2, name: 'Back wall', color: [0.75, 0.75, 0.75], tint: false },
+        { index: 4, name: 'Floor', color: [0.75, 0.75, 0.75], tint: false },
+        { index: 5, name: 'Ceiling', color: [0.75, 0.75, 0.75], tint: false },
+        { index: 6, name: 'Mirror sphere', color: [0.999, 0.999, 0.999], tint: true },
+        { index: 7, name: 'Glass sphere', color: [0.999, 0.999, 0.999], tint: true },
+    ];
+    const BAND_ROWS = 8;
+
+    function hslToRgb(h: number, s: number, l: number): Color {
+        const k = (n: number) => (n + h / 30) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+        return [f(0), f(8), f(4)];
+    }
+
+    function randomColor(tint: boolean): Color {
+        const rand = (min: number, max: number) => min + Math.random() * (max - min);
+        // Reflectance must stay below 1; mirror/glass get lighter tints so they still read as such.
+        const [r, g, b] = tint
+            ? hslToRgb(rand(0, 360), rand(0.5, 1), rand(0.6, 0.8))
+            : hslToRgb(rand(0, 360), rand(0.3, 0.8), rand(0.35, 0.6));
+        return [Math.min(r, 0.999), Math.min(g, 0.999), Math.min(b, 0.999)];
+    }
+
+    function toCss([r, g, b]: Color) {
+        return `rgb(${Math.round(r * 255)} ${Math.round(g * 255)} ${Math.round(b * 255)})`;
+    }
+
+    function setup(section: HTMLElement) {
+        const width = Number(section.dataset.width);
+        const height = Number(section.dataset.height);
+        const spp = Number(section.dataset.spp);
+        const canvas = section.querySelector('canvas')!;
+        const ctx = canvas.getContext('2d')!;
+        const status = section.querySelector<HTMLElement>('[data-status]')!;
+        const swatches = section.querySelector<HTMLElement>('[data-swatches]')!;
+        const button = section.querySelector<HTMLButtonElement>('[data-rerender]')!;
+
+        const workerUrl = `${import.meta.env.BASE_URL}smallpt/worker.js`;
+        const workerCount = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 8));
+        const workers: Worker[] = [];
+        const idleWorkers = new Set<Worker>();
+
+        let renderId = 0;
+        let colors: [number, ...Color][] = [];
+        let nextBand = 0;
+        let bandsDone = 0;
+        let startTime = 0;
+        const bandCount = Math.ceil(height / BAND_ROWS);
+
+        function dispatch(worker: Worker) {
+            if (nextBand >= bandCount) {
+                idleWorkers.add(worker);
+                return;
+            }
+            idleWorkers.delete(worker);
+            const y0 = nextBand++ * BAND_ROWS;
+            worker.postMessage({
+                id: renderId, width, height, spp, y0, y1: Math.min(y0 + BAND_ROWS, height), colors,
+            });
+        }
+
+        function onMessage(this: Worker, { data }: MessageEvent) {
+            if (data.id !== renderId) {
+                // Stale band from a superseded render; hand this worker new work.
+                dispatch(this);
+                return;
+            }
+            if (data.error) {
+                status.textContent = `Rendering failed: ${data.error}`;
+                idleWorkers.add(this);
+                return;
+            }
+            ctx.putImageData(new ImageData(data.pixels, width, data.y1 - data.y0), 0, data.y0);
+            bandsDone++;
+            if (bandsDone === bandCount) {
+                const seconds = ((performance.now() - startTime) / 1000).toFixed(1);
+                status.textContent = `Rendered ${width}×${height} at ${spp} samples/pixel in ${seconds}s on ${workerCount} threads.`;
+            } else {
+                status.textContent = `Rendering… ${Math.round((100 * bandsDone) / bandCount)}%`;
+            }
+            dispatch(this);
+        }
+
+        function ensureWorkers() {
+            while (workers.length < workerCount) {
+                const worker = new Worker(workerUrl, { type: 'module' });
+                worker.addEventListener('message', onMessage);
+                worker.addEventListener('error', () => {
+                    status.textContent = 'Rendering failed: could not load the WebAssembly module.';
+                });
+                workers.push(worker);
+                idleWorkers.add(worker);
+            }
+        }
+
+        function render(spheres: { index: number; name: string; color: Color }[]) {
+            ensureWorkers();
+            renderId++;
+            colors = spheres.map(({ index, color }) => [index, ...color]);
+            nextBand = 0;
+            bandsDone = 0;
+            startTime = performance.now();
+            status.textContent = 'Rendering… 0%';
+
+            swatches.replaceChildren(...spheres.map(({ name, color }) => {
+                const li = document.createElement('li');
+                li.className = 'size-6 rounded-full border border-gray-300';
+                li.style.backgroundColor = toCss(color);
+                li.title = name;
+                li.setAttribute('aria-label', name);
+                return li;
+            }));
+
+            // Workers still busy with an old render pick up new bands when they report back.
+            [...idleWorkers].forEach(dispatch);
+        }
+
+        button.addEventListener('click', () => {
+            render(DEFAULT_SPHERES.map((s) => ({ ...s, color: randomColor(s.tint) })));
+        });
+
+        // Path tracing saturates the CPU, so wait until the section is on screen.
+        const observer = new IntersectionObserver((entries) => {
+            if (entries.some((e) => e.isIntersecting)) {
+                observer.disconnect();
+                if (renderId === 0) render(DEFAULT_SPHERES);
+            }
+        });
+        observer.observe(section);
+
+        return () => {
+            observer.disconnect();
+            workers.forEach((w) => w.terminate());
+        };
+    }
+
+    let cleanups: (() => void)[] = [];
+    document.addEventListener('astro:page-load', () => {
+        cleanups = [...document.querySelectorAll<HTMLElement>('[data-smallpt]')].map(setup);
+    });
+    document.addEventListener('astro:before-swap', () => {
+        cleanups.forEach((cleanup) => cleanup());
+        cleanups = [];
+    });
+</script>
