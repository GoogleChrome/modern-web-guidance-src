diff --git a/smallpt/worker.js b/smallpt/worker.js
new file mode 100644
index 0000000..85b7eae
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,22 @@
+// Runs smallpt (compiled to WebAssembly) off the main thread.
+import initSmallpt from './smallpt.js';
+
+const wasm = await initSmallpt();
+
+self.onmessage = ({ data }) => {
+  const { id, width, height, spp, y0, y1, pass, colors } = data;
+  colors.forEach(([r, g, b], i) => wasm._set_sphere_color(i, r, g, b));
+
+  const length = (y1 - y0) * width * 3;
+  const ptr = wasm._malloc(length * 4);
+  try {
+    wasm._render_rows(ptr, width, height, spp, y0, y1, pass);
+    // Read HEAPF32 after the call: memory growth may replace the buffer.
+    const pixels = new Float32Array(wasm.HEAPF32.buffer, ptr, length).slice();
+    self.postMessage({ id, y0, y1, pixels }, [pixels.buffer]);
+  } finally {
+    wasm._free(ptr);
+  }
+};
+
+self.postMessage({ ready: true });
diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..0b95e1a
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env sh
+# Compiles smallpt to an ES6 WebAssembly module for use inside a Web Worker.
+set -eu
+# Note: -flto is omitted because the Debian emscripten LTO libc++ fails to link.
+cd "$(dirname "$0")"
+mkdir -p ../smallpt
+em++ -c smallpt.cpp -o smallpt.o -O3 -Wall -Wno-dangling-else -Werror
+em++ smallpt.o -o ../smallpt/smallpt.js \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_render_rows,_set_sphere_color,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPF32
+rm smallpt.o
