diff --git a/smallpt/main.js b/smallpt/main.js
new file mode 100644
index 0000000..7aff7df
--- /dev/null
+++ b/smallpt/main.js
@@ -0,0 +1,140 @@
+// Progressive smallpt renderer: farms row bands out to a pool of workers and
+// averages successive low-sample passes into the canvas.
+const WIDTH = 480;
+const HEIGHT = 360;
+const BAND = 12;          // rows per job
+const SPP_PER_PASS = 8;   // samples per pixel per pass
+const PASSES = 16;        // total = 128 spp
+
+// Default colors from smallpt's scene, indexed like spheres[] in smallpt.cpp.
+const DEFAULT_COLORS = [
+  [0.75, 0.25, 0.25], // left wall
+  [0.25, 0.25, 0.75], // right wall
+  [0.75, 0.75, 0.75], // back wall
+  [0, 0, 0],          // front (behind camera)
+  [0.75, 0.75, 0.75], // floor
+  [0.75, 0.75, 0.75], // ceiling
+  [0.999, 0.999, 0.999], // mirror ball
+  [0.999, 0.999, 0.999], // glass ball
+  [0, 0, 0],          // light
+];
+
+const canvas = document.querySelector('#smallpt-canvas');
+const button = document.querySelector('#smallpt-randomize');
+const status = document.querySelector('#smallpt-status');
+const ctx = canvas.getContext('2d');
+canvas.width = WIDTH;
+canvas.height = HEIGHT;
+
+const image = ctx.createImageData(WIDTH, HEIGHT);
+const sum = new Float32Array(WIDTH * HEIGHT * 3);
+const rowSamples = new Uint16Array(HEIGHT);
+const gamma = new Uint8ClampedArray(4096);
+for (let i = 0; i < gamma.length; i++) {
+  gamma[i] = Math.pow(i / (gamma.length - 1), 1 / 2.2) * 255 + 0.5;
+}
+
+let job = null; // current render: { id, colors, queue, done, total, start }
+let nextId = 0;
+const idle = [];
+
+function hslToRgb(h, s, l) {
+  const f = (n) => {
+    const k = (n + h * 12) % 12;
+    return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+  };
+  return [f(0), f(8), f(4)];
+}
+
+function randomColors() {
+  const colors = DEFAULT_COLORS.map((c) => c.slice());
+  for (const i of [0, 1, 2, 4, 5]) {
+    colors[i] = hslToRgb(Math.random(), 0.3 + Math.random() * 0.6, 0.35 + Math.random() * 0.3);
+  }
+  // Tint the mirror and glass balls with lighter colors so they stay shiny.
+  for (const i of [6, 7]) {
+    colors[i] = hslToRgb(Math.random(), 0.4 + Math.random() * 0.6, 0.75).map((c) => Math.min(c, 0.999));
+  }
+  return colors;
+}
+
+function render(colors) {
+  sum.fill(0);
+  rowSamples.fill(0);
+  const queue = [];
+  for (let pass = 0; pass < PASSES; pass++) {
+    for (let y0 = 0; y0 < HEIGHT; y0 += BAND) {
+      queue.push({ pass, y0, y1: Math.min(y0 + BAND, HEIGHT) });
+    }
+  }
+  job = { id: nextId++, colors, queue, done: 0, total: queue.length, start: performance.now() };
+  while (idle.length) dispatch(idle.pop());
+}
+
+function dispatch(worker) {
+  const task = job?.queue.shift();
+  if (!task) {
+    idle.push(worker);
+    return;
+  }
+  worker.postMessage({
+    id: job.id,
+    width: WIDTH,
+    height: HEIGHT,
+    spp: SPP_PER_PASS,
+    colors: job.colors,
+    ...task,
+  });
+}
+
+function onResult(worker, { id, y0, y1, pixels }) {
+  if (id === job.id) {
+    const offset = y0 * WIDTH * 3;
+    for (let i = 0; i < pixels.length; i++) sum[offset + i] += pixels[i];
+    const data = image.data;
+    for (let y = y0; y < y1; y++) {
+      const n = ++rowSamples[y];
+      const scale = (gamma.length - 1) / n;
+      for (let x = 0; x < WIDTH; x++) {
+        const s = (y * WIDTH + x) * 3;
+        const d = (y * WIDTH + x) * 4;
+        data[d] = gamma[Math.min(sum[s] * scale, gamma.length - 1) | 0];
+        data[d + 1] = gamma[Math.min(sum[s + 1] * scale, gamma.length - 1) | 0];
+        data[d + 2] = gamma[Math.min(sum[s + 2] * scale, gamma.length - 1) | 0];
+        data[d + 3] = 255;
+      }
+    }
+    ctx.putImageData(image, 0, 0, 0, y0, WIDTH, y1 - y0);
+
+    job.done++;
+    const spp = Math.floor((job.done / job.total) * PASSES * SPP_PER_PASS);
+    if (job.done === job.total) {
+      const seconds = ((performance.now() - job.start) / 1000).toFixed(1);
+      status.textContent = `Done: ${PASSES * SPP_PER_PASS} samples per pixel in ${seconds}s.`;
+    } else {
+      status.textContent = `Rendering… ${spp} samples per pixel`;
+    }
+  }
+  dispatch(worker);
+}
+
+const workerCount = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 16));
+for (let i = 0; i < workerCount; i++) {
+  const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+  worker.onmessage = ({ data }) => {
+    if (!data.ready) {
+      onResult(worker, data);
+    } else if (job) {
+      dispatch(worker);
+    } else {
+      idle.push(worker);
+      render(DEFAULT_COLORS);
+      button.disabled = false;
+    }
+  };
+  worker.onerror = () => {
+    status.textContent = 'The path tracer failed to load.';
+  };
+}
+
+button.addEventListener('click', () => render(randomColors()));
