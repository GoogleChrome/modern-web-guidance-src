+  <script>
+    (() => {
+      const W = 320, H = 240, PASSES = 64; // 64 passes x 4 spp = 256 spp
+      // Sphere colors from smallpt's scene, in its order:
+      // left, right, back, front, bottom, top walls, mirror, glass, light.
+      const ORIGINAL = [
+        [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0],
+        [.75, .75, .75], [.75, .75, .75], [.999, .999, .999], [.999, .999, .999], [0, 0, 0],
+      ];
+      const SHOWN = [0, 1, 2, 4, 6, 7]; // spheres visible to the camera with a color
+
+      const canvas = document.getElementById('tracer-canvas');
+      const ctx = canvas.getContext('2d');
+      const status = document.getElementById('tracer-status');
+      const swatches = document.getElementById('tracer-swatches');
+      const button = document.getElementById('tracer-shuffle');
+      const worker = new Worker('smallpt/worker.js');
+      let current = 0;
+
+      // Random albedo; diffuse walls stay below 0.85 so light still bounces,
+      // the mirror and glass get a lighter tint so they keep reading as such.
+      const randomColor = (min, max) => Array.from({ length: 3 }, () => min + Math.random() * (max - min));
+      const randomize = () => ORIGINAL.map((c, i) =>
+        i === 3 || i === 8 ? c : i >= 6 ? randomColor(.55, .999) : randomColor(.05, .85));
+
+      const css = ([r, g, b]) => `rgb(${[r, g, b].map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join()})`;
+
+      function render(colors) {
+        swatches.innerHTML = SHOWN.map((i) => `<span style="background:${css(colors[i])}"></span>`).join('');
+        status.textContent = 'Rendering…';
+        worker.postMessage({
+          type: 'render', width: W, height: H, passes: PASSES, colors,
+          seed: Math.floor(Math.random() * 65536),
+        });
+        current++;
+      }
+
+      worker.onmessage = ({ data }) => {
+        if (data.type !== 'pass' || data.id !== current) return;
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), W, H), 0, 0);
+        status.textContent = data.done
+          ? `Done · ${data.spp} samples/pixel`
+          : `Rendering · ${data.spp} samples/pixel`;
+      };
+      worker.onerror = () => { status.textContent = 'Could not load the renderer.'; };
+
+      button.addEventListener('click', () => render(randomize()));
+      render(ORIGINAL);
+    })();
+  </script>
+
