+#!/usr/bin/env bash
+# Compile smallpt to WebAssembly. Requires Emscripten (emcc) on PATH.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc wasm/smallpt.cpp -O3 -o smallpt/smallpt.js \
+  -sENVIRONMENT=worker -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sALLOW_MEMORY_GROWTH=1 \
+  -sEXPORTED_FUNCTIONS=_sphere_count,_set_sphere_color,_begin,_render_pass \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
