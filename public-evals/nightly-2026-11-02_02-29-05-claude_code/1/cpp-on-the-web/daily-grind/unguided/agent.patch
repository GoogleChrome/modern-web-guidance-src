new file mode 100644
index 0000000..c073b65
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,29 @@
+// Runs the smallpt WebAssembly module off the main thread. Each message
+// {type:'render'} restarts progressive rendering; after every pass the
+// current image is posted back as an ImageData-compatible RGBA buffer.
+importScripts('smallpt.js');
+
+const ready = createSmallpt();
+let job = 0;
+
+self.onmessage = async ({ data }) => {
+  if (data.type !== 'render') return;
+  const M = await ready;
+  const id = ++job;
+  const { width, height, passes, colors, seed } = data;
+  colors.forEach(([r, g, b], i) => M._set_sphere_color(i, r, g, b));
+  const ptr = M._begin(width, height, seed);
+
+  for (let p = 0; p < passes; p++) {
+    // Yield between passes so a newer render request can cancel this one.
+    await new Promise((r) => setTimeout(r, 0));
+    if (id !== job) return;
+    const t = performance.now();
+    const spp = M._render_pass();
+    const pixels = M.HEAPU8.slice(ptr, ptr + width * height * 4);
+    self.postMessage(
+      { type: 'pass', id, spp, ms: performance.now() - t, done: p === passes - 1, pixels },
+      [pixels.buffer]
+    );
+  }
+};
