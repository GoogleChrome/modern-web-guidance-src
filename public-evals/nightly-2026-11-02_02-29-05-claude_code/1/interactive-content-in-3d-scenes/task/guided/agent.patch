+  <script>
+    (() => {
+      const scene = document.getElementById('box-scene');
+      const canvas = document.getElementById('box-canvas');
+      const form = document.getElementById('box-form');
+      const status = document.getElementById('box-status');
+      const section = scene.closest('.box-section');
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        status.textContent = `Thanks ${data.get('name')}! ${data.get('bags')} × ${data.get('grind')} added.`;
+      });
+      form.addEventListener('reset', () => { status.textContent = ''; });
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      const gl = canvas.getContext('webgl2', { alpha: true, premultipliedAlpha: false });
+
+      // Fallback: canvas children aren't rendered, so move the form beside the canvas.
+      if (!supportsHtmlInCanvas || !gl) {
+        scene.classList.add('no-html-canvas');
+        scene.append(form);
+        if (!gl) {
+          canvas.remove();
+          return;
+        }
+      }
+
+      // Box dimensions (half extents). The front face is 4:5 like the form.
+      const W = 0.8, H = 1.0, D = 0.45;
+      const FORM_W = 1.44, FORM_H = 1.8;
+      const CAM_DIST = 5;
+
+      // ---- Shaders ----
+      const program = gl.createProgram();
+      for (const [type, src] of [
+        [gl.VERTEX_SHADER, `#version 300 es
+          in vec3 aPos;
+          in vec3 aNormal;
+          in vec2 aUV;
+          uniform mat4 uMVP;
+          uniform mat4 uRotation;
+          out vec3 vNormal;
+          out vec2 vUV;
+          void main() {
+            vNormal = (uRotation * vec4(aNormal, 0.0)).xyz;
+            vUV = aUV;
+            gl_Position = uMVP * vec4(aPos, 1.0);
+          }`],
+        [gl.FRAGMENT_SHADER, `#version 300 es
+          precision mediump float;
+          in vec3 vNormal;
+          in vec2 vUV;
+          uniform sampler2D uTex;
+          uniform float uLit;
+          out vec4 outColor;
+          void main() {
+            vec4 color = texture(uTex, vUV);
+            float diffuse = max(dot(normalize(vNormal), normalize(vec3(0.4, 0.7, 1.0))), 0.0);
+            float light = mix(1.0, 0.45 + 0.6 * diffuse, uLit);
+            outColor = vec4(color.rgb * light, color.a);
+          }`],
+      ]) {
+        const shader = gl.createShader(type);
+        gl.shaderSource(shader, src);
+        gl.compileShader(shader);
+        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(shader));
+        gl.attachShader(program, shader);
+      }
+      gl.linkProgram(program);
+      gl.useProgram(program);
+      const uMVP = gl.getUniformLocation(program, 'uMVP');
+      const uRotation = gl.getUniformLocation(program, 'uRotation');
+      const uLit = gl.getUniformLocation(program, 'uLit');
+
+      // ---- Geometry: each face is TL, BL, BR, TR (counter-clockwise from outside) ----
+      function buildMesh(faces) {
+        const data = [];
+        const indices = [];
+        faces.forEach(({ corners, normal }, i) => {
+          const uvs = [[0, 0], [0, 1], [1, 1], [1, 0]];
+          corners.forEach((c, j) => data.push(...c, ...normal, ...uvs[j]));
+          const o = i * 4;
+          indices.push(o, o + 1, o + 2, o, o + 2, o + 3);
+        });
+        const vao = gl.createVertexArray();
+        gl.bindVertexArray(vao);
+        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
+        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(data), gl.STATIC_DRAW);
+        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer());
+        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(indices), gl.STATIC_DRAW);
+        [['aPos', 3, 0], ['aNormal', 3, 12], ['aUV', 2, 24]].forEach(([name, size, offset]) => {
+          const loc = gl.getAttribLocation(program, name);
+          gl.enableVertexAttribArray(loc);
+          gl.vertexAttribPointer(loc, size, gl.FLOAT, false, 32, offset);
+        });
+        return { vao, count: indices.length };
+      }
+
+      const boxMesh = buildMesh([
+        { normal: [0, 0, 1], corners: [[-W, H, D], [-W, -H, D], [W, -H, D], [W, H, D]] },
+        { normal: [0, 0, -1], corners: [[W, H, -D], [W, -H, -D], [-W, -H, -D], [-W, H, -D]] },
+        { normal: [1, 0, 0], corners: [[W, H, D], [W, -H, D], [W, -H, -D], [W, H, -D]] },
+        { normal: [-1, 0, 0], corners: [[-W, H, -D], [-W, -H, -D], [-W, -H, D], [-W, H, D]] },
+        { normal: [0, 1, 0], corners: [[-W, H, -D], [-W, H, D], [W, H, D], [W, H, -D]] },
+        { normal: [0, -1, 0], corners: [[-W, -H, D], [-W, -H, -D], [W, -H, -D], [W, -H, D]] },
+      ]);
+      // Unit quad spanning -0.5..0.5, as expected by computeCanvasTransform().
+      const quadMesh = buildMesh([
+        { normal: [0, 0, 1], corners: [[-0.5, 0.5, 0], [-0.5, -0.5, 0], [0.5, -0.5, 0], [0.5, 0.5, 0]] },
+      ]);
+
+      // ---- Kraft-paper box texture, drawn procedurally ----
+      const label = document.createElement('canvas');
+      label.width = 512;
+      label.height = 640;
+      const ctx = label.getContext('2d');
+      ctx.fillStyle = '#b08a5e';
+      ctx.fillRect(0, 0, 512, 640);
+      for (let i = 0; i < 4000; i++) {
+        ctx.fillStyle = `rgba(${Math.random() < 0.5 ? '60,40,20' : '255,240,220'},0.08)`;
+        ctx.fillRect(Math.random() * 512, Math.random() * 640, 2, 2);
+      }
+      ctx.fillStyle = '#4e342e';
+      ctx.fillRect(0, 250, 512, 140);
+      ctx.fillStyle = '#ffab40';
+      ctx.fillRect(0, 240, 512, 8);
+      ctx.fillRect(0, 392, 512, 8);
+      ctx.fillStyle = '#fafafa';
+      ctx.textAlign = 'center';
+      ctx.font = 'bold 54px "Segoe UI", sans-serif';
+      ctx.fillText('THE DAILY', 256, 312);
+      ctx.fillText('GRIND', 256, 368);
+      ctx.strokeStyle = 'rgba(78,52,46,0.6)';
+      ctx.lineWidth = 12;
+      ctx.strokeRect(6, 6, 500, 628);
+
+      const boxTexture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, boxTexture);
+      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, label);
+      gl.generateMipmap(gl.TEXTURE_2D);
+
+      // ---- HTML-in-Canvas texture helpers ----
+      const formTexture = gl.createTexture();
+      const formTextureState = { width: 0, height: 0 };
+
+      // Returns the element's size in canvas grid pixels, or null if it has no paint record yet.
+      function getElementImageSize(element) {
+        let elementImage;
+        try {
+          elementImage = canvas.captureElementImage(element);
+        } catch {
+          canvas.requestPaint();
+          return null;
+        }
+        const width = Math.ceil(elementImage.width);
+        const height = Math.ceil(elementImage.height);
+        elementImage.close();
+        return width > 0 && height > 0 ? { width, height } : null;
+      }
+
+      // Allocate storage only on first upload or when the size changes (reallocating clears it).
+      function allocateElementTexture(width, height) {
+        gl.bindTexture(gl.TEXTURE_2D, formTexture);
+        if (formTextureState.width === width && formTextureState.height === height) return;
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, width, height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
+        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+        formTextureState.width = width;
+        formTextureState.height = height;
+      }
+
+      function uploadForm() {
+        const size = getElementImageSize(form);
+        if (!size) return false;
+        allocateElementTexture(size.width, size.height);
+        gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, form, size);
+        return true;
+      }
+
+      // Maps the element's border box (CSS px) to the canvas (CSS px) for a unit quad drawn with `mvp`.
+      function computeCanvasTransform(element, mvp) {
+        const width = element.offsetWidth;
+        const height = element.offsetHeight;
+        const toGLModel = new DOMMatrix()
+          .scale(1 / width, -1 / height, 1 / height)
+          .translate(-width / 2, -height / 2);
+        const clipToCanvasViewport = new DOMMatrix()
+          .translate(canvas.clientWidth / 2, canvas.clientHeight / 2)
+          .scale(canvas.clientWidth / 2, -canvas.clientHeight / 2, canvas.clientHeight / 2);
+        return clipToCanvasViewport.multiply(mvp).multiply(toGLModel);
+      }
+
+      // ---- Animation state ----
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let angle = -20;
+      let lastTime = 0;
+      let hovering = false;
+      let formUploaded = false;
+      let formHitTestable = false;
+      let running = false;
+      let frameId = 0;
+
+      // ---- Match the canvas grid to device pixels ----
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        formUploaded = false; // The element's size in canvas grid pixels changed.
+        if (!running) supportsHtmlInCanvas ? canvas.requestPaint() : render(); // Redraw while paused.
+      }).observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Slow down while hovered and stop while editing, so typing stays comfortable.
+      form.addEventListener('pointerenter', () => { hovering = true; });
+      form.addEventListener('pointerleave', () => { hovering = false; });
+
+      function perspective(fovDeg, aspect, near, far) {
+        const f = 1 / Math.tan((fovDeg * Math.PI) / 360);
+        const nf = 1 / (near - far);
+        return new DOMMatrix([
+          f / aspect, 0, 0, 0,
+          0, f, 0, 0,
+          0, 0, (far + near) * nf, -1,
+          0, 0, 2 * far * near * nf, 0,
+        ]);
+      }
+
+      function draw(mesh, texture, mvp, rotation, lit) {
+        gl.bindVertexArray(mesh.vao);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniformMatrix4fv(uMVP, false, mvp.toFloat32Array());
+        gl.uniformMatrix4fv(uRotation, false, rotation.toFloat32Array());
+        gl.uniform1f(uLit, lit);
+        gl.drawElements(gl.TRIANGLES, mesh.count, gl.UNSIGNED_SHORT, 0);
+      }
+
+      function render() {
+        if (!canvas.width || !canvas.height) return;
+        const now = performance.now();
+        const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.1) : 0;
+        lastTime = now;
+        const editing = form.contains(document.activeElement);
+        const speed = reducedMotion.matches || editing ? 0 : hovering ? 8 : 30; // degrees per second
+        angle = (angle + speed * dt) % 360;
+
+        const rotation = new DOMMatrix().rotate(14, 0, 0).rotate(0, angle, 0);
+        const viewProjection = perspective(40, canvas.clientWidth / canvas.clientHeight, 0.1, 100)
+          .translate(0, 0, -CAM_DIST);
+        const formModel = rotation.translate(0, 0, D + 0.004).scale(FORM_W, FORM_H, 1);
+        const formMVP = viewProjection.multiply(formModel);
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+        gl.enable(gl.CULL_FACE);
+        gl.enable(gl.BLEND);
+        gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+        draw(boxMesh, boxTexture, viewProjection.multiply(rotation), rotation, 1);
+        if (!supportsHtmlInCanvas) return;
+
+        if (formUploaded) draw(quadMesh, formTexture, formMVP, rotation, 0.4);
+
+        // Only keep the form hit-testable while its face points towards the camera.
+        const normal = rotation.transformPoint(new DOMPoint(0, 0, 1));
+        const center = rotation.transformPoint(new DOMPoint(0, 0, D));
+        const facing = normal.x * -center.x + normal.y * -center.y + normal.z * (CAM_DIST - center.z) > 0.2;
+        if (facing) {
+          canvas.updateElementGeometry(form, { canvasTransform: computeCanvasTransform(form, formMVP) });
+          formHitTestable = true;
+        } else if (formHitTestable) {
+          canvas.clearElementGeometry(form);
+          formHitTestable = false;
+          if (editing) document.activeElement.blur();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = (event) => {
+          if (!formUploaded || event.changedElements?.length) {
+            try {
+              formUploaded = uploadForm() || formUploaded;
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+          render();
+        };
+      }
+
+      function tick() {
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+        else render();
+        frameId = requestAnimationFrame(tick);
+      }
+
+      function start() {
+        if (running) return;
+        running = true;
+        lastTime = 0;
+        frameId = requestAnimationFrame(tick);
+      }
+
+      function stop() {
+        running = false;
+        cancelAnimationFrame(frameId);
+      }
+
+      // Pause the render loop while the section is skipped (off-screen).
+      if ('contentVisibility' in document.documentElement.style) {
+        section.addEventListener('contentvisibilityautostatechange', (event) => {
+          event.skipped ? stop() : start();
+        });
+      } else {
+        new IntersectionObserver(([entry]) => {
+          entry.isIntersecting ? start() : stop();
+        }, { rootMargin: '200px' }).observe(section);
+      }
+      start();
+    })();
+  </script>
+
