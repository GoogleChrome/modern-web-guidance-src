+  <script>
+    const shots = document.getElementById('shots');
+    const shotsOutput = document.getElementById('shots-output');
+
+    function syncShots() {
+      const label = `${shots.value} shot${shots.value === '1' ? '' : 's'}`;
+      shotsOutput.value = label;
+      shots.setAttribute('aria-valuetext', label);
+      shots.style.setProperty('--attr-min', shots.min);
+      shots.style.setProperty('--attr-max', shots.max);
+      shots.style.setProperty('--control-value', shots.value);
+    }
+
+    syncShots();
+    shots.addEventListener('input', syncShots);
+
+    const pickupDate = document.getElementById('pickup-date');
+    const today = new Date();
+    const pad = (n) => String(n).padStart(2, '0');
+    pickupDate.min = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
+  </script>
