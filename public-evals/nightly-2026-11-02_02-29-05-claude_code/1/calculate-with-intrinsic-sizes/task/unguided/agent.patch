+    /* Promo Badge */
+    .promo-badge {
+      display: inline-block;
+      /* Fallback for browsers without calc-size() */
+      inline-size: max-content;
+      /* 1.2x the max-content size, clamped between 100px and the parent's width */
+      inline-size: calc-size(max-content, size * 1.2);
+      min-inline-size: 100px;
+      max-inline-size: 100%;
+      margin-block-end: 10px;
+      padding-block: 4px;
+      padding-inline: 12px;
+      background: var(--accent);
+      color: var(--text);
