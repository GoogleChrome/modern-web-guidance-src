+      border-radius: 999px;
+    }
+
+    /* Sourcing Accordion */
+    .accordion {
+      margin-block-start: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding-block: 18px;
+      padding-inline: 20px;
+      background: var(--primary);
+      color: white;
+      border: none;
+      font: inherit;
+      font-size: 1.2rem;
+      font-weight: bold;
+      text-align: start;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .accordion-icon {
+      transition: rotate 0.3s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      rotate: 45deg;
+    }
+
+    /*
+      Note: directly transitioning between different intrinsic keyword sizes
+      (e.g. auto -> max-content, or fit-content -> min-content) isn't supported.
+      interpolate-size / calc-size() only interpolate between a fixed <length-percentage>
+      (like 0) and a single intrinsic size, so one end of the transition must be a fixed length.
+    */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease;
+    }
+
+    .accordion-content.is-open {
+      /* Natural height plus 2rem of breathing room */
+      block-size: auto;
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    .accordion-inner {
+      padding-block: 20px 0;
+      padding-inline: 20px;
+    }
+
+    .accordion-inner p + p {
+      margin-block-start: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .accordion-content,
+      .accordion-icon {
+        transition: none;
+      }
+    }
+
