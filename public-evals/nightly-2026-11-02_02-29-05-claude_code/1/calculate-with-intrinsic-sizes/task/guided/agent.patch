@@ -134,8 +138,110 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Promo badge */
+    .promo-badge {
+      display: block;
+      margin-inline: auto;
+      margin-block-end: 10px;
+      padding: 4px 12px;
+      background: var(--accent);
+      color: var(--text);
+      border-radius: 999px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      text-align: center;
+      white-space: nowrap;
+      /* Fallback for browsers without calc-size() */
+      inline-size: max-content;
+      /* 1.2x the max-content size, clamped between 100px and the parent's inline size */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Our Sourcing accordion */
+    .accordion {
+      margin-block-start: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding: 16px 20px;
+      background: none;
+      border: none;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    #accordion-toggle::after {
+      content: "+";
+      font-size: 1.5rem;
+      line-height: 1;
+      transition: rotate 0.3s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::after {
+      rotate: 45deg;
+    }
+
+    /*
+      Note: directly transitioning between two different intrinsic keyword
+      sizes (e.g. min-content -> max-content, or auto -> fit-content) isn't
+      supported. One end of the transition must be a fixed length or
+      percentage, which is why the collapsed state uses block-size: 0.
+    */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      opacity: 0;
+      transition: block-size 0.4s ease, opacity 0.4s ease;
+    }
+
+    .accordion-content.is-open {
+      opacity: 1;
+      /* Fallback for browsers without calc-size() */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    .accordion-content p {
+      padding-inline: 20px;
+    }
+
+    .accordion-content p + p {
+      margin-block-start: 1rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      /* Skip the size animation; just fade the content in quickly */
+      .accordion-content {
+        transition: opacity 0.2s ease;
+      }
+
+      #accordion-toggle::after {
+        transition: none;
+      }
+    }
+
