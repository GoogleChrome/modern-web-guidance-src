+  <script>
+    const accordionToggle = document.getElementById('accordion-toggle');
+    const accordionContent = document.getElementById('sourcing-content');
+
+    accordionToggle.addEventListener('click', () => {
+      const isOpen = accordionToggle.getAttribute('aria-expanded') === 'true';
+      accordionToggle.setAttribute('aria-expanded', String(!isOpen));
+      accordionContent.classList.toggle('is-open', !isOpen);
+      // Keep collapsed content out of the tab order and accessibility tree
+      accordionContent.inert = isOpen;
+    });
+  </script>
