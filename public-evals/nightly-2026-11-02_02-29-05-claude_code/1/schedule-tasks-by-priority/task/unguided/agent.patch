+  <script>
+    (function () {
+      // Lower rank runs first.
+      const PRIORITIES = {
+        urgent: { rank: 0, label: 'Urgent' },
+        standard: { rank: 1, label: 'Standard' },
+        background: { rank: 2, label: 'Background' }
+      };
+
+      const TASK_TYPES = {
+        urgent: { name: 'Checkout', slices: 8, sliceMs: 6 },
+        standard: { name: 'Menu update', slices: 20, sliceMs: 8 },
+        background: { name: 'Telemetry log', slices: 60, sliceMs: 10 }
+      };
+
+      // Max time spent on task work before handing control back to the browser.
+      const FRAME_BUDGET_MS = 12;
+
+      const queueEl = document.getElementById('ops-queue');
+      const logEl = document.getElementById('ops-log');
+      const queuedCountEl = document.getElementById('ops-queued-count');
+      const doneCountEl = document.getElementById('ops-done-count');
+      const frameGapEl = document.getElementById('ops-frame-gap');
+      const heartbeatDot = document.getElementById('ops-heartbeat-dot');
+
+      const queue = [];
+      const counters = { urgent: 0, standard: 0, background: 0 };
+      let nextId = 1;
+      let doneCount = 0;
+      let pumping = false;
+
+      // Yield to the event loop so input, rendering and newly queued urgent
+      // tasks get a chance to run. Prefers the native Scheduler API.
+      const yieldToMain = (function () {
+        if (window.scheduler && typeof window.scheduler.yield === 'function') {
+          return function () { return window.scheduler.yield(); };
+        }
+        if (typeof MessageChannel === 'function') {
+          const channel = new MessageChannel();
+          const pending = [];
+          channel.port1.onmessage = function () { pending.shift()(); };
+          return function () {
+            return new Promise(function (resolve) {
+              pending.push(resolve);
+              channel.port2.postMessage(null);
+            });
+          };
+        }
+        return function () {
+          return new Promise(function (resolve) { setTimeout(resolve, 0); });
+        };
+      })();
+
+      // Simulates CPU-bound work by blocking the thread for `ms`.
+      function busyWork(ms) {
+        const end = performance.now() + ms;
+        while (performance.now() < end) { /* spin */ }
+      }
+
+      function enqueue(kind) {
+        const type = TASK_TYPES[kind];
+        counters[kind] += 1;
+        const task = {
+          id: nextId++,
+          kind: kind,
+          rank: PRIORITIES[kind].rank,
+          name: type.name + ' #' + counters[kind],
+          totalSlices: type.slices,
+          sliceMs: type.sliceMs,
+          done: 0,
+          queuedAt: performance.now(),
+          startedAt: null,
+          el: null
+        };
+        queue.push(task);
+        renderQueueItem(task);
+        sortQueue();
+        updateCounts();
+        pump();
+        return task;
+      }
+
+      // Stable sort: by priority, then FIFO within the same priority.
+      function sortQueue() {
+        queue.sort(function (a, b) { return a.rank - b.rank || a.id - b.id; });
+        queue.forEach(function (task) { queueEl.appendChild(task.el); });
+        syncEmptyState(queueEl, queue.length, 'Queue is idle');
+      }
+
+      async function pump() {
+        if (pumping) return;
+        pumping = true;
+        try {
+          while (queue.length) {
+            const sliceStart = performance.now();
+            // Work through slices until the frame budget is spent, always
+            // re-picking the highest priority task so urgent work preempts.
+            while (queue.length && performance.now() - sliceStart < FRAME_BUDGET_MS) {
+              const task = queue[0];
+              if (task.startedAt === null) task.startedAt = performance.now();
+              busyWork(task.sliceMs);
+              task.done += 1;
+              if (task.done >= task.totalSlices) {
+                queue.shift();
+                complete(task);
+              }
+            }
+            renderProgress();
+            await yieldToMain();
+          }
+        } finally {
+          pumping = false;
+          updateCounts();
+        }
+      }
+
+      function complete(task) {
+        doneCount += 1;
+        const finishedAt = performance.now();
+        task.el.remove();
+        updateCounts();
+        syncEmptyState(queueEl, queue.length, 'Queue is idle');
+
+        const li = document.createElement('li');
+        li.innerHTML =
+          '<div class="ops-row"><span>' +
+          '<span class="ops-badge ' + task.kind + '"></span><span class="ops-name"></span>' +
+          '</span><span class="ops-meta"></span></div>';
+        li.querySelector('.ops-badge').textContent = PRIORITIES[task.kind].label;
+        li.querySelector('.ops-name').textContent = task.name;
+        li.querySelector('.ops-meta').textContent =
+          'waited ' + Math.round(task.startedAt - task.queuedAt) + ' ms · ran ' +
+          Math.round(finishedAt - task.startedAt) + ' ms';
+        logEl.appendChild(li);
+        syncEmptyState(logEl, logEl.querySelectorAll('li:not(.ops-empty)').length, 'No tasks completed yet');
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      function renderQueueItem(task) {
+        const li = document.createElement('li');
+        li.innerHTML =
+          '<div class="ops-row"><span>' +
+          '<span class="ops-badge ' + task.kind + '"></span><span class="ops-name"></span>' +
+          '</span><span class="ops-meta"></span></div>' +
+          '<div class="ops-progress"><div></div></div>';
+        li.querySelector('.ops-badge').textContent = PRIORITIES[task.kind].label;
+        li.querySelector('.ops-name').textContent = task.name;
+        task.el = li;
+        updateItemProgress(task);
+      }
+
+      function updateItemProgress(task) {
+        const pct = Math.round((task.done / task.totalSlices) * 100);
+        task.el.querySelector('.ops-progress div').style.width = pct + '%';
+        task.el.querySelector('.ops-meta').textContent =
+          task.done === 0 ? 'waiting' : pct + '%';
+      }
+
+      function renderProgress() {
+        queue.forEach(updateItemProgress);
+      }
+
+      function updateCounts() {
+        queuedCountEl.textContent = queue.length;
+        doneCountEl.textContent = doneCount;
+      }
+
+      function syncEmptyState(listEl, count, message) {
+        const empty = listEl.querySelector('.ops-empty');
+        if (count === 0 && !empty) {
+          const li = document.createElement('li');
+          li.className = 'ops-empty';
+          li.textContent = message;
+          listEl.appendChild(li);
+        } else if (count > 0 && empty) {
+          empty.remove();
+        }
+      }
+
+      // Mixed batch, submitted out of order on purpose: the scheduler runs
+      // it urgent → standard → background regardless of submission order.
+      function runBatch() {
+        ['background', 'standard', 'urgent', 'background', 'standard', 'urgent', 'background']
+          .forEach(enqueue);
+      }
+
+      document.querySelectorAll('[data-ops-kind]').forEach(function (btn) {
+        btn.addEventListener('click', function () { enqueue(btn.dataset.opsKind); });
+      });
+      document.getElementById('ops-batch').addEventListener('click', runBatch);
+      document.getElementById('ops-clear').addEventListener('click', function () {
+        logEl.innerHTML = '';
+        doneCount = 0;
+        longestGap = 0;
+        frameGapEl.textContent = '0 ms';
+        updateCounts();
+        syncEmptyState(logEl, 0, 'No tasks completed yet');
+      });
+
+      // Responsiveness monitor: a rAF-driven heartbeat and longest frame gap.
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      let lastFrame = performance.now();
+      let longestGap = 0;
+      let pos = 0;
+      function heartbeat(now) {
+        const gap = now - lastFrame;
+        lastFrame = now;
+        if (gap > longestGap) {
+          longestGap = gap;
+          frameGapEl.textContent = Math.round(gap) + ' ms';
+        }
+        if (!reduceMotion) {
+          pos = (pos + gap * 0.12) % 160;
+          heartbeatDot.style.transform = 'translateX(' + (pos - 30) + 'px)';
+        }
+        requestAnimationFrame(heartbeat);
+      }
+      requestAnimationFrame(heartbeat);
+      // Ignore the gap caused by the tab being hidden.
+      document.addEventListener('visibilitychange', function () { lastFrame = performance.now(); });
+
+      syncEmptyState(queueEl, 0, 'Queue is idle');
+      syncEmptyState(logEl, 0, 'No tasks completed yet');
+    })();
+  </script>
+
 </body>
 
