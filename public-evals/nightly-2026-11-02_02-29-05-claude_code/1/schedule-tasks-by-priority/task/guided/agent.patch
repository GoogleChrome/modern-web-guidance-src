+  <script>
+    (() => {
+      const TASKS = {
+        checkout: { label: 'Checkout', priority: 'user-blocking', units: 40 },
+        menu: { label: 'Menu update', priority: 'user-visible', units: 80 },
+        telemetry: { label: 'Telemetry log', priority: 'background', units: 120 }
+      };
+      // Submitted deliberately out of priority order; the scheduler sorts it out.
+      const BATCH = ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout', 'telemetry'];
+
+      const section = document.querySelector('.ops-queue');
+      const log = section.querySelector('.ops-log');
+      const pendingOut = section.querySelector('#ops-pending');
+      const pingsOut = section.querySelector('#ops-pings');
+      let pending = 0;
+      let seq = 0;
+      let pings = 0;
+
+      function yieldToMain() {
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          return scheduler.yield();
+        }
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      // Simulated heavy work: roughly 1ms of busy CPU per unit.
+      function crunch() {
+        const end = performance.now() + 1;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(Math.random());
+        return x;
+      }
+
+      function addLog(task, message) {
+        const li = document.createElement('li');
+        const tag = document.createElement('span');
+        tag.className = 'ops-tag';
+        tag.dataset.priority = task.priority;
+        tag.textContent = `[${task.priority}]`;
+        li.append(tag, message);
+        log.append(li);
+        log.scrollTop = log.scrollHeight;
+      }
+
+      function setPending(delta) {
+        pending += delta;
+        pendingOut.value = pending;
+      }
+
+      async function runTask(task) {
+        const start = performance.now();
+        let deadline = start + 50;
+        for (let i = 0; i < task.units; i++) {
+          crunch();
+          if (performance.now() >= deadline) {
+            await yieldToMain();
+            deadline = performance.now() + 50;
+          }
+        }
+        return Math.round(performance.now() - start);
+      }
+
+      function enqueue(key) {
+        const task = TASKS[key];
+        const id = ++seq;
+        const queuedAt = performance.now();
+        setPending(1);
+        addLog(task, `#${id} ${task.label} queued`);
+        scheduler.postTask(async () => {
+          const waited = Math.round(performance.now() - queuedAt);
+          addLog(task, `#${id} ${task.label} started (waited ${waited}ms)`);
+          const took = await runTask(task);
+          addLog(task, `#${id} ${task.label} done in ${took}ms`);
+        }, { priority: task.priority })
+          .catch(err => addLog(task, `#${id} ${task.label} failed: ${err.message}`))
+          .finally(() => setPending(-1));
+      }
+
+      function init() {
+        section.querySelectorAll('[data-task]').forEach(btn => {
+          btn.disabled = false;
+          btn.addEventListener('click', () => enqueue(btn.dataset.task));
+        });
+        const batchBtn = section.querySelector('.ops-batch');
+        batchBtn.disabled = false;
+        batchBtn.addEventListener('click', () => BATCH.forEach(enqueue));
+      }
+
+      section.querySelector('.ops-ping').addEventListener('click', () => {
+        pingsOut.value = ++pings;
+      });
+      section.querySelector('#ops-clear').addEventListener('click', () => {
+        log.replaceChildren();
+      });
+
+      if ('scheduler' in window && 'postTask' in window.scheduler) {
+        init();
+      } else {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = init;
+        script.onerror = () => {
+          // Minimal priority-ordered stand-in if the polyfill cannot load.
+          const order = ['user-blocking', 'user-visible', 'background'];
+          const queue = [];
+          let scheduled = false;
+          const drain = () => {
+            scheduled = false;
+            const next = queue.shift();
+            if (!next) return;
+            Promise.resolve().then(next.cb).then(next.resolve, next.reject)
+              .finally(() => { if (queue.length && !scheduled) { scheduled = true; setTimeout(drain, 0); } });
+          };
+          window.scheduler = Object.assign(window.scheduler || {}, {
+            postTask(cb, { priority = 'user-visible' } = {}) {
+              return new Promise((resolve, reject) => {
+                const rank = order.indexOf(priority);
+                const idx = queue.findIndex(t => t.rank > rank);
+                const entry = { cb, rank, resolve, reject };
+                idx === -1 ? queue.push(entry) : queue.splice(idx, 0, entry);
+                if (!scheduled) { scheduled = true; setTimeout(drain, 0); }
+              });
+            }
+          });
+          init();
+        };
+        document.head.append(script);
+      }
+    })();
+  </script>
+
