+  <script type="module">
+    import 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const button = form.querySelector('[data-testid="signin-button"]');
+      button.disabled = true;
+      status.textContent = '';
+
+      try {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({
+            username: form.username.value,
+            password: form.password.value,
+          }),
+        });
+        if (!response.ok) {
+          status.textContent = 'Sign-in failed. Please check your credentials.';
+          return;
+        }
+        status.textContent = 'Signed in. Welcome back!';
+        form.reset();
+        // Fire and forget: passkey promotion must never affect the sign-in UI.
+        promotePasskey();
+      } catch {
+        status.textContent = 'Sign-in failed. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    // Silently register a passkey after a successful password sign-in.
+    async function promotePasskey() {
+      try {
+        if (!window.PublicKeyCredential?.getClientCapabilities) return;
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ conditional: true }),
+        });
+        if (!optionsResponse.ok) return;
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+        let credential;
+        try {
+          credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+        } catch (e) {
+          if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+            console.error('Unexpected conditional create error:', e);
+          }
+          return;
+        }
+        if (!credential) return;
+
+        const encoded = credential.toJSON();
+        let verified = false;
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'same-origin',
+            body: JSON.stringify(encoded),
+          });
+          verified = verifyResponse.ok;
+        } catch (e) {
+          console.error('Passkey verification network failure:', e);
+        }
+
+        // Drop the orphaned credential from the passkey provider if the server rejected it.
+        if (!verified && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id ?? location.hostname,
+            credentialId: encoded.id,
+          });
+        }
+      } catch (e) {
+        console.error('Passkey promotion failed:', e);
+      }
+    }
+  </script>
+
