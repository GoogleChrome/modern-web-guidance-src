+  <script>
+    document.querySelectorAll('.reviews-wrapper').forEach(function (wrapper) {
+      var scroller = wrapper.querySelector('.reviews-scroll');
+      var top = wrapper.querySelector('.indicator-top');
+      var bottom = wrapper.querySelector('.indicator-bottom');
+
+      function update() {
+        var maxScroll = scroller.scrollHeight - scroller.clientHeight;
+        top.classList.toggle('visible', scroller.scrollTop > 1);
+        bottom.classList.toggle('visible', scroller.scrollTop < maxScroll - 1);
+      }
+
+      scroller.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      if ('ResizeObserver' in window) new ResizeObserver(update).observe(scroller);
+      update();
+    });
+  </script>
