diff --git a/src/components/Surface.astro b/src/components/Surface.astro
new file mode 100644
index 0000000..83c47d0
--- /dev/null
+++ b/src/components/Surface.astro
@@ -0,0 +1,16 @@
+---
+import type { HTMLTag, Polymorphic } from 'astro/types';
+
+/**
+ * Marks a region of the page with a semantic context. Components placed
+ * inside react to it on their own via the `featured:` / `compact:` variants
+ * (CSS container style queries on `--surface`), so neither side needs to
+ * know about the other.
+ */
+type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> & {
+    kind: 'featured' | 'compact';
+};
+
+const { as: Tag = 'div', kind, ...rest } = Astro.props;
+---
+<Tag data-surface={kind} {...rest}><slot /></Tag>
