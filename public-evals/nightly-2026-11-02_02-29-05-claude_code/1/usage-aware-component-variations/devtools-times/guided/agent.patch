+
+/*
+ * Semantic surfaces: a layout container declares what kind of context it is,
+ * descendants decide for themselves how to adapt to it.
+ */
+[data-surface="featured"] { --surface: featured; }
+[data-surface="compact"] { --surface: compact; }
+
+/*
+ * Container style queries are Baseline Newly available (May 2026), so the
+ * attribute selector stays as a fallback. `:where()` keeps it at the same
+ * specificity, letting the style query win wherever it is supported.
+ * Avoid nesting different surfaces while the fallback is in place: the
+ * descendant selector can't tell which surface is nearest.
+ * Drop the `:where()` branch once style queries are widely available.
+ */
+@custom-variant featured {
+  :where([data-surface="featured"]) & { @slot; }
+  @container style(--surface: featured) { @slot; }
+}
+
+@custom-variant compact {
+  :where([data-surface="compact"]) & { @slot; }
+  @container style(--surface: compact) { @slot; }
+}
