+import type { CollectionEntry } from 'astro:content';
+
+// Editorial "desks" group free-form categories into a small set of semantic
+// buckets. Components never branch on raw category strings; they read the
+// desk/tone/format and let CSS (see global.css) pick the visual treatment.
+export type Desk =
+    | 'news'
+    | 'politics'
+    | 'business'
+    | 'science'
+    | 'sports'
+    | 'culture'
+    | 'lifestyle'
+    | 'media';
+
+// "sombre" stories (crime, death, violence) get a restrained treatment:
+// desaturated imagery, neutral accents and no playful hover colours.
+export type Tone = 'standard' | 'sombre';
+
+export type Format = 'quick' | 'standard' | 'long';
+
+export interface ArticleContext {
+    desk: Desk;
+    tone: Tone;
+    format: Format;
+    categoryLabel: string;
+    categoryHref: string;
+    formatLabel: string;
+}
+
+const categoryToDesk: Record<string, Desk> = {
+    'news': 'news',
+    'national': 'news',
+    'world': 'news',
+    'politics': 'politics',
+    'urban development': 'politics',
+    'business': 'business',
+    'economy': 'business',
+    'labor': 'business',
+    'science': 'science',
+    'sports': 'sports',
+    'culture': 'culture',
+    'arts': 'culture',
+    'lifestyle': 'lifestyle',
+    'pets': 'lifestyle',
+    'media': 'media',
+    'web development': 'media',
+};
+
+// Used when the category itself is unknown: the first tag with a known desk wins.
+const tagToDesk: Record<string, Desk> = {
+    ...categoryToDesk,
+    'infrastructure': 'news',
+    'activism': 'politics',
+    'manufacturing': 'business',
+    'jobs': 'business',
+    'technology': 'media',
+    'journalism': 'media',
+    'music': 'culture',
+    'theater': 'culture',
+    'dance': 'culture',
+    'festivals': 'culture',
+};
+
+const sombreKeywords = [
+    'crime', 'criminal', 'killer', 'murder', 'death', 'forensic',
+    'violence', 'victim', 'investigation', 'tragedy',
+];
+
+export function deskForCategory(category: string): Desk | undefined {
+    return categoryToDesk[category.trim().toLowerCase()];
+}
+
+export function capitalize(value: string) {
+    return value.charAt(0).toUpperCase() + value.slice(1);
+}
+
+function resolveDesk(category: string, tags: string[] = []): Desk {
+    const fromCategory = deskForCategory(category);
+    if (fromCategory) return fromCategory;
+    for (const tag of tags) {
+        const fromTag = tagToDesk[tag.toLowerCase()];
+        if (fromTag) return fromTag;
+    }
+    return 'news';
+}
+
+function resolveTone(data: CollectionEntry<'articles'>['data']): Tone {
+    const haystack = [data.title, data.summary, ...(data.tags ?? [])].join(' ').toLowerCase();
+    return sombreKeywords.some(keyword => haystack.includes(keyword)) ? 'sombre' : 'standard';
+}
+
+function resolveFormat(readingTime?: number): Format {
+    if (readingTime === undefined) return 'standard';
+    if (readingTime <= 3) return 'quick';
+    if (readingTime >= 8) return 'long';
+    return 'standard';
+}
+
+const formatLabels: Record<Format, (minutes?: number) => string> = {
+    quick: minutes => `Quick read · ${minutes} Min.`,
+    standard: minutes => `${minutes} Min.`,
+    long: minutes => `Long read · ${minutes} Min.`,
+};
+
+export function getArticleContext(article: CollectionEntry<'articles'>): ArticleContext {
+    const { data } = article;
+    const format = resolveFormat(data.readingTime);
+    return {
+        desk: resolveDesk(data.category, data.tags),
+        tone: resolveTone(data),
+        format,
+        categoryLabel: capitalize(data.category),
+        categoryHref: `${import.meta.env.BASE_URL}category/${data.category.toLowerCase()}`,
+        formatLabel: formatLabels[format](data.readingTime),
+    };
+}
+
+// Spread onto a wrapping element so descendants inherit the desk's CSS variables.
+export function contextAttributes(context: Pick<ArticleContext, 'desk' | 'tone' | 'format'>) {
+    return {
+        'data-desk': context.desk,
+        'data-tone': context.tone,
+        'data-format': context.format,
+    };
+}
+
+// True when the surrounding section already names the article's category,
+// e.g. a "Sports" teaser on the sports category page. Repeating the kicker
+// there is noise, so teasers swap it for a more informative label.
+export function isRedundantCategory(article: CollectionEntry<'articles'>, sectionCategory?: string) {
+    if (!sectionCategory) return false;
+    return article.data.category.toLowerCase() === sectionCategory.toLowerCase();
+}
