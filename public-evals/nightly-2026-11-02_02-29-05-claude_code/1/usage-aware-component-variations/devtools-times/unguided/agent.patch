+}
+/*
+ * Semantic context theming.
+ * Components set data-desk / data-tone / data-format (see utils/semantics.ts)
+ * and consume the resulting custom properties, e.g. text-(--desk-accent).
+ */
+:root,
+[data-desk] {
+  --desk-accent: var(--color-amber-800);
+  --desk-hover: var(--color-amber-500);
+  --desk-surface: var(--color-amber-50);
+  --desk-image-filter: none;
+}
+
+[data-desk="news"] {
+  --desk-accent: var(--color-red-700);
+  --desk-hover: var(--color-red-600);
+  --desk-surface: var(--color-red-50);
+}
+[data-desk="politics"] {
+  --desk-accent: var(--color-indigo-700);
+  --desk-hover: var(--color-indigo-500);
+  --desk-surface: var(--color-indigo-50);
+}
+[data-desk="business"] {
+  --desk-accent: var(--color-emerald-700);
+  --desk-hover: var(--color-emerald-600);
+  --desk-surface: var(--color-emerald-50);
+}
+[data-desk="science"] {
+  --desk-accent: var(--color-cyan-700);
+  --desk-hover: var(--color-cyan-600);
+  --desk-surface: var(--color-cyan-50);
+}
+[data-desk="sports"] {
+  --desk-accent: var(--color-orange-700);
+  --desk-hover: var(--color-orange-500);
+  --desk-surface: var(--color-orange-50);
+}
+[data-desk="culture"] {
+  --desk-accent: var(--color-fuchsia-700);
+  --desk-hover: var(--color-fuchsia-500);
+  --desk-surface: var(--color-fuchsia-50);
+}
+[data-desk="lifestyle"] {
+  --desk-accent: var(--color-amber-800);
+  --desk-hover: var(--color-amber-500);
+  --desk-surface: var(--color-amber-50);
+}
+[data-desk="media"] {
+  --desk-accent: var(--color-violet-700);
+  --desk-hover: var(--color-violet-500);
+  --desk-surface: var(--color-violet-50);
+}
+
+/* Sombre stories override whichever desk they belong to. */
+[data-tone="sombre"] {
+  --desk-accent: var(--color-gray-700);
+  --desk-hover: var(--color-gray-500);
+  --desk-surface: var(--color-gray-100);
+  --desk-image-filter: grayscale(0.7) contrast(1.05);
+}
+
+.desk-image {
+  filter: var(--desk-image-filter);
+  transition: filter 300ms ease;
+}
+
+[data-tone="sombre"] .desk-icon {
+  display: none;
+}
+
+/* Long reads highlight their reading-time label to signal depth. */
+[data-format="long"] .desk-format {
+  color: var(--desk-accent);
+  font-weight: 600;
+}
