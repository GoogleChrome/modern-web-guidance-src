+const { context, label = context.categoryLabel, href = context.categoryHref, class: className = '' } = Astro.props;
+const Icon = deskIcons[context.desk];
+---
+<a
+    href={href}
+    class:list={['inline-flex items-center gap-1 text-sm font-brand tracking-widest text-(--desk-accent) hover:underline', className]}
+>
+    <Icon className="desk-icon w-4 h-4 -mt-px" aria-hidden="true" />
+    {label}
+</a>
