+    label?: string;
+    href?: string;
+    class?: string;
+}
+
+const deskIcons: Record<Desk, typeof NewspaperIcon> = {
+    news: NewspaperIcon,
+    politics: BuildingLibraryIcon,
+    business: ChartBarIcon,
+    science: BeakerIcon,
+    sports: TrophyIcon,
+    culture: TicketIcon,
+    lifestyle: SunIcon,
+    media: TvIcon,
+};
