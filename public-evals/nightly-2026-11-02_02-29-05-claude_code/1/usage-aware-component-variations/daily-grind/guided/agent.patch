+    /* Contextual card variations: sections declare a semantic --surface,
+       cards opt in to reacting to it. */
+    .seasonal {
+      --surface: seasonal;
+    }
+
+    .card-badge {
+      display: none;
+    }
+
+    /* Fallback for browsers without container style queries */
+    :where(.seasonal) .card {
+      position: relative;
+      background: linear-gradient(160deg, #fff8ef, #fbe9d7);
+      border-top: 4px solid var(--accent);
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.15);
+    }
+
+    :where(.seasonal) .card-badge {
+      display: inline-block;
+    }
+
+    :where(.seasonal) .card .btn {
