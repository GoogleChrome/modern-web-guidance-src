index 0000000..d67aad7
--- /dev/null
+++ b/lib/evp-verify.js
@@ -0,0 +1,301 @@
+// Verifies Email Verification Protocol (EVP) presentation tokens.
+//
+// Spec: https://github.com/WICG/email-verification-protocol
+//       https://datatracker.ietf.org/doc/draft-hardt-email-verification/
+//
+// A presentation token is `<EVT>~<KB-JWT>`:
+//   - EVT: a JWT signed by the email domain's issuer asserting `email` +
+//     `email_verified`, bound to a browser-generated key via `cnf.jwk`.
+//   - KB-JWT: signed by the browser with that key, binding the EVT to our
+//     origin (`aud`), our server-issued `nonce`, and the EVT itself (`sd_hash`).
+//
+// The issuer for an email domain is discovered through a DNS TXT record at
+// `_email-verification.<domain>` (`iss=<issuer host>`), and its signing keys
+// are published at the `jwks_uri` advertised in
+// `https://<issuer host>/.well-known/email-verification`.
+
+import crypto from 'node:crypto';
+import dns from 'node:dns/promises';
+import net from 'node:net';
+
+const EVT_TYPES = new Set(['evt+jwt', 'evp+sd-jwt', 'evp-sd-jwt']);
+const KB_TYPE = 'kb+jwt';
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const MAX_FETCH_BYTES = 64 * 1024;
+const FETCH_TIMEOUT_MS = 5000;
+const CACHE_TTL_MS = 10 * 60 * 1000;
+const CLOCK_SKEW_S = 60;
+const MAX_TOKEN_AGE_S = 5 * 60;
+
+export class EvpError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.name = 'EvpError';
+    this.code = code;
+  }
+}
+
+const fail = (code, message) => {
+  throw new EvpError(code, message);
+};
+
+// --- JOSE helpers -----------------------------------------------------------
+
+const b64urlDecode = (s) => {
+  if (typeof s !== 'string' || !/^[A-Za-z0-9_-]*$/.test(s)) fail('malformed', 'Invalid base64url segment');
+  return Buffer.from(s, 'base64url');
+};
+
+const b64urlJson = (s) => {
+  try {
+    const value = JSON.parse(b64urlDecode(s).toString('utf8'));
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error();
+    return value;
+  } catch (err) {
+    if (err instanceof EvpError) throw err;
+    return fail('malformed', 'Invalid JWT JSON segment');
+  }
+};
+
+function parseJwt(jwt) {
+  const parts = jwt.split('.');
+  if (parts.length !== 3 || parts.some((p) => p.length === 0)) fail('malformed', 'JWT must have three segments');
+  return {
+    header: b64urlJson(parts[0]),
+    payload: b64urlJson(parts[1]),
+    signingInput: Buffer.from(`${parts[0]}.${parts[1]}`, 'ascii'),
+    signature: b64urlDecode(parts[2]),
+  };
+}
+
+// Only asymmetric, explicitly-specified algorithms. `none` and HMAC are never
+// accepted. `EdDSA` is accepted for compatibility with earlier drafts but only
+// with an Ed25519 key.
+const ALGORITHMS = {
+  Ed25519: { kty: 'OKP', crv: 'Ed25519', hash: null },
+  EdDSA: { kty: 'OKP', crv: 'Ed25519', hash: null },
+  ES256: { kty: 'EC', crv: 'P-256', hash: 'sha256', ec: true },
+  ES384: { kty: 'EC', crv: 'P-384', hash: 'sha384', ec: true },
+  RS256: { kty: 'RSA', hash: 'sha256' },
+  PS256: { kty: 'RSA', hash: 'sha256', pss: true },
+};
+
+function importPublicJwk(jwk, alg) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) fail('bad_alg', `Unsupported signing algorithm: ${String(alg)}`);
+  if (!jwk || typeof jwk !== 'object') fail('bad_key', 'Missing JWK');
+  if (jwk.d !== undefined || jwk.k !== undefined) fail('bad_key', 'JWK must be a public key');
+  if (jwk.kty !== spec.kty || (spec.crv && jwk.crv !== spec.crv)) fail('bad_key', `Key type does not match ${alg}`);
+  if (jwk.alg !== undefined && jwk.alg !== alg) fail('bad_key', 'Key alg does not match token alg');
+  try {
+    const { kty, crv, x, y, n, e } = jwk;
+    return crypto.createPublicKey({ key: { kty, crv, x, y, n, e }, format: 'jwk' });
+  } catch {
+    return fail('bad_key', 'Unable to import JWK');
+  }
+}
+
+function verifySignature(jwt, key, alg) {
+  const spec = ALGORITHMS[alg];
+  const options = { key };
+  if (spec.ec) options.dsaEncoding = 'ieee-p1363';
+  if (spec.pss) {
+    options.padding = crypto.constants.RSA_PKCS1_PSS_PADDING;
+    options.saltLength = 32;
+  }
+  let ok = false;
+  try {
+    ok = crypto.verify(spec.hash, jwt.signingInput, options, jwt.signature);
+  } catch {
+    ok = false;
+  }
+  if (!ok) fail('bad_signature', 'Signature verification failed');
+}
+
+const nowSeconds = () => Math.floor(Date.now() / 1000);
+
+function checkIat(iat, now, label) {
+  if (!Number.isInteger(iat)) fail('bad_claims', `${label} iat is missing`);
+  if (iat > now + CLOCK_SKEW_S) fail('expired', `${label} was issued in the future`);
+  if (iat < now - MAX_TOKEN_AGE_S) fail('expired', `${label} is too old`);
+}
+
+function timingSafeEqualStr(a, b) {
+  const ab = Buffer.from(String(a));
+  const bb = Buffer.from(String(b));
+  return ab.length === bb.length && crypto.timingSafeEqual(ab, bb);
+}
+
+// --- Issuer discovery -------------------------------------------------------
+
+const HOSTNAME_RE = /^(?=.{1,253}$)(?!-)[a-z0-9-]{1,63}(?<!-)(\.(?!-)[a-z0-9-]{1,63}(?<!-))+$/;
+
+export function emailDomain(email) {
+  const at = typeof email === 'string' ? email.lastIndexOf('@') : -1;
+  if (at < 1) fail('bad_email', 'Invalid email address');
+  const domain = email.slice(at + 1).toLowerCase();
+  if (!HOSTNAME_RE.test(domain)) fail('bad_email', 'Invalid email domain');
+  return domain;
+}
+
+function isPublicAddress(ip) {
+  if (net.isIPv4(ip)) {
+    const [a, b] = ip.split('.').map(Number);
+    return !(
+      a === 0 || a === 10 || a === 127 || a >= 224 ||
+      (a === 100 && b >= 64 && b <= 127) ||
+      (a === 169 && b === 254) ||
+      (a === 172 && b >= 16 && b <= 31) ||
+      (a === 192 && b === 168) ||
+      (a === 198 && (b === 18 || b === 19))
+    );
+  }
+  if (net.isIPv6(ip)) {
+    const lower = ip.toLowerCase();
+    const mapped = lower.match(/^::ffff:(\d+\.\d+\.\d+\.\d+)$/);
+    if (mapped) return isPublicAddress(mapped[1]);
+    return !(
+      lower === '::' || lower === '::1' ||
+      /^f[cd]/.test(lower) || /^fe[89ab]/.test(lower) || /^ff/.test(lower)
+    );
+  }
+  return false;
+}
+
+// Default network implementations; overridable for tests.
+const defaultResolveTxt = (name) => dns.resolveTxt(name);
+
+async function defaultFetchJson(url) {
+  const { hostname, protocol } = new URL(url);
+  if (protocol !== 'https:') fail('discovery', 'Issuer URLs must use https');
+  // Guard against DNS records pointing us at internal infrastructure (SSRF).
+  const addrs = await dns.lookup(hostname, { all: true }).catch(() => []);
+  if (addrs.length === 0 || !addrs.every((a) => isPublicAddress(a.address))) {
+    fail('discovery', 'Issuer host does not resolve to a public address');
+  }
+  let res;
+  try {
+    res = await fetch(url, {
+      redirect: 'error',
+      headers: { accept: 'application/json' },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+  } catch {
+    fail('discovery', `Unable to fetch ${url}`);
+  }
+  if (!res.ok) fail('discovery', `Fetching ${url} returned HTTP ${res.status}`);
+  const declared = Number(res.headers.get('content-length') || 0);
+  if (declared > MAX_FETCH_BYTES) fail('discovery', 'Issuer response too large');
+  const body = await res.text();
+  if (body.length > MAX_FETCH_BYTES) fail('discovery', 'Issuer response too large');
+  try {
+    return JSON.parse(body);
+  } catch {
+    return fail('discovery', `Invalid JSON from ${url}`);
+  }
+}
+
+export function createVerifier({
+  origin,
+  resolveTxt = defaultResolveTxt,
+  fetchJson = defaultFetchJson,
+  now = nowSeconds,
+} = {}) {
+  if (!origin) throw new Error('createVerifier requires the relying party origin');
+  const cache = new Map();
+
+  const cached = async (key, load) => {
+    const hit = cache.get(key);
+    if (hit && hit.expires > Date.now()) return hit.value;
+    const value = await load();
+    cache.set(key, { value, expires: Date.now() + CACHE_TTL_MS });
+    return value;
+  };
+
+  async function discoverIssuer(domain) {
+    let records;
+    try {
+      records = await resolveTxt(`_email-verification.${domain}`);
+    } catch {
+      fail('unsupported_domain', `${domain} does not support browser email verification`);
+    }
+    const issRecords = records.map((chunks) => chunks.join('')).filter((r) => r.startsWith('iss='));
+    if (issRecords.length !== 1) fail('unsupported_domain', `${domain} does not have exactly one EVP issuer record`);
+    const host = issRecords[0].slice(4).trim();
+    if (!HOSTNAME_RE.test(host)) fail('discovery', 'Issuer record is not a valid host name');
+    return `https://${host}`;
+  }
+
+  async function issuerKeys(issuer) {
+    return cached(`keys:${issuer}`, async () => {
+      const metadata = await fetchJson(`${issuer}/.well-known/email-verification`);
+      if (!metadata || metadata.issuer !== issuer) fail('discovery', 'Issuer metadata does not match issuer');
+      if (typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+        fail('discovery', 'Issuer metadata has no https jwks_uri');
+      }
+      const jwks = await fetchJson(metadata.jwks_uri);
+      if (!jwks || !Array.isArray(jwks.keys)) fail('discovery', 'Issuer JWKS is malformed');
+      return jwks.keys;
+    });
+  }
+
+  // Returns `{ email, issuer, isPrivateEmail }` on success; throws EvpError.
+  async function verify(token, { nonce, email: expectedEmail }) {
+    if (typeof token !== 'string' || token.length === 0) fail('missing_token', 'No verification token was provided');
+    if (token.length > MAX_TOKEN_LENGTH) fail('malformed', 'Token too large');
+    if (!nonce) fail('bad_nonce', 'No active verification nonce');
+
+    // 1. Split `<EVT>~<KB-JWT>`. Selective disclosures are not used by EVP.
+    const parts = token.split('~');
+    if (parts.length !== 2) fail('malformed', 'Token must be <EVT>~<KB-JWT>');
+    const [evtJwt, kbJwt] = parts;
+    const evt = parseJwt(evtJwt);
+    const kb = parseJwt(kbJwt);
+    const t = now();
+
+    // 2. KB-JWT claims (signature is checked once we trust cnf.jwk).
+    if (kb.header.typ !== KB_TYPE) fail('malformed', 'KB-JWT typ must be kb+jwt');
+    if (kb.payload.aud !== origin) fail('bad_audience', 'Token was not issued for this site');
+    if (typeof kb.payload.nonce !== 'string' || !timingSafeEqualStr(kb.payload.nonce, nonce)) {
+      fail('bad_nonce', 'Token nonce does not match this session');
+    }
+    checkIat(kb.payload.iat, t, 'KB-JWT');
+    const sdHash = crypto.createHash('sha256').update(`${evtJwt}~`, 'ascii').digest('base64url');
+    if (!timingSafeEqualStr(kb.payload.sd_hash, sdHash)) fail('bad_binding', 'KB-JWT is not bound to this EVT');
+
+    // 3. EVT header and claims.
+    if (!EVT_TYPES.has(evt.header.typ)) fail('malformed', 'Unexpected EVT typ');
+    if (!ALGORITHMS[evt.header.alg]) fail('bad_alg', 'Unsupported EVT algorithm');
+    if (typeof evt.header.kid !== 'string' || !evt.header.kid) fail('malformed', 'EVT kid is missing');
+    const { iss, email, email_verified: emailVerified, cnf } = evt.payload;
+    if (typeof iss !== 'string' || typeof email !== 'string') fail('bad_claims', 'EVT iss/email missing');
+    if (emailVerified !== true) fail('unverified', 'Issuer did not verify this email');
+    if (!cnf || typeof cnf.jwk !== 'object') fail('bad_claims', 'EVT cnf.jwk missing');
+    checkIat(evt.payload.iat, t, 'EVT');
+
+    if (expectedEmail !== undefined && email.toLowerCase() !== String(expectedEmail).trim().toLowerCase()) {
+      fail('email_mismatch', 'Verified email does not match the email entered');
+    }
+
+    // 4. Issuer must be the one the email domain delegates to via DNS.
+    const issuer = await discoverIssuer(emailDomain(email));
+    if (iss !== issuer) fail('bad_issuer', 'EVT issuer is not authoritative for this email domain');
+
+    // 5. EVT signature with the issuer's published key.
+    const keys = await issuerKeys(issuer);
+    const jwk = keys.find((k) => k && k.kid === evt.header.kid);
+    if (!jwk) fail('bad_key', 'Issuer signing key not found');
+    if (jwk.use !== undefined && jwk.use !== 'sig') fail('bad_key', 'Issuer key is not a signing key');
+    verifySignature(evt, importPublicJwk(jwk, evt.header.alg), evt.header.alg);
+
+    // 6. KB-JWT signature with the browser key the issuer bound into the EVT.
+    if (cnf.jwk.alg !== undefined && kb.header.alg !== cnf.jwk.alg) fail('bad_alg', 'KB-JWT alg does not match cnf key');
+    verifySignature(kb, importPublicJwk(cnf.jwk, kb.header.alg), kb.header.alg);
+
+    return { email, issuer, isPrivateEmail: evt.payload.is_private_email === true };
+  }
+
+  return { verify };
+}
+
+export const _internal = { isPublicAddress };
