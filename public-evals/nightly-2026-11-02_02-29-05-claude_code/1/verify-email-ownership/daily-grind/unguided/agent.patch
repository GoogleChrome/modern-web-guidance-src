@@ -0,0 +1,269 @@
+// The Daily Grind web server.
+//
+//   GET  /                     Homepage, with a fresh EVP nonce bound to the session
+//   POST /api/rewards/signup   Create a rewards account after verifying the
+//                              browser-supplied email verification token
+//
+// Configuration (env):
+//   PORT       Port to listen on (default 11222)
+//   RP_ORIGIN  Public origin of the site, e.g. https://dailygrind.example.
+//              Tokens are only accepted if bound to this exact origin.
+
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createVerifier, EvpError } from './lib/evp-verify.js';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+const RP_ORIGIN = (process.env.RP_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const DATA_FILE = path.join(ROOT, 'data', 'accounts.json');
+const SESSION_COOKIE = 'dg_evp';
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const MAX_BODY_BYTES = 32 * 1024;
+
+const verifier = createVerifier({ origin: RP_ORIGIN });
+
+// --- Sessions / nonces ------------------------------------------------------
+// sessionId -> { nonce, expires }. Nonces are single-use: any sign-up attempt
+// consumes the current one and a new nonce is handed back to the page.
+
+const sessions = new Map();
+
+function issueNonce(sessionId) {
+  const nonce = crypto.randomBytes(32).toString('base64url');
+  sessions.set(sessionId, { nonce, expires: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+function consumeNonce(sessionId) {
+  const entry = sessions.get(sessionId);
+  sessions.delete(sessionId);
+  return entry && entry.expires > Date.now() ? entry.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, entry] of sessions) if (entry.expires <= now) sessions.delete(id);
+}, 60 * 1000).unref();
+
+function getSessionId(req) {
+  const match = (req.headers.cookie || '').match(new RegExp(`(?:^|;\\s*)${SESSION_COOKIE}=([A-Za-z0-9_-]{43})`));
+  return match ? match[1] : null;
+}
+
+function sessionCookie(sessionId) {
+  const secure = RP_ORIGIN.startsWith('https://') ? '; Secure' : '';
+  return `${SESSION_COOKIE}=${sessionId}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${NONCE_TTL_MS / 1000}${secure}`;
+}
+
+// --- Accounts ---------------------------------------------------------------
+
+let writeQueue = Promise.resolve();
+
+async function readAccounts() {
+  try {
+    return JSON.parse(await fs.readFile(DATA_FILE, 'utf8'));
+  } catch (err) {
+    if (err.code === 'ENOENT') return [];
+    throw err;
+  }
+}
+
+// Serialised so concurrent sign-ups can't clobber each other or double-register.
+function createAccount(account) {
+  const run = writeQueue.then(async () => {
+    const accounts = await readAccounts();
+    if (accounts.some((a) => a.email.toLowerCase() === account.email.toLowerCase())) return false;
+    accounts.push(account);
+    await fs.mkdir(path.dirname(DATA_FILE), { recursive: true });
+    const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(accounts, null, 2));
+    await fs.rename(tmp, DATA_FILE);
+    return true;
+  });
+  writeQueue = run.catch(() => {});
+  return run;
+}
+
+// --- HTTP helpers -----------------------------------------------------------
+
+const SECURITY_HEADERS = {
+  'x-content-type-options': 'nosniff',
+  'referrer-policy': 'strict-origin-when-cross-origin',
+  'x-frame-options': 'DENY',
+};
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, data, headers = {}) {
+  send(res, status, JSON.stringify(data), {
+    'content-type': 'application/json; charset=utf-8',
+    'cache-control': 'no-store',
+    ...headers,
+  });
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Body too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+// --- Routes -----------------------------------------------------------------
+
+let indexTemplate;
+
+async function handleHome(req, res) {
+  indexTemplate ??= await fs.readFile(path.join(ROOT, 'index.html'), 'utf8');
+  const sessionId = crypto.randomBytes(32).toString('base64url');
+  const nonce = issueNonce(sessionId);
+  send(res, 200, indexTemplate.replace('{{EVP_NONCE}}', nonce), {
+    'content-type': 'text/html; charset=utf-8',
+    'cache-control': 'no-store',
+    'set-cookie': sessionCookie(sessionId),
+  });
+}
+
+const USER_MESSAGES = {
+  missing_token:
+    "We couldn't verify your email automatically. Pick your email from your browser's autofill suggestions " +
+    '(your browser and email provider must support instant email verification).',
+  unsupported_domain: "Your email provider doesn't support instant browser verification yet.",
+  email_mismatch: 'The verified email does not match the email you entered. Please choose it from autofill again.',
+  bad_nonce: 'Your sign-up session expired. Please try again.',
+  expired: 'Your verification expired. Please try again.',
+};
+
+async function handleSignup(req, res) {
+  const wantsJson = (req.headers.accept || '').includes('application/json');
+
+  const respond = (status, data, sessionId) => {
+    const headers = {};
+    if (sessionId) {
+      data.nonce = issueNonce(sessionId);
+      headers['set-cookie'] = sessionCookie(sessionId);
+    }
+    if (wantsJson) return sendJson(res, status, data, headers);
+    const title = data.ok ? 'Welcome to Daily Grind Rewards!' : 'Sign-up failed';
+    return send(
+      res,
+      status,
+      `<!DOCTYPE html><meta charset="utf-8"><title>${title}</title>` +
+        `<p>${escapeHtml(data.message)}</p><p><a href="/">Back to The Daily Grind</a></p>`,
+      { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store', ...headers },
+    );
+  };
+
+  // CSRF: only accept submissions from our own pages.
+  const requestOrigin = req.headers.origin;
+  if (requestOrigin && requestOrigin !== RP_ORIGIN) {
+    return respond(403, { ok: false, error: 'bad_origin', message: 'Cross-site requests are not allowed.' });
+  }
+  if (!(req.headers['content-type'] || '').startsWith('application/x-www-form-urlencoded')) {
+    return respond(415, { ok: false, error: 'bad_request', message: 'Unsupported content type.' });
+  }
+
+  const sessionId = getSessionId(req);
+  const nonce = sessionId ? consumeNonce(sessionId) : null;
+  // Always rotate to a fresh session so the page can retry.
+  const nextSessionId = crypto.randomBytes(32).toString('base64url');
+  if (sessionId) sessions.delete(sessionId);
+
+  const form = new URLSearchParams(await readBody(req));
+  const name = (form.get('name') || '').trim();
+  const email = (form.get('email') || '').trim();
+  const token = form.get('token') || '';
+
+  if (!name || name.length > 100) {
+    return respond(400, { ok: false, error: 'bad_request', message: 'Please enter your name.' }, nextSessionId);
+  }
+  if (!email || email.length > 254) {
+    return respond(400, { ok: false, error: 'bad_request', message: 'Please enter your email.' }, nextSessionId);
+  }
+  if (form.get('terms') !== 'on') {
+    return respond(400, { ok: false, error: 'bad_request', message: 'Please accept the Rewards terms.' }, nextSessionId);
+  }
+
+  let verified;
+  try {
+    verified = await verifier.verify(token, { nonce, email });
+  } catch (err) {
+    if (!(err instanceof EvpError)) throw err;
+    console.warn(`[rewards] email verification failed (${err.code}): ${err.message}`);
+    return respond(
+      400,
+      { ok: false, error: err.code, message: USER_MESSAGES[err.code] || "We couldn't verify that you own this email address." },
+      nextSessionId,
+    );
+  }
+
+  const created = await createAccount({
+    id: crypto.randomUUID(),
+    name,
+    email: verified.email,
+    emailVerified: true,
+    emailVerifiedBy: verified.issuer,
+    emailVerifiedAt: new Date().toISOString(),
+    isPrivateEmail: verified.isPrivateEmail,
+    marketingOptIn: form.get('marketing') === 'on',
+    points: 50,
+    createdAt: new Date().toISOString(),
+  });
+  if (!created) {
+    return respond(
+      409,
+      { ok: false, error: 'exists', message: 'A rewards account already exists for this email.' },
+      nextSessionId,
+    );
+  }
+
+  return respond(201, {
+    ok: true,
+    email: verified.email,
+    message: `Welcome, ${name}! Your email is verified and 50 bonus points are waiting for you.`,
+  });
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, RP_ORIGIN);
+    if ((pathname === '/' || pathname === '/index.html') && (req.method === 'GET' || req.method === 'HEAD')) {
+      return await handleHome(req, res);
+    }
+    if (pathname === '/api/rewards/signup') {
+      if (req.method !== 'POST') return sendJson(res, 405, { ok: false, error: 'method_not_allowed' }, { allow: 'POST' });
+      return await handleSignup(req, res);
+    }
+    return send(res, 404, 'Not found', { 'content-type': 'text/plain; charset=utf-8' });
+  } catch (err) {
+    if (res.headersSent) return res.destroy();
+    if (err.status === 413) return sendJson(res, 413, { ok: false, error: 'too_large' });
+    console.error(err);
+    return sendJson(res, 500, { ok: false, error: 'server_error', message: 'Something went wrong. Please try again.' });
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on http://localhost:${PORT} (RP origin ${RP_ORIGIN})`);
+});
diff --git a/test/evp-verify.test.js b/test/evp-verify.test.js
new file mode 100644
index 0000000..a996c75
--- /dev/null
+++ b/test/evp-verify.test.js
@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { describe, it } from 'node:test';
+import { createVerifier, EvpError, _internal } from '../lib/evp-verify.js';
+
+const ORIGIN = 'https://dailygrind.example';
+const ISSUER = 'https://issuer.example';
+const NONCE = 'n0nce-abcdefghijklmnopqrstuvwxyz0123456789';
+
+const b64 = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');
+
+function signJwt(header, payload, privateKey, alg) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  const opts = alg === 'ES256' ? { key: privateKey, dsaEncoding: 'ieee-p1363' } : privateKey;
+  const sig = crypto.sign(alg === 'ES256' ? 'sha256' : null, Buffer.from(input), opts);
+  return `${input}.${sig.toString('base64url')}`;
+}
+
+const issuerKeys = crypto.generateKeyPairSync('ed25519');
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', use: 'sig' };
+
+function makeToken({ evtHeader = {}, evtPayload = {}, kbHeader = {}, kbPayload = {}, browserAlg = 'ES256' } = {}) {
+  const now = Math.floor(Date.now() / 1000);
+  const browser = browserAlg === 'ES256'
+    ? crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' })
+    : crypto.generateKeyPairSync('ed25519');
+  const cnfJwk = { ...browser.publicKey.export({ format: 'jwk' }), alg: browserAlg };
+  const evt = signJwt(
+    { alg: 'Ed25519', kid: 'k1', typ: 'evt+jwt', ...evtHeader },
+    { iss: ISSUER, iat: now, cnf: { jwk: cnfJwk }, email: 'Ada@Mail.Example', email_verified: true, ...evtPayload },
+    issuerKeys.privateKey,
+    'Ed25519',
+  );
+  const sdHash = crypto.createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = signJwt(
+    { alg: browserAlg, typ: 'kb+jwt', ...kbHeader },
+    { aud: ORIGIN, nonce: NONCE, iat: now, sd_hash: sdHash, ...kbPayload },
+    browser.privateKey,
+    browserAlg,
+  );
+  return `${evt}~${kb}`;
+}
+
+function verifier(overrides = {}) {
+  return createVerifier({
+    origin: ORIGIN,
+    resolveTxt: async (name) => {
+      assert.equal(name, '_email-verification.mail.example');
+      return [['v=spf1 -all'], ['iss=', 'issuer.example']];
+    },
+    fetchJson: async (url) => {
+      if (url === `${ISSUER}/.well-known/email-verification`) {
+        return { issuer: ISSUER, issuance_endpoint: `${ISSUER}/issue`, jwks_uri: `${ISSUER}/jwks` };
+      }
+      if (url === `${ISSUER}/jwks`) return { keys: [issuerJwk] };
+      throw new Error(`unexpected fetch ${url}`);
+    },
+    ...overrides,
+  });
+}
+
+async function rejects(promise, code) {
+  await assert.rejects(promise, (err) => err instanceof EvpError && err.code === code);
+}
+
+describe('EVP token verification', () => {
+  it('accepts a valid token (ES256 browser key)', async () => {
+    const result = await verifier().verify(makeToken(), { nonce: NONCE, email: 'ada@mail.example' });
+    assert.deepEqual(result, { email: 'Ada@Mail.Example', issuer: ISSUER, isPrivateEmail: false });
+  });
+
+  it('accepts a valid token (Ed25519 browser key)', async () => {
+    const result = await verifier().verify(makeToken({ browserAlg: 'Ed25519' }), { nonce: NONCE });
+    assert.equal(result.email, 'Ada@Mail.Example');
+  });
+
+  it('rejects missing token', () => rejects(verifier().verify('', { nonce: NONCE }), 'missing_token'));
+  it('rejects without session nonce', () => rejects(verifier().verify(makeToken(), { nonce: null }), 'bad_nonce'));
+  it('rejects wrong nonce', () => rejects(verifier().verify(makeToken(), { nonce: 'other' }), 'bad_nonce'));
+  it('rejects wrong audience', () =>
+    rejects(verifier().verify(makeToken({ kbPayload: { aud: 'https://evil.example' } }), { nonce: NONCE }), 'bad_audience'));
+  it('rejects email mismatch', () =>
+    rejects(verifier().verify(makeToken(), { nonce: NONCE, email: 'eve@mail.example' }), 'email_mismatch'));
+  it('rejects email_verified != true', () =>
+    rejects(verifier().verify(makeToken({ evtPayload: { email_verified: 'true' } }), { nonce: NONCE }), 'unverified'));
+  it('rejects stale KB-JWT', () =>
+    rejects(verifier().verify(makeToken({ kbPayload: { iat: 1 } }), { nonce: NONCE }), 'expired'));
+  it('rejects stale EVT', () =>
+    rejects(verifier().verify(makeToken({ evtPayload: { iat: 1 } }), { nonce: NONCE }), 'expired'));
+  it('rejects wrong sd_hash', () =>
+    rejects(verifier().verify(makeToken({ kbPayload: { sd_hash: 'x' } }), { nonce: NONCE }), 'bad_binding'));
+  it('rejects alg none', () =>
+    rejects(verifier().verify(makeToken({ evtHeader: { alg: 'none' } }), { nonce: NONCE }), 'bad_alg'));
+  it('rejects wrong KB typ', () =>
+    rejects(verifier().verify(makeToken({ kbHeader: { typ: 'jwt' } }), { nonce: NONCE }), 'malformed'));
+  it('rejects issuer not authorised by DNS', () =>
+    rejects(verifier().verify(makeToken({ evtPayload: { iss: 'https://evil.example' } }), { nonce: NONCE }), 'bad_issuer'));
+  it('rejects domains without an EVP record', () =>
+    rejects(verifier({ resolveTxt: async () => [['v=spf1 -all']] }).verify(makeToken(), { nonce: NONCE }), 'unsupported_domain'));
+  it('rejects unknown kid', () =>
+    rejects(verifier().verify(makeToken({ evtHeader: { kid: 'nope' } }), { nonce: NONCE }), 'bad_key'));
+
+  it('rejects EVT signed by a different key', async () => {
+    const other = crypto.generateKeyPairSync('ed25519');
+    const otherJwk = { ...other.publicKey.export({ format: 'jwk' }), kid: 'k1' };
+    const v = verifier({
+      fetchJson: async (url) =>
+        url.endsWith('/jwks') ? { keys: [otherJwk] } : { issuer: ISSUER, jwks_uri: `${ISSUER}/jwks` },
+    });
+    await rejects(v.verify(makeToken(), { nonce: NONCE }), 'bad_signature');
+  });
+
+  it('rejects KB-JWT not signed by cnf key', async () => {
+    const [evt] = makeToken().split('~');
+    const [, kb] = makeToken().split('~');
+    // A KB-JWT from another presentation is not bound to this EVT.
+    await rejects(verifier().verify(`${evt}~${kb}`, { nonce: NONCE }), 'bad_binding');
+    const attacker = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+    const sdHash = crypto.createHash('sha256').update(`${evt}~`).digest('base64url');
+    const forged = signJwt(
+      { alg: 'ES256', typ: 'kb+jwt' },
+      { aud: ORIGIN, nonce: NONCE, iat: Math.floor(Date.now() / 1000), sd_hash: sdHash },
+      attacker.privateKey,
+      'ES256',
+    );
+    await rejects(verifier().verify(`${evt}~${forged}`, { nonce: NONCE }), 'bad_signature');
+  });
+
+  it('rejects metadata whose issuer does not match', () =>
+    rejects(
+      verifier({ fetchJson: async () => ({ issuer: 'https://evil.example', jwks_uri: 'https://evil.example/jwks' }) })
+        .verify(makeToken(), { nonce: NONCE }),
+      'discovery',
+    ));
+
+  it('classifies private addresses', () => {
+    for (const ip of ['127.0.0.1', '10.1.2.3', '192.168.0.1', '169.254.169.254', '::1', 'fd00::1', '::ffff:10.0.0.1']) {
+      assert.equal(_internal.isPublicAddress(ip), false, ip);
+    }
+    for (const ip of ['8.8.8.8', '2606:4700::1111']) assert.equal(_internal.isPublicAddress(ip), true, ip);
+  });
+});
