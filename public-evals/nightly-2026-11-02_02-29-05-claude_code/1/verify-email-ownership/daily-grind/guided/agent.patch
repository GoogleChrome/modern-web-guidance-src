index 0000000..5ea8cb5
--- /dev/null
+++ b/server/evp.js
@@ -0,0 +1,145 @@
+// Email Verification Protocol (EVP) relying-party verification.
+// Verifies the `EVT~KB-JWT` SD-JWT presentation the browser places in the
+// hidden `autocomplete="email-verification-token"` input.
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers (e.g. Gmail) and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+const NETWORK_TIMEOUT_MS = 5000;
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Cache one remote JWKS per issuer so jose can reuse its key cache across requests.
+const jwksByIssuer = new Map();
+
+async function assertDnsDelegation(domain, iss) {
+  let records;
+  try {
+    records = await dns.resolveTxt(`_email-verification.${domain}`);
+  } catch (err) {
+    throw new Error(`No _email-verification TXT record for "${domain}" (${err.code}).`);
+  }
+  const txtRecords = records.map((r) => r.join(''));
+  if (!txtRecords.some((txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss)) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+}
+
+async function loadIssuerJwks(iss) {
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') throw new Error('Issuer must use HTTPS.');
+
+  const res = await fetch(discoveryUrl, { signal: AbortSignal.timeout(NETWORK_TIMEOUT_MS) });
+  if (!res.ok) throw new Error(`Issuer metadata request failed with ${res.status}.`);
+  const metadata = await res.json();
+  if (metadata.issuer !== iss || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const cached = jwksByIssuer.get(iss);
+  if (cached?.uri === metadata.jwks_uri) return cached.jwks;
+  const jwks = createRemoteJWKSet(new URL(metadata.jwks_uri), { timeoutDuration: NETWORK_TIMEOUT_MS });
+  jwksByIssuer.set(iss, { uri: metadata.jwks_uri, jwks });
+  return jwks;
+}
+
+/**
+ * Throws unless `rawToken` cryptographically proves that the browser user
+ * controls `submittedEmail`, bound to this origin and the single-use nonce.
+ */
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }) {
+  // Step 1: Parse the SD-JWT presentation.
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || typeof iss !== 'string') {
+    throw new Error('Missing nonce, KB-JWT, or issuer.');
+  }
+
+  // Step 2: Validate DNS delegation before making any request to `iss`.
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  await assertDnsDelegation(domain, iss);
+  const issuerJwks = await loadIssuerJwks(iss);
+
+  // Step 3: Verify the EVT signature and the Key Binding JWT.
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header?.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  // Check the disclosed claims (they may be selectively disclosed rather than
+  // plain in the issuer JWT payload). Compare emails case-insensitively.
+  const claims = verified.payload;
+  if (claims.email_verified !== true) {
+    throw new Error('email_verified !== true.');
+  }
+  if (typeof claims.email !== 'string' || claims.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+}
diff --git a/server/index.js b/server/index.js
new file mode 100644
index 0000000..62e9a28
--- /dev/null
+++ b/server/index.js
@@ -0,0 +1,212 @@
+import { createServer } from 'node:http';
+import { randomBytes, randomUUID, scrypt } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './evp.js';
+
+const PORT = Number(process.env.PORT) || 11222;
+// Public origin of this site; used as the expected KB-JWT audience and for
+// the same-origin POST check. Never derive this from request headers.
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+// Email Verification origin trial token for RP_ORIGIN.
+const ORIGIN_TRIAL_TOKEN = process.env.EVP_ORIGIN_TRIAL_TOKEN || '';
+
+const SESSION_COOKIE = 'dg_sid';
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const MAX_BODY_BYTES = 64 * 1024;
+
+const template = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const scryptAsync = promisify(scrypt);
+
+// In-memory stores for this demo. Swap for a real session store / database.
+const sessions = new Map(); // sessionId -> { nonce, expiresAt }
+const accounts = new Map(); // lowercased email -> account
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, s] of sessions) if (s.expiresAt < now) sessions.delete(id);
+}, 60_000).unref();
+
+const STATUS_MESSAGES = {
+  verified: ['success', 'Welcome to Daily Grind Rewards! Your email is verified and your account is ready — your first drink is on us.'],
+  pending: ['info', 'Almost there! Check your inbox for a link to confirm your email and activate your rewards.'],
+  exists: ['info', 'You already have a rewards account with that email. Sign in from My Account to see your points.'],
+  invalid: ['error', 'Please enter your name, a valid email address, and a password of at least 8 characters.'],
+};
+
+function parseCookies(header = '') {
+  return Object.fromEntries(
+    header.split(';').map((c) => c.trim().split('=')).filter(([k, v]) => k && v)
+  );
+}
+
+function getOrCreateSessionId(req, res) {
+  const existing = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  if (existing && /^[\w-]{36}$/.test(existing)) return existing;
+  const id = randomUUID();
+  res.setHeader('Set-Cookie', `${SESSION_COOKIE}=${id}; Path=/; HttpOnly; Secure; SameSite=Lax`);
+  return id;
+}
+
+function issueSessionNonce(sessionId) {
+  const nonce = randomBytes(32).toString('base64url');
+  sessions.set(sessionId, { nonce, expiresAt: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+// Atomically read and delete the single-use nonce so a token can't be replayed.
+function consumeSessionNonce(req) {
+  const sessionId = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  const session = sessionId && sessions.get(sessionId);
+  if (!session) return null;
+  sessions.delete(sessionId);
+  return session.expiresAt >= Date.now() ? session.nonce : null;
+}
+
+async function readForm(req) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw Object.assign(new Error('Body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const key = await scryptAsync(password, salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${key.toString('base64url')}`;
+}
+
+function sendTraditionalVerificationEmail(email) {
+  // Fallback for browsers without Email Verification support, providers that
+  // don't participate, or tokens that fail verification.
+  // TODO: Wire up the transactional email provider to send a confirmation link.
+  console.info(`[rewards] Email verification fallback required for ${email}`);
+}
+
+function redirect(res, status) {
+  res.writeHead(303, { Location: `/?rewards=${status}#rewards`, 'Cache-Control': 'no-store' });
+  res.end();
+}
+
+function renderHome(req, res, url) {
+  const sessionId = getOrCreateSessionId(req, res);
+  const nonce = issueSessionNonce(sessionId);
+
+  const status = STATUS_MESSAGES[url.searchParams.get('rewards')];
+  const statusHtml = status
+    ? `<p class="notice notice--${status[0]}" role="${status[0] === 'error' ? 'alert' : 'status'}">${status[1]}</p>`
+    : '';
+
+  const html = template
+    .replace('{{EVP_NONCE}}', nonce)
+    .replace('{{REWARDS_STATUS}}', statusHtml);
+
+  const headers = {
+    'Content-Type': 'text/html; charset=utf-8',
+    // Each render carries a single-use nonce; don't let bfcache/HTTP caches reuse it.
+    'Cache-Control': 'no-store',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+  };
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(req.method === 'HEAD' ? undefined : html);
+}
+
+async function handleRewardsSignup(req, res) {
+  // Reject cross-origin form posts (the session cookie is also SameSite=Lax).
+  const origin = req.headers.origin;
+  if (origin && origin !== RP_ORIGIN) {
+    res.writeHead(403, { 'Content-Type': 'text/plain' }).end('Forbidden');
+    return;
+  }
+
+  const form = await readForm(req);
+  const name = String(form.get('name') || '').trim();
+  const submittedEmail = String(form.get('email') || '').trim();
+  const password = String(form.get('new-password') || '');
+  const rawToken = String(form.get('email-verification-token') || '').trim();
+  // Consume the nonce up front so it's single-use regardless of outcome.
+  const expectedNonce = consumeSessionNonce(req);
+
+  if (
+    !name || name.length > 200 ||
+    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(submittedEmail) || submittedEmail.length > 254 ||
+    password.length < 8 || password.length > 1024
+  ) {
+    redirect(res, 'invalid');
+    return;
+  }
+
+  let emailVerified = false;
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      emailVerified = true;
+    } catch (err) {
+      console.error('[rewards] Email verification token check failed:', err.message);
+    }
+  }
+
+  const key = submittedEmail.toLowerCase();
+  if (accounts.has(key)) {
+    // Only reveal that an account exists to someone who has proven they own the email.
+    if (emailVerified) {
+      redirect(res, 'exists');
+    } else {
+      sendTraditionalVerificationEmail(submittedEmail);
+      redirect(res, 'pending');
+    }
+    return;
+  }
+
+  accounts.set(key, {
+    id: randomUUID(),
+    name,
+    email: submittedEmail,
+    passwordHash: await hashPassword(password),
+    emailVerified,
+    points: 0,
+    createdAt: new Date().toISOString(),
+  });
+
+  if (emailVerified) {
+    // Fast path: ownership is cryptographically verified; no OTP or magic link needed.
+    redirect(res, 'verified');
+  } else {
+    sendTraditionalVerificationEmail(submittedEmail);
+    redirect(res, 'pending');
+  }
+}
+
+const server = createServer(async (req, res) => {
+  const url = new URL(req.url, RP_ORIGIN);
+  try {
+    if (url.pathname === '/' || url.pathname === '/index.html') {
+      if (req.method === 'GET' || req.method === 'HEAD') return renderHome(req, res, url);
+    } else if (url.pathname === '/api/rewards/signup') {
+      if (req.method === 'POST') return await handleRewardsSignup(req, res);
+    } else {
+      res.writeHead(404, { 'Content-Type': 'text/plain' }).end('Not found');
+      return;
+    }
+    res.writeHead(405, { 'Content-Type': 'text/plain' }).end('Method not allowed');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) res.writeHead(err.status || 500, { 'Content-Type': 'text/plain' });
+    res.end(err.status === 413 ? 'Payload too large' : 'Something went wrong');
+  }
+});
+
+server.listen(PORT, () => {
+  console.info(`The Daily Grind running at ${RP_ORIGIN}`);
+});
