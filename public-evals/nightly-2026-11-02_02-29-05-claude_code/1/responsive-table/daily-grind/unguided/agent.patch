+    /* Nutrition & Pricing Table */
+    .table-heading {
+      margin-top: 40px;
+      text-align: center;
+      color: var(--primary);
+    }
+
+    .table-wrapper {
+      margin-top: 15px;
+      overflow-x: auto;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      min-width: 560px;
+      border-collapse: collapse;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      caption-side: bottom;
+      padding: 10px 15px;
+      font-size: 0.8rem;
+      text-align: left;
+      color: #5d4037;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 15px;
+      text-align: left;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .nutrition-table td {
+      text-align: right;
+      font-variant-numeric: tabular-nums;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th:not(:first-child) {
+      text-align: right;
+    }
+
+    .nutrition-table tbody th {
+      color: var(--primary);
+      background: white;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) th,
+    .nutrition-table tbody tr:nth-child(even) td {
+      background: #f5f0ee;
+    }
+
+    /* Keep the drink name column visible while scrolling horizontally */
+    .nutrition-table th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 1;
+    }
+
+    .scroll-hint {
+      display: none;
+      margin-top: 8px;
+      font-size: 0.8rem;
+      text-align: center;
+      color: #5d4037;
+    }
+
+    @media (max-width: 600px) {
+      .scroll-hint {
+        display: block;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+      }
+    }
+
