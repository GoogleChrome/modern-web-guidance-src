+  <script>
+    (() => {
+      const message = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const result = document.getElementById('detect-result');
+      const languageNames = new Intl.DisplayNames([navigator.language, 'en'], { type: 'language' });
+      let detectorPromise;
+
+      function disable(reason) {
+        button.disabled = true;
+        result.textContent = reason;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        disable('Language detection is not supported in this browser.');
+        return;
+      }
+
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          disable('Language detection is not available on this device.');
+        }
+      }).catch(() => disable('Language detection is not available on this device.'));
+
+      // create() must run inside the click handler: downloading the model requires a user gesture.
+      function getDetector() {
+        detectorPromise ??= LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round(e.loaded * 100);
+              progress.hidden = false;
+              progress.value = percent;
+              result.textContent = `Downloading language model… ${percent}%`;
+            });
+          },
+        }).catch((err) => {
+          detectorPromise = undefined;
+          throw err;
+        }).finally(() => {
+          progress.hidden = true;
+        });
+        return detectorPromise;
+      }
+
+      button.addEventListener('click', async () => {
+        const text = message.value.trim();
+        if (!text) {
+          result.textContent = 'Please enter a message first.';
+          return;
+        }
+
+        button.disabled = true;
+        try {
+          const detector = await getDetector();
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            result.textContent = 'Could not determine the language. Try writing a longer message.';
+          } else {
+            const name = languageNames.of(top.detectedLanguage) ?? top.detectedLanguage;
+            const confidence = (top.confidence * 100).toFixed(1);
+            result.textContent = `Detected language: ${name} (${confidence}% confidence)`;
+          }
+        } catch (err) {
+          result.textContent = `Language detection failed: ${err.message}`;
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
