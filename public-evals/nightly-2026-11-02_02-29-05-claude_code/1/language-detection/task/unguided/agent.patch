+  <script>
+    (() => {
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const result = document.getElementById('detect-result');
+      const languageNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      let detectorPromise = null;
+
+      function showMessage(message, isError = false) {
+        result.textContent = message;
+        result.classList.toggle('error', isError);
+      }
+
+      async function getDetector() {
+        if (!('LanguageDetector' in self)) {
+          throw new Error('Language detection is not supported in this browser.');
+        }
+
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          throw new Error('Language detection is not available on this device.');
+        }
+
+        if (!detectorPromise) {
+          detectorPromise = LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                showMessage(`Downloading language model... ${Math.round(e.loaded * 100)}%`);
+              });
+            },
+          }).catch((err) => {
+            detectorPromise = null;
+            throw err;
+          });
+        }
+
+        if (availability !== 'available') {
+          showMessage('Downloading language model... 0%');
+        }
+
+        return detectorPromise;
+      }
+
+      button.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          showMessage('Please enter a message first.', true);
+          return;
+        }
+
+        button.disabled = true;
+        try {
+          const detector = await getDetector();
+          showMessage('Detecting...');
+          const [top] = await detector.detect(text);
+
+          if (!top || top.detectedLanguage === 'und') {
+            showMessage('Could not determine the language.');
+            return;
+          }
+
+          const name = languageNames.of(top.detectedLanguage) || top.detectedLanguage;
+          const confidence = (top.confidence * 100).toFixed(1);
+          showMessage(`Language: ${name} (${confidence}% confidence)`);
+        } catch (err) {
+          showMessage(err.message || 'Language detection failed.', true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
