+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const orderForm = document.getElementById('order-form');
+    const shopSelect = document.getElementById('shop');
+
+    const syncAriaInvalid = () => {
+      if (shopSelect.matches(':user-invalid')) {
+        shopSelect.setAttribute('aria-invalid', 'true');
+      } else {
+        shopSelect.removeAttribute('aria-invalid');
+      }
+    };
+
+    shopSelect.addEventListener('blur', syncAriaInvalid);
+    shopSelect.addEventListener('change', syncAriaInvalid);
+    // Submit is blocked while invalid, so sync on the resulting invalid event
+    shopSelect.addEventListener('invalid', () => requestAnimationFrame(syncAriaInvalid));
+  </script>
+
