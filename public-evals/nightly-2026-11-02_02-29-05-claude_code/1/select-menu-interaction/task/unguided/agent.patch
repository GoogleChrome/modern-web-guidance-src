+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var shop = document.getElementById('shop');
+      var field = document.getElementById('shop-field');
+
+      // Only reveal validation state once the user has interacted or tried to submit
+      function showErrors() {
+        field.classList.add('show-errors');
+        shop.setAttribute('aria-invalid', String(!shop.checkValidity()));
+      }
+
+      shop.addEventListener('change', showErrors);
+      shop.addEventListener('blur', showErrors);
+
+      form.addEventListener('submit', function (event) {
+        if (!form.checkValidity()) {
+          event.preventDefault();
+          showErrors();
+          shop.focus();
+        }
+      });
+    })();
+  </script>
