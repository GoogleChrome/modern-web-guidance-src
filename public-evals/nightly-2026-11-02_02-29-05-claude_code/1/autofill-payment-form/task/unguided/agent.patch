+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('card-number');
+      const name = document.getElementById('card-name');
+      const expiry = document.getElementById('card-expiry');
+      const cvc = document.getElementById('card-cvc');
+      const status = document.getElementById('form-status');
+
+      // Group card digits in blocks of four as the user types
+      number.addEventListener('input', function () {
+        const digits = number.value.replace(/\D/g, '').slice(0, 19);
+        number.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
+      });
+
+      // Insert the slash in MM/YY automatically
+      expiry.addEventListener('input', function (e) {
+        let digits = expiry.value.replace(/\D/g, '').slice(0, 4);
+        if (digits.length >= 3 || (digits.length === 2 && e.inputType !== 'deleteContentBackward')) {
+          digits = digits.slice(0, 2) + '/' + digits.slice(2);
+        }
+        expiry.value = digits;
+      });
+
+      cvc.addEventListener('input', function () {
+        cvc.value = cvc.value.replace(/\D/g, '').slice(0, 4);
+      });
+
+      function luhn(digits) {
+        let sum = 0;
+        for (let i = 0; i < digits.length; i++) {
+          let d = parseInt(digits[digits.length - 1 - i], 10);
+          if (i % 2 === 1) {
+            d *= 2;
+            if (d > 9) d -= 9;
+          }
+          sum += d;
+        }
+        return sum % 10 === 0;
+      }
+
+      const validators = {
+        'card-number': function () {
+          const digits = number.value.replace(/\D/g, '');
+          if (!digits) return 'Card number is required.';
+          if (digits.length < 12 || digits.length > 19 || !luhn(digits)) return 'Enter a valid card number.';
+          return '';
+        },
+        'card-name': function () {
+          if (!name.value.trim()) return 'Name on card is required.';
+          return '';
+        },
+        'card-expiry': function () {
+          const match = expiry.value.match(/^(\d{2})\/(\d{2})$/);
+          if (!match) return 'Use the format MM/YY.';
+          const month = parseInt(match[1], 10);
+          const year = 2000 + parseInt(match[2], 10);
+          if (month < 1 || month > 12) return 'Enter a valid month.';
+          const now = new Date();
+          if (year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth() + 1)) {
+            return 'This card has expired.';
+          }
+          return '';
+        },
+        'card-cvc': function () {
+          if (!/^\d{3,4}$/.test(cvc.value)) return 'Enter a 3 or 4 digit code.';
+          return '';
+        }
+      };
+
+      function validate(input) {
+        const message = validators[input.id]();
+        document.getElementById(input.id + '-error').textContent = message;
+        input.classList.toggle('invalid', !!message);
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        return !message;
+      }
+
+      [number, name, expiry, cvc].forEach(function (input) {
+        input.addEventListener('blur', function () { validate(input); });
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        status.textContent = '';
+        const fields = [number, name, expiry, cvc];
+        const valid = fields.map(validate).every(Boolean);
+        if (!valid) {
+          fields.find(function (f) { return f.classList.contains('invalid'); }).focus();
+          return;
+        }
+        // TODO: hand card details to a PCI-compliant payment processor (e.g. Stripe Elements) here.
+        status.textContent = 'Thank you! Your payment details have been received.';
+        form.reset();
+      });
+    })();
+  </script>
+
 </body>
 
