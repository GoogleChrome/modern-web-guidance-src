     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase Section */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 40px;
+      align-items: start;
+    }
+
+    .nested-curve-parent {
+      background: var(--primary);
+      padding: 14px;
+      border-radius: 24px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      /* Fallback: clips at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--secondary);
+      color: var(--text);
+      padding: 14px 18px;
+    }
+
+    .nested-curve-footer h3 {
+      color: var(--primary);
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* Clips children to the content box, with concentric inner corner curves */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    .safety-zone-parent {
+      background: var(--secondary);
+      padding: 24px;
+      border-radius: 16px;
+      /* Fallback: clips overflowing text but also truncates the button glow */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+    }
+
+    .promo-ticker {
+      white-space: nowrap;
+      font-weight: 600;
+      margin: 8px 0 20px;
+    }
+
+    .glowing-btn {
+      display: block;
+      width: 100%;
+      background: var(--accent);
+      color: var(--text);
+      border: none;
+      border-radius: 8px;
+      padding: 12px 20px;
+      font: inherit;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 0 24px 8px rgba(255, 171, 64, 0.75);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* 15px safety zone so the button glow can bleed outside */
+        overflow-clip-margin: 15px;
+      }
+    }
+
     footer {
