     .btn:hover {
       background: #3e2723;
     }
 
+    /* Menu sections with sticky, state-aware headers */
+    .menu-section {
+      margin-top: 60px;
+      /* Prevent scroll anchoring from fighting the padding change when stuck */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the site navigation */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named so it can't collide with any other container query */
+      container-type: scroll-state;
+      container-name: menu-section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 20px 24px;
+      border-radius: 8px;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s;
+    }
+
+    .sticky-header h2 {
+      font-size: 1.5rem;
+      line-height: 1.3;
+    }
+
+    .sticky-header p {
+      font-size: 0.9rem;
+    }
+
+    @container menu-section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        padding: 8px 24px;
+        box-shadow: 0 4px 10px rgb(0 0 0 / 0.25);
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
