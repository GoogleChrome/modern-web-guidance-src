+          step: 1, target: 'reg-bday-month', error: 'reg-bday-error', inputs: ['reg-bday-month', 'reg-bday-day'],
+          check: function () {
+            var month = val('reg-bday-month');
+            var day = val('reg-bday-day');
+            if (!month && !day) return '';
+            if (!month) { this.target = 'reg-bday-month'; return 'Birthday must include a month'; }
+            this.target = 'reg-bday-day';
+            if (!day) return 'Birthday must include a day';
+            var n = Number(day);
+            if (!/^\d{1,2}$/.test(day) || n < 1 || n > DAYS_IN_MONTH[month - 1]) {
+              return 'Enter a real day for ' + MONTHS[month - 1];
+            }
+            return '';
+          }
+        },
+        {
+          step: 2, target: 'reg-comms-sms', error: 'reg-comms-error', inputs: ['reg-comms-sms'],
+          check: function () {
+            if ($('reg-comms-sms').checked && !val('reg-phone')) {
+              return 'To get text offers, add a mobile number in the "About you" step, or untick this option';
+            }
+            return '';
+          }
+        },
+        {
+          step: 2, target: 'reg-terms', error: 'reg-terms-error', inputs: ['reg-terms'],
+          check: function () {
+            return $('reg-terms').checked ? '' : 'Agree to the Rewards Terms and Privacy Policy to join';
+          }
+        }
+      ];
+
+      function runRule(rule) {
+        var message = rule.check();
+        $(rule.error).textContent = message;
+        rule.inputs.forEach(function (id) {
+          var invalid = message && (rule.inputs.length === 1 || id === rule.target);
+          if (invalid) $(id).setAttribute('aria-invalid', 'true');
+          else $(id).removeAttribute('aria-invalid');
+        });
+        return message ? { id: rule.target, message: message, step: rule.step } : null;
+      }
+
+      function validate(stepIndexes) {
+        var errors = [];
+        rules.forEach(function (rule) {
+          if (stepIndexes.indexOf(rule.step) === -1) return;
+          var err = runRule(rule);
+          if (err) errors.push(err);
+        });
+        return errors;
+      }
+
+      function rulesFor(id) {
+        return rules.filter(function (rule) { return rule.inputs.indexOf(id) !== -1; });
+      }
+
+      function showSummary(errors) {
+        summaryList.textContent = '';
+        errors.forEach(function (err) {
+          var li = document.createElement('li');
+          var a = document.createElement('a');
+          a.href = '#' + err.id;
+          a.textContent = err.message;
+          li.appendChild(a);
+          summaryList.appendChild(li);
+        });
+        summary.hidden = false;
+        summary.focus();
+      }
+
+      function hideSummary() {
+        summary.hidden = true;
+        summaryList.textContent = '';
+      }
+
+      summaryList.addEventListener('click', function (e) {
+        var link = e.target.closest('a');
+        if (!link) return;
+        e.preventDefault();
+        var field = $(link.getAttribute('href').slice(1));
+        field.scrollIntoView({ block: 'center' });
+        field.focus({ preventScroll: true });
+      });
+
+      function showStep(index, opts) {
+        opts = opts || {};
+        current = index;
+        hideSummary();
+        steps.forEach(function (step, i) { step.hidden = i !== index; });
+        Array.prototype.forEach.call(indicators, function (li, i) {
+          li.classList.toggle('is-complete', i < index);
+          if (i === index) li.setAttribute('aria-current', 'step');
+          else li.removeAttribute('aria-current');
+        });
+        backBtn.hidden = index === 0;
+        nextBtn.hidden = index === lastStep;
+        submitBtn.hidden = index !== lastStep;
+        if (index === lastStep) buildReview();
+
+        if (opts.focus === false) return;
+        var label = 'Step ' + (index + 1) + ' of ' + steps.length + ': ' + steps[index].dataset.title;
+        document.title = label + ' – Join Rewards | ' + baseTitle;
+        status.textContent = label;
+        var focusTarget = opts.field ? $(opts.field) : steps[index].querySelector('h3');
+        form.scrollIntoView({ block: 'start' });
+        focusTarget.focus({ preventScroll: true });
+      }
+
+      function goNext() {
+        var errors = validate([current]);
+        if (errors.length) { showSummary(errors); return; }
+        showStep(current + 1);
+      }
+
+      function addReviewRow(term, value, step, field) {
+        var dt = document.createElement('dt');
+        var dd = document.createElement('dd');
+        var edit = document.createElement('dd');
+        var btn = document.createElement('button');
+        dt.textContent = term;
+        dd.textContent = value;
+        btn.type = 'button';
+        btn.className = 'btn-link';
+        btn.textContent = 'Change';
+        btn.setAttribute('aria-label', 'Change ' + term.toLowerCase());
+        btn.addEventListener('click', function () { showStep(step, { field: field }); });
+        edit.appendChild(btn);
+        review.appendChild(dt);
+        review.appendChild(dd);
+        review.appendChild(edit);
+      }
+
+      function buildReview() {
+        var month = val('reg-bday-month');
+        var store = $('reg-store');
+        var updates = [];
+        if ($('reg-comms-email').checked) updates.push('Email');
+        if ($('reg-comms-sms').checked) updates.push('Text message');
+
+        review.textContent = '';
+        addReviewRow('Email address', val('reg-email'), 0, 'reg-email');
+        addReviewRow('Full name', val('reg-name'), 1, 'reg-name');
+        addReviewRow('Mobile number', val('reg-phone') || 'Not provided', 1, 'reg-phone');
+        addReviewRow('Birthday', month ? MONTHS[month - 1] + ' ' + Number(val('reg-bday-day')) : 'Not provided',
+          1, 'reg-bday-month');
+        addReviewRow('Home store', store.value ? store.options[store.selectedIndex].text : 'No preference',
+          2, 'reg-store');
+        addReviewRow('Offers', updates.length ? updates.join(' and ') : 'No marketing messages', 2, 'reg-comms-email');
+      }
+
+      // Validate a field once the user leaves it, then re-check as they type to clear errors promptly.
+      var touched = {};
+      form.addEventListener('change', function (e) { if (e.target.id) touched[e.target.id] = true; });
+      form.addEventListener('focusout', function (e) {
+        var id = e.target.id;
+        if (!touched[id]) return;
+        if (e.target.type === 'email') e.target.value = e.target.value.trim();
+        rulesFor(id).forEach(runRule);
+      });
+      form.addEventListener('input', function (e) {
+        var id = e.target.id;
+        touched[id] = true;
+        rulesFor(id).forEach(function (rule) {
+          if ($(rule.error).textContent) runRule(rule);
+        });
+      });
+
+      // Live password requirement checklist.
+      var pw = $('reg-password');
+      function updatePasswordRules() {
+        var v = pw.value;
+        var email = val('reg-email').toLowerCase();
+        form.querySelector('[data-rule="length"]').classList.toggle('is-met', v.length >= 8);
+        form.querySelector('[data-rule="email"]').classList.toggle('is-met', !!v && v.toLowerCase() !== email);
+      }
+      pw.addEventListener('input', updatePasswordRules);
+      $('reg-email').addEventListener('input', updatePasswordRules);
+
+      var toggle = $('reg-password-toggle');
+      toggle.addEventListener('click', function () {
+        var show = pw.type === 'password';
+        pw.type = show ? 'text' : 'password';
+        toggle.setAttribute('aria-pressed', String(show));
+        toggle.firstChild.nodeValue = show ? 'Hide' : 'Show';
+      });
+
+      backBtn.addEventListener('click', function () { showStep(current - 1); });
+      nextBtn.addEventListener('click', goNext);
+
+      form.addEventListener('submit', function (e) {
+        // Pressing Enter on an earlier step should advance, not submit.
+        if (current < lastStep) { e.preventDefault(); goNext(); return; }
+        if (submitting) { e.preventDefault(); return; }
+
+        var errors = validate(steps.map(function (_, i) { return i; }));
+        if (errors.length) {
+          e.preventDefault();
+          showStep(errors[0].step, { focus: false });
+          showSummary(errors.filter(function (err) { return err.step === errors[0].step; }));
+          return;
+        }
+
+        // Never show a revealed password on the way out, and block double submits.
+        pw.type = 'password';
+        submitting = true;
+        submitBtn.setAttribute('aria-disabled', 'true');
+        submitBtn.textContent = 'Joining…';
+        status.textContent = 'Submitting your registration…';
+      });
+
+      // Reset if the page is restored from the back/forward cache.
+      window.addEventListener('pageshow', function (e) {
+        if (!e.persisted) return;
+        submitting = false;
+        submitBtn.removeAttribute('aria-disabled');
+        submitBtn.textContent = 'Join Rewards';
+      });
+
+      showStep(0, { focus: false });
+    })();
+  </script>
+
 </body>
 
 </html>
