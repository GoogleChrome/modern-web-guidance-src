diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..ccbc993
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,145 @@
+import { baseStyles, buttonStyles } from './shared-styles.js';
+
+let uid = 0;
+
+/**
+ * <coffee-card image="..." image-alt="...">
+ *   <h3 slot="title">Name</h3>
+ *   <p>Description</p>
+ *   <a slot="action" href="...">View Details</a>
+ * </coffee-card>
+ *
+ * Content stays in the light DOM so the heading level, text and links remain
+ * author-controlled and readable without JavaScript. The optional image is
+ * rendered inside the shadow root.
+ */
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: flex;
+    flex-direction: column;
+    background: #fff;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.3s, transform 0.3s;
+  }
+
+  :host(:hover),
+  :host(:focus-within) {
+    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+    transform: translateY(-2px);
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :host(:hover),
+    :host(:focus-within) {
+      transform: none;
+    }
+  }
+
+  .media {
+    aspect-ratio: 4 / 3;
+    background: var(--secondary, #d7ccc8);
+  }
+
+  .media img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    align-items: center;
+    padding: 20px;
+  }
+
+  ::slotted([slot="title"]) {
+    margin: 0 0 10px;
+    color: var(--primary, #4e342e);
+    font-size: 1.17em;
+  }
+
+  ::slotted(:not([slot])) {
+    margin: 0;
+  }
+
+  .actions {
+    margin-top: auto;
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="media" part="media" hidden>
+    <img alt="" loading="lazy" decoding="async">
+  </div>
+  <div class="body" part="body">
+    <slot name="title"></slot>
+    <slot></slot>
+    <div class="actions"><slot name="action"></slot></div>
+  </div>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['image', 'image-alt'];
+
+  #media;
+  #img;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, buttonStyles, styles];
+    root.append(template.content.cloneNode(true));
+    this.#media = root.querySelector('.media');
+    this.#img = root.querySelector('img');
+    root.querySelector('slot[name="action"]').addEventListener('slotchange', () => this.#labelActions());
+    root.querySelector('slot[name="title"]').addEventListener('slotchange', () => this.#labelActions());
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  #render() {
+    const src = this.getAttribute('image');
+    this.#media.hidden = !src;
+    if (src) {
+      this.#img.src = src;
+      this.#img.alt = this.getAttribute('image-alt') ?? '';
+    } else {
+      this.#img.removeAttribute('src');
+    }
+  }
+
+  // Generic link text like "View Details" is ambiguous when listed out of
+  // context by assistive tech, so append the card title to its accessible name
+  // (keeping the visible text first to satisfy "label in name").
+  #labelActions() {
+    const title = this.querySelector('[slot="title"]');
+    const titleText = title?.textContent.trim();
+    if (!titleText) return;
+
+    if (!title.id) title.id = `coffee-card-title-${++uid}`;
+
+    for (const action of this.querySelectorAll('[slot="action"]')) {
+      if (action.hasAttribute('aria-label') && !action.dataset.autoLabel) continue;
+      const text = action.textContent.trim();
+      if (!text || text.includes(titleText)) continue;
+      action.setAttribute('aria-label', `${text}: ${titleText}`);
+      action.dataset.autoLabel = '';
+    }
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/components/hero-banner.js b/components/hero-banner.js
new file mode 100644
