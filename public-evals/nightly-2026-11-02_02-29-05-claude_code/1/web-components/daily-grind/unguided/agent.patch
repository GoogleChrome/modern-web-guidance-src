new file mode 100644
index 0000000..7f2dde2
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,56 @@
+// Styles shared across components. Each component adopts these sheets into its
+// own shadow root, so the rules stay encapsulated while design tokens
+// (--primary, --accent, ...) still inherit from the page.
+
+const sheet = (css) => {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+};
+
+export const baseStyles = sheet(`
+  :host {
+    box-sizing: border-box;
+  }
+
+  *,
+  *::before,
+  *::after {
+    box-sizing: inherit;
+  }
+
+  [hidden] {
+    display: none !important;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *,
+    *::before,
+    *::after {
+      transition: none !important;
+    }
+  }
+`);
+
+// Button treatment for slotted call-to-action links.
+export const buttonStyles = sheet(`
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: #fff;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+
+  ::slotted(a:hover) {
+    background: var(--text, #3e2723);
+  }
+
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 2px;
+  }
+`);
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..5832fe8
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,228 @@
+import { baseStyles } from './shared-styles.js';
+
+/**
+ * <site-nav label="Main">
+ *   <a slot="brand" href="/">Brand</a>
+ *   <a href="/menu">Menu</a>
+ *   <a href="/logout" data-variant="outline">Logout</a>
+ * </site-nav>
+ *
+ * Renders a <nav> landmark. Below the collapse breakpoint the links move into
+ * a disclosure toggled by a button (aria-expanded), which closes on Escape,
+ * on outside click, or when a link is chosen.
+ */
+const COLLAPSE_QUERY = '(max-width: 720px)';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--primary, #4e342e);
+    color: #fff;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  .links {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+  }
+
+  ::slotted(a) {
+    color: #fff;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+
+  ::slotted(a:hover),
+  ::slotted(a[aria-current="page"]) {
+    color: var(--accent, #ffab40);
+  }
+
+  ::slotted(a:focus-visible) {
+    outline: 2px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+    border-radius: 2px;
+  }
+
+  ::slotted([data-variant="outline"]) {
+    border: 1px solid var(--accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    background: transparent;
+    color: inherit;
+    font: inherit;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    padding: 6px 10px;
+    cursor: pointer;
+  }
+
+  .toggle:focus-visible {
+    outline: 2px solid var(--accent, #ffab40);
+    outline-offset: 2px;
+  }
+
+  .bars,
+  .bars::before,
+  .bars::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.2s;
+  }
+
+  .bars {
+    position: relative;
+  }
+
+  .bars::before,
+  .bars::after {
+    content: "";
+    position: absolute;
+    left: 0;
+  }
+
+  .bars::before { top: -6px; }
+  .bars::after { top: 6px; }
+
+  :host([open]) .bars { background: transparent; }
+  :host([open]) .bars::before { transform: translateY(6px) rotate(45deg); }
+  :host([open]) .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+  @media ${COLLAPSE_QUERY} {
+    .toggle {
+      display: inline-flex;
+    }
+
+    .links {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 12px;
+      padding-top: 1rem;
+    }
+
+    :host([open]) .links {
+      display: flex;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" type="button" part="toggle" aria-expanded="false" aria-controls="links">
+      <span class="bars" aria-hidden="true"></span>
+      <span>Menu</span>
+    </button>
+    <div class="links" id="links" part="links">
+      <slot></slot>
+    </div>
+  </nav>
+`;
+
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['open', 'label'];
+
+  #nav;
+  #toggle;
+  #mql = window.matchMedia(COLLAPSE_QUERY);
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.append(template.content.cloneNode(true));
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#toggle.addEventListener('click', () => this.toggle());
+    root.querySelector('slot:not([name])').addEventListener('click', (e) => {
+      if (e.target.closest('a')) this.close();
+    });
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+  }
+
+  toggle(force = !this.open) {
+    this.open = force;
+  }
+
+  close({ restoreFocus = false } = {}) {
+    if (!this.open) return;
+    this.open = false;
+    if (restoreFocus) this.#toggle.focus();
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('label')) this.#nav.setAttribute('aria-label', 'Main');
+    document.addEventListener('keydown', this.#onKeydown);
+    document.addEventListener('click', this.#onDocumentClick);
+    this.#mql.addEventListener('change', this.#onBreakpoint);
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('keydown', this.#onKeydown);
+    document.removeEventListener('click', this.#onDocumentClick);
+    this.#mql.removeEventListener('change', this.#onBreakpoint);
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'label') {
+      this.#nav.setAttribute('aria-label', value || 'Main');
+    } else if (name === 'open') {
+      this.#toggle.setAttribute('aria-expanded', String(value !== null));
+      this.dispatchEvent(new CustomEvent('nav-toggle', { detail: { open: value !== null } }));
+    }
+  }
+
+  #onKeydown = (e) => {
+    if (e.key === 'Escape' && this.open) {
+      this.close({ restoreFocus: this.contains(document.activeElement) || Boolean(this.shadowRoot.activeElement) });
+    }
+  };
+
+  #onDocumentClick = (e) => {
+    if (this.open && !e.composedPath().includes(this)) this.close();
+  };
+
+  #onBreakpoint = (e) => {
+    if (!e.matches) this.close();
+  };
+}
+
+customElements.define('site-nav', SiteNav);
