--- /dev/null
+++ b/components/hero-banner.js
@@ -0,0 +1,65 @@
+import { baseStyles, buttonStyles } from './shared-styles.js';
+
+/**
+ * <hero-banner image="..." label="...">
+ *   <h1>Headline</h1>
+ *   <p>Tagline</p>
+ *   <a href="...">Call to action</a>
+ * </hero-banner>
+ *
+ * The background image is decorative; meaningful content lives in the slotted
+ * light DOM. Set role/landmark on the host (e.g. role="banner") as needed.
+ */
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-height: var(--hero-height, 60vh);
+    padding: 40px 20px;
+    color: #fff;
+    text-align: center;
+    background:
+      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--hero-image, none);
+    background-color: var(--primary, #4e342e);
+    background-size: cover;
+    background-position: center;
+  }
+
+  ::slotted(h1) {
+    margin: 0 0 1rem;
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+  }
+
+  ::slotted(p) {
+    margin: 0;
+    max-width: 40rem;
+  }
+`);
+
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, buttonStyles, styles];
+    root.innerHTML = '<slot></slot>';
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'image') {
+      if (value) {
+        this.style.setProperty('--hero-image', `url(${JSON.stringify(value)})`);
+      } else {
+        this.style.removeProperty('--hero-image');
+      }
+    }
+  }
+}
+
+customElements.define('hero-banner', HeroBanner);
