diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..6d3a520
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,330 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  ApiError,
+  authApi,
+  describePasskeyError,
+  registerPasskey,
+  signals,
+  supportsPasskeys,
+  type AccountSummary,
+  type PublicPasskey,
+} from '../lib/passkeys';
+import { PasskeyIcon } from './PasskeyIcon';
+import ReauthDialog from './ReauthDialog';
+
+const formatDate = (iso: string) =>
+  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function AccountSettings({ initialAccount }: { initialAccount: AccountSummary }) {
+  const [account, setAccount] = useState(initialAccount);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmingId, setConfirmingId] = useState<string | null>(null);
+  const [passkeysAvailable, setPasskeysAvailable] = useState(true);
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const pendingAction = useRef<{ key: string; action: () => Promise<void> } | null>(null);
+
+  useEffect(() => {
+    setPasskeysAvailable(supportsPasskeys());
+    // Keep the user's passkey providers in sync with what the server accepts.
+    signals.syncAccount(initialAccount);
+  }, [initialAccount]);
+
+  const updateAccount = (next: AccountSummary) => {
+    setAccount(next);
+    signals.syncAccount(next);
+  };
+
+  /** Runs a sensitive action, asking the user to reauthenticate first if the server requires it. */
+  const withReauth = useCallback(async (key: string, action: () => Promise<void>) => {
+    try {
+      await action();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'reauth_required') {
+        pendingAction.current = { key, action };
+        setReauthOpen(true);
+        return;
+      }
+      throw err;
+    }
+  }, []);
+
+  const run = async (key: string, action: () => Promise<void>) => {
+    setError(null);
+    setNotice(null);
+    setBusy(key);
+    try {
+      await withReauth(key, action);
+    } catch (err) {
+      setError(describePasskeyError(err));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleVerified = async () => {
+    setReauthOpen(false);
+    const pending = pendingAction.current;
+    pendingAction.current = null;
+    authApi<AccountSummary>('passkeys').then(setAccount, () => {});
+    if (pending) run(pending.key, pending.action);
+  };
+
+  const handleReauthCancel = useCallback(() => {
+    pendingAction.current = null;
+    setReauthOpen(false);
+  }, []);
+
+  const addPasskey = () =>
+    run('add', async () => {
+      const { passkey, account: next } = await registerPasskey();
+      setAccount(next);
+      setNotice(`Passkey “${passkey.name}” created. You can now use it to sign in.`);
+    });
+
+  const renamePasskey = (passkey: PublicPasskey) =>
+    run(passkey.id, async () => {
+      const next = await authApi<AccountSummary>(`passkeys/${encodeURIComponent(passkey.id)}`, {
+        method: 'PATCH',
+        body: { name: draftName },
+      });
+      setAccount(next);
+      setEditingId(null);
+      setNotice('Passkey renamed.');
+    });
+
+  const deletePasskey = (passkey: PublicPasskey) =>
+    run(passkey.id, async () => {
+      const next = await authApi<AccountSummary>(`passkeys/${encodeURIComponent(passkey.id)}`, {
+        method: 'DELETE',
+      });
+      updateAccount(next);
+      setConfirmingId(null);
+      setNotice(
+        `Passkey “${passkey.name}” removed. You may also want to delete it from your password manager.`,
+      );
+    });
+
+  const signOut = async () => {
+    setBusy('signout');
+    await authApi('logout', { body: {} }).catch(() => {});
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  const isOnlySignInMethod = !account.hasPassword && account.passkeys.length === 1;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-6">
+      <div className="flex items-end justify-between">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-800">Account settings</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as <strong>{account.username}</strong>
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={signOut}
+          disabled={busy === 'signout'}
+          className="py-2 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-800 bg-white hover:bg-gray-50"
+        >
+          {busy === 'signout' ? 'Signing out...' : 'Sign out'}
+        </button>
+      </div>
+
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {notice && (
+        <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {notice}
+        </div>
+      )}
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <div className="flex items-start justify-between gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+              Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Sign in with your fingerprint, face, or screen lock. Passkeys are stored by your device or password
+              manager and can’t be phished.
+            </p>
+          </div>
+          {passkeysAvailable && account.passkeys.length > 0 && (
+            <button
+              type="button"
+              onClick={addPasskey}
+              disabled={busy !== null}
+              className="shrink-0 py-2 px-3 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+            >
+              {busy === 'add' ? 'Waiting...' : 'Add a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!passkeysAvailable && (
+          <p className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser doesn’t support passkeys. Try a recent version of Chrome, Safari, Edge, or Firefox.
+          </p>
+        )}
+
+        {account.passkeys.length === 0 ? (
+          <div className="mt-6 p-6 text-center border border-dashed border-gray-300 rounded-lg">
+            <PasskeyIcon className="w-10 h-10 mx-auto text-gray-700" />
+            <p className="mt-2 font-semibold text-gray-800">You don’t have any passkeys yet</p>
+            <p className="text-sm text-gray-600 mb-4">Create one to sign in faster without a password.</p>
+            {passkeysAvailable && (
+              <button
+                type="button"
+                onClick={addPasskey}
+                disabled={busy !== null}
+                className="py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+              >
+                {busy === 'add' ? 'Waiting for passkey...' : 'Create a passkey'}
+              </button>
+            )}
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {account.passkeys.map((passkey) => (
+              <li key={passkey.id} className="py-4 flex items-start gap-4">
+                <PasskeyIcon className="w-8 h-8 mt-1 shrink-0 text-gray-700" />
+                <div className="flex-1 min-w-0">
+                  {editingId === passkey.id ? (
+                    <form
+                      onSubmit={(e) => {
+                        e.preventDefault();
+                        renamePasskey(passkey);
+                      }}
+                      className="flex gap-2"
+                    >
+                      <label htmlFor={`name-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`name-${passkey.id}`}
+                        value={draftName}
+                        onChange={(e) => setDraftName(e.target.value)}
+                        maxLength={64}
+                        required
+                        autoFocus
+                        className="flex-1 min-w-0 px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        disabled={busy !== null}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+                      >
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-800 truncate">
+                      {passkey.name}
+                      {passkey.synced && (
+                        <span className="ml-2 align-middle text-xs font-medium text-green-800 bg-green-100 rounded px-1.5 py-0.5">
+                          Synced
+                        </span>
+                      )}
+                    </p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-1">
+                    {passkey.provider && passkey.provider !== passkey.name && <>{passkey.provider} · </>}
+                    Created {formatDate(passkey.createdAt)} ·{' '}
+                    {passkey.lastUsedAt ? `Last used ${formatDate(passkey.lastUsedAt)}` : 'Never used'}
+                  </p>
+
+                  {confirmingId === passkey.id && (
+                    <div className="mt-3 p-3 bg-red-50 rounded-md text-sm" role="alert">
+                      <p className="text-red-800">
+                        Remove this passkey? You won’t be able to sign in with it anymore.
+                      </p>
+                      <div className="mt-2 flex gap-2">
+                        <button
+                          type="button"
+                          onClick={() => deletePasskey(passkey)}
+                          disabled={busy !== null}
+                          className="px-3 py-1 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800 disabled:opacity-75"
+                        >
+                          {busy === passkey.id ? 'Removing...' : 'Remove'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setConfirmingId(null)}
+                          className="px-3 py-1 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+                        >
+                          Keep
+                        </button>
+                      </div>
+                    </div>
+                  )}
+                </div>
+
+                {editingId !== passkey.id && confirmingId !== passkey.id && (
+                  <div className="flex shrink-0 gap-1">
+                    <button
+                      type="button"
+                      onClick={() => {
+                        setEditingId(passkey.id);
+                        setDraftName(passkey.name);
+                        setConfirmingId(null);
+                      }}
+                      className="px-2 py-1 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+                      aria-label={`Rename ${passkey.name}`}
+                    >
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => {
+                        setConfirmingId(passkey.id);
+                        setEditingId(null);
+                      }}
+                      disabled={isOnlySignInMethod}
+                      title={isOnlySignInMethod ? 'Add another passkey before removing your only one.' : undefined}
+                      className="px-2 py-1 rounded-md text-sm font-medium text-red-700 hover:bg-red-50 disabled:text-gray-400 disabled:hover:bg-transparent disabled:cursor-not-allowed"
+                      aria-label={`Remove ${passkey.name}`}
+                    >
+                      Remove
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {isOnlySignInMethod && (
+          <p className="mt-4 text-xs text-gray-500">
+            This passkey is the only way to sign in to your account. Add a passkey on another device as a backup.
+          </p>
+        )}
+      </section>
+
+      {reauthOpen && (
+        <ReauthDialog
+          username={account.username}
+          canUsePasskey={passkeysAvailable && account.passkeys.length > 0}
+          canUsePassword={account.hasPassword}
+          onVerified={handleVerified}
+          onCancel={handleReauthCancel}
+        />
+      )}
+    </div>
+  );
+}
