+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { accountSummary } from '../lib/auth/account';
+import { getAuth } from '../lib/auth/session';
+import { ensureUser } from '../lib/auth/store';
+
+const auth = await getAuth(Astro.session);
+if (!auth) {
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin`);
+}
+
+const user = await ensureUser(auth.username, { hasPassword: auth.method === 'password' });
+const account = accountSummary(user, auth, Astro.url);
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings client:load initialAccount={account} />
+  </div>
+</Layout>
