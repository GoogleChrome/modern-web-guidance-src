--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,78 @@
+import type { AstroSession } from 'astro';
+
+type Session = AstroSession | undefined;
+
+export type AuthMethod = 'password' | 'passkey';
+
+export interface AuthState {
+  username: string;
+  method: AuthMethod;
+  /** Epoch ms of the most recent sign-in or reauthentication. */
+  verifiedAt: number;
+}
+
+/** Sensitive account changes require the user to have verified within this window. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+/** WebAuthn challenges expire after this long. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export async function getAuth(session: Session): Promise<AuthState | null> {
+  return ((await session?.get('auth')) as AuthState | undefined) ?? null;
+}
+
+export async function signIn(session: Session, username: string, method: AuthMethod) {
+  if (!session) throw new Error('Sessions are not configured');
+  // Fresh session ID on privilege change to prevent session fixation.
+  await session.regenerate();
+  session.set('auth', { username, method, verifiedAt: Date.now() } satisfies AuthState);
+}
+
+export async function markReauthenticated(session: Session, method: AuthMethod) {
+  const auth = await getAuth(session);
+  if (!auth) return;
+  session!.set('auth', { ...auth, method, verifiedAt: Date.now() } satisfies AuthState);
+}
+
+export function signOut(session: Session) {
+  session?.delete('auth');
+  session?.delete('webauthn');
+}
+
+export function isRecentlyVerified(auth: AuthState) {
+  return Date.now() - auth.verifiedAt < REAUTH_WINDOW_MS;
+}
+
+export type CeremonyState =
+  | {
+      type: 'registration';
+      challenge: string;
+      username: string;
+      /** 'signup' creates a passkey-only account; 'add' adds to the signed-in account. */
+      mode: 'signup' | 'add';
+      webauthnUserID: string;
+      createdAt: number;
+    }
+  | {
+      type: 'authentication';
+      challenge: string;
+      /** 'signin' starts a session; 'reauth' confirms the signed-in user. */
+      purpose: 'signin' | 'reauth';
+      createdAt: number;
+    };
+
+export function setCeremony(session: Session, state: CeremonyState) {
+  session?.set('webauthn', state);
+}
+
+/** Reads and clears the pending ceremony so each challenge can only be used once. */
+export async function takeCeremony<T extends CeremonyState['type']>(
+  session: Session,
+  type: T,
+): Promise<Extract<CeremonyState, { type: T }> | null> {
+  const state = (await session?.get('webauthn')) as CeremonyState | undefined;
+  if (!state || state.type !== type) return null;
+  session!.delete('webauthn');
+  if (Date.now() - state.createdAt > CHALLENGE_TTL_MS) return null;
+  return state as Extract<CeremonyState, { type: T }>;
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..6266db4
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,153 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+/**
+ * A tiny file-backed store for user accounts and their passkeys.
+ *
+ * Username/password accounts live in the external Times API; this store only
+ * keeps what the WebAuthn relying party needs: a stable, opaque user handle per
+ * username and the public keys of the passkeys registered to it.
+ */
+
+export interface StoredPasskey {
+  /** Base64URL credential ID. */
+  id: string;
+  /** Base64URL COSE public key. */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface StoredUser {
+  username: string;
+  /** Base64URL WebAuthn user handle (random, never the username). */
+  webauthnUserID: string;
+  /** Whether the account can also sign in with a password. */
+  hasPassword: boolean;
+  passkeys: StoredPasskey[];
+  createdAt: string;
+}
+
+interface Database {
+  users: Record<string, StoredUser>;
+}
+
+const DB_PATH = resolve(process.env.PASSKEY_DB_PATH ?? '.data/passkeys.json');
+
+let cache: Database | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DB_PATH, 'utf8')) as Database;
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: {} };
+  }
+  return cache;
+}
+
+async function persist(db: Database) {
+  await mkdir(dirname(DB_PATH), { recursive: true });
+  const tmp = `${DB_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(db, null, 2));
+  await rename(tmp, DB_PATH);
+}
+
+/** Runs a read-modify-write transaction; transactions are serialized. */
+function transact<T>(fn: (db: Database) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    await persist(db);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+const key = (username: string) => username.trim().toLowerCase();
+
+export const newWebAuthnUserID = () => randomBytes(32).toString('base64url');
+
+export async function getUser(username: string): Promise<StoredUser | null> {
+  await queue;
+  const db = await load();
+  return db.users[key(username)] ?? null;
+}
+
+export async function findUserByCredentialID(
+  credentialID: string,
+): Promise<{ user: StoredUser; passkey: StoredPasskey } | null> {
+  await queue;
+  const db = await load();
+  for (const user of Object.values(db.users)) {
+    const passkey = user.passkeys.find((p) => p.id === credentialID);
+    if (passkey) return { user, passkey };
+  }
+  return null;
+}
+
+/** Returns the local record for a username, creating it if needed. */
+export function ensureUser(
+  username: string,
+  opts: { hasPassword: boolean; webauthnUserID?: string },
+): Promise<StoredUser> {
+  return transact((db) => {
+    const k = key(username);
+    let user = db.users[k];
+    if (!user) {
+      user = {
+        username: username.trim(),
+        webauthnUserID: opts.webauthnUserID ?? newWebAuthnUserID(),
+        hasPassword: opts.hasPassword,
+        passkeys: [],
+        createdAt: new Date().toISOString(),
+      };
+      db.users[k] = user;
+    } else if (opts.hasPassword) {
+      user.hasPassword = true;
+    }
+    return user;
+  });
+}
+
+export function addPasskey(username: string, passkey: StoredPasskey): Promise<StoredUser> {
+  return transact((db) => {
+    const user = db.users[key(username)];
+    if (!user) throw new Error('Unknown user');
+    user.passkeys.push(passkey);
+    return user;
+  });
+}
+
+export function updatePasskey(
+  username: string,
+  credentialID: string,
+  patch: Partial<Pick<StoredPasskey, 'name' | 'counter' | 'backedUp' | 'lastUsedAt'>>,
+): Promise<StoredPasskey | null> {
+  return transact((db) => {
+    const passkey = db.users[key(username)]?.passkeys.find((p) => p.id === credentialID);
+    if (!passkey) return null;
+    Object.assign(passkey, patch);
+    return passkey;
+  });
+}
+
+export function removePasskey(username: string, credentialID: string): Promise<boolean> {
+  return transact((db) => {
+    const user = db.users[key(username)];
+    if (!user) return false;
+    const before = user.passkeys.length;
+    user.passkeys = user.passkeys.filter((p) => p.id !== credentialID);
+    return user.passkeys.length !== before;
+  });
+}
diff --git a/src/lib/auth/timesApi.ts b/src/lib/auth/timesApi.ts
new file mode 100644
index 0000000..cb5523d
--- /dev/null
+++ b/src/lib/auth/timesApi.ts
@@ -0,0 +1,31 @@
+import { randomBytes } from 'node:crypto';
+
+const API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface TimesApiResult {
+  ok: boolean;
+  status: number;
+  data: { error?: string; [key: string]: unknown };
+}
+
+async function call(path: 'login' | 'register', username: string, password: string): Promise<TimesApiResult> {
+  const response = await fetch(`${API_BASE}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, status: response.status, data };
+}
+
+export const login = (username: string, password: string) => call('login', username, password);
+
+export const register = (username: string, password: string) => call('register', username, password);
+
+/**
+ * Reserves a username for a passkey-only account. The Times API requires a
+ * password, so a random one is generated and immediately discarded; the account
+ * can only be accessed with its passkeys.
+ */
+export const registerPasswordless = (username: string) =>
+  register(username, `${randomBytes(24).toString('base64url')}7`);
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..39f7046
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,163 @@
+import {
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  WebAuthnAbortService,
+  WebAuthnError,
+} from '@simplewebauthn/browser';
+import type { AccountSummary } from './auth/account';
+import type { PublicPasskey } from './auth/relyingParty';
+
+export type { AccountSummary, PublicPasskey };
+
+const AUTH_API = `${import.meta.env.BASE_URL}api/auth`;
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public status: number,
+    public code?: string,
+    public data: Record<string, any> = {},
+  ) {
+    super(message);
+  }
+}
+
+/** Thrown when the user dismisses the browser's passkey dialog. */
+export class PasskeyCancelledError extends Error {}
+
+export async function authApi<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(`${AUTH_API}/${path}`, {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: init.body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+    credentials: 'same-origin',
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ApiError(data.error || 'Unknown error', response.status, data.code, data);
+  }
+  return data as T;
+}
+
+export const supportsPasskeys = () => browserSupportsWebAuthn();
+
+export const supportsPasskeyAutofill = () => browserSupportsWebAuthnAutofill();
+
+/** Whether the browser can silently create a passkey after a password sign-in. */
+export async function supportsConditionalCreate() {
+  const PKC = (globalThis as any).PublicKeyCredential;
+  if (typeof PKC?.getClientCapabilities !== 'function') return false;
+  try {
+    return Boolean((await PKC.getClientCapabilities()).conditionalCreate);
+  } catch {
+    return false;
+  }
+}
+
+/** Aborts any in-flight WebAuthn request started by this module (e.g. pending autofill). */
+export const cancelPasskeyRequest = () => WebAuthnAbortService.cancelCeremony();
+
+function normalizeWebAuthnError(err: unknown): never {
+  if (err instanceof WebAuthnError) {
+    const cause = err.cause as Error | undefined;
+    if (err.code === 'ERROR_CEREMONY_ABORTED' || cause?.name === 'NotAllowedError' || cause?.name === 'AbortError') {
+      throw new PasskeyCancelledError(err.message);
+    }
+    if (err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+      throw new Error('This device already has a passkey for your account.');
+    }
+  } else if (err instanceof Error && (err.name === 'NotAllowedError' || err.name === 'AbortError')) {
+    throw new PasskeyCancelledError(err.message);
+  }
+  throw err;
+}
+
+/** Best-effort Signal API calls; unsupported browsers simply ignore them. */
+export const signals = {
+  unknownCredential(rpID: string, credentialID: string) {
+    sendSignal({ signalName: 'unknownCredential', rpID, credentialID }).catch(() => {});
+  },
+  syncAccount(account: AccountSummary) {
+    sendSignal({
+      signalName: 'allAcceptedCredentials',
+      rpID: account.rpID,
+      userID: account.userID,
+      allAcceptedCredentialIDs: account.passkeys.map((p) => p.id),
+    }).catch(() => {});
+    sendSignal({
+      signalName: 'currentUserDetails',
+      rpID: account.rpID,
+      userID: account.userID,
+      userName: account.username,
+      userDisplayName: account.username,
+    }).catch(() => {});
+  },
+};
+
+function signalIfRejected(err: unknown) {
+  if (err instanceof ApiError && err.data.rpID && err.data.credentialID) {
+    signals.unknownCredential(err.data.rpID, err.data.credentialID);
+  }
+}
+
+/**
+ * Creates a passkey. Pass `username` to sign up with a passkey-only account;
+ * omit it to add a passkey to the signed-in account.
+ */
+export async function registerPasskey(
+  opts: { username?: string; useAutoRegister?: boolean } = {},
+): Promise<{ passkey: PublicPasskey; account: AccountSummary }> {
+  const optionsJSON = await authApi('webauthn/register-options', { body: { username: opts.username } });
+
+  let response;
+  try {
+    response = await startRegistration({ optionsJSON, useAutoRegister: opts.useAutoRegister });
+  } catch (err) {
+    normalizeWebAuthnError(err);
+  }
+
+  try {
+    const result = await authApi('webauthn/register-verify', { body: { response } });
+    signals.syncAccount(result.account);
+    return result;
+  } catch (err) {
+    signalIfRejected(err);
+    throw err;
+  }
+}
+
+/**
+ * Signs in (or reauthenticates) with a passkey. With `autofill`, the request
+ * waits for the user to pick a passkey from the username field's autofill.
+ */
+export async function authenticateWithPasskey(
+  opts: { purpose?: 'signin' | 'reauth'; autofill?: boolean } = {},
+): Promise<{ account: AccountSummary }> {
+  const purpose = opts.purpose ?? 'signin';
+  const optionsJSON = await authApi('webauthn/authenticate-options', { body: { purpose } });
+
+  let response;
+  try {
+    response = await startAuthentication({ optionsJSON, useBrowserAutofill: opts.autofill });
+  } catch (err) {
+    normalizeWebAuthnError(err);
+  }
+
+  try {
+    const result = await authApi('webauthn/authenticate-verify', { body: { response } });
+    if (purpose === 'signin') signals.syncAccount(result.account);
+    return result;
+  } catch (err) {
+    signalIfRejected(err);
+    throw err;
+  }
+}
+
+export function describePasskeyError(err: unknown): string | null {
+  if (err instanceof PasskeyCancelledError) return null;
+  if (err instanceof ApiError || err instanceof Error) return err.message;
+  return 'Something went wrong. Please try again.';
+}
