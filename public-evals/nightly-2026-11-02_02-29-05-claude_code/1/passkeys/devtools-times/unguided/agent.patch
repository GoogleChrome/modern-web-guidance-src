diff --git a/src/lib/auth/account.ts b/src/lib/auth/account.ts
new file mode 100644
index 0000000..dc5557e
--- /dev/null
+++ b/src/lib/auth/account.ts
@@ -0,0 +1,25 @@
+import { getRelyingParty, toPublicPasskey, type PublicPasskey } from './relyingParty';
+import { REAUTH_WINDOW_MS, type AuthState } from './session';
+import type { StoredUser } from './store';
+
+export interface AccountSummary {
+  username: string;
+  hasPassword: boolean;
+  passkeys: PublicPasskey[];
+  /** Epoch ms after which sensitive actions need reauthentication. */
+  verifiedUntil: number;
+  /** Values the browser needs for the WebAuthn Signal API. */
+  rpID: string;
+  userID: string;
+}
+
+export function accountSummary(user: StoredUser, auth: AuthState, url: URL): AccountSummary {
+  return {
+    username: user.username,
+    hasPassword: user.hasPassword,
+    passkeys: user.passkeys.map(toPublicPasskey),
+    verifiedUntil: auth.verifiedAt + REAUTH_WINDOW_MS,
+    rpID: getRelyingParty(url).rpID,
+    userID: user.webauthnUserID,
+  };
+}
diff --git a/src/lib/auth/http.ts b/src/lib/auth/http.ts
new file mode 100644
index 0000000..e3dff35
--- /dev/null
+++ b/src/lib/auth/http.ts
@@ -0,0 +1,44 @@
+import { getAuth, isRecentlyVerified, type AuthState } from './session';
+import type { AstroSession } from 'astro';
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function error(status: number, code: string, message: string) {
+  return json({ error: message, code }, status);
+}
+
+/**
+ * Parses a JSON request body. Non-JSON bodies are ignored: browsers can't send
+ * `application/json` cross-site without a CORS preflight, which guards these
+ * endpoints against CSRF (the app disables Astro's origin check).
+ */
+export async function readJSON<T = any>(request: Request): Promise<Partial<T>> {
+  if (!request.headers.get('content-type')?.includes('application/json')) return {};
+  try {
+    const body = await request.json();
+    return body && typeof body === 'object' ? body : {};
+  } catch {
+    return {};
+  }
+}
+
+/**
+ * Resolves the signed-in user, or an error response. With `recent: true`, also
+ * requires that the user signed in or reauthenticated within the reauth window.
+ */
+export async function requireAuth(
+  session: AstroSession | undefined,
+  { recent = false } = {},
+): Promise<{ auth: AuthState; response?: never } | { auth?: never; response: Response }> {
+  const auth = await getAuth(session);
+  if (!auth) return { response: error(401, 'unauthenticated', 'You need to sign in first.') };
+  if (recent && !isRecentlyVerified(auth)) {
+    return { response: error(403, 'reauth_required', 'Please confirm it’s you to continue.') };
+  }
+  return { auth };
+}
diff --git a/src/lib/auth/relyingParty.ts b/src/lib/auth/relyingParty.ts
new file mode 100644
index 0000000..f65c106
--- /dev/null
+++ b/src/lib/auth/relyingParty.ts
@@ -0,0 +1,56 @@
+import type { StoredPasskey } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+
+/**
+ * The relying party ID and accepted origins are derived from the request URL
+ * (which honours X-Forwarded-* for the hosts in `security.allowedDomains`).
+ * Set WEBAUTHN_RP_ID / WEBAUTHN_ORIGINS (comma-separated) to pin them instead.
+ */
+export function getRelyingParty(url: URL) {
+  const rpID = process.env.WEBAUTHN_RP_ID || url.hostname;
+  const origins = process.env.WEBAUTHN_ORIGINS
+    ? process.env.WEBAUTHN_ORIGINS.split(',').map((o) => o.trim()).filter(Boolean)
+    : [url.origin];
+  return { rpID, origins };
+}
+
+/** Friendly names for common passkey providers, keyed by AAGUID. */
+const PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'cc45f64e-52a2-451b-831a-4edd8022a202': 'ToothPic Passkey Provider',
+};
+
+export function defaultPasskeyName(aaguid: string, deviceType: StoredPasskey['deviceType']) {
+  return PROVIDERS[aaguid] ?? (deviceType === 'multiDevice' ? 'Synced passkey' : 'Security key');
+}
+
+/** The subset of a stored passkey that is safe to send to the browser. */
+export function toPublicPasskey(p: StoredPasskey) {
+  return {
+    id: p.id,
+    name: p.name,
+    provider: PROVIDERS[p.aaguid] ?? null,
+    synced: p.deviceType === 'multiDevice' && p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export type PublicPasskey = ReturnType<typeof toPublicPasskey>;
