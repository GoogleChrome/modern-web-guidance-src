@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { accountSummary } from '../../../../lib/auth/account';
+import { error, json, readJSON, requireAuth } from '../../../../lib/auth/http';
+import { getUser, removePasskey, updatePasskey } from '../../../../lib/auth/store';
+
+export const PATCH: APIRoute = async ({ params, request, session, url }) => {
+  const { auth, response } = await requireAuth(session);
+  if (response) return response;
+
+  const { name } = await readJSON<{ name: string }>(request);
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return error(400, 'invalid_name', 'Passkey names must be between 1 and 64 characters.');
+  }
+
+  const updated = await updatePasskey(auth.username, params.id!, { name: trimmed });
+  if (!updated) return error(404, 'not_found', 'Passkey not found.');
+
+  return json(accountSummary((await getUser(auth.username))!, auth, url));
+};
+
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const { auth, response } = await requireAuth(session, { recent: true });
+  if (response) return response;
+
+  const user = await getUser(auth.username);
+  if (!user?.passkeys.some((p) => p.id === params.id)) {
+    return error(404, 'not_found', 'Passkey not found.');
+  }
+  if (!user.hasPassword && user.passkeys.length === 1) {
+    return error(
+      409,
+      'last_passkey',
+      'This is the only way to sign in to your account. Add another passkey before removing this one.',
+    );
+  }
+
+  await removePasskey(auth.username, params.id!);
+  return json(accountSummary((await getUser(auth.username))!, auth, url));
+};
