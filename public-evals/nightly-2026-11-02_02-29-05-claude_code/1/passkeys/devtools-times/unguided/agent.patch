+import React from 'react';
+
+/** The passkey glyph (a person with a key), drawn in the current text colour. */
+export function PasskeyIcon({ className = 'w-5 h-5' }: { className?: string }) {
+  return (
+    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" className={className}>
+      <circle cx="9" cy="7" r="4" />
+      <path d="M2 19.5C2 16.46 4.46 14 7.5 14h3c.9 0 1.75.22 2.5.6V21H3.5A1.5 1.5 0 0 1 2 19.5Z" />
+      <path
+        fillRule="evenodd"
+        d="M18.5 8.5a3.5 3.5 0 0 0-1.5 6.66V20l1.5 1.5L20 20v-1l-.75-.75L20 17.5v-2.34A3.5 3.5 0 0 0 18.5 8.5Zm0 1.75a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"
+      />
+    </svg>
+  );
+}
diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
new file mode 100644
index 0000000..e09bf4c
--- /dev/null
+++ b/src/components/ReauthDialog.tsx
@@ -0,0 +1,130 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ApiError, authApi, authenticateWithPasskey, describePasskeyError } from '../lib/passkeys';
+import { PasskeyIcon } from './PasskeyIcon';
+
+interface ReauthDialogProps {
+  username: string;
+  canUsePasskey: boolean;
+  canUsePassword: boolean;
+  onVerified: () => void;
+  onCancel: () => void;
+}
+
+/** Asks the signed-in user to confirm their identity before a sensitive change. */
+export default function ReauthDialog({ username, canUsePasskey, canUsePassword, onVerified, onCancel }: ReauthDialogProps) {
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState<'passkey' | 'password' | null>(null);
+  const dialogRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    dialogRef.current?.querySelector<HTMLElement>('button, input')?.focus();
+    const onKeyDown = (e: KeyboardEvent) => e.key === 'Escape' && onCancel();
+    document.addEventListener('keydown', onKeyDown);
+    return () => document.removeEventListener('keydown', onKeyDown);
+  }, [onCancel]);
+
+  const verifyWithPasskey = async () => {
+    setError(null);
+    setBusy('passkey');
+    try {
+      await authenticateWithPasskey({ purpose: 'reauth' });
+      onVerified();
+    } catch (err) {
+      setError(describePasskeyError(err));
+      setBusy(null);
+    }
+  };
+
+  const verifyWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setBusy('password');
+    try {
+      await authApi('reauthenticate', { body: { password } });
+      onVerified();
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'An unexpected error occurred. Please try again later.');
+      setBusy(null);
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" onClick={onCancel}>
+      <div
+        ref={dialogRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="reauth-title"
+        onClick={(e) => e.stopPropagation()}
+        className="w-full max-w-sm rounded-lg bg-white p-6 shadow-xl"
+      >
+        <h2 id="reauth-title" className="text-xl font-bold text-gray-800">
+          Confirm it’s you
+        </h2>
+        <p className="mt-1 mb-4 text-sm text-gray-600">
+          For your security, verify your identity as <strong>{username}</strong> to continue.
+        </p>
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {canUsePasskey && (
+          <button
+            type="button"
+            onClick={verifyWithPasskey}
+            disabled={busy !== null}
+            className="w-full flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+          >
+            <PasskeyIcon className="w-5 h-5" />
+            {busy === 'passkey' ? 'Waiting for passkey...' : 'Use your passkey'}
+          </button>
+        )}
+
+        {canUsePasskey && canUsePassword && (
+          <div className="my-4 flex items-center gap-3 text-xs uppercase tracking-wide text-gray-400">
+            <span className="h-px flex-1 bg-gray-200" />
+            or
+            <span className="h-px flex-1 bg-gray-200" />
+          </div>
+        )}
+
+        {canUsePassword && (
+          <form onSubmit={verifyWithPassword} className="space-y-3">
+            <input type="text" name="username" autoComplete="username" value={username} readOnly hidden />
+            <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">
+              Password
+            </label>
+            <input
+              type="password"
+              id="reauth-password"
+              autoComplete="current-password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button
+              type="submit"
+              disabled={busy !== null}
+              className="w-full py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 disabled:opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+            >
+              {busy === 'password' ? 'Verifying...' : 'Continue with password'}
+            </button>
+          </form>
+        )}
+
+        <button
+          type="button"
+          onClick={onCancel}
+          className="mt-4 w-full text-center text-sm font-medium text-gray-600 hover:text-gray-900 underline"
+        >
+          Cancel
+        </button>
+      </div>
+    </div>
+  );
+}
