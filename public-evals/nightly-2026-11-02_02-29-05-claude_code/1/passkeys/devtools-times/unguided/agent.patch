@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { error, json, readJSON, requireAuth } from '../../../lib/auth/http';
+import { markReauthenticated } from '../../../lib/auth/session';
+import { ensureUser } from '../../../lib/auth/store';
+import { login } from '../../../lib/auth/timesApi';
+
+/** Password reauthentication. Passkey reauthentication goes through the passkey authentication endpoints. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { auth, response } = await requireAuth(session);
+  if (response) return response;
+
+  const { password } = await readJSON<{ password: string }>(request);
+  if (typeof password !== 'string' || !password) {
+    return error(400, 'invalid_request', 'Password is required.');
+  }
+
+  const result = await login(auth.username, password);
+  if (!result.ok) return error(401, 'invalid_password', 'That password is incorrect.');
+
+  await ensureUser(auth.username, { hasPassword: true });
+  await markReauthenticated(session, 'password');
+  return json({ ok: true, verifiedAt: Date.now() });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
new file mode 100644
index 0000000..3e54a2e
--- /dev/null
+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { error, json, readJSON } from '../../../lib/auth/http';
+import { signIn } from '../../../lib/auth/session';
+import { ensureUser, getUser } from '../../../lib/auth/store';
+import { register } from '../../../lib/auth/timesApi';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await readJSON<{ username: string; password: string }>(request);
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return error(400, 'invalid_request', 'Username and password are required.');
+  }
+  if (await getUser(username)) {
+    return error(409, 'username_taken', 'That username is already taken.');
+  }
+
+  const result = await register(username.trim(), password);
+  if (!result.ok) return json(result.data, result.status);
+
+  const user = await ensureUser(username, { hasPassword: true });
+  await signIn(session, user.username, 'password');
+  return json({ ...result.data, username: user.username });
+};
diff --git a/src/pages/api/auth/webauthn/authenticate-options.ts b/src/pages/api/auth/webauthn/authenticate-options.ts
new file mode 100644
index 0000000..0fa30a1
--- /dev/null
+++ b/src/pages/api/auth/webauthn/authenticate-options.ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { error, json, readJSON, requireAuth } from '../../../../lib/auth/http';
+import { getRelyingParty } from '../../../../lib/auth/relyingParty';
+import { setCeremony } from '../../../../lib/auth/session';
+import { getUser } from '../../../../lib/auth/store';
+
+/**
+ * Starts passkey authentication.
+ * - `signin`: any discoverable passkey for this site (also used for autofill).
+ * - `reauth`: one of the signed-in user's passkeys, with user verification.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { rpID } = getRelyingParty(url);
+  const { purpose = 'signin' } = await readJSON<{ purpose: 'signin' | 'reauth' }>(request);
+
+  if (purpose === 'reauth') {
+    const { auth, response } = await requireAuth(session);
+    if (response) return response;
+    const user = await getUser(auth.username);
+    if (!user?.passkeys.length) {
+      return error(400, 'no_passkeys', 'There are no passkeys on this account.');
+    }
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+      userVerification: 'required',
+    });
+    setCeremony(session, { type: 'authentication', purpose, challenge: options.challenge, createdAt: Date.now() });
+    return json(options);
+  }
+
+  if (purpose !== 'signin') return error(400, 'invalid_request', 'Unknown purpose.');
+
+  const options = await generateAuthenticationOptions({ rpID, userVerification: 'preferred' });
+  setCeremony(session, { type: 'authentication', purpose, challenge: options.challenge, createdAt: Date.now() });
+  return json(options);
+};
diff --git a/src/pages/api/auth/webauthn/authenticate-verify.ts b/src/pages/api/auth/webauthn/authenticate-verify.ts
new file mode 100644
index 0000000..c8679ba
--- /dev/null
+++ b/src/pages/api/auth/webauthn/authenticate-verify.ts
@@ -0,0 +1,75 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { accountSummary } from '../../../../lib/auth/account';
+import { error, json, readJSON } from '../../../../lib/auth/http';
+import { getRelyingParty } from '../../../../lib/auth/relyingParty';
+import { getAuth, markReauthenticated, signIn, takeCeremony } from '../../../../lib/auth/session';
+import { findUserByCredentialID, getUser, updatePasskey } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { response: assertion } = await readJSON<{ response: AuthenticationResponseJSON }>(request);
+  if (!assertion?.id) return error(400, 'invalid_request', 'Missing passkey response.');
+
+  const { rpID, origins } = getRelyingParty(url);
+  const ceremony = await takeCeremony(session, 'authentication');
+  if (!ceremony) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+
+  const found = await findUserByCredentialID(assertion.id);
+  if (!found) {
+    // rpID + credentialID let the browser hide this stale passkey via the Signal API.
+    return json(
+      {
+        error: 'This passkey is no longer registered with The DevTools Times.',
+        code: 'unknown_credential',
+        rpID,
+        credentialID: assertion.id,
+      },
+      404,
+    );
+  }
+  const { user, passkey } = found;
+
+  const auth = await getAuth(session);
+  if (ceremony.purpose === 'reauth' && auth?.username !== user.username) {
+    return error(403, 'wrong_account', 'That passkey belongs to a different account.');
+  }
+
+  const userHandle = assertion.response.userHandle;
+  if (userHandle && userHandle !== user.webauthnUserID) {
+    return error(400, 'verification_failed', 'Passkey could not be verified.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: assertion,
+      expectedChallenge: ceremony.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64url')),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: ceremony.purpose === 'reauth',
+    });
+  } catch (err) {
+    return error(400, 'verification_failed', `Passkey could not be verified: ${(err as Error).message}`);
+  }
+  if (!verification.verified) return error(400, 'verification_failed', 'Passkey could not be verified.');
+
+  await updatePasskey(user.username, passkey.id, {
+    counter: verification.authenticationInfo.newCounter,
+    backedUp: verification.authenticationInfo.credentialBackedUp,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (ceremony.purpose === 'signin') {
+    await signIn(session, user.username, 'passkey');
+  } else {
+    await markReauthenticated(session, 'passkey');
+  }
+
+  return json({ account: accountSummary((await getUser(user.username))!, (await getAuth(session))!, url) });
+};
diff --git a/src/pages/api/auth/webauthn/register-options.ts b/src/pages/api/auth/webauthn/register-options.ts
new file mode 100644
index 0000000..ae21b6b
--- /dev/null
+++ b/src/pages/api/auth/webauthn/register-options.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { error, json, readJSON, requireAuth } from '../../../../lib/auth/http';
+import { getRelyingParty, RP_NAME } from '../../../../lib/auth/relyingParty';
+import { getAuth, setCeremony } from '../../../../lib/auth/session';
+import { ensureUser, getUser, newWebAuthnUserID } from '../../../../lib/auth/store';
+
+const USERNAME_PATTERN = /^[A-Za-z0-9._-]{3,32}$/;
+
+/**
+ * Starts passkey registration.
+ * - Signed in: adds a passkey to the current account (requires recent verification).
+ * - Signed out: starts a passkey-only sign-up for `username`.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { rpID } = getRelyingParty(url);
+  let username: string;
+  let webauthnUserID: string;
+  let excludeCredentials: { id: string; transports?: string[] }[] = [];
+  let mode: 'signup' | 'add';
+
+  if (await getAuth(session)) {
+    const { auth, response } = await requireAuth(session, { recent: true });
+    if (response) return response;
+    const user = await ensureUser(auth.username, { hasPassword: auth.method === 'password' });
+    username = user.username;
+    webauthnUserID = user.webauthnUserID;
+    excludeCredentials = user.passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+    mode = 'add';
+  } else {
+    const body = await readJSON<{ username: string }>(request);
+    username = typeof body.username === 'string' ? body.username.trim() : '';
+    if (!USERNAME_PATTERN.test(username)) {
+      return error(
+        400,
+        'invalid_username',
+        'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.',
+      );
+    }
+    if (await getUser(username)) {
+      return error(409, 'username_taken', 'That username is already taken.');
+    }
+    webauthnUserID = newWebAuthnUserID();
+    mode = 'signup';
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: username,
+    userDisplayName: username,
+    userID: new Uint8Array(Buffer.from(webauthnUserID, 'base64url')),
+    attestationType: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+
+  setCeremony(session, {
+    type: 'registration',
+    challenge: options.challenge,
+    username,
+    mode,
+    webauthnUserID,
+    createdAt: Date.now(),
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/webauthn/register-verify.ts b/src/pages/api/auth/webauthn/register-verify.ts
new file mode 100644
index 0000000..3d02945
--- /dev/null
+++ b/src/pages/api/auth/webauthn/register-verify.ts
@@ -0,0 +1,93 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { accountSummary } from '../../../../lib/auth/account';
+import { error, json, readJSON } from '../../../../lib/auth/http';
+import { defaultPasskeyName, getRelyingParty, toPublicPasskey } from '../../../../lib/auth/relyingParty';
+import { getAuth, signIn, takeCeremony } from '../../../../lib/auth/session';
+import {
+  addPasskey,
+  ensureUser,
+  findUserByCredentialID,
+  getUser,
+  type StoredPasskey,
+} from '../../../../lib/auth/store';
+import { registerPasswordless } from '../../../../lib/auth/timesApi';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { response: credential } = await readJSON<{ response: RegistrationResponseJSON }>(request);
+  if (!credential?.id) return error(400, 'invalid_request', 'Missing passkey response.');
+
+  const { rpID, origins } = getRelyingParty(url);
+  // Lets the browser hide a passkey the server ended up rejecting.
+  const rejected = (status: number, code: string, message: string) =>
+    json({ error: message, code, rpID, credentialID: credential.id }, status);
+
+  const ceremony = await takeCeremony(session, 'registration');
+  if (!ceremony) {
+    return rejected(400, 'challenge_expired', 'This request expired. Please try again.');
+  }
+
+  const auth = await getAuth(session);
+  if (ceremony.mode === 'add' && auth?.username !== ceremony.username) {
+    return rejected(401, 'unauthenticated', 'Your session changed. Please sign in again.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: credential,
+      expectedChallenge: ceremony.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return rejected(400, 'verification_failed', `Passkey could not be verified: ${(err as Error).message}`);
+  }
+  if (!verification.verified) {
+    return rejected(400, 'verification_failed', 'Passkey could not be verified.');
+  }
+
+  const info = verification.registrationInfo;
+  if (await findUserByCredentialID(info.credential.id)) {
+    return error(409, 'already_registered', 'This passkey is already registered.');
+  }
+
+  if (ceremony.mode === 'signup') {
+    if (await getUser(ceremony.username)) {
+      return rejected(409, 'username_taken', 'That username is already taken.');
+    }
+    const result = await registerPasswordless(ceremony.username);
+    if (!result.ok) {
+      return rejected(
+        result.status === 409 ? 409 : 400,
+        'registration_failed',
+        `Registration failed: ${result.data.error || 'Unknown error'}`,
+      );
+    }
+    await ensureUser(ceremony.username, { hasPassword: false, webauthnUserID: ceremony.webauthnUserID });
+  }
+
+  const passkey: StoredPasskey = {
+    id: info.credential.id,
+    publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+    counter: info.credential.counter,
+    transports: info.credential.transports ?? credential.response.transports ?? [],
+    deviceType: info.credentialDeviceType,
+    backedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    name: defaultPasskeyName(info.aaguid, info.credentialDeviceType),
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+  const user = await addPasskey(ceremony.username, passkey);
+
+  if (ceremony.mode === 'signup') {
+    await signIn(session, user.username, 'passkey');
+  }
+
+  return json({
+    passkey: toPublicPasskey(passkey),
+    account: accountSummary(user, (await getAuth(session))!, url),
+  });
+};
