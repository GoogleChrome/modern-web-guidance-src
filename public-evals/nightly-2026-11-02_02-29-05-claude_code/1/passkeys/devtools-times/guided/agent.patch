+import type { APIRoute } from 'astro';
+import { updateUserDisplayName } from '../../../lib/auth/store';
+import { getSessionUser, json } from '../../../lib/auth/session';
+
+/** Updates the signed-in user's display name (the username is owned by the Times auth service). */
+export const PUT: APIRoute = async ({ request, session }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return json({ error: 'Not signed in' }, 401);
+
+  const { displayName } = await request.json();
+  if (typeof displayName !== 'string' || !displayName.trim() || displayName.length > 64) {
+    return json({ error: 'Display name must be 1–64 characters' }, 400);
+  }
+
+  const user = await updateUserDisplayName(sessionUser.id, displayName.trim());
+  if (!user) return json({ error: 'User not found' }, 404);
+  session?.set('user', { ...sessionUser, displayName: user.displayName });
+  return json({ id: user.id, username: user.username, displayName: user.displayName });
+};
