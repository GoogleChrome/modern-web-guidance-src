+/**
+ * Relying Party configuration. Set PASSKEY_RP_ID / PASSKEY_ORIGINS when the app
+ * sits behind a proxy whose public hostname differs from the request URL.
+ */
+export const RP_NAME = 'The DevTools Times';
+
+export function getRpId(url: URL): string {
+  return process.env.PASSKEY_RP_ID ?? url.hostname;
+}
+
+export function getExpectedOrigins(url: URL): string[] {
+  const configured = process.env.PASSKEY_ORIGINS?.split(',').map((o) => o.trim()).filter(Boolean);
+  return configured?.length ? configured : [url.origin];
+}
+
+/** How long a sign-in or reauthentication counts as "recent" for sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export const TIMES_AUTH_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..1673349
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,56 @@
+import type { AstroSession } from 'astro';
+import { REAUTH_WINDOW_MS } from './config';
+import type { PasskeyUser, StoredPasskeyCredential } from './store';
+
+export interface SessionUser {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+type Session = AstroSession | undefined;
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export async function getSessionUser(session: Session): Promise<SessionUser | undefined> {
+  return (await session?.get('user')) as SessionUser | undefined;
+}
+
+export async function signIn(session: Session, user: PasskeyUser): Promise<SessionUser> {
+  const sessionUser = { id: user.id, username: user.username, displayName: user.displayName };
+  // Rotate the session ID to prevent session fixation.
+  await session?.regenerate();
+  session?.set('user', sessionUser);
+  session?.set('authenticatedAt', Date.now());
+  return sessionUser;
+}
+
+export function markReauthenticated(session: Session): void {
+  session?.set('authenticatedAt', Date.now());
+}
+
+export async function hasRecentAuthentication(session: Session): Promise<boolean> {
+  const at = (await session?.get('authenticatedAt')) as number | undefined;
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+/** Shape sent to the browser — never expose the public key or counter. */
+export function toPublicCredential(cred: StoredPasskeyCredential) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    providerIcon: cred.providerIcon,
+    credentialDeviceType: cred.credentialDeviceType,
+    credentialBackedUp: cred.credentialBackedUp,
+    registeredAt: cred.registeredAt,
+    lastUsedAt: cred.lastUsedAt,
+  };
+}
+
+export type PublicCredential = ReturnType<typeof toPublicCredential>;
+
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..846f2d0
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,115 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+/**
+ * Minimal file-backed store for passkey users and credentials.
+ *
+ * Accounts themselves live in the external Times auth service; this store only
+ * keeps the WebAuthn user handle for each username and the passkeys registered
+ * to it. Point PASSKEY_DATA_DIR at a persistent volume in production.
+ */
+
+export interface PasskeyUser {
+  id: string; // Base64URL-encoded WebAuthn user handle
+  username: string;
+  displayName: string;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated PasskeyUser.id
+  credentialPublicKey: string; // Base64URL-encoded public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Data {
+  users: Record<string, PasskeyUser>; // keyed by username
+  credentials: Record<string, StoredPasskeyCredential>; // keyed by credential ID
+}
+
+const dataDir = process.env.PASSKEY_DATA_DIR ?? path.join(process.cwd(), '.data');
+const dataFile = path.join(dataDir, 'passkeys.json');
+
+let cache: Data | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<Data> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(dataFile, 'utf8')) as Data;
+  } catch {
+    cache = { users: {}, credentials: {} };
+  }
+  return cache;
+}
+
+function persist(data: Data): Promise<void> {
+  // Serialize writes and replace the file atomically.
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(dataDir, { recursive: true });
+    const tmp = `${dataFile}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(data));
+    await rename(tmp, dataFile);
+  });
+  return writeQueue;
+}
+
+export async function findUserByUsername(username: string): Promise<PasskeyUser | undefined> {
+  return (await load()).users[username];
+}
+
+export async function findUserById(id: string): Promise<PasskeyUser | undefined> {
+  return Object.values((await load()).users).find((user) => user.id === id);
+}
+
+export async function getOrCreateUser(username: string): Promise<PasskeyUser> {
+  const data = await load();
+  let user = data.users[username];
+  if (!user) {
+    user = { id: randomBytes(32).toString('base64url'), username, displayName: username };
+    data.users[username] = user;
+    await persist(data);
+  }
+  return user;
+}
+
+export async function updateUserDisplayName(userId: string, displayName: string): Promise<PasskeyUser | undefined> {
+  const data = await load();
+  const user = Object.values(data.users).find((u) => u.id === userId);
+  if (!user) return undefined;
+  user.displayName = displayName;
+  await persist(data);
+  return user;
+}
+
+export async function findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+  return Object.values((await load()).credentials)
+    .filter((cred) => cred.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export async function findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+  return (await load()).credentials[id];
+}
+
+export async function saveCredential(cred: StoredPasskeyCredential): Promise<void> {
+  const data = await load();
+  data.credentials[cred.id] = cred;
+  await persist(data);
+}
+
+export async function deleteCredential(id: string): Promise<void> {
+  const data = await load();
+  delete data.credentials[id];
+  await persist(data);
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..cb3b4d4
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,247 @@
+/**
+ * Browser-side WebAuthn helpers. Uses the native WebAuthn APIs directly, with
+ * `webauthn-polyfills` filling in JSON (de)serialization and getClientCapabilities()
+ * on browsers that support PublicKeyCredential but not those newer statics.
+ */
+
+const API = `${import.meta.env.BASE_URL}api/auth`;
+
+// Newer WebAuthn statics that aren't in every TypeScript DOM lib yet.
+interface PublicKeyCredentialStatics {
+  getClientCapabilities(): Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON(json: unknown): PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON(json: unknown): PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?(options: { rpId: string; credentialId: string }): Promise<void>;
+  signalAllAcceptedCredentials?(options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }): Promise<void>;
+  signalCurrentUserDetails?(options: { rpId: string; userId: string; name: string; displayName: string }): Promise<void>;
+}
+
+type JSONCredential = { id: string } & Record<string, unknown>;
+
+let ready: Promise<PublicKeyCredentialStatics | null> | null = null;
+
+/** Resolves to the PublicKeyCredential statics, or null when WebAuthn is unavailable. */
+function webauthn(): Promise<PublicKeyCredentialStatics | null> {
+  ready ??= (async () => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential) return null;
+    await import('webauthn-polyfills');
+    return window.PublicKeyCredential as unknown as PublicKeyCredentialStatics;
+  })();
+  return ready;
+}
+
+function toJSON(credential: Credential | null): JSONCredential {
+  return (credential as unknown as { toJSON(): JSONCredential }).toJSON();
+}
+
+async function postJSON(path: string, body?: unknown): Promise<Response> {
+  return fetch(`${API}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+async function errorFrom(response: Response, fallback: string): Promise<Error> {
+  const data = await response.json().catch(() => ({}));
+  return new Error(data.error || fallback);
+}
+
+export async function getCapabilities(): Promise<Record<string, boolean>> {
+  const pkc = await webauthn();
+  if (!pkc) return {};
+  try {
+    return await pkc.getClientCapabilities();
+  } catch {
+    return {};
+  }
+}
+
+/** Whether to offer "Create a passkey" buttons on this device. */
+export async function canCreatePasskeys(): Promise<boolean> {
+  const caps = await getCapabilities();
+  return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+}
+
+/** Thrown when the user cancelled or the operation was aborted — callers should stay quiet. */
+export class PasskeyCancelledError extends Error {}
+
+function describeWebAuthnError(err: unknown, action: 'create' | 'get'): Error {
+  const name = (err as DOMException)?.name;
+  if (name === 'NotAllowedError' || name === 'AbortError') {
+    return new PasskeyCancelledError('Passkey prompt was cancelled.');
+  }
+  if (name === 'InvalidStateError' && action === 'create') {
+    return new Error('A passkey for this account already exists in this passkey provider.');
+  }
+  if (name === 'SecurityError') {
+    return new Error('Passkeys are not available on this site configuration (secure origin / RP ID mismatch).');
+  }
+  return new Error('Something went wrong with your passkey. Please try again.');
+}
+
+async function signalUnknown(pkc: PublicKeyCredentialStatics, rpId: string, credentialId: string) {
+  if (!pkc.signalUnknownCredential) return;
+  try {
+    await pkc.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential failed:', err);
+  }
+}
+
+export type CreateMode = 'promotion' | 'management' | 'conditional';
+
+/**
+ * Register a new passkey for the signed-in user. Resolves to the stored passkey,
+ * or null when conditional creation was silently skipped.
+ */
+export async function registerPasskey(mode: CreateMode) {
+  const pkc = await webauthn();
+  if (!pkc) throw new Error('Passkeys are not supported in this browser.');
+
+  const optionsResponse = await postJSON('passkeys/register-options', {
+    promotion: mode === 'promotion',
+    conditional: mode === 'conditional',
+  });
+  if (!optionsResponse.ok) throw await errorFrom(optionsResponse, 'Could not start passkey creation.');
+  const optionsJSON = await optionsResponse.json();
+  const rpId: string = optionsJSON.rp.id;
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey: pkc.parseCreationOptionsFromJSON(optionsJSON),
+      ...(mode === 'conditional' && { mediation: 'conditional' as CredentialMediationRequirement }),
+    });
+  } catch (err) {
+    if (mode === 'conditional') return null; // Silent: never surface errors for conditional create.
+    throw describeWebAuthnError(err, 'create');
+  }
+
+  const encoded = toJSON(credential);
+  let verifyResponse: Response;
+  try {
+    verifyResponse = await postJSON('passkeys/register-verify', encoded);
+  } catch {
+    await signalUnknown(pkc, rpId, encoded.id);
+    if (mode === 'conditional') return null;
+    throw new Error('Could not reach the server to save your passkey.');
+  }
+  if (!verifyResponse.ok) {
+    // The provider holds a credential the server never stored — tell it to drop it.
+    await signalUnknown(pkc, rpId, encoded.id);
+    if (mode === 'conditional') return null;
+    throw await errorFrom(verifyResponse, 'Your passkey could not be saved.');
+  }
+  return verifyResponse.json();
+}
+
+/** Silently offer a passkey after a password sign-in when the browser supports conditional create. */
+export async function conditionalCreatePasskey(): Promise<void> {
+  const caps = await getCapabilities();
+  if (!caps.conditionalCreate) return;
+  try {
+    await registerPasskey('conditional');
+  } catch (err) {
+    console.warn('Conditional passkey creation skipped:', err);
+  }
+}
+
+async function verifySignIn(pkc: PublicKeyCredentialStatics, rpId: string, credential: Credential | null) {
+  const encoded = toJSON(credential);
+  const response = await postJSON('passkeys/login-verify', encoded);
+  if (response.status === 404) {
+    // Unauthenticated + credential unknown to the server: the provider should hide it.
+    await signalUnknown(pkc, rpId, encoded.id);
+  }
+  if (!response.ok) throw await errorFrom(response, 'Passkey sign-in failed.');
+  return response.json();
+}
+
+async function signInOptions(pkc: PublicKeyCredentialStatics) {
+  const response = await postJSON('passkeys/login-options');
+  if (!response.ok) throw await errorFrom(response, 'Could not start passkey sign-in.');
+  const optionsJSON = await response.json();
+  return { rpId: optionsJSON.rpId as string, publicKey: pkc.parseRequestOptionsFromJSON(optionsJSON) };
+}
+
+/**
+ * Arm passkey suggestions in the username field's autofill (conditional mediation).
+ * Resolves with the signed-in user, or null if unsupported/aborted.
+ */
+export async function signInWithAutofill(signal: AbortSignal) {
+  const pkc = await webauthn();
+  if (!pkc || !(await getCapabilities()).conditionalGet) return null;
+
+  const { rpId, publicKey } = await signInOptions(pkc);
+  if (signal.aborted) return null;
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal, mediation: 'conditional' });
+  } catch (err) {
+    const name = (err as DOMException)?.name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return null;
+    throw describeWebAuthnError(err, 'get');
+  }
+  return verifySignIn(pkc, rpId, credential);
+}
+
+/** Explicit "Sign in with a passkey" button flow. */
+export async function signInWithPasskey(signal: AbortSignal) {
+  const pkc = await webauthn();
+  if (!pkc) throw new Error('Passkeys are not supported in this browser.');
+
+  const { rpId, publicKey } = await signInOptions(pkc);
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal });
+  } catch (err) {
+    throw describeWebAuthnError(err, 'get');
+  }
+  return verifySignIn(pkc, rpId, credential);
+}
+
+/** Step-up verification with one of the signed-in user's own passkeys. */
+export async function reauthenticate(): Promise<void> {
+  const pkc = await webauthn();
+  if (!pkc) throw new Error('Passkeys are not supported in this browser.');
+
+  const optionsResponse = await postJSON('reauth/options');
+  if (!optionsResponse.ok) throw await errorFrom(optionsResponse, 'Could not start verification.');
+  const optionsJSON = await optionsResponse.json();
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({ publicKey: pkc.parseRequestOptionsFromJSON(optionsJSON) });
+  } catch (err) {
+    throw describeWebAuthnError(err, 'get');
+  }
+
+  const encoded = toJSON(credential);
+  const verifyResponse = await postJSON('reauth/verify', encoded);
+  if (verifyResponse.status === 404) await signalUnknown(pkc, optionsJSON.rpId, encoded.id);
+  if (!verifyResponse.ok) throw await errorFrom(verifyResponse, 'Verification failed.');
+}
+
+/** Keep the user's passkey provider in sync with the passkeys the server accepts. */
+export async function signalAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  const pkc = await webauthn();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+/** Push the updated account name/display name to the user's passkey provider. */
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  const pkc = await webauthn();
+  if (!pkc?.signalCurrentUserDetails) return;
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails failed:', err);
+  }
+}
