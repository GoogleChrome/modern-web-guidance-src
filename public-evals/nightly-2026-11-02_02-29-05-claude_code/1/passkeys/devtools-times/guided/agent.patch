+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRpId } from '../../../../lib/auth/config';
+import { json } from '../../../../lib/auth/session';
+
+/** Discoverable-credential sign-in options (used by both autofill and the explicit button). */
