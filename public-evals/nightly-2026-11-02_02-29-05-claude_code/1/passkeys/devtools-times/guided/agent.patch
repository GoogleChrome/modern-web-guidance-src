@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { findCredentialById, findUserById, saveCredential } from '../../../../lib/auth/store';
+import { json, signIn } from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const pending = (await session?.get('authentication')) as
+    | { challenge: string; userVerification: 'preferred' | 'required' }
+    | undefined;
+  session?.delete('authentication');
+  if (!pending) return json({ error: 'No sign-in in progress' }, 400);
+
+  const response = await request.json();
+  const stored = typeof response?.id === 'string' ? await findCredentialById(response.id) : undefined;
+  if (!stored) {
+    // 404 lets the client tell the passkey provider to forget this credential.
+    return json({ error: 'This passkey is no longer registered with The DevTools Times' }, 404);
+  }
+  const user = await findUserById(stored.passkeyUserId);
+  if (!user) return json({ error: 'This passkey is no longer registered with The DevTools Times' }, 404);
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: stored.id,
+        publicKey: isoBase64URL.toBuffer(stored.credentialPublicKey),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey could not be verified' }, 400);
+
+  const { newCounter, credentialBackedUp, credentialDeviceType } = verification.authenticationInfo;
+  await saveCredential({ ...stored, counter: newCounter, credentialBackedUp, credentialDeviceType, lastUsedAt: Date.now() });
+
+  const sessionUser = await signIn(session, user);
+  return json({ user: sessionUser });
+};
