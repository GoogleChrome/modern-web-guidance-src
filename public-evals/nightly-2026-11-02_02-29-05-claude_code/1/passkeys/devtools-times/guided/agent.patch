+import type { APIRoute } from 'astro';
+import { TIMES_AUTH_API } from '../../../lib/auth/config';
+import { getOrCreateUser } from '../../../lib/auth/store';
+import { json, signIn } from '../../../lib/auth/session';
+
+/** Proxies password sign-in to the Times auth service and starts a local session on success. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const response = await fetch(`${TIMES_AUTH_API}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    return json(data, response.status);
+  }
+
+  const user = await signIn(session, await getOrCreateUser(username));
+  return json({ ...data, user });
+};
