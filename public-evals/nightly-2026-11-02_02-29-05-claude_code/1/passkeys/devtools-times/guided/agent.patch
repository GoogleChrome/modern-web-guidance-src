+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRpId } from '../../../../lib/auth/config';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+import { getSessionUser, json } from '../../../../lib/auth/session';
+
+/** Step-up options restricted to the signed-in user's own passkeys. */
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const passkeys = await findCredentialsByUserId(user.id);
+  if (passkeys.length === 0) return json({ error: 'No passkeys registered' }, 409);
+
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    allowCredentials: passkeys.map((cred) => ({ id: cred.id, transports: cred.transports })),
+    userVerification: 'preferred',
+  });
+  session?.set('reauthentication', { challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
