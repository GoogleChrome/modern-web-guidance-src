+import type { APIRoute } from 'astro';
+import { deleteCredential, findCredentialById, saveCredential } from '../../../../lib/auth/store';
+import { getSessionUser, hasRecentAuthentication, json, toPublicCredential } from '../../../../lib/auth/session';
+
+async function findOwnedCredential(id: string | undefined, userId: string) {
+  const cred = id ? await findCredentialById(id) : undefined;
+  return cred?.passkeyUserId === userId ? cred : undefined;
+}
+
+/** Rename a passkey (server-side label only). */
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const cred = await findOwnedCredential(params.id, user.id);
+  if (!cred) return json({ error: 'Passkey not found' }, 404);
+
+  const { name } = await request.json();
+  if (typeof name !== 'string' || !name.trim() || name.length > 64) {
+    return json({ error: 'Name must be 1–64 characters' }, 400);
+  }
+  const updated = { ...cred, name: name.trim() };
+  await saveCredential(updated);
+  return json(toPublicCredential(updated));
+};
+
+/** Delete a passkey. Sensitive: requires a recent sign-in or reauthentication. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!(await hasRecentAuthentication(session))) {
+    return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 403);
+  }
+
+  const cred = await findOwnedCredential(params.id, user.id);
+  if (!cred) return json({ error: 'Passkey not found' }, 404);
+
+  await deleteCredential(cred.id);
+  return json({ success: true });
+};
