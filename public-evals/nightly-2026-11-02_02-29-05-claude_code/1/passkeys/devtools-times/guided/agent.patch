+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { lookupProvider } from '../../../../lib/auth/aaguid';
+import { saveCredential } from '../../../../lib/auth/store';
+import { getSessionUser, json, toPublicCredential } from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const pending = (await session?.get('registration')) as { challenge: string; conditional: boolean } | undefined;
+  session?.delete('registration');
+  if (!pending) return json({ error: 'No registration in progress' }, 400);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: await request.json(),
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      // Options requested userVerification: 'preferred'.
+      requireUserVerification: false,
+      // Conditional create may complete without a fresh user-presence gesture.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+
+  if (!verification.verified || !verification.registrationInfo) {
+    return json({ error: 'Passkey registration could not be verified' }, 400);
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = verification.registrationInfo;
+  const provider = await lookupProvider(aaguid);
+  const stored = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    credentialType: 'public-key' as const,
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.icon,
+    name: provider.name,
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await saveCredential(stored);
+  return json(toPublicCredential(stored));
+};
