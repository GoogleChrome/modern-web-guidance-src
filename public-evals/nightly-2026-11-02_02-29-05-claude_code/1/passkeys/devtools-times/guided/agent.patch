+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { findCredentialById, saveCredential } from '../../../../lib/auth/store';
+import { getSessionUser, json, markReauthenticated } from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const pending = (await session?.get('reauthentication')) as
+    | { challenge: string; userVerification: 'preferred' | 'required' }
+    | undefined;
+  session?.delete('reauthentication');
+  if (!pending) return json({ error: 'No reauthentication in progress' }, 400);
+
+  const response = await request.json();
+  const stored = typeof response?.id === 'string' ? await findCredentialById(response.id) : undefined;
+  if (!stored) return json({ error: 'Passkey not found' }, 404);
+  // Reject a valid passkey that belongs to a different account.
+  if (stored.passkeyUserId !== user.id) return json({ error: 'This passkey belongs to another account' }, 403);
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: stored.id,
+        publicKey: isoBase64URL.toBuffer(stored.credentialPublicKey),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey could not be verified' }, 400);
+
+  await saveCredential({ ...stored, counter: verification.authenticationInfo.newCounter, lastUsedAt: Date.now() });
+  markReauthenticated(session);
+  return json({ success: true });
+};
