diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..a9c3bac
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,412 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  PasskeyCancelledError,
+  canCreatePasskeys,
+  reauthenticate,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalUserDetails,
+} from '../lib/passkeys-client';
+
+const API = `${import.meta.env.BASE_URL}api/auth`;
+
+interface User {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+interface Passkey {
+  id: string;
+  name: string;
+  providerIcon?: string;
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface Props {
+  user: User;
+  rpId: string;
+  initialPasskeys: Passkey[];
+}
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+const primaryButtonClass =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const secondaryButtonClass =
+  'inline-flex items-center justify-center gap-2 py-2 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const dangerButtonClass = primaryButtonClass.replace('bg-gray-900 hover:bg-gray-800', 'bg-red-700 hover:bg-red-800');
+const secondaryDangerButtonClass = secondaryButtonClass.replace('text-gray-800', 'text-red-700');
+
+export default function AccountSettings({ user: initialUser, rpId, initialPasskeys }: Props) {
+  const [user, setUser] = useState(initialUser);
+  const [passkeys, setPasskeys] = useState<Passkey[]>(initialPasskeys);
+  const [canCreate, setCanCreate] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+
+  const [displayName, setDisplayName] = useState(initialUser.displayName);
+  const [savingName, setSavingName] = useState(false);
+
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+
+  const [pendingDelete, setPendingDelete] = useState<Passkey | null>(null);
+  const [deleteStep, setDeleteStep] = useState<'confirm' | 'reauth'>('confirm');
+  const [deleting, setDeleting] = useState(false);
+  const [dialogError, setDialogError] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  const showStatus = (message: string) => {
+    setError(null);
+    setStatus(message);
+  };
+
+  const showError = (message: string) => {
+    setStatus(null);
+    setError(message);
+  };
+
+  const refreshPasskeys = async (): Promise<Passkey[]> => {
+    const response = await fetch(`${API}/passkeys`);
+    if (!response.ok) throw new Error('Could not load your passkeys.');
+    const list: Passkey[] = await response.json();
+    setPasskeys(list);
+    return list;
+  };
+
+  useEffect(() => {
+    canCreatePasskeys().then(setCanCreate);
+    // Let the passkey provider hide passkeys the server no longer accepts.
+    signalAcceptedCredentials(rpId, initialUser.id, initialPasskeys.map((p) => p.id));
+  }, []);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (pendingDelete && !dialog.open) dialog.showModal();
+    if (!pendingDelete && dialog.open) dialog.close();
+  }, [pendingDelete]);
+
+  const handleCreatePasskey = async () => {
+    setError(null);
+    setStatus(null);
+    setCreating(true);
+    try {
+      const created: Passkey = await registerPasskey('management');
+      await refreshPasskeys();
+      showStatus(`Passkey “${created.name}” created.`);
+    } catch (err) {
+      if (!(err instanceof PasskeyCancelledError)) showError((err as Error).message);
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const handleSaveDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSavingName(true);
+    try {
+      const response = await fetch(`${API}/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Could not update your display name.');
+      setUser(data);
+      setDisplayName(data.displayName);
+      await signalUserDetails(rpId, data.id, data.username, data.displayName);
+      showStatus('Display name updated.');
+    } catch (err) {
+      showError((err as Error).message);
+    } finally {
+      setSavingName(false);
+    }
+  };
+
+  const startRename = (passkey: Passkey) => {
+    setRenamingId(passkey.id);
+    setRenameValue(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    try {
+      const response = await fetch(`${API}/passkeys/${encodeURIComponent(passkey.id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: renameValue }),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Could not rename the passkey.');
+      setRenamingId(null);
+      await refreshPasskeys();
+      showStatus('Passkey renamed.');
+    } catch (err) {
+      showError((err as Error).message);
+    }
+  };
+
+  const requestDelete = (passkey: Passkey) => {
+    setDialogError(null);
+    setDeleteStep('confirm');
+    setPendingDelete(passkey);
+  };
+
+  const closeDialog = () => {
+    if (!deleting) setPendingDelete(null);
+  };
+
+  const performDelete = async (passkey: Passkey) => {
+    const response = await fetch(`${API}/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+    const data = await response.json().catch(() => ({}));
+    if (response.status === 403 && data.code === 'REAUTH_REQUIRED') {
+      setDeleteStep('reauth');
+      return;
+    }
+    if (!response.ok) throw new Error(data.error || 'Could not remove the passkey.');
+
+    setPendingDelete(null);
+    const list = await refreshPasskeys();
+    await signalAcceptedCredentials(rpId, user.id, list.map((p) => p.id));
+    showStatus(`Passkey “${passkey.name}” removed.`);
+  };
+
+  const handleConfirmDelete = async () => {
+    if (!pendingDelete) return;
+    setDialogError(null);
+    setDeleting(true);
+    try {
+      await performDelete(pendingDelete);
+    } catch (err) {
+      setDialogError((err as Error).message);
+    } finally {
+      setDeleting(false);
+    }
+  };
+
+  const handleReauthAndDelete = async () => {
+    if (!pendingDelete) return;
+    setDialogError(null);
+    setDeleting(true);
+    try {
+      await reauthenticate();
+      await performDelete(pendingDelete);
+    } catch (err) {
+      if (!(err instanceof PasskeyCancelledError)) setDialogError((err as Error).message);
+    } finally {
+      setDeleting(false);
+    }
+  };
+
+  const handleSignOut = async () => {
+    await fetch(`${API}/logout`, { method: 'POST' });
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-6">
+      <div className="flex items-center justify-between">
+        <h1 className="text-2xl font-bold text-gray-800">Account settings</h1>
+        <button type="button" onClick={handleSignOut} className={secondaryButtonClass}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {status && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{status}</div>}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="profile-heading">
+        <h2 id="profile-heading" className="text-lg font-semibold text-gray-800 mb-4">
+          Profile
+        </h2>
+        <dl className="mb-4 text-sm">
+          <dt className="font-medium text-gray-700">Username</dt>
+          <dd className="text-gray-900">{user.username}</dd>
+        </dl>
+        <form onSubmit={handleSaveDisplayName} className="space-y-2">
+          <label htmlFor="display-name" className="block text-sm font-medium text-gray-700">
+            Display name
+          </label>
+          <div className="flex gap-2">
+            <input
+              id="display-name"
+              name="display-name"
+              autoComplete="name"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              className={inputClass}
+            />
+            <button
+              type="submit"
+              disabled={savingName || displayName.trim() === user.displayName}
+              className={primaryButtonClass}
+            >
+              {savingName ? 'Saving...' : 'Save'}
+            </button>
+          </div>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-lg font-semibold text-gray-800">
+              Passkeys
+            </h2>
+            <p className="text-sm text-gray-600">
+              Sign in with your fingerprint, face, screen lock, or a security key instead of your password.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreatePasskey} disabled={creating} className={primaryButtonClass}>
+              <KeyIcon className="h-5 w-5" aria-hidden="true" />
+              {creating ? 'Waiting for passkey...' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!canCreate && (
+          <p className="mb-4 p-3 text-sm text-gray-700 bg-gray-100 rounded-lg">
+            This browser or device can't create passkeys. Keep using a strong, unique password, and try adding a
+            passkey from a supported device.
+          </p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <p className="text-sm text-gray-500">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border-t border-gray-200">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="py-4 flex items-start gap-4">
+                {passkey.providerIcon ? (
+                  <img src={passkey.providerIcon} alt="" width={32} height={32} className="h-8 w-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="h-8 w-8 shrink-0 text-gray-500" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-0">
+                  {renamingId === passkey.id ? (
+                    <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${passkey.id}`}
+                        value={renameValue}
+                        onChange={(e) => setRenameValue(e.target.value)}
+                        required
+                        maxLength={64}
+                        autoFocus
+                        className={`${inputClass} flex-1 min-w-40`}
+                      />
+                      <button type="submit" className={primaryButtonClass}>
+                        Save
+                      </button>
+                      <button type="button" onClick={() => setRenamingId(null)} className={secondaryButtonClass}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-900 truncate">{passkey.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-1">
+                    Created {dateFormat.format(passkey.registeredAt)}
+                    {' · '}
+                    {passkey.lastUsedAt ? `Last used ${dateFormat.format(passkey.lastUsedAt)}` : 'Never used'}
+                    {passkey.credentialBackedUp && ' · Synced'}
+                  </p>
+                </div>
+
+                {renamingId !== passkey.id && (
+                  <div className="flex gap-2 shrink-0">
+                    <button
+                      type="button"
+                      onClick={() => startRename(passkey)}
+                      className={secondaryButtonClass}
+                      aria-label={`Rename ${passkey.name}`}
+                    >
+                      <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                      <span className="hidden sm:inline">Rename</span>
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => requestDelete(passkey)}
+                      className={secondaryDangerButtonClass}
+                      aria-label={`Remove ${passkey.name}`}
+                    >
+                      <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                      <span className="hidden sm:inline">Remove</span>
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        onClose={() => setPendingDelete(null)}
+        onCancel={(e) => deleting && e.preventDefault()}
+        aria-labelledby="delete-dialog-heading"
+        className="m-auto w-full max-w-md p-6 rounded-lg shadow-xl backdrop:bg-black/40"
+      >
+        {pendingDelete && (
+          <>
+            <h2 id="delete-dialog-heading" className="text-lg font-semibold text-gray-900 mb-2">
+              {deleteStep === 'confirm' ? 'Remove this passkey?' : 'Verify it’s you'}
+            </h2>
+            <p className="text-sm text-gray-600 mb-4">
+              {deleteStep === 'confirm'
+                ? `You won’t be able to sign in with “${pendingDelete.name}” anymore. You can still sign in with your password or other passkeys.`
+                : 'Removing a passkey is a sensitive change. Confirm with one of your passkeys to continue.'}
+            </p>
+            {dialogError && (
+              <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+                {dialogError}
+              </div>
+            )}
+            <div className="flex justify-end gap-2">
+              <button type="button" onClick={closeDialog} disabled={deleting} className={secondaryButtonClass}>
+                Cancel
+              </button>
+              {deleteStep === 'confirm' ? (
+                <button
+                  type="button"
+                  onClick={handleConfirmDelete}
+                  disabled={deleting}
+                  className={dangerButtonClass}
+                >
+                  {deleting ? 'Removing...' : 'Remove'}
+                </button>
+              ) : (
+                <button type="button" onClick={handleReauthAndDelete} disabled={deleting} className={primaryButtonClass}>
+                  <KeyIcon className="h-5 w-5" aria-hidden="true" />
+                  {deleting ? 'Verifying...' : 'Verify with passkey'}
+                </button>
+              )}
+            </div>
+          </>
+        )}
+      </dialog>
+    </div>
+  );
+}
