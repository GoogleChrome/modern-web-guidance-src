+describe('registration', () => {
+  test('creates an account with a passkey and signs the customer in', async () => {
+    const client = new Client();
+    const auth = new SoftAuthenticator();
+
+    const opts = await client.request('POST', '/api/register/options', { name: ' Ada  Lovelace ', email: 'ADA@Example.com ' });
+    assert.equal(opts.status, 200);
+    const { options } = opts.data;
+    assert.equal(options.rp.id, 'localhost');
+    assert.equal(options.user.name, 'ada@example.com');
+    assert.equal(options.user.displayName, 'Ada Lovelace');
+    assert.equal(options.authenticatorSelection.residentKey, 'required');
+    assert.equal(options.authenticatorSelection.userVerification, 'required');
+
+    const res = await client.request('POST', '/api/register/verify', { response: auth.create(options) });
+    assert.equal(res.status, 200, JSON.stringify(res.data));
+    assert.equal(res.data.user.email, 'ada@example.com');
+    assert.equal(res.data.user.passkeys.length, 1);
+    assert.equal(res.data.user.passkeys[0].name, 'Google Password Manager');
+    assert.equal(res.data.user.passkeys[0].synced, true);
+    assert.ok(res.data.user.reauthValidUntil > Date.now());
+    assert.equal('publicKey' in res.data.user.passkeys[0], false, 'public keys are not exposed');
+
+    const session = await client.request('GET', '/api/session');
+    assert.equal(session.data.user.name, 'Ada Lovelace');
+    assert.equal(session.data.rpID, 'localhost');
+  });
+
+  test('rejects duplicate emails and invalid input', async () => {
+    const client = new Client();
+    const dup = await client.request('POST', '/api/register/options', { name: 'Ada', email: 'ada@example.com' });
+    assert.equal(dup.status, 409);
+    assert.equal(dup.data.error, 'email_taken');
+
+    const badEmail = await client.request('POST', '/api/register/options', { name: 'X', email: 'nope' });
+    assert.equal(badEmail.data.error, 'invalid_email');
+
+    const noName = await client.request('POST', '/api/register/options', { name: '   ', email: 'x@example.com' });
+    assert.equal(noName.data.error, 'invalid_name');
+  });
+
+  test('rejects responses from the wrong origin and replayed challenges', async () => {
+    const client = new Client();
+    const phish = new SoftAuthenticator({ origin: 'https://daily-grind.evil' });
+    const opts = await client.request('POST', '/api/register/options', { name: 'Eve', email: 'eve@example.com' });
+    const response = phish.create(opts.data.options);
+    const res = await client.request('POST', '/api/register/verify', { response });
+    assert.equal(res.status, 400);
+    assert.equal(res.data.error, 'verification_failed');
+
+    // The challenge was consumed by the failed attempt.
+    const replay = await client.request('POST', '/api/register/verify', { response });
+    assert.equal(replay.data.error, 'challenge_expired');
+    assert.equal(store.getUserByEmail('eve@example.com'), undefined);
+  });
+});
+
+describe('sign in', () => {
+  test('signs in with a discoverable passkey and rotates the session', async () => {
+    const auth = new SoftAuthenticator();
+    const signup = new Client();
+    await signup.register(auth, { name: 'Grace', email: 'grace@example.com' });
+
+    const client = new Client();
+    const opts = await client.request('POST', '/api/login/options', {});
+    assert.deepEqual(opts.data.options.allowCredentials ?? [], []);
+    assert.equal(opts.data.options.userVerification, 'required');
+    const anonymousCookie = client.cookie;
+
+    const res = await client.request('POST', '/api/login/verify', { response: auth.get(opts.data.options) });
+    assert.equal(res.status, 200, JSON.stringify(res.data));
+    assert.equal(res.data.user.email, 'grace@example.com');
+    assert.notEqual(client.cookie, anonymousCookie, 'session id rotates on sign-in');
+    assert.equal(store.getUserByEmail('grace@example.com').passkeys[0].counter, 1);
+  });
+
+  test('reports unknown passkeys so the browser can hide them', async () => {
+    const auth = new SoftAuthenticator();
+    const opts = await new Client().request('POST', '/api/register/options', { name: 'X', email: 'ghost@example.com' });
+    auth.create(opts.data.options); // never verified, so the server doesn't know it
+
+    const res = await new Client().login(auth);
+    assert.equal(res.status, 400);
+    assert.equal(res.data.error, 'unknown_credential');
+    assert.equal(res.data.credentialID, auth.credentials[0].id);
+  });
+
+  test('rejects a reused challenge and a cloned authenticator counter', async () => {
+    const auth = new SoftAuthenticator();
+    await new Client().register(auth, { name: 'Linus', email: 'linus@example.com' });
+
+    const client = new Client();
+    const opts = await client.request('POST', '/api/login/options', {});
+    const response = auth.get(opts.data.options);
+    assert.equal((await client.request('POST', '/api/login/verify', { response })).status, 200);
+
+    const replay = await client.request('POST', '/api/login/verify', { response });
+    assert.equal(replay.data.error, 'challenge_expired');
+
+    auth.credentials[0].counter = 0; // a clone with a stale counter
+    const cloned = await new Client().login(auth);
+    assert.equal(cloned.data.error, 'verification_failed');
+  });
+
+  test('sign out ends the session', async () => {
+    const auth = new SoftAuthenticator();
+    const client = new Client();
+    await client.register(auth, { name: 'Ken', email: 'ken@example.com' });
+    assert.equal((await client.request('POST', '/api/logout', {})).status, 200);
+    assert.equal((await client.request('GET', '/api/session')).data.user, null);
+  });
+});
