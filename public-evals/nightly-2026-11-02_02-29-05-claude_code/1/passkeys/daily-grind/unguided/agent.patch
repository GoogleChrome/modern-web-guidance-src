@@ -0,0 +1,176 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/site.css">
+  <link rel="stylesheet" href="/assets/account.css">
+  <script src="/assets/nav.js" defer></script>
+  <script src="/vendor/simplewebauthn-browser.js" defer></script>
+  <script src="/assets/account.js" defer></script>
+</head>
+
+<body data-page="account">
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/account" class="logout-link" data-auth-link>Sign in</a></li>
+    </ul>
+  </nav>
+
+  <header class="account-hero">
+    <h1>My Account</h1>
+    <p>No passwords to remember. Just your face, fingerprint, or screen lock.</p>
+  </header>
+
+  <main class="container account">
+    <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
+
+    <p id="loading" class="loading">Loading your account…</p>
+
+    <div id="unsupported" class="notice notice-error" hidden>
+      This browser doesn’t support passkeys. Please update your browser or try a different device to
+      sign in to your Daily Grind account.
+    </div>
+
+    <!-- Signed out: sign in or create an account -->
+    <section id="signed-out" class="account-grid" hidden>
+      <div class="card panel">
+        <h2>Sign in</h2>
+        <p class="muted">Use the passkey saved on your phone, computer, or password manager.</p>
+        <form id="signin-form" novalidate>
+          <label for="signin-email">Email</label>
+          <!-- "webauthn" lets the browser offer saved passkeys right in the autofill menu. -->
+          <input id="signin-email" name="email" type="email" autocomplete="username webauthn"
+            placeholder="you@example.com">
+          <p class="hint">Pick a saved passkey from the suggestions, or use the button below.</p>
+          <button type="submit" class="btn btn-block">
+            <span class="passkey-icon" aria-hidden="true"></span>
+            Sign in with a passkey
+          </button>
+        </form>
+      </div>
+
+      <div class="card panel">
+        <h2>New here? Create an account</h2>
+        <p class="muted">Earn rewards, save your usual order, and check out faster. Your account is
+          protected by a passkey instead of a password.</p>
+        <form id="register-form" novalidate>
+          <label for="register-name">Name</label>
+          <input id="register-name" name="name" type="text" autocomplete="name" maxlength="80" required>
+          <label for="register-email">Email</label>
+          <input id="register-email" name="email" type="email" autocomplete="email" maxlength="254" required>
+          <button type="submit" class="btn btn-block">Create account with a passkey</button>
+        </form>
+        <details class="explainer">
+          <summary>What’s a passkey?</summary>
+          <p>A passkey is a secure sign-in credential stored by your device or password manager. You
+            unlock it the same way you unlock your device, it can’t be phished or reused on other
+            sites, and there’s no password for anyone to steal.</p>
+        </details>
+      </div>
+    </section>
+
+    <!-- Signed in: profile and passkey management -->
+    <section id="signed-in" hidden>
+      <h2 class="welcome">Welcome back, <span id="welcome-name"></span>!</h2>
+
+      <div class="account-grid">
+        <div class="card panel">
+          <h3>Profile</h3>
+          <form id="profile-form" novalidate>
+            <label for="profile-name">Name</label>
+            <input id="profile-name" name="name" type="text" autocomplete="name" maxlength="80" required>
+            <label for="profile-email">Email</label>
+            <input id="profile-email" name="email" type="email" autocomplete="email" maxlength="254" required>
+            <p class="hint">Changing your email asks you to confirm with your passkey.</p>
+            <button type="submit" class="btn">Save changes</button>
+          </form>
+          <p class="member-since muted" id="member-since"></p>
+        </div>
+
+        <div class="card panel">
+          <h3>Passkeys</h3>
+          <p class="muted">Passkeys let you sign in securely with your fingerprint, face, or screen
+            lock. Add one for each device or password manager you use.</p>
+          <ul id="passkey-list" class="passkey-list"></ul>
+          <button type="button" id="add-passkey" class="btn">
+            <span class="passkey-icon" aria-hidden="true"></span>
+            Create a passkey
+          </button>
+        </div>
+      </div>
+
+      <div class="signout-row">
+        <button type="button" id="signout" class="btn btn-secondary">Sign out</button>
+      </div>
+    </section>
+  </main>
+
+  <template id="passkey-item-template">
+    <li class="passkey-item">
+      <span class="passkey-icon passkey-icon-lg" aria-hidden="true"></span>
+      <div class="passkey-details">
+        <div class="passkey-name"></div>
+        <form class="rename-form" hidden>
+          <label class="visually-hidden">Passkey name</label>
+          <input type="text" name="name" maxlength="60" required>
+          <button type="submit" class="btn btn-small">Save</button>
+          <button type="button" class="btn btn-small btn-secondary" data-action="cancel-rename">Cancel</button>
+        </form>
+        <div class="passkey-meta muted"></div>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="link-button" data-action="rename">Rename</button>
+        <button type="button" class="link-button danger" data-action="remove">Remove</button>
+      </div>
+    </li>
+  </template>
+
+  <dialog id="reauth-dialog" aria-labelledby="reauth-title">
+    <form method="dialog">
+      <h2 id="reauth-title">Confirm it’s you</h2>
+      <p id="reauth-reason">For your security, please verify with one of your passkeys to continue.</p>
+      <p id="reauth-error" class="notice notice-error" role="alert" hidden></p>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn btn-secondary">Cancel</button>
+        <button type="button" id="reauth-confirm" class="btn">
+          <span class="passkey-icon" aria-hidden="true"></span>
+          Verify with passkey
+        </button>
+        <button type="button" id="reauth-continue" class="btn" hidden></button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="confirm-dialog" aria-labelledby="confirm-title">
+    <form method="dialog">
+      <h2 id="confirm-title">Remove passkey?</h2>
+      <p id="confirm-message"></p>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn btn-secondary">Cancel</button>
+        <button type="submit" value="confirm" class="btn btn-danger">Remove</button>
+      </div>
+    </form>
+  </dialog>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
