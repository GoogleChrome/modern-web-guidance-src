@@ -0,0 +1,33 @@
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const rootDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+const port = Number(process.env.PORT) || 11222;
+
+// The origin customers load the site from. Passkeys are bound to the RP ID, so in production set
+// ORIGIN (and optionally RP_ID) explicitly, e.g. ORIGIN=https://www.dailygrind.coffee RP_ID=dailygrind.coffee
+const origin = (process.env.ORIGIN || `http://localhost:${port}`).replace(/\/+$/, '');
+const rpID = process.env.RP_ID || new URL(origin).hostname;
+
+export const config = {
+  port,
+  origin,
+  rpID,
+  rpName: process.env.RP_NAME || 'The Daily Grind',
+  secureCookies: origin.startsWith('https://'),
+  publicDir: path.join(rootDir, 'public'),
+  dataFile: path.resolve(process.env.DATA_FILE || path.join(rootDir, 'data', 'db.json')),
+  vendorFiles: {
+    '/vendor/simplewebauthn-browser.js': path.join(
+      rootDir, 'node_modules', '@simplewebauthn', 'browser', 'dist', 'bundle', 'index.umd.min.js',
+    ),
+  },
+  sessionTTL: 1000 * 60 * 60 * 24 * 7, // 7 days, sliding
+  // Signed-out sessions only exist to hold WebAuthn challenges.
+  anonymousSessionTTL: 1000 * 60 * 30,
+  challengeTTL: 1000 * 60 * 5,
+  // How long after a passkey verification sensitive actions are allowed without asking again
+  reauthWindow: 1000 * 60 * 5,
+  ceremonyTimeout: 1000 * 60 * 2,
+};
diff --git a/server/index.js b/server/index.js
new file mode 100644
index 0000000..477636b
--- /dev/null
+++ b/server/index.js
@@ -0,0 +1,34 @@
+import http from 'node:http';
+import { config } from './config.js';
+import { Store } from './store.js';
+import { createApi } from './api.js';
+import { serveStatic, setSecurityHeaders } from './static.js';
+
+const store = new Store(config.dataFile);
+await store.load();
+
+const api = createApi(store);
+
+const server = http.createServer(async (req, res) => {
+  setSecurityHeaders(res);
+  try {
+    const url = new URL(req.url, config.origin);
+    if (url.pathname.startsWith('/api/')) {
+      await api(req, res, url);
+    } else {
+      await serveStatic(req, res, url);
+    }
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) {
+      res.writeHead(500, { 'Content-Type': 'application/json' });
+      res.end(JSON.stringify({ error: 'server_error', message: 'Something went wrong. Please try again.' }));
+    } else {
+      res.end();
+    }
+  }
+});
+
+server.listen(config.port, () => {
+  console.log(`The Daily Grind is brewing on ${config.origin} (RP ID: ${config.rpID})`);
+});
diff --git a/server/sessions.js b/server/sessions.js
new file mode 100644
index 0000000..47b5541
--- /dev/null
+++ b/server/sessions.js
@@ -0,0 +1,121 @@
+import crypto from 'node:crypto';
+import { config } from './config.js';
+
+const COOKIE_NAME = config.secureCookies ? '__Host-dg_sid' : 'dg_sid';
+
+/**
+ * In-memory session store. Sessions hold the signed-in user, the time of the last passkey
+ * verification (for reauthentication), and outstanding WebAuthn challenges keyed by purpose.
+ */
+const sessions = new Map();
+
+function ttl(session) {
+  return session.userId ? config.sessionTTL : config.anonymousSessionTTL;
+}
+
+function newId() {
+  return crypto.randomBytes(32).toString('base64url');
+}
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const idx = part.indexOf('=');
+    if (idx < 0) continue;
+    out[part.slice(0, idx).trim()] = decodeURIComponent(part.slice(idx + 1).trim());
+  }
+  return out;
+}
+
+function setCookie(res, id, maxAgeSeconds) {
+  const attrs = [
+    `${COOKIE_NAME}=${id}`,
+    'Path=/',
+    'HttpOnly',
+    'SameSite=Lax',
+    `Max-Age=${maxAgeSeconds}`,
+  ];
+  if (config.secureCookies) attrs.push('Secure');
+  res.setHeader('Set-Cookie', attrs.join('; '));
+}
+
+/** Returns the current session, or null. */
+export function getSession(req) {
+  const id = parseCookies(req.headers.cookie)[COOKIE_NAME];
+  if (!id) return null;
+  const session = sessions.get(id);
+  if (!session) return null;
+  if (session.expiresAt < Date.now()) {
+    sessions.delete(id);
+    return null;
+  }
+  session.expiresAt = Date.now() + ttl(session);
+  return session;
+}
+
+/** Returns the current session, creating an anonymous one if needed. */
+export function ensureSession(req, res) {
+  const existing = getSession(req);
+  if (existing) return existing;
+  const session = {
+    id: newId(),
+    userId: null,
+    reauthAt: 0,
+    challenges: {},
+    expiresAt: Date.now() + config.anonymousSessionTTL,
+  };
+  sessions.set(session.id, session);
+  setCookie(res, session.id, config.sessionTTL / 1000);
+  return session;
+}
+
+/**
+ * Signs a user in. The session ID is rotated to prevent session fixation, and the passkey
+ * verification that got us here counts as a fresh authentication.
+ */
+export function signIn(req, res, userId) {
+  const old = getSession(req);
+  if (old) sessions.delete(old.id);
+  const session = ensureSession({ headers: {} }, res);
+  session.userId = userId;
+  session.reauthAt = Date.now();
+  session.expiresAt = Date.now() + config.sessionTTL;
+  return session;
+}
+
+export function signOut(req, res) {
+  const session = getSession(req);
+  if (session) sessions.delete(session.id);
+  setCookie(res, '', 0);
+}
+
+/** Signs out every session belonging to a user, except optionally one to keep. */
+export function revokeUserSessions(userId, keepSessionId) {
+  for (const [id, session] of sessions) {
+    if (session.userId === userId && id !== keepSessionId) sessions.delete(id);
+  }
+}
+
+export function storeChallenge(session, purpose, challenge, extra = {}) {
+  session.challenges[purpose] = { challenge, expiresAt: Date.now() + config.challengeTTL, ...extra };
+}
+
+/** Removes and returns a challenge so it can only be used once. */
+export function takeChallenge(session, purpose) {
+  const entry = session?.challenges[purpose];
+  if (!entry) return null;
+  delete session.challenges[purpose];
+  return entry.expiresAt >= Date.now() ? entry : null;
+}
+
+export function hasRecentAuth(session) {
+  return Boolean(session?.userId) && Date.now() - session.reauthAt <= config.reauthWindow;
+}
+
+// Sweep expired sessions periodically.
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, session] of sessions) {
+    if (session.expiresAt < now) sessions.delete(id);
+  }
+}, 1000 * 60 * 10).unref();
diff --git a/server/static.js b/server/static.js
new file mode 100644
index 0000000..9708430
--- /dev/null
+++ b/server/static.js
@@ -0,0 +1,94 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { config } from './config.js';
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+  '.webp': 'image/webp',
+};
+
+const CSP = [
+  "default-src 'self'",
+  "script-src 'self'",
+  // The homepage uses an inline <style> block and style attributes.
+  "style-src 'self' 'unsafe-inline'",
+  "img-src 'self' data: https://images.unsplash.com",
+  "connect-src 'self'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+export function setSecurityHeaders(res) {
+  res.setHeader('Content-Security-Policy', CSP);
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+  if (config.secureCookies) {
+    res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains');
+  }
+}
+
+async function tryFile(file) {
+  try {
+    const stat = await fs.stat(file);
+    return stat.isFile() ? file : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Resolves a URL path to a file inside public/, supporting extensionless URLs like /account. */
+async function resolvePublicFile(pathname) {
+  let decoded;
+  try {
+    decoded = decodeURIComponent(pathname);
+  } catch {
+    return null;
+  }
+  if (decoded.includes('\0')) return null;
+  const base = path.join(config.publicDir, path.normalize(decoded));
+  if (base !== config.publicDir && !base.startsWith(config.publicDir + path.sep)) return null;
+
+  if (decoded.endsWith('/')) return tryFile(path.join(base, 'index.html'));
+  return (await tryFile(base)) || (path.extname(base) ? null : tryFile(`${base}.html`));
+}
+
+export async function serveStatic(req, res, url) {
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    res.writeHead(405, { Allow: 'GET, HEAD' });
+    res.end();
+    return;
+  }
+
+  // Signing out is a state change, so it's done with a POST from the account UI. Plain links to
+  // /logout land on the account page where the customer can sign out.
+  if (url.pathname === '/logout') {
+    res.writeHead(303, { Location: '/account' });
+    res.end();
+    return;
+  }
+
+  const file = config.vendorFiles[url.pathname] || (await resolvePublicFile(url.pathname));
+  if (!file) {
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+    return;
+  }
+
+  const body = await fs.readFile(file);
+  res.writeHead(200, {
+    'Content-Type': MIME_TYPES[path.extname(file)] || 'application/octet-stream',
+    'Content-Length': body.length,
+    'Cache-Control': file.endsWith('.html') ? 'no-cache' : 'public, max-age=300',
+  });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
diff --git a/server/store.js b/server/store.js
new file mode 100644
index 0000000..a128bf7
--- /dev/null
+++ b/server/store.js
@@ -0,0 +1,64 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+/**
+ * Tiny JSON-file persistence for customer accounts and their passkeys. Writes are serialized and
+ * atomic (write to temp file, then rename) so a crash can't leave a half-written database.
+ *
+ * User shape:
+ * {
+ *   id, webauthnUserID, email, name, createdAt, updatedAt,
+ *   passkeys: [{ id, publicKey, counter, transports, deviceType, backedUp, aaguid, name,
+ *                createdAt, lastUsedAt }]
+ * }
+ */
+export class Store {
+  constructor(file) {
+    this.file = file;
+    this.data = { users: [] };
+    this.writeQueue = Promise.resolve();
+  }
+
+  async load() {
+    try {
+      this.data = JSON.parse(await fs.readFile(this.file, 'utf8'));
+      this.data.users ??= [];
+    } catch (err) {
+      if (err.code !== 'ENOENT') throw err;
+      await this.save();
+    }
+  }
+
+  save() {
+    const snapshot = JSON.stringify(this.data, null, 2);
+    this.writeQueue = this.writeQueue.then(async () => {
+      await fs.mkdir(path.dirname(this.file), { recursive: true });
+      const tmp = `${this.file}.${process.pid}.tmp`;
+      await fs.writeFile(tmp, snapshot, { mode: 0o600 });
+      await fs.rename(tmp, this.file);
+    });
+    return this.writeQueue;
+  }
+
+  getUserById(id) {
+    return this.data.users.find((u) => u.id === id);
+  }
+
+  getUserByEmail(email) {
+    return this.data.users.find((u) => u.email === email);
+  }
+
+  findPasskey(credentialID) {
+    for (const user of this.data.users) {
+      const passkey = user.passkeys.find((p) => p.id === credentialID);
+      if (passkey) return { user, passkey };
+    }
+    return null;
+  }
+
+  async createUser(user) {
+    this.data.users.push(user);
+    await this.save();
+    return user;
+  }
+}
diff --git a/test/passkeys.test.js b/test/passkeys.test.js
new file mode 100644
index 0000000..1f12480
--- /dev/null
+++ b/test/passkeys.test.js
@@ -0,0 +1,481 @@
+import { after, before, describe, test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { Readable } from 'node:stream';
+import { isoBase64URL, isoCBOR } from '@simplewebauthn/server/helpers';
+
+const tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), 'daily-grind-test-'));
+process.env.DATA_FILE = path.join(tmpDir, 'db.json');
+delete process.env.ORIGIN;
+delete process.env.RP_ID;
+
+const { config } = await import('../server/config.js');
+const { Store } = await import('../server/store.js');
+const { createApi } = await import('../server/api.js');
+const { serveStatic } = await import('../server/static.js');
+
+const ORIGIN = config.origin;
+const sha256 = (data) => crypto.createHash('sha256').update(data).digest();
+const b64url = (buf) => isoBase64URL.fromBuffer(new Uint8Array(buf));
+
+/* ------------------------------------------------------------------------------------------------
+ * A minimal software authenticator (ES256, "none" attestation) acting like a synced passkey provider.
+ * ---------------------------------------------------------------------------------------------- */
+
+class SoftAuthenticator {
+  constructor({ aaguid = 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', origin = ORIGIN } = {}) {
+    this.aaguid = Buffer.from(aaguid.replaceAll('-', ''), 'hex');
+    this.origin = origin;
+    this.credentials = []; // { id, privateKey, userHandle, rpId, counter }
+  }
+
+  authData(rpId, flags, counter, attested) {
+    const counterBuf = Buffer.alloc(4);
+    counterBuf.writeUInt32BE(counter);
+    return Buffer.concat([sha256(rpId), Buffer.from([flags]), counterBuf, attested ?? Buffer.alloc(0)]);
+  }
+
+  create(options) {
+    const excluded = new Set((options.excludeCredentials ?? []).map((c) => c.id));
+    if (this.credentials.some((c) => excluded.has(c.id))) {
+      throw Object.assign(new Error('excluded'), { name: 'InvalidStateError' });
+    }
+    const { privateKey, publicKey } = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+    const jwk = publicKey.export({ format: 'jwk' });
+    const credId = crypto.randomBytes(16);
+    const cose = isoCBOR.encode(new Map([
+      [1, 2], [3, -7], [-1, 1],
+      [-2, new Uint8Array(Buffer.from(jwk.x, 'base64url'))],
+      [-3, new Uint8Array(Buffer.from(jwk.y, 'base64url'))],
+    ]));
+    const idLen = Buffer.alloc(2);
+    idLen.writeUInt16BE(credId.length);
+    const attested = Buffer.concat([this.aaguid, idLen, credId, Buffer.from(cose)]);
+    // UP | UV | BE | BS | AT
+    const authData = this.authData(options.rp.id, 0x01 | 0x04 | 0x08 | 0x10 | 0x40, 0, attested);
+    const clientDataJSON = Buffer.from(JSON.stringify({
+      type: 'webauthn.create', challenge: options.challenge, origin: this.origin, crossOrigin: false,
+    }));
+    const attestationObject = isoCBOR.encode(new Map([
+      ['fmt', 'none'], ['attStmt', new Map()], ['authData', new Uint8Array(authData)],
+    ]));
+    const id = b64url(credId);
+    this.credentials.push({ id, privateKey, userHandle: options.user.id, rpId: options.rp.id, counter: 0 });
+    return {
+      id,
+      rawId: id,
+      type: 'public-key',
+      response: {
+        clientDataJSON: b64url(clientDataJSON),
+        attestationObject: b64url(attestationObject),
+        transports: ['hybrid', 'internal'],
+      },
+      clientExtensionResults: { credProps: { rk: true } },
+    };
+  }
+
+  get(options, credentialId) {
+    const allowed = (options.allowCredentials ?? []).map((c) => c.id);
+    const cred = credentialId
+      ? this.credentials.find((c) => c.id === credentialId)
+      : this.credentials.find((c) => !allowed.length || allowed.includes(c.id));
+    if (!cred) throw Object.assign(new Error('no credential'), { name: 'NotAllowedError' });
+    cred.counter += 1;
+    const authData = this.authData(options.rpId, 0x01 | 0x04 | 0x08 | 0x10, cred.counter);
+    const clientDataJSON = Buffer.from(JSON.stringify({
+      type: 'webauthn.get', challenge: options.challenge, origin: this.origin, crossOrigin: false,
+    }));
+    const signature = crypto.sign('sha256', Buffer.concat([authData, sha256(clientDataJSON)]), cred.privateKey);
+    return {
+      id: cred.id,
+      rawId: cred.id,
+      type: 'public-key',
+      response: {
+        clientDataJSON: b64url(clientDataJSON),
+        authenticatorData: b64url(authData),
+        signature: b64url(signature),
+        userHandle: cred.userHandle,
+      },
+      clientExtensionResults: {},
+    };
+  }
+}
+
+/* ------------------------------------------------------------------------------------------------
+ * In-process HTTP client (no listening server) that keeps a cookie jar.
+ * ---------------------------------------------------------------------------------------------- */
+
+let store;
+let api;
+let ipCounter = 0;
+
+class Client {
+  constructor() {
+    this.cookie = '';
+    this.ip = `10.0.0.${++ipCounter}`;
+  }
+
+  async request(method, pathname, body, { origin = ORIGIN, contentType = 'application/json' } = {}) {
+    const payload = body === undefined ? [] : [Buffer.from(JSON.stringify(body))];
+    const req = Readable.from(payload);
+    Object.assign(req, {
+      method,
+      url: pathname,
+      headers: {
+        ...(this.cookie && { cookie: this.cookie }),
+        ...(origin && { origin }),
+        ...(body !== undefined && { 'content-type': contentType }),
+      },
+      socket: { remoteAddress: this.ip },
+    });
+
+    const headers = {};
+    let status = 200;
+    let raw = '';
+    const res = {
+      headersSent: false,
+      setHeader: (k, v) => { headers[k.toLowerCase()] = v; },
+      writeHead: (s, h = {}) => {
+        status = s;
+        for (const [k, v] of Object.entries(h)) headers[k.toLowerCase()] = v;
+        res.headersSent = true;
+      },
+      end: (chunk) => { if (chunk) raw += chunk; },
+    };
+
+    const url = new URL(pathname, ORIGIN);
+    if (url.pathname.startsWith('/api/')) await api(req, res, url);
+    else await serveStatic(req, res, url);
+
+    const setCookie = headers['set-cookie'];
+    if (setCookie) {
+      const pair = setCookie.split(';')[0];
+      this.cookie = /Max-Age=0\b/.test(setCookie) ? '' : pair;
+    }
+    let data = raw;
+    try { data = JSON.parse(raw); } catch { /* not JSON */ }
+    return { status, data, headers };
+  }
+
+  async register(authenticator, { name = 'Ada Lovelace', email = 'ada@example.com' } = {}) {
+    const opts = await this.request('POST', '/api/register/options', { name, email });
+    assert.equal(opts.status, 200, JSON.stringify(opts.data));
+    const response = authenticator.create(opts.data.options);
+    return this.request('POST', '/api/register/verify', { response });
+  }
+
+  async login(authenticator, credentialId) {
+    const opts = await this.request('POST', '/api/login/options', {});
+    assert.equal(opts.status, 200);
+    return this.request('POST', '/api/login/verify', { response: authenticator.get(opts.data.options, credentialId) });
+  }
+
+  async reauth(authenticator, credentialId) {
+    const opts = await this.request('POST', '/api/reauth/options', {});
+    assert.equal(opts.status, 200, JSON.stringify(opts.data));
+    return this.request('POST', '/api/reauth/verify', { response: authenticator.get(opts.data.options, credentialId) });
+  }
+
+  async addPasskey(authenticator) {
+    const opts = await this.request('POST', '/api/passkeys/options', {});
+    if (opts.status !== 200) return opts;
+    return this.request('POST', '/api/passkeys/verify', { response: authenticator.create(opts.data.options) });
+  }
+}
+
+/** Runs `fn` with sensitive-action reauthentication treated as stale. */
+async function withStaleAuth(fn) {
+  const original = config.reauthWindow;
+  config.reauthWindow = -1;
+  try {
+    return await fn();
+  } finally {
+    config.reauthWindow = original;
+  }
+}
+
+before(async () => {
+  store = new Store(config.dataFile);
+  await store.load();
+  api = createApi(store);
+});
+
+after(async () => {
+  await store.writeQueue;
+  await fs.rm(tmpDir, { recursive: true, force: true });
+});
