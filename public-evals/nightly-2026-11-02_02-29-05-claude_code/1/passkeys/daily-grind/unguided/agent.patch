new file mode 100644
index 0000000..0410b96
--- /dev/null
+++ b/public/assets/nav.js
@@ -0,0 +1,43 @@
+// Keeps the site navigation in sync with the customer's sign-in state and signs out via POST.
+(() => {
+  let signedIn = false;
+
+  function render() {
+    const link = document.querySelector('[data-auth-link]');
+    if (!link) return;
+    link.textContent = signedIn ? 'Logout' : 'Sign in';
+    link.href = signedIn ? '/logout' : '/account';
+  }
+
+  async function signOut() {
+    await fetch('/api/logout', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: '{}',
+    });
+    window.location.assign('/');
+  }
+
+  document.addEventListener('click', (event) => {
+    const link = event.target.closest('[data-auth-link]');
+    if (!link || !signedIn) return;
+    event.preventDefault();
+    signOut().catch(() => window.location.assign('/account'));
+  });
+
+  window.DailyGrindNav = {
+    setSignedIn(value) {
+      signedIn = Boolean(value);
+      render();
+    },
+    signOut,
+  };
+
+  // The account page manages its own session state and reports it via setSignedIn().
+  if (document.body.dataset.page !== 'account') {
+    fetch('/api/session', { headers: { Accept: 'application/json' } })
+      .then((res) => (res.ok ? res.json() : null))
+      .then((data) => window.DailyGrindNav.setSignedIn(Boolean(data?.user)))
+      .catch(() => {});
+  }
+})();
