+// Friendly names for common passkey providers, keyed by authenticator AAGUID, used to suggest a
+// default name for newly created passkeys. Source: https://github.com/passkeydeveloper/passkey-authenticator-aaguids
+const PROVIDERS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+};
+
+export function providerName(aaguid) {
+  return PROVIDERS[aaguid] || null;
+}
diff --git a/server/api.js b/server/api.js
new file mode 100644
index 0000000..b62ca9e
--- /dev/null
+++ b/server/api.js
@@ -0,0 +1,541 @@
+import crypto from 'node:crypto';
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { config } from './config.js';
+import { providerName } from './aaguids.js';
+import {
+  ensureSession,
+  getSession,
+  hasRecentAuth,
+  revokeUserSessions,
+  signIn,
+  signOut,
+  storeChallenge,
+  takeChallenge,
+} from './sessions.js';
+
+const MAX_BODY_BYTES = 64 * 1024;
+const MAX_PASSKEYS = 20;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+class HttpError extends Error {
+  constructor(status, code, message, extra = {}) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.extra = extra;
+  }
+}
+
+/* ----------------------------------------------------------------------------------------------
+ * Request helpers
+ * -------------------------------------------------------------------------------------------- */
+
+function sendJSON(res, status, body) {
+  res.writeHead(status, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+  res.end(JSON.stringify(body));
+}
+
+async function readJSON(req) {
+  if (!/^application\/json\b/i.test(req.headers['content-type'] || '')) {
+    throw new HttpError(415, 'unsupported_media_type', 'Expected a JSON request body.');
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw new HttpError(413, 'payload_too_large', 'Request body too large.');
+    chunks.push(chunk);
+  }
+  if (!size) return {};
+  try {
+    const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+    return body;
+  } catch {
+    throw new HttpError(400, 'invalid_json', 'Malformed JSON body.');
+  }
+}
+
+/**
+ * Cookie-authenticated, state-changing requests must come from our own pages. Combined with
+ * SameSite=Lax cookies and the JSON content-type requirement, this blocks cross-site request forgery.
+ */
+function assertSameOrigin(req) {
+  if (req.headers.origin !== config.origin) {
+    throw new HttpError(403, 'bad_origin', 'Cross-origin requests are not allowed.');
+  }
+}
+
+function clientIp(req) {
+  if (process.env.TRUST_PROXY) {
+    const forwarded = req.headers['x-forwarded-for'];
+    if (forwarded) return forwarded.split(',')[0].trim();
+  }
+  return req.socket.remoteAddress || 'unknown';
+}
+
+// Simple fixed-window rate limiting for WebAuthn ceremony endpoints.
+const RATE_LIMIT = { windowMs: 60_000, max: 30 };
+const rateBuckets = new Map();
+function rateLimit(req) {
+  const key = clientIp(req);
+  const now = Date.now();
+  let bucket = rateBuckets.get(key);
+  if (!bucket || bucket.resetAt <= now) {
+    bucket = { count: 0, resetAt: now + RATE_LIMIT.windowMs };
+    rateBuckets.set(key, bucket);
+  }
+  if (++bucket.count > RATE_LIMIT.max) {
+    throw new HttpError(429, 'rate_limited', 'Too many attempts. Please wait a minute and try again.');
+  }
+}
+setInterval(() => {
+  const now = Date.now();
+  for (const [key, bucket] of rateBuckets) if (bucket.resetAt <= now) rateBuckets.delete(key);
+}, 60_000).unref();
+
+/* ----------------------------------------------------------------------------------------------
+ * Validation & serialization
+ * -------------------------------------------------------------------------------------------- */
+
+function normalizeEmail(value) {
+  const email = String(value ?? '').trim().toLowerCase();
+  if (!EMAIL_RE.test(email) || email.length > 254) {
+    throw new HttpError(400, 'invalid_email', 'Please enter a valid email address.');
+  }
+  return email;
+}
+
+function normalizeName(value, { field = 'name', label = 'Name', max = 80 } = {}) {
+  const name = String(value ?? '').replace(/\s+/g, ' ').trim();
+  if (!name || name.length > max) {
+    throw new HttpError(400, `invalid_${field}`, `${label} must be between 1 and ${max} characters.`);
+  }
+  return name;
+}
+
+function requireResponse(body) {
+  const response = body.response;
+  if (!response || typeof response !== 'object' || typeof response.id !== 'string') {
+    throw new HttpError(400, 'invalid_response', 'Missing passkey response.');
+  }
+  return response;
+}
+
+function defaultPasskeyName(aaguid, deviceType, transports = []) {
+  const provider = providerName(aaguid);
+  if (provider) return provider;
+  if (deviceType === 'singleDevice' && transports.some((t) => ['usb', 'nfc', 'ble'].includes(t))) {
+    return 'Security key';
+  }
+  return 'Passkey';
+}
+
+function serializeUser(user, session) {
+  return {
+    name: user.name,
+    email: user.email,
+    createdAt: user.createdAt,
+    webauthnUserID: user.webauthnUserID,
+    passkeys: user.passkeys.map((p) => ({
+      id: p.id,
+      name: p.name,
+      provider: providerName(p.aaguid),
+      synced: p.backedUp,
+      createdAt: p.createdAt,
+      lastUsedAt: p.lastUsedAt,
+    })),
+    reauthValidUntil: hasRecentAuth(session) ? session.reauthAt + config.reauthWindow : null,
+  };
+}
+
+function toWebAuthnCredential(passkey) {
+  return {
+    id: passkey.id,
+    publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+    counter: passkey.counter,
+    transports: passkey.transports,
+  };
+}
+
+function newPasskeyRecord(registrationInfo) {
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = registrationInfo;
+  const now = new Date().toISOString();
+  return {
+    id: credential.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports ?? [],
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    aaguid,
+    name: defaultPasskeyName(aaguid, credentialDeviceType, credential.transports),
+    createdAt: now,
+    lastUsedAt: now,
+  };
+}
+
+/* ----------------------------------------------------------------------------------------------
+ * Shared WebAuthn ceremony steps
+ * -------------------------------------------------------------------------------------------- */
+
+const REGISTRATION_SELECTION = {
+  // Discoverable credentials let customers sign in without typing anything.
+  residentKey: 'required',
+  userVerification: 'required',
+};
+
+async function verifyRegistration(response, expectedChallenge) {
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: config.origin,
+      expectedRPID: config.rpID,
+      requireUserVerification: true,
+    });
+  } catch (err) {
+    console.warn('Passkey registration failed verification:', err.message);
+    throw new HttpError(400, 'verification_failed', 'We could not verify that passkey. Please try again.');
+  }
+  if (!verification.verified) {
+    throw new HttpError(400, 'verification_failed', 'We could not verify that passkey. Please try again.');
+  }
+  return verification.registrationInfo;
+}
+
+/**
+ * Verifies an authentication assertion against a stored passkey and records its use.
+ * `expectedUserId` restricts the assertion to a particular account (used for reauthentication).
+ */
+async function verifyAssertion(store, response, expectedChallenge, expectedUserId) {
+  const match = store.findPasskey(response.id);
+  if (!match || (expectedUserId && match.user.id !== expectedUserId)) {
+    throw new HttpError(
+      400,
+      'unknown_credential',
+      'That passkey isn’t registered with The Daily Grind. It may have been removed from your account.',
+      // Lets the browser hide this stale passkey via PublicKeyCredential.signalUnknownCredential().
+      expectedUserId ? {} : { credentialID: response.id },
+    );
+  }
+  const { user, passkey } = match;
+
+  // The user handle the authenticator returns must match the account the passkey belongs to.
+  if (response.response?.userHandle && response.response.userHandle !== user.webauthnUserID) {
+    throw new HttpError(400, 'verification_failed', 'We could not verify that passkey. Please try again.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: config.origin,
+      expectedRPID: config.rpID,
+      credential: toWebAuthnCredential(passkey),
+      requireUserVerification: true,
+    });
+  } catch (err) {
+    console.warn('Passkey authentication failed verification:', err.message);
+    throw new HttpError(400, 'verification_failed', 'We could not verify that passkey. Please try again.');
+  }
+  if (!verification.verified) {
+    throw new HttpError(400, 'verification_failed', 'We could not verify that passkey. Please try again.');
+  }
+
+  const info = verification.authenticationInfo;
+  passkey.counter = info.newCounter;
+  passkey.backedUp = info.credentialBackedUp;
+  passkey.deviceType = info.credentialDeviceType;
+  passkey.lastUsedAt = new Date().toISOString();
+  await store.save();
+  return user;
+}
+
+/* ----------------------------------------------------------------------------------------------
+ * Routes
+ * -------------------------------------------------------------------------------------------- */
+
+export function createApi(store) {
+  function requireUser(req) {
+    const session = getSession(req);
+    const user = session?.userId && store.getUserById(session.userId);
+    if (!user) throw new HttpError(401, 'unauthenticated', 'Please sign in to continue.');
+    return { session, user };
+  }
+
+  /** Sensitive actions require a passkey verification within the last few minutes. */
+  function requireRecentAuth(session) {
+    if (!hasRecentAuth(session)) {
+      throw new HttpError(403, 'reauth_required', 'Please confirm it’s you with your passkey to continue.');
+    }
+  }
+
+  function findOwnPasskey(user, id) {
+    const passkey = user.passkeys.find((p) => p.id === id);
+    if (!passkey) throw new HttpError(404, 'passkey_not_found', 'That passkey was not found on your account.');
+    return passkey;
+  }
+
+  const routes = {
+    'GET /api/session': async (req) => {
+      const session = getSession(req);
+      const user = session?.userId && store.getUserById(session.userId);
+      return {
+        rpID: config.rpID,
+        user: user ? serializeUser(user, session) : null,
+      };
+    },
+
+    /* ----- Account registration (sign up with a passkey) ----- */
+
+    'POST /api/register/options': async (req, res, body) => {
+      rateLimit(req);
+      const name = normalizeName(body.name);
+      const email = normalizeEmail(body.email);
+      if (store.getUserByEmail(email)) {
+        throw new HttpError(409, 'email_taken', 'An account with that email already exists. Try signing in instead.');
+      }
+
+      const session = ensureSession(req, res);
+      const webauthnUserID = isoBase64URL.fromBuffer(crypto.randomBytes(32));
+      const options = await generateRegistrationOptions({
+        rpName: config.rpName,
+        rpID: config.rpID,
+        userID: isoBase64URL.toBuffer(webauthnUserID),
+        userName: email,
+        userDisplayName: name,
+        timeout: config.ceremonyTimeout,
+        attestationType: 'none',
+        authenticatorSelection: REGISTRATION_SELECTION,
+        extensions: { credProps: true },
+      });
+      // The account is only created once the passkey is verified.
+      storeChallenge(session, 'register', options.challenge, { pending: { name, email, webauthnUserID } });
+      return { options };
+    },
+
+    'POST /api/register/verify': async (req, res, body) => {
+      rateLimit(req);
+      const response = requireResponse(body);
+      const session = getSession(req);
+      const entry = takeChallenge(session, 'register');
+      if (!entry) throw new HttpError(400, 'challenge_expired', 'That request expired. Please try again.');
+
+      const registrationInfo = await verifyRegistration(response, entry.challenge);
+      const { name, email, webauthnUserID } = entry.pending;
+      if (store.getUserByEmail(email)) {
+        throw new HttpError(409, 'email_taken', 'An account with that email already exists. Try signing in instead.');
+      }
+      if (store.findPasskey(registrationInfo.credential.id)) {
+        throw new HttpError(409, 'passkey_exists', 'That passkey is already registered.');
+      }
+
+      const now = new Date().toISOString();
+      const user = await store.createUser({
+        id: crypto.randomUUID(),
+        webauthnUserID,
+        email,
+        name,
+        createdAt: now,
+        updatedAt: now,
+        passkeys: [newPasskeyRecord(registrationInfo)],
+      });
+      const newSession = signIn(req, res, user.id);
+      return { user: serializeUser(user, newSession) };
+    },
+
+    /* ----- Sign in ----- */
+
+    'POST /api/login/options': async (req, res) => {
+      rateLimit(req);
+      const session = ensureSession(req, res);
+      // No allowCredentials: the browser offers the customer's discoverable passkeys for this site,
+      // which also powers passkey autofill (conditional mediation) on the email field.
+      const options = await generateAuthenticationOptions({
+        rpID: config.rpID,
+        userVerification: 'required',
+        timeout: config.ceremonyTimeout,
+      });
+      storeChallenge(session, 'login', options.challenge);
+      return { options };
+    },
+
+    'POST /api/login/verify': async (req, res, body) => {
+      rateLimit(req);
+      const response = requireResponse(body);
+      const entry = takeChallenge(getSession(req), 'login');
+      if (!entry) throw new HttpError(400, 'challenge_expired', 'That sign-in request expired. Please try again.');
+
+      const user = await verifyAssertion(store, response, entry.challenge);
+      const session = signIn(req, res, user.id);
+      return { user: serializeUser(user, session) };
+    },
+
+    'POST /api/logout': async (req, res) => {
+      signOut(req, res);
+      return { ok: true };
+    },
+
+    /* ----- Reauthentication ----- */
+
+    'POST /api/reauth/options': async (req) => {
+      rateLimit(req);
+      const { session, user } = requireUser(req);
+      const options = await generateAuthenticationOptions({
+        rpID: config.rpID,
+        // Only this customer's passkeys are acceptable.
+        allowCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+        userVerification: 'required',
+        timeout: config.ceremonyTimeout,
+      });
+      storeChallenge(session, 'reauth', options.challenge);
+      return { options };
+    },
+
+    'POST /api/reauth/verify': async (req, res, body) => {
+      rateLimit(req);
+      const response = requireResponse(body);
+      const { session, user } = requireUser(req);
+      const entry = takeChallenge(session, 'reauth');
+      if (!entry) throw new HttpError(400, 'challenge_expired', 'That request expired. Please try again.');
+
+      await verifyAssertion(store, response, entry.challenge, user.id);
+      session.reauthAt = Date.now();
+      return { user: serializeUser(user, session) };
+    },
+
+    /* ----- Profile ----- */
+
+    'PATCH /api/profile': async (req, res, body) => {
+      const { session, user } = requireUser(req);
+      const name = body.name === undefined ? user.name : normalizeName(body.name);
+      const email = body.email === undefined ? user.email : normalizeEmail(body.email);
+
+      if (email !== user.email) {
+        // Changing the sign-in identifier is sensitive.
+        requireRecentAuth(session);
+        const existing = store.getUserByEmail(email);
+        if (existing && existing.id !== user.id) {
+          throw new HttpError(409, 'email_taken', 'That email is already used by another account.');
+        }
+      }
+
+      user.name = name;
+      user.email = email;
+      user.updatedAt = new Date().toISOString();
+      await store.save();
+      return { user: serializeUser(user, session) };
+    },
+
+    /* ----- Passkey management ----- */
+
+    'POST /api/passkeys/options': async (req) => {
+      rateLimit(req);
+      const { session, user } = requireUser(req);
+      requireRecentAuth(session);
+      if (user.passkeys.length >= MAX_PASSKEYS) {
+        throw new HttpError(409, 'too_many_passkeys', `You can save up to ${MAX_PASSKEYS} passkeys.`);
+      }
+      const options = await generateRegistrationOptions({
+        rpName: config.rpName,
+        rpID: config.rpID,
+        userID: isoBase64URL.toBuffer(user.webauthnUserID),
+        userName: user.email,
+        userDisplayName: user.name,
+        timeout: config.ceremonyTimeout,
+        attestationType: 'none',
+        // Prevents creating a second passkey in a provider that already holds one for this account.
+        excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+        authenticatorSelection: REGISTRATION_SELECTION,
+        extensions: { credProps: true },
+      });
+      storeChallenge(session, 'add-passkey', options.challenge);
+      return { options };
+    },
+
+    'POST /api/passkeys/verify': async (req, res, body) => {
+      rateLimit(req);
+      const response = requireResponse(body);
+      const { session, user } = requireUser(req);
+      const entry = takeChallenge(session, 'add-passkey');
+      if (!entry) throw new HttpError(400, 'challenge_expired', 'That request expired. Please try again.');
+      requireRecentAuth(session);
+
+      const registrationInfo = await verifyRegistration(response, entry.challenge);
+      if (store.findPasskey(registrationInfo.credential.id)) {
+        throw new HttpError(409, 'passkey_exists', 'That passkey is already registered.');
+      }
+      const passkey = newPasskeyRecord(registrationInfo);
+      user.passkeys.push(passkey);
+      await store.save();
+      return { user: serializeUser(user, session), passkeyId: passkey.id };
+    },
+
+    'PATCH /api/passkeys/:id': async (req, res, body, id) => {
+      const { session, user } = requireUser(req);
+      const passkey = findOwnPasskey(user, id);
+      passkey.name = normalizeName(body.name, { field: 'passkey_name', label: 'Passkey name', max: 60 });
+      await store.save();
+      return { user: serializeUser(user, session) };
+    },
+
+    'DELETE /api/passkeys/:id': async (req, res, body, id) => {
+      const { session, user } = requireUser(req);
+      const passkey = findOwnPasskey(user, id);
+      requireRecentAuth(session);
+      if (user.passkeys.length === 1) {
+        throw new HttpError(
+          409,
+          'last_passkey',
+          'This is your only passkey. Create another one before removing it so you don’t get locked out.',
+        );
+      }
+      user.passkeys = user.passkeys.filter((p) => p !== passkey);
+      await store.save();
+      // A removed passkey might be lost or compromised, so sign out everywhere else.
+      revokeUserSessions(user.id, session.id);
+      return { user: serializeUser(user, session) };
+    },
+  };
+
+  function matchRoute(method, pathname) {
+    const exact = routes[`${method} ${pathname}`];
+    if (exact) return { handler: exact };
+    const m = pathname.match(/^\/api\/passkeys\/([A-Za-z0-9_-]+)$/);
+    if (m) {
+      const handler = routes[`${method} /api/passkeys/:id`];
+      if (handler) return { handler, param: m[1] };
+    }
+    return null;
+  }
+
+  return async function handleApi(req, res, url) {
+    try {
+      const route = matchRoute(req.method, url.pathname);
+      if (!route) throw new HttpError(404, 'not_found', 'Not found.');
+
+      let body = {};
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        assertSameOrigin(req);
+        if (req.method !== 'DELETE') body = await readJSON(req);
+      }
+      const result = await route.handler(req, res, body, route.param);
+      sendJSON(res, 200, result);
+    } catch (err) {
+      if (!(err instanceof HttpError)) throw err;
+      sendJSON(res, err.status, { error: err.code, message: err.message, ...err.extra });
+    }
+  };
+}
