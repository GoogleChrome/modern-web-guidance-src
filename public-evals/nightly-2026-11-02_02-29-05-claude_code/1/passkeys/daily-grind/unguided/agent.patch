+describe('account management', () => {
+  test('updates the name freely but requires reauthentication to change email', async () => {
+    const auth = new SoftAuthenticator();
+    const client = new Client();
+    await client.register(auth, { name: 'Margaret', email: 'margaret@example.com' });
+    await new Client().register(new SoftAuthenticator(), { name: 'Other', email: 'taken@example.com' });
+
+    await withStaleAuth(async () => {
+      const rename = await client.request('PATCH', '/api/profile', { name: 'Margaret Hamilton', email: 'margaret@example.com' });
+      assert.equal(rename.status, 200);
+      assert.equal(rename.data.user.name, 'Margaret Hamilton');
+
+      const change = await client.request('PATCH', '/api/profile', { email: 'mh@example.com' });
+      assert.equal(change.status, 403);
+      assert.equal(change.data.error, 'reauth_required');
+    });
+
+    assert.equal((await client.reauth(auth)).status, 200);
+    const taken = await client.request('PATCH', '/api/profile', { email: 'taken@example.com' });
+    assert.equal(taken.data.error, 'email_taken');
+    const change = await client.request('PATCH', '/api/profile', { email: 'MH@example.com' });
+    assert.equal(change.status, 200);
+    assert.equal(change.data.user.email, 'mh@example.com');
+  });
+
+  test('adds, renames, and removes passkeys with reauthentication', async () => {
+    const phone = new SoftAuthenticator();
+    const laptop = new SoftAuthenticator({ aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d' });
+    const client = new Client();
+    const signup = await client.register(phone, { name: 'Barbara', email: 'barbara@example.com' });
+    const phoneId = signup.data.user.passkeys[0].id;
+
+    const lastOne = await client.request('DELETE', `/api/passkeys/${phoneId}`);
+    assert.equal(lastOne.status, 409);
+    assert.equal(lastOne.data.error, 'last_passkey');
+
+    const stale = await withStaleAuth(() => client.addPasskey(laptop));
+    assert.equal(stale.data.error, 'reauth_required');
+
+    // Re-registering a provider that already has a passkey for this account is excluded.
+    const excluded = await client.request('POST', '/api/passkeys/options', {});
+    assert.deepEqual(excluded.data.options.excludeCredentials.map((c) => c.id), [phoneId]);
+    assert.throws(() => phone.create(excluded.data.options), { name: 'InvalidStateError' });
+
+    const added = await client.addPasskey(laptop);
+    assert.equal(added.status, 200, JSON.stringify(added.data));
+    assert.equal(added.data.user.passkeys.length, 2);
+    const laptopKey = added.data.user.passkeys.find((p) => p.id === added.data.passkeyId);
+    assert.equal(laptopKey.name, '1Password');
+
+    const renamed = await client.request('PATCH', `/api/passkeys/${laptopKey.id}`, { name: '  Work laptop ' });
+    assert.equal(renamed.data.user.passkeys.find((p) => p.id === laptopKey.id).name, 'Work laptop');
+    const blank = await client.request('PATCH', `/api/passkeys/${laptopKey.id}`, { name: '' });
+    assert.equal(blank.data.error, 'invalid_passkey_name');
+
+    // Another device stays signed in until a passkey is removed.
+    const otherDevice = new Client();
+    assert.equal((await otherDevice.login(laptop)).status, 200);
+
+    const staleDelete = await withStaleAuth(() => client.request('DELETE', `/api/passkeys/${phoneId}`));
+    assert.equal(staleDelete.data.error, 'reauth_required');
+
+    assert.equal((await client.reauth(laptop)).status, 200);
+    const removed = await client.request('DELETE', `/api/passkeys/${phoneId}`);
+    assert.equal(removed.status, 200);
+    assert.deepEqual(removed.data.user.passkeys.map((p) => p.id), [laptopKey.id]);
+    assert.equal((await otherDevice.request('GET', '/api/session')).data.user, null);
+
+    const signInWithRemoved = await new Client().login(phone);
+    assert.equal(signInWithRemoved.data.error, 'unknown_credential');
+  });
+
+  test('reauthentication only accepts the signed-in customer’s passkeys', async () => {
+    const mine = new SoftAuthenticator();
+    const theirs = new SoftAuthenticator();
+    const client = new Client();
+    await client.register(mine, { name: 'Me', email: 'me@example.com' });
+    await new Client().register(theirs, { name: 'Them', email: 'them@example.com' });
+
+    const opts = await client.request('POST', '/api/reauth/options', {});
+    assert.equal(opts.data.options.allowCredentials.length, 1);
+    const res = await client.request('POST', '/api/reauth/verify', {
+      response: theirs.get(opts.data.options, theirs.credentials[0].id),
+    });
+    assert.equal(res.data.error, 'unknown_credential');
+  });
+
+  test('cannot manage another customer’s passkeys', async () => {
+    const victimAuth = new SoftAuthenticator();
+    const victim = new Client();
+    const v = await victim.register(victimAuth, { name: 'Victim', email: 'victim@example.com' });
+    const attacker = new Client();
+    await attacker.register(new SoftAuthenticator(), { name: 'Mallory', email: 'mallory@example.com' });
+
+    const res = await attacker.request('PATCH', `/api/passkeys/${v.data.user.passkeys[0].id}`, { name: 'pwned' });
+    assert.equal(res.status, 404);
+  });
+});
