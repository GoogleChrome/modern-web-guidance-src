+describe('request protections', () => {
+  test('requires sign-in for account routes', async () => {
+    const client = new Client();
+    for (const [method, url, body] of [
+      ['PATCH', '/api/profile', { name: 'x' }],
+      ['POST', '/api/passkeys/options', {}],
+      ['POST', '/api/reauth/options', {}],
+      ['DELETE', '/api/passkeys/abc'],
+    ]) {
+      const res = await client.request(method, url, body);
+      assert.equal(res.status, 401, `${method} ${url}`);
+    }
+  });
+
+  test('blocks cross-site and non-JSON requests', async () => {
+    const auth = new SoftAuthenticator();
+    const client = new Client();
+    await client.register(auth, { name: 'Csrf', email: 'csrf@example.com' });
+
+    const crossSite = await client.request('PATCH', '/api/profile', { name: 'Hacked' }, { origin: 'https://evil.example' });
+    assert.equal(crossSite.status, 403);
+    assert.equal(crossSite.data.error, 'bad_origin');
+
+    const noOrigin = await client.request('POST', '/api/logout', {}, { origin: null });
+    assert.equal(noOrigin.status, 403);
+
+    const form = await client.request('PATCH', '/api/profile', { name: 'Hacked' }, { contentType: 'text/plain' });
+    assert.equal(form.status, 415);
+    assert.equal(store.getUserByEmail('csrf@example.com').name, 'Csrf');
+  });
+
+  test('rate limits ceremony endpoints', async () => {
+    const client = new Client();
+    let last;
+    for (let i = 0; i < 31; i++) last = await client.request('POST', '/api/login/options', {});
+    assert.equal(last.status, 429);
+  });
+});
