+    /* Decorative CSS icons
+       Icons are purely decorative: the heading/link text already carries the
+       meaning, so generated content gets empty alt text ("/ ''") and is never
+       announced. The single-value `content` line is a fallback for browsers
+       without the alt-text syntax. */
+    .icon-start::before,
+    .icon-end::after {
+      content: "";
+      content: "" / "";
+      display: inline-block;
+      width: var(--icon-size, 1em);
+      height: var(--icon-size, 1em);
+      background-color: var(--icon-color, currentColor);
+      mask: var(--icon) no-repeat center / contain;
+      vertical-align: calc(0.5cap - var(--icon-size, 1em) / 2 - 0.02em);
+      flex: none;
+      pointer-events: none;
+      /* Keep masked icons visible in forced-colors mode */
+      forced-color-adjust: none;
+    }
+
+    .icon-start::before {
+      margin-inline-end: 0.4em;
+    }
+
+    .icon-end::after {
+      margin-inline-start: 0.4em;
+    }
+
+    /* Section heading flourish: ornamental glyphs hidden from screen readers */
+    .section-title {
+      text-align: center;
+      color: var(--primary);
+    }
+
+    .section-title::before,
+    .section-title::after {
+      color: var(--accent);
+      font-size: 0.8em;
+    }
+
+    .section-title::before {
+      content: "\2766\00a0";
+      content: "\2766\00a0" / "";
+    }
+
+    .section-title::after {
+      content: "\00a0\2766";
+      content: "\00a0\2766" / "";
+      display: inline-block;
+      transform: scaleX(-1);
+    }
+
+    /* Drink heading icons */
+    .card h3 {
+      --icon-color: var(--accent);
+      --icon-size: 1.1em;
+    }
+
+    .card h3::after {
+      /* Accent underline flourish (no content, so nothing to announce) */
+      content: "";
+      display: block;
+      width: 3rem;
+      height: 3px;
+      margin: 0.4rem auto 0;
+      border-radius: 3px;
+      background: linear-gradient(90deg, transparent, var(--accent), transparent);
+    }
+
+    .drink-maple {
+      --icon: var(--icon-maple);
+    }
+
+    .drink-espresso {
+      --icon: var(--icon-bean);
+    }
+
+    .drink-cold-brew {
+      --icon: var(--icon-ice);
+    }
+
+    /* Button icons */
+    .btn-order {
+      --icon: var(--icon-cup);
+      --icon-size: 1.15em;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .btn-order:hover {
+      background: #ffc370;
+    }
+
+    .btn-details {
+      --icon: var(--icon-arrow);
+      --icon-size: 0.9em;
+    }
+
+    .btn-details::after {
+      transition: translate 0.2s ease;
+    }
+
+    .btn-details:hover::after,
+    .btn-details:focus-visible::after {
+      translate: 0.2em 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn-details::after {
+        transition: none;
+      }
+    }
+
