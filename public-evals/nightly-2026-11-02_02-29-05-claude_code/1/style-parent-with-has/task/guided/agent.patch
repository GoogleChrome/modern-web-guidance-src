diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,85 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+      margin: 60px auto 0;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact form {
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    .field {
+      background: white;
+      padding: 12px 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      transition: border-color 0.2s;
+    }
+
+    .field label {
+      display: block;
+      font-weight: 600;
+      margin-bottom: 4px;
+    }
+
+    .field input,
+    .field textarea {
+      width: 100%;
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      padding: 10px;
+      border: 1px solid #a1887f;
+      border-radius: 4px;
+    }
+
+    .field textarea {
+      min-height: 140px;
+      resize: vertical;
+    }
+
+    .field input:focus-visible,
+    .field textarea:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .field .error-msg {
+      display: none;
+      color: #c62828;
+      font-size: 0.875rem;
+      margin-top: 4px;
+    }
+
+    /* Invalid state: only after the user has interacted or tried to submit */
+    .field:has(:user-invalid) {
+      border-color: #c62828;
+    }
+
+    .field:has(:user-invalid) .error-msg {
+      display: block;
+    }
+
+    .contact button {
+      align-self: flex-start;
+      font: inherit;
+      border: none;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
