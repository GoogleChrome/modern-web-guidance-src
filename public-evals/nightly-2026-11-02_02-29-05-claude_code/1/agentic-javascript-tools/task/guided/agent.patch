diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,97 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        price: { small: 4.75, medium: 5.25, large: 5.75 },
+        caffeineMg: 150,
+        dairyFree: true,
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        price: { single: 2.75, double: 3.50 },
+        caffeineMg: 75,
+        dairyFree: true,
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Drinks",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        price: { medium: 4.50, large: 5.00 },
+        caffeineMg: 200,
+        dairyFree: true,
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    const normalize = (value) => value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
+
+    function findMenuItem(itemName) {
+      const query = normalize(itemName);
+      return (
+        MENU_ITEMS.find((item) => normalize(item.name) === query) ??
+        MENU_ITEMS.find((item) => normalize(item.name).includes(query) || query.includes(normalize(item.name)))
+      );
+    }
+
+    let toolController;
+
+    function registerMenuTools() {
+      if (!("modelContext" in document) || toolController) return;
+      toolController = new AbortController();
+
+      document.modelContext.registerTool({
+        name: "get_menu_item_details",
+        description: "Looks up a drink on The Daily Grind menu by name and returns its description, category, prices by size, caffeine content, and dietary info. Use when the user asks about a specific menu item.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            itemName: {
+              type: "string",
+              description: "Name of the menu item as the user said it, e.g. \"maple oat latte\". Case and punctuation don't matter.",
+            },
+          },
+          required: ["itemName"],
+        },
+        execute({ itemName } = {}) {
+          if (typeof itemName !== "string" || !itemName.trim()) {
+            return { error: "Provide the name of a menu item.", availableItems: MENU_ITEMS.map((item) => item.name) };
+          }
+          const item = findMenuItem(itemName);
+          if (!item) {
+            return { error: `Menu item "${itemName}" not found.`, availableItems: MENU_ITEMS.map((item) => item.name) };
+          }
+          return { ...item, url: new URL(item.url, location.origin).href, currency: "USD" };
+        },
+        annotations: { readOnlyHint: true },
+      }, { signal: toolController.signal }).catch((err) => {
+        console.warn("Failed to register WebMCP menu tool:", err);
+        toolController = undefined;
+      });
+    }
+
+    function unregisterMenuTools() {
+      toolController?.abort();
+      toolController = undefined;
+    }
+
+    registerMenuTools();
+    // Unregister when the page is unloaded or enters the back/forward cache; re-register if restored from it.
+    addEventListener("pagehide", unregisterMenuTools);
+    addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
