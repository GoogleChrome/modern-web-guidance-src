diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,112 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose a client-side tool so in-browser AI assistants can look up menu items.
+    (() => {
+      if (!('modelContext' in navigator)) return;
+
+      const TOOL_NAME = 'get_menu_item_details';
+      const normalize = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+      // Read menu items from the rendered cards so the tool always matches what's on the page.
+      const getMenuItems = () =>
+        [...document.querySelectorAll('.card')].map((card) => {
+          const link = card.querySelector('a');
+          return {
+            name: card.querySelector('h3')?.textContent.trim() ?? '',
+            description: card.querySelector('p')?.textContent.trim() ?? '',
+            detailsUrl: link ? new URL(link.getAttribute('href'), location.href).href : null,
+          };
+        });
+
+      const findMenuItem = (query) => {
+        const q = normalize(query);
+        const items = getMenuItems();
+        return (
+          items.find((item) => normalize(item.name) === q) ??
+          items.find((item) => normalize(item.name).includes(q) || q.includes(normalize(item.name))) ??
+          null
+        );
+      };
+
+      const textResult = (data) => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+
+      const tool = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item at The Daily Grind coffee shop by its name ' +
+          '(e.g. "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew"). Returns the item\'s ' +
+          'name, description, and a URL to its full details page. Matching is case-insensitive ' +
+          'and accepts partial names. If no item matches, returns an error with the list of available items.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up, e.g. "Maple Oat Latte" or "cold brew". ' +
+                'Case-insensitive; partial names are accepted.',
+            },
+          },
+          required: ['name'],
+          additionalProperties: false,
+        },
+        annotations: { readOnlyHint: true },
+        async execute({ name } = {}) {
+          if (typeof name !== 'string' || !name.trim()) {
+            return { ...textResult({ error: 'The "name" parameter must be a non-empty string.' }), isError: true };
+          }
+          const item = findMenuItem(name);
+          if (!item) {
+            return {
+              ...textResult({
+                error: `No menu item found matching "${name}".`,
+                availableItems: getMenuItems().map((i) => i.name),
+              }),
+              isError: true,
+            };
+          }
+          return textResult(item);
+        },
+      };
+
+      let controller = null;
+      let registration = null;
+
+      const register = () => {
+        if (controller) return;
+        controller = new AbortController();
+        try {
+          registration = navigator.modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (err) {
+          console.error(`Failed to register WebMCP tool "${TOOL_NAME}":`, err);
+          controller = null;
+        }
+      };
+
+      const unregister = () => {
+        if (!controller) return;
+        controller.abort();
+        // Older implementations ignore the signal and use an explicit unregister API instead.
+        try {
+          if (typeof registration?.unregister === 'function') registration.unregister();
+          else if (typeof navigator.modelContext.unregisterTool === 'function') navigator.modelContext.unregisterTool(TOOL_NAME);
+        } catch {
+          // Already unregistered via the abort signal.
+        }
+        controller = null;
+        registration = null;
+      };
+
+      register();
+      // pagehide fires on unload and when entering the back/forward cache; re-register if restored.
+      window.addEventListener('pagehide', unregister);
+      window.addEventListener('pageshow', (e) => { if (e.persisted) register(); });
+    })();
+  </script>
+
 </body>
 
 </html>
