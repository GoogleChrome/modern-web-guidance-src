+  <script>
+    // The "View Details" buttons declare interestfor="seasonal-preview", so the
+    // browser handles hover/focus/long-press and fires interest/loseinterest on
+    // the preview box itself. One listener pair here covers every button.
+    // Intentionally not a live region: these previews are passive.
+    const seasonalPreview = document.getElementById('seasonal-preview');
+    const defaultPreviewText = seasonalPreview.textContent;
+
+    seasonalPreview.addEventListener('interest', (event) => {
+      seasonalPreview.textContent = event.source?.dataset.drink ?? defaultPreviewText;
+    });
+
+    seasonalPreview.addEventListener('loseinterest', () => {
+      seasonalPreview.textContent = defaultPreviewText;
+    });
+  </script>
+
