+    /* Toast notifications
+       Each toast is its own popover="manual" element in the top layer, so no
+       z-index is needed. Stacking offset comes from sibling-index(); the
+       holder uses display: contents so it never acts as a layout box. */
+    .toast-region {
+      display: contents;
+    }
+
+    .toast {
+      --toast-height: 3.25rem;
+      --toast-gap: 0.75rem;
+      --toast-index: sibling-index();
+
+      position: fixed;
+      inset: auto 1.25rem calc(1.25rem + (var(--toast-index) - 1) * (var(--toast-height) + var(--toast-gap))) auto;
+      margin: 0;
+      block-size: var(--toast-height);
+      inline-size: max-content;
+      max-inline-size: calc(100vw - 2.5rem);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0 0.5rem 0 1rem;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 6px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
+      font-weight: 600;
+
+      opacity: 0;
+      translate: 0 1rem;
+      transition:
+        opacity 0.3s ease,
+        translate 0.3s ease,
+        bottom 0.3s ease,
+        overlay 0.3s allow-discrete,
+        display 0.3s allow-discrete;
+    }
+
+    .toast:not(:is(:popover-open, .\:popover-open)) {
+      display: none;
+    }
+
+    .toast:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .toast:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        translate: 2rem 0;
+      }
+    }
+
+    /* Fallback where sibling-index() is unsupported */
+    @supports not (order: sibling-index()) {
+      .toast { --toast-index: 1; }
+      .toast:nth-child(2) { --toast-index: 2; }
+      .toast:nth-child(3) { --toast-index: 3; }
+      .toast:nth-child(4) { --toast-index: 4; }
+      .toast:nth-child(5) { --toast-index: 5; }
+      .toast:nth-child(6) { --toast-index: 6; }
+      .toast:nth-child(7) { --toast-index: 7; }
+      .toast:nth-child(8) { --toast-index: 8; }
+    }
+
+    .toast-close {
+      display: grid;
+      place-items: center;
+      inline-size: 2rem;
+      block-size: 2rem;
+      border: none;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      background: rgba(255, 255, 255, 0.15);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        translate: none;
+        transition-property: opacity, overlay, display;
+      }
+
+      @starting-style {
+        .toast:is(:popover-open, .\:popover-open) {
