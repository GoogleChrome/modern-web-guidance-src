+  <div class="toast-region" aria-live="polite"></div>
+
+  <template id="toast-template">
+    <div class="toast" popover="manual" role="status">
+      <span>Added to cart!</span>
+      <button type="button" class="toast-close" popovertargetaction="hide" aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const region = document.querySelector(".toast-region");
+    const template = document.getElementById("toast-template");
+    const DURATION = 3000;
+    const EXIT_MS = 300;
+    let count = 0;
+
+    function showToast() {
+      const toast = template.content.firstElementChild.cloneNode(true);
+      toast.id = `toast-${++count}`;
+      toast.querySelector(".toast-close").setAttribute("popovertarget", toast.id);
+
+      const timer = setTimeout(() => toast.hidePopover(), DURATION);
+      toast.addEventListener("toggle", (event) => {
+        if (event.newState !== "closed") return;
+        clearTimeout(timer);
+        setTimeout(() => toast.remove(), EXIT_MS);
+      });
+
+      // Newest toast is first sibling, so it sits at the bottom and older ones shift up
+      region.prepend(toast);
+      toast.showPopover();
+    }
+
+    document.addEventListener("click", (event) => {
+      if (event.target.closest(".toast-trigger")) showToast();
+    });
+  </script>
+
