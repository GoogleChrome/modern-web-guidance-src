+  <script>
+    const TOAST_DURATION = 3000;
+
+    function dismissToast(toast) {
+      if (!toast.isConnected || !toast.matches(':popover-open')) return;
+      toast.hidePopover();
+      // Remove once the exit transition has finished
+      Promise.allSettled(toast.getAnimations().map((a) => a.finished))
+        .then(() => toast.remove());
+    }
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.popover = 'manual';
+      toast.setAttribute('role', 'status');
+
+      const text = document.createElement('span');
+      text.className = 'toast-message';
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('aria-label', 'Dismiss notification');
+      close.textContent = '\u00d7';
+      close.addEventListener('click', () => dismissToast(toast));
+
+      toast.append(text, close);
+      document.body.append(toast);
+      toast.showPopover();
+
+      setTimeout(() => dismissToast(toast), TOAST_DURATION);
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => showToast('Added to cart!'));
+    });
+  </script>
+
