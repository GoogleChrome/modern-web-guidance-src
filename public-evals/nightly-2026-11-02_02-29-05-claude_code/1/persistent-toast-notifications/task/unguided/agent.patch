+    /* Toast notifications
+       Each toast is a manual popover, so it is promoted to the browser's top
+       layer (above everything, no z-index needed). Toasts stack by anchoring
+       to the previous toast: every toast is named --toast, and an element
+       resolves a shared anchor name to the last earlier element with that
+       name. The first toast has no anchor and falls back to the corner. */
+    .toast {
+      /* Reset the UA popover styles */
+      inset: auto;
+      margin: 0;
+
+      position: fixed;
+      right: 1.25rem;
+      anchor-name: --toast;
+      position-anchor: --toast;
+      bottom: calc(anchor(top, 0.5rem) + 0.75rem);
+
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-width: 220px;
+      padding: 0.75rem 0.75rem 0.75rem 1rem;
