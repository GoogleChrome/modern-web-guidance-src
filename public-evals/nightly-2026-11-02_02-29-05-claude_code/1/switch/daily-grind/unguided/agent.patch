+  <script>
+    (function () {
+      var actions = {
+        'pref-dark-mode': function (on) {
+          document.documentElement.dataset.theme = on ? 'dark' : 'light';
+        }
+      };
+
+      function setSwitch(btn, on) {
+        btn.setAttribute('aria-checked', String(on));
+        btn.querySelector('.switch-state').textContent = on ? 'On' : 'Off';
+        if (actions[btn.id]) actions[btn.id](on);
+      }
+
+      document.querySelectorAll('.switch[role="switch"]').forEach(function (btn) {
+        var key = 'daily-grind:' + btn.id;
+        var stored = null;
+        try { stored = localStorage.getItem(key); } catch (e) { }
+        setSwitch(btn, stored === 'true');
+
+        // Clicking the visible label toggles too, like a native <label>.
+        var label = document.getElementById(btn.getAttribute('aria-labelledby'));
+        if (label) label.addEventListener('click', function () { btn.click(); btn.focus(); });
+
+        // <button> already handles Enter/Space and focus natively.
+        btn.addEventListener('click', function () {
+          var on = btn.getAttribute('aria-checked') !== 'true';
+          setSwitch(btn, on);
+          try { localStorage.setItem(key, String(on)); } catch (e) { }
+        });
+      });
+    })();
+  </script>
+
