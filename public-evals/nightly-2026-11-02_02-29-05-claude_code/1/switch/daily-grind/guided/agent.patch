+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://cdn.jsdelivr.net/npm/input-switch-polyfill@1.12.0/input-switch-polyfill.js');
+    }
+
+    const form = document.getElementById('preferences-form');
+    const status = document.getElementById('preferences-status');
+    const saved = JSON.parse(localStorage.getItem('dailyGrindPreferences') ?? '{}');
+
+    for (const input of form.querySelectorAll('input[switch]')) {
+      if (input.name in saved) input.checked = saved[input.name];
+
+      input.addEventListener('change', () => {
+        saved[input.name] = input.checked;
+        localStorage.setItem('dailyGrindPreferences', JSON.stringify(saved));
+        const label = input.closest('label').querySelector('span').firstChild.textContent.trim();
+        status.textContent = `${label} turned ${input.checked ? 'on' : 'off'}.`;
+      });
+    }
+  </script>
