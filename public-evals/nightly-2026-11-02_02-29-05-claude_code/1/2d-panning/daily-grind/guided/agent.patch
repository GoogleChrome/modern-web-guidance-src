+  <script>
+    const mapViewport = document.querySelector('.map-viewport');
+
+    // Start centered on the flagship store
+    mapViewport.scrollLeft = (mapViewport.scrollWidth - mapViewport.clientWidth) / 2;
+    mapViewport.scrollTop = (mapViewport.scrollHeight - mapViewport.clientHeight) / 3;
+
+    // Without native scroll-axis-lock support, pan via scrollLeft/scrollTop
+    // so gestures are never railed to a single axis.
+    if (!CSS.supports('scroll-axis-lock', 'none')) {
+      const DRAG_THRESHOLD = 4;
+      let pan = null;
+
+      mapViewport.addEventListener('wheel', (e) => {
+        e.preventDefault();
+        mapViewport.scrollLeft += e.deltaX;
+        mapViewport.scrollTop += e.deltaY;
+      }, { passive: false });
+
+      mapViewport.addEventListener('pointerdown', (e) => {
+        const rect = mapViewport.getBoundingClientRect();
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - mapViewport.clientLeft >= mapViewport.clientWidth ||
+          e.clientY - rect.top - mapViewport.clientTop >= mapViewport.clientHeight
+        ) {
+          return;
+        }
+        pan = { id: e.pointerId, x: e.clientX, y: e.clientY, dragging: false };
+      });
+
+      mapViewport.addEventListener('pointermove', (e) => {
+        if (!pan || e.pointerId !== pan.id) return;
+        const dx = e.clientX - pan.x;
+        const dy = e.clientY - pan.y;
+        // Only capture once the pointer moves, so taps on pin links still work
+        if (!pan.dragging) {
+          if (Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
+          pan.dragging = true;
+          mapViewport.setPointerCapture(e.pointerId);
+          mapViewport.classList.add('is-panning');
+        }
+        mapViewport.scrollLeft -= dx;
+        mapViewport.scrollTop -= dy;
+        pan.x = e.clientX;
+        pan.y = e.clientY;
+      });
+
+      let suppressClick = false;
+      const endPan = () => {
+        // A drag that ends over a pin link shouldn't trigger the link
+        if (pan && pan.dragging) {
+          suppressClick = true;
+          setTimeout(() => { suppressClick = false; });
+        }
+        pan = null;
+        mapViewport.classList.remove('is-panning');
+      };
+      mapViewport.addEventListener('pointerup', endPan);
+      mapViewport.addEventListener('pointercancel', endPan);
+
+      mapViewport.addEventListener('click', (e) => {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+        }
+      }, true);
+    }
+  </script>
