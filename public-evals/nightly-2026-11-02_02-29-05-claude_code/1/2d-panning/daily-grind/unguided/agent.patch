+  <script>
+    (function () {
+      var viewport = document.getElementById('cafe-map');
+      var card = document.getElementById('map-card');
+
+      var cafes = {
+        downtown: { name: 'Downtown Roastery', address: '120 Main Street', hours: 'Mon–Sun 6am–9pm', photo: 'photo-1554118811-1e0d58224f24' },
+        oldtown: { name: 'Old Town Corner', address: '8 Cobblestone Lane', hours: 'Mon–Sat 7am–6pm', photo: 'photo-1501339847302-ac426a4a7cbb' },
+        harbor: { name: 'Harbor Espresso Bar', address: '45 Pier Road', hours: 'Mon–Sun 6am–8pm', photo: 'photo-1453614512568-c4024d13c247' },
+        riverside: { name: 'Riverside Cafe', address: '300 River Brew Way', hours: 'Mon–Fri 6:30am–7pm', photo: 'photo-1445116572660-236099ec97a0' },
+        gardens: { name: 'Bean Gardens Kiosk', address: 'Bean Gardens, North Gate', hours: 'Daily 8am–4pm', photo: 'photo-1509042239860-f550ce710b93' },
+        campus: { name: 'Campus Commons', address: '1 University Plaza', hours: 'Mon–Fri 7am–10pm', photo: 'photo-1442512595331-e89e73853f31' }
+      };
+
+      // Start centered on the downtown pin.
+      viewport.scrollLeft = 1100 - viewport.clientWidth / 2;
+      viewport.scrollTop = 700 - viewport.clientHeight / 2;
+
+      // Free 2D panning: both deltas are applied every move, so diagonal drags
+      // and mid-gesture direction changes are followed without axis locking.
+      var DRAG_THRESHOLD = 4;
+      var pointerId = null;
+      var startX = 0, startY = 0, lastX = 0, lastY = 0, lastTime = 0;
+      var velX = 0, velY = 0;
+      var dragged = false;
+      var momentumFrame = null;
+
+      function stopMomentum() {
+        if (momentumFrame !== null) {
+          cancelAnimationFrame(momentumFrame);
+          momentumFrame = null;
+        }
+      }
+
+      viewport.addEventListener('pointerdown', function (e) {
+        if (pointerId !== null || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        stopMomentum();
+        pointerId = e.pointerId;
+        startX = lastX = e.clientX;
+        startY = lastY = e.clientY;
+        lastTime = performance.now();
+        velX = velY = 0;
+        dragged = false;
+      });
+
+      viewport.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== pointerId) return;
+        if (!dragged) {
+          if (Math.hypot(e.clientX - startX, e.clientY - startY) < DRAG_THRESHOLD) return;
+          dragged = true;
+          viewport.setPointerCapture(pointerId);
+          viewport.classList.add('is-panning');
+        }
+        var dx = e.clientX - lastX;
+        var dy = e.clientY - lastY;
+        var now = performance.now();
+        var dt = Math.max(now - lastTime, 1);
+        viewport.scrollLeft -= dx;
+        viewport.scrollTop -= dy;
+        // Smoothed velocity (px/ms) for the release glide.
+        velX = 0.8 * (dx / dt) + 0.2 * velX;
+        velY = 0.8 * (dy / dt) + 0.2 * velY;
+        lastX = e.clientX;
+        lastY = e.clientY;
+        lastTime = now;
+      });
+
+      function endPan(e) {
+        if (e.pointerId !== pointerId) return;
+        pointerId = null;
+        viewport.classList.remove('is-panning');
+        if (!dragged) return;
+        // Discard velocity if the pointer paused before release.
+        if (performance.now() - lastTime > 80) return;
+        var vx = velX, vy = velY, prev = performance.now();
+        function glide(now) {
+          var dt = now - prev;
+          prev = now;
+          viewport.scrollLeft -= vx * dt;
+          viewport.scrollTop -= vy * dt;
+          var decay = Math.pow(0.995, dt);
+          vx *= decay;
+          vy *= decay;
+          momentumFrame = Math.hypot(vx, vy) > 0.02 ? requestAnimationFrame(glide) : null;
+        }
+        momentumFrame = requestAnimationFrame(glide);
+      }
+
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+      viewport.addEventListener('wheel', stopMomentum, { passive: true });
+
+      // A drag that ends over a pin shouldn't also open it.
+      viewport.addEventListener('click', function (e) {
+        if (dragged) {
+          e.preventDefault();
+          e.stopPropagation();
+          dragged = false;
+        }
+      }, true);
+
+      viewport.addEventListener('keydown', function (e) {
+        if (e.target !== viewport) return;
+        var step = e.shiftKey ? 200 : 60;
+        var moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+        var move = moves[e.key];
+        if (!move) return;
+        e.preventDefault();
+        stopMomentum();
+        viewport.scrollBy({ left: move[0], top: move[1], behavior: 'smooth' });
+      });
+
+      // Location detail card
+      var activePin = null;
+
+      function closeCard() {
+        card.hidden = true;
+        if (activePin) activePin.classList.remove('is-active');
+        activePin = null;
+      }
+
+      viewport.querySelectorAll('.map-pin').forEach(function (pin) {
+        pin.addEventListener('click', function () {
+          var cafe = cafes[pin.dataset.cafe];
+          if (activePin) activePin.classList.remove('is-active');
+          activePin = pin;
+          pin.classList.add('is-active');
+          card.style.left = pin.style.left;
+          card.style.top = pin.style.top;
+          card.querySelector('img').src = 'https://images.unsplash.com/' + cafe.photo + '?auto=format&fit=crop&w=520&q=70';
+          card.querySelector('img').alt = cafe.name + ' interior';
+          card.querySelector('h3').textContent = cafe.name;
+          card.querySelector('.map-card-address').textContent = cafe.address;
+          card.querySelector('.map-card-hours').textContent = cafe.hours;
+          card.hidden = false;
+        });
+      });
+
+      card.querySelector('.map-card-close').addEventListener('click', function () {
+        var pin = activePin;
+        closeCard();
+        if (pin) pin.focus();
+      });
+
+      viewport.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && !card.hidden) closeCard();
+      });
+    })();
+  </script>
+
