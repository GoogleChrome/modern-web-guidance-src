+  <script>
+    // Apply a "next"/"previous" view transition type on cross-document navigations.
+    // Registered in <head> so the listener is in place before the first render.
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const DIRECTION_KEY = 'daily-grind:nav-direction';
+
+      const pageOf = (url) => {
+        const page = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+        return Number.isFinite(page) && page > 0 ? page : 1;
+      };
+
+      // Remember which pagination link was clicked so the next page knows the direction.
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('#next, #previous');
+        if (link) sessionStorage.setItem(DIRECTION_KEY, link.id);
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+
+        let direction = sessionStorage.getItem(DIRECTION_KEY);
+        sessionStorage.removeItem(DIRECTION_KEY);
+
+        // Back/forward traversals: infer direction from the page numbers.
+        const activation = window.navigation && navigation.activation;
+        if (activation && activation.navigationType === 'traverse' && activation.from) {
+          const from = pageOf(activation.from.url);
+          const to = pageOf(activation.entry.url);
+          direction = to > from ? 'next' : to < from ? 'previous' : null;
+        }
+
+        if (direction === 'next' || direction === 'previous') {
+          event.viewTransition.types.add(direction);
+        }
+      });
+    }
+  </script>
 </head>
 
