   </style>
+
+  <script>
+    // Cross-document page transitions, only when the user hasn't asked for reduced motion.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const DIRECTION_KEY = 'page-transition-direction';
+
+      // Remember which pagination link was used so the next page can pick the matching animation.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('#next, #previous');
+        if (link) sessionStorage.setItem(DIRECTION_KEY, link.id);
+      });
+
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+
+        let type = sessionStorage.getItem(DIRECTION_KEY);
+        sessionStorage.removeItem(DIRECTION_KEY);
+
+        // Back/forward buttons: derive the direction from the history entries.
+        const activation = window.navigation?.activation;
+        if (activation?.navigationType === 'traverse' && activation.from) {
+          type = activation.entry.index > activation.from.index ? 'next' : 'previous';
+        }
+
+        if (type === 'next' || type === 'previous') {
+          e.viewTransition.types.add(type);
+        }
+      });
+    }
+  </script>
