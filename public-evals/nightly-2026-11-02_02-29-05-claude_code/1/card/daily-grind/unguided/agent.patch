+  <div class="order-toast" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      const countEl = document.querySelector('.order-count');
+      const toast = document.querySelector('.order-toast');
+      const order = JSON.parse(sessionStorage.getItem('dailyGrindOrder') || '[]');
+      let toastTimer;
+
+      const updateCount = () => { countEl.textContent = order.length; };
+      updateCount();
+
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const priceEl = form.querySelector('.price');
+        const button = form.querySelector('button[type="submit"]');
+        let resetTimer;
+
+        form.addEventListener('change', () => {
+          const selected = form.querySelector('input[name="size"]:checked');
+          priceEl.textContent = '$' + selected.dataset.price;
+        });
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const selected = form.querySelector('input[name="size"]:checked');
+          const item = { name: form.dataset.item, size: selected.value, price: Number(selected.dataset.price) };
+
+          order.push(item);
+          sessionStorage.setItem('dailyGrindOrder', JSON.stringify(order));
+          updateCount();
+
+          button.textContent = 'Added \u2713';
+          button.classList.add('is-added');
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(() => {
+            button.textContent = 'Add to Order';
+            button.classList.remove('is-added');
+          }, 1500);
+
+          toast.textContent = `Added ${item.size} ${item.name} to your order`;
+          toast.classList.add('is-visible');
+          clearTimeout(toastTimer);
+          toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 2500);
+        });
+      });
+    })();
+  </script>
+
