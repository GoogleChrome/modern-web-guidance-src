+  <script>
+    const ORDER_KEY = 'dailyGrindOrder';
+    const orderCount = document.getElementById('order-count');
+
+    function loadOrder() {
+      try {
+        return JSON.parse(localStorage.getItem(ORDER_KEY)) ?? [];
+      } catch {
+        return [];
+      }
+    }
+
+    function renderCount(order) {
+      orderCount.textContent = order.length;
+    }
+
+    renderCount(loadOrder());
+
+    document.querySelectorAll('.order-form').forEach((form) => {
+      const status = form.querySelector('.order-status');
+      const name = form.closest('.card').querySelector('h3').textContent;
+      let clearTimer;
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const size = form.querySelector('input[name="size"]:checked');
+        const sizeLabel = size.closest('label').querySelector('.size-long').textContent;
+        const order = loadOrder();
+        order.push({ item: form.elements.item.value, size: size.value, price: Number(size.dataset.price) });
+        try {
+          localStorage.setItem(ORDER_KEY, JSON.stringify(order));
+        } catch {
+          // Storage unavailable (private mode, quota): keep the in-page count accurate anyway
+        }
+        renderCount(order);
+        status.textContent = `Added a ${sizeLabel.toLowerCase()} ${name} to your order.`;
+        clearTimeout(clearTimer);
+        clearTimer = setTimeout(() => (status.textContent = ''), 4000);
+      });
+    });
+  </script>
+
 </body>
 
