+  <dialog class="modal" id="logout-dialog" aria-labelledby="logout-dialog-title">
+    <button type="button" class="modal-close" id="close-dialog-btn" aria-label="Close">&times;</button>
+    <h2 id="logout-dialog-title">Log out?</h2>
+    <p>Are you sure you want to log out of your Daily Grind account?</p>
+    <div class="modal-actions">
+      <button type="button" class="btn btn-secondary" data-close-dialog>Cancel</button>
+      <a href="/logout" class="btn">Log Out</a>
+    </div>
+  </dialog>
+
+  <div class="info-overlay" id="info-overlay" role="status" hidden>
+    <span>online ordering is currently offline</span>
+    <button type="button" class="info-overlay-close" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script>
+    // Plays the element's exit animation, then runs the callback.
+    function animateOut(el, done) {
+      el.classList.add('is-closing');
+      el.addEventListener('animationend', function handler(e) {
+        if (e.target !== el) return;
+        el.removeEventListener('animationend', handler);
+        el.classList.remove('is-closing');
+        done();
+      });
+    }
+
+    const dialog = document.getElementById('logout-dialog');
+
+    function closeDialog() {
+      if (!dialog.open || dialog.classList.contains('is-closing')) return;
+      animateOut(dialog, () => dialog.close());
+    }
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    dialog.querySelector('[data-close-dialog]').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) {
+        const r = dialog.getBoundingClientRect();
+        const inside = e.clientX >= r.left && e.clientX <= r.right &&
+          e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDialog();
+      }
+    });
+
+    const overlay = document.getElementById('info-overlay');
+
+    document.getElementById('foobar').addEventListener('click', () => {
+      overlay.classList.remove('is-closing');
+      overlay.hidden = false;
+    });
+    overlay.querySelector('.info-overlay-close').addEventListener('click', () => {
+      if (overlay.classList.contains('is-closing')) return;
+      animateOut(overlay, () => { overlay.hidden = true; });
+    });
+  </script>
+
