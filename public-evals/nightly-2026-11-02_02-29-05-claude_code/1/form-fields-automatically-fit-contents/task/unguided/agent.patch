+  <script>
+    // Fallback for browsers without `field-sizing: content` support:
+    // measure each field's content and size it to fit.
+    if (!CSS.supports('field-sizing', 'content')) {
+      const mirror = document.createElement('span');
+      mirror.style.cssText = 'position:absolute;visibility:hidden;top:0;left:-9999px;white-space:pre;';
+      document.body.appendChild(mirror);
+
+      const textWidth = (el, text) => {
+        const cs = getComputedStyle(el);
+        mirror.style.font = cs.font;
+        mirror.style.letterSpacing = cs.letterSpacing;
+        mirror.textContent = text || ' ';
+        return mirror.getBoundingClientRect().width;
+      };
+
+      const chrome = (el) => {
+        const cs = getComputedStyle(el);
+        return ['paddingLeft', 'paddingRight', 'borderLeftWidth', 'borderRightWidth']
+          .reduce((sum, prop) => sum + parseFloat(cs[prop]), 0);
+      };
+
+      const fit = (el) => {
+        if (el.tagName === 'SELECT') {
+          const label = el.options[el.selectedIndex]?.text;
+          // Leave room for the native dropdown arrow
+          el.style.width = `${Math.ceil(textWidth(el, label) + chrome(el) + 24)}px`;
+        } else if (el.tagName === 'TEXTAREA') {
+          const lines = (el.value || el.placeholder).split('\n');
+          const widest = Math.max(...lines.map((line) => textWidth(el, line)));
+          el.style.width = `${Math.ceil(widest + chrome(el) + 2)}px`;
+          el.style.height = 'auto';
+          const cs = getComputedStyle(el);
+          const borders = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
+          el.style.height = `${el.scrollHeight + borders}px`;
+        } else {
+          el.style.width = `${Math.ceil(textWidth(el, el.value || el.placeholder) + chrome(el) + 2)}px`;
+        }
+      };
+
+      document.querySelectorAll('.auto-size').forEach((el) => {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => fit(el));
+        fit(el);
+      });
+    }
+  </script>
