     .btn:hover {
       background: #3e2723;
     }
 
+    /* Feedback Form */
+    .feedback {
+      margin-top: 60px;
+      max-width: 640px;
+      margin-inline: auto;
+    }
+
+    .feedback h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .feedback form {
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      /* Keep controls from stretching so they can size to their content */
+      align-items: flex-start;
+      gap: 4px;
+      margin-block-end: 1.25rem;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .form-group input,
+    .form-group textarea,
+    .form-group select {
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      padding: 0.6rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #8d6e63;
+      border-radius: 5px;
+      background: white;
+      /* Grow and shrink to fit the content (progressive enhancement) */
+      field-sizing: content;
+      max-inline-size: 100%;
+    }
+
+    .form-group input {
+      min-inline-size: 15ch;
+    }
+
+    .form-group textarea {
+      /* Stable width; height follows the content */
+      width: min(100%, 50ch);
+      min-block-size: 3lh;
+      max-block-size: 12lh;
+      resize: vertical;
+    }
+
+    .form-group input:focus-visible,
+    .form-group textarea:focus-visible,
+    .form-group select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .feedback .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
