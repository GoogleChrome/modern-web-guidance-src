+    /* Active nav indicator: tethered to the active item and slides between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      inset-block-start: calc(anchor(bottom) + .1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 3px;
+      border-radius: 2px;
+      background: var(--accent);
+      pointer-events: none;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: inset .3s ease, opacity .3s;
+      }
+
+      @supports not (position-anchor: auto) {
+        display: none;
+      }
+    }
+
+    nav ul:not(:has(li.active))::before {
+      opacity: 0;
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+
+      @supports not (position-anchor: auto) {
+        box-shadow: inset 0 -3px var(--accent);
+      }
+    }
+
