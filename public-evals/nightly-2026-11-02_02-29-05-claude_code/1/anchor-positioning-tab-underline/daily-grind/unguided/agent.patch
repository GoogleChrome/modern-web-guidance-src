+  <script>
+    (function () {
+      var list = document.querySelector('nav ul');
+      var indicator = list.querySelector('.nav-indicator');
+      var items = Array.prototype.slice.call(list.querySelectorAll('.nav-item'));
+      var STORAGE_KEY = 'nav-active';
+      var NAV_DELAY = 350; // matches the indicator transition duration
+      var active = null;
+
+      function moveTo(link, animate) {
+        if (!animate) indicator.classList.add('no-transition');
+        indicator.style.width = link.offsetWidth + 'px';
+        indicator.style.transform = 'translateX(' + link.offsetLeft + 'px)';
+        indicator.style.opacity = '1';
+        if (!animate) {
+          indicator.offsetWidth; // flush styles before re-enabling transitions
+          indicator.classList.remove('no-transition');
+        }
+      }
+
+      function setActive(link, animate) {
+        if (active) {
+          active.classList.remove('active');
+          active.removeAttribute('aria-current');
+        }
+        active = link;
+        link.classList.add('active');
+        link.setAttribute('aria-current', 'page');
+        moveTo(link, animate);
+      }
+
+      function initialItem() {
+        var path = window.location.pathname;
+        var match = items.filter(function (a) {
+          var href = a.getAttribute('href');
+          return path === href || path.indexOf(href + '/') === 0;
+        })[0];
+        if (match) return match;
+        var stored = sessionStorage.getItem(STORAGE_KEY);
+        return items.filter(function (a) { return a.getAttribute('href') === stored; })[0] || null;
+      }
+
+      var start = initialItem();
+      if (start) setActive(start, false);
+
+      items.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          sessionStorage.setItem(STORAGE_KEY, link.getAttribute('href'));
+          if (link === active) return;
+          setActive(link, true);
+
+          // Let a plain click finish the slide before navigating; leave
+          // modified clicks (new tab/window) to the browser.
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+          e.preventDefault();
+          setTimeout(function () { window.location.href = link.href; }, NAV_DELAY);
+        });
+      });
+
+      window.addEventListener('resize', function () {
+        if (active) moveTo(active, false);
+      });
+    })();
+  </script>
