diff --git a/src/components/useModalDialog.ts b/src/components/useModalDialog.ts
new file mode 100644
index 0000000..8a6d6e3
--- /dev/null
+++ b/src/components/useModalDialog.ts
@@ -0,0 +1,30 @@
+import type React from 'react';
+import { useEffect, useRef } from 'react';
+
+export const modalDialogClassName =
+  'm-auto mt-[15vh] p-0 border-0 w-full max-w-[min(42rem,calc(100%-2rem))] max-h-none overflow-visible bg-white shadow-xl backdrop:bg-white/30 backdrop:backdrop-blur-sm';
+
+/**
+ * Opens a native <dialog> as a modal as soon as it mounts. The browser provides focus
+ * trapping, Escape-to-close, inertness of the rest of the page and focus restoration to
+ * the opener; pair the returned `ref` with the dialog's `onClose` prop to unmount it.
+ */
+export function useModalDialog(initialFocusRef?: React.RefObject<HTMLElement | null>) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current;
+    if (!dialog) return;
+    if (!dialog.open) dialog.showModal();
+    initialFocusRef?.current?.focus();
+  }, []);
+
+  const close = () => ref.current?.close();
+
+  // With zero padding on the dialog, a click whose target is the dialog itself landed on the backdrop.
+  const closeOnBackdropClick = (event: React.MouseEvent<HTMLDialogElement>) => {
+    if (event.target === event.currentTarget) close();
+  };
+
+  return { ref, close, closeOnBackdropClick };
+}
