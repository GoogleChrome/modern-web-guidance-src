+  <script>
+    (function () {
+      var form = document.getElementById('subscribe-form');
+      var nameInput = document.getElementById('sub-name');
+      var emailInput = document.getElementById('sub-email');
+      var roast = document.getElementById('roast-level');
+      var roastOutput = document.getElementById('roast-output');
+      var progress = document.getElementById('setup-progress');
+      var progressText = document.getElementById('progress-text');
+      var status = document.getElementById('form-status');
+      var roastNames = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      var roastTouched = false;
+
+      function updateRoast() {
+        var label = roastNames[roast.value - 1];
+        roastOutput.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        var pct = (roast.value - roast.min) / (roast.max - roast.min) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        var steps = [
+          nameInput.value.trim() !== '',
+          emailInput.validity.valid && emailInput.value !== '',
+          !!form.querySelector('input[name="frequency"]:checked'),
+          roastTouched
+        ];
+        var done = steps.filter(Boolean).length;
+        var pct = Math.round(done / steps.length * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progress.setAttribute('aria-valuetext', done + ' of ' + steps.length + ' steps complete');
+        progressText.textContent = pct + '%';
+        return done === steps.length;
+      }
+
+      roast.addEventListener('input', function () {
+        roastTouched = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        roastTouched = true;
+        if (!updateProgress() || !form.checkValidity()) {
+          status.textContent = 'Please enter your name, a valid email, and choose a delivery frequency.';
+          var firstInvalid = form.querySelector(':invalid');
+          if (firstInvalid) firstInvalid.focus();
+          return;
+        }
+        status.textContent = 'Thanks, ' + nameInput.value.trim() + '! Your subscription is all set.';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
