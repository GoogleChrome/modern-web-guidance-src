+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const progress = document.getElementById('setup-progress');
+      const status = document.getElementById('setup-progress-status');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastChosen = false;
+
+      const updateRoast = () => {
+        const label = roastLabels[roast.value - 1];
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roastOutput.value = label;
+        roast.setAttribute('aria-valuetext', label);
+        roast.style.setProperty('--fill', `${pct}%`);
+      };
+
+      const updateProgress = () => {
+        const steps = [
+          form.elements.name.validity.valid,
+          form.elements.email.validity.valid,
+          form.elements.frequency.value !== '',
+          roastChosen,
+        ];
+        const done = steps.filter(Boolean).length;
+        progress.value = done;
+        progress.textContent = `${done} of ${steps.length} steps`;
+        const text = `${done} of ${steps.length} steps complete`;
+        if (status.textContent !== text) status.textContent = text;
+      };
+
+      roast.addEventListener('input', () => {
+        roastChosen = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
