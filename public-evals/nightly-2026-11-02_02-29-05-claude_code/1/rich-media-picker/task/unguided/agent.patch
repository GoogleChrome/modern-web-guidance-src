+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
+    }
+
+    .roast-select::picker-icon {
+      color: var(--primary);
+      transition: rotate 0.2s;
+    }
+
+    .roast-select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 8px 10px;
+      border-radius: 5px;
+      text-align: left;
+      color: var(--text);
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      background: #efebe9;
+    }
+
+    .roast-select option::checkmark {
+      order: 1;
+      margin-left: auto;
+      color: var(--primary);
+    }
+
+    .roast-icon {
+      flex-shrink: 0;
+      width: 32px;
+      height: 32px;
+      color: var(--primary);
+    }
+
+    .roast-text {
+      display: flex;
