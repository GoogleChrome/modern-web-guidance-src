+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      padding: 8px 12px;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select::picker-icon {
+      color: var(--primary);
+    }
+
+    .roast-select::picker(select) {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 4px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 8px 10px;
+      border-radius: 6px;
+      color: var(--text);
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: #efebe9;
+    }
+
+    .roast-select option:checked {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked .roast-title {
+      font-weight: 700;
+    }
+
+    .roast-select option svg {
+      flex-shrink: 0;
+      color: var(--primary);
+    }
+
+    .roast-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-title {
+      font-weight: 600;
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    /* Separator is only for the plain-text fallback */
+    .roast-select .roast-sep,
+    .roast-select selectedcontent .roast-desc {
+      display: none;
+    }
+
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
