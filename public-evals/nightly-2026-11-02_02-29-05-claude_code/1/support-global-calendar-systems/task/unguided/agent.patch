+  <script type="module">
+    // All calendar math goes through Temporal (never legacy Date). Native Temporal is used when it
+    // supports every calendar below; otherwise the polyfill is loaded on demand.
+    const POLYFILL_URL = 'https://esm.sh/temporal-polyfill@1.0.6/es2022/full/implementation.bundle.mjs';
+
+    const FULL_DATE = { weekday: 'long', era: 'long', year: 'numeric', month: 'long', day: 'numeric' };
+    const MONTH_NAME = { month: 'long' };
+
+    const input = document.getElementById('calendar-date-input');
+    const todayButton = document.getElementById('calendar-today-btn');
+    const status = document.getElementById('calendar-status');
+    const cards = [...document.querySelectorAll('.calendar-card[data-calendar]')];
+    const calendarIds = cards.map((card) => card.dataset.calendar);
+
+    let Temporal;
+    let TemporalIntl;
+    let renderedToday;
+    const formatters = new Map();
+
+    function supportsCalendars(T) {
+      try {
+        const probe = T.PlainDate.from('2024-03-15');
+        return calendarIds.every((id) => {
+          const date = probe.withCalendar(id);
+          return date.calendarId === id && /^M\d{2}L?$/.test(date.monthCode) && date.monthsInYear >= 12;
+        });
+      } catch {
+        return false;
+      }
+    }
+
+    async function loadTemporal() {
+      const native = globalThis.Temporal;
+      if (typeof native?.PlainDate?.from === 'function' && supportsCalendars(native)) {
+        return { Temporal: native, Intl: globalThis.Intl };
+      }
+      // The "implementation" entry always provides the full polyfill (it never hands back a partial
+      // native Temporal) and doesn't modify globals.
+      const polyfill = await import(POLYFILL_URL);
+      if (!supportsCalendars(polyfill.Temporal)) {
+        throw new Error('Required calendars are unavailable in this browser.');
+      }
+      return { Temporal: polyfill.Temporal, Intl: polyfill.Intl };
+    }
+
+    // Formatting a Temporal.PlainDate requires the formatter's calendar to match the date's calendar,
+    // so formatters are keyed (and verified) per calendar.
+    function formatter(locale, calendar, options) {
+      const key = JSON.stringify([locale ?? '', calendar, options]);
+      let dtf = formatters.get(key);
+      if (!dtf) {
+        dtf = new TemporalIntl.DateTimeFormat(locale, { ...options, calendar });
+        if (dtf.resolvedOptions().calendar !== calendar) {
+          throw new RangeError(`Calendar "${calendar}" is not supported for formatting.`);
+        }
+        formatters.set(key, dtf);
+      }
+      return dtf;
+    }
+
+    function setStatus(message, isError = false) {
+      status.textContent = message;
+      status.classList.toggle('is-error', isError);
+    }
+
+    function cell(content) {
+      const td = document.createElement('td');
+      td.append(content);
+      return td;
+    }
+
+    function code(text) {
+      const el = document.createElement('code');
+      el.textContent = text;
+      return el;
+    }
+
+    function clearCard(card, message = '—') {
+      for (const el of card.querySelectorAll('[data-field]')) {
+        el.textContent = el.tagName === 'DD' ? '—' : '';
+      }
+      card.querySelector('[data-field="formatted"]').textContent = message;
+      card.querySelector('[data-field="monthsCaption"]').textContent = 'Month breakdown';
+      const badge = card.querySelector('[data-field="timeline"]');
+      badge.textContent = '—';
+      delete badge.dataset.timeline;
+    }
+
+    function renderCard(card, date, timeline) {
+      const calendar = date.calendarId;
+      const field = (name) => card.querySelector(`[data-field="${name}"]`);
+
+      const badge = field('timeline');
+      badge.textContent = timeline;
+      badge.dataset.timeline = timeline.toLowerCase();
+
+      field('formatted').textContent = formatter(undefined, calendar, FULL_DATE).format(date);
+      field('native').textContent = formatter(card.dataset.nativeLocale, calendar, FULL_DATE).format(date);
+
+      field('year').textContent = String(date.year);
+      // Show Temporal's own era fields. Intl's localized era names (already in the formatted date) can
+      // follow a different era scheme, e.g. pre-Meiji Japanese eras vs. Temporal's "ce".
+      if (date.era !== undefined) {
+        field('era').replaceChildren(code(date.era), ` ${date.eraYear}`);
+      } else {
+        field('era').textContent = '—';
+      }
+      field('month').textContent = `${date.month} · ${formatter(undefined, calendar, MONTH_NAME).format(date)}`;
+      field('monthCode').replaceChildren(code(date.monthCode));
+      field('monthsInYear').textContent = String(date.monthsInYear);
+      field('leap').textContent = `${date.inLeapYear ? 'Yes' : 'No'} · ${date.daysInYear} days`;
+      field('monthsCaption').textContent = `Month breakdown · year ${date.year}`;
+
+      const rows = [];
+      for (let month = 1; month <= date.monthsInYear; month++) {
+        // Build from the arithmetic `year` rather than era/eraYear: it stays unambiguous even when a
+        // Japanese era changes partway through the year.
+        const first = Temporal.PlainDate.from({ calendar, year: date.year, month, day: 1 }, { overflow: 'reject' });
+        const row = document.createElement('tr');
+        if (first.monthCode === date.monthCode) {
+          row.className = 'is-selected';
+          row.setAttribute('aria-current', 'date');
+        }
+        row.append(
+          cell(String(month)),
+          cell(code(first.monthCode)),
+          cell(formatter(undefined, calendar, MONTH_NAME).format(first)),
+          cell(String(first.daysInMonth)),
+        );
+        rows.push(row);
+      }
+      field('months').replaceChildren(...rows);
+    }
+
+    function render() {
+      renderedToday = Temporal.Now.plainDateISO();
+
+      if (!input.value) {
+        cards.forEach((card) => clearCard(card));
+        setStatus('Pick a date to convert it.');
+        return;
+      }
+
+      let selected;
+      try {
+        selected = Temporal.PlainDate.from(input.value);
+      } catch {
+        cards.forEach((card) => clearCard(card));
+        setStatus('Please enter a valid date.', true);
+        return;
+      }
+      setStatus('');
+
+      const comparison = Temporal.PlainDate.compare(selected, renderedToday);
+      const timeline = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      for (const card of cards) {
+        try {
+          renderCard(card, selected.withCalendar(card.dataset.calendar), timeline);
+        } catch (error) {
+          console.error(error);
+          clearCard(card, 'This date can’t be shown in this calendar.');
+        }
+      }
+    }
+
+    // Keep the Past/Today/Future labels correct if the page stays open past midnight.
+    function refreshIfDayChanged() {
+      if (renderedToday && !Temporal.Now.plainDateISO().equals(renderedToday)) {
+        render();
+      }
+    }
+
+    try {
+      ({ Temporal, Intl: TemporalIntl } = await loadTemporal());
+      input.value = Temporal.Now.plainDateISO().toString();
+      input.disabled = false;
+      todayButton.disabled = false;
+
+      input.addEventListener('input', render);
+      todayButton.addEventListener('click', () => {
+        input.value = Temporal.Now.plainDateISO().toString();
+        render();
+      });
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'visible') refreshIfDayChanged();
+      });
+      setInterval(refreshIfDayChanged, 60_000);
+
+      render();
+    } catch (error) {
+      console.error(error);
+      setStatus('Sorry, the calendar converter couldn’t be loaded. Please try again later.', true);
+    }
+  </script>
+
 </body>
 
