+  <script type="module">
+    // Progressive enhancement: use native Temporal when present, otherwise load the polyfill.
+    if (typeof globalThis.Temporal === 'undefined') {
+      try {
+        const module = await import('https://esm.sh/temporal-polyfill@0.3');
+        globalThis.Temporal = module.Temporal;
+      } catch {
+        // Handled below: the tool reports that it is unavailable.
+      }
+    }
+
+    const input = document.getElementById('calendar-date');
+    const status = document.getElementById('calendar-status');
+    const cards = document.querySelectorAll('.calendar-card');
+
+    // Era names matter for era-based calendars such as Japanese (Reiwa, Heisei, ...).
+    const FORMAT_OPTIONS = {
+      'islamic-umalqura': { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' },
+      hebrew: { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' },
+      japanese: { era: 'long', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' },
+    };
+
+    const supportedCalendars = (() => {
+      try {
+        return new Set(Intl.supportedValuesOf('calendar'));
+      } catch {
+        return new Set();
+      }
+    })();
+
+    // Locale for formatting: the visitor's language with the target calendar extension.
+    // Temporal requires the formatter's calendar to match the date's calendar.
+    function localeFor(calendarId) {
+      try {
+        return new Intl.Locale(navigator.language || 'en', { calendar: calendarId }).toString();
+      } catch {
+        return `en-u-ca-${calendarId}`;
+      }
+    }
+
+    function setField(card, name, value) {
+      const el = card.querySelector(`[data-field="${name}"]`);
+      el.textContent = value;
+      if (name === 'timeline') el.dataset.timeline = value;
+    }
+
+    function resetCard(card, note) {
+      card.querySelector('.formatted').textContent = '\u2014';
+      for (const el of card.querySelectorAll('[data-field]')) {
+        el.textContent = '\u2014';
+        delete el.dataset.timeline;
+      }
+      card.querySelector('tbody').replaceChildren();
+      card.querySelector('.note').textContent = note;
+    }
+
+    function renderCard(card, isoDate, todayISO) {
+      const calendarId = card.dataset.calendar;
+
+      if (!supportedCalendars.has(calendarId)) {
+        resetCard(card, `The ${calendarId} calendar isn't supported by this browser.`);
+        return;
+      }
+
+      const date = isoDate.withCalendar(calendarId);
+      if (date.calendar.id !== calendarId) {
+        resetCard(card, `The ${calendarId} calendar isn't supported by this browser.`);
+        return;
+      }
+
+      card.querySelector('.formatted').textContent =
+        date.toLocaleString(localeFor(calendarId), FORMAT_OPTIONS[calendarId]);
+
+      setField(card, 'year', String(date.year));
+      setField(card, 'month', String(date.month));
+      setField(card, 'monthCode', date.monthCode);
+      setField(card, 'monthsInYear', String(date.monthsInYear));
+
+      const comparison = Temporal.PlainDate.compare(date, todayISO.withCalendar(calendarId));
+      setField(card, 'timeline', comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today');
+
+      // Never assume 12 months or fixed month lengths; ask the calendar.
+      const rows = [];
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = date.with({ month: m, day: 1 });
+        const row = document.createElement('tr');
+        if (monthStart.monthCode === date.monthCode) row.setAttribute('aria-current', 'date');
+        for (const value of [m, monthStart.monthCode, monthStart.daysInMonth]) {
+          const cell = document.createElement('td');
+          cell.textContent = String(value);
+          row.append(cell);
+        }
+        rows.push(row);
+      }
+      card.querySelector('tbody').replaceChildren(...rows);
+
+      const notes = [];
+      if (date.inLeapYear) {
+        notes.push(date.monthsInYear > 12
+          ? `Leap year: ${date.monthsInYear} months, with an added leap month.`
+          : `Leap year: ${date.daysInYear} days.`);
+      }
+      if (calendarId === 'islamic-umalqura') {
+        notes.push('Calculated dates; local moon sightings may differ by a day.');
+      }
+      card.querySelector('.note').textContent = notes.join(' ');
+    }
+
+    function render() {
+      if (!input.value) {
+        status.textContent = 'Choose a date to see it in other calendars.';
+        cards.forEach((card) => resetCard(card, ''));
+        return;
+      }
+
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value, { overflow: 'reject' });
+      } catch {
+        status.textContent = 'Please enter a valid date.';
+        cards.forEach((card) => resetCard(card, ''));
+        return;
+      }
+
+      status.textContent = '';
+      const todayISO = Temporal.Now.plainDateISO();
+      for (const card of cards) {
+        try {
+          renderCard(card, isoDate, todayISO);
+        } catch {
+          resetCard(card, 'This date is outside the range this calendar can display.');
+        }
+      }
+    }
+
+    if (typeof globalThis.Temporal === 'undefined') {
+      input.disabled = true;
+      status.textContent = 'Calendar conversion is unavailable right now. Please try again later.';
+    } else {
+      input.value = Temporal.Now.plainDateISO().toString();
+      input.addEventListener('input', render);
+      render();
+    }
+  </script>
