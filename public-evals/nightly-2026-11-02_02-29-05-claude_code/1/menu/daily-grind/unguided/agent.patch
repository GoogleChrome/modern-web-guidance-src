+       */
+      const ITEM = '[role^="menuitem"]';
+      const HOVER_DELAY = 150;
+      const instances = new Set();
+      let uid = 0;
+
+      class MenuButton {
+        constructor(host, items, options = {}) {
+          this.host = host;
+          this.trigger = host.querySelector('.menu-trigger');
+          this.options = options;
+          this.state = options.state || {};
+          this.data = new WeakMap();
+          this.hoverTimer = 0;
+          this.typeahead = { buffer: '', timer: 0 };
+
+          const label = this.trigger.getAttribute('aria-label') || this.trigger.textContent.trim();
+          this.root = this.buildMenu(items, label);
+          host.append(this.root);
+
+          this.trigger.setAttribute('aria-haspopup', 'menu');
+          this.trigger.setAttribute('aria-expanded', 'false');
+          this.trigger.setAttribute('aria-controls', this.root.id);
+
+          this.sync();
+          this.bind();
+          instances.add(this);
+        }
+
+        get isOpen() {
