+            { label: 'Iced Latte', href: '/menu/iced-latte' },
+            {
+              label: 'Frozen Blends', items: [
+                { label: 'Mocha Frappé', href: '/menu/mocha-frappe' },
+                { label: 'Caramel Frappé', href: '/menu/caramel-frappe' },
+              ]
+            },
+          ]
+        },
+        {
+          label: 'Tea', items: [
+            {
+              label: 'Lattes', items: [
+                { label: 'Chai Latte', href: '/menu/chai-latte' },
+                { label: 'Matcha Latte', href: '/menu/matcha-latte' },
+                { label: 'London Fog', href: '/menu/london-fog' },
+              ]
+            },
+            {
+              label: 'Brewed', items: [
+                { label: 'Earl Grey', href: '/menu/earl-grey' },
+                { label: 'Jasmine Green', href: '/menu/jasmine-green' },
+                { label: 'Peppermint Herbal', href: '/menu/peppermint' },
+              ]
+            },
+          ]
+        },
+        {
+          label: 'Seasonal', hint: 'New', items: [
+            { label: 'Maple Oat Latte', href: '/menu/seasonal' },
+            { label: 'Pumpkin Spice Latte', href: '/menu/pumpkin-spice' },
+            { label: 'Apple Crisp Cold Brew', href: '/menu/apple-crisp' },
+          ]
+        },
+        { label: 'Bakery', href: '/menu/bakery' },
+        { type: 'separator' },
+        { label: 'View Full Menu', href: '/menu' },
+      ]);
+
+      new MenuButton(document.getElementById('account-menu'), [
+        { label: 'Profile', href: '/account' },
+        { label: 'Order History', href: '/account/orders' },
+        {
+          label: 'Rewards', hint: '240 ★', items: [
+            { label: 'Redeem a Reward', href: '/rewards/redeem' },
+            { label: 'Rewards Activity', href: '/rewards/activity' },
+            { label: 'How It Works', href: '/rewards' },
+          ]
+        },
+        {
+          label: 'Preferences', items: [
+            {
+              type: 'group', label: 'Notifications', items: [
+                { type: 'checkbox', name: 'emailOffers', label: 'Email offers' },
+                { type: 'checkbox', name: 'orderAlerts', label: 'Order-ready alerts' },
+              ]
+            },
+            { type: 'separator' },
+            {
+              label: 'Home Store', hint: (s) => STORES[s.store], items: Object.entries(STORES).map(
+                ([value, label]) => ({ type: 'radio', name: 'store', value, label })
+              )
+            },
+          ]
+        },
+        { type: 'separator' },
+        { label: 'Logout', href: '/logout', danger: true },
+      ], {
+        align: 'end',
+        state: { emailOffers: true, orderAlerts: true, store: 'downtown' },
+        onChange: (item, state) => {
+          if (item.name === 'store') notify(`Home store set to ${STORES[state.store]}.`);
+        },
+      });
+
+      /* ---------- Seasonal favorites ---------- */
+
+      const CUP_SIZES = [
+        { value: 'small', label: 'Small · 12 oz', short: 'Small', delta: 0 },
+        { value: 'medium', label: 'Medium · 16 oz', short: 'Medium', delta: 0.5 },
+        { value: 'large', label: 'Large · 20 oz', short: 'Large', delta: 1 },
+      ];
+      const MILKS = [
+        { value: 'whole', label: 'Whole', kind: 'dairy' },
+        { value: 'two-percent', label: '2%', kind: 'dairy' },
+        { value: 'skim', label: 'Skim', kind: 'dairy' },
+        { value: 'breve', label: 'Half & Half', kind: 'dairy' },
+        { value: 'oat', label: 'Oat', kind: 'plant', delta: 0.7 },
+        { value: 'almond', label: 'Almond', kind: 'plant', delta: 0.7 },
+        { value: 'soy', label: 'Soy', kind: 'plant', delta: 0.7 },
+        { value: 'coconut', label: 'Coconut', kind: 'plant', delta: 0.7 },
+        { value: 'none', label: 'No milk' },
+      ];
+      const TEMPS = [
+        { value: 'hot', label: 'Hot' },
+        { value: 'extra-hot', label: 'Extra hot' },
+        { value: 'iced', label: 'Iced' },
+      ];
+      const SYRUPS = [
+        { value: 'maple', label: 'Maple' },
+        { value: 'vanilla', label: 'Vanilla' },
+        { value: 'caramel', label: 'Caramel' },
+        { value: 'hazelnut', label: 'Hazelnut' },
+        { value: 'brown-sugar', label: 'Brown Sugar' },
+      ];
+      const SYRUP_PRICE = 0.6;
+      const SWEETNESS = [
+        { value: 'unsweetened', label: 'Unsweetened' },
+        { value: 'light', label: 'Light' },
+        { value: 'regular', label: 'Regular' },
+        { value: 'extra', label: 'Extra sweet' },
+      ];
+      const EXTRAS = [
+        { value: 'shot', label: 'Extra espresso shot', delta: 0.9 },
+        { value: 'cold-foam', label: 'Sweet cream cold foam', delta: 1.25 },
+        { value: 'whip', label: 'Whipped cream', delta: 0.5 },
+        { value: 'cinnamon', label: 'Cinnamon dusting', delta: 0 },
+      ];
+
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte', base: 4.75, details: '/menu/seasonal',
+          sizes: CUP_SIZES, temps: TEMPS,
+          defaults: { size: 'medium', milk: 'oat', temp: 'hot', syrups: ['maple'], sweetness: 'regular', extras: [], favorite: false },
+          included: { milk: 'oat', syrups: ['maple'] },
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso', base: 2.95, details: '/menu/espresso',
+          sizeLabel: 'Shots',
+          sizes: [
+            { value: 'single', label: 'Single', short: 'Single', delta: 0 },
+            { value: 'double', label: 'Double', short: 'Double', delta: 1 },
+            { value: 'triple', label: 'Triple', short: 'Triple', delta: 1.75 },
+          ],
+          defaults: { size: 'double', milk: 'none', syrups: [], sweetness: 'unsweetened', extras: [], favorite: false },
+        },
+        'cold-brew': {
+          name: 'Cold Brew', base: 4.25, details: '/menu/cold-brew',
+          sizes: CUP_SIZES,
+          defaults: { size: 'medium', milk: 'none', syrups: [], sweetness: 'unsweetened', extras: [], favorite: false },
+        },
+      };
+
+      const money = (n) => `$${n.toFixed(2)}`;
+      const surcharge = (n) => (n ? `+${money(n)}` : '');
+      const find = (list, value) => list.find((o) => o.value === value);
+      const cloneState = (state) => JSON.parse(JSON.stringify(state));
+
+      function price(drink, state) {
+        const included = drink.included || {};
+        const milk = state.milk === included.milk ? 0 : find(MILKS, state.milk).delta || 0;
+        const syrups = state.syrups.filter((s) => !(included.syrups || []).includes(s)).length * SYRUP_PRICE;
+        const extras = state.extras.reduce((sum, v) => sum + find(EXTRAS, v).delta, 0);
+        return drink.base + find(drink.sizes, state.size).delta + milk + syrups + extras;
+      }
+
+      function summary(drink, state) {
+        const parts = [find(drink.sizes, state.size).short];
+        if (drink.temps) parts.push(find(drink.temps, state.temp).label);
+        if (state.milk !== 'none') parts.push(`${find(MILKS, state.milk).label} milk`);
+        if (state.syrups.length) parts.push(state.syrups.map((v) => find(SYRUPS, v).label).join(' + '));
+        if (state.sweetness !== drink.defaults.sweetness) parts.push(find(SWEETNESS, state.sweetness).label);
+        parts.push(...state.extras.map((v) => find(EXTRAS, v).label));
+        return parts.join(' · ');
+      }
+
+      function customizeItems(drink) {
+        const radio = (name, extra = () => ({})) => (o) => ({ type: 'radio', name, value: o.value, label: o.label, ...extra(o) });
+        const milkRadio = radio('milk');
+        const items = [
+          {
+            type: 'group', label: drink.sizeLabel || 'Size',
+            items: drink.sizes.map(radio('size', (o) => ({ hint: surcharge(o.delta) }))),
+          },
+          { type: 'separator' },
+          {
+            label: 'Milk', hint: (s) => find(MILKS, s.milk).label, items: [
+              { label: 'Dairy', items: MILKS.filter((m) => m.kind === 'dairy').map(milkRadio) },
+              { label: 'Plant-based', hint: surcharge(0.7), items: MILKS.filter((m) => m.kind === 'plant').map(milkRadio) },
+              { type: 'separator' },
+              milkRadio(find(MILKS, 'none')),
+            ]
+          },
+        ];
+        if (drink.temps) {
+          items.push({ label: 'Temperature', hint: (s) => find(TEMPS, s.temp).label, items: drink.temps.map(radio('temp')) });
+        }
+        items.push(
+          {
+            label: 'Sweetener', hint: (s) => find(SWEETNESS, s.sweetness).label, items: [
+              {
+                label: 'Syrups', hint: (s) => (s.syrups.length ? `${s.syrups.length} added` : 'None'),
+                items: SYRUPS.map((o) => ({ type: 'checkbox', name: 'syrups', value: o.value, label: o.label, hint: surcharge(SYRUP_PRICE) })),
+              },
+              { type: 'separator' },
+              { type: 'group', label: 'Sweetness', items: SWEETNESS.map(radio('sweetness')) },
+            ]
+          },
+          {
+            label: 'Extras', hint: (s) => (s.extras.length ? `${s.extras.length} added` : ''),
+            items: EXTRAS.map((o) => ({ type: 'checkbox', name: 'extras', value: o.value, label: o.label, hint: surcharge(o.delta) || 'Free' })),
+          },
+          { type: 'separator' },
+          { label: 'Add to Order', action: 'add', hint: (s) => money(price(drink, s)) },
+          { type: 'checkbox', name: 'favorite', label: 'Save as Favorite' },
+          { label: 'View Details', href: drink.details },
+          { label: 'Reset to Default', action: 'reset' },
+        );
+        return items;
+      }
+
+      document.querySelectorAll('.card[data-drink]').forEach((card) => {
+        const drink = DRINKS[card.dataset.drink];
+        const state = cloneState(drink.defaults);
+
+        const render = () => {
+          card.querySelector('[data-price]').textContent = money(price(drink, state));
+          card.querySelector('[data-summary]').textContent = summary(drink, state);
+        };
+
+        const add = () => {
+          addToOrder({ drink: drink.name, options: cloneState(state), price: price(drink, state) });
+          notify(`Added ${drink.name} (${summary(drink, state)}) to your order — ${money(price(drink, state))}.`);
+        };
+
+        const menu = new MenuButton(card.querySelector('.menu'), customizeItems(drink), {
+          state,
+          onChange: (item) => {
+            render();
+            if (item.name === 'favorite') {
+              notify(state.favorite ? `${drink.name} saved to your favorites.` : `${drink.name} removed from your favorites.`);
+            }
+          },
+          onSelect: (item) => {
+            if (item.action === 'add') add();
+            if (item.action === 'reset') {
+              Object.assign(state, cloneState(drink.defaults), { favorite: state.favorite });
+              menu.sync();
+              render();
+              notify(`${drink.name} reset to the default recipe.`);
+            }
+          },
+        });
+
+        card.querySelector('[data-add]').addEventListener('click', add);
+        render();
+      });
+    })();
+  </script>
