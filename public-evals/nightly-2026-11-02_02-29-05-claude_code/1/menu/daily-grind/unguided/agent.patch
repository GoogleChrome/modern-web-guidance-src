+              break;
+            case 'End':
+            case 'PageDown':
+              items[items.length - 1].focus();
+              break;
+            case 'ArrowRight':
+              if (submenu) this.openSubmenu(el, true);
+              break;
+            case 'ArrowLeft':
+            case 'Escape':
+              if (menu !== this.root) {
+                this.hide(menu);
+                this.parentItemOf(menu).focus();
+              } else if (e.key === 'Escape') {
+                this.close(true);
+              }
+              break;
+            case 'Enter':
+            case ' ':
+              if (submenu) this.openSubmenu(el, true);
+              else el.click();
+              break;
+            case 'Tab':
+              this.close();
+              return;
+            default:
+              if (e.key.length !== 1 || e.ctrlKey || e.metaKey || e.altKey) return;
+              this.focusByTypeahead(items, index, e.key);
+          }
+          e.preventDefault();
+          e.stopPropagation();
+        }
+
+        focusByTypeahead(items, index, char) {
+          clearTimeout(this.typeahead.timer);
+          this.typeahead.timer = setTimeout(() => { this.typeahead.buffer = ''; }, 500);
+          const buffer = (this.typeahead.buffer += char.toLowerCase());
+          // A fresh search starts after the current item; a continued one includes it.
+          const start = buffer.length > 1 ? index : index + 1;
+          const ordered = [...items.slice(start), ...items.slice(0, start)];
+          const match = ordered.find((el) => this.data.get(el).label.toLowerCase().startsWith(buffer));
+          if (match) match.focus();
+        }
+
+        onClick(e) {
+          const el = e.target.closest(ITEM);
+          if (!el) return;
+          const item = this.data.get(el);
+
+          if (item.items) {
+            this.openSubmenu(el, true);
+            return;
+          }
+
+          if (item.type === 'radio' || item.type === 'checkbox') {
+            const current = this.state[item.name];
+            if (item.type === 'radio') {
+              this.state[item.name] = item.value;
+            } else if (Array.isArray(current)) {
+              this.state[item.name] = current.includes(item.value)
+                ? current.filter((v) => v !== item.value)
+                : [...current, item.value];
+            } else {
+              this.state[item.name] = !current;
+            }
+            this.sync();
+            this.options.onChange?.(item, this.state);
+            return;
+          }
+
+          // Links navigate on their own; actions return focus to the trigger.
+          this.close(!item.href);
+          this.options.onSelect?.(item, this.state);
+        }
+
+        onHover(e) {
+          const el = e.target.closest(ITEM);
+          if (!el) return;
+          el.focus({ preventScroll: true });
+          clearTimeout(this.hoverTimer);
+          this.hoverTimer = setTimeout(() => {
+            if (this.submenuOf(el)) this.openSubmenu(el, false);
+            else this.closeSubmenusIn(this.menuOf(el));
+          }, HOVER_DELAY);
+        }
+      }
+
+      window.addEventListener('resize', () => instances.forEach((menu) => menu.close()));
+
+      /* ---------- Toast & order ---------- */
+
+      const toast = document.getElementById('toast');
+      let toastTimer = 0;
+      function notify(message) {
+        toast.textContent = message;
+        toast.classList.add('toast--visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toast.classList.remove('toast--visible'), 3500);
+      }
+
+      const order = [];
+      function addToOrder(entry) {
+        order.push(entry);
+        const count = order.length;
+        document.getElementById('order-count').textContent = count;
+        document.getElementById('order-link').setAttribute('aria-label', `Your order, ${count} item${count === 1 ? '' : 's'}`);
+      }
+
+      /* ---------- Navigation menus ---------- */
+
+      const STORES = { downtown: 'Downtown', riverside: 'Riverside', uptown: 'Uptown' };
+
+      new MenuButton(document.getElementById('drinks-menu'), [
+        {
+          label: 'Espresso Bar', items: [
+            {
+              label: 'Classics', items: [
+                { label: 'Espresso', href: '/menu/espresso' },
