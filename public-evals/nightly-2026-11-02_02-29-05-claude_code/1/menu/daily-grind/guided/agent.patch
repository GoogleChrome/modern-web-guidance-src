+    }
+
+    // Runs after an item is activated, before its menu closes.
+    function onSelect(item) {
+      const slot = item.closest('[data-order-menu]');
+      if (!slot) return;
+      const drink = slot.dataset.drink;
+      if (item.dataset.action === 'add-to-order') {
+        announce(`Added ${drink} (${describeOrder(slot)}) to your order.`);
+      } else if (item.dataset.action === 'favorite') {
+        const saved = item.getAttribute('aria-checked') === 'true';
+        announce(saved ? `Saved ${drink} to your favorites.` : `Removed ${drink} from your favorites.`);
+      } else {
+        updateSelection(slot);
+      }
+    }
+
+    // Menu system
+    const ITEM = '[focusgroup~="menu"] :is(button, a[href])';
+    const canHover = matchMedia('(hover: hover)');
+    const hasAnchorPositioning = CSS.supports('position-area: block-end');
+    const hasInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+    const triggers = [...document.querySelectorAll('[commandfor]')];
+    const menus = triggers.map(menuFor);
+    const enterOnOpen = new Map(); // menu -> 'first' | 'last', for keyboard opens only
+    let pointerTrigger = null;
+    let hoveredItem = null;
+    let hoverTimer;
+
+    function menuFor(trigger) { return document.getElementById(trigger.getAttribute('commandfor')); }
+    function triggerFor(menu) { return document.querySelector(`[commandfor="${menu.id}"]`); }
+    function groupOf(menu) { return menu.querySelector(':scope > [focusgroup]'); }
+    function isSubmenu(menu) { return Boolean(menu.parentElement.closest('[popover]')); }
+    function isOpen(menu) {
+      try { return menu.matches(':popover-open'); } catch { return menu.classList.contains(':popover-open'); }
+    }
+    function rootMenu(el) {
+      let menu = el.closest('[popover]');
+      while (menu && isSubmenu(menu)) menu = menu.parentElement.closest('[popover]');
+      return menu;
+    }
+    function ownItems(group) {
+      return [...group.querySelectorAll('button, a[href]')]
+        .filter(item => item.closest('[focusgroup]') === group)
+        .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+    }
+    function focusEdge(menu, edge) {
+      const items = ownItems(groupOf(menu));
+      (edge === 'last' ? items.at(-1) : items[0])?.focus();
+    }
+    function closeAndRestore(menu, { fromPointer = false } = {}) {
+      triggerFor(menu).focus({ focusVisible: !fromPointer });
+      menu.hidePopover();
+    }
+    // Opening by keyboard always goes through the trigger's click, so the invoker is the only open path.
+    function openWithKeyboard(trigger, edge) {
+      const menu = menuFor(trigger);
+      if (isOpen(menu)) return focusEdge(menu, edge);
+      enterOnOpen.set(menu, edge);
+      trigger.click();
+    }
+
+    // Fallback positioning when CSS anchor positioning is unavailable.
+    function placeMenu(menu) {
+      const t = triggerFor(menu).getBoundingClientRect();
+      const m = menu.getBoundingClientRect();
+      const vw = document.documentElement.clientWidth;
+      const vh = window.innerHeight;
+      let left, top;
+      if (isSubmenu(menu)) {
+        left = t.right;
+        top = t.top;
+        if (left + m.width > vw) left = t.left - m.width;
+        if (left < 0) { left = t.left + 16; top = t.bottom; }
+      } else {
+        left = t.left;
+        top = t.bottom + 4;
+        if (top + m.height > vh && t.top - m.height - 4 >= 0) top = t.top - m.height - 4;
+      }
+      menu.style.left = `${Math.max(0, Math.min(left, vw - m.width))}px`;
+      menu.style.top = `${Math.max(0, Math.min(top, vh - m.height))}px`;
+    }
+    if (!hasAnchorPositioning) {
+      addEventListener('scroll', () => menus.filter(isOpen).forEach(placeMenu), { passive: true });
+      addEventListener('resize', () => menus.filter(isOpen).forEach(placeMenu));
+    }
+
+    // focusgroup is not natively supported yet: install Up, Down, Home, End and the menu roles.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll('button:not([role]), a[href]:not([role])').forEach(item => {
+          item.setAttribute('role', 'menuitem');
+        });
+        // One tab stop for the whole menu system: Tab leaves instead of stepping through items.
+        ownItems(group).forEach(item => { item.tabIndex = -1; });
+        group.addEventListener('keydown', event => {
+          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+          const items = ownItems(group);
+          const current = items.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          items[next].focus({ preventScroll: true });
+        }, true);
+      });
+    }
+
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+
+      trigger.addEventListener('pointerdown', event => {
+        // Keep focus where it is mid-click; the toggle handler focuses the trigger without a ring.
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('click', event => {
+        const fromKeyboard = event.detail === 0;
+        if (fromKeyboard && !isOpen(menu) && !enterOnOpen.has(menu)) enterOnOpen.set(menu, 'first');
+        if (!fromKeyboard) pointerTrigger = trigger;
+        if (hasInvokers) return;
+        event.preventDefault();
+        if (isOpen(menu)) closeAndRestore(menu, { fromPointer: !fromKeyboard });
+        else menu.showPopover({ source: trigger });
+      });
+
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', open);
+        hoveredItem = null;
+        const edge = enterOnOpen.get(menu);
+        enterOnOpen.delete(menu);
+        if (!open) return;
+        if (!hasAnchorPositioning) placeMenu(menu);
+        if (edge) focusEdge(menu, edge);
+        else if (pointerTrigger === trigger) trigger.focus({ focusVisible: false });
+      });
+
+      if (isSubmenu(menu)) {
+        trigger.addEventListener('pointerleave', event => startBridge(menu, event));
+      }
+    });
+
+    document.addEventListener('keydown', event => {
+      const target = event.target;
+      if (!(target instanceof Element)) return;
+      pointerTrigger = null;
+
+      // Top-level trigger: arrows and Home/End enter its menu. Enter and Space toggle natively.
+      if (target.matches('.menu-root > [commandfor]')) {
+        const edge = { ArrowDown: 'first', Home: 'first', ArrowUp: 'last', End: 'last' }[event.key];
+        if (!edge) return;
+        event.preventDefault();
+        openWithKeyboard(target, edge);
+        return;
+      }
+
+      if (!target.matches(ITEM)) return;
+      const menu = target.closest('[popover]');
+
+      if (event.key === 'ArrowRight' && target.hasAttribute('commandfor')) {
+        event.preventDefault();
+        openWithKeyboard(target, 'first');
+      } else if (event.key === 'Escape' || (event.key === 'ArrowLeft' && isSubmenu(menu))) {
+        // Close one level at a time; preventDefault stops the native close request closing the parent too.
+        event.preventDefault();
+        event.stopPropagation();
+        closeAndRestore(menu);
+      } else if (event.key === ' ' && target.getAttribute('role') === 'menuitemcheckbox') {
+        // Space toggles a checkbox and keeps the menu open; Enter toggles and closes via click.
+        event.preventDefault();
+        toggleChecked(target);
+        onSelect(target);
+      } else if (event.key === 'Tab') {
+        // Let focus move on, then close the whole hierarchy.
+        const root = rootMenu(target);
+        setTimeout(() => { if (isOpen(root)) root.hidePopover(); });
+      }
+    });
+
+    // Some browsers activate buttons on Space keyup.
+    document.addEventListener('keyup', event => {
+      if (event.key === ' ' && event.target.matches?.('[role="menuitemcheckbox"]')) event.preventDefault();
+    });
+
+    function toggleChecked(item) {
+      item.setAttribute('aria-checked', item.getAttribute('aria-checked') !== 'true');
+    }
+
+    // Activation: commands, checkable items and links (links navigate natively).
+    document.addEventListener('click', event => {
+      const item = event.target.closest?.(ITEM);
+      if (!item || item.hasAttribute('commandfor')) return;
+      const role = item.getAttribute('role');
+      if (role === 'menuitemcheckbox') toggleChecked(item);
+      if (role === 'menuitemradio') {
+        item.closest('[role="group"]').querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+          radio.setAttribute('aria-checked', radio === item);
+        });
+      }
+      onSelect(item);
+      const root = rootMenu(item);
+      const close = () => { if (isOpen(root)) closeAndRestore(root, { fromPointer: event.detail !== 0 }); };
+      // Leave checkable items visible briefly so the changed check mark registers.
+      if (role === 'menuitemcheckbox' || role === 'menuitemradio') setTimeout(close, 300);
+      else close();
+    });
+
+    // Hover follows focus, and hovering a submenu trigger previews its submenu after a short delay.
+    document.addEventListener('pointermove', event => {
+      if (event.pointerType === 'touch') return;
+      const item = event.target.closest?.(ITEM);
+      if (!item) return;
+      if (document.activeElement !== item) item.focus({ focusVisible: false, preventScroll: true });
+      if (hoveredItem === item) return;
+      hoveredItem = item;
+      clearTimeout(hoverTimer);
+      const menu = item.closest('[popover]');
+      const submenu = item.hasAttribute('commandfor') ? menuFor(item) : null;
+      hoverTimer = setTimeout(() => {
+        if (submenu) {
+          // Opening an auto popover closes its open siblings.
+          if (!isOpen(submenu)) submenu.showPopover({ source: item });
+        } else {
+          groupOf(menu).querySelectorAll(':scope > [popover]').forEach(sibling => {
+            if (isOpen(sibling)) sibling.hidePopover();
+          });
+        }
+      }, 150);
+    });
+
+    // Safe triangle from the pointer to the open submenu's near edge.
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      if (event.clientX >= rect.left && event.clientX <= rect.right) return; // --below: no side edge.
+      const style = submenu.style;
+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop(); // Reached an item.
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // Close every menu when focus lands outside its menu system.
+    document.addEventListener('focusin', event => {
+      document.querySelectorAll('.menu-root > [popover]').forEach(menu => {
+        if (isOpen(menu) && !menu.parentElement.contains(event.target)) menu.hidePopover();
+      });
+    });
+  </script>
+
 </body>
 
