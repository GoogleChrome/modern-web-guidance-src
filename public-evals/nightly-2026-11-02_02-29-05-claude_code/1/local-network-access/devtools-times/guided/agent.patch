diff --git a/src/utils/localNetwork.ts b/src/utils/localNetwork.ts
new file mode 100644
index 0000000..f1f2164
--- /dev/null
+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,62 @@
+// Helpers for Local Network Access (LNA): reaching devices on the user's LAN
+// (`local` address space) or companion services on their machine (`loopback`)
+// from this publicly served site.
+
+export type TargetAddressSpace = 'local' | 'loopback';
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type LnaPermissionState = PermissionState;
+
+declare global {
+  interface RequestInit {
+    targetAddressSpace?: TargetAddressSpace;
+  }
+}
+
+const LOOPBACK_HOST = /^(localhost|.+\.localhost|127(\.\d{1,3}){3}|\[::1\])$/i;
+
+export function permissionNameFor(space: TargetAddressSpace): LnaPermissionName {
+  return space === 'loopback' ? 'loopback-network' : 'local-network';
+}
+
+// Infer the address space from the URL host. Anything that isn't loopback is
+// treated as `local` (RFC 1918 ranges, link-local, ULA, `.local` mDNS names).
+export function addressSpaceFor(url: string | URL): TargetAddressSpace {
+  const { hostname } = new URL(url);
+  return LOOPBACK_HOST.test(hostname) ? 'loopback' : 'local';
+}
+
+// Never query the legacy 'local-network-access' name: it crashes the renderer
+// in older Chrome versions and try/catch can't prevent that.
+export async function queryLnaPermission(
+  name: LnaPermissionName,
+  onChange?: (state: LnaPermissionState) => void,
+): Promise<LnaPermissionState> {
+  if (!navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: name as PermissionName });
+    if (onChange) {
+      status.addEventListener('change', () => onChange(status.state));
+    }
+    return status.state;
+  } catch {
+    // Browser doesn't know this permission; let a user-initiated request proceed.
+    return 'prompt';
+  }
+}
+
+// Fetch from a local or loopback endpoint. Declaring `targetAddressSpace`
+// exempts http:// URLs from mixed-content blocking (once permission is granted)
+// and makes the browser abort if the host resolves to an unexpected space.
+// Call this from a user gesture unless permission is already 'granted'.
+export async function fetchLocalResource(
+  url: string | URL,
+  init: RequestInit = {},
+): Promise<Response> {
+  return fetch(url, {
+    mode: 'cors',
+    ...init,
+    targetAddressSpace: init.targetAddressSpace ?? addressSpaceFor(url),
+  });
+}
