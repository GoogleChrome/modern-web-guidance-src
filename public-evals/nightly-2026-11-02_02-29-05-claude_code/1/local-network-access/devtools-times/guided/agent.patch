diff --git a/src/components/LocalDeviceConnect.tsx b/src/components/LocalDeviceConnect.tsx
new file mode 100644
index 0000000..f0a8a33
--- /dev/null
+++ b/src/components/LocalDeviceConnect.tsx
@@ -0,0 +1,152 @@
+import React, { useEffect, useId, useState } from 'react';
+import {
+  addressSpaceFor,
+  fetchLocalResource,
+  permissionNameFor,
+  queryLnaPermission,
+  type LnaPermissionState,
+} from '../utils/localNetwork';
+
+const DEFAULT_URL = 'http://127.0.0.1:45678/status';
+const STORAGE_KEY = 'localDeviceUrl';
+
+export default function LocalDeviceConnect() {
+  const inputId = useId();
+  const [url, setUrl] = useState(() => localStorage.getItem(STORAGE_KEY) ?? DEFAULT_URL);
+  const [permission, setPermission] = useState<LnaPermissionState | null>(null);
+  const [result, setResult] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  let space: ReturnType<typeof addressSpaceFor> | null = null;
+  try {
+    space = addressSpaceFor(url);
+  } catch {
+    // Invalid URL while typing
+  }
+  const permissionName = space ? permissionNameFor(space) : null;
+
+  useEffect(() => {
+    if (!permissionName) return;
+    let active = true;
+    queryLnaPermission(permissionName, (state) => active && setPermission(state)).then(
+      (state) => active && setPermission(state),
+    );
+    return () => {
+      active = false;
+    };
+  }, [permissionName]);
+
+  const connect = async () => {
+    setError(null);
+    setResult(null);
+    setLoading(true);
+    try {
+      localStorage.setItem(STORAGE_KEY, url);
+      const response = await fetchLocalResource(url);
+      const text = await response.text();
+      if (!response.ok) {
+        setError(`Device responded with HTTP ${response.status}`);
+      } else {
+        setResult(text);
+      }
+    } catch {
+      setError(
+        'Could not reach the device. Make sure it is powered on, on the same network, ' +
+          'allows requests from this site (CORS), and that local network access is allowed for this site.',
+      );
+    } finally {
+      setLoading(false);
+      if (permissionName) {
+        queryLnaPermission(permissionName).then(setPermission);
+      }
+    }
+  };
+
+  // Connect automatically once access has been granted; otherwise wait for a click
+  // so the browser's permission prompt follows a user gesture.
+  useEffect(() => {
+    if (permission === 'granted' && result === null && error === null && !loading) {
+      connect();
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [permission]);
+
+  const isSecure = window.isSecureContext;
+  const label = space === 'loopback' ? 'Loopback network' : 'Local network';
+
+  return (
+    <div className="max-w-xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 className="text-2xl font-bold mb-2 text-gray-800">Connect a Local Device</h2>
+      <p className="text-sm text-gray-600 mb-6">
+        Link a device on your home network (such as a smart display) or the DevTools Times desktop companion
+        running on this computer. Your browser will ask for permission before this site can reach it.
+      </p>
+
+      {!isSecure && (
+        <div className="mb-4 p-3 text-sm text-yellow-800 bg-yellow-100 rounded-lg" role="alert">
+          Local network access requires a secure (https://) connection to this site.
+        </div>
+      )}
+
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          connect();
+        }}
+        className="space-y-4"
+      >
+        <div>
+          <label htmlFor={inputId} className="block text-sm font-medium text-gray-700 mb-1">
+            Device address
+          </label>
+          <input
+            type="url"
+            id={inputId}
+            value={url}
+            onChange={(e) => setUrl(e.target.value)}
+            required
+            placeholder="http://192.168.1.100:8080/status"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+
+        {permission && (
+          <p className="text-sm text-gray-700">
+            {label} access: <span className="font-semibold">{permission}</span>
+          </p>
+        )}
+
+        {permission === 'denied' && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {label} access is blocked for this site. To re-enable it, open site settings from the icon next to the
+            address bar and set <strong>{label}</strong> to <strong>Allow</strong>, then try again.
+          </div>
+        )}
+
+        <button
+          type="submit"
+          disabled={loading || !space}
+          className={`w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            loading || !space ? 'opacity-75 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Connecting...' : 'Connect'}
+        </button>
+      </form>
+
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {result !== null && (
+        <div className="mt-4" role="status">
+          <p className="mb-1 text-sm text-green-700 font-medium">Connected.</p>
+          <pre className="p-3 text-xs bg-gray-100 rounded-lg overflow-x-auto">{result}</pre>
+        </div>
+      )}
+    </div>
+  );
+}
