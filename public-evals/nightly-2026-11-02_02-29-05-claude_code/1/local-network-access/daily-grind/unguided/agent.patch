+        host = stripBrackets(host.toLowerCase());
+        if (host === 'localhost' || /\.localhost$/.test(host) || host === '::1') return true;
+        var ip = parseIPv4(host);
+        return !!ip && ip[0] === 127;
+      }
+
+      function isPrivateNetworkHost(host) {
+        host = stripBrackets(host.toLowerCase());
+        if (/^[a-z0-9-]+(\.[a-z0-9-]+)*\.local$/.test(host)) return true; // mDNS
+        var ip = parseIPv4(host);
+        if (ip) {
+          return ip[0] === 10 ||
+            (ip[0] === 172 && ip[1] >= 16 && ip[1] <= 31) ||
+            (ip[0] === 192 && ip[1] === 168) ||
