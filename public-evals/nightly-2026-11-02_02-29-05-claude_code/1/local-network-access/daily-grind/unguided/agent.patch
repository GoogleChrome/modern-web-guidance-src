+          this.setConnection('error', 'Unexpected reply');
+          this.setFeedback('error', 'Something answered at ' + where + ', but it doesn’t look like a ' + this.config.label + '.', [
+            'Double-check the address and port.'
+          ]);
+        } else {
+          this.setConnection('error', 'Can’t connect');
+          this.setFeedback('error', 'Couldn’t reach the ' + this.config.label + ' at ' + where + '.', [
+            'If your browser asked for permission, choose "Allow".',
+            this.config.addressSpace === 'loopback'
+              ? 'Make sure Brew Companion is running and up to date.'
+              : 'Make sure the brewer is on and on the same Wi-Fi network.',
+            'Verify the address and port are correct.'
+          ]);
+        }
+      };
+
+      DevicePanel.prototype.disconnect = function () {
+        if (this.controller) {
+          this.controller.userCancelled = true;
+          this.controller.abort();
+        }
+        this.connected = false;
+        this.el.disconnect.hidden = true;
+        this.el.info.hidden = true;
+        this.setConnection('idle', 'Not connected');
+        this.setFeedback('', 'Disconnected from the ' + this.config.label + '.');
+      };
+
+      // ---- Init ------------------------------------------------------------
+
+      var notice = document.getElementById('equipment-support-notice');
+      if (!window.isSecureContext) {
+        notice.textContent = 'Equipment connections are only available when this site is loaded over HTTPS.';
+        notice.hidden = false;
+      } else if (!('fetch' in window) || !('AbortController' in window)) {
+        notice.textContent = 'Your browser is too old to connect to equipment. Please update to the latest version.';
+        notice.hidden = false;
+      }
+
+      var saved = loadSettings();
+      document.querySelectorAll('.device[data-device]').forEach(function (root) {
+        var key = root.getAttribute('data-device');
+        if (DEVICES[key]) new DevicePanel(root, DEVICES[key], saved[key]);
+      });
+    })();
+  </script>
