+  <script type="module">
+    const REQUEST_TIMEOUT_MS = 8000;
+
+    const STATE_LABELS = {
+      granted: 'Allowed',
+      prompt: 'Will ask',
+      denied: 'Blocked',
+      unsupported: 'Not required',
+    };
+
+    if (!window.isSecureContext) {
+      document.getElementById('context-warning').hidden = false;
+    }
+
+    function setPermissionUI(card, state) {
+      const badge = card.querySelector('[data-permission-status]');
+      badge.dataset.state = state;
+      badge.textContent = STATE_LABELS[state] ?? state;
+      badge.title = state === 'unsupported'
+        ? 'This browser does not use local network permissions'
+        : `Permission: ${state}`;
+      card.querySelector('[data-remediation]').hidden = state !== 'denied';
+    }
+
+    function showResult(card, kind, message, details) {
+      const box = card.querySelector('.connection-result');
+      box.dataset.kind = kind;
+      box.replaceChildren(document.createTextNode(message));
+      if (details !== undefined) {
+        const pre = document.createElement('pre');
+        pre.textContent = typeof details === 'string' ? details : JSON.stringify(details, null, 2);
+        box.append(pre);
+      }
+    }
+
+    /**
+     * Queries the granular Local Network Access permission. Never queries the legacy
+     * 'local-network-access' name, which crashes the renderer in older Chrome versions.
+     * Returns the PermissionStatus, or null when the browser doesn't recognize the name.
+     */
+    async function queryPermission(name) {
+      if (!navigator.permissions?.query) return null;
+      try {
+        return await navigator.permissions.query({ name });
+      } catch {
+        return null;
+      }
+    }
+
+    function describeError(error, card) {
+      const isLocal = card.dataset.addressSpace === 'local';
+      if (error.name === 'TimeoutError') {
+        return isLocal
+          ? 'The brewer did not respond in time. Check that it is powered on and connected to the same Wi-Fi network as this device.'
+          : 'The brewing utility did not respond in time. Check that it is running on this computer.';
+      }
+      if (card.querySelector('[data-permission-status]').dataset.state === 'denied') {
+        return 'Connection blocked: permission was denied. Follow the steps below to allow access.';
+      }
+      return isLocal
+        ? 'Could not reach the brewer. Check the address, make sure the brewer is on the same network, and allow local network access if your browser asks.'
+        : 'Could not reach the brewing utility. Check that it is running on the address above, and allow loopback access if your browser asks.';
+    }
+
+    async function connect(card) {
+      const form = card.querySelector('form');
+      const input = form.elements.url;
+      const button = form.querySelector('button');
+
+      let url;
+      try {
+        url = new URL(input.value.trim());
+        if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new TypeError();
+        input.setCustomValidity('');
+      } catch {
+        input.setCustomValidity('Enter a full http:// or https:// address.');
+        input.reportValidity();
+        showResult(card, 'error', 'Enter a full address starting with http:// or https://.');
+        return;
+      }
+
+      button.disabled = true;
+      button.textContent = 'Connecting…';
+      showResult(card, 'info', `Connecting to ${url.host}…`);
+
+      try {
+        const response = await fetch(new Request(url, {
+          method: 'GET',
+          mode: 'cors',
+          credentials: 'omit',
+          cache: 'no-store',
+          // Exempts http:// targets from mixed-content blocking and makes the browser
+          // verify the resolved IP actually belongs to the declared address space.
+          targetAddressSpace: card.dataset.addressSpace,
+          signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+        }));
+        if (!response.ok) {
+          throw Object.assign(new Error(`HTTP ${response.status}`), { httpStatus: response.status });
+        }
+        const type = response.headers.get('content-type') ?? '';
+        const body = type.includes('json') ? await response.json() : (await response.text()).slice(0, 2000);
+        const name = card.dataset.addressSpace === 'local' ? 'brewer' : 'brewing utility';
+        showResult(card, 'success', `Connected to the ${name} at ${url.host}.`, body || undefined);
+      } catch (error) {
+        const message = error.httpStatus
+          ? `The device answered but returned an error (HTTP ${error.httpStatus}). Check the address path.`
+          : describeError(error, card);
+        showResult(card, 'error', message);
+      } finally {
+        button.disabled = false;
+        button.textContent = 'Connect';
+      }
+    }
+
+    for (const card of document.querySelectorAll('.equipment-card')) {
+      const form = card.querySelector('form');
+      const input = form.elements.url;
+      input.addEventListener('input', () => input.setCustomValidity(''));
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        connect(card);
+      });
+
+      queryPermission(card.dataset.permission).then((status) => {
+        if (!status) {
+          setPermissionUI(card, 'unsupported');
+          return;
+        }
+        setPermissionUI(card, status.state);
+        // Stay in sync if the user changes the permission from site settings or the prompt.
+        status.addEventListener('change', () => setPermissionUI(card, status.state));
+        // Only connect automatically when access was already granted; otherwise wait for a click.
+        if (status.state === 'granted') connect(card);
+      });
+    }
+  </script>
+
 </body>
 
