+    /* Decorative text lines
+       Native text-decoration keeps ink skipping around descenders (p, y, J…).
+       Reveals animate color, offset and thickness everywhere; browsers that
+       support text-decoration-inset also get lines that grow from the center
+       and stop short of the word's ends. */
+    .deco {
+      --deco-color: var(--accent);
+      --deco-offset: 0.3em;
+      --deco-thickness: 2px;
+      --deco-inset: 0.15em;
+      text-decoration-line: underline;
+      text-decoration-style: solid;
+      text-decoration-color: transparent;
+      text-decoration-thickness: var(--deco-thickness);
+      text-underline-offset: calc(var(--deco-offset) + 0.25em);
+      text-decoration-skip-ink: auto;
+      transition:
+        text-decoration-color 0.35s ease,
+        text-underline-offset 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
+        text-decoration-thickness 0.35s ease,
+        text-decoration-inset 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
+        color 0.3s;
+    }
+
+    @supports (text-decoration-inset: 1px) {
+      .deco {
+        text-decoration-inset: 2.5em;
+      }
+    }
+
+    .deco:hover,
+    .deco:focus-visible {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: var(--deco-offset);
+    }
+
+    @supports (text-decoration-inset: 1px) {
+      .deco:hover,
+      .deco:focus-visible {
+        text-decoration-inset: var(--deco-inset);
+      }
+    }
+
+    /* Nav: underline drops into place on hover */
+    nav .deco {
+      --deco-offset: 6px;
+      --deco-inset: 0.1em 0.35em;
+    }
+
+    /* Logout: strikethrough wipes across on hover */
+    nav .deco.logout-link {
+      --deco-inset: 0.2em;
+      text-decoration-line: line-through;
+      text-decoration-thickness: 1px;
+    }
+
+    nav .deco.logout-link:hover,
+    nav .deco.logout-link:focus-visible {
+      text-decoration-thickness: 2px;
+    }
+
+    /* Footer: dotted underline that tightens up on hover */
+    .footer-links .deco {
+      --deco-color: var(--primary);
+      --deco-offset: 4px;
+      --deco-inset: 0 0.25em;
+      text-decoration-line: underline;
+      text-decoration-style: dotted;
+      text-decoration-color: rgba(62, 39, 35, 0.35);
+      text-underline-offset: var(--deco-offset);
+    }
+
+    .footer-links .deco:hover,
+    .footer-links .deco:focus-visible {
+      text-decoration-style: solid;
+      text-decoration-thickness: 2px;
+    }
+
+    /* Section heading: double rule above and below, revealed on load */
+    .section-title {
+      text-align: center;
+      margin-bottom: 0.5rem;
+    }
+
+    .section-title .deco {
+      --deco-offset: 0.2em;
+      --deco-thickness: 3px;
+      --deco-inset: 0.4em;
+      text-decoration-line: underline overline;
+      text-decoration-style: double;
+      animation: deco-reveal 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s both;
+    }
+
+    /* Card titles: wavy underline revealed as each card scrolls into view */
+    .card h3 .deco {
+      --deco-offset: 0.2em;
+      --deco-thickness: 1.5px;
+      --deco-inset: 0.3em 0.6em;
+      text-decoration-style: wavy;
+      animation: deco-reveal 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+    }
+
+    .card:nth-child(2) h3 .deco { animation-delay: 0.15s; }
+    .card:nth-child(3) h3 .deco { animation-delay: 0.3s; }
+
+    @supports (animation-timeline: view()) {
+      .card h3 .deco {
+        animation-delay: 0s;
+        animation-timeline: view();
+        animation-range: entry 10% cover 35%;
+      }
+    }
+
+    .card:hover h3 .deco {
+      --deco-thickness: 2.5px;
+      text-decoration-thickness: var(--deco-thickness);
+    }
+
+    @keyframes deco-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-underline-offset: calc(var(--deco-offset) + 0.5em);
+        text-decoration-inset: 3em;
+      }
+      to {
+        text-decoration-color: var(--deco-color);
+        text-underline-offset: var(--deco-offset);
+        text-decoration-inset: var(--deco-inset);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .deco {
+        transition: none;
+        animation: none !important;
+      }
+
+      .section-title .deco,
+      .card h3 .deco {
+        text-decoration-color: var(--deco-color);
+        text-underline-offset: var(--deco-offset);
+      }
+
+      @supports (text-decoration-inset: 1px) {
+        .section-title .deco,
+        .card h3 .deco {
+          text-decoration-inset: var(--deco-inset);
+        }
+      }
+    }
   </style>
 </head>
 
