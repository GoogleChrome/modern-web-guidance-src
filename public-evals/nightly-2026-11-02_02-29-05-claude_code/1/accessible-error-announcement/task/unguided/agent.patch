+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var success = document.getElementById('newsletter-success');
+      var ERROR_ID = 'newsletter-email-error';
+      // Errors only appear after the user has interacted (blurred the field or submitted).
+      var touched = false;
+
+      function getErrorMessage() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Visual message, aria-invalid, aria-describedby and the live region all change together,
+      // so assistive tech announces exactly what is shown and nothing more.
+      function showError(message, forceAnnounce) {
+        if (error.textContent === message && !forceAnnounce) return;
+        input.setAttribute('aria-invalid', 'true');
+        input.setAttribute('aria-describedby', ERROR_ID);
+        if (forceAnnounce && error.textContent === message) {
+          // Re-announce an unchanged message on repeated submits.
+          error.textContent = '';
+          requestAnimationFrame(function () { error.textContent = message; });
+        } else {
+          error.textContent = message;
+        }
+      }
+
+      function clearError() {
+        input.setAttribute('aria-invalid', 'false');
+        input.removeAttribute('aria-describedby');
+        error.textContent = '';
+      }
+
+      function validate(forceAnnounce) {
+        var message = getErrorMessage();
+        if (message) {
+          showError(message, forceAnnounce);
+        } else {
+          clearError();
+        }
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        // Don't flag an untouched, empty field just because focus passed through it.
+        if (!touched && input.value.trim() === '') return;
+        touched = true;
+        validate(false);
+      });
+
+      input.addEventListener('input', function () {
+        success.textContent = '';
+        if (!touched) return;
+        // Clear immediately once valid; keep the error (updated if needed) while invalid.
+        validate(false);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        if (!validate(true)) {
+          input.focus();
+          return;
+        }
+        success.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        touched = false;
+        clearError();
+      });
+    })();
+  </script>
+
