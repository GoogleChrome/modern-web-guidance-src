+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const status = form.querySelector('.newsletter-status');
+      const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+
+      // Fallback interaction tracking for browsers without :user-invalid.
+      let hasInteracted = false;
+      let hasBlurred = false;
+      let submitAttempted = false;
+
+      const isUserInvalid = () => {
+        if (supportsUserInvalid) return email.matches(':user-invalid');
+        const flagged = submitAttempted || (hasInteracted && hasBlurred);
+        const invalid = flagged && !email.checkValidity();
+        email.classList.toggle('user-invalid-fallback', invalid);
+        return invalid;
+      };
+
+      const errorText = () =>
+        email.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like name@example.com.';
+
+      // Keep aria-invalid and the live error text in lockstep with the visual
+      // :user-invalid state, so screen readers only hear the error when it is
+      // shown and stop hearing it as soon as the email becomes valid.
+      const sync = () => {
+        if (isUserInvalid()) {
+          email.setAttribute('aria-invalid', 'true');
+          const text = errorText();
+          if (error.textContent !== text) error.textContent = text;
+        } else {
+          email.removeAttribute('aria-invalid');
+          error.textContent = '';
+        }
+      };
+
+      email.addEventListener('input', () => {
+        hasInteracted = true;
+        status.textContent = '';
+        sync();
+      });
+      email.addEventListener('blur', () => {
+        hasBlurred = true;
+        sync();
+      });
+      email.addEventListener('invalid', (event) => {
+        // Replace the native validation bubble with our inline message.
+        event.preventDefault();
+        submitAttempted = true;
+        // :user-invalid is set during the submit attempt; read it once it settles.
+        requestAnimationFrame(sync);
+        email.focus();
+      });
+      form.addEventListener('reset', () => {
+        hasInteracted = hasBlurred = submitAttempted = false;
+        email.classList.remove('user-invalid-fallback');
+        email.removeAttribute('aria-invalid');
+        error.textContent = '';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        form.reset();
+        status.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+      });
+    })();
+  </script>
+
