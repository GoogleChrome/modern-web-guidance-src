+    /* Swipe-to-reveal drink cards */
+    .card.SwipeReveal {
+      display: grid;
+      grid-template-columns: 100% max-content;
+      padding: 0;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .card.SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      padding: 20px;
+      background: white;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel button {
+      border: 0;
+      padding: 0 16px;
+      min-width: 76px;
+      font: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: white;
+      background: var(--primary);
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel button:nth-child(2) {
+      background: #6d4c41;
+    }
+
+    .SwipeReveal-panel button:last-child {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .SwipeReveal-panel button:hover {
+      filter: brightness(1.1);
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline: 2px solid var(--text);
+      outline-offset: -4px;
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
