+  <script>
+    (function () {
+      var DRAG_THRESHOLD = 10;
+      var cards = Array.prototype.slice.call(document.querySelectorAll('.swipe-card'));
+
+      function actionsWidth(card) {
+        return card.querySelector('.swipe-actions').offsetWidth;
+      }
+
+      function setOpen(card, open) {
+        var content = card.querySelector('.swipe-content');
+        var actions = card.querySelector('.swipe-actions');
+        var toggle = card.querySelector('.actions-toggle');
+        card.classList.toggle('open', open);
+        content.style.transform = open ? 'translateX(' + -actionsWidth(card) + 'px)' : '';
+        actions.inert = !open;
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.setAttribute('aria-label', (open ? 'Hide' : 'Show') + ' actions for ' + card.dataset.drink);
+      }
+
+      function closeOthers(except) {
+        cards.forEach(function (c) {
+          if (c !== except && c.classList.contains('open')) setOpen(c, false);
+        });
+      }
+
+      cards.forEach(function (card) {
+        var content = card.querySelector('.swipe-content');
+        var startX = 0, startY = 0, baseX = 0, currentX = 0;
+        var tracking = false, dragging = false, suppressClick = false;
+
+        content.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          tracking = true;
+          dragging = false;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseX = card.classList.contains('open') ? -actionsWidth(card) : 0;
+          currentX = baseX;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (!tracking) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+          if (!dragging) {
+            if (Math.abs(dy) > DRAG_THRESHOLD && Math.abs(dy) > Math.abs(dx)) {
+              tracking = false; // vertical scroll, let the browser handle it
+              return;
+            }
+            if (Math.abs(dx) < DRAG_THRESHOLD) return;
+            dragging = true;
+            card.classList.add('dragging');
+            content.setPointerCapture(e.pointerId);
+            closeOthers(card);
+          }
+          var max = actionsWidth(card);
+          currentX = Math.max(-max, Math.min(0, baseX + dx));
+          content.style.transform = 'translateX(' + currentX + 'px)';
+        });
+
+        function endDrag() {
+          if (!tracking) return;
+          tracking = false;
+          if (!dragging) return;
+          dragging = false;
+          card.classList.remove('dragging');
+          // A swipe only reveals or hides the buttons; it never triggers one.
+          setOpen(card, currentX < -actionsWidth(card) / 2);
+          suppressClick = true;
+          setTimeout(function () { suppressClick = false; }, 0);
+        }
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+
+        // Swallow the click that follows a swipe so links like "View Details" don't fire.
+        content.addEventListener('click', function (e) {
+          if (suppressClick) {
+            e.preventDefault();
+            e.stopPropagation();
+            suppressClick = false;
+            return;
+          }
+          if (card.classList.contains('open') && !e.target.closest('.actions-toggle')) {
+            e.preventDefault();
+            setOpen(card, false);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        card.querySelector('.actions-toggle').addEventListener('click', function () {
+          var open = !card.classList.contains('open');
+          closeOthers(card);
+          setOpen(card, open);
+          if (open) card.querySelector('.swipe-action').focus();
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.classList.contains('open')) {
+            setOpen(card, false);
+            card.querySelector('.actions-toggle').focus();
+          }
+        });
+
+        var fav = card.querySelector('.swipe-action.favorite');
+        fav.addEventListener('click', function () {
+          var saved = fav.getAttribute('aria-pressed') !== 'true';
+          fav.setAttribute('aria-pressed', String(saved));
+          fav.setAttribute('aria-label', (saved ? 'Remove ' : 'Save ') + card.dataset.drink + (saved ? ' from' : ' to') + ' favorites');
+          fav.querySelector('.icon').innerHTML = saved ? '&#9829;' : '&#9825;';
+          fav.querySelector('.label').textContent = saved ? 'Saved' : 'Save';
+        });
+
+        var share = card.querySelector('.swipe-action.share');
+        share.addEventListener('click', function () {
+          var url = new URL(share.dataset.url, location.href).href;
+          if (navigator.share) {
+            navigator.share({ title: card.dataset.drink, url: url }).catch(function () {});
+          } else if (navigator.clipboard) {
+            navigator.clipboard.writeText(url).then(function () {
+              share.lastChild.textContent = 'Copied';
+              setTimeout(function () { share.lastChild.textContent = 'Share'; }, 1500);
+            });
+          }
+        });
+      });
+
+      // Tapping outside an open card closes it.
+      document.addEventListener('pointerdown', function (e) {
+        var card = e.target.closest('.swipe-card');
+        closeOthers(card);
+      });
+
+      window.addEventListener('resize', function () {
+        cards.forEach(function (c) { if (c.classList.contains('open')) setOpen(c, true); });
+      });
+    })();
+  </script>
+
 </body>
 
