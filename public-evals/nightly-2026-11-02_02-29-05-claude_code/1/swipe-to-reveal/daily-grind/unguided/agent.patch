+    /* Swipeable drink cards */
+    .swipe-card {
+      position: relative;
+      padding: 0;
+      overflow: hidden;
+    }
+
+    .swipe-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      padding: 20px;
+      background: white;
+      touch-action: pan-y;
+      user-select: none;
+      transition: transform 0.25s ease;
+    }
+
+    .swipe-card.dragging .swipe-content {
+      transition: none;
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .swipe-actions {
+      position: absolute;
+      top: 0;
+      right: 0;
+      bottom: 0;
+      display: flex;
+      width: var(--actions-width, 216px);
+    }
+
+    .swipe-action {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      gap: 4px;
+      border: none;
+      color: white;
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .swipe-action .icon {
+      font-size: 1.3rem;
+      line-height: 1;
+    }
+
+    .swipe-action.order {
+      background: var(--primary);
+    }
+
+    .swipe-action.favorite {
+      background: #c62828;
+    }
+
+    .swipe-action.share {
+      background: #8d6e63;
+    }
+
+    .swipe-action:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .actions-toggle {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      width: 32px;
+      height: 32px;
+      border: none;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.2rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .actions-toggle:hover,
+    .actions-toggle:focus-visible {
+      background: var(--secondary);
+    }
