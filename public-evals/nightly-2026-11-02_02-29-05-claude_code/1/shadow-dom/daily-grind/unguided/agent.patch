+// <drink-card> — reusable menu card with an isolated (Shadow DOM) layout.
+//
+// Usage:
+//   <drink-card heading="Cold Brew" href="/menu/cold-brew" action="View Details" limited>
+//     Steeped for 18 hours for maximum smoothness.
+//   </drink-card>
+//
+// Attributes:
+//   heading  – card title
+//   href     – destination for the action link
+//   action   – action link label (defaults to "View Details")
+//   limited  – boolean; when present a "Limited" badge is shown. It can be
+//              added/removed at any time (e.g. card.limited = true).
+// The element's text content is used as the description.
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      all: initial;
+      display: block;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    .card {
+      position: relative;
+      box-sizing: border-box;
+      height: 100%;
+      background: #fff;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      right: 12px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      font-size: 1.17em;
+      color: #4e342e;
+    }
+
+    p {
+      margin: 0;
+    }
+
+    a {
+      display: inline-block;
+      background: #4e342e;
+      color: #fff;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    a:hover {
+      background: #3e2723;
+    }
+  </style>
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden>Limited</span>
+    <h3 part="heading"></h3>
+    <p part="description"><slot></slot></p>
+    <a part="action"></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['heading', 'href', 'action', 'limited'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this._badge = root.querySelector('.badge');
+    this._heading = root.querySelector('h3');
+    this._link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  get limited() {
+    return this.hasAttribute('limited');
+  }
+
+  set limited(value) {
+    this.toggleAttribute('limited', Boolean(value));
+  }
+
+  _render() {
+    this._heading.textContent = this.getAttribute('heading') ?? '';
+    this._link.textContent = this.getAttribute('action') || 'View Details';
+
+    const href = this.getAttribute('href');
+    if (href) {
+      this._link.setAttribute('href', href);
+      this._link.hidden = false;
+    } else {
+      this._link.removeAttribute('href');
+      this._link.hidden = true;
+    }
+
+    this._badge.hidden = !this.limited;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
