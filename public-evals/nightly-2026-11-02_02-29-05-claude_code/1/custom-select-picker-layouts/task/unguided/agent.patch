+    /* Roast Picker */
+    .order-form {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      margin-top: 20px;
+    }
+
+    .order-form label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      margin-bottom: 6px;
+    }
+
+    .roast-select {
+      min-width: 240px;
+      padding: 10px 14px;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      background: white;
+      color: var(--text);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .order-form button.btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select::picker-icon {
+        margin-left: auto;
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent img {
+        width: 28px;
+        height: 28px;
+        border-radius: 50%;
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      /* Options menu: 3-column grid instead of a vertical list */
+      .roast-select::picker(select) {
+        display: grid;
+        grid-template-columns: repeat(3, 160px);
+        gap: 12px;
+        padding: 12px;
+        margin-top: 8px;
+        border: none;
+        border-radius: 10px;
+        background: white;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
+        position-area: bottom;
+      }
+
+      .roast-select option {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 6px;
+        padding: 8px;
+        border: 2px solid transparent;
+        border-radius: 8px;
+        text-align: center;
+        cursor: pointer;
+        transition: border-color 0.2s, background 0.2s;
+      }
+
+      .roast-select option::checkmark {
+        display: none;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        border-color: var(--accent);
+      }
+
+      .roast-select option img {
+        width: 100%;
+        height: 100px;
+        border-radius: 6px;
+      }
+
+      .roast-select option .roast-name {
+        font-weight: bold;
+        color: var(--primary);
+      }
+
+      .roast-select option .roast-desc {
+        font-size: 0.75rem;
+        line-height: 1.3;
+      }
+    }
+
+    .roast-select img {
+      object-fit: cover;
+    }
+
