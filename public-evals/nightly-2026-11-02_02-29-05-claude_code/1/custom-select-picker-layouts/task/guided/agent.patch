+  <script>
+    // The roast options sit in a single row, so Left/Right map to previous/next option
+    // (native select only handles Up/Down).
+    document.getElementById('roast-picker').addEventListener('keydown', (event) => {
+      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+      const option = document.activeElement;
+      if (!(option instanceof HTMLOptionElement)) return;
+      const next = event.key === 'ArrowRight' ? option.nextElementSibling : option.previousElementSibling;
+      if (next instanceof HTMLOptionElement) {
+        event.preventDefault();
+        next.focus();
+      }
+    });
+  </script>
