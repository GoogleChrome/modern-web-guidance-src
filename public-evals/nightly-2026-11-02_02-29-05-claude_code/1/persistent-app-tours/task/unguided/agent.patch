     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title">
+    <h4 id="tour-step-title">Earn points with every sip</h4>
+    <p>Join Rewards to earn points on every order and redeem them for free drinks and treats.</p>
+    <button type="button" id="tour-step-close">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+      var closeBtn = document.getElementById('tour-step-close');
+      var supportsAnchor = window.CSS && CSS.supports('anchor-name: --a');
+      var supportsPopover = typeof step.showPopover === 'function';
+
+      function isOpen() {
+        return supportsPopover ? step.matches(':popover-open') : step.style.display !== 'none';
+      }
+
+      // Fallback positioning for browsers without CSS anchor positioning
+      function reposition() {
+        if (supportsAnchor || !isOpen()) return;
+        var r = link.getBoundingClientRect();
+        var w = step.offsetWidth;
+        var left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), window.innerWidth - w - 8);
+        step.style.top = (r.bottom) + 'px';
+        step.style.left = left + 'px';
+      }
+
+      function close() {
+        if (supportsPopover) step.hidePopover();
+        else step.style.display = 'none';
+        link.classList.remove('tour-active');
+      }
+
+      if (!supportsAnchor) {
+        step.style.position = 'fixed';
+        window.addEventListener('scroll', reposition, { passive: true });
+        window.addEventListener('resize', reposition);
+        if (window.ResizeObserver) new ResizeObserver(reposition).observe(link);
+      }
+
+      if (supportsPopover) {
+        step.showPopover();
+      } else {
+        step.style.zIndex = '1001';
+      }
+      reposition();
+
+      link.addEventListener('click', function (e) {
+        if (isOpen()) e.preventDefault();
+      });
+      closeBtn.addEventListener('click', close);
+    })();
+  </script>
+
 </body>
 
