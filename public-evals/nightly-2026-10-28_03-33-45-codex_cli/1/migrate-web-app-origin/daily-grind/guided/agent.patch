@@ -0,0 +1,112 @@
+const config = await fetch(new URL('./migration-config.json', import.meta.url)).then(response => {
+  if (!response.ok) throw new Error('Migration configuration unavailable');
+  return response.json();
+});
+const oldUrl = new URL(config.oldAppUrl);
+const newUrl = new URL(config.newAppUrl);
+const transferUrl = new URL('./transfer.html', newUrl);
+const status = document.querySelector('#migration-status');
+const isReceiver = location.pathname === transferUrl.pathname && config.role === 'new';
+const keys = config.settingsKeys;
+const MAX_BYTES = 100_000;
+
+function trusted(event, expectedWindow, expectedUrl) {
+  if (event.source !== expectedWindow || event.origin === 'null') return false;
+  try {
+    if ('Origin' in globalThis) return Origin.from(event).isSameOrigin(Origin.from(expectedUrl.href));
+    return new URL(event.origin).origin === expectedUrl.origin;
+  } catch { return false; }
+}
+
+if (isReceiver) {
+  const opener = window.opener;
+  const continueLink = document.querySelector('#continue');
+  continueLink.href = newUrl.href;
+  continueLink.hidden = false;
+  if (!opener) {
+    status.textContent = 'Open the previous app and choose “Move my settings” to transfer your configuration.';
+  } else {
+    const token = crypto.randomUUID();
+    let finished = false;
+    const timeout = setTimeout(() => {
+      finished = true;
+      status.textContent = 'Could not connect. Keep the previous app open and try again. No settings were removed.';
+    }, 30_000);
+    window.addEventListener('message', event => {
+      if (finished || !trusted(event, opener, oldUrl) || event.data?.type !== 'daily-grind:settings' || event.data.token !== token) return;
+      const values = event.data.values;
+      if (!values || typeof values !== 'object' || Array.isArray(values) || JSON.stringify(values).length > MAX_BYTES) return;
+      if (Object.entries(values).some(([key, value]) => !keys.includes(key) || typeof value !== 'string')) return;
+      finished = true;
+      clearTimeout(timeout);
+      const previous = new Map();
+      try {
+        for (const [key, value] of Object.entries(values)) {
+          previous.set(key, localStorage.getItem(key));
+          localStorage.setItem(key, value);
+        }
+        opener.postMessage({ type: 'daily-grind:complete', token }, oldUrl.origin);
+        status.textContent = 'Your settings have been copied. Continue to the app. If your browser offers an app update, accept it to move your installed shortcut. Other browsers may require reinstalling the app.';
+      } catch {
+        for (const [key, value] of previous) {
+          try { value === null ? localStorage.removeItem(key) : localStorage.setItem(key, value); } catch { /* Original settings remain on the old origin. */ }
+        }
+        status.textContent = 'Settings could not be saved. They remain available in your previous app. Allow site storage and try again.';
+      }
+    });
+    opener.postMessage({ type: 'daily-grind:ready', token }, oldUrl.origin);
+  }
+} else if (config.role === 'old' && location.origin === oldUrl.origin) {
+  const banner = document.createElement('aside');
+  banner.setAttribute('aria-label', 'App relocation');
+  banner.style.cssText = 'padding:1rem 5%;background:#fff3df;color:#3e2723';
+  const description = document.createElement('p');
+  description.textContent = 'The Daily Grind is moving. Copy your settings before accepting an installed-app update. If your browser does not offer an update, install the app at its new address.';
+  const button = document.createElement('button');
+  button.type = 'button';
+  button.textContent = 'Move my settings';
+  const link = document.createElement('a');
+  link.href = newUrl.href;
+  link.textContent = ' Visit the new app';
+  const feedback = document.createElement('p');
+  feedback.setAttribute('role', 'status');
+  banner.append(description, button, link, feedback);
+  document.body.prepend(banner);
+  button.addEventListener('click', () => {
+    button.disabled = true;
+    let popup;
+    let token;
+    function cleanup() {
+      window.removeEventListener('message', receive);
+      clearTimeout(timeout);
+      button.disabled = false;
+    }
+    function receive(event) {
+      if (!trusted(event, popup, newUrl)) return;
+      if (event.data?.type === 'daily-grind:ready' && typeof event.data.token === 'string' && event.data.token.length <= 100 && !token) {
+        token = event.data.token;
+        try {
+          const values = Object.fromEntries(keys.map(key => [key, localStorage.getItem(key)]).filter(([, value]) => value !== null));
+          if (JSON.stringify(values).length > MAX_BYTES) throw new Error('Settings too large');
+          popup.postMessage({ type: 'daily-grind:settings', token, values }, newUrl.origin);
+        } catch {
+          feedback.textContent = 'Could not read your settings. Allow site storage and try again. Your original settings are unchanged.';
+          cleanup();
+        }
+      } else if (event.data?.type === 'daily-grind:complete' && token && event.data.token === token) {
+        feedback.textContent = 'Settings copied. You can now accept the browser’s app update.';
+        cleanup();
+      }
+    }
+    window.addEventListener('message', receive);
+    const timeout = setTimeout(() => {
+      feedback.textContent = 'Transfer did not finish. Keep both windows open and try again. Your original settings are unchanged.';
+      cleanup();
+    }, 35_000);
+    popup = window.open(transferUrl.href, '_blank', 'popup');
+    if (!popup) {
+      feedback.textContent = 'Allow popups for this site, then choose “Move my settings” again.';
+      cleanup();
+    }
+  });
+}
