@@ -0,0 +1,48 @@
+import { readFile, writeFile, mkdir, copyFile } from 'node:fs/promises';
+import { getDomain } from 'tldts';
+
+const config = JSON.parse(await readFile(process.env.MIGRATION_CONFIG || 'migration.config.json', 'utf8'));
+function httpsUrl(value, label) {
+  if (!value) throw new Error(`Set ${label} in migration.config.json before building.`);
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash) {
+    throw new Error(`${label} must be an HTTPS URL without credentials, query, or fragment.`);
+  }
+  return url;
+}
+const oldUrl = httpsUrl(config.oldAppUrl, 'oldAppUrl');
+const newUrl = httpsUrl(config.newAppUrl, 'newAppUrl');
+const oldId = httpsUrl(config.oldAppId, 'oldAppId');
+const newId = httpsUrl(config.newAppId, 'newAppId');
+const domain = getDomain(oldUrl.hostname, { allowPrivateDomains: true });
+if (!domain || domain !== getDomain(newUrl.hostname, { allowPrivateDomains: true }) || oldUrl.origin === newUrl.origin) {
+  throw new Error('Migration requires distinct HTTPS origins sharing a registrable domain.');
+}
+if (oldId.origin !== oldUrl.origin || newId.origin !== newUrl.origin) throw new Error('App IDs must belong to their respective origins.');
+if (!Array.isArray(config.settingsKeys) || config.settingsKeys.some(key => typeof key !== 'string' || !key || key.length > 200) || new Set(config.settingsKeys).size !== config.settingsKeys.length) {
+  throw new Error('settingsKeys must be a list of unique localStorage configuration keys.');
+}
+const html = await readFile('index.html', 'utf8');
+for (const [role, appUrl, id] of [['old', oldUrl, oldId], ['new', newUrl, newId]]) {
+  const root = `dist/${role}`;
+  const appDir = `${root}${new URL('.', appUrl).pathname}`;
+  await mkdir(appDir, { recursive: true });
+  const manifest = {
+    name: 'The Daily Grind', short_name: 'Daily Grind', id: id.href,
+    start_url: appUrl.href, scope: new URL('.', appUrl).pathname,
+    display: 'standalone', theme_color: '#4e342e', background_color: '#fafafa',
+    icons: [{ src: './icon.svg', sizes: 'any', type: 'image/svg+xml', purpose: 'any' }],
+    ...(role === 'old' ? { migrate_to: { id: newId.href, install_url: newUrl.href } }
+      : { migrate_from: [{ id: oldId.href, install_url: oldUrl.href }] })
+  };
+  const pagePath = appUrl.pathname.endsWith('/') ? `${appUrl.pathname}index.html` : appUrl.pathname;
+  await writeFile(`${root}${pagePath}`, html.replace('</head>', '<link rel="manifest" href="./manifest.webmanifest">\n<script type="module" src="./migration.js"></script>\n</head>'));
+  await writeFile(`${appDir}manifest.webmanifest`, JSON.stringify(manifest, null, 2));
+  await writeFile(`${appDir}migration-config.json`, JSON.stringify({ ...config, role }));
+  for (const file of ['migration.js', 'transfer.html', 'icon.svg']) await copyFile(`migration/${file}`, `${appDir}${file}`);
+  if (role === 'old') {
+    await mkdir(`${root}/.well-known`, { recursive: true });
+    await writeFile(`${root}/.well-known/web-app-origin-association`, JSON.stringify({ [newId.href]: { allow_migration: true } }, null, 2));
+  }
+}
+console.log('Built dist/old and dist/new. Deploy each directory at its corresponding origin root.');
diff --git a/scripts/migration.test.mjs b/scripts/migration.test.mjs
new file mode 100644
index 0000000..2b18e3a
--- /dev/null
+++ b/scripts/migration.test.mjs
@@ -0,0 +1,80 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, cp, writeFile, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve, join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+import vm from 'node:vm';
+
+const root = resolve('.');
+const valid = { oldAppUrl: 'https://old.example.co.uk/shop/', newAppUrl: 'https://new.example.co.uk/coffee/', oldAppId: 'https://old.example.co.uk/shop/', newAppId: 'https://new.example.co.uk/coffee/', settingsKeys: ['theme'] };
+
+async function build(config, check) {
+  const dir = await mkdtemp(join(tmpdir(), 'daily-grind-migration-'));
+  try {
+    await cp('index.html', join(dir, 'index.html'));
+    await cp('migration', join(dir, 'migration'), { recursive: true });
+    await writeFile(join(dir, 'migration.config.json'), JSON.stringify(config));
+    const result = spawnSync(process.execPath, [join(root, 'scripts/build.mjs')], { cwd: dir, encoding: 'utf8' });
+    await check(result, dir);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+}
+
+test('builds reciprocal manifests and authorizes the complete destination ID', async () => {
+  await build(valid, async (result, dir) => {
+    assert.equal(result.status, 0, result.stderr);
+    const old = JSON.parse(await readFile(join(dir, 'dist/old/shop/manifest.webmanifest')));
+    const next = JSON.parse(await readFile(join(dir, 'dist/new/coffee/manifest.webmanifest')));
+    const association = JSON.parse(await readFile(join(dir, 'dist/old/.well-known/web-app-origin-association')));
+    assert.deepEqual(old.migrate_to, { id: valid.newAppId, install_url: valid.newAppUrl });
+    assert.deepEqual(next.migrate_from, [{ id: valid.oldAppId, install_url: valid.oldAppUrl }]);
+    assert.deepEqual(association, { [valid.newAppId]: { allow_migration: true } });
+    const page = await readFile(join(dir, 'dist/new/coffee/index.html'), 'utf8');
+    assert.match(page, /rel="manifest"/);
+    assert.match(page, /src="\.\/migration.js"/);
+  });
+});
+
+test('rejects unconfigured, cross-site, private-suffix and wrong-ID destinations', async () => {
+  for (const config of [
+    { ...valid, oldAppUrl: null },
+    { ...valid, newAppUrl: 'https://attacker.example.org/' },
+    { ...valid, oldAppUrl: 'https://alice.github.io/', newAppUrl: 'https://bob.github.io/' },
+    { ...valid, newAppId: 'https://other.example.co.uk/' },
+    { ...valid, newAppUrl: 'http://new.example.co.uk/' },
+  ]) await build(config, result => assert.notEqual(result.status, 0));
+});
+
+test('receiver rejects spoofed senders and keys, then copies settings and acknowledges', async () => {
+  const messages = [];
+  const opener = { postMessage: (data, origin) => messages.push({ data, origin }) };
+  const listeners = {};
+  const values = new Map([['theme', 'old'], ['token', 'secret']]);
+  const elements = { '#migration-status': {}, '#continue': {} };
+  const context = {
+    URL, crypto: { randomUUID: () => 'nonce' },
+    fetch: async () => ({ ok: true, json: async () => ({ ...valid, role: 'new' }) }),
+    document: { querySelector: selector => elements[selector] },
+    location: { pathname: '/coffee/transfer.html' },
+    window: { opener, addEventListener: (type, callback) => { listeners[type] = callback; } },
+    localStorage: { getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, value), removeItem: key => values.delete(key) },
+    setTimeout: () => 1, clearTimeout() {},
+  };
+  const source = (await readFile('migration/migration.js', 'utf8')).replaceAll('import.meta.url', JSON.stringify('https://new.example.co.uk/coffee/migration.js'));
+  await vm.runInNewContext(`(async () => { ${source} })()`, context);
+  const data = { type: 'daily-grind:settings', token: 'nonce', values: { theme: 'dark' } };
+  for (const [origin, sourceWindow, payload] of [
+    ['https://old.example.co.uk.attacker.org', opener, data],
+    ['null', opener, data],
+    ['https://old.example.co.uk', {}, data],
+    ['https://old.example.co.uk', opener, { ...data, token: 'wrong' }],
+    ['https://old.example.co.uk', opener, { ...data, values: { token: 'stolen' } }],
+  ]) listeners.message({ origin, source: sourceWindow, data: payload });
+  assert.equal(values.get('theme'), 'old');
+  assert.equal(messages.length, 1);
+  listeners.message({ origin: 'https://old.example.co.uk', source: opener, data });
+  assert.equal(values.get('theme'), 'dark');
+  assert.equal(values.get('token'), 'secret');
+  assert.equal(messages[1].data.type, 'daily-grind:complete');
+  assert.equal(messages[1].origin, 'https://old.example.co.uk');
+});
