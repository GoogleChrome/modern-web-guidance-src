+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.hash));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let observer;
+
+    function setCurrent(currentLink) {
+      links.forEach(link => {
+        if (link === currentLink) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function syncNativeCurrent() {
+      setCurrent(nav.querySelector('a:target-current'));
+    }
+
+    function updateNavigation() {
+      const navHeight = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navHeight}px`);
+      if (nativeTracking) {
+        syncNativeCurrent();
+        return;
+      }
+
+      observer?.disconnect();
+      observer = new IntersectionObserver(() => {
+        // Compare every section, since observer entries contain only changed targets.
+        let currentIndex = -1;
+        let largestVisibleArea = 0;
+        sections.forEach((section, index) => {
+          const bounds = section.getBoundingClientRect();
+          const visibleArea = Math.max(0,
+            Math.min(bounds.bottom, window.innerHeight * 0.6) -
+            Math.max(bounds.top, navHeight));
+          if (visibleArea > largestVisibleArea) {
+            largestVisibleArea = visibleArea;
+            currentIndex = index;
+          }
+        });
+        setCurrent(links[currentIndex]);
+      }, {
+        rootMargin: `-${navHeight}px 0px -40% 0px`,
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    if (nativeTracking) {
+      let framePending = false;
+      document.addEventListener('scroll', () => {
+        if (framePending) return;
+        framePending = true;
+        requestAnimationFrame(() => {
+          syncNativeCurrent();
+          framePending = false;
+        });
+      }, { passive: true });
+      document.addEventListener('scrollend', syncNativeCurrent);
+    }
+
+    new ResizeObserver(updateNavigation).observe(nav);
+    window.addEventListener('resize', updateNavigation);
+    updateNavigation();
+  </script>
+
