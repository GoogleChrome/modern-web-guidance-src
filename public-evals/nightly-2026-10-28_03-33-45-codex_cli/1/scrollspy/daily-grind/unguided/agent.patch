+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = sectionLinks.map(link => document.querySelector(link.hash));
+    let updatePending = false;
+
+    function updateActiveSection() {
+      updatePending = false;
+      const navBottom = navigation.getBoundingClientRect().bottom;
+      const viewportHeight = window.innerHeight;
+      const activationLine = navBottom + (viewportHeight - navBottom) * 0.25;
+      const visibleSections = sections.map(section => ({
+        section,
+        bounds: section.getBoundingClientRect()
+      })).filter(({ bounds }) => bounds.bottom > navBottom && bounds.top < viewportHeight);
+
+      // Prefer the section at the reading position, then the nearest visible one.
+      let active = visibleSections.find(({ bounds }) =>
+        bounds.top <= activationLine && bounds.bottom > activationLine
+      ) || visibleSections[0];
+
+      // A short final section may never reach the reading position.
+      if (window.scrollY + viewportHeight >= document.documentElement.scrollHeight - 2) {
+        active = visibleSections[visibleSections.length - 1];
+      }
+
+      sectionLinks.forEach((link, index) => {
+        if (sections[index] === active?.section) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function scheduleUpdate() {
+      if (!updatePending) {
+        updatePending = true;
+        window.requestAnimationFrame(updateActiveSection);
+      }
+    }
+
+    function updateNavigationHeight() {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      scheduleUpdate();
+    }
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', updateNavigationHeight);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('load', updateNavigationHeight);
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    updateNavigationHeight();
+    updateActiveSection();
+  </script>
+
