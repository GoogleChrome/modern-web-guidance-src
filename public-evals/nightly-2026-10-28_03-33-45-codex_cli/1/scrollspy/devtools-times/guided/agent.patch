diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..e5d0b58
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,136 @@
+---
+const sections = [
+    { id: 'headlines', label: 'Headlines' },
+    { id: 'top-news', label: 'Top News' },
+    { id: 'world', label: 'World' },
+    { id: 'politics', label: 'Politics' },
+];
+---
+
+<section-nav>
+    <nav aria-label="On this page">
+        <ul>
+            {sections.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
+        </ul>
+    </nav>
+</section-nav>
+
+<style>
+    section-nav {
+        display: block;
+        position: sticky;
+        top: 0;
+        z-index: 20;
+        background: white;
+        border-bottom: 1px solid #d1d5db;
+    }
+
+    nav {
+        scroll-target-group: auto;
+    }
+
+    ul {
+        display: flex;
+        justify-content: center;
+    }
+
+    a {
+        display: block;
+        padding: 0.75rem clamp(0.5rem, 3vw, 1.5rem);
+        border-bottom: 3px solid transparent;
+        color: #4b5563;
+        font-size: 0.875rem;
+        font-weight: 600;
+        white-space: nowrap;
+    }
+
+    a:hover { background: #f3f4f6; }
+
+    a:is(:target-current, .is-current) {
+        color: #111827;
+        border-bottom-color: currentColor;
+        background: #f3f4f6;
+    }
+</style>
+
+<script>
+    class SectionNav extends HTMLElement {
+        private cleanup?: () => void;
+
+        connectedCallback() {
+            // The custom element may connect before the following sections are parsed.
+            const initialize = () => {
+                const links = [...this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
+                const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+                const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+                    CSS.supports('selector(:target-current)');
+                const controller = new AbortController();
+                const { signal } = controller;
+                let observer: IntersectionObserver | undefined;
+                let frame = 0;
+                let scrollTimer: ReturnType<typeof setTimeout>;
+
+                const sync = () => {
+                    let active = 0;
+                    if (nativeTracking) {
+                        active = links.findIndex(link => link.matches(':target-current'));
+                    } else {
+                        const line = this.getBoundingClientRect().height + 16;
+                        targets.forEach((target, index) => {
+                            if (target && target.getBoundingClientRect().top <= line) active = index;
+                        });
+                        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+                            active = links.length - 1;
+                        }
+                    }
+                    links.forEach((link, index) => {
+                        const current = index === active;
+                        link.classList.toggle('is-current', !nativeTracking && current);
+                        if (current) link.setAttribute('aria-current', 'location');
+                        else link.removeAttribute('aria-current');
+                    });
+                };
+
+                const observe = () => {
+                    observer?.disconnect();
+                    if (!nativeTracking) {
+                        // Watch a thin band just below the sticky menu, including short sections.
+                        const top = Math.min(this.offsetHeight + 16, window.innerHeight - 1);
+                        observer = new IntersectionObserver(sync, {
+                            rootMargin: `-${top}px 0px -${Math.max(0, window.innerHeight - top - 1)}px 0px`,
+                        });
+                        targets.forEach(target => { if (target) observer!.observe(target); });
+                    }
+                    sync();
+                };
+
+                document.addEventListener('scrollend', sync, { signal });
+                // Also covers older browsers without scrollend and the document's bottom edge.
+                document.addEventListener('scroll', () => {
+                    clearTimeout(scrollTimer);
+                    scrollTimer = setTimeout(sync, 100);
+                }, { passive: true, signal });
+                window.addEventListener('resize', observe, { signal });
+                window.addEventListener('hashchange', sync, { signal });
+                document.addEventListener('astro:page-load', observe, { signal });
+                frame = requestAnimationFrame(observe);
+                this.cleanup = () => {
+                    controller.abort();
+                    observer?.disconnect();
+                    cancelAnimationFrame(frame);
+                    clearTimeout(scrollTimer);
+                };
+            };
+
+            if (document.readyState === 'loading') {
+                const controller = new AbortController();
+                document.addEventListener('DOMContentLoaded', initialize, { once: true, signal: controller.signal });
+                this.cleanup = () => controller.abort();
+            } else initialize();
+        }
+
+        disconnectedCallback() { this.cleanup?.(); }
+    }
+
+    if (!customElements.get('section-nav')) customElements.define('section-nav', SectionNav);
+</script>
