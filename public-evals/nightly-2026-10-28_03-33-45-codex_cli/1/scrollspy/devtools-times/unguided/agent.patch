diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..467ad98
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,86 @@
+---
+const sections = [
+  { id: 'top-stories', label: 'Top Stories' },
+  { id: 'top-news', label: 'Top News' },
+  { id: 'world', label: 'World' },
+  { id: 'politics', label: 'Politics' },
+];
+---
+
+<section-navigation class="sticky top-0 z-20 block border-b border-gray-200 bg-white shadow-sm">
+  <nav aria-label="Page sections" class="flex overflow-x-auto px-4 sm:px-6 gap-6 text-sm font-semibold">
+    {sections.map(({ id, label }, index) => (
+      <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}
+        class="section-link whitespace-nowrap border-b-2 border-transparent py-3 text-gray-600 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-amber-600">
+        {label}
+      </a>
+    ))}
+  </nav>
+</section-navigation>
+
+<style>
+  .section-link[aria-current='location'] {
+    border-bottom-color: var(--color-amber-500);
+    color: var(--color-gray-900);
+  }
+</style>
+
+<script>
+  class SectionNavigation extends HTMLElement {
+    connectedCallback() {
+      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+      const sections = links.flatMap(link => {
+        const section = document.getElementById(link.hash.slice(1));
+        return section ? [{ link, section }] : [];
+      });
+      let frame = 0;
+
+      const update = () => {
+        frame = 0;
+        // Track the section reaching the reading area just below the sticky menu.
+        const readingLine = Math.max(0, this.getBoundingClientRect().bottom) + 24;
+        let current = sections[0];
+        for (const entry of sections) {
+          if (entry.section.getBoundingClientRect().top <= readingLine) current = entry;
+        }
+        // The final section may be too short to reach the reading line.
+        const last = sections.at(-1);
+        if (last && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2
+          && last.section.getBoundingClientRect().top < window.innerHeight) current = last;
+
+        for (const { link } of sections) {
+          if (link === current?.link) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        }
+      };
+
+      const scheduleUpdate = () => {
+        if (!frame) frame = requestAnimationFrame(update);
+      };
+      const resizeObserver = new ResizeObserver(scheduleUpdate);
+      resizeObserver.observe(document.body);
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('hashchange', scheduleUpdate);
+      update();
+
+      this.cleanup = () => {
+        cancelAnimationFrame(frame);
+        resizeObserver.disconnect();
+        window.removeEventListener('scroll', scheduleUpdate);
+        window.removeEventListener('resize', scheduleUpdate);
+        window.removeEventListener('hashchange', scheduleUpdate);
+      };
+    }
+
+    private cleanup?: () => void;
+
+    disconnectedCallback() {
+      this.cleanup?.();
+    }
+  }
+
+  if (!customElements.get('section-navigation')) {
+    customElements.define('section-navigation', SectionNavigation);
+  }
+</script>
