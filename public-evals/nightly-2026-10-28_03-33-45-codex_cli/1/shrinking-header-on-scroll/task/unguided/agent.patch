+  <script>
+    (function () {
+      // Older browsers get the same continuous effect without CSS scroll timelines.
+      var nativeScrollAnimation = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll(root block)') &&
+        CSS.supports('animation-range', '0px 180px');
+      if (nativeScrollAnimation) return;
+
+      var nav = document.querySelector('nav');
+      var logo = document.querySelector('.logo');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var narrowScreen = window.matchMedia('(max-width: 640px)');
+      var pending = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function update() {
+        pending = false;
+        if (reducedMotion.matches) {
+          nav.style.height = '';
+          logo.style.fontSize = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 180, 1));
+        var expanded = narrowScreen.matches ? 7 : 4.4;
+        var compact = narrowScreen.matches ? 5.5 : 3;
+        nav.style.height = (expanded + (compact - expanded) * progress) + 'rem';
+        logo.style.fontSize = (1.5 - 0.25 * progress) + 'rem';
+      }
+
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          requestFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('resize', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      // addListener also works in browsers predating MediaQueryList.addEventListener.
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else if (reducedMotion.addListener) {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      update();
+    }());
+  </script>
