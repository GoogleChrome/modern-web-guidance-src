     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      // Partial timeline support also needs the fallback (notably range support).
+      var hasScrollAnimation = window.CSS && typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (hasScrollAnimation) return;
+
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var frame = null;
+
+      function updateNavigation() {
+        frame = null;
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = reducedMotion.matches ? 0 : Math.max(0, Math.min(1, scrollTop / 160));
+        navigation.style.setProperty('--nav-scroll-progress', progress);
+      }
+
+      function scheduleUpdate() {
+        if (frame === null) frame = window.requestAnimationFrame(updateNavigation);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      // Also handle a restored page that starts partway down the document.
+      updateNavigation();
+    }());
+  </script>
+
 </body>
 
