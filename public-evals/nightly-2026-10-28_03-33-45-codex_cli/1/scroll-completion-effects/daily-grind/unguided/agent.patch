+  <script>
+    (() => {
+      const nav = document.querySelector('nav');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let cancelNavigation = () => {};
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"]');
+        if (!link || event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+        let target;
+        try {
+          target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
+        } catch {
+          return;
+        }
+        if (!target) return;
+
+        event.preventDefault();
+        cancelNavigation();
+        document.querySelectorAll('.navigation-arrival').forEach((element) => {
+          element.classList.remove('navigation-arrival');
+        });
+
+        // Clamp the destination: sections near the footer cannot reach the top.
+        const destination = Math.max(0, Math.min(
+          window.scrollY + target.getBoundingClientRect().top - nav.offsetHeight - 16,
+          document.documentElement.scrollHeight - window.innerHeight
+        ));
+        let frame;
+        let settledFrames = 0;
+        let idleFrames = 0;
+        let previousY = window.scrollY;
+        const stopKeys = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ']);
+        const cancelOnKey = (event) => {
+          if (stopKeys.has(event.key)) cleanup();
+        };
+        const cleanup = () => {
+          cancelAnimationFrame(frame);
+          window.removeEventListener('wheel', cleanup);
+          window.removeEventListener('touchstart', cleanup);
+          window.removeEventListener('pointerdown', cleanup);
+          window.removeEventListener('keydown', cancelOnKey);
+          cancelNavigation = () => {};
+        };
+        cancelNavigation = cleanup;
+        window.addEventListener('wheel', cleanup, { passive: true });
+        window.addEventListener('touchstart', cleanup, { passive: true });
+        window.addEventListener('pointerdown', cleanup, { passive: true });
+        window.addEventListener('keydown', cancelOnKey);
+
+        const checkArrival = () => {
+          const currentY = window.scrollY;
+          const stationary = Math.abs(currentY - previousY) < 0.1;
+          const arrived = Math.abs(currentY - destination) <= 1;
+          settledFrames = arrived && stationary ? settledFrames + 1 : 0;
+          idleFrames = stationary ? idleFrames + 1 : 0;
+          previousY = currentY;
+
+          if (settledFrames >= 3) {
+            cleanup();
+            // preventScroll keeps focus from starting a second scroll.
+            target.focus({ preventScroll: true });
+            target.classList.add('navigation-arrival');
+            target.addEventListener('animationend', () => {
+              target.classList.remove('navigation-arrival');
+            }, { once: true });
+            if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+            return;
+          }
+          // An interrupted or unreachable scroll must never activate the target.
+          if (idleFrames >= 60) {
+            cleanup();
+            return;
+          }
+          frame = requestAnimationFrame(checkArrival);
+        };
+
+        window.scrollTo({
+          top: destination,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+        frame = requestAnimationFrame(checkArrival);
+      });
+    })();
+  </script>
