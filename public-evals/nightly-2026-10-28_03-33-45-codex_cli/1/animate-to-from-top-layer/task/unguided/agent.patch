+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="overlay-close" id="close-dialog-btn" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Yes, log out</a>
+    </div>
+  </dialog>
+
+  <aside class="order-notice" id="order-notice" aria-label="Online ordering information" hidden>
+    <button type="button" class="overlay-close" id="close-notice-btn" aria-label="Dismiss ordering information">&times;</button>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderNotice = document.getElementById('order-notice');
+
+    // Keep overlays mounted until their exit animation has finished.
+    function closeWithAnimation(element, onClosed) {
+      if (element.classList.contains('is-closing')) return;
+      element.classList.add('is-closing');
+      let fallback;
+      function finish(event) {
+        if (event && (event.target !== element || event.animationName !== 'overlay-exit')) return;
+        clearTimeout(fallback);
+        element.removeEventListener('animationend', finish);
+        onClosed();
+        element.classList.remove('is-closing');
+      }
+      element.addEventListener('animationend', finish);
+      fallback = setTimeout(finish, 250);
+    }
+
+    function closeLogoutDialog() {
+      if (!logoutDialog.open) return;
+      closeWithAnimation(logoutDialog, () => {
+        logoutDialog.close();
+        document.body.classList.remove('dialog-open');
+        logoutLink.focus();
+      });
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (logoutDialog.open) return;
+      logoutDialog.showModal();
+      document.body.classList.add('dialog-open');
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+    logoutDialog.addEventListener('click', (event) => {
+      const bounds = logoutDialog.getBoundingClientRect();
+      if (event.target === logoutDialog &&
+          (event.clientX < bounds.left || event.clientX > bounds.right ||
+           event.clientY < bounds.top || event.clientY > bounds.bottom)) {
+        closeLogoutDialog();
+      }
+    });
+
+    function dismissOrderNotice() {
+      if (orderNotice.hidden) return;
+      closeWithAnimation(orderNotice, () => {
+        const hadFocus = orderNotice.contains(document.activeElement);
+        orderNotice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (hadFocus) orderButton.focus();
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      if (!orderNotice.hidden) {
+        dismissOrderNotice();
+        return;
+      }
+      orderNotice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', dismissOrderNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open) dismissOrderNotice();
+    });
+  </script>
