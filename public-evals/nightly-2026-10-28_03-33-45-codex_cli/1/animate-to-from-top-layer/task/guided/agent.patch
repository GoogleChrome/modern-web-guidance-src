+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <div class="overlay-heading">
+      <h2 id="logout-title">Log out?</h2>
+      <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation">&times;</button>
+    </div>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Confirm Logout</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" popover="manual" aria-label="Online ordering information">
+    <div class="overlay-heading">
+      <p role="status">online ordering is currently offline</p>
+      <button type="button" id="close-notice-btn" class="close-button" aria-label="Dismiss ordering notice">&times;</button>
+    </div>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderingButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    if (!supportsPopover) orderingNotice.removeAttribute('popover');
+
+    // Keep the element (and dialog backdrop) visible until CSS exits finish,
+    // including browsers without discrete display/overlay transitions.
+    async function dismissOverlay(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    const closeLogout = () => dismissOverlay(logoutDialog, () => logoutDialog.close());
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogout();
+    });
+
+    orderingButton.addEventListener('click', () => {
+      if (orderingButton.getAttribute('aria-expanded') === 'true') return;
+      if (supportsPopover) orderingNotice.showPopover();
+      else orderingNotice.setAttribute('data-fallback-open', '');
+      orderingButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', () => {
+      dismissOverlay(orderingNotice, () => {
+        const restoreFocus = orderingNotice.contains(document.activeElement);
+        if (supportsPopover) orderingNotice.hidePopover();
+        else orderingNotice.removeAttribute('data-fallback-open');
+        orderingButton.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderingButton.focus();
+      });
+    });
+  </script>
