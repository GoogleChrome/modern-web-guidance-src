       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* The transparent text copy lets native decoration skip letter descenders.
+       Clip only that copy to reveal the line without moving or hiding the text. */
+    .decorated-text {
+      --line-color: var(--accent);
+      --line-style: solid;
+      --line-thickness: 0.08em;
+      --line-offset: 0.22em;
+      --line-inset-start: 0.05em;
+      --line-inset-end: 0.05em;
+      position: relative;
+      display: inline-block;
+    }
+
+    .decorated-text::after {
+      /* Empty alternative text keeps generated content out of accessible names. */
+      content: attr(data-text) / "";
+      position: absolute;
+      inset: 0;
+      color: transparent;
+      pointer-events: none;
+      text-decoration-line: underline;
+      text-decoration-color: var(--line-color);
+      text-decoration-style: var(--line-style);
+      text-decoration-thickness: var(--line-thickness);
+      text-underline-offset: var(--line-offset);
+      text-decoration-skip-ink: auto;
+      clip-path: inset(-0.5em var(--line-inset-end) -0.65em var(--line-inset-start));
+    }
+
+    nav .decorated-text {
+      --line-inset-start: 0.08em;
+      --line-inset-end: 0.08em;
+    }
+
+    nav .decorated-text::after,
+    .footer-links .decorated-text::after {
+      clip-path: inset(-0.5em 100% -0.65em var(--line-inset-start));
+      transition: clip-path 350ms ease;
+    }
+
+    nav a:is(:hover, :focus-visible) .decorated-text::after,
+    .footer-links a:is(:hover, :focus-visible) .decorated-text::after {
+      clip-path: inset(-0.5em var(--line-inset-end) -0.65em var(--line-inset-start));
+    }
+
+    nav a:focus-visible,
+    .footer-links a:focus-visible {
+      outline: 2px solid currentColor;
+      outline-offset: 6px;
+    }
+
+    .section-title {
+      text-align: center;
+      padding-bottom: 0.35em;
+    }
+
+    .section-title .decorated-text {
+      --line-style: wavy;
+      --line-offset: 0.3em;
+      --line-inset-start: 0.45em;
+      --line-inset-end: 0.45em;
+    }
+
+    .section-title .decorated-text::after,
+    .card .decorated-text::after {
+      animation: reveal-line 850ms ease both;
+    }
+
+    .card .decorated-text {
+      --line-color: #a96924;
+      --line-offset: 0.25em;
+      --line-inset-start: 0.2em;
+      --line-inset-end: 0.2em;
+    }
+
+    .card:nth-child(1) .decorated-text {
+      --line-style: double;
+    }
+
+    .card:nth-child(2) .decorated-text::after {
+      animation-delay: 150ms;
+    }
+
+    .card:nth-child(3) .decorated-text {
+      --line-style: wavy;
+    }
+
+    .card:nth-child(3) .decorated-text::after {
+      animation-delay: 300ms;
+    }
+
+    .footer-links .decorated-text {
+      --line-color: var(--primary);
+      --line-style: double;
+      --line-thickness: 0.06em;
+      --line-offset: 0.3em;
+      --line-inset-start: 0.12em;
+      --line-inset-end: 0.12em;
+    }
+
+    @keyframes reveal-line {
+      from {
+        clip-path: inset(-0.5em 100% -0.65em var(--line-inset-start));
+      }
+      to {
+        clip-path: inset(-0.5em var(--line-inset-end) -0.65em var(--line-inset-start));
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
