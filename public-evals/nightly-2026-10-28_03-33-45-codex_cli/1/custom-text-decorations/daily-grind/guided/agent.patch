+      text-underline-offset: 0.22em;
+    }
+
+    :where(nav a, .footer-links a):focus-visible {
+      outline: 2px solid currentColor;
+      outline-offset: 5px;
+      border-radius: 2px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      :where(nav a.text-line, .footer-links a.text-line) {
+        transition: color 0.25s ease-out, text-decoration-color 0.25s ease-out;
+      }
+
+      :where(nav a.text-line, .footer-links a.text-line):is(:hover, :focus-visible) {
+        text-decoration-color: currentColor;
+      }
+
+      /* Unsupported inset declarations leave the native line visible. */
+      @supports (text-decoration-inset: 0 100%) {
+        :where(nav a.text-line, .footer-links a.text-line) {
+          text-decoration-inset: var(--line-start) 100%;
+          transition: color 0.25s ease-out, text-decoration-color 0.25s ease-out,
+            text-decoration-inset 0.3s ease-out;
+        }
+
+        :where(nav a.text-line, .footer-links a.text-line):is(:hover, :focus-visible) {
+          text-decoration-inset: var(--line-start) var(--line-end);
+        }
+      }
+
+      .seasonal-title .text-line,
+      .card .text-line {
+        animation: reveal-text-line 0.7s ease-out backwards;
+      }
+
+      .card .text-line { animation-delay: 0.15s; }
+      .card:nth-child(2) .text-line { animation-delay: 0.25s; }
+      .card:nth-child(3) .text-line { animation-delay: 0.35s; }
+
+      @keyframes reveal-text-line {
+        from {
+          text-decoration-color: transparent;
+          text-decoration-inset: var(--line-start) 100%;
+        }
+        to {
+          text-decoration-color: var(--line-color);
+          text-decoration-inset: var(--line-start) var(--line-end);
+        }
+      }
+    }
