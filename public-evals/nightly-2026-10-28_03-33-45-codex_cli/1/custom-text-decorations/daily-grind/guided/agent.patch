+    /* Native lines follow wrapped text and retain default descender ink skipping.
+       Each treatment controls its vertical offset and horizontal end insets. */
+    :where(.text-line) {
+      --line-color: #a85a12;
+      --line-start: 0.12em;
+      --line-end: 0.12em;
+      text-decoration: underline solid var(--line-color) max(1px, 0.07em);
