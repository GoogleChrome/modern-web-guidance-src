+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+    const value = document.getElementById('roast-value');
+    const orderLink = document.getElementById('order-now');
+
+    function closePicker(returnFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openPicker(index = options.findIndex(option => option.getAttribute('aria-selected') === 'true')) {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    trigger.addEventListener('click', () => {
+      if (menu.hidden) openPicker();
+      else closePicker();
+    });
+
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+
+    options.forEach(option => option.addEventListener('click', () => {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      value.textContent = option.querySelector('.roast-name').textContent + ' roast';
+      orderLink.href = '/order-online?roast=' + option.dataset.roast;
+      closePicker(true);
+    }));
+
+    menu.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % options.length;
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index + options.length - 1) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (/^[lmd]$/i.test(event.key)) next = options.findIndex(option => option.dataset.roast.startsWith(event.key.toLowerCase()));
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      }
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closePicker(true);
+      }
+      if (event.key === 'Tab') {
+        // Move from the composite picker to the next/previous page control.
+        trigger.focus();
+        closePicker();
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
 </body>
 
