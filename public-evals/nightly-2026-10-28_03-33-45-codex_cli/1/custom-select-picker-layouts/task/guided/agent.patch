+    }
+
+    .hero-order .btn {
+      border: 1px solid var(--secondary);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select::picker(select) {
+        width: anchor-size(width);
+        max-width: calc(100vw - 32px);
+        margin-block: 8px;
+        padding: 8px;
+        border: 1px solid var(--secondary);
+        border-radius: 12px;
+        background: #fffaf5;
+        color: var(--text);
+        box-shadow: 0 12px 32px #24150e40;
+      }
+
+      /* Apply grid only while open so it cannot reveal a closed picker. */
+      .roast-select:open::picker(select) {
+        display: grid;
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+        gap: 6px;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+      }
+
+      .roast-select option {
+        position: relative;
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 6px;
+        padding: 14px 4px 10px;
+        border: 2px solid transparent;
+        border-radius: 8px;
+        text-align: center;
+        cursor: pointer;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: #eee3d8;
+        outline-offset: -3px;
+      }
+
+      .roast-select option:checked {
+        border-color: var(--primary);
+        background: #f0e2cf;
+      }
+
+      .roast-select option::checkmark {
+        position: absolute;
+        top: 2px;
+        right: 5px;
+        color: var(--primary);
+        font-weight: 700;
+      }
+
+      .roast-art {
+        width: 48px;
+        height: 48px;
+        flex-shrink: 0;
+      }
+
+      .roast-name {
+        font-weight: 700;
+      }
+
+      .roast-notes {
+        font-size: 0.75rem;
+        line-height: 1.4;
+        color: #685247;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent .roast-art {
+        width: 28px;
+        height: 28px;
+      }
+
+      .roast-select selectedcontent .roast-notes {
+        display: none;
+      }
+    }
