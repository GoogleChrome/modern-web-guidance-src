+  <script type="module">
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+    const plannerControls = document.getElementById('plannerControls');
+    const destinations = [
+      { name: 'New York', zone: 'America/New_York' },
+      { name: 'London', zone: 'Europe/London' },
+      { name: 'Tokyo', zone: 'Asia/Tokyo' },
+      { name: 'UTC', zone: 'UTC' },
+    ];
+    const timeFormat = { hour: 'numeric', minute: '2-digit', hour12: true };
+    const dateFormat = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+    function showWarning(message = '') {
+      hostWarning.textContent = message;
+      hostWarning.hidden = !message;
+    }
+
+    async function initializePlanner() {
+      try {
+        // Use the native API where available; load the same API for older browsers.
+        const TemporalAPI = globalThis.Temporal ??
+          (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+
+        dateInput.value = TemporalAPI.Now.zonedDateTimeISO(hostTzSelect.value)
+          .toPlainDate().toString();
+        plannerControls.disabled = false;
+
+        function updatePlanner() {
+          grid.replaceChildren();
+          if (!dateInput.value || !timeInput.value ||
+              !dateInput.validity.valid || !timeInput.validity.valid) {
+            showWarning('Choose a valid tasting date and host time to see the local times.');
+            return;
+          }
+
+          try {
+            const input = `${dateInput.value}T${timeInput.value}[${hostTzSelect.value}]`;
+            // Validate and resolve first, so malformed input cannot be mistaken for DST.
+            const hostTime = TemporalAPI.ZonedDateTime.from(input, {
+              disambiguation: 'compatible', overflow: 'reject',
+            });
+            let warning = '';
+
+            try {
+              TemporalAPI.ZonedDateTime.from(input, { disambiguation: 'reject' });
+            } catch (error) {
+              if (!(error instanceof RangeError)) throw error;
+              const earlier = TemporalAPI.ZonedDateTime.from(input, { disambiguation: 'earlier' });
+              const later = TemporalAPI.ZonedDateTime.from(input, { disambiguation: 'later' });
+              const isOverlap = earlier.toPlainDateTime().equals(later.toPlainDateTime());
+              const resolved = hostTime.toLocaleString('en-US', { ...dateFormat, ...timeFormat });
+
+              warning = isOverlap
+                ? `Daylight saving overlap: this host time occurs twice in ${hostTzSelect.value}. We selected the first occurrence: ${resolved} (UTC${hostTime.offset}); the second occurrence has offset UTC${later.offset}. All cards show the first occurrence.`
+                : `Daylight saving gap: this host time does not exist in ${hostTzSelect.value} because the clocks move forward. We shifted it forward by the clock-change gap to ${resolved} (UTC${hostTime.offset}). All cards show this resolved time.`;
+            }
+
+            const cards = destinations.map(({ name, zone }) => {
+              // Temporal objects are immutable: each conversion returns a new object.
+              const localTime = hostTime.withTimeZone(zone);
+              const card = document.createElement('article');
+              card.className = 'timezone-card';
+              const heading = document.createElement('h3');
+              heading.textContent = name;
+              const time = document.createElement('time');
+              time.className = 'local-time';
+              time.dateTime = localTime.toInstant().toString();
+              time.textContent = localTime.toLocaleString('en-US', timeFormat);
+              const date = document.createElement('span');
+              date.className = 'local-date';
+              date.textContent = localTime.toLocaleString('en-US', dateFormat);
+              const offset = document.createElement('span');
+              offset.className = 'timezone-offset';
+              offset.textContent = `UTC${localTime.offset}`;
+              card.append(heading, time, date, offset);
+              return card;
+            });
+
+            grid.replaceChildren(...cards);
+            showWarning(warning);
+          } catch {
+            showWarning('We couldn’t calculate that tasting time. Please check the date, time, and host time zone.');
+          }
+        }
+
+        for (const control of [dateInput, timeInput, hostTzSelect]) {
+          control.addEventListener('input', updatePlanner);
+          control.addEventListener('change', updatePlanner);
+        }
+        updatePlanner();
+      } catch {
+        showWarning('The tasting planner couldn’t load. Please check your connection and reload, or try a browser with Temporal support.');
+      }
+    }
+
+    initializePlanner();
+  </script>
+
 </body>
 
