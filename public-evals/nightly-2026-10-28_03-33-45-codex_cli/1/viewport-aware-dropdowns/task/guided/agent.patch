+  <script type="module">
+    // Native popovers use the browser's top layer and provide Escape/light dismissal.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById("trigger-btn");
+    const panel = document.getElementById("action-panel");
+    const nativeAnchors = CSS.supports("anchor-name: --options-trigger") &&
+      CSS.supports("position-area: block-end span-inline-end") &&
+      CSS.supports("position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline");
+    let isOpen = false;
+
+    function positionPanel() {
+      const anchor = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? document.documentElement.clientHeight) - 16;
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+
+      // Scroll oversized content within whichever side has enough room.
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      panel.style.maxHeight = `${Math.max(above, below)}px`;
+      if (nativeAnchors) return;
+
+      // Keep older browsers tethered too, including on scroll and viewport resize.
+      panel.style.positionArea = "none";
+      const { width, height } = panel.getBoundingClientRect();
+      const left = anchor.left + width <= rightEdge ? anchor.left : anchor.right - width;
+      const top = height <= below ? anchor.bottom : anchor.top - height;
+      panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - width))}px`;
+      panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`;
+    }
+
+    panel.addEventListener("beforetoggle", (event) => {
+      isOpen = event.newState === "open";
+      if (isOpen) requestAnimationFrame(positionPanel);
+    });
+    panel.addEventListener("toggle", () => {
+      if (isOpen) positionPanel();
+    });
+    const reposition = () => {
+      if (isOpen) positionPanel();
+    };
+    window.addEventListener("resize", reposition);
+    document.addEventListener("scroll", reposition, true);
+    window.visualViewport?.addEventListener("resize", reposition);
+    window.visualViewport?.addEventListener("scroll", reposition);
+    new ResizeObserver(reposition).observe(trigger);
+
+    panel.addEventListener("click", (event) => {
+      const action = event.target.closest("button[data-href]");
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
