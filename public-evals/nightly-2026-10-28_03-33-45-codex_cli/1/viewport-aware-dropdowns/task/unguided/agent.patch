+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      // Popovers render in the top layer; fixed coordinates are relative to
+      // the viewport, independent of navigation overflow and stacking contexts.
+      const viewport = window.visualViewport;
+      const edge = 8;
+      const minX = (viewport?.offsetLeft ?? 0) + edge;
+      const minY = (viewport?.offsetTop ?? 0) + edge;
+      const maxX = minX + (viewport?.width ?? window.innerWidth) - edge * 2;
+      const maxY = minY + (viewport?.height ?? window.innerHeight) - edge * 2;
+
+      panel.style.maxWidth = `${Math.max(0, maxX - minX)}px`;
+      panel.style.maxHeight = `${Math.max(0, maxY - minY)}px`;
+
+      const anchor = trigger.getBoundingClientRect();
+      const { width, height } = panel.getBoundingClientRect();
+      let left = anchor.left;
+      let top = anchor.bottom;
+
+      // Prefer below, left aligned; flip each axis independently on collision.
+      if (left + width > maxX) left = anchor.right - width;
+      if (top + height > maxY) top = anchor.top - height;
+
+      // If neither side fits, keep the entire scrollable panel in the viewport.
+      panel.style.left = `${Math.max(minX, Math.min(left, maxX - width))}px`;
+      panel.style.top = `${Math.max(minY, Math.min(top, maxY - height))}px`;
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      if (event.newState === 'open') {
+        // Runs after the popover becomes measurable, before the next paint.
+        requestAnimationFrame(positionPanel);
+      }
+    });
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    const positionObserver = new ResizeObserver(positionPanel);
+    positionObserver.observe(trigger);
+    positionObserver.observe(panel);
+    positionObserver.observe(document.querySelector('nav'));
+  </script>
