+  <script>
+    (() => {
+      const form = document.querySelector('#sign-in-form');
+      const username = document.querySelector('#username');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      const status = document.querySelector('[data-testid="auth-status"]');
+      let activeRequest;
+      let signedIn = false;
+      let conditionalAvailable = false;
+      let explicitPending = false;
+
+      const decode = (value) => {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')),
+          (character) => character.charCodeAt(0));
+      };
+
+      const encode = (value) => btoa(String.fromCharCode(...new Uint8Array(value)))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      async function authenticate(conditional) {
+        if (signedIn || (conditional && (activeRequest || explicitPending))) return;
+        activeRequest?.abort();
+        const controller = new AbortController();
+        activeRequest = controller;
+        if (!conditional) {
+          explicitPending = true;
+          button.disabled = true;
+          status.textContent = 'Follow your device’s instructions to sign in.';
+        }
+
+        try {
+          // The server must issue a fresh, session-bound WebAuthn challenge.
+          const optionsResponse = await fetch('/api/login/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(conditional ? {} : { username: username.value.trim() }),
+            signal: controller.signal
+          });
+          if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+          const options = await optionsResponse.json();
+          const publicKey = { ...(options.publicKey || options) };
+          publicKey.challenge = decode(publicKey.challenge);
+          if (publicKey.allowCredentials) {
+            publicKey.allowCredentials = publicKey.allowCredentials.map((credential) => ({
+              ...credential, id: decode(credential.id)
+            }));
+          }
+          // Discoverable credentials must be available for username autofill.
+          if (conditional) publicKey.allowCredentials = [];
+          publicKey.userVerification = 'required';
+
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : 'required',
+            signal: controller.signal
+          });
+          if (controller.signal.aborted) return;
+          if (!credential) throw new Error('No passkey was selected. Please try again.');
+
+          button.disabled = true;
+          status.textContent = 'Verifying your passkey…';
+          const verification = await fetch('/api/login/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
+              id: credential.id,
+              rawId: encode(credential.rawId),
+              type: credential.type,
+              authenticatorAttachment: credential.authenticatorAttachment,
+              response: {
+                clientDataJSON: encode(credential.response.clientDataJSON),
+                authenticatorData: encode(credential.response.authenticatorData),
+                signature: encode(credential.response.signature),
+                userHandle: credential.response.userHandle == null
+                  ? null : encode(credential.response.userHandle)
+              },
+              clientExtensionResults: credential.getClientExtensionResults()
+            }),
+            signal: controller.signal
+          });
+          if (!verification.ok) throw new Error('Passkey verification failed. Please try again.');
+          const result = verification.status === 204 ? {} : await verification.json();
+          if (result.success === false || result.verified === false || result.authenticated === false) {
+            throw new Error('Passkey verification failed. Please try again.');
+          }
+          signedIn = true;
+          status.textContent = 'Successfully signed in with your passkey.';
+        } catch (error) {
+          if (!controller.signal.aborted) {
+            if (error.name === 'NotAllowedError') {
+              if (!conditional) status.textContent = 'Sign-in was canceled or timed out. Please try again.';
+            } else {
+              status.textContent = error instanceof TypeError
+                ? 'Could not complete passkey sign-in. Please try again.' : error.message;
+            }
+          }
+        } finally {
+          if (activeRequest === controller) {
+            activeRequest = undefined;
+            explicitPending = false;
+            button.disabled = signedIn;
+            if (!conditional && !signedIn && conditionalAvailable) void authenticate(true);
+          }
+        }
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!explicitPending) void authenticate(false);
+      });
+
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        button.disabled = true;
+        status.textContent = 'Passkey sign-in is not supported in this browser. Use a supported browser over HTTPS.';
+        return;
+      }
+
+      // Arm autofill on load so focusing the username field can show passkeys.
+      if (PublicKeyCredential.isConditionalMediationAvailable) {
+        PublicKeyCredential.isConditionalMediationAvailable().then((available) => {
+          conditionalAvailable = available;
+          if (available) void authenticate(true);
+        }).catch(() => { /* The explicit sign-in button remains available. */ });
+      }
+      username.addEventListener('focus', () => {
+        if (conditionalAvailable) void authenticate(true);
+      });
+    })();
+  </script>
+
 </body>
 
