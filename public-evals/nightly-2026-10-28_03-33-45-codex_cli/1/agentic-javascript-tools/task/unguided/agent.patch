diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,82 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Prefer the current WebMCP API, with support for earlier browser versions.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const tool = {
+        name: 'get_menu_item',
+        description: 'Look up a Daily Grind menu item by name and return its name, description, and details URL. Available items include Maple Oat Latte, Dark Roast Espresso, and Cold Brew. Matching ignores capitalization and surrounding whitespace.',
+        inputSchema: {
+          type: 'object',
+          description: 'The menu item to look up.',
+          properties: {
+            name: {
+              type: 'string',
+              description: 'The full menu item name, such as "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew".',
+              minLength: 1
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        async execute(input) {
+          if (typeof input?.name !== 'string' || !input.name.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          // Read the displayed menu so tool responses stay aligned with the page.
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const name = input.name.trim().toLowerCase();
+          const item = items.find((item) => item.name.toLowerCase() === name);
+          return item ?? {
+            error: 'Menu item not found. Use one of the available item names.',
+            availableItems: items.map((item) => item.name)
+          };
+        }
+      };
+
+      let registration;
+
+      function registerTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          Promise.resolve(modelContext.registerTool(tool, { signal: controller.signal }))
+            .catch((error) => {
+              if (registration === controller) registration = undefined;
+              if (!controller.signal.aborted) console.warn('Menu tool registration failed:', error);
+            });
+        } catch (error) {
+          registration = undefined;
+          console.warn('Menu tool registration failed:', error);
+        }
+      }
+
+      function unregisterTool() {
+        if (!registration) return;
+        registration.abort();
+        registration = undefined;
+        // Older WebMCP implementations use explicit unregistration.
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(tool.name);
+        }
+      }
+
+      window.addEventListener('pagehide', unregisterTool);
+      window.addEventListener('pageshow', registerTool);
+      registerTool();
+    })();
+  </script>
 </body>
 
 </html>
