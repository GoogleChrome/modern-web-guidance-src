+  <script>
+    for (const card of document.querySelectorAll('.card')) {
+      const content = card.querySelector('.card-content');
+      const toggle = content.querySelector('button');
+      const close = card.querySelector('.close-actions');
+
+      const closeActions = () => {
+        toggle.focus({ preventScroll: true });
+        card.scrollTo({ left: 0 });
+      };
+
+      toggle.addEventListener('click', () => {
+        card.scrollTo({ left: card.scrollLeft > 1 ? 0 : card.scrollWidth - card.clientWidth });
+      });
+      close.addEventListener('click', closeActions);
+      card.addEventListener('scroll', () => {
+        toggle.setAttribute('aria-expanded', String(card.scrollLeft > 1));
+      }, { passive: true });
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeActions();
+        }
+      });
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+  </script>
+
