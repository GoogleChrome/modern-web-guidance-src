+  <script>
+    const drinkCards = document.querySelectorAll('.drink-card');
+
+    function setActionsOpen(card, open) {
+      if (open) {
+        drinkCards.forEach(other => {
+          if (other !== card) setActionsOpen(other, false);
+        });
+      }
+      const actions = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.actions-toggle');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      actions.inert = !open;
+      actions.setAttribute('aria-hidden', String(!open));
+      toggle.setAttribute('aria-expanded', String(open));
+      toggle.textContent = open ? 'Close' : 'Actions';
+    }
+
+    drinkCards.forEach(card => {
+      const content = card.querySelector('.drink-content');
+      let gesture = null;
+      let suppressClick = false;
+
+      card.querySelector('.actions-toggle').addEventListener('click', () => {
+        setActionsOpen(card, !card.classList.contains('is-open'));
+      });
+
+      card.querySelector('.save-drink').addEventListener('click', event => {
+        const button = event.currentTarget;
+        const saved = button.getAttribute('aria-pressed') !== 'true';
+        button.setAttribute('aria-pressed', String(saved));
+        button.setAttribute('aria-label', `${saved ? 'Unsave' : 'Save'} ${card.dataset.drink}`);
+        button.textContent = saved ? 'Saved' : 'Save drink';
+      });
+
+      content.addEventListener('pointerdown', event => {
+        suppressClick = false;
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button, a')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY,
+          open: card.classList.contains('is-open'), horizontal: false };
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 10) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { gesture = null; return; }
+          gesture.horizontal = true;
+          content.setPointerCapture(event.pointerId);
+          card.classList.add('is-dragging');
+        }
+        const width = card.querySelector('.drink-actions').offsetWidth;
+        const offset = Math.max(-width, Math.min(0, (gesture.open ? -width : 0) + dx));
+        content.style.transform = `translateX(${offset}px)`;
+      });
+
+      function endGesture(event) {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const current = gesture;
+        gesture = null;
+        card.classList.remove('is-dragging');
+        content.style.removeProperty('transform');
+        if (current.horizontal) {
+          suppressClick = true;
+          const dx = event.clientX - current.x;
+          const open = event.type === 'pointerup' && Math.abs(dx) > 40 ? dx < 0 : current.open;
+          setActionsOpen(card, open);
+        }
+        if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId);
+      }
+
+      content.addEventListener('pointerup', endGesture);
+      content.addEventListener('pointercancel', endGesture);
+      content.addEventListener('lostpointercapture', endGesture);
+      card.addEventListener('click', event => {
+        if (suppressClick && event.detail !== 0) {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          suppressClick = false;
+        }
+      }, true);
+      card.addEventListener('pointerdown', () => { suppressClick = false; }, true);
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape') setActionsOpen(card, false);
+      });
+    });
+
+    document.addEventListener('pointerdown', event => {
+      drinkCards.forEach(card => {
+        if (!card.contains(event.target)) setActionsOpen(card, false);
+      });
+    });
+  </script>
