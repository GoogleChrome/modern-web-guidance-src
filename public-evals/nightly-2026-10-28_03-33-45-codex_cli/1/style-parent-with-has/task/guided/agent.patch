+  <script>
+    const contactForm = document.getElementById('contact-form');
+
+    // CSS controls error presentation; keep assistive technology in sync.
+    const syncContactValidity = (event) => {
+      const field = event.target;
+      if (!field.matches('input, textarea')) return;
+      requestAnimationFrame(() => {
+        if (field.matches(':user-invalid')) {
+          field.setAttribute('aria-invalid', 'true');
+        } else {
+          field.removeAttribute('aria-invalid');
+        }
+      });
+    };
+
+    contactForm.addEventListener('focusout', syncContactValidity);
+    contactForm.addEventListener('input', syncContactValidity);
+    contactForm.addEventListener('invalid', syncContactValidity, true);
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      document.getElementById('contact-status').textContent =
+        'Message delivery is not connected yet. Your message has not been sent.';
+    });
+  </script>
