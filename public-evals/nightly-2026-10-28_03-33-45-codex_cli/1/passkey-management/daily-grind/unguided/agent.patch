+import { createPasskeyService, syncAuthenticator } from './passkey-service.mjs';
+
+const $ = selector => document.querySelector(selector);
+const list = $('#passkey-list');
+const dialog = $('#passkey-dialog');
+const form = $('#passkey-form');
+const nameInput = $('#passkey-name');
+const confirmButton = $('#confirm-dialog');
+const cancelButton = $('#cancel-dialog');
+const status = $('#status');
+let storage;
+try { storage = localStorage; } catch { /* Storage is optional. */ }
+const service = createPasskeyService({
+  mode: document.documentElement.dataset.accountMode,
+  storage,
+  fetcher: (...args) => fetch(...args),
+  hostname: location.hostname,
+});
+let snapshot;
+let selected;
+let action;
+let opener;
+let saving = false;
+let loading = false;
+
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+  use.setAttribute('href', `#${name}`);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function dateLabel(value) {
+  const date = new Date(value);
+  return value && !Number.isNaN(date.valueOf()) ? new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date) : 'Not available';
+}
+function notify(message, error = false) {
+  status.textContent = message;
+  status.className = `status${error ? ' error' : ''}`;
+  status.hidden = false;
+}
+function render() {
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+  $('#key-count').textContent = snapshot.passkeys.length;
+  if (!snapshot.passkeys.length) {
+    const empty = element('div', 'empty-state');
+    empty.append(element('strong', '', 'No passkeys registered'), element('p', '', 'Your registered passkeys will appear here when you add one to your account.'));
+    if (service.preview) empty.append(element('p', '', 'All sample passkeys have been removed from this preview.'));
+    list.append(empty);
+    return;
+  }
+  snapshot.passkeys.forEach(key => {
+    const row = element('article', 'passkey-row');
+    const device = element('div', 'device-icon');
+    device.append(icon(['phone', 'laptop'].includes(key.device) ? key.device : 'key'));
+    const details = element('div', 'key-details');
+    const title = element('div', 'key-title');
+    title.append(element('h4', '', key.name));
+    if (key.current) title.append(element('span', 'current-badge', 'Used for this sign-in'));
+    details.append(title, element('p', '', `Added ${dateLabel(key.createdAt)} · Last used ${dateLabel(key.lastUsedAt)}`));
+    const actions = element('div', 'row-actions');
+    for (const [type, label, glyph] of [['rename', 'Rename', 'edit'], ['delete', 'Delete', 'trash']]) {
+      const button = element('button', `row-action ${type}`);
+      button.type = 'button';
+      button.setAttribute('aria-label', `${label} ${key.name}`);
+      button.dataset.keyId = key.id;
+      button.append(icon(glyph), element('span', '', label));
+      button.addEventListener('click', () => openDialog(type, key, button));
+      actions.append(button);
+    }
+    row.append(device, details, actions);
+    list.append(row);
+  });
+}
+async function synchronize() {
+  if (service.preview) return;
+  const result = await syncAuthenticator(snapshot, window.PublicKeyCredential, window.isSecureContext);
+  $('#sync-note').textContent = result === 'signaled'
+    ? 'Your browser has been notified of your current passkeys. Your passkey provider controls when changes are applied.'
+    : result === 'unsupported'
+      ? 'Automatic sync isn’t available in this browser. Remove unused passkeys from your device’s password or passkey settings, too.'
+      : 'Your account is up to date, but browser sync couldn’t finish. You can remove unused passkeys in your device settings.';
+}
+async function load() {
+  if (loading) return;
+  loading = true;
+  list.setAttribute('aria-busy', 'true');
+  status.hidden = true;
+  try {
+    snapshot = await service.list();
+    render();
+    await synchronize();
+  } catch (error) {
+    snapshot = null;
+    $('#key-count').textContent = '—';
+    const container = element('div', 'empty-state');
+    container.append(element('strong', '', 'Your passkeys couldn’t be loaded'), element('p', '', error.message));
+    const retry = element('button', 'button secondary', 'Try again');
+    retry.type = 'button';
+    retry.addEventListener('click', load);
+    container.append(retry);
+    list.replaceChildren(container);
+  } finally {
+    loading = false;
+    list.setAttribute('aria-busy', 'false');
+  }
+}
+function openDialog(type, key, button) {
+  selected = key;
+  action = type;
+  opener = button;
+  const deleting = type === 'delete';
+  $('#dialog-title').textContent = deleting ? 'Delete this passkey?' : 'Rename your passkey';
+  $('#dialog-description').textContent = deleting
+    ? `“${key.name}” will no longer work to sign in.${snapshot.passkeys.length === 1 ? ' This is your last passkey. Make sure you have another way to access your account before continuing.' : ''}${key.current ? ' This passkey was used for your current sign-in. Your existing session will stay open.' : ''}${service.preview ? ' This only removes sample data.' : ' Supported browsers will be notified. You may also need to remove it in your device settings.'}`
+    : 'Give this passkey a familiar name so it’s easy to recognize. This changes its name in your Daily Grind account.';
+  $('#dialog-icon').replaceChildren(icon(deleting ? 'trash' : 'edit'));
+  $('#rename-field').hidden = deleting;
+  nameInput.required = !deleting;
+  nameInput.disabled = deleting;
+  nameInput.value = key.name;
+  nameInput.setCustomValidity('');
+  $('#dialog-error').hidden = true;
+  confirmButton.textContent = deleting ? 'Delete passkey' : 'Save name';
+  confirmButton.className = `button ${deleting ? 'danger' : 'primary'}`;
+  dialog.showModal();
+  if (!deleting) { nameInput.focus(); nameInput.select(); }
+  else cancelButton.focus();
+}
+cancelButton.addEventListener('click', () => { if (!saving) dialog.close(); });
+dialog.addEventListener('cancel', event => { if (saving) event.preventDefault(); });
+dialog.addEventListener('close', () => {
+  if (opener?.isConnected) opener.focus();
+  else {
+    const next = list.querySelector('button');
+    if (next) next.focus();
+    else { $('#security-title').tabIndex = -1; $('#security-title').focus(); }
+  }
+});
+nameInput.addEventListener('input', () => nameInput.setCustomValidity(''));
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (saving) return;
+  const newName = nameInput.value.trim();
+  if (action === 'rename' && !newName) {
+    nameInput.setCustomValidity('Enter a name for this passkey.');
+    nameInput.reportValidity();
+    return;
+  }
+  saving = true;
+  cancelButton.disabled = true;
+  confirmButton.disabled = true;
+  confirmButton.textContent = action === 'delete' ? 'Deleting…' : 'Saving…';
+  $('#dialog-error').hidden = true;
+  try {
+    snapshot = action === 'delete' ? await service.remove(selected.id) : await service.rename(selected.id, newName);
+    render();
+    const deleting = action === 'delete';
+    // The old row was replaced; restore focus to its replacement when renaming.
+    if (!deleting) opener = [...list.querySelectorAll('button')].find(button => button.dataset.keyId === selected.id);
+    dialog.close();
+    notify(deleting ? `“${selected.name}” was deleted.${service.preview ? ' Sample data updated.' : ''}` : `Passkey renamed to “${newName}”.`);
+    if (deleting) await synchronize();
+  } catch (error) {
+    $('#dialog-error').textContent = error.message;
+    $('#dialog-error').hidden = false;
+  } finally {
+    saving = false;
+    cancelButton.disabled = false;
+    confirmButton.disabled = false;
+    confirmButton.textContent = action === 'delete' ? 'Delete passkey' : 'Save name';
+  }
+});
+if (service.preview) {
+  $('#preview-note').hidden = false;
+  $('#sync-note').textContent = 'This preview uses sample passkeys. Your real browser passkeys are never changed.';
+}
+load();
