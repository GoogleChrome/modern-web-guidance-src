diff --git a/passkey-service.mjs b/passkey-service.mjs
new file mode 100644
index 0000000..8be7056
--- /dev/null
+++ b/passkey-service.mjs
@@ -0,0 +1,111 @@
+// This static checkout uses an explicit preview adapter. Set data-account-mode="live"
+// on <html> only after implementing the authenticated API described in ACCOUNT_API.md.
+export const previewKeys = [
+  { id: 'preview-mac', name: 'MacBook Pro', device: 'laptop', createdAt: '2026-09-12T10:30:00Z', lastUsedAt: '2026-10-28T08:15:00Z', current: true },
+  { id: 'preview-phone', name: 'iPhone', device: 'phone', createdAt: '2026-09-12T11:00:00Z', lastUsedAt: '2026-10-27T09:00:00Z', current: false },
+  { id: 'preview-security-key', name: 'YubiKey 5 NFC', device: 'key', createdAt: '2026-10-03T12:00:00Z', lastUsedAt: '2026-10-21T14:00:00Z', current: false },
+];
+
+export function validateSnapshot(data, hostname) {
+  const base64url = value => typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value) && value.length % 4 !== 1;
+  if (!data || data.authenticated !== true || data.complete !== true || !Array.isArray(data.passkeys) ||
+      !base64url(data.userId) || typeof data.rpId !== 'string' || !data.rpId ||
+      !(hostname === data.rpId || hostname.endsWith(`.${data.rpId}`)) ||
+      typeof data.csrfToken !== 'string' || !data.csrfToken) {
+    throw new Error('We couldn’t load a complete, authenticated passkey list. Please try again.');
+  }
+  const ids = new Set();
+  const credentials = new Set();
+  for (const key of data.passkeys) {
+    if (!key || typeof key.id !== 'string' || !key.id || ids.has(key.id) ||
+        !base64url(key.credentialId) || credentials.has(key.credentialId) ||
+        typeof key.name !== 'string' || !key.name.trim() || key.name.length > 64) {
+      throw new Error('The passkey list could not be verified. Please try again.');
+    }
+    ids.add(key.id);
+    credentials.add(key.credentialId);
+  }
+  return data;
+}
+
+export async function syncAuthenticator(snapshot, credentialAPI, secureContext) {
+  if (!secureContext || typeof credentialAPI?.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  try {
+    // Only a complete, server-confirmed snapshot may be used here. Never send preview IDs.
+    await credentialAPI.signalAllAcceptedCredentials({
+      rpId: snapshot.rpId,
+      userId: snapshot.userId,
+      allAcceptedCredentialIds: snapshot.passkeys.map(key => key.credentialId),
+    });
+    return 'signaled';
+  } catch {
+    return 'failed';
+  }
+}
+
+export function createPasskeyService({ mode, storage, fetcher, hostname }) {
+  const preview = mode !== 'live';
+  const storageKey = 'daily-grind-preview-passkeys-v1';
+  let snapshot;
+  let keys = structuredClone(previewKeys);
+  if (preview) {
+    try {
+      const saved = JSON.parse(storage?.getItem(storageKey) ?? 'null');
+      if (Array.isArray(saved) && saved.length <= previewKeys.length && saved.every(key =>
+        key && previewKeys.some(original => original.id === key.id) && typeof key.name === 'string' && key.name.trim() && key.name.length <= 64) &&
+        new Set(saved.map(key => key.id)).size === saved.length) {
+        keys = saved.map(key => ({ ...previewKeys.find(original => original.id === key.id), name: key.name }));
+      }
+    } catch { /* Storage can be disabled; the in-memory preview remains usable. */ }
+  }
+  function savePreview() {
+    try { storage?.setItem(storageKey, JSON.stringify(keys)); } catch { /* In-memory fallback. */ }
+  }
+  async function request(path = '', options = {}) {
+    const response = await fetcher(`/api/account/passkeys${path}`, {
+      ...options,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      headers: {
+        Accept: 'application/json',
+        ...(options.method ? { 'Content-Type': 'application/json', 'X-CSRF-Token': snapshot.csrfToken } : {}),
+      },
+    });
+    if (response.status === 401 || response.status === 403) throw new Error('Your session has expired. Sign in again to manage your passkeys.');
+    if (response.status === 409) throw new Error('This passkey has changed. Refresh the list and try again.');
+    if (!response.ok) throw new Error('We couldn’t save this change. Please try again.');
+    try { return validateSnapshot(await response.json(), hostname); }
+    catch { throw new Error('We couldn’t confirm your passkeys. Refresh the list before making another change.'); }
+  }
+  return {
+    preview,
+    async list() {
+      snapshot = preview ? { passkeys: structuredClone(keys) } : await request();
+      return snapshot;
+    },
+    async rename(id, name) {
+      name = name.trim();
+      if (!name || name.length > 64) throw new Error('Enter a name between 1 and 64 characters.');
+      if (!snapshot?.passkeys.some(key => key.id === id)) throw new Error('This passkey is no longer available. Refresh the list.');
+      if (preview) {
+        keys = keys.map(key => key.id === id ? { ...key, name } : key);
+        savePreview();
+        snapshot = { passkeys: structuredClone(keys) };
+      } else {
+        snapshot = await request(`/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ name }) });
+      }
+      return snapshot;
+    },
+    async remove(id) {
+      if (!snapshot?.passkeys.some(key => key.id === id)) throw new Error('This passkey is no longer available. Refresh the list.');
+      if (preview) {
+        keys = keys.filter(key => key.id !== id);
+        savePreview();
+        snapshot = { passkeys: structuredClone(keys) };
+      } else {
+        snapshot = await request(`/${encodeURIComponent(id)}`, { method: 'DELETE', body: '{}' });
+      }
+      return snapshot;
+    },
+  };
+}
diff --git a/passkey-service.test.mjs b/passkey-service.test.mjs
new file mode 100644
index 0000000..6eb6404
--- /dev/null
+++ b/passkey-service.test.mjs
@@ -0,0 +1,107 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyService, validateSnapshot, syncAuthenticator } from './passkey-service.mjs';
+
+const valid = () => ({
+  authenticated: true, complete: true, rpId: 'coffee.example.com', userId: 'dXNlcjEyMw', csrfToken: 'csrf',
+  passkeys: [{ id: 'key-1', credentialId: 'Y3JlZGVudGlhbDEyMw', name: 'Laptop' }],
+});
+const response = (data, status = 200) => ({ ok: status >= 200 && status < 300, status, json: async () => data });
+
+test('preview renames, persists and deletes without making network calls', async () => {
+  const stored = new Map();
+  const options = {
+    mode: 'preview',
+    storage: { getItem: key => stored.get(key), setItem: (key, value) => stored.set(key, value) },
+    fetcher: () => { throw new Error('Preview must not make API calls'); },
+  };
+  const service = createPasskeyService(options);
+  const initial = await service.list();
+  assert.equal(initial.passkeys.length, 3);
+  const first = initial.passkeys[0].id;
+  assert.equal((await service.rename(first, '  Work laptop  ')).passkeys[0].name, 'Work laptop');
+  assert.equal((await createPasskeyService(options).list()).passkeys[0].name, 'Work laptop');
+  assert.equal((await service.remove(first)).passkeys.length, 2);
+  assert.equal((await createPasskeyService(options).list()).passkeys.length, 2);
+});
+
+test('preview permits removal of all samples and survives unavailable storage', async () => {
+  const service = createPasskeyService({ mode: 'preview', storage: { getItem() { throw Error(); }, setItem() { throw Error(); } } });
+  const { passkeys } = await service.list();
+  for (const key of passkeys) await service.remove(key.id);
+  assert.deepEqual((await service.list()).passkeys, []);
+});
+
+test('rejects blank, overly long, and missing-record renames', async () => {
+  const service = createPasskeyService({ mode: 'preview' });
+  const { passkeys } = await service.list();
+  await assert.rejects(service.rename(passkeys[0].id, '  '));
+  await assert.rejects(service.rename(passkeys[0].id, 'x'.repeat(65)));
+  await assert.rejects(service.rename('absent', 'name'));
+});
+
+test('only complete, authenticated, RP-matching snapshots are accepted', () => {
+  assert.equal(validateSnapshot(valid(), 'coffee.example.com').passkeys.length, 1);
+  for (const changes of [
+    { complete: false }, { authenticated: false }, { userId: '' }, { csrfToken: '' },
+    { rpId: 'example.net' }, { rpId: '' }, { passkeys: [{}] },
+    { passkeys: [...valid().passkeys, ...valid().passkeys] },
+    { passkeys: [{ ...valid().passkeys[0], credentialId: 'not+base64/' }] },
+  ]) assert.throws(() => validateSnapshot({ ...valid(), ...changes }, 'coffee.example.com'));
+  assert.throws(() => validateSnapshot(valid(), 'evilcoffee.example.com'));
+});
+
+test('live mutations send CSRF and use server-confirmed snapshots', async () => {
+  const requests = [];
+  const changed = { ...valid(), passkeys: [{ ...valid().passkeys[0], name: 'Renamed' }] };
+  const responses = [valid(), changed, { ...valid(), passkeys: [] }];
+  const service = createPasskeyService({ mode: 'live', hostname: 'coffee.example.com', fetcher: async (url, options) => {
+    requests.push({ url, options });
+    return response(responses.shift());
+  } });
+  await service.list();
+  assert.equal((await service.rename('key-1', 'Renamed')).passkeys[0].name, 'Renamed');
+  assert.deepEqual((await service.remove('key-1')).passkeys, []);
+  assert.equal(requests[1].options.method, 'PATCH');
+  assert.equal(requests[1].options.headers['X-CSRF-Token'], 'csrf');
+  assert.deepEqual(JSON.parse(requests[1].options.body), { name: 'Renamed' });
+  assert.equal(requests[2].options.method, 'DELETE');
+  assert.equal(requests[2].options.credentials, 'same-origin');
+  assert.equal(requests[0].options.cache, 'no-store');
+});
+
+test('API failures never fall back to preview data', async () => {
+  for (const status of [401, 403, 404, 409, 500]) {
+    const service = createPasskeyService({ mode: 'live', hostname: 'coffee.example.com', fetcher: async () => response({}, status) });
+    await assert.rejects(service.list());
+    assert.equal(service.preview, false);
+  }
+});
+
+test('failed deletion does not replace the accepted credential list', async () => {
+  let count = 0;
+  const service = createPasskeyService({ mode: 'live', hostname: 'coffee.example.com', fetcher: async () => {
+    count++;
+    return count === 2 ? response({}, 500) : response(valid());
+  } });
+  const snapshot = await service.list();
+  await assert.rejects(service.remove('key-1'));
+  assert.equal(snapshot.passkeys.length, 1);
+  assert.equal((await service.rename('key-1', 'Renamed')).passkeys.length, 1);
+});
+
+test('sync sends complete credential list and intentionally supports final deletion', async () => {
+  const calls = [];
+  const api = { async signalAllAcceptedCredentials(options) { calls.push(options); } };
+  assert.equal(await syncAuthenticator(valid(), api, true), 'signaled');
+  assert.deepEqual(calls[0], { rpId: valid().rpId, userId: valid().userId, allAcceptedCredentialIds: [valid().passkeys[0].credentialId] });
+  assert.equal(await syncAuthenticator({ ...valid(), passkeys: [] }, api, true), 'signaled');
+  assert.deepEqual(calls[1].allAcceptedCredentialIds, []);
+});
+
+test('unsupported and failing sync remain distinct from server mutation failure', async () => {
+  assert.equal(await syncAuthenticator(valid(), undefined, true), 'unsupported');
+  assert.equal(await syncAuthenticator(valid(), {}, true), 'unsupported');
+  assert.equal(await syncAuthenticator(valid(), { signalAllAcceptedCredentials() { throw Error(); } }, true), 'failed');
+  assert.equal(await syncAuthenticator(valid(), { signalAllAcceptedCredentials() { assert.fail('insecure context'); } }, false), 'unsupported');
+});
