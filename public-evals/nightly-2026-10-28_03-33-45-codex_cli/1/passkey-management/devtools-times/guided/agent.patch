+
+export const POST: APIRoute = async ({ request, session, redirect }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  await session?.destroy();
+  return redirect(`${import.meta.env.BASE_URL}signin`, 303);
+};
