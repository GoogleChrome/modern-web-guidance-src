@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import { isCredentialId, publicAccount, relyingPartyId, updateAccount } from '../../../server/accounts';
+import { json, sameOrigin, signedInUsername } from '../../../server/account-http';
+
+export const GET: APIRoute = async (context) => {
+  const username = await signedInUsername(context);
+  if (!username) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  try {
+    return json(await updateAccount(username, account => publicAccount(account, relyingPartyId(context.url))));
+  } catch {
+    return json({ error: 'Unable to load passkeys. Please try again.' }, 500);
+  }
+};
+
+const mutate: APIRoute = async (context) => {
+  if (!sameOrigin(context.request)) return json({ error: 'Invalid request origin.' }, 403);
+  const username = await signedInUsername(context);
+  if (!username) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  let input;
+  try {
+    input = await context.request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!input || !isCredentialId(input.id)) return json({ error: 'Invalid passkey ID.' }, 400);
+  const name = typeof input.name === 'string' ? input.name.trim() : '';
+  if (context.request.method === 'PUT' && (!name || name.length > 80)) {
+    return json({ error: 'Use a name between 1 and 80 characters.' }, 400);
+  }
+  try {
+    const result = await updateAccount(username, account => {
+      const key = account.passkeys.find(key => key.id === input.id);
+      if (!key) return null;
+      if (context.request.method === 'DELETE') {
+        account.passkeys = account.passkeys.filter(key => key.id !== input.id);
+      } else {
+        key.name = name;
+      }
+      // Return the complete authoritative list, including when the last key is
+      // removed. The client must never signal a filtered or stale local list.
+      return publicAccount(account, relyingPartyId(context.url));
+    });
+    return result ? json(result) : json({ error: 'Passkey not found. Refresh the list and try again.' }, 404);
+  } catch {
+    return json({ error: 'Unable to save changes. Please try again.' }, 500);
+  }
+};
+
+export const PUT = mutate;
+export const DELETE = mutate;
