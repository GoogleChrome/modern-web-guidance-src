diff --git a/src/utils/passkey-sync.ts b/src/utils/passkey-sync.ts
new file mode 100644
index 0000000..d4b2645
--- /dev/null
+++ b/src/utils/passkey-sync.ts
@@ -0,0 +1,46 @@
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  aaguid?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface PasskeyAccount {
+  username: string;
+  userId: string;
+  rpId: string;
+  passkeys: PasskeySummary[];
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+};
+
+export async function syncPasskeys(account: PasskeyAccount): Promise<string> {
+  const api = typeof window.PublicKeyCredential === 'undefined'
+    ? undefined : window.PublicKeyCredential as typeof PublicKeyCredential & SignalAPI;
+  if (!window.isSecureContext || !api?.signalAllAcceptedCredentials) {
+    return 'Your browser cannot update your password manager automatically. Remove deleted passkeys from your password manager manually.';
+  }
+  // IDs come from the server's complete list and are already Base64URL. Never
+  // encode them again or signal an empty list as a fallback for a failed fetch.
+  const validId = (id: string) => /^[A-Za-z0-9_-]+$/.test(id) && id.length % 4 !== 1;
+  if (!validId(account.userId) || account.passkeys.some(key => !validId(key.id))) {
+    return 'Your changes are saved, but the browser could not be notified. Update your password manager manually.';
+  }
+  try {
+    await api.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.userId,
+      allAcceptedCredentialIds: account.passkeys.map(key => key.id),
+    });
+    return 'Your browser has been notified of your current passkeys. Your password manager controls when it applies updates.';
+  } catch {
+    return 'Your changes are saved, but your password manager could not be updated. Try refreshing the list, or remove deleted passkeys from your password manager manually.';
+  }
+}
