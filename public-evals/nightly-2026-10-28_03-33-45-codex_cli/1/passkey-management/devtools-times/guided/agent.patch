+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,194 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { syncPasskeys, type PasskeyAccount, type PasskeySummary } from '../utils/passkey-sync';
+import providers from '../utils/passkey-providers.json';
+
+const endpoint = `${import.meta.env.BASE_URL}api/account/passkeys`;
+const button = 'rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-wait';
+const primary = `${button} bg-gray-900 text-white hover:bg-gray-700`;
+
+function date(timestamp?: number) {
+  return timestamp && Number.isFinite(timestamp)
+    ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(timestamp)
+    : 'Not available';
+}
+
+function PasskeyRow({ passkey, busy, lastKey, onChange }: {
+  passkey: PasskeySummary;
+  busy: boolean;
+  lastKey: boolean;
+  onChange: (method: 'PUT' | 'DELETE', id: string, name?: string) => Promise<boolean>;
+}) {
+  const [mode, setMode] = useState<'view' | 'rename' | 'remove'>('view');
+  const [name, setName] = useState(passkey.name);
+  const renameButton = useRef<HTMLButtonElement>(null);
+  const removeButton = useRef<HTMLButtonElement>(null);
+  const returnFocus = useRef<'rename' | 'remove' | null>(null);
+  useEffect(() => {
+    if (mode === 'view' && returnFocus.current) {
+      (returnFocus.current === 'rename' ? renameButton : removeButton).current?.focus();
+      returnFocus.current = null;
+    }
+  }, [mode]);
+  const provider = passkey.aaguid && passkey.aaguid !== '00000000-0000-0000-0000-000000000000'
+    ? (providers as Record<string, { name: string; icon?: string }>)[passkey.aaguid.toLowerCase()] : undefined;
+  const label = passkey.name || provider?.name || 'Passkey';
+
+  function cancel() {
+    returnFocus.current = mode === 'rename' ? 'rename' : 'remove';
+    setMode('view');
+  }
+
+  return (
+    <li className="py-6">
+      <div className="flex gap-4">
+        <div className="flex size-11 shrink-0 items-center justify-center rounded-full bg-gray-100">
+          {provider?.icon ? <img src={provider.icon} alt="" className="size-6" /> : <KeyIcon className="size-6 text-gray-600" aria-hidden="true" />}
+        </div>
+        <div className="min-w-0 flex-1">
+          <div className="flex flex-wrap items-start justify-between gap-3">
+            <div>
+              <h3 className="break-words font-semibold text-gray-900">{label}</h3>
+              <p className="mt-1 text-sm text-gray-500">{provider?.name || 'Unknown passkey provider'}</p>
+            </div>
+            <div className="flex gap-2">
+              <button ref={renameButton} className={button} disabled={busy || mode !== 'view'} aria-label={`Rename ${label}`} onClick={() => { setName(passkey.name); setMode('rename'); }}>
+                <PencilSquareIcon className="mr-1.5 inline size-4" aria-hidden="true" />Rename
+              </button>
+              <button ref={removeButton} className={`${button} text-red-700`} disabled={busy || mode !== 'view'} aria-label={`Remove ${label}`} onClick={() => setMode('remove')}>
+                <TrashIcon className="mr-1.5 inline size-4" aria-hidden="true" />Remove
+              </button>
+            </div>
+          </div>
+          <dl className="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-500">
+            <div><dt className="inline">Added </dt><dd className="inline">{date(passkey.registeredAt)}</dd></div>
+            <div><dt className="inline">Last used </dt><dd className="inline">{passkey.lastUsedAt ? date(passkey.lastUsedAt) : 'Never'}</dd></div>
+          </dl>
+          {mode === 'rename' && (
+            <form className="mt-4 rounded-lg bg-gray-50 p-4" onSubmit={async event => {
+              event.preventDefault();
+              if (await onChange('PUT', passkey.id, name.trim())) cancel();
+            }}>
+              <label className="block text-sm font-medium">Passkey display name
+                <input autoFocus required maxLength={80} value={name} disabled={busy} onChange={event => setName(event.target.value)} className="mt-2 block w-full rounded border border-gray-300 bg-white px-3 py-2 focus-visible:outline-2 focus-visible:outline-gray-900" />
+              </label>
+              <p className="mt-2 text-xs text-gray-500">This name helps you identify the passkey here. It does not rename your account or the entry in your password manager.</p>
+              <div className="mt-3 flex gap-2">
+                <button type="submit" className={primary} disabled={busy || !name.trim()}>{busy ? 'Saving…' : 'Save name'}</button>
+                <button type="button" className={button} disabled={busy} onClick={cancel}>Cancel</button>
+              </div>
+            </form>
+          )}
+          {mode === 'remove' && (
+            <div className="mt-4 rounded-lg border border-red-200 bg-red-50 p-4">
+              <p className="text-sm font-semibold text-gray-900">Remove “{label}”?</p>
+              <p className="mt-2 text-sm text-gray-700">You won’t be able to use this passkey to sign in again.{lastKey ? ' This is your last passkey. You can still sign in with your username and password.' : ''}</p>
+              <div className="mt-3 flex flex-wrap gap-2">
+                <button className={`${button} border-red-700 bg-red-700 text-white hover:bg-red-800`} disabled={busy} onClick={() => void onChange('DELETE', passkey.id)}>{busy ? 'Removing…' : 'Remove passkey'}</button>
+                <button autoFocus className={button} disabled={busy} onClick={cancel}>Keep passkey</button>
+              </div>
+            </div>
+          )}
+        </div>
+      </div>
+    </li>
+  );
+}
+
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<PasskeyAccount | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [syncMessage, setSyncMessage] = useState('');
+  const [signedOut, setSignedOut] = useState(false);
+  const heading = useRef<HTMLHeadingElement>(null);
+
+  async function readResponse(response: Response): Promise<PasskeyAccount> {
+    if (response.status === 401) {
+      setSignedOut(true);
+      setAccount(null);
+      throw new Error('Your session has expired. Sign in again to manage your passkeys.');
+    }
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Unable to save changes. Try again.');
+    if (!Array.isArray(data.passkeys) || !data.userId || !data.rpId) throw new Error('Unable to load your passkeys. Try again.');
+    return data;
+  }
+
+  async function load(signal?: AbortSignal) {
+    setLoading(true);
+    setError('');
+    setMessage('');
+    setSyncMessage('');
+    try {
+      const data = await readResponse(await fetch(endpoint, { cache: 'no-store', signal }));
+      if (signal?.aborted) return;
+      setAccount(data);
+      setSignedOut(false);
+      setSyncMessage(await syncPasskeys(data));
+    } catch (error) {
+      if (!signal?.aborted) setError(error instanceof Error ? error.message : 'Unable to load passkeys. Please try again.');
+    } finally {
+      if (!signal?.aborted) setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    const controller = new AbortController();
+    void load(controller.signal);
+    return () => controller.abort();
+  }, []);
+
+  async function change(method: 'PUT' | 'DELETE', id: string, name?: string) {
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      const data = await readResponse(await fetch(endpoint, {
+        method,
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ id, name }),
+      }));
+      setAccount(data);
+      setMessage(method === 'DELETE' ? 'Passkey removed.' : 'Passkey name updated.');
+      if (method === 'DELETE') {
+        heading.current?.focus();
+        setSyncMessage(await syncPasskeys(data));
+      }
+      return true;
+    } catch (error) {
+      setError(error instanceof Error ? error.message : 'Unable to save changes. Please try again.');
+      return false;
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section aria-labelledby="passkeys-heading" aria-busy={loading || busy}>
+      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-5">
+        <div className="flex items-center gap-3">
+          <KeyIcon className="size-6 text-gray-700" aria-hidden="true" />
+          <h2 id="passkeys-heading" ref={heading} tabIndex={-1} className="text-xl font-bold focus-visible:outline-2">Your passkeys{account ? ` (${account.passkeys.length})` : ''}</h2>
+        </div>
+        <button className={button} disabled={loading || busy || signedOut} onClick={() => void load()}>Refresh list</button>
+      </div>
+      <p className="mt-5 text-sm leading-6 text-gray-600">Passkeys let you sign in with your fingerprint, face, or device lock. Give each one a recognizable name and remove any you no longer use.</p>
+      {error && <p role="alert" className="mt-5 rounded border border-red-200 bg-red-50 p-4 text-sm text-red-800">{error} {signedOut && <a href={`${import.meta.env.BASE_URL}signin`} className="font-semibold underline">Sign in</a>}</p>}
+      <p role="status" className="mt-4 text-sm text-green-800">{message}</p>
+      {loading ? <p role="status" className="py-8 text-sm text-gray-500">Loading your passkeys…</p> : account && (
+        account.passkeys.length ? <ul className="divide-y divide-gray-200">{account.passkeys.map(passkey => <PasskeyRow key={passkey.id} passkey={passkey} busy={busy} lastKey={account.passkeys.length === 1} onChange={change} />)}</ul> : (
+          <div className="my-6 rounded-lg border border-dashed border-gray-300 px-6 py-10 text-center">
+            <KeyIcon className="mx-auto mb-3 size-8 text-gray-400" aria-hidden="true" />
+            <h3 className="font-semibold">No passkeys registered</h3>
+            <p className="mt-2 text-sm text-gray-500">You can continue signing in with your username and password.</p>
+          </div>
+        )
+      )}
+      {syncMessage && <p role="status" className="mt-4 rounded-lg bg-gray-50 p-4 text-xs leading-5 text-gray-600">{syncMessage}</p>}
+      <p className="mt-6 border-t border-gray-200 pt-5 text-xs leading-5 text-gray-500">Removing a passkey revokes its access to The DevTools Times. Your browser will be notified when supported; other devices or password managers may need a manual update.</p>
+    </section>
+  );
+}
