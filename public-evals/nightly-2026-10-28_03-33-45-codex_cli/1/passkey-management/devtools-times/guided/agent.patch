+import type { APIContext } from 'astro';
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
+
+export async function signedInUsername(context: Pick<APIContext, 'session'>): Promise<string | undefined> {
+  const reader = await context.session?.get('reader') as { username: string; expiresAt: number } | undefined;
+  return reader && reader.expiresAt > Date.now() ? reader.username : undefined;
+}
diff --git a/src/server/accounts.ts b/src/server/accounts.ts
new file mode 100644
index 0000000..0136548
--- /dev/null
+++ b/src/server/accounts.ts
@@ -0,0 +1,69 @@
+import { createHash, randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+export interface Passkey {
+  id: string;
+  name: string;
+  aaguid?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+// Registration and authentication must use this same record, so deleting a key
+// revokes it as well as removing it from the management list.
+export interface StoredPasskey extends Passkey {
+  publicKey: string;
+  counter: number;
+}
+
+export interface Account {
+  userId: string;
+  username: string;
+  passkeys: StoredPasskey[];
+}
+
+const directory = process.env.ACCOUNT_DATA_DIR || join(process.cwd(), '.data', 'accounts');
+const pending = new Map<string, Promise<unknown>>();
+export const relyingPartyId = (url: URL) => process.env.PASSKEY_RP_ID || url.hostname;
+export const isCredentialId = (value: unknown): value is string =>
+  typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value) && value.length % 4 !== 1;
+
+// Serialize writes per account and atomically replace files. This repository is
+// intended for a single Node instance with a persistent volume (see README).
+export async function updateAccount<T>(username: string, operation: (account: Account) => T): Promise<T> {
+  const key = createHash('sha256').update(username).digest('hex');
+  const previous = pending.get(key) || Promise.resolve();
+  const task = previous.catch(() => {}).then(async () => {
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const path = join(directory, `${key}.json`);
+    let account: Account;
+    try {
+      account = JSON.parse(await readFile(path, 'utf8'));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      account = { username, userId: randomBytes(32).toString('base64url'), passkeys: [] };
+    }
+    const result = operation(account);
+    const temporary = `${path}.${randomBytes(8).toString('hex')}.tmp`;
+    await writeFile(temporary, JSON.stringify(account), { mode: 0o600 });
+    await rename(temporary, path);
+    return result;
+  });
+  pending.set(key, task);
+  try {
+    return await task;
+  } finally {
+    if (pending.get(key) === task) pending.delete(key);
+  }
+}
+
+export function publicAccount(account: Account, rpId: string) {
+  return {
+    userId: account.userId,
+    username: account.username,
+    rpId,
+    passkeys: account.passkeys.map(({ id, name, aaguid, registeredAt, lastUsedAt }) =>
+      ({ id, name, aaguid, registeredAt, lastUsedAt })),
+  };
+}
