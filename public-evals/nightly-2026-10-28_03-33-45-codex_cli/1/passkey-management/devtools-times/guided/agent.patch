index 0000000..78d9185
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,31 @@
+import type { APIRoute } from 'astro';
+import { json, sameOrigin } from '../../../server/account-http';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sign-in is temporarily unavailable.' }, 503);
+  try {
+    const { username, password } = await request.json();
+    if (typeof username !== 'string' || !username.trim() || username.length > 200 ||
+        typeof password !== 'string' || !password || password.length > 1024) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, 401);
+    // Do not persist the reader's password or expose upstream tokens to scripts.
+    const result = await response.json();
+    if (result.error || result.success === false) return json({ error: 'Unable to sign in.' }, 401);
+    const canonicalUsername = result.user?.username || result.username || username;
+    if (typeof canonicalUsername !== 'string') return json({ error: 'Invalid sign-in response.' }, 502);
+    await session.regenerate();
+    session.set('reader', { username: canonicalUsername, expiresAt: Date.now() + 86400000 }, { ttl: 86400 });
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to sign in right now. Please try again.' }, 502);
+  }
+};
