+import type { APIRoute } from 'astro';
+import { json, sameOrigin } from '../../../lib/account-server.ts';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Request origin is not allowed.' }, 403);
+  await session?.destroy();
+  return json({ success: true });
+};
diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..06a0aa9
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,123 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { isPasskeyAccount, syncAuthenticator, type PasskeyAccount } from '../src/lib/passkeys.ts';
+import { GET, PATCH, DELETE } from '../src/pages/api/account/passkeys.ts';
+import { POST as login } from '../src/pages/api/auth/login.ts';
+import { POST as logout } from '../src/pages/api/auth/logout.ts';
+
+const snapshot: PasskeyAccount = {
+  complete: true,
+  rpId: 'example.com',
+  user: { id: 'dXNlcg', name: 'reader', displayName: 'Reader' },
+  passkeys: [{ id: 'a2V5', displayName: 'Laptop', createdAt: '2026-01-01T00:00:00Z', lastUsedAt: null }],
+};
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  Reflect.deleteProperty(globalThis, 'PublicKeyCredential');
+  Reflect.deleteProperty(globalThis, 'isSecureContext');
+});
+const context = (method: string, body?: object, token: string | null = 'secret-token', origin = 'https://example.com') => ({
+  request: new Request('https://example.com/devtools-times/api/account/passkeys', {
+    method, headers: { Origin: origin, 'Content-Type': 'application/json' },
+    body: body ? JSON.stringify(body) : undefined,
+  }),
+  session: { get: async () => token, delete: async () => {}, regenerate: async () => {}, set: async () => {}, destroy: async () => {} },
+} as any);
+function signals(api: object) {
+  Object.defineProperty(globalThis, 'isSecureContext', { configurable: true, value: true });
+  Object.defineProperty(globalThis, 'PublicKeyCredential', { configurable: true, value: api });
+}
+
+test('snapshot validation rejects missing completeness, invalid IDs and duplicate keys', () => {
+  assert.equal(isPasskeyAccount(snapshot), true);
+  assert.equal(isPasskeyAccount({ ...snapshot, complete: undefined }), false);
+  assert.equal(isPasskeyAccount({ ...snapshot, passkeys: [...snapshot.passkeys, ...snapshot.passkeys] }), false);
+  assert.equal(isPasskeyAccount({ ...snapshot, user: { ...snapshot.user, id: 'not base64!' } }), false);
+  assert.equal(isPasskeyAccount({ ...snapshot, passkeys: undefined }), false);
+});
+
+test('sync sends the authoritative credential list and account identity, not a key nickname', async () => {
+  const calls: object[] = [];
+  signals({ signalAllAcceptedCredentials: async (value: object) => calls.push(value), signalCurrentUserDetails: async (value: object) => calls.push(value) });
+  assert.equal(await syncAuthenticator(snapshot), 'sent');
+  assert.deepEqual(calls, [
+    { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] },
+    { rpId: 'example.com', userId: 'dXNlcg', name: 'reader', displayName: 'Reader' },
+  ]);
+});
+
+test('removing the last key can signal an authoritative empty list', async () => {
+  let ids;
+  signals({ signalAllAcceptedCredentials: async (value: any) => { ids = value.allAcceptedCredentialIds; } });
+  assert.equal(await syncAuthenticator({ ...snapshot, passkeys: [] }), 'sent');
+  assert.deepEqual(ids, []);
+});
+
+test('unsupported browsers and rejected signals do not fail account changes', async () => {
+  assert.equal(await syncAuthenticator(snapshot), 'unsupported');
+  signals({ signalAllAcceptedCredentials: async () => { throw new Error('Provider unavailable'); } });
+  assert.equal(await syncAuthenticator(snapshot), 'failed');
+});
+
+test('signed-out requests never call the upstream service', async () => {
+  globalThis.fetch = async () => { throw new Error('Unexpected upstream call'); };
+  assert.equal((await GET(context('GET', undefined, null))).status, 401);
+});
+
+test('account mutations reject cross-origin requests before calling upstream', async () => {
+  globalThis.fetch = async () => { throw new Error('Unexpected upstream call'); };
+  assert.equal((await DELETE(context('DELETE', { id: 'a2V5' }, 'token', 'https://evil.example'))).status, 403);
+  assert.equal((await login(context('POST', {}, 'token', 'https://evil.example'))).status, 403);
+  assert.equal((await logout(context('POST', {}, 'token', 'https://evil.example'))).status, 403);
+});
+
+test('rename trims names and forwards only the server session token', async () => {
+  globalThis.fetch = async (url, init) => {
+    assert.ok(String(url).endsWith('/passkeys/a2V5'));
+    assert.equal(init?.method, 'PATCH');
+    assert.equal(new Headers(init?.headers).get('Authorization'), 'Bearer secret-token');
+    assert.deepEqual(JSON.parse(init?.body as string), { displayName: 'My laptop' });
+    return Response.json(snapshot);
+  };
+  assert.equal((await PATCH(context('PATCH', { id: 'a2V5', displayName: '  My laptop  ' }))).status, 200);
+});
+
+test('blank and overlong display names are rejected before calling upstream', async () => {
+  globalThis.fetch = async () => { throw new Error('Unexpected upstream call'); };
+  assert.equal((await PATCH(context('PATCH', { id: 'a2V5', displayName: '  ' }))).status, 400);
+  assert.equal((await PATCH(context('PATCH', { id: 'a2V5', displayName: 'a'.repeat(65) }))).status, 400);
+});
+
+test('invalid or partial service snapshots are never returned for browser signaling', async () => {
+  globalThis.fetch = async () => Response.json({ ...snapshot, complete: false });
+  assert.equal((await GET(context('GET'))).status, 502);
+});
+
+test('expired upstream sessions clear the account token', async () => {
+  globalThis.fetch = async () => new Response(null, { status: 401 });
+  const ctx = context('GET');
+  let removed = '';
+  ctx.session.delete = async (key: string) => { removed = key; };
+  assert.equal((await GET(ctx)).status, 401);
+  assert.equal(removed, 'accountToken');
+});
+
+test('removal returns the server snapshot and respects last-method protection', async () => {
+  globalThis.fetch = async () => Response.json({ ...snapshot, passkeys: [] });
+  const response = await DELETE(context('DELETE', { id: 'a2V5' }));
+  assert.deepEqual((await response.json()).passkeys, []);
+  globalThis.fetch = async () => new Response(null, { status: 409 });
+  assert.equal((await DELETE(context('DELETE', { id: 'a2V5' }))).status, 409);
+});
+
+test('login rotates the session and keeps the service token out of the response', async () => {
+  globalThis.fetch = async () => Response.json({ token: 'private-token' });
+  const ctx = context('POST', { username: 'reader', password: 'password' });
+  const calls: unknown[] = [];
+  ctx.session.regenerate = async () => { calls.push('rotate'); };
+  ctx.session.set = async (key: string, value: string) => { calls.push([key, value]); };
+  const response = await login(ctx);
+  assert.deepEqual(calls, ['rotate', ['accountToken', 'private-token']]);
+  assert.deepEqual(await response.json(), { success: true });
+});
