+---
+import Layout from '../layouts/Layout.astro';
+import PasskeySettings from '../components/PasskeySettings';
+Astro.response.headers.set('Cache-Control', 'no-store');
+const signedIn = Boolean(await Astro.session?.get('accountToken'));
+---
+<Layout title="Account settings | The DevTools Times">
+  <div class="px-5 py-10 sm:px-10 lg:px-14 lg:py-12">
+    <nav aria-label="Breadcrumb" class="mb-7 flex items-center gap-2 text-xs text-stone-500"><a href={import.meta.env.BASE_URL} class="hover:text-stone-900">Home</a><span aria-hidden="true">/</span><span class="text-stone-800">Account settings</span></nav>
+    <div class="border-b-2 border-stone-900 pb-7">
+      <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-stone-500">The DevTools Times · Reader account</p>
