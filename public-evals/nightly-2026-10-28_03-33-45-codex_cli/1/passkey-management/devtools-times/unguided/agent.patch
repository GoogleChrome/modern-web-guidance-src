+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { accountApiUrl, json, sameOrigin } from '../../../lib/account-server.ts';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!session) return json({ error: 'Account sessions are unavailable.' }, 503);
+  let credentials;
+  try { credentials = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof credentials?.username !== 'string' || typeof credentials?.password !== 'string' || !credentials.username || !credentials.password) {
+    return json({ error: 'Enter your username and password.' }, 400);
+  }
+  try {
+    const response = await fetch(`${accountApiUrl}/login`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: credentials.username, password: credentials.password }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: response.status >= 500 ? 'Sign in is temporarily unavailable.' : 'Check your username and password.' }, response.status >= 500 ? 502 : 401);
+    const data = await response.json();
+    if (typeof data.token !== 'string' || !data.token) return json({ error: 'The sign-in service did not return an account session.' }, 502);
+    await session.regenerate();
+    await session.set('accountToken', data.token);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to reach the sign-in service. Please try again.' }, 502);
+  }
+};
