+++ b/src/lib/account-server.ts
@@ -0,0 +1,13 @@
+export const accountApiUrl = (import.meta.env?.TIMES_API_URL || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api').replace(/\/$/, '');
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+// Global origin checking is disabled in this sample app; enforce it for account changes.
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..2f5e9ba
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,53 @@
+/** Complete, authoritative snapshot; never populate this from browser storage. */
+export interface PasskeyAccount {
+  complete: true;
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: {
+    id: string;
+    displayName: string;
+    createdAt: string;
+    lastUsedAt: string | null;
+  }[];
+}
+
+export function isPasskeyAccount(value: unknown): value is PasskeyAccount {
+  if (!value || typeof value !== 'object') return false;
+  const data = value as PasskeyAccount;
+  const base64url = /^[A-Za-z0-9_-]+$/;
+  return data.complete === true && typeof data.rpId === 'string' && data.rpId.length > 0 &&
+    !!data.user && typeof data.user.id === 'string' && base64url.test(data.user.id) &&
+    typeof data.user.name === 'string' && typeof data.user.displayName === 'string' &&
+    Array.isArray(data.passkeys) && data.passkeys.every(key =>
+      !!key && typeof key.id === 'string' && base64url.test(key.id) &&
+      typeof key.displayName === 'string' && typeof key.createdAt === 'string' &&
+      Number.isFinite(Date.parse(key.createdAt)) &&
+      (key.lastUsedAt === null || (typeof key.lastUsedAt === 'string' && Number.isFinite(Date.parse(key.lastUsedAt))))) &&
+    new Set(data.passkeys.map(key => key.id)).size === data.passkeys.length;
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+/** Signals are best effort: resolution does not confirm a provider changed its storage. */
+export async function syncAuthenticator(account: PasskeyAccount): Promise<'sent' | 'unsupported' | 'failed'> {
+  if (!globalThis.isSecureContext || typeof PublicKeyCredential === 'undefined') return 'unsupported';
+  const api = PublicKeyCredential as unknown as SignalAPI;
+  if (!api.signalAllAcceptedCredentials) return 'unsupported';
+  try {
+    await api.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.user.id,
+      allAcceptedCredentialIds: account.passkeys.map(key => key.id),
+    });
+    // This is account identity, not the site's nickname for an individual key.
+    if (api.signalCurrentUserDetails) {
+      await api.signalCurrentUserDetails({ rpId: account.rpId, userId: account.user.id, name: account.user.name, displayName: account.user.displayName });
+    }
+    return 'sent';
+  } catch {
+    return 'failed';
+  }
+}
