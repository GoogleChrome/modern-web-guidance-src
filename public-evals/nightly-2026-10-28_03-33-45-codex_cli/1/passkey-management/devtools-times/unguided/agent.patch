new file mode 100644
index 0000000..4d63fd6
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,45 @@
+import type { APIRoute } from 'astro';
+import { accountApiUrl, json, sameOrigin } from '../../../lib/account-server.ts';
+import { isPasskeyAccount } from '../../../lib/passkeys.ts';
+
+const handle: APIRoute = async ({ request, session }) => {
+  if (request.method !== 'GET' && !sameOrigin(request)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const token = await session?.get('accountToken');
+  if (typeof token !== 'string' || !token) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+
+  let path = '/passkeys';
+  let body: string | undefined;
+  if (request.method !== 'GET') {
+    let input;
+    try { input = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+    if (typeof input?.id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(input.id) || input.id.length > 2048) return json({ error: 'Invalid passkey.' }, 400);
+    path += `/${encodeURIComponent(input.id)}`;
+    if (request.method === 'PATCH') {
+      if (typeof input.displayName !== 'string' || !input.displayName.trim() || input.displayName.trim().length > 64) return json({ error: 'Use a name between 1 and 64 characters.' }, 400);
+      body = JSON.stringify({ displayName: input.displayName.trim() });
+    }
+  }
+  try {
+    const response = await fetch(`${accountApiUrl}${path}`, {
+      method: request.method,
+      headers: { Authorization: `Bearer ${token}`, ...(body ? { 'Content-Type': 'application/json' } : {}) },
+      body, signal: AbortSignal.timeout(15000), cache: 'no-store',
+    });
+    if (response.status === 401) {
+      await session?.delete('accountToken');
+      return json({ error: 'Your session has expired. Please sign in again.' }, 401);
+    }
+    if (response.status === 403) return json({ error: 'You do not have permission to manage this passkey.' }, 403);
+    if (!response.ok) return json({ error: response.status === 409 ? 'This passkey cannot be removed. Keep another sign-in method available.' : 'The passkey service is unavailable. Please try again.' }, response.status === 409 ? 409 : 502);
+    // Mutations also return a complete snapshot, so no incomplete list is ever signaled.
+    const data = await response.json();
+    if (!isPasskeyAccount(data)) throw new Error('Invalid account snapshot');
+    return json(data);
+  } catch {
+    return json({ error: request.method === 'GET' ? 'Unable to load your passkeys. Please try again.' : 'We could not confirm the change. Refresh your passkeys before trying again.' }, 502);
+  }
+};
+
+export const GET = handle;
+export const PATCH = handle;
+export const DELETE = handle;
