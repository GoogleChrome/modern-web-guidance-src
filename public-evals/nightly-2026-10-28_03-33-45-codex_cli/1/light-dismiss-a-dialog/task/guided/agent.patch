+  <script>
+    const logoutDialog = document.getElementById('logout-dialog');
+    const logoutTrigger = document.querySelector('.test-dialog-trigger');
+
+    logoutTrigger.addEventListener('click', () => logoutDialog.showModal());
+
+    logoutDialog.addEventListener('close', () => {
+      const confirmed = logoutDialog.returnValue === 'logout';
+      logoutDialog.returnValue = '';
+      if (confirmed) window.location.assign('/logout');
+    });
+
+    // Keep backdrop dismissal available where closedby is not supported.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      logoutDialog.addEventListener('click', (event) => {
+        if (event.target !== logoutDialog) return;
+        const rect = logoutDialog.getBoundingClientRect();
+        const outside = event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+        if (outside) logoutDialog.close();
+      });
+    }
+  </script>
