+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('coffee-form');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const confirmation = document.getElementById('coffee-confirmation');
+      const ctx = canvas.getContext('2d');
+      let nativeHTML = Boolean(ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function');
+      let width = 0;
+      let height = 0;
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        canvas.removeAttribute('content');
+        canvas.setAttribute('aria-hidden', 'true');
+        stage.append(form);
+        stage.style.removeProperty('height');
+        form.style.removeProperty('width');
+      }
+
+      if (nativeHTML) {
+        canvas.append(form);
+      } else {
+        useOverlay();
+      }
+
+      function draw() {
+        if (!ctx || !width || !height) return;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        // All drawing coordinates use CSS pixels; the backing store uses device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+
+        ctx.fillStyle = '#e2d3c5';
+        ctx.beginPath();
+        ctx.ellipse(width * .49, height - 35, width * .44, 18, 0, 0, Math.PI * 2);
+        ctx.fill();
+        // Handle, then cup body so the handle joins sit behind the ceramic.
+        ctx.strokeStyle = '#c9ae96';
+        ctx.lineWidth = 18;
+        ctx.beginPath();
+        ctx.ellipse(width * .86, height * .47, width * .105, height * .14, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        const body = ctx.createLinearGradient(width * .07, 0, width * .9, 0);
+        body.addColorStop(0, '#e7d5c0');
+        body.addColorStop(.25, '#fffaf3');
+        body.addColorStop(.75, '#fffaf3');
+        body.addColorStop(1, '#dec6ae');
+        ctx.fillStyle = body;
+        ctx.beginPath();
+        ctx.moveTo(width * .07, 92);
+        ctx.lineTo(width * .9, 92);
+        ctx.lineTo(width * .85, height - 75);
+        ctx.quadraticCurveTo(width * .85, height - 40, width * .48, height - 40);
+        ctx.quadraticCurveTo(width * .12, height - 40, width * .12, height - 75);
+        ctx.closePath();
+        ctx.fill();
+        ctx.lineWidth = 3;
+        ctx.stroke();
+        ctx.fillStyle = '#c9ae96';
+        ctx.beginPath();
+        ctx.ellipse(width * .485, 92, width * .415, 25, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = { oat: '#bb8a5a', whole: '#c69b70', almond: '#b18051', none: '#563426' }[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(width * .485, 90, width * .39, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        if (nativeHTML) {
+          try {
+            // This 2D call also synchronizes hit testing, selection and accessibility bounds.
+            ctx.drawElementImage(form, width * .14, 120);
+          } catch (error) {
+            // Preserve the same live controls if a partial implementation cannot draw them.
+            useOverlay();
+            resize();
+          }
+        }
+      }
+
+      function requestDraw() {
+        if (nativeHTML) canvas.requestPaint();
+        else draw();
+      }
+
+      function resize(entry) {
+        if (!ctx) return;
+        if (nativeHTML) {
+          form.style.width = `${stage.clientWidth * .68}px`;
+          stage.style.height = `${form.offsetHeight + 210}px`;
+        }
+        const rect = canvas.getBoundingClientRect();
+        width = rect.width;
+        height = rect.height;
+        const pixels = entry?.target === canvas && entry.devicePixelContentBoxSize?.[0];
+        const ratio = window.devicePixelRatio || 1;
+        const pixelWidth = Math.max(1, pixels?.inlineSize || Math.round(width * ratio));
+        const pixelHeight = Math.max(1, pixels?.blockSize || Math.round(height * ratio));
+        if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
+        if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
+        requestDraw();
+      }
+
+      if (nativeHTML) canvas.onpaint = draw;
+      if (typeof ResizeObserver !== 'undefined') {
+        const observer = new ResizeObserver(entries => {
+          resize(entries.find(entry => entry.target === canvas));
+        });
+        observer.observe(form);
+        const deviceBox = typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        try {
+          observer.observe(canvas, deviceBox ? { box: 'device-pixel-content-box' } : {});
+        } catch (error) {
+          observer.observe(canvas);
+        }
+      }
+      // Re-arm the query whenever zooming or moving between displays changes pixel density.
+      let densityQuery;
+      function watchDensity() {
+        densityQuery?.removeEventListener('change', watchDensity);
+        densityQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        densityQuery.addEventListener('change', watchDensity);
+        resize();
+      }
+      window.addEventListener('resize', () => resize());
+      watchDensity();
+
+      form.addEventListener('input', () => {
+        document.getElementById('milk-summary').textContent = milk.selectedOptions[0].textContent;
+        document.getElementById('syrup-summary').textContent = syrup.selectedOptions[0].textContent;
+        confirmation.replaceChildren();
+        requestDraw();
+      });
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const name = document.getElementById('coffee-name').value.trim();
+        // Keep message text in the DOM so the browser can translate and search it.
+        confirmation.replaceChildren();
+        const message = document.createElement('span');
+        message.textContent = 'Cup customized';
+        confirmation.append(message, name ? `, ${name}!` : '!');
+        resize();
+      });
+      // Printed output uses the live form even on browsers with native canvas HTML.
+      let restoreNativeAfterPrint = false;
