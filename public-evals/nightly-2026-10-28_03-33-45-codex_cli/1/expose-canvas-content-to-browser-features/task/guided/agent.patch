+        restoreNativeAfterPrint = nativeHTML;
+        if (nativeHTML) useOverlay();
+      });
+      window.addEventListener('afterprint', () => {
+        if (restoreNativeAfterPrint) {
+          nativeHTML = true;
+          canvas.removeAttribute('aria-hidden');
+          canvas.setAttribute('content', 'drawable');
+          canvas.append(form);
+          canvas.onpaint = draw;
+          resize();
+        }
+      });
+    })();
+  </script>
