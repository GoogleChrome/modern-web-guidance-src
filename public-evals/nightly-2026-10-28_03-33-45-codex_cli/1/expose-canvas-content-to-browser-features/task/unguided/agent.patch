+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.querySelector('.coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = form.querySelector('.coffee-summary');
+      const ctx = canvas.getContext('2d');
+      // A single form is used in both modes, with its native keyboard behavior intact.
+      let nativeHTML = Boolean(ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function');
+      const inset = 48;
+      const formTop = 140;
+      let frame;
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        canvas.removeAttribute('content');
+        canvas.setAttribute('aria-hidden', 'true');
+        stage.append(form);
+      }
+
+      if (nativeHTML) {
+        canvas.append(form);
+      } else {
+        useOverlay();
+      }
+
+      function drawCup(width, height) {
+        const center = width / 2;
+        const bottom = height - 30;
+        ctx.clearRect(0, 0, width, height);
+
+        // Saucer, tapered ceramic body, and a coffee-filled rim.
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath();
+        ctx.ellipse(center, bottom + 5, width / 2 - 8, 18, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const glaze = ctx.createLinearGradient(20, 0, width - 20, 0);
+        glaze.addColorStop(0, '#e8d5bd');
+        glaze.addColorStop(0.45, '#fffaf2');
+        glaze.addColorStop(1, '#e8d5bd');
+        ctx.fillStyle = glaze;
+        ctx.strokeStyle = '#927361';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(18, 108);
+        ctx.lineTo(36, bottom - 12);
+        ctx.quadraticCurveTo(center, bottom + 12, width - 36, bottom - 12);
+        ctx.lineTo(width - 18, 108);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = '#fffaf2';
+        ctx.beginPath();
+        ctx.ellipse(center, 108, center - 18, 26, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = { whole: '#b88760', oat: '#c49870', almond: '#be916b', soy: '#b58b68' }[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(center, 108, center - 29, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = { vanilla: '#f5ddb0', maple: '#794522', caramel: '#99541d' }[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(center, 108, (center - 40) * 0.65, 9, 0, 0, Math.PI * 2);
+          ctx.stroke();
+        }
+        ctx.strokeStyle = '#927361';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        for (const offset of [-30, 0, 30]) {
+          ctx.beginPath();
+          ctx.moveTo(center + offset, 65);
+          ctx.bezierCurveTo(center + offset - 14, 50, center + offset + 14, 40, center + offset, 24);
+          ctx.stroke();
+        }
+      }
+
+      function paint() {
+        if (!ctx) return;
+        const { width, height } = stage.getBoundingClientRect();
+        // Keep all drawing coordinates in CSS pixels; only the bitmap uses device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        drawCup(width, height);
+        if (nativeHTML) {
+          try {
+            // This API also synchronizes hit testing, selection, and accessible geometry.
+            ctx.drawElementImage(form, inset, formTop);
+          } catch (error) {
+            // Partial implementations must still leave a usable, visible HTML form.
+            useOverlay();
+            schedule();
+          }
+        }
+      }
+
+      function layout() {
+        frame = null;
+        const width = stage.getBoundingClientRect().width;
+        if (!width) return;
+        form.style.width = `${Math.max(1, width - inset * 2)}px`;
+        const height = Math.ceil(form.getBoundingClientRect().height) + formTop + 80;
+        stage.style.setProperty('--stage-height', `${height}px`);
+        const ratio = window.devicePixelRatio || 1;
+        const pixelWidth = Math.round(width * ratio);
+        const pixelHeight = Math.round(height * ratio);
+        if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
+        if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
+        if (nativeHTML) canvas.requestPaint();
+        else paint();
+      }
+
+      function schedule() {
+        if (!frame) frame = requestAnimationFrame(layout);
+      }
+
+      if (nativeHTML) canvas.onpaint = paint;
+      if (typeof ResizeObserver !== 'undefined') {
+        const observer = new ResizeObserver(schedule);
+        observer.observe(stage);
+        observer.observe(form);
+      }
+      // Translation, focus styles, and validation can change the HTML snapshot.
+      new MutationObserver(schedule).observe(form, {
+        subtree: true, childList: true, characterData: true
+      });
+      for (const event of ['input', 'change', 'focusin', 'focusout', 'invalid']) {
+        form.addEventListener(event, schedule, true);
+      }
+      form.addEventListener('input', () => { summary.hidden = true; });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const name = document.getElementById('coffee-name');
+        if (!name.value.trim()) {
+          name.value = '';
+          name.reportValidity();
+          schedule();
+          return;
+        }
+        document.getElementById('saved-name').textContent = name.value.trim();
+        document.getElementById('saved-milk').textContent = milk.selectedOptions[0].textContent;
+        document.getElementById('saved-syrup').textContent = syrup.selectedOptions[0].textContent;
+        summary.hidden = false;
+        schedule();
+      });
+      window.addEventListener('resize', schedule);
+      // Moving between displays can change pixel density without a CSS resize.
+      function watchDensity() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          schedule();
+          watchDensity();
+        }, { once: true });
+      }
+      watchDensity();
+      if (document.fonts) document.fonts.ready.then(schedule);
+      schedule();
+    })();
+  </script>
