diff --git a/render-worker.js b/render-worker.js
new file mode 100644
index 0000000..d1e9a3f
--- /dev/null
+++ b/render-worker.js
@@ -0,0 +1,21 @@
+import createSmallpt from './assets/smallpt.js';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const module = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    module._initialize(width, height, seed);
+    for (const [index, color] of Object.entries(colors)) {
+      module._set_color(Number(index), ...color);
+    }
+    const started = performance.now();
+    for (let sample = 4; sample <= samples; sample += 4) {
+      module._sample_pass();
+      const pointer = module._pixels();
+      const frame = module.HEAPU8.slice(pointer, pointer + width * height * 4);
+      self.postMessage({ frame: frame.buffer, width, height, sample, elapsed: performance.now() - started, done: sample === samples }, [frame.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || 'The renderer could not start.' });
+  }
+};
