@@ -0,0 +1,46 @@
+// Browser adapter for Kevin Beason's smallpt. Original source and MIT license in vendor/.
+#define main smallpt_original_main
+#include "../vendor/smallpt.cpp"
+#undef main
+#include <vector>
+#include <cstdint>
+
+static int width, height, passes;
+static unsigned int sceneSeed;
+static std::vector<Vec> accumulation;
+static std::vector<unsigned char> framebuffer;
+extern "C" {
+void initialize(int w, int h, unsigned int seed) {
+  width=w; height=h; passes=0; sceneSeed=seed;
+  accumulation.assign(w*h*4, Vec());
+  framebuffer.assign(w*h*4, 0);
+}
+void set_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) spheres[index].c=Vec(r,g,b);
+}
+unsigned char* pixels() { return framebuffer.data(); }
+int sample_pass() {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for(int y=0; y<height; y++) {
+    uint32_t seed=sceneSeed ^ (uint32_t(y+1)*2654435761u) ^ (uint32_t(passes+1)*2246822519u);
+    unsigned short Xi[3]={(unsigned short)seed,(unsigned short)(seed>>16),(unsigned short)(y*y*y+passes*37+1)};
+    for(int x=0; x<width; x++) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for(int sy=0; sy<2; sy++) for(int sx=0; sx<2; sx++) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        Vec &sum=accumulation[i*4+sy*2+sx];
+        sum=sum+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec avg=sum*(1.0/(passes+1));
+        color=color+Vec(clamp(avg.x),clamp(avg.y),clamp(avg.z))*.25;
+      }
+      framebuffer[i*4]=toInt(color.x); framebuffer[i*4+1]=toInt(color.y);
+      framebuffer[i*4+2]=toInt(color.z); framebuffer[i*4+3]=255;
+    }
+  }
+  return ++passes*4;
+}
+}
