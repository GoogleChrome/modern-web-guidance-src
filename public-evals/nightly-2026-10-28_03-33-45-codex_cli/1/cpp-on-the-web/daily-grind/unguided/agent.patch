--- /dev/null
+++ b/scripts/check.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import createSmallpt from '../assets/smallpt.js';
+const wasmBinary = await readFile(new URL('../assets/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(wasmBinary), 'valid WebAssembly binary');
+const module = await createSmallpt({ wasmBinary });
+const width = 48, height = 36;
+function render(seed) {
+  module._initialize(width, height, seed);
+  assert.equal(module._sample_pass(), 4);
+  assert.equal(module._sample_pass(), 8);
+  return module.HEAPU8.slice(module._pixels(), module._pixels() + width * height * 4);
+}
+const baseline = render(12345);
+assert.deepEqual(render(12345), baseline, 'rendering is deterministic for a fixed seed');
+assert(baseline.some((v, i) => i % 4 !== 3 && v > 30), 'scene contains visible light');
+for (let i = 3; i < baseline.length; i += 4) assert.equal(baseline[i], 255, 'opaque pixels');
+module._set_color(0, 0.1, 0.8, 0.2);
+module._set_color(6, 0.1, 0.6, 0.9);
+const randomized = render(12345);
+const changed = randomized.filter((v, i) => v !== baseline[i]).length;
+assert(changed > width * height, 'material colors change a substantial part of the rendered image');
+console.log(`WASM checks passed: deterministic output, progressive samples, RGBA pixels, and ${changed} changed channels after recoloring.`);
