+const $ = (selector) => document.querySelector(selector);
+const canvas = $('#render-canvas');
+const context = canvas.getContext('2d');
+const originalColors = { 0: [0.75, 0.25, 0.25], 1: [0.25, 0.25, 0.75], 6: [0.999, 0.999, 0.999], 7: [0.999, 0.999, 0.999] };
+let colors = structuredClone(originalColors);
+let targetSamples = 64;
+let worker;
+let hasFrame = false;
+let selectedSwatch;
+const poster = new Image();
+poster.onload = () => { if (!hasFrame) context.drawImage(poster, 0, 0, canvas.width, canvas.height); };
+poster.src = 'assets/initial-render.png';
+
+function updatePalette(tag) {
+  document.querySelectorAll('.swatch').forEach(button => {
+    const hex = '#' + colors[button.dataset.index].map(c => Math.round(c * 255).toString(16).padStart(2, '0')).join('');
+    button.style.setProperty('--swatch', hex);
+    button.dataset.color = hex;
+  });
+  $('#palette-tag').textContent = tag;
+}
+function setView(scene) {
+  $('#scene-info').hidden = !scene;
+  $('#render-tab').classList.toggle('selected', !scene);
+  $('#scene-tab').classList.toggle('selected', scene);
+  $('#render-tab').setAttribute('aria-selected', String(!scene));
+  $('#scene-tab').setAttribute('aria-selected', String(scene));
+}
+function render() {
+  worker?.terminate();
+  setView(false);
+  const width = Number($('#resolution').value);
+  const height = width * 3 / 4;
+  $('#render-status').textContent = 'Rendering';
+  $('#render-dot').classList.add('rendering');
+  $('#progress-text').textContent = 'Tracing light…';
+  $('#progress-percent').textContent = '0%';
+  $('#progress-fill').style.width = '0%';
+  $('#sample-count').textContent = '0';
+  $('#elapsed').textContent = '0.0s';
+  $('#resolution-label').textContent = `${width} × ${height}`;
+  const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => showError('Could not load the renderer. Try reloading the page.');
+    worker.onmessage = ({ data }) => {
+      if (data.error) { showError(data.error); return; }
+      hasFrame = true;
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width;
+        canvas.height = data.height;
+      }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.frame), data.width, data.height), 0, 0);
+      const progress = Math.round(data.sample / targetSamples * 100);
+      $('#sample-count').textContent = data.sample;
+      $('#elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+      $('#progress-percent').textContent = `${progress}%`;
+      $('#progress-fill').style.width = `${progress}%`;
+      if (data.done) {
+        $('#render-status').textContent = 'Render complete';
+        $('#render-dot').classList.remove('rendering');
+        $('#progress-text').textContent = 'Every ray found its way.';
+        worker.terminate();
+      }
+    };
+    worker.postMessage({ width, height, samples: targetSamples, seed, colors });
+  } catch (error) { showError(error.message); }
+}
+function showError(message) {
+  $('#render-status').textContent = 'Renderer unavailable';
+  $('#render-dot').classList.remove('rendering');
+  $('#progress-text').textContent = message;
+  $('#progress-percent').textContent = '';
+  worker?.terminate();
+}
+function randomColor() {
+  // Saturated, luminous colors with reflectance below 1 for stable light transport.
+  const hue = Math.random() * 6;
+  const chroma = 0.35 + Math.random() * 0.38;
+  const low = 0.12 + Math.random() * 0.12;
+  const x = chroma * (1 - Math.abs(hue % 2 - 1));
+  const rgb = [[chroma,x,0],[x,chroma,0],[0,chroma,x],[0,x,chroma],[x,0,chroma],[chroma,0,x]][Math.floor(hue)];
+  return rgb.map(v => Math.min(0.94, v + low));
+}
+$('#randomize').addEventListener('click', () => {
+  for (const index of Object.keys(colors)) colors[index] = randomColor();
+  updatePalette('RANDOMIZED');
+  render();
+});
+$('#rerender').addEventListener('click', render);
+$('#reset').addEventListener('click', () => {
+  colors = structuredClone(originalColors);
+  targetSamples = 64;
+  $('#resolution').value = '640';
+  updateQuality();
+  updatePalette('ORIGINAL');
+  render();
+});
+function updateQuality() {
+  document.querySelectorAll('[data-samples]').forEach(button => {
+    const selected = Number(button.dataset.samples) === targetSamples;
+    button.classList.toggle('selected', selected);
+    button.setAttribute('aria-pressed', String(selected));
+  });
+}
+document.querySelectorAll('[data-samples]').forEach(button => button.addEventListener('click', () => {
+  targetSamples = Number(button.dataset.samples);
+  updateQuality();
+  render();
+}));
+$('#resolution').addEventListener('change', render);
+document.querySelectorAll('.swatch').forEach(button => button.addEventListener('click', () => {
+  selectedSwatch = button;
+  $('#color-picker').value = button.dataset.color;
+  $('#color-picker').click();
+}));
+$('#color-picker').addEventListener('change', event => {
+  const hex = event.target.value;
+  colors[selectedSwatch.dataset.index] = [1, 3, 5].map(i => Math.min(0.999, parseInt(hex.slice(i, i + 2), 16) / 255));
+  updatePalette('CUSTOM');
+  render();
+});
+$('#download').addEventListener('click', () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${Date.now()}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+$('#scene-tab').addEventListener('click', () => setView(true));
+$('#render-tab').addEventListener('click', () => setView(false));
+$('#about-button').addEventListener('click', () => $('#about-dialog').showModal());
+$('.dialog-close').addEventListener('click', () => $('#about-dialog').close());
+$('#about-dialog').addEventListener('click', event => { if (event.target === event.currentTarget) event.currentTarget.close(); });
+updateQuality();
+render();
