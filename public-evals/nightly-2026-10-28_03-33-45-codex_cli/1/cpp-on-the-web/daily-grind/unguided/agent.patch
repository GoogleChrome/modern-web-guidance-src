+// Produce the startup artwork with the same compiled WebAssembly used in the browser.
+import { readFile, writeFile } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import createSmallpt from '../assets/smallpt.js';
+const module = await createSmallpt({ wasmBinary: await readFile(new URL('../assets/smallpt.wasm', import.meta.url)) });
+const width=640, height=480;
+module._initialize(width, height, 17042);
+const start = performance.now();
+for(let i=0;i<32;i++) module._sample_pass();
+const data = module.HEAPU8.slice(module._pixels(), module._pixels()+width*height*4);
+const rows = Buffer.alloc(height*(width*4+1));
+for(let y=0;y<height;y++) rows.set(data.subarray(y*width*4,(y+1)*width*4), y*(width*4+1)+1);
+function crc32(buffer){let crc=0xffffffff;for(const b of buffer){crc^=b;for(let k=0;k<8;k++)crc=(crc>>>1)^((crc&1)?0xedb88320:0);}return (crc^0xffffffff)>>>0;}
+function chunk(type,data){const name=Buffer.from(type);const size=Buffer.alloc(4);size.writeUInt32BE(data.length);const crc=Buffer.alloc(4);crc.writeUInt32BE(crc32(Buffer.concat([name,data])));return Buffer.concat([size,name,data,crc]);}
+const header=Buffer.alloc(13);header.writeUInt32BE(width,0);header.writeUInt32BE(height,4);header[8]=8;header[9]=6;
+await writeFile(new URL('../assets/initial-render.png',import.meta.url),Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',header),chunk('IDAT',deflateSync(rows)),chunk('IEND',Buffer.alloc(0))]));
+console.log(`Created actual smallpt render at 128 spp in ${((performance.now()-start)/1000).toFixed(1)}s.`);
