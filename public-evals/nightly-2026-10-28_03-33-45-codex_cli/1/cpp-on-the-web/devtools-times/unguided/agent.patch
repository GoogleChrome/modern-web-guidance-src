diff --git a/public/render-worker.js b/public/render-worker.js
new file mode 100644
index 0000000..b99e573
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,27 @@
+import createSmallpt from './wasm/smallpt.js';
+const ready = createSmallpt();
+let generation = 0;
+self.onmessage = async ({ data }) => {
+  const ownGeneration = ++generation;
+  try {
+    const module = await ready;
+    if (generation !== ownGeneration) return;
+    const { width, height, samples, colors } = data;
+    module._init(width, height);
+    for (const [id, color] of Object.entries(colors)) module._set_color(Number(id), ...color);
+    const start = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 12) {
+        if (generation !== ownGeneration) return;
+        module._render_rows(row, 12, pass);
+        // Yield so a new palette can interrupt an in-progress render.
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+      if (generation !== ownGeneration) return;
+      const pixels = module.HEAPU8.slice(module._get_pixels(), module._get_pixels() + width * height * 4);
+      self.postMessage({ pixels, samples: (pass + 1) * 4, elapsed: (performance.now() - start) / 1000, done: (pass + 1) * 4 >= samples, id: data.id }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error), id: data.id });
+  }
+};
