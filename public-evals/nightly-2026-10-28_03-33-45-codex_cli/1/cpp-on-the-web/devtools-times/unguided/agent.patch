new file mode 100644
index 0000000..d595744
--- /dev/null
+++ b/public/studio.js
@@ -0,0 +1,96 @@
+const $ = id => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+const original = { 0: [.75, .25, .25], 1: [.25, .25, .75], 2: [.75, .75, .75], 3: [0, 0, 0], 4: [.75, .75, .75], 5: [.75, .75, .75], 6: [.999, .999, .999], 7: [.999, .999, .999] };
+let colors = structuredClone(original);
+let worker;
+let renderId = 0;
+let hasRendered = false;
+let paletteIndex = 0;
+const qualities = { 16: 'Quick', 64: 'Balanced', 256: 'Fine' };
+function showError(message) {
+  $('status').textContent = 'Renderer unavailable — reload to retry';
+  $('status').title = message;
+  $('status-dot').style.background = '#c47979';
+  $('randomize').disabled = true;
+  $('reset-scene').disabled = true;
+  $('samples').disabled = true;
+}
+function render() {
+  if (!worker) return;
+  renderId++;
+  $('status').textContent = 'Tracing light…';
+  $('status-dot').style.background = '#9c8ac6';
+  $('sample-count').textContent = '0';
+  $('elapsed').textContent = '0.0';
+  $('progress').style.width = '0%';
+  worker.postMessage({ id: renderId, width: 640, height: 480, samples: Number($('samples').value), colors });
+}
+function updateSwatches() {
+  [0, 1, 2, 6, 7].forEach((id, index) => {
+    const color = colors[id];
+    $('swatches').children[index].style.setProperty('--color', `rgb(${color.map(c => Math.round(c * 255)).join(',')})`);
+  });
+}
+function hueColor(h, saturation, lightness) {
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  const f = n => { const k = (n + h * 12) % 12; return lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); };
+  return [f(0), f(8), f(4)];
+}
+$('randomize').addEventListener('click', () => {
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296;
+  colors = structuredClone(original);
+  colors[0] = hueColor(hue, .46, .52);
+  colors[1] = hueColor((hue + .36) % 1, .42, .55);
+  colors[2] = hueColor((hue + .17) % 1, .12, .72);
+  // Tint both foreground spheres while preserving their mirror and glass materials.
+  colors[6] = hueColor((hue + .08) % 1, .44, .75);
+  colors[7] = hueColor((hue + .55) % 1, .3, .82);
+  $('palette-name').textContent = `Experiment ${String(++paletteIndex).padStart(2, '0')}`;
+  updateSwatches();
+  render();
+});
+$('reset-scene').addEventListener('click', () => {
+  colors = structuredClone(original);
+  $('palette-name').textContent = 'The original';
+  updateSwatches();
+  render();
+});
+$('samples').addEventListener('change', () => {
+  $('quality-label').textContent = qualities[$('samples').value];
+  render();
+});
+$('save').addEventListener('click', async () => {
+  if (!hasRendered) {
+    const image = document.querySelector('.preview');
+    if (!image.complete || !image.naturalWidth) return;
+    context.drawImage(image, 0, 0, 640, 480);
+  }
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${paletteIndex ? `experiment-${paletteIndex}` : 'original'}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+$('status').setAttribute('role', 'status');
+try {
+  worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+  worker.onmessage = ({ data }) => {
+    if (data.id !== renderId) return;
+    if (data.error) { showError(data.error); return; }
+    context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), 640, 480), 0, 0);
+    canvas.style.opacity = '1';
+    hasRendered = true;
+    $('sample-count').textContent = data.samples;
+    $('elapsed').textContent = data.elapsed.toFixed(1);
+    $('progress').style.width = `${data.samples / Number($('samples').value) * 100}%`;
+    $('status').textContent = data.done ? 'Render complete' : 'Tracing light…';
+    $('status-dot').style.background = data.done ? '#80a68a' : '#9c8ac6';
+  };
+  worker.onerror = event => showError(event.message);
+  render();
+} catch (error) { showError(String(error)); }
