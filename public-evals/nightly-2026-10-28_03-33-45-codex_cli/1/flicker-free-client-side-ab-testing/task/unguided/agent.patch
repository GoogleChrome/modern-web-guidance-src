+  <style>html.experiment-pending body{visibility:hidden}html.experiment-pending .hero-copy{min-height:480px}</style>
+  <script>
+    (() => {
+      document.documentElement.classList.add('experiment-pending');
+      let finished = false;
+      let timer;
+      let domReady = document.readyState !== 'loading';
+      let requested = null;
+      // Integration contract: the SDK calls window.everleafExperimentReady() or
+      // dispatches "experiment:ready" AFTER all initial DOM changes are complete.
+      // Script load alone is deliberately not treated as experiment readiness.
+      const finish = (fallback) => {
+        if (finished) return;
+        requested = fallback;
+        if (!domReady) return;
+        finished = true;
+        clearTimeout(timer);
+        if (fallback) {
+          let variant = 'b';
+          try {
+            variant = localStorage.getItem('everleaf-variant') || (Math.random() < .5 ? 'a' : 'b');
+            localStorage.setItem('everleaf-variant', variant);
+          } catch (_) { /* Private storage still receives a valid variant. */ }
+          const copy = variant === 'a'
+            ? ['A little green.', 'A lot of good.', 'Find your plant']
+            : ['Good things', 'grow here.', 'Find your plant'];
+          document.querySelector('[data-hero-line-one]').textContent = copy[0];
+          document.querySelector('[data-hero-line-two]').textContent = copy[1];
+          document.querySelector('[data-hero-cta]').firstChild.textContent = copy[2] + ' ';
+          document.documentElement.dataset.experimentVariant = variant;
+          document.documentElement.dataset.experimentSource = 'local-fallback';
+        } else {
+          document.documentElement.dataset.experimentSource = 'sdk';
+        }
+        document.documentElement.classList.remove('experiment-pending');
+      };
+      window.everleafExperimentReady = () => finish(false);
+      window.addEventListener('experiment:ready', window.everleafExperimentReady, { once: true });
+      window.addEventListener('DOMContentLoaded', () => {
+        domReady = true;
+        if (requested !== null) finish(requested);
+      }, { once: true });
+      window.everleafExperimentFailed = () => finish(true);
+      timer = setTimeout(() => finish(true), 1800);
+    })();
+  </script>
