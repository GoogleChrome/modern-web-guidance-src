+import { createServer } from 'node:http';
+import { readFileSync, mkdirSync } from 'node:fs';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { verifyEmailToken } from './server/verify-email.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.PUBLIC_ORIGIN || `http://localhost:${port}`).origin;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) throw new Error('Set PUBLIC_ORIGIN to your public HTTPS origin');
+const template = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+const styles = readFileSync(new URL('./styles.css', import.meta.url));
+const dataDir = process.env.DATA_DIR || './data';
+mkdirSync(dataDir, {recursive:true, mode:0o700});
+const db = new DatabaseSync(`${dataDir}/rewards.sqlite`);
+db.exec(`PRAGMA journal_mode=WAL;
+  CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+  CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY, email TEXT NOT NULL, email_key TEXT NOT NULL UNIQUE, first_name TEXT NOT NULL, joined_at TEXT NOT NULL, terms_version TEXT NOT NULL, email_verified INTEGER NOT NULL CHECK(email_verified=1));`);
+const escape = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
+function page(response, {message='',status=200,name='',email='',success=false} = {}) {
+  db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+  const id = randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(id,nonce,Date.now()+600000);
+  let html = template.replace('<!-- VERIFICATION_NONCE -->',nonce).replace('<!-- FORM_MESSAGE -->',escape(message));
+  if (success) html = html.replace(/<!-- SIGNUP_CONTENT_START -->[\s\S]*<!-- SIGNUP_CONTENT_END -->/, `<div class="success-panel" role="status"><span aria-hidden="true">✓</span><h3>Welcome to the Daily Grind, ${escape(name)}.</h3><p>Your email is verified and your rewards account is ready. We’re glad you’re here.</p><a class="button" href="/order-online">Find your next cup ↗</a></div>`);
+  else html = html.replace('id="name" name="name"', `id="name" name="name" value="${escape(name)}"`).replace('id="email" name="email"', `id="email" name="email" value="${escape(email)}"`);
+  response.writeHead(status, {'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store','X-Content-Type-Options':'nosniff','Referrer-Policy':'same-origin','Set-Cookie':`dg_signup=${id}; HttpOnly; SameSite=Lax; Path=/; Max-Age=600${origin.startsWith('https:')?'; Secure':''}`, ...(process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL ? {'Origin-Trial':process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL} : {})});
+  response.end(html);
+}
+const consume = db.prepare('DELETE FROM challenges WHERE id = ? RETURNING nonce, expires');
+createServer(async (request,response) => {
+  try {
+    const path = new URL(request.url,origin).pathname;
+    if (request.method === 'GET' && path === '/') return page(response);
+    if (request.method === 'GET' && path === '/styles.css') { response.writeHead(200,{'Content-Type':'text/css; charset=utf-8'}); response.end(styles); return; }
+    if (path !== '/api/verify-email') { response.writeHead(404,{'Content-Type':'text/plain'}); response.end('Page not found'); return; }
+    if (request.method !== 'POST') { response.writeHead(405,{'Allow':'POST'}); response.end('Method not allowed'); return; }
+    if (request.headers.origin !== origin) { response.writeHead(403); response.end('Please submit the form from the Daily Grind homepage.'); return; }
+    const session = request.headers.cookie?.split(';').map(s=>s.trim()).find(s=>s.startsWith('dg_signup='))?.slice(10) || '';
+    // DELETE RETURNING consumes the challenge atomically, even if validation fails.
+    const challenge = consume.get(session);
+    if (!challenge || challenge.expires < Date.now()) return page(response,{status:409,message:'This form has expired or was already submitted. Please try again using this fresh form.'});
+    if (request.headers['content-type']?.split(';')[0] !== 'application/x-www-form-urlencoded') return page(response,{status:415,message:'Please use the registration form to join.'});
+    let body = '';
+    for await (const chunk of request) { body += chunk.toString(); if (Buffer.byteLength(body) > 32768) { response.writeHead(413); response.end('Form too large'); return; } }
+    const form = new URLSearchParams(body);
+    const name = (form.get('name') || '').trim();
+    const email = (form.get('email') || '').trim();
+    const token = (form.get('token') || '').trim();
+    if (!name || name.length > 80 || email.length > 254 || !/^[^\s@]+@[a-z\d](?:[a-z\d.-]*[a-z\d])?\.[a-z]{2,}$/i.test(email) || form.get('terms') !== 'accepted') return page(response,{status:400,name,email,message:'Please enter your first name, a valid email address, and accept the terms.'});
+    if (!token) return page(response,{status:422,name,email,message:'Your browser didn’t provide email ownership proof. Sign in to your email provider in a supported browser, then select or re-enter your email and try again. No account was created and no email was sent.'});
+    try { await verifyEmailToken({rawToken:token,email,nonce:challenge.nonce,audience:origin}); }
+    catch { return page(response,{status:422,name,email,message:'We couldn’t confirm your email ownership. Please re-enter your email and try again. If your provider or browser doesn’t support verification, registration is currently unavailable. No email was sent.'}); }
+    db.prepare('INSERT INTO members VALUES (?, ?, ?, ?, ?, ?, 1) ON CONFLICT(email_key) DO NOTHING').run(randomUUID(),email,email.toLowerCase(),name,new Date().toISOString(),'2026-10-28');
+    return page(response,{success:true,name});
+  } catch { if (!response.headersSent) page(response,{status:500,message:'We couldn’t finish your registration. Please try again in a moment.'}); else response.end(); }
+}).listen(port);
