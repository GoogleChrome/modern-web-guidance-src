diff --git a/test/verification.test.mjs b/test/verification.test.mjs
new file mode 100644
index 0000000..d1aafab
--- /dev/null
+++ b/test/verification.test.mjs
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { verifyEmailToken, validEmail } from '../lib/verification.mjs';
+import { openStore } from '../lib/store.mjs';
+
+const origin = 'https://dailygrind.example';
+const email = 'coffee@example.com';
+const issuer = 'https://provider.example';
+async function fixture(options = {}) {
+  const alg = options.alg || 'ES256';
+  const provider = await generateKeyPair(alg, { extractable: true });
+  const browser = await generateKeyPair(alg, { extractable: true });
+  const providerJwk = { ...await exportJWK(provider.publicKey), kid: 'test-key', alg };
+  const browserJwk = { ...await exportJWK(browser.publicKey), alg };
+  const time = Math.floor(Date.now() / 1000);
+  const evt = await new SignJWT({ email, email_verified: true, cnf: { jwk: browserJwk }, ...options.evt })
+    .setProtectedHeader({ typ: 'evt+jwt', kid: 'test-key', alg }).setIssuer(issuer).setIssuedAt(time).sign(provider.privateKey);
+  const hash = createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = await new SignJWT({ nonce: 'challenge', sd_hash: hash, ...options.kb })
+    .setProtectedHeader({ typ: 'kb+jwt', alg }).setAudience(options.audience || origin).setIssuedAt(options.iat ?? time)
+    .sign(options.wrongKey ? provider.privateKey : browser.privateKey);
+  return {
+    args: { email, nonce: 'challenge', origin, token: `${evt}~${kb}` },
+    discover: async () => ({ issuer: options.discoveredIssuer || issuer, jwks: { keys: [providerJwk] } }),
+  };
+}
+for (const alg of ['ES256', 'Ed25519', 'EdDSA', 'RS256']) {
+  test(`accepts valid provider and browser signatures (${alg})`, async () => {
+    const { args, discover } = await fixture({ alg });
+    assert.deepEqual(await verifyEmailToken(args, discover), { email, issuer });
+  });
+}
+for (const [name, options] of [
+  ['unverified email', { evt: { email_verified: false } }],
+  ['changed email', { evt: { email: 'other@example.com' } }],
+  ['wrong nonce', { kb: { nonce: 'another-session' } }],
+  ['wrong origin', { audience: 'https://attacker.example' }],
+  ['untrusted issuer', { discoveredIssuer: 'https://attacker.example' }],
+  ['wrong hash', { kb: { sd_hash: 'wrong' } }],
+  ['expired binding', { iat: Math.floor(Date.now() / 1000) - 600 }],
+  ['future binding', { iat: Math.floor(Date.now() / 1000) + 600 }],
+  ['wrong browser key', { wrongKey: true }],
+  ['expired provider token', { evt: { exp: 1 } }],
+]) {
+  test(`rejects ${name}`, async () => {
+    const { args, discover } = await fixture(options);
+    await assert.rejects(verifyEmailToken(args, discover));
+  });
+}
+test('rejects forged signature and missing binding', async () => {
+  const { args, discover } = await fixture();
+  const [evt, kb] = args.token.split('~');
+  const parts = evt.split('.');
+  parts[2] = Buffer.alloc(64).toString('base64url');
+  await assert.rejects(verifyEmailToken({ ...args, token: `${parts.join('.')}~${kb}` }, discover));
+  await assert.rejects(verifyEmailToken({ ...args, token: evt }, discover));
+});
+test('challenges are unique, session-bound, and consumed atomically', () => {
+  const store = openStore(':memory:');
+  try {
+    const a = store.challenge(), b = store.challenge();
+    assert.notEqual(a.nonce, b.nonce);
+    assert.equal(store.consume('unknown-session'), undefined);
+    assert.equal(store.consume(a.session), a.nonce);
+    assert.equal(store.consume(a.session), undefined);
+    assert.equal(store.consume(b.session), b.nonce);
+  } finally { store.close(); }
+});
+test('members persist with duplicate email protection', () => {
+  const store = openStore(':memory:');
+  try {
+    assert.ok(store.register({ name: 'Coffee Lover', email, issuer }));
+    assert.equal(store.register({ name: 'Other Name', email, issuer }), null);
+  } finally { store.close(); }
+});
+test('rejects malformed addresses', () => {
+  for (const invalid of ['coffee', 'a@@example.com', 'a@localhost', 'a@example.com/secret', 'a b@example.com']) assert.equal(validEmail(invalid), false);
+});
