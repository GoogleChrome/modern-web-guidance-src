+import { openStore } from './lib/store.mjs';
+import { verifyEmailToken, validEmail } from './lib/verification.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.APP_ORIGIN || `http://localhost:${port}`).origin;
+const secure = origin.startsWith('https:');
+const store = openStore(process.env.DATABASE_PATH || './data/rewards.sqlite');
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const css = await readFile(new URL('./styles.css', import.meta.url));
+const escape = value => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
+const cookie = value => `dg_signup=${value}; HttpOnly; SameSite=Lax; Path=/; Max-Age=600${secure ? '; Secure' : ''}`;
+const attempts = new Map();
+function limited(ip) {
+  const now = Date.now();
+  for (const [key, item] of attempts) if (item.until < now) attempts.delete(key);
+  const item = attempts.get(ip) || { count: 0, until: now + 60000 };
+  attempts.set(ip, item);
+  return ++item.count > 30;
+}
+function page(res, message = '', success = false, status = 200, values = {}) {
+  const challenge = store.challenge();
+  const form = template.replaceAll('__NONCE__', challenge.nonce)
+    .replace('__NAME__', escape(values.name || '')).replace('__EMAIL__', escape(values.email || ''))
+    .replace('__MESSAGE__', escape(message)).replace('__STATUS_CLASS__', message ? (success ? 'success' : 'error') : 'empty')
+    .replaceAll('__SUCCESS__', success ? 'hidden' : '').replace('__WELCOME__', success ? '' : 'hidden');
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Set-Cookie': cookie(challenge.session) });
+  res.end(form);
+}
+
+createServer(async (req, res) => {
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'same-origin');
+  res.setHeader('Content-Security-Policy', "default-src 'self'; img-src 'self' https://images.unsplash.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'; form-action 'self'; base-uri 'none'");
+  if (process.env.EVP_ORIGIN_TRIAL_TOKEN) res.setHeader('Origin-Trial', process.env.EVP_ORIGIN_TRIAL_TOKEN);
+  try {
+    const path = new URL(req.url, origin).pathname;
+    if (req.method === 'GET' && path === '/styles.css') { res.writeHead(200, { 'Content-Type': 'text/css' }); res.end(css); return; }
+    if (req.method === 'GET' && path === '/') {
+      if (limited(req.socket.remoteAddress)) { res.writeHead(429); res.end('Please try again in a minute.'); return; }
+      page(res); return;
+    }
+    if (req.method === 'POST' && path === '/api/rewards/register') {
+      if (req.headers.origin !== origin || req.headers['sec-fetch-site'] === 'cross-site') { res.writeHead(403); res.end('Please submit the form from the Daily Grind homepage.'); return; }
+      if (limited(req.socket.remoteAddress)) { res.writeHead(429); res.end('Please try again in a minute.'); return; }
+      if (req.headers['content-type']?.split(';')[0] !== 'application/x-www-form-urlencoded') { res.writeHead(415); res.end('Unsupported form format.'); return; }
+      let body = '';
+      for await (const chunk of req) {
+        body += chunk;
+        if (Buffer.byteLength(body) > 32768) { res.writeHead(413); res.end('Form too large.'); return; }
+      }
+      const fields = new URLSearchParams(body);
+      const values = { name: (fields.get('name') || '').trim(), email: (fields.get('email') || '').trim() };
+      const session = /(?:^|;\s*)dg_signup=([A-Za-z0-9_-]+)/.exec(req.headers.cookie || '')?.[1];
+      const nonce = store.consume(session || '');
+      if (!nonce) { page(res, 'Your sign-up session expired. Please try again below.', false, 400, values); return; }
+      if (!values.name || values.name.length > 100 || !validEmail(values.email) || fields.get('terms') !== 'yes') {
+        page(res, 'Please enter your name, a valid email address, and accept the rewards terms.', false, 400, values); return;
+      }
+      const token = fields.get('evt');
+      if (!token) {
+        page(res, 'Your browser or email provider could not verify this address. Try a supported browser while signed in to your email provider. No account was created and no email was sent.', false, 422, values); return;
+      }
+      let verified;
+      try { verified = await verifyEmailToken({ token, email: values.email, nonce, origin }); }
+      catch { page(res, 'We couldn’t verify your email securely. Please check your address, sign in to your email provider in this browser, and try again. No account was created.', false, 422, values); return; }
+      const id = store.register({ ...values, issuer: verified.issuer });
+      if (!id) { page(res, 'This email already has a rewards account. Your existing membership is ready for your next visit.', false, 409, values); return; }
+      page(res, 'Your email is verified and your rewards account is ready. Give your email at the counter on your next visit to start collecting points.', true, 201); return;
+    }
+    res.writeHead(404); res.end('Page not found.');
+  } catch (error) {
+    console.error('Rewards request failed:', error.code || error.name);
+    if (!res.headersSent) page(res, 'Something went wrong. Please try again in a moment.', false, 500);
+    else res.end();
+  }
+}).listen(port, '0.0.0.0');
