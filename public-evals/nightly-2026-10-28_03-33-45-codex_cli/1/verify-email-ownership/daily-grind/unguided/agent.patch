diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..fe12d23
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,30 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+export function openStore(filename) {
+  if (filename !== ':memory:') mkdirSync(dirname(filename), { recursive: true });
+  const db = new DatabaseSync(filename);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (session TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL UNIQUE, issuer TEXT NOT NULL, created INTEGER NOT NULL);`);
+  return {
+    challenge() {
+      const session = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(session, nonce, Date.now() + 600000);
+      return { session, nonce };
+    },
+    consume(session) {
+      return db.prepare('DELETE FROM challenges WHERE session = ? AND expires > ? RETURNING nonce').get(session, Date.now())?.nonce;
+    },
+    register({ name, email, issuer }) {
+      const id = randomUUID();
+      const result = db.prepare('INSERT INTO members VALUES (?, ?, ?, ?, ?) ON CONFLICT(email) DO NOTHING').run(id, name, email, issuer, Date.now());
+      return result.changes ? id : null;
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/lib/verification.mjs b/lib/verification.mjs
new file mode 100644
index 0000000..ef46727
--- /dev/null
+++ b/lib/verification.mjs
@@ -0,0 +1,71 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt, lookup } from 'node:dns/promises';
+import { request } from 'node:https';
+import ipaddr from 'ipaddr.js';
+import { decodeProtectedHeader, importJWK, jwtVerify, createLocalJWKSet } from 'jose';
+
+const algorithms = ['ES256', 'RS256', 'PS256', 'EdDSA', 'Ed25519'];
+const validHost = /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i;
+export function validEmail(email) {
+  return typeof email === 'string' && email.length <= 254 && /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[^@\s]+$/.test(email) && validHost.test(email.split('@')[1]);
+}
+
+// Pin each HTTPS request to a publicly routable DNS result. Never follow redirects.
+export async function publicJson(address) {
+  const url = new URL(address);
+  if (url.protocol !== 'https:' || url.username || url.password || url.port || !validHost.test(url.hostname)) throw Error('Invalid provider URL');
+  const addresses = await lookup(url.hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) throw Error('Private provider address');
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      lookup: (_host, options, callback) => options.all ? callback(null, [addresses[0]]) : callback(null, addresses[0].address, addresses[0].family),
+      headers: { Accept: 'application/json' },
+    }, res => {
+      if (res.statusCode !== 200) { res.resume(); reject(Error('Provider unavailable')); return; }
+      let data = '';
+      res.on('data', chunk => { data += chunk; if (Buffer.byteLength(data) > 128 * 1024) req.destroy(Error('Provider response too large')); });
+      res.on('error', reject);
+      res.on('end', () => { try { resolve(JSON.parse(data)); } catch (error) { reject(error); } });
+    });
+    req.setTimeout(5000, () => req.destroy(Error('Provider timed out')));
+    req.on('error', reject);
+    req.end();
+  });
+}
+
+export async function discoverProvider(email) {
+  const records = await resolveTxt(`_email-verification.${email.split('@')[1]}`);
+  if (records.length !== 1) throw Error('Missing provider delegation');
+  const host = records[0].join('').replace(/^iss=/, '');
+  if (!records[0].join('').startsWith('iss=') || !validHost.test(host)) throw Error('Invalid provider delegation');
+  const issuer = `https://${host}`;
+  const metadata = await publicJson(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw Error('Invalid provider metadata');
+  const jwks = await publicJson(metadata.jwks_uri);
+  return { issuer, jwks };
+}
+
+export async function verifyEmailToken({ token, email, nonce, origin }, discover = discoverProvider) {
+  if (!validEmail(email) || typeof token !== 'string' || token.length > 24000) throw Error('Invalid verification');
+  const parts = token.split('~');
+  if (parts.length !== 2 || parts.some(part => !part)) throw Error('Missing bound token');
+  const [evt, kb] = parts;
+  const { issuer, jwks } = await discover(email);
+  const { payload, protectedHeader } = await jwtVerify(evt, createLocalJWKSet(jwks), {
+    issuer, algorithms, typ: 'evt+jwt', maxTokenAge: '5m', clockTolerance: 30,
+    requiredClaims: ['iat', 'email', 'email_verified', 'cnf'],
+  });
+  if (!protectedHeader.kid || payload.email !== email || payload.email_verified !== true || !payload.cnf?.jwk) throw Error('Email mismatch');
+  const jwk = payload.cnf.jwk;
+  if (jwk.d || jwk.k || jwk.kty === 'oct') throw Error('Invalid public key');
+  const header = decodeProtectedHeader(kb);
+  if (!algorithms.includes(header.alg) || (jwk.alg && jwk.alg !== header.alg)) throw Error('Invalid binding algorithm');
+  const key = await importJWK(jwk, header.alg);
+  const { payload: binding } = await jwtVerify(kb, key, {
+    algorithms: [header.alg], audience: origin, typ: 'kb+jwt', maxTokenAge: '5m', clockTolerance: 30,
+    requiredClaims: ['iat', 'nonce', 'sd_hash'],
+  });
+  const digest = createHash('sha256').update(`${evt}~`).digest('base64url');
+  if (binding.aud !== origin || binding.nonce !== nonce || binding.sd_hash !== digest) throw Error('Invalid key binding');
+  return { email: payload.email, issuer };
+}
