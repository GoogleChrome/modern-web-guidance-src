+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .card > .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    .customizations {
+      border: 0;
+      min-width: 0;
+      margin: 22px 0;
+      text-align: left;
+    }
+
+    .customizations legend {
+      margin-bottom: 10px;
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.1em;
+      text-transform: uppercase;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    .customization-option {
+      position: relative;
+      margin-top: 8px;
+    }
+
+    /* Keep the native input focusable and clickable over the entire label. */
+    .customization-option input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .customization-option label {
+      display: grid;
+      grid-template-columns: 22px 20px minmax(0, 1fr);
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: #fdfaf7;
+      color: var(--primary);
+      font-size: 0.875rem;
+      cursor: pointer;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-icon {
+      width: 20px;
+      height: 20px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.7;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      color: #795548;
+    }
+
+    .checkbox-mark {
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      border: 2px solid #8d6e63;
+      border-radius: 6px;
+      background: white;
+      transition: background-color 180ms ease, border-color 180ms ease,
+        transform 180ms ease;
+    }
+
+    .checkbox-mark svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 22;
+      stroke-dashoffset: 22;
+      opacity: 0;
+      transform: scale(0.65);
+      transition: stroke-dashoffset 200ms ease, opacity 150ms ease,
+        transform 200ms ease;
+    }
+
+    .customization-option input:hover + label {
+      border-color: #8d6e63;
+      background: #f4ece5;
+    }
+
+    .customization-option input:checked + label {
+      border-color: #a86b20;
+      background: #fff3df;
+    }
+
+    .customization-option input:checked + label .checkbox-mark {
+      background: var(--accent);
+      border-color: var(--primary);
+    }
+
+    .customization-option input:checked + label .checkbox-mark svg {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .customization-option input:active + label .checkbox-mark {
+      transform: scale(0.9);
+    }
+
+    .customization-option input:focus-visible + label {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization-option label,
+      .checkbox-mark,
+      .checkbox-mark svg {
+        transition: none;
+      }
+    }
+
+    /* Use the system checkbox and colors in high-contrast modes. */
+    @media (forced-colors: active) {
+      .customization-option input {
+        appearance: auto;
+        inset: auto;
+        left: 12px;
+        top: 50%;
+        width: 22px;
+        height: 22px;
+        opacity: 1;
+        transform: translateY(-50%);
+      }
+
+      .checkbox-mark {
+        visibility: hidden;
+      }
+
+      .customization-option input + label {
+        color: CanvasText;
+        background: Canvas;
+        border-color: ButtonText;
+      }
+
+      .customization-option input:checked + label {
+        border-color: Highlight;
+      }
+
+      .customization-option input:focus-visible + label {
+        outline-color: Highlight;
+      }
+
+      .option-icon {
+        color: CanvasText;
+      }
+    }
+
