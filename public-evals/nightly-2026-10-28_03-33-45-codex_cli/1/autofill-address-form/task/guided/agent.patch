+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingReview = document.getElementById('shipping-review');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      document.getElementById('review-name').textContent = details.get('name');
+      document.getElementById('review-address').textContent = [
+        details.get('street-address'),
+        details.get('city'),
+        details.get('region'),
+        details.get('postal-code'),
+        details.get('country')
+      ].filter(Boolean).join('\n');
+      document.getElementById('review-contact').textContent = [
+        details.get('email'), details.get('phone')
+      ].filter(Boolean).join('\n');
+      shippingReview.hidden = false;
+      shippingStatus.textContent = 'Your shipping details are ready to review below. No order has been placed.';
+    });
+
+    // Autofill may emit change rather than input; invalidate either kind of edit.
+    function clearShippingReview() {
+      shippingReview.hidden = true;
+      shippingStatus.textContent = '';
+    }
+    shippingForm.addEventListener('input', clearShippingReview);
+    shippingForm.addEventListener('change', clearShippingReview);
+  </script>
