+  <script>
+    const slides = [...document.querySelectorAll('#seasonal-items .card')];
+    const position = document.querySelector('#seasonal-position');
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const supportsDirectionalTransitions = typeof document.startViewTransition === 'function'
+      && CSS.supports('selector(:active-view-transition-type(forward))');
+    let currentIndex = 0;
+    let activeTransition;
+    let entryAnimation;
+
+    document.querySelector('.seasonal-controls').hidden = false;
+
+    function step(direction) {
+      activeTransition?.skipTransition();
+      entryAnimation?.cancel();
+
+      const updateSlide = () => {
+        slides[currentIndex].hidden = true;
+        currentIndex = (currentIndex + direction + slides.length) % slides.length;
+        slides[currentIndex].hidden = false;
+        position.textContent = `${currentIndex + 1} / ${slides.length}`;
+      };
+
+      if (motionPreference.matches) {
+        updateSlide();
+      } else if (supportsDirectionalTransitions) {
+        activeTransition = document.startViewTransition({
+          update: updateSlide,
+          types: [direction === 1 ? 'forward' : 'backward']
+        });
+      } else {
+        updateSlide();
+        // Preserve directional entry in browsers without typed View Transitions.
+        entryAnimation = slides[currentIndex].animate([
+          { transform: `translateX(${direction * 100}%)` },
+          { transform: 'translateX(0)' }
+        ], { duration: 300, easing: 'ease-in-out' });
+      }
+    }
+
+    document.querySelector('#seasonal-next').addEventListener('click', () => step(1));
+    document.querySelector('#seasonal-previous').addEventListener('click', () => step(-1));
+    motionPreference.addEventListener('change', () => {
+      if (motionPreference.matches) {
+        activeTransition?.skipTransition();
+        entryAnimation?.cancel();
+      }
+    });
+  </script>
