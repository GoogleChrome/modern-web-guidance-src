+  <script>
+    const slides = Array.from(document.querySelectorAll('#seasonal-slides .card'));
+    const status = document.getElementById('seasonal-status');
+    let currentSlide = 0;
+
+    function showSlide(direction) {
+      slides[currentSlide].hidden = true;
+      slides[currentSlide].classList.remove('slide-next', 'slide-previous');
+      currentSlide = (currentSlide + direction + slides.length) % slides.length;
+      const slide = slides[currentSlide];
+      slide.hidden = false;
+      // Restart the entry animation even when navigating rapidly between items.
+      void slide.offsetWidth;
+      slide.classList.add(direction === 1 ? 'slide-next' : 'slide-previous');
+      status.textContent = `${currentSlide + 1} of ${slides.length}: ${slide.querySelector('h3').textContent}`;
+    }
+
+    document.getElementById('seasonal-next').addEventListener('click', () => showSlide(1));
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSlide(-1));
+  </script>
