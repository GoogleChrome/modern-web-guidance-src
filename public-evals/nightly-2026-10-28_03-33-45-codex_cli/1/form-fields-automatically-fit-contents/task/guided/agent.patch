+  <script>
+    const notesForm = document.querySelector('.notes-form');
+    // This is a writing space, with no remote submission destination.
+    notesForm.addEventListener('submit', (event) => event.preventDefault());
+
+    if (!CSS.supports('field-sizing', 'content')) {
+      const measuringContext = document.createElement('canvas').getContext('2d');
+      const fitControls = () => {
+        notesForm.querySelectorAll('input, select, textarea').forEach((control) => {
+          if (control instanceof HTMLTextAreaElement) {
+            // Reset first so deleting text also shrinks the textarea.
+            control.style.height = 'auto';
+            const style = getComputedStyle(control);
+            const borders = parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth);
+            control.style.height = `${control.scrollHeight + borders}px`;
+          } else if (measuringContext) {
+            const style = getComputedStyle(control);
+            measuringContext.font = style.font;
+            const text = control instanceof HTMLSelectElement
+              ? control.selectedOptions[0].text
+              : control.value || control.placeholder || ' ';
+            const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+            const borders = parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+            const arrow = control instanceof HTMLSelectElement ? 24 : 2;
+            control.style.width = `${Math.ceil(measuringContext.measureText(text).width + padding + borders + arrow)}px`;
+          }
+        });
+      };
+      notesForm.addEventListener('input', fitControls);
+      notesForm.addEventListener('change', fitControls);
+      window.addEventListener('resize', fitControls);
+      window.addEventListener('pageshow', fitControls);
+      document.fonts.ready.then(fitControls);
+      fitControls();
+    }
+  </script>
