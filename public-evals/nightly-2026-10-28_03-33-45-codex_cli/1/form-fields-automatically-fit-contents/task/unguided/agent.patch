+  <script>
+    const form = document.querySelector('.note-form');
+    const controls = [...form.querySelectorAll('.content-control')];
+    const measure = document.createElement('span');
+    measure.className = 'measure-text';
+    measure.setAttribute('aria-hidden', 'true');
+    document.body.append(measure);
+
+    function sizeControl(control) {
+      const style = getComputedStyle(control);
+      measure.style.font = style.font;
+      measure.style.letterSpacing = style.letterSpacing;
+      const content = control.tagName === 'SELECT'
+        ? control.selectedOptions[0].text
+        : control.value || control.placeholder || ' ';
+      let width = 0;
+      for (const line of content.split('\n')) {
+        measure.textContent = line;
+        width = Math.max(width, measure.getBoundingClientRect().width);
+      }
+      const extra = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+        + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      control.style.width = `${Math.ceil(width + extra + 3)}px`;
+      if (control.tagName === 'TEXTAREA') {
+        control.style.height = 'auto';
+        control.style.height = `${control.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+      }
+    }
+
+    function sizeAll() { controls.forEach(sizeControl); }
+    controls.forEach(control => {
+      control.addEventListener('input', () => sizeControl(control));
+      control.addEventListener('change', () => sizeControl(control));
+    });
+    window.addEventListener('resize', sizeAll);
+    document.fonts.ready.then(sizeAll);
+    sizeAll();
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const note = Object.fromEntries(new FormData(form));
+      const status = form.querySelector('.form-status');
+      try {
+        localStorage.setItem('daily-grind-note', JSON.stringify(note));
+        status.textContent = `Thanks, ${note.name}! Your note is saved on this device. It hasn't been sent to the café.`;
+      } catch {
+        status.textContent = 'Your browser could not save this note. Please copy it before leaving this page.';
+      }
+    });
+  </script>
