+---
+import type { CollectionEntry } from 'astro:content';
+import BookmarkButton from './BookmarkButton';
+interface Props { article: CollectionEntry<'articles'>; image?: string; label?: string; summary?: string; }
+const { article, image, label, summary } = Astro.props;
+const base = import.meta.env.BASE_URL;
+const saved = await Astro.session?.get('readingList') || [];
+const src = image || (article.data.image.startsWith('http') ? article.data.image : `${base}${article.data.image.replace(/^\//, '')}`);
+---
+<article class="context-story">
+  <a class="story-image" href={`${base}articles/${article.id}`} tabindex="-1" aria-hidden="true"><img src={src} alt="" width="1200" height="800" loading={image ? 'eager' : 'lazy'} /><span class="feature-label">THE BIG PICTURE</span></a>
+  <div class="story-body">
+    <div class="story-kicker">{label || article.data.category}<span class="feature-note"> · EDITOR’S CHOICE</span></div>
+    <a class="story-title" href={`${base}articles/${article.id}`}><h3>{article.data.title}</h3></a>
+    <p class="story-summary">{summary || article.data.summary}</p>
+    <div class="story-meta"><span>{article.data.readingTime} min read<span class="story-author"> · By {article.data.author}</span></span><BookmarkButton client:load slug={article.id} initialIsBookmarked={saved.includes(article.id)} /></div>
+  </div>
+</article>
