+    .scroller {
+      --card-width: clamp(240px, 70vw, 320px);
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      scroll-snap-type: x proximity;
+      /* Let the first and last products reach the center, too. */
+      padding: 40px max(16px, calc((100% - var(--card-width)) / 2));
+      margin-top: 8px;
+      list-style: none;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .product-item {
+      flex: 0 0 var(--card-width);
+      min-width: 0;
+      scroll-snap-align: center;
+      view-timeline: --product inline;
+    }
+
+    :focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    nav a:focus-visible {
+      outline-color: var(--accent);
+    }
+
+    .scroller:focus-visible {
+      outline-offset: 2px;
+    }
+
+    @keyframes center-product {
+      0%, 100% { transform: scale(0.86); }
+      50% { transform: scale(1); }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view(inline)) {
+        .scroller .card {
+          /* Track the untransformed list item to keep the timeline stable.
+             Halfway through cover, its center meets the scrollport center. */
+          animation: center-product 1s linear both;
+          animation-timeline: --product;
+          animation-range: cover 0% cover 100%;
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-snap-type: none;
+      }
+    }
+
