diff --git a/spatial-navigation.js b/spatial-navigation.js
new file mode 100644
index 0000000..c5ee8ee
--- /dev/null
+++ b/spatial-navigation.js
@@ -0,0 +1,46 @@
+(() => {
+  const directions = {
+    ArrowLeft: [-1, 0],
+    ArrowRight: [1, 0],
+    ArrowUp: [0, -1],
+    ArrowDown: [0, 1],
+  };
+
+  document.querySelectorAll('.grid').forEach((grid) => {
+    grid.addEventListener('keydown', (event) => {
+      const direction = directions[event.key];
+      if (!direction || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+
+      // Keep native links, tab order, and any other controls inside cards intact.
+      const cards = Array.from(grid.querySelectorAll(':scope > .card'))
+        .map((card) => ({ card, link: card.querySelector('a[href]') }))
+        .filter(({ card, link }) => link && link.getClientRects().length && !card.closest('[inert]'))
+        .map(({ card, link }) => ({ link, rect: card.getBoundingClientRect() }));
+      const current = cards.find(({ link }) => link === event.target);
+      if (!current) return;
+
+      const [dx, dy] = direction;
+      const center = (rect) => ({ x: (rect.left + rect.right) / 2, y: (rect.top + rect.bottom) / 2 });
+      const origin = center(current.rect);
+      const candidates = cards.filter((item) => item !== current).map((item) => {
+        const target = center(item.rect);
+        const overlapX = Math.min(current.rect.right, item.rect.right) - Math.max(current.rect.left, item.rect.left);
+        const overlapY = Math.min(current.rect.bottom, item.rect.bottom) - Math.max(current.rect.top, item.rect.top);
+        return {
+          ...item,
+          forward: dx ? (target.x - origin.x) * dx : (target.y - origin.y) * dy,
+          // Horizontal movement stays in the current row. Vertical movement
+          // prefers the current column, with a fallback for incomplete rows.
+          eligible: dx ? overlapY > 1 : overlapY <= 1,
+          aligned: dx ? true : overlapX > 1,
+          distance: (target.x - origin.x) ** 2 + (target.y - origin.y) ** 2,
+        };
+      }).filter((item) => item.forward > 1 && item.eligible)
+        .sort((a, b) => Number(b.aligned) - Number(a.aligned) || a.distance - b.distance);
+
+      // Avoid scrolling the page while navigating, including at grid edges.
+      event.preventDefault();
+      candidates[0]?.link.focus();
+    });
+  });
+})();
diff --git a/tests/spatial-navigation.test.cjs b/tests/spatial-navigation.test.cjs
new file mode 100644
index 0000000..e407897
--- /dev/null
+++ b/tests/spatial-navigation.test.cjs
@@ -0,0 +1,100 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const source = readFileSync(require.resolve('../spatial-navigation.js'), 'utf8');
+const rect = (left, top, width = 100, height = 100) => ({ left, top, right: left + width, bottom: top + height });
+
+function setup(positions) {
+  let handler;
+  let focused = null;
+  const cards = positions.map((position, index) => {
+    const link = {
+      hidden: false,
+      getClientRects() { return this.hidden ? [] : [position]; },
+      focus() { focused = index; },
+    };
+    return {
+      position,
+      link,
+      inert: false,
+      querySelector: () => link,
+      closest() { return this.inert ? this : null; },
+      getBoundingClientRect() { return this.position; },
+    };
+  });
+  const grid = {
+    addEventListener: (_, callback) => { handler = callback; },
+    querySelectorAll: () => cards,
+  };
+  runInNewContext(source, { document: { querySelectorAll: () => [grid] } });
+  return {
+    cards,
+    press(index, key, overrides = {}) {
+      focused = index;
+      let prevented = false;
+      handler({ key, target: cards[index].link, preventDefault() { prevented = true; }, ...overrides });
+      return { focused, prevented };
+    },
+  };
+}
+
+test('three columns follow visual rows and columns without wrapping', () => {
+  const grid = setup([rect(0, 0), rect(120, 0), rect(240, 0), rect(0, 120), rect(120, 120), rect(240, 120)]);
+  assert.equal(grid.press(0, 'ArrowRight').focused, 1);
+  assert.equal(grid.press(1, 'ArrowLeft').focused, 0);
+  assert.equal(grid.press(1, 'ArrowDown').focused, 4);
+  assert.equal(grid.press(4, 'ArrowUp').focused, 1);
+  assert.deepEqual(grid.press(2, 'ArrowRight'), { focused: 2, prevented: true });
+  assert.deepEqual(grid.press(0, 'ArrowUp'), { focused: 0, prevented: true });
+});
+
+test('two columns support an incomplete last row', () => {
+  const grid = setup([rect(0, 0), rect(120, 0), rect(0, 120)]);
+  assert.equal(grid.press(0, 'ArrowDown').focused, 2);
+  assert.equal(grid.press(1, 'ArrowDown').focused, 2);
+  assert.equal(grid.press(2, 'ArrowUp').focused, 0);
+  assert.equal(grid.press(1, 'ArrowRight').focused, 1);
+});
+
+test('one column uses vertical arrows and keeps horizontal arrows at the edge', () => {
+  const grid = setup([rect(0, 0), rect(0, 120), rect(0, 240)]);
+  assert.equal(grid.press(0, 'ArrowDown').focused, 1);
+  assert.equal(grid.press(2, 'ArrowUp').focused, 1);
+  assert.equal(grid.press(1, 'ArrowRight').focused, 1);
+  assert.equal(grid.press(1, 'ArrowLeft').focused, 1);
+});
+
+test('visual order supports reversed layouts and resizing without reinitialization', () => {
+  const grid = setup([rect(240, 0), rect(120, 0), rect(0, 0)]);
+  assert.equal(grid.press(0, 'ArrowLeft').focused, 1);
+  assert.equal(grid.press(1, 'ArrowRight').focused, 0);
+  grid.cards.forEach((card, index) => { card.position = rect(0, index * 120); });
+  assert.equal(grid.press(0, 'ArrowDown').focused, 1);
+  assert.equal(grid.press(0, 'ArrowLeft').focused, 0);
+});
+
+test('hidden and inert cards are skipped', () => {
+  const grid = setup([rect(0, 0), rect(120, 0), rect(240, 0), rect(360, 0)]);
+  grid.cards[1].link.hidden = true;
+  grid.cards[2].inert = true;
+  assert.equal(grid.press(0, 'ArrowRight').focused, 3);
+});
+
+test('native activation, tabbing, modified keys and nested controls are left alone', () => {
+  const grid = setup([rect(0, 0), rect(120, 0)]);
+  for (const key of ['Tab', 'Enter', ' ', 'Escape']) {
+    assert.deepEqual(grid.press(0, key), { focused: 0, prevented: false });
+  }
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'defaultPrevented']) {
+    assert.equal(grid.press(0, 'ArrowRight', { [modifier]: true }).prevented, false);
+  }
+  assert.equal(grid.press(0, 'ArrowRight', { target: {} }).prevented, false);
+});
+
+test('unequal card heights preserve the vertical column', () => {
+  const grid = setup([rect(0, 0, 100, 160), rect(120, 0), rect(0, 180), rect(120, 180)]);
+  assert.equal(grid.press(3, 'ArrowUp').focused, 1);
+  assert.equal(grid.press(1, 'ArrowDown').focused, 3);
+});
