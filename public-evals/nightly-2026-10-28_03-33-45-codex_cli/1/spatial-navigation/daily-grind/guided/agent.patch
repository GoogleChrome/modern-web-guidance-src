diff --git a/spatial-navigation.mjs b/spatial-navigation.mjs
new file mode 100644
index 0000000..d7c9473
--- /dev/null
+++ b/spatial-navigation.mjs
@@ -0,0 +1,86 @@
+const directions = {
+  ArrowRight: { start: 'left', end: 'right', crossStart: 'top', crossEnd: 'bottom', sign: 1 },
+  ArrowLeft: { start: 'right', end: 'left', crossStart: 'top', crossEnd: 'bottom', sign: -1 },
+  ArrowDown: { start: 'top', end: 'bottom', crossStart: 'left', crossEnd: 'right', sign: 1 },
+  ArrowUp: { start: 'bottom', end: 'top', crossStart: 'left', crossEnd: 'right', sign: -1 },
+};
+
+// Rectangles are supplied fresh for every keypress, regardless of layout or DOM order.
+export function findSpatialTarget(current, candidates, key) {
+  const direction = directions[key];
+  if (!direction) return;
+  const { start, end, crossStart, crossEnd, sign } = direction;
+  const origin = current.rect;
+  const center = (origin[crossStart] + origin[crossEnd]) / 2;
+  let best;
+
+  for (const candidate of candidates) {
+    if (candidate.element === current.element) continue;
+    const rect = candidate.rect;
+    const gap = sign * (rect[start] - origin[end]);
+    if (gap < -1) continue; // Allow subpixel rounding at adjacent edges.
+
+    const aligned = Math.min(origin[crossEnd], rect[crossEnd]) >
+      Math.max(origin[crossStart], rect[crossStart]);
+    const offset = Math.abs((rect[crossStart] + rect[crossEnd]) / 2 - center);
+    const score = Math.max(0, gap) + 2 * offset;
+    const option = { candidate, aligned, gap, offset, score };
+
+    if (!best || (aligned && !best.aligned) ||
+        (aligned === best.aligned && (aligned
+          ? gap < best.gap || (gap === best.gap && offset < best.offset)
+          : score < best.score))) {
+      best = option;
+    }
+  }
+
+  return best?.candidate.element;
+}
+
+export function initializeSpatialNavigation(container) {
+  const items = () => Array.from(container.querySelectorAll('[data-spatial-item]'));
+  const candidates = () => items().filter(element => {
+    if (element.matches(':disabled') || element.closest('[hidden], [inert]')) return false;
+    if (typeof element.checkVisibility === 'function') {
+      return element.checkVisibility({ checkVisibilityCSS: true });
+    }
+    // Older browsers lack checkVisibility; rect checks below also exclude display:none.
+    const style = container.ownerDocument.defaultView.getComputedStyle(element);
+    return style.visibility !== 'hidden' && style.visibility !== 'collapse';
+  }).map(element => ({ element, rect: element.getBoundingClientRect() }))
+    .filter(({ rect }) => rect.width > 0 && rect.height > 0);
+
+  const setActive = active => {
+    items().forEach(element => { element.tabIndex = element === active ? 0 : -1; });
+  };
+
+  const initial = candidates();
+  const focused = initial.find(({ element }) => element === container.ownerDocument.activeElement);
+  setActive(focused?.element ?? initial[0]?.element);
+
+  container.addEventListener('focusin', event => {
+    const target = event.composedPath()[0];
+    if (candidates().some(({ element }) => element === target)) setActive(target);
+  });
+
+  container.addEventListener('keydown', event => {
+    if (!Object.hasOwn(directions, event.key) || event.defaultPrevented ||
+        event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.isComposing) return;
+
+    const target = event.composedPath()[0];
+    if (target.matches?.(':read-write, input, textarea, select, [role="slider"], [role="spinbutton"], [role="combobox"]')) return;
+
+    const available = candidates();
+    const current = available.find(({ element }) =>
+      element === target && element === container.ownerDocument.activeElement);
+    if (!current) return; // Leave nested controls and other descendants alone.
+
+    const next = findSpatialTarget(current, available, event.key);
+    if (!next) return; // Keep native viewport scrolling at the boundary.
+
+    event.preventDefault();
+    setActive(next);
+    next.focus({ preventScroll: true });
+    next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  });
+}
diff --git a/spatial-navigation.test.mjs b/spatial-navigation.test.mjs
new file mode 100644
index 0000000..0e42d12
--- /dev/null
+++ b/spatial-navigation.test.mjs
@@ -0,0 +1,155 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { findSpatialTarget, initializeSpatialNavigation } from './spatial-navigation.mjs';
+
+function entry(name, left, top, width = 100, height = 50) {
+  return {
+    element: name,
+    rect: { left, top, right: left + width, bottom: top + height, width, height },
+  };
+}
+
+test('arrows follow visual positions in a reordered, wrapped grid', () => {
+  const a = entry('a', 120, 0);
+  const b = entry('b', 0, 70);
+  const c = entry('c', 0, 0);
+  const d = entry('d', 120, 70);
+  const items = [a, b, c, d];
+  assert.equal(findSpatialTarget(c, items, 'ArrowRight'), 'a');
+  assert.equal(findSpatialTarget(a, items, 'ArrowLeft'), 'c');
+  assert.equal(findSpatialTarget(a, items, 'ArrowDown'), 'd');
+  assert.equal(findSpatialTarget(d, items, 'ArrowUp'), 'a');
+  assert.equal(findSpatialTarget(a, items, 'ArrowRight'), undefined);
+});
+
+test('single columns and reversed rows use physical arrow directions', () => {
+  const top = entry('top', 0, 0);
+  const bottom = entry('bottom', 0, 70);
+  assert.equal(findSpatialTarget(top, [bottom, top], 'ArrowDown'), 'bottom');
+  assert.equal(findSpatialTarget(bottom, [bottom, top], 'ArrowUp'), 'top');
+  assert.equal(findSpatialTarget(top, [top, bottom], 'ArrowRight'), undefined);
+  const right = entry('right', 120, 0);
+  assert.equal(findSpatialTarget(right, [right, top], 'ArrowLeft'), 'top');
+});
+
+test('aligned items win over closer diagonals, including wide asymmetric items', () => {
+  const current = entry('current', 0, 0, 300, 100);
+  const diagonal = entry('diagonal', 310, 110);
+  const aligned = entry('aligned', 400, 20);
+  const overlapping = entry('overlapping', 200, 0, 200, 50);
+  assert.equal(findSpatialTarget(current, [current, diagonal, overlapping, aligned], 'ArrowRight'), 'aligned');
+  assert.equal(findSpatialTarget(current, [current, overlapping], 'ArrowRight'), undefined);
+});
+
+test('aligned ties prefer the nearest perpendicular center; ragged rows use diagonal fallback', () => {
+  const current = entry('current', 120, 0);
+  const far = entry('far', 190, 70);
+  const near = entry('near', 120, 70);
+  assert.equal(findSpatialTarget(current, [current, far, near], 'ArrowDown'), 'near');
+  const ragged = entry('ragged', 0, 70);
+  const distant = entry('distant', 400, 70);
+  assert.equal(findSpatialTarget(current, [current, distant, ragged], 'ArrowDown'), 'ragged');
+});
+
+test('edge tolerance permits subpixel rounding without treating overlaps as directional', () => {
+  const current = entry('current', 0, 0);
+  const adjacent = entry('adjacent', 99.5, 0);
+  assert.equal(findSpatialTarget(current, [current, adjacent], 'ArrowRight'), 'adjacent');
+});
+
+// Minimal DOM doubles exercise the event contract without a browser or server.
+function widget(rectangles, { legacy = false } = {}) {
+  const listeners = {};
+  const document = {
+    activeElement: null,
+    defaultView: { getComputedStyle: item => ({ visibility: item.visible ? 'visible' : 'hidden' }) },
+  };
+  const items = rectangles.map((rect, index) => ({
+    rect, index, visible: true, excluded: false, disabled: false, editable: false, tabIndex: 0,
+    checkVisibility: legacy ? undefined : function () { return this.visible; },
+    matches(selector) { return selector === ':disabled' ? this.disabled : this.editable; },
+    closest() { return this.excluded ? {} : null; },
+    getBoundingClientRect() { return this.rect; },
+    focus() { document.activeElement = this; listeners.focusin({ composedPath: () => [this] }); },
+    scrollIntoView(options) { this.scrollOptions = options; },
+  }));
+  const container = {
+    ownerDocument: document,
+    querySelectorAll: () => items,
+    addEventListener: (name, callback) => { listeners[name] = callback; },
+  };
+  const press = (key, overrides = {}) => {
+    const event = {
+      key, defaultPrevented: false,
+      composedPath: () => [document.activeElement],
+      preventDefault() { this.defaultPrevented = true; },
+      ...overrides,
+    };
+    listeners.keydown(event);
+    return event;
+  };
+  return { container, items, document, press };
+}
+
+test('roving focus remembers pointer focus, scrolls minimally, and reads layout changes live', () => {
+  const grid = widget([entry('', 0, 0).rect, entry('', 120, 0).rect, entry('', 240, 0).rect]);
+  initializeSpatialNavigation(grid.container);
+  assert.deepEqual(grid.items.map(item => item.tabIndex), [0, -1, -1]);
+  assert.equal(grid.document.activeElement, null, 'initialization must not steal focus');
+  grid.items[1].focus();
+  assert.deepEqual(grid.items.map(item => item.tabIndex), [-1, 0, -1]);
+  assert.equal(grid.press('ArrowRight').defaultPrevented, true);
+  assert.equal(grid.document.activeElement, grid.items[2]);
+  assert.deepEqual(grid.items[2].scrollOptions, { block: 'nearest', inline: 'nearest' });
+  assert.deepEqual(grid.items.map(item => item.tabIndex), [-1, -1, 0]);
+  grid.items[0].rect = entry('', 0, 0).rect;
+  grid.items[1].rect = entry('', 0, 70).rect;
+  grid.items[2].rect = entry('', 0, 140).rect;
+  assert.equal(grid.press('ArrowUp').defaultPrevented, true);
+  assert.equal(grid.document.activeElement, grid.items[1]);
+});
+
+test('boundaries, modifiers, editing, nested controls, and native activation stay untouched', () => {
+  const grid = widget([entry('', 0, 0).rect, entry('', 120, 0).rect]);
+  initializeSpatialNavigation(grid.container);
+  grid.items[0].focus();
+  for (const key of ['ArrowLeft', 'ArrowUp', 'Tab', 'Enter', ' ']) {
+    assert.equal(grid.press(key).defaultPrevented, false);
+  }
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'isComposing']) {
+    assert.equal(grid.press('ArrowRight', { [modifier]: true }).defaultPrevented, false);
+  }
+  grid.press('ArrowRight', { defaultPrevented: true });
+  assert.equal(grid.document.activeElement, grid.items[0]);
+  grid.items[0].editable = true;
+  assert.equal(grid.press('ArrowRight').defaultPrevented, false);
+  grid.items[0].editable = false;
+  const nested = { matches: () => false };
+  assert.equal(grid.press('ArrowRight', { composedPath: () => [nested, grid.items[0]] }).defaultPrevented, false);
+  assert.equal(grid.document.activeElement, grid.items[0]);
+});
+
+for (const legacy of [false, true]) {
+  test(`hidden, inert, disabled, and zero-size items are skipped (legacy visibility: ${legacy})`, () => {
+    const grid = widget(Array.from({ length: 6 }, (_, i) => entry('', 120 * i, 0).rect), { legacy });
+    grid.items[1].visible = false;
+    grid.items[2].excluded = true;
+    grid.items[3].disabled = true;
+    grid.items[4].rect.width = 0;
+    initializeSpatialNavigation(grid.container);
+    grid.items[0].focus();
+    assert.equal(grid.press('ArrowRight').defaultPrevented, true);
+    assert.equal(grid.document.activeElement, grid.items[5]);
+  });
+}
+
+test('empty widgets initialize safely and independent widgets keep separate tab stops', () => {
+  initializeSpatialNavigation(widget([]).container);
+  for (let i = 0; i < 2; i++) {
+    const grid = widget([entry('', 0, 0).rect]);
+    initializeSpatialNavigation(grid.container);
+    grid.items[0].focus();
+    assert.equal(grid.items[0].tabIndex, 0);
+    assert.equal(grid.press('ArrowDown').defaultPrevented, false);
+  }
+});
