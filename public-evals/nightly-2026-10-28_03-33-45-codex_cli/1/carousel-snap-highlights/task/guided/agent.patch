+  <script>
+    // Keep the centered highlight available without scroll-state query support.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      const items = carousel.querySelectorAll('.carousel-item');
+      let observer;
+
+      const observeCenter = () => {
+        observer?.disconnect();
+        observer = new IntersectionObserver(entries => {
+          entries.forEach(entry => {
+            entry.target.classList.toggle('is-snapped', entry.isIntersecting);
+          });
+        }, {
+          root: carousel,
+          rootMargin: `0px -${carousel.clientWidth * 0.49}px`,
+          threshold: 0
+        });
+        items.forEach(item => observer.observe(item));
+      };
+
+      new ResizeObserver(observeCenter).observe(carousel);
+    }
+  </script>
