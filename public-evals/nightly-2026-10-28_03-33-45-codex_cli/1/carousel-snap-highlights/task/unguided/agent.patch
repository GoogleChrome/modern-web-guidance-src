+  <script>
+    const carousel = document.querySelector('.carousel');
+    const items = [...carousel.querySelectorAll('.carousel-item')];
+    let pendingFrame = null;
+
+    function updateCenteredCard() {
+      const bounds = carousel.getBoundingClientRect();
+      const center = bounds.left + carousel.clientLeft + carousel.clientWidth / 2;
+      let closest = items[0];
+      let closestDistance = Infinity;
+
+      for (const item of items) {
+        const rect = item.getBoundingClientRect();
+        const distance = Math.abs(rect.left + rect.width / 2 - center);
+        if (distance < closestDistance) {
+          closest = item;
+          closestDistance = distance;
+        }
+      }
+
+      for (const item of items) {
+        item.classList.toggle('is-active', item === closest);
+      }
+      pendingFrame = null;
+    }
+
+    function scheduleUpdate() {
+      if (pendingFrame === null) {
+        pendingFrame = requestAnimationFrame(updateCenteredCard);
+      }
+    }
+
+    carousel.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    updateCenteredCard();
+  </script>
+
 </body>
 
