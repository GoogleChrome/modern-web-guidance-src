@@ -206,7 +278,53 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const mailingListEmail = document.getElementById('mailing-list-email');
+    const mailingListError = document.getElementById('mailing-list-error');
+    const mailingListStatus = document.getElementById('mailing-list-status');
+    let emailTouched = false;
+
+    function validateEmail() {
+      let message = '';
+      if (!mailingListEmail.value.trim()) {
+        message = 'Please enter your email address.';
+      } else if (!mailingListEmail.validity.valid) {
+        message = 'Please enter a valid email address.';
+      }
+      mailingListError.textContent = message;
+      if (message) {
+        mailingListEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        mailingListEmail.removeAttribute('aria-invalid');
+      }
+      return !message;
+    }
+
+    mailingListEmail.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    mailingListEmail.addEventListener('input', () => {
+      mailingListError.textContent = '';
+      mailingListEmail.removeAttribute('aria-invalid');
+      mailingListStatus.textContent = '';
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!mailingListEmail.value.trim() || !mailingListEmail.validity.valid) {
+        if (emailTouched) validateEmail();
+        mailingListEmail.focus();
+        return;
+      }
+      // Connect a mailing-list provider before accepting subscriptions.
+      mailingListStatus.textContent = 'Mailing list signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
