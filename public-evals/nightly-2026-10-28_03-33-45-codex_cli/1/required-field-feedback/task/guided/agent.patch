+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const emailInput = document.getElementById('mailing-list-email');
+    const signupStatus = document.getElementById('mailing-list-status');
+
+    const syncEmailError = () => {
+      if (emailInput.validity.valid) {
+        emailInput.removeAttribute('aria-invalid');
+      } else {
+        emailInput.setAttribute('aria-invalid', 'true');
+      }
+    };
+
+    // A visit followed by blur counts as interaction, even without typing.
+    emailInput.addEventListener('blur', syncEmailError);
+    emailInput.addEventListener('invalid', syncEmailError);
+    emailInput.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      if (emailInput.validity.valid) {
+        emailInput.removeAttribute('aria-invalid');
+      }
+    });
+
+    mailingList.addEventListener('reset', () => {
+      emailInput.removeAttribute('aria-invalid');
+      signupStatus.textContent = '';
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing-list provider here before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
