+export default function SearchFlyout({ id, articles }: Props) {
+  const [searchTerm, setSearchTerm] = useState('');
+  const inputId = useId();
+  const query = searchTerm.trim().toLowerCase();
+  const filteredArticles = useMemo(() => articles.filter(article =>
+    article.title.toLowerCase().includes(query) || article.summary.toLowerCase().includes(query)
+  ), [articles, query]);
+  const results = query ? filteredArticles : articles.slice(0, 3);
+
+  return (
+    <Modal id={id} title="Search articles">
+      <search className="block p-4">
+        <form onSubmit={event => event.preventDefault()}>
+          <label htmlFor={inputId} className="block text-sm font-semibold mb-2">Search for articles</label>
+          <input id={inputId} name="q" type="search" autoComplete="on" autoCorrect="off" autoCapitalize="off" spellCheck={false} enterKeyHint="search"
+            className="w-full p-2 border border-gray-400 rounded-md" value={searchTerm}
+            onChange={event => setSearchTerm(event.target.value)} autoFocus />
+          <button type="submit" className="mt-2 p-2 font-semibold">Search</button>
+        </form>
+      </search>
+      <div className="p-4">
+        <h3 className="font-semibold mb-3">{query ? 'Results' : 'Featured'}</h3>
+        <p role="status" className="text-sm text-gray-600 mb-3">{query ? `${results.length} articles found.` : ''}</p>
+        {query && results.length === 0 && <p>No results found for “{searchTerm}”.</p>}
+        <ul className="space-y-2" role="list">
+          {results.map(article => (
+            <li key={article.slug}>
+              <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md">
+                <h4 className="font-bold text-lg">{article.title}</h4>
+                <p className="text-sm text-gray-600">{article.summary}</p>
+              </a>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </Modal>
+  );
 }
