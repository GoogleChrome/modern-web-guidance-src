diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..771e2bf
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,22 @@
+import type { ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  children: ReactNode;
+  focusClose?: boolean;
+}
+
+export default function Modal({ id, title, children, focusClose = false }: Props) {
+  return (
+    <dialog id={id} aria-labelledby={`${id}-title`} closedby="any" className="content-dialog bg-white text-gray-900 shadow-xl">
+      <header className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <form method="dialog">
+          <button type="submit" autoFocus={focusClose} className="p-2 text-sm font-semibold">Close</button>
+        </form>
+      </header>
+      {children}
+    </dialog>
+  );
+}
