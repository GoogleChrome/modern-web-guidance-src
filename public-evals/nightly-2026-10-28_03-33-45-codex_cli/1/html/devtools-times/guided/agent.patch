+}
+:where(a, button, input, [tabindex]):focus-visible {
+  outline: 3px solid #1d4ed8;
+  outline-offset: 3px;
+}
+
+button {
+  min-inline-size: 24px;
+  min-block-size: 24px;
+}
+
+.skip-link {
+  position: fixed;
+  inset-block-start: 0.5rem;
+  inset-inline-start: 0.5rem;
+  z-index: 100;
+  padding: 0.75rem 1rem;
+  color: white;
+  background: #111827;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.content-dialog {
+  inline-size: min(42rem, calc(100% - 2rem));
+  max-block-size: calc(100dvh - 2rem);
+  margin: auto;
+  padding: 0;
+  border: 0;
+  overflow-y: auto;
+}
+
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background: rgb(255 255 255 / 0.45);
+  backdrop-filter: blur(4px);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+.navigation-popover {
+  position: fixed;
+  inset: 1rem;
+  inline-size: min(72rem, calc(100% - 2rem));
+  max-block-size: calc(100dvh - 2rem);
+  margin: auto;
+  overflow-y: auto;
+}
+
+/* The polyfill exposes a class where the native pseudo-class is unavailable. */
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+input {
+  font-size: 1rem;
+  min-block-size: 3rem;
+}
+
+input:user-invalid {
+  border-color: #b91c1c;
+}
+
+@media (pointer: coarse) {
+  button {
+    min-inline-size: 44px;
+    min-block-size: 44px;
+  }
+}
