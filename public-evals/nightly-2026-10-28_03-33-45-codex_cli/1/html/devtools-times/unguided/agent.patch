+}
+.skip-link:focus { transform: translateY(0); }
+:focus-visible { outline: 3px solid #b45309; outline-offset: 3px; }
+.modal {
+  position: fixed;
+  inset: 0;
+  margin: 15vh auto auto;
+  width: min(42rem, calc(100vw - 2rem));
+  max-height: 80vh;
+  max-height: 80dvh;
+  overflow: auto;
+  border: 0;
+  padding: 0;
+}
+.modal::backdrop { background: rgb(255 255 255 / .4); backdrop-filter: blur(4px); }
+html:has(dialog[open]) { overflow: hidden; }
+.navigation-popover {
+  position: fixed;
+  inset: 10rem 0 auto;
+  margin-inline: auto;
+  width: min(72rem, calc(100vw - 2rem));
+  max-height: calc(100dvh - 11rem);
+  overflow: auto;
+  padding: 0;
+}
