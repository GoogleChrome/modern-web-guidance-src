@@ -206,7 +272,49 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    function clearEmailError() {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterError.textContent = '';
+    }
+
+    function validateEmail() {
+      newsletterEmail.value = newsletterEmail.value.trim();
+      const valid = newsletterEmail.validity.valid;
+      if (valid) {
+        clearEmailError();
+      } else {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+        newsletterError.textContent = newsletterEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.';
+      }
+      return valid;
+    }
+
+    newsletterEmail.addEventListener('blur', validateEmail);
+    newsletterEmail.addEventListener('focus', clearEmailError);
+    newsletterEmail.addEventListener('input', () => {
+      clearEmailError();
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      newsletterEmail.blur();
+      if (!validateEmail()) return;
+
+      // Replace this message with a request to the newsletter service when configured.
+      newsletterStatus.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
