+  <script>
+    // Native sibling functions automatically track DOM changes. This fallback
+    // provides the same zero-based index and count without fixed nth-child rules.
+    if (!CSS.supports('order', 'sibling-index()') || !CSS.supports('z-index', 'sibling-count()')) {
+      const groups = '.grid, .fan-container, .circle-container';
+      const updateCollections = () => {
+        document.querySelectorAll(groups).forEach((group) => {
+          const items = Array.from(group.children);
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index);
+            item.style.setProperty('--item-count', items.length);
+          });
+        });
+      };
+      updateCollections();
+      new MutationObserver(updateCollections).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true,
+      });
+    }
+  </script>
