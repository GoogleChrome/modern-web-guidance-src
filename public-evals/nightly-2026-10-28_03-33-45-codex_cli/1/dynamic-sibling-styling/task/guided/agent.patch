+  <script>
+    // Older browsers get the same live sibling data; modern browsers use CSS alone.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const itemSelector = '.spectrum-card, .fan-card, .circle-orb';
+      const groups = new Set(
+        [...document.querySelectorAll(itemSelector)].map(item => item.parentElement)
+      );
+      const updateSiblings = group => {
+        const siblings = [...group.children];
+        siblings.forEach((item, index) => {
+          if (item.matches(itemSelector)) {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', siblings.length);
+          }
+        });
+      };
+      const observer = new MutationObserver(records => {
+        new Set(records.map(record => record.target)).forEach(updateSiblings);
+      });
+      groups.forEach(group => {
+        updateSiblings(group);
+        observer.observe(group, { childList: true });
+      });
+    }
+  </script>
+
