+  <script>
+    const previews = document.querySelectorAll('.drink-preview');
+    let activePreview = null;
+    let closeTimer;
+
+    function positionPreview() {
+      if (!activePreview) return;
+      const trigger = activePreview.querySelector('.btn');
+      const panel = activePreview.querySelector('.hovercard');
+      const bounds = trigger.getBoundingClientRect();
+      const margin = 16;
+      const gap = 10;
+      const left = Math.max(margin, Math.min(
+        bounds.left + bounds.width / 2 - panel.offsetWidth / 2,
+        window.innerWidth - panel.offsetWidth - margin
+      ));
+      const above = bounds.top - panel.offsetHeight - gap;
+      const top = above >= margin ? above : Math.max(margin, Math.min(
+        bounds.bottom + gap,
+        window.innerHeight - panel.offsetHeight - margin
+      ));
+      panel.style.left = `${left}px`;
+      panel.style.top = `${top}px`;
+    }
+
+    function closePreview() {
+      clearTimeout(closeTimer);
+      if (!activePreview) return;
+      activePreview.querySelector('.hovercard').hidden = true;
+      activePreview.querySelector('.btn').setAttribute('aria-expanded', 'false');
+      activePreview = null;
+    }
+
+    function openPreview(preview) {
+      clearTimeout(closeTimer);
+      if (activePreview !== preview) closePreview();
+      activePreview = preview;
+      preview.querySelector('.hovercard').hidden = false;
+      preview.querySelector('.btn').setAttribute('aria-expanded', 'true');
+      positionPreview();
+    }
+
+    previews.forEach(preview => {
+      let hovered = false;
+      function scheduleClose() {
+        clearTimeout(closeTimer);
+        closeTimer = setTimeout(() => {
+          if (activePreview === preview && !hovered && !preview.contains(document.activeElement)) {
+            closePreview();
+          }
+        }, 180);
+      }
+      preview.addEventListener('pointerenter', event => {
+        if (event.pointerType === 'touch') return;
+        hovered = true;
+        openPreview(preview);
+      });
+      preview.addEventListener('pointerleave', () => {
+        hovered = false;
+        scheduleClose();
+      });
+      preview.addEventListener('focusin', () => openPreview(preview));
+      preview.addEventListener('focusout', scheduleClose);
+    });
+
+    document.addEventListener('keydown', event => {
+      if (event.key !== 'Escape' || !activePreview) return;
+      if (activePreview.querySelector('.hovercard').contains(document.activeElement)) {
+        activePreview.querySelector('.btn').focus();
+      }
+      closePreview();
+    });
+    document.addEventListener('pointerdown', event => {
+      if (activePreview && !activePreview.contains(event.target)) closePreview();
+    });
+    window.addEventListener('resize', positionPreview);
+    document.addEventListener('scroll', positionPreview, true);
+  </script>
