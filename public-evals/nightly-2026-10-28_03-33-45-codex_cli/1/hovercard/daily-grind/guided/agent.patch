+  <script type="module">
+    // Load compatibility support only where the native APIs are missing.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+    }
+
+    // Older Popover implementations treat an unknown "hint" value as manual.
+    // Use auto there to retain Escape and outside-click dismissal.
+    const hintProbe = document.createElement("div");
+    hintProbe.popover = "hint";
+    if (hintProbe.popover !== "hint") {
+      document.querySelectorAll('.drink-preview[popover="hint"]').forEach(panel => {
+        panel.popover = "auto";
+      });
+    }
+
+    // Keep previews beside their links where CSS anchor positioning is unavailable.
+    if (!CSS.supports("position-area", "block-end span-inline-end")) {
+      const previews = [...document.querySelectorAll("[interestfor]")].map(link => ({
+        link,
+        panel: document.getElementById(link.getAttribute("interestfor"))
+      }));
+      const positionPreview = ({ link, panel }) => {
+        if (!panel.matches(":is(:popover-open, .\\:popover-open)")) return;
+        const rect = link.getBoundingClientRect();
+        const gap = 8;
+        const edge = 12;
+        const width = panel.offsetWidth;
+        const height = panel.offsetHeight;
+        const left = Math.max(edge, Math.min(rect.left, innerWidth - width - edge));
+        const below = rect.bottom + gap;
+        const top = below + height <= innerHeight - edge ? below : rect.top - height - gap;
+        panel.style.margin = "0";
+        panel.style.left = `${left}px`;
+        panel.style.top = `${Math.max(edge, Math.min(top, innerHeight - height - edge))}px`;
+      };
+      for (const preview of previews) {
+        preview.panel.addEventListener("beforetoggle", event => {
+          if (event.newState === "open") requestAnimationFrame(() => positionPreview(preview));
+        });
+      }
+      const reposition = () => previews.forEach(positionPreview);
+      window.addEventListener("resize", reposition);
+      document.addEventListener("scroll", reposition, { capture: true, passive: true });
+    }
+
+    if (!Object.hasOwn(HTMLButtonElement.prototype, "interestForElement")) {
+      await import("https://unpkg.com/interestfor@1.0.10/src/interestfor.min.js");
+    }
+  </script>
