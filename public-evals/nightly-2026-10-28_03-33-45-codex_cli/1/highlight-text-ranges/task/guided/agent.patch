+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menu = document.getElementById('seasonal-menu');
+    const supportsHighlights = Boolean(window.CSS?.highlights && window.Highlight);
+
+    function collectTextNodes() {
+      return Array.from(menu.querySelectorAll('.card')).flatMap((card) => {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+        return nodes;
+      });
+    }
+
+    let textNodes = collectTextNodes();
+
+    function highlightMatches() {
+      if (supportsHighlights) {
+        CSS.highlights.delete('menu-search');
+      } else {
+        menu.querySelectorAll('mark.menu-match').forEach((mark) => {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        menu.normalize();
+        textNodes = collectTextNodes();
+      }
+
+      const query = searchInput.value.toLowerCase();
+      if (!query.trim()) return;
+
+      const ranges = [];
+      for (const node of textNodes) {
+        const text = node.textContent;
+        const searchableText = text.toLowerCase();
+        let index = searchableText.indexOf(query);
+        if (index === -1) continue;
+
+        const fragment = supportsHighlights ? null : document.createDocumentFragment();
+        let offset = 0;
+        while (index !== -1) {
+          const end = index + query.length;
+          if (supportsHighlights) {
+            const range = document.createRange();
+            range.setStart(node, index);
+            range.setEnd(node, end);
+            ranges.push(range);
+          } else {
+            fragment.append(text.slice(offset, index));
+            const mark = document.createElement('mark');
+            mark.className = 'menu-match';
+            mark.textContent = text.slice(index, end);
+            fragment.append(mark);
+          }
+          offset = end;
+          index = searchableText.indexOf(query, end);
+        }
+
+        if (fragment) {
+          fragment.append(text.slice(offset));
+          node.replaceWith(fragment);
+        }
+      }
+
+      if (supportsHighlights) {
+        CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+    }
+
+    searchInput.addEventListener('input', highlightMatches);
+    highlightMatches();
+  </script>
+
 </body>
 
