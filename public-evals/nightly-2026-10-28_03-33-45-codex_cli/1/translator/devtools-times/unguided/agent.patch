diff --git a/src/components/TranslationControl.tsx b/src/components/TranslationControl.tsx
new file mode 100644
index 0000000..06ee774
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,147 @@
+import { useEffect, useRef, useState } from 'react';
+import { LanguageIcon, ArrowPathIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { captureTranslation, restoreTranslation, type TranslationSnapshot } from '../utils/translation';
+
+type Translator = {
+  translate(text: string, options: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+};
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<'unavailable' | 'downloadable' | 'downloading' | 'available'>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }): void;
+  }): Promise<Translator>;
+};
+
+const languages = [
+  ['en', 'English (original)'], ['es', 'Español'], ['fr', 'Français'],
+  ['de', 'Deutsch'], ['it', 'Italiano'], ['pt', 'Português'],
+  ['nl', 'Nederlands'], ['pl', 'Polski'], ['uk', 'Українська'],
+  ['tr', 'Türkçe'], ['ar', 'العربية'], ['hi', 'हिन्दी'],
+  ['bn', 'বাংলা'], ['ja', '日本語'], ['ko', '한국어'], ['zh', '中文'],
+];
+
+export default function TranslationControl() {
+  const [visible, setVisible] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [target, setTarget] = useState('es');
+  const [current, setCurrent] = useState('en');
+  const [busy, setBusy] = useState(false);
+  const [status, setStatus] = useState('');
+  const snapshot = useRef<TranslationSnapshot | null>(null);
+  const operation = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    setVisible(Boolean(document.querySelector('[data-translatable]')));
+    setSupported('Translator' in window && window.isSecureContext);
+    // Astro's client router can navigate away while a model is downloading.
+    const cancel = () => operation.current?.abort();
+    document.addEventListener('astro:before-swap', cancel);
+    return () => {
+      cancel();
+      document.removeEventListener('astro:before-swap', cancel);
+    };
+  }, []);
+
+  function showOriginal() {
+    operation.current?.abort();
+    if (snapshot.current) restoreTranslation(snapshot.current);
+    setBusy(false);
+    setCurrent('en');
+    setStatus('Showing the original English articles.');
+  }
+
+  async function translate() {
+    if (target === 'en') return showOriginal();
+    if (busy) return;
+    const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    if (!api) return;
+    const controller = new AbortController();
+    operation.current = controller;
+    const { signal } = controller;
+    let translator: Translator | undefined;
+    setBusy(true);
+    setStatus('Checking language availability…');
+    try {
+      const pair = { sourceLanguage: 'en', targetLanguage: target };
+      const availability = await api.availability(pair);
+      signal.throwIfAborted();
+      if (availability === 'unavailable') {
+        setStatus('This language is unavailable on your device. Please choose another language.');
+        return;
+      }
+      setStatus(availability === 'available' ? 'Translating on your device…' : 'Preparing language download. This may take a moment…');
+      translator = await api.create({
+        ...pair, signal,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (!signal.aborted) setStatus(`Downloading language pack… ${Math.round(event.loaded * 100)}%`);
+          });
+        },
+      });
+      signal.throwIfAborted();
+      snapshot.current ??= captureTranslation(document.querySelector('main') ?? document);
+      const original = snapshot.current;
+      const results: string[] = [];
+      const cache = new Map<string, string>();
+      for (const [index, { original: text }] of original.texts.entries()) {
+        signal.throwIfAborted();
+        setStatus(`Translating on your device… ${Math.round(index / original.texts.length * 100)}%`);
+        const trimmed = text.trim();
+        let translated = cache.get(trimmed);
+        if (translated === undefined) {
+          translated = await translator.translate(trimmed, { signal });
+          if (!translated.trim()) throw new Error('Empty translation');
+          cache.set(trimmed, translated);
+        }
+        results.push(text.replace(/\S[\s\S]*\S|\S/, () => translated!));
+      }
+      signal.throwIfAborted();
+      // Commit only after every translation succeeds, so errors leave the page intact.
+      original.texts.forEach(({ node }, index) => { node.data = results[index]; });
+      original.roots.forEach(({ element }) => {
+        element.lang = target;
+        element.dir = target === 'ar' ? 'rtl' : 'ltr';
+      });
+      setCurrent(target);
+      const languageName = languages.find(([code]) => code === target)?.[1] ?? target;
+      setStatus(`Showing articles in ${languageName}. Translated on your device; machine translations may contain errors.`);
+    } catch {
+      if (!signal.aborted) setStatus('Translation could not finish. Please try again. A language pack download may need an internet connection.');
+    } finally {
+      translator?.destroy();
+      if (!signal.aborted) setBusy(false);
+    }
+  }
+
+  if (!visible) return null;
+  return (
+    <section aria-label="Article translation" className="border-b border-amber-200 bg-amber-50/70 px-4 py-4 sm:px-6">
+      <div className="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
+        <div className="flex items-center gap-3">
+          <LanguageIcon className="h-6 w-6 text-amber-800" aria-hidden="true" />
+          <div>
+            <h2 className="font-brand text-xl text-gray-900">Read in your language</h2>
+            <p className="flex items-center gap-1 text-xs text-gray-600"><ShieldCheckIcon className="h-3.5 w-3.5" aria-hidden="true" /> On-device translation · Your article text stays in your browser</p>
+          </div>
+        </div>
+        <div className="flex flex-wrap items-center gap-2">
+          <label className="sr-only" htmlFor="translation-language">Translate articles to</label>
+          <select id="translation-language" value={target} onChange={event => setTarget(event.target.value)} disabled={busy || !supported} className="max-w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus-visible:outline-2 focus-visible:outline-amber-700 disabled:opacity-50">
+            {languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+          </select>
+          <button onClick={translate} disabled={busy || !supported || target === current} className="flex items-center gap-2 rounded bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 disabled:cursor-not-allowed disabled:opacity-50">
+            {busy && <ArrowPathIcon className="h-4 w-4 animate-spin" aria-hidden="true" />}
+            {busy ? 'Translating…' : 'Translate'}
+          </button>
+          {(current !== 'en' || busy) && <button onClick={showOriginal} className="rounded px-2 py-2 text-sm text-amber-900 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-amber-700">{busy ? 'Cancel' : 'Show original'}</button>}
+        </div>
+      </div>
+      <p role="status" aria-live="polite" aria-atomic="true" className="mt-2 text-xs text-gray-600">
+        {!supported ? 'On-device translation is unavailable in this browser. Try a supported desktop browser such as Chrome over HTTPS.' : status || 'Translate article headlines, teasers, and full stories. Your browser may download a language pack the first time.'}
+      </p>
+    </section>
+  );
+}
