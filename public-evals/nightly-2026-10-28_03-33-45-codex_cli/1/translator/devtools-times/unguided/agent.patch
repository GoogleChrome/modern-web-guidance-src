diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..39a429d
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,38 @@
+export interface TranslationSnapshot {
+  roots: { element: HTMLElement; lang: string | null; dir: string | null }[];
+  texts: { node: Text; original: string }[];
+}
+
+// Keep the original DOM, links, and inline formatting intact. Never translate code.
+export function captureTranslation(root: ParentNode): TranslationSnapshot {
+  const roots = Array.from(root.querySelectorAll<HTMLElement>('[data-translatable]'))
+    .filter(element => !element.parentElement?.closest('[data-translatable]'));
+  const texts: TranslationSnapshot['texts'] = [];
+  for (const element of roots) {
+    const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        return node.textContent?.trim() &&
+          !node.parentElement?.closest('script, style, pre, code, [translate="no"]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      },
+    });
+    while (walker.nextNode()) {
+      const node = walker.currentNode as Text;
+      texts.push({ node, original: node.data });
+    }
+  }
+  return {
+    roots: roots.map(element => ({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') })),
+    texts,
+  };
+}
+
+export function restoreTranslation(snapshot: TranslationSnapshot) {
+  for (const { node, original } of snapshot.texts) node.data = original;
+  for (const { element, lang, dir } of snapshot.roots) {
+    if (lang === null) element.removeAttribute('lang');
+    else element.setAttribute('lang', lang);
+    if (dir === null) element.removeAttribute('dir');
+    else element.setAttribute('dir', dir);
+  }
+}
