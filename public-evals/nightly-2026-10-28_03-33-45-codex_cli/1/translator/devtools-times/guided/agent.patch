diff --git a/src/components/TranslationControl.astro b/src/components/TranslationControl.astro
new file mode 100644
index 0000000..031e4ed
--- /dev/null
+++ b/src/components/TranslationControl.astro
@@ -0,0 +1,88 @@
+---
+const languages = [
+  ['en', 'English'], ['ar', 'العربية'], ['bn', 'বাংলা'], ['zh', '中文'],
+  ['zh-Hant', '繁體中文'], ['nl', 'Nederlands'], ['fr', 'Français'],
+  ['de', 'Deutsch'], ['hi', 'हिन्दी'], ['id', 'Bahasa Indonesia'],
+  ['it', 'Italiano'], ['ja', '日本語'], ['ko', '한국어'], ['pl', 'Polski'],
+  ['pt', 'Português'], ['ru', 'Русский'], ['es', 'Español'],
+  ['tr', 'Türkçe'], ['uk', 'Українська'], ['vi', 'Tiếng Việt'],
+];
+---
+
+<section data-translation-control aria-label="Article translation" class="translation-bar" hidden>
+  <div class="translation-intro">
+    <span class="translation-icon" aria-hidden="true">
+      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
+        <path d="M4 5h12M10 3v2M7 5c0 5 3 8 7 10M14 5c0 5-4 9-10 12M14 21l4-11 4 11M15.5 17h5" />
+      </svg>
+    </span>
+    <div>
+      <h2>Read in your language</h2>
+      <p>On-device translation <span aria-hidden="true">·</span> Your reading stays private</p>
+    </div>
+  </div>
+  <div class="translation-actions">
+    <label for="reading-language" class="sr-only">Translate articles into</label>
+    <select id="reading-language" aria-describedby="translation-status" disabled>
+      {languages.map(([code, name]) => <option value={code} lang={code} selected={code === 'es'}>{name}</option>)}
+    </select>
+    <button type="button" data-translate-button disabled>Translate</button>
+    <button type="button" data-original-button class="translation-original" hidden>Show original</button>
+  </div>
+  <div class="translation-feedback">
+    <p id="translation-status" role="status" aria-live="polite" aria-atomic="true">Checking on-device translation…</p>
+    <progress data-translation-progress aria-label="Translation progress" max="1" hidden></progress>
+  </div>
+</section>
+
+<script>
+  import { initializeTranslation } from '../scripts/translation';
+
+  let cleanup: (() => void) | undefined;
+  document.addEventListener('astro:page-load', () => {
+    cleanup?.();
+    const control = document.querySelector<HTMLElement>('[data-translation-control]');
+    cleanup = control ? initializeTranslation(control) : undefined;
+  });
+  document.addEventListener('astro:before-swap', () => {
+    cleanup?.();
+    cleanup = undefined;
+  });
+</script>
+
+<style>
+  .translation-bar {
+    margin: 0 1.5rem;
+    padding: 1.25rem 0;
+    border-bottom: 1px solid #e5e7eb;
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 0.9rem 1.5rem;
+    font-family: system-ui, sans-serif;
+  }
+  [hidden] { display: none !important; }
+  .translation-intro { display: flex; align-items: center; gap: 0.75rem; flex: 1; }
+  .translation-icon {
+    display: grid; place-items: center; background: #fffbeb; color: #92400e;
+    border: 1px solid #fde68a; border-radius: 50%; width: 42px; height: 42px; flex-shrink: 0;
+  }
+  h2 { font-size: 0.9rem; font-weight: 650; color: #1f2937; }
+  .translation-intro p { font-size: 0.72rem; color: #6b7280; margin-top: 0.2rem; }
+  .translation-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
+  select, button { min-height: 40px; border-radius: 4px; font-size: 0.8rem; }
+  select { border: 1px solid #d1d5db; padding: 0.5rem 1.7rem 0.5rem 0.75rem; background: white; max-width: 100%; }
+  button { background: #1f2937; color: white; padding: 0.5rem 1rem; font-weight: 600; cursor: pointer; }
+  button:hover:enabled { background: #374151; }
+  button:disabled, select:disabled { opacity: 0.55; cursor: not-allowed; }
+  button:focus-visible, select:focus-visible { outline: 2px solid #b45309; outline-offset: 3px; }
+  .translation-original { background: transparent; color: #92400e; padding-inline: 0.5rem; }
+  .translation-original:hover:enabled { background: #fffbeb; }
+  .translation-feedback { flex-basis: 100%; color: #6b7280; font-size: 0.75rem; }
+  progress { display: block; margin-top: 0.6rem; width: 100%; height: 5px; accent-color: #b45309; }
+  @media (max-width: 640px) {
+    .translation-bar { margin-inline: 1rem; }
+    .translation-intro, .translation-actions { flex-basis: 100%; }
+    select { flex: 1; }
+  }
+</style>
