diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..5085254
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,217 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type LocalTranslator = {
+  translate(text: string, options?: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<LocalTranslator>;
+};
+
+// Translate text nodes, never HTML: article links, emphasis, and embedded widgets survive.
+function collectText(element: HTMLElement) {
+  const nodes: { node: Text; original: string }[] = [];
+  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      return node.textContent?.trim() && !node.parentElement?.closest(
+        'script, style, pre, code, button, input, textarea, select, [translate="no"], [data-translation-control]',
+      ) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  while (walker.nextNode()) {
+    const node = walker.currentNode as Text;
+    nodes.push({ node, original: node.data });
+  }
+  return { element, nodes, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') };
+}
+
+export function initializeTranslation(control: HTMLElement) {
+  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-translatable]')).map(collectText);
+  if (!sections.length) return () => {};
+  control.hidden = false;
+
+  const select = control.querySelector<HTMLSelectElement>('select')!;
+  const button = control.querySelector<HTMLButtonElement>('[data-translate-button]')!;
+  const originalButton = control.querySelector<HTMLButtonElement>('[data-original-button]')!;
+  const status = control.querySelector<HTMLElement>('[role="status"]')!;
+  const progress = control.querySelector<HTMLProgressElement>('progress')!;
+  const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+  const cache = new Map<string, Map<string, string>>();
+  const textNodes = sections.flatMap(section => section.nodes);
+  let activeLanguage = 'en';
+  let generation = 0;
+  let disposed = false;
+  let translator: LocalTranslator | undefined;
+  let controller: AbortController | undefined;
+
+  const message = (text: string) => { status.textContent = text; };
+  const languageName = () => select.selectedOptions[0].textContent;
+
+  function stop() {
+    generation++;
+    controller?.abort();
+    translator?.destroy();
+    translator = undefined;
+    progress.hidden = true;
+    button.removeAttribute('aria-busy');
+  }
+
+  function restore() {
+    for (const section of sections) {
+      for (const { node, original } of section.nodes) node.data = original;
+      for (const attribute of ['lang', 'dir'] as const) {
+        const value = section[attribute];
+        if (value === null) section.element.removeAttribute(attribute);
+        else section.element.setAttribute(attribute, value);
+      }
+    }
+    activeLanguage = 'en';
+    originalButton.hidden = true;
+  }
+
+  async function checkAvailability() {
+    const run = ++generation;
+    button.disabled = true;
+    if (select.value === 'en') {
+      button.textContent = 'Show original';
+      button.disabled = activeLanguage === 'en';
+      message('English is the original language of these articles.');
+      return;
+    }
+    button.textContent = 'Translate';
+    message('Checking language availability…');
+    try {
+      const available = await api!.availability({ sourceLanguage: 'en', targetLanguage: select.value });
+      if (disposed || run !== generation) return;
+      button.disabled = available === 'unavailable';
+      if (available === 'unavailable') {
+        message('This language is not available on your device. Try another language.');
+      } else if (available === 'available') {
+        message('Ready to translate articles and teasers on your device.');
+      } else {
+        button.textContent = 'Download & translate';
+        message('A language pack is needed. Translate to download it, then read on your device.');
+      }
+    } catch {
+      if (disposed || run !== generation) return;
+      message('Could not check translation availability. Choose a language to try again.');
+    }
+  }
+
+  async function translate() {
+    if (select.value === 'en') {
+      showOriginal();
+      return;
+    }
+    stop();
+    const run = generation;
+    const target = select.value;
+    const name = languageName();
+    controller = new AbortController();
+    const signal = controller.signal;
+    select.disabled = true;
+    button.disabled = true;
+    originalButton.hidden = false;
+    originalButton.textContent = 'Cancel / show original';
+    button.setAttribute('aria-busy', 'true');
+    progress.hidden = false;
+    progress.removeAttribute('value');
+    message(`Preparing ${name} translation…`);
+    let session: LocalTranslator | undefined;
+
+    try {
+      let translations = cache.get(target);
+      if (!translations) {
+        // Call create directly in the click handler, before any await, to retain user activation.
+        session = await api!.create({
+          sourceLanguage: 'en', targetLanguage: target, signal,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              if (disposed || run !== generation) return;
+              const loaded = (event as Event & { loaded: number }).loaded;
+              progress.value = loaded;
+              message(`Downloading language pack… ${Math.round(loaded * 100)}%`);
+            });
+          },
+        });
+        if (disposed || run !== generation) return;
+        translator = session;
+        translations = new Map();
+        const uniqueText = [...new Set(textNodes.map(({ original }) => original.trim()))];
+        for (let index = 0; index < uniqueText.length; index++) {
+          if (disposed || run !== generation) return;
+          const text = uniqueText[index];
+          translations.set(text, await session.translate(text, { signal }));
+          if (disposed || run !== generation) return;
+          progress.value = (index + 1) / uniqueText.length;
+          message(`Translating articles and teasers… ${Math.round(progress.value * 100)}%`);
+        }
+        cache.set(target, translations);
+      }
+      if (disposed || run !== generation) return;
+      // Commit together so an interrupted or failed translation never leaves mixed languages.
+      for (const section of sections) {
+        for (const { node, original } of section.nodes) {
+          node.data = original.replace(original.trim(), () => translations.get(original.trim())!);
+        }
+        section.element.lang = target;
+        section.element.dir = target === 'ar' ? 'rtl' : 'ltr';
+      }
+      activeLanguage = target;
+      message(`Translated into ${name} on your device. AI translations may contain mistakes.`);
+    } catch (error) {
+      if (disposed || run !== generation) return;
+      message(error instanceof DOMException && error.name === 'NotAllowedError'
+        ? 'Translation needs browser permission. Allow the download, then try again.'
+        : 'Translation could not finish. Your current text is unchanged. Check your connection or try another language.');
+    } finally {
+      session?.destroy();
+      if (!disposed && run === generation) {
+        translator = undefined;
+        select.disabled = false;
+        button.disabled = false;
+        button.textContent = 'Translate';
+        progress.hidden = true;
+        button.removeAttribute('aria-busy');
+        originalButton.hidden = activeLanguage === 'en';
+        originalButton.textContent = 'Show original';
+      }
+    }
+  }
+
+  function showOriginal() {
+    stop();
+    restore();
+    select.disabled = !api;
+    button.disabled = !api || select.value === 'en';
+    button.textContent = select.value === 'en' ? 'Show original' : 'Translate';
+    message('Showing the original English articles and teasers.');
+  }
+
+  const changeLanguage = () => { void checkAvailability(); };
+  const startTranslation = () => { void translate(); };
+  select.addEventListener('change', changeLanguage);
+  button.addEventListener('click', startTranslation);
+  originalButton.addEventListener('click', showOriginal);
+
+  if (!window.isSecureContext || !api) {
+    message('On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, over HTTPS.');
+  } else {
+    select.disabled = false;
+    void checkAvailability();
+  }
+
+  return () => {
+    disposed = true;
+    stop();
+    restore();
+    select.removeEventListener('change', changeLanguage);
+    button.removeEventListener('click', startTranslation);
+    originalButton.removeEventListener('click', showOriginal);
+    cache.clear();
+  };
+}
