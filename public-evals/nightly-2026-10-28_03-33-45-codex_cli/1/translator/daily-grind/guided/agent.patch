diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..667702e
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,124 @@
+(() => {
+  const select = document.getElementById('language-select');
+  const button = document.getElementById('translate-button');
+  const status = document.getElementById('translation-status');
+  const nodes = [...document.querySelectorAll('[data-translatable]')];
+  // Always translate the original copy, never a previous machine translation.
+  const originals = nodes.map((node) => node.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let readyOptions = null;
+  let activeTranslator = null;
+  let displayedLanguage = 'en';
+
+  function display(texts, language) {
+    nodes.forEach((node, index) => {
+      node.textContent = texts[index];
+      node.lang = language;
+    });
+    displayedLanguage = language;
+  }
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. The original English text is available below. Try a supported desktop browser, such as Chrome or Edge, over HTTPS.';
+    return;
+  }
+
+  select.disabled = false;
+  status.textContent = 'Showing the original English text. Choose a language to translate.';
+
+  select.addEventListener('change', async () => {
+    const request = ++revision;
+    const language = select.value;
+    readyOptions = null;
+    button.disabled = true;
+    button.textContent = 'Translate';
+    if (activeTranslator) {
+      activeTranslator.destroy();
+      activeTranslator = null;
+    }
+
+    if (cache.has(language)) {
+      display(cache.get(language), language);
+      status.textContent = language === 'en'
+        ? 'Showing the original English text.'
+        : 'Showing the translated coffee descriptions and story. Choose English to restore the original.';
+      return;
+    }
+
+    status.textContent = 'Checking on-device language support…';
+    const options = {
+      sourceLanguage: 'en',
+      targetLanguage: language,
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          if (request !== revision) return;
+          const percent = Math.round(event.loaded * 100);
+          status.textContent = `Downloading language pack: ${percent}%. Translation will run on your device.`;
+        });
+      },
+    };
+
+    try {
+      const availability = await window.Translator.availability(options);
+      if (request !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. The displayed text has been kept. Choose another language or English for the original.';
+        return;
+      }
+      if (!['available', 'downloadable', 'downloading'].includes(availability)) {
+        throw new Error('Unknown translation availability');
+      }
+      readyOptions = options;
+      button.disabled = false;
+      button.textContent = availability === 'available' ? 'Translate' : 'Download & translate';
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device. Select Translate to continue.'
+        : 'A language pack is needed. Select Download & translate to continue. The first download may take a few minutes.';
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Could not check language support. The displayed text has been kept. Choose another language and try again, or choose English for the original.';
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    if (!readyOptions || button.disabled) return;
+    const request = revision;
+    const options = readyOptions;
+    let translator;
+    button.disabled = true;
+    button.textContent = 'Translating…';
+    status.textContent = 'Preparing on-device translation… You can choose English at any time to restore the original.';
+
+    try {
+      // Create directly within the click gesture, with no availability await first.
+      translator = await window.Translator.create(options);
+      if (request !== revision) return;
+      activeTranslator = translator;
+      status.textContent = 'Translating coffee descriptions and story on your device…';
+      const translated = [];
+      for (const text of originals) {
+        const result = await translator.translate(text);
+        if (request !== revision) return;
+        if (typeof result !== 'string' || !result.trim()) {
+          throw new Error('Empty translation');
+        }
+        translated.push(result);
+      }
+      // Commit the complete result together so a failed translation keeps the page intact.
+      cache.set(options.targetLanguage, translated);
+      display(translated, options.targetLanguage);
+      status.textContent = 'Coffee descriptions and story translated on your device. Choose English to restore the original.';
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Translation could not finish. The displayed text has been kept. Check your connection if a language pack is needed, then try again or choose English for the original.';
+    } finally {
+      if (translator) translator.destroy();
+      if (request === revision) {
+        activeTranslator = null;
+        button.textContent = 'Translate';
+        button.disabled = displayedLanguage === options.targetLanguage;
+      }
+    }
+  });
+})();
