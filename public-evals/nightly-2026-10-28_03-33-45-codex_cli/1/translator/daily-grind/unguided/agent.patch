diff --git a/translations.js b/translations.js
new file mode 100644
index 0000000..af0f6a5
--- /dev/null
+++ b/translations.js
@@ -0,0 +1,86 @@
+(() => {
+  'use strict';
+
+  const selector = document.getElementById('language');
+  const textElements = document.querySelectorAll('[data-i18n]');
+  const english = Object.fromEntries(
+    Array.from(textElements, element => [element.dataset.i18n, element.textContent])
+  );
+  // Bundled translations keep the language switch instant and entirely on-device.
+  const translations = {
+    en: english,
+    es: {
+      language: 'Idioma', menu: 'Menú', locations: 'Locales', rewards: 'Recompensas',
+      account: 'Mi cuenta', logout: 'Cerrar sesión', heroTitle: 'Despierta tus sentidos',
+      heroText: 'De origen ético, tostado localmente y servido en tu taza.', order: 'Pedir ahora',
+      translationNote: 'Las traducciones se realizan en tu dispositivo. Elige tu idioma arriba.',
+      favorites: 'Favoritos de temporada', mapleTitle: 'Latte de avena y arce',
+      mapleText: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.',
+      espressoTitle: 'Espresso de tueste oscuro',
+      espressoText: 'Intenso, ahumado y perfecto para empezar la mañana con energía.',
+      coldTitle: 'Café de extracción en frío', coldText: 'Infusionado durante 18 horas para una máxima suavidad.',
+      details: 'Ver detalles', storyTitle: 'Nuestra historia',
+      storyText: 'En The Daily Grind, creemos que un gran día empieza con una taza preparada con esmero. Combinamos granos de origen ético con un tueste local para crear un espacio donde disfrutar de una mañana tranquila, una conversación cercana y tu próximo café favorito.',
+      careers: 'Únete al equipo', contact: 'Contáctanos', privacy: 'Privacidad',
+      copyright: '© 2026 The Daily Grind Coffee Co. Todos los derechos reservados.'
+    },
+    fr: {
+      language: 'Langue', menu: 'Carte', locations: 'Nos cafés', rewards: 'Fidélité',
+      account: 'Mon compte', logout: 'Déconnexion', heroTitle: 'Éveillez vos sens',
+      heroText: 'Un café issu de sources éthiques, torréfié localement et servi dans votre tasse.', order: 'Commander',
+      translationNote: 'Les traductions restent sur votre appareil. Choisissez votre langue ci-dessus.',
+      favorites: 'Les favoris de saison', mapleTitle: 'Latte à l’avoine et à l’érable',
+      mapleText: 'Un lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      espressoTitle: 'Espresso à torréfaction foncée',
+      espressoText: 'Intense et fumé, idéal pour faire le plein d’énergie le matin.',
+      coldTitle: 'Café infusé à froid', coldText: 'Infusé pendant 18 heures pour une douceur incomparable.',
+      details: 'Voir les détails', storyTitle: 'Notre histoire',
+      storyText: 'Chez The Daily Grind, nous pensons qu’une belle journée commence par une tasse préparée avec soin. Nous associons des grains issus de sources éthiques à une torréfaction locale pour vous offrir un moment de calme, une conversation chaleureuse et votre prochain café préféré.',
+      careers: 'Rejoignez l’équipe', contact: 'Contactez-nous', privacy: 'Confidentialité',
+      copyright: '© 2026 The Daily Grind Coffee Co. Tous droits réservés.'
+    },
+    de: {
+      language: 'Sprache', menu: 'Speisekarte', locations: 'Standorte', rewards: 'Treueprogramm',
+      account: 'Mein Konto', logout: 'Abmelden', heroTitle: 'Wecke deine Sinne',
+      heroText: 'Ethisch bezogen, lokal geröstet und frisch in deiner Tasse.', order: 'Jetzt bestellen',
+      translationNote: 'Die Übersetzungen bleiben auf deinem Gerät. Wähle oben deine Sprache.',
+      favorites: 'Saisonale Favoriten', mapleTitle: 'Hafer-Latte mit Ahornsirup',
+      mapleText: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      espressoTitle: 'Dunkel gerösteter Espresso',
+      espressoText: 'Kräftig, rauchig und perfekt für einen schwungvollen Start in den Morgen.',
+      coldTitle: 'Cold Brew', coldText: 'Für besonders milden Geschmack 18 Stunden kalt gezogen.',
+      details: 'Mehr erfahren', storyTitle: 'Unsere Geschichte',
+      storyText: 'Bei The Daily Grind glauben wir, dass ein schöner Tag mit einer sorgfältig zubereiteten Tasse Kaffee beginnt. Wir verbinden ethisch bezogene Bohnen mit lokaler Röstung und schaffen Raum für einen ruhigen Morgen, ein nettes Gespräch und deinen nächsten Lieblingskaffee.',
+      careers: 'Werde Teil des Teams', contact: 'Kontakt', privacy: 'Datenschutz',
+      copyright: '© 2026 The Daily Grind Coffee Co. Alle Rechte vorbehalten.'
+    }
+  };
+  const storageKey = 'daily-grind-language';
+
+  function applyLanguage(language) {
+    const selected = Object.hasOwn(translations, language) ? language : 'en';
+    textElements.forEach(element => {
+      element.textContent = translations[selected][element.dataset.i18n] ?? english[element.dataset.i18n];
+    });
+    document.documentElement.lang = selected;
+    selector.value = selected;
+  }
+
+  let savedLanguage = 'en';
+  try {
+    savedLanguage = localStorage.getItem(storageKey) || 'en';
+  } catch {
+    // The selector still works when browser privacy settings block storage.
+  }
+  applyLanguage(savedLanguage);
+  selector.addEventListener('change', () => {
+    applyLanguage(selector.value);
+    try {
+      localStorage.setItem(storageKey, selector.value);
+    } catch {
+      // Persistence is optional; translating never depends on storage access.
+    }
+  });
+  document.querySelector('.language-picker').hidden = false;
+  document.getElementById('translation-note').hidden = false;
+})();
