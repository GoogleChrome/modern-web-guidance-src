+  <script>
+    const feature = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    const supportsAnchors = CSS.supports('anchor-name: --rewards-link') &&
+      CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let positionFrame;
+
+    // Keep the fallback tethered through scrolling, resizing and layout changes.
+    function trackFeature() {
+      if (!tourOpen) return;
+      const target = feature.getBoundingClientRect();
+      const width = tourStep.offsetWidth;
+      const height = tourStep.offsetHeight;
+      const left = Math.max(12, Math.min(target.right - width, window.innerWidth - width - 12));
+      const top = target.bottom + 14;
+      tourStep.style.left = `${left}px`;
+      tourStep.style.right = 'auto';
+      tourStep.style.top = `${top + height > window.innerHeight - 12 && target.top > height + 14
+        ? target.top - height - 14 : top}px`;
+      positionFrame = requestAnimationFrame(trackFeature);
+    }
+
+    if (supportsPopover) tourStep.showPopover();
+    if (!supportsAnchors || !supportsPopover) trackFeature();
+    closeTour.focus({ preventScroll: true });
+
+    feature.addEventListener('click', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+    feature.addEventListener('auxclick', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(positionFrame);
+      if (supportsPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      feature.removeAttribute('aria-describedby');
+      feature.focus({ preventScroll: true });
+    });
+  </script>
