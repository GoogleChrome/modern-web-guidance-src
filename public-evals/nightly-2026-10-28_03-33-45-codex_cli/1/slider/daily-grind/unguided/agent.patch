+  <script>
+    const strength = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('strength-value');
+    const strengthNames = ['Light', 'Mellow', 'Balanced', 'Bold', 'Intense'];
+
+    function updateStrength() {
+      const value = Number(strength.value);
+      const progress = ((value - Number(strength.min)) / (Number(strength.max) - Number(strength.min))) * 100;
+      const description = `${strengthNames[value - 1]} · ${value} / ${strength.max}`;
+      strength.style.setProperty('--strength-progress', `${progress}%`);
+      strengthValue.textContent = description;
+      strength.setAttribute('aria-valuetext', `${strengthNames[value - 1]}, ${value} of ${strength.max}`);
+    }
+
+    strength.addEventListener('input', updateStrength);
+    updateStrength();
+  </script>
