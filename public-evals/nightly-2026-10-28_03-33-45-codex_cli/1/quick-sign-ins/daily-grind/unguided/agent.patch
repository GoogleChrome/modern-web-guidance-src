+  <script>
+    (() => {
+      const form = document.querySelector('#signin-form');
+      const email = document.querySelector('#signin-email');
+      const password = document.querySelector('#signin-password');
+      const passkeyButton = document.querySelector('#passkey-signin');
+      const status = document.querySelector('#signin-status');
+      const supported = window.isSecureContext && !!window.PublicKeyCredential && !!navigator.credentials;
+      let pending = null;
+      let busy = false;
+      let signedIn = false;
+
+      function message(text, error = false) {
+        status.textContent = text;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        form.setAttribute('aria-busy', String(value));
+        form.querySelectorAll('button').forEach(button => { button.disabled = value; });
+      }
+
+      // Server integration contract (same-origin, HTTPS):
+      // POST /api/auth/passkey/options -> PublicKeyCredentialRequestOptions as JSON,
+      // with base64url challenge/credential IDs and a fresh, session-bound challenge.
+      // POST /api/auth/passkey/verify -> { authenticated: true } only after verifying
+      // the assertion, challenge, origin, RP ID and user verification requirements.
+      // POST /api/auth/login accepts { username, password } and returns the same result.
+      // Both verification endpoints must establish a secure HttpOnly session cookie,
+      // validate request origins/CSRF and rate-limit attempts. Never trust client state.
+      async function post(path, body, signal) {
+        const response = await fetch(path, {
+          method: 'POST', credentials: 'same-origin', redirect: 'error', cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body), signal
+        });
+        if (response.status === 401 || response.status === 403) {
+          throw new Error('We couldn’t sign you in. Check your details and try again.');
+        }
+        if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64 + '='.repeat((4 - base64.length % 4) % 4)), c => c.charCodeAt(0));
+      }
+
+      function encode(value) {
+        return btoa(String.fromCharCode(...new Uint8Array(value)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function finish(result) {
+        if (result.authenticated !== true) throw new Error('We couldn’t sign you in. Please try again.');
+        signedIn = true;
+        password.value = '';
+        form.hidden = true;
+        document.querySelector('#signin-heading').textContent = 'You’re signed in.';
+        document.querySelector('#signin-context').textContent = 'Welcome back to The Daily Grind. Make yourself at home.';
+        message('You can keep browsing right here.');
+        const signInLink = document.querySelector('[data-signin="Sign in"]');
+        signInLink.textContent = 'Signed in';
+      }
+
+      async function usePasskey(conditional = false) {
+        if (!supported || busy || signedIn) return;
+        pending?.abort();
+        const controller = new AbortController();
+        pending = controller;
+        if (!conditional) { setBusy(true); message('Choose a saved passkey in your browser.'); }
+        try {
+          const options = await post('/api/auth/passkey/options', {}, controller.signal);
+          options.challenge = decode(options.challenge);
+          options.allowCredentials = conditional ? [] : (options.allowCredentials || []).map(item => ({
+            ...item, id: decode(item.id)
+          }));
+          const credential = await navigator.credentials.get({
+            publicKey: options,
+            mediation: conditional ? 'conditional' : 'optional',
+            signal: controller.signal
+          });
+          if (!credential || controller.signal.aborted) return;
+          setBusy(true);
+          const response = credential.response;
+          const result = await post('/api/auth/passkey/verify', {
+            id: credential.id, rawId: encode(credential.rawId), type: credential.type,
+            authenticatorAttachment: credential.authenticatorAttachment,
+            clientExtensionResults: credential.getClientExtensionResults(),
+            response: {
+              clientDataJSON: encode(response.clientDataJSON),
+              authenticatorData: encode(response.authenticatorData),
+              signature: encode(response.signature),
+              userHandle: response.userHandle ? encode(response.userHandle) : null
+            }
+          }, controller.signal);
+          finish(result);
+        } catch (error) {
+          if (error.name !== 'AbortError' && (!conditional || busy)) {
+            message(error.name === 'NotAllowedError'
+              ? 'Passkey sign-in was canceled or unavailable. Try again or use your password.'
+              : 'Passkey sign-in is unavailable right now. Try your password or try again later.', true);
+          }
+        } finally {
+          if (pending === controller) {
+            pending = null;
+            setBusy(false);
+          }
+        }
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (busy || signedIn) return;
+        pending?.abort();
+        pending = null;
+        setBusy(true);
+        message('Signing you in…');
+        try {
+          finish(await post('/api/auth/login', { username: email.value, password: password.value }));
+        } catch (error) {
+          message(error.message === 'Failed to fetch'
+            ? 'Couldn’t reach sign-in. Check your connection and try again.' : error.message, true);
+        } finally {
+          setBusy(false);
+        }
+      });
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          event.preventDefault();
+          const panel = document.querySelector('#signin');
+          if (!signedIn) {
+            const destination = link.dataset.signin;
+            document.querySelector('#signin-context').textContent = destination === 'Sign in'
+              ? 'Sign in to enjoy your rewards and make ordering easy.'
+              : `Sign in here for ${destination}. You’ll stay on this page.`;
+          }
+          panel.scrollIntoView({ block: 'center' });
+          if (!signedIn) email.focus({ preventScroll: true });
+        });
+      });
+
+      passkeyButton.hidden = !supported;
+      passkeyButton.addEventListener('click', () => usePasskey());
+      // Conditional mediation offers saved passkeys in autofill without interrupting browsing.
+      async function startAutofill() {
+        try {
+          if (supported && await PublicKeyCredential.isConditionalMediationAvailable?.()) {
+            await usePasskey(true);
+          }
+        } catch { /* Password autofill remains available on browsers without conditional UI. */ }
+      }
+      startAutofill();
+    })();
+  </script>
