diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..056fde6
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,43 @@
+// Module scripts run after parsing, so the server-rendered shadow trees are ready.
+class DrinkCard extends HTMLElement {
+  #button;
+
+  #toggleFavorite = () => {
+    const favorite = this.#button.getAttribute('aria-pressed') !== 'true';
+    this.#button.setAttribute('aria-pressed', String(favorite));
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { drink: this.dataset.drink, favorite },
+    }));
+  };
+
+  connectedCallback() {
+    // Older browsers leave DSD inert. Move the same server-authored nodes into
+    // a shadow root only when the parser hasn't already created one.
+    if (!this.shadowRoot) {
+      const template = this.querySelector('template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open' }).append(template.content);
+      template.remove();
+    }
+
+    // Hydration only adds behavior: never replace the rendered markup or CSS.
+    this.#button = this.shadowRoot.querySelector('button');
+    if (!this.#button) return;
+    this.#button.addEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    // A card can reconnect after being moved; preserve its state and avoid
+    // leaving a detached card's control active without its listener.
+    if (!this.#button) return;
+    this.#button.removeEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = true;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
