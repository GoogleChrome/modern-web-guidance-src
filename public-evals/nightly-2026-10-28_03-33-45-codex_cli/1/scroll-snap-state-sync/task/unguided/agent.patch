+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = tocLinks.map(link => document.getElementById(link.hash.slice(1)));
+
+    function updateCurrentDrink() {
+      const snapTop = panel.getBoundingClientRect().top + panel.clientTop
+        + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      let currentIndex = 0;
+      let nearestDistance = Infinity;
+
+      headings.forEach((heading, index) => {
+        const distance = Math.abs(heading.getBoundingClientRect().top - snapTop);
+        if (distance < nearestDistance) {
+          nearestDistance = distance;
+          currentIndex = index;
+        }
+      });
+
+      tocLinks.forEach((link, index) => {
+        if (index === currentIndex) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    tocLinks.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = headings[index];
+        const top = panel.scrollTop + heading.getBoundingClientRect().top
+          - panel.getBoundingClientRect().top - panel.clientTop
+          - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+        heading.focus({ preventScroll: true });
+        panel.scrollTo({
+          top,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    let scrollFrame = null;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame !== null) return;
+      scrollFrame = requestAnimationFrame(() => {
+        updateCurrentDrink();
+        scrollFrame = null;
+      });
+    }, { passive: true });
+    window.addEventListener('resize', updateCurrentDrink);
+    updateCurrentDrink();
+  </script>
