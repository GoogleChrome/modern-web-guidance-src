+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const headers = sections.map(section => section.querySelector('h3'));
+
+    function setCurrentSection(section) {
+      links.forEach(link => {
+        if (link.hash === `#${section.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function headerOffset(header) {
+      return header.getBoundingClientRect().top - panel.getBoundingClientRect().top
+        - panel.clientTop - parseFloat(getComputedStyle(panel).scrollPaddingBlockStart);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) setCurrentSection(section);
+      });
+    } else {
+      const observer = new IntersectionObserver(() => {
+        const closestHeader = headers.reduce((closest, header) =>
+          Math.abs(headerOffset(header)) < Math.abs(headerOffset(closest)) ? header : closest
+        );
+        setCurrentSection(closestHeader.closest('.drink-section'));
+      }, { root: panel, threshold: [0, 0.25, 0.5, 0.75, 1] });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = sections.find(section => link.hash === `#${section.id}`);
+        const header = section.querySelector('h3');
+        panel.scrollTo({ top: panel.scrollTop + headerOffset(header) });
+        header.focus({ preventScroll: true });
+      });
+    });
+  </script>
