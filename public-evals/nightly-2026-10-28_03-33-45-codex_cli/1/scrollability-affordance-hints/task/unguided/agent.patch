+  <script>
+    const reviewsScroll = document.querySelector('.reviews-scroll');
+    const indicatorTop = document.querySelector('.indicator-top');
+    const indicatorBottom = document.querySelector('.indicator-bottom');
+
+    function updateReviewIndicators() {
+      const { scrollTop, scrollHeight, clientHeight } = reviewsScroll;
+      indicatorTop.hidden = scrollTop <= 0;
+      // Allow for fractional scroll positions at the bottom of the list.
+      indicatorBottom.hidden = scrollHeight - clientHeight - scrollTop <= 1;
+    }
+
+    reviewsScroll.addEventListener('scroll', updateReviewIndicators, { passive: true });
+    window.addEventListener('resize', updateReviewIndicators);
+
+    const reviewsResizeObserver = new ResizeObserver(updateReviewIndicators);
+    reviewsResizeObserver.observe(reviewsScroll);
+    reviewsResizeObserver.observe(document.querySelector('.reviews-list'));
+    updateReviewIndicators();
+  </script>
+
