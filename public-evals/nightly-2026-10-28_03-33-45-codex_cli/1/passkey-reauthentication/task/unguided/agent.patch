+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+={0,2}$/.test(value)) {
+        throw new Error('The server returned invalid credential options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), char => char.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity confirmation…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Passkey verification requires a supported browser and a secure connection.');
+        }
+
+        // The server derives the account and its registered credentials from the session.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Accept': 'application/json' }
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to prepare identity confirmation. Please try again.');
+        const optionsJSON = await optionsResponse.json();
+        const options = optionsJSON.publicKey ?? optionsJSON;
+        if (!Array.isArray(options.allowCredentials) || options.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key is available for this account.');
+        }
+
+        const publicKey = {
+          ...options,
+          challenge: decodeBase64url(options.challenge),
+          allowCredentials: options.allowCredentials.map(credential => {
+            if (credential.type !== 'public-key') throw new Error('The server returned invalid credential options.');
+            return { ...credential, id: decodeBase64url(credential.id) };
+          }),
+          userVerification: 'required'
+        };
+        reauthStatus.textContent = 'Confirm your identity with your passkey or security key…';
+        const assertion = await navigator.credentials.get({ publicKey });
+        if (!assertion || assertion.type !== 'public-key') {
+          throw new Error('Identity confirmation was not completed. Please try again.');
+        }
+
+        const verificationResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify({
+            id: assertion.id,
+            rawId: encodeBase64url(assertion.rawId),
+            type: assertion.type,
+            authenticatorAttachment: assertion.authenticatorAttachment,
+            response: {
+              clientDataJSON: encodeBase64url(assertion.response.clientDataJSON),
+              authenticatorData: encodeBase64url(assertion.response.authenticatorData),
+              signature: encodeBase64url(assertion.response.signature),
+              userHandle: assertion.response.userHandle == null ? null : encodeBase64url(assertion.response.userHandle)
+            },
+            clientExtensionResults: assertion.getClientExtensionResults()
+          })
+        });
+        // The server must verify the signature, origin, RP ID, single-use challenge,
+        // credential ownership and UV flag, then enforce reauthentication on changes.
+        if (!verificationResponse.ok) throw new Error('Identity verification failed. Please try again.');
+        reauthStatus.textContent = 'Identity confirmed. You can continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Identity confirmation was canceled or timed out. Please try again.'
+          : error.message || 'Identity confirmation failed. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
+
