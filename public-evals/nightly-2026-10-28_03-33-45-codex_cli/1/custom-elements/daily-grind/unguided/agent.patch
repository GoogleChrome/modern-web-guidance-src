@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window();
+for (const name of ['document', 'HTMLElement', 'customElements', 'AbortController', 'CustomEvent']) {
+  globalThis[name] = window[name];
+}
+
+// Exercise upgrading an element that already has a property before registration.
+const earlyCard = document.createElement('coffee-card');
+earlyCard.name = 'Early coffee';
+earlyCard.price = 4.5;
+earlyCard.disabled = true;
+document.body.append(earlyCard);
+await import('./coffee-card.js');
+
+test('upgrades properties assigned before registration', () => {
+  assert.equal(earlyCard.getAttribute('name'), 'Early coffee');
+  assert.equal(earlyCard.getAttribute('price'), '4.5');
+  assert.equal(earlyCard.hasAttribute('disabled'), true);
+  assert.equal(Object.hasOwn(earlyCard, 'name'), false);
+});
+
+test('reflects strings in both directions and renders text safely', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  for (const name of ['name', 'description', 'href']) {
+    card[name] = 'coffee';
+    assert.equal(card.getAttribute(name), 'coffee');
+    card.setAttribute(name, 'updated');
+    assert.equal(card[name], 'updated');
+  }
+  card.name = '<img src=x onerror=alert(1)>';
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+  assert.equal(card.shadowRoot.querySelector('img'), null);
+  card.description = 'Freshly roasted';
+  assert.equal(card.shadowRoot.querySelector('.description').textContent, card.description);
+  card.href = '/menu/cold-brew';
+  assert.equal(card.shadowRoot.querySelector('a').getAttribute('href'), card.href);
+  card.name = null;
+  card.href = null;
+  assert.equal(card.name, '');
+  assert.equal(card.hasAttribute('name'), false);
+  assert.equal(card.href, '/menu');
+  card.remove();
+});
+
+test('reflects numeric prices, including zero, removal and invalid inputs', () => {
+  const card = document.createElement('coffee-card');
+  const price = card.shadowRoot.querySelector('.price');
+  document.body.append(card);
+  assert.equal(card.price, null);
+  assert.equal(price.hidden, true);
+  card.price = 4.5;
+  assert.equal(card.getAttribute('price'), '4.5');
+  assert.equal(price.textContent, '$4.50');
+  card.setAttribute('price', '0');
+  assert.equal(card.price, 0);
+  assert.equal(price.hidden, false);
+  assert.equal(price.textContent, '$0.00');
+  for (const value of ['', 'invalid', '-1', 'Infinity']) {
+    card.setAttribute('price', value);
+    assert.equal(card.price, null);
+    assert.equal(price.hidden, true);
+    assert.throws(() => { card.price = value; }, RangeError);
+  }
+  card.price = null;
+  assert.equal(card.hasAttribute('price'), false);
+  card.remove();
+});
+
+test('uses boolean presence semantics and disables navigation and events', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  const link = card.shadowRoot.querySelector('a');
+  let selections = 0;
+  card.addEventListener('coffee-select', () => selections++);
+  card.disabled = true;
+  assert.equal(card.getAttribute('disabled'), '');
+  assert.equal(link.hasAttribute('href'), false);
+  assert.equal(link.getAttribute('aria-disabled'), 'true');
+  link.click();
+  assert.equal(selections, 0);
+  card.setAttribute('disabled', 'false');
+  assert.equal(card.disabled, true);
+  card.disabled = false;
+  assert.equal(card.hasAttribute('disabled'), false);
+  assert.equal(link.getAttribute('aria-disabled'), null);
+  assert.equal(link.getAttribute('href'), '/menu');
+  card.removeAttribute('disabled');
+  assert.equal(card.disabled, false);
+  card.remove();
+});
+
+test('cleans up on disconnect and binds once on each reconnect', () => {
+  const card = document.createElement('coffee-card');
+  card.name = 'Cold Brew';
+  card.price = 3;
+  const link = card.shadowRoot.querySelector('a');
+  // Cancel native navigation while exercising the real click listener.
+  link.addEventListener('click', event => event.preventDefault());
+  const selections = [];
+  const listener = event => selections.push(event.detail);
+  document.body.addEventListener('coffee-select', listener);
+  document.body.append(card);
+  link.click();
+  assert.deepEqual(selections, [{ name: 'Cold Brew', href: '/menu', price: 3 }]);
+  card.remove();
+  let detachedSelections = 0;
+  card.addEventListener('coffee-select', () => detachedSelections++);
+  link.click();
+  assert.equal(detachedSelections, 0);
+  for (let count = 0; count < 3; count++) {
+    document.body.append(card);
+    link.click();
+    card.remove();
+  }
+  assert.equal(selections.length, 4);
+  assert.equal(detachedSelections, 3);
+  document.body.removeEventListener('coffee-select', listener);
+});
