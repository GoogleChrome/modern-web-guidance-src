+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .price { margin-top: 10px; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a[aria-disabled="true"] { opacity: 0.5; cursor: default; }
+  </style>
+  <article aria-labelledby="name">
+    <h3 id="name"></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'disabled'];
+
+  #controller;
+  #name;
+  #description;
+  #price;
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#name = root.querySelector('h3');
+    this.#description = root.querySelector('.description');
+    this.#price = root.querySelector('.price');
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Preserve properties assigned before the custom element was defined.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this.#render();
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    this.#link.addEventListener('click', this.#onSelect, {
+      signal: this.#controller.signal,
+    });
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+    this.#controller = undefined;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#setString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#setString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? '/menu'; }
+  set href(value) { this.#setString('href', value); }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const value = Number(raw);
+    return Number.isFinite(value) && value >= 0 ? value : null;
+  }
+
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (String(value).trim() === '' || !Number.isFinite(number) || number < 0) {
+      throw new RangeError('price must be a finite, non-negative number or null');
+    }
+    this.setAttribute('price', String(number));
+  }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  #setString(name, value) {
+    if (value == null) this.removeAttribute(name);
+    else this.setAttribute(name, String(value));
+  }
+
+  #render() {
+    this.#name.textContent = this.name;
+    this.#description.textContent = this.description;
+    const price = this.price;
+    this.#price.hidden = price === null;
+    this.#price.textContent = price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(price);
+    if (this.disabled) {
+      this.#link.removeAttribute('href');
+      this.#link.setAttribute('role', 'link');
+      this.#link.setAttribute('aria-disabled', 'true');
+    } else {
+      this.#link.setAttribute('href', this.href);
+      this.#link.removeAttribute('role');
+      this.#link.removeAttribute('aria-disabled');
+    }
+  }
+
+  #onSelect = (event) => {
+    if (this.disabled) {
+      event.preventDefault();
+      return;
+    }
+    this.dispatchEvent(new CustomEvent('coffee-select', {
+      bubbles: true,
+      composed: true,
+      detail: { name: this.name, href: this.href, price: this.price },
+    }));
+  };
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/coffee-card.test.js b/coffee-card.test.js
