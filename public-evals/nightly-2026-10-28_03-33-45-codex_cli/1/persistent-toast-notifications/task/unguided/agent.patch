+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-live="polite" aria-atomic="true"></span>
+      <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.querySelector('#toast-template');
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+        let dismissed = false;
+        let timeout;
+
+        const dismiss = () => {
+          if (dismissed) return;
+          dismissed = true;
+          clearTimeout(timeout);
+
+          if (toast.contains(document.activeElement)) {
+            trigger.focus({ preventScroll: true });
+          }
+
+          toast.hidePopover();
+          // Retain the box in the top layer until its CSS exit completes.
+          // With reduced motion (or no transitions), remove it immediately.
+          Promise.allSettled(toast.getAnimations().map((animation) => animation.finished))
+            .then(() => toast.remove());
+        };
+
+        toast.querySelector('.toast-close').addEventListener('click', dismiss);
+        document.body.append(toast);
+        toast.showPopover();
+        // Populate the live region after it is exposed to assistive technology.
+        requestAnimationFrame(() => {
+          toast.querySelector('[role="status"]').textContent = 'added to cart!';
+        });
+        timeout = setTimeout(dismiss, 3000);
+      });
+    });
+  </script>
