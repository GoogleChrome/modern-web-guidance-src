+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-live="polite" aria-atomic="true"></span>
+      <button type="button" class="toast-close" aria-label="Close notification"
+        popovertargetaction="hide">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.getElementById('toast-template');
+    let toastId = 0;
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+        toast.id = `cart-toast-${++toastId}`;
+        const closeButton = toast.querySelector('.toast-close');
+        closeButton.setAttribute('popovertarget', toast.id);
+
+        // Direct body siblings keep positioning entirely in CSS, with no wrapper.
+        document.body.append(toast);
+        toast.showPopover();
+        toast.querySelector('[role="status"]').textContent = 'added to cart!';
+
+        const timeout = setTimeout(dismiss, 3000);
+
+        async function dismiss() {
+          if (toast.hasAttribute('data-closing')) return;
+          clearTimeout(timeout);
+          toast.setAttribute('data-closing', '');
+          // Keep the real top-layer element open until its exit has finished,
+          // including browsers without discrete display/overlay transitions.
+          await Promise.allSettled(toast.getAnimations().map((animation) => animation.finished));
+          toast.hidePopover();
+          toast.remove();
+        }
+
+        closeButton.addEventListener('click', (event) => {
+          // Defer the declarative hide action until after the exit animation.
+          event.preventDefault();
+          dismiss();
+        });
+      });
+    });
+  </script>
