diff --git a/initial-theme.js b/initial-theme.js
new file mode 100644
index 0000000..811a076
--- /dev/null
+++ b/initial-theme.js
@@ -0,0 +1,10 @@
+// Apply the stored theme before the incoming page is painted or captured.
+// Keep the existing light appearance when no preference has been saved.
+try {
+  const theme = localStorage.getItem('theme');
+  if (theme === 'light' || theme === 'dark') {
+    document.documentElement.dataset.theme = theme;
+  }
+} catch {
+  // Storage may be unavailable; the default CSS theme remains usable.
+}
