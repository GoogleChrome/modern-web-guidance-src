diff --git a/public/critical-page-ready.js b/public/critical-page-ready.js
new file mode 100644
index 0000000..c10367c
--- /dev/null
+++ b/public/critical-page-ready.js
@@ -0,0 +1,14 @@
+// The render-blocking head script installs this guard before the first reveal.
+// Stylesheets in the head and rel="expect" handle CSS and HTML readiness.
+window.addEventListener('pagereveal', (event) => {
+  if (!event.viewTransition) return;
+
+  // Render blocking does not wait for asynchronous island hydration. If initial
+  // JavaScript is still pending, show the page normally rather than animate an
+  // unstable snapshot. Lazy islands are not part of the initial view contract.
+  const contentParsed = document.getElementById('page-content-ready');
+  const hydrationPending = document.querySelector('astro-island[client="load"][ssr]');
+  if (!contentParsed || hydrationPending) {
+    event.viewTransition.skipTransition();
+  }
+});
