+    /* Rewards and order progress */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: clamp(20px, 4vw, 32px);
+      background: #fff;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
+    }
+
+    .progress-panel h2 {
+      margin-bottom: 4px;
+    }
+
+    .progress-item {
+      margin-top: 24px;
+    }
+
+    .progress-heading {
+      display: flex;
+      justify-content: space-between;
+      flex-wrap: wrap;
+      gap: 4px 16px;
+      margin-bottom: 8px;
+    }
+
+    .progress-heading label {
+      font-weight: 600;
+    }
+
+    .progress-item p,
+    .progress-heading span {
+      font-size: 0.9rem;
+    }
+
+    .process-progress {
+      --progress-animation-duration: 1.8s;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      margin-bottom: 8px;
+      appearance: none;
+      border: 0 solid;
+      border-radius: 999px;
+      overflow: clip;
+      background: var(--secondary);
+      container-type: inline-size;
+    }
+
+    .process-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .process-progress::-webkit-progress-value {
+      background: var(--primary);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .process-progress::-moz-progress-bar {
+      background: var(--primary);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .process-progress:indeterminate {
+      --progress-animation: progress-pending var(--progress-animation-duration) linear infinite;
+    }
+
+    .process-progress:indeterminate:dir(rtl) {
+      --progress-animation: progress-pending var(--progress-animation-duration) linear infinite reverse;
+    }
+
+    @keyframes progress-pending {
+      from, to {
+        inline-size: 30%;
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .process-progress {
+        --progress-animation-duration: 10s;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .process-progress {
+        --primary: Highlight;
+        --secondary: Canvas;
+        outline: 1px solid CanvasText;
+      }
+    }
+
