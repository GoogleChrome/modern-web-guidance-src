+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-time');
+      const coffeeAnniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          // Native inputs restore plain calendar/time strings without timezone conversion.
+          if (typeof saved.pickupTime === 'string') pickupTime.value = saved.pickupTime;
+          if (typeof saved.coffeeAnniversary === 'string') coffeeAnniversary.value = saved.coffeeAnniversary;
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again below.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'Unsaved changes. Select Save preferences to keep them.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        // These are floating wall-clock/calendar values, never instants. Keep the
+        // input strings verbatim: Date, UTC, and timezone conversions would shift them.
+        const preferences = {
+          pickupTime: pickupTime.value,
+          coffeeAnniversary: coffeeAnniversary.value
+        };
+        try {
+          localStorage.setItem(storageKey, JSON.stringify(preferences));
+          status.textContent = 'Preferences saved. Your selected time and date stay the same when you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved in this browser. Please enable browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
