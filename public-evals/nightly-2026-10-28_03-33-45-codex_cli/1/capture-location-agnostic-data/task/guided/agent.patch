+  <script>
+    (() => {
+      const storageKey = 'daily-grind:coffee-preferences:v1';
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-time');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      function validateSelection(input, plainType) {
+        if (!input.checkValidity()) return false;
+        // Native inputs validate the plain strings in browsers without Temporal.
+        if (input.value && globalThis.Temporal?.[plainType]) {
+          try {
+            globalThis.Temporal[plainType].from(input.value);
+          } catch {
+            return false;
+          }
+        }
+        return true;
+      }
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupTime === 'string') pickupTime.value = saved.pickupTime;
+          if (typeof saved.coffeeAnniversary === 'string') anniversary.value = saved.coffeeAnniversary;
+          if (!validateSelection(pickupTime, 'PlainTime')) pickupTime.value = '';
+          if (!validateSelection(anniversary, 'PlainDate')) anniversary.value = '';
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        if (!validateSelection(pickupTime, 'PlainTime') || !validateSelection(anniversary, 'PlainDate')) {
+          status.textContent = 'Please choose a valid time and date.';
+          return;
+        }
+
+        try {
+          // Persist wall-clock time and calendar date verbatim, with no zone or
+          // timestamp conversion. Empty strings let users clear either preference.
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupTime: pickupTime.value,
+            coffeeAnniversary: anniversary.value,
+          }));
+          status.textContent = 'Preferences saved in this browser. Your time and date stay the same when you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Allow browser storage and try again.';
+        }
+      });
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+      document.getElementById('save-preferences').disabled = false;
+    })();
+  </script>
