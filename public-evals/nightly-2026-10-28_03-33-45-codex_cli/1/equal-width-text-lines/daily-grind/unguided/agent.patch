+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = [...heroHeading.querySelectorAll('span')];
+
+    function fitHeadingLines() {
+      const availableWidth = heroHeading.clientWidth;
+      if (!availableWidth) return;
+
+      // Measure natural glyph widths, then size each line without changing spacing.
+      headingLines.forEach(line => {
+        line.style.fontSize = '100px';
+        line.style.maxWidth = 'none';
+      });
+      const widths = headingLines.map(line => line.getBoundingClientRect().width);
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${100 * availableWidth / widths[index]}px`;
+        line.style.removeProperty('max-width');
+      });
+    }
+
+    fitHeadingLines();
+    document.fonts.ready.then(fitHeadingLines);
+
+    let previousWidth = heroHeading.clientWidth;
+    new ResizeObserver(([entry]) => {
+      if (entry.contentRect.width !== previousWidth) {
+        previousWidth = entry.contentRect.width;
+        fitHeadingLines();
+      }
+    }).observe(heroHeading);
+  </script>
