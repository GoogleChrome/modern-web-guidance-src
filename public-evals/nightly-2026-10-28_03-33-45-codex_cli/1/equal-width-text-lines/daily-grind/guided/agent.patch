+  <script>
+    if (!CSS.supports('text-fit', 'grow per-line-all 400%')) {
+      const lockup = document.querySelector('.hero-lockup');
+      const lines = [...lockup.querySelectorAll(':scope > span')];
+
+      const fitHeading = () => {
+        // Reset together, then measure together to avoid a reflow for each line.
+        lines.forEach(line => line.style.removeProperty('--text-fit-scale'));
+        const width = lockup.getBoundingClientRect().width;
+        const scales = lines.map(line => width / line.getBoundingClientRect().width);
+        lines.forEach((line, index) => {
+          line.style.setProperty('--text-fit-scale', scales[index]);
+        });
+      };
+
+      fitHeading();
+      new ResizeObserver(fitHeading).observe(lockup);
+      document.fonts.ready.then(fitHeading);
+      document.fonts.addEventListener('loadingdone', fitHeading);
+    }
+  </script>
