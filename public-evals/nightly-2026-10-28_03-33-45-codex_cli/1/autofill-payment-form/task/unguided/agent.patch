+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const expiryInput = document.getElementById('card-expiry');
+
+    expiryInput.addEventListener('input', () => expiryInput.setCustomValidity(''));
+
+    paymentForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const [month, year] = expiryInput.value.split('/').map(Number);
+      const now = new Date();
+      if (new Date(2000 + year, month) <= now) {
+        expiryInput.setCustomValidity('Enter an expiry date that has not passed.');
+        expiryInput.reportValidity();
+        return;
+      }
+      document.getElementById('payment-status').textContent =
+        'Your details pass the form checks. No payment has been processed or card details sent.';
+      paymentForm.reset();
+    });
+  </script>
