+      }
+    };
+
+    async function fetchVerifiedAsset(asset) {
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadVerifiedImage(image) {
+      const response = await fetchVerifiedAsset(externalAssets[image.dataset.externalImage]);
+      const objectURL = URL.createObjectURL(await response.blob());
+      try {
+        image.src = objectURL;
+        await image.decode();
+        image.style.visibility = 'visible';
+      } catch (error) {
+        image.removeAttribute('src');
+        throw error;
+      } finally {
+        URL.revokeObjectURL(objectURL);
+      }
+    }
+
+    async function loadVerifiedFont(weight) {
+      const response = await fetchVerifiedAsset(externalAssets[`font${weight}`]);
+      const font = new FontFace('Lato', await response.arrayBuffer(), {
+        weight: String(weight),
+        style: 'normal',
+        display: 'swap'
+      });
+      document.fonts.add(await font.load());
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      if (window.feather) window.feather.replace();
+      const loads = [
+        ...Array.from(document.querySelectorAll('[data-external-image]'), loadVerifiedImage),
+        ...[400, 700].map(loadVerifiedFont)
+      ];
+      // Fail closed: keep fallback colors/fonts; never retry without integrity.
+      loads.forEach(load => load.catch(error => console.warn('External asset unavailable:', error)));
+    });
+  </script>
