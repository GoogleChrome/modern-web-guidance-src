+  <script>
+    // CSS URL integrity is not universal. Fall back to Fetch SRI, never to an
+    // unchecked remote URL. Digests are pinned at release time, not at runtime.
+    (() => {
+      const font = {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.2.6/files/lora-latin-400-normal.woff2",
+        "integrity": "sha384-aFxA3BDBa0FQEb3YpbJCAXLunGfquJVh+SIk8+aJiR4VNizJ/CAi9XDHEN9FvMPY"
+      };
+      const images = [
+        {
+          "selector": ".hero",
+          "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+          "integrity": "sha384-MkCawIXxkhKfMCsafNM9LontDHX3W8n8sYbKwfQ5NE+0xJOWg9RoQMv3OfOjdF4b"
+        },
+        {
+          "selector": ".card-image--latte",
+          "url": "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-x2K/bA51pQugUJAdiAyKc3oWHrr4/9gsaNZcD9LJa6aOD7gBgsdD6mqy1z7Ziqsu"
+        },
+        {
+          "selector": ".card-image--espresso",
+          "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+        },
+        {
+          "selector": ".card-image--coldbrew",
+          "url": "https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-8BVYoeCa4BfhP0cdbKGlxiGxgD6YRYCANIIF9K4gA7wJ+qrwR9xBeHLywbueB0EJ"
+        }
+      ];
+      const supportsCssIntegrity = typeof CSS !== 'undefined' && CSS.supports(
+        'background-image',
+        `url("${font.url}" cross-origin(anonymous) referrer-policy(no-referrer) integrity("${font.integrity}"))`
+      );
+      if (supportsCssIntegrity) return;
+      // Fail closed in browsers without Fetch SRI instead of silently skipping checks.
+      if (typeof Request === 'undefined' || !('integrity' in Request.prototype)) return;
+
+      async function verifiedResponse(asset) {
+        const response = await fetch(asset.url, {
+          integrity: asset.integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer'
+        });
+        if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+        return response;
+      }
+
+      const objectUrls = [];
+      for (const image of images) {
+        (async () => {
+          const response = await verifiedResponse(image);
+          const blob = await response.blob();
+          const objectUrl = URL.createObjectURL(blob);
+          objectUrls.push(objectUrl);
+          const overlay = image.selector === '.hero'
+            ? 'linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), '
+            : '';
+          document.querySelector(image.selector).style.backgroundImage = `${overlay}url("${objectUrl}")`;
+        })().catch(() => {
+          // Keep the solid-color placeholder if fetching or verification fails.
+          console.warn('A homepage image could not be verified.');
+        });
+      }
+      // Keep URLs alive for page lifetime, including back/forward cache restores.
+      window.addEventListener('pagehide', (event) => {
+        if (!event.persisted) objectUrls.forEach((url) => URL.revokeObjectURL(url));
+      });
+
+      if (typeof FontFace !== 'undefined' && document.fonts) {
+        (async () => {
+          const response = await verifiedResponse(font);
+          const face = new FontFace('Daily Grind Lora', await response.arrayBuffer(), {
+            style: 'normal', weight: '400', display: 'swap'
+          });
+          await face.load();
+          document.fonts.add(face);
+        })().catch(() => {
+          // The system serif font remains available if verification fails.
+          console.warn('The homepage font could not be verified.');
+        });
+      }
+    })();
+  </script>
