+  <script type="module">
+    // Load compatibility support only in browsers missing the native APIs.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    const tooltips = document.querySelectorAll(".details-tooltip");
+    const isOpen = tooltip => tooltip.matches(":is(:popover-open, .\\:popover-open)");
+
+    // Also dismiss hint popovers in browsers that only implement auto/manual.
+    document.addEventListener("keydown", event => {
+      if (event.key === "Escape") {
+        tooltips.forEach(tooltip => {
+          if (isOpen(tooltip)) tooltip.hidePopover();
+        });
+      }
+    });
+
+    if (!CSS.supports("position-area", "right")) {
+      const positionTooltip = tooltip => {
+        if (!isOpen(tooltip)) return;
+        const trigger = document.querySelector(`[interestfor="${tooltip.id}"]`);
+        const button = trigger.getBoundingClientRect();
+        const { width, height } = tooltip.getBoundingClientRect();
+        const gap = 8;
+        const edge = 12;
+        let left = button.right + gap;
+        let top = button.top + (button.height - height) / 2;
+        if (left + width > innerWidth - edge) {
+          left = button.left - width - gap;
+          if (left < edge) {
+            left = button.left + (button.width - width) / 2;
+            top = button.bottom + gap;
+            if (top + height > innerHeight - edge) top = button.top - height - gap;
+          }
+        }
+        tooltip.style.left = `${Math.max(edge, Math.min(left, innerWidth - width - edge))}px`;
+        tooltip.style.top = `${Math.max(edge, Math.min(top, innerHeight - height - edge))}px`;
+      };
+      tooltips.forEach(tooltip => tooltip.addEventListener("toggle", () => positionTooltip(tooltip)));
+      const reposition = () => tooltips.forEach(positionTooltip);
+      window.addEventListener("resize", reposition);
+      document.addEventListener("scroll", reposition, true);
+    }
+  </script>
