+export interface SavedPasskey {
+  provider?: { name: string; icon?: string }; id: string; userId: string; name: string; aaguid: string; deviceType: string;
+  backedUp: boolean; registeredAt: number; lastUsedAt: number | null;
+}
+export interface Account {
+  user: { id: string; username: string; displayName: string };
+  rpId: string; verifiedUntil: number; passkeys: SavedPasskey[];
+}
+export const appUrl = (path: string) => `${import.meta.env.BASE_URL}${path}`;
+export class ApiError extends Error { constructor(public status: number, message: string) { super(message); } }
+export async function api<T = Account>(action: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(appUrl(`api/auth/${action}`), {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body), signal,
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new ApiError(response.status, data.error || 'Unable to connect. Please try again.');
+  return data;
+}
+export async function capabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential) return { available: false, create: false, conditional: false };
+  await import('webauthn-polyfills');
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  return { available: true, create: !!caps.passkeyPlatformAuthenticator && !!caps.conditionalGet, conditional: !!caps.conditionalGet };
+}
+export function passkeyError(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was canceled or timed out. Try again, use another device, or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection on this site’s configured domain.';
+    if (error.name === 'AbortError') return 'The passkey request was canceled. You can try again.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
+async function signalUnknown(rpId: string, credentialId: string) {
+  try { await PublicKeyCredential.signalUnknownCredential?.({ rpId, credentialId }); } catch { /* Password-manager synchronization is best effort. */ }
+}
+export async function authenticate(signal: AbortSignal, reauth = false, conditional = false) {
+  const action = reauth ? 'reauthentication' : 'authentication';
+  const { options, ceremonyId } = await api<{ options: PublicKeyCredentialRequestOptionsJSON; ceremonyId: string }>(`${action}/options`, {}, signal);
+  const credential = await navigator.credentials.get({ publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options), signal, ...(conditional ? { mediation: 'conditional' } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  try { return await api(`${action}/verify`, { ceremonyId, credential: credential.toJSON() }, signal); }
+  catch (error) {
+    if (!reauth && error instanceof ApiError && error.status === 404) await signalUnknown(options.rpId!, credential.id);
+    throw error;
+  }
+}
+export async function registerPasskey(signal: AbortSignal, promotion = false) {
+  const { options, ceremonyId } = await api<{ options: PublicKeyCredentialCreationOptionsJSON; ceremonyId: string }>('registration/options', { promotion }, signal);
+  const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options), signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  try { return await api('registration/verify', { ceremonyId, credential: credential.toJSON() }, signal); }
+  catch (error) { await signalUnknown(options.rp.id!, credential.id); throw error; }
+}
+export async function syncPasskeys(account: Account) {
+  if (!window.PublicKeyCredential) return;
+  try { await PublicKeyCredential.signalAllAcceptedCredentials?.({ rpId: account.rpId, userId: account.user.id, allAcceptedCredentialIds: account.passkeys.map(key => key.id) }); } catch { /* Best effort. */ }
+}
+export async function syncProfile(account: Account) {
+  if (!window.PublicKeyCredential) return;
+  try { await PublicKeyCredential.signalCurrentUserDetails?.({ rpId: account.rpId, userId: account.user.id, name: account.user.username, displayName: account.user.displayName }); } catch { /* Best effort. */ }
+}
diff --git a/src/lib/server/auth-service.ts b/src/lib/server/auth-service.ts
