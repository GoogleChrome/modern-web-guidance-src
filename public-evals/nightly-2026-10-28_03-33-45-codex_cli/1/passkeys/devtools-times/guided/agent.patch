+++ b/src/lib/server/auth-service.ts
@@ -0,0 +1,145 @@
+import type { APIRoute } from 'astro';
+import providers from '../passkey-providers.json';
+import { generateAuthenticationOptions, generateRegistrationOptions, verifyAuthenticationResponse, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { getAuthStore, digest } from './auth-store';
+
+const PASSWORD_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const PRODUCTION_ORIGIN = 'https://astro-news-pytrpecapa-uc.a.run.app';
+class HttpError extends Error { constructor(public status: number, message: string) { super(message); } }
+const fail = (status: number, message: string): never => { throw new HttpError(status, message); };
+
+export const handleAuth: APIRoute = async ({ request, url, cookies, params }) => {
+  const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+  try {
+    const origin = new URL(process.env.WEBAUTHN_ORIGIN || (['localhost', '127.0.0.1', '[::1]'].includes(url.hostname) ? url.origin : PRODUCTION_ORIGIN));
+    const rpID = origin.hostname;
+    const action = params.action;
+    const isGet = request.method === 'GET';
+    if (!isGet && request.method !== 'POST') return json({ error: 'Method not allowed.' }, 405);
+    if (!isGet && request.headers.get('origin') !== origin.origin) fail(403, 'Request origin is not allowed.');
+    if (!isGet && !request.headers.get('content-type')?.startsWith('application/json')) fail(415, 'Expected a JSON request.');
+    const body = isGet ? {} : JSON.parse(await request.text().then(value => {
+      if (value.length > 65536) fail(413, 'Request is too large.');
+      return value;
+    }));
+    const store = getAuthStore();
+    const cookieName = 'devtools_times_session';
+    let secret = cookies.get(cookieName)?.value;
+    let session = secret ? store.session(digest(secret)) : undefined;
+    const setSession = (userId: string | null, verifiedAt = 0) => {
+      if (session) store.db.prepare('DELETE FROM sessions WHERE id = ?').run(session.id);
+      secret = store.createSession(userId, verifiedAt);
+      cookies.set(cookieName, secret, { httpOnly: true, sameSite: 'lax', secure: origin.protocol === 'https:', path: (import.meta.env?.BASE_URL || '/devtools-times/'), maxAge: 7 * 86400 });
+      session = store.session(digest(secret))!;
+    };
+    const requireUser = () => {
+      if (!session?.userId) fail(401, 'Please sign in to manage your account.');
+      return store.user(session!.userId!) || fail(401, 'Please sign in again.');
+    };
+    const requireRecent = () => {
+      const user = requireUser();
+      if (!session!.verifiedAt || Date.now() - session!.verifiedAt > 300000) fail(403, 'Verify your identity before changing your passkeys.');
+      return user;
+    };
+    const snapshot = () => {
+      const user = requireUser();
+      return { user, rpId: rpID, verifiedUntil: session!.verifiedAt + 300000, passkeys: store.list(user.id).map(({ publicKey, counter, ...credential }) => ({ ...credential, provider: (providers as Record<string, { name: string; icon?: string }>)[credential.aaguid] })) };
+    };
+    if (isGet) {
+      if (action === 'account') return json(snapshot());
+      return json({ error: 'Not found.' }, 404);
+    }
+    if (action === 'login' || action === 'signup' || action === 'password/verify') {
+      const username = action === 'password/verify' ? requireUser().username : body.username?.trim();
+      if (typeof username !== 'string' || !username || username.length > 128 || typeof body.password !== 'string' || !body.password || body.password.length > 1024) fail(400, 'Enter your username and password.');
+      const upstream = await fetch(`${PASSWORD_API}/${action === 'signup' ? 'register' : 'login'}`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password: body.password }), signal: AbortSignal.timeout(15000),
+      });
+      if (!upstream.ok) fail(upstream.status >= 500 ? 502 : 400, action === 'signup' ? 'Unable to create this account. Check your username and password requirements.' : 'The username or password is incorrect.');
+      if (action === 'password/verify') {
+        store.db.prepare('UPDATE sessions SET verifiedAt = ? WHERE id = ?').run(Date.now(), session!.id);
+        session = store.session(session!.id);
+      } else {
+        // The existing password service remains the authority for account ownership.
+        const user = store.ensureUser(username);
+        setSession(user.id, Date.now());
+      }
+      return json(snapshot());
+    }
+    if (action === 'logout') {
+      if (session) store.db.prepare('DELETE FROM sessions WHERE id = ?').run(session.id);
+      cookies.delete(cookieName, { path: (import.meta.env?.BASE_URL || '/devtools-times/') });
+      return json({ success: true });
+    }
+    if (action === 'registration/options') {
+      const user = requireRecent();
+      const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID, userID: Buffer.from(user.id, 'base64url'), userName: user.username, userDisplayName: user.displayName,
+        attestationType: 'none', excludeCredentials: store.list(user.id).map(key => ({ id: key.id, transports: key.transports as AuthenticatorTransport[] })),
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred', ...(body.promotion === true ? { authenticatorAttachment: 'platform' as const } : {}) },
+      });
+      return json({ options, ceremonyId: store.challenge(session!.id, 'registration', options.challenge, user.id) });
+    }
+    if (action === 'authentication/options' || action === 'reauthentication/options') {
+      const reauth = action.startsWith('reauthentication');
+      const user = reauth ? requireUser() : undefined;
+      const keys = user ? store.list(user.id) : [];
+      if (reauth && !keys.length) fail(400, 'Use your password to verify your identity, then add a passkey.');
+      if (!session) setSession(null);
+      const options = await generateAuthenticationOptions({ rpID, userVerification: reauth ? 'required' : 'preferred', allowCredentials: keys.map(key => ({ id: key.id, transports: key.transports as AuthenticatorTransport[] })) });
+      return json({ options, ceremonyId: store.challenge(session!.id, reauth ? 'reauthentication' : 'authentication', options.challenge, user?.id || null) });
+    }
+    if (['registration/verify', 'authentication/verify', 'reauthentication/verify'].includes(action!)) {
+      const kind = action!.split('/')[0];
+      if (typeof body.ceremonyId !== 'string' || !session) fail(400, 'This request expired. Please try again.');
+      const challenge = store.consume(body.ceremonyId, session!.id, kind);
+      if (!challenge || challenge.expiresAt < Date.now()) fail(400, 'This request expired. Please try again.');
+      const credential = body.credential;
+      if (!credential || typeof credential.id !== 'string') fail(400, 'No passkey was returned.');
+      if (kind === 'registration') {
+        const user = requireRecent();
+        if (challenge!.userId !== user.id) fail(403, 'This passkey belongs to a different account.');
+        const result = await verifyRegistrationResponse({ response: credential, expectedChallenge: challenge!.challenge, expectedOrigin: origin.origin, expectedRPID: rpID, requireUserVerification: false });
+        if (!result.verified || !result.registrationInfo) fail(400, 'The passkey could not be verified.');
+        const info = result.registrationInfo!;
+        if (store.credential(info.credential.id)) fail(409, 'This passkey is already registered.');
+        store.add({ id: info.credential.id, userId: user.id, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'), counter: info.credential.counter, transports: info.credential.transports || [], aaguid: info.aaguid,
+          deviceType: info.credentialDeviceType, backedUp: info.credentialBackedUp, name: 'My passkey', registeredAt: Date.now(), lastUsedAt: null });
+      } else {
+        const key = store.credential(credential.id) || fail(404, 'This passkey is no longer registered. Sign in with your password.');
+        const reauth = kind === 'reauthentication';
+        if (reauth && (key.userId !== requireUser().id || key.userId !== challenge!.userId)) fail(403, 'Use a passkey for your signed-in account.');
+        if (credential.response?.userHandle && credential.response.userHandle !== key.userId) fail(403, 'This passkey belongs to a different account.');
+        const result = await verifyAuthenticationResponse({ response: credential, expectedChallenge: challenge!.challenge, expectedOrigin: origin.origin, expectedRPID: rpID, requireUserVerification: reauth,
+          credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports as AuthenticatorTransport[] } });
+        if (!result.verified) fail(400, 'The passkey could not be verified.');
+        if (!store.saveAuthentication(key, { ...key, counter: result.authenticationInfo.newCounter, backedUp: result.authenticationInfo.credentialBackedUp, lastUsedAt: Date.now() })) fail(409, 'The passkey changed during verification. Please try again.');
+        // Primary sign-in with preferred UV does not authorize sensitive changes.
+        if (reauth) { store.db.prepare('UPDATE sessions SET verifiedAt = ? WHERE id = ?').run(Date.now(), session!.id); session = store.session(session!.id); }
+        else setSession(key.userId);
+      }
+      return json(snapshot());
+    }
+    if (action === 'passkeys/rename' || action === 'passkeys/delete') {
+      const user = requireRecent();
+      const key = typeof body.id === 'string' ? store.credential(body.id) : undefined;
+      if (!key || key.userId !== user.id) fail(404, 'Passkey not found.');
+      if (action.endsWith('rename')) {
+        if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 64) fail(400, 'Enter a passkey name of 1–64 characters.');
+        store.save({ ...key!, name: body.name.trim() });
+      } else store.db.prepare('DELETE FROM passkeys WHERE id = ? AND userId = ?').run(key!.id, user.id);
+      return json(snapshot());
+    }
+    if (action === 'profile') {
+      const user = requireRecent();
+      if (typeof body.displayName !== 'string' || !body.displayName.trim() || body.displayName.trim().length > 80) fail(400, 'Enter a display name of 1–80 characters.');
+      store.db.prepare('UPDATE users SET displayName = ? WHERE id = ?').run(body.displayName.trim(), user.id);
+      return json(snapshot());
+    }
+    return json({ error: 'Not found.' }, 404);
+  } catch (error) {
+    if (error instanceof HttpError) return json({ error: error.message }, error.status);
+    if (error instanceof SyntaxError) return json({ error: 'Invalid request.' }, 400);
+    console.error('Account request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'We could not complete the request. Please try again.' }, 400);
+  }
+};
diff --git a/src/lib/server/auth-store.ts b/src/lib/server/auth-store.ts
new file mode 100644
index 0000000..a52cd02
--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,69 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes, createHash } from 'node:crypto';
+
+export interface User { id: string; username: string; displayName: string }
+export interface Passkey {
+  id: string; userId: string; publicKey: string; counter: number; transports: string[];
+  deviceType: string; backedUp: boolean; aaguid: string; name: string;
+  registeredAt: number; lastUsedAt: number | null;
+}
+export const token = () => randomBytes(32).toString('base64url');
+export const digest = (value: string) => createHash('sha256').update(value).digest('hex');
+
+export class AuthStore {
+  db: DatabaseSync;
+  constructor(path: string) {
+    if (path !== ':memory:') mkdirSync(dirname(resolve(path)), { recursive: true });
+    this.db = new DatabaseSync(path);
+    this.db.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA foreign_keys = ON;
+      CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), data TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, userId TEXT REFERENCES users(id), verifiedAt INTEGER NOT NULL DEFAULT 0, expiresAt INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, sessionId TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE, kind TEXT NOT NULL, challenge TEXT NOT NULL, userId TEXT, expiresAt INTEGER NOT NULL);
+    `);
+  }
+  user(id: string) { return this.db.prepare('SELECT * FROM users WHERE id = ?').get(id) as unknown as User | undefined; }
+  ensureUser(username: string) {
+    this.db.prepare('INSERT OR IGNORE INTO users VALUES (?, ?, ?)').run(token(), username, username);
+    return this.db.prepare('SELECT * FROM users WHERE username = ?').get(username) as unknown as User;
+  }
+  list(userId: string): Passkey[] {
+    return this.db.prepare('SELECT data FROM passkeys WHERE userId = ?').all(userId).map(row => JSON.parse(row.data as string));
+  }
+  credential(id: string): Passkey | undefined {
+    const row = this.db.prepare('SELECT data FROM passkeys WHERE id = ?').get(id);
+    return row ? JSON.parse(row.data as string) : undefined;
+  }
+  add(passkey: Passkey) { this.db.prepare('INSERT INTO passkeys VALUES (?, ?, ?)').run(passkey.id, passkey.userId, JSON.stringify(passkey)); }
+  save(passkey: Passkey) { this.db.prepare('UPDATE passkeys SET data = ? WHERE id = ? AND userId = ?').run(JSON.stringify(passkey), passkey.id, passkey.userId); }
+  saveAuthentication(previous: Passkey, updated: Passkey) {
+    // Reject deleted credentials and concurrent counter updates after async signature verification.
+    return this.db.prepare('UPDATE passkeys SET data = ? WHERE id = ? AND userId = ? AND data = ?')
+      .run(JSON.stringify(updated), previous.id, previous.userId, JSON.stringify(previous)).changes === 1;
+  }
+  session(id: string) {
+    return this.db.prepare('SELECT * FROM sessions WHERE id = ? AND expiresAt > ?').get(id, Date.now()) as { id: string; userId: string | null; verifiedAt: number; expiresAt: number } | undefined;
+  }
+  createSession(userId: string | null = null, verifiedAt = 0) {
+    this.db.prepare('DELETE FROM sessions WHERE expiresAt <= ?').run(Date.now());
+    this.db.prepare('DELETE FROM challenges WHERE expiresAt <= ?').run(Date.now());
+    const secret = token();
+    this.db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?)').run(digest(secret), userId, verifiedAt, Date.now() + 7 * 86400000);
+    return secret;
+  }
+  challenge(sessionId: string, kind: string, challenge: string, userId: string | null) {
+    // Keep several ceremonies separate so autofill, tabs and explicit prompts cannot overwrite each other.
+    const id = token();
+    this.db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?, ?, ?)').run(id, sessionId, kind, challenge, userId, Date.now() + 300000);
+    return id;
+  }
+  consume(id: string, sessionId: string, kind: string) {
+    return this.db.prepare('DELETE FROM challenges WHERE id = ? AND sessionId = ? AND kind = ? RETURNING *').get(id, sessionId, kind) as { challenge: string; userId: string | null; expiresAt: number } | undefined;
+  }
+}
+let store: AuthStore;
+export function getAuthStore() { return store ??= new AuthStore(process.env.AUTH_DB_PATH || './.data/auth.sqlite'); }
