diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..33301c7
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,151 @@
+import { after, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import type { APIContext } from 'astro';
+import { handleAuth } from '../src/lib/server/auth-service';
+import { digest, getAuthStore } from '../src/lib/server/auth-store';
+
+process.env.AUTH_DB_PATH = ':memory:';
+process.env.WEBAUTHN_ORIGIN = 'http://localhost:4321';
+const origin = process.env.WEBAUTHN_ORIGIN;
+const realFetch = globalThis.fetch;
+// Password identity remains delegated to the existing service; tests never contact it.
+globalThis.fetch = async () => new Response('{}', { status: 200 });
+after(() => { globalThis.fetch = realFetch; getAuthStore().db.close(); });
+class Client {
+  jar = new Map<string, string>();
+  async request(action: string, body?: unknown, customOrigin = origin) {
+    const url = new URL(`/devtools-times/api/auth/${action}`, origin);
+    const response = await handleAuth({ url, params: { action },
+      request: new Request(url, { method: body === undefined ? 'GET' : 'POST', headers: { 'Content-Type': 'application/json', origin: customOrigin }, body: body === undefined ? undefined : JSON.stringify(body) }),
+      cookies: {
+        get: (name: string) => this.jar.has(name) ? { value: this.jar.get(name) } : undefined,
+        set: (name: string, value: string) => this.jar.set(name, value),
+        delete: (name: string) => this.jar.delete(name),
+      },
+    } as unknown as APIContext) as Response;
+    return { status: response.status, data: await response.json() };
+  }
+  login(username: string) { return this.request('login', { username, password: 'test-pass-123' }); }
+}
+function authenticator() {
+  const { publicKey, privateKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32).toString('base64url');
+  const cose = isoCBOR.encode(new Map<number, number | Uint8Array>([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')]]));
+  const rpHash = createHash('sha256').update('localhost').digest();
+  return {
+    id,
+    registration(challenge: string) {
+      const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.create', challenge, origin }));
+      const idBytes = Buffer.from(id, 'base64url');
+      const length = Buffer.alloc(2); length.writeUInt16BE(idBytes.length);
+      const authData = Buffer.concat([rpHash, Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), length, idBytes, cose]);
+      return { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: clientData.toString('base64url'), attestationObject: Buffer.from(isoCBOR.encode(new Map<string, unknown>([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]) as never)).toString('base64url'), transports: ['internal'] } };
+    },
+    assertion(challenge: string, userHandle: string, counter: number, uv = true) {
+      const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge, origin }));
+      const count = Buffer.alloc(4); count.writeUInt32BE(counter);
+      const authData = Buffer.concat([rpHash, Buffer.from([uv ? 5 : 1]), count]);
+      const signature = sign('sha256', Buffer.concat([authData, createHash('sha256').update(clientData).digest()]), privateKey);
+      return { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: clientData.toString('base64url'), authenticatorData: authData.toString('base64url'), signature: signature.toString('base64url'), userHandle } };
+    },
+  };
+}
+async function enroll(client: Client, key: ReturnType<typeof authenticator>) {
+  const options = await client.request('registration/options', {});
+  assert.equal(options.status, 200);
+  assert.equal(options.data.options.authenticatorSelection.residentKey, 'required');
+  const credential = key.registration(options.data.options.challenge);
+  const result = await client.request('registration/verify', { ceremonyId: options.data.ceremonyId, credential });
+  assert.equal(result.status, 200, JSON.stringify(result.data));
+  return result.data;
+}
+
+test('password sign-up supports passkey enrollment, duplicates and single-use challenges', async () => {
+  const client = new Client();
+  assert.equal((await client.request('signup', { username: 'reader', password: 'test-pass-123' })).status, 200);
+  const key = authenticator();
+  const account = await enroll(client, key);
+  assert.equal(account.passkeys.length, 1);
+  assert.equal(account.passkeys[0].publicKey, undefined);
+  const options = await client.request('registration/options', {});
+  assert.equal(options.data.options.excludeCredentials[0].id, key.id);
+  const credential = key.registration(options.data.options.challenge);
+  assert.equal((await client.request('registration/verify', { ceremonyId: options.data.ceremonyId, credential })).status, 409);
+  assert.equal((await client.request('registration/verify', { ceremonyId: options.data.ceremonyId, credential })).status, 400);
+});
+
+test('discoverable authentication verifies signatures, updates usage and rotates sessions', async () => {
+  const owner = new Client(); await owner.login('returning-reader');
+  const key = authenticator(); const account = await enroll(owner, key);
+  const client = new Client();
+  const options = await client.request('authentication/options', {});
+  assert.deepEqual(options.data.options.allowCredentials, []);
+  const before = client.jar.get('devtools_times_session');
+  const credential = key.assertion(options.data.options.challenge, account.user.id, 1);
+  const result = await client.request('authentication/verify', { ceremonyId: options.data.ceremonyId, credential });
+  assert.equal(result.status, 200, JSON.stringify(result.data));
+  assert.notEqual(client.jar.get('devtools_times_session'), before);
+  assert.equal(result.data.user.id, account.user.id);
+  assert.ok(result.data.passkeys[0].lastUsedAt);
+  assert.equal((await client.request('passkeys/delete', { id: key.id })).status, 403);
+  const reauth = await client.request('reauthentication/options', {});
+  assert.equal(reauth.data.options.userVerification, 'required');
+  assert.deepEqual(reauth.data.options.allowCredentials.map((item: { id: string }) => item.id), [key.id]);
+  const confirmed = await client.request('reauthentication/verify', { ceremonyId: reauth.data.ceremonyId, credential: key.assertion(reauth.data.options.challenge, account.user.id, 2) });
+  assert.equal(confirmed.status, 200);
+  assert.equal((await client.request('passkeys/rename', { id: key.id, name: 'My laptop' })).data.passkeys[0].name, 'My laptop');
+  assert.equal((await client.request('passkeys/delete', { id: key.id })).data.passkeys.length, 0);
+  assert.equal((await client.request('account')).status, 200);
+});
+
+test('reauthentication rejects another account and assertions without user verification', async () => {
+  const alice = new Client(); const bob = new Client();
+  await alice.login('alice'); await bob.login('bob');
+  const aliceKey = authenticator(); const bobKey = authenticator();
+  const a = await enroll(alice, aliceKey); const b = await enroll(bob, bobKey);
+  let options = await alice.request('reauthentication/options', {});
+  assert.equal((await alice.request('reauthentication/verify', { ceremonyId: options.data.ceremonyId, credential: bobKey.assertion(options.data.options.challenge, b.user.id, 1) })).status, 403);
+  options = await alice.request('reauthentication/options', {});
+  assert.equal((await alice.request('reauthentication/verify', { ceremonyId: options.data.ceremonyId, credential: aliceKey.assertion(options.data.options.challenge, a.user.id, 1, false) })).status, 400);
+  assert.equal((await bob.request('passkeys/delete', { id: aliceKey.id })).status, 404);
+});
+
+test('cross-site mutations, missing sessions, expired challenges and tampering are rejected', async () => {
+  const client = new Client();
+  assert.equal((await client.request('login', { username: 'reader', password: 'x' }, 'https://evil.example')).status, 403);
+  assert.equal((await client.request('account')).status, 401);
+  await client.login('security-reader'); const key = authenticator(); const account = await enroll(client, key);
+  let options = await client.request('authentication/options', {});
+  const stranger = new Client();
+  assert.equal((await stranger.request('authentication/verify', { ceremonyId: options.data.ceremonyId, credential: key.assertion(options.data.options.challenge, account.user.id, 1) })).status, 400);
+  getAuthStore().db.prepare('UPDATE challenges SET expiresAt = 0 WHERE id = ?').run(options.data.ceremonyId);
+  assert.equal((await client.request('authentication/verify', { ceremonyId: options.data.ceremonyId, credential: key.assertion(options.data.options.challenge, account.user.id, 1) })).status, 400);
+  options = await client.request('authentication/options', {});
+  const tampered = key.assertion(options.data.options.challenge, account.user.id, 1); tampered.response.signature = randomBytes(64).toString('base64url');
+  assert.equal((await client.request('authentication/verify', { ceremonyId: options.data.ceremonyId, credential: tampered })).status, 400);
+  assert.equal((await client.request('logout', {})).status, 200);
+  assert.equal((await client.request('account')).status, 401);
+});
+
+test('credential updates reject concurrent assertions and credentials removed during verification', () => {
+  const store = getAuthStore(); const user = store.ensureUser('race-reader');
+  const key = { id: 'race-key', userId: user.id, publicKey: 'key', counter: 1, transports: [], deviceType: 'singleDevice', backedUp: false, aaguid: '', name: 'Key', registeredAt: Date.now(), lastUsedAt: null };
+  store.add(key);
+  assert.equal(store.saveAuthentication(key, { ...key, counter: 2 }), true);
+  assert.equal(store.saveAuthentication(key, { ...key, counter: 3 }), false);
+  store.db.prepare('DELETE FROM passkeys WHERE id = ?').run(key.id);
+  assert.equal(store.saveAuthentication({ ...key, counter: 2 }, { ...key, counter: 3 }), false);
+});
+
+test('expiring a session removes its challenges and prevents account access', async () => {
+  const client = new Client(); await client.login('expiring-reader');
+  const options = await client.request('registration/options', {});
+  const sessionId = digest(client.jar.get('devtools_times_session')!);
+  getAuthStore().db.prepare('UPDATE sessions SET expiresAt = 0 WHERE id = ?').run(sessionId);
+  assert.equal((await client.request('account')).status, 401);
+  getAuthStore().createSession();
+  assert.equal(getAuthStore().consume(options.data.ceremonyId, sessionId, 'registration'), undefined);
+});
