@@ -0,0 +1,76 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { FingerPrintIcon, ShieldCheckIcon, ArrowRightIcon } from '@heroicons/react/24/outline';
+import { api, appUrl, authenticate, capabilities, passkeyError, registerPasskey } from '../lib/passkeys';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState('');
+  const [created, setCreated] = useState(false);
+  const [support, setSupport] = useState<{ available: boolean; create: boolean; conditional: boolean } | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  const controller = useRef<AbortController | null>(null);
+  useEffect(() => { let active = true; capabilities().then(value => { if (active) setSupport(value); }).catch(() => { if (active) setSupport({ available: false, create: false, conditional: false }); }); return () => { active = false; controller.current?.abort(); }; }, []);
+  useEffect(() => {
+    if (signup || !support?.conditional || busy) return;
+    const abort = new AbortController();
+    controller.current = abort;
+    authenticate(abort.signal, false, true).then(() => { if (!abort.signal.aborted) window.location.assign(appUrl('account')); }).catch(error => {
+      if (!abort.signal.aborted && !(error instanceof DOMException && ['NotAllowedError', 'AbortError'].includes(error.name))) setError(passkeyError(error));
+    });
+    return () => abort.abort();
+  }, [signup, support, busy, attempt]);
+  const start = (name: string) => {
+    controller.current?.abort();
+    const abort = new AbortController(); controller.current = abort;
+    setError(''); setBusy(name); return abort;
+  };
+  const submit = async (event: React.FormEvent) => {
+    event.preventDefault(); const abort = start('password');
+    try {
+      await api(signup ? 'signup' : 'login', { username, password }, abort.signal);
+      setPassword('');
+      if (signup) setCreated(true); else window.location.assign(appUrl('account'));
+    } catch (error) { if (!abort.signal.aborted) setError(passkeyError(error)); }
+    finally { if (!abort.signal.aborted) { setBusy(''); setAttempt(value => value + 1); } }
+  };
+  const passkey = async () => {
+    const abort = start('passkey');
+    try {
+      if (created) await registerPasskey(abort.signal, true); else await authenticate(abort.signal);
+      window.location.assign(appUrl('account'));
+    } catch (error) { if (!abort.signal.aborted) setError(passkeyError(error)); }
+    finally { if (!abort.signal.aborted) { setBusy(''); setAttempt(value => value + 1); } }
+  };
+  return <div className="auth-shell">
+    <div className="auth-eyebrow">YOUR DEVTOOLS TIMES ACCOUNT</div>
+    <h1>{created ? 'A smarter way to sign in.' : signup ? 'Stay curious. Join us.' : 'Welcome back.'}</h1>
+    <p className="auth-intro">{created ? 'Your account is ready. Add a passkey for a simpler, more secure sign-in next time.' : signup ? 'Create your account and make the most of every story.' : 'Sign in to your account to pick up where you left off.'}</p>
+    <section className="auth-card" aria-label={created ? 'Set up a passkey' : signup ? 'Create account' : 'Sign in'} aria-busy={!!busy}>
+      {error && <div className="auth-message error" role="alert">{error}</div>}
+      {created ? <>
+        <div className="passkey-emblem"><FingerPrintIcon aria-hidden="true" /></div>
+        <h2 className="text-xl font-semibold text-center">Leave the password behind</h2>
+        <p className="text-sm text-gray-600 text-center mt-3 mb-6">Use your fingerprint, face, or device screen lock. Your biometric data stays on your device.</p>
+        <button type="button" className="auth-primary w-full" onClick={passkey} disabled={!!busy || !support?.create}><FingerPrintIcon aria-hidden="true" />{busy ? 'Creating passkey…' : 'Create a passkey'}</button>
+        {support && !support.create && <p className="auth-hint" role="status">Passkey creation isn’t available in this browser. You can add one later on a supported device.</p>}
+        <a className="auth-skip" href={appUrl('account')}>Skip for now <ArrowRightIcon aria-hidden="true" /></a>
+      </> : <>
+        {!signup && <>
+          <button type="button" className="auth-primary w-full" onClick={passkey} disabled={!!busy || !support?.available}><FingerPrintIcon aria-hidden="true" />{busy === 'passkey' ? 'Waiting for your passkey…' : 'Sign in with a passkey'}</button>
+          <p className="auth-hint">{support && !support.available ? 'Passkeys aren’t available in this browser. Please use your password.' : 'Use your fingerprint, face, screen lock, or another device.'}</p>
+          <div className="auth-divider"><span>or use your password</span></div>
+        </>}
+        <form onSubmit={submit} className="space-y-5">
+          <div><label htmlFor="username">Username</label><input id="username" name="username" autoComplete={signup ? 'username' : 'username webauthn'} autoCapitalize="none" spellCheck={false} autoFocus value={username} onChange={event => setUsername(event.target.value)} maxLength={128} required disabled={!!busy} /></div>
+          <div><label htmlFor="password">Password</label><input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={event => setPassword(event.target.value)} minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} required disabled={!!busy} aria-describedby={signup ? 'password-hint' : undefined} />{signup && <p id="password-hint" className="auth-hint text-left">At least 8 characters, including a number.</p>}</div>
+          <button type="submit" className={`${signup ? 'auth-primary' : 'auth-secondary'} w-full`} disabled={!!busy} data-skip-tracking="true">{busy === 'password' ? signup ? 'Creating account…' : 'Signing in…' : signup ? 'Create account' : 'Sign in with password'}<ArrowRightIcon aria-hidden="true" /></button>
+        </form>
+        {signup && <div className="auth-note"><ShieldCheckIcon aria-hidden="true" /><p><strong>Your next sign-in can be passwordless.</strong><br />Add a passkey after creating your account.</p></div>}
+      </>}
+    </section>
+    {!created && <p className="auth-footer">{signup ? 'Already have an account?' : 'New to The DevTools Times?'} <a href={appUrl(signup ? 'signin' : 'signup')}>{signup ? 'Sign in' : 'Create an account'}</a></p>}
+    <p className="auth-security"><ShieldCheckIcon aria-hidden="true" />Secure access. More time for the stories that matter.</p>
+  </div>;
+}
