@@ -0,0 +1,53 @@
+import { useEffect, useState, type FormEvent } from 'react';
+import { authenticatePasskey, authError, authRequest, passkeysSupported, registerPasskey } from '../lib/auth';
+import { Icon } from './AccountIcons';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState('');
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [error, setError] = useState('');
+  const [success, setSuccess] = useState('');
+  const [method, setMethod] = useState<'passkey' | 'password'>('passkey');
+  useEffect(() => { const supported = passkeysSupported(); setSupported(supported); if (!supported) setMethod('password'); }, []);
+  async function submit(event: FormEvent) {
+    event.preventDefault(); setError(''); setSuccess(''); setBusy(method);
+    try {
+      if (method === 'passkey') {
+        if (signup) await registerPasskey(username, 'My first passkey');
+        else await authenticatePasskey('signin', username);
+        window.location.assign(`${import.meta.env.BASE_URL}account`);
+      } else {
+        await authRequest(signup ? '/register' : '/login', { username, password });
+        if (signup) { setSuccess('Your account is ready. Sign in to get started.'); setPassword(''); }
+        else window.location.assign(`${import.meta.env.BASE_URL}account`);
+      }
+    } catch (error) { setError(authError(error)); } finally { setBusy(''); }
+  }
+  return <div className="auth-shell">
+    <a className="eyebrow back-link" href={import.meta.env.BASE_URL}>← BACK TO THE TIMES</a>
+    <div className="auth-panel">
+      <span className="icon-tile"><Icon name={signup ? 'user' : 'key'} width={25} height={25}/></span>
+      <p className="eyebrow">YOUR DAILY PERSPECTIVE</p>
+      <h1>{signup ? 'A little more informed.' : 'Welcome back.'}</h1>
+      <p className="muted">{signup ? 'Create your account. Make The Times yours.' : 'Sign in to your DevTools Times account.'}</p>
+      <div className="method-tabs" aria-label="Sign-in method">
+        <button type="button" aria-pressed={method === 'passkey'} disabled={!!busy || supported === false} className={method === 'passkey' ? 'selected' : ''} onClick={() => { setMethod('passkey'); setError(''); }}><Icon/> Passkey <span className="mini-tag">RECOMMENDED</span></button>
+        <button type="button" aria-pressed={method === 'password'} disabled={!!busy} className={method === 'password' ? 'selected' : ''} onClick={() => { setMethod('password'); setError(''); }}>Password</button>
+      </div>
+      {supported === false && <p className="notice">Passkeys aren’t available in this browser. You can continue with a password.</p>}
+      {error && <p className="notice error" role="alert">{error}</p>}
+      {success && <p className="notice success" role="status">{success} <a href={`${import.meta.env.BASE_URL}signin`}>Sign in →</a></p>}
+      <form onSubmit={submit} className="auth-fields">
+        <label htmlFor="username">Username {method === 'passkey' && !signup && <span className="muted">(optional)</span>}</label>
+        <input id="username" name="username" autoComplete="username webauthn" placeholder="Enter your username" value={username} onChange={e => setUsername(e.target.value)} required={signup || method === 'password'} disabled={!!busy}/>
+        {method === 'password' ? <><label htmlFor="password">Password</label><input id="password" type="password" name="password" autoComplete={signup ? 'new-password' : 'current-password'} placeholder="Enter your password" value={password} onChange={e => setPassword(e.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '.*[0-9].*' : undefined} disabled={!!busy}/>{signup && <p className="field-hint">Use at least 8 characters, including a number.</p>}</> : <p className="passkey-explainer"><Icon name="shield"/><span>{signup ? 'No password to create or remember. Use your fingerprint, face, or screen lock to securely access your account.' : 'Use your fingerprint, face, or screen lock. Your device will guide you through the next step.'}</span></p>}
+        <button className="primary-button" disabled={!!busy || supported === null} data-skip-tracking="true">{method === 'passkey' && <Icon/>}{busy ? (method === 'passkey' ? 'Waiting for your device…' : 'Please wait…') : method === 'passkey' ? (signup ? 'Create account with a passkey' : 'Sign in with a passkey') : signup ? 'Create account' : 'Sign in'}<span aria-hidden="true">→</span></button>
+      </form>
+      <p className="auth-switch">{signup ? 'Already a reader?' : 'New to The Times?'} <a href={`${import.meta.env.BASE_URL}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} →</a></p>
+      {signup && <p className="fine-print">By creating an account, you agree to our <a href={`${import.meta.env.BASE_URL}legal/terms`}>Terms of Service</a> and <a href={`${import.meta.env.BASE_URL}legal/privacy`}>Privacy Policy</a>.</p>}
+    </div>
+    <p className="auth-footnote"><Icon name="lock" width={14} height={14}/> Your perspective matters. Your security does, too.</p>
+  </div>;
+}
