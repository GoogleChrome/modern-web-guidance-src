+    key: <><circle cx="8" cy="9" r="4"/><path d="m11 12 9 9m-5-5 3-3m-1 5 3-3"/></>,
+    shield: <><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6z"/><path d="m8 12 3 3 5-6"/></>,
+    user: <><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></>,
+    lock: <><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></>,
+    device: <><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></>,
+    arrow: <path d="m9 5 7 7-7 7"/>,
+    check: <path d="m5 12 4 4L19 6"/>,
+    plus: <path d="M12 5v14M5 12h14"/>,
+    logout: <><path d="M9 4H4v16h5m5-4 4-4-4-4m-5 4h12"/></>,
+    book: <><path d="M12 5v16M3 3c4 0 7 0 9 2 2-2 5-2 9-2v16c-4 0-7 0-9 2-2-2-5-2-9-2z"/></>,
+    bell: <><path d="M5 17h14l-2-4V8a5 5 0 0 0-10 0v5zm5 4h4"/></>,
+  };
+  return <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" {...props}>{paths[name] || paths.key}</svg>;
+}
