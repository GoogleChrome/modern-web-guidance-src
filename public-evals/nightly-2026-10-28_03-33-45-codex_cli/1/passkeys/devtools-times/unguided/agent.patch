+++ b/src/lib/auth.ts
@@ -0,0 +1,62 @@
+// All credential verification and session ownership belong to the authentication API.
+export const API = import.meta.env.PUBLIC_AUTH_API_URL || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export async function authRequest(path: string, body?: unknown, method = 'POST') {
+  const response = await fetch(`${API}${path}`, {
+    method, credentials: 'include',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  if (!response.ok) {
+    if (response.status === 401) throw new Error('Please sign in again to continue.');
+    if (response.status === 404 || response.status === 501) throw new Error('Passkeys are not available right now. Please use your password or try again later.');
+    throw new Error('We couldn’t complete that request. Please try again.');
+  }
+  return response.status === 204 ? {} : response.json();
+}
+export function passkeysSupported() {
+  return typeof window !== 'undefined' && window.isSecureContext && !!window.PublicKeyCredential && !!navigator.credentials;
+}
+function decode(value: string): ArrayBuffer {
+  const text = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
+  return Uint8Array.from(text, c => c.charCodeAt(0)).buffer;
+}
+function encode(value: ArrayBuffer) {
+  return btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+function serialize(credential: PublicKeyCredential) {
+  const response = credential.response;
+  const common = { id: credential.id, rawId: encode(credential.rawId), type: credential.type, authenticatorAttachment: credential.authenticatorAttachment, clientExtensionResults: credential.getClientExtensionResults() };
+  if (response instanceof AuthenticatorAttestationResponse) {
+    return { ...common, response: { clientDataJSON: encode(response.clientDataJSON), attestationObject: encode(response.attestationObject), transports: response.getTransports?.() || [] } };
+  }
+  const assertion = response as AuthenticatorAssertionResponse;
+  return { ...common, response: { clientDataJSON: encode(assertion.clientDataJSON), authenticatorData: encode(assertion.authenticatorData), signature: encode(assertion.signature), userHandle: assertion.userHandle ? encode(assertion.userHandle) : null } };
+}
+export async function registerPasskey(username?: string, name?: string) {
+  if (!passkeysSupported()) throw new Error('Passkeys require a supported browser and a secure connection. You can still use your password.');
+  const { options, challengeId } = await authRequest('/passkeys/register/options', { username });
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    ...options, challenge: decode(options.challenge), user: { ...options.user, id: decode(options.user.id) },
+    excludeCredentials: options.excludeCredentials?.map((item: { id: string }) => ({ ...item, id: decode(item.id) })),
+    authenticatorSelection: { ...options.authenticatorSelection, residentKey: 'required', userVerification: 'required' },
+  };
+  const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  return authRequest('/passkeys/register/verify', { challengeId, credential: serialize(credential), name });
+}
+export async function authenticatePasskey(purpose: 'signin' | 'reauthenticate' = 'signin', username?: string) {
+  if (!passkeysSupported()) throw new Error('Passkeys are not supported in this browser. Please use your password.');
+  const { options, challengeId } = await authRequest('/passkeys/authenticate/options', { purpose, username: username || undefined });
+  const publicKey: PublicKeyCredentialRequestOptions = { ...options, challenge: decode(options.challenge), userVerification: 'required', allowCredentials: options.allowCredentials?.map((item: { id: string }) => ({ ...item, id: decode(item.id) })) };
+  const credential = await navigator.credentials.get({ publicKey }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  return authRequest('/passkeys/authenticate/verify', { purpose, challengeId, credential: serialize(credential) });
+}
+export function authError(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was canceled or timed out. Please try again, or use your password.';
+    if (error.name === 'InvalidStateError') return 'This device already has a passkey for your account. Try signing in with it.';
+    if (error.name === 'SecurityError') return 'Passkeys aren’t available on this domain. Please use your password.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
