+db.exec(`
+  PRAGMA journal_mode=WAL;
+  PRAGMA foreign_keys=ON;
+  CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT NOT NULL COLLATE NOCASE UNIQUE, name TEXT NOT NULL);
+  CREATE TABLE IF NOT EXISTS passkeys (
+    id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key TEXT NOT NULL,
+    counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, aaguid TEXT NOT NULL,
+    device_type TEXT NOT NULL, backed_up INTEGER NOT NULL, registered_at INTEGER NOT NULL, last_used_at INTEGER
+  );
+  CREATE TABLE IF NOT EXISTS sessions (
+    id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), expires INTEGER NOT NULL,
+    pending TEXT, grant_action TEXT, grant_expires INTEGER
+  );
+`);
+const run = (sql, ...params) => db.prepare(sql).run(...params);
+const one = (sql, ...params) => db.prepare(sql).get(...params);
+const all = (sql, ...params) => db.prepare(sql).all(...params);
