+function validateAction(user, action) {
+  if (action === 'profile' || action === 'add-passkey' || action === 'verify') return;
+  if (typeof action === 'string' && action.startsWith('delete:') && credentials(user.id).some(c => `delete:${c.id}` === action)) return;
+  if (typeof action === 'string' && action.startsWith('rename:') && credentials(user.id).some(c => `rename:${c.id}` === action)) return;
+  throw fail(400, 'That account action is not available.');
+}
+
+app.get('/api/account', (req, res) => {
+  if (!req.session?.user_id) return res.json({ user: null, passkeys: [], rpId: req.rpID });
+  res.json(snapshot(req, requireUser(req)));
+});
+app.post('/api/register/options', async (req, res) => {
+  const adding = !!req.session?.user_id;
+  let user;
+  if (adding) {
+    user = requireUser(req);
+    requireGrant(req, 'add-passkey');
+  } else {
+    const profile = validateProfile(req.body);
+    if (one('SELECT id FROM users WHERE email = ?', profile.email)) throw fail(409, 'An account already uses this email. Sign in with your saved passkey.');
