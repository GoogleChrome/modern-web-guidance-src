+test('passkey management enforces ownership, protects the last key, and revokes other sessions', async t => {
+  const { accounts, register } = fixture(t);
+  const { session, state } = await register();
+  const first = state.passkeys[0].id;
+  assert.throws(() => accounts.managePasskey(first, {}, session, true), /last one/);
+  const secondAccount = await register({ name: 'Other User', email: 'other@example.com', passkeyName: 'Other phone' });
+  assert.throws(() => accounts.managePasskey(first, { name: 'Hijack' }, secondAccount.session), /not found/);
+  const request = await accounts.registrationOptions({ passkeyName: 'Backup' }, session, true);
+  await accounts.registrationVerify({ requestId: request.requestId, response: {} }, session, true);
+  const renamed = accounts.managePasskey(first, { name: 'My phone' }, session);
+  assert.equal(renamed.passkeys[0].name, 'My phone');
+  const login = await accounts.authenticationOptions();
+  const otherSession = await accounts.authenticationVerify({ requestId: login.requestId, response: { id: first } });
+  const remaining = accounts.managePasskey(first, {}, session, true);
+  assert.equal(remaining.passkeys.length, 1);
+  assert.throws(() => accounts.snapshot(otherSession), /sign in/);
+  const revoked = await accounts.authenticationOptions();
+  await assert.rejects(accounts.authenticationVerify({ requestId: revoked.requestId, response: { id: first } }), /could not sign you in/);
+});
