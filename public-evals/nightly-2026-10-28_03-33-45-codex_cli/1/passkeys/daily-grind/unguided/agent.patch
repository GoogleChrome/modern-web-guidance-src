+test('real WebAuthn verification accepts a signed assertion and rejects wrong origin, RP, missing UV, and invalid signatures', async t => {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  // COSE EC2 key: kty=2, alg=-7 (ES256), crv=1 (P-256), x and y coordinates.
+  const cose = Buffer.concat([Buffer.from('a5010203262001215820', 'hex'), Buffer.from(jwk.x, 'base64url'), Buffer.from('225820', 'hex'), Buffer.from(jwk.y, 'base64url')]);
+  const credentialId = Buffer.from('test-credential').toString('base64url');
+  const accounts = createAccounts({ origin: 'https://coffee.example.com',
+    verifyRegistration: async () => ({ verified: true, registrationInfo: { credential: { id: credentialId, publicKey: cose, counter: 0, transports: [] }, credentialBackedUp: false } }),
+  });
+  t.after(() => accounts.close());
+  const registration = await accounts.registrationOptions({ name: 'Alex Morgan', email: 'alex@example.com', passkeyName: 'Test authenticator' });
+  const initialSession = await accounts.registrationVerify({ requestId: registration.requestId, response: {} });
+  const userId = accounts.snapshot(initialSession).user.id;
+  let counter = 0;
+  async function assertion({ origin = 'https://coffee.example.com', rp = 'coffee.example.com', flags = 5, badSignature = false } = {}) {
+    const { requestId, options } = await accounts.authenticationOptions();
+    const clientDataJSON = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge: options.challenge, origin, crossOrigin: false }));
+    const count = Buffer.alloc(4); count.writeUInt32BE(++counter);
+    const authenticatorData = Buffer.concat([createHash('sha256').update(rp).digest(), Buffer.from([flags]), count]);
+    const signature = sign('sha256', Buffer.concat([authenticatorData, createHash('sha256').update(clientDataJSON).digest()]), privateKey);
+    if (badSignature) signature[signature.length - 1] ^= 1;
+    return accounts.authenticationVerify({ requestId, response: { id: credentialId, rawId: credentialId, type: 'public-key', clientExtensionResults: {},
+      response: { clientDataJSON: clientDataJSON.toString('base64url'), authenticatorData: authenticatorData.toString('base64url'), signature: signature.toString('base64url'), userHandle: Buffer.from(userId).toString('base64url') } } });
+  }
+  const signedIn = await assertion();
+  assert.equal(accounts.snapshot(signedIn).user.id, userId);
+  await assert.rejects(assertion({ origin: 'https://attacker.example.com' }));
+  await assert.rejects(assertion({ rp: 'attacker.example.com' }));
+  await assert.rejects(assertion({ flags: 1 }));
+  await assert.rejects(assertion({ badSignature: true }));
+});
