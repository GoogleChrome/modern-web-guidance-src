new file mode 100644
index 0000000..a94c6e1
--- /dev/null
+++ b/test/accounts.test.mjs
@@ -0,0 +1,147 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPairSync, createHash, sign } from 'node:crypto';
+import { createAccounts } from '../lib/accounts.mjs';
+
+// Inject only signature verification for deterministic service-policy tests.
+// Production uses SimpleWebAuthn's actual cryptographic verifiers.
+function fixture(t) {
+  let time = 1700000000000;
+  let serial = 0;
+  const accounts = createAccounts({ origin: 'https://coffee.example.com', now: () => time,
+    verifyRegistration: async ({ response }) => {
+      if (response.reject) throw new Error('Invalid attestation');
+      return { verified: true, registrationInfo: { credential: { id: `key-${++serial}`, publicKey: new Uint8Array([1, 2, 3]), counter: 0, transports: ['internal'] }, credentialBackedUp: true } };
+    },
+    verifyAuthentication: async ({ response }) => ({ verified: !response.reject, authenticationInfo: { newCounter: 1, credentialBackedUp: true } }),
+  });
+  t.after(() => accounts.close());
+  const profile = { name: 'Alex Morgan', email: 'Alex@example.com', passkeyName: 'Phone' };
+  async function register(input = profile) {
+    const request = await accounts.registrationOptions(input);
+    const session = await accounts.registrationVerify({ requestId: request.requestId, response: {} });
+    return { session, state: accounts.snapshot(session) };
+  }
+  return { accounts, profile, register, advance: ms => { time += ms; } };
+}
+
+test('registration requests require discoverable passkeys and create no account before verification', async t => {
+  const { accounts, profile } = fixture(t);
+  const request = await accounts.registrationOptions(profile);
+  assert.equal(request.options.rp.id, 'coffee.example.com');
+  assert.equal(request.options.authenticatorSelection.residentKey, 'required');
+  assert.equal(request.options.authenticatorSelection.userVerification, 'required');
+  await assert.rejects(accounts.registrationVerify({ requestId: request.requestId, response: { reject: true } }));
+  const retry = await accounts.registrationOptions(profile);
+  const session = await accounts.registrationVerify({ requestId: retry.requestId, response: {} });
+  assert.equal(accounts.snapshot(session).user.email, 'alex@example.com');
+  await assert.rejects(accounts.registrationVerify({ requestId: retry.requestId, response: {} }), /expired/);
+});
+
+test('sign-in requires a valid, unexpired, single-use challenge and a registered credential', async t => {
+  const { accounts, register, advance } = fixture(t);
+  const { state } = await register();
+  let request = await accounts.authenticationOptions();
+  assert.equal(request.options.userVerification, 'required');
+  await assert.rejects(accounts.authenticationVerify({ requestId: request.requestId, response: { id: state.passkeys[0].id, reject: true } }), /verification failed/);
+  request = await accounts.authenticationOptions();
+  advance(300001);
+  await assert.rejects(accounts.authenticationVerify({ requestId: request.requestId, response: { id: state.passkeys[0].id } }), /expired/);
+  request = await accounts.authenticationOptions();
+  await assert.rejects(accounts.authenticationVerify({ requestId: request.requestId, response: { id: 'unknown-key' } }), /could not sign you in/);
+  request = await accounts.authenticationOptions();
+  const input = { requestId: request.requestId, response: { id: state.passkeys[0].id } };
+  const session = await accounts.authenticationVerify(input);
+  assert.equal(accounts.snapshot(session).user.id, state.user.id);
+  await assert.rejects(accounts.authenticationVerify(input), /expired/);
