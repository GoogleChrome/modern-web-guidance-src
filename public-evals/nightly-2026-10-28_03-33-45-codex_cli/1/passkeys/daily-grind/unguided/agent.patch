+      }
+    }
+  } catch (error) {
+    const status = error instanceof AccountError ? error.status : 400;
+    json(status, { error: error instanceof AccountError ? error.message : 'The passkey request could not be verified. Please try again.' });
+  }
+}).listen(port, () => console.log(`Daily Grind listening on port ${port}`));
