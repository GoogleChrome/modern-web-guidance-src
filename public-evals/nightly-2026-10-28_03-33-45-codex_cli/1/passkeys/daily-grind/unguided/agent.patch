diff --git a/lib/accounts.mjs b/lib/accounts.mjs
new file mode 100644
index 0000000..781261a
--- /dev/null
+++ b/lib/accounts.mjs
@@ -0,0 +1,163 @@
+import { randomBytes, createHash } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import {
+  generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+
+const token = () => randomBytes(32).toString('base64url');
+const hash = value => createHash('sha256').update(value).digest('hex');
+const FIVE_MINUTES = 5 * 60 * 1000;
+export class AccountError extends Error {
+  constructor(message, status = 400) { super(message); this.status = status; }
+}
+function check(condition, message, status) {
+  if (!condition) throw new AccountError(message, status);
+}
+function profile(input) {
+  const name = String(input.name ?? '').trim();
+  const email = String(input.email ?? '').trim().toLowerCase();
+  check(name.length >= 2 && name.length <= 80, 'Enter a name between 2 and 80 characters.');
+  check(email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email), 'Enter a valid email address.');
+  return { name, email };
+}
+function label(value) {
+  const result = String(value ?? '').trim();
+  check(result.length >= 1 && result.length <= 60, 'Use a passkey name between 1 and 60 characters.');
+  return result;
+}
+
+export function createAccounts({ filename = ':memory:', origin, now = Date.now, verifyRegistration = verifyRegistrationResponse, verifyAuthentication = verifyAuthenticationResponse }) {
+  const rpID = new URL(origin).hostname;
+  const db = new DatabaseSync(filename);
+  db.exec(`PRAGMA foreign_keys = ON; PRAGMA journal_mode = WAL;
+    CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL UNIQUE);
+    CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id),
+      public_key BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL,
+      created_at INTEGER NOT NULL, last_used INTEGER, backed_up INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id),
+      expires INTEGER NOT NULL, verified_at INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, purpose TEXT NOT NULL, challenge TEXT NOT NULL,
+      user_id TEXT, session_id TEXT, payload TEXT NOT NULL, expires INTEGER NOT NULL);`);
+  const get = (sql, ...args) => db.prepare(sql).get(...args);
+  const run = (sql, ...args) => db.prepare(sql).run(...args);
+  const all = (sql, ...args) => db.prepare(sql).all(...args);
+  function transaction(fn) {
+    db.exec('BEGIN IMMEDIATE');
+    try { const result = fn(); db.exec('COMMIT'); return result; }
+    catch (error) { db.exec('ROLLBACK'); throw error; }
+  }
+  function session(raw) {
+    const record = raw && get('SELECT * FROM sessions WHERE id = ? AND expires > ?', hash(raw), now());
+    check(record, 'Please sign in to continue.', 401);
+    return record;
+  }
+  function fresh(record) {
+    check(now() - record.verified_at < FIVE_MINUTES, 'Confirm it’s you with your passkey to continue.', 403);
+  }
+  function snapshot(raw) {
+    const record = session(raw);
+    return {
+      user: get('SELECT id, name, email FROM users WHERE id = ?', record.user_id),
+      passkeys: all('SELECT id, name, created_at, last_used, backed_up FROM passkeys WHERE user_id = ? ORDER BY created_at', record.user_id),
+      reauthenticate: now() - record.verified_at >= FIVE_MINUTES,
+    };
+  }
+  function newSession(userId) {
+    const raw = token();
+    run('INSERT INTO sessions VALUES (?, ?, ?, ?)', hash(raw), userId, now() + 7 * 86400000, now());
+    return raw;
+  }
+  function challenge(purpose, value, userId = null, sessionId = null, payload = {}) {
+    run('DELETE FROM challenges WHERE expires <= ?', now());
+    run('DELETE FROM sessions WHERE expires <= ?', now());
+    const id = token();
+    run('INSERT INTO challenges VALUES (?, ?, ?, ?, ?, ?, ?)', hash(id), purpose, value, userId, sessionId, JSON.stringify(payload), now() + FIVE_MINUTES);
+    return id;
+  }
