+test('stale sessions require reauthentication and reauth is bound to the current session', async t => {
+  const { accounts, register, advance, profile } = fixture(t);
+  const { session, state } = await register();
+  advance(300001);
+  assert.equal(accounts.snapshot(session).reauthenticate, true);
+  assert.throws(() => accounts.updateProfile(profile, session), /Confirm/);
+  await assert.rejects(accounts.registrationOptions({ passkeyName: 'Backup' }, session, true), /Confirm/);
+  assert.throws(() => accounts.managePasskey(state.passkeys[0].id, { name: 'New name' }, session), /Confirm/);
+  const request = await accounts.authenticationOptions(session, true);
+  await accounts.authenticationVerify({ requestId: request.requestId, response: { id: state.passkeys[0].id } }, session, true);
+  assert.equal(accounts.snapshot(session).reauthenticate, false);
+  assert.equal(accounts.updateProfile({ ...profile, name: 'Alex Updated' }, session).user.name, 'Alex Updated');
+  const login = await accounts.authenticationOptions();
+  const otherSession = await accounts.authenticationVerify({ requestId: login.requestId, response: { id: state.passkeys[0].id } });
+  const bound = await accounts.authenticationOptions(session, true);
+  await assert.rejects(accounts.authenticationVerify({ requestId: bound.requestId, response: { id: state.passkeys[0].id } }, otherSession, true), /Session changed/);
+});
