diff --git a/public/account.css b/public/account.css
new file mode 100644
index 0000000..082264f
--- /dev/null
+++ b/public/account.css
@@ -0,0 +1,68 @@
+[hidden] { display: none !important; }
+button, input { font: inherit; }
+button { cursor: pointer; }
+button:disabled { cursor: wait; opacity: .55; }
+:focus-visible { outline: 3px solid #bc742b; outline-offset: 4px; }
+nav .logout-link { color: white; background: transparent; font-size: .9rem; }
+#account-dialog { padding: 0; margin: auto; border: 0; border-radius: 16px; width: min(920px, calc(100% - 32px)); max-height: calc(100dvh - 48px); color: #3e2723; box-shadow: 0 24px 100px #20130d55; }
+#account-dialog::backdrop { background: #241a15a8; backdrop-filter: blur(4px); }
+body:has(#account-dialog[open]) { overflow: hidden; }
+.account-layout { display: grid; grid-template-columns: .82fr 1.18fr; background: #fffcf8; }
+.account-story { background: linear-gradient(180deg, #281e16aa, #281e1670 40%, #281e16e6), url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=800&q=85') center/cover; padding: 36px; display: flex; flex-direction: column; justify-content: space-between; min-height: 620px; color: #fff7eb; }
+.account-wordmark { font-size: .8rem; letter-spacing: 2px; font-weight: 700; }
+.account-story h2 { font-family: Georgia, serif; font-weight: 400; font-size: 2.7rem; line-height: 1.16; margin: 18px 0; }
+.account-story p { color: #ede1d0; font-size: .95rem; }
+.account-story-footer { font-size: .72rem; letter-spacing: 1px; color: #ddd1c0; margin-top: 44px; }
+.account-panel { position: relative; padding: 42px 40px 28px; min-width: 0; }
+.account-eyebrow { font-size: .64rem; font-weight: 700; letter-spacing: 1.9px; color: #927155; }
+.account-story .account-eyebrow { color: #edd6b5; }
+.account-panel > h2 { font-family: Georgia, serif; font-size: 2.2rem; font-weight: 400; margin: 4px 0; }
+.account-subtitle { color: #85756a; font-size: .88rem; margin: 0 0 24px; }
+.account-close { border: 0; background: transparent; position: absolute; top: 14px; right: 18px; font-size: 1.7rem; line-height: 1; padding: 6px; color: #85756a; }
+.account-tabs { display: flex; border-bottom: 1px solid #e7dfd4; gap: 24px; margin-bottom: 24px; }
+.account-tabs button { border: 0; border-bottom: 2px solid transparent; padding: 8px 0 12px; background: transparent; color: #8a7b6e; font-weight: 600; font-size: .86rem; }
+.account-tabs button[aria-selected="true"] { color: #4e342e; border-bottom-color: #4e342e; }
+.account-panel label { display: block; font-size: .79rem; font-weight: 600; margin: 16px 0 6px; }
+.account-panel input { width: 100%; min-width: 0; padding: 11px 13px; background: white; border: 1px solid #dcd1c5; border-radius: 6px; font-size: .9rem; color: #3e2723; }
+.account-panel input:focus { border-color: #846145; }
+.account-primary { width: 100%; padding: 12px 18px; border: 1px solid #4e342e; border-radius: 6px; background: #4e342e; color: white; font-weight: 600; font-size: .9rem; margin-top: 22px; }
+.account-primary:hover { background: #3e2723; }
+.account-secondary { border: 1px solid #d9ccbc; background: transparent; color: #4e342e; padding: 8px 12px; border-radius: 5px; font-size: .8rem; }
+.account-secondary:hover { background: #f2ece3; }
+.account-text { background: transparent; border: 0; color: #7f4c33; font-size: .8rem; text-decoration: underline; padding: 6px 0; }
+.passkey-illustration { display: grid; place-items: center; margin: 30px auto 20px; height: 72px; width: 72px; background: #f0e7db; border: 1px solid #e7daca; border-radius: 50%; color: #78563c; }
+.passkey-illustration svg { width: 34px; height: 34px; }
+.account-intro { text-align: center; }
+.account-intro h3 { font-family: Georgia, serif; font-size: 1.4rem; font-weight: 400; margin-bottom: 8px; }
+.account-intro p { color: #85756a; font-size: .87rem; }
+.account-note { font-size: .75rem; color: #85756a; margin-top: 12px; }
+.account-help { border-top: 1px solid #e9e0d6; padding-top: 18px; margin-top: 26px; color: #8b7a6b; font-size: .7rem; line-height: 1.65; }
+.account-help span { color: #806344; margin-right: 4px; }
+#account-status { padding: 11px 13px; border-radius: 6px; background: #edf1e7; color: #455437; margin-bottom: 16px; font-size: .83rem; }
+#account-status[data-error="true"] { background: #fbebe4; color: #923f29; }
+.account-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 20px 0 8px; }
+.account-section-heading h3 { font-family: Georgia, serif; font-weight: 400; font-size: 1.25rem; }
+.account-key { border: 1px solid #e4dace; border-radius: 8px; padding: 14px; margin-top: 12px; background: white; }
+.account-key-title { display: flex; gap: 10px; align-items: center; }
+.account-key-title svg { height: 22px; width: 22px; flex-shrink: 0; color: #8d7154; }
+.account-key-title strong { overflow-wrap: anywhere; font-size: .88rem; }
+.account-key p { font-size: .7rem; color: #8b7a6b; margin-top: 6px; }
+.account-key-actions { display: flex; gap: 16px; margin-top: 5px; }
+.account-key-actions button { font-size: .72rem; }
+.account-key-actions button:disabled { cursor: not-allowed; }
+.account-inline-form { border: 1px solid #e4dace; padding: 0 14px 14px; border-radius: 8px; margin-top: 14px; }
+.account-form-actions { display: flex; align-items: center; gap: 14px; }
+.account-form-actions .account-primary { width: auto; margin-top: 14px; }
+.account-confirm { background: #f9eee5; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: .8rem; }
+.account-confirm .account-secondary { margin: 8px 8px 0 0; }
+@media (max-width: 700px) {
+  .account-layout { grid-template-columns: 1fr; }
+  .account-story { display: none; }
+  .account-panel { padding: 34px 24px 24px; }
+  #account-dialog { max-width: 480px; }
+  nav { flex-wrap: wrap; gap: 10px; }
+  nav ul { flex-wrap: wrap; gap: 10px 16px; }
+  nav ul li { margin-left: 0; }
+  .hero h1 { font-size: 2.3rem; }
+}
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
