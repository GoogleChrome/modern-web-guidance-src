@@ -0,0 +1,113 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { mkdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { createAccounts, AccountError } from './lib/accounts.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+const configuredURL = new URL(origin);
+if (configuredURL.origin !== origin || (configuredURL.protocol !== 'https:' && configuredURL.hostname !== 'localhost')) {
+  throw new Error('APP_ORIGIN must be an HTTPS origin (or http://localhost for local development), with no trailing slash.');
+}
+const dataDirectory = resolve(process.env.DATA_DIR || 'data');
+mkdirSync(dataDirectory, { recursive: true, mode: 0o700 });
+const accounts = createAccounts({ filename: resolve(dataDirectory, 'accounts.sqlite'), origin });
+const cookieName = configuredURL.protocol === 'https:' ? '__Host-daily_grind' : 'daily_grind';
+const sessionCookie = (value, clear = false) => `${cookieName}=${value}; HttpOnly; SameSite=Strict; Path=/; Max-Age=${clear ? 0 : 604800}${configuredURL.protocol === 'https:' ? '; Secure' : ''}`;
+const limits = new Map();
+function rateLimit(request) {
+  // Use the socket address; do not trust client-supplied forwarding headers.
+  const key = request.socket.remoteAddress;
+  const now = Date.now();
+  if (limits.size > 10000) for (const [id, entry] of limits) if (entry.until <= now) limits.delete(id);
+  const entry = limits.get(key);
+  if (!entry || entry.until <= now) limits.set(key, { count: 1, until: now + 60000 });
+  else if (++entry.count > 60) throw new AccountError('Too many requests. Please wait a minute and try again.', 429);
+}
+async function body(request) {
+  if (!request.headers['content-type']?.startsWith('application/json')) throw new AccountError('Expected JSON.', 415);
+  const chunks = [];
+  let bytes = 0;
+  for await (const chunk of request) {
+    bytes += chunk.length;
+    if (bytes > 65536) throw new AccountError('Request is too large.', 413);
+    chunks.push(chunk);
+  }
+  try {
+    const result = JSON.parse(Buffer.concat(chunks).toString());
+    if (!result || typeof result !== 'object' || Array.isArray(result)) throw new Error();
+    return result;
+  } catch { throw new AccountError('Invalid JSON.'); }
+}
+const staticFiles = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/account': ['index.html', 'text/html; charset=utf-8'],
+  '/account.js': ['public/account.js', 'text/javascript; charset=utf-8'],
+  '/account.css': ['public/account.css', 'text/css; charset=utf-8'],
+};
+createServer(async (request, response) => {
+  const headers = {
+    'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Content-Security-Policy': "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
+    'Permissions-Policy': 'publickey-credentials-get=(self), publickey-credentials-create=(self)',
+  };
+  function json(status, value, cookie) {
+    response.writeHead(status, { ...headers, 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...(cookie ? { 'Set-Cookie': cookie } : {}) });
+    response.end(JSON.stringify(value));
+  }
+  try {
+    const path = new URL(request.url, origin).pathname;
+    if (!path.startsWith('/api/')) {
+      const file = staticFiles[path];
+      if (!file || !['GET', 'HEAD'].includes(request.method)) { response.writeHead(404, headers); response.end('Not found'); return; }
+      const content = await readFile(new URL(file[0], import.meta.url));
+      response.writeHead(200, { ...headers, 'Content-Type': file[1] });
+      response.end(request.method === 'HEAD' ? undefined : content); return;
+    }
+    const raw = request.headers.cookie?.split(';').map(item => item.trim()).find(item => item.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    if (request.method === 'GET' && path === '/api/account') {
+      try { json(200, accounts.snapshot(raw)); }
+      catch (error) { if (error.status === 401) json(200, { user: null }); else throw error; }
+      return;
+    }
+    if (request.headers.origin !== origin) throw new AccountError('Request origin does not match this site.', 403);
+    rateLimit(request);
+    const input = await body(request);
+    const action = `${request.method} ${path}`;
+    switch (action) {
+      case 'POST /api/register/options': json(200, await accounts.registrationOptions(input)); break;
+      case 'POST /api/passkeys/options': json(200, await accounts.registrationOptions(input, raw, true)); break;
+      case 'POST /api/register/verify': {
+        const next = await accounts.registrationVerify(input);
+        accounts.logout(raw);
+        json(200, accounts.snapshot(next), sessionCookie(next)); break;
+      }
+      case 'POST /api/passkeys/verify': {
+        await accounts.registrationVerify(input, raw, true);
+        json(200, accounts.snapshot(raw)); break;
+      }
+      case 'POST /api/login/options': json(200, await accounts.authenticationOptions()); break;
+      case 'POST /api/reauth/options': json(200, await accounts.authenticationOptions(raw, true)); break;
+      case 'POST /api/login/verify': {
+        const next = await accounts.authenticationVerify(input);
+        accounts.logout(raw);
+        json(200, accounts.snapshot(next), sessionCookie(next)); break;
+      }
+      case 'POST /api/reauth/verify': {
+        await accounts.authenticationVerify(input, raw, true);
+        json(200, accounts.snapshot(raw)); break;
+      }
+      case 'PATCH /api/profile': json(200, accounts.updateProfile(input, raw)); break;
+      case 'POST /api/logout': accounts.logout(raw); json(200, { user: null }, sessionCookie('', true)); break;
