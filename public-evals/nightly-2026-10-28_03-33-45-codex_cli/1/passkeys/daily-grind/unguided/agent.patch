--- /dev/null
+++ b/account-client.js
@@ -0,0 +1,176 @@
+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const dialog = document.querySelector('#account-dialog');
+const content = document.querySelector('#account-content');
+const status = document.querySelector('#account-status');
+const subtitle = document.querySelector('#account-subtitle');
+const logout = document.querySelector('#nav-logout');
+let account = { user: null };
+let tab = 'signin';
+let busy = false;
+let loaded = false;
+let canAuthenticate = window.isSecureContext && browserSupportsWebAuthn();
+const keyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="5"/><path d="m12 12 9 9m-3-3 3-3m-6 0 3-3"/></svg>';
+const escape = value => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
+const date = value => new Date(value).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+function message(text, error = false) {
+  status.textContent = text; status.hidden = !text; status.dataset.error = String(error);
+}
+async function api(path, input, method = 'POST') {
+  const response = await fetch(`/api/${path}`, { method, credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, ...(method === 'GET' ? {} : { body: JSON.stringify(input || {}) }) });
+  const type = response.headers.get('content-type') || '';
+  if (!type.includes('application/json')) throw new Error('Account services are unavailable. Please try again later.');
+  const data = await response.json();
+  if (!response.ok) {
+    const error = new Error(data.error || 'Something went wrong. Please try again.');
+    error.status = response.status; throw error;
+  }
+  return data;
+}
+function setBusy(value) {
+  busy = value; content.setAttribute('aria-busy', String(value));
+  for (const button of dialog.querySelectorAll('button, input')) {
+    if (button.id !== 'account-close') button.disabled = value || button.dataset.disabled === 'true';
+  }
+  logout.disabled = value;
+}
+async function work(fn) {
+  if (busy) return;
+  message(''); setBusy(true);
+  try { await fn(); }
+  catch (error) {
+    if (error.status === 401) { account = { user: null }; tab = 'signin'; render(); }
+    const cancelled = ['NotAllowedError', 'AbortError', 'ERROR_CEREMONY_ABORTED', 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY'].includes(error.name) || ['ERROR_CEREMONY_ABORTED', 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY'].includes(error.code);
+    message(cancelled ? 'The passkey prompt was cancelled or timed out. You can try again.' : error.name === 'InvalidStateError' || error.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED' ? 'This device already has a passkey for your account. Try another device or security key.' : error.message || 'Could not complete the request. Please try again.', true);
+  } finally { setBusy(false); }
+}
+function update(next) { account = next; render(); }
+async function authenticate(reauth = false) {
+  message(reauth ? 'Confirm it’s you using your device or security key…' : 'Follow the passkey prompt on your device…');
+  const path = reauth ? 'reauth' : 'login';
+  const { options, requestId } = await api(`${path}/options`);
+  const response = await startAuthentication({ optionsJSON: options });
+  const next = await api(`${path}/verify`, { requestId, response });
+  account = next;
+  return next;
+}
+async function sensitive(fn) {
+  // Refresh from the server so a panel left open cannot bypass reauthentication.
+  const next = await api('account', null, 'GET');
+  if (!next.user) { update(next); throw new Error('Your session expired. Please sign in again.'); }
+  account = next;
+  if (next.reauthenticate) await authenticate(true);
+  try { return await fn(); }
+  catch (error) { if (error.status !== 403) throw error; await authenticate(true); return fn(); }
+}
+async function register(input, adding = false) {
+  const path = adding ? 'passkeys' : 'register';
+  const { options, requestId } = await api(`${path}/options`, input);
+  message('Follow the prompt to save a passkey on your device or security key…');
+  const response = await startRegistration({ optionsJSON: options });
+  update(await api(`${path}/verify`, { requestId, response }));
+  message(adding ? 'Your new passkey is ready to use.' : 'Welcome to The Daily Grind. Your account and passkey are ready.');
+}
+function render() {
+  logout.hidden = !account.user;
+  subtitle.textContent = account.user ? `Welcome back, ${account.user.name}. Make yourself at home.` : 'Your coffee break, with one less password.';
+  if (!account.user) {
+    content.innerHTML = `<div class="account-tabs" role="tablist" aria-label="Account access">
+      <button type="button" role="tab" id="signin-tab" aria-controls="access-panel" aria-selected="${tab === 'signin'}" data-tab="signin">Sign in</button>
+      <button type="button" role="tab" id="register-tab" aria-controls="access-panel" aria-selected="${tab === 'register'}" data-tab="register">Create account</button></div>
+      <div id="access-panel" role="tabpanel" aria-labelledby="${tab}-tab">
+      ${tab === 'signin' ? `<div class="account-intro"><div class="passkey-illustration">${keyIcon}</div><h3>A familiar face. A fresh cup.</h3><p>Sign in with your fingerprint, face, device PIN, or security key. No password to remember.</p></div>
+        <button type="button" class="account-primary" data-action="signin" ${!canAuthenticate ? 'disabled data-disabled="true"' : ''}>Sign in with a passkey <span aria-hidden="true">→</span></button>
+        <p class="account-note">Using a different device? Choose a passkey from your phone or a security key in the prompt.</p>` : `<form id="register-form">
+        <label for="register-name">Full name</label><input id="register-name" name="name" autocomplete="name" placeholder="Alex Morgan" required minlength="2" maxlength="80">
+        <label for="register-email">Email address</label><input id="register-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254">
+        <label for="register-key">Passkey name</label><input id="register-key" name="passkeyName" placeholder="e.g. My phone" required maxlength="60">
+        <button type="submit" class="account-primary" ${!canAuthenticate ? 'disabled data-disabled="true"' : ''}>Create account with a passkey <span aria-hidden="true">→</span></button>
+        <p class="account-note">Your device will ask you to save a passkey. Your account is created only when that step succeeds. Email is used for your profile, and is not verified.</p></form>`}</div>`;
+  } else {
+    content.innerHTML = `<div class="account-tabs" role="tablist" aria-label="Account settings">
+      <button type="button" id="profile-tab" role="tab" aria-controls="settings-panel" aria-selected="${tab !== 'passkeys'}" data-tab="profile">Profile</button>
+      <button type="button" id="passkeys-tab" role="tab" aria-controls="settings-panel" aria-selected="${tab === 'passkeys'}" data-tab="passkeys">Passkeys (${account.passkeys.length})</button></div>
+      <div id="settings-panel" role="tabpanel" aria-labelledby="${tab === 'passkeys' ? 'passkeys' : 'profile'}-tab">
+      ${tab !== 'passkeys' ? `<div class="account-section-heading"><h3>Your details</h3></div><p class="account-note">A few details to make your daily ritual yours.</p>
+        <form id="profile-form"><label for="profile-name">Full name</label><input id="profile-name" name="name" autocomplete="name" required minlength="2" maxlength="80" value="${escape(account.user.name)}">
+        <label for="profile-email">Email address</label><input id="profile-email" name="email" type="email" autocomplete="email" required maxlength="254" value="${escape(account.user.email)}">
+        <button type="submit" class="account-primary">Save changes</button><p class="account-note">We may ask you to confirm with your passkey before saving. Updating your email keeps your existing passkeys working.</p></form>` : `<div class="account-section-heading"><h3>Your saved passkeys</h3><button type="button" class="account-secondary" data-action="show-add" ${!canAuthenticate ? 'disabled data-disabled="true"' : ''}>+ Add passkey</button></div>
+        <p class="account-note">Keep a second passkey as a backup. You need at least one to access your account.</p>
+        <div id="passkey-editor"></div><div>${account.passkeys.map(key => `<article class="account-key" data-key="${escape(key.id)}"><div class="account-key-title">${keyIcon}<strong>${escape(key.name)}</strong></div><p>Added ${date(key.created_at)} · ${key.backed_up ? 'Backed up by your passkey provider' : 'Not currently backed up'}</p><p>${key.last_used ? `Last used ${date(key.last_used)}` : 'Not used to sign in yet'}</p><div class="account-key-actions"><button type="button" class="account-text" data-action="rename">Rename</button><button type="button" class="account-text" data-action="remove" ${account.passkeys.length === 1 ? 'disabled data-disabled="true" title="Add another passkey before removing your last one"' : ''}>Remove</button></div><div class="account-key-editor"></div></article>`).join('')}</div>
+        <p class="account-note">Removing a passkey here revokes its access. To delete it from your device, use your device’s password or passkey manager.</p>`}</div>
+        <div class="account-section-heading"><button type="button" class="account-text" data-action="reauth" ${!canAuthenticate ? 'disabled data-disabled="true"' : ''}>Confirm it’s me</button><button type="button" class="account-text" data-action="logout">Sign out</button></div>`;
+  }
+  content.setAttribute('aria-busy', String(busy));
+  if (busy) setBusy(true);
+  if (!canAuthenticate) message('Passkeys need a supported browser and a secure HTTPS connection (or localhost). Please open this site in a compatible browser.', true);
+}
+async function load() {
+  await work(async () => { update(await api('account', null, 'GET')); loaded = true; });
+  if (!loaded) {
+    content.innerHTML = '<p class="account-note">We couldn’t load your account.</p><button type="button" class="account-primary" data-action="retry">Try again</button>';
+  }
+}
+document.querySelector('#account-open').addEventListener('click', event => {
+  event.preventDefault(); dialog.showModal(); if (!busy) load();
+});
+document.querySelector('#account-close').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if (event.target === dialog) { const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); } });
+async function signout() { update(await api('logout')); tab = 'signin'; render(); message('You’re signed out. See you for your next cup.'); }
+logout.addEventListener('click', () => work(signout));
+content.addEventListener('keydown', event => {
+  const tabs = [...content.querySelectorAll('[role="tab"]')];
+  if (tabs.includes(event.target) && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+    event.preventDefault();
+    const index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (tabs.indexOf(event.target) + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
+    tabs[index].click();
+  }
+});
+content.addEventListener('click', event => {
+  const button = event.target.closest('button'); if (!button || busy) return;
+  if (button.dataset.tab) { tab = button.dataset.tab; message(''); render(); content.querySelector(`[data-tab="${tab}"]`).focus(); return; }
+  const action = button.dataset.action;
+  if (action === 'retry') return load();
+  if (action === 'signin') return work(async () => { update(await authenticate()); tab = 'profile'; render(); message('You’re signed in. Welcome back.'); });
+  if (action === 'reauth') return work(async () => { update(await authenticate(true)); message('Identity confirmed. You’re ready to update your account.'); });
+  if (action === 'logout') return work(signout);
+  if (action === 'show-add') {
+    document.querySelector('#passkey-editor').innerHTML = '<form id="add-key-form" class="account-inline-form"><label for="new-key-name">New passkey name</label><input id="new-key-name" name="passkeyName" placeholder="e.g. Backup security key" required maxlength="60"><div class="account-form-actions"><button type="submit" class="account-primary">Save a new passkey</button><button type="button" class="account-text" data-action="cancel-add">Cancel</button></div></form>';
+    document.querySelector('#new-key-name').focus(); return;
+  }
+  if (action === 'cancel-add') { document.querySelector('#passkey-editor').innerHTML = ''; content.querySelector('[data-action="show-add"]').focus(); return; }
+  const row = button.closest('[data-key]');
+  if (!row) return;
+  const key = account.passkeys.find(item => item.id === row.dataset.key);
+  const editor = row.querySelector('.account-key-editor');
+  if (action === 'rename') {
+    editor.innerHTML = `<form class="rename-key-form"><label for="rename-${escape(key.id)}">Passkey name</label><input id="rename-${escape(key.id)}" name="name" value="${escape(key.name)}" required maxlength="60"><div class="account-form-actions"><button type="submit" class="account-primary">Save name</button><button type="button" class="account-text" data-action="cancel-key">Cancel</button></div></form>`;
+    editor.querySelector('input').focus();
+  }
+  if (action === 'remove') {
+    editor.innerHTML = `<div class="account-confirm"><p>Remove “${escape(key.name)}”? This passkey will no longer sign you in, and your other sessions will be signed out.</p><button type="button" class="account-secondary" data-action="confirm-remove">Remove passkey</button><button type="button" class="account-text" data-action="cancel-key">Keep passkey</button></div>`;
+    editor.querySelector('[data-action="cancel-key"]').focus();
+  }
+  if (action === 'cancel-key') { editor.innerHTML = ''; row.querySelector('[data-action="rename"]').focus(); }
+  if (action === 'confirm-remove') work(async () => {
+    await sensitive(async () => update(await api(`passkeys/${key.id}`, {}, 'DELETE')));
+    message('Passkey removed. Your other sessions have been signed out.');
+    content.querySelector('[data-action="show-add"]').focus();
+  });
+});
+content.addEventListener('submit', event => {
+  event.preventDefault();
+  const form = event.target;
+  if (!form.reportValidity()) return;
+  const input = Object.fromEntries(new FormData(form));
+  if (form.id === 'register-form') return work(() => register(input));
+  if (form.id === 'profile-form') return work(async () => { await sensitive(async () => update(await api('profile', input, 'PATCH'))); message('Your profile has been updated.'); });
+  if (form.id === 'add-key-form') return work(() => sensitive(() => register(input, true)));
+  if (form.classList.contains('rename-key-form')) {
+    const id = form.closest('[data-key]').dataset.key;
+    return work(async () => { await sensitive(async () => update(await api(`passkeys/${id}`, input, 'PATCH'))); message('Passkey renamed.'); });
+  }
+});
+// Restore session state without opening the panel or showing an intrusive error.
+api('account', null, 'GET').then(next => { if (!busy && !dialog.open) { account = next; logout.hidden = !next.user; } }).catch(() => {});
+if (location.pathname === '/account') { dialog.showModal(); load(); }
