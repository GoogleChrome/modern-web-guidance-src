+  <script>
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with espresso.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Hot', 'Iced']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Enjoy our dark roast as a concentrated espresso.',
+        sizes: ['Single shot', 'Double shot'],
+        preparations: ['Hot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness and served chilled over ice.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Iced']
+      }
+    };
+
+    const dialog = document.querySelector('#drink-dialog');
+    const title = document.querySelector('#dialog-title');
+    const description = document.querySelector('#drink-description');
+    const drinkChoice = document.querySelector('#drink-choice');
+    const orderForm = document.querySelector('#order-form');
+    let opener;
+    let orderingMenu = false;
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      title.textContent = orderingMenu ? 'Order a seasonal favorite' : drink.name;
+      description.textContent = drink.description;
+      document.querySelector('#drink-size').replaceChildren(
+        ...drink.sizes.map(size => new Option(size, size))
+      );
+      document.querySelector('#drink-temperature').replaceChildren(
+        ...drink.preparations.map(preparation => new Option(preparation, preparation))
+      );
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        orderingMenu = button.hasAttribute('data-order-menu');
+        orderForm.reset();
+        drinkChoice.value = button.dataset.drink;
+        updateDrink();
+        dialog.showModal();
+        document.documentElement.classList.add('dialog-open');
+        title.focus();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    document.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+
+    // Support backdrop dismissal in browsers without closedby="any".
+    // Both ends of the gesture must be outside, so dragging from a field
+    // onto the backdrop does not accidentally dismiss the dialog.
+    function isBackdrop(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.target === dialog && (
+        event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom
+      );
+    }
+
+    let backdropPointerId = null;
+    dialog.addEventListener('pointerdown', event => {
+      backdropPointerId = event.isPrimary && event.button === 0 && isBackdrop(event)
+        ? event.pointerId : null;
+    });
+    dialog.addEventListener('pointerup', event => {
+      if (event.pointerId === backdropPointerId && isBackdrop(event)) dialog.close();
+      backdropPointerId = null;
+    });
+    dialog.addEventListener('pointercancel', () => { backdropPointerId = null; });
+
+    // Native cancel handling supports Escape and platform dismiss requests.
+    dialog.addEventListener('close', () => {
+      document.documentElement.classList.remove('dialog-open');
+      backdropPointerId = null;
+      if (opener && opener.isConnected) opener.focus({ preventScroll: true });
+    });
+  </script>
+
 </body>
 
