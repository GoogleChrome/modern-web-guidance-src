+  <script>
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        sizes: ['Small', 'Medium', 'Large']
+      }
+    };
+    const drinkDialog = document.getElementById('drink-dialog');
+    const drinkChoice = document.getElementById('drink-choice');
+    const drinkSize = document.getElementById('drink-size');
+
+    function updateDrinkDetails() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      drinkSize.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        drinkDialog.querySelector('.order-form').reset();
+        drinkChoice.value = button.dataset.drink;
+        updateDrinkDetails();
+        // Focus the invoker even on platforms that don't focus buttons on click.
+        // The native modal will then restore focus to this button when dismissed.
+        button.focus();
+        drinkDialog.showModal();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrinkDetails);
+
+    // Older browsers ignore closedby. Check both ends of a pointer interaction
+    // so selecting text or clicking dialog padding doesn't dismiss the dialog.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      let pressedOutside = false;
+      function isOutside(event) {
+        const rect = drinkDialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      }
+      drinkDialog.addEventListener('pointerdown', event => {
+        pressedOutside = event.isPrimary && event.button === 0 && isOutside(event);
+      });
+      drinkDialog.addEventListener('pointerup', event => {
+        if (event.isPrimary && pressedOutside && isOutside(event)) drinkDialog.close();
+        pressedOutside = false;
+      });
+      drinkDialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+      drinkDialog.addEventListener('close', () => { pressedOutside = false; });
+    }
+  </script>
+
 </body>
 
