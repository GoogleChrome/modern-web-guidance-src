new file mode 100644
index 0000000..1d6357f
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,75 @@
+import type { APIRoute } from 'astro';
+import { Buffer } from 'node:buffer';
+
+const json = (body: Record<string, unknown>, status = 200) => new Response(JSON.stringify(body), {
+  status,
+  headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, url }) => {
+  // This app disables Astro's global origin check; keep SMS requests same-origin.
+  if (request.headers.get('origin') !== url.origin) return json({ error: 'Invalid request origin.' }, 403);
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const { action, username, password, code } = body;
+  const phone = typeof body.phone === 'string' ? body.phone.replace(/[\s()\-]/g, '') : '';
+  if (!/^\+[1-9]\d{7,14}$/.test(phone)) return json({ error: 'Enter a valid phone number including its country code, starting with +.' }, 400);
+  if (action !== 'send' && action !== 'verify') return json({ error: 'Invalid request.' }, 400);
+  if (action === 'verify' && (
+    typeof username !== 'string' || !username.trim() || username.length > 100 ||
+    typeof password !== 'string' || password.length < 8 || password.length > 256 || !/\d/.test(password) ||
+    typeof code !== 'string' || !/^\d{6}$/.test(code)
+  )) return json({ error: 'Enter a username, a password of at least 8 characters containing a number, and a 6-digit code.' }, 400);
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) return json({ error: 'SMS verification is currently unavailable. Please try again later.' }, 503);
+
+  try {
+    const parameters = new URLSearchParams({ To: phone });
+    if (action === 'send') {
+      parameters.set('Channel', 'sms');
+      // The template must end with @your-hostname #{{code}} for WebOTP.
+      if (process.env.TWILIO_VERIFY_TEMPLATE_SID) parameters.set('TemplateSid', process.env.TWILIO_VERIFY_TEMPLATE_SID);
+    } else parameters.set('Code', code);
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service)}/${action === 'send' ? 'Verifications' : 'VerificationCheck'}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: parameters,
+      signal: AbortSignal.timeout(15_000),
+    });
+    const result = await response.json();
+    if (response.status === 429 || result.code === 60202 || result.code === 60203) return json({ error: 'Too many attempts. Please wait a minute before requesting another code.' }, 429);
+    if (!response.ok) return json({ error: action === 'send' ? 'Unable to send an SMS to that number. Check the number and try again.' : 'Your code is invalid or has expired. Try again or request a new code.' }, 400);
+    if (action === 'send') {
+      if (result.status !== 'pending') return json({ error: 'Unable to send your code. Please try again.' }, 502);
+      return json({ sent: true });
+    }
+    if (result.status !== 'approved') return json({ error: 'That code is incorrect. Please try again.' }, 400);
+
+    // Never create an account until the SMS provider approves the code for this number.
+    try {
+      const registration = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password, phone }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!registration.ok) return json({ error: 'Your phone was verified, but registration failed. Check your account details and request a new code to try again.', restart: true }, 400);
+      return json({ registered: true });
+    } catch {
+      return json({ error: 'Registration could not be confirmed. Try signing in first. If your account was not created, request a new code to try again.', restart: true }, 502);
+    }
+  } catch {
+    return json({ error: 'The SMS service could not be reached. Please try again.' }, 502);
+  }
+};
