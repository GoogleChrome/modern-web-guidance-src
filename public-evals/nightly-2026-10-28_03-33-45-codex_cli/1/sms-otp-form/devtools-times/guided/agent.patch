+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { checkChallenge, hashCode, normalizePhone, smsMessage, validPhone, sendCode } from '../src/lib/signup.ts';
+
+const phone = '+12025550123';
+const now = 1_000_000;
+const challenge = () => ({ id: 'test-challenge', phone, hash: hashCode('012345'), expiresAt: now + 300_000, sentAt: now, attempts: 0 });
+
+test('accepts a leading-zero code and rejects a code for a different number', () => {
+  assert.equal(checkChallenge(challenge(), phone, '012345', now).error, null);
+  assert.ok(checkChallenge(challenge(), '+442079460123', '012345', now).error);
+});
+
+test('rejects a missing, consumed, or expired challenge', () => {
+  assert.ok(checkChallenge(undefined, phone, '012345', now).error);
+  assert.ok(checkChallenge(challenge(), phone, '012345', now + 300_000).error);
+});
+
+test('locks out after five wrong codes, including a subsequently correct code', () => {
+  let current = challenge();
+  for (let attempt = 1; attempt <= 5; attempt++) {
+    const result = checkChallenge(current, phone, '999999', now);
+    assert.ok(result.error);
+    current = result.challenge!;
+    assert.equal(current.attempts, attempt);
+  }
+  assert.ok(checkChallenge(current, phone, '012345', now).error);
+});
+
+test('rejects malformed codes and never coerces numbers or drops leading zeroes', () => {
+  for (const code of ['12345', '01234a', ' 012345', 12345, null]) {
+    assert.ok(checkChallenge(challenge(), phone, code, now).error);
+  }
+});
+
+test('resending a new code invalidates the old code', () => {
+  const replacement = { ...challenge(), hash: hashCode('654321') };
+  assert.ok(checkChallenge(replacement, phone, '012345', now).error);
+  assert.equal(checkChallenge(replacement, phone, '654321', now).error, null);
+});
+
+test('normalizes common international formatting and rejects local-only numbers', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), phone);
+  assert.equal(validPhone(normalizePhone('+44 20 7946 0123')), true);
+  for (const value of ['2025550123', '+0123456789', '+123', '+1234567890123456', '+12345678abc']) {
+    assert.equal(validPhone(value), false);
+  }
+});
+
+test('SMS ends with exactly the origin-bound hostname and intact code', () => {
+  assert.equal(smsMessage('news.example.com', '012345').split('\n').at(-1), '@news.example.com #012345');
+});
+
+test('SMS delivery fails closed without credentials and uses a server-side provider request', async () => {
+  const originalFetch = globalThis.fetch;
+  const keys = ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_FROM_NUMBER', 'SMS_OTP_HOST'];
+  const saved = keys.map(key => process.env[key]);
+  try {
+    keys.forEach(key => delete process.env[key]);
+    globalThis.fetch = async () => { throw new Error('must not contact provider'); };
+    await assert.rejects(sendCode(phone, '012345'), /SMS_NOT_CONFIGURED/);
+    process.env.TWILIO_ACCOUNT_SID = 'ACtest';
+    process.env.TWILIO_AUTH_TOKEN = 'test-token';
+    process.env.TWILIO_FROM_NUMBER = '+12025550999';
+    process.env.SMS_OTP_HOST = 'news.example.com';
+    globalThis.fetch = async (url, options) => {
+      assert.equal(url, 'https://api.twilio.com/2010-04-01/Accounts/ACtest/Messages.json');
+      const params = options?.body as URLSearchParams;
+      assert.equal(params.get('To'), phone);
+      assert.equal(params.get('Body')?.split('\n').at(-1), '@news.example.com #012345');
+      return new Response('{}', { status: 201 });
+    };
+    await sendCode(phone, '012345');
+    globalThis.fetch = async () => new Response('{}', { status: 400 });
+    await assert.rejects(sendCode(phone, '012345'), /SMS_SEND_FAILED/);
+  } finally {
+    globalThis.fetch = originalFetch;
+    keys.forEach((key, index) => {
+      if (saved[index] === undefined) delete process.env[key];
+      else process.env[key] = saved[index];
+    });
+  }
+});
