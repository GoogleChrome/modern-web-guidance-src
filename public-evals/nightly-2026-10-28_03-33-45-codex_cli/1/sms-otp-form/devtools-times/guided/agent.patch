diff --git a/src/lib/signup.ts b/src/lib/signup.ts
new file mode 100644
index 0000000..2f50438
--- /dev/null
+++ b/src/lib/signup.ts
@@ -0,0 +1,55 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LIFETIME = 5 * 60_000;
+export const RESEND_DELAY = 60_000;
+export const normalizePhone = (phone: string) => phone.replace(/[\s().-]/g, '');
+export const validPhone = (phone: string) => /^\+[1-9]\d{7,14}$/.test(phone);
+export const hashCode = (code: string) => createHash('sha256').update(code).digest('hex');
+export const newCode = () => randomInt(0, 1_000_000).toString().padStart(6, '0');
+export const matchesCode = (code: string, hash: string) =>
+  timingSafeEqual(Buffer.from(hashCode(code), 'hex'), Buffer.from(hash, 'hex'));
+
+export interface PhoneChallenge {
+  id: string;
+  phone: string;
+  hash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+// Returns the next challenge state so callers persist attempt counts even on failure.
+export function checkChallenge(challenge: PhoneChallenge | undefined, phone: string, code: unknown, now: number) {
+  if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now || challenge.attempts >= 5) {
+    return { error: 'Your code has expired or is unavailable. Request a new code.', challenge };
+  }
+  if (typeof code !== 'string' || !/^\d{6}$/.test(code)) {
+    return { error: 'Enter the 6-digit code from your text message.', challenge };
+  }
+  const next = { ...challenge, attempts: challenge.attempts + 1 };
+  if (!matchesCode(code, challenge.hash)) {
+    return { error: next.attempts >= 5 ? 'Too many incorrect attempts. Request a new code.' : 'That code is incorrect. Check your text message and try again.', challenge: next };
+  }
+  return { error: null, challenge: next };
+}
+
+export function smsMessage(host: string, code: string) {
+  return `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${host} #${code}`;
+}
+
+export async function sendCode(phone: string, code: string) {
+  const { TWILIO_ACCOUNT_SID: account, TWILIO_AUTH_TOKEN: token, TWILIO_FROM_NUMBER: from, SMS_OTP_HOST: host } = process.env;
+  if (!account || !token || !from || !host || !/^[a-z0-9.-]+$/i.test(host)) {
+    throw new Error('SMS_NOT_CONFIGURED');
+  }
+  const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(account)}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: phone, From: from, Body: smsMessage(host, code) }),
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw new Error('SMS_SEND_FAILED');
+}
diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..3f77c73
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,78 @@
+import type { APIRoute } from 'astro';
+import { randomUUID } from 'node:crypto';
+import { CODE_LIFETIME, RESEND_DELAY, checkChallenge, hashCode, newCode, normalizePhone, sendCode, validPhone, type PhoneChallenge } from '../../lib/signup';
+
+const reply = (data: object, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+// Serializes same-session mutations so concurrent submissions cannot reuse a code.
+const pending = new Set<string>();
+// Additional per-number protection within this server process, including new sessions.
+const sends = new Map<string, number>();
+// Retain consumed IDs through expiry to reject stale concurrent session snapshots.
+const consumed = new Map<string, number>();
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return reply({ error: 'Please submit this form from this website.' }, 403);
+  }
+  if (!session) return reply({ error: 'Sign-up is temporarily unavailable.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return reply({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object' || typeof body.phone !== 'string') {
+    return reply({ error: 'Enter a phone number including its country code.' }, 400);
+  }
+  const phone = normalizePhone(body.phone);
+  if (!validPhone(phone)) return reply({ error: 'Enter a valid phone number including + and its country code.' }, 400);
+  // Loading first initializes the ID for an existing cookie-backed session.
+  const challenge = await session.get('signupChallenge') as PhoneChallenge | undefined;
+  if (!session.sessionID) session.set('signupStarted', true);
+  const sessionId = session.sessionID;
+  if (!sessionId) return reply({ error: 'Sign-up is temporarily unavailable.' }, 503);
+  if (pending.has(sessionId)) return reply({ error: 'A request is already in progress. Please wait.' }, 429);
+  pending.add(sessionId);
+  try {
+    const now = Date.now();
+    for (const [id, expiresAt] of consumed) if (expiresAt <= now) consumed.delete(id);
+    if (body.action === 'send') {
+      for (const [key, time] of sends) if (now - time >= RESEND_DELAY) sends.delete(key);
+      const lastSent = Math.max(challenge?.sentAt ?? 0, sends.get(phone) ?? 0);
+      if (now - lastSent < RESEND_DELAY) {
+        return reply({ error: 'Please wait a minute before requesting another code.', retryAfter: Math.ceil((RESEND_DELAY - now + lastSent) / 1000) }, 429);
+      }
+      sends.set(phone, now);
+      const code = newCode();
+      // Replacing the challenge invalidates any previous number or code.
+      await session.set('signupChallenge', { id: randomUUID(), phone, hash: hashCode(code), expiresAt: now + CODE_LIFETIME, sentAt: now, attempts: 0 });
+      try { await sendCode(phone, code); } catch {
+        await session.delete('signupChallenge');
+        return reply({ error: 'We could not send a text. Please try again in a minute.', retryAfter: RESEND_DELAY / 1000 }, 503);
+      }
+      return reply({ phone, retryAfter: RESEND_DELAY / 1000 });
+    }
+    if (body.action !== 'register') return reply({ error: 'Invalid action.' }, 400);
+    if (typeof body.username !== 'string' || !body.username.trim() || body.username.length > 100 ||
+        typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 256 || !/\d/.test(body.password)) {
+      return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    }
+    if (challenge && consumed.has(challenge.id)) return reply({ error: 'This code has already been used. Request a new code.' }, 400);
+    const checked = checkChallenge(challenge, phone, body.code, now);
+    if (checked.challenge) session.set('signupChallenge', checked.challenge);
+    if (checked.error) return reply({ error: checked.error }, 400);
+    // Consume before calling registration, including on upstream failure.
+    consumed.set(challenge!.id, challenge!.expiresAt);
+    await session.delete('signupChallenge');
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) return reply({ error: 'Registration failed. Check your account details and request a new code.' }, 400);
+    return reply({ success: true });
+  } catch {
+    return reply({ error: 'Sign-up could not be completed. Please request a new code and try again.' }, 503);
+  } finally {
+    pending.delete(sessionId);
+  }
+};
