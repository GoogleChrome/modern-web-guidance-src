@@ -0,0 +1,165 @@
+/* Static preview adapter. Replace this adapter with same-origin POST endpoints
+   for SMS sending and verification before enabling real authentication.
+   Server must issue expiring, rate-limited, single-use challenges, validate the
+   code and establish the session. Never trust this preview's client-side result.
+   SMS final line: @<production hostname> #<six-digit code> (no scheme or port). */
+const smsService = {
+  async send(phone) { return { challengeId: crypto.randomUUID(), phone }; },
+  async verify(challengeId, code) { return Boolean(challengeId) && code === '123456'; }
+};
+const phoneForm = document.querySelector('#phone-form');
+const codeForm = document.querySelector('#code-form');
+const phoneInput = document.querySelector('#phone');
+const codeInput = document.querySelector('#otp');
+const status = document.querySelector('#form-status');
+const phoneError = document.querySelector('#phone-error');
+const codeError = document.querySelector('#code-error');
+const resendButton = document.querySelector('#resend-code');
+let challenge = null;
+let otpController = null;
+let cooldownTimer = null;
+let expiresAt = 0;
+let resendAt = 0;
+let attempts = 0;
+let busy = false;
+const intent = () => document.querySelector('input[name="intent"]:checked').value;
+function stopListening() { otpController?.abort(); otpController = null; }
+async function listenForSms() {
+  stopListening();
+  if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+  const controller = new AbortController();
+  otpController = controller;
+  const timeout = setTimeout(() => controller.abort(), 120000);
+  try {
+    const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+    if (!controller.signal.aborted && credential && !codeForm.hidden) {
+      codeInput.value = credential.code;
+      codeInput.setCustomValidity('');
+      codeInput.removeAttribute('aria-invalid');
+      codeError.textContent = '';
+      codeForm.requestSubmit();
+    }
+  } catch { /* Dismissal, timeout, or unsupported policy: manual entry stays available. */ }
+  finally { clearTimeout(timeout); if (otpController === controller) otpController = null; }
+}
+function updateIntent() {
+  const order = intent() === 'order';
+  codeForm.querySelector('button[type="submit"]').innerHTML = `${order ? 'Verify & start my order' : 'Verify & sign in'} <span aria-hidden="true">→</span>`;
+  document.querySelector('#continue-link').href = order ? '/order-online' : '/rewards';
+  document.querySelector('#continue-link').innerHTML = `${order ? 'Start my order' : 'Explore Rewards'} <span aria-hidden="true">→</span>`;
+  document.querySelector('#success-message').textContent = 'Demo complete! In the live site, your verified session would let you ' + (order ? 'order ahead and pick up your favorites.' : 'see your points, perks, and favorite orders.');
+}
+function setStep(code) {
+  phoneForm.hidden = code;
+  codeForm.hidden = !code;
+  document.querySelector('#success').hidden = true;
+  for (const [id, active] of [['phone-progress', !code], ['code-progress', code]]) {
+    const element = document.getElementById(id);
+    element.classList.toggle('current', active);
+    if (active) element.setAttribute('aria-current', 'step'); else element.removeAttribute('aria-current');
+  }
+}
+function startCooldown(restart = true) {
+  clearInterval(cooldownTimer);
+  if (restart) resendAt = Date.now() + 30000;
+  const update = () => {
+    const remaining = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
+    resendButton.disabled = remaining > 0;
+    resendButton.textContent = remaining ? `Resend in ${remaining}s` : 'Resend code';
+    if (!remaining) clearInterval(cooldownTimer);
+  };
+  update(); cooldownTimer = setInterval(update, 1000);
+}
+function normalizedPhone() {
+  const digits = phoneInput.value.replace(/\D/g, '');
+  return digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
+}
+async function sendCode() {
+  if (busy) return;
+  busy = true;
+  stopListening();
+  const button = phoneForm.querySelector('button[type="submit"]');
+  button.disabled = true; resendButton.disabled = true;
+  try {
+    challenge = await smsService.send('+1' + normalizedPhone());
+    expiresAt = Date.now() + 5 * 60000;
+    attempts = 0;
+    codeInput.value = ''; codeInput.setCustomValidity(''); codeInput.removeAttribute('aria-invalid'); codeError.textContent = '';
+    const number = normalizedPhone();
+    document.querySelector('#sent-to').textContent = `Code for +1 ••• ••• ${number.slice(-4)}`;
+    setStep(true); updateIntent(); startCooldown();
+    status.textContent = 'Demo code ready: 123456. It expires in 5 minutes. No SMS was sent.';
+    codeInput.focus();
+    listenForSms();
+  } catch {
+    status.textContent = 'We couldn’t request a code. Please try again.';
+    resendButton.disabled = false;
+  } finally { busy = false; button.disabled = false; }
+}
+phoneInput.addEventListener('input', () => { phoneInput.setCustomValidity(''); phoneInput.removeAttribute('aria-invalid'); phoneError.textContent = ''; });
+phoneInput.addEventListener('invalid', () => { phoneError.textContent = 'Enter a valid 10-digit US mobile number.'; phoneInput.setAttribute('aria-invalid', 'true'); });
+phoneForm.addEventListener('submit', event => {
+  event.preventDefault();
+  if (!/^[2-9][0-9]{2}[2-9][0-9]{6}$/.test(normalizedPhone())) {
+    phoneInput.setCustomValidity('Enter a valid 10-digit US mobile number.');
+    phoneError.textContent = phoneInput.validationMessage;
+    phoneInput.setAttribute('aria-invalid', 'true'); phoneInput.reportValidity(); return;
+  }
+  sendCode();
+});
+codeInput.addEventListener('input', () => { codeInput.setCustomValidity(''); codeInput.removeAttribute('aria-invalid'); codeError.textContent = ''; });
+codeInput.addEventListener('invalid', () => { codeError.textContent = 'Enter the complete 6-digit code.'; codeInput.setAttribute('aria-invalid', 'true'); });
+codeInput.addEventListener('paste', event => {
+  const text = event.clipboardData?.getData('text').trim();
+  if (text && /^[0-9\s-]+$/.test(text) && text.replace(/\D/g, '').length === 6) {
+    event.preventDefault(); codeInput.value = text.replace(/\D/g, ''); codeInput.dispatchEvent(new Event('input'));
+  }
+});
+codeForm.addEventListener('submit', async event => {
+  event.preventDefault(); stopListening();
+  if (busy) return;
+  const button = codeForm.querySelector('button[type="submit"]');
+  if (Date.now() > expiresAt || attempts >= 5) {
+    codeError.textContent = attempts >= 5 ? 'Too many attempts. Request a new code below.' : 'This code has expired. Request a new code below.';
+    codeInput.setAttribute('aria-invalid', 'true'); codeInput.focus(); return;
+  }
+  busy = true; button.disabled = true;
+  try {
+    const verified = await smsService.verify(challenge?.challengeId, codeInput.value);
+    attempts++;
+    if (!verified) {
+      codeError.textContent = 'That code doesn’t match. For this demo, enter 123456.';
+      codeInput.setAttribute('aria-invalid', 'true'); codeInput.focus(); codeInput.select(); return;
+    }
+    challenge = null; expiresAt = 0; clearInterval(cooldownTimer);
+    codeInput.value = ''; codeForm.hidden = true;
+    document.querySelector('#success').hidden = false;
+    updateIntent();
+    status.textContent = 'Demo verification complete. No account has been signed in.';
+    document.querySelector('#continue-link').focus();
+  } catch { codeError.textContent = 'Verification is unavailable. Please try again.'; }
+  finally { busy = false; button.disabled = false; }
+});
+function reset() {
+  if (busy) return;
+  stopListening(); clearInterval(cooldownTimer); challenge = null; expiresAt = 0;
+  setStep(false); status.textContent = ''; codeInput.value = ''; phoneInput.focus();
+}
+document.querySelector('#change-phone').addEventListener('click', reset);
+document.querySelector('#start-over').addEventListener('click', reset);
+resendButton.addEventListener('click', () => { if (Date.now() >= resendAt) sendCode(); });
+document.querySelectorAll('input[name="intent"]').forEach(radio => radio.addEventListener('change', updateIntent));
+document.querySelectorAll('[data-intent]').forEach(link => link.addEventListener('click', () => {
+  document.querySelector(`input[name="intent"][value="${link.dataset.intent}"]`).checked = true;
+  updateIntent();
+  if (!phoneForm.hidden) phoneInput.focus({ preventScroll: true });
+  else if (!codeForm.hidden) codeInput.focus({ preventScroll: true });
+}));
+window.addEventListener('pagehide', () => { stopListening(); clearInterval(cooldownTimer); });
+window.addEventListener('pageshow', event => {
+  if (event.persisted && !codeForm.hidden) {
+    if (Date.now() < resendAt) startCooldown(false); else { resendButton.disabled = false; resendButton.textContent = 'Resend code'; }
+    listenForSms();
+  }
+});
+updateIntent();
