+<script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = Array.from(list.querySelectorAll('[role="option"]'));
+    const value = document.getElementById('roast-value');
+    const input = document.getElementById('roast-input');
+
+    function closeRoasts(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    trigger.addEventListener('click', () => {
+      if (list.hidden) openRoasts();
+      else closeRoasts();
+    });
+
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach(option => {
+      option.addEventListener('click', () => {
+        options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+        value.textContent = option.firstChild.textContent;
+        input.value = option.dataset.value;
+        input.dispatchEvent(new Event('change', { bubbles: true }));
+        closeRoasts(true);
+      });
+    });
+
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let nextIndex;
+      if (event.key === 'ArrowDown') nextIndex = (index + 1) % options.length;
+      if (event.key === 'ArrowUp') nextIndex = (index - 1 + options.length) % options.length;
+      if (event.key === 'Home') nextIndex = 0;
+      if (event.key === 'End') nextIndex = options.length - 1;
+      if (nextIndex !== undefined) {
+        event.preventDefault();
+        options[nextIndex].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        options[index].click();
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      } else if (event.key.length === 1) {
+        const match = options.find(option => option.dataset.value.startsWith(event.key.toLowerCase()));
+        if (match) {
+          event.preventDefault();
+          match.focus();
+        }
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
