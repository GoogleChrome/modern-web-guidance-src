+  <script>
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.querySelector('#coffee-roast');
+      const fallback = document.querySelector('.roast-fallback');
+      const summary = fallback.querySelector('summary');
+      const value = document.querySelector('#roast-value');
+      const label = document.querySelector('#roast-label');
+      select.hidden = true;
+      fallback.hidden = false;
+      label.removeAttribute('for');
+      label.addEventListener('click', () => summary.focus());
+
+      fallback.addEventListener('change', (event) => {
+        select.value = event.target.value;
+        value.textContent = select.selectedOptions[0].textContent;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        fallback.open = false;
+        summary.focus();
+      });
+
+      fallback.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          fallback.open = false;
+          summary.focus();
+        }
+      });
+
+      document.addEventListener('click', (event) => {
+        if (!fallback.contains(event.target)) fallback.open = false;
+      });
+
+      fallback.addEventListener('focusout', (event) => {
+        if (!fallback.contains(event.relatedTarget)) fallback.open = false;
+      });
+    }
+  </script>
