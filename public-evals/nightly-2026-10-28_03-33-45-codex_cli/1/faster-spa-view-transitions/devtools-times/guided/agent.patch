diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..91c438d
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,59 @@
+// Astro still owns fetching, history, scrolling, head updates and script execution.
+// Its persistent main container keeps these views mounted across document swaps.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const initialView = document.querySelector<HTMLElement>("[data-view-key]");
+if (initialView?.dataset.viewKey) {
+  views.set(initialView.dataset.viewKey, initialView);
+}
+
+document.addEventListener("astro:before-swap", (event) => {
+  const incoming = event.newDocument.querySelector<HTMLElement>("[data-view-key]");
+  const host = document.querySelector<HTMLElement>("[data-view-cache]");
+  const key = incoming?.dataset.viewKey;
+  // Pages outside the shared layout keep Astro's normal navigation behavior.
+  if (!host || !incoming || !key) return;
+
+  const swap = event.swap;
+  event.swap = () => {
+    // Do not change cached nodes during preparation: navigation can be aborted.
+    swap();
+
+    // Authentication views are fresh on every visit and discarded on departure.
+    const active = incoming.dataset.cacheView === "false"
+      ? incoming
+      : views.get(key) ?? incoming;
+
+    for (const [oldKey, view] of views) {
+      if (view !== active && view.dataset.cacheView === "false") {
+        view.remove();
+        views.delete(oldKey);
+      } else if (view !== active) {
+        view.classList.add("inactive");
+        view.inert = true;
+        view.setAttribute("aria-hidden", "true");
+      }
+    }
+
+    if (active.parentElement !== host) host.append(active);
+    active.classList.remove("inactive");
+    active.inert = false;
+    active.removeAttribute("aria-hidden");
+
+    // Map insertion order tracks least-recently-used views, including the active one.
+    views.delete(key);
+    views.set(key, active);
+    while (views.size > MAX_VIEWS) {
+      const oldestKey = views.keys().next().value!;
+      views.get(oldestKey)!.remove();
+      views.delete(oldestKey);
+    }
+  };
+});
+
+document.addEventListener("astro:after-swap", () => {
+  // Prevent focus from staying inside an inactive view. Astro handles scroll
+  // restoration and fragment navigation independently of this focus change.
+  document.querySelector<HTMLElement>(".spa-view:not(.inactive)")
+    ?.focus({ preventScroll: true });
+});
