+
+/* Keep the actual nodes and rendering state of recently visited views. */
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
