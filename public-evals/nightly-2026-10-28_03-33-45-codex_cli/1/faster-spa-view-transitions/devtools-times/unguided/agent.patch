diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..3890770
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,83 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Includes the active view. Evict the least recently visited view first.
+export const MAX_CACHED_VIEWS = 5;
+const installed = new WeakSet<Document>();
+
+export function installViewCache(doc: Document) {
+  if (installed.has(doc)) return;
+  installed.add(doc);
+
+  // Map insertion order records visits without moving existing live nodes.
+  const views = new Map<string, HTMLElement>();
+  const submissions = new WeakSet<AbortSignal>();
+
+  doc.addEventListener("astro:before-preparation", (event) => {
+    if (event.formData) submissions.add(event.signal);
+  });
+
+  doc.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
+    const host = doc.querySelector<HTMLElement>("[data-view-cache]");
+    const incoming = event.newDocument.querySelector<HTMLElement>(
+      "[data-view-cache] > [data-view-key]",
+    );
+    // Let Astro handle destinations that do not use the shared layout.
+    if (!host || !incoming) {
+      views.clear();
+      return;
+    }
+
+    const swap = event.swap;
+    event.swap = () => {
+      const active = host.querySelector<HTMLElement>("[data-view-key]:not([hidden])");
+      const key = incoming.dataset.viewKey!;
+
+      if (active && active.dataset.cacheView !== "false") {
+        views.set(active.dataset.viewKey!, active);
+      }
+
+      // A form response or explicit navigation to the current URL must show
+      // the fresh response rather than an older version of the same view.
+      const refresh = submissions.has(event.signal) || active?.dataset.viewKey === key;
+      if (submissions.has(event.signal)) {
+        for (const view of views.values()) {
+          if (view !== active) view.remove();
+        }
+        views.clear();
+      }
+
+      const next = !refresh && incoming.dataset.cacheView !== "false"
+        ? views.get(key) ?? incoming
+        : incoming;
+
+      if (active && active !== next) {
+        if (active.dataset.cacheView === "false" || refresh) {
+          active.remove();
+        } else {
+          active.hidden = true;
+          active.setAttribute("inert", "");
+          active.setAttribute("aria-hidden", "true");
+        }
+      }
+
+      // The persistent host keeps hydrated islands connected during Astro's
+      // body swap; revisits reuse the actual nodes, including their listeners.
+      if (next.parentElement !== host) host.append(next);
+      next.hidden = false;
+      next.removeAttribute("inert");
+      next.removeAttribute("aria-hidden");
+      views.delete(key);
+      if (next.dataset.cacheView !== "false") views.set(key, next);
+
+      while (host.children.length > MAX_CACHED_VIEWS) {
+        const oldest = views.keys().next().value;
+        if (oldest === undefined) break;
+        views.get(oldest)!.remove();
+        views.delete(oldest);
+      }
+
+      // Keep Astro's head, history, focus, scroll, and script handling.
+      swap();
+    };
+  });
+}
diff --git a/tests/view-cache.test.ts b/tests/view-cache.test.ts
new file mode 100644
index 0000000..d3de1c0
--- /dev/null
+++ b/tests/view-cache.test.ts
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { parseHTML } from "linkedom";
+import { installViewCache, MAX_CACHED_VIEWS } from "../src/scripts/view-cache.ts";
+
+function page(key: string, cache = true) {
+  return parseHTML(`<!doctype html><html><head><title>${key}</title></head><body>
+    <div data-view-cache data-astro-transition-persist="page-views">
+      <main data-view-key="${key}" data-cache-view="${cache}">
+        <input value="initial"><button>Click</button>
+      </main>
+    </div>
+  </body></html>`).document;
+}
+
+function setup() {
+  const doc = page("/home");
+  installViewCache(doc as unknown as Document);
+  const navigate = (key: string, { cache = true, submit = false } = {}) => {
+    const incoming = page(key, cache);
+    const signal = new AbortController().signal;
+    if (submit) {
+      const preparation = new doc.defaultView.Event("astro:before-preparation");
+      Object.assign(preparation, { signal, formData: new FormData() });
+      doc.dispatchEvent(preparation);
+    }
+    const event = new doc.defaultView.Event("astro:before-swap");
+    let swaps = 0;
+    Object.assign(event, {
+      signal,
+      newDocument: incoming,
+      swap: () => {
+        // Model Astro's transfer of a transition:persist element into the
+        // incoming body. The router still owns the rest of the document.
+        const host = doc.querySelector("[data-view-cache]")!;
+        incoming.querySelector("[data-view-cache]")!.replaceWith(host);
+        doc.body.replaceWith(incoming.body);
+        doc.title = incoming.title;
+        swaps++;
+      },
+    });
+    doc.dispatchEvent(event);
+    assert.equal(swaps, 0, "cache changes wait for the actual swap");
+    (event as unknown as { swap(): void }).swap();
+    assert.equal(swaps, 1, "Astro's swap still runs exactly once");
+    const visible = doc.querySelectorAll("main:not([hidden])");
+    assert.equal(visible.length, 1);
+    assert.equal(visible[0].getAttribute("data-view-key"), key);
+    assert.equal(doc.title, key);
+    return visible[0];
+  };
+  return { doc, navigate };
+}
+
+test("revisits preserve node identity, input values, and event listeners", () => {
+  const { doc, navigate } = setup();
+  const home = doc.querySelector("main")!;
+  const input = home.querySelector("input")!;
+  const button = home.querySelector("button")!;
+  input.value = "kept";
+  let clicks = 0;
+  button.addEventListener("click", () => clicks++);
+
+  navigate("/article");
+  assert.equal(home.hasAttribute("hidden"), true);
+  assert.equal(home.hasAttribute("inert"), true);
+  assert.equal(home.getAttribute("aria-hidden"), "true");
+  assert.equal(home.isConnected, true);
+
+  assert.equal(navigate("/home"), home);
+  assert.equal(home.querySelector("input"), input);
+  assert.equal(input.value, "kept");
+  assert.equal(home.hasAttribute("inert"), false);
+  assert.equal(home.hasAttribute("aria-hidden"), false);
+  button.dispatchEvent(new doc.defaultView.Event("click"));
+  assert.equal(clicks, 1);
+});
+
+test("the cache is bounded and evicts the least recently visited view", () => {
+  const { doc, navigate } = setup();
+  const home = doc.querySelector("main");
+  const first = navigate("/1");
+  for (let index = 2; index < MAX_CACHED_VIEWS; index++) navigate(`/${index}`);
+  navigate("/home");
+  navigate("/new");
+  assert.equal(doc.querySelectorAll("main").length, MAX_CACHED_VIEWS);
+  assert.equal(home!.isConnected, true);
+  assert.equal(first.isConnected, false);
+  assert.notEqual(navigate("/1"), first);
+});
+
+test("query strings distinguish cached views", () => {
+  const { navigate } = setup();
+  const first = navigate("/search?q=one");
+  const second = navigate("/search?q=two");
+  assert.notEqual(second, first);
+  assert.equal(navigate("/search?q=one"), first);
+});
+
+test("same-URL navigation refreshes the view", () => {
+  const { doc, navigate } = setup();
+  const home = doc.querySelector("main")!;
+  assert.notEqual(navigate("/home"), home);
+  assert.equal(home.isConnected, false);
+  assert.equal(doc.querySelectorAll("main").length, 1);
+});
+
+test("opted-out forms are removed on departure and recreated on return", () => {
+  const { navigate } = setup();
+  const form = navigate("/signin", { cache: false });
+  navigate("/article");
+  assert.equal(form.isConnected, false);
+  assert.notEqual(navigate("/signin", { cache: false }), form);
+});
+
+test("form responses invalidate saved views", () => {
+  const { doc, navigate } = setup();
+  const home = doc.querySelector("main")!;
+  const article = navigate("/article");
+  assert.notEqual(navigate("/home", { submit: true }), home);
+  assert.equal(home.isConnected, false);
+  assert.equal(article.isConnected, false);
+  assert.equal(doc.querySelectorAll("main").length, 1);
+});
+
+test("installing twice does not wrap the swap twice", () => {
+  const { doc, navigate } = setup();
+  installViewCache(doc as unknown as Document);
+  navigate("/article");
+  assert.equal(doc.querySelectorAll("main").length, 2);
+});
