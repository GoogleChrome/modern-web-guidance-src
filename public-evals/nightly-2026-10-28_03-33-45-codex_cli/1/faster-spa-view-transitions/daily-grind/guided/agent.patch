+(() => {
+  'use strict';
+
+  const titles = new Map([
+    ['home', 'Artisanal Coffee'],
+    ['menu', 'Menu'],
+    ['locations', 'Locations'],
+    ['rewards', 'Rewards'],
+    ['account', 'My Account'],
+  ]);
+  const host = document.getElementById('view-host');
+  // The cache is bounded to the five known views. Never detach a visited view.
+  const views = new Map([
+    ['home', { element: document.getElementById('view-home'), scroll: 0 }],
+  ]);
+  const navLinks = document.querySelectorAll('nav a[href^="#/"]');
+  let activeRoute;
+
+  function routeFromHash(hash) {
+    const route = hash.replace(/^#\/?/, '') || 'home';
+    return titles.has(route) ? route : 'home';
+  }
+
+  function initializeView(route, element) {
+    if (route === 'menu') {
+      element.querySelector('#menu-filter').addEventListener('change', (event) => {
+        element.querySelectorAll('[data-category]').forEach((card) => {
+          card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+        });
+      });
+    }
+    if (route === 'locations') {
+      element.querySelector('#location-search').addEventListener('input', (event) => {
+        const query = event.target.value.trim().toLowerCase();
+        let count = 0;
+        element.querySelectorAll('[data-location]').forEach((card) => {
+          card.hidden = !card.dataset.location.includes(query);
+          if (!card.hidden) count += 1;
+        });
+        element.querySelector('#location-status').textContent = count === 0 ? 'No locations match your search.' : '';
+      });
+    }
+    if (route === 'account') {
+      element.querySelector('#preferences-form').addEventListener('submit', (event) => {
+        event.preventDefault();
+        element.querySelector('#preferences-status').textContent = 'Preferences kept for this visit. Reloading the page will reset them.';
+      });
+    }
+  }
+
+  function getView(route) {
+    if (!views.has(route)) {
+      const element = document.createElement('div');
+      element.id = `view-${route}`;
+      element.className = 'spa-view inactive';
+      element.tabIndex = -1;
+      element.inert = true;
+      element.setAttribute('aria-hidden', 'true');
+      element.setAttribute('aria-labelledby', `${route}-heading`);
+      element.append(document.getElementById(`template-${route}`).content.cloneNode(true));
+      host.append(element);
+      initializeView(route, element);
+      views.set(route, { element, scroll: 0 });
+    }
+    return views.get(route);
+  }
+
+  function showRoute({ moveFocus = true } = {}) {
+    const route = routeFromHash(window.location.hash);
+    if (route === activeRoute) return;
+    if (activeRoute) {
+      const previous = views.get(activeRoute);
+      previous.scroll = window.scrollY;
+      previous.element.classList.add('inactive');
+      previous.element.inert = true;
+      previous.element.setAttribute('aria-hidden', 'true');
+    }
+
+    const current = getView(route);
+    current.element.classList.remove('inactive');
+    current.element.inert = false;
+    current.element.removeAttribute('aria-hidden');
+    activeRoute = route;
+    document.title = `The Daily Grind | ${titles.get(route)}`;
+    navLinks.forEach((link) => {
+      if (routeFromHash(link.hash) === route) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    if (moveFocus) current.element.focus({ preventScroll: true });
+    window.scrollTo({ top: current.scroll, left: 0, behavior: 'instant' });
+  }
+
+  // Preserve native modified clicks and external links. Hash URLs also work on
+  // static hosting and can be bookmarked without requiring server rewrites.
+  document.addEventListener('click', (event) => {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target.closest('a[href]');
+    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+    const url = new URL(link.href, window.location.href);
+    if (url.origin !== window.location.origin || url.pathname !== window.location.pathname || url.search !== window.location.search) return;
+    if (!/^#\/(menu|locations|rewards|account)?$/.test(url.hash)) return;
+    event.preventDefault();
+    if (url.hash === window.location.hash) return;
+    window.history.pushState(null, '', url.hash);
+    showRoute();
+  });
+
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  window.addEventListener('popstate', () => showRoute());
+  window.addEventListener('hashchange', () => showRoute());
+  showRoute({ moveFocus: false });
+})();
