+(() => {
+  const container = document.getElementById('views');
+  const home = document.getElementById('view-home');
+  home.hidden = true;
+  const views = new Map([['home', home]]);
+  const scrollPositions = new Map();
+  const titles = {
+    home: 'Artisanal Coffee',
+    menu: 'Menu',
+    locations: 'Locations',
+    rewards: 'Rewards',
+    account: 'My Account',
+  };
+  let activeRoute = null;
+
+  function initializeView(route, view) {
+    if (route === 'menu') {
+      view.querySelector('#menu-filter').addEventListener('change', (event) => {
+        const category = event.target.value;
+        view.querySelectorAll('[data-category]').forEach((card) => {
+          card.hidden = category !== 'all' && card.dataset.category !== category;
+        });
+      });
+    }
+    if (route === 'account') {
+      view.querySelector('#account-form').addEventListener('submit', (event) => {
+        event.preventDefault();
+        view.querySelector('#account-status').textContent = 'Preferences saved for this visit.';
+      });
+    }
+  }
+
+  function showView() {
+    const requestedRoute = window.location.hash.replace(/^#\/?/, '') || 'home';
+    const route = Object.hasOwn(titles, requestedRoute) ? requestedRoute : 'home';
+    if (route === activeRoute) return;
+
+    if (activeRoute !== null) {
+      scrollPositions.set(activeRoute, window.scrollY);
+      views.get(activeRoute).hidden = true;
+    }
+
+    // Clone and wire up each view once; keep its live DOM for future visits.
+    if (!views.has(route)) {
+      const template = document.getElementById(`template-${route}`);
+      const view = template.content.firstElementChild.cloneNode(true);
+      view.hidden = true;
+      container.appendChild(view);
+      initializeView(route, view);
+      views.set(route, view);
+    }
+
+    const view = views.get(route);
+    view.hidden = false;
+    const isNavigation = activeRoute !== null;
+    activeRoute = route;
+    document.title = `The Daily Grind | ${titles[route]}`;
+    document.querySelectorAll('nav a').forEach((link) => {
+      const isCurrent = link.getAttribute('href') === (route === 'home' ? '#/' : `#/${route}`);
+      if (isCurrent) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    if (isNavigation) {
+      const heading = view.querySelector('h1');
+      heading.setAttribute('tabindex', '-1');
+      heading.focus({ preventScroll: true });
+    }
+    window.scrollTo(0, scrollPositions.get(route) || 0);
+  }
+
+  // Hash routes also work on static hosts and support browser Back/Forward.
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', showView);
+  showView();
+})();
