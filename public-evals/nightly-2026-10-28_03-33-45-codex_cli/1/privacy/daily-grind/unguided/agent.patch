@@ -0,0 +1,8 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+
+// Publish only the public files, never the repository or internal audit notes.
+await rm(new URL('../dist/', import.meta.url), { recursive: true, force: true });
+await mkdir(new URL('../dist/', import.meta.url), { recursive: true });
+for (const path of ['index.html', 'privacy-policy.html', 'assets', '_headers']) {
+  await cp(new URL(`../${path}`, import.meta.url), new URL(`../dist/${path}`, import.meta.url), { recursive: true });
+}
diff --git a/scripts/serve.mjs b/scripts/serve.mjs
new file mode 100644
index 0000000..27da400
--- /dev/null
+++ b/scripts/serve.mjs
@@ -0,0 +1,46 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+
+const root = new URL('../dist/', import.meta.url);
+const headerFile = await readFile(new URL('_headers', root), 'utf8');
+const headers = Object.fromEntries(headerFile.split('\n').filter(line => line.startsWith('  ')).map(line => {
+  const colon = line.indexOf(':');
+  return [line.slice(0, colon).trim(), line.slice(colon + 1).trim()];
+}));
+// An explicit public-file map prevents serving source files or arbitrary paths.
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy.html', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+const server = createServer(async (request, response) => {
+  for (const [name, value] of Object.entries(headers)) response.setHeader(name, value);
+  response.setHeader('Content-Type', 'text/plain; charset=utf-8');
+  if (!['GET', 'HEAD'].includes(request.method)) {
+    response.writeHead(405, { Allow: 'GET, HEAD' });
+    response.end('Method not allowed');
+    return;
+  }
+  // Query strings are never logged, reflected, stored, or used to select files.
+  const route = routes.get((request.url ?? '').split('?')[0]);
+  if (!route) {
+    response.writeHead(404);
+    response.end(request.method === 'HEAD' ? undefined : 'Page not found');
+    return;
+  }
+  try {
+    const body = await readFile(new URL(route[0], root));
+    response.writeHead(200, { 'Content-Type': route[1], 'Content-Length': body.length });
+    response.end(request.method === 'HEAD' ? undefined : body);
+  } catch {
+    response.writeHead(500);
+    response.end(request.method === 'HEAD' ? undefined : 'Page unavailable');
+  }
+});
+server.requestTimeout = 15_000;
+server.headersTimeout = 10_000;
+server.listen(Number(process.env.PORT ?? 11222), process.env.HOST ?? '0.0.0.0');
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..9a8747f
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,49 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import test from 'node:test';
+
+const read = path => readFile(new URL(`../${path}`, import.meta.url), 'utf8');
+const pages = ['index.html', 'privacy-policy.html'];
+const policy = await read('_headers');
+const csp = policy.match(/Content-Security-Policy: (.+)/)[1];
+
+test('pages use restrictive CSP, no referrers, and no data collection elements', async () => {
+  for (const page of pages) {
+    const html = await read(page);
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    const fallback = html.match(/http-equiv="Content-Security-Policy" content="([^"]+)"/)[1];
+    assert.equal(fallback, csp.replace("; frame-ancestors 'none'", ''));
+    assert.doesNotMatch(html, /<(?:script|form|input|textarea|select|iframe|object|embed)\b/i);
+    assert.doesNotMatch(html, /\s(?:style|on\w+)\s*=/i);
+    for (const [, value] of html.matchAll(/(?:src|href|action)="([^"]+)"/g)) {
+      assert.match(value, /^\/(?!\/)/, `Unexpected external resource: ${value}`);
+      assert.ok(!value.includes('?'), 'Navigation must not carry query data');
+    }
+  }
+});
+
+test('styles request only local assets', async () => {
+  const css = await read('assets/styles.css');
+  assert.doesNotMatch(css, /@import|https?:|\/\//i);
+  assert.match(css, /url\('\.\/coffee\.jpg'\)/);
+  const photo = await readFile(new URL('../assets/coffee.jpg', import.meta.url));
+  assert.equal(photo.subarray(0, 3).toString('hex'), 'ffd8ff');
+});
+
+test('response policy blocks active content, tracking connections, and framing', () => {
+  for (const directive of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "base-uri 'none'", "form-action 'none'", "frame-ancestors 'none'"]) {
+    assert.ok(csp.split('; ').includes(directive), directive);
+  }
+  for (const header of ['Referrer-Policy: no-referrer', 'X-Content-Type-Options: nosniff', 'X-Frame-Options: DENY', 'Strict-Transport-Security: max-age=31536000', 'Cache-Control: no-store', 'Permissions-Policy:']) {
+    assert.ok(policy.includes(header), header);
+  }
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|https?:|\*/);
+});
+
+test('build publishes only intended public files', async () => {
+  await import('../scripts/build.mjs');
+  const files = await readdir(new URL('../dist/', import.meta.url), { recursive: true });
+  assert.deepEqual(files.sort(), ['_headers', 'assets', 'assets/coffee.jpg', 'assets/styles.css', ...pages].sort());
+  assert.equal(await read('dist/_headers'), policy);
+  for (const page of pages) assert.equal(await read(`dist/${page}`), await read(page));
+});
