+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { auditMarkup, auditSite, auditStyles, documentPolicy } from './privacy-audit.mjs';
+
+const page = `<head><meta name="referrer" content="no-referrer"><meta http-equiv="Content-Security-Policy" content="${documentPolicy}"></head><body><a href="/">Home</a></body>`;
+
+test('reviewed website passes source and header audit', async () => {
+  await auditSite(new URL('../', import.meta.url));
+});
+
+test('blocks newly introduced tracking, execution, and collection', () => {
+  for (const addition of [
+    '<script src="/tracking.js"></script>',
+    '<img src="https://tracker.example/pixel">',
+    '<img src="//tracker.example/pixel">',
+    '<iframe src="/embed"></iframe>',
+    '<a href="/" ping="/track">Home</a>',
+    '<a onclick="collect()">Home</a>',
+    '<form action="/collect"></form>',
+    '<meta http-equiv="refresh" content="0;url=/track">',
+    '<link rel="prefetch" href="/track">',
+  ]) assert.throws(() => auditMarkup(page + addition), addition);
+});
+
+test('requires privacy fallbacks and rejects unreviewed CSS requests', () => {
+  auditMarkup(page);
+  assert.throws(() => auditMarkup(page.replace('name="referrer"', 'name="other"')));
+  auditStyles('.hero { background-image: url("/assets/coffee-hero.jpg"); }');
+  for (const css of ['@import "/tracker.css";', 'a { background: url(//tracker.example/pixel); }', 'a { background: url(https://tracker.example/pixel); }']) {
+    assert.throws(() => auditStyles(css));
+  }
+});
