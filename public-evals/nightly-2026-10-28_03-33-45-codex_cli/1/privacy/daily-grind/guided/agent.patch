+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/">Back to home</a>
+  </nav>
+  <main class="container policy">
+    <h1>Your privacy at The Daily Grind</h1>
+    <p>Last updated: October 28, 2026</p>
+    <section aria-labelledby="browsing">
+      <h2 id="browsing">Browse without tracking</h2>
+      <p>These informational pages use no analytics, advertising trackers, fingerprinting, tracking cookies, or third-party embeds. Images and styles are served from this website. We run no client-side JavaScript and save no personal information in your browser's local storage.</p>
+    </section>
+    <section aria-labelledby="delivery">
+      <h2 id="delivery">What it takes to deliver a page</h2>
+      <p>Your browser sends technical information, including your IP address and the requested URL, to the hosting provider so it can deliver and protect the website. Hosting access logs and their retention depend on the provider's configuration. This website does not add a separate visitor database or analytics service.</p>
+      <p>Our pages ask your browser not to send a referrer when following links. Please avoid including personal information or secrets in website URLs.</p>
+    </section>
+    <section aria-labelledby="services">
+      <h2 id="services">Accounts and orders</h2>
+      <p>This version of the website provides informational pages only. The menu, account, rewards, ordering, contact, and logout links are placeholders; they do not submit information or create an account. No payment or account information is collected by these pages.</p>
+      <p>If these services are introduced, their data needs, retention, and ways to access, correct, or delete information must be explained before you provide it. Optional marketing must be a separate choice.</p>
+    </section>
+  </main>
+  <footer>
+    <p><a href="/">The Daily Grind</a> &middot; Coffee without the tracking.</p>
+  </footer>
+</body>
+</html>
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..a83afea
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,14 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import { auditSite } from './privacy-audit.mjs';
+
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+await auditSite(root);
+await rm(output, { recursive: true, force: true });
+await mkdir(output);
+// Publish only reviewed website assets, never the repository or tooling.
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(new URL(path, root), new URL(path, output), { recursive: true });
+}
+await auditSite(output);
+console.log('Built and privacy-audited static website in dist/.');
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..4631cf7
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, access } from 'node:fs/promises';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+export const documentPolicy = "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'";
+
+// Conservative source guardrails for this script-free site, not an HTML sanitizer.
+// CSP remains the browser enforcement layer. New capabilities require review.
+export function auditMarkup(html) {
+  assert(!/<\s*(script|style|iframe|object|embed|base|form|input|textarea|select|svg)\b/i.test(html), 'Unreviewed executable content, embed, or data collection');
+  assert(!/\s(?:on[\w-]+|style|ping|srcdoc)\s*=/i.test(html), 'Inline handlers, styles, or tracking attributes');
+  assert(!/(?:\b(?:https?:|javascript:|data:)|\/\/)/i.test(html), 'Unreviewed external URL or active URL scheme');
+  assert(!/<meta\b[^>]*http-equiv\s*=\s*["']?refresh/i.test(html), 'Unreviewed navigation');
+  assert(!/\brel\s*=\s*["'][^"']*(?:preconnect|dns-prefetch|prefetch|prerender|modulepreload)/i.test(html), 'Unreviewed speculative requests');
+  assert(html.includes(`<meta http-equiv="Content-Security-Policy" content="${documentPolicy}">`), 'Missing or divergent CSP fallback');
+  assert(html.includes('<meta name="referrer" content="no-referrer">'), 'Missing no-referrer fallback');
+}
+
+export function auditStyles(css) {
+  assert(!/@import|https?:|\/\/|\\/i.test(css), 'Unreviewed CSS import, external URL, or escaped URL');
+}
+
+export async function auditSite(root) {
+  const files = [];
+  async function walk(directory) {
+    for (const item of await readdir(new URL(directory, root), { withFileTypes: true })) {
+      assert(!item.isSymbolicLink(), 'Symlink in published content');
+      const path = directory + item.name;
+      if (item.isDirectory()) await walk(path + '/');
+      else files.push(path);
+    }
+  }
+  // These are the only directories the build publishes.
+  await walk('assets/');
+  await walk('privacy-policy/');
+  files.push('index.html');
+  assert.deepEqual(files.sort(), ['assets/coffee-hero.jpg', 'assets/styles.css', 'index.html', 'privacy-policy/index.html'], 'Review new runtime assets before publishing');
+  for (const path of files) {
+    if (!path.endsWith('.html') && !path.endsWith('.css')) continue;
+    const source = await readFile(new URL(path, root), 'utf8');
+    if (path.endsWith('.html')) auditMarkup(source);
+    else auditStyles(source);
+    // Verify every referenced resource exists; navigation placeholders are exempt.
+    const references = path.endsWith('.css')
+      ? [...source.matchAll(/url\(\s*['"]?([^'"\s)]+)/g)].map(match => match[1])
+      : [...source.matchAll(/<link\b[^>]*href="([^"]+)"/g)].map(match => match[1]);
+    for (const resource of references) {
+      assert(resource.startsWith('/assets/'), 'Resources must be reviewed same-origin assets');
+      assert(!resource.includes('..'), 'Resource must stay within assets');
+      await access(new URL(resource.slice(1), root));
+    }
+  }
+  const headers = await readFile(new URL('_headers', root), 'utf8');
+  assert(headers.startsWith('/*\n'), 'Headers must apply to all paths');
+  for (const header of [
+    `Content-Security-Policy: ${documentPolicy}; frame-ancestors 'none'`,
+    'Referrer-Policy: no-referrer',
+    'X-Content-Type-Options: nosniff',
+    'X-Frame-Options: DENY',
+    'Cross-Origin-Opener-Policy: same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy: same-origin',
+    'Strict-Transport-Security: max-age=300',
+    'Cache-Control: no-store',
+  ]) assert(headers.split('\n').includes(`  ${header}`), `Missing header: ${header}`);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics', 'attribution-reporting']) {
+    assert(headers.includes(`${feature}=()`), `Missing permission restriction: ${feature}`);
+  }
+  assert(!/Reporting-Endpoints:|report-uri|report-to|Set-Cookie:/i.test(headers), 'Review telemetry or cookie collection first');
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  await auditSite(new URL('../', import.meta.url));
+  console.log(`Privacy source audit passed: ${fileURLToPath(new URL('../', import.meta.url))}`);
+}
