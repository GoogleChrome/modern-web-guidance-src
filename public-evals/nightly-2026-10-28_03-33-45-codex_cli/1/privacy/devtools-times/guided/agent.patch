diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..69ba9a9
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,20 @@
+export const AUTH_SERVICE_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+// Only these two fields belong in an authentication request. Never retain the
+// service's response body (which may contain tokens or identifying error text).
+export async function submitCredentials(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<boolean> {
+  const response = await fetch(`${AUTH_SERVICE_URL}/${action}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+    redirect: 'error',
+    body: JSON.stringify({ username, password }),
+  });
+  return response.ok;
+}
diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..8ec9c25
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { AUTH_SERVICE_URL, submitCredentials } from '../src/utils/auth.ts';
+
+for (const action of ['login', 'register']) {
+  test(`${action} sends only credentials without cookies, referrers, caching, or redirects`, async (t) => {
+    const fetch = t.mock.method(globalThis, 'fetch', async () => ({ ok: true }));
+    assert.equal(await submitCredentials(action, 'demo-reader', 'demo-password-123'), true);
+    assert.deepEqual(fetch.mock.calls[0].arguments, [
+      `${AUTH_SERVICE_URL}/${action}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer',
+        cache: 'no-store',
+        redirect: 'error',
+        body: JSON.stringify({ username: 'demo-reader', password: 'demo-password-123' }),
+      },
+    ]);
+  });
+}
+
+test('authentication failures do not read identifying service errors or tokens', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => ({
+    ok: false,
+    json() { throw new Error('Response body must not be consumed'); },
+  }));
+  assert.equal(await submitCredentials('login', 'demo-reader', 'wrong-password'), false);
+});
+
+test('network failures propagate so forms can clear passwords and show a safe message', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => { throw new TypeError('Network failure'); });
+  await assert.rejects(submitCredentials('register', 'demo-reader', 'demo-password-123'), TypeError);
+});
