+  <script>
+    (() => {
+      const types = {
+        urgent: { name: 'Checkout', rank: 0, slices: 28, browserPriority: 'user-blocking' },
+        standard: { name: 'Menu update', rank: 1, slices: 60, browserPriority: 'user-visible' },
+        background: { name: 'Telemetry', rank: 2, slices: 88, browserPriority: 'background' }
+      };
+      const queue = [];
+      const queueElement = document.getElementById('live-queue');
+      const activity = document.getElementById('activity-log');
+      const status = document.getElementById('system-status');
+      let nextId = 0;
+      let completed = 0;
+      let scheduled = false;
+      let activeTask = null;
+      let hasLog = false;
+      let lastPaint = 0;
+
+      function log(message) {
+        if (!hasLog) { activity.replaceChildren(); hasLog = true; }
+        const entry = document.createElement('div');
+        entry.className = 'activity-entry';
+        const time = document.createElement('time');
+        const now = new Date();
+        time.dateTime = now.toISOString();
+        time.textContent = now.toLocaleTimeString([], { hour12: false });
+        const text = document.createElement('span');
+        text.textContent = message;
+        entry.append(time, text);
+        activity.prepend(entry);
+        while (activity.children.length > 80) activity.lastElementChild.remove();
+      }
+
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} task${queue.length === 1 ? '' : 's'}`;
+        document.getElementById('completed-count').textContent = `${completed} task${completed === 1 ? '' : 's'} completed`;
+        status.textContent = queue.length ? 'Queue is working' : 'Ready to brew';
+        if (!queue.length) {
+          queueElement.innerHTML = '<div class="queue-empty"><span class="empty-symbol" aria-hidden="true">✓</span><strong>All caught up</strong><span>Run a task to put the queue to work.</span></div>';
+          return;
+        }
+        queueElement.innerHTML = queue.map(task => {
+          const progress = Math.floor(task.done / task.slices * 100);
+          const state = task === activeTask ? 'Running' : task.done ? 'Paused · higher priority first' : 'Waiting';
+          return `<div class="queue-item"><div class="task-meta"><strong>${task.name} <span class="panel-count">#${task.id}</span></strong><span class="priority priority-${task.type}">${task.type}</span></div><div class="task-state"><span>${state}</span><span>${progress}%</span></div><div class="progress-track" role="progressbar" aria-label="${task.name} #${task.id}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${progress}"><div class="progress-fill" style="width:${progress}%"></div></div></div>`;
+        }).join('');
+      }
+
+      function enqueue(type) {
+        const task = { ...types[type], type, id: ++nextId, done: 0 };
+        queue.push(task);
+        queue.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        log(`${task.name} #${task.id} queued · ${type}`);
+        render();
+        schedule();
+      }
+
+      function schedule() {
+        if (scheduled || !queue.length) return;
+        scheduled = true;
+        // A timer provides a rendering/input opportunity between every work slice.
+        setTimeout(() => {
+          // Read priority after yielding so newly queued urgent work gets picked first.
+          if (globalThis.scheduler && typeof globalThis.scheduler.postTask === 'function') {
+            globalThis.scheduler.postTask(runSlice, { priority: queue[0].browserPriority })
+              .catch(() => { scheduled = false; schedule(); });
+          } else {
+            runSlice();
+          }
+        }, 16);
+      }
+
+      function runSlice() {
+        scheduled = false;
+        const task = queue[0];
+        if (!task) return;
+        const changed = task !== activeTask;
+        if (changed) {
+          if (activeTask && queue.includes(activeTask)) log(`${activeTask.name} #${activeTask.id} paused for higher priority work`);
+          log(`${task.name} #${task.id} ${task.done ? 'resumed' : 'started'}`);
+          activeTask = task;
+        }
+        // Simulate CPU work in bounded slices rather than one long blocking loop.
+        const deadline = performance.now() + 3;
+        while (performance.now() < deadline) Math.sqrt(Math.random() * 10000);
+        task.done += 1;
+        if (task.done === task.slices) {
+          queue.shift();
+          completed += 1;
+          log(`${task.name} #${task.id} completed`);
+          activeTask = null;
+          render();
+        } else if (changed || performance.now() - lastPaint > 80) {
+          render();
+          lastPaint = performance.now();
+        }
+        schedule();
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue(button.dataset.task));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        // Deliberately enqueue out of order to demonstrate priority over arrival time.
+        enqueue('background');
+        enqueue('standard');
+        enqueue('urgent');
+      });
+      document.getElementById('clear-log').addEventListener('click', () => {
+        activity.innerHTML = '<div class="queue-empty"><span class="empty-symbol" aria-hidden="true">◷</span><strong>A fresh start</strong><span>Task activity will appear here.</span></div>';
+        hasLog = false;
+      });
+    })();
+  </script>
+
