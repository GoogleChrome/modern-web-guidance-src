+  <script>
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-button');
+    const status = document.getElementById('feedback-status');
+    const progress = document.getElementById('model-progress');
+    let detector;
+    let availability = 'unavailable';
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Language detection is not supported in this browser. Try a browser with built-in language detection.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is currently unavailable on this device.';
+          return;
+        }
+        button.disabled = false;
+        status.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'The language model needs to download. Select Detect to continue.';
+      } catch {
+        status.textContent = 'Unable to check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = message.value.trim();
+      if (!text) {
+        status.textContent = 'Enter a message before detecting its language.';
+        message.focus();
+        return;
+      }
+      if (button.disabled || availability === 'unavailable') return;
+
+      button.disabled = true;
+      message.readOnly = true;
+      form.setAttribute('aria-busy', 'true');
+      try {
+        if (!detector) {
+          if (availability !== 'available') {
+            progress.value = 0;
+            progress.hidden = false;
+            status.textContent = 'Downloading language model: 0%';
+          }
+          // Create directly from the submit gesture so model downloads are permitted.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                progress.hidden = false;
+                progress.value = percent;
+                status.textContent = `Downloading language model: ${percent}%`;
+              });
+            }
+          });
+          availability = 'available';
+        }
+
+        progress.hidden = true;
+        status.textContent = 'Detecting language…';
+        const [result] = await detector.detect(text);
+        if (!result || result.detectedLanguage === 'und') {
+          status.textContent = 'Could not determine the language. Try a longer message with more context.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        try {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        } catch {
+          // Keep the language tag if display names are unsupported.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1
+        }).format(result.confidence);
+        status.textContent = `Language: ${language} · AI confidence: ${confidence}`;
+      } catch {
+        if (detector) detector.destroy();
+        detector = undefined;
+        status.textContent = 'Language detection failed. Please try again. If a model download was interrupted, check your connection.';
+      } finally {
+        progress.hidden = true;
+        button.disabled = false;
+        message.readOnly = false;
+        form.removeAttribute('aria-busy');
+      }
+    });
+
+    message.addEventListener('input', () => {
+      if (availability !== 'unavailable' && !button.disabled) {
+        status.textContent = 'Select Detect to check your updated message.';
+      }
+    });
+
+    checkAvailability();
+  </script>
