+  <script type="module">
+    const drawer = document.querySelector('#navigation-drawer');
+    const menuButton = document.querySelector('#open-menu');
+    const track = drawer.querySelector('.drawer-track');
+    const panel = drawer.querySelector('.drawer-panel');
+
+    menuButton.addEventListener('click', () => {
+      drawer.showModal();
+      track.scrollTo({ left: 0, behavior: 'instant' });
+      menuButton.setAttribute('aria-expanded', 'true');
+    });
+
+    drawer.querySelector('.close-menu').addEventListener('click', () => drawer.close());
+
+    // Require a tap that starts and ends outside the panel, not a swipe.
+    let backdropPress;
+    drawer.addEventListener('pointerdown', (event) => {
+      backdropPress = panel.contains(event.target) ? null : { x: event.clientX, y: event.clientY };
+    });
+    drawer.addEventListener('pointercancel', () => { backdropPress = null; });
+    drawer.addEventListener('pointerup', (event) => {
+      if (backdropPress && !panel.contains(event.target) &&
+          Math.hypot(event.clientX - backdropPress.x, event.clientY - backdropPress.y) < 8) {
+        drawer.close();
+      }
+      backdropPress = null;
+    });
+
+    const closeAfterSwipe = () => {
+      if (drawer.open && track.scrollLeft >= panel.offsetWidth - 1) drawer.close();
+    };
+    if ('onscrollend' in track) {
+      track.addEventListener('scrollend', closeAfterSwipe);
+    } else {
+      // Older browsers still use native scrolling; wait for it to settle.
+      let scrollTimer;
+      track.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(closeAfterSwipe, 150);
+      }, { passive: true });
+    }
+
+    drawer.addEventListener('close', () => {
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+
+    // Keep the open snap position when the viewport changes orientation/size.
+    new ResizeObserver(() => {
+      if (drawer.open) track.scrollTo({ left: 0, behavior: 'instant' });
+    }).observe(track);
+  </script>
