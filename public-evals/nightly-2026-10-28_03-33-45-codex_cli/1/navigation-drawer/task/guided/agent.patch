+  <script type="module">
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const closeButton = drawer.querySelector('.drawer-close');
+    let phase = 'closed';
+    let hasShown = false;
+
+    function finishClosing() {
+      phase = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus();
+    }
+
+    async function openDrawer() {
+      if (phase !== 'closed') return;
+      phase = 'opening';
+      hasShown = false;
+      drawer.showPopover();
+      page.inert = true;
+      openButton.setAttribute('aria-expanded', 'true');
+
+      // Safari and Firefox need an explicit initial jump to the closed stop.
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      }
+      // Commit the closed position before beginning the opening scroll.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (phase === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (phase === 'closed') return;
+      phase = 'closing';
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    // Observe actual visibility so native swipes and button dismissal share
+    // the same cleanup, without hiding the popover midway through a swipe.
+    const observer = new IntersectionObserver(entries => {
+      if (phase === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRatio >= 0.001) hasShown = true;
+      if (entry.intersectionRatio < 0.001 && (hasShown || phase === 'closing')) {
+        finishClosing();
+      } else if (entry.intersectionRatio === 1 && phase === 'opening') {
+        phase = 'open';
+        closeButton.focus();
+      }
+    }, { root: scroller, threshold: [0, 0.001, 1] });
+    observer.observe(sheet);
+
+    // Keep the fade working when CSS scroll-driven animations are unavailable.
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const opacity = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / sheet.offsetWidth));
+        drawer.style.setProperty('--drawer-backdrop', opacity);
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+
+    document.addEventListener('keydown', event => {
+      if (phase === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      } else if (event.key === 'Tab') {
+        // A manual popover needs its own focus boundary in addition to inert.
+        const controls = [...sheet.querySelectorAll('button, a[href]')];
+        const first = controls[0];
+        const last = controls.at(-1);
+        if (phase === 'opening' || phase === 'closing') {
+          event.preventDefault();
+        } else if (event.shiftKey && (document.activeElement === first || !sheet.contains(document.activeElement))) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && (document.activeElement === last || !sheet.contains(document.activeElement))) {
+          event.preventDefault();
+          first.focus();
+        }
+      }
+    });
+  </script>
