+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('setup-status');
+    const summary = document.getElementById('subscription-summary');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--range-fill', `${((Number(roast.value) - 1) / 4) * 100}%`);
+      // A valid default roast counts as ready; marketing consent is never required.
+      const completed = Number(email.validity.valid) + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      const percent = Math.round((completed / 3) * 100);
+      progress.value = completed;
+      progress.textContent = `${percent}%`;
+      status.textContent = `${percent}% complete · ${completed} of 3 details ready.`;
+      summary.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    window.addEventListener('pageshow', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      const frequencyLabel = frequency.labels[0].textContent.trim();
+      const updates = document.getElementById('coffee-emails').checked ? 'Email offers selected.' : 'No marketing emails selected.';
+      summary.textContent = `Your preferences: ${roastValue.value} roast, delivered ${frequencyLabel.toLowerCase()}. ${updates} This is a preview; no subscription has been placed.`;
+    });
+    updateSetup();
+    document.getElementById('review-subscription').disabled = false;
+  </script>
