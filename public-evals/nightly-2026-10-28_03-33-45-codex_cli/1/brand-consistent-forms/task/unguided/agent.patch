+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const progress = document.getElementById('subscription-progress');
+    const summary = document.getElementById('subscription-summary');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      const percent = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percent}%`;
+      document.getElementById('progress-status').textContent = `${completed} of 3 complete · ${percent}%`;
+      summary.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const updates = document.getElementById('email-updates').checked ? 'requested' : 'not requested';
+      summary.textContent = `Your preferences: ${roastNames[Number(roast.value) - 1]} roast, delivered ${frequency.toLowerCase()}. Email updates: ${updates}. This is a preview of your preferences; no subscription has been placed.`;
+    });
+    updateSetup();
+  </script>
