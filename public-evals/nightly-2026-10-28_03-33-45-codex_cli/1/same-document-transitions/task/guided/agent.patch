+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const listHeading = document.getElementById('list-heading');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const pageTitle = document.title;
+    // Restore the list ourselves so browser history cannot move the shared target.
+    history.scrollRestoration = 'manual';
+    let selected = null;
+    let listScroll = 0;
+    let activeTransition = null;
+    let navigation = Promise.resolve();
+
+    function routeCard() {
+      return thumbnails.find(card => card.hash === location.hash) || null;
+    }
+
+    async function showPage(next, animate = true) {
+      if (next === selected) return;
+
+      const card = next || selected;
+      const cardTitle = card.querySelector('.title');
+      if (!selected) listScroll = window.scrollY;
+
+      const update = () => {
+        if (next) {
+          hero.style.setProperty('--coffee-image', next.style.getPropertyValue('--coffee-image'));
+          title.textContent = next.querySelector('.title').textContent;
+          hero.setAttribute('aria-label', title.textContent);
+          document.getElementById('description').textContent = next.parentElement.querySelector('p').textContent;
+        }
+        listPage.hidden = Boolean(next);
+        detailPage.hidden = !next;
+        selected = next;
+        document.title = next ? `${title.textContent} | The Daily Grind` : pageTitle;
+        window.scrollTo({ top: next ? 0 : listScroll, behavior: 'instant' });
+      };
+
+      const shared = [[card, 'coffee-hero'], [hero, 'coffee-hero'],
+        [cardTitle, 'coffee-title'], [title, 'coffee-title']];
+      try {
+        if (!animate || reducedMotion.matches || !document.startViewTransition) {
+          update();
+          return;
+        }
+
+        // Only the visible member of each pair participates in each snapshot.
+        shared.forEach(([element, name]) => { element.style.viewTransitionName = name; });
+        activeTransition = document.startViewTransition(update);
+        // A skipped snapshot can reject ready even though the DOM update succeeds.
+        activeTransition.ready.catch(() => {});
+        await activeTransition.finished;
+      } catch (error) {
+        // Navigation must still work if snapshot creation is interrupted or fails.
+        if (selected !== next) update();
+        console.warn('View transition skipped:', error);
+      } finally {
+        shared.forEach(([element]) => element.style.removeProperty('view-transition-name'));
+        activeTransition = null;
+        (selected ? title : listHeading).focus({ preventScroll: true });
+      }
+    }
+
+    function navigateTo(next) {
+      // Finish the current morph before starting another, including browser Back/Forward.
+      navigation = navigation.catch(() => {}).then(() => showPage(next));
+    }
+
+    thumbnails.forEach(card => {
+      card.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        history.pushState({ fromFavorites: true }, '', card.hash);
+        navigateTo(card);
+      });
+    });
+
+    document.querySelector('.back-link').addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      if (history.state?.fromFavorites) {
+        history.back();
+      } else {
+        history.pushState(null, '', '#seasonal-favorites');
+        navigateTo(null);
+      }
+    });
+
+    window.addEventListener('popstate', () => navigateTo(routeCard()));
+    window.addEventListener('hashchange', () => navigateTo(routeCard()));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+    // Direct links open the corresponding detail without an entrance animation.
+    navigation = showPage(routeCard(), false);
+  </script>
