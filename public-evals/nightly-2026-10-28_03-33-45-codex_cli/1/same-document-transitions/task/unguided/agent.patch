+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const detailImage = document.querySelector('#detail-image');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const motion = matchMedia('(prefers-reduced-motion: reduce)');
+    const root = document.documentElement;
+    let selected = null;
+    let listScroll = 0;
+    let activeTransition = null;
+    let navigation = Promise.resolve();
+
+    const descriptions = {
+      'maple-oat-latte': 'Our seasonal latte pairs freshly pulled espresso with silky steamed oat milk and a touch of Vermont maple syrup. Comforting, gently sweet, and made for slow mornings.',
+      'dark-roast-espresso': 'A deeply roasted espresso with a bold, smoky character and a rich finish. Freshly ground and pulled to order for a small cup with plenty of warmth.',
+      'cold-brew': 'Slow-steeped for 18 hours, our cold brew is smooth and refreshing. Served over ice to let its mellow roasted flavor shine with every sip.'
+    };
+
+    function routeCard() {
+      return thumbnails.find(card => card.hash === location.hash) || null;
+    }
+
+    function showPage(card, moveFocus = true) {
+      if (card && !selected) listScroll = window.scrollY;
+      if (card) {
+        const image = card.querySelector('img');
+        title.textContent = card.querySelector('.title').textContent;
+        detailImage.src = image.src;
+        detailImage.alt = image.alt;
+        document.querySelector('#detail-description').textContent = descriptions[card.dataset.coffee];
+      }
+      listPage.hidden = !!card;
+      detailPage.hidden = !card;
+      selected = card;
+      document.title = card ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+      if (moveFocus) {
+        window.scrollTo({ top: card ? Math.max(0, detailPage.offsetTop - 100) : listScroll, behavior: 'instant' });
+        (card ? title : document.querySelector('#list-heading')).focus({ preventScroll: true });
+      }
+    }
+
+    async function navigate() {
+      const next = routeCard();
+      if (next === selected) return;
+      if (!document.startViewTransition || motion.matches) {
+        showPage(next);
+        return;
+      }
+      const card = next || selected;
+      const cardTitle = card.querySelector('.title');
+      const sourceTitle = selected ? title : cardTitle;
+      const before = sourceTitle.getBoundingClientRect();
+      const tagged = [card, hero, cardTitle, title];
+      card.style.viewTransitionName = 'coffee-card';
+      hero.style.viewTransitionName = 'coffee-card';
+      cardTitle.style.viewTransitionName = 'coffee-title';
+      title.style.viewTransitionName = 'coffee-title';
+      try {
+        activeTransition = document.startViewTransition(() => {
+          showPage(next);
+          const after = (next ? title : cardTitle).getBoundingClientRect();
+          root.style.setProperty('--title-x', `${before.left - after.left}px`);
+          root.style.setProperty('--title-y', `${before.top - after.top}px`);
+        });
+        // A skipped/unsupported snapshot must still complete the route update.
+        await activeTransition.updateCallbackDone;
+        await activeTransition.finished;
+      } catch (error) {
+        showPage(next);
+      } finally {
+        tagged.forEach(element => element.style.removeProperty('view-transition-name'));
+        root.style.removeProperty('--title-x');
+        root.style.removeProperty('--title-y');
+        activeTransition = null;
+      }
+    }
+
+    window.addEventListener('hashchange', () => {
+      activeTransition?.skipTransition();
+      navigation = navigation.then(navigate, navigate);
+    });
+    motion.addEventListener('change', () => {
+      if (motion.matches) activeTransition?.skipTransition();
+    });
+    // Hash URLs also support reloads and opening a favorite in a new tab.
+    showPage(routeCard(), !!routeCard());
+  </script>
