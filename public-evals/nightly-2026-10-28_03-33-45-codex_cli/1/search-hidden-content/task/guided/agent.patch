+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    // Revealing is one-way, whether triggered by the button or native search.
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'View coupon';
+    }
+
+    couponPanel.addEventListener('beforematch', revealCoupon);
+    couponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.focus();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+
+    const tablist = document.querySelector('.business-tabs');
+    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
+    const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));
+
+    function selectTab(selectedTab) {
+      tabs.forEach((tab, index) => {
+        const selected = tab === selectedTab;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panels[index].removeAttribute('hidden');
+        } else {
+          panels[index].setAttribute('hidden', 'until-found');
+        }
+      });
+    }
+
+    if ('onbeforematch' in HTMLElement.prototype) {
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(tab));
+        // A search match must also close the other panel and select its tab.
+        panels[index].addEventListener('beforematch', () => selectTab(tab));
+      });
+
+      tablist.addEventListener('keydown', event => {
+        const index = tabs.indexOf(document.activeElement);
+        if (index < 0) return;
+        let next;
+        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = tabs.length - 1;
+        else return;
+        event.preventDefault();
+        selectTab(tabs[next]);
+        tabs[next].focus();
+      });
+    } else {
+      // Older browsers show searchable sections with anchor navigation instead.
+      revealCoupon();
+      tablist.removeAttribute('role');
+      tabs.forEach((tab, index) => {
+        const link = document.createElement('a');
+        link.className = tab.className;
+        link.href = '#' + panels[index].id;
+        link.id = tab.id;
+        link.textContent = tab.textContent;
+        tab.replaceWith(link);
+        panels[index].removeAttribute('hidden');
+        panels[index].removeAttribute('role');
+      });
+    }
+  </script>
