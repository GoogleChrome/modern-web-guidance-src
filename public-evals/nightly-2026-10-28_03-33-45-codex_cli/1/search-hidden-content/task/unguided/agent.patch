+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const revealCouponButton = document.getElementById('reveal-coupon');
+
+    function revealCoupon() {
+      // Reveal only: neither this button nor search can collapse the panel.
+      couponPanel.removeAttribute('hidden');
+      revealCouponButton.setAttribute('aria-expanded', 'true');
+      revealCouponButton.textContent = 'Coupon revealed';
+      revealCouponButton.disabled = true;
+    }
+
+    revealCouponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+    couponPanel.addEventListener('beforematch', revealCoupon);
+  </script>
