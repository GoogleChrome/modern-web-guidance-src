 <body>
@@ -206,7 +286,115 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="feedback-launcher" id="feedback-open" aria-haspopup="dialog" aria-controls="feedback-dialog">✎ &nbsp; Feedback</button>
+
+  <div id="feedback-home-right">
+    <dialog id="feedback-dialog" class="feedback-dialog" aria-labelledby="feedback-title" aria-describedby="feedback-intro">
+      <div class="feedback-heading">
+        <div>
+          <p class="feedback-eyebrow">A little feedback, a better brew</p>
+          <h2 id="feedback-title">How was your visit?</h2>
+        </div>
+        <button type="button" class="feedback-close" id="feedback-close" aria-label="Close feedback">×</button>
+      </div>
+      <p class="feedback-intro" id="feedback-intro">Good coffee starts with listening. Keep a note about your Daily Grind experience.</p>
+      <form id="feedback-form">
+        <label for="feedback-topic">What’s on your mind?</label>
+        <select id="feedback-topic" name="topic">
+          <option value="visit">My café experience</option>
+          <option value="coffee">The coffee &amp; menu</option>
+          <option value="website">The website</option>
+          <option value="other">Something else</option>
+        </select>
+        <label for="feedback-message">Your feedback</label>
+        <textarea id="feedback-message" name="message" placeholder="Tell us what made your day, or what could be better…" maxlength="5000" autofocus></textarea>
+        <div class="feedback-actions">
+          <button type="button" class="feedback-move" id="feedback-move">↔ Move to left</button>
+          <button type="submit" class="feedback-save">Save note</button>
+        </div>
+        <p class="feedback-note">Notes are saved only in this browser and aren’t sent to our team.</p>
+        <p class="feedback-status" id="feedback-status" role="status" aria-live="polite"></p>
+      </form>
+    </dialog>
+  </div>
+  <div id="feedback-home-left"></div>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackOpen = document.getElementById('feedback-open');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackTopic = document.getElementById('feedback-topic');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const rightHome = document.getElementById('feedback-home-right');
+    const leftHome = document.getElementById('feedback-home-left');
+    const storageKey = 'daily-grind-feedback';
+
+    // Storage is optional: privacy settings must not prevent opening the dialog.
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved.message === 'string') feedbackMessage.value = saved.message;
+      if (saved && [...feedbackTopic.options].some(option => option.value === saved.topic)) {
+        feedbackTopic.value = saved.topic;
+      }
+    } catch { /* Keep the in-memory draft if browser storage is unavailable. */ }
+
+    feedbackOpen.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+    document.getElementById('feedback-close').addEventListener('click', () => feedbackDialog.close());
+    feedbackDialog.addEventListener('close', () => {
+      // Ignore a queued close event from the fallback's synchronous close/reopen.
+      if (!feedbackDialog.open) feedbackOpen.focus({ preventScroll: true });
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const destination = feedbackDialog.parentElement === rightHome ? leftHome : rightHome;
+      if (typeof destination.moveBefore === 'function') {
+        // Atomic reparenting preserves top-layer modal state and active focus.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        // Ordinary DOM moves lose top-layer state. Explicitly restore it on the
+        // same dialog so form values, listeners, and the draft remain intact.
+        const wasOpen = feedbackDialog.open;
+        const returnValue = feedbackDialog.returnValue;
+        const activeElement = document.activeElement;
+        const selection = activeElement === feedbackMessage
+          ? [feedbackMessage.selectionStart, feedbackMessage.selectionEnd, feedbackMessage.selectionDirection]
+          : null;
+        const scrollPositions = [feedbackDialog, feedbackMessage].map(element =>
+          [element, element.scrollTop, element.scrollLeft]);
+        if (wasOpen) feedbackDialog.close();
+        destination.appendChild(feedbackDialog);
+        if (wasOpen) feedbackDialog.showModal();
+        feedbackDialog.returnValue = returnValue;
+        if (wasOpen && activeElement && feedbackDialog.contains(activeElement)) {
+          activeElement.focus({ preventScroll: true });
+          if (selection) feedbackMessage.setSelectionRange(...selection);
+        }
+        scrollPositions.forEach(([element, top, left]) => {
+          element.scrollTop = top;
+          element.scrollLeft = left;
+        });
+      }
+      feedbackMove.textContent = destination === leftHome ? '↔ Move to right' : '↔ Move to left';
+      feedbackStatus.textContent = `Moved to the ${destination === leftHome ? 'left' : 'right'}. Your note stays with you.`;
+    });
+
+    document.getElementById('feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          topic: feedbackTopic.value,
+          message: feedbackMessage.value
+        }));
+        feedbackStatus.textContent = 'Your note is saved in this browser.';
+      } catch {
+        feedbackStatus.textContent = 'Browser storage is unavailable. Your note will remain here until you reload.';
+      }
+    });
+  </script>
 </body>
 
 </html>
