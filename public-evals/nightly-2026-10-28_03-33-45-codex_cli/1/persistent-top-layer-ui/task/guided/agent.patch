   </footer>
 
+  <button type="button" class="btn feedback-launcher" id="open-feedback"
+    aria-haspopup="dialog" aria-controls="feedback-dialog">Feedback</button>
+
+  <div id="feedback-right">
+    <dialog id="feedback-dialog" class="feedback-dialog" aria-labelledby="feedback-title"
+      aria-describedby="feedback-description">
+      <div class="feedback-heading">
+        <h2 id="feedback-title">How was your visit?</h2>
+        <form method="dialog">
+          <button class="feedback-close" aria-label="Close feedback">✕</button>
+        </form>
+      </div>
+      <p id="feedback-description">A little feedback makes a better brew. Your draft stays here while you move or close this panel.</p>
+      <label for="feedback-message">Your feedback</label>
+      <textarea id="feedback-message" placeholder="Tell us what’s on your mind…" autofocus></textarea>
+      <div class="feedback-actions">
+        <button type="button" class="btn feedback-move" id="move-feedback">Move to left</button>
+        <form method="dialog"><button class="btn">Done</button></form>
+      </div>
+      <p class="feedback-location" id="feedback-location" role="status">Panel on the right · Draft only, not submitted</p>
+    </dialog>
+  </div>
+  <div id="feedback-left"></div>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLeft = document.getElementById('feedback-left');
+    const feedbackRight = document.getElementById('feedback-right');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const moveFeedback = document.getElementById('move-feedback');
+
+    document.getElementById('open-feedback').addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    moveFeedback.addEventListener('click', () => {
+      const target = feedbackDialog.parentElement === feedbackRight ? feedbackLeft : feedbackRight;
+
+      if (typeof target.moveBefore === 'function') {
+        // Both parents are connected to the same document. The atomic move keeps
+        // the dialog in the top layer with native modal and focus state intact.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const wasModal = feedbackDialog.matches(':modal');
+        const focused = document.activeElement;
+        const returnValue = feedbackDialog.returnValue;
+        const selection = [feedbackMessage.selectionStart, feedbackMessage.selectionEnd,
+          feedbackMessage.selectionDirection];
+        const scrollPositions = [feedbackDialog, feedbackMessage].map(element =>
+          [element, element.scrollTop, element.scrollLeft]);
+
+        // Explicitly close first: a traditional move can leave `open` set while
+        // dropping modal/top-layer state, making showModal() alone insufficient.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+        }
+        feedbackDialog.returnValue = returnValue;
+        if (wasOpen && focused instanceof HTMLElement && feedbackDialog.contains(focused)) {
+          focused.focus({ preventScroll: true });
+        }
+        feedbackMessage.setSelectionRange(...selection);
+        for (const [element, top, left] of scrollPositions) {
+          element.scrollTop = top;
+          element.scrollLeft = left;
+        }
+      }
+
+      const side = target === feedbackLeft ? 'left' : 'right';
+      moveFeedback.textContent = `Move to ${side === 'left' ? 'right' : 'left'}`;
+      document.getElementById('feedback-location').textContent =
+        `Panel on the ${side} · Draft only, not submitted`;
+    });
+  </script>
+
