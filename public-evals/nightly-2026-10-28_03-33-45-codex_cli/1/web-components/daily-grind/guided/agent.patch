+    :host {
+      color: white;
+      background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+        var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+      background-size: cover;
+      background-position: center;
+    }
+    .content {
+      min-height: 60vh;
+      padding: 32px 20px;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) {
+      font-size: clamp(2rem, 6vw, 3rem);
+      margin-bottom: 1rem;
+    }
+  </style>
+  <div class="content" part="content">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </div>
+`;
+
+/**
+ * Place inside a native header or section. Slots: heading, default (description),
+ * action (native link). Theme: --primary, --accent, --hero-image (CSS url()).
+ * Styling hook: ::part(content). Long content can grow beyond the minimum height.
+ */
+export class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+}
+
+if (!customElements.get('coffee-hero')) customElements.define('coffee-hero', CoffeeHero);
diff --git a/components/coffee-navigation.js b/components/coffee-navigation.js
new file mode 100644
index 0000000..bb986c6
--- /dev/null
+++ b/components/coffee-navigation.js
@@ -0,0 +1,118 @@
+import { baseStyles } from './shared.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    ${baseStyles}
+    :host { background: var(--primary, #4e342e); color: white; }
+    nav {
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 20px;
+      flex-wrap: wrap;
+    }
+    ::slotted([slot="brand"]) {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+    #links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+    ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+    ::slotted(a:hover) { color: var(--accent, #ffab40); }
+    ::slotted([data-outlined]) {
+      border: 1px solid var(--accent, #ffab40);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+    button {
+      font: inherit;
+      color: inherit;
+      background: transparent;
+      border: 1px solid var(--accent, #ffab40);
+      padding: 8px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+    [hidden] { display: none; }
+    @media (max-width: 48rem) {
+      #links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 8px; }
+      ::slotted(a) { padding: 8px 12px; }
+    }
+  </style>
+  <nav aria-label="Main navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="links" hidden>Navigation</button>
+    <div id="links"><slot></slot></div>
+  </nav>
+`;
+
+/**
+ * Slots: brand (text or home link), default (direct navigation anchors).
+ * Theme: --primary, --accent. Each instance owns its disclosure and listeners.
+ */
+export class CoffeeNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('#links');
+  }
+
+  connectedCallback() {
+    // Connections can repeat when a consumer moves or reinserts this element.
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const { signal } = this.#controller;
+    this.#media = matchMedia('(max-width: 48rem)');
+    const syncLayout = () => {
+      const mobile = this.#media.matches;
+      if (mobile) {
+        this.#button.hidden = false;
+        this.#setExpanded(false);
+      }
+      else {
+        this.#links.hidden = false;
+        if (this.shadowRoot.activeElement === this.#button) {
+          this.querySelector('a')?.focus();
+        }
+        this.#button.hidden = true;
+        this.#button.setAttribute('aria-expanded', 'true');
+      }
+    };
+    this.#button.addEventListener('click', () => {
+      this.#setExpanded(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        this.#setExpanded(false);
+        this.#button.focus();
+        event.preventDefault();
+      }
+    }, { signal });
+    this.#media.addEventListener('change', syncLayout, { signal });
+    syncLayout();
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #setExpanded(expanded) {
+    // Move focus before hiding slotted links, including a focused descendant.
+    if (!expanded && [...this.querySelectorAll('a')].some(link => link.matches(':focus-within'))) {
+      this.#button.focus();
+    }
+    this.#button.setAttribute('aria-expanded', String(expanded));
+    this.#links.hidden = !expanded;
+  }
+}
+
+if (!customElements.get('coffee-navigation')) customElements.define('coffee-navigation', CoffeeNavigation);
