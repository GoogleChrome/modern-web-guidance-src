@@ -0,0 +1,40 @@
+import { baseStyles } from './shared.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    ${baseStyles}
+    :host {
+      background: var(--card-background, white);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+      text-align: center;
+    }
+    article { padding: 20px; }
+    ::slotted([slot="heading"]) {
+      margin-bottom: 10px;
+      color: var(--primary, #4e342e);
+    }
+  </style>
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </article>
+`;
+
+/**
+ * Slots: heading (use the appropriate native heading level), default (description),
+ * action (native link with a descriptive accessible name).
+ * Theme: --primary, --text, --accent, --card-background. Styling hook: ::part(card).
+ * Content stays in Light DOM, so changes need no rerender and links work without JS.
+ */
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
