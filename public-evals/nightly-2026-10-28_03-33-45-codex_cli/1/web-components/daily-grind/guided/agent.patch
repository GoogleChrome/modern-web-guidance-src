+// Shared source, copied into each shadow template; no global component styles.
+export const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  *, ::slotted(*) { box-sizing: border-box; }
+  ::slotted(*) { margin: 0; }
+  ::slotted(a[slot="action"]) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    border-radius: 5px;
+    margin-top: 15px;
+    text-decoration: none;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
