@@ -0,0 +1,89 @@
+import { baseStyles } from './styles.js';
+
+export class CoffeeNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${baseStyles}
+        :host { position: sticky; top: 0; z-index: 1000; }
+        nav {
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 1rem 5%;
+          display: flex;
+          flex-wrap: wrap;
+          justify-content: space-between;
+          align-items: center;
+          gap: 1rem;
+          --focus: var(--accent, #ffab40);
+        }
+        .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+        #links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+        [hidden] { display: none !important; }
+        ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; }
+        ::slotted(a:hover) { color: var(--accent, #ffab40); }
+        ::slotted(.logout-link), button {
+          border: 1px solid var(--accent, #ffab40);
+          padding: 5px 12px;
+          border-radius: 4px;
+        }
+        button { color: white; background: transparent; font: inherit; cursor: pointer; }
+        @media (max-width: 700px) {
+          .logo { font-size: 1.15rem; }
+          #links { flex-basis: 100%; align-items: stretch; flex-direction: column; gap: 8px; }
+          ::slotted(a) { padding: 8px 12px; }
+        }
+      </style>
+      <nav aria-label="Primary">
+        <div class="logo"><slot name="brand">THE DAILY GRIND</slot></div>
+        <button type="button" aria-expanded="false" aria-controls="links" hidden>Menu</button>
+        <div id="links"><slot></slot></div>
+      </nav>
+    `;
+    this.button = this.shadowRoot.querySelector('button');
+    this.links = this.shadowRoot.querySelector('#links');
+    this.onViewportChange = () => this.setExpanded(!this.viewport.matches);
+  }
+
+  connectedCallback() {
+    this.listeners = new AbortController();
+    const options = { signal: this.listeners.signal };
+    this.viewport = window.matchMedia('(max-width: 700px)');
+    this.viewport.addEventListener('change', this.onViewportChange);
+    this.onViewportChange();
+    this.button.addEventListener('click', () => {
+      this.setExpanded(this.button.getAttribute('aria-expanded') !== 'true');
+    }, options);
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.viewport.matches && !this.links.hidden) {
+        this.setExpanded(false);
+        this.button.focus();
+      }
+    }, options);
+    this.addEventListener('click', (event) => {
+      if (this.viewport.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.setExpanded(false);
+      }
+    }, options);
+  }
+
+  disconnectedCallback() {
+    this.listeners.abort();
+    this.viewport.removeEventListener('change', this.onViewportChange);
+  }
+
+  setExpanded(expanded) {
+    // Keep focus visible if resizing collapses the link containing it.
+    const focusedLink = this.contains(document.activeElement);
+    this.button.hidden = !this.viewport.matches;
+    this.button.setAttribute('aria-expanded', String(expanded));
+    this.links.hidden = !expanded;
+    if (!expanded && focusedLink) this.button.focus();
+    if (this.button.hidden && this.shadowRoot.activeElement === this.button) {
+      this.querySelector('a')?.focus();
+    }
+  }
+}
+
+customElements.define('coffee-navigation', CoffeeNavigation);
diff --git a/components/styles.js b/components/styles.js
new file mode 100644
index 0000000..e4c0307
--- /dev/null
+++ b/components/styles.js
@@ -0,0 +1,23 @@
+// Shared rules are installed inside each shadow root, never in the global page.
+export const baseStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  [hidden] { display: none !important; }
+  a:focus-visible, button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--focus, #a65300);
+    outline-offset: 4px;
+  }
+`;
+
+export const buttonStyles = `
+  .btn {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  .btn:hover { background: #3e2723; }
+`;
