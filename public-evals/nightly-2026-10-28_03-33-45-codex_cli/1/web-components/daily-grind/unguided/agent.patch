+import { baseStyles, buttonStyles } from './styles.js';
+
+// Usage: <coffee-card name="Cold Brew" description="…" href="/menu/cold-brew">
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${baseStyles}
+        ${buttonStyles}
+        :host { height: 100%; }
+        article {
+          height: 100%;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+        h3 { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        p { margin: 0; }
+      </style>
+      <article aria-labelledby="name">
+        <h3 id="name"></h3>
+        <p></p>
+        <a class="btn">View Details</a>
+      </article>
+    `;
+  }
+
+  connectedCallback() { this.update(); }
+  attributeChangedCallback() { this.update(); }
+
+  update() {
+    const name = this.getAttribute('name') || 'Coffee';
+    this.shadowRoot.querySelector('h3').textContent = name;
+    this.shadowRoot.querySelector('p').textContent = this.getAttribute('description') || '';
+    const link = this.shadowRoot.querySelector('a');
+    link.setAttribute('aria-label', `View details for ${name}`);
+    // A card without a destination does not expose a nonfunctional control.
+    const href = this.getAttribute('href');
+    link.hidden = !href;
+    if (href) link.setAttribute('href', href);
+    else link.removeAttribute('href');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
