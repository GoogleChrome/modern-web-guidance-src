diff --git a/origin-validation.mjs b/origin-validation.mjs
new file mode 100644
index 0000000..37c9dfd
--- /dev/null
+++ b/origin-validation.mjs
@@ -0,0 +1,108 @@
+// Use only a known registrable domain you control for the legacy same-site fallback.
+export function createValidators({ trustedOrderingUrl, pageUrl, siteDomain,
+  OriginAPI = globalThis.Origin, MessageEventAPI = globalThis.MessageEvent }) {
+  const page = new URL(pageUrl);
+  const trusted = new URL(trustedOrderingUrl);
+  if (trusted.protocol !== 'https:' || trusted.username || trusted.password) {
+    throw new TypeError('The ordering service must use an HTTPS URL without credentials.');
+  }
+
+  function extractOrigin(candidate) {
+    try {
+      return OriginAPI.from(candidate);
+    } catch (error) {
+      // Synthetic MessageEvents have no internal origin. Never use this fallback
+      // for opaque widget identity: parsing "null" cannot preserve that identity.
+      if (MessageEventAPI && candidate instanceof MessageEventAPI) {
+        return OriginAPI.from(candidate.origin);
+      }
+      throw error;
+    }
+  }
+
+  function parseLink(candidate) {
+    const value = typeof candidate === 'string' ? candidate : candidate?.href;
+    if (typeof value !== 'string' || !value.trim()) return null;
+    try {
+      const url = new URL(value, page);
+      if ((url.protocol !== 'https:' && url.protocol !== 'http:') ||
+          url.username || url.password || url.origin === 'null') return null;
+      return url;
+    } catch {
+      return null;
+    }
+  }
+
+  function isTrustedOrderingMessage(event) {
+    try {
+      if (!event.source) return false;
+      if (OriginAPI) {
+        const sender = extractOrigin(event);
+        return !sender.opaque && sender.isSameOrigin(OriginAPI.from(trusted));
+      }
+      const sender = new URL(event.origin);
+      return sender.origin !== 'null' && sender.origin === trusted.origin;
+    } catch {
+      return false;
+    }
+  }
+
+  function isSameSiteUrl(candidate) {
+    const url = parseLink(candidate);
+    if (!url) return false;
+    try {
+      if (OriginAPI) {
+        const origin = OriginAPI.from(url);
+        return !origin.opaque && origin.isSameSite(OriginAPI.from(page));
+      }
+      // URL has no Public Suffix List. Never infer a registrable domain by
+      // splitting a hostname; only broaden trust to this configured private site.
+      const belongsToSite = (host) => Boolean(siteDomain) &&
+        (host === siteDomain || host.endsWith(`.${siteDomain}`));
+      return url.protocol === page.protocol &&
+        (url.hostname === page.hostname ||
+          (belongsToSite(page.hostname) && belongsToSite(url.hostname)));
+    } catch {
+      return false;
+    }
+  }
+
+  function allowedRedirect(candidate) {
+    const url = parseLink(candidate);
+    return url && isSameSiteUrl(url) ? url.href : null;
+  }
+
+  function classifyLink(candidate) {
+    const url = parseLink(candidate);
+    if (!url) return 'invalid';
+    return isSameSiteUrl(url) ? 'internal' : 'external';
+  }
+
+  return { isTrustedOrderingMessage, isSameSiteUrl, allowedRedirect, classifyLink };
+}
+
+export function createWidgetMessageValidator(expectedWidgetWindow,
+  { OriginAPI = globalThis.Origin } = {}) {
+  let pinned = false;
+  let pinnedSource = null;
+  let pinnedOrigin = OriginAPI ? new OriginAPI() : null;
+
+  return function acceptsWidgetMessage(event) {
+    if (!expectedWidgetWindow || event.source !== expectedWidgetWindow) return false;
+    try {
+      // Extract the browser's actual opaque origin, never the serialized "null".
+      const sender = OriginAPI ? OriginAPI.from(event) : null;
+      if (OriginAPI ? !sender.opaque : event.origin !== 'null') return false;
+      if (!pinned) {
+        if (event.data?.type !== 'init') return false;
+        pinnedOrigin = sender;
+        pinnedSource = event.source;
+        pinned = true;
+      }
+      return event.source === pinnedSource &&
+        (!OriginAPI || sender.isSameOrigin(pinnedOrigin));
+    } catch {
+      return false;
+    }
+  };
+}
