+// Loaded from the parent's site with only allow-scripts: the URL still supplies
+// the parent's target origin even though this document's own origin is opaque.
+const parentOrigin = new URL(window.location.href).origin;
+window.parent.postMessage({ type: 'init' }, parentOrigin);
+document.querySelector('button').addEventListener('click', () => {
+  window.parent.postMessage({ type: 'navigate', url: '/menu/seasonal' }, parentOrigin);
+});
