diff --git a/page.mjs b/page.mjs
new file mode 100644
index 0000000..5813877
--- /dev/null
+++ b/page.mjs
@@ -0,0 +1,56 @@
+import { createValidators, createWidgetMessageValidator } from './origin-validation.mjs';
+
+// Deployment configuration: replace the reserved .example values with your
+// ordering service's exact origin and your own private registrable domain.
+const TRUSTED_ORDERING_URL = 'https://orders.dailygrind.example';
+const SITE_DOMAIN = 'dailygrind.example';
+const validation = createValidators({
+  trustedOrderingUrl: TRUSTED_ORDERING_URL,
+  pageUrl: window.location.href,
+  siteDomain: SITE_DOMAIN,
+});
+const widget = document.getElementById('coffee-widget');
+const acceptsWidgetMessage = createWidgetMessageValidator(widget.contentWindow);
+const status = document.getElementById('order-status');
+
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+  if (event.source === widget.contentWindow) {
+    if (!acceptsWidgetMessage(event)) return;
+    if (data.type === 'navigate' && typeof data.url === 'string') {
+      const target = validation.allowedRedirect(data.url);
+      if (target) window.location.assign(target);
+    }
+    return;
+  }
+
+  if (!validation.isTrustedOrderingMessage(event)) return;
+  if (data.type === 'order-status' && typeof data.message === 'string' &&
+      data.message.length <= 500) {
+    status.textContent = data.message;
+  } else if (data.type === 'redirect' && typeof data.url === 'string') {
+    const target = validation.allowedRedirect(data.url);
+    if (target) window.location.assign(target);
+  }
+});
+
+// Apply the same URL policy at activation time, including dynamically added links.
+function validateLink(event) {
+  const link = event.target.closest?.('a[href], area[href]');
+  if (!link) return;
+  const classification = validation.classifyLink(link);
+  if (classification === 'invalid') {
+    event.preventDefault();
+    return;
+  }
+  if (classification === 'external') {
+    link.relList.add('noopener', 'noreferrer');
+  }
+}
+document.addEventListener('click', validateLink);
+document.addEventListener('auxclick', validateLink);
+
+// Load only after installing the listener so the one-time init cannot be lost.
+widget.src = new URL('./coffee-widget.html', import.meta.url).href;
diff --git a/tests/origin-validation.test.mjs b/tests/origin-validation.test.mjs
new file mode 100644
index 0000000..6050c0c
--- /dev/null
+++ b/tests/origin-validation.test.mjs
@@ -0,0 +1,128 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createValidators, createWidgetMessageValidator } from '../origin-validation.mjs';
+
+const source = {};
+const options = {
+  trustedOrderingUrl: 'https://orders.dailygrind.example',
+  pageUrl: 'https://www.dailygrind.example/home',
+  siteDomain: 'dailygrind.example',
+  OriginAPI: null,
+};
+const validators = createValidators(options);
+const message = (origin) => ({ origin, source });
+
+test('ordering requires the exact normalized HTTPS origin', () => {
+  assert.equal(validators.isTrustedOrderingMessage(message('https://orders.dailygrind.example:443')), true);
+  for (const origin of [
+    'https://orders.dailygrind.example.attacker.test',
+    'https://orders.dailygrind.example@attacker.test',
+    'https://other.dailygrind.example', 'http://orders.dailygrind.example',
+    'https://orders.dailygrind.example:8443', 'null', '', 'not a URL',
+  ]) assert.equal(validators.isTrustedOrderingMessage(message(origin)), false, origin);
+  assert.equal(validators.isTrustedOrderingMessage({ origin: options.trustedOrderingUrl, source: null }), false);
+});
+
+test('redirects resolve relative URLs and allow schemeful configured-site navigation', () => {
+  assert.equal(validators.allowedRedirect('/menu?coffee=latte#details'),
+    'https://www.dailygrind.example/menu?coffee=latte#details');
+  assert.equal(validators.isSameSiteUrl('https://billing.dailygrind.example:8443/orders'), true);
+  assert.equal(validators.isSameSiteUrl({ href: 'https://dailygrind.example/menu' }), true);
+  for (const url of [
+    '//attacker.test/path', 'http://www.dailygrind.example/menu',
+    'https://dailygrind.example.attacker.test', 'https://evildailygrind.example',
+    'https://dailygrind.example@attacker.test', 'https://user@dailygrind.example',
+    'javascript:alert(1)', 'data:text/html,hello', 'blob:https://www.dailygrind.example/id',
+    'file:///tmp/menu', 'https://[', '', null, {},
+  ]) assert.equal(validators.allowedRedirect(url), null, String(url));
+});
+
+test('fallback does not infer public suffixes or broaden trust on unrelated hosts', () => {
+  for (const [pageUrl, other] of [
+    ['https://a.co.uk', 'https://b.co.uk'],
+    ['https://tenant-a.github.io', 'https://tenant-b.github.io'],
+    ['https://localhost:11222', 'https://dailygrind.example'],
+  ]) {
+    const policy = createValidators({ ...options, pageUrl });
+    assert.equal(policy.isSameSiteUrl(other), false);
+    assert.equal(policy.isSameSiteUrl('/menu'), true);
+  }
+  const policy = createValidators({ ...options, pageUrl: 'https://www.coffee.co.uk', siteDomain: 'coffee.co.uk' });
+  assert.equal(policy.isSameSiteUrl('https://orders.coffee.co.uk'), true);
+  assert.equal(policy.isSameSiteUrl('https://another.co.uk'), false);
+});
+
+test('link classification distinguishes safe external links from invalid schemes', () => {
+  assert.equal(validators.classifyLink({ href: '/menu' }), 'internal');
+  assert.equal(validators.classifyLink('https://coffee.example.org'), 'external');
+  assert.equal(validators.classifyLink('http://www.dailygrind.example'), 'external');
+  assert.equal(validators.classifyLink('javascript:alert(1)'), 'invalid');
+});
+
+test('fallback widget pins only on init from the expected source', () => {
+  const accept = createWidgetMessageValidator(source, { OriginAPI: null });
+  const event = (type, sender = source, origin = 'null') => ({ source: sender, origin, data: { type } });
+  assert.equal(accept(event('navigate')), false);
+  assert.equal(accept(event('init', {})), false);
+  assert.equal(accept(event('init', source, 'https://dailygrind.example')), false);
+  assert.equal(accept(event('init')), true);
+  assert.equal(accept(event('navigate')), true);
+  assert.equal(accept(event('navigate', {})), false);
+  assert.equal(createWidgetMessageValidator(null, { OriginAPI: null })(event('init', null)), false);
+});
+
+// A contract double exercises Origin API dispatch and opaque identity in Node.
+// It does not emulate a browser's Public Suffix List or real MessageEvent origins.
+class TestOrigin {
+  constructor(url = null) { this.url = url; this.opaque = url === null; }
+  static from(candidate) {
+    if (candidate?.internalOrigin) return candidate.internalOrigin;
+    if (candidate instanceof URL) return new TestOrigin(candidate);
+    if (typeof candidate === 'string') return new TestOrigin(new URL(candidate));
+    throw new TypeError('No internal origin');
+  }
+  isSameOrigin(other) {
+    assert.ok(other instanceof TestOrigin);
+    return this.opaque || other.opaque ? this === other : this.url.origin === other.url.origin;
+  }
+  isSameSite(other) {
+    assert.ok(other instanceof TestOrigin);
+    // The test injects a decision, rather than reimplementing the PSL.
+    return this.url.hostname === 'billing.dailygrind.example' && other.url.hostname === 'www.dailygrind.example';
+  }
+}
+
+test('native API preserves opaque identity and never repins after initialization', () => {
+  const accept = createWidgetMessageValidator(source, { OriginAPI: TestOrigin });
+  const firstOrigin = new TestOrigin();
+  const otherOrigin = new TestOrigin();
+  const event = (type, internalOrigin, sender = source) => ({
+    source: sender, origin: 'null', internalOrigin, data: { type },
+  });
+  assert.equal(accept(event('navigate', firstOrigin)), false);
+  assert.equal(accept(event('init', otherOrigin, {})), false);
+  assert.equal(accept(event('init', firstOrigin)), true);
+  assert.equal(accept(event('navigate', firstOrigin)), true);
+  assert.equal(accept(event('navigate', otherOrigin, {})), false);
+  assert.equal(accept(event('init', otherOrigin)), false);
+  assert.equal(accept(event('navigate', firstOrigin)), true);
+  assert.equal(accept({ source, origin: 'null', data: { type: 'init' } }), false);
+});
+
+test('native URL checks use Origin instances and same-site API', () => {
+  const policy = createValidators({ ...options, OriginAPI: TestOrigin });
+  assert.equal(policy.isSameSiteUrl('https://billing.dailygrind.example'), true);
+  assert.equal(policy.isTrustedOrderingMessage({ source, internalOrigin: TestOrigin.from(options.trustedOrderingUrl) }), true);
+  assert.equal(policy.isTrustedOrderingMessage({ source, internalOrigin: new TestOrigin() }), false);
+  assert.equal(policy.isTrustedOrderingMessage({ source, origin: 'null' }), false);
+});
+
+test('synthetic MessageEvents fall back only for tuple ordering origins', () => {
+  const policy = createValidators({ ...options, OriginAPI: TestOrigin });
+  const trusted = new MessageEvent('message', { origin: options.trustedOrderingUrl });
+  Object.defineProperty(trusted, 'source', { value: source });
+  assert.equal(policy.isTrustedOrderingMessage(trusted), true);
+  const opaque = new MessageEvent('message', { origin: 'null' });
+  Object.defineProperty(opaque, 'source', { value: source });
+  assert.equal(policy.isTrustedOrderingMessage(opaque), false);
+});
diff --git a/tests/page.test.mjs b/tests/page.test.mjs
new file mode 100644
index 0000000..6d9b8bf
--- /dev/null
+++ b/tests/page.test.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+test('page wires trust checks to navigation, status, and link activation', async () => {
+  const messages = new Map();
+  const clicks = new Map();
+  const navigations = [];
+  const widget = { contentWindow: {}, src: '' };
+  const status = { textContent: '' };
+  globalThis.window = {
+    location: {
+      href: 'https://www.dailygrind.example/',
+      assign: (url) => navigations.push(url),
+    },
+    addEventListener: (type, callback) => messages.set(type, callback),
+  };
+  globalThis.document = {
+    getElementById: (id) => id === 'coffee-widget' ? widget : status,
+    addEventListener: (type, callback) => clicks.set(type, callback),
+  };
+  try {
+    await import('../page.mjs');
+    assert.ok(widget.src.endsWith('/coffee-widget.html'));
+    const receive = messages.get('message');
+    const ordering = (data, origin = 'https://orders.dailygrind.example') =>
+      receive({ source: {}, origin, data });
+    ordering({ type: 'redirect', url: '/menu' }, 'https://orders.dailygrind.example.attacker.test');
+    ordering({ type: 'redirect', url: 'https://attacker.test' });
+    ordering({ type: 'redirect', url: 'javascript:alert(1)' });
+    assert.deepEqual(navigations, []);
+    ordering({ type: 'redirect', url: 'https://billing.dailygrind.example/orders' });
+    assert.deepEqual(navigations, ['https://billing.dailygrind.example/orders']);
+    ordering({ type: 'order-status', message: '<img src=x onerror=alert(1)>' });
+    assert.equal(status.textContent, '<img src=x onerror=alert(1)>');
+    ordering({ type: 'order-status', message: 'x'.repeat(501) });
+    ordering({ type: 'order-status', message: { html: 'bad' } });
+    ordering(null);
+    assert.equal(status.textContent, '<img src=x onerror=alert(1)>');
+
+    const sandbox = (type, source = widget.contentWindow, url = '/menu/seasonal') =>
+      receive({ origin: 'null', source, data: { type, url } });
+    sandbox('navigate');
+    sandbox('init', {});
+    sandbox('navigate', {});
+    assert.equal(navigations.length, 1);
+    sandbox('init');
+    sandbox('navigate', {}, '/account');
+    sandbox('navigate', widget.contentWindow, 'https://attacker.test');
+    assert.equal(navigations.length, 1);
+    sandbox('navigate');
+    assert.equal(navigations[1], 'https://www.dailygrind.example/menu/seasonal');
+
+    const activate = (href, type) => {
+      const rel = new Set();
+      const link = { href, relList: { add: (...tokens) => tokens.forEach((token) => rel.add(token)) } };
+      const event = { target: { closest: () => link }, prevented: false,
+        preventDefault() { this.prevented = true; } };
+      clicks.get(type)(event);
+      return { event, rel };
+    };
+    assert.equal(activate('javascript:alert(1)', 'click').event.prevented, true);
+    assert.equal(activate('data:text/html,hello', 'auxclick').event.prevented, true);
+    const external = activate('https://external.example', 'auxclick');
+    assert.equal(external.event.prevented, false);
+    assert.deepEqual([...external.rel], ['noopener', 'noreferrer']);
+    assert.equal(activate('/menu', 'click').event.prevented, false);
+  } finally {
+    delete globalThis.window;
+    delete globalThis.document;
+  }
+});
