diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..3f8b977
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,172 @@
+(() => {
+  'use strict';
+
+  // Read the visible menu so agent responses and human-facing content stay in sync.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map((card) => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const order = new Map();
+  const status = document.querySelector('#menu-status');
+  const orderItems = document.querySelector('#order-items');
+
+  function validateInput(input, keys) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      return { error: 'Provide an object containing the tool arguments.' };
+    }
+    if (Object.keys(input).some((key) => !keys.includes(key))) {
+      return { error: 'Unexpected argument.', acceptedArguments: keys };
+    }
+  }
+
+  function findDrink(drinkId) {
+    return menu.find((drink) => drink.id === drinkId);
+  }
+
+  function unknownDrink() {
+    return { error: 'Choose a drink ID from the seasonal menu.', availableDrinkIds: menu.map((drink) => drink.id) };
+  }
+
+  function renderOrder() {
+    orderItems.replaceChildren();
+    for (const [id, quantity] of order) {
+      const item = document.createElement('li');
+      item.textContent = `${quantity} × ${findDrink(id).name}`;
+      orderItems.append(item);
+    }
+    document.querySelector('#empty-order').hidden = order.size > 0;
+    document.querySelector('#clear-order').disabled = order.size === 0;
+  }
+
+  function orderDrink(input) {
+    const invalid = validateInput(input, ['drinkId', 'quantity']);
+    if (invalid) return invalid;
+    const drink = findDrink(input.drinkId);
+    if (!drink) return unknownDrink();
+    const quantity = input.quantity === undefined ? 1 : input.quantity;
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      return { error: 'Quantity must be a whole number from 1 to 10.' };
+    }
+    const totalQuantity = (order.get(drink.id) || 0) + quantity;
+    if (totalQuantity > 10) return { error: 'An order can contain at most 10 of each drink.' };
+    order.set(drink.id, totalQuantity);
+    renderOrder();
+    status.textContent = `Added ${quantity} × ${drink.name} to your on-page order.`;
+    return {
+      status: 'added_to_page_order',
+      drink: { ...drink },
+      quantityAdded: quantity,
+      order: [...order].map(([id, count]) => ({ drinkId: id, quantity: count })),
+      purchaseSubmitted: false,
+    };
+  }
+
+  const drinkIdSchema = {
+    type: 'string', enum: menu.map((drink) => drink.id),
+    description: 'The stable ID of the seasonal drink.',
+  };
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Seasonal Favorites coffee menu to discover drinks and their details.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { query: { type: 'string', description: 'Words to match in drink names or descriptions.', default: '' } },
+      },
+      execute(input = {}) {
+        const invalid = validateInput(input, ['query']);
+        if (invalid) return invalid;
+        const query = input.query === undefined ? '' : input.query;
+        if (typeof query !== 'string') return { error: 'Query must be text.' };
+        const matches = menu.filter((drink) => `${drink.name} ${drink.description}`.toLowerCase().includes(query.trim().toLowerCase()));
+        return { category: 'Seasonal Favorites', drinks: matches.map((drink) => ({ ...drink })) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible, local on-page order. No purchase or payment is submitted.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          drinkId: drinkIdSchema,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'How many drinks to add to the order.' },
+        },
+        required: ['drinkId'],
+      },
+      execute: orderDrink,
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight a seasonal drink card and bring it into view for the user.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { drinkId: drinkIdSchema }, required: ['drinkId'],
+      },
+      execute(input) {
+        const invalid = validateInput(input, ['drinkId']);
+        if (invalid) return invalid;
+        const drink = findDrink(input.drinkId);
+        if (!drink) return unknownDrink();
+        for (const card of cards) {
+          const selected = card.dataset.drinkId === drink.id;
+          card.classList.toggle('is-highlighted', selected);
+          if (selected) {
+            card.focus({ preventScroll: true });
+            card.scrollIntoView({ block: 'nearest', behavior: 'instant' });
+          }
+        }
+        status.textContent = `Showing ${drink.name}. ${drink.description}`;
+        return { status: 'highlighted', drink: { ...drink } };
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  // Human controls use the same action as the agent tools, even without WebMCP.
+  document.querySelector('.order-panel').hidden = false;
+  for (const button of document.querySelectorAll('[data-order-drink]')) {
+    button.hidden = false;
+    button.addEventListener('click', () => {
+      const result = orderDrink({ drinkId: button.dataset.orderDrink });
+      if (result.error) status.textContent = result.error;
+    });
+  }
+  document.querySelector('#clear-order').addEventListener('click', () => {
+    order.clear();
+    renderOrder();
+    status.textContent = 'Your on-page order has been cleared.';
+  });
+  renderOrder();
+
+  // Prefer the current API, with compatibility for early WebMCP previews.
+  const modelContext = document.modelContext || navigator.modelContext;
+  if (typeof modelContext?.registerTool !== 'function') return;
+
+  let registration;
+  async function registerTools() {
+    if (registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of tools) {
+        if (controller.signal.aborted) return;
+        await modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      if (registration === controller) registration = undefined;
+      console.warn('Daily Grind WebMCP registration failed.', error);
+    }
+  }
+  window.addEventListener('pagehide', () => {
+    registration?.abort();
+    registration = undefined;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
diff --git a/webmcp.test.cjs b/webmcp.test.cjs
new file mode 100644
index 0000000..81d2e50
--- /dev/null
+++ b/webmcp.test.cjs
@@ -0,0 +1,148 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const html = readFileSync(`${__dirname}/index.html`, 'utf8');
+const source = readFileSync(`${__dirname}/webmcp.js`, 'utf8');
+
+// Minimal DOM double: exercises callbacks and state without launching a browser.
+function element() {
+  const listeners = {};
+  const classes = new Set();
+  return {
+    dataset: {}, hidden: true, disabled: false, textContent: '', children: [],
+    classList: { toggle(name, enabled) { enabled ? classes.add(name) : classes.delete(name); }, contains(name) { return classes.has(name); } },
+    addEventListener(name, callback) { listeners[name] = callback; },
+    click() { listeners.click(); },
+    replaceChildren() { this.children = []; },
+    append(child) { this.children.push(child); },
+    focus() { this.focused = true; },
+    scrollIntoView() { this.scrolled = true; },
+  };
+}
+
+async function setup({ support = 'document', fail = false } = {}) {
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)"[^>]*>\s*<h3>([^<]+)<\/h3>\s*<p>([^<]+)<\/p>\s*<a href="([^"]+)"/g)].map(([, id, name, description, href]) => {
+    const card = element();
+    card.dataset.drinkId = id;
+    card.querySelector = (selector) => ({ h3: { textContent: name }, p: { textContent: description }, a: { getAttribute: () => href } })[selector];
+    return card;
+  });
+  assert.equal(cards.length, 3);
+  const buttons = cards.map((card) => Object.assign(element(), { dataset: { orderDrink: card.dataset.drinkId } }));
+  const nodes = Object.fromEntries(['#menu-status', '#order-items', '#empty-order', '#clear-order', '.order-panel'].map((selector) => [selector, element()]));
+  const tools = new Map();
+  const registrations = [];
+  const events = {};
+  const warnings = [];
+  const api = {
+    async registerTool(tool, { signal }) {
+      if (fail && registrations.length === 1) throw new Error('Registration failed');
+      assert.equal(tools.has(tool.name), false, 'No duplicate tools');
+      tools.set(tool.name, tool);
+      registrations.push({ tool, signal });
+      signal.addEventListener('abort', () => tools.delete(tool.name));
+    },
+  };
+  const document = {
+    querySelectorAll: (selector) => selector === '[data-drink-id]' ? cards : buttons,
+    querySelector: (selector) => nodes[selector],
+    createElement: () => element(),
+  };
+  const navigator = {};
+  if (support === 'document') document.modelContext = api;
+  if (support === 'navigator') navigator.modelContext = api;
+  vm.runInNewContext(source, {
+    document, navigator, AbortController,
+    window: { addEventListener: (name, callback) => { events[name] = callback; } },
+    console: { warn: (...args) => warnings.push(args) },
+  });
+  const settle = () => new Promise((resolve) => setImmediate(resolve));
+  await settle();
+  // Normalize cross-realm values for assertions.
+  const call = (name, input) => JSON.parse(JSON.stringify(tools.get(name).execute(input)));
+  return { tools, cards, buttons, nodes, events, registrations, warnings, call, settle };
+}
+
+test('registers discoverable tools and reads the actual menu without UI mutations', async () => {
+  const { tools, nodes, call } = await setup();
+  assert.deepEqual([...tools.keys()], ['get_seasonal_menu', 'order_drink', 'highlight_drink']);
+  assert.equal(tools.get('get_seasonal_menu').annotations.readOnlyHint, true);
+  assert.equal(tools.get('order_drink').annotations.readOnlyHint, false);
+  assert.equal(call('get_seasonal_menu', {}).drinks.length, 3);
+  assert.equal(call('get_seasonal_menu', { query: ' OAT ' }).drinks[0].id, 'maple-oat-latte');
+  assert.equal(call('get_seasonal_menu', { query: '18 hours' }).drinks[0].id, 'cold-brew');
+  assert.deepEqual(call('get_seasonal_menu', { query: 'not on the menu' }).drinks, []);
+  assert.equal(nodes['#menu-status'].textContent, '');
+});
+
+test('agent and human orders share state, render quantities, and clear', async () => {
+  const { call, buttons, nodes } = await setup();
+  const result = call('order_drink', { drinkId: 'cold-brew', quantity: 2 });
+  assert.equal(result.purchaseSubmitted, false);
+  buttons[2].click();
+  assert.equal(nodes['#order-items'].children[0].textContent, '3 × Cold Brew');
+  assert.equal(nodes['#empty-order'].hidden, true);
+  assert.match(nodes['#menu-status'].textContent, /Added 1 × Cold Brew/);
+  nodes['#clear-order'].click();
+  assert.equal(nodes['#order-items'].children.length, 0);
+  assert.equal(nodes['#empty-order'].hidden, false);
+  assert.equal(nodes['#clear-order'].disabled, true);
+});
+
+test('invalid inputs return actionable errors and leave order state untouched', async () => {
+  const { call, nodes } = await setup();
+  for (const input of [null, [], {}, { drinkId: 'unknown' }, { drinkId: 'cold-brew', quantity: 0 }, { drinkId: 'cold-brew', quantity: 1.5 }, { drinkId: 'cold-brew', quantity: '2' }, { drinkId: 'cold-brew', quantity: 11 }, { drinkId: 'cold-brew', extra: true }]) {
+    assert.ok(call('order_drink', input).error);
+  }
+  assert.ok(call('get_seasonal_menu', { query: 10 }).error);
+  assert.ok(call('highlight_drink', { drinkId: '<script>' }).error);
+  assert.equal(nodes['#order-items'].children.length, 0);
+  call('order_drink', { drinkId: 'cold-brew', quantity: 10 });
+  assert.ok(call('order_drink', { drinkId: 'cold-brew' }).error);
+  assert.equal(nodes['#order-items'].children[0].textContent, '10 × Cold Brew');
+});
+
+test('highlight selects only the requested card and updates accessible status', async () => {
+  const { call, cards, nodes } = await setup();
+  call('highlight_drink', { drinkId: 'maple-oat-latte' });
+  call('highlight_drink', { drinkId: 'cold-brew' });
+  assert.equal(cards[0].classList.contains('is-highlighted'), false);
+  assert.equal(cards[2].classList.contains('is-highlighted'), true);
+  assert.equal(cards[2].focused, true);
+  assert.equal(cards[2].scrolled, true);
+  assert.match(nodes['#menu-status'].textContent, /Showing Cold Brew/);
+});
+
+test('unsupported browsers retain working human controls', async () => {
+  const { tools, buttons, nodes } = await setup({ support: 'none' });
+  assert.equal(tools.size, 0);
+  assert.equal(nodes['.order-panel'].hidden, false);
+  assert.equal(buttons[0].hidden, false);
+  buttons[0].click();
+  assert.equal(nodes['#order-items'].children[0].textContent, '1 × Maple Oat Latte');
+});
+
+test('early-preview API is supported and page lifecycle unregisters and restores tools', async () => {
+  const { tools, events, registrations, settle } = await setup({ support: 'navigator' });
+  assert.equal(tools.size, 3);
+  events.pageshow();
+  await settle();
+  assert.equal(registrations.length, 3);
+  events.pagehide();
+  assert.equal(tools.size, 0);
+  assert.equal(registrations[0].signal.aborted, true);
+  events.pageshow();
+  await settle();
+  assert.equal(tools.size, 3);
+  assert.equal(registrations.length, 6);
+});
+
+test('failed registration cleans partial tools and preserves page controls', async () => {
+  const { tools, warnings, buttons, nodes } = await setup({ fail: true });
+  assert.equal(tools.size, 0);
+  assert.equal(warnings.length, 1);
+  buttons[0].click();
+  assert.equal(nodes['#order-items'].children[0].textContent, '1 × Maple Oat Latte');
+});
