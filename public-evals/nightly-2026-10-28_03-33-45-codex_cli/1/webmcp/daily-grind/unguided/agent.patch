index 0000000..5f0aba4
--- /dev/null
+++ b/daily-grind.js
@@ -0,0 +1,164 @@
+(() => {
+  'use strict';
+
+  // The visible menu is the source of truth for both visitors and agents.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const form = document.getElementById('order-form');
+  const drinkSelect = document.getElementById('order-drink');
+  const quantityInput = document.getElementById('order-quantity');
+  const items = document.getElementById('order-items');
+  const empty = document.getElementById('order-empty');
+  const clearButton = document.getElementById('clear-order');
+  const status = document.getElementById('order-status');
+  const order = new Map();
+
+  function announce(message) { status.textContent = message; }
+
+  function getDrink(drinkId) {
+    const drink = menu.find(item => item.id === drinkId);
+    if (!drink) throw new Error(`Unknown drink. Use one of: ${menu.map(item => item.id).join(', ')}.`);
+    return drink;
+  }
+
+  function selectDrink(drinkId) {
+    const drink = getDrink(drinkId);
+    drinkSelect.value = drink.id;
+    cards.forEach(card => card.classList.toggle('is-selected', card.dataset.drinkId === drink.id));
+    return drink;
+  }
+
+  function getOrder() {
+    return {
+      status: 'draft',
+      submitted: false,
+      items: [...order].map(([drinkId, quantity]) => ({ drinkId, name: getDrink(drinkId).name, quantity })),
+      totalQuantity: [...order.values()].reduce((total, quantity) => total + quantity, 0),
+    };
+  }
+
+  function renderOrder() {
+    items.replaceChildren();
+    for (const item of getOrder().items) {
+      const row = document.createElement('li');
+      row.textContent = `${item.quantity} × ${item.name}`;
+      items.append(row);
+    }
+    empty.hidden = order.size > 0;
+    clearButton.disabled = order.size === 0;
+  }
+
+  function addDrink(drinkId, quantity = 1) {
+    const drink = getDrink(drinkId);
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) {
+      throw new Error('Quantity must be a whole number from 1 to 20.');
+    }
+    const nextQuantity = (order.get(drinkId) || 0) + quantity;
+    if (nextQuantity > 20) throw new Error('An order draft can contain at most 20 of each drink.');
+    order.set(drinkId, nextQuantity);
+    selectDrink(drinkId);
+    renderOrder();
+    announce(`Added ${quantity} × ${drink.name} to your order draft.`);
+    return getOrder();
+  }
+
+  for (const [index, drink] of menu.entries()) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    drinkSelect.append(option);
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'btn';
+    button.textContent = `Order ${drink.name}`;
+    button.addEventListener('click', () => {
+      selectDrink(drink.id);
+      announce(`${drink.name} selected. Choose a quantity and add it to your order.`);
+      document.getElementById('drink-order').scrollIntoView({ block: 'start' });
+      quantityInput.focus({ preventScroll: true });
+    });
+    cards[index].append(button);
+  }
+  drinkSelect.addEventListener('change', () => selectDrink(drinkSelect.value));
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    try { addDrink(drinkSelect.value, Number(quantityInput.value)); }
+    catch (error) { announce(error.message); }
+  });
+  clearButton.addEventListener('click', () => {
+    order.clear();
+    renderOrder();
+    announce('Order draft cleared.');
+  });
+
+  // Feature detection keeps the regular UI available in browsers without WebMCP.
+  const modelContext = document.modelContext ?? navigator.modelContext;
+  if (typeof modelContext?.registerTool !== 'function') return;
+
+  const drinkIdSchema = {
+    type: 'string',
+    enum: menu.map(drink => drink.id),
+    description: 'The seasonal drink ID returned by get_seasonal_menu.',
+  };
+  const result = data => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+  const execute = action => async (input = {}) => {
+    try {
+      if (!input || typeof input !== 'object' || Array.isArray(input)) {
+        throw new Error('Tool input must be an object.');
+      }
+      return result(action(input));
+    } catch (error) {
+      return { ...result({ error: error.message }), isError: true };
+    }
+  };
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Read the Seasonal Favorites coffee menu, including drink IDs, names, descriptions and detail links. Does not change the page.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: execute(() => ({ title: 'Seasonal Favorites', drinks: menu.map(drink => ({ ...drink })) })),
+    },
+    {
+      name: 'select_drink',
+      description: 'Highlight a seasonal drink and select it in the on-page order form. Does not add it to the order draft.',
+      inputSchema: { type: 'object', properties: { drinkId: drinkIdSchema }, required: ['drinkId'], additionalProperties: false },
+      execute: execute(({ drinkId }) => {
+        const drink = selectDrink(drinkId);
+        announce(`${drink.name} selected. Choose a quantity and add it to your order.`);
+        document.getElementById('drink-order').scrollIntoView({ block: 'start' });
+        return { selectedDrink: { ...drink } };
+      }),
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible client-side order draft. Quantity defaults to 1, with at most 20 of each drink. Does not submit an order, charge payment, or contact the café.',
+      inputSchema: {
+        type: 'object',
+        properties: { drinkId: drinkIdSchema, quantity: { type: 'integer', minimum: 1, maximum: 20, default: 1 } },
+        required: ['drinkId'], additionalProperties: false,
+      },
+      execute: execute(({ drinkId, quantity = 1 }) => addDrink(drinkId, quantity)),
+    },
+    {
+      name: 'get_order',
+      description: 'Read the current on-page order draft and total number of drinks. Drafts are kept only for this page session and are never submitted.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: execute(getOrder),
+    },
+  ];
+
+  async function registerTools() {
+    for (const tool of tools) {
+      try { await modelContext.registerTool(tool); }
+      catch (error) { console.warn(`Could not register WebMCP tool ${tool.name}.`, error); }
+    }
+  }
+  void registerTools();
+})();
