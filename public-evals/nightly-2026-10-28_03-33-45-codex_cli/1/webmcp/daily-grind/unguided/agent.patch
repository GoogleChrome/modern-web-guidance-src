diff --git a/tests/webmcp.test.cjs b/tests/webmcp.test.cjs
new file mode 100644
index 0000000..613bceb
--- /dev/null
+++ b/tests/webmcp.test.cjs
@@ -0,0 +1,109 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const source = readFileSync(new URL('../daily-grind.js', `file://${__filename}`), 'utf8');
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+
+// Small DOM fixture: exercises the actual script without launching a browser.
+class Element {
+  constructor(text = '') {
+    this.textContent = text;
+    this.children = [];
+    this.listeners = {};
+    this.classes = new Set();
+    this.classList = { toggle: (name, enabled) => enabled ? this.classes.add(name) : this.classes.delete(name) };
+  }
+  append(child) { this.children.push(child); }
+  replaceChildren() { this.children = []; }
+  addEventListener(event, callback) { this.listeners[event] = callback; }
+  scrollIntoView() { this.scrolled = true; }
+  focus() { this.focused = true; }
+}
+
+async function load(mode = 'document') {
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)">\s*<h3>(.*?)<\/h3>\s*<p>(.*?)<\/p>\s*<a href="([^"]+)"/g)].map(match => {
+    const card = new Element();
+    card.dataset = { drinkId: match[1] };
+    card.querySelector = selector => ({ h3: new Element(match[2]), p: new Element(match[3]), a: { getAttribute: () => match[4] } })[selector];
+    return card;
+  });
+  assert.equal(cards.length, 3);
+  const elements = Object.fromEntries(['order-form', 'order-drink', 'order-quantity', 'order-items', 'order-empty', 'clear-order', 'order-status', 'drink-order'].map(id => [id, new Element()]));
+  const registered = new Map();
+  const warnings = [];
+  const context = { registerTool: async tool => {
+    if (mode === 'failure' && tool.name === 'get_seasonal_menu') throw Error('Unavailable');
+    registered.set(tool.name, tool);
+  } };
+  const document = {
+    querySelectorAll: () => cards,
+    getElementById: id => elements[id],
+    createElement: () => new Element(),
+  };
+  const navigator = {};
+  if (mode === 'document' || mode === 'failure') document.modelContext = context;
+  if (mode === 'navigator') navigator.modelContext = context;
+  vm.runInNewContext(source, { document, navigator, console: { warn: (...args) => warnings.push(args) } });
+  await new Promise(resolve => setImmediate(resolve));
+  const call = async (name, input) => {
+    const result = await registered.get(name).execute(input);
+    return { ...result, data: JSON.parse(result.content[0].text) };
+  };
+  return { cards, elements, registered, call, warnings };
+}
+
+test('registers tools with both API locations and gracefully handles unsupported browsers', async () => {
+  for (const mode of ['document', 'navigator', 'unsupported']) {
+    const app = await load(mode);
+    assert.equal(app.registered.size, mode === 'unsupported' ? 0 : 4);
+    assert.equal(app.elements['order-drink'].children.length, 3);
+  }
+  const app = await load('failure');
+  assert.equal(app.registered.size, 3);
+  assert.equal(app.warnings.length, 1);
+});
+
+test('queries the visible menu and selects drinks without adding to the draft', async () => {
+  const { call, elements, cards } = await load();
+  const menu = (await call('get_seasonal_menu', {})).data;
+  assert.deepEqual(menu.drinks.map(drink => drink.name), ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']);
+  await call('select_drink', { drinkId: 'cold-brew' });
+  assert.equal(elements['order-drink'].value, 'cold-brew');
+  assert.ok(cards[2].classes.has('is-selected'));
+  assert.ok(elements['drink-order'].scrolled);
+  assert.equal((await call('get_order')).data.totalQuantity, 0);
+});
+
+test('agent orders update the visible draft; manual controls share the same state', async () => {
+  const { call, elements, cards } = await load();
+  assert.equal((await call('order_drink', { drinkId: 'maple-oat-latte', quantity: 2 })).data.totalQuantity, 2);
+  await call('order_drink', { drinkId: 'maple-oat-latte' });
+  assert.equal(elements['order-items'].children[0].textContent, '3 × Maple Oat Latte');
+  assert.equal(elements['order-empty'].hidden, true);
+  cards[2].children[0].listeners.click();
+  assert.ok(elements['order-quantity'].focused);
+  elements['order-quantity'].value = '2';
+  elements['order-form'].listeners.submit({ preventDefault() {} });
+  const order = (await call('get_order')).data;
+  assert.equal(order.totalQuantity, 5);
+  assert.equal(order.submitted, false);
+  elements['clear-order'].listeners.click();
+  assert.equal((await call('get_order')).data.totalQuantity, 0);
+  assert.equal(elements['order-items'].children.length, 0);
+  assert.equal(elements['clear-order'].disabled, true);
+});
+
+test('invalid orders return errors without changing state', async () => {
+  const { call } = await load();
+  for (const quantity of [0, -1, 1.5, 21, '2', null]) {
+    assert.equal((await call('order_drink', { drinkId: 'cold-brew', quantity })).isError, true);
+  }
+  assert.equal((await call('order_drink', { drinkId: 'missing' })).isError, true);
+  assert.equal((await call('order_drink', null)).isError, true);
+  assert.equal((await call('get_order')).data.totalQuantity, 0);
+  await call('order_drink', { drinkId: 'cold-brew', quantity: 20 });
+  assert.equal((await call('order_drink', { drinkId: 'cold-brew' })).isError, true);
+  assert.equal((await call('get_order')).data.totalQuantity, 20);
+});
