diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..1164ad7
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,42 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function getArticles(signal?: AbortSignal): Promise<Article[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load articles (${response.status})`);
+  return response.json();
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleResult(article: Article) {
+  return { ...article, url: `${import.meta.env.BASE_URL}articles/${article.slug}` };
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<{ readingList: string[] }> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load reading list (${response.status})`);
+  return response.json();
+}
+
+export async function toggleReadingList(slug: string, signal?: AbortSignal): Promise<{ readingList: string[] }> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Could not update reading list (${response.status})`);
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: data.readingList }));
+  return data;
+}
diff --git a/src/lib/site-tools.ts b/src/lib/site-tools.ts
new file mode 100644
index 0000000..5ce8f88
--- /dev/null
+++ b/src/lib/site-tools.ts
@@ -0,0 +1,58 @@
+import { articleResult, getArticles, getReadingList, toggleReadingList } from './articles';
+import { registerTool } from './webmcp';
+
+let dispose: (() => void)[] = [];
+function cleanup() {
+  dispose.forEach(stop => stop());
+  dispose = [];
+}
+function setup() {
+  cleanup();
+  dispose = [
+    registerTool({
+      name: 'list_articles',
+      description: 'List all DevTools Times articles with slugs, titles, summaries and URLs.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: async (_, options) => (await getArticles(options?.signal)).map(articleResult),
+    }),
+    registerTool({
+      name: 'get_article',
+      description: 'Get article details by slug. Includes the article text when it is the currently open article.',
+      inputSchema: { type: 'object', properties: { slug: { type: 'string', description: 'Article slug from list_articles.' } }, required: ['slug'], additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: async ({ slug }, options) => {
+        if (typeof slug !== 'string' || !slug.trim()) throw new Error('A nonempty article slug is required.');
+        const article = (await getArticles(options?.signal)).find(article => article.slug === slug);
+        if (!article) throw new Error(`Article not found: ${slug}`);
+        const current = document.querySelector<HTMLElement>('[data-article-slug]');
+        if (current?.dataset.articleSlug !== slug) return articleResult(article);
+        const body = current.querySelector('[data-article-body]')?.cloneNode(true) as HTMLElement | undefined;
+        body?.querySelectorAll('script, style').forEach(element => element.remove());
+        return { ...articleResult(article), text: body?.textContent?.trim() ?? '' };
+      },
+    }),
+    registerTool({
+      name: 'get_reading_list',
+      description: 'Get the current session reading list with article details and URLs.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true },
+      execute: async (_, options) => {
+        const [articles, { readingList }] = await Promise.all([getArticles(options?.signal), getReadingList(options?.signal)]);
+        return articles.filter(article => readingList.includes(article.slug)).map(articleResult);
+      },
+    }),
+    registerTool({
+      name: 'toggle_reading_list',
+      description: 'Toggle an article in the current session reading list: add it if absent, remove it if saved. Returns the updated list of slugs.',
+      inputSchema: { type: 'object', properties: { slug: { type: 'string', description: 'Article slug from list_articles.' } }, required: ['slug'], additionalProperties: false },
+      execute: async ({ slug }, options) => {
+        if (typeof slug !== 'string' || !slug.trim()) throw new Error('A nonempty article slug is required.');
+        if (!(await getArticles(options?.signal)).some(article => article.slug === slug)) throw new Error(`Article not found: ${slug}`);
+        return toggleReadingList(slug, options?.signal);
+      },
+    }),
+  ];
+}
+document.addEventListener('astro:before-swap', cleanup);
+document.addEventListener('astro:page-load', setup);
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..cf31190
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,54 @@
+// Keep experimental browser types local so unsupported browsers need no polyfill.
+export interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: Record<string, unknown>, options?: { signal?: AbortSignal }) => unknown;
+}
+
+interface ModelContext {
+  registerTool(tool: BrowserTool, options?: { signal: AbortSignal }): void | Promise<void>;
+  unregisterTool?(name: string): void | Promise<void>;
+}
+
+// Serialize registration and cleanup per name, including rapid Astro/React remounts.
+const pending = new WeakMap<ModelContext, Map<string, Promise<void>>>();
+
+export function registerTool(tool: BrowserTool): () => void {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context) return () => {};
+  const queue = pending.get(context) ?? new Map<string, Promise<void>>();
+  pending.set(context, queue);
+  const controller = new AbortController();
+  let disposed = false;
+  let registered = false;
+  const registration = (queue.get(tool.name) ?? Promise.resolve()).then(async () => {
+    if (disposed) return;
+    await context.registerTool(tool, { signal: controller.signal });
+    registered = true;
+  }).catch(error => console.warn(`Could not register WebMCP tool ${tool.name}`, error));
+  queue.set(tool.name, registration);
+  return () => {
+    if (disposed) return;
+    disposed = true;
+    const cleanup = registration.then(async () => {
+      if (registered && context.unregisterTool) await context.unregisterTool(tool.name);
+    }).catch(error => {
+      console.warn(`Could not unregister WebMCP tool ${tool.name}`, error);
+    }).finally(() => controller.abort());
+    queue.set(tool.name, cleanup);
+    void cleanup.then(() => {
+      if (queue.get(tool.name) === cleanup) queue.delete(tool.name);
+    });
+  };
+}
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as Event & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  };
+  if (submission.agentInvoked && submission.respondWith) submission.respondWith(result);
+}
