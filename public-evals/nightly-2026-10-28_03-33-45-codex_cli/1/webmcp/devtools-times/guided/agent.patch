diff --git a/src/utils/article-client.ts b/src/utils/article-client.ts
new file mode 100644
index 0000000..e97c8b1
--- /dev/null
+++ b/src/utils/article-client.ts
@@ -0,0 +1,46 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const articleUrl = (slug: string) => `${import.meta.env.BASE_URL}articles/${encodeURIComponent(slug)}`;
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ).map(article => ({ ...article, url: articleUrl(article.slug) })) : [];
+}
+
+export async function fetchJSON<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, init);
+  if (!response.ok) throw new Error(`Request failed (${response.status} ${response.statusText}).`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) => fetchJSON<Article[]>('articles.json', { signal });
+export const getReadingList = (signal?: AbortSignal) => fetchJSON<{ readingList: string[] }>('reading-list.json', { signal });
+
+export async function toggleReadingList(slug: string, signal?: AbortSignal) {
+  const data = await fetchJSON<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }), signal,
+  });
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: data.readingList }));
+  return data;
+}
+
+// React's synthetic event keeps the browser's agent submission methods on nativeEvent.
+export function respondToAgent(event: React.FormEvent<HTMLFormElement>, result: Promise<unknown>) {
+  const submission = event.nativeEvent as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith: (result: Promise<string>) => void;
+  };
+  if (submission.agentInvoked) submission.respondWith(result.then(value => JSON.stringify(value)));
+}
+
+export function errorResult(error: unknown) {
+  return { error: error instanceof Error ? error.message : String(error) };
+}
