diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..fd54235
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,86 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { articleUrl, getArticles, getReadingList, errorResult } from '../utils/article-client';
+
+// This single island owns site-wide utility tools, avoiding duplicate registrations
+// from the many article teasers and bookmark buttons on a page.
+export default function ArticleTools({ isArticle = false }: { isArticle?: boolean }) {
+  useWebMCP({
+    name: 'list_articles',
+    description: 'List the available articles with their summaries and links.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal }) {
+      try {
+        const articles = await getArticles(signal);
+        return { articles: articles.map(article => ({ ...article, url: articleUrl(article.slug) })) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_article_details',
+    description: 'Look up an article summary and link before opening it to read the full story.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', minLength: 1, description: 'The article identifier returned by search_articles or list_articles.' } },
+      required: ['slug'],
+      additionalProperties: false,
+    },
+    async execute(input, { signal }) {
+      if (!input || typeof input.slug !== 'string' || !input.slug.trim()) {
+        return { error: 'Provide an article slug from search_articles or list_articles.' };
+      }
+      try {
+        const article = (await getArticles(signal)).find(article => article.slug === input.slug);
+        return article ? { ...article, url: articleUrl(article.slug) }
+          : { error: 'Article not found. Use search_articles or list_articles to find an existing slug.' };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: 'Read the saved article list with article details and links.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal }) {
+      try {
+        const [articles, { readingList }] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+        return { readingList, articles: articles.filter(article => readingList.includes(article.slug))
+          .map(article => ({ ...article, url: articleUrl(article.slug) })) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'read_current_article',
+    enabled: isArticle,
+    description: 'Read the headline, summary, and body of the article currently displayed.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const article = document.querySelector('[data-current-article]');
+      if (!article) return { error: 'Open an article page first. Use list_articles to find an article link.' };
+      const body = article.querySelector('[data-article-body]')?.cloneNode(true) as HTMLElement | undefined;
+      body?.querySelectorAll('script, style, template').forEach(node => node.remove());
+      return {
+        summary: article.querySelector('[data-article-summary]')?.textContent?.trim(),
+        title: article.querySelector('h1')?.textContent?.trim(),
+        body: body?.textContent?.trim(),
+        url: window.location.href,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
