+  <script>
+    (() => {
+      const control = document.getElementById('reduce-motion');
+      const state = document.getElementById('motion-state');
+      const systemPreference = matchMedia('(prefers-reduced-motion: reduce)');
+      const root = document.documentElement;
+      const key = 'daily-grind-reduce-motion';
+
+      function syncControl() {
+        control.checked = root.dataset.reduceMotion === undefined
+          ? systemPreference.matches
+          : root.dataset.reduceMotion === 'true';
+        state.textContent = control.checked ? 'On' : 'Off';
+      }
+
+      if (!('switch' in HTMLInputElement.prototype)) {
+        // Keep switch semantics even if the visual enhancement cannot load.
+        control.setAttribute('role', 'switch');
+        import('./vendor/input-switch-polyfill/input-switch-polyfill.js')
+          .catch(() => {});
+      }
+
+      control.addEventListener('change', () => {
+        root.dataset.reduceMotion = String(control.checked);
+        syncControl();
+        try {
+          localStorage.setItem(key, root.dataset.reduceMotion);
+        } catch {}
+      });
+
+      systemPreference.addEventListener('change', syncControl);
+      window.addEventListener('storage', (event) => {
+        if (event.key !== key && event.key !== null) return;
+        if (event.newValue === 'true' || event.newValue === 'false') {
+          root.dataset.reduceMotion = event.newValue;
+        } else {
+          delete root.dataset.reduceMotion;
+        }
+        syncControl();
+      });
+
+      syncControl();
+      document.getElementById('display-preferences').hidden = false;
+    })();
+  </script>
+
 </body>
 
