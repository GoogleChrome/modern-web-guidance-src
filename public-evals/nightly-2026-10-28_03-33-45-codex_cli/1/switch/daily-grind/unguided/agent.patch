+  <script>
+    const themeSwitch = document.getElementById('dark-mode');
+    let darkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
+
+    try {
+      const savedTheme = localStorage.getItem('daily-grind-theme');
+      if (savedTheme === 'dark' || savedTheme === 'light') {
+        darkMode = savedTheme === 'dark';
+      }
+    } catch {
+      // The switch still works when browser storage is unavailable.
+    }
+
+    function applyTheme() {
+      document.documentElement.dataset.theme = themeSwitch.checked ? 'dark' : 'light';
+    }
+
+    themeSwitch.checked = darkMode;
+    applyTheme();
+
+    themeSwitch.addEventListener('change', () => {
+      applyTheme();
+      try {
+        localStorage.setItem('daily-grind-theme', themeSwitch.checked ? 'dark' : 'light');
+      } catch {
+        // Keep the current theme usable without persistence.
+      }
+    });
+  </script>
