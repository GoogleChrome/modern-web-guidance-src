+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const journalCopy = document.getElementById('journal-copy');
+    const summarizerOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          journalStatus.textContent = `Downloading browser AI model: ${Math.round(event.loaded * 100)}%. This first download may take a few minutes.`;
+        });
+      }
+    };
+
+    async function checkSummarizer() {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Native AI summaries are unavailable in this browser. Try a supported desktop browser over HTTPS; the full journal is available above.';
+        return;
+      }
+
+      try {
+        const availability = await window.Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Browser AI is unavailable on this device. You can still read the full journal above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Get a few key points using AI on your device.'
+          : 'Summarize will prepare the browser AI model. A first-time download may take a few minutes; the journal text stays on your device.';
+      } catch {
+        journalStatus.textContent = 'Unable to check browser AI availability. Reload the page to try again; the full journal is available above.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing browser AI… A first-time model download may take a few minutes.';
+      let summarizer;
+
+      try {
+        // Create directly from the click to preserve the required user activation.
+        summarizer = await window.Summarizer.create(summarizerOptions);
+        journalStatus.textContent = 'Summarizing the journal on your device…';
+        const summary = await summarizer.summarize(journalCopy.innerText);
+        const points = summary.split(/\n+/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Summary ready below. Generated by your browser AI; refer to the journal for the full story.';
+      } catch {
+        journalStatus.textContent = 'The browser could not generate a summary. Please try again. The full journal remains available above.';
+      } finally {
+        summarizer?.destroy();
+        summaryPanel.removeAttribute('aria-busy');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkSummarizer();
+  </script>
+
