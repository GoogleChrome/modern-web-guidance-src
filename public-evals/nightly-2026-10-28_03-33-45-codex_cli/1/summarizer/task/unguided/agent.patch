+      <noscript><p>Enable JavaScript to use the browser's native AI summary.</p></noscript>
+      <div class="journal-summary" id="journal-summary" aria-labelledby="summary-heading" hidden>
+        <h3 id="summary-heading">Sourcing at a glance</h3>
+        <ul id="journal-summary-points"></ul>
+      </div>
