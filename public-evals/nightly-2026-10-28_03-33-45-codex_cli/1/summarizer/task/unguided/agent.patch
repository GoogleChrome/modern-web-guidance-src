+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'Native AI summaries are unavailable in this browser. Try a supported desktop browser over HTTPS.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'Your browser’s native AI is unavailable on this device. You can still read the full journal above.';
+            return;
+          }
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points using AI on your device.'
+            : 'First use downloads your browser’s AI model. The summary is generated on your device.';
+        } catch {
+          status.textContent = 'Unable to check native AI availability. Reload the page to try again.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your browser’s AI…';
+        let summarizer;
+
+        try {
+          // Create directly from the click to preserve user activation for model downloads.
+          summarizer = await window.Summarizer.create({
+            ...options,
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                status.textContent = `Downloading the browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+              });
+            }
+          });
+          status.textContent = 'Reading the journal and finding the key points…';
+          const result = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+          // Group wrapped lines into list items and render model output strictly as text.
+          const bullets = [];
+          for (const line of result.split(/\r?\n/)) {
+            const trimmed = line.trim();
+            if (!trimmed) continue;
+            const marker = /^(?:[-*•–]\s+|\d+[.)]\s+)/;
+            if (marker.test(trimmed) || !bullets.length) {
+              bullets.push(trimmed.replace(marker, ''));
+            } else {
+              bullets[bullets.length - 1] += ` ${trimmed}`;
+            }
+          }
+          if (!bullets.length) throw new Error('Empty summary');
+          points.replaceChildren(...bullets.map((text) => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'Your AI-generated summary is ready below.';
+        } catch {
+          status.textContent = 'The browser couldn’t create a summary. Please try again; native AI may be unavailable or the model download may have been interrupted.';
+        } finally {
+          summarizer?.destroy();
+          summary.removeAttribute('aria-busy');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
