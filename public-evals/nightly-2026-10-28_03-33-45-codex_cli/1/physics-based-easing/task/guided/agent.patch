+    }
+
+    @media (hover: hover) {
+      .spring:hover {
+        transform: scale(1.04);
+      }
+
+      .bounce:hover {
+        transform: translateY(-8px) scale(1.025);
+      }
+    }
+
+    .spring:focus-within {
+      transform: scale(1.04);
+    }
+
+    .bounce:focus-within {
+      transform: translateY(-8px) scale(1.025);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .spring,
+      .bounce,
+      .spring *,
