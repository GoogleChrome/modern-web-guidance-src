+      font-size: 0.9rem;
+    }
+
+    .rewards-progress {
+      position: relative;
+      width: 220px;
+      max-width: 100%;
+      aspect-ratio: 1;
+      margin: 24px auto;
+    }
+
+    .rewards-progress svg {
+      display: block;
+      width: 100%;
+      height: 100%;
+      transform: rotate(-90deg);
+    }
+
+    .rewards-progress circle {
+      fill: none;
+      stroke-width: 10;
+    }
+
+    .rewards-track {
+      stroke: var(--secondary);
+    }
+
+    .rewards-fill {
+      stroke: var(--accent);
+      stroke-linecap: round;
+    }
+
+    .rewards-progress-details {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      color: var(--primary);
+    }
+
+    .rewards-count {
+      font-size: 2.5rem;
+      font-weight: 700;
+      line-height: 1.2;
+    }
+
+    .rewards-count span {
+      font-size: 1.1rem;
+      font-weight: 400;
+    }
+
+    .rewards-remaining {
+      font-weight: 600;
+      margin-bottom: 6px;
+    }
+
+    @media (min-width: 1000px) {
+      .container {
+        display: grid;
+        grid-template-columns: minmax(0, 1fr) 300px;
+        gap: 24px;
+        align-items: start;
+      }
+
+      .seasonal-favorites .grid {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+      }
+    }
+
+    @media (max-width: 999px) {
+      .rewards {
+        margin-top: 32px;
+      }
+    }
