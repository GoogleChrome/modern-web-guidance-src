+
+    .rewards-count span {
+      font-size: 1.1rem;
+      font-weight: 400;
+    }
+
+    .rewards-remaining {
+      margin-top: 8px;
+      padding: 3px 10px;
+      border-radius: 20px;
+      background: var(--accent);
+      font-size: 0.8rem;
+      font-weight: 600;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
