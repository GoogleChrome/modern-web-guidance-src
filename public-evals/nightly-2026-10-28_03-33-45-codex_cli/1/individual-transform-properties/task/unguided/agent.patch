+      /* Keep the stacking context stable before, during, and after hover. */
+      isolation: isolate;
+      /* Independent transform properties keep the animations and transition separate. */
+      scale: 1;
+      transition: scale 0.3s ease;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
