diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,56 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .seasonal-promo {
+      padding: 24px 32px;
+      text-align: center;
+    }
+
+    .target {
+      display: inline-grid;
+      place-content: center;
+      width: 96px;
+      height: 96px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.85rem;
+      font-weight: bold;
+      line-height: 1.3;
+      /* Identity transforms establish a stable stacking context before hover. */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.15;
+    }
+
+    /* Each animation owns one property so hover never replaces either one. */
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -16px 0; }
+      to { translate: 16px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation-duration: 60s, 12s;
+        transition: none;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
