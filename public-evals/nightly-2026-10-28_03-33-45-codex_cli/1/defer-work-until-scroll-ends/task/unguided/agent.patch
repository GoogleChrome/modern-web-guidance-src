+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const origins = Array.from(scroller.querySelectorAll('[data-origin]'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollTimer;
+
+    function reportVisibleOrigin() {
+      const bounds = scroller.getBoundingClientRect();
+      let mostVisible = origins[0];
+      let largestArea = -1;
+
+      // Measure only once scrolling settles, never during active scrolling.
+      for (const origin of origins) {
+        const rect = origin.getBoundingClientRect();
+        const width = Math.max(0, Math.min(rect.right, bounds.right) - Math.max(rect.left, bounds.left));
+        const height = Math.max(0, Math.min(rect.bottom, bounds.bottom) - Math.max(rect.top, bounds.top));
+        const area = width * height;
+        if (area > largestArea) {
+          largestArea = area;
+          mostVisible = origin;
+        }
+      }
+
+      scrolling = false;
+      status.textContent = `Scroll ended. Visible: ${mostVisible.dataset.origin}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      // Older browsers use a debounce; modern browsers signal completion directly.
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(reportVisibleOrigin, 180);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', reportVisibleOrigin);
+    }
+  </script>
