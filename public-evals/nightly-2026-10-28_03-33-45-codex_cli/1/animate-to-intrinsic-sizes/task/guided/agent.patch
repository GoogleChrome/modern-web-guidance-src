+    /* Keep padding inside the animated boxes so they collapse fully to zero. */
+    #promo-alert {
+      position: static;
+      width: 100%;
+      max-width: none;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      color: var(--text);
+      background: var(--accent);
+      block-size: 0;
+      overflow: hidden;
+      opacity: 0;
+    }
+
+    #promo-alert[open] {
+      block-size: auto;
+      opacity: 1;
+    }
+
+    .promo-inner {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 20px;
+      padding: 12px 5%;
+      text-align: center;
+    }
+
+    #alert-dismiss {
+      display: grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      border: 1px solid currentColor;
+      border-radius: 50%;
+      color: inherit;
+      background: transparent;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .faq {
+      margin-top: 48px;
+    }
+
+    .faq h2 {
+      margin-bottom: 20px;
+      text-align: center;
+    }
+
+    .faq details {
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    /* Summary provides native button behavior and expanded-state semantics. */
+    #faq-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      padding: 20px;
+      list-style: none;
+      font-weight: 600;
+      cursor: pointer;
+    }
+
+    #faq-trigger::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger::after {
+      content: '';
+      flex-shrink: 0;
+      width: 9px;
+      height: 9px;
+      border-right: 2px solid currentColor;
+      border-bottom: 2px solid currentColor;
+      transform: rotate(45deg);
+      transition: transform 0.35s ease;
+    }
+
+    details[open] > #faq-trigger::after {
+      transform: rotate(225deg);
+    }
+
+    #faq-content {
+      padding: 0 20px 20px;
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    /* Unsupported browsers retain the native instant open/close behavior. */
+    @supports (interpolate-size: allow-keywords) {
+      #promo-alert,
+      .faq details {
+        interpolate-size: allow-keywords;
+      }
+
+      #promo-alert {
+        transition: block-size 0.35s ease, opacity 0.35s ease,
+          display 0.35s allow-discrete;
+      }
+
+      .faq details::details-content {
+        block-size: 0;
+        overflow: hidden;
+        transition: block-size 0.35s ease,
+          content-visibility 0.35s allow-discrete;
+      }
+
+      .faq details[open]::details-content {
+        block-size: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      .faq details::details-content,
+      #faq-trigger::after {
+        transition: none;
+      }
+    }
   </style>
