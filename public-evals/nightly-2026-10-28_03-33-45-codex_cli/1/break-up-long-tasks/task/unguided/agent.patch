+  <script>
+    (() => {
+      const form = document.getElementById('simulation-form');
+      const targetSelect = document.getElementById('flavor-target');
+      const batchSelect = document.getElementById('batch-size');
+      const runButton = document.getElementById('run-simulation');
+      const cancelButton = document.getElementById('cancel-simulation');
+      const output = document.getElementById('simulation-output');
+      const progress = document.getElementById('simulation-progress');
+      const count = document.getElementById('simulation-count');
+      const status = document.getElementById('simulation-status');
+      const results = document.getElementById('simulation-results');
+      const dimensions = ['acidity', 'sweetness', 'body'];
+      const targets = { balanced: [5, 7, 6], bright: [8, 6, 4], bold: [3, 6, 9] };
+      const format = new Intl.NumberFormat('en-US');
+      let activeRun = null;
+
+      // A real task boundary lets input and rendering run; a resolved Promise does not.
+      async function yieldToMain() {
+        if (globalThis.scheduler && typeof globalThis.scheduler.yield === 'function') {
+          await globalThis.scheduler.yield();
+        } else {
+          await new Promise(resolve => setTimeout(resolve, 0));
+        }
+      }
+
+      function simulateRecipe(index) {
+        // A seeded generator keeps each exploration reproducible.
+        let seed = index + 1;
+        const random = () => {
+          seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+          return seed / 4294967296;
+        };
+        const shares = [random() + 0.05, random() + 0.05, random() + 0.05];
+        const total = shares.reduce((sum, value) => sum + value, 0);
+        const weights = shares.map(value => value / total);
+        const roast = Math.floor(random() * 3);
+        const temperature = 88 + Math.floor(random() * 9);
+        const beans = [[4, 8, 8], [6, 7, 6], [9, 6, 4]];
+        const profile = [0, 0, 0];
+        // Integrate extraction over 64 stages for each candidate recipe.
+        for (let stage = 1; stage <= 64; stage++) {
+          const extraction = 1 - Math.exp(-stage / (18 + (96 - temperature)));
+          for (let axis = 0; axis < 3; axis++) {
+            profile[axis] += weights.reduce((sum, weight, bean) => sum + weight * beans[bean][axis], 0) * extraction / 64;
+          }
+        }
+        const adjusted = [profile[0] + 1.5 - roast * 1.4, profile[1] + 1.6 - Math.abs(roast - 1) * 0.5, profile[2] + 1 + roast * 1.1];
+        return { weights, roast, temperature, profile: adjusted.map(value => Math.max(0, Math.min(10, value))) };
+      }
+
+      function renderResults(best, partial) {
+        results.replaceChildren();
+        const heading = document.createElement('h3');
+        heading.textContent = partial ? 'Closest matches so far' : 'Your closest matches';
+        results.append(heading);
+        for (const [index, recipe] of best.entries()) {
+          const item = document.createElement('div');
+          item.className = 'blend-result';
+          const title = document.createElement('strong');
+          title.textContent = `${index + 1}. ${['Light', 'Medium', 'Dark'][recipe.roast]} roast · ${recipe.temperature}°C · ${recipe.score.toFixed(1)}% match`;
+          const description = document.createElement('p');
+          const brazil = Math.round(recipe.weights[0] * 100);
+          const colombia = Math.round(recipe.weights[1] * 100);
+          description.textContent = `Brazil ${brazil}% / Colombia ${colombia}% / Ethiopia ${100 - brazil - colombia}%`;
+          const notes = document.createElement('p');
+          notes.textContent = recipe.profile.map((value, axis) => `${dimensions[axis]} ${value.toFixed(1)}`).join(' · ');
+          item.append(title, description, notes);
+          results.append(item);
+        }
+      }
+
+      batchSelect.addEventListener('change', () => {
+        progress.max = Number(batchSelect.value);
+        progress.value = 0;
+        count.textContent = `0 / ${format.format(Number(batchSelect.value))}`;
+      });
+      cancelButton.addEventListener('click', () => {
+        if (activeRun) activeRun.cancelled = true;
+      });
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (activeRun) return;
+        const run = { cancelled: false };
+        activeRun = run;
+        const total = Number(batchSelect.value);
+        const target = targets[targetSelect.value];
+        const sums = [0, 0, 0];
+        const best = [];
+        let processed = 0;
+        runButton.disabled = targetSelect.disabled = batchSelect.disabled = true;
+        cancelButton.disabled = false;
+        output.setAttribute('aria-busy', 'true');
+        progress.max = total;
+        progress.value = 0;
+        count.textContent = `0 / ${format.format(total)}`;
+        status.textContent = 'Exploring your blends…';
+        results.replaceChildren();
+        dimensions.forEach(name => {
+          document.getElementById(`${name}-bar`).style.width = '0%';
+          document.getElementById(`${name}-value`).textContent = '—';
+        });
+        try {
+          await yieldToMain();
+          while (processed < total && !run.cancelled) {
+            const sliceStart = performance.now();
+            let sliceCount = 0;
+            // Bound each slice by both time and count, including on slower devices.
+            while (processed < total && sliceCount < 150 && performance.now() - sliceStart < 8) {
+              const recipe = simulateRecipe(processed);
+              const distance = Math.hypot(...recipe.profile.map((value, axis) => value - target[axis]));
+              recipe.score = Math.max(0, 100 - distance / Math.sqrt(300) * 100);
+              recipe.profile.forEach((value, axis) => { sums[axis] += value; });
+              if (best.length < 3 || recipe.score > best[best.length - 1].score) {
+                best.push(recipe);
+                best.sort((a, b) => b.score - a.score);
+                best.length = Math.min(3, best.length);
+              }
+              processed++;
+              sliceCount++;
+            }
+            progress.value = processed;
+            count.textContent = `${format.format(processed)} / ${format.format(total)}`;
+            dimensions.forEach((name, axis) => {
+              const average = sums[axis] / processed;
+              document.getElementById(`${name}-bar`).style.width = `${average * 10}%`;
+              document.getElementById(`${name}-value`).textContent = average.toFixed(1);
+            });
+            await yieldToMain();
+          }
+          renderResults(best, run.cancelled);
+          status.textContent = run.cancelled
+            ? `Stopped after ${format.format(processed)} recipes. You can start a fresh exploration.`
+            : `Tasting complete. ${format.format(total)} recipes explored. Average profile shown above.`;
+        } catch (error) {
+          status.textContent = 'The exploration was interrupted. Please try again.';
+          console.error('Blend simulation failed:', error);
+        } finally {
+          activeRun = null;
+          runButton.disabled = targetSelect.disabled = batchSelect.disabled = false;
+          cancelButton.disabled = true;
+          output.setAttribute('aria-busy', 'false');
+        }
+      });
+    })();
+  </script>
 </body>
 
