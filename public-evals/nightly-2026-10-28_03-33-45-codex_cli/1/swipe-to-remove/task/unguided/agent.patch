+  <script>
+    const cart = document.querySelector('.SwipeableList');
+    const cartStatus = document.querySelector('.cart-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const name = item.querySelector('h3').textContent;
+      const hadFocus = item.contains(document.activeElement);
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-ready', 'is-removing');
+      item.querySelector('button').disabled = true;
+
+      requestAnimationFrame(() => {
+        content.style.transform = `translateX(${direction * 100}%)`;
+        requestAnimationFrame(() => {
+          item.style.height = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.opacity = '0';
+        });
+      });
+
+      window.setTimeout(() => {
+        const nextButton = item.nextElementSibling?.querySelector('button:not(:disabled)')
+          || item.previousElementSibling?.querySelector('button:not(:disabled)');
+        item.remove();
+        const count = cart.children.length;
+        cartStatus.textContent = `${name} removed. ${count ? `${count} item${count === 1 ? '' : 's'} in your cart.` : 'Your cart is empty.'}`;
+        if (hadFocus) {
+          if (nextButton) nextButton.focus();
+          else {
+            const heading = document.querySelector('#cart-heading');
+            heading.tabIndex = -1;
+            heading.focus();
+          }
+        }
+      }, reducedMotion.matches ? 0 : 320);
+    }
+
+    cart.querySelectorAll('.SwipeableList-item').forEach((item) => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(100, content.clientWidth * 0.3);
+
+      function resetGesture() {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      }
+
+      content.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, delta: 0, horizontal: false };
+        content.setPointerCapture(event.pointerId);
+      });
+
+      content.addEventListener('pointermove', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            resetGesture();
+            return;
+          }
+          if (Math.abs(dx) < 8) return;
+          gesture.horizontal = true;
+          item.classList.add('is-dragging');
+        }
+        gesture.delta = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+
+      content.addEventListener('pointerup', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const { delta, horizontal } = gesture;
+        gesture = null;
+        if (horizontal && Math.abs(delta) >= threshold()) removeItem(item, Math.sign(delta));
+        else resetGesture();
+      });
+
+      content.addEventListener('pointercancel', resetGesture);
+      content.addEventListener('lostpointercapture', () => {
+        if (gesture) resetGesture();
+      });
+      item.querySelector('button').addEventListener('click', () => removeItem(item));
+    });
+  </script>
