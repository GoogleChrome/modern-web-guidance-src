+  <script>
+    (() => {
+      function detectInitialBackgroundState() {
+        if (
+          typeof PerformanceObserver !== 'undefined' &&
+          PerformanceObserver.supportedEntryTypes?.includes('visibility-state')
+        ) {
+          const entries = performance.getEntriesByType('visibility-state');
+          const initialEntry = entries.find((entry) => entry.startTime === 0);
+
+          if (initialEntry) {
+            const firstHiddenEntry = entries.find((entry) => entry.name === 'hidden');
+            return {
+              initiallyBackgrounded: initialEntry.name === 'hidden',
+              // Browser-recorded milliseconds relative to performance.timeOrigin.
+              // Zero means hidden at load; null means no hidden entry so far.
+              timeBackgrounded: firstHiddenEntry?.startTime ?? null,
+              fallbackActive: false,
+            };
+          }
+        }
+
+        // LEGACY FALLBACK: potentially unreliable, especially for async scripts.
+        // This reads the current state and cannot reconstruct earlier transitions.
+        // If hidden now, time 0 is only an estimate, not an exact timestamp.
+        const hiddenNow = document.visibilityState === 'hidden';
+        console.warn(
+          'Background detection fallback active: initial visibility and timing are estimates; async scripts may miss earlier visibility changes.'
+        );
+        return {
+          initiallyBackgrounded: hiddenNow,
+          timeBackgrounded: hiddenNow ? 0 : null,
+          fallbackActive: true,
+        };
+      }
+
+      // One snapshot at script execution; browser timer precision limits apply.
+      console.log(detectInitialBackgroundState());
+    })();
+  </script>
