+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { PassThrough } = require('node:stream');
+const { securityHeaders, allowsRequest, receiveReports, summarizeReports } = require('../security');
+const { createRequestHandler } = require('../request-handler');
+
+// In-memory requests only: never import server.js or create/listen on a server.
+function request(handler, { url = '/', method = 'GET', headers = {}, body = '' } = {}) {
+  return new Promise((resolve, reject) => {
+    const req = new PassThrough();
+    Object.assign(req, { url, method, headers });
+    const responseHeaders = {};
+    const res = {
+      setHeader(name, value) { responseHeaders[name.toLowerCase()] = value; },
+      writeHead(status, extra = {}) {
+        this.status = status;
+        for (const [name, value] of Object.entries(extra)) this.setHeader(name, value);
+      },
+      end(data) {
+        resolve({ status: this.status, headers: responseHeaders, body: data?.toString() || '' });
+      },
+    };
+    try {
+      handler(req, res);
+      req.end(body);
+    } catch (error) { reject(error); }
+  });
+}
+
+test('CSP enforces no scripts or DOM injection policies without unsafe allowances', () => {
+  const headers = securityHeaders();
+  const csp = headers['Content-Security-Policy'];
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "object-src 'none'", "base-uri 'none'", "form-action 'self'", "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'", "trusted-types 'none'", 'report-to csp',
+    'report-uri /security-reports']) assert.ok(csp.split('; ').includes(directive), directive);
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|\*/);
+  assert.equal(headers['Reporting-Endpoints'], 'csp="/security-reports"');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'SAMEORIGIN');
+  assert.equal(headers['Cross-Origin-Opener-Policy'], 'same-origin-allow-popups');
+  assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.equal(headers['Referrer-Policy'], 'strict-origin-when-cross-origin');
+  assert.match(headers['Permissions-Policy'], /camera=\(\).*microphone=\(\).*geolocation=\(\)/);
+  assert.equal(headers['Cross-Origin-Embedder-Policy'], undefined);
+});
+
+test('report-only rollout and short HSTS are explicit deployment options', () => {
+  const defaults = securityHeaders();
+  assert.equal(defaults['Strict-Transport-Security'], undefined);
+  const staged = securityHeaders({ reportOnly: true, https: true });
+  assert.equal(staged['Content-Security-Policy'], undefined);
+  assert.equal(staged['Content-Security-Policy-Report-Only'], defaults['Content-Security-Policy']);
+  assert.equal(staged['Strict-Transport-Security'], 'max-age=300');
+  assert.equal(staged['X-Frame-Options'], 'SAMEORIGIN');
+});
+
+test('markup and CSS fit the enforced policy', () => {
+  const html = fs.readFileSync(path.join(__dirname, '../index.html'), 'utf8');
+  const css = fs.readFileSync(path.join(__dirname, '../styles.css'), 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:|<base\b/i);
+  assert.match(html, /<link rel="stylesheet" href="\/styles.css">/);
+  assert.match(html, /<form action="\/logout" method="post">/);
+  const policy = securityHeaders()['Content-Security-Policy'];
+  for (const [, url] of css.matchAll(/url\(['"]?(https:[^'")]+)['"]?\)/g)) {
+    assert.ok(policy.split('; ').find(d => d.startsWith('img-src ')).split(' ').includes(new URL(url).origin));
+  }
+  assert.doesNotMatch(css, /@import|expression\s*\(|javascript:/i);
+});
