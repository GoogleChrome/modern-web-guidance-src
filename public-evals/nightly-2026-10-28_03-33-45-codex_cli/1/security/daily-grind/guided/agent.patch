--- /dev/null
+++ b/security.js
@@ -0,0 +1,112 @@
+const CSP = [
+  "default-src 'none'",
+  // No application scripts exist: do not authorize any script, inline or external.
+  "script-src 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'self'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+  'report-to csp',
+  'report-uri /security-reports',
+].join('; ');
+
+function securityHeaders({ reportOnly = false, https = false } = {}) {
+  return {
+    [reportOnly ? 'Content-Security-Policy-Report-Only' : 'Content-Security-Policy']: CSP,
+    'Reporting-Endpoints': 'csp="/security-reports"',
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+    // Explicit deployment opt-in; never trust arbitrary X-Forwarded-Proto values.
+    ...(https ? { 'Strict-Transport-Security': 'max-age=300' } : {}),
+  };
+}
+
+function allowsRequest(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (!site || site === 'same-origin' || site === 'none') return true;
+  // Same-site subdomains are not automatically trusted. Public top-level links work.
+  return ['GET', 'HEAD'].includes(req.method)
+    && req.headers['sec-fetch-mode'] === 'navigate'
+    && req.headers['sec-fetch-dest'] === 'document';
+}
+
+const MAX_REPORT_BYTES = 16 * 1024;
+const DIRECTIVES = new Set([
+  'default-src', 'script-src', 'script-src-elem', 'script-src-attr',
+  'style-src', 'style-src-elem', 'style-src-attr', 'img-src', 'font-src',
+  'connect-src', 'object-src', 'base-uri', 'form-action', 'frame-ancestors',
+  'frame-src', 'worker-src', 'media-src', 'manifest-src',
+  'require-trusted-types-for', 'trusted-types',
+]);
+
+// Store only fixed vocabulary counts: never URLs, samples, cookies, or raw bodies.
+function summarizeReports(payload) {
+  const reports = Array.isArray(payload)
+    ? payload.filter(report => report?.type === 'csp-violation').map(report => report.body)
+    : [payload?.['csp-report']];
+  if (reports.length === 0 || reports.length > 100) return null;
+  const counts = {};
+  for (const report of reports) {
+    if (!report || typeof report !== 'object') return null;
+    const directive = report.effectiveDirective ?? report['effective-directive'];
+    if (!DIRECTIVES.has(directive)) continue;
+    const disposition = report.disposition === 'report' ? 'report' : 'enforce';
+    const key = `${disposition}:${directive}`;
+    counts[key] = (counts[key] || 0) + 1;
+  }
+  return counts;
+}
+
+function receiveReports(req, res, log = console.info) {
+  const contentType = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  if (!['application/csp-report', 'application/reports+json'].includes(contentType)) {
+    res.writeHead(415);
+    res.end();
+    req.resume();
+    return;
+  }
+
+  let bytes = 0;
+  let chunks = [];
+  let finished = false;
+  const finish = status => {
+    if (finished) return;
+    finished = true;
+    chunks = [];
+    res.writeHead(status);
+    res.end();
+  };
+  req.on('data', chunk => {
+    if (finished) return;
+    bytes += chunk.length;
+    if (bytes > MAX_REPORT_BYTES) return finish(413);
+    chunks.push(chunk);
+  });
+  req.on('end', () => {
+    if (finished) return;
+    let summary;
+    try {
+      summary = summarizeReports(JSON.parse(Buffer.concat(chunks).toString('utf8')));
+    } catch {
+      return finish(400);
+    }
+    if (!summary) return finish(400);
+    if (Object.keys(summary).length) log('CSP violation counts', summary);
+    finish(204);
+  });
+  req.on('error', () => finish(400));
+  req.on('aborted', () => finish(400));
+}
+
+module.exports = { securityHeaders, allowsRequest, receiveReports, summarizeReports };
