+test('both reporting formats produce only allowlisted counts', async () => {
+  const logs = [];
+  const handler = (req, res) => receiveReports(req, res, (...args) => logs.push(args));
+  const legacy = { 'csp-report': {
+    'effective-directive': 'script-src-elem', disposition: 'enforce',
+    'document-uri': 'https://example.com/?secret=123', 'script-sample': 'private content',
+  } };
+  const modern = [{ type: 'csp-violation', url: 'https://example.com/?token=123', body: {
+    effectiveDirective: 'trusted-types', disposition: 'report', sample: 'private content',
+  } }];
+  for (const [type, payload] of [['application/csp-report', legacy], ['application/reports+json', modern]]) {
+    const res = await request(handler, { headers: { 'content-type': `${type}; charset=utf-8` }, body: JSON.stringify(payload) });
+    assert.equal(res.status, 204);
+  }
+  assert.deepEqual(logs, [
+    ['CSP violation counts', { 'enforce:script-src-elem': 1 }],
+    ['CSP violation counts', { 'report:trusted-types': 1 }],
+  ]);
+  assert.doesNotMatch(JSON.stringify(logs), /secret|token|private|https:/);
+  assert.deepEqual(summarizeReports({ 'csp-report': { 'effective-directive': '__proto__' } }), {});
+});
