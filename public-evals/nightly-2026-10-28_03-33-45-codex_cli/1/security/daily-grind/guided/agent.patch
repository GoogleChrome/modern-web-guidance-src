+test('Fetch Metadata blocks foreign subresources and POSTs while retaining public links', () => {
+  for (const site of ['same-origin', 'none', undefined]) {
+    assert.equal(allowsRequest({ method: 'POST', headers: { 'sec-fetch-site': site } }), true);
+  }
+  for (const site of ['cross-site', 'same-site']) {
+    assert.equal(allowsRequest({ method: 'POST', headers: { 'sec-fetch-site': site } }), false);
+    assert.equal(allowsRequest({ method: 'GET', headers: { 'sec-fetch-site': site } }), false);
+    assert.equal(allowsRequest({ method: 'GET', headers: {
+      'sec-fetch-site': site, 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document',
+    } }), true);
+    assert.equal(allowsRequest({ method: 'GET', headers: {
+      'sec-fetch-site': site, 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'object',
+    } }), false);
+  }
+});
