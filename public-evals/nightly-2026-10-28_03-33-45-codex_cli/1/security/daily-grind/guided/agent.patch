+test('documents, deep links, and stylesheet have correct types and security headers', async () => {
+  const handler = createRequestHandler();
+  for (const url of ['/', '/menu/seasonal', '/styles.css', '/server.js', '/../../security.js']) {
+    const res = await request(handler, { url });
+    assert.equal(res.status, 200);
+    assert.ok(res.headers['content-security-policy']);
+    assert.match(res.headers.vary, /Sec-Fetch-Site/);
+    assert.equal(res.headers['cache-control'], 'no-store');
+    assert.equal(res.headers['content-type'], url === '/styles.css' ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    assert.match(res.body, url === '/styles.css' ? /:root/ : /<!DOCTYPE html>/);
+  }
+  const head = await request(handler, { method: 'HEAD', url: '/styles.css' });
+  assert.equal(head.status, 200);
+  assert.equal(head.body, '');
+});
+
+test('logout requires POST, clears browser data, and rejects cross-site forms', async () => {
+  const handler = createRequestHandler();
+  const get = await request(handler, { url: '/logout' });
+  assert.equal(get.status, 405);
+  assert.equal(get.headers.allow, 'POST');
+  assert.equal(get.headers['clear-site-data'], undefined);
+  const post = await request(handler, { url: '/logout/', method: 'POST', headers: { 'sec-fetch-site': 'same-origin' } });
+  assert.equal(post.status, 200);
+  assert.equal(post.headers['clear-site-data'], '"cookies", "storage", "cache"');
+  const foreign = await request(handler, { url: '/logout', method: 'POST', headers: { 'sec-fetch-site': 'cross-site' } });
+  assert.equal(foreign.status, 403);
+  assert.equal(foreign.headers['clear-site-data'], undefined);
+  assert.ok(foreign.headers['content-security-policy']);
+});
+
+test('logout falls back to exact Origin checks when Fetch Metadata is unavailable', async () => {
+  const handler = createRequestHandler({ https: true });
+  for (const [headers, expected] of [
+    [{ host: 'coffee.example', origin: 'https://coffee.example' }, 200],
+    [{ host: 'coffee.example', origin: 'https://evil.example' }, 403],
+    [{ host: 'coffee.example', origin: 'http://coffee.example' }, 403],
+    [{ host: 'coffee.example', origin: 'null' }, 403],
+    [{ host: 'coffee.example' }, 403],
+    [{ host: 'coffee.example', origin: 'https://evil.example', 'sec-fetch-site': 'same-origin' }, 403],
+  ]) {
+    const res = await request(handler, { url: '/logout', method: 'POST', headers });
+    assert.equal(res.status, expected);
+  }
+});
