+test('reports reject oversized, malformed, wrong-type and excessive batches without logging', async () => {
+  const logs = [];
+  const handler = (req, res) => receiveReports(req, res, (...args) => logs.push(args));
+  for (const [body, contentType, status] of [
+    ['x'.repeat(16385), 'application/csp-report', 413],
+    ['{', 'application/csp-report', 400],
+    ['null', 'application/csp-report', 400],
+    ['{}', 'text/plain', 415],
+    [JSON.stringify(Array.from({ length: 101 }, () => ({ type: 'csp-violation', body: {} }))), 'application/reports+json', 400],
+  ]) {
+    const res = await request(handler, { body, headers: { 'content-type': contentType } });
+    assert.equal(res.status, status);
+  }
+  assert.deepEqual(logs, []);
+});
