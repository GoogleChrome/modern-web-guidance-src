@@ -0,0 +1,61 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const { securityHeaders, allowsRequest, receiveReports } = require('./security');
+
+// Importable for offline checks; this module never opens a listening socket.
+function createRequestHandler(options = {}) {
+  const headers = securityHeaders(options);
+  return (req, res) => {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    res.setHeader('Cache-Control', 'no-store');
+
+    const end = (status, message, extraHeaders = {}) => {
+      res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8', ...extraHeaders });
+      res.end(req.method === 'HEAD' ? undefined : message);
+    };
+
+    let pathname;
+    try {
+      // No Host-header interpolation, filesystem paths, or reflected request values.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return end(400, 'Bad request');
+    }
+
+    // Reports can be delivered without Fetch Metadata by the browser's reporting service.
+    if (pathname === '/security-reports') {
+      if (req.method !== 'POST') return end(405, 'Method not allowed', { Allow: 'POST' });
+      return receiveReports(req, res);
+    }
+
+    if (!allowsRequest(req)) return end(403, 'Forbidden');
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      if (req.method !== 'POST') return end(405, 'Method not allowed', { Allow: 'POST' });
+      const origin = req.headers.origin;
+      const scheme = options.https || req.socket?.encrypted ? 'https' : 'http';
+      const sameOrigin = origin
+        ? Boolean(req.headers.host) && origin === `${scheme}://${req.headers.host}`
+        : req.headers['sec-fetch-site'] === 'same-origin';
+      if (!sameOrigin) return end(403, 'Forbidden');
+      return end(200, 'Logged out', { 'Clear-Site-Data': '"cookies", "storage", "cache"' });
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      return end(405, 'Method not allowed', { Allow: 'GET, HEAD' });
+    }
+
+    // Fixed mapping: never expose server source, policy code, or arbitrary files.
+    const stylesheet = pathname === '/styles.css';
+    const filePath = path.join(__dirname, stylesheet ? 'styles.css' : 'index.html');
+    fs.readFile(filePath, (err, data) => {
+      if (err) return end(500, 'Server error');
+      res.writeHead(200, {
+        'Content-Type': stylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8',
+      });
+      res.end(req.method === 'HEAD' ? undefined : data);
+    });
+  };
+}
+
+module.exports = { createRequestHandler };
