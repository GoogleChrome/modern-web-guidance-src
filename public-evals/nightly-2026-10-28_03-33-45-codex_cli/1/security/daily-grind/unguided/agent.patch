+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders } = require('./security');
+
+// This module does not open a socket, so response behavior can be tested offline.
+function createRequestHandler({ mode = 'report-only', root = __dirname } = {}) {
+  const headers = securityHeaders(mode);
+
+  return async function handleRequest(req, res) {
+    for (const [name, value] of Object.entries(headers)) {
+      res.setHeader(name, value);
+    }
+
+    function send(status, type, body) {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'text/plain; charset=utf-8', 'Method not allowed');
+      return;
+    }
+
+    let pathname;
+    try {
+      // Do not trust the Host header as a URL parsing base.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'text/plain; charset=utf-8', 'Bad request');
+      return;
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      res.setHeader('Cache-Control', 'no-store');
+      send(200, 'text/plain; charset=utf-8', 'Logged out');
+      return;
+    }
+
+    const stylesheet = pathname === '/styles.css';
+    // Preserve the existing page routes, but never serve HTML as a missing asset.
+    if (!stylesheet && (pathname.includes('.') || pathname.startsWith('/assets/'))) {
+      send(404, 'text/plain; charset=utf-8', 'Not found');
+      return;
+    }
+
+    try {
+      // Only fixed filenames reach the filesystem, never request-controlled paths.
+      const body = await fs.readFile(path.join(root, stylesheet ? 'styles.css' : 'index.html'));
+      send(200, stylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8', body);
+    } catch {
+      send(500, 'text/plain; charset=utf-8', 'Server error');
+    }
+  };
+}
+
+module.exports = { createRequestHandler };
