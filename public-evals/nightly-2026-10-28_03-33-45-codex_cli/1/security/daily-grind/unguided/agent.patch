new file mode 100644
index 0000000..d11134f
--- /dev/null
+++ b/security.js
@@ -0,0 +1,40 @@
+// Start in observation mode; promote the same policy after reviewing violations.
+const policy = [
+  "default-src 'none'",
+  "script-src 'none'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'none'",
+  "font-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'none'",
+  "frame-ancestors 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+].join('; ');
+
+function securityHeaders(mode = 'report-only') {
+  if (!['report-only', 'enforce'].includes(mode)) {
+    throw new Error('SECURITY_POLICY_MODE must be report-only or enforce');
+  }
+
+  const headers = {
+    'Content-Security-Policy': mode === 'enforce'
+      ? policy
+      : "object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+  };
+
+  if (mode === 'report-only') {
+    headers['Content-Security-Policy-Report-Only'] = policy;
+  }
+  return headers;
+}
+
+module.exports = { policy, securityHeaders };
diff --git a/security.test.js b/security.test.js
new file mode 100644
index 0000000..f0d816e
--- /dev/null
+++ b/security.test.js
@@ -0,0 +1,86 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const { createRequestHandler } = require('./app');
+const { policy, securityHeaders } = require('./security');
+
+async function request(url = '/', { method = 'GET', mode, root } = {}) {
+  const response = {
+    headers: {},
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      for (const [name, value] of Object.entries(headers)) this.setHeader(name, value);
+    },
+    end(body) { this.body = body?.toString(); },
+  };
+  await createRequestHandler({ mode, root })({ url, method, headers: { host: '[invalid' } }, response);
+  return response;
+}
+
+test('rollout observes the candidate while enforcing embedding and base restrictions', () => {
+  const headers = securityHeaders();
+  assert.equal(headers['Content-Security-Policy-Report-Only'], policy);
+  assert.equal(headers['Content-Security-Policy'], "object-src 'none'; base-uri 'none'; frame-ancestors 'none'");
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['Referrer-Policy'], 'strict-origin-when-cross-origin');
+  assert.match(headers['Permissions-Policy'], /camera=\(\)/);
+});
+
+test('promotion enforces the exact candidate and rejects invalid configuration', () => {
+  const headers = securityHeaders('enforce');
+  assert.equal(headers['Content-Security-Policy'], policy);
+  assert.equal(headers['Content-Security-Policy-Report-Only'], undefined);
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'", "style-src-attr 'none'", "img-src 'self' https://images.unsplash.com", "form-action 'none'", "require-trusted-types-for 'script'", "trusted-types 'none'"]) {
+    assert.ok(policy.split('; ').includes(directive), directive);
+  }
+  assert.doesNotMatch(policy, /unsafe-inline|unsafe-eval|\*/);
+  assert.throws(() => securityHeaders('disabled'), /SECURITY_POLICY_MODE/);
+});
+
+test('markup and stylesheet work without inline execution or style exceptions', async () => {
+  const page = await request();
+  assert.equal(page.status, 200);
+  assert.equal(page.headers['content-type'], 'text/html; charset=utf-8');
+  assert.match(page.body, /<link rel="stylesheet" href="\/styles.css">/);
+  assert.doesNotMatch(page.body, /<script\b|<style\b|\sstyle\s*=|\son[a-z]+\s*=|javascript:|<base\b/i);
+  const css = await request('/styles.css?v=1');
+  assert.equal(css.status, 200);
+  assert.equal(css.headers['content-type'], 'text/css; charset=utf-8');
+  assert.equal(css.body, await fs.readFile('styles.css', 'utf8'));
+  const origins = [...css.body.matchAll(/https:\/\/[^/'"\s)]+/g)].map(([origin]) => origin);
+  assert.deepEqual(origins, ['https://images.unsplash.com']);
+  assert.match(css.body, /\.section-title\s*\{\s*text-align: center;/);
+});
+
+test('all response paths retain headers, including errors and rejected methods', async () => {
+  for (const [url, options, status] of [
+    ['/menu/seasonal', {}, 200],
+    ['/logout', {}, 200],
+    ['/missing.js', {}, 404],
+    ['/assets/missing', {}, 404],
+    ['/%2e%2e/server.js', {}, 404],
+    ['http://[', {}, 400],
+    ['/', { method: 'POST' }, 405],
+    ['/', { root: '/nonexistent-daily-grind-test-root' }, 500],
+  ]) {
+    const response = await request(url, { ...options, mode: 'enforce' });
+    assert.equal(response.status, status, url);
+    assert.equal(response.headers['content-security-policy'], policy, url);
+    assert.equal(response.headers['x-content-type-options'], 'nosniff', url);
+    if (status !== 200) assert.doesNotMatch(response.body, /<!DOCTYPE|Error:|ENOENT/);
+    if (status === 405) assert.equal(response.headers.allow, 'GET, HEAD');
+    if (url === '/logout') assert.equal(response.headers['cache-control'], 'no-store');
+  }
+});
+
+test('HEAD returns the same security and content headers without a body', async () => {
+  for (const url of ['/', '/styles.css', '/logout', '/missing.js']) {
+    const get = await request(url);
+    const head = await request(url, { method: 'HEAD' });
+    assert.equal(head.status, get.status);
+    assert.deepEqual(head.headers, get.headers);
+    assert.equal(head.body, undefined);
+  }
+});
