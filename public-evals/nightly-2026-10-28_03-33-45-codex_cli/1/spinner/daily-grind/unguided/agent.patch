+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-link]');
+    const seasonalFavorites = document.querySelector('#seasonal-favorites');
+    const loadingStatus = document.querySelector('#loading-status');
+
+    function resetLoading() {
+      loadingLinks.forEach((link) => {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('.spinner').hidden = true;
+        link.querySelector('[data-label]').textContent = link.dataset.originalLabel;
+      });
+      seasonalFavorites.removeAttribute('aria-busy');
+      loadingStatus.textContent = '';
+    }
+
+    loadingLinks.forEach((link) => {
+      link.dataset.originalLabel = link.querySelector('[data-label]').textContent;
+      link.addEventListener('click', (event) => {
+        // Keep new-tab, download, and modified-click behavior native.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('.spinner').hidden = false;
+        link.querySelector('[data-label]').textContent = link.dataset.loadingText;
+        if (seasonalFavorites.contains(link)) seasonalFavorites.setAttribute('aria-busy', 'true');
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+    });
+
+    // Clear outgoing-page state when restored from the back/forward cache.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
