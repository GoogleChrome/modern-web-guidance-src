+  <script>
+    const loadingLinks = document.querySelectorAll('a[data-loading-label]');
+
+    loadingLinks.forEach((link) => {
+      const label = link.querySelector('.btn-label');
+      const spinner = link.querySelector('.loading-spinner');
+      const originalLabel = label.textContent;
+
+      link.addEventListener('click', (event) => {
+        // Keep modified clicks and links opened in other contexts native.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) {
+          return;
+        }
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        label.textContent = link.dataset.loadingLabel;
+        spinner.hidden = false;
+        // Let the browser navigate normally, including without JavaScript.
+      });
+
+      // Also fires when restoring the page from the back/forward cache.
+      window.addEventListener('pageshow', () => {
+        link.setAttribute('aria-busy', 'false');
+        link.removeAttribute('aria-disabled');
+        label.textContent = originalLabel;
+        spinner.hidden = true;
+      });
+    });
+  </script>
+
