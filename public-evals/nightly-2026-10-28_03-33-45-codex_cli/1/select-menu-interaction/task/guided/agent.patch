+  <script>
+    const localShop = document.getElementById('local-shop');
+
+    // Keep the accessible error state aligned with deferred native validation.
+    const syncShopValidity = () => {
+      requestAnimationFrame(() => {
+        localShop.setAttribute('aria-invalid', String(localShop.matches(':user-invalid')));
+      });
+    };
+
+    localShop.addEventListener('blur', syncShopValidity);
+    localShop.addEventListener('input', syncShopValidity);
+    localShop.addEventListener('change', syncShopValidity);
+    localShop.addEventListener('invalid', () => {
+      localShop.setAttribute('aria-invalid', 'true');
+    });
+  </script>
