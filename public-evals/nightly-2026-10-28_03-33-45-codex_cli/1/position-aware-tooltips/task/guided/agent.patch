@@ -134,8 +134,97 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .info-button {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 28px;
+      height: 28px;
+      margin: 15px 0 0 8px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+      vertical-align: baseline;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #maple-tooltip {
+      position: fixed;
+      width: 20rem;
+      max-width: calc(100vw - 2rem);
+      margin: auto;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      text-align: start;
+    }
+
+    .tooltip-content {
+      position: relative;
+      margin-block: 0 12px;
+      padding: 14px 16px;
+      border-radius: 10px 10px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 14px rgb(0 0 0 / 18%);
+      font-size: 0.9rem;
+    }
+
+    @supports (anchor-name: --maple-info) {
+      #maple-tooltip {
+        /* popovertarget supplies the implicit anchor connection. */
+        inset: auto;
+        margin: 0;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+      }
+    }
+
+    @supports (container-type: anchored) {
+      #maple-tooltip {
+        container-type: anchored;
+      }
+
+      .tooltip-content::before {
+        content: "";
+        position: absolute;
+        inset-inline-start: calc(50% - 7px);
+        inset-block-end: -7px;
+        border-style: solid;
+        border-width: 7px 7px 0;
+        border-color: var(--primary) transparent transparent;
+      }
+
+      /* Query the outer container; only its descendants can be restyled. */
+      @container anchored(fallback: flip-block) {
+        .tooltip-content {
+          margin-block: 12px 0;
+          border-radius: 4px 4px 10px 10px;
+        }
+
+        .tooltip-content::before {
+          inset-block-start: -7px;
+          inset-block-end: auto;
+          border-width: 0 7px 7px;
+          border-color: transparent transparent var(--primary);
+        }
+      }
+    }
+
     footer {
