new file mode 100644
index 0000000..e3d35b3
--- /dev/null
+++ b/coffee-finder.mjs
@@ -0,0 +1,82 @@
+const coffees = [
+  {
+    name: 'Maple Oat Latte', taste: 'creamy', temperatures: ['hot', 'iced'],
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    url: '/menu/seasonal',
+  },
+  {
+    name: 'Dark Roast Espresso', taste: 'bold', temperatures: ['hot'],
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    url: '/menu/espresso',
+  },
+  {
+    name: 'Cold Brew', taste: 'smooth', temperatures: ['iced'],
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    url: '/menu/cold-brew',
+  },
+];
+
+export function findCoffee({ taste, temperature }) {
+  if (!['bold', 'creamy', 'smooth'].includes(taste) ||
+      !['hot', 'iced', 'either'].includes(temperature)) {
+    throw new Error('Choose a taste and a serving temperature from the available options.');
+  }
+  const matches = coffees
+    .filter(coffee => temperature === 'either' || coffee.temperatures.includes(temperature))
+    .sort((a, b) => Number(b.taste === taste) - Number(a.taste === taste))
+    .map(coffee => ({ ...coffee, temperatures: [...coffee.temperatures], matchesTaste: coffee.taste === taste }));
+  const recommendation = matches[0];
+  const reason = recommendation.matchesTaste
+    ? 'A match for your taste and temperature preferences.'
+    : `Your preferred taste isn't available ${temperature}. Here's an alternative that matches your temperature.`;
+  return { status: 'success', preferences: { taste, temperature }, recommendation, alternatives: matches.slice(1), reason };
+}
+
+export function attachCoffeeFinder(form, output) {
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    let result;
+    if (!form.reportValidity()) {
+      result = { status: 'error', message: 'Choose a taste and serving temperature before finding a coffee.' };
+    } else {
+      try {
+        result = findCoffee(Object.fromEntries(new FormData(form)));
+      } catch (error) {
+        result = { status: 'error', message: error.message };
+      }
+    }
+    const document = output.ownerDocument;
+    output.replaceChildren();
+    output.className = 'finder-result';
+    if (result.status === 'success') {
+      const heading = document.createElement('h3');
+      heading.textContent = `Your match: ${result.recommendation.name}`;
+      const description = document.createElement('p');
+      description.textContent = result.recommendation.description;
+      const reason = document.createElement('p');
+      reason.textContent = result.reason;
+      const link = document.createElement('a');
+      link.href = result.recommendation.url;
+      link.textContent = 'Explore this coffee →';
+      output.append(heading, description, reason, link);
+      if (result.alternatives.length) {
+        const alternatives = document.createElement('p');
+        alternatives.className = 'finder-note';
+        alternatives.textContent = `Also worth a sip: ${result.alternatives.map(coffee => coffee.name).join(', ')}.`;
+        output.append(alternatives);
+      }
+    } else {
+      output.textContent = result.message;
+    }
+    // WebMCP extends SubmitEvent; ordinary browsers use the same visible flow.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(result));
+    }
+  });
+}
+
+if (typeof document !== 'undefined') {
+  const form = document.getElementById('coffee-finder-form');
+  const output = document.getElementById('coffee-result');
+  if (form && output) attachCoffeeFinder(form, output);
+}
diff --git a/coffee-finder.test.mjs b/coffee-finder.test.mjs
new file mode 100644
index 0000000..e914c61
--- /dev/null
+++ b/coffee-finder.test.mjs
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { findCoffee, attachCoffeeFinder } from './coffee-finder.mjs';
+
+test('every taste and temperature returns a compatible recommendation', () => {
+  for (const taste of ['bold', 'creamy', 'smooth']) {
+    for (const temperature of ['hot', 'iced', 'either']) {
+      const result = findCoffee({ taste, temperature });
+      assert.equal(result.status, 'success');
+      for (const coffee of [result.recommendation, ...result.alternatives]) {
+        assert.ok(temperature === 'either' || coffee.temperatures.includes(temperature));
+      }
+      if (temperature === 'either') assert.equal(result.recommendation.taste, taste);
+    }
+  }
+});
+
+test('exact matches rank first, and incompatible preferences explain the fallback', () => {
+  assert.equal(findCoffee({ taste: 'creamy', temperature: 'iced' }).recommendation.name, 'Maple Oat Latte');
+  assert.equal(findCoffee({ taste: 'bold', temperature: 'hot' }).recommendation.name, 'Dark Roast Espresso');
+  assert.equal(findCoffee({ taste: 'smooth', temperature: 'iced' }).recommendation.name, 'Cold Brew');
+  const fallback = findCoffee({ taste: 'smooth', temperature: 'hot' });
+  assert.equal(fallback.recommendation.matchesTaste, false);
+  assert.match(fallback.reason, /isn't available hot/);
+});
+
+test('missing and unexpected field values fail validation', () => {
+  for (const input of [{}, { taste: 'unknown', temperature: 'hot' }, { taste: 'bold', temperature: 'warm' }]) {
+    assert.throws(() => findCoffee(input), /Choose a taste/);
+  }
+});
+
+// Lightweight DOM doubles check submission behavior without a browser or server.
+function setup(valid = true) {
+  let submit;
+  const form = {
+    reportValidity: () => valid,
+    addEventListener: (type, handler) => { assert.equal(type, 'submit'); submit = handler; },
+  };
+  const output = {
+    children: [],
+    ownerDocument: { createElement: tag => ({ tag }) },
+    replaceChildren() { this.children = []; },
+    append(...children) { this.children.push(...children); },
+  };
+  attachCoffeeFinder(form, output);
+  return { output, submit };
+}
+
+test('agent submission updates visible results and returns the same structured recommendation', async t => {
+  t.mock.method(globalThis, 'FormData', function () {
+    return new Map([['taste', 'smooth'], ['temperature', 'iced']]);
+  });
+  const { output, submit } = setup();
+  let response;
+  let prevented = false;
+  submit({
+    preventDefault: () => { prevented = true; },
+    agentInvoked: true,
+    respondWith: promise => { response = promise; },
+  });
+  assert.ok(prevented);
+  const result = await response;
+  assert.equal(result.recommendation.name, 'Cold Brew');
+  assert.equal(output.children[0].textContent, 'Your match: Cold Brew');
+  assert.equal(output.children[3].href, '/menu/cold-brew');
+});
+
+test('invalid agent submissions return an error and ordinary submissions need no WebMCP API', async () => {
+  const { output, submit } = setup(false);
+  let response;
+  submit({ preventDefault() {}, agentInvoked: true, respondWith: promise => { response = promise; } });
+  assert.equal((await response).status, 'error');
+  assert.match(output.textContent, /Choose a taste/);
+  assert.doesNotThrow(() => submit({ preventDefault() {} }));
+});
+
+test('homepage declares an automatically submittable tool and named required parameters', async () => {
+  const html = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+  assert.match(html, /<form[^>]*toolname="find_coffee"[^>]*tooldescription="[^"]+"[^>]*toolautosubmit/s);
+  for (const name of ['taste', 'temperature']) {
+    assert.match(html, new RegExp(`<select[^>]*name="${name}"[^>]*required[^>]*toolparamdescription=`));
+  }
+});
