+  <script>
+    const coffees = [
+      {
+        name: 'Maple Oat Latte', temperature: 'hot', flavor: 'sweet',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        url: '/menu/seasonal'
+      },
+      {
+        name: 'Dark Roast Espresso', temperature: 'hot', flavor: 'bold',
+        description: 'Bold, smoky, and perfect for a morning boost.',
+        url: '/menu/espresso'
+      },
+      {
+        name: 'Cold Brew', temperature: 'cold', flavor: 'smooth',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        url: '/menu/cold-brew'
+      }
+    ];
+    const finder = document.getElementById('coffee-finder-form');
+    const status = document.getElementById('finder-status');
+    const results = document.getElementById('finder-results');
+    const flavorLabels = { sweet: 'Sweet & creamy', bold: 'Bold & smoky', smooth: 'Smooth & mellow' };
+
+    function clearResults(message) {
+      results.replaceChildren();
+      results.hidden = true;
+      status.textContent = message;
+    }
+
+    finder.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Both humans and agents use the same validation and recommendation logic.
+      const reply = (value) => {
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(value));
+        }
+      };
+      const data = new FormData(finder);
+      const temperature = data.get('temperature');
+      const flavor = data.get('flavor');
+      if (!finder.checkValidity() ||
+          !['any', 'hot', 'cold'].includes(temperature) ||
+          !['any', 'sweet', 'bold', 'smooth'].includes(flavor)) {
+        const message = 'Please choose a temperature and flavor from the available options.';
+        clearResults(message);
+        finder.reportValidity();
+        reply({ error: message });
+        return;
+      }
+
+      const matches = coffees.filter((coffee) =>
+        (temperature === 'any' || coffee.temperature === temperature) &&
+        (flavor === 'any' || coffee.flavor === flavor));
+      const message = matches.length
+        ? `${matches.length} ${matches.length === 1 ? 'coffee matches' : 'coffees match'} your taste. Meet your next daily favorite.`
+        : 'No seasonal coffees match both preferences. Try another flavor or choose either temperature.';
+      clearResults(message);
+
+      for (const coffee of matches) {
+        const card = document.createElement('li');
+        card.className = 'card';
+        const notes = document.createElement('p');
+        notes.className = 'coffee-notes';
+        notes.textContent = `${coffee.temperature === 'hot' ? 'Served hot' : 'Served cold'} · ${flavorLabels[coffee.flavor]}`;
+        const title = document.createElement('h3');
+        title.textContent = coffee.name;
+        const description = document.createElement('p');
+        description.textContent = coffee.description;
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = coffee.url;
+        link.textContent = `Explore ${coffee.name}`;
+        card.append(notes, title, description, link);
+        results.append(card);
+      }
+      results.hidden = matches.length === 0;
+      // Return the same results shown on the page to a WebMCP caller.
+      reply({ preferences: { temperature, flavor }, count: matches.length, matches, message });
+    });
+
+    finder.addEventListener('change', () => {
+      clearResults('Preferences updated. Select Find My Coffee to see your matches.');
+    });
+    finder.addEventListener('reset', () => {
+      clearResults('Your next favorite is just a few choices away.');
+    });
+  </script>
