diff --git a/src/components/useAuthForm.ts b/src/components/useAuthForm.ts
new file mode 100644
index 0000000..8fd78e3
--- /dev/null
+++ b/src/components/useAuthForm.ts
@@ -0,0 +1,91 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { registerAgentTool } from '../utils/webmcp';
+
+type AuthAction = 'login' | 'register';
+
+function isCredentials(input: unknown): input is { username: string; password: string } {
+  if (!input || typeof input !== 'object') return false;
+  const value = input as Record<string, unknown>;
+  return typeof value.username === 'string' && value.username.length > 0
+    && typeof value.password === 'string' && value.password.length > 0;
+}
+
+export function useAuthForm(action: AuthAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const busy = useRef(false);
+
+  // Both form submissions and tool calls use this path, including status updates.
+  const submit = useCallback(async (input: unknown, signal?: AbortSignal) => {
+    if (busy.current) return JSON.stringify({ success: false, error: 'A submission is already in progress.' });
+    setError(null);
+    setSuccess(null);
+    if (!isCredentials(input)) {
+      const message = 'Username and password are required.';
+      setError(message);
+      return JSON.stringify({ success: false, error: message });
+    }
+
+    setUsername(input.username);
+    setPassword(input.password);
+    busy.current = true;
+    setLoading(true);
+    try {
+      const response = await fetch(`https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: input.username, password: input.password }),
+        signal,
+      });
+      const data = await response.json();
+      if (!response.ok) {
+        const message = `${action === 'login' ? 'Login' : 'Registration'} failed: ${data.error || 'Unknown error'}`;
+        setError(message);
+        return JSON.stringify({ success: false, error: message });
+      }
+
+      const message = action === 'login' ? 'Login successful!' : 'User registered successfully! You can now sign in.';
+      setSuccess(message);
+      if (action === 'register') {
+        setUsername('');
+        setPassword('');
+      }
+      // Do not expose credentials or authentication tokens in tool results.
+      return JSON.stringify({ success: true, message });
+    } catch {
+      const message = signal?.aborted ? 'Submission cancelled.' : 'An unexpected error occurred. Please try again later.';
+      setError(message);
+      return JSON.stringify({ success: false, error: message });
+    } finally {
+      busy.current = false;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => registerAgentTool({
+    name: action === 'login' ? 'sign_in' : 'sign_up',
+    description: action === 'login'
+      ? 'Sign in to The DevTools Times using an existing username and password. Updates the sign-in form and returns success or an error.'
+      : 'Create a DevTools Times account using a username and password. The password should be at least 8 characters and contain a number. Updates the sign-up form and returns success or an error.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        username: { type: 'string', minLength: 1, description: 'Account username.' },
+        password: { type: 'string', minLength: 1, description: 'Account password.' },
+      },
+      required: ['username', 'password'],
+      additionalProperties: false,
+    },
+    execute: (input, options) => submit(input, options?.signal),
+  }), [action, submit]);
+
+  const handleSubmit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    await submit({ username, password });
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..8d8f0f9
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,36 @@
+export interface AgentTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown, options?: { signal?: AbortSignal }) => Promise<string>;
+}
+
+interface ModelContext {
+  registerTool: (tool: AgentTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+/** Register only while the owning component is mounted. Unsupported browsers are a no-op. */
+export function registerAgentTool(tool: AgentTool): () => void {
+  const current = (document as Document & { modelContext?: ModelContext }).modelContext;
+  const legacy = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  const context = current ?? legacy;
+  if (!context) return () => {};
+
+  const controller = new AbortController();
+  try {
+    const registration = context.registerTool(tool, { signal: controller.signal });
+    void Promise.resolve(registration).catch(() => {
+      // Registration failure must not interrupt ordinary form interactions.
+      if (!controller.signal.aborted) console.warn(`Unable to register agent tool: ${tool.name}`);
+    });
+  } catch {
+    console.warn(`Unable to register agent tool: ${tool.name}`);
+  }
+
+  return () => {
+    controller.abort();
+    // Older navigator.modelContext implementations use explicit unregistration.
+    if (!current) context.unregisterTool?.(tool.name);
+  };
+}
diff --git a/tests/auth-tools.test.mjs b/tests/auth-tools.test.mjs
new file mode 100644
index 0000000..ae48058
--- /dev/null
+++ b/tests/auth-tools.test.mjs
@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+import { test } from 'node:test';
+
+// Run the client callbacks without a browser or a server. Hook state is captured
+// so the tests can assert the visible form status as well as the tool result.
+const reactStub = `
+  export const useCallback = fn => fn;
+  export const useRef = value => ({ current: value });
+  export const useEffect = effect => globalThis.authHarness.cleanups.push(effect());
+  export const useState = value => {
+    const state = globalThis.authHarness.state;
+    const index = state.push(value) - 1;
+    return [value, next => { state[index] = next; }];
+  };
+`;
+const moduleUrl = code => `data:text/javascript;base64,${Buffer.from(code).toString('base64')}`;
+const webmcpUrl = new URL('../src/utils/webmcp.ts', import.meta.url).href;
+const source = await readFile(new URL('../src/components/useAuthForm.ts', import.meta.url), 'utf8');
+const { useAuthForm } = await import(moduleUrl(stripTypeScriptTypes(source)
+  .replace("'react'", JSON.stringify(moduleUrl(reactStub)))
+  .replace("'../utils/webmcp'", JSON.stringify(webmcpUrl))));
+
+function mount(action, context) {
+  const harness = { state: [], cleanups: [], tools: [], options: [] };
+  globalThis.authHarness = harness;
+  globalThis.document = { modelContext: context === undefined ? {
+    registerTool(tool, options) {
+      harness.tools.push(tool);
+      harness.options.push(options);
+    },
+  } : context };
+  harness.form = useAuthForm(action);
+  return harness;
+}
+const credentials = { username: 'reader', password: 'password123' };
+
+test('sign-in tool submits credentials and updates the same form status', async () => {
+  const harness = mount('login');
+  const tool = harness.tools[0];
+  assert.equal(tool.name, 'sign_in');
+  assert.deepEqual(tool.inputSchema.required, ['username', 'password']);
+  const calls = [];
+  const previousFetch = globalThis.fetch;
+  globalThis.fetch = async (...args) => {
+    calls.push(args);
+    return { ok: true, json: async () => ({ token: 'private-token' }) };
+  };
+  try {
+    const result = await tool.execute(credentials);
+    assert.deepEqual(JSON.parse(result), { success: true, message: 'Login successful!' });
+    assert.equal(calls[0][0].endsWith('/api/login'), true);
+    assert.deepEqual(JSON.parse(calls[0][1].body), credentials);
+    assert.equal(harness.state[3], 'Login successful!');
+    assert.equal(harness.state[4], false);
+    assert.equal(result.includes('private-token'), false);
+    harness.cleanups.forEach(cleanup => cleanup());
+    assert.equal(harness.options[0].signal.aborted, true);
+  } finally { globalThis.fetch = previousFetch; }
+});
+
+test('sign-up returns API failures, resets successful forms, and rejects invalid input', async () => {
+  const harness = mount('register');
+  const tool = harness.tools[0];
+  assert.equal(tool.name, 'sign_up');
+  let requests = 0;
+  const previousFetch = globalThis.fetch;
+  globalThis.fetch = async () => {
+    requests++;
+    return { ok: requests > 1, json: async () => ({ error: 'APP_ERR_1001' }) };
+  };
+  try {
+    assert.equal(JSON.parse(await tool.execute({ username: 'reader' })).success, false);
+    assert.equal(requests, 0);
+    assert.match(JSON.parse(await tool.execute(credentials)).error, /APP_ERR_1001/);
+    assert.match(harness.state[2], /Registration failed/);
+    assert.equal(JSON.parse(await tool.execute(credentials)).success, true);
+    assert.deepEqual(harness.state.slice(0, 3), ['', '', null]);
+  } finally { globalThis.fetch = previousFetch; }
+});
+
+test('concurrent calls are rejected and network failures clear loading', async () => {
+  const harness = mount('login');
+  const tool = harness.tools[0];
+  let reject;
+  const previousFetch = globalThis.fetch;
+  globalThis.fetch = () => new Promise((_, rejectRequest) => { reject = rejectRequest; });
+  try {
+    const pending = tool.execute(credentials);
+    assert.equal(harness.state[4], true);
+    assert.match(JSON.parse(await tool.execute(credentials)).error, /already in progress/);
+    reject(new Error('offline'));
+    assert.equal(JSON.parse(await pending).success, false);
+    assert.equal(harness.state[4], false);
+  } finally { globalThis.fetch = previousFetch; }
+});
+
+test('unsupported browsers retain ordinary submission and legacy registration cleans up', async () => {
+  const harness = mount('login', null);
+  // Test the registration helper independently of the hook harness.
+  const { registerAgentTool } = await import(webmcpUrl);
+  delete document.modelContext;
+  const cleanup = registerAgentTool({ name: 'example' });
+  cleanup();
+  assert.equal(typeof harness.form.handleSubmit, 'function');
+  let removed;
+  Object.defineProperty(navigator, 'modelContext', { configurable: true, value: {
+    registerTool() {}, unregisterTool(name) { removed = name; },
+  } });
+  try {
+    registerAgentTool({ name: 'example' })();
+    assert.equal(removed, 'example');
+  } finally { delete navigator.modelContext; }
+});
