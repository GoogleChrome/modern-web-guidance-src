diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..bde57a4
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,12 @@
+// These experimental SubmitEvent members are not yet in TypeScript's DOM types.
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+};
+
+export function respondToAgent(event: Event, result: Promise<string>): void {
+  const submitEvent = event as AgentSubmitEvent;
+  if (submitEvent.agentInvoked && typeof submitEvent.respondWith === 'function') {
+    submitEvent.respondWith(result);
+  }
+}
