@@ -206,7 +268,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-error');
+    let hasInteracted = false;
+
+    function updateEmailError() {
+      const showError = hasInteracted && !email.validity.valid;
+      const message = showError
+        ? (email.validity.valueMissing ? 'Please enter your email address.' : 'Please enter a valid email address.')
+        : '';
+
+      email.setAttribute('aria-invalid', String(showError));
+      // The visible error is also the live region, so both always share one state.
+      if (emailError.textContent !== message) {
+        emailError.textContent = message;
+      }
+    }
+
+    email.addEventListener('blur', () => {
+      hasInteracted = true;
+      updateEmailError();
+    });
+
+    email.addEventListener('input', updateEmailError);
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      hasInteracted = true;
+      updateEmailError();
+      if (!email.validity.valid) {
+        email.focus();
+      }
+    });
+  </script>
+
 </body>
 
 </html>
