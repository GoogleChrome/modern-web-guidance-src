+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterAnnouncement = document.getElementById('newsletter-announcement');
+
+    function syncNewsletterError() {
+      // Match the same post-interaction state that reveals the visual error.
+      const showError = newsletterEmail.matches(':user-invalid');
+      newsletterEmail.setAttribute('aria-invalid', String(showError));
+      newsletterEmail.setAttribute('aria-describedby', showError
+        ? 'newsletter-hint newsletter-error'
+        : 'newsletter-hint');
+
+      const announcement = showError ? newsletterError.textContent : '';
+      // Avoid repeating the announcement on every keystroke while still invalid.
+      if (newsletterAnnouncement.textContent !== announcement) {
+        newsletterAnnouncement.textContent = announcement;
+      }
+    }
+
+    function syncNewsletterAfterInteraction() {
+      // Native blur, validation and reset state can settle after event dispatch.
+      requestAnimationFrame(syncNewsletterError);
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      syncNewsletterError(); // Clear immediately when a correction makes it valid.
+      syncNewsletterAfterInteraction();
+    });
+    for (const event of ['blur', 'change', 'focus', 'invalid']) {
+      newsletterEmail.addEventListener(event, syncNewsletterAfterInteraction);
+    }
+    newsletterForm.addEventListener('reset', syncNewsletterAfterInteraction);
+  </script>
+
