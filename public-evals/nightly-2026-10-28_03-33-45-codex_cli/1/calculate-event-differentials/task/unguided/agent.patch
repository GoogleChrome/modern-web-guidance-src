+  <script>
+    (() => {
+      const promotion = document.getElementById('maple-promotion');
+      const countdown = document.getElementById('promotion-countdown');
+      const elapsed = document.getElementById('promotion-elapsed');
+      const hourInMilliseconds = 60 * 60 * 1000;
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(milliseconds / hourInMilliseconds);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotion() {
+        const now = Date.now();
+        // Numeric components construct midnight in the visitor's local zone, not UTC.
+        const end = new Date(2026, 2, 1, 0, 0, 0).getTime();
+        const remaining = Math.max(0, end - now);
+        countdown.textContent = remaining > 0
+          ? `${formatDuration(remaining)} left`
+          : 'Offer ended · 0 days 0 hours left';
+
+        // A local ISO date-time (without Z or an offset) uses the visitor's zone.
+        const start = new Date(promotion.dataset.promotionStart).getTime();
+        if (!Number.isFinite(start) || start >= end) {
+          elapsed.textContent = 'Elapsed time unavailable: promotion start date not specified.';
+        } else if (now < start) {
+          countdown.textContent = 'Promotion has not started';
+          elapsed.textContent = '0 days 0 hours since the promotion started.';
+        } else {
+          elapsed.textContent = `${formatDuration(now - start)} since the promotion started.`;
+        }
+      }
+
+      updatePromotion();
+      window.addEventListener('pageshow', updatePromotion);
+    })();
+  </script>
+
