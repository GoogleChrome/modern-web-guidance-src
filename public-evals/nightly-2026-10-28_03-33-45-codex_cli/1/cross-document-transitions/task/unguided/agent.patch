   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root),
+      ::view-transition-new(root) {
+        animation-duration: 320ms;
+        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+        mix-blend-mode: normal;
+      }
+
+      html:active-view-transition-type(next) {
+        --page-exit: -12%;
+        --page-enter: 12%;
+      }
+
+      html:active-view-transition-type(previous) {
+        --page-exit: 12%;
+        --page-enter: -12%;
+      }
+
+      html:active-view-transition-type(next)::view-transition-old(root),
+      html:active-view-transition-type(previous)::view-transition-old(root) {
+        animation-name: page-out;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(root),
+      html:active-view-transition-type(previous)::view-transition-new(root) {
+        animation-name: page-in;
+      }
+
+      @keyframes page-out {
+        to { opacity: 0; transform: translateX(var(--page-exit)); }
+      }
+
+      @keyframes page-in {
+        from { opacity: 0; transform: translateX(var(--page-enter)); }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      *, *::before, *::after {
+        transition: none !important;
+      }
+    }
+
