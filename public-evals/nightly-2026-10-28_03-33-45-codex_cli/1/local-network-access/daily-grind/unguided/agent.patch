diff --git a/tests/equipment.test.cjs b/tests/equipment.test.cjs
new file mode 100644
index 0000000..cff3917
--- /dev/null
+++ b/tests/equipment.test.cjs
@@ -0,0 +1,139 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const source = readFileSync(require('node:path').join(__dirname, '../equipment.js'), 'utf8');
+
+function setup({ fetchImpl, permissionState = 'prompt', permissionsSupported = true, secure = true } = {}) {
+  const elements = new Map();
+  const calls = [];
+  const permissions = new Map();
+  const timers = new Map();
+  let timerId = 0;
+  function getElement(id) {
+    if (!elements.has(id)) elements.set(id, {
+      value: '', dataset: {}, disabled: false, handlers: {},
+      addEventListener(name, callback) { this.handlers[name] = callback; },
+      setAttribute(name, value) { this[name] = value; },
+      removeAttribute(name) { delete this[name]; },
+      focus() { this.focused = true; }
+    });
+    return elements.get(id);
+  }
+  vm.runInNewContext(source, {
+    document: { getElementById: getElement }, window: { isSecureContext: secure },
+    navigator: { permissions: { async query({ name }) {
+      if (!permissionsSupported) throw new TypeError('Unsupported permission');
+      const permission = { state: permissionState, addEventListener(_, callback) { this.change = callback; } };
+      permissions.set(name, permission);
+      return permission;
+    } } },
+    URL, AbortController, TypeError, Date,
+    setTimeout(callback) { timers.set(++timerId, callback); return timerId; },
+    clearTimeout(id) { timers.delete(id); },
+    async fetch(url, options) {
+      calls.push({ url, options });
+      return fetchImpl ? fetchImpl(url, options) : { ok: true, body: null };
+    }
+  });
+  return {
+    get: getElement, calls, permissions, timers,
+    async submit(id, url) {
+      getElement(`${id}-url`).value = url;
+      await getElement(`${id}-form`).handlers.submit({ preventDefault() {} });
+    }
+  };
+}
+const ready = () => new Promise(resolve => setImmediate(resolve));
+
+test('local and loopback checks use separate permissions and request address spaces', async () => {
+  const app = setup();
+  await ready();
+  await app.submit('brewer', 'http://192.168.1.50/status');
+  await app.submit('utility', 'http://[::1]:8765/status');
+  assert.deepEqual([...app.permissions.keys()], ['local-network', 'loopback-network']);
+  assert.deepEqual(app.calls.map(call => call.options.targetAddressSpace), ['local', 'loopback']);
+  for (const call of app.calls) {
+    assert.equal(call.options.mode, 'cors');
+    assert.equal(call.options.credentials, 'omit');
+    assert.equal(call.options.redirect, 'error');
+  }
+  assert.equal(app.get('brewer-state').dataset.state, 'connected');
+  assert.equal(app.get('utility-state').dataset.state, 'connected');
+  app.permissions.get('local-network').state = 'denied';
+  app.permissions.get('local-network').change();
+  assert.equal(app.get('brewer-state').dataset.state, 'error');
+  assert.equal(app.get('utility-state').dataset.state, 'connected');
+});
+
+test('rejects wrong network targets and malformed or credential-bearing URLs', async () => {
+  const app = setup();
+  await ready();
+  for (const [id, url] of [
+    ['utility', 'http://192.168.1.50/status'], ['utility', 'http://localhost.example.com/'],
+    ['brewer', 'http://127.0.0.1/'], ['brewer', 'https://example.com/'],
+    ['brewer', 'not a url'], ['brewer', 'http://user:pass@coffee.local/status']
+  ]) {
+    await app.submit(id, url);
+    assert.equal(app.get(`${id}-state`).dataset.state, 'error');
+    assert.equal(app.get(`${id}-url`)['aria-invalid'], 'true');
+  }
+  assert.equal(app.calls.length, 0);
+});
+
+test('denied permission prevents requests; unavailable introspection permits an honest attempt', async () => {
+  const blocked = setup({ permissionState: 'denied' });
+  await ready();
+  await blocked.submit('utility', 'http://localhost:8765/status');
+  assert.equal(blocked.calls.length, 0);
+  assert.match(blocked.get('utility-message').textContent, /blocked/);
+  const unsupported = setup({ permissionsSupported: false });
+  await ready();
+  assert.match(unsupported.get('utility-permission').textContent, /unavailable/);
+  await unsupported.submit('utility', 'http://localhost:8765/status');
+  assert.equal(unsupported.calls.length, 1);
+});
+
+test('HTTP failures and opaque browser network failures have actionable feedback', async () => {
+  for (const fetchImpl of [
+    async () => ({ ok: false, status: 503 }),
+    async () => { throw new TypeError('Failed to fetch'); }
+  ]) {
+    const app = setup({ fetchImpl });
+    await ready();
+    await app.submit('brewer', 'http://coffee.local/status');
+    assert.equal(app.get('brewer-state').dataset.state, 'error');
+    assert.match(app.get('brewer-message').textContent, /HTTP 503|CORS/);
+    assert.equal(app.get('brewer-connect').disabled, false);
+  }
+});
+
+test('disconnect ignores late responses, and timeout makes retry available', async () => {
+  let resolve;
+  const app = setup({ fetchImpl: () => new Promise(done => { resolve = done; }) });
+  await ready();
+  const pending = app.submit('utility', 'http://127.0.0.1:8765/status');
+  app.get('utility-disconnect').handlers.click();
+  assert.equal(app.calls[0].options.signal.aborted, true);
+  resolve({ ok: true, body: null });
+  await pending;
+  assert.equal(app.get('utility-state').dataset.state, 'idle');
+  const timeoutApp = setup({ fetchImpl: (_, { signal }) => new Promise((_, reject) => {
+    signal.addEventListener('abort', () => reject(new Error('Aborted')));
+  }) });
+  await ready();
+  const timed = timeoutApp.submit('brewer', 'http://10.0.0.2/status');
+  [...timeoutApp.timers.values()][0]();
+  await timed;
+  assert.match(timeoutApp.get('brewer-message').textContent, /10 seconds/);
+  assert.equal(timeoutApp.get('brewer-connect').disabled, false);
+});
+
+test('insecure contexts cannot issue requests', async () => {
+  const app = setup({ secure: false });
+  await ready();
+  await app.submit('utility', 'http://localhost:8765/status');
+  assert.equal(app.calls.length, 0);
+  assert.equal(app.get('utility-connect').disabled, true);
+  assert.match(app.get('utility-message').textContent, /HTTPS/);
+});
