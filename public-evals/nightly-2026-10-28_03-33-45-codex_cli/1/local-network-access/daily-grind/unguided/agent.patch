diff --git a/equipment.js b/equipment.js
new file mode 100644
index 0000000..b1136cf
--- /dev/null
+++ b/equipment.js
@@ -0,0 +1,149 @@
+(() => {
+  'use strict';
+
+  const isLoopback = host => host === 'localhost' || host === '[::1]' || /^127\./.test(host);
+  const isPrivate = host => {
+    const octets = host.split('.').map(Number);
+    return (octets.length === 4 && (octets[0] === 10 ||
+      (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+      (octets[0] === 192 && octets[1] === 168) ||
+      (octets[0] === 169 && octets[1] === 254))) ||
+      host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host);
+  };
+
+  for (const [id, addressSpace, permissionName] of [
+    ['brewer', 'local', 'local-network'],
+    ['utility', 'loopback', 'loopback-network']
+  ]) {
+    const element = suffix => document.getElementById(`${id}-${suffix}`);
+    const input = element('url');
+    const connect = element('connect');
+    const disconnect = element('disconnect');
+    const status = element('state');
+    const message = element('message');
+    let permission;
+    let sharedPermission = false;
+    let controller;
+    let attempt = 0;
+
+    function show(state, detail) {
+      status.dataset.state = state;
+      status.textContent = '● ' + ({ idle: 'Not connected', connecting: 'Connecting…', connected: 'Reachable', error: 'Connection failed' })[state];
+      message.textContent = detail;
+      message.dataset.error = String(state === 'error');
+    }
+
+    function renderPermission() {
+      const labels = { granted: 'Allowed', denied: 'Blocked', prompt: 'Ask on connect' };
+      element('permission').textContent = 'Permission: ' + (permission ? labels[permission.state] : 'Status unavailable') + (sharedPermission ? ' (shared)' : '');
+      if (permission?.state === 'denied' && (controller || status.dataset.state === 'connected')) {
+        reset('Access was blocked. Allow access in this website’s browser site settings, then reconnect.', 'error');
+      }
+    }
+
+    async function observePermission() {
+      if (!window.isSecureContext) {
+        element('permission').textContent = 'Permission: secure page required';
+        connect.disabled = true;
+        show('error', 'Open this page over HTTPS or localhost to connect to equipment.');
+        return;
+      }
+      if (navigator.permissions?.query) {
+        try {
+          permission = await navigator.permissions.query({ name: permissionName });
+        } catch {
+          try {
+            permission = await navigator.permissions.query({ name: 'local-network-access' });
+            sharedPermission = true;
+          } catch { /* Browsers without permission introspection may still support fetch. */ }
+        }
+      }
+      if (permission) permission.addEventListener('change', renderPermission);
+      renderPermission();
+    }
+
+    function reset(detail, state = 'idle') {
+      attempt++;
+      controller?.abort();
+      controller = undefined;
+      input.disabled = false;
+      connect.disabled = !window.isSecureContext;
+      disconnect.disabled = true;
+      show(state, detail);
+    }
+
+    disconnect.addEventListener('click', () => reset('Disconnected. You can reconnect whenever you’re ready.'));
+    input.addEventListener('input', () => {
+      input.removeAttribute('aria-invalid');
+      reset('Address updated. Select Connect to check this endpoint.');
+    });
+
+    element('form').addEventListener('submit', async event => {
+      event.preventDefault();
+      if (controller || !window.isSecureContext) return;
+      let url;
+      try {
+        url = new URL(input.value.trim());
+        if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+          throw new Error('Enter an HTTP or HTTPS status URL without credentials or a fragment.');
+        }
+        if (id === 'utility' && !isLoopback(url.hostname)) {
+          throw new Error('The utility must use localhost, a 127.x.x.x address, or [::1] on this device.');
+        }
+        if (id === 'brewer' && (!isPrivate(url.hostname) || isLoopback(url.hostname))) {
+          throw new Error('Use your brewer’s private network IP address or .local hostname.');
+        }
+      } catch (error) {
+        input.setAttribute('aria-invalid', 'true');
+        show('error', error instanceof TypeError ? 'Enter a complete status URL, including http:// or https://.' : error.message);
+        input.focus();
+        return;
+      }
+      input.removeAttribute('aria-invalid');
+      if (permission?.state === 'denied') {
+        show('error', 'Access is blocked. Allow access in this website’s browser site settings, then retry.');
+        return;
+      }
+      const currentAttempt = ++attempt;
+      const requestController = new AbortController();
+      controller = requestController;
+      let timedOut = false;
+      const timeout = setTimeout(() => { timedOut = true; requestController.abort(); }, 10000);
+      input.disabled = true;
+      connect.disabled = true;
+      disconnect.disabled = false;
+      show('connecting', 'Checking your endpoint. Allow the browser’s network permission prompt if one appears.');
+      try {
+        const response = await fetch(url.href, {
+          method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+          redirect: 'error', targetAddressSpace: addressSpace, signal: requestController.signal
+        });
+        if (currentAttempt !== attempt) return;
+        if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check the status URL and service configuration, then retry.`);
+        show('connected', `Endpoint reachable at ${new Date().toLocaleTimeString()}. No brew has been started. Disconnect or check again to refresh.`);
+        // Reachability is confirmed by the headers; no device data is required or retained.
+        if (response.body) response.body.cancel().catch(() => {});
+      } catch (error) {
+        if (currentAttempt !== attempt) return;
+        const detail = permission?.state === 'denied'
+          ? 'Access is blocked. Allow access in this website’s browser site settings, then retry.'
+          : timedOut
+            ? 'No response within 10 seconds. Check the address, network, and that the brewer or utility is running, then retry.'
+            : error instanceof TypeError
+              ? 'Could not reach the endpoint. Check that it is running, the address and network are correct, and browser access and CORS are allowed. See connection help below.'
+              : error.message;
+        show('error', detail);
+        disconnect.disabled = true;
+      } finally {
+        clearTimeout(timeout);
+        if (currentAttempt === attempt) {
+          controller = undefined;
+          input.disabled = false;
+          connect.disabled = false;
+          renderPermission();
+        }
+      }
+    });
+    observePermission();
+  }
+})();
