+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsStickyFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let scheduled = false;
+
+    function updateStickyHeaders() {
+      scheduled = false;
+      if (!needsStickyFallback) return;
+
+      // Read viewport coordinates: the document remains the scroll root.
+      const states = stickyContainers.map(container => {
+        const bounds = container.getBoundingClientRect();
+        return bounds.top <= navigationHeight + 0.5 &&
+          bounds.top >= navigationHeight - 0.5 && window.scrollY > 0;
+      });
+      stickyContainers.forEach((container, index) => {
+        container.classList.toggle('is-stuck', states[index]);
+      });
+    }
+
+    function scheduleStickyUpdate() {
+      if (scheduled) return;
+      scheduled = true;
+      requestAnimationFrame(updateStickyHeaders);
+    }
+
+    const navigationObserver = new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      scheduleStickyUpdate();
+    });
+    navigationObserver.observe(navigation);
+
+    if (needsStickyFallback) {
+      window.addEventListener('scroll', scheduleStickyUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStickyUpdate);
+    }
+  </script>
+
 </body>
 
