+  <script>
+    const cafeMap = document.getElementById('cafe-map');
+    const needsPanFallback = !CSS.supports('scroll-axis-lock', 'none');
+
+    function recenterMap() {
+      cafeMap.scrollLeft = (cafeMap.scrollWidth - cafeMap.clientWidth) / 2;
+      cafeMap.scrollTop = (cafeMap.scrollHeight - cafeMap.clientHeight) / 2;
+    }
+
+    document.getElementById('map-reset').addEventListener('click', recenterMap);
+    recenterMap();
+
+    if (needsPanFallback) {
+      cafeMap.classList.add('has-pan-fallback');
+      cafeMap.addEventListener('wheel', (event) => {
+        // Preserve browser zoom gestures; normalize line- and page-based wheels.
+        if (event.ctrlKey) return;
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? cafeMap.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? cafeMap.clientHeight : 1;
+        cafeMap.scrollLeft += event.shiftKey && !event.deltaX ? event.deltaY * unitX : event.deltaX * unitX;
+        cafeMap.scrollTop += event.shiftKey && !event.deltaX ? 0 : event.deltaY * unitY;
+      }, { passive: false });
+    }
+
+    let pan = null;
+    cafeMap.addEventListener('pointerdown', (event) => {
+      // Supported browsers keep native touch panning; mouse dragging is always available.
+      if (!event.isPrimary || event.button !== 0 || (!needsPanFallback && event.pointerType !== 'mouse')) return;
+      const rect = cafeMap.getBoundingClientRect();
+      const x = event.clientX - rect.left - cafeMap.clientLeft;
+      const y = event.clientY - rect.top - cafeMap.clientTop;
+      // Leave native scrollbar interaction alone.
+      if (x < 0 || y < 0 || x >= cafeMap.clientWidth || y >= cafeMap.clientHeight) return;
+      pan = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      cafeMap.setPointerCapture(event.pointerId);
+      cafeMap.classList.add('is-panning');
+      cafeMap.focus({ preventScroll: true });
+    });
+
+    cafeMap.addEventListener('pointermove', (event) => {
+      if (!pan || pan.id !== event.pointerId) return;
+      // Apply both deltas on every move, including changes of direction mid-gesture.
+      cafeMap.scrollLeft -= event.clientX - pan.x;
+      cafeMap.scrollTop -= event.clientY - pan.y;
+      pan.x = event.clientX;
+      pan.y = event.clientY;
+    });
+
+    function endPan(event) {
+      if (!pan || pan.id !== event.pointerId) return;
+      pan = null;
+      cafeMap.classList.remove('is-panning');
+      if (cafeMap.hasPointerCapture(event.pointerId)) cafeMap.releasePointerCapture(event.pointerId);
+    }
+
+    cafeMap.addEventListener('pointerup', endPan);
+    cafeMap.addEventListener('pointercancel', endPan);
+    cafeMap.addEventListener('lostpointercapture', endPan);
+  </script>
