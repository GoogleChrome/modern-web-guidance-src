+  <script>
+    const cafeMap = document.getElementById('cafe-map');
+    const pins = cafeMap.querySelectorAll('.cafe-pin');
+    let drag = null;
+    let suppressClick = false;
+
+    function recenterMap() {
+      cafeMap.scrollLeft = 900 - cafeMap.clientWidth / 2;
+      cafeMap.scrollTop = 600 - cafeMap.clientHeight / 2;
+    }
+
+    document.getElementById('map-reset').addEventListener('click', recenterMap);
+    recenterMap();
+
+    cafeMap.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || drag) return;
+      suppressClick = false;
+      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0 };
+      // Keep button clicks targeted correctly while capturing drags outside the map.
+      const target = event.target.closest('.cafe-pin') || cafeMap;
+      target.setPointerCapture(event.pointerId);
+    });
+
+    cafeMap.addEventListener('pointermove', (event) => {
+      if (!drag || event.pointerId !== drag.id) return;
+      const dx = event.clientX - drag.x;
+      const dy = event.clientY - drag.y;
+      // Apply both components on every event; never choose or lock an axis.
+      cafeMap.scrollLeft -= dx;
+      cafeMap.scrollTop -= dy;
+      drag.distance += Math.hypot(dx, dy);
+      drag.x = event.clientX;
+      drag.y = event.clientY;
+      if (drag.distance > 4) {
+        suppressClick = true;
+        cafeMap.classList.add('is-dragging');
+      }
+    });
+
+    function endDrag(event) {
+      if (!drag || event.pointerId !== drag.id) return;
+      drag = null;
+      cafeMap.classList.remove('is-dragging');
+    }
+
+    cafeMap.addEventListener('pointerup', endDrag);
+    cafeMap.addEventListener('pointercancel', endDrag);
+    cafeMap.addEventListener('lostpointercapture', endDrag);
+    cafeMap.addEventListener('click', (event) => {
+      if (suppressClick && event.detail !== 0) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+      }
+      suppressClick = false;
+    }, true);
+
+    cafeMap.addEventListener('wheel', (event) => {
+      if (event.ctrlKey) return;
+      event.preventDefault();
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? cafeMap.clientHeight : 1;
+      cafeMap.scrollLeft += event.deltaX * unit;
+      cafeMap.scrollTop += event.deltaY * unit;
+    }, { passive: false });
+
+    pins.forEach((pin) => {
+      pin.addEventListener('click', () => {
+        pins.forEach((other) => other.setAttribute('aria-pressed', String(other === pin)));
+        document.getElementById('location-detail').textContent = pin.dataset.detail;
+      });
+    });
+  </script>
+
