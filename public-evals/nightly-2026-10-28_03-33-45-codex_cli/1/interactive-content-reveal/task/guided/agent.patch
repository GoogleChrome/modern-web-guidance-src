+    .product-card {
+      position: relative;
+      isolation: isolate;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      transition: --inner-size 0.25s ease, --outer-size 0.25s ease;
+    }
+
+    @media (hover: hover) {
+      .product-card:hover {
+        --inner-size: 70px;
+        --outer-size: 150px;
+      }
+    }
+
+    .product-card > .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      border-radius: inherit;
+      pointer-events: none;
+      /* Keep the enhancement hidden when masking is unsupported. */
+      display: none;
+    }
+
+    @supports (mask-image: radial-gradient(circle, black, transparent)) or
+      (-webkit-mask-image: radial-gradient(circle, black, transparent)) {
+      .product-card > .spotlight-overlay {
+        display: block;
+        background:
+          radial-gradient(circle, #d7ccc8 1px, transparent 1px) 0 0 / 12px 12px,
+          linear-gradient(135deg, #fff3df, #f3e4dc);
+        -webkit-mask-image: radial-gradient(
+          circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px)
+        );
+        mask-image: radial-gradient(
+          circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px)
+        );
+        -webkit-mask-repeat: no-repeat;
+        mask-repeat: no-repeat;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
