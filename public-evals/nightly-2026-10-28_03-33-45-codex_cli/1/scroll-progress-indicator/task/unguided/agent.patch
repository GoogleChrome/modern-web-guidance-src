+  <script>
+    // Use native scroll-driven animation when available, with a JS fallback.
+    if (!(window.CSS && CSS.supports('animation-timeline: scroll(root block)'))) {
+      const indicator = document.querySelector('.scroll-progress');
+      let framePending = false;
+
+      function updateProgress() {
+        const root = document.documentElement;
+        const scrollableHeight = root.scrollHeight - root.clientHeight;
+        const progress = scrollableHeight > 0
+          ? Math.min(1, Math.max(0, window.scrollY / scrollableHeight))
+          : 0;
+        indicator.style.transform = 'scaleX(' + progress + ')';
+        framePending = false;
+      }
+
+      function scheduleUpdate() {
+        if (!framePending) {
+          framePending = true;
+          window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+      }
+      updateProgress();
+    }
+  </script>
 </body>
 
