diff --git a/media.js b/media.js
new file mode 100644
index 0000000..cdd4bba
--- /dev/null
+++ b/media.js
@@ -0,0 +1,67 @@
+// URLs stay in data attributes until proximity is established, including in
+// browsers that ignore loading="lazy" on media. The preload scanner cannot
+// start poster or metadata requests before this point.
+const pendingMedia = new Set(document.querySelectorAll('[data-lazy-media]'));
+
+function activateMedia(media) {
+  if (!pendingMedia.delete(media)) return;
+
+  for (const attribute of ['poster', 'src']) {
+    if (media.dataset[attribute]) {
+      media.setAttribute(attribute, media.dataset[attribute]);
+      delete media.dataset[attribute];
+    }
+  }
+
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+
+  media.preload = media.dataset.preload || 'metadata';
+  delete media.dataset.preload;
+  delete media.dataset.lazyMedia;
+  media.load();
+}
+
+if ('IntersectionObserver' in window) {
+  const observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting) continue;
+      activateMedia(entry.target);
+      observer.unobserve(entry.target);
+    }
+    if (pendingMedia.size === 0) observer.disconnect();
+  }, { rootMargin: '200px 0px' });
+
+  pendingMedia.forEach((media) => observer.observe(media));
+} else {
+  // Keep the same bandwidth guarantee on older browsers without the observer.
+  let scheduled = false;
+  function checkProximity() {
+    scheduled = false;
+    const nearby = [...pendingMedia].filter((media) => {
+      const rect = media.getBoundingClientRect();
+      return rect.bottom >= -200 && rect.top <= window.innerHeight + 200;
+    });
+    nearby.forEach(activateMedia);
+    if (pendingMedia.size === 0) {
+      window.removeEventListener('scroll', scheduleCheck);
+      window.removeEventListener('resize', scheduleCheck);
+    }
+  }
+  function scheduleCheck() {
+    if (scheduled) return;
+    scheduled = true;
+    requestAnimationFrame(checkProximity);
+  }
+  window.addEventListener('scroll', scheduleCheck, { passive: true });
+  window.addEventListener('resize', scheduleCheck);
+  checkProximity();
+}
+
+for (const media of document.querySelectorAll('video, audio')) {
+  media.addEventListener('error', () => {
+    media.closest('figure').querySelector('.media-error').hidden = false;
+  });
+}
