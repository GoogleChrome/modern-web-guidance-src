+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+
+    const setPending = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    };
+
+    const setActive = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    };
+
+    // Start-aligned slides use offsets relative to the positioned gallery.
+    const closestIndex = () => items.reduce((closest, item, index) =>
+      Math.abs(item.offsetLeft - gallery.scrollLeft) <
+      Math.abs(items[closest].offsetLeft - gallery.scrollLeft) ? index : closest, 0);
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      setActive(items.indexOf(event.snapTargetInline));
+    });
+
+    let frame = null;
+    let scrollTimeout;
+    const settle = () => {
+      clearTimeout(scrollTimeout);
+      if (frame !== null) cancelAnimationFrame(frame);
+      frame = null;
+      setActive(closestIndex());
+    };
+
+    const needsPendingFallback = !('onscrollsnapchanging' in gallery);
+    const needsEndFallback = !('onscrollend' in gallery);
+
+    if (needsPendingFallback || needsEndFallback) {
+      gallery.addEventListener('scroll', () => {
+        if (needsPendingFallback && frame === null) {
+          frame = requestAnimationFrame(() => {
+            frame = null;
+            setPending(closestIndex());
+          });
+        }
+        if (needsEndFallback) {
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(settle, 150);
+        }
+      }, { passive: true });
+    }
+
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', settle);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const left = items[index].offsetLeft;
+        if (Math.abs(gallery.scrollLeft - left) < 1) {
+          settle();
+          return;
+        }
+        setPending(index);
+        gallery.scrollTo({
+          left,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
+        });
+      });
+    });
+
+    setActive(closestIndex());
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('load', settle, { once: true });
+  </script>
+
