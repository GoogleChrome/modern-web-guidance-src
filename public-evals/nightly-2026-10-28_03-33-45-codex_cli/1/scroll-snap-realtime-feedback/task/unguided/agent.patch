+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    let settleTimer;
+
+    function markPending(index) {
+      thumbnails.forEach((thumbnail, position) => {
+        thumbnail.classList.toggle('pending', position === index);
+      });
+    }
+
+    function select(index) {
+      thumbnails.forEach((thumbnail, position) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', position === index);
+        if (position === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function nearestIndex() {
+      const left = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      return items.reduce((closest, item, index) =>
+        Math.abs(item.getBoundingClientRect().left - left) <
+        Math.abs(items[closest].getBoundingClientRect().left - left) ? index : closest, 0);
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) markPending(index);
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) select(index);
+    });
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      select(nearestIndex());
+    }
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapChanging) markPending(nearestIndex());
+      // Older browsers without scrollend still clear the transient state.
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }, { passive: true });
+    gallery.addEventListener('scrollend', finishScroll);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        if (index === nearestIndex() && Math.abs(items[index].getBoundingClientRect().left -
+            gallery.getBoundingClientRect().left - gallery.clientLeft) < 1) {
+          select(index);
+          return;
+        }
+        markPending(index);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + items[index].getBoundingClientRect().left -
+            gallery.getBoundingClientRect().left - gallery.clientLeft,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
