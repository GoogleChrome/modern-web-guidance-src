+// Versioned, domain-separated signatures. Verification keys travel separately
+// from documents: an attacker-controlled document never establishes trust.
+const encoder = new TextEncoder();
+const suites = ['ML-DSA-65', 'Ed25519', 'ECDSA'];
+export const format = 'daily-grind-signed-v1';
+const keyFormat = 'daily-grind-public-key-v1';
+const context = encoder.encode(format);
+
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+function base64(bytes) { return btoa(String.fromCharCode(...new Uint8Array(bytes))); }
+function unbase64(value) {
+  if (typeof value !== 'string' || !value.length || value.length > 20000 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) throw new Error('Invalid encoded key or signature.');
+  return Uint8Array.from(atob(value), char => char.charCodeAt(0));
+}
+function requireCrypto() {
+  if (!globalThis.crypto?.subtle) throw new Error('Digital signing needs HTTPS and a browser with Web Crypto support.');
+}
+function keyParams(suite) {
+  if (!suites.includes(suite)) throw new Error('Unsupported signature algorithm.');
+  return suite === 'ECDSA' ? { name: 'ECDSA', namedCurve: 'P-256' } : suite;
+}
+function signatureParams(suite) {
+  return suite === 'ECDSA' ? { name: 'ECDSA', hash: 'SHA-256' } : suite === 'ML-DSA-65' ? { name: suite, context } : suite;
+}
+function publicFormat(suite) { return suite === 'ML-DSA-65' ? 'raw-public' : 'raw'; }
+function signedBytes(body) {
+  const bytes = encoder.encode(canonical(body));
+  if (body.suite === 'ML-DSA-65') return bytes;
+  // Classical algorithms ignore ContextParams, so frame the context explicitly.
+  const framed = new Uint8Array(1 + context.length + bytes.length);
+  framed[0] = context.length;
+  framed.set(context, 1);
+  framed.set(bytes, context.length + 1);
+  return framed;
+}
+function exactKeys(value, keys) {
+  if (!value || Array.isArray(value) || typeof value !== 'object' || Object.keys(value).sort().join('|') !== [...keys].sort().join('|')) throw new Error('Unrecognized document structure.');
+}
+export function validatePayload(payload) {
+  const common = ['id', 'issuer', 'kind', 'createdAt', 'recipient', 'currency', 'amountCents', 'sample'];
+  if (!['receipt', 'voucher'].includes(payload?.kind)) throw new Error('Expected an order receipt or gift voucher.');
+  exactKeys(payload, [...common, payload.kind === 'receipt' ? 'items' : 'message']);
+  if (payload.issuer !== 'The Daily Grind · local sample' || payload.sample !== true || payload.currency !== 'USD' || typeof payload.id !== 'string' || !/^DG-[0-9a-f-]{36}$/.test(payload.id) || typeof payload.createdAt !== 'string' || !Number.isFinite(Date.parse(payload.createdAt)) || new Date(payload.createdAt).toISOString() !== payload.createdAt || typeof payload.recipient !== 'string' || payload.recipient.length > 80 || !Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0 || payload.amountCents > 100000) throw new Error('Invalid document details.');
+  if (payload.kind === 'voucher') {
+    if (![1000, 2500, 5000, 10000].includes(payload.amountCents) || typeof payload.message !== 'string' || payload.message.length > 200) throw new Error('Invalid gift voucher.');
+  } else {
+    if (!Array.isArray(payload.items) || payload.items.length !== 1) throw new Error('Invalid receipt items.');
+    const item = payload.items[0];
+    exactKeys(item, ['name', 'quantity', 'unitCents']);
+    const prices = { 'Maple Oat Latte': 550, 'Dark Roast Espresso': 350, 'Cold Brew': 450 };
+    if (!Object.hasOwn(prices, item.name) || prices[item.name] !== item.unitCents || !Number.isInteger(item.quantity) || item.quantity < 1 || item.quantity > 20 || payload.amountCents !== item.quantity * item.unitCents) throw new Error('Receipt totals or items are inconsistent.');
+  }
+}
+export async function fingerprint(suite, publicKey) {
+  requireCrypto();
+  const digest = await crypto.subtle.digest('SHA-256', encoder.encode(canonical({ suite, publicKey })));
+  return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export function supportsQuantum() {
+  return typeof globalThis.SubtleCrypto?.supports === 'function' && globalThis.SubtleCrypto.supports('sign', 'ML-DSA-65') && globalThis.SubtleCrypto.supports('verify', 'ML-DSA-65');
+}
+export async function createKey(suite) {
+  requireCrypto();
+  const keyPair = await crypto.subtle.generateKey(keyParams(suite), false, ['sign', 'verify']);
+  const publicKey = base64(await crypto.subtle.exportKey(publicFormat(suite), keyPair.publicKey));
+  return { suite, ...keyPair, publicBytes: publicKey, keyId: await fingerprint(suite, publicKey) };
+}
+export async function createBestKey() {
+  const candidates = supportsQuantum() ? suites : suites.slice(1);
+  for (const suite of candidates) {
+    try { return await createKey(suite); }
+    catch (error) { if (error.name !== 'NotSupportedError') throw error; }
+  }
+  throw new Error('No supported digital signature algorithm is available in this browser.');
+}
+export function exportPublicKey(key) {
+  return { format: keyFormat, suite: key.suite, keyId: key.keyId, publicKey: key.publicBytes };
+}
+export async function importPublicKey(data) {
+  requireCrypto();
+  exactKeys(data, ['format', 'suite', 'keyId', 'publicKey']);
+  if (data.format !== keyFormat || !suites.includes(data.suite) || !/^[a-f0-9]{64}$/.test(data.keyId)) throw new Error('Not a Daily Grind public verification key.');
+  const bytes = unbase64(data.publicKey);
+  const expectedLength = { 'ML-DSA-65': 1952, Ed25519: 32, ECDSA: 65 }[data.suite];
+  if (bytes.length !== expectedLength || await fingerprint(data.suite, data.publicKey) !== data.keyId) throw new Error('Public key fingerprint does not match.');
+  const publicKey = await crypto.subtle.importKey(publicFormat(data.suite), bytes, keyParams(data.suite), true, ['verify']);
+  return { suite: data.suite, publicKey, publicBytes: data.publicKey, keyId: data.keyId };
+}
+export async function signDocument(payload, key) {
+  validatePayload(payload);
+  const body = { format, suite: key.suite, keyId: key.keyId, payload };
+  const signature = await crypto.subtle.sign(signatureParams(key.suite), key.privateKey, signedBytes(body));
+  return { ...body, signature: base64(signature) };
+}
+export async function verifyDocument(document, trustedKey) {
+  requireCrypto();
+  exactKeys(document, ['format', 'suite', 'keyId', 'payload', 'signature']);
+  if (document.format !== format || !suites.includes(document.suite) || !/^[a-f0-9]{64}$/.test(document.keyId)) throw new Error('Unrecognized signed document.');
+  validatePayload(document.payload);
+  if (!trustedKey || trustedKey.keyId !== document.keyId || trustedKey.suite !== document.suite) throw new Error('Unknown signer. Import a public key from the signer and check its fingerprint before trusting it.');
+  const { signature, ...body } = document;
+  const valid = await crypto.subtle.verify(signatureParams(document.suite), trustedKey.publicKey, unbase64(signature), signedBytes(body));
+  if (!valid) throw new Error('Signature invalid. This document has changed or was signed by a different key.');
+  return document.payload;
+}
