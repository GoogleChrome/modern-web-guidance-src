@@ -0,0 +1,279 @@
+import { createKey, exportPublicKey, importPublicKey, signDocument, verifyDocument, supportsQuantum } from './signatures.mjs';
+
+const $ = id => document.getElementById(id);
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const coffees = { maple: ['Maple Oat Latte', 550], espresso: ['Dark Roast Espresso', 350], coldbrew: ['Cold Brew', 450] };
+const knownKeys = new Map();
+const signingKeys = new Map();
+let currentKey, lastSigned, downloadable, pendingKey, dbPromise;
+let storageWarning = '';
+let fileLoading = false;
+let fileVersion = 0;
+
+function status(message, tone = '') {
+  $('studio-status').textContent = message;
+  $('studio-status').dataset.tone = tone;
+}
+function mode(create) {
+  fileVersion++;
+  fileLoading = false;
+  $('create-panel').hidden = !create;
+  $('verify-panel').hidden = create;
+  $('create-mode').setAttribute('aria-pressed', String(create));
+  $('verify-mode').setAttribute('aria-pressed', String(!create));
+  status(create ? 'Ready when you are. Your documents stay on your device.' : 'Upload or paste a signed document to check its integrity and signer.');
+  if (create) updatePreview();
+}
+$('create-mode').addEventListener('click', () => mode(true));
+$('verify-mode').addEventListener('click', () => mode(false));
+
+function openDatabase() {
+  if (!dbPromise) dbPromise = new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing-v1', 1);
+    request.onupgradeneeded = () => {
+      const store = request.result.createObjectStore('keys', { keyPath: 'keyId' });
+      store.createIndex('suite', 'suite');
+    };
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Browser key storage is blocked.'));
+    request.onsuccess = () => {
+      request.result.onversionchange = () => request.result.close();
+      resolve(request.result);
+    };
+  });
+  return dbPromise;
+}
+async function readKey(suite, refresh = false) {
+  if (!refresh && signingKeys.has(suite)) return signingKeys.get(suite);
+  try {
+    const db = await openDatabase();
+    const keys = await new Promise((resolve, reject) => {
+      const request = db.transaction('keys').objectStore('keys').index('suite').getAll(suite);
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(request.error);
+    });
+    // Retain every local public key, including keys created by another tab.
+    for (const stored of keys) knownKeys.set(stored.keyId, stored);
+    const key = keys[0];
+    if (key) signingKeys.set(suite, key);
+    return key;
+  } catch {
+    storageWarning = ' Browser storage is unavailable: this key lasts only for this page session. Download its public key before leaving.';
+    return undefined;
+  }
+}
+async function saveKey(key) {
+  signingKeys.set(key.suite, key);
+  knownKeys.set(key.keyId, key);
+  try {
+    const db = await openDatabase();
+    await new Promise((resolve, reject) => {
+      const transaction = db.transaction('keys', 'readwrite');
+      transaction.objectStore('keys').put(key);
+      transaction.oncomplete = resolve;
+      transaction.onerror = () => reject(transaction.error);
+      transaction.onabort = () => reject(transaction.error);
+    });
+  } catch {
+    storageWarning = ' Browser storage is unavailable: this key lasts only for this page session. Download its public key before leaving.';
+  }
+}
+async function getSigningKey(choice) {
+  const candidates = choice === 'auto' ? (supportsQuantum() ? ['ML-DSA-65', 'Ed25519', 'ECDSA'] : ['Ed25519', 'ECDSA']) : [choice];
+  for (const suite of candidates) {
+    try {
+      const existing = await readKey(suite);
+      if (existing) return existing;
+      const key = await createKey(suite);
+      await saveKey(key);
+      return key;
+    } catch (error) {
+      if (choice !== 'auto' || error.name !== 'NotSupportedError') throw error;
+    }
+  }
+  throw new Error('No supported signature algorithm is available in this browser.');
+}
+function draftPayload() {
+  const voucher = $('sign-form').elements.documentType.value === 'voucher';
+  const [name, unitCents] = coffees[$('coffee').value];
+  const quantity = Number($('quantity').value);
+  return {
+    id: 'DG-' + crypto.randomUUID(), issuer: 'The Daily Grind · local sample',
+    kind: voucher ? 'voucher' : 'receipt', createdAt: new Date().toISOString(),
+    recipient: $('recipient').value.trim(), currency: 'USD', sample: true,
+    amountCents: voucher ? Number($('gift-amount').value) : unitCents * quantity,
+    ...(voucher ? { message: $('gift-message').value.trim() } : { items: [{ name, quantity, unitCents }] })
+  };
+}
+function render(payload, state, suite = '', keyId = '') {
+  const voucher = payload.kind === 'voucher';
+  $('preview-kind').textContent = voucher ? 'SAMPLE GIFT VOUCHER' : 'SAMPLE ORDER RECEIPT';
+  $('preview-date').textContent = state === 'unsigned' ? 'MADE WITH CARE' : new Date(payload.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+  $('preview-recipient').textContent = 'For ' + (payload.recipient || 'a coffee lover');
+  $('preview-item').textContent = voucher ? 'A little coffee, a lot of love' : `${payload.items[0].quantity} × ${payload.items[0].name}`;
+  $('preview-price').textContent = money(payload.amountCents);
+  $('preview-total').textContent = money(payload.amountCents);
+  $('total-label').textContent = voucher ? 'Gift value · USD' : 'Total · USD';
+  $('preview-message').hidden = !voucher || !payload.message;
+  $('preview-message').textContent = voucher ? payload.message : '';
+  const signed = state !== 'unsigned';
+  $('preview-state').textContent = state === 'verified' ? 'SIGNATURE VERIFIED' : signed ? 'DIGITALLY SIGNED' : 'UNSIGNED PREVIEW';
+  $('seal-title').textContent = state === 'verified' ? 'Integrity verified' : signed ? 'Digitally signed sample' : 'A little extra assurance';
+  $('seal-description').textContent = signed ? `${suite === 'ECDSA' ? 'ECDSA P-256' : suite} · Key ${keyId.slice(0, 12)}…` : 'Ready for your digital signature.';
+  $('preview-id').textContent = signed ? payload.id : 'BREWED WITH LOVE. SEALED WITH MATH.';
+}
+function updatePreview() {
+  const voucher = $('sign-form').elements.documentType.value === 'voucher';
+  $('receipt-fields').hidden = voucher;
+  $('quantity').disabled = voucher;
+  $('coffee').disabled = voucher;
+  $('voucher-fields').hidden = !voucher;
+  $('gift-amount').disabled = !voucher;
+  $('gift-message').disabled = !voucher;
+  $('sign-button').replaceChildren(document.createTextNode(voucher ? 'Sign sample gift voucher ' : 'Sign sample receipt '), Object.assign(document.createElement('span'), { textContent: '↗' }));
+  downloadable = undefined;
+  $('download-document').disabled = true;
+  // A preview needs no cryptographic operations or secure context.
+  const [name, unitCents] = coffees[$('coffee').value];
+  const quantity = Math.min(20, Math.max(1, Number($('quantity').value) || 1));
+  render({ kind: voucher ? 'voucher' : 'receipt', recipient: $('recipient').value.trim(), amountCents: voucher ? Number($('gift-amount').value) : unitCents * quantity, items: [{ name, quantity }], message: $('gift-message').value.trim() }, 'unsigned');
+}
+$('sign-form').addEventListener('input', () => { updatePreview(); status('Preview updated. Sign again to seal these details.'); });
+$('sign-form').addEventListener('change', updatePreview);
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const form = $('sign-form');
+  if (!form.reportValidity()) return;
+  // Snapshot before async key generation; do not allow edits to masquerade as signed.
+  if (!globalThis.crypto?.subtle) { status('Digital signing needs HTTPS and a browser with Web Crypto support.', 'error'); return; }
+  const controls = [...form.elements];
+  const disabledBefore = controls.map(control => control.disabled);
+  try {
+    const payload = draftPayload();
+    const choice = $('algorithm').value;
+    controls.forEach(control => { control.disabled = true; });
+    status('Creating your digital signature…');
+    const key = await getSigningKey(choice);
+    const signed = await signDocument(payload, key);
+    // Self-check before presenting or exporting a signed result.
+    await verifyDocument(signed, key);
+    currentKey = key;
+    lastSigned = signed;
+    downloadable = signed;
+    $('download-document').disabled = false;
+    $('download-key').disabled = false;
+    $('use-last').disabled = false;
+    $('key-info').textContent = `${currentKey.suite === 'ECDSA' ? 'ECDSA P-256' : currentKey.suite} · SHA-256 fingerprint: ${currentKey.keyId}${storageWarning}`;
+    render(payload, 'signed', currentKey.suite, currentKey.keyId);
+    status(`Sample ${payload.kind === 'voucher' ? 'gift voucher' : 'receipt'} signed with ${currentKey.suite === 'ECDSA' ? 'ECDSA P-256' : currentKey.suite}. Download the document and share the public key separately.${storageWarning}`, 'success');
+  } catch (error) { status(friendlyError(error), 'error'); }
+  finally { controls.forEach((control, index) => { control.disabled = disabledBefore[index]; }); }
+});
+function friendlyError(error) {
+  if (error.name === 'NotSupportedError') return 'This browser does not support that signature algorithm. Choose Automatic or ECDSA P-256. Quantum-resistant documents need a browser that supports ML-DSA-65.';
+  if (error instanceof SyntaxError) return 'This is not valid JSON. Upload or paste a complete signed document.';
+  return error.message || 'The operation could not be completed. Please try again.';
+}
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url; link.download = filename;
+  document.body.append(link); link.click(); link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download-document').addEventListener('click', () => {
+  if (downloadable) download(downloadable, `${downloadable.payload.id}-${downloadable.payload.kind}.json`);
+});
+$('download-key').addEventListener('click', () => {
+  if (currentKey) download(exportPublicKey(currentKey), `daily-grind-public-key-${currentKey.keyId.slice(0, 12)}.json`);
+});
+async function readJSONFile(file) {
+  if (!file || file.size > 65536) throw new Error('Choose a JSON file smaller than 64 KB.');
+  return file.text();
+}
+function invalidateVerification() {
+  downloadable = undefined;
+  $('download-document').disabled = true;
+  $('preview-state').textContent = 'AWAITING VERIFICATION';
+  $('seal-title').textContent = 'Verification pending';
+  $('seal-description').textContent = 'Verify the current document before trusting it.';
+}
+$('document-json').addEventListener('input', () => {
+  fileVersion++;
+  fileLoading = false;
+  $('document-file').value = '';
+  invalidateVerification();
+  status('Document changed. Verify its signature again.');
+});
+$('document-file').addEventListener('change', async () => {
+  const version = ++fileVersion;
+  fileLoading = true;
+  invalidateVerification();
+  try {
+    const text = await readJSONFile($('document-file').files[0]);
+    if (version !== fileVersion) return;
+    $('document-json').value = text;
+    status('Document loaded. Select Verify signature to check it.');
+  } catch (error) { if (version === fileVersion) status(friendlyError(error), 'error'); }
+  finally { if (version === fileVersion) fileLoading = false; }
+});
+$('use-last').addEventListener('click', () => {
+  if (!lastSigned) return;
+  fileVersion++;
+  fileLoading = false;
+  $('document-json').value = JSON.stringify(lastSigned, null, 2);
+  $('document-file').value = '';
+  invalidateVerification();
+  status('Your last signed sample is ready to verify.');
+});
+$('verify-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (fileLoading) { status('Please wait for the selected file to finish loading.', 'error'); return; }
+  const version = fileVersion;
+  $('verify-button').disabled = true;
+  invalidateVerification();
+  status('Checking the signature and trusted key…');
+  try {
+    const text = $('document-json').value;
+    if (text.length > 65536) throw new Error('Signed documents must be smaller than 64 KB.');
+    const signed = JSON.parse(text);
+    // Load previously created local keys, but never trust a key from a document.
+    if (['ML-DSA-65', 'Ed25519', 'ECDSA'].includes(signed?.suite)) await readKey(signed.suite, true);
+    const payload = await verifyDocument(signed, knownKeys.get(signed?.keyId));
+    if (version !== fileVersion) return;
+    downloadable = signed;
+    $('download-document').disabled = false;
+    render(payload, 'verified', signed.suite, signed.keyId);
+    status(`Signature valid. The ${payload.kind === 'voucher' ? 'gift voucher' : 'receipt'} is unchanged and matches trusted key ${signed.keyId.slice(0, 12)}…. This is a local sample, not proof of purchase or redeemable credit.`, 'success');
+  } catch (error) {
+    if (version !== fileVersion) return;
+    $('preview-state').textContent = 'NOT VERIFIED';
+    $('seal-title').textContent = 'Document not verified';
+    $('seal-description').textContent = 'Do not rely on this document.';
+    status(friendlyError(error), 'error');
+  } finally { $('verify-button').disabled = false; }
+});
+let trustVersion = 0;
+$('trust-file').addEventListener('change', async () => {
+  const version = ++trustVersion;
+  pendingKey = undefined;
+  $('pending-trust').hidden = true;
+  $('trust-status').textContent = 'Reading public key…';
+  try {
+    const data = JSON.parse(await readJSONFile($('trust-file').files[0]));
+    const key = await importPublicKey(data);
+    if (version !== trustVersion) return;
+    pendingKey = key;
+    $('trust-fingerprint').textContent = `${key.suite} · SHA-256 fingerprint: ${key.keyId}`;
+    $('pending-trust').hidden = false;
+    $('trust-status').textContent = 'Key loaded. Compare this fingerprint with the signer through a trusted channel before accepting it.';
+  } catch (error) { if (version === trustVersion) $('trust-status').textContent = friendlyError(error); }
+});
+$('trust-key').addEventListener('click', () => {
+  if (!pendingKey) return;
+  knownKeys.set(pendingKey.keyId, pendingKey);
+  $('trust-status').textContent = `Key ${pendingKey.keyId.slice(0, 12)}… is now trusted for this session. Verify your document again.`;
+  $('pending-trust').hidden = true;
+  pendingKey = undefined;
+});
+updatePreview();
