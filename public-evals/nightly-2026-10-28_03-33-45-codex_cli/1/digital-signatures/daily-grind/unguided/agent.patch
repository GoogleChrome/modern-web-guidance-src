diff --git a/tests/receipt-crypto.test.mjs b/tests/receipt-crypto.test.mjs
new file mode 100644
index 0000000..80f7a91
--- /dev/null
+++ b/tests/receipt-crypto.test.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { canonical, generateIdentity, signDocument, parseDocument, verifyDocument, exportPublicKey, importPublicKey } from '../receipt-crypto.mjs';
+if (!globalThis.crypto) globalThis.crypto = webcrypto;
+const identity = await generateIdentity();
+const other = await generateIdentity();
+const payload = (type = 'receipt') => ({
+  type, id: `DG-${type === 'receipt' ? 'R' : 'V'}-12345678-1234-4321-8123-123456789abc`,
+  issuedAt: '2026-10-28T10:00:00.000Z', currency: 'USD', customer: 'Jamie', note: 'Enjoy your coffee ☕',
+  items: [{ name: type === 'receipt' ? 'Maple Oat Latte' : 'Coffee gift voucher', quantity: 1, unitAmount: 550 }], totalAmount: 550
+});
+test('receipt and voucher signatures survive JSON round trips and reordered properties', async () => {
+  for (const type of ['receipt', 'voucher']) {
+    const doc = await signDocument(payload(type), identity);
+    const reordered = Object.fromEntries(Object.entries(doc).reverse());
+    assert.deepEqual(await verifyDocument(parseDocument(JSON.stringify(reordered)), identity.publicKey), payload(type));
+  }
+});
+test('private key cannot be exported; exported public key verifies on another device', async () => {
+  assert.equal(identity.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', identity.privateKey));
+  const imported = await importPublicKey(JSON.stringify(await exportPublicKey(identity)));
+  const doc = await signDocument(payload(), identity);
+  assert.equal(imported.keyId, identity.keyId);
+  assert.deepEqual(await verifyDocument(doc, imported.publicKey), payload());
+});
+test('validly shaped edits to every signed field invalidate signatures', async () => {
+  const original = await signDocument(payload(), identity);
+  for (const change of [
+    p => { p.customer = 'Someone else'; }, p => { p.note = 'Changed'; },
+    p => { p.items[0].unitAmount = 100; p.totalAmount = 100; },
+    p => { p.issuedAt = '2026-10-29T10:00:00.000Z'; },
+    p => { p.id = p.id.replace('12345678', '87654321'); },
+    p => { p.items[0].name = 'Espresso'; }
+  ]) {
+    const altered = structuredClone(original);
+    change(altered.payload);
+    await assert.rejects(verifyDocument(parseDocument(JSON.stringify(altered)), identity.publicKey), /Signature invalid/);
+  }
+});
+test('unknown signers, mismatched keys, and substituted signer identifiers are rejected', async () => {
+  const doc = await signDocument(payload(), identity);
+  await assert.rejects(verifyDocument(doc, undefined), /Unknown signer/);
+  await assert.rejects(verifyDocument(doc, other.publicKey), /does not match/);
+  const substituted = { ...doc, keyId: other.keyId };
+  await assert.rejects(verifyDocument(substituted, other.publicKey), /Signature invalid/);
+});
+test('unsupported metadata, broken signatures, invalid totals and oversized files are rejected', async () => {
+  const doc = await signDocument(payload(), identity);
+  const bad = [
+    { ...doc, version: 2 }, { ...doc, algorithm: 'none' }, { ...doc, signature: 'bad' },
+    { ...doc, unexpected: true }, { ...doc, payload: { ...doc.payload, totalAmount: 1 } },
+    { ...doc, payload: { ...doc.payload, currency: 'EUR' } },
+    { ...doc, payload: { ...doc.payload, issuedAt: 'yesterday' } }
+  ];
+  for (const value of bad) assert.throws(() => parseDocument(JSON.stringify(value)));
+  assert.throws(() => parseDocument('not JSON'), /not valid JSON/);
+  assert.throws(() => parseDocument(' '.repeat(100001)), /smaller than/);
+  const changedSignature = { ...doc, signature: (doc.signature[0] === 'A' ? 'B' : 'A') + doc.signature.slice(1) };
+  await assert.rejects(verifyDocument(parseDocument(JSON.stringify(changedSignature)), identity.publicKey), /Signature invalid/);
+});
+test('public key import rejects fingerprint edits and private key material', async () => {
+  const exported = await exportPublicKey(identity);
+  await assert.rejects(importPublicKey(JSON.stringify({ ...exported, keyId: other.keyId })), /fingerprint/);
+  await assert.rejects(importPublicKey(JSON.stringify({ ...exported, publicKey: { ...exported.publicKey, d: 'secret' } })), /private key material/);
+});
+test('invalid amounts cannot be signed and canonical serialization is stable', async () => {
+  await assert.rejects(signDocument({ ...payload(), totalAmount: -100 }, identity));
+  const invalid = payload(); invalid.items[0].quantity = 1.5;
+  await assert.rejects(signDocument(invalid, identity));
+  assert.equal(canonical({ z: { b: 1, a: 2 }, a: ['a', 'b'] }), canonical({ a: ['a', 'b'], z: { a: 2, b: 1 } }));
+});
