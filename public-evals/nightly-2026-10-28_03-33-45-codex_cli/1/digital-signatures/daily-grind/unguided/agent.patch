+import { generateIdentity, signDocument, parseDocument, verifyDocument, exportPublicKey, importPublicKey, fingerprint } from './receipt-crypto.mjs';
+const $ = id => document.getElementById(id);
+const menu = {
+  maple: { name: 'Maple Oat Latte', unitAmount: 550 },
+  espresso: { name: 'Dark Roast Espresso', unitAmount: 350 },
+  coldbrew: { name: 'Cold Brew', unitAmount: 450 }
+};
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const prettyFingerprint = keyId => keyId.match(/.{1,4}/g).join(' ');
+let type = 'receipt', identity, database, signedDocument, latestDocument, pendingKey;
+let revision = 0, verifyRevision = 0;
+const setText = (id, value) => { $(id).textContent = value; };
+function notify(title, message, error = false) {
+  const box = $('status');
+  box.replaceChildren();
+  const heading = document.createElement('strong');
+  heading.textContent = title;
+  box.append(heading, document.createTextNode(message));
+  box.classList.toggle('error', error);
+  box.hidden = false;
+}
+function clearStatus() { $('status').hidden = true; }
+function openDatabase() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Browser key storage is blocked. Close other Daily Grind tabs and reload.'));
+  });
+}
+function readKey(id) {
+  return new Promise((resolve, reject) => {
+    const request = database.transaction('keys', 'readonly').objectStore('keys').get(id);
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+function saveKey(id, value) {
+  return new Promise((resolve, reject) => {
+    const tx = database.transaction('keys', 'readwrite');
+    tx.objectStore('keys').put(value, id);
+    tx.oncomplete = () => resolve();
+    tx.onerror = tx.onabort = () => reject(tx.error || new Error('Could not save the public key.'));
+  });
+}
+// Recheck within one transaction so concurrent first visits retain the same identity.
+function saveInitialIdentity(candidate) {
+  return new Promise((resolve, reject) => {
+    const tx = database.transaction('keys', 'readwrite');
+    const store = tx.objectStore('keys');
+    const request = store.get('signer');
+    let selected;
+    request.onsuccess = () => {
+      selected = request.result || candidate;
+      if (!request.result) store.put(selected, 'signer');
+    };
+    tx.oncomplete = () => resolve(selected);
+    tx.onerror = tx.onabort = () => reject(tx.error || new Error('Could not save your signing key.'));
+  });
+}
+function getPayload() {
+  const quantity = type === 'receipt' ? Number($('quantity').value) : 1;
+  const item = type === 'receipt' ? menu[$('coffee').value] : { name: 'Coffee gift voucher', unitAmount: Number($('amount').value) };
+  return {
+    type, id: `DG-${type === 'receipt' ? 'R' : 'V'}-${crypto.randomUUID()}`,
+    issuedAt: new Date().toISOString(), currency: 'USD', customer: $('customer').value.trim(),
+    note: $('note').value.trim(), items: [{ ...item, quantity }], totalAmount: item.unitAmount * quantity
+  };
+}
+function renderPreview(payload, mode = 'draft', keyId) {
+  const isVoucher = payload.type === 'voucher';
+  const item = payload.items[0];
+  setText('preview-kind', isVoucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT');
+  setText('preview-id', mode === 'draft' ? (isVoucher ? 'A little joy, on the house' : 'Made for your daily ritual') : `${payload.id.slice(0, 13)}… · ${new Date(payload.issuedAt).toLocaleDateString()}`);
+  setText('preview-item', item.name);
+  setText('preview-price', money(item.unitAmount));
+  setText('preview-quantity', isVoucher ? 'For a well-deserved coffee break' : `${item.quantity} ${item.quantity === 1 ? 'cup' : 'cups'} · Made with care`);
+  setText('preview-total', money(payload.totalAmount));
+  setText('total-label', isVoucher ? 'Gift value' : 'Total');
+  $('preview-customer').hidden = !payload.customer;
+  setText('preview-customer', `${isVoucher ? 'For' : 'Customer'}: ${payload.customer}`);
+  $('preview-note').hidden = !payload.note;
+  setText('preview-note', payload.note);
+  $('signature-stamp').classList.toggle('signed', mode !== 'draft');
+  setText('stamp-title', mode === 'verified' ? 'Signature verified' : mode === 'signed' ? 'Digitally signed' : 'Ready for your signature');
+  setText('stamp-detail', keyId ? `ECDSA P-256 · Key ${keyId.slice(0, 12)}…` : 'A little proof. A lot of peace of mind.');
+  setText('preview-state', mode === 'draft' ? '• Live preview' : mode === 'verified' ? '✓ Verified document' : '✓ Signed document');
+}
+function updateDraft() {
+  revision++;
+  signedDocument = undefined;
+  $('download-button').disabled = true;
+  clearStatus();
+  // Draft previews remain useful even before crypto initializes.
+  const item = type === 'receipt' ? menu[$('coffee').value] : { name: 'Coffee gift voucher', unitAmount: Number($('amount').value) };
+  const quantity = type === 'receipt' ? Number($('quantity').value) : 1;
+  renderPreview({ type, customer: $('customer').value.trim(), note: $('note').value.trim(), items: [{ ...item, quantity: Number.isInteger(quantity) && quantity > 0 && quantity <= 50 ? quantity : 1 }], totalAmount: item.unitAmount * (Number.isInteger(quantity) && quantity > 0 && quantity <= 50 ? quantity : 1) });
+}
+function changeType(nextType) {
+  type = nextType;
+  const voucher = type === 'voucher';
+  for (const value of ['receipt', 'voucher']) {
+    $(`${value}-type`).classList.toggle('selected', type === value);
+    $(`${value}-type`).setAttribute('aria-pressed', String(type === value));
+  }
+  $('coffee-field').hidden = voucher;
+  $('quantity-field').hidden = voucher;
+  $('quantity').disabled = voucher;
+  $('amount-field').hidden = !voucher;
+  $('customer-label').replaceChildren(document.createTextNode(voucher ? 'Recipient name ' : 'Customer name '));
+  const optional = document.createElement('span');
+  optional.textContent = '(optional)';
+  $('customer-label').append(optional);
+  setText('sign-button', voucher ? '◇  Sign gift voucher  →' : '◇  Sign coffee receipt  →');
+  updateDraft();
+}
+function changeTab(tab) {
+  revision++;
+  for (const name of ['create', 'verify']) {
+    const selected = name === tab;
+    $(`${name}-tab`).setAttribute('aria-selected', String(selected));
+    $(`${name}-tab`).tabIndex = selected ? 0 : -1;
+    $(`${name}-panel`).hidden = !selected;
+  }
+  verifyRevision++;
+  clearStatus();
+  if (tab === 'create') {
+    if (signedDocument) renderPreview(signedDocument.payload, 'signed', signedDocument.keyId);
+    else updateDraft();
+    $('download-button').disabled = !signedDocument;
+  } else {
+    $('download-button').disabled = true;
+    if (latestDocument) renderPreview(latestDocument.payload, 'signed', latestDocument.keyId);
+  }
+}
+for (const tab of ['create', 'verify']) {
+  $(`${tab}-tab`).addEventListener('click', () => changeTab(tab));
+  $(`${tab}-tab`).addEventListener('keydown', event => {
+    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+    event.preventDefault();
+    const next = event.key === 'Home' ? 'create' : event.key === 'End' ? 'verify' : tab === 'create' ? 'verify' : 'create';
+    changeTab(next);
+    $(`${next}-tab`).focus();
+  });
+}
+$('receipt-type').addEventListener('click', () => changeType('receipt'));
+$('voucher-type').addEventListener('click', () => changeType('voucher'));
+$('sign-form').addEventListener('input', updateDraft);
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!identity || !$('sign-form').reportValidity()) return;
+  const currentRevision = revision;
+  $('sign-button').disabled = true;
+  setText('sign-button', 'Signing securely…');
+  try {
+    const result = await signDocument(getPayload(), identity);
+    if (currentRevision !== revision) return;
+    signedDocument = latestDocument = result;
+    $('use-latest').hidden = false;
+    $('download-button').disabled = false;
+    renderPreview(result.payload, 'signed', result.keyId);
+    notify('Signed and ready to share.', 'Your document is signed with this browser’s key. Download it, or use Verify a document to check its signature.');
+  } catch (error) {
+    if (currentRevision === revision) notify('Could not sign the document.', error.message, true);
+  }
+  finally {
+    $('sign-button').disabled = !identity;
+    setText('sign-button', type === 'receipt' ? '◇  Sign coffee receipt  →' : '◇  Sign gift voucher  →');
+  }
+});
+function downloadJSON(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download-button').addEventListener('click', () => {
+  if (signedDocument) downloadJSON(signedDocument, `${signedDocument.payload.id}.json`);
+});
+function resetVerification() {
+  verifyRevision++;
+  clearStatus();
+  $('download-button').disabled = true;
+  setText('preview-state', '• Awaiting verification');
+  $('signature-stamp').classList.remove('signed');
+  setText('stamp-title', 'Awaiting verification');
+  setText('stamp-detail', 'Check this document against a trusted key.');
+}
+$('document-json').addEventListener('input', resetVerification);
+$('document-file').addEventListener('change', async event => {
+  const file = event.target.files[0];
+  if (!file) return;
+  resetVerification();
+  const current = verifyRevision;
+  try {
+    if (file.size > 100000) throw new Error('Choose a document smaller than 100 KB.');
+    const text = await file.text();
+    if (current !== verifyRevision) return;
+    $('document-json').value = text;
+    notify('Document loaded.', `${file.name} is ready. Select Verify document to check its signature.`);
+  } catch (error) { notify('Could not load the document.', error.message, true); }
+  event.target.value = '';
+});
+$('use-latest').addEventListener('click', () => {
+  if (!latestDocument) return;
+  $('document-json').value = JSON.stringify(latestDocument, null, 2);
+  resetVerification();
+  $('document-json').focus();
+});
+$('verify-button').addEventListener('click', async () => {
+  resetVerification();
+  const current = verifyRevision;
+  $('verify-button').disabled = true;
+  try {
+    const doc = parseDocument($('document-json').value);
+    const key = doc.keyId === identity.keyId ? identity.publicKey : (await readKey(`trusted:${doc.keyId}`))?.publicKey;
+    await verifyDocument(doc, key);
+    if (current !== verifyRevision) return;
+    renderPreview(doc.payload, 'verified', doc.keyId);
+    notify('Signature verified. Details intact.', `This ${doc.payload.type} matches a public key you trust (${doc.keyId.slice(0, 12)}…). This does not confirm payment or redemption eligibility.`);
+  } catch (error) {
+    if (current !== verifyRevision) return;
+    setText('preview-state', '× Not verified');
+    setText('stamp-title', 'Document not verified');
+    setText('stamp-detail', 'Do not rely on the displayed document.');
+    notify('Document not verified.', error.message, true);
+  } finally { $('verify-button').disabled = !identity; }
+});
+$('export-key').addEventListener('click', async () => {
+  try { downloadJSON(await exportPublicKey(identity), `daily-grind-public-key-${identity.keyId.slice(0, 12)}.json`); }
+  catch (error) { setText('key-status', `Could not export the public key: ${error.message}`); }
+});
+$('key-file').addEventListener('change', async event => {
+  const file = event.target.files[0];
+  pendingKey = undefined;
+  $('pending-key').hidden = true;
+  if (!file) return;
+  try {
+    if (file.size > 10000) throw new Error('Choose a public key file smaller than 10 KB.');
+    pendingKey = await importPublicKey(await file.text());
+    setText('pending-fingerprint', prettyFingerprint(pendingKey.keyId));
+    $('pending-key').hidden = false;
+    setText('key-status', 'Key loaded, but not yet trusted.');
+  } catch (error) { setText('key-status', error.message); }
+  event.target.value = '';
+});
+$('confirm-key').addEventListener('click', async () => {
+  if (!pendingKey) return;
+  $('confirm-key').disabled = true;
+  try {
+    const candidate = pendingKey;
+    await saveKey(`trusted:${candidate.keyId}`, candidate);
+    setText('key-status', `Trusted public key saved: ${candidate.keyId.slice(0, 12)}…. You can now verify its documents.`);
+    pendingKey = undefined;
+    $('pending-key').hidden = true;
+  } catch (error) { setText('key-status', `Could not save the public key: ${error.message}`); }
+  finally { $('confirm-key').disabled = false; }
+});
+$('cancel-key').addEventListener('click', () => {
+  pendingKey = undefined;
+  $('pending-key').hidden = true;
+  setText('key-status', 'Import cancelled. No key was trusted.');
+});
+async function initialize() {
+  try {
+    if (!globalThis.isSecureContext || !globalThis.crypto?.subtle || !globalThis.indexedDB) throw new Error('Signing requires HTTPS and a browser with Web Crypto and IndexedDB enabled.');
+    database = await openDatabase();
+    identity = await readKey('signer');
+    if (!identity) identity = await saveInitialIdentity(await generateIdentity());
+    if (!identity.privateKey || identity.privateKey.extractable || await fingerprint(identity.publicKey) !== identity.keyId) throw new Error('The saved signing key is unavailable or invalid.');
+    setText('key-summary', '· ECDSA P-256 · Ready on this device');
+    setText('key-description', 'Your non-exportable private key is saved in this browser. The public key below identifies this local signer. Share it, along with its fingerprint, so someone else can verify your documents.');
+    setText('fingerprint', prettyFingerprint(identity.keyId));
+    for (const id of ['sign-button', 'verify-button', 'export-key', 'key-file']) $(id).disabled = false;
+  } catch (error) {
+    identity = undefined;
+    setText('key-summary', '· Unavailable');
+    setText('key-description', error.message);
+    $('key-dot').style.background = '#b47c5b';
+    notify('Secure signing is unavailable.', `${error.message} No document has been signed.`, true);
+  }
+}
+initialize();
