new file mode 100644
index 0000000..857528c
--- /dev/null
+++ b/receipt-crypto.mjs
@@ -0,0 +1,87 @@
+// Versioned, deterministic signed format. No embedded public key is implicitly trusted.
+export const ALGORITHM = 'ECDSA-P256-SHA256';
+export const FORMAT = 'daily-grind-document';
+const encoder = new TextEncoder();
+const operation = { name: 'ECDSA', hash: 'SHA-256' };
+export const canonical = value => {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`;
+};
+const exactKeys = (value, keys) => value && typeof value === 'object' && !Array.isArray(value) && Object.keys(value).sort().join('|') === [...keys].sort().join('|');
+const boundedText = (value, limit) => typeof value === 'string' && value.length <= limit;
+export function validatePayload(p) {
+  if (!exactKeys(p, ['type', 'id', 'issuedAt', 'currency', 'customer', 'note', 'items', 'totalAmount']) ||
+      !['receipt', 'voucher'].includes(p.type) || p.currency !== 'USD' ||
+      typeof p.id !== 'string' || !/^DG-[RV]-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(p.id) ||
+      !p.id.startsWith(p.type === 'receipt' ? 'DG-R-' : 'DG-V-') ||
+      typeof p.issuedAt !== 'string' || !Number.isFinite(Date.parse(p.issuedAt)) || new Date(p.issuedAt).toISOString() !== p.issuedAt ||
+      !boundedText(p.customer, 80) || !boundedText(p.note, 200) ||
+      !Number.isSafeInteger(p.totalAmount) || p.totalAmount <= 0 || p.totalAmount > 50000000 ||
+      !Array.isArray(p.items) || p.items.length !== 1) throw new Error('This document has an invalid or unsupported format.');
+  const item = p.items[0];
+  if (!exactKeys(item, ['name', 'quantity', 'unitAmount']) || !boundedText(item.name, 100) || !item.name.length ||
+      !Number.isSafeInteger(item.quantity) || item.quantity < 1 || item.quantity > 50 ||
+      !Number.isSafeInteger(item.unitAmount) || item.unitAmount <= 0 ||
+      item.unitAmount * item.quantity !== p.totalAmount ||
+      (p.type === 'voucher' && (item.quantity !== 1 || item.name !== 'Coffee gift voucher'))) {
+    throw new Error('The document amounts or line items are invalid.');
+  }
+  return p;
+}
+function toBase64(buffer) {
+  return btoa(String.fromCharCode(...new Uint8Array(buffer)));
+}
+function fromSignature(value) {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9+/]{86}==$/.test(value)) throw new Error('The digital signature is malformed.');
+  return Uint8Array.from(atob(value), char => char.charCodeAt(0));
+}
+export async function fingerprint(publicKey) {
+  const spki = await crypto.subtle.exportKey('spki', publicKey);
+  const hash = await crypto.subtle.digest('SHA-256', spki);
+  return [...new Uint8Array(hash)].map(byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function generateIdentity() {
+  const keys = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+  return { ...keys, keyId: await fingerprint(keys.publicKey) };
+}
+export async function signDocument(payload, identity) {
+  validatePayload(payload);
+  const body = { format: FORMAT, version: 1, algorithm: ALGORITHM, keyId: identity.keyId, payload };
+  const signature = await crypto.subtle.sign(operation, identity.privateKey, encoder.encode(canonical(body)));
+  return { ...body, signature: toBase64(signature) };
+}
+export function parseDocument(text) {
+  if (typeof text !== 'string' || text.length > 100000) throw new Error('Choose a document smaller than 100 KB.');
+  let doc;
+  try { doc = JSON.parse(text); } catch { throw new Error('That is not valid JSON. Paste or upload the complete signed document.'); }
+  if (!exactKeys(doc, ['format', 'version', 'algorithm', 'keyId', 'payload', 'signature']) ||
+      doc.format !== FORMAT || doc.version !== 1 || doc.algorithm !== ALGORITHM ||
+      typeof doc.keyId !== 'string' || !/^[a-f0-9]{64}$/.test(doc.keyId)) throw new Error('This is not a supported Daily Grind signed document.');
+  validatePayload(doc.payload);
+  fromSignature(doc.signature);
+  return doc;
+}
+export async function verifyDocument(doc, trustedKey) {
+  doc = parseDocument(JSON.stringify(doc));
+  if (!trustedKey) throw new Error('Unknown signer. Import and confirm the signer’s public key in “Your signing key” before verifying.');
+  if (await fingerprint(trustedKey) !== doc.keyId) throw new Error('The public key does not match this document’s signer.');
+  const { signature, ...body } = doc;
+  const valid = await crypto.subtle.verify(operation, trustedKey, fromSignature(signature), encoder.encode(canonical(body)));
+  if (!valid) throw new Error('Signature invalid. The document was changed or was not signed by the trusted key.');
+  return doc.payload;
+}
+export async function exportPublicKey(identity) {
+  return { format: 'daily-grind-public-key', algorithm: ALGORITHM, keyId: identity.keyId, publicKey: await crypto.subtle.exportKey('jwk', identity.publicKey) };
+}
+export async function importPublicKey(text) {
+  if (text.length > 10000) throw new Error('The public key file is too large.');
+  let data;
+  try { data = JSON.parse(text); } catch { throw new Error('Choose a valid public key JSON file.'); }
+  if (!exactKeys(data, ['format', 'algorithm', 'keyId', 'publicKey']) || data.format !== 'daily-grind-public-key' || data.algorithm !== ALGORITHM ||
+      !data.publicKey || data.publicKey.kty !== 'EC' || data.publicKey.crv !== 'P-256' || 'd' in data.publicKey) throw new Error('Choose an exported Daily Grind P-256 public key, without private key material.');
+  const publicKey = await crypto.subtle.importKey('jwk', data.publicKey, { name: 'ECDSA', namedCurve: 'P-256' }, true, ['verify']);
+  const keyId = await fingerprint(publicKey);
+  if (data.keyId !== keyId) throw new Error('The public key fingerprint does not match the file.');
+  return { publicKey, keyId };
+}
