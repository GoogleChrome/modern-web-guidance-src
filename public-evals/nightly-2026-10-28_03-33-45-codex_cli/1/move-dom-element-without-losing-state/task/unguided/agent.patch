+  <script>
+    (function () {
+      var hero = document.querySelector('.hero');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var home = document.getElementById('video-home');
+      var panel = document.getElementById('video-panel');
+      var toggle = document.getElementById('theater-toggle');
+      var canMove = typeof heroSlot.moveBefore === 'function';
+      var theater = false;
+
+      function positionLegacyPlayer() {
+        if (canMove || !theater) return;
+        panel.style.width = heroSlot.getBoundingClientRect().width + 'px';
+        heroSlot.style.height = panel.getBoundingClientRect().height + 'px';
+        var bounds = heroSlot.getBoundingClientRect();
+        panel.style.left = bounds.left + window.pageXOffset + 'px';
+        panel.style.top = bounds.top + window.pageYOffset + 'px';
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', function () {
+        theater = !theater;
+        heroSlot.hidden = !theater;
+        hero.classList.toggle('is-theater', theater);
+
+        if (canMove) {
+          // Move the connected panel and its iframe atomically. Never reset src,
+          // clone the iframe, or detach it with appendChild/insertBefore.
+          (theater ? heroSlot : home).moveBefore(panel, null);
+        } else {
+          // Traditional reparenting reloads iframes. Keep the original DOM parent
+          // and reserve an equally sized hero slot for this visual fallback.
+          panel.classList.toggle('legacy-theater', theater);
+          if (!theater) {
+            panel.style.width = '';
+            panel.style.left = '';
+            panel.style.top = '';
+            heroSlot.style.height = '';
+          }
+        }
+
+        toggle.setAttribute('aria-pressed', String(theater));
+        toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        positionLegacyPlayer();
+        // Keep the player and the return control in view in either location.
+        panel.scrollIntoView({ block: 'center' });
+      });
+
+      window.addEventListener('resize', positionLegacyPlayer);
+      if (!canMove && typeof ResizeObserver === 'function') {
+        new ResizeObserver(positionLegacyPlayer).observe(panel);
+      }
+    }());
+  </script>
+
