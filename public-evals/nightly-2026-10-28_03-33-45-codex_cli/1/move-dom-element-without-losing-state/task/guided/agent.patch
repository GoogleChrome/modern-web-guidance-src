+  <script>
+    const player = document.getElementById('roasting-player');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const heroVideo = document.getElementById('hero-video');
+    const hero = document.querySelector('.hero');
+    const toggle = document.getElementById('theater-toggle');
+    const heroToggle = document.getElementById('hero-theater-toggle');
+    const placeholder = document.getElementById('video-placeholder');
+    const canMoveWithoutReload = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionLegacyPlayer() {
+      if (canMoveWithoutReload || !theaterMode) return;
+
+      // Keep the iframe connected to its original parent: insertBefore/appendChild
+      // would reload it. Translate it over the hero's reserved slot instead.
+      const origin = mainSlot.getBoundingClientRect();
+      const destination = heroSlot.getBoundingClientRect();
+      player.style.transform = `translate(${destination.left - origin.left}px, ${destination.top - origin.top}px)`;
+      player.style.width = `${destination.width}px`;
+      player.style.height = `${destination.height}px`;
+      player.style.zIndex = '1';
+    }
+
+    function toggleTheaterMode() {
+      theaterMode = !theaterMode;
+      const destination = theaterMode ? heroSlot : mainSlot;
+
+      // Reveal the destination before moving; never recreate the iframe or set src.
+      if (theaterMode) heroVideo.hidden = false;
+      hero.classList.toggle('theater-active', theaterMode);
+
+      if (canMoveWithoutReload) {
+        destination.moveBefore(player, null);
+      } else if (theaterMode) {
+        positionLegacyPlayer();
+      } else {
+        ['transform', 'width', 'height', 'z-index'].forEach(property => {
+          player.style.removeProperty(property);
+        });
+      }
+
+      placeholder.hidden = !theaterMode;
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      heroToggle.setAttribute('aria-pressed', String(theaterMode));
+      // Transfer focus before hiding the hero's control on the return trip.
+      (theaterMode ? heroToggle : toggle).focus({ preventScroll: true });
+      heroVideo.hidden = !theaterMode;
+      destination.scrollIntoView({ block: 'center' });
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', toggleTheaterMode);
+    heroToggle.addEventListener('click', toggleTheaterMode);
+
+    if (!canMoveWithoutReload) {
+      window.addEventListener('resize', positionLegacyPlayer);
+      window.addEventListener('load', positionLegacyPlayer);
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(positionLegacyPlayer);
+        [hero, heroSlot, mainSlot].forEach(element => observer.observe(element));
+      }
+    }
+  </script>
