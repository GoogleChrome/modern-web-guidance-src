+  <script>
+    (() => {
+      const panel = document.querySelector('#quick-order');
+      const handle = document.querySelector('#order-handle');
+      const launcher = document.querySelector('#cart-launcher');
+      const drink = document.querySelector('#coffee-drink');
+      const size = document.querySelector('#coffee-size');
+      const feedback = document.querySelector('#order-feedback');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const menu = { maple: { name: 'Maple Oat Latte', price: 550 }, espresso: { name: 'Dark Roast Espresso', price: 350 }, coldbrew: { name: 'Cold Brew', price: 450 } };
+      let quantity = 1;
+      let temperature = 'hot';
+      let bag = [];
+      try {
+        const saved = JSON.parse(sessionStorage.getItem('daily-grind-bag') || '[]');
+        if (Array.isArray(saved)) bag = saved.filter(item =>
+          item && typeof item.name === 'string' && ['regular', 'large'].includes(item.size) &&
+          ['hot', 'iced'].includes(item.temperature) && Number.isInteger(item.quantity) &&
+          item.quantity > 0 && item.quantity <= 20 && Number.isInteger(item.total) && item.total > 0
+        );
+      } catch { /* The cart also works when browser storage is unavailable. */ }
+      let offsetX = 0, offsetY = 0;
+      const subtotal = () => (menu[drink.value].price + (size.value === 'large' ? 100 : 0)) * quantity;
+      const format = cents => money.format(cents / 100);
+      function updateOptions() {
+        document.querySelector('#quantity').value = quantity;
+        document.querySelector('#decrease').disabled = quantity <= 1;
+        document.querySelector('#increase').disabled = quantity >= 20;
+        document.querySelector('#coffee-price').value = format(subtotal());
+        document.querySelectorAll('[data-temp]').forEach(button => {
+          button.disabled = drink.value === 'coldbrew' && button.dataset.temp === 'hot';
+          button.setAttribute('aria-pressed', String(button.dataset.temp === temperature));
+        });
+      }
+      drink.addEventListener('change', () => { if (drink.value === 'coldbrew') temperature = 'iced'; updateOptions(); feedback.textContent = ''; });
+      size.addEventListener('change', updateOptions);
+      document.querySelectorAll('[data-temp]').forEach(button => button.addEventListener('click', () => { temperature = button.dataset.temp; updateOptions(); }));
+      document.querySelector('#decrease').addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateOptions(); });
+      document.querySelector('#increase').addEventListener('click', () => { quantity = Math.min(20, quantity + 1); updateOptions(); });
+      function updateBag() {
+        try { sessionStorage.setItem('daily-grind-bag', JSON.stringify(bag)); } catch { /* Keep the current bag in memory. */ }
+        const count = bag.reduce((sum, item) => sum + item.quantity, 0);
+        const total = bag.reduce((sum, item) => sum + item.total, 0);
+        document.querySelector('#order-count').textContent = count;
+        document.querySelector('#order-count').setAttribute('aria-label', `${count} items in bag`);
+        document.querySelector('#launcher-count').textContent = count;
+        document.querySelector('#bag-summary').textContent = `Your bag · ${count} ${count === 1 ? 'item' : 'items'}${count ? ' · ' + format(total) : ''}`;
+        document.querySelector('#bag-empty').hidden = count > 0;
+        document.querySelector('#continue-order').hidden = count === 0;
+        const list = document.querySelector('#bag-items');
+        list.replaceChildren();
+        bag.forEach((item, index) => {
+          const row = document.createElement('li');
+          const description = document.createElement('span');
+          description.textContent = `${item.quantity} × ${item.name}`;
+          const detail = document.createElement('small');
+          detail.textContent = `${item.size} · ${item.temperature} · ${format(item.total)}`;
+          description.append(detail);
+          const remove = document.createElement('button');
+          remove.type = 'button'; remove.className = 'remove-item'; remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${item.name} from bag`);
+          remove.addEventListener('click', () => {
+            bag.splice(index, 1); updateBag();
+            feedback.textContent = `${item.name} removed from your bag.`;
+            document.querySelector('#bag-summary').focus();
+          });
+          row.append(description, remove); list.append(row);
+        });
+      }
+      document.querySelector('#coffee-form').addEventListener('submit', event => {
+        event.preventDefault();
+        bag.push({ name: menu[drink.value].name, size: size.value, temperature, quantity, total: subtotal() });
+        updateBag();
+        feedback.textContent = `${quantity} ${menu[drink.value].name} added to your bag.`;
+      });
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        panel.style.right = 'auto'; panel.style.bottom = 'auto';
+      }
+      function clampPosition() {
+        if (panel.hidden) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+      document.querySelector('#minimize-order').hidden = false;
+      handle.disabled = false;
+      handle.classList.add('ready');
+      handle.setAttribute('aria-label', 'Move quick order panel. Drag or use arrow keys.');
+      handle.addEventListener('pointerdown', event => {
+        if (event.button !== 0 || !event.isPrimary) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left; offsetY = event.clientY - rect.top;
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('dragging');
+      });
+      handle.addEventListener('pointermove', event => {
+        if (handle.hasPointerCapture(event.pointerId)) moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      const stopDrag = event => {
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+        handle.classList.remove('dragging');
+      };
+      handle.addEventListener('pointerup', stopDrag);
+      handle.addEventListener('pointercancel', stopDrag);
+      handle.addEventListener('lostpointercapture', () => handle.classList.remove('dragging'));
+      handle.addEventListener('keydown', event => {
+        const movements = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        const movement = movements[event.key];
+        if (!movement) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + movement[0], rect.top + movement[1]);
+      });
+      document.querySelector('#minimize-order').addEventListener('click', () => {
+        panel.hidden = true; launcher.hidden = false; launcher.setAttribute('aria-expanded', 'false'); launcher.focus();
+      });
+      launcher.addEventListener('click', () => {
+        panel.hidden = false; launcher.hidden = true; launcher.setAttribute('aria-expanded', 'true'); clampPosition(); handle.focus();
+      });
+      window.addEventListener('resize', clampPosition);
+      new ResizeObserver(clampPosition).observe(panel);
+      updateOptions();
+      updateBag();
+    })();
+  </script>
+
