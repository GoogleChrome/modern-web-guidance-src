+  <script>
+    (() => {
+      const panel = document.getElementById('coffee-cart');
+      const handle = document.getElementById('cart-handle');
+      const body = document.getElementById('cart-body');
+      const toggle = document.getElementById('cart-toggle');
+      const drink = document.getElementById('cart-drink');
+      const minus = document.getElementById('cart-minus');
+      const plus = document.getElementById('cart-plus');
+      const status = document.getElementById('cart-status');
+      const menu = {
+        maple: { name: 'Maple Oat Latte', price: 550 },
+        espresso: { name: 'Dark Roast Espresso', price: 350 },
+        coldbrew: { name: 'Cold Brew', price: 450 }
+      };
+      const sizePrices = { S: -50, M: 0, L: 75 };
+      const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+      let quantity = 1;
+      let cart = [];
+      const size = () => document.querySelector('input[name="size"]:checked').value;
+      const unitPrice = () => menu[drink.value].price + sizePrices[size()];
+      function updateSelection() {
+        document.getElementById('cart-quantity').value = quantity;
+        document.getElementById('cart-price').textContent = money(unitPrice() * quantity);
+        minus.disabled = quantity === 1;
+        plus.disabled = quantity === 20;
+      }
+      minus.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateSelection(); });
+      plus.addEventListener('click', () => { quantity = Math.min(20, quantity + 1); updateSelection(); });
+      document.getElementById('quick-order-form').addEventListener('change', updateSelection);
+      function renderCart() {
+        const list = document.getElementById('cart-items');
+        list.replaceChildren();
+        let count = 0;
+        let total = 0;
+        cart.forEach(item => {
+          count += item.quantity;
+          total += item.price * item.quantity;
+          const row = document.createElement('li');
+          row.className = 'cart-item';
+          const name = document.createElement('span');
+          name.textContent = `${item.quantity} × ${menu[item.drink].name} (${item.size})`;
+          const price = document.createElement('span');
+          price.textContent = money(item.price * item.quantity);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${menu[item.drink].name}, size ${item.size}`);
+          remove.addEventListener('click', () => {
+            cart = cart.filter(entry => entry !== item);
+            renderCart();
+            status.textContent = `${menu[item.drink].name} removed.`;
+            document.getElementById('cart-drink').focus();
+          });
+          row.append(name, price, remove);
+          list.append(row);
+        });
+        document.getElementById('cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+        document.getElementById('cart-total').textContent = money(total);
+        document.getElementById('cart-empty').hidden = count > 0;
+        document.getElementById('cart-clear').hidden = count === 0;
+        keepInBounds();
+      }
+      document.getElementById('quick-order-form').addEventListener('submit', event => {
+        event.preventDefault();
+        const existing = cart.find(item => item.drink === drink.value && item.size === size());
+        if (existing) existing.quantity += quantity;
+        else cart.push({ drink: drink.value, size: size(), price: unitPrice(), quantity });
+        renderCart();
+        status.textContent = `${quantity} ${menu[drink.value].name} added to your cart.`;
+      });
+      document.getElementById('cart-clear').addEventListener('click', () => {
+        cart = [];
+        renderCart();
+        status.textContent = 'Your cart is cleared.';
+        drink.focus();
+      });
+      function movePanel(x, y) {
+        const rect = panel.getBoundingClientRect();
+        panel.style.left = `${Math.max(12, Math.min(x, window.innerWidth - rect.width - 12))}px`;
+        panel.style.top = `${Math.max(12, Math.min(y, window.innerHeight - rect.height - 12))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      }
+      function keepInBounds() {
+        if (!panel.style.left) return;
+        const rect = panel.getBoundingClientRect();
+        movePanel(rect.left, rect.top);
+      }
+      let drag = null;
+      handle.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        const rect = panel.getBoundingClientRect();
+        drag = { id: event.pointerId, x: event.clientX - rect.left, y: event.clientY - rect.top };
+        handle.setPointerCapture(event.pointerId);
+        panel.classList.add('is-dragging');
+      });
+      handle.addEventListener('pointermove', event => {
+        if (drag && event.pointerId === drag.id) movePanel(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      function endDrag() { drag = null; panel.classList.remove('is-dragging'); }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', endDrag);
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+        if (!directions[event.key]) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        const [x, y] = directions[event.key];
+        const step = event.shiftKey ? 40 : 10;
+        movePanel(rect.left + x * step, rect.top + y * step);
+      });
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand quick order' : 'Minimize quick order');
+        toggle.textContent = body.hidden ? '+' : '−';
+        keepInBounds();
+      });
+      window.addEventListener('resize', keepInBounds);
+      new ResizeObserver(keepInBounds).observe(panel);
+      updateSelection();
+    })();
+  </script>
+
 </body>
 
