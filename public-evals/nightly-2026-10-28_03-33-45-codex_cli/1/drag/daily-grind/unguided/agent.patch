+  <aside class="coffee-cart" id="coffee-cart" aria-label="Quick coffee order">
+    <header class="cart-header">
+      <button type="button" class="cart-handle" id="cart-handle" aria-label="Move quick order panel. Drag or use arrow keys." aria-describedby="cart-drag-hint">
