+          </div></fieldset>
+          <div><span class="cart-label" id="quantity-label">Quantity</span><div class="cart-stepper" role="group" aria-labelledby="quantity-label">
+            <button type="button" id="cart-minus" aria-label="Decrease quantity" disabled>−</button>
