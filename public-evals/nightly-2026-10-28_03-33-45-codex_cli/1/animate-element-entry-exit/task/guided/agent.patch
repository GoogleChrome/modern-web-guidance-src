+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    let promoCount = 0;
+    let busy = false;
+
+    // Probe actual behavior: some browsers parse allow-discrete without
+    // keeping display visible for the duration of an exit transition.
+    function canTransitionDisplay() {
+      if (!window.CSS?.supports('transition-behavior', 'allow-discrete')) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.append(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      const supported = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supported;
+    }
+
+    const supportsDisplayTransition = canTransitionDisplay();
+
+    function updateControls() {
+      removeBtn.disabled = busy || !domContainer.querySelector('.card');
+      toggleBtn.disabled = busy || !toggleCard.isConnected;
+      toggleBtn.setAttribute('aria-expanded', String(toggleCard.isConnected && !toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show featured promo' : 'Hide featured promo';
+    }
+
+    async function hideCard(card) {
+      if (card.hidden) return;
+      // Finish a first style update before starting the exit, even if the
+      // card was just inserted by a previous click.
+      getComputedStyle(card).opacity;
+      if (supportsDisplayTransition) card.hidden = true;
+      else card.setAttribute('data-closing', '');
+
+      let timeout;
+      try {
+        await Promise.race([
+          Promise.allSettled(card.getAnimations().map(animation => animation.finished)),
+          new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+        ]);
+      } finally {
+        clearTimeout(timeout);
+        card.hidden = true;
+        card.removeAttribute('data-closing');
+      }
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Fresh Perks • Promo ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Pair your favorite coffee with a freshly baked pastry for a delicious break.';
+      card.append(heading, description);
+      domContainer.append(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.querySelector('.card:last-child');
+      if (!card || busy) return;
+      busy = true;
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      busy = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (busy || !toggleCard.isConnected) return;
+      busy = true;
+      updateControls();
+      if (toggleCard.hidden) toggleCard.hidden = false;
+      else await hideCard(toggleCard);
+      busy = false;
+      updateControls();
+    });
+  </script>
+
