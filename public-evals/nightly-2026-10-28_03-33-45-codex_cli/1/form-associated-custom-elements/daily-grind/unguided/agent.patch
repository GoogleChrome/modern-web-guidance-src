diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..bb56e28
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,179 @@
+// A form-associated control: no hidden input or submission interception needed.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #buttons;
+  #status;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+    const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    shadow.innerHTML = `
+      <style>
+        :host { display: block; }
+        .rating { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
+        .stars { display: flex; gap: 4px; }
+        button {
+          display: grid; place-items: center; width: 42px; height: 44px;
+          padding: 0; border: 1px solid #e5d9ce; border-radius: 6px;
+          background: #faf7f3; color: #aa9685; cursor: pointer;
+        }
+        svg { width: 27px; height: 27px; fill: transparent; stroke: currentColor; stroke-width: 1.5; }
+        button[data-filled] { color: #a45e13; background: #fff4df; border-color: #dfb57c; }
+        button[data-filled] svg { fill: #eeb555; }
+        button:focus-visible { outline: 3px solid #c57923; outline-offset: 3px; }
+        button:disabled { cursor: not-allowed; opacity: 0.5; }
+        .status { font: 0.85rem 'Segoe UI', sans-serif; color: #725c52; }
+        .error { margin: 8px 0 0; color: #a32920; font: 0.85rem 'Segoe UI', sans-serif; }
+        .error[hidden] { display: none; }
+        :host([data-invalid]) button { border-color: #a32920; }
+        @media (forced-colors: active) {
+          button[data-filled] { border: 2px solid Highlight; color: Highlight; }
+          button[data-filled] svg { fill: Highlight; }
+        }
+      </style>
+      <div class="rating">
+        <div class="stars">
+          ${[1, 2, 3, 4, 5].map(value => `
+            <button type="button" role="radio" aria-label="${value} ${value === 1 ? 'star' : 'stars'}" data-value="${value}">
+              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z"/></svg>
+            </button>`).join('')}
+        </div>
+        <span class="status" aria-live="polite"></span>
+      </div>
+      <p class="error" id="error" hidden>Please choose a star rating.</p>`;
+    this.#buttons = [...shadow.querySelectorAll('button')];
+    this.#status = shadow.querySelector('.status');
+
+    for (const button of this.#buttons) {
+      button.addEventListener('click', () => this.#choose(button.dataset.value));
+      button.addEventListener('keydown', event => {
+        const current = Number(button.dataset.value);
+        let next;
+        switch (event.key) {
+          case 'ArrowRight': case 'ArrowDown': next = current % 5 + 1; break;
+          case 'ArrowLeft': case 'ArrowUp': next = (current + 3) % 5 + 1; break;
+          case 'Home': next = 1; break;
+          case 'End': next = 5; break;
+          default: return;
+        }
+        event.preventDefault();
+        this.#choose(String(next));
+        this.#buttons[next - 1].focus();
+      });
+    }
+    this.addEventListener('invalid', () => this.#showError(true));
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(newValue);
+    this.#sync();
+  }
+
+  get form() { return this.#internals.form; }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get type() { return 'star-rating'; }
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  get labels() { return this.#internals.labels; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  focus(options) {
+    if (!this.#disabled && !this.disabled) {
+      this.#buttons[Math.max(0, Number(this.#value) - 1)].focus(options);
+    }
+  }
+
+  formDisabledCallback(disabled) {
+    // Includes inherited disabled state from an ancestor fieldset.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#showError(false);
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state, mode) {
+    this.value = state;
+    this.#showError(false);
+  }
+
+  #normalize(value) {
+    const text = String(value ?? '');
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #choose(value) {
+    if (this.#disabled || this.disabled) return;
+    const previous = this.#value;
+    this.value = value;
+    if (previous !== this.#value) {
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+  }
+
+  #showError(show) {
+    this.toggleAttribute('data-invalid', show);
+    this.#internals.ariaInvalid = String(show);
+    this.shadowRoot.querySelector('.error').hidden = !show;
+    for (const button of this.#buttons) {
+      if (show) button.setAttribute('aria-describedby', 'error');
+      else button.removeAttribute('aria-describedby');
+    }
+  }
+
+  #sync() {
+    const disabled = this.#disabled || this.disabled;
+    const missing = this.required && !this.#value;
+    // The second argument is the state passed back on history/session restore.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a star rating.' : '',
+      this.#buttons[0],
+    );
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(disabled);
+    this.#buttons.forEach((button, index) => {
+      const selected = Number(this.#value) === index + 1;
+      button.setAttribute('aria-checked', String(selected));
+      button.toggleAttribute('data-filled', index < Number(this.#value));
+      button.tabIndex = !disabled && (selected || (!this.#value && index === 0)) ? 0 : -1;
+      button.disabled = disabled;
+    });
+    this.#status.textContent = this.#value ? `${this.#value} out of 5` : 'Select a rating';
+    if (!missing || disabled) this.#showError(false);
+  }
+}
+
+customElements.define('star-rating', StarRating);
