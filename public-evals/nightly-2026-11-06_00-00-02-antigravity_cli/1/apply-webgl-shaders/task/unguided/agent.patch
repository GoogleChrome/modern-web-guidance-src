+          const cx = ((r.left - heroRect.left) + r.width * 0.5) / heroRect.width;
+          const cy = ((r.top - heroRect.top) + r.height * 0.5) / heroRect.height;
+          addRipple(cx, cy, 0.85, now - idx * 0.15);
+        });
+      }
+
+      // Pointer & touch listeners on hero (do not block text selection or link clicking)
+      function handlePointerMove(clientX, clientY, boost = 1.0) {
+        const rect = hero.getBoundingClientRect();
+        if (rect.width <= 0 || rect.height <= 0) return;
+        const nx = (clientX - rect.left) / rect.width;
+        const ny = (clientY - rect.top) / rect.height;
+
+        pointer.x = Math.max(0, Math.min(1, nx));
+        pointer.y = Math.max(0, Math.min(1, ny));
+        pointer.targetActive = 1.0;
+
+        const now = getElapsedSec();
+        const dx = pointer.x - pointer.lastX;
+        const dy = pointer.y - pointer.lastY;
+        const movedDist = Math.hypot(dx, dy);
+
+        if (now - pointer.lastSpawnTime > 0.065 && movedDist > 0.012) {
+          const strength = Math.min(1.25, (0.45 + movedDist * 4.5) * boost);
+          addRipple(pointer.x, pointer.y, strength, now);
+          pointer.lastSpawnTime = now;
+          pointer.lastX = pointer.x;
+          pointer.lastY = pointer.y;
+        }
+      }
+
+      hero.addEventListener('pointermove', (e) => {
+        handlePointerMove(e.clientX, e.clientY, hoveredElements.size > 0 ? 1.25 : 0.95);
+      }, { passive: true });
+
+      hero.addEventListener('pointerdown', (e) => {
+        const rect = hero.getBoundingClientRect();
+        if (rect.width <= 0 || rect.height <= 0) return;
+        const nx = (e.clientX - rect.left) / rect.width;
+        const ny = (e.clientY - rect.top) / rect.height;
+        addRipple(nx, ny, 1.35, getElapsedSec());
+      }, { passive: true });
+
+      hero.addEventListener('pointerleave', () => {
+        pointer.targetActive = 0.0;
+      }, { passive: true });
+
+      // Interactive hover/focus listeners on 'Wake Up Your Senses' and 'Order Now'
+      for (const el of targetElements) {
+        el.addEventListener('pointerenter', (e) => {
+          hoveredElements.add(el);
+          targetHoverValue = 1.0;
+          rasterizeHtmlToWebGLTexture();
+
+          const heroRect = hero.getBoundingClientRect();
+          const rect = el.getBoundingClientRect();
+          const nx = e.clientX
+            ? (e.clientX - heroRect.left) / Math.max(1, heroRect.width)
+            : ((rect.left - heroRect.left) + rect.width * 0.5) / Math.max(1, heroRect.width);
+          const ny = e.clientY
+            ? (e.clientY - heroRect.top) / Math.max(1, heroRect.height)
+            : ((rect.top - heroRect.top) + rect.height * 0.5) / Math.max(1, heroRect.height);
+          addRipple(nx, ny, 1.1, getElapsedSec());
+        });
+
+        el.addEventListener('pointerleave', () => {
+          hoveredElements.delete(el);
+          targetHoverValue = hoveredElements.size > 0 ? 1.0 : 0.0;
+          rasterizeHtmlToWebGLTexture();
+        });
+
+        el.addEventListener('focus', () => {
+          hoveredElements.add(el);
+          targetHoverValue = 1.0;
+          rasterizeHtmlToWebGLTexture();
+        });
+
+        el.addEventListener('blur', () => {
+          hoveredElements.delete(el);
+          targetHoverValue = hoveredElements.size > 0 ? 1.0 : 0.0;
+          rasterizeHtmlToWebGLTexture();
+        });
+      }
+
+      // Re-rasterize on resize, font load, or DOM text mutations
+      window.addEventListener('resize', () => {
+        rasterizeHtmlToWebGLTexture();
+      });
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(() => {
+          rasterizeHtmlToWebGLTexture();
+        });
+        ro.observe(hero);
+        targetElements.forEach((el) => ro.observe(el));
+      }
+
+      if (typeof MutationObserver !== 'undefined') {
+        const mo = new MutationObserver(() => {
+          rasterizeHtmlToWebGLTexture();
+        });
+        targetElements.forEach((el) =>
+          mo.observe(el, { childList: true, characterData: true, subtree: true })
+        );
+      }
+
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(() => {
+          rasterizeHtmlToWebGLTexture();
+        });
+      }
+
+      // Initial rasterization & ripple seed
+      rasterizeHtmlToWebGLTexture();
+      seedInitialRipples();
+
+      let lastAmbientRippleTime = 0;
+
+      function renderFrame() {
+        const now = getElapsedSec();
+
+        // Periodically emit gentle ambient ripples over 'Wake Up Your Senses' and 'Order Now'
+        if (now - lastAmbientRippleTime > 1.8) {
+          const heroRect = hero.getBoundingClientRect();
+          if (heroRect.width > 0 && heroRect.height > 0) {
+            const targetEl = targetElements[Math.floor(now) % targetElements.length];
+            const r = targetEl.getBoundingClientRect();
+            const jitterX = (Math.sin(now * 2.3) * 0.28) * (r.width / heroRect.width);
+            const jitterY = (Math.cos(now * 1.7) * 0.2) * (r.height / heroRect.height);
+            const cx = ((r.left - heroRect.left) + r.width * 0.5) / heroRect.width + jitterX;
+            const cy = ((r.top - heroRect.top) + r.height * 0.5) / heroRect.height + jitterY;
+            addRipple(cx, cy, 0.65, now);
+          }
+          lastAmbientRippleTime = now;
+        }
+
+        pointer.active += (pointer.targetActive - pointer.active) * 0.08;
+        currentHoverValue += (targetHoverValue - currentHoverValue) * 0.1;
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+
+        gl.enable(gl.BLEND);
+        gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+        gl.useProgram(program);
+
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, htmlTexture);
+        gl.uniform1i(uTextureLoc, 0);
+
+        gl.uniform1f(uTimeLoc, now);
+        gl.uniform2f(uResolutionLoc, canvas.width, canvas.height);
+        gl.uniform2f(uPointerLoc, pointer.x, pointer.y);
+        gl.uniform1f(uPointerActiveLoc, pointer.active);
+        gl.uniform1f(uHoverIntensityLoc, currentHoverValue);
+
+        for (let i = 0; i < MAX_RIPPLES; i++) {
+          const rp = ripples[i];
+          gl.uniform4f(uRippleLocs[i], rp.x, rp.y, rp.startTime, rp.strength);
+        }
+
+        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
+        gl.enableVertexAttribArray(aPositionLoc);
+        gl.vertexAttribPointer(aPositionLoc, 2, gl.FLOAT, false, 0, 0);
+
+        gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer);
+        gl.enableVertexAttribArray(aUvLoc);
+        gl.vertexAttribPointer(aUvLoc, 2, gl.FLOAT, false, 0, 0);
+
+        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
+        gl.drawElements(gl.TRIANGLES, indexCount, gl.UNSIGNED_SHORT, 0);
+
+        requestAnimationFrame(renderFrame);
+      }
+
+      requestAnimationFrame(renderFrame);
+    })();
+  </script>
