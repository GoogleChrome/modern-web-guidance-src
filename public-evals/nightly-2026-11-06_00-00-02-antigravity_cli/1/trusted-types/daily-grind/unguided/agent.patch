+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`,
+    ];
+
+    const gridContainer = document.querySelector('.grid');
+    if (gridContainer) {
+      gridContainer.innerHTML = htmlPolicy.createHTML(seasonalFavoritesHTML.join('\n'));
+    }
+  </script>
