+  <script>
+    function sanitizeHTML(unsafeHTML) {
+      let clean = String(unsafeHTML);
+      // Remove dangerous paired elements and their content
+      clean = clean.replace(/<(script|style|iframe|object|embed|applet|svg|math|form|base|meta|link)\b[^>]*>[\s\S]*?<\/\1>/gi, '');
+      // Remove self-closing or unclosed dangerous tags
+      clean = clean.replace(/<\/?(script|style|iframe|object|embed|applet|svg|math|form|base|meta|link)\b[^>]*\/?>/gi, '');
+      // Strip inline event handlers (on*)
+      clean = clean.replace(/\s+on[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '');
+      // Neutralize javascript:, vbscript:, and data: URIs in href/src/action attributes
+      clean = clean.replace(
+        /(\s+(?:href|src|xlink:href|action|formaction)\s*=\s*)(?:"\s*(?:javascript|vbscript|data):[^"]*"|'\s*(?:javascript|vbscript|data):[^']*'|(?:\s*(?:javascript|vbscript|data):[^\s>]+))/gi,
+        '$1"#"',
+      );
+      return clean;
+    }
+
+    const htmlPolicy = window.trustedTypes
+      ? window.trustedTypes.createPolicy('dailyGrindHTML', {
+          createHTML: (input) => sanitizeHTML(input),
+        })
+      : {
+          createHTML: (input) => sanitizeHTML(input),
+        };
+
+    const seasonalFavoritesHTML = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
