+/**
+ * The Daily Grind - Privacy by Design & Secure Data Handling Module
+ * Implements:
+ * 1. Data Minimization (URL tracker & token stripping, storage allowlisting, TTL enforcement)
+ * 2. Third-Party Audits (DOM script/iframe/image/link inspection and referrer stripping)
+ * 3. Secure Data Handling (XSS-safe text updates, SHA-256 tokenization, complete state purge on logout)
+ */
+(function () {
+  'use strict';
+
+  const STORAGE_KEY_PREFS = 'dg_ephemeral_prefs';
+  const STORAGE_TTL_MS = 15 * 60 * 1000; // 15 minutes ephemeral retention
+  const ALLOWED_SESSION_KEYS = new Set([STORAGE_KEY_PREFS]);
+  const ALLOWED_IMAGE_HOSTS = new Set(['images.unsplash.com']);
+  const SENSITIVE_QUERY_PARAMS = [
+    'utm_source',
+    'utm_medium',
+    'utm_campaign',
+    'utm_term',
+    'utm_content',
+    'fbclid',
+    'gclid',
+    'msclkid',
+    'mc_cid',
+    'mc_eid',
+    'session_id',
+    'token',
+    'auth',
+    'email',
+    'phone'
+  ];
+
+  /**
+   * 1. Data Minimization: Strip tracking & sensitive parameters from URL address bar
+   * Prevents accidental leakage of tokens or tracking identifiers via Referer or browser history.
+   */
+  function sanitizeUrlParameters() {
+    try {
+      const currentUrl = new URL(window.location.href);
+      let modified = false;
+
+      SENSITIVE_QUERY_PARAMS.forEach((param) => {
+        if (currentUrl.searchParams.has(param)) {
+          currentUrl.searchParams.delete(param);
+          modified = true;
+        }
+      });
+
+      // Also strip any parameter starting with utm_
+      for (const key of Array.from(currentUrl.searchParams.keys())) {
+        if (key.toLowerCase().startsWith('utm_')) {
+          currentUrl.searchParams.delete(key);
+          modified = true;
+        }
+      }
+
+      if (modified && window.history && window.history.replaceState) {
+        const cleanUrl =
+          currentUrl.pathname +
+          (currentUrl.search ? currentUrl.search : '') +
+          currentUrl.hash;
+        window.history.replaceState(null, document.title, cleanUrl);
+      }
+    } catch (_) {
+      // Ignore URL parsing errors in restricted environments
+    }
+  }
+
+  /**
+   * 2. Data Minimization: Enforce strict storage minimization and TTL expiration.
+   * Purges any unapproved keys from localStorage and sessionStorage.
+   */
+  function enforceStorageMinimization() {
+    try {
+      // Never persist long-term data in localStorage
+      if (window.localStorage && window.localStorage.length > 0) {
+        window.localStorage.clear();
+      }
+
+      if (window.sessionStorage) {
+        for (let i = window.sessionStorage.length - 1; i >= 0; i--) {
+          const key = window.sessionStorage.key(i);
+          if (key && !ALLOWED_SESSION_KEYS.has(key)) {
+            window.sessionStorage.removeItem(key);
+          }
+        }
+
+        const rawPrefs = window.sessionStorage.getItem(STORAGE_KEY_PREFS);
+        if (rawPrefs) {
+          const parsed = JSON.parse(rawPrefs);
+          if (!parsed || typeof parsed.expiresAt !== 'number' || Date.now() > parsed.expiresAt) {
+            window.sessionStorage.removeItem(STORAGE_KEY_PREFS);
+          }
+        }
+      }
+    } catch (_) {
+      // Storage access may be disabled by strict browser settings; fail safely
+    }
+  }
+
+  /**
+   * 3. Secure Data Handling: Complete purge of all client-side state (used on Logout & Clear Data)
+   */
+  async function purgeAllClientData() {
+    try {
+      if (window.sessionStorage) {
+        window.sessionStorage.clear();
+      }
+      if (window.localStorage) {
+        window.localStorage.clear();
+      }
+    } catch (_) {
+      // Ignore storage errors
+    }
+
+    // Expire any non-HttpOnly first-party cookies
+    try {
+      const cookies = document.cookie ? document.cookie.split(';') : [];
+      cookies.forEach((cookie) => {
+        const eqPos = cookie.indexOf('=');
+        const name = (eqPos > -1 ? cookie.slice(0, eqPos) : cookie).trim();
+        if (name) {
+          document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Strict`;
+        }
+      });
+    } catch (_) {
+      // Ignore cookie access errors
+    }
+
+    // Clear Cache Storage API if available
+    try {
+      if ('caches' in window && window.caches) {
+        const keys = await window.caches.keys();
+        await Promise.all(keys.map((key) => window.caches.delete(key)));
+      }
+    } catch (_) {
+      // Ignore cache API errors
+    }
+  }
+
+  /**
+   * 4. Third-Party Audit & Hardening:
+   * - Audits external scripts, iframes, images, and links
+   * - Enforces `rel="noopener noreferrer"` and `referrerpolicy="no-referrer"` on external links/media
+   */
+  function runThirdPartyAudit() {
+    let externalScriptsCount = 0;
+    let verifiedMedia = true;
+
+    // Inspect all scripts
+    const scripts = document.querySelectorAll('script[src]');
+    scripts.forEach((script) => {
+      try {
+        const url = new URL(script.src, window.location.origin);
+        if (url.origin !== window.location.origin) {
+          externalScriptsCount++;
+          script.remove();
+        }
+      } catch (_) {
+        // Ignore invalid URLs
+      }
+    });
+
+    // Inspect and remove any unauthorized iframes/embeds
+    const embeds = document.querySelectorAll('iframe, embed, object');
+    embeds.forEach((el) => el.remove());
+
+    // Inspect and harden all images
+    const images = document.querySelectorAll('img');
+    images.forEach((img) => {
+      img.setAttribute('referrerpolicy', 'no-referrer');
+      try {
+        const src = img.getAttribute('src');
