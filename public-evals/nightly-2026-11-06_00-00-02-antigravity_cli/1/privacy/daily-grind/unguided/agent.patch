+  function toggleHeroMedia(enabled) {
+    const heroImg = document.querySelector('.hero-bg');
+    if (!heroImg) return;
+
+    if (!enabled) {
+      if (heroImg.getAttribute('src')) {
+        heroImg.setAttribute('data-src', heroImg.getAttribute('src'));
+        heroImg.removeAttribute('src');
+      }
+      heroImg.style.display = 'none';
+    } else {
+      const savedSrc = heroImg.getAttribute('data-src');
