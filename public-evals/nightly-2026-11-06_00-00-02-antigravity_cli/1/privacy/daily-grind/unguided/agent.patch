+  function loadEphemeralPreferences() {
+    try {
+      const raw = window.sessionStorage ? window.sessionStorage.getItem(STORAGE_KEY_PREFS) : null;
+      if (!raw) return;
+
+      const data = JSON.parse(raw);
+      const ephemeralToggle = document.getElementById('pref-ephemeral-ui');
+      const mediaToggle = document.getElementById('pref-third-party-media');
+      const roastSelect = document.getElementById('roast-pref');
+
+      if (ephemeralToggle && typeof data.allowEphemeralUi === 'boolean') {
+        ephemeralToggle.checked = data.allowEphemeralUi;
+      }
+      if (mediaToggle && typeof data.allowThirdPartyMedia === 'boolean') {
+        mediaToggle.checked = data.allowThirdPartyMedia;
+        toggleHeroMedia(data.allowThirdPartyMedia);
+      }
+      if (roastSelect && typeof data.roastPreference === 'string') {
+        const allowedRoasts = ['none', 'light', 'medium', 'dark'];
+        if (allowedRoasts.includes(data.roastPreference)) {
+          roastSelect.value = data.roastPreference;
+        }
+      }
+    } catch (_) {
+      // Fail closed if JSON is malformed
+    }
+  }
