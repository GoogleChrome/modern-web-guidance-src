+          const allowedOrigins = new Set([
+            window.location.origin,
+            'https://www.youtube-nocookie.com',
+          ]);
+          if (!allowedOrigins.has(parsed.origin)) {
+            throw new TypeError(`Blocked untrusted script URL origin: ${parsed.origin}`);
+          }
+          return parsed.href;
+        },
+      })
