+// 4. Differential Privacy (Fuzzing / Randomized Noise) for Aggregate Statistics
+export function addDifferentialPrivacyNoise(trueCount, epsilon = 1.0) {
+  // Generate Laplace(0, 1/epsilon) noise using crypto.getRandomValues for unbiased randomness
+  const randomWords = new Uint32Array(1);
+  crypto.getRandomValues(randomWords);
+  const u = (randomWords[0] / 0xffffffff) - 0.5;
+  const sign = u < 0 ? -1 : 1;
+  const laplaceNoise = -sign * (1 / epsilon) * Math.log(1 - 2 * Math.abs(u));
+  return Math.max(0, Math.round(trueCount + laplaceNoise));
+}
