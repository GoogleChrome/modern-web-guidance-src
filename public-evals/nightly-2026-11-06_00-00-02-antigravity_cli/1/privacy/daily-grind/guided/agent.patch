@@ -0,0 +1,203 @@
+/**
+ * The Daily Grind — Privacy-by-Design Security & Policy Configuration
+ *
+ * Implements HTTP security and privacy headers, Fetch Metadata resource isolation,
+ * secure cookie configuration (__Host- session cookies & CHIPS partitioned cookies),
+ * rate limiting, PII log scrubbing, and Clear-Site-Data logout handling.
+ *
+ * HTTP Header Summary:
+ * --------------------
+ * Referrer-Policy: strict-origin-when-cross-origin
+ * Permissions-Policy: geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()
+ * X-Content-Type-Options: nosniff
+ * X-Frame-Options: DENY
+ * Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
+ * Cross-Origin-Opener-Policy: same-origin-allow-popups
+ * Cross-Origin-Resource-Policy: same-origin
+ * Reporting-Endpoints: default="https://reports.dailygrind.example/default", main-endpoint="https://reports.dailygrind.example/main", conn-reports="https://reports.dailygrind.example/conn"
+ * Connection-Allowlist: (response-origin "https://images.unsplash.com/*" "https://img.youtube.com/*" "https://www.youtube-nocookie.com/*" "https://idp.dailygrind.example/*"); report-to=conn-reports
+ * Content-Security-Policy: script-src 'nonce-{RANDOM}' 'strict-dynamic' 'report-sample'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'; require-trusted-types-for 'script'; report-to main-endpoint
+ * Clear-Site-Data: "*" (on /api/logout subresource endpoint)
+ * Set-Cookie: __Host-session_id=xyz123; Secure; HttpOnly; SameSite=Lax; Path=/
+ * Set-Cookie: theme_pref=dark; SameSite=None; Secure; Path=/; Partitioned; HttpOnly
+ */
+
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+/**
+ * Scrub Personally Identifiable Information (PII) from application logs.
+ * Automatically masks emails, bearer/session tokens, phone numbers, and IDs.
+ */
+export function scrubLogPII(input) {
+  const raw = typeof input === 'string' ? input : JSON.stringify(input ?? '');
+  return raw
+    // Mask email addresses
+    .replace(/\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/g, '[REDACTED_EMAIL]')
+    // Mask session/bearer tokens and API keys
+    .replace(/\b(?:Bearer\s+|token=|session_id=|__Host-session_id=)[A-Za-z0-9._~+/-]+=*/gi, '[REDACTED_TOKEN]')
+    // Mask phone numbers
+    .replace(/\b(?:\+?\d{1,3}[\s.-]?)?\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}\b/g, '[REDACTED_PHONE]')
+    // Mask UUIDs / customer IDs
+    .replace(/\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/gi, '[REDACTED_ID]');
+}
+
+/**
+ * Normalize a config URL or URLPattern string for Connection-Allowlist:
+ * - Rewrites ws:// and wss:// to http:// and https://.
+ * - Strips bare trailing slash on origin-only URLs so all subpaths are permitted.
+ */
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(`Pattern must include an http:// or https:// scheme: ${rawPattern}`);
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(`Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`);
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(`Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`);
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+/**
+ * Build an RFC 9651 Inner List value for Connection-Allowlist.
+ */
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = [
+    'https://images.unsplash.com/*',
+    'https://img.youtube.com/*',
+    'https://www.youtube-nocookie.com/*',
+    'https://idp.dailygrind.example/*',
+  ],
+  reportTo = 'conn-reports',
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+/**
+ * Generate a cryptographic per-request CSP nonce and apply privacy & security headers.
+ */
+export function applyPrivacySecurityHeaders(req, res) {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  const nonce = btoa(String.fromCharCode(...bytes));
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+
+  // Privacy-preserving Referrer-Policy and defensive Permissions-Policy
+  setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  setHeader(
+    'Permissions-Policy',
+    'geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()',
+  );
+
+  // Companion security headers
+  setHeader('X-Content-Type-Options', 'nosniff');
+  setHeader('X-Frame-Options', 'DENY');
+  setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
+  setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+  // Reporting API endpoints (PII scrubbed before reaching endpoint)
+  setHeader(
+    'Reporting-Endpoints',
+    'default="https://reports.dailygrind.example/default", main-endpoint="https://reports.dailygrind.example/main", conn-reports="https://reports.dailygrind.example/conn"',
+  );
+
+  // Outbound Connection Allowlist scoped to document/worker destinations
+  const secFetchDest = req?.headers?.['sec-fetch-dest'] || 'document';
+  if (ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) {
+    setHeader('Connection-Allowlist', buildConnectionAllowlistHeader());
+  }
+
+  // Enforced Content-Security-Policy with Trusted Types and strict-dynamic
+  const csp = [
+    "default-src 'self'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "style-src 'self' 'unsafe-inline'",
+    "img-src 'self' https://images.unsplash.com https://img.youtube.com data:",
+    'frame-src https://www.youtube-nocookie.com',
+    "connect-src 'self' https://idp.dailygrind.example",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    'report-to main-endpoint',
+  ].join('; ');
+
+  setHeader('Content-Security-Policy', csp);
+  return { nonce };
+}
+
+/**
+ * Configure secure session cookies (__Host- prefix, HttpOnly, Secure, SameSite=Lax)
+ * and CHIPS partitioned cookies (Partitioned, SameSite=None, Secure, HttpOnly) for 1:1 embeds.
+ */
+export function buildSecureCookies({ sessionId, themePref = 'light' }) {
+  const cookies = [];
+  if (sessionId) {
+    cookies.push(`__Host-session_id=${encodeURIComponent(sessionId)}; SameSite=Lax; HttpOnly; Secure; Path=/`);
+  }
+  if (themePref) {
+    cookies.push(`theme_pref=${encodeURIComponent(themePref)}; SameSite=None; Secure; Path=/; Partitioned; HttpOnly`);
+  }
+  return cookies;
+}
+
+/**
+ * Handle logout subresource request with Clear-Site-Data header to wipe cookies, storage, and cache
+ * without blocking main document navigation rendering on slow devices.
+ */
+export function handleLogoutSubresource(res) {
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+  setHeader('Clear-Site-Data', '"*"');
+  setHeader('Cache-Control', 'no-store');
+}
+
+/**
+ * Fetch Metadata resource isolation middleware: rejects suspicious cross-site requests
+ * before authentication/authorization checks to prevent timing leaks.
+ */
+export function enforceFetchMetadataIsolation(req, res, next) {
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+  const site = req.get?.('Sec-Fetch-Site') ?? req.headers?.['sec-fetch-site'];
+  const mode = req.get?.('Sec-Fetch-Mode') ?? req.headers?.['sec-fetch-mode'];
+  const dest = req.get?.('Sec-Fetch-Dest') ?? req.headers?.['sec-fetch-dest'];
+
+  if (!site) return next(); // Fallback for legacy browsers
+  if (['same-origin', 'same-site', 'none'].includes(site)) return next();
+
+  // Allow standard navigate GET requests (top-level link clicks)
+  if (site === 'cross-site' && mode === 'navigate' && req.method === 'GET' && !['object', 'embed'].includes(dest)) {
+    return next();
+  }
+
+  res.status(403).send('Forbidden');
+}
