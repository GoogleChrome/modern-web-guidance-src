+// 2. Client-side Rate Limiter for sensitive endpoints (store search, profile access/updates)
+const rateLimitBuckets = new Map();
+
+export function checkRateLimit(endpointKey, { maxRequests = 5, windowMs = 60_000 } = {}) {
+  const now = Date.now();
+  const timestamps = (rateLimitBuckets.get(endpointKey) || []).filter((t) => now - t < windowMs);
+  if (timestamps.length >= maxRequests) {
+    return { allowed: false, retryAfterSec: Math.ceil((windowMs - (now - timestamps[0])) / 1000) };
+  }
+  timestamps.push(now);
+  rateLimitBuckets.set(endpointKey, timestamps);
+  return { allowed: true, remaining: maxRequests - timestamps.length };
+}
+
+// 3. Ephemeral In-Memory User Profile & Order State (Never stores PII or tokens in localStorage)
