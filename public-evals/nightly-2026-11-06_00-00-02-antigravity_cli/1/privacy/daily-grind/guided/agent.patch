+    }
+
+    statusEl.textContent = `Order ${ephemeralUserState.activeOrder.orderId} placed via ${checkoutMode === 'guest' ? 'Guest Checkout (no account created)' : 'Account Checkout'}. Phone purpose limited strictly to 2FA (${twoFactorSms ? 'Enabled' : 'Not stored'}).`;
+    if (fulfillBtn) {
+      fulfillBtn.hidden = false;
+    }
+
+    logPrivacySafe('order_submitted', {
+      checkoutMode,
+      ageBracket,
+      phone: phone || 'none',
+      purposeLimitation: 'phone_2fa_only_never_marketing',
+    });
+    renderDataRightsInspector();
+  });
+
+  if (fulfillBtn) {
+    fulfillBtn.addEventListener('click', () => {
+      const completedId = ephemeralUserState.activeOrder?.orderId || 'Active order';
+      // Delete order pickup data immediately once purpose (fulfillment) is complete
+      ephemeralUserState.activeOrder = null;
+      ephemeralUserState.phone = '';
+      fulfillBtn.hidden = true;
+      statusEl.textContent = `${completedId} fulfilled! Pickup alias and transient order data have been permanently deleted in accordance with Data Minimization & Purpose Fulfillment.`;
+      logPrivacySafe('order_data_deleted_on_fulfillment', { status: 'purged' });
+      renderDataRightsInspector();
+    });
+  }
+}
+
+// 11. User Data Rights (Access, Correction, and Easy Self-Service Deletion) & Logout with Clear-Site-Data
+function renderDataRightsInspector() {
+  const viewer = document.getElementById('user-data-inspector');
+  if (!viewer) return;
+
+  const snapshot = {
+    checkoutMode: ephemeralUserState.checkoutMode,
+    pickupName: ephemeralUserState.pickupName,
+    email: ephemeralUserState.email,
+    ageBracket: ephemeralUserState.ageBracket,
+    phoneFor2FAOnly: ephemeralUserState.phone || null,
+    marketingOptIn: ephemeralUserState.marketingOptIn,
+    activeOrder: ephemeralUserState.activeOrder,
+    localStoragePIIKeys: 0,
+  };
+  viewer.textContent = JSON.stringify(snapshot, null, 2);
+}
+
+function initDataRightsAndLogout() {
+  const accessBtn = document.getElementById('access-data-btn');
+  const correctForm = document.getElementById('correct-data-form');
+  const deleteAccountBtn = document.getElementById('delete-account-btn');
+  const rightsStatus = document.getElementById('data-rights-status');
+  const logoutLink = document.getElementById('logout-btn');
+
+  if (accessBtn) {
+    accessBtn.addEventListener('click', () => {
+      const rateCheck = checkRateLimit('data-access', { maxRequests: 10, windowMs: 60_000 });
+      if (!rateCheck.allowed) {
+        if (rightsStatus) rightsStatus.textContent = `Rate limit active. Retry in ${rateCheck.retryAfterSec}s.`;
+        return;
+      }
+      renderDataRightsInspector();
+      if (rightsStatus) {
+        rightsStatus.textContent = 'Retrieved complete copy of your in-memory profile data.';
+      }
+    });
+  }
+
+  if (correctForm) {
+    correctForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const formData = new FormData(correctForm);
+      const updatedName = String(formData.get('correct-name') || '').trim();
+      const updatedEmail = String(formData.get('correct-email') || '').trim();
+      const updatedBracket = String(formData.get('correct-age-bracket') || '18-34');
+
+      if (updatedName) ephemeralUserState.pickupName = updatedName;
+      if (updatedEmail) ephemeralUserState.email = updatedEmail;
+      ephemeralUserState.ageBracket = updatedBracket;
+
+      renderDataRightsInspector();
+      if (rightsStatus) {
+        rightsStatus.textContent = 'Personal information corrected and updated immediately.';
+      }
+      logPrivacySafe('user_data_corrected', { email: updatedEmail });
+    });
+  }
+
+  if (deleteAccountBtn) {
+    deleteAccountBtn.addEventListener('click', () => {
+      ephemeralUserState.checkoutMode = 'guest';
+      ephemeralUserState.pickupName = '';
+      ephemeralUserState.email = '';
+      ephemeralUserState.ageBracket = 'not-collected';
+      ephemeralUserState.phone = '';
+      ephemeralUserState.twoFactorOptIn = false;
+      ephemeralUserState.marketingOptIn = false;
+      ephemeralUserState.activeOrder = null;
+      purgeSensitiveBrowserStorage();
+      renderDataRightsInspector();
+      if (rightsStatus) {
+        rightsStatus.textContent =
+          'Account & personal data erased immediately (1-click self-service deletion; non-dependent menu & guest ordering remain fully accessible).';
+      }
+      logPrivacySafe('account_erased', { status: 'deleted_all_user_data' });
+    });
+  }
+
+  if (logoutLink) {
+    logoutLink.addEventListener('click', async (event) => {
+      event.preventDefault();
+      // Trigger Clear-Site-Data via subresource fetch to avoid blocking main UI rendering on slow devices
+      try {
+        await fetch('/logout', {
+          method: 'POST',
+          credentials: 'same-origin',
+          referrerPolicy: 'no-referrer',
+        });
+      } catch {
+        // Fallback when running as static file without POST handler
+      }
+      ephemeralUserState.activeOrder = null;
+      ephemeralUserState.phone = '';
+      purgeSensitiveBrowserStorage();
+      renderDataRightsInspector();
+      if (rightsStatus) {
+        rightsStatus.textContent =
+          'Logged out cleanly. Triggered Clear-Site-Data: "*" subresource and wiped session state & browser storage.';
+      }
+      logPrivacySafe('user_logout_clear_site_data', { header: 'Clear-Site-Data: "*"' });
+    });
+  }
+}
+
+// Initialize all Privacy-by-Design controls on DOMContentLoaded
+document.addEventListener('DOMContentLoaded', async () => {
+  purgeSensitiveBrowserStorage();
+  initOrderForm();
+  initVideoFacade();
+  initDataRightsAndLogout();
+  renderDataRightsInspector();
+  runThirdPartyNetworkAudit();
+
+  // Bind explicit fallback geolocation button
+  const geoFallbackBtn = document.getElementById('use-location-fallback-btn');
+  if (geoFallbackBtn) {
+    geoFallbackBtn.addEventListener('click', () => {
+      if ('geolocation' in navigator) {
+        navigator.geolocation.getCurrentPosition(
+          (pos) => updateMap(pos),
+          () => updateMap(null),
+          { enableHighAccuracy: false, timeout: 5000, maximumAge: 300_000 },
+        );
+      } else {
+        updateMap(null);
+      }
+    });
+  }
+
+  // Bind manual postal-prefix lookup (zero geolocation permission needed)
+  const zipLookupForm = document.getElementById('coarse-region-form');
+  if (zipLookupForm) {
+    zipLookupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      updateMap(null);
+    });
+  }
+
+  // Bind FedCM button
+  const fedcmBtn = document.getElementById('fedcm-signin-btn');
+  if (fedcmBtn) {
+    fedcmBtn.addEventListener('click', handleFedCMSignIn);
+  }
+
+  // Bind Re-run Third-Party Audit button
+  const auditBtn = document.getElementById('run-network-audit-btn');
+  if (auditBtn) {
+    auditBtn.addEventListener('click', runThirdPartyNetworkAudit);
+  }
+
+  // Render Feature Detection & UA-CH status
+  const capabilities = await detectPlatformCapabilities();
+  const capEl = document.getElementById('capability-detection-status');
+  if (capEl) {
+    capEl.textContent = `Feature Detection: Geolocation=${capabilities.geolocation}, Credentials/FedCM=${capabilities.credentialsContainer}, TrustedTypes=${capabilities.trustedTypes}, CSS url() Modifiers=${capabilities.cssUrlIntegrity} | Client Hints: ${capabilities.uaClientHints}`;
+  }
+
+  // Initialize differential privacy counters on seasonal cards
+  document.querySelectorAll('[data-drink-stat]').forEach((el) => {
+    const base = Number(el.getAttribute('data-base-count') || '42');
+    const fuzzed = addDifferentialPrivacyNoise(base, 1.0);
+    el.textContent = `~${fuzzed} cups ordered today (Differential Privacy ε=1.0 fuzzed)`;
+  });
+
+  logPrivacySafe('privacy_by_design_initialized', {
+    sampleScrubCheck: 'customer@example.com Bearer secret_jwt_token_987654',
+  });
+});
