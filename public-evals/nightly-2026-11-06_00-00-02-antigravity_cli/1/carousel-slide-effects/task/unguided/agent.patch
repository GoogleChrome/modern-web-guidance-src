+      text-align: center;
+      color: #5d4037;
+      font-size: 0.95rem;
+      margin-bottom: 10px;
+    }
+
+    @keyframes scale-on-scroll {
+      0% {
+        transform: scale(0.75);
+        opacity: 0.65;
+      }
+      50% {
+        transform: scale(1.1);
+        opacity: 1;
+      }
+      100% {
+        transform: scale(0.75);
+        opacity: 0.65;
+      }
+    }
+
+    .scroller {
+      display: flex;
+      gap: 2rem;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      padding: 3rem calc(50% - 140px);
+      margin: 0 auto;
+      align-items: stretch;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      overflow: hidden;
+      padding: 0;
+      background: white;
+      border-radius: 12px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
+      transform-origin: center center;
+      view-timeline-name: --card-timeline;
+      view-timeline-axis: inline;
+      animation: scale-on-scroll linear both;
+      animation-timeline: view(inline);
+      animation-range: cover 0% cover 100%;
+      will-change: transform, opacity;
+    }
+
+    .scroller .card:focus-within {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .product-image {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .product-content {
+      padding: 20px;
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+      justify-content: space-between;
+    }
+
+    .product-price {
+      font-weight: bold;
+      font-size: 1.15rem;
+      color: var(--primary);
+      margin-top: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller .card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+      }
+    }
+
