+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+      const drinkSections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+
+      if (!panel || tocLinks.length === 0 || drinkSections.length === 0) return;
+
+      const setActiveDrink = (sectionId) => {
+        if (!sectionId) return;
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${sectionId}`;
+          link.classList.toggle('active', isMatch);
+          link.classList.toggle('target-current', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      // Smoothly scroll the right panel to the matching section when clicking any TOC link
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const targetHash = link.getAttribute('href');
+          if (!targetHash || !targetHash.startsWith('#')) return;
+
+          const targetId = targetHash.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setActiveDrink(targetId);
+
+          const targetHeading = targetSection.querySelector('h3') || targetSection;
+          targetHeading.scrollIntoView({ behavior: 'smooth', block: 'start' });
+
+          // Move focus to the heading without interrupting the smooth scroll so keyboard users can navigate from there
+          targetHeading.focus({ preventScroll: true });
+          history.replaceState(null, '', targetHash);
+        });
+      });
+
+      // 1. Native Scroll Snap Event synchronization
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const snappedTarget = event.snapTargetBlock;
+        if (!snappedTarget) return;
+
+        const snappedSection = snappedTarget.closest('.drink-section') || snappedTarget;
+        if (snappedSection && snappedSection.id) {
+          setActiveDrink(snappedSection.id);
+        }
+      });
+
+      // 2. Fallback synchronization using IntersectionObserver when scrollsnapchange is unsupported
+      if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+        const headers = drinkSections.map((section) => section.querySelector('h3') || section);
+
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            const topEntry = headers.reduce((currentTop, header) => {
+              const { bottom } = header.getBoundingClientRect();
+              if (bottom < panelRect.top) return currentTop;
+              if (!currentTop) return header;
+              return bottom < currentTop.getBoundingClientRect().bottom ? header : currentTop;
+            }, undefined);
+
+            if (topEntry) {
+              const section = topEntry.closest('.drink-section') || topEntry;
+              if (section && section.id) {
+                setActiveDrink(section.id);
+              }
+            }
+          },
+          { root: panel, threshold: [0, 0.25, 0.5, 0.9] }
+        );
+
+        headers.forEach((header) => observer.observe(header));
+      }
+    })();
+  </script>
