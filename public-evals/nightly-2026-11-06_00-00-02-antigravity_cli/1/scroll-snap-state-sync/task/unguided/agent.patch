+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocSidebar = document.querySelector('.toc-sidebar');
+      if (!panel || !tocSidebar) return;
+
+      const tocLinks = Array.from(tocSidebar.querySelectorAll('a[href^="#"]'));
+      const drinkSections = Array.from(panel.querySelectorAll('.drink-section'));
+
+      function setActiveDrink(targetId) {
+        if (!targetId) return;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + targetId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        drinkSections.forEach((section) => {
+          const isMatch = section.id === targetId;
+          section.classList.toggle('is-active', isMatch);
+        });
+      }
+
+      function updateActiveOnScroll() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = drinkSections[0];
+        let minDistance = Infinity;
+
+        drinkSections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const headerRect = header.getBoundingClientRect();
+          const distance = Math.abs(headerRect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        if (closestSection) {
+          setActiveDrink(closestSection.id);
+        }
+      }
+
+      // Click handler for TOC links to smoothly scroll the panel to the section
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetSection = panel.querySelector('#' + CSS.escape(targetId));
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setActiveDrink(targetId);
+
+          panel.scrollTo({
+            top: targetSection.offsetTop,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      // IntersectionObserver rooted in .seasonal-panel for snap detection
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            entries.forEach((entry) => {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
+                setActiveDrink(entry.target.id);
+              }
+            });
+          },
+          {
+            root: panel,
+            threshold: [0.5, 0.75]
+          }
+        );
+
+        drinkSections.forEach((section) => observer.observe(section));
+      }
+
+      // Scroll and scrollend listeners to guarantee synchronization when snapping completes
+      let scrollTicking = false;
+      panel.addEventListener('scroll', () => {
+        if (!scrollTicking) {
+          window.requestAnimationFrame(() => {
+            updateActiveOnScroll();
+            scrollTicking = false;
+          });
+          scrollTicking = true;
+        }
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', updateActiveOnScroll, { passive: true });
+
+      // Initialize state on load
+      updateActiveOnScroll();
+    })();
+  </script>
