 const http = require('node:http');
 const fs = require('node:fs');
 const path = require('node:path');
+const crypto = require('node:crypto');
 
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+function generateNonce() {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+}
+
+function isFetchMetadataAllowed(req) {
+  const siteHeader = req.headers['sec-fetch-site'];
+  const modeHeader = req.headers['sec-fetch-mode'];
+  const destHeader = req.headers['sec-fetch-dest'];
+
+  const site = typeof siteHeader === 'string' ? siteHeader.toLowerCase() : '';
+  const mode = typeof modeHeader === 'string' ? modeHeader.toLowerCase() : '';
+  const dest = typeof destHeader === 'string' ? destHeader.toLowerCase() : '';
+
+  if (!site) return true; // Fallback for legacy browsers
+
+  if (['same-origin', 'same-site', 'none'].includes(site)) return true;
+
+  // Allow standard navigate GET requests (link clicks)
+  if (
+    site === 'cross-site' &&
+    mode === 'navigate' &&
+    req.method === 'GET' &&
+    !['object', 'embed'].includes(dest)
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
+function applySecurityHeaders(req, res, nonce) {
+  const origin = `http://${req.headers.host || `localhost:${PORT}`}`;
+  const reportEndpoints = [
+    `default="${origin}/api/security-reports"`,
+    `main-endpoint="${origin}/api/security-reports"`,
+  ].join(', ');
+
+  const csp = [
+    "default-src 'self'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'self' 'nonce-${nonce}'`,
+    "img-src 'self' https://images.unsplash.com data:",
+    "connect-src 'self'",
+    "font-src 'self'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    'trusted-types escape-html',
+    'report-to main-endpoint',
+  ].join('; ');
+
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+  res.setHeader('Reporting-Endpoints', reportEndpoints);
+  res.setHeader('Content-Security-Policy', csp);
+  res.setHeader('Content-Security-Policy-Report-Only', csp);
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+  );
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+
+  const secFetchDest = req.headers['sec-fetch-dest'];
+  if (!secFetchDest || ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) {
+    const connAllowlist =
+      '(response-origin "https://images.unsplash.com/*"); report-to=main-endpoint';
+    res.setHeader('Connection-Allowlist', connAllowlist);
+    res.setHeader('Connection-Allowlist-Report-Only', connAllowlist);
+  }
+}
 
 const server = http.createServer((req, res) => {
   const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
