+        return menu.matches(':popover-open, .\\:popover-open');
+      } catch {
+        return menu.classList.contains(':popover-open');
+      }
+    }
+
+    function rootMenuOf(node) {
+      let current = node.closest('[popover]');
+      while (current) {
+        const parentPopover = current.parentElement?.closest('[popover]');
+        if (!parentPopover) return current;
+        current = parentPopover;
+      }
+      return null;
+    }
+
+    function enabledItemsFor(menu) {
+      const group = menu?.querySelector(':scope > [focusgroup~="menu"]');
+      if (!group) return [];
+      return [...group.querySelectorAll('button, a[href]')]
+        .filter(item => item.closest('[focusgroup]') === group)
+        .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+    }
+
+    function focusRingless(el) {
+      if (!el) return;
+      try {
+        el.focus({ focusVisible: false, preventScroll: true });
+      } catch {
+        el.focus({ preventScroll: true });
+      }
+    }
+
+    function closeAndRestore(menu, { fromPointer = false } = {}) {
+      if (!menu || !isOpen(menu)) return;
+      const trigger = triggerFor(menu);
+      if (trigger) {
+        suppressingPreviewTrigger = trigger;
+        if (fromPointer) {
+          focusRingless(trigger);
+        } else {
+          trigger.focus({ preventScroll: true });
+        }
+        setTimeout(() => {
+          if (suppressingPreviewTrigger === trigger) suppressingPreviewTrigger = null;
+        }, 0);
+      }
+      previewMenus.delete(menu);
+      menu.hidePopover();
+    }
+
+    function setMenubarTabStop(activeTrigger) {
+      if (!menubarTriggers.includes(activeTrigger)) return;
+      menubarTriggers.forEach(btn => {
+        btn.tabIndex = btn === activeTrigger ? 0 : -1;
+      });
+    }
+
+    if (menubarTriggers.length > 0) {
+      setMenubarTabStop(menubarTriggers[0]);
+    }
+
+    // 2. Fallback for focusgroup when native support is absent
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll(':where(button, a[href]):not([role])').forEach(item => {
+          item.setAttribute('role', 'menuitem');
+        });
+        group.addEventListener('keydown', event => {
+          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+          const items = [...group.querySelectorAll('button, a[href]')]
+            .filter(item => item.closest('[focusgroup]') === group)
+            .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+          const current = items.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          items[next].focus({ preventScroll: true });
+        }, true);
+      });
+    } else {
+      // Even with native focusgroup, Home and End jump to first and last enabled item
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.addEventListener('keydown', event => {
+          if (event.key !== 'Home' && event.key !== 'End') return;
+          const items = [...group.querySelectorAll('button, a[href]')]
+            .filter(item => item.closest('[focusgroup]') === group)
+            .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+          if (!items.length) return;
+          event.preventDefault();
+          const target = event.key === 'Home' ? items[0] : items[items.length - 1];
+          target.focus({ preventScroll: true });
+        });
+      });
+    }
+
+    // 3. Fallback positioning when CSS Anchor Positioning (position-area) is unsupported
+    function positionMenuFallback(menu, trigger) {
+      if (!menu || !trigger) return;
+      if (supportsAnchorArea && !supportsImplicitAnchor) {
+        const anchorId = `--anchor-${trigger.id}`;
+        trigger.style.setProperty('anchor-name', anchorId);
+        menu.style.setProperty('position-anchor', anchorId);
+        return;
+      }
+      if (supportsAnchorArea) return;
+
+      const isSubmenu = Boolean(menu.parentElement?.closest('[popover]'));
+      const trigRect = trigger.getBoundingClientRect();
+      const menuRect = menu.getBoundingClientRect();
+      const vw = document.documentElement.clientWidth;
+      const vh = document.documentElement.clientHeight;
+      const pad = 8;
+
+      let left;
+      let top;
+
+      if (!isSubmenu) {
+        left = trigRect.left;
+        top = trigRect.bottom + 4;
+        if (left + menuRect.width > vw - pad) {
+          left = Math.max(pad, trigRect.right - menuRect.width);
+        }
+        if (top + menuRect.height > vh - pad && trigRect.top - menuRect.height - 4 >= pad) {
+          top = trigRect.top - menuRect.height - 4;
+        }
+      } else {
+        left = trigRect.right + 2;
+        top = trigRect.top;
+        if (left + menuRect.width > vw - pad) {
+          if (trigRect.left - menuRect.width - 2 >= pad) {
+            left = trigRect.left - menuRect.width - 2;
+          } else {
+            // Narrow screen fallback below trigger, indented so it never covers its trigger
+            left = Math.min(trigRect.left + 16, Math.max(pad, vw - menuRect.width - pad));
+            top = trigRect.bottom + 2;
+          }
+        }
+        if (top + menuRect.height > vh - pad) {
+          top = Math.max(pad, vh - menuRect.height - pad);
+        }
+      }
+
+      menu.style.left = `${Math.max(pad, left)}px`;
+      menu.style.top = `${Math.max(pad, top)}px`;
+    }
+
+    // 4. Safe Triangle Bridge for Submenus
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      if (event.clientX >= rect.left && event.clientX <= rect.right) return;
+      const style = submenu.style;
+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop();
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // 5. Open a menu cleanly with source anchor support
+    function showMenuAnchored(menu, trigger) {
+      if (!menu || isOpen(menu)) return;
+      try {
+        menu.showPopover({ source: trigger });
+      } catch {
+        menu.showPopover();
+      }
+    }
+
+    // 6. Set up Triggers, Invoker Fallback, Preview on Focus, and Toggle Listener
+    allTriggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+      const isMenubarTrigger = menubarTriggers.includes(trigger);
+      const isSubmenuTrigger = Boolean(trigger.closest('[popover]'));
+
+      // Prevent pointerdown from shifting focus before click
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      // Fallback when native command="toggle-popover" is unsupported
+      if (!supportsInvokers) {
+        trigger.addEventListener('click', event => {
+          event.preventDefault();
+          const fromPointer = pointerTrigger === trigger || event.detail > 0;
+          if (isOpen(menu)) {
+            closeAndRestore(menu, { fromPointer });
+          } else {
+            if (!fromPointer) {
+              enterOnOpen.add(menu);
+            }
+            showMenuAnchored(menu, trigger);
+          }
+          pointerTrigger = null;
+        });
+      } else {
+        trigger.addEventListener('click', event => {
+          const fromPointer = pointerTrigger === trigger || event.detail > 0;
+          if (!fromPointer && !isOpen(menu) && !previewMenus.has(menu)) {
+            enterOnOpen.add(menu);
+          }
+          setTimeout(() => {
+            pointerTrigger = null;
+          }, 0);
+        });
+      }
+
+      // Sync aria-expanded, position fallback, and focus movement in `toggle` listener
+      menu.addEventListener('toggle', event => {
+        const openState = event.newState ? event.newState === 'open' : isOpen(menu);
+        trigger.setAttribute('aria-expanded', openState ? 'true' : 'false');
+
+        if (openState) {
+          positionMenuFallback(menu, trigger);
+          if (enterOnOpen.has(menu)) {
+            enterOnOpen.delete(menu);
+            previewMenus.delete(menu);
+            const items = enabledItemsFor(menu);
+            const targetIndex = menu.dataset.enterEdge === 'last' ? items.length - 1 : 0;
+            delete menu.dataset.enterEdge;
+            items[targetIndex]?.focus({ preventScroll: true });
+          } else if (pointerTrigger === trigger) {
+            focusRingless(trigger);
+          }
+        } else {
+          previewMenus.delete(menu);
+          enterOnOpen.delete(menu);
+        }
+      });
+
+      // Menubar trigger: preview on focus & hover switch
+      if (isMenubarTrigger) {
+        trigger.addEventListener('focus', () => {
+          setMenubarTabStop(trigger);
+          if (
+            returningFromWindowBlur ||
+            suppressingPreviewTrigger === trigger ||
+            pointerTrigger === trigger ||
+            isOpen(menu)
+          ) {
+            return;
+          }
+          previewMenus.add(menu);
+          showMenuAnchored(menu, trigger);
+        });
+
+        trigger.addEventListener('blur', event => {
+          const nextFocus = event.relatedTarget;
+          if (previewMenus.has(menu) && (!nextFocus || !menu.contains(nextFocus))) {
+            previewMenus.delete(menu);
+            if (isOpen(menu)) menu.hidePopover();
+          }
+        });
+
+        trigger.addEventListener('pointerenter', () => {
+          const anyMenubarOpen = menubarTriggers.some(t => isOpen(menuFor(t)));
+          if (!anyMenubarOpen || isOpen(menu)) return;
+          menubarTriggers.forEach(t => {
+            const m = menuFor(t);
+            if (m && m !== menu && isOpen(m)) {
+              previewMenus.delete(m);
+              m.hidePopover();
+            }
+          });
+          previewMenus.add(menu);
+          showMenuAnchored(menu, trigger);
+          focusRingless(trigger);
+          setMenubarTabStop(trigger);
+        });
+      }
+
+      // Submenu trigger: hover preview after short delay & safe triangle on pointerleave
+      if (isSubmenuTrigger) {
+        let hoverTimer = null;
+        trigger.addEventListener('pointerenter', () => {
+          clearTimeout(hoverTimer);
+          hoverTimer = setTimeout(() => {
+            if (!isOpen(menu)) {
+              previewMenus.add(menu);
+              showMenuAnchored(menu, trigger);
+            }
+          }, 90);
+        });
+
+        trigger.addEventListener('pointerleave', event => {
+          clearTimeout(hoverTimer);
+          startBridge(menu, event);
+        });
+      }
+
+      // Trigger keyboard navigation
+      trigger.addEventListener('keydown', event => {
+        if (isMenubarTrigger && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) {
+          event.preventDefault();
+          const idx = menubarTriggers.indexOf(trigger);
+          const delta = event.key === 'ArrowRight' ? 1 : -1;
+          const nextTrigger = menubarTriggers[(idx + delta + menubarTriggers.length) % menubarTriggers.length];
+          if (isOpen(menu)) {
+            previewMenus.delete(menu);
+            menu.hidePopover();
+          }
+          setMenubarTabStop(nextTrigger);
+          nextTrigger.focus();
+          return;
+        }
+
+        if (!isSubmenuTrigger && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
+          event.preventDefault();
+          const edge = event.key === 'ArrowUp' ? 'last' : 'first';
+          if (isOpen(menu)) {
+            previewMenus.delete(menu);
+            const items = enabledItemsFor(menu);
+            const item = edge === 'last' ? items[items.length - 1] : items[0];
+            item?.focus({ preventScroll: true });
+          } else {
+            menu.dataset.enterEdge = edge;
+            enterOnOpen.add(menu);
+            trigger.click();
+          }
+          return;
+        }
+
+        if (!isSubmenuTrigger && (event.key === 'Home' || event.key === 'End')) {
+          event.preventDefault();
+          const edge = event.key === 'End' ? 'last' : 'first';
+          if (isOpen(menu)) {
+            previewMenus.delete(menu);
+            const items = enabledItemsFor(menu);
+            const item = edge === 'last' ? items[items.length - 1] : items[0];
+            item?.focus({ preventScroll: true });
+          } else {
+            menu.dataset.enterEdge = edge;
+            enterOnOpen.add(menu);
+            trigger.click();
+          }
+          return;
+        }
+
+        if (isSubmenuTrigger && event.key === 'ArrowRight') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isOpen(menu)) {
+            previewMenus.delete(menu);
+            enabledItemsFor(menu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(menu);
+            trigger.click();
+          }
+        }
+      });
+    });
+
+    // 7. Menu-level pointer & keyboard interactions (hover-follows-focus, Escape/ArrowLeft/ArrowRight, checkable items)
+    document.querySelectorAll('[popover]').forEach(popover => {
+      const group = popover.querySelector(':scope > [focusgroup~="menu"]');
+      if (!group) return;
+
+      // Hover follows focus without ring; sibling item closes open sibling submenus
+      group.addEventListener('pointermove', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        if (document.activeElement !== item) {
+          focusRingless(item);
+        }
+        // Close any open sibling submenu in this group if hovering a non-matching sibling
+        group.querySelectorAll(':scope > [popover]').forEach(sub => {
+          if (isOpen(sub) && menuFor(item) !== sub) {
+            previewMenus.delete(sub);
+            sub.hidePopover();
+          }
+        });
+      });
+
+      // Keyboard navigation inside an open menu
+      popover.addEventListener('keydown', event => {
+        const isSubmenu = Boolean(popover.parentElement?.closest('[popover]'));
+        const activeItem = document.activeElement?.closest('button, a[href]');
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(popover, { fromPointer: false });
+          return;
+        }
+
+        if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isSubmenu) {
+            closeAndRestore(popover, { fromPointer: false });
+          } else {
+            const rootTrigger = triggerFor(popover);
+            if (rootTrigger && menubarTriggers.includes(rootTrigger)) {
+              const idx = menubarTriggers.indexOf(rootTrigger);
+              const prevTrigger = menubarTriggers[(idx - 1 + menubarTriggers.length) % menubarTriggers.length];
+              popover.hidePopover();
+              setMenubarTabStop(prevTrigger);
+              prevTrigger.focus();
+            }
+          }
+          return;
+        }
+
+        if (event.key === 'ArrowRight') {
+          // If on a submenu trigger, its own keydown handler opens the submenu
+          if (activeItem && activeItem.hasAttribute('commandfor')) return;
+          const rootPopover = rootMenuOf(popover);
+          const rootTrigger = triggerFor(rootPopover);
+          if (rootTrigger && menubarTriggers.includes(rootTrigger)) {
+            event.preventDefault();
+            event.stopPropagation();
+            const idx = menubarTriggers.indexOf(rootTrigger);
+            const nextTrigger = menubarTriggers[(idx + 1) % menubarTriggers.length];
+            rootPopover.hidePopover();
+            setMenubarTabStop(nextTrigger);
+            nextTrigger.focus();
+          }
+          return;
+        }
+
+        // APG Space key on menuitemcheckbox toggles and stays open
+        if (event.key === ' ' && activeItem?.getAttribute('role') === 'menuitemcheckbox') {
+          event.preventDefault();
+          event.stopPropagation();
+          toggleCheckableItem(activeItem, { stayOpen: true, fromPointer: false });
+        }
+      });
+
+      // Item activation (commands, radios, checkboxes, links)
+      group.addEventListener('click', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        // Submenu triggers are handled by invoker/trigger logic
+        if (item.hasAttribute('commandfor')) return;
+
+        const fromPointer = event.detail > 0;
+        const role = item.getAttribute('role');
+
+        if (role === 'menuitemcheckbox' || role === 'menuitemradio') {
+          event.preventDefault();
+          toggleCheckableItem(item, { stayOpen: false, fromPointer });
+          return;
+        }
+
+        if (item.tagName === 'A') {
+          event.preventDefault();
+          const label = item.textContent.trim();
+          announceSelection(`Viewing category: ${label} (${item.getAttribute('href')})`);
+          const root = rootMenuOf(popover);
+          closeAndRestore(root, { fromPointer });
+          return;
+        }
+
+        // Standard command button
+        const actionLabel = item.dataset.action || item.textContent.replace(/\s+/g, ' ').trim();
+        announceSelection(actionLabel);
+        const root = rootMenuOf(popover);
+        closeAndRestore(root, { fromPointer });
+      });
+    });
+
+    function toggleCheckableItem(item, { stayOpen = false, fromPointer = false } = {}) {
+      const role = item.getAttribute('role');
+      const root = rootMenuOf(item);
+
+      if (role === 'menuitemcheckbox') {
+        const nextChecked = item.getAttribute('aria-checked') !== 'true';
+        item.setAttribute('aria-checked', String(nextChecked));
+        const label = item.dataset.addon || item.dataset.action || item.textContent.replace(/\s+/g, ' ').trim();
+        updateDrinkCardSummary(root);
+        announceSelection(`${label}: ${nextChecked ? 'Enabled' : 'Disabled'}`);
+      } else if (role === 'menuitemradio') {
+        const radioGroup = item.closest('[role="group"]') || item.parentElement;
+        radioGroup?.querySelectorAll('[role="menuitemradio"]').forEach(Peer => {
+          Peer.setAttribute('aria-checked', String(Peer === item));
+        });
+        const label = item.dataset.label || item.dataset.action || item.textContent.replace(/\s+/g, ' ').trim();
+        updateDrinkCardSummary(root);
+        announceSelection(`Selected option: ${label}`);
+      }
+
+      if (!stayOpen && root) {
+        setTimeout(() => {
+          closeAndRestore(root, { fromPointer });
+        }, 260);
+      }
+    }
+
+    function updateDrinkCardSummary(rootPopover) {
+      if (!rootPopover) return;
+      const summaryId = rootPopover.dataset.summaryTarget;
+      if (!summaryId) return;
+      const summaryEl = document.getElementById(summaryId);
+      if (!summaryEl) return;
+
+      const chosenRadios = [...rootPopover.querySelectorAll('[role="menuitemradio"][aria-checked="true"]')]
+        .map(btn => btn.dataset.label || btn.textContent.trim());
+      const chosenAddons = [...rootPopover.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]')]
+        .map(btn => btn.dataset.addon || btn.textContent.trim());
+
+      summaryEl.textContent = [...chosenRadios, ...chosenAddons].join(' · ');
+    }
+
+    function announceSelection(message) {
+      if (statusOutput) {
+        statusOutput.textContent = message;
+      }
+    }
+
+    // 8. Close all open menus when focus moves outside the menu system (e.g., on Tab)
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+      document.querySelectorAll('[popover]').forEach(popover => {
+        if (!isOpen(popover)) return;
+        // Check root popovers; hiding root closes nested submenus
+        if (popover.parentElement?.closest('[popover]')) return;
+        const trigger = triggerFor(popover);
+        const insideThisSystem =
+          popover.contains(target) ||
+          trigger === target ||
+          (menubar && menubar.contains(trigger) && menubar.contains(target));
+        if (!insideThisSystem) {
+          previewMenus.delete(popover);
+          popover.hidePopover();
+        }
+      });
+    });
+  </script>
 </body>
 
