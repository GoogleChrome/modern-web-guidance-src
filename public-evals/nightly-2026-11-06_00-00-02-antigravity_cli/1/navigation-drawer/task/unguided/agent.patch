+  <script>
+    (function () {
+      const menuToggle = document.getElementById('menu-toggle');
+      const drawerClose = document.getElementById('drawer-close');
+      const navDrawer = document.getElementById('nav-drawer');
+      const drawerOverlay = document.getElementById('drawer-overlay');
+
+      let isOpen = false;
+
+      function openDrawer() {
+        isOpen = true;
+        navDrawer.style.transform = '';
+        navDrawer.classList.remove('swiping');
+        navDrawer.classList.add('open');
+        drawerOverlay.classList.add('open');
+        navDrawer.setAttribute('aria-hidden', 'false');
+        navDrawer.removeAttribute('inert');
+        menuToggle.setAttribute('aria-expanded', 'true');
+        drawerClose.focus();
+      }
+
+      function closeDrawer(returnFocus = true) {
+        if (!isOpen) return;
+        isOpen = false;
+        navDrawer.style.transform = '';
+        navDrawer.classList.remove('swiping');
+        navDrawer.classList.remove('open');
+        drawerOverlay.classList.remove('open');
+        navDrawer.setAttribute('aria-hidden', 'true');
+        navDrawer.setAttribute('inert', '');
+        menuToggle.setAttribute('aria-expanded', 'false');
+        if (returnFocus) {
+          menuToggle.focus();
+        }
+      }
+
+      menuToggle.addEventListener('click', (e) => {
+        e.stopPropagation();
+        if (isOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      });
+
+      drawerClose.addEventListener('click', () => {
+        closeDrawer();
+      });
+
+      drawerOverlay.addEventListener('click', () => {
+        closeDrawer();
+      });
+
+      // Close when tapping/clicking outside the drawer and menu toggle
+      document.addEventListener('pointerdown', (e) => {
+        if (!isOpen) return;
+        if (!navDrawer.contains(e.target) && !menuToggle.contains(e.target)) {
+          closeDrawer(false);
+        }
+      });
+
+      // Close on Escape key
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && isOpen) {
+          e.preventDefault();
+          closeDrawer(true);
+        }
+      });
+
+      // Swipe-to-close gesture support (Touch & Pointer events)
+      let startX = 0;
+      let startY = 0;
+      let currentDeltaX = 0;
+      let isTracking = false;
+      let isHorizontalSwipe = false;
+
+      function handleSwipeStart(clientX, clientY) {
+        if (!isOpen) return;
+        startX = clientX;
+        startY = clientY;
+        currentDeltaX = 0;
+        isTracking = true;
+        isHorizontalSwipe = false;
+      }
+
+      function handleSwipeMove(clientX, clientY) {
+        if (!isTracking || !isOpen) return;
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+
+        if (!isHorizontalSwipe) {
+          if (Math.abs(deltaX) > 8 && Math.abs(deltaX) > Math.abs(deltaY)) {
+            isHorizontalSwipe = true;
+            navDrawer.classList.add('swiping');
+          } else if (Math.abs(deltaY) > 12) {
+            isTracking = false;
+            return;
+          } else {
+            return;
+          }
+        }
+
+        currentDeltaX = deltaX;
+        // Follow rightward drag smoothly
+        if (deltaX > 0) {
+          navDrawer.style.transform = `translateX(${deltaX}px)`;
+        } else {
+          navDrawer.style.transform = 'translateX(0px)';
+        }
+      }
+
+      function handleSwipeEnd(clientX) {
+        if (!isTracking || !isOpen) return;
+        const deltaX = typeof clientX === 'number' ? clientX - startX : currentDeltaX;
+        isTracking = false;
+        navDrawer.classList.remove('swiping');
+
+        const threshold = Math.min(50, navDrawer.offsetWidth * 0.25);
+        if (isHorizontalSwipe && Math.abs(deltaX) >= threshold) {
+          closeDrawer(false);
+        } else {
+          navDrawer.style.transform = '';
+        }
+        isHorizontalSwipe = false;
+      }
+
+      // Touch event listeners for mobile swipe
+      navDrawer.addEventListener('touchstart', (e) => {
+        if (e.touches.length === 1) {
+          handleSwipeStart(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      navDrawer.addEventListener('touchmove', (e) => {
+        if (e.touches.length === 1) {
+          handleSwipeMove(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      navDrawer.addEventListener('touchend', (e) => {
+        const touch = e.changedTouches && e.changedTouches[0];
+        handleSwipeEnd(touch ? touch.clientX : undefined);
+      });
+
+      navDrawer.addEventListener('touchcancel', () => {
+        isTracking = false;
+        isHorizontalSwipe = false;
+        navDrawer.classList.remove('swiping');
+        navDrawer.style.transform = '';
+      });
+
+      // Pointer event listeners for non-touch pointer drag (mouse/pen)
+      navDrawer.addEventListener('pointerdown', (e) => {
+        if (e.pointerType === 'touch') return;
+        handleSwipeStart(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (e.pointerType === 'touch' || !isTracking) return;
+        handleSwipeMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', (e) => {
+        if (e.pointerType === 'touch' || !isTracking) return;
+        handleSwipeEnd(e.clientX);
+      });
+    })();
+  </script>
 </body>
 
