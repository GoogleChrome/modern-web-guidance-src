+++ b/styles.css
@@ -0,0 +1,281 @@
+/* Opt in to cross-document view transitions for same-origin navigations */
+@view-transition {
+  navigation: auto;
+}
+
+/* Disable cross-document view transitions for users requesting reduced motion */
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* Custom compositor-friendly view transition animations when motion is allowed */
+@media (prefers-reduced-motion: no-preference) {
+  ::view-transition-old(root) {
+    animation: 0.3s ease-in both page-exit;
+  }
+
+  ::view-transition-new(root) {
+    animation: 0.3s ease-out both page-enter;
+  }
+
+  :active-view-transition-type(forwards) {
+    &::view-transition-old(root) {
+      animation: 0.3s ease-in both slide-out-left;
+    }
+
+    &::view-transition-new(root) {
+      animation: 0.3s ease-out both slide-in-right;
+    }
+  }
+
+  :active-view-transition-type(backwards) {
+    &::view-transition-old(root) {
+      animation: 0.3s ease-in both slide-out-right;
+    }
+
+    &::view-transition-new(root) {
+      animation: 0.3s ease-out both slide-in-left;
+    }
+  }
+}
+
+@keyframes page-exit {
+  to {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+}
+
+@keyframes page-enter {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+}
+
+@keyframes slide-out-left {
+  to {
+    opacity: 0;
+    transform: translateX(-15%);
+  }
+}
+
+@keyframes slide-in-right {
+  from {
+    opacity: 0;
+    transform: translateX(15%);
+  }
+}
+
+@keyframes slide-out-right {
+  to {
+    opacity: 0;
+    transform: translateX(15%);
+  }
+}
+
+@keyframes slide-in-left {
+  from {
+    opacity: 0;
+    transform: translateX(-15%);
+  }
+}
+
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --card-bg: #ffffff;
+}
+
+:root[data-theme="dark"] {
+  --primary: #2d1b17;
+  --secondary: #3e2723;
+  --accent: #ffab40;
+  --text: #f5f5f5;
+  --light: #1a110e;
+  --card-bg: #2a1c18;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: site-header;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  view-transition-name: site-logo;
+}
+
+.logo a {
+  color: white;
+  text-decoration: none;
+}
+
