@@ -0,0 +1,64 @@
+// Apply initial theme and layout before first paint so the view transition snapshot is stable
+const applyInitialThemeAndLayout = () => {
+  try {
+    const theme = localStorage.getItem('theme') || 'light';
+    const layout = localStorage.getItem('layout') || 'grid';
+    document.documentElement.dataset.theme = theme;
+    document.documentElement.dataset.layout = layout;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+    document.documentElement.dataset.layout = 'grid';
+  }
+};
+
+applyInitialThemeAndLayout();
+
+const ROUTE_ORDER = ['/', '/menu', '/locations', '/rewards', '/account', '/order-online'];
+
+const normalizePath = (pathname) => {
+  const cleaned = pathname.replace(/\/index\.html$/, '').replace(/\.html$/, '');
+  return cleaned === '' ? '/' : cleaned;
+};
+
+if ('onpagereveal' in window) {
+  window.addEventListener('pagereveal', async (event) => {
+    if (!event.viewTransition) return;
+
+    if (!window.navigation?.activation?.from) return;
+
+    const fromUrl = new URL(window.navigation.activation.from.url);
+    const toUrl = new URL(window.navigation.activation.entry?.url || window.location.href);
+
+    const fromPath = normalizePath(fromUrl.pathname);
+    const toPath = normalizePath(toUrl.pathname);
+
+    const fromIndex = ROUTE_ORDER.indexOf(fromPath);
+    const toIndex = ROUTE_ORDER.indexOf(toPath);
+
+    if (fromIndex !== -1 && toIndex !== -1 && fromIndex !== toIndex) {
+      event.viewTransition.types.add(toIndex > fromIndex ? 'forwards' : 'backwards');
+    }
+
+    // Context-dependent morph between homepage seasonal card and subpage heading
+    let temporaryNamedElement = null;
+    if (fromPath === '/' && toPath.startsWith('/menu')) {
+      temporaryNamedElement = document.querySelector('#seasonal-favorites h2');
+      if (temporaryNamedElement) {
+        temporaryNamedElement.style.viewTransitionName = 'seasonal-heading';
+      }
+    }
+
+    if (temporaryNamedElement) {
+      try {
+        await event.viewTransition.ready;
+      } catch (error) {
+        if (error.name !== 'InvalidStateError') {
+          throw error;
+        }
+      } finally {
+        await event.viewTransition.finished;
+        temporaryNamedElement.style.viewTransitionName = '';
+      }
+    }
+  });
+}
