index 0000000..d1b6b4b
--- /dev/null
+++ b/theme.js
@@ -0,0 +1,122 @@
+(function () {
+  var root = document.documentElement;
+  var ROUTE_ORDER = ['/', '/menu', '/locations', '/rewards', '/account', '/order-online'];
+
+  function normalizePath(pathname) {
+    if (!pathname || pathname === '/index.html') return '/';
+    return pathname.replace(/\/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
+  }
+
+  function applyInitialThemeAndLayout() {
+    var savedTheme = null;
+    try {
+      savedTheme = localStorage.getItem('daily-grind-theme');
+    } catch (e) {}
+
+    var prefersDark = false;
+    try {
+      prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
+    } catch (e) {}
+
+    var theme = savedTheme || (prefersDark ? 'dark' : 'light');
+    root.setAttribute('data-theme', theme);
+
+    var viewportWidth = window.innerWidth || 1024;
+    var layout = viewportWidth < 768 ? 'compact' : 'standard';
+    root.setAttribute('data-layout', layout);
+    root.setAttribute('data-page', normalizePath(window.location.pathname));
+
+    try {
+      var savedDir = sessionStorage.getItem('daily-grind-transition-dir');
+      if (savedDir) {
+        root.setAttribute('data-transition-dir', savedDir);
+      }
+    } catch (e) {}
+  }
+
+  // Run synchronously during render-blocking <head> evaluation
+  applyInitialThemeAndLayout();
+
+  window.addEventListener('pageswap', function (event) {
+    if (!event.viewTransition) return;
+    try {
+      var fromPath = normalizePath(window.location.pathname);
+      var targetUrl = event.activation && event.activation.entry && event.activation.entry.url
+        ? new URL(event.activation.entry.url, window.location.origin)
+        : null;
+      var toPath = targetUrl ? normalizePath(targetUrl.pathname) : '/';
+
+      var fromIndex = ROUTE_ORDER.indexOf(fromPath);
+      var toIndex = ROUTE_ORDER.indexOf(toPath);
+      var direction = 'forward';
+      if (fromIndex !== -1 && toIndex !== -1 && toIndex < fromIndex) {
+        direction = 'back';
+      } else if (toPath === '/' && fromPath !== '/') {
+        direction = 'back';
+      }
+
+      sessionStorage.setItem('daily-grind-transition-dir', direction);
+      sessionStorage.setItem('daily-grind-from-path', fromPath);
+
+      if (event.viewTransition.types && typeof event.viewTransition.types.add === 'function') {
+        event.viewTransition.types.add(direction);
+      }
+    } catch (e) {}
+  });
+
+  window.addEventListener('pagereveal', function (event) {
+    if (!event.viewTransition) return;
+    try {
+      var direction = sessionStorage.getItem('daily-grind-transition-dir') || 'forward';
+      root.setAttribute('data-transition-dir', direction);
+
+      if (event.viewTransition.types && typeof event.viewTransition.types.add === 'function') {
+        event.viewTransition.types.add(direction);
+      }
+
+      event.viewTransition.finished.finally(function () {
+        root.removeAttribute('data-transition-dir');
+      });
+    } catch (e) {}
+  });
+
+  window.addEventListener('DOMContentLoaded', function () {
+    var currentPath = normalizePath(window.location.pathname);
+    var navLinks = document.querySelectorAll('nav a[href]');
+    navLinks.forEach(function (link) {
+      var linkPath = normalizePath(link.getAttribute('href'));
+      if (linkPath === currentPath || (linkPath === '/menu' && currentPath.indexOf('/menu/') === 0)) {
+        if (!link.classList.contains('logo-link')) {
+          link.setAttribute('aria-current', 'page');
+        }
+      }
+    });
+
+    var toggleBtn = document.querySelector('[data-theme-toggle]');
+    if (toggleBtn) {
+      var updateLabel = function () {
+        var currentTheme = root.getAttribute('data-theme') || 'light';
+        toggleBtn.textContent = currentTheme === 'dark' ? 'Light Roast' : 'Dark Roast';
+        toggleBtn.setAttribute('aria-label', 'Switch color theme');
+      };
+      updateLabel();
+
+      toggleBtn.addEventListener('click', function () {
+        var nextTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
+        var applyTheme = function () {
+          root.setAttribute('data-theme', nextTheme);
+          try {
+            localStorage.setItem('daily-grind-theme', nextTheme);
+          } catch (e) {}
+          updateLabel();
+        };
+
+        if (document.startViewTransition) {
+          document.startViewTransition(applyTheme);
+        } else {
+          applyTheme();
+        }
+      });
+    }
+  });
+})();
