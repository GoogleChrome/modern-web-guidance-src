+            <dt>Coffee Anniversary:</dt>
+            <dd id="summary-anniversary-date">2023-11-06</dd>
+            <dt>Annual Recurring Date:</dt>
+            <dd id="summary-annual-month-day">--11-06</dd>
+            <dt>Next Scheduled Pickup:</dt>
+            <dd id="summary-combined-datetime">2026-11-06T08:30:00</dd>
+          </dl>
+        </div>
