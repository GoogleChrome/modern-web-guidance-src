+  <script>
+    const STORAGE_KEYS = {
+      pickupTime: 'dailyGrind.pickupReminderTime',
+      anniversaryDate: 'dailyGrind.coffeeAnniversaryDate',
+    };
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const pickupInput = document.getElementById('pickup-time');
+      const anniversaryInput = document.getElementById('anniversary-date');
+
+      const summaryPickupEl = document.getElementById('summary-pickup-time');
+      const summaryAnniversaryEl = document.getElementById('summary-anniversary-date');
+      const summaryMonthDayEl = document.getElementById('summary-annual-month-day');
+      const summaryCombinedEl = document.getElementById('summary-combined-datetime');
+
+      const savedTime = localStorage.getItem(STORAGE_KEYS.pickupTime);
+      const savedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+
+      if (savedTime) {
+        pickupInput.value = savedTime;
+      }
+      if (savedDate) {
+        anniversaryInput.value = savedDate;
+      }
+
+      function renderSchedule() {
+        if (!pickupInput.value || !anniversaryInput.value) {
+          return;
+        }
+
+        // 1. Parse wall-clock time and calendar date into location-agnostic Temporal Plain types
+        const reminderTime = Temporal.PlainTime.from(pickupInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(anniversaryInput.value);
+
+        // 2. Model the annual recurring anniversary using Temporal.PlainMonthDay with explicit calendar
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month: anniversaryDate.month,
+          day: anniversaryDate.day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+
+        // Convert PlainMonthDay to PlainDate with a specific year before date comparisons/arithmetic
+        const thisYearOccurrence = annualAnniversary.toPlainDate({ year: today.year });
+        const nextOccurrence =
+          Temporal.PlainDate.compare(thisYearOccurrence, today) < 0
+            ? annualAnniversary.toPlainDate({ year: today.year + 1 })
+            : thisYearOccurrence;
+
+        // Combine calendar date and wall-clock time into a location-agnostic PlainDateTime
+        const todayPickupAppointment = today.toPlainDateTime(reminderTime);
+
+        // Read fields directly from Plain types and display without time zone conversion
+        summaryPickupEl.textContent = `${reminderTime.toLocaleString()} (${reminderTime.toString().slice(0, 5)} wall-clock time)`;
+        summaryAnniversaryEl.textContent = `${anniversaryDate.toLocaleString()} (${anniversaryDate.year}-${String(anniversaryDate.month).padStart(2, '0')}-${String(anniversaryDate.day).padStart(2, '0')})`;
+
+        summaryMonthDayEl.textContent = `${annualAnniversary.toLocaleString()} (Next celebration: ${nextOccurrence.toLocaleString()})`;
+        if (isAnniversaryToday) {
+          const badge = document.createElement('span');
+          badge.className = 'badge';
+          badge.textContent = 'Happy Coffee Anniversary!';
+          summaryMonthDayEl.appendChild(badge);
+        }
+
+        summaryCombinedEl.textContent = `${todayPickupAppointment.toLocaleString()} (${todayPickupAppointment.toString()})`;
+      }
+
+      pickupInput.addEventListener('input', () => {
+        pickupInput.setCustomValidity('');
+      });
+      pickupInput.addEventListener('blur', () => {
+        if (!pickupInput.value) {
+          pickupInput.setCustomValidity('Please select a daily pickup reminder time.');
+        }
+      });
+
+      anniversaryInput.addEventListener('input', () => {
+        anniversaryInput.setCustomValidity('');
+      });
+      anniversaryInput.addEventListener('blur', () => {
+        if (!anniversaryInput.value) {
+          anniversaryInput.setCustomValidity('Please select your coffee anniversary date.');
+        }
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.checkValidity()) {
+          form.reportValidity();
+          return;
+        }
+
+        const reminderTime = Temporal.PlainTime.from(pickupInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(anniversaryInput.value);
+
+        localStorage.setItem(STORAGE_KEYS.pickupTime, reminderTime.toString().slice(0, 5));
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, anniversaryDate.toString());
+
+        renderSchedule();
+      });
+
+      renderSchedule();
+    }
+
+    // Check if Temporal is supported natively; load polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
