+  <script>
+    (function () {
+      const STORAGE_KEYS = {
+        pickupTime: 'dailyGrind.pickupReminderPlainTime',
+        anniversaryDate: 'dailyGrind.coffeeAnniversaryPlainDate'
+      };
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      /**
+       * Parses a location-agnostic wall-clock time string (HH:MM) without using Date or time zones.
+       * Uses Temporal.PlainTime when available, falling back to direct string component parsing.
+       */
+      function parsePlainTime(rawTime) {
+        if (typeof rawTime !== 'string') return null;
+        const trimmed = rawTime.trim();
+        if (!trimmed) return null;
+
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          try {
+            const pt = Temporal.PlainTime.from(trimmed);
+            const iso = String(pt.hour).padStart(2, '0') + ':' + String(pt.minute).padStart(2, '0');
+            return { hour: pt.hour, minute: pt.minute, iso: iso };
+          } catch (_) {
+            return null;
+          }
+        }
+
+        const match = /^(\d{2}):(\d{2})(?::\d{2})?$/.exec(trimmed);
+        if (!match) return null;
+        const hour = Number(match[1]);
+        const minute = Number(match[2]);
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return null;
+        const iso = String(hour).padStart(2, '0') + ':' + String(minute).padStart(2, '0');
+        return { hour: hour, minute: minute, iso: iso };
+      }
+
+      /**
+       * Parses a location-agnostic calendar date string (YYYY-MM-DD) without using Date or time zones.
+       * Avoids the classic `new Date("YYYY-MM-DD")` UTC-midnight-to-local shift bug.
+       */
+      function parsePlainDate(rawDate) {
+        if (typeof rawDate !== 'string') return null;
+        const trimmed = rawDate.trim();
+        if (!trimmed) return null;
+
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          try {
+            const pd = Temporal.PlainDate.from(trimmed);
+            const iso =
+              String(pd.year).padStart(4, '0') + '-' +
+              String(pd.month).padStart(2, '0') + '-' +
+              String(pd.day).padStart(2, '0');
+            return { year: pd.year, month: pd.month, day: pd.day, iso: iso };
+          } catch (_) {
+            return null;
+          }
+        }
+
+        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(trimmed);
+        if (!match) return null;
+        const year = Number(match[1]);
+        const month = Number(match[2]);
+        const day = Number(match[3]);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return null;
+        const iso =
+          String(year).padStart(4, '0') + '-' +
+          String(month).padStart(2, '0') + '-' +
+          String(day).padStart(2, '0');
+        return { year: year, month: month, day: day, iso: iso };
+      }
+
+      function formatPlainTime(plainTime) {
+        const period = plainTime.hour >= 12 ? 'PM' : 'AM';
+        const hour12 = plainTime.hour % 12 === 0 ? 12 : plainTime.hour % 12;
+        const paddedMinute = String(plainTime.minute).padStart(2, '0');
+        return hour12 + ':' + paddedMinute + ' ' + period + ' (' + plainTime.iso + ')';
+      }
+
+      function formatPlainDate(plainDate) {
+        const monthName = MONTH_NAMES[plainDate.month - 1];
+        return monthName + ' ' + plainDate.day + ', ' + plainDate.year + ' (' + plainDate.iso + ')';
+      }
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeDisplay = document.getElementById('pickup-reminder-display');
+      const timeValueEl = document.getElementById('pickup-reminder-value');
+      const dateDisplay = document.getElementById('coffee-anniversary-display');
+      const dateValueEl = document.getElementById('coffee-anniversary-value');
+      const statusEl = document.getElementById('preferences-status');
+      const form = document.getElementById('coffee-preferences-form');
+
+      function safeGetStorage(key) {
+        try {
+          return window.localStorage.getItem(key);
+        } catch (_) {
+          return null;
+        }
+      }
+
+      function safeSetStorage(key, value) {
+        try {
+          window.localStorage.setItem(key, value);
+        } catch (_) {
+          // Ignore storage errors in restricted environments
+        }
+      }
+
+      function syncPreferences(persist, showSavedMessage) {
+        const parsedTime = parsePlainTime(timeInput.value);
+        if (parsedTime) {
+          timeInput.value = parsedTime.iso;
+          timeDisplay.textContent = formatPlainTime(parsedTime);
+          timeValueEl.textContent = parsedTime.iso;
+          if (persist) {
+            safeSetStorage(STORAGE_KEYS.pickupTime, parsedTime.iso);
+          }
+        }
+
+        const parsedDate = parsePlainDate(dateInput.value);
+        if (parsedDate) {
+          dateInput.value = parsedDate.iso;
+          dateDisplay.textContent = formatPlainDate(parsedDate);
+          dateValueEl.textContent = parsedDate.iso;
+          if (persist) {
+            safeSetStorage(STORAGE_KEYS.anniversaryDate, parsedDate.iso);
+          }
+        }
+
+        if (showSavedMessage && statusEl && parsedTime && parsedDate) {
+          statusEl.textContent =
+            'Saved location-agnostic preferences: ' + parsedTime.iso + ' daily & ' + parsedDate.iso;
+        }
+      }
+
+      // Restore saved plain values without any timezone conversion
+      const savedTime = parsePlainTime(safeGetStorage(STORAGE_KEYS.pickupTime));
+      if (savedTime) {
+        timeInput.value = savedTime.iso;
+      }
+
+      const savedDate = parsePlainDate(safeGetStorage(STORAGE_KEYS.anniversaryDate));
+      if (savedDate) {
+        dateInput.value = savedDate.iso;
+      }
+
+      syncPreferences(false, false);
+
+      timeInput.addEventListener('input', function () {
+        syncPreferences(true, false);
+      });
+      timeInput.addEventListener('change', function () {
+        syncPreferences(true, false);
+      });
+
+      dateInput.addEventListener('input', function () {
+        syncPreferences(true, false);
+      });
+      dateInput.addEventListener('change', function () {
+        syncPreferences(true, false);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        syncPreferences(true, true);
+      });
+    })();
+  </script>
+
 </body>
 
