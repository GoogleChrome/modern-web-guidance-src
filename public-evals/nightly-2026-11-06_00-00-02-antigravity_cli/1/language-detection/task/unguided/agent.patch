+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const downloadProgress = document.getElementById('download-progress');
+    const detectionResult = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+
+    function getLanguageName(code) {
+      if (!code) return 'Unknown';
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        return displayNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackMessage.value.trim();
+      detectionResult.textContent = '';
+      downloadProgress.textContent = '';
+
+      if (!text) {
+        detectionResult.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectionResult.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+
+        if (availability === 'unavailable') {
+          detectionResult.textContent = 'Language detection is currently unavailable on this device.';
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            downloadProgress.textContent = 'Downloading model: 0%';
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = Math.round(e.loaded * 100);
+                  downloadProgress.textContent = `Downloading model: ${pct}%`;
+                });
+              }
+            });
+            downloadProgress.textContent = 'Downloading model: 100%';
+          } else {
+            detectorInstance = await LanguageDetector.create();
+          }
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const languageName = getLanguageName(topResult.detectedLanguage);
+          const confidencePct = (topResult.confidence * 100).toFixed(1);
+          detectionResult.textContent = `Language: ${languageName} (${topResult.detectedLanguage}) — Confidence: ${confidencePct}%`;
+        } else {
+          detectionResult.textContent = 'Could not detect the language.';
+        }
+      } catch (err) {
+        detectionResult.textContent = `Error detecting language: ${err.message || err}`;
+      }
+    });
+  </script>
