+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('download-progress');
+      const progressText = document.getElementById('download-progress-text');
+      const resultOutput = document.getElementById('detection-result');
+
+      const displayNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      function getLanguageName(code) {
+        if (!code) return 'Unknown';
+        if (displayNames) {
+          try {
+            return displayNames.of(code) || code;
+          } catch {
+            return code;
+          }
+        }
+        return code;
+      }
+
+      function showMessage(text, isError = false) {
+        resultOutput.textContent = text;
+        resultOutput.classList.toggle('error', isError);
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+      });
+
+      let detectorInstance = null;
+
+      async function checkFeatureAvailability() {
+        if (!('LanguageDetector' in self)) {
+          detectBtn.disabled = true;
+          showMessage('Client-side language detection is not supported in this browser.', true);
+          return 'unavailable';
+        }
+
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            detectBtn.disabled = true;
+            showMessage('The built-in language detection model is unavailable on this device.', true);
+          }
+          return availability;
+        } catch (err) {
+          detectBtn.disabled = true;
+          showMessage('Unable to check language detection availability.', true);
+          return 'unavailable';
+        }
+      }
+
+      checkFeatureAvailability();
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          showMessage('Please enter a message to detect its language.', true);
+          textarea.focus();
+          return;
+        }
+
+        if (!('LanguageDetector' in self)) {
+          detectBtn.disabled = true;
+          showMessage('Client-side language detection is not supported in this browser.', true);
+          return;
+        }
+
+        detectBtn.disabled = true;
+        showMessage('');
+
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            showMessage('The built-in language detection model is unavailable on this device.', true);
+            return;
+          }
+
+          if (!detectorInstance) {
+            const needsDownload = availability === 'downloadable' || availability === 'downloading';
+            if (needsDownload) {
+              progressBar.value = 0;
+              progressText.textContent = '0%';
+              progressContainer.hidden = false;
+            }
+
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  progressContainer.hidden = false;
+                  const percent = Math.round((e.loaded || 0) * 100);
+                  progressBar.value = percent;
+                  progressText.textContent = `${percent}%`;
+                });
+              },
+            });
+
+            progressContainer.hidden = true;
+          }
+
+          const results = await detectorInstance.detect(text);
+          if (results && results.length > 0) {
+            const topResult = results[0];
+            const languageName = getLanguageName(topResult.detectedLanguage);
+            const confidencePercent = (topResult.confidence * 100).toFixed(1);
+            showMessage(`Detected Language: ${languageName} (${confidencePercent}% confidence)`);
+          } else {
+            showMessage('Could not confidently detect the language of this message.', true);
+          }
+        } catch (err) {
+          progressContainer.hidden = true;
+          showMessage(`Language detection failed: ${err.message || 'An unexpected error occurred.'}`, true);
+        } finally {
+          if ('LanguageDetector' in self) {
+            detectBtn.disabled = false;
+          }
+        }
+      });
+    })();
+  </script>
