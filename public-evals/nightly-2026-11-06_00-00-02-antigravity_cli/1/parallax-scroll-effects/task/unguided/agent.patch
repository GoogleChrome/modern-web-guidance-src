+    /* Scroll-Driven Parallax Section */
+    @keyframes parallax-shift {
+      from {
+        transform: translate3d(0, var(--parallax-start, 0px), 0) scale(var(--parallax-scale, 1));
+      }
+      to {
+        transform: translate3d(0, var(--parallax-end, 0px), 0) scale(var(--parallax-scale, 1));
+      }
+    }
+
+    .parallax-section {
