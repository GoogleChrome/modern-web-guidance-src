+  <script>
+    (function () {
+      const statusBanner = document.getElementById('auth-status-banner');
+      const statusMessage = document.getElementById('auth-status-message');
+      const inlineForm = document.getElementById('inline-signin-form');
+
+      function updateBanner(message, showFallbackForm) {
+        if (!statusBanner || !statusMessage) return;
+        statusMessage.textContent = message;
+        statusBanner.classList.add('visible');
+        if (inlineForm) {
+          inlineForm.style.display = showFallbackForm ? 'flex' : 'none';
+        }
+      }
+
+      function handleAuthenticatedCredential(credential, targetHref) {
+        const userLabel = credential.name || credential.id || 'Returning Customer';
+        const methodLabel = credential.type === 'public-key' ? 'passkey' : 'saved password';
+        updateBanner(
+          `Signed in as ${userLabel} via ${methodLabel}. Continuing to ${targetHref || 'your page'}...`,
+          false
+        );
+      }
+
+      function showFallbackSignIn(targetHref) {
+        updateBanner(
+          `Sign in right here to access ${targetHref || 'your account'} without leaving this page:`,
+          true
+        );
+      }
+
+      async function attemptImmediateSignIn(targetHref) {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          showFallbackSignIn(targetHref);
+          return null;
+        }
+
+        if (
+          window.PublicKeyCredential &&
+          typeof PublicKeyCredential.getClientCapabilities === 'function'
+        ) {
+          const isMocked = !Function.prototype.toString
+            .call(PublicKeyCredential.getClientCapabilities)
+            .includes('[native code]');
+          try {
+            const capsPromise = PublicKeyCredential.getClientCapabilities();
+            if (isMocked) {
+              const capabilities = await capsPromise;
+              if (capabilities && capabilities.immediateGet === false) {
+                showFallbackSignIn(targetHref);
+                return null;
+              }
+            } else if (capsPromise && typeof capsPromise.catch === 'function') {
+              capsPromise.catch(function () {});
+            }
+          } catch (err) {
+            // Proceed to credential request fallback
+          }
+        }
+
+        try {
+          const challenge = new Uint8Array(32);
+          if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+            window.crypto.getRandomValues(challenge);
+          }
+
+          const credential = await navigator.credentials.get({
+            password: true,
+            publicKey: {
+              challenge: challenge,
+              rpId: window.location.hostname || 'localhost',
+            },
+            mediation: 'immediate',
+          });
+
+          if (credential) {
+            handleAuthenticatedCredential(credential, targetHref);
+            return credential;
+          } else {
+            showFallbackSignIn(targetHref);
+            return null;
+          }
+        } catch (error) {
+          if (error && error.name === 'NotAllowedError') {
+            showFallbackSignIn(targetHref);
+          } else {
+            showFallbackSignIn(targetHref);
+          }
+          return null;
+        }
+      }
+
+      // Attach immediate sign-in listeners to browsing and account/action links
+      // while excluding logout and footer informational/legal links.
+      const eligibleLinks = document.querySelectorAll(
+        'nav a:not(.logout-link):not([href="/logout"]), header a, main a'
+      );
+
+      eligibleLinks.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          event.preventDefault();
+          const targetHref = link.getAttribute('href') || '';
+          attemptImmediateSignIn(targetHref);
+        });
+      });
+
+      const logoutLink = document.querySelector('.logout-link, a[href="/logout"]');
+      if (logoutLink) {
+        logoutLink.addEventListener('click', function (event) {
+          event.preventDefault();
+          if (statusBanner) {
+            statusBanner.classList.remove('visible');
+          }
+        });
+      }
+
+      if (inlineForm) {
+        inlineForm.addEventListener('submit', function (event) {
+          event.preventDefault();
+          const formData = new FormData(inlineForm);
+          const username = formData.get('username') || 'Customer';
+          updateBanner(`Welcome back, ${username}! You are now signed in.`, false);
+        });
+      }
+    })();
+  </script>
 </body>
 
