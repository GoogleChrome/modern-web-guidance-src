+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const statusDotEl = document.getElementById('roast-status-dot');
+      const statusTextEl = document.getElementById('roast-status-text');
+      const stageNameEl = document.getElementById('roast-stage-name');
+
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+      let currentTemp = 385.0;
+      let tempDirection = 1;
+
+      const beanCount = 34;
+      const beans = Array.from({ length: beanCount }, (_, i) => ({
+        x: 80 + (i * 17) % (canvas.width - 160),
+        y: 50 + (i * 23) % (canvas.height - 100),
+        vx: (Math.random() - 0.5) * 2.4 + 0.8,
+        vy: (Math.random() - 0.5) * 2.4 - 0.5,
+        rx: 10 + (i % 4),
+        ry: 6 + (i % 3),
+        angle: (i * 0.45) % (Math.PI * 2),
+        spin: (Math.random() - 0.5) * 0.08 + 0.02,
+        roastLevel: (i % 10) / 10
+      }));
+
+      function getBeanColor(temp, offset) {
+        const normalized = Math.min(1, Math.max(0, (temp - 350) / 95 + offset * 0.15));
+        const r = Math.round(165 - normalized * 105);
+        const g = Math.round(115 - normalized * 80);
+        const b = Math.round(70 - normalized * 50);
+        return `rgb(${r}, ${g}, ${b})`;
+      }
+
+      function getStageName(temp) {
+        if (temp < 375) return 'Drying & Yellowing';
+        if (temp < 402) return 'Maillard Reaction';
+        if (temp < 424) return 'First Crack';
+        return 'Medium-Dark Development';
+      }
+
+      function renderFrame() {
+        if (!isRunning) return;
+
+        const w = canvas.width;
+        const h = canvas.height;
+
+        ctx.fillStyle = '#1b0f0c';
+        ctx.fillRect(0, 0, w, h);
+
+        // Subtle heated drum glow
+        const glow = ctx.createRadialGradient(w * 0.5, h * 0.9, 10, w * 0.5, h * 0.6, w * 0.55);
+        glow.addColorStop(0, 'rgba(255, 111, 0, 0.22)');
+        glow.addColorStop(0.6, 'rgba(255, 171, 64, 0.06)');
+        glow.addColorStop(1, 'rgba(27, 15, 12, 0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, w, h);
+
+        // Draw tumbling coffee beans
+        for (let i = 0; i < beans.length; i++) {
+          const b = beans[i];
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.spin;
+
+          if (b.x < 24 || b.x > w - 24) b.vx *= -1;
+          if (b.y < 24 || b.y > h - 24) b.vy *= -1;
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.rx, b.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = getBeanColor(currentTemp, b.roastLevel);
+          ctx.fill();
+          ctx.lineWidth = 1;
+          ctx.strokeStyle = 'rgba(20, 10, 5, 0.7)';
+          ctx.stroke();
+
+          // Center crease of the coffee bean
+          ctx.beginPath();
+          ctx.moveTo(-b.rx * 0.75, 0);
+          ctx.quadraticCurveTo(0, b.ry * 0.35, b.rx * 0.75, 0);
+          ctx.strokeStyle = '#1a0d08';
+          ctx.lineWidth = 1.4;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        animationFrameId = requestAnimationFrame(renderFrame);
+      }
+
+      function updateTemperature() {
+        const delta = (Math.random() * 1.4 + 0.4) * tempDirection;
+        currentTemp = Number((currentTemp + delta).toFixed(1));
+
+        if (currentTemp >= 438.0) {
+          currentTemp = 438.0;
+          tempDirection = -1;
+        } else if (currentTemp <= 368.0) {
+          currentTemp = 368.0;
+          tempDirection = 1;
+        }
+
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+        if (stageNameEl) {
+          stageNameEl.textContent = getStageName(currentTemp);
+        }
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+
+        if (statusDotEl) statusDotEl.classList.remove('paused');
+        if (statusTextEl) statusTextEl.textContent = 'Roaster Active';
+
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(renderFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 800);
+        }
+      }
+
+      function pauseSimulation() {
+        if (!isRunning && animationFrameId === null && tempIntervalId === null) return;
+        isRunning = false;
+
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+
+        if (statusDotEl) statusDotEl.classList.add('paused');
+        if (statusTextEl) statusTextEl.textContent = 'Paused (Offscreen)';
+      }
+
+      function handleVisibilityChange(isVisible) {
+        if (isVisible) {
+          startSimulation();
+        } else {
+          pauseSimulation();
+        }
+      }
+
+      // Primary: native rendering state change event (contentvisibilityautostatechange)
+      // Fallback: IntersectionObserver for older browsers lacking native support
+      if ('oncontentvisibilityautostatechange' in widget || 'ContentVisibilityAutoStateChangeEvent' in window) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          handleVisibilityChange(!event.skipped);
+        });
+      } else if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            handleVisibilityChange(entry.isIntersecting);
+          });
+        }, { threshold: 0.05 });
+        observer.observe(widget);
+      } else {
+        // Legacy fallback if neither is supported
+        startSimulation();
+      }
+    })();
+  </script>
