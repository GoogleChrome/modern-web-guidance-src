+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['active', 'favorited', 'checked', 'drink-name', 'drink-id'];
+      }
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this._isSyncing = false;
+        this._handleClick = this._handleClick.bind(this);
+        this._handleKeyDown = this._handleKeyDown.bind(this);
+      }
+
+      connectedCallback() {
+        this._loadPersistedState();
+        this._render();
+        this._updateState();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || this._isSyncing) return;
+        if (this.shadowRoot.innerHTML) {
+          this._updateState();
+        }
+      }
+
+      get favorited() {
+        return (
+          this.hasAttribute('active') ||
+          this.hasAttribute('favorited') ||
+          this.hasAttribute('checked')
+        );
+      }
+
+      set favorited(value) {
+        const isFav = Boolean(value);
+        this._isSyncing = true;
+        if (isFav) {
+          this.setAttribute('active', '');
+          this.setAttribute('favorited', '');
+          this.setAttribute('checked', '');
+        } else {
+          this.removeAttribute('active');
+          this.removeAttribute('favorited');
+          this.removeAttribute('checked');
+        }
+        this._isSyncing = false;
+        this._savePersistedState(isFav);
+        this._updateState();
+      }
+
+      get active() {
+        return this.favorited;
+      }
+
+      set active(value) {
+        this.favorited = value;
+      }
+
+      get checked() {
+        return this.favorited;
+      }
+
+      set checked(value) {
+        this.favorited = value;
+      }
+
+      get drinkName() {
+        return this.getAttribute('drink-name') || 'drink';
+      }
+
+      get drinkId() {
+        return (
+          this.getAttribute('drink-id') ||
+          this.drinkName.toLowerCase().replace(/[^a-z0-9]+/g, '-')
+        );
+      }
+
+      _getStorageKey() {
+        return `daily-grind:favorite:${this.drinkId}`;
+      }
+
+      _loadPersistedState() {
+        try {
+          const saved = localStorage.getItem(this._getStorageKey());
+          if (saved === 'true') {
+            this.favorited = true;
+          } else if (saved === 'false') {
+            this.favorited = false;
+          }
+        } catch (err) {
+          // Ignore storage access errors
+        }
+      }
+
+      _savePersistedState(isFav) {
+        try {
+          localStorage.setItem(this._getStorageKey(), String(isFav));
+        } catch (err) {
+          // Ignore storage access errors
+        }
+      }
+
+      toggle() {
+        this.favorited = !this.favorited;
+        const detail = {
+          drinkId: this.drinkId,
+          drinkName: this.drinkName,
+          favorited: this.favorited,
+          active: this.favorited,
+          checked: this.favorited,
+        };
+        this.dispatchEvent(
+          new CustomEvent('favorite-toggle', {
+            detail,
+            bubbles: true,
+            composed: true,
+          })
+        );
+        this.dispatchEvent(
+          new CustomEvent('change', {
+            detail,
+            bubbles: true,
+            composed: true,
+          })
+        );
+      }
+
+      _handleClick(event) {
+        event.stopPropagation();
+        this.toggle();
+      }
+
+      _handleKeyDown(event) {
+        if (event.key === ' ' || event.key === 'Enter') {
+          event.preventDefault();
+          this.toggle();
+        }
+      }
+
+      _updateState() {
+        const isFav = this.favorited;
+        const name = this.drinkName;
+        const label = isFav
+          ? `Remove ${name} from favorites`
+          : `Mark ${name} as a favorite`;
+
+        this.setAttribute('aria-pressed', String(isFav));
+        this.setAttribute('aria-checked', String(isFav));
+
+        const btn = this.shadowRoot.querySelector('button');
+        if (btn) {
+          btn.setAttribute('aria-pressed', String(isFav));
+          btn.setAttribute('aria-label', label);
+          btn.setAttribute('title', label);
+          btn.classList.toggle('active', isFav);
+        }
+      }
+
+      _render() {
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+            }
+
+            button {
+              appearance: none;
+              border: 1px solid var(--secondary, #d7ccc8);
+              background: var(--light, #fafafa);
+              color: #8d6e63;
+              width: 36px;
+              height: 36px;
+              border-radius: 50%;
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+              cursor: pointer;
+              padding: 0;
+              transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
+            }
+
+            button:hover {
+              border-color: var(--accent, #ffab40);
+              color: #e53935;
+              background: #fff8f6;
+              transform: scale(1.06);
+            }
+
+            button:focus-visible {
+              outline: 2px solid var(--accent, #ffab40);
+              outline-offset: 2px;
+            }
+
+            button:active {
+              transform: scale(0.95);
+            }
+
+            button.active {
+              background: #ffebee;
+              border-color: #ef5350;
+              color: #e53935;
+              box-shadow: 0 2px 6px rgba(229, 57, 53, 0.2);
+            }
+
+            svg {
+              width: 18px;
+              height: 18px;
+              fill: transparent;
+              stroke: currentColor;
+              stroke-width: 2;
+              stroke-linecap: round;
+              stroke-linejoin: round;
+              transition: fill 0.2s ease, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
+            }
+
+            button.active svg {
+              fill: currentColor;
+              transform: scale(1.12);
+            }
+          </style>
+          <button type="button" part="button" aria-pressed="false">
+            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
+            </svg>
+          </button>
+        `;
+
+        const btn = this.shadowRoot.querySelector('button');
+        btn.addEventListener('click', this._handleClick);
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
+
 </body>
 
