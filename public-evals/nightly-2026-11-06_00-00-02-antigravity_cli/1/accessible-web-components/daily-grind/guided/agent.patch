+  <script type="module">
+    const favoriteToggleTemplate = document.createElement('template');
+    favoriteToggleTemplate.innerHTML = `
+      <span class="heart" part="icon" aria-hidden="true">♥</span>
+      <span class="label" part="label"><slot>Favorite</slot></span>
+      <span class="track" part="track" aria-hidden="true"><span class="thumb" part="thumb"></span></span>
+    `;
+
+    const favoriteToggleSheet = new CSSStyleSheet();
+    favoriteToggleSheet.replaceSync(`
+      :host {
+        --_accent: var(--favorite-accent, #ffab40);
+        --_color: var(--favorite-color, #4e342e);
+        --_bg: var(--favorite-bg, #fdfaf8);
+        --_border: var(--favorite-border, #d7ccc8);
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding: 0.35rem 0.75rem;
+        border-radius: 999px;
+        border: 1px solid var(--_border);
+        background: var(--_bg);
+        color: var(--_color);
+        font: inherit;
+        font-size: 0.875rem;
+        font-weight: 600;
+        cursor: pointer;
+        user-select: none;
+        transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s;
+      }
+
+      :host(:hover) {
+        border-color: var(--_accent);
+      }
+
+      :host(:focus-visible) {
+        outline: 3px solid var(--_accent);
+        outline-offset: 2px;
+      }
+
+      :host([disabled]) {
+        opacity: 0.5;
+        pointer-events: none;
+      }
+
+      .heart {
+        font-size: 1rem;
+        line-height: 1;
+        color: var(--_border);
+        transition: color 0.2s, transform 0.2s;
+      }
+
+      :host(:state(favorited)) {
+        background: rgba(255, 171, 64, 0.14);
+        border-color: var(--_accent);
+      }
+
+      :host(:state(favorited)) .heart {
+        color: #e53935;
+        transform: scale(1.15);
+      }
+
+      .track {
+        position: relative;
+        width: 2rem;
+        height: 1.125rem;
+        border-radius: 999px;
+        background: var(--_border);
+        transition: background-color 0.2s;
+      }
+
+      :host(:state(favorited)) .track {
+        background: var(--_accent);
+      }
+
+      .thumb {
+        position: absolute;
+        top: 2px;
+        left: 2px;
+        width: calc(1.125rem - 4px);
+        height: calc(1.125rem - 4px);
+        border-radius: 50%;
+        background: #ffffff;
+        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+        transition: transform 0.2s;
+      }
+
+      :host(:state(favorited)) .thumb {
+        transform: translateX(0.875rem);
+      }
+    `);
+
+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['checked', 'disabled', 'label'];
+
+      #internals;
+      #hasAriaMixin = false;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.#hasAriaMixin = 'role' in this.#internals;
+        if (this.#hasAriaMixin) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        }
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [favoriteToggleSheet];
+        this.shadowRoot.append(favoriteToggleTemplate.content.cloneNode(true));
+
+        this.addEventListener('click', () => this.toggle());
+        this.addEventListener('keydown', (e) => {
+          if (e.key === ' ' || e.key === 'Enter') {
+            e.preventDefault();
+            this.toggle();
+          }
+        });
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex') && !this.disabled) {
+          this.tabIndex = 0;
+        }
+        if (!this.#hasAriaMixin && !this.hasAttribute('role')) {
+          this.setAttribute('role', 'switch');
+        }
+        this.#restoreSavedState();
+        this.#syncState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        this.#syncState();
+      }
+
+      get checked() {
+        return this.hasAttribute('checked');
+      }
+
+      set checked(on) {
+        this.toggleAttribute('checked', Boolean(on));
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+
+      set label(val) {
+        val ? this.setAttribute('label', val) : this.removeAttribute('label');
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id') ?? '';
+      }
+
+      set drinkId(val) {
+        val ? this.setAttribute('drink-id', val) : this.removeAttribute('drink-id');
+      }
+
+      toggle(force = !this.checked) {
+        if (this.disabled) return false;
+        const next = Boolean(force);
+        if (next === this.checked) return next;
+        this.checked = next;
+        this.#persistState();
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        return next;
+      }
+
+      #restoreSavedState() {
+        if (!this.drinkId || this.hasAttribute('checked')) return;
+        try {
+          const saved = localStorage.getItem(`daily-grind:fav:${this.drinkId}`);
+          if (saved === 'true') {
+            this.checked = true;
+          }
+        } catch {
+          // Ignore storage restrictions
+        }
+      }
+
+      #persistState() {
+        if (!this.drinkId) return;
+        try {
+          localStorage.setItem(`daily-grind:fav:${this.drinkId}`, String(this.checked));
+        } catch {
+          // Ignore storage restrictions
+        }
+      }
+
+      #syncState() {
+        const isChecked = this.checked;
+        const isDisabled = this.disabled;
+
+        if (this.#hasAriaMixin) {
+          this.#internals.ariaChecked = String(isChecked);
+          this.#internals.ariaDisabled = String(isDisabled);
+          if (this.label) {
+            this.#internals.ariaLabel = this.label;
+          }
+        } else {
+          this.setAttribute('aria-checked', String(isChecked));
+          if (isDisabled) {
+            this.setAttribute('aria-disabled', 'true');
+          } else {
+            this.removeAttribute('aria-disabled');
+          }
+          if (this.label && !this.hasAttribute('aria-label')) {
+            this.setAttribute('aria-label', this.label);
+          }
+        }
+
+        if (isChecked) {
+          this.#internals.states.add('favorited');
+        } else {
+          this.#internals.states.delete('favorited');
+        }
+      }
+    }
+
+    customElements.define('favorite-toggle', FavoriteToggle);
+  </script>
