+  <script type="module">
+    // Out-of-order coffee order events collected from distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps (including multiple events
+    // occurring within the same millisecond: 08:15:30.104...).
+    const rawOrderEvents = [
+      {
+        arrivalOrder: 1,
+        orderId: 'ORD-8842',
+        service: 'roastery-queue-svc',
+        eventType: 'barista.ticket.dispatched',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.105420110Z',
+      },
+      {
+        arrivalOrder: 2,
+        orderId: 'ORD-8842',
+        service: 'inventory-lock-svc',
+        eventType: 'beans.batch.reserved',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.104210890Z',
+      },
+      {
+        arrivalOrder: 3,
+        orderId: 'ORD-8842',
+        service: 'edge-gateway-us-east',
+        eventType: 'order.request.received',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.104002150Z',
+      },
+      {
+        arrivalOrder: 4,
+        orderId: 'ORD-8842',
+        service: 'loyalty-ledger-svc',
+        eventType: 'rewards.points.accrued',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.104998405Z',
+      },
+      {
+        arrivalOrder: 5,
+        orderId: 'ORD-8842',
+        service: 'auth-token-validator',
+        eventType: 'session.token.verified',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.104002985Z',
+      },
+      {
+        arrivalOrder: 6,
+        orderId: 'ORD-8842',
+        service: 'payment-settlement-svc',
+        eventType: 'payment.intent.captured',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.104998012Z',
+      },
+      {
+        arrivalOrder: 7,
+        orderId: 'ORD-8842',
+        service: 'espresso-telemetry-svc',
+        eventType: 'extraction.shot.queued',
+        item: 'Maple Oat Latte',
+        ts: '2026-11-06T08:15:30.106000500Z',
+      },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    // 1. Parse recorded nanosecond timestamps as Temporal.Instant (never new Date(ts),
+    // which truncates sub-millisecond precision).
+    function parseEvents(rawItems) {
+      return rawItems.map((evt) => ({
+        ...evt,
+        timestamp: Temporal.Instant.from(evt.ts),
+      }));
+    }
+
+    // 2. Sort chronologically using Temporal.Instant.compare(a, b)
+    function sequenceEvents(items) {
+      return [...items].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    // 3. Measure intervals between consecutive events using instant.since(previousInstant)
+    function analyzeOrderTrace(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            gap: null,
+            formattedInterval: 'Initial event (0ns)',
+            isSimultaneous: false,
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        const gap = curr.timestamp.since(prev.timestamp);
+        const formattedInterval = isSimultaneous
+          ? '0ns'
+          : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`;
+
+        return {
+          ...curr,
+          gap,
+          formattedInterval,
+          isSimultaneous,
+        };
+      });
+    }
+
+    function renderOrderEvents() {
+      const parsed = parseEvents(rawOrderEvents);
+      const sorted = sequenceEvents(parsed);
+      const analyzed = analyzeOrderTrace(sorted);
+
+      const tbody = document.getElementById('events-tbody');
+      tbody.replaceChildren();
+
+      let subMsCollisionsPrevented = 0;
+      for (let i = 1; i < analyzed.length; i++) {
+        if (analyzed[i].timestamp.epochMilliseconds === analyzed[i - 1].timestamp.epochMilliseconds) {
+          subMsCollisionsPrevented++;
+        }
+      }
+
+      analyzed.forEach((evt, index) => {
+        const tr = document.createElement('tr');
+
+        const seqTd = document.createElement('td');
+        seqTd.className = 'mono';
+        seqTd.textContent = `${index + 1} (in: #${evt.arrivalOrder})`;
+
+        const orderTd = document.createElement('td');
+        orderTd.className = 'mono';
+        orderTd.textContent = `${evt.orderId} (${evt.item})`;
+
+        const serviceTd = document.createElement('td');
+        const serviceBadge = document.createElement('span');
+        serviceBadge.className = 'service-badge mono';
+        serviceBadge.textContent = evt.service;
+        serviceTd.append(serviceBadge);
+
+        const typeTd = document.createElement('td');
+        typeTd.className = 'mono';
+        typeTd.textContent = evt.eventType;
+
+        const tsTd = document.createElement('td');
+        const timeEl = document.createElement('time');
+        timeEl.className = 'mono';
+        timeEl.dateTime = evt.timestamp.toString();
+        timeEl.textContent = evt.timestamp.toString();
+        tsTd.append(timeEl);
+
+        const intervalTd = document.createElement('td');
+        const intervalBadge = document.createElement('span');
+        intervalBadge.className = 'interval-badge mono';
+        intervalBadge.textContent = evt.formattedInterval;
+        if (evt.gap) {
+          intervalBadge.title = `ISO 8601 Duration: ${evt.gap.toString()}`;
+        }
+        intervalTd.append(intervalBadge);
+
+        tr.append(seqTd, orderTd, serviceTd, typeTd, tsTd, intervalTd);
+        tbody.append(tr);
+      });
+
+      const firstInstant = analyzed[0].timestamp;
+      const lastInstant = analyzed[analyzed.length - 1].timestamp;
+      const totalSpan = lastInstant.since(firstInstant);
+
+      document.getElementById('stat-event-count').textContent = String(analyzed.length);
+      document.getElementById('stat-subms-count').textContent = String(subMsCollisionsPrevented);
+      document.getElementById('stat-total-span').textContent = totalSpan.toLocaleString('en-US', {
+        style: 'narrow',
+      });
+      document.getElementById('telemetry-results').hidden = false;
+    }
+
+    function initializeApp() {
+      const loadBtn = document.getElementById('load-events-btn');
+      loadBtn?.addEventListener('click', () => {
+        renderOrderEvents();
+      });
+    }
+
+    (async () => {
+      await ensureTemporal();
+      initializeApp();
+    })();
+  </script>
 </body>
 
