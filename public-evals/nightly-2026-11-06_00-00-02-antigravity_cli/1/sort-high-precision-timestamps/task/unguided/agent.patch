+        </div>
+        <div class="metric-box">
+          <div class="metric-label">Shortest Interval (&Delta; min)</div>
+          <div class="metric-value" id="metric-min-interval">+${summary.minIntervalNanoseconds.toLocaleString()} ns</div>
+        </div>
