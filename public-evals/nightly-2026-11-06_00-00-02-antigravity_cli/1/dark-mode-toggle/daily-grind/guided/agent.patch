+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggleBtn = document.getElementById('theme-toggle');
+
+      function getSystemScheme() {
+        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+
+      function getStoredScheme() {
+        try {
+          const val = localStorage.getItem('color-scheme');
+          return val === 'light' || val === 'dark' ? val : null;
+        } catch {
+          return null;
+        }
+      }
+
+      function getRenderedScheme() {
+        const stored = getStoredScheme();
+        if (stored) return stored;
+        if (meta.content === 'light' || meta.content === 'dark') return meta.content;
+        return getSystemScheme();
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        const currentScheme = getRenderedScheme();
+        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';
+        const systemScheme = getSystemScheme();
+
+        if (targetScheme !== systemScheme) {
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+          meta.content = targetScheme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme' || e.key === null) {
+          meta.content = e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'light dark';
+        }
+      });
+    })();
+  </script>
+
