diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,105 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-track: #e8e0dc;
+      --scrollbar-thumb: #4e342e;
+      --scrollbar-thumb-hover: #271815;
+      --scrollbar-thumb-active: #1b0f0d;
+      --scrollbar-border: #fafafa;
+      --scrollbar-width: 16px;
     }
 
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #222222;
+        --scrollbar-thumb-active: #000000;
+        --scrollbar-border: #000000;
+        --scrollbar-width: 18px;
+      }
+    }
+
+    /* Prominent, High-Contrast Scrollbar Styles */
+    html {
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+    }
+
+    ::-webkit-scrollbar {
+      width: var(--scrollbar-width);
+      height: var(--scrollbar-width);
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 2px solid var(--secondary);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border-radius: 8px;
+      border: 3px solid var(--scrollbar-border);
+      min-height: 48px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+      border-width: 2px;
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: var(--scrollbar-thumb-active);
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    @media (prefers-contrast: more) {
+      ::-webkit-scrollbar-track {
+        border-left: 2px solid #000000;
+        box-shadow: inset 0 0 0 1px #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-radius: 0;
+        border: 2px solid #ffffff;
+        outline: 2px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: #000000;
+        border-color: var(--accent);
+      }
+    }
+
+    @media (forced-colors: active) {
+      html {
+        scrollbar-color: ButtonText ButtonFace;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: ButtonFace;
+        border-left: 2px solid ButtonText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: ButtonText;
+        border: 2px solid ButtonFace;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: Highlight;
+        border-color: HighlightText;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
