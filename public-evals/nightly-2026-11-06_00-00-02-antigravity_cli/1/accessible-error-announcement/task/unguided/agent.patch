+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMessage = document.getElementById('newsletter-error');
+      const ERROR_TEXT = 'Please enter a valid email address.';
+
+      function matchesUserInvalid(input) {
+        try {
+          return input.matches(':user-invalid');
+        } catch (e) {
+          return false;
+        }
+      }
+
+      function showError() {
+        emailInput.setAttribute('aria-invalid', 'true');
+        emailInput.classList.add('is-invalid');
+        errorMessage.classList.add('visible');
+        if (errorMessage.textContent !== ERROR_TEXT) {
+          errorMessage.textContent = ERROR_TEXT;
+        }
+      }
+
+      function clearError() {
+        emailInput.setAttribute('aria-invalid', 'false');
+        emailInput.classList.remove('is-invalid');
+        errorMessage.classList.remove('visible');
+        if (errorMessage.textContent !== '') {
+          errorMessage.textContent = '';
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        if (!emailInput.validity.valid) {
+          showError();
+        } else {
+          clearError();
+        }
+      });
+
+      emailInput.addEventListener('change', function () {
+        if (!emailInput.validity.valid) {
+          showError();
+        } else {
+          clearError();
+        }
+      });
+
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        showError();
+      });
+
+      emailInput.addEventListener('input', function () {
+        if (emailInput.validity.valid) {
+          clearError();
+        } else if (matchesUserInvalid(emailInput) || emailInput.getAttribute('aria-invalid') === 'true') {
+          showError();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!emailInput.checkValidity()) {
+          showError();
+        } else {
+          clearError();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
