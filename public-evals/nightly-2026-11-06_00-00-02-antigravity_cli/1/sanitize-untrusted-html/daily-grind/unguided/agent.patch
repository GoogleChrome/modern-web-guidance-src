+  <script>
+    (function () {
+      const INITIAL_REVIEWS = [
+        {
+          name: 'Maya Lin',
+          drink: 'Maple Oat Latte',
+          rating: 5,
+          feedback: 'The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of sweetness and roast!<ul><li>Silky oat foam</li><li>Real Vermont maple flavor</li></ul>'
+        },
+        {
+          name: 'Jordan Vance',
+          drink: 'Cold Brew',
+          rating: 5,
+          feedback: 'Steeped for <b>18 hours</b> and you can truly taste the difference. Zero bitterness and <i>super refreshing</i>.'
+        }
+      ];
+
+      /**
+       * Renders untrusted HTML safely into the target element using the browser's
+       * built-in safe HTML parsing and sanitization capabilities (Element.prototype.setHTML
+       * or Document.parseHTML) to strip out unsafe elements and attributes.
+       */
+      function renderSanitizedHTML(targetElement, untrustedHTML) {
+        const htmlString = String(untrustedHTML ?? '');
+
+        if (typeof targetElement.setHTML === 'function') {
+          targetElement.setHTML(htmlString);
+          return;
+        }
+
+        if (typeof Document.parseHTML === 'function') {
+          const parsedDoc = Document.parseHTML(htmlString);
+          targetElement.replaceChildren(...parsedDoc.body.childNodes);
+          return;
+        }
+
+        // Fallback DOM-based sanitizer if running in a browser without native Sanitizer API support
+        const parser = new DOMParser();
+        const doc = parser.parseFromString(htmlString, 'text/html');
+        const allowedTags = new Set([
+          'B', 'I', 'EM', 'STRONG', 'U', 'S', 'SMALL', 'MARK', 'SUB', 'SUP',
+          'P', 'BR', 'HR', 'UL', 'OL', 'LI', 'BLOCKQUOTE', 'CODE', 'PRE', 'SPAN', 'DIV',
+          'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'A'
+        ]);
+        const allowedAttrs = new Set(['href', 'title', 'class']);
+
+        function cleanNode(node) {
+          const children = Array.from(node.childNodes);
+          for (const child of children) {
+            if (child.nodeType === Node.ELEMENT_NODE) {
+              if (!allowedTags.has(child.tagName)) {
+                child.remove();
+                continue;
+              }
+              for (const attr of Array.from(child.attributes)) {
+                const name = attr.name.toLowerCase();
+                const val = attr.value.trim().toLowerCase();
+                if (!allowedAttrs.has(name) || (name === 'href' && (val.startsWith('javascript:') || val.startsWith('data:') || val.startsWith('vbscript:')))) {
+                  child.removeAttribute(attr.name);
+                }
+              }
+              cleanNode(child);
+            } else if (child.nodeType !== Node.TEXT_NODE) {
+              child.remove();
+            }
+          }
+        }
+
+        cleanNode(doc.body);
+        targetElement.replaceChildren(...doc.body.childNodes);
+      }
+
+      function createReviewElement(review) {
+        const item = document.createElement('article');
+        item.className = 'review-item';
+
+        const header = document.createElement('div');
+        header.className = 'review-header';
+
+        const leftMeta = document.createElement('div');
+        const author = document.createElement('span');
+        author.className = 'review-author';
+        author.textContent = review.name;
+
+        const badge = document.createElement('span');
+        badge.className = 'review-drink-badge';
+        badge.style.marginLeft = '8px';
+        badge.textContent = review.drink;
+
+        leftMeta.appendChild(author);
+        leftMeta.appendChild(badge);
+
+        const ratingEl = document.createElement('div');
+        ratingEl.className = 'review-rating';
+        const starsCount = Math.min(5, Math.max(1, Number(review.rating) || 5));
+        ratingEl.textContent = '★'.repeat(starsCount) + '☆'.repeat(5 - starsCount);
+        ratingEl.setAttribute('aria-label', starsCount + ' out of 5 stars');
+
+        header.appendChild(leftMeta);
+        header.appendChild(ratingEl);
+
+        const content = document.createElement('div');
+        content.className = 'review-content';
+        renderSanitizedHTML(content, review.feedback);
+
+        item.appendChild(header);
+        item.appendChild(content);
+
+        return item;
+      }
+
+      const reviewsList = document.getElementById('reviews-list');
+      const reviewForm = document.getElementById('review-form');
+
+      INITIAL_REVIEWS.forEach(function (review) {
+        reviewsList.appendChild(createReviewElement(review));
+      });
+
+      reviewForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        const nameInput = document.getElementById('reviewer-name');
+        const drinkSelect = document.getElementById('review-drink');
+        const ratingSelect = document.getElementById('review-rating');
+        const feedbackInput = document.getElementById('review-feedback');
+
+        const newReview = {
+          name: nameInput.value.trim() || 'Anonymous Customer',
+          drink: drinkSelect.value,
+          rating: parseInt(ratingSelect.value, 10) || 5,
+          feedback: feedbackInput.value
+        };
+
+        const reviewEl = createReviewElement(newReview);
+        reviewsList.prepend(reviewEl);
+
+        feedbackInput.value = '';
+        nameInput.value = '';
+      });
+    })();
+  </script>
+
