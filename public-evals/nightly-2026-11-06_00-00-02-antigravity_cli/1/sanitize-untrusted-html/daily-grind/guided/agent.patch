+        drink: 'Dark Roast Espresso',
+        author: 'Marcus T.',
+        rating: 5,
+        html: '<p>Rich crema with <em>zero bitterness</em>. My favorite tasting notes:</p><ul><li>Smoked cacao</li><li>Toasted walnut</li></ul>'
+      },
+      {
+        drink: 'Cold Brew',
+        author: 'Priya K.',
+        rating: 4,
+        html: '<p>The <code>18-hour</code> steep time makes a real difference—<span class="highlight">silky smooth</span> even without milk.</p>'
+      }
+    ];
+
+    async function createReviewListItem(review, showDrinkBadge = false) {
+      const li = document.createElement('li');
+      li.className = 'review-item';
+
+      if (showDrinkBadge) {
+        const badge = document.createElement('span');
+        badge.className = 'review-drink-badge';
+        badge.textContent = review.drink;
+        li.appendChild(badge);
+      }
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const authorEl = document.createElement('span');
+      authorEl.className = 'review-author';
+      authorEl.textContent = review.author;
+
+      const metaEl = document.createElement('span');
+      metaEl.className = 'review-meta';
+      const stars = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
+      metaEl.textContent = `${stars} (${review.rating}/5)`;
+
+      header.append(authorEl, metaEl);
+
+      const contentEl = document.createElement('div');
+      contentEl.className = 'review-content';
+      await safeSetHTML(contentEl, review.html);
+
+      li.append(header, contentEl);
+      return li;
+    }
+
+    function updateDrinkSummaries() {
+      const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'];
+      for (const drink of drinks) {
+        const summaryEl = document.querySelector(`[data-drink-summary="${drink}"]`);
+        if (!summaryEl) continue;
+
+        const matching = reviews.filter((r) => r.drink === drink);
+        const count = matching.length;
+        const avg = count
+          ? (matching.reduce((sum, r) => sum + r.rating, 0) / count).toFixed(1)
+          : '0.0';
+        summaryEl.textContent = `★ ${avg} (${count} ${count === 1 ? 'review' : 'reviews'})`;
+      }
+    }
+
+    async function renderAllReviews() {
+      const feedEl = document.getElementById('all-reviews-feed');
+      const drinkLists = new Map();
+
+      document.querySelectorAll('[data-drink-reviews]').forEach((listEl) => {
+        listEl.replaceChildren();
+        drinkLists.set(listEl.getAttribute('data-drink-reviews'), listEl);
+      });
+
+      feedEl.replaceChildren();
+
+      for (const review of reviews) {
+        const feedItem = await createReviewListItem(review, true);
+        feedEl.appendChild(feedItem);
+
+        const drinkListEl = drinkLists.get(review.drink);
+        if (drinkListEl) {
+          const cardItem = await createReviewListItem(review, false);
+          drinkListEl.appendChild(cardItem);
+        }
+      }
+
+      updateDrinkSummaries();
+    }
+
+    // Wire up "Review Drink" card triggers
+    document.querySelectorAll('.write-review-trigger').forEach((button) => {
+      button.addEventListener('click', () => {
+        const targetDrink = button.getAttribute('data-select-drink');
+        const radio = document.querySelector(`input[name="drink"][value="${targetDrink}"]`);
+        if (radio) {
+          radio.checked = true;
+        }
+        const nameInput = document.getElementById('reviewer-name');
+        nameInput?.focus();
+      });
+    });
+
+    // Wire up formatting shortcut buttons
+    const reviewTextarea = document.getElementById('review-html');
+    const reviewPreview = document.getElementById('review-preview');
+
+    document.querySelectorAll('.format-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const tag = btn.getAttribute('data-insert-tag');
+        if (!tag || !reviewTextarea) return;
+
+        const start = reviewTextarea.selectionStart ?? reviewTextarea.value.length;
+        const end = reviewTextarea.selectionEnd ?? reviewTextarea.value.length;
+        const selected = reviewTextarea.value.slice(start, end) || 'tasting note';
+        const snippet =
+          tag === 'ul'
+            ? `<ul><li>${selected}</li></ul>`
+            : `<${tag}>${selected}</${tag}>`;
+
+        reviewTextarea.setRangeText(snippet, start, end, 'end');
+        reviewTextarea.dispatchEvent(new Event('input', { bubbles: true }));
+        reviewTextarea.focus();
+      });
+    });
+
+    // Validation & live preview following blur/input timing guidelines
+    const reviewerNameInput = document.getElementById('reviewer-name');
+    const reviewerNameError = document.getElementById('reviewer-name-error');
+    const reviewHtmlError = document.getElementById('review-html-error');
+    const formStatus = document.getElementById('review-form-status');
+    const reviewForm = document.getElementById('review-form');
+    const submitBtn = document.getElementById('submit-review-btn');
+
+    function validateField(input, errorEl, emptyMessage, tooShortMessage) {
+      input.setCustomValidity('');
+      if (input.validity.valueMissing || !input.value.trim()) {
+        input.setCustomValidity(emptyMessage);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = emptyMessage;
+        return false;
+      }
+      if (input.validity.tooShort && tooShortMessage) {
+        input.setCustomValidity(tooShortMessage);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = tooShortMessage;
+        return false;
+      }
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      return true;
+    }
+
+    reviewerNameInput.addEventListener('blur', () => {
+      validateField(
+        reviewerNameInput,
+        reviewerNameError,
+        'Please enter your name.',
+        'Name must be at least 2 characters.'
+      );
+    });
+
+    reviewerNameInput.addEventListener('input', () => {
+      reviewerNameInput.setCustomValidity('');
+      reviewerNameInput.removeAttribute('aria-invalid');
+      reviewerNameError.textContent = '';
+      formStatus.textContent = '';
+      formStatus.className = 'form-status';
+    });
+
+    reviewTextarea.addEventListener('blur', () => {
+      validateField(
+        reviewTextarea,
+        reviewHtmlError,
+        'Please enter your review feedback.'
+      );
+    });
+
+    reviewTextarea.addEventListener('input', () => {
+      reviewTextarea.setCustomValidity('');
+      reviewTextarea.removeAttribute('aria-invalid');
+      reviewHtmlError.textContent = '';
+      formStatus.textContent = '';
+      formStatus.className = 'form-status';
+      safePreviewHTML(reviewPreview, reviewTextarea.value);
+    });
+
+    reviewForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      const isNameValid = validateField(
+        reviewerNameInput,
+        reviewerNameError,
+        'Please enter your name.',
+        'Name must be at least 2 characters.'
+      );
+      const isHtmlValid = validateField(
+        reviewTextarea,
+        reviewHtmlError,
+        'Please enter your review feedback.'
+      );
+
+      if (!isNameValid || !isHtmlValid) {
+        formStatus.textContent = 'Please fix the highlighted fields before submitting.';
+        formStatus.className = 'form-status is-error';
+        if (!isNameValid) {
+          reviewerNameInput.focus();
+        } else {
+          reviewTextarea.focus();
+        }
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        const formData = new FormData(reviewForm);
+        const drink = String(formData.get('drink') || 'Maple Oat Latte');
+        const rating = Number(formData.get('rating') || 5);
+        const author = String(formData.get('reviewer_name') || '').trim();
+        const html = String(formData.get('review_html') || '');
+
+        reviews.unshift({ drink, author, rating, html });
+        await renderAllReviews();
+
+        reviewForm.reset();
+        await safePreviewHTML(reviewPreview, '');
+
+        formStatus.textContent = `Thank you, ${author}! Your sanitized review for ${drink} has been posted.`;
+        formStatus.className = 'form-status is-success';
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    renderAllReviews();
+  </script>
+
 </body>
 
 </html>
