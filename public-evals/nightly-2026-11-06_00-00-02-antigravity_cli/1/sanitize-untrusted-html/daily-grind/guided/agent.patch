+      const elements = ALLOWED_ELEMENTS;
+      const attributes = ALLOWED_ATTRIBUTES;
+
+      if ('setHTML' in Element.prototype) {
+        // setHTML() parses, sanitizes, and inserts untrusted HTML in one step
+        el.setHTML(html, { sanitizer: { elements, attributes } });
