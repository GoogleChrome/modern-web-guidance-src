+  <script>
+    (function () {
+      const list = document.querySelector('.SwipeableList');
+      if (!list) return;
+
+      const SWIPE_THRESHOLD_RATIO = 0.3;
+      const MIN_THRESHOLD_PX = 80;
+      const NEUTRAL_BG = '#bcaaa4';
+      const ACTION_BG = '#d32f2f';
+
+      function updateCartTotal() {
+        const remainingItems = list.querySelectorAll('.SwipeableList-item:not(.is-collapsing)');
+        let total = 0;
+        remainingItems.forEach((item) => {
+          const price = parseFloat(item.getAttribute('data-price') || '0');
+          if (!isNaN(price)) total += price;
+        });
+
+        const totalEl = document.getElementById('cart-total');
+        if (totalEl) {
+          totalEl.textContent = '$' + total.toFixed(2);
+        }
+
+        const emptyMsg = document.getElementById('cart-empty-msg');
+        const summary = document.getElementById('cart-summary');
+        if (remainingItems.length === 0) {
+          if (emptyMsg) emptyMsg.style.display = 'block';
+          if (summary) summary.style.display = 'none';
+        }
+      }
+
+      function initSwipeItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let startX = 0;
+        let currentDeltaX = 0;
+        let isDragging = false;
+        let isRemoved = false;
+
+        function getThreshold() {
+          const width = item.offsetWidth || 300;
+          return Math.max(MIN_THRESHOLD_PX, width * SWIPE_THRESHOLD_RATIO);
+        }
+
+        function onStart(clientX) {
+          if (isRemoved) return;
+          isDragging = true;
+          startX = clientX;
+          currentDeltaX = 0;
+          content.classList.add('is-dragging');
+          content.style.transition = 'none';
+        }
+
+        function onMove(clientX) {
+          if (!isDragging || isRemoved) return;
+          currentDeltaX = clientX - startX;
+          content.style.transform = `translateX(${currentDeltaX}px)`;
+
+          const pastThreshold = Math.abs(currentDeltaX) >= getThreshold();
+          if (pastThreshold) {
+            item.classList.add('is-past-threshold');
+            track.classList.add('is-past-threshold');
+            track.style.backgroundColor = ACTION_BG;
+          } else {
+            item.classList.remove('is-past-threshold');
+            track.classList.remove('is-past-threshold');
+            track.style.backgroundColor = NEUTRAL_BG;
+          }
+        }
+
+        function onEnd() {
+          if (!isDragging || isRemoved) return;
+          isDragging = false;
+          content.classList.remove('is-dragging');
+          content.style.transition = 'transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1)';
+
+          const threshold = getThreshold();
+          if (Math.abs(currentDeltaX) >= threshold) {
+            isRemoved = true;
+            const direction = currentDeltaX >= 0 ? 1 : -1;
+            const width = item.offsetWidth || 500;
+
+            item.classList.add('is-past-threshold');
+            track.classList.add('is-past-threshold');
+            track.style.backgroundColor = ACTION_BG;
+            content.style.transform = `translateX(${direction * width}px)`;
+
+            // Measure current height and smoothly collapse down to 0
+            const currentHeight = item.offsetHeight;
+            item.style.height = currentHeight + 'px';
+            item.style.maxHeight = currentHeight + 'px';
+            // Force reflow so browser registers starting height
+            void item.offsetHeight;
+
+            item.classList.add('is-collapsing');
+            item.style.transition = 'height 0.35s ease, max-height 0.35s ease, margin-bottom 0.35s ease, padding 0.35s ease, opacity 0.3s ease';
+            item.style.height = '0px';
+            item.style.maxHeight = '0px';
+            item.style.marginBottom = '0px';
+            item.style.paddingTop = '0px';
+            item.style.paddingBottom = '0px';
+            item.style.opacity = '0';
+
+            updateCartTotal();
+
+            setTimeout(() => {
+              if (item.parentNode) {
+                item.parentNode.removeChild(item);
+              }
+            }, 360);
+          } else {
+            content.style.transform = 'translateX(0px)';
+            item.classList.remove('is-past-threshold');
+            track.classList.remove('is-past-threshold');
+            track.style.backgroundColor = NEUTRAL_BG;
+          }
+        }
+
+        // Pointer Events
+        content.addEventListener('pointerdown', (e) => {
+          if (e.button !== undefined && e.button !== 0) return;
+          onStart(e.clientX);
+          if (content.setPointerCapture && e.pointerId !== undefined) {
+            try {
+              content.setPointerCapture(e.pointerId);
+            } catch (_) {}
+          }
+        });
+
+        window.addEventListener('pointermove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX);
+        });
+
+        window.addEventListener('pointerup', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        window.addEventListener('pointercancel', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        // Mouse Events fallback (for environments dispatching synthetic mouse events)
+        content.addEventListener('mousedown', (e) => {
+          if (isDragging) return;
+          if (e.button !== undefined && e.button !== 0) return;
+          onStart(e.clientX);
+        });
+
+        window.addEventListener('mousemove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX);
+        });
+
+        window.addEventListener('mouseup', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        // Touch Events fallback
+        content.addEventListener('touchstart', (e) => {
+          if (isDragging) return;
+          if (e.touches && e.touches.length > 0) {
+            onStart(e.touches[0].clientX);
+          }
+        }, { passive: true });
+
+        window.addEventListener('touchmove', (e) => {
+          if (!isDragging) return;
+          if (e.touches && e.touches.length > 0) {
+            onMove(e.touches[0].clientX);
+          }
+        }, { passive: true });
+
+        window.addEventListener('touchend', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+      }
+
+      const items = list.querySelectorAll('.SwipeableList-item');
+      items.forEach(initSwipeItem);
+    })();
+  </script>
+
