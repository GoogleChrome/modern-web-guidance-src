       background: #3e2723;
     }
 
+    /* Customization Checkboxes */
+    .customization-fieldset {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 0.75rem 1rem;
+      margin-top: 15px;
+      text-align: left;
+      background-color: var(--light);
+    }
+
+    .customization-fieldset legend {
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: var(--primary);
+      padding: 0 0.4rem;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+    }
+
+    .checkbox-option {
+      display: flex;
+    }
+
+    .checkbox-label {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.65rem;
+      min-block-size: 44px;
+      inline-size: 100%;
+      cursor: pointer;
+      color: var(--text);
+      font-size: 0.95rem;
+      user-select: none;
+    }
+
+    .checkbox-custom {
+      --checkbox-size: 1.25em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      flex-shrink: 0;
+      margin: 0;
+      color: var(--primary);
+      background-color: #ffffff;
+      border: 2px solid currentColor;
+      border-radius: 4px;
+      cursor: pointer;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 150ms ease, border-color 150ms ease;
+      }
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon) no-repeat center / contain;
+        scale: 0;
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: scale 150ms ease;
+        }
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:hover:not(:disabled) {
+        border-color: var(--text);
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+        background-color: var(--primary);
+        border-color: var(--primary);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+        background-color: var(--primary);
+        border-color: var(--primary);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        background-color: var(--accent);
+        scale: 1;
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+    }
+
+    .checkbox-label:has(.checkbox-custom:disabled) {
+      cursor: not-allowed;
+      opacity: 0.65;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
