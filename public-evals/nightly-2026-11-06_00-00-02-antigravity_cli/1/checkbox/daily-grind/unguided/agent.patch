+
+    /* Custom visual checkbox box */
+    .checkbox-box {
+      width: 20px;
+      height: 20px;
+      border-radius: 5px;
+      border: 2px solid #8d6e63;
+      background-color: #ffffff;
+      display: inline-flex;
