+
+    /* Native checkbox kept accessible and interactive in the DOM */
+    .checkbox-input {
+      position: absolute;
+      opacity: 0;
+      width: 20px;
+      height: 20px;
+      left: 10px;
+      margin: 0;
+      cursor: pointer;
