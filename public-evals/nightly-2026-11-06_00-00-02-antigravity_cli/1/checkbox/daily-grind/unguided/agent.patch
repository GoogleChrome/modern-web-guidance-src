+        transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
+        box-shadow 0.25s ease;
+      animation: checkbox-uncheck 0.25s ease forwards;
+    }
+
+    /* Checkmark SVG icon inside checkbox box */
+    .checkbox-check-icon {
+      width: 13px;
+      height: 13px;
