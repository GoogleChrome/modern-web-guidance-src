+      outline-offset: 2px;
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.35);
+    }
+
+    .custom-checkbox:has(.checkbox-input:focus-visible) {
+      border-color: var(--primary);
+    }
+
+    .checkbox-input:disabled + .checkbox-box,
+    .checkbox-input:disabled ~ .checkbox-content {
+      opacity: 0.55;
+      cursor: not-allowed;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-checkbox,
+      .checkbox-box,
+      .checkbox-check-icon,
+      .option-icon,
+      .checkbox-badge {
+        transition: none;
+        animation: none;
+      }
     }
 
