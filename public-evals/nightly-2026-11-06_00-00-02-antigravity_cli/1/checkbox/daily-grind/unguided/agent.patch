+      fill: none;
+      stroke-dasharray: 24;
+      stroke-dashoffset: 24;
+      opacity: 0;
+      transform: scale(0.5) rotate(-10deg);
+      transition:
+        stroke-dashoffset 0.28s cubic-bezier(0.4, 0, 0.2, 1),
+        opacity 0.2s ease,
+        transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    /* Option label content & custom themed icon */
+    .checkbox-content {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      flex: 1;
+      gap: 8px;
+      font-size: 0.88rem;
+      color: var(--text);
+      transition: color 0.2s ease;
+    }
+
+    .checkbox-label-text {
+      display: inline-flex;
+      align-items: center;
+      gap: 7px;
+      font-weight: 500;
+    }
+
+    .option-icon {
+      width: 16px;
+      height: 16px;
+      color: #795548;
+      flex-shrink: 0;
+      transition: color 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .checkbox-badge {
+      font-size: 0.75rem;
+      font-weight: 600;
+      color: #6d4c41;
+      background: rgba(215, 204, 200, 0.45);
+      padding: 2px 7px;
+      border-radius: 999px;
+      transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
+    }
+
+    /* Checked States & Check/Uncheck Animations */
+    @keyframes checkbox-pop {
+      0% {
+        transform: scale(0.85);
+      }
+      55% {
+        transform: scale(1.16);
+      }
+      100% {
+        transform: scale(1);
+      }
+    }
+
+    @keyframes checkbox-uncheck {
+      0% {
+        transform: scale(1.06);
+      }
+      50% {
+        transform: scale(0.92);
+      }
+      100% {
+        transform: scale(1);
+      }
+    }
+
+    .checkbox-input:checked + .checkbox-box {
+      background-color: var(--primary);
+      border-color: var(--primary);
+      box-shadow: 0 2px 6px rgba(78, 52, 46, 0.3);
+      animation: checkbox-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+    }
+
+    .checkbox-input:checked + .checkbox-box .checkbox-check-icon {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1) rotate(0deg);
+    }
+
+    .checkbox-input:checked ~ .checkbox-content {
+      color: var(--primary);
+    }
+
+    .checkbox-input:checked ~ .checkbox-content .checkbox-label-text {
+      font-weight: 600;
+    }
+
+    .checkbox-input:checked ~ .checkbox-content .option-icon {
+      color: var(--accent);
+      transform: scale(1.15) rotate(-6deg);
+    }
+
+    .checkbox-input:checked ~ .checkbox-content .checkbox-badge {
+      background-color: var(--accent);
