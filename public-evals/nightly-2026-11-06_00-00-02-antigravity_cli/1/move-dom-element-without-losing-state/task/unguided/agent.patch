+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const iframe = document.getElementById('roasting-video');
+    const heroSection = document.querySelector('.hero');
+    const mainContainer = document.querySelector('main.container');
+
+    let isTheaterMode = false;
+
+    function reparentIframe(targetParent, element, referenceNode = null) {
+      if (typeof targetParent.moveBefore === 'function') {
+        targetParent.moveBefore(element, referenceNode);
+      } else if (referenceNode) {
+        targetParent.insertBefore(element, referenceNode);
+      } else {
+        targetParent.appendChild(element);
+      }
+    }
+
+    theaterBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetParent = isTheaterMode ? heroSection : mainContainer;
+
+      reparentIframe(targetParent, iframe, null);
+
+      heroSection.classList.toggle('theater-active', isTheaterMode);
+      theaterBtn.setAttribute('aria-pressed', String(isTheaterMode));
+    });
+  </script>
+
