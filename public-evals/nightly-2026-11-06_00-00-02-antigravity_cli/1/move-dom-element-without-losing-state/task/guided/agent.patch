+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const heroSection = document.getElementById('hero-section');
+    const videoWrapper = document.getElementById('video-wrapper');
+    const videoIframe = document.getElementById('roasting-video');
+    const theaterStatus = document.getElementById('theater-status');
+
+    let isTheaterMode = false;
+
+    function reparentPreservingState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetContainer = isTheaterMode ? heroSection : videoWrapper;
+
+      reparentPreservingState(targetContainer, videoIframe);
+
+      theaterBtn.setAttribute('aria-pressed', String(isTheaterMode));
+      theaterBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Theater Mode';
+      theaterStatus.textContent = isTheaterMode
+        ? 'Video moved to hero section in theater mode.'
+        : 'Video moved back to main content section.';
+    });
+  </script>
