+  <script>
+    (function () {
+      const statusBadge = document.getElementById('scheduler-status-badge');
+      const statQueued = document.getElementById('stat-queued');
+      const statCompleted = document.getElementById('stat-completed');
+      const statYields = document.getElementById('stat-yields');
+      const statActive = document.getElementById('stat-active');
+      const logSummary = document.getElementById('ops-log-summary');
+      const logList = document.getElementById('ops-log-list');
+
+      let queuedCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+      let taskCounter = 0;
+
+      // Feature detect the scheduler API and load polyfill for unsupported browsers
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        statusBadge.textContent = 'Loading Scheduler Polyfill...';
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => {
+          statusBadge.textContent = 'Scheduler Polyfill Active';
+          initSimulator();
+        };
+        script.onerror = () => {
+          statusBadge.textContent = 'Fallback Scheduler Active';
+          initSimulator();
+        };
+        document.head.appendChild(script);
+      } else {
+        statusBadge.textContent = 'Native Scheduler API Active';
+        initSimulator();
+      }
+
+      function updateStats(activeLabel) {
+        statQueued.textContent = String(queuedCount);
+        statCompleted.textContent = String(completedCount);
+        statYields.textContent = String(yieldCount);
+        if (activeLabel !== undefined) {
+          statActive.textContent = activeLabel;
+        }
+      }
+
+      async function yieldToMainThread() {
+        yieldCount++;
+        statYields.textContent = String(yieldCount);
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          await scheduler.yield();
+        } else {
+          await new Promise(resolve => setTimeout(resolve, 0));
+        }
+      }
+
+      // Break up heavy synchronous work using a 50ms deadline and scheduler.yield()
+      async function performLongTaskWork(iterations) {
+        let deadline = performance.now() + 50;
+        let accumulator = 0;
+
+        for (let i = 0; i < iterations; i++) {
+          accumulator += Math.sqrt((i % 1000) + 1);
+
+          if (performance.now() >= deadline) {
+            await yieldToMainThread();
+            deadline = performance.now() + 50;
+          }
+        }
+        return accumulator;
+      }
+
+      function appendLogRow(taskId, label, priority, statusText) {
+        const emptyState = document.getElementById('ops-empty-state');
+        if (emptyState) {
+          emptyState.remove();
+        }
+
+        const li = document.createElement('li');
+        li.className = 'ops-log-item';
+        li.dataset.taskId = String(taskId);
+        li.dataset.priority = priority;
+
+        const left = document.createElement('div');
+        const badge = document.createElement('span');
+        badge.className = `ops-log-badge badge-${priority}`;
+        badge.textContent = priority;
+
+        const title = document.createElement('strong');
+        title.style.marginLeft = '10px';
+        title.textContent = `#${taskId} ${label}`;
+
+        left.appendChild(badge);
+        left.appendChild(title);
+
+        const meta = document.createElement('span');
+        meta.className = 'ops-log-meta';
+        meta.textContent = statusText;
+
+        li.appendChild(left);
+        li.appendChild(meta);
+        logList.appendChild(li);
+        logList.scrollTop = logList.scrollHeight;
+        return meta;
+      }
+
+      function scheduleOperation(label, priority, iterations = 1200000) {
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateStats();
+        logSummary.textContent = `${queuedCount} queued · ${completedCount} completed`;
+
+        const runTask = async () => {
+          const startTime = performance.now();
+          updateStats(label);
+          const metaNode = appendLogRow(taskId, label, priority, 'Running...');
+
+          await performLongTaskWork(iterations);
+
+          const elapsed = (performance.now() - startTime).toFixed(1);
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          metaNode.textContent = `Completed in ${elapsed} ms`;
+          updateStats(queuedCount === 0 ? 'Idle' : undefined);
+          logSummary.textContent = `${queuedCount} queued · ${completedCount} completed`;
+        };
+
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          return scheduler.postTask(runTask, { priority });
+        }
+
+        return new Promise(resolve => {
+          setTimeout(() => resolve(runTask()), 0);
+        });
+      }
+
+      function initSimulator() {
+        document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+          // Schedule a high-priority task that blocks user interaction
+          scheduleOperation('Urgent Checkout Task', 'user-blocking', 1000000);
+        });
+
+        document.getElementById('btn-menu-update').addEventListener('click', () => {
+          // Schedule a default user-visible priority task
+          scheduleOperation('Standard Menu Update', 'user-visible', 1200000);
+        });
+
+        document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+          // Schedule a low-priority background task
+          scheduleOperation('Background Telemetry Logging', 'background', 1500000);
+        });
+
+        document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+          // Enqueue mixed tasks in reverse/mixed order so scheduler.postTask executes them in priority order:
+          // user-blocking (Urgent Checkout) -> user-visible (Standard Menu Update) -> background (Telemetry Logging)
+          scheduleOperation('Background Telemetry Logging (Batch)', 'background', 900000);
+          scheduleOperation('Standard Menu Update (Batch)', 'user-visible', 900000);
+          scheduleOperation('Urgent Checkout Task (Batch)', 'user-blocking', 900000);
+          scheduleOperation('Background Telemetry Sync (Batch)', 'background', 900000);
+          scheduleOperation('Seasonal Menu Price Refresh (Batch)', 'user-visible', 900000);
+          scheduleOperation('Express Payment Verification (Batch)', 'user-blocking', 900000);
+        });
+
+        document.getElementById('btn-clear-log').addEventListener('click', () => {
+          logList.innerHTML = '<li class="ops-log-item" id="ops-empty-state"><span>No operations executed yet. Use the controls above to schedule tasks.</span></li>';
+          completedCount = 0;
+          yieldCount = 0;
+          updateStats(queuedCount === 0 ? 'Idle' : undefined);
+          logSummary.textContent = 'Log cleared';
+        });
+      }
+    })();
+  </script>
 </body>
 
