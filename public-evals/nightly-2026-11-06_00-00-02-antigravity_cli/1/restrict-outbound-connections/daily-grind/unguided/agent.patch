@@ -0,0 +1,111 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+const querystring = require('querystring');
+
+const PORT = process.env.PORT || 11222;
+
+const CSP_HEADER = [
+  "default-src 'self'",
+  "connect-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "script-src 'self' 'unsafe-inline'",
+  "style-src 'self' 'unsafe-inline'",
+  "form-action 'self'",
+  "base-uri 'self'",
+  "object-src 'none'"
+].join('; ');
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+const subscribers = new Set();
+
+function parseEmail(rawBody, contentType) {
+  if (!rawBody) return '';
+  if (contentType.includes('application/json')) {
+    try {
+      const parsed = JSON.parse(rawBody);
+      return (parsed.email || '').trim();
+    } catch {
+      return '';
+    }
+  }
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const parsed = querystring.parse(rawBody);
+    return (parsed.email || '').trim();
+  }
+  try {
+    const parsed = JSON.parse(rawBody);
+    if (parsed && parsed.email) return String(parsed.email).trim();
+  } catch {
+    // Fallback to query string
+  }
+  const parsed = querystring.parse(rawBody);
+  return (parsed.email || '').trim();
+}
+
+const server = http.createServer((req, res) => {
+  res.setHeader('Content-Security-Policy', CSP_HEADER);
+
+  const reqUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+  const pathname = reqUrl.pathname;
+
+  if (req.method === 'POST' && (
+    pathname === '/newsletter' ||
+    pathname === '/api/newsletter' ||
+    pathname === '/subscribe' ||
+    pathname === '/api/subscribe'
+  )) {
+    let body = '';
+    req.on('data', (chunk) => {
+      body += chunk.toString();
+    });
+    req.on('end', () => {
+      const contentType = req.headers['content-type'] || '';
+      const email = parseEmail(body, contentType);
+      if (!email || !email.includes('@')) {
+        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ ok: false, error: 'Please provide a valid email address.' }));
+        return;
+      }
+      subscribers.add(email);
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ ok: true, message: 'Thank you for subscribing to The Daily Grind newsletter!', email }));
+    });
+    return;
+  }
+
+  let filePath = pathname === '/' ? '/index.html' : pathname;
+  const resolvedPath = path.resolve(__dirname, '.' + filePath);
+
+  if (!resolvedPath.startsWith(__dirname)) {
+    res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Forbidden');
+    return;
+  }
+
+  fs.readFile(resolvedPath, (err, content) => {
+    if (err) {
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Not Found');
+      return;
+    }
+    const ext = path.extname(resolvedPath).toLowerCase();
+    const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+    res.writeHead(200, { 'Content-Type': contentType });
+    res.end(content);
+  });
+});
+
+server.listen(PORT, () => {
+  console.log(`Server listening on http://localhost:${PORT}`);
+});
