+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const messageEl = document.getElementById('newsletter-message');
+
+      function showMessage(text, isError) {
+        messageEl.textContent = text;
+        messageEl.className = 'newsletter-message ' + (isError ? 'error' : 'success');
+      }
+
+      document.addEventListener('securitypolicyviolation', function (e) {
+        showMessage(
+          'Sorry, the request could not go through because connections to external servers (' + (e.blockedURI || 'blocked destination') + ') are restricted.',
+          true
+        );
+      });
+
+      form.addEventListener('submit', async function (e) {
+        e.preventDefault();
+        const email = emailInput.value.trim();
+        if (!email) {
+          showMessage('Please enter a valid email address.', true);
+          return;
+        }
+
+        const endpoint = form.getAttribute('action') || '/newsletter';
+
+        try {
+          const response = await fetch(endpoint, {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json'
+            },
+            body: JSON.stringify({ email: email })
+          });
+
+          const data = await response.json().catch(function () { return {}; });
+          if (!response.ok) {
+            showMessage(data.error || 'Sorry, your request could not go through. Please try again later.', true);
+            return;
+          }
+
+          showMessage(data.message || 'Thank you for subscribing to our newsletter!', false);
+          form.reset();
+        } catch (err) {
+          showMessage('Sorry, your request could not go through. Please check your connection and try again.', true);
+        }
+      });
+    })();
+  </script>
+
