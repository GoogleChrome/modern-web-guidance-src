+    // Client-side helper that catches blocked outbound requests gracefully without unhandled rejections.
+    async function fetchWithPolicyHandling(url, { statusElement = statusEl, ...fetchOptions } = {}) {
+      try {
+        const response = await fetch(url, fetchOptions);
+        let payload = null;
+        const contentType = response.headers.get('content-type') || '';
+        if (contentType.includes('application/json')) {
+          payload = await response.json();
+        } else {
+          payload = await response.text();
+        }
+
+        if (!response.ok) {
+          const serverMessage =
+            payload && typeof payload === 'object' && payload.message
+              ? payload.message
+              : `HTTP ${response.status}`;
+          throw new Error(serverMessage);
+        }
+
+        const successMessage =
+          payload && typeof payload === 'object' && payload.message
+            ? payload.message
+            : `Success: Request to ${url} completed.`;
+        if (statusElement) {
+          statusElement.dataset.state = 'success';
+          statusElement.textContent = `✓ ${successMessage}`;
