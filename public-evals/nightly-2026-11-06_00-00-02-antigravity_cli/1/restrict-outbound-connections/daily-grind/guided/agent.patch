+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+export const ALLOWLIST_DESTS = new Set([
+  'document',
+  'iframe',
+  'worker',
+  'sharedworker',
+  'serviceworker',
+]);
+
+export const UNSPLASH_ORIGIN = 'https://images.unsplash.com';
+
+const subscribers = new Set();
+const securityReports = [];
+
+/**
+ * Normalize a config URL or URLPattern string for Connection-Allowlist:
+ * - Rewrites ws:// and wss:// to http:// and https:// (WebSocket matching rule).
+ * - Strips a bare trailing slash on origin-only URLs (e.g. from new URL(...).href)
+ *   so all subpaths on the origin are permitted instead of only "/".
+ */
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(`Pattern must include an http:// or https:// scheme: ${rawPattern}`);
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(`Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`);
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(`Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`);
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+/**
+ * Build an RFC 9651 Inner List value for Connection-Allowlist or Connection-Allowlist-Report-Only.
+ */
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = [UNSPLASH_ORIGIN],
+  reportTo = 'conn-reports',
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+/**
+ * Compute SHA-256 CSP hashes for inline <script> blocks in HTML content.
+ */
+export function computeInlineScriptHashes(html) {
+  const hashes = [];
+  const scriptRegex = /<script\b[^>]*>([\s\S]*?)<\/script>/gi;
+  let match;
+  while ((match = scriptRegex.exec(html)) !== null) {
+    const content = match[1];
+    if (content && content.trim().length > 0) {
+      const digest = crypto.createHash('sha256').update(content, 'utf8').digest('base64');
+      hashes.push(`'sha256-${digest}'`);
+    }
+  }
+  return hashes;
+}
+
+/**
+ * Build the companion Content-Security-Policy header for browsers without Connection-Allowlist support.
+ */
+export function buildCspHeader({
+  scriptHashes = [],
+  reportTo = 'conn-reports',
+  includeReportTo = true,
+  includeFrameAncestors = true,
+} = {}) {
+  const scriptSources = ["'self'", ...scriptHashes, "'report-sample'"].join(' ');
+  const directives = [
+    "default-src 'self'",
+    "connect-src 'self'",
+    `img-src 'self' ${UNSPLASH_ORIGIN} data: blob:`,
+    "style-src 'self' 'unsafe-inline'",
+    `script-src ${scriptSources}`,
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'self'",
+  ];
+  if (includeFrameAncestors) {
+    directives.push("frame-ancestors 'none'");
+  }
+  if (includeReportTo && reportTo) {
+    directives.push(`report-to ${reportTo}`);
+  }
+  return directives.join('; ');
+}
+
+/**
+ * Apply Connection-Allowlist, Reporting-Endpoints, and Content-Security-Policy fallback headers.
+ */
+export function setConnectionAllowlistHeaders(res, options = {}) {
+  const {
+    secFetchDest = 'document',
+    patterns = [UNSPLASH_ORIGIN],
+    reportOnlyPatterns,
+    reportEndpointName = 'conn-reports',
+    reportEndpointUrl = '/api/security-reports',
+    redirects = 'block',
+    webrtc = 'block',
+    reportOnly = false,
+    scriptHashes = [],
+  } = options;
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+
+  if (typeof res.appendHeader === 'function') {
+    res.appendHeader('Vary', 'Sec-Fetch-Dest');
+  } else if (typeof res.headers?.append === 'function') {
+    res.headers.append('Vary', 'Sec-Fetch-Dest');
+  } else {
+    setHeader('Vary', 'Sec-Fetch-Dest');
+  }
+
+  setHeader('X-Content-Type-Options', 'nosniff');
+  setHeader('X-Frame-Options', 'DENY');
+  setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+  );
+  setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+
+  if (secFetchDest && !ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) return;
+
+  setHeader('Reporting-Endpoints', `${reportEndpointName}="${reportEndpointUrl}"`);
+  setHeader(
+    reportOnly ? 'Connection-Allowlist-Report-Only' : 'Connection-Allowlist',
+    buildConnectionAllowlistHeader({
+      allowSelf: true,
+      patterns,
+      reportTo: reportEndpointName,
+      redirects,
+      webrtc,
+    }),
+  );
+
+  if (!reportOnly && Array.isArray(reportOnlyPatterns)) {
+    setHeader(
+      'Connection-Allowlist-Report-Only',
+      buildConnectionAllowlistHeader({
+        allowSelf: true,
+        patterns: reportOnlyPatterns,
+        reportTo: reportEndpointName,
+        redirects,
+        webrtc,
+      }),
+    );
+  }
+
+  setHeader(
+    'Content-Security-Policy',
+    buildCspHeader({
+      scriptHashes,
+      reportTo: reportEndpointName,
+      includeReportTo: true,
+      includeFrameAncestors: true,
+    }),
+  );
+}
+
+function readRequestBody(req, maxBytes = 16384) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let total = 0;
+    req.on('data', (chunk) => {
+      total += chunk.length;
+      if (total > maxBytes) {
+        reject(new Error('Payload too large'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function parseEmailFromBody(rawBody, contentType = '') {
+  const trimmed = rawBody.trim();
+  if (!trimmed) return '';
+  if (contentType.includes('application/json') || trimmed.startsWith('{')) {
+    try {
+      const parsed = JSON.parse(trimmed);
+      return typeof parsed?.email === 'string' ? parsed.email.trim() : '';
+    } catch {
+      return '';
+    }
+  }
+  const params = new URLSearchParams(trimmed);
+  return (params.get('email') || '').trim();
+}
+
+function isValidEmail(email) {
+  return typeof email === 'string' && email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+}
+
+export function createServer() {
+  const indexPath = path.join(__dirname, 'index.html');
+
+  return http.createServer(async (req, res) => {
+    const host = req.headers.host || `localhost:${process.env.PORT || 11222}`;
+    const proto = req.headers['x-forwarded-proto'] || 'http';
+    const baseUrl = `${proto}://${host}`;
+    const url = new URL(req.url || '/', baseUrl);
+    const reportEndpointUrl = `${baseUrl}/api/security-reports`;
+    const secFetchDest = req.headers['sec-fetch-dest'] || 'document';
+
+    // Handle newsletter signup POST requests
+    if (
+      req.method === 'POST' &&
+      (url.pathname === '/api/newsletter' ||
+        url.pathname === '/newsletter' ||
+        url.pathname === '/subscribe')
+    ) {
+      setConnectionAllowlistHeaders(res, {
+        secFetchDest: 'empty',
+        reportEndpointUrl,
+      });
+      res.setHeader('Content-Type', 'application/json; charset=utf-8');
+
+      const fetchSite = req.headers['sec-fetch-site'];
+      if (fetchSite && !['same-origin', 'none'].includes(String(fetchSite).toLowerCase())) {
+        res.writeHead(403);
+        res.end(
+          JSON.stringify({
+            ok: false,
+            message: 'Cross-origin newsletter submissions are not permitted.',
+          }),
+        );
+        return;
+      }
+
+      try {
+        const rawBody = await readRequestBody(req);
+        const email = parseEmailFromBody(rawBody, req.headers['content-type'] || '');
+
+        if (!isValidEmail(email)) {
+          res.writeHead(400);
+          res.end(
+            JSON.stringify({
+              ok: false,
+              message: 'Please enter a valid email address (for example, alex@example.com).',
+            }),
+          );
+          return;
+        }
+
+        subscribers.add(email.toLowerCase());
+        res.writeHead(200);
+        res.end(
+          JSON.stringify({
+            ok: true,
+            email: email.toLowerCase(),
+            message: `Thanks for subscribing! We'll send fresh roast notes to ${email}.`,
+          }),
+        );
+      } catch {
+        res.writeHead(400);
+        res.end(
+          JSON.stringify({
+            ok: false,
+            message: 'Unable to process your signup request. Please try again.',
+          }),
+        );
+      }
+      return;
+    }
+
+    // Handle Connection-Allowlist and CSP violation reports
+    if (req.method === 'POST' && url.pathname === '/api/security-reports') {
+      try {
+        const rawBody = await readRequestBody(req);
+        if (rawBody) {
+          securityReports.push(rawBody);
+        }
+      } catch {
+        // Ignore malformed report payloads
+      }
+      res.writeHead(204);
+      res.end();
+      return;
+    }
+
+    // Serve homepage
+    if (
+      (req.method === 'GET' || req.method === 'HEAD') &&
+      (url.pathname === '/' || url.pathname === '/index.html')
+    ) {
+      try {
+        const html = fs.readFileSync(indexPath, 'utf8');
+        const scriptHashes = computeInlineScriptHashes(html);
+        setConnectionAllowlistHeaders(res, {
+          secFetchDest,
+          patterns: [UNSPLASH_ORIGIN],
+          reportEndpointUrl,
+          scriptHashes,
+        });
+        res.setHeader('Content-Type', 'text/html; charset=utf-8');
+        res.writeHead(200);
+        res.end(req.method === 'HEAD' ? undefined : html);
+      } catch {
+        res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+        res.end('Internal Server Error');
+      }
+      return;
+    }
+
+    res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ ok: false, message: 'Not Found' }));
+  });
+}
+
+const isMain =
+  process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
+
