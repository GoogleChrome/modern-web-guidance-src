   </main>
 
+  <script type="module">
+    const seasonalPreview = document.getElementById("seasonal-preview");
+    const previewStatus = seasonalPreview.querySelector(".preview-status");
+    const previewNotes = seasonalPreview.querySelector(".preview-notes");
+    const defaultMessage = "Select a drink to preview";
+
+    seasonalPreview.addEventListener("interest", (event) => {
+      const source = event.source;
+      if (!source) return;
+      const drink = source.dataset.drink || source.dataset.effect || "";
+      const accent = source.dataset.accent || "";
+      const notes = source.dataset.notes || "";
+
+      event.target.dataset.preview = drink;
+      if (accent) {
+        event.target.style.setProperty("--preview-accent", accent);
+      }
+      previewStatus.textContent = drink ? `Previewing: ${drink}` : defaultMessage;
+      if (notes) {
+        previewNotes.textContent = notes;
+        previewNotes.hidden = false;
+      }
+    });
+
+    seasonalPreview.addEventListener("loseinterest", (event) => {
+      delete event.target.dataset.preview;
+      event.target.style.removeProperty("--preview-accent");
+      previewStatus.textContent = defaultMessage;
+      previewNotes.textContent = "";
+      previewNotes.hidden = true;
+    });
+
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
