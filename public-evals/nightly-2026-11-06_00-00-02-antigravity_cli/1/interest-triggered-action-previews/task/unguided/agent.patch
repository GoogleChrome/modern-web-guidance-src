+  <script>
+    const previewBox = document.getElementById('seasonal-preview');
+    const defaultPreviewText = 'Select a drink to preview';
+
+    if (previewBox) {
+      previewBox.addEventListener('interest', (event) => {
+        const invoker = event.source;
+        const card = invoker?.closest('.card');
+        const drink = invoker?.dataset.drink || card?.querySelector('h3')?.textContent?.trim() || '';
+        const description = invoker?.dataset.description || card?.querySelector('p')?.textContent?.trim() || '';
+        const accent = invoker?.dataset.accent || '#ffab40';
+
+        previewBox.textContent = description ? `${drink} — ${description}` : drink;
+        previewBox.style.setProperty('--preview-accent', accent);
+        previewBox.style.borderColor = accent;
+        previewBox.style.borderLeftColor = accent;
+        previewBox.dataset.activeDrink = drink;
+      });
+
+      previewBox.addEventListener('loseinterest', () => {
+        previewBox.textContent = defaultPreviewText;
+        previewBox.style.removeProperty('--preview-accent');
+        previewBox.style.borderColor = '';
+        previewBox.style.borderLeftColor = '';
+        delete previewBox.dataset.activeDrink;
+      });
+    }
+  </script>
+
