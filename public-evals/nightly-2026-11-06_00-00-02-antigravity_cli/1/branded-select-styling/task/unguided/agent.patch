+  <script>
+    (function () {
+      const roastDetails = {
+        light: {
+          label: 'Light Roast',
+          note: 'Bright, floral acidity with delicate citrus & berry notes'
+        },
+        medium: {
+          label: 'Medium Roast',
+          note: 'Balanced body with rich caramel & toasted nut notes'
+        },
+        dark: {
+          label: 'Dark Roast',
+          note: 'Bold, full-bodied flavor with smoky dark chocolate notes'
+        }
+      };
+
+      const wrapper = document.getElementById('roast-select-wrapper');
+      const nativeSelect = document.getElementById('roast-select');
+      const trigger = document.getElementById('roast-trigger');
+      const selectedText = document.getElementById('roast-selected-text');
+      const list = document.getElementById('roast-dropdown-list');
+      const options = Array.from(list.querySelectorAll('.roast-dropdown-option'));
+      const roastNote = document.getElementById('roast-note');
+      const orderBtn = document.getElementById('hero-order-btn');
+
+      function setOpen(isOpen) {
+        wrapper.classList.toggle('open', isOpen);
+        trigger.setAttribute('aria-expanded', String(isOpen));
+        if (isOpen) {
+          const activeOption = options.find(opt => opt.getAttribute('aria-selected') === 'true') || options[0];
+          if (activeOption) activeOption.focus();
+        }
+      }
+
+      function selectRoast(value, focusTrigger = true) {
+        if (!roastDetails[value]) return;
+        nativeSelect.value = value;
+        selectedText.textContent = roastDetails[value].label;
+        roastNote.textContent = roastDetails[value].note;
+        if (orderBtn) {
+          orderBtn.href = '/order-online?roast=' + encodeURIComponent(value);
+        }
+
+        options.forEach(opt => {
+          const isSelected = opt.getAttribute('data-value') === value;
+          opt.setAttribute('aria-selected', String(isSelected));
+          opt.setAttribute('tabindex', isSelected ? '0' : '-1');
+        });
+
+        setOpen(false);
+        if (focusTrigger) {
+          trigger.focus();
+        }
+      }
+
+      trigger.addEventListener('click', (e) => {
+        e.stopPropagation();
+        const isOpen = wrapper.classList.contains('open');
+        setOpen(!isOpen);
+      });
+
+      trigger.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          setOpen(true);
+        }
+      });
+
+      options.forEach((option, index) => {
+        option.addEventListener('click', (e) => {
+          e.stopPropagation();
+          selectRoast(option.getAttribute('data-value'));
+        });
+
+        option.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            selectRoast(option.getAttribute('data-value'));
+          } else if (e.key === 'Escape') {
+            e.preventDefault();
+            setOpen(false);
+            trigger.focus();
+          } else if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            const next = options[(index + 1) % options.length];
+            next.focus();
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            const prev = options[(index - 1 + options.length) % options.length];
+            prev.focus();
+          }
+        });
+      });
+
+      nativeSelect.addEventListener('change', (e) => {
+        selectRoast(e.target.value, false);
+      });
+
+      document.addEventListener('click', (e) => {
+        if (!wrapper.contains(e.target)) {
+          setOpen(false);
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && wrapper.classList.contains('open')) {
+          setOpen(false);
+          trigger.focus();
+        }
+      });
+    })();
+  </script>
 </body>
 
