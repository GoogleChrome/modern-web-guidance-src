+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.grid .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let currentIndex = 0;
+
+      function showCard(newIndex, direction) {
+        currentIndex = (newIndex + cards.length) % cards.length;
+        const prefersReducedMotion = reducedMotionQuery.matches;
+
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-in-right', 'slide-in-left');
+          if (index === currentIndex) {
+            card.hidden = false;
+            card.setAttribute('aria-hidden', 'false');
+            card.classList.add('active');
+            if (!prefersReducedMotion && direction) {
+              void card.offsetWidth;
+              card.classList.add(direction === 'next' ? 'slide-in-right' : 'slide-in-left');
+            }
+          } else {
+            card.hidden = true;
+            card.setAttribute('aria-hidden', 'true');
+          }
+        });
+      }
+
+      nextBtn.addEventListener('click', function () {
+        showCard(currentIndex + 1, 'next');
+      });
+
+      prevBtn.addEventListener('click', function () {
+        showCard(currentIndex - 1, 'prev');
+      });
+    })();
+  </script>
+
