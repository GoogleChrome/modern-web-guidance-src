+import React, { useState, useEffect } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+interface StoryItem {
+  id: string;
+  data: {
+    title: string;
+    date: Date | string;
+  };
+}
+
+interface TopStoriesSliderProps {
+  stories: StoryItem[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [slideStep, setSlideStep] = useState(0);
+  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
+
+  useEffect(() => {
+    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+    setPrefersReducedMotion(mediaQuery.matches);
+
+    const handleChange = (e: MediaQueryListEvent) => {
+      setPrefersReducedMotion(e.matches);
+    };
+
+    mediaQuery.addEventListener('change', handleChange);
+    return () => mediaQuery.removeEventListener('change', handleChange);
+  }, []);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handleNext = () => {
+    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    setPrefersReducedMotion(reduced);
+    setDirection('next');
+    setSlideStep((s) => s + 1);
+    setCurrentIndex((prev) => (prev + 1) % stories.length);
+  };
+
+  const handlePrev = () => {
+    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    setPrefersReducedMotion(reduced);
+    setDirection('prev');
+    setSlideStep((s) => s + 1);
+    setCurrentIndex((prev) => (prev - 1 + stories.length) % stories.length);
+  };
+
+  const currentStory = stories[currentIndex];
+  const dateObj =
+    currentStory.data.date instanceof Date
+      ? currentStory.data.date
+      : new Date(currentStory.data.date);
+  const formattedDate = dateObj.toLocaleDateString();
+
+  const slideClass =
+    direction === 'next'
+      ? 'top-story-slide top-story-slide-next'
+      : direction === 'prev'
+      ? 'top-story-slide top-story-slide-prev'
+      : 'top-story-slide';
+
+  return (
+    <div
+      className="flex items-center justify-between gap-4"
+      role="region"
+      aria-label="Top Stories"
+    >
+      <button
+        type="button"
+        onClick={handlePrev}
+        aria-label="Previous"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+        <span>Previous</span>
+      </button>
+
+      <div className="overflow-hidden flex-1 text-center">
+        <div
+          key={`${currentStory.id}-${slideStep}`}
+          data-direction={direction ?? undefined}
+          className={slideClass}
+          style={
+            prefersReducedMotion
+              ? { animation: 'none', transition: 'none', transform: 'none' }
+              : undefined
+          }
+        >
+          <a href={`${import.meta.env.BASE_URL}articles/${currentStory.id}`}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+              {currentStory.data.title}
+            </h3>
+          </a>
+          <span className="text-xs text-gray-500">{formattedDate}</span>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={handleNext}
+        aria-label="Next"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <span>Next</span>
+        <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+      </button>
+    </div>
+  );
+}
