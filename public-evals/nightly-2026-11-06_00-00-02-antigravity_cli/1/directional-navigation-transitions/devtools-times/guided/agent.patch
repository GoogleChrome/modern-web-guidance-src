     </div>
 
+    <script>
+        function initTopStoriesSlider() {
+            const slider = document.querySelector('[data-top-stories-slider]');
+            if (!slider || slider.hasAttribute('data-initialized')) return;
+            slider.setAttribute('data-initialized', 'true');
+
+            const viewport = slider.querySelector('[data-slider-viewport]') as HTMLElement | null;
+            const slides = Array.from(slider.querySelectorAll('[data-story-slide]')) as HTMLElement[];
+            const prevBtn = slider.querySelector('[data-slider-prev]') as HTMLButtonElement | null;
+            const nextBtn = slider.querySelector('[data-slider-next]') as HTMLButtonElement | null;
+
+            if (!viewport || slides.length === 0 || !prevBtn || !nextBtn) return;
+
+            let currentIndex = 0;
+
+            const showSlide = (nextIndex: number, direction: 'forward' | 'backward') => {
+                const updateDOM = () => {
+                    slides.forEach((slide, i) => {
+                        slide.hidden = i !== nextIndex;
+                    });
+                    currentIndex = nextIndex;
+                };
+
+                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+                if (prefersReducedMotion) {
+                    updateDOM();
+                    return;
+                }
+
+                const anyViewport = viewport as any;
+                if (typeof anyViewport.startViewTransition === 'function') {
+                    const transition = anyViewport.startViewTransition({
+                        update: updateDOM,
+                        types: [direction],
+                    });
+                    transition.ready?.catch(() => {});
+                } else if (typeof document.startViewTransition === 'function') {
+                    const transition = document.startViewTransition({
+                        update: updateDOM,
+                        types: [direction],
+                    });
+                    transition.ready?.catch(() => {});
+                } else {
+                    updateDOM();
+                }
+            };
+
+            prevBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex - 1 + slides.length) % slides.length;
+                showSlide(nextIndex, 'backward');
+            });
+
+            nextBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % slides.length;
+                showSlide(nextIndex, 'forward');
+            });
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
+
     <!-- Main Content Area -->
