+}
+
+@keyframes slide-to-left {
+  to {
+    transform: translateX(-100%);
+  }
+}
+
+@keyframes slide-from-right {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-to-right {
+  to {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-from-left {
+  from {
+    transform: translateX(-100%);
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  ::view-transition-group(top-story-slide) {
+    animation: 0.35s ease-in-out both;
+    overflow: clip;
+  }
+
+  ::view-transition-group-children(top-story-slide),
+  ::view-transition-image-pair(top-story-slide) {
+    overflow: clip;
+  }
+
+  html:active-view-transition-type(forward)::view-transition-old(top-story-slide),
+  :active-view-transition-type(forward)::view-transition-old(top-story-slide) {
+    animation: 0.35s ease-in-out both slide-to-left;
+  }
+
+  html:active-view-transition-type(forward)::view-transition-new(top-story-slide),
+  :active-view-transition-type(forward)::view-transition-new(top-story-slide) {
+    animation: 0.35s ease-in-out both slide-from-right;
+  }
+
+  html:active-view-transition-type(backward)::view-transition-old(top-story-slide),
+  :active-view-transition-type(backward)::view-transition-old(top-story-slide) {
+    animation: 0.35s ease-in-out both slide-to-right;
+  }
+
+  html:active-view-transition-type(backward)::view-transition-new(top-story-slide),
+  :active-view-transition-type(backward)::view-transition-new(top-story-slide) {
+    animation: 0.35s ease-in-out both slide-from-left;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
