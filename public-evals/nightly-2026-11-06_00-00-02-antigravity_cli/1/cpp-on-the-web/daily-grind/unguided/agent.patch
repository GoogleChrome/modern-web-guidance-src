+  <script src="smallpt.js"></script>
+  <script>
+    (function () {
+      const canvas = document.getElementById('render-canvas');
+      const ctx = canvas.getContext('2d');
+      const statusText = document.getElementById('status-text');
+      const metricsText = document.getElementById('metrics-text');
+      const progressFill = document.getElementById('progress-fill');
+      const randomizeBtn = document.getElementById('randomize-btn');
+      const rerenderBtn = document.getElementById('rerender-btn');
+      const resolutionSelect = document.getElementById('resolution-select');
+      const samplesSelect = document.getElementById('samples-select');
+      const swatchesContainer = document.getElementById('swatches-container');
+
+      const SPHERE_LABELS = [
+        { index: 0, name: 'Left Wall' },
+        { index: 1, name: 'Right Wall' },
+        { index: 2, name: 'Back Wall' },
+        { index: 4, name: 'Floor' },
+        { index: 6, name: 'Mirror Sphere' },
+        { index: 7, name: 'Glass Sphere' }
+      ];
+
+      let wasmReady = false;
+      let renderJobId = 0;
+
+      function toDisplayHex(val) {
+        // Apply gamma 2.2 encoding like smallpt's toInt() so swatch matches rendered appearance
+        const clamped = Math.max(0, Math.min(1, val));
+        const byte = Math.min(255, Math.floor(Math.pow(clamped, 1 / 2.2) * 255 + 0.5));
+        return byte.toString(16).padStart(2, '0');
+      }
+
+      function updateColorSwatches() {
+        if (!wasmReady) return;
+        swatchesContainer.innerHTML = '';
+        for (const item of SPHERE_LABELS) {
+          const r = Module._get_sphere_color_r(item.index);
+          const g = Module._get_sphere_color_g(item.index);
+          const b = Module._get_sphere_color_b(item.index);
+          const hex = '#' + toDisplayHex(r) + toDisplayHex(g) + toDisplayHex(b);
+
+          const el = document.createElement('div');
+          el.className = 'swatch-item';
+          el.innerHTML = `
+            <span class="swatch-color" style="background-color: ${hex};"></span>
+            <div class="swatch-meta">
+              <span class="swatch-name">${item.name}</span>
+              <span class="swatch-hex">${hex.toUpperCase()}</span>
+            </div>
+          `;
+          swatchesContainer.appendChild(el);
+        }
+      }
+
+      function parseResolution() {
+        const [w, h] = resolutionSelect.value.split('x').map(Number);
+        return { width: w || 320, height: h || 240 };
+      }
+
+      function flushBufferToCanvas(width, height) {
+        const ptr = Module._get_rgba_ptr();
+        const byteLength = width * height * 4;
+        const pixels = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(pixels, width, height);
+        ctx.putImageData(imageData, 0, 0);
+      }
+
+      function startRender(options = {}) {
+        if (!wasmReady) return;
+
+        renderJobId++;
+        const currentJob = renderJobId;
+
+        if (options.randomize) {
+          const seed = Math.floor(Math.random() * 0xFFFFFFFE) + 1;
+          Module._randomize_sphere_colors(seed);
+        } else if (options.resetDefault) {
+          Module._reset_default_colors();
+        }
+
+        updateColorSwatches();
+
+        const { width, height } = parseResolution();
+        const targetSpp = parseInt(samplesSelect.value, 10) || 16;
+        const totalPasses = Math.max(1, Math.ceil(targetSpp / 4));
+
+        canvas.width = width;
+        canvas.height = height;
+
+        Module._init_scene(width, height);
+        const startTime = performance.now();
+
+        let currentPass = 0;
+        let currentY = 0;
+        const rowsPerSlice = Math.max(8, Math.floor(height / 8));
+
+        statusText.textContent = `Rendering pass 1 of ${totalPasses}...`;
+        progressFill.style.width = '2%';
+
+        function stepSlice() {
+          if (currentJob !== renderJobId) return;
+
+          const yEnd = Math.min(height, currentY + rowsPerSlice);
+          Module._render_scanlines(currentY, yEnd, 1);
+          flushBufferToCanvas(width, height);
+
+          currentY = yEnd;
+          const completedUnits = currentPass * height + currentY;
+          const totalUnits = totalPasses * height;
+          const pct = Math.min(100, (completedUnits / totalUnits) * 100);
+          const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
+          const currentSpp = (currentPass + (currentY >= height ? 1 : 0)) * 4;
+
+          progressFill.style.width = `${pct.toFixed(1)}%`;
+          metricsText.textContent = `${currentSpp} / ${totalPasses * 4} spp | ${elapsed}s`;
+
+          if (currentY >= height) {
+            currentPass++;
+            currentY = 0;
+          }
+
+          if (currentPass < totalPasses) {
+            statusText.textContent = `Rendering pass ${currentPass + 1} of ${totalPasses} (${Math.round(pct)}%)...`;
+            requestAnimationFrame(stepSlice);
+          } else {
+            statusText.textContent = `Render complete (${totalPasses * 4} spp)`;
+            progressFill.style.width = '100%';
+          }
+        }
+
+        requestAnimationFrame(stepSlice);
+      }
+
+      randomizeBtn.addEventListener('click', () => {
+        startRender({ randomize: true });
+      });
+
+      rerenderBtn.addEventListener('click', () => {
+        startRender({ resetDefault: true });
+      });
+
+      resolutionSelect.addEventListener('change', () => {
+        startRender();
+      });
+
+      samplesSelect.addEventListener('change', () => {
+        startRender();
+      });
+
+      function onWasmReady() {
+        if (wasmReady) return;
+        wasmReady = true;
+        randomizeBtn.disabled = false;
+        rerenderBtn.disabled = false;
+        startRender();
+      }
+
+      if (typeof Module !== 'undefined' && Module.calledRun) {
+        onWasmReady();
+      } else if (typeof Module !== 'undefined') {
+        const prevInit = Module.onRuntimeInitialized;
+        Module.onRuntimeInitialized = function () {
+          if (typeof prevInit === 'function') prevInit();
+          onWasmReady();
+        };
+      }
+    })();
+  </script>
