+}
+
+// Persistent buffers for progressive/interactive WebAssembly rendering
+static int g_w = 0;
+static int g_h = 0;
+static int g_total_samples = 0;
+static Vec *g_accum = NULL;
+static uint8_t *g_rgba = NULL;
+static unsigned int g_rng_seed = 1337;
+
+static double rand_unit() {
+  g_rng_seed = g_rng_seed * 1664525u + 1013904223u;
+  return (g_rng_seed & 0xFFFFFF) / double(0x1000000);
+}
+
+static Vec hsv_to_rgb(double h, double s, double v) {
+  double c = v * s;
+  double x = c * (1.0 - fabs(fmod(h * 6.0, 2.0) - 1.0));
+  double m = v - c;
+  double r = 0, g = 0, b = 0;
+  int i = int(h * 6.0);
+  switch (i % 6) {
+    case 0: r = c; g = x; b = 0; break;
+    case 1: r = x; g = c; b = 0; break;
+    case 2: r = 0; g = c; b = x; break;
+    case 3: r = 0; g = x; b = c; break;
+    case 4: r = x; g = 0; b = c; break;
+    case 5: r = c; g = 0; b = x; break;
+  }
+  return Vec(r + m, g + m, b + m);
+}
+
+extern "C" {
+
+EXPORT void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25); // Left
+  spheres[1].c = Vec(.25, .25, .75); // Right
+  spheres[2].c = Vec(.75, .75, .75); // Back
+  spheres[3].c = Vec(0, 0, 0);       // Front
+  spheres[4].c = Vec(.75, .75, .75); // Bottom
+  spheres[5].c = Vec(.75, .75, .75); // Top
+  spheres[6].c = Vec(1, 1, 1) * .999; // Mirror
+  spheres[7].c = Vec(1, 1, 1) * .999; // Glass
+}
+
+EXPORT void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EXPORT double get_sphere_color_r(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.x : 0.0;
+}
+
+EXPORT double get_sphere_color_g(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.y : 0.0;
+}
+
+EXPORT double get_sphere_color_b(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.z : 0.0;
+}
+
+EXPORT void randomize_sphere_colors(unsigned int seed) {
+  if (seed != 0) g_rng_seed = seed;
+  // Left wall: vibrant random hue
+  double h1 = rand_unit();
+  spheres[0].c = hsv_to_rgb(h1, 0.65 + 0.25 * rand_unit(), 0.70 + 0.20 * rand_unit());
+  // Right wall: complementary/contrasting hue
+  double h2 = fmod(h1 + 0.35 + 0.30 * rand_unit(), 1.0);
+  spheres[1].c = hsv_to_rgb(h2, 0.65 + 0.25 * rand_unit(), 0.70 + 0.20 * rand_unit());
+  // Back wall: soft tinted hue
+  double h3 = rand_unit();
+  spheres[2].c = hsv_to_rgb(h3, 0.25 + 0.35 * rand_unit(), 0.75 + 0.15 * rand_unit());
+  // Bottom floor: subtle warm/cool tint
+  spheres[4].c = hsv_to_rgb(rand_unit(), 0.20 + 0.30 * rand_unit(), 0.75 + 0.15 * rand_unit());
+  // Top ceiling: light neutral/pastel
+  spheres[5].c = hsv_to_rgb(rand_unit(), 0.10 + 0.20 * rand_unit(), 0.80 + 0.15 * rand_unit());
+  // Mirror sphere: metallic tint (gold, copper, rose, cyan, or silver)
+  spheres[6].c = hsv_to_rgb(rand_unit(), 0.35 + 0.50 * rand_unit(), 0.90 + 0.099 * rand_unit());
+  // Glass sphere: colored crystal tint
+  spheres[7].c = hsv_to_rgb(rand_unit(), 0.30 + 0.50 * rand_unit(), 0.92 + 0.079 * rand_unit());
+}
+
+EXPORT void init_scene(int w, int h) {
+  if (w != g_w || h != g_h || !g_accum || !g_rgba) {
+    delete[] g_accum;
+    delete[] g_rgba;
+    g_w = w;
+    g_h = h;
+    g_accum = new Vec[w * h];
+    g_rgba = new uint8_t[w * h * 4];
+  }
+  for (int i = 0; i < w * h; i++) {
+    g_accum[i] = Vec(0, 0, 0);
+  }
+  for (int i = 0; i < w * h * 4; i += 4) {
+    g_rgba[i] = 0;
+    g_rgba[i + 1] = 0;
+    g_rgba[i + 2] = 0;
+    g_rgba[i + 3] = 255;
+  }
+  g_total_samples = 0;
+}
+
+// Scanline progressive render: renders [y_start, y_end) for the current pass
+EXPORT int render_scanlines(int y_start, int y_end, int samps) {
+  if (!g_accum || !g_rgba || g_w <= 0 || g_h <= 0) return 0;
+  if (samps < 1) samps = 1;
+  int w = g_w;
+  int h = g_h;
+  if (y_start < 0) y_start = 0;
+  if (y_end > h) y_end = h;
+  int pass_offset = g_total_samples;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h);
+  Vec cy = (cx % cam.d).norm() * .5135;
+
+  double inv_passes = 4.0 / double(g_total_samples + samps * 4);
+
+  for (int y = y_start; y < y_end; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(y + pass_offset * 17),
+      (unsigned short)(y * y + pass_offset * 31 + (g_rng_seed & 0xFFFF)),
+      (unsigned short)(y * y * y + pass_offset * 97 + ((g_rng_seed >> 16) & 0xFFFF))
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      Vec pixel_pass(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r(0, 0, 0);
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          pixel_pass = pixel_pass + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      int idx = (h - y - 1) * w + x;
+      g_accum[idx] = g_accum[idx] + pixel_pass * samps;
+      Vec col = g_accum[idx] * inv_passes;
+      g_rgba[idx * 4 + 0] = (uint8_t)toInt(col.x);
+      g_rgba[idx * 4 + 1] = (uint8_t)toInt(col.y);
+      g_rgba[idx * 4 + 2] = (uint8_t)toInt(col.z);
+      g_rgba[idx * 4 + 3] = 255;
+    }
+  }
+
+  if (y_end >= h) {
+    g_total_samples += samps * 4;
+  }
+  return g_total_samples;
+}
+
+// Progressive step: adds `samps` samples per subpixel (each step = samps * 4 rays/pixel)
+EXPORT int render_step(int samps) {
+  return render_scanlines(0, g_h, samps);
+}
+
+// Single-shot render entry point
+EXPORT uint8_t* render(int w, int h, int samps_per_pixel) {
+  init_scene(w, h);
+  int sub_samps = samps_per_pixel / 4;
+  if (sub_samps < 1) sub_samps = 1;
+  render_step(sub_samps);
+  return g_rgba;
+}
+
+EXPORT uint8_t* get_rgba_ptr() {
+  return g_rgba;
+}
+
+EXPORT int get_total_samples() {
+  return g_total_samples;
+}
+
+} // extern "C"
+
+int main(int argc, char *argv[]){
+  int w=1024, h=768, samps = argc==2 ? atoi(argv[1])/4 : 1; // # samples
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
