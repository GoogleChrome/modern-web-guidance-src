+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const { width, height, samples, colors, resetDefault } = event.data;
+
+  const wasm = await getWasm();
+
+  if (resetDefault) {
+    wasm._reset_default_colors();
+  }
+
+  if (Array.isArray(colors)) {
+    for (const { index, r, g, b } of colors) {
+      wasm._set_sphere_color(index, r, g, b);
+    }
+  }
+
+  const byteLength = width * height * 4;
+  const ptr = wasm._malloc(byteLength);
+
+  const startTime = performance.now();
+  try {
+    wasm._render_scene(ptr, width, height, samples);
+    const elapsedMs = Math.round(performance.now() - startTime);
+    const pixels = new Uint8ClampedArray(
+      wasm.HEAPU8.buffer,
+      ptr,
+      byteLength,
+    ).slice();
+    self.postMessage(
+      { pixels, width, height, samples, elapsedMs, colors },
+      [pixels.buffer],
+    );
+  } finally {
+    wasm._free(ptr);
+  }
+});
