new file mode 100644
index 0000000..2cfea74
--- /dev/null
+++ b/app.js
@@ -0,0 +1,126 @@
+const canvas = document.getElementById('smallpt-canvas');
+const ctx = canvas.getContext('2d');
+const statusEl = document.getElementById('render-status');
+const randomizeBtn = document.getElementById('randomize-btn');
+const resetBtn = document.getElementById('reset-btn');
+const sppSelect = document.getElementById('spp-select');
+const swatchesEl = document.getElementById('color-swatches');
+
+const SPHERE_LABELS = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+const DEFAULT_COLORS = [
+  { index: 0, r: 0.75, g: 0.25, b: 0.25 },
+  { index: 1, r: 0.25, g: 0.25, b: 0.75 },
+  { index: 2, r: 0.75, g: 0.75, b: 0.75 },
+  { index: 4, r: 0.75, g: 0.75, b: 0.75 },
+  { index: 5, r: 0.75, g: 0.75, b: 0.75 },
+  { index: 6, r: 0.999, g: 0.999, b: 0.999 },
+  { index: 7, r: 0.999, g: 0.999, b: 0.999 },
+];
+
+let activeColors = DEFAULT_COLORS;
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), {
+  type: 'module',
+});
+
+function toCssRgb(r, g, b) {
+  const toByte = (v) => Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255);
+  return `rgb(${toByte(r)}, ${toByte(g)}, ${toByte(b)})`;
+}
+
+function renderSwatches(colors) {
+  swatchesEl.replaceChildren();
+  for (const item of colors) {
+    const meta = SPHERE_LABELS.find((s) => s.index === item.index);
+    if (!meta) continue;
+    const badge = document.createElement('span');
+    badge.className = 'swatch';
+
+    const dot = document.createElement('span');
+    dot.className = 'swatch-dot';
+    dot.style.backgroundColor = toCssRgb(item.r, item.g, item.b);
+
+    const text = document.createElement('span');
+    text.textContent = meta.name;
+
+    badge.append(dot, text);
+    swatchesEl.append(badge);
+  }
+}
+
+function generateRandomColors() {
+  const randChannel = (min, max) =>
+    Number((min + Math.random() * (max - min)).toFixed(3));
+
+  return [
+    { index: 0, r: randChannel(0.15, 0.9), g: randChannel(0.15, 0.9), b: randChannel(0.15, 0.9) },
+    { index: 1, r: randChannel(0.15, 0.9), g: randChannel(0.15, 0.9), b: randChannel(0.15, 0.9) },
+    { index: 2, r: randChannel(0.25, 0.9), g: randChannel(0.25, 0.9), b: randChannel(0.25, 0.9) },
+    { index: 4, r: randChannel(0.25, 0.9), g: randChannel(0.25, 0.9), b: randChannel(0.25, 0.9) },
+    { index: 5, r: randChannel(0.35, 0.9), g: randChannel(0.35, 0.9), b: randChannel(0.35, 0.9) },
+    { index: 6, r: randChannel(0.4, 0.999), g: randChannel(0.4, 0.999), b: randChannel(0.4, 0.999) },
+    { index: 7, r: randChannel(0.4, 0.999), g: randChannel(0.4, 0.999), b: randChannel(0.4, 0.999) },
+  ];
+}
+
+function setBusy(isBusy, message) {
+  randomizeBtn.disabled = isBusy;
+  resetBtn.disabled = isBusy;
+  sppSelect.disabled = isBusy;
+  statusEl.textContent = message;
+}
+
+function startRender({ colors, resetDefault = false }) {
+  const samples = Number.parseInt(sppSelect.value, 10) || 16;
+  activeColors = colors;
+  renderSwatches(activeColors);
+  setBusy(
+    true,
+    `Rendering ${canvas.width}x${canvas.height} at ${samples} spp in WebAssembly...`,
+  );
+  worker.postMessage({
+    width: canvas.width,
+    height: canvas.height,
+    samples,
+    colors,
+    resetDefault,
+  });
+}
+
+worker.addEventListener('message', (event) => {
+  const { pixels, width, height, samples, elapsedMs } = event.data;
+  const imageData = new ImageData(pixels, width, height);
+  ctx.putImageData(imageData, 0, 0);
+  setBusy(
+    false,
+    `Rendered ${width}x${height} (${samples} spp) in ${elapsedMs} ms via WebAssembly.`,
+  );
+});
+
+worker.addEventListener('error', (err) => {
+  setBusy(false, `Render worker error: ${err.message || 'Unknown error'}`);
+});
+
+randomizeBtn.addEventListener('click', () => {
+  startRender({ colors: generateRandomColors(), resetDefault: false });
+});
+
+resetBtn.addEventListener('click', () => {
+  startRender({ colors: DEFAULT_COLORS, resetDefault: true });
+});
+
+sppSelect.addEventListener('change', () => {
+  startRender({ colors: activeColors, resetDefault: false });
+});
+
+// Perform initial render on load
+startRender({ colors: DEFAULT_COLORS, resetDefault: true });
