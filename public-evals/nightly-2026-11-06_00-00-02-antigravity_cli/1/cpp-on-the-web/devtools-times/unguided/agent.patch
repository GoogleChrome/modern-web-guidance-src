+        padding: 6px 8px;
+        border-radius: 4px;
+        border: 1px solid var(--border);
+      }
+      .swatch-dot {
+        width: 14px;
+        height: 14px;
+        border-radius: 50%;
+        border: 1px solid rgba(255, 255, 255, 0.25);
+        flex-shrink: 0;
+      }
+      .swatch-hex {
+        margin-left: auto;
+        color: var(--muted);
+      }
+    </style>
+  </head>
+  <body>
+    <div class="container">
+      <div class="layout">
+        <div class="viewport-col">
+          <div class="canvas-wrap">
+            <canvas
+              id="smallpt-canvas"
+              width="240"
+              height="180"
+              data-render-count="0"
+              data-seed="0"
+              data-passes="0"
+            ></canvas>
+            <div id="smallpt-badge">Initializing WebAssembly...</div>
+          </div>
+          <div class="progress-track">
+            <div id="smallpt-progress-bar"></div>
+          </div>
+        </div>
+
+        <div class="info-col">
+          <span class="pill">C++ to WebAssembly • Monte Carlo Path Tracer</span>
+          <h1>smallpt Path Tracer</h1>
+          <p>
+            Running Kevin Beason's open-source C++ global illumination path tracer (<code>smallpt.cpp</code>) compiled to WebAssembly (<code>smallpt.wasm</code>) client-side in the browser.
+          </p>
+
+          <div class="actions">
+            <button id="randomize-colors-btn" type="button">
+              Run Again with Randomized Sphere Colors
+            </button>
+            <button id="reset-colors-btn" type="button">
+              Reset Default Colors
+            </button>
+          </div>
+
+          <div class="swatches-box">
+            <div class="swatches-header">
+              <span>ACTIVE SCENE SPHERE COLORS</span>
+              <span id="smallpt-stats">240×180 • 0 spp</span>
+            </div>
+            <div class="swatches-grid">
+              <div class="swatch-item">
+                <span data-swatch-idx="0" class="swatch-dot" style="background:#bf4040"></span>
+                <span>Left Wall</span>
+                <span data-swatch-hex="0" class="swatch-hex">#bf4040</span>
+              </div>
+              <div class="swatch-item">
+                <span data-swatch-idx="1" class="swatch-dot" style="background:#4040bf"></span>
+                <span>Right Wall</span>
+                <span data-swatch-hex="1" class="swatch-hex">#4040bf</span>
+              </div>
+              <div class="swatch-item">
+                <span data-swatch-idx="2" class="swatch-dot" style="background:#bfbfbf"></span>
+                <span>Back Wall</span>
+                <span data-swatch-hex="2" class="swatch-hex">#bfbfbf</span>
+              </div>
+              <div class="swatch-item">
+                <span data-swatch-idx="4" class="swatch-dot" style="background:#bfbfbf"></span>
+                <span>Floor</span>
+                <span data-swatch-hex="4" class="swatch-hex">#bfbfbf</span>
+              </div>
+              <div class="swatch-item">
+                <span data-swatch-idx="6" class="swatch-dot" style="background:#ffffff"></span>
+                <span>Mirror</span>
+                <span data-swatch-hex="6" class="swatch-hex">#ffffff</span>
+              </div>
+              <div class="swatch-item">
+                <span data-swatch-idx="7" class="swatch-dot" style="background:#ffffff"></span>
+                <span>Glass</span>
+                <span data-swatch-hex="7" class="swatch-hex">#ffffff</span>
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+
+    <script>
+      (function () {
+        const WIDTH = 240;
+        const HEIGHT = 180;
+        const TARGET_PASSES = 24;
+        const PASSES_PER_STEP = 2;
+
+        let wasmMod = null;
+        let rafId = null;
+        let renderCount = 0;
+        let currentSeed = 0;
+        let renderStartTime = 0;
+
+        function toHexChannel(v) {
+          const clamped = Math.max(0, Math.min(1, v));
+          const srgb = Math.round(Math.pow(clamped, 1 / 2.2) * 255);
+          return srgb.toString(16).padStart(2, "0");
+        }
+
+        function updateSwatches() {
+          if (!wasmMod) return;
+          const indices = [0, 1, 2, 4, 6, 7];
+          const colors = {};
+          for (const idx of indices) {
+            const r = wasmMod._get_sphere_color_channel(idx, 0);
+            const g = wasmMod._get_sphere_color_channel(idx, 1);
+            const b = wasmMod._get_sphere_color_channel(idx, 2);
+            const hex = "#" + toHexChannel(r) + toHexChannel(g) + toHexChannel(b);
+            colors[idx] = hex;
+            const dot = document.querySelector(`[data-swatch-idx="${idx}"]`);
+            const label = document.querySelector(`[data-swatch-hex="${idx}"]`);
+            if (dot) dot.style.background = hex;
+            if (label) label.textContent = hex;
+          }
+          const canvas = document.getElementById("smallpt-canvas");
+          if (canvas) {
+            canvas.setAttribute("data-sphere-colors", JSON.stringify(colors));
+          }
+        }
+
+        function blitToCanvas(passes) {
+          const canvas = document.getElementById("smallpt-canvas");
+          if (!canvas || !wasmMod) return;
+          const ctx = canvas.getContext("2d");
+          if (!ctx) return;
+
+          const ptr = wasmMod._get_rgba_ptr();
+          const byteLength = WIDTH * HEIGHT * 4;
+          const pixels = new Uint8ClampedArray(
+            wasmMod.HEAPU8.buffer,
+            ptr,
+            byteLength
+          );
+          const imageData = new ImageData(new Uint8ClampedArray(pixels), WIDTH, HEIGHT);
+          ctx.putImageData(imageData, 0, 0);
+
+          const elapsedMs = Math.round(performance.now() - renderStartTime);
+          const pct = Math.min(100, Math.round((passes / TARGET_PASSES) * 100));
+
+          canvas.setAttribute("data-passes", String(passes));
+
+          const badge = document.getElementById("smallpt-badge");
+          if (badge) {
+            badge.textContent =
+              passes >= TARGET_PASSES
+                ? `Rendered ${passes} spp (${elapsedMs} ms)`
+                : `Tracing rays... ${passes}/${TARGET_PASSES} spp (${pct}%)`;
+          }
+
+          const progressBar = document.getElementById("smallpt-progress-bar");
+          if (progressBar) {
+            progressBar.style.width = `${pct}%`;
+          }
+
+          const stats = document.getElementById("smallpt-stats");
+          if (stats) {
+            stats.textContent = `${WIDTH}×${HEIGHT} • ${passes} spp • ${elapsedMs} ms`;
+          }
+        }
+
+        function scheduleNextPass() {
+          if (rafId !== null) {
+            cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            if (!wasmMod) return;
+            const currentPasses = wasmMod._get_passes();
+            if (currentPasses >= TARGET_PASSES) return;
+            const passes = wasmMod._render_pass(PASSES_PER_STEP);
+            blitToCanvas(passes);
+            if (passes < TARGET_PASSES) {
+              scheduleNextPass();
+            }
+          });
+        }
+
+        function startRender(randomize) {
+          if (!wasmMod) return;
+          if (rafId !== null) {
+            cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+
+          renderStartTime = performance.now();
+          if (randomize) {
+            currentSeed = ((Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0) || 1;
+            wasmMod._randomize_sphere_colors(currentSeed);
+          }
+
+          updateSwatches();
+
+          const passes = wasmMod._render_pass(PASSES_PER_STEP);
+          renderCount += 1;
+
+          const canvas = document.getElementById("smallpt-canvas");
+          if (canvas) {
+            canvas.setAttribute("data-render-count", String(renderCount));
+            canvas.setAttribute("data-seed", String(currentSeed));
+          }
+
+          blitToCanvas(passes);
+          if (passes < TARGET_PASSES) {
+            scheduleNextPass();
+          }
+        }
+
+        function loadScriptCandidate(candidates) {
+          return new Promise((resolve, reject) => {
+            let idx = 0;
+            function tryNext() {
+              if (idx >= candidates.length) {
+                reject(new Error("Could not load smallpt.js"));
+                return;
+              }
+              const src = candidates[idx++];
+              const s = document.createElement("script");
+              s.src = src;
+              s.onload = () => {
+                const dir = src.substring(0, src.lastIndexOf("/") + 1);
+                resolve(dir);
+              };
+              s.onerror = tryNext;
+              document.head.appendChild(s);
+            }
+            tryNext();
+          });
+        }
+
+        async function init() {
+          let wasmDir = "./";
+          if (typeof window.createSmallptModule !== "function") {
+            wasmDir = await loadScriptCandidate([
+              "./smallpt.js",
+              "./public/smallpt.js",
+              "/devtools-times/smallpt.js",
+              "/smallpt.js",
+            ]);
+          }
+          wasmMod = await window.createSmallptModule({
+            locateFile: function (file) {
+              return wasmDir + file;
+            },
+          });
+          wasmMod._init_renderer(WIDTH, HEIGHT);
+
+          document
+            .getElementById("randomize-colors-btn")
+            .addEventListener("click", function () {
+              startRender(true);
+            });
+
+          document
+            .getElementById("reset-colors-btn")
+            .addEventListener("click", function () {
+              currentSeed = 0;
+              wasmMod._reset_sphere_colors();
+              startRender(false);
+            });
+
+          startRender(false);
+        }
+
+        init();
+      })();
+    </script>
+  </body>
+</html>
