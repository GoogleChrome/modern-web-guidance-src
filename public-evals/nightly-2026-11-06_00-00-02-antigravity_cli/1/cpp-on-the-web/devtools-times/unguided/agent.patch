diff --git a/src/wasm/smallpt.cpp b/src/wasm/smallpt.cpp
new file mode 100644
index 0000000..4c17c33
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,304 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Adapted for WebAssembly client-side execution in the browser.
+
+#include <cmath>
+#include <cstdlib>
+#include <cstdio>
+#include <cstdint>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+  double x, y, z; // position, also color (r,g,b)
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) { x = x_; y = y_; z = z_; }
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec& norm() { return *this = *this * (1 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; } // cross:
+  Vec operator%(Vec &b) { return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x); }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR }; // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_) :
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p - r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0; else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+// Scene: radius, position, emission, color, material
+Sphere spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+
+const Vec default_colors[] = {
+  Vec(.75, .25, .25),
+  Vec(.25, .25, .75),
+  Vec(.75, .75, .75),
+  Vec(0, 0, 0),
+  Vec(.75, .75, .75),
+  Vec(.75, .75, .75),
+  Vec(.999, .999, .999),
+  Vec(.999, .999, .999),
+  Vec(0, 0, 0)
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return int(pow(clamp(x), 1 / 2.2) * 255 + .5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+  for (int i = int(n); i--;) if ((d = spheres[i].intersect(r)) && d < t) { t = d; id = i; }
+  return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+  double t;                               // distance to intersection
+  int id = 0;                             // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z; // max refl
+  if (++depth > 5) {
+    if (depth < 50 && erand48(Xi) < p) f = f * (1 / p);
+    else return obj.e; // R.R.
+  }
+  if (obj.refl == DIFF) {                 // Ideal DIFFUSE reflection
+    double r1 = 2 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl) > 0;                    // Ray from outside going in?
+  double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1 - P);
+  return obj.e + f.mult(depth > 2 ? (erand48(Xi) < P ?   // Russian roulette
+    radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+    radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static int g_width = 0;
+static int g_height = 0;
+static int g_passes = 0;
+static int g_sub_counts[4] = {0, 0, 0, 0};
+static Vec *g_sub_accum = nullptr; // 4 subpixels per pixel
+static uint8_t *g_rgba = nullptr;
+static unsigned int g_seed_offset = 1u;
+
+static uint32_t splitmix32(uint32_t x) {
+  x += 0x9e3779b9u;
+  x = (x ^ (x >> 16)) * 0x85ebca6bu;
+  x = (x ^ (x >> 13)) * 0xc2b2ae35u;
+  return x ^ (x >> 16);
+}
+
+static double rand01(unsigned int &state) {
+  state = splitmix32(state);
+  return (state & 0x00FFFFFFu) / double(0x01000000u);
+}
+
+static Vec hsv_to_rgb(double h, double s, double v) {
+  double c = v * s;
+  double x = c * (1.0 - fabs(fmod(h * 6.0, 2.0) - 1.0));
+  double m = v - c;
+  double r = 0, g = 0, b = 0;
+  int region = int(h * 6.0) % 6;
+  switch (region) {
+    case 0: r = c; g = x; b = 0; break;
+    case 1: r = x; g = c; b = 0; break;
+    case 2: r = 0; g = c; b = x; break;
+    case 3: r = 0; g = x; b = c; break;
+    case 4: r = x; g = 0; b = c; break;
+    default: r = c; g = 0; b = x; break;
+  }
+  return Vec(r + m, g + m, b + m);
+}
+
+static void clear_accum() {
+  g_passes = 0;
+  for (int s = 0; s < 4; ++s) g_sub_counts[s] = 0;
+  if (g_sub_accum) {
+    for (int i = 0; i < g_width * g_height * 4; ++i) {
+      g_sub_accum[i] = Vec();
+    }
+  }
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void init_renderer(int w, int h) {
+  if (g_width != w || g_height != h || !g_sub_accum || !g_rgba) {
+    delete[] g_sub_accum;
+    delete[] g_rgba;
+    g_width = w;
+    g_height = h;
+    g_sub_accum = new Vec[w * h * 4];
+    g_rgba = new uint8_t[w * h * 4];
+  }
+  clear_accum();
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  for (int i = 0; i < 9; ++i) {
+    spheres[i].c = default_colors[i];
+  }
+  clear_accum();
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_channel(int index, int channel) {
+  if (index < 0 || index >= 9) return 0.0;
+  if (channel == 0) return spheres[index].c.x;
+  if (channel == 1) return spheres[index].c.y;
+  return spheres[index].c.z;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned int state = seed ? seed : (1337u + g_seed_offset * 7919u);
+  g_seed_offset += 1u;
+
+  // Left wall (sphere 0) - vibrant hue
+  double h0 = rand01(state);
+  spheres[0].c = hsv_to_rgb(h0, 0.70 + 0.25 * rand01(state), 0.75 + 0.15 * rand01(state));
+
+  // Right wall (sphere 1) - complementary/contrasting hue
+  double h1 = fmod(h0 + 0.32 + 0.36 * rand01(state), 1.0);
+  spheres[1].c = hsv_to_rgb(h1, 0.70 + 0.25 * rand01(state), 0.75 + 0.15 * rand01(state));
+
+  // Back wall (sphere 2) - distinct tinted backdrop
+  double h2 = fmod(h0 + 0.18 + 0.64 * rand01(state), 1.0);
+  spheres[2].c = hsv_to_rgb(h2, 0.35 + 0.35 * rand01(state), 0.75 + 0.15 * rand01(state));
+
+  // Bottom floor (sphere 4) - soft warm or cool tint
+  double h4 = rand01(state);
+  spheres[4].c = hsv_to_rgb(h4, 0.25 + 0.30 * rand01(state), 0.75 + 0.15 * rand01(state));
+
+  // Top ceiling (sphere 5) - light tint
+  double h5 = rand01(state);
+  spheres[5].c = hsv_to_rgb(h5, 0.15 + 0.25 * rand01(state), 0.80 + 0.15 * rand01(state));
+
+  // Mirror sphere (sphere 6) - colorful metallic specular tint
+  double h6 = rand01(state);
+  spheres[6].c = hsv_to_rgb(h6, 0.60 + 0.35 * rand01(state), 0.92 + 0.079 * rand01(state));
+
+  // Glass sphere (sphere 7) - colorful refractive glass tint
+  double h7 = fmod(h6 + 0.30 + 0.40 * rand01(state), 1.0);
+  spheres[7].c = hsv_to_rgb(h7, 0.60 + 0.35 * rand01(state), 0.92 + 0.079 * rand01(state));
+
+  clear_accum();
+}
+
+EMSCRIPTEN_KEEPALIVE
+int render_pass(int rays_per_pass) {
+  if (!g_sub_accum || !g_rgba || g_width <= 0 || g_height <= 0) {
+    init_renderer(320, 240);
+  }
+  int w = g_width;
+  int h = g_height;
+  int count = rays_per_pass > 0 ? rays_per_pass : 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm()); // cam pos, dir
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135;
+
+  for (int c_idx = 0; c_idx < count; ++c_idx) {
+    int pass_idx = g_passes;
+    int sub = pass_idx & 3;
+    int sx = sub & 1;
+    int sy = (sub >> 1) & 1;
+
+    for (int y = 0; y < h; y++) { // Loop over image rows
+      uint32_t h1 = splitmix32(uint32_t(y) * 1973u + uint32_t(pass_idx) * 9277u + g_seed_offset * 26699u);
+      uint32_t h2 = splitmix32(h1 ^ 0xdeadbeefu);
+      unsigned short Xi[3] = {
+        static_cast<unsigned short>(h1 & 0xFFFFu),
+        static_cast<unsigned short>((h1 >> 16) & 0xFFFFu),
+        static_cast<unsigned short>(h2 & 0xFFFFu)
+      };
+      for (unsigned short x = 0; x < w; x++) { // Loop cols
+        int i = (h - y - 1) * w + x;
+        double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+        double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+        Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+        Vec r = radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi);
+        // Camera rays are pushed ^^^^^ forward to start in interior
+        g_sub_accum[i * 4 + sub] = g_sub_accum[i * 4 + sub] + r;
+      }
+    }
+    g_sub_counts[sub]++;
+    g_passes++;
+  }
+
+  double inv_passes = g_passes > 0 ? (1.0 / double(g_passes)) : 1.0;
+
+  for (int i = 0; i < w * h; ++i) {
+    Vec sum = g_sub_accum[i * 4 + 0] + g_sub_accum[i * 4 + 1] + g_sub_accum[i * 4 + 2] + g_sub_accum[i * 4 + 3];
+    Vec c = sum * inv_passes;
+    g_rgba[i * 4 + 0] = static_cast<uint8_t>(toInt(c.x));
+    g_rgba[i * 4 + 1] = static_cast<uint8_t>(toInt(c.y));
+    g_rgba[i * 4 + 2] = static_cast<uint8_t>(toInt(c.z));
+    g_rgba[i * 4 + 3] = 255;
+  }
+
+  return g_passes;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_ptr() {
+  return g_rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_width() {
+  return g_width;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_height() {
+  return g_height;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_passes() {
+  return g_passes;
+}
+
+}
