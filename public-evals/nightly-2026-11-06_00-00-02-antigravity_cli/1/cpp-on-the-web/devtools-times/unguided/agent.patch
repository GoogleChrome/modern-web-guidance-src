+<script is:inline src={`${baseUrl}smallpt.js`}></script>
+<script is:inline define:vars={{ baseUrl }}>
+  (function () {
+    const WIDTH = 240;
+    const HEIGHT = 180;
+    const TARGET_PASSES = 24;
