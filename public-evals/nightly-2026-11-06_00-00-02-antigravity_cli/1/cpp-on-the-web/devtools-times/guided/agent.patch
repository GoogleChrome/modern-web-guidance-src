+import initSmallpt from './smallpt.js';
+
+interface SmallptModule {
+  _render_frame: (ptr: number, width: number, height: number, samples: number) => void;
+  _randomize_spheres: (seed: number) => void;
+  _set_sphere_color: (index: number, r: number, g: number, b: number) => void;
+  _get_sphere_colors: (ptr: number) => void;
+  _malloc: (size: number) => number;
+  _free: (ptr: number) => void;
+  HEAPU8: Uint8Array;
+}
+
+let wasmPromise: Promise<SmallptModule> | null = null;
+
+function getWasm(): Promise<SmallptModule> {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt() as Promise<SmallptModule>;
+  }
+  return wasmPromise;
+}
+
+export interface RenderRequestMessage {
+  width: number;
+  height: number;
+  samples: number;
+  randomize?: boolean;
+  seed?: number;
+  renderId?: number;
+}
+
+export interface RenderResponseMessage {
+  pixels: Uint8ClampedArray;
+  width: number;
+  height: number;
+  samples: number;
+  elapsedMs: number;
+  paletteBytes: Uint8Array;
+  renderId: number;
+}
+
+self.onmessage = async (event: MessageEvent<RenderRequestMessage>) => {
+  const {
+    width = 320,
+    height = 240,
+    samples = 2,
+    randomize = false,
+    seed = Date.now(),
+    renderId = 0,
+  } = event.data || {};
+
+  const wasm = await getWasm();
+
+  if (randomize) {
+    wasm._randomize_spheres(seed >>> 0);
+  }
+
+  const byteLength = width * height * 4;
+  const paletteLength = 9 * 3;
+  const ptr = wasm._malloc(byteLength);
+  const palettePtr = wasm._malloc(paletteLength);
+
+  try {
+    const startMs = performance.now();
+    wasm._render_frame(ptr, width, height, samples);
+    const elapsedMs = performance.now() - startMs;
+
+    wasm._get_sphere_colors(palettePtr);
+
+    // Read wasm.HEAPU8 fresh after Wasm execution since ALLOW_MEMORY_GROWTH may detach previous buffers
+    const pixels = new Uint8ClampedArray(
+      wasm.HEAPU8.buffer,
+      ptr,
+      byteLength,
+    ).slice();
+
+    const paletteBytes = new Uint8Array(
+      wasm.HEAPU8.buffer,
+      palettePtr,
+      paletteLength,
+    ).slice();
+
+    self.postMessage(
+      {
+        pixels,
+        width,
+        height,
+        samples,
+        elapsedMs,
+        paletteBytes,
+        renderId,
+      } satisfies RenderResponseMessage,
+      [pixels.buffer],
+    );
+  } finally {
+    wasm._free(palettePtr);
+    wasm._free(ptr);
+  }
+};
