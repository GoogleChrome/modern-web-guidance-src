diff --git a/src/components/SmallptPathTracer.tsx b/src/components/SmallptPathTracer.tsx
new file mode 100644
index 0000000..505ba5f
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,176 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+import type { RenderRequestMessage, RenderResponseMessage } from '../wasm/worker';
+
+const SPHERE_LABELS: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+const DEFAULT_WIDTH = 320;
+const DEFAULT_HEIGHT = 240;
+const DEFAULT_SAMPLES = 2; // 2x2 subpixels * 2 = 8 samples per pixel
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const renderIdRef = useRef<number>(0);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [sphereColors, setSphereColors] = useState<string[]>([
+    'rgb(225, 135, 135)',
+    'rgb(135, 135, 225)',
+    'rgb(225, 225, 225)',
+    'rgb(225, 225, 225)',
+    'rgb(225, 225, 225)',
+    'rgb(255, 255, 255)',
+    'rgb(255, 255, 255)',
+  ]);
+
+  const triggerRender = useCallback((randomize: boolean) => {
+    const worker = workerRef.current;
+    if (!worker) return;
+
+    setIsRendering(true);
+    const nextRenderId = ++renderIdRef.current;
+    const seed = Math.floor(Math.random() * 0xffffffff) >>> 0;
+
+    const request: RenderRequestMessage = {
+      width: DEFAULT_WIDTH,
+      height: DEFAULT_HEIGHT,
+      samples: DEFAULT_SAMPLES,
+      randomize,
+      seed,
+      renderId: nextRenderId,
+    };
+
+    worker.postMessage(request);
+  }, []);
+
+  useEffect(() => {
+    const worker = new Worker(new URL('../wasm/worker.ts', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent<RenderResponseMessage>) => {
+      const { pixels, width, height, elapsedMs: duration, paletteBytes } = event.data;
+
+      const canvas = canvasRef.current;
+      if (canvas) {
+        const ctx = canvas.getContext('2d');
+        if (ctx) {
+          const imageData = new ImageData(new Uint8ClampedArray(pixels), width, height);
+          ctx.putImageData(imageData, 0, 0);
+        }
+      }
+
+      if (paletteBytes && paletteBytes.length >= 27) {
+        const updatedColors = SPHERE_LABELS.map(({ index }) => {
+          const r = paletteBytes[index * 3 + 0];
+          const g = paletteBytes[index * 3 + 1];
+          const b = paletteBytes[index * 3 + 2];
+          return `rgb(${r}, ${g}, ${b})`;
+        });
+        setSphereColors(updatedColors);
+      }
+
+      setElapsedMs(duration);
+      setIsRendering(false);
+    };
+
+    // Initial render with original smallpt Cornell Box colors
+    triggerRender(false);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [triggerRender]);
+
+  return (
+    <section
+      aria-labelledby="smallpt-heading"
+      className="my-6 bg-gray-900 text-white rounded-xl shadow-md overflow-hidden border border-gray-800"
+    >
+      <div className="p-6 md:p-8 flex flex-col lg:flex-row gap-8 items-center">
+        <div className="relative flex-shrink-0 w-full max-w-[480px] aspect-[4/3] bg-black rounded-lg overflow-hidden border border-gray-700 shadow-inner flex items-center justify-center">
+          <canvas
+            ref={canvasRef}
+            id="smallpt-canvas"
+            width={DEFAULT_WIDTH}
+            height={DEFAULT_HEIGHT}
+            className="w-full h-full object-contain"
+          />
+          {isRendering && (
+            <div
+              role="status"
+              aria-live="polite"
+              className="absolute inset-0 bg-black/50 backdrop-blur-[2px] flex flex-col items-center justify-center gap-2 text-sm font-medium text-amber-300"
+            >
+              <span className="inline-block h-6 w-6 animate-spin rounded-full border-2 border-amber-400 border-t-transparent" />
+              <span>Path tracing in WebAssembly…</span>
+            </div>
+          )}
+        </div>
+
+        <div className="flex-1 space-y-4 text-left">
+          <div className="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-400/15 text-amber-300 border border-amber-400/30">
+            Interactive WebAssembly Demo
+          </div>
+          <h2 id="smallpt-heading" className="text-2xl md:text-3xl font-bold tracking-tight text-white">
+            smallpt C++ Global Illumination Path Tracer
+          </h2>
+          <p className="text-gray-300 text-sm leading-relaxed">
+            Compiled from Kevin Beason&apos;s open-source C++ path tracer (<code>smallpt</code>) to
+            WebAssembly using Emscripten and executed off the main thread in a dedicated Web Worker.
+            Features Monte Carlo global illumination, diffuse surfaces, specular reflection, and
+            dielectric glass refraction.
+          </p>
+
+          <div className="pt-1">
+            <div className="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
+              Scene Sphere Colors
+            </div>
+            <div className="flex flex-wrap gap-2">
+              {SPHERE_LABELS.map((sphere, i) => (
+                <div
+                  key={sphere.index}
+                  className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-gray-800 border border-gray-700 text-xs text-gray-200"
+                >
+                  <span
+                    className="w-3 h-3 rounded-full border border-white/20 inline-block"
+                    style={{ backgroundColor: sphereColors[i] }}
+                  />
+                  <span>{sphere.name}</span>
+                </div>
+              ))}
+            </div>
+          </div>
+
+          <div className="pt-2 flex flex-wrap items-center gap-4">
+            <button
+              type="button"
+              id="randomize-spheres-btn"
+              onClick={() => triggerRender(true)}
+              disabled={isRendering}
+              className="px-5 py-2.5 rounded-lg font-semibold text-sm bg-amber-400 text-gray-950 hover:bg-amber-300 disabled:opacity-60 disabled:cursor-not-allowed transition cursor-pointer shadow-sm"
+            >
+              {isRendering ? 'Rendering…' : 'Randomize Sphere Colors'}
+            </button>
+
+            <div className="text-xs text-gray-400 font-mono">
+              {DEFAULT_WIDTH}×{DEFAULT_HEIGHT} · {DEFAULT_SAMPLES * 4} spp
+              {elapsedMs !== null && ` · ${Math.round(elapsedMs)} ms`}
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
