+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      if (!board) return;
+
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      const listsByStatus = {};
+      const countsByStatus = {};
+
+      columns.forEach((col) => {
+        const status = col.getAttribute('data-status');
+        listsByStatus[status] = col.querySelector('.column-cards');
+        countsByStatus[status] = col.querySelector('.column-count');
+      });
+
+      function renderMoveButtons(status) {
+        if (status === 'queued') {
+          return '<button type="button" class="move-btn" data-move-to="brewing" title="Move to Brewing">Brew &rarr;</button>';
+        }
+        if (status === 'brewing') {
+          return (
+            '<button type="button" class="move-btn" data-move-to="queued" title="Move to Queued">&larr;</button>' +
+            '<button type="button" class="move-btn" data-move-to="ready" title="Move to Ready">Ready &rarr;</button>'
+          );
+        }
+        return '<button type="button" class="move-btn" data-move-to="brewing" title="Move back to Brewing">&larr; Brew</button>';
+      }
+
+      function updateColumnCounts() {
+        Object.keys(listsByStatus).forEach((status) => {
+          const list = listsByStatus[status];
+          const badge = countsByStatus[status];
+          if (list && badge) {
+            badge.textContent = String(list.children.length);
+          }
+        });
+      }
+
+      function moveCardToColumn(card, targetStatus, beforeCard) {
+        const targetList = listsByStatus[targetStatus];
+        if (!card || !targetList) return;
+
+        window.requestAnimationFrame(() => {
+          card.setAttribute('data-status', targetStatus);
+          const btnContainer = card.querySelector('.move-btns');
+          if (btnContainer) {
+            btnContainer.innerHTML = renderMoveButtons(targetStatus);
+          }
+
+          if (beforeCard && beforeCard.parentNode === targetList && beforeCard !== card) {
+            targetList.insertBefore(card, beforeCard);
+          } else {
+            targetList.appendChild(card);
+          }
+
+          updateColumnCounts();
+        });
+      }
+
+      // Quick action buttons via event delegation
+      board.addEventListener('click', (e) => {
+        const moveBtn = e.target.closest('.move-btn');
+        if (!moveBtn) return;
+        const targetStatus = moveBtn.getAttribute('data-move-to');
+        const card = moveBtn.closest('.card');
+        if (card && targetStatus) {
+          moveCardToColumn(card, targetStatus, null);
+        }
+      });
+
+      // Native HTML5 Drag and Drop support (batched via requestAnimationFrame)
+      let draggedCard = null;
+      let activeDropColumn = null;
+      let dragRafId = null;
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.getAttribute('data-order-id') || '');
+        }
+        window.requestAnimationFrame(() => {
+          if (draggedCard) draggedCard.classList.add('is-dragging');
+        });
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!draggedCard) return;
+        e.preventDefault();
+        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
+
+        const col = e.target.closest('.board-column');
+        if (col !== activeDropColumn) {
+          if (dragRafId) cancelAnimationFrame(dragRafId);
+          dragRafId = window.requestAnimationFrame(() => {
+            columns.forEach((c) => c.classList.toggle('drag-over', c === col));
+            activeDropColumn = col;
+          });
+        }
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const col = e.target.closest('.board-column');
+        if (col && !col.contains(e.relatedTarget)) {
+          col.classList.remove('drag-over');
+          if (activeDropColumn === col) activeDropColumn = null;
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        if (!draggedCard) return;
+        e.preventDefault();
+        const col = e.target.closest('.board-column');
+        columns.forEach((c) => c.classList.remove('drag-over'));
+        activeDropColumn = null;
+
+        if (col) {
+          const targetStatus = col.getAttribute('data-status');
+          const overCard = e.target.closest('.card');
+          moveCardToColumn(draggedCard, targetStatus, overCard);
+        }
+      });
+
+      board.addEventListener('dragend', () => {
+        if (draggedCard) {
+          draggedCard.classList.remove('is-dragging');
+          draggedCard = null;
+        }
+        columns.forEach((c) => c.classList.remove('drag-over'));
+        activeDropColumn = null;
+      });
+
+      // Add new order form handler using DocumentFragment
+      let nextOrderId = 104;
+      const newOrderForm = document.getElementById('new-order-form');
+      if (newOrderForm) {
+        newOrderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const customerInput = document.getElementById('customer-input');
+          const drinkSelect = document.getElementById('drink-select');
+          const sizeSelect = document.getElementById('size-select');
+
+          const customer = (customerInput.value || 'Guest').trim();
+          const drink = drinkSelect.value;
+          const size = sizeSelect.value;
+          const orderId = nextOrderId++;
+
+          const fragment = document.createDocumentFragment();
+          const card = document.createElement('div');
+          card.className = 'card';
+          card.setAttribute('draggable', 'true');
+          card.setAttribute('data-order-id', String(orderId));
+          card.setAttribute('data-status', 'queued');
+
+          card.innerHTML =
+            '<div class="card-top">' +
+              '<span class="order-id">#' + orderId + '</span>' +
+              '<span class="order-time">Just now</span>' +
+            '</div>' +
+            '<h3></h3>' +
+            '<p class="order-meta"></p>' +
+            '<div class="card-actions">' +
+              '<span class="customer-tag"></span>' +
+              '<div class="move-btns">' + renderMoveButtons('queued') + '</div>' +
+            '</div>';
+
+          card.querySelector('h3').textContent = drink;
+          card.querySelector('.order-meta').textContent = size + ' \u2022 Standard prep';
+          card.querySelector('.customer-tag').textContent = customer;
+
+          fragment.appendChild(card);
+
+          window.requestAnimationFrame(() => {
+            listsByStatus.queued.insertBefore(fragment, listsByStatus.queued.firstChild);
+            updateColumnCounts();
+            customerInput.value = '';
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
