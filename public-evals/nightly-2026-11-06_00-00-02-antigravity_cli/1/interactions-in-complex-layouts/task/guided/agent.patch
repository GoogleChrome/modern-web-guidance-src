+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      const announcer = document.getElementById('kanban-announcer');
+      const columns = Array.from(document.querySelectorAll('.board-column'));
+      const statusOrder = ['queued', 'brewing', 'ready'];
+      let draggedCard = null;
+      let nextOrderNumber = 105;
+
+      const sampleDrinks = [
+        { name: 'Maple Oat Latte', notes: 'Creamy oat milk with a hint of Vermont maple syrup.', link: '/menu/seasonal' },
+        { name: 'Dark Roast Espresso', notes: 'Bold, smokey, and perfect for a morning boost.', link: '/menu/espresso' },
+        { name: 'Cold Brew', notes: 'Steeped for 18 hours for maximum smoothness.', link: '/menu/cold-brew' },
+        { name: 'Caramel Macchiato', notes: 'Freshly steamed milk with vanilla-flavored syrup and caramel drizzle.', link: '/menu/espresso' },
+        { name: 'Matcha Green Tea Latte', notes: 'Smooth and creamy matcha sweetened just right with oat milk.', link: '/menu/seasonal' }
+      ];
+
+      function moveNodePreservingState(targetParent, nodeToMove, referenceNode = null) {
+        if ('moveBefore' in Element.prototype) {
+          targetParent.moveBefore(nodeToMove, referenceNode);
+        } else {
+          targetParent.insertBefore(nodeToMove, referenceNode);
+        }
+      }
+
+      function updateColumnCounts() {
+        for (const col of columns) {
+          const status = col.dataset.status;
+          const list = col.querySelector('.column-cards') || col;
+          const count = list.querySelectorAll('.card').length;
+          const badge = col.querySelector(`[data-count-for="${status}"]`);
+          if (badge) {
+            badge.textContent = String(count);
+          }
+        }
+      }
+
+      function updateCardButtonLabel(card, status) {
+        const btn = card.querySelector('.btn-move');
+        if (!btn) return;
+        btn.textContent = status === 'ready' ? 'Complete \u2713' : 'Advance \u2192';
+      }
+
+      function moveItemToColumn(card, targetColumn, referenceCard = null) {
+        if (!card || !targetColumn) return;
+        const targetList = targetColumn.querySelector('.column-cards') || targetColumn;
+        const newStatus = targetColumn.dataset.status;
+
+        moveNodePreservingState(targetList, card, referenceCard);
+        updateCardButtonLabel(card, newStatus);
+        updateColumnCounts();
+
+        const title = card.querySelector('h3')?.textContent || 'Order';
+        if (announcer) {
+          announcer.textContent = `Moved ${title} to ${newStatus}`;
+        }
+      }
+
+      function getDragAfterElement(container, y) {
+        const draggableElements = [...container.querySelectorAll('.card:not(.dragging)')];
+        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
+
+        for (const child of draggableElements) {
+          const box = child.getBoundingClientRect();
+          const offset = y - box.top - box.height / 2;
+          if (offset < 0 && offset > closest.offset) {
+            closest = { offset, element: child };
+          }
+        }
+        return closest.element;
+      }
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        card.classList.add('dragging');
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.id);
+        }
+      });
+
+      board.addEventListener('dragend', (e) => {
+        const card = e.target.closest('.card');
+        if (card) {
+          card.classList.remove('dragging');
+        }
+        draggedCard = null;
+        for (const col of columns) {
+          col.classList.remove('drag-over');
+        }
+      });
+
+      for (const col of columns) {
+        col.addEventListener('dragover', (e) => {
+          e.preventDefault();
+          if (e.dataTransfer) {
+            e.dataTransfer.dropEffect = 'move';
+          }
+          col.classList.add('drag-over');
+        });
+
+        col.addEventListener('dragleave', (e) => {
+          if (!col.contains(e.relatedTarget)) {
+            col.classList.remove('drag-over');
+          }
+        });
+
+        col.addEventListener('drop', (e) => {
+          e.preventDefault();
+          col.classList.remove('drag-over');
+          const cardId = e.dataTransfer?.getData('text/plain');
+          const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+          if (!card) return;
+
+          const targetList = col.querySelector('.column-cards') || col;
+          const afterElement = getDragAfterElement(targetList, e.clientY);
+          moveItemToColumn(card, col, afterElement);
+        });
+      }
+
+      // Click handler for quick advance/complete button
+      board.addEventListener('click', (e) => {
+        const moveBtn = e.target.closest('.btn-move');
+        if (!moveBtn) return;
+
+        const card = moveBtn.closest('.card');
+        const currentCol = moveBtn.closest('.board-column');
+        if (!card || !currentCol) return;
+
+        const currentIndex = statusOrder.indexOf(currentCol.dataset.status);
+        if (currentIndex < statusOrder.length - 1) {
+          const nextStatus = statusOrder[currentIndex + 1];
+          const nextCol = document.getElementById(nextStatus);
+          moveItemToColumn(card, nextCol);
+        } else {
+          // Completed from Ready column
+          const title = card.querySelector('h3')?.textContent || 'Order';
+          card.remove();
+          updateColumnCounts();
+          if (announcer) {
+            announcer.textContent = `Completed and removed ${title}`;
+          }
+        }
+      });
+
+      function createOrderCard(drink, orderNum) {
+        const article = document.createElement('article');
+        article.className = 'card';
+        article.id = `order-${orderNum}`;
+        article.draggable = true;
+        article.dataset.orderId = String(orderNum);
+
+        article.innerHTML = `
+          <div class="card-meta">
+            <span>#${orderNum} &bull; Counter</span>
+            <span>Just now</span>
+          </div>
+          <h3>${drink.name}</h3>
+          <p>${drink.notes}</p>
+          <div class="card-actions">
+            <a href="${drink.link}" class="btn" style="margin-top: 0; padding: 5px 10px; font-size: 0.78rem;">View Details</a>
+            <button type="button" class="btn-move" data-advance="order-${orderNum}">Advance &rarr;</button>
+          </div>
+        `;
+        return article;
+      }
+
+      document.getElementById('add-order-btn')?.addEventListener('click', () => {
+        const drink = sampleDrinks[nextOrderNumber % sampleDrinks.length];
+        const card = createOrderCard(drink, nextOrderNumber++);
+        const queuedCol = document.getElementById('queued');
+        moveItemToColumn(card, queuedCol);
+      });
+
+      document.getElementById('bulk-orders-btn')?.addEventListener('click', async () => {
+        const totalToCreate = 50;
+        for (let i = 0; i < totalToCreate; i++) {
+          const drink = sampleDrinks[nextOrderNumber % sampleDrinks.length];
+          const targetStatus = statusOrder[i % statusOrder.length];
+          const targetCol = document.getElementById(targetStatus);
+          const targetList = targetCol.querySelector('.column-cards') || targetCol;
+          const card = createOrderCard(drink, nextOrderNumber++);
+          updateCardButtonLabel(card, targetStatus);
+          targetList.appendChild(card);
+
+          if ((i + 1) % 25 === 0 && 'scheduler' in window && 'yield' in scheduler) {
+            await scheduler.yield();
+          }
+        }
+        updateColumnCounts();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
