+  <script>
+    const COFFEE_DETAILS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        price: '$5.50',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with our signature double-shot espresso and finished with a light dusting of warm cinnamon.',
+        notes: 'Toasted oats, rich maple, warm spice',
+        ingredients: 'Double-shot espresso, steamed barista oat milk, pure Grade-A Vermont maple syrup, ground cinnamon (16 oz)'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        price: '$3.75',
+        description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches to bring out deep caramelized sugars and a velvety crema.',
+        notes: 'Dark chocolate, roasted walnut, smoky cedar',
+        ingredients: '100% single-origin Sumatra & Colombia dark-roasted Arabica beans, freshly pulled double shot (2 oz)'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        price: '$4.75',
+        description: 'Steeped for 18 hours in cold filtered water for maximum smoothness and naturally sweet, low-acid flavor served over artisanal ice.',
+        notes: 'Sweet cocoa, molasses, smooth clean finish',
+        ingredients: 'Coarse-ground Ethiopian & Guatemalan blend, cold-steeped 18 hours, triple-filtered water (16 oz)'
+      }
+    };
+
+    const modal = document.getElementById('coffee-details-modal');
+    const modalTitle = document.getElementById('modal-title');
+    const modalPrice = document.getElementById('modal-price');
+    const modalDescription = document.getElementById('modal-description');
+    const modalNotes = document.getElementById('modal-notes');
+    const modalIngredients = document.getElementById('modal-ingredients');
+
+    document.querySelectorAll('[data-coffee]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const coffeeKey = button.getAttribute('data-coffee');
+        const details = COFFEE_DETAILS[coffeeKey];
+        if (!details) return;
+
+        modalTitle.textContent = details.title;
+        modalPrice.textContent = details.price;
+        modalDescription.textContent = details.description;
+        modalNotes.textContent = details.notes;
+        modalIngredients.textContent = details.ingredients;
+
+        modal.showModal();
+      });
+    });
+
+    modal.addEventListener('click', (event) => {
+      if (event.target === modal) {
+        modal.close();
+      }
+    });
+  </script>
