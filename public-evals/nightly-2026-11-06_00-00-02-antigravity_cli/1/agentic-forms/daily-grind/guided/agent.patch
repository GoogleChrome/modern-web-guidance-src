+    function validateField(input) {
+      input.setCustomValidity('');
+      const value = input.value.trim();
+
+      if (value.length > 50) {
+        input.setCustomValidity('Keyword must be 50 characters or fewer.');
+      } else if (value && !/^[A-Za-z0-9\s,\-&']*$/.test(value)) {
+        input.setCustomValidity('Please use only letters, numbers, spaces, commas, or hyphens.');
+      }
+
+      if (!input.checkValidity()) {
+        queryError.textContent = input.validationMessage;
+        queryError.hidden = false;
+        return { field: input.name, message: input.validationMessage };
+      }
+
+      queryError.textContent = '';
+      queryError.hidden = true;
+      return null;
+    }
+
+    function validateCoffeeForm() {
