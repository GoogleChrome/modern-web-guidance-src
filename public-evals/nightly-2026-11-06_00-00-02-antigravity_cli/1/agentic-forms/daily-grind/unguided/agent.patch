+  <script>
+    (function () {
+      const form = document.getElementById('coffee-order-form');
+      const drinkSelect = document.getElementById('drink');
+      const sizeSelect = document.getElementById('size');
+      const tempSelect = document.getElementById('temperature');
+      const milkSelect = document.getElementById('milk');
+      const sweetnessSelect = document.getElementById('sweetness');
+      const extraShotsInput = document.getElementById('extra_shots');
+      const customerNameInput = document.getElementById('customer_name');
+      const notesInput = document.getElementById('notes');
+      const totalPriceEl = document.getElementById('total-price');
+      const drinkSummaryEl = document.getElementById('drink-summary');
+      const orderResultEl = document.getElementById('order-result');
+
+      const DRINK_PRICES = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', price: 5.50 },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', price: 3.75 },
+        'cold-brew': { name: '18-Hour Cold Brew', price: 4.75 },
+        'caramel-macchiato': { name: 'Caramel Macchiato', price: 5.25 },
+        'cappuccino': { name: 'Classic Cappuccino', price: 4.50 },
+        'pour-over': { name: 'Single-Origin Pour Over', price: 4.25 },
+        'matcha-latte': { name: 'Ceremonial Matcha Latte', price: 5.50 }
+      };
+
+      const PRESETS = {
+        'cozy-sweet': {
+          drink: 'maple-oat-latte',
+          size: 'medium',
+          temperature: 'hot',
+          milk: 'oat',
+          sweetness: 'maple',
+          extra_shots: 0
+        },
+        'morning-boost': {
+          drink: 'dark-roast-espresso',
+          size: 'medium',
+          temperature: 'hot',
+          milk: 'none',
+          sweetness: 'unsweetened',
+          extra_shots: 1
+        },
+        'smooth-chilled': {
+          drink: 'cold-brew',
+          size: 'large',
+          temperature: 'iced',
+          milk: 'oat',
+          sweetness: 'half-sweet',
+          extra_shots: 0
+        },
+        'earthy-zen': {
+          drink: 'matcha-latte',
+          size: 'medium',
+          temperature: 'iced',
+          milk: 'oat',
+          sweetness: 'standard',
+          extra_shots: 0
+        }
+      };
+
+      function calculateOrder() {
+        const drinkInfo = DRINK_PRICES[drinkSelect.value] || { name: drinkSelect.value, price: 4.50 };
+        const size = sizeSelect.value;
+        const sizeUpcharge = size === 'large' ? 0.75 : (size === 'small' ? -0.50 : 0);
+        const shots = Math.max(0, Math.min(4, parseInt(extraShotsInput.value || '0', 10) || 0));
+        const total = Math.max(2.50, drinkInfo.price + sizeUpcharge + shots * 1.00);
+
+        const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+        const tempLabel = tempSelect.value === 'iced' ? 'Iced' : 'Hot';
+        const milkOption = milkSelect.options[milkSelect.selectedIndex];
+        const milkLabel = milkSelect.value === 'none' ? 'Black' : 'with ' + (milkOption ? milkOption.text : milkSelect.value);
+
+        totalPriceEl.textContent = '$' + total.toFixed(2);
+        drinkSummaryEl.textContent =
+          sizeLabel + ' ' + tempLabel + ' ' + drinkInfo.name + ' (' + milkLabel + (shots > 0 ? ', +' + shots + ' shot' + (shots > 1 ? 's' : '') : '') + ')';
+
+        return {
+          drinkId: drinkSelect.value,
+          drinkName: drinkInfo.name,
+          size: size,
+          temperature: tempSelect.value,
+          milk: milkSelect.value,
+          sweetness: sweetnessSelect.value,
+          extraShots: shots,
+          customerName: (customerNameInput.value || 'Guest').trim(),
+          notes: (notesInput.value || '').trim(),
+          totalPrice: '$' + total.toFixed(2)
+        };
+      }
+
+      form.addEventListener('input', calculateOrder);
+      form.addEventListener('change', calculateOrder);
+
+      // Preset finder chips
+      document.querySelectorAll('.finder-chip').forEach((chip) => {
+        chip.addEventListener('click', () => {
+          const preset = PRESETS[chip.dataset.preset];
+          if (!preset) return;
+          document.querySelectorAll('.finder-chip').forEach((c) => c.classList.remove('active'));
+          chip.classList.add('active');
+
+          drinkSelect.value = preset.drink;
+          sizeSelect.value = preset.size;
+          tempSelect.value = preset.temperature;
+          milkSelect.value = preset.milk;
+          sweetnessSelect.value = preset.sweetness;
+          extraShotsInput.value = String(preset.extra_shots);
+          calculateOrder();
+        });
+      });
+
+      // Quick-select buttons on Seasonal Favorites cards
+      document.querySelectorAll('[data-select-drink]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const targetDrink = btn.getAttribute('data-select-drink');
+          if (targetDrink && DRINK_PRICES[targetDrink]) {
+            drinkSelect.value = targetDrink;
+            if (targetDrink === 'cold-brew') {
+              tempSelect.value = 'iced';
+            }
+            calculateOrder();
+          }
+        });
+      });
+
+      // Listen for WebMCP Declarative Tool lifecycle events
+      const modelCtxTargets = [window, document, document.modelContext, navigator.modelContext].filter(Boolean);
+      modelCtxTargets.forEach((target) => {
+        if (typeof target.addEventListener === 'function') {
+          target.addEventListener('toolactivated', (event) => {
+            if (!event.toolName || event.toolName === 'order_coffee') {
+              form.classList.add('agent-active');
+              calculateOrder();
+            }
+          });
+          target.addEventListener('toolcancel', (event) => {
+            if (!event.toolName || event.toolName === 'order_coffee') {
+              form.classList.remove('agent-active');
+            }
+          });
+        }
+      });
+
+      // Handle form submission for both human users and AI agents
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        form.classList.remove('agent-active');
+
+        const summary = calculateOrder();
+        const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+        const confirmationPayload = {
+          status: 'confirmed',
+          orderId: orderId,
+          customerName: summary.customerName,
+          item: summary.drinkName,
+          size: summary.size,
+          temperature: summary.temperature,
+          milk: summary.milk,
+          sweetness: summary.sweetness,
+          extraShots: summary.extraShots,
+          notes: summary.notes || 'None',
+          total: summary.totalPrice,
+          estimatedPickupMinutes: 5,
+          message:
+            'Order ' +
+            orderId +
+            ' confirmed for ' +
+            summary.customerName +
+            ': ' +
+            summary.size +
+            ' ' +
+            summary.temperature +
+            ' ' +
+            summary.drinkName +
+            ' (' +
+            summary.totalPrice +
+            '). Ready for pickup in ~5 minutes.'
+        };
+
+        orderResultEl.innerHTML =
+          '<h3>Order Confirmed! (' +
+          confirmationPayload.orderId +
+          ')</h3>' +
+          '<p>Thanks, <strong>' +
+          summary.customerName.replace(/[<>&"']/g, '') +
+          '</strong>! We are preparing your handcrafted beverage now.</p>' +
+          '<ul class="order-result-details">' +
+          '<li><strong>Beverage:</strong> ' +
+          summary.size +
+          ' ' +
+          summary.temperature +
+          ' ' +
+          summary.drinkName +
+          '</li>' +
+          '<li><strong>Customizations:</strong> Milk: ' +
+          summary.milk +
+          ', Sweetness: ' +
+          summary.sweetness +
+          ', Extra Shots: ' +
+          summary.extraShots +
+          '</li>' +
+          (summary.notes ? '<li><strong>Notes:</strong> ' + summary.notes.replace(/[<>&"']/g, '') + '</li>' : '') +
+          '<li><strong>Total Due at Pickup:</strong> ' +
+          summary.totalPrice +
+          ' (Ready in ~5 mins)</li>' +
+          '</ul>';
+        orderResultEl.classList.add('visible');
+
+        // Return structured tool response when submitted by a browser AI agent (WebMCP)
+        if (typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(confirmationPayload));
+        }
+      });
+
+      calculateOrder();
+    })();
+  </script>
 </body>
 
 </html>
