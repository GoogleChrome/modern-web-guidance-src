+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const OLD_ORIGIN = 'https://old-app.dailygrind.example.com';
+      const NEW_ORIGIN = 'https://new-app.dailygrind.example.com';
+      const ALLOWED_ORIGINS = new Set([OLD_ORIGIN, NEW_ORIGIN, window.location.origin]);
+
+      const drinkSelect = document.getElementById('pref-drink');
+      const milkSelect = document.getElementById('pref-milk');
+      const prefsSummary = document.getElementById('prefs-summary');
+      const migrationLink = document.getElementById('migration-link');
+      const migrationBanner = document.getElementById('migration-banner');
+      const dismissBtn = document.getElementById('dismiss-migration-banner');
+      const syncBtn = document.getElementById('sync-config-btn');
+
+      function loadConfig() {
+        try {
+          const urlParams = new URLSearchParams(window.location.search);
+          const migratedConfigParam = urlParams.get('migrated_config');
+          if (migratedConfigParam) {
+            const parsedFromUrl = JSON.parse(atob(migratedConfigParam));
+            if (parsedFromUrl && typeof parsedFromUrl === 'object') {
+              localStorage.setItem(STORAGE_KEY, JSON.stringify(parsedFromUrl));
+              const cleanUrl = new URL(window.location.href);
+              cleanUrl.searchParams.delete('migrated_config');
+              window.history.replaceState({}, document.title, cleanUrl.toString());
+            }
+          }
+
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            return JSON.parse(raw);
+          }
+        } catch (err) {
+          console.warn('Unable to read stored configuration:', err);
+        }
+        return {
+          favoriteDrink: 'Maple Oat Latte',
+          milkPreference: 'Oat Milk',
+          updatedAt: new Date().toISOString()
+        };
+      }
+
+      function saveConfig(config) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+        } catch (err) {
+          console.warn('Unable to save configuration:', err);
+        }
+        renderConfig(config);
+      }
+
+      function renderConfig(config) {
+        if (drinkSelect && config.favoriteDrink) {
+          drinkSelect.value = config.favoriteDrink;
+        }
+        if (milkSelect && config.milkPreference) {
+          milkSelect.value = config.milkPreference;
+        }
+        if (prefsSummary) {
+          prefsSummary.textContent = `${config.favoriteDrink} \u2022 ${config.milkPreference}`;
+        }
+        if (migrationLink) {
+          try {
+            const targetUrl = new URL('/index.html', NEW_ORIGIN);
+            const encoded = btoa(JSON.stringify(config));
+            targetUrl.searchParams.set('migrated_config', encoded);
+            migrationLink.href = targetUrl.toString();
+          } catch (_) {
+            // Fallback to static href
+          }
+        }
+      }
+
+      const currentConfig = loadConfig();
+      renderConfig(currentConfig);
+
+      function updateFromControls() {
+        const updated = {
+          favoriteDrink: drinkSelect.value,
+          milkPreference: milkSelect.value,
+          updatedAt: new Date().toISOString()
+        };
+        saveConfig(updated);
+      }
+
+      drinkSelect.addEventListener('change', updateFromControls);
+      milkSelect.addEventListener('change', updateFromControls);
+
+      if (dismissBtn && migrationBanner) {
+        dismissBtn.addEventListener('click', () => {
+          migrationBanner.hidden = true;
+        });
+      }
+
+      // Cross-origin configuration handoff via postMessage because Web App Origin Migration
+      // only transfers the OS installation (shortcuts/icons) and does NOT transfer LocalStorage/IndexedDB.
+      window.addEventListener('message', (event) => {
+        if (!ALLOWED_ORIGINS.has(event.origin)) return;
+        const data = event.data;
+        if (!data || typeof data !== 'object') return;
+
+        if (data.type === 'DAILY_GRIND_REQUEST_CONFIG') {
+          const cfg = loadConfig();
+          event.source?.postMessage(
+            { type: 'DAILY_GRIND_CONFIG_PAYLOAD', config: cfg },
+            event.origin
+          );
+        } else if (data.type === 'DAILY_GRIND_CONFIG_PAYLOAD' && data.config) {
+          saveConfig(data.config);
+        }
+      });
+
+      if (syncBtn) {
+        syncBtn.addEventListener('click', () => {
+          const cfg = loadConfig();
+          saveConfig(cfg);
+          if (window.opener && window.opener !== window) {
+            window.opener.postMessage(
+              { type: 'DAILY_GRIND_CONFIG_PAYLOAD', config: cfg },
+              NEW_ORIGIN
+            );
+          }
+          prefsSummary.textContent = `${cfg.favoriteDrink} \u2022 ${cfg.milkPreference} (Synced)`;
+        });
+      }
+    })();
+  </script>
 </body>
 
