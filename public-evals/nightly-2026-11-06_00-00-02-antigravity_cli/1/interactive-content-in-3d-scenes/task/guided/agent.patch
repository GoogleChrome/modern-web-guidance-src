+       -0.5,  0.5, -0.5,   0, 1, 0,    0, 0,   0.55, 0.38, 0.26,
+
+        // Bottom face (y = -0.5) - Deep espresso
+       -0.5, -0.5, -0.5,   0, -1, 0,   0, 1,   0.22, 0.14, 0.12,
+        0.5, -0.5, -0.5,   0, -1, 0,   1, 1,   0.22, 0.14, 0.12,
+        0.5, -0.5,  0.5,   0, -1, 0,   1, 0,   0.22, 0.14, 0.12,
+       -0.5, -0.5, -0.5,   0, -1, 0,   0, 1,   0.22, 0.14, 0.12,
+        0.5, -0.5,  0.5,   0, -1, 0,   1, 0,   0.22, 0.14, 0.12,
+       -0.5, -0.5,  0.5,   0, -1, 0,   0, 0,   0.22, 0.14, 0.12,
+
+        // Right face (x = 0.5) - Cinnamon kraft
+        0.5, -0.5,  0.5,   1, 0, 0,    0, 1,   0.46, 0.31, 0.24,
+        0.5, -0.5, -0.5,   1, 0, 0,    1, 1,   0.46, 0.31, 0.24,
+        0.5,  0.5, -0.5,   1, 0, 0,    1, 0,   0.46, 0.31, 0.24,
+        0.5, -0.5,  0.5,   1, 0, 0,    0, 1,   0.46, 0.31, 0.24,
+        0.5,  0.5, -0.5,   1, 0, 0,    1, 0,   0.46, 0.31, 0.24,
+        0.5,  0.5,  0.5,   1, 0, 0,    0, 0,   0.46, 0.31, 0.24,
+
+        // Left face (x = -0.5) - Cinnamon kraft
+       -0.5, -0.5, -0.5,  -1, 0, 0,    0, 1,   0.46, 0.31, 0.24,
+       -0.5, -0.5,  0.5,  -1, 0, 0,    1, 1,   0.46, 0.31, 0.24,
+       -0.5,  0.5,  0.5,  -1, 0, 0,    1, 0,   0.46, 0.31, 0.24,
+       -0.5, -0.5, -0.5,  -1, 0, 0,    0, 1,   0.46, 0.31, 0.24,
+       -0.5,  0.5,  0.5,  -1, 0, 0,    1, 0,   0.46, 0.31, 0.24,
+       -0.5,  0.5, -0.5,  -1, 0, 0,    0, 0,   0.46, 0.31, 0.24,
+      ]);
+
+      // Front quad spanning -0.5 to 0.5 in X and Y at Z = 0 (transformed by htmlElementMVP)
+      const frontQuadVertices = new Float32Array([
+       -0.5, -0.5,  0.0,   0, 0, 1,    0, 1,   0.98, 0.96, 0.92,
+        0.5, -0.5,  0.0,   0, 0, 1,    1, 1,   0.98, 0.96, 0.92,
+        0.5,  0.5,  0.0,   0, 0, 1,    1, 0,   0.98, 0.96, 0.92,
+       -0.5, -0.5,  0.0,   0, 0, 1,    0, 1,   0.98, 0.96, 0.92,
+        0.5,  0.5,  0.0,   0, 0, 1,    1, 0,   0.98, 0.96, 0.92,
+       -0.5,  0.5,  0.0,   0, 0, 1,    0, 0,   0.98, 0.96, 0.92,
+      ]);
+
+      function createVAO(glCtx, data) {
+        const vao = glCtx.createVertexArray();
+        glCtx.bindVertexArray(vao);
+        const vbo = glCtx.createBuffer();
+        glCtx.bindBuffer(glCtx.ARRAY_BUFFER, vbo);
+        glCtx.bufferData(glCtx.ARRAY_BUFFER, data, glCtx.STATIC_DRAW);
+        const stride = 11 * 4;
+        glCtx.enableVertexAttribArray(0);
+        glCtx.vertexAttribPointer(0, 3, glCtx.FLOAT, false, stride, 0);
+        glCtx.enableVertexAttribArray(1);
+        glCtx.vertexAttribPointer(1, 3, glCtx.FLOAT, false, stride, 3 * 4);
+        glCtx.enableVertexAttribArray(2);
+        glCtx.vertexAttribPointer(2, 2, glCtx.FLOAT, false, stride, 6 * 4);
+        glCtx.enableVertexAttribArray(3);
+        glCtx.vertexAttribPointer(3, 3, glCtx.FLOAT, false, stride, 8 * 4);
+        glCtx.bindVertexArray(null);
+        return vao;
+      }
+
+      const boxVAO = createVAO(gl, boxVertices);
+      const frontQuadVAO = createVAO(gl, frontQuadVertices);
+
+      // Setup WebGL texture for HTML-in-Canvas
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      const textureState = { width: 0, height: 0 };
+
+      // Perspective Matrix helper
+      function createPerspectiveMatrix(fovRad, aspect, near, far) {
+        const f = 1.0 / Math.tan(fovRad / 2);
+        const nf = 1 / (near - far);
+        return new DOMMatrix([
+          f / aspect, 0, 0, 0,
+          0, f, 0, 0,
+          0, 0, (far + near) * nf, -1,
+          0, 0, (2 * far * near) * nf, 0
+        ]);
+      }
+
+      // Coffee box dimensions: 1.55 wide, 1.95 tall, 0.85 deep
+      const boxWidth = 1.55;
+      const boxHeight = 1.95;
+      const boxDepth = 0.85;
+
+      let isSpinning = true;
+      let startTime = performance.now();
+      let pausedElapsed = 0;
+
+      toggleSpinBtn.addEventListener('click', () => {
+        if (isSpinning) {
+          pausedElapsed = performance.now() - startTime;
+          isSpinning = false;
+          toggleSpinBtn.textContent = 'Resume Rotation';
+          toggleSpinBtn.setAttribute('aria-pressed', 'true');
+        } else {
+          startTime = performance.now() - pausedElapsed;
+          isSpinning = true;
+          toggleSpinBtn.textContent = 'Pause Rotation';
+          toggleSpinBtn.setAttribute('aria-pressed', 'false');
+        }
+      });
+
+      centerBoxBtn.addEventListener('click', () => {
+        pausedElapsed = 0;
+        startTime = performance.now();
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      });
+
+      function renderScene(timeMs) {
+        const elapsedSec = (isSpinning ? (timeMs - startTime) : pausedElapsed) * 0.001;
+        // Oscillating 3D spin so the coffee box continuously rotates in 3D while keeping the front label accessible
+        const angleY = Math.sin(elapsedSec * 0.85) * 32; // degrees (-32deg to +32deg)
+        const angleX = Math.cos(elapsedSec * 0.6) * 8 - 3; // subtle 3D pitch
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0.11, 0.06, 0.05, 1.0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+
+        const aspect = (canvas.clientWidth || 500) / (canvas.clientHeight || 500);
+        const projMatrix = createPerspectiveMatrix((42 * Math.PI) / 180, aspect, 0.1, 100.0);
+        const viewMatrix = new DOMMatrix().translate(0, 0, -3.55);
+
+        // Base rigid rotation for the coffee box
+        const boxRotation = new DOMMatrix()
+          .rotate(angleX, angleY, 0);
+
+        // Model matrix for the 5 coffee box sides
+        const boxModelMatrix = new DOMMatrix()
+          .multiply(boxRotation)
+          .scale(boxWidth, boxHeight, boxDepth);
+
+        const boxMVP = projMatrix
+          .multiply(viewMatrix)
+          .multiply(boxModelMatrix);
+
+        // Model matrix for the front face (where the interactive HTML form is projected)
+        // Translates to z = +boxDepth / 2 and scales the -0.5..0.5 quad to boxWidth x boxHeight
+        const frontFaceModelMatrix = new DOMMatrix()
+          .multiply(boxRotation)
+          .translate(0, 0, boxDepth / 2)
+          .scale(boxWidth, boxHeight, 1);
+
+        const htmlElementMVP = projMatrix
+          .multiply(viewMatrix)
+          .multiply(frontFaceModelMatrix)
+          .toFloat32Array();
+
+        gl.useProgram(program);
+
+        // Draw 5 sides of the coffee box
+        gl.uniformMatrix4fv(uMVPLoc, false, boxMVP.toFloat32Array());
+        gl.uniformMatrix4fv(uModelLoc, false, boxModelMatrix.toFloat32Array());
+        gl.uniform1i(uUseTextureLoc, 0);
+        gl.bindVertexArray(boxVAO);
+        gl.drawArrays(gl.TRIANGLES, 0, 30);
+
+        // Draw front face with the uploaded HTML form texture
+        gl.uniformMatrix4fv(uMVPLoc, false, htmlElementMVP);
+        gl.uniformMatrix4fv(uModelLoc, false, frontFaceModelMatrix.toFloat32Array());
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniform1i(uTextureLoc, 0);
+        gl.uniform1i(uUseTextureLoc, textureState.width > 0 ? 1 : 0);
+        gl.bindVertexArray(frontQuadVAO);
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+        gl.bindVertexArray(null);
+
+        return htmlElementMVP;
+      }
+
+      if (supportsHtmlInCanvas) {
+        let initialUploadDone = false;
+
+        canvas.onpaint = (event) => {
+          // 1. Update texture with HTML content when descendant elements changed or on first upload
+          const hasChangedElements =
+            !event ||
+            !event.changedElements ||
+            event.changedElements.length > 0 ||
+            !initialUploadDone;
+
+          if (hasChangedElements) {
+            try {
+              const uploaded = uploadElementWebGL(gl, canvas, texture, uiElement, textureState);
+              if (uploaded) {
+                initialUploadDone = true;
+              }
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+
+          // Render the 3D coffee box scene and compute htmlElementMVP
+          const htmlElementMVP = renderScene(performance.now());
+
+          // 2. Sync DOM position, hit testing, and accessibility bounds with 3D scene
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+          });
+        };
+
+        function render() {
+          // Request to update the canvas in the animation loop
+          canvas.requestPaint();
+          requestAnimationFrame(render);
+        }
+        requestAnimationFrame(render);
+      } else {
+        // Fallback animation loop when HTML-in-Canvas is not supported
+        function fallbackLoop(now) {
+          renderScene(now);
+          requestAnimationFrame(fallbackLoop);
+        }
+        requestAnimationFrame(fallbackLoop);
+      }
+    })();
+  </script>
