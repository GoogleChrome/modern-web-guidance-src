+  <script>
+    (function () {
+      const brewProfiles = {
+        1: {
+          name: 'Mild',
+          title: 'Light & Delicate Profile',
+          tasting: 'Bright floral aroma with crisp citrus acidity and a clean, tea-like finish.',
+          ratio: 'Ratio: 1:18',
+          caffeine: '~95mg Caffeine'
+        },
+        2: {
+          name: 'Smooth',
+          title: 'Smooth Morning Profile',
+          tasting: 'Mellow sweetness with hints of honey, golden raisin, and soft vanilla.',
+          ratio: 'Ratio: 1:17',
+          caffeine: '~120mg Caffeine'
+        },
+        3: {
+          name: 'Medium',
+          title: 'Medium Roast Profile',
+          tasting: 'Balanced body with warm caramel, milk chocolate, and toasted hazelnut notes.',
+          ratio: 'Ratio: 1:16',
+          caffeine: '~145mg Caffeine'
+        },
+        4: {
+          name: 'Bold',
+          title: 'Bold & Rich Profile',
+          tasting: 'Full-bodied extraction with dark cocoa, roasted almond, and lingering spice.',
+          ratio: 'Ratio: 1:14',
+          caffeine: '~175mg Caffeine'
+        },
+        5: {
+          name: 'Extra Strong',
+          title: 'Double-Shot Espresso Roast Profile',
+          tasting: 'Intense velvety crema with bittersweet dark chocolate and smokey molasses.',
+          ratio: 'Ratio: 1:12',
+          caffeine: '~210mg Caffeine'
+        }
+      };
+
+      const slider = document.getElementById('brew-strength-slider');
+      const labelEl = document.getElementById('brew-strength-label');
+      const titleEl = document.getElementById('brew-profile-title');
+      const tastingEl = document.getElementById('brew-profile-tasting');
+      const ratioEl = document.getElementById('brew-profile-ratio');
+      const caffeineEl = document.getElementById('brew-profile-caffeine');
+      const ticks = document.querySelectorAll('.brew-tick');
+
+      if (!slider) return;
+
+      function updateBrewStrength(val) {
+        const min = Number(slider.min) || 1;
+        const max = Number(slider.max) || 5;
+        const numericVal = Math.min(max, Math.max(min, Number(val) || 3));
+        const percent = ((numericVal - min) / (max - min)) * 100;
+
+        slider.style.setProperty('--fill-percent', percent + '%');
+
+        const profile = brewProfiles[numericVal] || brewProfiles[3];
+        const valueText = 'Level ' + numericVal + ': ' + profile.name + ' — ' + profile.tasting;
+
+        slider.setAttribute('aria-valuenow', String(numericVal));
+        slider.setAttribute('aria-valuetext', valueText);
+
+        if (labelEl) {
+          labelEl.textContent = profile.name + ' (Level ' + numericVal + ' of ' + max + ')';
+        }
+        if (titleEl) titleEl.textContent = profile.title;
+        if (tastingEl) tastingEl.textContent = profile.tasting;
+        if (ratioEl) ratioEl.textContent = profile.ratio;
+        if (caffeineEl) caffeineEl.textContent = profile.caffeine;
+
+        ticks.forEach(function (tick) {
+          const tickVal = Number(tick.getAttribute('data-value'));
+          tick.classList.toggle('active', tickVal === numericVal);
+        });
+      }
+
+      slider.addEventListener('input', function (e) {
+        updateBrewStrength(e.target.value);
+      });
+
+      slider.addEventListener('change', function (e) {
+        updateBrewStrength(e.target.value);
+      });
+
+      ticks.forEach(function (tick) {
+        tick.addEventListener('click', function () {
+          const targetVal = tick.getAttribute('data-value');
+          if (targetVal) {
+            slider.value = targetVal;
+            updateBrewStrength(targetVal);
+            slider.focus();
+          }
+        });
+      });
+
+      updateBrewStrength(slider.value);
+    })();
+  </script>
 </body>
 
