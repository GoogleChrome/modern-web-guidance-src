+  <script>
+    const slider = document.querySelector('#brew-strength-slider');
+    const output = document.querySelector('#brew-strength-output');
+
+    const brewProfiles = {
+      1: { label: 'Light (1 / 5) — Bright & Floral', aria: 'Light (1 of 5) — Bright & Floral' },
+      2: { label: 'Mild (2 / 5) — Mellow & Citrusy', aria: 'Mild (2 of 5) — Mellow & Citrusy' },
+      3: { label: 'Medium (3 / 5) — Balanced & Smooth', aria: 'Medium (3 of 5) — Balanced & Smooth' },
+      4: { label: 'Bold (4 / 5) — Rich & Caramelized', aria: 'Bold (4 of 5) — Rich & Caramelized' },
+      5: { label: 'Extra Strong (5 / 5) — Intense & Smokey', aria: 'Extra Strong (5 of 5) — Intense & Smokey' }
+    };
+
+    function syncSliderValue() {
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 100);
+      slider.style.setProperty('--control-value', slider.value);
+
+      const profile = brewProfiles[slider.value];
+      if (profile) {
+        output.textContent = profile.label;
+        slider.setAttribute('aria-valuetext', profile.aria);
+      }
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
