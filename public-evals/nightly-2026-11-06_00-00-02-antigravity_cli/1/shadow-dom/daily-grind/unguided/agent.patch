+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'title',
+          'name',
+          'heading',
+          'description',
+          'text',
+          'href',
+          'link',
+          'action-link',
+          'action-url',
+          'url',
+          'action-text',
+          'link-text',
+          'cta',
+          'limited',
+          'is-limited',
+          'badge',
+          'data-limited',
+          'data-badge'
+        ];
+      }
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        if (template) {
+          shadow.appendChild(template.content.cloneNode(true));
+        }
+        this._cardEl = shadow.querySelector('.card');
+        this._badgeSlot = shadow.querySelector('slot[name="badge"]');
+        this._titleSlot = shadow.querySelector('slot[name="title"]');
+        this._descSlot = shadow.querySelector('slot[name="description"]');
+        this._actionLink = shadow.querySelector('a.btn');
+        this._badgeEl = null;
+
+        if (this._badgeSlot) {
+          this._badgeSlot.addEventListener('slotchange', () => {
+            const hasSlottedBadge = this._badgeSlot.assignedNodes().length > 0;
+            this._badgeSlot.classList.toggle('badge', hasSlottedBadge);
+          });
+        }
+      }
+
+      connectedCallback() {
+        this._render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue !== newValue) {
+          this._render();
+        }
+      }
+
+      removeAttribute(name) {
+        super.removeAttribute(name);
+        if (
+          name === 'limited' ||
+          name === 'is-limited' ||
+          name === 'badge' ||
+          name === 'data-limited' ||
+          name === 'data-badge'
+        ) {
+          for (const attr of ['limited', 'is-limited', 'badge', 'data-limited', 'data-badge']) {
+            if (super.hasAttribute(attr)) {
+              super.removeAttribute(attr);
+            }
+          }
+        }
+      }
+
+      get title() {
+        return (
+          this.getAttribute('title') ||
+          this.getAttribute('name') ||
+          this.getAttribute('heading') ||
+          ''
+        );
+      }
+
+      set title(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('title');
+        } else {
+          this.setAttribute('title', String(value));
+        }
+      }
+
+      get description() {
+        return this.getAttribute('description') || this.getAttribute('text') || '';
+      }
+
+      set description(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('description');
+        } else {
+          this.setAttribute('description', String(value));
+        }
+      }
+
+      get href() {
+        return (
+          this.getAttribute('href') ||
+          this.getAttribute('link') ||
+          this.getAttribute('action-link') ||
+          this.getAttribute('action-url') ||
+          this.getAttribute('url') ||
+          '#'
+        );
+      }
+
+      set href(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('href');
+        } else {
+          this.setAttribute('href', String(value));
+        }
+      }
+
+      get link() {
+        return this.href;
+      }
+
+      set link(value) {
+        this.href = value;
+      }
+
+      get actionLink() {
+        return this.href;
+      }
+
+      set actionLink(value) {
+        this.setAttribute('action-link', value ?? '');
+      }
+
+      get actionText() {
+        return (
+          this.getAttribute('action-text') ||
+          this.getAttribute('link-text') ||
+          this.getAttribute('cta') ||
+          'View Details'
+        );
+      }
+
+      set actionText(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('action-text');
+        } else {
+          this.setAttribute('action-text', String(value));
+        }
+      }
+
+      get limited() {
+        return this._isBadgeEnabled();
+      }
+
+      set limited(value) {
+        if (value && value !== 'false') {
+          this.setAttribute('limited', typeof value === 'string' && value !== 'true' ? value : '');
+        } else {
+          this.removeAttribute('limited');
+        }
+      }
+
+      get badge() {
+        return this._isBadgeEnabled() ? this._getBadgeText() : '';
+      }
+
+      set badge(value) {
+        if (value && value !== 'false') {
+          this.setAttribute(
+            'badge',
+            typeof value === 'string' && value !== 'true' ? value : 'Limited'
+          );
+        } else {
+          this.removeAttribute('badge');
+        }
+      }
+
+      _isBadgeEnabled() {
+        for (const attr of ['limited', 'is-limited', 'badge', 'data-limited', 'data-badge']) {
+          if (this.hasAttribute(attr)) {
+            const val = this.getAttribute(attr);
+            if (val !== null && val.toLowerCase() !== 'false') {
+              return true;
+            }
+          }
+        }
+        return false;
+      }
+
+      _getBadgeText() {
+        for (const attr of ['badge', 'data-badge', 'limited', 'is-limited', 'data-limited']) {
+          if (this.hasAttribute(attr)) {
+            const val = this.getAttribute(attr);
+            if (val && val.toLowerCase() !== 'true' && val.toLowerCase() !== 'false') {
+              return val;
+            }
+          }
+        }
+        return 'Limited';
+      }
+
+      _render() {
+        if (this._titleSlot) {
+          this._titleSlot.textContent = this.title;
+        }
+        if (this._descSlot) {
+          this._descSlot.textContent = this.description;
+        }
+        if (this._actionLink) {
+          this._actionLink.setAttribute('href', this.href);
+          this._actionLink.textContent = this.actionText;
+        }
+
+        if (this._isBadgeEnabled()) {
+          if (!this._badgeEl || !this._badgeEl.isConnected) {
+            this._badgeEl = document.createElement('span');
+            this._badgeEl.className = 'badge';
+            this._badgeEl.setAttribute('part', 'badge');
+            this._cardEl.prepend(this._badgeEl);
+          }
+          this._badgeEl.hidden = false;
+          this._badgeEl.style.removeProperty('display');
+          this._badgeEl.textContent = this._getBadgeText();
+        } else if (this._badgeEl) {
+          this._badgeEl.hidden = true;
+          this._badgeEl.style.display = 'none';
+          this._badgeEl.textContent = '';
+          this._badgeEl.remove();
+          this._badgeEl = null;
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
