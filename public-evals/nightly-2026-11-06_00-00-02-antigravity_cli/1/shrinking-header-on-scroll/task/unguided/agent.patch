+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var scrollRange = 150;
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline', 'scroll()');
+      var supportsCustomProps =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('--scroll-progress', '0');
+
+      function updateNavOnScroll() {
+        var scrollY = window.scrollY !== undefined ? window.scrollY : (document.documentElement.scrollTop || document.body.scrollTop || 0);
+        var progress = Math.min(Math.max(scrollY / scrollRange, 0), 1);
+
+        nav.style.setProperty('--scroll-progress', progress.toFixed(4));
+
+        if (scrollY > 20) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        if (!supportsScrollTimeline && !supportsCustomProps) {
+          var padRem = 1 - 0.55 * progress;
+          nav.style.paddingTop = padRem + 'rem';
+          nav.style.paddingBottom = padRem + 'rem';
+        }
+      }
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      window.addEventListener('resize', updateNavOnScroll, { passive: true });
+      updateNavOnScroll();
+    })();
+  </script>
