+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      if (!form) return;
+
+      const progressEl = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const roastInput = document.getElementById('roast-level');
+      const roastValueText = document.getElementById('roast-level-value');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const freqRadios = form.querySelectorAll('input[name="delivery_frequency"]');
+
+      const roastNames = {
+        1: 'Light',
+        2: 'Medium-Light',
+        3: 'Medium',
+        4: 'Medium-Dark',
+        5: 'Dark'
+      };
+
+      let roastInteracted = true;
+
+      function updateFormState() {
+        const roastVal = roastInput.value;
+        const roastLabel = roastNames[roastVal] || 'Medium';
+        if (roastValueText) {
+          roastValueText.textContent = roastLabel + ' (' + roastVal + '/5)';
+        }
+
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        const hasFrequency = Array.from(freqRadios).some(r => r.checked);
+        if (hasFrequency) completedSteps += 1;
+        if (roastInteracted && roastVal) completedSteps += 1;
+        if (emailCheckbox && emailCheckbox.checked) completedSteps += 1;
+
+        const percentage = Math.round((completedSteps / totalSteps) * 100);
+        if (progressEl) {
+          progressEl.value = percentage;
+          progressEl.textContent = percentage + '%';
+        }
+        if (progressText) {
+          progressText.textContent = percentage + '%';
+        }
+      }
+
+      form.addEventListener('input', updateFormState);
+      form.addEventListener('change', updateFormState);
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (progressEl) {
+          progressEl.value = 100;
+          progressEl.textContent = '100%';
+        }
+        if (progressText) {
+          progressText.textContent = '100%';
+        }
+      });
+
+      updateFormState();
+    })();
+  </script>
