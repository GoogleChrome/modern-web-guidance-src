+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-level-output');
+      const progressEl = document.getElementById('subscription-progress');
+      const progressStatus = document.getElementById('progress-status');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const feedbackEl = document.getElementById('subscription-feedback');
+
+      const roastLabels = {
+        1: 'Light Roast',
+        2: 'Medium-Light Roast',
+        3: 'Medium Roast',
+        4: 'Medium-Dark Roast',
+        5: 'Dark Roast'
+      };
+
+      let roastTouched = false;
+
+      function updateSliderProgress() {
+        const min = Number(roastSlider.min) || 1;
+        const max = Number(roastSlider.max) || 5;
+        const val = Number(roastSlider.value) || 3;
+        const pct = ((val - min) / (max - min)) * 100;
+        roastSlider.style.setProperty('--progress', `${pct}%`);
+
+        const labelText = roastLabels[val] || 'Medium Roast';
+        roastOutput.textContent = `${labelText} (${val} / ${max})`;
+        roastSlider.setAttribute('aria-valuetext', `${labelText} (${val} out of ${max})`);
+      }
+
+      function updateCompletionProgress() {
+        const selectedFrequency = form.querySelector('input[name="delivery_frequency"]:checked');
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        if (selectedFrequency) completedSteps += 1;
+        if (roastSlider.value) completedSteps += 1;
+        if (emailCheckbox.checked || roastTouched) completedSteps += 1;
+
+        const percent = Math.round((completedSteps / totalSteps) * 100);
+        progressEl.value = percent;
+        progressEl.textContent = `${percent}%`;
+        progressStatus.textContent = `${percent}% Complete`;
+      }
+
+      roastSlider.addEventListener('input', () => {
+        roastTouched = true;
+        updateSliderProgress();
+        updateCompletionProgress();
+      });
+
+      form.addEventListener('change', () => {
+        updateCompletionProgress();
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        progressEl.value = 100;
+        progressEl.textContent = '100%';
+        progressStatus.textContent = '100% Complete';
+        const freq = form.querySelector('input[name="delivery_frequency"]:checked')?.value || 'weekly';
+        const roast = roastLabels[roastSlider.value] || 'Medium Roast';
+        feedbackEl.hidden = false;
+        feedbackEl.textContent = `Subscription saved! Your ${roast.toLowerCase()} beans will be delivered ${freq}.`;
+      });
+
+      updateSliderProgress();
+      updateCompletionProgress();
+    })();
+  </script>
