+    /* Customer Feedback Log */
+    .feedback-section {
+      margin-top: 60px;
+    }
+
+    .feedback-log {
+      --scrollbar-thumb: var(--accent);
+      --scrollbar-track: var(--primary);
+      max-height: 280px;
+      overflow-y: auto;
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 20px;
+      margin-top: 20px;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+      list-style: none;
+    }
+
+    /* Legacy fallback for WebKit/Blink browsers */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        /* Must define base size in WebKit for custom colors to be visual */
+        width: 8px;
+        height: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 4px;
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
+    .testimonial-item {
+      border-bottom: 1px solid var(--secondary);
+      padding-bottom: 16px;
+    }
+
+    .testimonial-item:last-child {
+      border-bottom: none;
+      padding-bottom: 0;
+    }
+
+    .testimonial-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-bottom: 6px;
+    }
+
+    .testimonial-author {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .testimonial-meta {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .testimonial-quote {
+      font-style: italic;
+      color: var(--text);
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
