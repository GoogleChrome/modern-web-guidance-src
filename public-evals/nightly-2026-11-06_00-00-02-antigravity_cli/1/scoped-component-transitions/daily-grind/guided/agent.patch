+    @layer transitions {
+      /* Outer wrapper named so outer grid transitions can move cards while inner transitions run */
+      .card-wrapper {
+        view-transition-name: match-element;
+      }
+
+      /* Prevent inner card transition names from leaking into outer transitions */
+      .card {
+        view-transition-scope: all;
+      }
+
+      /* Nested View Transition Group for scrollable list inside a card */
+      .card .drink-list {
+        view-transition-name: match-element;
+        view-transition-group: contain;
+        view-transition-class: drink-list;
+      }
+
+      ::view-transition-group-children(.drink-list) {
+        overflow: clip;
+      }
+
+      /* Participating elements inside each scoped card or list */
+      .card .drink-item,
+      .card .card-details,
+      .card .card-footer {
+        view-transition-name: match-element;
+      }
+
+      ::view-transition-group(*) {
+        animation-duration: 300ms;
+        animation-timing-function: ease-in-out;
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(*),
+        ::view-transition-old(*),
+        ::view-transition-new(*) {
+          animation: none !important;
+        }
+      }
     }
