+          desc: 'Balanced caramel sweetness with rounded milk-chocolate body and toasted hazelnut finish.',
+          width: '66%',
+          metrics: ['Agtron: #55', 'Development: 17.2%', 'Acidity: Balanced']
+        },
+        dark: {
+          title: 'Vienna Dark Roast (440°F)',
+          desc: 'Roasted into early second crack for syrupy viscosity, bittersweet cocoa, and smoky warmth.',
+          width: '92%',
+          metrics: ['Agtron: #38', 'Development: 21.0%', 'Acidity: Low']
+        }
+      };
+
+      function setRoastProfile(profileKey) {
+        const info = ROAST_DATA[profileKey];
+        if (!roastPanel || !info) return;
+
+        runComponentTransition(roastPanel, () => {
+          roastPanel.dataset.roast = profileKey;
+          roastPanel.querySelectorAll('[data-roast-tab]').forEach((btn) => {
+            btn.classList.toggle('active', btn.dataset.roastTab === profileKey);
+          });
+          document.getElementById('roast-stage-title').textContent = info.title;
+          document.getElementById('roast-stage-desc').textContent = info.desc;
+          document.getElementById('roast-meter-bar').style.width = info.width;
+          const metricsEl = document.getElementById('roast-stage-metrics');
+          if (metricsEl) {
+            metricsEl.innerHTML = info.metrics.map((m) => `<span>${m}</span>`).join('');
+          }
+        });
+      }
+
+      if (roastPanel) {
+        roastPanel.addEventListener('click', (e) => {
+          const tab = e.target.closest('[data-roast-tab]');
+          if (tab) {
+            setRoastProfile(tab.dataset.roastTab);
+          }
+        });
+      }
+
+      // 4. Concurrent Trigger Controls (animates multiple separate components simultaneously)
+      function triggerAllConcurrentTransitions() {
+        document.querySelectorAll('.card').forEach((cardEl) => {
+          const current = cardEl.dataset.state || 'overview';
+          const next = STATES[(STATES.indexOf(current) + 1) % STATES.length];
+          setCardState(cardEl, next);
+        });
+
+        if (listComponent && brewList) {
+          runComponentTransition(listComponent, () => {
+            const items = Array.from(brewList.children);
+            if (items.length > 1) {
+              brewList.appendChild(items[0]);
+            }
+          });
+        }
+
+        if (roastPanel) {
+          const order = ['light', 'medium', 'dark'];
+          const current = roastPanel.dataset.roast || 'light';
+          const next = order[(order.indexOf(current) + 1) % order.length];
+          setRoastProfile(next);
+        }
+      }
+
+      const concurrentHeroBtn = document.getElementById('trigger-concurrent-btn');
+      const cycleAllCardsBtn = document.getElementById('cycle-all-cards-btn');
+      if (concurrentHeroBtn) {
+        concurrentHeroBtn.addEventListener('click', triggerAllConcurrentTransitions);
+      }
+      if (cycleAllCardsBtn) {
+        cycleAllCardsBtn.addEventListener('click', () => {
+          document.querySelectorAll('.card').forEach((cardEl) => {
+            const current = cardEl.dataset.state || 'overview';
+            const next = STATES[(STATES.indexOf(current) + 1) % STATES.length];
+            setCardState(cardEl, next);
+          });
+        });
+      }
+
+      // 5. Unblocked Page Controls (prove the rest of the page stays interactive during transitions)
+      const pageInteractionBtn = document.getElementById('page-interaction-btn');
+      if (pageInteractionBtn) {
+        pageInteractionBtn.addEventListener('click', recordPageInteraction);
+      }
+
+      const cartBtn = document.getElementById('cart-counter-btn');
+      if (cartBtn) {
+        cartBtn.addEventListener('click', () => {
+          cartCount += 1;
+          if (cartCountEl) cartCountEl.textContent = String(cartCount);
+          recordPageInteraction();
+        });
+      }
+
+      const sugarLevels = ['Regular', 'Half Sweet', 'Extra Sweet', 'Unsweetened'];
+      let sugarIdx = 0;
+      const sugarBtn = document.getElementById('instant-sugar-btn');
+      const sugarLabel = document.getElementById('sugar-level-label');
+      if (sugarBtn && sugarLabel) {
+        sugarBtn.addEventListener('click', () => {
+          sugarIdx = (sugarIdx + 1) % sugarLevels.length;
+          sugarLabel.textContent = sugarLevels[sugarIdx];
+          recordPageInteraction();
+        });
+      }
+
+      const cupInput = document.getElementById('cup-note-input');
+      const cupPreview = document.getElementById('cup-note-preview');
+      if (cupInput && cupPreview) {
+        cupInput.addEventListener('input', () => {
+          cupPreview.textContent = cupInput.value.trim() || 'Guest';
+          recordPageInteraction();
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
