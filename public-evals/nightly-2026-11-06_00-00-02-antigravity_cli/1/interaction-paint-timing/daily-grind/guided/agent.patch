@@ -207,6 +207,255 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const ROUTE_VIEWS = {
+      '/menu': {
+        title: 'Artisanal Menu',
+        description: 'Explore our handcrafted espresso drinks, pour-overs, and freshly baked pastries.'
+      },
+      '/locations': {
+        title: 'Our Locations',
+        description: 'Visit our neighborhood cafes in Downtown, Riverside, and the Arts District.'
+      },
+      '/rewards': {
+        title: 'Daily Grind Rewards',
+        description: 'Earn beans with every cup and redeem them for free drinks and seasonal merch.'
+      },
+      '/account': {
+        title: 'My Account',
+        description: 'Manage your coffee subscriptions, saved orders, and payment preferences.'
+      },
+      '/logout': {
+        title: 'Signed Out',
+        description: 'You have been safely signed out. See you tomorrow morning!'
+      },
+      '/order-online': {
+        title: 'Order Online',
+        description: 'Skip the line—customize your drink for quick pickup or local delivery.'
+      },
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte',
+        description: 'Velvety steamed oat milk infused with pure Vermont grade-A maple syrup and a double shot of espresso.'
+      },
+      '/menu/espresso': {
+        title: 'Dark Roast Espresso',
+        description: 'Full-bodied single-origin beans roasted dark for rich cocoa and smoky caramel notes.'
+      },
+      '/menu/cold-brew': {
+        title: '18-Hour Cold Brew',
+        description: 'Coarse-ground Colombian beans steeped cold for 18 hours for an ultra-smooth, low-acid finish.'
+      }
+    };
+
+    const performanceMetrics = {
+      interactionPaints: [],
+      softNavigations: [],
+      events: []
+    };
+    window.__dailyGrindPerf = performanceMetrics;
+
+    /**
+     * Observes contentful paints caused by user interactions and invokes a callback
+     * whenever an interaction produces a larger contentful paint.
+     *
+     * @param {(entry: PerformanceEntry) => void} onInteractionPaint
+     */
+    export function observeInteractionPaints(onInteractionPaint) {
+      if (
+        typeof PerformanceObserver === 'undefined' ||
+        !PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint')
+      ) {
+        return null;
+      }
+
+      const observer = new PerformanceObserver((list) => {
+        for (const entry of list.getEntries()) {
+          // entry.duration is (entry.presentationTime - entry.startTime)
+          onInteractionPaint(entry);
+        }
+      });
+
+      observer.observe({ type: 'interaction-contentful-paint', buffered: true });
+      return observer;
+    }
+
+    /**
+     * Tracks FCP and LCP for each client-side soft navigation and reports finalized
+     * route metrics when the user navigates to a new route or hides the page.
+     */
+    export function trackSoftNavigationLCP(onSoftNavReport) {
+      const supported =
+        typeof PerformanceObserver !== 'undefined' &&
+        PerformanceObserver.supportedEntryTypes?.includes('soft-navigation') &&
+        PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint');
+
+      if (!supported) {
+        return null;
+      }
+
+      let activeSoftNav = null;
+      let activeLcpEntry = null;
+
+      function finalizeCurrentSoftNav() {
+        if (!activeSoftNav) return;
+
+        onSoftNavReport({
+          url: activeSoftNav.name,
+          navigationId: activeSoftNav.navigationId,
+          interactionId: activeSoftNav.interactionId,
+          fcpDuration: activeSoftNav.duration,
+          lcpDuration: activeLcpEntry ? activeLcpEntry.duration : null,
+          lcpElement: activeLcpEntry?.largestContentfulPaint?.element ?? null,
+          lcpSize: activeLcpEntry?.largestContentfulPaint?.size ?? null
+        });
+
+        activeSoftNav = null;
+        activeLcpEntry = null;
+      }
+
+      const softNavObserver = new PerformanceObserver((list) => {
+        for (const softNavEntry of list.getEntries()) {
+          finalizeCurrentSoftNav();
+
+          activeSoftNav = softNavEntry;
+          // Seed the LCP candidate with getLargestInteractionContentfulPaint()
+          // to capture any attributed contentful paints that occurred before the URL updated.
+          activeLcpEntry = softNavEntry.getLargestInteractionContentfulPaint();
+        }
+      });
+
+      const icpObserver = new PerformanceObserver((list) => {
+        for (const icpEntry of list.getEntries()) {
+          // Match by interactionId (not navigationId) so only paints caused
+          // by the soft navigation's initiating interaction update the route's LCP.
+          if (activeSoftNav && icpEntry.interactionId === activeSoftNav.interactionId) {
+            activeLcpEntry = icpEntry;
+          }
+        }
+      });
+
+      softNavObserver.observe({ type: 'soft-navigation', buffered: true });
+      icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden') {
+          finalizeCurrentSoftNav();
+        }
+      });
+
+      return { softNavObserver, icpObserver, finalizeCurrentSoftNav };
+    }
+
+    /**
+     * Keep standard hard-navigation and event observers active as a progressive
+     * enhancement fallback across all browsers.
+     */
+    function observeStandardMetrics() {
+      if (typeof PerformanceObserver === 'undefined') return;
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
+        const lcpObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            performanceMetrics.hardLcp = entry.startTime;
+          }
+        });
+        lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
+      }
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('event')) {
+        const eventObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (entry.interactionId) {
+              performanceMetrics.events.push({
+                name: entry.name,
+                interactionId: entry.interactionId,
+                duration: entry.duration,
+                startTime: entry.startTime,
+                processingStart: entry.processingStart,
+                processingEnd: entry.processingEnd,
+                target: entry.target?.tagName ?? null
+              });
+            }
+          }
+        });
+        eventObserver.observe({ type: 'event', buffered: true, durationThreshold: 16 });
+      }
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('layout-shift')) {
+        const clsObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (!entry.hadRecentInput) {
+              performanceMetrics.cls = (performanceMetrics.cls || 0) + entry.value;
+            }
+          }
+        });
+        clsObserver.observe({ type: 'layout-shift', buffered: true });
+      }
+    }
+
+    // Initialize observers
+    observeInteractionPaints((entry) => {
+      const record = {
+        interactionId: entry.interactionId,
+        startTime: entry.startTime,
+        paintTime: entry.paintTime,
+        presentationTime: entry.presentationTime,
+        duration: entry.duration,
+        element: entry.largestContentfulPaint?.element ?? null,
+        size: entry.largestContentfulPaint?.size ?? null
+      };
+      performanceMetrics.interactionPaints.push(record);
+      console.info('[Perf] Interaction Contentful Paint:', record);
+    });
+
+    trackSoftNavigationLCP((report) => {
+      performanceMetrics.softNavigations.push(report);
+      console.info('[Perf] Soft Navigation Paint Timing:', report);
+    });
+
+    observeStandardMetrics();
+
+    // Handle clicks on navigation bar, "Order Now" button, and "Seasonal Favorites" cards
+    // to perform client-side view switches and paint visual updates.
+    const mainContainer = document.querySelector('main.container');
+    const initialMainHTML = mainContainer ? mainContainer.innerHTML : '';
+
+    function renderClientView(pathname) {
+      if (!mainContainer) return;
+      const viewData = ROUTE_VIEWS[pathname];
+      if (!viewData) {
+        mainContainer.innerHTML = initialMainHTML;
+        return;
+      }
+
+      mainContainer.innerHTML = `
+        <section class="card" data-view="${pathname}">
+          <h2>${viewData.title}</h2>
+          <p>${viewData.description}</p>
+          <a href="/" class="btn" data-home-link>Back to Seasonal Favorites</a>
+        </section>
+      `;
+    }
+
+    document.addEventListener('click', (event) => {
+      const target = event.target.closest('nav a, .hero .btn, .grid .card, [data-home-link]');
+      if (!target) return;
+
+      const link = target.matches('a') ? target : target.querySelector('a');
+      const href = link?.getAttribute('href');
+      if (!href || !href.startsWith('/')) return;
+
+      event.preventDefault();
+      renderClientView(href);
+      if (window.location.pathname !== href) {
+        history.pushState({ path: href }, '', href);
+      }
+    });
+
+    window.addEventListener('popstate', () => {
+      renderClientView(window.location.pathname);
+    });
+  </script>
 </body>
 
 </html>
