+      }
+
+      // 2. "Order Now" button click monitoring + client-side view switching
+      var orderNowBtn = document.getElementById('order-now-btn');
+      if (orderNowBtn) {
+        orderNowBtn.addEventListener('click', function (event) {
+          event.preventDefault();
+          var clickStart = (typeof event.timeStamp === 'number' && event.timeStamp > 0 && event.timeStamp <= performance.now())
+            ? event.timeStamp
+            : performance.now();
+
+          var viewTarget = orderNowBtn.getAttribute('data-view-target') || 'order-online';
+          var domEndTime = switchView(viewTarget, {
+            startTime: clickStart,
+            trigger: 'order-now-button'
+          });
+
+          recordPaintMeasurement({
+            category: 'order-now-button',
+            label: 'Order Now CTA',
+            startTime: clickStart,
+            domEndTime: domEndTime,
+            detail: {
+              targetView: viewTarget,
+              href: orderNowBtn.getAttribute('href') || '/order-online'
+            }
+          });
+        });
+      }
+
+      // 3. "Seasonal Favorites" cards click monitoring + visual detail expansion / view switching
+      var seasonalGrid = document.getElementById('seasonal-favorites-grid');
+      if (seasonalGrid) {
+        seasonalGrid.addEventListener('click', function (event) {
+          var card = event.target.closest('.card');
+          if (!card || !seasonalGrid.contains(card)) return;
+
+          var clickStart = (typeof event.timeStamp === 'number' && event.timeStamp > 0 && event.timeStamp <= performance.now())
+            ? event.timeStamp
+            : performance.now();
+
+          var cardLink = event.target.closest('a.btn');
+          var itemName = card.getAttribute('data-item-name') || (card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : 'Seasonal Card');
+          var cardId = card.getAttribute('data-favorite-card') || itemName;
+
+          // Toggle selected state on Seasonal Favorites cards for immediate visual update
+          var allCards = seasonalGrid.querySelectorAll('.card');
+          for (var i = 0; i < allCards.length; i++) {
+            if (allCards[i] === card) {
+              allCards[i].classList.toggle('selected');
+            } else {
+              allCards[i].classList.remove('selected');
+            }
+          }
+
+          var domEndTime = performance.now();
+          var viewTarget = null;
+
+          if (cardLink) {
+            event.preventDefault();
+            card.classList.add('selected');
+            viewTarget = cardLink.getAttribute('data-view-target') || 'menu-seasonal';
+            domEndTime = switchView(viewTarget, {
+              startTime: clickStart,
+              trigger: 'seasonal-favorite-card'
+            });
+          }
+
+          recordPaintMeasurement({
+            category: 'seasonal-favorite-card',
+            label: 'Card: ' + itemName,
+            startTime: clickStart,
+            domEndTime: domEndTime,
+            detail: {
+              cardId: cardId,
+              itemName: itemName,
+              expanded: card.classList.contains('selected'),
+              targetView: viewTarget
+            }
+          });
+        });
+      }
+
+      // 4. Back to Home & Footer client-side view switches
+      var backToHomeBtn = document.getElementById('back-to-home-btn');
+      if (backToHomeBtn) {
+        backToHomeBtn.addEventListener('click', function (event) {
+          event.preventDefault();
+          var clickStart = (typeof event.timeStamp === 'number' && event.timeStamp > 0 && event.timeStamp <= performance.now())
+            ? event.timeStamp
+            : performance.now();
+          switchView('home', { startTime: clickStart, trigger: 'back-button' });
+        });
+      }
+
+      var footerLinks = document.querySelectorAll('.footer-links a[data-view-target]');
+      for (var f = 0; f < footerLinks.length; f++) {
+        footerLinks[f].addEventListener('click', function (event) {
+          event.preventDefault();
+          var clickStart = (typeof event.timeStamp === 'number' && event.timeStamp > 0 && event.timeStamp <= performance.now())
+            ? event.timeStamp
+            : performance.now();
+          var targetView = event.currentTarget.getAttribute('data-view-target');
+          switchView(targetView, { startTime: clickStart, trigger: 'footer-link' });
+        });
+      }
+
+      window.addEventListener('popstate', function (event) {
+        var startTime = performance.now();
+        var nextView = (event.state && event.state.view) || (window.location.hash ? window.location.hash.slice(1) : 'home');
+        switchView(nextView, { startTime: startTime, trigger: 'popstate', skipHistory: true });
+      });
+
+      var clearBtn = document.getElementById('perf-clear-btn');
+      if (clearBtn) {
+        clearBtn.addEventListener('click', function () {
+          metricsStore.length = 0;
+          if (typeof performance.clearMarks === 'function') {
+            performance.clearMarks();
+          }
+          if (typeof performance.clearMeasures === 'function') {
+            performance.clearMeasures();
+          }
+          renderMetricsDashboard(null);
+        });
+      }
+
+      // Expose programmatic client-side performance monitoring API
+      window.dailyGrindPerf = {
+        metrics: metricsStore,
+        getMetrics: function (category) {
+          if (!category) return metricsStore.slice();
+          return metricsStore.filter(function (entry) {
+            return entry.category === category;
+          });
+        },
+        getSummary: function () {
+          var byCategory = {};
+          var totalMs = 0;
+          for (var i = 0; i < metricsStore.length; i++) {
+            var item = metricsStore[i];
+            totalMs += item.paintDurationMs;
+            if (!byCategory[item.category]) {
+              byCategory[item.category] = { count: 0, totalPaintMs: 0, avgPaintMs: 0, lastPaintMs: 0 };
+            }
+            byCategory[item.category].count += 1;
+            byCategory[item.category].totalPaintMs += item.paintDurationMs;
+            byCategory[item.category].lastPaintMs = item.paintDurationMs;
+            byCategory[item.category].avgPaintMs = byCategory[item.category].totalPaintMs / byCategory[item.category].count;
+          }
+          return {
+            totalEvents: metricsStore.length,
+            averagePaintMs: metricsStore.length ? totalMs / metricsStore.length : 0,
+            byCategory: byCategory
+          };
+        },
+        switchView: function (viewName) {
+          return switchView(viewName, { startTime: performance.now(), trigger: 'api' });
+        },
+        measureInteractionPaint: function (category, label, domMutationFn) {
+          var startTime = performance.now();
+          if (typeof domMutationFn === 'function') {
+            domMutationFn();
+          }
+          var domEndTime = performance.now();
+          recordPaintMeasurement({
+            category: category || 'custom',
+            label: label || 'custom-interaction',
+            startTime: startTime,
+            domEndTime: domEndTime
+          });
+        },
+        clear: function () {
+          metricsStore.length = 0;
+          renderMetricsDashboard(null);
+        }
+      };
+    })();
+  </script>
 </body>
 
 </html>
