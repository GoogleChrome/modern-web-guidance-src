+      /**
+       * Wait until the browser has finished painting the visual updates produced
+       * in the current task. Uses double requestAnimationFrame (the first rAF runs
+       * right before layout/paint of the next frame; the second rAF or post-frame
+       * macrotask runs immediately after that frame has been painted).
+       */
+      function afterNextPaint(callback) {
+        if (typeof window.requestAnimationFrame === 'function') {
+          window.requestAnimationFrame(function () {
+            setTimeout(function () {
+              callback(performance.now());
+            }, 0);
+          });
+        } else {
+          setTimeout(function () {
+            callback(performance.now());
+          }, 0);
+        }
+      }
+
+      function renderMetricsDashboard(latestEntry) {
+        var tbody = document.getElementById('perf-log-tbody');
+        var emptyRow = document.getElementById('perf-empty-row');
+        var lastDurationEl = document.getElementById('perf-last-duration');
+        var lastViewSwitchEl = document.getElementById('perf-last-view-switch');
