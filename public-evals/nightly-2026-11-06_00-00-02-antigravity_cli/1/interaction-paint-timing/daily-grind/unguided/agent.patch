+      function recordPaintMeasurement(options) {
+        var category = options.category;
+        var label = options.label;
+        var startTime = options.startTime;
+        var domEndTime = options.domEndTime;
+        var detail = options.detail || {};
+
+        afterNextPaint(function (paintEndTime) {
+          var paintDurationMs = Math.max(0, paintEndTime - startTime);
+          var domUpdateDurationMs = Math.max(0, domEndTime - startTime);
+          var id = metricsStore.length + 1;
+          var startMarkName = 'daily-grind:' + category + ':' + id + ':start';
+          var paintMarkName = 'daily-grind:' + category + ':' + id + ':paint';
+          var measureName = 'daily-grind:' + category + ':' + label;
