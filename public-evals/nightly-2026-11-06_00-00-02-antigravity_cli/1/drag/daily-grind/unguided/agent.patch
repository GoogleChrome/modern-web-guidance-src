+          extraShots: 0,
+          unitPrice: 4.75,
+          qty: 1
+        }
+      ];
+
+      function getBuilderUnitPrice() {
+        return builderState.basePrice + builderState.sizeUpcharge + (builderState.extraShots * 1.00);
+      }
+
+      function updateBuilderUI() {
+        const price = getBuilderUnitPrice();
+        const formatted = '$' + price.toFixed(2);
+        builderLivePrice.textContent = formatted;
+        addBtnPrice.textContent = formatted;
+        shotCountVal.textContent = String(builderState.extraShots);
+      }
+
+      function renderCart() {
+        cartItemsList.innerHTML = '';
+        let totalQty = 0;
+        let subtotal = 0;
+
+        if (cartItems.length === 0) {
+          const empty = document.createElement('div');
+          empty.className = 'cart-empty-msg';
+          empty.textContent = 'Your coffee cart is empty. Customize a drink above or quick-add from Seasonal Favorites!';
+          cartItemsList.appendChild(empty);
+        } else {
+          cartItems.forEach((item) => {
+            totalQty += item.qty;
+            subtotal += item.unitPrice * item.qty;
+
+            const row = document.createElement('div');
+            row.className = 'cart-item';
+
+            const shotsText = item.extraShots > 0 ? ` • +${item.extraShots} shot${item.extraShots > 1 ? 's' : ''}` : '';
+            const milkText = item.milk && item.milk !== 'None' ? `${item.milk} Milk` : 'No Milk';
+
+            row.innerHTML = `
+              <div class="cart-item-info">
+                <div class="cart-item-title">${item.name}</div>
+                <div class="cart-item-meta">${item.size} • ${item.temp} • ${milkText}${shotsText}</div>
+              </div>
+              <div class="cart-item-controls">
+                <button type="button" class="qty-btn" data-action="dec" data-id="${item.id}" aria-label="Decrease quantity">&minus;</button>
+                <span class="item-qty">${item.qty}</span>
+                <button type="button" class="qty-btn" data-action="inc" data-id="${item.id}" aria-label="Increase quantity">+</button>
+                <span class="item-price">$${(item.unitPrice * item.qty).toFixed(2)}</span>
+              </div>
+            `;
+            cartItemsList.appendChild(row);
+          });
+        }
+
+        const tax = subtotal * 0.085;
+        const activeFee = cartItems.length > 0 ? fulfillmentFee : 0;
+        const grandTotal = subtotal + tax + activeFee;
+
+        cartCountBadge.textContent = String(totalQty);
+        cartSubtotalEl.textContent = '$' + subtotal.toFixed(2);
+        cartTaxEl.textContent = '$' + (tax + activeFee).toFixed(2);
+        cartTotalEl.textContent = '$' + grandTotal.toFixed(2);
+        checkoutBtnTotal.textContent = '$' + grandTotal.toFixed(2);
+        placeOrderBtn.disabled = cartItems.length === 0;
+      }
+
+      function addItemToCart(itemSpec) {
+        orderStatusBanner.classList.remove('visible');
+        const key = `${itemSpec.name}|${itemSpec.size}|${itemSpec.temp}|${itemSpec.milk}|${itemSpec.extraShots}`;
+        const existing = cartItems.find(
+          (i) => `${i.name}|${i.size}|${i.temp}|${i.milk}|${i.extraShots}` === key
+        );
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cartItems.push({
+            id: 'item-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
+            name: itemSpec.name,
+            size: itemSpec.size,
+            temp: itemSpec.temp,
+            milk: itemSpec.milk,
+            extraShots: itemSpec.extraShots,
+            unitPrice: itemSpec.unitPrice,
+            qty: 1
+          });
+        }
+        renderCart();
+      }
+
+      // Builder Events
+      drinkSelect.addEventListener('change', () => {
+        const opt = drinkSelect.options[drinkSelect.selectedIndex];
+        builderState.name = opt.value;
+        builderState.basePrice = parseFloat(opt.dataset.basePrice || '5.00');
+        updateBuilderUI();
+      });
+
+      function setupSegmentedGroup(container, onSelect) {
+        container.addEventListener('click', (e) => {
+          const btn = e.target.closest('.seg-btn');
+          if (!btn) return;
+          container.querySelectorAll('.seg-btn').forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          onSelect(btn);
+        });
+      }
+
+      setupSegmentedGroup(sizeSelector, (btn) => {
+        builderState.size = btn.dataset.size;
+        builderState.sizeUpcharge = parseFloat(btn.dataset.upcharge || '0');
+        updateBuilderUI();
+      });
+
+      setupSegmentedGroup(tempSelector, (btn) => {
+        builderState.temp = btn.dataset.temp;
+      });
+
+      setupSegmentedGroup(milkSelector, (btn) => {
+        builderState.milk = btn.dataset.milk;
+      });
+
+      setupSegmentedGroup(fulfillmentSelector, (btn) => {
+        fulfillmentMode = btn.dataset.mode;
+        fulfillmentFee = parseFloat(btn.dataset.fee || '0');
+        renderCart();
+      });
+
+      shotDecBtn.addEventListener('click', () => {
+        if (builderState.extraShots > 0) {
+          builderState.extraShots -= 1;
+          updateBuilderUI();
+        }
+      });
+
+      shotIncBtn.addEventListener('click', () => {
+        if (builderState.extraShots < 4) {
+          builderState.extraShots += 1;
+          updateBuilderUI();
+        }
+      });
+
+      addToCartBtn.addEventListener('click', () => {
+        addItemToCart({
+          name: builderState.name,
+          size: builderState.size,
+          temp: builderState.temp,
+          milk: builderState.milk,
+          extraShots: builderState.extraShots,
+          unitPrice: getBuilderUnitPrice()
+        });
+      });
+
+      // Card Quick-Add buttons
+      document.querySelectorAll('.quick-add-card-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          panel.classList.remove('is-minimized');
+          minimizeBtn.innerHTML = '&minus;';
+          minimizeBtn.setAttribute('aria-expanded', 'true');
+          addItemToCart({
+            name: btn.dataset.drink,
+            size: 'Medium (16oz)',
+            temp: btn.dataset.temp || 'Hot',
+            milk: btn.dataset.milk || 'Oat',
+            extraShots: 0,
+            unitPrice: parseFloat(btn.dataset.price || '5.00')
+          });
+        });
+      });
+
+      // Cart Item Quantity Controls
+      cartItemsList.addEventListener('click', (e) => {
+        const btn = e.target.closest('.qty-btn');
+        if (!btn) return;
+        const id = btn.dataset.id;
+        const action = btn.dataset.action;
+        const idx = cartItems.findIndex((i) => i.id === id);
+        if (idx === -1) return;
+
+        if (action === 'inc') {
+          cartItems[idx].qty += 1;
+        } else if (action === 'dec') {
+          cartItems[idx].qty -= 1;
+          if (cartItems[idx].qty <= 0) {
+            cartItems.splice(idx, 1);
+          }
+        }
+        renderCart();
+      });
+
+      clearCartBtn.addEventListener('click', () => {
+        cartItems = [];
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      });
+
+      placeOrderBtn.addEventListener('click', () => {
+        if (cartItems.length === 0) return;
+        const orderNum = Math.floor(100 + Math.random() * 900);
+        const modeText = fulfillmentMode === 'delivery' ? 'Local Delivery (20-30 mins)' : 'In-Store Pickup (10 mins)';
+        orderStatusBanner.textContent = `Order #DG-${orderNum} confirmed for ${modeText}!`;
+        orderStatusBanner.classList.add('visible');
+        cartItems = [];
+        renderCart();
+      });
+
+      // Minimize / Expand Panel
+      minimizeBtn.addEventListener('click', (e) => {
+        e.stopPropagation();
+        const isMin = panel.classList.toggle('is-minimized');
+        minimizeBtn.innerHTML = isMin ? '&#9744;' : '&minus;';
+        minimizeBtn.setAttribute('aria-expanded', String(!isMin));
+      });
+
+      // Reset Panel Position
+      function resetPanelPosition() {
+        panel.style.left = '';
+        panel.style.top = '84px';
+        panel.style.right = '24px';
+        panel.style.bottom = 'auto';
+      }
+
+      resetPosBtn.addEventListener('click', (e) => {
+        e.stopPropagation();
+        resetPanelPosition();
+      });
+
+      // Draggable Header Handle Logic (supports Pointer, Mouse, and Touch events)
+      let isDragging = false;
+      let dragOffsetX = 0;
+      let dragOffsetY = 0;
+
+      function clamp(val, min, max) {
+        return Math.max(min, Math.min(max, val));
+      }
+
+      function startDrag(clientX, clientY, target) {
+        if (target && target.closest('button')) return false;
+        const rect = panel.getBoundingClientRect();
+        isDragging = true;
+        dragOffsetX = clientX - rect.left;
+        dragOffsetY = clientY - rect.top;
+
+        panel.style.left = rect.left + 'px';
+        panel.style.top = rect.top + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.classList.add('is-dragging');
+        return true;
+      }
+
+      function moveDrag(clientX, clientY) {
+        if (!isDragging) return;
+        const rect = panel.getBoundingClientRect();
+        const maxLeft = Math.max(8, window.innerWidth - rect.width - 8);
+        const maxTop = Math.max(8, window.innerHeight - rect.height - 8);
+        const nextLeft = clamp(clientX - dragOffsetX, 8, maxLeft);
+        const nextTop = clamp(clientY - dragOffsetY, 8, maxTop);
+
+        panel.style.left = Math.round(nextLeft) + 'px';
+        panel.style.top = Math.round(nextTop) + 'px';
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        panel.classList.remove('is-dragging');
+      }
+
+      dragHandle.addEventListener('pointerdown', (e) => {
+        if (e.button !== undefined && e.button !== 0) return;
+        startDrag(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', () => {
+        endDrag();
+      });
+
+      dragHandle.addEventListener('mousedown', (e) => {
+        if (e.button !== 0) return;
+        if (startDrag(e.clientX, e.clientY, e.target)) {
+          e.preventDefault();
+        }
+      });
+
+      window.addEventListener('mousemove', (e) => {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', () => {
+        endDrag();
+      });
+
+      dragHandle.addEventListener('touchstart', (e) => {
+        if (e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        if (startDrag(touch.clientX, touch.clientY, e.target)) {
+          e.preventDefault();
+        }
+      }, { passive: false });
+
+      window.addEventListener('touchmove', (e) => {
+        if (!isDragging || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        moveDrag(touch.clientX, touch.clientY);
+        e.preventDefault();
+      }, { passive: false });
+
+      window.addEventListener('touchend', () => {
+        endDrag();
+      });
+
+      window.addEventListener('resize', () => {
+        if (!panel.style.left) return;
+        const rect = panel.getBoundingClientRect();
+        const maxLeft = Math.max(8, window.innerWidth - rect.width - 8);
+        const maxTop = Math.max(8, window.innerHeight - rect.height - 8);
+        panel.style.left = Math.round(clamp(rect.left, 8, maxLeft)) + 'px';
+        panel.style.top = Math.round(clamp(rect.top, 8, maxTop)) + 'px';
+      });
+
+      updateBuilderUI();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
 </html>
