+  <script>
+    (function () {
+      const panel = document.getElementById('quick-order-panel');
+      const handle = document.getElementById('quick-order-handle');
+      const toggleBtn = document.getElementById('panel-toggle-btn');
+      const sizeSelect = document.getElementById('coffee-size-select');
+      const milkSelect = document.getElementById('coffee-milk-select');
+      const itemsList = document.getElementById('cart-items-list');
+      const countBadge = document.getElementById('cart-count-badge');
+      const totalPriceEl = document.getElementById('cart-total-price');
+      const clearBtn = document.getElementById('clear-cart-btn');
+      const placeOrderBtn = document.getElementById('place-order-btn');
+      const statusMsg = document.getElementById('order-status-msg');
+
+      if (!panel || !handle) return;
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility when JS initializes
+      handle.classList.add('drag-ready');
+      handle.tabIndex = 0;
+      handle.setAttribute(
+        'aria-label',
+        'Quick-Order Cart header handle. Drag or press arrow keys to move panel.'
+      );
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let hasPositionedManually = false;
+
+      function ensureTopLeftPositioning() {
+        if (hasPositionedManually) return;
+        const rect = panel.getBoundingClientRect();
+        panel.style.left = `${rect.left}px`;
+        panel.style.top = `${rect.top}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        hasPositionedManually = true;
+      }
+
+      function moveTo(left, top) {
+        ensureTopLeftPositioning();
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (
+          event.button !== 0 ||
+          event.target.closest('button, input, select, textarea, a')
+        ) {
+          return;
+        }
+
+        ensureTopLeftPositioning();
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        const movedDistance = Math.hypot(
+          event.clientX - startX,
+          event.clientY - startY
+        );
+        if (movedDistance < 4 && !handle.classList.contains('dragging')) {
+          return;
+        }
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const step = 15;
+        const rect = panel.getBoundingClientRect();
+        let nextLeft = rect.left;
+        let nextTop = rect.top;
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            nextLeft -= step;
+            break;
+          case 'ArrowRight':
+            nextLeft += step;
+            break;
+          case 'ArrowUp':
+            nextTop -= step;
+            break;
+          case 'ArrowDown':
+            nextTop += step;
+            break;
+          default:
+            return;
+        }
+
+        event.preventDefault();
+        moveTo(nextLeft, nextTop);
+      });
+
+      window.addEventListener('resize', () => {
+        if (!hasPositionedManually) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      });
+
+      // Minimize / Expand Panel
+      toggleBtn.addEventListener('click', () => {
+        const isMinimized = panel.classList.toggle('minimized');
+        toggleBtn.setAttribute('aria-expanded', String(!isMinimized));
+        toggleBtn.setAttribute(
+          'aria-label',
+          isMinimized ? 'Expand quick-order panel' : 'Minimize quick-order panel'
+        );
+        toggleBtn.textContent = isMinimized ? '+' : '−';
+        if (hasPositionedManually) {
+          const rect = panel.getBoundingClientRect();
+          moveTo(rect.left, rect.top);
+        }
+      });
+
+      // Cart State & Interactive Controls
+      const quantities = {
+        'maple-oat-latte': 1,
+        'dark-roast-espresso': 0,
+        'cold-brew': 1,
+      };
+
+      function updateCartUI() {
+        const sizeExtra = parseFloat(sizeSelect.value) || 0;
+        const milkExtra = parseFloat(milkSelect.value) || 0;
+        let totalItems = 0;
+        let totalCost = 0;
+
+        const itemRows = itemsList.querySelectorAll('.cart-item');
+        itemRows.forEach((row) => {
+          const id = row.getAttribute('data-id');
+          const basePrice = parseFloat(row.getAttribute('data-base-price')) || 0;
+          const qty = quantities[id] || 0;
+          const qtyEl = row.querySelector('[data-qty]');
+          if (qtyEl) qtyEl.textContent = String(qty);
+
+          totalItems += qty;
+          totalCost += qty * (basePrice + sizeExtra + milkExtra);
+        });
+
+        countBadge.textContent = `${totalItems} ${totalItems === 1 ? 'item' : 'items'}`;
+        totalPriceEl.textContent = `$${totalCost.toFixed(2)}`;
+      }
+
+      itemsList.addEventListener('click', (event) => {
+        const btn = event.target.closest('.qty-btn');
+        if (!btn) return;
+        const row = btn.closest('.cart-item');
+        if (!row) return;
+        const id = row.getAttribute('data-id');
+        const action = btn.getAttribute('data-action');
+
+        if (action === 'increment') {
+          quantities[id] = (quantities[id] || 0) + 1;
+        } else if (action === 'decrement') {
+          quantities[id] = Math.max(0, (quantities[id] || 0) - 1);
+        }
+        statusMsg.classList.remove('visible');
+        updateCartUI();
+      });
+
+      document.querySelectorAll('.quick-add-card-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const id = btn.getAttribute('data-item-id');
+          if (!id) return;
+          quantities[id] = (quantities[id] || 0) + 1;
+          if (panel.classList.contains('minimized')) {
+            toggleBtn.click();
+          }
+          statusMsg.classList.remove('visible');
+          updateCartUI();
+        });
+      });
+
+      sizeSelect.addEventListener('change', updateCartUI);
+      milkSelect.addEventListener('change', updateCartUI);
+
+      clearBtn.addEventListener('click', () => {
+        Object.keys(quantities).forEach((key) => {
+          quantities[key] = 0;
+        });
+        statusMsg.classList.remove('visible');
+        updateCartUI();
+      });
+
+      placeOrderBtn.addEventListener('click', () => {
+        const totalItems = Object.values(quantities).reduce((a, b) => a + b, 0);
+        statusMsg.classList.add('visible');
+        if (totalItems === 0) {
+          statusMsg.textContent = 'Add at least one coffee item to place a quick order.';
+          return;
+        }
+        const sizeLabel = sizeSelect.options[sizeSelect.selectedIndex].text.split(' ')[0];
+        const milkLabel = milkSelect.options[milkSelect.selectedIndex].text.split(' (')[0];
+        statusMsg.textContent = `Order received! Preparing ${totalItems} ${sizeLabel} drink(s) with ${milkLabel}.`;
+      });
+
+      updateCartUI();
+    })();
+  </script>
 </body>
 
