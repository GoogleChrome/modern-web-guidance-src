+    /* Contact Section */
+    .contact-section {
+      max-width: 600px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .contact-card {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .contact-card h2 {
+      text-align: center;
+      margin-bottom: 20px;
+      color: var(--primary);
+    }
+
+    .form-group {
+      margin-bottom: 16px;
+      padding: 10px 12px;
+      border: 2px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .form-group:focus-within {
+      border-color: var(--primary);
+    }
+
+    .form-group:has(:invalid) {
+      border-color: #d32f2f;
+    }
+
+    .form-group label {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: 600;
+      margin-bottom: 4px;
+      color: var(--primary);
+    }
+
+    .form-group input,
+    .form-group textarea {
+      width: 100%;
+      border: none;
+      background: transparent;
+      font-family: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      outline: none;
+    }
+
+    .form-group textarea {
+      resize: vertical;
+      min-height: 100px;
+    }
+
+    .contact-card button.btn {
+      width: 100%;
+      border: none;
+      font-size: 1rem;
+      cursor: pointer;
+    }
+
