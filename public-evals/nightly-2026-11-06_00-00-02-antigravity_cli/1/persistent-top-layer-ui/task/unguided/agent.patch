+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-modal');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const openSecondaryBtn = document.getElementById('open-feedback-secondary-btn');
+      const openFooterLink = document.getElementById('open-feedback-footer-link');
+      const closeIconBtn = document.getElementById('close-feedback-icon');
+      const cancelBtn = document.getElementById('cancel-feedback-btn');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const hostIndicator = document.getElementById('current-host-indicator');
+      const feedbackForm = document.getElementById('feedback-form');
+      const feedbackStatus = document.getElementById('feedback-status');
+      const nameInput = document.getElementById('feedback-name');
+
+      const containers = [
+        document.getElementById('modal-container-primary'),
+        document.getElementById('modal-container-secondary'),
+        document.getElementById('modal-container-footer')
+      ];
+
+      // Track the most recently focused element inside the dialog so that moving
+      // the modal via either the in-modal Move button or an external control preserves focus.
+      let lastFocusedInsideModal = null;
+      dialog.addEventListener('focusin', (event) => {
+        if (dialog.contains(event.target)) {
+          lastFocusedInsideModal = event.target;
+        }
+      });
+
+      function updateHostContainersUI() {
+        const currentParent = dialog.parentElement;
+        containers.forEach((container) => {
+          const isCurrent = container === currentParent;
+          container.classList.toggle('active-host', isCurrent);
+          const badge = container.querySelector('[data-host-status]');
+          if (badge) {
+            badge.textContent = isCurrent ? 'Hosting Modal' : 'Empty';
+          }
+        });
+        if (currentParent && hostIndicator) {
+          hostIndicator.textContent = '#' + currentParent.id;
+          hostIndicator.dataset.parentId = currentParent.id;
+        }
+      }
+
+      function openFeedbackModal() {
+        feedbackStatus.classList.remove('visible');
+        feedbackStatus.textContent = '';
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+        nameInput.focus();
+      }
+
+      function closeFeedbackModal() {
+        if (dialog.open) {
+          dialog.close();
+        }
+      }
+
+      function moveModalToNextContainer() {
+        const wasOpen = dialog.open;
+        const currentParent = dialog.parentElement;
+        const currentIndex = containers.indexOf(currentParent);
+        const nextIndex = (currentIndex + 1) % containers.length;
+        const targetContainer = containers[nextIndex];
+
+        const activeEl = document.activeElement;
+        const focusTarget =
+          (activeEl && dialog.contains(activeEl))
+            ? activeEl
+            : (lastFocusedInsideModal && dialog.contains(lastFocusedInsideModal))
+              ? lastFocusedInsideModal
+              : moveBtn;
+
+        let selectionStart = null;
+        let selectionEnd = null;
+        let selectionDirection = null;
+        if (focusTarget && typeof focusTarget.selectionStart === 'number') {
+          try {
+            selectionStart = focusTarget.selectionStart;
+            selectionEnd = focusTarget.selectionEnd;
+            selectionDirection = focusTarget.selectionDirection;
+          } catch (_) {
+            // Ignore input types that do not support selection ranges
+          }
+        }
+
+        // Prefer atomic DOM move (moveBefore) when supported so top-layer modal state
+        // and focus remain uninterrupted; fall back to appendChild + re-establishing
+        // modal/focus state on older engines.
+        if (typeof targetContainer.moveBefore === 'function') {
+          targetContainer.moveBefore(dialog, null);
+        } else {
+          targetContainer.appendChild(dialog);
+        }
+
+        // Ensure the dialog stays open and modal across the move in all browsers
+        if (wasOpen) {
+          if (!dialog.open) {
+            if (typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+        }
+
+        // Ensure focus and text selection inside the modal remain active
+        if (focusTarget && typeof focusTarget.focus === 'function') {
+          if (document.activeElement !== focusTarget) {
+            focusTarget.focus({ preventScroll: true });
+          }
+          if (selectionStart !== null && selectionEnd !== null && typeof focusTarget.setSelectionRange === 'function') {
+            try {
+              focusTarget.setSelectionRange(selectionStart, selectionEnd, selectionDirection || 'none');
+            } catch (_) {}
+          }
+        }
+
+        updateHostContainersUI();
+      }
+
+      openBtn.addEventListener('click', openFeedbackModal);
+      openSecondaryBtn.addEventListener('click', openFeedbackModal);
+      openFooterLink.addEventListener('click', (event) => {
+        event.preventDefault();
+        openFeedbackModal();
+      });
+
+      closeIconBtn.addEventListener('click', closeFeedbackModal);
+      cancelBtn.addEventListener('click', closeFeedbackModal);
+      moveBtn.addEventListener('click', moveModalToNextContainer);
+
+      // Close when clicking on the dialog backdrop outside the modal content box
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) {
+          closeFeedbackModal();
+        }
+      });
+
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        feedbackStatus.textContent = 'Thank you! Your feedback has been received.';
+        feedbackStatus.classList.add('visible');
+        setTimeout(() => {
+          closeFeedbackModal();
+          feedbackForm.reset();
+          feedbackStatus.classList.remove('visible');
+        }, 900);
+      });
+
+      updateHostContainersUI();
+    })();
+  </script>
 </body>
 
