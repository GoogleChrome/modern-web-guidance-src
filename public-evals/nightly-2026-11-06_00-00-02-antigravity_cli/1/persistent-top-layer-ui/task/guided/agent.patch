+  <script type="module">
+    // Feature detect Invoker Commands and conditionally load polyfill when missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const moveModalBtn = document.getElementById('move-modal-btn');
+    const locationStatus = document.getElementById('modal-location-status');
+    const containers = [
+      document.getElementById('primary-modal-container'),
+      document.getElementById('secondary-modal-container'),
+      document.getElementById('footer-modal-container')
+    ];
+
+    // Fallback for closedby="any" light-dismiss in browsers without native dialog closedBy support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+      }
+    }
+
+    // Reset returnValue on close to avoid leaking stale values across dismissals
+    feedbackDialog.addEventListener('close', () => {
+      feedbackDialog.returnValue = '';
+    });
+
+    // Move the open <dialog> to the next container in the DOM while preserving top-layer & focus state
+    moveModalBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const currentIndex = containers.indexOf(currentParent);
+      const targetParent = containers[(currentIndex + 1) % containers.length];
+      const activeBeforeMove = document.activeElement;
+
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.hasAttribute('open') || feedbackDialog.matches(':popover-open');
+        targetParent.insertBefore(feedbackDialog, null);
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+        if (activeBeforeMove instanceof HTMLElement && feedbackDialog.contains(activeBeforeMove)) {
+          activeBeforeMove.focus();
+        }
+      }
+
+      for (const container of containers) {
+        if (container.classList.contains('host-container')) {
+          container.dataset.activeHost = String(container === targetParent);
+        }
+      }
+
+      const label = targetParent.dataset.containerLabel || targetParent.id;
+      locationStatus.textContent = `Current container: ${label}`;
+    });
+  </script>
