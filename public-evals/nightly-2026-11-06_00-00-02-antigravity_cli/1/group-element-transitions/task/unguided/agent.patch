+        'ethiopian-yirgacheffe': {
+          name: 'Ethiopian Yirgacheffe',
+          roast: 'Light Roast',
+          price: '$18',
+          origin: 'Origin: Yirgacheffe, Ethiopia',
+          notes: 'Delicate floral jasmine aroma with bright bergamot and lemon zest notes.',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        'colombian-supremo': {
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          price: '$16',
+          origin: 'Origin: Huila, Colombia',
+          notes: 'Balanced body featuring toasted caramel sweetness and roasted walnut finish.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        'sumatra-mandheling': {
+          name: 'Sumatra Mandheling',
+          roast: 'Dark Roast',
+          price: '$19',
+          origin: 'Origin: Aceh, Indonesia',
+          notes: 'Full-bodied, low acidity profile with earthy cedar and bittersweet dark cocoa.',
+          image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+        },
+        'guatemalan-antigua': {
+          name: 'Guatemalan Antigua',
+          roast: 'Medium-Dark',
+          price: '$17',
+          origin: 'Origin: Antigua Valley, Guatemala',
+          notes: 'Volcanic soil grown beans offering velvety milk chocolate and warm baking spice.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      const beanGrid = document.getElementById('bean-grid');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const varietySelect = document.getElementById('bean-variety-select');
+      const beanCountEl = document.getElementById('bean-count');
+      let nextBeanId = 5;
+
+      function runWithViewTransition(updateDom) {
+        if (typeof document.startViewTransition === 'function') {
+          return document.startViewTransition(() => {
+            updateDom();
+          });
+        }
+        updateDom();
+        return null;
+      }
+
+      function updateCountAndEmptyState() {
+        const cards = beanGrid.querySelectorAll('.bean-card');
+        beanCountEl.textContent = String(cards.length);
+        const existingEmpty = beanGrid.querySelector('.empty-bean-message');
+        if (cards.length === 0 && !existingEmpty) {
+          const emptyMsg = document.createElement('div');
+          emptyMsg.className = 'empty-bean-message';
+          emptyMsg.textContent = 'No coffee beans selected yet. Use "+ Add Coffee Bean" above to build your selection.';
+          beanGrid.appendChild(emptyMsg);
+        } else if (cards.length > 0 && existingEmpty) {
+          existingEmpty.remove();
+        }
+      }
+
+      function createBeanCard(beanData, uniqueId) {
+        const article = document.createElement('article');
+        article.className = 'card bean-card';
+        article.setAttribute('role', 'listitem');
+        article.setAttribute('data-bean-id', uniqueId);
+        article.style.viewTransitionName = uniqueId;
+        article.style.setProperty('view-transition-class', 'bean-card');
+
+        article.innerHTML = `
+          <img class="bean-card-image" src="${beanData.image}" alt="${beanData.name} coffee beans">
+          <div class="bean-card-body">
+            <div class="bean-card-meta">
+              <span class="roast-badge">${beanData.roast}</span>
+              <span class="bean-price">${beanData.price}</span>
+            </div>
+            <h3>${beanData.name}</h3>
+            <div class="bean-origin">${beanData.origin}</div>
+            <p class="bean-notes">${beanData.notes}</p>
+            <button type="button" class="remove-bean-btn" data-action="remove" aria-label="Remove ${beanData.name}">Remove Bean</button>
+          </div>
+        `;
+        return article;
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        const selectedKey = varietySelect.value;
+        const beanData = BEAN_CATALOG[selectedKey] || BEAN_CATALOG['kenyan-aa'];
+        const uniqueId = `bean-${nextBeanId++}`;
+        const newCard = createBeanCard(beanData, uniqueId);
+
+        runWithViewTransition(() => {
+          const emptyMsg = beanGrid.querySelector('.empty-bean-message');
+          if (emptyMsg) {
+            emptyMsg.remove();
+          }
+          beanGrid.prepend(newCard);
+          updateCountAndEmptyState();
+        });
+
+        varietySelect.selectedIndex = (varietySelect.selectedIndex + 1) % varietySelect.options.length;
+      });
+
+      beanGrid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.remove-bean-btn');
+        if (!removeBtn) return;
+
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        runWithViewTransition(() => {
+          card.remove();
+          updateCountAndEmptyState();
+        });
+      });
+    })();
+  </script>
