+  <script>
+    const BEAN_CATALOG = [
+      {
+        id: 'ethiopian-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        roast: 'Light Roast',
+        price: '$18',
+        notes: 'Bright bergamot, jasmine blossom, and sweet stone fruit finish.',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'colombian-supremo',
+        name: 'Colombian Supremo',
+        roast: 'Medium Roast',
+        price: '$16',
+        notes: 'Balanced caramel sweetness with toasted walnut and citrus acidity.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        roast: 'Dark Roast',
+        price: '$19',
+        notes: 'Full-bodied and velvety with dark cocoa, cedar, and earthy spice.',
+        image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'guatemala-antigua',
+        name: 'Guatemala Antigua',
+        roast: 'Medium Roast',
+        price: '$17',
+        notes: 'Rich milk chocolate aroma layered with brown sugar and orange zest.',
+        image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'kenya-aa',
+        name: 'Kenya AA Nyeri',
+        roast: 'Light-Medium',
+        price: '$20',
+        notes: 'Juicy blackcurrant, ruby grapefruit, and a crisp wine-like finish.',
+        image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'costa-rica-tarrazu',
+        name: 'Costa Rica Tarrazú',
+        roast: 'Medium Roast',
+        price: '$18',
+        notes: 'Honeyed crisp apple, roasted almond, and silky cocoa undertones.',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      }
+    ];
+
+    let selectedBeans = BEAN_CATALOG.slice(0, 4);
+
+    const listEl = document.getElementById('bean-selection-list');
+    const selectEl = document.getElementById('bean-catalog-select');
+    const addBtn = document.getElementById('add-bean-btn');
+    const resetBtn = document.getElementById('reset-beans-btn');
+
+    function renderBeanSelection() {
+      const selectedIds = new Set(selectedBeans.map((bean) => bean.id));
+      const availableBeans = BEAN_CATALOG.filter((bean) => !selectedIds.has(bean.id));
+
+      selectEl.replaceChildren();
+      if (availableBeans.length === 0) {
+        const option = document.createElement('option');
+        option.value = '';
+        option.textContent = 'All coffee beans added';
+        selectEl.appendChild(option);
+        selectEl.disabled = true;
+        addBtn.disabled = true;
+      } else {
+        for (const bean of availableBeans) {
+          const option = document.createElement('option');
+          option.value = bean.id;
+          option.textContent = `${bean.name} (${bean.roast}) — ${bean.price}`;
+          selectEl.appendChild(option);
+        }
+        selectEl.disabled = false;
+        addBtn.disabled = false;
+      }
+
+      resetBtn.disabled = selectedBeans.length === BEAN_CATALOG.length;
+
+      listEl.replaceChildren();
+      if (selectedBeans.length === 0) {
+        const emptyItem = document.createElement('li');
+        emptyItem.className = 'empty-selection';
+        emptyItem.textContent = 'Your coffee bean box is empty. Add a variety above to get started!';
+        listEl.appendChild(emptyItem);
+        return;
+      }
+
+      for (const bean of selectedBeans) {
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.style.viewTransitionName = `bean-${bean.id}`;
+
+        const img = document.createElement('img');
+        img.src = bean.image;
+        img.alt = `${bean.name} coffee beans`;
+        img.loading = 'lazy';
+
+        const body = document.createElement('div');
+        body.className = 'bean-item-body';
+
+        const meta = document.createElement('div');
+        meta.className = 'bean-meta';
+        const roastSpan = document.createElement('span');
+        roastSpan.textContent = bean.roast;
+        const priceSpan = document.createElement('span');
+        priceSpan.textContent = bean.price;
+        meta.append(roastSpan, priceSpan);
+
+        const title = document.createElement('h3');
+        title.textContent = bean.name;
+
+        const desc = document.createElement('p');
+        desc.textContent = bean.notes;
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'btn-remove';
+        removeBtn.textContent = 'Remove from Box';
+        removeBtn.addEventListener('click', () => removeBean(bean.id));
+
+        body.append(meta, title, desc, removeBtn);
+        li.append(img, body);
+        listEl.appendChild(li);
+      }
+    }
+
+    function updateWithViewTransition(updateFn) {
+      if (document.startViewTransition) {
+        document.startViewTransition(() => {
+          updateFn();
+          renderBeanSelection();
+        });
+      } else {
+        updateFn();
+        renderBeanSelection();
+      }
+    }
+
+    function addSelectedBean() {
+      const beanId = selectEl.value;
+      const beanToAdd = BEAN_CATALOG.find((bean) => bean.id === beanId);
+      if (!beanToAdd) return;
+
+      updateWithViewTransition(() => {
+        selectedBeans = [...selectedBeans, beanToAdd];
+      });
+    }
+
+    function removeBean(beanId) {
+      updateWithViewTransition(() => {
+        selectedBeans = selectedBeans.filter((bean) => bean.id !== beanId);
+      });
+    }
+
+    function restoreAllBeans() {
+      updateWithViewTransition(() => {
+        selectedBeans = [...BEAN_CATALOG];
+      });
+    }
+
+    addBtn.addEventListener('click', addSelectedBean);
+    resetBtn.addEventListener('click', restoreAllBeans);
+
+    renderBeanSelection();
+  </script>
 </body>
 
