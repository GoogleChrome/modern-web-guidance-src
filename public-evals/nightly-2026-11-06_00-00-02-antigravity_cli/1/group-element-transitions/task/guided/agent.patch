+      font-size: 0.85rem;
+      cursor: pointer;
+      transition: background-color 0.2s, color 0.2s;
+    }
+
+    .btn-remove:hover {
+      background-color: #d32f2f;
+      color: white;
+    }
+
+    .empty-selection {
+      text-align: center;
+      padding: 32px;
+      background: white;
+      border-radius: 8px;
+      color: #6d4c41;
+      grid-column: 1 / -1;
+    }
+
+    ::view-transition {
+      /* Non-transitioned elements below the view transitions remain interactive */
+      pointer-events: none;
+    }
+
+    /* Targets any view transition group that has the 'bean-card' class */
+    ::view-transition-group(.bean-card) {
+      animation-duration: 0.45s;
+      animation-timing-function: ease-in-out;
+    }
+
+    /* Added element entry animation */
+    ::view-transition-new(.bean-card):only-child {
+      animation-name: bean-slide-in;
+      animation-duration: 0.45s;
+      animation-timing-function: ease-out;
+    }
+
+    /* Removed element exit animation */
+    ::view-transition-old(.bean-card):only-child {
+      animation-name: bean-slide-out;
+      animation-duration: 0.45s;
+      animation-timing-function: ease-in;
+    }
+
+    @keyframes bean-slide-in {
+      from {
+        opacity: 0;
+        translate: 0 24px;
+        scale: 0.92;
+      }
+    }
+
+    @keyframes bean-slide-out {
+      to {
+        opacity: 0;
+        translate: 0 -24px;
+        scale: 0.92;
+      }
+    }
+
+    /* Handle accessibility by respecting motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      /* Disable all group transitions, including the default `root` group. */
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
