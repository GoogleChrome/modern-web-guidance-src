diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,387 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Nexus Cloud — Deploy at the Speed of Thought</title>
+
+  <link rel="preconnect" href="https://cdn.example.com">
+
+  <!--
+    MANDATORY: Both `async` and `blocking="render"` are required.
+    - `async`: Prevents parser-blocking, so the DOM is built in parallel.
+    - `blocking="render"`: Holds rendering until the script executes,
+      ensuring experiment changes are applied before the user sees anything.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // DO: Only apply the anti-flicker fallback in browsers
+    // that do not support blocking="render".
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      // Hide the page until the experiment script runs.
+      document.documentElement.classList.add('ab-loading');
+
+      // DO: Set a timeout to reveal the page if the experiment
+      // script takes too long. This prevents an indefinitely
+      // blank page on slow connections.
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+
+    // In the experiment SDK's initialization callback, remove the fallback class to reveal the page.
+    function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    }
+    window.onExperimentReady = onExperimentReady;
+  </script>
+
+  <style>
+    @layer base, theme, components;
+
+    /*
+      DO: Use opacity to hide content during experiment loading.
+      This is only applied when blocking="render" is unsupported.
+    */
+    .ab-loading {
+      opacity: 0 !important;
+    }
+
+    @layer theme {
+      :root {
+        color-scheme: light dark;
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+        --color-bg: light-dark(#f8fafc, #090d16);
+        --color-surface: light-dark(#ffffff, #111827);
+        --color-text: light-dark(#0f172a, #f8fafc);
+        --color-text-muted: light-dark(#475569, #94a3b8);
+        --color-border: light-dark(#e2e8f0, #1e293b);
+        --color-primary: #2563eb;
+        --color-primary-hover: #1d4ed8;
+        --color-primary-contrast: #ffffff;
+        --color-variant-b: #059669;
+        --color-variant-b-hover: #047857;
+        --radius-md: 0.5rem;
+        --radius-lg: 1rem;
+        --radius-pill: 9999px;
+        --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
+        --space-xs: 0.5rem;
+        --space-sm: 0.75rem;
+        --space-md: 1rem;
+        --space-lg: 1.5rem;
+        --space-xl: 2.5rem;
+        --space-2xl: 4rem;
+      }
+
+      /* Variant B overrides keyed to data-variant attribute on <html> or <body> */
+      :root[data-variant="b"],
+      body[data-variant="b"] {
+        --color-primary: var(--color-variant-b);
+        --color-primary-hover: var(--color-variant-b-hover);
+      }
+    }
+
+    @layer base {
+      body {
+        margin: 0;
+        font-family: var(--font-sans);
+        background-color: var(--color-bg);
+        color: var(--color-text);
+        line-height: 1.6;
+      }
+
+      h1, h2, h3, p {
+        margin-block: 0;
+      }
+
+      img {
+        max-inline-size: 100%;
+        block-size: auto;
+        display: block;
+      }
+    }
+
+    @layer components {
+      .site-header {
+        border-block-end: 1px solid var(--color-border);
+        background-color: var(--color-surface);
+        padding-block: var(--space-md);
+        padding-inline: var(--space-lg);
+      }
+
+      .nav-container {
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: var(--space-md);
+      }
+
+      .brand {
+        font-weight: 700;
+        font-size: 1.25rem;
+        color: var(--color-text);
+        text-decoration: none;
+        display: inline-flex;
+        align-items: center;
+        gap: var(--space-xs);
+      }
+
+      .nav-links {
+        list-style: none;
+        margin: 0;
+        padding: 0;
+        display: flex;
+        gap: var(--space-lg);
+
+        & a {
+          color: var(--color-text-muted);
+          text-decoration: none;
+          font-weight: 500;
+          transition: color 0.15s ease;
+
+          &:hover,
+          &:focus-visible {
+            color: var(--color-text);
+          }
+        }
+      }
+
+      .hero {
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: var(--space-2xl);
+        padding-inline: var(--space-lg);
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
+        gap: var(--space-2xl);
+        align-items: center;
+      }
+
+      .hero-content {
+        display: flex;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: var(--space-lg);
+      }
+
+      .badge {
+        display: inline-flex;
+        align-items: center;
+        gap: var(--space-xs);
+        padding-block: 0.25rem;
+        padding-inline: var(--space-sm);
+        border-radius: var(--radius-pill);
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        font-size: 0.875rem;
+        font-weight: 600;
+        color: var(--color-primary);
+      }
+
+      .hero-title {
+        font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
+        line-height: 1.15;
+        letter-spacing: -0.02em;
+        font-weight: 800;
+      }
+
+      .hero-subtitle {
+        font-size: 1.125rem;
+        color: var(--color-text-muted);
+        max-inline-size: 55ch;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: var(--space-md);
+        margin-block-start: var(--space-xs);
+      }
+
+      .cta-button {
+        appearance: none;
+        border: none;
+        border-radius: var(--radius-md);
+        background-color: var(--color-primary);
+        color: var(--color-primary-contrast);
+        font-family: inherit;
+        font-size: 1rem;
+        font-weight: 600;
+        padding-block: var(--space-sm);
+        padding-inline: var(--space-xl);
+        cursor: pointer;
+        display: inline-flex;
+        align-items: center;
+        gap: var(--space-xs);
+        box-shadow: var(--shadow-lg);
+        transition: background-color 0.15s ease, transform 0.15s ease;
+
+        &:hover:not(:disabled) {
+          background-color: var(--color-primary-hover);
+          transform: translateY(-1px);
+        }
+
+        &:focus-visible {
+          outline: 3px solid var(--color-primary);
+          outline-offset: 2px;
+        }
+      }
+
+      .secondary-link {
+        color: var(--color-text);
+        font-weight: 600;
+        text-decoration: none;
+        padding-block: var(--space-sm);
+        padding-inline: var(--space-md);
+        border-radius: var(--radius-md);
+        border: 1px solid var(--color-border);
+        background-color: var(--color-surface);
+        transition: border-color 0.15s ease;
+
+        &:hover,
+        &:focus-visible {
+          border-color: var(--color-text-muted);
+        }
+      }
+
+      .hero-visual {
+        border-radius: var(--radius-lg);
+        overflow: hidden;
+        border: 1px solid var(--color-border);
+        box-shadow: var(--shadow-lg);
+        background-color: var(--color-surface);
+      }
+
+      .features {
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: var(--space-xl);
+        padding-inline: var(--space-lg);
+        border-block-start: 1px solid var(--color-border);
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
+        gap: var(--space-lg);
+      }
+
+      .feature-card {
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        border-radius: var(--radius-md);
+        padding: var(--space-lg);
+        display: flex;
+        flex-direction: column;
+        gap: var(--space-xs);
+
+        & h2 {
+          font-size: 1.125rem;
+          font-weight: 700;
+        }
+
+        & p {
+          font-size: 0.9375rem;
+          color: var(--color-text-muted);
+        }
+      }
+
+      .site-footer {
+        border-block-start: 1px solid var(--color-border);
+        padding-block: var(--space-lg);
+        padding-inline: var(--space-lg);
+        text-align: center;
+        color: var(--color-text-muted);
+        font-size: 0.875rem;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <nav class="nav-container" aria-label="Primary navigation">
+      <a href="/" class="brand">
+        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
+          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
+          <polyline points="2 17 12 22 22 17"></polyline>
+          <polyline points="2 12 12 17 22 12"></polyline>
+        </svg>
+        <span>Nexus Cloud</span>
+      </a>
+      <ul class="nav-links">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#docs">Documentation</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-heading">
+      <div class="hero-content">
+        <span class="badge" data-experiment-target="hero-badge">Edge Network v4.2 Live</span>
+        <h1 id="hero-heading" class="hero-title" data-experiment-target="hero-title">
+          Deploy globally in milliseconds, not hours.
+        </h1>
+        <p class="hero-subtitle" data-experiment-target="hero-subtitle">
+          Zero-configuration edge compute, automated canary rollouts, and instant observability built for high-velocity engineering teams.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            id="hero-cta"
+            class="cta-button"
+            data-experiment-target="hero-cta"
+          >
+            <span>Start Free Trial</span>
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
+              <line x1="5" y1="12" x2="19" y2="12"></line>
+              <polyline points="12 5 19 12 12 19"></polyline>
+            </svg>
+          </button>
+          <a href="#docs" class="secondary-link">Explore Architecture</a>
+        </div>
+      </div>
+
+      <div class="hero-visual">
+        <img
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80 1200w
+          "
+          sizes="(max-width: 768px) 100vw, 50vw"
+          alt="Real-time analytics and deployment telemetry dashboard"
+          width="1200"
+          height="800"
+          fetchpriority="high"
+        >
+      </div>
+    </section>
+
+    <section id="features" class="features" aria-label="Platform capabilities">
+      <article class="feature-card">
+        <h2>Instant Rollbacks</h2>
+        <p>Revert to any previous immutable deployment snapshot across 300+ edge locations in under 50ms.</p>
+      </article>
+      <article class="feature-card">
+        <h2>Deterministic Builds</h2>
+        <p>Every commit builds inside an isolated micro-VM with cryptographic provenance and caching.</p>
+      </article>
+      <article class="feature-card">
+        <h2>Live Telemetry</h2>
+        <p>Stream structured logs, Core Web Vitals, and distributed traces with zero sampling lag.</p>
+      </article>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <p>&copy; 2026 Nexus Cloud Inc. All rights reserved.</p>
+  </footer>
+</body>
+</html>
