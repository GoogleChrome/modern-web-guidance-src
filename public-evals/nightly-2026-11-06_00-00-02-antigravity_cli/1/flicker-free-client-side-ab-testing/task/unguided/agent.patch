+  <!-- Early connection hints to reduce A/B testing script latency -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="dns-prefetch" href="https://cdn.example.com" />
+  <link rel="preload" href="https://cdn.example.com/experiment-sdk.js" as="script" />
+
+  <!-- Anti-flicker snippet: hides experiment content (preserving layout to avoid CLS) until variant is applied or fallback triggers -->
+  <style id="ab-antiflicker-style">
+    html.async-hide body {
+      opacity: 0 !important;
+      visibility: hidden !important;
+    }
+  </style>
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var revealed = false;
+      var domReady = false;
+
+      document.addEventListener('DOMContentLoaded', function () {
+        domReady = true;
+      });
+
+      function revealContent() {
+        if (revealed) return;
+        revealed = true;
+        root.classList.remove('async-hide');
+        var sdkScript = document.getElementById('experiment-sdk');
+        if (sdkScript && sdkScript.hasAttribute('blocking')) {
+          sdkScript.removeAttribute('blocking');
+        }
+      }
+
+      // Expose reveal helper globally and setup failsafe timeout so a slow/failed CDN never leaves the page blank
+      window.__revealABContent = revealContent;
+      var fallbackTimer = setTimeout(revealContent, 1000);
+
+      window.__onExperimentLoaded = function () {
+        clearTimeout(fallbackTimer);
+        if (!domReady && document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', revealContent, { once: true });
+        } else {
+          // Queue after any DOMContentLoaded listeners registered by the experiment SDK
+          document.addEventListener('DOMContentLoaded', revealContent, { once: true });
+          setTimeout(revealContent, 0);
+        }
+      };
+
+      window.__onExperimentError = function () {
+        clearTimeout(fallbackTimer);
+        revealContent();
+      };
+    })();
+  </script>
+
+  <!-- Load A/B testing SDK with defer + blocking="render" + fetchpriority="high"
+       so HTML parsing is not blocked, the DOM is ready when the SDK runs,
+       and initial paint waits until the variant is applied. -->
+  <script
+    id="experiment-sdk"
+    src="https://cdn.example.com/experiment-sdk.js"
+    defer
+    blocking="render"
+    fetchpriority="high"
+    onload="window.__onExperimentLoaded && window.__onExperimentLoaded()"
+    onerror="window.__onExperimentError && window.__onExperimentError()"
+  ></script>
