+            credentialId: newCredentialId,
+            name: newName,
+            provider: 'Browser Password Manager',
+            createdAt: 'Just now',
+            lastUsedAt: 'Just now',
+            synced: true,
+            icon: '🔑'
+          };
+
+          passkeys.push(newPasskey);
+          savePasskeys(passkeys);
+          renderPasskeys();
+
+          await syncPasskeysWithAuthenticator({
+            statusMessage: `Registered new passkey "${newPasskey.name}" and synced with browser authenticator.`
+          });
+        });
+      }
+
+      // Smooth navigation handling for "My Account" link while keeping window state alive
+      document.querySelectorAll('a[href="/account"], a[href="#account"]').forEach(link => {
+        link.addEventListener('click', (e) => {
