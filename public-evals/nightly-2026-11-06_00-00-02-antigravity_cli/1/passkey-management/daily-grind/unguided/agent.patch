+          const renameBtn = e.target.closest('button[data-action="rename"]');
+          if (renameBtn) {
+            const credId = renameBtn.getAttribute('data-credential-id');
+            if (editingCredentialId === credId) {
+              // If already open, check if user typed a new name and clicked Rename again to save
+              const activeForm = passkeyListEl.querySelector(`form[data-rename-form="${CSS.escape(credId)}"]`);
