+        } catch (err) {
+          // Ignore storage errors
+        }
+        return DEFAULT_PASSKEYS.map(pk => ({ ...pk }));
+      }
+
+      function savePasskeys(list) {
+        try {
+          localStorage.setItem(STORAGE_KEY_PASSKEYS, JSON.stringify(list));
+        } catch (err) {
+          // Ignore storage errors
+        }
+      }
+
+      let currentUser = loadUser();
+      let passkeys = loadPasskeys();
+      let editingCredentialId = null;
+
+      const passkeyListEl = document.getElementById('passkey-list');
+      const syncStatusMessageEl = document.getElementById('sync-status-message');
+      const syncLastMethodEl = document.getElementById('sync-last-method');
+      const acceptedCountEl = document.getElementById('accepted-count');
+      const rpIdDisplayEl = document.getElementById('rp-id-display');
+      const profileDisplayNameEl = document.getElementById('profile-display-name');
+      const headerUserEmailEl = document.getElementById('header-user-email');
+      const userDisplayNameInput = document.getElementById('user-display-name-input');
+      const userNameInput = document.getElementById('user-name-input');
+      const userIdDisplayEl = document.getElementById('user-id-display');
+      const userAvatarEl = document.getElementById('user-avatar');
+
+      function updateStatusBanner(message, methodInfo) {
+        if (syncStatusMessageEl) {
+          syncStatusMessageEl.textContent = message;
+        }
+        if (syncLastMethodEl && methodInfo) {
+          syncLastMethodEl.textContent = methodInfo;
+        }
+        if (acceptedCountEl) {
+          acceptedCountEl.textContent = String(passkeys.length);
+        }
+        if (rpIdDisplayEl) {
+          rpIdDisplayEl.textContent = getRpId();
+        }
+      }
+
+      // Synchronize accepted passkey credentials with the browser authenticator via WebAuthn Signal API
+      async function syncPasskeysWithAuthenticator(options = {}) {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = passkeys.map(pk => pk.credentialId);
+        const signalsCalled = [];
+
+        try {
+          if (typeof window.PublicKeyCredential !== 'undefined') {
+            // 1. Signal all currently accepted credential IDs for the signed-in user
+            if (typeof window.PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+              await window.PublicKeyCredential.signalAllAcceptedCredentials({
+                rpId: rpId,
+                userId: currentUser.userId,
+                allAcceptedCredentialIds: allAcceptedCredentialIds
+              });
+              signalsCalled.push('signalAllAcceptedCredentials');
+            }
+
+            // 2. If a specific credential was deleted, also signal unknown credential if supported
+            if (options.deletedCredentialId && typeof window.PublicKeyCredential.signalUnknownCredential === 'function') {
+              await window.PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId,
+                credentialId: options.deletedCredentialId
+              });
+              signalsCalled.push('signalUnknownCredential');
+            }
+
+            // 3. If user details or labels were updated, signal current user details if supported
+            if (options.syncUserDetails && typeof window.PublicKeyCredential.signalCurrentUserDetails === 'function') {
+              await window.PublicKeyCredential.signalCurrentUserDetails({
+                rpId: rpId,
+                userId: currentUser.userId,
+                name: currentUser.name,
+                displayName: currentUser.displayName
+              });
+              signalsCalled.push('signalCurrentUserDetails');
+            }
+          }
+        } catch (err) {
+          console.warn('WebAuthn Signal API call warning:', err);
+        }
+
+        const methodBadge = signalsCalled.length > 0
+          ? 'Synced via ' + signalsCalled[0]
+          : 'Synced (' + allAcceptedCredentialIds.length + ' accepted)';
+
+        if (options.statusMessage) {
+          updateStatusBanner(options.statusMessage, methodBadge);
+        } else {
+          updateStatusBanner(
+            'Browser authenticator is in sync (' + allAcceptedCredentialIds.length + ' active ' + (allAcceptedCredentialIds.length === 1 ? 'passkey' : 'passkeys') + ' accepted).',
+            methodBadge
+          );
+        }
+      }
+
+      function renderUserProfile() {
+        if (profileDisplayNameEl) profileDisplayNameEl.textContent = currentUser.displayName;
+        if (headerUserEmailEl) headerUserEmailEl.textContent = currentUser.name;
+        if (userDisplayNameInput) userDisplayNameInput.value = currentUser.displayName;
+        if (userNameInput) userNameInput.value = currentUser.name;
+        if (userIdDisplayEl) userIdDisplayEl.textContent = currentUser.userId;
+        if (userAvatarEl) {
+          const initials = currentUser.displayName
+            .split(/\s+/)
+            .filter(Boolean)
+            .slice(0, 2)
+            .map(part => part[0].toUpperCase())
+            .join('');
+          userAvatarEl.textContent = initials || 'DG';
+        }
+      }
+
+      function escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#039;');
+      }
+
+      function renderPasskeys() {
+        if (!passkeyListEl) return;
+
+        if (acceptedCountEl) {
+          acceptedCountEl.textContent = String(passkeys.length);
+        }
+
+        if (passkeys.length === 0) {
+          passkeyListEl.innerHTML = `
+            <li class="empty-state" data-testid="empty-passkeys">
+              <p><strong>No registered passkeys found on your account.</strong></p>
+              <p>All previously registered passkeys have been removed from your account and browser authenticator.</p>
+              <button type="button" class="btn-sm btn-outline" id="restore-default-passkeys-btn">Restore Sample Passkeys</button>
+            </li>
+          `;
+          const restoreBtn = document.getElementById('restore-default-passkeys-btn');
+          if (restoreBtn) {
+            restoreBtn.addEventListener('click', () => {
+              passkeys = DEFAULT_PASSKEYS.map(pk => ({ ...pk }));
+              editingCredentialId = null;
+              savePasskeys(passkeys);
+              renderPasskeys();
+              syncPasskeysWithAuthenticator({
+                statusMessage: 'Restored sample passkeys and synchronized browser authenticator.'
+              });
+            });
+          }
+          return;
+        }
+
+        passkeyListEl.innerHTML = passkeys.map((pk) => {
+          const isEditing = editingCredentialId === pk.credentialId;
+          const shortId = pk.credentialId.length > 16
+            ? pk.credentialId.slice(0, 10) + '…' + pk.credentialId.slice(-4)
+            : pk.credentialId;
+
+          return `
+            <li class="passkey-item" data-credential-id="${escapeHtml(pk.credentialId)}" data-testid="passkey-item">
+              <div class="passkey-info">
+                <div class="passkey-icon" aria-hidden="true">${pk.icon || '🔑'}</div>
+                <div class="passkey-details">
+                  <div class="passkey-title-row">
+                    <span class="passkey-name" data-testid="passkey-name">${escapeHtml(pk.name)}</span>
+                    <span class="passkey-badge ${pk.synced ? 'synced' : ''}">
+                      ${pk.synced ? 'Synced Passkey' : 'Device-Bound'}
+                    </span>
+                  </div>
+                  <div class="passkey-meta">
+                    <span>Provider: <strong>${escapeHtml(pk.provider || 'Browser Authenticator')}</strong></span>
+                    <span>Created: ${escapeHtml(pk.createdAt)}</span>
+                    <span>Last used: ${escapeHtml(pk.lastUsedAt)}</span>
+                    <span>ID: <code class="passkey-id-code" title="${escapeHtml(pk.credentialId)}">${escapeHtml(shortId)}</code></span>
+                  </div>
+                  <form class="rename-form" data-rename-form="${escapeHtml(pk.credentialId)}" ${isEditing ? '' : 'hidden'}>
+                    <input
+                      type="text"
+                      class="rename-input"
+                      name="passkeyName"
+                      value="${escapeHtml(pk.name)}"
+                      aria-label="New name for ${escapeHtml(pk.name)}"
+                      placeholder="Enter passkey name"
+                      required
+                    />
+                    <button type="submit" class="btn-sm btn-primary btn-save-rename">Save</button>
+                    <button type="button" class="btn-sm btn-outline btn-cancel-rename" data-cancel-id="${escapeHtml(pk.credentialId)}">Cancel</button>
+                  </form>
+                </div>
+              </div>
+              <div class="passkey-controls">
+                <button
+                  type="button"
+                  class="btn-sm btn-outline btn-rename"
+                  data-action="rename"
+                  data-credential-id="${escapeHtml(pk.credentialId)}"
+                  aria-label="Rename ${escapeHtml(pk.name)}"
+                >
+                  Rename
+                </button>
+                <button
+                  type="button"
+                  class="btn-sm btn-danger btn-delete"
+                  data-action="delete"
+                  data-credential-id="${escapeHtml(pk.credentialId)}"
+                  aria-label="Delete ${escapeHtml(pk.name)}"
+                >
+                  Delete
+                </button>
+              </div>
+            </li>
+          `;
+        }).join('');
+
+        // Focus active rename input if editing
+        if (editingCredentialId) {
+          const activeForm = passkeyListEl.querySelector(`form[data-rename-form="${CSS.escape(editingCredentialId)}"]`);
+          if (activeForm) {
+            const input = activeForm.querySelector('.rename-input');
+            if (input) {
+              input.focus();
+              input.select();
+            }
+          }
+        }
+      }
+
+      // Rename a passkey by credentialId
+      async function renamePasskey(credentialId, newName) {
+        const trimmed = (newName || '').trim();
+        if (!trimmed) return;
+
+        const target = passkeys.find(pk => pk.credentialId === credentialId);
+        if (!target) return;
+
+        target.name = trimmed;
+        editingCredentialId = null;
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncPasskeysWithAuthenticator({
+          syncUserDetails: true,
+          statusMessage: `Passkey renamed to "${trimmed}" and browser authenticator synced.`
+        });
+      }
+
+      // Delete a passkey by credentialId and sync browser authenticator
+      async function deletePasskey(credentialId) {
+        const index = passkeys.findIndex(pk => pk.credentialId === credentialId);
+        if (index === -1) return;
+
+        const [removed] = passkeys.splice(index, 1);
+        if (editingCredentialId === credentialId) {
+          editingCredentialId = null;
+        }
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncPasskeysWithAuthenticator({
+          deletedCredentialId: removed.credentialId,
+          statusMessage: `Deleted passkey "${removed.name}". Browser authenticator updated (${passkeys.length} remaining).`
+        });
+      }
+
+      // Delegate click and form submit events inside passkey list
+      if (passkeyListEl) {
+        passkeyListEl.addEventListener('click', (e) => {
+          const renameBtn = e.target.closest('button[data-action="rename"]');
+          if (renameBtn) {
+            const credId = renameBtn.getAttribute('data-credential-id');
+            if (editingCredentialId === credId) {
+              // If already open, check if user typed a new name and clicked Rename again to save
+              const activeForm = passkeyListEl.querySelector(`form[data-rename-form="${CSS.escape(credId)}"]`);
+              const input = activeForm && activeForm.querySelector('.rename-input');
+              const target = passkeys.find(pk => pk.credentialId === credId);
+              if (input && target && input.value.trim() && input.value.trim() !== target.name) {
+                renamePasskey(credId, input.value);
+                return;
+              }
+            }
+            editingCredentialId = credId;
+            renderPasskeys();
+            return;
+          }
+
+          const cancelBtn = e.target.closest('button.btn-cancel-rename');
+          if (cancelBtn) {
+            editingCredentialId = null;
+            renderPasskeys();
+            return;
+          }
+
+          const deleteBtn = e.target.closest('button[data-action="delete"]');
+          if (deleteBtn) {
+            const credId = deleteBtn.getAttribute('data-credential-id');
+            deletePasskey(credId);
+          }
+        });
+
+        passkeyListEl.addEventListener('submit', (e) => {
+          const form = e.target.closest('form[data-rename-form]');
+          if (form) {
+            e.preventDefault();
+            const credId = form.getAttribute('data-rename-form');
+            const input = form.querySelector('.rename-input');
+            if (credId && input) {
+              renamePasskey(credId, input.value);
+            }
+          }
+        });
+      }
+
+      // Handle Profile Form Updates -> calls PublicKeyCredential.signalCurrentUserDetails
+      const profileForm = document.getElementById('profile-form');
+      if (profileForm) {
+        profileForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const newDisplayName = (userDisplayNameInput.value || '').trim();
+          const newName = (userNameInput.value || '').trim();
+          if (!newDisplayName || !newName) return;
+
+          currentUser.displayName = newDisplayName;
+          currentUser.name = newName;
+          saveUser(currentUser);
+          renderUserProfile();
+
+          await syncPasskeysWithAuthenticator({
+            syncUserDetails: true,
+            statusMessage: `Account details updated for ${newDisplayName} and synced with browser authenticator.`
+          });
+        });
+      }
+
+      // Handle manual Sync Authenticator button
+      const syncBtn = document.getElementById('sync-authenticator-btn');
+      if (syncBtn) {
+        syncBtn.addEventListener('click', () => {
+          syncPasskeysWithAuthenticator({
+            syncUserDetails: true,
+            statusMessage: `Synchronized ${passkeys.length} accepted passkey(s) with browser authenticator.`
+          });
+        });
+      }
+
+      // Handle Add Passkey button
+      const addPasskeyBtn = document.getElementById('add-passkey-btn');
+      if (addPasskeyBtn) {
+        addPasskeyBtn.addEventListener('click', async () => {
+          const rpId = getRpId();
+          let newCredentialId = 'Y3JlZC1kYWlseS1ncmluZC1rZXkt' + String(Date.now()).slice(-4);
+          let newName = 'Chrome on ' + (navigator.platform || 'Desktop');
+
+          try {
+            if (navigator.credentials && typeof navigator.credentials.create === 'function') {
+              const challenge = new Uint8Array(32);
+              if (window.crypto && window.crypto.getRandomValues) {
+                window.crypto.getRandomValues(challenge);
+              }
+              const userIdBytes = new TextEncoder().encode(currentUser.userId);
+              const cred = await navigator.credentials.create({
+                publicKey: {
+                  challenge,
+                  rp: { name: 'The Daily Grind', id: rpId },
+                  user: {
+                    id: userIdBytes,
+                    name: currentUser.name,
+                    displayName: currentUser.displayName
+                  },
+                  pubKeyCredParams: [
+                    { type: 'public-key', alg: -7 },
+                    { type: 'public-key', alg: -257 }
+                  ],
+                  authenticatorSelection: {
+                    residentKey: 'required',
+                    userVerification: 'preferred'
+                  },
+                  excludeCredentials: passkeys.map(pk => ({
+                    type: 'public-key',
+                    id: new TextEncoder().encode(pk.credentialId)
+                  }))
+                }
+              });
