+            accountSection.scrollIntoView({ behavior: 'smooth' });
+          }
+          syncPasskeysWithAuthenticator({ syncUserDetails: true });
+        });
+      });
+
+      // Initialize UI and sync on page load
+      renderUserProfile();
+      renderPasskeys();
+      syncPasskeysWithAuthenticator({ syncUserDetails: true });
+    })();
+  </script>
+</body>
