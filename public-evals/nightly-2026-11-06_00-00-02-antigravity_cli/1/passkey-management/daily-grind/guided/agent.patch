@@ -0,0 +1,556 @@
+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  listFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  deleteFetch,
+  optionsFetch,
+  registerVerifyFetch,
+  resetDemoCredentials
+} from './api.js';
+
+const FALLBACK_KEY_ICON = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234e342e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='7.5' cy='15.5' r='5.5'/><path d='m21 2-9.6 9.6'/><path d='m15.5 7.5 3 3L22 7l-3-3'/></svg>";
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value) {
+  return typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+/**
+ * Determine passkey provider metadata from AAGUID.
+ * Skips registry lookup when AAGUID is all-zero ('00000000-0000-0000-0000-000000000000').
+ */
+export function resolvePasskeyMetadata(cred) {
+  const { aaguid } = cred;
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: 'Unknown passkey provider',
+      displayName: cred.name || 'Unknown passkey provider',
+      providerIcon: undefined
+    };
+  }
+  const provider = aaguid ? aaguids[aaguid] : undefined;
+  const providerName = provider?.name || 'Unknown passkey provider';
+  return {
+    providerName,
+    displayName: cred.name || providerName,
+    providerIcon: cred.providerIcon || provider?.icon_light
+  };
+}
+
+function formatEpochDate(epochMs) {
+  if (!epochMs || typeof epochMs !== 'number') return null;
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric'
+    }).format(new Date(epochMs));
+  } catch (e) {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+function showStatusMessage(message, type = 'success') {
+  const banner = document.getElementById('passkey-status-banner');
+  if (!banner) return;
+  banner.textContent = message;
+  banner.className = `status-banner status-${type}`;
+  banner.hidden = false;
+}
+
+export async function syncAcceptedCredentials(rpId, userId, currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const credentialIds = currentCredentialsList.map(c => c.id); // Array of Base64URL credential ID strings
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.');
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds
+    });
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export function renderUserProfile(user) {
+  if (!user) return;
+  const nameInput = document.getElementById('account-username-input');
+  const displayNameInput = document.getElementById('account-displayname-input');
+  const profileHeadingName = document.getElementById('profile-heading-name');
+  const profileHeadingEmail = document.getElementById('profile-heading-email');
+  const profilePoints = document.getElementById('profile-rewards-points');
+
+  if (nameInput && document.activeElement !== nameInput) {
+    nameInput.value = user.name || '';
+  }
+  if (displayNameInput && document.activeElement !== displayNameInput) {
+    displayNameInput.value = user.displayName || '';
+  }
+  if (profileHeadingName) {
+    profileHeadingName.textContent = user.displayName || 'Customer';
+  }
+  if (profileHeadingEmail) {
+    profileHeadingEmail.textContent = user.name || '';
+  }
+  if (profilePoints && user.rewardsPoints !== undefined) {
+    profilePoints.textContent = `${user.rewardsPoints} pts`;
+  }
+}
+
+export function renderUI(credentials = []) {
+  const listContainer = document.getElementById('passkey-list');
+  const emptyState = document.getElementById('passkey-empty-state');
+  const countBadge = document.getElementById('passkey-count-badge');
+
+  if (countBadge) {
+    countBadge.textContent = `${credentials.length} ${credentials.length === 1 ? 'passkey' : 'passkeys'}`;
+  }
+
+  if (!listContainer) return;
+  listContainer.innerHTML = '';
+
+  if (!Array.isArray(credentials) || credentials.length === 0) {
+    listContainer.hidden = true;
+    if (emptyState) emptyState.hidden = false;
+    return;
+  }
+
+  listContainer.hidden = false;
+  if (emptyState) emptyState.hidden = true;
+
+  for (const cred of credentials) {
+    const { providerName, displayName, providerIcon } = resolvePasskeyMetadata(cred);
+    const registeredDateStr = formatEpochDate(cred.registeredAt) || 'Unknown';
+    const lastUsedDateStr = cred.lastUsedAt ? formatEpochDate(cred.lastUsedAt) : 'Never';
+    const syncBadgeText = cred.credentialBackedUp ? 'Synced' : 'Device-bound';
+
+    const li = document.createElement('li');
+    li.className = 'passkey-item';
+    li.dataset.credentialId = cred.id;
+
+    // Provider Icon
+    const iconWrapper = document.createElement('div');
+    iconWrapper.className = 'passkey-icon-wrapper';
+    const img = document.createElement('img');
+    img.className = 'passkey-provider-icon';
+    img.src = providerIcon || FALLBACK_KEY_ICON;
+    img.alt = `${providerName} icon`;
+    img.width = 32;
+    img.height = 32;
+    iconWrapper.appendChild(img);
+
+    // Details column
+    const details = document.createElement('div');
+    details.className = 'passkey-details';
+
+    const titleRow = document.createElement('div');
+    titleRow.className = 'passkey-title-row';
+
+    const nameEl = document.createElement('span');
+    nameEl.className = 'passkey-name';
+    nameEl.textContent = displayName;
+    titleRow.appendChild(nameEl);
+
+    if (displayName !== providerName && providerName !== 'Unknown passkey provider') {
+      const providerTag = document.createElement('span');
+      providerTag.className = 'passkey-provider-tag';
+      providerTag.textContent = providerName;
+      titleRow.appendChild(providerTag);
+    }
+
+    const syncTag = document.createElement('span');
+    syncTag.className = `passkey-sync-badge ${cred.credentialBackedUp ? 'is-synced' : 'is-device'}`;
+    syncTag.textContent = syncBadgeText;
+    titleRow.appendChild(syncTag);
+
+    const metaRow = document.createElement('div');
+    metaRow.className = 'passkey-meta-row';
+
+    const regSpan = document.createElement('span');
+    regSpan.className = 'passkey-date-registered';
+    regSpan.innerHTML = `<strong>Created:</strong> <time datetime="${new Date(cred.registeredAt).toISOString()}">${registeredDateStr}</time>`;
+
+    const usedSpan = document.createElement('span');
+    usedSpan.className = 'passkey-date-used';
+    if (cred.lastUsedAt) {
+      usedSpan.innerHTML = `<strong>Last used:</strong> <time datetime="${new Date(cred.lastUsedAt).toISOString()}">${lastUsedDateStr}</time>`;
+    } else {
+      usedSpan.innerHTML = `<strong>Last used:</strong> Never`;
+    }
+
+    metaRow.append(regSpan, usedSpan);
+    details.append(titleRow, metaRow);
+
+    // Actions column
+    const actions = document.createElement('div');
+    actions.className = 'passkey-actions';
+
+    const renameBtn = document.createElement('button');
+    renameBtn.type = 'button';
+    renameBtn.className = 'btn-secondary btn-sm passkey-rename-btn';
+    renameBtn.dataset.action = 'rename';
+    renameBtn.dataset.credentialId = cred.id;
+    renameBtn.dataset.credentialName = displayName;
+    renameBtn.setAttribute('aria-label', `Rename ${displayName}`);
+    renameBtn.textContent = 'Rename';
+
+    const deleteBtn = document.createElement('button');
+    deleteBtn.type = 'button';
+    deleteBtn.className = 'btn-danger btn-sm passkey-delete-btn';
+    deleteBtn.dataset.action = 'delete';
+    deleteBtn.dataset.credentialId = cred.id;
+    deleteBtn.dataset.credentialName = displayName;
+    deleteBtn.setAttribute('aria-label', `Delete ${displayName}`);
+    deleteBtn.textContent = 'Delete';
+
+    actions.append(renameBtn, deleteBtn);
+    li.append(iconWrapper, details, actions);
+    listContainer.appendChild(li);
+  }
+}
+
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { rpId, userId, credentials } = await updatedResponse.json();
+
+    renderUI(credentials);
+    showStatusMessage('Passkey deleted and synchronized with your authenticator.', 'success');
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(rpId, userId, credentials);
+  } else {
+    showStatusMessage('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const trimmed = (newCredentialName || '').trim();
+  if (!trimmed) {
+    showStatusMessage('Please enter a non-empty name for your passkey.', 'error');
+    return false;
+  }
+  const response = await renameCredentialFetch(credentialId, { name: trimmed });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const { credentials } = await updatedResponse.json();
+    renderUI(credentials);
+    showStatusMessage(`Passkey renamed to "${trimmed}".`, 'success');
+    return true;
+  }
+  showStatusMessage('Could not rename passkey. Please try again.', 'error');
+  return false;
+}
+
+// Renaming the user's account username or displayName triggers signalCurrentUserDetails
+export async function performUserRename(updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    const data = await response.json();
+    const { rpId, userId } = data;
+    renderUserProfile(data);
+    showStatusMessage('Account profile updated and synced with your passkey provider.', 'success');
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      if (!rpId || !isValidBase64Url(userId)) {
+        console.warn('SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.');
+        return;
+      }
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+          userId, // Base64URL-encoded user ID from the server
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName // Updated display name
+        });
+      } catch (e) {
+        // Use console.warn instead of console.error for passive background sync
+        console.warn('SignalCurrentUserDetails sync warning:', e);
+      }
+    }
+  } else {
+    showStatusMessage('Failed to update account profile.', 'error');
+  }
+}
+
+function showStandardPasswordFallbackUI() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+  if (createBtn) {
+    createBtn.hidden = true;
+    createBtn.disabled = true;
+  }
+  if (fallbackNotice) {
+    fallbackNotice.hidden = false;
+  }
+}
+
+async function gatePasskeyCreationUI() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    const supportsPlatformPasskey = Boolean(
+      capabilities?.passkeyPlatformAuthenticator ?? capabilities?.userVerifyingPlatformAuthenticator
+    );
+    const supportsConditionalGet = Boolean(capabilities?.conditionalGet);
+
+    if (!supportsPlatformPasskey || !supportsConditionalGet) {
+      showStandardPasswordFallbackUI();
+    } else {
+      if (createBtn) {
+        createBtn.hidden = false;
+        createBtn.disabled = false;
+      }
+      if (fallbackNotice) {
+        fallbackNotice.hidden = true;
+      }
+    }
+  } catch (e) {
+    console.warn('Could not detect passkey client capabilities:', e);
+    showStandardPasswordFallbackUI();
+  }
+}
+
+export async function registerPasskey(isPromotion = false) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  // Verify passkey capability and conditional UI are available
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  const supportsPlatformPasskey = Boolean(
+    capabilities?.passkeyPlatformAuthenticator ?? capabilities?.userVerifyingPlatformAuthenticator
+  );
+  if (!supportsPlatformPasskey || !capabilities?.conditionalGet) {
+    // Hide "Create passkey" buttons and fall back to password/MFA flows instead
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    // passkey prompt execution
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showStatusMessage('A passkey already exists on this authenticator for your Daily Grind account.', 'warning');
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showStatusMessage('Configuration RP ID or Secure Context error while creating passkey.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showStatusMessage('Passkey creation was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (PublicKeyCredential.signalUnknownCredential) {
+        // Server verification failed to verify/authenticate the credential (orphaned)
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rp.id, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+          credentialId: encodedResponse.id // Base64URL-encoded credential ID
+        });
+      }
+      showStatusMessage('Passkey verification failed on the server.', 'error');
+      return;
+    }
+
+    const updatedResponse = await listFetch();
+    const { rpId, userId, credentials } = await updatedResponse.json();
+    renderUI(credentials);
+    showStatusMessage('New passkey registered to your Daily Grind account.', 'success');
+    await syncAcceptedCredentials(rpId, userId, credentials);
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId: publicKey.rp.id, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+        credentialId: encodedResponse.id // Base64URL-encoded credential ID
+      });
+    }
+    showStatusMessage('Network error during passkey verification.', 'error');
+  }
+}
+
+export async function loadManagementPanel() {
+  await gatePasskeyCreationUI();
+
+  const response = await listFetch();
+  const { rpId, userId, user, credentials } = await response.json();
+
+  renderUserProfile(user);
+  renderUI(credentials);
+  // Sync accepted credentials on initial load using server-provided rpId and userId
+  await syncAcceptedCredentials(rpId, userId, credentials);
+}
+
+function setupDialogsAndInteractions() {
+  const renameDialog = document.getElementById('rename-passkey-dialog');
+  const renameForm = document.getElementById('rename-passkey-form');
+  const renameInput = document.getElementById('rename-passkey-input');
+  const renameIdInput = document.getElementById('rename-passkey-id');
+
+  const deleteDialog = document.getElementById('delete-passkey-dialog');
+  const deleteNameSpan = document.getElementById('delete-passkey-target-name');
+  let pendingDeleteId = null;
+
+  // Fallback for browsers without closedby="any" support on <dialog>
+  if (typeof HTMLDialogElement !== 'undefined' && !('closedBy' in HTMLDialogElement.prototype)) {
+    for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+      dialog.addEventListener('click', (event) => {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+        if (isDialogContent) return;
+        dialog.close();
+      });
+    }
+  }
+
+  // Delegate Rename and Delete clicks in the passkey list
+  const listContainer = document.getElementById('passkey-list');
+  if (listContainer) {
+    listContainer.addEventListener('click', async (event) => {
+      const btn = event.target.closest('button[data-action]');
+      if (!btn) return;
+
+      const action = btn.dataset.action;
+      const credentialId = btn.dataset.credentialId;
+      const credentialName = btn.dataset.credentialName || 'Passkey';
+
+      if (action === 'rename') {
+        if (renameDialog && typeof renameDialog.showModal === 'function') {
+          renameIdInput.value = credentialId;
+          renameInput.value = credentialName;
+          renameDialog.returnValue = '';
+          renameDialog.showModal();
+          renameInput.select();
+        }
+      } else if (action === 'delete') {
+        if (deleteDialog && typeof deleteDialog.showModal === 'function') {
+          pendingDeleteId = credentialId;
+          if (deleteNameSpan) deleteNameSpan.textContent = credentialName;
+          deleteDialog.returnValue = '';
+          deleteDialog.showModal();
+        } else {
+          await performDelete(credentialId);
+        }
+      }
+    });
+  }
+
+  // Handle Rename Dialog submission
+  if (renameForm && renameDialog) {
+    renameForm.addEventListener('submit', async (event) => {
+      const submitter = event.submitter;
+      if (submitter && submitter.value === 'cancel') {
+        return; // Let method="dialog" close without saving
+      }
+      event.preventDefault();
+      const credId = renameIdInput.value;
+      const newName = renameInput.value;
+      const ok = await performCredentialRename(credId, newName);
+      if (ok) {
+        renameDialog.close('save');
+        renameDialog.returnValue = '';
+      }
+    });
+
+    renameDialog.addEventListener('close', () => {
+      renameDialog.returnValue = '';
+    });
+  }
+
+  // Handle Delete Confirmation Dialog
+  if (deleteDialog) {
+    deleteDialog.addEventListener('close', async () => {
+      const choice = deleteDialog.returnValue;
+      deleteDialog.returnValue = '';
+      if (choice === 'confirm-delete' && pendingDeleteId) {
+        const idToDelete = pendingDeleteId;
+        pendingDeleteId = null;
+        await performDelete(idToDelete);
+      } else {
+        pendingDeleteId = null;
+      }
+    });
+  }
+
+  // Handle Account Profile Rename Form (name / displayName + signalCurrentUserDetails)
+  const profileForm = document.getElementById('account-profile-form');
+  if (profileForm) {
+    profileForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const nameInput = document.getElementById('account-username-input');
+      const displayNameInput = document.getElementById('account-displayname-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (!updatedName || !updatedDisplayName) {
+        showStatusMessage('Both email/username and display name are required.', 'error');
+        return;
+      }
+      await performUserRename(updatedName, updatedDisplayName);
+    });
+  }
+
+  // Handle Create Passkey button
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+  if (createPasskeyBtn) {
+    createPasskeyBtn.addEventListener('click', async () => {
+      await registerPasskey(false);
+    });
+  }
+
+  // Handle Reset Demo Passkeys button
+  const resetDemoBtn = document.getElementById('reset-demo-passkeys-btn');
+  if (resetDemoBtn) {
+    resetDemoBtn.addEventListener('click', async () => {
+      resetDemoCredentials();
+      await loadManagementPanel();
+      showStatusMessage('Demo passkeys restored and synchronized.', 'info');
+    });
+  }
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  setupDialogsAndInteractions();
+  loadManagementPanel();
+});
