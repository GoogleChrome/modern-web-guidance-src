+import aaguids from './aaguids.json' with { type: 'json' };
+
+const STORAGE_KEY_CREDS = 'daily_grind_passkey_credentials_v1';
+const STORAGE_KEY_USER = 'daily_grind_user_profile_v1';
+
+// Predefined server RP ID (constant string matching registration rp.id)
+const SERVER_RP_ID = 'localhost';
+
+const DEFAULT_USER = {
+  id: 'usr_101',
+  passkeyUserId: 'ZGFpbHktZ3JpbmQtdXNlci0xMDE', // Valid unpadded Base64URL string ('daily-grind-user-101')
+  name: 'elena.rodriguez@dailygrind.coffee',
+  displayName: 'Elena Rodriguez',
+  memberSince: 'March 2024',
+  rewardsPoints: 480
+};
+
+// All credential IDs and passkeyUserId are strictly valid unpadded Base64URL strings ([A-Za-z0-9_-], no '=', length % 4 !== 1)
+const INITIAL_CREDENTIALS = [
+  {
+    id: 'dGVzdC1jcmVkLTE', // Base64URL for 'test-cred-1' (length 15, 15 % 4 === 3)
+    passkeyUserId: 'ZGFpbHktZ3JpbmQtdXNlci0xMDE',
+    credentialPublicKey: 'pQECAyYgASFYIJV8_X1k2b7jM5N9vR3pL8wK1qY4tH6gF0dE2cB9aZ0oIlgg7M4nP1rT5vX8zB2dF6hJ9lN3pQ7sU0wV4yA6cE8gI1k',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', // iCloud Keychain
+    providerIcon: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.icon_light,
+    name: 'iCloud Keychain',
+    transports: ['internal', 'hybrid'],
+    registeredAt: 1757862000000, // Sep 14, 2025
+    lastUsedAt: 1793881200000,   // Nov 5, 2026
+    counter: 14
+  },
+  {
+    id: 'dGVzdC1jcmVkLTI', // Base64URL for 'test-cred-2' (length 15, 15 % 4 === 3)
+    passkeyUserId: 'ZGFpbHktZ3JpbmQtdXNlci0xMDE',
+    credentialPublicKey: 'pQECAyYgASFYIKb9_Y2l3c8kN6O0wS4qM9xL2rZ5uI7hG1eF3dC0ba1pJmhh8N5oQ2sU6wY9aC3eG7iK0mO4qR8tV1xW5zB7dF9hJ2l',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', // Google Password Manager
+    providerIcon: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.icon_light,
+    name: 'Work Pixel 9 (Google Password Manager)',
+    transports: ['internal', 'hybrid'],
+    registeredAt: 1768489200000, // Jan 15, 2026
+    lastUsedAt: 1792498800000,   // Oct 20, 2026
+    counter: 6
+  },
+  {
+    id: 'dGVzdC1jcmVkLTM', // Base64URL for 'test-cred-3' (length 15, 15 % 4 === 3)
+    passkeyUserId: 'ZGFpbHktZ3JpbmQtdXNlci0xMDE',
+    credentialPublicKey: 'pQECAyYgASFYILc0_Z3m4d9lO7P1xT5rN0yM3sA6vJ8iH2fG4eD1cb2qKnii9O6pR3tV7xZ0bD4fH8jL1nP5rS9uW2yX6aC8eG0iK3m',
+    credentialType: 'public-key',
+    credentialDeviceType: 'singleDevice',
+    credentialBackedUp: false,
+    aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d', // 1Password
+    providerIcon: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.icon_light,
+    name: '1Password Vault',
+    transports: ['internal'],
+    registeredAt: 1775919600000, // Apr 11, 2026
+    lastUsedAt: undefined,
+    counter: 0
+  }
+];
+
+function getStoredUser() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_USER);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (parsed && parsed.passkeyUserId) return parsed;
+    }
+  } catch (e) {
+    // ignore storage errors
+  }
+  return { ...DEFAULT_USER };
+}
+
+function saveStoredUser(user) {
+  try {
+    localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));
+  } catch (e) {
+    // ignore storage errors
+  }
+}
+
+function getStoredCredentials() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_CREDS);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (Array.isArray(parsed)) return parsed;
+    }
+  } catch (e) {
+    // ignore storage errors
+  }
+  const initial = INITIAL_CREDENTIALS.map(c => ({ ...c }));
+  saveStoredCredentials(initial);
+  return initial;
+}
+
+function saveStoredCredentials(creds) {
+  try {
+    localStorage.setItem(STORAGE_KEY_CREDS, JSON.stringify(creds));
+  } catch (e) {
+    // ignore storage errors
+  }
+}
+
+function createJsonResponse(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+function generateRandomBase64Url(byteLength = 32) {
+  const bytes = new Uint8Array(byteLength);
+  if (globalThis.crypto && globalThis.crypto.getRandomValues) {
+    globalThis.crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < byteLength; i++) bytes[i] = Math.floor(Math.random() * 256);
+  }
+  const base64 = globalThis.btoa(String.fromCharCode(...bytes));
+  return base64.replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_');
+}
+
+export async function listFetch() {
+  const user = getStoredUser();
+  const credentials = getStoredCredentials();
+  return createJsonResponse({
+    rpId: SERVER_RP_ID,
+    userId: user.passkeyUserId,
+    user: {
+      name: user.name,
+      displayName: user.displayName,
+      memberSince: user.memberSince,
+      rewardsPoints: user.rewardsPoints
+    },
+    credentials
+  });
+}
+
+export async function renameCredentialFetch(credentialId, body) {
+  const credentials = getStoredCredentials();
+  const index = credentials.findIndex(c => c.id === credentialId);
+  if (index === -1) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  const trimmedName = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (!trimmedName) {
+    return createJsonResponse({ error: 'A valid passkey name is required.' }, 400);
+  }
+  credentials[index] = {
+    ...credentials[index],
+    name: trimmedName
+  };
+  saveStoredCredentials(credentials);
+  return createJsonResponse(credentials[index]);
+}
+
+export async function deleteFetch(credentialId) {
+  const credentials = getStoredCredentials();
+  const index = credentials.findIndex(c => c.id === credentialId);
+  if (index === -1) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  credentials.splice(index, 1);
+  saveStoredCredentials(credentials);
+  return createJsonResponse({ success: true });
+}
+
+export async function updateUserFetch(body) {
+  const user = getStoredUser();
+  const updatedUser = {
+    ...user,
+    name: typeof body?.name === 'string' && body.name.trim() ? body.name.trim() : user.name,
+    displayName: typeof body?.displayName === 'string' && body.displayName.trim() ? body.displayName.trim() : user.displayName
+  };
+  saveStoredUser(updatedUser);
+  return createJsonResponse({
+    ...updatedUser,
+    rpId: SERVER_RP_ID,
+    userId: updatedUser.passkeyUserId
+  });
+}
+
+export async function optionsFetch({ promotion = false } = {}) {
+  const user = getStoredUser();
+  const userExistingCredentials = getStoredCredentials();
+  const challenge = generateRandomBase64Url(32);
+
+  // Management flow omits authenticatorAttachment so external security keys and platform authenticators are both allowed
+  const options = {
+    challenge,
+    rp: {
+      id: SERVER_RP_ID,
+      name: 'The Daily Grind'
+    },
+    user: {
+      id: user.passkeyUserId,
+      name: user.name,
+      displayName: user.displayName
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 }
+    ],
+    excludeCredentials: userExistingCredentials.map(cred => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid']
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(promotion && { authenticatorAttachment: 'platform' })
+    }
+  };
+  return options;
+}
+
+export async function registerVerifyFetch(encodedResponse) {
+  if (!encodedResponse || !encodedResponse.id) {
+    return createJsonResponse({ error: 'Invalid attestation response' }, 400);
+  }
+  const user = getStoredUser();
+  const credentials = getStoredCredentials();
+
+  const aaguid = encodedResponse.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+  let resolvedName = 'Unknown passkey provider';
+  let resolvedIcon = undefined;
+
+  if (aaguid !== '00000000-0000-0000-0000-000000000000') {
+    const provider = aaguids[aaguid];
+    resolvedName = provider?.name || 'Unknown passkey provider';
+    resolvedIcon = provider?.icon_light;
+  }
+
+  const newCred = {
+    id: encodedResponse.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: encodedResponse.response?.attestationObject || 'pQECAyYgASFYIG5ldy1jcmVkZW50aWFsLXB1YmxpYy1rZXk',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid,
+    providerIcon: resolvedIcon,
+    name: resolvedName,
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    registeredAt: Date.now(),
+    lastUsedAt: Date.now(),
+    counter: 0
+  };
+
+  credentials.push(newCred);
+  saveStoredCredentials(credentials);
+  return createJsonResponse({ verified: true, credential: newCred });
+}
+
+export function resetDemoCredentials() {
+  const initial = INITIAL_CREDENTIALS.map(c => ({ ...c }));
+  saveStoredCredentials(initial);
+  saveStoredUser({ ...DEFAULT_USER });
+  return { user: { ...DEFAULT_USER }, credentials: initial };
+}
+
+// Install fetch interceptor so direct fetch('/api/...') requests also work seamlessly
+const originalFetch = globalThis.fetch?.bind(globalThis);
+if (originalFetch) {
+  globalThis.fetch = async function (input, init = {}) {
+    const urlStr = typeof input === 'string' ? input : (input?.url || '');
+    try {
+      const parsedUrl = new URL(urlStr, globalThis.location?.origin || 'http://localhost');
+      const pathname = parsedUrl.pathname;
+      const method = (init?.method || (typeof input === 'object' && input?.method) || 'GET').toUpperCase();
+
+      if (pathname === '/api/credentials' && method === 'GET') {
+        return listFetch();
+      }
+      if (pathname.startsWith('/api/credential/') && method === 'PUT') {
+        const id = decodeURIComponent(pathname.slice('/api/credential/'.length));
+        const body = init?.body ? JSON.parse(init.body) : {};
+        return renameCredentialFetch(id, body);
+      }
+      if (pathname.startsWith('/api/credential/') && method === 'DELETE') {
+        const id = decodeURIComponent(pathname.slice('/api/credential/'.length));
+        return deleteFetch(id);
+      }
+      if (pathname === '/api/user' && method === 'PUT') {
+        const body = init?.body ? JSON.parse(init.body) : {};
+        return updateUserFetch(body);
+      }
+      if (pathname === '/api/passkeys/register/options' && method === 'POST') {
+        const body = init?.body ? JSON.parse(init.body) : {};
+        const opts = await optionsFetch(body);
+        return createJsonResponse(opts);
+      }
+      if (pathname === '/api/passkeys/register/verify' && method === 'POST') {
+        const body = init?.body ? JSON.parse(init.body) : {};
+        return registerVerifyFetch(body);
+      }
+    } catch (e) {
+      // fall through to originalFetch
+    }
+    return originalFetch(input, init);
+  };
+}
