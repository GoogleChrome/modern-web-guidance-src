+  font-size: 0.92rem;
+  font-family: inherit;
+  border: 1px solid #c7b9b4;
+  border-radius: 6px;
+  background: #fff;
+  color: var(--text);
+}
+
+.form-control:focus {
+  outline: 2px solid var(--accent);
+  border-color: var(--primary);
+}
+
+.form-hint {
+  display: block;
+  font-size: 0.78rem;
+  color: var(--text-muted);
+  margin-top: 4px;
+}
+
+/* Passkey List */
+.passkey-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.passkey-item {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 16px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: #fcfaf9;
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.passkey-item:hover {
+  border-color: #bcaaa4;
+  box-shadow: 0 2px 6px rgba(78, 52, 46, 0.07);
+}
+
+.passkey-icon-wrapper {
+  width: 44px;
+  height: 44px;
+  border-radius: 10px;
+  background: white;
+  border: 1px solid var(--border);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.passkey-provider-icon {
+  width: 28px;
+  height: 28px;
+  object-fit: contain;
+}
+
+.passkey-details {
+  flex: 1;
+  min-width: 0;
+}
+
+.passkey-title-row {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 4px;
+}
+
+.passkey-name {
+  font-weight: 700;
+  font-size: 1rem;
+  color: var(--text);
+}
+
+.passkey-provider-tag {
+  font-size: 0.75rem;
+  background: #efebe9;
+  color: var(--text-muted);
+  padding: 2px 8px;
+  border-radius: 4px;
+}
+
+.passkey-sync-badge {
+  font-size: 0.74rem;
+  font-weight: 600;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+
+.passkey-sync-badge.is-synced {
+  background: #e8f5e9;
+  color: #2e7d32;
+}
+
+.passkey-sync-badge.is-device {
+  background: #eceff1;
+  color: #455a64;
+}
+
+.passkey-meta-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  font-size: 0.82rem;
+  color: var(--text-muted);
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 8px;
+  flex-shrink: 0;
+}
+
+@media (max-width: 560px) {
+  .passkey-item {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .passkey-actions {
+    width: 100%;
+    justify-content: flex-end;
+  }
+}
+
+.passkey-empty-state {
+  text-align: center;
+  padding: 32px 20px;
+  background: #fcfaf9;
+  border: 1px dashed #cbbdb8;
+  border-radius: 8px;
+  color: var(--text-muted);
+}
+
+.passkey-empty-state h4 {
+  color: var(--primary);
+  margin-bottom: 6px;
+}
+
+.passkey-fallback-box {
+  margin-top: 14px;
+  padding: 12px 16px;
+  border-radius: 8px;
+  background: #fff8e1;
+  border: 1px solid #ffe082;
+  color: #5d4037;
+  font-size: 0.86rem;
+}
+
+.passkey-footer-toolbar {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-top: 20px;
+  padding-top: 16px;
+  border-top: 1px solid var(--border);
+  font-size: 0.82rem;
+  color: var(--text-muted);
+}
+
+/* Native Modal Dialogs (Rule 1 from dialog guidance) */
+dialog {
+  margin: auto;
+  padding: 24px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  max-width: 440px;
+  width: calc(100% - 32px);
+  background: var(--surface);
+  color: var(--text);
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
+}
+
+/* MANDATORY: stop scroll gestures inside modal or backdrop from scrolling the page behind it */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background-color: rgba(30, 18, 15, 0.55);
+  backdrop-filter: blur(2px);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+dialog h2 {
+  font-size: 1.25rem;
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+dialog p {
+  font-size: 0.92rem;
+  color: var(--text-muted);
+  margin-bottom: 16px;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 20px;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 60px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
