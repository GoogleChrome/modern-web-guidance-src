+export interface PasskeyItem {
+  id: string;
+  credentialId: string;
+  displayName: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string;
+  deviceType: string;
+  transports: string[];
+  backedUp: boolean;
+}
+
+export interface ReaderAccount {
+  userId: string;
+  username: string;
+  displayName: string;
+  email: string;
+  subscriptionTier: string;
+  memberSince: string;
+  isSignedIn: boolean;
+}
+
+export const DEFAULT_READER_ACCOUNT: ReaderAccount = {
+  // Base64URL-encoded user handle ("user-alex-rivera-001")
+  userId: 'dXNlci1hbGV4LXJpdmVyYS0wMDE',
+  username: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+  email: 'alex.rivera@devtoolstimes.com',
+  subscriptionTier: 'Digital & Print All-Access',
+  memberSince: 'March 2023',
+  isSignedIn: true,
+};
+
+export const DEFAULT_PASSKEYS: PasskeyItem[] = [
+  {
+    id: 'Y3JlZC1tYWNib29rLXByby0wMDE',
+    credentialId: 'Y3JlZC1tYWNib29rLXByby0wMDE',
+    displayName: 'MacBook Pro (Chrome)',
+    name: 'MacBook Pro (Chrome)',
+    createdAt: '2025-08-14T10:30:00.000Z',
+    lastUsedAt: '2025-10-20T08:15:00.000Z',
+    deviceType: 'Synced passkey (Google Password Manager)',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'Y3JlZC1pcGhvbmUtMTYtcHJvLTAwMg',
+    credentialId: 'Y3JlZC1pcGhvbmUtMTYtcHJvLTAwMg',
+    displayName: 'iPhone 16 Pro',
+    name: 'iPhone 16 Pro',
+    createdAt: '2025-09-02T14:22:00.000Z',
+    lastUsedAt: '2025-10-18T19:45:00.000Z',
+    deviceType: 'Synced passkey (iCloud Keychain)',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'Y3JlZC1waXhlbC05LXByby0wMDM',
+    credentialId: 'Y3JlZC1waXhlbC05LXByby0wMDM',
+    displayName: 'YubiKey 5C NFC',
+    name: 'YubiKey 5C NFC',
+    createdAt: '2025-05-19T09:00:00.000Z',
+    lastUsedAt: '2025-07-01T11:10:00.000Z',
+    deviceType: 'Hardware security key',
+    transports: ['usb', 'nfc'],
+    backedUp: false,
+  },
+];
+
+// In-memory store fallback when session storage is not available across stateless calls
+let memoryAccount: ReaderAccount = { ...DEFAULT_READER_ACCOUNT };
+let memoryPasskeys: PasskeyItem[] = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+
+export async function getAccountFromSession(session?: any): Promise<ReaderAccount> {
+  if (session) {
+    const stored = await session.get('readerAccount');
+    if (stored) {
+      return stored;
+    }
+    await session.set('readerAccount', memoryAccount);
+  }
+  return memoryAccount;
+}
+
+export async function setAccountInSession(session: any, account: ReaderAccount): Promise<ReaderAccount> {
+  memoryAccount = { ...account };
+  if (session) {
+    await session.set('readerAccount', memoryAccount);
+  }
+  return memoryAccount;
+}
+
+export async function getPasskeysFromSession(session?: any): Promise<PasskeyItem[]> {
+  if (session) {
+    const stored = await session.get('passkeys');
+    if (Array.isArray(stored)) {
+      return stored;
+    }
+    await session.set('passkeys', memoryPasskeys);
+  }
+  return memoryPasskeys;
+}
+
+export async function setPasskeysInSession(session: any, passkeys: PasskeyItem[]): Promise<PasskeyItem[]> {
+  memoryPasskeys = passkeys.map((pk) => ({ ...pk }));
+  if (session) {
+    await session.set('passkeys', memoryPasskeys);
+  }
+  return memoryPasskeys;
+}
+
+export async function resetPasskeysInSession(session?: any): Promise<{ user: ReaderAccount; passkeys: PasskeyItem[] }> {
+  memoryAccount = { ...DEFAULT_READER_ACCOUNT };
+  memoryPasskeys = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+  if (session) {
+    await session.set('readerAccount', memoryAccount);
+    await session.set('passkeys', memoryPasskeys);
+  }
+  return { user: memoryAccount, passkeys: memoryPasskeys };
+}
