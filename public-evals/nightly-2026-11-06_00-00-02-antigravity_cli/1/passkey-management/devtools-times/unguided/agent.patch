diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..4e8e921
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,948 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  DevicePhoneMobileIcon,
+  ComputerDesktopIcon,
+  FingerPrintIcon,
+} from '@heroicons/react/24/outline';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_READER_ACCOUNT,
+  type PasskeyItem,
+  type ReaderAccount,
+} from '../utils/passkeyStore';
+import {
+  syncAllAcceptedCredentials,
+  syncCurrentUserDetails,
+  syncUnknownCredential,
+  bufferToBase64Url,
+  ensureBase64Url,
+  getRpId,
+  type AuthenticatorSyncEvent,
+} from '../utils/webauthnSignal';
+
+interface PasskeyManagerProps {
+  user?: ReaderAccount;
+  onUserUpdated?: (user: ReaderAccount) => void;
+}
+
+const STORAGE_KEYS = {
+  USER: 'devtools_times_reader_account',
+  PASSKEYS: 'devtools_times_passkeys',
+};
+
+export default function PasskeyManager({
+  user: externalUser,
+  onUserUpdated,
+}: PasskeyManagerProps) {
+  const [user, setUser] = useState<ReaderAccount>(
+    externalUser || DEFAULT_READER_ACCOUNT
+  );
+  const [passkeys, setPasskeys] = useState<PasskeyItem[]>(DEFAULT_PASSKEYS);
+  const [loading, setLoading] = useState<boolean>(false);
+
+  // User Display Name form state
+  const [readerDisplayName, setReaderDisplayName] = useState<string>(
+    (externalUser || DEFAULT_READER_ACCOUNT).displayName
+  );
+  const [readerUsername, setReaderUsername] = useState<string>(
+    (externalUser || DEFAULT_READER_ACCOUNT).username
+  );
+  const [savingUserDetails, setSavingUserDetails] = useState<boolean>(false);
+
+  // Per-passkey inline rename state
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(
+    null
+  );
+  const [editingDisplayName, setEditingDisplayName] = useState<string>('');
+
+  // New passkey registration state
+  const [newPasskeyName, setNewPasskeyName] = useState<string>('');
+  const [registering, setRegistering] = useState<boolean>(false);
+
+  // Feedback banner & WebAuthn Signal API sync log
+  const [feedback, setFeedback] = useState<{
+    type: 'success' | 'info' | 'error';
+    message: string;
+  } | null>(null);
+  const [syncEvents, setSyncEvents] = useState<AuthenticatorSyncEvent[]>([]);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const appendSyncEvents = useCallback(
+    (...events: AuthenticatorSyncEvent[]) => {
+      setSyncEvents((prev) => [...events, ...prev].slice(0, 10));
+    },
+    []
+  );
+
+  // Persist to localStorage for client-side continuity
+  const persistStateLocally = useCallback(
+    (nextUser: ReaderAccount, nextPasskeys: PasskeyItem[]) => {
+      try {
+        localStorage.setItem(STORAGE_KEYS.USER, JSON.stringify(nextUser));
+        localStorage.setItem(
+          STORAGE_KEYS.PASSKEYS,
+          JSON.stringify(nextPasskeys)
+        );
+      } catch {
+        // Ignore storage errors
+      }
+    },
+    []
+  );
+
+  // Sync External User prop if updated by parent
+  useEffect(() => {
+    if (externalUser) {
+      setUser(externalUser);
+      setReaderDisplayName(externalUser.displayName);
+      setReaderUsername(externalUser.username);
+    }
+  }, [externalUser]);
+
+  // Initial fetch of registered passkeys + initial authenticator sync
+  useEffect(() => {
+    let isMounted = true;
+
+    const loadPasskeysAndSync = async () => {
+      setLoading(true);
+      try {
+        const response = await fetch(`${baseUrl}api/passkeys.json`);
+        if (response.ok) {
+          const data = await response.json();
+          if (isMounted && data.user && Array.isArray(data.passkeys)) {
+            setUser(data.user);
+            setReaderDisplayName(data.user.displayName);
+            setReaderUsername(data.user.username);
+            setPasskeys(data.passkeys);
+            persistStateLocally(data.user, data.passkeys);
+            onUserUpdated?.(data.user);
+
+            // Signal accepted credentials and current user details on initial load
+            const acceptedEvent = await syncAllAcceptedCredentials({
+              userId: data.user.userId,
+              allAcceptedCredentialIds: data.passkeys.map(
+                (pk: PasskeyItem) => pk.credentialId
+              ),
+            });
+            const detailsEvent = await syncCurrentUserDetails({
+              userId: data.user.userId,
+              name: data.user.username,
+              displayName: data.user.displayName,
+            });
+            if (isMounted) {
+              appendSyncEvents(acceptedEvent, detailsEvent);
+            }
+          }
+        }
+      } catch {
+        // Fallback to localStorage or default state
+        try {
+          const storedUser = localStorage.getItem(STORAGE_KEYS.USER);
+          const storedKeys = localStorage.getItem(STORAGE_KEYS.PASSKEYS);
+          if (storedUser && isMounted) {
+            const parsedUser = JSON.parse(storedUser);
+            setUser(parsedUser);
+            setReaderDisplayName(parsedUser.displayName);
+            setReaderUsername(parsedUser.username);
+          }
+          if (storedKeys && isMounted) {
+            setPasskeys(JSON.parse(storedKeys));
+          }
+        } catch {
+          // Keep defaults
+        }
+      } finally {
+        if (isMounted) {
+          setLoading(false);
+        }
+      }
+    };
+
+    loadPasskeysAndSync();
+    return () => {
+      isMounted = false;
+    };
+  }, [baseUrl, appendSyncEvents, onUserUpdated, persistStateLocally]);
+
+  // Update the reader's Display Name (and username) + signal browser authenticator via signalCurrentUserDetails
+  const handleUpdateReaderDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = readerDisplayName.trim();
+    const trimmedUsername = readerUsername.trim() || user.username;
+    if (!trimmedDisplayName) {
+      setFeedback({
+        type: 'error',
+        message: 'Display name cannot be empty.',
+      });
+      return;
+    }
+
+    setSavingUserDetails(true);
+    setFeedback(null);
+
+    try {
+      let updatedUser: ReaderAccount = {
+        ...user,
+        displayName: trimmedDisplayName,
+        username: trimmedUsername,
+        email: trimmedUsername,
+      };
+
+      try {
+        const response = await fetch(`${baseUrl}api/passkeys.json`, {
+          method: 'PATCH',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            userDisplayName: trimmedDisplayName,
+            displayName: trimmedDisplayName,
+            username: trimmedUsername,
+          }),
+        });
+        if (response.ok) {
+          const data = await response.json();
+          if (data.user) {
+            updatedUser = data.user;
+          }
+        }
+      } catch {
+        // Continue with optimistic update if offline
+      }
+
+      setUser(updatedUser);
+      persistStateLocally(updatedUser, passkeys);
+      onUserUpdated?.(updatedUser);
+
+      // Signal browser authenticator with updated user details
+      const syncEvent = await syncCurrentUserDetails({
+        userId: updatedUser.userId,
+        name: updatedUser.username,
+        displayName: updatedUser.displayName,
+      });
+      appendSyncEvents(syncEvent);
+
+      setFeedback({
+        type: 'success',
+        message: `Display name updated to "${updatedUser.displayName}" and synchronized with your browser authenticator.`,
+      });
+    } finally {
+      setSavingUserDetails(false);
+    }
+  };
+
+  // Start editing a specific passkey's display name
+  const handleStartRenamePasskey = (passkey: PasskeyItem) => {
+    setEditingCredentialId(passkey.credentialId);
+    setEditingDisplayName(passkey.displayName);
+    setFeedback(null);
+  };
+
+  const handleCancelRenamePasskey = () => {
+    setEditingCredentialId(null);
+    setEditingDisplayName('');
+  };
+
+  // Save updated passkey display name + signal browser authenticator
+  const handleSavePasskeyDisplayName = async (
+    credentialId: string,
+    e?: React.FormEvent
+  ) => {
+    if (e) e.preventDefault();
+    const trimmedName = editingDisplayName.trim();
+    if (!trimmedName) {
+      setFeedback({
+        type: 'error',
+        message: 'Passkey display name cannot be empty.',
+      });
+      return;
+    }
+
+    let nextPasskeys = passkeys.map((pk) =>
+      pk.credentialId === credentialId
+        ? { ...pk, displayName: trimmedName, name: trimmedName }
+        : pk
+    );
+
+    try {
+      const response = await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: credentialId,
+          credentialId,
+          displayName: trimmedName,
+        }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          nextPasskeys = data.passkeys;
+        }
+      }
+    } catch {
+      // Keep optimistic state
+    }
+
+    setPasskeys(nextPasskeys);
+    persistStateLocally(user, nextPasskeys);
+    setEditingCredentialId(null);
+    setEditingDisplayName('');
+
+    // Keep browser authenticator in sync with current user details & accepted credentials
+    const userDetailsEvent = await syncCurrentUserDetails({
+      userId: user.userId,
+      name: user.username,
+      displayName: user.displayName,
+    });
+    const acceptedEvent = await syncAllAcceptedCredentials({
+      userId: user.userId,
+      allAcceptedCredentialIds: nextPasskeys.map((pk) => pk.credentialId),
+    });
+    appendSyncEvents(userDetailsEvent, acceptedEvent);
+
+    setFeedback({
+      type: 'success',
+      message: `Passkey display name updated to "${trimmedName}" and synchronized with your browser authenticator.`,
+    });
+  };
+
+  // Remove a passkey + signal browser authenticator via signalAllAcceptedCredentials and signalUnknownCredential
+  const handleRemovePasskey = async (passkeyToRemove: PasskeyItem) => {
+    const targetId = passkeyToRemove.credentialId;
+    let remainingPasskeys = passkeys.filter(
+      (pk) => pk.credentialId !== targetId && pk.id !== targetId
+    );
+
+    try {
+      const response = await fetch(
+        `${baseUrl}api/passkeys.json?credentialId=${encodeURIComponent(targetId)}`,
+        {
+          method: 'DELETE',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            id: targetId,
+            credentialId: targetId,
+          }),
+        }
+      );
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          remainingPasskeys = data.passkeys;
+        }
+      }
+    } catch {
+      // Keep optimistic removal
+    }
+
+    setPasskeys(remainingPasskeys);
+    persistStateLocally(user, remainingPasskeys);
+    if (editingCredentialId === targetId) {
+      setEditingCredentialId(null);
+      setEditingDisplayName('');
+    }
