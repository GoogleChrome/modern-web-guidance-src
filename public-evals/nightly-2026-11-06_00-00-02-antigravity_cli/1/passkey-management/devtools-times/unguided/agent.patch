diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..bea4dbf
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,250 @@
+import type { APIRoute } from 'astro';
+import {
+  getAccountFromSession,
+  setAccountInSession,
+  getPasskeysFromSession,
+  setPasskeysInSession,
+  resetPasskeysInSession,
+  type PasskeyItem,
+} from '../../utils/passkeyStore';
+import { ensureBase64Url } from '../../utils/webauthnSignal';
+
+function jsonResponse(data: Record<string, unknown>, status = 200): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getAccountFromSession(session);
+  const passkeys = await getPasskeysFromSession(session);
+  const allAcceptedCredentialIds = passkeys.map((pk) => pk.credentialId);
+
+  return jsonResponse({
+    user,
+    passkeys,
+    allAcceptedCredentialIds,
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  let body: Record<string, any> = {};
+  try {
+    body = await request.json();
+  } catch {
+    return jsonResponse({ error: 'Invalid JSON request body' }, 400);
+  }
+
+  const action = body.action || 'add';
+  let user = await getAccountFromSession(session);
+  let passkeys = await getPasskeysFromSession(session);
+
+  if (action === 'reset') {
+    const resetState = await resetPasskeysInSession(session);
+    return jsonResponse({
+      user: resetState.user,
+      passkeys: resetState.passkeys,
+      allAcceptedCredentialIds: resetState.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'delete' || action === 'remove') {
+    const targetId = body.credentialId || body.id;
+    if (!targetId) {
+      return jsonResponse({ error: 'credentialId is required' }, 400);
+    }
+    passkeys = passkeys.filter(
+      (pk) => pk.credentialId !== targetId && pk.id !== targetId
+    );
+    await setPasskeysInSession(session, passkeys);
+    return jsonResponse({
+      user,
+      passkeys,
+      removedCredentialId: targetId,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'updateUser' || action === 'updateProfile') {
+    const nextDisplayName =
+      typeof body.displayName === 'string' && body.displayName.trim()
+        ? body.displayName.trim()
+        : user.displayName;
+    const nextUsername =
+      typeof body.username === 'string' && body.username.trim()
+        ? body.username.trim()
+        : typeof body.name === 'string' && body.name.trim()
+          ? body.name.trim()
+          : user.username;
+
+    user = await setAccountInSession(session, {
+      ...user,
+      displayName: nextDisplayName,
+      username: nextUsername,
+      email: nextUsername,
+    });
+
+    return jsonResponse({
+      user,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'rename' || action === 'updatePasskey') {
+    const targetId = body.credentialId || body.id;
+    const nextName = (body.displayName || body.name || '').trim();
+    if (!targetId || !nextName) {
+      return jsonResponse({ error: 'credentialId and displayName are required' }, 400);
+    }
+
+    let updatedPasskey: PasskeyItem | null = null;
+    passkeys = passkeys.map((pk) => {
+      if (pk.credentialId === targetId || pk.id === targetId) {
+        updatedPasskey = {
+          ...pk,
+          displayName: nextName,
+          name: nextName,
+        };
+        return updatedPasskey;
+      }
+      return pk;
+    });
+
+    await setPasskeysInSession(session, passkeys);
+    return jsonResponse({
+      user,
+      passkeys,
+      updatedPasskey,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  // Default action: add/register a new passkey
+  const rawId =
+    body.credentialId ||
+    body.id ||
+    ensureBase64Url(`cred-device-${Date.now()}`);
+  const credentialId = ensureBase64Url(String(rawId));
+  const displayName =
+    (body.displayName || body.name || '').trim() ||
+    `Passkey (${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' })})`;
+  const nowIso = new Date().toISOString();
+
+  const newPasskey: PasskeyItem = {
+    id: credentialId,
+    credentialId,
+    displayName,
+    name: displayName,
+    createdAt: body.createdAt || nowIso,
+    lastUsedAt: body.lastUsedAt || nowIso,
+    deviceType: body.deviceType || 'Synced passkey (Browser Authenticator)',
+    transports: Array.isArray(body.transports) ? body.transports : ['internal', 'hybrid'],
+    backedUp: body.backedUp ?? true,
+  };
+
+  passkeys = [newPasskey, ...passkeys.filter((pk) => pk.credentialId !== credentialId)];
+  await setPasskeysInSession(session, passkeys);
+
+  return jsonResponse({
+    user,
+    passkeys,
+    addedPasskey: newPasskey,
+    allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+  });
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  let body: Record<string, any> = {};
+  try {
+    body = await request.json();
+  } catch {
+    return jsonResponse({ error: 'Invalid JSON request body' }, 400);
+  }
+
+  let user = await getAccountFromSession(session);
+  let passkeys = await getPasskeysFromSession(session);
+  const targetId = body.credentialId || body.id;
+
+  // Update a specific passkey's display name if targetId is provided
+  let updatedPasskey: PasskeyItem | null = null;
+  if (targetId) {
+    const nextPasskeyName = (body.displayName || body.name || '').trim();
+    if (!nextPasskeyName) {
+      return jsonResponse({ error: 'displayName is required' }, 400);
+    }
+
+    passkeys = passkeys.map((pk) => {
+      if (pk.credentialId === targetId || pk.id === targetId) {
+        updatedPasskey = {
+          ...pk,
+          displayName: nextPasskeyName,
+          name: nextPasskeyName,
+        };
+        return updatedPasskey;
+      }
+      return pk;
+    });
+    await setPasskeysInSession(session, passkeys);
+  }
+
+  // Update user's displayName / username if userDetails or non-credential displayName provided
+  if (!targetId || body.userDisplayName || body.username) {
+    const nextUserDisplayName = (
+      body.userDisplayName ||
+      (!targetId ? body.displayName : '') ||
+      ''
+    ).trim();
+    const nextUsername = (body.username || body.userName || '').trim();
+
+    user = await setAccountInSession(session, {
+      ...user,
+      displayName: nextUserDisplayName || user.displayName,
+      username: nextUsername || user.username,
+      email: nextUsername || user.email,
+    });
+  }
+
+  return jsonResponse({
+    user,
+    passkeys,
+    updatedPasskey,
+    allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+  });
+};
+
+export const PUT: APIRoute = PATCH;
+
+export const DELETE: APIRoute = async ({ request, url, session }) => {
+  let targetId =
+    url.searchParams.get('credentialId') || url.searchParams.get('id') || '';
+
+  if (!targetId) {
+    try {
+      const body = await request.json();
+      targetId = body.credentialId || body.id || '';
+    } catch {
+      // No JSON body provided
+    }
+  }
+
+  if (!targetId) {
+    return jsonResponse({ error: 'credentialId is required to remove a passkey' }, 400);
+  }
+
+  const user = await getAccountFromSession(session);
+  let passkeys = await getPasskeysFromSession(session);
+
+  passkeys = passkeys.filter(
+    (pk) => pk.credentialId !== targetId && pk.id !== targetId
+  );
+  await setPasskeysInSession(session, passkeys);
+
+  return jsonResponse({
+    user,
+    passkeys,
+    removedCredentialId: targetId,
+    allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+  });
+};
