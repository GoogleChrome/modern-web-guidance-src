index 0000000..d1ad468
--- /dev/null
+++ b/src/utils/webauthnSignal.ts
@@ -0,0 +1,204 @@
+export interface AuthenticatorSyncEvent {
+  id: string;
+  timestamp: string;
+  method:
+    | 'signalAllAcceptedCredentials'
+    | 'signalCurrentUserDetails'
+    | 'signalUnknownCredential';
+  status: 'synced' | 'unsupported' | 'error';
+  summary: string;
+  payload: Record<string, unknown>;
+}
+
+const BASE64URL_REGEX = /^[A-Za-z0-9_-]+$/;
+
+export function bufferToBase64Url(buffer: ArrayBuffer | Uint8Array): string {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function ensureBase64Url(value: string): string {
+  if (!value) return '';
+  if (BASE64URL_REGEX.test(value) && value.length % 4 !== 1) {
+    return value;
+  }
+  const encoder = new TextEncoder();
+  return bufferToBase64Url(encoder.encode(value));
+}
+
+export function getRpId(): string {
+  if (typeof window !== 'undefined' && window.location?.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+export function isSignalApiSupported(): {
+  signalAllAcceptedCredentials: boolean;
+  signalCurrentUserDetails: boolean;
+  signalUnknownCredential: boolean;
+} {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) {
+    return {
+      signalAllAcceptedCredentials: false,
+      signalCurrentUserDetails: false,
+      signalUnknownCredential: false,
+    };
+  }
+  return {
+    signalAllAcceptedCredentials:
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+    signalCurrentUserDetails:
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+    signalUnknownCredential:
+      typeof PublicKeyCredential.signalUnknownCredential === 'function',
+  };
+}
+
+export async function syncAllAcceptedCredentials(params: {
+  userId: string;
+  allAcceptedCredentialIds: string[];
+  rpId?: string;
+}): Promise<AuthenticatorSyncEvent> {
+  const rpId = params.rpId || getRpId();
+  const userId = ensureBase64Url(params.userId);
+  const allAcceptedCredentialIds = params.allAcceptedCredentialIds.map(ensureBase64Url);
+  const payload = { rpId, userId, allAcceptedCredentialIds };
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+      return {
+        id: `${Date.now()}-accepted`,
+        timestamp: new Date().toISOString(),
+        method: 'signalAllAcceptedCredentials',
+        status: 'synced',
+        summary: `Synchronized ${allAcceptedCredentialIds.length} accepted passkey(s) with browser authenticator.`,
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        id: `${Date.now()}-accepted-err`,
+        timestamp: new Date().toISOString(),
+        method: 'signalAllAcceptedCredentials',
+        status: 'error',
+        summary: `Failed to signal accepted credentials: ${err?.message || 'Unknown error'}`,
+        payload,
+      };
+    }
+  }
+
+  return {
+    id: `${Date.now()}-accepted-fallback`,
+    timestamp: new Date().toISOString(),
+    method: 'signalAllAcceptedCredentials',
+    status: 'unsupported',
+    summary: `Prepared signalAllAcceptedCredentials (${allAcceptedCredentialIds.length} active key(s)); WebAuthn Signal API not active in this browser.`,
+    payload,
+  };
+}
+
+export async function syncCurrentUserDetails(params: {
+  userId: string;
+  name: string;
+  displayName: string;
+  rpId?: string;
+}): Promise<AuthenticatorSyncEvent> {
+  const rpId = params.rpId || getRpId();
+  const userId = ensureBase64Url(params.userId);
+  const payload = {
+    rpId,
+    userId,
+    name: params.name,
+    displayName: params.displayName,
+  };
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails(payload);
+      return {
+        id: `${Date.now()}-userdetails`,
+        timestamp: new Date().toISOString(),
+        method: 'signalCurrentUserDetails',
+        status: 'synced',
+        summary: `Synchronized display name "${params.displayName}" (${params.name}) with browser authenticator.`,
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        id: `${Date.now()}-userdetails-err`,
+        timestamp: new Date().toISOString(),
+        method: 'signalCurrentUserDetails',
+        status: 'error',
+        summary: `Failed to signal current user details: ${err?.message || 'Unknown error'}`,
+        payload,
+      };
+    }
+  }
+
+  return {
+    id: `${Date.now()}-userdetails-fallback`,
+    timestamp: new Date().toISOString(),
+    method: 'signalCurrentUserDetails',
+    status: 'unsupported',
+    summary: `Prepared signalCurrentUserDetails for "${params.displayName}"; WebAuthn Signal API not active in this browser.`,
+    payload,
+  };
+}
+
+export async function syncUnknownCredential(params: {
+  credentialId: string;
+  rpId?: string;
+}): Promise<AuthenticatorSyncEvent> {
+  const rpId = params.rpId || getRpId();
+  const credentialId = ensureBase64Url(params.credentialId);
+  const payload = { rpId, credentialId };
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalUnknownCredential === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalUnknownCredential(payload);
+      return {
+        id: `${Date.now()}-unknown`,
+        timestamp: new Date().toISOString(),
+        method: 'signalUnknownCredential',
+        status: 'synced',
+        summary: `Signaled removed credential (${credentialId.slice(0, 12)}…) as unknown to browser authenticator.`,
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        id: `${Date.now()}-unknown-err`,
+        timestamp: new Date().toISOString(),
+        method: 'signalUnknownCredential',
+        status: 'error',
+        summary: `Failed to signal unknown credential: ${err?.message || 'Unknown error'}`,
+        payload,
+      };
+    }
+  }
+
+  return {
+    id: `${Date.now()}-unknown-fallback`,
+    timestamp: new Date().toISOString(),
+    method: 'signalUnknownCredential',
+    status: 'unsupported',
+    summary: `Prepared signalUnknownCredential for (${credentialId.slice(0, 12)}…); WebAuthn Signal API not active in this browser.`,
+    payload,
+  };
+}
