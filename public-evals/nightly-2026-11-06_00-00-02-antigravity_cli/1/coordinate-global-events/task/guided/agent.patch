+  <script type="module">
+    const TARGET_ZONES = [
+      { label: 'New York', timeZone: 'America/New_York' },
+      { label: 'London', timeZone: 'Europe/London' },
+      { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+      { label: 'UTC', timeZone: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) {
+        return;
+      }
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition gap or overlap conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Resolve the host time safely using disambiguation: 'compatible'
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit',
+          timeZoneName: 'short'
+        });
+
+        const wallClockChanged =
+          hostTime.hour !== earlierTime.hour ||
+          hostTime.minute !== earlierTime.minute;
+
+        if (wallClockChanged) {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected local time (${time}) does not exist in ${timeZone} because clocks spring forward during a DST transition gap. Using compatible disambiguation, the schedule was automatically resolved forward to ${resolvedFormatted} (${hostTime.toString()}).`;
+        } else if (!earlierTime.equals(laterTime)) {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected local time (${time}) is ambiguous in ${timeZone} because clocks fall back and repeat this hour during a DST transition overlap. Using compatible disambiguation, the schedule was resolved to the first occurrence at ${resolvedFormatted} (${hostTime.toString()}).`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time falls in a DST transition gap or overlap in ${timeZone}. It was resolved to ${resolvedFormatted} (${hostTime.toString()}).`;
+        }
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      // Render target timezone cards without mutating the immutable hostTime ZonedDateTime
+      grid.replaceChildren(
+        ...TARGET_ZONES.map(({ label, timeZone: targetTz }) => {
+          const targetZdt = hostTime.withTimeZone(targetTz);
+          const formattedTime = targetZdt.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit'
+          });
+          const formattedDate = targetZdt.toLocaleString('en-US', {
+            weekday: 'short',
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric',
+            timeZoneName: 'short'
+          });
+
+          const card = document.createElement('div');
+          card.className = 'card tz-card';
+
+          const heading = document.createElement('h3');
+          heading.textContent = label;
+
+          const tzId = document.createElement('p');
+          tzId.className = 'tz-id';
+          tzId.textContent = targetTz;
+
+          const timeEl = document.createElement('div');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formattedTime;
+
+          const dateEl = document.createElement('p');
+          dateEl.className = 'tz-date';
+          dateEl.textContent = formattedDate;
+
+          card.append(heading, tzId, timeEl, dateEl);
+          return card;
+        })
+      );
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      for (const control of [dateInput, timeInput, hostTzSelect]) {
+        control.addEventListener('change', updateSchedule);
+        control.addEventListener('input', updateSchedule);
+      }
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
