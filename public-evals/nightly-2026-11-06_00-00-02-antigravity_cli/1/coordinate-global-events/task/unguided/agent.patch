+  <script>
+    (function () {
+      const TARGET_TIMEZONES = [
+        { label: 'New York', id: 'America/New_York' },
+        { label: 'London', id: 'Europe/London' },
+        { label: 'Tokyo', id: 'Asia/Tokyo' },
+        { label: 'UTC', id: 'UTC' }
+      ];
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function formatLocalTime(timeLike) {
+        const hour24 = timeLike.hour;
+        const minute = String(timeLike.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function formatLocalDate(dateLike) {
+        const months = [
+          'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
+          'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
+        ];
+        return `${months[dateLike.month - 1]} ${dateLike.day}, ${dateLike.year}`;
+      }
+
+      function resolveHostDateTime(plainDateTime, hostTz) {
+        const earlierZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+        const laterZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'later' });
+        const resolvedZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+        let hasConflict = !earlierZdt.equals(laterZdt);
+        try {
+          plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'reject' });
+        } catch (err) {
+          hasConflict = true;
+        }
+
+        if (!hasConflict) {
+          return { zdt: resolvedZdt, warning: '' };
+        }
+
+        const requestedTimeLabel = formatLocalTime(plainDateTime);
+        const resolvedTimeLabel = formatLocalTime(resolvedZdt);
+        const isGap = !resolvedZdt.toPlainDateTime().equals(plainDateTime);
+
+        if (isGap) {
+          return {
+            zdt: resolvedZdt,
+            warning: `Daylight Saving Time Gap Detected: ${requestedTimeLabel} does not exist in ${hostTz} because clocks spring forward from UTC${earlierZdt.offset} to UTC${laterZdt.offset}. The time was automatically resolved forward to ${resolvedTimeLabel} (UTC${resolvedZdt.offset}).`
+          };
+        }
+
+        return {
+          zdt: resolvedZdt,
+          warning: `Daylight Saving Time Overlap Detected: ${requestedTimeLabel} is ambiguous in ${hostTz} because clocks fall back and the hour repeats (first at UTC${earlierZdt.offset}, then at UTC${laterZdt.offset}). The time was resolved to the earlier occurrence at ${resolvedTimeLabel} (UTC${resolvedZdt.offset}).`
+        };
+      }
+
+      function updateSchedule() {
+        const dateValue = dateInput.value;
+        const timeValue = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateValue || !timeValue || !hostTz) {
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateValue);
+        const plainTime = Temporal.PlainTime.from(timeValue);
+        const plainDateTime = plainDate.toPlainDateTime(plainTime);
+
+        const { zdt: hostZonedDateTime, warning } = resolveHostDateTime(plainDateTime, hostTz);
+
+        if (warning) {
+          hostWarning.textContent = warning;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        grid.innerHTML = '';
+
+        for (const target of TARGET_TIMEZONES) {
+          const targetZdt = hostZonedDateTime.withTimeZone(target.id);
+          const card = document.createElement('div');
+          card.className = 'card tz-card' + (target.id === hostTz ? ' is-host' : '');
+          card.dataset.timezone = target.id;
+
+          const heading = document.createElement('h3');
+          heading.textContent = target.label;
+
+          const tzIdEl = document.createElement('div');
+          tzIdEl.className = 'tz-id';
+          tzIdEl.textContent = `${target.id} (UTC${targetZdt.offset})`;
+
+          const timeEl = document.createElement('div');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formatLocalTime(targetZdt);
+
+          const dateEl = document.createElement('div');
+          dateEl.className = 'tz-date';
+          dateEl.textContent = formatLocalDate(targetZdt);
+
+          card.appendChild(heading);
+          card.appendChild(tzIdEl);
+          card.appendChild(timeEl);
+          card.appendChild(dateEl);
+          grid.appendChild(card);
+        }
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
