+  <script>
+    (function () {
+      const orderProgress = document.getElementById('order-progress');
+      const orderStatus = document.getElementById('order-status');
+      const btnIndeterminate = document.getElementById('btn-indeterminate');
+      const btnBrewing = document.getElementById('btn-brewing');
+      const btnReady = document.getElementById('btn-ready');
+      const buttons = [btnIndeterminate, btnBrewing, btnReady];
+
+      function setActiveButton(activeBtn) {
+        buttons.forEach((btn) => {
+          btn.setAttribute('aria-pressed', btn === activeBtn ? 'true' : 'false');
+        });
+      }
+
+      btnIndeterminate.addEventListener('click', () => {
+        orderProgress.removeAttribute('value');
+        orderStatus.textContent = 'Syncing with roastery baristas…';
+        setActiveButton(btnIndeterminate);
+      });
+
+      btnBrewing.addEventListener('click', () => {
+        orderProgress.value = 65;
+        orderStatus.textContent = 'Brewing — 65% complete';
+        setActiveButton(btnBrewing);
+      });
+
+      btnReady.addEventListener('click', () => {
+        orderProgress.value = 100;
+        orderStatus.textContent = 'Order complete — Ready for pickup!';
+        setActiveButton(btnReady);
+      });
+    })();
+  </script>
