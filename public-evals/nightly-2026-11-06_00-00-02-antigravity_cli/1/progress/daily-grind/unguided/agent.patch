+  <script>
+    (function () {
+      const buttons = document.querySelectorAll('.progress-btn');
+      const customTrack = document.getElementById('custom-progress-bar');
+      const customFill = document.getElementById('custom-progress-fill');
+      const nativeProgress = document.getElementById('native-progress-bar');
+      const statusLabel = document.getElementById('progress-status-label');
+      const statusValue = document.getElementById('progress-status-value');
+      const subtext = document.getElementById('progress-subtext');
+      const steps = document.querySelectorAll('.progress-step');
+
+      function updateProgress(state, value, label, sub) {
+        statusLabel.textContent = label;
+        subtext.textContent = sub;
+
+        if (state === 'indeterminate') {
+          customTrack.classList.add('is-indeterminate');
+          customTrack.removeAttribute('aria-valuenow');
+          customTrack.setAttribute('aria-busy', 'true');
+          statusValue.textContent = 'Processing...';
+
+          nativeProgress.removeAttribute('value');
+          nativeProgress.textContent = 'Processing...';
+
+          steps.forEach((step) => {
+            step.classList.remove('completed', 'current');
+          });
+        } else {
+          const numericVal = Number(value);
+          customTrack.classList.remove('is-indeterminate');
+          customTrack.setAttribute('aria-valuenow', String(numericVal));
+          customTrack.setAttribute('aria-busy', 'false');
+          customFill.style.width = numericVal + '%';
+          statusValue.textContent = numericVal + '%';
+
+          nativeProgress.setAttribute('value', String(numericVal));
+          nativeProgress.value = numericVal;
+          nativeProgress.textContent = numericVal + '%';
+
+          steps.forEach((step) => {
+            const threshold = Number(step.getAttribute('data-threshold'));
+            step.classList.remove('completed', 'current');
+            if (numericVal > threshold || numericVal === 100) {
+              step.classList.add('completed');
+            } else if (numericVal === threshold) {
+              step.classList.add('current');
+            }
+          });
+        }
+      }
+
+      buttons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          buttons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          updateProgress(
+            btn.getAttribute('data-state'),
+            btn.getAttribute('data-value'),
+            btn.getAttribute('data-label'),
+            btn.getAttribute('data-sub')
+          );
+        });
+      });
+    })();
+  </script>
