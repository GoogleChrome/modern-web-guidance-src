+    button[type="submit"]:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    /* Applies horizontal auto-sizing to inputs */
+    input[type="text"] {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    /* Applies vertical auto-sizing to textareas while keeping horizontal width stable */
+    textarea {
+      field-sizing: content;
+      height: auto;
+      width: 50ch;
+      max-inline-size: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    /* Sizes the select element to fit the active option only */
+    select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: 50ch;
+    }
+
+    /* Fallback for browsers where field-sizing: content is not supported */
+    @supports not (field-sizing: content) {
+      .growable-textarea {
+        display: grid;
+        width: 50ch;
+        max-inline-size: 100%;
+      }
+
+      .growable-textarea::after,
+      .growable-textarea > textarea {
+        grid-area: 1 / 1 / 2 / 2;
+        font: inherit;
+        padding: 0.75rem;
+        border: 1px solid #999;
+        border-radius: 4px;
+        width: 100%;
+        min-block-size: 3lh;
+        max-block-size: 10lh;
+      }
+
+      .growable-textarea::after {
+        content: attr(data-replicated-value) " ";
+        white-space: pre-wrap;
+        visibility: hidden;
+      }
+
+      .growable-textarea > textarea {
+        resize: none;
+        overflow: hidden;
+      }
+    }
+
+    button[type="submit"] {
+      border: none;
+      font: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+      min-height: 48px;
+    }
+
