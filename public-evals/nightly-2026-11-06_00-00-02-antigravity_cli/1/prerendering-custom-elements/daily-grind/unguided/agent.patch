+            this._favoriteBtn.setAttribute('aria-pressed', expectedAttr);
+          }
+        }
+        if (this._favIcon) {
+          const expectedIcon = isFavorited ? '\u2665' : '\u2661';
+          if (this._favIcon.textContent !== expectedIcon) {
+            this._favIcon.textContent = expectedIcon;
+          }
+        }
+      }
+
+      _renderClientFallback() {
