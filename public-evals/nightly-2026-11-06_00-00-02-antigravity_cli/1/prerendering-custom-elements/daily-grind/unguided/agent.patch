+          if (this._detailsBtn.getAttribute('aria-expanded') !== expectedAttr) {
+            this._detailsBtn.setAttribute('aria-expanded', expectedAttr);
+          }
+          const expectedLabel = isExpanded ? 'Hide Details' : 'View Details';
+          if (this._detailsBtn.textContent !== expectedLabel) {
+            this._detailsBtn.textContent = expectedLabel;
+          }
+        }
+        if (this._detailsPanel && this._detailsPanel.hidden === isExpanded) {
+          this._detailsPanel.hidden = !isExpanded;
+        }
+      }
+
+      _syncFavoritedState(isFavorited) {
+        if (this._favoriteBtn) {
+          const expectedAttr = String(isFavorited);
