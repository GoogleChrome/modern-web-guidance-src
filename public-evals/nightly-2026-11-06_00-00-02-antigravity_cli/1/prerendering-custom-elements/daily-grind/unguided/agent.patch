+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        this._hydrated = false;
+        this._onDetailsClick = this.toggleDetails.bind(this);
+        this._onFavoriteClick = this.toggleFavorite.bind(this);
+      }
+
+      connectedCallback() {
+        // Only construct shadow DOM if the element was created dynamically in JS
+        // without a server-rendered Declarative Shadow DOM (<template shadowrootmode="open">).
+        if (!this.shadowRoot) {
+          this._renderClientFallback();
+        }
+
+        // Hydrate existing server-rendered shadow DOM in place without re-rendering
+        // or replacing any existing DOM nodes.
+        if (!this._hydrated) {
+          this._detailsBtn = this.shadowRoot.querySelector('.details-toggle');
+          this._detailsPanel = this.shadowRoot.querySelector('.details');
+          this._favoriteBtn = this.shadowRoot.querySelector('.favorite-toggle');
+          this._favIcon = this.shadowRoot.querySelector('.fav-icon');
+
+          if (this._detailsBtn) {
+            this._detailsBtn.addEventListener('click', this._onDetailsClick);
+          }
+          if (this._favoriteBtn) {
+            this._favoriteBtn.addEventListener('click', this._onFavoriteClick);
+          }
+
+          this._hydrated = true;
+
+          // Sync state only if initial host attributes differ from server-rendered defaults
+          if (this.hasAttribute('expanded')) {
+            this._syncExpandedState(true);
+          }
+          if (this.hasAttribute('favorited')) {
+            this._syncFavoritedState(true);
+          }
+        }
+      }
+
+      disconnectedCallback() {
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onDetailsClick);
+        }
+        if (this._favoriteBtn) {
+          this._favoriteBtn.removeEventListener('click', this._onFavoriteClick);
+        }
+        this._hydrated = false;
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this._hydrated) return;
+        if (name === 'expanded') {
+          this._syncExpandedState(newValue !== null);
+        } else if (name === 'favorited') {
+          this._syncFavoritedState(newValue !== null);
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(value) {
+        this.toggleAttribute('expanded', Boolean(value));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      toggleDetails() {
+        const nextExpanded = !this.expanded;
+        this.expanded = nextExpanded;
+        this._syncExpandedState(nextExpanded);
+        this.dispatchEvent(
+          new CustomEvent('details-toggle', {
+            detail: {
+              drinkId: this.getAttribute('drink-id'),
+              name: this.getAttribute('name'),
+              expanded: nextExpanded
+            },
+            bubbles: true,
+            composed: true
+          })
+        );
+      }
+
+      toggleFavorite() {
+        const nextFavorited = !this.favorited;
+        this.favorited = nextFavorited;
+        this._syncFavoritedState(nextFavorited);
+        this.dispatchEvent(
+          new CustomEvent('favorite-toggle', {
+            detail: {
+              drinkId: this.getAttribute('drink-id'),
+              name: this.getAttribute('name'),
+              favorited: nextFavorited
+            },
+            bubbles: true,
+            composed: true
+          })
+        );
+      }
+
+      _syncExpandedState(isExpanded) {
