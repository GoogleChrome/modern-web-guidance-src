+          display: inline-block;
+          background: var(--_primary);
+          color: white;
+          padding: 10px 16px;
+          text-decoration: none;
+          border: none;
+          border-radius: 5px;
+          transition: background 0.3s;
+        }
+        .btn:hover {
+          background: var(--_text);
+        }
+        .fav-btn {
+          display: inline-flex;
+          align-items: center;
+          gap: 6px;
+          background: transparent;
+          color: var(--_primary);
+          border: 1px solid var(--_primary);
+          padding: 9px 14px;
+          border-radius: 5px;
+          transition: background 0.2s, color 0.2s, border-color 0.2s;
+        }
+        :host(:state(favorited)) .fav-btn,
+        :host([favorited]) .fav-btn {
+          background: var(--_accent);
+          border-color: var(--_accent);
+          color: var(--_text);
+          font-weight: 600;
+        }
+      </style>
+      <article class="card" part="card">
+        <div class="header">
+          <slot name="title"></slot>
+          <slot></slot>
+        </div>
+        <div class="details" id="details" part="details" hidden>
+          <slot name="details"></slot>
+        </div>
+        <div class="actions" part="actions">
+          <button type="button" id="details-toggle" class="btn" part="details-button" aria-expanded="false" aria-controls="details">View Details</button>
+          <button type="button" id="favorite-toggle" class="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Favorite drink">
+            <span aria-hidden="true">♡</span>
+            <span class="fav-label">Favorite</span>
+          </button>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['open', 'favorited'];
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.();
+
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // only attach a shadow root if absent (e.g., dynamically constructed or non-DSD engine).
+        if (!this.shadowRoot) {
+          const declarativeTpl = this.querySelector('template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' });
+          if (declarativeTpl) {
+            this.shadowRoot.append(declarativeTpl.content.cloneNode(true));
+            declarativeTpl.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach listeners once against existing markup without re-rendering.
+        this.shadowRoot.getElementById('details-toggle')
+          ?.addEventListener('click', () => {
+            this.open = !this.open;
+            this.dispatchEvent(new CustomEvent('details-toggle', {
+              bubbles: true,
+              detail: { drinkId: this.drinkId, open: this.open }
+            }));
+          });
+
+        this.shadowRoot.getElementById('favorite-toggle')
+          ?.addEventListener('click', () => {
+            this.favorited = !this.favorited;
+            this.dispatchEvent(new CustomEvent('favorite-toggle', {
+              bubbles: true,
+              detail: { drinkId: this.drinkId, favorited: this.favorited }
+            }));
+          });
+      }
+
+      connectedCallback() {
+        this.#syncOpenState();
+        this.#syncFavoritedState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'open') this.#syncOpenState();
+        if (name === 'favorited') this.#syncFavoritedState();
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id') ?? '';
+      }
+
+      set drinkId(v) {
+        v ? this.setAttribute('drink-id', v) : this.removeAttribute('drink-id');
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(on) {
+        this.toggleAttribute('open', !!on);
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(on) {
+        this.toggleAttribute('favorited', !!on);
+      }
+
+      #syncOpenState() {
+        const isOpen = this.open;
+        if (this.#internals?.states) {
+          isOpen ? this.#internals.states.add('open') : this.#internals.states.delete('open');
+        }
+        const detailsEl = this.shadowRoot?.getElementById('details');
+        const btn = this.shadowRoot?.getElementById('details-toggle');
+        if (detailsEl) detailsEl.hidden = !isOpen;
+        if (btn) {
+          btn.setAttribute('aria-expanded', String(isOpen));
+          btn.textContent = isOpen ? 'Hide Details' : 'View Details';
+        }
+      }
+
+      #syncFavoritedState() {
+        const isFav = this.favorited;
+        if (this.#internals?.states) {
+          isFav ? this.#internals.states.add('favorited') : this.#internals.states.delete('favorited');
+        }
+        const btn = this.shadowRoot?.getElementById('favorite-toggle');
+        if (btn) {
+          btn.setAttribute('aria-pressed', String(isFav));
+          const icon = btn.querySelector('[aria-hidden="true"]');
+          const label = btn.querySelector('.fav-label');
+          if (icon) icon.textContent = isFav ? '♥' : '♡';
+          if (label) label.textContent = isFav ? 'Favorited' : 'Favorite';
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
