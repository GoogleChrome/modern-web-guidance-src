+  <script>
+    (function () {
+      const globalStatus = document.getElementById('global-status');
+      const orderNowBtn = document.getElementById('order-now-btn');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalBanner = document.getElementById('seasonal-loading-status');
+      const seasonalStatusText = seasonalBanner ? seasonalBanner.querySelector('.seasonal-status-text') : null;
+      const detailButtons = document.querySelectorAll('.drink-details-btn');
+
+      function announceStatus(message) {
+        if (globalStatus) {
+          globalStatus.textContent = message;
+        }
+      }
+
+      function setButtonLoading(btn, loadingText, statusAnnouncement) {
+        if (!btn || btn.getAttribute('aria-busy') === 'true') return false;
+
+        btn.classList.add('is-loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+
+        const labelEl = btn.querySelector('.btn-label');
+        if (labelEl) {
+          if (!btn.dataset.originalLabel) {
+            btn.dataset.originalLabel = labelEl.textContent;
+          }
+          labelEl.textContent = loadingText;
+        }
+
+        announceStatus(statusAnnouncement || loadingText);
+        return true;
+      }
+
+      if (orderNowBtn) {
+        orderNowBtn.addEventListener('click', function (event) {
+          if (orderNowBtn.getAttribute('aria-busy') === 'true') {
+            event.preventDefault();
+            return;
+          }
+          event.preventDefault();
+          const targetHref = orderNowBtn.getAttribute('href');
+          setButtonLoading(
+            orderNowBtn,
+            'Starting Order...',
+            'Starting your order, please wait...'
+          );
+
+          window.setTimeout(function () {
+            if (targetHref) {
+              window.location.href = targetHref;
+            }
+          }, 800);
+        });
+      }
+
+      detailButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          if (btn.getAttribute('aria-busy') === 'true') {
+            event.preventDefault();
+            return;
+          }
+          event.preventDefault();
+
+          const drinkName = btn.getAttribute('data-drink') || 'drink';
+          const targetHref = btn.getAttribute('href');
+          const card = btn.closest('.card');
+
+          setButtonLoading(
+            btn,
+            'Loading Details...',
+            'Loading details for ' + drinkName + ', please wait...'
+          );
+
+          if (card) {
+            card.classList.add('is-loading');
+            card.setAttribute('aria-busy', 'true');
+          }
+
+          if (seasonalSection) {
+            seasonalSection.classList.add('is-loading');
+            seasonalSection.setAttribute('aria-busy', 'true');
+          }
+
+          if (seasonalBanner) {
+            if (seasonalStatusText) {
+              seasonalStatusText.textContent = 'Loading ' + drinkName + ' details...';
+            }
+            seasonalBanner.classList.add('is-visible');
+          }
+
+          window.setTimeout(function () {
+            if (targetHref) {
+              window.location.href = targetHref;
+            }
+          }, 800);
+        });
+      });
+    })();
+  </script>
