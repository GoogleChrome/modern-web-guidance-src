+  <script>
+    function createLoadingSpinner(labelText) {
+      const spinner = document.createElement('progress');
+      spinner.className = 'loading-spinner';
+      spinner.setAttribute('aria-label', labelText);
+      return spinner;
+    }
+
+    function setBusyState(triggerEl, { busy, loadingText, spinnerLabel, busyContainer }) {
+      const labelEl = triggerEl.querySelector('.btn-label');
+      const container = busyContainer || triggerEl;
+
+      if (busy) {
+        triggerEl.dataset.originalLabel = labelEl ? labelEl.textContent : triggerEl.textContent;
+        triggerEl.setAttribute('aria-disabled', 'true');
+        triggerEl.setAttribute('aria-busy', 'true');
+        if (container !== triggerEl) {
+          container.setAttribute('aria-busy', 'true');
+        }
+
+        if (labelEl && loadingText) {
+          labelEl.textContent = loadingText;
+        }
+
+        let spinner = triggerEl.querySelector('progress.loading-spinner');
+        if (!spinner) {
+          spinner = createLoadingSpinner(spinnerLabel || loadingText || 'Loading');
+          triggerEl.prepend(spinner);
+        } else {
+          spinner.setAttribute('aria-label', spinnerLabel || loadingText || 'Loading');
+          spinner.hidden = false;
+        }
+      } else {
+        triggerEl.removeAttribute('aria-disabled');
+        triggerEl.removeAttribute('aria-busy');
+        if (container !== triggerEl) {
+          container.removeAttribute('aria-busy');
+        }
+
+        const spinner = triggerEl.querySelector('progress.loading-spinner');
+        if (spinner) {
+          spinner.remove();
+        }
+
+        if (labelEl && triggerEl.dataset.originalLabel) {
+          labelEl.textContent = triggerEl.dataset.originalLabel;
+        }
+      }
+    }
+
+    const orderNowBtn = document.getElementById('order-now-btn');
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (orderNowBtn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        setBusyState(orderNowBtn, {
+          busy: true,
+          loadingText: 'Starting Order...',
+          spinnerLabel: 'Starting order'
+        });
+
+        const targetHref = orderNowBtn.getAttribute('href');
+        window.setTimeout(() => {
+          setBusyState(orderNowBtn, {
+            busy: false
+          });
+          if (targetHref) {
+            window.location.href = targetHref;
+          }
+        }, 1200);
+      });
+    }
+
+    document.querySelectorAll('.view-details-btn').forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (btn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const card = btn.closest('.card');
+        const drinkTitle = card?.querySelector('h3')?.textContent?.trim() || 'drink';
+        const detailsEl = card?.querySelector('.drink-details');
+
+        setBusyState(btn, {
+          busy: true,
+          loadingText: 'Loading Details...',
+          spinnerLabel: `Loading ${drinkTitle} details`,
+          busyContainer: card
+        });
+
+        window.setTimeout(() => {
+          setBusyState(btn, {
+            busy: false,
+            busyContainer: card
+          });
+          if (detailsEl) {
+            detailsEl.hidden = false;
+          }
+        }, 1000);
+      });
+    });
+  </script>
