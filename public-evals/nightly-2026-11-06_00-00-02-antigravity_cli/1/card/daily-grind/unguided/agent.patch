+  <script>
+    (() => {
+      let totalItems = 0;
+      const orderCountEl = document.getElementById('order-count');
+
+      document.querySelectorAll('.card .order-form').forEach((form) => {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const card = form.closest('.card');
+          const drinkName = card?.dataset.drink || card?.querySelector('h3')?.textContent || 'Drink';
+          const selectedSizeInput = form.querySelector('input[type="radio"]:checked');
+          const size = selectedSizeInput ? selectedSizeInput.value : 'medium';
+          const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+
+          totalItems += 1;
+          if (orderCountEl) {
+            orderCountEl.textContent = String(totalItems);
+          }
+
+          if (card) {
+            card.dataset.added = 'true';
+          }
+
+          const feedback = form.querySelector('.order-feedback');
+          if (feedback) {
+            feedback.textContent = `Added ${sizeLabel} ${drinkName} to your order!`;
+            feedback.hidden = false;
+          }
+        });
+      });
+    })();
+  </script>
