diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,164 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Typography &amp; Visual Proportions Normalization</title>
+  <style>
+    :root {
+      --bg-primary: #f8fafc;
+      --surface-primary: #ffffff;
+      --text-primary: #0f172a;
+      --text-secondary: #475569;
+      --border-light: #e2e8f0;
+      --code-bg: #f1f5f9;
+      --code-text: #0284c7;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background-color: var(--bg-primary);
+      color: var(--text-primary);
+      line-height: 1.65;
+      padding: 3rem 1.5rem;
+    }
+
+    main {
+      max-width: 820px;
+      margin: 0 auto;
+      display: flex;
+      flex-direction: column;
+      gap: 2.5rem;
+    }
+
+    header h1 {
+      font-size: 1.875rem;
+      font-weight: 700;
+      letter-spacing: -0.025em;
+      margin-bottom: 0.5rem;
+    }
+
+    header p {
+      color: var(--text-secondary);
+      font-size: 1rem;
+    }
+
+    .card {
+      background: var(--surface-primary);
+      border: 1px solid var(--border-light);
+      border-radius: 12px;
+      padding: 2rem;
+      box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.05);
+    }
+
+    .section-label {
+      display: inline-block;
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.06em;
+      color: #64748b;
+      margin-bottom: 0.75rem;
+    }
+
+    /*
+     * Automatic visual height normalization across mixed font families.
+     * Using `font-size-adjust: from-font` extracts the primary font's
+     * x-height aspect ratio automatically and normalizes inline code fonts.
+     */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", Times, serif;
+      font-size: 1.125rem;
+      line-height: 1.75;
+      font-size-adjust: from-font;
+      color: var(--text-primary);
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, Consolas, Monaco, monospace;
+      font-size: 1em;
+      background-color: var(--code-bg);
+      color: var(--code-text);
+      padding: 0.15em 0.4em;
+      border-radius: 6px;
+      border: 1px solid #cbd5e1;
+    }
+
+    /*
+     * Independent theme container with a specific numeric aspect-ratio override
+     * to lock down its visual and typographic proportions.
+     */
+    #independent-theme-container {
+      font-family: "Trebuchet MS", Verdana, Geneva, Tahoma, sans-serif;
+      font-size: 1.05rem;
+      font-size-adjust: 0.52;
+      aspect-ratio: 16 / 9;
+      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
+      color: #f8fafc;
+      border: 1px solid #334155;
+      border-radius: 12px;
+      padding: 2rem;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      gap: 1rem;
+      box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.25);
+    }
+
+    #independent-theme-container h2 {
+      font-size: 1.4rem;
+      font-weight: 600;
+      color: #38bdf8;
+    }
+
+    #independent-theme-container p {
+      color: #cbd5e1;
+      line-height: 1.65;
+    }
+
+    #independent-theme-container code {
+      font-family: "Lucida Console", Monaco, Consolas, monospace;
+      background-color: rgba(56, 189, 248, 0.12);
+      color: #7dd3fc;
+      padding: 0.15em 0.4em;
+      border-radius: 4px;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Modern CSS Font Metric &amp; Proportion Normalization</h1>
+      <p>Demonstrating automatic mixed-font visual height normalization and numeric aspect-ratio overrides.</p>
+    </header>
+
+    <section class="card" aria-labelledby="mixed-heading">
+      <span class="section-label" id="mixed-heading">Automatic Metric Normalization</span>
+      <p id="mixed-fonts-container">
+        When combining prose set in a traditional serif typeface with technical inline code tokens such as
+        <code>const MetricRatio = window.getComputedStyle(el).fontSizeAdjust;</code> or
+        <code>font-size-adjust: from-font</code>, differing x-heights can create jarring visual jumps. By applying
+        automatic metric adjustment on this paragraph container, inline code snippets like
+        <code>Array.prototype.map()</code> and <code>document.querySelector('#mixed-fonts-container')</code> scale
+        harmoniously to match the surrounding text's lowercase visual height.
+      </p>
+    </section>
+
+    <div id="independent-theme-container">
+      <span class="section-label" style="color: #94a3b8;">Independent Theme Container</span>
+      <h2>Locked Visual &amp; Typographic Proportions</h2>
+      <p>
+        This standalone dark-themed container applies an explicit numeric override
+        (<code>font-size-adjust: 0.52</code> and <code>aspect-ratio: 16 / 9</code>) so its typography and container
+        geometry maintain consistent visual proportions regardless of fallback font metrics or surrounding styles.
+      </p>
+    </div>
+  </main>
+</body>
+</html>
