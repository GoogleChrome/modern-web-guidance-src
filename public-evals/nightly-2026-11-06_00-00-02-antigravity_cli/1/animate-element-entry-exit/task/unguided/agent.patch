+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoDeals = [
+      {
+        title: 'Free Pastry Friday',
+        description: 'Get a complimentary freshly baked croissant with any large specialty coffee order.',
+        link: '/rewards'
+      },
+      {
+        title: 'Roaster’s Reserve 20% Off',
+        description: 'Take home a bag of our single-origin Ethiopian whole-bean coffee at 20% off.',
+        link: '/menu'
+      },
+      {
+        title: 'Double Rewards Weekend',
+        description: 'Earn 2x loyalty points on every mobile order placed Saturday and Sunday.',
+        link: '/rewards'
+      },
+      {
+        title: 'Bring-a-Tumbler Discount',
+        description: 'Save $1.00 on any hot or iced beverage when you bring your own reusable cup.',
+        link: '/locations'
+      }
+    ];
+
+    let promoCount = 0;
+
+    addBtn.addEventListener('click', () => {
+      const deal = promoDeals[promoCount % promoDeals.length];
+      promoCount++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${deal.title}</h3>
+        <p>${deal.description}</p>
+        <a href="${deal.link}" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      if (lastCard.hidden || getComputedStyle(lastCard).display === 'none') {
+        lastCard.remove();
+        return;
+      }
+
+      lastCard.classList.add('removing');
+      let removed = false;
+      const cleanup = () => {
+        if (removed) return;
+        removed = true;
+        lastCard.remove();
+      };
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 350);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
