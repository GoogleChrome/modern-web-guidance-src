+  <script>
+    (() => {
+      function parseRGB(colorStr) {
+        if (!colorStr) return null;
+        const m = colorStr.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/i);
+        if (m) return [parseFloat(m[1]), parseFloat(m[2]), parseFloat(m[3])];
+        return null;
+      }
+
+      function getLuminance([r, g, b]) {
+        const toLinear = (c) => {
+          const s = c / 255;
+          return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+        };
+        return 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
+      }
+
+      function getContrastTextColor(bgColorStr) {
+        const rgb = parseRGB(bgColorStr);
+        if (!rgb) return null;
+        const lum = getLuminance(rgb);
+        const contrastWhite = (1.0 + 0.05) / (lum + 0.05);
+        const contrastBlack = (lum + 0.05) / (0.0 + 0.05);
+        return contrastWhite >= contrastBlack ? '#ffffff' : '#000000';
+      }
+
+      let lastPrimaryContrast = null;
+      let lastSecondaryContrast = null;
+
+      function updateContrastColors() {
+        const nav = document.querySelector('nav');
+        if (nav) {
+          const navBg = getComputedStyle(nav).backgroundColor;
+          const navText = getContrastTextColor(navBg);
+          if (navText && navText !== lastPrimaryContrast) {
+            lastPrimaryContrast = navText;
+            document.documentElement.style.setProperty('--primary-contrast', navText);
+          }
+        }
+
+        const footer = document.querySelector('footer');
+        if (footer) {
+          const footerBg = getComputedStyle(footer).backgroundColor;
+          const footerText = getContrastTextColor(footerBg);
+          if (footerText && footerText !== lastSecondaryContrast) {
+            lastSecondaryContrast = footerText;
+            document.documentElement.style.setProperty('--secondary-contrast', footerText);
+          }
+        }
+      }
+
+      updateContrastColors();
+
+      const observer = new MutationObserver(updateContrastColors);
+      observer.observe(document.documentElement, {
+        attributes: true,
+        childList: true,
+        subtree: true,
+        characterData: true
+      });
+
+      window.addEventListener('load', updateContrastColors);
+    })();
+  </script>
+
