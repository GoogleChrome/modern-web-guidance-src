+  <script>
+    (function () {
+      const searchInput = document.getElementById('search-input');
+      const cardElements = document.querySelectorAll('.grid .card h3, .grid .card p, .grid .card a');
+
+      cardElements.forEach((el) => {
+        el.dataset.originalText = el.textContent;
+      });
+
+      function highlightMatches() {
+        const query = searchInput.value;
+
+        cardElements.forEach((el) => {
+          el.textContent = el.dataset.originalText;
+        });
+
+        if (!query) {
+          return;
+        }
+
+        const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+        const regex = new RegExp(`(${escapedQuery})`, 'gi');
+
+        cardElements.forEach((el) => {
+          const originalText = el.dataset.originalText;
+          if (!regex.test(originalText)) {
+            return;
+          }
+          regex.lastIndex = 0;
+
+          const fragment = document.createDocumentFragment();
+          const parts = originalText.split(regex);
+
+          parts.forEach((part, index) => {
+            if (index % 2 === 1) {
+              const mark = document.createElement('mark');
+              mark.className = 'highlight';
+              mark.style.backgroundColor = 'gold';
+              mark.textContent = part;
+              fragment.appendChild(mark);
+            } else if (part) {
+              fragment.appendChild(document.createTextNode(part));
+            }
+          });
+
+          el.textContent = '';
+          el.appendChild(fragment);
+        });
+      }
+
+      searchInput.addEventListener('input', highlightMatches);
+      searchInput.addEventListener('keyup', highlightMatches);
+    })();
+  </script>
 </body>
 
