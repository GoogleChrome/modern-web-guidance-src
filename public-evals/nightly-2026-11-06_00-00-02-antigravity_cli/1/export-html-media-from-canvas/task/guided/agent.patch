+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('card_recipient_input');
+      const messageInput = document.getElementById('card_message_input');
+      const bgColorInput = document.getElementById('card_bg_color');
+      const swatchButtons = document.querySelectorAll('.swatch-btn');
+      const recipientDisplay = document.getElementById('card_recipient_display');
+      const messageDisplay = document.getElementById('card_message_display');
+      const exportBtn = document.getElementById('export_card_btn');
+      const fallbackNotice = document.getElementById('canvas_fallback_notice');
+
+      let currentBgColor = '#4e342e';
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      function renderFallbackCanvas() {
+        const dpr = window.devicePixelRatio || 1;
+        const width = canvas.width / dpr;
+        const height = canvas.height / dpr;
+
+        ctx.save();
+        ctx.scale(dpr, dpr);
+        ctx.clearRect(0, 0, width, height);
+
+        // Card background
+        ctx.fillStyle = currentBgColor;
+        ctx.beginPath();
+        if (ctx.roundRect) {
+          ctx.roundRect(0, 0, width, height, 16);
+        } else {
+          ctx.rect(0, 0, width, height);
+        }
+        ctx.fill();
+
+        // Card border
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.45)';
+        ctx.lineWidth = 4;
+        ctx.stroke();
+
+        // Header text
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 16px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('THE DAILY GRIND', 24, 42);
+
+        // Badge
+        const badgeText = '$25 GIFT CARD';
+        ctx.font = 'bold 13px "Segoe UI", Tahoma, sans-serif';
+        const badgeWidth = ctx.measureText(badgeText).width + 20;
+        const badgeX = width - 24 - badgeWidth;
+        ctx.fillStyle = '#ffab40';
+        ctx.beginPath();
+        if (ctx.roundRect) {
+          ctx.roundRect(badgeX, 24, badgeWidth, 26, 13);
+        } else {
+          ctx.rect(badgeX, 24, badgeWidth, 26);
+        }
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.fillText(badgeText, badgeX + 10, 42);
+
+        // Message & Recipient
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 20px "Segoe UI", Tahoma, sans-serif';
+        const messageText = messageDisplay.textContent || 'Enjoy a warm cup on me!';
+        ctx.fillText(messageText.slice(0, 36), 24, 125);
+        if (messageText.length > 36) {
+          ctx.fillText(messageText.slice(36, 72), 24, 152);
+        }
+
+        ctx.font = '15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.fillText('For: ' + (recipientDisplay.textContent || 'Alex'), 24, 185);
+
+        // Footer divider & text
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(24, height - 44);
+        ctx.lineTo(width - 24, height - 44);
+        ctx.stroke();
+
+        ctx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.fillText('ARTISANAL ROASTERS', 24, height - 24);
+        const rightFooter = 'REDEEMABLE IN-STORE & ONLINE';
+        const rightWidth = ctx.measureText(rightFooter).width;
+        ctx.fillText(rightFooter, width - 24 - rightWidth, height - 24);
+
+        ctx.restore();
+      }
+
+      function triggerCanvasRepaint() {
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderFallbackCanvas();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(exportElement, 0, 0);
+        };
+      } else {
+        fallbackNotice.textContent = 'Note: Native HTML-in-Canvas API is not enabled in this browser; using 2D canvas fallback preview.';
+        fallbackNotice.classList.add('visible');
+      }
+
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        triggerCanvasRepaint();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      recipientInput.addEventListener('input', (event) => {
+        const val = event.target.value.trim();
+        recipientDisplay.textContent = val || 'Coffee Lover';
+        triggerCanvasRepaint();
+      });
+
+      messageInput.addEventListener('input', (event) => {
+        const val = event.target.value.trim();
+        messageDisplay.textContent = val || 'Enjoy a warm cup on me!';
+        triggerCanvasRepaint();
+      });
+
+      function updateCardColor(color) {
+        currentBgColor = color;
+        bgColorInput.value = color;
+        exportElement.style.setProperty('--card-bg', color);
+        swatchButtons.forEach((btn) => {
+          btn.setAttribute('aria-pressed', String(btn.dataset.color.toLowerCase() === color.toLowerCase()));
+        });
+        triggerCanvasRepaint();
+      }
+
+      bgColorInput.addEventListener('input', (event) => {
+        updateCardColor(event.target.value);
+      });
+
+      swatchButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          updateCardColor(btn.dataset.color);
+        });
+      });
+
+      exportBtn.addEventListener('click', () => {
+        triggerCanvasRepaint();
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = dataURL;
+        link.click();
+      });
+    })();
+  </script>
 </body>
 
