+  <script>
+    (function () {
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('card_recipient');
+      const messageInput = document.getElementById('card_message');
+      const amountSelect = document.getElementById('card_amount');
+      const bgColorInput = document.getElementById('card_bg_color');
+      const swatches = document.querySelectorAll('.color-swatch');
+
+      const recipientDisplay = document.getElementById('card_recipient_display');
+      const messageDisplay = document.getElementById('card_message_display');
+      const amountDisplay = document.getElementById('card_amount_display');
+
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const renderBtn = document.getElementById('render_canvas_btn');
+      const exportBtn = document.getElementById('export_card_btn');
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        context.beginPath();
+        context.moveTo(x + radius, y);
+        context.lineTo(x + width - radius, y);
+        context.quadraticCurveTo(x + width, y, x + width, y + radius);
+        context.lineTo(x + width, y + height - radius);
+        context.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
+        context.lineTo(x + radius, y + height);
+        context.quadraticCurveTo(x, y + height, x, y + height - radius);
+        context.lineTo(x, y + radius);
+        context.quadraticCurveTo(x, y, x + radius, y);
+        context.closePath();
+      }
+
+      function wrapText(context, text, x, y, maxWidth, lineHeight, maxLines) {
+        const words = text.split(/\s+/);
+        let line = '';
+        let lineCount = 0;
+
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line ? line + ' ' + words[i] : words[i];
+          const metrics = context.measureText(testLine);
+          if (metrics.width > maxWidth && line) {
+            context.fillText(line, x, y);
+            line = words[i];
+            y += lineHeight;
+            lineCount++;
+            if (maxLines && lineCount >= maxLines - 1) {
+              const remaining = words.slice(i).join(' ');
+              context.fillText(remaining, x, y);
+              return y + lineHeight;
+            }
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          context.fillText(line, x, y);
+          y += lineHeight;
+        }
+        return y;
+      }
+
+      function drawCardFallback() {
+        const width = canvas.width;
+        const height = canvas.height;
+        const bgColor = bgColorInput.value || '#4e342e';
+        const brandText = '☕ THE DAILY GRIND';
+        const amountText = amountDisplay.textContent.trim();
+        const messageText = messageDisplay.textContent.trim();
+        const recipientText = recipientDisplay.textContent.trim();
+
+        ctx.clearRect(0, 0, width, height);
+
+        ctx.save();
+        drawRoundedRect(ctx, 0, 0, width, height, 16);
+        ctx.clip();
+
+        // Card background
+        ctx.fillStyle = bgColor;
+        ctx.fillRect(0, 0, width, height);
+
+        // Decorative accent circle
+        ctx.fillStyle = 'rgba(255, 171, 64, 0.12)';
+        ctx.beginPath();
+        ctx.arc(width - 50, height - 50, 90, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Brand title
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(brandText, 24, 38);
+
+        // Amount pill
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+        const amountWidth = ctx.measureText(amountText).width + 24;
+        const pillX = width - 24 - amountWidth;
+        const pillY = 24;
+        ctx.fillStyle = '#ffab40';
+        drawRoundedRect(ctx, pillX, pillY, amountWidth, 28, 14);
+        ctx.fill();
+
+        ctx.fillStyle = '#3e2723';
+        ctx.fillText(amountText, pillX + 12, pillY + 14);
+
+        // Message body
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 20px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'top';
+        const nextY = wrapText(ctx, messageText, 24, 92, width - 48, 27, 3);
+
+        // Recipient line
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.font = 'italic 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(recipientText, 24, Math.min(nextY + 6, 175));
+
+        // Footer divider & text
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(24, height - 42);
+        ctx.lineTo(width - 24, height - 42);
+        ctx.stroke();
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'alphabetic';
+        ctx.fillText('ARTISANAL COFFEE GIFT CARD', 24, height - 22);
+
+        const rightFooter = 'REDEEMABLE IN-STORE & ONLINE';
+        const rightWidth = ctx.measureText(rightFooter).width;
+        ctx.fillText(rightFooter, width - 24 - rightWidth, height - 22);
+
+        ctx.restore();
+      }
+
+      function renderHtmlCardToCanvas(callback) {
+        // First draw synchronous 2D representation so canvas is immediately populated
+        drawCardFallback();
+
+        // Also serialize the actual #export_element DOM node into an SVG foreignObject
+        // and render it onto the canvas for faithful HTML-to-canvas rendering
+        try {
+          const width = canvas.width;
+          const height = canvas.height;
+          const clone = exportElement.cloneNode(true);
+          clone.setAttribute('xmlns', 'http://www.w3.org/1999/xhtml');
+
+          const computedBg = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+          clone.style.cssText = [
+            'width:' + width + 'px',
+            'height:' + height + 'px',
+            'background-color:' + computedBg,
+            'color:#ffffff',
+            'border-radius:16px',
+            'padding:24px',
+            'box-sizing:border-box',
+            'display:flex',
+            'flex-direction:column',
+            'justify-content:space-between',
+            'position:relative',
+            'overflow:hidden',
+            'font-family:"Segoe UI", Tahoma, Geneva, Verdana, sans-serif'
+          ].join(';');
+
+          const topEl = clone.querySelector('.gift-card-top');
+          if (topEl) {
+            topEl.style.cssText = 'display:flex;justify-content:space-between;align-items:center;';
+          }
+          const brandEl = clone.querySelector('.gift-card-brand');
+          if (brandEl) {
+            brandEl.style.cssText = 'font-weight:700;letter-spacing:1.5px;font-size:15px;display:flex;align-items:center;gap:8px;';
+          }
+          const amountEl = clone.querySelector('.gift-card-amount');
+          if (amountEl) {
+            amountEl.style.cssText = 'background:#ffab40;color:#3e2723;font-weight:700;padding:4px 12px;border-radius:20px;font-size:15px;';
+          }
+          const msgEl = clone.querySelector('.gift-card-message');
+          if (msgEl) {
+            msgEl.style.cssText = 'font-size:20px;font-weight:600;line-height:1.35;margin-bottom:8px;word-break:break-word;';
+          }
+          const recEl = clone.querySelector('.gift-card-recipient');
+          if (recEl) {
+            recEl.style.cssText = 'font-size:15px;opacity:0.9;font-style:italic;';
+          }
+          const footerEl = clone.querySelector('.gift-card-footer');
+          if (footerEl) {
+            footerEl.style.cssText = 'display:flex;justify-content:space-between;align-items:center;font-size:12px;opacity:0.8;border-top:1px solid rgba(255,255,255,0.2);padding-top:10px;';
+          }
+
+          const serialized = new XMLSerializer().serializeToString(clone);
+          const svgMarkup =
+            '<svg xmlns="http://www.w3.org/2000/svg" width="' + width + '" height="' + height + '">' +
+            '<foreignObject width="100%" height="100%">' +
+            serialized +
+            '</foreignObject>' +
+            '</svg>';
+
+          const img = new Image();
+          img.onload = function () {
+            ctx.clearRect(0, 0, width, height);
+            ctx.drawImage(img, 0, 0, width, height);
+            if (typeof callback === 'function') callback();
+          };
+          img.onerror = function () {
+            if (typeof callback === 'function') callback();
+          };
+          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgMarkup);
+        } catch (err) {
+          if (typeof callback === 'function') callback();
+        }
+      }
+
+      function updateHtmlCard() {
+        const recipient = recipientInput.value.trim() || 'Coffee Lover';
+        const message = messageInput.value.trim() || 'Enjoy a freshly brewed cup on me!';
+        const amount = amountSelect.value || '$25';
+        const bgColor = bgColorInput.value || '#4e342e';
+
+        recipientDisplay.textContent = 'For: ' + recipient;
+        messageDisplay.textContent = message;
+        amountDisplay.textContent = amount;
+        exportElement.style.backgroundColor = bgColor;
+
+        swatches.forEach(function (swatch) {
+          if (swatch.getAttribute('data-color').toLowerCase() === bgColor.toLowerCase()) {
+            swatch.classList.add('active');
+          } else {
+            swatch.classList.remove('active');
+          }
+        });
+
+        renderHtmlCardToCanvas();
+      }
+
+      recipientInput.addEventListener('input', updateHtmlCard);
+      messageInput.addEventListener('input', updateHtmlCard);
+      amountSelect.addEventListener('change', updateHtmlCard);
+      bgColorInput.addEventListener('input', updateHtmlCard);
+
+      swatches.forEach(function (swatch) {
+        swatch.addEventListener('click', function () {
+          const color = swatch.getAttribute('data-color');
+          bgColorInput.value = color;
+          updateHtmlCard();
+        });
+      });
+
+      renderBtn.addEventListener('click', function () {
+        renderHtmlCardToCanvas();
+      });
+
+      exportBtn.addEventListener('click', function () {
+        renderHtmlCardToCanvas(function () {
+          let dataUrl;
+          try {
+            dataUrl = canvas.toDataURL('image/png');
+          } catch (e) {
+            drawCardFallback();
+            dataUrl = canvas.toDataURL('image/png');
+          }
+          const link = document.createElement('a');
+          const recipientSlug = (recipientInput.value.trim() || 'gift-card')
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/(^-|-$)/g, '');
+          link.download = 'daily-grind-' + (recipientSlug || 'gift-card') + '.png';
+          link.href = dataUrl;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+        });
+      });
+
+      // Initial render on page load
+      updateHtmlCard();
+    })();
+  </script>
