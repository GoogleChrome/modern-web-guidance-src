+  <script>
+    // 1. Conditionally load the Invoker Commands polyfill
+    const hasNativeSupport = 'commandForElement' in HTMLButtonElement.prototype;
+
+    if (!hasNativeSupport) {
+      (async () => {
+        try {
+          await import('https://esm.run/invokers-polyfill');
+        } catch (err) {
+          console.error('Error loading fallback:', err);
+        }
+      })();
+    }
+
+    // 2. Manual fallback if CommandEvent doesn't exist (e.g., offline or before polyfill loads)
+    if (!globalThis.CommandEvent) {
+      globalThis.CommandEvent = class CommandEvent extends Event {
+        constructor(type, { source, command, ...options } = {}) {
+          super(type, options);
+          this.source = source;
+          this.command = command;
+        }
+      };
+
+      document.addEventListener('click', (event) => {
+        if ('commandForElement' in HTMLButtonElement.prototype) return;
+        const button = event.composedPath().find((el) => el.matches?.('button[commandfor]'));
+        if (!button) return;
+
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        const command = button.getAttribute('command');
+
+        if (target && command) {
+          target.dispatchEvent(new CommandEvent('command', {
+            command,
+            source: button,
+          }));
+        }
+      });
+    }
+
+    // 3. Define a registry of custom command actions and manage ARIA states
+    const commandRegistry = {
+      '--spin': (target, source) => {
+        const isSpun = target.classList.toggle('is-spun');
+        source?.setAttribute('aria-pressed', String(isSpun));
+      },
+      '--grow': (target, source) => {
+        const isGrown = target.classList.toggle('is-grown');
+        source?.setAttribute('aria-pressed', String(isGrown));
+      },
+      '--round': (target, source) => {
+        const isRounded = target.classList.toggle('is-rounded');
+        source?.setAttribute('aria-pressed', String(isRounded));
+      },
+      '--reset': (target) => {
+        target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+        document.querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`).forEach((btn) => {
+          btn.setAttribute('aria-pressed', 'false');
+        });
+      },
+    };
+
+    // 4. Listen for the 'command' event directly on the target element
+    document.getElementById('action-target').addEventListener('command', (event) => {
+      const command = event.command;
+      const target = event.target;
+      const source = event.source;
+      const action = commandRegistry[command];
+
+      if (action) {
+        action(target, source);
+      }
+    });
+  </script>
+
