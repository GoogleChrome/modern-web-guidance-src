+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let activeIndex = 0;
+      let scrollFinishTimer = null;
+
+      function getClosestIndex() {
+        const galleryRect = gallery.getBoundingClientRect();
+        const galleryCenter = galleryRect.left + galleryRect.width / 2;
+        let closestIdx = 0;
+        let minDistance = Infinity;
+
+        items.forEach((item, index) => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(itemCenter - galleryCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIdx = index;
+          }
+        });
+
+        return closestIdx;
+      }
+
+      function setPendingThumbnail(targetIndex) {
+        thumbnails.forEach((thumb, idx) => {
+          thumb.classList.toggle('pending', idx === targetIndex);
+        });
+      }
+
+      function finalizeScroll(finalIndex) {
+        if (scrollFinishTimer) {
+          clearTimeout(scrollFinishTimer);
+          scrollFinishTimer = null;
+        }
+        const resolvedIndex = typeof finalIndex === 'number' ? finalIndex : getClosestIndex();
+        activeIndex = resolvedIndex;
+
+        thumbnails.forEach((thumb, idx) => {
+          thumb.classList.remove('pending');
+          if (idx === activeIndex) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Listen for native scrollsnapchanging event for instant snap target detection
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const snapTarget = event.snapTargetInline || event.snapTargetBlock;
+        if (snapTarget) {
+          const idx = items.indexOf(snapTarget);
+          if (idx !== -1) {
+            setPendingThumbnail(idx);
+          }
+        }
+      });
+
+      // Listen for native scrollsnapchange event when snap completes
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const snapTarget = event.snapTargetInline || event.snapTargetBlock;
+        if (snapTarget) {
+          const idx = items.indexOf(snapTarget);
+          if (idx !== -1) {
+            finalizeScroll(idx);
+          }
+        }
+      });
+
+      // Listen for scroll and scrollend events to guarantee cross-browser support
+      gallery.addEventListener('scroll', () => {
+        const targetIdx = getClosestIndex();
+        setPendingThumbnail(targetIdx);
+
+        if (scrollFinishTimer) {
+          clearTimeout(scrollFinishTimer);
+        }
+        scrollFinishTimer = setTimeout(() => {
+          finalizeScroll();
+        }, 150);
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', () => {
+        finalizeScroll();
+      });
+
+      // Allow clicking thumbnails to scroll to the corresponding item
+      thumbnails.forEach((thumb, idx) => {
+        thumb.addEventListener('click', () => {
+          const targetItem = items[idx];
+          if (!targetItem) return;
+          const targetScrollLeft = targetItem.offsetLeft - (gallery.clientWidth - targetItem.clientWidth) / 2;
+
+          if (Math.abs(gallery.scrollLeft - targetScrollLeft) < 2) {
+            finalizeScroll(idx);
+            return;
+          }
+
+          setPendingThumbnail(idx);
+          gallery.scrollTo({
+            left: targetScrollLeft,
+            behavior: 'smooth'
+          });
+        });
+      });
+    })();
+  </script>
+
