+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const originItems = Array.from(scroller.querySelectorAll('.origin-item'));
+    let isScrolling = false;
+
+    function findMostVisibleOrigin(container) {
+      const containerRect = container.getBoundingClientRect();
+      let mostVisibleOrigin = '';
+      let maxVisibleArea = -1;
+
+      for (const item of originItems) {
+        const rect = item.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, containerRect.top);
+        const visibleBottom = Math.min(rect.bottom, containerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleArea) {
+          maxVisibleArea = visibleHeight;
+          mostVisibleOrigin = item.dataset.origin || item.querySelector('h3').textContent.trim();
+        }
+      }
+
+      return mostVisibleOrigin;
+    }
+
+    function initializeScroller() {
+      // 1. Lightweight informative feedback during scroll without layout reads
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      // 2. Defer layout measurements until scrolling ends
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        const visibleOrigin = findMostVisibleOrigin(scroller);
+        statusEl.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
