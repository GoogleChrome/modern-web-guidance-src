+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      const items = Array.from(scroller.querySelectorAll('.bean-item'));
+
+      let isScrolling = false;
+      let scrollTimeout = null;
+
+      function getMostVisibleOrigin() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        let bestOrigin = '';
+        let maxVisibleScore = -1;
+
+        for (const item of items) {
+          const itemRect = item.getBoundingClientRect();
+          const visibleTop = Math.max(scrollerRect.top, itemRect.top);
+          const visibleBottom = Math.min(scrollerRect.bottom, itemRect.bottom);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          const visibleWidth = Math.max(
+            0,
+            Math.min(scrollerRect.right, itemRect.right) - Math.max(scrollerRect.left, itemRect.left)
+          );
+          const visibleArea = visibleHeight * visibleWidth;
+
+          if (visibleArea > maxVisibleScore) {
+            maxVisibleScore = visibleArea;
+            bestOrigin = item.getAttribute('data-origin') || item.querySelector('h3').textContent.trim();
+          }
+        }
+
+        return bestOrigin;
+      }
+
+      function onScrollStop() {
+        isScrolling = false;
+        if (scrollTimeout) {
+          clearTimeout(scrollTimeout);
+          scrollTimeout = null;
+        }
+        const origin = getMostVisibleOrigin();
+        statusEl.textContent = `Scroll ended. Visible: ${origin}`;
+      }
+
+      // Passive scroll listener that only updates DOM on state transition into scrolling
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          if (!isScrolling) {
+            isScrolling = true;
+            statusEl.textContent = 'Scrolling...';
+          }
+
+          // Fallback debounce for environments where scrollend isn't fired
+          if (scrollTimeout) {
+            clearTimeout(scrollTimeout);
+          }
+          scrollTimeout = setTimeout(onScrollStop, 150);
+        },
+        { passive: true }
+      );
+
+      // Native scrollend event for immediate accuracy when scrolling finishes
+      scroller.addEventListener('scrollend', onScrollStop, { passive: true });
+    })();
+  </script>
