+  <script>
+    (() => {
+      const grid = document.getElementById('card-grid');
+      if (!grid) return;
+
+      const DIRECTION_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);
+      const TOLERANCE = 2;
+      const FALLBACK_WEIGHT = 2.5;
+
+      function getCandidates(container) {
+        const allFocusable = Array.from(
+          container.querySelectorAll('a[href], button:not(:disabled), [role="gridcell"][tabindex]')
+        );
+        return allFocusable.filter((el) => el.checkVisibility());
+      }
+
+      function setActiveCandidate(candidates, nextActive) {
+        for (const candidate of candidates) {
+          candidate.setAttribute('tabindex', candidate === nextActive ? '0' : '-1');
+        }
+      }
+
+      function findNextCandidate(current, candidates, key) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = currentRect.left + currentRect.width / 2;
+        const currentCenterY = currentRect.top + currentRect.height / 2;
+
+        const isHorizontal = key === 'ArrowLeft' || key === 'ArrowRight';
+        const aligned = [];
+        const unaligned = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+          const rect = candidate.getBoundingClientRect();
+
+          let gap = -1;
+          if (key === 'ArrowRight' && rect.left >= currentRect.right - TOLERANCE) {
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (key === 'ArrowLeft' && rect.right <= currentRect.left + TOLERANCE) {
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (key === 'ArrowDown' && rect.top >= currentRect.bottom - TOLERANCE) {
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (key === 'ArrowUp' && rect.bottom <= currentRect.top + TOLERANCE) {
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          if (gap < 0) continue;
+
+          const candidateCenterX = rect.left + rect.width / 2;
+          const candidateCenterY = rect.top + rect.height / 2;
+
+          const overlapsPerpendicular = isHorizontal
+            ? Math.min(currentRect.bottom, rect.bottom) > Math.max(currentRect.top, rect.top) + TOLERANCE
+            : Math.min(currentRect.right, rect.right) > Math.max(currentRect.left, rect.left) + TOLERANCE;
+
+          const perpendicularCenterOffset = isHorizontal
+            ? Math.abs(candidateCenterY - currentCenterY)
+            : Math.abs(candidateCenterX - currentCenterX);
+
+          const item = {
+            element: candidate,
+            gap,
+            perpendicularCenterOffset,
+            fallbackScore: gap + FALLBACK_WEIGHT * perpendicularCenterOffset,
+          };
+
+          if (overlapsPerpendicular) {
+            aligned.push(item);
+          } else {
+            unaligned.push(item);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => a.gap - b.gap || a.perpendicularCenterOffset - b.perpendicularCenterOffset);
+          return aligned[0].element;
+        }
+
+        if (unaligned.length > 0) {
+          unaligned.sort((a, b) => a.fallbackScore - b.fallbackScore || a.gap - b.gap);
+          return unaligned[0].element;
+        }
+
+        return null;
+      }
+
+      grid.addEventListener('keydown', (e) => {
+        if (!DIRECTION_KEYS.has(e.key)) return;
+        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element)) return;
+
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+          return;
+        }
+
+        const candidates = getCandidates(grid);
+        if (!candidates.includes(target)) return;
+
+        const nextCandidate = findNextCandidate(target, candidates, e.key);
+        if (!nextCandidate) {
+          // Do not call preventDefault() when no candidate exists in the pressed direction,
+          // preserving native browser boundary scrolling.
+          return;
+        }
+
+        e.preventDefault();
+        setActiveCandidate(candidates, nextCandidate);
+        nextCandidate.focus();
+        nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+
+      grid.addEventListener('focusin', (e) => {
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element)) return;
+        const candidates = getCandidates(grid);
+        if (candidates.includes(target)) {
+          setActiveCandidate(candidates, target);
+        }
+      });
+
+      const layoutButtons = document.querySelectorAll('[data-set-layout]');
+      for (const btn of layoutButtons) {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-set-layout');
+          grid.setAttribute('data-layout', mode);
+          for (const b of layoutButtons) {
+            b.setAttribute('aria-pressed', String(b === btn));
+          }
+        });
+      }
+    })();
+  </script>
+
