+export class CoffeeMenuSection extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subtitle', 'active-category'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._activeCategory = 'all';
+    this._searchQuery = '';
+    this._favoritesOnly = false;
+
+    this._headingEl = this.shadowRoot.querySelector('#menu-heading');
+    this._subtitleEl = this.shadowRoot.querySelector('.subtitle');
+    this._tabs = Array.from(this.shadowRoot.querySelectorAll('.tab-btn'));
+    this._searchInput = this.shadowRoot.querySelector('.search-input');
+    this._favToggle = this.shadowRoot.querySelector('.favorites-toggle');
+    this._resultsCount = this.shadowRoot.querySelector('.results-count');
+    this._emptyState = this.shadowRoot.querySelector('.empty-state');
+    this._resetBtn = this.shadowRoot.querySelector('.reset-btn');
+    this._slot = this.shadowRoot.querySelector('slot');
+  }
+
+  connectedCallback() {
+    this._syncAttributes();
+    this._bindEvents();
+    this._applyFilters();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this._syncAttributes();
+    if (name === 'active-category' && newValue) {
+      this._setCategory(newValue);
+    }
+  }
+
+  _syncAttributes() {
+    if (this.hasAttribute('heading')) {
+      this._headingEl.textContent = this.getAttribute('heading');
+    }
+    if (this.hasAttribute('subtitle')) {
+      this._subtitleEl.textContent = this.getAttribute('subtitle');
+    }
+  }
+
+  _bindEvents() {
+    if (this._bound) return;
+    this._bound = true;
+
+    const tabList = this.shadowRoot.querySelector('.filter-tabs');
+    tabList.addEventListener('click', (e) => {
+      const tab = e.target.closest('.tab-btn');
+      if (!tab) return;
+      this._setCategory(tab.dataset.category);
+    });
+
+    tabList.addEventListener('keydown', (e) => {
+      const idx = this._tabs.indexOf(e.target.closest('.tab-btn'));
+      if (idx === -1) return;
+      let nextIdx = -1;
+      if (e.key === 'ArrowRight') {
+        e.preventDefault();
+        nextIdx = (idx + 1) % this._tabs.length;
+      } else if (e.key === 'ArrowLeft') {
+        e.preventDefault();
+        nextIdx = (idx - 1 + this._tabs.length) % this._tabs.length;
+      } else if (e.key === 'Home') {
+        e.preventDefault();
+        nextIdx = 0;
+      } else if (e.key === 'End') {
+        e.preventDefault();
+        nextIdx = this._tabs.length - 1;
+      }
+      if (nextIdx !== -1) {
+        const nextTab = this._tabs[nextIdx];
+        nextTab.focus();
+        this._setCategory(nextTab.dataset.category);
+      }
+    });
+
+    this._searchInput.addEventListener('input', (e) => {
+      this._searchQuery = e.target.value.trim().toLowerCase();
+      this._applyFilters();
+    });
+
+    this._favToggle.addEventListener('click', () => {
+      this._favoritesOnly = !this._favoritesOnly;
+      this._favToggle.setAttribute('aria-pressed', String(this._favoritesOnly));
+      this._applyFilters();
+    });
+
+    this._resetBtn.addEventListener('click', () => {
+      this._searchInput.value = '';
+      this._searchQuery = '';
+      this._favoritesOnly = false;
+      this._favToggle.setAttribute('aria-pressed', 'false');
+      this._setCategory('all');
+    });
+
+    this._slot.addEventListener('slotchange', () => {
+      this._applyFilters();
+    });
+
+    this.addEventListener('coffee-favorite', () => {
+      if (this._favoritesOnly) {
+        this._applyFilters();
+      }
+    });
+  }
+
+  _setCategory(category) {
+    this._activeCategory = category;
+    this._tabs.forEach((tab) => {
+      const active = tab.dataset.category === category;
+      tab.setAttribute('aria-selected', String(active));
+      tab.tabIndex = active ? 0 : -1;
+    });
+    this._applyFilters();
+    this.dispatchEvent(
+      new CustomEvent('coffee-filter-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          category: this._activeCategory,
+          search: this._searchQuery,
+          favoritesOnly: this._favoritesOnly
+        }
+      })
+    );
+  }
+
+  _getCards() {
+    const assigned = this._slot.assignedElements({ flatten: true });
+    return assigned.filter((el) => el.tagName.toLowerCase() === 'coffee-card' || el.classList.contains('card'));
+  }
+
+  _applyFilters() {
+    const cards = this._getCards();
+    if (cards.length === 0) return;
+
+    let visibleCount = 0;
+    cards.forEach((card) => {
+      const cat = (card.getAttribute('category') || '').toLowerCase();
+      const name = (card.getAttribute('name') || card.textContent || '').toLowerCase();
+      const desc = (card.getAttribute('description') || '').toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const roast = (card.getAttribute('roast') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited') && card.getAttribute('favorited') !== 'false';
+
+      const matchesCategory = this._activeCategory === 'all' || cat === this._activeCategory;
+      const matchesSearch =
+        !this._searchQuery ||
+        name.includes(this._searchQuery) ||
+        desc.includes(this._searchQuery) ||
+        notes.includes(this._searchQuery) ||
+        roast.includes(this._searchQuery);
+      const matchesFav = !this._favoritesOnly || isFav;
+
+      const visible = matchesCategory && matchesSearch && matchesFav;
+      card.hidden = !visible;
+      if (visible) visibleCount++;
+    });
+
+    this._resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} handcrafted drink${cards.length === 1 ? '' : 's'}`;
+    this._emptyState.hidden = visibleCount > 0;
+  }
+}
+
+if (!customElements.get('coffee-menu-section')) {
+  customElements.define('coffee-menu-section', CoffeeMenuSection);
+}
