+
+    <div class="nav-controls">
+      <button
+        type="button"
+        class="menu-toggle"
+        aria-expanded="false"
+        aria-controls="primary-nav-list"
+        aria-label="Toggle navigation menu"
+      >
+        ☰ Menu
+      </button>
+
+      <ul id="primary-nav-list" part="nav-list">
+        <li><a href="/menu">Menu</a></li>
+        <li><a href="/locations">Locations</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/account">My Account</a></li>
+        <li><a href="/logout" class="logout-link">Logout</a></li>
+      </ul>
+
+      <button
+        type="button"
+        class="cart-trigger"
+        part="cart-button"
+        aria-label="Open order bag, 0 items"
+      >
+        <span aria-hidden="true">☕</span>
+        <span>Order</span>
+        <span class="cart-badge" aria-live="polite">0</span>
+      </button>
+    </div>
+  </nav>
+`;
+
+export class DgNavbar extends HTMLElement {
+  static get observedAttributes() {
+    return ['brand', 'cart-count'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._count = 0;
+    this._badgeEl = this.shadowRoot.querySelector('.cart-badge');
+    this._cartBtn = this.shadowRoot.querySelector('.cart-trigger');
+    this._menuToggle = this.shadowRoot.querySelector('.menu-toggle');
+    this._navList = this.shadowRoot.querySelector('#primary-nav-list');
+  }
+
+  connectedCallback() {
+    this._onCartUpdate = (e) => {
+      if (e.detail && typeof e.detail.totalCount === 'number') {
+        this._setCount(e.detail.totalCount);
+      }
+    };
+
+    document.addEventListener('coffee-cart-updated', this._onCartUpdate);
+
+    this._cartBtn.addEventListener('click', () => {
+      this.dispatchEvent(
+        new CustomEvent('coffee-toggle-cart', {
+          bubbles: true,
+          composed: true
+        })
+      );
+    });
+
+    this._menuToggle.addEventListener('click', () => {
+      const open = this._menuToggle.getAttribute('aria-expanded') === 'true';
+      const next = !open;
+      this._menuToggle.setAttribute('aria-expanded', String(next));
+      this._navList.dataset.open = String(next);
+    });
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('coffee-cart-updated', this._onCartUpdate);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'cart-count') {
+      this._setCount(parseInt(newVal, 10) || 0);
+    }
+  }
+
+  _setCount(count) {
+    this._count = count;
+    this._badgeEl.textContent = String(count);
+    this._cartBtn.setAttribute('aria-label', `Open order bag, ${count} item${count === 1 ? '' : 's'}`);
+  }
+}
+
+if (!customElements.get('dg-navbar')) {
+  customElements.define('dg-navbar', DgNavbar);
+}
