+      const li = document.createElement('li');
+      li.className = 'empty-msg';
+      li.textContent = 'Your coffee bag is currently empty. Add a drink from Seasonal Favorites!';
+      this._listEl.appendChild(li);
+      this._totalEl.textContent = '$0.00';
+      this._pointsEl.textContent = '0';
+      return;
+    }
+
+    let total = 0;
+    this._items.forEach((item) => {
+      total += item.price * item.qty;
+      const li = document.createElement('li');
+      li.className = 'item-row';
+
+      const info = document.createElement('div');
+      info.className = 'item-info';
+      const title = document.createElement('strong');
+      title.textContent = item.name;
+      const meta = document.createElement('span');
+      meta.className = 'item-meta';
+      meta.textContent = `${item.size}${item.milk ? ` · ${item.milk}` : ''} · $${(item.price * item.qty).toFixed(2)}`;
+      info.appendChild(title);
+      info.appendChild(meta);
+
+      const controls = document.createElement('div');
+      controls.className = 'qty-controls';
+
+      const decBtn = document.createElement('button');
+      decBtn.type = 'button';
+      decBtn.className = 'qty-btn';
+      decBtn.textContent = '−';
+      decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+      decBtn.addEventListener('click', () => {
+        item.qty -= 1;
+        if (item.qty <= 0) {
+          this._items = this._items.filter((x) => x.key !== item.key);
+        }
+        this._render();
+        this._emitCartUpdate();
+      });
+
+      const qtySpan = document.createElement('span');
+      qtySpan.textContent = String(item.qty);
+
+      const incBtn = document.createElement('button');
+      incBtn.type = 'button';
+      incBtn.className = 'qty-btn';
+      incBtn.textContent = '+';
+      incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+      incBtn.addEventListener('click', () => {
+        item.qty += 1;
+        this._render();
+        this._emitCartUpdate();
+      });
+
+      controls.appendChild(decBtn);
+      controls.appendChild(qtySpan);
+      controls.appendChild(incBtn);
+
+      li.appendChild(info);
+      li.appendChild(controls);
+      this._listEl.appendChild(li);
+    });
+
+    this._totalEl.textContent = `$${total.toFixed(2)}`;
+    this._pointsEl.textContent = String(Math.round(total * 10));
+  }
+}
+
+if (!customElements.get('coffee-order-drawer')) {
+  customElements.define('coffee-order-drawer', CoffeeOrderDrawer);
+}
