+      drink.image || 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80';
+    this._img.alt = drink.name || 'Coffee';
+    this._menuLink.setAttribute('href', drink.href || '/menu');
+
+    this._backdrop.hidden = false;
+    this._closeBtn.focus();
+  }
+
+  close() {
+    this._backdrop.hidden = true;
+    if (this._lastFocused && typeof this._lastFocused.focus === 'function') {
+      this._lastFocused.focus();
+    }
+  }
+}
+
+if (!customElements.get('coffee-detail-modal')) {
+  customElements.define('coffee-detail-modal', CoffeeDetailModal);
+}
