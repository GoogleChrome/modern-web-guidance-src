+
+export class CoffeeBrewGuide extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._method = 'pour-over';
+    this._servings = 2;
+    this._strengthAdj = 0;
+
+    this._methodBtns = Array.from(this.shadowRoot.querySelectorAll('.method-btn'));
+    this._strengthBtns = Array.from(this.shadowRoot.querySelectorAll('.strength-btn'));
+    this._servingsInput = this.shadowRoot.querySelector('#servings-range');
+    this._servingsOutput = this.shadowRoot.querySelector('#servings-output');
+    this._coffeeGramsEl = this.shadowRoot.querySelector('.coffee-grams');
+    this._waterMlEl = this.shadowRoot.querySelector('.water-ml');
+    this._grindTempEl = this.shadowRoot.querySelector('.grind-temp');
+    this._brewTimeEl = this.shadowRoot.querySelector('.brew-time');
+    this._tipEl = this.shadowRoot.querySelector('.barista-tip');
+  }
+
+  connectedCallback() {
+    this._bindEvents();
+    this._render();
+  }
+
+  _bindEvents() {
+    if (this._bound) return;
+    this._bound = true;
+
+    const methodTabs = this.shadowRoot.querySelector('.method-tabs');
+    methodTabs.addEventListener('click', (e) => {
+      const btn = e.target.closest('.method-btn');
+      if (!btn) return;
+      this._selectMethod(btn.dataset.method);
+    });
+
+    methodTabs.addEventListener('keydown', (e) => {
+      const idx = this._methodBtns.indexOf(e.target.closest('.method-btn'));
+      if (idx === -1) return;
+      let nextIdx = -1;
+      if (e.key === 'ArrowRight') {
+        e.preventDefault();
+        nextIdx = (idx + 1) % this._methodBtns.length;
+      } else if (e.key === 'ArrowLeft') {
+        e.preventDefault();
+        nextIdx = (idx - 1 + this._methodBtns.length) % this._methodBtns.length;
+      }
+      if (nextIdx !== -1) {
+        const nextBtn = this._methodBtns[nextIdx];
+        nextBtn.focus();
+        this._selectMethod(nextBtn.dataset.method);
+      }
+    });
+
+    this._servingsInput.addEventListener('input', (e) => {
+      this._servings = parseInt(e.target.value, 10) || 1;
+      this._render();
+    });
+
+    const strengthGroup = this.shadowRoot.querySelector('.strength-group');
+    strengthGroup.addEventListener('click', (e) => {
+      const btn = e.target.closest('.strength-btn');
+      if (!btn) return;
+      this._strengthBtns.forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
+      this._strengthAdj = parseFloat(btn.dataset.adj || '0');
+      this._render();
+    });
+  }
+
+  _selectMethod(methodKey) {
+    if (!BREW_METHODS[methodKey]) return;
+    this._method = methodKey;
+    this._methodBtns.forEach((btn) => {
+      const active = btn.dataset.method === methodKey;
+      btn.setAttribute('aria-selected', String(active));
+      btn.tabIndex = active ? 0 : -1;
+    });
+    this._render();
+  }
+
+  _render() {
+    const info = BREW_METHODS[this._method];
+    const isEspresso = this._method === 'espresso';
+    const unitMl = isEspresso ? 36 : 225;
+    const totalWater = this._servings * unitMl;
+    const effectiveRatio = Math.max(1.5, info.ratio + (isEspresso ? this._strengthAdj * 0.25 : this._strengthAdj));
+    const coffeeGrams = Math.round(totalWater / effectiveRatio);
+
+    this._servingsOutput.textContent = `${this._servings} ${isEspresso ? (this._servings === 1 ? 'shot' : 'shots') : this._servings === 1 ? 'cup' : 'cups'}`;
+    this._coffeeGramsEl.textContent = `${coffeeGrams}g`;
+    this._waterMlEl.textContent = `${totalWater}ml`;
+    this._grindTempEl.textContent = `${info.grind.split(' ')[0]} · ${info.temp.split(' ')[0]}`;
+    this._brewTimeEl.textContent = info.time;
+    this._tipEl.textContent = info.tip;
+  }
+}
+
+if (!customElements.get('coffee-brew-guide')) {
+  customElements.define('coffee-brew-guide', CoffeeBrewGuide);
+}
