+    grind: 'Coarse (like sea salt)',
+    temp: '200°F (93°C)',
+    time: '4:00 mins',
+    tip: 'Stir gently after 1 minute to break the crust, then press the plunger slowly to minimize sediment.'
+  },
+  espresso: {
+    label: 'Espresso Shot',
+    ratio: 2,
+    grind: 'Extra Fine (powdery)',
+    temp: '198°F (92°C)',
+    time: '25 – 30 secs',
+    tip: 'Distribute grounds evenly and tamp with firm, level pressure for a rich, honey-like extraction.'
+  },
+  'cold-brew': {
+    label: 'Cold Brew Concentrate',
+    ratio: 8,
+    grind: 'Extra Coarse',
+    temp: 'Cold Filtered Water',
+    time: '16 – 18 hours',
+    tip: 'Steep covered at room temperature or refrigerated, then dilute 1:1 with water or oat milk over ice.'
+  }
+};
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      --guide-primary: var(--primary, #4e342e);
+      --guide-secondary: var(--secondary, #d7ccc8);
+      --guide-accent: var(--accent, #ffab40);
+      --guide-text: var(--text, #3e2723);
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      color: var(--guide-text);
+    }
+
+    .brew-section {
+      background: #ffffff;
+      border-radius: 12px;
+      padding: 28px;
+      box-shadow: 0 4px 14px rgba(62, 39, 35, 0.08);
+      border: 1px solid rgba(78, 52, 46, 0.1);
+      margin-top: 40px;
+    }
+
+    .header {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    h2 {
+      margin: 0 0 8px 0;
+      color: var(--guide-primary);
+      font-size: 1.75rem;
+    }
+
+    .subtitle {
+      margin: 0;
+      color: #6d4c41;
+      font-size: 0.95rem;
+    }
+
+    .method-tabs {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 10px;
+      margin-bottom: 24px;
+    }
+
+    .method-btn {
+      padding: 10px 18px;
+      border-radius: 8px;
+      border: 1px solid var(--guide-secondary);
+      background: #faf7f5;
+      color: var(--guide-text);
+      font-weight: 600;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: all 0.2s;
+    }
+
+    .method-btn:hover {
+      border-color: var(--guide-primary);
+    }
+
+    .method-btn[aria-selected="true"] {
+      background: var(--guide-primary);
+      color: #ffffff;
+      border-color: var(--guide-primary);
+    }
+
+    .method-btn:focus-visible {
+      outline: 3px solid var(--guide-accent);
+      outline-offset: 2px;
+    }
+
+    .calculator-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+      gap: 24px;
+      align-items: center;
+    }
+
+    .controls-panel {
+      background: #faf6f4;
+      padding: 20px;
+      border-radius: 10px;
+    }
+
+    .field-group {
+      margin-bottom: 16px;
+    }
+
+    .field-group:last-child {
+      margin-bottom: 0;
+    }
+
+    label {
+      display: flex;
+      justify-content: space-between;
+      font-weight: 600;
+      font-size: 0.9rem;
+      margin-bottom: 8px;
+      color: var(--guide-primary);
+    }
+
+    input[type="range"] {
+      width: 100%;
+      accent-color: var(--guide-primary);
+      cursor: pointer;
+    }
+
+    input[type="range"]:focus-visible {
+      outline: 2px solid var(--guide-accent);
+      outline-offset: 2px;
