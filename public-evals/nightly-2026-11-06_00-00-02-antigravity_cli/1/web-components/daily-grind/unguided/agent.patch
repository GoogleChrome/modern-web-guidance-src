+      font-weight: 600;
+      cursor: pointer;
+    }
+
+    .strength-btn[aria-checked="true"] {
+      background: var(--guide-primary);
+      color: #ffffff;
+      border-color: var(--guide-primary);
+    }
+
+    .strength-btn:focus-visible {
+      outline: 3px solid var(--guide-accent);
+      outline-offset: 1px;
+    }
+
+    .results-panel {
+      display: grid;
+      grid-template-columns: repeat(2, 1fr);
+      gap: 12px;
+    }
+
+    .metric-card {
+      background: #faf7f5;
+      border: 1px solid rgba(78, 52, 46, 0.12);
+      border-radius: 8px;
+      padding: 14px;
+      text-align: center;
+    }
+
+    .metric-label {
+      display: block;
+      font-size: 0.78rem;
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+      color: #6d4c41;
+      margin-bottom: 4px;
+    }
