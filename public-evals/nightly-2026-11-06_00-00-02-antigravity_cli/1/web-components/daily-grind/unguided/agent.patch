+      <p class="subtitle">Dial in the ideal coffee-to-water ratio for our freshly roasted beans at home.</p>
+    </div>
+
+    <div class="method-tabs" role="tablist" aria-label="Brewing methods">
+      <button type="button" class="method-btn" role="tab" aria-selected="true" tabindex="0" data-method="pour-over">Pour Over</button>
+      <button type="button" class="method-btn" role="tab" aria-selected="false" tabindex="-1" data-method="french-press">French Press</button>
+      <button type="button" class="method-btn" role="tab" aria-selected="false" tabindex="-1" data-method="espresso">Espresso</button>
+      <button type="button" class="method-btn" role="tab" aria-selected="false" tabindex="-1" data-method="cold-brew">Cold Brew</button>
+    </div>
+
+    <div class="calculator-grid" role="tabpanel" aria-labelledby="brew-guide-title">
+      <div class="controls-panel">
+        <div class="field-group">
+          <label for="servings-range">
+            <span>Servings (Cups)</span>
+            <output id="servings-output" for="servings-range">2 cups</output>
+          </label>
+          <input id="servings-range" type="range" min="1" max="8" step="1" value="2" />
+        </div>
+
+        <div class="field-group">
+          <label id="strength-label">Brew Strength</label>
+          <div class="strength-group" role="radiogroup" aria-labelledby="strength-label">
+            <button type="button" class="strength-btn" role="radio" aria-checked="false" data-adj="1">Mellow</button>
+            <button type="button" class="strength-btn" role="radio" aria-checked="true" data-adj="0">Balanced</button>
+            <button type="button" class="strength-btn" role="radio" aria-checked="false" data-adj="-1">Bold</button>
+          </div>
+        </div>
+      </div>
+
+      <div class="results-panel" aria-live="polite" aria-atomic="true">
+        <div class="metric-card">
+          <span class="metric-label">Coffee Grounds</span>
+          <span class="metric-value coffee-grams">28g</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Water Volume</span>
+          <span class="metric-value water-ml">450ml</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Grind &amp; Temp</span>
+          <span class="metric-value grind-temp" style="font-size: 0.95rem;">Medium-Fine · 200°F</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Brew Time</span>
+          <span class="metric-value brew-time" style="font-size: 0.95rem;">3:00 – 3:30 mins</span>
+        </div>
