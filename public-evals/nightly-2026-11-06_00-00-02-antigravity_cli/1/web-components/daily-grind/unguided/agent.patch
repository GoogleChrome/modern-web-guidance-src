+`;
+
+export class DgHero extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subheading', 'cta-text', 'cta-href', 'background-image'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._headingSlot = this.shadowRoot.querySelector('slot[name="heading"]');
+    this._subSlot = this.shadowRoot.querySelector('slot[name="subheading"]');
+    this._ctaLink = this.shadowRoot.querySelector('.cta-link');
+    this._exploreBtn = this.shadowRoot.querySelector('.explore-btn');
+  }
+
+  connectedCallback() {
+    this._sync();
+    this._exploreBtn.addEventListener('click', () => {
+      const menuSection = document.querySelector('coffee-menu-section, main');
+      if (menuSection) {
+        menuSection.scrollIntoView({ behavior: 'smooth' });
+      }
+    });
+  }
+
+  attributeChangedCallback() {
+    this._sync();
+  }
+
+  _sync() {
+    if (this.hasAttribute('heading') && this._headingSlot.assignedNodes().length === 0) {
+      this._headingSlot.textContent = this.getAttribute('heading');
+    }
+    if (this.hasAttribute('subheading') && this._subSlot.assignedNodes().length === 0) {
+      this._subSlot.textContent = this.getAttribute('subheading');
+    }
+    if (this.hasAttribute('cta-text')) {
+      this._ctaLink.textContent = this.getAttribute('cta-text');
+    }
+    if (this.hasAttribute('cta-href')) {
+      this._ctaLink.setAttribute('href', this.getAttribute('cta-href'));
+    }
+    if (this.hasAttribute('background-image')) {
+      this.style.setProperty('--hero-bg', `url('${this.getAttribute('background-image')}')`);
+    }
+  }
+}
+
+if (!customElements.get('dg-hero')) {
+  customElements.define('dg-hero', DgHero);
