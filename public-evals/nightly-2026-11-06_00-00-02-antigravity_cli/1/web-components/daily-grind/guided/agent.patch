+  #setupListeners() {
+    const tabs = Array.from(this.shadowRoot.querySelectorAll('.method-tab'));
+    const cupsSlider = this.shadowRoot.getElementById('cups-slider');
+    const strengthSelect = this.shadowRoot.getElementById('strength-select');
+
+    const activateTab = (tab, focus = false) => {
+      tabs.forEach((t) => {
+        const isTarget = t === tab;
+        t.setAttribute('aria-selected', String(isTarget));
+        t.tabIndex = isTarget ? 0 : -1;
+      });
+      if (focus) tab.focus();
