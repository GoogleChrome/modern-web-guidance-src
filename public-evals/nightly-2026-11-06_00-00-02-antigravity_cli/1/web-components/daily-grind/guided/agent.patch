+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article part="card">
+    <div class="media-wrap" part="media">
+      <img id="card-img" alt="" loading="lazy" decoding="async" />
+      <div class="badges">
+        <span id="category-badge" class="badge" part="badge" hidden></span>
+        <span id="roast-badge" class="badge roast" part="roast-badge" hidden></span>
+      </div>
+      <button type="button" id="fav-btn" class="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+        <svg class="fav-icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+        </svg>
+      </button>
+    </div>
+    <div class="body" part="body">
+      <div class="header-row">
+        <h3 id="card-title" part="title"></h3>
+        <span id="card-price" class="price" part="price"></span>
+      </div>
+      <div class="description" id="card-desc">
+        <slot></slot>
+      </div>
+      <fieldset class="size-fieldset" aria-label="Select cup size">
+        <legend>Cup Size</legend>
+        <div class="size-options" role="group">
+          <button type="button" class="size-btn" data-size="12oz" data-offset="0" aria-pressed="true">12oz</button>
+          <button type="button" class="size-btn" data-size="16oz" data-offset="0.75" aria-pressed="false">16oz (+$0.75)</button>
+          <button type="button" class="size-btn" data-size="20oz" data-offset="1.25" aria-pressed="false">20oz (+$1.25)</button>
+        </div>
+      </fieldset>
+      <button type="button" id="details-toggle" class="details-toggle" aria-expanded="false" aria-controls="details-panel">
+        Tasting Notes &amp; Origin
+      </button>
+      <div id="details-panel" class="details-panel" role="region" aria-labelledby="details-toggle" hidden>
+        <ul class="details-list">
+          <li><strong>Tasting Notes:</strong> <span id="notes-val">Rich &amp; balanced</span></li>
+          <li><strong>Origin:</strong> <span id="origin-val">House Blend</span></li>
+          <li><strong>Calories (12oz):</strong> <span id="cal-val">15 kcal</span></li>
+        </ul>
+        <slot name="details"></slot>
+      </div>
+      <div class="actions" part="actions">
+        <button type="button" id="add-btn" class="action-btn" part="button">Add to Order</button>
+        <a id="details-link" class="details-link" part="link" href="/menu">View Details</a>
+      </div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'description',
+    'price',
+    'category',
+    'roast',
+    'origin',
+    'tasting-notes',
+    'calories',
+    'image',
+    'href',
+    'favorited',
+  ];
+
+  #internals;
+  #selectedSize = '12oz';
+  #sizeOffset = 0;
+  #inCartCount = 0;
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+    this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#setupListeners();
+      this.#initialized = true;
+    }
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'favorited') {
+      const isFav = this.hasAttribute('favorited');
+      this.#setCustomState('favorited', isFav);
+    }
+    if (this.isConnected) {
+      this.#render();
+    }
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(val) {
+    val ? this.setAttribute('name', val) : this.removeAttribute('name');
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? '';
+  }
+  set description(val) {
+    val ? this.setAttribute('description', val) : this.removeAttribute('description');
+  }
+
+  get price() {
+    return Number(this.getAttribute('price')) || 4.5;
+  }
+  set price(val) {
+    this.setAttribute('price', String(val));
+  }
+
+  get category() {
+    return this.getAttribute('category') ?? '';
+  }
+  set category(val) {
+    val ? this.setAttribute('category', val) : this.removeAttribute('category');
+  }
+
+  get roast() {
+    return this.getAttribute('roast') ?? '';
+  }
+  set roast(val) {
+    val ? this.setAttribute('roast', val) : this.removeAttribute('roast');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '/menu';
+  }
+  set href(val) {
+    val ? this.setAttribute('href', val) : this.removeAttribute('href');
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(val) {
+    this.toggleAttribute('favorited', Boolean(val));
+  }
+
+  get selectedSize() {
+    return this.#selectedSize;
+  }
+
+  get effectivePrice() {
+    return +(this.price + this.#sizeOffset).toFixed(2);
+  }
+
+  #setCustomState(stateName, active) {
+    if (!this.#internals?.states) return;
+    if (active) {
+      this.#internals.states.add(stateName);
+    } else {
+      this.#internals.states.delete(stateName);
+    }
+  }
+
+  #setupListeners() {
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    const detailsToggle = this.shadowRoot.getElementById('details-toggle');
+    const detailsPanel = this.shadowRoot.getElementById('details-panel');
+    const addBtn = this.shadowRoot.getElementById('add-btn');
+    const sizeBtns = this.shadowRoot.querySelectorAll('.size-btn');
+    const slot = this.shadowRoot.querySelector('slot:not([name])');
+
+    favBtn.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(
+        new CustomEvent('coffee-favorite', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.name,
+            favorited: this.favorited,
+          },
+        })
+      );
+    });
+
+    detailsToggle.addEventListener('click', () => {
+      const expanded = detailsToggle.getAttribute('aria-expanded') === 'true';
+      const nextState = !expanded;
+      detailsToggle.setAttribute('aria-expanded', String(nextState));
+      detailsPanel.hidden = !nextState;
+      this.#setCustomState('expanded', nextState);
+    });
+
+    sizeBtns.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        sizeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        this.#selectedSize = btn.dataset.size || '12oz';
+        this.#sizeOffset = Number(btn.dataset.offset) || 0;
+        this.#updatePriceDisplay();
+      });
+    });
+
+    addBtn.addEventListener('click', () => {
+      this.#inCartCount += 1;
+      this.#setCustomState('in-cart', true);
+      addBtn.textContent = `Added (${this.#inCartCount} in Bag)`;
+      this.dispatchEvent(
+        new CustomEvent('coffee-order', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.name,
+            size: this.#selectedSize,
+            price: this.effectivePrice,
+            category: this.category,
+            image: this.getAttribute('image') || '',
+          },
+        })
+      );
+    });
+
+    slot.addEventListener('slotchange', () => {
+      this.#syncDescriptionFallback();
+    });
+  }
+
+  #syncDescriptionFallback() {
+    const slot = this.shadowRoot.querySelector('slot:not([name])');
+    const assigned = slot.assignedNodes({ flatten: true }).filter((n) => n.textContent.trim().length > 0);
+    if (assigned.length === 0 && this.description) {
+      slot.textContent = this.description;
+    }
+  }
+
+  #updatePriceDisplay() {
+    const priceEl = this.shadowRoot.getElementById('card-price');
+    priceEl.textContent = `$${this.effectivePrice.toFixed(2)}`;
+  }
+
+  #render() {
+    const titleEl = this.shadowRoot.getElementById('card-title');
+    const imgEl = this.shadowRoot.getElementById('card-img');
+    const catBadge = this.shadowRoot.getElementById('category-badge');
+    const roastBadge = this.shadowRoot.getElementById('roast-badge');
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    const notesVal = this.shadowRoot.getElementById('notes-val');
+    const originVal = this.shadowRoot.getElementById('origin-val');
+    const calVal = this.shadowRoot.getElementById('cal-val');
+    const linkEl = this.shadowRoot.getElementById('details-link');
+
+    const name = this.name || 'Artisanal Coffee';
+    titleEl.textContent = name;
+
+    const image =
+      this.getAttribute('image') ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80';
+    imgEl.src = image;
+    imgEl.alt = `${name} served fresh`;
+
+    if (this.category) {
+      catBadge.textContent = this.category;
+      catBadge.hidden = false;
+    } else {
+      catBadge.hidden = true;
+    }
+
+    if (this.roast) {
+      roastBadge.textContent = `${this.roast} Roast`;
+      roastBadge.hidden = false;
+    } else {
+      roastBadge.hidden = true;
+    }
+
+    const isFav = this.favorited;
+    favBtn.setAttribute('aria-pressed', String(isFav));
+    favBtn.setAttribute(
+      'aria-label',
+      isFav ? `Remove ${name} from favorites` : `Save ${name} to favorites`
+    );
+    this.#setCustomState('favorited', isFav);
+
+    notesVal.textContent = this.getAttribute('tasting-notes') || 'Caramel, toasted hazelnut, smooth cocoa';
+    originVal.textContent = this.getAttribute('origin') || 'Small-lot Latin America & East Africa';
+    calVal.textContent = `${this.getAttribute('calories') || '15'} kcal`;
+
+    linkEl.href = this.href;
+    linkEl.setAttribute('aria-label', `View details for ${name}`);
+
+    this.#syncDescriptionFallback();
+    this.#updatePriceDisplay();
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
