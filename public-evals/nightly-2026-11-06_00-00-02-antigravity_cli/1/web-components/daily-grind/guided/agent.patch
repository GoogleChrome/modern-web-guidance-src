+      outline-offset: 2px;
+    }
+
+    .sub-btn {
+      font: inherit;
+      font-weight: 700;
+      padding: 11px 20px;
+      border-radius: 8px;
+      border: none;
+      background: var(--primary, #4e342e);
+      color: #ffffff;
+      cursor: pointer;
+      transition: background 0.2s ease;
+    }
+
+    .sub-btn:hover {
+      background: #3e2723;
+    }
+
+    .sub-feedback {
+      margin-top: 18px;
+      padding: 12px 16px;
+      border-radius: 8px;
+      background: #ffffff;
+      border-left: 4px solid var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.92rem;
+    }
+  }
+`);
+
+const roastSubscriptionTemplate = document.createElement('template');
+roastSubscriptionTemplate.innerHTML = `
+  <section class="sub-card" aria-labelledby="sub-heading">
+    <div class="sub-header">
+      <h2 id="sub-heading" part="heading">Roaster's Bean Club &amp; Rewards Estimator</h2>
+      <p>Customize your freshly roasted whole-bean or ground delivery and earn bonus loyalty stars on every bag.</p>
+    </div>
+
+    <form id="sub-form" class="sub-form" novalidate>
+      <div class="field">
+        <label for="roast-level">Roast Profile</label>
+        <select id="roast-level" name="roast">
+          <option value="Light Single-Origin (Bright & Floral)">Light Single-Origin (Bright &amp; Floral)</option>
+          <option value="Medium House Blend (Caramel & Nutty)" selected>Medium House Blend (Caramel &amp; Nutty)</option>
+          <option value="Dark Espresso Roast (Bold & Smoky)">Dark Espresso Roast (Bold &amp; Smoky)</option>
+        </select>
+      </div>
+
+      <div class="field">
+        <label for="grind-type">Grind Preparation</label>
+        <select id="grind-type" name="grind">
+          <option value="Whole Bean" selected>Whole Bean (Maximum Freshness)</option>
+          <option value="Drip / Pour Over Grind">Drip / Pour Over Grind</option>
+          <option value="Espresso Fine Grind">Espresso Fine Grind</option>
+          <option value="French Press Coarse">French Press Coarse</option>
+        </select>
+      </div>
+
+      <div class="field">
+        <label for="cadence">Delivery Cadence</label>
+        <select id="cadence" name="cadence">
+          <option value="weekly" data-price="16.50" data-stars="120">Every Week ($16.50 / bag • Save 15%)</option>
+          <option value="biweekly" data-price="17.50" data-stars="90" selected>Every 2 Weeks ($17.50 / bag • Save 10%)</option>
+          <option value="monthly" data-price="18.50" data-stars="60">Monthly ($18.50 / bag • Save 5%)</option>
+        </select>
+      </div>
+
+      <button type="submit" class="sub-btn" part="button">Preview Subscription Plan</button>
+    </form>
+
+    <div id="sub-feedback" class="sub-feedback" role="status" aria-live="polite">
+      Selected Plan: <strong>Medium House Blend (Caramel &amp; Nutty)</strong> • Whole Bean • <strong>$17.50</strong> every 2 weeks (+90 Bonus Rewards Stars/month).
+    </div>
+  </section>
+`;
+
+export class RoastSubscription extends HTMLElement {
+  #internals;
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [roastSubscriptionSheet];
+    this.shadowRoot.append(roastSubscriptionTemplate.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#setupListeners();
+      this.#initialized = true;
+    }
+    this.#updateSummary(false);
+  }
+
+  #setupListeners() {
+    const form = this.shadowRoot.getElementById('sub-form');
+    const selects = form.querySelectorAll('select');
+
+    selects.forEach((sel) => {
+      sel.addEventListener('change', () => this.#updateSummary(false));
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      this.#updateSummary(true);
+    });
+  }
+
+  #updateSummary(confirmed = false) {
+    const roast = this.shadowRoot.getElementById('roast-level').value;
+    const grind = this.shadowRoot.getElementById('grind-type').value;
+    const cadenceSelect = this.shadowRoot.getElementById('cadence');
+    const selectedOpt = cadenceSelect.options[cadenceSelect.selectedIndex];
+    const price = selectedOpt.dataset.price || '17.50';
+    const stars = selectedOpt.dataset.stars || '90';
+    const feedback = this.shadowRoot.getElementById('sub-feedback');
+
+    if (confirmed) {
+      this.#internals?.states?.add('subscribed');
+      feedback.innerHTML = `Plan Saved to Account Preview: <strong>${roast}</strong> (${grind}) at <strong>$${price}/bag</strong> — You'll earn <strong>${stars} Rewards Stars</strong> per month plus free local roastery shipping!`;
+      this.dispatchEvent(
+        new CustomEvent('subscription-preview', {
+          bubbles: true,
+          composed: true,
+          detail: { roast, grind, cadence: cadenceSelect.value, price: Number(price), stars: Number(stars) },
+        })
+      );
+    } else {
+      feedback.innerHTML = `Selected Plan: <strong>${roast}</strong> • ${grind} • <strong>$${price}/bag</strong> (+${stars} Bonus Rewards Stars/month).`;
+    }
+  }
+}
+
+if (!customElements.get('roast-subscription')) {
+  customElements.define('roast-subscription', RoastSubscription);
+}
