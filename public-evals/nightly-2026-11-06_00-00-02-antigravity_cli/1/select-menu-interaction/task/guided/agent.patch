+  <script>
+    const orderForm = document.getElementById('order-form');
+    const orderStatus = document.getElementById('order-status');
+    const orderSubmitBtn = document.getElementById('order-submit-btn');
+
+    const updateAriaState = (event) => {
+      const control = event.target;
+      if (!control.matches?.('input, textarea, select')) return;
+
+      if (control.matches(':user-invalid')) {
+        control.setAttribute('aria-invalid', 'true');
+      } else if (control.matches(':user-valid') || control.checkValidity()) {
+        control.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Listen in the capture phase since blur, focus, and invalid do not bubble.
+    document.addEventListener('blur', updateAriaState, true);
+    document.addEventListener('focus', updateAriaState, true);
+    document.addEventListener('invalid', updateAriaState, true);
+    document.addEventListener('change', updateAriaState, true);
+
+    document.addEventListener('input', (event) => {
+      const control = event.target;
+      if (!control.matches?.('input, textarea, select')) return;
+
+      if (control.getAttribute('aria-invalid') === 'true' || control.checkValidity()) {
+        updateAriaState(event);
+      }
+    });
+
+    orderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      orderForm.querySelectorAll('input[required], select[required], textarea[required]').forEach((control) => {
+        if (control.matches(':user-invalid')) {
+          control.setAttribute('aria-invalid', 'true');
+        } else if (control.matches(':user-valid')) {
+          control.removeAttribute('aria-invalid');
+        }
+      });
+
+      if (orderForm.checkValidity()) {
+        const shopSelect = document.getElementById('local-shop');
+        const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+        orderSubmitBtn.disabled = true;
+        orderStatus.textContent = `Pickup location set to ${selectedOption.text}. Redirecting to menu...`;
+        orderStatus.classList.add('visible');
+      }
+    });
+  </script>
