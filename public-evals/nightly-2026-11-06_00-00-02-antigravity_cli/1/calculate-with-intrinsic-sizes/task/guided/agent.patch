+  <script>
+    const toggleBtn = document.getElementById('accordion-toggle');
+    const accordionContent = document.querySelector('.accordion-content');
+    const accordionIcon = toggleBtn?.querySelector('.accordion-icon');
+
+    toggleBtn?.addEventListener('click', () => {
+      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
+      const nextState = !isExpanded;
+      toggleBtn.setAttribute('aria-expanded', String(nextState));
+      accordionContent?.classList.toggle('open', nextState);
+      accordionContent?.classList.toggle('is-expanded', nextState);
+      if (accordionIcon) {
+        accordionIcon.textContent = nextState ? '−' : '+';
+      }
+    });
+  </script>
