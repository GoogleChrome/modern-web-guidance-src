+    /* Toast Notifications */
+    .toast {
+      position: fixed;
+      inset: auto;
+      right: 1.5rem;
+      bottom: 1.5rem;
+      bottom: calc(1.5rem + (sibling-index() - 1) * 4.5rem);
+      margin: 0;
+      padding: 0.85rem 1.25rem;
+      background: var(--primary);
+      color: white;
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      display: flex;
+      align-items: center;
+      gap: 1rem;
+      opacity: 0;
+      transform: translateY(1rem) scale(0.95);
+      transition-property: opacity, transform, bottom, margin-bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    .toast + .toast {
+      margin-bottom: 4.5rem;
+    }
+
+    @supports (bottom: calc(1px * sibling-index())) {
+      .toast + .toast {
+        margin-bottom: 0;
+      }
+    }
+
+    :is(.toast:is(:popover-open, .\:popover-open)):where(:not([data-closing])) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateY(1rem) scale(0.95);
+      }
+    }
+
+    .toast-close {
+      background: transparent;
+      border: 1px solid rgba(255, 255, 255, 0.4);
