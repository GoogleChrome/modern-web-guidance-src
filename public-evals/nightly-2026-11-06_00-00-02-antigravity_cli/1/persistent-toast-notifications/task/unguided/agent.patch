+    /* Top-Layer Toast Notification System */
+    .toast {
+      --toast-index: 0;
+      --toast-height: 52px;
+      --toast-gap: 12px;
+
+      /* Override default popover centering and place in bottom-right */
+      position: fixed;
+      inset: auto 24px 24px auto;
+      margin: 0;
+
+      /* Guarantee minimum height matches stacking calculation */
+      min-height: var(--toast-height);
+      padding: 12px 16px;
+      border: 1px solid rgba(255, 171, 64, 0.35);
+      border-radius: 8px;
+      background: var(--primary);
+      color: var(--light);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 14px;
+      font-size: 0.95rem;
+      font-weight: 500;
+      pointer-events: auto;
+
+      /* Pure CSS dynamic vertical stacking offset based on open toast siblings */
+      transform: translateY(calc(var(--toast-index) * -1 * (var(--toast-height) + var(--toast-gap)))) scale(0.95);
+      opacity: 0;
+
+      transition:
+        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        opacity 0.3s ease,
+        overlay 0.3s allow-discrete,
+        display 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      opacity: 1;
+      transform: translateY(calc(var(--toast-index) * -1 * (var(--toast-height) + var(--toast-gap)))) scale(1);
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateY(calc(var(--toast-index) * -1 * (var(--toast-height) + var(--toast-gap)) + 20px)) scale(0.95);
+      }
+    }
+
+    /* Exit animation state before popover hides or when closing */
+    .toast.closing {
+      opacity: 0;
+      transform: translateY(calc(var(--toast-index) * -1 * (var(--toast-height) + var(--toast-gap)) + 16px)) scale(0.95);
+      pointer-events: none;
+    }
+
+    /* Pure CSS sibling-based stacking offset (newest toast at bottom, older ones pushed up) */
+    .toast:popover-open:has(~ .toast:popover-open) {
+      --toast-index: 1;
+    }
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open) {
+      --toast-index: 2;
+    }
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open) {
