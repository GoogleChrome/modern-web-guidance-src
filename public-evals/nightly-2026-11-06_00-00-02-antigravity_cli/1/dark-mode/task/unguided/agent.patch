+  <script>
+    (function () {
+      const root = document.documentElement;
+      const themeSelect = document.getElementById('theme-select');
+      const lateNightSelect = document.getElementById('late-night-select');
+      const specialItems = document.querySelectorAll('#late-night-scroll .special-item');
+
+      function applyTheme(mode) {
+        const normalized = (mode || 'system').toLowerCase();
+        if (normalized === 'light') {
+          root.setAttribute('data-theme', 'light');
+          root.classList.remove('dark');
+          root.classList.add('light');
+          root.style.colorScheme = 'light';
+        } else if (normalized === 'dark') {
+          root.setAttribute('data-theme', 'dark');
+          root.classList.remove('light');
+          root.classList.add('dark');
+          root.style.colorScheme = 'dark';
+        } else {
+          root.setAttribute('data-theme', 'system');
+          root.classList.remove('light', 'dark');
+          root.style.colorScheme = 'light dark';
+        }
+      }
+
+      if (themeSelect) {
+        applyTheme(themeSelect.value);
+        themeSelect.addEventListener('change', function (e) {
+          applyTheme(e.target.value);
+        });
+      }
+
+      if (lateNightSelect) {
+        lateNightSelect.addEventListener('change', function (e) {
+          const category = e.target.value;
+          specialItems.forEach(function (item) {
+            if (category === 'all' || item.getAttribute('data-category') === category) {
+              item.style.opacity = '1';
+              item.style.borderLeftColor = 'var(--accent)';
+            } else {
+              item.style.opacity = '0.45';
+              item.style.borderLeftColor = 'var(--border)';
+            }
+          });
+        });
+      }
+    })();
+  </script>
+
