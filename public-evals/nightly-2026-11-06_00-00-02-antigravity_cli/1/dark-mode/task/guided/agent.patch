+      const themeSelect = document.getElementById('theme-select');
+      const systemOption = document.getElementById('theme-option-system');
+      const darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateSystemOptionLabel() {
+        if (!systemOption) return;
+        const currentSystem = darkMediaQuery.matches ? 'dark' : 'light';
+        systemOption.textContent = `System Default (Currently ${currentSystem})`;
+      }
+
+      function applyTheme(value, persist = true) {
+        const normalized = value === 'light' || value === 'dark' ? value : 'system';
+        if (normalized === 'system') {
+          if (metaColorScheme) metaColorScheme.content = 'light dark';
+          root.style.colorScheme = 'light dark';
+          delete root.dataset.theme;
+          if (persist) {
+            try {
+              localStorage.removeItem('color-scheme');
+            } catch (e) {}
+          }
+        } else {
+          if (metaColorScheme) metaColorScheme.content = normalized;
+          root.style.colorScheme = normalized;
+          root.dataset.theme = normalized;
+          if (persist) {
+            try {
+              localStorage.setItem('color-scheme', normalized);
+            } catch (e) {}
+          }
+        }
+        if (themeSelect && themeSelect.value !== normalized) {
+          themeSelect.value = normalized;
+        }
+      }
+
+      // Initialize from saved preference or meta tag
+      let initialTheme = 'system';
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          initialTheme = stored;
+        }
+      } catch (e) {}
+
+      updateSystemOptionLabel();
+      applyTheme(initialTheme, false);
+
+      if (themeSelect) {
+        themeSelect.addEventListener('change', (e) => {
+          applyTheme(e.target.value, true);
+        });
+      }
+
+      darkMediaQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          const newScheme = e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'system';
+          applyTheme(newScheme, false);
+        }
+      });
+
+      // Late Night Specials category filter
+      const specialsFilter = document.getElementById('specials-filter');
+      const specialItems = document.querySelectorAll('#specials-scroll-area .special-item');
+      if (specialsFilter) {
+        specialsFilter.addEventListener('change', (e) => {
+          const category = e.target.value;
+          specialItems.forEach((item) => {
+            item.hidden = category !== 'all' && item.dataset.category !== category;
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
