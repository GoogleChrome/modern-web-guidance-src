+  <script>
+    (() => {
+      const BARISTA_SYSTEM_PROMPT =
+        'You are the friendly expert barista at The Daily Grind coffee shop. ' +
+        'Answer customer questions specifically about our two signature drinks: ' +
+        '1) Maple Oat Latte: Espresso combined with steamed creamy oat milk and real Vermont maple syrup (dairy-free, vegan, warm spiced sweetness, 180 kcal). ' +
+        '2) Cold Brew: Single-origin Colombian beans coarse-ground and steeped in cool filtered water for 18 hours for ultra-smooth, low-acidity chocolatey flavor (5 kcal unsweetened, high caffeine). ' +
+        'Keep responses helpful, concise, and focused on these beverages.';
+
+      const askBtn = document.getElementById('ask-the-barista');
+      const stopBtn = document.getElementById('stop-barista-btn');
+      const questionInput = document.getElementById('barista-question');
+      const baristaProgress = document.getElementById('barista-progress');
+      const baristaAnswer = document.getElementById('barista-answer');
+
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentStatus = document.getElementById('sentiment-status');
+      const sentimentOutput = document.getElementById('sentiment-output');
+
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+      const contextUsageDisplay = document.getElementById('context-usage-display');
+      const branchStatus = document.getElementById('branch-status');
+      const branchList = document.getElementById('branch-list');
+
+      // Base session holds only initialPrompts so clones inherit baseline instructions cleanly.
+      let baseSession = null;
+      let activeSession = null;
+      let currentAbortController = null;
+      const clonedSessions = new Map();
+      let branchCounter = 0;
+      const responseCache = new Map();
+
+      function updateContextUsageUI(session = activeSession || baseSession) {
+        if (session && typeof session.contextUsage === 'number' && typeof session.contextWindow === 'number') {
+          const used = session.contextUsage;
+          const total = session.contextWindow;
+          const pct = total > 0 ? Math.round((used / total) * 100) : 0;
+          contextUsageDisplay.textContent = `Context Usage: ${used} / ${total} tokens (${pct}%)`;
+        } else {
+          contextUsageDisplay.textContent = 'Context Usage: 0 / 0 tokens';
+        }
+      }
+
+      async function checkModelAvailability() {
+        if (!('LanguageModel' in self)) {
+          return 'unavailable';
+        }
+        try {
+          return await LanguageModel.availability();
+        } catch {
+          return 'unavailable';
+        }
+      }
+
+      async function ensureBaseSession(statusEl) {
+        if (baseSession) {
+          return baseSession;
+        }
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          return null;
+        }
+        baseSession = await LanguageModel.create({
+          initialPrompts: [{ role: 'system', content: BARISTA_SYSTEM_PROMPT }],
+          expectedInputs: [{ type: 'text' }],
+          expectedOutputs: [{ type: 'text' }],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded || 0) * 100);
+              if (statusEl) {
+                statusEl.textContent = `Downloading on-device AI model: ${pct}%`;
+              }
+            });
+          },
+        });
+        updateContextUsageUI(baseSession);
+        return baseSession;
+      }
+
+      async function getOrCreateActiveSession(statusEl) {
+        if (activeSession) {
+          return activeSession;
+        }
+        const base = await ensureBaseSession(statusEl);
+        if (!base) {
+          return null;
+        }
+        activeSession = await base.clone();
+        updateContextUsageUI(activeSession);
+        return activeSession;
+      }
+
+      // Pre-warm the base session when the user focuses or hovers over the AI sections
+      let prewarmStarted = false;
+      async function prewarmSession() {
+        if (prewarmStarted) return;
+        prewarmStarted = true;
+        try {
+          await ensureBaseSession(baristaProgress);
+        } catch {
+          // Graceful fallback handled on interaction
+        }
+      }
+      ['mouseenter', 'focusin'].forEach((evt) => {
+        document.getElementById('barista-section').addEventListener(evt, prewarmSession, { once: true });
+        document.getElementById('feedback-section').addEventListener(evt, prewarmSession, { once: true });
+      });
+
+      function generateFallbackBaristaAnswer(question) {
+        const q = question.toLowerCase();
+        if (q.includes('cold brew')) {
+          return 'Our Cold Brew is crafted from single-origin Colombian beans steeped in cool filtered water for 18 hours, producing an ultra-smooth, low-acidity cup with subtle dark chocolate notes.';
+        }
+        if (q.includes('maple') || q.includes('oat') || q.includes('latte')) {
+          return 'Our Maple Oat Latte pairs rich espresso with velvety steamed oat milk and pure Vermont maple syrup. It is 100% plant-based and dairy-free!';
+        }
+        return 'We recommend trying our Maple Oat Latte (creamy oat milk with pure Vermont maple syrup) or our 18-hour steeped Cold Brew for maximum smoothness!';
+      }
+
+      // 1. Ask the Barista (Streaming + Availability Check + Progress Monitoring)
+      askBtn.addEventListener('click', async () => {
+        const question = (questionInput.value || '').trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+        const cacheKey = question.toLowerCase();
+
+        baristaAnswer.textContent = '';
+        baristaProgress.textContent = 'Checking on-device model availability...';
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          baristaProgress.textContent = 'Built-in LanguageModel unavailable; using local barista fallback.';
+          baristaAnswer.textContent = generateFallbackBaristaAnswer(question);
+          return;
+        }
+
+        if (responseCache.has(cacheKey)) {
+          baristaProgress.textContent = 'Loaded from local session cache.';
+          baristaAnswer.textContent = responseCache.get(cacheKey);
+          return;
+        }
+
+        if (currentAbortController) {
+          currentAbortController.abort();
+        }
+        currentAbortController = new AbortController();
+        askBtn.disabled = true;
+        stopBtn.hidden = false;
+
+        try {
+          const session = await getOrCreateActiveSession(baristaProgress);
+          if (!session) {
+            baristaProgress.textContent = 'Model unavailable; showing fallback response.';
+            baristaAnswer.textContent = generateFallbackBaristaAnswer(question);
+            return;
+          }
+
+          baristaProgress.textContent = 'Streaming barista answer...';
+          const stream = session.promptStreaming(
+            `Customer question about Maple Oat Latte or Cold Brew: ${question}`,
+            { signal: currentAbortController.signal }
+          );
+
+          let completeResult = '';
+          for await (const chunk of stream) {
+            completeResult += chunk;
+            baristaAnswer.append(chunk);
+          }
+
+          responseCache.set(cacheKey, completeResult);
+          baristaProgress.textContent = 'Response complete.';
+          updateContextUsageUI(session);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            baristaProgress.textContent = 'Generation stopped by user.';
+          } else {
+            baristaProgress.textContent = 'Error streaming from model; showing fallback answer.';
+            baristaAnswer.textContent = generateFallbackBaristaAnswer(question);
+          }
+        } finally {
+          askBtn.disabled = false;
+          stopBtn.hidden = true;
+          currentAbortController = null;
+        }
+      });
+
+      stopBtn.addEventListener('click', () => {
+        if (currentAbortController) {
+          currentAbortController.abort();
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output with score & category)
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['Maple Oat Latte', 'Cold Brew', 'Service', 'Atmosphere', 'General'],
+          },
+        },
+        required: ['score', 'category'],
+        additionalProperties: false,
+      };
+
+      function analyzeFeedbackFallback(text) {
+        const lower = text.toLowerCase();
+        const positiveWords = ['great', 'love', 'smooth', 'delicious', 'perfect', 'best', 'amazing', 'good'];
+        const negativeWords = ['bad', 'bitter', 'cold', 'slow', 'terrible', 'worst', 'sour'];
+        let score = 3;
+        if (positiveWords.some((w) => lower.includes(w))) score = 5;
+        if (negativeWords.some((w) => lower.includes(w))) score = 2;
+
+        let category = 'General';
+        if (lower.includes('maple') || lower.includes('oat') || lower.includes('latte')) {
+          category = 'Maple Oat Latte';
+        } else if (lower.includes('cold brew')) {
+          category = 'Cold Brew';
+        }
+        return { score, category };
+      }
+
+      sentimentBtn.addEventListener('click', async () => {
+        const feedbackText = (feedbackInput.value || '').trim() || 'The Maple Oat Latte and Cold Brew were both smooth and delicious!';
+        sentimentStatus.textContent = 'Checking model availability...';
+        sentimentBtn.disabled = true;
+
+        let tempSession = null;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            const fallbackResult = analyzeFeedbackFallback(feedbackText);
+            sentimentStatus.textContent = 'Built-in AI unavailable; computed structured fallback.';
+            sentimentOutput.textContent = JSON.stringify(fallbackResult, null, 2);
+            return;
+          }
+
+          const base = await ensureBaseSession(sentimentStatus);
+          if (!base) {
+            const fallbackResult = analyzeFeedbackFallback(feedbackText);
+            sentimentOutput.textContent = JSON.stringify(fallbackResult, null, 2);
+            return;
+          }
+
+          // Clone from the clean base session for an isolated task and destroy immediately when finished
+          tempSession = await base.clone();
+          sentimentStatus.textContent = 'Analyzing feedback with JSON Schema constraint...';
+
+          const rawJson = await tempSession.prompt(
+            `Analyze the following customer coffee shop feedback and return a JSON object with a numeric "score" (1 to 5) and a "category": "${feedbackText}"`,
+            { responseConstraint: feedbackSchema }
+          );
+
+          const parsed = JSON.parse(rawJson);
+          sentimentOutput.textContent = JSON.stringify(
+            { score: parsed.score, category: parsed.category },
+            null,
+            2
+          );
+          sentimentStatus.textContent = 'Structured JSON analysis complete.';
+        } catch {
+          const fallbackResult = analyzeFeedbackFallback(feedbackText);
+          sentimentStatus.textContent = 'Fallback structured JSON returned.';
+          sentimentOutput.textContent = JSON.stringify(fallbackResult, null, 2);
+        } finally {
+          if (tempSession && typeof tempSession.destroy === 'function') {
+            tempSession.destroy();
+          }
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // 3. Conversation Branching (Clone active sessions, track context usage, clean up unneeded sessions)
+      function renderBranches() {
+        branchList.textContent = '';
+        for (const [id, entry] of clonedSessions.entries()) {
+          const card = document.createElement('div');
+          card.className = 'branch-card';
+
+          const info = document.createElement('div');
+          const used = entry.session && typeof entry.session.contextUsage === 'number' ? entry.session.contextUsage : 0;
+          const windowSize = entry.session && typeof entry.session.contextWindow === 'number' ? entry.session.contextWindow : 0;
+          info.textContent = `Branch #${id} (${entry.label}) — Context: ${used} / ${windowSize} tokens`;
+
+          const actions = document.createElement('div');
+          actions.style.display = 'flex';
+          actions.style.gap = '8px';
+
+          const switchBtn = document.createElement('button');
+          switchBtn.type = 'button';
+          switchBtn.className = 'btn';
+          switchBtn.style.marginTop = '0';
+          switchBtn.style.padding = '6px 12px';
+          switchBtn.textContent = activeSession === entry.session ? 'Active' : 'Use Branch';
+          switchBtn.disabled = activeSession === entry.session;
+          switchBtn.addEventListener('click', () => {
+            activeSession = entry.session;
+            updateContextUsageUI(activeSession);
+            branchStatus.textContent = `Switched active conversation to Branch #${id}.`;
+            renderBranches();
+          });
+
+          const destroyBtn = document.createElement('button');
+          destroyBtn.type = 'button';
+          destroyBtn.className = 'btn';
+          destroyBtn.style.marginTop = '0';
+          destroyBtn.style.padding = '6px 12px';
+          destroyBtn.style.background = '#8d6e63';
+          destroyBtn.textContent = 'Destroy';
+          destroyBtn.addEventListener('click', () => {
+            if (entry.session && typeof entry.session.destroy === 'function') {
+              entry.session.destroy();
+            }
+            if (activeSession === entry.session) {
+              activeSession = null;
+            }
+            clonedSessions.delete(id);
+            updateContextUsageUI(activeSession || baseSession);
+            branchStatus.textContent = `Destroyed Branch #${id} and freed session memory.`;
+            renderBranches();
+          });
+
+          actions.append(switchBtn, destroyBtn);
+          card.append(info, actions);
+          branchList.append(card);
+        }
+      }
+
+      function cleanupUnneededSessions(maxClones = 3) {
+        let destroyedCount = 0;
+        for (const [id, entry] of clonedSessions.entries()) {
+          const isOverflowing =
+            entry.session &&
+            typeof entry.session.contextUsage === 'number' &&
+            typeof entry.session.contextWindow === 'number' &&
+            entry.session.contextWindow > 0 &&
+            entry.session.contextUsage / entry.session.contextWindow > 0.85;
+
+          const exceedsPool = clonedSessions.size > maxClones && entry.session !== activeSession;
+
+          if (isOverflowing || exceedsPool || entry.session !== activeSession) {
+            if (entry.session && typeof entry.session.destroy === 'function') {
+              entry.session.destroy();
+            }
+            clonedSessions.delete(id);
+            destroyedCount++;
+          }
+        }
+        updateContextUsageUI(activeSession || baseSession);
+        renderBranches();
+        return destroyedCount;
+      }
+
+      cloneBtn.addEventListener('click', async () => {
+        branchStatus.textContent = 'Checking model availability to clone session...';
+        cloneBtn.disabled = true;
+
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            branchStatus.textContent = 'Built-in LanguageModel is unavailable on this device.';
+            return;
+          }
+
+          const sourceSession = await getOrCreateActiveSession(branchStatus);
+          if (!sourceSession) {
+            branchStatus.textContent = 'Unable to initialize session for cloning.';
+            return;
+          }
+
+          // Automatically clean up older inactive sessions if too many clones are active
+          if (clonedSessions.size >= 3) {
+            cleanupUnneededSessions(2);
+          }
+
+          const cloned = await sourceSession.clone();
+          branchCounter += 1;
+          const branchId = branchCounter;
+          clonedSessions.set(branchId, {
+            id: branchId,
+            label: 'Maple Oat Latte & Cold Brew Branch',
+            session: cloned,
+          });
+          activeSession = cloned;
+
+          updateContextUsageUI(activeSession);
+          branchStatus.textContent = `Cloned active session into Branch #${branchId}.`;
+          renderBranches();
+        } catch {
+          branchStatus.textContent = 'Could not clone session.';
+        } finally {
+          cloneBtn.disabled = false;
+        }
+      });
+
+      cleanupBtn.addEventListener('click', () => {
+        const count = cleanupUnneededSessions(0);
+        branchStatus.textContent = count > 0
+          ? `Cleaned up ${count} unneeded session(s) via session.destroy().`
+          : 'No inactive cloned sessions to clean up.';
+      });
+
+      // Ensure all sessions are destroyed when the page is unloaded to free device memory
+      window.addEventListener('pagehide', () => {
+        for (const [, entry] of clonedSessions.entries()) {
+          if (entry.session && typeof entry.session.destroy === 'function') {
+            entry.session.destroy();
+          }
+        }
+        clonedSessions.clear();
+        if (activeSession && typeof activeSession.destroy === 'function') {
+          activeSession.destroy();
+          activeSession = null;
+        }
+        if (baseSession && typeof baseSession.destroy === 'function') {
+          baseSession.destroy();
+          baseSession = null;
+        }
+      });
+    })();
+  </script>
