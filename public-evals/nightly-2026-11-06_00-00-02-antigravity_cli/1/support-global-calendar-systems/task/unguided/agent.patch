+  <script>
+    (function () {
+      const dateInput = document.getElementById('calendar-date-picker');
+      const cards = document.querySelectorAll('.calendar-card');
+
+      function getTodayPlainDate() {
+        if (typeof Temporal !== 'undefined' && Temporal.Now) {
+          return Temporal.Now.plainDateISO();
+        }
+        const now = new Date();
+        const yyyy = now.getFullYear();
+        const mm = String(now.getMonth() + 1).padStart(2, '0');
+        const dd = String(now.getDate()).padStart(2, '0');
+        return `${yyyy}-${mm}-${dd}`;
+      }
+
+      function getRelativeStatus(isoDate, todayPlain) {
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          const cmp = Temporal.PlainDate.compare(isoDate, todayPlain);
+          if (cmp < 0) return 'Past';
+          if (cmp > 0) return 'Future';
+          return 'Today';
+        }
+        const isoStr = String(isoDate);
+        const todayStr = String(todayPlain);
+        if (isoStr < todayStr) return 'Past';
+        if (isoStr > todayStr) return 'Future';
+        return 'Today';
+      }
+
+      function formatLocalizedDate(calDate, calendarId) {
+        return calDate.toLocaleString('en-US', {
+          calendar: calendarId,
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+          era: 'long'
+        });
+      }
+
+      function renderCalendars(isoDateString) {
+        if (!isoDateString) return;
+
+        const todayPlain = getTodayPlainDate();
+        let baseDate;
+        try {
+          baseDate = Temporal.PlainDate.from(isoDateString);
+        } catch (err) {
+          return;
+        }
+
+        const status = getRelativeStatus(baseDate, todayPlain);
+
+        cards.forEach((card) => {
+          const calendarId = card.getAttribute('data-calendar');
+          const calDate = baseDate.withCalendar(calendarId);
+
+          const statusEl = card.querySelector('[data-field="relative-status"]');
+          statusEl.textContent = status;
+          statusEl.className = 'status-badge status-' + status.toLowerCase();
+
+          const localizedEl = card.querySelector('[data-field="localized-date"]');
+          localizedEl.textContent = formatLocalizedDate(calDate, calendarId);
+
+          const yearEl = card.querySelector('[data-field="year"]');
+          yearEl.textContent = String(calDate.year);
+
+          const monthEl = card.querySelector('[data-field="month"]');
+          monthEl.textContent = String(calDate.month);
+
+          const monthCodeEl = card.querySelector('[data-field="month-code"]');
+          monthCodeEl.textContent = calDate.monthCode;
+
+          const monthsInYearEl = card.querySelector('[data-field="months-in-year"]');
+          monthsInYearEl.textContent = String(calDate.monthsInYear);
+
+          const breakdownList = card.querySelector('[data-field="months-breakdown"]');
+          breakdownList.innerHTML = '';
+
+          for (let m = 1; m <= calDate.monthsInYear; m++) {
+            const monthDate = calDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-chip' + (m === calDate.month ? ' active-month' : '');
+            li.innerHTML = `<span class="month-code">${monthDate.monthCode}</span> <span class="month-days">${monthDate.daysInMonth} days</span>`;
+            breakdownList.appendChild(li);
+          }
+        });
+      }
+
+      const todayIso = getTodayPlainDate().toString();
+      dateInput.value = todayIso;
+      renderCalendars(todayIso);
+
+      dateInput.addEventListener('input', (e) => {
+        renderCalendars(e.target.value);
+      });
+      dateInput.addEventListener('change', (e) => {
+        renderCalendars(e.target.value);
+      });
+    })();
+  </script>
