+  <script type="module">
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function resolveIslamicCalendarId() {
+      const candidates = ['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic'];
+      for (const candidate of candidates) {
+        if (isCalendarSupported(candidate)) {
+          return candidate;
+        }
+      }
+      return 'islamic-umalqura';
+    }
+
+    function renderCalendarCard(container, config, selectedIsoDate, todayIsoDate) {
+      if (!container) return;
+
+      const { calendarId, title, locale, includeEra } = config;
+      const supported = isCalendarSupported(calendarId);
+      const targetDate = supported
+        ? selectedIsoDate.withCalendar(calendarId)
+        : selectedIsoDate;
+      const todayInCalendar = supported
+        ? todayIsoDate.withCalendar(calendarId)
+        : todayIsoDate;
+
+      const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+      const relativeStatus = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      const formatOptions = {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric',
+        ...(includeEra ? { era: 'long' } : {})
+      };
+      const localizedDate = targetDate.toLocaleString(locale, formatOptions);
+
+      const year = targetDate.year;
+      const numericMonth = targetDate.month;
+      const monthCode = targetDate.monthCode;
+      const totalMonths = targetDate.monthsInYear;
+
+      const monthsBreakdown = [];
+      for (let m = 1; m <= totalMonths; m++) {
+        const monthDate = targetDate.with({ day: 1, month: m });
+        monthsBreakdown.push({
+          monthNumber: m,
+          monthCode: monthDate.monthCode,
+          daysInMonth: monthDate.daysInMonth,
+          isCurrent: monthDate.monthCode === monthCode
+        });
+      }
+
+      const monthsHtml = monthsBreakdown
+        .map(
+          (item) => `
+            <li class="month-chip ${item.isCurrent ? 'active-month' : ''}" data-month="${item.monthNumber}" data-month-code="${item.monthCode}" data-days="${item.daysInMonth}">
+              <span class="month-code">${item.monthCode}</span>
+              <span class="month-days">${item.daysInMonth} days</span>
+            </li>
+          `
+        )
+        .join('');
+
+      container.innerHTML = `
+        <div class="calendar-card-header">
+          <h3>${title}</h3>
+          <span class="timeline-badge" data-status="${relativeStatus}">${relativeStatus}</span>
+        </div>
+        <div class="localized-date-box" data-field="localized-date">${localizedDate}</div>
+        <div class="calendar-stats">
+          <div class="stat-item">
+            <span class="stat-label">Converted Year</span>
+            <span class="stat-value" data-field="year">${year}</span>
+          </div>
+          <div class="stat-item">
+            <span class="stat-label">Numeric Month</span>
+            <span class="stat-value" data-field="month">${numericMonth}</span>
+          </div>
+          <div class="stat-item">
+            <span class="stat-label">Month Code</span>
+            <span class="stat-value" data-field="month-code">${monthCode}</span>
+          </div>
+          <div class="stat-item">
+            <span class="stat-label">Total Months in Year</span>
+            <span class="stat-value" data-field="months-in-year">${totalMonths}</span>
+          </div>
+        </div>
+        <div class="months-breakdown">
+          <h4>Months Breakdown (${totalMonths} Months)</h4>
+          <ul class="months-list">
+            ${monthsHtml}
+          </ul>
+        </div>
+      `;
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput) return;
+
+      const islamicCalendarId = resolveIslamicCalendarId();
+      const calendars = [
+        {
+          elementId: 'islamic-date',
+          calendarId: islamicCalendarId,
+          title: 'Islamic Calendar',
+          locale: `en-u-ca-${islamicCalendarId}`,
+          includeEra: true
+        },
+        {
+          elementId: 'hebrew-date',
+          calendarId: 'hebrew',
+          title: 'Hebrew Calendar',
+          locale: 'en-u-ca-hebrew',
+          includeEra: true
+        },
+        {
+          elementId: 'japanese-date',
+          calendarId: 'japanese',
+          title: 'Japanese Calendar',
+          locale: 'en-u-ca-japanese',
+          includeEra: true
+        }
+      ];
+
+      const initialToday = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = initialToday.toString();
+      }
+
+      function updateCalendars() {
+        const todayIso = Temporal.Now.plainDateISO();
+        let selectedIso = todayIso;
+        if (dateInput.value) {
+          try {
+            selectedIso = Temporal.PlainDate.from(dateInput.value);
+          } catch {
+            selectedIso = todayIso;
+          }
+        }
+
+        for (const config of calendars) {
+          const cardEl = document.getElementById(config.elementId);
+          renderCalendarCard(cardEl, config, selectedIso, todayIso);
+        }
+      }
+
+      dateInput.addEventListener('input', updateCalendars);
+      dateInput.addEventListener('change', updateCalendars);
+      updateCalendars();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
