+  <script>
+    (function () {
+      const toolbar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const gridBtn = document.getElementById('view-grid-btn');
+      const listBtn = document.getElementById('view-list-btn');
+      const detailsBtn = document.getElementById('toggle-details-btn');
+      const filtersBtn = document.getElementById('toggle-filters-btn');
+      const copyBtn = document.getElementById('copy-drinks-btn');
+      const filterBar = document.getElementById('favorites-filters');
+      const statusRegion = document.getElementById('favorites-status');
+
+      function announce(msg) {
+        if (statusRegion) {
+          statusRegion.textContent = msg;
+        }
+      }
+
+      gridBtn.addEventListener('click', () => {
+        grid.classList.remove('list-view');
+        gridBtn.setAttribute('aria-pressed', 'true');
+        listBtn.setAttribute('aria-pressed', 'false');
+        announce('Switched to grid view');
+      });
+
+      listBtn.addEventListener('click', () => {
+        grid.classList.add('list-view');
+        listBtn.setAttribute('aria-pressed', 'true');
+        gridBtn.setAttribute('aria-pressed', 'false');
+        announce('Switched to list view');
+      });
+
+      detailsBtn.addEventListener('click', () => {
+        const isPressed = detailsBtn.getAttribute('aria-pressed') === 'true';
+        const nextState = !isPressed;
+        detailsBtn.setAttribute('aria-pressed', String(nextState));
+        grid.classList.toggle('hide-details', !nextState);
+        announce(nextState ? 'Drink details shown' : 'Drink details hidden');
+      });
+
+      filtersBtn.addEventListener('click', () => {
+        const isPressed = filtersBtn.getAttribute('aria-pressed') === 'true';
+        const nextState = !isPressed;
+        filtersBtn.setAttribute('aria-pressed', String(nextState));
+        filtersBtn.setAttribute('aria-expanded', String(nextState));
+        filterBar.hidden = !nextState;
+        announce(nextState ? 'Drink filters shown' : 'Drink filters hidden');
+      });
+
+      filterBar.addEventListener('click', (e) => {
+        const chip = e.target.closest('.chip');
+        if (!chip) return;
+        const filter = chip.getAttribute('data-filter');
+        filterBar.querySelectorAll('.chip').forEach((btn) => {
+          btn.setAttribute('aria-pressed', String(btn === chip));
+        });
+        grid.querySelectorAll('.card').forEach((card) => {
+          const match = filter === 'all' || card.getAttribute('data-category') === filter;
+          card.hidden = !match;
+        });
+        announce('Filtered by ' + chip.textContent);
+      });
+
+      copyBtn.addEventListener('click', async () => {
+        const cards = Array.from(grid.querySelectorAll('.card')).filter((c) => !c.hidden);
+        const text = cards
+          .map((card) => {
+            const title = card.querySelector('h3')?.textContent.trim() || '';
+            const desc = card.querySelector('p')?.textContent.trim() || '';
+            return `${title} - ${desc}`;
+          })
+          .join('\n');
+
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(text);
+          }
+          announce('Featured drinks list copied to clipboard');
+        } catch (err) {
+          announce('Unable to copy featured drinks list');
+        }
+      });
+
+      toolbar.addEventListener('keydown', (e) => {
+        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
+        const buttons = Array.from(toolbar.querySelectorAll('button'));
+        const idx = buttons.indexOf(document.activeElement);
+        if (idx === -1) return;
+        e.preventDefault();
+        const nextIdx = e.key === 'ArrowRight'
+          ? (idx + 1) % buttons.length
+          : (idx - 1 + buttons.length) % buttons.length;
+        buttons[nextIdx].focus();
+      });
+    })();
+  </script>
