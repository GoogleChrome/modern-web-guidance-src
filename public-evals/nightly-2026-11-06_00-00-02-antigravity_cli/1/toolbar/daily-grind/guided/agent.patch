+              .map((card) => {
+                const title = card.querySelector('h3')?.innerText.trim() || '';
+                const detailsEl = card.querySelector('.drink-details');
+                const includeDetails = target.getAttribute('data-details') !== 'hidden' && detailsEl;
+                const desc = includeDetails ? detailsEl.innerText.replace(/\s+/g, ' ').trim() : '';
+                return desc ? `${title} - ${desc}` : title;
+              })
+              .join('\n')
+          : target.innerText.trim();
+        if (!text) return;
+        try {
+          try {
+            await navigator.clipboard.writeText(text);
+          } catch {
+            if (!legacyCopy(text)) throw new Error('Copy failed');
+          }
+          report(button, true);
+        } catch {
+          report(button, false);
+        }
+      }
+
+      if ('CommandEvent' in window) {
+        document.addEventListener(
+          'command',
+          (event) => {
+            if (event.command.startsWith('--copy')) copy(event.source, event.target, event.command);
+          },
+          true
+        );
+      } else {
+        document.addEventListener('click', (event) => {
+          const button = event.target.closest('button[command^="--copy"]');
+          if (!button || button.getAttribute('aria-disabled') === 'true') return;
+          const target = document.getElementById(button.getAttribute('commandfor'));
+          if (target) copy(button, target, button.getAttribute('command'));
+        });
+      }
+    })();
+  </script>
