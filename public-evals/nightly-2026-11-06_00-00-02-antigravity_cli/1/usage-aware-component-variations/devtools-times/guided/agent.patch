+}
+
+/* ==========================================================================
+   1. Semantic Context Containers (Style Query Producers)
+   Note: Do NOT set `container-type` for style queries; they query inherited
+   custom properties on the nearest ancestor automatically.
+   ========================================================================== */
+
+.featured {
+  --surface: featured;
+}
+
+.spotlight {
+  --surface: spotlight;
+}
+
+.briefing {
+  --surface: briefing;
+}
+
+.related {
+  --surface: related;
+}
+
+.ticker {
+  --surface: ticker;
+}
+
+/* ==========================================================================
+   2. Default Component Styles (Standard Context)
+   ========================================================================== */
+
+.article-teaser {
+  display: flex;
+  flex-direction: column;
+  block-size: 100%;
+  background: var(--surface-bg-default);
+}
+
+.teaser-media {
+  display: block;
+  inline-size: 100%;
+}
+
+.teaser-image {
+  display: block;
+  inline-size: 100%;
+  block-size: auto;
+  object-fit: cover;
+  aspect-ratio: 16 / 9;
+  border-radius: var(--radius-md);
+}
+
+.teaser-body {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  margin-block-start: 0.75rem;
+}
+
+.teaser-meta-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: safe center;
+  gap: var(--space-sm);
+}
+
+/* Contextual badges are hidden by default and revealed only in relevant semantic contexts */
+.teaser-badge {
+  display: none;
+  align-items: safe center;
+  padding-block: 0.125rem;
+  padding-inline: var(--space-sm);
+  border-radius: var(--radius-pill);
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  background: var(--brand-accent-soft);
+  color: var(--brand-accent);
+}
+
+.teaser-title {
+  font-family: "Grenze", serif;
+  font-weight: 500;
+  font-size: 1.25rem;
+  line-height: 1.25;
+  color: var(--text-primary);
+  margin-block-start: var(--space-xs);
+}
+
+.teaser-summary {
+  color: var(--text-secondary);
+  margin-block-start: var(--space-xs);
+  font-size: 1rem;
+}
+
+.teaser-footer {
+  display: flex;
+  justify-content: space-between;
+  align-items: safe center;
+  gap: var(--space-sm);
+  color: var(--text-muted);
+  margin-block-start: auto;
+  padding-block-start: var(--space-sm);
+  border-block-start: 1px solid var(--surface-border-subtle);
+}
+
+.teaser-actions {
+  display: flex;
+  align-items: safe center;
+  gap: var(--space-sm);
+  margin-inline-start: auto;
+}
+
+/* Default: Outlined informational style for CTA & Bookmark button */
+.teaser-cta {
+  display: inline-flex;
+  align-items: safe center;
+  padding-block: var(--space-xs);
+  padding-inline: 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--text-secondary);
+  border: 1px solid currentColor;
+  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+.teaser-cta:hover {
+  color: var(--brand-accent);
+}
+
+.bookmark-button {
+  display: inline-flex;
+  align-items: safe center;
+  gap: var(--space-xs);
+  padding-block: var(--space-xs);
+  padding-inline: var(--space-sm);
+  font-size: 0.75rem;
+  font-weight: 600;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--text-muted);
+  border: 1px solid currentColor;
+  cursor: pointer;
+  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+.bookmark-button:hover:not(:disabled) {
+  color: var(--brand-accent);
+}
+
+.bookmark-label {
+  display: none;
+}
+
+/* ==========================================================================
+   3. Selector-Based Contextual Styles (Broad Browser Support Fallback)
+   Uses :where() to keep zero extra specificity on the context selector so
+   that @container style() rules later in source order win automatically.
+   ========================================================================== */
+
+/* Featured surface fallback */
+:where(.featured) .article-teaser {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: var(--space-xl);
+  padding: var(--space-lg);
+  background: var(--surface-bg-featured);
+  border: 1px solid var(--surface-border-strong);
+  border-radius: var(--radius-md);
+}
+
+:where(.featured) .teaser-body {
+  margin-block-start: 0;
+  justify-content: center;
+}
+
+:where(.featured) .teaser-badge--featured {
+  display: inline-flex;
+}
+
+:where(.featured) .teaser-title {
+  font-size: clamp(1.875rem, 3vw, 2.5rem);
+  line-height: 1.15;
+  margin-block-start: var(--space-sm);
+}
+
+:where(.featured) .teaser-summary {
+  font-size: 1.125rem;
+  margin-block-start: var(--space-md);
+}
+
+:where(.featured) .teaser-footer {
+  margin-block-start: var(--space-lg);
+  padding-block-start: var(--space-md);
+  border-block-start-color: var(--surface-border-strong);
+}
+
+:where(.featured) .teaser-cta,
+:where(.featured) .bookmark-button {
+  background: var(--brand-accent);
+  color: white;
+  border: none;
+}
+
+:where(.featured) .teaser-cta:hover,
+:where(.featured) .bookmark-button:hover:not(:disabled) {
+  background: var(--brand-accent-hover);
+  color: white;
+}
+
+:where(.featured) .bookmark-label {
+  display: inline;
+}
+
+/* Spotlight surface fallback (visual media focus, concise copy) */
+:where(.spotlight) .article-teaser {
+  padding: var(--space-md);
+  border: 1px solid var(--surface-border-subtle);
+  border-radius: var(--radius-md);
+}
+
+:where(.spotlight) .teaser-badge--spotlight {
+  display: inline-flex;
+}
+
+:where(.spotlight) .teaser-summary {
+  display: none;
+}
+
+:where(.spotlight) .teaser-title {
+  font-size: 1.5rem;
+}
+
+/* Briefing surface fallback (editorial text focus without thumbnail) */
+:where(.briefing) .article-teaser {
+  padding: var(--space-lg);
+  background: var(--surface-bg-briefing);
+  border: 1px solid var(--surface-border-subtle);
+  border-radius: var(--radius-md);
+}
+
+:where(.briefing) .teaser-media {
