+}
+
+:where(.briefing) .teaser-badge--briefing {
+  display: inline-flex;
+}
+
+:where(.briefing) .teaser-title {
+  font-size: 1.5rem;
+}
+
+/* Related surface fallback */
+:where(.related) .teaser-badge--related {
+  display: inline-flex;
+}
+
+/* Ticker surface fallback (ultra-compact top bar items) */
+:where(.ticker) .teaser-media,
+:where(.ticker) .teaser-summary,
+:where(.ticker) .teaser-footer,
+:where(.ticker) .teaser-category {
+  display: none;
+}
+
+:where(.ticker) .teaser-body {
+  margin-block-start: 0;
+}
+
+:where(.ticker) .teaser-title {
+  font-family: inherit;
+  font-weight: 700;
+  font-size: 1rem;
+}
