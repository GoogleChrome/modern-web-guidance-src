+import type { CollectionEntry } from 'astro:content';
+
+export type SemanticDomain =
+  | 'breaking-civic'   // News, Politics, National, Criminal Networks, Infrastructure
+  | 'economic-data'    // Economy, Business, Labor, Manufacturing, Markets
+  | 'scientific-lab'   // Science, Tech, Web Development, Forensic, Research
+  | 'cultural-stage'   // Culture, Media, Arts, Ballet, Music, Journalism
+  | 'kinetic-pulse'    // Sports, Athletics, Championships, Super Bowl
+  | 'organic-living';  // Lifestyle, Urban Development, Pets, Coastal, Coffee
+
+export type SemanticTone =
+  | 'urgent'           // Crisis, breaking, crime, strikes, decay
+  | 'analytical'       // Research, data, forensic, outlook, tech, markets
+  | 'expressive'       // Culture, stage, ballet, improv, indie fest
+  | 'kinetic'          // High-energy sports, action, competition
+  | 'serene';          // Nature, coffee, coastal, lifestyle, pets
+
+export type VisualArchetype =
+  | 'editorial-broadsheet' // Authoritative serif, heavy rule borders, urgency indicators
+  | 'market-terminal'      // Structured ledger lines, monospace data metrics, financial accents
+  | 'research-dossier'     // Technical blueprint grid, metadata pills, lab-grade precision
+  | 'gallery-playbill'     // High-contrast artistic framing, asymmetric editorial typography, warm spotlight
+  | 'stadium-scoreboard'   // Bold athletic angles, kinetic telemetry badges, high-contrast energy
+  | 'botanical-journal';   // Soft organic curves, warm tactile paper tones, sensory calm
+
+export type ReadingDepth = 'quick-dispatch' | 'standard-feature' | 'deep-investigation';
+
+export interface SemanticMetric {
+  label: string;
+  value: string;
+  unit?: string;
+  trend?: 'up' | 'down' | 'neutral' | 'alert';
+}
+
+export interface SemanticProfile {
+  domain: SemanticDomain;
+  tone: SemanticTone;
+  archetype: VisualArchetype;
+  depth: ReadingDepth;
+  domainLabel: string;
+  toneLabel: string;
+  archetypeLabel: string;
+  urgencyScore: number; // 1 to 100
+  analyticalDensity: number; // 1 to 100
+  sensoryWarmth: number; // 1 to 100
+  accentPrimary: string;
+  accentSecondary: string;
+  surfaceBg: string;
+  borderStyle: string;
+  badgeStyle: string;
+  fontPairing: 'editorial-serif' | 'technical-mono' | 'display-kinetic' | 'cultural-playbill' | 'organic-humanist';
+  layoutPattern: 'asymmetric-split' | 'technical-bento' | 'gallery-spotlight' | 'kinetic-banner' | 'ledger-grid' | 'journal-card';
+  contextualMetrics: SemanticMetric[];
+  semanticCues: string[];
+  calloutTitle: string;
+  calloutBody: string;
+}
+
+const DOMAIN_CONFIG: Record<SemanticDomain, {
+  archetype: VisualArchetype;
+  domainLabel: string;
+  archetypeLabel: string;
+  defaultTone: SemanticTone;
+  accentPrimary: string;
+  accentSecondary: string;
+  surfaceBg: string;
+  borderStyle: string;
+  badgeStyle: string;
+  fontPairing: SemanticProfile['fontPairing'];
+  layoutPattern: SemanticProfile['layoutPattern'];
+}> = {
+  'breaking-civic': {
+    archetype: 'editorial-broadsheet',
+    domainLabel: 'Civic & Dispatch',
+    archetypeLabel: 'Broadsheet Wire',
+    defaultTone: 'urgent',
+    accentPrimary: '#dc2626',   // Crimson 600
+    accentSecondary: '#991b1b', // Crimson 800
+    surfaceBg: '#fffafa',
+    borderStyle: 'border-l-4 border-red-700',
+    badgeStyle: 'bg-red-50 text-red-800 border border-red-200',
+    fontPairing: 'editorial-serif',
+    layoutPattern: 'asymmetric-split',
+  },
+  'economic-data': {
+    archetype: 'market-terminal',
+    domainLabel: 'Markets & Labor',
+    archetypeLabel: 'Ledger Terminal',
+    defaultTone: 'analytical',
+    accentPrimary: '#047857',   // Emerald 700
+    accentSecondary: '#065f46', // Emerald 800
+    surfaceBg: '#f8fafc',
+    borderStyle: 'border-t-2 border-emerald-700',
+    badgeStyle: 'bg-emerald-50 text-emerald-800 border border-emerald-200 font-mono',
+    fontPairing: 'technical-mono',
+    layoutPattern: 'ledger-grid',
+  },
+  'scientific-lab': {
+    archetype: 'research-dossier',
+    domainLabel: 'Science & Systems',
+    archetypeLabel: 'Technical Dossier',
+    defaultTone: 'analytical',
+    accentPrimary: '#0369a1',   // Sky/Cyan 700
+    accentSecondary: '#1e3a8a', // Indigo 900
+    surfaceBg: '#f0f9ff',
+    borderStyle: 'border border-sky-200 border-t-4 border-t-sky-600',
+    badgeStyle: 'bg-sky-50 text-sky-800 border border-sky-200 font-mono',
+    fontPairing: 'technical-mono',
+    layoutPattern: 'technical-bento',
+  },
+  'cultural-stage': {
+    archetype: 'gallery-playbill',
+    domainLabel: 'Arts & Criticism',
+    archetypeLabel: 'Gallery Playbill',
+    defaultTone: 'expressive',
+    accentPrimary: '#7e22ce',   // Purple 700
+    accentSecondary: '#be185d', // Pink 700
+    surfaceBg: '#faf5ff',
+    borderStyle: 'border-b-4 border-purple-800',
+    badgeStyle: 'bg-purple-50 text-purple-900 border border-purple-200 italic',
+    fontPairing: 'cultural-playbill',
+    layoutPattern: 'gallery-spotlight',
+  },
+  'kinetic-pulse': {
+    archetype: 'stadium-scoreboard',
+    domainLabel: 'Athletic Arena',
+    archetypeLabel: 'Kinetic Telemetry',
+    defaultTone: 'kinetic',
+    accentPrimary: '#ea580c',   // Orange 600
+    accentSecondary: '#c2410c', // Orange 700
+    surfaceBg: '#fff7ed',
+    borderStyle: 'border-l-4 border-orange-600',
+    badgeStyle: 'bg-orange-100 text-orange-900 border border-orange-300 uppercase tracking-wider font-bold',
+    fontPairing: 'display-kinetic',
+    layoutPattern: 'kinetic-banner',
+  },
+  'organic-living': {
+    archetype: 'botanical-journal',
+    domainLabel: 'Living & Habitat',
+    archetypeLabel: 'Sensory Fieldnote',
+    defaultTone: 'serene',
+    accentPrimary: '#b45309',   // Amber 700
+    accentSecondary: '#4d7c0f', // Lime 700
+    surfaceBg: '#fefce8',
+    borderStyle: 'border border-amber-200/80 rounded-xl',
+    badgeStyle: 'bg-amber-50 text-amber-900 border border-amber-200 rounded-full',
+    fontPairing: 'organic-humanist',
+    layoutPattern: 'journal-card',
+  },
+};
+
+export function resolveCategoryDomain(category: string, textContent = ''): SemanticDomain {
+  const cat = (category || '').toLowerCase().trim();
+  const text = textContent.toLowerCase();
+
+  if (['politics', 'national', 'news', 'news & politics'].includes(cat)) {
+    return 'breaking-civic';
+  }
+  if (['economy', 'business', 'labor'].includes(cat)) {
+    return 'economic-data';
+  }
+  if (['science', 'web development', 'science & tech', 'tech'].includes(cat)) {
+    return 'scientific-lab';
+  }
+  if (['culture', 'media', 'arts & culture', 'arts'].includes(cat)) {
+    return 'cultural-stage';
+  }
+  if (['sports'].includes(cat)) {
+    return 'kinetic-pulse';
+  }
+  if (['lifestyle', 'urban development', 'pets', 'lifestyle & sports'].includes(cat)) {
+    // Disambiguate if text strongly signals sports or civic urgency
+    if (cat === 'lifestyle & sports' && (text.includes('athlete') || text.includes('sports') || text.includes('championship'))) {
+      return 'kinetic-pulse';
+    }
+    return 'organic-living';
+  }
+
+  // Fallback keyword classification
+  if (/(crisis|strike|crime|activism|decay|election)/.test(text)) return 'breaking-civic';
+  if (/(market|economy|manufacturing|housing|supply)/.test(text)) return 'economic-data';
+  if (/(research|forensic|devtools|science|dna|ai)/.test(text)) return 'scientific-lab';
+  if (/(ballet|improv|festival|music|theater|journalism)/.test(text)) return 'cultural-stage';
+  if (/(olympic|bowl|tennis|cycling|game|stadium)/.test(text)) return 'kinetic-pulse';
+
+  return 'organic-living';
+}
+
+export function analyzeSemanticTone(
+  domain: SemanticDomain,
+  title: string,
+  summary: string,
+  tags: string[] = []
+): { tone: SemanticTone; toneLabel: string; urgencyScore: number; analyticalDensity: number; sensoryWarmth: number; cues: string[] } {
+  const combined = `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
+  const cues: string[] = [];
+
+  let urgencyScore = 35;
+  let analyticalDensity = 45;
+  let sensoryWarmth = 45;
+
+  // Check urgent signals
+  const urgentMatches = combined.match(/\b(crisis|ticking time bomb|decay|strikes|unrest|killer|crime|criminal|existential|urgent|gridlock|overhaul|protest)\b/g);
+  if (urgentMatches) {
+    urgencyScore += Math.min(55, urgentMatches.length * 18);
+    cues.push(...Array.from(new Set(urgentMatches)).slice(0, 2).map(w => `Urgency: "${w}"`));
+  }
+
+  // Check analytical signals
+  const analyticalMatches = combined.match(/\b(research|science|forensic|dna|data|manufacturing|supply chains|economic|devtools|performance|verification|microscope|photosynthesis|analysis)\b/g);
+  if (analyticalMatches) {
+    analyticalDensity += Math.min(50, analyticalMatches.length * 16);
+    cues.push(...Array.from(new Set(analyticalMatches)).slice(0, 2).map(w => `Analytical: "${w}"`));
+  }
+
+  // Check kinetic signals
+  const kineticMatches = combined.match(/\b(thrills|championships|super bowl|olympic|roar|race|explosive|electric|stadium|rematch|swimmers|cyclist)\b/g);
+  if (kineticMatches) {
+    urgencyScore += Math.min(40, kineticMatches.length * 14);
+    sensoryWarmth += 20;
+    cues.push(...Array.from(new Set(kineticMatches)).slice(0, 2).map(w => `Kinetic: "${w}"`));
+  }
+
+  // Check expressive/cultural signals
+  const expressiveMatches = combined.match(/\b(ballet|swan lake|improv|unscripted|indie|festival|stage|choreography|classic|art)\b/g);
+  if (expressiveMatches) {
+    sensoryWarmth += Math.min(45, expressiveMatches.length * 16);
+    cues.push(...Array.from(new Set(expressiveMatches)).slice(0, 2).map(w => `Expressive: "${w}"`));
+  }
+
+  // Check serene/organic signals
+  const sereneMatches = combined.match(/\b(coastal|shore|tides|coffee|alchemy|roasted|plants|quiet|cuddle|griffon|sanctuary|breeze|open water)\b/g);
+  if (sereneMatches) {
+    sensoryWarmth += Math.min(50, sereneMatches.length * 18);
+    urgencyScore = Math.max(15, urgencyScore - 15);
+    cues.push(...Array.from(new Set(sereneMatches)).slice(0, 2).map(w => `Sensory: "${w}"`));
+  }
+
+  urgencyScore = Math.min(98, Math.max(12, urgencyScore));
+  analyticalDensity = Math.min(98, Math.max(15, analyticalDensity));
+  sensoryWarmth = Math.min(98, Math.max(15, sensoryWarmth));
+
+  let tone: SemanticTone = DOMAIN_CONFIG[domain].defaultTone;
+  if (urgencyScore >= 72 && domain !== 'kinetic-pulse') {
+    tone = 'urgent';
+  } else if (domain === 'kinetic-pulse' || (kineticMatches && kineticMatches.length >= 2)) {
+    tone = 'kinetic';
+  } else if (analyticalDensity >= 70) {
+    tone = 'analytical';
+  } else if (domain === 'cultural-stage' || (expressiveMatches && expressiveMatches.length >= 2)) {
+    tone = 'expressive';
+  } else if (sensoryWarmth >= 68) {
+    tone = 'serene';
+  }
+
+  const toneLabels: Record<SemanticTone, string> = {
+    urgent: 'High-Urgency Dispatch',
+    analytical: 'Empirical & Analytical',
+    expressive: 'Critical & Expressive',
+    kinetic: 'High-Tempo Action',
+    serene: 'Reflective & Sensory',
+  };
+
+  if (cues.length === 0) {
+    cues.push(`Domain: ${DOMAIN_CONFIG[domain].domainLabel}`);
+  }
+
+  return {
+    tone,
+    toneLabel: toneLabels[tone],
+    urgencyScore,
+    analyticalDensity,
+    sensoryWarmth,
+    cues,
+  };
+}
+
+function buildContextualMetrics(
+  domain: SemanticDomain,
+  tone: SemanticTone,
+  readingTime: number,
+  urgencyScore: number,
+  analyticalDensity: number,
+  sensoryWarmth: number,
+  title: string
+): { metrics: SemanticMetric[]; calloutTitle: string; calloutBody: string } {
+  const lowerTitle = title.toLowerCase();
+
+  switch (domain) {
+    case 'breaking-civic':
+      return {
+        metrics: [
+          { label: 'Civic Impact', value: urgencyScore > 70 ? 'Critical' : 'Elevated', trend: 'alert' },
+          { label: 'Urgency Index', value: `${urgencyScore}`, unit: '/100', trend: 'up' },
+          { label: 'Dispatch Pacing', value: `${readingTime}m`, unit: 'brief', trend: 'neutral' },
+        ],
+        calloutTitle: 'Civic Impact Assessment',
+        calloutBody: lowerTitle.includes('infrastructure')
+          ? 'Structural grade evaluated at D+ across monitored metropolitan corridors; immediate legislative allocation required.'
+          : lowerTitle.includes('criminal')
+          ? 'Multi-jurisdictional intelligence synthesis mapping illicit network topologies and cross-border nodes.'
+          : 'Active civic development with direct implications for public policy, institutional accountability, and community governance.',
+      };
+
+    case 'economic-data':
+      return {
+        metrics: [
+          { label: 'Market Signal', value: tone === 'urgent' ? 'Volatile' : 'Expansion', trend: tone === 'urgent' ? 'alert' : 'up' },
+          { label: 'Data Density', value: `${analyticalDensity}%`, trend: 'up' },
+          { label: 'Sector Horizon', value: 'Q3–Q4', unit: 'cycle', trend: 'neutral' },
+        ],
+        calloutTitle: 'Macroeconomic Ledger Context',
+        calloutBody: lowerTitle.includes('housing')
+          ? 'Urban supply deficit widened by zoning bottlenecks, material inflation, and skilled construction labor constraints.'
+          : lowerTitle.includes('strike')
+          ? 'Collective bargaining momentum accelerating across transit and technology sectors amid real-wage compression.'
+          : 'Domestic industrial reshoring driven by semiconductor capital expenditure and clean-tech supply chain incentives.',
+      };
+
+    case 'scientific-lab':
+      return {
+        metrics: [
+          { label: 'Empirical Rigor', value: `${analyticalDensity}`, unit: 'idx', trend: 'up' },
+          { label: 'Method', value: lowerTitle.includes('forensic') || lowerTitle.includes('killer') ? 'Forensic' : 'Peer-Lab', trend: 'neutral' },
+          { label: 'Depth', value: `${readingTime} min`, unit: 'dossier', trend: 'neutral' },
+        ],
+        calloutTitle: 'Scientific & Technical Dossier',
+        calloutBody: lowerTitle.includes('architects') || lowerTitle.includes('plant')
+          ? 'Photosynthetic carbon fixation and vascular xylem/phloem transport form the primary biosphere equilibrium engine.'
+          : lowerTitle.includes('devtools')
+          ? 'Runtime telemetry, network request conditioning, and flamechart profiling reduce interaction-to-next-paint latency.'
+          : 'Evidence-driven inquiry combining laboratory instrumentation, molecular sequencing, and behavioral pattern analysis.',
+      };
+
+    case 'cultural-stage':
+      return {
+        metrics: [
+          { label: 'Aesthetic Mode', value: lowerTitle.includes('journalism') || lowerTitle.includes('print') ? 'Fourth Estate' : 'Live Stage', trend: 'neutral' },
+          { label: 'Resonance', value: `${sensoryWarmth}%`, trend: 'up' },
+          { label: 'Curation', value: 'Critic’s Pick', trend: 'up' },
+        ],
+        calloutTitle: 'Curatorial & Critical Note',
+        calloutBody: lowerTitle.includes('swan lake')
+          ? 'Minimalist scenography and contemporary athletic phrasing strip away classical artifice to expose raw dramatic tension.'
+          : lowerTitle.includes('journalism') || lowerTitle.includes('print')
+          ? 'Structural transition from legacy print circulation toward algorithmic verification and direct reader stewardship.'
+          : 'Live unscripted performance and independent sonic curation reaffirm the communal vitality of physical stages.',
+      };
+
+    case 'kinetic-pulse':
+      return {
+        metrics: [
+          { label: 'Tempo Rating', value: `${Math.max(78, urgencyScore)}`, unit: 'BPM-eq', trend: 'up' },
+          { label: 'Arena Status', value: lowerTitle.includes('super bowl') ? 'Title Bout' : 'Finals', trend: 'alert' },
+          { label: 'Read Sprint', value: `${readingTime}m`, unit: 'pace', trend: 'neutral' },
+        ],
+        calloutTitle: 'Athletic Telemetry & Matchup Pulse',
+        calloutBody: lowerTitle.includes('super bowl')
+          ? 'Championship rematch pitting New England’s top-ranked scoring defense (10-7 AFC title win) against Seattle’s aerial offense.'
+          : 'High-output physical endurance and tactical execution under peak competitive stadium pressure.',
+      };
+
+    case 'organic-living':
+    default:
+      return {
+        metrics: [
+          { label: 'Sensory Index', value: `${sensoryWarmth}`, unit: '/100', trend: 'up' },
+          { label: 'Cadence', value: readingTime <= 3 ? 'Brisk' : 'Unhurried', trend: 'neutral' },
+          { label: 'Habitat', value: lowerTitle.includes('coastal') ? 'Intertidal' : lowerTitle.includes('coffee') ? 'Botanical' : 'Urban', trend: 'neutral' },
+        ],
+        calloutTitle: 'Fieldnote & Living Context',
+        calloutBody: lowerTitle.includes('coffee')
+          ? 'Maillard roasting kinetics unlock 800+ volatile aromatic compounds across high-altitude Arabica and Robusta cultivars.'
+          : lowerTitle.includes('coastal')
+          ? 'Intertidal microclimates and negative-ion marine aerosols modulate circadian rhythm and reduce systemic cortisol.'
+          : 'Human-scale urban mobility, domestic companionship, and restorative daily rituals anchored in tactile place.',
+      };
+  }
+}
+
+export function deriveSemanticProfile(input: {
+  title: string;
+  summary?: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+}): SemanticProfile {
+  const { title, summary = '', category, readingTime = 4, tags = [] } = input;
+  const domain = resolveCategoryDomain(category, `${title} ${summary}`);
+  const config = DOMAIN_CONFIG[domain];
+  const { tone, toneLabel, urgencyScore, analyticalDensity, sensoryWarmth, cues } = analyzeSemanticTone(
+    domain,
+    title,
+    summary,
+    tags
+  );
+
+  const depth: ReadingDepth =
+    readingTime <= 3 ? 'quick-dispatch' : readingTime >= 6 ? 'deep-investigation' : 'standard-feature';
+
+  const { metrics, calloutTitle, calloutBody } = buildContextualMetrics(
+    domain,
+    tone,
+    readingTime,
+    urgencyScore,
+    analyticalDensity,
+    sensoryWarmth,
+    title
+  );
+
+  return {
+    domain,
+    tone,
+    archetype: config.archetype,
+    depth,
+    domainLabel: config.domainLabel,
+    toneLabel,
+    archetypeLabel: config.archetypeLabel,
+    urgencyScore,
+    analyticalDensity,
+    sensoryWarmth,
+    accentPrimary: config.accentPrimary,
+    accentSecondary: config.accentSecondary,
+    surfaceBg: config.surfaceBg,
+    borderStyle: config.borderStyle,
+    badgeStyle: config.badgeStyle,
+    fontPairing: config.fontPairing,
+    layoutPattern: config.layoutPattern,
+    contextualMetrics: metrics,
+    semanticCues: cues,
+    calloutTitle,
+    calloutBody,
+  };
+}
+
+export function deriveArticleSemanticProfile(article: CollectionEntry<'articles'>): SemanticProfile {
+  return deriveSemanticProfile({
+    title: article.data.title,
+    summary: article.data.summary,
+    category: article.data.category,
+    readingTime: article.data.readingTime ?? 4,
+    tags: article.data.tags ?? [],
+  });
+}
+
+export function getAllSemanticDomains(): Array<{
+  domain: SemanticDomain;
+  label: string;
+  archetype: VisualArchetype;
+  archetypeLabel: string;
+  accentPrimary: string;
+  description: string;
+}> {
+  return [
+    {
+      domain: 'breaking-civic',
