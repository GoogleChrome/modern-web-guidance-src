+    >
+      {/* Semantic Context Header Bar */}
+      <div className={theme.headerBar}>
+        <div className="flex items-center gap-2">
+          <span className="inline-block w-2 h-2 rounded-full bg-current opacity-80" />
+          <span>
+            Semantic Context: {profile.domainLabel} • {profile.archetypeLabel}
