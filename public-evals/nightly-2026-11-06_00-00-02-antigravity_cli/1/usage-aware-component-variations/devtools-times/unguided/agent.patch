+            onClick={() => setShowInspector(!showInspector)}
+            className="text-[11px] underline opacity-90 hover:opacity-100 cursor-pointer"
+          >
+            {showInspector ? 'Hide Visual Logic' : 'Inspect Visual Logic'}
+          </button>
+        )}
+      </div>
+
+      {/* Optional Interactive Visual Logic Switcher / Inspector */}
+      {showInspector && (
+        <div className="px-4 py-3 bg-white/95 border-b border-gray-200 text-xs">
+          <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
+            <span className="font-semibold text-gray-700">
+              Preview Adaptive Visual Archetype Override:
+            </span>
+            <div className="flex flex-wrap gap-1">
+              {domainOptions.map((opt) => (
+                <button
+                  key={opt.id}
+                  type="button"
+                  onClick={() => setActiveDomain(opt.id)}
+                  className={`px-2 py-0.5 rounded text-[11px] font-medium transition-colors cursor-pointer ${
+                    activeDomain === opt.id
+                      ? 'bg-gray-900 text-white'
+                      : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
+                  }`}
+                >
+                  {opt.label}
+                </button>
+              ))}
+            </div>
+          </div>
+          <div className="grid grid-cols-3 gap-2 pt-1 text-[11px] text-gray-600 font-mono">
+            <div>Urgency Score: {profile.urgencyScore}/100</div>
+            <div>Analytical Density: {profile.analyticalDensity}/100</div>
+            <div>Sensory Warmth: {profile.sensoryWarmth}/100</div>
+          </div>
+        </div>
+      )}
+
+      {/* Main Callout Body */}
+      <div className="p-4 sm:p-5">
+        <div className="flex flex-col md:flex-row md:items-start justify-between gap-4">
+          <div className="flex-1">
+            <div className="text-[11px] uppercase tracking-wider opacity-70 font-semibold mb-1">
+              {profile.toneLabel} • {profile.depth.replace('-', ' ')}
+            </div>
+            <h4 className={`mb-2 ${theme.titleText}`}>{displayTitle}</h4>
+            <p className={theme.bodyText}>{displayBody}</p>
+
+            {/* Semantic Cues */}
+            <div className="mt-3 flex flex-wrap items-center gap-1.5">
+              <span className="text-[11px] text-gray-500 font-medium mr-1">Context Signals:</span>
+              {profile.semanticCues.map((cue, idx) => (
+                <span key={idx} className={theme.cueBadge}>
+                  {cue}
+                </span>
+              ))}
+            </div>
+          </div>
+
+          {/* Contextual Metrics Grid */}
+          <div className="grid grid-cols-3 md:grid-cols-1 gap-2 md:w-44 flex-shrink-0">
+            {profile.contextualMetrics.map((metric, idx) => (
+              <div key={idx} className={theme.metricBox}>
+                <div className="text-[10px] uppercase tracking-wider opacity-70">{metric.label}</div>
+                <div className={theme.metricValue}>
+                  {metric.value}
+                  {metric.unit && <span className="text-xs font-normal opacity-75 ml-0.5">{metric.unit}</span>}
+                </div>
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+    </aside>
+  );
+}
