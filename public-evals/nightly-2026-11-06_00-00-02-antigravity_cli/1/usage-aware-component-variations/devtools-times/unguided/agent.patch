+
+interface SemanticAdaptiveCalloutProps {
+  profile: SemanticProfile;
+  title?: string;
+  body?: string;
+  interactiveOverride?: boolean;
+}
+
+const DOMAIN_THEME_CLASSES: Record<
+  SemanticDomain,
