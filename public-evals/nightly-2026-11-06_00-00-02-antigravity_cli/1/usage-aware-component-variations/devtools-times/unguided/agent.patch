+                                {report.data.description}
+                            </p>
+                        </div>
+
+                        <div class="pt-3 border-t border-gray-200/80 flex items-center justify-between text-xs font-mono text-gray-600">
+                            <span>{profile.calloutTitle}</span>
+                            <span class="font-semibold" style={`color: ${profile.accentPrimary}`}>
+                                {profile.contextualMetrics[0]?.label}: {profile.contextualMetrics[0]?.value}
+                            </span>
+                        </div>
+                    </article>
+                );
+            })}
         </div>
     </div>
-</Layout>
