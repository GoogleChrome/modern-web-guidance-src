+import type {
+  TranslationAvailability,
+  TranslatorInstance,
+  LanguageDetectorInstance,
+} from '../global';
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName: string;
+  flag: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English', nativeName: 'English', flag: '🇺🇸' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español', flag: '🇪🇸' },
+  { code: 'fr', name: 'French', nativeName: 'Français', flag: '🇫🇷' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch', flag: '🇩🇪' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano', flag: '🇮🇹' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português', flag: '🇵🇹' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語', flag: '🇯🇵' },
+  { code: 'zh', name: 'Chinese', nativeName: '中文', flag: '🇨🇳' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어', flag: '🇰🇷' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية', flag: '🇸🇦' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी', flag: '🇮🇳' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский', flag: '🇷🇺' },
+];
+
+export function getLanguageName(code: string): string {
+  const found = SUPPORTED_LANGUAGES.find((l) => l.code === code);
+  if (found) return `${found.name} (${found.nativeName})`;
+  try {
+    const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+    return displayNames.of(code) || code.toUpperCase();
+  } catch {
+    return code.toUpperCase();
+  }
+}
+
+export function isOnDeviceTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'Translator' in self ||
+      window.Translator ||
+      window.ai?.translator ||
+      window.translation?.createTranslator
+  );
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'LanguageDetector' in self ||
+      window.LanguageDetector ||
+      window.ai?.languageDetector ||
+      window.translation?.createDetector
+  );
+}
+
+function normalizeAvailability(raw: string | undefined): TranslationAvailability {
+  if (!raw) return 'unavailable';
+  if (raw === 'readily' || raw === 'available') return 'available';
+  if (raw === 'after-download' || raw === 'downloadable') return 'downloadable';
+  if (raw === 'downloading') return 'downloading';
+  return 'unavailable';
+}
+
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<TranslationAvailability> {
+  if (sourceLanguage === targetLanguage) return 'available';
+  if (typeof window === 'undefined') return 'unavailable';
+
+  try {
+    if (window.Translator && typeof window.Translator.availability === 'function') {
+      const status = await window.Translator.availability({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+    if (window.ai?.translator) {
+      if (typeof window.ai.translator.availability === 'function') {
+        const status = await window.ai.translator.availability({ sourceLanguage, targetLanguage });
+        return normalizeAvailability(status);
+      }
+      if (typeof window.ai.translator.capabilities === 'function') {
+        const caps = await window.ai.translator.capabilities();
+        if (caps.languagePairAvailable) {
+          return normalizeAvailability(caps.languagePairAvailable(sourceLanguage, targetLanguage));
+        }
+        return normalizeAvailability(caps.available);
+      }
+    }
+    if (window.translation && typeof window.translation.canTranslate === 'function') {
+      const status = await window.translation.canTranslate({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+  } catch (err) {
+    console.warn('Error checking on-device translation availability:', err);
+  }
+
+  return 'unavailable';
+}
+
+export async function detectSourceLanguage(text: string): Promise<{ language: string; confidence: number } | null> {
+  if (typeof window === 'undefined' || !text.trim()) return null;
+
+  try {
+    let detector: LanguageDetectorInstance | null = null;
+    if (window.LanguageDetector && typeof window.LanguageDetector.create === 'function') {
+      detector = await window.LanguageDetector.create();
+    } else if (window.ai?.languageDetector?.create) {
+      detector = await window.ai.languageDetector.create();
+    } else if (window.translation?.createDetector) {
+      detector = await window.translation.createDetector();
+    }
+
+    if (detector) {
+      const results = await detector.detect(text.slice(0, 1000));
+      if (typeof detector.destroy === 'function') {
+        detector.destroy();
+      }
+      if (results && results.length > 0 && results[0].detectedLanguage) {
+        return {
+          language: results[0].detectedLanguage,
+          confidence: results[0].confidence ?? 1,
+        };
+      }
+    }
+  } catch (err) {
+    console.warn('Language detection failed, falling back to default:', err);
+  }
+
+  return null;
+}
+
+export interface CreateTranslatorParams {
+  sourceLanguage: string;
+  targetLanguage: string;
+  signal?: AbortSignal;
+  onDownloadProgress?: (progressPercent: number) => void;
+}
+
+const translatorCache = new Map<string, TranslatorInstance>();
+
+export async function getOrCreateOnDeviceTranslator({
+  sourceLanguage,
+  targetLanguage,
+  signal,
+  onDownloadProgress,
+}: CreateTranslatorParams): Promise<TranslatorInstance | null> {
+  if (typeof window === 'undefined') return null;
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+  if (translatorCache.has(cacheKey)) {
+    return translatorCache.get(cacheKey)!;
+  }
+
+  const monitorCallback = (monitor: any) => {
+    monitor.addEventListener('downloadprogress', (e: any) => {
+      if (onDownloadProgress) {
+        const loaded = typeof e.loaded === 'number' ? e.loaded : 0;
+        const total = typeof e.total === 'number' && e.total > 0 ? e.total : 1;
+        // In Chrome Translator API, e.loaded is either 0..1 or bytes out of e.total
+        const ratio = e.total ? loaded / total : loaded;
+        const pct = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+        onDownloadProgress(pct);
+      }
+    });
+  };
+
+  try {
+    let instance: TranslatorInstance | null = null;
+
+    if (window.Translator && typeof window.Translator.create === 'function') {
+      instance = await window.Translator.create({
+        sourceLanguage,
+        targetLanguage,
+        signal,
+        monitor: monitorCallback,
+      });
+    } else if (window.ai?.translator?.create) {
+      instance = await window.ai.translator.create({
+        sourceLanguage,
+        targetLanguage,
+        signal,
+        monitor: monitorCallback,
+      });
+    } else if (window.translation?.createTranslator) {
+      instance = await window.translation.createTranslator({
+        sourceLanguage,
+        targetLanguage,
+        signal,
+        monitor: monitorCallback,
+      });
+    }
+
+    if (instance) {
+      translatorCache.set(cacheKey, instance);
+      return instance;
+    }
+  } catch (err) {
+    console.warn(`Native on-device Translator.create failed for ${cacheKey}:`, err);
+  }
+
+  return null;
