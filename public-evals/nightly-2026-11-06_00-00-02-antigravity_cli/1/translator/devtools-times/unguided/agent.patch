+export interface TranslationProgressStats {
+  completedSegments: number;
+  totalSegments: number;
+  downloadProgress: number | null;
+  usedNativeApi: boolean;
+  detectedSourceLanguage?: string;
+}
+
+const originalTextStore = new WeakMap<Element, string>();
+
+export function restoreElementsToOriginal(elements: Element[]): void {
+  for (const el of elements) {
+    const orig = originalTextStore.get(el);
+    if (orig !== undefined) {
+      el.textContent = orig;
+    }
+    el.removeAttribute('data-translated-lang');
+    el.removeAttribute('lang');
+  }
+}
+
+export async function translateDomElements(
+  elements: Element[],
+  options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal?: AbortSignal;
+    onProgress?: (stats: TranslationProgressStats) => void;
+  }
+): Promise<TranslationProgressStats> {
+  const { sourceLanguage, targetLanguage, signal, onProgress } = options;
+
+  if (sourceLanguage === targetLanguage || targetLanguage === 'original') {
+    restoreElementsToOriginal(elements);
+    return {
+      completedSegments: elements.length,
+      totalSegments: elements.length,
+      downloadProgress: null,
+      usedNativeApi: true,
+    };
+  }
+
+  // Filter elements that have meaningful text and no child elements we are separately translating
+  const validElements = elements.filter((el) => {
+    const existingOrig = originalTextStore.get(el);
+    const currentText = (existingOrig ?? el.textContent ?? '').trim();
+    return currentText.length > 0;
+  });
+
+  let actualSourceLang = sourceLanguage;
+  if (sourceLanguage === 'auto' && validElements.length > 0) {
+    const sampleText = validElements
+      .slice(0, 3)
+      .map((el) => originalTextStore.get(el) ?? el.textContent ?? '')
+      .join(' ');
+    const detected = await detectSourceLanguage(sampleText);
+    actualSourceLang = detected?.language || 'en';
+  }
+
+  if (actualSourceLang === targetLanguage) {
+    restoreElementsToOriginal(validElements);
+    return {
+      completedSegments: validElements.length,
+      totalSegments: validElements.length,
+      downloadProgress: null,
+      usedNativeApi: true,
+      detectedSourceLanguage: actualSourceLang,
+    };
+  }
+
+  let downloadProgress: number | null = null;
+  let usedNativeApi = false;
+  let completedSegments = 0;
+  const totalSegments = validElements.length;
+
+  const notify = () => {
+    onProgress?.({
+      completedSegments,
+      totalSegments,
+      downloadProgress,
+      usedNativeApi,
+      detectedSourceLanguage: actualSourceLang,
+    });
+  };
+
+  notify();
+
+  for (const el of validElements) {
+    if (signal?.aborted) {
+      throw new DOMException('Translation aborted', 'AbortError');
+    }
+
+    if (!originalTextStore.has(el)) {
+      originalTextStore.set(el, el.textContent ?? '');
+    }
+    const sourceText = originalTextStore.get(el)!;
+
+    const { translatedText, usedNativeApi: isNative } = await translateTextOnDevice(sourceText, {
+      sourceLanguage: actualSourceLang,
+      targetLanguage,
+      signal,
+      onDownloadProgress: (pct) => {
+        downloadProgress = pct;
+        notify();
+      },
+    });
+
+    usedNativeApi = usedNativeApi || isNative;
+    el.textContent = translatedText;
+    el.setAttribute('data-translated-lang', targetLanguage);
