+function fallbackLocalTranslate(text: string, sourceLanguage: string, targetLanguage: string): string {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) return text;
+
+  const dict = OFFLINE_DICTIONARY[targetLanguage];
+  if (dict) {
+    if (dict[trimmed]) {
+      return text.replace(trimmed, dict[trimmed]);
+    }
+    // Word-level phrasebook substitution when exact headline/phrase isn't matched
+    const words = trimmed.split(/(\s+|[.,!?;:"'()—-]+)/);
+    let replacedCount = 0;
+    const translatedWords = words.map((token) => {
+      const lower = token.toLowerCase();
+      if (dict[lower]) {
+        replacedCount++;
+        const replacement = dict[lower];
+        if (token[0] && token[0] === token[0].toUpperCase() && token[0] !== token[0].toLowerCase()) {
+          return replacement.charAt(0).toUpperCase() + replacement.slice(1);
+        }
+        return replacement;
+      }
+      return token;
+    });
+    if (replacedCount > 0) {
+      return translatedWords.join('');
+    }
+  }
+
+  return `[${targetLanguage.toUpperCase()}] ${trimmed}`;
+}
+
+const textTranslationMemory = new Map<string, string>();
+
+export async function translateTextOnDevice(
+  text: string,
+  options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal?: AbortSignal;
+    onDownloadProgress?: (pct: number) => void;
+  }
+): Promise<{ translatedText: string; usedNativeApi: boolean }> {
+  const { sourceLanguage, targetLanguage, signal, onDownloadProgress } = options;
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) {
+    return { translatedText: text, usedNativeApi: true };
+  }
+
+  const memKey = `${sourceLanguage}:${targetLanguage}:${trimmed}`;
+  if (textTranslationMemory.has(memKey)) {
+    return { translatedText: textTranslationMemory.get(memKey)!, usedNativeApi: true };
+  }
+
+  const translator = await getOrCreateOnDeviceTranslator({
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    onDownloadProgress,
+  });
+
+  if (translator) {
+    try {
+      const result = await translator.translate(trimmed, { signal });
+      textTranslationMemory.set(memKey, result);
+      return { translatedText: result, usedNativeApi: true };
+    } catch (err) {
+      if ((err as Error)?.name === 'AbortError') throw err;
+      console.warn('Translator.translate error, using local fallback:', err);
+    }
+  }
+
+  const fallbackResult = fallbackLocalTranslate(text, sourceLanguage, targetLanguage);
+  textTranslationMemory.set(memKey, fallbackResult);
+  return { translatedText: fallbackResult, usedNativeApi: false };
+}
