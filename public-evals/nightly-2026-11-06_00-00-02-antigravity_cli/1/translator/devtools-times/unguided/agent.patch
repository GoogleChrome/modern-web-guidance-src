diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..e49e14f
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,654 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  checkTranslationAvailability,
+  isOnDeviceTranslatorSupported,
+  translateDomElements,
+  restoreElementsToOriginal,
+  detectSourceLanguage,
+} from '../utils/translator';
+import type { TranslationAvailability } from '../global';
+
+export interface ArticleTranslationControlProps {
+  /**
+   * Scope of translation:
+   * - 'article': Translates the current news article (headline, summary, caption, body) + related teasers on the page
+   * - 'page': Global header control that translates all news articles and teasers visible on the page
+   * - 'teaser': Compact control scoped to a single teaser card
+   */
+  scope?: 'article' | 'page' | 'teaser';
+  /**
+   * Optional CSS selector or container ID when scoping to a specific article or teaser
+   */
+  containerSelector?: string;
+  /**
+   * Default source language code (defaults to 'en' or 'auto')
+   */
+  defaultSourceLanguage?: string;
+}
+
+const STORAGE_KEY_TARGET_LANG = 'devtools_times_preferred_target_lang';
+const STORAGE_KEY_SOURCE_LANG = 'devtools_times_preferred_source_lang';
+const GLOBAL_TRANSLATE_EVENT = 'devtools-times:language-change';
+
+function collectTranslatableElements(scope: 'article' | 'page' | 'teaser', container: HTMLElement | null): Element[] {
+  const root: Document | HTMLElement =
+    scope === 'page' ? document : container || document.querySelector('[data-article-container]') || document;
+
+  const elements: Element[] = [];
+  const seen = new Set<Element>();
+
+  const addEl = (el: Element | null) => {
+    if (!el || seen.has(el)) return;
+    // Skip script, style, or translation control UI elements
+    if (el.closest('[data-translation-control="true"]') || el.tagName === 'SCRIPT' || el.tagName === 'STYLE') {
+      return;
+    }
+    seen.add(el);
+    elements.push(el);
+  };
+
+  // 1. Explicitly marked translatable elements (headlines, teaser titles, summaries, captions, categories)
+  root.querySelectorAll('[data-translatable]').forEach((el) => addEl(el));
+
+  // 2. Article prose body elements (paragraphs, headings, list items, blockquotes)
+  root.querySelectorAll('[data-translatable-body] p, [data-translatable-body] h2, [data-translatable-body] h3, [data-translatable-body] h4, [data-translatable-body] li, [data-translatable-body] blockquote').forEach((el) => {
+    addEl(el);
+  });
+
+  // 3. Fallback selectors for any teaser or article headings/summaries not yet tagged
+  if (scope === 'page' || scope === 'article') {
+    root.querySelectorAll('article h1, article h2, article h3, article p, article figcaption').forEach((el) => {
+      // Avoid parent containers if children are already added
+      if (el.querySelector('p, h1, h2, h3')) return;
+      addEl(el);
+    });
+  }
+
+  return elements;
+}
+
+export default function ArticleTranslationControl({
+  scope = 'article',
+  containerSelector,
+  defaultSourceLanguage = 'en',
+}: ArticleTranslationControlProps) {
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>('original');
+  const [availability, setAvailability] = useState<TranslationAvailability>('available');
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+  const [status, setStatus] = useState<'idle' | 'detecting' | 'downloading' | 'translating' | 'translated' | 'error'>('idle');
+  const [progress, setProgress] = useState<{ completed: number; total: number; downloadPct: number | null }>({
+    completed: 0,
+    total: 0,
+    downloadPct: null,
+  });
+  const [detectedLang, setDetectedLang] = useState<string | null>(null);
+  const [usedNativeApi, setUsedNativeApi] = useState<boolean>(true);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [isDropdownOpen, setIsDropdownOpen] = useState<boolean>(false);
+
+  const rootRef = useRef<HTMLDivElement>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const resolveContainer = useCallback((): HTMLElement | null => {
+    if (typeof document === 'undefined') return null;
+    if (containerSelector) {
+      return document.querySelector<HTMLElement>(containerSelector);
+    }
+    if (scope === 'teaser' && rootRef.current) {
+      return rootRef.current.closest<HTMLElement>('[data-teaser-card], article, .shadow-sm');
+    }
+    if (scope === 'article' && rootRef.current) {
+      return rootRef.current.closest<HTMLElement>('article') || document.querySelector<HTMLElement>('article');
+    }
+    return document.body;
+  }, [containerSelector, scope]);
+
+  // Check API support and availability when language pair changes
+  useEffect(() => {
+    const supported = isOnDeviceTranslatorSupported();
+    setApiSupported(supported);
+
+    if (targetLanguage === 'original' || sourceLanguage === targetLanguage) {
+      setAvailability('available');
+      return;
+    }
+
+    let cancelled = false;
+    const effectiveSource = sourceLanguage === 'auto' ? detectedLang || 'en' : sourceLanguage;
+    checkTranslationAvailability(effectiveSource, targetLanguage).then((avail) => {
+      if (!cancelled) {
+        setAvailability(avail);
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage, detectedLang]);
+
+  const performTranslation = useCallback(
+    async (srcLang: string, tgtLang: string, broadcast = true) => {
+      if (abortControllerRef.current) {
+        abortControllerRef.current.abort();
+      }
+
+      const container = resolveContainer();
+      const elements = collectTranslatableElements(scope, container);
+
+      if (tgtLang === 'original' || srcLang === tgtLang) {
+        restoreElementsToOriginal(elements);
+        setStatus('idle');
+        setErrorMessage(null);
+        if (broadcast && scope !== 'teaser') {
+          localStorage.setItem(STORAGE_KEY_TARGET_LANG, 'original');
+          window.dispatchEvent(
+            new CustomEvent(GLOBAL_TRANSLATE_EVENT, {
+              detail: { sourceLanguage: srcLang, targetLanguage: 'original', originScope: scope },
+            })
+          );
+        }
+        return;
+      }
+
+      if (elements.length === 0) return;
+
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+      setErrorMessage(null);
+      setStatus(srcLang === 'auto' ? 'detecting' : 'translating');
+      setProgress({ completed: 0, total: elements.length, downloadPct: null });
+
+      try {
+        const result = await translateDomElements(elements, {
+          sourceLanguage: srcLang,
+          targetLanguage: tgtLang,
+          signal: controller.signal,
+          onProgress: (stats) => {
+            if (stats.detectedSourceLanguage) {
+              setDetectedLang(stats.detectedSourceLanguage);
+            }
+            if (stats.downloadProgress !== null && stats.downloadProgress < 100 && stats.completedSegments === 0) {
+              setStatus('downloading');
+            } else {
+              setStatus('translating');
+            }
+            setProgress({
+              completed: stats.completedSegments,
+              total: stats.totalSegments,
+              downloadPct: stats.downloadProgress,
+            });
+          },
+        });
+
+        setUsedNativeApi(result.usedNativeApi);
+        if (result.detectedSourceLanguage) {
+          setDetectedLang(result.detectedSourceLanguage);
+        }
+        setStatus('translated');
+
+        if (broadcast && scope !== 'teaser') {
+          localStorage.setItem(STORAGE_KEY_TARGET_LANG, tgtLang);
+          localStorage.setItem(STORAGE_KEY_SOURCE_LANG, srcLang);
+          window.dispatchEvent(
+            new CustomEvent(GLOBAL_TRANSLATE_EVENT, {
+              detail: { sourceLanguage: srcLang, targetLanguage: tgtLang, originScope: scope },
+            })
+          );
+        }
+      } catch (err) {
+        if ((err as Error)?.name === 'AbortError') return;
+        console.error('Translation failed:', err);
+        setStatus('error');
+        setErrorMessage((err as Error)?.message || 'Unable to translate content on-device.');
+      }
+    },
+    [resolveContainer, scope]
+  );
+
+  // Sync with saved preference or global language-change events across the page
+  useEffect(() => {
+    const savedTarget = localStorage.getItem(STORAGE_KEY_TARGET_LANG);
+    const savedSource = localStorage.getItem(STORAGE_KEY_SOURCE_LANG);
+
+    if (savedSource) {
+      setSourceLanguage(savedSource);
+    }
+    if (savedTarget && savedTarget !== 'original') {
+      setTargetLanguage(savedTarget);
+      performTranslation(savedSource || defaultSourceLanguage, savedTarget, false);
+    }
+
+    const handleGlobalChange = (e: Event) => {
+      const customEvent = e as CustomEvent<{
+        sourceLanguage: string;
+        targetLanguage: string;
+        originScope: string;
+      }>;
+      if (!customEvent.detail) return;
+      const { sourceLanguage: newSrc, targetLanguage: newTgt } = customEvent.detail;
+      setSourceLanguage(newSrc);
+      setTargetLanguage(newTgt);
+      performTranslation(newSrc, newTgt, false);
+    };
+
+    window.addEventListener(GLOBAL_TRANSLATE_EVENT, handleGlobalChange);
+    return () => {
+      window.removeEventListener(GLOBAL_TRANSLATE_EVENT, handleGlobalChange);
+      if (abortControllerRef.current) {
+        abortControllerRef.current.abort();
+      }
+    };
+  }, [defaultSourceLanguage, performTranslation]);
+
+  const handleSelectTargetLanguage = (newTarget: string) => {
+    setTargetLanguage(newTarget);
+    setIsDropdownOpen(false);
+    performTranslation(sourceLanguage, newTarget, true);
+  };
+
+  const handleSelectSourceLanguage = (newSource: string) => {
+    setSourceLanguage(newSource);
+    if (targetLanguage !== 'original') {
+      performTranslation(newSource, targetLanguage, true);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    if (targetLanguage === 'original') return;
+    const effectiveSource = sourceLanguage === 'auto' ? detectedLang || 'en' : sourceLanguage;
+    const nextSource = targetLanguage;
+    const nextTarget = effectiveSource;
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    performTranslation(nextSource, nextTarget, true);
+  };
+
+  const handleDetectLanguage = async () => {
+    const container = resolveContainer();
+    const elements = collectTranslatableElements(scope, container);
+    const sample = elements
+      .slice(0, 3)
+      .map((el) => el.textContent || '')
+      .join(' ');
+    setStatus('detecting');
+    const result = await detectSourceLanguage(sample);
+    const lang = result?.language || 'en';
+    setDetectedLang(lang);
+    setSourceLanguage(lang);
+    if (targetLanguage !== 'original') {
+      performTranslation(lang, targetLanguage, true);
+    } else {
+      setStatus('idle');
+    }
+  };
+
+  const handleReset = () => {
+    setTargetLanguage('original');
+    setIsDropdownOpen(false);
+    performTranslation(sourceLanguage, 'original', true);
+  };
+
+  const currentTargetOption = SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage);
+
+  // Compact header bar mode ('page' scope) for translating teasers & articles site-wide
+  if (scope === 'page') {
+    return (
+      <div
+        ref={rootRef}
+        data-translation-control="true"
+        className="relative inline-flex items-center"
+      >
+        <div className="flex items-center space-x-1.5 bg-gray-100 hover:bg-gray-200/80 border border-gray-300 rounded px-2 py-1 text-xs transition-colors">
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.75}
+            stroke="currentColor"
+            className="w-4 h-4 text-amber-600 flex-shrink-0"
+            aria-hidden="true"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <label htmlFor="header-translate-select" className="sr-only">
+            Translate articles and teasers
+          </label>
+          <select
+            id="header-translate-select"
+            aria-label="Translate page articles and teasers"
+            value={targetLanguage}
+            onChange={(e) => handleSelectTargetLanguage(e.target.value)}
+            className="bg-transparent font-medium text-gray-800 focus:outline-none cursor-pointer pr-1"
+          >
+            <option value="original">Translate: Original (EN)</option>
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.flag} {lang.name} ({lang.nativeName})
+              </option>
+            ))}
+          </select>
+
+          {status === 'translating' || status === 'downloading' || status === 'detecting' ? (
+            <span
+              className="inline-flex items-center text-[11px] text-amber-700 font-semibold pl-1"
+              title="On-device translation in progress"
+            >
+              <span className="w-3 h-3 border-2 border-amber-500 border-t-transparent rounded-full animate-spin mr-1" />
+              {progress.total > 0 ? `${Math.round((progress.completed / progress.total) * 100)}%` : '...'}
+            </span>
+          ) : status === 'translated' && targetLanguage !== 'original' ? (
+            <button
+              type="button"
+              onClick={handleReset}
+              title="Restore original language"
+              className="text-[11px] font-semibold text-amber-700 hover:text-amber-900 underline pl-1 cursor-pointer"
+            >
+              Reset
+            </button>
+          ) : null}
+        </div>
+      </div>
+    );
+  }
+
+  // Compact inline teaser button mode ('teaser' scope)
+  if (scope === 'teaser') {
+    return (
+      <div
+        ref={rootRef}
+        data-translation-control="true"
+        className="relative inline-flex items-center"
+      >
+        <button
+          type="button"
+          onClick={() => setIsDropdownOpen((prev) => !prev)}
+          title="Translate teaser on-device"
+          aria-label="Translate teaser on-device"
+          aria-expanded={isDropdownOpen}
+          className={`inline-flex items-center space-x-1 text-xs px-2 py-1 rounded border transition-colors cursor-pointer ${
+            status === 'translated' && targetLanguage !== 'original'
+              ? 'bg-amber-50 border-amber-300 text-amber-800 font-semibold'
+              : 'bg-gray-50 border-gray-200 text-gray-600 hover:text-amber-600 hover:border-amber-300'
+          }`}
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.75}
+            stroke="currentColor"
+            className="w-3.5 h-3.5"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <span>
+            {status === 'translating' || status === 'downloading'
+              ? '...'
+              : currentTargetOption && targetLanguage !== 'original'
+              ? currentTargetOption.code.toUpperCase()
+              : 'Translate'}
+          </span>
+        </button>
+
+        {isDropdownOpen && (
+          <div className="absolute bottom-full right-0 mb-1.5 w-48 bg-white border border-gray-200 rounded-md shadow-lg py-1.5 px-2 z-30 text-xs">
+            <div className="font-semibold text-gray-700 pb-1 mb-1 border-b border-gray-100 flex justify-between items-center">
+              <span>On-Device Translate</span>
+              <button
+                type="button"
+                onClick={() => setIsDropdownOpen(false)}
+                className="text-gray-400 hover:text-gray-600"
+                aria-label="Close translation menu"
+              >
+                ✕
+              </button>
+            </div>
+            <label className="block text-[11px] text-gray-500 mb-1">
+              Target Language:
+              <select
+                value={targetLanguage}
+                onChange={(e) => handleSelectTargetLanguage(e.target.value)}
+                className="mt-0.5 w-full border border-gray-300 rounded px-1.5 py-1 text-gray-800 bg-white focus:outline-none focus:border-amber-400"
+              >
+                <option value="original">Original</option>
+                {SUPPORTED_LANGUAGES.map((lang) => (
+                  <option key={lang.code} value={lang.code}>
+                    {lang.flag} {lang.name}
+                  </option>
+                ))}
+              </select>
+            </label>
+            {targetLanguage !== 'original' && (
+              <button
+                type="button"
+                onClick={handleReset}
+                className="mt-1 w-full text-center py-1 text-amber-700 hover:bg-amber-50 rounded font-medium cursor-pointer"
+              >
+                Show Original
+              </button>
+            )}
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  // Full Article Translation Control bar ('article' scope)
+  return (
+    <div
+      ref={rootRef}
+      data-translation-control="true"
+      className="bg-gray-50 border border-gray-200 rounded-lg p-3 sm:p-4 my-4 shadow-2xs"
+      role="region"
+      aria-label="On-device article translation control"
+    >
+      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
+        {/* Title & On-Device Badge */}
+        <div className="flex items-center space-x-2.5">
+          <div className="w-8 h-8 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0">
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.75}
+              stroke="currentColor"
+              className="w-5 h-5"
+              aria-hidden="true"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+          </div>
+          <div>
+            <div className="flex items-center space-x-2">
+              <span className="text-sm font-semibold text-gray-900">On-Device Article Translator</span>
+              <span
+                className={`text-[11px] font-medium px-2 py-0.5 rounded-full ${
+                  apiSupported
+                    ? 'bg-emerald-100 text-emerald-800'
+                    : 'bg-amber-100 text-amber-800'
+                }`}
+              >
+                {apiSupported ? 'Browser AI Ready' : 'Local Offline Mode'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Translate this article and teasers privately in your browser without sending text to a server.
+            </p>
+          </div>
+        </div>
+
+        {/* Language Controls */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source Language */}
+          <div className="flex items-center space-x-1">
+            <label htmlFor="article-source-lang" className="text-xs font-medium text-gray-600">
+              From:
+            </label>
+            <select
+              id="article-source-lang"
+              aria-label="Source language"
+              value={sourceLanguage}
+              onChange={(e) => handleSelectSourceLanguage(e.target.value)}
+              className="text-xs bg-white border border-gray-300 rounded-md px-2.5 py-1.5 text-gray-800 font-medium focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
+            >
+              <option value="auto">
+                Auto-detect{detectedLang ? ` (${detectedLang.toUpperCase()})` : ''}
+              </option>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Swap button */}
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={targetLanguage === 'original'}
+            title="Swap source and target languages"
+            aria-label="Swap source and target languages"
+            className="p-1.5 text-gray-500 hover:text-gray-800 hover:bg-gray-200/60 rounded-md disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.75}
+              stroke="currentColor"
+              className="w-4 h-4"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+              />
+            </svg>
+          </button>
+
+          {/* Target Language */}
+          <div className="flex items-center space-x-1">
+            <label htmlFor="article-target-lang" className="text-xs font-medium text-gray-600">
+              To:
+            </label>
+            <select
+              id="article-target-lang"
+              aria-label="Target language"
+              value={targetLanguage}
+              onChange={(e) => handleSelectTargetLanguage(e.target.value)}
+              className="text-xs bg-white border border-gray-300 rounded-md px-2.5 py-1.5 text-gray-800 font-medium focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
+            >
+              <option value="original">Original Article</option>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Detect Language Button */}
+          <button
+            type="button"
+            onClick={handleDetectLanguage}
+            title="Detect article language using on-device LanguageDetector API"
+            className="text-xs bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 font-medium px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
+          >
+            Detect
+          </button>
+
+          {/* Restore Original Button */}
+          {targetLanguage !== 'original' && (
+            <button
+              type="button"
+              onClick={handleReset}
+              className="text-xs bg-gray-800 hover:bg-gray-700 text-white font-semibold px-3 py-1.5 rounded-md transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Status & Progress Bar */}
+      {(status !== 'idle' || errorMessage) && (
+        <div className="mt-3 pt-2.5 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
+          <div className="flex items-center space-x-2">
+            {(status === 'translating' || status === 'downloading' || status === 'detecting') && (
+              <>
+                <span className="w-3.5 h-3.5 border-2 border-amber-500 border-t-transparent rounded-full animate-spin flex-shrink-0" />
+                <span className="text-gray-700 font-medium">
+                  {status === 'detecting' && 'Detecting article language on-device...'}
+                  {status === 'downloading' &&
+                    `Downloading on-device language model (${progress.downloadPct ?? 0}%)...`}
+                  {status === 'translating' &&
+                    `Translating article on-device (${progress.completed} of ${progress.total} segments)...`}
+                </span>
+              </>
+            )}
+
+            {status === 'translated' && targetLanguage !== 'original' && (
+              <span className="text-emerald-700 font-medium flex items-center">
+                <svg
+                  className="w-4 h-4 mr-1 text-emerald-600"
+                  fill="none"
+                  stroke="currentColor"
+                  viewBox="0 0 24 24"
+                >
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    strokeWidth={2}
+                    d="M5 13l4 4L19 7"
+                  />
+                </svg>
+                Translated into {currentTargetOption?.name || targetLanguage.toUpperCase()} (
+                {usedNativeApi ? 'Chrome On-Device Translator API' : 'On-Device Offline Dictionary'})
+              </span>
+            )}
+
+            {status === 'error' && errorMessage && (
+              <span className="text-red-600 font-medium">{errorMessage}</span>
+            )}
+          </div>
+
+          {availability === 'downloadable' && status === 'idle' && (
+            <span className="text-amber-700">
+              Language pack will be downloaded on-device on first use.
+            </span>
+          )}
+
+          {(status === 'translating' || status === 'downloading') && progress.total > 0 && (
+            <div className="w-full sm:w-40 bg-gray-200 h-1.5 rounded-full overflow-hidden">
+              <div
+                className="bg-amber-500 h-full transition-all duration-200"
+                style={{
+                  width: `${
+                    status === 'downloading'
+                      ? progress.downloadPct ?? 10
+                      : Math.round((progress.completed / progress.total) * 100)
+                  }%`,
+                }}
+              />
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
