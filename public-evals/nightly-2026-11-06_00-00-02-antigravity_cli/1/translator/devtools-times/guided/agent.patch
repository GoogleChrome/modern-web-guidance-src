+import type {
+  TranslatorAvailability,
+  TranslatorInstance,
+  TranslatorOptions,
+} from '../../global';
+
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+  nativeName: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'zh', name: 'Chinese (Simplified)', nativeName: '中文 (简体)' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)', nativeName: '中文 (繁體)' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe' },
+  { code: 'vi', name: 'Vietnamese', nativeName: 'Tiếng Việt' },
+  { code: 'id', name: 'Indonesian', nativeName: 'Bahasa Indonesia' },
+  { code: 'th', name: 'Thai', nativeName: 'ไทย' },
+  { code: 'sv', name: 'Swedish', nativeName: 'Svenska' },
+  { code: 'da', name: 'Danish', nativeName: 'Dansk' },
+  { code: 'fi', name: 'Finnish', nativeName: 'Suomi' },
+  { code: 'no', name: 'Norwegian', nativeName: 'Norsk' },
+  { code: 'cs', name: 'Czech', nativeName: 'Čeština' },
+  { code: 'el', name: 'Greek', nativeName: 'Ελληνικά' },
+  { code: 'he', name: 'Hebrew', nativeName: 'עברית' },
+  { code: 'hu', name: 'Hungarian', nativeName: 'Magyar' },
+  { code: 'ro', name: 'Romanian', nativeName: 'Română' },
+  { code: 'uk', name: 'Ukrainian', nativeName: 'Українська' },
+  { code: 'bg', name: 'Bulgarian', nativeName: 'Български' },
+  { code: 'bn', name: 'Bengali', nativeName: 'বাংলা' },
+  { code: 'hr', name: 'Croatian', nativeName: 'Hrvatski' },
+  { code: 'kn', name: 'Kannada', nativeName: 'ಕನ್ನಡ' },
+  { code: 'lt', name: 'Lithuanian', nativeName: 'Lietuvių' },
+  { code: 'mr', name: 'Marathi', nativeName: 'मराठी' },
+  { code: 'sk', name: 'Slovak', nativeName: 'Slovenčina' },
+  { code: 'sl', name: 'Slovenian', nativeName: 'Slovenščina' },
+  { code: 'ta', name: 'Tamil', nativeName: 'தமிழ்' },
+  { code: 'te', name: 'Telugu', nativeName: 'తెలుగు' },
+];
+
+export const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+export function getLanguageDir(code: string): 'rtl' | 'ltr' {
+  return RTL_LANGUAGES.has(code) ? 'rtl' : 'ltr';
+}
+
+export function getLanguageName(code: string): string {
+  const found = SUPPORTED_LANGUAGES.find((l) => l.code === code);
+  return found ? found.name : code;
+}
+
+export function isTranslatorSupported(): boolean {
+  return (
+    typeof self !== 'undefined' &&
+    'Translator' in self &&
+    Boolean(self.Translator)
+  );
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return (
+    typeof self !== 'undefined' &&
+    'LanguageDetector' in self &&
+    Boolean(self.LanguageDetector)
+  );
+}
+
+export async function checkTranslatorAvailability(
+  options: TranslatorOptions,
+): Promise<TranslatorAvailability> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unavailable';
+  }
+  if (options.sourceLanguage === options.targetLanguage) {
+    return 'available';
+  }
+  try {
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+const translatorInstanceCache = new Map<string, Promise<TranslatorInstance>>();
+const translationTextCache = new Map<string, string>();
+
+/**
+ * Creates or retrieves a cached on-device Translator instance for the language pair.
+ * Note: When availability is 'downloadable' or 'downloading', calling this MUST be
+ * initiated directly by a user gesture (e.g., a button click) to prevent NotAllowedError.
+ */
+export async function getOrCreateTranslator(
+  options: TranslatorOptions,
+  onDownloadProgress?: (percent: number) => void,
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    throw new Error(
+      'Client-side translation is currently unsupported in this browser.',
+    );
+  }
+
+  const pairKey = `${options.sourceLanguage}->${options.targetLanguage}`;
+  const existing = translatorInstanceCache.get(pairKey);
+  if (existing) {
+    return existing;
+  }
+
+  // Pass the identical options object to availability() and create()
+  const pairOptions: TranslatorOptions = {
+    sourceLanguage: options.sourceLanguage,
+    targetLanguage: options.targetLanguage,
+  };
+
+  const availability = await self.Translator.availability(pairOptions);
+  if (availability === 'unavailable') {
+    throw new Error(
+      `On-device translation from ${getLanguageName(pairOptions.sourceLanguage)} to ${getLanguageName(pairOptions.targetLanguage)} is unavailable on this device.`,
+    );
+  }
+
+  const creationPromise = self.Translator.create({
+    ...pairOptions,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        const ratio =
+          typeof e.total === 'number' && e.total > 0
+            ? e.loaded / e.total
+            : e.loaded;
+        const pct = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+        onDownloadProgress?.(pct);
+      });
+    },
+  }).catch((err) => {
+    translatorInstanceCache.delete(pairKey);
+    throw err;
+  });
+
+  translatorInstanceCache.set(pairKey, creationPromise);
+  return creationPromise;
+}
+
+/**
+ * Detects the source language of a sample text using the on-device LanguageDetector API.
+ * Must be invoked within a user gesture if the detector model is downloadable/downloading.
+ */
+export async function detectTextLanguage(
+  sampleText: string,
+  fallbackLanguage = 'en',
+  onDownloadProgress?: (percent: number) => void,
+): Promise<{ detectedLanguage: string; confidence: number }> {
+  const cleaned = sampleText.trim();
+  if (cleaned.length < 12 || !isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return { detectedLanguage: fallbackLanguage, confidence: 1 };
+  }
+
+  try {
+    const availability = await self.LanguageDetector.availability();
+    if (availability === 'unavailable') {
+      return { detectedLanguage: fallbackLanguage, confidence: 1 };
+    }
+
+    const detector = await self.LanguageDetector.create({
+      monitor(m) {
+        m.addEventListener('downloadprogress', (e) => {
+          const ratio =
+            typeof e.total === 'number' && e.total > 0
+              ? e.loaded / e.total
+              : e.loaded;
+          const pct = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+          onDownloadProgress?.(pct);
+        });
+      },
+    });
+
+    const results = await detector.detect(cleaned.slice(0, 600));
+    if (results && results.length > 0 && results[0].detectedLanguage) {
+      const top = results[0];
+      const isSupported = SUPPORTED_LANGUAGES.some(
+        (l) => l.code === top.detectedLanguage,
+      );
+      if (isSupported && top.confidence >= 0.4) {
+        return {
+          detectedLanguage: top.detectedLanguage,
+          confidence: top.confidence,
+        };
+      }
+    }
+  } catch {
+    // Graceful fallback if detection fails or requires gesture
+  }
+
+  return { detectedLanguage: fallbackLanguage, confidence: 1 };
+}
+
+/**
+ * Translates a single piece of text using the given TranslatorInstance, with in-memory caching.
+ */
+export async function translateTextWithCache(
+  translator: TranslatorInstance,
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string,
+  useStreamingForLongText = false,
+  onStreamUpdate?: (partial: string) => void,
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) {
+    return text;
+  }
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}::${trimmed}`;
+  const cached = translationTextCache.get(cacheKey);
+  if (cached !== undefined) {
+    onStreamUpdate?.(cached);
+    return cached;
+  }
+
+  if (
+    useStreamingForLongText &&
+    trimmed.length > 160 &&
+    typeof translator.translateStreaming === 'function'
+  ) {
+    try {
+      const stream = translator.translateStreaming(trimmed);
+      let accumulated = '';
+      for await (const chunk of stream) {
+        // Handle both incremental chunks and cumulative chunks across Chrome implementations
+        if (accumulated && chunk.startsWith(accumulated)) {
+          accumulated = chunk;
+        } else {
+          accumulated += chunk;
+        }
+        onStreamUpdate?.(accumulated);
+      }
+      if (accumulated.trim()) {
+        translationTextCache.set(cacheKey, accumulated);
+        return accumulated;
+      }
+    } catch {
+      // Fall back to standard translate() if streaming throws
+    }
+  }
+
+  const result = await translator.translate(trimmed);
+  translationTextCache.set(cacheKey, result);
+  onStreamUpdate?.(result);
+  return result;
+}
+
+const originalTextStore = new WeakMap<Element, string>();
+const originalLangStore = new WeakMap<Element, string | null>();
+const originalDirStore = new WeakMap<Element, string | null>();
+
+function rememberElementOriginal(el: Element): string {
+  const existing = originalTextStore.get(el);
+  if (existing !== undefined) {
+    return existing;
+  }
+  const attrOrig = el.getAttribute('data-original-text');
+  const text = attrOrig !== null ? attrOrig : (el.textContent ?? '');
+  originalTextStore.set(el, text);
+  if (attrOrig === null) {
+    el.setAttribute('data-original-text', text);
+  }
+  if (!originalLangStore.has(el)) {
+    originalLangStore.set(el, el.getAttribute('lang'));
+  }
+  if (!originalDirStore.has(el)) {
+    originalDirStore.set(el, el.getAttribute('dir'));
+  }
+  return text;
+}
+
+function restoreElementOriginal(el: Element): void {
+  const orig =
+    originalTextStore.get(el) ?? el.getAttribute('data-original-text');
+  if (orig !== null && orig !== undefined) {
+    el.textContent = orig;
+  }
+  const origLang = originalLangStore.get(el);
+  if (origLang) {
+    el.setAttribute('lang', origLang);
+  } else {
+    el.removeAttribute('lang');
+  }
+  const origDir = originalDirStore.get(el);
+  if (origDir) {
+    el.setAttribute('dir', origDir);
+  } else {
+    el.removeAttribute('dir');
+  }
+  el.removeAttribute('data-translated-lang');
+}
+
+const originalNodeTextStore = new WeakMap<Text, string>();
+
+function collectTranslatableTextNodes(root: Element): Text[] {
+  const nodes: Text[] = [];
+  if (typeof document === 'undefined') return nodes;
+
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      const tag = parent.tagName.toLowerCase();
+      if (
+        tag === 'script' ||
+        tag === 'style' ||
+        tag === 'code' ||
+        tag === 'pre' ||
+        tag === 'noscript' ||
+        parent.closest('[data-no-translate="true"]')
+      ) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      const value =
+        originalNodeTextStore.get(node as Text) ?? node.nodeValue ?? '';
+      if (!value.trim()) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  let current = walker.nextNode();
+  while (current) {
+    const textNode = current as Text;
+    if (!originalNodeTextStore.has(textNode)) {
+      originalNodeTextStore.set(textNode, textNode.nodeValue ?? '');
+    }
+    nodes.push(textNode);
+    current = walker.nextNode();
+  }
+
+  return nodes;
+}
+
+async function translateTextNodePreservingFormatting(
+  translator: TranslatorInstance,
+  textNode: Text,
+  sourceLanguage: string,
+  targetLanguage: string,
+  useStreaming = false,
+): Promise<void> {
+  const original =
+    originalNodeTextStore.get(textNode) ?? textNode.nodeValue ?? '';
+  if (!originalNodeTextStore.has(textNode)) {
+    originalNodeTextStore.set(textNode, original);
+  }
+
+  const leadingWhitespaceMatch = original.match(/^\s*/);
+  const trailingWhitespaceMatch = original.match(/\s*$/);
+  const leading = leadingWhitespaceMatch ? leadingWhitespaceMatch[0] : '';
+  const trailing = trailingWhitespaceMatch ? trailingWhitespaceMatch[0] : '';
+  const core = original.trim();
+
+  if (!core) return;
+
+  const translated = await translateTextWithCache(
+    translator,
+    core,
+    sourceLanguage,
+    targetLanguage,
+    useStreaming,
+    (partial) => {
+      textNode.nodeValue = `${leading}${partial}${trailing}`;
+    },
+  );
+  textNode.nodeValue = `${leading}${translated}${trailing}`;
+}
+
+export interface TranslateScopeProgress {
+  completed: number;
+  total: number;
+}
+
+/**
+ * Translates all article and teaser elements within a container (or the entire document).
+ * Properly updates `lang` and `dir` attributes on translated parts per WCAG 3.1.2.
+ */
+export async function translateContainerElements(
+  translator: TranslatorInstance,
+  sourceLanguage: string,
+  targetLanguage: string,
+  container: ParentNode = document,
+  onProgress?: (progress: TranslateScopeProgress) => void,
+): Promise<number> {
+  const fieldElements = Array.from(
+    container.querySelectorAll<HTMLElement>('[data-translatable]'),
+  );
+  const bodyContainers = Array.from(
+    container.querySelectorAll<HTMLElement>('[data-translatable-body]'),
+  );
+
+  const bodyBlocks: HTMLElement[] = [];
+  for (const bodyContainer of bodyContainers) {
+    if (!originalLangStore.has(bodyContainer)) {
+      originalLangStore.set(bodyContainer, bodyContainer.getAttribute('lang'));
+    }
+    if (!originalDirStore.has(bodyContainer)) {
+      originalDirStore.set(bodyContainer, bodyContainer.getAttribute('dir'));
+    }
+    const blocks = Array.from(
+      bodyContainer.querySelectorAll<HTMLElement>(
+        'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption, td, th',
+      ),
+    );
+    if (blocks.length > 0) {
+      bodyBlocks.push(...blocks);
+    } else {
+      bodyBlocks.push(bodyContainer);
+    }
+  }
+
+  const total = fieldElements.length + bodyBlocks.length;
+  let completed = 0;
+  const targetDir = getLanguageDir(targetLanguage);
+
+  onProgress?.({ completed, total });
+
+  for (const el of fieldElements) {
+    const original = rememberElementOriginal(el);
+    if (original.trim()) {
+      const translated = await translateTextWithCache(
+        translator,
+        original,
+        sourceLanguage,
+        targetLanguage,
+        false,
+      );
+      el.textContent = translated;
+      el.setAttribute('lang', targetLanguage);
+      el.setAttribute('dir', targetDir);
+      el.setAttribute('data-translated-lang', targetLanguage);
+    }
+    completed += 1;
+    onProgress?.({ completed, total });
+  }
+
+  for (const block of bodyBlocks) {
+    if (!originalLangStore.has(block)) {
+      originalLangStore.set(block, block.getAttribute('lang'));
+    }
+    if (!originalDirStore.has(block)) {
+      originalDirStore.set(block, block.getAttribute('dir'));
+    }
+    const textNodes = collectTranslatableTextNodes(block);
+    if (textNodes.length === 1) {
+      // Single text node block (e.g., standard paragraph or heading): can stream smoothly
+      await translateTextNodePreservingFormatting(
+        translator,
+        textNodes[0],
+        sourceLanguage,
+        targetLanguage,
+        true,
+      );
+    } else {
+      for (const tNode of textNodes) {
+        await translateTextNodePreservingFormatting(
+          translator,
+          tNode,
+          sourceLanguage,
+          targetLanguage,
+          false,
+        );
+      }
+    }
+    block.setAttribute('lang', targetLanguage);
+    block.setAttribute('dir', targetDir);
+    block.setAttribute('data-translated-lang', targetLanguage);
+    completed += 1;
+    onProgress?.({ completed, total });
+  }
+
+  for (const bodyContainer of bodyContainers) {
+    bodyContainer.setAttribute('lang', targetLanguage);
+    bodyContainer.setAttribute('dir', targetDir);
+    bodyContainer.setAttribute('data-translated-lang', targetLanguage);
+  }
+
+  return total;
+}
+
+/**
+ * Restores all translated elements within a container (or the entire document) back to original text and language attributes.
+ */
+export function restoreContainerElements(
+  container: ParentNode = document,
+): void {
+  const fieldElements = Array.from(
+    container.querySelectorAll<HTMLElement>('[data-translatable]'),
+  );
+  for (const el of fieldElements) {
+    restoreElementOriginal(el);
+  }
+
+  const bodyContainers = Array.from(
+    container.querySelectorAll<HTMLElement>('[data-translatable-body]'),
+  );
+  for (const bodyContainer of bodyContainers) {
+    const blocks = Array.from(
+      bodyContainer.querySelectorAll<HTMLElement>(
+        'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption, td, th',
+      ),
+    );
+    const allTargets = blocks.length > 0 ? blocks : [bodyContainer];
+    for (const block of allTargets) {
+      const textNodes = collectTranslatableTextNodes(block);
+      for (const tNode of textNodes) {
+        const orig = originalNodeTextStore.get(tNode);
+        if (orig !== undefined) {
+          tNode.nodeValue = orig;
+        }
+      }
+      const origLang = originalLangStore.get(block);
+      if (origLang) {
+        block.setAttribute('lang', origLang);
+      } else {
+        block.removeAttribute('lang');
+      }
+      const origDir = originalDirStore.get(block);
+      if (origDir) {
+        block.setAttribute('dir', origDir);
+      } else {
+        block.removeAttribute('dir');
+      }
+      block.removeAttribute('data-translated-lang');
+    }
+
+    const origBodyLang = originalLangStore.get(bodyContainer);
+    if (origBodyLang) {
+      bodyContainer.setAttribute('lang', origBodyLang);
+    } else {
+      bodyContainer.removeAttribute('lang');
+    }
+    const origBodyDir = originalDirStore.get(bodyContainer);
+    if (origBodyDir) {
+      bodyContainer.setAttribute('dir', origBodyDir);
+    } else {
+      bodyContainer.removeAttribute('dir');
+    }
+    bodyContainer.removeAttribute('data-translated-lang');
+  }
+}
+
+export interface GlobalTranslationEventDetail {
+  sourceLanguage: string;
+  targetLanguage: string;
+  isTranslated: boolean;
+}
+
+export const GLOBAL_TRANSLATION_EVENT = 'devtools-times:translation-change';
+
+export function dispatchGlobalTranslationEvent(
+  detail: GlobalTranslationEventDetail,
+): void {
+  if (typeof window !== 'undefined') {
+    window.dispatchEvent(
+      new CustomEvent<GlobalTranslationEventDetail>(GLOBAL_TRANSLATION_EVENT, {
+        detail,
+      }),
+    );
+  }
+}
