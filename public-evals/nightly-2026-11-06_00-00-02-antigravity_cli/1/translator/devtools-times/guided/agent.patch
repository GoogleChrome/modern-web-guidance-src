diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..68bd3d5
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,1112 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import {
+  LanguageIcon,
+  ArrowsRightLeftIcon,
+  ArrowPathIcon,
+  SparklesIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import type { TranslatorAvailability } from '../../global';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkTranslatorAvailability,
+  getOrCreateTranslator,
+  detectTextLanguage,
+  translateContainerElements,
+  restoreContainerElements,
+  getLanguageName,
+  GLOBAL_TRANSLATION_EVENT,
+  dispatchGlobalTranslationEvent,
+  type GlobalTranslationEventDetail,
+} from '../utils/translator';
+
+export type TranslationControlVariant = 'header' | 'article' | 'teaser';
+
+export interface ArticleTranslationControlProps {
+  /**
+   * Visual and functional variant:
+   * - 'header': Compact control in the top navigation bar that translates all articles and teasers on the page.
+   * - 'article': Rich editorial control bar on an article detail page.
+   * - 'teaser': Compact per-teaser translation control.
+   */
+  variant?: TranslationControlVariant;
+  /**
+   * Optional CSS selector scoping which container to translate.
+   * If omitted:
+   * - 'teaser' scopes to the closest `[data-translation-scope]` ancestor
+   * - 'article' scopes to `[data-article-root]` (or `main` if not found)
+   * - 'header' scopes to `document`
+   */
+  scopeSelector?: string;
+  /**
+   * Optional context label (e.g., article title) to disambiguate multiple teaser controls for screen readers.
+   */
+  contextLabel?: string;
+  /**
+   * Default source language code (BCP 47). Defaults to 'en'.
+   */
+  defaultSourceLanguage?: string;
+  /**
+   * Default target language code (BCP 47). Defaults to 'es'.
+   */
+  defaultTargetLanguage?: string;
+}
+
+const STORAGE_SOURCE_KEY = 'dtt_translate_source_lang';
+const STORAGE_TARGET_KEY = 'dtt_translate_target_lang';
+
+export default function ArticleTranslationControl({
+  variant = 'article',
+  scopeSelector,
+  contextLabel,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+}: ArticleTranslationControlProps) {
+  const instanceId = useId();
+  const rootRef = useRef<HTMLDivElement>(null);
+  const popoverRef = useRef<HTMLDivElement>(null);
+
+  const [sourceLanguage, setSourceLanguage] = useState<string>(
+    defaultSourceLanguage,
+  );
+  const [targetLanguage, setTargetLanguage] = useState<string>(
+    defaultTargetLanguage,
+  );
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(false);
+  const [availability, setAvailability] =
+    useState<TranslatorAvailability>('available');
+
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isDetecting, setIsDetecting] = useState<boolean>(false);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [translatedTargetLang, setTranslatedTargetLang] = useState<
+    string | null
+  >(null);
+
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [elementsProgress, setElementsProgress] = useState<{
+    completed: number;
+    total: number;
+  } | null>(null);
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [isPopoverOpen, setIsPopoverOpen] = useState<boolean>(false);
+
+  const resolveScopeContainer = (): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      const explicit = document.querySelector(scopeSelector);
+      if (explicit) return explicit;
+    }
+    if (variant === 'teaser' && rootRef.current) {
+      const closestScope = rootRef.current.closest('[data-translation-scope]');
+      if (closestScope) return closestScope;
+    }
+    if (variant === 'article') {
+      if (rootRef.current) {
+        const closestScope = rootRef.current.closest(
+          '[data-translation-scope]',
+        );
+        if (closestScope) return closestScope;
+      }
+      const mainEl = document.querySelector('main');
+      if (mainEl) return mainEl;
+    }
+    return document;
+  };
+
+  // Initialize language preferences and feature detection on mount
+  useEffect(() => {
+    const supported = isTranslatorSupported();
+    setApiSupported(supported);
+    setDetectorSupported(isLanguageDetectorSupported());
+
+    try {
+      const savedSource = localStorage.getItem(STORAGE_SOURCE_KEY);
+      const savedTarget = localStorage.getItem(STORAGE_TARGET_KEY);
+      if (
+        savedSource &&
+        SUPPORTED_LANGUAGES.some((l) => l.code === savedSource)
+      ) {
+        setSourceLanguage(savedSource);
+      }
+      if (
+        savedTarget &&
+        SUPPORTED_LANGUAGES.some((l) => l.code === savedTarget)
+      ) {
+        setTargetLanguage(savedTarget);
+      } else if (typeof navigator !== 'undefined' && navigator.language) {
+        const browserLang = navigator.language.split('-')[0];
+        if (
+          browserLang &&
+          browserLang !== (savedSource || defaultSourceLanguage) &&
+          SUPPORTED_LANGUAGES.some((l) => l.code === browserLang)
+        ) {
+          setTargetLanguage(browserLang);
+        }
+      }
+    } catch {
+      // Ignore storage access errors
+    }
+  }, [defaultSourceLanguage]);
+
+  // Check Translator.availability({ sourceLanguage, targetLanguage }) whenever language pair changes
+  useEffect(() => {
+    let cancelled = false;
+    async function verifyAvailability() {
+      if (!isTranslatorSupported()) {
+        if (!cancelled) setAvailability('unavailable');
+        return;
+      }
+      if (sourceLanguage === targetLanguage) {
+        if (!cancelled) setAvailability('available');
+        return;
+      }
+      const status = await checkTranslatorAvailability({
+        sourceLanguage,
+        targetLanguage,
+      });
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    }
+    verifyAvailability();
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  // Synchronize with global page translation events
+  useEffect(() => {
+    const handleGlobalChange = (e: Event) => {
+      const customEvent = e as CustomEvent<GlobalTranslationEventDetail>;
+      if (!customEvent.detail) return;
+      const {
+        sourceLanguage: newSource,
+        targetLanguage: newTarget,
+        isTranslated: globalTranslated,
+      } = customEvent.detail;
+      setSourceLanguage(newSource);
+      setTargetLanguage(newTarget);
+      setIsTranslated(globalTranslated);
+      setTranslatedTargetLang(globalTranslated ? newTarget : null);
+      setErrorMessage(null);
+    };
+
+    window.addEventListener(GLOBAL_TRANSLATION_EVENT, handleGlobalChange);
+    return () => {
+      window.removeEventListener(GLOBAL_TRANSLATION_EVENT, handleGlobalChange);
+    };
+  }, []);
+
+  // Close popover on Escape or outside click
+  useEffect(() => {
+    if (!isPopoverOpen) return;
+
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        setIsPopoverOpen(false);
+      }
+    };
+    const handlePointerDown = (e: MouseEvent) => {
+      if (rootRef.current && !rootRef.current.contains(e.target as Node)) {
+        setIsPopoverOpen(false);
+      }
+    };
+
+    window.addEventListener('keydown', handleKeyDown);
+    window.addEventListener('mousedown', handlePointerDown);
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+      window.removeEventListener('mousedown', handlePointerDown);
+    };
+  }, [isPopoverOpen]);
+
+  const handleSourceLanguageChange = (newSource: string) => {
+    setSourceLanguage(newSource);
+    setErrorMessage(null);
+    try {
+      localStorage.setItem(STORAGE_SOURCE_KEY, newSource);
+    } catch {
+      // Ignore storage errors
+    }
+  };
+
+  const handleTargetLanguageChange = (newTarget: string) => {
+    setTargetLanguage(newTarget);
+    setErrorMessage(null);
+    try {
+      localStorage.setItem(STORAGE_TARGET_KEY, newTarget);
+    } catch {
+      // Ignore storage errors
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    const prevSource = sourceLanguage;
+    const prevTarget = targetLanguage;
+    handleSourceLanguageChange(prevTarget);
+    handleTargetLanguageChange(prevSource);
+  };
+
+  // User-gesture handler for LanguageDetector.create() & detect()
+  const handleDetectSourceLanguage = async () => {
+    setErrorMessage(null);
+    setStatusMessage(null);
+    const container = resolveScopeContainer();
+    if (!container) return;
+
+    const sampleNodes = Array.from(
+      container.querySelectorAll<HTMLElement>(
+        '[data-translatable], [data-translatable-body] p',
+      ),
+    );
+    const sampleText = sampleNodes
+      .slice(0, 4)
+      .map((el) => el.textContent?.trim() ?? '')
+      .filter(Boolean)
+      .join(' ');
+
+    if (sampleText.length < 12) {
+      setStatusMessage('Not enough text to automatically detect language.');
+      return;
+    }
+
+    setIsDetecting(true);
+    try {
+      const { detectedLanguage, confidence } = await detectTextLanguage(
+        sampleText,
+        sourceLanguage,
+        (pct) => setDownloadProgress(pct),
+      );
+      setDownloadProgress(null);
+      handleSourceLanguageChange(detectedLanguage);
+
+      // If detected language matches target language, pick a different target language automatically
+      if (detectedLanguage === targetLanguage) {
+        const fallbackTarget = detectedLanguage === 'en' ? 'es' : 'en';
+        handleTargetLanguageChange(fallbackTarget);
+      }
+
+      const pctConfidence = Math.round(confidence * 100);
+      setStatusMessage(
+        `Detected ${getLanguageName(detectedLanguage)} (${pctConfidence}% confidence).`,
+      );
+    } catch {
+      setErrorMessage('Could not detect article language on this device.');
+    } finally {
+      setIsDetecting(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  // User-gesture handler for Translator.create() & translate()
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+    setStatusMessage(null);
+
+    if (!apiSupported) {
+      setErrorMessage(
+        'Client-side translation is currently unsupported in this browser.',
+      );
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    const container = resolveScopeContainer();
+    if (!container) return;
+
+    setIsTranslating(true);
+    setDownloadProgress(null);
+    setElementsProgress(null);
+
+    try {
+      const translator = await getOrCreateTranslator(
+        {
+          sourceLanguage,
+          targetLanguage,
+        },
+        (pct) => {
+          setDownloadProgress(pct);
+        },
+      );
+
+      setDownloadProgress(null);
+
+      await translateContainerElements(
+        translator,
+        sourceLanguage,
+        targetLanguage,
+        container,
+        (progress) => {
+          setElementsProgress(progress);
+        },
+      );
+
+      setIsTranslated(true);
+      setTranslatedTargetLang(targetLanguage);
+      setStatusMessage(
+        `Translated to ${getLanguageName(targetLanguage)} on-device.`,
+      );
+
+      if (variant === 'header') {
+        dispatchGlobalTranslationEvent({
+          sourceLanguage,
+          targetLanguage,
+          isTranslated: true,
+        });
+      }
+    } catch (err: any) {
+      const message =
+        err instanceof Error
+          ? err.message
+          : 'Unable to complete on-device translation.';
+      setErrorMessage(message);
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+      setElementsProgress(null);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    setErrorMessage(null);
+    const container = resolveScopeContainer();
+    if (!container) return;
+
+    restoreContainerElements(container);
+    setIsTranslated(false);
+    setTranslatedTargetLang(null);
+    setStatusMessage(`Restored original (${getLanguageName(sourceLanguage)}).`);
+
+    if (variant === 'header') {
+      dispatchGlobalTranslationEvent({
+        sourceLanguage,
+        targetLanguage,
+        isTranslated: false,
+      });
+    }
+  };
+
+  const sourceSelectId = `${instanceId}-source-lang`;
+  const targetSelectId = `${instanceId}-target-lang`;
+  const statusId = `${instanceId}-status`;
+
+  const availabilityBadge = () => {
+    if (!apiSupported) {
+      return (
+        <span className="inline-flex items-center gap-1 rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 border border-amber-200">
+          <ExclamationTriangleIcon
+            className="w-3.5 h-3.5 text-amber-600 shrink-0"
+            aria-hidden="true"
+          />
+          Browser unsupported
+        </span>
+      );
+    }
+    if (availability === 'unavailable') {
+      return (
+        <span className="inline-flex items-center gap-1 rounded bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 border border-red-200">
+          Pair unavailable
+        </span>
+      );
+    }
+    if (availability === 'downloadable' || availability === 'downloading') {
+      return (
+        <span className="inline-flex items-center gap-1 rounded bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700 border border-blue-200">
+          Model download required
+        </span>
+      );
+    }
+    return (
+      <span className="inline-flex items-center gap-1 rounded bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">
+        <SparklesIcon
+          className="w-3.5 h-3.5 text-emerald-600 shrink-0"
+          aria-hidden="true"
+        />
+        On-device AI ready
+      </span>
+    );
+  };
+
+  const isTranslateDisabled =
+    !apiSupported ||
+    isTranslating ||
+    availability === 'unavailable' ||
+    sourceLanguage === targetLanguage;
+
+  // Compact Teaser Variant
+  if (variant === 'teaser') {
+    const disambiguatedSuffix = contextLabel ? `: ${contextLabel}` : '';
+    return (
+      <div
+        ref={rootRef}
+        data-no-translate="true"
+        className="relative inline-flex items-center"
+      >
+        <div className="inline-flex items-center gap-1">
+          <button
+            type="button"
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+              setIsPopoverOpen((prev) => !prev);
+            }}
+            aria-expanded={isPopoverOpen}
+            className={`inline-flex items-center gap-1 px-2 py-1 min-h-6 rounded text-xs font-medium transition-colors border ${
+              isTranslated
+                ? 'bg-amber-50 text-amber-900 border-amber-300 hover:bg-amber-100'
+                : 'bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100 hover:text-gray-900'
+            }`}
+          >
+            <LanguageIcon className="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
+            <span>
+              {isTranslated && translatedTargetLang
+                ? `Translated (${translatedTargetLang.toUpperCase()})`
+                : 'Translate'}
+            </span>
+            {disambiguatedSuffix && (
+              <span className="sr-only">{disambiguatedSuffix}</span>
+            )}
+          </button>
+
+          {isTranslated && (
+            <button
+              type="button"
+              onClick={(e) => {
+                e.preventDefault();
+                e.stopPropagation();
+                handleRestoreOriginal();
+              }}
+              className="inline-flex items-center px-1.5 py-1 min-h-6 rounded text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors"
+            >
+              <span>Reset</span>
+              {disambiguatedSuffix && (
+                <span className="sr-only">{disambiguatedSuffix}</span>
+              )}
+            </button>
+          )}
+        </div>
+
+        {isPopoverOpen && (
+          <div
+            ref={popoverRef}
+            role="dialog"
+            aria-label={`Translate teaser${disambiguatedSuffix}`}
+            onClick={(e) => e.stopPropagation()}
+            className="absolute bottom-full right-0 mb-2 w-72 rounded-lg bg-white p-3 shadow-xl border border-gray-200 z-30 text-left"
+          >
+            <div className="flex items-center justify-between gap-2 pb-2 mb-2 border-b border-gray-100">
+              <span className="text-xs font-semibold text-gray-800 flex items-center gap-1">
+                <LanguageIcon
+                  className="w-4 h-4 text-amber-600 shrink-0"
+                  aria-hidden="true"
+                />
+                On-Device Teaser Translator
+              </span>
+              <button
