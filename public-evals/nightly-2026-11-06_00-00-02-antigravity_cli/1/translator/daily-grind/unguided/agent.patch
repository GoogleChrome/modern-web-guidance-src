+            el.setAttribute('lang', targetLanguage);
+          }
+        });
+        document.documentElement.lang = targetLanguage;
+        currentLanguage = targetLanguage;
+        return true;
+      }
+
+      function restoreOriginalEnglish() {
+        translatableElements.forEach((el) => {
+          if (el.dataset.originalText) {
+            el.textContent = el.dataset.originalText;
+          }
+          el.setAttribute('lang', 'en');
+        });
+        document.documentElement.lang = 'en';
+        currentLanguage = 'en';
+      }
+
+      async function createOnDeviceTranslator(sourceLanguage, targetLanguage, requestId) {
+        const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+        if (translatorCache.has(cacheKey)) {
+          return { translator: translatorCache.get(cacheKey), availability: 'available' };
+        }
+
+        // Standard Web Built-in AI Translator API ('Translator' in self)
+        if ('Translator' in self && typeof self.Translator?.availability === 'function') {
+          const availability = await self.Translator.availability({
+            sourceLanguage,
+            targetLanguage
+          });
+
+          if (availability === 'unavailable' || availability === 'no') {
+            return { translator: null, availability: 'unavailable' };
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading' || availability === 'after-download') {
+            statusEl.textContent = `Downloading on-device ${LANGUAGE_NAMES[targetLanguage] || targetLanguage} language model...`;
+            setProgress(0, true);
+          }
+
+          const translator = await self.Translator.create({
+            sourceLanguage,
+            targetLanguage,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (requestId !== activeRequestId) return;
+                const ratio = (e.total && e.total > 0) ? (e.loaded / e.total) : (typeof e.loaded === 'number' ? e.loaded : 0);
+                const percent = Math.round(Math.min(1, Math.max(0, ratio)) * 100);
+                setProgress(percent, true);
+                statusEl.textContent = `Downloading on-device language pack: ${percent}%`;
+              });
+            }
+          });
+
+          translatorCache.set(cacheKey, translator);
+          return { translator, availability };
+        }
+
+        // Legacy Chrome Built-in AI namespace fallback (self.ai.translator / self.translation)
+        const legacyFactory = self.ai?.translator || self.translation;
+        if (legacyFactory) {
+          const createFn = legacyFactory.create || legacyFactory.createTranslator;
+          if (typeof createFn === 'function') {
+            const translator = await createFn.call(legacyFactory, {
+              sourceLanguage,
+              targetLanguage,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  if (requestId !== activeRequestId) return;
+                  const ratio = (e.total && e.total > 0) ? (e.loaded / e.total) : (typeof e.loaded === 'number' ? e.loaded : 0);
+                  setProgress(Math.round(ratio * 100), true);
+                });
+              }
+            });
+            translatorCache.set(cacheKey, translator);
+            return { translator, availability: 'available' };
+          }
+        }
+
+        return { translator: null, availability: 'unsupported' };
+      }
+
+      async function translatePage(targetLanguage) {
+        const requestId = ++activeRequestId;
+        setProgress(0, false);
+
+        if (targetLanguage === 'en') {
+          restoreOriginalEnglish();
+          statusEl.textContent = 'Showing original English text.';
+          return;
+        }
+
+        const sourceLanguage = 'en';
+        const languageLabel = LANGUAGE_NAMES[targetLanguage] || targetLanguage;
+
+        translatableElements.forEach((el) => el.classList.add('translating'));
+        statusEl.textContent = `Checking on-device model availability for ${languageLabel}...`;
+
+        try {
+          const { translator, availability } = await createOnDeviceTranslator(
+            sourceLanguage,
+            targetLanguage,
+            requestId
+          );
+
+          if (requestId !== activeRequestId) return;
+
+          if (!translator) {
+            setProgress(0, false);
+            const usedFallback = applyFallbackTranslation(targetLanguage);
+            if (availability === 'unavailable') {
+              statusEl.textContent = usedFallback
+                ? `On-device model unavailable for ${languageLabel} — translated using built-in offline dictionary.`
+                : `On-device translation is unavailable for ${languageLabel}.`;
+            } else {
+              statusEl.textContent = usedFallback
+                ? `Translated to ${languageLabel} (on-device offline pack).`
+                : `On-device Translator API is not supported in this browser.`;
+            }
+            return;
+          }
+
+          setProgress(100, false);
+          statusEl.textContent = `Translating menu descriptions and story to ${languageLabel} on-device...`;
+
+          for (const el of translatableElements) {
+            if (requestId !== activeRequestId) return;
+            const sourceText = el.dataset.originalText || el.textContent.trim();
+            const translatedText = await translator.translate(sourceText);
+            if (requestId !== activeRequestId) return;
+            if (translatedText) {
+              el.textContent = translatedText;
+              el.setAttribute('lang', targetLanguage);
+            }
+          }
+
+          document.documentElement.lang = targetLanguage;
+          currentLanguage = targetLanguage;
+          statusEl.textContent = `Translated to ${languageLabel} on-device directly in your browser.`;
+        } catch (err) {
+          if (requestId !== activeRequestId) return;
+          setProgress(0, false);
+          const usedFallback = applyFallbackTranslation(targetLanguage);
+          statusEl.textContent = usedFallback
+            ? `Translated to ${languageLabel} using local fallback (on-device model error: ${err?.message || 'unavailable'}).`
+            : `Failed to translate to ${languageLabel}: ${err?.message || 'Unknown error'}.`;
+        } finally {
+          if (requestId === activeRequestId) {
+            translatableElements.forEach((el) => el.classList.remove('translating'));
+          }
+        }
+      }
+
+      languageSelect.addEventListener('change', (event) => {
+        translatePage(event.target.value);
+      });
+
+      window.addEventListener('pagehide', () => {
+        for (const translator of translatorCache.values()) {
+          if (typeof translator?.destroy === 'function') {
+            translator.destroy();
+          }
+        }
+        translatorCache.clear();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
