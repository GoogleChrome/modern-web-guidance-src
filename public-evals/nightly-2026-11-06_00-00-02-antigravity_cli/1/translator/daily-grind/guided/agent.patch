+  <script>
+    (function () {
+      const languageSelect = document.getElementById('target-language');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const statusEl = document.getElementById('translation-status');
+      const progressEl = document.getElementById('translation-progress');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English source strings so visitors can translate between any languages cleanly
+      const originalTexts = translatableElements.map((el) => el.textContent.trim());
+      let currentLanguage = 'en';
+
+      function setStatus(message, showProgress = false, progressPercent = 0) {
+        statusEl.textContent = message;
+        progressEl.hidden = !showProgress;
+        if (showProgress) {
+          progressEl.value = progressPercent;
+        }
+      }
+
+      function restoreEnglish() {
+        translatableElements.forEach((el, index) => {
+          el.textContent = originalTexts[index];
+          el.setAttribute('lang', 'en');
+        });
+        currentLanguage = 'en';
+        setStatus('Showing original English text.');
+      }
+
+      // Feature detection exclusively via global Translator in self/window
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      async function checkTargetAvailability(targetLanguage) {
+        if (targetLanguage === 'en') {
+          translateBtn.disabled = false;
+          setStatus('Ready to restore original English text.');
+          return 'available';
+        }
+
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        try {
+          const availability = await Translator.availability(options);
+          if (availability === 'unavailable') {
+            translateBtn.disabled = true;
+            setStatus(`Translation model for "${targetLanguage}" is unavailable on this device.`);
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            translateBtn.disabled = false;
+            setStatus(`Language pack (${targetLanguage}) is ${availability}. Click "Translate On-Device" to download and translate.`);
+          } else if (availability === 'available') {
+            translateBtn.disabled = false;
+            setStatus(`Language model (${targetLanguage}) is available on-device.`);
+          }
+          return availability;
+        } catch (err) {
+          translateBtn.disabled = true;
+          setStatus('Unable to check language model availability on this device.');
+          return 'unavailable';
+        }
+      }
+
+      async function runTranslation(targetLanguage, fromUserGesture) {
+        if (targetLanguage === 'en') {
+          restoreEnglish();
+          return;
+        }
+
+        // Identical options object passed to both Translator.availability(options) and Translator.create(options)
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        try {
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            translateBtn.disabled = true;
+            setStatus(`Translation model for "${targetLanguage}" is unavailable on this device.`);
+            return;
+          }
+
+          if ((availability === 'downloadable' || availability === 'downloading') && !fromUserGesture) {
+            // Strictly requires a user gesture (button click) to prevent NotAllowedError
+            translateBtn.disabled = false;
+            setStatus(`Click "Translate On-Device" to download the "${targetLanguage}" model and translate.`);
+            return;
+          }
+
+          translateBtn.disabled = true;
+          languageSelect.disabled = true;
+          setStatus(`Preparing on-device translator (${targetLanguage})...`, availability !== 'available', 0);
+
+          const translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded || 0) * 100);
+                setStatus(`Downloading language model: ${percent}%`, true, percent);
+              });
+            },
+          });
+
+          setStatus(`Translating coffee menu and story to "${targetLanguage}"...`, false);
+
+          for (let i = 0; i < translatableElements.length; i++) {
+            const el = translatableElements[i];
+            const sourceText = originalTexts[i];
+            if (sourceText.length > 120 && typeof translator.translateStreaming === 'function') {
+              const stream = translator.translateStreaming(sourceText);
+              let translated = '';
+              for await (const chunk of stream) {
+                translated += chunk;
+                el.textContent = translated;
+              }
+            } else {
+              const result = await translator.translate(sourceText);
+              el.textContent = result;
+            }
+            el.setAttribute('lang', targetLanguage);
+          }
+
+          currentLanguage = targetLanguage;
+          setStatus(`Translated on-device to ${languageSelect.options[languageSelect.selectedIndex].text}.`, false);
+        } catch (error) {
+          console.warn('On-device translation failed:', error);
+          setStatus('On-device translation could not be completed on this device.', false);
+        } finally {
+          languageSelect.disabled = false;
+          translateBtn.disabled = false;
+        }
+      }
+
+      languageSelect.addEventListener('change', async () => {
+        const targetLanguage = languageSelect.value;
+        const availability = await checkTargetAvailability(targetLanguage);
+        if (targetLanguage === 'en') {
+          restoreEnglish();
+        } else if (availability === 'available') {
+          // Model is already on-device; translate immediately or on click
+          await runTranslation(targetLanguage, true);
+        }
+      });
+
+      translateBtn.addEventListener('click', async () => {
+        const targetLanguage = languageSelect.value;
+        await runTranslation(targetLanguage, true);
+      });
+    })();
+  </script>
 </body>
 
