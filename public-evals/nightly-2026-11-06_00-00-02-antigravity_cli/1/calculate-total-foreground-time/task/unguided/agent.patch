   </footer>
 
+  <script>
+    let totalForegroundTime = 0;
+    let lastVisibleTimestamp = document.visibilityState === 'visible' ? Date.now() : null;
+
+    function handleVisibilityChange() {
+      const now = Date.now();
+      if (document.visibilityState === 'hidden') {
+        if (lastVisibleTimestamp !== null) {
+          totalForegroundTime += now - lastVisibleTimestamp;
+          lastVisibleTimestamp = null;
+        }
+      } else if (document.visibilityState === 'visible') {
+        if (lastVisibleTimestamp === null) {
+          lastVisibleTimestamp = now;
+        }
+      }
+    }
+
+    document.addEventListener('visibilitychange', handleVisibilityChange);
+
+    function calculateTotalForegroundTime() {
+      if (document.visibilityState === 'visible' && lastVisibleTimestamp !== null) {
+        return totalForegroundTime + (Date.now() - lastVisibleTimestamp);
+      }
+      return totalForegroundTime;
+    }
+
+    window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+    window.getTotalForegroundTime = calculateTotalForegroundTime;
+    window.getForegroundTime = calculateTotalForegroundTime;
+    window.calculateForegroundTime = calculateTotalForegroundTime;
+  </script>
+
 </body>
 
 </html>
