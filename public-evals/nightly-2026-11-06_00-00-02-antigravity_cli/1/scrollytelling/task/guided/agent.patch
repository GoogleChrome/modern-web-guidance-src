+
+    #tracked section h3 {
+      color: var(--primary);
+      font-size: 1.5rem;
+      margin-bottom: 12px;
+    }
+
+    #animated {
+      display: grid;
+      grid-template-columns: 1fr;
+      gap: 20px;
+    }
+
+    #animated section {
+      background: white;
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
+    }
+
+    #animated section img {
+      width: 100%;
+      height: 280px;
+      object-fit: cover;
+      display: block;
+    }
+
+    #animated section .visual-caption {
+      padding: 20px;
+      text-align: center;
+    }
+
+    #animated section .visual-caption h4 {
+      color: var(--primary);
+      font-size: 1.25rem;
+      margin-bottom: 6px;
+    }
+
+    @keyframes animate-in {
+      from {
+        scale: 0.5;
+        opacity: 0;
+        transform: rotateY(-180deg);
+      }
+      to {
+        scale: 1;
+        opacity: 1;
+        transform: rotateY(0deg);
+      }
+    }
+
+    @keyframes animate-out {
+      to {
+        translate: 100% 0;
+        opacity: 0;
+      }
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      @media (prefers-reduced-motion: no-preference) {
+        html {
+          timeline-scope: --tl-1, --tl-2, --tl-3, --tl-4, --tl-5;
+        }
+
+        #tracked {
+          section:nth-child(1) { view-timeline: --tl-1 block; }
+          section:nth-child(2) { view-timeline: --tl-2 block; }
+          section:nth-child(3) { view-timeline: --tl-3 block; }
+          section:nth-child(4) { view-timeline: --tl-4 block; }
+          section:nth-child(5) { view-timeline: --tl-5 block; }
+        }
+
+        #animated {
+          position: sticky;
+          top: 15vh;
+          min-height: 70vh;
+          place-items: center;
+          overflow: hidden;
+          perspective: 1000px;
+
+          section {
+            grid-area: 1 / 1;
+            width: 100%;
+            animation: animate-in auto linear both, animate-out auto linear forwards;
+            animation-range: entry 25% cover 50%, exit 50% exit 75%;
+            backface-visibility: hidden;
+          }
+
+          section:nth-child(1) { animation-timeline: --tl-1; }
+          section:nth-child(2) { animation-timeline: --tl-2; }
+          section:nth-child(3) { animation-timeline: --tl-3; }
+          section:nth-child(4) { animation-timeline: --tl-4; }
+          section:nth-child(5) { animation-timeline: --tl-5; }
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #animated section {
+        animation: none !important;
+        opacity: 1 !important;
+        transform: none !important;
+        translate: 0 0 !important;
+      }
+    }
+
+    @media (max-width: 768px) {
+      .scrollytelling-layout {
+        grid-template-columns: 1fr;
+      }
+    }
+
