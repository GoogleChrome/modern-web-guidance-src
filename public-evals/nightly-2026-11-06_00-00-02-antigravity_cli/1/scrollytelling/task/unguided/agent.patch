+    }
+
+    .step-badge {
+      display: inline-block;
+      align-self: flex-start;
+      background: var(--secondary);
+      color: var(--primary);
+      font-weight: bold;
+      font-size: 0.8rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      padding: 4px 12px;
+      border-radius: 20px;
+      margin-bottom: 12px;
+    }
+
+    #tracked section h3 {
+      font-size: 1.6rem;
+      color: var(--primary);
+      margin-bottom: 12px;
+    }
+
+    #animated {
+      position: sticky;
+      top: 100px;
+      height: calc(100vh - 140px);
+      min-height: 420px;
+      max-height: 640px;
+      display: grid;
+      grid-template-areas: "stack";
+      border-radius: 16px;
+      overflow: hidden;
+      box-shadow: 0 12px 32px rgba(62, 39, 35, 0.18);
+      background: var(--primary);
+    }
+
+    #animated section {
+      grid-area: stack;
+      position: relative;
+      width: 100%;
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      justify-content: flex-end;
+      padding: 32px;
+      color: white;
+      opacity: 0;
+      transform: translateY(24px) scale(0.96);
+      will-change: opacity, transform;
+      animation: reveal-section linear both;
+    }
+
+    #animated section:nth-child(1) {
+      animation-timeline: --section-1;
+      animation-range: entry 10% exit 90%;
+    }
+
+    #animated section:nth-child(2) {
+      animation-timeline: --section-2;
+      animation-range: entry 10% exit 90%;
+    }
+
+    #animated section:nth-child(3) {
+      animation-timeline: --section-3;
+      animation-range: entry 10% exit 90%;
+    }
+
+    #animated section:nth-child(4) {
+      animation-timeline: --section-4;
+      animation-range: entry 10% exit 90%;
+    }
+
+    @keyframes reveal-section {
+      0% {
+        opacity: 0;
+        transform: translateY(24px) scale(0.96);
+      }
+      25%, 75% {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+      }
+      100% {
+        opacity: 0;
+        transform: translateY(-24px) scale(1.03);
+      }
+    }
+
+    #animated section img {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      z-index: 0;
+    }
+
+    #animated section::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(to top, rgba(30, 18, 15, 0.85) 0%, rgba(30, 18, 15, 0.2) 60%, transparent 100%);
+      z-index: 1;
+    }
+
+    .animated-caption {
+      position: relative;
+      z-index: 2;
+    }
+
+    .animated-caption h4 {
+      font-size: 1.5rem;
+      margin-bottom: 6px;
+      color: var(--accent);
+    }
+
+    @media (max-width: 768px) {
+      .scrollytelling-content {
+        grid-template-columns: 1fr;
+      }
+
+      #animated {
+        position: sticky;
+        top: 70px;
+        height: 45vh;
+        min-height: 280px;
+        order: -1;
+        z-index: 10;
+      }
+    }
+
