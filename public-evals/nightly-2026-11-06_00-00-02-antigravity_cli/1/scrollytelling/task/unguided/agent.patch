+    }
+
+    #tracked section:nth-child(1) {
+      view-timeline-name: --section-1;
+      view-timeline-axis: block;
+    }
+
+    #tracked section:nth-child(2) {
+      view-timeline-name: --section-2;
+      view-timeline-axis: block;
+    }
+
