+    /* Scrollytelling Section (Pure CSS Scroll-Driven Animations) */
+    .scrollytelling {
+      margin-top: 60px;
+      timeline-scope: --section-1, --section-2, --section-3, --section-4;
+    }
+
+    .scrollytelling-header {
+      text-align: center;
+      margin-bottom: 40px;
+    }
+
