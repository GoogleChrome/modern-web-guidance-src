+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    toggleBtn?.addEventListener('click', () => {
+      const currentDensity = targetContainer.style.getPropertyValue('--density').trim();
+      const isSpacious = currentDensity === 'spacious';
+      if (isSpacious) {
+        targetContainer.style.removeProperty('--density');
+        toggleBtn.setAttribute('aria-pressed', 'false');
+      } else {
+        targetContainer.style.setProperty('--density', 'spacious');
+        toggleBtn.setAttribute('aria-pressed', 'true');
+      }
+    });
+  </script>
