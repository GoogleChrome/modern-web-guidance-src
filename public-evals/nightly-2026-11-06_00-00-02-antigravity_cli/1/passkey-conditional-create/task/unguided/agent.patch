+  <script>
+    function base64UrlToUint8Array(val) {
+      if (val instanceof ArrayBuffer) return new Uint8Array(val);
+      if (ArrayBuffer.isView(val)) return new Uint8Array(val.buffer, val.byteOffset, val.byteLength);
+      if (Array.isArray(val)) return new Uint8Array(val);
+      if (typeof val === 'string') {
+        try {
+          const base64 = val.replace(/-/g, '+').replace(/_/g, '/');
+          const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
+          const binary = atob(padded);
+          const bytes = new Uint8Array(binary.length);
+          for (let i = 0; i < binary.length; i++) {
+            bytes[i] = binary.charCodeAt(i);
+          }
+          return bytes;
+        } catch {
+          return new TextEncoder().encode(val);
+        }
+      }
+      return new Uint8Array();
+    }
+
+    function bufferToBase64Url(buf) {
+      if (!buf) return buf;
+      if (typeof buf === 'string') return buf;
+      const bytes = buf instanceof ArrayBuffer
+        ? new Uint8Array(buf)
+        : ArrayBuffer.isView(buf)
+          ? new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength)
+          : Array.isArray(buf)
+            ? new Uint8Array(buf)
+            : null;
+      if (!bytes) return buf;
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function preparePublicKeyOptions(rawOptions) {
+      const opts = rawOptions && rawOptions.publicKey ? rawOptions.publicKey : rawOptions;
+      if (!opts || typeof opts !== 'object') return opts;
+
+      const publicKey = { ...opts };
+
+      if (publicKey.challenge !== undefined) {
+        publicKey.challenge = base64UrlToUint8Array(publicKey.challenge);
+      }
+
+      if (publicKey.user && typeof publicKey.user === 'object') {
+        publicKey.user = {
+          ...publicKey.user,
+          id: publicKey.user.id !== undefined
+            ? base64UrlToUint8Array(publicKey.user.id)
+            : new Uint8Array(),
+        };
+      }
+
+      if (Array.isArray(publicKey.excludeCredentials)) {
+        publicKey.excludeCredentials = publicKey.excludeCredentials.map((cred) => ({
+          ...cred,
+          id: cred.id !== undefined ? base64UrlToUint8Array(cred.id) : cred.id,
+        }));
+      }
+
+      return publicKey;
+    }
+
+    function serializeCredential(cred) {
+      if (!cred) return null;
+      if (typeof cred.toJSON === 'function') {
+        return cred.toJSON();
+      }
+      const response = cred.response || {};
+      return {
+        ...cred,
+        id: cred.id,
+        rawId: bufferToBase64Url(cred.rawId ?? cred.id),
+        type: cred.type || 'public-key',
+        authenticatorAttachment: cred.authenticatorAttachment,
+        clientExtensionResults:
+          typeof cred.getClientExtensionResults === 'function'
+            ? cred.getClientExtensionResults()
+            : cred.clientExtensionResults || {},
+        response: {
+          ...response,
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          attestationObject: bufferToBase64Url(response.attestationObject),
+          transports:
+            typeof response.getTransports === 'function'
+              ? response.getTransports()
+              : response.transports,
+        },
+      };
+    }
+
+    async function silentlyPromotePasskey(username) {
+      try {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+          !navigator.credentials ||
+          typeof navigator.credentials.create !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) {
+          return;
+        }
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username }),
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const rawOptions = await optionsResponse.json();
+        const publicKey = preparePublicKeyOptions(rawOptions);
+
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+
+        if (!credential) {
+          return;
+        }
+
+        await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(serializeCredential(credential)),
+        });
+      } catch {
+        // Silently ignore errors in background conditional passkey creation without any UI
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    if (signinForm) {
+      signinForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const usernameInput = document.getElementById('username');
+        const username = usernameInput ? usernameInput.value.trim() : '';
+        await silentlyPromotePasskey(username);
+      });
+    }
+  </script>
