+  <script type="module">
+    import('webauthn-polyfills').catch(() => {});
+
+    (function () {
+      const loginAbortController = new AbortController();
+
+      const form = document.getElementById('signin-form');
+      const emailInput = document.getElementById('email');
+      const passwordInput = document.getElementById('current-password');
+      const togglePasswordBtn = document.getElementById('toggle-password');
+      const signinBtn = document.querySelector('[data-testid="signin-button"]');
+
+      if (togglePasswordBtn && passwordInput) {
+        togglePasswordBtn.addEventListener('click', () => {
+          const isHidden = passwordInput.type === 'password';
+          passwordInput.type = isHidden ? 'text' : 'password';
+          togglePasswordBtn.setAttribute('aria-pressed', String(isHidden));
+          togglePasswordBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
+          togglePasswordBtn.textContent = isHidden ? 'Hide' : 'Show';
+        });
+      }
+
+      async function triggerConditionalCreate(abortController) {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) {
+          return;
+        }
+
+        // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+        if (abortController) {
+          abortController.abort();
+        }
+
+        // 2. Fetch creation options signaling the backend that this is a conditional request
+        let creationOptionsJSON;
+        try {
+          const optionsRes = await fetch('/api/register/options', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ conditional: true })
+          });
+          if (!optionsRes.ok) {
+            return;
+          }
+          creationOptionsJSON = await optionsRes.json();
+        } catch (err) {
+          return;
+        }
+
+        const rawOptions = creationOptionsJSON && creationOptionsJSON.publicKey ? creationOptionsJSON.publicKey : creationOptionsJSON;
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions);
+
+        let credential;
+        try {
+          // 3. Invoke silent credentials creation prompt
+          credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional'
+          });
+        } catch (e) {
+          // 4. Silently swallow common WebAuthn browser exceptions
+          if (e && ['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+            return;
+          }
+          console.error('Unexpected conditional create error:', e);
+          return;
+        }
+
+        if (!credential) {
+          return;
+        }
+
+        // 5. Server verification step using dedicated Try/Catch block
+        const encodedResponse = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+        const rpId = (publicKey && publicKey.rp && publicKey.rp.id) || (rawOptions && rawOptions.rp && rawOptions.rp.id);
+
+        try {
+          const verifyRes = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedResponse)
+          });
+          if (!verifyRes.ok) {
+            if (PublicKeyCredential.signalUnknownCredential && rpId) {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+                credentialId: encodedResponse.id
+              });
+            }
+          }
+        } catch (serverErr) {
+          console.error('Verification network failure:', serverErr);
+          if (PublicKeyCredential.signalUnknownCredential && rpId) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      }
+
+      if (form) {
+        form.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          if (signinBtn) {
+            signinBtn.disabled = true;
+          }
+
+          try {
+            // Attempt password login endpoint if available; proceed gracefully when running standalone
+            try {
+              const loginRes = await fetch(form.action, {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({
+                  email: emailInput ? emailInput.value : '',
+                  password: passwordInput ? passwordInput.value : ''
+                })
+              });
+              // Only halt if an explicit auth failure status is returned
+              if (loginRes.status === 401 || loginRes.status === 403) {
+                return;
+              }
+            } catch (_) {
+              // Proceed with post-login conditional passkey creation in standalone environments
+            }
+
+            await triggerConditionalCreate(loginAbortController);
+          } finally {
+            if (signinBtn) {
+              signinBtn.disabled = false;
+            }
+          }
+        });
+      }
+    })();
+  </script>
