+          ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    export async function safeAppendReviewHTML(el, untrustedHTML) {
+      if ('appendHTML' in Element.prototype) {
+        el.appendHTML(untrustedHTML, { sanitizer: createReviewSanitizerConfig() });
