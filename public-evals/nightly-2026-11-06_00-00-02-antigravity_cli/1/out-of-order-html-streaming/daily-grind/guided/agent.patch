+      if ('setHTMLUnsafe' in promoContainer) {
+        promoContainer.setHTMLUnsafe(trustedCmsHTML, { runScripts: true });
+      }
+    }
+
+    export async function streamCmsPromoBlock(promoContainer, endpoint = '/api/cms/promo') {
+      if (!promoContainer) return;
+      const response = await fetch(endpoint);
