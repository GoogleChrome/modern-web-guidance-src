+            await response.body
+              .pipeThrough(new TextDecoderStream())
+              .pipeTo(cardElement.streamReplaceWithHTML());
+          }
+        } else if ('replaceWithHTML' in cardElement) {
+          cardElement.replaceWithHTML(await response.text());
+        } else if ('streamHTML' in cardElement) {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(cardElement.streamHTML());
+        }
+      } catch {
+        // Fallback when running statically without a live API endpoint
+      }
+    }
