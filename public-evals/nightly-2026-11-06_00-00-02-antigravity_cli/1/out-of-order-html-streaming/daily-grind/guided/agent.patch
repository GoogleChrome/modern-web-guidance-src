+  <script type="module">
+    // 1. Load Polyfills for Out-of-Order HTML Streaming & HTML Setters when native support is missing
+    if (!('for' in HTMLTemplateElement.prototype)) {
+      try {
+        await import('template-for-polyfill');
+      } catch {
+        // Fallback for environments where bare module specifiers are not bundled
+        applyDeclarativeTemplatesFallback();
+      }
+    }
+
+    if (!('streamHTML' in Element.prototype) || !('setHTML' in Element.prototype)) {
+      try {
+        await import('html-setters-polyfill');
+      } catch {
+        // Fallback handled via feature detection in helper functions below
+      }
+    }
+
+    function applyDeclarativeTemplatesFallback() {
+      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_COMMENT);
+      const startComments = new Map();
+      const markerComments = new Map();
+      let current;
+      while ((current = walker.nextNode())) {
+        const text = current.nodeValue.trim();
+        const startMatch = text.match(/^\?start\s+name="([^"]+)"$/);
+        if (startMatch) startComments.set(startMatch[1], current);
+        const markerMatch = text.match(/^\?marker\s+name="([^"]+)"$/);
+        if (markerMatch) markerComments.set(markerMatch[1], current);
+      }
+
+      document.querySelectorAll('template[for]').forEach((tpl) => {
+        const targetName = tpl.getAttribute('for');
+        const startNode = startComments.get(targetName);
+        if (startNode && startNode.parentNode) {
+          const nodesToRemove = [];
+          let sibling = startNode.nextSibling;
+          while (sibling) {
+            if (sibling.nodeType === Node.COMMENT_NODE && sibling.nodeValue.trim().startsWith('?end')) {
+              nodesToRemove.push(sibling);
+              break;
+            }
+            nodesToRemove.push(sibling);
+            sibling = sibling.nextSibling;
+          }
+          nodesToRemove.forEach((n) => n.remove());
+          startNode.replaceWith(tpl.content.cloneNode(true));
+          tpl.remove();
+        } else if (markerComments.has(targetName)) {
+          markerComments.get(targetName).replaceWith(tpl.content.cloneNode(true));
+          tpl.remove();
+        }
+      });
+    }
+
+    // 2. Sanitizer Configuration & Safe HTML Insertion for Untrusted Customer Reviews
+    const REVIEW_ELEMENTS = ['blockquote', 'p', 'b', 'i', 'strong', 'em', 'span', 'cite'];
+    const REVIEW_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    function createReviewSanitizerConfig() {
+      const config = {
+        elements: REVIEW_ELEMENTS,
+        attributes: REVIEW_ATTRIBUTES
+      };
+      return 'Sanitizer' in window ? new Sanitizer(config) : config;
+    }
+
+    export async function safeSetReviewHTML(el, untrustedHTML) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(untrustedHTML, { sanitizer: createReviewSanitizerConfig() });
+      } else {
