+    </div>
+  </template>
+
+  <script>
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const seasonalCards = document.getElementById('seasonal-cards');
+    const menuSelect = document.getElementById('seasonal-menu-select');
+    const refreshBtn = document.getElementById('refresh-seasonal-btn');
+    const reviewsList = document.getElementById('customer-reviews-list');
+    const reviewForm = document.getElementById('customer-review-form');
+    const cmsPromoContainer = document.getElementById('cms-promo-container');
+
+    /**
+     * Refresh the seasonal coffee cards in place with fresh HTML streamed from the server
+     * whenever the menu changes. Uses native Response.textStream() + Element.streamHTML()
+     * (and supports streaming <template for="..."> patches via streamHTMLUnsafe()).
+     */
+    async function refreshSeasonalMenu(season = menuSelect.value) {
+      const endpoint = `/api/menu/seasonal?season=${encodeURIComponent(season)}`;
+      try {
+        const response = await fetch(endpoint, {
+          headers: { Accept: 'text/html' }
+        });
+
+        if (!response.ok) {
+          throw new Error(`Failed to fetch seasonal menu (${response.status})`);
+        }
+
+        const patchMode = response.headers.get('X-Patch-Mode');
+        if (patchMode === 'declarative' && typeof seasonalSection.streamHTMLUnsafe === 'function') {
+          await response
+            .textStream()
+            .pipeTo(seasonalSection.streamHTMLUnsafe());
+          return;
+        }
+
+        if (typeof response.textStream === 'function' && typeof seasonalCards.streamHTML === 'function') {
+          await response
+            .textStream()
+            .pipeTo(seasonalCards.streamHTML());
+        } else if (response.body && typeof seasonalCards.streamHTML === 'function') {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(seasonalCards.streamHTML());
+        } else {
+          const freshHtml = await response.text();
+          seasonalCards.setHTML(freshHtml);
+        }
+      } catch (err) {
+        console.warn('Seasonal menu server refresh unavailable:', err);
+      }
+    }
+
+    menuSelect.addEventListener('change', () => {
+      refreshSeasonalMenu(menuSelect.value);
+    });
+
+    refreshBtn.addEventListener('click', () => {
+      refreshSeasonalMenu(menuSelect.value);
+    });
+
+    // Also listen for server-pushed or custom menu-change events
+    window.addEventListener('menu-change', (event) => {
+      const nextSeason = event.detail?.season || menuSelect.value;
+      if (event.detail?.html && typeof seasonalCards.setHTML === 'function') {
+        seasonalCards.setHTML(event.detail.html);
+      } else {
+        refreshSeasonalMenu(nextSeason);
+      }
+    });
+
+    /**
+     * Render and append untrusted customer-submitted reviews using native setHTML() and appendHTML()
+     * so user-supplied HTML is automatically sanitized by the browser's built-in Sanitizer API.
+     */
+    const initialCustomerReviewsHtml = `
+      <article class="review-item">
+        <div class="review-meta">Maya R. &bull; Maple Oat Latte</div>
+        <p>Absolutely love the <strong>real Vermont maple</strong> notes without being overly sweet!</p>
+      </article>
+      <article class="review-item">
+        <div class="review-meta">Devon K. &bull; Cold Brew</div>
+        <p>Super smooth finish. My go-to morning fuel every single day.</p>
+      </article>
+    `;
+
+    function renderCustomerReviews(reviewsHtml) {
+      if (typeof reviewsList.setHTML === 'function') {
+        reviewsList.setHTML(reviewsHtml);
+      }
+    }
+
+    function addCustomerReview(name, drink, rawCommentHtml) {
+      const reviewMarkup = `
+        <article class="review-item">
+          <div class="review-meta">${name} &bull; ${drink}</div>
+          <div class="review-body">${rawCommentHtml}</div>
+        </article>
+      `;
+
+      if (typeof reviewsList.appendHTML === 'function') {
+        reviewsList.appendHTML(reviewMarkup);
+      } else if (typeof reviewsList.setHTML === 'function') {
+        reviewsList.setHTML(reviewsList.innerHTML + reviewMarkup);
+      }
+    }
+
+    reviewForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = document.getElementById('reviewer-name').value.trim();
+      const drink = document.getElementById('reviewed-drink').value;
+      const comment = document.getElementById('review-body').value.trim();
+      if (!name || !comment) return;
+
+      addCustomerReview(name, drink, comment);
+      reviewForm.reset();
+    });
+
+    /**
+     * Render the promo block from our own trusted CMS along with its embedded widget script
+     * using setHTMLUnsafe(..., { runScripts: true }) and streamHTMLUnsafe({ runScripts: true }).
+     */
+    const defaultCmsPromoHtml = `
+      <div class="cms-promo-widget" id="cms-seasonal-widget">
+        <span class="promo-badge">CMS Double Stars Event</span>
+        <h4>2x Grind Rewards on Seasonal Drinks</h4>
+        <p>Order any Seasonal Favorite today and earn double stars automatically.</p>
+        <div class="promo-code-box">
+          Promo Code: <strong id="cms-widget-code">LOADING...</strong>
+        </div>
+        <p id="cms-widget-status" style="font-size: 0.8rem; margin-top: 8px;"></p>
+        <button type="button" id="cms-widget-claim-btn" class="btn" style="background: var(--accent); color: var(--text);">
+          Activate 2x Stars
+        </button>
+      </div>
+      <script>
+        (() => {
+          const codeEl = document.getElementById('cms-widget-code');
+          const statusEl = document.getElementById('cms-widget-status');
+          const claimBtn = document.getElementById('cms-widget-claim-btn');
+          if (codeEl) {
+            codeEl.textContent = 'MAPLE2X';
+          }
+          if (statusEl) {
+            statusEl.textContent = 'CMS Rewards Widget active — ready to apply at checkout.';
+          }
+          if (claimBtn) {
+            claimBtn.addEventListener('click', () => {
+              claimBtn.textContent = '2x Stars Activated!';
+              if (statusEl) {
+                statusEl.textContent = 'Code MAPLE2X applied to your Daily Grind Rewards account.';
+              }
+            });
+          }
+        })();
+      <\/script>
+    `;
+
+    async function loadCmsPromoBlock(cmsEndpoint = '/api/cms/seasonal-promo') {
+      if (typeof cmsPromoContainer.setHTMLUnsafe === 'function') {
+        cmsPromoContainer.setHTMLUnsafe(defaultCmsPromoHtml, { runScripts: true });
+      }
+
+      try {
+        const response = await fetch(cmsEndpoint, {
+          headers: { Accept: 'text/html' }
+        });
+        if (!response.ok) return;
+
+        if (typeof response.textStream === 'function' && typeof cmsPromoContainer.streamHTMLUnsafe === 'function') {
+          await response
+            .textStream()
+            .pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+        } else if (typeof cmsPromoContainer.setHTMLUnsafe === 'function') {
+          const cmsHtml = await response.text();
+          cmsPromoContainer.setHTMLUnsafe(cmsHtml, { runScripts: true });
+        }
+      } catch {
+        // Keep initial trusted CMS promo block rendered above when offline/static
+      }
+    }
+
+    renderCustomerReviews(initialCustomerReviewsHtml);
+    loadCmsPromoBlock();
+  </script>
+
 </body>
 
