+  <!-- Out-of-order declarative partial updates streamed later in the same HTML document -->
+  <template for="seasonal-banner">
+    <p style="text-align: center; margin-top: 8px;">
+      Small-batch seasonal pours crafted with locally roasted beans.
+    </p>
+  </template>
+
