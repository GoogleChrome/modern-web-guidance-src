+        if (!swipeState.tracking || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        moveSwipeTrack(touch.clientX, touch.clientY);
+      }, { passive: true });
+
+      viewportEl.addEventListener('touchend', function () {
+        endSwipeTrack();
+      });
+
+      viewportEl.addEventListener('touchcancel', function () {
+        endSwipeTrack();
+      });
+
+      // Pointer/Mouse drag support (from edge zone or horizontal drag on detail background)
+      edgeSwipeZone.addEventListener('mousedown', function (e) {
+        e.preventDefault();
+        beginSwipeTrack(e.clientX, e.clientY, true);
+      });
+
+      viewportEl.addEventListener('mousedown', function (e) {
+        if (currentStack.length <= 1) return;
+        if (e.button !== 0) return;
+        // Avoid interfering with buttons/links unless dragging
+        if (e.target.closest('button, a, input, select, textarea')) return;
+        beginSwipeTrack(e.clientX, e.clientY, e.clientX <= 36);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!swipeState.tracking) return;
+        moveSwipeTrack(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', function () {
+        if (!swipeState.tracking) return;
+        endSwipeTrack();
+      });
+
+      /* ==========================================================================
+       * Event Delegation for Cards, Drill-Down Links, Back Buttons & Customizer
+       * ========================================================================== */
+      document.addEventListener('click', function (e) {
+        // 1. Back button clicks
+        const backBtn = e.target.closest('[data-action="back"]');
+        if (backBtn) {
+          e.preventDefault();
+          navigateBack();
+          return;
+        }
+
+        // 2. Root logo / home links
+        const rootLink = e.target.closest('[data-nav-root]');
+        if (rootLink) {
+          e.preventDefault();
+          if (currentStack.length > 1) {
+            navigateToStackLevel(0);
+          }
+          return;
+        }
+
+        // 3. Breadcrumb hierarchy jumps
+        const crumbLink = e.target.closest('[data-crumb-level]');
+        if (crumbLink) {
+          e.preventDefault();
+          const targetLevel = parseInt(crumbLink.getAttribute('data-crumb-level'), 10);
+          navigateToStackLevel(targetLevel);
+          return;
+        }
+
+        // 4. Level 2 subview drill-down cards
+        const subviewLink = e.target.closest('[data-drill-subview]');
+        if (subviewLink) {
+          e.preventDefault();
+          const parentSlug = subviewLink.getAttribute('data-parent-slug');
+          const subview = subviewLink.getAttribute('data-drill-subview');
+          if (ITEMS[parentSlug] && SUBVIEWS.includes(subview)) {
+            navigateToPath(ITEMS[parentSlug].path + '/' + subview);
+          }
+          return;
+        }
+
+        // 5. Seasonal Favorites "View Details" link or related item card
+        const drillLink = e.target.closest('[data-drill-link]');
+        if (drillLink) {
+          e.preventDefault();
+          const slug = drillLink.getAttribute('data-drill-link');
+          if (ITEMS[slug]) {
+            navigateToPath(ITEMS[slug].path);
+          }
+          return;
+        }
+
+        // 6. Clicking anywhere on a Seasonal Favorites card on Home screen
+        const cardEl = e.target.closest('.card[data-item-slug]');
+        if (cardEl) {
+          e.preventDefault();
+          const slug = cardEl.getAttribute('data-item-slug');
+          if (ITEMS[slug]) {
+            navigateToPath(ITEMS[slug].path);
+          }
+          return;
+        }
+
+        // 7. Scroll to Seasonal Favorites CTA on Home
+        const scrollSeasonal = e.target.closest('[data-scroll-seasonal]');
+        if (scrollSeasonal) {
+          e.preventDefault();
+          if (currentStack.length > 1) {
+            navigateToStackLevel(0);
+          }
+          const section = document.getElementById('seasonal-favorites-section');
+          if (section) {
+            section.scrollIntoView({ behavior: 'smooth' });
+          }
+          return;
+        }
+
+        // 8. Size & Milk customization pills inside Detail View
+        const sizePill = e.target.closest('.option-pill[data-size]');
+        if (sizePill) {
+          selectedCustomizations.size = sizePill.getAttribute('data-size');
+          selectedCustomizations.sizeDelta = parseFloat(sizePill.getAttribute('data-delta') || '0');
+          const activeSlug = screenDetailEl.getAttribute('data-active-slug');
+          if (activeSlug) renderDetailScreen(activeSlug);
+          return;
+        }
+
+        const milkPill = e.target.closest('.option-pill[data-milk]');
+        if (milkPill) {
+          selectedCustomizations.milk = milkPill.getAttribute('data-milk');
+          const activeSlug = screenDetailEl.getAttribute('data-active-slug');
+          if (activeSlug) renderDetailScreen(activeSlug);
+          return;
+        }
+
+        // 9. Add to Order button
+        const addBtn = e.target.closest('#add-to-order-btn');
+        if (addBtn) {
+          cartCount += 1;
+          cartCountEl.textContent = String(cartCount);
+          const activeSlug = screenDetailEl.getAttribute('data-active-slug');
+          const item = ITEMS[activeSlug];
+          const feedbackEl = document.getElementById('order-feedback');
+          if (feedbackEl && item) {
+            feedbackEl.textContent = `Added ${selectedCustomizations.size} ${item.title} (${selectedCustomizations.milk}) to your cup!`;
+          }
+          return;
+        }
+      });
+
+      // Copy Deep Link button
+      if (copyDeeplinkBtn) {
+        copyDeeplinkBtn.addEventListener('click', function () {
+          const url = window.location.href;
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            navigator.clipboard.writeText(url).catch(function () {});
+          }
+          copyDeeplinkBtn.textContent = 'Link Copied!';
+          setTimeout(function () {
+            copyDeeplinkBtn.textContent = 'Copy Link';
+          }, 1800);
+        });
+      }
+
+      // Keyboard navigation support (Enter/Space on cards, Escape to pop stack)
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && currentStack.length > 1) {
+          e.preventDefault();
+          navigateBack();
+          return;
+        }
+        if ((e.key === 'Enter' || e.key === ' ') && document.activeElement) {
+          const focusedCard = document.activeElement.closest('.card[data-item-slug]');
+          if (focusedCard && document.activeElement === focusedCard) {
+            e.preventDefault();
+            const slug = focusedCard.getAttribute('data-item-slug');
+            if (ITEMS[slug]) {
+              navigateToPath(ITEMS[slug].path);
+            }
+          }
+        }
+      });
+
+      /* ==========================================================================
+       * Initial Boot & Deep-Link Synchronization
+       * ========================================================================== */
+      const initialStack = parseLocationToStack(window.location);
+      const initialTop = initialStack[initialStack.length - 1];
+      replaceUrlState(initialTop.path, initialStack);
+      applyStackState(initialStack, { scrollTopLevel: initialStack.length - 1 });
+
+      // Expose navigation stack controller for programmatic inspection if needed
+      window.DailyGrindStack = {
+        getStack: function () { return currentStack.slice(); },
+        navigateTo: navigateToPath,
+        back: navigateBack
+      };
+    })();
+  </script>
 </body>
 
 </html>
