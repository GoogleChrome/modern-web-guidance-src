+    function setRoastBannerPaused(paused) {
+      roastBanner.dataset.paused = String(paused);
+      roastToggleBtn.setAttribute('aria-pressed', String(paused));
+      roastToggleBtn.textContent = paused ? 'Resume' : 'Pause';
+
+      const animations = roastTrack.getAnimations();
+      for (const anim of animations) {
+        if (paused) {
+          anim.pause();
+        } else {
+          anim.play();
+        }
+      }
+      const activeAnim = animations[0];
+      const stateLabel = activeAnim?.playState || (paused ? 'paused' : 'running');
+      document.body.dataset.lastAnimationState = `roast-banner:${stateLabel}`;
+    }
+
+    if (reducedMotionQuery.matches) {
+      roastBanner.dataset.paused = 'true';
+      roastToggleBtn.setAttribute('aria-pressed', 'true');
+      roastToggleBtn.textContent = 'Resume';
+    }
+
+    roastToggleBtn.addEventListener('click', () => {
+      const isCurrentlyPaused = roastBanner.dataset.paused === 'true';
+      setRoastBannerPaused(!isCurrentlyPaused);
+    });
+
+    // Top-layer discrete display transition probe & animated dialog close helper
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    const dialog = document.getElementById('drink-details-dialog');
+    const dialogTitle = document.getElementById('drink-dialog-title');
+    const dialogDescription = document.getElementById('drink-dialog-description');
+    const dialogRoast = document.getElementById('drink-dialog-roast');
+    const dialogCaffeine = document.getElementById('drink-dialog-caffeine');
+    const dialogPrice = document.getElementById('drink-dialog-price');
+    const dialogNotes = document.getElementById('drink-dialog-notes');
+    const dialogOrderLink = document.getElementById('drink-dialog-order-link');
+
+    function populateDrinkDialog(button) {
+      dialogTitle.textContent = button.dataset.drinkTitle || '';
+      dialogDescription.textContent = button.dataset.drinkDescription || '';
+      dialogRoast.textContent = button.dataset.drinkRoast || '';
+      dialogCaffeine.textContent = button.dataset.drinkCaffeine || '';
+      dialogPrice.textContent = button.dataset.drinkPrice || '';
+      dialogNotes.innerHTML = '';
+      const strong = document.createElement('strong');
+      strong.textContent = 'Tasting Notes: ';
+      dialogNotes.append(strong, document.createTextNode(button.dataset.drinkNotes || ''));
+      dialogOrderLink.setAttribute('href', button.dataset.drinkHref || '/order-online');
+    }
+
+    async function closeTopLayer(element) {
+      if (!element.open) return;
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+      element.close();
+    }
+
+    // Open & populate drink details overlay when clicking "View Details"
+    for (const btn of document.querySelectorAll('.view-details-btn')) {
+      btn.addEventListener('click', () => {
+        dialog.removeAttribute('data-closing');
+        populateDrinkDialog(btn);
+        if (!dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    // Close controls inside the dialog
+    for (const closeBtn of dialog.querySelectorAll('[data-dialog-close]')) {
+      closeBtn.addEventListener('click', () => {
+        closeTopLayer(dialog);
+      });
+    }
+
+    // Route native cancel (Esc / closedby) through closeTopLayer for smooth exit animation
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeTopLayer(dialog);
+    });
+
+    // Fallback for browsers without closedby="any" support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => {
+        pressedOutside = outside(e, dialog);
+      });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e, dialog)) {
+          closeTopLayer(dialog);
+        }
+      });
+    }
+  </script>
+
 </body>
 
