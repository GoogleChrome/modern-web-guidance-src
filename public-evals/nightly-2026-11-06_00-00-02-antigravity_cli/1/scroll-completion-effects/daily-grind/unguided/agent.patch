+  <script>
+    (function () {
+      let cleanupPendingScroll = null;
+
+      function clearActiveTargets() {
+        document.querySelectorAll('.scroll-target-active, .is-highlighted, [data-scroll-complete]').forEach((el) => {
+          el.classList.remove('scroll-target-active', 'is-highlighted');
+          el.removeAttribute('data-scroll-complete');
+        });
+      }
+
+      function setActiveNavLink(targetId) {
+        document.querySelectorAll('nav a').forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${targetId}`;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function activateTargetAfterScroll(target, targetId) {
+        if (!target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+
+        // Trigger visual effects and CSS animation class
+        target.classList.add('scroll-target-active', 'is-highlighted');
+        target.setAttribute('data-scroll-complete', 'true');
+
+        // Also trigger Web Animations API effect if supported
+        if (typeof target.animate === 'function' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          target.animate(
+            [
+              { transform: 'translateY(0) scale(1)' },
+              { transform: 'translateY(-4px) scale(1.01)' },
+              { transform: 'translateY(0) scale(1)' }
+            ],
+            {
+              duration: 650,
+              easing: 'cubic-bezier(0.22, 1, 0.36, 1)'
+            }
+          );
+        }
+
+        // Move focus to the target element only after the scroll has finished
+        target.focus({ preventScroll: true });
+
+        if (history.replaceState) {
+          history.replaceState(null, '', `#${targetId}`);
+        }
+      }
+
+      function scrollToTarget(target, targetId) {
+        if (cleanupPendingScroll) {
+          cleanupPendingScroll();
+          cleanupPendingScroll = null;
+        }
+
+        clearActiveTargets();
+        if (document.activeElement === target && typeof target.blur === 'function') {
+          target.blur();
+        }
+
+        setActiveNavLink(targetId);
+
+        let completed = false;
+        let hasScrolled = false;
+        let noScrollTimer = null;
+        let debounceTimer = null;
+
+        const finish = () => {
+          if (completed) return;
+          completed = true;
+          if (cleanupPendingScroll) {
+            cleanupPendingScroll();
+            cleanupPendingScroll = null;
+          }
+          activateTargetAfterScroll(target, targetId);
+        };
+
+        const onScrollEnd = () => {
+          finish();
+        };
+
+        const onScroll = () => {
+          hasScrolled = true;
+          if (noScrollTimer) {
+            clearTimeout(noScrollTimer);
+            noScrollTimer = null;
+          }
+          // Fallback for environments without native scrollend support
+          if (!('onscrollend' in window)) {
+            clearTimeout(debounceTimer);
+            debounceTimer = setTimeout(finish, 150);
+          }
+        };
+
+        cleanupPendingScroll = () => {
+          window.removeEventListener('scrollend', onScrollEnd);
+          document.removeEventListener('scrollend', onScrollEnd);
+          window.removeEventListener('scroll', onScroll);
+          clearTimeout(noScrollTimer);
+          clearTimeout(debounceTimer);
+        };
+
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+        document.addEventListener('scrollend', onScrollEnd, { once: true });
+        window.addEventListener('scroll', onScroll, { passive: true });
+
+        // If the viewport is already at the target position and no scroll event starts,
+        // still apply the post-scroll focus and visual effect after a brief check.
+        noScrollTimer = setTimeout(() => {
+          if (!hasScrolled) {
+            finish();
+          }
+        }, 120);
+
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        target.scrollIntoView({
+          behavior: prefersReducedMotion ? 'auto' : 'smooth',
+          block: 'start'
+        });
+      }
+
+      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
+        anchor.addEventListener('click', (event) => {
+          const href = anchor.getAttribute('href');
+          if (!href || href === '#') return;
+
+          const targetId = href.slice(1);
+          const target = document.getElementById(targetId);
+          if (!target) return;
+
+          event.preventDefault();
+          scrollToTarget(target, targetId);
+        });
+      });
+    })();
+  </script>
+
