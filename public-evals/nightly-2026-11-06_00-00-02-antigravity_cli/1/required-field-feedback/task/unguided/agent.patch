+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-email');
+      const errorMsg = document.getElementById('mailing-email-error');
+      const successMsg = document.getElementById('mailing-success');
+
+      let interacted = false;
+
+      function validateEmailField() {
+        const value = emailInput.value.trim();
+        if (value === '') {
+          emailInput.classList.add('has-error');
+          emailInput.setAttribute('aria-invalid', 'true');
+          errorMsg.textContent = 'Please enter your email address.';
+          errorMsg.classList.add('visible');
+          return false;
+        } else if (!emailInput.checkValidity()) {
+          emailInput.classList.add('has-error');
+          emailInput.setAttribute('aria-invalid', 'true');
+          errorMsg.textContent = 'Please enter a valid email address.';
+          errorMsg.classList.add('visible');
+          return false;
+        } else {
+          emailInput.classList.remove('has-error');
+          emailInput.setAttribute('aria-invalid', 'false');
+          errorMsg.classList.remove('visible');
+          return true;
+        }
+      }
+
+      emailInput.addEventListener('focus', function () {
+        interacted = true;
+      });
+
+      emailInput.addEventListener('blur', function () {
+        if (interacted) {
+          validateEmailField();
+        }
+      });
+
+      emailInput.addEventListener('input', function () {
+        successMsg.classList.remove('visible');
+        if (emailInput.classList.contains('has-error')) {
+          validateEmailField();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        interacted = true;
+        if (validateEmailField()) {
+          successMsg.classList.add('visible');
+          emailInput.value = '';
+          interacted = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
