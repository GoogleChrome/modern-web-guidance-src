+  <script>
+    (function () {
+      function hydrateMediaElement(mediaEl) {
+        if (!mediaEl || mediaEl.dataset.loaded === 'true') {
+          return;
+        }
+        mediaEl.dataset.loaded = 'true';
+
+        if (mediaEl.dataset.poster) {
+          mediaEl.setAttribute('poster', mediaEl.dataset.poster);
+          mediaEl.removeAttribute('data-poster');
+        }
+
+        var sources = mediaEl.querySelectorAll('source[data-src]');
+        sources.forEach(function (sourceEl) {
+          sourceEl.setAttribute('src', sourceEl.dataset.src);
+          sourceEl.removeAttribute('data-src');
+        });
+
+        if (mediaEl.dataset.src) {
+          mediaEl.setAttribute('src', mediaEl.dataset.src);
+          mediaEl.removeAttribute('data-src');
+        }
+
+        var targetPreload = mediaEl.dataset.preload || 'metadata';
+        mediaEl.setAttribute('preload', targetPreload);
+
+        if (typeof mediaEl.load === 'function') {
+          mediaEl.load();
+        }
+
+        var card = mediaEl.closest('.media-card');
+        if (card) {
+          var coverImg = card.querySelector('img[data-src]');
+          if (coverImg) {
+            coverImg.setAttribute('src', coverImg.dataset.src);
+            coverImg.removeAttribute('data-src');
+          }
+          var statusEl = card.querySelector('[data-lazy-status]');
+          if (statusEl) {
+            statusEl.dataset.lazyStatus = 'loaded';
+            statusEl.textContent = mediaEl.tagName === 'VIDEO'
+              ? 'Ready to play HD roastery film'
+              : 'Ready to stream episode audio';
+          }
+        }
+      }
+
+      var lazyMediaElements = document.querySelectorAll('.lazy-media');
+
+      lazyMediaElements.forEach(function (el) {
+        ['pointerenter', 'focusin', 'click', 'play'].forEach(function (eventName) {
+          el.addEventListener(eventName, function () {
+            hydrateMediaElement(el);
+          }, { once: true });
+        });
+      });
+
+      if ('IntersectionObserver' in window) {
+        var mediaObserver = new IntersectionObserver(function (entries, observer) {
+          entries.forEach(function (entry) {
+            if (entry.isIntersecting) {
+              hydrateMediaElement(entry.target);
+              observer.unobserve(entry.target);
+            }
+          });
+        }, {
+          rootMargin: '200px 0px',
+          threshold: 0.01
+        });
+
+        lazyMediaElements.forEach(function (el) {
+          mediaObserver.observe(el);
+        });
+      } else {
+        lazyMediaElements.forEach(hydrateMediaElement);
+      }
+    })();
+  </script>
