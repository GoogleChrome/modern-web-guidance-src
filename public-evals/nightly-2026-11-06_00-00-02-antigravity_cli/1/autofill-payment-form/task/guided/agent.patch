+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const submitBtn = document.getElementById('pay-submit-btn');
+    const paymentStatus = document.getElementById('payment-status');
+
+    const errorMessages = {
+      'cc-number': 'Please enter a valid 13–19 digit card number.',
+      'cc-name': 'Please enter the cardholder name as shown on the card.',
+      'cc-exp': 'Please enter a valid expiry date in MM/YY format.',
+      'cc-csc': 'Please enter the 3- or 4-digit security code.'
+    };
+
+    const inputs = paymentForm.querySelectorAll('input');
+
+    inputs.forEach((input) => {
+      const errorEl = document.getElementById(`${input.id}-error`);
+
+      input.addEventListener('blur', () => {
+        if (!input.validity.valid) {
+          errorEl.textContent = errorMessages[input.id] || input.validationMessage;
+        }
+      });
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        if (errorEl) {
+          errorEl.textContent = '';
+        }
+        paymentStatus.textContent = '';
+        paymentStatus.className = 'payment-status';
+      });
+    });
+
+    paymentForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!paymentForm.checkValidity()) {
+        paymentForm.reportValidity();
+        return;
+      }
+      submitBtn.disabled = true;
+      submitBtn.textContent = 'Payment Processed';
+      paymentStatus.textContent = 'Thank you! Your payment details have been verified.';
+      paymentStatus.className = 'payment-status success';
+    });
+  </script>
