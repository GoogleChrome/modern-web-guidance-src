+                      CLI Event Stream WebSocket (<code className="font-mono">127.0.0.1</code> / <code className="font-mono">localhost</code>)
+                    </label>
+                    <input
+                      id={cliWsInputId}
+                      type="text"
+                      value={cliWsUrl}
+                      onChange={(e) => setCliWsUrl(e.target.value)}
+                      placeholder="ws://127.0.0.1:45678/events"
+                      className="w-full rounded border border-gray-300 px-2.5 py-1.5 text-xs font-mono text-gray-800 focus:border-amber-500 focus:outline-none"
+                    />
+                  </div>
+                </div>
+              </div>
+
+              <div className="space-y-3 pt-2 border-t border-gray-100">
+                <div className="flex flex-wrap gap-2">
+                  <button
+                    type="button"
+                    onClick={() => handleConnectCliDaemon(cliHttpUrl)}
+                    disabled={cliStatus === 'connecting'}
+                    className="flex-1 rounded bg-gray-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-700 disabled:opacity-50 cursor-pointer"
+                  >
+                    {cliStatus === 'connecting'
+                      ? 'Connecting...'
+                      : 'Connect Local CLI'}
+                  </button>
+                  <button
+                    type="button"
+                    onClick={handleToggleCliWebSocket}
+                    className="rounded border border-gray-300 bg-gray-50 px-3 py-1.5 text-xs font-semibold text-gray-800 hover:bg-gray-100 cursor-pointer"
+                  >
+                    {cliWsStatus === 'connected'
+                      ? 'Disconnect WS'
+                      : cliWsStatus === 'connecting'
+                      ? 'Opening WS...'
+                      : 'Attach CLI WS'}
+                  </button>
+                </div>
+
+                {cliError && (
+                  <p role="alert" className="text-xs text-red-700 bg-red-50 border border-red-200 rounded p-2">
+                    {cliError}
+                  </p>
+                )}
+
+                {cliResponse && (
+                  <div>
+                    <p className="text-xs font-semibold text-gray-700 mb-1">
+                      Companion CLI Output:
+                    </p>
+                    <pre
+                      role="region"
+                      aria-label="Companion CLI Output"
+                      tabIndex={0}
+                      className="rounded bg-gray-900 text-amber-300 p-2.5 text-xs font-mono overflow-x-auto max-h-36"
+                    >
+                      <code>{cliResponse}</code>
+                    </pre>
+                  </div>
+                )}
+              </div>
+            </section>
+          </div>
+
+          <details className="rounded-md border border-gray-200 bg-gray-50 p-3 text-xs text-gray-700">
+            <summary className="font-semibold cursor-pointer text-gray-900">
+              Local Development &amp; Testing Notes (Address Space Lattice)
+            </summary>
+            <div className="mt-2 space-y-1.5 text-gray-600">
+              <p>
+                Browsers enforce Local Network Access checks across the IP address space lattice (<code className="font-mono">public</code> &rarr; <code className="font-mono">local</code> &rarr; <code className="font-mono">loopback</code>), gating requests behind <code className="font-mono">local-network</code> (RFC 1918 LAN IPs like <code className="font-mono">192.168.1.x</code> and <code className="font-mono">.local</code> mDNS) and <code className="font-mono">loopback-network</code> (<code className="font-mono">127.0.0.1</code>, <code className="font-mono">[::1]</code>, <code className="font-mono">localhost</code>).
+              </p>
+              <p>
+                When testing locally on <code className="font-mono">localhost</code>, simulate a public origin with Chromium flag:{' '}
+                <code className="font-mono bg-gray-200 px-1 py-0.5 rounded text-gray-800">
+                  --ip-address-space-overrides=127.0.0.1:4321=public,[::1]:4321=public
+                </code>{' '}
+                or toggle <strong>Local network</strong> and <strong>Loopback network</strong> in browser Site Settings.
+              </p>
+            </div>
+          </details>
+        </div>
+      </dialog>
+    </div>
+  );
+}
