+  <script type="module">
+    /**
+     * Updates the permission badge and remediation UI for a granular LNA permission.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {PermissionState} state
+     */
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      if (statusBadge) {
+        statusBadge.textContent = state;
+        statusBadge.dataset.state = state;
+      }
+      if (remediationBox) {
+        // Show remediation instructions whenever permission is explicitly denied
+        remediationBox.hidden = state !== 'denied';
+      }
+    }
+
+    /**
+     * Cross-browser permission check for the granular LNA permissions.
+     * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @returns {Promise<PermissionState>}
+     */
+    export async function queryLnaPermissionSafe(permissionName) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+        });
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name; proceed on user gesture
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    /**
+     * Connects to the shop's Wi-Fi coffee brewer on the private LAN over HTTP.
+     * Declares targetAddressSpace: 'local' to exempt local HTTP from Mixed Content
+     * blocking and verify the resolved IP belongs to the private local range.
+     * @param {string} deviceUrl
+     */
+    export async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Brewer responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to the companion desktop brewing helper on the loopback interface.
+     * Declares targetAddressSpace: 'loopback' when targeting 127.0.0.1, [::1], or localhost.
+     * @param {string} daemonUrl
+     */
+    export async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Desktop helper responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a WebSocket connection to a local network or loopback device.
+     * Passes only subprotocol string(s) as the second argument (never an options object).
+     * @param {string} wsUrl
+     */
+    export function openLocalWebSocket(wsUrl) {
+      return new WebSocket(wsUrl, ['v1.telemetry']);
+    }
+
+    // UI Elements
+    const insecureWarning = document.getElementById('insecure-context-warning');
+    if (window.isSecureContext === false) {
+      insecureWarning.hidden = false;
+    }
+
+    const lanInput = document.getElementById('lan-endpoint-input');
+    const lanWsInput = document.getElementById('lan-ws-input');
+    const lanConnectBtn = document.getElementById('btn-connect-lan');
+    const lanStreamBtn = document.getElementById('btn-stream-lan');
+    const lanConnBadge = document.getElementById('lan-conn-badge');
+    const lanLog = document.getElementById('lan-telemetry-log');
+    const lanRemediation = document.querySelector('[data-remediation="local-network"]');
+
+    const loopbackInput = document.getElementById('loopback-endpoint-input');
+    const loopbackWsInput = document.getElementById('loopback-ws-input');
+    const loopbackConnectBtn = document.getElementById('btn-connect-loopback');
+    const loopbackStreamBtn = document.getElementById('btn-stream-loopback');
+    const loopbackConnBadge = document.getElementById('loopback-conn-badge');
+    const loopbackLog = document.getElementById('loopback-telemetry-log');
+    const loopbackRemediation = document.querySelector('[data-remediation="loopback-network"]');
+
+    async function connectLanBrewer() {
+      const url = lanInput.value.trim();
+      lanConnBadge.textContent = 'Connecting...';
+      lanConnBadge.dataset.conn = 'connecting';
+      lanLog.textContent = `Requesting ${url} (targetAddressSpace: 'local')...`;
+
+      try {
+        const data = await fetchLocalDeviceStatus(url);
+        lanConnBadge.textContent = 'Connected';
+        lanConnBadge.dataset.conn = 'connected';
+        lanRemediation.hidden = true;
+        lanLog.textContent = `Connected to LAN Brewer:\n${JSON.stringify(data, null, 2)}`;
+      } catch (err) {
+        lanConnBadge.textContent = 'Connection Failed';
+        lanConnBadge.dataset.conn = 'error';
+        lanRemediation.hidden = false;
+        lanLog.textContent = `Could not reach brewer at ${url} (${err.message}).\nVerify the brewer is powered on, on the same Wi-Fi LAN, and allowed under "Local network" in browser Site Settings.`;
+      } finally {
+        await queryLnaPermissionSafe('local-network');
+      }
+    }
+
+    async function connectLoopbackHelper() {
+      const url = loopbackInput.value.trim();
+      loopbackConnBadge.textContent = 'Connecting...';
+      loopbackConnBadge.dataset.conn = 'connecting';
+      loopbackLog.textContent = `Requesting ${url} (targetAddressSpace: 'loopback')...`;
+
+      try {
+        const data = await fetchLoopbackDaemon(url);
+        loopbackConnBadge.textContent = 'Connected';
+        loopbackConnBadge.dataset.conn = 'connected';
+        loopbackRemediation.hidden = true;
+        loopbackLog.textContent = `Connected to Desktop Helper:\n${JSON.stringify(data, null, 2)}`;
+      } catch (err) {
+        loopbackConnBadge.textContent = 'Connection Failed';
+        loopbackConnBadge.dataset.conn = 'error';
+        loopbackRemediation.hidden = false;
+        loopbackLog.textContent = `Could not reach desktop helper at ${url} (${err.message}).\nVerify the companion app is running on 127.0.0.1 and allowed under "Loopback network" in browser Site Settings.`;
+      } finally {
+        await queryLnaPermissionSafe('loopback-network');
+      }
+    }
+
+    let activeLanSocket = null;
+    function streamLanTelemetry() {
+      const wsUrl = lanWsInput.value.trim();
+      if (activeLanSocket) {
+        activeLanSocket.close();
+      }
+      lanConnBadge.textContent = 'Streaming...';
+      lanConnBadge.dataset.conn = 'connecting';
+      lanLog.textContent = `Opening WebSocket ${wsUrl} (subprotocol: v1.telemetry)...`;
+
+      try {
+        const socket = openLocalWebSocket(wsUrl);
+        activeLanSocket = socket;
+        socket.addEventListener('open', () => {
+          lanConnBadge.textContent = 'Live Stream';
+          lanConnBadge.dataset.conn = 'connected';
+          lanRemediation.hidden = true;
+          lanLog.textContent = `WebSocket connected to ${wsUrl}. Listening for boiler telemetry...`;
+        });
+        socket.addEventListener('message', (event) => {
+          lanLog.textContent = `Telemetry update:\n${String(event.data)}`;
+        });
+        socket.addEventListener('error', () => {
+          lanConnBadge.textContent = 'Stream Error';
+          lanConnBadge.dataset.conn = 'error';
+          lanRemediation.hidden = false;
+          lanLog.textContent = `WebSocket stream failed for ${wsUrl}. Check that the LAN brewer is online and "Local network" permission is granted.`;
+        });
+      } catch (err) {
+        lanConnBadge.textContent = 'Stream Error';
+        lanConnBadge.dataset.conn = 'error';
+        lanRemediation.hidden = false;
+        lanLog.textContent = `Invalid WebSocket URL or connection blocked: ${err.message}`;
+      }
+    }
+
+    let activeLoopbackSocket = null;
+    function streamLoopbackScale() {
+      const wsUrl = loopbackWsInput.value.trim();
+      if (activeLoopbackSocket) {
+        activeLoopbackSocket.close();
+      }
+      loopbackConnBadge.textContent = 'Streaming...';
+      loopbackConnBadge.dataset.conn = 'connecting';
+      loopbackLog.textContent = `Opening WebSocket ${wsUrl} (subprotocol: v1.telemetry)...`;
+
+      try {
+        const socket = openLocalWebSocket(wsUrl);
+        activeLoopbackSocket = socket;
+        socket.addEventListener('open', () => {
+          loopbackConnBadge.textContent = 'Live Stream';
+          loopbackConnBadge.dataset.conn = 'connected';
+          loopbackRemediation.hidden = true;
+          loopbackLog.textContent = `WebSocket connected to ${wsUrl}. Listening for scale weight events...`;
+        });
+        socket.addEventListener('message', (event) => {
+          loopbackLog.textContent = `Scale reading:\n${String(event.data)}`;
+        });
+        socket.addEventListener('error', () => {
+          loopbackConnBadge.textContent = 'Stream Error';
+          loopbackConnBadge.dataset.conn = 'error';
+          loopbackRemediation.hidden = false;
+          loopbackLog.textContent = `WebSocket stream failed for ${wsUrl}. Ensure the Desktop Helper daemon is running on 127.0.0.1 and "Loopback network" permission is granted.`;
+        });
+      } catch (err) {
+        loopbackConnBadge.textContent = 'Stream Error';
+        loopbackConnBadge.dataset.conn = 'error';
+        loopbackRemediation.hidden = false;
+        loopbackLog.textContent = `Invalid WebSocket URL or connection blocked: ${err.message}`;
+      }
+    }
+
+    // Explicit user gesture bindings
+    lanConnectBtn.addEventListener('click', connectLanBrewer);
+    lanStreamBtn.addEventListener('click', streamLanTelemetry);
+    loopbackConnectBtn.addEventListener('click', connectLoopbackHelper);
+    loopbackStreamBtn.addEventListener('click', streamLoopbackScale);
+
+    // Pre-check granular permissions on load: only auto-connect when state === 'granted'
+    async function initEquipmentConnections() {
+      const [localState, loopbackState] = await Promise.all([
+        queryLnaPermissionSafe('local-network'),
+        queryLnaPermissionSafe('loopback-network'),
+      ]);
+
+      if (localState === 'granted') {
+        connectLanBrewer();
+      }
+      if (loopbackState === 'granted') {
+        connectLoopbackHelper();
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
