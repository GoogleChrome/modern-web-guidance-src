+  <script>
+    /**
+     * Determines the appropriate Local Network Access targetAddressSpace
+     * ('loopback', 'local', or 'public') for a given URL or host.
+     */
+    function getTargetAddressSpace(urlString, fallbackSpace) {
+      try {
+        const parsed = new URL(urlString);
+        const host = parsed.hostname.toLowerCase();
+        if (
+          host === '127.0.0.1' ||
+          host === 'localhost' ||
+          host === '::1' ||
+          host === '[::1]' ||
+          host.startsWith('127.')
+        ) {
+          return 'loopback';
+        }
+        if (
+          host.startsWith('192.168.') ||
+          host.startsWith('10.') ||
+          /^172\.(1[6-9]|2\d|3[0-1])\./.test(host) ||
+          host.endsWith('.local')
+        ) {
+          return 'local';
+        }
+      } catch (_) {
+        // Ignore URL parse error and use fallbackSpace
+      }
+      return fallbackSpace || 'local';
+    }
+
+    /**
+     * Queries browser permission state for Local Network Access permissions:
+     * 'local-network' (for private LAN devices like 192.168.1.x) and
+     * 'loopback-network' (for localhost/127.0.0.1 companion apps),
+     * with a fallback to the alias 'local-network-access'.
+     */
+    async function checkNetworkPermission(permissionName, statusElement) {
+      if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+        statusElement.textContent = 'unsupported';
+        return 'unsupported';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        statusElement.textContent = status.state;
+        status.onchange = () => {
+          statusElement.textContent = status.state;
+        };
+        return status.state;
+      } catch (primaryErr) {
+        try {
+          const fallbackStatus = await navigator.permissions.query({ name: 'local-network-access' });
+          statusElement.textContent = fallbackStatus.state;
+          fallbackStatus.onchange = () => {
+            statusElement.textContent = fallbackStatus.state;
+          };
+          return fallbackStatus.state;
+        } catch (_) {
+          statusElement.textContent = 'prompt (default)';
+          return 'prompt';
+        }
+      }
+    }
+
+    /**
+     * Connects to a local LAN coffee brewer ('local' address space) or
+     * loopback desktop brewing helper ('loopback' address space) via fetch().
+     */
+    async function requestEquipmentEndpoint({
+      url,
+      targetAddressSpace,
+      method = 'GET',
+      payload = null,
+      statusPill,
+      telemetryBox,
+      deviceLabel
+    }) {
+      const resolvedSpace = getTargetAddressSpace(url, targetAddressSpace);
+      statusPill.className = 'status-pill connecting';
+      statusPill.textContent = 'Connecting...';
+
+      const timestamp = new Date().toLocaleTimeString();
+      telemetryBox.textContent =
+        `[${timestamp}] Sending ${method} request to ${url}\n` +
+        `Options: { mode: "cors", targetAddressSpace: "${resolvedSpace}" }...`;
+
+      const fetchOptions = {
+        method,
+        mode: 'cors',
+        targetAddressSpace: resolvedSpace
+      };
+
+      if (payload) {
+        fetchOptions.headers = { 'Content-Type': 'application/json' };
+        fetchOptions.body = JSON.stringify(payload);
+      }
+
+      try {
+        const response = await fetch(url, fetchOptions);
+        const contentType = response.headers.get('content-type') || '';
+        let data;
+        if (contentType.includes('application/json')) {
+          data = await response.json();
+        } else {
+          data = await response.text();
+        }
+
+        statusPill.className = 'status-pill connected';
+        statusPill.textContent = 'Connected';
+        const formatted = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
+        telemetryBox.textContent =
+          `[${timestamp}] Connected to ${deviceLabel} (${url})\n` +
+          `targetAddressSpace: "${resolvedSpace}" | HTTP ${response.status}\n` +
+          `Response:\n${formatted}`;
+        return { ok: response.ok, status: response.status, data };
+      } catch (err) {
+        statusPill.className = 'status-pill error';
+        statusPill.textContent = 'Offline / Blocked';
+        telemetryBox.textContent =
+          `[${timestamp}] Connection attempt to ${deviceLabel} (${url})\n` +
+          `targetAddressSpace: "${resolvedSpace}"\n` +
+          `Status: ${err && err.message ? err.message : String(err)}\n` +
+          `Tip: Ensure the device is online and grant browser permission for ${
+            resolvedSpace === 'loopback' ? 'loopback-network (127.0.0.1)' : 'local-network (private LAN)'
+          }.`;
+        return { ok: false, error: err };
+      }
+    }
+
+    // Wire up Shop LAN Wi-Fi Brewer controls (targetAddressSpace: 'local')
+    const lanInput = document.getElementById('lan-endpoint-input');
+    const lanConnectBtn = document.getElementById('lan-connect-btn');
+    const lanStatusPill = document.getElementById('lan-status-pill');
+    const lanTelemetry = document.getElementById('lan-telemetry');
+    const lanPermState = document.getElementById('lan-perm-state');
+    const lanCheckPermBtn = document.getElementById('lan-check-perm-btn');
+
+    function connectLanBrewer(customPathOrMethod = {}) {
+      const baseUrl = lanInput.value.trim() || 'http://192.168.1.100/api/status';
+      const url = customPathOrMethod.url || baseUrl;
+      return requestEquipmentEndpoint({
+        url,
+        targetAddressSpace: 'local',
+        method: customPathOrMethod.method || 'GET',
+        payload: customPathOrMethod.payload || null,
+        statusPill: lanStatusPill,
+        telemetryBox: lanTelemetry,
+        deviceLabel: 'Shop Wi-Fi Coffee Brewer (LAN)'
+      });
+    }
+
+    lanConnectBtn.addEventListener('click', () => connectLanBrewer());
+    lanCheckPermBtn.addEventListener('click', () => checkNetworkPermission('local-network', lanPermState));
+
+    document.querySelectorAll('.lan-preset-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        lanInput.value = btn.getAttribute('data-url');
+        connectLanBrewer();
+      });
+    });
+
+    document.getElementById('lan-brew-btn').addEventListener('click', () => {
+      const currentOrigin = (() => {
+        try { return new URL(lanInput.value.trim()).origin; } catch (_) { return 'http://192.168.1.100'; }
+      })();
+      connectLanBrewer({
+        url: `${currentOrigin}/api/brew`,
+        method: 'POST',
+        payload: { action: 'start', temperatureCelsius: 94, profile: 'Artisanal Pour-Over' }
+      });
+    });
+
+    document.getElementById('lan-preheat-btn').addEventListener('click', () => {
+      const currentOrigin = (() => {
+        try { return new URL(lanInput.value.trim()).origin; } catch (_) { return 'http://192.168.1.100'; }
+      })();
+      connectLanBrewer({
+        url: `${currentOrigin}/api/preheat`,
+        method: 'POST',
+        payload: { targetCelsius: 96 }
+      });
+    });
+
+    // Wire up Companion Desktop Brewing Helper controls (targetAddressSpace: 'loopback')
+    const loopbackInput = document.getElementById('loopback-endpoint-input');
+    const loopbackConnectBtn = document.getElementById('loopback-connect-btn');
+    const loopbackStatusPill = document.getElementById('loopback-status-pill');
+    const loopbackTelemetry = document.getElementById('loopback-telemetry');
+    const loopbackPermState = document.getElementById('loopback-perm-state');
+    const loopbackCheckPermBtn = document.getElementById('loopback-check-perm-btn');
+
+    function connectLoopbackHelper(customPathOrMethod = {}) {
+      const baseUrl = loopbackInput.value.trim() || 'http://127.0.0.1:8765/api/status';
+      const url = customPathOrMethod.url || baseUrl;
+      return requestEquipmentEndpoint({
+        url,
+        targetAddressSpace: 'loopback',
+        method: customPathOrMethod.method || 'GET',
+        payload: customPathOrMethod.payload || null,
+        statusPill: loopbackStatusPill,
+        telemetryBox: loopbackTelemetry,
+        deviceLabel: 'Companion Desktop Brewing Helper (127.0.0.1)'
+      });
+    }
+
+    loopbackConnectBtn.addEventListener('click', () => connectLoopbackHelper());
+    loopbackCheckPermBtn.addEventListener('click', () =>
+      checkNetworkPermission('loopback-network', loopbackPermState)
+    );
+
+    document.getElementById('loopback-sync-btn').addEventListener('click', () => {
+      const currentOrigin = (() => {
+        try { return new URL(loopbackInput.value.trim()).origin; } catch (_) { return 'http://127.0.0.1:8765'; }
+      })();
+      connectLoopbackHelper({
+        url: `${currentOrigin}/api/recipes/sync`,
+        method: 'POST',
+        payload: { recipes: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'] }
+      });
+    });
+
+    document.getElementById('loopback-scale-btn').addEventListener('click', () => {
+      const currentOrigin = (() => {
+        try { return new URL(loopbackInput.value.trim()).origin; } catch (_) { return 'http://127.0.0.1:8765'; }
+      })();
+      connectLoopbackHelper({
+        url: `${currentOrigin}/api/telemetry`,
+        method: 'GET'
+      });
+    });
+
+    document.getElementById('loopback-tare-btn').addEventListener('click', () => {
+      const currentOrigin = (() => {
+        try { return new URL(loopbackInput.value.trim()).origin; } catch (_) { return 'http://127.0.0.1:8765'; }
+      })();
+      connectLoopbackHelper({
+        url: `${currentOrigin}/api/scale/tare`,
+        method: 'POST',
+        payload: { zero: true }
+      });
+    });
+
+    // Check initial Local Network Access permission states on load
+    checkNetworkPermission('local-network', lanPermState);
+    checkNetworkPermission('loopback-network', loopbackPermState);
+  </script>
