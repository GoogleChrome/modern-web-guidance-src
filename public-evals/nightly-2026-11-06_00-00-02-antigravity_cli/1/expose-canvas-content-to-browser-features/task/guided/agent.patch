+  <script>
+    (function () {
+      const stage = document.getElementById('customizer-stage');
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const uiElement = document.getElementById('ui-element');
+      const sleeveBadge = document.getElementById('cup-sleeve-badge');
+
+      const nameInput = document.getElementById('cup-name-input');
+      const milkSelect = document.getElementById('milk-select');
+      const syrupSelect = document.getElementById('syrup-select');
+      const sleeveNameDisplay = document.getElementById('sleeve-name-display');
+      const sleeveMetaDisplay = document.getElementById('sleeve-meta-display');
+      const orderLiveText = document.getElementById('order-live-text');
+
+      const milkColors = {
+        'Oat Milk': '#eadbc8',
+        'Whole Milk': '#f7f1e5',
+        'Almond Milk': '#e6d2b5',
+        'Coconut Milk': '#f4f6f0',
+        'Soy Milk': '#efe3cc'
+      };
+
+      const syrupColors = {
+        'Vermont Maple': '#b85d19',
+        'Vanilla Bean': '#f3cf7a',
+        'Salted Caramel': '#c67a27',
+        'Toasted Hazelnut': '#8d5524',
+        'No Syrup': 'transparent'
+      };
+
+      function getOrderState() {
+        const rawName = nameInput.value.trim();
+        return {
+          cupName: rawName.length > 0 ? rawName : 'Guest',
+          milk: milkSelect.value,
+          syrup: syrupSelect.value
+        };
+      }
+
+      function syncOrderText() {
+        const { cupName, milk, syrup } = getOrderState();
+        sleeveNameDisplay.textContent = cupName;
+        sleeveMetaDisplay.textContent = `${milk} \u2022 ${syrup}`;
+        orderLiveText.replaceChildren();
+
+        const prefix = document.createTextNode('Cup for ');
+        const nameStrong = document.createElement('strong');
+        nameStrong.textContent = cupName;
+        const mid1 = document.createTextNode(': Signature Espresso with ');
+        const milkStrong = document.createElement('strong');
+        milkStrong.textContent = milk;
+        const mid2 = document.createTextNode(' and ');
+        const syrupStrong = document.createElement('strong');
+        syrupStrong.textContent = syrup;
+        const suffix = document.createTextNode(syrup === 'No Syrup' ? '.' : ' syrup.');
+
+        orderLiveText.append(prefix, nameStrong, mid1, milkStrong, mid2, syrupStrong, suffix);
+      }
+
+      function drawCoffeeScene() {
+        const cssWidth = canvas.clientWidth || 920;
+        const cssHeight = canvas.clientHeight || 440;
+        const scaleX = canvas.width / cssWidth;
+        const scaleY = canvas.height / cssHeight;
+
+        ctx.save();
+        ctx.scale(scaleX, scaleY);
+
+        // Warm café backdrop
+        const bgGrad = ctx.createLinearGradient(0, 0, cssWidth, cssHeight);
+        bgGrad.addColorStop(0, '#fff8f2');
+        bgGrad.addColorStop(1, '#f3e5dc');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+        // Countertop surface
+        ctx.fillStyle = '#d7ccc8';
+        ctx.fillRect(0, cssHeight - 54, cssWidth, 54);
+
+        const { milk, syrup } = getOrderState();
+        const cupCenterX = 220;
+        const cupTopY = 120;
+        const cupBottomY = 365;
+        const topHalfWidth = 86;
+        const bottomHalfWidth = 62;
+
+        // Steam wisps
+        ctx.strokeStyle = 'rgba(78, 52, 46, 0.22)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-30, 0, 30].forEach((offset, idx) => {
+          ctx.beginPath();
+          ctx.moveTo(cupCenterX + offset, cupTopY - 26);
+          ctx.bezierCurveTo(
+            cupCenterX + offset - 12,
+            cupTopY - 48,
+            cupCenterX + offset + 14,
+            cupTopY - 68,
+            cupCenterX + offset - 2,
+            cupTopY - 88 - idx * 4
+          );
+          ctx.stroke();
+        });
+
+        // Cup shadow
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.16)';
+        ctx.beginPath();
+        ctx.ellipse(cupCenterX, cupBottomY + 6, bottomHalfWidth + 18, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Cup body
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX - topHalfWidth, cupTopY);
+        ctx.lineTo(cupCenterX + topHalfWidth, cupTopY);
+        ctx.lineTo(cupCenterX + bottomHalfWidth, cupBottomY);
+        ctx.lineTo(cupCenterX - bottomHalfWidth, cupBottomY);
+        ctx.closePath();
+        ctx.fillStyle = '#fffdf9';
+        ctx.fill();
+        ctx.lineWidth = 3;
+        ctx.strokeStyle = '#4e342e';
+        ctx.stroke();
+
+        // Milk & Espresso interior preview band near top of cup
+        ctx.save();
+        ctx.clip();
+        ctx.fillStyle = milkColors[milk] || '#eadbc8';
+        ctx.fillRect(cupCenterX - topHalfWidth, cupTopY + 8, topHalfWidth * 2, 54);
+
+        if (syrup !== 'No Syrup') {
+          ctx.strokeStyle = syrupColors[syrup] || '#b85d19';
+          ctx.lineWidth = 5;
+          ctx.beginPath();
+          for (let x = cupCenterX - topHalfWidth + 12; x <= cupCenterX + topHalfWidth - 12; x += 24) {
+            ctx.moveTo(x, cupTopY + 18);
+            ctx.quadraticCurveTo(x + 6, cupTopY + 34, x + 12, cupTopY + 20);
+          }
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Kraft cardboard sleeve
+        const sleeveTopY = 200;
+        const sleeveBottomY = 296;
+        const sleeveTopHalf = 78;
+        const sleeveBottomHalf = 68;
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX - sleeveTopHalf, sleeveTopY);
+        ctx.lineTo(cupCenterX + sleeveTopHalf, sleeveTopY);
+        ctx.lineTo(cupCenterX + sleeveBottomHalf, sleeveBottomY);
+        ctx.lineTo(cupCenterX - sleeveBottomHalf, sleeveBottomY);
+        ctx.closePath();
+        ctx.fillStyle = '#c89f72';
+        ctx.fill();
+        ctx.lineWidth = 2;
+        ctx.strokeStyle = '#6d4c41';
+        ctx.stroke();
+
+        // Coffee lid
+        ctx.fillStyle = '#4e342e';
+        ctx.beginPath();
+        ctx.roundRect(cupCenterX - topHalfWidth - 8, cupTopY - 18, (topHalfWidth + 8) * 2, 20, 6);
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.beginPath();
+        ctx.roundRect(cupCenterX - topHalfWidth + 10, cupTopY - 28, (topHalfWidth - 10) * 2, 12, 4);
+        ctx.fill();
+
+        ctx.restore();
+      }
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          drawCoffeeScene();
+
+          const cssWidth = canvas.clientWidth || 920;
+          const scaleX = canvas.width / cssWidth;
+          const scaleY = canvas.height / (canvas.clientHeight || 440);
+          ctx.save();
+          ctx.scale(scaleX, scaleY);
+
+          const panelX = Math.max(380, cssWidth - uiElement.offsetWidth - 36);
+          const panelY = 36;
+          ctx.drawElementImage(sleeveBadge, 142, 222);
+          ctx.drawElementImage(uiElement, panelX, panelY);
+          ctx.restore();
+        };
+      } else {
+        // Fallback strategy: place the HTML content on top of the canvas using CSS
+        stage.classList.add('canvas-fallback');
+        stage.append(sleeveBadge, uiElement);
+      }
+
+      function requestSceneUpdate() {
+        syncOrderText();
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          ctx.reset();
+          drawCoffeeScene();
+        }
+      }
+
+      nameInput.addEventListener('input', requestSceneUpdate);
+      milkSelect.addEventListener('change', requestSceneUpdate);
+      syrupSelect.addEventListener('change', requestSceneUpdate);
+
+      // Scale canvas grid to match the device scale factor to prevent blurriness
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestSceneUpdate();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      syncOrderText();
+    })();
+  </script>
 </body>
 
