+  <script>
+    (function () {
+      const totalCups = 10;
+      let currentCups = 7;
+      const circumference = 2 * Math.PI * 80;
+
+      const circle = document.getElementById('rewards-progress-circle');
+      const countEl = document.getElementById('rewards-count');
+      const remainingEl = document.getElementById('rewards-remaining');
+      const percentTextEl = document.getElementById('rewards-percent-text');
+      const headlineEl = document.getElementById('rewards-headline');
+      const progressBar = document.querySelector('.progress-ring-container');
+      const addStampBtn = document.getElementById('add-stamp-btn');
+
+      function updateRing() {
+        const ratio = currentCups / totalCups;
+        const offset = circumference * (1 - ratio);
+        circle.style.strokeDasharray = circumference.toFixed(2);
+        circle.style.strokeDashoffset = offset.toFixed(2);
+        countEl.textContent = currentCups + ' / ' + totalCups;
+        progressBar.setAttribute('aria-valuenow', String(currentCups));
+
+        const remaining = totalCups - currentCups;
+        const pct = Math.round(ratio * 100);
+        if (remaining === 0) {
+          remainingEl.textContent = 'Free Drink Ready!';
+          headlineEl.textContent = 'Congratulations! Your Free Drink Is Ready to Redeem!';
+          addStampBtn.textContent = 'Start New Card';
+        } else {
+          remainingEl.textContent = remaining + ' to Free Drink';
+          headlineEl.textContent = 'Almost at Your Next Free Handcrafted Drink!';
+          addStampBtn.textContent = 'Log Drink Purchase (+1)';
+        }
+        if (percentTextEl && percentTextEl.previousElementSibling) {
+          percentTextEl.previousElementSibling.textContent = pct + '% Complete';
+          percentTextEl.textContent = currentCups + ' of ' + totalCups + ' drinks purchased';
+        }
+      }
+
+      if (addStampBtn) {
+        addStampBtn.addEventListener('click', function () {
+          currentCups = currentCups >= totalCups ? 1 : currentCups + 1;
+          updateRing();
+        });
+      }
+    })();
+  </script>
