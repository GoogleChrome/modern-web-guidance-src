+    /* Loyalty Rewards Section */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .rewards-section {
+      margin-top: 50px;
+    }
+
+    .rewards-card {
+      background: white;
+      padding: 35px 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      margin-top: 20px;
+      border-top: 4px solid var(--accent);
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex-shrink: 0;
+    }
+
+    progress.progress-ring {
+      --size: 160px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      width: var(--size);
+      height: var(--size);
+      appearance: none;
+      -webkit-appearance: none;
+      border-radius: 50%;
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) * 1%),
+        var(--track-color) 0
+      );
+      background-clip: border-area;
+      border: var(--thickness) solid transparent;
+      background-origin: border-box;
+      transition: --value 0s ease-in-out;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition-duration: 0.4s;
+      }
+
+      @supports not (background-clip: border-area) {
+        mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+        border: 0;
+      }
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value,
+    progress.progress-ring::-moz-progress-bar,
+    progress.progress-ring::slider-fill {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring[value="100"] {
+      --fill-color: var(--primary);
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      line-height: 1.2;
+      pointer-events: none;
+    }
+
+    .progress-ring-count {
+      font-size: 1.75rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .progress-ring-label {
+      font-size: 0.8rem;
+      color: var(--text);
+      margin-top: 4px;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+
+    .rewards-details {
+      flex: 1;
+      min-width: 260px;
+      max-width: 520px;
+    }
+
+    .rewards-details h3 {
