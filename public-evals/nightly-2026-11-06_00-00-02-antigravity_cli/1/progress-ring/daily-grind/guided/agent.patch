+  <script>
+    (function () {
+      const progress = document.getElementById('loyalty-progress');
+      const countEl = document.getElementById('loyalty-count');
+      const percentEl = document.getElementById('loyalty-percent');
+      const statusTextEl = document.getElementById('loyalty-status-text');
+      const addStampBtn = document.getElementById('add-stamp-btn');
+
+      if (!progress) return;
+
+      if (!CSS.supports('width: attr(value type(<number>))')) {
+        progress.style.setProperty('--value', progress.getAttribute('value'));
+        const observer = new MutationObserver(() => {
+          progress.style.setProperty('--value', progress.getAttribute('value'));
+        });
+        observer.observe(progress, {
+          attributes: true,
+          attributeFilter: ['value'],
+        });
+      }
+
+      const maxCups = 10;
+      let currentCups = 7;
+
+      if (addStampBtn) {
+        addStampBtn.addEventListener('click', () => {
+          currentCups = currentCups < maxCups ? currentCups + 1 : 1;
+          const percentage = Math.round((currentCups / maxCups) * 100);
+          progress.setAttribute('value', String(percentage));
+          countEl.textContent = `${currentCups} / ${maxCups}`;
+          percentEl.textContent = `${percentage}% • Cups`;
+
+          const remaining = maxCups - currentCups;
+          if (remaining === 0) {
+            statusTextEl.innerHTML = '<strong>Congratulations!</strong> You have unlocked a <strong>free handcrafted drink</strong> on your next visit!';
+            addStampBtn.textContent = 'Redeem & Reset';
+          } else {
+            statusTextEl.innerHTML = `You're only <strong>${remaining} ${remaining === 1 ? 'cup' : 'cups'} away</strong> from unlocking your next handcrafted beverage on the house! Earn 1 cup stamp with every qualifying purchase.`;
+            addStampBtn.textContent = 'Log a Cup (+1)';
+          }
+        });
+      }
+    })();
+  </script>
