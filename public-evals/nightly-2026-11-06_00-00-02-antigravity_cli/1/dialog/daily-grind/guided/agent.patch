+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        price: '$5.50',
+        calories: '190 cal',
+        caffeine: '150 mg caffeine',
+        description: 'Creamy steamed oat milk blended with rich espresso and pure Grade A Vermont maple syrup, topped with a light dusting of cinnamon.',
+        notes: 'Toasted oat, warm maple, caramel finish.',
+        defaultMilk: 'Oat Milk',
+        defaultTemp: 'Hot'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        price: '$3.75',
+        calories: '15 cal',
+        caffeine: '185 mg caffeine',
+        description: 'Bold, smokey double-shot pulled from freshly ground Sumatra and Colombian dark-roasted beans for a rich crema and intense morning boost.',
+        notes: 'Dark chocolate, roasted walnut, smokey cedar.',
+        defaultMilk: 'No Milk / Black',
+        defaultTemp: 'Hot'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        price: '$4.75',
+        calories: '10 cal',
+        caffeine: '200 mg caffeine',
+        description: 'Coarse-ground Ethiopian beans steeped in filtered cold water for 18 hours for maximum smoothness and naturally low acidity.',
+        notes: 'Sweet cocoa, dark berry, velvety finish.',
+        defaultMilk: 'No Milk / Black',
+        defaultTemp: 'Iced'
+      }
+    };
+
+    const dialog = document.getElementById('drink-modal');
+    const titleEl = document.getElementById('drink-modal-title');
+    const priceEl = document.getElementById('drink-modal-price');
+    const caloriesEl = document.getElementById('drink-modal-calories');
+    const caffeineEl = document.getElementById('drink-modal-caffeine');
+    const descEl = document.getElementById('drink-modal-description');
+    const notesEl = document.getElementById('drink-modal-notes');
+    const drinkSelect = document.getElementById('order-drink-select');
+    const milkSelect = document.getElementById('order-milk-select');
+    const tempHot = document.getElementById('temp-hot');
+    const tempIced = document.getElementById('temp-iced');
+    const orderStatus = document.getElementById('order-status');
+    const orderForm = document.getElementById('drink-order-form');
+
+    function populateDrinkDetails(drinkId) {
+      const drink = DRINKS[drinkId] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      priceEl.textContent = drink.price;
+      caloriesEl.textContent = drink.calories;
+      caffeineEl.textContent = drink.caffeine;
+      descEl.textContent = drink.description;
+      notesEl.textContent = '';
+      const strong = document.createElement('strong');
+      strong.textContent = 'Tasting Notes: ';
+      notesEl.append(strong, drink.notes);
+
+      drinkSelect.value = drinkId in DRINKS ? drinkId : 'maple-oat-latte';
+      milkSelect.value = drink.defaultMilk;
+      if (drink.defaultTemp === 'Iced') {
+        tempIced.checked = true;
+      } else {
+        tempHot.checked = true;
+      }
+    }
+
+    drinkSelect.addEventListener('change', (event) => {
+      populateDrinkDetails(event.target.value);
+    });
+
+    document.querySelectorAll('[data-drink]').forEach((button) => {
+      button.addEventListener('click', () => {
+        populateDrinkDetails(button.dataset.drink);
+        if (!('commandForElement' in HTMLButtonElement.prototype) && !dialog.open) {
+          dialog.showModal();
+        }
+      });
+    });
+
+    const closeIconBtn = dialog.querySelector('.dialog-close-icon');
+    closeIconBtn.addEventListener('click', () => {
+      if (!('commandForElement' in HTMLButtonElement.prototype) && dialog.open) {
+        dialog.close('cancel');
+      }
+    });
+
+    // Fallback for browsers without closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dlg.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dlg);
+        });
+        dlg.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dlg)) dlg.close();
+        });
+      }
+    }
+
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (action === 'order') {
+        const formData = new FormData(orderForm);
+        const drinkKey = formData.get('drink');
+        const drinkName = DRINKS[drinkKey]?.name || 'Coffee';
+        const size = formData.get('size');
+        const milk = formData.get('milk');
+        const temp = formData.get('temperature');
+        const qty = formData.get('quantity');
+
+        const banner = document.createElement('p');
+        banner.className = 'order-status-banner';
+        banner.textContent = `Added ${qty}x ${size} ${temp} ${drinkName} (${milk}) to your order.`;
+        orderStatus.replaceChildren(banner);
+      }
+    });
+  </script>
+
 </body>
 
 </html>
