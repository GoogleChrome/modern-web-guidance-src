+      track.addEventListener('touchmove', (e) => {
+        if (e.touches.length === 1) moveDrag(e.touches[0].clientX);
+      }, { passive: true });
+      track.addEventListener('touchend', endDrag);
+
+      updateCarouselUI(0);
+
+      /* Expanding Detail View right out of the triggering "View Details" button */
+      const overlay = document.getElementById('drink-detail-overlay');
+      const detailView = document.getElementById('drink-detail-view');
+      const backdrop = document.getElementById('detail-backdrop');
+      const closeBtn = document.getElementById('detail-close-btn');
+      const dismissBtn = document.getElementById('detail-dismiss-btn');
+      const orderBtn = document.getElementById('detail-order-btn');
+      const sizeBtns = Array.from(detailView.querySelectorAll('.size-btn'));
+
+      const detailImage = document.getElementById('detail-image');
+      const detailBadge = document.getElementById('detail-badge');
+      const detailTitle = document.getElementById('detail-title');
+      const detailPrice = document.getElementById('detail-price');
+      const detailDesc = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+      const detailOrigin = document.getElementById('detail-origin');
+      const detailNutrition = document.getElementById('detail-nutrition');
+
+      let activeTriggerBtn = null;
+      let activeCard = null;
+      let closeTimer = null;
+
+      function applyTriggerGeometry(triggerEl) {
+        if (!triggerEl) return;
+        const btnRect = triggerEl.getBoundingClientRect();
+
+        // Temporarily ensure detailView has layout box without transform distortion
+        const prevTransition = detailView.style.transition;
+        const prevTransform = detailView.style.transform;
+        detailView.style.transition = 'none';
+        detailView.style.transform = 'none';
+        const panelRect = detailView.getBoundingClientRect();
+
+        const panelWidth = panelRect.width || 640;
+        const panelHeight = panelRect.height || 520;
+        const panelLeft = panelRect.left || (window.innerWidth - panelWidth) / 2;
+        const panelTop = panelRect.top || (window.innerHeight - panelHeight) / 2;
+
+        const btnCenterX = btnRect.left + btnRect.width / 2;
+        const btnCenterY = btnRect.top + btnRect.height / 2;
+        const panelCenterX = panelLeft + panelWidth / 2;
+        const panelCenterY = panelTop + panelHeight / 2;
+
+        const originX = btnCenterX - panelLeft;
+        const originY = btnCenterY - panelTop;
+        const dx = btnCenterX - panelCenterX;
+        const dy = btnCenterY - panelCenterY;
+        const sx = Math.max(0.08, +(btnRect.width / panelWidth).toFixed(4));
+        const sy = Math.max(0.08, +(btnRect.height / panelHeight).toFixed(4));
+
+        detailView.style.setProperty('--origin-x', `${originX}px`);
+        detailView.style.setProperty('--origin-y', `${originY}px`);
+        detailView.style.setProperty('--flip-dx', `${dx}px`);
+        detailView.style.setProperty('--flip-dy', `${dy}px`);
+        detailView.style.setProperty('--flip-sx', `${sx}`);
+        detailView.style.setProperty('--flip-sy', `${sy}`);
+        detailView.style.transformOrigin = `${originX}px ${originY}px`;
+
+        detailView.style.transform = prevTransform;
+        detailView.offsetHeight; // Force reflow
+        detailView.style.transition = prevTransition;
+      }
+
+      function openDetailView(drinkId, triggerBtn) {
+        const data = DRINK_DATA[drinkId];
+        if (!data) return;
+
+        if (closeTimer) {
+          clearTimeout(closeTimer);
+          closeTimer = null;
+        }
+
+        if (activeTriggerBtn) {
+          activeTriggerBtn.setAttribute('aria-expanded', 'false');
+        }
+        if (activeCard) {
+          activeCard.classList.remove('is-expanded');
+        }
+
+        activeTriggerBtn = triggerBtn;
+        activeCard = triggerBtn.closest('.card');
+
+        triggerBtn.setAttribute('aria-expanded', 'true');
+        if (activeCard) {
+          activeCard.classList.add('is-expanded');
+        }
+
+        // Populate detail content
+        detailImage.src = data.image;
+        detailImage.alt = data.imageAlt;
+        detailBadge.textContent = data.badge;
+        detailTitle.textContent = data.title;
+        detailPrice.textContent = data.price;
+        detailDesc.textContent = data.description;
+        detailNotes.textContent = data.notes;
+        detailOrigin.textContent = data.origin;
+        detailNutrition.textContent = data.nutrition;
+        orderBtn.textContent = `Add ${data.title} to Order`;
+
+        overlay.classList.remove('is-open');
+        overlay.classList.add('is-active');
+        overlay.setAttribute('aria-hidden', 'false');
+
+        applyTriggerGeometry(triggerBtn);
+
+        requestAnimationFrame(() => {
+          overlay.classList.add('is-open');
+          closeBtn.focus({ preventScroll: true });
+        });
+      }
+
+      function closeDetailView() {
+        if (!overlay.classList.contains('is-active')) return;
+
+        if (activeTriggerBtn) {
+          applyTriggerGeometry(activeTriggerBtn);
+          activeTriggerBtn.setAttribute('aria-expanded', 'false');
+        }
+        if (activeCard) {
+          activeCard.classList.remove('is-expanded');
+        }
+
+        overlay.classList.remove('is-open');
+        overlay.setAttribute('aria-hidden', 'true');
+
+        const btnToFocus = activeTriggerBtn;
+        closeTimer = setTimeout(() => {
+          overlay.classList.remove('is-active');
+          if (btnToFocus) {
+            btnToFocus.focus({ preventScroll: true });
+          }
+        }, 420);
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          const drinkId = btn.getAttribute('data-drink-id');
+          openDetailView(drinkId, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDetailView);
+      dismissBtn.addEventListener('click', closeDetailView);
+      backdrop.addEventListener('click', closeDetailView);
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
+          btn.setAttribute('aria-pressed', 'true');
+        });
+      });
+
+      orderBtn.addEventListener('click', () => {
+        const selectedSize = detailView.querySelector('.size-btn[aria-pressed="true"]')?.dataset.size || 'Tall (12oz)';
+        orderBtn.textContent = `Added (${selectedSize}) ✓`;
+        setTimeout(() => {
+          closeDetailView();
+        }, 550);
+      });
+
+      // Keyboard Escape & Focus Trap inside Detail View
+      document.addEventListener('keydown', (e) => {
+        if (!overlay.classList.contains('is-active')) return;
+
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeDetailView();
+          return;
+        }
+
+        if (e.key === 'Tab') {
+          const focusables = Array.from(
+            detailView.querySelectorAll('button:not(:disabled), [href], [tabindex]:not([tabindex="-1"])')
+          );
+          if (focusables.length === 0) return;
+          const first = focusables[0];
+          const last = focusables[focusables.length - 1];
+
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
+  </script>
+
 </body>
 
