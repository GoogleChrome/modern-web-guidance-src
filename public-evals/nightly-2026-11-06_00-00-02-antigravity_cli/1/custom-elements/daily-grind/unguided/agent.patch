+    } else {
+      this.setAttribute('calories', String(num));
+    }
+  }
+
+  get rating() {
+    const val = parseFloat(this.getAttribute('rating'));
+    return Number.isFinite(val) ? Math.min(5, Math.max(0, val)) : 0;
+  }
+
+  set rating(value) {
+    const num = Number(value);
+    if (value === null || value === undefined || value === '' || !Number.isFinite(num)) {
+      this.removeAttribute('rating');
+    } else {
+      const clamped = Math.min(5, Math.max(0, num));
+      this.setAttribute('rating', String(clamped));
+    }
+  }
