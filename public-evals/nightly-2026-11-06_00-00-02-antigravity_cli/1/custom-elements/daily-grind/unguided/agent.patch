+  }
+
+  disconnectedCallback() {
+    this._isConnected = false;
+    this._cleanupEventListeners();
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:disconnected', {
+        bubbles: true,
+        composed: true,
+        detail: { card: this, name: this.name }
+      })
+    );
+  }
+
+  adoptedCallback() {
+    if (this._isConnected) {
+      this._cleanupEventListeners();
+      this.render();
+      this._setupEventListeners();
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+
+    if (this._isConnected) {
+      this.render();
+      this._setupEventListeners();
+
+      this.dispatchEvent(
+        new CustomEvent('coffee-card:attribute-changed', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            card: this,
+            attribute: name,
+            oldValue,
+            newValue
+          }
+        })
+      );
+    }
+  }
+
+  // ==========================================
+  // Internal Lifecycle & Event Management
+  // ==========================================
+
+  _upgradeProperties() {
+    const props = [
+      'name',
+      'title',
+      'description',
+      'href',
+      'actionText',
+      'category',
+      'roastLevel',
+      'origin',
+      'notes',
+      'image',
+      'price',
+      'calories',
+      'rating',
+      'caffeineMg',
+      'featured',
+      'seasonal',
+      'inStock',
+      'soldOut',
+      'iced',
+      'decaf',
+      'vegan',
+      'disabled'
+    ];
+
+    for (const prop of props) {
+      if (Object.prototype.hasOwnProperty.call(this, prop)) {
+        const value = this[prop];
+        delete this[prop];
+        this[prop] = value;
+      }
+    }
+  }
+
+  _cleanupEventListeners() {
+    if (this._abortController) {
+      this._abortController.abort();
+      this._abortController = null;
+    }
+  }
+
+  _setupEventListeners() {
+    this._cleanupEventListeners();
