+  }
+
+  set inStock(value) {
+    const boolVal = Boolean(value);
+    this.toggleAttribute('in-stock', boolVal);
+    if (boolVal && this.hasAttribute('sold-out')) {
+      this.removeAttribute('sold-out');
+    }
+  }
+
+  get soldOut() {
+    return this.hasAttribute('sold-out');
+  }
+
+  set soldOut(value) {
+    const boolVal = Boolean(value);
+    this.toggleAttribute('sold-out', boolVal);
+    if (boolVal && this.hasAttribute('in-stock')) {
+      this.removeAttribute('in-stock');
+    }
+  }
