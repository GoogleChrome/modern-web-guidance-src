+              ${featured ? '<span class="badge featured">Featured</span>' : ''}
+              ${seasonal ? '<span class="badge seasonal">Seasonal</span>' : ''}
+              ${iced ? '<span class="badge iced">Iced</span>' : ''}
+              ${decaf ? '<span class="badge decaf">Decaf</span>' : ''}
+              ${vegan ? '<span class="badge vegan">Vegan</span>' : ''}
+              ${soldOut ? '<span class="badge sold-out">Sold Out</span>' : ''}
+            </div>
+          `
+              : ''
+          }
+
+          <div class="card-header">
+            <div>
+              ${category ? `<span class="category-label">${category}</span>` : ''}
+              <h3 part="title">${name}</h3>
+            </div>
+            ${formattedPrice ? `<span class="price-tag" part="price">${formattedPrice}</span>` : ''}
+          </div>
+
+          ${
+            rating > 0
+              ? `
+            <div class="rating-row" part="rating" aria-label="Rating ${rating} out of 5">
+              <span class="stars">${this._renderStars(rating)}</span>
+              <span>${rating.toFixed(1)}</span>
+            </div>
+          `
+              : ''
+          }
+
+          <p class="description" part="description">${description}</p>
+
+          ${
+            notesList.length > 0
+              ? `
+            <div class="notes-list" part="notes">
+              ${notesList.map((note) => `<span class="note-pill">${note}</span>`).join('')}
+            </div>
+          `
+              : ''
+          }
+
+          ${
+            roastLevel || origin || calories > 0 || caffeineMg > 0 || this.hasAttribute('in-stock') || soldOut
+              ? `
+            <div class="meta-grid" part="meta">
+              ${
+                roastLevel
+                  ? `<div class="meta-item"><span class="meta-label">Roast</span><span class="meta-value">${roastLevel}</span></div>`
+                  : ''
+              }
+              ${
+                origin
+                  ? `<div class="meta-item"><span class="meta-label">Origin</span><span class="meta-value">${origin}</span></div>`
+                  : ''
+              }
+              ${
+                calories > 0
+                  ? `<div class="meta-item"><span class="meta-label">Calories</span><span class="meta-value">${calories} kcal</span></div>`
+                  : ''
+              }
+              ${
+                caffeineMg > 0 || decaf
+                  ? `<div class="meta-item"><span class="meta-label">Caffeine</span><span class="meta-value">${caffeineMg} mg</span></div>`
+                  : ''
+              }
+              <div class="meta-item">
+                <span class="meta-label">Status</span>
+                <span class="meta-value">${soldOut ? 'Sold Out' : inStock ? 'In Stock' : 'Available'}</span>
+              </div>
+            </div>
+          `
+              : ''
+          }
+
+          <slot></slot>
+
+          <div class="actions" part="actions">
+            <a
+              href="${isUnavailable ? '#' : href}"
+              class="btn details-btn ${isUnavailable ? 'disabled' : ''}"
+              part="button"
+              ${isUnavailable ? 'aria-disabled="true" tabindex="-1"' : ''}
+            >
+              ${soldOut ? 'Sold Out' : actionText}
+            </a>
+            <button
+              type="button"
+              class="btn secondary quick-add-btn"
+              part="quick-add"
+              ${isUnavailable ? 'disabled' : ''}
+              title="${soldOut ? 'Currently out of stock' : `Add ${name} to order`}"
+            >
+              + Order
+            </button>
+          </div>
+        </div>
+      </article>
+    `;
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.CoffeeCard = CoffeeCard;
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', CoffeeCard);
+  }
+}
+
+export { CoffeeCard };
