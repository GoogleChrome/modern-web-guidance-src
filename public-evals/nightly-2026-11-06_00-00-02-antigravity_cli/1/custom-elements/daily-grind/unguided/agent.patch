+  <script type="module">
+    const grid = document.getElementById('coffee-grid');
+    const orderStatus = document.getElementById('order-status');
+    const filterAllBtn = document.getElementById('filter-all');
+    const filterFeaturedBtn = document.getElementById('filter-featured');
+    const toggleIcedBtn = document.getElementById('toggle-iced');
+    const discountBtn = document.getElementById('discount-btn');
+
+    let cartCount = 0;
+    let cartTotal = 0;
+    let discountApplied = false;
+
+    grid.addEventListener('coffee-card:order', (event) => {
+      const { name, price } = event.detail;
+      cartCount += 1;
+      cartTotal += price;
+      orderStatus.textContent = `Cart: ${cartCount} item${cartCount === 1 ? '' : 's'} ($${cartTotal.toFixed(2)}) — Added ${name}`;
+    });
+
+    filterAllBtn.addEventListener('click', () => {
+      filterAllBtn.classList.add('active');
+      filterFeaturedBtn.classList.remove('active');
+      grid.querySelectorAll('coffee-card').forEach((card) => {
+        card.hidden = false;
+      });
+    });
+
+    filterFeaturedBtn.addEventListener('click', () => {
+      filterFeaturedBtn.classList.add('active');
+      filterAllBtn.classList.remove('active');
+      grid.querySelectorAll('coffee-card').forEach((card) => {
+        card.hidden = !card.featured;
+      });
+    });
+
+    toggleIcedBtn.addEventListener('click', () => {
+      const coldBrew = grid.querySelector('coffee-card[name="Cold Brew"]');
+      if (coldBrew) {
+        coldBrew.iced = !coldBrew.iced;
+      }
+    });
+
+    discountBtn.addEventListener('click', () => {
+      const cards = grid.querySelectorAll('coffee-card');
+      cards.forEach((card) => {
+        const delta = discountApplied ? 0.5 : -0.5;
+        card.price = Number((card.price + delta).toFixed(2));
+      });
+      discountApplied = !discountApplied;
+      discountBtn.textContent = discountApplied
+        ? 'Restore Regular Prices'
+        : 'Apply $0.50 Happy Hour';
+    });
+  </script>
+
