+  // ==========================================
+  // Numeric Attributes / Properties Reflection
+  // ==========================================
+
+  get price() {
+    const val = parseFloat(this.getAttribute('price'));
+    return Number.isFinite(val) ? val : 0;
+  }
+
+  set price(value) {
+    const num = Number(value);
+    if (value === null || value === undefined || value === '' || !Number.isFinite(num)) {
