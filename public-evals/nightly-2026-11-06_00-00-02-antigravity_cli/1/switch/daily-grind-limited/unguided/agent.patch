+  <script>
+    (function () {
+      const STORAGE_KEY = 'dailyGrind_orderNotifications';
+      const toggleInput = document.getElementById('preference-toggle');
+      const stateBadge = document.getElementById('preference-state');
+      const preferenceCard = document.getElementById('preference-card');
+
+      function applyPreferenceState(isEnabled) {
+        toggleInput.checked = isEnabled;
+        toggleInput.setAttribute('aria-checked', String(isEnabled));
+        stateBadge.textContent = isEnabled ? 'On' : 'Off';
+        preferenceCard.classList.toggle('is-enabled', isEnabled);
+        preferenceCard.setAttribute('data-state', isEnabled ? 'on' : 'off');
+      }
+
+      try {
+        const saved = localStorage.getItem(STORAGE_KEY);
+        if (saved === 'on' || saved === 'true') {
+          applyPreferenceState(true);
+        } else {
+          applyPreferenceState(false);
+        }
+      } catch (e) {
+        applyPreferenceState(false);
+      }
+
+      toggleInput.addEventListener('change', function () {
+        const isEnabled = toggleInput.checked;
+        applyPreferenceState(isEnabled);
+        try {
+          localStorage.setItem(STORAGE_KEY, isEnabled ? 'on' : 'off');
+        } catch (e) {
+          // Ignore storage errors in restricted environments
+        }
+      });
+
+      toggleInput.addEventListener('keydown', function (event) {
+        if (event.key === 'Enter') {
+          event.preventDefault();
+          toggleInput.checked = !toggleInput.checked;
+          toggleInput.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      });
+    })();
+  </script>
+
