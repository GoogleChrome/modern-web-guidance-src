+  <script>
+    const notificationSwitch = document.getElementById('notifications');
+    const notificationStatus = document.getElementById('notifications-status');
+    const STORAGE_KEY = 'daily_grind_roast_notifications';
+
+    const savedPreference = localStorage.getItem(STORAGE_KEY);
+    if (savedPreference !== null) {
+      notificationSwitch.checked = savedPreference === 'true';
+    }
+
+    function updatePreferenceStatus(isEnabled) {
+      notificationStatus.textContent = isEnabled
+        ? 'Roast drop notifications are enabled.'
+        : 'Roast drop notifications are currently off.';
+    }
+
+    updatePreferenceStatus(notificationSwitch.checked);
+
+    notificationSwitch.addEventListener('change', (event) => {
+      const isEnabled = event.target.checked;
+      localStorage.setItem(STORAGE_KEY, String(isEnabled));
+      updatePreferenceStatus(isEnabled);
+    });
+  </script>
