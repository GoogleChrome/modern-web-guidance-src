+  <script type="importmap">
+    {
+      "imports": {
+        "input-switch-polyfill": "https://esm.sh/input-switch-polyfill"
+      }
+    }
+  </script>
+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const notificationsToggle = document.getElementById('notifications');
+    const preferenceStatus = document.getElementById('preference-status');
+    const STORAGE_KEY = 'daily_grind_notifications_enabled';
+
+    if (notificationsToggle && preferenceStatus) {
+      const savedPreference = localStorage.getItem(STORAGE_KEY);
+      if (savedPreference !== null) {
+        notificationsToggle.checked = savedPreference === 'true';
+      }
+
+      const updateStatus = () => {
+        const isEnabled = notificationsToggle.checked;
+        preferenceStatus.textContent = isEnabled
+          ? 'Notifications are enabled.'
+          : 'Notifications are currently off.';
+      };
+
+      updateStatus();
+
+      notificationsToggle.addEventListener('change', () => {
+        localStorage.setItem(STORAGE_KEY, String(notificationsToggle.checked));
+        updateStatus();
+      });
+    }
+  </script>
+
