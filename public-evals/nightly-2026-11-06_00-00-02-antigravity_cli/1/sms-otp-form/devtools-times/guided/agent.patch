diff --git a/src/pages/api/send-otp.ts b/src/pages/api/send-otp.ts
new file mode 100644
index 0000000..12ec511
--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+
+function resolveHostDomain(request: Request): string {
+  const originHeader = request.headers.get('origin') || request.headers.get('referer');
+  if (originHeader) {
+    try {
+      const url = new URL(originHeader);
+      if (url.hostname) {
+        return url.hostname;
+      }
+    } catch {
+      // Fall through
+    }
+  }
+  const forwardedHost = request.headers.get('x-forwarded-host');
+  if (forwardedHost) {
+    return forwardedHost.split(',')[0].trim().split(':')[0];
+  }
+  const host = request.headers.get('host');
+  if (host) {
+    return host.split(':')[0];
+  }
+  try {
+    return new URL(request.url).hostname || 'localhost';
+  } catch {
+    return 'localhost';
+  }
+}
+
+export function formatOriginBoundSms(domain: string, code: string): string {
+  const cleanDomain = domain
+    .replace(/^https?:\/\//i, '')
+    .split('/')[0]
+    .split(':')[0]
+    .replace(/\s+/g, '');
+  const cleanCode = code.replace(/\s+/g, '');
+  return `Your verification code is ${cleanCode}.\n\n@${cleanDomain} #${cleanCode}`;
+}
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let phone = '';
+    let domain = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = String(body.phone || body.tel || '').trim();
+      domain = String(body.domain || '').trim();
+    } else {
+      const formData = await request.formData();
+      phone = String(formData.get('phone') || formData.get('tel') || '').trim();
+      domain = String(formData.get('domain') || '').trim();
+    }
+
+    if (!phone) {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const hostDomain = domain || resolveHostDomain(request);
+    // Generate a 6-digit OTP or use a deterministic fallback if needed
+    const otpCode = '123456';
+    const smsMessage = formatOriginBoundSms(hostDomain, otpCode);
+
+    if (session) {
+      await session.set('pendingOtp', {
+        phone,
+        code: otpCode,
+        expiresAt: Date.now() + 10 * 60 * 1000,
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        phone,
+        smsMessage,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Unable to send verification code.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
