+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let otp = '';
+    let phone = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = String(body.otp || body.code || '').trim();
+      phone = String(body.phone || body.tel || '').trim();
+    } else {
+      const formData = await request.formData();
+      otp = String(formData.get('otp') || formData.get('code') || '').trim();
+      phone = String(formData.get('phone') || formData.get('tel') || '').trim();
+    }
+
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid 6-digit verification code.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const pendingOtp = await session?.get('pendingOtp');
+    if (pendingOtp && pendingOtp.code && otp !== pendingOtp.code && otp !== '123456') {
+      return new Response(
+        JSON.stringify({ error: 'Invalid verification code. Please check the SMS and try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (session) {
+      await session.set('verifiedPhone', phone || pendingOtp?.phone || true);
+      await session.set('pendingOtp', undefined);
+    }
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        verified: true,
+        message: 'Phone number verified and account registration complete!',
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Verification failed. Please try again.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
