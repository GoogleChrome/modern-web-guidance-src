+  <script>
+    (function () {
+      const form = document.getElementById('otp-form');
+      const input = document.getElementById('otp-code');
+      const statusEl = document.getElementById('otp-status');
+      const resendBtn = document.getElementById('resend-otp-btn');
+      let abortController = null;
+
+      function setStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'status-message ' + (type || '');
+      }
+
+      function initWebOTP() {
+        if ('OTPCredential' in window && navigator.credentials && navigator.credentials.get) {
+          if (abortController) {
+            abortController.abort();
+          }
+          abortController = new AbortController();
+
+          navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: abortController.signal
+          }).then(function (otp) {
+            if (otp && otp.code) {
+              input.value = otp.code;
+              setStatus('Passcode automatically filled from SMS.', 'info');
+              if (form.requestSubmit) {
+                form.requestSubmit();
+              } else {
+                form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
+              }
+            }
+          }).catch(function (err) {
+            // Silently ignore AbortError or unsupported permission errors in non-SMS environments
+          });
+        }
+      }
+
+      if (form) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          if (abortController) {
+            abortController.abort();
+            abortController = null;
+          }
+
+          const code = (input.value || '').trim();
+          if (!/^[0-9]{6}$/.test(code)) {
+            setStatus('Please enter a valid 6-digit numerical passcode.', 'error');
+            input.setAttribute('aria-invalid', 'true');
+            input.focus();
+            return;
+          }
+
+          input.removeAttribute('aria-invalid');
+          setStatus('Passcode verified! Redirecting to your Rewards & Order session...', 'success');
+        });
+      }
+
+      if (resendBtn) {
+        resendBtn.addEventListener('click', function () {
+          input.value = '';
+          input.removeAttribute('aria-invalid');
+          setStatus('A new 6-digit verification code has been sent to your phone.', 'info');
+          initWebOTP();
+          input.focus();
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initWebOTP);
+      } else {
+        initWebOTP();
+      }
+    })();
+  </script>
