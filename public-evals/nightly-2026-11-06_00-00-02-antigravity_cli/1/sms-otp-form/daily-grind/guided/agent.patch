+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const verifyBtn = document.getElementById('verify-btn');
+    const resendCodeBtn = document.getElementById('resend-code-btn');
+    const otpStatus = document.getElementById('otp-status');
+    const smsPreview = document.getElementById('sms-message-preview');
+    const verificationContext = document.getElementById('verification-context');
+    const navRewardsLink = document.getElementById('nav-rewards-link');
+    const heroOrderLink = document.getElementById('hero-order-link');
+
+    let otpAbortController = null;
+
+    function formatOriginBoundSms(code) {
+      const host = window.location.hostname || 'dailygrind.example';
+      return `Your Daily Grind verification code is ${code}.\n\n@${host} #${code}`;
+    }
+
+    if (smsPreview) {
+      smsPreview.textContent = formatOriginBoundSms('482910');
+    }
+
+    function showStatus(message, type = 'info') {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.className = `status-banner ${type}`;
+      otpStatus.hidden = false;
+    }
+
+    function clearOtpError() {
+      if (!otpInput || !otpError) return;
+      otpInput.setCustomValidity('');
+      otpInput.removeAttribute('aria-invalid');
+      otpError.textContent = '';
+      otpError.hidden = true;
+    }
+
+    function validateOtpField() {
+      if (!otpInput || !otpError) return true;
+      otpInput.setCustomValidity('');
+      if (!otpInput.checkValidity()) {
+        const msg = 'Please enter the 6-digit numeric verification code.';
+        otpInput.setCustomValidity(msg);
+        otpInput.setAttribute('aria-invalid', 'true');
+        otpError.textContent = `Error: ${msg}`;
+        otpError.hidden = false;
+        return false;
+      }
+      clearOtpError();
+      return true;
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        clearOtpError();
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    if (otpInput) {
+      otpInput.addEventListener('input', () => {
+        clearOtpError();
+      });
+
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value.length > 0) {
+          validateOtpField();
+        }
+      });
+
+      otpInput.addEventListener('invalid', () => {
+        const msg = 'Please enter the 6-digit numeric verification code.';
+        otpInput.setCustomValidity(msg);
+        otpInput.setAttribute('aria-invalid', 'true');
+        if (otpError) {
+          otpError.textContent = `Error: ${msg}`;
+          otpError.hidden = false;
+        }
+      });
+    }
+
+    if (phoneForm) {
+      phoneForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const phoneVal = phoneInput && phoneInput.value.trim() ? phoneInput.value.trim() : 'your mobile phone';
+        if (smsPreview) {
+          smsPreview.textContent = formatOriginBoundSms('482910');
+        }
+        showStatus(`Sent a 6-digit verification code via SMS to ${phoneVal}.`, 'info');
+        startSmsOtpListener();
+        if (otpInput) {
+          otpInput.focus();
+        }
+      });
+    }
+
+    if (resendCodeBtn) {
+      resendCodeBtn.addEventListener('click', () => {
+        if (verifyBtn) {
+          verifyBtn.disabled = false;
+        }
+        clearOtpError();
+        if (smsPreview) {
+          smsPreview.textContent = formatOriginBoundSms('482910');
+        }
+        showStatus('A new 6-digit verification code has been sent to your phone.', 'info');
+        startSmsOtpListener();
+        if (otpInput) {
+          otpInput.value = '';
+          otpInput.focus();
+        }
+      });
+    }
+
+    if (otpForm) {
+      otpForm.addEventListener('submit', async (event) => {
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+        event.preventDefault();
+
+        if (!validateOtpField()) {
+          otpInput.focus();
+          return;
+        }
+
+        if (verifyBtn) {
+          verifyBtn.disabled = true;
+        }
+
+        const formData = new FormData(otpForm);
+        const code = formData.get('otp');
+
+        try {
+          await fetch(otpForm.action, { method: 'POST', body: formData });
+        } catch {
+          // Graceful fallback when running as a static demo without a backend endpoint
+        }
+
+        showStatus(`Code ${code} verified! You are now signed in to Daily Grind Rewards and ready to order.`, 'success');
+      });
+    }
+
+    if (navRewardsLink) {
+      navRewardsLink.addEventListener('click', () => {
+        if (verificationContext) {
+          verificationContext.textContent = 'Sign in to Daily Grind Rewards: enter the 6-digit SMS code sent to your phone.';
+        }
+        startSmsOtpListener();
+      });
+    }
+
+    if (heroOrderLink) {
+      heroOrderLink.addEventListener('click', () => {
+        if (verificationContext) {
+          verificationContext.textContent = 'Confirm your phone number for online ordering: enter the 6-digit SMS code sent to your phone.';
+        }
+        startSmsOtpListener();
+      });
+    }
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
+
 </body>
 
