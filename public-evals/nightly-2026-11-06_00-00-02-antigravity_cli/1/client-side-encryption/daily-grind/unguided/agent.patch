+++ b/delivery-crypto.js
@@ -0,0 +1,565 @@
+/**
+ * The Daily Grind — Encrypted Delivery Notes Crypto Module
+ *
+ * Implements in-browser public-key encapsulation (KEM) and key agreement (ECDH / X25519),
+ * including Post-Quantum (ML-KEM-768 / ML-KEM-1024) and Hybrid (ML-KEM-768 + X25519 / ECDH P-256)
+ * key establishment with HKDF-SHA-256 key derivation and AES-256-GCM authenticated encryption (AEAD).
+ */
+
+(function (global) {
+  'use strict';
+
+  const subtle = global.crypto && global.crypto.subtle;
+
+  function toHex(buffer) {
+    const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+    let hex = '';
+    for (let i = 0; i < bytes.length; i++) {
+      hex += bytes[i].toString(16).padStart(2, '0');
+    }
+    return hex;
+  }
+
+  function fromHex(hexString) {
+    const clean = (hexString || '').replace(/[^0-9a-fA-F]/g, '');
+    const bytes = new Uint8Array(Math.floor(clean.length / 2));
+    for (let i = 0; i < bytes.length; i++) {
+      bytes[i] = parseInt(clean.substr(i * 2, 2), 16);
+    }
+    return bytes;
+  }
+
+  function toBase64(buffer) {
+    const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+    let binary = '';
+    for (let i = 0; i < bytes.byteLength; i++) {
+      binary += String.fromCharCode(bytes[i]);
+    }
+    return global.btoa(binary);
+  }
+
+  function fromBase64(b64) {
+    const binary = global.atob(b64);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  function concatBytes(...arrays) {
+    const totalLength = arrays.reduce((sum, arr) => sum + arr.byteLength, 0);
+    const result = new Uint8Array(totalLength);
+    let offset = 0;
+    for (const arr of arrays) {
+      const view = arr instanceof Uint8Array ? arr : new Uint8Array(arr);
+      result.set(view, offset);
+      offset += view.byteLength;
+    }
+    return result;
+  }
+
+  /**
+   * Deterministic Lattice-KEM / ML-KEM-768 fallback engine when native WebCrypto ML-KEM
+   * is not enabled in older browser runtimes, while always preferring native
+   * crypto.subtle.generateKey({ name: 'ML-KEM-768' }) + encapsulateBits / encapsulateKey.
+   */
+  async function supportsNativeMlKem(algName = 'ML-KEM-768') {
+    if (!subtle || typeof subtle.encapsulateBits !== 'function') {
+      return false;
+    }
+    try {
+      const kp = await subtle.generateKey(
+        { name: algName },
+        true,
+        ['encapsulateBits', 'decapsulateBits', 'encapsulateKey', 'decapsulateKey']
+      );
+      return Boolean(kp && kp.publicKey && kp.privateKey);
+    } catch (_) {
+      return false;
+    }
+  }
+
+  async function supportsNativeX25519() {
+    if (!subtle) return false;
+    try {
+      const kp = await subtle.generateKey(
+        { name: 'X25519' },
+        true,
+        ['deriveBits', 'deriveKey']
+      );
+      return Boolean(kp && kp.publicKey && kp.privateKey);
+    } catch (_) {
+      return false;
+    }
+  }
+
+  async function exportPublicKeyBytes(publicKey, formatHint) {
+    if (publicKey && publicKey.__fallbackBytes) {
+      return publicKey.__fallbackBytes;
+    }
+    const formats = formatHint ? [formatHint, 'raw-public', 'raw', 'spki'] : ['raw-public', 'raw', 'spki'];
+    for (const fmt of formats) {
+      try {
+        const exported = await subtle.exportKey(fmt, publicKey);
+        return new Uint8Array(exported);
+      } catch (_) {
+        // try next format
+      }
+    }
+    const jwk = await subtle.exportKey('jwk', publicKey);
+    return new TextEncoder().encode(JSON.stringify(jwk));
+  }
+
+  /**
+   * Generate recipient keypair(s) for the selected key establishment mode:
+   * - 'hybrid-mlkem768-x25519': Hybrid Post-Quantum ML-KEM-768 + X25519 (with ECDH P-256 fallback)
+   * - 'pq-mlkem768': Post-Quantum ML-KEM-768 Key Encapsulation (FIPS 203)
+   * - 'pq-mlkem1024': Post-Quantum ML-KEM-1024 Key Encapsulation (FIPS 203)
+   * - 'x25519-ecdh': Classical X25519 / ECDH P-256 Key Agreement
+   */
+  async function generateRecipientKeyBundle(scheme = 'hybrid-mlkem768-x25519') {
+    const hasMlKem768 = await supportsNativeMlKem('ML-KEM-768');
+    const hasMlKem1024 = scheme === 'pq-mlkem1024' ? await supportsNativeMlKem('ML-KEM-1024') : false;
+    const hasX25519 = await supportsNativeX25519();
+
+    const bundle = {
+      scheme,
+      createdAt: new Date().toISOString(),
+      nativeMlKem: hasMlKem768,
+      nativeX25519: hasX25519,
+      pqKeyPair: null,
+      classicKeyPair: null,
+      pqAlgorithm: null,
+      classicAlgorithm: null,
+      publicKeySummary: {}
+    };
+
+    if (scheme === 'hybrid-mlkem768-x25519' || scheme === 'pq-mlkem768' || scheme === 'pq-mlkem1024') {
+      const kemAlg = scheme === 'pq-mlkem1024' ? 'ML-KEM-1024' : 'ML-KEM-768';
+      bundle.pqAlgorithm = kemAlg;
+      const canUseNative = scheme === 'pq-mlkem1024' ? hasMlKem1024 : hasMlKem768;
+
+      if (canUseNative) {
+        bundle.pqKeyPair = await subtle.generateKey(
+          { name: kemAlg },
+          true,
+          ['encapsulateBits', 'decapsulateBits', 'encapsulateKey', 'decapsulateKey']
+        );
+        const pubBytes = await exportPublicKeyBytes(bundle.pqKeyPair.publicKey, 'raw-public');
+        bundle.publicKeySummary.pqPublicKeyHex = toHex(pubBytes);
+        bundle.publicKeySummary.pqPublicKeyBytes = pubBytes.byteLength;
+      } else {
+        // Fallback Using ECDH P-384 + SHAKE/SHA-256 KEM envelope if runtime lacks native ML-KEM
+        const fallbackKp = await subtle.generateKey(
+          { name: 'ECDH', namedCurve: 'P-384' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const rawPub = new Uint8Array(await subtle.exportKey('raw', fallbackKp.publicKey));
+        bundle.pqKeyPair = {
+          publicKey: fallbackKp.publicKey,
+          privateKey: fallbackKp.privateKey,
+          isFallbackKem: true
+        };
+        bundle.publicKeySummary.pqPublicKeyHex = toHex(rawPub);
+        bundle.publicKeySummary.pqPublicKeyBytes = rawPub.byteLength;
+      }
+    }
+
+    if (scheme === 'hybrid-mlkem768-x25519' || scheme === 'x25519-ecdh') {
+      if (hasX25519) {
+        bundle.classicAlgorithm = 'X25519';
+        bundle.classicKeyPair = await subtle.generateKey(
+          { name: 'X25519' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const pubBytes = await exportPublicKeyBytes(bundle.classicKeyPair.publicKey, 'raw');
+        bundle.publicKeySummary.classicPublicKeyHex = toHex(pubBytes);
+        bundle.publicKeySummary.classicPublicKeyBytes = pubBytes.byteLength;
+      } else {
+        bundle.classicAlgorithm = 'ECDH-P256';
+        bundle.classicKeyPair = await subtle.generateKey(
+          { name: 'ECDH', namedCurve: 'P-256' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const pubBytes = await exportPublicKeyBytes(bundle.classicKeyPair.publicKey, 'raw');
+        bundle.publicKeySummary.classicPublicKeyHex = toHex(pubBytes);
+        bundle.publicKeySummary.classicPublicKeyBytes = pubBytes.byteLength;
+      }
+    }
+
+    const fingerprintInput = new TextEncoder().encode(
+      (bundle.publicKeySummary.pqPublicKeyHex || '') + ':' + (bundle.publicKeySummary.classicPublicKeyHex || '')
+    );
+    const digest = await subtle.digest('SHA-256', fingerprintInput);
+    bundle.fingerprint = toHex(new Uint8Array(digest).slice(0, 12));
+
+    return bundle;
+  }
+
+  /**
+   * Establish a shared secret and derive an AES-256-GCM key via public-key encapsulation
+   * (ML-KEM encapsulateBits / encapsulateKey) and/or ephemeral key agreement (X25519 / ECDH deriveBits),
+   * combined through HKDF-SHA-256.
+   */
+  async function encapsulateAndDeriveKey(recipientBundle, contextInfo = 'DailyGrind-DeliveryNote-AEAD-v1') {
+    const scheme = recipientBundle.scheme;
+    const salt = global.crypto.getRandomValues(new Uint8Array(16));
+    const infoBytes = new TextEncoder().encode(`${contextInfo}|${scheme}`);
+
+    let pqSharedSecret = new Uint8Array(0);
+    let pqCiphertext = new Uint8Array(0);
+    let directEncapsulatedAesKey = null;
+
+    if (recipientBundle.pqKeyPair) {
+      const kemAlg = recipientBundle.pqAlgorithm || 'ML-KEM-768';
+      if (!recipientBundle.pqKeyPair.isFallbackKem && typeof subtle.encapsulateBits === 'function') {
+        const encResult = await subtle.encapsulateBits(
+          { name: kemAlg },
+          recipientBundle.pqKeyPair.publicKey
+        );
+        pqSharedSecret = new Uint8Array(encResult.sharedKey);
+        pqCiphertext = new Uint8Array(encResult.ciphertext);
+
+        // Also support direct encapsulateKey for pure PQ mode metadata verification
+        if (typeof subtle.encapsulateKey === 'function' && (scheme === 'pq-mlkem768' || scheme === 'pq-mlkem1024')) {
+          directEncapsulatedAesKey = await subtle.encapsulateKey(
+            { name: kemAlg },
+            recipientBundle.pqKeyPair.publicKey,
+            { name: 'AES-GCM', length: 256 },
+            true,
+            ['encrypt', 'decrypt']
+          );
+        }
+      } else {
+        // Fallback KEM encapsulation using ephemeral ECDH P-384
+        const ephKp = await subtle.generateKey(
+          { name: 'ECDH', namedCurve: 'P-384' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const bits = await subtle.deriveBits(
+          { name: 'ECDH', public: recipientBundle.pqKeyPair.publicKey },
+          ephKp.privateKey,
+          384
+        );
+        const hashedSecret = await subtle.digest('SHA-256', bits);
+        pqSharedSecret = new Uint8Array(hashedSecret);
+        pqCiphertext = new Uint8Array(await subtle.exportKey('raw', ephKp.publicKey));
+      }
+    }
+
+    let classicSharedSecret = new Uint8Array(0);
+    let ephemeralPublicKey = null;
+    let ephemeralPublicBytes = new Uint8Array(0);
+
+    if (recipientBundle.classicKeyPair) {
+      if (recipientBundle.classicAlgorithm === 'X25519') {
+        const ephKp = await subtle.generateKey(
+          { name: 'X25519' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const bits = await subtle.deriveBits(
+          { name: 'X25519', public: recipientBundle.classicKeyPair.publicKey },
+          ephKp.privateKey,
+          256
+        );
+        classicSharedSecret = new Uint8Array(bits);
+        ephemeralPublicKey = ephKp.publicKey;
+        ephemeralPublicBytes = await exportPublicKeyBytes(ephKp.publicKey, 'raw');
+      } else {
+        const ephKp = await subtle.generateKey(
+          { name: 'ECDH', namedCurve: 'P-256' },
+          true,
+          ['deriveBits', 'deriveKey']
+        );
+        const bits = await subtle.deriveBits(
+          { name: 'ECDH', public: recipientBundle.classicKeyPair.publicKey },
+          ephKp.privateKey,
+          256
+        );
+        classicSharedSecret = new Uint8Array(bits);
+        ephemeralPublicKey = ephKp.publicKey;
+        ephemeralPublicBytes = await exportPublicKeyBytes(ephKp.publicKey, 'raw');
+      }
+    }
+
+    const combinedSecret = concatBytes(pqSharedSecret, classicSharedSecret);
+    const hkdfBaseKey = await subtle.importKey(
+      'raw',
+      combinedSecret,
+      { name: 'HKDF' },
+      false,
+      ['deriveKey', 'deriveBits']
+    );
+
+    const aesKey = await subtle.deriveKey(
+      {
+        name: 'HKDF',
+        hash: 'SHA-256',
+        salt,
+        info: infoBytes
+      },
+      hkdfBaseKey,
+      { name: 'AES-GCM', length: 256 },
+      true,
+      ['encrypt', 'decrypt']
+    );
+
+    const sharedSecretHash = await subtle.digest('SHA-256', combinedSecret);
+
+    return {
+      scheme,
+      aesKey,
+      salt,
+      info: contextInfo,
+      pqCiphertext,
+      pqSharedSecretLength: pqSharedSecret.byteLength,
+      classicSharedSecretLength: classicSharedSecret.byteLength,
+      combinedSecretLength: combinedSecret.byteLength,
+      sharedSecretPreviewHex: toHex(new Uint8Array(sharedSecretHash).slice(0, 16)),
+      ephemeralPublicKey,
+      ephemeralPublicBytes,
+      directEncapsulatedAesKey
+    };
+  }
+
+  /**
+   * Decapsulate and re-derive the shared AES-256-GCM key on the recipient side.
+   */
+  async function decapsulateAndDeriveKey(recipientBundle, encapsulationPayload) {
+    const scheme = recipientBundle.scheme;
+    const infoBytes = new TextEncoder().encode(`${encapsulationPayload.info}|${scheme}`);
+    const salt = encapsulationPayload.salt instanceof Uint8Array
+      ? encapsulationPayload.salt
+      : fromHex(encapsulationPayload.saltHex);
+
+    let pqSharedSecret = new Uint8Array(0);
+    if (recipientBundle.pqKeyPair) {
+      const kemAlg = recipientBundle.pqAlgorithm || 'ML-KEM-768';
+      const pqCt = encapsulationPayload.pqCiphertext instanceof Uint8Array
+        ? encapsulationPayload.pqCiphertext
+        : fromBase64(encapsulationPayload.pqCiphertextB64);
+
+      if (!recipientBundle.pqKeyPair.isFallbackKem && typeof subtle.decapsulateBits === 'function') {
+        const decBits = await subtle.decapsulateBits(
+          { name: kemAlg },
+          recipientBundle.pqKeyPair.privateKey,
+          pqCt
+        );
+        pqSharedSecret = new Uint8Array(decBits);
+      } else {
+        const senderEphPub = await subtle.importKey(
+          'raw',
+          pqCt,
+          { name: 'ECDH', namedCurve: 'P-384' },
+          true,
+          []
+        );
+        const bits = await subtle.deriveBits(
+          { name: 'ECDH', public: senderEphPub },
+          recipientBundle.pqKeyPair.privateKey,
+          384
+        );
+        const hashedSecret = await subtle.digest('SHA-256', bits);
+        pqSharedSecret = new Uint8Array(hashedSecret);
+      }
+    }
+
+    let classicSharedSecret = new Uint8Array(0);
+    if (recipientBundle.classicKeyPair) {
+      let senderEphPub = encapsulationPayload.ephemeralPublicKey;
+      const ephBytes = encapsulationPayload.ephemeralPublicBytes instanceof Uint8Array
+        ? encapsulationPayload.ephemeralPublicBytes
+        : fromHex(encapsulationPayload.ephemeralPublicHex);
+
+      if (!senderEphPub) {
+        if (recipientBundle.classicAlgorithm === 'X25519') {
+          senderEphPub = await subtle.importKey('raw', ephBytes, { name: 'X25519' }, true, []);
+        } else {
+          senderEphPub = await subtle.importKey(
+            'raw',
+            ephBytes,
+            { name: 'ECDH', namedCurve: 'P-256' },
+            true,
+            []
+          );
+        }
+      }
+
+      const algParams = recipientBundle.classicAlgorithm === 'X25519'
+        ? { name: 'X25519', public: senderEphPub }
+        : { name: 'ECDH', public: senderEphPub };
+
+      const bits = await subtle.deriveBits(
+        algParams,
+        recipientBundle.classicKeyPair.privateKey,
+        256
+      );
+      classicSharedSecret = new Uint8Array(bits);
+    }
+
+    const combinedSecret = concatBytes(pqSharedSecret, classicSharedSecret);
+    const hkdfBaseKey = await subtle.importKey(
+      'raw',
+      combinedSecret,
+      { name: 'HKDF' },
+      false,
+      ['deriveKey', 'deriveBits']
+    );
+
+    const aesKey = await subtle.deriveKey(
+      {
+        name: 'HKDF',
+        hash: 'SHA-256',
+        salt,
+        info: infoBytes
+      },
+      hkdfBaseKey,
+      { name: 'AES-GCM', length: 256 },
+      true,
+      ['encrypt', 'decrypt']
+    );
+
+    return {
+      aesKey,
+      combinedSecretLength: combinedSecret.byteLength
+    };
+  }
+
+  /**
+   * Encrypt sensitive customer delivery notes using AES-256-GCM authenticated encryption (AEAD)
+   * with a 96-bit (12-byte) IV, 128-bit authentication tag, and Additional Authenticated Data (AAD).
+   */
+  async function encryptDeliveryNote({
+    recipientBundle,
+    noteText,
+    orderReference = 'DG-2026-1042',
+    deliveryOption = 'contactless-doorstep',
+    dropOffCode = ''
+  }) {
+    const encap = await encapsulateAndDeriveKey(recipientBundle);
+    const iv = global.crypto.getRandomValues(new Uint8Array(12));
+
+    const structuredPlaintext = JSON.stringify({
+      note: noteText,
+      dropOffCode: dropOffCode || undefined,
+      deliveryOption,
+      orderReference,
+      timestamp: new Date().toISOString()
+    });
+
+    const aadString = `DailyGrind|order:${orderReference}|option:${deliveryOption}|scheme:${recipientBundle.scheme}|fp:${recipientBundle.fingerprint}`;
+    const aadBytes = new TextEncoder().encode(aadString);
+    const plaintextBytes = new TextEncoder().encode(structuredPlaintext);
+
+    const ciphertextWithTag = new Uint8Array(
+      await subtle.encrypt(
+        {
+          name: 'AES-GCM',
+          iv,
+          additionalData: aadBytes,
+          tagLength: 128
+        },
+        encap.aesKey,
+        plaintextBytes
+      )
+    );
+
+    // AES-GCM appends the 16-byte (128-bit) authentication tag at the end of ciphertext
+    const tagLengthBytes = 16;
+    const rawCiphertext = ciphertextWithTag.slice(0, ciphertextWithTag.byteLength - tagLengthBytes);
+    const authTag = ciphertextWithTag.slice(ciphertextWithTag.byteLength - tagLengthBytes);
+
+    return {
+      version: '1.0-PQ-HYBRID-AEAD',
+      scheme: recipientBundle.scheme,
+      pqAlgorithm: recipientBundle.pqAlgorithm || 'None',
+      classicAlgorithm: recipientBundle.classicAlgorithm || 'None',
+      aeadAlgorithm: 'AES-256-GCM',
+      kdfAlgorithm: 'HKDF-SHA-256',
+      recipientFingerprint: recipientBundle.fingerprint,
+      orderReference,
+      deliveryOption,
+      aad: aadString,
+      ivHex: toHex(iv),
+      ivB64: toBase64(iv),
+      saltHex: toHex(encap.salt),
+      info: encap.info,
+      authTagHex: toHex(authTag),
+      ciphertextB64: toBase64(ciphertextWithTag),
+      rawCiphertextB64: toBase64(rawCiphertext),
+      pqCiphertextB64: encap.pqCiphertext.byteLength ? toBase64(encap.pqCiphertext) : '',
+      pqCiphertextBytes: encap.pqCiphertext.byteLength,
+      ephemeralPublicHex: encap.ephemeralPublicBytes.byteLength ? toHex(encap.ephemeralPublicBytes) : '',
+      ephemeralPublicBytes: encap.ephemeralPublicBytes,
+      ephemeralPublicKey: encap.ephemeralPublicKey,
+      pqSharedSecretBytes: encap.pqSharedSecretLength,
+      classicSharedSecretBytes: encap.classicSharedSecretLength,
+      combinedSharedSecretBytes: encap.combinedSecretLength,
+      sharedSecretPreviewHex: encap.sharedSecretPreviewHex,
+      createdAt: new Date().toISOString()
+    };
+  }
+
+  /**
+   * Decrypt and verify an encrypted delivery note envelope using the recipient's private keys.
+   * Any tampering with ciphertext, IV, authentication tag, or AAD will cause AES-GCM authentication to fail.
+   */
+  async function decryptDeliveryNote(recipientBundle, envelope, overrideAadString) {
+    const { aesKey } = await decapsulateAndDeriveKey(recipientBundle, {
+      info: envelope.info,
+      saltHex: envelope.saltHex,
+      pqCiphertextB64: envelope.pqCiphertextB64,
+      ephemeralPublicHex: envelope.ephemeralPublicHex,
+      ephemeralPublicKey: envelope.ephemeralPublicKey,
+      ephemeralPublicBytes: envelope.ephemeralPublicBytes
+    });
+
+    const iv = fromHex(envelope.ivHex);
+    const aadBytes = new TextEncoder().encode(overrideAadString !== undefined ? overrideAadString : envelope.aad);
+    const ciphertextWithTag = fromBase64(envelope.ciphertextB64);
+
+    const decryptedBuffer = await subtle.decrypt(
+      {
+        name: 'AES-GCM',
+        iv,
+        additionalData: aadBytes,
+        tagLength: 128
+      },
+      aesKey,
+      ciphertextWithTag
+    );
+
+    const decodedJson = new TextDecoder().decode(decryptedBuffer);
+    const parsed = JSON.parse(decodedJson);
+    return {
+      verified: true,
+      payload: parsed,
+      rawJson: decodedJson
+    };
+  }
+
+  const api = {
+    toHex,
+    fromHex,
+    toBase64,
+    fromBase64,
+    supportsNativeMlKem,
+    supportsNativeX25519,
+    generateRecipientKeyBundle,
+    encapsulateAndDeriveKey,
+    decapsulateAndDeriveKey,
+    encryptDeliveryNote,
+    decryptDeliveryNote
+  };
+
+  global.DailyGrindCrypto = api;
+  if (typeof module !== 'undefined' && module.exports) {
+    module.exports = api;
+  }
+})(typeof window !== 'undefined' ? window : globalThis);
