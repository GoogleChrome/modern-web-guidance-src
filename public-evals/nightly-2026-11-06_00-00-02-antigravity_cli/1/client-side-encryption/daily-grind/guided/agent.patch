+    export async function generateRecipientKeys(
+      preferredKem = 'MLKEM768-X25519',
+      forceRotate = false,
+    ) {
+      const usePQ = supportsPostQuantumEnvelope(preferredKem);
+      const storageKey = usePQ ? `recipient-kem-key-${preferredKem}` : 'recipient-kem-key-X25519';
+
+      if (!forceRotate) {
