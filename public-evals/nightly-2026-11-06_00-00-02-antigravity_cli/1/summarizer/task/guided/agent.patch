+  <script>
+    (async function initRoastersJournalSummarizer() {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summarizer-status');
+      const summaryContainer = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('journal-summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: 'An article from an artisanal coffee roastery journal explaining their ethical bean sourcing, quality testing, and roasting process.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short'
+      };
+
+      function disableWithFallback(message) {
+        summarizeBtn.disabled = true;
+        statusEl.textContent = message;
+      }
+
+      function renderBulletPoints(summaryText) {
+        summaryList.replaceChildren();
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^[\s*\-•–]+/, '').trim())
+          .filter(Boolean);
+
+        if (lines.length === 0 && summaryText.trim()) {
+          lines.push(summaryText.trim());
+        }
+
+        for (const point of lines) {
+          const li = document.createElement('li');
+          li.textContent = point;
+          summaryList.appendChild(li);
+        }
+
+        summaryContainer.hidden = false;
+      }
+
+      if (!('Summarizer' in self)) {
+        disableWithFallback('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await Summarizer.availability(summarizerOptions);
+      } catch (err) {
+        disableWithFallback('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        disableWithFallback('Local summarization is currently unavailable on this device.');
+        return;
+      }
+
+      let summarizerInstance = null;
+
+      if (availability === 'available') {
+        try {
+          summarizerInstance = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (e.total) {
+                  const pct = Math.round((e.loaded / e.total) * 100);
+                  statusEl.textContent = `Downloading AI model: ${pct}%`;
+                }
+              });
+            }
+          });
+        } catch (err) {
+          // Will retry on user click gesture if needed
+        }
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        summarizeBtn.disabled = true;
+        statusEl.textContent = 'Generating summary...';
+
+        try {
+          if (!summarizerInstance) {
+            summarizerInstance = await Summarizer.create({
+              ...summarizerOptions,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const ratio = e.total ? e.loaded / e.total : e.loaded;
+                  const pct = Math.round(ratio * 100);
+                  statusEl.textContent = `Downloading AI model: ${pct}%`;
+                });
+              }
+            });
+          }
+
+          statusEl.textContent = 'Summarizing journal entry...';
+          const longText = articleEl.innerText;
+          const summary = await summarizerInstance.summarize(longText, {
+            context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points for coffee shop visitors.'
+          });
+
+          renderBulletPoints(summary);
+          statusEl.textContent = 'Summarized with built-in browser AI.';
+        } catch (err) {
+          statusEl.textContent = 'Unable to generate summary using built-in browser AI.';
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
