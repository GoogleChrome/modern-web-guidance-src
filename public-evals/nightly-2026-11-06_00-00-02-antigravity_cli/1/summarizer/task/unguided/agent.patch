+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryBox = document.getElementById('journal-summary');
+    const summaryOutput = document.getElementById('summary-output');
+    const journalTextEl = document.getElementById('journal-text');
+
+    function renderBullets(summaryText) {
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•+\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      const ul = document.createElement('ul');
+      for (const item of lines) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        ul.appendChild(li);
+      }
+      summaryOutput.replaceChildren(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const textToSummarize = journalTextEl.innerText.trim();
+      summaryBox.classList.add('visible');
+      summarizeBtn.disabled = true;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryOutput.innerHTML = '<p class="summary-status">Generating summary with browser AI...</p>';
+
+      let summarizer;
+      try {
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a coffee roaster explaining their ethical bean sourcing and roasting process.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+              summaryOutput.innerHTML = `<p class="summary-status">Downloading on-device AI model (${percent}%)...</p>`;
+            });
+          }
+        };
+
+        if ('Summarizer' in self) {
+          const availability = await Summarizer.availability();
+          if (availability === 'unavailable') {
+            throw new Error('The browser Summarizer API is unavailable on this device.');
+          }
+          summarizer = await Summarizer.create(options);
+        } else if (self.ai && self.ai.summarizer) {
+          const capabilities = await self.ai.summarizer.capabilities();
+          if (capabilities.available === 'no') {
+            throw new Error('The browser Summarizer API is unavailable on this device.');
+          }
+          summarizer = await self.ai.summarizer.create(options);
+        } else {
+          throw new Error('Your browser does not support the built-in AI Summarizer API.');
+        }
+
+        const result = await summarizer.summarize(textToSummarize);
+        renderBullets(result);
+        summarizeBtn.textContent = 'Summarize';
+      } catch (err) {
+        summaryOutput.innerHTML = `<p class="summary-status">${err.message || 'Unable to generate summary using browser AI.'}</p>`;
+        summarizeBtn.textContent = 'Summarize';
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
