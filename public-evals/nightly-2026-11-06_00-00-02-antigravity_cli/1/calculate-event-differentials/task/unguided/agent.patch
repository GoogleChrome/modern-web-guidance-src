+  <script>
+    function updateMapleOatTimer() {
+      const remainingEl = document.getElementById('countdown-remaining');
+      const elapsedEl = document.getElementById('countdown-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = typeof Temporal !== 'undefined'
+        ? Temporal.Now.timeZoneId()
+        : Intl.DateTimeFormat().resolvedOptions().timeZone;
+
+      let remainingDays = 0;
+      let remainingHours = 0;
+      let elapsedDays = 0;
+      let elapsedHours = 0;
+      let isExpired = false;
+
+      if (typeof Temporal !== 'undefined') {
+        const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+        // Promotion starts February 1, 2026 at midnight in the user's local time zone
+        const promoStart = Temporal.ZonedDateTime.from({
+          year: 2026,
+          month: 2,
+          day: 1,
+          hour: 0,
+          minute: 0,
+          second: 0,
+          timeZone: userTimeZone
+        });
+
+        // Offer ends March 1, 2026 at midnight in the user's local time zone
+        const promoEnd = Temporal.ZonedDateTime.from({
+          year: 2026,
+          month: 3,
+          day: 1,
+          hour: 0,
+          minute: 0,
+          second: 0,
+          timeZone: userTimeZone
+        });
+
+        if (Temporal.ZonedDateTime.compare(now, promoEnd) >= 0) {
+          isExpired = true;
+        } else {
+          const remainingDuration = now.until(promoEnd, {
+            largestUnit: 'days',
+            smallestUnit: 'hours',
+            roundingMode: 'trunc'
+          });
+          remainingDays = remainingDuration.days;
+          remainingHours = remainingDuration.hours;
+        }
+
+        if (Temporal.ZonedDateTime.compare(now, promoStart) > 0) {
+          const elapsedDuration = now.since(promoStart, {
+            largestUnit: 'days',
+            smallestUnit: 'hours',
+            roundingMode: 'trunc'
+          });
+          elapsedDays = elapsedDuration.days;
+          elapsedHours = elapsedDuration.hours;
+        }
+      } else {
+        const now = new Date();
+        const promoStart = new Date(2026, 1, 1, 0, 0, 0);
+        const promoEnd = new Date(2026, 2, 1, 0, 0, 0);
+
+        const remainingMs = promoEnd.getTime() - now.getTime();
+        if (remainingMs <= 0) {
+          isExpired = true;
+        } else {
+          const totalRemainingHours = Math.floor(remainingMs / (1000 * 60 * 60));
+          remainingDays = Math.floor(totalRemainingHours / 24);
+          remainingHours = totalRemainingHours % 24;
+        }
+
+        const elapsedMs = Math.max(0, now.getTime() - promoStart.getTime());
+        const totalElapsedHours = Math.floor(elapsedMs / (1000 * 60 * 60));
+        elapsedDays = Math.floor(totalElapsedHours / 24);
+        elapsedHours = totalElapsedHours % 24;
+      }
+
+      if (isExpired) {
+        remainingEl.textContent = `0 days, 0 hours (Offer ended)`;
+      } else {
+        remainingEl.textContent = `${remainingDays} days, ${remainingHours} hours`;
+      }
+
+      elapsedEl.textContent = `${elapsedDays} days, ${elapsedHours} hours`;
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatTimer);
+  </script>
