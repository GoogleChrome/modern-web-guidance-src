   </footer>
 
+  <script>
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      let pendingTransitionType = sessionStorage.getItem('transitionType');
+      sessionStorage.removeItem('transitionType');
+
+      const nextLink = document.getElementById('next');
+      const prevLink = document.getElementById('previous');
+
+      if (nextLink) {
+        nextLink.addEventListener('click', () => {
+          sessionStorage.setItem('transitionType', 'next');
+        });
+      }
+
+      if (prevLink) {
+        prevLink.addEventListener('click', () => {
+          sessionStorage.setItem('transitionType', 'previous');
+        });
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        if (!event.viewTransition) return;
+        const activeEl = document.activeElement;
+        const type =
+          activeEl?.id === 'next'
+            ? 'next'
+            : activeEl?.id === 'previous'
+              ? 'previous'
+              : sessionStorage.getItem('transitionType');
+        if (type === 'next' || type === 'previous') {
+          event.viewTransition.types.add(type);
+        }
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+        let type = pendingTransitionType;
+        if (!type && window.navigation?.activation) {
+          const fromUrl = new URL(window.navigation.activation.from.url);
+          const toUrl = new URL(window.navigation.activation.entry.url);
+          const fromPage = parseInt(fromUrl.searchParams.get('page') || '1', 10);
+          const toPage = parseInt(toUrl.searchParams.get('page') || '1', 10);
+          if (toPage > fromPage) {
+            type = 'next';
+          } else if (toPage < fromPage) {
+            type = 'previous';
+          }
+        }
+        if (type === 'next' || type === 'previous') {
+          event.viewTransition.types.add(type);
+        }
+      });
+    }
+  </script>
 </body>
 
