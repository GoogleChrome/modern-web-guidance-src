+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingSubmitBtn = document.getElementById('shipping-submit-btn');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    if (shippingForm) {
+      shippingForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!shippingForm.checkValidity()) {
+          shippingForm.reportValidity();
+          return;
+        }
+        shippingSubmitBtn.disabled = true;
+        shippingStatus.textContent = 'Shipping address saved! Preparing your coffee bean delivery order...';
+        shippingStatus.classList.add('visible');
+      });
+
+      shippingForm.addEventListener('input', () => {
+        if (shippingSubmitBtn.disabled) {
+          shippingSubmitBtn.disabled = false;
+        }
+      });
+    }
+  </script>
