+              (data.action ? data.action + ': ' + data.points + ' pts' : data.type) +
+              ') from pinned sandboxed iframe.'
+          );
+          return acceptedSandboxMsg;
+        }
+
+        // Case B: Cross-window messages from the trusted ordering origin
+        if (isTrustedOrderingOrigin(event.origin)) {
+          var orderInfo = data.orderId
+            ? 'Order #' + String(data.orderId) + ' (' + String(data.status || 'updated') + ')'
+            : String(data.type || 'ORDER_UPDATE');
+
+          var acceptedOrderMsg = {
+            accepted: true,
+            channel: 'ordering',
+            type: data.type || 'ORDER_UPDATE',
+            orderId: data.orderId || null,
+            status: data.status || null,
+            origin: event.origin,
+            reason: 'Accepted message from verified trusted ordering origin'
+          };
+          messageAuditLog.push(acceptedOrderMsg);
+          updateBanner(
+            'order-status',
+            'accepted',
+            'Verified order update from ' + event.origin + ': ' + orderInfo
+          );
+          return acceptedOrderMsg;
+        }
+
+        // Case C: Any other origin is rejected
+        var rejectedOriginEntry = {
+          accepted: false,
+          channel: 'ordering',
+          type: data.type || 'UNKNOWN',
+          origin: event.origin,
+          reason: 'Rejected cross-window message from untrusted origin: ' + String(event.origin)
+        };
+        messageAuditLog.push(rejectedOriginEntry);
+        updateBanner('order-status', 'rejected', rejectedOriginEntry.reason);
+        return rejectedOriginEntry;
+      }
+
+      window.addEventListener('message', handleIncomingMessage);
+
+      // =========================================================================
+      // 3. Page Redirect Parameter Check & Link Click Interception
+      // =========================================================================
+
+      function checkPageRedirectParams() {
+        var currentUrl = parseUrlSafely(window.location.href);
+        if (!currentUrl) return null;
+
+        var paramNames = ['redirect', 'returnTo', 'next', 'return_url', 'url'];
+        for (var i = 0; i < paramNames.length; i++) {
+          var key = paramNames[i];
+          if (currentUrl.searchParams.has(key)) {
+            var rawTarget = currentUrl.searchParams.get(key);
+            var validation = validateSameSiteRedirect(rawTarget, '/');
+            if (validation.valid) {
+              updateBanner(
+                'redirect-status',
+                'accepted',
+                'Validated same-site redirect target (' + key + '): ' + validation.url
+              );
+            } else {
+              updateBanner(
+                'redirect-status',
+                'rejected',
+                'Blocked untrusted redirect parameter (' + key + '): ' + String(rawTarget) + ' -> fallback to ' + validation.url
+              );
+            }
+            return validation;
+          }
+        }
+        return null;
+      }
+
+      document.addEventListener('click', function (event) {
+        var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
+        if (!anchor) return;
+
+        var rawHref = anchor.getAttribute('href') || '';
+        if (rawHref === '#' || anchor.getAttribute('data-link-scope') === 'blocked') {
+          event.preventDefault();
+          updateBanner('redirect-status', 'rejected', 'Blocked navigation to unsafe link.');
+          return;
+        }
+
+        var parsed = parseUrlSafely(rawHref, window.location.href);
+        if (!parsed || (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') || parsed.username || parsed.password) {
+          event.preventDefault();
+          updateBanner('redirect-status', 'rejected', 'Blocked navigation to invalid URL scheme or credentials.');
+          return;
+        }
+
+        if (!isSameSiteUrl(parsed.href, window.location.href)) {
+          // Ensure external links always have safe attributes before following
+          anchor.setAttribute('rel', 'noopener noreferrer');
+          anchor.setAttribute('target', '_blank');
+        }
+      });
+
+      // Initialize link validation and redirect parameter checks on DOM ready
+      function initSecurityControls() {
+        validateAndHardenLinks(document, window.location.href);
+        checkPageRedirectParams();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSecurityControls);
+      } else {
+        initSecurityControls();
+      }
+
+      // Expose validation API on window for programmatic inspection and testing
+      window.DailyGrindSecurity = {
+        TRUSTED_ORDERING_ORIGINS: TRUSTED_ORDERING_ORIGINS,
+        SITE_CANONICAL_DOMAIN: SITE_CANONICAL_DOMAIN,
+        parseUrlSafely: parseUrlSafely,
+        getRegistrableDomain: getRegistrableDomain,
+        isExactOrSubdomain: isExactOrSubdomain,
+        isTrustedOrderingOrigin: isTrustedOrderingOrigin,
+        isSameOriginUrl: isSameOriginUrl,
+        isSameSiteUrl: isSameSiteUrl,
+        validateSameSiteRedirect: validateSameSiteRedirect,
+        validateAndHardenLinks: validateAndHardenLinks,
+        handleIncomingMessage: handleIncomingMessage,
+        getPinnedWidgetSource: function () {
+          return pinnedWidgetSource;
+        },
+        getPinnedWidgetId: function () {
+          return pinnedWidgetId;
+        },
+        resetPinnedWidget: function (newExpectedIframe) {
+          pinnedWidgetSource = null;
+          pinnedWidgetId = null;
+          if (newExpectedIframe && newExpectedIframe.id) {
+            // Optional override hook
+          }
+        },
+        getMessageAuditLog: function () {
+          return messageAuditLog.slice();
+        }
+      };
+    })();
+  </script>
 </body>
 
 </html>
