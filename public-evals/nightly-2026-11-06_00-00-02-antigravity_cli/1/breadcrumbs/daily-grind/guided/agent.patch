+  <script>
+    (() => {
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const cards = document.querySelectorAll('.card[data-item-title]');
+
+      const baseTrail = [
+        { label: 'Home', href: '/' },
+        { label: 'Menu', href: '/menu' },
+        { label: 'Seasonal Favorites', href: '/menu/seasonal' }
+      ];
+
+      function renderBreadcrumbs(trail) {
+        breadcrumbList.replaceChildren(
+          ...trail.map((step, index) => {
+            const li = document.createElement('li');
+            const a = document.createElement('a');
+            a.href = step.href;
+            a.textContent = step.label;
+            if (index === trail.length - 1) {
+              a.setAttribute('aria-current', 'page');
+            }
+            li.appendChild(a);
+            return li;
+          })
+        );
+      }
+
+      cards.forEach((card) => {
+        const link = card.querySelector('a.btn');
+        if (!link) return;
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          cards.forEach((c) => c.classList.remove('is-selected'));
+          card.classList.add('is-selected');
+          renderBreadcrumbs([
+            ...baseTrail,
+            {
+              label: card.dataset.itemTitle,
+              href: card.dataset.itemHref
+            }
+          ]);
+        });
+      });
+
+      breadcrumbList.addEventListener('click', (event) => {
+        const link = event.target.closest('a');
+        if (!link) return;
+        const items = Array.from(breadcrumbList.querySelectorAll('li > a'));
+        const clickedIndex = items.indexOf(link);
+        if (clickedIndex !== -1 && clickedIndex < items.length - 1) {
+          event.preventDefault();
+          cards.forEach((c) => c.classList.remove('is-selected'));
+          renderBreadcrumbs(baseTrail.slice(0, Math.max(clickedIndex + 1, 1)));
+        }
+      });
+    })();
+  </script>
+
