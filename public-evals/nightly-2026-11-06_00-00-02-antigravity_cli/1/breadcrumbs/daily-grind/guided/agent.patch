+
+    .breadcrumb > ol > li > a[aria-current="page"] {
+      color: var(--text);
+      font-weight: 700;
+      text-decoration: none;
+    }
+
+    @media (forced-colors: active) {
+      .breadcrumb > ol > li > a[aria-current="page"] {
+        text-decoration: underline;
+      }
+    }
