+
+    .breadcrumb > ol {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 0.5rem;
+      list-style: none;
+      margin: 0;
+      padding: 0.5rem 0;
+      border-block-end: 1px solid var(--secondary);
+    }
+
+    .breadcrumb > ol > li {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      font-size: 0.95rem;
+    }
+
+    /* The empty alt text after the slash hides the divider from screen readers; li + li skips the first item */
+    .breadcrumb > ol > li + li::before {
+      content: "/" / "";
+      color: var(--primary);
+      user-select: none;
+    }
+
+    .breadcrumb > ol > li > a {
+      display: inline-flex;
+      align-items: center;
