+  <script>
+    (function () {
+      const items = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          path: '/menu/seasonal',
+          description: 'Creamy oat milk with a hint of pure Vermont maple syrup and a double shot of our signature espresso.',
+          notes: '16 oz • $5.50 • Available Hot or Iced'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          path: '/menu/espresso',
+          description: 'Bold, smokey, and full-bodied single-origin beans roasted to perfection for an intense morning boost.',
+          notes: 'Double Shot • $3.75 • Rich Cocoa & Roasted Nut Notes'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          path: '/menu/cold-brew',
+          description: 'Coarse-ground artisanal beans steeped in cool filtered water for 18 hours for maximum smoothness and low acidity.',
+          notes: '16 oz • $4.75 • Served Over Artisanal Ice'
+        }
+      };
+
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const seasonalSection = document.getElementById('seasonal-section');
+      const detailSection = document.getElementById('item-detail');
+      const detailTitle = document.getElementById('detail-title');
+      const detailDescription = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+      const backBtn = document.getElementById('back-to-seasonal');
+
+      function renderBreadcrumbs(trail) {
+        breadcrumbList.innerHTML = '';
+        trail.forEach(function (crumb, idx) {
+          const li = document.createElement('li');
+          const isLast = idx === trail.length - 1;
+          li.className = isLast ? 'breadcrumb-item active' : 'breadcrumb-item';
+          if (isLast) {
+            li.setAttribute('aria-current', 'page');
+            li.textContent = crumb.label;
+          } else {
+            const a = document.createElement('a');
+            a.href = crumb.href;
+            a.textContent = crumb.label;
+            a.dataset.level = crumb.level;
+            a.addEventListener('click', function (e) {
+              e.preventDefault();
+              showSeasonalView(crumb.level);
+            });
+            li.appendChild(a);
+          }
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function showSeasonalView(level) {
+        detailSection.classList.remove('active');
+        seasonalSection.style.display = 'block';
+        if (level === 'home') {
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' }
+          ]);
+        } else if (level === 'menu') {
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' }
+          ]);
+        } else {
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu/seasonal', level: 'seasonal' }
+          ]);
+        }
+      }
+
+      function showItemDetail(itemKey) {
+        const item = items[itemKey];
+        if (!item) return;
+        seasonalSection.style.display = 'none';
+        detailTitle.textContent = item.title;
+        detailDescription.textContent = item.description;
+        detailNotes.textContent = item.notes;
+        detailSection.classList.add('active');
+
+        renderBreadcrumbs([
+          { label: 'Home', href: '/', level: 'home' },
+          { label: 'Menu', href: '/menu', level: 'menu' },
+          { label: 'Seasonal Favorites', href: '#seasonal-section', level: 'seasonal' },
+          { label: item.title, href: item.path, level: 'item' }
+        ]);
+      }
+
+      document.querySelectorAll('[data-item]').forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          showItemDetail(btn.getAttribute('data-item'));
+        });
+      });
+
+      document.querySelectorAll('[data-breadcrumb]').forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          e.preventDefault();
+          showSeasonalView(link.getAttribute('data-breadcrumb'));
+        });
+      });
+
+      backBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        showSeasonalView('seasonal');
+      });
+    })();
+  </script>
 </body>
 
