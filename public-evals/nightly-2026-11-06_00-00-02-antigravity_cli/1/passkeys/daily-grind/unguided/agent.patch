+
+        // Signed-in Customer View
+        guestView.classList.add('hidden');
+        memberView.classList.remove('hidden');
+        navBadge.textContent = `${user.name} (${user.passkeys.length} Passkey${user.passkeys.length === 1 ? '' : 's'})`;
+        logoutBtn.classList.remove('hidden');
+
+        if (isReauthFresh()) {
+          const secondsLeft = Math.max(
+            1,
+            Math.round((REAUTH_WINDOW_MS - (Date.now() - new Date(state.lastReauthAt).getTime())) / 1000)
+          );
+          reauthBadge.textContent = `Passkey Verified (${secondsLeft}s step-up window)`;
+          reauthBadge.className = 'badge badge-success';
+        } else {
+          reauthBadge.textContent = 'Reauth Required for Sensitive Changes';
+          reauthBadge.className = 'badge badge-warning';
+        }
+
+        // Populate Profile Fields
+        document.getElementById('profile-greeting').textContent = `${user.name}'s Coffee Profile`;
+        document.getElementById('profile-tier-subtitle').textContent = `${user.tier || 'Gold Bean Member'} • ${user.email}`;
+        document.getElementById('profile-name').value = user.name || '';
+        document.getElementById('profile-email').value = user.email || '';
+        document.getElementById('profile-phone').value = user.phone || '';
+        document.getElementById('profile-drink').value = user.favoriteDrink || 'Maple Oat Latte';
+        document.getElementById('profile-roast').value = user.roastPreference || 'Single-Origin Ethiopian Light';
+        document.getElementById('profile-payment').value = user.paymentMethod || '';
+        document.getElementById('profile-require-reauth-always').checked = Boolean(user.requireReauthAlways);
+
+        // Render Saved Passkeys List
+        renderPasskeysList(user);
+
+        // Render Security Audit Log
+        renderAuditLog(user);
+      }
+
+      function renderPasskeysList(user) {
+        const container = document.getElementById('saved-passkeys-list');
+        const countBadge = document.getElementById('passkey-count-badge');
+        const passkeys = user.passkeys || [];
+        countBadge.textContent = String(passkeys.length);
+        container.innerHTML = '';
+
+        if (passkeys.length === 0) {
+          const empty = document.createElement('div');
+          empty.className = 'passkey-item';
+          empty.innerHTML = '<div class="passkey-meta">No passkeys saved. Add a passkey above to secure your account.</div>';
+          container.appendChild(empty);
+          return;
+        }
+
+        passkeys.forEach((pk) => {
+          const item = document.createElement('div');
+          item.className = 'passkey-item';
+          item.dataset.passkeyId = pk.id;
+
+          const shortId = pk.id.length > 18 ? `${pk.id.slice(0, 10)}…${pk.id.slice(-6)}` : pk.id;
+          const badgeClass = pk.backedUp ? 'badge-success' : 'badge-neutral';
+          const syncLabel = pk.backedUp ? 'Synced / Multi-Device' : 'Hardware-Bound';
+
+          item.innerHTML = `
+            <div class="passkey-meta">
+              <div class="passkey-title">
+                <span>🔑 ${escapeHtml(pk.nickname)}</span>
+                <span class="badge ${badgeClass}">${syncLabel}</span>
+                <span class="passkey-id-code" title="Credential ID: ${escapeHtml(pk.id)}">ID: ${escapeHtml(shortId)}</span>
+              </div>
+              <div class="passkey-details">
+                <span><strong>Created:</strong> ${formatTimestamp(pk.createdAt)}</span>
+                <span><strong>Last Used:</strong> ${formatTimestamp(pk.lastUsedAt)}</span>
+                <span><strong>Transports:</strong> ${escapeHtml((pk.transports || ['internal']).join(', '))}</span>
+                <span><strong>Sign Count:</strong> ${Number(pk.signCount || 1)}</span>
+              </div>
+            </div>
+            <div class="passkey-actions">
+              <button type="button" class="btn btn-outline btn-sm" data-action="test-passkey" data-id="${escapeHtml(pk.id)}">
+                Verify
+              </button>
+              <button type="button" class="btn btn-outline btn-sm" data-action="rename-passkey" data-id="${escapeHtml(pk.id)}">
+                Rename
+              </button>
+              <button type="button" class="btn btn-danger btn-sm" data-action="delete-passkey" data-id="${escapeHtml(pk.id)}">
+                Remove
+              </button>
+            </div>
+          `;
+          container.appendChild(item);
+        });
+      }
+
+      function renderAuditLog(user) {
+        const listEl = document.getElementById('security-audit-list');
+        listEl.innerHTML = '';
+        const logs = user.auditLog || [];
+        logs.forEach((entry) => {
+          const row = document.createElement('div');
+          row.className = 'audit-entry';
+          row.innerHTML = `
+            <span>${escapeHtml(entry.event)}</span>
+            <span style="color: var(--text-muted); white-space: nowrap;">${formatTimestamp(entry.timestamp)}</span>
+          `;
+          listEl.appendChild(row);
+        });
+      }
+
+      function escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#039;');
+      }
+
+      // --- Step-Up Reauthentication Modal Workflow ---
+      function openReauthModal({ actionLabel, onVerified }) {
+        const user = getCurrentUser();
+        if (!user) return;
+
+        pendingReauthCallback = onVerified;
+        document.getElementById('reauth-account-email').textContent = user.email;
+        document.getElementById('reauth-action-label').textContent = actionLabel || 'Protected Account Change';
+
+        const selectEl = document.getElementById('reauth-credential-select');
+        selectEl.innerHTML = '';
+
+        const anyOpt = document.createElement('option');
+        anyOpt.value = '';
+        anyOpt.textContent = 'Any Registered Account Passkey (Recommended)';
+        selectEl.appendChild(anyOpt);
+
+        (user.passkeys || []).forEach((pk) => {
+          const opt = document.createElement('option');
+          opt.value = pk.id;
+          opt.textContent = `${pk.nickname} (${(pk.transports || ['internal']).join('/')})`;
+          selectEl.appendChild(opt);
+        });
+
+        document.getElementById('reauth-modal').classList.remove('hidden');
+      }
+
+      function closeReauthModal() {
+        document.getElementById('reauth-modal').classList.add('hidden');
+        pendingReauthCallback = null;
+      }
+
+      async function executeReauthConfirmation() {
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const preferredId = document.getElementById('reauth-credential-select').value || undefined;
+        try {
+          const { passkey } = await assertPasskeyCredential({
+            user,
+            preferredCredentialId: preferredId
+          });
+
+          state.lastReauthAt = new Date().toISOString();
+          const actionLabel = document.getElementById('reauth-action-label').textContent;
+          addAuditEntry(user, `Reauthenticated via "${passkey.nickname}" for: ${actionLabel}`);
+          saveStore(state);
+
+          const callback = pendingReauthCallback;
+          closeReauthModal();
+          renderApp();
+
+          if (typeof callback === 'function') {
+            await callback(passkey);
+          } else {
+            showAlert(`Identity verified using passkey "${passkey.nickname}". Step-up window active for 2 minutes.`, 'success');
+          }
+        } catch (err) {
+          showAlert(err.message || 'Passkey reauthentication failed.', 'error');
+        }
+      }
+
+      // --- Event Listeners & Flows ---
+      function switchAuthTab(tab) {
+        const signInTab = document.getElementById('tab-signin-btn');
+        const registerTab = document.getElementById('tab-register-btn');
+        const signInPanel = document.getElementById('panel-signin');
+        const registerPanel = document.getElementById('panel-register');
+
+        if (tab === 'register') {
+          signInTab.classList.remove('active');
+          signInTab.setAttribute('aria-selected', 'false');
+          registerTab.classList.add('active');
+          registerTab.setAttribute('aria-selected', 'true');
+          signInPanel.classList.add('hidden');
+          registerPanel.classList.remove('hidden');
+        } else {
+          registerTab.classList.remove('active');
+          registerTab.setAttribute('aria-selected', 'false');
+          signInTab.classList.add('active');
+          signInTab.setAttribute('aria-selected', 'true');
+          registerPanel.classList.add('hidden');
+          signInPanel.classList.remove('hidden');
+        }
+      }
+
+      // 1. Customer Registration with Passkey Creation
+      document.getElementById('register-passkey-form').addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const name = document.getElementById('reg-name').value.trim();
+        const email = document.getElementById('reg-email').value.trim().toLowerCase();
+        const favoriteDrink = document.getElementById('reg-drink').value;
+        const passkeyLabel = document.getElementById('reg-passkey-label').value.trim() || 'Primary Passkey';
+        const attachment = document.getElementById('authenticator-attachment-select').value;
+
+        if (!name || !email) {
+          showAlert('Please provide both your full name and email address to register.', 'error');
+          return;
+        }
+
+        const existing = state.users.find((u) => u.email.toLowerCase() === email);
+        if (existing) {
+          showAlert('An account with this email already exists. Please sign in with your passkey instead.', 'error');
+          switchAuthTab('signin');
+          document.getElementById('signin-email').value = email;
+          return;
+        }
+
+        const newUser = {
+          id: 'usr_' + Math.random().toString(36).slice(2, 10),
+          name,
+          email,
+          phone: '',
+          favoriteDrink,
+          roastPreference: 'Single-Origin Ethiopian Light',
+          paymentMethod: 'Daily Grind Gift Card •••• 1045',
+          tier: 'Welcome Bean Member • 100 Bonus Stars',
+          requireReauthAlways: true,
+          passkeys: [],
+          auditLog: []
+        };
+
+        try {
+          const passkey = await createPasskeyCredential({
+            user: newUser,
+            nickname: passkeyLabel,
+            attachment
+          });
+
+          newUser.passkeys.push(passkey);
+          addAuditEntry(newUser, `Registered customer account & enrolled passkey "${passkey.nickname}"`);
+
+          state.users.push(newUser);
+          state.currentUserId = newUser.id;
+          state.lastReauthAt = new Date().toISOString();
+          saveStore(state);
+
+          e.target.reset();
+          renderApp();
+          showAlert(`Welcome to The Daily Grind, ${newUser.name}! Your passkey "${passkey.nickname}" is registered and active.`, 'success');
+        } catch (err) {
+          showAlert(err.message || 'Passkey registration could not be completed.', 'error');
+        }
+      });
+
+      // 2A. One-Tap Discoverable Passkey Sign-In
+      document.getElementById('btn-passkey-discoverable-signin').addEventListener('click', async () => {
+        try {
+          const { user, passkey } = await assertPasskeyCredential({ user: null });
+          state.currentUserId = user.id;
+          state.lastReauthAt = new Date().toISOString();
+          addAuditEntry(user, `Signed in with discoverable passkey "${passkey.nickname}"`);
+          saveStore(state);
+          renderApp();
+          showAlert(`Welcome back, ${user.name}! Authenticated via "${passkey.nickname}".`, 'success');
+        } catch (err) {
+          showAlert(err.message || 'Could not sign in with a discoverable passkey.', 'error');
+        }
+      });
+
+      // 2B. Email-Targeted Passkey Sign-In
+      document.getElementById('signin-email-form').addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const email = document.getElementById('signin-email').value.trim().toLowerCase();
+        const user = state.users.find((u) => u.email.toLowerCase() === email);
+        if (!user) {
+          showAlert(`No customer account found for "${email}". Try registering a new passkey account.`, 'error');
+          return;
+        }
+
+        try {
+          const { passkey } = await assertPasskeyCredential({ user });
+          state.currentUserId = user.id;
+          state.lastReauthAt = new Date().toISOString();
+          addAuditEntry(user, `Signed in via email lookup with passkey "${passkey.nickname}"`);
+          saveStore(state);
+          renderApp();
+          showAlert(`Signed in as ${user.name} using passkey "${passkey.nickname}".`, 'success');
+        } catch (err) {
+          showAlert(err.message || 'Passkey sign-in failed.', 'error');
+        }
+      });
+
+      // Demo User Quick-Fill
+      document.getElementById('btn-fill-demo-user').addEventListener('click', () => {
+        document.getElementById('signin-email').value = 'maya.lin@dailygrind.coffee';
+        showAlert('Demo email filled! Click "Authenticate with Email Passkey" or "Sign In with Saved Passkey" to sign in.', 'info');
+      });
+
+      // 3. Saved Passkey Management: Add New Passkey
+      document.getElementById('add-passkey-form').addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const nicknameInput = document.getElementById('new-passkey-nickname');
+        const nickname = nicknameInput.value.trim();
+        const attachment = document.getElementById('authenticator-attachment-select').value;
+        if (!nickname) return;
+
+        const performEnroll = async () => {
+          try {
+            const newPasskey = await createPasskeyCredential({
+              user,
+              nickname,
+              attachment
+            });
+            user.passkeys.unshift(newPasskey);
+            addAuditEntry(user, `Enrolled new passkey "${newPasskey.nickname}" (${newPasskey.attachment})`);
+            saveStore(state);
+            nicknameInput.value = '';
+            renderApp();
+            showAlert(`Added new passkey "${newPasskey.nickname}" to your account.`, 'success');
+          } catch (err) {
+            showAlert(err.message || 'Failed to add passkey.', 'error');
+          }
+        };
+
+        if (user.requireReauthAlways && !isReauthFresh()) {
+          openReauthModal({
+            actionLabel: `Enroll new passkey "${nickname}"`,
+            onVerified: performEnroll
+          });
+        } else {
+          await performEnroll();
+        }
+      });
+
+      // Saved Passkey Actions: Verify, Rename, Remove
+      document.getElementById('saved-passkeys-list').addEventListener('click', async (e) => {
+        const btn = e.target.closest('button[data-action]');
+        if (!btn) return;
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const action = btn.dataset.action;
+        const passkeyId = btn.dataset.id;
+        const targetPasskey = (user.passkeys || []).find((p) => p.id === passkeyId);
+        if (!targetPasskey) return;
+
+        if (action === 'test-passkey') {
+          try {
+            const { passkey } = await assertPasskeyCredential({
+              user,
+              preferredCredentialId: passkeyId
+            });
+            state.lastReauthAt = new Date().toISOString();
+            addAuditEntry(user, `Verified passkey "${passkey.nickname}" (sign count: ${passkey.signCount})`);
+            saveStore(state);
+            renderApp();
+            showAlert(`Passkey "${passkey.nickname}" verified! Sign counter incremented to ${passkey.signCount}.`, 'success');
+          } catch (err) {
+            showAlert(err.message || 'Passkey verification failed.', 'error');
+          }
+        } else if (action === 'rename-passkey') {
+          const itemEl = btn.closest('.passkey-item');
+          const existingEditor = itemEl.querySelector('.inline-rename-box');
+          if (existingEditor) {
+            existingEditor.remove();
+            return;
+          }
+          const renameBox = document.createElement('div');
+          renameBox.className = 'inline-rename-box';
+          renameBox.style.cssText = 'width: 100%; margin-top: 10px; display: flex; gap: 8px;';
+          renameBox.innerHTML = `
+            <input type="text" class="form-control rename-input" value="${escapeHtml(targetPasskey.nickname)}" style="flex: 1; padding: 6px 10px;">
+            <button type="button" class="btn btn-sm btn-accent save-rename-btn">Save Name</button>
+          `;
+          itemEl.appendChild(renameBox);
+          const inputEl = renameBox.querySelector('.rename-input');
+          inputEl.focus();
+          renameBox.querySelector('.save-rename-btn').addEventListener('click', () => {
+            const nextName = inputEl.value.trim();
+            if (nextName) {
+              const oldName = targetPasskey.nickname;
+              targetPasskey.nickname = nextName;
+              addAuditEntry(user, `Renamed passkey "${oldName}" to "${nextName}"`);
+              saveStore(state);
+              renderApp();
+              showAlert(`Passkey renamed to "${nextName}".`, 'success');
+            }
+          });
+        } else if (action === 'delete-passkey') {
+          if (user.passkeys.length <= 1) {
+            showAlert('You cannot remove your only remaining passkey. Enroll a backup passkey before removing this one.', 'error');
+            return;
+          }
+
+          const performDelete = () => {
+            user.passkeys = user.passkeys.filter((p) => p.id !== passkeyId);
+            addAuditEntry(user, `Revoked and removed saved passkey "${targetPasskey.nickname}"`);
+            saveStore(state);
+            renderApp();
+            showAlert(`Removed passkey "${targetPasskey.nickname}" from your account.`, 'info');
+          };
+
+          openReauthModal({
+            actionLabel: `Remove saved passkey "${targetPasskey.nickname}"`,
+            onVerified: performDelete
+          });
+        }
+      });
+
+      // 4 & 5. Profile Updates & Step-Up Reauthentication
+      function applyProfileUpdatesFromForm(user) {
+        user.name = document.getElementById('profile-name').value.trim() || user.name;
+        user.email = document.getElementById('profile-email').value.trim().toLowerCase() || user.email;
+        user.phone = document.getElementById('profile-phone').value.trim();
+        user.favoriteDrink = document.getElementById('profile-drink').value;
+        user.roastPreference = document.getElementById('profile-roast').value;
+        user.paymentMethod = document.getElementById('profile-payment').value.trim();
+        user.requireReauthAlways = document.getElementById('profile-require-reauth-always').checked;
+
+        addAuditEntry(user, `Updated customer profile & coffee preferences (${user.favoriteDrink})`);
+        saveStore(state);
+        renderApp();
+        showAlert('Customer profile and coffee preferences updated!', 'success');
+      }
+
+      document.getElementById('profile-update-form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const newEmail = document.getElementById('profile-email').value.trim().toLowerCase();
+        const newPayment = document.getElementById('profile-payment').value.trim();
+        const requireReauthAlways = document.getElementById('profile-require-reauth-always').checked;
+        const sensitiveChanged = newEmail !== user.email.toLowerCase() || newPayment !== (user.paymentMethod || '');
+
+        if (requireReauthAlways || sensitiveChanged || !isReauthFresh()) {
+          openReauthModal({
+            actionLabel: sensitiveChanged
+              ? 'Update sensitive profile details (Email / Payment Method)'
+              : 'Save customer profile changes',
+            onVerified: () => applyProfileUpdatesFromForm(user)
+          });
+        } else {
+          applyProfileUpdatesFromForm(user);
+        }
+      });
+
+      // Explicit "Reauthenticate & Update Profile" button
+      document.getElementById('btn-force-stepup-save').addEventListener('click', () => {
+        const user = getCurrentUser();
+        if (!user) return;
+        openReauthModal({
+          actionLabel: 'Step-Up Reauthentication & Profile Update',
+          onVerified: () => applyProfileUpdatesFromForm(user)
+        });
+      });
+
+      // Standalone Reauth Button in Profile Header
+      document.getElementById('btn-trigger-reauth').addEventListener('click', () => {
+        openReauthModal({
+          actionLabel: 'Manual Passkey Session Verification',
+          onVerified: null
+        });
