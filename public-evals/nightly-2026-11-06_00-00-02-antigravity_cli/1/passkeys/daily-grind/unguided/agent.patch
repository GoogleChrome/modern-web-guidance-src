+      document.getElementById('btn-reauth-confirm').addEventListener('click', executeReauthConfirmation);
+
+      // Logout
+      document.getElementById('nav-logout-btn').addEventListener('click', () => {
+        const user = getCurrentUser();
+        if (user) {
+          addAuditEntry(user, 'Signed out of session');
+        }
+        state.currentUserId = null;
+        state.lastReauthAt = null;
+        saveStore(state);
+        renderApp();
+        showAlert('You have been signed out of your Daily Grind account.', 'info');
+      });
+
+      // Virtual Authenticator Toggle
+      document.getElementById('virtual-authenticator-toggle').addEventListener('change', (e) => {
+        state.useVirtualAuthenticator = e.target.checked;
+        saveStore(state);
+        renderApp();
+      });
+
+      // Reset Demo Data
+      document.getElementById('QuickDemoResetBtn').addEventListener('click', () => {
+        state = getDefaultStore();
+        saveStore(state);
+        renderApp();
+        showAlert('Demo customer accounts and passkeys have been reset to defaults.', 'info');
+      });
+
+      // Dismiss Alert
+      document.getElementById('account-alert-close').addEventListener('click', hideAlert);
+
+      // Tabs
+      document.getElementById('tab-signin-btn').addEventListener('click', () => switchAuthTab('signin'));
+      document.getElementById('tab-register-btn').addEventListener('click', () => switchAuthTab('register'));
+
+      // Seasonal Menu Quick-Select Drink
+      document.querySelectorAll('[data-quick-drink]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const drink = btn.getAttribute('data-quick-drink');
+          const user = getCurrentUser();
