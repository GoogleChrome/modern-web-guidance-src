+          supportBadge.textContent = 'Virtual WebAuthn Fallback Active';
+          supportBadge.className = 'badge badge-warning';
+        }
+
+        if (!user) {
+          guestView.classList.remove('hidden');
+          memberView.classList.add('hidden');
+          navBadge.textContent = 'Guest • Not Signed In';
+          logoutBtn.classList.add('hidden');
