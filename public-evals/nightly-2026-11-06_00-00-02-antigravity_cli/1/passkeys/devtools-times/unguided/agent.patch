+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  if (!body.credentialId) {
+    return new Response(JSON.stringify({ error: 'Missing credentialId' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  if (session) {
+    const existingPasskeys = (await session.get('passkeys')) || [];
+    const newEntry = {
+      id: body.credentialId,
+      name: body.name || 'Passkey',
+      username: body.username,
+      transports: body.transports || ['internal'],
+      createdAt: new Date().toISOString(),
+    };
+    await session.set('passkeys', [
+      newEntry,
+      ...existingPasskeys.filter((p: { id: string }) => p.id !== body.credentialId),
+    ]);
+  }
+
+  return new Response(
+    JSON.stringify({
+      verified: true,
+      credentialId: body.credentialId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
