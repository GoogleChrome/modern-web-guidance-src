diff --git a/src/utils/passkeyStore.ts b/src/utils/passkeyStore.ts
new file mode 100644
index 0000000..d404436
--- /dev/null
+++ b/src/utils/passkeyStore.ts
@@ -0,0 +1,295 @@
+import { base64UrlToUint8Array, uint8ArrayToBase64Url } from './webauthn';
+
+export interface StoredPasskey {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+  aaguid?: string;
+  transports: string[];
+  backedUp: boolean;
+  publicKey?: string;
+}
+
+export interface StoredUser {
+  id: string;
+  username: string;
+  email: string;
+  displayName: string;
+  password?: string;
+  createdAt: string;
+  passkeys: StoredPasskey[];
+}
+
+export interface AuthSession {
+  userId: string;
+  username: string;
+  email: string;
+  displayName: string;
+  authMethod: 'passkey' | 'password';
+  credentialId?: string;
+  authenticatedAt: string;
+  lastReauthAt: string;
+}
+
+const USERS_STORAGE_KEY = 'devtools_times_users_v1';
+const SESSION_STORAGE_KEY = 'devtools_times_session_v1';
+
+const DEFAULT_DEMO_USER: StoredUser = {
+  id: 'usr_demo_alex_mercer',
+  username: 'alex.mercer',
+  email: 'alex.mercer@devtoolstimes.dev',
+  displayName: 'Alex Mercer',
+  password: 'Password123',
+  createdAt: '2025-01-15T09:30:00.000Z',
+  passkeys: [
+    {
+      id: 'dGVzdC1tYWNib29rLXByby10b3VjaC1pZC1jcmVkZW50aWFs',
+      name: 'MacBook Pro (Touch ID)',
+      createdAt: '2025-02-10T14:20:00.000Z',
+      lastUsedAt: '2025-05-01T08:15:00.000Z',
+      aaguid: 'adce0002-35bc-c60a-648b-0b25f1f05503',
+      transports: ['internal', 'hybrid'],
+      backedUp: true,
+    },
+    {
+      id: 'dGVzdC15dWJpa2V5LTUtbmZjLXNlY3VyaXR5LWtleQ',
+      name: 'YubiKey 5 NFC',
+      createdAt: '2025-03-04T11:05:00.000Z',
+      lastUsedAt: '2025-04-18T19:42:00.000Z',
+      aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a',
+      transports: ['usb', 'nfc'],
+      backedUp: false,
+    },
+  ],
+};
+
+function notifyAuthChange() {
+  if (typeof window !== 'undefined') {
+    window.dispatchEvent(new CustomEvent('dtt-auth-change'));
+  }
+}
+
+export function getStoredUsers(): StoredUser[] {
+  if (typeof window === 'undefined') return [DEFAULT_DEMO_USER];
+  try {
+    const raw = localStorage.getItem(USERS_STORAGE_KEY);
+    if (!raw) {
+      const initial = [DEFAULT_DEMO_USER];
+      localStorage.setItem(USERS_STORAGE_KEY, JSON.stringify(initial));
+      return initial;
+    }
+    const parsed = JSON.parse(raw);
+    if (Array.isArray(parsed) && parsed.length > 0) {
+      return parsed;
+    }
+    return [DEFAULT_DEMO_USER];
+  } catch {
+    return [DEFAULT_DEMO_USER];
+  }
+}
+
+export function saveStoredUsers(users: StoredUser[]): void {
+  if (typeof window === 'undefined') return;
+  localStorage.setItem(USERS_STORAGE_KEY, JSON.stringify(users));
+  notifyAuthChange();
+}
+
+export function findUserByUsername(identifier: string): StoredUser | undefined {
+  const normalized = identifier.trim().toLowerCase();
+  if (!normalized) return undefined;
+  const users = getStoredUsers();
+  return users.find(
+    (u) =>
+      u.username.toLowerCase() === normalized ||
+      u.email.toLowerCase() === normalized
+  );
+}
+
+export function findUserByCredentialId(credentialId: string): { user: StoredUser; passkey: StoredPasskey } | undefined {
+  const users = getStoredUsers();
+  for (const user of users) {
+    const pk = user.passkeys.find((p) => p.id === credentialId);
+    if (pk) {
+      return { user, passkey: pk };
+    }
+  }
+  return undefined;
+}
+
+export function getCurrentSession(): AuthSession | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(SESSION_STORAGE_KEY);
+    if (!raw) return null;
+    return JSON.parse(raw) as AuthSession;
+  } catch {
+    return null;
+  }
+}
+
+export function setCurrentSession(session: AuthSession | null): void {
+  if (typeof window === 'undefined') return;
+  if (!session) {
+    localStorage.removeItem(SESSION_STORAGE_KEY);
+  } else {
+    localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
+  }
+  notifyAuthChange();
+}
+
+export function getCurrentUser(): StoredUser | null {
+  const session = getCurrentSession();
+  if (!session) return null;
+  const users = getStoredUsers();
+  return users.find((u) => u.id === session.userId || u.username === session.username) || null;
+}
+
+export function createSessionForUser(
+  user: StoredUser,
+  authMethod: 'passkey' | 'password',
+  credentialId?: string
+): AuthSession {
+  const now = new Date().toISOString();
+  const session: AuthSession = {
+    userId: user.id,
+    username: user.username,
+    email: user.email,
+    displayName: user.displayName,
+    authMethod,
+    credentialId,
+    authenticatedAt: now,
+    lastReauthAt: now,
+  };
+  setCurrentSession(session);
+  return session;
+}
+
+export function recordReauthentication(method: 'passkey' | 'password', credentialId?: string): AuthSession | null {
+  const current = getCurrentSession();
+  if (!current) return null;
+  const updated: AuthSession = {
+    ...current,
+    authMethod: method,
+    credentialId: credentialId || current.credentialId,
+    lastReauthAt: new Date().toISOString(),
+  };
+  setCurrentSession(updated);
+  return updated;
+}
+
+export function isReauthFresh(maxAgeSeconds = 300): boolean {
+  const session = getCurrentSession();
+  if (!session || !session.lastReauthAt) return false;
+  const elapsedMs = Date.now() - new Date(session.lastReauthAt).getTime();
+  return elapsedMs <= maxAgeSeconds * 1000;
+}
+
+export function ensureUserExists(username: string, displayName?: string, password?: string): StoredUser {
+  const cleanUsername = username.trim();
+  const existing = findUserByUsername(cleanUsername);
+  if (existing) {
+    if (displayName && displayName.trim()) {
+      existing.displayName = displayName.trim();
+    }
+    if (password) {
+      existing.password = password;
+    }
+    const users = getStoredUsers().map((u) => (u.id === existing.id ? existing : u));
+    saveStoredUsers(users);
+    return existing;
+  }
+
+  const randomBytes = new Uint8Array(16);
+  if (typeof window !== 'undefined' && window.crypto) {
+    window.crypto.getRandomValues(randomBytes);
+  }
+  const userId = 'usr_' + uint8ArrayToBase64Url(randomBytes).slice(0, 16);
+  const isEmail = cleanUsername.includes('@');
+  const newUser: StoredUser = {
+    id: userId,
+    username: cleanUsername,
+    email: isEmail ? cleanUsername : `${cleanUsername.toLowerCase().replace(/[^a-z0-9._-]/g, '')}@devtoolstimes.dev`,
+    displayName: displayName?.trim() || cleanUsername.split('@')[0],
+    password,
+    createdAt: new Date().toISOString(),
+    passkeys: [],
+  };
+
+  const users = getStoredUsers();
+  users.push(newUser);
+  saveStoredUsers(users);
+  return newUser;
+}
+
+export function addPasskeyToUser(userId: string, passkey: StoredPasskey): StoredUser | null {
+  const users = getStoredUsers();
+  const idx = users.findIndex((u) => u.id === userId);
+  if (idx === -1) return null;
+
+  const existingPasskeyIdx = users[idx].passkeys.findIndex((p) => p.id === passkey.id);
+  if (existingPasskeyIdx >= 0) {
+    users[idx].passkeys[existingPasskeyIdx] = passkey;
+  } else {
+    users[idx].passkeys.unshift(passkey);
+  }
+  saveStoredUsers(users);
+  return users[idx];
+}
+
+export function renameUserPasskey(userId: string, credentialId: string, newName: string): StoredUser | null {
+  const users = getStoredUsers();
+  const idx = users.findIndex((u) => u.id === userId);
+  if (idx === -1) return null;
+
+  users[idx].passkeys = users[idx].passkeys.map((pk) =>
+    pk.id === credentialId ? { ...pk, name: newName.trim() || pk.name } : pk
+  );
+  saveStoredUsers(users);
+  return users[idx];
+}
+
+export function removeUserPasskey(userId: string, credentialId: string): StoredUser | null {
+  const users = getStoredUsers();
+  const idx = users.findIndex((u) => u.id === userId);
+  if (idx === -1) return null;
+
+  users[idx].passkeys = users[idx].passkeys.filter((pk) => pk.id !== credentialId);
+  saveStoredUsers(users);
+  return users[idx];
+}
+
+export function updateUserProfile(
+  userId: string,
+  updates: Partial<Pick<StoredUser, 'displayName' | 'email' | 'username' | 'password'>>
+): StoredUser | null {
+  const users = getStoredUsers();
+  const idx = users.findIndex((u) => u.id === userId);
+  if (idx === -1) return null;
+
+  users[idx] = {
+    ...users[idx],
+    ...updates,
+  };
+  saveStoredUsers(users);
+
+  const session = getCurrentSession();
+  if (session && session.userId === userId) {
+    setCurrentSession({
+      ...session,
+      username: users[idx].username,
+      email: users[idx].email,
+      displayName: users[idx].displayName,
+    });
+  }
+  return users[idx];
+}
+
+export function deleteUserAccount(userId: string): void {
+  const users = getStoredUsers().filter((u) => u.id !== userId);
+  saveStoredUsers(users);
+  const session = getCurrentSession();
+  if (session && session.userId === userId) {
+    setCurrentSession(null);
+  }
+}
diff --git a/src/utils/webauthn.ts b/src/utils/webauthn.ts
new file mode 100644
index 0000000..d110dda
--- /dev/null
+++ b/src/utils/webauthn.ts
@@ -0,0 +1,458 @@
+import {
+  addPasskeyToUser,
+  createSessionForUser,
+  ensureUserExists,
+  findUserByCredentialId,
+  findUserByUsername,
+  getCurrentUser,
+  getStoredUsers,
+  recordReauthentication,
+  saveStoredUsers,
+  type StoredPasskey,
+  type StoredUser,
+} from './passkeyStore';
+
+export function uint8ArrayToBase64Url(bytes: Uint8Array): string {
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/g, '');
+}
+
+export function base64UrlToUint8Array(base64Url: string): Uint8Array {
+  const padding = '='.repeat((4 - (base64Url.length % 4)) % 4);
+  const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  try {
+    const rawData = atob(base64);
+    const outputArray = new Uint8Array(rawData.length);
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i);
+    }
+    return outputArray;
+  } catch {
+    return new Uint8Array(16);
+  }
+}
+
+export function stringToUint8Array(str: string): Uint8Array {
+  return new TextEncoder().encode(str);
+}
+
+export function generateChallenge(size = 32): Uint8Array {
+  const challenge = new Uint8Array(size);
+  if (typeof window !== 'undefined' && window.crypto) {
+    window.crypto.getRandomValues(challenge);
+  }
+  return challenge;
+}
+
+export interface WebAuthnCapabilities {
+  isSupported: boolean;
+  isPlatformAuthenticatorAvailable: boolean;
+  isConditionalMediationAvailable: boolean;
+}
+
+export async function detectWebAuthnCapabilities(): Promise<WebAuthnCapabilities> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !navigator.credentials
+  ) {
+    return {
+      isSupported: false,
+      isPlatformAuthenticatorAvailable: false,
+      isConditionalMediationAvailable: false,
+    };
+  }
+
+  let isPlatformAuthenticatorAvailable = false;
+  let isConditionalMediationAvailable = false;
+
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      isPlatformAuthenticatorAvailable =
+        await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    isPlatformAuthenticatorAvailable = false;
+  }
+
+  try {
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      isConditionalMediationAvailable =
+        await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    isConditionalMediationAvailable = false;
+  }
+
+  return {
+    isSupported: true,
+    isPlatformAuthenticatorAvailable,
+    isConditionalMediationAvailable,
+  };
+}
+
+export function inferPasskeyDeviceName(): string {
+  if (typeof navigator === 'undefined') return 'Passkey Device';
+  const ua = navigator.userAgent;
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'MacBook / iCloud Keychain';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iPhone / iCloud Keychain';
+  if (/Android/i.test(ua)) return 'Android / Google Password Manager';
+  if (/Windows/i.test(ua)) return 'Windows Hello';
+  if (/Linux/i.test(ua)) return 'Linux Authenticator';
+  return 'Platform Passkey';
+}
+
+export function formatPasskeyError(err: unknown): string {
+  if (err instanceof DOMException || (err && typeof err === 'object' && 'name' in err)) {
+    const name = (err as { name: string; message?: string }).name;
+    const message = (err as { name: string; message?: string }).message;
+    switch (name) {
+      case 'InvalidStateError':
+        return 'A passkey is already registered for this authenticator on this device.';
+      case 'NotAllowedError':
+        return 'The passkey request was canceled, timed out, or not allowed by your browser or authenticator.';
+      case 'AbortError':
+        return 'The passkey operation was aborted.';
+      case 'SecurityError':
+        return 'Security error: Passkeys require a valid relying party domain (HTTPS or localhost).';
+      case 'NotSupportedError':
+        return 'This authenticator or browser does not support the requested passkey configuration.';
+      default:
+        return message || `WebAuthn error (${name})`;
+    }
+  }
+  if (err instanceof Error) {
+    return err.message;
+  }
+  return 'An unexpected error occurred during the passkey ceremony.';
+}
+
+export async function signalUnknownCredentialToAuthenticator(credentialId: string): Promise<void> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+  };
+  if (typeof pkc.signalUnknownCredential === 'function') {
+    try {
+      await pkc.signalUnknownCredential({
+        rpId: window.location.hostname,
+        credentialId,
+      });
+    } catch {
+      // Ignore if unsupported by the active authenticator
+    }
+  }
+}
+
+export async function signalCurrentUserDetailsToAuthenticator(user: StoredUser): Promise<void> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalCurrentUserDetails?: (options: {
+      rpId: string;
+      userId: string;
+      name: string;
+      displayName: string;
+    }) => Promise<void>;
+  };
+  if (typeof pkc.signalCurrentUserDetails === 'function') {
+    try {
+      await pkc.signalCurrentUserDetails({
+        rpId: window.location.hostname,
+        userId: uint8ArrayToBase64Url(stringToUint8Array(user.id)),
+        name: user.username,
+        displayName: user.displayName,
+      });
+    } catch {
+      // Ignore if unsupported
+    }
+  }
+}
+
+export interface RegisterPasskeyOptions {
+  username: string;
+  displayName?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+}
+
+export async function registerPasskey({
+  username,
+  displayName,
+  passkeyName,
+  authenticatorAttachment,
+}: RegisterPasskeyOptions): Promise<{ user: StoredUser; passkey: StoredPasskey }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('WebAuthn passkeys are not supported in this browser environment.');
+  }
+
+  const user = ensureUserExists(username, displayName);
+  const challenge = generateChallenge(32);
+  const userIdBytes = stringToUint8Array(user.id);
+
+  // Exclude already registered credentials for this user
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = user.passkeys.map((pk) => ({
+    id: base64UrlToUint8Array(pk.id) as BufferSource,
+    type: 'public-key',
+    transports: pk.transports as AuthenticatorTransport[],
+  }));
+
+  // Call the backend options endpoint if available, or construct standard WebAuthn options
+  let serverChallengeBytes: Uint8Array = challenge;
+  try {
+    const resp = await fetch(`${import.meta.env.BASE_URL}api/passkeys/register-options.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: user.username,
+        displayName: user.displayName,
+        userId: user.id,
+      }),
+    });
+    if (resp.ok) {
+      const serverOpts = await resp.json();
+      if (serverOpts.challenge) {
+        serverChallengeBytes = base64UrlToUint8Array(serverOpts.challenge);
+      }
+    }
+  } catch {
+    // Fallback to client-generated challenge
+  }
+
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    challenge: serverChallengeBytes as BufferSource,
+    rp: {
+      name: 'The DevTools Times',
+      id: window.location.hostname,
+    },
+    user: {
+      id: userIdBytes as BufferSource,
+      name: user.username,
+      displayName: user.displayName || user.username,
+    },
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },   // ES256
+      { alg: -257, type: 'public-key' }, // RS256
+      { alg: -8, type: 'public-key' },   // EdDSA
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'required',
+      ...(authenticatorAttachment ? { authenticatorAttachment } : {}),
+    },
+  };
+
+  const credential = (await navigator.credentials.create({
+    publicKey,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey creation returned no credential.');
+  }
+
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const credentialId = credential.id || uint8ArrayToBase64Url(new Uint8Array(credential.rawId));
+  const transports =
+    typeof response.getTransports === 'function'
+      ? response.getTransports()
+      : ['internal', 'hybrid'];
+
+  let publicKeyBase64: string | undefined;
+  if (typeof response.getPublicKey === 'function') {
+    const pkBuffer = response.getPublicKey();
+    if (pkBuffer) {
+      publicKeyBase64 = uint8ArrayToBase64Url(new Uint8Array(pkBuffer));
+    }
+  }
+
+  const now = new Date().toISOString();
+  const newPasskey: StoredPasskey = {
+    id: credentialId,
+    name: passkeyName?.trim() || inferPasskeyDeviceName(),
+    createdAt: now,
+    lastUsedAt: now,
+    transports: transports.length > 0 ? transports : ['internal'],
+    backedUp: transports.includes('hybrid') || transports.includes('internal'),
+    publicKey: publicKeyBase64,
+  };
+
+  // Notify verification endpoint
+  try {
+    await fetch(`${import.meta.env.BASE_URL}api/passkeys/register-verify.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        userId: user.id,
+        username: user.username,
+        credentialId,
+        name: newPasskey.name,
+        transports: newPasskey.transports,
+        clientDataJSON: uint8ArrayToBase64Url(new Uint8Array(response.clientDataJSON)),
+        attestationObject: uint8ArrayToBase64Url(new Uint8Array(response.attestationObject)),
+      }),
+    });
+  } catch {
+    // Non-fatal in standalone/demo environment
+  }
+
+  const updatedUser = addPasskeyToUser(user.id, newPasskey) || user;
+  createSessionForUser(updatedUser, 'passkey', credentialId);
+
+  return { user: updatedUser, passkey: newPasskey };
+}
+
+export interface AuthenticatePasskeyOptions {
+  username?: string;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  isReauth?: boolean;
+}
+
+export async function authenticateWithPasskey({
+  username,
+  mediation = 'optional',
+  signal,
+  isReauth = false,
+}: AuthenticatePasskeyOptions = {}): Promise<{ user: StoredUser; passkey: StoredPasskey }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('WebAuthn passkeys are not supported in this browser environment.');
+  }
+
+  const challenge = generateChallenge(32);
+  let targetUser: StoredUser | undefined;
+
+  if (isReauth) {
+    targetUser = getCurrentUser() || undefined;
+  } else if (username && username.trim()) {
+    targetUser = findUserByUsername(username);
+  }
+
+  let serverChallengeBytes: Uint8Array = challenge;
+  try {
+    const resp = await fetch(`${import.meta.env.BASE_URL}api/passkeys/auth-options.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: targetUser?.username || username,
+        isReauth,
+      }),
+    });
+    if (resp.ok) {
+      const serverOpts = await resp.json();
+      if (serverOpts.challenge) {
+        serverChallengeBytes = base64UrlToUint8Array(serverOpts.challenge);
+      }
+    }
+  } catch {
+    // Fallback to client challenge
+  }
+
+  // Only restrict allowCredentials during reauthentication or when user has known local credentials
+  // and isn't using conditional mediation (conditional mediation requires empty allowCredentials)
+  let allowCredentials: PublicKeyCredentialDescriptor[] | undefined;
+  if (mediation !== 'conditional' && targetUser && targetUser.passkeys.length > 0 && isReauth) {
+    allowCredentials = targetUser.passkeys.map((pk) => ({
+      id: base64UrlToUint8Array(pk.id) as BufferSource,
+      type: 'public-key',
+      transports: pk.transports as AuthenticatorTransport[],
+    }));
+  }
+
+  const publicKey: PublicKeyCredentialRequestOptions = {
+    challenge: serverChallengeBytes as BufferSource,
+    rpId: window.location.hostname,
+    timeout: 60000,
+    userVerification: 'required',
+    ...(allowCredentials ? { allowCredentials } : {}),
+  };
+
+  const credential = (await navigator.credentials.get({
+    publicKey,
+    mediation,
+    signal,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('No passkey credential was returned by the authenticator.');
+  }
+
+  const response = credential.response as AuthenticatorAssertionResponse;
+  const credentialId = credential.id || uint8ArrayToBase64Url(new Uint8Array(credential.rawId));
+
+  // Verify against server endpoint
+  try {
+    await fetch(`${import.meta.env.BASE_URL}api/passkeys/auth-verify.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        credentialId,
+        isReauth,
+        authenticatorData: uint8ArrayToBase64Url(new Uint8Array(response.authenticatorData)),
+        clientDataJSON: uint8ArrayToBase64Url(new Uint8Array(response.clientDataJSON)),
+        signature: uint8ArrayToBase64Url(new Uint8Array(response.signature)),
+        userHandle: response.userHandle
+          ? uint8ArrayToBase64Url(new Uint8Array(response.userHandle))
+          : null,
+      }),
+    });
+  } catch {
+    // Continue
+  }
+
+  const now = new Date().toISOString();
+  const matched = findUserByCredentialId(credentialId);
+
+  if (matched) {
+    matched.passkey.lastUsedAt = now;
+    const users = getStoredUsers().map((u) => (u.id === matched.user.id ? matched.user : u));
+    saveStoredUsers(users);
+    if (isReauth) {
+      recordReauthentication('passkey', credentialId);
+    } else {
+      createSessionForUser(matched.user, 'passkey', credentialId);
+    }
+    return matched;
+  }
+
+  // If the authenticator returned a valid WebAuthn assertion (e.g. from Chrome DevTools Virtual Authenticator
+  // or a synced passkey createdearlier), bind or resolve the user gracefully:
+  let resolvedUser = targetUser || getCurrentUser();
+  if (!resolvedUser && response.userHandle) {
+    try {
+      const decodedUserId = new TextDecoder().decode(response.userHandle);
+      resolvedUser = getStoredUsers().find((u) => u.id === decodedUserId) || null;
+    } catch {
+      resolvedUser = null;
+    }
+  }
+  if (!resolvedUser) {
+    resolvedUser = ensureUserExists(username?.trim() || 'alex.mercer');
+  }
+
+  const dynamicPasskey: StoredPasskey = {
+    id: credentialId,
+    name: inferPasskeyDeviceName(),
+    createdAt: now,
+    lastUsedAt: now,
+    transports: ['internal'],
+    backedUp: true,
+  };
+
+  const updatedUser = addPasskeyToUser(resolvedUser.id, dynamicPasskey) || resolvedUser;
+  if (isReauth) {
+    recordReauthentication('passkey', credentialId);
+  } else {
+    createSessionForUser(updatedUser, 'passkey', credentialId);
+  }
+
+  return { user: updatedUser, passkey: dynamicPasskey };
+}
