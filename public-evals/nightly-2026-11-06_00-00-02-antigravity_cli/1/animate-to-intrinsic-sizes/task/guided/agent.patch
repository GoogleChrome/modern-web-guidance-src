+  <script>
+    // MANDATORY Accessibility Synchronization: Ensure elements collapsed to zero dimensions are removed from the assistive technology tree, and sync aria-expanded states on triggers.
+    const alertElement = document.getElementById('promo-alert');
+    const alertDismissBtn = document.getElementById('alert-dismiss');
+
+    alertDismissBtn?.addEventListener('click', () => {
+      alertElement?.classList.add('is-dismissed');
+      if (alertElement && getComputedStyle(alertElement).transitionDuration === '0s') {
+        alertElement.hidden = true;
+      }
+    });
+
+    alertElement?.addEventListener('transitionend', (e) => {
+      if (e.propertyName === 'block-size' && alertElement.classList.contains('is-dismissed')) {
+        alertElement.hidden = true;
+      }
+    });
+
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqDetails = faqTrigger?.closest('details');
+    if (faqDetails && faqTrigger) {
+      faqTrigger.setAttribute('aria-expanded', String(faqDetails.open));
+      faqDetails.addEventListener('toggle', () => {
+        faqTrigger.setAttribute('aria-expanded', String(faqDetails.open));
+      });
+    }
+  </script>
