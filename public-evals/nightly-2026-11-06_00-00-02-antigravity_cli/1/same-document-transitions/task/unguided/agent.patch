+  <script>
+    (function () {
+      const ITEMS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+          price: '$5.75',
+          roast: 'Medium Roast',
+          calories: '190 Cal',
+          description: 'Creamy oat milk with a hint of pure Vermont maple syrup, paired with our signature double-shot espresso and finished with a light dusting of warm cinnamon.',
+          notes: 'Toasted oats, rich amber maple, warm spice finish.'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+          price: '$3.50',
+          roast: 'Dark Roast',
+          calories: '15 Cal',
+          description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches to bring out deep caramelized sugars and a velvety crema.',
+          notes: 'Bittersweet dark chocolate, roasted walnut, smoky cedar.'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80',
+          price: '$4.75',
+          roast: 'Single-Origin Medium',
+          calories: '10 Cal',
+          description: 'Steeped in cool filtered water for 18 hours for maximum smoothness and naturally low acidity. Served over crystal-clear artisan ice.',
+          notes: 'Sweet cocoa nibs, molasses, crisp clean finish.'
+        }
+      };
+
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const listHeading = document.getElementById('list-heading');
+      const heroEl = document.getElementById('hero');
+      const titleEl = document.getElementById('title');
+      const priceEl = document.getElementById('detail-price');
+      const roastEl = document.getElementById('detail-roast');
+      const caloriesEl = document.getElementById('detail-calories');
+      const descriptionEl = document.getElementById('detail-description');
+      const notesEl = document.getElementById('detail-notes');
+      const backButton = document.getElementById('back-button');
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let activeThumbnail = null;
+
+      function prefersReducedMotion() {
+        return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      }
+
+      function cleanupTransitionState() {
+        const namedEls = document.querySelectorAll('.transition-hero, .transition-title, [style*="view-transition-name"]');
+        namedEls.forEach((el) => {
+          el.classList.remove('transition-hero', 'transition-title');
+          el.style.viewTransitionName = '';
+          if (el.getAttribute('style') === '') {
+            el.removeAttribute('style');
+          }
+        });
+      }
+
+      function setTransitionTargets(heroTarget, titleTarget) {
+        if (heroTarget) {
+          heroTarget.classList.add('transition-hero');
+          heroTarget.style.viewTransitionName = 'hero';
+        }
+        if (titleTarget) {
+          titleTarget.classList.add('transition-title');
+          titleTarget.style.viewTransitionName = 'title';
+        }
+      }
+
+      function populateDetail(itemId, fallbackCard) {
+        const data = ITEMS[itemId];
+        if (data) {
+          heroEl.src = data.image;
+          heroEl.alt = data.title;
+          titleEl.textContent = data.title;
+          priceEl.textContent = data.price;
+          roastEl.textContent = data.roast;
+          caloriesEl.textContent = data.calories;
+          descriptionEl.textContent = data.description;
+          notesEl.textContent = data.notes;
+        } else if (fallbackCard) {
+          const cardTitle = fallbackCard.querySelector('.title');
+          const cardImg = fallbackCard.querySelector('img');
+          const cardDesc = fallbackCard.querySelector('p');
+          if (cardTitle) titleEl.textContent = cardTitle.textContent;
+          if (cardImg) {
+            heroEl.src = cardImg.src;
+            heroEl.alt = cardImg.alt || '';
+          }
+          if (cardDesc) descriptionEl.textContent = cardDesc.textContent;
+        }
+      }
+
+      function openDetail(card) {
+        activeThumbnail = card;
+        const itemId = card.getAttribute('data-id');
+        const thumbTitle = card.querySelector('.title');
+
+        const updateDOM = () => {
+          cleanupTransitionState();
+          populateDetail(itemId, card);
+          listPage.hidden = true;
+          detailPage.hidden = false;
+          setTransitionTargets(heroEl, titleEl);
+          titleEl.focus({ preventScroll: true });
+        };
+
+        if (!document.startViewTransition || prefersReducedMotion()) {
+          updateDOM();
+          cleanupTransitionState();
+          return;
+        }
+
+        cleanupTransitionState();
+        setTransitionTargets(card, thumbTitle);
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          cleanupTransitionState();
+          titleEl.focus({ preventScroll: true });
+        });
+      }
+
+      function closeDetail() {
+        const targetCard = activeThumbnail || thumbnails[0];
+        const thumbTitle = targetCard ? targetCard.querySelector('.title') : null;
+
+        const updateDOM = () => {
+          cleanupTransitionState();
+          detailPage.hidden = true;
+          listPage.hidden = false;
+          if (targetCard) {
+            setTransitionTargets(targetCard, thumbTitle);
+          }
+          listHeading.focus({ preventScroll: true });
+        };
+
+        if (!document.startViewTransition || prefersReducedMotion() || !targetCard) {
+          updateDOM();
+          cleanupTransitionState();
+          return;
+        }
+
+        cleanupTransitionState();
+        setTransitionTargets(heroEl, titleEl);
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          cleanupTransitionState();
+          listHeading.focus({ preventScroll: true });
+        });
+      }
+
+      thumbnails.forEach((card) => {
+        card.addEventListener('click', (event) => {
+          event.preventDefault();
+          openDetail(card);
+        });
+
+        card.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            openDetail(card);
+          }
+        });
+      });
+
+      backButton.addEventListener('click', (event) => {
+        event.preventDefault();
+        closeDetail();
+      });
+    })();
+  </script>
 </body>
 
 </html>
