+  <script>
+    const thumbnails = document.querySelectorAll('.thumbnail');
+    const backButton = document.getElementById('back-button');
+    const hero = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailDescription = document.getElementById('detail-description');
+    const detailPrice = document.getElementById('detail-price');
+    const listHeading = document.getElementById('list-heading');
+
+    function populateDetail(card) {
+      const titleText = card.querySelector('.title')?.textContent || card.dataset.title || '';
+      const descText = card.dataset.description || card.querySelector('p')?.textContent || '';
+      const priceText = card.dataset.price || '';
+      const computedStyle = getComputedStyle(card);
+
+      hero.style.backgroundImage = computedStyle.backgroundImage;
+      hero.style.backgroundColor = computedStyle.backgroundColor;
+      detailTitle.textContent = titleText;
+      if (detailDescription) detailDescription.textContent = descText;
+      if (detailPrice) detailPrice.textContent = priceText;
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+      // Clean up any stale selected classes first
+      document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      card.classList.add('selected');
+      populateDetail(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+        listHeading?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', goFromListToDetail);
+      thumbnail.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', goFromDetailToList);
+  </script>
 </body>
 
