+  <script type="module">
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+  </script>
+
+  <script>
+    (() => {
+      const openDialogBtn = document.getElementById('open-dialog-btn');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+      const logoutDialog = document.getElementById('logout-dialog');
+      const foobarBtn = document.getElementById('foobar');
+      const offlineOverlay = document.getElementById('offline-overlay');
+      const closeOverlayBtn = document.getElementById('close-overlay-btn');
+
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      function supportsTopLayerExit() {
+        return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+      }
+
+      async function closeTopLayer(element) {
+        if (!supportsTopLayerExit()) {
+          element.setAttribute('data-closing', '');
+          const animations = element.getAnimations({ subtree: true });
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 2000)),
+            ]);
+          }
+          if (!element.hasAttribute('data-closing')) return;
+          element.removeAttribute('data-closing');
+        }
+
+        if (typeof element.close === 'function' && element.open) {
+          element.close();
+        } else if (typeof element.hidePopover === 'function') {
+          element.hidePopover();
+        }
+      }
+
+      // Open confirmation modal when clicking the logout link
+      openDialogBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        logoutDialog.removeAttribute('data-closing');
+        logoutDialog.showModal();
+      });
+
+      // Intercept close button if top-layer exit fallback is needed
+      closeDialogBtn.addEventListener('click', (event) => {
+        if (!supportsTopLayerExit()) {
+          event.preventDefault();
+          closeTopLayer(logoutDialog);
+        }
+      });
+
+      // Intercept native Esc / cancel to ensure smooth exit animation
+      logoutDialog.addEventListener('cancel', (event) => {
+        if (!supportsTopLayerExit()) {
+          event.preventDefault();
+          closeTopLayer(logoutDialog);
+        }
+      });
+
+      // Reset returnValue on close
+      logoutDialog.addEventListener('close', () => {
+        logoutDialog.returnValue = '';
+      });
+
+      // Fallback for dialog closedby="any" light dismiss in browsers lacking native closedBy
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e, dialog) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        logoutDialog.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, logoutDialog);
+        });
+        logoutDialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, logoutDialog)) {
+            closeTopLayer(logoutDialog);
+          }
+        });
+      }
+
+      // Return focus to #foobar when dismissing popover from inside, and support exit animation fallback
+      closeOverlayBtn.addEventListener('click', async (event) => {
+        if (!supportsTopLayerExit()) {
+          event.preventDefault();
+          await closeTopLayer(offlineOverlay);
+        }
+        foobarBtn.focus();
+      });
+
+      // Ensure #foobar works immediately even before invokers-polyfill loads or in offline environments
+      foobarBtn.addEventListener('click', () => {
+        if (!('commandForElement' in HTMLButtonElement.prototype) && typeof offlineOverlay.togglePopover === 'function') {
+          offlineOverlay.removeAttribute('data-closing');
+          offlineOverlay.togglePopover();
+        }
+      });
+    })();
+  </script>
