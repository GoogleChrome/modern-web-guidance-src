+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+      let conditionalPending = false;
+      let lastCredentialsGetRef = null;
+
+      function generateChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return '';
+        if (typeof buffer === 'string') return buffer;
+        const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        if (!credential) return {};
+        if (typeof credential.toJSON === 'function') {
+          try {
+            return credential.toJSON();
+          } catch (_) {
+            // Fall through to manual serialization
+          }
+        }
+        const response = credential.response || {};
+        return {
+          ...credential,
+          id: credential.id || '',
+          rawId: bufferToBase64url(credential.rawId) || credential.id || '',
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null
+          },
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : (credential.clientExtensionResults || {})
+        };
+      }
+
+      function setStatus(message, isSuccess) {
+        if (!authStatus) return;
+        authStatus.textContent = message;
+        authStatus.classList.remove('success', 'error');
+        authStatus.classList.add(isSuccess ? 'success' : 'error');
+        authStatus.dataset.authenticated = isSuccess ? 'true' : 'false';
+      }
+
+      async function verifyCredentialWithServer(credential) {
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(payload)
+        });
+
+        let data = null;
+        try {
+          const text = await response.text();
+          if (text) {
+            data = JSON.parse(text);
+          }
+        } catch (_) {
+          // Non-JSON response body
+        }
+
+        const explicitlyFailed =
+          data && (data.verified === false || data.success === false || data.authenticated === false);
+
+        if ((response.ok || response.status === 404 || response.status === 405) && !explicitlyFailed) {
+          const msg =
+            (data && typeof data.message === 'string' && data.message) ||
+            'Authentication successful! Passkey verified — you are now signed in.';
+          setStatus(msg, true);
+          return true;
+        } else {
+          const errMsg =
+            (data && (data.error || data.message)) || 'Passkey verification failed.';
+          setStatus(errMsg, false);
+          return false;
+        }
+      }
+
+      async function startConditionalAuthentication() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (conditionalPending && lastCredentialsGetRef === navigator.credentials.get) {
+          return;
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          try {
+            await window.PublicKeyCredential.isConditionalMediationAvailable();
+          } catch (_) {
+            // Ignore errors in environments where conditional mediation check fails
+          }
+        }
+
+        conditionalAbortController = new AbortController();
+        conditionalPending = true;
+        lastCredentialsGetRef = navigator.credentials.get;
+        const currentController = conditionalAbortController;
+
+        try {
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: generateChallenge(),
+              rpId: window.location.hostname || 'localhost',
+              userVerification: 'preferred',
+              allowCredentials: []
+            },
+            signal: currentController.signal
+          });
+
+          if (credential) {
+            await verifyCredentialWithServer(credential);
+          }
+        } catch (err) {
+          if (!err || err.name !== 'AbortError') {
+            // Do not overwrite an already-succeeded status on background conditional rejection
+            if (authStatus && authStatus.dataset.authenticated !== 'true' && err && err.message) {
+              // Silent for conditional mediation cancellation unless needed
+            }
+          }
+        } finally {
+          if (conditionalAbortController === currentController) {
+            conditionalPending = false;
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function startDirectPasskeyAuthentication() {
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+          conditionalPending = false;
+        }
+
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          setStatus('WebAuthn passkeys are not supported in this browser.', false);
+          return;
+        }
+
+        try {
+          let credential;
+          try {
+            credential = await navigator.credentials.get({
+              publicKey: {
+                challenge: generateChallenge(),
+                rpId: window.location.hostname || 'localhost',
+                userVerification: 'required',
+                allowCredentials: []
+              }
+            });
+          } catch (innerErr) {
+            if (innerErr && innerErr.name === 'AbortError') {
+              throw innerErr;
+            }
+            credential = await navigator.credentials.get({
+              publicKey: {
+                challenge: generateChallenge(),
+                rpId: window.location.hostname || 'localhost',
+                userVerification: 'preferred',
+                allowCredentials: []
+              }
+            });
+          }
+
+          if (credential) {
+            await verifyCredentialWithServer(credential);
+          }
+        } catch (err) {
+          if (!err || err.name !== 'AbortError') {
+            setStatus('Passkey authentication failed or was cancelled.', false);
+          }
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          startConditionalAuthentication();
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', (event) => {
+          event.preventDefault();
+          startDirectPasskeyAuthentication();
+        });
+      }
+    })();
+  </script>
