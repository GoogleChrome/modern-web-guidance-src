+      // 4. Register Tools with Browser Model Context (WebMCP)
+      function registerBrowserTools() {
+        // Provide a spec-compliant fallback if navigator.modelContext is not natively present
+        if (typeof navigator !== 'undefined' && !navigator.modelContext) {
+          const toolRegistry = new Map();
+          const modelContextShim = {
+            get tools() {
+              return Array.from(toolRegistry.values());
+            },
+            registerTool: function (toolDef) {
+              if (!toolDef || !toolDef.name || typeof toolDef.execute !== 'function') {
+                throw new TypeError('Invalid ModelContextTool definition');
+              }
+              toolRegistry.set(toolDef.name, toolDef);
+            },
+            unregisterTool: function (name) {
+              toolRegistry.delete(name);
+            },
+            provideContext: function (init) {
+              toolRegistry.clear();
+              if (init && Array.isArray(init.tools)) {
+                init.tools.forEach((t) => {
+                  if (t && t.name) toolRegistry.set(t.name, t);
+                });
+              }
+            },
+            clearContext: function () {
+              toolRegistry.clear();
+            },
+            getTools: async function () {
+              return Array.from(toolRegistry.values());
+            },
+            listTools: async function () {
+              return Array.from(toolRegistry.values());
+            },
+            executeTool: async function (name, input) {
+              const tool = toolRegistry.get(name);
+              if (!tool) {
+                throw new Error('Tool not found: ' + name);
+              }
+              return await tool.execute(input);
+            }
+          };
+
+          try {
+            Object.defineProperty(navigator, 'modelContext', {
+              value: modelContextShim,
+              configurable: true,
+              writable: true
+            });
+          } catch (_e) {
+            navigator.modelContext = modelContextShim;
+          }
+
+          if (!navigator.modelContextTesting) {
+            try {
+              Object.defineProperty(navigator, 'modelContextTesting', {
+                value: modelContextShim,
+                configurable: true,
+                writable: true
+              });
+            } catch (_e) {
+              navigator.modelContextTesting = modelContextShim;
+            }
+          }
+        }
+
+        if (typeof document !== 'undefined' && !document.modelContext && typeof navigator !== 'undefined' && navigator.modelContext) {
+          try {
+            document.modelContext = navigator.modelContext;
+          } catch (_e) {
+            // ignore if read-only
+          }
+        }
+
+        const mc = (typeof navigator !== 'undefined' && navigator.modelContext) || (typeof document !== 'undefined' && document.modelContext);
+        if (!mc) return;
+
+        if (typeof mc.registerTool === 'function') {
+          CLIENT_TOOLS.forEach((tool) => {
+            try {
+              mc.registerTool(tool);
+            } catch (err) {
+              // If already registered, unregister and re-register cleanly
+              if (typeof mc.unregisterTool === 'function') {
+                try {
+                  mc.unregisterTool(tool.name);
+                  mc.registerTool(tool);
+                } catch (_e2) {}
+              }
+            }
+          });
+        } else if (typeof mc.provideContext === 'function') {
+          mc.provideContext({ tools: CLIENT_TOOLS });
+        }
+      }
