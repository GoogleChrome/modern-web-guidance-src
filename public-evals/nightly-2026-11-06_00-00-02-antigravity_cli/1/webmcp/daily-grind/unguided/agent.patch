+      // Core Action 5: Trigger Interactive UI Updates on the Page
+      function triggerPageUIUpdate(rawInput) {
+        const input = normalizeInput(rawInput);
+        const appliedUpdates = [];
+
+        if (input.category !== undefined || input.query !== undefined || input.filter !== undefined) {
+          const cat = input.category || input.filter || state.activeCategory;
+          const q = input.query !== undefined ? input.query : state.searchQuery;
+          updateMenuGridUI({ category: cat, query: q });
+          appliedUpdates.push('Filtered Seasonal Favorites (category="' + cat + '", query="' + q + '")');
+        }
+
+        if (input.highlightDrink || input.drink || input.showDetailsFor) {
+          const targetDrink = findDrink(input.highlightDrink || input.showDetailsFor || input.drink);
+          if (targetDrink) {
+            if (input.showDetails !== false) {
+              showDrinkDetailsUI(targetDrink);
+              appliedUpdates.push('Opened details panel & highlighted "' + targetDrink.name + '"');
+            } else {
+              updateMenuGridUI({ highlightDrinkId: targetDrink.id });
+              appliedUpdates.push('Highlighted "' + targetDrink.name + '" card');
+            }
+          }
+        }
+
+        if (input.promoCode) {
+          const code = String(input.promoCode).trim().toUpperCase();
+          state.promoCode = code;
+          state.discountRate = 0.15;
+          const promoEl = document.getElementById('active-promo-display');
+          if (promoEl) {
+            promoEl.textContent = 'Promo Applied: ' + code + ' (15% OFF)';
+          }
+          renderOrderUI();
+          appliedUpdates.push('Applied seasonal promo code ' + code + ' (15% discount)');
+        }
+
+        if (input.bannerMessage || input.statusMessage || input.message) {
+          const msg = String(input.bannerMessage || input.statusMessage || input.message);
+          updateStatusBanner(input.badgeText || 'Page Updated', msg, state.orders.length > 0);
+          appliedUpdates.push('Updated status banner message');
+        }
+
+        if (input.subtitle) {
+          const subEl = document.getElementById('seasonal-menu-subtitle');
+          if (subEl) subEl.textContent = String(input.subtitle);
+          appliedUpdates.push('Updated Seasonal Favorites subtitle');
+        }
+
+        if (appliedUpdates.length === 0) {
+          updateStatusBanner('UI Refreshed', 'Seasonal Favorites menu and order display synchronized.', state.orders.length > 0);
+          appliedUpdates.push('Synchronized Seasonal Favorites UI state');
+        }
+
+        const uiPayload = {
+          success: true,
+          appliedUpdates: appliedUpdates,
+          uiState: {
+            activeCategory: state.activeCategory,
+            searchQuery: state.searchQuery,
+            highlightedDrinkId: state.highlightedDrinkId,
+            selectedDrink: state.selectedDrinkDetails ? state.selectedDrinkDetails.name : null,
+            promoCode: state.promoCode,
+            totalItemsInOrder: state.totalItems,
+            totalOrderPrice: state.totalPrice,
+            statusMessage: state.statusMessage
+          }
+        };
+
+        return {
+          ...uiPayload,
+          content: [{ type: 'text', text: JSON.stringify(uiPayload, null, 2) }]
+        };
+      }
