+        const input = normalizeInput(rawInput);
+        const action = String(input.action || 'checkout').trim().toLowerCase();
+
+        if (action === 'clear' || action === 'reset' || action === 'cancel') {
+          state.orders = [];
+          state.lastOrder = null;
+          state.checkoutReceipt = null;
+          renderOrderUI();
+          updateStatusBanner('Order Cleared', 'Your active drink order tray has been cleared.', false);
+
+          const clearPayload = {
+            success: true,
+            action: 'clear',
+            cart: [],
+            totalItems: 0,
+            totalPrice: 0,
+            message: 'Order tray cleared.'
+          };
+          return {
+            ...clearPayload,
+            content: [{ type: 'text', text: JSON.stringify(clearPayload, null, 2) }]
+          };
+        }
+
+        if (action === 'status' || action === 'get' || action === 'view') {
+          const statusPayload = {
+            success: true,
+            action: 'status',
+            cart: state.orders,
+            totalItems: state.totalItems,
+            subtotal: state.subtotal,
+            totalPrice: state.totalPrice,
+            formattedTotal: '$' + state.totalPrice.toFixed(2),
+            lastOrder: state.lastOrder,
+            checkoutReceipt: state.checkoutReceipt
+          };
+          return {
+            ...statusPayload,
+            content: [{ type: 'text', text: JSON.stringify(statusPayload, null, 2) }]
+          };
+        }
+
+        // Default: Checkout current order (if empty, place a default Maple Oat Latte or specified drink first)
+        if (state.orders.length === 0 && (input.drink || input.item || input.name)) {
+          placeDrinkOrder(input);
+        }
+
+        const receiptId = 'DG-CHK-' + Math.floor(1000 + Math.random() * 9000);
+        const itemsSummary = state.orders.length > 0
+          ? state.orders.map((o) => o.quantity + 'x ' + o.size + ' ' + o.drinkName).join(', ')
+          : 'No items in tray';
+
+        state.checkoutReceipt = {
+          receiptId: receiptId,
+          customerName: input.customerName || (state.lastOrder && state.lastOrder.customerName) || 'Guest',
+          items: [...state.orders],
+          totalItems: state.totalItems,
+          totalPrice: state.totalPrice,
+          formattedTotal: '$' + state.totalPrice.toFixed(2),
