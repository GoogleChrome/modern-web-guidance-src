+
+        if (navCartBadgeEl) {
+          navCartBadgeEl.textContent = `Order: ${totalItems} item${totalItems === 1 ? "" : "s"} ($${totalPrice.toFixed(2)})`;
+        }
+
+        if (orderTotalEl) {
+          orderTotalEl.textContent = `$${totalPrice.toFixed(2)}`;
+        }
+
+        if (!orderListEl) return;
+        orderListEl.replaceChildren();
+
+        if (orderTray.length === 0) {
+          const emptyLi = document.createElement("li");
+          emptyLi.id = "empty-order-msg";
+          emptyLi.style.padding = "14px 0";
+          emptyLi.style.color = "#795548";
+          emptyLi.style.fontStyle = "italic";
+          emptyLi.textContent = "No drinks in your order tray yet.";
+          orderListEl.appendChild(emptyLi);
+          return;
+        }
+
+        for (const item of orderTray) {
+          const li = document.createElement("li");
+          li.className = "order-item";
+
+          const descSpan = document.createElement("span");
+          const labelPart = item.customerName ? ` for ${item.customerName}` : "";
+          descSpan.textContent = `${item.quantity}x ${item.size} ${item.drinkName} (${item.milk}${labelPart})`;
+
+          const priceSpan = document.createElement("strong");
+          priceSpan.textContent = `$${item.lineTotal.toFixed(2)}`;
+
+          li.append(descSpan, priceSpan);
+          orderListEl.appendChild(li);
+        }
+      }
+
+      function applyMenuFilterUI({ query = "", dietary = "all", temperature = "all", maxPrice } = {}) {
+        const normalizedQuery = String(query || "").trim().toLowerCase();
+        const normalizedDietary = VALID_DIETARY.includes(dietary) ? dietary : "all";
+        const normalizedTemp = VALID_TEMPS.includes(temperature) ? temperature : "all";
+
+        const matchedItems = SEASONAL_MENU.filter((item) => {
+          const matchesQuery =
+            !normalizedQuery ||
+            item.name.toLowerCase().includes(normalizedQuery) ||
+            item.description.toLowerCase().includes(normalizedQuery) ||
+            item.tastingNotes.toLowerCase().includes(normalizedQuery);
+
+          const matchesDietary =
+            normalizedDietary === "all" || item.dietary.includes(normalizedDietary);
+
+          const matchesTemp =
+            normalizedTemp === "all" || item.servedTemperatures.includes(normalizedTemp);
+
+          const matchesPrice =
+            typeof maxPrice !== "number" || Number.isNaN(maxPrice) || item.basePrice <= maxPrice;
+
+          return matchesQuery && matchesDietary && matchesTemp && matchesPrice;
+        });
+
+        const matchedIds = new Set(matchedItems.map((i) => i.id));
+        const cards = document.querySelectorAll("#seasonal-menu-grid .card");
+        cards.forEach((card) => {
+          const cardId = card.getAttribute("data-drink-id");
+          card.classList.toggle("is-hidden", !matchedIds.has(cardId));
+        });
+
+        if (filterStatusEl) {
+          filterStatusEl.textContent = `Showing ${matchedItems.length} of ${SEASONAL_MENU.length} seasonal drinks`;
+        }
+
+        return matchedItems;
+      }
+
+      function updateDrinkUI({ drinkId, highlight = true, expandDetails = true }) {
+        const drink = findDrink(drinkId);
+        if (!drink) {
+          return {
+            error: `Drink "${drinkId}" not found in Seasonal Favorites.`,
+            availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+          };
+        }
+
+        const cards = document.querySelectorAll("#seasonal-menu-grid .card");
+        cards.forEach((card) => {
+          const isTarget = card.getAttribute("data-drink-id") === drink.id;
+          if (isTarget) {
+            card.classList.remove("is-hidden");
+            card.classList.toggle("is-highlighted", Boolean(highlight));
+            card.classList.toggle("show-details", Boolean(expandDetails));
+          } else if (highlight) {
+            card.classList.remove("is-highlighted");
+          }
+        });
+
+        // Sync the order form selection so the user and agent see the selected drink
+        const radioInput = drinkOrderForm?.querySelector(`input[name="drinkName"][value="${drink.name}"]`);
+        if (radioInput) {
+          radioInput.checked = true;
+        }
+
+        updateStatusBanner(`Viewing details for ${drink.name} ($${drink.basePrice.toFixed(2)}).`);
+
+        return {
+          status: "updated",
+          highlightedDrink: drink,
+          uiState: {
+            highlighted: Boolean(highlight),
+            detailsExpanded: Boolean(expandDetails)
+          }
+        };
+      }
+
+      function addDrinkOrder({
+        drinkName,
+        size = "Medium",
+        milk,
+        quantity = 1,
+        customerName = ""
+      }) {
+        const drink = findDrink(drinkName);
+        if (!drink) {
+          const errorObj = {
+            error: `Menu item "${drinkName}" not found in Seasonal Favorites.`,
+            availableDrinks: SEASONAL_MENU.map((item) => item.name)
+          };
+          showOrderToast(errorObj.error, true);
+          return errorObj;
+        }
+
+        const resolvedSize = VALID_SIZES.includes(size) ? size : null;
+        if (!resolvedSize) {
+          const errorObj = {
+            error: `Invalid size "${size}".`,
+            supportedSizes: VALID_SIZES
+          };
+          showOrderToast(errorObj.error, true);
+          return errorObj;
+        }
+
+        const resolvedMilk = milk ? (VALID_MILKS.includes(milk) ? milk : null) : drink.defaultMilk;
+        if (!resolvedMilk) {
+          const errorObj = {
+            error: `Unsupported milk option "${milk}".`,
+            supportedMilks: VALID_MILKS
+          };
+          showOrderToast(errorObj.error, true);
+          return errorObj;
+        }
+
+        const parsedQty = Number(quantity);
+        if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 20) {
+          const errorObj = {
+            error: "Quantity must be an integer between 1 and 20."
+          };
+          showOrderToast(errorObj.error, true);
+          return errorObj;
+        }
+
+        const unitPrice = drink.pricesBySize[resolvedSize] ?? drink.basePrice;
+        const lineTotal = Number((unitPrice * parsedQty).toFixed(2));
+        const cleanCustomer = String(customerName || "").trim();
+
+        const orderEntry = {
+          orderItemId: `ord-${Date.now()}-${orderTray.length + 1}`,
+          drinkId: drink.id,
+          drinkName: drink.name,
+          size: resolvedSize,
+          milk: resolvedMilk,
+          quantity: parsedQty,
+          unitPrice,
+          lineTotal,
+          customerName: cleanCustomer
+        };
+
+        orderTray.push(orderEntry);
+        renderOrderTray();
+
+        // Highlight the ordered drink card on the page
+        updateDrinkUI({ drinkId: drink.id, highlight: true, expandDetails: true });
+
+        const summaryMsg = `Added ${parsedQty}x ${resolvedSize} ${drink.name} (${resolvedMilk}) to order tray — $${lineTotal.toFixed(2)}.`;
+        showOrderToast(summaryMsg, false);
+        updateStatusBanner(summaryMsg);
+
+        const totalAmount = Number(orderTray.reduce((sum, entry) => sum + entry.lineTotal, 0).toFixed(2));
+        const totalCount = orderTray.reduce((sum, entry) => sum + entry.quantity, 0);
+
+        return {
+          status: "ordered",
+          addedItem: orderEntry,
+          orderSummary: {
+            totalItems: totalCount,
+            totalPrice: totalAmount,
+            items: [...orderTray]
+          }
+        };
+      }
+
+      // Wire standard DOM event handlers for user and agent form submissions
+      if (menuSearchForm) {
+        menuSearchForm.addEventListener("submit", (event) => {
+          event.preventDefault();
+          const formData = new FormData(menuSearchForm);
+          const query = String(formData.get("query") || "");
+          const dietary = String(formData.get("dietary") || "all");
+
+          const matched = applyMenuFilterUI({ query, dietary });
+          updateStatusBanner(`Filtered Seasonal Favorites: ${matched.length} matching drink(s).`);
+
+          if (event.agentInvoked && typeof event.respondWith === "function") {
+            event.respondWith(
+              Promise.resolve(
+                JSON.stringify({
+                  matchedCount: matched.length,
+                  drinks: matched
+                })
+              )
+            );
+          }
+        });
+      }
+
+      if (drinkOrderForm) {
+        drinkOrderForm.addEventListener("submit", (event) => {
+          event.preventDefault();
+          const formData = new FormData(drinkOrderForm);
+          const drinkName = String(formData.get("drinkName") || "");
+          const size = String(formData.get("size") || "Medium");
+          const milk = String(formData.get("milk") || "Oat Milk");
+          const customerName = String(formData.get("customerName") || "");
+
+          const result = addDrinkOrder({
+            drinkName,
+            size,
+            milk,
+            quantity: 1,
+            customerName
+          });
+
+          if (event.agentInvoked && typeof event.respondWith === "function") {
+            if (result.error) {
+              event.respondWith(Promise.resolve(`Validation failed: ${result.error}`));
+            } else {
+              event.respondWith(Promise.resolve(JSON.stringify(result)));
+            }
+          }
+        });
+      }
+
+      // Card buttons ("View Details" & "Quick Order")
+      document.querySelectorAll(".toggle-details-btn").forEach((btn) => {
+        btn.addEventListener("click", (event) => {
+          event.preventDefault();
+          const targetId = btn.getAttribute("data-target");
+          const card = document.querySelector(`.card[data-drink-id="${targetId}"]`);
+          const willExpand = card ? !card.classList.contains("show-details") : true;
+          updateDrinkUI({ drinkId: targetId, highlight: true, expandDetails: willExpand });
+        });
+      });
+
+      document.querySelectorAll(".quick-order-btn").forEach((btn) => {
+        btn.addEventListener("click", () => {
+          const drinkName = btn.getAttribute("data-drink");
+          addDrinkOrder({ drinkName, size: "Medium", quantity: 1 });
+        });
+      });
+
+      if (resetUiBtn) {
+        resetUiBtn.addEventListener("click", () => {
+          if (menuSearchForm) menuSearchForm.reset();
+          applyMenuFilterUI({ query: "", dietary: "all", temperature: "all" });
+          document.querySelectorAll("#seasonal-menu-grid .card").forEach((card) => {
+            card.classList.remove("is-highlighted", "show-details", "is-hidden");
+          });
+          updateStatusBanner("Reset Seasonal Favorites view to default.");
+        });
+      }
+
+      // WebMCP Lifecycle Event Listeners (compatible with Chrome 156+ on document.modelContext and older window fallback)
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor("toolactivated", ({ toolName }) => {
+        if (toolName) {
+          updateStatusBanner(`AI Agent executing tool: "${toolName}"…`);
+        }
+      });
+
+      targetFor("toolcancel", ({ toolName }) => {
+        if (toolName) {
+          updateStatusBanner(`AI Agent cancelled tool: "${toolName}".`);
+        }
+      });
+
+      // Imperative WebMCP Tool Registration with Feature Detection and AbortController lifecycle cleanup
+      async function registerDailyGrindWebMcpTools() {
+        if (!("modelContext" in document) || !document.modelContext) {
+          return;
+        }
+
+        const controller = new AbortController();
+        const { signal } = controller;
+
+        window.addEventListener("pagehide", () => controller.abort(), { once: true });
+
+        // 1. Query Seasonal Favorites Menu Tool (Read-Only)
+        await document.modelContext.registerTool(
+          {
+            name: "query_seasonal_favorites_menu",
+            description:
+              "Queries the Seasonal Favorites coffee menu and optionally filters visible drink cards on the page by search keyword, dietary need, serving temperature, or maximum price. Use when the user asks what drinks are on the Seasonal Favorites menu, wants nutrition/caffeine/pricing details, or wants to filter the menu.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                query: {
+                  type: "string",
+                  description: "Keyword to match against drink name, description, or tasting notes."
+                },
+                dietary: {
+                  type: "string",
+                  enum: VALID_DIETARY,
+                  default: "all",
+                  description: "Dietary restriction to filter by."
+                },
+                temperature: {
+                  type: "string",
+                  enum: VALID_TEMPS,
+                  default: "all",
+                  description: "Serving temperature preference."
+                },
+                maxPrice: {
+                  type: "number",
+                  minimum: 0,
+                  description: "Maximum base drink price in USD."
+                },
+                updatePageFilter: {
+                  type: "boolean",
+                  default: true,
+                  description: "Whether to update the visible Seasonal Favorites cards on the page to reflect the filter."
+                }
+              }
+            },
+            execute(input = {}) {
+              const {
+                query = "",
+                dietary = "all",
+                temperature = "all",
+                maxPrice,
+                updatePageFilter = true
+              } = input || {};
+
+              if (!VALID_DIETARY.includes(dietary)) {
+                return {
+                  error: "Unsupported dietary filter value.",
+                  supportedDietaryValues: VALID_DIETARY
+                };
+              }
+
+              if (!VALID_TEMPS.includes(temperature)) {
+                return {
+                  error: "Unsupported temperature filter value.",
+                  supportedTemperatures: VALID_TEMPS
+                };
+              }
+
+              if (maxPrice !== undefined && (typeof maxPrice !== "number" || Number.isNaN(maxPrice) || maxPrice < 0)) {
+                return {
+                  error: "Provide a non-negative number for maxPrice."
+                };
+              }
+
+              let matches;
+              if (updatePageFilter) {
+                matches = applyMenuFilterUI({ query, dietary, temperature, maxPrice });
+              } else {
+                const q = String(query || "").trim().toLowerCase();
+                matches = SEASONAL_MENU.filter((item) => {
+                  const mQuery =
+                    !q ||
+                    item.name.toLowerCase().includes(q) ||
+                    item.description.toLowerCase().includes(q) ||
+                    item.tastingNotes.toLowerCase().includes(q);
+                  const mDiet = dietary === "all" || item.dietary.includes(dietary);
+                  const mTemp = temperature === "all" || item.servedTemperatures.includes(temperature);
+                  const mPrice = maxPrice === undefined || item.basePrice <= maxPrice;
+                  return mQuery && mDiet && mTemp && mPrice;
+                });
+              }
+
+              return {
+                totalMenuCount: SEASONAL_MENU.length,
+                matchedCount: matches.length,
+                drinks: matches
+              };
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          },
+          { signal }
+        );
+
+        // 2. Order Seasonal Drink Tool (Interactive Order & UI Update)
+        await document.modelContext.registerTool(
+          {
+            name: "order_seasonal_drink",
+            description:
+              "Places an interactive drink order for a Seasonal Favorites item and updates the live Order Tray and navigation cart counter on the page. Use when the user asks to order, buy, or add a coffee drink to their order.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                drinkName: {
+                  type: "string",
+                  enum: SEASONAL_MENU.map((d) => d.name),
+                  description: "Name of the Seasonal Favorites drink to order."
+                },
+                size: {
+                  type: "string",
+                  enum: VALID_SIZES,
+                  default: "Medium",
+                  description: "Cup size for the drink."
+                },
+                milk: {
+                  type: "string",
+                  enum: VALID_MILKS,
+                  description: "Milk or non-dairy option for the drink."
+                },
+                quantity: {
+                  type: "number",
+                  minimum: 1,
+                  maximum: 20,
+                  default: 1,
+                  description: "Number of cups to add to the order."
+                },
+                customerName: {
+                  type: "string",
+                  description: "Customer name for the cup label."
+                }
+              },
+              required: ["drinkName"]
+            },
+            execute(input = {}) {
+              const {
+                drinkName,
+                size = "Medium",
+                milk,
+                quantity = 1,
+                customerName = ""
+              } = input || {};
+
+              return addDrinkOrder({
+                drinkName,
+                size,
+                milk,
+                quantity,
+                customerName
+              });
+            },
+            annotations: {
+              readOnlyHint: false,
+              consequentialHint: false,
+              untrustedContentHint: false
+            }
+          },
+          { signal }
+        );
+
+        // 3. Highlight or Inspect Seasonal Drink UI Tool
+        await document.modelContext.registerTool(
+          {
+            name: "update_seasonal_menu_ui",
+            description:
+              "Updates the homepage UI to highlight a specific Seasonal Favorites drink card, expand or collapse its tasting notes and nutrition details, or reset all menu filters. Use when the user wants to inspect, spotlight, or compare a drink on the page.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                action: {
+                  type: "string",
+                  enum: ["highlight_drink", "expand_all_details", "reset_view"],
+                  default: "highlight_drink",
+                  description: "UI update action to perform on the Seasonal Favorites section."
+                },
+                drinkName: {
+                  type: "string",
+                  enum: SEASONAL_MENU.map((d) => d.name),
+                  description: "Target Seasonal Favorites drink when highlighting or inspecting a single card."
+                }
+              },
+              required: ["action"]
+            },
+            execute(input = {}) {
+              const { action = "highlight_drink", drinkName } = input || {};
+
+              if (action === "reset_view") {
+                if (menuSearchForm) menuSearchForm.reset();
+                const allDrinks = applyMenuFilterUI({ query: "", dietary: "all", temperature: "all" });
+                document.querySelectorAll("#seasonal-menu-grid .card").forEach((card) => {
+                  card.classList.remove("is-highlighted", "show-details", "is-hidden");
+                });
+                updateStatusBanner("Reset Seasonal Favorites view to default.");
+                return {
+                  status: "reset",
+                  visibleCount: allDrinks.length
+                };
+              }
+
+              if (action === "expand_all_details") {
+                document.querySelectorAll("#seasonal-menu-grid .card").forEach((card) => {
+                  card.classList.remove("is-hidden");
+                  card.classList.add("show-details");
+                });
+                updateStatusBanner("Expanded tasting notes and nutrition details for all Seasonal Favorites.");
+                return {
+                  status: "expanded_all",
+                  drinks: SEASONAL_MENU.map((d) => d.name)
+                };
+              }
+
+              if (action === "highlight_drink") {
+                if (!drinkName) {
+                  return {
+                    error: "Provide drinkName when action is 'highlight_drink'.",
+                    availableDrinks: SEASONAL_MENU.map((d) => d.name)
+                  };
+                }
+                return updateDrinkUI({
+                  drinkId: drinkName,
+                  highlight: true,
+                  expandDetails: true
+                });
+              }
+
+              return {
+                error: `Unsupported UI action "${action}".`,
+                supportedActions: ["highlight_drink", "expand_all_details", "reset_view"]
+              };
+            },
+            annotations: {
+              readOnlyHint: false
+            }
+          },
+          { signal }
+        );
+
+        // 4. Get Current Order Tray State Tool (Read-Only)
+        await document.modelContext.registerTool(
+          {
+            name: "get_order_tray_summary",
+            description:
+              "Returns the current items, quantities, and total price in the customer's interactive drink order tray. Use when the user asks to review their current order or total.",
+            inputSchema: {
+              type: "object",
+              properties: {}
+            },
+            execute() {
+              const totalItems = orderTray.reduce((sum, entry) => sum + entry.quantity, 0);
+              const totalPrice = Number(orderTray.reduce((sum, entry) => sum + entry.lineTotal, 0).toFixed(2));
+              return {
+                totalItems,
+                totalPrice,
+                items: [...orderTray]
+              };
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          },
+          { signal }
+        );
+      }
+
+      registerDailyGrindWebMcpTools();
+    })();
+  </script>
 </body>
 
 </html>
