diff --git a/src/components/ArticleUtilities.tsx b/src/components/ArticleUtilities.tsx
new file mode 100644
index 0000000..66a3af0
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,445 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleSummaryItem {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  date: string;
+  readingTime?: number;
+}
+
+interface ArticleUtilitiesProps {
+  currentArticle?: ArticleSummaryItem & {
+    imageCaption?: string;
+    relatedSlugs?: string[];
+  };
+  initialIsBookmarked?: boolean;
+}
+
+const LIST_ARTICLES_SCHEMA = {
+  type: 'object',
+  properties: {
+    category: {
+      type: 'string',
+      description: 'Category name to filter articles by.',
+    },
+    limit: {
+      type: 'number',
+      minimum: 1,
+      maximum: 50,
+      default: 10,
+      description: 'Maximum number of articles to return.',
+    },
+  },
+} as const;
+
+const READ_ONLY_ANNOTATIONS = {
+  readOnlyHint: true,
+} as const;
+
+const MUTATION_ANNOTATIONS = {
+  readOnlyHint: false,
+} as const;
+
+const EMPTY_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const TEXT_SIZE_OPTIONS = ['sm', 'base', 'lg', 'xl'] as const;
+type TextSizeOption = (typeof TEXT_SIZE_OPTIONS)[number];
+
+const TEXT_SIZE_SCHEMA = {
+  type: 'object',
+  properties: {
+    size: {
+      type: 'string',
+      enum: TEXT_SIZE_OPTIONS,
+      default: 'base',
+      description: 'Desired typography scale for the article body.',
+    },
+  },
+  required: ['size'],
+} as const;
+
+const HIGHLIGHT_SCHEMA = {
+  type: 'object',
+  properties: {
+    term: {
+      type: 'string',
+      description: 'Phrase or keyword to find and highlight in the current article body. Pass an empty string to clear highlights.',
+    },
+  },
+  required: ['term'],
+} as const;
+
+const NAVIGATE_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    slug: {
+      type: 'string',
+      description: 'Identifier slug of the article to open.',
+    },
+  },
+  required: ['slug'],
+} as const;
+
+export default function ArticleUtilities({
+  currentArticle,
+  initialIsBookmarked = false,
+}: ArticleUtilitiesProps) {
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+  const [textSize, setTextSize] = useState<TextSizeOption>('base');
+  const [highlightTerm, setHighlightTerm] = useState<string>('');
+  const [shareFeedback, setShareFeedback] = useState<string | null>(null);
+
+  const isOnArticlePage = Boolean(currentArticle?.slug);
+
+  useEffect(() => {
+    setIsBookmarked(initialIsBookmarked);
+  }, [initialIsBookmarked]);
+
+  useEffect(() => {
+    const handleUpdate = (event: Event) => {
+      const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+      if (currentArticle?.slug && Array.isArray(customEvent.detail?.readingList)) {
+        setIsBookmarked(customEvent.detail.readingList.includes(currentArticle.slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleUpdate);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleUpdate);
+    };
+  }, [currentArticle?.slug]);
+
+  const applyTextSizeToDOM = (size: TextSizeOption) => {
+    setTextSize(size);
+    const proseEl = document.querySelector('article .prose') as HTMLElement | null;
+    if (proseEl) {
+      proseEl.classList.remove('prose-sm', 'prose-base', 'prose-lg', 'prose-xl');
+      proseEl.classList.add(`prose-${size}`);
+    }
+  };
+
+  const applyHighlightToDOM = (term: string) => {
+    const trimmed = term.trim();
+    setHighlightTerm(trimmed);
+    const proseEl = document.querySelector('article .prose');
+    if (!proseEl) {
+      return { matches: 0, matchedParagraphs: [] as string[] };
+    }
+
+    const paragraphs = Array.from(proseEl.querySelectorAll('p, li, h2, h3, h4'));
+    const matchedParagraphs: string[] = [];
+    let matchCount = 0;
+
+    paragraphs.forEach(el => {
+      const htmlEl = el as HTMLElement;
+      htmlEl.style.backgroundColor = '';
+      htmlEl.style.outline = '';
+      htmlEl.removeAttribute('data-agent-highlighted');
+
+      if (trimmed && (htmlEl.textContent || '').toLowerCase().includes(trimmed.toLowerCase())) {
+        htmlEl.style.backgroundColor = 'rgba(251, 191, 36, 0.25)';
+        htmlEl.style.outline = '1px solid rgba(245, 158, 11, 0.5)';
+        htmlEl.setAttribute('data-agent-highlighted', 'true');
+        matchCount += 1;
+        matchedParagraphs.push((htmlEl.textContent || '').trim());
+      }
+    });
+
+    return { matches: matchCount, matchedParagraphs };
+  };
+
+  const isGlobalProvider = !currentArticle;
+
+  // Global tool: list or filter articles across the site
+  useWebMCP({
+    name: 'list_articles',
+    description: 'Lists published articles from The DevTools Times, optionally filtered by category. Use when the user wants to browse available articles or discover slugs.',
+    inputSchema: LIST_ARTICLES_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    enabled: isGlobalProvider,
+    async execute({ category, limit = 10 }: { category?: string; limit?: number }, { signal }) {
+      const safeLimit = typeof limit === 'number' && limit >= 1 && limit <= 50 ? Math.floor(limit) : 10;
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+        if (!response.ok) {
+          return { error: `Failed to fetch articles (${response.status}).` };
+        }
+        const data: Array<{ slug: string; title: string; summary: string; image?: string; category?: string }> =
+          await response.json();
+
+        let filtered = data;
+        if (typeof category === 'string' && category.trim()) {
+          const targetCategory = category.trim().toLowerCase();
+          filtered = data.filter(item =>
+            (item.category || '').toLowerCase() === targetCategory ||
+            item.title.toLowerCase().includes(targetCategory) ||
+            item.summary.toLowerCase().includes(targetCategory)
+          );
+        }
+
+        return {
+          totalAvailable: filtered.length,
+          articles: filtered.slice(0, safeLimit).map(item => ({
+            slug: item.slug,
+            title: item.title,
+            summary: item.summary,
+            url: `${import.meta.env.BASE_URL}articles/${item.slug}`,
+          })),
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  // Global tool: navigate directly to an article by slug
+  useWebMCP({
+    name: 'open_article',
+    description: 'Navigates the browser to a specific article page given its slug. Use when the user asks to open or read a specific article.',
+    inputSchema: NAVIGATE_ARTICLE_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    enabled: isGlobalProvider,
+    async execute({ slug }: { slug?: string }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) {
+        return { error: 'Please provide a non-empty article slug.' };
+      }
+      const normalized = slug.trim();
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+        if (response.ok) {
+          const catalog: Array<{ slug: string; title: string }> = await response.json();
+          const match = catalog.find(a => a.slug === normalized);
+          if (!match) {
+            return {
+              error: `Article "${normalized}" was not found.`,
+              availableSlugs: catalog.map(a => a.slug),
+            };
+          }
+        }
+        const targetUrl = `${import.meta.env.BASE_URL}articles/${normalized}`;
+        window.location.assign(targetUrl);
+        return {
+          navigatingTo: targetUrl,
+          slug: normalized,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  // Article-page utility: extract full structured article content & metadata
+  useWebMCP({
+    name: 'get_current_article_details',
+    description: 'Extracts the full text, headings, metadata, and word count of the article currently open on the page. Use when the user wants to summarize, analyze, or ask questions about the current article.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    enabled: isOnArticlePage,
+    execute() {
+      if (!currentArticle) {
+        return { error: 'No article is currently active on this page.' };
+      }
+      const proseEl = document.querySelector('article .prose');
+      const bodyText = proseEl ? (proseEl.textContent || '').trim() : '';
+      const headings = proseEl
+        ? Array.from(proseEl.querySelectorAll('h1, h2, h3, h4')).map(h => (h.textContent || '').trim())
+        : [];
+      const wordCount = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+
+      return {
+        slug: currentArticle.slug,
+        title: currentArticle.title,
+        summary: currentArticle.summary,
+        author: currentArticle.author,
+        category: currentArticle.category,
+        date: currentArticle.date,
+        readingTimeMinutes: currentArticle.readingTime ?? Math.max(1, Math.ceil(wordCount / 200)),
+        wordCount,
+        headings,
+        bodyText,
+        bookmarked: isBookmarked,
+        url: window.location.href,
+      };
+    },
+  });
+
+  // Article-page utility: toggle bookmark status for the current article
+  useWebMCP({
+    name: 'bookmark_current_article',
+    description: 'Toggles the reading-list bookmark status for the article currently open on the page. Use when the user asks to save, bookmark, or remove the current article.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    enabled: isOnArticlePage,
+    async execute(_args, { signal }) {
+      if (!currentArticle?.slug) {
+        return { error: 'No article is currently open on this page.' };
+      }
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ slug: currentArticle.slug }),
+          signal,
+        });
+        if (!response.ok) {
+          return { error: `Failed to toggle bookmark (${response.status}).` };
+        }
+        const data = await response.json();
+        const updatedList: string[] = Array.isArray(data.readingList) ? data.readingList : [];
+        const nowBookmarked = updatedList.includes(currentArticle.slug);
+        setIsBookmarked(nowBookmarked);
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } })
+        );
+        return {
+          slug: currentArticle.slug,
+          title: currentArticle.title,
+          bookmarked: nowBookmarked,
+          action: nowBookmarked ? 'bookmarked' : 'removed',
+          readingList: updatedList,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  // Article-page utility: adjust article reading text size
+  useWebMCP({
+    name: 'set_article_text_size',
+    description: 'Adjusts the font size of the current article body to make reading more comfortable. Use when the user asks to make the article text larger, smaller, or reset its size.',
+    inputSchema: TEXT_SIZE_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    enabled: isOnArticlePage,
+    execute({ size = 'base' }: { size?: TextSizeOption }) {
+      if (!TEXT_SIZE_OPTIONS.includes(size)) {
+        return {
+          error: 'Unsupported text size option.',
+          supportedSizes: TEXT_SIZE_OPTIONS,
+        };
+      }
+      applyTextSizeToDOM(size);
+      return {
+        slug: currentArticle?.slug,
+        textSize: size,
+      };
+    },
+  });
+
+  // Article-page utility: highlight passages matching a keyword or phrase
+  useWebMCP({
+    name: 'highlight_article_passages',
+    description: 'Highlights paragraphs and headings in the current article that contain a given keyword or phrase, or clears highlights when passed an empty term. Use when the user wants to locate or emphasize specific mentions within the article.',
+    inputSchema: HIGHLIGHT_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    enabled: isOnArticlePage,
+    execute({ term }: { term?: string }) {
+      if (typeof term !== 'string') {
+        return { error: 'Pass a string search term to highlight, or an empty string to clear highlights.' };
+      }
+      const { matches, matchedParagraphs } = applyHighlightToDOM(term);
+      return {
+        slug: currentArticle?.slug,
+        term: term.trim(),
+        matchCount: matches,
+        matchedParagraphs,
+      };
+    },
+  });
+
+  // Article-page utility: copy citation / share link
+  useWebMCP({
+    name: 'share_current_article',
+    description: 'Generates a formatted citation and shareable URL for the current article and copies the URL to the clipboard if permitted. Use when the user wants to share, cite, or copy the link to the current article.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    enabled: isOnArticlePage,
+    async execute() {
+      if (!currentArticle) {
+        return { error: 'No article is currently open on this page.' };
+      }
+      const shareUrl = window.location.href;
+      const citation = `"${currentArticle.title}" by ${currentArticle.author} — The DevTools Times (${currentArticle.date}) ${shareUrl}`;
+      let copiedToClipboard = false;
+
+      if (navigator.clipboard?.writeText) {
+        try {
+          await navigator.clipboard.writeText(shareUrl);
+          copiedToClipboard = true;
+        } catch {
+          copiedToClipboard = false;
+        }
+      }
+
+      setShareFeedback('Link ready to share');
+      return {
+        slug: currentArticle.slug,
+        title: currentArticle.title,
+        author: currentArticle.author,
+        url: shareUrl,
+        citation,
+        copiedToClipboard,
+      };
+    },
+  });
+
+  if (!isOnArticlePage || !currentArticle) {
+    return null;
+  }
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 text-xs text-gray-600" aria-label="Article utilities">
+      <div className="flex items-center gap-1 border border-gray-200 rounded-md px-2 py-1 bg-gray-50">
+        <span className="font-semibold text-gray-700 mr-1">Text size:</span>
+        {TEXT_SIZE_OPTIONS.map(option => (
+          <button
+            key={option}
+            type="button"
+            onClick={() => applyTextSizeToDOM(option)}
+            className={`px-1.5 py-0.5 rounded uppercase font-medium transition ${
+              textSize === option
+                ? 'bg-amber-400 text-gray-900'
+                : 'text-gray-600 hover:bg-gray-200'
+            }`}
+            aria-pressed={textSize === option}
+          >
+            {option}
+          </button>
+        ))}
+      </div>
+
+      {highlightTerm && (
+        <button
+          type="button"
+          onClick={() => applyHighlightToDOM('')}
+          className="px-2 py-1 border border-amber-300 bg-amber-50 text-amber-900 rounded-md hover:bg-amber-100 transition"
+        >
+          Clear highlight: "{highlightTerm}"
+        </button>
+      )}
+
+      {shareFeedback && (
+        <span className="text-amber-700 font-medium" role="status">
+          {shareFeedback}
+        </span>
+      )}
+    </div>
+  );
+}
