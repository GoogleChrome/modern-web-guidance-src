+
+    .roast-picker-group label {
+      display: block;
+      font-weight: 600;
+      margin-bottom: 0.4rem;
+      color: var(--light);
+      font-size: 0.95rem;
+    }
+
+    select.roast-select,
+    select.roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 10px 14px;
+      background-color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      color: var(--text);
+      font-size: 1rem;
+      font-family: inherit;
+      cursor: pointer;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    select.roast-select:hover {
+      border-color: var(--accent);
+    }
+
+    select.roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--primary);
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: var(--light);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 4px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);
+      width: anchor-size(width);
+      color: var(--text);
+      font-family: inherit;
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      color: var(--text);
+    }
+
+    select.roast-select option svg {
+      flex-shrink: 0;
+      color: var(--primary);
+    }
+
+    select.roast-select option:hover {
+      background-color: var(--secondary);
+    }
+
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--primary);
+      color: var(--light);
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    select.roast-select option:checked svg {
+      color: var(--accent);
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: var(--secondary);
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      text-align: left;
+      line-height: 1.3;
+    }
+
+    .option-title {
