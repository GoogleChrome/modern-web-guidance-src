+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const roastSelect = document.getElementById("roast-select");
+      if (!roastSelect) return;
+
+      // Support spatial Left/Right arrow navigation across the 3-column grid picker
+      roastSelect.addEventListener("keydown", (event) => {
+        if (!CSS.supports("appearance", "base-select")) return;
+        if (!roastSelect.matches(":open")) return;
+        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
+
+        const options = Array.from(roastSelect.querySelectorAll("option"));
+        const activeOption = document.activeElement?.closest("option") || roastSelect.selectedOptions[0];
+        if (!activeOption || options.length === 0) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        const currentCenter = {
+          x: currentRect.left + currentRect.width / 2,
+          y: currentRect.top + currentRect.height / 2,
+        };
+
+        let bestCandidate = null;
+        let bestDistance = Infinity;
+
+        for (const opt of options) {
+          if (opt === activeOption) continue;
+          const rect = opt.getBoundingClientRect();
+          const center = {
+            x: rect.left + rect.width / 2,
+            y: rect.top + rect.height / 2,
+          };
+          const dx = center.x - currentCenter.x;
+          const dy = center.y - currentCenter.y;
+
+          const isValidDirection =
+            (event.key === "ArrowRight" && dx > 4) ||
+            (event.key === "ArrowLeft" && dx < -4) ||
+            (event.key === "ArrowDown" && dy > 4) ||
+            (event.key === "ArrowUp" && dy < -4);
+
+          if (!isValidDirection) continue;
+
+          const distance = Math.hypot(dx, dy);
+          if (distance < bestDistance) {
+            bestDistance = distance;
+            bestCandidate = opt;
+          }
+        }
+
+        if (bestCandidate) {
+          event.preventDefault();
+          bestCandidate.focus();
+        }
+      });
+    });
+  </script>
