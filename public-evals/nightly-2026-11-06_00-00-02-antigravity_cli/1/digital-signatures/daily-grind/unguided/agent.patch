+      const tabVoucher = document.getElementById('tab-voucher');
+      const receiptForm = document.getElementById('receipt-form');
+      const voucherForm = document.getElementById('voucher-form');
+
+      const receiptItemSelect = document.getElementById('receipt-item');
+      const receiptQtyInput = document.getElementById('receipt-qty');
+      const receiptAddonSelect = document.getElementById('receipt-addon');
+      const receiptTotalInput = document.getElementById('receipt-total');
+
+      const previewDocTitle = document.getElementById('preview-doc-title');
+      const previewDocId = document.getElementById('preview-doc-id');
+      const previewFieldsContainer = document.getElementById('preview-fields-container');
+      const previewAlg = document.getElementById('preview-alg');
+      const previewDigest = document.getElementById('preview-digest');
+      const previewSig = document.getElementById('preview-sig');
+
+      const sendToVerifierBtn = document.getElementById('send-to-verifier-btn');
+      const copySignedJsonBtn = document.getElementById('copy-signed-json-btn');
+      const downloadSignedJsonBtn = document.getElementById('download-signed-json-btn');
+
+      const verifyJsonInput = document.getElementById('verify-json-input');
+      const verifyPubkeyInput = document.getElementById('verify-pubkey-input');
+      const verifyBtn = document.getElementById('verify-btn');
+      const simulateTamperBtn = document.getElementById('simulate-tamper-btn');
+      const restoreValidBtn = document.getElementById('restore-valid-btn');
+
+      const verifierBadge = document.getElementById('verifier-badge');
+      const verificationResult = document.getElementById('verification-result');
+      const verificationHeadline = document.getElementById('verification-headline');
+      const verificationSchemeTag = document.getElementById('verification-scheme-tag');
+      const verificationDetails = document.getElementById('verification-details');
+
+      const ledgerCount = document.getElementById('ledger-count');
+      const signedLedgerList = document.getElementById('signed-ledger-list');
+
+      function recalculateReceiptTotal() {
+        const [, itemPriceStr] = receiptItemSelect.value.split('|');
+        const [, addonPriceStr] = receiptAddonSelect.value.split('|');
+        const qty = Math.max(1, parseInt(receiptQtyInput.value || '1', 10));
+        const total = (parseFloat(itemPriceStr) * qty + parseFloat(addonPriceStr)).toFixed(2);
+        receiptTotalInput.value = total;
+      }
+
+      receiptItemSelect.addEventListener('change', recalculateReceiptTotal);
+      receiptQtyInput.addEventListener('input', recalculateReceiptTotal);
+      receiptAddonSelect.addEventListener('change', recalculateReceiptTotal);
+
+      function updateKeyRingUI() {
+        if (!state.keyRing) return;
+        const kr = state.keyRing;
+        const isPqc = kr.algorithm.includes('PQC');
+
+        activeSchemeBadge.textContent = isPqc ? 'Quantum-Resistant Active' : 'Classical WebCrypto Active';
+        activeSchemeBadge.className = 'badge ' + (isPqc ? 'badge-pqc' : 'badge-classical');
+
+        keyIdDisplay.textContent = kr.keyId + ' (' + kr.algorithm + ')';
+        keyFingerprintDisplay.textContent = kr.fingerprintHex.slice(0, 32) + '...';
+        publicKeyExport.value = kr.pubBundleBase64;
+      }
+
+      function renderPreviewCard(signedBundle) {
+        const p = signedBundle.payload;
+        const proof = signedBundle.cryptographicProof;
+
+        if (p.documentType === 'COFFEE_ORDER_RECEIPT') {
+          previewDocTitle.textContent = 'SIGNED COFFEE ORDER RECEIPT';
+          previewDocId.textContent = p.orderId + ' • ' + p.merchant;
+          previewFieldsContainer.innerHTML =
+            '<div class="receipt-kv"><span>Customer:</span><span>' +
+            p.customerName +
+            '</span></div>' +
+            '<div class="receipt-kv"><span>Beverage:</span><span>' +
+            p.quantity +
+            'x ' +
+            p.beverage +
+            '</span></div>' +
+            '<div class="receipt-kv"><span>Add-on:</span><span>' +
+            p.addon +
+            '</span></div>' +
+            '<div class="receipt-kv"><span>Total Paid:</span><strong>$' +
+            p.totalUsd +
+            ' USD</strong></div>';
+        } else {
+          previewDocTitle.textContent = 'SIGNED DIGITAL GIFT VOUCHER';
+          previewDocId.textContent = p.voucherCode + ' • ' + p.merchant;
+          previewFieldsContainer.innerHTML =
+            '<div class="receipt-kv"><span>Recipient:</span><span>' +
+            p.recipientName +
+            ' (From: ' +
+            p.senderName +
+            ')</span></div>' +
+            '<div class="receipt-kv"><span>Voucher Value:</span><strong>$' +
+            p.amountUsd +
+            ' USD</strong></div>' +
+            '<div class="receipt-kv"><span>Valid Until:</span><span>' +
+            p.expiresOn +
+            '</span></div>' +
+            '<div class="receipt-kv"><span>Message:</span><span>' +
+            p.message +
+            '</span></div>';
+        }
+
+        previewAlg.textContent = proof.algorithm + ' (' + proof.keyId + ')';
+        previewDigest.textContent = proof.payloadSha256.slice(0, 24) + '...';
+        previewSig.textContent = proof.signature.slice(0, 36) + '...';
+      }
+
+      function renderLedger() {
+        ledgerCount.textContent = state.signedLedger.length + ' Signed';
+        signedLedgerList.innerHTML = '';
+
+        state.signedLedger.forEach((bundle, idx) => {
+          const p = bundle.payload;
+          const proof = bundle.cryptographicProof;
+          const isReceipt = p.documentType === 'COFFEE_ORDER_RECEIPT';
+          const isPqc = proof.algorithm.includes('PQC');
+
+          const item = document.createElement('div');
+          item.className = 'ledger-item';
+          item.innerHTML =
+            '<div class="ledger-item-top">' +
+            '<strong>' +
+            (isReceipt ? 'Receipt ' + p.orderId : 'Voucher ' + p.voucherCode) +
+            '</strong>' +
+            '<span class="badge ' +
+            (isPqc ? 'badge-pqc' : 'badge-classical') +
+            '">' +
+            proof.algorithm +
+            '</span>' +
+            '</div>' +
+            '<div style="font-size: 0.84rem; color: var(--muted);">' +
+            (isReceipt
+              ? p.customerName + ' — ' + p.quantity + 'x ' + p.beverage + ' ($' + p.totalUsd + ')'
+              : 'To: ' + p.recipientName + ' — Value: $' + p.amountUsd + ' USD') +
+            '</div>' +
+            '<div class="mono" style="font-size: 0.75rem; color: var(--muted);">SHA-256: ' +
+            proof.payloadSha256.slice(0, 20) +
+            '...</div>' +
+            '<div><button type="button" class="btn btn-outline btn-sm" data-ledger-idx="' +
+            idx +
+            '">Load &amp; Verify</button></div>';
+
+          item.querySelector('button').addEventListener('click', async () => {
+            state.lastValidSignedBundle = bundle;
+            verifyJsonInput.value = JSON.stringify(bundle, null, 2);
+            await runVerificationFromInputs();
+          });
+
+          signedLedgerList.appendChild(item);
+        });
+      }
+
+      async function runVerificationFromInputs() {
+        let parsed;
+        try {
+          parsed = JSON.parse(verifyJsonInput.value);
+        } catch (err) {
+          verificationResult.className = 'verification-status invalid';
+          verifierBadge.className = 'badge badge-invalid';
+          verifierBadge.textContent = 'Invalid JSON';
+          verificationHeadline.textContent = 'VERIFICATION FAILED — MALFORMED JSON';
+          verificationDetails.textContent = 'Could not parse JSON bundle: ' + err.message;
+          return;
+        }
+
+        const result = await verifySignedBundle(parsed, verifyPubkeyInput.value);
+        const isPqc = (result.algorithm || '').includes('PQC');
+
+        verificationSchemeTag.textContent = isPqc ? 'Quantum-Resistant' : 'Classical Asymmetric';
+        verificationSchemeTag.className = 'badge ' + (isPqc ? 'badge-pqc' : 'badge-classical');
+
+        if (result.valid) {
+          verificationResult.className = 'verification-status valid';
+          verifierBadge.className = 'badge badge-valid';
+          verifierBadge.textContent = 'Verified Authentic';
+          verificationHeadline.textContent = 'AUTHENTIC & INTACT — SIGNATURE VALID';
+          verificationDetails.innerHTML =
+            '<div><strong>Document Type:</strong> ' +
+            result.docType +
+            ' | <strong>Scheme:</strong> ' +
+            result.algorithm +
+            '</div>' +
+            '<div><strong>Key ID:</strong> ' +
+            result.keyId +
+            ' | <strong>Key Fingerprint:</strong> ' +
+            result.computedPubFingerprint.slice(0, 20) +
+            '...</div>' +
+            '<div><strong>Status:</strong> ' +
+            result.reason +
+            '</div>';
+        } else {
+          verificationResult.className = 'verification-status invalid';
+          verifierBadge.className = 'badge badge-invalid';
+          verifierBadge.textContent = 'Tampered / Invalid';
+          verificationHeadline.textContent = 'VERIFICATION FAILED — TAMPERED OR FORGED';
+          verificationDetails.innerHTML =
+            '<div><strong>Reason:</strong> ' +
+            result.reason +
+            '</div>' +
+            (result.recomputedSha256
+              ? '<div class="mono" style="margin-top:4px;">Computed SHA-256: ' +
+                result.recomputedSha256.slice(0, 28) +
+                '... | Signed SHA-256: ' +
+                String(result.recordedSha256 || '').slice(0, 28) +
+                '...</div>'
+              : '');
+        }
+      }
+
+      function buildReceiptPayloadFromForm() {
+        const [beverageName] = receiptItemSelect.value.split('|');
+        const [addonName] = receiptAddonSelect.value.split('|');
+        return {
+          documentType: 'COFFEE_ORDER_RECEIPT',
+          merchant: 'The Daily Grind Coffee Co.',
+          orderId: document.getElementById('receipt-order-id').value.trim(),
+          customerName: document.getElementById('receipt-customer').value.trim(),
+          beverage: beverageName,
+          quantity: parseInt(receiptQtyInput.value || '1', 10),
+          addon: addonName,
+          totalUsd: document.getElementById('receipt-total').value.trim(),
+          currency: 'USD',
+          issuedAt: new Date().toISOString()
+        };
+      }
+
+      function buildVoucherPayloadFromForm() {
+        return {
+          documentType: 'GIFT_VOUCHER',
+          merchant: 'The Daily Grind Coffee Co.',
+          voucherCode: document.getElementById('voucher-code').value.trim(),
+          amountUsd: parseFloat(document.getElementById('voucher-amount').value || '50').toFixed(2),
+          currency: 'USD',
+          recipientName: document.getElementById('voucher-recipient').value.trim(),
+          senderName: document.getElementById('voucher-sender').value.trim(),
+          expiresOn: document.getElementById('voucher-expiry').value,
+          message: document.getElementById('voucher-note').value.trim(),
+          issuedAt: new Date().toISOString()
+        };
+      }
+
+      async function issueAndSignDocument(payload) {
+        if (!state.keyRing) {
+          state.keyRing = await generateKeyRing(state.algorithm);
+          updateKeyRingUI();
+        }
+        const signedBundle = await signCanonicalPayload(payload, state.keyRing);
+        state.lastValidSignedBundle = signedBundle;
+        state.signedLedger.unshift(signedBundle);
+        if (state.signedLedger.length > 8) {
+          state.signedLedger.pop();
+        }
+
+        renderPreviewCard(signedBundle);
+        renderLedger();
+        verifyJsonInput.value = JSON.stringify(signedBundle, null, 2);
+        await runVerificationFromInputs();
+      }
+
+      // Tab switching
+      tabReceipt.addEventListener('click', () => {
+        state.activeDocType = 'COFFEE_ORDER_RECEIPT';
+        tabReceipt.classList.add('active');
+        tabReceipt.setAttribute('aria-selected', 'true');
+        tabVoucher.classList.remove('active');
+        tabVoucher.setAttribute('aria-selected', 'false');
+        receiptForm.classList.remove('hidden');
+        voucherForm.classList.add('hidden');
+      });
+
+      tabVoucher.addEventListener('click', () => {
+        state.activeDocType = 'GIFT_VOUCHER';
+        tabVoucher.classList.add('active');
+        tabVoucher.setAttribute('aria-selected', 'true');
+        tabReceipt.classList.remove('active');
+        tabReceipt.setAttribute('aria-selected', 'false');
+        voucherForm.classList.remove('hidden');
+        receiptForm.classList.add('hidden');
+      });
+
+      // Key generation & algorithm switching
+      algSelect.addEventListener('change', async () => {
+        state.algorithm = algSelect.value;
+        state.keyRing = await generateKeyRing(state.algorithm);
+        updateKeyRingUI();
+        const payload =
+          state.activeDocType === 'COFFEE_ORDER_RECEIPT'
+            ? buildReceiptPayloadFromForm()
+            : buildVoucherPayloadFromForm();
+        await issueAndSignDocument(payload);
+      });
+
+      generateKeysBtn.addEventListener('click', async () => {
+        state.algorithm = algSelect.value;
+        state.keyRing = await generateKeyRing(state.algorithm);
+        updateKeyRingUI();
+        const payload =
+          state.activeDocType === 'COFFEE_ORDER_RECEIPT'
+            ? buildReceiptPayloadFromForm()
+            : buildVoucherPayloadFromForm();
+        await issueAndSignDocument(payload);
+      });
+
+      copyPubkeyBtn.addEventListener('click', async () => {
+        if (navigator.clipboard && publicKeyExport.value) {
+          try {
+            await navigator.clipboard.writeText(publicKeyExport.value);
+            copyPubkeyBtn.textContent = 'Copied!';
+            setTimeout(() => {
+              copyPubkeyBtn.textContent = 'Copy Public Key';
+            }, 1400);
+          } catch (_) {}
+        }
+      });
+
+      // Form submissions
+      receiptForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await issueAndSignDocument(buildReceiptPayloadFromForm());
+      });
+
+      voucherForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await issueAndSignDocument(buildVoucherPayloadFromForm());
+      });
+
+      // Verifier actions
+      sendToVerifierBtn.addEventListener('click', async () => {
+        if (state.lastValidSignedBundle) {
+          verifyJsonInput.value = JSON.stringify(state.lastValidSignedBundle, null, 2);
+          await runVerificationFromInputs();
+        }
+      });
+
+      copySignedJsonBtn.addEventListener('click', async () => {
+        if (navigator.clipboard && state.lastValidSignedBundle) {
+          try {
+            await navigator.clipboard.writeText(JSON.stringify(state.lastValidSignedBundle, null, 2));
+            copySignedJsonBtn.textContent = 'Copied JSON!';
+            setTimeout(() => {
+              copySignedJsonBtn.textContent = 'Copy Signed JSON';
+            }, 1400);
+          } catch (_) {}
+        }
+      });
+
+      downloadSignedJsonBtn.addEventListener('click', () => {
+        if (!state.lastValidSignedBundle) return;
+        const blob = new Blob([JSON.stringify(state.lastValidSignedBundle, null, 2)], {
+          type: 'application/json'
+        });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        const docId =
+          state.lastValidSignedBundle.payload.orderId ||
+          state.lastValidSignedBundle.payload.voucherCode ||
+          'document';
+        a.href = url;
+        a.download = docId.toLowerCase() + '-signed.json';
+        document.body.appendChild(a);
+        a.click();
+        document.body.removeChild(a);
+        URL.revokeObjectURL(url);
+      });
+
+      verifyBtn.addEventListener('click', runVerificationFromInputs);
+      verifyJsonInput.addEventListener('input', runVerificationFromInputs);
+      verifyPubkeyInput.addEventListener('input', runVerificationFromInputs);
+
+      simulateTamperBtn.addEventListener('click', async () => {
+        try {
+          const current = JSON.parse(verifyJsonInput.value);
+          if (current && current.payload) {
+            if (current.payload.documentType === 'COFFEE_ORDER_RECEIPT') {
+              current.payload.totalUsd = '999.00';
+              current.payload.quantity = 99;
+            } else {
+              current.payload.amountUsd = '999.00';
+            }
+            verifyJsonInput.value = JSON.stringify(current, null, 2);
+            await runVerificationFromInputs();
+          }
+        } catch (_) {}
+      });
+
+      restoreValidBtn.addEventListener('click', async () => {
+        if (state.lastValidSignedBundle) {
+          verifyJsonInput.value = JSON.stringify(state.lastValidSignedBundle, null, 2);
+          verifyPubkeyInput.value = '';
+          await runVerificationFromInputs();
+        }
+      });
+
+      // Initialize on page load with both a signed Gift Voucher and a signed Coffee Order Receipt
+      async function init() {
+        recalculateReceiptTotal();
+        state.keyRing = await generateKeyRing(state.algorithm);
+        updateKeyRingUI();
+
+        // Issue an initial signed Gift Voucher and Receipt so both are immediately available in the ledger
+        const initialVoucher = buildVoucherPayloadFromForm();
+        await issueAndSignDocument(initialVoucher);
+
+        const initialReceipt = buildReceiptPayloadFromForm();
+        await issueAndSignDocument(initialReceipt);
+      }
+
+      init();
+    })();
+  </script>
 </body>
 
 </html>
