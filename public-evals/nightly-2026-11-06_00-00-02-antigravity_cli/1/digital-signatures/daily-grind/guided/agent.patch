+        if (isValid) {
+          setBanner(
+            'valid',
+            `Verified Authentic & Intact (${detectedSuite}, context "${contextName}") — Signature matches payload and signer public key.`,
+          );
+        } else {
+          setBanner(
+            'invalid',
+            `Verification Failed (${detectedSuite}, context "${contextName}") — Payload was modified, signature is invalid, or domain context did not match.`,
+          );
+        }
+      } catch (err) {
+        setBanner(
+          'invalid',
+          `Verification Error: ${err instanceof Error ? err.message : String(err)}`,
+        );
+      }
+    }
+
+    artifactTypeSelect.addEventListener('change', () => {
+      const isVoucher = artifactTypeSelect.value === 'voucher';
+      receiptFields.hidden = isVoucher;
+      voucherFields.hidden = !isVoucher;
+      metaDomainContext.textContent = DOMAIN_CONTEXTS[artifactTypeSelect.value];
+    });
+
+    suiteSelect.addEventListener('change', async () => {
+      await initKeyPair();
+      await handleSign();
+    });
+
+    rotateKeysBtn.addEventListener('click', async () => {
+      await initKeyPair();
+      await handleSign();
+    });
+
+    signForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      await handleSign();
+    });
+
+    signSampleVoucherBtn.addEventListener('click', async () => {
+      artifactTypeSelect.value = 'voucher';
+      artifactTypeSelect.dispatchEvent(new Event('change'));
+      await handleSign();
+    });
+
+    verifyForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      await handleVerify();
+    });
+
+    tamperPayloadBtn.addEventListener('click', async () => {
+      try {
+        const parsed = JSON.parse(verifyPayloadInput.value);
+        if ('totalUSD' in parsed) {
+          parsed.totalUSD = '0.01';
+        } else if ('amountUSD' in parsed) {
+          parsed.amountUSD = '999.00';
+        } else {
+          parsed.tampered = true;
+        }
+        verifyPayloadInput.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifyPayloadInput.value += '\n// tampered';
+      }
+      await handleVerify();
+    });
+
+    replayContextBtn.addEventListener('click', async () => {
+      verifyContextSelect.value =
+        verifyContextSelect.value === DOMAIN_CONTEXTS.receipt
+          ? DOMAIN_CONTEXTS.voucher
+          : DOMAIN_CONTEXTS.receipt;
+      await handleVerify();
+    });
+
+    document.querySelectorAll('.quick-order-btn').forEach((btn) => {
+      btn.addEventListener('click', async () => {
+        artifactTypeSelect.value = 'receipt';
+        artifactTypeSelect.dispatchEvent(new Event('change'));
+        document.getElementById('receipt-item').value = btn.dataset.item || 'Maple Oat Latte';
+        document.getElementById('receipt-total').value = btn.dataset.price || '6.50';
+        document.getElementById('receipt-order-id').value =
+          `DG-2026-${Math.floor(1000 + Math.random() * 9000)}`;
+        document.getElementById('crypto-portal').scrollIntoView({ behavior: 'smooth' });
+        await handleSign();
+      });
+    });
+
+    // Initialize key pair and sign initial receipt on load
+    initKeyPair().then(() => handleSign());
+  </script>
+
 </body>
 
 </html>
