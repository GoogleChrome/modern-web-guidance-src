+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterSubmit = document.getElementById('newsletter-submit');
+    const newsletterSuccess = document.getElementById('newsletter-success');
+
+    const updateAriaState = (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+
+      // Gate on the browser's interaction-aware state (:user-invalid/:user-valid)
+      // so fields that were only tabbed through are not announced as invalid.
+      if (input.matches(':user-invalid')) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Listen on the document in the capture phase for non-bubbling events
+    document.addEventListener('blur', updateAriaState, true);
+    document.addEventListener('focus', updateAriaState, true);
+    document.addEventListener('invalid', updateAriaState, true);
+
+    // Clear error state immediately when the user corrects the input
+    document.addEventListener('input', (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+
+      if (input.getAttribute('aria-invalid') === 'true') {
+        updateAriaState(event);
+      }
+    });
+
+    newsletterForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (newsletterForm.checkValidity()) {
+        newsletterSubmit.disabled = true;
+        newsletterSuccess.style.display = 'block';
+      }
+    });
+  </script>
+
 </body>
 
