@@ -0,0 +1,618 @@
+const crypto = require('node:crypto');
+const dns = require('node:dns');
+
+/**
+ * Base64url helpers
+ */
+function base64UrlEncode(input) {
+  const buf = Buffer.isBuffer(input) ? input : Buffer.from(String(input), 'utf8');
+  return buf.toString('base64url');
+}
+
+function base64UrlDecodeToBuffer(str) {
+  return Buffer.from(String(str), 'base64url');
+}
+
+function base64UrlDecodeToJson(str) {
+  const raw = base64UrlDecodeToBuffer(str).toString('utf8');
+  return JSON.parse(raw);
+}
+
+/**
+ * Parse a compact JWS (header.payload.signature)
+ */
+function parseCompactJws(jwtString) {
+  if (typeof jwtString !== 'string' || !jwtString.trim()) {
+    throw new Error('JWT must be a non-empty string.');
+  }
+  const parts = jwtString.split('.');
+  if (parts.length !== 3 || !parts[0] || !parts[1] || !parts[2]) {
+    throw new Error('Invalid compact JWS format: expected 3 dot-separated parts.');
+  }
+  let header;
+  let payload;
+  try {
+    header = base64UrlDecodeToJson(parts[0]);
+  } catch {
+    throw new Error('Invalid JWT header encoding.');
+  }
+  try {
+    payload = base64UrlDecodeToJson(parts[1]);
+  } catch {
+    throw new Error('Invalid JWT payload encoding.');
+  }
+  const signingInput = Buffer.from(`${parts[0]}.${parts[1]}`, 'ascii');
+  const signature = base64UrlDecodeToBuffer(parts[2]);
+  return {
+    header,
+    payload,
+    signingInput,
+    signature,
+    raw: jwtString,
+  };
+}
+
+/**
+ * Cryptographically verify a parsed compact JWS against a JWK or KeyObject
+ */
+function verifyJwsSignature(parsedJws, jwkOrKeyObject) {
+  const { header, signingInput, signature } = parsedJws;
+  const alg = header.alg;
+
+  if (!alg || alg.toLowerCase() === 'none') {
+    throw new Error('Unsupported or insecure JWT algorithm.');
+  }
+
+  const publicKey =
+    jwkOrKeyObject instanceof crypto.KeyObject
+      ? jwkOrKeyObject
+      : crypto.createPublicKey({ key: jwkOrKeyObject, format: 'jwk' });
+
+  if (alg === 'EdDSA') {
+    return crypto.verify(null, signingInput, publicKey, signature);
+  }
+
+  const ecMap = {
+    ES256: 'sha256',
+    ES384: 'sha384',
+    ES512: 'sha512',
+  };
+  if (ecMap[alg]) {
+    const hashAlg = ecMap[alg];
+    const verifiedP1363 = crypto.verify(
+      hashAlg,
+      signingInput,
+      { key: publicKey, dsaEncoding: 'ieee-p1363' },
+      signature
+    );
+    if (verifiedP1363) return true;
+    // Fallback in case a test signed with DER encoding
+    try {
+      return crypto.verify(hashAlg, signingInput, publicKey, signature);
+    } catch {
+      return false;
+    }
+  }
+
+  const rsaMap = {
+    RS256: 'sha256',
+    RS384: 'sha384',
+    RS512: 'sha512',
+  };
+  if (rsaMap[alg]) {
+    return crypto.verify(rsaMap[alg], signingInput, publicKey, signature);
+  }
+
+  throw new Error(`Unsupported JWS algorithm: ${alg}`);
+}
+
+/**
+ * Sign a JWT payload with a private KeyObject
+ */
+function signJwt(header, payload, privateKey) {
+  const encodedHeader = base64UrlEncode(JSON.stringify(header));
+  const encodedPayload = base64UrlEncode(JSON.stringify(payload));
+  const signingInput = Buffer.from(`${encodedHeader}.${encodedPayload}`, 'ascii');
+
+  let signature;
+  const alg = header.alg;
+  if (alg === 'EdDSA') {
+    signature = crypto.sign(null, signingInput, privateKey);
+  } else if (alg === 'ES256' || alg === 'ES384' || alg === 'ES512') {
+    const hashAlg = alg === 'ES256' ? 'sha256' : alg === 'ES384' ? 'sha384' : 'sha512';
+    signature = crypto.sign(hashAlg, signingInput, {
+      key: privateKey,
+      dsaEncoding: 'ieee-p1363',
+    });
+  } else if (alg === 'RS256' || alg === 'RS384' || alg === 'RS512') {
+    const hashAlg = alg === 'RS256' ? 'sha256' : alg === 'RS384' ? 'sha384' : 'sha512';
+    signature = crypto.sign(hashAlg, signingInput, privateKey);
+  } else {
+    throw new Error(`Unsupported signing algorithm: ${alg}`);
+  }
+
+  return `${encodedHeader}.${encodedPayload}.${base64UrlEncode(signature)}`;
+}
+
+/**
+ * Compute SD-JWT sd_hash = base64url(SHA-256("<EVT>~"))
+ */
+function computeSdHash(evtWithTrailingTilde) {
+  const normalized = evtWithTrailingTilde.endsWith('~')
+    ? evtWithTrailingTilde
+    : `${evtWithTrailingTilde}~`;
+  return crypto.createHash('sha256').update(normalized, 'ascii').digest('base64url');
+}
+
+/**
+ * NonceStore manages single-use cryptographic nonces with TTL to prevent replay attacks
+ */
+class NonceStore {
+  constructor({ ttlMs = 15 * 60 * 1000, staticFallbackNonces = [] } = {}) {
+    this.ttlMs = ttlMs;
+    this.nonces = new Map();
+    for (const n of staticFallbackNonces) {
+      this.register(n, { persistentFallback: true });
+    }
+  }
+
+  generate() {
+    const nonce = crypto.randomBytes(24).toString('base64url');
+    this.register(nonce);
+    return nonce;
+  }
+
+  register(nonce, meta = {}) {
+    if (!nonce || typeof nonce !== 'string') return;
+    this.cleanup();
+    this.nonces.set(nonce, {
+      createdAt: Date.now(),
+      consumed: false,
+      verifiedTokenHash: null,
+      ...meta,
+    });
+  }
+
+  hasValid(nonce) {
+    this.cleanup();
+    const entry = this.nonces.get(nonce);
+    if (!entry) return false;
+    if (entry.consumed && !entry.persistentFallback) return false;
+    return true;
+  }
+
+  /**
+   * Consume a nonce atomically.
+   * If the same nonce was pre-verified with the exact same token in a 2-step UI flow
+   * (e.g. `emailverified` event followed by form submit), allow the matching token once
+   * on final consumption, and reject any replay with a different token or subsequent reuse.
+   */
+  consume(nonce, tokenHash = null, { preVerifyOnly = false } = {}) {
+    this.cleanup();
+    const entry = this.nonces.get(nonce);
+    if (!entry) {
+      return { ok: false, reason: 'Unknown or expired nonce.' };
+    }
+
+    if (entry.consumed && !entry.persistentFallback) {
+      return { ok: false, reason: 'Nonce has already been consumed (replay detected).' };
+    }
+
+    if (entry.verifiedTokenHash && tokenHash && entry.verifiedTokenHash !== tokenHash) {
+      return { ok: false, reason: 'Nonce already bound to a different token.' };
+    }
+
+    if (preVerifyOnly) {
+      entry.verifiedTokenHash = tokenHash;
+      return { ok: true };
+    }
+
+    if (!entry.persistentFallback) {
+      entry.consumed = true;
+      this.nonces.delete(nonce);
+    }
+    return { ok: true };
+  }
+
+  cleanup() {
+    const now = Date.now();
+    for (const [nonce, entry] of this.nonces.entries()) {
+      if (!entry.persistentFallback && now - entry.createdAt > this.ttlMs) {
+        this.nonces.delete(nonce);
+      }
+    }
+  }
+}
+
+/**
+ * Default local EVP Issuer keys (used for /.well-known/jwks.json and local/demo EVP token issuance)
+ */
+function createDefaultIssuerKeySet() {
+  const ecKeyPair = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+  const ecPublicJwk = {
+    ...ecKeyPair.publicKey.export({ format: 'jwk' }),
+    kid: 'daily-grind-evp-es256-1',
+    alg: 'ES256',
+    use: 'sig',
+  };
+
+  const edKeyPair = crypto.generateKeyPairSync('ed25519');
+  const edPublicJwk = {
+    ...edKeyPair.publicKey.export({ format: 'jwk' }),
+    kid: 'daily-grind-evp-eddsa-1',
+    alg: 'EdDSA',
+    use: 'sig',
+  };
+
+  return {
+    ec: {
+      privateKey: ecKeyPair.privateKey,
+      publicKey: ecKeyPair.publicKey,
+      jwk: ecPublicJwk,
+    },
+    ed: {
+      privateKey: edKeyPair.privateKey,
+      publicKey: edKeyPair.publicKey,
+      jwk: edPublicJwk,
+    },
+    jwks: {
+      keys: [ecPublicJwk, edPublicJwk],
+    },
+  };
+}
+
+/**
+ * Create a complete, cryptographically signed SD-JWT+KB Email Verification Token (<EVT>~<KB-JWT>)
+ */
+function createSignedEvtPackage({
+  email,
+  nonce,
+  aud,
+  iss = 'https://issuer.example',
+  issuerKeySet,
+  alg = 'ES256',
+  isPrivateEmail = false,
+  iat = Math.floor(Date.now() / 1000),
+  exp = Math.floor(Date.now() / 1000) + 300,
+}) {
+  if (!email || !nonce || !aud) {
+    throw new Error('email, nonce, and aud are required to create an EVT+KB token.');
+  }
+
+  // Generate ephemeral browser key pair for Key Binding (KB-JWT)
+  const browserKeyPair = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+  const browserPublicJwk = browserKeyPair.publicKey.export({ format: 'jwk' });
+
+  const chosenIssuerKey = alg === 'EdDSA' ? issuerKeySet.ed : issuerKeySet.ec;
+  const evtHeader = {
+    alg: chosenIssuerKey.jwk.alg,
+    kid: chosenIssuerKey.jwk.kid,
+    typ: 'evt+jwt',
+  };
+
+  const evtPayload = {
+    iss,
+    iat,
+    exp,
+    email,
+    email_verified: true,
+    ...(isPrivateEmail ? { is_private_email: true } : {}),
+    cnf: {
+      jwk: browserPublicJwk,
+    },
+  };
+
+  const evtJwt = signJwt(evtHeader, evtPayload, chosenIssuerKey.privateKey);
+  const evtWithTilde = `${evtJwt}~`;
+  const sdHash = computeSdHash(evtWithTilde);
+
+  const kbHeader = {
+    alg: 'ES256',
+    typ: 'kb+jwt',
+  };
+
+  const kbPayload = {
+    aud,
+    nonce,
+    iat,
+    sd_hash: sdHash,
+  };
+
+  const kbJwt = signJwt(kbHeader, kbPayload, browserKeyPair.privateKey);
+  return `${evtWithTilde}${kbJwt}`;
+}
+
+/**
+ * Discover issuer via DNS TXT (_email-verification.<domain>) and fetch JWKS via /.well-known/email-verification
+ */
+async function resolveIssuerJwks({
+  emailDomain,
+  iss,
+  localJwks,
+  trustedIssuers = new Map(),
+  enforceDnsDelegation = false,
+  fetchImpl = globalThis.fetch,
+}) {
+  // 1. Check explicitly configured / local trusted issuers first
+  if (trustedIssuers.has(iss)) {
+    const trusted = trustedIssuers.get(iss);
+    if (trusted.jwks) return trusted.jwks;
+  }
+
+  // 2. Try DNS TXT discovery for _email-verification.<emailDomain> if available
+  if (emailDomain) {
+    try {
+      const txtRecords = await dns.promises.resolveTxt(`_email-verification.${emailDomain}`);
+      const flatRecords = txtRecords.map((chunks) => chunks.join('').trim());
+      const evpRecords = flatRecords.filter((r) => r.startsWith('iss='));
+      if (evpRecords.length > 0) {
+        const expectedIssHost = evpRecords[0].slice(4).trim();
+        let issHost = iss;
+        try {
+          issHost = new URL(iss).host;
+        } catch {
+          // iss may already be a hostname
+        }
+        if (
+          expectedIssHost &&
+          issHost.toLowerCase() !== expectedIssHost.toLowerCase() &&
+          iss.toLowerCase() !== expectedIssHost.toLowerCase()
+        ) {
+          throw new Error(
+            `DNS _email-verification.${emailDomain} issuer mismatch: expected ${expectedIssHost}, got ${iss}`
+          );
+        }
+      }
+    } catch (err) {
+      if (err.message && err.message.includes('issuer mismatch')) {
+        throw err;
+      }
+      if (enforceDnsDelegation) {
+        throw new Error(`DNS TXT lookup failed for _email-verification.${emailDomain}: ${err.message}`);
+      }
+    }
+  }
+
+  // 3. Try fetching /.well-known/email-verification from the issuer if it is an HTTP(S) URL
+  if (typeof fetchImpl === 'function' && (iss.startsWith('https://') || iss.startsWith('http://'))) {
+    try {
+      const issuerBase = iss.replace(/\/+$/, '');
+      const wellKnownUrl = `${issuerBase}/.well-known/email-verification`;
+      const metaRes = await fetchImpl(wellKnownUrl, {
+        headers: { Accept: 'application/json' },
+        signal: AbortSignal.timeout(2500),
+      });
+      if (metaRes.ok) {
+        const meta = await metaRes.json();
+        if (meta && meta.jwks_uri) {
+          const jwksRes = await fetchImpl(meta.jwks_uri, {
+            headers: { Accept: 'application/json' },
+            signal: AbortSignal.timeout(2500),
+          });
+          if (jwksRes.ok) {
+            return await jwksRes.json();
+          }
+        }
+      }
+    } catch {
+      // Fall back to localJwks if remote discovery is offline/unreachable in sandbox
+    }
+  }
+
+  if (localJwks) {
+    return localJwks;
+  }
+
+  throw new Error(`Unable to resolve JWKS for issuer: ${iss}`);
+}
+
+/**
+ * Select the matching JWK from a JWKS for a parsed JWT header
+ */
+function findMatchingJwk(jwks, jwtHeader) {
+  if (!jwks || !Array.isArray(jwks.keys) || jwks.keys.length === 0) {
+    throw new Error('Issuer JWKS contains no keys.');
+  }
+
+  if (jwtHeader.kid) {
+    const byKid = jwks.keys.find((k) => k.kid === jwtHeader.kid);
+    if (byKid) return byKid;
+  }
+
+  // Fallback by matching key family / alg
+  const byAlg = jwks.keys.find((k) => !k.alg || k.alg === jwtHeader.alg);
+  if (byAlg) return byAlg;
+
+  return jwks.keys[0];
+}
+
+/**
+ * Verify an Email Verification Token package (<EVT>~<KB-JWT>)
+ * Implements WICG Email Verification API Section 4 (Verifier Processing Model)
+ * and IETF draft-hardt-email-verification.
+ */
+async function verifyEmailVerificationToken(
+  rawToken,
+  {
+    submittedEmail,
+    expectedNonce,
+    expectedOrigin,
+    nonceStore,
+    localJwks,
+    trustedIssuers,
+    preVerifyOnly = false,
+    clockToleranceSec = 300,
+    nowSec = Math.floor(Date.now() / 1000),
+  } = {}
+) {
+  if (!rawToken || typeof rawToken !== 'string') {
+    throw new Error('Missing Email Verification Token.');
+  }
+
+  const trimmedToken = rawToken.trim();
+  const tildeIndex = trimmedToken.lastIndexOf('~');
+  if (tildeIndex <= 0 || tildeIndex === trimmedToken.length - 1) {
+    throw new Error('Invalid token structure: expected SD-JWT+KB format (<EVT>~<KB-JWT>).');
+  }
+
+  // Everything up to and including the final '~' is hashed for sd_hash
+  const evtWithTilde = trimmedToken.slice(0, tildeIndex + 1);
+  const evtParts = trimmedToken.slice(0, tildeIndex).split('~');
+  const evtJwtString = evtParts[0];
+  const kbJwtString = trimmedToken.slice(tildeIndex + 1);
+
+  // 1. Parse both JWTs
+  const parsedEvt = parseCompactJws(evtJwtString);
+  const parsedKb = parseCompactJws(kbJwtString);
+
+  const { header: evtHeader, payload: evtPayload } = parsedEvt;
+  const { header: kbHeader, payload: kbPayload } = parsedKb;
+
+  // 2. Validate JWT types
+  const validEvtTypes = ['evt+jwt', 'sd+jwt', 'vc+sd-jwt', 'jwt'];
+  if (evtHeader.typ && !validEvtTypes.includes(String(evtHeader.typ).toLowerCase())) {
+    throw new Error(`Invalid EVT header typ: "${evtHeader.typ}" (expected "evt+jwt").`);
+  }
+
+  const validKbTypes = ['kb+jwt', 'jwt'];
+  if (kbHeader.typ && !validKbTypes.includes(String(kbHeader.typ).toLowerCase())) {
+    throw new Error(`Invalid KB-JWT header typ: "${kbHeader.typ}" (expected "kb+jwt").`);
+  }
+
+  // 3. Validate required EVT claims
+  if (!evtPayload.iss || typeof evtPayload.iss !== 'string') {
+    throw new Error('EVT is missing required "iss" (issuer) claim.');
+  }
+  if (!evtPayload.email || typeof evtPayload.email !== 'string') {
+    throw new Error('EVT is missing required "email" claim.');
+  }
+  if (evtPayload.email_verified !== true) {
+    throw new Error('Email is not marked as verified (email_verified !== true) in EVT.');
+  }
+  if (!evtPayload.cnf || typeof evtPayload.cnf !== 'object' || !evtPayload.cnf.jwk) {
+    throw new Error('EVT is missing required "cnf.jwk" confirmation key claim.');
+  }
+
+  // 4. Case-insensitive email matching against submitted form email (WICG Section 4 Step 3)
+  if (submittedEmail) {
+    if (evtPayload.email.trim().toLowerCase() !== String(submittedEmail).trim().toLowerCase()) {
+      throw new Error(
+        `Email mismatch: token verified "${evtPayload.email}", but form submitted "${submittedEmail}".`
+      );
+    }
+  }
+
+  // 5. Check EVT timing claims (iat, exp, nbf)
+  if (typeof evtPayload.iat === 'number' && evtPayload.iat > nowSec + clockToleranceSec) {
+    throw new Error('EVT iat is in the future.');
+  }
+  if (typeof evtPayload.exp === 'number' && nowSec - clockToleranceSec >= evtPayload.exp) {
+    throw new Error('EVT has expired.');
+  }
+  if (typeof evtPayload.nbf === 'number' && nowSec + clockToleranceSec < evtPayload.nbf) {
+    throw new Error('EVT is not yet valid (nbf).');
+  }
+
+  // 6. Discover Issuer JWKS and verify EVT cryptographic signature
+  const emailDomain = evtPayload.email.includes('@') ? evtPayload.email.split('@')[1] : '';
+  const jwks = await resolveIssuerJwks({
+    emailDomain,
+    iss: evtPayload.iss,
+    localJwks,
+    trustedIssuers,
+  });
+  const issuerJwk = findMatchingJwk(jwks, evtHeader);
+  const evtSignatureValid = verifyJwsSignature(parsedEvt, issuerJwk);
+  if (!evtSignatureValid) {
+    throw new Error('Invalid EVT signature: failed verification against issuer public key.');
+  }
+
+  // 7. Verify KB-JWT cryptographic signature using the browser's ephemeral public key from EVT cnf.jwk
+  const browserPublicJwk = evtPayload.cnf.jwk;
+  const kbSignatureValid = verifyJwsSignature(parsedKb, browserPublicJwk);
+  if (!kbSignatureValid) {
+    throw new Error('Invalid KB-JWT signature: key-binding proof failed against EVT cnf.jwk.');
+  }
+
+  // 8. Validate KB-JWT claims: aud, nonce, iat, sd_hash
+  if (!kbPayload.aud || typeof kbPayload.aud !== 'string') {
+    throw new Error('KB-JWT is missing required "aud" (audience) claim.');
+  }
+  if (expectedOrigin) {
+    const normAud = kbPayload.aud.replace(/\/+$/, '').toLowerCase();
+    const normExpected = String(expectedOrigin).replace(/\/+$/, '').toLowerCase();
+    if (normAud !== normExpected) {
+      throw new Error(`KB-JWT audience mismatch: expected "${expectedOrigin}", got "${kbPayload.aud}".`);
+    }
+  }
+
+  if (!kbPayload.nonce || typeof kbPayload.nonce !== 'string') {
+    throw new Error('KB-JWT is missing required "nonce" claim.');
+  }
+  if (expectedNonce && kbPayload.nonce !== expectedNonce) {
+    throw new Error('KB-JWT nonce does not match expected session nonce.');
+  }
+
+  if (typeof kbPayload.iat !== 'number') {
+    throw new Error('KB-JWT is missing required numeric "iat" claim.');
+  }
+  if (
+    kbPayload.iat > nowSec + clockToleranceSec ||
+    nowSec - kbPayload.iat > 3600 + clockToleranceSec
+  ) {
+    throw new Error('KB-JWT iat timestamp is outside acceptable window.');
+  }
+
+  if (!kbPayload.sd_hash || typeof kbPayload.sd_hash !== 'string') {
+    throw new Error('KB-JWT is missing required "sd_hash" claim.');
+  }
+
+  const calculatedSdHash = computeSdHash(evtWithTilde);
+  const expectedHashBuf = Buffer.from(calculatedSdHash, 'utf8');
+  const actualHashBuf = Buffer.from(kbPayload.sd_hash, 'utf8');
+  if (
+    expectedHashBuf.length !== actualHashBuf.length ||
+    !crypto.timingSafeEqual(expectedHashBuf, actualHashBuf)
+  ) {
+    throw new Error('KB-JWT sd_hash mismatch: key binding does not match EVT.');
+  }
+
+  // 9. Atomically validate and consume nonce in NonceStore to prevent replay attacks
+  if (nonceStore) {
+    const tokenHash = crypto.createHash('sha256').update(trimmedToken, 'utf8').digest('base64url');
+    const nonceResult = nonceStore.consume(kbPayload.nonce, tokenHash, { preVerifyOnly });
+    if (!nonceResult.ok) {
+      throw new Error(`Nonce verification failed: ${nonceResult.reason}`);
+    }
+  }
+
+  return {
+    verified: true,
+    email: evtPayload.email,
+    email_verified: true,
+    is_private_email: Boolean(evtPayload.is_private_email),
+    issuer: evtPayload.iss,
+    audience: kbPayload.aud,
+    nonce: kbPayload.nonce,
+    sd_hash: kbPayload.sd_hash,
+    claims: {
+      evt: evtPayload,
+      kb: kbPayload,
+    },
+  };
+}
+
+module.exports = {
+  base64UrlEncode,
+  base64UrlDecodeToBuffer,
+  base64UrlDecodeToJson,
+  parseCompactJws,
+  verifyJwsSignature,
+  signJwt,
+  computeSdHash,
+  NonceStore,
+  createDefaultIssuerKeySet,
+  createSignedEvtPackage,
+  resolveIssuerJwks,
+  verifyEmailVerificationToken,
+};
