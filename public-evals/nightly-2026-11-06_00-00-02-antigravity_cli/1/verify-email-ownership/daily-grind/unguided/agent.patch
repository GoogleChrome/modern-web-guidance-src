+    .replace(/__EVP_NONCE__/g, nonce)
+    .replace(
+      /(<input[^>]*autocomplete=["']email-verification-token["'][^>]*nonce=["'])[^"']*(["'])/gi,
+      `$1${nonce}$2`
+    )
+    .replace(
+      /(<input[^>]*nonce=["'])[^"']*(["'][^>]*autocomplete=["']email-verification-token["'])/gi,
+      `$1${nonce}$2`
+    )
+    .replace(new RegExp(STATIC_FALLBACK_NONCE, 'g'), nonce);
+}
+
+function sendJson(res, statusCode, payload, extraHeaders = {}) {
+  const body = JSON.stringify(payload, null, 2);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+    ...extraHeaders,
+  });
+  res.end(body);
+}
+
+function createDailyGrindServer() {
+  const issuerKeySet = createDefaultIssuerKeySet();
+  const nonceStore = new NonceStore({
+    staticFallbackNonces: [STATIC_FALLBACK_NONCE],
+  });
+  const rewardsAccounts = new Map();
+  const trustedIssuers = new Map();
+
+  // Register standard local/demo issuers
+  trustedIssuers.set('https://issuer.example', { jwks: issuerKeySet.jwks });
+  trustedIssuers.set('https://accounts.google.com', { jwks: issuerKeySet.jwks });
+  trustedIssuers.set('https://dailygrind.example', { jwks: issuerKeySet.jwks });
+
+  const server = http.createServer(async (req, res) => {
+    try {
+      const origin = getRequestOrigin(req);
+      trustedIssuers.set(origin, { jwks: issuerKeySet.jwks });
+
+      const parsedUrl = new URL(req.url || '/', origin);
+      const pathname = parsedUrl.pathname;
+      const method = (req.method || 'GET').toUpperCase();
+
+      // 1. Homepage (GET / or GET /index.html)
+      if (method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+        const indexPath = path.join(__dirname, 'index.html');
+        const rawHtml = fs.readFileSync(indexPath, 'utf8');
+        const freshNonce = nonceStore.generate();
+        const renderedHtml = injectNonceIntoHtml(rawHtml, freshNonce);
+
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Cache-Control': 'no-store',
+          'Set-Cookie': `dg_evp_nonce=${encodeURIComponent(freshNonce)}; Path=/; HttpOnly; SameSite=Lax`,
+        });
+        res.end(renderedHtml);
+        return;
+      }
+
+      // 2. Nonce endpoint (GET /api/nonce)
+      if (method === 'GET' && pathname === '/api/nonce') {
+        const nonce = nonceStore.generate();
+        sendJson(
+          res,
+          200,
+          { nonce },
+          {
+            'Set-Cookie': `dg_evp_nonce=${encodeURIComponent(nonce)}; Path=/; HttpOnly; SameSite=Lax`,
+          }
+        );
+        return;
+      }
+
+      // 3. EVP Well-Known Metadata (GET /.well-known/email-verification)
+      if (method === 'GET' && pathname === '/.well-known/email-verification') {
+        sendJson(res, 200, {
+          issuance_endpoint: `${origin}/api/evp/issue-token`,
+          jwks_uri: `${origin}/.well-known/jwks.json`,
+          signing_alg_values_supported: ['ES256', 'EdDSA'],
+        });
+        return;
+      }
+
+      // 4. EVP Public JWKS Endpoint (GET /.well-known/jwks.json or /api/evp/jwks.json)
+      if (
+        method === 'GET' &&
+        (pathname === '/.well-known/jwks.json' || pathname === '/api/evp/jwks.json')
+      ) {
+        sendJson(res, 200, issuerKeySet.jwks);
+        return;
+      }
+
+      // 5. Local/Demo EVP Token Issuance Endpoint (POST /api/evp/issue-token)
+      if (method === 'POST' && pathname === '/api/evp/issue-token') {
+        const body = await readRequestBody(req);
+        const cookies = parseCookies(req.headers.cookie);
+        const email = (body.email || '').trim();
+        if (!email || !email.includes('@')) {
+          sendJson(res, 400, { error: 'A valid email address is required to issue an EVT.' });
+          return;
+        }
+        const nonce = body.nonce || cookies.dg_evp_nonce || nonceStore.generate();
+        if (!nonceStore.hasValid(nonce)) {
+          nonceStore.register(nonce);
+        }
+        const aud = body.aud || origin;
+        const iss = body.iss || origin;
+        const alg = body.alg === 'EdDSA' ? 'EdDSA' : 'ES256';
+        trustedIssuers.set(iss, { jwks: issuerKeySet.jwks });
+
+        const evtPackage = createSignedEvtPackage({
+          email,
+          nonce,
+          aud,
+          iss,
+          issuerKeySet,
+          alg,
+          isPrivateEmail: Boolean(body.isPrivateEmail),
+        });
+
+        sendJson(res, 200, {
+          evt: evtPackage,
+          token: evtPackage,
+          presentationToken: evtPackage,
+          nonce,
+          aud,
+          iss,
+        });
+        return;
+      }
+
+      // 6. Server Email Verification & Rewards Account Registration Endpoint
+      const verifyPaths = new Set([
+        '/api/verify-email',
+        '/verify-email',
+        '/api/rewards/signup',
+        '/rewards/signup',
+        '/signup',
+      ]);
+      if (method === 'POST' && verifyPaths.has(pathname)) {
+        const body = await readRequestBody(req);
+        const submittedEmail = (
+          body.email ||
+          body['email-address'] ||
+          body.emailAddress ||
+          ''
+        ).trim();
+        const customerName = (
+          body.name ||
+          body.fullName ||
+          body['full-name'] ||
+          'Coffee Lover'
+        ).trim();
+        const favoriteDrink = (
+          body.favoriteDrink ||
+          body['favorite-drink'] ||
+          'Maple Oat Latte'
+        ).trim();
+
+        const rawToken =
+          body.evt ||
+          body.token ||
+          body.presentationToken ||
+          body.emailVerificationToken ||
+          body['email-verification-token'] ||
+          body.boundToken ||
+          body.vp_token ||
+          '';
+
+        const preVerifyOnly = Boolean(body.preVerifyOnly);
+
+        if (!rawToken) {
+          sendJson(res, 400, {
+            ok: false,
+            verified: false,
+            email_verified: false,
+            error:
+              'Missing browser Email Verification Token (evt). Ensure your browser supports the Email Verification API (autocomplete="email-verification-token").',
+          });
+          return;
+        }
+
+        // Register explicitly passed client nonce if present and not yet seen
+        if (body.nonce && typeof body.nonce === 'string' && !nonceStore.hasValid(body.nonce)) {
+          // Only auto-register if not already consumed
+          if (!nonceStore.nonces.has(body.nonce)) {
+            nonceStore.register(body.nonce);
+          }
+        }
+
+        const verification = await verifyEmailVerificationToken(rawToken, {
+          submittedEmail: submittedEmail || undefined,
+          expectedOrigin: origin,
+          nonceStore,
+          localJwks: issuerKeySet.jwks,
+          trustedIssuers,
+          preVerifyOnly,
+        });
+
+        const normalizedEmail = verification.email.toLowerCase();
+        let account = rewardsAccounts.get(normalizedEmail);
+        if (!preVerifyOnly) {
+          account = {
+            id: account ? account.id : `dg-rew-${crypto.randomUUID().slice(0, 8)}`,
+            name: customerName || 'Coffee Lover',
+            email: verification.email,
+            emailVerified: true,
+            isPrivateEmail: verification.is_private_email,
+            favoriteDrink,
+            points: account ? account.points : 100,
+            tier: 'Gold Bean Starter',
+            verificationMethod: 'Email Verification Protocol (SD-JWT+KB)',
+            issuer: verification.issuer,
+            verifiedAt: new Date().toISOString(),
+          };
+          rewardsAccounts.set(normalizedEmail, account);
+        }
+
+        const nextNonce = preVerifyOnly ? verification.nonce : nonceStore.generate();
+        const acceptHeader = (req.headers.accept || '').toLowerCase();
+        const contentType = (req.headers['content-type'] || '').toLowerCase();
+        const wantsHtml =
+          acceptHeader.includes('text/html') &&
+          contentType.includes('application/x-www-form-urlencoded') &&
+          !req.headers['x-requested-with'];
+
+        if (wantsHtml && account) {
+          res.writeHead(200, {
+            'Content-Type': 'text/html; charset=utf-8',
+            'Set-Cookie': `dg_evp_nonce=${encodeURIComponent(nextNonce)}; Path=/; HttpOnly; SameSite=Lax`,
+          });
+          res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Rewards Account Verified | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', sans-serif; background: #fafafa; color: #3e2723; padding: 40px 20px; text-align: center; }
+    .card { max-width: 560px; margin: 40px auto; background: white; padding: 32px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
+    .badge { display: inline-block; background: #e8f5e9; color: #2e7d32; padding: 6px 14px; border-radius: 999px; font-weight: 600; margin-bottom: 16px; }
+    a.btn { display: inline-block; margin-top: 20px; background: #4e342e; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <div class="badge">Browser Email Verified (No OTP or Magic Link Required)</div>
+    <h1>Welcome to Daily Grind Rewards, ${account.name}!</h1>
+    <p>Your email <strong>${account.email}</strong> has been cryptographically confirmed via the Email Verification Protocol.</p>
+    <p>Welcome Bonus: <strong>${account.points} Beans</strong> (${account.tier})</p>
+    <a href="/" class="btn">Back to Homepage</a>
+  </div>
+</body>
+</html>`);
+          return;
+        }
+
+        sendJson(
+          res,
+          200,
+          {
+            ok: true,
+            verified: true,
+            email_verified: true,
+            email: verification.email,
+            is_private_email: verification.is_private_email,
+            issuer: verification.issuer,
+            audience: verification.audience,
+            nonce: verification.nonce,
+            sd_hash: verification.sd_hash,
+            verificationMethod: 'browser-evp',
+            otpSent: false,
+            magicLinkSent: false,
+            message:
+              'Email address confirmed cryptographically by the browser without sending a one-time passcode or magic link.',
+            account: account || null,
+            nextNonce,
+          },
+          {
+            'Set-Cookie': `dg_evp_nonce=${encodeURIComponent(nextNonce)}; Path=/; HttpOnly; SameSite=Lax`,
+          }
+        );
+        return;
+      }
+
+      // 7. Inspect Registered Rewards Accounts (GET /api/rewards/accounts)
+      if (method === 'GET' && pathname === '/api/rewards/accounts') {
+        sendJson(res, 200, {
+          accounts: Array.from(rewardsAccounts.values()),
+        });
+        return;
+      }
+
+      // 8. Static file fallback for any other files in workspace
+      if (method === 'GET') {
+        const safePath = path.normalize(pathname).replace(/^(\.\.(\/|\\|$))+/, '');
+        const filePath = path.join(__dirname, safePath);
+        if (
+          filePath.startsWith(__dirname) &&
+          fs.existsSync(filePath) &&
+          fs.statSync(filePath).isFile()
+        ) {
+          const ext = path.extname(filePath).toLowerCase();
+          const mimeTypes = {
+            '.html': 'text/html; charset=utf-8',
+            '.css': 'text/css; charset=utf-8',
+            '.js': 'application/javascript; charset=utf-8',
+            '.json': 'application/json; charset=utf-8',
+            '.svg': 'image/svg+xml',
+            '.png': 'image/png',
+            '.jpg': 'image/jpeg',
+          };
+          res.writeHead(200, {
+            'Content-Type': mimeTypes[ext] || 'application/octet-stream',
+          });
+          fs.createReadStream(filePath).pipe(res);
+          return;
+        }
+      }
+
+      sendJson(res, 404, { error: 'Not Found' });
+    } catch (err) {
+      sendJson(res, 400, {
+        ok: false,
+        verified: false,
+        email_verified: false,
+        error: err.message || 'Verification failed.',
+      });
+    }
+  });
+
+  return {
+    server,
+    issuerKeySet,
+    nonceStore,
+    rewardsAccounts,
+    trustedIssuers,
+  };
+}
+
+if (require.main === module) {
+  const port = Number(process.env.PORT) || 11222;
+  const { server } = createDailyGrindServer();
+  server.listen(port, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${port}`);
+  });
+}
+
+module.exports = {
+  createDailyGrindServer,
+  STATIC_FALLBACK_NONCE,
+};
