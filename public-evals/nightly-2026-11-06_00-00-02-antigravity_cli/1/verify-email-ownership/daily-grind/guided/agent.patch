@@ -0,0 +1,156 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import test from 'node:test';
+import { exportJWK, generateKeyPair, SignJWT } from 'jose';
+import {
+  consumeSessionNonce,
+  createFormSession,
+  handleSignupSubmission,
+  renderHomepageHtml,
+  RP_ORIGIN,
+  verifyEmailVerificationToken,
+} from './server.js';
+
+async function createMockEvpPresentation({
+  email = 'CoffeeLover@Example.com',
+  emailVerified = true,
+  iss = 'https://issuer.example.com',
+  aud = RP_ORIGIN,
+  nonce,
+  alg = 'ES256',
+  omitKid = false,
+}) {
+  const issuerKeys = await generateKeyPair(alg);
+  const holderKeys = await generateKeyPair(alg);
+
+  const issuerPublicJwk = await exportJWK(issuerKeys.publicKey);
+  issuerPublicJwk.alg = alg;
+  if (!omitKid) {
+    issuerPublicJwk.kid = 'issuer-key-1';
+  }
+
+  const holderPublicJwk = await exportJWK(holderKeys.publicKey);
+  holderPublicJwk.alg = alg;
+
+  const evtHeader = { alg, typ: 'ev+sd-jwt' };
+  if (!omitKid) {
+    evtHeader.kid = 'issuer-key-1';
+  }
+
+  const evtJwt = await new SignJWT({
+    iss,
+    email,
+    email_verified: emailVerified,
+    cnf: {
+      jwk: holderPublicJwk,
+    },
+  })
+    .setProtectedHeader(evtHeader)
+    .setIssuedAt()
+    .setExpirationTime('5m')
+    .sign(issuerKeys.privateKey);
+
+  // SD-JWT presentation with zero selective disclosures: `<EVT>~<KB-JWT>`
+  const sdJwtWithoutKb = `${evtJwt}~`;
+  const sdHash = createHash('sha256').update(sdJwtWithoutKb).digest('base64url');
+
+  const kbJwt = await new SignJWT({
+    nonce,
+    aud,
+    sd_hash: sdHash,
+  })
+    .setProtectedHeader({ alg, typ: 'kb+jwt' })
+    .setIssuedAt()
+    .sign(holderKeys.privateKey);
+
+  return {
+    rawToken: `${sdJwtWithoutKb}${kbJwt}`,
+    issuerPublicKey: issuerKeys.publicKey,
+    issuerPublicJwk,
+  };
+}
+
+test('renderHomepageHtml injects per-form nonce, csrf token, and Origin-Trial token', async () => {
+  const session = createFormSession();
+  const html = await renderHomepageHtml(session.nonce, session.csrfToken);
+
+  assert.ok(html.includes(`nonce="${session.nonce}"`));
+  assert.ok(html.includes('autocomplete="email-verification-token"'));
+  assert.ok(html.includes('autocomplete="email"'));
+  assert.ok(html.includes('autocomplete="new-password"'));
+});
+
+test('verifyEmailVerificationToken verifies valid EVT+KB-JWT with case-insensitive email match and omitted kid', async () => {
+  const session = createFormSession();
+  const nonce = await consumeSessionNonce({ headers: { cookie: session.cookieValue.split(';')[0] } });
+  assert.equal(nonce, session.nonce);
+
+  // Ensure single-use nonce was atomically deleted
+  const secondRead = await consumeSessionNonce({ headers: { cookie: session.cookieValue.split(';')[0] } });
+  assert.equal(secondRead, null);
+
+  const { rawToken, issuerPublicKey } = await createMockEvpPresentation({
+    email: 'Barista@Example.com',
+    nonce,
+    omitKid: true,
+  });
+
+  // Simulate ERR_JWKS_MULTIPLE_MATCHING_KEYS when kid is omitted
+  const fakeUnrelatedKey = (await generateKeyPair('ES256')).publicKey;
+  const mockJwks = async () => {
+    const err = new Error('Multiple matching keys in JWKS');
+    err.code = 'ERR_JWKS_MULTIPLE_MATCHING_KEYS';
+    err[Symbol.asyncIterator] = async function* () {
+      yield fakeUnrelatedKey;
+      yield issuerPublicKey;
+    };
+    throw err;
+  };
+
+  const verified = await verifyEmailVerificationToken(
+    {
+      rawToken,
+      submittedEmail: 'barista@example.com',
+      expectedNonce: nonce,
+      expectedAudience: RP_ORIGIN,
+    },
+    {
+      resolveTxt: async (host) => {
+        assert.equal(host, '_email-verification.example.com');
+        return [['iss=issuer.example.com']];
+      },
+      fetch: async (url) => {
+        assert.equal(url.toString(), 'https://issuer.example.com/.well-known/email-verification');
+        return {
+          ok: true,
+          json: async () => ({
+            issuer: 'https://issuer.example.com',
+            jwks_uri: 'https://issuer.example.com/.well-known/jwks.json',
+          }),
+        };
+      },
+      createRemoteJWKSet: () => mockJwks,
+    },
+  );
+
+  assert.equal(verified.payload.email, 'Barista@Example.com');
+  assert.equal(verified.payload.email_verified, true);
+});
+
+test('handleSignupSubmission falls back gracefully to OTP/magic-link email when token is empty or invalid', async () => {
+  const session = createFormSession();
+  const form = new Map([
+    ['email', 'guest@example.com'],
+    ['name', 'Alex Rivera'],
+    ['token', ''],
+  ]);
+
+  const result = await handleSignupSubmission({
+    headers: { cookie: session.cookieValue.split(';')[0] },
+    formData: async () => ({ get: (k) => form.get(k) }),
+  });
+
+  assert.equal(result.status, 'verification_email_sent');
+  assert.equal(result.emailVerified, false);
+  assert.equal(result.email, 'guest@example.com');
+});
