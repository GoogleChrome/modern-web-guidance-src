+
+      function clearFieldError(input, errorEl) {
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+      }
+
+      function validateEmailField() {
+        emailInput.setCustomValidity('');
+        if (emailInput.validity.valueMissing) {
+          const msg = 'Please enter your email address.';
+          emailInput.setCustomValidity(msg);
+          showFieldError(emailInput, emailError, msg);
+          return false;
+        }
+        if (emailInput.validity.typeMismatch) {
+          const msg = 'Please enter a valid email address (for example, alex@example.com).';
+          emailInput.setCustomValidity(msg);
+          showFieldError(emailInput, emailError, msg);
+          return false;
+        }
+        clearFieldError(emailInput, emailError);
+        return true;
+      }
+
+      function validatePasswordField() {
+        passwordInput.setCustomValidity('');
+        if (passwordInput.validity.valueMissing) {
+          const msg = 'Please create a password for your rewards account.';
+          passwordInput.setCustomValidity(msg);
+          showFieldError(passwordInput, passwordError, msg);
+          return false;
+        }
+        if (passwordInput.validity.tooShort || passwordInput.value.length < 8) {
+          const msg = 'Password must be at least 8 characters long.';
+          passwordInput.setCustomValidity(msg);
+          showFieldError(passwordInput, passwordError, msg);
+          return false;
+        }
+        clearFieldError(passwordInput, passwordError);
+        return true;
