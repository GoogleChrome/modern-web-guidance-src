+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { readFile } from 'node:fs/promises';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+// Replace with your public relying-party origin (configurable via RP_ORIGIN env var)
+const DEFAULT_PORT = process.env.PORT || 11222;
+export const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${DEFAULT_PORT}`;
+export const ORIGIN_TRIAL_TOKEN =
+  process.env.ORIGIN_TRIAL_TOKEN || 'A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6==';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers (e.g. Gmail) and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+export const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Server-side session state keyed by an HttpOnly, Secure, SameSite=Lax session ID cookie.
+// Never store the expected nonce value directly inside a client cookie where an attacker could
+// replay both the cookie and token.
+export const sessionStore = new Map();
+
+// In-memory store of created rewards accounts and pending email verification fallbacks
+export const rewardsAccounts = new Map();
+export const pendingOtpVerifications = new Map();
+
+/**
+ * Generate a cryptographically random 256-bit (32-byte) base64url token/nonce.
+ */
+export function generateSecureToken() {
+  return randomBytes(32).toString('base64url');
+}
+
+/**
+ * Parse the Cookie header into an object map.
+ */
+export function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  if (!cookieHeader) return cookies;
+  for (const pair of cookieHeader.split(';')) {
+    const idx = pair.indexOf('=');
+    if (idx === -1) continue;
+    const key = pair.slice(0, idx).trim();
+    const val = pair.slice(idx + 1).trim();
+    cookies[key] = decodeURIComponent(val);
+  }
+  return cookies;
+}
+
+/**
+ * Create or update a server-side session with a freshly generated per-form nonce and CSRF token.
+ */
+export function createFormSession(cookieHeader = '') {
+  const cookies = parseCookies(cookieHeader);
+  let sessionId = cookies.dg_session_id;
+  if (!sessionId || !sessionStore.has(sessionId)) {
+    sessionId = generateSecureToken();
+  }
+  const nonce = generateSecureToken();
+  const csrfToken = generateSecureToken();
+
+  sessionStore.set(sessionId, {
+    nonce,
+    csrfToken,
+    createdAt: Date.now(),
+  });
+
+  return {
+    sessionId,
+    nonce,
+    csrfToken,
+    cookieValue: `dg_session_id=${encodeURIComponent(sessionId)}; Path=/; HttpOnly; Secure; SameSite=Lax`,
+  };
+}
+
+/**
+ * Atomically read and delete the single-use nonce from server-side session state.
+ */
+export async function consumeSessionNonce(requestOrHeaders) {
+  const cookieHeader =
+    typeof requestOrHeaders?.headers?.get === 'function'
+      ? requestOrHeaders.headers.get('cookie')
+      : requestOrHeaders?.headers?.cookie || '';
+  const cookies = parseCookies(cookieHeader);
+  const sessionId = cookies.dg_session_id;
+  if (!sessionId) return null;
+
+  const session = sessionStore.get(sessionId);
+  if (!session || !session.nonce) return null;
+
+  // Atomically read and delete the expected nonce from server-side session storage immediately
+  // so an intercepted token cannot be replayed.
+  const expectedNonce = session.nonce;
+  delete session.nonce;
+  sessionStore.delete(sessionId);
+  return expectedNonce;
+}
+
+/**
+ * Verify an Email Verification Token (EVT + KB-JWT) presentation according to the
+ * Email Verification Protocol (EVP).
+ */
+export async function verifyEmailVerificationToken(
+  { rawToken, submittedEmail, expectedNonce, expectedAudience = RP_ORIGIN },
+  deps = {},
+) {
+  const resolveTxt = deps.resolveTxt || ((hostname) => dns.resolveTxt(hostname));
+  const fetchFn = deps.fetch || globalThis.fetch;
+  const createJwks = deps.createRemoteJWKSet || ((url) => createRemoteJWKSet(url));
+
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email address domain.');
+  }
+  const txtRecords = (await resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    Array.isArray(r) ? r.join('') : String(r),
+  );
+  if (!txtRecords.some((txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss)) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+  const discoveryRes = await fetchFn(discoveryUrl);
+  if (!discoveryRes.ok) {
+    throw new Error(`Failed to fetch issuer metadata: ${discoveryRes.status}`);
+  }
+  const metadata = await discoveryRes.json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  const issuerJwks = createJwks(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+export function completeAccountCreation(submittedEmail, profile = {}) {
+  const account = {
+    id: generateSecureToken(),
+    email: submittedEmail, // Preserve the submitted email string
+    name: profile.name || '',
+    emailVerified: true,
+    verificationMethod: 'email-verification-protocol',
+    points: 100, // Welcome bonus points
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(submittedEmail.toLowerCase(), account);
+  return {
+    status: 'verified',
+    emailVerified: true,
+    verificationMethod: 'evp',
+    email: submittedEmail,
+    name: account.name,
+    points: account.points,
+    message: 'Email address verified via browser! Your Daily Grind Rewards account is active with 100 bonus points.',
+  };
+}
+
+export function sendTraditionalVerificationEmail(submittedEmail, profile = {}) {
+  const otpCode = String(Math.floor(100000 + Math.random() * 900000));
+  pendingOtpVerifications.set(submittedEmail.toLowerCase(), {
+    email: submittedEmail,
+    name: profile.name || '',
+    otpCode,
+    createdAt: new Date().toISOString(),
+  });
+  return {
+    status: 'verification_email_sent',
+    emailVerified: false,
+    verificationMethod: 'email_otp_fallback',
+    email: submittedEmail,
+    name: profile.name || '',
+    message: `We sent a verification link and one-time passcode to ${submittedEmail} to finish activating your rewards account.`,
+  };
+}
+
+/**
+ * Handle sign-up submission using standard Web Fetch Request or parsed form fields.
+ */
+export async function handleSignupSubmission(request, deps = {}) {
+  const formData = await request.formData();
+  const submittedEmail = String(formData.get('email') || '').trim();
+  const submittedName = String(formData.get('name') || '').trim();
+  const rawToken = String(formData.get('token') || '').trim();
+
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = await consumeSessionNonce(request);
+  const expectedAudience = deps.expectedAudience || RP_ORIGIN;
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken(
+        {
+          rawToken,
+          submittedEmail,
+          expectedNonce,
+          expectedAudience,
+        },
+        deps,
+      );
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return completeAccountCreation(submittedEmail, { name: submittedName });
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return sendTraditionalVerificationEmail(submittedEmail, { name: submittedName });
+}
+
+/**
+ * Parse URL-encoded, JSON, or multipart/form-data HTTP request body into a Map-like FormData.
+ */
+async function parseNodeRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const rawBody = Buffer.concat(chunks).toString('utf8');
+  const contentType = req.headers['content-type'] || '';
+
+  const fields = new Map();
+  if (contentType.includes('application/json')) {
+    try {
+      const parsed = JSON.parse(rawBody || '{}');
+      for (const [k, v] of Object.entries(parsed)) {
+        fields.set(k, v);
+      }
+    } catch {}
+  } else {
+    const params = new URLSearchParams(rawBody);
+    for (const [k, v] of params.entries()) {
+      fields.set(k, v);
+    }
+  }
+  return {
+    get(key) {
+      return fields.has(key) ? fields.get(key) : null;
+    },
+  };
+}
+
+function escapeHtml(str = '') {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+/**
+ * Render index.html with a fresh per-render cryptographic nonce and CSRF token.
+ */
+export async function renderHomepageHtml(nonce, csrfToken) {
+  const indexPath = path.join(__dirname, 'index.html');
+  const template = await readFile(indexPath, 'utf8');
+  return template
+    .replaceAll('SERVER_GENERATED_PER_FORM_NONCE', escapeHtml(nonce))
+    .replaceAll('SERVER_GENERATED_CSRF_TOKEN', escapeHtml(csrfToken))
+    .replaceAll('SERVER_ORIGIN_TRIAL_TOKEN', escapeHtml(ORIGIN_TRIAL_TOKEN));
+}
+
+export function createAppServer(deps = {}) {
+  return http.createServer(async (req, res) => {
+    try {
+      const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+
+      // Serve homepage with fresh server-generated nonce, Origin-Trial, and Cache-Control: no-store
+      if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+        const session = createFormSession(req.headers.cookie);
+        const html = await renderHomepageHtml(session.nonce, session.csrfToken);
+
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Cache-Control': 'no-store',
+          'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+          'Set-Cookie': session.cookieValue,
+        });
+        res.end(html);
+        return;
+      }
+
+      // Endpoint to fetch a fresh session nonce if needed by client progressive enhancement
+      if (req.method === 'GET' && url.pathname === '/api/verify-email/session') {
+        const session = createFormSession(req.headers.cookie);
+        res.writeHead(200, {
+          'Content-Type': 'application/json; charset=utf-8',
+          'Cache-Control': 'no-store',
+          'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+          'Set-Cookie': session.cookieValue,
+        });
+        res.end(JSON.stringify({ nonce: session.nonce, csrfToken: session.csrfToken }));
+        return;
+      }
+
+      // Server verification endpoint for rewards account sign-up
+      if (
+        req.method === 'POST' &&
+        (url.pathname === '/api/verify-email' || url.pathname === '/api/rewards/signup')
+      ) {
+        const formData = await parseNodeRequestBody(req);
+        const submittedEmail = String(formData.get('email') || '').trim();
+        const submittedPassword = String(formData.get('new-password') || formData.get('password') || '');
+
+        if (!submittedEmail || !submittedEmail.includes('@') || submittedPassword.length < 8) {
+          res.writeHead(400, {
+            'Content-Type': 'application/json; charset=utf-8',
+            'Cache-Control': 'no-store',
+          });
+          res.end(
+            JSON.stringify({
+              status: 'error',
+              message: 'Please provide a valid email address and a password with at least 8 characters.',
+            }),
+          );
+          return;
+        }
+
+        const requestAdapter = {
+          headers: req.headers,
+          formData: async () => formData,
+        };
+
+        const result = await handleSignupSubmission(requestAdapter, deps);
+        const acceptsJson = (req.headers.accept || '').includes('application/json');
+
+        if (acceptsJson) {
+          res.writeHead(200, {
+            'Content-Type': 'application/json; charset=utf-8',
+            'Cache-Control': 'no-store',
+          });
+          res.end(JSON.stringify(result));
+          return;
+        }
+
+        // Standard HTML response when submitted without AJAX
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Cache-Control': 'no-store',
+        });
+        res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Rewards Sign-Up Status | The Daily Grind</title>
+</head>
+<body style="font-family: system-ui, sans-serif; max-width: 600px; margin: 4rem auto; padding: 0 1.5rem; color: #3e2723;">
+  <h1>${result.emailVerified ? 'Welcome to Daily Grind Rewards!' : 'Check Your Email'}</h1>
+  <p>${escapeHtml(result.message)}</p>
+  <p><a href="/" style="color: #4e342e; font-weight: 600;">Return to Homepage</a></p>
+</body>
+</html>`);
+        return;
+      }
+
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Not Found');
+    } catch (err) {
+      console.error('Server error:', err);
+      res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ status: 'error', message: 'Internal server error' }));
+    }
+  });
+}
+
+// Start the server only when executed directly (not when imported by tests)
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const server = createAppServer();
+  server.listen(DEFAULT_PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${DEFAULT_PORT}`);
+  });
+}
