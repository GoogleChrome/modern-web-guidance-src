+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = Math.max(
+          document.body.scrollHeight,
+          document.documentElement.scrollHeight
+        );
+
+        // If scrolled to the very bottom of the page, highlight the last section
+        if (docHeight - scrollBottom <= 10) {
+          setActiveSection(sections[sections.length - 1].id);
+          return;
+        }
+
+        // Probe line slightly below the sticky navbar
+        const probeY = navHeight + Math.min(140, viewportHeight * 0.25);
+
+        let activeSection = sections[0];
+        let bestVisibleHeight = -1;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+
+          // Direct hit: section spans across the probe line just below the sticky nav
+          if (rect.top <= probeY && rect.bottom > probeY) {
+            activeSection = section;
+            bestVisibleHeight = Infinity;
+            break;
+          }
+
+          // Otherwise, track the section with the largest visible height in the viewport
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (visibleHeight > bestVisibleHeight) {
+            bestVisibleHeight = visibleHeight;
+            activeSection = section;
+          }
+        }
+
+        // If user is above the first section (e.g., at the hero), fallback to the section closest to probeY
+        if (bestVisibleHeight <= 0) {
+          let minDistance = Infinity;
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            const distance = Math.abs(rect.top - probeY);
+            if (distance < minDistance) {
+              minDistance = distance;
+              activeSection = section;
+            }
+          }
+        }
+
+        if (activeSection && activeSection.id) {
+          setActiveSection(activeSection.id);
+        }
+      }
+
+      // Use IntersectionObserver + scroll/resize listeners for responsive, accurate updates
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveSectionOnScroll();
+          },
+          {
+            root: null,
+            rootMargin: '-15% 0px -45% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach(section => observer.observe(section));
+      }
+
+      window.addEventListener('scroll', updateActiveSectionOnScroll, { passive: true });
+      window.addEventListener('resize', updateActiveSectionOnScroll, { passive: true });
+
+      navLinks.forEach(link => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          if (targetId) {
+            setActiveSection(targetId);
+          }
+        });
+      });
+
+      // Initial check on load (respecting hash if present)
+      if (window.location.hash) {
+        const hashId = window.location.hash.slice(1);
+        if (sections.some(sec => sec.id === hashId)) {
+          setActiveSection(hashId);
+        }
+      } else {
+        updateActiveSectionOnScroll();
+      }
+    })();
+  </script>
