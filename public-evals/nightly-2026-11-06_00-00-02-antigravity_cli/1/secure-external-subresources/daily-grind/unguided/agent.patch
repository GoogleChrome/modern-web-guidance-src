+  <script>
+    /**
+     * Fetch and verify cryptographic integrity (SHA-384) of third-party images
+     * while omitting credentials (credentials: 'omit') and referrer headers (referrerPolicy: 'no-referrer').
+     */
+    (function verifyExternalResources() {
+      const images = document.querySelectorAll('img[integrity][crossorigin]');
+      images.forEach((img) => {
+        const integrityAttr = img.getAttribute('integrity');
+        if (!integrityAttr || !window.fetch) return;
+
+        fetch(img.src, {
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: img.getAttribute('referrerpolicy') || 'no-referrer',
+          integrity: integrityAttr
+        }).catch(() => {
+          // If cryptographic integrity check fails, prevent rendering untrusted image
+          img.removeAttribute('src');
+        });
+      });
+
+      document.addEventListener('DOMContentLoaded', () => {
+        if (window.dayjs) {
+          const yearEl = document.getElementById('current-year');
+          if (yearEl) yearEl.textContent = window.dayjs().format('YYYY');
+        }
+        if (window.lucide && typeof window.lucide.createIcons === 'function') {
+          window.lucide.createIcons();
+        }
+      });
+    })();
+  </script>
