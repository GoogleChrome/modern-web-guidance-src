+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopia Yirgacheffe', acidity: 88, body: 62, sweetness: 84, bitterness: 30, aroma: 92 },
+      { name: 'Colombia Huila', acidity: 76, body: 78, sweetness: 86, bitterness: 42, aroma: 84 },
+      { name: 'Sumatra Mandheling', acidity: 48, body: 94, sweetness: 68, bitterness: 66, aroma: 80 },
+      { name: 'Guatemala Antigua', acidity: 72, body: 82, sweetness: 79, bitterness: 50, aroma: 86 },
+      { name: 'Brazil Cerrado', acidity: 54, body: 86, sweetness: 82, bitterness: 58, aroma: 76 },
+      { name: 'Kenya AA', acidity: 92, body: 70, sweetness: 80, bitterness: 36, aroma: 90 }
+    ];
+
+    const ROAST_MODIFIERS = {
+      light: { acidity: 1.15, body: 0.9, sweetness: 1.05, bitterness: 0.75, aroma: 1.12 },
+      medium: { acidity: 1.0, body: 1.05, sweetness: 1.12, bitterness: 0.95, aroma: 1.05 },
+      dark: { acidity: 0.75, body: 1.2, sweetness: 0.92, bitterness: 1.25, aroma: 0.95 }
+    };
+
+    const BREW_MODIFIERS = {
+      espresso: { acidity: 1.05, body: 1.22, sweetness: 1.08, bitterness: 1.1, aroma: 1.15 },
+      pourover: { acidity: 1.14, body: 0.88, sweetness: 1.1, bitterness: 0.82, aroma: 1.18 },
+      frenchpress: { acidity: 0.9, body: 1.18, sweetness: 1.0, bitterness: 1.05, aroma: 1.02 },
+      coldbrew: { acidity: 0.68, body: 1.1, sweetness: 1.16, bitterness: 0.72, aroma: 0.94 }
+    };
+
+    const batchSizeInput = document.getElementById('batch-size');
+    const batchSizeLabel = document.getElementById('batch-size-label');
+    const roastLevelSelect = document.getElementById('roast-level');
+    const brewMethodSelect = document.getElementById('brew-method');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const statusText = document.getElementById('simulation-status');
+    const progressText = document.getElementById('simulation-progress-text');
+    const progressBar = document.getElementById('simulation-progress');
+    const metricProcessed = document.getElementById('metric-processed');
+    const metricYields = document.getElementById('metric-yields');
+    const metricTopScore = document.getElementById('metric-top-score');
+    const resultsContainer = document.getElementById('blend-results');
+
+    batchSizeInput.addEventListener('input', () => {
+      batchSizeLabel.textContent = Number(batchSizeInput.value).toLocaleString();
+    });
+
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        return await window.scheduler.yield();
+      }
+      return new Promise(resolve => setTimeout(resolve, 0));
+    }
+
+    function generateRecipeBatch(count, roast, brew) {
+      const items = [];
+      for (let i = 0; i < count; i++) {
+        const primary = ORIGINS[i % ORIGINS.length];
+        const secondary = ORIGINS[(i * 3 + 1) % ORIGINS.length];
+        const tertiary = ORIGINS[(i * 5 + 2) % ORIGINS.length];
+        const ratioPrimary = 40 + ((i * 7) % 35);
+        const ratioSecondary = 15 + ((i * 11) % (90 - ratioPrimary - 10));
+        const ratioTertiary = 100 - ratioPrimary - ratioSecondary;
+        const waterTempC = 88 + (i % 9);
+        const grindMicrons = 250 + ((i * 19) % 750);
+
+        items.push({
+          id: i + 1,
+          name: `Blend #${i + 1}: ${primary.name.split(' ')[0]} / ${secondary.name.split(' ')[0]}`,
+          composition: `${ratioPrimary}% ${primary.name}, ${ratioSecondary}% ${secondary.name}, ${ratioTertiary}% ${tertiary.name}`,
+          origins: [
+            { bean: primary, weight: ratioPrimary / 100 },
+            { bean: secondary, weight: ratioSecondary / 100 },
+            { bean: tertiary, weight: ratioTertiary / 100 }
+          ],
+          roast,
+          brew,
+          waterTempC,
+          grindMicrons
+        });
+      }
+      return items;
+    }
+
+    function simulateSingleBlend(item) {
+      const roastMod = ROAST_MODIFIERS[item.roast] || ROAST_MODIFIERS.medium;
+      const brewMod = BREW_MODIFIERS[item.brew] || BREW_MODIFIERS.espresso;
+
+      let acidity = 0;
+      let body = 0;
+      let sweetness = 0;
+      let bitterness = 0;
+      let aroma = 0;
+
+      for (const part of item.origins) {
+        acidity += part.bean.acidity * part.weight;
+        body += part.bean.body * part.weight;
+        sweetness += part.bean.sweetness * part.weight;
+        bitterness += part.bean.bitterness * part.weight;
+        aroma += part.bean.aroma * part.weight;
+      }
+
+      // Multi-step thermodynamic extraction curve simulation
+      let extractionYield = 0.18;
+      for (let step = 1; step <= 400; step++) {
+        const tempFactor = Math.sin((item.waterTempC + step * 0.05) * 0.0314);
+        const surfaceFactor = Math.cos((item.grindMicrons - step * 0.12) * 0.0042);
+        extractionYield += (tempFactor * surfaceFactor) * 0.00015;
+      }
+
+      const clamp = val => Math.min(100, Math.max(10, Math.round(val)));
+      const profile = {
+        acidity: clamp(acidity * roastMod.acidity * brewMod.acidity * (1 + extractionYield * 0.08)),
+        body: clamp(body * roastMod.body * brewMod.body * (1 + extractionYield * 0.1)),
+        sweetness: clamp(sweetness * roastMod.sweetness * brewMod.sweetness * (1 - Math.abs(0.2 - extractionYield) * 0.25)),
+        bitterness: clamp(bitterness * roastMod.bitterness * brewMod.bitterness * (1 + Math.max(0, extractionYield - 0.21) * 0.4)),
+        aroma: clamp(aroma * roastMod.aroma * brewMod.aroma)
+      };
+
+      const harmonyPenalty = Math.max(0, profile.bitterness - profile.sweetness) * 0.22;
+      const rawScore =
+        profile.sweetness * 0.28 +
+        profile.aroma * 0.24 +
+        profile.body * 0.22 +
+        profile.acidity * 0.20 -
+        harmonyPenalty +
+        6;
+      const cuppingScore = Math.min(99.4, Math.max(70.0, Number(rawScore.toFixed(1))));
+
+      return {
+        ...item,
+        profile,
+        cuppingScore
+      };
+    }
+
+    function renderTopBlends(blends) {
+      resultsContainer.innerHTML = blends.map(blend => `
+        <article class="blend-card">
+          <h4>
+            <span>${blend.name}</span>
+            <span class="score-badge">${blend.cuppingScore} pts</span>
+          </h4>
+          <p style="font-size: 0.8rem; color: #5d4037; margin-bottom: 6px;">${blend.composition}</p>
+          <p style="font-size: 0.76rem; color: #795548;">Brew: ${blend.waterTempC}&deg;C &bull; Grind: ${blend.grindMicrons}&mu;m</p>
+          <div class="flavor-bars">
+            ${['sweetness', 'aroma', 'body', 'acidity', 'bitterness'].map(attr => `
+              <div class="flavor-bar-row">
+                <span style="text-transform: capitalize;">${attr}</span>
+                <div class="bar-track">
+                  <div class="bar-fill" style="width: ${blend.profile[attr]}%;"></div>
+                </div>
+                <span>${blend.profile[attr]}%</span>
+              </div>
+            `).join('')}
+          </div>
+        </article>
+      `).join('');
+    }
+
+    async function processRecipeBatch(items) {
+      let deadline = performance.now() + 50;
+      let processedCount = 0;
+      let yieldCount = 0;
+      const results = [];
+
+      for (const item of items) {
+        results.push(simulateSingleBlend(item));
+        processedCount++;
+
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          const pct = Math.round((processedCount / items.length) * 100);
+          progressBar.value = pct;
+          progressText.textContent = `${pct}%`;
+          metricProcessed.textContent = processedCount.toLocaleString();
+          metricYields.textContent = yieldCount.toLocaleString();
+          statusText.textContent = `Simulating flavor extraction curves (${processedCount.toLocaleString()} / ${items.length.toLocaleString()})...`;
+
+          await yieldToMain();
+          deadline = performance.now() + 50;
+        }
+      }
+
+      results.sort((a, b) => b.cuppingScore - a.cuppingScore);
+      const topBlends = results.slice(0, 6);
+
+      progressBar.value = 100;
+      progressText.textContent = '100%';
+      metricProcessed.textContent = processedCount.toLocaleString();
+      metricYields.textContent = yieldCount.toLocaleString();
+      metricTopScore.textContent = topBlends.length ? `${topBlends[0].cuppingScore} pts` : '--';
+      statusText.textContent = `Completed ${processedCount.toLocaleString()} recipe simulations across ${yieldCount} main-thread yields.`;
+
+      renderTopBlends(topBlends);
+    }
+
+    runBtn.addEventListener('click', async () => {
+      const count = Number(batchSizeInput.value) || 2500;
+      const roast = roastLevelSelect.value;
+      const brew = brewMethodSelect.value;
+
+      runBtn.disabled = true;
+      statusText.textContent = 'Preparing batch recipes...';
+      progressBar.value = 0;
+      progressText.textContent = '0%';
+
+      try {
+        const batch = generateRecipeBatch(count, roast, brew);
+        await processRecipeBatch(batch);
+      } finally {
+        runBtn.disabled = false;
+      }
+    });
+
+    // Run an initial simulation batch automatically so results are visible immediately
+    runBtn.click();
+  </script>
 </body>
 
