+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return new Promise(function (resolve) {
+          setTimeout(resolve, 0);
+        });
+      }
+
+      // Check if user input is pending or time slice budget has elapsed
+      function shouldYieldToMain(sliceStartTime, budgetMs) {
+        const elapsed = performance.now() - sliceStartTime;
+        if (elapsed >= budgetMs) {
+          return true;
+        }
+        if (
+          typeof navigator !== 'undefined' &&
+          navigator.scheduling &&
+          typeof navigator.scheduling.isInputPending === 'function' &&
+          elapsed >= 4 &&
+          navigator.scheduling.isInputPending()
+        ) {
+          return true;
+        }
+        return false;
+      }
+
+      // Expose helpers on window for programmatic inspection/testing
+      window.yieldToMain = yieldToMain;
+      window.shouldYieldToMain = shouldYieldToMain;
+
+      // DOM elements
+      const targetProfileSelect = document.getElementById('target-profile-select');
+      const roastTempRange = document.getElementById('roast-temp-range');
+      const roastTempDisplay = document.getElementById('roast-temp-display');
+      const brewMethodSelect = document.getElementById('brew-method-select');
+      const batchSizeSelect = document.getElementById('batch-size-select');
+      const chunkBudgetSelect = document.getElementById('chunk-budget-select');
+      const blendFilterInput = document.getElementById('blend-filter-input');
+      const runBtn = document.getElementById('run-simulation-btn');
+      const cancelBtn = document.getElementById('cancel-simulation-btn');
+      const sampleTastingBtn = document.getElementById('sample-tasting-btn');
+      const cuppingClickCountEl = document.getElementById('cupping-click-count');
+      const schedulerApiLabel = document.getElementById('scheduler-api-label');
+      const threadHealthBadge = document.getElementById('thread-health-badge');
+      const frameLatencyVal = document.getElementById('frame-latency-val');
+      const simulationStatusText = document.getElementById('simulation-status-text');
+      const progressLabel = document.getElementById('progress-label');
+      const progressPercent = document.getElementById('progress-percent');
+      const progressBar = document.getElementById('simulation-progressbar');
+      const progressFill = document.getElementById('progress-fill');
+      const metricProcessed = document.getElementById('metric-processed');
+      const metricYields = document.getElementById('metric-yields');
+      const metricSliceDuration = document.getElementById('metric-slice-duration');
+      const metricLongTasks = document.getElementById('metric-long-tasks');
+      const metricBestScore = document.getElementById('metric-best-score');
+      const extractionYieldBadge = document.getElementById('extraction-yield-badge');
+      const dominantNotesContainer = document.getElementById('dominant-notes-container');
+      const topBlendsList = document.getElementById('top-blends-list');
+      const matchedCountLabel = document.getElementById('matched-count-label');
+
+      // Detect scheduler support
+      const hasSchedulerYield =
+        typeof globalThis.scheduler !== 'undefined' &&
+        typeof globalThis.scheduler.yield === 'function';
+      schedulerApiLabel.textContent = hasSchedulerYield
+        ? 'scheduler.yield() Active'
+        : 'Time-Sliced Yielding (setTimeout)';
+
+      // Track Long Tasks via PerformanceObserver if supported
+      let observedLongTasks = 0;
+      if (typeof PerformanceObserver !== 'undefined') {
+        try {
+          const observer = new PerformanceObserver(function (list) {
+            const entries = list.getEntries();
+            observedLongTasks += entries.length;
+            if (metricLongTasks) {
+              metricLongTasks.textContent = String(observedLongTasks);
+            }
+          });
+          observer.observe({ entryTypes: ['longtask'] });
+        } catch (e) {
+          // Ignore if longtask entryType is unsupported in environment
+        }
+      }
+
+      // Live frame latency monitor
+      let lastFrameTime = performance.now();
+      function trackFrameLatency(now) {
+        const delta = now - lastFrameTime;
+        lastFrameTime = now;
+        if (delta > 0 && delta < 250) {
+          frameLatencyVal.textContent = delta.toFixed(1) + ' ms';
+        }
+        requestAnimationFrame(trackFrameLatency);
+      }
+      requestAnimationFrame(trackFrameLatency);
+
+      function formatRoastLabel(tempC) {
+        if (tempC < 200) return tempC + '°C (Light Cinnamon)';
+        if (tempC < 207) return tempC + '°C (City Light-Med)';
+        if (tempC < 214) return tempC + '°C (Full City Medium)';
+        if (tempC < 221) return tempC + '°C (Vienna Med-Dark)';
+        return tempC + '°C (French Dark)';
+      }
+
+      roastTempRange.addEventListener('input', function () {
+        roastTempDisplay.textContent = formatRoastLabel(Number(roastTempRange.value));
+      });
+
+      let cuppingClicks = 0;
+      sampleTastingBtn.addEventListener('click', function () {
+        cuppingClicks += 1;
+        cuppingClickCountEl.textContent = String(cuppingClicks);
+      });
+
+      // Deterministic pseudo-random generator for reproducible recipe blend synthesis
+      function createSeededRng(seed) {
+        let state = seed >>> 0;
+        return function () {
+          state = (1664525 * state + 1013904223) >>> 0;
+          return state / 4294967296;
+        };
+      }
+
+      // Simulate a single recipe blend with non-trivial thermodynamic Maillard & extraction kinetics
+      function simulateSingleRecipeBlend(index, config, rng) {
+        // Pick 3 distinct origins for the tri-origin artisanal blend
+        const idxA = index % ORIGINS.length;
+        const idxB = (index * 3 + 1 + Math.floor(rng() * 5)) % ORIGINS.length;
+        const idxC = (index * 5 + 2 + Math.floor(rng() * 5)) % ORIGINS.length;
+
+        const originA = ORIGINS[idxA];
+        const originB = ORIGINS[idxB === idxA ? (idxA + 1) % ORIGINS.length : idxB];
+        const originC = ORIGINS[
+          idxC === idxA || idxC === idxB ? (idxA + 2) % ORIGINS.length : idxC
+        ];
+
+        // Generate normalized blend ratios (in 5% increments)
+        const rawW1 = 0.25 + rng() * 0.55;
+        const rawW2 = (1 - rawW1) * (0.35 + rng() * 0.45);
+        const pctA = Math.max(10, Math.min(80, Math.round((rawW1 * 100) / 5) * 5));
+        const pctB = Math.max(10, Math.min(100 - pctA - 5, Math.round((rawW2 * 100) / 5) * 5));
+        const pctC = Math.max(5, 100 - pctA - pctB);
+
+        const wA = pctA / 100;
+        const wB = pctB / 100;
+        const wC = pctC / 100;
+
+        // Multi-step Maillard & caramelization thermal simulation over 45 roast time-steps
+        const roastTemp = config.roastTemp + (rng() - 0.5) * 5;
+        const normTemp = (roastTemp - 192) / 36; // 0.0 (light) to 1.0 (dark)
+        let maillardAccum = 0;
+        let caramelAccum = 0;
+        let organicAcidRetention = 1.0;
+        let pyrolysisBitterness = 0;
+
+        const avgDensity = originA.density * wA + originB.density * wB + originC.density * wC;
+        for (let step = 0; step < 45; step++) {
+          const progress = step / 44;
+          const drumTemp = 155 + (roastTemp - 155) * Math.pow(progress, 0.72);
+          const rateMaillard = Math.exp(-28 / (drumTemp * 0.015)) * avgDensity;
+          const rateCaramel = drumTemp > 185 ? Math.pow((drumTemp - 185) / 45, 1.35) : 0;
+          maillardAccum += rateMaillard * 0.045;
+          caramelAccum += rateCaramel * 0.05;
+          organicAcidRetention *= 1 - 0.0065 * normTemp * progress;
+          if (drumTemp > 210) {
+            pyrolysisBitterness += Math.pow((drumTemp - 210) / 22, 1.5) * 1.4;
+          }
+        }
+
+        const brewMod = BREW_MODIFIERS[config.brewMethod] || BREW_MODIFIERS.pourover;
+
+        // Weighted origin baselines
+        const baseAcidity = originA.acidity * wA + originB.acidity * wB + originC.acidity * wC;
+        const baseSweetness = originA.sweetness * wA + originB.sweetness * wB + originC.sweetness * wC;
+        const baseBody = originA.body * wA + originB.body * wB + originC.body * wC;
+        const baseAroma = originA.aroma * wA + originB.aroma * wB + originC.aroma * wC;
+        const baseFinish = originA.finish * wA + originB.finish * wB + originC.finish * wC;
+        const baseBitterness = originA.bitterness * wA + originB.bitterness * wB + originC.bitterness * wC;
+
+        // Apply thermal kinetics & brew extraction modifiers
+        const acidity = clampScore(
+          baseAcidity * organicAcidRetention * brewMod.acidity * (1.06 - normTemp * 0.22)
+        );
+        const sweetness = clampScore(
+          (baseSweetness * 0.85 + caramelAccum * 18) *
+            brewMod.sweetness *
+            (1 - Math.abs(normTemp - 0.48) * 0.22)
+        );
+        const body = clampScore(
+          (baseBody * 0.88 + maillardAccum * 9 + normTemp * 12) * brewMod.body
+        );
+        const aroma = clampScore(
+          (baseAroma * 0.9 + maillardAccum * 11) *
+            brewMod.aroma *
+            (1 - Math.max(0, normTemp - 0.72) * 0.3)
+        );
+        const finish = clampScore(
+          (baseFinish * 0.9 + caramelAccum * 10 - pyrolysisBitterness * 0.8) * brewMod.finish
+        );
+        const bitterness = clampScore(
+          (baseBitterness * 0.8 + normTemp * 26 + pyrolysisBitterness * 3.5) * brewMod.bitterness
+        );
+
+        const extractionYield = Number(
+          (
+            brewMod.baseYield +
+            (sweetness - 80) * 0.03 +
+            (normTemp - 0.45) * 0.8 +
+            (rng() - 0.5) * 0.6
+          ).toFixed(1)
+        );
+
+        // Compute sensory distance to target profile
+        const target = TARGET_PROFILES[config.targetProfile] || TARGET_PROFILES.balanced;
+        const diffSq =
+          Math.pow(acidity - target.acidity, 2) * 1.1 +
+          Math.pow(sweetness - target.sweetness, 2) * 1.25 +
+          Math.pow(body - target.body, 2) * 1.1 +
+          Math.pow(aroma - target.aroma, 2) * 1.0 +
+          Math.pow(finish - target.finish, 2) * 0.95 +
+          Math.pow(bitterness - target.bitterness, 2) * 1.15;
+
+        const rmsError = Math.sqrt(diffSq / 6.55);
+        const matchScore = Number(Math.max(40, Math.min(99.8, 100 - rmsError * 1.35)).toFixed(1));
+
+        // Assemble tasting notes
+        const note1 = originA.notes[index % originA.notes.length];
+        const note2 = originB.notes[(index + 1) % originB.notes.length];
+        const note3 = originC.notes[(index + 2) % originC.notes.length];
+        const notes = Array.from(new Set([note1, note2, note3]));
+
+        return {
+          id: 'BLD-' + String(index + 1).padStart(4, '0'),
+          name:
+            'Lot #' +
+            String(index + 101) +
+            ' ' +
+            originA.name.split(' ')[0] +
+            '-' +
+            originB.name.split(' ')[0] +
+            ' Reserve',
+          composition:
+            pctA +
+            '% ' +
+            originA.name +
+            ' · ' +
+            pctB +
+            '% ' +
+            originB.name +
+            ' · ' +
+            pctC +
+            '% ' +
+            originC.name,
+          roastTemp: Math.round(roastTemp),
+          extractionYield: extractionYield,
+          matchScore: matchScore,
+          scores: {
+            acidity: Math.round(acidity),
+            sweetness: Math.round(sweetness),
+            body: Math.round(body),
+            aroma: Math.round(aroma),
+            finish: Math.round(finish),
+            bitterness: Math.round(bitterness)
+          },
+          notes: notes
+        };
+      }
+
+      function clampScore(val) {
+        return Math.max(10, Math.min(99, val));
+      }
+
+      // State for current simulation and results
+      let activeRunId = 0;
+      let latestSimulatedBlends = [];
+
+      function renderSimulationResults(blends, filterQuery) {
+        if (!blends || blends.length === 0) return;
+
+        const query = (filterQuery || '').trim().toLowerCase();
+        const filtered = query
+          ? blends.filter(function (b) {
+              return (
+                b.name.toLowerCase().includes(query) ||
+                b.composition.toLowerCase().includes(query) ||
+                b.notes.some(function (n) {
+                  return n.toLowerCase().includes(query);
+                })
+              );
+            })
+          : blends;
+
+        const topMatches = filtered.slice(0, 8);
+        matchedCountLabel.textContent = query
+          ? 'Showing ' + topMatches.length + ' of ' + filtered.length + ' filtered blends'
+          : 'Showing top ' + topMatches.length + ' of ' + blends.length.toLocaleString() + ' blends';
+
+        // Update top blends list DOM
+        topBlendsList.innerHTML = '';
+        if (topMatches.length === 0) {
+          const emptyEl = document.createElement('div');
+          emptyEl.className = 'blend-item';
+          emptyEl.textContent = 'No recipe blends match "' + filterQuery + '". Try clearing the filter.';
+          topBlendsList.appendChild(emptyEl);
+        } else {
+          const fragment = document.createDocumentFragment();
+          for (let i = 0; i < topMatches.length; i++) {
+            const item = topMatches[i];
+            const card = document.createElement('div');
+            card.className = 'blend-item';
+            card.innerHTML =
+              '<div class="blend-item-header">' +
+              '<span class="blend-name">' +
+              item.name +
+              '</span>' +
+              '<span class="blend-score">' +
+              item.matchScore.toFixed(1) +
+              '% Match</span>' +
+              '</div>' +
+              '<div class="blend-meta">' +
+              item.composition +
+              '</div>' +
+              '<div class="blend-mini-metrics">' +
+              '<span>Roast: ' +
+              item.roastTemp +
+              '°C</span>' +
+              '<span>Yield: ' +
+              item.extractionYield +
+              '%</span>' +
+              '<span>Acidity: ' +
+              item.scores.acidity +
+              '</span>' +
+              '<span>Sweetness: ' +
+              item.scores.sweetness +
+              '</span>' +
+              '<span>Body: ' +
+              item.scores.body +
+              '</span>' +
+              '<span>Notes: ' +
+              item.notes.join(', ') +
+              '</span>' +
+              '</div>';
+            fragment.appendChild(card);
+          }
+          topBlendsList.appendChild(fragment);
+        }
+
+        // Compute aggregate profile across top 25 blends
+        const samplePool = (filtered.length > 0 ? filtered : blends).slice(0, 25);
+        const totals = {
+          acidity: 0,
+          sweetness: 0,
+          body: 0,
+          aroma: 0,
+          finish: 0,
+          bitterness: 0,
+          yield: 0
+        };
+        const noteFreq = {};
+
+        for (let i = 0; i < samplePool.length; i++) {
+          const b = samplePool[i];
+          totals.acidity += b.scores.acidity;
+          totals.sweetness += b.scores.sweetness;
+          totals.body += b.scores.body;
+          totals.aroma += b.scores.aroma;
+          totals.finish += b.scores.finish;
+          totals.bitterness += b.scores.bitterness;
+          totals.yield += b.extractionYield;
+          for (let j = 0; j < b.notes.length; j++) {
+            const note = b.notes[j];
+            noteFreq[note] = (noteFreq[note] || 0) + 1;
+          }
+        }
+
+        const count = samplePool.length;
+        const avg = {
+          acidity: Math.round(totals.acidity / count),
+          sweetness: Math.round(totals.sweetness / count),
+          body: Math.round(totals.body / count),
+          aroma: Math.round(totals.aroma / count),
+          finish: Math.round(totals.finish / count),
+          bitterness: Math.round(totals.bitterness / count),
+          yield: (totals.yield / count).toFixed(1)
+        };
+
+        updateBar('acidity', avg.acidity);
+        updateBar('sweetness', avg.sweetness);
+        updateBar('body', avg.body);
+        updateBar('aroma', avg.aroma);
+        updateBar('finish', avg.finish);
+        updateBar('bitterness', avg.bitterness);
+        extractionYieldBadge.textContent = 'Extraction Yield: ' + avg.yield + '%';
+
+        const topNotes = Object.keys(noteFreq)
+          .sort(function (a, b) {
+            return noteFreq[b] - noteFreq[a];
+          })
+          .slice(0, 5);
+
+        dominantNotesContainer.innerHTML = '';
+        for (let i = 0; i < topNotes.length; i++) {
+          const span = document.createElement('span');
+          span.className = 'note-tag';
+          span.textContent = topNotes[i];
+          dominantNotesContainer.appendChild(span);
+        }
+      }
+
+      function updateBar(key, val) {
+        const valEl = document.getElementById('val-' + key);
+        const barEl = document.getElementById('bar-' + key);
+        if (valEl) valEl.textContent = val + ' / 100';
+        if (barEl) barEl.style.width = val + '%';
+      }
+
+      // Main chunked batch processor that breaks up long tasks and yields to the main thread
+      async function runFlavorSimulation(customOptions) {
+        activeRunId += 1;
+        const currentRunId = activeRunId;
+
+        const config = Object.assign(
+          {
+            targetProfile: targetProfileSelect.value,
+            roastTemp: Number(roastTempRange.value),
+            brewMethod: brewMethodSelect.value,
+            batchSize: Number(batchSizeSelect.value),
+            chunkBudgetMs: Number(chunkBudgetSelect.value)
+          },
+          customOptions || {}
+        );
+
+        const totalBlends = Math.max(1, config.batchSize);
+        const timeBudgetMs = Math.max(4, Math.min(25, config.chunkBudgetMs));
+        const maxItemsPerSlice = 60; // Hard cap per slice in addition to time budget
+
+        cancelBtn.disabled = false;
+        simulationStatusText.textContent = 'Simulating blends (yielding to main thread)...';
+        threadHealthBadge.textContent = 'Main Thread: Yielding (' + timeBudgetMs + 'ms budget)';
+
+        const rng = createSeededRng(
+          config.roastTemp * 131 +
+            totalBlends * 17 +
+            config.targetProfile.charCodeAt(0) * 31 +
+            config.brewMethod.charCodeAt(0) * 19
+        );
+
+        const results = [];
+        let processed = 0;
+        let yieldCount = 0;
+        let totalSliceTimeMs = 0;
+        let sliceCount = 0;
+        let maxSliceMs = 0;
+        let bestMatch = 0;
+
+        let sliceStart = performance.now();
+        let itemsInCurrentSlice = 0;
+
+        while (processed < totalBlends) {
+          if (currentRunId !== activeRunId) {
+            return null; // Aborted or superseded by a newer run
+          }
+
+          const blend = simulateSingleRecipeBlend(processed, config, rng);
+          results.push(blend);
+          if (blend.matchScore > bestMatch) {
+            bestMatch = blend.matchScore;
+          }
+
+          processed += 1;
+          itemsInCurrentSlice += 1;
+
+          const needYield =
+            processed < totalBlends &&
+            (itemsInCurrentSlice >= maxItemsPerSlice ||
+              shouldYieldToMain(sliceStart, timeBudgetMs));
+
+          if (needYield || processed === totalBlends) {
+            const sliceDuration = performance.now() - sliceStart;
+            totalSliceTimeMs += sliceDuration;
+            sliceCount += 1;
+            if (sliceDuration > maxSliceMs) {
+              maxSliceMs = sliceDuration;
+            }
+
+            const pct = Math.round((processed / totalBlends) * 100);
+            progressLabel.textContent =
+              processed < totalBlends
+                ? 'Simulating Recipe Batch (' +
+                  processed.toLocaleString() +
+                  ' / ' +
+                  totalBlends.toLocaleString() +
+                  ' blends)...'
+                : 'Batch Complete (' + totalBlends.toLocaleString() + ' blends simulated)';
+            progressPercent.textContent = pct + '%';
+            progressBar.setAttribute('aria-valuenow', String(pct));
+            progressFill.style.width = pct + '%';
+
+            metricProcessed.textContent =
+              processed.toLocaleString() + ' / ' + totalBlends.toLocaleString();
+            metricYields.textContent = yieldCount + ' yields';
+            const avgSlice = totalSliceTimeMs / sliceCount;
+            metricSliceDuration.textContent = avgSlice.toFixed(1) + ' ms';
+            metricBestScore.textContent = bestMatch.toFixed(1) + '%';
+
+            if (processed < totalBlends) {
+              yieldCount += 1;
+              metricYields.textContent = yieldCount + ' yields';
+              await yieldToMain();
+              sliceStart = performance.now();
+              itemsInCurrentSlice = 0;
+            }
+          }
+        }
+
+        if (currentRunId !== activeRunId) {
+          return null;
+        }
+
+        // Sort top blends in non-blocking stages if large
+        if (shouldYieldToMain(sliceStart, timeBudgetMs)) {
+          yieldCount += 1;
+          metricYields.textContent = yieldCount + ' yields';
+          await yieldToMain();
+        }
+
+        results.sort(function (a, b) {
+          return b.matchScore - a.matchScore;
+        });
+
+        latestSimulatedBlends = results;
+        renderSimulationResults(latestSimulatedBlends, blendFilterInput.value);
+
+        cancelBtn.disabled = true;
+        simulationStatusText.textContent =
+          'Completed ' +
+          totalBlends.toLocaleString() +
+          ' blends across ' +
+          yieldCount +
+          ' main-thread yields';
+        threadHealthBadge.textContent =
+          'Main Thread: Responsive (max slice ' + maxSliceMs.toFixed(1) + 'ms)';
+
+        return {
+          processed: processed,
+          yieldCount: yieldCount,
+          avgSliceMs: totalSliceTimeMs / Math.max(1, sliceCount),
+          maxSliceMs: maxSliceMs,
+          topBlends: results.slice(0, 8)
+        };
+      }
+
+      window.runFlavorSimulation = runFlavorSimulation;
+
+      // Event bindings
+      runBtn.addEventListener('click', function () {
+        runFlavorSimulation();
+      });
+
+      cancelBtn.addEventListener('click', function () {
+        activeRunId += 1;
+        cancelBtn.disabled = true;
+        simulationStatusText.textContent = 'Batch simulation paused by user';
+        progressLabel.textContent = 'Simulation Paused';
+      });
+
+      blendFilterInput.addEventListener('input', function () {
+        renderSimulationResults(latestSimulatedBlends, blendFilterInput.value);
+      });
+
+      targetProfileSelect.addEventListener('change', function () {
+        runFlavorSimulation();
+      });
+
+      brewMethodSelect.addEventListener('change', function () {
+        runFlavorSimulation();
+      });
+
+      // Populate initial baseline synchronously with a small sample, then kick off full chunked simulation
+      (function initBaseline() {
+        const seedRng = createSeededRng(42026);
+        const baselineConfig = {
+          targetProfile: targetProfileSelect.value,
+          roastTemp: Number(roastTempRange.value),
+          brewMethod: brewMethodSelect.value
+        };
+        const initialPool = [];
+        for (let i = 0; i < 40; i++) {
+          initialPool.push(simulateSingleRecipeBlend(i, baselineConfig, seedRng));
+        }
+        initialPool.sort(function (a, b) {
+          return b.matchScore - a.matchScore;
+        });
+        latestSimulatedBlends = initialPool;
+        renderSimulationResults(latestSimulatedBlends, '');
+      })();
+    })();
+  </script>
