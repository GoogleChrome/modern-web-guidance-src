+  <script>
+    document.querySelectorAll('.card').forEach((card) => {
+      const trigger = card.querySelector('a.btn');
+      const hovercard = card.querySelector('.hovercard');
+      if (!trigger || !hovercard) return;
+
+      let hideTimeout = null;
+
+      const showHovercard = () => {
+        clearTimeout(hideTimeout);
+        document.querySelectorAll('.hovercard.active').forEach((other) => {
+          if (other !== hovercard) {
+            other.classList.remove('active');
+            other.setAttribute('aria-hidden', 'true');
+          }
+        });
+        hovercard.classList.add('active');
+        hovercard.setAttribute('aria-hidden', 'false');
+        trigger.setAttribute('aria-expanded', 'true');
+      };
+
+      const scheduleHide = () => {
+        clearTimeout(hideTimeout);
+        hideTimeout = setTimeout(() => {
+          hovercard.classList.remove('active');
+          hovercard.setAttribute('aria-hidden', 'true');
+          trigger.setAttribute('aria-expanded', 'false');
+        }, 120);
+      };
+
+      trigger.addEventListener('mouseenter', showHovercard);
+      trigger.addEventListener('focus', showHovercard);
+      trigger.addEventListener('mouseleave', scheduleHide);
+      trigger.addEventListener('blur', scheduleHide);
+
+      hovercard.addEventListener('mouseenter', showHovercard);
+      hovercard.addEventListener('focusin', showHovercard);
+      hovercard.addEventListener('mouseleave', scheduleHide);
+      hovercard.addEventListener('focusout', (e) => {
+        if (!hovercard.contains(e.relatedTarget) && e.relatedTarget !== trigger) {
+          scheduleHide();
+        }
+      });
+
+      const priceEl = hovercard.querySelector('[data-role="price"]');
+      const caloriesEl = hovercard.querySelector('[data-role="calories"]');
+      const caffeineEl = hovercard.querySelector('[data-role="caffeine"]');
+      const sizeButtons = hovercard.querySelectorAll('.hovercard-size-btn');
+
+      sizeButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeButtons.forEach((b) => b.classList.remove('selected'));
+          btn.classList.add('selected');
+          if (priceEl && btn.dataset.price) priceEl.textContent = btn.dataset.price;
+          if (caloriesEl && btn.dataset.calories) caloriesEl.textContent = btn.dataset.calories;
+          if (caffeineEl && btn.dataset.caffeine) caffeineEl.textContent = btn.dataset.caffeine;
+        });
+      });
+    });
+  </script>
