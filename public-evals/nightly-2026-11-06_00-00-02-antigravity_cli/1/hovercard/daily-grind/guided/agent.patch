+      color: #6d4c41;
+      margin-bottom: 10px;
+    }
+
+    .hovercard-body {
+      display: flex;
+      gap: 12px;
+      align-items: flex-start;
+      margin-bottom: 12px;
+    }
+
+    .hovercard-body img {
+      width: 90px;
+      height: 90px;
+      object-fit: cover;
+      border-radius: 6px;
+      flex-shrink: 0;
+    }
+
+    .hovercard-body p {
+      font-size: 0.85rem;
+      line-height: 1.45;
+      color: var(--text);
+    }
+
+    .hovercard-meta {
+      display: flex;
