+    /* Scroll-Position-Aware Floating Back to Top Button */
+    @keyframes reveal-back-to-top {
+      0% {
+        opacity: 0;
+        visibility: hidden;
+        pointer-events: none;
+        transform: translateY(16px) scale(0.9);
+      }
+      1% {
+        visibility: visible;
+        pointer-events: auto;
+      }
+      100% {
+        opacity: 1;
+        visibility: visible;
+        pointer-events: auto;
+        transform: translateY(0) scale(1);
+      }
+    }
+
+    .back-to-top {
+      position: fixed;
+      bottom: 2rem;
+      right: 2rem;
+      z-index: 1100;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5rem;
+      padding: 0.75rem 1.15rem;
+      border: 2px solid var(--accent);
+      border-radius: 999px;
+      background-color: var(--primary);
+      color: #ffffff;
+      font-family: inherit;
+      font-size: 0.9rem;
+      font-weight: 600;
+      cursor: pointer;
+      box-shadow: 0 6px 18px rgba(62, 39, 35, 0.28);
+      /* Start hidden at the top of the container */
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transform: translateY(16px) scale(0.9);
+      transition:
+        background-color 0.2s ease,
+        color 0.2s ease,
+        box-shadow 0.2s ease,
+        border-color 0.2s ease;
+      /* CSS Scroll-Driven Animation bound to .scroller */
+      animation-name: reveal-back-to-top;
+      animation-fill-mode: both;
+      animation-timing-function: linear;
+      animation-timeline: --scroller;
+      animation-range: 0px 150px;
+    }
+
+    .back-to-top.is-visible,
+    .back-to-top.visible {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateY(0) scale(1);
+    }
+
+    @supports not (animation-timeline: scroll()) {
+      .back-to-top {
+        transition:
+          opacity 0.3s ease,
+          transform 0.3s ease,
+          visibility 0.3s ease,
+          background-color 0.2s ease,
+          color 0.2s ease,
+          box-shadow 0.2s ease;
+      }
+    }
