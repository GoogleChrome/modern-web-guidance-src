+  <script>
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeBtn = document.getElementById('close-tour');
+
+    function isTourOpen() {
+      if (typeof tourStep.matches === 'function' && tourStep.matches(':popover-open')) {
+        return true;
+      }
+      return tourStep.classList.contains('is-open');
+    }
+
+    if (typeof tourStep.showPopover === 'function') {
+      tourStep.showPopover();
+    } else {
+      tourStep.classList.add('is-open');
+    }
+
+    if (!(window.CSS && CSS.supports && CSS.supports('anchor-name', '--feature'))) {
+      function updateTourPosition() {
+        if (!isTourOpen()) return;
+        const rect = featureLink.getBoundingClientRect();
+        tourStep.style.top = `${rect.bottom + 12}px`;
+        tourStep.style.left = `${rect.left + rect.width / 2}px`;
+        tourStep.style.transform = 'translateX(-50%)';
+      }
+      updateTourPosition();
+      window.addEventListener('resize', updateTourPosition);
+      window.addEventListener('scroll', updateTourPosition, true);
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updateTourPosition);
+        ro.observe(document.body);
+        ro.observe(featureLink);
+      }
+    }
+
+    closeBtn.addEventListener('click', () => {
+      if (typeof tourStep.hidePopover === 'function') {
+        if (tourStep.matches(':popover-open')) {
+          tourStep.hidePopover();
+        }
+      } else {
+        tourStep.classList.remove('is-open');
+        tourStep.style.display = 'none';
+      }
+    });
+
+    featureLink.addEventListener('click', (event) => {
+      if (isTourOpen()) {
+        event.preventDefault();
+      }
+    });
+  </script>
+
