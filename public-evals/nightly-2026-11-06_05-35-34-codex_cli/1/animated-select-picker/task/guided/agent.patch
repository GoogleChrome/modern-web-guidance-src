+    .store-selector {
+      width: min(100%, 20rem);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .store-selector label {
+      display: block;
+      margin-bottom: 0.375rem;
+      font-weight: 600;
+    }
+
+    .store-select {
+      width: 100%;
+      min-height: 48px;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      color: var(--text);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: transform 250ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        transform: rotate(180deg);
+      }
+
+      .store-select::picker(select) {
+        width: anchor-size(width);
+        max-height: min(20rem, 50dvh);
+        overflow-y: auto;
+        margin-block: 0.375rem;
+        padding: 0.375rem;
+        border: 1px solid var(--secondary);
+        border-radius: 8px;
+        background: var(--light);
+        color: var(--text);
+        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
+        opacity: 0;
+        transition:
+          opacity 250ms ease,
+          display 250ms allow-discrete,
+          overlay 250ms allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      .store-select option {
+        min-height: 48px;
+        padding: 0.625rem 0.75rem;
+        border-radius: 4px;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+        font-weight: 700;
+      }
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
