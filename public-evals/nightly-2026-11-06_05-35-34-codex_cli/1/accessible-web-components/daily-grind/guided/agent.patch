+// Reuse with <favorite-toggle drink-id="unique-id" drink-name="Drink name">.
+// The boolean `favorite` attribute also exposes the current selection.
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['favorite', 'drink-name'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host { display: block; margin-top: 14px; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 16px;
+          border: 1px solid var(--primary, #4e342e);
+          border-radius: 24px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+        button:hover { background: #f5efec; }
+        button[aria-pressed="true"] { background: #fff0dc; }
+        button:focus-visible {
+          outline: 3px solid var(--primary, #4e342e);
+          outline-offset: 3px;
+        }
+        svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }
+        button[aria-pressed="true"] svg { fill: currentColor; }
+        .state { font-size: 0.85em; }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
+        </svg>
+        <span>Favorite</span>
+        <span class="state" aria-hidden="true">Off</span>
+      </button>
+    `;
+    this.button = root.querySelector('button');
+    this.stateLabel = root.querySelector('.state');
+    this.button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      try {
+        if (this.storageKey) {
+          localStorage.setItem(this.storageKey, String(this.favorite));
+        }
+      } catch {
+        // Keep the toggle usable when browser storage is unavailable.
+      }
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkId: this.getAttribute('drink-id'), favorite: this.favorite },
+      }));
+    });
+  }
+
+  connectedCallback() {
+    try {
+      const saved = this.storageKey && localStorage.getItem(this.storageKey);
+      if (saved !== null && saved !== undefined) this.favorite = saved === 'true';
+    } catch {
+      // Use the current selection when browser storage is unavailable.
+    }
+    this.render();
+  }
+
+  attributeChangedCallback() {
+    this.render();
+  }
+
+  get storageKey() {
+    const id = this.getAttribute('drink-id');
+    return id ? `daily-grind:favorite:${id}` : null;
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  render() {
+    this.button.setAttribute('aria-pressed', String(this.favorite));
+    this.button.setAttribute('aria-label', `Favorite ${this.getAttribute('drink-name') || 'drink'}`);
+    this.stateLabel.textContent = this.favorite ? 'On' : 'Off';
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
