+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let authenticated = false;
+    let compatibility;
+
+    async function prepareWebAuthn() {
+      // Polyfill JSON conversion and capability detection on older WebAuthn clients.
+      if (!PublicKeyCredential.getClientCapabilities ||
+          !PublicKeyCredential.parseRequestOptionsFromJSON ||
+          !PublicKeyCredential.prototype.toJSON) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+    }
+
+    async function authenticate(conditional = false) {
+      if (authenticated) return;
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      const { signal } = controller;
+      let completed = false;
+
+      if (!conditional) {
+        button.disabled = true;
+        status.textContent = 'Waiting for your passkey…';
+      }
+
+      try {
+        compatibility ??= prepareWebAuthn();
+        await compatibility;
+        if (signal.aborted) return;
+        if (conditional) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (signal.aborted || !capabilities.conditionalGet) return;
+        }
+
+        // The backend must generate and retain a fresh challenge in this session.
+        // Options are WebAuthn JSON, either directly or wrapped in publicKey.
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options.publicKey ?? options);
+        // Discoverable passkeys let users choose an account without typing first.
+        publicKey.allowCredentials = [];
+        if (!conditional) publicKey.userVerification = 'required';
+        if (signal.aborted) return;
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal,
+        });
+        if (!credential || signal.aborted) return;
+
+        button.disabled = true;
+        status.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+          signal,
+        });
+        if (!response.ok) {
+          if (response.status === 404 && publicKey.rpId && PublicKeyCredential.signalUnknownCredential) {
+            // A failed synchronization must not hide the verification error.
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            }).catch(() => {});
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        const result = response.status === 204 ? {} : await response.json();
+        if (result.verified === false || result.success === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        authenticated = true;
+        completed = true;
+        status.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (signal.aborted || error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) status.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+        } else {
+          status.textContent = error instanceof TypeError
+            ? 'Unable to connect. Please try signing in again.'
+            : error.message || 'Unable to sign in with a passkey. Please try again.';
+        }
+      } finally {
+        if (activeRequest === controller) {
+          activeRequest = undefined;
+          button.disabled = authenticated;
+          // Restore silent autofill after a dismissed or failed explicit prompt.
+          if (!conditional && !completed) void authenticate(true);
+        }
+      }
+    }
+
+    if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+      button.disabled = true;
+      status.textContent = 'Passkeys require a supported browser and a secure connection.';
+      form.addEventListener('submit', (event) => event.preventDefault());
+    } else {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!button.disabled) void authenticate();
+      });
+      // Pending conditional mediation stays silent until the username is focused.
+      void authenticate(true);
+      window.addEventListener('pagehide', () => activeRequest?.abort());
+    }
+  </script>
+
