+<script>
+const mixed = document.getElementById('mixed-fonts-container');
+const normalize = document.getElementById('normalize');
+document.getElementById('body-font').addEventListener('change', e => {mixed.style.fontFamily = e.target.value;document.querySelector('.font-key').textContent = e.target.selectedOptions[0].textContent;});
+document.getElementById('code-font').addEventListener('change', e => {mixed.querySelector('code').style.fontFamily = e.target.value;document.querySelector('.font-key.mono').textContent = e.target.selectedOptions[0].textContent;});
+for (const [id, property, unit] of [['font-size','fontSize','px'],['line-height','lineHeight','']]) {document.getElementById(id).addEventListener('input', e => {mixed.style[property] = e.target.value + unit;document.getElementById(id+'-value').textContent = e.target.value + (unit ? ' '+unit : '');});}
+normalize.addEventListener('click', () => {const enabled = normalize.getAttribute('aria-checked') !== 'true';normalize.setAttribute('aria-checked',String(enabled));mixed.style.fontSizeAdjust = enabled ? 'from-font' : 'none';document.getElementById('code-adjust').textContent = enabled ? 'from-font' : 'none';document.getElementById('adjust-badge').textContent = enabled ? 'from-font' : 'none';document.querySelector('.preview-caption').innerHTML = enabled ? '<span class="check">✓</span> Optical height, automatically aligned.' : '<span class="check">○</span> Original font proportions, without adjustment.';});
+const tabs = [...document.querySelectorAll('[role=tab]')];
+function activateTab(tab) {tabs.forEach(item => {const active = item === tab;item.classList.toggle('active', active);item.setAttribute('aria-selected',String(active));item.tabIndex = active ? 0 : -1;document.getElementById(item.getAttribute('aria-controls')).classList.toggle('hidden', !active);});document.getElementById('source-view').classList.add('visible');}
+tabs.forEach((tab,index) => {tab.tabIndex = index === 0 ? 0 : -1;tab.addEventListener('click', () => activateTab(tab));tab.addEventListener('keydown', e => {if (['ArrowLeft','ArrowRight','Home','End'].includes(e.key)) {e.preventDefault();const next = e.key === 'Home' ? tabs[0] : e.key === 'End' ? tabs.at(-1) : tabs[(index + 1) % tabs.length];activateTab(next);next.focus();}});});
+document.getElementById('copy-css').addEventListener('click', async e => {const button = e.currentTarget;const css = `#mixed-fonts-container {\n  font-size-adjust: ${normalize.getAttribute('aria-checked') === 'true' ? 'from-font' : 'none'};\n}\n\n#independent-theme-container {\n  font-size-adjust: 0.5;\n  aspect-ratio: 16 / 10;\n}`;try {await navigator.clipboard.writeText(css);button.textContent = '✓ Copied';} catch {button.textContent = 'Select CSS to copy';}setTimeout(() => {button.innerHTML = '<span>▢</span> Copy code';},2200);});
