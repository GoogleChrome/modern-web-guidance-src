+    .sample-label { margin: 0 0 14px; color: #8b9685; font: .6rem monospace; letter-spacing: 1.5px; }
+    #mixed-fonts-container { font-family: Arial, Helvetica, sans-serif; font-size: var(--sample-size); font-size-adjust: from-font; line-height: 1.65; margin: 0; max-width: 38ch; overflow-wrap: anywhere; }
+    #mixed-fonts-container code { font-family: 'Courier New', Courier, monospace; font-size: 1em; color: #377857; background: #dfe9d9; border-radius: 3px; padding: 1px 4px; }
+    #independent-theme-container { font-family: Georgia, 'Times New Roman', serif; font-size: var(--sample-size); font-size-adjust: 0.5; line-height: 1.65; background: #293e35; color: #f0f3e8; }
+    #independent-theme-container p:last-child { margin: 0; overflow-wrap: anywhere; }
+    #independent-theme-container em { color: #c6dcaa; }
+    #independent-theme-container .sample-label { color: #a6b7a5; font-size-adjust: none; }
+    .show-guides .sample-text { background-image: repeating-linear-gradient(to bottom, transparent 0, transparent calc(1.65em - 1px), #83a77555 calc(1.65em - 1px), #83a77555 1.65em); }
+    .font-meta { display: flex; gap: 6px; align-items: center; padding: 16px 19px; color: #869080; font-size: .65rem; }
+    .font-meta strong { font-weight: 400; color: #4e5d50; } .font-meta .spacer { flex: 1; }
