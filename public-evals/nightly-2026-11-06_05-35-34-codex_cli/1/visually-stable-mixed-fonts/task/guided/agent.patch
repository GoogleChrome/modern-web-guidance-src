+    .guide-label input:checked { background: #377857; }
+    .guide-label input:checked::after { transform: translateX(11px); }
+    .reset { border: 0; background: transparent; color: #778078; font-size: .7rem; padding: 3px 0 3px 20px; border-left: 1px solid var(--line); }
+    .specimens { padding: 25px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
+    .specimen { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; min-width: 0; }
+    .specimen-header { display: flex; align-items: center; padding: 16px 19px; gap: 9px; }
+    .number { color: #939b92; font: .65rem monospace; }
+    h2 { font-size: .8rem; font-weight: 600; margin: 0; }
+    .badge { margin-left: auto; background: #edf4eb; color: #658362; font: .6rem monospace; padding: 4px 7px; border-radius: 4px; }
