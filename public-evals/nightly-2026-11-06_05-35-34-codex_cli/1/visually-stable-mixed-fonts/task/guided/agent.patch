+    .code-toolbar { display: flex; align-items: center; padding: 0 24px; gap: 22px; border-bottom: 1px solid #e7ebe3; }
+    .tabs { display: flex; gap: 22px; }
+    .tab { color: #899185; border: 0; background: transparent; padding: 14px 0 12px; font-size: .7rem; border-bottom: 2px solid transparent; }
+    .tab[aria-selected=true] { color: var(--green); border-bottom-color: var(--green); }
+    .filename { margin-left: auto; font: .65rem monospace; color: #98a08f; }
+    .copy { border: 1px solid #dfe5d8; border-radius: 5px; color: #657260; background: white; font-size: .65rem; padding: 4px 9px; }
+    pre { margin: 0; padding: 23px 25px 26px; font: .75rem/1.9 'Courier New', monospace; overflow-x: auto; color: #607457; tab-size: 2; }
+    .code-comment { color: #98a18f; } .code-property { color: #537f75; } .code-value { color: #9a7853; }
+    .status { border-top: 1px solid var(--line); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; font-size: .65rem; color: #8a9385; }
+    .status span:first-child { display: flex; gap: 7px; align-items: center; color: #637d61; }
+    .notes { display: grid; grid-template-columns: 1fr 1fr; gap: 55px; padding: 28px 4px 32px; }
+    .note { display: flex; align-items: flex-start; gap: 12px; }
+    .note-icon { flex-shrink: 0; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 6px; width: 27px; height: 27px; font-family: Georgia, serif; color: #74856c; }
+    .note h3 { font-size: .75rem; margin: 0 0 5px; font-weight: 600; }
+    .note p { color: #838b7e; font-size: .72rem; margin: 0; line-height: 1.8; max-width: 60ch; }
+    .note code { color: #637c5e; font-size: .95em; }
+    footer { padding: 19px 0 25px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: #92998c; font-size: .65rem; }
+    footer span:last-child { font-family: monospace; }
+    @supports not (font-size-adjust: from-font) { #mixed-fonts-container { line-height: 1.7; } #mixed-fonts-container code { font-size: .98em; } }
+    @supports not (font-size-adjust: 0.5) { #independent-theme-container { font-size: calc(var(--sample-size) * 1.04); line-height: 1.7; } }
+    @media (min-width: 1450px) { .hero { padding-top: 70px; padding-bottom: 48px; } .canvas { min-height: 240px; } }
+    @media (max-width: 760px) { main { padding: 0 22px; } .header-inner { padding: 18px 22px; } .hero { padding: 34px 0; } h1 { letter-spacing: -1.6px; } .hero-art { display: none; } .header-caption { font-size: .65rem; } .header-caption span { display: none; } .toolbar { flex-wrap: wrap; gap: 15px; padding: 16px; } .live-label { width: 100%; } .size-control { margin-right: auto; } .specimens { grid-template-columns: 1fr; padding: 15px; gap: 15px; } .canvas { min-height: 190px; } .notes { grid-template-columns: 1fr; gap: 22px; } .filename { display: none; } .copy { margin-left: auto; } .status { gap: 12px; padding: 12px 16px; } footer { gap: 15px; } }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <div class="header-inner">
+      <a class="brand" href="./" aria-label="Type Lab home"><span class="brand-mark" aria-hidden="true">a</span>type lab<span style="color:#90a187">.</span></a>
+      <div class="header-caption">Small experiments. Better typography.<span>EXPERIMENT 001</span></div>
+    </div>
+  </header>
+  <main>
+    <section class="hero" aria-labelledby="page-title">
+      <div><p class="eyebrow">A LITTLE MORE IN PROPORTION</p><h1 id="page-title">Different fonts.<br><span>Same visual rhythm.</span></h1><p class="intro">Give every font a common ground. Explore how modern CSS keeps mixed type beautifully balanced, automatically.</p></div>
+      <div class="hero-art" aria-hidden="true">A<span>a</span></div>
+    </section>
+    <section class="workspace" aria-label="Font size adjustment playground">
+      <div class="toolbar">
+        <span class="live-label"><span class="dot"></span>Live playground</span>
+        <label class="size-control" for="font-size">Font size <input id="font-size" type="range" min="18" max="32" value="24"><output id="size-value" for="font-size">24px</output></label>
+        <label class="guide-label">Show baselines <input id="guides" type="checkbox" role="switch"></label>
+        <button class="reset" type="button" id="reset">↺ &nbsp; Reset</button>
+      </div>
+      <div class="specimens">
+        <article class="specimen">
+          <div class="specimen-header"><span class="number">01</span><h2>Mixed font families</h2><span class="badge">automatic</span></div>
+          <div class="canvas"><p class="sample-label">ONE PARAGRAPH. TWO PERSONALITIES.</p><p id="mixed-fonts-container" class="sample-text">Good design is in the details.<br>Even a little <code>inline code</code> should feel right at home.</p></div>
+          <div class="font-meta"><strong>Arial</strong><span>+ </span><strong>Courier New</strong><span class="spacer"></span><span>sans + mono</span></div>
+        </article>
+        <article class="specimen">
+          <div class="specimen-header"><span class="number">02</span><h2>Independent theme</h2><span class="badge">ratio · 0.5</span></div>
+          <div id="independent-theme-container" class="canvas"><p class="sample-label">A WORLD OF ITS OWN.</p><p class="sample-text">A different character.<br>The same <em>sense of balance.</em><br>Beautifully in proportion.</p></div>
+          <div class="font-meta"><strong>Georgia</strong><span class="spacer"></span><span>serif · independent theme</span></div>
+        </article>
+      </div>
+      <div class="code-panel">
+        <div class="code-toolbar">
+          <div class="tabs" role="tablist" aria-label="Implementation language">
+          <button class="tab" id="css-tab" role="tab" aria-selected="true" aria-controls="code-view" tabindex="0" data-language="css">CSS</button>
+          <button class="tab" id="html-tab" role="tab" aria-selected="false" aria-controls="code-view" tabindex="-1" data-language="html">HTML</button>
+          </div>
+          <span class="filename" id="filename">the little things.css</span>
+          <button class="copy" id="copy" type="button" role="button" aria-label="Copy displayed code">⧉ &nbsp; Copy code</button>
+        </div>
+        <pre id="code-view" role="tabpanel" aria-labelledby="css-tab" tabindex="0"><code id="code-content"><span class="code-comment">/* Let the primary font set the rhythm. */</span>
+#mixed-fonts-container {
+  <span class="code-property">font-size-adjust</span>: <span class="code-value">from-font</span>;
+}
+
+<span class="code-comment">/* Give an independent theme its own proportions. */</span>
+#independent-theme-container {
+  <span class="code-property">font-size-adjust</span>: <span class="code-value">0.5</span>;
+}</code></pre>
+      </div>
+      <div class="status"><span id="support-status"><span class="dot"></span>Progressive enhancement enabled</span><span>Native CSS. No dependencies.</span></div>
+    </section>
+    <section class="notes" aria-label="How it works">
+      <div class="note"><span class="note-icon" aria-hidden="true">x</span><div><h3>Match the height, keep the character.</h3><p><code>from-font</code> uses the primary font’s x-height to automatically normalize the visual size of other fonts in the paragraph.</p></div></div>
+      <div class="note"><span class="note-icon" aria-hidden="true">↗</span><div><h3>Independent, but in harmony.</h3><p>A fixed <code>0.5</code> x-height ratio gives the separate theme consistent proportions, regardless of its surrounding typography.</p></div></div>
+    </section>
+    <footer><span>A small exploration of the modern web.</span><span>Made with care & a little CSS.</span></footer>
+  </main>
+  <script>
+    const sizeInput = document.querySelector('#font-size');
+    const sizeValue = document.querySelector('#size-value');
+    const guides = document.querySelector('#guides');
+    const workspace = document.querySelector('.workspace');
+    sizeInput.addEventListener('input', () => {
+      document.documentElement.style.setProperty('--sample-size', `${Number(sizeInput.value) / 16}rem`);
+      sizeValue.value = `${sizeInput.value}px`;
+    });
+    guides.addEventListener('change', () => workspace.classList.toggle('show-guides', guides.checked));
+    document.querySelector('#reset').addEventListener('click', () => {
+      sizeInput.value = '24';
+      sizeInput.dispatchEvent(new Event('input'));
+      guides.checked = false;
+      workspace.classList.remove('show-guides');
+    });
+    const code = document.querySelector('#code-content');
+    const cssMarkup = code.innerHTML;
+    const htmlSource = `<p id="mixed-fonts-container">\n  Good design is in the details.\n  Even a little <code>inline code</code>\n  should feel right at home.\n</p>\n\n<div id="independent-theme-container">\n  <p>A different character.\n  The same <em>sense of balance.</em></p>\n</div>`;
+    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
+    function selectTab(tab) {
+      tabs.forEach(item => {
+        item.setAttribute('aria-selected', String(item === tab));
+        item.tabIndex = item === tab ? 0 : -1;
+      });
+      const isCss = tab.dataset.language === 'css';
+      if (isCss) code.innerHTML = cssMarkup;
+      else code.textContent = htmlSource;
+      document.querySelector('#filename').textContent = isCss ? 'the little things.css' : 'the little things.html';
+      document.querySelector('#code-view').setAttribute('aria-labelledby', tab.id);
+    }
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('keydown', event => {
+        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+        event.preventDefault();
+        const next = event.key === 'Home' ? tabs[0] : event.key === 'End' ? tabs[tabs.length - 1] : tabs[(index + 1) % tabs.length];
+        selectTab(next);
+        next.focus();
+      });
+    });
+    const copy = document.querySelector('#copy');
+    copy.addEventListener('click', async () => {
+      try {
+        await navigator.clipboard.writeText(code.textContent);
+        copy.textContent = '✓ Copied';
+        setTimeout(() => { copy.textContent = '⧉  Copy code'; }, 1800);
+      } catch {
+        copy.textContent = 'Select code to copy';
+        document.querySelector('#code-view').focus();
+        const selection = window.getSelection();
+        const range = document.createRange();
+        range.selectNodeContents(code);
+        selection.removeAllRanges();
+        selection.addRange(range);
+      }
+    });
+    if (CSS.supports('font-size-adjust', 'from-font') && CSS.supports('font-size-adjust', '0.5')) {
+      document.querySelector('#support-status').lastChild.textContent = 'font-size-adjust is supported in your browser';
+    } else {
+      document.querySelector('#support-status').lastChild.textContent = 'Fallback typography active in this browser';
+    }
+  </script>
+</body>
+</html>
