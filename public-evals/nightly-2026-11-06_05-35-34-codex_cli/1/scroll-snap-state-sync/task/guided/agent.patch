+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+
+    function setActive(id) {
+      tocLinks.forEach(link => {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function scrollToHeading(heading, behavior) {
+      const padding = parseFloat(getComputedStyle(panel).scrollPaddingBlockStart) || 0;
+      const top = panel.scrollTop + heading.getBoundingClientRect().top
+        - panel.getBoundingClientRect().top - panel.clientTop - padding;
+      panel.scrollTo({ top, behavior });
+    }
+
+    tocLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = headings.find(item => `#${item.id}` === link.hash);
+        heading.focus({ preventScroll: true });
+        // CSS supplies smooth scrolling and honors reduced-motion preferences.
+        scrollToHeading(heading, 'auto');
+        if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (event.snapTargetBlock) setActive(event.snapTargetBlock.id);
+      });
+    } else {
+      function syncActiveHeading() {
+        const padding = parseFloat(getComputedStyle(panel).scrollPaddingBlockStart) || 0;
+        const top = panel.getBoundingClientRect().top + panel.clientTop + padding;
+        const nearest = headings.reduce((closest, heading) =>
+          Math.abs(heading.getBoundingClientRect().top - top)
+            < Math.abs(closest.getBoundingClientRect().top - top) ? heading : closest
+        );
+        setActive(nearest.id);
+      }
+
+      const observer = new IntersectionObserver(syncActiveHeading, {
+        root: panel,
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      panel.querySelectorAll('.drink-section').forEach(section => observer.observe(section));
+      panel.addEventListener('scrollend', syncActiveHeading);
+    }
+
+    function followHash() {
+      const heading = headings.find(item => `#${item.id}` === location.hash);
+      if (heading) {
+        scrollToHeading(heading, 'instant');
+        setActive(heading.id);
+      }
+    }
+
+    window.addEventListener('hashchange', followHash);
+    followHash();
+  </script>
+
