@@ -0,0 +1,154 @@
+(() => {
+  'use strict';
+
+  // Read the displayed menu so tools and visitors see the same descriptions.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+  }));
+  const drinkInput = document.getElementById('order-drink');
+  const quantityInput = document.getElementById('order-quantity');
+  const status = document.getElementById('order-status');
+  const orderItems = document.getElementById('order-items');
+  const orders = [];
+  const result = data => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+  const failure = error => ({ ...result({ error }), isError: true });
+  const snapshot = () => orders.map(item => ({ ...item }));
+
+  function validate(input, allowed) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      return 'Arguments must be an object.';
+    }
+    if (Object.keys(input).some(key => !allowed.includes(key))) {
+      return `Supported arguments: ${allowed.join(', ')}.`;
+    }
+    return null;
+  }
+
+  function selectDrink(drinkId) {
+    const drink = menu.find(item => item.id === drinkId);
+    if (!drink) return null;
+    drinkInput.value = drink.id;
+    cards.forEach(card => card.classList.toggle('is-selected', card.dataset.drinkId === drink.id));
+    return drink;
+  }
+
+  function revealOrder() {
+    document.getElementById('order-panel').scrollIntoView({ behavior: 'smooth', block: 'center' });
+    drinkInput.focus({ preventScroll: true });
+  }
+
+  function renderOrder() {
+    orderItems.replaceChildren(...orders.map(item => {
+      const row = document.createElement('li');
+      row.textContent = `${item.quantity} × ${item.name}`;
+      return row;
+    }));
+  }
+
+  const drinkSchema = {
+    type: 'string', enum: menu.map(item => item.id), description: 'The menu ID of the drink.',
+  };
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Seasonal Favorites coffee menu. Returns drink IDs, names, and descriptions without changing the page.',
+      inputSchema: {
+        type: 'object', properties: { query: { type: 'string', description: 'Search text matched against drink names and descriptions.', default: '' } },
+        additionalProperties: false,
+      },
+      annotations: { readOnlyHint: true },
+      execute(input = {}) {
+        const error = validate(input, ['query']);
+        if (error) return failure(error);
+        const { query = '' } = input;
+        if (typeof query !== 'string') return failure('query must be a string.');
+        const search = query.trim().toLowerCase();
+        return result({ section: 'Seasonal Favorites', drinks: menu.filter(item =>
+          `${item.name} ${item.description}`.toLowerCase().includes(search)) });
+      },
+    },
+    {
+      name: 'select_drink',
+      description: 'Highlight a seasonal drink, select it in the order form, and bring the form into view without adding an order.',
+      inputSchema: { type: 'object', properties: { drinkId: drinkSchema }, required: ['drinkId'], additionalProperties: false },
+      annotations: { readOnlyHint: false },
+      execute(input = {}) {
+        const error = validate(input, ['drinkId']);
+        if (error) return failure(error);
+        const drink = selectDrink(input.drinkId);
+        if (!drink) return failure('Unknown drinkId. Use get_seasonal_menu to find available drinks.');
+        status.textContent = `${drink.name} selected. Choose a quantity and add it to your order.`;
+        revealOrder();
+        return result({ selectedDrink: drink });
+      },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible local demo order and show confirmation. No payment or real café order is submitted; orders reset on reload.',
+      inputSchema: {
+        type: 'object', properties: {
+          drinkId: drinkSchema,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add.' },
+        }, required: ['drinkId'], additionalProperties: false,
+      },
+      annotations: { readOnlyHint: false },
+      execute(input = {}) {
+        const error = validate(input, ['drinkId', 'quantity']);
+        if (error) return failure(error);
+        const { quantity = 1 } = input;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          return failure('quantity must be an integer between 1 and 10.');
+        }
+        const drink = selectDrink(input.drinkId);
+        if (!drink) return failure('Unknown drinkId. Use get_seasonal_menu to find available drinks.');
+        quantityInput.value = String(quantity);
+        orders.push({ drinkId: drink.id, name: drink.name, quantity });
+        renderOrder();
+        status.textContent = `Added ${quantity} × ${drink.name} to your demo order.`;
+        revealOrder();
+        return result({ status: 'added_to_demo_order', orders: snapshot() });
+      },
+    },
+  ];
+
+  // Also expose an explicit discovery/invocation surface without patching native APIs.
+  window.dailyGrind = Object.freeze({
+    listTools: () => tools.map(({ execute, ...definition }) => JSON.parse(JSON.stringify(definition))),
+    async callTool(name, input = {}) {
+      const tool = tools.find(item => item.name === name);
+      return tool ? tool.execute(input) : failure('Unknown tool. Call dailyGrind.listTools() for available tools.');
+    },
+  });
+
+  document.querySelectorAll('[data-select-drink]').forEach(button => {
+    button.addEventListener('click', () => tools[1].execute({ drinkId: button.dataset.selectDrink }));
+  });
+  drinkInput.addEventListener('change', () => selectDrink(drinkInput.value));
+  document.getElementById('order-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const response = tools[2].execute({ drinkId: drinkInput.value, quantity: Number(quantityInput.value) });
+    if (response.isError) status.textContent = JSON.parse(response.content[0].text).error;
+  });
+  document.getElementById('clear-order').addEventListener('click', () => {
+    orders.length = 0;
+    renderOrder();
+    status.textContent = 'Your demo order has been cleared.';
+  });
+
+  // Prefer the current WebMCP API; support the older navigator API as well.
+  const modelContext = document.modelContext?.registerTool ? document.modelContext : navigator.modelContext;
+  if (modelContext?.registerTool) {
+    for (const tool of tools) {
+      try {
+        Promise.resolve(modelContext.registerTool(tool)).catch(error => {
+          console.warn(`Daily Grind could not register ${tool.name}:`, error);
+        });
+      } catch (error) {
+        console.warn(`Daily Grind could not register ${tool.name}:`, error);
+      }
+    }
+  }
+})();
