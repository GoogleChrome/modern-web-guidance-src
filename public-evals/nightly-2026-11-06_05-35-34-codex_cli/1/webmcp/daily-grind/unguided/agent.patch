diff --git a/tests/app.test.cjs b/tests/app.test.cjs
new file mode 100644
index 0000000..a9b1d08
--- /dev/null
+++ b/tests/app.test.cjs
@@ -0,0 +1,93 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const html = readFileSync('index.html', 'utf8');
+const source = readFileSync('app.js', 'utf8');
+
+function setup(api = 'none') {
+  function element(extra = {}) {
+    return Object.assign({
+      value: '', textContent: '', children: [], listeners: {},
+      addEventListener(name, callback) { this.listeners[name] = callback; },
+      replaceChildren(...children) { this.children = children; },
+      scrollIntoView() { this.scrolled = true; },
+      focus() { this.focused = true; },
+    }, extra);
+  }
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)">\s*<h3>([^<]+)<\/h3>\s*<p>([^<]+)<\/p>/g)].map(([, id, name, description]) => element({
+    dataset: { drinkId: id },
+    querySelector: selector => ({ textContent: selector === 'h3' ? name : description }),
+    classList: { toggle(name, selected) { this.selected = selected; } },
+  }));
+  assert.equal(cards.length, 3);
+  const buttons = cards.map(card => element({ dataset: { selectDrink: card.dataset.drinkId } }));
+  const elements = Object.fromEntries(['order-drink', 'order-quantity', 'order-status', 'order-items', 'order-panel', 'order-form', 'clear-order'].map(id => [id, element()]));
+  const registered = [];
+  const document = {
+    querySelectorAll: selector => selector === '[data-drink-id]' ? cards : buttons,
+    getElementById: id => elements[id], createElement: () => element(),
+  };
+  const navigator = {};
+  if (api !== 'none') (api === 'current' ? document : navigator).modelContext = { registerTool: tool => registered.push(tool) };
+  const window = {};
+  vm.runInNewContext(source, { document, navigator, window, console });
+  return { tools: window.dailyGrind, elements, cards, buttons, registered };
+}
+const payload = response => JSON.parse(response.content[0].text);
+
+test('registers discoverable schemas with current and legacy WebMCP APIs', () => {
+  for (const api of ['current', 'legacy']) {
+    const { tools, registered } = setup(api);
+    assert.equal(registered.length, 3);
+    assert.deepEqual(Array.from(registered, tool => tool.name), ['get_seasonal_menu', 'select_drink', 'order_drink']);
+    assert.equal(tools.listTools()[0].annotations.readOnlyHint, true);
+    const schema = tools.listTools();
+    schema[0].name = 'changed';
+    assert.equal(tools.listTools()[0].name, 'get_seasonal_menu');
+  }
+});
+
+test('fallback queries visible menu with case-insensitive search and no UI mutations', async () => {
+  const { tools, elements } = setup();
+  assert.equal(payload(await tools.callTool('get_seasonal_menu')).drinks.length, 3);
+  const found = payload(await tools.callTool('get_seasonal_menu', { query: ' OAT ' }));
+  assert.equal(found.drinks[0].id, 'maple-oat-latte');
+  assert.equal(payload(await tools.callTool('get_seasonal_menu', { query: 'tea' })).drinks.length, 0);
+  assert.equal(elements['order-status'].textContent, '');
+});
+
+test('agent selection and human ordering share visible state and clear behavior', async () => {
+  const { tools, elements, cards, buttons } = setup();
+  await tools.callTool('select_drink', { drinkId: 'cold-brew' });
+  assert.equal(elements['order-drink'].value, 'cold-brew');
+  assert.equal(cards[2].classList.selected, true);
+  assert.equal(elements['order-panel'].scrolled, true);
+  assert.equal(elements['order-items'].children.length, 0);
+  const added = payload(await tools.callTool('order_drink', { drinkId: 'cold-brew', quantity: 2 }));
+  assert.equal(added.orders[0].quantity, 2);
+  assert.equal(elements['order-items'].children[0].textContent, '2 × Cold Brew');
+  buttons[0].listeners.click();
+  elements['order-quantity'].value = '3';
+  elements['order-form'].listeners.submit({ preventDefault() {} });
+  assert.equal(elements['order-items'].children[1].textContent, '3 × Maple Oat Latte');
+  elements['clear-order'].listeners.click();
+  assert.equal(elements['order-items'].children.length, 0);
+  const next = payload(await tools.callTool('order_drink', { drinkId: 'dark-roast-espresso' }));
+  assert.equal(next.orders.length, 1);
+  assert.equal(next.orders[0].quantity, 1);
+});
+
+test('invalid tool arguments return actionable errors without changing order or selection', async () => {
+  const { tools, elements } = setup();
+  for (const args of [null, [], {}, { drinkId: 'tea' }, { drinkId: 'cold-brew', quantity: 0 }, { drinkId: 'cold-brew', quantity: 11 }, { drinkId: 'cold-brew', quantity: 1.5 }, { drinkId: 'cold-brew', quantity: '2' }, { drinkId: 'cold-brew', extra: true }]) {
+    const response = await tools.callTool('order_drink', args);
+    assert.equal(response.isError, true);
+    assert.equal(typeof payload(response).error, 'string');
+  }
+  assert.equal((await tools.callTool('get_seasonal_menu', { query: 42 })).isError, true);
+  assert.equal((await tools.callTool('select_drink', { drinkId: 'tea' })).isError, true);
+  assert.equal((await tools.callTool('missing')).isError, true);
+  assert.equal(elements['order-items'].children.length, 0);
+  assert.equal(elements['order-drink'].value, '');
+});
