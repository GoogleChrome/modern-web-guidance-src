index 0000000..74d5d15
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,78 @@
+import { createMenuTools } from './menu-tools.mjs';
+
+const cards = [...document.querySelectorAll('[data-drink-id]')];
+// Read the displayed menu so agents and visitors always see the same drinks.
+const menu = cards.map((card) => ({
+  id: card.dataset.drinkId,
+  name: card.querySelector('h3').textContent.trim(),
+  description: card.querySelector('p').textContent.trim(),
+}));
+const status = document.querySelector('#drink-status');
+const summary = document.querySelector('.order-summary');
+const orderItems = document.querySelector('#order-items');
+const order = new Map();
+
+function renderOrder() {
+  orderItems.replaceChildren(...[...order.values()].map((item) => {
+    const row = document.createElement('li');
+    row.textContent = `${item.quantity} × ${item.name}`;
+    return row;
+  }));
+  summary.hidden = order.size === 0;
+}
+
+const tools = createMenuTools(menu, {
+  order(drink, quantity) {
+    const previous = order.get(drink.id)?.quantity ?? 0;
+    order.set(drink.id, { ...drink, quantity: previous + quantity });
+    renderOrder();
+    status.textContent = `Added ${quantity} × ${drink.name} to your local order.`;
+    return { status: 'added', localOnly: true, items: [...order.values()].map((item) => ({ ...item })) };
+  },
+  highlight(drink) {
+    for (const card of cards) card.classList.toggle('is-highlighted', card.dataset.drinkId === drink.id);
+    const card = cards.find((card) => card.dataset.drinkId === drink.id);
+    card.scrollIntoView({ block: 'center', behavior: 'instant' });
+    card.focus({ preventScroll: true });
+    status.textContent = `${drink.name}: ${drink.description}`;
+    return { status: 'highlighted', drink: { ...drink } };
+  },
+});
+
+const orderTool = tools.find((tool) => tool.name === 'order_drink');
+for (const card of cards) {
+  const button = card.querySelector('.order-drink');
+  button.hidden = false;
+  button.addEventListener('click', () => orderTool.execute({ drinkId: card.dataset.drinkId }));
+}
+document.querySelector('#clear-order').addEventListener('click', () => {
+  order.clear();
+  renderOrder();
+  status.textContent = 'Your local order has been cleared.';
+});
+
+// WebMCP is progressive enhancement; ordinary controls work without it.
+let registration;
+async function registerTools() {
+  const context = document.modelContext;
+  if (typeof context?.registerTool !== 'function' || registration) return;
+  const controller = new AbortController();
+  registration = controller;
+  try {
+    for (const tool of tools) {
+      if (controller.signal.aborted) return;
+      await context.registerTool(tool, { signal: controller.signal });
+    }
+  } catch (error) {
+    controller.abort();
+    if (registration === controller) registration = undefined;
+    console.warn('Daily Grind browser tools could not be registered.', error);
+  }
+}
+
+window.addEventListener('pagehide', () => {
+  registration?.abort();
+  registration = undefined;
+});
+window.addEventListener('pageshow', () => { void registerTools(); });
+void registerTools();
