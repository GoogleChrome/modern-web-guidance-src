diff --git a/menu-tools.mjs b/menu-tools.mjs
new file mode 100644
index 0000000..fb38ee1
--- /dev/null
+++ b/menu-tools.mjs
@@ -0,0 +1,72 @@
+// Tool callbacks and page controls share the same validated actions.
+export function createMenuTools(menu, actions) {
+  const drinkIds = menu.map((drink) => drink.id);
+  const drinkProperty = {
+    type: 'string', enum: drinkIds,
+    description: 'The drink identifier returned by the seasonal menu.',
+  };
+  const error = (message) => ({ error: message, availableDrinkIds: drinkIds });
+  const validObject = (input, keys) => input !== null && typeof input === 'object'
+    && !Array.isArray(input) && Object.keys(input).every((key) => keys.includes(key));
+  const findDrink = (input) => menu.find((drink) => drink.id === input.drinkId);
+
+  return [
+    {
+      name: 'query_seasonal_menu',
+      description: 'Find drinks in the Daily Grind Seasonal Favorites menu, including descriptions and identifiers for ordering.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          query: { type: 'string', default: '', description: 'Words to match against a drink name or description.' },
+        },
+      },
+      execute(input = {}) {
+        if (!validObject(input, ['query']) || (input.query !== undefined && typeof input.query !== 'string')) {
+          return error('Provide an object with an optional text query.');
+        }
+        const query = (input.query ?? '').trim().toLowerCase();
+        const drinks = menu.filter((drink) => `${drink.name} ${drink.description}`.toLowerCase().includes(query));
+        return { section: 'Seasonal Favorites', drinks: drinks.map((drink) => ({ ...drink })), count: drinks.length };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible local order on this page. This does not send an order to a café or take payment.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          drinkId: drinkProperty,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add to the local order.' },
+        },
+        required: ['drinkId'],
+      },
+      execute(input = {}) {
+        if (!validObject(input, ['drinkId', 'quantity'])) return error('Provide a drink identifier and optional quantity.');
+        const drink = findDrink(input);
+        if (!drink) return error('Choose a drink from the seasonal menu.');
+        const quantity = input.quantity === undefined ? 1 : input.quantity;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          return error('Quantity must be an integer from 1 to 10.');
+        }
+        return actions.order(drink, quantity);
+      },
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight a seasonal drink card and bring it into view to show the user a recommendation.',
+      inputSchema: {
+        type: 'object', additionalProperties: false,
+        properties: { drinkId: drinkProperty }, required: ['drinkId'],
+      },
+      execute(input = {}) {
+        if (!validObject(input, ['drinkId'])) return error('Provide a drink identifier.');
+        const drink = findDrink(input);
+        if (!drink) return error('Choose a drink from the seasonal menu.');
+        return actions.highlight(drink);
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+}
diff --git a/menu-tools.test.mjs b/menu-tools.test.mjs
new file mode 100644
index 0000000..c751d48
--- /dev/null
+++ b/menu-tools.test.mjs
@@ -0,0 +1,74 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createMenuTools } from './menu-tools.mjs';
+
+// Use the real displayed menu to catch drift between the page and tool schemas.
+const html = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+const menu = [...html.matchAll(/data-drink-id="([^"]+)"[^>]*>\s*<h3>([^<]+)<\/h3>\s*<p>([^<]+)<\/p>/g)]
+  .map(([, id, name, description]) => ({ id, name, description }));
+
+function setup() {
+  const calls = [];
+  const tools = createMenuTools(menu, {
+    order: (drink, quantity) => { calls.push({ drink, quantity }); return { status: 'added' }; },
+    highlight: (drink) => { calls.push({ drink }); return { status: 'highlighted' }; },
+  });
+  return { calls, tools, get: (name) => tools.find((tool) => tool.name === name) };
+}
+
+test('menu query returns actual displayed drinks and filters without changing state', () => {
+  const { get, calls } = setup();
+  const tool = get('query_seasonal_menu');
+  assert.equal(tool.annotations.readOnlyHint, true);
+  assert.equal(tool.execute().count, 3);
+  assert.deepEqual(tool.execute({ query: ' MAPLE ' }).drinks, [menu[0]]);
+  assert.deepEqual(tool.execute({ query: '18 hours' }).drinks, [menu[2]]);
+  assert.equal(tool.execute({ query: 'missing' }).count, 0);
+  const result = tool.execute();
+  result.drinks[0].name = 'Changed';
+  assert.equal(tool.execute().drinks[0].name, 'Maple Oat Latte');
+  assert.deepEqual(calls, []);
+});
+
+test('ordering validates inputs before calling the shared action and applies defaults', () => {
+  const { get, calls } = setup();
+  const tool = get('order_drink');
+  for (const input of [null, [], 'coffee', {}, { drinkId: 'missing' },
+    ...[0, -1, 11, 1.5, '2', null, NaN].map((quantity) => ({ drinkId: menu[0].id, quantity })),
+    { drinkId: menu[0].id, extra: true }]) {
+    assert.ok(tool.execute(input).error);
+  }
+  assert.equal(calls.length, 0);
+  assert.deepEqual(tool.execute({ drinkId: menu[0].id }), { status: 'added' });
+  assert.equal(calls[0].quantity, 1);
+  tool.execute({ drinkId: menu[2].id, quantity: 10 });
+  assert.deepEqual(calls[1], { drink: menu[2], quantity: 10 });
+});
+
+test('highlight only changes UI for a valid menu drink', () => {
+  const { get, calls } = setup();
+  const tool = get('highlight_drink');
+  for (const input of [null, [], {}, { drinkId: 'unknown' }, { drinkId: menu[0].id, extra: true }]) {
+    assert.ok(tool.execute(input).error);
+  }
+  assert.equal(calls.length, 0);
+  assert.deepEqual(tool.execute({ drinkId: menu[1].id }), { status: 'highlighted' });
+  assert.equal(calls[0].drink, menu[1]);
+});
+
+test('all tools publish distinct names, typed schemas, and matching drink identifiers', () => {
+  const { tools } = setup();
+  assert.equal(new Set(tools.map((tool) => tool.name)).size, 3);
+  for (const tool of tools) {
+    assert.equal(tool.inputSchema.type, 'object');
+    assert.equal(tool.inputSchema.additionalProperties, false);
+    if (tool.inputSchema.properties.drinkId) {
+      assert.deepEqual(tool.inputSchema.properties.drinkId.enum, menu.map((drink) => drink.id));
+      assert.equal(tool.annotations.readOnlyHint, false);
+    }
+  }
+  for (const input of [null, [], { query: 1 }, { unexpected: true }]) {
+    assert.ok(tools[0].execute(input).error);
+  }
+});
