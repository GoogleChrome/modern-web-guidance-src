+import type { FormEvent } from 'react';
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJson(path: string, init: RequestInit = {}) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, init);
+  const text = await response.text();
+  init.signal?.throwIfAborted();
+  let data;
+  try { data = JSON.parse(text); } catch { data = null; }
+  if (!response.ok) {
+    throw new Error(data?.message || data?.error || `Request failed (HTTP ${response.status}).`);
+  }
+  if (data === null) throw new Error('The server returned an invalid JSON response.');
+  return data;
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleResult(article: Article) {
+  return { ...article, url: `${import.meta.env.BASE_URL}articles/${encodeURIComponent(article.slug)}` };
+}
+
+// Call respondWith synchronously during submission; the promise includes UI updates.
+export function respondToAgent(event: FormEvent<HTMLFormElement>, result: Promise<unknown>) {
+  const nativeEvent = event.nativeEvent as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<string>) => void;
+  };
+  if (nativeEvent.agentInvoked && typeof nativeEvent.respondWith === 'function') {
+    nativeEvent.respondWith(result.then(value => JSON.stringify(value)));
+  }
+}
+
+export function errorResult(error: unknown) {
+  return { error: error instanceof Error ? error.message : String(error) };
+}
+
+export function announceReadingList(readingList: string[]) {
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: readingList }));
+}
