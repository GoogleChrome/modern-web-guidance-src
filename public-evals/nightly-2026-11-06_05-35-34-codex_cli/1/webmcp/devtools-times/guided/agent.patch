--- /dev/null
+++ b/tests/browser-actions.test.mjs
@@ -0,0 +1,67 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+// Exercise the client module without loading Astro or its server entrypoint.
+// Vite normally substitutes BASE_URL during compilation.
+const source = (await readFile(new URL('../src/lib/browser-actions.ts', import.meta.url), 'utf8'))
+  .replaceAll('import.meta.env.BASE_URL', JSON.stringify('/devtools-times/'));
+const actions = await import('data:text/javascript;base64,' +
+  Buffer.from(stripTypeScriptTypes(source)).toString('base64'));
+const originalFetch = globalThis.fetch;
+afterEach(() => { globalThis.fetch = originalFetch; });
+
+const articles = [
+  { slug: 'coffee', title: 'Coffee Alchemy', summary: 'Brewing around the world' },
+  { slug: 'coast', title: 'Coastal Pulse', summary: 'Tides and beaches' },
+];
+
+test('search matches titles and summaries, ignores case and surrounding whitespace', () => {
+  assert.deepEqual(actions.searchArticles(articles, ' COFFEE '), [articles[0]]);
+  assert.deepEqual(actions.searchArticles(articles, 'beaches'), [articles[1]]);
+  assert.deepEqual(actions.searchArticles(articles, 'unmatched'), []);
+  assert.deepEqual(actions.searchArticles(articles, '  '), []);
+  assert.equal(actions.articleResult(articles[0]).url, '/devtools-times/articles/coffee');
+});
+
+test('API requests preserve the deployment base and cancellation signal', async () => {
+  const controller = new AbortController();
+  globalThis.fetch = async (url, init) => {
+    assert.equal(url, '/devtools-times/api/articles.json');
+    assert.equal(init.signal, controller.signal);
+    return Response.json(articles);
+  };
+  assert.deepEqual(await actions.requestJson('articles.json', { signal: controller.signal }), articles);
+});
+
+test('API failures retain actionable messages and handle non-JSON responses', async () => {
+  globalThis.fetch = async () => Response.json({ message: 'Coffee machine is broken' }, { status: 500 });
+  await assert.rejects(actions.requestJson('coffee-brew'), /Coffee machine is broken/);
+  globalThis.fetch = async () => new Response('Not found', { status: 404 });
+  await assert.rejects(actions.requestJson('tide-levels'), /HTTP 404/);
+  globalThis.fetch = async () => new Response('<html>unexpected response</html>');
+  await assert.rejects(actions.requestJson('articles.json'), /invalid JSON/);
+});
+
+test('cancellation during response processing does not return stale results', async () => {
+  const controller = new AbortController();
+  globalThis.fetch = async () => ({
+    ok: true,
+    text: async () => { controller.abort(); return '[]'; },
+  });
+  await assert.rejects(actions.requestJson('articles.json', { signal: controller.signal }), { name: 'AbortError' });
+});
+
+test('agent response is attached synchronously and waits for action completion', async () => {
+  let received;
+  let complete;
+  const result = new Promise(resolve => { complete = resolve; });
+  actions.respondToAgent({ nativeEvent: {
+    agentInvoked: true, respondWith: promise => { received = promise; },
+  } }, result);
+  assert.ok(received instanceof Promise);
+  complete({ saved: true });
+  assert.deepEqual(JSON.parse(await received), { saved: true });
+  actions.respondToAgent({ nativeEvent: {} }, Promise.resolve({ saved: true }));
+});
