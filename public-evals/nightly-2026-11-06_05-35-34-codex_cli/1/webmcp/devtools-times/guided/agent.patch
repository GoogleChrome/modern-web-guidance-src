diff --git a/src/components/BrowserTools.tsx b/src/components/BrowserTools.tsx
new file mode 100644
index 0000000..2282433
--- /dev/null
+++ b/src/components/BrowserTools.tsx
@@ -0,0 +1,93 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { articleResult, errorResult, requestJson, searchArticles, type Article } from '../lib/browser-actions';
+
+// One component per utility keeps hook calls unconditional and lifecycle managed.
+function UtilityTool({ name, description, path, needsId = false }: {
+  name: string; description: string; path: string; needsId?: boolean;
+}) {
+  useWebMCP({
+    name, description,
+    inputSchema: {
+      type: 'object',
+      properties: needsId ? { id: { type: 'string', description: 'The article slug to retrieve popularity for.' } } : {},
+      required: needsId ? ['id'] : [],
+      additionalProperties: false,
+    },
+    async execute(input: { id?: string }, { signal }) {
+      if (needsId && (typeof input.id !== 'string' || !input.id.trim())) {
+        return { error: 'Supply a nonempty article id.' };
+      }
+      try {
+        return await requestJson(path + (needsId ? `?id=${encodeURIComponent(input.id!.trim())}` : ''), { signal });
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  return null;
+}
+
+export default function BrowserTools() {
+  useWebMCP({
+    name: 'search_articles',
+    description: 'Find articles in The DevTools Times by words in their title or summary.',
+    inputSchema: {
+      type: 'object',
+      properties: { query: { type: 'string', minLength: 1, description: 'Words to find in article titles and summaries.' } },
+      required: ['query'], additionalProperties: false,
+    },
+    async execute({ query }: { query: string }, { signal }) {
+      if (typeof query !== 'string' || !query.trim()) return { error: 'Supply a nonempty search query.' };
+      try {
+        const articles: Article[] = await requestJson('articles.json', { signal });
+        return { articles: searchArticles(articles, query).map(articleResult) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_reading_list',
+    description: 'Retrieve articles saved in the current visitor’s reading list.',
+    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+    async execute(_input, { signal }) {
+      try {
+        const [articles, { readingList }]: [Article[], { readingList: string[] }] = await Promise.all([
+          requestJson('articles.json', { signal }), requestJson('reading-list.json', { signal }),
+        ]);
+        return { articles: articles.filter(article => readingList.includes(article.slug)).map(articleResult) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return errorResult(error);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_current_article',
+    description: 'Read the article currently displayed, including its title, summary, and body.',
+    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+    execute() {
+      const article = document.querySelector('[data-article-slug]');
+      if (!article) return { error: 'Open an article page first.' };
+      return {
+        slug: article.getAttribute('data-article-slug'),
+        title: article.querySelector('h1')?.textContent?.trim(),
+        summary: article.querySelector('[data-article-summary]')?.textContent?.trim(),
+        body: article.querySelector('[data-article-body]')?.textContent?.trim(),
+        url: location.href,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+  return <>
+    <UtilityTool name="get_coffee_brew" description="Retrieve coffee brewing data for the coffee article." path="coffee-brew" />
+    <UtilityTool name="get_tide_levels" description="Retrieve tide levels for the coastal article." path="tide-levels" />
+    <UtilityTool name="get_plant_stats" description="Retrieve plant statistics for the plants article." path="plant-stats" />
+    <UtilityTool name="get_article_popularity" description="Retrieve article views and trending status." path="article-popularity" needsId />
+  </>;
+}
