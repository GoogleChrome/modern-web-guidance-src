diff --git a/tests/browser-tools.test.mjs b/tests/browser-tools.test.mjs
new file mode 100644
index 0000000..d1fae89
--- /dev/null
+++ b/tests/browser-tools.test.mjs
@@ -0,0 +1,113 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+// Load only client helpers, with Astro's build-time base URL substituted.
+async function loadClient(path) {
+  const source = (await readFile(new URL(path, import.meta.url), 'utf8'))
+    .replaceAll('import.meta.env.BASE_URL', JSON.stringify('/devtools-times/'));
+  return import(`data:text/javascript;base64,${Buffer.from(stripTypeScriptTypes(source)).toString('base64')}`);
+}
+const api = await loadClient('../src/lib/articles.ts');
+const webmcp = await loadClient('../src/lib/webmcp.ts');
+const articles = [
+  { slug: 'coffee', title: 'Coffee Alchemy', summary: 'Roasted beans' },
+  { slug: 'plants', title: 'Silent Architects', summary: 'Plants and earth' },
+];
+
+test('search matches title and summary, trims whitespace and handles no matches', () => {
+  assert.deepEqual(api.searchArticles(articles, ' COFFEE '), [articles[0]]);
+  assert.deepEqual(api.searchArticles(articles, 'EARTH'), [articles[1]]);
+  assert.deepEqual(api.searchArticles(articles, 'missing'), []);
+  assert.deepEqual(api.searchArticles(articles, '  '), []);
+  assert.equal(api.articleUrl('a/b'), '/devtools-times/articles/a%2Fb');
+});
+
+test('reading-list actions are idempotent, serialized, validated and notify the UI', async () => {
+  const originalFetch = globalThis.fetch;
+  let slugs = [];
+  let writes = 0;
+  const events = [];
+  globalThis.window = { dispatchEvent: event => events.push(event.detail) };
+  globalThis.fetch = async (url, options) => {
+    assert.ok(url.startsWith('/devtools-times/api/'));
+    if (url.endsWith('articles.json')) return Response.json(articles);
+    if (options?.method === 'POST') {
+      writes++;
+      const { slug } = JSON.parse(options.body);
+      slugs = slugs.includes(slug) ? slugs.filter(item => item !== slug) : [...slugs, slug];
+    }
+    return Response.json({ readingList: slugs });
+  };
+  try {
+    const results = await Promise.all([api.updateReadingList('coffee', 'add'), api.updateReadingList('coffee', 'add')]);
+    assert.deepEqual(results, [['coffee'], ['coffee']]);
+    assert.equal(writes, 1);
+    await api.updateReadingList('coffee', 'remove');
+    await api.updateReadingList('coffee', 'remove');
+    assert.equal(writes, 2);
+    await assert.rejects(api.updateReadingList('missing', 'add'), /not found/);
+    await assert.rejects(api.updateReadingList('coffee', 'toggle'), /add or remove/);
+    assert.deepEqual(await api.updateReadingList('plants', 'add'), ['plants']);
+    assert.deepEqual(events.at(-1), ['plants']);
+    globalThis.fetch = async () => new Response(null, { status: 500 });
+    await assert.rejects(api.getArticles(), /500/);
+  } finally {
+    globalThis.fetch = originalFetch;
+    delete globalThis.window;
+  }
+});
+
+test('WebMCP detection degrades gracefully and supports document and navigator implementations', () => {
+  globalThis.document = {};
+  assert.equal(webmcp.modelContext(), undefined);
+  const context = { registerTool() {} };
+  Object.defineProperty(navigator, 'modelContext', { configurable: true, value: context });
+  assert.equal(webmcp.modelContext(), context);
+  document.modelContext = { registerTool() {} };
+  assert.equal(webmcp.modelContext(), document.modelContext);
+  delete navigator.modelContext;
+  delete globalThis.document;
+});
+
+test('agent form submission returns its result through the native submit event', async () => {
+  let received;
+  const result = Promise.resolve({ articles });
+  webmcp.respondToAgent({ agentInvoked: true, respondWith: promise => { received = promise; } }, result);
+  assert.deepEqual(await received, { articles });
+  assert.doesNotThrow(() => webmcp.respondToAgent({}, result));
+});
+
+test('site-wide tools register once and use the current page after navigation', async () => {
+  const source = await readFile(new URL('../src/components/BrowserTools.astro', import.meta.url), 'utf8');
+  const script = stripTypeScriptTypes(source.replace(/^<script>\s*/, '').replace(/\s*<\/script>\s*$/, '')
+    .replace(/^\s*import .*;$/gm, ''));
+  const tools = new Map();
+  const events = new Map();
+  let currentArticle = null;
+  const context = { registerTool: tool => tools.set(tool.name, tool), unregisterTool: name => tools.delete(name) };
+  const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+  const execute = new AsyncFunction('modelContext', 'getArticles', 'searchArticles', 'articleUrl', 'getReadingList', 'updateReadingList', 'document', 'window', 'location', script);
+  const doc = { querySelector: () => currentArticle };
+  const win = { addEventListener: (name, listener) => events.set(name, listener) };
+  const args = [async () => articles, api.searchArticles, api.articleUrl, async () => ['coffee'], async () => ['coffee'], doc, win, { href: 'https://example.test/devtools-times/articles/coffee' }];
+  await execute(() => undefined, ...args);
+  assert.equal(tools.size, 0);
+  await execute(() => context, ...args);
+  assert.equal(tools.size, 7);
+  assert.equal((await tools.get('search_articles').execute({ query: 'coffee' }))[0].slug, 'coffee');
+  assert.equal((await tools.get('get_reading_list').execute({}))[0].slug, 'coffee');
+  await assert.rejects(tools.get('get_current_article').execute({}), /Open an article/);
+  currentArticle = {
+    dataset: { articleSlug: 'coffee' },
+    querySelector: selector => selector === '[data-article-body]'
+      ? { cloneNode: () => ({ textContent: 'Article body', querySelectorAll: () => [] }) }
+      : { textContent: selector === 'h1' ? 'Coffee Alchemy' : 'Roasted beans' },
+  };
+  assert.equal((await tools.get('get_current_article').execute({})).text, 'Article body');
+  events.get('pagehide')({ persisted: true });
+  assert.equal(tools.size, 7);
+  events.get('pagehide')({ persisted: false });
+  assert.equal(tools.size, 0);
+});
