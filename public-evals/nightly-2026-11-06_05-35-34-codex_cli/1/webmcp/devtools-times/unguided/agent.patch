+
+export interface ModelContext {
+  registerTool: (tool: Tool) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+export function modelContext(): ModelContext | undefined {
+  // Support the original navigator API as well as the newer document API.
+  return (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+}
+
+export interface AgentSubmitEvent extends SubmitEvent {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+}
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submit = event as AgentSubmitEvent;
+  if (submit.agentInvoked && submit.respondWith) submit.respondWith(result);
+}
