diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..f7b5917
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,57 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const READING_LIST_CHANGED = 'reading-list-changed';
+const base = import.meta.env.BASE_URL;
+
+async function request<T>(path: string, options?: RequestInit): Promise<T> {
+  const response = await fetch(`${base}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status})`);
+  return response.json();
+}
+
+export function getArticles() {
+  return request<Article[]>('articles.json');
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleUrl(slug: string) {
+  return `${base}articles/${encodeURIComponent(slug)}`;
+}
+
+export async function getReadingList() {
+  return (await request<{ readingList: string[] }>('reading-list.json')).readingList;
+}
+
+// Serialize local changes so simultaneous UI and agent actions cannot toggle twice.
+let pendingChange = Promise.resolve();
+export function updateReadingList(slug: string, action: string): Promise<string[]> {
+  const change = pendingChange.then(async () => {
+    if (typeof slug !== 'string' || !slug.trim()) throw new Error('An article slug is required.');
+    if (action !== 'add' && action !== 'remove') throw new Error('Action must be add or remove.');
+    const articles = await getArticles();
+    if (!articles.some(article => article.slug === slug)) throw new Error('Article not found.');
+    let readingList = await getReadingList();
+    if (readingList.includes(slug) !== (action === 'add')) {
+      ({ readingList } = await request<{ readingList: string[] }>('reading-list.json', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug }),
+      }));
+    }
+    window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: readingList }));
+    return readingList;
+  });
+  pendingChange = change.then(() => {}, () => {});
+  return change;
+}
