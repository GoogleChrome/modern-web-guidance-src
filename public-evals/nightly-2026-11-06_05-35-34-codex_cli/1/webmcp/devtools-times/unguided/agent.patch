diff --git a/src/components/BrowserTools.astro b/src/components/BrowserTools.astro
new file mode 100644
index 0000000..7a8634c
--- /dev/null
+++ b/src/components/BrowserTools.astro
@@ -0,0 +1,90 @@
+<script>
+  import { getArticles, searchArticles, articleUrl, getReadingList, updateReadingList } from '../lib/articles';
+  import { modelContext, type Tool } from '../lib/webmcp';
+
+  async function waitForElement(selector: string): Promise<HTMLElement> {
+    const existing = document.querySelector<HTMLElement>(selector);
+    if (existing) return existing;
+    return new Promise((resolve, reject) => {
+      const observer = new MutationObserver(() => {
+        const element = document.querySelector<HTMLElement>(selector);
+        if (element) { observer.disconnect(); clearTimeout(timeout); resolve(element); }
+      });
+      const timeout = setTimeout(() => { observer.disconnect(); reject(new Error('The form could not be opened.')); }, 10000);
+      observer.observe(document.body, { subtree: true, childList: true, attributes: true });
+    });
+  }
+
+  const context = modelContext();
+  if (context?.registerTool) {
+    const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+    const slugSchema = { type: 'string', description: 'Exact article slug returned by list_articles or search_articles.' };
+    const tools: Tool[] = [
+      {
+        name: 'list_articles', description: 'List DevTools Times article titles, summaries, slugs and URLs.',
+        inputSchema: emptySchema, annotations: { readOnlyHint: true },
+        execute: async () => (await getArticles()).map(article => ({ ...article, url: articleUrl(article.slug) })),
+      },
+      {
+        name: 'search_articles', description: 'Search DevTools Times article titles and summaries, case insensitively.',
+        inputSchema: { type: 'object', properties: { query: { type: 'string', minLength: 1 } }, required: ['query'], additionalProperties: false },
+        annotations: { readOnlyHint: true },
+        execute: async ({ query }) => {
+          if (typeof query !== 'string' || !query.trim()) throw new Error('A search query is required.');
+          return searchArticles(await getArticles(), query).map(article => ({ ...article, url: articleUrl(article.slug) }));
+        },
+      },
+      {
+        name: 'get_current_article', description: 'Read the title, summary and body text of the article currently open. Available on article pages.',
+        inputSchema: emptySchema, annotations: { readOnlyHint: true },
+        execute: async () => {
+          const article = document.querySelector<HTMLElement>('article[data-article-slug]');
+          if (!article) throw new Error('Open an article page first.');
+          const body = article.querySelector('[data-article-body]')?.cloneNode(true) as HTMLElement | undefined;
+          body?.querySelectorAll('script, style, noscript').forEach(element => element.remove());
+          return { slug: article.dataset.articleSlug, title: article.querySelector('h1')?.textContent?.trim(),
+            summary: article.querySelector('[data-article-summary]')?.textContent?.trim(),
+            text: body?.textContent?.trim(), url: location.href };
+        },
+      },
+      {
+        name: 'get_reading_list', description: 'Get the current session’s saved articles.',
+        inputSchema: emptySchema, annotations: { readOnlyHint: true },
+        execute: async () => {
+          const [articles, slugs] = await Promise.all([getArticles(), getReadingList()]);
+          return articles.filter(article => slugs.includes(article.slug)).map(article => ({ ...article, url: articleUrl(article.slug) }));
+        },
+      },
+      {
+        name: 'update_reading_list', description: 'Add or remove an article in the current session’s reading list. Repeating an action leaves the same state.',
+        inputSchema: { type: 'object', properties: { slug: slugSchema, action: { type: 'string', enum: ['add', 'remove'] } }, required: ['slug', 'action'], additionalProperties: false },
+        annotations: { readOnlyHint: false },
+        execute: async ({ slug, action }) => ({ readingList: await updateReadingList(slug as string, action as string) }),
+      },
+      ...(['search', 'reading-list'] as const).map(kind => ({
+        name: kind === 'search' ? 'open_search' : 'open_reading_list',
+        description: `Open the ${kind} form to display its contents and expose its form tool.`,
+        inputSchema: emptySchema,
+        execute: async () => {
+          const button = await waitForElement(`[data-open-${kind}][data-tool-ready="true"]`);
+          button.click();
+          await waitForElement(`form[toolname="${kind === 'search' ? 'search_articles_form' : 'update_reading_list_form'}"]`);
+          return { opened: kind };
+        },
+      })),
+    ];
+    const registered: string[] = [];
+    // This script runs once per document. Callbacks read the current DOM after Astro swaps.
+    for (const tool of tools) {
+      try {
+        await context.registerTool(tool);
+        registered.push(tool.name);
+      } catch (error) {
+        console.warn(`Could not register browser tool ${tool.name}`, error);
+      }
+    }
+    window.addEventListener('pagehide', event => {
+      if (!event.persisted) registered.forEach(name => context.unregisterTool?.(name));
+    });
+  }
+</script>
