+  <script>
+    const signinForm = document.querySelector('#signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.querySelector('#signin-status');
+
+    async function promotePasskey() {
+      // Promotion is optional: every failure stays isolated from password sign-in.
+      try {
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // Older browsers may support conditional creation without the JSON helpers.
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+            typeof PublicKeyCredential.prototype.toJSON !== 'function') {
+          await import('./node_modules/webauthn-polyfills/esm/json_serialization.js');
+        }
+
+        // The authenticated server supplies the account, challenge, RP ID and
+        // excludeCredentials, and binds this ceremony to conditional creation.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(
+          await optionsResponse.json()
+        );
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const encodedResponse = credential.toJSON();
+        try {
+          // The backend must allow absent user presence only for this
+          // session-bound conditional ceremony, while verifying the challenge,
+          // origin and RP ID normally.
+          const verification = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ ...encodedResponse, conditional: true })
+          });
+          if (!verification.ok) throw new Error('Registration rejected');
+          const result = await verification.json().catch(() => null);
+          if (result?.verified === false || result?.success === false) {
+            throw new Error('Registration rejected');
+          }
+        } catch {
+          // Best-effort cleanup uses the server's RP ID, including parent domains.
+          if (publicKey.rp.id &&
+              typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      } catch {
+        // Unsupported providers, cancellation and network errors are all silent.
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+
+      try {
+        const response = await fetch('/api/login', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+        // /api/login establishes the session only after all required factors.
+        const result = await response.json();
+        if (result.mfaRequired || result.requiresMfa) {
+          signinStatus.textContent = 'Complete your additional sign-in verification.';
+          signinButton.disabled = false;
+          return;
+        }
+        if (result.success === false || result.authenticated === false) {
+          throw new Error('Sign-in failed');
+        }
+
+        signinForm.elements.password.value = '';
+        signinStatus.textContent = 'You are signed in.';
+        void promotePasskey();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Check your details and try again.';
+        signinButton.disabled = false;
+      }
+    });
+  </script>
