+      preview.style.setProperty('--preview-accent', event.source.dataset.accent);
+    });
+
+    preview.addEventListener('loseinterest', (event) => {
+      if (event.source !== activeSource) return;
+      activeSource = null;
+      preview.textContent = 'Select a drink to preview';
+      preview.style.removeProperty('--preview-accent');
+    });
