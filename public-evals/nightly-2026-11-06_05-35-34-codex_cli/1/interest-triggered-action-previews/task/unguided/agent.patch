+  <script type="module">
+    const preview = document.getElementById('seasonal-preview');
+    let activeSource = null;
+
+    // All invokers declare their target in HTML; only the shared target needs handlers.
+    preview.addEventListener('interest', (event) => {
+      activeSource = event.source;
+      preview.textContent = event.source.dataset.drink;
+      preview.style.setProperty('--preview-accent', event.source.dataset.accent);
+    });
+
+    preview.addEventListener('loseinterest', (event) => {
+      // A previous invoker must not clear a newer preview.
+      if (event.source !== activeSource) return;
+      activeSource = null;
+      preview.textContent = 'Select a drink to preview';
+      preview.style.removeProperty('--preview-accent');
+    });
+
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement')) {
+      await import('./vendor/interestfor-1.0.12.min.js');
+    }
+  </script>
