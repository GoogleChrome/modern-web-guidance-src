+import { randomBytes, randomUUID } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { OAuth2Client } from 'google-auth-library';
+
+export class HttpError extends Error {
+  constructor(status, message) { super(message); this.status = status; }
+}
+export function validateIdentity(payload, { clientId, nonce, email, now = Date.now() }) {
+  if (!payload || !['https://accounts.google.com', 'accounts.google.com'].includes(payload.iss)
+      || payload.aud !== clientId || !payload.exp || payload.exp * 1000 <= now
+      || typeof payload.sub !== 'string' || !payload.sub || payload.nonce !== nonce)
+    throw new HttpError(401, 'Verification expired or invalid. Please verify with Google again.');
+  if (payload.email_verified !== true || typeof payload.email !== 'string'
+      || !(payload.email.toLowerCase().endsWith('@gmail.com') || (typeof payload.hd === 'string' && payload.hd)))
+    throw new HttpError(400, 'Please use a Gmail or Google Workspace address so we can confirm ownership without an email.');
+  if (payload.email.toLowerCase() !== email.toLowerCase())
+    throw new HttpError(400, 'Your Google address does not match the email in the form. Update your email or choose the matching Google account.');
+  return { email: payload.email.toLowerCase(), subject: payload.sub };
+}
+export function openStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (
+      token TEXT PRIMARY KEY, expires INTEGER NOT NULL, email TEXT, subject TEXT, member TEXT, attempts INTEGER NOT NULL DEFAULT 0
+    );
+    CREATE TABLE IF NOT EXISTS members (
+      id TEXT PRIMARY KEY, subject TEXT NOT NULL UNIQUE, email TEXT NOT NULL UNIQUE,
+      first_name TEXT NOT NULL, last_name TEXT NOT NULL, marketing INTEGER NOT NULL,
+      terms_version TEXT NOT NULL, created_at TEXT NOT NULL
+    );`);
+  return db;
+}
+const json = (data, status = 200, cookie) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...(cookie ? { 'Set-Cookie': cookie } : {}) }
+});
+const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export function createApi({ db, clientId, origin, verifyToken, secure = true }) {
+  const google = new OAuth2Client(clientId);
+  const verify = verifyToken || (async credential => (await google.verifyIdToken({ idToken: credential, audience: clientId })).getPayload());
+  const cookieName = secure ? '__Host-dg_registration' : 'dg_registration';
+  const cookie = token => `${cookieName}=${token}; Path=/; HttpOnly; SameSite=Strict; Max-Age=600${secure ? '; Secure' : ''}`;
+  return async function api(request) {
+    try {
+      const url = new URL(request.url);
+      if (!['/api/auth/config', '/api/verify-email', '/api/rewards'].includes(url.pathname)) return json({ error: 'Not found.' }, 404);
+      if (request.method !== (url.pathname === '/api/auth/config' ? 'GET' : 'POST')) return json({ error: 'Method not allowed.' }, 405);
+      if (!clientId) return json({ error: 'Email verification is not available yet. Please try again later.' }, 503);
+      if (origin && url.origin !== origin) throw new HttpError(403, 'Invalid request origin.');
+      if (request.method === 'POST' && request.headers.get('origin') !== (origin || url.origin))
+        throw new HttpError(403, 'Please register from the Daily Grind website.');
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+      const token = request.headers.get('cookie')?.split(';').map(s => s.trim()).find(s => s.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+      let challenge = token && db.prepare('SELECT * FROM challenges WHERE token = ? AND expires > ?').get(token, Date.now());
+      if (url.pathname === '/api/auth/config') {
+        if (challenge && !challenge.member) db.prepare('DELETE FROM challenges WHERE token = ?').run(token);
+        const nonce = randomBytes(32).toString('hex');
+        db.prepare('INSERT INTO challenges (token, expires) VALUES (?, ?)').run(nonce, Date.now() + 600_000);
+        return json({ clientId, nonce }, 200, cookie(nonce));
+      }
+      if (!challenge || challenge.member) throw new HttpError(401, 'Your registration session expired. Refresh the page and try again.');
+      if (!request.headers.get('content-type')?.startsWith('application/json')) throw new HttpError(415, 'Expected JSON.');
+      const raw = await request.text();
+      if (Buffer.byteLength(raw) > 20_000) throw new HttpError(413, 'Request too large.');
+      let body;
+      try { body = JSON.parse(raw); } catch { throw new HttpError(400, 'Invalid request.'); }
+      if (!body || typeof body !== 'object' || Array.isArray(body)) throw new HttpError(400, 'Invalid request.');
+      if (typeof body.email !== 'string' || body.email.length > 254 || !emailPattern.test(body.email.trim())) throw new HttpError(400, 'Enter a valid email address.');
+      const email = body.email.trim().toLowerCase();
+      if (url.pathname === '/api/verify-email') {
+        // Never retain a previous verification after an unsuccessful re-verification.
+        db.prepare('UPDATE challenges SET email = NULL, subject = NULL, attempts = attempts + 1 WHERE token = ?').run(token);
+        if (challenge.attempts >= 10) throw new HttpError(429, 'Too many attempts. Refresh the page to start again.');
+        if (typeof body.credential !== 'string' || body.credential.length > 16_000) throw new HttpError(400, 'Please verify with Google.');
+        let payload;
+        try { payload = await verify(body.credential); } catch { throw new HttpError(401, 'We could not verify your Google account. Please try again.'); }
+        const identity = validateIdentity(payload, { clientId, nonce: token, email });
+        const updated = db.prepare('UPDATE challenges SET email = ?, subject = ? WHERE token = ? AND expires > ? AND member IS NULL').run(identity.email, identity.subject, token, Date.now());
+        if (!updated.changes) throw new HttpError(401, 'Your session expired. Refresh the page.');
+        return json({ verified: true, email: identity.email });
+      }
+      if (!challenge.email || challenge.email !== email || !challenge.subject) throw new HttpError(403, 'Verify this email with Google before creating your account.');
+      const firstName = typeof body.firstName === 'string' ? body.firstName.trim() : '';
+      const lastName = typeof body.lastName === 'string' ? body.lastName.trim() : '';
+      if (!firstName || !lastName || firstName.length > 60 || lastName.length > 60) throw new HttpError(400, 'Enter your first and last name (up to 60 characters each).');
+      if (body.terms !== true || typeof body.marketing !== 'boolean') throw new HttpError(400, 'Accept the Rewards Terms and Privacy Policy to continue.');
+      const existing = db.prepare('SELECT id FROM members WHERE email = ? OR subject = ?').get(email, challenge.subject);
+      if (existing) throw new HttpError(409, 'You already have a rewards account with this Google account.');
+      const id = `DG-${randomUUID()}`;
+      db.exec('BEGIN IMMEDIATE');
+      try {
+        db.prepare('INSERT INTO members VALUES (?, ?, ?, ?, ?, ?, ?, ?)').run(id, challenge.subject, email, firstName, lastName, Number(body.marketing), '2026-11-06', new Date().toISOString());
+        db.prepare('UPDATE challenges SET member = ? WHERE token = ?').run(id, token);
+        db.exec('COMMIT');
+      } catch (error) { db.exec('ROLLBACK'); throw error; }
+      return json({ memberId: id, firstName, email, verified: true }, 201);
+    } catch (error) {
+      if (!(error instanceof HttpError)) console.error('Rewards request failed:', error.name);
+      return json({ error: error instanceof HttpError ? error.message : 'Something went wrong. Please try again.' }, error.status || 500);
+    }
+  };
+}
