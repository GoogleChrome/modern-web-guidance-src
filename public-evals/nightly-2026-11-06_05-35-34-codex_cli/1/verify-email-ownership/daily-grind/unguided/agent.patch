@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createApi, openStore, validateIdentity } from './rewards.mjs';
+
+const origin = 'https://dailygrind.example';
+const clientId = 'test-client.apps.googleusercontent.com';
+const identity = nonce => ({ iss: 'https://accounts.google.com', aud: clientId, exp: Math.floor(Date.now() / 1000) + 300, sub: 'google-user-123', email: 'jamie@gmail.com', email_verified: true, nonce });
+
+test('identity checks reject untrusted claims and third-party Google email accounts', () => {
+  const options = { clientId, nonce: 'challenge', email: 'jamie@gmail.com' };
+  assert.equal(validateIdentity(identity('challenge'), options).email, options.email);
+  for (const change of [{ iss: 'evil.example' }, { aud: 'other-client' }, { exp: 1 }, { nonce: 'replayed' }, { email_verified: false }, { sub: '' }, { email: 'someone@gmail.com' }, { email: 'jamie@third-party.example' }]) {
+    assert.throws(() => validateIdentity({ ...identity('challenge'), ...change }, options));
+  }
+  assert.equal(validateIdentity({ ...identity('challenge'), email: 'jamie@workspace.example', hd: 'workspace.example' }, { ...options, email: 'jamie@workspace.example' }).email, 'jamie@workspace.example');
+});
+
+test('registration enforces server verification, consent, uniqueness, and persists a member', async () => {
+  const db = openStore(':memory:');
+  let claims; let rejectSignature = false;
+  const api = createApi({ db, clientId, origin, verifyToken: async () => { if (rejectSignature) throw new Error('Invalid signature'); return claims; } });
+  let cookie;
+  const request = async (path, body, headers = {}) => {
+    const res = await api(new Request(origin + path, { method: body ? 'POST' : 'GET', headers: { ...(cookie ? { cookie } : {}), origin, 'content-type': 'application/json', ...headers }, ...(body ? { body: JSON.stringify(body) } : {}) }));
+    return { status: res.status, data: await res.json(), cookie: res.headers.get('set-cookie') };
+  };
+  const registration = { firstName: 'Jamie', lastName: 'Morgan', email: 'jamie@gmail.com', terms: true, marketing: false };
+  assert.equal((await request('/api/rewards', registration)).status, 401);
+  const config = await request('/api/auth/config');
+  assert.equal(config.status, 200);
+  assert.match(config.cookie, /HttpOnly; SameSite=Strict; Max-Age=600; Secure/);
+  cookie = config.cookie.split(';')[0]; claims = identity(config.data.nonce);
+  assert.equal((await request('/api/rewards', registration)).status, 403);
+  assert.equal((await request('/api/verify-email', { credential: 'signed', email: registration.email }, { origin: 'https://evil.example' })).status, 403);
+  rejectSignature = true;
+  assert.equal((await request('/api/verify-email', { credential: 'forged', email: registration.email })).status, 401);
+  rejectSignature = false;
+  assert.equal((await request('/api/verify-email', { credential: 'signed', email: 'other@gmail.com' })).status, 400);
+  assert.equal((await request('/api/verify-email', { credential: 'signed', email: registration.email })).status, 200);
+  assert.equal((await request('/api/rewards', { ...registration, email: 'changed@gmail.com' })).status, 403);
+  assert.equal((await request('/api/rewards', { ...registration, terms: false })).status, 400);
+  const created = await request('/api/rewards', registration);
+  assert.equal(created.status, 201);
+  const member = db.prepare('SELECT * FROM members WHERE id = ?').get(created.data.memberId);
+  assert.equal(member.email, registration.email);
+  assert.equal(member.marketing, 0);
+  assert.equal(member.terms_version, '2026-11-06');
+  assert.equal((await request('/api/rewards', registration)).status, 401);
+  const fresh = await request('/api/auth/config');
+  cookie = fresh.cookie.split(';')[0]; claims = identity(fresh.data.nonce);
+  assert.equal((await request('/api/verify-email', { credential: 'signed', email: registration.email })).status, 200);
+  assert.equal((await request('/api/rewards', registration)).status, 409);
+  db.close();
+});
+
+test('expired sessions and replayed nonces fail closed; absent provider configuration is explicit', async () => {
+  const db = openStore(':memory:');
+  let claims;
+  const api = createApi({ db, clientId, origin, verifyToken: async () => claims });
+  const config = await api(new Request(origin + '/api/auth/config'));
+  const cookie = config.headers.get('set-cookie').split(';')[0];
+  claims = identity('a-different-browser-nonce');
+  const verify = () => api(new Request(origin + '/api/verify-email', { method: 'POST', headers: { origin, cookie, 'content-type': 'application/json' }, body: JSON.stringify({ credential: 'signed-but-replayed', email: 'jamie@gmail.com' }) }));
+  assert.equal((await verify()).status, 401);
+  db.prepare('UPDATE challenges SET expires = 0').run();
+  assert.equal((await verify()).status, 401);
+  const unavailable = createApi({ db, origin });
+  assert.equal((await unavailable(new Request(origin + '/api/auth/config'))).status, 503);
+  db.close();
+});
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..90b99e0
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,34 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { mkdirSync } from 'node:fs';
+import { createApi, openStore } from './rewards.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) throw new Error('Set APP_ORIGIN to your public HTTPS origin.');
+mkdirSync(new URL('./data/', import.meta.url), { recursive: true });
+const api = createApi({ db: openStore(process.env.DATABASE_PATH || new URL('./data/rewards.sqlite', import.meta.url).pathname), clientId: process.env.GOOGLE_CLIENT_ID, origin, secure: origin.startsWith('https://') });
+const files = new Map([['/', ['index.html', 'text/html; charset=utf-8']], ['/styles.css', ['styles.css', 'text/css; charset=utf-8']], ['/signup.js', ['signup.js', 'text/javascript; charset=utf-8']]]);
+createServer(async (req, res) => {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('X-Frame-Options', 'DENY');
+  try {
+    const path = new URL(req.url, origin).pathname;
+    if (path.startsWith('/api/')) {
+      let size = 0; const chunks = [];
+      for await (const chunk of req) {
+        size += chunk.length;
+        if (size > 20_000) { res.writeHead(413, { 'Content-Type': 'application/json' }); res.end(JSON.stringify({ error: 'Request too large.' })); return; }
+        chunks.push(chunk);
+      }
+      const response = await api(new Request(new URL(req.url, origin), { method: req.method, headers: req.headers, ...(!['GET', 'HEAD'].includes(req.method) ? { body: Buffer.concat(chunks) } : {}) }));
+      res.writeHead(response.status, Object.fromEntries(response.headers)); res.end(await response.text()); return;
+    }
+    const file = files.get(path);
+    if (!file) { res.writeHead(404); res.end('Not found'); return; }
+    if (!['GET', 'HEAD'].includes(req.method)) { res.writeHead(405); res.end('Method not allowed'); return; }
+    res.writeHead(200, { 'Content-Type': file[1], 'Cache-Control': 'no-cache' });
+    res.end(req.method === 'HEAD' ? undefined : await readFile(new URL(file[0], import.meta.url)));
+  } catch { res.writeHead(500); res.end('Unable to complete the request.'); }
+}).listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
diff --git a/signup.js b/signup.js
new file mode 100644
index 0000000..18f265c
--- /dev/null
+++ b/signup.js
@@ -0,0 +1,82 @@
+const form = document.querySelector('#signup-form');
+const email = form.elements.email;
+const verifyButton = document.querySelector('#verify-button');
+const verificationStatus = document.querySelector('#verification-status');
+const formStatus = document.querySelector('#form-status');
+const badge = document.querySelector('#verified-badge');
+let verifiedEmail = '';
+let verificationBusy = false;
+let googleReady = false;
+const normalize = () => email.value.trim().toLowerCase();
+function message(element, text, ok = false) { element.textContent = text; element.classList.toggle('ok', ok); }
+async function api(path, body) {
+  const response = await fetch(path, { method: body ? 'POST' : 'GET', credentials: 'same-origin', headers: body ? { 'Content-Type': 'application/json' } : {}, ...(body ? { body: JSON.stringify(body) } : {}) });
+  const contentType = response.headers.get('content-type') || '';
+  if (!contentType.includes('application/json')) throw new Error('Email verification is currently unavailable. Please try again later.');
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Please try again.');
+  return data;
+}
+email.addEventListener('input', () => {
+  if (normalize() !== verifiedEmail) { badge.hidden = true; verifiedEmail = ''; message(verificationStatus, ''); }
+});
+verifyButton.addEventListener('click', () => {
+  if (!email.reportValidity()) return;
+  message(verificationStatus, googleReady ? 'Choose your account using the Google button above.' : 'Email verification is currently unavailable. Please try again later.');
+});
+async function onGoogleCredential({ credential }) {
+  if (verificationBusy) return;
+  if (!email.reportValidity()) return;
+  verificationBusy = true;
+  const requestedEmail = normalize();
+  verifiedEmail = ''; badge.hidden = true;
+  message(verificationStatus, 'Confirming your email…', true);
+  try {
+    const data = await api('/api/verify-email', { credential, email: requestedEmail });
+    if (normalize() !== requestedEmail) throw new Error('Your email changed. Please verify the new address.');
+    verifiedEmail = data.email;
+    badge.hidden = false;
+    message(verificationStatus, 'Email confirmed. You’re ready to join.', true);
+  } catch (error) { message(verificationStatus, error.message); }
+  finally { verificationBusy = false; }
+}
+async function setupGoogle() {
+  try {
+    const config = await api('/api/auth/config');
+    await new Promise((resolve, reject) => {
+      const script = document.createElement('script');
+      script.src = 'https://accounts.google.com/gsi/client'; script.async = true;
+      script.onload = resolve; script.onerror = () => reject(new Error('Google could not load. Check your connection and refresh the page.'));
+      document.head.append(script);
+    });
+    google.accounts.id.initialize({ client_id: config.clientId, nonce: config.nonce, callback: onGoogleCredential, auto_select: false });
+    google.accounts.id.renderButton(document.querySelector('#google-button'), { theme: 'outline', size: 'large', text: 'continue_with', width: Math.min(360, document.querySelector('.verification').clientWidth - 34) });
+    googleReady = true; verifyButton.hidden = true;
+  } catch (error) { message(verificationStatus, error.message); }
+}
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!form.reportValidity()) return;
+  if (verificationBusy) { message(formStatus, 'Please wait while we confirm your email.'); return; }
+  if (!verifiedEmail || verifiedEmail !== normalize()) {
+    message(formStatus, 'Verify your email with Google first, then create your account.');
+    document.querySelector('.verification').scrollIntoView({ block: 'center' });
+    return;
+  }
+  const button = document.querySelector('#join-button');
+  button.disabled = true; message(formStatus, 'Creating your account…', true);
+  try {
+    const data = await api('/api/rewards', { firstName: form.elements.firstName.value, lastName: form.elements.lastName.value, email: normalize(), terms: form.elements.terms.checked, marketing: form.elements.marketing.checked });
+    document.querySelector('#member-name').textContent = data.firstName;
+    document.querySelector('#member-id').textContent = data.memberId;
+    form.hidden = true;
+    document.querySelector('.card-top').hidden = true;
+    document.querySelector('.signup-card > h2').hidden = true;
+    document.querySelector('.card-description').hidden = true;
+    const success = document.querySelector('#success'); success.hidden = false; success.focus();
+  } catch (error) { message(formStatus, error.message); }
+  finally { button.disabled = false; }
+});
+document.querySelectorAll('[data-dialog]').forEach(button => button.addEventListener('click', () => document.getElementById(button.dataset.dialog).showModal()));
+document.querySelectorAll('.close-dialog').forEach(button => button.addEventListener('click', () => button.closest('dialog').close()));
+setupGoogle();
