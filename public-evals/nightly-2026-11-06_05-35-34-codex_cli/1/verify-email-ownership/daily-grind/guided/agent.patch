+const form = document.querySelector('#rewards-form');
+const toggle = document.querySelector('#toggle-password');
+const password = document.querySelector('#password');
+if (toggle && password) {
+  toggle.hidden = false;
+  toggle.addEventListener('click', () => {
+    const visible = password.type === 'password';
+    password.type = visible ? 'text' : 'password';
+    toggle.textContent = visible ? 'Hide' : 'Show';
+    toggle.setAttribute('aria-pressed', String(visible));
+  });
+}
+// Preserve native form submission: the browser adds the email token at submission.
+// Reading FormData or replacing this with fetch could miss the browser-issued token.
+form?.addEventListener('submit', () => {
+  form.querySelector('[type="submit"]').disabled = true;
+  form.setAttribute('aria-busy', 'true');
+  document.querySelector('#form-progress').textContent = 'Securely confirming your email…';
+});
+window.addEventListener('pageshow', () => {
+  if (!form) return;
+  form.querySelector('[type="submit"]').disabled = false;
+  form.removeAttribute('aria-busy');
+  document.querySelector('#form-progress').textContent = '';
+});
