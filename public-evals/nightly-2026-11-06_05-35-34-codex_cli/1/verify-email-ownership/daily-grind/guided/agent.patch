+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { createApp } from '../lib/app.mjs';
+const template = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const origin = 'https://coffee.example';
+async function fresh(app) {
+  const res = await app.handle(new Request(origin));
+  const html = await res.text();
+  return { html, response: res, cookie: res.headers.get('set-cookie').split(';')[0], csrf: html.match(/name="csrf" value="([^"]+)"/)[1], nonce: html.match(/name="token" nonce="([^"]+)"/)[1] };
+}
+function submit(app, session, overrides = {}, headers = {}) {
+  return app.handle(new Request(`${origin}/api/verify-email`, { method: 'POST', headers: { origin, cookie: session.cookie, 'content-type': 'application/x-www-form-urlencoded', ...headers }, body: new URLSearchParams({ name: 'Avery', email: 'avery@example.com', password: 'a long coffee password', csrf: session.csrf, token: 'browser-token', ...overrides }) }));
+}
+test('fresh server-rendered nonce and secure cookie; no template markers remain', async () => {
+  const app = createApp({ template, origin, databasePath: ':memory:', trialToken: 'trial' });
+  try {
+    const a = await fresh(app), b = await fresh(app);
+    assert.notEqual(a.nonce, b.nonce);
+    assert.ok(a.nonce.length >= 43);
+    assert.match(a.response.headers.get('set-cookie'), /HttpOnly; SameSite=Lax; Path=\/; Max-Age=600; Secure/);
+    assert.equal(a.response.headers.get('cache-control'), 'no-store');
+    assert.equal(a.response.headers.get('origin-trial'), 'trial');
+    assert.doesNotMatch(a.html, /<!--(?:NONCE|CSRF|NAME|EMAIL|STATUS|SUCCESS)-->/);
+  } finally { app.close(); }
+});
+test('unsupported browsers get clear retry feedback, escaped values, and a consumed nonce', async () => {
+  let called = false;
+  const app = createApp({ template, origin, databasePath: ':memory:', verify: async () => { called = true; } });
+  try {
+    const session = await fresh(app);
