+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, randomBytes } from 'node:crypto';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { SDJwtInstance } from '@sd-jwt/core';
+import { verifyEmailVerificationToken, publicJson } from '../lib/verify-email.mjs';
+
+const issuer = 'https://issuer.example';
+const audience = 'https://coffee.example';
+const issuerKey = await generateKeyPair('ES256');
+const holderKey = await generateKeyPair('ES256');
+const issuerJwk = { ...await exportJWK(issuerKey.publicKey), alg: 'ES256' };
+const holderJwk = { ...await exportJWK(holderKey.publicKey), alg: 'ES256' };
+const otherKey = await generateKeyPair('ES256');
+const otherJwk = { ...await exportJWK(otherKey.publicKey), alg: 'ES256' };
+const hasher = (data) => createHash('sha256').update(data).digest();
+const dependencies = {
+  resolveTxt: async () => [['iss=issuer.example']],
+  getJson: async (url) => url.endsWith('/.well-known/email-verification')
+    ? { issuer, jwks_uri: `${issuer}/keys` } : { keys: [otherJwk, issuerJwk] },
+};
+async function presentation({ email = 'Member@example.com', email_verified = true, nonce = 'test-nonce', aud = audience, iat = Math.floor(Date.now() / 1000), sd_hash, holder = holderKey, kbAlg = 'ES256' } = {}) {
+  const jwt = await new SignJWT({ email, email_verified, cnf: { jwk: holderJwk } }).setProtectedHeader({ alg: 'ES256', typ: 'ev+sd-jwt' }).setIssuer(issuer).setIssuedAt(iat).setExpirationTime(iat + 300).sign(issuerKey.privateKey);
+  const sd = `${jwt}~`;
+  const binding = await new SignJWT({ nonce, aud, iat, sd_hash: sd_hash ?? hasher(sd).toString('base64url') }).setProtectedHeader({ alg: kbAlg, typ: 'kb+jwt' }).sign(holder.privateKey);
+  return sd + binding;
+}
+const verify = async (token, overrides = {}, deps = dependencies) => verifyEmailVerificationToken({ rawToken: token, submittedEmail: 'member@example.com', expectedNonce: 'test-nonce', expectedAudience: audience, ...overrides }, deps);
+
+test('valid browser presentation accepts case differences and tries all issuer keys without kid', async () => {
+  assert.equal((await verify(await presentation())).email_verified, true);
+});
+test('requires email_verified true and exact case-insensitive email match', async () => {
+  await assert.rejects(verify(await presentation({ email_verified: false })));
+  await assert.rejects(verify(await presentation({ email: 'attacker@example.com' })));
+});
+test('rejects wrong nonce, audience, hash, signing key and stale tokens', async () => {
+  for (const values of [{ nonce: 'wrong' }, { aud: 'https://other.example' }, { sd_hash: 'wrong' }, { holder: otherKey }, { iat: Math.floor(Date.now() / 1000) - 600 }]) await assert.rejects(verify(await presentation(values)));
+});
+test('rejects missing key binding and malformed token', async () => {
+  const token = await presentation();
+  await assert.rejects(verify(token.slice(0, token.lastIndexOf('~') + 1)));
+  await assert.rejects(verify('forged'));
+});
+test('checks domain delegation before metadata fetch', async () => {
+  let fetched = false;
+  await assert.rejects(verify(await presentation(), {}, { resolveTxt: async () => [['iss=attacker.example']], getJson: async () => { fetched = true; } }));
+  assert.equal(fetched, false);
+});
+test('rejects discovery issuer mismatch', async () => {
+  await assert.rejects(verify(await presentation(), {}, { ...dependencies, getJson: async () => ({ issuer: 'https://wrong.example', jwks_uri: `${issuer}/keys` }) }));
+});
+test('rejects non-HTTPS and private-network metadata requests', async () => {
+  for (const url of ['http://issuer.example', 'https://127.0.0.1/keys', 'https://[::1]/keys', 'https://user:password@issuer.example/keys']) await assert.rejects(publicJson(url));
+});
+test('accepts selectively disclosed email claims', async () => {
+  const sd = new SDJwtInstance({ hasher, hashAlg: 'sha-256', saltGenerator: () => randomBytes(16).toString('base64url'), signAlg: 'ES256', signer: async (data) => {
+    const [header, payload] = data.split('.');
+    return (await new SignJWT(JSON.parse(Buffer.from(payload, 'base64url'))).setProtectedHeader(JSON.parse(Buffer.from(header, 'base64url'))).sign(issuerKey.privateKey)).split('.')[2];
+  } });
+  const issued = await sd.issue({ iss: issuer, iat: Math.floor(Date.now() / 1000), email: 'member@example.com', email_verified: true, cnf: { jwk: holderJwk } }, { _sd: ['email', 'email_verified'] }, { header: { typ: 'ev+sd-jwt' } });
+  const kb = await new SignJWT({ nonce: 'test-nonce', aud: audience, iat: Math.floor(Date.now() / 1000), sd_hash: hasher(issued).toString('base64url') }).setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).sign(holderKey.privateKey);
+  assert.equal((await verify(issued + kb)).email, 'member@example.com');
+});
