index 0000000..5e740ee
--- /dev/null
+++ b/lib/app.mjs
@@ -0,0 +1,83 @@
+import { randomBytes, randomUUID, scrypt as scryptCallback } from 'node:crypto';
+import { promisify } from 'node:util';
+import { DatabaseSync } from 'node:sqlite';
+import { verifyEmailVerificationToken } from './verify-email.mjs';
+
+const scrypt = promisify(scryptCallback);
+const random = () => randomBytes(32).toString('base64url');
+const escape = (value) => String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+const ttl = 10 * 60 * 1000;
+
+export function createApp({ template, origin, databasePath = 'rewards.sqlite', trialToken = '', verify = verifyEmailVerificationToken }) {
+  const publicOrigin = new URL(origin).origin;
+  const secure = publicOrigin.startsWith('https:');
+  const cookieName = secure ? '__Host-dg_signup' : 'dg_signup';
+  const db = new DatabaseSync(databasePath);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, csrf TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, email_key TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, email_verified INTEGER NOT NULL, created_at TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+  function render(message = '', values = {}, status = 200, success = false) {
+    const now = Date.now();
+    db.prepare('DELETE FROM challenges WHERE expires < ?').run(now);
+    db.prepare('DELETE FROM limits WHERE expires < ?').run(now);
+    const id = random(), nonce = random(), csrf = random();
+    db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?)').run(id, nonce, csrf, now + ttl);
+    const html = template.replaceAll('<!--NONCE-->', nonce).replaceAll('<!--CSRF-->', csrf)
+      .replaceAll('<!--NAME-->', escape(values.name ?? '')).replaceAll('<!--EMAIL-->', escape(values.email ?? ''))
+      .replace('<!--STATUS-->', message ? `<p class="form-message ${success ? 'success' : 'error'}" role="${success ? 'status' : 'alert'}" tabindex="-1" autofocus>${escape(message)}</p>` : '')
+      .replace('<!--SUCCESS-->', success ? 'hidden' : '');
+    const headers = {
+      'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store',
+      'Set-Cookie': `${cookieName}=${id}; HttpOnly; SameSite=Lax; Path=/; Max-Age=600${secure ? '; Secure' : ''}`,
+      'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin',
+      'Content-Security-Policy': "default-src 'self'; img-src 'self' https://images.unsplash.com; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+    };
+    if (trialToken) headers['Origin-Trial'] = trialToken;
+    return new Response(html, { status, headers });
+  }
+  async function handle(request, clientAddress = 'unknown') {
+    const url = new URL(request.url);
+    if (request.method === 'GET' && url.pathname === '/') return render();
+    if (url.pathname !== '/api/verify-email') return new Response('Not found', { status: 404 });
+    if (request.method !== 'POST') return new Response('Method not allowed', { status: 405, headers: { Allow: 'POST' } });
+    // Origin is checked against configuration, never attacker-controlled Host headers.
+    if (request.headers.get('origin') !== publicOrigin) return render('Please return to the homepage and try again.', {}, 403);
+    const cookie = request.headers.get('cookie')?.split(';').map((part) => part.trim()).find((part) => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    // SQLite DELETE RETURNING atomically consumes the session challenge, even on failure.
+    const challenge = cookie ? db.prepare('DELETE FROM challenges WHERE id = ? RETURNING *').get(cookie) : null;
+    if (!challenge || challenge.expires < Date.now()) return render('Your sign-up session expired. Please try again with this fresh form.', {}, 400);
+    const limit = db.prepare(`INSERT INTO limits VALUES (?, 1, ?) ON CONFLICT(key) DO UPDATE SET count = count + 1 RETURNING count`).get(clientAddress, Date.now() + ttl);
+    if (limit.count > 15) return render('Too many attempts. Please try again in 10 minutes.', {}, 429);
+    const contentType = request.headers.get('content-type') ?? '';
+    if (!contentType.startsWith('application/x-www-form-urlencoded')) return render('Please use the sign-up form below.', {}, 415);
+    const body = await request.text();
+    if (Buffer.byteLength(body) > 65536) return render('That submission is too large. Please try again.', {}, 413);
+    const data = new URLSearchParams(body);
+    const name = (data.get('name') ?? '').trim();
+    const email = (data.get('email') ?? '').trim();
+    const password = data.get('password') ?? '';
+    const values = { name, email };
+    if (data.get('csrf') !== challenge.csrf) return render('Your form could not be confirmed. Please try again.', values, 403);
+    if (data.get('website')) return render('Your sign-up could not be completed.', {}, 400);
+    if (!name || name.length > 100 || email.length > 254 || !/^[^\s@<>]+@[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$/.test(email) || password.length < 12 || password.length > 128) return render('Please enter your name, a valid email, and a password of 12–128 characters.', values, 400);
+    const rawToken = data.get('token') ?? '';
+    if (!rawToken) return render('Your browser could not verify this email. Try a supported Chrome browser while signed in to your email provider. No account was created and no verification email was sent.', values, 422);
+    try {
+      await verify({ rawToken, submittedEmail: email, expectedNonce: challenge.nonce, expectedAudience: publicOrigin });
+    } catch {
+      // Never log credentials, raw tokens, or customer email addresses.
+      return render('We couldn’t confirm this email securely. Please check your email-provider session and try again. No verification email was sent.', values, 422);
+    }
+    const salt = randomBytes(16).toString('hex');
+    const hash = (await scrypt(password, salt, 64)).toString('hex');
+    try {
+      db.prepare('INSERT INTO accounts VALUES (?, ?, ?, ?, ?, 1, ?)').run(randomUUID(), name, email, email.toLowerCase(), `scrypt:${salt}:${hash}`, new Date().toISOString());
+    } catch (error) {
+      if (error.code?.startsWith('ERR_SQLITE') && error.message.includes('UNIQUE')) return render('An account with this email already exists. Your existing account has not changed.', values, 409);
+      throw error;
+    }
+    return render(`Welcome to Daily Grind Rewards, ${name}! Your email is verified and your account is ready. We’ll see you for your next cup.`, {}, 201, true);
+  }
+  return { handle, close: () => db.close() };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..1480edf
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,101 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt, lookup } from 'node:dns/promises';
+import { request } from 'node:https';
+import ipaddr from 'ipaddr.js';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const algorithms = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => alg === 'Ed25519' ? 'EdDSA' : alg;
+const hasher = (data, alg) => {
+  if (alg !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+
+// Resolve and pin public addresses before fetching untrusted issuer metadata.
+// Redirects are intentionally rejected, including redirects to private networks.
+export async function publicJson(address) {
+  const url = new URL(address);
+  if (url.protocol !== 'https:' || url.port || url.username || url.password || url.hash) throw new Error('Invalid issuer URL');
+  const addresses = await lookup(url.hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) throw new Error('Non-public issuer');
+  const pinned = addresses[0];
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      headers: { Accept: 'application/json' },
+      lookup: (_hostname, options, callback) => options.all
+        ? callback(null, [pinned]) : callback(null, pinned.address, pinned.family),
+    }, (res) => {
+      if (res.statusCode !== 200) { res.resume(); reject(new Error('Issuer discovery failed')); return; }
+      let size = 0;
+      const chunks = [];
+      res.on('data', (chunk) => {
+        size += chunk.length;
+        if (size > 128 * 1024) { res.destroy(new Error('Issuer response too large')); return; }
+        chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); } catch (error) { reject(error); }
+      });
+    });
+    const timeout = setTimeout(() => req.destroy(new Error('Issuer request timed out')), 5000);
+    req.on('close', () => clearTimeout(timeout));
+    req.on('error', reject);
+    req.end();
+  });
+}
+
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }, dependencies = {}) {
+  const txtLookup = dependencies.resolveTxt ?? resolveTxt;
+  const getJson = dependencies.getJson ?? publicJson;
+  if (!rawToken || rawToken.length > 32768 || !expectedNonce) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const payload = decoded.jwt?.payload;
+  const issuer = payload?.iss;
+  if (!decoded.kbJwt || typeof issuer !== 'string') throw new Error('Missing issuer or key binding');
+  const issuerUrl = new URL(issuer);
+  if (issuerUrl.protocol !== 'https:' || issuerUrl.origin !== issuer || issuerUrl.port || issuerUrl.username || issuerUrl.password) throw new Error('Invalid issuer');
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  const records = await txtLookup(`_email-verification.${domain}`);
+  if (!records.some((parts) => `https://${parts.join('').replace(/^iss=/, '').trim()}` === issuer && parts.join('').startsWith('iss='))) throw new Error('Issuer not delegated');
+  const metadata = await getJson(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid issuer metadata');
+  const jwks = await getJson(metadata.jwks_uri);
+  if (!Array.isArray(jwks.keys)) throw new Error('Invalid issuer keys');
+  const keys = createLocalJWKSet({ keys: jwks.keys.filter((key) => !key.d && (
+    (key.kty === 'EC' && key.crv === 'P-256') || (key.kty === 'OKP' && key.crv === 'Ed25519')
+  )) });
+  const options = { typ: 'ev+sd-jwt', issuer, algorithms, maxTokenAge: '5m', clockTolerance: 60 };
+  const instance = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compact = `${data}.${sig}`;
+      try { await jwtVerify(compact, keys, options); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let matched = false;
+        for await (const key of error) {
+          try { await jwtVerify(compact, key, options); matched = true; break; } catch { /* try next issuer key */ }
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const jwk = payload.cnf?.jwk;
+      const alg = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || !((jwk.kty === 'EC' && jwk.crv === 'P-256') || (jwk.kty === 'OKP' && jwk.crv === 'Ed25519')) || !algorithms.includes(jwk.alg) || !algorithms.includes(alg) || normalizeAlg(jwk.alg) !== normalizeAlg(alg)) throw new Error('Invalid holder key');
+      await jwtVerify(`${data}.${sig}`, await importJWK(jwk, alg), {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [alg], maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  const verified = await instance.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60,
+  });
+  if (verified.payload.email_verified !== true || typeof verified.payload.email !== 'string' || verified.payload.email.toLowerCase() !== submittedEmail.toLowerCase()) throw new Error('Email mismatch');
+  return verified.payload;
+}
