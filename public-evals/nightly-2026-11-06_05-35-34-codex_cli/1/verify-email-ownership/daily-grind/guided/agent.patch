+test('enforces CSRF, request origin, server input constraints and verified token', async () => {
+  const app = createApp({ template, origin, databasePath: ':memory:', verify: async () => { throw new Error('Invalid'); } });
+  try {
+    assert.equal((await submit(app, await fresh(app), {}, { origin: 'https://attacker.example' })).status, 403);
+    assert.equal((await submit(app, await fresh(app), { csrf: 'wrong' })).status, 403);
+    assert.equal((await submit(app, await fresh(app), { password: 'short' })).status, 400);
+    assert.equal((await submit(app, await fresh(app))).status, 422);
+  } finally { app.close(); }
+});
+test('persists verified accounts with salted hashes, blocks duplicates and replay', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'dg-test-'));
+  const path = join(dir, 'accounts.sqlite');
+  let expected;
+  const app = createApp({ template, origin, databasePath: path, verify: async (args) => {
+    assert.equal(args.expectedAudience, origin);
+    assert.equal(args.expectedNonce, expected);
+  } });
+  try {
+    const session = await fresh(app); expected = session.nonce;
+    assert.equal((await submit(app, session)).status, 201);
+    assert.equal((await submit(app, session)).status, 400);
+    const next = await fresh(app); expected = next.nonce;
+    assert.equal((await submit(app, next, { email: 'AVERY@example.com' })).status, 409);
+    const db = new DatabaseSync(path);
+    const rows = db.prepare('SELECT * FROM accounts').all();
+    assert.equal(rows.length, 1);
+    assert.equal(rows[0].email_verified, 1);
+    assert.match(rows[0].password_hash, /^scrypt:[a-f0-9]{32}:[a-f0-9]{128}$/);
+    assert.notEqual(rows[0].password_hash, 'a long coffee password');
+    db.close();
+  } finally { app.close(); rmSync(dir, { recursive: true, force: true }); }
+});
