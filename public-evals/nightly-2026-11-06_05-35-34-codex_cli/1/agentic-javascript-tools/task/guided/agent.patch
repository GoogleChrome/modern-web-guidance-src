diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,70 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      if (typeof document.modelContext?.registerTool !== 'function') return;
+
+      const tool = {
+        name: 'get_menu_item',
+        description: 'Look up a menu item and return its description and details link. Use when someone asks about a drink on the menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              description: 'The menu item name as written or spoken by the user; matching ignores capitalization and surrounding whitespace.',
+              minLength: 1
+            }
+          },
+          required: ['itemName'],
+          additionalProperties: false
+        },
+        execute(input) {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const name = input.itemName.trim().toLowerCase();
+          const item = items.find((entry) => entry.name.toLowerCase() === name);
+
+          return item ?? {
+            error: `Menu item "${input.itemName.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      let registration = null;
+
+      async function registerTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await document.modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = null;
+          if (!controller.signal.aborted) console.warn('Menu lookup tool registration failed.', error);
+        }
+      }
+
+      window.addEventListener('pagehide', () => {
+        registration?.abort();
+        registration = null;
+      });
+      window.addEventListener('pageshow', registerTool);
+      registerTool();
+    })();
+  </script>
+
 </body>
 
 </html>
