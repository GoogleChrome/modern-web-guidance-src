diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -174,9 +174,9 @@
     <a href="/order-online" class="btn">Order Now</a>
   </header>
 
   <main class="container">
-    <section>
+    <section id="menu-favorites">
       <h2 style="text-align: center;">Seasonal Favorites</h2>
       <div class="grid">
         <div class="card">
           <h3>Maple Oat Latte</h3>
@@ -206,7 +206,73 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const modelContext = document.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      let registrationController;
+
+      const menuItemTool = {
+        name: 'get_menu_item_details',
+        description: 'Look up a Daily Grind menu item and return its name, description, and details link. Use when someone asks about a drink on the menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              description: 'The menu item name, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew. Matching ignores capitalization and surrounding whitespace.',
+              minLength: 1
+            }
+          },
+          required: ['itemName'],
+          additionalProperties: false
+        },
+        execute(input) {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty menu item name in itemName.' };
+          }
+
+          const items = Array.from(document.querySelectorAll('#menu-favorites .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const requestedName = input.itemName.trim().toLowerCase();
+          const item = items.find((entry) => entry.name.toLowerCase() === requestedName);
+
+          return item ?? {
+            error: `Menu item "${input.itemName.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      async function registerMenuItemTool() {
+        if (registrationController && !registrationController.signal.aborted) return;
+
+        const controller = new AbortController();
+        registrationController = controller;
+        try {
+          await modelContext.registerTool(menuItemTool, { signal: controller.signal });
+        } catch (error) {
+          if (!controller.signal.aborted) {
+            controller.abort();
+            console.warn('Could not register the menu item lookup tool.', error);
+          }
+        }
+      }
+
+      // Aborting the registration signal removes the tool when leaving the page.
+      window.addEventListener('pagehide', () => registrationController?.abort());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuItemTool();
+      });
+      registerMenuItemTool();
+    })();
+  </script>
 </body>
 
 </html>
