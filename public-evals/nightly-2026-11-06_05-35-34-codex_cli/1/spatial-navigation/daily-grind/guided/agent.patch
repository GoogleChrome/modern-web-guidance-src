diff --git a/spatial-navigation.mjs b/spatial-navigation.mjs
new file mode 100644
index 0000000..1c68635
--- /dev/null
+++ b/spatial-navigation.mjs
@@ -0,0 +1,75 @@
+const directions = {
+  ArrowRight: { start: 'left', end: 'right', crossStart: 'top', crossEnd: 'bottom', sign: 1 },
+  ArrowLeft: { start: 'right', end: 'left', crossStart: 'top', crossEnd: 'bottom', sign: -1 },
+  ArrowDown: { start: 'top', end: 'bottom', crossStart: 'left', crossEnd: 'right', sign: 1 },
+  ArrowUp: { start: 'bottom', end: 'top', crossStart: 'left', crossEnd: 'right', sign: -1 },
+};
+
+function visibleItems(grid) {
+  return Array.from(grid.querySelectorAll('[data-spatial-item]')).filter(item => {
+    if (item.closest('[hidden], [inert], [aria-hidden="true"]') || item.matches(':disabled, [aria-disabled="true"]')) return false;
+    if (item.checkVisibility && !item.checkVisibility({ visibilityProperty: true, contentVisibilityAuto: true })) return false;
+    const rect = item.getBoundingClientRect();
+    return rect.width > 0 && rect.height > 0;
+  });
+}
+
+// Read fresh rectangles on each keypress: CSS reflow, ordering and direction can change.
+export function findSpatialTarget(current, items, key) {
+  const direction = directions[key];
+  if (!direction) return;
+  const { start, end, crossStart, crossEnd, sign } = direction;
+  const origin = current.getBoundingClientRect();
+  let best;
+
+  for (const item of items) {
+    if (item === current) continue;
+    const rect = item.getBoundingClientRect();
+    const gap = sign * (rect[start] - origin[end]);
+    if (gap < -1) continue; // Allow subpixel rounding at adjacent edges.
+    const aligned = Math.min(rect[crossEnd], origin[crossEnd]) > Math.max(rect[crossStart], origin[crossStart]);
+    const offset = Math.abs((rect[crossStart] + rect[crossEnd] - origin[crossStart] - origin[crossEnd]) / 2);
+    const score = Math.max(0, gap) + 2 * offset;
+    const candidate = { item, aligned, gap, offset, score };
+    if (!best || (aligned && !best.aligned) ||
+        (aligned === best.aligned && (aligned
+          ? gap < best.gap || (gap === best.gap && offset < best.offset)
+          : score < best.score))) best = candidate;
+  }
+  return best?.item;
+}
+
+export function initializeSpatialGrid(grid) {
+  // Enhance only after JS loads; without it all links retain normal Tab navigation.
+  grid.setAttribute('role', 'grid');
+  grid.setAttribute('aria-describedby', 'grid-help');
+  grid.querySelector('.grid').setAttribute('role', 'row');
+  for (const card of grid.querySelectorAll('.card')) card.setAttribute('role', 'gridcell');
+
+  function activate(item) {
+    for (const candidate of grid.querySelectorAll('[data-spatial-item]')) {
+      candidate.tabIndex = candidate === item ? 0 : -1;
+    }
+  }
+  activate(visibleItems(grid)[0]);
+
+  grid.addEventListener('focusin', event => {
+    const target = event.composedPath()[0];
+    if (visibleItems(grid).includes(target)) activate(target);
+  });
+
+  grid.addEventListener('keydown', event => {
+    if (!directions[event.key] || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.isComposing) return;
+    const target = event.composedPath()[0];
+    if (target.matches?.(':read-write, select, input, textarea, [role="slider"], [role="spinbutton"], [role="combobox"]')) return;
+    const items = visibleItems(grid);
+    // Nested controls keep their own keys; don't resolve a parent candidate.
+    if (!items.includes(target)) return;
+    const next = findSpatialTarget(target, items, event.key);
+    if (!next) return; // Preserve native viewport scrolling at the boundary.
+    event.preventDefault();
+    activate(next);
+    next.focus({ preventScroll: true });
+    next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  });
+}
diff --git a/spatial-navigation.test.mjs b/spatial-navigation.test.mjs
new file mode 100644
index 0000000..e9a0ce4
--- /dev/null
+++ b/spatial-navigation.test.mjs
@@ -0,0 +1,164 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { findSpatialTarget, initializeSpatialGrid } from './spatial-navigation.mjs';
+
+// DOM doubles keep these tests server-free; rectangles model CSS layout changes.
+function item(left, top, width = 100, height = 40) {
+  return {
+    rect: { left, top, right: left + width, bottom: top + height, width, height },
+    tabIndex: 0,
+    getBoundingClientRect() { return this.rect; },
+    closest() { return this.hiddenAncestor ? {} : null; },
+    matches(selector) { return selector.startsWith(':disabled') ? !!this.disabled : !!this.editable; },
+    checkVisibility() { return this.visible !== false; },
+    focus(options) { this.focusOptions = options; },
+    scrollIntoView(options) { this.scrollOptions = options; },
+  };
+}
+
+function widget(items) {
+  const handlers = {};
+  const attributes = {};
+  const row = { setAttribute(name, value) { this[name] = value; } };
+  const cards = items.map(() => ({ setAttribute(name, value) { this[name] = value; } }));
+  const grid = {
+    setAttribute(name, value) { attributes[name] = value; },
+    querySelector() { return row; },
+    querySelectorAll(selector) { return selector === '.card' ? cards : items; },
+    addEventListener(name, handler) { handlers[name] = handler; },
+  };
+  initializeSpatialGrid(grid);
+  return {
+    attributes, row, cards,
+    focus(target) { handlers.focusin({ composedPath: () => [target, grid] }); },
+    key(target, key, overrides = {}) {
+      const event = {
+        key, defaultPrevented: false,
+        composedPath: () => [target, grid],
+        preventDefault() { this.defaultPrevented = true; },
+        ...overrides,
+      };
+      handlers.keydown(event);
+      return event;
+    },
+  };
+}
+
+test('arrows follow two-dimensional geometry without wrapping at edges', () => {
+  const a = item(0, 0), b = item(120, 0), c = item(0, 60), d = item(120, 60);
+  const items = [a, b, c, d];
+  for (const [origin, key, expected] of [
+    [a, 'ArrowRight', b], [b, 'ArrowLeft', a],
+    [a, 'ArrowDown', c], [c, 'ArrowUp', a],
+    [b, 'ArrowDown', d], [d, 'ArrowUp', b],
+    [b, 'ArrowRight', undefined], [c, 'ArrowLeft', undefined],
+    [a, 'ArrowUp', undefined], [d, 'ArrowDown', undefined],
+  ]) assert.equal(findSpatialTarget(origin, items, key), expected);
+});
+
+test('uses fresh positions after reflow into a single column', () => {
+  const a = item(0, 0), b = item(120, 0), c = item(240, 0);
+  const items = [a, b, c];
+  assert.equal(findSpatialTarget(a, items, 'ArrowRight'), b);
+  b.rect = item(0, 60).rect;
+  c.rect = item(0, 120).rect;
+  assert.equal(findSpatialTarget(a, items, 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(a, items, 'ArrowDown'), b);
+  assert.equal(findSpatialTarget(c, items, 'ArrowUp'), b);
+});
+
+test('supports reversed visual order, as in RTL and flex row-reverse', () => {
+  const a = item(240, 0), b = item(120, 0), c = item(0, 0);
+  assert.equal(findSpatialTarget(a, [a, b, c], 'ArrowLeft'), b);
+  assert.equal(findSpatialTarget(b, [a, b, c], 'ArrowRight'), a);
+});
+
+test('direction filtering uses edges rather than centers for unequal items', () => {
+  const current = item(100, 100);
+  const overlapping = item(110, 100, 400);
+  const adjacent = item(220, 100);
+  assert.equal(findSpatialTarget(current, [current, overlapping, adjacent], 'ArrowRight'), adjacent);
+});
+
+test('prefers aligned candidates, then axial gap, then center offset', () => {
+  const current = item(0, 0);
+  const diagonal = item(105, 41);
+  const farther = item(240, 0);
+  const offCenter = item(120, 30);
+  const aligned = item(120, 0);
+  assert.equal(findSpatialTarget(current, [current, diagonal, farther, offCenter, aligned], 'ArrowRight'), aligned);
+});
+
+test('uses weighted diagonal fallback for incomplete or staggered rows', () => {
+  const current = item(0, 0);
+  const farSideways = item(250, 60);
+  const nearby = item(110, 100);
+  assert.equal(findSpatialTarget(current, [current, farSideways, nearby], 'ArrowDown'), nearby);
+});
+
+test('allows subpixel edge rounding', () => {
+  const a = item(0, 0), b = item(99.5, 0);
+  assert.equal(findSpatialTarget(a, [a, b], 'ArrowRight'), b);
+});
+
+test('enhances semantics and maintains one Tab stop when navigating or clicking', () => {
+  const a = item(0, 0), b = item(120, 0), c = item(240, 0);
+  const grid = widget([a, b, c]);
+  assert.equal(grid.attributes.role, 'grid');
+  assert.equal(grid.row.role, 'row');
+  assert.ok(grid.cards.every(card => card.role === 'gridcell'));
+  assert.deepEqual([a.tabIndex, b.tabIndex, c.tabIndex], [0, -1, -1]);
+  assert.equal(grid.key(a, 'ArrowRight').defaultPrevented, true);
+  assert.deepEqual([a.tabIndex, b.tabIndex, c.tabIndex], [-1, 0, -1]);
+  assert.deepEqual(b.focusOptions, { preventScroll: true });
+  assert.deepEqual(b.scrollOptions, { block: 'nearest', inline: 'nearest' });
+  grid.focus(c);
+  assert.deepEqual([a.tabIndex, b.tabIndex, c.tabIndex], [-1, -1, 0]);
+});
+
+test('preserves native scrolling, activation, Tab and modified keys', () => {
+  const a = item(0, 0), b = item(120, 0);
+  const grid = widget([a, b]);
+  for (const key of ['ArrowLeft', 'ArrowUp', 'ArrowDown', 'Enter', ' ', 'Tab', 'Home', 'End']) {
+    assert.equal(grid.key(a, key).defaultPrevented, false);
+  }
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'isComposing']) {
+    assert.equal(grid.key(a, 'ArrowRight', { [modifier]: true }).defaultPrevented, false);
+  }
+  grid.key(a, 'ArrowRight', { defaultPrevented: true });
+  assert.equal(b.focusOptions, undefined);
+  assert.equal(grid.key(b, 'ArrowRight').defaultPrevented, false);
+});
+
+test('skips hidden, inert, disabled and zero-size targets', () => {
+  for (const state of [
+    { visible: false }, { hiddenAncestor: true }, { disabled: true },
+    { rect: item(0, 0, 0, 0).rect },
+  ]) {
+    const hidden = Object.assign(item(0, 0), state);
+    const a = item(120, 0), b = item(240, 0);
+    const grid = widget([hidden, a, b]);
+    assert.deepEqual([hidden.tabIndex, a.tabIndex, b.tabIndex], [-1, 0, -1]);
+    assert.equal(grid.key(a, 'ArrowLeft').defaultPrevented, false);
+    assert.equal(grid.key(a, 'ArrowRight').defaultPrevented, true);
+  }
+});
+
+test('leaves nested controls alone and uses the original composed event target', () => {
+  const a = item(0, 0), b = item(120, 0);
+  const grid = widget([a, b]);
+  const nested = item(0, 0);
+  assert.equal(grid.key(nested, 'ArrowRight', { target: a }).defaultPrevented, false);
+  a.editable = true;
+  assert.equal(grid.key(a, 'ArrowRight').defaultPrevented, false);
+  a.editable = false;
+  assert.equal(grid.key(a, 'ArrowRight', { target: {} }).defaultPrevented, true);
+});
+
+test('widgets keep independent roving focus state', () => {
+  const a = item(0, 0), b = item(120, 0), c = item(0, 0), d = item(120, 0);
+  const first = widget([a, b]);
+  widget([c, d]);
+  first.key(a, 'ArrowRight');
+  assert.deepEqual([a.tabIndex, b.tabIndex, c.tabIndex, d.tabIndex], [-1, 0, 0, -1]);
+});
