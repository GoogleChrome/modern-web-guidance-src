+  <script>
+    const form = document.getElementById('brew-form');
+    const fields = [...form.querySelectorAll('.content-sized')];
+    const status = document.getElementById('brew-status');
+    const measure = document.createElement('span');
+    measure.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;pointer-events:none;top:0;left:0;';
+    measure.setAttribute('aria-hidden', 'true');
+    document.body.append(measure);
+
+    function fitField(field) {
+      const style = getComputedStyle(field);
+      measure.style.font = style.font;
+      measure.style.letterSpacing = style.letterSpacing;
+      const text = field.tagName === 'SELECT'
+        ? field.selectedOptions[0].textContent
+        : field.value || field.placeholder || ' ';
+      let width = 0;
+      for (const line of text.split('\n')) {
+        measure.textContent = line || ' ';
+        width = Math.max(width, measure.getBoundingClientRect().width);
+      }
+      const extra = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+        + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      field.style.width = Math.ceil(width + extra + 3) + 'px';
+      if (field.tagName === 'TEXTAREA') {
+        field.style.height = 'auto';
+        field.style.height = (field.scrollHeight + parseFloat(style.borderTopWidth)
+          + parseFloat(style.borderBottomWidth)) + 'px';
+      }
+    }
+
+    function fitAll() { fields.forEach(fitField); }
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        for (const field of fields) {
+          if (typeof saved[field.name] === 'string'
+            && (field.tagName !== 'SELECT' || [...field.options].some(option => option.value === saved[field.name]))) {
+            field.value = saved[field.name];
+          }
+        }
+      }
+    } catch { /* The form remains usable when storage is unavailable. */ }
+
+    for (const field of fields) {
+      field.addEventListener('input', () => { fitField(field); status.textContent = ''; });
+      field.addEventListener('change', () => fitField(field));
+    }
+    window.addEventListener('resize', fitAll);
+    if (document.fonts) document.fonts.ready.then(fitAll);
+    fitAll();
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your preferences are saved. Here’s to your next perfect cup!';
+      } catch {
+        status.textContent = 'Your browser couldn’t save these preferences. Please allow local storage and try again.';
+      }
+    });
+  </script>
+
