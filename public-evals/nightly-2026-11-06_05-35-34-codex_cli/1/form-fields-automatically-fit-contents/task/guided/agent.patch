+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const preferenceFields = [...preferencesForm.querySelectorAll('input, textarea, select')];
+    const saveStatus = document.getElementById('save-status');
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
+      if (saved && typeof saved === 'object') {
+        for (const field of preferenceFields) {
+          if (typeof saved[field.name] === 'string') field.value = saved[field.name];
+        }
+      }
+    } catch { /* The form remains usable when storage is unavailable. */ }
+
+    if (!CSS.supports('field-sizing', 'content')) {
+      const measure = document.createElement('span');
+      measure.setAttribute('aria-hidden', 'true');
+      Object.assign(measure.style, { position: 'absolute', visibility: 'hidden', whiteSpace: 'pre', pointerEvents: 'none' });
+      document.body.append(measure);
+      const fitFields = () => {
+        for (const field of preferenceFields) {
+          const style = getComputedStyle(field);
+          if (field.tagName === 'TEXTAREA') {
+            field.style.height = 'auto';
+            field.style.height = `${field.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+          } else {
+            measure.style.font = style.font;
+            measure.style.letterSpacing = style.letterSpacing;
+            measure.textContent = field.tagName === 'SELECT'
+              ? field.selectedOptions[0]?.textContent || ''
+              : field.value || field.placeholder;
+            const extra = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+              + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+            field.style.width = `${Math.ceil(measure.getBoundingClientRect().width + extra + 2)}px`;
+          }
+        }
+      };
+      preferencesForm.addEventListener('input', fitFields);
+      preferencesForm.addEventListener('change', fitFields);
+      window.addEventListener('resize', fitFields);
+      document.fonts.ready.then(fitFields);
+      fitFields();
+    }
+
+    preferencesForm.addEventListener('input', () => { saveStatus.textContent = ''; });
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(new FormData(preferencesForm))));
+        saveStatus.textContent = 'Your preferences are saved. Here’s to your next cup!';
+      } catch {
+        saveStatus.textContent = 'This browser couldn’t save your preferences. Your notes are still here until you leave this page.';
+      }
+    });
+  </script>
