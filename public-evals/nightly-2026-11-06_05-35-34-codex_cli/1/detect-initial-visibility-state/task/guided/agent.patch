+  <script>
+    (() => {
+      const entries = 'VisibilityStateEntry' in window
+        ? performance.getEntriesByType('visibility-state')
+        : [];
+      const hasVisibilityHistory = entries.length > 0;
+      const initiallyBackgrounded = hasVisibilityHistory
+        ? entries[0].name === 'hidden'
+        : document.visibilityState === 'hidden';
+
+      // Performance timestamps are milliseconds since navigation; null means
+      // no hidden state has been observed. The fallback's zero is an estimate.
+      const timeBackgrounded = hasVisibilityHistory
+        ? entries.find((entry) => entry.name === 'hidden')?.startTime ?? null
+        : initiallyBackgrounded ? 0 : null;
+
+      console.log({
+        initiallyBackgrounded,
+        timeBackgrounded,
+        note: hasVisibilityHistory
+          ? 'Visibility history timestamps are in milliseconds since navigation.'
+          : 'Fallback visibility checks are unreliable for async scripts: the tab may become visible before execution. The timestamp is an estimate in milliseconds since navigation.',
+      });
+    })();
+  </script>
