+    /* Contact form: validate the whole field wrapper after interaction. */
+    .contact {
+      max-width: 640px;
+    }
+
+    .contact form {
+      display: grid;
+      gap: 16px;
+      margin-top: 20px;
+    }
+
+    .contact-field {
+      padding: 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      min-height: 48px;
+      padding: 10px;
+      border: 1px solid #8d6e63;
+      border-radius: 4px;
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+    }
+
+    .contact-field input:focus-visible,
+    .contact-field textarea:focus-visible,
+    .contact button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .contact-hint,
+    .contact-error {
+      font-size: 0.875rem;
+    }
+
+    .contact-hint {
+      display: block;
+      margin-bottom: 6px;
+    }
+
+    .contact-error {
+      display: none;
+      margin-top: 6px;
+      color: #b3261e;
+    }
+
+    .contact-field:has(:user-invalid) {
+      border-color: #b3261e;
+    }
+
+    .contact-field:has(:user-invalid) .contact-error {
+      display: block;
+    }
+
+    .contact button {
+      justify-self: start;
+      min-height: 48px;
+      margin-top: 0;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
