+  <script>
+    const coffeeDialog = document.querySelector('#coffee-details');
+    const coffeeButtons = [...document.querySelectorAll('[data-coffee]')];
+    let detailsTrigger;
+    let awaitingBack = false;
+
+    function showCoffeeDetails(button) {
+      const card = button.closest('.card');
+      detailsTrigger = button;
+      document.querySelector('#coffee-details-title').textContent = card.querySelector('h3').textContent;
+      document.querySelector('#coffee-details-description').textContent = card.querySelector('p').textContent;
+      document.querySelector('#coffee-details-menu').href = button.dataset.menu;
+      if (!coffeeDialog.open) coffeeDialog.showModal();
+    }
+
+    coffeeButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        if (awaitingBack || coffeeDialog.open) return;
+        // Give browser Back (including mobile gestures) a dialog-only entry to dismiss.
+        history.pushState({ ...history.state, coffeeDetails: button.dataset.coffee }, '');
+        showCoffeeDetails(button);
+      });
+    });
+
+    coffeeDialog.addEventListener('close', () => {
+      detailsTrigger?.focus();
+      // Native Escape, platform close requests, and the Close button share cleanup.
+      if (history.state?.coffeeDetails) {
+        awaitingBack = true;
+        history.back();
+      }
+    });
+
+    window.addEventListener('popstate', () => {
+      awaitingBack = false;
+      const button = coffeeButtons.find((item) => item.dataset.coffee === history.state?.coffeeDetails);
+      if (button) {
+        showCoffeeDetails(button);
+      } else if (coffeeDialog.open) {
+        coffeeDialog.close();
+      }
+    });
+  </script>
+
