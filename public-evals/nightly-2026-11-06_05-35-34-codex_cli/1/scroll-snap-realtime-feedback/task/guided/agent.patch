+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const controls = document.querySelector('.gallery-thumbnails');
+    const thumbnails = [...controls.querySelectorAll('.thumbnail')];
+    const nativePending = 'onscrollsnapchanging' in gallery;
+    const nativeSelection = 'onscrollsnapchange' in gallery;
+    const nativeScrollEnd = 'onscrollend' in gallery;
+    const nativeFocusGroup = 'focusGroup' in HTMLElement.prototype;
+    let frame = null;
+    let scrollTimeout;
+
+    function closestIndex() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      return items.reduce((closest, item, index) => {
+        const distance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        const previous = items[closest];
+        return distance < Math.abs(previous.offsetLeft + previous.offsetWidth / 2 - center)
+          ? index : closest;
+      }, 0);
+    }
+
+    function setPending(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    }
+
+    function syncFocus() {
+      if (nativeFocusGroup) return;
+      const focused = thumbnails.indexOf(document.activeElement);
+      const current = thumbnails.findIndex(thumbnail => thumbnail.classList.contains('active'));
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.tabIndex = i === (focused >= 0 ? focused : current) ? 0 : -1;
+      });
+    }
+
+    function select(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+      syncFocus();
+    }
+
+    function settle() {
+      clearTimeout(scrollTimeout);
+      // Prevent a queued fallback frame from restoring pending after settlement.
+      cancelAnimationFrame(frame);
+      frame = null;
+      select(closestIndex());
+    }
+
+    gallery.addEventListener('scrollsnapchanging', event => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', event => {
+      select(items.indexOf(event.snapTargetInline));
+    });
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', settle);
+
+    gallery.addEventListener('scroll', () => {
+      if (!nativePending && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          setPending(closestIndex());
+        });
+      }
+      if (!nativeScrollEnd) {
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(settle, 180);
+      }
+    }, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        if (Math.abs(gallery.scrollLeft - items[index].offsetLeft) < 1) {
+          select(index);
+          return;
+        }
+        gallery.scrollTo({
+          left: items[index].offsetLeft,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if (!nativeFocusGroup) {
+      controls.setAttribute('role', 'toolbar');
+      controls.addEventListener('focusin', syncFocus);
+      controls.addEventListener('keydown', event => {
+        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+        const current = thumbnails.indexOf(document.activeElement);
+        if (current < 0) return;
+        event.preventDefault();
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? thumbnails.length - 1
+          : (current + (event.key === 'ArrowLeft' ? -1 : 1) + thumbnails.length) % thumbnails.length;
+        thumbnails[next].focus({ preventScroll: true });
+      });
+    }
+
+    select(closestIndex());
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('load', settle, { once: true });
+    window.addEventListener('resize', () => {
+      if (!nativeSelection) settle();
+    });
+  </script>
