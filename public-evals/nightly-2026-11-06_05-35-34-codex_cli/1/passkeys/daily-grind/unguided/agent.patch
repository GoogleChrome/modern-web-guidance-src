+/* Browser-only WebAuthn demonstration. Production verification belongs on a server. */
+const encoder = new TextEncoder();
+export const encode = value => btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+export const decode = value => Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
+export function supported() {
+  return Boolean(globalThis.isSecureContext && globalThis.PublicKeyCredential && navigator.credentials && crypto.subtle);
+}
+function requireSupport() {
+  if (!supported()) throw new Error('Passkeys need a supported browser on HTTPS or localhost. You can still explore the preview account.');
+}
+export function validateClientData(buffer, challenge, type, origin) {
+  const data = JSON.parse(new TextDecoder().decode(buffer));
+  if (data.type !== type || data.challenge !== encode(challenge) || data.origin !== origin || data.crossOrigin === true) {
+    throw new Error('The passkey response could not be verified. Please try again.');
+  }
+}
+export async function validateAuthenticatorData(value, rpId) {
+  const bytes = new Uint8Array(value);
+  if (bytes.length < 37) throw new Error('Invalid authenticator response.');
+  const expected = new Uint8Array(await crypto.subtle.digest('SHA-256', encoder.encode(rpId)));
+  if (!expected.every((v, i) => v === bytes[i]) || (bytes[32] & 5) !== 5) {
+    throw new Error('Device verification was not completed. Please try again.');
+  }
+}
+export function rawSignature(value) {
+  const data = new Uint8Array(value);
+  // ES256 authenticators return a DER sequence of two unsigned 256-bit integers.
+  if (data[0] !== 0x30 || data[1] !== data.length - 2 || data[2] !== 2) throw new Error('Invalid passkey signature.');
+  const rLength = data[3];
+  const sOffset = 4 + rLength;
+  if (data[sOffset] !== 2) throw new Error('Invalid passkey signature.');
+  const sLength = data[sOffset + 1];
+  if (sOffset + 2 + sLength !== data.length) throw new Error('Invalid passkey signature.');
+  const output = new Uint8Array(64);
+  [data.slice(4, sOffset), data.slice(sOffset + 2)].forEach((part, index) => {
+    if (part.length === 33 && part[0] === 0) part = part.slice(1);
+    if (!part.length || part.length > 32) throw new Error('Invalid passkey signature.');
+    output.set(part, index * 32 + 32 - part.length);
+  });
+  return output;
+}
+export async function enroll(account, name) {
+  requireSupport();
+  const challenge = crypto.getRandomValues(new Uint8Array(32));
+  const credential = await navigator.credentials.create({ publicKey: {
+    challenge, rp: { name: 'The Daily Grind', id: location.hostname },
+    user: { id: decode(account.id), name: account.email, displayName: account.name },
+    pubKeyCredParams: [{ type: 'public-key', alg: -7 }],
+    authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+    excludeCredentials: account.passkeys.filter(p => !p.demo).map(p => ({ type: 'public-key', id: decode(p.id) })),
+    timeout: 60000, attestation: 'none'
+  }});
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  validateClientData(credential.response.clientDataJSON, challenge, 'webauthn.create', location.origin);
+  if (typeof credential.response.getPublicKey !== 'function') throw new Error('Please update your browser to save passkeys.');
+  await validateAuthenticatorData(credential.response.getAuthenticatorData(), location.hostname);
+  const publicKey = credential.response.getPublicKey();
+  if (!publicKey || credential.response.getPublicKeyAlgorithm() !== -7) throw new Error('This authenticator is not supported. Try another device.');
+  return { id: credential.id, publicKey: encode(publicKey), name, kind: credential.authenticatorAttachment === 'platform' ? 'laptop' : 'phone', created: new Date().toISOString(), lastUsed: null, transports: credential.response.getTransports?.() || [], demo: false };
+}
