diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..a780266
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,19 @@
+import { mkdir, readFile, copyFile } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+const files = ['index.html', 'styles.css', 'app.js', 'passkeys.js'];
+for (const file of files.filter(f => f.endsWith('.js'))) {
+  const result = spawnSync(process.execPath, ['--check', file], { stdio: 'inherit' });
+  if (result.status !== 0) process.exit(result.status || 1);
+}
+const html = await readFile('index.html', 'utf8');
+const ids = [...html.matchAll(/\bid="([^"]+)"/g)].map(m => m[1]);
+if (new Set(ids).size !== ids.length) throw new Error('Duplicate HTML IDs');
+for (const match of html.matchAll(/<use href="#([^"]+)"/g)) {
+  if (!ids.includes(match[1])) throw new Error(`Missing icon ${match[1]}`);
+}
+for (const path of ['styles.css', 'app.js', 'passkeys.js']) {
+  if (!(await readFile(path, 'utf8')).trim()) throw new Error(`Empty asset ${path}`);
+}
+await mkdir('dist', { recursive: true });
+await Promise.all(files.map(file => copyFile(file, `dist/${file}`)));
+console.log('Built static site in dist/. JavaScript syntax, HTML IDs, and SVG references checked.');
