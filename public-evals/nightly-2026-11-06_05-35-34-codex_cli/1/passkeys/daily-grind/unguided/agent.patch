+  const keys = account.passkeys.filter(p => !p.demo);
+  if (!keys.length) throw new Error('This account has no enrolled passkeys. Open the preview account to add one, or create a new account.');
+  const challenge = crypto.getRandomValues(new Uint8Array(32));
+  const credential = await navigator.credentials.get({ publicKey: {
+    challenge, rpId: location.hostname, userVerification: 'required', timeout: 60000,
+    allowCredentials: keys.map(p => ({ type: 'public-key', id: decode(p.id), transports: p.transports }))
+  }});
