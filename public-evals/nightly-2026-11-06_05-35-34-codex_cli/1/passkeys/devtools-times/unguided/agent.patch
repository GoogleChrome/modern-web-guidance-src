+          account.passkeys.push({ id: credential.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter, transports: credential.transports, name: typeof body.name === 'string' && body.name.trim() ? body.name.trim().slice(0, 60) : 'My passkey', createdAt: Date.now(), backedUp: result.registrationInfo.credentialBackedUp });
