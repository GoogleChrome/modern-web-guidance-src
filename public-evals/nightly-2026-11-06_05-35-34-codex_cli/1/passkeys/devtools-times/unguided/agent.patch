+          const userId = user?.id || token();
+          const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: new URL(origin).hostname, userName: user?.username || username!, userID: new TextEncoder().encode(userId), attestationType: 'none', authenticatorSelection: { residentKey: 'required', userVerification: 'required' }, excludeCredentials: user?.passkeys.map(k => ({ id: k.id, transports: k.transports })) });
+          const secret = token(); db.pending[digest(secret)] = { challenge: options.challenge, kind: 'register', expires: Date.now() + 300_000, userId, username, origin, rpID: new URL(origin).hostname, sessionKey: user ? sessionKey : undefined }; cookies.set(pendingCookie, secret, { ...cookieOptions, maxAge: 300 }); return json(options);
+        }
+        const reauth = body.mode === 'reauthenticate';
+        if (reauth) requireUser();
+        const options = await generateAuthenticationOptions({ rpID: new URL(origin).hostname, userVerification: 'required', ...(reauth ? { allowCredentials: user!.passkeys.map(k => ({ id: k.id, transports: k.transports })) } : {}) });
+        if (reauth && !user!.passkeys.length) throw new AuthError('Use your password to confirm your identity.');
+        const secret = token(); db.pending[digest(secret)] = { challenge: options.challenge, kind: reauth ? 'reauthenticate' : 'authenticate', expires: Date.now() + 300_000, userId: reauth ? user!.id : undefined, sessionKey: reauth ? sessionKey : undefined, origin, rpID: new URL(origin).hostname }; cookies.set(pendingCookie, secret, { ...cookieOptions, maxAge: 300 }); return json(options);
+      }
+      if (action === 'passkeys/verify') {
+        const key = digest(cookies.get(pendingCookie)?.value || ''); const pending = db.pending[key]; delete db.pending[key]; cookies.delete(pendingCookie, { path });
