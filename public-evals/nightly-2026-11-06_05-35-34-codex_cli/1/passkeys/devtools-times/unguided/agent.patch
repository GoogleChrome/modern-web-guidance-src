+      if (action === 'password/signup' || action === 'password/signin') {
+        const username = typeof body.username === 'string' ? body.username.trim().toLowerCase() : '';
+        const password = typeof body.password === 'string' ? body.password : '';
+        if (!username || username.length > 120 || password.length > 256) throw new AuthError('Enter a valid username and password.');
+        let account = db.users.find(u => u.username === username);
+        if (action.endsWith('signup')) {
