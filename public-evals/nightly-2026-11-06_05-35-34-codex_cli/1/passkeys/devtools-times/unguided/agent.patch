+      const setSession = (account: User) => { delete db.sessions[sessionKey]; const secret = token(); db.sessions[digest(secret)] = { userId: account.id, expires: Date.now() + 7 * 86400_000, verifiedAt: Date.now() }; cookies.set(cookieName, secret, { ...cookieOptions, maxAge: 7 * 86400 }); };
+      const action = params.action;
+      if (request.method === 'GET') {
+        if (action !== 'me') return json({ error: 'Not found.' }, 404);
+        return json({ user: user ? publicUser(user) : null });
+      }
