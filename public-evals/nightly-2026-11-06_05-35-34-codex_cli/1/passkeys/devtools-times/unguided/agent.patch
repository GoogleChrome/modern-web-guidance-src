+      for (const rateKey of rateKeys) { const attempt = db.attempts[rateKey] ||= { count: 0, expires: Date.now() + 60_000 }; if (++attempt.count > 30) throw new AuthError('Too many attempts. Please try again in a minute.', 429); }
