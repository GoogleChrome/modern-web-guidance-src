+import { useEffect, useState } from 'react';
+import { ArrowRightIcon, ArrowLeftIcon, FingerPrintIcon, ShieldCheckIcon, CheckIcon, KeyIcon } from '@heroicons/react/24/outline';
+import { api, base, errorMessage, passkeysSupported, usePasskey } from '../lib/auth-client';
+import PasskeyArt from './PasskeyArt';
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [method, setMethod] = useState<'passkey' | 'password'>('passkey');
+  const [supported, setSupported] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => { const enabled = passkeysSupported(); setSupported(enabled); if (!enabled) setMethod('password'); }, []);
+  async function submit(event?: React.FormEvent) {
+    event?.preventDefault(); setBusy(true); setError('');
+    try {
+      if (method === 'passkey') await usePasskey(signup ? 'register' : 'authenticate', username, 'My first passkey');
+      else await api(`password/${signup ? 'signup' : 'signin'}`, { username, password });
+      window.location.assign(`${base}account/settings${signup && method === 'password' ? '?welcome=1' : ''}`);
+    } catch (err) { setError(errorMessage(err)); } finally { setBusy(false); }
+  }
+  return <div className="auth-page">
+    <a href={base} className="back-link"><ArrowLeftIcon/> Back to the news</a>
+    <div className="auth-layout">
+      <section className="auth-story"><span className="eyebrow"><span className="tiny-line"/> YOUR WORLD. A LITTLE CLOSER.</span><h1>Good journalism.<br/>One less password.</h1><p>Make room for what matters. Your next great read is just a touch away.</p><PasskeyArt/><div className="story-footnote"><ShieldCheckIcon/><span>A more secure way to stay informed.</span></div></section>
+      <section className="auth-panel"><span className="eyebrow">THE DEVTOOLS TIMES ACCOUNT</span><h2>{signup ? 'A fresh perspective starts here.' : 'Welcome back.'}</h2><p className="panel-intro">{signup ? 'Create your free account. Stay curious.' : 'Sign in to your account and pick up where you left off.'}</p>
+        <div className="auth-methods" aria-label="Sign-in method"><button type="button" disabled={busy || !supported} className={method === 'passkey' ? 'selected' : ''} onClick={() => { setMethod('passkey'); setError(''); }}><FingerPrintIcon/> Passkey <span>Recommended</span></button><button type="button" disabled={busy} className={method === 'password' ? 'selected' : ''} onClick={() => { setMethod('password'); setError(''); }}><KeyIcon/> Password</button></div>
+        {!supported && <p className="notice">Passkeys aren’t available in this browser or connection. Please use a password.</p>}
+        {error && <div className="error-notice" role="alert">{error}</div>}
+        <form onSubmit={submit} className="auth-form">
+          {(signup || method === 'password') && <label>Username<input autoComplete="username webauthn" name="username" value={username} onChange={e => setUsername(e.target.value)} placeholder="Enter your username" required maxLength={120} disabled={busy}/></label>}
+          {method === 'password' ? <label>Password<input type="password" autoComplete={signup ? 'new-password' : 'current-password'} name="password" value={password} onChange={e => setPassword(e.target.value)} placeholder={signup ? 'Create a secure password' : 'Enter your password'} required minLength={signup ? 8 : undefined} maxLength={256} disabled={busy}/>{signup && <small>At least 8 characters, including a number.</small>}</label> : <div className="auth-passkey-info"><div className="icon-square"><FingerPrintIcon/></div><h3>{signup ? 'Your fingerprint. Your face. Your key.' : 'You already have the key.'}</h3><p>{signup ? 'Use your fingerprint, face, or device PIN to create an account. No password to remember.' : 'Use your fingerprint, face, or device PIN to sign in securely. You can also use a passkey from another device.'}</p></div>}
+          <button className="primary-button full" type="submit" disabled={busy}>{method === 'passkey' && <FingerPrintIcon/>}{busy ? 'Waiting for confirmation…' : signup ? (method === 'passkey' ? 'Create account with a passkey' : 'Create your account') : (method === 'passkey' ? 'Sign in with a passkey' : 'Sign in')} {!busy && <ArrowRightIcon/>}</button>
+        </form>
+        {method === 'passkey' && <p className="private-note"><LockMark/> Your biometric data never leaves your device.</p>}
+        <p className="auth-switch">{signup ? 'Already part of the story?' : 'New to The DevTools Times?'} <a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} <span>↗</span></a></p>
+        <p className="auth-terms">By continuing, you agree to our <a href={`${base}legal/terms`}>Terms of Service</a> and <a href={`${base}legal/privacy`}>Privacy Policy</a>.</p>
+      </section>
+    </div>
+    <div className="auth-trust"><span><CheckIcon/> No password to remember</span><span><CheckIcon/> Built-in phishing protection</span><span><CheckIcon/> Your privacy comes first</span></div>
+  </div>;
+}
+function LockMark() { return <ShieldCheckIcon/>; }
