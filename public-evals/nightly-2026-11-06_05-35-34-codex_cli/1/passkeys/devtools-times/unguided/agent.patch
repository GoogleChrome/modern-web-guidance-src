new file mode 100644
index 0000000..b79539d
--- /dev/null
+++ b/src/lib/auth-client.ts
@@ -0,0 +1,23 @@
+import { browserSupportsWebAuthn, startAuthentication, startRegistration } from '@simplewebauthn/browser';
+export type AccountPasskey = { id: string; name: string; createdAt: number; lastUsed?: number; backedUp: boolean };
+export type Account = { id: string; username: string; hasPassword: boolean; passkeys: AccountPasskey[] };
+export const base = import.meta.env.BASE_URL;
+export class RequestError extends Error { constructor(message: string, public code?: string) { super(message); } }
+export async function api(action: string, body?: unknown) {
+  const response = await fetch(`${base}api/auth/${action}`, { method: body === undefined ? 'GET' : 'POST', headers: body === undefined ? {} : { 'Content-Type': 'application/json' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  const data = await response.json();
+  if (!response.ok) throw new RequestError(data.error || 'Something went wrong. Please try again.', data.code);
+  return data;
+}
+export function passkeysSupported() { return window.isSecureContext && browserSupportsWebAuthn(); }
+export async function usePasskey(mode: 'register' | 'authenticate' | 'reauthenticate', username?: string, name?: string) {
+  if (!passkeysSupported()) throw new Error('Passkeys require a supported browser and a secure connection. You can use your password instead.');
+  const options = await api('passkeys/options', { mode, username });
+  const credential = mode === 'register' ? await startRegistration({ optionsJSON: options }) : await startAuthentication({ optionsJSON: options });
+  return api('passkeys/verify', { credential, name });
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof Error && error.name === 'NotAllowedError') return 'The passkey request was canceled or timed out. You can try again.';
+  if (error instanceof Error && error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or sign in.';
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/server/auth.ts b/src/lib/server/auth.ts
new file mode 100644
index 0000000..7d7a9a9
--- /dev/null
+++ b/src/lib/server/auth.ts
@@ -0,0 +1,29 @@
+import { randomBytes, scryptSync, timingSafeEqual, createHash } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export type Passkey = { id: string; publicKey: string; counter: number; transports?: string[]; name: string; createdAt: number; lastUsed?: number; backedUp: boolean };
+export type User = { id: string; username: string; password?: string; passkeys: Passkey[] };
+export type Session = { userId: string; expires: number; verifiedAt: number };
+export type Pending = { challenge: string; kind: 'register' | 'authenticate' | 'reauthenticate'; expires: number; userId?: string; username?: string; origin: string; rpID: string; sessionKey?: string };
+type Store = { users: User[]; sessions: Record<string, Session>; pending: Record<string, Pending>; attempts: Record<string, { count: number; expires: number }> };
+const file = resolve(process.env.AUTH_DATA_FILE || '.data/auth.json');
+let queue: Promise<unknown> = Promise.resolve();
+export function transaction<T>(fn: (db: Store) => Promise<T>): Promise<T> {
+  const task = queue.then(async () => {
+    let db: Store;
+    try { db = JSON.parse(await readFile(file, 'utf8')); }
+    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; db = { users: [], sessions: {}, pending: {}, attempts: {} }; }
+    for (const collection of [db.sessions, db.pending, db.attempts]) for (const [key, value] of Object.entries(collection)) if (value.expires < Date.now()) delete collection[key];
+    try { return await fn(db); }
+    finally { await mkdir(dirname(file), { recursive: true, mode: 0o700 }); await writeFile(`${file}.tmp`, JSON.stringify(db), { mode: 0o600 }); await rename(`${file}.tmp`, file); }
+  });
+  queue = task.catch(() => {});
+  return task;
+}
+export const token = () => randomBytes(32).toString('base64url');
+export const digest = (value: string) => createHash('sha256').update(value).digest('hex');
+export function hashPassword(password: string) { const salt = token(); return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`; }
+export function checkPassword(password: string, hash?: string) { const [salt, stored] = (hash || hashPassword('unused-password')).split(':'); return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(stored, 'hex')) && !!hash; }
+export const publicUser = (user: User) => ({ id: user.id, username: user.username, hasPassword: !!user.password, passkeys: user.passkeys.map(({ publicKey, counter, transports, ...key }) => key) });
+export class AuthError extends Error { constructor(message: string, public status = 400, public code = 'AUTH_ERROR') { super(message); } }
