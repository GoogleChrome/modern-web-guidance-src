+      }
+      if (action === 'reauthenticate/password') {
+        requireUser();
+        if (typeof body.password !== 'string' || body.password.length > 256 || !checkPassword(body.password, user!.password)) throw new AuthError('That password is incorrect. Please try again.', 401);
