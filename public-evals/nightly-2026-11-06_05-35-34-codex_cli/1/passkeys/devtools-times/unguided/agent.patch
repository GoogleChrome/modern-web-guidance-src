diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..7658847
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,49 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+const dir = await mkdtemp(join(tmpdir(), 'times-auth-test-'));
+process.env.AUTH_DATA_FILE = join(dir, 'auth.json');
+const { hashPassword, checkPassword, transaction, digest, publicUser } = await import('../src/lib/server/auth.ts');
+after(() => rm(dir, { recursive: true, force: true }));
+
+test('passwords are salted, verified, and rejected for missing accounts', () => {
+  const first = hashPassword('My secret 123');
+  const second = hashPassword('My secret 123');
+  assert.notEqual(first, second);
+  assert.equal(checkPassword('My secret 123', first), true);
+  assert.equal(checkPassword('Wrong secret', first), false);
+  assert.equal(checkPassword('My secret 123'), false);
+});
+
+test('public account data never exposes password hashes or passkey material', () => {
+  const value = publicUser({ id: 'reader', username: 'Reader', password: 'secret-hash', passkeys: [{ id: 'key', publicKey: 'secret-key-material', counter: 7, transports: ['internal'], name: 'Laptop', createdAt: 1, backedUp: true }] });
+  assert.equal(value.hasPassword, true);
+  assert.equal(value.password, undefined);
+  assert.equal(value.passkeys[0].publicKey, undefined);
+  assert.equal(value.passkeys[0].counter, undefined);
+});
+
+test('concurrent transactions preserve writes and persist after validation errors', async () => {
+  await Promise.all(Array.from({ length: 8 }, (_, i) => transaction(async db => { db.users.push({ id: String(i), username: `reader-${i}`, passkeys: [] }); })));
+  await assert.rejects(transaction(async db => { db.pending.oneTime = { challenge: 'challenge', expires: Date.now() + 60000 }; throw new Error('Failed verification'); }));
+  const saved = JSON.parse(await readFile(process.env.AUTH_DATA_FILE, 'utf8'));
+  assert.equal(saved.users.length, 8);
+  assert.ok(saved.pending.oneTime);
+  await transaction(async db => { delete db.pending.oneTime; });
+});
+
+test('expired sessions and ceremonies are removed before access', async () => {
+  await transaction(async db => {
+    db.sessions[digest('expired')] = { userId: '0', expires: 1, verifiedAt: 1 };
+    db.pending.expired = { challenge: 'old', expires: 1 };
+    db.attempts.expired = { count: 40, expires: 1 };
+  });
+  await transaction(async db => {
+    assert.equal(db.sessions[digest('expired')], undefined);
+    assert.equal(db.pending.expired, undefined);
+    assert.equal(db.attempts.expired, undefined);
+    assert.equal(db.users.length, 8);
+  });
+});
