new file mode 100644
index 0000000..1ae63c0
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,75 @@
+export const accountUrl = `${import.meta.env.BASE_URL}account/settings`;
+export class ApiError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+export async function api<T = { ok: boolean }>(path: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${path}`, {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin', signal,
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new ApiError(data.error || 'The request failed. Please try again.', response.status);
+  return data;
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. You can try again or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys require HTTPS and a matching site configuration.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled. Please try again.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
+export async function capabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential) return null;
+  await import('webauthn-polyfills');
+  return PublicKeyCredential.getClientCapabilities();
+}
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }); }
+  catch (error) { console.warn('Passkey synchronization was unavailable.', error); }
+}
+export async function authenticate(signal: AbortSignal, conditional = false, reauth = false) {
+  const prefix = reauth ? 'reauthentication' : 'authentication';
+  const options = await api<PublicKeyCredentialRequestOptionsJSON>(`${prefix}/options`, {}, signal);
+  if (signal.aborted) throw new DOMException('Cancelled', 'AbortError');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  const credential = await navigator.credentials.get({ publicKey, signal, ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected.');
+  try { await api(`${prefix}/verify`, credential.toJSON(), signal); }
+  catch (error) {
+    if (!reauth && error instanceof ApiError && error.status === 404) await signalUnknown(options.rpId!, credential.id);
+    throw error;
+  }
+}
+export async function registerPasskey(signal: AbortSignal, promotion = false) {
+  const options = await api<PublicKeyCredentialCreationOptionsJSON>('registration/options', { promotion }, signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created.');
+  try { await api('registration/verify', credential.toJSON(), signal); }
+  catch (error) {
+    await signalUnknown(options.rp.id!, credential.id);
+    throw error;
+  }
+}
+export type Account = {
+  user: { id: string; username: string; displayName: string }; rpId: string; userId: string;
+  credentials: { id: string; name: string; aaguid: string; registeredAt: number; lastUsedAt?: number; backedUp: boolean }[];
+};
+const validId = (id: string) => !!id && id.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(id);
+export async function syncPasskeys(account: Account) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  const ids = account.credentials.map(c => c.id);
+  if (!account.rpId || !validId(account.userId) || !ids.every(validId)) return;
+  try { await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: ids }); }
+  catch (error) { console.warn('Passkey synchronization was unavailable.', error); }
+}
+export async function syncProfile(account: Account) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails || !validId(account.userId)) return;
+  try { await PublicKeyCredential.signalCurrentUserDetails({ rpId: account.rpId, userId: account.userId,
+    name: account.user.username, displayName: account.user.displayName }); }
+  catch (error) { console.warn('Passkey profile synchronization was unavailable.', error); }
+}
