+        <div className="flex flex-wrap gap-3"><button className={buttonClass} disabled={busy} data-skip-tracking="true">{busy ? 'Please wait…' : pending.kind === 'delete' ? 'Verify and delete passkey' : 'Verify and continue'}</button>
+          <button type="button" onClick={() => { setPending(null); setPassword(''); setError(''); }} className={secondaryClass} disabled={busy}>Cancel</button></div>
+      </form>
