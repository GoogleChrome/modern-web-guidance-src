index 0000000..d27f60e
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,174 @@
+import type { APIRoute } from 'astro';
+import { createHash, randomBytes } from 'node:crypto';
+import {
+  generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import { withAuthStore, type Session } from '../../../lib/server/auth-store';
+
+const remote = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const configuredOrigin = new URL(process.env.AUTH_ORIGIN || 'https://astro-news-pytrpecapa-uc.a.run.app').origin;
+const rpID = process.env.AUTH_RP_ID || new URL(configuredOrigin).hostname;
+const cookieName = 'times_auth';
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+class AuthError extends Error {
+  constructor(message: string, public status = 400) { super(message); }
+}
+function text(value: unknown, max = 100): string {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) throw new AuthError('Please enter a valid value.');
+  return value.trim();
+}
+
+export const ALL: APIRoute = async ({ request, params, cookies }) => {
+  const action = params.action;
+  if (request.method !== 'GET' && request.method !== 'POST') return json({ error: 'Method not allowed.' }, 405);
+  // This route enforces its own CSRF protection; the sample disables Astro's global origin check.
+  if (request.method === 'POST' && request.headers.get('Origin') !== configuredOrigin) {
+    return json({ error: 'The request origin does not match AUTH_ORIGIN.' }, 403);
+  }
+  try {
+    const body = request.method === 'POST' ? await request.json() : {};
+    return await withAuthStore(async (store) => {
+      const rawToken = cookies.get(cookieName)?.value;
+      const key = rawToken ? createHash('sha256').update(rawToken).digest('hex') : '';
+      let session: Session | undefined = store.sessions[key];
+      let user = store.users.find(u => u.id === session?.userId);
+      const requireUser = () => {
+        if (!session || !user) throw new AuthError('Sign in to manage your account.', 401);
+        return user;
+      };
+      const freshSession = (userId?: string) => {
+        if (key) delete store.sessions[key];
+        const token = randomBytes(32).toString('base64url');
+        session = { userId, expires: Date.now() + (userId ? 12 * 60 * 60_000 : 5 * 60_000) };
+        store.sessions[createHash('sha256').update(token).digest('hex')] = session;
+        cookies.set(cookieName, token, {
+          httpOnly: true, secure: configuredOrigin.startsWith('https:'), sameSite: 'strict',
+          path: import.meta.env.BASE_URL, maxAge: userId ? 43200 : 300,
+        });
+        return session;
+      };
+      const requireRecent = () => {
+        requireUser();
+        if (!session?.verifiedAt || Date.now() - session.verifiedAt > 5 * 60_000) {
+          throw new AuthError('Verify your identity before changing your passkeys.', 403);
+        }
+      };
+      const userKeys = () => store.passkeys.filter(p => p.userId === requireUser().id);
+      const list = () => ({
+        user: requireUser(), rpId: rpID, userId: user!.id,
+        credentials: userKeys().map(({ publicKey, counter, ...safe }) => safe),
+      });
+      if (action === 'account' && request.method === 'GET') return json(list());
+      if (request.method !== 'POST') throw new AuthError('Not found.', 404);
+      if (action === 'logout') {
+        if (key) delete store.sessions[key];
+        cookies.delete(cookieName, { path: import.meta.env.BASE_URL });
+        return json({ ok: true });
+      }
+      if (action === 'login' || action === 'register' || action === 'password/verify') {
+        const username = action === 'password/verify' ? requireUser().username : text(body.username);
+        const password = body.password;
+        if (typeof password !== 'string' || !password || password.length > 1024) throw new AuthError('Enter your password.');
+        const upstream = await fetch(`${remote}/${action === 'register' ? 'register' : 'login'}`, {
+          method: 'POST', headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+        });
+        if (!upstream.ok) throw new AuthError(action === 'register'
+          ? 'Could not create your account. Try another username and a password with at least 8 characters and a number.'
+          : 'Sign-in failed. Check your username and password.', 400);
+        // Registration does not imply an authenticated session; explicitly log in afterward.
+        if (action === 'register') return json({ ok: true });
+        if (action === 'password/verify') {
+          session!.verifiedAt = Date.now();
+          return json({ ok: true });
+        }
+        user = store.users.find(u => u.username === username);
+        if (!user) {
+          user = { id: randomBytes(32).toString('base64url'), username, displayName: username };
+          store.users.push(user);
+        }
+        freshSession(user.id).verifiedAt = Date.now();
+        return json({ user });
+      }
+      if (action === 'registration/options') {
+        requireRecent();
+        const options = await generateRegistrationOptions({
+          rpName: 'The DevTools Times', rpID, userID: Buffer.from(user!.id, 'base64url'),
+          userName: user!.username, userDisplayName: user!.displayName,
+          attestationType: 'none', excludeCredentials: userKeys().map(p => ({ id: p.id, transports: p.transports })),
+          authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required',
+            ...(body.promotion ? { authenticatorAttachment: 'platform' as const } : {}) },
+        });
+        session!.pending = { challenge: options.challenge, kind: 'registration', expires: Date.now() + 300_000, userId: user!.id };
+        return json(options);
+      }
+      if (action === 'authentication/options' || action === 'reauthentication/options') {
+        const reauth = action.startsWith('reauthentication');
+        const keys = reauth ? userKeys() : [];
+        if (reauth && !keys.length) throw new AuthError('No passkeys are registered. Verify with your password instead.');
+        const options = await generateAuthenticationOptions({ rpID, userVerification: 'required',
+          allowCredentials: keys.map(p => ({ id: p.id, transports: p.transports })) });
+        if (!session) freshSession();
+        session!.pending = { challenge: options.challenge, kind: reauth ? 'reauthentication' : 'authentication',
+          expires: Date.now() + 300_000, userId: reauth ? user!.id : undefined };
+        return json(options);
+      }
+      if (['registration/verify', 'authentication/verify', 'reauthentication/verify'].includes(action || '')) {
+        const pending = session?.pending;
+        delete session?.pending;
+        const kind = action!.split('/')[0];
+        if (!pending || pending.kind !== kind || pending.expires < Date.now()) throw new AuthError('This request expired. Please try again.');
+        if (kind === 'registration') {
+          requireRecent();
+          if (pending.userId !== user!.id) throw new AuthError('Account mismatch.', 403);
+          const result = await verifyRegistrationResponse({ response: body, expectedChallenge: pending.challenge,
+            expectedOrigin: configuredOrigin, expectedRPID: rpID, requireUserVerification: true });
+          if (!result.verified) throw new AuthError('The passkey could not be verified.');
+          const info = result.registrationInfo;
+          if (store.passkeys.some(p => p.id === info.credential.id)) throw new AuthError('This passkey is already registered.');
+          store.passkeys.push({ id: info.credential.id, userId: user!.id,
+            publicKey: Buffer.from(info.credential.publicKey).toString('base64url'), counter: info.credential.counter,
+            transports: info.credential.transports, aaguid: info.aaguid, name: 'My passkey',
+            registeredAt: Date.now(), backedUp: info.credentialBackedUp });
+          return json({ ok: true });
+        }
+        const passkey = store.passkeys.find(p => p.id === body.id);
+        if (!passkey) throw new AuthError('This passkey is no longer registered. Sign in with your password.', user ? 400 : 404);
+        if (kind === 'reauthentication' && (passkey.userId !== requireUser().id || pending.userId !== user!.id)) {
+          throw new AuthError('Use a passkey belonging to this account.', 403);
+        }
+        if (body.response?.userHandle && body.response.userHandle !== passkey.userId) throw new AuthError('Account mismatch.', 403);
+        const result = await verifyAuthenticationResponse({ response: body, expectedChallenge: pending.challenge,
+          expectedOrigin: configuredOrigin, expectedRPID: rpID, requireUserVerification: true,
+          credential: { id: passkey.id, publicKey: Buffer.from(passkey.publicKey, 'base64url'), counter: passkey.counter, transports: passkey.transports } });
+        if (!result.verified) throw new AuthError('The passkey could not be verified.');
