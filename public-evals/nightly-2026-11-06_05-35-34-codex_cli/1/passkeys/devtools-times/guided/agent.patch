--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,41 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export type Passkey = {
+  id: string; userId: string; publicKey: string; counter: number;
+  transports?: string[]; name: string; aaguid: string;
+  registeredAt: number; lastUsedAt?: number; backedUp: boolean;
+};
+export type User = { id: string; username: string; displayName: string };
+export type Session = {
+  userId?: string; expires: number; verifiedAt?: number;
+  pending?: { challenge: string; kind: string; expires: number; userId?: string };
+};
+type Store = { users: User[]; passkeys: Passkey[]; sessions: Record<string, Session> };
+const filename = resolve(process.env.AUTH_STORE_PATH || '.data/auth.json');
+let queue: Promise<unknown> = Promise.resolve();
+
+// A serialized, atomically replaced store for this sample's single Node process.
+// Multi-instance deployments must replace this with a shared transactional database.
+export function withAuthStore<T>(operation: (store: Store) => Promise<T>): Promise<T> {
+  const task = queue.then(async () => {
+    let store: Store;
+    try { store = JSON.parse(await readFile(filename, 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      store = { users: [], passkeys: [], sessions: {} };
+    }
+    for (const [key, session] of Object.entries(store.sessions)) {
+      if (session.expires < Date.now()) delete store.sessions[key];
+    }
+    // Persist consumed challenges even if verification fails.
+    try { return await operation(store); }
+    finally {
+      await mkdir(dirname(filename), { recursive: true, mode: 0o700 });
+      await writeFile(`${filename}.tmp`, JSON.stringify(store), { mode: 0o600 });
+      await rename(`${filename}.tmp`, filename);
+    }
+  });
+  queue = task.catch(() => {});
+  return task;
+}
