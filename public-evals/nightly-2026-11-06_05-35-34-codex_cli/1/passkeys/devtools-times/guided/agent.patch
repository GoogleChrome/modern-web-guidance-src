@@ -0,0 +1,108 @@
+import { useEffect, useRef, useState } from 'react';
+import { accountUrl, api, authenticate, capabilities, errorMessage, registerPasskey } from '../lib/passkeys';
+
+export const inputClass = 'w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-700';
+export const buttonClass = 'rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-not-allowed disabled:opacity-50';
+export const secondaryClass = 'rounded-md border border-gray-400 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-not-allowed disabled:opacity-50';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [registered, setRegistered] = useState(false);
+  const [signedIn, setSignedIn] = useState(false);
+  const controller = useRef<AbortController | null>(null);
+  const mounted = useRef(true);
+  const conditionalAvailable = useRef(false);
+  const finished = useRef(false);
+
+  async function autofill() {
+    if (!conditionalAvailable.current || signup || !mounted.current || finished.current) return;
+    controller.current?.abort();
+    const request = new AbortController();
+    controller.current = request;
+    try {
+      await authenticate(request.signal, true);
+      if (!request.signal.aborted && mounted.current) { finished.current = true; window.location.assign(accountUrl); }
+    } catch (err) {
+      if (!request.signal.aborted && mounted.current && !(err instanceof DOMException && ['NotAllowedError', 'AbortError'].includes(err.name))) {
+        setError(errorMessage(err));
+      }
+    }
+  }
+  useEffect(() => {
+    mounted.current = true;
+    capabilities().then(caps => {
+      if (!mounted.current) return;
+      setSupported(!!caps);
+      setCanCreate(!!caps?.passkeyPlatformAuthenticator && !!caps?.conditionalGet);
+      conditionalAvailable.current = !!caps?.conditionalGet;
+      void autofill();
+    }).catch(() => {});
+    return () => { mounted.current = false; controller.current?.abort(); };
+  }, []);
+
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    controller.current?.abort();
+    setError(''); setMessage(''); setBusy(true);
+    try {
+      if (signup && !registered) {
+        await api('register', { username, password });
+        setRegistered(true);
+      }
+      await api('login', { username, password });
+      finished.current = true;
+      setPassword('');
+      if (signup) { setSignedIn(true); setMessage('Your account is ready. Add a passkey for faster, safer sign-ins.'); }
+      else window.location.assign(accountUrl);
+    } catch (err) {
+      setError(errorMessage(err));
+      if (!signup) void autofill();
+    } finally { setBusy(false); }
+  }
+  async function passkey() {
+    controller.current?.abort();
+    const request = new AbortController(); controller.current = request;
+    setError(''); setBusy(true);
+    try {
+      if (signedIn) await registerPasskey(request.signal, true);
+      else await authenticate(request.signal);
+      finished.current = true;
+      window.location.assign(accountUrl);
+    } catch (err) { setError(errorMessage(err)); if (!signedIn) void autofill(); }
+    finally { setBusy(false); }
+  }
+  return <section className="mx-auto mt-10 max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-sm" aria-labelledby="auth-heading">
+    <h1 id="auth-heading" className="mb-3 text-center text-2xl font-bold text-gray-900">{signedIn ? 'Set up your passkey' : signup ? 'Create your account' : 'Sign in'}</h1>
+    <p className="mb-6 text-center text-sm text-gray-600">{signup ? 'Your next great read starts here.' : 'Welcome back to The DevTools Times.'}</p>
+    <div aria-live="polite">{message && <p className="mb-4 rounded-md bg-green-50 p-3 text-sm text-green-800">{message}</p>}</div>
+    {error && <p role="alert" className="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{error}</p>}
+    {signedIn ? <div className="space-y-4">
+      <p className="text-sm text-gray-600">Use your fingerprint, face, or device PIN instead of typing a password. Your biometric information stays on your device.</p>
+      <button type="button" onClick={passkey} disabled={!canCreate || busy} className={`${buttonClass} w-full`} data-skip-tracking="true">{busy ? 'Creating passkey…' : 'Create a passkey'}</button>
+      {!canCreate && <p className="text-sm text-gray-600">Passkey creation is unavailable on this browser or device. You can add one later in account settings.</p>}
+      <a className="block text-center text-sm underline" href={accountUrl}>Continue to account settings</a>
+    </div> : <>
+      {!signup && <div className="mb-5 space-y-3">
+        <button type="button" onClick={passkey} disabled={!supported || busy} className={`${buttonClass} w-full`} data-skip-tracking="true">{busy ? 'Signing in…' : 'Sign in with a passkey'}</button>
+        <p className="text-center text-xs text-gray-600">{supported ? 'Use your fingerprint, face, device PIN, or security key.' : 'Passkeys are unavailable here. You can sign in with your password below.'}</p>
+        <p className="text-center text-sm text-gray-500">or use your password</p>
+      </div>}
+      <form onSubmit={submit} className="space-y-4">
+        <div><label htmlFor="username" className="mb-1 block text-sm font-medium text-gray-700">Username</label>
+          <input className={inputClass} id="username" name="username" autoComplete={signup ? 'username' : 'username webauthn'} autoCapitalize="none" spellCheck={false} value={username} onChange={e => setUsername(e.target.value)} required maxLength={100} disabled={busy || registered} /></div>
+        <div><label htmlFor="password" className="mb-1 block text-sm font-medium text-gray-700">Password</label>
+          <input className={inputClass} id="password" name="password" type="password" autoComplete={signup && !registered ? 'new-password' : 'current-password'} value={password} onChange={e => setPassword(e.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '.*[0-9].*' : undefined} aria-describedby={signup ? 'password-help' : undefined} disabled={busy} />
+          {signup && <p id="password-help" className="mt-1 text-xs text-gray-600">Use at least 8 characters and a number. You can add a passkey after creating your account.</p>}</div>
+        {registered && <p className="text-sm text-gray-700">Your account was created. Sign in to finish setting up your passkey.</p>}
+        <button className={`${buttonClass} w-full`} disabled={busy} data-skip-tracking="true">{busy ? 'Please wait…' : signup && !registered ? 'Create account' : 'Sign in with password'}</button>
+      </form>
+      <p className="mt-6 text-center text-sm text-gray-600">{signup ? 'Already have an account?' : 'New to The DevTools Times?'}{' '}<a className="font-medium text-gray-900 underline" href={`${import.meta.env.BASE_URL}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'}</a></p>
+    </>}
+  </section>;
+}
