+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const journalProgress = document.getElementById('journal-progress');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const summaryOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en'
+    };
+
+    async function checkSummarySupport() {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'On-device summaries are not supported in this browser. Try a supported desktop browser over HTTPS; the full journal is available above.';
+        return;
+      }
+
+      try {
+        const availability = await window.Summarizer.availability(summaryOptions);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Your browser’s AI model is unavailable on this device. You can still read the full journal above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Get a few key points, generated on your device.'
+          : 'Your browser needs to download an AI model first. Select Summarize to prepare it; this may take a few minutes.';
+      } catch {
+        journalStatus.textContent = 'Could not check browser AI support. Reload the page to try again, or read the full journal above.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      if (summarizeButton.disabled) return;
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.hidden = true;
+      journalProgress.removeAttribute('value');
+      journalProgress.hidden = false;
+      journalStatus.textContent = 'Preparing your browser’s AI. The first use may require a model download.';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to preserve user activation for downloads.
+        summarizer = await window.Summarizer.create({
+          ...summaryOptions,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalProgress.max = event.total || 1;
+              journalProgress.value = event.loaded;
+            });
+          }
+        });
+        journalProgress.removeAttribute('value');
+        journalStatus.textContent = 'Reading the journal and creating your key points on this device…';
+        const result = await summarizer.summarize(document.getElementById('journal-text').innerText);
+        const points = result.split(/\n+/)
+          .map((line) => line.replace(/^\s*(?:[-*•] |\d+[.)]\s+)/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        // Treat generated output as text, never as HTML.
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI summary is ready below.';
+      } catch {
+        journalStatus.textContent = 'The browser could not create a summary. Select Summarize to try again. The full journal is still available above.';
+      } finally {
+        summarizer?.destroy();
+        journalProgress.hidden = true;
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkSummarySupport();
+  </script>
