+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summarization is not available in this browser. Try a supported browser on HTTPS or localhost. You can still read the full journal above.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI. First use may take a little longer…';
+      let summarizer;
+
+      try {
+        // Create directly from the click so model downloads retain user activation.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading browser AI model: ${Math.round(event.loaded * 100)}%. Keep this page open…`;
+            });
+          }
+        });
+
+        journalStatus.textContent = 'Summarizing the sourcing story on your device…';
+        const summary = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•–]\s*|\d+[.)]\s+)/, '').trim())
+          .filter(Boolean);
+
+        if (!points.length) throw new Error('Empty summary');
+
+        const items = points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        });
+        summaryPoints.replaceChildren(...items);
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Summary ready below. Generated by your browser’s AI; see the full journal for details.';
+      } catch (error) {
+        if (error.name === 'NotSupportedError') {
+          journalStatus.textContent = 'Your browser’s AI model is not available on this device. You can still read the full journal above.';
+        } else if (error.name === 'NotAllowedError') {
+          journalStatus.textContent = 'Your browser could not start its AI model. Check browser permissions, then select Summarize to try again.';
+        } else {
+          journalStatus.textContent = 'We could not create a summary. Please try again; if a model download is needed, check your connection.';
+        }
+      } finally {
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        summaryPanel.setAttribute('aria-busy', 'false');
+        if (summarizer) summarizer.destroy();
+      }
+    });
+  </script>
