+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-error');
+    const signupStatus = newsletter.querySelector('.newsletter-status');
+
+    // Use native email constraints, but control when feedback is displayed.
+    newsletter.noValidate = true;
+
+    function clearEmailError() {
+      email.removeAttribute('aria-invalid');
+      emailError.textContent = '';
+    }
+
+    function validateEmail() {
+      const valid = email.validity.valid;
+      email.setAttribute('aria-invalid', String(!valid));
+      emailError.textContent = valid ? '' : email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address, like you@example.com.';
+      return valid;
+    }
+
+    email.addEventListener('blur', validateEmail);
+    email.addEventListener('focus', clearEmailError);
+    email.addEventListener('input', () => {
+      clearEmailError();
+      signupStatus.textContent = '';
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signupStatus.textContent = '';
+      if (!validateEmail()) {
+        email.focus();
+        validateEmail();
+        return;
+      }
+
+      // A mailing-list service must be connected before subscriptions can be saved.
+      signupStatus.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
