diff --git a/components/drink-card.js b/components/drink-card.js
new file mode 100644
index 0000000..ee0d6a7
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,90 @@
+const template = document.createElement('template');
+
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-size: 1rem;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    *, ::slotted(*) {
+      box-sizing: border-box;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      font-size: 1.17em;
+      color: #4e342e;
+    }
+
+    p {
+      margin: 0;
+    }
+
+    /* Reset page styles on the supplied content as well as scoping our own. */
+    ::slotted(*) {
+      all: unset;
+      box-sizing: border-box;
+    }
+
+    ::slotted([slot="badge"]) {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    ::slotted(a[slot="action"]) {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    ::slotted(a[slot="action"]:hover) {
+      background: #3e2723;
+    }
+
+    ::slotted(a[slot="action"]:focus-visible) {
+      outline: 2px solid #4e342e;
+      outline-offset: 3px;
+    }
+  </style>
+  <article>
+    <slot name="badge"></slot>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
