+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    let promoNumber = 1;
+    let isBusy = false;
+
+    function showCard(card) {
+      // Older browsers need an explicit starting state for entry transitions.
+      const needsEntryFallback = !('CSSStartingStyleRule' in window);
+      if (needsEntryFallback) card.setAttribute('data-entering', '');
+      card.hidden = false;
+      if (needsEntryFallback) {
+        getComputedStyle(card).opacity;
+        card.removeAttribute('data-entering');
+      }
+    }
+
+    async function hideCard(card) {
+      if (card.hidden) return;
+      // Keep display intact during exit, including in browsers that cannot
+      // transition display. Only apply hidden once the fade and scale finish.
+      card.setAttribute('data-closing', '');
+      const animations = card.getAnimations();
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      card.hidden = true;
+      card.removeAttribute('data-closing');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      card.hidden = true;
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Promo ${promoNumber++}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover a new favorite with our seasonal coffee and bakery pairings.';
+      card.append(heading, description);
+      domContainer.appendChild(card);
+      showCard(card);
+      removeBtn.disabled = isBusy;
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.lastElementChild;
+      if (!card || isBusy) return;
+      isBusy = true;
+      removeBtn.disabled = true;
+      toggleBtn.disabled = true;
+      await hideCard(card);
+      card.remove();
+      isBusy = false;
+      toggleBtn.disabled = !toggleCard.isConnected;
+      removeBtn.disabled = domContainer.childElementCount === 0;
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (isBusy) return;
+      isBusy = true;
+      toggleBtn.disabled = true;
+      removeBtn.disabled = true;
+      if (toggleCard.hidden) {
+        showCard(toggleCard);
+      } else {
+        await hideCard(toggleCard);
+      }
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Default Promo' : 'Hide Default Promo';
+      isBusy = false;
+      toggleBtn.disabled = !toggleCard.isConnected;
+      removeBtn.disabled = domContainer.childElementCount === 0;
+    });
+  </script>
