+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let promoNumber = 0;
+
+    function animateCard(card, removing = false) {
+      const frames = [
+        { opacity: 0, transform: 'scale(0.9)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      return card.animate(removing ? frames.reverse() : frames, {
+        duration: reducedMotion.matches ? 0 : 300,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+    }
+
+    function updateControls() {
+      removeBtn.disabled = !domContainer.querySelector('.card:not([data-removing])');
+      toggleBtn.disabled = !toggleCard.isConnected || toggleCard.hasAttribute('data-removing');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoNumber}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover a new favorite with our locally roasted coffee. Ask in store about today’s specials.';
+      card.append(heading, description);
+      domContainer.append(card);
+      animateCard(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-removing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      card.setAttribute('data-removing', '');
+      updateControls();
+      if (!card.hidden) {
+        // Keep the card in the DOM until its exit animation finishes.
+        await animateCard(card, true).finished.catch(() => {});
+      }
+      card.remove();
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      if (!toggleCard.hidden) animateCard(toggleCard);
+    });
+  </script>
+
 </body>
 
