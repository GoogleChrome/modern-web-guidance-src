+<script>
+    (() => {
+      let active = null;
+      let closeTimer;
+
+      function positionPreview() {
+        if (!active) return;
+        const { trigger, panel } = active;
+        const rect = trigger.getBoundingClientRect();
+        const gap = 10;
+        const margin = 16;
+        const width = panel.offsetWidth;
+        const height = panel.offsetHeight;
+        const left = Math.max(margin, Math.min(
+          rect.left + (rect.width - width) / 2,
+          window.innerWidth - width - margin
+        ));
+        const below = rect.bottom + gap;
+        const top = below + height <= window.innerHeight - margin
+          ? below
+          : Math.max(margin, rect.top - height - gap);
+        panel.style.left = `${left}px`;
+        panel.style.top = `${top}px`;
+      }
+
+      function closePreview(restoreFocus = false) {
+        clearTimeout(closeTimer);
+        if (!active) return;
+        const { trigger, panel } = active;
+        if (restoreFocus && panel.contains(document.activeElement)) trigger.focus();
+        panel.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        active = null;
+      }
+
+      function openPreview(trigger, panel) {
+        clearTimeout(closeTimer);
+        if (active?.trigger === trigger) return;
+        closePreview();
+        active = { trigger, panel };
+        panel.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        positionPreview();
+      }
+
+      function scheduleClose() {
+        clearTimeout(closeTimer);
+        // Allow the pointer to cross the small gap between link and preview.
+        closeTimer = setTimeout(() => {
+          if (!active) return;
+          const { trigger, panel } = active;
+          if (trigger.matches(':hover') || panel.matches(':hover') ||
+              trigger === document.activeElement || panel.contains(document.activeElement)) return;
+          closePreview();
+        }, 180);
+      }
+
+      document.querySelectorAll('.preview-trigger').forEach(trigger => {
+        const panel = document.getElementById(trigger.getAttribute('aria-controls'));
+        trigger.addEventListener('pointerenter', event => {
+          if (event.pointerType !== 'touch') openPreview(trigger, panel);
+        });
+        trigger.addEventListener('focus', () => openPreview(trigger, panel));
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowDown') {
+            event.preventDefault();
+            openPreview(trigger, panel);
+            panel.querySelector('button').focus();
+          }
+        });
+        [trigger, panel].forEach(element => {
+          element.addEventListener('pointerleave', scheduleClose);
+          element.addEventListener('focusout', scheduleClose);
+        });
+        panel.addEventListener('pointerenter', () => clearTimeout(closeTimer));
+        panel.addEventListener('focusin', () => clearTimeout(closeTimer));
+        panel.querySelector('.preview-close').addEventListener('click', () => closePreview(true));
+      });
+
+      document.addEventListener('keydown', event => {
+        if (event.key === 'Escape' && active) {
+          event.preventDefault();
+          closePreview(true);
+        }
+      });
+      document.addEventListener('pointerdown', event => {
+        if (active && !active.trigger.contains(event.target) && !active.panel.contains(event.target)) {
+          closePreview();
+        }
+      });
+      window.addEventListener('resize', positionPreview);
+      window.addEventListener('scroll', positionPreview, { passive: true });
+    })();
+  </script>
