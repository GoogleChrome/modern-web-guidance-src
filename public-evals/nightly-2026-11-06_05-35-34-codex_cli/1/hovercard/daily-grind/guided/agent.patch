diff --git a/index.html b/index.html
index 66c9173..2019d96 100644
--- a/index.html
+++ b/index.html
@@ -135,6 +135,112 @@
       background: #3e2723;
     }
 
+    [interestfor] {
+      --interest-delay-start: 0.25s;
+      --interest-delay-end: 0.3s;
+      interest-delay: var(--interest-delay-start) var(--interest-delay-end);
+    }
+
+    .btn:focus-visible,
+    .drink-preview a:focus-visible,
+    .drink-preview summary:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .drink-preview {
+      display: none;
+      position: fixed;
+      width: min(340px, calc(100vw - 24px));
+      max-height: calc(100dvh - 24px);
+      overflow-y: auto;
+      padding: 24px;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 12px;
+      background: white;
+      color: var(--text);
+      text-align: left;
+      box-shadow: 0 12px 36px rgb(62 39 35 / 20%);
+    }
+
+    .drink-preview:popover-open {
+      display: block;
+    }
+
+    .drink-preview .eyebrow {
+      margin-bottom: 6px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+      color: #795548;
+    }
+
+    .drink-preview h4 {
+      margin-bottom: 8px;
+      font-size: 1.3rem;
+      line-height: 1.3;
+    }
+
+    .drink-preview dl {
+      display: grid;
+      grid-template-columns: auto 1fr;
+      gap: 6px 16px;
+      margin: 16px 0;
+      padding: 12px 0;
+      border-block: 1px solid #eee5e1;
+      font-size: 0.9rem;
+    }
+
+    .drink-preview dt {
+      font-weight: 600;
+    }
+
+    .drink-preview summary {
+      cursor: pointer;
+      font-weight: 600;
+    }
+
+    .drink-preview details p {
+      margin-top: 8px;
+      font-size: 0.9rem;
+    }
+
+    .drink-preview .btn {
+      display: block;
+      text-align: center;
+    }
+
+    @supports (position-area: block-end) {
+      [interestfor="maple-preview"] { anchor-name: --maple-preview; }
+      [interestfor="espresso-preview"] { anchor-name: --espresso-preview; }
+      [interestfor="cold-brew-preview"] { anchor-name: --cold-brew-preview; }
+      #maple-preview { position-anchor: --maple-preview; }
+      #espresso-preview { position-anchor: --espresso-preview; }
+      #cold-brew-preview { position-anchor: --cold-brew-preview; }
+
+      .drink-preview {
+        inset: auto;
+        margin: 8px 0;
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .drink-preview {
+        transition: opacity 0.15s, display 0.15s allow-discrete,
+          overlay 0.15s allow-discrete;
+      }
+
+      @starting-style {
+        .drink-preview:popover-open {
+          opacity: 0;
+        }
+      }
+    }
+
