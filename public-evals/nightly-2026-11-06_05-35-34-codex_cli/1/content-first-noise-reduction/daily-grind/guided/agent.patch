+  <script>
+    // Keep navigation available on upward scroll and whenever it has keyboard focus.
+    const navigation = document.querySelector('nav');
+    let lastY = window.scrollY;
+    window.addEventListener('scroll', () => {
+      const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+      const y = Math.max(0, Math.min(window.scrollY, maxY));
+      if (y === lastY) return;
+      navigation.classList.toggle('is-hidden', y > lastY && y > navigation.offsetHeight);
+      lastY = y;
+    }, { passive: true });
+    navigation.addEventListener('focusin', () => navigation.classList.remove('is-hidden'));
+  </script>
