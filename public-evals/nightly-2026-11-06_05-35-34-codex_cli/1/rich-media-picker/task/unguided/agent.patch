+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const listbox = document.getElementById('roast-options');
+    const selection = document.getElementById('roast-selection');
+    const options = Array.from(listbox.querySelectorAll('[role="option"]'));
+    const orderButton = document.getElementById('order-button');
+    let selectedIndex = 0;
+    let activeIndex = 0;
+    let search = '';
+    let searchTimeout;
+
+    function activate(index) {
+      activeIndex = (index + options.length) % options.length;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === activeIndex));
+      listbox.setAttribute('aria-activedescendant', options[activeIndex].id);
+      options[activeIndex].scrollIntoView({ block: 'nearest' });
+    }
+
+    function closePicker(restoreFocus = false) {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      search = '';
+      clearTimeout(searchTimeout);
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker(index = selectedIndex) {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      listbox.focus({ preventScroll: true });
+      activate(index);
+    }
+
+    function choose(index) {
+      selectedIndex = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      selection.replaceChildren(...options[index].querySelector('.roast-content').cloneNode(true).childNodes);
+      orderButton.href = '/order-online?roast=' + encodeURIComponent(options[index].dataset.value);
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => {
+      if (listbox.hidden) openPicker();
+      else closePicker(true);
+    });
+
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker(event.key === 'ArrowUp' ? options.length - 1 : selectedIndex);
+      }
+    });
+
+    listbox.addEventListener('keydown', (event) => {
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' ', 'Escape'].includes(event.key)) {
+        event.preventDefault();
+        if (event.key === 'ArrowDown') activate(activeIndex + 1);
+        if (event.key === 'ArrowUp') activate(activeIndex - 1);
+        if (event.key === 'Home') activate(0);
+        if (event.key === 'End') activate(options.length - 1);
+        if (event.key === 'Enter' || event.key === ' ') choose(activeIndex);
+        if (event.key === 'Escape') closePicker(true);
+      } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+        search += event.key.toLowerCase();
+        clearTimeout(searchTimeout);
+        searchTimeout = setTimeout(() => { search = ''; }, 600);
+        const match = options.findIndex(option => option.querySelector('strong').textContent.toLowerCase().startsWith(search));
+        if (match !== -1) activate(match);
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => choose(index));
+      option.addEventListener('pointermove', () => activate(index));
+    });
+
+    document.addEventListener('pointerdown', (event) => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+
+    picker.addEventListener('focusout', (event) => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
