+  <script type="module">
+    const actions = [...document.querySelectorAll('.loading-action')].map((container) => {
+      const link = container.querySelector('a');
+      const label = link.querySelector('.action-label');
+      return { link, label, spinner: container.querySelector('progress'), originalLabel: label.textContent };
+    });
+
+    function resetLoading() {
+      for (const { link, label, spinner, originalLabel } of actions) {
+        link.removeAttribute('aria-busy');
+        label.textContent = originalLabel;
+        spinner.hidden = true;
+      }
+    }
+
+    for (const { link, label, spinner } of actions) {
+      link.addEventListener('click', (event) => {
+        // Keep native navigation, including keyboard activation and opening new tabs.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        label.textContent = link.dataset.loadingLabel;
+        spinner.hidden = false;
+      });
+    }
+
+    // A restored page must not retain the navigation's pending state.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
