+  <script>
+    const cart = document.querySelector('.cart');
+    const list = cart.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    async function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-ready', 'is-removing');
+      const content = item.querySelector('.SwipeableList-content');
+      const name = item.querySelector('h3').textContent;
+      const button = item.querySelector('button');
+      const hadFocus = item.contains(document.activeElement);
+      const nextButton = item.nextElementSibling?.querySelector('button')
+        || item.previousElementSibling?.querySelector('button');
+      button.disabled = true;
+      const duration = reducedMotion.matches ? 0 : 220;
+      await content.animate([
+        { transform: getComputedStyle(content).transform },
+        { transform: `translateX(${direction * content.offsetWidth}px)` }
+      ], { duration, easing: 'ease-out', fill: 'forwards' }).finished;
+      await item.animate([
+        { height: `${item.offsetHeight}px`, marginBottom: '12px', opacity: 1 },
+        { height: '0px', marginBottom: '0px', opacity: 0 }
+      ], { duration, easing: 'ease-in-out', fill: 'forwards' }).finished;
+      item.remove();
+      const items = [...list.children];
+      cart.querySelector('#cart-count').textContent = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
+      cart.querySelector('#cart-total').textContent = currency.format(
+        items.reduce((total, row) => total + Number(row.dataset.price), 0) / 100
+      );
+      cart.querySelector('.cart-empty').hidden = items.length > 0;
+      cart.querySelector('.cart-status').textContent = `${name} removed. ${items.length} ${items.length === 1 ? 'item remains' : 'items remain'}.`;
+      if (hadFocus) {
+        if (nextButton?.isConnected && !nextButton.disabled) nextButton.focus();
+        else {
+          const heading = cart.querySelector('h2');
+          heading.tabIndex = -1;
+          heading.focus();
+        }
+      }
+    }
+
+    list.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(120, content.offsetWidth * 0.3);
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      };
+
+      item.querySelector('button').addEventListener('click', () => removeItem(item));
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, dx: 0, horizontal: false };
+      });
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { reset(); return; }
+          gesture.horizontal = true;
+          content.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.dx = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+      content.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const { dx, horizontal } = gesture;
+        gesture = null;
+        if (horizontal && Math.abs(dx) >= threshold()) removeItem(item, Math.sign(dx));
+        else reset();
+      });
+      content.addEventListener('pointercancel', reset);
+      content.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+      content.addEventListener('pointerleave', () => { if (gesture && !gesture.horizontal) reset(); });
+    });
+  </script>
 </body>
 
