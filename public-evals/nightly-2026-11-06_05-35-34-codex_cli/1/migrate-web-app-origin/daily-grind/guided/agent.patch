+export const MAX_BYTES = 65536;
+
+export function sameOrigin(candidate, trusted) {
+  try {
+    if ('Origin' in globalThis) return Origin.from(candidate).isSameOrigin(Origin.from(trusted));
+    const url = new URL(candidate);
+    return url.origin !== 'null' && url.origin === new URL(trusted).origin;
+  } catch { return false; }
+}
+
+export function validateSnapshot(data, config) {
+  if (!data || data.version !== 1 || data.from !== config.oldOrigin || data.to !== config.newOrigin ||
+      !data.settings || Array.isArray(data.settings) || typeof data.settings !== 'object' ||
+      new TextEncoder().encode(JSON.stringify(data)).length > MAX_BYTES ||
+      Object.entries(data.settings).some(([key, value]) => !config.keys.includes(key) || typeof value !== 'string')) {
+    throw new Error('This settings backup is invalid or belongs to a different app.');
+  }
+  return data;
+}
+
+export function snapshot(storage, config) {
+  const settings = Object.create(null);
+  for (const key of config.keys) {
+    const value = storage.getItem(key);
+    if (value !== null) settings[key] = value;
+  }
+  return validateSnapshot({ version: 1, from: config.oldOrigin, to: config.newOrigin, settings }, config);
+}
+
+export function restore(storage, data, config) {
+  validateSnapshot(data, config);
+  const previous = Object.entries(data.settings).map(([key]) => [key, storage.getItem(key)]);
+  try {
+    for (const [key, value] of Object.entries(data.settings)) storage.setItem(key, value);
+  } catch (error) {
+    for (const [key, value] of previous) {
+      try { value === null ? storage.removeItem(key) : storage.setItem(key, value); } catch { /* Keep source backup for retry. */ }
+    }
+    throw error;
+  }
+}
