@@ -0,0 +1,25 @@
+import { getDomain } from 'tldts';
+
+export function configuration(env = process.env) {
+  function origin(value) {
+    const url = new URL(value);
+    if (url.protocol !== 'https:' || url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
+      throw new Error('Origins must be HTTPS origins without paths, credentials, queries or fragments.');
+    }
+    return url.origin;
+  }
+  if (!env.OLD_ORIGIN || !env.NEW_ORIGIN) throw new Error('Set OLD_ORIGIN and NEW_ORIGIN to your real HTTPS origins.');
+  const oldOrigin = origin(env.OLD_ORIGIN);
+  const newOrigin = origin(env.NEW_ORIGIN);
+  const site = value => getDomain(new URL(value).hostname, { allowPrivateDomains: true });
+  if (oldOrigin === newOrigin || !site(oldOrigin) || site(oldOrigin) !== site(newOrigin)) {
+    throw new Error('Migration requires distinct origins on the same registrable domain.');
+  }
+  const oldId = new URL(env.OLD_APP_ID || '/', oldOrigin);
+  if (oldId.origin !== oldOrigin || oldId.hash || oldId.username || oldId.password) throw new Error('OLD_APP_ID must belong to OLD_ORIGIN and have no fragment or credentials.');
+  const keys = JSON.parse(env.CONFIG_KEYS || '["daily-grind:preferences"]');
+  if (!Array.isArray(keys) || !keys.length || keys.some(k => typeof k !== 'string' || !k || k.length > 200) || new Set(keys).size !== keys.length) {
+    throw new Error('CONFIG_KEYS must be a nonempty JSON array of unique localStorage setting keys.');
+  }
+  return { oldOrigin, newOrigin, oldId: oldId.href, keys };
+}
