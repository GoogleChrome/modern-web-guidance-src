+import { mkdir, writeFile, copyFile, rm } from 'node:fs/promises';
+import { configuration } from './config.mjs';
+
+const config = configuration();
+// Validate before replacing output. Each directory is deployed at its origin's root.
+await rm('dist', { recursive: true, force: true });
+for (const role of ['old', 'new']) {
+  const out = `dist/${role}`;
+  await mkdir(`${out}/.well-known`, { recursive: true });
+  for (const file of ['index.html', 'migration.html', 'migration.js', 'migration-core.js', 'migration.css', 'icon.svg']) {
+    await copyFile(file, `${out}/${file}`);
+  }
+  await writeFile(`${out}/migration-config.js`, `export default ${JSON.stringify({ ...config, role })};\n`);
+  const manifest = {
+    name: 'The Daily Grind', short_name: 'Daily Grind', id: role === 'old' ? config.oldId : '/',
+    start_url: '/', scope: '/', display: 'standalone', background_color: '#fafafa', theme_color: '#4e342e',
+    icons: [{ src: '/icon.svg', sizes: 'any', type: 'image/svg+xml', purpose: 'any' }]
+  };
+  if (role === 'old') manifest.migrate_to = { id: `${config.newOrigin}/`, install_url: `${config.newOrigin}/` };
+  else manifest.migrate_from = [{ id: config.oldId, install_url: `${config.oldOrigin}/`, behavior: 'suggest' }];
+  await writeFile(`${out}/manifest.webmanifest`, JSON.stringify(manifest, null, 2));
+  if (role === 'old') await writeFile(`${out}/.well-known/web-app-origin-association`, JSON.stringify({
+    [`${config.newOrigin}/`]: { allow_migration: true }
+  }, null, 2));
+}
+console.log('Built dist/old and dist/new. Deploy new first, then old; keep old reachable for settings transfer.');
