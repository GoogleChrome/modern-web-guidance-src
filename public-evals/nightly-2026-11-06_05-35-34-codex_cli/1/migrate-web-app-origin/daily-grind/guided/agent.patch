@@ -0,0 +1,120 @@
+import config from './migration-config.js';
+import { MAX_BYTES, sameOrigin, snapshot, restore } from './migration-core.js';
+
+const status = document.querySelector('#transfer-status');
+const say = message => { if (status) status.textContent = message; };
+const validRole = config && sameOrigin(location.href, config.role === 'old' ? config.oldOrigin : config.newOrigin);
+
+if (!validRole) {
+  say('Origin migration has not been configured for this deployment.');
+} else if (document.querySelector('#migration-notice')) {
+  const old = config.role === 'old';
+  document.querySelector('#migration-notice').hidden = false;
+  document.querySelector('#migration-description').textContent = old
+    ? `We’re moving to ${config.newOrigin}. Copy your settings before accepting the app update. Supported browsers can update your existing app and shortcuts. Otherwise, install the new app from your browser’s menu after transferring.`
+    : 'Welcome to our new home. If your settings are missing, transfer them from the old app or import a settings backup.';
+  const link = document.querySelector('#migration-link');
+  link.href = old ? config.newOrigin : '/migration.html';
+  link.textContent = old ? 'Visit the new site' : 'Import a settings backup';
+  if (!old) {
+    const oldSite = document.querySelector('#old-site-link');
+    oldSite.href = config.oldOrigin;
+    oldSite.hidden = false;
+  }
+  if (old) {
+    const transfer = document.querySelector('#transfer');
+    transfer.hidden = false;
+    document.querySelector('#export').hidden = false;
+    transfer.addEventListener('click', () => {
+      let data;
+      try { data = snapshot(localStorage, config); }
+      catch { say('Could not read your settings. Check storage access and try again.'); return; }
+      const nonce = crypto.randomUUID();
+      let popup;
+      let timer;
+      let closed;
+      let sent = false;
+      const cleanup = () => {
+        window.removeEventListener('message', receive);
+        clearTimeout(timer);
+        clearInterval(closed);
+        transfer.disabled = false;
+      };
+      const receive = event => {
+        if (event.source !== popup || !sameOrigin(event.origin, config.newOrigin) || event.data?.nonce !== nonce) return;
+        if (event.data.type === 'daily-grind:ready') {
+          sent = true;
+          popup.postMessage({ type: 'daily-grind:settings', nonce, payload: data }, config.newOrigin);
+        } else if (sent && event.data.type === 'daily-grind:saved') {
+          cleanup();
+          say('Settings copied. Continue in the new app window. Your original settings remain available here.');
+        } else if (sent && event.data.type === 'daily-grind:error') {
+          cleanup();
+          say('Settings could not be saved in the new app. Download a backup and try importing it there.');
+        }
+      };
+      window.addEventListener('message', receive);
+      // Keep the opener only for this trusted, exact-origin transfer handshake.
+      popup = window.open(`${config.newOrigin}/migration.html#${nonce}`, '_blank', 'popup,width=620,height=650');
+      if (!popup) { cleanup(); say('The transfer window was blocked. Allow popups or download a settings backup and import it on the new site.'); return; }
+      transfer.disabled = true;
+      say('Complete the transfer in the new window.');
+      timer = setTimeout(() => { cleanup(); say('Transfer timed out. Your original settings are safe; retry or use a backup.'); }, 60000);
+      closed = setInterval(() => {
+        if (popup.closed) { cleanup(); say('The transfer window closed. Retry or use a settings backup.'); }
+      }, 500);
+    });
+    document.querySelector('#export').addEventListener('click', () => {
+      try {
+        const url = URL.createObjectURL(new Blob([JSON.stringify(snapshot(localStorage, config))], { type: 'application/json' }));
+        const anchor = document.createElement('a');
+        anchor.href = url;
+        anchor.download = 'daily-grind-settings.json';
+        anchor.click();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+        say('Backup downloaded. Visit the new site and choose “Import a settings backup”.');
+      } catch { say('Could not create a backup. Check storage access and try again.'); }
+    });
+  }
+} else if (config.role === 'new') {
+  const controls = document.querySelector('#import-controls');
+  controls.hidden = false;
+  say('Transfer from the old app, or select a settings backup to import.');
+  document.querySelector('#import').addEventListener('click', async () => {
+    const file = document.querySelector('#backup').files[0];
+    if (!file) { say('Choose a settings backup first.'); return; }
+    try {
+      if (file.size > MAX_BYTES) throw new Error('Backup too large.');
+      restore(localStorage, JSON.parse(await file.text()), config);
+      say('Settings imported. Continue to The Daily Grind.');
+    } catch { say('Could not import this backup. Check that it is a Daily Grind settings backup and storage is available.'); }
+  });
+  const nonce = location.hash.slice(1);
+  const sender = window.opener;
+  if (sender && /^[a-f0-9-]{36}$/.test(nonce)) {
+    history.replaceState(null, '', location.pathname);
+    const cleanup = () => {
+      window.removeEventListener('message', receive);
+      clearTimeout(timer);
+      window.opener = null;
+    };
+    const receive = event => {
+      if (event.source !== sender || !sameOrigin(event.origin, config.oldOrigin) ||
+          event.data?.nonce !== nonce || event.data.type !== 'daily-grind:settings') return;
+      try {
+        restore(localStorage, event.data.payload, config);
+        sender.postMessage({ type: 'daily-grind:saved', nonce }, config.oldOrigin);
+        say('Your settings have been transferred. Continue to The Daily Grind.');
+      } catch {
+        sender.postMessage({ type: 'daily-grind:error', nonce }, config.oldOrigin);
+        say('Could not save your settings. You can still import a settings backup.');
+      }
+      cleanup();
+    };
+    window.addEventListener('message', receive);
+    const timer = setTimeout(() => { cleanup(); say('Transfer timed out. Retry from the old app or import a backup.'); }, 60000);
+    sender.postMessage({ type: 'daily-grind:ready', nonce }, config.oldOrigin);
+  }
+} else {
+  say('Open the old app’s home page to transfer or download your settings.');
+}
