+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+import { configuration } from '../scripts/config.mjs';
+import { sameOrigin, snapshot, restore, validateSnapshot } from '../migration-core.js';
+
+const env = { OLD_ORIGIN: 'https://old.example.co.uk', NEW_ORIGIN: 'https://app.example.co.uk' };
+const config = configuration(env);
+const key = config.keys[0];
+function storage(entries = []) {
+  const map = new Map(entries);
+  return { getItem: k => map.get(k) ?? null, setItem: (k, v) => map.set(k, v), removeItem: k => map.delete(k) };
+}
+
+test('deployment requires explicit HTTPS origins and same-site ownership, including private suffixes', () => {
+  assert.throws(() => configuration({}));
+  for (const next of ['http://app.example.co.uk', 'https://other.co.uk', env.OLD_ORIGIN, 'https://app.example.co.uk/path', 'https://user:pass@app.example.co.uk']) {
+    assert.throws(() => configuration({ ...env, NEW_ORIGIN: next }));
+  }
+  assert.throws(() => configuration({ OLD_ORIGIN: 'https://alice.github.io', NEW_ORIGIN: 'https://bob.github.io' }));
+  assert.equal(config.oldId, `${env.OLD_ORIGIN}/`);
+  assert.throws(() => configuration({ ...env, OLD_APP_ID: 'https://attacker.example/' }));
+});
+
+test('origin checks normalize default ports and reject spoofed, invalid, and opaque origins', () => {
+  assert.equal(sameOrigin('https://app.example.co.uk:443/path', config.newOrigin), true);
+  for (const value of ['null', 'data:text/plain,hi', 'https://app.example.co.uk.attacker.com', 'http://app.example.co.uk', 'https://app.example.co.uk:8443', 'bad']) {
+    assert.equal(sameOrigin(value, config.newOrigin), false);
+  }
+});
+
+test('transfers allowlisted settings only; preserves source and unrelated destination data', () => {
+  const source = storage([[key, '{"milk":"oat"}'], ['session-token', 'secret']]);
+  const dest = storage([[key, 'old'], ['other', 'keep']]);
+  restore(dest, snapshot(source, config), config);
+  assert.equal(dest.getItem(key), '{"milk":"oat"}');
+  assert.equal(dest.getItem('session-token'), null);
+  assert.equal(dest.getItem('other'), 'keep');
+  assert.equal(source.getItem(key), '{"milk":"oat"}');
+  restore(dest, snapshot(storage(), config), config);
+  assert.equal(dest.getItem(key), '{"milk":"oat"}');
+});
+
+test('rejects invalid, foreign, unknown-key, non-string and oversized backups before writing', () => {
+  const valid = snapshot(storage(), config);
+  for (const data of [null, { ...valid, version: 2 }, { ...valid, from: config.newOrigin }, { ...valid, to: config.oldOrigin }, { ...valid, settings: [] }, { ...valid, settings: { unknown: 'x' } }, { ...valid, settings: { [key]: {} } }, { ...valid, settings: { [key]: 'x'.repeat(65536) } }]) {
+    assert.throws(() => validateSnapshot(data, config));
+  }
+});
+
+test('failed writes roll back earlier settings and propagate error for retry', () => {
+  const multiple = { ...config, keys: ['a', 'b'] };
+  const dest = storage([['a', 'before']]);
+  const write = dest.setItem;
+  dest.setItem = (key, value) => { if (key === 'b') throw new Error('Quota exceeded'); write(key, value); };
+  assert.throws(() => restore(dest, { version: 1, from: config.oldOrigin, to: config.newOrigin, settings: { a: 'after', b: 'full' } }, multiple));
+  assert.equal(dest.getItem('a'), 'before');
+  assert.equal(dest.getItem('b'), null);
+});
+
+// Exercise client event handlers with window/DOM doubles, without launching a browser or server.
+const client = (await readFile(new URL('../migration.js', import.meta.url), 'utf8')).replace(/^import .*;\n/gm, '');
+function clientWindow(role, options = {}) {
+  const nodes = new Map();
+  const listeners = new Map();
+  const nonce = '12345678-1234-1234-1234-123456789abc';
+  function node(id) {
+    if (!nodes.has(id)) nodes.set(id, { hidden: true, textContent: '', handlers: {}, addEventListener(type, fn) { this.handlers[type] = fn; } });
+    return nodes.get(id);
+  }
+  const posts = [];
+  const peer = { postMessage: (...args) => posts.push(args), closed: false };
+  const window = {
+    opener: role === 'new' ? peer : null,
+    addEventListener: (type, fn) => listeners.set(type, fn),
+    removeEventListener: type => listeners.delete(type),
+    open: () => options.blocked ? null : peer
+  };
+  const local = options.storage || storage([[key, 'source-setting']]);
+  vm.runInNewContext(client, {
+    config: { ...config, role }, MAX_BYTES: 65536, sameOrigin, snapshot, restore,
+    document: { querySelector: id => id === '#migration-notice' && role === 'new' ? null : node(id) },
+    window, location: { href: role === 'old' ? config.oldOrigin : config.newOrigin, hash: `#${nonce}`, pathname: '/migration.html' },
+    localStorage: local, crypto: { randomUUID: () => nonce }, history: { replaceState() {} },
+    setTimeout: () => 1, clearTimeout() {}, setInterval: () => 2, clearInterval() {}
+  });
+  return { node, peer, posts, local, nonce, window,
+    message: (data, origin, source = peer) => listeners.get('message')?.({ data, origin, source }) };
+}
+
+test('sender requires the exact destination origin, popup and nonce before sending settings', () => {
+  const app = clientWindow('old');
+  app.node('#transfer').handlers.click();
+  const ready = { type: 'daily-grind:ready', nonce: app.nonce };
+  app.message(ready, 'https://app.example.co.uk.attacker.com');
+  app.message(ready, config.newOrigin, {});
+  app.message({ ...ready, nonce: 'wrong' }, config.newOrigin);
+  assert.equal(app.posts.length, 0);
+  app.message(ready, config.newOrigin);
+  assert.equal(app.posts.length, 1);
+  assert.equal(app.posts[0][1], config.newOrigin);
+  app.message({ type: 'daily-grind:saved', nonce: app.nonce }, config.newOrigin);
+  assert.match(app.node('#transfer-status').textContent, /Settings copied/);
+  assert.equal(app.node('#transfer').disabled, false);
+  assert.equal(app.local.getItem(key), 'source-setting');
+});
+
+test('blocked popup leaves retry and backup available', () => {
+  const app = clientWindow('old', { blocked: true });
+  app.node('#transfer').handlers.click();
+  assert.match(app.node('#transfer-status').textContent, /blocked/);
+  assert.equal(app.node('#transfer').disabled, false);
+});
+
+test('receiver rejects wrong peers and acknowledges only after storage succeeds', () => {
+  const app = clientWindow('new');
+  const message = { type: 'daily-grind:settings', nonce: app.nonce, payload: snapshot(storage([[key, 'transferred']]), config) };
+  assert.equal(app.posts[0][0].type, 'daily-grind:ready');
+  app.message(message, config.oldOrigin, {});
+  app.message(message, config.newOrigin);
+  assert.equal(app.local.getItem(key), 'source-setting');
+  app.message(message, config.oldOrigin);
+  assert.equal(app.local.getItem(key), 'transferred');
+  assert.equal(app.posts[1][0].type, 'daily-grind:saved');
+  assert.equal(app.window.opener, null);
+  app.message(message, config.oldOrigin);
+  assert.equal(app.posts.length, 2);
+});
+
+test('receiver reports storage failure rather than successful transfer', () => {
+  const local = storage();
+  local.setItem = () => { throw new Error('Storage unavailable'); };
+  const app = clientWindow('new', { storage: local });
+  app.message({ type: 'daily-grind:settings', nonce: app.nonce, payload: snapshot(storage([[key, 'value']]), config) }, config.oldOrigin);
+  assert.equal(app.posts[1][0].type, 'daily-grind:error');
+  assert.match(app.node('#transfer-status').textContent, /Could not save/);
+});
