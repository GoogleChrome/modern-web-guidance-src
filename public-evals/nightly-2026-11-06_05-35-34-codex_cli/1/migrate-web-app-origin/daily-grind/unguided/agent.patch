+'use strict';
+const $ = (selector) => document.querySelector(selector);
+const storageKey = 'daily-grind:preferences';
+const defaults = { appearance: 'system', notifications: false, startPage: 'home' };
+function readPreferences() {
+  try { return { ...defaults, ...JSON.parse(localStorage.getItem(storageKey) || '{}') }; }
+  catch { return { ...defaults }; }
+}
+let preferences = readPreferences();
+let transfer = null;
+let toastTimer;
+$('#current-origin').textContent = location.origin;
+$('#current-host').textContent = location.host;
+function toast(message) {
+  $('#toast').textContent = message;
+  $('#toast').hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { $('#toast').hidden = true; }, 4500);
+}
+function destinationURL() {
+  const raw = $('#destination').value.trim();
+  if (!raw) throw new Error('Enter the new HTTPS origin to continue.');
+  let url;
+  try { url = new URL(raw); } catch { throw new Error('Enter a valid origin, like https://app.example.com'); }
+  if (url.protocol !== 'https:') throw new Error('Use an HTTPS origin to keep your transfer secure.');
+  if (url.username || url.password || url.pathname !== '/' || url.search || url.hash) throw new Error('Enter only the origin, without a path, sign-in details, or query.');
+  if (url.origin === location.origin) throw new Error('Choose a different origin from your current app.');
+  return url;
+}
+$('#destination').addEventListener('input', () => {
+  $('#url-help').classList.remove('error');
+  $('#destination').removeAttribute('aria-invalid');
+  $('#url-help').textContent = 'Use a secure URL, like https://app.example.com';
+  try { $('#new-host').textContent = destinationURL().host; } catch { $('#new-host').textContent = 'New origin'; }
+});
+$('#destination').setAttribute('aria-describedby', 'url-help');
+for (const [input, summary] of [['#keep-config', '#config-summary'], ['#keep-shortcut', '#shortcut-summary']]) {
+  $(input).addEventListener('change', () => $(summary).classList.toggle('disabled', !$(input).checked));
+}
+function download(contents, type, name) {
+  const blob = new Blob([contents], { type });
+  const href = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = href;
+  anchor.download = name;
+  document.body.append(anchor);
+  anchor.click();
+  anchor.remove();
+  setTimeout(() => URL.revokeObjectURL(href), 10000);
+}
+$('#transfer-form').addEventListener('submit', (event) => {
+  event.preventDefault();
+  let url;
+  try { url = destinationURL(); }
+  catch (error) {
+    $('#url-help').textContent = error.message;
+    $('#url-help').classList.add('error');
+    $('#destination').setAttribute('aria-invalid', 'true');
+    $('#destination').focus();
+    return;
+  }
+  transfer = {
+    schemaVersion: 1, app: 'daily-grind', createdAt: new Date().toISOString(),
+    sourceOrigin: location.origin, destinationOrigin: url.origin,
+    preferences: $('#keep-config').checked ? readPreferences() : null,
+  };
+  $('#transfer-description').textContent = `The Daily Grind is heading to ${url.host}. Download your selected items below to bring them along.`;
+  const actions = $('#download-actions');
+  actions.replaceChildren();
+  if ($('#keep-config').checked) {
+    const button = document.createElement('button');
+    button.className = 'primary-button';
+    button.textContent = 'Download configuration backup ↓';
+    button.onclick = () => {
+      download(JSON.stringify(transfer, null, 2), 'application/json', 'daily-grind-transfer.json');
+      toast('Configuration backup downloaded. Keep it for your new origin.');
+    };
+    actions.append(button);
+  }
+  if ($('#keep-shortcut').checked) {
+    const button = document.createElement('button');
+    button.className = 'primary-button';
+    button.textContent = 'Download new shortcut ↓';
+    button.onclick = () => {
+      download(`[InternetShortcut]\r\nURL=${url.origin}/\r\n`, 'application/octet-stream', 'The Daily Grind.url');
+      toast('Shortcut downloaded. Move it to your desktop to use it.');
+    };
+    actions.append(button);
+  }
+  if (!actions.children.length) $('#transfer-description').textContent = `You chose to move without configuration or a shortcut. Open ${url.host} to continue.`;
+  $('#open-destination').href = url.origin;
+  $('#transfer-dialog').showModal();
+});
+for (const button of document.querySelectorAll('.close-dialog')) button.addEventListener('click', () => button.closest('dialog').close());
+for (const button of ['#guide-button', '#learn-button', '#support-button']) $(button).addEventListener('click', () => $('#guide-dialog').showModal());
+function escapeHTML(value) {
+  return String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
+}
+const titles = {
+  transfer: ['Give your app a new home.', 'Move to a new origin, and bring the little things that make it yours.', 'Transfer app'],
+  overview: ['Your workspace, at a glance.', 'A familiar place for the apps you use every day.', 'Overview'],
+  apps: ['A little space for your apps.', 'Manage your Daily Grind app and its next home.', 'My apps'],
+  settings: ['Make it feel like yours.', 'These preferences are included in your configuration backup.', 'Settings'],
+  backups: ['Everything, safely packed.', 'Restore your preferences at your new origin.', 'Backup & restore'],
+};
+function showPanel(name) {
+  if (!titles[name]) name = 'transfer';
+  const [title, description, label] = titles[name];
+  $('#page-title').textContent = title;
+  $('#page-description').textContent = description;
+  $('#breadcrumb').textContent = label;
+  document.querySelectorAll('[data-panel]').forEach((link) => link.classList.toggle('active', link.dataset.panel === name));
+  $('#transfer-panel').hidden = name !== 'transfer';
+  const panel = $('#secondary-panel');
+  panel.hidden = name === 'transfer';
+  if (name === 'transfer') return;
+  if (name === 'backups') {
+    panel.innerHTML = '<h2>Restore user configuration</h2><p>Select the configuration backup you downloaded before your move. Only Daily Grind preferences will be restored. Your backup must be intended for this origin.</p><label for="backup-file">Configuration backup (.json)</label><br><input id="backup-file" type="file" accept="application/json,.json"><p id="restore-status" role="status" class="backup-status"></p><button class="primary-button" id="restore-guide">View transfer guide ↗</button>';
+    $('#restore-guide').onclick = () => $('#guide-dialog').showModal();
+    $('#backup-file').onchange = async (event) => {
+      const file = event.target.files[0];
+      if (!file) return;
+      try {
+        if (file.size > 100000) throw new Error('This backup is too large. Choose a Daily Grind configuration file.');
+        const data = JSON.parse(await file.text());
+        if (data.schemaVersion !== 1 || data.app !== 'daily-grind' || !data.preferences || typeof data.preferences !== 'object' || Array.isArray(data.preferences)) throw new Error('Choose a valid Daily Grind configuration backup.');
+        if (data.destinationOrigin !== location.origin) throw new Error('This backup is intended for a different origin. Open its destination to restore it.');
+        const p = data.preferences;
+        if (!['system', 'light', 'dark'].includes(p.appearance) || typeof p.notifications !== 'boolean' || !['home', 'menu', 'rewards'].includes(p.startPage)) throw new Error('The backup contains invalid preferences.');
+        const clean = { appearance: p.appearance, notifications: p.notifications, startPage: p.startPage };
+        localStorage.setItem(storageKey, JSON.stringify(clean));
+        preferences = clean;
+        $('#restore-status').textContent = 'Configuration restored. Your preferences are now saved on this origin.';
+        toast('Your configuration has been restored.');
+      } catch (error) { $('#restore-status').textContent = error instanceof SyntaxError ? 'This file is not valid JSON. Choose your configuration backup.' : error.message; }
+      event.target.value = '';
+    };
+  } else if (name === 'settings') {
+    preferences = readPreferences();
+    panel.innerHTML = '<h2>User configuration</h2><p>Save the preferences you want to bring to your new home.</p><label class="settings-row">Appearance preference<select id="appearance"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label><label class="settings-row">Preferred start page<select id="start-page"><option value="home">Home</option><option value="menu">Menu</option><option value="rewards">Rewards</option></select></label><label class="settings-row">Notification preference<input type="checkbox" id="notifications"></label><p>These saved preferences travel with your backup. Browser notification permission must be granted separately at the new origin.</p><button id="save-settings" class="primary-button">Save preferences</button>';
+    $('#appearance').value = preferences.appearance;
+    $('#start-page').value = preferences.startPage;
+    $('#notifications').checked = preferences.notifications;
+    $('#save-settings').onclick = () => {
+      const next = { appearance: $('#appearance').value, startPage: $('#start-page').value, notifications: $('#notifications').checked };
+      try { localStorage.setItem(storageKey, JSON.stringify(next)); preferences = next; toast('Your preferences are saved on this device.'); }
+      catch { toast('Your browser could not save these preferences. Check storage permissions.'); }
+    };
+  } else {
+    panel.innerHTML = `<h2>${name === 'overview' ? 'Your personal workspace' : 'Your installed app'}</h2><p>The Daily Grind is ready for its next chapter. Prepare a configuration backup and a shortcut for a new origin.</p><div class="app-card"><div class="coffee-icon"><svg><use href="#coffee"/></svg></div><div><strong>The Daily Grind</strong><p>${escapeHTML(location.origin)}</p></div></div><a class="primary-button" href="#transfer">Prepare a transfer →</a>`;
+  }
+}
+window.addEventListener('hashchange', () => showPanel(location.hash.slice(1)));
+showPanel(location.hash.slice(1) || 'transfer');
