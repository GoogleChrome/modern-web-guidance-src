 </head>
 
 <body>
+  <div class="scroller" tabindex="-1" aria-label="Page content">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +272,40 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" inert aria-hidden="true">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const sentinel = scroller.querySelector('.scroll-sentinel');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Observe only the top boundary; no continuous scroll handler is needed.
+    const observer = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting;
+      if (!visible && document.activeElement === backToTop) {
+        scroller.focus({ preventScroll: true });
+      }
+      backToTop.inert = !visible;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+      backToTop.classList.toggle('is-visible', visible);
+    }, { root: scroller });
+
+    observer.observe(sentinel);
+
+    backToTop.addEventListener('click', () => {
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth'
+      });
+    });
+  </script>
+
 </body>
 
 </html>
