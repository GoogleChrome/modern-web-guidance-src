+      height: 120px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: max(24px, env(safe-area-inset-right));
+      bottom: max(24px, env(safe-area-inset-bottom));
+      z-index: 1001;
+      display: inline-flex;
