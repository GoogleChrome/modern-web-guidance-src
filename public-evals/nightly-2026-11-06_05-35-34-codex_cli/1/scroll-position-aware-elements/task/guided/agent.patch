diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,79 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+      container-name: page;
+      scroll-behavior: smooth;
+      /* The button's normal-flow space keeps the footer clear at the bottom. */
+      padding-bottom: 20px;
+    }
+
+    .scroll-sentinel {
+      height: 1px;
+      margin-bottom: -1px;
+      visibility: hidden;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      display: block;
+      width: max-content;
+      margin: 20px 20px 0 auto;
+      padding: 12px 18px;
+      border: 0;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      z-index: 1001;
+      /* Visibility also removes the hidden button from keyboard navigation. */
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition: visibility 0.25s, opacity 0.25s ease, translate 0.25s ease;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @container page scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .scroller.scrolled .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .back-to-top {
+        transition: none;
+        translate: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -155,10 +226,12 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
 
-  <nav>
+  <nav id="page-top" tabindex="-1">
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
@@ -206,7 +279,31 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" aria-label="Back to top">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+
+    backToTop.addEventListener('click', () => {
+      // Return keyboard focus before the button becomes hidden at the top.
+      document.getElementById('page-top').focus({ preventScroll: true });
+      scroller.scrollTo({ top: 0 });
+    });
+
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const observer = new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller, threshold: 1 });
+
+      observer.observe(scroller.querySelector('.scroll-sentinel'));
+    }
+  </script>
+
 </body>
 
 </html>
