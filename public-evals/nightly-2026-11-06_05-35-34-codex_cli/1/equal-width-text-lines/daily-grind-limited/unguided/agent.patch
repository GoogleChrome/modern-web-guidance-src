+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = [...heroHeading.querySelectorAll('span')];
+    let previousWidth = 0;
+
+    function fitHeadingLines(force = false) {
+      const width = heroHeading.getBoundingClientRect().width;
+      if (!width || (!force && width === previousWidth)) return;
+      previousWidth = width;
+
+      // Measure each line at the same size, then scale the font itself to fit.
+      headingLines.forEach(line => { line.style.fontSize = '100px'; });
+      const lineWidths = headingLines.map(line => line.getBoundingClientRect().width);
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${100 * width / lineWidths[index]}px`;
+      });
+    }
+
+    fitHeadingLines();
+    new ResizeObserver(() => fitHeadingLines()).observe(heroHeading);
+    document.fonts.ready.then(() => fitHeadingLines(true));
+  </script>
