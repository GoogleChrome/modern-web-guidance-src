+  <script>
+    (() => {
+      const themeMeta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+      const systemButton = document.getElementById('theme-system');
+      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+      const storageKey = 'daily-grind-theme';
+
+      function isDark() {
+        return themeMeta.content === 'dark' ||
+          (themeMeta.content === 'light dark' && systemTheme.matches);
+      }
+
+      function updateControls() {
+        toggle.setAttribute('aria-pressed', String(isDark()));
+        systemButton.hidden = themeMeta.content === 'light dark';
+      }
+
+      function setTheme(theme) {
+        themeMeta.content = theme;
+        updateControls();
+        try {
+          if (theme === 'light dark') {
+            localStorage.removeItem(storageKey);
+          } else {
+            localStorage.setItem(storageKey, theme);
+          }
+        } catch { /* The current page still switches if storage is blocked. */ }
+      }
+
+      toggle.addEventListener('click', () => setTheme(isDark() ? 'light' : 'dark'));
+      systemButton.addEventListener('click', () => setTheme('light dark'));
+      systemTheme.addEventListener('change', updateControls);
+      window.addEventListener('storage', (event) => {
+        if (event.key !== storageKey && event.key !== null) return;
+        themeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+          ? event.newValue : 'light dark';
+        updateControls();
+      });
+
+      updateControls();
+      toggle.hidden = false;
+    })();
+  </script>
+
