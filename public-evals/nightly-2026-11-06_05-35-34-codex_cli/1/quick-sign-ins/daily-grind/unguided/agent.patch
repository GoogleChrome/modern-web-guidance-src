+<script>
+    (() => {
+      // Same-origin authentication API contract:
+      // GET /api/auth/session -> { authenticated: boolean }
+      // POST /api/auth/passkey/options -> PublicKeyCredentialRequestOptions JSON
+      // POST /api/auth/passkey/verify <- serialized assertion
+      // POST /api/auth/password <- { username, password }
+      // Both verification endpoints must return { authenticated: true } only after
+      // server verification and setting a Secure, HttpOnly, SameSite session cookie.
+      // POST /api/auth/logout must invalidate that session.
+      // The server must validate Origin/CSRF, rate-limit passwords, and validate
+      // single-use passkey challenges, RP ID, origin, signatures and user handles.
+      const form = document.querySelector('#signin-form');
+      const username = document.querySelector('#username');
+      const password = document.querySelector('#password');
+      const passkeyButton = document.querySelector('#passkey-signin');
+      const status = document.querySelector('#auth-status');
+      const signInLink = document.querySelector('#signin-link');
+      const signOut = document.querySelector('#signout');
+      const continueLink = document.querySelector('#continue-link');
+      let authenticated = false;
+      let busy = false;
+      let destination = null;
+      let conditionalController;
+      let conditionalAvailable = false;
+      let requestGeneration = 0;
+      const passkeysAvailable = window.isSecureContext &&
+        !!window.PublicKeyCredential && !!navigator.credentials?.get;
+      passkeyButton.hidden = !passkeysAvailable;
+
+      function message(text, error = false) {
+        status.textContent = text;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        form.setAttribute('aria-busy', String(value));
+        form.querySelectorAll('button').forEach(button => { button.disabled = value; });
+        signOut.disabled = value;
+      }
+
+      async function api(path, body, signal) {
+        const response = await fetch('/api/auth/' + path, {
+          method: body === undefined ? 'GET' : 'POST',
+          credentials: 'same-origin', cache: 'no-store', signal,
+          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest',
+            ...(body === undefined ? {} : { 'Content-Type': 'application/json' }) },
+          ...(body === undefined ? {} : { body: JSON.stringify(body) })
+        });
+        if (!response.ok) {
+          if (response.status === 401 && path === 'password') {
+            throw new Error('Email or password not recognized. Please try again.');
+          }
+          throw new Error('Sign-in is unavailable right now. Please try again shortly.');
+        }
+        if (!response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is unavailable right now. Please try again shortly.');
+        }
+        return response.json();
+      }
+
+      function stopConditional() {
+        requestGeneration++;
+        conditionalController?.abort();
+        conditionalController = undefined;
+      }
+
+      function showSession(value) {
+        authenticated = value;
+        form.hidden = value;
+        signInLink.hidden = value;
+        signOut.hidden = !value;
+        document.querySelector('#signin-title').textContent = value ? 'You’re signed in.' : 'Welcome back.';
+        document.querySelector('#signin-hint').hidden = value;
+        document.querySelector('#signin-description').textContent = value
+          ? 'Your next coffee is calling. Keep exploring your Daily Grind.'
+          : 'Sign in for your rewards, your favorites, and a quicker coffee run. Stay right here while you do.';
+        continueLink.hidden = !value || !destination;
+        if (value && destination) {
+          continueLink.href = destination.href;
+          continueLink.textContent = 'Continue to ' + destination.label;
+        }
+      }
+
+      function verified(result) {
+        if (result.authenticated !== true) throw new Error('Sign-in could not be verified. Please try again.');
+        stopConditional();
+        password.value = '';
+        showSession(true);
+        message('Welcome back! You can keep browsing.');
+        if (destination) continueLink.focus();
+        else signOut.focus();
+      }
+
+      function decode(value) {
+        const raw = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
+        return Uint8Array.from(raw, character => character.charCodeAt(0));
+      }
+
+      function encode(value) {
+        return btoa(String.fromCharCode(...new Uint8Array(value)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      async function passkey(conditional = false) {
+        if (busy || authenticated) return;
+        stopConditional();
+        const generation = requestGeneration;
+        const controller = new AbortController();
+        if (conditional) conditionalController = controller;
+        else { setBusy(true); message('Choose your passkey in your browser.'); }
+        try {
+          const options = await api('passkey/options', {}, controller.signal);
+          if (generation !== requestGeneration) return;
+          const publicKey = { ...options, challenge: decode(options.challenge) };
+          if (conditional) publicKey.allowCredentials = [];
+          else if (options.allowCredentials) {
+            publicKey.allowCredentials = options.allowCredentials.map(item => ({ ...item, id: decode(item.id) }));
+          }
+          const credential = await navigator.credentials.get({
+            publicKey, ...(conditional ? { mediation: 'conditional' } : {}), signal: controller.signal
+          });
+          if (!credential || generation !== requestGeneration) return;
+          if (conditional) setBusy(true);
+          const response = credential.response;
+          verified(await api('passkey/verify', {
+            id: credential.id, rawId: encode(credential.rawId), type: credential.type,
+            authenticatorAttachment: credential.authenticatorAttachment,
+            response: {
+              clientDataJSON: encode(response.clientDataJSON),
+              authenticatorData: encode(response.authenticatorData), signature: encode(response.signature),
+              userHandle: response.userHandle ? encode(response.userHandle) : null
+            }, clientExtensionResults: credential.getClientExtensionResults()
+          }, controller.signal));
+        } catch (error) {
+          if (error.name !== 'AbortError' && (!conditional || busy)) {
+            message(error.name === 'NotAllowedError'
+              ? 'No passkey selected. Try again or use your password.'
+              : 'Passkey sign-in is unavailable right now. You can try your password.', true);
+          }
+        } finally {
+          // An aborted background request must not unlock another active sign-in.
+          if (!conditional || generation === requestGeneration || authenticated) setBusy(false);
+          if (!conditional && !authenticated) startConditional();
+        }
+      }
+
+      function startConditional() {
+        if (conditionalAvailable && !authenticated && !busy) void passkey(true);
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (busy) return;
+        stopConditional();
+        setBusy(true);
+        message('Signing you in…');
+        try {
+          verified(await api('password', { username: username.value.trim(), password: password.value }));
+        } catch (error) { message(error.message, true); }
+        finally { setBusy(false); if (!authenticated) startConditional(); }
+      });
+      passkeyButton.addEventListener('click', () => void passkey());
+      document.querySelectorAll('[data-signin], #signin-link').forEach(link => {
+        link.addEventListener('click', event => {
+          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+          if (authenticated && link.dataset.signin) return;
+          event.preventDefault();
+          destination = link.dataset.signin ? { href: link.href, label: link.dataset.signin } : null;
+          message(destination ? 'Sign in here to continue to ' + destination.label + '.' : 'Sign in here and keep exploring.');
+          document.querySelector('#signin').scrollIntoView({ block: 'center' });
+          username.focus({ preventScroll: true });
+        });
+      });
+      signOut.addEventListener('click', async () => {
+        if (busy) return;
+        setBusy(true);
+        try {
+          await api('logout', {});
+          destination = null;
+          showSession(false);
+          message('You’re signed out. See you for your next cup.');
+          username.focus();
+        } catch { message('Could not sign out. Please try again.', true); }
+        finally { setBusy(false); if (!authenticated) startConditional(); }
+      });
+      window.addEventListener('pagehide', stopConditional);
+      window.addEventListener('pageshow', event => { if (event.persisted) initialize(); });
+      async function initialize() {
+        const generation = requestGeneration;
+        try {
+          const session = await api('session');
+          if (generation === requestGeneration && !busy) showSession(session.authenticated === true);
+        }
+        catch { /* Browsing and password autofill remain available if the API is offline. */ }
+        if (passkeysAvailable && typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+          try { conditionalAvailable = await PublicKeyCredential.isConditionalMediationAvailable(); }
+          catch { conditionalAvailable = false; }
+          startConditional();
+        }
+      }
+      void initialize();
+    })();
+  </script>
