diff --git a/widget.js b/widget.js
new file mode 100644
index 0000000..a253105
--- /dev/null
+++ b/widget.js
@@ -0,0 +1,9 @@
+// The referrer supplies only the reply destination, never a trust decision.
+// With no referrer, keep the widget local rather than broadcasting to '*'.
+if (document.referrer) {
+  const targetOrigin = new URL(document.referrer).origin;
+  if (targetOrigin !== 'null') {
+    parent.postMessage({ type: 'init' }, targetOrigin);
+    parent.postMessage({ type: 'widget-status', message: 'Ready to take your coffee order.' }, targetOrigin);
+  }
+}
