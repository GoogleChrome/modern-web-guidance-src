diff --git a/security.mjs b/security.mjs
new file mode 100644
index 0000000..5fc8142
--- /dev/null
+++ b/security.mjs
@@ -0,0 +1,70 @@
+// Deployment configuration: replace these with domains controlled by Daily Grind.
+export const TRUSTED_ORDERING_ORIGIN = 'https://orders.dailygrind.example';
+export const TRUSTED_SITE_DOMAIN = 'dailygrind.example';
+
+export function createValidation({ baseUrl, OriginAPI = globalThis.Origin }) {
+  const base = new URL(baseUrl);
+  const supportsOrigin = typeof OriginAPI?.from === 'function';
+
+  function trustedOrderingMessage(event) {
+    try {
+      if (supportsOrigin) {
+        let sender;
+        try {
+          sender = OriginAPI.from(event);
+        } catch {
+          // Synthetic MessageEvents lack the browser's internal origin.
+          sender = OriginAPI.from(event.origin);
+        }
+        return !sender.opaque && sender.isSameOrigin(OriginAPI.from(TRUSTED_ORDERING_ORIGIN));
+      }
+      const sender = new URL(event.origin);
+      return sender.origin !== 'null' && sender.origin === new URL(TRUSTED_ORDERING_ORIGIN).origin;
+    } catch {
+      return false;
+    }
+  }
+
+  function sameSiteUrl(candidate) {
+    try {
+      if (typeof candidate !== 'string' && !(candidate instanceof URL)) return null;
+      const url = new URL(candidate, base);
+      if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) return null;
+      if (supportsOrigin) {
+        const origin = OriginAPI.from(url);
+        return !origin.opaque && origin.isSameSite(OriginAPI.from(base)) ? url : null;
+      }
+      // Never infer a registrable domain by splitting a hostname. Only this
+      // explicitly controlled domain may use the cross-subdomain fallback.
+      const controlledHost = (host) => host === TRUSTED_SITE_DOMAIN || host.endsWith(`.${TRUSTED_SITE_DOMAIN}`);
+      const allowedHost = url.hostname === base.hostname ||
+        (controlledHost(base.hostname) && controlledHost(url.hostname));
+      return url.protocol === base.protocol && allowedHost ? url : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function createWidgetValidator(expectedWindow) {
+    let pinned = false;
+    let pinnedOrigin;
+    return (event) => {
+      if (!expectedWindow || event.source !== expectedWindow) return false;
+      try {
+        // Do not parse event.origin here: all opaque senders serialize to "null".
+        const sender = supportsOrigin ? OriginAPI.from(event) : null;
+        if (supportsOrigin ? !sender.opaque : event.origin !== 'null') return false;
+        if (!pinned) {
+          if (event.data?.type !== 'init') return false;
+          pinnedOrigin = sender;
+          pinned = true;
+        }
+        return !supportsOrigin || sender.isSameOrigin(pinnedOrigin);
+      } catch {
+        return false;
+      }
+    };
+  }
+
+  return { trustedOrderingMessage, sameSiteUrl, createWidgetValidator };
+}
diff --git a/security.test.mjs b/security.test.mjs
new file mode 100644
index 0000000..972142e
--- /dev/null
+++ b/security.test.mjs
@@ -0,0 +1,189 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createValidation, TRUSTED_ORDERING_ORIGIN } from './security.mjs';
+
+const fallback = (baseUrl = 'https://www.dailygrind.example/menu') =>
+  createValidation({ baseUrl, OriginAPI: null });
+
+test('ordering messages require the exact normalized origin', () => {
+  const { trustedOrderingMessage: accepts } = fallback();
+  assert.equal(accepts({ origin: TRUSTED_ORDERING_ORIGIN }), true);
+  assert.equal(accepts({ origin: 'https://orders.dailygrind.example:443' }), true);
+  for (const origin of [
+    'https://orders.dailygrind.example.evil.test',
+    'https://dailygrind.example', 'https://orders.dailygrind.example:8443',
+    'http://orders.dailygrind.example', 'null', '', 'not a URL',
+  ]) assert.equal(accepts({ origin }), false, origin);
+});
+
+test('redirects resolve relative URLs and allow controlled same-site subdomains and ports', () => {
+  const { sameSiteUrl } = fallback();
+  assert.equal(sameSiteUrl('../checkout?item=coffee#pay').href, 'https://www.dailygrind.example/checkout?item=coffee#pay');
+  assert.equal(sameSiteUrl('https://billing.dailygrind.example:8443/orders').port, '8443');
+  assert.equal(sameSiteUrl('https://WWW.DAILYGRIND.EXAMPLE:443/menu').port, '');
+});
+
+test('redirects reject spoofing, unsafe schemes, credentials and malformed input', () => {
+  const { sameSiteUrl } = fallback();
+  for (const url of [
+    '//evil.test/path', 'https://dailygrind.example.evil.test',
+    'https://evildailygrind.example', 'http://www.dailygrind.example',
+    'https://dailygrind.example@evil.test', 'https://user@www.dailygrind.example',
+    'https://www.dailygrind.example\\@evil.test',
+    'javascript:alert(1)', 'data:text/html,hello', 'blob:https://www.dailygrind.example/id',
+    'https://[', null, {},
+  ]) {
+    // A backslash terminates the authority: URL parsing makes this a safe local path.
+    if (url === 'https://www.dailygrind.example\\@evil.test') {
+      assert.equal(sameSiteUrl(url).hostname, 'www.dailygrind.example');
+    } else assert.equal(sameSiteUrl(url), null, String(url));
+  }
+});
+
+test('fallback never guesses sites for public suffixes or shared hosting', () => {
+  for (const [base, other] of [
+    ['https://shop.example.co.uk', 'https://attacker.co.uk'],
+    ['https://tenant-a.github.io', 'https://tenant-b.github.io'],
+    ['https://shop.example.co.uk', 'https://billing.example.co.uk'],
+  ]) assert.equal(fallback(base).sameSiteUrl(other), null);
+  assert.ok(fallback('http://localhost:11222').sameSiteUrl('http://localhost:9000/menu'));
+});
+
+test('sandbox fallback pins only after init from the expected window', () => {
+  const widget = {};
+  const other = {};
+  const accepts = fallback().createWidgetValidator(widget);
+  const event = (source, type, origin = 'null') => ({ source, data: { type }, origin });
+  assert.equal(accepts(event(widget, 'widget-status')), false);
+  assert.equal(accepts(event(other, 'init')), false);
+  assert.equal(accepts(event(widget, 'init', TRUSTED_ORDERING_ORIGIN)), false);
+  assert.equal(accepts(event(widget, 'init')), true);
+  assert.equal(accepts(event(widget, 'widget-status')), true);
+  assert.equal(accepts(event(other, 'widget-status')), false);
+  assert.equal(fallback().createWidgetValidator(null)(event(null, 'init')), false);
+});
+
+// Origin is not available in Node. These API contract tests model identities
+// supplied by the browser; they do not claim to test its PSL implementation.
+function originFixture() {
+  const origins = new Map();
+  const calls = [];
+  const api = { from(input) {
+    calls.push(input);
+    if (!origins.has(input)) throw new TypeError('No internal origin');
+    return origins.get(input);
+  } };
+  return { api, origins, calls };
+}
+
+test('native sandbox branch preserves opaque identity and never reparses null', () => {
+  const { api, origins, calls } = originFixture();
+  const widget = {};
+  const other = {};
+  const identity = {};
+  const opaque = (id) => ({ opaque: true, isSameOrigin: (peer) => peer.id === id, id });
+  const event = (source, type, origin = opaque(identity)) => {
+    const message = { source, origin: 'null', data: { type } };
+    origins.set(message, origin);
+    return message;
+  };
+  const accepts = createValidation({ baseUrl: 'https://dailygrind.example', OriginAPI: api }).createWidgetValidator(widget);
+  assert.equal(accepts(event(other, 'init')), false);
+  assert.equal(accepts(event(widget, 'widget-status')), false);
+  assert.equal(accepts(event(widget, 'init', { opaque: false })), false);
+  assert.equal(accepts(event(widget, 'init')), true);
+  assert.equal(accepts(event(widget, 'widget-status')), true);
+  assert.equal(accepts(event(other, 'widget-status')), false);
+  // A navigation keeps the WindowProxy but changes its opaque identity.
+  assert.equal(accepts(event(widget, 'init', opaque({}))), false);
+  assert.equal(accepts({ source: widget, origin: 'null', data: { type: 'init' } }), false);
+  assert.equal(calls.includes('null'), false);
+});
+
+test('native ordering branch accepts extracted origin and synthetic tuple fallback', () => {
+  const { api, origins } = originFixture();
+  const trusted = { opaque: false, isSameOrigin: (peer) => peer === trusted };
+  origins.set(TRUSTED_ORDERING_ORIGIN, trusted);
+  const validation = createValidation({ baseUrl: 'https://dailygrind.example', OriginAPI: api });
+  const real = { origin: TRUSTED_ORDERING_ORIGIN };
+  origins.set(real, trusted);
+  assert.equal(validation.trustedOrderingMessage(real), true);
+  assert.equal(validation.trustedOrderingMessage({ origin: TRUSTED_ORDERING_ORIGIN }), true);
+  assert.equal(validation.trustedOrderingMessage({ origin: 'null' }), false);
+});
+
+test('native site validation uses Origin objects and fails closed on errors', () => {
+  const api = { from(url) {
+    assert.ok(url instanceof URL);
+    return { opaque: false, isSameSite(peer) {
+      assert.equal(peer.marker, 'site');
+      return url.hostname === 'billing.example.co.uk';
+    }, marker: 'site' };
+  } };
+  const { sameSiteUrl } = createValidation({ baseUrl: 'https://shop.example.co.uk', OriginAPI: api });
+  assert.ok(sameSiteUrl('https://billing.example.co.uk'));
+  assert.equal(sameSiteUrl('https://attacker.co.uk'), null);
+  const broken = createValidation({ baseUrl: 'https://dailygrind.example', OriginAPI: { from() { throw new TypeError(); } } });
+  assert.equal(broken.sameSiteUrl('/menu'), null);
+});
+
+test('page receiver gates status, redirects, links and widget initialization', async () => {
+  const originalWindow = globalThis.window;
+  const originalDocument = globalThis.document;
+  const listeners = new Map();
+  const navigations = [];
+  const widgetWindow = {};
+  const widget = { contentWindow: widgetWindow };
+  const status = { textContent: 'Initial status' };
+  const orderLink = { href: '/order-online' };
+  const externalRelations = new Set();
+  const internalRelations = new Set();
+  globalThis.window = {
+    location: {
+      href: 'https://www.dailygrind.example/?returnTo=https%3A%2F%2Fevil.test',
+      assign: (url) => navigations.push(url),
+    },
+    addEventListener: (type, listener) => listeners.set(type, listener),
+  };
+  globalThis.document = {
+    querySelector: (selector) => ({ '#order-status': status, '#ordering-widget': widget, '#order-now': orderLink })[selector],
+    querySelectorAll: () => [
+      { href: 'https://evil.test', relList: { add: (...values) => values.forEach((value) => externalRelations.add(value)) } },
+      { href: 'https://www.dailygrind.example/menu', relList: { add: (...values) => values.forEach((value) => internalRelations.add(value)) } },
+    ],
+  };
+  try {
+    await import('./daily-grind.mjs');
+    const receive = listeners.get('message');
+    assert.equal(typeof receive, 'function');
+    assert.equal(widget.src, './widget.html');
+    assert.equal(orderLink.href, '/order-online');
+    assert.deepEqual([...externalRelations], ['external', 'noopener', 'noreferrer']);
+    assert.equal(internalRelations.size, 0);
+    const send = (data, origin = TRUSTED_ORDERING_ORIGIN, source = {}) => receive({ data, origin, source });
+    send({ type: 'order-status', message: 'Forged' }, 'https://evil.test');
+    send(null);
+    send({ type: 'order-status', message: {} });
+    assert.equal(status.textContent, 'Initial status');
+    send({ type: 'order-status', message: '<b>Order ready</b>' });
+    assert.equal(status.textContent, '<b>Order ready</b>');
+    send({ type: 'redirect', url: 'https://evil.test' });
+    send({ type: 'redirect', url: '/checkout' }, 'https://evil.test');
+    assert.equal(navigations.length, 0);
+    send({ type: 'redirect', url: 'https://billing.dailygrind.example/orders' });
+    assert.deepEqual(navigations, ['https://billing.dailygrind.example/orders']);
+    send({ type: 'widget-status', message: 'Too early' }, 'null', widgetWindow);
+    assert.equal(status.textContent, '<b>Order ready</b>');
+    send({ type: 'init' }, 'null', widgetWindow);
+    send({ type: 'widget-status', message: 'Widget ready' }, 'null', widgetWindow);
+    send({ type: 'widget-status', message: 'Impostor' }, 'null');
+    send({ type: 'redirect', url: '/checkout' }, 'null', widgetWindow);
+    assert.equal(status.textContent, 'Widget ready');
+    assert.equal(navigations.length, 1);
+  } finally {
+    if (originalWindow === undefined) delete globalThis.window;
+    else globalThis.window = originalWindow;
+    if (originalDocument === undefined) delete globalThis.document;
+    else globalThis.document = originalDocument;
+  }
+});
