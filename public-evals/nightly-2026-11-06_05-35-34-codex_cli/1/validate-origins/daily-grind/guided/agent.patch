new file mode 100644
index 0000000..cd41fa2
--- /dev/null
+++ b/README.md
@@ -0,0 +1,31 @@
+# The Daily Grind
+
+Static page; run `npm test` for validation regression tests. No build is required.
+
+Before deployment, set `TRUSTED_ORDERING_ORIGIN` and `TRUSTED_SITE_DOMAIN` in
+`security.mjs` to the ordering service and private registrable domain you control.
+The checked-in values use the reserved `dailygrind.example` domain.
+
+Ordering messages accept `{ type: 'order-status', message }` or
+`{ type: 'redirect', url }` from the exact trusted origin. Redirects and the
+optional `?returnTo=` Order Now destination must be HTTP(S), credential-free,
+and schemefully same-site with the current page. Links outside that site receive
+`external noopener noreferrer` relations.
+
+Where available, the Origin API supplies public-suffix-aware site checks and
+opaque sender identities. Without it, site checks allow the same hostname or
+subdomains of the explicitly configured private domain (only when the page
+itself is on that domain). Other cross-subdomain destinations fail closed;
+there is no hostname-splitting heuristic.
+
+The `allow-scripts` sandbox widget must send `init` from its expected window
+before status messages are accepted. With the Origin API its opaque identity
+is pinned for the page lifetime, including across iframe navigations. Without
+that API the fallback checks the expected WindowProxy and a `null` origin;
+it cannot distinguish navigations within that same iframe. Other iframe windows
+are always rejected. Widgets cannot redirect the page. A reload of the page
+establishes a fresh widget session.
+
+Tests run in Node without a browser. Origin API branches use explicit API
+fixtures; real browser origin extraction and public suffix processing are not
+exercised by those tests.
diff --git a/daily-grind.mjs b/daily-grind.mjs
new file mode 100644
index 0000000..a12f184
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,43 @@
+import { createValidation } from './security.mjs';
+
+const validation = createValidation({ baseUrl: window.location.href });
+const status = document.querySelector('#order-status');
+const widget = document.querySelector('#ordering-widget');
+const acceptsWidget = validation.createWidgetValidator(widget.contentWindow);
+
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+  if (validation.trustedOrderingMessage(event)) {
+    if (data.type === 'order-status' && typeof data.message === 'string' && data.message.length <= 500) {
+      status.textContent = data.message;
+    } else if (data.type === 'redirect' && typeof data.url === 'string') {
+      const target = validation.sameSiteUrl(data.url);
+      if (target) window.location.assign(target.href);
+    }
+    return;
+  }
+
+  // Sandboxed widgets can update status, but cannot issue ordering redirects.
+  if (!acceptsWidget(event)) return;
+  if (data.type === 'widget-status' && typeof data.message === 'string' && data.message.length <= 500) {
+    status.textContent = data.message;
+  }
+});
+
+const returnTo = new URL(window.location.href).searchParams.get('returnTo');
+if (returnTo) {
+  const target = validation.sameSiteUrl(returnTo);
+  if (target) document.querySelector('#order-now').href = target.href;
+}
+
+// Classify parsed links with the same policy used for redirects.
+for (const link of document.querySelectorAll('a[href]')) {
+  if (!validation.sameSiteUrl(link.href)) {
+    link.relList.add('external', 'noopener', 'noreferrer');
+  }
+}
+
+// Install the receiver before starting the sandboxed document.
+widget.src = './widget.html';
