diff --git a/page.mjs b/page.mjs
new file mode 100644
index 0000000..74d4860
--- /dev/null
+++ b/page.mjs
@@ -0,0 +1,38 @@
+import { createMessageHandler, externalLink } from './message-security.mjs';
+
+const widget = document.getElementById('ordering-widget');
+const status = document.getElementById('ordering-status');
+
+window.addEventListener('message', createMessageHandler({
+  pageURL: window.location.href,
+  widgetWindow: widget.contentWindow,
+  redirect: url => window.location.assign(url),
+  openExternal: url => window.open(url, '_blank', 'noopener,noreferrer'),
+  setStatus: text => { status.textContent = text; },
+  resizeWidget: height => { widget.style.height = `${height}px`; },
+}));
+
+// Validate outbound anchors too, including links inserted after page load.
+document.addEventListener('click', event => {
+  const anchor = event.target.closest?.('a[href]');
+  if (!anchor) return;
+  let url;
+  try {
+    url = new URL(anchor.getAttribute('href'), window.location.href);
+  } catch {
+    event.preventDefault();
+    return;
+  }
+  if (url.origin !== window.location.origin || !['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    const safeURL = externalLink(anchor.getAttribute('href'), window.location.href);
+    if (!safeURL) {
+      event.preventDefault();
+      return;
+    }
+    anchor.href = safeURL;
+    anchor.rel = 'noopener noreferrer';
+  }
+});
+
+// Attach the listener before loading the widget so its initialization is seen.
+widget.src = './ordering-widget.html';
