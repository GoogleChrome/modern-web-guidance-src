+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Ordering widget</title>
+  <style>
+    body { margin: 0; padding: 12px; font: 16px 'Segoe UI', sans-serif; color: #3e2723; text-align: center; }
+  </style>
+</head>
+<body>
+  <p style="margin: 0;">Fresh coffee is a click away.</p>
+  <script>
+    // The sandbox gives this document an opaque origin. The parent verifies
+    // our WindowProxy; '*' is necessary because the host origin varies.
+    parent.postMessage({ type: 'widget:init' }, '*');
+    parent.postMessage({ type: 'widget:status', text: 'Online ordering is ready.' }, '*');
+    parent.postMessage({ type: 'widget:resize', height: 48 }, '*');
+  </script>
+</body>
+</html>
