--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,23 @@
+import type { ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ id, title, onClose, children }: Props) {
+  return (
+    <dialog id={id} aria-labelledby={`${id}-title`} closedby="any"
+      onClose={onClose} className="overlay-dialog bg-white shadow-xl">
+      <div className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <form method="dialog">
+          <button className="p-2 text-sm font-semibold hover:text-amber-700">Close</button>
+        </form>
+      </div>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NavigationPopover.tsx b/src/components/NavigationPopover.tsx
new file mode 100644
index 0000000..37aea95
--- /dev/null
+++ b/src/components/NavigationPopover.tsx
@@ -0,0 +1,36 @@
+import { useId, useRef, type ReactNode } from 'react';
+
+interface Props {
+  label: string;
+  active?: boolean;
+  children: ReactNode;
+}
+
+export default function NavigationPopover({ label, active = false, children }: Props) {
+  const id = useId();
+  const trigger = useRef<HTMLButtonElement>(null);
+  const panel = useRef<HTMLDivElement>(null);
+  return (
+    <>
+      <button type="button" ref={trigger} popoverTarget={id}
+        onClick={() => {
+          const bottom = trigger.current?.getBoundingClientRect().bottom ?? 0;
+          panel.current?.style.setProperty('--popover-top', `${Math.min(bottom + 8, window.innerHeight / 2)}px`);
+        }}
+        className={`flex items-center gap-1 py-3 whitespace-nowrap hover:text-gray-600 ${active ? 'text-amber-800' : ''}`}>
+        {label}
+        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" strokeWidth="3" stroke="currentColor" className="w-3 h-3">
+          <path strokeLinecap="round" strokeLinejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
+        </svg>
+      </button>
+      <div ref={panel} id={id} popover="auto" className="navigation-popover bg-white border border-gray-300 shadow-lg p-6">
+        <div className="flex justify-between items-center gap-4 mb-4">
+          <h2 className="font-semibold">{label}</h2>
+          <button type="button" popoverTarget={id} popoverTargetAction="hide"
+            onClick={() => trigger.current?.focus()} className="p-2 text-sm underline">Close</button>
+        </div>
+        {children}
+      </div>
+    </>
+  );
+}
