diff --git a/src/hooks/useArticles.ts b/src/hooks/useArticles.ts
new file mode 100644
index 0000000..f9ae009
--- /dev/null
+++ b/src/hooks/useArticles.ts
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react';
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+let catalog: Promise<Article[]> | undefined;
+function loadArticles() {
+  return catalog ??= fetch(`${import.meta.env.BASE_URL}api/articles.json`)
+    .then(response => {
+      if (!response.ok) throw new Error('Unable to load articles.');
+      return response.json() as Promise<Article[]>;
+    }).catch(error => {
+      catalog = undefined;
+      throw error;
+    });
+}
+
+export function useArticles(enabled: boolean) {
+  const [articles, setArticles] = useState<Article[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    if (!enabled) return;
+    let active = true;
+    setLoading(true);
+    setError('');
+    loadArticles().then(data => { if (active) setArticles(data); })
+      .catch(() => { if (active) setError('Articles could not be loaded. Close and reopen to try again.'); })
+      .finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, [enabled]);
+  return { articles, loading, error };
+}
