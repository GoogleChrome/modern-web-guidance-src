+}
+:focus-visible {
+  outline: 3px solid #92400e;
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: fixed;
+  inset-block-start: 0.5rem;
+  inset-inline-start: 0.5rem;
+  padding: 0.75rem 1rem;
+  background: white;
+  color: #111827;
+  z-index: 100;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.overlay-dialog {
+  width: min(42rem, calc(100% - 2rem));
+  max-height: 80dvh;
+  margin: 10dvh auto auto;
+  padding: 0;
+  overflow-y: auto;
+}
+
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+.navigation-popover {
+  position: fixed;
+  inset: var(--popover-top, 1rem) 0 auto;
+  width: min(72rem, calc(100% - 2rem));
+  max-height: calc(100dvh - var(--popover-top, 1rem) - 1rem);
+  margin: 0 auto;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
diff --git a/src/utils/overlays.ts b/src/utils/overlays.ts
new file mode 100644
index 0000000..e0fa027
--- /dev/null
+++ b/src/utils/overlays.ts
@@ -0,0 +1,13 @@
+let support: Promise<unknown> | undefined;
+
+// Keep modern browsers on native APIs; load compatibility code only when needed.
+export function ensureOverlaySupport() {
+  return support ??= (async () => {
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('@oddbird/popover-polyfill');
+    }
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      await import('invokers-polyfill');
+    }
+  })();
+}
