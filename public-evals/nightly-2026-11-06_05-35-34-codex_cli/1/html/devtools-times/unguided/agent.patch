diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..5b139a3
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  open: boolean;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** The native modal provides focus containment, Escape dismissal and an inert background. */
+export default function Modal({ id, title, open, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog || !open) return;
+    const trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (trigger?.isConnected) trigger.focus({ preventScroll: true });
+    };
+  }, [open]);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={`${id}-title`}
+      className="overlay-dialog bg-white shadow-xl w-full max-w-2xl"
+      onClose={onClose}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <div className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <button type="button" autoFocus={title !== 'Search articles'} onClick={() => dialogRef.current?.close()} aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700">
+          <span aria-hidden="true">✕</span>
+        </button>
+      </div>
+      {open && children}
+    </dialog>
+  );
+}
