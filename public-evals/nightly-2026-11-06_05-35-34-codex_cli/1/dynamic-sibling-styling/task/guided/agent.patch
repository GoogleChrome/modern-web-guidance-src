+  <script>
+    // Older browsers get the same count-driven layouts, including live DOM changes.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const updateSiblings = () => {
+        const items = document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb');
+        const groups = new Set(Array.from(items, item => item.parentElement));
+        groups.forEach(group => {
+          Array.from(group.children).forEach((item, index) => {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', group.children.length);
+          });
+        });
+      };
+      updateSiblings();
+      new MutationObserver(updateSiblings).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true
+      });
+    }
+  </script>
+
