+  <script>
+    // Keep the fallback in sync even when whole groups are inserted or removed.
+    // Each group is indexed independently; CSS uses these values as its fallback.
+    const layoutSelector = '.grid, .fan-container, .circle-container';
+    function updateLayouts() {
+      document.querySelectorAll(layoutSelector).forEach(container => {
+        const items = [...container.children];
+        items.forEach((item, index) => {
+          item.style.setProperty('--fallback-index', index);
+          item.style.setProperty('--fallback-count', items.length);
+        });
+      });
+    }
+    updateLayouts();
+    new MutationObserver(updateLayouts).observe(document.querySelector('main'), {
+      childList: true,
+      subtree: true
+    });
+  </script>
