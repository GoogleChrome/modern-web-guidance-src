+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const label = document.getElementById('cup-label');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = document.getElementById('coffee-summary');
+      const previewName = document.getElementById('cup-preview-name');
+      const ctx = canvas.getContext('2d');
+      let nativeHTML = !!ctx && typeof ctx.drawElementImage === 'function'
+        && typeof canvas.requestPaint === 'function';
+      let width = 0, height = 0, dpr = 1;
+      let geometry;
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.removeAttribute('layoutsubtree');
+        canvas.removeAttribute('content');
+        [label, form].forEach(element => {
+          element.style.transform = '';
+          stage.appendChild(element);
+        });
+        placeControls();
+      }
+
+      // Canvas drawing and DOM controls share the same CSS-pixel geometry.
+      function placeControls() {
+        if (!geometry) return;
+        const { cupX, cupY, cupScale, formX, formY, formWidth } = geometry;
+        previewName.style.fontSize = `${(name.value.trim().length > 14 ? 18 : 24) * cupScale}px`;
+        const placements = [
+          [form, formX, formY, formWidth],
+          [label, cupX - 79 * cupScale, cupY + 139 * cupScale, 158 * cupScale]
+        ];
+        placements.forEach(([element, x, y, w]) => {
+          element.style.width = `${w}px`;
+          element.style.left = nativeHTML ? '0px' : `${x}px`;
+          element.style.top = nativeHTML ? '0px' : `${y}px`;
+        });
+      }
+
+      function drawHTML(element, x, y) {
+        const transform = ctx.drawElementImage(element, x, y);
+        // Older implementations require explicit hit-test synchronization.
+        if (transform && typeof transform.toString === 'function') {
+          element.style.transform = transform.toString();
+        } else {
+          element.style.transform = '';
+        }
+      }
+
+      function paint() {
+        if (!ctx || !geometry) return;
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+        const { cupX, cupY, cupScale, formX, formY } = geometry;
+        ctx.save();
+        ctx.translate(cupX, cupY);
+        ctx.scale(cupScale, cupScale);
+
+        // A soft tabletop shadow, ceramic body, handle, and changing coffee.
+        ctx.fillStyle = '#e2d4c1';
+        ctx.beginPath(); ctx.ellipse(12, 298, 128, 15, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.strokeStyle = '#c6b29a'; ctx.lineWidth = 18;
+        ctx.beginPath(); ctx.ellipse(99, 160, 44, 54, 0, 0, Math.PI * 2); ctx.stroke();
+        ctx.strokeStyle = '#fffcf5'; ctx.lineWidth = 12; ctx.stroke();
+        const ceramic = ctx.createLinearGradient(-110, 0, 110, 0);
+        ceramic.addColorStop(0, '#e4d8c6'); ceramic.addColorStop(0.4, '#fffdf6');
+        ceramic.addColorStop(1, '#eee4d4');
+        ctx.fillStyle = ceramic;
+        ctx.beginPath(); ctx.moveTo(-110, 74); ctx.lineTo(-88, 265);
+        ctx.quadraticCurveTo(0, 303, 88, 265); ctx.lineTo(110, 74); ctx.closePath(); ctx.fill();
+        ctx.fillStyle = '#79533c';
+        ctx.beginPath(); ctx.moveTo(-102, 132); ctx.lineTo(-92, 226);
+        ctx.quadraticCurveTo(0, 255, 92, 226); ctx.lineTo(102, 132);
+        ctx.quadraticCurveTo(0, 159, -102, 132); ctx.fill();
+        ctx.fillStyle = '#fffaf0';
+        ctx.beginPath(); ctx.ellipse(0, 74, 110, 34, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = { oat: '#bd956b', whole: '#d5b18a', almond: '#b38a61', none: '#4b2e21' }[milk.value];
+        ctx.beginPath(); ctx.ellipse(0, 76, 99, 25, 0, 0, Math.PI * 2); ctx.fill();
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = { maple: '#8f562b', vanilla: '#f3ddac', caramel: '#b36b27' }[syrup.value];
+          ctx.lineWidth = 3; ctx.beginPath();
+          ctx.ellipse(0, 76, 61, 13, 0, 0.1, Math.PI * 1.8);
+          ctx.ellipse(0, 76, 35, 7, 0, 0.1, Math.PI * 1.8); ctx.stroke();
+        }
+        ctx.strokeStyle = '#b7a18b'; ctx.lineWidth = 2.5; ctx.lineCap = 'round';
+        [-32, 0, 32].forEach(x => {
+          ctx.beginPath(); ctx.moveTo(x, 22); ctx.bezierCurveTo(x - 15, 7, x + 14, -5, x, -22); ctx.stroke();
+        });
+        ctx.restore();
+
+        if (nativeHTML) {
+          try {
+            drawHTML(label, cupX - 79 * cupScale, cupY + 139 * cupScale);
+            drawHTML(form, formX, formY);
+          } catch (error) {
+            // A partially implemented experimental API must not hide the form.
+            useOverlay();
+          }
+        }
+      }
+
+      function requestDraw() {
+        if (nativeHTML) canvas.requestPaint();
+        else paint();
+      }
+
+      function resize() {
+        const bounds = canvas.getBoundingClientRect();
+        width = bounds.width; height = bounds.height;
+        dpr = window.devicePixelRatio || 1;
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        const compact = window.matchMedia('(max-width: 640px)').matches;
+        geometry = compact
+          ? { cupX: width / 2 - 8, cupY: 42, cupScale: 0.84, formX: 22, formY: 330, formWidth: width - 44 }
+          : { cupX: width * 0.25, cupY: 85, cupScale: Math.min(1.1, width / 850), formX: width * 0.52, formY: 66, formWidth: width * 0.43 };
+        placeControls();
+        requestDraw();
+      }
+
+      function update() {
+        const cupName = name.value.trim();
+        previewName.textContent = cupName || 'Your name';
+        const milkText = milk.selectedOptions[0].textContent;
+        const syrupText = syrup.value === 'none' ? 'No syrup' : `${syrup.selectedOptions[0].textContent} syrup`;
+        summary.textContent = `${cupName ? `${cupName}'s cup` : 'Your cup'} · ${milkText} · ${syrupText}`;
+        placeControls();
+        requestDraw();
+      }
+
+      if (!nativeHTML) useOverlay();
+      canvas.addEventListener('paint', paint);
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      form.addEventListener('submit', event => event.preventDefault());
+      new ResizeObserver(resize).observe(canvas);
+      window.addEventListener('resize', resize);
+      // Re-arm the query after moving between displays with different densities.
+      function watchDensity() {
+        const query = window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => { resize(); watchDensity(); }, { once: true });
+      }
+      watchDensity();
+      resize();
+      update();
+    })();
+  </script>
+
