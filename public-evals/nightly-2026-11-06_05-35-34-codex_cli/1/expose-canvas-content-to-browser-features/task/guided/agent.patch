+          element.style.left = `${x}px`;
+          element.style.top = `${y}px`;
+        }
+      }
+
+      function draw() {
+        if (!ctx || !layout) return;
+        const sx = canvas.width / cssWidth;
+        const sy = canvas.height / cssHeight;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(sx, 0, 0, sy, 0, 0);
+        const { cupX, cupY, cupScale } = layout;
+        ctx.save();
+        ctx.translate(cupX, cupY);
+        ctx.scale(cupScale, cupScale);
+        // A soft backdrop and saucer ground the hand-drawn takeaway cup.
+        ctx.fillStyle = '#eee1d2';
+        ctx.beginPath(); ctx.arc(0, 185, 170, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = '#dcc8b6';
+        ctx.beginPath(); ctx.ellipse(0, 354, 134, 14, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.strokeStyle = '#b7987c'; ctx.lineWidth = 3; ctx.lineCap = 'round';
+        for (const x of [-44, 0, 44]) {
+          ctx.beginPath(); ctx.moveTo(x, 39);
+          ctx.bezierCurveTo(x - 16, 24, x + 16, 15, x, 0); ctx.stroke();
+        }
+        const cupGradient = ctx.createLinearGradient(-115, 0, 115, 0);
+        cupGradient.addColorStop(0, '#e7d3ba'); cupGradient.addColorStop(.45, '#fff9ec'); cupGradient.addColorStop(1, '#e7d3ba');
+        ctx.fillStyle = cupGradient;
+        ctx.beginPath(); ctx.moveTo(-115, 94); ctx.lineTo(115, 94);
+        ctx.lineTo(86, 340); ctx.quadraticCurveTo(0, 364, -86, 340); ctx.closePath(); ctx.fill();
+        ctx.fillStyle = '#71503e';
+        ctx.beginPath(); ctx.moveTo(-106, 164); ctx.lineTo(106, 164);
+        ctx.lineTo(94, 286); ctx.quadraticCurveTo(0, 307, -94, 286); ctx.closePath(); ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.beginPath(); ctx.roundRect(-125, 70, 250, 35, 10); ctx.fill();
+        ctx.fillStyle = '#5f4033';
+        ctx.beginPath(); ctx.ellipse(0, 71, 115, 21, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = { oat: '#bf9268', whole: '#d9b38c', almond: '#b1845e', none: '#513124' }[milk.value];
+        ctx.beginPath(); ctx.ellipse(0, 68, 100, 13, 0, 0, Math.PI * 2); ctx.fill();
+        if (syrup.value !== 'none') {
