+      function resize(entry) {
+        const rect = entry ? entry.contentRect : canvas.getBoundingClientRect();
+        cssWidth = rect.width;
+        cssHeight = rect.height;
+        if (!cssWidth || !cssHeight) return;
+        const narrow = cssWidth <= 660;
+        const cupScale = Math.min(1, (narrow ? cssWidth - 32 : cssWidth * .47) / 350);
+        const cupX = narrow ? cssWidth / 2 : cssWidth * .25;
