index 0000000..e2143f4
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,177 @@
+// A native form-associated control: no hidden inputs or submission proxies.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+  #customError = '';
+  #radios;
+  #error;
+  #summary;
+  #group;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    const descriptions = ['Poor', 'Fair', 'Good', 'Very good', 'Excellent'];
+    root.innerHTML = `
+      <style>
+        :host { display: block; margin-bottom: 24px; color: #3e2723; }
+        .title { font-size: .9rem; font-weight: 600; margin: 0 0 7px; }
+        .stars { display: flex; gap: 6px; width: fit-content; }
+        label { position: relative; display: grid; place-items: center; width: 44px; height: 46px; cursor: pointer; border-radius: 6px; }
+        input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
+        svg { width: 34px; height: 34px; fill: #fffdfa; stroke: #987b60; stroke-width: 1.3; pointer-events: none; }
+        label.filled svg { fill: #c18a35; stroke: #a36e25; }
+        label:has(input:focus-visible) { outline: 3px solid #a66a26; outline-offset: 2px; }
+        .stars:not([aria-disabled="true"]):hover label svg { fill: #c18a35; stroke: #a36e25; }
+        .stars:not([aria-disabled="true"]) label:hover ~ label svg { fill: #fffdfa; stroke: #987b60; }
+        .summary { color: #705d52; font-size: .8rem; margin: 5px 0 0; }
+        .error { color: #a02c20; font-size: .85rem; margin: 6px 0 0; }
+        .error:empty { display: none; }
+        .stars[aria-disabled="true"] { opacity: .5; }
+        .stars[aria-disabled="true"] label { cursor: default; }
+        @media (forced-colors: active) {
+          svg { fill: Canvas; stroke: ButtonText; }
+          label.filled svg { fill: Highlight; stroke: ButtonText; }
+        }
+      </style>
+      <p class="title" id="title">How would you rate it? <span id="required">*</span></p>
+      <div class="stars" role="radiogroup" aria-labelledby="title" aria-describedby="summary error">
+        ${descriptions.map((description, index) => `
+          <label>
+            <input type="radio" name="stars" value="${index + 1}" aria-label="${index + 1} ${index === 0 ? 'star' : 'stars'} — ${description}">
+            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96Z"/></svg>
+          </label>`).join('')}
+      </div>
+      <p class="summary" id="summary">Select a star, from 1 to 5.</p>
+      <p class="error" id="error" aria-live="polite"></p>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#error = root.querySelector('#error');
+    this.#summary = root.querySelector('#summary');
+    this.#group = root.querySelector('.stars');
+
+    root.addEventListener('change', (event) => {
+      if (this.#disabled || !this.#radios.includes(event.target)) return;
+      this.value = event.target.value;
+      // Native radio change stays inside the shadow root; expose one host event.
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    // The original radio input event is already bubbling and composed.
+    root.addEventListener('input', (event) => {
+      if (!this.#disabled && this.#radios.includes(event.target)) {
+        this.value = event.target.value;
+      }
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) {
+      this.#value = this.#normalize(this.getAttribute('value'));
+    }
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get name() { return this.getAttribute('name') || ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get type() { return 'star-rating'; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(message) {
+    this.#customError = String(message);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    // Includes ancestor fieldsets, and preserves the value for re-enabling.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state) {
+    // The same serialized state works for history restoration and autofill.
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #normalize(value) {
+    const text = String(value ?? '');
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value;
+    const message = this.#customError || (missing ? 'Please select a star rating.' : '');
+    const flags = this.#customError ? { customError: true } : missing ? { valueMissing: true } : {};
+    const anchor = this.#radios.find((radio) => radio.value === this.#value) || this.#radios[0];
+    this.#internals.setValidity(flags, message, anchor);
+    this.#render();
+  }
+
+  #render() {
+    this.#radios.forEach((radio) => {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = this.#disabled;
+      radio.parentElement.classList.toggle('filled', Number(radio.value) <= Number(this.#value));
+    });
+    this.#group.setAttribute('aria-disabled', String(this.#disabled));
+    this.#group.setAttribute('aria-required', String(this.required));
+    const invalid = this.#showError && !this.#disabled && !this.validity.valid;
+    this.#group.setAttribute('aria-invalid', String(invalid));
+    this.shadowRoot.querySelector('#required').hidden = !this.required;
+    this.#error.textContent = invalid ? this.validationMessage : '';
+    this.#summary.textContent = this.#value ? `${this.#value} of 5 stars` : 'Select a star, from 1 to 5.';
+  }
+}
+
+customElements.define('star-rating', StarRating);
+
+const feedbackForm = document.querySelector('#coffee-feedback');
+const feedbackStatus = feedbackForm.querySelector('[role="status"]');
+feedbackForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  // Native submission and FormData both obtain rating through ElementInternals.
+  const data = new FormData(feedbackForm);
+  const rating = data.get('rating');
+  feedbackStatus.textContent = rating
+    ? `Thanks for your feedback! Preview: ${data.get('coffee')}, ${rating} of 5 stars. Your feedback has not been sent or saved.`
+    : 'The feedback fields are disabled. Enable them to leave your feedback.';
+});
+feedbackForm.addEventListener('reset', () => { feedbackStatus.textContent = ''; });
+feedbackForm.addEventListener('input', () => { feedbackStatus.textContent = ''; });
