new file mode 100644
index 0000000..6705736
--- /dev/null
+++ b/scripts/star-rating.js
@@ -0,0 +1,159 @@
+/** A single-value, form-associated control. No hidden input or form interception. */
+export class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'value'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+  #radios;
+  #description;
+  #error;
+  #group;
+  #labels = ['Could be better', 'Just okay', 'Pretty good', 'Loved it', 'Made my day'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; font: inherit; }
+        .rating { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
+        .stars { display: flex; gap: 2px; }
+        label { display: grid; place-items: center; position: relative; width: 48px; height: 48px; cursor: pointer; border-radius: 4px; }
+        input { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+        svg { width: 33px; height: 33px; fill: transparent; stroke: #9b9f8e; stroke-width: 1.25; }
+        label[data-filled] svg { fill: #b38743; stroke: #b38743; }
+        input:focus-visible + svg { outline: 2px solid #263f32; outline-offset: 5px; border-radius: 2px; }
+        @media (hover: hover) { .stars:has(label:hover) label svg { fill: transparent; stroke: #9b9f8e; } .stars:has(label:hover) label:hover svg, .stars:has(label:hover) label:has(~ label:hover) svg { fill: #b38743; stroke: #b38743; } }
+        .description { color: #73796a; font-size: 11px; }
+        .error { color: #a33f2e; font-size: 12px; margin: 5px 0 0; }
+        .error:empty { display: none; }
+        :host(:disabled) { opacity: .55; }
+        :host(:disabled) label { cursor: default; pointer-events: none; }
+        @media (forced-colors: active) { svg { stroke: ButtonText; } label[data-filled] svg { fill: Highlight; stroke: ButtonText; } input:focus-visible + svg { outline-color: Highlight; } }
+      </style>
+      <div class="rating">
+        <div class="stars" role="radiogroup" aria-label="How was your coffee?" aria-describedby="rating-description rating-error">
+          ${[1, 2, 3, 4, 5].map(value => `
+            <label>
+              <input type="radio" name="stars" value="${value}" aria-label="${value} ${value === 1 ? 'star' : 'stars'}: ${this.#labels[value - 1]}">
+              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 4 8.2 9 1.3-6.5 6.3 1.5 9-8-4.2L8 28l1.5-9L3 12.5l9-1.3Z"/></svg>
+            </label>`).join('')}
+        </div>
+        <span id="rating-description" class="description" aria-live="polite">Select a rating</span>
+      </div>
+      <p id="rating-error" class="error" aria-live="polite"></p>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#group = root.querySelector('.stars');
+    this.#description = root.querySelector('.description');
+    this.#error = root.querySelector('.error');
+
+    // Native radios supply arrow-key navigation, Space, and checked semantics.
+    // Emit one pair of events from the host rather than leaking shadow events.
+    root.addEventListener('input', event => event.stopPropagation());
+    root.addEventListener('change', event => {
+      event.stopPropagation();
+      if (this.#disabled || !this.#radios.includes(event.target)) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertReplacementText' }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#sync();
+    });
+  }
+
+  connectedCallback() {
+    // Preserve properties assigned before this element was upgraded.
+    for (const name of ['value', 'defaultValue', 'required', 'disabled', 'name']) {
+      if (Object.hasOwn(this, name)) {
+        const value = this[name];
+        delete this[name];
+        this[name] = value;
+      }
+    }
+    if (!this.#dirty) this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, previous, next) {
+    if (previous === next) return;
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(next);
+    this.#sync();
+  }
+
+  #normalize(value) {
+    const text = String(value ?? '');
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(this.#disabled);
+    this.#group.setAttribute('aria-required', String(this.required));
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = this.#disabled;
+      radio.parentElement.toggleAttribute('data-filled', Number(radio.value) <= Number(this.#value));
+    }
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a coffee rating.' : '',
+      this.#radios.find(radio => radio.checked) || this.#radios[0],
+    );
+    this.#group.setAttribute('aria-invalid', String(missing && this.#showError && !this.#disabled));
+    this.#error.textContent = missing && this.#showError && !this.#disabled ? 'Please choose a coffee rating.' : '';
+    this.#description.textContent = this.#value ? `${this.#value}/5 · ${this.#labels[Number(this.#value) - 1]}` : 'Select a rating';
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value ?? '')); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    // Never reflect inherited fieldset disabling onto the host's attribute.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    // The second setFormValue argument is the string supplied on restoration.
+    this.#showError = false;
+    this.value = typeof state === 'string' ? state : '';
+  }
+}
+
+if (!customElements.get('star-rating')) customElements.define('star-rating', StarRating);
