diff --git a/scripts/feedback.js b/scripts/feedback.js
new file mode 100644
index 0000000..80eb66f
--- /dev/null
+++ b/scripts/feedback.js
@@ -0,0 +1,30 @@
+import './star-rating.js';
+
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+
+form.addEventListener('submit', event => {
+  // The browser validates the custom element before dispatching submit.
+  event.preventDefault();
+  const data = new FormData(form);
+  if (!data.has('coffee') || !data.has('rating')) {
+    status.textContent = 'Choose your coffee and a rating before saving your feedback.';
+    return;
+  }
+  // This static homepage has no feedback API. Store only the latest response,
+  // and tell the visitor explicitly where it was saved.
+  try {
+    localStorage.setItem('daily-grind-feedback', JSON.stringify({
+      coffee: data.get('coffee'),
+      rating: data.get('rating'),
+      comments: data.get('comments'),
+      savedAt: new Date().toISOString(),
+    }));
+    status.textContent = 'Thanks for sharing your thoughts! Your feedback has been saved on this device.';
+  } catch {
+    status.textContent = 'Your browser could not save your feedback. Your answers are still here — please try again with browser storage enabled.';
+  }
+});
+
+form.addEventListener('reset', () => { status.textContent = ''; });
+form.addEventListener('input', () => { status.textContent = ''; });
