+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Playfair+Display:wght@400;500;600&display=swap');
+:root { color-scheme: light; --green: #263f32; --ink: #2b352d; --muted: #72766c; --paper: #f8f7f2; --line: #e1e2d8; --gold: #b38743; }
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--paper); color: var(--ink); font: 14px/1.65 'DM Sans', sans-serif; }
+a { color: inherit; text-decoration: none; }
+button, input, select, textarea { font: inherit; }
+button, select { cursor: pointer; }
+:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
+nav { max-width: 1440px; margin: auto; padding: 23px 5.5%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
+.logo { display: flex; gap: 11px; align-items: center; color: var(--green); font-size: 17px; font-weight: 700; letter-spacing: 1px; line-height: 1.4; white-space: nowrap; }
+.logo svg { width: 35px; height: 38px; }
+.logo small { display: block; font-size: 8px; font-weight: 500; letter-spacing: 2.5px; margin-top: 4px; }
+nav ul { display: flex; align-items: center; gap: 30px; list-style: none; margin: 0; padding: 0; font-size: 12px; font-weight: 500; }
+nav a:hover, .footer-links a:hover { color: var(--gold); }
+.account { border-left: 1px solid var(--line); padding-left: 28px; }
+.nav-order { display: inline-flex; align-items: center; gap: 22px; background: var(--green); color: white; padding: 12px 20px; border-radius: 4px; }
+.hero { position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(90deg, rgba(18, 28, 22, .8), rgba(18, 28, 22, .24)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=2000&q=85') center 53% / cover; color: #fffdf4; }
+.hero-content { width: 100%; max-width: 1280px; margin: auto; padding: 40px 5.5%; }
+.eyebrow { font-size: 9px; font-weight: 650; letter-spacing: 1.8px; }
+.hero .eyebrow { color: #e3dcc6; }
+h1, h2, h3, p { margin: 0; }
+h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; }
+h1 { font-size: clamp(44px, 4.6vw, 64px); line-height: 1.12; letter-spacing: -1.6px; margin: 15px 0; }
+.hero-content > p:not(.eyebrow) { font-size: 12px; color: #e7e6df; }
+.hero-link { display: inline-flex; align-items: center; gap: 27px; font-size: 12px; margin-top: 23px; padding-bottom: 5px; border-bottom: 1px solid #c0bba5; }
+.hero-caption { position: absolute; bottom: 28px; right: 5.5%; font-size: 8px; letter-spacing: 2px; color: #e3dcc6; }
+main { max-width: 1280px; margin: auto; padding: 0 5.5%; }
+.feedback-section { display: grid; grid-template-columns: 1fr 1.22fr; gap: 65px; padding: 65px 0 60px; align-items: start; }
+.feedback-intro { padding-top: 24px; }
+.feedback-intro .eyebrow { font-size: 8px; letter-spacing: 1.5px; display: flex; align-items: center; gap: 10px; }
+.small-line { width: 23px; height: 1px; background: var(--gold); }
+.feedback-intro h2 { font-size: clamp(34px, 3.3vw, 46px); letter-spacing: -1.2px; line-height: 1.2; margin: 21px 0; color: var(--green); }
+.feedback-intro > p:not(.eyebrow) { color: var(--muted); line-height: 1.9; font-size: 13px; }
+.intro-note { display: flex; gap: 16px; align-items: center; margin-top: 30px; }
+.note-star { font-size: 40px; color: var(--gold); line-height: 1; }
+.intro-note p { font-size: 12px; line-height: 1.8; color: #66705e; }
+.roast-note { margin-top: 48px; font-size: 10px; color: #7a7d70; border-top: 1px solid var(--line); padding-top: 18px; }
+.roast-note span { color: #677457; margin-right: 7px; }
+form { background: #fffefa; padding: 30px 32px 24px; border: 1px solid #dedfd4; border-radius: 8px; box-shadow: 0 5px 20px #283b2b04; }
+.form-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
+.form-heading h3 { font-size: 24px; letter-spacing: -.5px; }
+.form-heading > span { font-size: 7px; letter-spacing: 1.2px; color: #7b806e; border: 1px solid #dfe3d6; border-radius: 3px; padding: 4px 7px; white-space: nowrap; }
+.form-description { font-size: 11px; color: var(--muted); margin-top: 5px; }
+fieldset { border: 0; margin: 24px 0 0; padding: 0; min-width: 0; }
+.field { margin-bottom: 19px; }
+label { display: block; font-size: 11px; font-weight: 600; margin-bottom: 7px; }
+.required { color: #986d35; margin-left: 2px; }
+.optional { font-weight: 400; color: var(--muted); font-size: 10px; margin-left: 3px; }
+select, textarea { width: 100%; background-color: #fffefa; color: var(--ink); border: 1px solid #b4b9ab; border-radius: 4px; padding: 11px 12px; font-size: 16px; }
+select { min-height: 48px; }
+textarea { resize: vertical; min-height: 94px; line-height: 1.7; }
+textarea::placeholder { color: #767b6e; font-size: 12px; }
+.hint { font-size: 10px; color: #7b7e72; margin-top: 5px; }
+.rating-field { margin-top: 21px; }
+.rating-field label { margin-bottom: 4px; }
+.form-actions { display: flex; align-items: center; gap: 22px; margin-top: 24px; }
+.submit-button { flex: 1; display: flex; align-items: center; justify-content: space-between; background: var(--green); color: #fff; border: 0; border-radius: 4px; padding: 14px 18px; font-size: 12px; font-weight: 500; min-height: 48px; }
+.submit-button:hover { background: #3c5842; }
+.reset-button { background: none; border: 0; min-height: 48px; padding: 12px 2px; font-size: 11px; color: #6a7165; text-decoration: underline; text-underline-offset: 4px; }
+.form-footnote { border-top: 1px solid var(--line); padding-top: 15px; margin-top: 22px; font-size: 9px; text-align: center; color: #7c8172; }
+.form-footnote span { font-size: 13px; margin-right: 5px; }
+#feedback-status:not(:empty) { margin-top: 16px; padding: 12px; background: #edf2e7; border-radius: 4px; font-size: 12px; }
+fieldset:disabled { opacity: .55; }
+.favorites { border-top: 1px solid var(--line); padding: 31px 0 45px; }
+.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 16px; }
+.section-heading .eyebrow { font-size: 8px; color: #7e826e; letter-spacing: 1.4px; }
+.section-heading h2 { font-size: 29px; letter-spacing: -.6px; margin-top: 7px; }
+.section-heading > a { font-size: 11px; border-bottom: 1px solid #a6ad98; padding-bottom: 4px; }
+.section-heading > a span { margin-left: 16px; }
+.favorites-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 23px; }
+.coffee-card { position: relative; display: flex; gap: 13px; padding: 20px 17px; border: 1px solid #dfe1d5; border-radius: 5px; background: #eeefe6; transition: background .2s; }
+.coffee-card:hover { background: #e4e8d9; }
+.coffee-number { font-family: Georgia, serif; color: #909b7a; font-size: 15px; padding-top: 2px; }
+.coffee-tag { font-size: 7px; letter-spacing: 1px; color: #7c826c; }
+.coffee-card h3 { font-size: 19px; margin: 5px 0; }
+.coffee-card p { font-size: 10px; color: #737b69; max-width: 180px; }
+.card-arrow { margin-left: auto; color: #667555; }
+footer { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 30px 5.5%; border-top: 1px solid #dedfd4; background: #f0f0e8; }
+.footer-brand { font-size: 11px; font-weight: 700; letter-spacing: 1.3px; }
+.footer-brand span { display: block; font-family: Georgia, serif; font-style: italic; font-size: 11px; font-weight: 400; letter-spacing: 0; color: #7c806f; margin-top: 4px; }
+.footer-links { display: flex; gap: 22px; font-size: 10px; }
+footer > p { font-size: 9px; color: #868979; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+@media (max-width: 1000px) { nav ul { gap: 18px; } .account { display: none; } .feedback-section { gap: 35px; } .form-heading { flex-wrap: wrap; gap: 8px; } .form-heading > span { display: none; } .coffee-card { padding: 15px 12px; gap: 9px; } footer { flex-wrap: wrap; } }
+@media (max-width: 700px) { nav { padding: 18px 5%; } .logo { font-size: 13px; gap: 8px; } .logo small { font-size: 6px; } .logo svg { width: 29px; } nav ul li:not(:last-child) { display: none; } .nav-order { padding: 10px 13px; gap: 12px; font-size: 11px; } .hero { min-height: 330px; } .hero-content { padding: 35px 6%; } .hero-caption { display: none; } main { padding: 0 6%; } .feedback-section { grid-template-columns: 1fr; padding: 34px 0; gap: 27px; } .feedback-intro { padding: 0; } .feedback-intro h2 { font-size: 38px; margin: 15px 0; } .feedback-intro h2 br { display: none; } .desktop-break { display: none; } .intro-note { margin-top: 19px; } .roast-note { display: none; } form { padding: 24px 20px 20px; } .favorites-grid { grid-template-columns: 1fr; gap: 10px; } .coffee-card { padding: 18px; } .coffee-card p { max-width: none; } .section-heading { align-items: start; } .section-heading h2 { font-size: 26px; } .section-heading > a { margin-top: 24px; white-space: nowrap; font-size: 10px; } .section-heading > a span { margin-left: 4px; } footer { padding: 25px 6%; gap: 20px; } .footer-links { gap: 16px; flex-wrap: wrap; } footer > p { width: 100%; } }
+@media (forced-colors: active) { .hero { background: Canvas; color: CanvasText; } .hero p { color: CanvasText; } .submit-button, .nav-order { border: 1px solid ButtonText; } }
