+  <script>
+    const darkModeToggle = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+    const saveStatus = document.getElementById('preference-save-status');
+
+    darkModeToggle.checked = document.documentElement.dataset.theme === 'dark';
+    darkModeState.textContent = darkModeToggle.checked ? 'On' : 'Off';
+
+    darkModeToggle.addEventListener('change', () => {
+      const enabled = darkModeToggle.checked;
+      document.documentElement.dataset.theme = enabled ? 'dark' : 'light';
+      darkModeState.textContent = enabled ? 'On' : 'Off';
+      try {
+        localStorage.setItem('daily-grind-dark-mode', String(enabled));
+        saveStatus.textContent = 'Preference saved on this device.';
+      } catch {
+        saveStatus.textContent = 'Preference applied for this visit. Your browser could not save it.';
+      }
+    });
+  </script>
