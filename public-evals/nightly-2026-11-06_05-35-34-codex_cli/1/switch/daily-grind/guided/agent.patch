+  <script>
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeToggle = document.getElementById('dark-mode');
+    const themeState = document.querySelector('.preference-state');
+    const themeFeedback = document.getElementById('preference-feedback');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+    const themeKey = 'daily-grind-theme';
+
+    if (!('switch' in HTMLInputElement.prototype)) {
+      themeToggle.classList.add('switch-fallback');
+      themeToggle.setAttribute('role', 'switch');
+    }
+
+    function syncThemeToggle() {
+      themeToggle.checked = themeMeta.content === 'dark' ||
+        (themeMeta.content === 'light dark' && systemTheme.matches);
+      themeState.textContent = themeToggle.checked ? 'On' : 'Off';
+    }
+
+    themeToggle.addEventListener('change', () => {
+      const theme = themeToggle.checked ? 'dark' : 'light';
+      const followsSystem = themeToggle.checked === systemTheme.matches;
+      themeMeta.content = followsSystem ? 'light dark' : theme;
+      syncThemeToggle();
+      try {
+        if (followsSystem) localStorage.removeItem(themeKey);
+        else localStorage.setItem(themeKey, theme);
+        themeFeedback.textContent = 'Preference saved for this browser.';
+      } catch {
+        themeFeedback.textContent = 'Preference applied for this visit. Browser storage is unavailable.';
+      }
+    });
+
+    systemTheme.addEventListener('change', syncThemeToggle);
+    window.addEventListener('storage', (event) => {
+      if (event.key !== themeKey && event.key !== null) return;
+      themeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+        ? event.newValue : 'light dark';
+      syncThemeToggle();
+      themeFeedback.textContent = '';
+    });
+    syncThemeToggle();
+    document.querySelector('.preferences').hidden = false;
+  </script>
+
