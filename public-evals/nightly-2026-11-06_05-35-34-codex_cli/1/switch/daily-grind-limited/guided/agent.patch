+  <script>
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const darkMode = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function syncDarkMode() {
+      darkMode.checked = themeMeta.content === 'dark' ||
+        (themeMeta.content === 'light dark' && systemTheme.matches);
+      darkModeState.textContent = darkMode.checked ? 'On' : 'Off';
+    }
+
+    darkMode.addEventListener('change', () => {
+      const target = darkMode.checked ? 'dark' : 'light';
+      const override = darkMode.checked === systemTheme.matches ? null : target;
+      themeMeta.content = override ?? 'light dark';
+      syncDarkMode();
+      try {
+        if (override) localStorage.setItem('daily-grind-theme', override);
+        else localStorage.removeItem('daily-grind-theme');
+      } catch {}
+    });
+
+    systemTheme.addEventListener('change', syncDarkMode);
+    window.addEventListener('storage', (event) => {
+      if (event.key !== 'daily-grind-theme' && event.key !== null) return;
+      themeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+        ? event.newValue : 'light dark';
+      syncDarkMode();
+    });
+
+    syncDarkMode();
+    document.querySelector('.preferences').hidden = false;
+  </script>
+
 </body>
 
