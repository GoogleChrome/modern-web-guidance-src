+  <script>
+    const form = document.querySelector('#subscription-form');
+    const nameInput = document.querySelector('#subscriber-name');
+    const emailInput = document.querySelector('#subscriber-email');
+    const roastInput = document.querySelector('#roast-level');
+    const updatesInput = document.querySelector('#email-updates');
+    const status = document.querySelector('#setup-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const roastNotes = ['bright & delicate', 'smooth & lively', 'balanced', 'rich & rounded', 'bold & intense'];
+
+    function updateProfile() {
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      const roastIndex = Number(roastInput.value) - 1;
+      const roastLabel = roastNames[roastIndex];
+      const roastDescription = roastLabel + ' · ' + roastNotes[roastIndex];
+      document.querySelector('#roast-description').value = roastDescription;
+      roastInput.setAttribute('aria-valuetext', roastDescription);
+      document.querySelector('#roast-summary').textContent = roastLabel;
+      document.querySelector('#delivery-summary').textContent = frequency ? frequency.value : 'Choose your rhythm';
+      document.querySelector('#updates-summary').textContent = updatesInput.checked ? 'Yes, please' : 'No, thanks';
+      const completed = Number(nameInput.value.trim().length > 0)
+        + Number(emailInput.value.trim().length > 0 && emailInput.validity.valid)
+        + Number(Boolean(frequency)) + 1;
+      const progress = document.querySelector('#setup-progress');
+      progress.value = completed;
+      progress.textContent = (completed * 25) + '%';
+      document.querySelector('#progress-description').textContent = completed + ' of 4 complete';
+    }
+
+    form.addEventListener('input', () => {
+      nameInput.setCustomValidity('');
+      status.textContent = '';
+      updateProfile();
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      nameInput.setCustomValidity(nameInput.value.trim() ? '' : 'Please enter your name.');
+      if (!form.reportValidity()) return;
+      updateProfile();
+      status.textContent = 'Your coffee profile is ready: ' + roastNames[Number(roastInput.value) - 1]
+        + ' roast, delivered ' + form.querySelector('input[name="frequency"]:checked').value.toLowerCase()
+        + '. These preferences are a preview; no subscription has been activated.';
+    });
+    updateProfile();
+  </script>
