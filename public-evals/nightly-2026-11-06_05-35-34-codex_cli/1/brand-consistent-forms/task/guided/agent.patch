+<script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastOutput = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressCopy = document.getElementById('progress-copy');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-coffee-preferences';
+    let saved = false;
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastOutput.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const completed = 1 + Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + Number(saved);
+      const percentage = `${completed * 25}%`;
+      progress.value = completed;
+      progress.textContent = percentage;
+      document.getElementById('progress-percent').textContent = percentage;
+      progressCopy.textContent = saved ? '4 of 4 steps complete · Preferences saved'
+        : `${completed} of 4 steps complete · Add your email, choose delivery, then save`;
+    }
+
+    form.addEventListener('input', () => {
+      saved = false;
+      status.textContent = '';
+      updateSetup();
+    });
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const preferences = {
+        email: email.value.trim(),
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: roast.value,
+        receiveEmails: document.getElementById('coffee-emails').checked
+      };
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        saved = true;
+        status.textContent = 'Your coffee preferences are saved on this device.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow site storage and try again.';
+      }
+      updateSetup();
+    });
+
+    try {
+      const preferences = JSON.parse(localStorage.getItem(storageKey));
+      if (preferences && ['weekly', 'fortnightly', 'monthly'].includes(preferences.frequency)
+        && ['1', '2', '3', '4', '5'].includes(preferences.roast) && typeof preferences.email === 'string') {
+        email.value = preferences.email;
+        form.querySelector(`input[name="frequency"][value="${preferences.frequency}"]`).checked = true;
+        roast.value = preferences.roast;
+        document.getElementById('coffee-emails').checked = preferences.receiveEmails === true;
+        saved = email.value.trim() !== '' && email.validity.valid;
+      }
+    } catch { /* The form remains usable when device storage is unavailable. */ }
+    updateSetup();
+  </script>
