+  <script>
+    const drinkCards = document.querySelectorAll('.drink-card');
+
+    function setActionsOpen(card, open) {
+      const actions = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.action-toggle');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      actions.inert = !open;
+      toggle.setAttribute('aria-expanded', String(open));
+      toggle.textContent = open ? 'Close' : 'Actions';
+    }
+
+    drinkCards.forEach(card => {
+      const content = card.querySelector('.drink-content');
+      const toggle = card.querySelector('.action-toggle');
+      let gesture = null;
+      let suppressClick = false;
+
+      function toggleActions() {
+        const open = !card.classList.contains('is-open');
+        drinkCards.forEach(other => setActionsOpen(other, other === card && open));
+      }
+
+      toggle.addEventListener('click', toggleActions);
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        suppressClick = false;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, horizontal: false };
+      });
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = Math.abs(event.clientX - gesture.x);
+        const dy = Math.abs(event.clientY - gesture.y);
+        if (!gesture.horizontal && dy > 10 && dy >= dx) {
+          gesture = null;
+          return;
+        }
+        if (!gesture.horizontal && dx > 10 && dx > dy) {
+          gesture.horizontal = true;
+          content.setPointerCapture(event.pointerId);
+        }
+      });
+      content.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const swiped = gesture.horizontal && Math.abs(event.clientX - gesture.x) >= 40;
+        suppressClick = gesture.horizontal;
+        gesture = null;
+        if (swiped) toggleActions();
+      });
+      content.addEventListener('pointercancel', () => { gesture = null; });
+      content.addEventListener('pointerleave', () => {
+        if (gesture && !gesture.horizontal) gesture = null;
+      });
+      // A swipe ending over a button must never turn into a button click.
+      content.addEventListener('click', event => {
+        if (!suppressClick) return;
+        suppressClick = false;
+        event.preventDefault();
+        event.stopImmediatePropagation();
+      }, true);
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape') setActionsOpen(card, false);
+      });
+    });
+
+    document.addEventListener('pointerdown', event => {
+      if (!event.target.closest('.drink-card')) {
+        drinkCards.forEach(card => setActionsOpen(card, false));
+      }
+    });
+  </script>
