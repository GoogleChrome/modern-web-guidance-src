+  <script>
+    for (const card of document.querySelectorAll('.drink-card')) {
+      const content = card.querySelector('.drink-content');
+      const showButton = card.querySelector('.show-actions');
+      const closeButton = card.querySelector('.close-actions');
+
+      const closeActions = () => {
+        card.scrollTo({ left: 0 });
+        showButton.focus({ preventScroll: true });
+      };
+
+      showButton.addEventListener('click', () => {
+        card.scrollTo({ left: card.scrollWidth - card.clientWidth });
+      });
+      closeButton.addEventListener('click', closeActions);
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeActions();
+        }
+      });
+      card.addEventListener('scroll', () => {
+        showButton.setAttribute('aria-expanded', String(card.scrollLeft > 1));
+      }, { passive: true });
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          card.scrollTo({ left: 0 });
+        }
+      });
+    }
+  </script>
