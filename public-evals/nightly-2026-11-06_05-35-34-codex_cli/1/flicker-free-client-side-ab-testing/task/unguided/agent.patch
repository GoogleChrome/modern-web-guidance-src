+  <script>
+    (() => {
+      let settled = false;
+      let timer;
+      const reveal = (state) => {
+        document.documentElement.dataset.experimentState = state;
+        document.documentElement.classList.remove('experiment-pending');
+      };
+      // SDK integration: dispatch `experiment:applied` only after DOM writes finish,
+      // or call window.gatherExperimentApplied() at the same completion boundary.
+      window.gatherExperimentApplied = () => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        reveal('applied');
+      };
+      document.addEventListener('experiment:applied', window.gatherExperimentApplied);
+      window.gatherExperimentFallback = () => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        const target = document.querySelector('[data-experiment]');
+        const fallback = document.getElementById('hero-fallback');
+        // Replace the hidden experiment subtree, so its original content is never
+        // exposed on failure or timeout. Late completion events are ignored.
+        if (target && fallback) target.replaceWith(fallback.content.cloneNode(true));
+        reveal('fallback');
+      };
+      document.addEventListener('DOMContentLoaded', () => {
+        timer = setTimeout(window.gatherExperimentFallback, 1800);
+        const sdk = document.createElement('script');
+        sdk.src = 'https://cdn.example.com/experiment-sdk.js';
+        sdk.async = true;
+        sdk.onerror = window.gatherExperimentFallback;
+        // A load event alone is not evidence that asynchronous variant DOM work
+        // is complete. The SDK must use the explicit completion hook above.
+        document.head.appendChild(sdk);
+      });
+    })();
+  </script>
