+  <script src="vendor/html2canvas.min.js"></script>
+  <script>
+    const card = document.getElementById('export_element');
+    const canvas = document.getElementById('gift-canvas');
+    const nameInput = document.getElementById('gift-name');
+    const messageInput = document.getElementById('gift-message');
+    const colorInput = document.getElementById('gift-color');
+    const exportButton = document.getElementById('export-button');
+    const status = document.getElementById('export-status');
+    let renderVersion = 0;
+    let renderTimer;
+
+    async function renderCard() {
+      const version = ++renderVersion;
+      if (typeof html2canvas !== 'function') throw new Error('Renderer unavailable');
+      const rendered = await html2canvas(card, { scale: 3, backgroundColor: null, logging: false });
+      if (version !== renderVersion) return false;
+      canvas.width = rendered.width;
+      canvas.height = rendered.height;
+      canvas.getContext('2d').drawImage(rendered, 0, 0);
+      canvas.hidden = false;
+      return true;
+    }
+
+    function updateCard() {
+      ++renderVersion;
+      canvas.hidden = true;
+      document.getElementById('card-recipient').textContent = nameInput.value.trim() ? 'Especially for ' + nameInput.value.trim() : 'Especially for you';
+      document.getElementById('card-message').textContent = messageInput.value;
+      document.getElementById('message-count').textContent = messageInput.value.length;
+      card.style.backgroundColor = colorInput.value;
+      const rgb = colorInput.value.match(/\w\w/g).map(value => parseInt(value, 16) / 255);
+      const linear = rgb.map(value => value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4);
+      const luminance = linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722;
+      card.style.color = luminance > 0.3 ? '#3e2723' : '#fff7ec';
+      document.querySelectorAll('.color-swatch').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.color === colorInput.value)));
+      clearTimeout(renderTimer);
+      renderTimer = setTimeout(() => renderCard().catch(() => {
+        status.textContent = 'Preview available. Reload the page if image export is unavailable.';
+      }), 180);
+    }
+
+    [nameInput, messageInput, colorInput].forEach(input => input.addEventListener('input', updateCard));
+    document.querySelectorAll('.color-swatch').forEach(button => button.addEventListener('click', () => {
+      colorInput.value = button.dataset.color;
+      updateCard();
+    }));
+    exportButton.addEventListener('click', async () => {
+      exportButton.disabled = true;
+      status.textContent = 'Preparing your card…';
+      clearTimeout(renderTimer);
+      try {
+        // Disable editing briefly so the exported canvas always matches the current card.
+        const controls = [...document.querySelectorAll('.studio-controls input, .studio-controls textarea, .color-swatch')];
+        controls.forEach(control => control.disabled = true);
+        try {
+          await renderCard();
+          const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Image export failed');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.download = 'daily-grind-gift-card.png';
+          link.href = url;
+          document.body.appendChild(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 30000);
+          status.textContent = 'Your card is ready. Enjoy sharing a little kindness!';
+        } finally {
+          controls.forEach(control => control.disabled = false);
+        }
+      } catch (error) {
+        status.textContent = 'Could not export your card. Please try again or reload the page.';
+      } finally {
+        exportButton.disabled = false;
+      }
+    });
+    new ResizeObserver(() => {
+      if (!exportButton.disabled) updateCard();
+    }).observe(card);
+    updateCard();
+  </script>
 </body>
 
