new file mode 100644
index 0000000..9b251da
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,38 @@
+class DrinkCard extends HTMLElement {
+  #button;
+
+  connectedCallback() {
+    // Module scripts run after parsing. Native DSD has already created the root.
+    // Reconnecting a card must not register a second listener or reset its state.
+    if (this.#button) return;
+
+    if (!this.shadowRoot) {
+      // Older engines can adopt the same server markup once, without rebuilding it.
+      const template = this.querySelector('template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open' }).append(template.content);
+      template.remove();
+    }
+
+    const button = this.shadowRoot.querySelector('button[aria-pressed]');
+    const label = button?.querySelector('[data-favorite-label]');
+    if (!button || !label) return;
+
+    this.#button = button;
+    button.addEventListener('click', () => {
+      const favorite = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(favorite));
+      label.textContent = favorite ? 'Favorited' : 'Favorite';
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        detail: { favorite },
+        bubbles: true,
+        composed: true,
+      }));
+    });
+    button.disabled = false;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
