diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..e0ee7d7
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,30 @@
+// Upgrade the server-rendered light DOM in place. Content and critical styles
+// already exist in index.html; hydration never builds or replaces the card.
+class DrinkCard extends HTMLElement {
+  #events;
+
+  connectedCallback() {
+    // A reconnect must not accumulate click handlers.
+    this.#events?.abort();
+    const button = this.querySelector('.favorite-toggle');
+    if (!button) return;
+
+    this.#events = new AbortController();
+    button.addEventListener('click', () => {
+      const favorite = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(favorite));
+      button.textContent = favorite ? 'Favorited' : 'Add to favorites';
+    }, { signal: this.#events.signal });
+    button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.#events?.abort();
+    const button = this.querySelector('.favorite-toggle');
+    if (button) button.disabled = true;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
