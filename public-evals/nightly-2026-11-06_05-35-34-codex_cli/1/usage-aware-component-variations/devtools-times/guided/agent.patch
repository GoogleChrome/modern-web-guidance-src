+/* Semantic context is declared on the preview surface, independently of components. */
+.context-success {
+  --intent: success;
+}
+.context-warning {
+  --intent: warning;
+}
+.context-danger {
+  --intent: danger;
+}
+:where(.context-success) .sample-btn.primary {
+  background: #4c7855;
+  border-color: #4c7855;
+}
+:where(.context-warning) .sample-btn.primary {
+  background: #ab813b;
