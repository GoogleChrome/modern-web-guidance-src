+}
+:where(.context-danger) .sample-btn.primary {
+  background: #b66b60;
+  border-color: #b66b60;
+}
+:where(.context-success) .adaptive-alert {
+  background: #edf3e9;
+  border-color: #d7e3ce;
+  color: #779367;
