+                      onClick={() => setView("list")}
+                    >
+                      <Icon name="list" size={17} />
+                    </button>
+                  </div>
+                </div>
+              </div>
+              <section
+                className={`component-grid ${view === "list" ? "list-view" : ""} context-${intent}`}
+                style={contextStyle}
+                aria-label="Component previews"
+              >
+                {filtered.map((c) => (
+                  <article className="component-card" key={c.name}>
+                    <div className={`component-preview ${c.type}`}>
+                      {code ? (
+                        <pre>
+                          <code>{`<Context intent="${intent}">\n  <${c.name.replace(/\s/g, "")}\n    variant="adaptive"\n  />\n</Context>`}</code>
+                        </pre>
+                      ) : (
+                        preview(c.type)
+                      )}
+                    </div>
+                    <div className="component-info">
+                      <div>
+                        <h3>{c.name}</h3>
+                        <span>
+                          {c.count} variants <Icon name="right" size={12} />
+                        </span>
+                      </div>
+                      <p>{c.desc}</p>
+                      <div className="component-meta">
+                        <span>
+                          <i />
+                          {c.category}
+                        </span>
+                        <span>
+                          <Icon name="bolt" size={11} />
+                          Context aware
+                        </span>
+                      </div>
+                    </div>
+                  </article>
+                ))}
+              </section>
+              {filtered.length === 0 && (
+                <div className="no-results">
+                  <Icon name="search" size={30} />
+                  <h3>No components found</h3>
+                  <p>Try another search or category.</p>
+                  <button
+                    onClick={() => {
+                      setQuery("");
+                      setCategory("All components");
+                    }}
+                  >
+                    Clear filters
+                  </button>
+                </div>
+              )}
+              <footer className="library-footer">
+                <span>
+                  <i />
+                  Built to belong, wherever you build.
+                </span>
+                <span>
+                  Made with intention <Icon name="spark" size={13} />
+                  <b>forma</b>
+                </span>
+              </footer>
+            </>
+          ) : (
+            <section className="resource-panel">
+              <div className="resource-icon">
+                <Icon
+                  name={
+                    page === "Foundations"
+                      ? "palette"
+                      : page === "Settings"
+                        ? "settings"
+                        : "book"
+                  }
+                  size={30}
+                />
+              </div>
+              <h2>
+                {page === "Documentation"
+                  ? "Designed to adapt. Built to be simple."
+                  : page === "Foundations"
+                    ? "The foundation of thoughtful interfaces."
+                    : page === "Changelog"
+                      ? "A system that keeps getting better."
+                      : page === "Settings"
+                        ? "Your workspace, your way."
+                        : "Let’s make it better together."}
+              </h2>
+              <p>
+                {page === "Documentation"
+                  ? "Choose a semantic context and let the component decide how to present itself. Every component includes accessible defaults and flexible variants."
+                  : page === "Changelog"
+                    ? "Version 1.2 — Context-aware components, four semantic intents, and a new live preview experience."
+                    : page === "Foundations"
+                      ? "Our foundations bring color, typography, spacing, and intent together in one consistent language."
+                      : "Manage your preferences and explore everything your Forma workspace has to offer."}
+              </p>
+              <div className="resource-options">
+                {(page === "Foundations"
+                  ? ["Color & intent", "Typography", "Spacing & layout"]
+                  : page === "Settings"
+                    ? [
+                        "Email notifications",
+                        "Workspace preferences",
+                        "Personal account",
+                      ]
+                    : [
+                        "Semantic contexts",
+                        "Component variants",
+                        "Accessible by default",
+                      ]
+                ).map((s, i) => (
+                  <div key={s}>
+                    <span className={`foundation-swatch swatch-${i}`} />
+                    <strong>{s}</strong>
+                    <span>
+                      {i === 0
+                        ? "Thoughtful defaults"
+                        : i === 1
+                          ? "Made to be flexible"
+                          : "Built into every component"}
+                    </span>
+                  </div>
+                ))}
+              </div>
+              <button
+                className="new-component"
+                onClick={() => nav("Components")}
+              >
+                Explore components <Icon name="arrow" size={16} />
+              </button>
+            </section>
+          )}
+        </main>
+      </div>
+      <dialog ref={dialog} className="create-dialog">
+        <form
+          onSubmit={(e) => {
+            e.preventDefault();
+            if (!name.trim()) return;
+            setCards([
+              ...cards,
+              {
+                name: name.trim(),
+                category: newCategory,
+                desc: "Your new context-aware component.",
+                count: 1,
+                type: "buttons",
+              },
+            ]);
+            setName("");
+            setCategory("All components");
+            setQuery("");
+            setPage("Components");
+            dialog.current?.close();
+            notify("Component created and added to your library");
+          }}
+        >
+          <div className="dialog-heading">
+            <span className="project-icon">
+              <Icon name="grid" size={23} />
+            </span>
+            <button
+              type="button"
+              aria-label="Close dialog"
+              onClick={() => dialog.current?.close()}
+            >
+              <Icon name="x" />
+            </button>
+          </div>
+          <h2>A new building block</h2>
+          <p>Create something that fits right in.</p>
+          <label>
+            Component name
+            <input
+              required
+              autoFocus
+              placeholder="e.g. Icon buttons"
+              value={name}
+              onChange={(e) => setName(e.target.value)}
+            />
+          </label>
+          <label>
+            Category
+            <select
+              value={newCategory}
+              onChange={(e) => setNewCategory(e.target.value)}
+            >
+              {categories.slice(1).map((c) => (
+                <option key={c}>{c}</option>
+              ))}
+            </select>
+          </label>
+          <div className="dialog-actions">
+            <button
+              type="button"
+              className="sample-btn secondary"
+              onClick={() => dialog.current?.close()}
+            >
+              Cancel
+            </button>
+            <button className="new-component" type="submit">
+              <Icon name="plus" size={16} />
+              Create component
+            </button>
+          </div>
+        </form>
+      </dialog>
+      <div className={`toast ${toast ? "visible" : ""}`} role="status">
+        <Icon name="check" size={17} />
+        {toast}
+      </div>
+    </div>
+  );
+}
