+:where(.context-warning) .adaptive-alert {
+  background: #fcf3e2;
+  border-color: #ebddbd;
+  color: #b28d45;
+}
+:where(.context-danger) .adaptive-alert {
+  background: #f9ece8;
+  border-color: #ebd1c9;
+  color: #b67f72;
+}
+:where(.context-success, .context-warning, .context-danger) .context-tag {
+  display: inline-flex;
