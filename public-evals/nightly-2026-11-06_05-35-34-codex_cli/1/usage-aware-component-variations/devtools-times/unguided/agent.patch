+ <section className="component-section"><div className="section-heading"><h2>{page==='Playground'?'Component playground':'Your components'}<span>{cards.length+18}</span></h2><button className="text-button" onClick={()=>{setPage(page==='Components'?'Overview':'Components');setTab('All components')}}>{page==='Components'?'Back to overview':'View all components'}<Icon name="arrow" size={16}/></button></div><div className="component-toolbar"><div className="tabs">{['All components','Recently added','Most used'].map(t=><button key={t} className={tab===t?'selected':''} onClick={()=>setTab(t)}>{t}</button>)}</div><label className="search"><Icon name="search" size={16}/><input ref={searchRef} aria-label="Search components" value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search components…"/><kbd>⌘ K</kbd></label></div>
