+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const menuStatus = document.getElementById('menu-status');
+    const reviews = document.getElementById('seasonal-reviews');
+    const promo = document.getElementById('seasonal-promo');
+
+    // Narrow fallback for this document's initial patch; native parsers already
+    // consumed the template. No HTML string parsing is needed in older browsers.
+    const initialCards = document.getElementById('initial-seasonal-cards');
+    if (initialCards && !('htmlFor' in HTMLTemplateElement.prototype)) {
+      cards.replaceChildren(initialCards.content);
+      initialCards.remove();
+    }
+    cards.setAttribute('aria-busy', 'false');
+    menuStatus.textContent = '';
+
+    let purifierPromise;
+    async function safeSetHTML(target, html, sanitizer) {
+      if ('setHTML' in Element.prototype) {
+        target.setHTML(html, { sanitizer });
+      } else {
+        // Load a maintained sanitizer only when the native API is unavailable.
+        purifierPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.3.0/dist/purify.es.mjs');
+        const { default: DOMPurify } = await purifierPromise;
+        target.replaceChildren(DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...sanitizer.elements, '#text'],
+          ALLOWED_ATTR: sanitizer.attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+          RETURN_DOM_FRAGMENT: true,
+        }));
+      }
+    }
+
+    // API contract: return HTML fragments (not full documents) with text/html.
+    // Reviews remain untrusted even though they are served from our own origin.
+    async function fetchHTML(path, signal) {
+      const response = await fetch(path, {
+        headers: { Accept: 'text/html' },
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        signal,
+      });
+      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('HTML fragment unavailable');
+      }
+      return response;
+    }
+
+    let refreshing = false;
+    let refreshAgain = false;
+    async function refreshCards() {
+      // Coalesce events without letting a slower response overwrite a newer menu.
+      if (refreshing) {
+        refreshAgain = true;
+        return;
+      }
+      refreshing = true;
+      do {
+        refreshAgain = false;
+        cards.setAttribute('aria-busy', 'true');
+        menuStatus.textContent = 'Refreshing seasonal favorites…';
+        try {
+          const response = await fetchHTML('/api/menu/seasonal');
+          // Stage the sanitized fragment so failed requests leave the menu intact.
+          const next = document.createElement('div');
+          await safeSetHTML(next, await response.text(), {
+            elements: ['article', 'div', 'h3', 'p', 'a', 'strong', 'em', 'span'],
+            attributes: ['class', 'href'],
+          });
+          if (!next.children.length) throw new Error('Empty menu');
+          const active = document.activeElement;
+          const focusIndex = [...cards.querySelectorAll('a')].indexOf(active);
+          cards.replaceChildren(...next.childNodes);
+          if (focusIndex >= 0) {
+            const links = cards.querySelectorAll('a');
+            if (links.length) links[Math.min(focusIndex, links.length - 1)].focus();
+            else document.getElementById('seasonal-heading').focus();
+          }
+          menuStatus.textContent = 'Seasonal favorites are up to date.';
+        } catch {
+          menuStatus.textContent = 'We couldn’t refresh the menu. Showing the last available favorites.';
+        } finally {
+          cards.setAttribute('aria-busy', 'false');
+        }
+      } while (refreshAgain);
+      refreshing = false;
+    }
+
+    async function loadReviews() {
+      const status = document.getElementById('reviews-status');
+      try {
+        const response = await fetchHTML('/api/reviews/seasonal');
+        await safeSetHTML(reviews, await response.text(), {
+          elements: ['article', 'blockquote', 'p', 'cite', 'strong', 'em', 'br'],
+          attributes: [],
+        });
+        if (!reviews.textContent.trim()) reviews.textContent = 'No reviews yet.';
+      } catch {
+        reviews.textContent = 'Customer reviews are currently unavailable.';
+        status.textContent = 'Please check back soon.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    async function loadPromo() {
+      const status = document.getElementById('promo-status');
+      try {
+        // This fixed endpoint MUST return only publisher-controlled CMS HTML,
+        // including its widget scripts. Never mix in reviews or user input.
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        if (!('streamHTMLUnsafe' in Element.prototype)) {
+          await import('https://cdn.jsdelivr.net/npm/html-setters-polyfill@0.1.1/index.js');
+        }
+        promo.setAttribute('aria-busy', 'true');
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+      } catch {
+        status.textContent = 'The latest promotion is currently unavailable.';
+      } finally {
+        promo.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // The menu publisher sends a named SSE event after committing a menu change.
+    // Dispatching the same DOM event also supports updates from other page widgets.
+    document.addEventListener('menu-changed', refreshCards);
+    let polling;
+    const startPolling = () => { polling ??= setInterval(refreshCards, 60000); };
+    if ('EventSource' in window) {
+      let menuEvents;
+      const connectMenuEvents = () => {
+        menuEvents = new EventSource('/api/menu/events');
+        menuEvents.addEventListener('menu-changed', refreshCards);
+        menuEvents.addEventListener('open', () => {
+          clearInterval(polling);
+          polling = undefined;
+          refreshCards(); // Catch changes missed while disconnected.
+        });
+        menuEvents.onerror = () => {
+          menuStatus.textContent = 'Live updates interrupted. Checking the menu every minute.';
+          startPolling();
+        };
+      };
+      connectMenuEvents();
+      window.addEventListener('pagehide', () => {
+        menuEvents.close();
+        clearInterval(polling);
+        polling = undefined;
+      });
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) connectMenuEvents();
+      });
+    } else {
+      refreshCards();
+      startPolling();
+    }
+    loadReviews();
+    loadPromo();
+  </script>
 
