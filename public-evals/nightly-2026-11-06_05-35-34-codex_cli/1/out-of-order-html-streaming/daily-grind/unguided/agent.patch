+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const status = document.getElementById('menu-status');
+    const refreshButton = document.getElementById('refresh-menu');
+
+    // On older browsers the processing instructions are comments and the
+    // template stays inert. Only clone this fixed, trusted document payload.
+    const initialCards = document.getElementById('initial-seasonal-cards');
+    if (cards.querySelector('.skeleton') && initialCards?.content.childElementCount) {
+      cards.replaceChildren(initialCards.content.cloneNode(true));
+      initialCards.remove();
+    }
+
+    // Server integration contract (all endpoints return text/html fragments):
+    // GET /api/menu/seasonal: card children only, not a full page or templates.
+    // GET /api/reviews: customer-authored markup; always sanitize on insertion.
+    // GET /api/cms/seasonal-promo: trusted, editorial CMS HTML, including its
+    // widget script. Never include customer submissions in this response.
+    // GET /api/menu/events: text/event-stream; emit `event: menuchange` with a
+    // data line after each published menu change. Payload data is not HTML.
+    async function fetchHTML(url) {
+      const response = await fetch(url, {
+        headers: { Accept: 'text/html' },
+        cache: 'no-store',
+        credentials: 'same-origin'
+      });
+      if (!response.ok || response.redirected ||
+          !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('Expected an HTML fragment');
+      }
+      return response;
+    }
+
+    let refreshing = false;
+    let refreshPending = false;
+    async function refreshMenu() {
+      if (refreshing) {
+        refreshPending = true;
+        return;
+      }
+      refreshing = true;
+      refreshButton.disabled = true;
+      try {
+        do {
+          refreshPending = false;
+          status.textContent = 'Updating seasonal favorites…';
+          const response = await fetchHTML('/api/menu/seasonal');
+          // Parse into a detached container so a failed stream preserves the
+          // current menu. Safe methods strip scripts and event handlers.
+          const nextCards = document.createElement('div');
+          if (typeof nextCards.streamHTML === 'function' && response.body &&
+              typeof TextDecoderStream === 'function') {
+            await response.body.pipeThrough(new TextDecoderStream())
+              .pipeTo(nextCards.streamHTML());
+          } else {
+            nextCards.setHTML(await response.text());
+          }
+          if (!nextCards.querySelector('.card')) throw new Error('Empty menu');
+          cards.replaceChildren(...nextCards.childNodes);
+          status.textContent = 'Seasonal favorites are up to date.';
+        } while (refreshPending);
+      } catch {
+        status.textContent = 'We couldn’t refresh the menu. Please try again.';
+      } finally {
+        refreshing = false;
+        refreshButton.disabled = false;
+      }
+    }
+
+    if (typeof cards.setHTML === 'function') {
+      refreshButton.hidden = false;
+      refreshButton.addEventListener('click', refreshMenu);
+      // Also allows the app's menu publisher to trigger a local update.
+      document.addEventListener('menuchange', refreshMenu);
+      if (typeof EventSource === 'function') {
+        let menuEvents;
+        function connectMenuEvents() {
+          menuEvents = new EventSource('/api/menu/events');
+          menuEvents.addEventListener('menuchange', refreshMenu);
+          // Reconnects may follow missed publications; fetch the current menu.
+          menuEvents.addEventListener('open', refreshMenu);
+        }
+        connectMenuEvents();
+        window.addEventListener('pagehide', () => menuEvents.close());
+        window.addEventListener('pageshow', (event) => {
+          if (event.persisted) connectMenuEvents();
+        });
+      }
+    }
+
+    async function loadReviews() {
+      const reviews = document.getElementById('customer-reviews');
+      if (typeof reviews.setHTML !== 'function') return;
+      try {
+        const response = await fetchHTML('/api/reviews');
+        // Customer content NEVER uses an Unsafe API, even if served locally.
+        reviews.setHTML(await response.text());
+      } catch {
+        // Keep the readable fallback when the review service is unavailable.
+      }
+    }
+
+    async function loadPromo() {
+      const promo = document.getElementById('cms-promo');
+      // The streaming API check avoids enabling this path on older engines
+      // whose setHTMLUnsafe exists but cannot opt into script execution.
+      if (typeof promo.streamHTMLUnsafe !== 'function' ||
+          typeof promo.setHTMLUnsafe !== 'function') return;
+      try {
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        // Trust boundary: only our controlled CMS endpoint may reach this sink.
+        // runScripts is explicit so the CMS's embedded widget can initialize.
+        promo.setHTMLUnsafe(await response.text(), { runScripts: true });
+      } catch {
+        // The rewards link remains usable if the CMS cannot be reached.
+      }
+    }
 
+    loadReviews();
+    loadPromo();
+  </script>
