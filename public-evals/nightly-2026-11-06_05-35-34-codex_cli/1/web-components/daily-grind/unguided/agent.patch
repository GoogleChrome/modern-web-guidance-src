@@ -0,0 +1,200 @@
+const focusStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--focus-color, #986000);
+    outline-offset: 4px;
+  }
+`;
+
+const actionStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  ::slotted(a:hover) { background: #3e2723; }
+  @media (prefers-reduced-motion: reduce) {
+    ::slotted(a) { transition: none; }
+  }
+`;
+
+// Each instance owns its markup and styles. Page content stays declarative,
+// with native headings and links available even before the module loads.
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${focusStyles}
+        ${actionStyles}
+        :host { height: 100%; }
+        article {
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+          text-align: center;
+        }
+        ::slotted(h3) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        ::slotted(p) { margin: 0 0 auto; }
+      </style>
+      <article>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+  }
+}
+
+class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${focusStyles}
+        ${actionStyles}
+        :host { --focus-color: #ffab40; }
+        header {
+          min-height: 60vh;
+          background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+            var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+          background-size: cover;
+          background-position: center;
+          display: flex;
+          flex-direction: column;
+          justify-content: center;
+          align-items: center;
+          color: white;
+          text-align: center;
+          padding: 40px 20px;
+        }
+        ::slotted(h1) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+        ::slotted(p) { margin: 0; }
+      </style>
+      <header>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </header>
+    `;
+  }
+}
+
+class DailyNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${focusStyles}
+        :host { position: sticky; top: 0; z-index: 1000; --focus-color: #ffab40; }
+        nav {
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 1rem 5%;
+          display: flex;
+          justify-content: space-between;
+          align-items: center;
+          gap: 20px;
+        }
+        ::slotted([slot="brand"]) {
+          font-size: 1.5rem;
+          font-weight: bold;
+          letter-spacing: 1px;
+        }
+        .links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+        ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+        ::slotted(a:hover) { color: var(--accent, #ffab40); }
+        ::slotted(.logout-link) {
+          border: 1px solid var(--accent, #ffab40);
+          padding: 5px 12px;
+          border-radius: 4px;
+        }
+        button {
+          display: none;
+          font: inherit;
+          color: white;
+          background: transparent;
+          border: 1px solid var(--accent, #ffab40);
+          border-radius: 4px;
+          min-height: 44px;
+          padding: 8px 12px;
+          cursor: pointer;
+        }
+        @media (max-width: 760px) {
+          nav { flex-wrap: wrap; gap: 12px; }
+          ::slotted([slot="brand"]) { font-size: 1.2rem; }
+          button { display: block; }
+          .links { display: none; width: 100%; align-items: stretch; gap: 8px; }
+          .links[data-open] { display: flex; flex-direction: column; }
+          ::slotted(a) { padding: 10px 12px; }
+          ::slotted(.logout-link) { padding: 10px 12px; }
+        }
+      </style>
+      <nav aria-label="Main navigation">
+        <slot name="brand"></slot>
+        <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+        <div class="links" id="links"><slot></slot></div>
+      </nav>
+    `;
+    this.toggle = this.shadowRoot.querySelector('button');
+    this.links = this.shadowRoot.querySelector('.links');
+    this.onToggle = () => this.setOpen(this.toggle.getAttribute('aria-expanded') !== 'true');
+    this.onKeydown = (event) => {
+      if (event.key === 'Escape' && this.toggle.getAttribute('aria-expanded') === 'true') {
+        this.setOpen(false);
+        this.toggle.focus();
+      }
+    };
+    this.onNavigate = (event) => {
+      if (event.composedPath().some((node) => node instanceof HTMLAnchorElement)) {
+        this.setOpen(false);
+      }
+    };
+    this.onViewportChange = () => {
+      const focusWasOnToggle = this.shadowRoot.activeElement === this.toggle;
+      const focusWasInLinks = this.contains(document.activeElement);
+      this.setOpen(false);
+      if (!this.mobile.matches && focusWasOnToggle) {
+        this.querySelector('a:not([slot])')?.focus();
+      } else if (this.mobile.matches && focusWasInLinks) {
+        this.toggle.focus();
+      }
+    };
+  }
+
+  connectedCallback() {
+    this.mobile = window.matchMedia('(max-width: 760px)');
+    this.toggle.addEventListener('click', this.onToggle);
+    this.shadowRoot.addEventListener('keydown', this.onKeydown);
+    this.links.addEventListener('click', this.onNavigate);
+    this.mobile.addEventListener('change', this.onViewportChange);
+    this.setOpen(false);
+  }
+
+  disconnectedCallback() {
+    this.toggle.removeEventListener('click', this.onToggle);
+    this.shadowRoot.removeEventListener('keydown', this.onKeydown);
+    this.links.removeEventListener('click', this.onNavigate);
+    this.mobile.removeEventListener('change', this.onViewportChange);
+  }
+
+  setOpen(open) {
+    this.toggle.setAttribute('aria-expanded', String(open));
+    this.links.toggleAttribute('data-open', open);
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+customElements.define('coffee-hero', CoffeeHero);
+customElements.define('daily-navigation', DailyNavigation);
