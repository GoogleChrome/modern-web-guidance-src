@@ -0,0 +1,41 @@
+# Daily Grind components
+
+Load `daily-grind.js` once with a module script. No framework or build step is required.
+All four custom elements use open Shadow DOM, native semantic elements, and named
+slots. Keep slot content as direct children of the host; retain native headings
+and anchors for semantics and no-JavaScript access.
+
+```html
+<coffee-card>
+  <h3 slot="heading">House Blend</h3>
+  <p slot="description">Our everyday favorite.</p>
+  <a slot="action" href="/menu/house-blend"
+     aria-label="View details for House Blend">View Details</a>
+</coffee-card>
+```
+
+Choose the heading level appropriate to the surrounding document. Give repeated
+action links descriptive accessible names, as above. Hosts do not add tab stops;
+their native links and buttons participate in normal keyboard navigation.
+
+| Element | Slots | Exposed parts |
+| --- | --- | --- |
+| `coffee-card` | `heading`, `description`, `action` | `card` |
+| `grind-hero` | `heading`, `description`, `action` | `hero` |
+| `grind-navigation` | `brand`, `links` (multiple anchors) | `navigation`, `toggle` |
+| `grind-footer` | `links` (multiple anchors), `copyright` | `footer` |
+
+Theme through inherited `--primary`, `--secondary`, `--accent`, and `--text`
+properties. Each has a default inside the component. Override the hero background
+with `--hero-image: url(...)`. Use `::part()` for deliberate internal overrides.
+Page layout, including sticky positioning, remains in `styles.css`.
+
+The navigation collapses at 48rem. Its native Menu button supports Enter and
+Space, exposes `aria-expanded`, and controls a panel in the same shadow root.
+Escape closes the panel and returns focus to the button. Closed links are hidden
+from keyboard navigation. Resizing preserves visible focus. Event listeners are
+removed on disconnect and restored on reconnect, allowing independent instances.
+
+Before JavaScript upgrades the elements, all source links and text stay visible.
+The source markup also remains available if scripts fail; the mobile disclosure
+and shadow styling require JavaScript.
diff --git a/components/daily-grind.js b/components/daily-grind.js
new file mode 100644
index 0000000..4e6abaf
--- /dev/null
+++ b/components/daily-grind.js
@@ -0,0 +1,177 @@
+// Parse static templates once; project consumer content without HTML interpolation.
+const baseStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid currentColor; outline-offset: 4px;
+  }
+`;
+const actionStyles = `
+  ::slotted([slot="action"]) {
+    display: inline-block; background: var(--primary, #4e342e); color: white;
+    padding: 10px 20px; text-decoration: none; border-radius: 5px;
+    margin-top: 15px; transition: background 0.3s;
+  }
+  ::slotted([slot="action"]:hover) { background: #3e2723; }
+  ::slotted([slot="action"]:focus-visible) {
+    outline-color: var(--primary, #4e342e);
+    box-shadow: 0 0 0 7px white;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    ::slotted([slot="action"]) { transition: none; }
+  }
+`;
+function template(markup, styles) {
+  const result = document.createElement('template');
+  result.innerHTML = `<style>${baseStyles}${styles}</style>${markup}`;
+  return result;
+}
+const cardTemplate = template(`
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <div class="action"><slot name="action"></slot></div>
+  </article>
+`, `
+  :host { height: 100%; }
+  article {
+    height: 100%; padding: 20px; background: white; border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1); text-align: center;
+    display: flex; flex-direction: column; align-items: center;
+  }
+  ::slotted([slot="heading"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+  ::slotted([slot="description"]) { margin: 0; }
+  .action { margin-top: auto; }
+  ${actionStyles}
+`);
+const heroTemplate = template(`
+  <header part="hero">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </header>
+`, `
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.5)),
+      var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+    background-size: cover; background-position: center;
+    display: flex; flex-direction: column; justify-content: center; align-items: center;
+    color: white; text-align: center; padding: 40px 20px;
+  }
+  ::slotted([slot="heading"]) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+  ::slotted([slot="description"]) { margin: 0; }
+  ${actionStyles}
+`);
+const navigationTemplate = template(`
+  <nav aria-label="Main navigation" part="navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="links" part="toggle">Menu</button>
+    <div id="links"><slot name="links"></slot></div>
+  </nav>
+`, `
+  nav {
+    background: var(--primary, #4e342e); color: white; padding: 1rem 5%;
+    display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap;
+  }
+  ::slotted(a) { color: white; text-decoration: none; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted([slot="brand"]) { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  #links { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
+  #links[hidden] { display: none; }
+  ::slotted([slot="links"]) { font-size: 0.9rem; }
+  ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button {
+    display: none; font: inherit; color: inherit; background: transparent;
+    border: 1px solid currentColor; border-radius: 4px; padding: 8px 12px; cursor: pointer;
+  }
+  @media (max-width: 48rem) {
+    button { display: block; }
+    #links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 4px; }
+    ::slotted([slot="links"]) { padding: 10px 12px; }
+  }
+`);
+const footerTemplate = template(`
+  <footer part="footer">
+    <nav aria-label="Footer navigation"><slot name="links"></slot></nav>
+    <slot name="copyright"></slot>
+  </footer>
+`, `
+  footer { background: var(--secondary, #d7ccc8); text-align: center; padding: 40px 20px; }
+  nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 20px; }
+  ::slotted(a) { color: var(--text, #3e2723); text-decoration: none; font-size: 0.85rem; padding: 5px 0; }
+  ::slotted(a:hover) { text-decoration: underline; }
+  ::slotted(p) { margin: 0; }
+`);
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(cardTemplate.content.cloneNode(true));
+  }
+}
+class GrindHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(heroTemplate.content.cloneNode(true));
+  }
+}
+class GrindFooter extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(footerTemplate.content.cloneNode(true));
+  }
+}
+class GrindNavigation extends HTMLElement {
+  #controller;
+  #mobile = window.matchMedia('(max-width: 48rem)');
+  #expanded = false;
+  #button;
+  #links;
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(navigationTemplate.content.cloneNode(true));
+    this.#button = this.shadowRoot.querySelector('button');
+    this.#links = this.shadowRoot.getElementById('links');
+  }
+  connectedCallback() {
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const options = { signal: this.#controller.signal };
+    this.#button.addEventListener('click', () => {
+      this.#expanded = !this.#expanded;
+      this.#sync();
+    }, options);
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#mobile.matches && this.#expanded) {
+        event.preventDefault();
+        this.#expanded = false;
+        this.#sync();
+        this.#button.focus();
+      }
+    }, options);
+    this.#mobile.addEventListener('change', () => {
+      // Avoid hiding a focused link when the viewport becomes narrow.
+      if (this.#mobile.matches && this.contains(document.activeElement)) this.#expanded = true;
+      if (!this.#mobile.matches && this.shadowRoot.activeElement === this.#button) {
+        this.querySelector('a[slot="brand"]')?.focus();
+      }
+      this.#sync();
+    }, options);
+    this.#sync();
+  }
+  disconnectedCallback() {
+    this.#controller.abort();
+  }
+  #sync() {
+    const visible = !this.#mobile.matches || this.#expanded;
+    this.#links.hidden = !visible;
+    this.#button.setAttribute('aria-expanded', String(visible));
+  }
+}
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard], ['grind-hero', GrindHero],
+  ['grind-navigation', GrindNavigation], ['grind-footer', GrindFooter],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
