diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..07e4891
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,32 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--light);
+}
+/* Page layout stays outside the components; each component owns its visuals. */
+grind-navigation, grind-hero, coffee-card, grind-footer { display: block; }
+grind-navigation { position: sticky; top: 0; z-index: 1000; }
+.container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
+h2 { margin: 0; text-align: center; }
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+grind-footer { margin-top: 40px; }
+.skip-link { position: fixed; top: 8px; left: 8px; z-index: 1001; transform: translateY(-200%); }
+.skip-link:focus { transform: none; padding: 10px 20px; background: white; color: var(--primary); }
+/* Keep source content readable and navigable before upgrade or without JS. */
+grind-navigation:not(:defined), grind-hero:not(:defined), grind-footer:not(:defined), coffee-card:not(:defined) { padding: 20px; }
+grind-navigation:not(:defined) a, grind-footer:not(:defined) a { display: inline-block; margin: 5px 10px; }
