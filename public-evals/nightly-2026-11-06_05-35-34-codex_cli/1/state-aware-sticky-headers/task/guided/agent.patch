+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsStickyFallback = !CSS.supports('container-type: scroll-state');
+    let pendingFrame = false;
+
+    function updateHeaders() {
+      pendingFrame = false;
+      const navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+
+      if (needsStickyFallback) {
+        for (const container of stickyContainers) {
+          const sectionTop = container.parentElement.getBoundingClientRect().top;
+          const headerTop = container.getBoundingClientRect().top;
+          container.classList.toggle('is-stuck',
+            sectionTop < navigationHeight && Math.abs(headerTop - navigationHeight) < 1);
+        }
+      }
+    }
+
+    function scheduleUpdate() {
+      if (!pendingFrame) {
+        pendingFrame = true;
+        requestAnimationFrame(updateHeaders);
+      }
+    }
+
+    // The viewport is the scroll root; no nested scrolling element is created.
+    if (needsStickyFallback) {
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    }
+    new ResizeObserver(scheduleUpdate).observe(navigation);
+    window.addEventListener('resize', scheduleUpdate);
+    updateHeaders();
+  </script>
+
 </body>
 
