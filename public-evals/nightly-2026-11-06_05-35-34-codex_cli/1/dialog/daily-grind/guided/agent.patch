+  <dialog id="drink-dialog" class="drink-dialog" closedby="any" aria-labelledby="drink-dialog-title" aria-describedby="drink-description">
+    <h2 id="drink-dialog-title">Drink details &amp; ordering</h2>
+    <p id="drink-description" aria-live="polite"></p>
+    <form action="/order-online" method="get">
+      <label for="drink-choice">Drink</label>
+      <select id="drink-choice" name="drink" autofocus>
+        <option value="maple-oat-latte">Maple Oat Latte</option>
+        <option value="dark-roast-espresso">Dark Roast Espresso</option>
+        <option value="cold-brew">Cold Brew</option>
+      </select>
+      <label for="drink-size">Size</label>
+      <select id="drink-size" name="size"></select>
+      <label for="drink-quantity">Quantity</label>
+      <input id="drink-quantity" name="quantity" type="number" min="1" max="20" step="1" value="1" required>
+      <p>Continue to online ordering to review availability and pricing.</p>
+      <button type="submit" class="btn">Continue to ordering</button>
+    </form>
+    <form method="dialog" class="dialog-close">
+      <button type="submit" class="btn">Close</button>
+    </form>
+  </dialog>
+
+  <script>
+    const drinkDialog = document.getElementById('drink-dialog');
+    const drinkChoice = document.getElementById('drink-choice');
+    const drinkSize = document.getElementById('drink-size');
+    const drinkQuantity = document.getElementById('drink-quantity');
+    const drinkDescription = document.getElementById('drink-description');
+    const drinks = {
+      'maple-oat-latte': {
+        description: 'Maple Oat Latte: Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Regular', 'Large']
+      },
+      'dark-roast-espresso': {
+        description: 'Dark Roast Espresso: Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot']
+      },
+      'cold-brew': {
+        description: 'Cold Brew: Steeped for 18 hours for maximum smoothness.',
+        sizes: ['Regular', 'Large']
+      }
+    };
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      drinkDescription.textContent = drink.description;
+      drinkSize.replaceChildren(...drink.sizes.map((size) => new Option(size, size)));
+    }
+
+    drinkChoice.addEventListener('change', updateDrink);
+
+    document.querySelectorAll('[data-drink]').forEach((button) => {
+      button.addEventListener('click', () => {
+        drinkChoice.value = button.dataset.drink;
+        drinkQuantity.value = '1';
+        updateDrink();
+        // Native modal behavior contains focus and restores it to the opener on close.
+        drinkDialog.showModal();
+      });
+    });
+
+    // Older browsers still support native Escape dismissal, but need light dismiss.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const isOutside = (event) => {
+        const rect = drinkDialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let outsidePointer = null;
+      drinkDialog.addEventListener('pointerdown', (event) => {
+        outsidePointer = event.isPrimary && event.button === 0 && isOutside(event)
+          ? event.pointerId : null;
+      });
+      drinkDialog.addEventListener('pointerup', (event) => {
+        if (outsidePointer === event.pointerId && isOutside(event)) drinkDialog.close();
+        outsidePointer = null;
+      });
+      drinkDialog.addEventListener('pointercancel', () => { outsidePointer = null; });
+      drinkDialog.addEventListener('close', () => { outsidePointer = null; });
+    }
+  </script>
+
 </body>
 
