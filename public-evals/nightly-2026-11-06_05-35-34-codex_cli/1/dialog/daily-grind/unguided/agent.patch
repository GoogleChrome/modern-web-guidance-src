+  <dialog id="drink-dialog" aria-labelledby="dialog-title" aria-describedby="drink-description" closedby="any">
+    <div class="dialog-header">
+      <h2 id="dialog-title" tabindex="-1">Maple Oat Latte</h2>
+      <button type="button" class="dialog-close">Close</button>
+    </div>
+    <p id="drink-description"></p>
+    <p>Review your drink selection here. Ordering online is not available on this page.</p>
+    <form id="order-form">
+      <div class="order-field">
+        <label for="drink-choice">Drink</label>
+        <select id="drink-choice" name="drink">
+          <option value="maple">Maple Oat Latte</option>
+          <option value="espresso">Dark Roast Espresso</option>
+          <option value="cold-brew">Cold Brew</option>
+        </select>
+      </div>
+      <div class="order-field">
+        <label for="drink-size">Size</label>
+        <select id="drink-size" name="size"></select>
+      </div>
+      <div class="order-field">
+        <label for="drink-quantity">Quantity</label>
+        <input id="drink-quantity" name="quantity" type="number" min="1" max="10" step="1" value="1" required>
+      </div>
+      <button type="submit" class="btn">Review selection</button>
+      <p id="order-summary" role="status" aria-atomic="true"></p>
+    </form>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)']
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        sizes: ['Small (12 oz)', 'Large (16 oz)']
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const title = document.getElementById('dialog-title');
+    const description = document.getElementById('drink-description');
+    const form = document.getElementById('order-form');
+    const drinkChoice = document.getElementById('drink-choice');
+    const sizeChoice = document.getElementById('drink-size');
+    const quantity = document.getElementById('drink-quantity');
+    const summary = document.getElementById('order-summary');
+    let opener;
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      title.textContent = drink.name;
+      description.textContent = drink.description;
+      sizeChoice.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+      summary.textContent = '';
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        form.reset();
+        drinkChoice.value = button.dataset.drink;
+        updateDrink();
+        dialog.showModal();
+        title.focus();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    form.addEventListener('input', () => { summary.textContent = ''; });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      summary.textContent = `Your selection: ${quantity.value} × ${drinks[drinkChoice.value].name}, ${sizeChoice.value}. Ordering online is not available on this page.`;
+    });
+
+    dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      if (opener?.isConnected) opener.focus();
+    });
+
+    // Light dismissal for browsers without support for closedby="any".
+    // Require both ends of the gesture outside to avoid closing on a drag out.
+    function isOutside(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+
+    let startedOutside = false;
+    dialog.addEventListener('pointerdown', event => {
+      startedOutside = event.target === dialog && isOutside(event);
+    });
+    dialog.addEventListener('pointercancel', () => { startedOutside = false; });
+    dialog.addEventListener('click', event => {
+      if (startedOutside && event.target === dialog && isOutside(event)) dialog.close();
+      startedOutside = false;
+    });
+    // Escape and platform close requests use the dialog's native cancel behavior.
+  </script>
+
 </body>
 
