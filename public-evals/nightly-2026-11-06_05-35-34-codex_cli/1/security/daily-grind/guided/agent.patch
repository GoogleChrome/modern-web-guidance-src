+// No scripts are needed by this site; deny execution rather than authorizing code.
+const POLICY = [
+  "default-src 'none'", "script-src 'none' 'report-sample'",
+  "script-src-attr 'none'", "style-src 'self'", "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com", "connect-src 'none'",
+  "object-src 'none'", "base-uri 'none'", "frame-ancestors 'none'",
+  "form-action 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'",
+  'report-uri /security-reports',
+];
+
+function securityHeaders(env = process.env) {
+  const mode = env.CSP_MODE || 'enforce';
+  if (!['enforce', 'report-only'].includes(mode)) throw new Error('Invalid CSP_MODE');
+  const headers = {
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+  };
+  const policy = [...POLICY];
+  // Never derive security-sensitive URLs from Host or X-Forwarded-*.
+  if (env.PUBLIC_ORIGIN) {
+    const origin = new URL(env.PUBLIC_ORIGIN);
+    if (origin.protocol !== 'https:' || origin.origin !== env.PUBLIC_ORIGIN) {
+      throw new Error('PUBLIC_ORIGIN must be an HTTPS origin without a trailing slash');
+    }
+    headers['Reporting-Endpoints'] = `default="${origin.origin}/security-reports"`;
+    policy.push('report-to default');
+    // Start short; do not commit unaudited subdomains or preload.
+    headers['Strict-Transport-Security'] = 'max-age=300';
+  }
+  if (mode === 'report-only') {
+    headers['Content-Security-Policy'] = "object-src 'none'; base-uri 'none'; frame-ancestors 'none'";
+    headers['Content-Security-Policy-Report-Only'] = policy.join('; ');
+  } else {
+    headers['Content-Security-Policy'] = policy.join('; ');
+  }
+  return headers;
+}
+
+function isCrossSiteRequestBlocked(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (!site || site === 'same-origin' || site === 'none') return false;
+  return !(['GET', 'HEAD'].includes(req.method)
+    && req.headers['sec-fetch-mode'] === 'navigate'
+    && req.headers['sec-fetch-dest'] === 'document');
+}
+
+module.exports = { securityHeaders, isCrossSiteRequestBlocked };
