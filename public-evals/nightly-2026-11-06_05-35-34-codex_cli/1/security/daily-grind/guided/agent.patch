@@ -0,0 +1,100 @@
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders, isCrossSiteRequestBlocked } = require('./security');
+
+const DIRECTIVES = new Set(['default-src', 'script-src', 'script-src-elem',
+  'script-src-attr', 'style-src', 'style-src-elem', 'style-src-attr', 'img-src',
+  'connect-src', 'font-src', 'object-src', 'base-uri', 'frame-ancestors',
+  'form-action', 'require-trusted-types-for', 'trusted-types', 'frame-src',
+  'worker-src', 'media-src', 'manifest-src']);
+
+function createHandler({ env = process.env, log = console.info } = {}) {
+  const headers = securityHeaders(env);
+  let windowStart = Date.now();
+  let reportRequests = 0;
+
+  return async function handle(req, res) {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, body = '', type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    let pathname;
+    try {
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return send(400, 'Bad request');
+    }
+
+    if (pathname === '/security-reports') {
+      res.setHeader('Cache-Control', 'no-store');
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return send(405, 'Method not allowed');
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim();
+      if (!['application/csp-report', 'application/reports+json'].includes(type)) {
+        return send(415, 'Unsupported media type');
+      }
+      // Bound parsing and log amplification without storing client identifiers.
+      if (Date.now() - windowStart >= 60_000) {
+        windowStart = Date.now();
+        reportRequests = 0;
+      }
+      if (++reportRequests > 60) {
+        res.setHeader('Retry-After', '60');
+        return send(429, 'Too many reports');
+      }
+      try {
+        let size = 0;
+        const chunks = [];
+        for await (const chunk of req) {
+          size += chunk.length;
+          if (size > 16_384) return send(413, 'Report too large');
+          chunks.push(chunk);
+        }
+        const payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        const reports = type === 'application/csp-report'
+          ? [payload?.['csp-report']]
+          : (Array.isArray(payload) ? payload.slice(0, 20)
+            .filter(report => report?.type === 'csp-violation').map(report => report.body) : []);
+        if (!reports.length || reports.some(report => !report || typeof report !== 'object')) {
+          return send(400, 'Invalid report');
+        }
+        // No raw JSON, URLs, query strings, script samples or user agents in logs.
+        const counts = {};
+        for (const report of reports) {
+          const value = report.effectiveDirective || report['effective-directive'];
+          const directive = DIRECTIVES.has(value) ? value : 'other';
+          counts[directive] = (counts[directive] || 0) + 1;
+        }
+        log(JSON.stringify({ event: 'csp-violation', counts }));
+        return send(204);
+      } catch {
+        return send(400, 'Invalid report');
+      }
+    }
+
+    if (isCrossSiteRequestBlocked(req)) return send(403, 'Forbidden');
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'Method not allowed');
+    }
+    if (pathname === '/logout' || pathname === '/logout/') {
+      res.setHeader('Cache-Control', 'no-store');
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      return send(200, 'Logged out');
+    }
+
+    // Explicit mapping prevents URL paths from selecting arbitrary local files.
+    const isStylesheet = pathname === '/styles.css';
+    try {
+      const data = await fs.readFile(path.join(__dirname, isStylesheet ? 'styles.css' : 'index.html'));
+      return send(200, data, isStylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      return send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
