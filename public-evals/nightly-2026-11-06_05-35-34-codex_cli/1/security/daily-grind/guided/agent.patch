index 0000000..5f315cf
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,106 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const fs = require('node:fs/promises');
+const { createHandler } = require('../app');
+const { securityHeaders } = require('../security');
+
+// Invoke the handler directly: no sockets, browser, or server entrypoint.
+async function request(handler, url = '/', { method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from([Buffer.from(body)]);
+  Object.assign(req, { url, method, headers });
+  const res = {
+    headers: {},
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      for (const [name, value] of Object.entries(headers)) this.setHeader(name, value);
+    },
+    end(body) { this.body = body?.toString() || ''; },
+  };
+  await handler(req, res);
+  return res;
+}
+
+test('markup and styles fit the enforced policy without inline exceptions', async () => {
+  const handler = createHandler({ env: {} });
+  for (const url of ['/', '/menu', '/account', '/logout', '/styles.css']) {
+    const response = await request(handler, url);
+    assert.equal(response.status, 200);
+    const csp = response.headers['content-security-policy'];
+    for (const directive of ["default-src 'none'", "script-src 'none' 'report-sample'",
+      "style-src 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'",
+      "frame-ancestors 'none'", 'report-uri /security-reports']) {
+      assert.ok(csp.includes(directive), directive);
+    }
+    assert.equal(response.headers['x-content-type-options'], 'nosniff');
+    assert.equal(response.headers['x-frame-options'], 'DENY');
+    assert.equal(response.headers['cross-origin-resource-policy'], 'same-origin');
+    assert.ok(!csp.includes('unsafe-inline') && !csp.includes('unsafe-eval'));
+    assert.equal(response.headers['strict-transport-security'], undefined);
+  }
+  const html = (await request(handler)).body;
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(html, /href="\/styles.css"/);
+  const css = await request(handler, '/styles.css');
+  assert.equal(css.headers['content-type'], 'text/css; charset=utf-8');
+  assert.match(css.body, /\.section-title/);
+  const urls = [...(await fs.readFile('styles.css', 'utf8')).matchAll(/url\(['"]?([^'")]+)/g)];
+  assert.ok(urls.every(([, value]) => new URL(value).origin === 'https://images.unsplash.com'));
+});
+
+test('secure deployment configuration and report-only rollback retain basic defenses', () => {
+  const headers = securityHeaders({ PUBLIC_ORIGIN: 'https://coffee.example', CSP_MODE: 'report-only' });
+  assert.equal(headers['Strict-Transport-Security'], 'max-age=300');
+  assert.equal(headers['Reporting-Endpoints'], 'default="https://coffee.example/security-reports"');
+  assert.match(headers['Content-Security-Policy-Report-Only'], /report-to default/);
+  assert.match(headers['Content-Security-Policy'], /frame-ancestors 'none'/);
+  for (const origin of ['http://coffee.example', 'https://coffee.example/path', 'https://user:pass@coffee.example']) {
+    assert.throws(() => securityHeaders({ PUBLIC_ORIGIN: origin }));
+  }
+  assert.throws(() => securityHeaders({ CSP_MODE: 'typo' }));
+});
+
+test('resource isolation permits incoming links and rejects cross-site asset loads and writes', async () => {
+  const handler = createHandler({ env: {} });
+  const cross = { 'sec-fetch-site': 'cross-site' };
+  assert.equal((await request(handler, '/styles.css', { headers: cross })).status, 403);
+  assert.equal((await request(handler, '/', { headers: { ...cross,
+    'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } })).status, 200);
+  assert.equal((await request(handler, '/', { method: 'POST', headers: cross })).status, 403);
+  const method = await request(handler, '/', { method: 'POST' });
+  assert.equal(method.status, 405);
+  assert.equal(method.headers.allow, 'GET, HEAD');
+  const head = await request(handler, '/styles.css', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(head.body, '');
+  const logout = await request(handler, '/logout');
+  assert.equal(logout.headers['cache-control'], 'no-store');
+  assert.equal(logout.headers['clear-site-data'], '"cookies", "storage", "cache"');
+});
+
+test('both report formats redact secrets and bound malformed or excessive input', async () => {
+  const logs = [];
+  const handler = createHandler({ env: {}, log: value => logs.push(value) });
+  const post = (body, type = 'application/csp-report') => request(handler, '/security-reports', {
+    method: 'POST', headers: { 'content-type': type }, body,
+  });
+  assert.equal((await post(JSON.stringify({ 'csp-report': {
+    'effective-directive': 'script-src-elem', 'document-uri': 'https://example/?secret=token',
+    'script-sample': 'private data', 'blocked-uri': 'https://secret.example',
+  } }))).status, 204);
+  assert.equal((await post(JSON.stringify([{ type: 'csp-violation',
+    body: { effectiveDirective: 'trusted-types', sample: 'private data' } }]),
+  'application/reports+json')).status, 204);
+  assert.deepEqual(logs.map(JSON.parse), [
+    { event: 'csp-violation', counts: { 'script-src-elem': 1 } },
+    { event: 'csp-violation', counts: { 'trusted-types': 1 } },
+  ]);
+  assert.equal((await post('{')).status, 400);
+  assert.equal((await post('{}')).status, 400);
+  assert.equal((await post('x'.repeat(16_385))).status, 413);
+  assert.equal((await post('{}', 'text/plain')).status, 415);
+  assert.equal((await request(handler, '/security-reports')).status, 405);
+  for (let i = 0; i < 55; i++) await post('{}');
+  assert.equal((await post('{}')).status, 429);
+});
