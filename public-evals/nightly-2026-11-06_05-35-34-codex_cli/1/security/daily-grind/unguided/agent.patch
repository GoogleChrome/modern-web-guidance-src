@@ -0,0 +1,80 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const fs = require('node:fs/promises');
+const { createHandler } = require('../handler');
+const { securityHeaders } = require('../security');
+
+// Exercise requests in memory; never import server.js or open a socket.
+async function request({ url = '/', method = 'GET', type, body = '', mode, onViolation } = {}) {
+  const req = Readable.from([Buffer.from(body)]);
+  Object.assign(req, { url, method, headers: type ? { 'content-type': type } : {} });
+  const res = {
+    headers: {}, headersSent: false,
+    setHeader(name, value) { this.headers[name] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      Object.assign(this.headers, headers);
+      this.headersSent = true;
+    },
+    end(body) { this.body = body?.toString() || ''; },
+  };
+  await createHandler({ mode, onViolation })(req, res);
+  return res;
+}
+
+test('safe rollout keeps baseline enforced and candidate report-only', () => {
+  const headers = securityHeaders();
+  assert.match(headers['Content-Security-Policy'], /script-src 'none'/);
+  assert.match(headers['Content-Security-Policy'], /frame-ancestors 'none'/);
+  const candidate = headers['Content-Security-Policy-Report-Only'];
+  assert.match(candidate, /style-src 'self'/);
+  assert.match(candidate, /img-src 'self' https:\/\/images.unsplash.com/);
+  assert.match(candidate, /report-uri \/csp-report/);
+  assert.doesNotMatch(candidate, /unsafe-inline|unsafe-eval|\*/);
+  const enforced = securityHeaders('enforce');
+  assert.equal(enforced['Content-Security-Policy'], candidate);
+  assert.equal(enforced['Content-Security-Policy-Report-Only'], undefined);
+  assert.throws(() => securityHeaders('off'));
+});
+
+test('markup and CSS work without inline code or extra remote origins', async () => {
+  const html = await fs.readFile('index.html', 'utf8');
+  const css = await fs.readFile('styles.css', 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(html, /<link rel="stylesheet" href="\/styles.css">/);
+  assert.doesNotMatch(css, /@import/i);
+  const urls = [...css.matchAll(/url\(['"]?([^'"\)]+)/g)].map((match) => new URL(match[1]));
+  assert.equal(urls.length, 1);
+  assert.equal(urls[0].origin, 'https://images.unsplash.com');
+});
+
+test('headers cover pages, assets, logout, and errors in both modes', async () => {
+  for (const mode of ['report-only', 'enforce']) {
+    for (const options of [{}, { url: '/menu' }, { url: '/styles.css' }, { url: '/logout' }, { method: 'PUT' }, { url: 'http://[' }]) {
+      const res = await request({ ...options, mode });
+      for (const [name, value] of Object.entries(securityHeaders(mode))) assert.equal(res.headers[name], value);
+    }
+  }
+  const css = await request({ url: '/styles.css' });
+  assert.equal(css.headers['Content-Type'], 'text/css; charset=utf-8');
+  assert.match(css.body, /\.hero/);
+  assert.equal((await request({ method: 'HEAD' })).body, '');
+  assert.equal((await request({ method: 'PUT' })).status, 405);
+  assert.equal((await request({ url: 'http://[' })).status, 400);
+});
+
+test('CSP reports are bounded, validated, and stripped of private data', async () => {
+  const summaries = [];
+  const options = { url: '/csp-report', method: 'POST', type: 'application/csp-report', onViolation: (summary) => summaries.push(summary) };
+  const body = JSON.stringify({ 'csp-report': { 'effective-directive': 'script-src-elem', disposition: 'enforce', 'document-uri': 'https://example.com/private?secret=1', 'script-sample': 'sensitive' } });
+  assert.equal((await request({ ...options, body })).status, 204);
+  assert.deepEqual(summaries, [{ directive: 'script-src-elem', disposition: 'enforce' }]);
+  assert.equal((await request({ ...options, body: '{' })).status, 400);
+  assert.equal((await request({ ...options, body: 'null' })).status, 400);
+  assert.equal((await request({ ...options, body: JSON.stringify({ 'csp-report': { 'effective-directive': 'bad\nlog' } }) })).status, 400);
+  assert.equal((await request({ ...options, body: 'x'.repeat(16385) })).status, 413);
+  assert.equal((await request({ ...options, type: 'text/plain', body })).status, 415);
+  assert.equal((await request({ ...options, method: 'GET' })).status, 405);
+  assert.equal(summaries.length, 1);
+});
