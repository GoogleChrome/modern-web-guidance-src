+// Keep this module free of server startup so policies can be checked offline.
+const baseline = "base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'none'";
+const policy = [
+  "default-src 'none'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+  "script-src 'none'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com",
+  "font-src 'none'",
+  "connect-src 'none'",
+  "form-action 'none'",
+  "frame-src 'none'",
+  "worker-src 'none'",
+  "manifest-src 'none'",
+  'report-uri /csp-report',
+].join('; ');
+
+function securityHeaders(mode = 'report-only') {
+  if (!['report-only', 'enforce'].includes(mode)) {
+    throw new Error('CSP_MODE must be report-only or enforce');
+  }
+  return {
+    'Content-Security-Policy': mode === 'enforce' ? policy : baseline,
+    ...(mode === 'report-only' ? { 'Content-Security-Policy-Report-Only': policy } : {}),
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'no-referrer',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+    'Cache-Control': 'no-store',
+  };
+}
+
+module.exports = { securityHeaders };
