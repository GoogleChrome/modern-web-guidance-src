+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders } = require('./security');
+
+const MAX_REPORT_BYTES = 16 * 1024;
+
+function createHandler({ mode = 'report-only', onViolation = (summary) => console.warn('CSP violation', summary) } = {}) {
+  const headers = securityHeaders(mode);
+  return async function handler(req, res) {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, body = '', type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    let pathname;
+    try {
+      // Never trust Host to construct a URL or a response header.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'Bad request');
+      return;
+    }
+
+    if (pathname === '/csp-report') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        send(405, 'Method not allowed');
+        return;
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+      if (type !== 'application/csp-report') {
+        send(415, 'Unsupported media type');
+        req.resume();
+        return;
+      }
+      try {
+        const chunks = [];
+        let bytes = 0;
+        for await (const chunk of req.iterator({ destroyOnReturn: false })) {
+          bytes += chunk.length;
+          if (bytes > MAX_REPORT_BYTES) {
+            send(413, 'Report too large');
+            req.resume();
+            return;
+          }
+          chunks.push(chunk);
+        }
+        const report = JSON.parse(Buffer.concat(chunks).toString('utf8'))?.['csp-report'];
+        const directive = report?.['effective-directive'];
+        if (typeof directive !== 'string' || !/^[a-z-]{1,64}$/.test(directive)) {
+          send(400, 'Invalid report');
+          return;
+        }
+        // Reports are untrusted. Never log URLs, source samples, or raw bodies.
+        onViolation({ directive, disposition: report.disposition === 'enforce' ? 'enforce' : 'report' });
+        send(204);
+      } catch {
+        if (!res.headersSent) send(400, 'Invalid report');
+      }
+      return;
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'Method not allowed');
+      return;
+    }
+    if (pathname === '/logout' || pathname === '/logout/') {
+      send(200, 'Logged out');
+      return;
+    }
+    // Preserve the existing page fallback; only explicitly listed assets are read.
+    const css = pathname === '/styles.css';
+    try {
+      const body = await fs.readFile(path.join(__dirname, css ? 'styles.css' : 'index.html'));
+      send(200, body, css ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
