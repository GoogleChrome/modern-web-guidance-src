+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativeAnchoring = CSS.supports('anchor-name: --rewards') && CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Block mouse, keyboard, and middle-click navigation during this step.
+    const preventTourNavigation = (event) => {
+      if (tourOpen) event.preventDefault();
+    };
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+
+    // Track layout shifts as well as scrolling and resizing in older browsers.
+    function trackRewards() {
+      if (!tourOpen) return;
+      const target = rewardsLink.getBoundingClientRect();
+      const width = tourStep.offsetWidth;
+      const height = tourStep.offsetHeight;
+      const left = Math.max(16, Math.min(target.left, window.innerWidth - width - 16));
+      const top = target.bottom + 14 + height <= window.innerHeight - 16
+        ? target.bottom + 14
+        : Math.max(16, target.top - height - 14);
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${top}px`;
+      trackingFrame = requestAnimationFrame(trackRewards);
+    }
+
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (nativePopover) tourStep.hidePopover();
+      else tourStep.hidden = true;
+      rewardsLink.removeAttribute('aria-describedby');
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (nativePopover) tourStep.showPopover();
+    if (!nativeAnchoring) trackRewards();
+    closeTour.focus({ preventScroll: true });
+  </script>
 </body>
 
