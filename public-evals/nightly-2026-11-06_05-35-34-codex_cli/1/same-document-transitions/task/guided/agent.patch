+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const detailImage = document.getElementById('detail-image');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const descriptions = {
+      'maple-oat-latte': ['Espresso meets silky oat milk and a gentle touch of Vermont maple syrup. A cozy, lightly sweet companion for crisp mornings.', 'Tasting notes: maple, toasted oats, and rich espresso.'],
+      'dark-roast-espresso': ['A full-bodied dark roast with a deep, smoky finish. Enjoy a small cup with plenty of character, freshly pulled to bring out its rich flavor.', 'Tasting notes: dark chocolate, toasted nuts, and a smoky finish.'],
+      'cold-brew': ['Slowly steeped for 18 hours, our cold brew is smooth, refreshing, and ready to pour over ice. Take your time with every sip.', 'Tasting notes: cocoa, mellow sweetness, and a clean finish.']
+    };
+    let activeFavorite = null;
+    let activeTransition = null;
+    let navigationVersion = 0;
+    let listScroll = 0;
+
+    function favoriteFromHash() {
+      const slug = location.hash.startsWith('#favorite/') ? location.hash.slice(10) : null;
+      return thumbnails.some(card => card.dataset.favorite === slug) ? slug : null;
+    }
+
+    function render(favorite) {
+      if (favorite) {
+        const card = thumbnails.find(card => card.dataset.favorite === favorite);
+        const image = card.querySelector('img');
+        detailImage.src = image.src;
+        detailImage.alt = image.alt;
+        title.textContent = card.querySelector('.title').textContent;
+        document.getElementById('description').textContent = descriptions[favorite][0];
+        document.getElementById('tasting-notes').textContent = descriptions[favorite][1];
+      }
+      listPage.hidden = Boolean(favorite);
+      detailPage.hidden = !favorite;
+      activeFavorite = favorite;
+      document.title = favorite ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function clearTransitionState() {
+      thumbnails.forEach(card => card.classList.remove('selected'));
+      hero.classList.remove('transitioning');
+      title.classList.remove('transitioning');
+    }
+
+    async function navigate() {
+      const version = ++navigationVersion;
+      // Finish the previous DOM update and its cleanup before naming another pair.
+      if (activeTransition) {
+        activeTransition.skipTransition();
+        try { await activeTransition.finished; } catch { /* A skipped snapshot is harmless. */ }
+      }
+      if (version !== navigationVersion) return;
+      const nextFavorite = favoriteFromHash();
+      if (nextFavorite === activeFavorite) return;
+      if (!activeFavorite) listScroll = window.scrollY;
+      const card = thumbnails.find(card => card.dataset.favorite === (nextFavorite || activeFavorite));
+      const update = () => {
+        render(nextFavorite);
+        window.scrollTo(0, nextFavorite ? 0 : listScroll);
+      };
+      const focusHeading = () => {
+        document.getElementById(nextFavorite ? 'title' : 'list-heading').focus({ preventScroll: true });
+      };
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        clearTransitionState();
+        focusHeading();
+        return;
+      }
+      card.classList.add('selected');
+      hero.classList.add('transitioning');
+      title.classList.add('transitioning');
+      let transition;
+      try {
+        transition = document.startViewTransition(update);
+        activeTransition = transition;
+        // Snapshot failures must not prevent routing or leave rejected promises.
+        transition.ready.catch(() => {});
+        await transition.finished;
+      } catch {
+        if (activeFavorite !== nextFavorite) update();
+      } finally {
+        clearTransitionState();
+        if (activeTransition === transition) activeTransition = null;
+        if (version === navigationVersion) focusHeading();
+      }
+    }
+
+    window.addEventListener('hashchange', navigate);
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+    // Hash links retain native keyboard activation and browser Back/Forward behavior.
+    const initialFavorite = favoriteFromHash();
+    render(initialFavorite);
+    if (initialFavorite) title.focus({ preventScroll: true });
+  </script>
