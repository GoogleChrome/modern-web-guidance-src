+  <script>
+    const carousel = document.querySelector('#seasonal-drinks');
+    const cards = [...carousel.querySelectorAll('.card')];
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const position = document.querySelector('#carousel-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function cardLeft(card) {
+      return carousel.scrollLeft + card.getBoundingClientRect().left
+        - carousel.getBoundingClientRect().left - 8;
+    }
+
+    function updateCarousel() {
+      const maxScroll = Math.max(0, carousel.scrollWidth - carousel.clientWidth);
+      const index = cards.reduce((closest, card, i) =>
+        Math.abs(cardLeft(card) - carousel.scrollLeft) <
+        Math.abs(cardLeft(cards[closest]) - carousel.scrollLeft) ? i : closest, 0);
+      previous.setAttribute('aria-disabled', String(carousel.scrollLeft <= 2));
+      next.setAttribute('aria-disabled', String(carousel.scrollLeft >= maxScroll - 2));
+      // At the end, the final card may be fully visible without being left-aligned.
+      const visibleIndex = maxScroll > 0 && carousel.scrollLeft >= maxScroll - 2
+        ? cards.length - 1 : index;
+      position.textContent = `Drink ${visibleIndex + 1} of ${cards.length}`;
+    }
+
+    function moveCarousel(direction) {
+      const control = direction < 0 ? previous : next;
+      if (control.getAttribute('aria-disabled') === 'true') return;
+      const ordered = direction < 0 ? [...cards].reverse() : cards;
+      const target = ordered.find(card => direction * (cardLeft(card) - carousel.scrollLeft) > 2);
+      if (target) carousel.scrollTo({
+        left: Math.max(0, cardLeft(target)),
+        behavior: reducedMotion.matches ? 'instant' : 'smooth'
+      });
+    }
+
+    previous.addEventListener('click', () => moveCarousel(-1));
+    next.addEventListener('click', () => moveCarousel(1));
+    let scrollTimer;
+    carousel.addEventListener('scroll', () => {
+      clearTimeout(scrollTimer);
+      scrollTimer = setTimeout(updateCarousel, 120);
+    }, { passive: true });
+    window.addEventListener('resize', updateCarousel);
+    updateCarousel();
+
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Espresso meets creamy oat milk and a hint of Vermont maple syrup for a gently sweet, comforting cup.',
+        notes: 'Flavor notes: maple sweetness and a creamy oat finish.',
+        href: '/menu/seasonal'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'A concentrated dark roast with a bold, smoky character. A small cup with a full-bodied finish for your morning ritual.',
+        notes: 'Flavor notes: deep roast and a smoky finish.',
+        href: '/menu/espresso'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours to bring out a smooth, rounded flavor. Slow brewing makes every chilled sip easy to enjoy.',
+        notes: 'Brew method: an 18-hour cold steep for maximum smoothness.',
+        href: '/menu/cold-brew'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    let openingAnimation;
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#detail-title').textContent = drink.name;
+        document.querySelector('#detail-description').textContent = drink.description;
+        document.querySelector('#detail-notes').textContent = drink.notes;
+        document.querySelector('#detail-menu-link').href = drink.href;
+        const trigger = button.getBoundingClientRect();
+        openingAnimation?.cancel();
+        dialog.showModal();
+
+        // Measure after opening: animate from this button's exact viewport bounds.
+        // Closing stays native and immediate, including Escape and focus return.
+        if (!reducedMotion.matches && typeof dialog.animate === 'function') {
+          const panel = dialog.getBoundingClientRect();
+          openingAnimation = dialog.animate([
+            {
+              transform: `translate(${trigger.left - panel.left}px, ${trigger.top - panel.top}px) scale(${trigger.width / panel.width}, ${trigger.height / panel.height})`,
+              opacity: 0.35
+            },
+            { transform: 'translate(0, 0) scale(1, 1)', opacity: 1 }
+          ], { duration: 360, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
+        }
+      });
+    });
+    dialog.addEventListener('close', () => openingAnimation?.cancel());
+  </script>
+
