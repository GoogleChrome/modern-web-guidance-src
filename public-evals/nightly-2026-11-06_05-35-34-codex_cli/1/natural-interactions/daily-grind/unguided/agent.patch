+  <script>
+    const drinks = document.getElementById('seasonal-drinks');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function scrollDrinks(direction) {
+      const card = drinks.querySelector('.card');
+      const step = card.getBoundingClientRect().width + parseFloat(getComputedStyle(drinks).gap);
+      drinks.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    }
+
+    document.querySelectorAll('[data-direction]').forEach(button => {
+      button.addEventListener('click', () => scrollDrinks(Number(button.dataset.direction)));
+    });
+
+    drinks.addEventListener('keydown', event => {
+      // Keep native key behavior for buttons and links inside the cards.
+      if (event.target !== drinks || event.altKey || event.ctrlKey || event.metaKey) return;
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        scrollDrinks(event.key === 'ArrowRight' ? 1 : -1);
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault();
+        drinks.scrollTo({ left: event.key === 'Home' ? 0 : drinks.scrollWidth,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      }
+    });
+
+    function setDetails(button, expanded) {
+      const panel = document.getElementById(button.getAttribute('aria-controls'));
+      if (!expanded && panel.contains(document.activeElement)) button.focus({ preventScroll: true });
+      button.setAttribute('aria-expanded', String(expanded));
+      button.textContent = expanded ? 'Hide Details' : 'View Details';
+      const title = button.closest('.card').querySelector('h3').textContent;
+      button.setAttribute('aria-label', `${expanded ? 'Hide' : 'View'} details for ${title}`);
+      panel.inert = !expanded;
+      panel.classList.toggle('is-open', expanded);
+    }
+
+    document.querySelectorAll('.detail-toggle').forEach(button => {
+      button.addEventListener('click', () => {
+        setDetails(button, button.getAttribute('aria-expanded') !== 'true');
+      });
+    });
+
+    drinks.addEventListener('keydown', event => {
+      if (event.key !== 'Escape') return;
+      const card = event.target.closest('.card');
+      const button = card?.querySelector('.detail-toggle[aria-expanded="true"]');
+      if (button) {
+        event.preventDefault();
+        setDetails(button, false);
+        button.focus({ preventScroll: true });
+      }
+    });
+  </script>
