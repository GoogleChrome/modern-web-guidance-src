+  <button type="button" id="feedback-launcher" class="feedback-launcher" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-3 3V11.5A8.5 8.5 0 0 1 9.5 3h3a8.5 8.5 0 0 1 8.5 8.5Z"/><path d="M7 10h8M7 14h5"/></svg>
+    Feedback
+  </button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('feedback-launcher');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const feedbackContainers = [
+      document.getElementById('feedback-main-container'),
+      document.getElementById('feedback-footer-container')
+    ];
+    let usedMoveFallback = false;
+    let moveCount = 0;
+
+    feedbackLauncher.addEventListener('click', () => feedbackDialog.showModal());
+
+    document.getElementById('feedback-move').addEventListener('click', () => {
+      const destination = feedbackContainers.find(container => container !== feedbackDialog.parentElement);
+      const focusedElement = document.activeElement;
+      const selection = focusedElement === feedbackMessage
+        ? [feedbackMessage.selectionStart, feedbackMessage.selectionEnd, feedbackMessage.selectionDirection]
+        : null;
+      const scrollTop = feedbackDialog.scrollTop;
+
+      if (typeof destination.moveBefore === 'function') {
+        // An atomic move retains the top layer, modal state, and focused control.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        // Explicitly close first: some browsers retain `open` after detachment
+        // but lose top-layer membership. Reopen synchronously to restore modality.
+        const wasOpen = feedbackDialog.open;
+        if (wasOpen) feedbackDialog.close();
+        destination.appendChild(feedbackDialog);
+        if (wasOpen) feedbackDialog.showModal();
+        usedMoveFallback = true;
+      }
+
+      if (feedbackDialog.contains(focusedElement) && document.activeElement !== focusedElement) {
+        focusedElement.focus();
+      }
+      if (selection) feedbackMessage.setSelectionRange(...selection);
+      feedbackDialog.scrollTop = scrollTop;
+      moveCount += 1;
+      feedbackStatus.textContent = `Moved ${moveCount === 1 ? 'once' : `${moveCount} times`}. Your draft is still here.`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      // Ignore a queued close event from a fallback move that already reopened.
+      if (feedbackDialog.open) return;
+      feedbackDialog.returnValue = '';
+      // Reopening during a fallback changes the browser's remembered invoker.
+      if (usedMoveFallback) {
+        feedbackLauncher.focus();
+        usedMoveFallback = false;
+      }
+    });
+
+    try {
+      feedbackMessage.value = localStorage.getItem('daily-grind-feedback') || '';
+    } catch { /* The form remains usable if storage is unavailable. */ }
+
+    document.getElementById('feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+      if (!feedbackMessage.value.trim()) {
+        feedbackStatus.textContent = 'Please write a little feedback before saving.';
+        feedbackMessage.focus();
+        return;
+      }
+      try {
+        localStorage.setItem('daily-grind-feedback', feedbackMessage.value);
+        feedbackStatus.textContent = 'Thank you! Your feedback is saved on this device.';
+      } catch {
+        feedbackStatus.textContent = 'Your browser couldn’t save this feedback. Please copy it before closing.';
+      }
+    });
+  </script>
+
