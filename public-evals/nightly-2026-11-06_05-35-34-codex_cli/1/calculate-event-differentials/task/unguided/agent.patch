+  <script>
+    (() => {
+      const hour = 60 * 60 * 1000;
+      // Assumed promotion start; numeric date components use the visitor's local zone.
+      const promotionStart = new Date(2026, 0, 1, 0, 0, 0).getTime();
+      const promotionEnd = new Date(2026, 2, 1, 0, 0, 0).getTime();
+      const values = document.getElementById('maple-timer-values');
+      const status = document.getElementById('maple-offer-status');
+      const remaining = document.getElementById('maple-remaining');
+      const elapsed = document.getElementById('maple-elapsed');
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / hour);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotionTimer() {
+        const now = Date.now();
+        status.textContent = now >= promotionEnd
+          ? 'Offer ended'
+          : now < promotionStart ? 'Promotion has not started · Offer ends in' : 'Offer ends in';
+        remaining.textContent = formatDuration(promotionEnd - now) + ' left';
+        elapsed.textContent = formatDuration(now - promotionStart) + ' elapsed since promotion start';
+        values.hidden = false;
+      }
+
+      updatePromotionTimer();
+      setInterval(updatePromotionTimer, 60 * 1000);
+    })();
+  </script>
