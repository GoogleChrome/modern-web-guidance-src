diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..63181b5
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,91 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+{articles.length > 0 && (
+    <top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-label="Top stories" aria-roledescription="carousel">
+        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+            <div class="overflow-hidden" data-stories>
+                {articles.map((article, index) => (
+                    <div data-story hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </div>
+                ))}
+            </div>
+            <div data-controls hidden class="mt-3">
+                <div class="flex items-center gap-3">
+                    <button type="button" data-previous class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800">Previous</button>
+                    <span data-status role="status" aria-live="polite" aria-atomic="true" class="text-xs text-gray-500">Story 1 of {articles.length}</span>
+                    <button type="button" data-next class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800">Next</button>
+                </div>
+            </div>
+        </div>
+    </top-stories-slider>
+)}
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            const status = this.querySelector<HTMLElement>('[data-status]');
+            if (stories.length < 2 || !controls || !status) return;
+
+            let current = 0;
+            const showStory = (direction: 'next' | 'previous') => {
+                stories[current].hidden = true;
+                delete stories[current].dataset.direction;
+                current = (current + (direction === 'next' ? 1 : -1) + stories.length) % stories.length;
+                stories[current].dataset.direction = direction;
+                stories[current].hidden = false;
+                status.textContent = `Story ${current + 1} of ${stories.length}`;
+            };
+
+            this.querySelector('[data-previous]')?.addEventListener('click', () => showStory('previous'));
+            this.querySelector('[data-next]')?.addEventListener('click', () => showStory('next'));
+            controls.hidden = false;
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
+
+<style>
+    [data-direction='next'] {
+        animation: story-from-right 300ms ease-out;
+    }
+
+    [data-direction='previous'] {
+        animation: story-from-left 300ms ease-out;
+    }
+
+    @keyframes story-from-right {
+        from { transform: translateX(100%); }
+        to { transform: translateX(0); }
+    }
+
+    @keyframes story-from-left {
+        from { transform: translateX(-100%); }
+        to { transform: translateX(0); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        [data-direction] {
+            animation: none;
+        }
+    }
+</style>
