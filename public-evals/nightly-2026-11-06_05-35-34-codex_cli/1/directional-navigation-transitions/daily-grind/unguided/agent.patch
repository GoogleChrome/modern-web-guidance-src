+  <script>
+    const seasonalItems = Array.from(document.querySelectorAll('.seasonal-item'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    let seasonalIndex = 0;
+
+    function stepSeasonal(direction) {
+      const current = seasonalItems[seasonalIndex];
+      current.hidden = true;
+      current.classList.remove('from-right', 'from-left');
+
+      seasonalIndex = (seasonalIndex + direction + seasonalItems.length) % seasonalItems.length;
+      const incoming = seasonalItems[seasonalIndex];
+      incoming.hidden = false;
+      incoming.classList.add(direction > 0 ? 'from-right' : 'from-left');
+      seasonalStatus.textContent = `${seasonalIndex + 1} of ${seasonalItems.length}: ${incoming.querySelector('h3').textContent}`;
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => stepSeasonal(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => stepSeasonal(1));
+  </script>
