+  <script>
+    const slides = document.querySelector('#seasonal-slides');
+    const items = Array.from(slides.querySelectorAll('.card'));
+    const previous = document.querySelector('#seasonal-previous');
+    const next = document.querySelector('#seasonal-next');
+    const status = document.querySelector('#seasonal-status');
+    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
+    let current = 0;
+    let activeTransition;
+
+    document.querySelector('.seasonal-controls').hidden = false;
+
+    async function step(direction) {
+      if (activeTransition) return;
+
+      const update = () => {
+        items[current].hidden = true;
+        current = (current + direction + items.length) % items.length;
+        items[current].hidden = false;
+        status.textContent = `${current + 1} of ${items.length}: ${items[current].querySelector('h3').textContent}`;
+      };
+      const type = direction === 1 ? 'forward' : 'backward';
+      const supportsDirectionalTransitions = document.startViewTransition &&
+        CSS.supports('selector(:active-view-transition-type(forward))');
+
+      delete slides.dataset.direction;
+      if (!motion.matches || !supportsDirectionalTransitions) {
+        if (motion.matches) slides.dataset.direction = type;
+        update();
+        return;
+      }
+
+      previous.disabled = next.disabled = true;
+      activeTransition = document.startViewTransition({ update, types: [type] });
+      try {
+        await activeTransition.finished;
+      } finally {
+        activeTransition = undefined;
+        previous.disabled = next.disabled = false;
+      }
+    }
+
+    motion.addEventListener('change', () => {
+      if (!motion.matches) activeTransition?.skipTransition();
+    });
+    previous.addEventListener('click', () => step(-1));
+    next.addEventListener('click', () => step(1));
+  </script>
+
 </body>
 
