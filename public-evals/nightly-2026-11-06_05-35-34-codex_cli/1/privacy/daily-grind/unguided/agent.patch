@@ -0,0 +1,8 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+
+// Publish only reviewed site files, never tooling, audit notes, or repository metadata.
+await rm('dist', { recursive: true, force: true });
+await mkdir('dist', { recursive: true });
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(path, `dist/${path}`, { recursive: true });
+}
diff --git a/scripts/privacy.test.mjs b/scripts/privacy.test.mjs
new file mode 100644
index 0000000..39bfbc1
--- /dev/null
+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,81 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+
+const read = (path) => readFile(path, 'utf8');
+const pages = ['index.html', 'privacy-policy/index.html'];
+const forbidden = /<script\b|<iframe\b|<object\b|<embed\b|<form\b|<input\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:|document\.cookie|localStorage|sessionStorage|indexedDB|sendBeacon|serviceWorker/i;
+
+for (const page of pages) {
+  test(`${page}: no active code, data collection, or third-party resources`, async () => {
+    const html = await read(page);
+    assert.doesNotMatch(html, forbidden);
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    assert.doesNotMatch(html, /https?:\/\/|\/\/[^\s<>/]/);
+    assert.match(html, /<meta http-equiv="Content-Security-Policy"/);
+    for (const [, path] of html.matchAll(/(?:src|href)="([^"]+)"/g)) {
+      assert.ok(path.startsWith('/') && !path.startsWith('//'), `Nonlocal link: ${path}`);
+      if (path.startsWith('/assets/')) assert.ok((await stat(`.${path}`)).isFile());
+    }
+  });
+}
+
+test('styles use only local assets', async () => {
+  const css = await read('assets/site.css');
+  assert.doesNotMatch(css, /https?:|@import|data:/i);
+  for (const [, path] of css.matchAll(/url\(['"]?([^'"\)]+)['"]?\)/g)) {
+    assert.ok(path.startsWith('/assets/'));
+    assert.ok((await stat(`.${path}`)).isFile());
+  }
+  const photo = await readFile('assets/coffee.jpg');
+  assert.equal(photo.subarray(0, 3).toString('hex'), 'ffd8ff');
+});
+
+test('host configurations enforce identical security headers on every path', async () => {
+  const raw = await read('_headers');
+  assert.ok(raw.startsWith('/*\n'));
+  const headers = Object.fromEntries(raw.trim().split('\n').slice(1).map(line => {
+    const colon = line.indexOf(':');
+    return [line.slice(0, colon).trim(), line.slice(colon + 1).trim()];
+  }));
+  const vercel = JSON.parse(await read('vercel.json'));
+  assert.equal(vercel.headers[0].source, '/(.*)');
+  assert.deepEqual(Object.fromEntries(vercel.headers[0].headers.map(h => [h.key, h.value])), headers);
+  assert.equal(headers['Referrer-Policy'], 'no-referrer');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['Strict-Transport-Security'], 'max-age=31536000');
+  assert.equal(headers['Cross-Origin-Opener-Policy'], 'same-origin');
+  assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.equal(headers['X-DNS-Prefetch-Control'], 'off');
+  for (const feature of ['camera', 'geolocation', 'microphone', 'payment', 'browsing-topics']) {
+    assert.ok(headers['Permissions-Policy'].includes(`${feature}=()`));
+  }
+  const csp = headers['Content-Security-Policy'];
+  const directives = Object.fromEntries(csp.split(';').map(d => {
+    const [name, ...values] = d.trim().split(/\s+/);
+    return [name, values.join(' ')];
+  }));
+  for (const name of ['default-src', 'script-src', 'connect-src', 'frame-src', 'object-src', 'worker-src', 'font-src', 'base-uri', 'form-action', 'frame-ancestors']) {
+    assert.equal(directives[name], "'none'", name);
+  }
+  assert.equal(directives['style-src'], "'self'");
+  assert.equal(directives['img-src'], "'self'");
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|https?:|\*/);
+  for (const page of pages) {
+    const html = await read(page);
+    const meta = html.match(/http-equiv="Content-Security-Policy" content="([^"]+)"/)[1];
+    assert.equal(meta, csp.replace("; frame-ancestors 'none'; upgrade-insecure-requests", ''));
+  }
+});
+
+test('privacy notice resolves and no GET logout action is exposed', async () => {
+  const html = await read('index.html');
+  assert.match(html, /href="\/privacy-policy\/"/);
+  assert.doesNotMatch(html, /href="\/logout"/);
+  assert.ok((await stat('privacy-policy/index.html')).isFile());
+});
+
+test('no executable client assets have been added', async () => {
+  assert.deepEqual((await readdir('assets')).sort(), ['coffee.jpg', 'site.css']);
+});
