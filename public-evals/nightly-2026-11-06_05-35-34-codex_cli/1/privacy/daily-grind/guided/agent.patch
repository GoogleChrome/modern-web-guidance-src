+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { securityHeaders, publicFiles } from './security.mjs';
+
+// Deliberately no request logging, body collection, cookies, sessions, or analytics.
+const server = createServer(async (req, res) => {
+  for (const [name, value] of Object.entries(securityHeaders)) res.setHeader(name, value);
+  res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+  const finish = (status, message) => {
+    res.writeHead(status);
+    res.end(req.method === 'HEAD' ? undefined : message);
+  };
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return finish(400, 'Invalid request.');
+  }
+
+  if (pathname === '/logout' && req.method === 'POST') {
+    // Mutations require a same-origin browser request; never use GET for clearing.
+    const origin = req.headers.origin;
+    const site = req.headers['sec-fetch-site'];
+    let sameOrigin = false;
+    try {
+      const source = new URL(origin);
