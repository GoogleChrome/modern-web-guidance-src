@@ -0,0 +1,29 @@
+// Shared by the HTTP server and the static-host build. No telemetry/report endpoint.
+export const securityHeaders = Object.freeze({
+  'Content-Security-Policy': [
+    "default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "img-src 'self'", "connect-src 'none'", "font-src 'none'",
+    "object-src 'none'", "base-uri 'none'", "frame-src 'none'",
+    "frame-ancestors 'none'", "form-action 'self'",
+    "require-trusted-types-for 'script'", "trusted-types 'none'",
+  ].join('; '),
+  'Referrer-Policy': 'no-referrer',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), browsing-topics=()',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  // Initial rollout only; increase after verifying production HTTPS coverage.
+  'Strict-Transport-Security': 'max-age=300',
+  'Cache-Control': 'no-store',
+});
+
+// Explicit publication list prevents serving source, configuration, or dotfiles.
+export const publicFiles = Object.freeze({
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/index.html': ['index.html', 'text/html; charset=utf-8'],
+  '/privacy-policy': ['privacy-policy.html', 'text/html; charset=utf-8'],
+  '/privacy-policy.html': ['privacy-policy.html', 'text/html; charset=utf-8'],
+  '/assets/styles.css': ['assets/styles.css', 'text/css; charset=utf-8'],
+  '/assets/coffee-hero.jpg': ['assets/coffee-hero.jpg', 'image/jpeg'],
+});
