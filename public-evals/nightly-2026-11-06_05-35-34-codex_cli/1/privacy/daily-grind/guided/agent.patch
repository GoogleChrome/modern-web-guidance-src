@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { copyFile, mkdir, readFile } from 'node:fs/promises';
+import { securityHeaders, publicFiles } from '../security.mjs';
+
+// Deliberately conservative: any new active content or collection requires review.
+function auditText(content, file) {
+  assert(!/<(?:script|iframe|object|embed|input|textarea|select|base)\b/i.test(content), `${file}: active content or data collection needs privacy review`);
+  assert(!/\s(?:on[\w]+|style|ping)\s*=/i.test(content), `${file}: inline code, styles, or link tracking needs review`);
+  assert(!/(?:https?:)?\/\//i.test(content), `${file}: external URL needs third-party review`);
+  assert(!/\b(?:data|javascript|blob):/i.test(content), `${file}: unsupported resource scheme`);
+  assert(!/@import\b/i.test(content), `${file}: stylesheet imports need review`);
+  for (const form of content.matchAll(/<form\b([^>]*)>/gi)) {
+    assert(/action="\/logout"/.test(form[1]) && /method="post"/.test(form[1]), `${file}: unexpected collection endpoint`);
+  }
+}
+
+// Confirm the audit catches representative regressions, without a browser/server.
+for (const sample of [
+  '<script src="/tracker.js"></script>',
+  '<img src="https://example.com/pixel">',
+  'body { background: url(//example.com/pixel) }',
+  '<input name="email">', '<a ping="/track">Link</a>',
+  '<form action="/collect" method="post">',
+]) assert.throws(() => auditText(sample, 'regression probe'));
+
+const pkg = JSON.parse(await readFile(new URL('../package.json', import.meta.url)));
+assert.equal(Object.keys(pkg.dependencies || {}).length, 0, 'New runtime dependencies require a third-party audit');
+assert.equal(Object.keys(pkg.devDependencies || {}).length, 0, 'New build dependencies require a third-party audit');
+assert.equal(pkg.scripts.start, 'node server.mjs');
+const csp = securityHeaders['Content-Security-Policy'];
+for (const rule of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "frame-ancestors 'none'", "form-action 'self'"]) assert(csp.includes(rule));
+assert.equal(securityHeaders['Referrer-Policy'], 'no-referrer');
+assert.equal(securityHeaders['Cache-Control'], 'no-store');
+assert.equal(securityHeaders['X-Content-Type-Options'], 'nosniff');
+assert.equal(securityHeaders['X-Frame-Options'], 'DENY');
+for (const feature of ['camera', 'microphone', 'geolocation']) assert(securityHeaders['Permissions-Policy'].includes(`${feature}=()`));
+
+const published = new Set(Object.values(publicFiles).map(([file]) => file));
+for (const file of published) {
+  const bytes = await readFile(new URL(`../${file}`, import.meta.url));
+  if (/\.(html|css)$/.test(file)) {
+    const content = bytes.toString();
+    auditText(content, file);
+    if (file.endsWith('.html')) assert(content.includes('<meta name="referrer" content="no-referrer">'));
+    const paths = [...content.matchAll(/(?:src|href)="(\/assets\/[^"?#]+)"|url\(['"]?(\/assets\/[^)'"?#]+)['"]?\)/g)];
+    for (const match of paths) assert(Object.hasOwn(publicFiles, match[1] || match[2]), `${file}: unpublished resource`);
+  }
+  if (file.endsWith('.jpg')) assert(bytes[0] === 0xff && bytes[1] === 0xd8, 'Invalid hero JPEG');
+}
+// Copy only audited files and the server. Never execute/import the server entrypoint.
+for (const file of [...published, 'server.mjs', 'security.mjs', 'package.json']) {
+  const target = new URL(`../dist/${file}`, import.meta.url);
+  await mkdir(new URL('.', target), { recursive: true });
+  await copyFile(new URL(`../${file}`, import.meta.url), target);
+}
+console.log(`Privacy audit passed: ${published.size} public files; no client scripts, external resources, or collection fields. Build written to dist/.`);
