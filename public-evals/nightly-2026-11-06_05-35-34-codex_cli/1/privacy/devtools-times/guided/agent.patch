diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..e3d27e4 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -9,5 +9,19 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+  const response = await next();
+  if (response.headers.get('Content-Type')?.includes('text/html')) {
+    // Use response headers: Permissions-Policy cannot be enforced with a meta tag.
+    response.headers.set('Referrer-Policy', 'no-referrer');
+    response.headers.set(
+      'Permissions-Policy',
+      'camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=()',
+    );
+    response.headers.set('X-Content-Type-Options', 'nosniff');
+    const path = context.url.pathname.replace(/\/+$/, '');
+    if (path.endsWith('/signin') || path.endsWith('/signup')) {
+      response.headers.set('Cache-Control', 'no-store');
+    }
+  }
+  return response;
 });
