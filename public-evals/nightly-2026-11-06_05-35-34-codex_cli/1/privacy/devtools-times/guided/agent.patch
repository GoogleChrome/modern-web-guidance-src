@@ -0,0 +1,14 @@
+export default function AccountPrivacyNotice({ purpose }: { purpose: string }) {
+  return (
+    <p id="account-privacy" className="mb-6 text-sm text-gray-700" data-skip-tracking="true">
+      This is a demo. When you submit, your username and password are sent to the
+      external authentication service at{' '}
+      <code className="break-all">us-central1-web-devrel-apps.cloudfunctions.net</code>{' '}
+      to {purpose}. Use made-up credentials, never personal information or a reused
+      password. Reading the site does not require an account.{' '}
+      <a href={`${import.meta.env.BASE_URL}legal/privacy`} className="underline">
+        Read about data handling and retention limits
+      </a>.
+    </p>
+  );
+}
