+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const home = document.getElementById('main-video-slot');
+      const theater = document.getElementById('hero-video-slot');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.getElementById('theater-toggle');
+      let active = false;
+      const useAtomicMove = typeof theater.moveBefore === 'function';
+
+      function positionLegacyPlayer() {
+        if (!active || useAtomicMove) return;
+        const bounds = theater.getBoundingClientRect();
+        player.style.left = `${bounds.left + window.scrollX}px`;
+        player.style.top = `${bounds.top + window.scrollY}px`;
+        player.style.width = `${bounds.width}px`;
+        player.style.height = `${bounds.height}px`;
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        const nextActive = !active;
+        const destination = nextActive ? theater : home;
+        if (useAtomicMove) {
+          // Both parents stay connected. Never detach or rewrite the iframe/src:
+          // traditional appendChild/insertBefore moves reload embedded players.
+          destination.moveBefore(player, null);
+        }
+        active = nextActive;
+        hero.classList.toggle('theater-active', active);
+        document.body.classList.toggle('legacy-theater', active && !useAtomicMove);
+        toggle.setAttribute('aria-pressed', String(active));
+        toggle.textContent = active ? 'Exit theater mode' : 'Theater mode';
+        if (active) {
+          positionLegacyPlayer();
+        } else {
+          player.style.removeProperty('left');
+          player.style.removeProperty('top');
+          player.style.removeProperty('width');
+          player.style.removeProperty('height');
+        }
+      });
+
+      window.addEventListener('resize', positionLegacyPlayer);
+      window.addEventListener('load', positionLegacyPlayer);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionLegacyPlayer);
+        observer.observe(document.body);
+        observer.observe(hero);
+      }
+    })();
+  </script>
+
