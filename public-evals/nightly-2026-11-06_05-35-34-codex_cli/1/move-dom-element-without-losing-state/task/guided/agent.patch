+  <script>
+    const player = document.getElementById('roasting-player');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const toggle = document.getElementById('theater-toggle');
+    const status = document.getElementById('video-status');
+    const canMove = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function alignFallbackPlayer() {
+      if (canMove || !theaterMode) return;
+      const target = heroSlot.getBoundingClientRect();
+      const origin = document.body.getBoundingClientRect();
+      player.style.setProperty('--player-top', `${target.top - origin.top}px`);
+      player.style.setProperty('--player-left', `${target.left - origin.left}px`);
+      player.style.setProperty('--player-width', `${target.width}px`);
+      player.style.setProperty('--player-height', `${target.height}px`);
+    }
+
+    toggle.addEventListener('click', () => {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+
+      // Reveal the destination before moving; hide it only after moving back.
+      if (theaterMode) heroSlot.hidden = false;
+      if (canMove) {
+        const destination = theaterMode ? heroSlot : mainSlot;
+        destination.moveBefore(player, null);
+      } else {
+        // appendChild/insertBefore would reload a YouTube iframe. Instead,
+        // leave it connected to its original parent and move it visually.
+        player.classList.toggle('theater-fallback', theaterMode);
+      }
+      mainSlot.classList.toggle('is-empty', theaterMode);
+      alignFallbackPlayer();
+      if (!theaterMode) heroSlot.hidden = true;
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      status.textContent = theaterMode
+        ? 'Video is now in the hero section.'
+        : 'Video is back in the main container.';
+    });
+
+    if (!canMove) {
+      window.addEventListener('resize', alignFallbackPlayer);
+      window.addEventListener('load', alignFallbackPlayer);
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(alignFallbackPlayer);
+        observer.observe(heroSlot);
+        observer.observe(document.body);
+      }
+    }
+    toggle.hidden = false;
+  </script>
 </body>
 
