+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'View coupon';
+    }
+
+    couponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.focus();
+    });
+
+    // Native search and fragment navigation reveal the same permanent panel.
+    couponPanel.addEventListener('beforematch', revealCoupon);
+
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      revealCoupon();
+    }
+
+    // Older browsers without named details groups still keep these exclusive.
+    if (!('name' in HTMLDetailsElement.prototype)) {
+      const businessTabs = document.querySelectorAll('.wholesale-tab');
+      businessTabs.forEach((tab) => {
+        tab.addEventListener('toggle', () => {
+          if (tab.open) {
+            businessTabs.forEach((other) => {
+              if (other !== tab) other.open = false;
+            });
+          }
+        });
+      });
+    }
+  </script>
