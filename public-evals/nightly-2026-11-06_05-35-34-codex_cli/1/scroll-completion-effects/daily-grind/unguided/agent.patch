+  <script>
+    (() => {
+      let cancelNavigation = () => {};
+      const scrollingKeys = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ']);
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"]');
+        if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') ||
+            (link.target && link.target !== '_self')) return;
+
+        const target = document.getElementById(link.hash.slice(1));
+        if (!target) return;
+
+        event.preventDefault();
+        cancelNavigation();
+        document.querySelectorAll('.navigation-target-arrived').forEach((element) => {
+          element.classList.remove('navigation-target-arrived');
+        });
+
+        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        const navHeight = document.querySelector('nav').getBoundingClientRect().height;
+        const destination = Math.max(0, Math.min(
+          target.getBoundingClientRect().top + window.scrollY - navHeight - 16,
+          document.documentElement.scrollHeight - window.innerHeight
+        ));
+        let frame;
+        let settledFrames = 0;
+        let previousPosition = window.scrollY;
+        const startedAt = performance.now();
+
+        const cleanup = () => {
+          cancelAnimationFrame(frame);
+          document.removeEventListener('scrollend', onScrollEnd);
+          window.removeEventListener('wheel', interrupt);
+          window.removeEventListener('touchstart', interrupt);
+          window.removeEventListener('pointerdown', interrupt);
+          window.removeEventListener('keydown', interrupt);
+          cancelNavigation = () => {};
+        };
+        const arrive = () => {
+          cleanup();
+          if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+          target.focus({ preventScroll: true });
+          if (!reducedMotion) target.classList.add('navigation-target-arrived');
+        };
+        const atDestination = () => Math.abs(window.scrollY - destination) < 1;
+        const onScrollEnd = () => {
+          if (atDestination()) arrive();
+        };
+        function interrupt(event) {
+          if (event.type !== 'keydown' || scrollingKeys.has(event.key)) cleanup();
+        }
+        const checkPosition = (now) => {
+          const position = window.scrollY;
+          settledFrames = atDestination() && Math.abs(position - previousPosition) < 0.5
+            ? settledFrames + 1 : 0;
+          previousPosition = position;
+          // Also covers browsers without scrollend and destinations already in view.
+          if (settledFrames >= 3) {
+            arrive();
+          } else if (now - startedAt > 8000) {
+            cleanup();
+          } else {
+            frame = requestAnimationFrame(checkPosition);
+          }
+        };
+
+        cancelNavigation = cleanup;
+        document.addEventListener('scrollend', onScrollEnd);
+        window.addEventListener('wheel', interrupt, { passive: true });
+        window.addEventListener('touchstart', interrupt, { passive: true });
+        window.addEventListener('pointerdown', interrupt, { passive: true });
+        window.addEventListener('keydown', interrupt);
+        window.scrollTo({ top: destination, behavior: reducedMotion ? 'instant' : 'smooth' });
+        frame = requestAnimationFrame(checkPosition);
+      });
+
+      document.addEventListener('animationend', (event) => {
+        if (event.animationName === 'destination-highlight') {
+          event.target.classList.remove('navigation-target-arrived');
+        }
+      });
+    })();
+  </script>
