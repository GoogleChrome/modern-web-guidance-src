+  <script>
+    let navigationId = 0;
+    let activeNavigation;
+
+    async function scrollToTarget(target, signal) {
+      // Install the fallback before scrolling so instant scrolls are observed too.
+      let idleTimer;
+      let finish;
+      const settled = new Promise((resolve) => { finish = resolve; });
+      const onScroll = () => {
+        clearTimeout(idleTimer);
+        idleTimer = setTimeout(finish, 120);
+      };
+      const cleanup = () => {
+        clearTimeout(idleTimer);
+        window.removeEventListener('scroll', onScroll);
+        window.removeEventListener('scrollend', finish);
+        signal.removeEventListener('abort', finish);
+      };
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('scrollend', finish);
+      signal.addEventListener('abort', finish, { once: true });
+      onScroll(); // Also settles when the target is already at the requested position.
+
+      try {
+        const navHeight = document.querySelector('nav').getBoundingClientRect().height;
+        // Use the root scroll method to avoid early scrollIntoView promise resolution.
+        const result = window.scrollTo({
+          top: Math.max(0, window.scrollY + target.getBoundingClientRect().top - navHeight - 16),
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
+            ? 'instant' : 'smooth'
+        });
+        if (result && typeof result.then === 'function') {
+          await result;
+        } else {
+          // Older browsers return undefined: use scrollend or scroll inactivity.
+          await settled;
+        }
+      } finally {
+        cleanup();
+      }
+    }
+
+    document.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+          link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+
+      const id = ++navigationId;
+      activeNavigation?.abort();
+      const controller = new AbortController();
+      activeNavigation = controller;
+      document.querySelectorAll('.navigation-target').forEach((element) => {
+        element.classList.remove('navigation-target');
+      });
+
+      const cancel = () => controller.abort();
+      const cancelOnKey = (keyEvent) => {
+        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(keyEvent.key)) {
+          cancel();
+        }
+      };
+      const options = { passive: true, signal: controller.signal };
+      window.addEventListener('wheel', cancel, options);
+      window.addEventListener('touchstart', cancel, options);
+      window.addEventListener('keydown', cancelOnKey, { signal: controller.signal });
+
+      try {
+        await scrollToTarget(target, controller.signal);
+        if (id !== navigationId || controller.signal.aborted) return;
+        if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+        target.focus({ preventScroll: true });
+        target.classList.add('navigation-target');
+      } finally {
+        controller.abort();
+        if (activeNavigation === controller) activeNavigation = undefined;
+      }
+    });
+  </script>
