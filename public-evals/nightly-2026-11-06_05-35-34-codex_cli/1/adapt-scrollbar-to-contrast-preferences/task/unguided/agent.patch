diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,16 +11,66 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-thumb: #4e342e;
+      --scrollbar-thumb-hover: #3e2723;
+      --scrollbar-track: #f1ece9;
     }
 
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
     }
 
+    /* Keep scrollbars distinct, including in nested scrollable areas. */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #000;
+        --scrollbar-thumb-hover: #000;
+        --scrollbar-track: #fff;
+      }
+    }
+
+    /* Older WebKit browsers use these in place of the standard properties. */
+    @supports not (scrollbar-color: auto) {
+      @media (forced-colors: none) {
+        ::-webkit-scrollbar {
+          width: 16px;
+          height: 16px;
+        }
+
+        ::-webkit-scrollbar-track {
+          background: var(--scrollbar-track);
+        }
+
+        ::-webkit-scrollbar-thumb {
+          background: var(--scrollbar-thumb);
+          border: 2px solid var(--scrollbar-track);
+          border-radius: 8px;
+        }
+
+        ::-webkit-scrollbar-thumb:hover,
+        ::-webkit-scrollbar-thumb:active {
+          background: var(--scrollbar-thumb-hover);
+        }
+
+        ::-webkit-scrollbar-corner {
+          background: var(--scrollbar-track);
+        }
+      }
+    }
+
+    /* Let the operating system supply the user's forced-color palette. */
+    @media (forced-colors: active) {
+      * {
+        scrollbar-color: auto;
+      }
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
