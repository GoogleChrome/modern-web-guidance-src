diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..6bfbde4
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,96 @@
+export interface ReaderAccount {
+  id: string;
+  username: string;
+  displayName: string;
+}
+export interface Passkey {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+export interface PasskeyState {
+  account: ReaderAccount;
+  rpId: string;
+  passkeys: Passkey[];
+}
+
+export async function accountRequest(
+  path: string,
+  method = 'GET',
+  body?: unknown,
+) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, {
+    method,
+    credentials: 'same-origin',
+    cache: 'no-store',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new Error(
+      data.error || 'Could not save your changes. Please try again.',
+    );
+  return data;
+}
+
+type SignalCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+};
+
+// IDs are already base64url encoded by the server; never encode them twice.
+export async function syncPasskeys(
+  state: PasskeyState,
+): Promise<string | null> {
+  const credential =
+    typeof PublicKeyCredential !== 'undefined'
+      ? (PublicKeyCredential as SignalCredential)
+      : undefined;
+  if (!credential?.signalAllAcceptedCredentials)
+    return 'Your browser cannot sync passkey changes automatically. You can manage saved copies in your password manager.';
+  try {
+    await credential.signalAllAcceptedCredentials({
+      rpId: state.rpId,
+      userId: state.account.id,
+      allAcceptedCredentialIds: state.passkeys.map((key) => key.id),
+    });
+    return null;
+  } catch {
+    return 'Your account is up to date, but browser sync failed. Retry sync or manage saved copies in your password manager.';
+  }
+}
+
+export async function syncReaderDetails(
+  rpId: string,
+  account: ReaderAccount,
+): Promise<string | null> {
+  const credential =
+    typeof PublicKeyCredential !== 'undefined'
+      ? (PublicKeyCredential as SignalCredential)
+      : undefined;
+  if (!credential?.signalCurrentUserDetails)
+    return 'Your display name was saved. Update your saved account details in your password manager if needed.';
+  try {
+    await credential.signalCurrentUserDetails({
+      rpId,
+      userId: account.id,
+      name: account.username,
+      displayName: account.displayName,
+    });
+    return null;
+  } catch {
+    return 'Your display name was saved, but browser sync failed. Retry sync to update your password manager.';
+  }
+}
