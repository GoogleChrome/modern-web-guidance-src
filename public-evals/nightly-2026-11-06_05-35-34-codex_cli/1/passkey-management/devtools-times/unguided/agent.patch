@@ -0,0 +1,73 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-accounts-'));
+process.env.ACCOUNT_DB_PATH = join(directory, 'accounts.sqlite');
+const store = await import('../src/lib/server/accounts.ts');
+after(() => rmSync(directory, { recursive: true, force: true }));
+
+const alice = store.accountForUsername('alice');
+const bob = store.accountForUsername('bob');
+const rpId = 'example.test';
+const keyId = Buffer.from('credential-id').toString('base64url');
+const key = {
+  id: keyId,
+  userId: alice.id,
+  rpId,
+  name: 'Laptop',
+  aaguid: '00000000-0000-0000-0000-000000000000',
+  registeredAt: Date.now(),
+  lastUsedAt: null,
+  credential: {
+    id: keyId,
+    publicKey: new Uint8Array([1, 2, 3]),
+    counter: 0,
+    transports: ['internal'],
+  },
+};
+
+test('accounts have stable base64url handles and persistent display names', () => {
+  assert.match(alice.id, /^[A-Za-z0-9_-]+$/);
+  assert.equal(store.accountForUsername('alice').id, alice.id);
+  assert.notEqual(alice.id, bob.id);
+  store.renameAccount(alice.id, 'Alice Reader');
+  assert.equal(store.findAccount(alice.id).displayName, 'Alice Reader');
+  assert.equal(store.accountForUsername('alice').displayName, 'Alice Reader');
+});
+
+test('credential management is scoped to its owner and relying party', () => {
+  store.savePasskey(key);
+  assert.equal(store.publicPasskeys(alice.id, rpId).length, 1);
+  assert.deepEqual(store.publicPasskeys(bob.id, rpId), []);
+  assert.deepEqual(store.publicPasskeys(alice.id, 'other.test'), []);
+  assert.equal(store.renamePasskey(bob.id, rpId, keyId, 'Stolen'), false);
+  assert.equal(store.removePasskey(bob.id, rpId, keyId), false);
+  assert.equal(store.removePasskey(alice.id, 'other.test', keyId), false);
+  assert.equal(store.renamePasskey(alice.id, rpId, keyId, 'Work laptop'), true);
+  const publicKey = store.publicPasskeys(alice.id, rpId)[0];
+  assert.equal(publicKey.name, 'Work laptop');
+  assert.equal(publicKey.registeredAt, key.registeredAt);
+  assert.equal(publicKey.lastUsedAt, null);
+  assert.equal('credential' in publicKey, false);
+  assert.equal('userId' in publicKey, false);
+});
+
+test('stored public keys round-trip and authentication updates usage atomically', () => {
+  const stored = store.findPasskey(keyId, rpId);
+  assert.deepEqual([...stored.credential.publicKey], [1, 2, 3]);
+  assert.equal(store.markPasskeyUsed(stored, 1), true);
+  assert.equal(store.markPasskeyUsed(stored, 2), false);
+  const updated = store.findPasskey(keyId, rpId);
+  assert.equal(updated.credential.counter, 1);
+  assert.ok(updated.lastUsedAt >= key.registeredAt);
+});
+
+test('deleting the last credential returns an authoritative empty list', () => {
+  assert.equal(store.removePasskey(alice.id, rpId, keyId), true);
+  assert.deepEqual(store.publicPasskeys(alice.id, rpId), []);
+  assert.equal(store.findPasskey(keyId, rpId), undefined);
+  assert.equal(store.removePasskey(alice.id, rpId, keyId), false);
+});
diff --git a/tests/passkey-sync.test.mjs b/tests/passkey-sync.test.mjs
