diff --git a/src/pages/api/account/index.ts b/src/pages/api/account/index.ts
new file mode 100644
index 0000000..b1af5e8
--- /dev/null
+++ b/src/pages/api/account/index.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { renameAccount } from '../../../lib/server/accounts';
+import {
+  json,
+  sameOrigin,
+  signedInAccount,
+  validName,
+} from '../../../lib/server/account-api';
+
+export const PUT: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  const account = await signedInAccount(context);
+  if (!account) return json({ error: 'Please sign in again.' }, 401);
+  let body;
+  try {
+    body = await context.request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!validName(body?.displayName))
+    return json(
+      { error: 'Use a display name between 1 and 80 characters.' },
+      400,
+    );
+  return json({ account: renameAccount(account.id, body.displayName.trim()) });
+};
diff --git a/src/pages/api/account/login.ts b/src/pages/api/account/login.ts
new file mode 100644
index 0000000..d282de6
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { accountForUsername } from '../../../lib/server/accounts';
+import { json, sameOrigin } from '../../../lib/server/account-api';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!session) return json({ error: 'Sessions are unavailable.' }, 503);
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (
+    typeof body?.username !== 'string' ||
+    !body.username.trim() ||
+    typeof body.password !== 'string' ||
+    !body.password
+  ) {
+    return json({ error: 'Enter your username and password.' }, 400);
+  }
+  try {
+    const response = await fetch(
+      'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login',
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          username: body.username.trim(),
+          password: body.password,
+        }),
+        signal: AbortSignal.timeout(15000),
+      },
+    );
+    if (!response.ok)
+      return json(
+        { error: 'Sign-in failed. Check your username and password.' },
+        response.status === 429 ? 429 : 401,
+      );
+    const account = accountForUsername(body.username.trim());
+    await session.regenerate();
+    session.delete('registrationChallenge');
+    session.delete('authenticationChallenge');
+    session.set('accountId', account.id);
+    return json({ success: true });
+  } catch {
+    return json(
+      { error: 'Sign-in is temporarily unavailable. Please try again.' },
+      503,
+    );
+  }
+};
