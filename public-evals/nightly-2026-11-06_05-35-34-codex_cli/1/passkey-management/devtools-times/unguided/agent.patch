+import type { APIRoute } from 'astro';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import {
+  listPasskeys,
+  publicPasskeys,
+  savePasskey,
+} from '../../../lib/server/accounts';
+import {
+  json,
+  relyingParty,
+  sameOrigin,
+  signedInAccount,
+} from '../../../lib/server/account-api';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  const account = await signedInAccount(context);
+  if (!account || !context.session)
+    return json({ error: 'Please sign in again.' }, 401);
+  const rpId = relyingParty(context.url);
+  const options = await generateRegistrationOptions({
+    rpName: 'The DevTools Times',
+    rpID: rpId,
+    userID: Buffer.from(account.id, 'base64url'),
+    userName: account.username,
+    userDisplayName: account.displayName,
+    attestationType: 'none',
+    excludeCredentials: listPasskeys(account.id, rpId).map((key) => ({
+      id: key.id,
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'required',
+    },
+  });
+  context.session.set('registrationChallenge', {
+    challenge: options.challenge,
+    expires: Date.now() + 300000,
+  });
+  return json(options);
+};
+
+export const PUT: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  const account = await signedInAccount(context);
+  if (!account || !context.session)
+    return json({ error: 'Please sign in again.' }, 401);
+  const pending = await context.session.get('registrationChallenge');
+  context.session.delete('registrationChallenge');
+  if (!pending || pending.expires < Date.now())
+    return json({ error: 'Registration expired. Please try again.' }, 400);
+  const rpId = relyingParty(context.url);
+  try {
+    const result = await verifyRegistrationResponse({
+      response: await context.request.json(),
+      expectedChallenge: pending.challenge,
+      expectedOrigin: process.env.WEBAUTHN_ORIGIN || context.url.origin,
+      expectedRPID: rpId,
+      requireUserVerification: true,
+    });
+    if (!result.verified)
+      return json({ error: 'Could not verify this passkey.' }, 400);
+    const { credential, aaguid } = result.registrationInfo;
+    savePasskey({
+      id: credential.id,
+      userId: account.id,
+      rpId,
+      name: '',
+      aaguid,
+      registeredAt: Date.now(),
+      lastUsedAt: null,
+      credential,
+    });
+    return json({ account, rpId, passkeys: publicPasskeys(account.id, rpId) });
+  } catch {
+    return json(
+      {
+        error:
+          'Could not register this passkey. It may already be registered. Please try again.',
+      },
+      400,
+    );
+  }
+};
