+import { json, sameOrigin } from '../../../lib/server/account-api';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  session?.destroy();
+  return json({ success: true });
+};
