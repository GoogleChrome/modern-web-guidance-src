--- /dev/null
+++ b/src/lib/server/account-api.ts
@@ -0,0 +1,33 @@
+import type { APIContext } from 'astro';
+import { findAccount } from './accounts';
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      'Content-Type': 'application/json',
+      'Cache-Control': 'no-store',
+    },
+  });
+}
+
+export async function signedInAccount(context: Pick<APIContext, 'session'>) {
+  const id = await context.session?.get('accountId');
+  return typeof id === 'string' ? findAccount(id) : undefined;
+}
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
+
+export function relyingParty(url: URL) {
+  return process.env.WEBAUTHN_RP_ID || url.hostname;
+}
+
+export function validName(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.trim().length > 0 &&
+    value.trim().length <= 80
+  );
+}
diff --git a/src/lib/server/accounts.ts b/src/lib/server/accounts.ts
new file mode 100644
index 0000000..261ed81
--- /dev/null
+++ b/src/lib/server/accounts.ts
@@ -0,0 +1,166 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { WebAuthnCredential } from '@simplewebauthn/server';
+
+export interface Account {
+  id: string;
+  username: string;
+  displayName: string;
+}
+export interface StoredPasskey {
+  id: string;
+  userId: string;
+  rpId: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+  credential: WebAuthnCredential;
+}
+
+// Keep this database on a persistent volume when deploying the standalone app.
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = process.env.ACCOUNT_DB_PATH || '.data/accounts.sqlite';
+    mkdirSync(dirname(path), { recursive: true });
+    database = new DatabaseSync(path);
+    database.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA foreign_keys = ON;
+      PRAGMA busy_timeout = 5000;
+      CREATE TABLE IF NOT EXISTS accounts (
+        id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES accounts(id),
+        rpId TEXT NOT NULL, name TEXT NOT NULL, aaguid TEXT NOT NULL,
+        registeredAt INTEGER NOT NULL, lastUsedAt INTEGER, credential TEXT NOT NULL
+      );
+    `);
+  }
+  return database;
+}
+
+export function findAccount(id: string): Account | undefined {
+  return db().prepare('SELECT * FROM accounts WHERE id = ?').get(id) as
+    Account | undefined;
+}
+
+// Called only after the existing identity service has verified the password.
+export function accountForUsername(username: string): Account {
+  db()
+    .prepare('INSERT OR IGNORE INTO accounts VALUES (?, ?, ?)')
+    .run(randomBytes(32).toString('base64url'), username, username);
+  return db()
+    .prepare('SELECT * FROM accounts WHERE username = ?')
+    .get(username) as unknown as Account;
+}
+
+export function renameAccount(id: string, displayName: string): Account {
+  db()
+    .prepare('UPDATE accounts SET displayName = ? WHERE id = ?')
+    .run(displayName, id);
+  return findAccount(id)!;
+}
+
+export function listPasskeys(userId: string, rpId: string): StoredPasskey[] {
+  const rows = db()
+    .prepare(
+      'SELECT * FROM passkeys WHERE userId = ? AND rpId = ? ORDER BY registeredAt DESC',
+    )
+    .all(userId, rpId);
+  return rows.map((row) => {
+    const credential = JSON.parse(row.credential as string);
+    credential.publicKey = Buffer.from(credential.publicKey, 'base64url');
+    return { ...row, credential };
+  }) as unknown as StoredPasskey[];
+}
+
+export function savePasskey(passkey: StoredPasskey) {
+  db()
+    .prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?)')
+    .run(
+      passkey.id,
+      passkey.userId,
+      passkey.rpId,
+      passkey.name,
+      passkey.aaguid,
+      passkey.registeredAt,
+      passkey.lastUsedAt,
+      JSON.stringify({
+        ...passkey.credential,
+        publicKey: Buffer.from(passkey.credential.publicKey).toString(
+          'base64url',
+        ),
+      }),
+    );
+}
+
+export function renamePasskey(
+  userId: string,
+  rpId: string,
+  id: string,
+  name: string,
+) {
+  return (
+    db()
+      .prepare(
+        'UPDATE passkeys SET name = ? WHERE id = ? AND userId = ? AND rpId = ?',
+      )
+      .run(name, id, userId, rpId).changes > 0
+  );
+}
+
+export function removePasskey(userId: string, rpId: string, id: string) {
+  return (
+    db()
+      .prepare('DELETE FROM passkeys WHERE id = ? AND userId = ? AND rpId = ?')
+      .run(id, userId, rpId).changes > 0
+  );
+}
+
+export function publicPasskeys(userId: string, rpId: string) {
+  return listPasskeys(userId, rpId).map(
+    ({ credential, userId: _userId, rpId: _rpId, ...passkey }) => passkey,
+  );
+}
+
+export function findPasskey(
+  id: string,
+  rpId: string,
+): StoredPasskey | undefined {
+  const row = db()
+    .prepare('SELECT userId FROM passkeys WHERE id = ? AND rpId = ?')
+    .get(id, rpId);
+  return row
+    ? listPasskeys(row.userId as string, rpId).find((key) => key.id === id)
+    : undefined;
+}
+
+export function markPasskeyUsed(key: StoredPasskey, counter: number) {
+  const credential = JSON.stringify({
+    ...key.credential,
+    counter,
+    publicKey: Buffer.from(key.credential.publicKey).toString('base64url'),
+  });
+  return (
+    db()
+      .prepare(
+        'UPDATE passkeys SET credential = ?, lastUsedAt = ? WHERE id = ? AND credential = ?',
+      )
+      .run(
+        credential,
+        Date.now(),
+        key.id,
+        JSON.stringify({
+          ...key.credential,
+          publicKey: Buffer.from(key.credential.publicKey).toString(
+            'base64url',
+          ),
+        }),
+      ).changes > 0
+  );
+}
