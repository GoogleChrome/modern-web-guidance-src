+import type { APIRoute } from 'astro';
+import {
+  publicPasskeys,
+  removePasskey,
+  renamePasskey,
+} from '../../../lib/server/accounts';
+import {
+  json,
+  relyingParty,
+  sameOrigin,
+  signedInAccount,
+  validName,
+} from '../../../lib/server/account-api';
+
+const mutate: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  const account = await signedInAccount(context);
+  if (!account) return json({ error: 'Please sign in again.' }, 401);
+  const rpId = relyingParty(context.url);
+  const id = context.params.id!;
+  let changed;
+  if (context.request.method === 'PUT') {
+    let body;
+    try {
+      body = await context.request.json();
+    } catch {
+      return json({ error: 'Invalid request.' }, 400);
+    }
+    if (!validName(body?.name))
+      return json(
+        { error: 'Use a passkey name between 1 and 80 characters.' },
+        400,
+      );
+    changed = renamePasskey(account.id, rpId, id, body.name.trim());
+  } else {
+    changed = removePasskey(account.id, rpId, id);
+  }
+  if (!changed)
+    return json(
+      { error: 'This passkey no longer exists. Refresh the list.' },
+      404,
+    );
+  // Always return the complete authoritative list, including an empty list.
+  return json({ account, rpId, passkeys: publicPasskeys(account.id, rpId) });
+};
+
+export const PUT = mutate;
+export const DELETE = mutate;
