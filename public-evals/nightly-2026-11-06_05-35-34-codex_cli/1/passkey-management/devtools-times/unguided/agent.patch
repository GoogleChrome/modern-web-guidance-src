diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..5e570d7
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,549 @@
+import { useEffect, useState } from 'react';
+import { startRegistration } from '@simplewebauthn/browser';
+import {
+  KeyIcon,
+  ShieldCheckIcon,
+  ArrowPathIcon,
+  PlusIcon,
+  PencilSquareIcon,
+  TrashIcon,
+} from '@heroicons/react/24/outline';
+import providers from '../lib/passkey-providers.json';
+import {
+  accountRequest,
+  syncPasskeys,
+  syncReaderDetails,
+  type Passkey,
+  type PasskeyState,
+} from '../lib/passkeys';
+
+const button =
+  'inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-not-allowed';
+const field =
+  'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-2 focus:outline-gray-900';
+const registry = providers as Record<
+  string,
+  { name: string; icon_light: string }
+>;
+function provider(key: Passkey) {
+  return registry[key.aaguid.toLowerCase()];
+}
+function label(key: Passkey) {
+  return key.name || provider(key)?.name || 'Unknown passkey provider';
+}
+function date(timestamp: number) {
+  return new Intl.DateTimeFormat('en', {
+    month: 'short',
+    day: 'numeric',
+    year: 'numeric',
+  }).format(timestamp);
+}
+
+export default function AccountSettings() {
+  const [state, setState] = useState<PasskeyState | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [syncNotice, setSyncNotice] = useState<string | null>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [keyName, setKeyName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+  const [displayName, setDisplayName] = useState('');
+
+  async function load() {
+    setLoading(true);
+    setError('');
+    try {
+      const data: PasskeyState = await accountRequest('passkeys');
+      setState(data);
+      setDisplayName(data.account.displayName);
+      const keysNotice = await syncPasskeys(data);
+      const detailsNotice = await syncReaderDetails(data.rpId, data.account);
+      setSyncNotice(keysNotice || detailsNotice);
+    } catch (error) {
+      setError((error as Error).message);
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    void load();
+    async function detect() {
+      if (!window.isSecureContext || typeof PublicKeyCredential === 'undefined')
+        return;
+      try {
+        // Older browsers can still manage their existing passkeys.
+        if (PublicKeyCredential.getClientCapabilities) {
+          const capabilities =
+            await PublicKeyCredential.getClientCapabilities();
+          setCanCreate(!!capabilities.userVerifyingPlatformAuthenticator);
+        } else {
+          setCanCreate(
+            await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable(),
+          );
+        }
+      } catch {
+        setCanCreate(false);
+      }
+    }
+    void detect();
+  }, []);
+
+  async function run(action: () => Promise<void>) {
+    setBusy(true);
+    setError('');
+    setNotice('');
+    try {
+      await action();
+    } catch (error) {
+      setError((error as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function createPasskey() {
+    await run(async () => {
+      const optionsJSON = await accountRequest('passkeys/register', 'POST');
+      const response = await startRegistration({ optionsJSON });
+      const data: PasskeyState = await accountRequest(
+        'passkeys/register',
+        'PUT',
+        response,
+      );
+      setState(data);
+      setNotice(
+        'Your new passkey is ready. You can use it next time you sign in.',
+      );
+      setSyncNotice(await syncPasskeys(data));
+    });
+  }
+
+  return (
+    <div className="mx-auto max-w-4xl px-5 py-10 sm:px-10 sm:py-14">
+      <a
+        href={import.meta.env.BASE_URL}
+        className="text-sm text-gray-500 hover:text-gray-900"
+      >
+        ← Back to the Times
+      </a>
+      <div className="mt-6 border-b border-gray-200 pb-8">
+        <p className="text-xs font-semibold uppercase tracking-widest text-gray-500">
+          Your account
+        </p>
+        <h1 className="font-brand mt-2 text-4xl text-gray-900 sm:text-5xl">
+          Account settings
+        </h1>
+        <p className="mt-3 text-gray-600">
+          A little housekeeping for a more secure reading experience.
+        </p>
+      </div>
+
+      {error && (
+        <div
+          role="alert"
+          className="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800"
+        >
+          {error}{' '}
+          {!state && (
+            <>
+              <button onClick={() => void load()} className="ml-2 underline">
+                Try again
+              </button>
+              <a
+                href={`${import.meta.env.BASE_URL}signin`}
+                className="ml-3 underline"
+              >
+                Sign in
+              </a>
+            </>
+          )}
+        </div>
+      )}
+      {notice && (
+        <p
+          role="status"
+          className="mt-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800"
+        >
+          {notice}
+        </p>
+      )}
+      {loading && (
+        <p role="status" className="py-12 text-sm text-gray-500">
+          Loading your account…
+        </p>
+      )}
+
+      {state && !loading && (
+        <>
+          <section
+            className="border-b border-gray-200 py-8"
+            aria-labelledby="profile-heading"
+          >
+            <h2
+              id="profile-heading"
+              className="text-xl font-semibold text-gray-900"
+            >
+              Reader profile
+            </h2>
+            <p className="mt-2 text-sm text-gray-500">
+              Signed in as{' '}
+              <span className="font-medium text-gray-800">
+                {state.account.username}
+              </span>
+            </p>
+            <form
+              className="mt-5 flex max-w-lg flex-col items-start gap-3 sm:flex-row sm:items-end"
+              onSubmit={(event) => {
+                event.preventDefault();
+                void run(async () => {
+                  const { account } = await accountRequest('account', 'PUT', {
+                    displayName: displayName.trim(),
+                  });
+                  setState({ ...state, account });
+                  setDisplayName(account.displayName);
+                  setNotice('Your display name has been updated.');
+                  setSyncNotice(await syncReaderDetails(state.rpId, account));
+                });
+              }}
+            >
+              <div className="w-full flex-1">
+                <label
+                  htmlFor="reader-name"
+                  className="mb-2 block text-sm font-medium"
+                >
+                  Display name
+                </label>
+                <input
+                  id="reader-name"
+                  autoComplete="nickname"
+                  className={field}
+                  value={displayName}
+                  onChange={(event) => setDisplayName(event.target.value)}
+                  required
+                  maxLength={80}
+                  disabled={busy}
+                />
+              </div>
+              <button
+                disabled={
+                  busy ||
+                  !displayName.trim() ||
+                  displayName.trim() === state.account.displayName
+                }
+                className={`${button} whitespace-nowrap border border-gray-300 bg-white hover:bg-gray-50`}
+              >
+                Save changes
+              </button>
+            </form>
+          </section>
+
+          <section
+            className="py-8"
+            aria-labelledby="passkeys-heading"
+            aria-busy={busy}
+          >
+            <div className="flex flex-wrap items-center justify-between gap-4">
+              <div className="flex items-center gap-3">
+                <KeyIcon className="h-6 w-6 text-gray-700" />
+                <h2
+                  id="passkeys-heading"
+                  className="text-xl font-semibold text-gray-900"
+                >
+                  Passkeys
+                </h2>
+                <span className="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">
+                  {state.passkeys.length}
+                </span>
+              </div>
+              {canCreate && (
+                <button
+                  onClick={() => void createPasskey()}
+                  disabled={busy}
+                  className={`${button} bg-gray-900 text-white hover:bg-gray-700`}
+                >
+                  <PlusIcon className="h-4 w-4" />
+                  Create passkey
+                </button>
+              )}
+            </div>
+            <p className="mt-3 max-w-2xl text-sm leading-6 text-gray-600">
+              Sign in securely with your fingerprint, face, or device PIN. Give
+              each passkey a name you recognize, and remove any you no longer
+              use.
+            </p>
+
+            <div className="mt-6 overflow-hidden rounded-lg border border-gray-200">
+              {state.passkeys.length === 0 ? (
+                <div className="px-6 py-10 text-center">
+                  <KeyIcon className="mx-auto h-9 w-9 text-gray-400" />
+                  <h3 className="mt-4 font-semibold text-gray-900">
+                    No passkeys yet
+                  </h3>
+                  <p className="mt-2 text-sm text-gray-500">
+                    {canCreate
+                      ? 'Create your first passkey for a simpler, safer sign-in.'
+                      : 'You can still sign in with your password.'}
+                  </p>
+                </div>
+              ) : (
+                <ul className="divide-y divide-gray-200">
+                  {state.passkeys.map((key) => (
+                    <li key={key.id} className="p-5 sm:p-6">
+                      <div className="flex items-start gap-4">
+                        <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">
+                          {provider(key)?.icon_light ? (
+                            <img
+                              src={provider(key)!.icon_light}
+                              alt=""
+                              className="h-7 w-7 object-contain"
+                            />
+                          ) : (
+                            <KeyIcon className="h-6 w-6 text-gray-600" />
+                          )}
+                        </div>
+                        <div className="min-w-0 flex-1">
+                          <h3 className="break-words font-semibold text-gray-900">
+                            {label(key)}
+                          </h3>
+                          {key.name && (
+                            <p className="mt-0.5 text-xs text-gray-500">
+                              {provider(key)?.name ||
+                                'Unknown passkey provider'}
+                            </p>
+                          )}
+                          <p className="mt-2 text-xs leading-5 text-gray-500">
+                            Added{' '}
+                            <time
+                              dateTime={new Date(
+                                key.registeredAt,
+                              ).toISOString()}
+                            >
+                              {date(key.registeredAt)}
+                            </time>
+                            <span aria-hidden="true"> · </span>
+                            {key.lastUsedAt ? (
+                              <>
+                                Last used{' '}
+                                <time
+                                  dateTime={new Date(
+                                    key.lastUsedAt,
+                                  ).toISOString()}
+                                >
+                                  {date(key.lastUsedAt)}
+                                </time>
+                              </>
+                            ) : (
+                              'Not used to sign in yet'
+                            )}
+                          </p>
+                          {editing !== key.id && removing !== key.id && (
+                            <div className="mt-3 flex flex-wrap gap-5">
+                              <button
+                                disabled={busy}
+                                onClick={() => {
+                                  setEditing(key.id);
+                                  setRemoving(null);
+                                  setKeyName(label(key));
+                                }}
+                                aria-label={`Rename ${label(key)}`}
+                                className="inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 disabled:opacity-50"
+                              >
+                                <PencilSquareIcon className="h-4 w-4" />
+                                Rename
+                              </button>
+                              <button
+                                disabled={busy}
+                                onClick={() => {
+                                  setRemoving(key.id);
+                                  setEditing(null);
+                                }}
+                                aria-label={`Remove ${label(key)}`}
+                                className="inline-flex items-center gap-1.5 text-sm font-medium text-red-700 hover:text-red-900 disabled:opacity-50"
+                              >
+                                <TrashIcon className="h-4 w-4" />
+                                Remove
+                              </button>
+                            </div>
+                          )}
+                          {editing === key.id && (
+                            <form
+                              className="mt-4 max-w-md"
+                              onSubmit={(event) => {
+                                event.preventDefault();
+                                void run(async () => {
+                                  const data: PasskeyState =
+                                    await accountRequest(
+                                      `passkeys/${encodeURIComponent(key.id)}`,
+                                      'PUT',
+                                      { name: keyName.trim() },
+                                    );
+                                  setState(data);
+                                  setEditing(null);
+                                  setNotice('Passkey name updated.');
+                                });
+                              }}
+                            >
+                              <label
+                                htmlFor="passkey-name"
+                                className="mb-2 block text-sm font-medium"
+                              >
+                                Passkey name
+                              </label>
+                              <input
+                                autoFocus
+                                id="passkey-name"
+                                className={field}
+                                maxLength={80}
+                                required
+                                disabled={busy}
+                                value={keyName}
+                                onChange={(event) =>
+                                  setKeyName(event.target.value)
+                                }
+                              />
+                              <div className="mt-3 flex gap-2">
+                                <button
+                                  disabled={busy || !keyName.trim()}
+                                  className={`${button} bg-gray-900 text-white`}
+                                >
+                                  Save name
+                                </button>
+                                <button
+                                  type="button"
+                                  disabled={busy}
+                                  onClick={() => setEditing(null)}
+                                  className={`${button} border border-gray-300`}
+                                >
+                                  Cancel
+                                </button>
+                              </div>
+                            </form>
+                          )}
+                          {removing === key.id && (
+                            <div className="mt-4 rounded-md border border-red-200 bg-red-50 p-4">
+                              <p className="text-sm font-semibold text-gray-900">
+                                Remove this passkey?
+                              </p>
+                              <p className="mt-1 text-sm leading-6 text-gray-600">
+                                It will no longer work for this account.{' '}
+                                {state.passkeys.length === 1
+                                  ? 'This is your last passkey. You can still sign in with your password.'
+                                  : 'You can still sign in with your other passkeys or password.'}
+                              </p>
+                              <div className="mt-3 flex flex-wrap gap-2">
+                                <button
+                                  autoFocus
+                                  disabled={busy}
+                                  onClick={() =>
+                                    void run(async () => {
+                                      const data: PasskeyState =
+                                        await accountRequest(
+                                          `passkeys/${encodeURIComponent(key.id)}`,
+                                          'DELETE',
+                                        );
+                                      setState(data);
+                                      setRemoving(null);
+                                      setNotice(
+                                        'Passkey removed from your account.',
+                                      );
+                                      setSyncNotice(await syncPasskeys(data));
+                                    })
+                                  }
+                                  className={`${button} bg-red-700 text-white hover:bg-red-800`}
+                                >
+                                  {busy ? 'Removing…' : 'Remove passkey'}
+                                </button>
+                                <button
+                                  disabled={busy}
+                                  onClick={() => setRemoving(null)}
+                                  className={`${button} border border-gray-300 bg-white`}
+                                >
+                                  Keep passkey
+                                </button>
+                              </div>
+                            </div>
+                          )}
+                        </div>
+                      </div>
+                    </li>
+                  ))}
+                </ul>
+              )}
+            </div>
+
+            {!canCreate && (
+              <p className="mt-4 text-sm text-gray-500">
+                To create a passkey, use a browser and device that support
+                passkeys over a secure connection.
+              </p>
+            )}
+            <div className="mt-6 flex items-start gap-3 rounded-lg bg-gray-50 p-4">
+              <ShieldCheckIcon className="mt-0.5 h-5 w-5 shrink-0 text-gray-600" />
+              <div className="text-xs leading-5 text-gray-500">
+                <p>
+                  Passkeys stay protected by your device or password manager.
+                  The Times never receives your fingerprint, face, or PIN.
+                </p>
+                <p className="mt-1">
+                  We notify supported password managers when you remove a
+                  passkey or change your account display name.
+                </p>
+              </div>
+            </div>
+            {syncNotice && (
+              <div
+                role="status"
+                className="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900"
+              >
+                {syncNotice}
+                <button
+                  disabled={busy}
+                  onClick={() =>
+                    void run(async () => {
+                      const data: PasskeyState =
+                        await accountRequest('passkeys');
+                      setState(data);
+                      const keysNotice = await syncPasskeys(data);
+                      const detailsNotice = await syncReaderDetails(
+                        data.rpId,
+                        data.account,
+                      );
+                      setSyncNotice(keysNotice || detailsNotice);
+                      if (!keysNotice && !detailsNotice)
+                        setNotice('Browser sync completed.');
+                    })
+                  }
+                  className="mt-2 flex items-center gap-1.5 font-semibold underline"
+                >
+                  <ArrowPathIcon className="h-4 w-4" />
+                  Retry sync
+                </button>
+              </div>
+            )}
+          </section>
+          <div className="flex justify-between border-t border-gray-200 pt-6 text-sm">
+            <span className="text-gray-500">
+              All changes are saved to your account.
+            </span>
+            <button
+              disabled={busy}
+              onClick={() =>
+                void run(async () => {
+                  await accountRequest('account/logout', 'POST');
+                  window.location.assign(import.meta.env.BASE_URL);
+                })
+              }
+              className="font-medium text-gray-700 underline hover:text-gray-900"
+            >
+              Sign out
+            </button>
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
