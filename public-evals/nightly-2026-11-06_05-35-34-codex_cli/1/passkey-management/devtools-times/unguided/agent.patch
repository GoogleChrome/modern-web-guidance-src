+++ b/tests/passkey-sync.test.mjs
@@ -0,0 +1,70 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { syncPasskeys, syncReaderDetails } from '../src/lib/passkeys.ts';
+
+const original = globalThis.PublicKeyCredential;
+afterEach(() => {
+  if (original === undefined) delete globalThis.PublicKeyCredential;
+  else globalThis.PublicKeyCredential = original;
+});
+const state = {
+  account: { id: 'cmVhZGVy', username: 'reader', displayName: 'A Reader' },
+  rpId: 'example.test',
+  passkeys: [{ id: 'Zmlyc3Q' }, { id: 'c2Vjb25k' }],
+};
+
+test('sync uses the full server credential list and existing base64url IDs', async () => {
+  let received;
+  globalThis.PublicKeyCredential = {
+    signalAllAcceptedCredentials: async (value) => {
+      received = value;
+    },
+  };
+  assert.equal(await syncPasskeys(state), null);
+  assert.deepEqual(received, {
+    rpId: state.rpId,
+    userId: state.account.id,
+    allAcceptedCredentialIds: ['Zmlyc3Q', 'c2Vjb25k'],
+  });
+  await syncPasskeys({ ...state, passkeys: [] });
+  assert.deepEqual(received.allAcceptedCredentialIds, []);
+});
+
+test('account name sync passes the canonical user handle and saved names', async () => {
+  let received;
+  globalThis.PublicKeyCredential = {
+    signalCurrentUserDetails: async (value) => {
+      received = value;
+    },
+  };
+  assert.equal(await syncReaderDetails(state.rpId, state.account), null);
+  assert.deepEqual(received, {
+    rpId: state.rpId,
+    userId: state.account.id,
+    name: 'reader',
+    displayName: 'A Reader',
+  });
+});
+
+test('unsupported signal methods produce actionable manual guidance', async () => {
+  delete globalThis.PublicKeyCredential;
+  assert.match(await syncPasskeys(state), /password manager/);
+  globalThis.PublicKeyCredential = {};
+  assert.match(await syncReaderDetails(state.rpId, state.account), /saved/);
+});
+
+test('rejected signals report sync failures without throwing away saved changes', async () => {
+  globalThis.PublicKeyCredential = {
+    signalAllAcceptedCredentials: async () => {
+      throw new Error('Denied');
+    },
+    signalCurrentUserDetails: async () => {
+      throw new Error('Denied');
+    },
+  };
+  assert.match(await syncPasskeys(state), /browser sync failed/);
+  assert.match(
+    await syncReaderDetails(state.rpId, state.account),
+    /saved.*sync failed/,
+  );
+});
