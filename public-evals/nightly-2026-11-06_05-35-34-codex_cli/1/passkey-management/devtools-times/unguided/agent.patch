+import type { APIRoute } from 'astro';
+import {
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import { findPasskey, markPasskeyUsed } from '../../../lib/server/accounts';
+import {
+  json,
+  relyingParty,
+  sameOrigin,
+} from '../../../lib/server/account-api';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!context.session)
+    return json({ error: 'Sessions are unavailable.' }, 503);
+  const options = await generateAuthenticationOptions({
+    rpID: relyingParty(context.url),
+    userVerification: 'required',
+  });
+  context.session.set('authenticationChallenge', {
+    challenge: options.challenge,
+    expires: Date.now() + 300000,
+  });
+  return json(options);
+};
+
+export const PUT: APIRoute = async (context) => {
+  if (!sameOrigin(context.request))
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!context.session)
+    return json({ error: 'Sessions are unavailable.' }, 503);
+  const pending = await context.session.get('authenticationChallenge');
+  context.session.delete('authenticationChallenge');
+  if (!pending || pending.expires < Date.now())
+    return json({ error: 'Sign-in expired. Please try again.' }, 400);
+  try {
+    const body = await context.request.json();
+    const rpId = relyingParty(context.url);
+    const key =
+      typeof body?.id === 'string' ? findPasskey(body.id, rpId) : undefined;
+    if (!key || body.response?.userHandle !== key.userId)
+      return json(
+        {
+          error: 'This passkey is not registered. Sign in with your password.',
+        },
+        401,
+      );
+    const result = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: process.env.WEBAUTHN_ORIGIN || context.url.origin,
+      expectedRPID: rpId,
+      credential: key.credential,
+      requireUserVerification: true,
+    });
+    if (
+      !result.verified ||
+      !markPasskeyUsed(key, result.authenticationInfo.newCounter)
+    )
+      return json(
+        { error: 'Could not verify this passkey. Please try again.' },
+        401,
+      );
+    await context.session.regenerate();
+    context.session.delete('registrationChallenge');
+    context.session.set('accountId', key.userId);
+    return json({ success: true });
+  } catch {
+    return json(
+      { error: 'Could not sign in with this passkey. Please try again.' },
+      401,
+    );
+  }
+};
