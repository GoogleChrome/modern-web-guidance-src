diff --git a/src/lib/passkey-sync.ts b/src/lib/passkey-sync.ts
new file mode 100644
index 0000000..5814dc0
--- /dev/null
+++ b/src/lib/passkey-sync.ts
@@ -0,0 +1,22 @@
+import type { PasskeyList } from './passkeys';
+import { isPasskeyList, isBase64URL } from './passkeys';
+
+export async function syncPasskeys(data: PasskeyList): Promise<'synced' | 'unsupported' | 'failed'> {
+  if (typeof PublicKeyCredential === 'undefined' || !PublicKeyCredential.signalAllAcceptedCredentials) return 'unsupported';
+  // Validate the entire list before signalling: a partial list could hide a valid key.
+  if (!isPasskeyList(data)) { console.warn('Passkey synchronization skipped: invalid server data.'); return 'failed'; }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: data.rpId, userId: data.userId, allAcceptedCredentialIds: data.credentials.map(key => key.id),
+    });
+    return 'synced';
+  } catch (error) {
+    console.warn('Passkey synchronization was unavailable.', error);
+    return 'failed';
+  }
+}
+export async function signalUnknown(rpId: string, id: string) {
+  if (typeof PublicKeyCredential === 'undefined' || !PublicKeyCredential.signalUnknownCredential || !isBase64URL(id)) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: id }); }
+  catch (error) { console.warn('Passkey synchronization was unavailable.', error); }
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..ef8c80f
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,27 @@
+export interface Passkey {
+  id: string;
+  name: string;
+  provider: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+
+export interface PasskeyList {
+  rpId: string;
+  userId: string;
+  credentials: Passkey[];
+}
+
+export function isBase64URL(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export function isPasskeyList(value: unknown): value is PasskeyList {
+  if (!value || typeof value !== 'object') return false;
+  const data = value as PasskeyList;
+  return typeof data.rpId === 'string' && !!data.rpId && isBase64URL(data.userId) &&
+    Array.isArray(data.credentials) && data.credentials.every(key => key && isBase64URL(key.id) &&
+      typeof key.name === 'string' && typeof key.provider === 'string' &&
+      Number.isFinite(key.registeredAt) && (key.lastUsedAt === null || Number.isFinite(key.lastUsedAt)));
+}
diff --git a/src/lib/server/account-http.ts b/src/lib/server/account-http.ts
new file mode 100644
index 0000000..7cf85cb
--- /dev/null
+++ b/src/lib/server/account-http.ts
@@ -0,0 +1,21 @@
+import type { APIContext } from 'astro';
+import { findReader } from './account-store';
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), { status, headers: {
+    'Content-Type': 'application/json', 'Cache-Control': 'no-store',
+    'Vary': 'Cookie',
+  } });
+}
+export function sameOrigin(context: APIContext) {
+  return context.request.headers.get('origin') === context.url.origin;
+}
+export async function signedInReader(context: Pick<APIContext, 'session'>) {
+  const id = await context.session?.get('readerId');
+  return typeof id === 'string' ? findReader(id) : undefined;
+}
+// Trusted deployment configuration, never a client-supplied hostname.
+export function relyingParty() {
+  const origin = process.env.WEBAUTHN_ORIGIN || 'https://astro-news-pytrpecapa-uc.a.run.app';
+  return { origin, rpId: process.env.WEBAUTHN_RP_ID || new URL(origin).hostname };
+}
diff --git a/src/lib/server/account-store.ts b/src/lib/server/account-store.ts
new file mode 100644
index 0000000..0517085
--- /dev/null
+++ b/src/lib/server/account-store.ts
@@ -0,0 +1,86 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { createHash } from 'node:crypto';
+import providers from '../passkey-providers.json';
+import type { Passkey } from '../passkeys';
+
+export interface Reader { id: string; username: string }
+export interface StoredCredential {
+  id: string;
+  userId: string;
+  name: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = process.env.ACCOUNT_DB_PATH || './.data/accounts.sqlite';
+    mkdirSync(dirname(path), { recursive: true });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+      CREATE TABLE IF NOT EXISTS readers (id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE);
+      CREATE TABLE IF NOT EXISTS credentials (
+        id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES readers(id), record TEXT NOT NULL
+      );
+      CREATE INDEX IF NOT EXISTS credentials_owner ON credentials(userId);`);
+    database.exec('CREATE TABLE IF NOT EXISTS challenges (value TEXT PRIMARY KEY, expires INTEGER NOT NULL)');
+  }
+  return database;
+}
+// Exact usernames preserve the identity semantics of the existing login service.
+// Only call after the password service has authenticated this username.
+export function readerForVerifiedUsername(username: string): Reader {
+  const id = createHash('sha256').update(username).digest('base64url');
+  db().prepare('INSERT OR IGNORE INTO readers (id, username) VALUES (?, ?)').run(id, username);
+  return { id, username };
+}
+export function findReader(id: string): Reader | undefined {
+  return db().prepare('SELECT id, username FROM readers WHERE id = ?').get(id) as Reader | undefined;
+}
+export function credentialsFor(userId: string): StoredCredential[] {
+  return db().prepare('SELECT record FROM credentials WHERE userId = ? ORDER BY rowid DESC').all(userId)
+    .map(row => JSON.parse(row.record as string));
+}
+export function findCredential(id: string): StoredCredential | undefined {
+  const row = db().prepare('SELECT record FROM credentials WHERE id = ?').get(id);
+  return row ? JSON.parse(row.record as string) : undefined;
+}
+export function insertCredential(credential: StoredCredential) {
+  db().prepare('INSERT INTO credentials (id, userId, record) VALUES (?, ?, ?)')
+    .run(credential.id, credential.userId, JSON.stringify(credential));
+}
+export function updateCredential(credential: StoredCredential) {
+  return db().prepare('UPDATE credentials SET record = ? WHERE id = ? AND userId = ?')
+    .run(JSON.stringify(credential), credential.id, credential.userId).changes;
+}
+export function deleteCredential(id: string, userId: string) {
+  return db().prepare('DELETE FROM credentials WHERE id = ? AND userId = ?').run(id, userId).changes;
+}
+export function saveChallenge(value: string, expires: number) {
+  db().prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+  db().prepare('INSERT INTO challenges (value, expires) VALUES (?, ?)').run(value, expires);
+}
+export function consumeChallenge(value: string) {
+  // DELETE RETURNING makes challenge consumption atomic across overlapping verification requests.
+  const row = db().prepare('DELETE FROM challenges WHERE value = ? RETURNING expires').get(value);
+  return !!row && Number(row.expires) >= Date.now();
+}
+export function recordAuthentication(key: StoredCredential, counter: number) {
+  return db().prepare(`UPDATE credentials SET record = json_set(record, '$.counter', ?, '$.lastUsedAt', ?)
+    WHERE id = ? AND userId = ? AND json_extract(record, '$.counter') = ?`)
+    .run(counter, Date.now(), key.id, key.userId, key.counter).changes;
+}
+export function publicCredential(key: StoredCredential): Passkey {
+  const provider = key.aaguid === '00000000-0000-0000-0000-000000000000' ? undefined :
+    (providers as Record<string, { name: string; icon?: string }>)[key.aaguid.toLowerCase()];
+  return {
+    id: key.id, name: key.name, provider: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon, registeredAt: key.registeredAt, lastUsedAt: key.lastUsedAt,
+  };
+}
