+import { useState } from 'react';
+import { accountRequest } from '../lib/passkey-client';
+export default function AccountMenu() {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  return <div className="flex flex-wrap items-center justify-end gap-3 text-xs">
+    <a href={`${import.meta.env.BASE_URL}account/settings`} className="rounded bg-gray-800 px-3 py-2 font-semibold text-white hover:bg-gray-700">Account settings</a>
+    <button type="button" disabled={busy} className="rounded px-2 py-2 font-semibold text-gray-600 hover:bg-gray-100 disabled:opacity-50" onClick={async () => {
+      setBusy(true); setError('');
+      try { await accountRequest('logout', 'POST'); window.location.assign(import.meta.env.BASE_URL); }
+      catch { setError('Unable to sign out. Try again.'); setBusy(false); }
+    }}>{busy ? 'Signing out…' : 'Sign out'}</button>
+    {error && <p role="alert" className="text-red-700">{error}</p>}
+  </div>;
+}
