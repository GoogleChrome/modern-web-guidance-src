new file mode 100644
index 0000000..2aa04eb
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { readerForVerifiedUsername } from '../../../lib/server/account-store';
+import { json, sameOrigin } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async context => {
+  if (!sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!context.session) return json({ error: 'Sign-in is unavailable.' }, 503);
+  try {
+    const { username, password } = await context.request.json();
+    if (typeof username !== 'string' || !username || username.length > 200 ||
+        typeof password !== 'string' || !password || password.length > 1024) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, response.status >= 500 ? 502 : 401);
+    // The existing service authenticates username/password. Never retain passwords or tokens in the browser.
+    const reader = readerForVerifiedUsername(username);
+    await context.session.regenerate();
+    await context.session.set('readerId', reader.id);
+    return json({ username: reader.username });
+  } catch {
+    return json({ error: 'Sign-in is unavailable. Please try again.' }, 503);
+  }
+};
