diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..dd0fcfe
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,31 @@
+import type { APIRoute } from 'astro';
+import { credentialsFor, publicCredential, findCredential, updateCredential, deleteCredential } from '../../../lib/server/account-store';
+import { json, sameOrigin, signedInReader, relyingParty } from '../../../lib/server/account-http';
+import { isBase64URL } from '../../../lib/passkeys';
+
+export const ALL: APIRoute = async context => {
+  const { request } = context;
+  if (!['GET', 'PUT', 'DELETE'].includes(request.method)) return json({ error: 'Method not allowed.' }, 405);
+  if (request.method !== 'GET' && !sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const reader = await signedInReader(context);
+  if (!reader) return json({ error: 'Sign in to manage your passkeys.' }, 401);
+  if (request.method !== 'GET') {
+    let body;
+    try { body = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+    if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+    if (!isBase64URL(body.id)) return json({ error: 'Invalid passkey.' }, 400);
+    const key = findCredential(body.id);
+    if (!key || key.userId !== reader.id) return json({ error: 'Passkey not found.' }, 404);
+    if (request.method === 'PUT') {
+      if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 80) {
+        return json({ error: 'Use a display name between 1 and 80 characters.' }, 400);
+      }
+      key.name = body.name.trim();
+      if (!updateCredential(key)) return json({ error: 'Passkey no longer exists. Refresh the list.' }, 409);
+    } else {
+      deleteCredential(key.id, reader.id);
+    }
+  }
+  // Return the complete authoritative list, including after mutations. Never signal a filtered or paginated list.
+  return json({ rpId: relyingParty().rpId, userId: reader.id, credentials: credentialsFor(reader.id).map(publicCredential) });
+};
diff --git a/src/pages/api/account/webauthn.ts b/src/pages/api/account/webauthn.ts
new file mode 100644
index 0000000..af9c1db
--- /dev/null
+++ b/src/pages/api/account/webauthn.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { credentialsFor, insertCredential, findCredential, recordAuthentication, findReader, saveChallenge, consumeChallenge } from '../../../lib/server/account-store';
+import { json, sameOrigin, relyingParty, signedInReader } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async context => {
+  if (!sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const session = context.session;
+  if (!session) return json({ error: 'Sign-in is unavailable.' }, 503);
+  const { rpId, origin } = relyingParty();
+  try {
+    const body = await context.request.json();
+    const reader = await signedInReader(context);
+    if (body.action === 'register-options') {
+      if (!reader) return json({ error: 'Sign in to add a passkey.' }, 401);
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID: rpId,
+        userName: reader.username, userDisplayName: reader.username,
+        userID: new Uint8Array(Buffer.from(reader.id, 'base64url')),
+        excludeCredentials: credentialsFor(reader.id).map(key => ({ id: key.id, transports: key.transports })),
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+      });
+      const expires = Date.now() + 300000;
+      saveChallenge(options.challenge, expires);
+      await session.set('passkeyChallenge', { value: options.challenge, type: 'register', userId: reader.id, expires });
+      return json(options);
+    }
+    if (body.action === 'signin-options') {
+      const options = await generateAuthenticationOptions({ rpID: rpId, allowCredentials: [], userVerification: 'required' });
+      const expires = Date.now() + 300000;
+      saveChallenge(options.challenge, expires);
+      await session.set('passkeyChallenge', { value: options.challenge, type: 'signin', userId: null, expires });
+      return json(options);
+    }
+    if (body.action !== 'register-verify' && body.action !== 'signin-verify') return json({ error: 'Unknown action.' }, 400);
+    const challenge = await session.get('passkeyChallenge');
+    session.delete('passkeyChallenge');
+    if (!challenge || challenge.expires < Date.now() || !body.credential || !consumeChallenge(challenge.value)) return json({ error: 'This request has expired. Please try again.' }, 400);
+    if (body.action === 'register-verify') {
+      if (!reader || challenge.type !== 'register' || challenge.userId !== reader.id) return json({ error: 'Sign in to add a passkey.' }, 401);
+      const result = await verifyRegistrationResponse({
+        response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin,
+        expectedRPID: rpId, requireUserVerification: true,
+      });
+      if (!result.verified) return json({ error: 'Could not verify this passkey.' }, 400);
+      const { credential, aaguid } = result.registrationInfo;
+      insertCredential({
+        id: credential.id, userId: reader.id, name: '', publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+        counter: credential.counter, transports: credential.transports || [], aaguid,
+        registeredAt: Date.now(), lastUsedAt: null,
+      });
+      return json({ success: true });
+    }
+    if (challenge.type !== 'signin') return json({ error: 'Invalid sign-in request.' }, 400);
+    const key = findCredential(body.credential.id);
+    if (!key) return json({ error: 'This passkey is no longer registered. Sign in with your password.' }, 404);
+    if (body.credential.response?.userHandle !== key.userId) return json({ error: 'Could not verify this passkey.' }, 400);
+    const result = await verifyAuthenticationResponse({
+      response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin,
+      expectedRPID: rpId, requireUserVerification: true,
+      credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports },
+    });
+    if (!result.verified || !findReader(key.userId)) return json({ error: 'Could not verify this passkey.' }, 400);
+    if (!recordAuthentication(key, result.authenticationInfo.newCounter)) return json({ error: 'This passkey has changed or been removed. Please try again.' }, 409);
+    await session.regenerate();
+    await session.set('readerId', key.userId);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Could not complete the passkey request. Please try again.' }, 400);
+  }
+};
diff --git a/tests/passkey-management.test.ts b/tests/passkey-management.test.ts
new file mode 100644
index 0000000..fc9b9f8
--- /dev/null
+++ b/tests/passkey-management.test.ts
@@ -0,0 +1,159 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import type { APIContext } from 'astro';
+import { readerForVerifiedUsername, insertCredential, credentialsFor, findCredential, saveChallenge, consumeChallenge } from '../src/lib/server/account-store';
+import { ALL as passkeys } from '../src/pages/api/account/passkeys';
+import { POST as webauthn } from '../src/pages/api/account/webauthn';
+import { POST as login } from '../src/pages/api/account/login';
+import { syncPasskeys } from '../src/lib/passkey-sync';
+import { isBase64URL, isPasskeyList } from '../src/lib/passkeys';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-passkeys-'));
+process.env.ACCOUNT_DB_PATH = join(directory, 'account.sqlite');
+process.env.WEBAUTHN_ORIGIN = 'https://news.example.com';
+process.env.WEBAUTHN_RP_ID = 'example.com';
+after(() => rmSync(directory, { recursive: true, force: true }));
+
+function context(method: string, body?: unknown, readerId?: string, origin = 'https://news.example.com') {
+  const values = new Map<string, unknown>(readerId ? [['readerId', readerId]] : []);
+  return {
+    url: new URL('https://news.example.com/devtools-times/api/account/passkeys'),
+    request: new Request('https://news.example.com/devtools-times/api/account/passkeys', {
+      method, headers: { Origin: origin, 'Content-Type': 'application/json' },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    }),
+    session: {
+      get: async (key: string) => values.get(key), set: async (key: string, value: unknown) => values.set(key, value),
+      delete: (key: string) => values.delete(key), regenerate: async () => {},
+    },
+  } as unknown as APIContext;
+}
+const alice = readerForVerifiedUsername('alice');
+const bob = readerForVerifiedUsername('bob');
+const first = Buffer.from('first-credential').toString('base64url');
+const second = Buffer.from('second-credential').toString('base64url');
+for (const id of [first, second]) insertCredential({
+  id, userId: alice.id, name: 'Laptop', publicKey: 'cHVibGljLWtleQ', counter: 0, transports: [],
+  aaguid: '00000000-0000-0000-0000-000000000000', registeredAt: 1700000000000, lastUsedAt: null,
+});
+
+test('listing requires a signed-in reader and prevents caching', async () => {
+  const response = await passkeys(context('GET'));
+  assert.equal(response.status, 401);
+  assert.equal(response.headers.get('cache-control'), 'no-store');
+});
+test('returns only the owner’s credentials, server RP ID and encoded user ID', async () => {
+  const response = await passkeys(context('GET', undefined, alice.id));
+  const data = await response.json();
+  assert.ok(isPasskeyList(data));
+  assert.equal(data.rpId, 'example.com');
+  assert.equal(data.userId, alice.id);
+  assert.equal(data.credentials.length, 2);
+  assert.equal(data.credentials[0].provider, 'Unknown passkey provider');
+  assert.equal(data.credentials[0].registeredAt, 1700000000000);
+  assert.equal(data.credentials[0].lastUsedAt, null);
+  assert.equal('publicKey' in data.credentials[0], false);
+  assert.deepEqual((await (await passkeys(context('GET', undefined, bob.id))).json()).credentials, []);
+});
+test('cross-origin mutations and changes to another reader’s passkey are rejected', async () => {
+  assert.equal((await passkeys(context('DELETE', { id: first }, alice.id, 'https://evil.example'))).status, 403);
+  for (const method of ['PUT', 'DELETE']) {
+    assert.equal((await passkeys(context(method, { id: first, name: 'Stolen' }, bob.id))).status, 404);
+  }
+  assert.equal(findCredential(first)?.name, 'Laptop');
+});
+test('rejects malformed IDs, blank names and oversized labels', async () => {
+  for (const body of [{ id: 'bad==', name: 'Name' }, { id: first, name: '  ' }, { id: first, name: 'x'.repeat(81) }]) {
+    assert.equal((await passkeys(context('PUT', body, alice.id))).status, 400);
+  }
+});
+test('renames persist, trim surrounding whitespace, and retain metadata', async () => {
+  const response = await passkeys(context('PUT', { id: first, name: '  Personal laptop  ' }, alice.id));
+  assert.equal(response.status, 200);
+  assert.equal(findCredential(first)?.name, 'Personal laptop');
+  assert.equal(findCredential(first)?.registeredAt, 1700000000000);
+  assert.equal((await response.json()).credentials.length, 2);
+});
+test('deletion returns the full authoritative remaining list, including the final empty list', async () => {
+  const firstResponse = await passkeys(context('DELETE', { id: first }, alice.id));
+  assert.deepEqual((await firstResponse.json()).credentials.map((key: { id: string }) => key.id), [second]);
+  assert.equal(findCredential(first), undefined);
+  const last = await passkeys(context('DELETE', { id: second }, alice.id));
+  assert.deepEqual((await last.json()).credentials, []);
+  assert.deepEqual(credentialsFor(alice.id), []);
+});
+test('registration requires authentication and uses configured RP and discoverable keys', async () => {
+  assert.equal((await webauthn(context('POST', { action: 'register-options' }))).status, 401);
+  const ctx = context('POST', { action: 'register-options' }, alice.id);
+  const response = await webauthn(ctx);
+  const options = await response.json();
+  assert.equal(options.rp.id, 'example.com');
+  assert.equal(options.user.id, alice.id);
+  assert.equal(options.authenticatorSelection.residentKey, 'required');
+  assert.equal(options.authenticatorSelection.authenticatorAttachment, undefined);
+  assert.equal((await ctx.session!.get('passkeyChallenge'))?.type, 'register');
+});
+test('expired or missing challenges cannot verify a credential', async () => {
+  const ctx = context('POST', { action: 'signin-verify', credential: { id: first } });
+  assert.equal((await webauthn(ctx)).status, 400);
+  await ctx.session!.set('passkeyChallenge', { value: 'expired', type: 'signin', expires: Date.now() - 1, userId: null });
+  const expired = context('POST', { action: 'signin-verify', credential: { id: first } });
+  expired.session = ctx.session;
+  assert.equal((await webauthn(expired)).status, 400);
+});
+test('verification challenges are single use, including overlapping requests', () => {
+  saveChallenge('test-one-time-challenge', Date.now() + 30000);
+  assert.equal(consumeChallenge('test-one-time-challenge'), true);
+  assert.equal(consumeChallenge('test-one-time-challenge'), false);
+  saveChallenge('expired-challenge', Date.now() - 1);
+  assert.equal(consumeChallenge('expired-challenge'), false);
+});
+test('a rejected password login cannot create a signed-in session', async () => {
+  const original = globalThis.fetch;
+  globalThis.fetch = async () => new Response('{}', { status: 401 });
+  try {
+    const ctx = context('POST', { username: 'alice', password: 'wrong' });
+    assert.equal((await login(ctx)).status, 401);
+    assert.equal(await ctx.session!.get('readerId'), undefined);
+  } finally { globalThis.fetch = original; }
+});
+test('verified password login creates a server session', async () => {
+  const original = globalThis.fetch;
+  globalThis.fetch = async () => new Response('{}', { status: 200 });
+  try {
+    const ctx = context('POST', { username: 'alice', password: 'verified-by-service' });
+    assert.equal((await login(ctx)).status, 200);
+    assert.equal(await ctx.session!.get('readerId'), alice.id);
+  } finally { globalThis.fetch = original; }
+});
+test('Base64URL validation rejects padding, invalid characters and impossible lengths', () => {
+  for (const invalid of ['', 'a', 'abc==', 'key:01', undefined]) assert.equal(isBase64URL(invalid), false);
+  assert.ok(isBase64URL(first));
+  assert.ok(isBase64URL(alice.id));
+});
+test('Signal API gets server RP ID and complete lists, including empty lists', async () => {
+  const original = globalThis.PublicKeyCredential;
+  const calls: unknown[] = [];
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async (value: unknown) => { calls.push(value); } } as unknown as typeof PublicKeyCredential;
+  try {
+    const data = { rpId: 'example.com', userId: alice.id, credentials: [] };
+    assert.equal(await syncPasskeys(data), 'synced');
+    assert.deepEqual(calls, [{ rpId: 'example.com', userId: alice.id, allAcceptedCredentialIds: [] }]);
+  } finally { globalThis.PublicKeyCredential = original; }
+});
+test('unsupported browsers and failed signals do not break management', async () => {
+  const original = globalThis.PublicKeyCredential;
+  const warn = console.warn;
+  console.warn = () => {};
+  const data = { rpId: 'example.com', userId: alice.id, credentials: [] };
+  try {
+    globalThis.PublicKeyCredential = undefined as unknown as typeof PublicKeyCredential;
+    assert.equal(await syncPasskeys(data), 'unsupported');
+    globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async () => { throw new Error('provider unavailable'); } } as unknown as typeof PublicKeyCredential;
