diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..ea353af
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,34 @@
+import type { PasskeyList } from './passkeys';
+import { isPasskeyList } from './passkeys';
+export { syncPasskeys, signalUnknown } from './passkey-sync';
+
+export const accountURL = `${import.meta.env.BASE_URL}api/account/`;
+export class AccountError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+export async function accountRequest(path: string, method = 'GET', body?: unknown) {
+  const response = await fetch(`${accountURL}${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  let data;
+  try { data = await response.json(); }
+  catch { throw new AccountError('The account service is unavailable. Please try again.', response.status); }
+  if (!response.ok) throw new AccountError(data.error || 'Unable to save changes. Please try again.', response.status);
+  return data;
+}
+export async function passkeyList(method = 'GET', body?: unknown): Promise<PasskeyList> {
+  const data = await accountRequest('passkeys', method, body);
+  if (!isPasskeyList(data)) throw new Error('Unable to read your passkeys. Please try again.');
+  return data;
+}
+export function passkeyError(error: unknown): string {
+  if (error instanceof Error) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this authenticator. Try a different device or security key.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable on this address. Please use the configured secure site.';
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
