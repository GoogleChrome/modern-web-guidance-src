diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..46fd70d
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,178 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon, PlusIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import type { Passkey, PasskeyList } from '../lib/passkeys';
+import { AccountError, accountRequest, passkeyList, syncPasskeys, signalUnknown, passkeyError } from '../lib/passkey-client';
+
+const button = 'inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-wait disabled:opacity-50';
+function date(value: number | null) {
+  if (value === null) return 'Not used yet';
+  return new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [expired, setExpired] = useState(false);
+  const [message, setMessage] = useState('');
+  const [sync, setSync] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const actions = useRef(new Map<string, HTMLButtonElement>());
+
+  function fail(error: unknown) {
+    setError(passkeyError(error));
+    if (error instanceof AccountError && error.status === 401) setExpired(true);
+  }
+  async function synchronize(list: PasskeyList) {
+    const result = await syncPasskeys(list);
+    setSync(result === 'synced' ? 'Your current passkey list has been shared with this browser’s authenticator.' :
+      result === 'unsupported' ? 'This browser doesn’t support automatic passkey sync. After removing a key, you may also need to delete it in your password manager.' :
+      'Your changes are saved. Authenticator sync is unavailable right now; you can remove unused keys in your password manager.');
+  }
+  async function load() {
+    setLoading(true); setError('');
+    try {
+      const list = await passkeyList();
+      setData(list);
+      await synchronize(list);
+    } catch (error) { fail(error); }
+    finally { setLoading(false); }
+  }
+  useEffect(() => {
+    let active = true;
+    (async () => {
+      try {
+        const list = await passkeyList();
+        if (!active) return;
+        setData(list);
+        await synchronize(list);
+      } catch (error) { if (active) fail(error); }
+      finally { if (active) setLoading(false); }
+    })();
+    (async () => {
+      if (!window.isSecureContext || typeof PublicKeyCredential === 'undefined') return;
+      try {
+        await import('webauthn-polyfills');
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (active) setCanCreate(capabilities.passkeyPlatformAuthenticator === true);
+      } catch { /* Keep password sign-in available when passkeys are unavailable. */ }
+    })();
+    return () => { active = false; };
+  }, []);
+
+  function closeEdit(id: string) {
+    setEditing(null); setRemoving(null);
+    actions.current.get(id)?.focus();
+  }
+  async function rename(event: React.FormEvent, key: Passkey) {
+    event.preventDefault();
+    if (!name.trim() || busy) return;
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const list = await passkeyList('PUT', { id: key.id, name: name.trim() });
+      setData(list); setEditing(null); setMessage('Passkey display name updated.');
+      actions.current.get(key.id)?.focus();
+      // Credential nicknames do not change the account identity in the authenticator.
+    } catch (error) { fail(error); }
+    finally { setBusy(false); }
+  }
+  async function remove(key: Passkey) {
+    if (busy) return;
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const list = await passkeyList('DELETE', { id: key.id });
+      setData(list); setRemoving(null); setMessage('Passkey removed from your account.');
+      heading.current?.focus();
+      await synchronize(list);
+    } catch (error) { fail(error); }
+    finally { setBusy(false); }
+  }
+  async function create() {
+    if (busy) return;
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const options = await accountRequest('webauthn', 'POST', { action: 'register-options' });
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+      if (!credential) return;
+      const encoded = credential.toJSON();
+      try {
+        await accountRequest('webauthn', 'POST', { action: 'register-verify', credential: encoded });
+      } catch (error) {
+        // Only reject credentials the server definitely refused; a network failure may follow a committed write.
+        if (error instanceof AccountError && error.status < 500) await signalUnknown(options.rp.id, encoded.id);
+        throw error;
+      }
+      const list = await passkeyList();
+      setData(list); setMessage('Passkey added. You can give it a display name below.');
+      await synchronize(list);
+    } catch (error) { fail(error); }
+    finally { setBusy(false); }
+  }
+
+  return <section aria-labelledby="passkeys-heading">
+    <div className="flex flex-wrap items-start justify-between gap-4">
+      <div className="max-w-xl">
+        <div className="flex items-center gap-3">
+          <KeyIcon className="h-6 w-6 text-gray-700" aria-hidden="true" />
+          <h2 id="passkeys-heading" ref={heading} tabIndex={-1} className="text-2xl font-semibold text-gray-900">Passkeys</h2>
+          {data && <span className="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600">{data.credentials.length}</span>}
+        </div>
+        <p className="mt-3 text-sm leading-6 text-gray-600">Sign in securely with your fingerprint, face, device PIN, or security key. Manage the passkeys connected to your account here.</p>
+      </div>
+      {canCreate && <button type="button" className={`${button} shrink-0`} disabled={busy || loading || expired} onClick={create}><PlusIcon className="h-4 w-4" aria-hidden="true" />Add a passkey</button>}
+    </div>
+
+    <div role="status" aria-live="polite" className="mt-5 text-sm text-green-800">{message}</div>
+    {error && <div role="alert" className="mt-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
+      <p>{error}</p>
+      {expired ? <a className="mt-2 inline-block font-medium underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in again</a> :
+        !data && <button type="button" className={`${button} mt-3`} onClick={load} disabled={loading}>Try again</button>}
+    </div>}
+    {loading && <p role="status" className="py-10 text-sm text-gray-500">Loading your passkeys…</p>}
+    {!loading && data && <>
+      {data.credentials.length === 0 ? <div className="mt-4 rounded-lg border border-dashed border-gray-300 px-6 py-10 text-center">
+        <ShieldCheckIcon className="mx-auto h-9 w-9 text-gray-400" aria-hidden="true" />
+        <h3 className="mt-3 font-semibold text-gray-900">No passkeys registered</h3>
+        <p className="mt-2 text-sm text-gray-600">{canCreate ? 'Add your first passkey for a faster, more secure sign-in.' : 'You can continue signing in with your username and password.'}</p>
+      </div> : <ul className="mt-4 divide-y divide-gray-200 rounded-lg border border-gray-200">
+        {data.credentials.map(key => <li key={key.id} className="p-5 sm:p-6">
+          <div className="flex flex-wrap items-start gap-4">
+            <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">
+              {key.providerIcon ? <img src={key.providerIcon} alt="" width="28" height="28" /> : <KeyIcon className="h-6 w-6 text-gray-500" aria-hidden="true" />}
+            </div>
+            <div className="min-w-0 flex-1">
+              <h3 className="break-words font-semibold text-gray-900">{key.name || key.provider}</h3>
+              {key.name && <p className="mt-1 text-xs text-gray-500">{key.provider}</p>}
+              <div className="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs leading-5 text-gray-500">
+                <span>Added <time dateTime={new Date(key.registeredAt).toISOString()}>{date(key.registeredAt)}</time></span>
+                <span>Last used: {key.lastUsedAt === null ? 'Not used yet' : <time dateTime={new Date(key.lastUsedAt).toISOString()}>{date(key.lastUsedAt)}</time>}</span>
+              </div>
+            </div>
+            <div className="flex flex-wrap gap-2">
+              <button type="button" ref={node => { if (node) actions.current.set(key.id, node); else actions.current.delete(key.id); }} className={button} disabled={busy || expired} aria-label={`Rename ${key.name || key.provider}`} onClick={() => { setEditing(key.id); setRemoving(null); setName(key.name || key.provider); setError(''); }}><PencilSquareIcon className="h-4 w-4" aria-hidden="true" />Rename</button>
+              <button type="button" className={`${button} text-red-700`} disabled={busy || expired} aria-label={`Remove ${key.name || key.provider}`} onClick={() => { setRemoving(key.id); setEditing(null); setError(''); }}><TrashIcon className="h-4 w-4" aria-hidden="true" />Remove</button>
+            </div>
+          </div>
+          {editing === key.id && <form onSubmit={event => rename(event, key)} className="mt-5 rounded-md bg-gray-50 p-4">
+            <label htmlFor={`name-${key.id}`} className="block text-sm font-medium text-gray-800">Passkey display name</label>
+            <input id={`name-${key.id}`} autoFocus required maxLength={80} value={name} disabled={busy} onChange={event => setName(event.target.value)} className="mt-2 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-gray-900" />
+            <p className="mt-2 text-xs text-gray-500">Choose a name you recognize, such as “Personal laptop”. This label is saved to your account.</p>
+            <div className="mt-3 flex gap-2"><button type="submit" className={button} disabled={busy || !name.trim()}>{busy ? 'Saving…' : 'Save name'}</button><button type="button" className={button} disabled={busy} onClick={() => closeEdit(key.id)}>Cancel</button></div>
+          </form>}
+          {removing === key.id && <div role="group" aria-label="Confirm passkey removal" className="mt-5 rounded-md border border-red-200 bg-red-50 p-4">
+            <p className="text-sm font-semibold text-gray-900">Remove “{key.name || key.provider}”?</p>
+            <p className="mt-2 text-sm leading-6 text-gray-700">You won’t be able to sign in with this passkey again. You can still use your password{data.credentials.length > 1 ? ' or another registered passkey' : ''}.</p>
+            <div className="mt-3 flex gap-2"><button type="button" className={`${button} text-red-700`} disabled={busy} onClick={() => remove(key)}>{busy ? 'Removing…' : 'Remove passkey'}</button><button type="button" className={button} disabled={busy} onClick={() => closeEdit(key.id)}>Keep passkey</button></div>
+          </div>}
+        </li>)}
+      </ul>}
+      <p className="mt-5 text-xs leading-5 text-gray-500">{sync}</p>
+    </>}
+  </section>;
+}
