diff --git a/passkey-service.mjs b/passkey-service.mjs
new file mode 100644
index 0000000..4d38f29
--- /dev/null
+++ b/passkey-service.mjs
@@ -0,0 +1,87 @@
+const STORAGE_KEY = 'daily-grind.passkeys.preview.v1';
+const examples = [
+  { id: 'preview-mac', name: 'MacBook Pro', device: 'laptop', provider: 'iCloud Keychain', createdAt: '2026-09-12', lastUsed: 'Today', current: true },
+  { id: 'preview-iphone', name: 'iPhone 15', device: 'phone', provider: 'iCloud Keychain', createdAt: '2026-09-12', lastUsed: '2 days ago' },
+  { id: 'preview-yubikey', name: 'YubiKey 5', device: 'usb', provider: 'Security key', createdAt: '2026-10-03', lastUsed: 'Oct 28, 2026' }
+];
+export function validName(value) {
+  const name = String(value).trim();
+  if (!name || name.length > 50) throw new Error('Enter a passkey name between 1 and 50 characters.');
+  return name;
+}
+export function createPasskeyService({ fetcher = globalThis.fetch, storage = globalThis.localStorage, credentialAPI = globalThis.PublicKeyCredential } = {}) {
+  let state = { passkeys: [], demo: false };
+  const snapshot = () => structuredClone(state);
+  async function request(path, options = {}) {
+    const headers = { Accept: 'application/json', ...options.headers };
+    if (options.body) headers['Content-Type'] = 'application/json';
+    const response = await fetcher('/api/account/passkeys' + path, { credentials: 'same-origin', ...options, headers });
+    if (response.status === 401 || response.status === 403) throw new Error('Your session has expired. Please sign in again.');
+    return response;
+  }
+  function persist(passkeys) {
+    // Persist only preview data. Real credential IDs and account data stay in memory.
+    try { storage?.setItem(STORAGE_KEY, JSON.stringify(passkeys)); }
+    catch { throw new Error('Your browser could not save this change. Please allow local storage and try again.'); }
+  }
+  function usePreview() {
+    let saved;
+    try { saved = JSON.parse(storage?.getItem(STORAGE_KEY) || 'null'); } catch { /* New preview if storage is unavailable. */ }
+    const valid = Array.isArray(saved) && saved.every(key => typeof key.id === 'string' && key.id.startsWith('preview-') && typeof key.name === 'string');
+    state = { demo: true, passkeys: structuredClone(valid ? saved : examples) };
+    return snapshot();
+  }
+  return {
+    async load() {
+      const response = await request('');
+      // Static hosting may return the HTML fallback for an unimplemented API.
+      if (response.status === 404 || (response.ok && response.headers.get('content-type')?.includes('text/html'))) return usePreview();
+      if (!response.ok) throw new Error('We could not load your passkeys. Please try again.');
+      const data = await response.json();
+      if (!Array.isArray(data.passkeys)) throw new Error('We could not read your passkeys. Please try again.');
+      state = { ...data, demo: false };
+      return snapshot();
+    },
+    async rename(id, value) {
+      const name = validName(value);
+      if (!state.passkeys.some(key => key.id === id)) throw new Error('This passkey no longer exists. Refresh the page to see your latest keys.');
+      if (!state.demo) {
+        const response = await request('/' + encodeURIComponent(id), { method: 'PATCH', body: JSON.stringify({ name }) });
+        if (!response.ok) throw new Error('We could not rename this passkey. Please try again.');
+      }
+      const next = state.passkeys.map(key => key.id === id ? { ...key, name } : key);
+      if (state.demo) persist(next);
+      state.passkeys = next;
+      return snapshot();
+    },
+    async remove(id) {
+      const key = state.passkeys.find(key => key.id === id);
+      if (!key) throw new Error('This passkey no longer exists. Refresh the page to see your latest keys.');
+      let authoritative;
+      if (!state.demo) {
+        const response = await request('/' + encodeURIComponent(id), { method: 'DELETE' });
+        if (!response.ok) throw new Error('We could not remove this passkey. Please try again.');
+        if (response.status !== 204) {
+          try { authoritative = await response.json(); } catch { /* Deletion still succeeded. */ }
+        }
+      }
+      const next = state.passkeys.filter(key => key.id !== id);
+      if (state.demo) persist(next);
+      state.passkeys = next;
+      let sync = 'preview';
+      if (!state.demo) {
+        sync = 'unsupported';
+        try {
+          if (credentialAPI?.signalAllAcceptedCredentials && authoritative?.rpId && authoritative?.userId && Array.isArray(authoritative?.allAcceptedCredentialIds)) {
+            await credentialAPI.signalAllAcceptedCredentials({ rpId: authoritative.rpId, userId: authoritative.userId, allAcceptedCredentialIds: authoritative.allAcceptedCredentialIds });
+            sync = 'notified';
+          } else if (credentialAPI?.signalUnknownCredential && state.rpId && key.credentialId) {
+            await credentialAPI.signalUnknownCredential({ rpId: state.rpId, credentialId: key.credentialId });
+            sync = 'notified';
+          }
+        } catch { sync = 'failed'; }
+      }
+      return { ...snapshot(), sync };
+    }
+  };
+}
diff --git a/passkey-service.test.mjs b/passkey-service.test.mjs
new file mode 100644
index 0000000..8a379f1
--- /dev/null
+++ b/passkey-service.test.mjs
@@ -0,0 +1,89 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyService, validName } from './passkey-service.mjs';
+
+const record = { id: 'record-1', credentialId: 'Y3JlZGVudGlhbA', name: 'My laptop', device: 'laptop' };
+const json = data => new Response(JSON.stringify(data), { headers: { 'content-type': 'application/json' } });
+const loaded = () => json({ rpId: 'coffee.example', passkeys: [record] });
+const memory = () => { const data = new Map(); return { getItem: key => data.get(key), setItem: (key, value) => data.set(key, value) }; };
+
+test('preview edits persist without signaling any real browser credentials', async () => {
+  const storage = memory();
+  const options = { storage, fetcher: async () => new Response('', { status: 404 }), credentialAPI: { signalUnknownCredential: () => assert.fail('Preview must not signal credentials') } };
+  const service = createPasskeyService(options);
+  const first = await service.load();
+  await service.rename(first.passkeys[0].id, '  Home laptop  ');
+  await service.remove(first.passkeys[1].id);
+  const reloaded = await createPasskeyService(options).load();
+  assert.equal(reloaded.demo, true);
+  assert.equal(reloaded.passkeys.length, 2);
+  assert.equal(reloaded.passkeys[0].name, 'Home laptop');
+});
+
+test('expired sessions and API outages never reveal preview account data', async () => {
+  for (const status of [401, 403, 500]) {
+    const service = createPasskeyService({ fetcher: async () => new Response('', { status }), storage: memory() });
+    await assert.rejects(service.load());
+  }
+});
+
+test('failed revocation leaves credentials intact and never notifies the browser', async () => {
+  let loadedOnce = false;
+  const service = createPasskeyService({ storage: memory(), fetcher: async () => {
+    if (!loadedOnce) { loadedOnce = true; return loaded(); }
+    return new Response('', { status: 500 });
+  }, credentialAPI: { signalUnknownCredential: () => assert.fail('Failed deletion must not signal') } });
+  await service.load();
+  await assert.rejects(service.remove(record.id));
+  await assert.rejects(service.remove(record.id), /could not remove/);
+});
+
+test('successful server revocation precedes browser notification', async () => {
+  const calls = [];
+  const service = createPasskeyService({ storage: memory(), fetcher: async (url, options) => {
+    if (options.method === 'DELETE') { calls.push('delete'); return new Response(null, { status: 204 }); }
+    return loaded();
+  }, credentialAPI: { signalUnknownCredential: async options => {
+    calls.push('signal');
+    assert.deepEqual(options, { rpId: 'coffee.example', credentialId: record.credentialId });
+  } } });
+  await service.load();
+  const result = await service.remove(record.id);
+  assert.deepEqual(calls, ['delete', 'signal']);
+  assert.equal(result.passkeys.length, 0);
+  assert.equal(result.sync, 'notified');
+});
+
+test('authoritative server snapshot is preferred over the single-credential signal', async () => {
+  const snapshot = { rpId: 'coffee.example', userId: 'dXNlcg', allAcceptedCredentialIds: [] };
+  const service = createPasskeyService({ storage: memory(), fetcher: async (url, options) => options.method === 'DELETE' ? json(snapshot) : loaded(), credentialAPI: {
+    signalAllAcceptedCredentials: async options => assert.deepEqual(options, snapshot),
+    signalUnknownCredential: () => assert.fail('Prefer authoritative snapshot')
+  } });
+  await service.load();
+  assert.equal((await service.remove(record.id)).sync, 'notified');
+});
+
+test('signal rejection preserves revocation and exposes manual cleanup state', async () => {
+  const service = createPasskeyService({ storage: memory(), fetcher: async (url, options) => options.method === 'DELETE' ? new Response(null, { status: 204 }) : loaded(), credentialAPI: {
+    signalUnknownCredential: async () => { throw new Error('Unsupported authenticator'); }
+  } });
+  await service.load();
+  const result = await service.remove(record.id);
+  assert.equal(result.sync, 'failed');
+  assert.equal(result.passkeys.length, 0);
+});
+
+test('unsupported browser still revokes the account passkey', async () => {
+  const service = createPasskeyService({ storage: memory(), fetcher: async (url, options) => options.method === 'DELETE' ? new Response(null, { status: 204 }) : loaded(), credentialAPI: {} });
+  await service.load();
+  const result = await service.remove(record.id);
+  assert.equal(result.sync, 'unsupported');
+  assert.equal(result.passkeys.length, 0);
+});
+
+test('blank and overlong labels are rejected before a mutation', () => {
+  assert.throws(() => validName('   '));
+  assert.throws(() => validName('x'.repeat(51)));
+  assert.equal(validName(' Home '), 'Home');
+});
