+(async () => {
+  const { createPasskeyService, validName } = await import('./passkey-service.mjs');
+  const service = createPasskeyService();
+  const list = document.querySelector('#passkey-list');
+  const dialog = document.querySelector('#action-dialog');
+  const form = document.querySelector('#action-form');
+  const field = document.querySelector('#name-field');
+  const input = document.querySelector('#passkey-name');
+  const title = document.querySelector('#dialog-title');
+  const description = document.querySelector('#dialog-description');
+  const confirm = document.querySelector('#confirm-action');
+  const cancel = document.querySelector('.cancel-button');
+  const error = document.querySelector('#dialog-error');
+  let state = { passkeys: [] }, action, selected, toastTimer, busy = false;
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+  function icon(name) {
+    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+    use.setAttribute('href', '#' + name); svg.append(use); svg.setAttribute('aria-hidden', 'true'); return svg;
+  }
+  function date(value) {
+    const parsed = new Date(value);
+    return Number.isNaN(parsed.getTime()) ? 'Unknown' : parsed.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+  }
+  function render() {
+    list.replaceChildren();
+    document.querySelector('#key-count').textContent = `${state.passkeys.length} passkey${state.passkeys.length === 1 ? '' : 's'}`;
+    document.querySelector('#account-mode').textContent = state.demo ? 'Preview account · Example passkeys. Changes are saved only in this browser.' : '';
+    if (!state.passkeys.length) {
+      const empty = element('div', 'empty-state');
+      empty.append(icon('key'), element('strong', '', 'No passkeys here yet.'), element('p', '', 'You’ve removed all your passkeys. Use your other sign-in method next time.'));
+      list.append(empty);
+    }
+    for (const key of state.passkeys) {
+      const row = element('div', 'passkey-row');
+      const tile = element('span', 'device-icon'); tile.append(icon(['phone', 'usb'].includes(key.device) ? key.device : 'laptop'));
+      const details = element('div', 'device-details');
+      const heading = element('div', 'device-title'); heading.append(element('h4', '', key.name));
+      if (key.current) heading.append(element('span', 'current', 'This device'));
+      details.append(heading, element('p', '', key.provider || 'Passkey'), element('p', '', `Added ${date(key.createdAt)} · Last used ${key.lastUsed || 'Never'}`));
+      const actions = element('div', 'row-actions');
+      for (const [type, label, symbol] of [['rename', 'Rename', 'edit'], ['delete', 'Delete', 'trash']]) {
+        const button = element('button', `icon-button ${type}`); button.type = 'button'; button.setAttribute('aria-label', `${label} ${key.name}`); button.title = `${label} passkey`; button.append(icon(symbol)); button.addEventListener('click', () => open(type, key)); actions.append(button);
+      }
+      row.append(tile, details, actions); list.append(row);
+    }
+  }
+  function open(type, key) {
+    action = type; selected = key; error.textContent = ''; input.setCustomValidity('');
+    field.hidden = type !== 'rename'; input.required = type === 'rename';
+    confirm.classList.toggle('danger', type === 'delete'); confirm.hidden = type === 'learn'; cancel.textContent = type === 'learn' ? 'Got it' : 'Cancel';
+    if (type === 'rename') {
+      title.textContent = 'Make it recognizable.'; description.textContent = 'Give this passkey a name that feels familiar. This label is just for your Daily Grind account.'; input.value = key.name; confirm.textContent = 'Save changes';
+    } else if (type === 'delete') {
+      title.textContent = 'Remove this passkey?';
+      description.textContent = `“${key.name}” will no longer be able to sign in to your account. ${state.passkeys.length === 1 ? 'This is your last passkey. Make sure you can sign in with another method before removing it. ' : ''}${state.demo ? 'This is a preview; no real authenticator will be changed.' : 'We’ll notify your browser where supported. You may also need to remove it from your password manager.'}`;
+      confirm.textContent = 'Remove passkey';
+    } else {
+      title.textContent = 'Your face. Your fingerprint. Your key.';
+      description.textContent = 'Passkeys let you sign in with the same face, fingerprint, or PIN you use to unlock your device. They help protect you from phishing, and your biometric information never leaves your device. Rename a key to recognize it here, or remove a key you no longer use. Browser sync depends on your browser and password manager; if it isn’t supported, remove the saved key from your device settings too.';
+    }
+    dialog.showModal(); if (type === 'rename') { input.focus(); input.select(); } else cancel.focus();
+  }
+  function close() { if (!busy) dialog.close(); }
+  cancel.addEventListener('click', close); document.querySelector('.close-button').addEventListener('click', close);
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  input.addEventListener('input', () => input.setCustomValidity(''));
+  document.querySelector('#learn-more').addEventListener('click', () => open('learn'));
+  function toast(message, warning = false) {
+    clearTimeout(toastTimer); const node = document.querySelector('#toast'); node.textContent = message; node.dataset.warning = warning; node.hidden = false;
+    toastTimer = setTimeout(() => { node.hidden = true; }, warning ? 15000 : 5500);
+  }
+  form.addEventListener('submit', async event => {
+    event.preventDefault(); if (busy || action === 'learn') return;
+    error.textContent = '';
+    if (action === 'rename') { try { validName(input.value); } catch (err) { input.setCustomValidity(err.message); input.reportValidity(); return; } }
+    busy = true; confirm.disabled = true; cancel.disabled = true; confirm.textContent = action === 'rename' ? 'Saving…' : 'Removing…';
+    try {
+      state = action === 'rename' ? await service.rename(selected.id, input.value) : await service.remove(selected.id);
+      dialog.close(); render();
+      if (action === 'rename') toast('Passkey renamed. A little easier to recognize.');
+      else if (state.demo) toast('Example passkey removed. Your real passkeys are unchanged.');
+      else if (state.sync === 'notified') toast('Passkey removed. Your browser has been notified.');
+      else toast('Passkey removed from your account. Remove it from your device’s password manager too; browser sync is unavailable.', true);
+      document.querySelector('#learn-more').focus({ preventScroll: true });
+    } catch (err) { error.textContent = err.message || 'Something went wrong. Please try again.'; }
+    finally { busy = false; confirm.disabled = false; cancel.disabled = false; confirm.textContent = action === 'rename' ? 'Save changes' : 'Remove passkey'; }
+  });
+  async function load() {
+    try { state = await service.load(); render(); }
+    catch (err) {
+      list.replaceChildren(element('p', 'empty-state', err.message));
+      const retry = element('button', 'text-link', 'Try again'); retry.type = 'button'; retry.addEventListener('click', load); list.append(retry);
+      document.querySelector('#key-count').textContent = 'Unavailable';
+    }
+  }
+  await load();
+})();
