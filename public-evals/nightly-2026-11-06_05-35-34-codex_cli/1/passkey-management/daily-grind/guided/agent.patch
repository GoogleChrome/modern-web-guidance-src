+import { createApiStore, createDemoStore, syncAcceptedCredentials } from './passkeys.js';
+
+const $ = selector => document.querySelector(selector);
+const demo = document.body.dataset.source !== 'api';
+// The static preview has no authenticated session. Production must explicitly enable API mode.
+const store = demo ? createDemoStore({ getItem: key => localStorage.getItem(key), setItem: (key, value) => localStorage.setItem(key, value) }) : createApiStore(fetch, $('meta[name="csrf-token"]')?.content || '');
+let account;
+let selectedId;
+let busy = false;
+const list = $('#passkey-list');
+const status = $('#status');
+const editDialog = $('#edit-dialog');
+const deleteDialog = $('#delete-dialog');
+$('#preview-note').hidden = !demo;
+if (demo) $('#sync-description').textContent = 'In a connected account, supported browsers can update your password manager when you remove a passkey. Preview changes only affect this browser’s sample list.';
+
+function notify(message, error = false) { status.textContent = message; status.classList.toggle('error', error); }
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS(svg.namespaceURI, 'use');
+  use.setAttribute('href', `#${name}`); svg.append(use); return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag); node.className = className;
+  if (text != null) node.textContent = text;
+  return node;
+}
+function formatDate(timestamp) {
+  return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(timestamp);
+}
+function render() {
+  list.replaceChildren();
+  $('#key-count').textContent = account.credentials.length;
+  for (const key of account.credentials) {
+    const row = element('article', 'passkey-row');
+    const device = element('span', 'device-icon'); device.append(icon(['laptop', 'phone', 'key'].includes(key.device) ? key.device : 'key'));
+    const details = element('div', 'key-details');
+    const title = element('div', 'key-title'); title.append(element('h4', '', key.name));
+    if (key.current) title.append(element('span', 'device-tag', 'This device'));
+    details.append(title, element('p', 'key-provider', key.provider || 'Unknown passkey provider'));
+    const dates = element('div', 'key-dates');
+    dates.append(element('span', '', `Added ${formatDate(key.registeredAt)}`), element('span', 'separator', '·'), element('span', '', key.lastUsedAt ? `Last used ${formatDate(key.lastUsedAt)}` : 'Not used yet'));
+    details.append(dates);
+    const actions = element('div', 'key-actions');
+    for (const [action, symbol, label] of [['rename', 'edit', 'Rename'], ['delete', 'trash', 'Remove']]) {
+      const button = element('button', `icon-button ${action}`); button.type = 'button';
+      button.setAttribute('aria-label', `${label} ${key.name}`); button.title = `${label} passkey`;
+      button.append(icon(symbol));
+      button.addEventListener('click', () => openAction(key, action)); actions.append(button);
+    }
+    row.append(device, details, actions); list.append(row);
+  }
+  if (!account.credentials.length) {
+    const empty = element('div', 'empty-state'); empty.append(icon('key'), element('strong', '', 'No passkeys saved'), element('p', '', 'Passkeys you register with your account will appear here.'));
+    list.append(empty);
+  }
+  list.setAttribute('aria-busy', 'false');
+}
+async function synchronize() {
+  const result = await syncAcceptedCredentials(account, { demo: store.demo });
+  if (result === 'unsupported' || result === 'failed') $('#sync-description').textContent = 'Your account is up to date. You may also need to remove deleted passkeys manually from your device or password manager.';
+  if (result === 'synced') $('#sync-description').textContent = 'Your account’s current passkey list has been shared with your browser. Your password manager controls when its saved passkeys are updated.';
+}
+async function load() {
+  $('#retry').hidden = true; list.setAttribute('aria-busy', 'true');
+  try { account = await store.list(); render(); notify(''); await synchronize(); }
+  catch (error) { list.replaceChildren(element('p', 'empty-state', 'Your passkeys couldn’t be loaded.')); list.setAttribute('aria-busy', 'false'); $('#key-count').textContent = '–'; notify(error.message, true); $('#retry').hidden = false; }
+}
+function openAction(key, action) {
+  selectedId = key.id;
+  if (action === 'rename') {
+    $('#passkey-name').value = key.name; $('#edit-error').textContent = ''; editDialog.showModal(); $('#passkey-name').select();
+  } else {
+    $('#delete-name').textContent = key.name; $('#delete-error').textContent = ''; $('#last-key-warning').hidden = account.credentials.length > 1; deleteDialog.showModal();
+  }
+}
+function setBusy(value, form) {
+  busy = value;
+  for (const button of form.querySelectorAll('button')) button.disabled = value;
+  form.setAttribute('aria-busy', String(value));
+}
+async function save(event, action) {
+  event.preventDefault();
+  if (busy) return;
+  const form = event.currentTarget;
+  const name = $('#passkey-name').value.trim();
+  if (action === 'rename' && !name) { $('#edit-error').textContent = 'Please enter a name for this passkey.'; $('#passkey-name').focus(); return; }
+  const oldName = account.credentials.find(key => key.id === selectedId)?.name || 'Passkey';
+  setBusy(true, form);
+  try {
+    account = action === 'rename' ? await store.rename(selectedId, name) : await store.remove(selectedId);
+    // Close while the invoker still exists, preserving native focus restoration.
+    (action === 'rename' ? editDialog : deleteDialog).close(); render();
+    notify(action === 'rename' ? 'Passkey renamed. A little easier to recognize.' : `${oldName} removed. It can no longer sign in to this account.${demo ? ' (Preview only.)' : ''}`);
+    if (action === 'delete') { $('#main').focus({ preventScroll: true }); await synchronize(); }
+    else {
+      const index = account.credentials.findIndex(key => key.id === selectedId);
+      list.children[index]?.querySelector('button')?.focus({ preventScroll: true });
+    }
+  } catch (error) { $(`#${action === 'rename' ? 'edit' : 'delete'}-error`).textContent = error.message; }
+  finally { setBusy(false, form); }
+}
+$('#edit-form').addEventListener('submit', event => save(event, 'rename'));
+$('#delete-form').addEventListener('submit', event => save(event, 'delete'));
+for (const button of document.querySelectorAll('[data-close]')) button.addEventListener('click', () => button.closest('dialog').close());
+for (const dialog of [editDialog, deleteDialog]) dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+$('#retry').addEventListener('click', load);
+$('#learn-more').addEventListener('click', () => $('#learn-dialog').showModal());
+
+const panels = {
+  profile: ['Personal details', [['Full name', 'Jamie Lewis'], ['Email address', 'jamie.lewis@example.com'], ['Account', 'Preview customer account']]],
+  orders: ['My orders', 'Your next great cup is waiting. You haven’t placed any orders in this preview account.'],
+  rewards: ['Grind rewards', 'You have 240 points. Every daily ritual brings you a little closer to your next reward.']
+};
+function showPanel() {
+  const panel = location.hash.slice(1);
+  const isPasskeys = !panels[panel];
+  $('#passkeys-panel').hidden = !isPasskeys; $('#other-panel').hidden = isPasskeys;
+  for (const link of document.querySelectorAll('.account-nav a')) {
+    const selected = link.dataset.panel === (isPasskeys ? 'passkeys' : panel);
+    link.classList.toggle('selected', selected);
+    if (selected) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current');
+  }
+  if (!isPasskeys) {
+    $('#other-title').textContent = panels[panel][0];
+    const content = $('#other-content'); content.replaceChildren();
+    if (Array.isArray(panels[panel][1])) {
+      for (const [label, value] of panels[panel][1]) { const field = element('div', 'profile-field'); field.append(element('span', '', label), element('strong', '', value)); content.append(field); }
+    } else content.append(element('p', '', panels[panel][1]));
+  }
+}
+// Ancillary preview sections never pretend to be authenticated production account data.
+if (!demo) for (const link of document.querySelectorAll('[data-panel]')) link.href = link.dataset.panel === 'passkeys' ? '/account#passkeys' : `/account/${link.dataset.panel}`;
+else { window.addEventListener('hashchange', showPanel); showPanel(); }
+load();
