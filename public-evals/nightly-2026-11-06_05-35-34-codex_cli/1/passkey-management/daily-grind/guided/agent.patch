diff --git a/passkeys.js b/passkeys.js
new file mode 100644
index 0000000..59dc06a
--- /dev/null
+++ b/passkeys.js
@@ -0,0 +1,74 @@
+export const validBase64Url = value => typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+
+export function validateAccount(data) {
+  if (!data || typeof data.rpId !== 'string' || !data.rpId || !validBase64Url(data.userId) || !Array.isArray(data.credentials)) throw new Error('The account returned invalid passkey information. Please try again.');
+  const ids = new Set();
+  for (const key of data.credentials) {
+    if (!validBase64Url(key.id) || ids.has(key.id) || typeof key.name !== 'string' || !Number.isFinite(key.registeredAt) || (key.lastUsedAt != null && !Number.isFinite(key.lastUsedAt))) throw new Error('The account returned invalid passkey information. Please try again.');
+    ids.add(key.id);
+  }
+  return data;
+}
+
+// Demo credentials are labels for a preview only, never registered authenticators.
+const seed = {
+  rpId: 'dailygrind.example', userId: 'amFtaWUtbGV3aXM',
+  credentials: [
+    { id: 'bWFjYm9vay1wcm8', name: 'MacBook Pro', provider: 'iCloud Keychain', device: 'laptop', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 10, 6), current: true },
+    { id: 'aXBob25l', name: 'iPhone', provider: 'iCloud Keychain', device: 'phone', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 10, 4) },
+    { id: 'eXViaWtleQ', name: 'YubiKey 5', provider: 'Security key', device: 'key', registeredAt: Date.UTC(2026, 9, 3), lastUsedAt: Date.UTC(2026, 9, 28) }
+  ]
+};
+const storageKey = 'daily-grind-passkeys-preview-v1';
+export function createDemoStore(storage) {
+  function read() {
+    const stored = storage.getItem(storageKey);
+    return validateAccount(stored ? JSON.parse(stored) : structuredClone(seed));
+  }
+  return {
+    demo: true,
+    async list() { return read(); },
+    async rename(id, name) {
+      const account = read();
+      const key = account.credentials.find(key => key.id === id);
+      if (!key) throw new Error('This passkey no longer exists. Refresh and try again.');
+      key.name = name;
+      storage.setItem(storageKey, JSON.stringify(account));
+      return account;
+    },
+    async remove(id) {
+      const account = read();
+      account.credentials = account.credentials.filter(key => key.id !== id);
+      storage.setItem(storageKey, JSON.stringify(account));
+      return account;
+    }
+  };
+}
+
+export function createApiStore(fetcher = fetch, csrfToken = '') {
+  async function request(path = '', method = 'GET', body) {
+    const response = await fetcher(`/api/account/passkeys${path}`, {
+      method, credentials: 'same-origin', cache: 'no-store',
+      headers: { Accept: 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}), ...(method !== 'GET' ? { 'X-CSRF-Token': csrfToken } : {}) },
+      ...(body ? { body: JSON.stringify(body) } : {})
+    });
+    if (response.status === 401) throw new Error('Your session has expired. Sign in again to manage your passkeys.');
+    if (!response.ok) throw new Error('We couldn’t save your change. Please try again.');
+    return validateAccount(await response.json());
+  }
+  // Each mutation returns the complete, authoritative list for the authenticated account.
+  return { demo: false, list: () => request(), rename: (id, name) => request(`/${encodeURIComponent(id)}`, 'PUT', { name }), remove: id => request(`/${encodeURIComponent(id)}`, 'DELETE') };
+}
+
+export async function syncAcceptedCredentials(account, { demo = false, credentialApi = globalThis.PublicKeyCredential } = {}) {
+  if (demo) return 'demo';
+  if (typeof credentialApi?.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  try {
+    validateAccount(account);
+    await credentialApi.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: account.credentials.map(key => key.id) });
+    return 'synced';
+  } catch (error) {
+    console.warn('Passkey browser synchronization could not complete:', error);
+    return 'failed';
+  }
+}
