+
+function memoryStorage() {
+  const values = new Map();
+  return { getItem: key => values.get(key) || null, setItem: (key, value) => values.set(key, value) };
+}
+
+test('preview renames and deletions persist, including the empty state', async () => {
+  const storage = memoryStorage();
+  const store = createDemoStore(storage);
+  let data = await store.list();
+  assert.equal(data.credentials.length, 3);
+  const id = data.credentials[0].id;
+  await store.rename(id, 'Work laptop');
+  assert.equal((await createDemoStore(storage).list()).credentials[0].name, 'Work laptop');
+  for (const key of data.credentials) data = await store.remove(key.id);
+  assert.deepEqual(data.credentials, []);
+  assert.deepEqual((await createDemoStore(storage).list()).credentials, []);
+});
+
+test('preview credentials never reach the authenticator signal API', async () => {
+  let called = false;
+  const data = await createDemoStore(memoryStorage()).list();
+  assert.equal(await syncAcceptedCredentials(data, { demo: true, credentialApi: { signalAllAcceptedCredentials() { called = true; } } }), 'demo');
+  assert.equal(called, false);
+});
+
+test('sync uses server RP ID and all remaining IDs, including no IDs after last deletion', async () => {
+  const data = await createDemoStore(memoryStorage()).list();
+  data.rpId = 'accounts.example.com';
+  const calls = [];
+  const credentialApi = { async signalAllAcceptedCredentials(payload) { calls.push(payload); } };
+  await syncAcceptedCredentials(data, { credentialApi });
+  assert.deepEqual(calls[0], { rpId: data.rpId, userId: data.userId, allAcceptedCredentialIds: data.credentials.map(key => key.id) });
+  data.credentials = [];
+  await syncAcceptedCredentials(data, { credentialApi });
+  assert.deepEqual(calls[1].allAcceptedCredentialIds, []);
+});
+
+test('unsupported browsers can still manage passkeys', async () => {
+  assert.equal(await syncAcceptedCredentials({}, { credentialApi: {} }), 'unsupported');
+});
+
+test('bad encoding and duplicate credentials are rejected', async () => {
+  for (const value of ['', 'a', 'abc=', 'has spaces', 'cred:01']) assert.equal(validBase64Url(value), false);
+  const data = await createDemoStore(memoryStorage()).list();
+  for (const key of data.credentials) assert.ok(validBase64Url(key.id));
+  data.credentials.push(data.credentials[0]);
+  assert.throws(() => validateAccount(data), /invalid passkey information/);
+});
+
+test('signal failure is non-fatal to account management', async () => {
+  const data = await createDemoStore(memoryStorage()).list();
+  const result = await syncAcceptedCredentials(data, { credentialApi: { async signalAllAcceptedCredentials() { throw new Error('Provider unavailable'); } } });
+  assert.equal(result, 'failed');
+});
+
+test('API mutations authenticate, carry CSRF token and use authoritative response', async () => {
+  const calls = [];
+  const data = await createDemoStore(memoryStorage()).list();
+  const store = createApiStore(async (url, options) => { calls.push({ url, options }); return { ok: true, json: async () => data }; }, 'csrf-test-token');
+  await store.list();
+  await store.rename(data.credentials[0].id, 'Office');
+  const deleted = await store.remove(data.credentials[0].id);
+  assert.equal(calls[0].options.credentials, 'same-origin');
+  assert.equal(calls[1].options.headers['X-CSRF-Token'], 'csrf-test-token');
+  assert.deepEqual(JSON.parse(calls[1].options.body), { name: 'Office' });
+  assert.equal(calls[2].options.method, 'DELETE');
+  assert.equal(deleted, data);
+});
+
+test('expired sessions and unsuccessful writes fail instead of simulating success', async () => {
+  const expired = createApiStore(async () => ({ ok: false, status: 401 }));
+  await assert.rejects(expired.list(), /session has expired/);
+  const failure = createApiStore(async () => ({ ok: false, status: 500 }));
+  await assert.rejects(failure.remove('eXViaWtleQ'), /couldn’t save/);
+});
