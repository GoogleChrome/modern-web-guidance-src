+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const cardNumber = document.getElementById('card-number');
+    const cardName = document.getElementById('card-name');
+    const cardExpiry = document.getElementById('card-expiry');
+    const paymentStatus = document.getElementById('payment-status');
+
+    paymentForm.addEventListener('input', () => {
+      paymentStatus.textContent = '';
+      cardNumber.setCustomValidity('');
+      cardName.setCustomValidity('');
+      cardExpiry.setCustomValidity('');
+    });
+
+    paymentForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const digits = cardNumber.value.replace(/[\s-]/g, '');
+      cardNumber.setCustomValidity(/^[0-9]{12,19}$/.test(digits) ? '' : 'Enter 12 to 19 digits.');
+      cardName.setCustomValidity(cardName.value.trim() ? '' : 'Enter the name on your card.');
+
+      const [month, year] = cardExpiry.value.split('/').map(Number);
+      const now = new Date();
+      const expired = 2000 + year < now.getFullYear() ||
+        (2000 + year === now.getFullYear() && month < now.getMonth() + 1);
+      cardExpiry.setCustomValidity(expired ? 'Enter a card expiry date that has not passed.' : '');
+
+      if (paymentForm.reportValidity()) {
+        paymentStatus.textContent = 'Details checked. No payment has been processed or card details sent.';
+        paymentForm.reset();
+      }
+    });
+  </script>
+
