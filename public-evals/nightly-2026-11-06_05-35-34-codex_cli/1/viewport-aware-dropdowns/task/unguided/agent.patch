+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      // Fixed coordinates match the trigger's viewport-relative bounds. Include
+      // the visual viewport so zooming and the on-screen keyboard are handled.
+      const viewport = window.visualViewport;
+      const left = viewport?.offsetLeft ?? 0;
+      const top = viewport?.offsetTop ?? 0;
+      const width = viewport?.width ?? document.documentElement.clientWidth;
+      const height = viewport?.height ?? document.documentElement.clientHeight;
+      const margin = 8;
+      const right = left + width - margin;
+      const bottom = top + height - margin;
+      const bounds = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, width - margin * 2)}px`;
+      panel.style.maxHeight = `${Math.max(0, height - margin * 2)}px`;
+      const panelBounds = panel.getBoundingClientRect();
+      const below = Math.max(0, bottom - bounds.bottom);
+      const above = Math.max(0, bounds.top - top - margin);
+      const flipUp = panelBounds.height > below && above > below;
+      const availableHeight = flipUp ? above : below;
+      panel.style.maxHeight = `${Math.min(height - margin * 2, availableHeight)}px`;
+
+      // Prefer left alignment; flip to right alignment at the right boundary.
+      let x = bounds.left;
+      if (x + panelBounds.width > right) x = bounds.right - panelBounds.width;
+      x = Math.max(left + margin, Math.min(x, right - panelBounds.width));
+      const actualHeight = panel.getBoundingClientRect().height;
+      const y = flipUp ? bounds.top - actualHeight : bounds.bottom;
+      panel.style.left = `${x}px`;
+      panel.style.top = `${Math.max(top + margin, Math.min(y, bottom - actualHeight))}px`;
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      if (event.newState === 'open') requestAnimationFrame(positionPanel);
+    });
+    panel.addEventListener('toggle', positionPanel);
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
