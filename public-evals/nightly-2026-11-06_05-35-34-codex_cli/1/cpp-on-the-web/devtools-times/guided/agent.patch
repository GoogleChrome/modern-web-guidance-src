+  if (id >= 0 && id < 8) spheres[id].c = Vec(clamp(r), clamp(g), clamp(b));
+}
+void render_rows(unsigned char* output, int w, int h, int samples, int start, int end, unsigned seed) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+  int samps=samples/4;
+  for (int row=start; row<end && row<h; ++row) {
+    int y=h-row-1;
+    unsigned short Xi[3]={(unsigned short)seed,(unsigned short)(seed>>16),(unsigned short)(y*y*y)};
+    for (int x=0; x<w; ++x) {
