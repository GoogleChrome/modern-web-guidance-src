@@ -0,0 +1,18 @@
+import { spawnSync } from 'node:child_process';
+import { mkdirSync, existsSync } from 'node:fs';
+mkdirSync('public/wasm', { recursive: true });
+const compiler = process.env.EMXX || 'em++';
+const result = spawnSync(compiler, [
+  'vendor/smallpt/renderer.cpp', '-o', 'public/wasm/smallpt.js',
+  '-O3', '-flto', '-Wall', '-Werror', '-fno-exceptions', '-fno-rtti', '-nostdlib++', '--no-entry',
+  '-sSTRICT', '-sEXPORT_ES6', '-sENVIRONMENT=worker',
+  '-sALLOW_MEMORY_GROWTH', '-sSTACK_SIZE=1MB',
+  '-sEXPORTED_FUNCTIONS=_render_rows,_set_color,_malloc,_free',
+  '-sEXPORTED_RUNTIME_METHODS=HEAPU8',
+], { stdio: 'inherit' });
+if (result.error?.code === 'ENOENT' && existsSync('public/wasm/smallpt.wasm') && existsSync('public/wasm/smallpt.js')) {
+  console.log('Emscripten unavailable; using the checked-in WebAssembly build.');
+} else if (result.status !== 0) {
+  console.error('WebAssembly compilation failed. Install Emscripten or set EMXX.');
+  process.exit(1);
+}
