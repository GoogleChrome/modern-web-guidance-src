+      id: Number(input.dataset.sphere),
+      rgb: input.value === defaults[index]
+        ? (index < 2 ? (index === 0 ? [.75, .25, .25] : [.25, .25, .75]) : [.999, .999, .999])
+        : [1, 3, 5].map(offset => Math.min(.999, parseInt(input.value.slice(offset, offset + 2), 16) / 255)),
+    }));
+    worker.postMessage({ width, height, samples, colors, seed: currentSeed });
+  } catch (error) {
+    fail(error instanceof Error ? error.message : 'WebAssembly is unavailable.');
+  }
+}
+function fail(message: string) {
+  status(message, false, true);
+  $('progress-text').textContent = 'Try again';
+  worker?.terminate();
+  worker = undefined;
+}
+randomize.addEventListener('click', () => {
+  // Keep materials bright enough to show their characteristic reflections.
+  inputs.forEach(input => {
+    const hue = Math.random() * 360;
+    const saturation = .28 + Math.random() * .46;
+    const lightness = .5 + Math.random() * .2;
+    const a = saturation * Math.min(lightness, 1 - lightness);
+    const channel = (n: number) => {
+      const k = (n + hue / 30) % 12;
+      return Math.round((lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))) * 255).toString(16).padStart(2, '0');
+    };
+    input.value = `#${channel(0)}${channel(8)}${channel(4)}`;
+  });
+  currentSeed = crypto.getRandomValues(new Uint32Array(1))[0];
+  updateColors();
+  render();
+});
+reset.addEventListener('click', () => {
+  inputs.forEach((input, index) => { input.value = defaults[index]; });
+  currentSeed = 1;
+  updateColors();
+  render();
+});
+inputs.forEach(input => input.addEventListener('change', () => { updateColors(); render(); }));
+const sampleButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-samples]')];
+sampleButtons.forEach(button => {
+  button.setAttribute('aria-pressed', String(Number(button.dataset.samples) === samples));
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    sampleButtons.forEach(item => { item.classList.toggle('selected', item === button); item.setAttribute('aria-pressed', String(item === button)); });
+    $('quality-description').textContent = ({16:'A quick look. More grain, less waiting.',64:'A nice balance of speed and detail.',128:'Smoother light, a little more patience.',256:'The cleanest image. Settle in for a moment.'} as Record<number, string>)[samples];
+    render();
+  });
+});
+$('resolution').addEventListener('change', render);
+const tabs = [$<HTMLButtonElement>('render-tab'), $<HTMLButtonElement>('source-tab')];
+function selectTab(index: number) {
+  tabs.forEach((tab, i) => {
+    tab.classList.toggle('active', i === index);
+    tab.setAttribute('aria-selected', String(i === index));
+    tab.tabIndex = i === index ? 0 : -1;
+    $(tab.getAttribute('aria-controls')!).hidden = i !== index;
+  });
+}
+tabs.forEach((tab, index) => {
+  tab.addEventListener('click', () => selectTab(index));
+  tab.addEventListener('keydown', event => {
+    if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+      event.preventDefault();
+      const next = event.key === 'Home' ? 0 : event.key === 'End' ? 1 : 1 - index;
+      selectTab(next);
+      tabs[next].focus();
+    }
+  });
+});
+selectTab(0);
+$('download').addEventListener('click', () => {
+  const link = document.createElement('a');
+  link.download = completed || !canvas.hidden ? 'smallpt-render.png' : 'smallpt-original.png';
+  if (completed || !canvas.hidden) {
+    canvas.toBlob(blob => {
+      if (!blob) return;
+      if (lastUrl) URL.revokeObjectURL(lastUrl);
+      lastUrl = URL.createObjectURL(blob);
+      link.href = lastUrl;
+      link.click();
+    }, 'image/png');
+  } else { link.href = reference.src; link.click(); }
+});
+window.addEventListener('pagehide', () => { worker?.terminate(); if (lastUrl) URL.revokeObjectURL(lastUrl); });
+render();
