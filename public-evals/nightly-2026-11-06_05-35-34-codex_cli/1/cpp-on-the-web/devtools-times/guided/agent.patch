+  $('status-dot').classList.toggle('busy', busy);
+  $('status-dot').classList.toggle('error', error);
+};
+function updateColors() {
+  inputs.forEach(input => { $(`hex-${input.dataset.sphere}`).textContent = input.value.toUpperCase(); });
+}
