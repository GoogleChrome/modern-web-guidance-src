diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..66e4b85
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,24 @@
+import createSmallpt from './smallpt.js';
+let renderer;
+self.onmessage = async ({ data }) => {
+  let ptr;
+  try {
+    const { width, height, samples, colors, seed } = data;
+    if (![320, 640, 1024].includes(width) || height !== width * 3 / 4 || ![16, 64, 128, 256].includes(samples)) throw new Error('Invalid render settings.');
+    renderer ??= await createSmallpt();
+    for (const { id, rgb } of colors) renderer._set_color(id, ...rgb);
+    ptr = renderer._malloc(width * height * 4);
+    if (!ptr) throw new Error('Could not allocate render memory.');
+    const start = performance.now();
+    for (let row = 0; row < height; row += 4) {
+      renderer._render_rows(ptr, width, height, samples, row, Math.min(row + 4, height), seed);
+      self.postMessage({ type: 'progress', progress: Math.min(row + 4, height) / height, elapsed: performance.now() - start });
+    }
+    const pixels = new Uint8ClampedArray(renderer.HEAPU8.buffer, ptr, width * height * 4).slice();
+    self.postMessage({ type: 'complete', pixels, width, height, elapsed: performance.now() - start }, [pixels.buffer]);
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message || String(error) });
+  } finally {
+    if (ptr) renderer._free(ptr);
+  }
+};
