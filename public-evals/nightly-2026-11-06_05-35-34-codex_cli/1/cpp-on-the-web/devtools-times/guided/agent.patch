@@ -0,0 +1,28 @@
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/wasm/smallpt.js';
+// Exercise the worker-targeted module without starting a server or browser.
+const binary = fs.readFileSync(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+globalThis.fetch = async () => new Response(binary, { headers: { 'Content-Type': 'application/wasm' } });
+const wasm = await createSmallpt();
+const width = 64, height = 48, size = width * height * 4;
+const ptr = wasm._malloc(size);
+try {
+  const render = (batched = false) => {
+    if (batched) {
+      for (let row = 0; row < height; row += 4) wasm._render_rows(ptr, width, height, 16, row, row + 4, 1);
+    } else wasm._render_rows(ptr, width, height, 16, 0, height, 1);
+    return Buffer.from(wasm.HEAPU8.slice(ptr, ptr + size));
+  };
+  const original = render();
+  assert(original.some((v, i) => i % 4 !== 3 && v > 0), 'Image must contain light');
+  assert(original.every((v, i) => i % 4 !== 3 || v === 255), 'Every pixel must be opaque');
+  assert(original.equals(render(true)), 'Row batches must match a whole-frame render');
+  wasm._set_color(6, .2, .8, .4);
+  wasm._set_color(7, .8, .3, .5);
+  assert(!original.equals(render()), 'Sphere color changes must affect the image');
+  wasm._set_color(6, .999, .999, .999);
+  wasm._set_color(7, .999, .999, .999);
+  assert(original.equals(render()), 'Reset must reproduce the original scene');
+  console.log('WebAssembly checks passed: RGBA output, row batching, sphere colors, and deterministic reset.');
+} finally { wasm._free(ptr); }
