+const $ = (id) => document.getElementById(id);
+const canvas = $('render-canvas');
+const context = canvas.getContext('2d');
+const renderButton = $('render');
+const paletteElements = [...document.querySelectorAll('.material')];
+let worker;
+let jobId = 0;
+let seed = 42;
+let randomized = false;
+let rendering = false;
+let hasImage = false;
+let currentSamples = 64;
+
+function setButtonLabel(text) {
+  renderButton.replaceChildren();
+  const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  icon.classList.add('icon');
+  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+  use.setAttribute('href', '#play');
+  icon.append(use);
+  renderButton.append(icon, document.createTextNode(text));
+}
+
+function setState(message, state = 'ready') {
+  $('status').textContent = message;
+  $('output-state').textContent = state === 'running' ? 'LIVE OUTPUT' : state === 'error' ? 'RENDER ERROR' : 'RENDER OUTPUT';
+  rendering = state === 'running';
+  setButtonLabel(rendering ? 'Stop rendering' : 'Render scene');
+  canvas.setAttribute('aria-busy', String(rendering));
+}
+
+function fail(message) {
+  setState(message, 'error');
+  $('randomize').disabled = true;
+  renderButton.disabled = true;
+}
+
+function updatePalette(colors) {
+  paletteElements.forEach((element, index) => {
+    const rgb = [...colors.slice(index * 3, index * 3 + 3)];
+    const hex = '#' + rgb.map((v) => v.toString(16).padStart(2, '0')).join('').toUpperCase();
+    element.querySelector('small').textContent = hex;
+    const swatch = element.querySelector('.swatch');
+    // Color values originate from the C++ scene, including sphere reflectances.
+    if (randomized || index < 2) swatch.style.background = hex;
+    else swatch.style.removeProperty('background');
+  });
+}
+
+function render() {
+  if (!worker) return;
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  currentSamples = Number(document.querySelector('input[name="quality"]:checked').value);
+  const id = ++jobId;
+  canvas.width = width;
+  canvas.height = height;
+  canvas.classList.remove('has-frame');
+  hasImage = false;
+  $('download').disabled = true;
+  $('progress').value = 0;
+  $('percentage').textContent = '0%';
+  $('sample-count').replaceChildren(document.createTextNode('0 '));
+  const target = document.createElement('span');
+  target.textContent = `/ ${currentSamples}`;
+  $('sample-count').append(target);
+  $('elapsed').textContent = '0.0 s';
+  $('image-resolution').textContent = `${width} × ${height} PX`;
+  $('seed').textContent = String(seed).padStart(6, '0');
+  setState('Tracing the light…', 'running');
+  worker.postMessage({ type: 'render', id, width, height, samples: currentSamples, seed, randomized });
+}
+
+$('randomize').addEventListener('click', () => {
+  seed = (crypto.getRandomValues(new Uint32Array(1))[0] % 999999) + 1;
+  randomized = true;
+  render();
+});
+
+renderButton.addEventListener('click', () => {
+  if (rendering) {
+    worker.postMessage({ type: 'stop' });
+    ++jobId;
+    setState('Render stopped. Ready when you are.');
+  } else render();
+});
+
+$('reset').addEventListener('click', () => {
+  seed = 42;
+  randomized = false;
+  $('resolution').value = '640';
+  document.querySelector('input[name="quality"][value="64"]').checked = true;
+  render();
+});
+
+$('download').addEventListener('click', () => {
+  if (!hasImage) return;
+  canvas.toBlob((blob) => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${seed}-${canvas.width}x${canvas.height}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+
+const viewer = $('viewer');
+$('fullscreen').disabled = !document.fullscreenEnabled;
+$('fullscreen').addEventListener('click', async () => {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else await viewer.requestFullscreen();
+  } catch {
+    $('status').textContent = 'Fullscreen is unavailable in this view.';
+  }
+});
+document.addEventListener('fullscreenchange', () => {
+  $('fullscreen').setAttribute('aria-label', document.fullscreenElement ? 'Exit fullscreen' : 'Expand render');
+});
+
+if (!window.WebAssembly || !window.Worker || !context) {
+  fail('This browser does not support the WebAssembly renderer.');
+} else {
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.addEventListener('error', () => fail('Could not load the renderer. Reload to try again.'));
+    worker.addEventListener('message', ({ data }) => {
+      if (data.id !== jobId) return;
+      if (data.type === 'error') {
+        fail(`Render failed: ${data.message}`);
+      } else if (data.type === 'started') {
+        updatePalette(data.palette);
+      } else if (data.type === 'frame') {
+        const image = new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height);
+        context.putImageData(image, 0, 0);
+        canvas.classList.add('has-frame');
+        hasImage = data.samples >= 4;
+        $('download').disabled = !hasImage;
+        $('progress').value = data.progress;
+        $('percentage').textContent = `${Math.floor(data.progress)}%`;
+        $('sample-count').firstChild.textContent = `${data.samples} `;
+        $('elapsed').replaceChildren(document.createTextNode(data.elapsed.toFixed(1)));
+        const unit = document.createElement('span');
+        unit.textContent = ' s';
+        $('elapsed').append(unit);
+        if (data.done) setState('Render complete. A little light, a lot of possibility.');
+      }
+    });
+    render();
+  } catch {
+    fail('Could not initialize WebAssembly. Reload to try again.');
+  }
+}
