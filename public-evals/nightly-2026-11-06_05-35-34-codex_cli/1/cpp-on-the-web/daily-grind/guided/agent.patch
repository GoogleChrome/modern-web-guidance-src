diff --git a/render-worker.js b/render-worker.js
new file mode 100644
index 0000000..a55cacf
--- /dev/null
+++ b/render-worker.js
@@ -0,0 +1,47 @@
+import createSmallpt from './wasm/smallpt.js';
+
+let renderer;
+let generation = 0;
+const initialized = createSmallpt().then((module) => { renderer = module; });
+
+self.onmessage = async ({ data }) => {
+  const job = ++generation;
+  try {
+    await initialized;
+    if (job !== generation) return;
+    if (data.type === 'stop') return;
+    if (data.type !== 'render') return;
+    const { width, height, samples, seed, randomized } = data;
+    if (!renderer._begin_render(width, height, samples, seed, randomized ? 1 : 0)) {
+      throw new Error('Invalid render settings.');
+    }
+    const palettePointer = renderer._get_palette();
+    const palette = renderer.HEAPU8.slice(palettePointer, palettePointer + 12);
+    self.postMessage({ type: 'started', id: data.id, palette });
+    const started = performance.now();
+    let lastUpdate = 0;
+    const step = () => {
+      if (job !== generation) return;
+      try {
+        // Short batches let new render/stop messages interrupt the current job.
+        const progress = renderer._render_rows(8);
+        const now = performance.now();
+        if (now - lastUpdate > 120 || progress === 10000) {
+          const pointer = renderer._get_pixels();
+          // Read the heap again after the call: memory growth can detach old views.
+          const pixels = renderer.HEAPU8.slice(pointer, pointer + width * height * 4);
+          self.postMessage({ type: 'frame', id: data.id, pixels, width, height,
+            progress: progress / 100, samples: renderer._get_samples(),
+            elapsed: (now - started) / 1000, done: progress === 10000 }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+        if (progress < 10000) setTimeout(step, 0);
+      } catch (error) {
+        self.postMessage({ type: 'error', id: data.id, message: error.message });
+      }
+    };
+    step();
+  } catch (error) {
+    self.postMessage({ type: 'error', id: data.id, message: error.message });
+  }
+};
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..249ec7b
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,30 @@
+import { mkdir, mkdtemp, cp, rm } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const scratch = await mkdtemp(join(tmpdir(), 'smallpt-build-'));
+function compile(args) {
+  const result = spawnSync(process.env.EMXX || 'em++', args, { stdio: 'inherit' });
+  if (result.error) throw new Error('Emscripten is required. Install it and activate emsdk_env.sh.', { cause: result.error });
+  if (result.status !== 0) throw new Error(`Emscripten exited with ${result.status}`);
+}
+try {
+  await mkdir('wasm', { recursive: true });
+  const object = join(scratch, 'smallpt.o');
+  const flags = ['-O3', '-flto', '-Wall', '-Werror', '-fno-exceptions', '-fno-rtti', '-nostdlib++'];
+  compile(['src/smallpt.cpp', '-c', '-o', object, ...flags]);
+  compile([object, '-o', 'wasm/smallpt.js', ...flags, '--no-entry',
+    '-sSTRICT', '-sEXPORT_ES6', '-sENVIRONMENT=worker', '-sALLOW_MEMORY_GROWTH',
+    '-sSTACK_SIZE=1MB', '-sINITIAL_MEMORY=32MB', '-sFILESYSTEM=0',
+    '-sEXPORTED_FUNCTIONS=_begin_render,_render_rows,_get_pixels,_get_palette,_get_samples',
+    '-sEXPORTED_RUNTIME_METHODS=HEAPU8']);
+  await rm('dist', { recursive: true, force: true });
+  await mkdir('dist');
+  for (const file of ['index.html', 'styles.css', 'app.js', 'render-worker.js', 'wasm', 'assets', 'src', 'vendor']) {
+    await cp(file, join('dist', file), { recursive: true });
+  }
+  console.log('Built smallpt WebAssembly and static site in dist/');
+} finally {
+  await rm(scratch, { recursive: true, force: true });
+}
diff --git a/scripts/render-preview.mjs b/scripts/render-preview.mjs
new file mode 100644
index 0000000..76e7fae
--- /dev/null
+++ b/scripts/render-preview.mjs
@@ -0,0 +1,64 @@
+// Render the initial image through the actual compiled WebAssembly, without a server.
+import { readFile, writeFile } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import assert from 'node:assert/strict';
+import createSmallpt from '../wasm/smallpt.js';
+
+const binary = await readFile(new URL('../wasm/smallpt.wasm', import.meta.url));
+const originalFetch = globalThis.fetch;
+globalThis.fetch = async (url) => {
+  assert.equal(new URL(url).pathname.endsWith('/wasm/smallpt.wasm'), true);
+  return new Response(binary, { headers: { 'Content-Type': 'application/wasm' } });
+};
+let renderer;
+try { renderer = await createSmallpt(); }
+finally { globalThis.fetch = originalFetch; }
+
+function frame(width, height, samples, seed, randomized) {
+  assert.equal(renderer._begin_render(width, height, samples, seed, randomized), 1);
+  let progress = 0;
+  while (progress < 10000) progress = renderer._render_rows(24);
+  assert.equal(renderer._get_samples(), samples);
+  const ptr = renderer._get_pixels();
+  return Buffer.from(renderer.HEAPU8.slice(ptr, ptr + width * height * 4));
+}
+const first = frame(64, 48, 16, 42, 0);
+assert(first.some((value, index) => index % 4 !== 3 && value > 0), 'Output must contain visible light');
+assert(first.every((value, index) => index % 4 !== 3 || value === 255), 'Every final pixel must be opaque');
+assert.deepEqual(frame(64, 48, 16, 42, 0), first, 'Identical seeds must reproduce the output');
+const changed = frame(64, 48, 16, 12345, 1);
+assert.notDeepEqual(changed, first, 'Randomized scene must change the output');
+const palettePtr = renderer._get_palette();
+const palette = renderer.HEAPU8.slice(palettePtr, palettePtr + 12);
+assert(palette[6] !== 255 || palette[7] !== 255 || palette[8] !== 255, 'Mirror sphere color must change');
+assert(palette[9] !== 255 || palette[10] !== 255 || palette[11] !== 255, 'Glass sphere color must change');
+assert.equal(renderer._begin_render(801, 600, 64, 42, 0), 0, 'Reject oversized image');
+console.log('Wasm checks passed: pixels, alpha, repeatability, randomized sphere colors, dimension limits.');
+
+const width = 640, height = 480;
+console.log('Rendering 640 × 480 preview at 128 samples per pixel…');
+const started = performance.now();
+const rgba = frame(width, height, 128, 42, 0);
+function crc32(bytes) {
+  let crc = 0xffffffff;
+  for (const byte of bytes) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1));
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, bytes) {
+  const label = Buffer.from(type);
+  const length = Buffer.alloc(4); length.writeUInt32BE(bytes.length);
+  const crc = Buffer.alloc(4); crc.writeUInt32BE(crc32(Buffer.concat([label, bytes])));
+  return Buffer.concat([length, label, bytes, crc]);
+}
+const header = Buffer.alloc(13);
+header.writeUInt32BE(width, 0); header.writeUInt32BE(height, 4); header[8] = 8; header[9] = 6;
+const rows = Buffer.alloc(height * (width * 4 + 1));
+for (let y = 0; y < height; y++) rgba.copy(rows, y * (width * 4 + 1) + 1, y * width * 4, (y + 1) * width * 4);
+await writeFile(new URL('../assets/preview.png', import.meta.url), Buffer.concat([
+  Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR', header),
+  chunk('IDAT', deflateSync(rows)), chunk('IEND', Buffer.alloc(0))
+]));
+console.log(`Saved genuine smallpt preview in ${((performance.now() - started) / 1000).toFixed(1)}s.`);
diff --git a/src/smallpt.cpp b/src/smallpt.cpp
new file mode 100644
index 0000000..6d00afc
--- /dev/null
+++ b/src/smallpt.cpp
@@ -0,0 +1,148 @@
+// Browser adaptation of Kevin Beason's smallpt (MIT).
+// Original source and full license: ../vendor/smallpt/
+#include <math.h>   // smallpt, a Path Tracer by Kevin Beason, 2008
+#include <stdlib.h> // Make : g++ -O3 -fopenmp smallpt.cpp -o smallpt
+#include <stdint.h>
+#include <string.h>
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// Progressive browser interface. Each pass retains the original 2x2 tent-filtered
+// camera sampling, adding four samples per pixel to a linear-radiance buffer.
+static constexpr int MAX_PIXELS = 800 * 600;
+static Vec accumulation[MAX_PIXELS];
+static unsigned char pixels[MAX_PIXELS * 4];
+static unsigned char palette[12];
+static int width, height, targetPasses, pass, row;
+static uint32_t renderSeed;
+
+static uint32_t randomWord(uint32_t &state) {
+  state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+  return state;
+}
+static Vec randomColor(uint32_t &state) {
+  // Bounded, bright reflectances keep every randomized room well illuminated.
+  double h = (randomWord(state) % 360) / 60.0;
+  double x = 1 - fabs(fmod(h, 2.0) - 1);
+  Vec c = h<1 ? Vec(1,x,0) : h<2 ? Vec(x,1,0) : h<3 ? Vec(0,1,x) :
+          h<4 ? Vec(0,x,1) : h<5 ? Vec(x,0,1) : Vec(1,0,x);
+  return c * .54 + Vec(.22,.22,.22);
+}
+extern "C" {
+int begin_render(int w, int h, int samples, unsigned int seed, int randomized) {
+  if (w<1 || h<1 || w>800 || h>600 || samples<4 || samples>1024) return 0;
+  width=w; height=h; targetPasses=(samples+3)/4; pass=0; row=0;
+  renderSeed=seed ? seed : 1;
+  memset(pixels, 0, w*h*4);
+  for (int i=0; i<w*h; ++i) accumulation[i]=Vec();
+  spheres[0].c=Vec(.75,.25,.25); spheres[1].c=Vec(.25,.25,.75);
+  spheres[6].c=Vec(.999,.999,.999); spheres[7].c=Vec(.999,.999,.999);
+  uint32_t state=renderSeed;
+  int ids[4]={0,1,6,7};
+  for (int i=0; i<4; ++i) {
+    if (randomized) spheres[ids[i]].c=randomColor(state);
+    Vec c=spheres[ids[i]].c;
+    palette[i*3]=toInt(c.x); palette[i*3+1]=toInt(c.y); palette[i*3+2]=toInt(c.z);
+  }
+  return 1;
+}
+int render_rows(int count) {
+  if (width==0 || pass>=targetPasses) return 10000;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int k=0; k<count && pass<targetPasses; ++k) {
+    int y=row;
+    uint32_t state=renderSeed ^ (uint32_t(y+1)*2654435761u) ^ (uint32_t(pass+1)*2246822519u);
+    unsigned short Xi[3]={static_cast<unsigned short>(randomWord(state)),
+      static_cast<unsigned short>(randomWord(state)), static_cast<unsigned short>(randomWord(state))};
+    for (int x=0; x<width; ++x) {
+      int i=(height-y-1)*width+x;
+      Vec r;
+      for (int sy=0; sy<2; ++sy) for (int sx=0; sx<2; ++sx) {
+        double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1 : 1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1 : 1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*.25;
+      }
+      accumulation[i]=accumulation[i]+r;
+      Vec color=accumulation[i]*(1.0/(pass+1));
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z); pixels[i*4+3]=255;
+    }
+    if (++row==height) { row=0; ++pass; }
+  }
+  return (pass*height+row)*10000/(targetPasses*height);
+}
+unsigned char *get_pixels() { return pixels; }
+unsigned char *get_palette() { return palette; }
+int get_samples() { return pass*4; }
+}
