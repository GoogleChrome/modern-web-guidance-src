+@layer base, layout, components, responsive;
+@layer base {
+  :root { --paper:#f7f8f2; --ink:#262b24; --muted:#7c8176; --line:#e0e3d9; --green:#44664a; --green-dark:#304d35; --soft-green:#eaf0e4; --mono:'DM Mono',monospace; --sans:'DM Sans',sans-serif; color-scheme:light; font-family:var(--sans); color:var(--ink); background:var(--paper); font-synthesis:none; }
+  body { margin:0; font-size:14px; -webkit-font-smoothing:antialiased; }
+  :where(main,section,aside,header,footer,div,button,select,fieldset,label) { box-sizing:border-box; }
+  :where(h1,h2,h3,p) { margin:0; }
+  a { color:inherit; text-decoration:none; }
+  button,select,input { font:inherit; }
+  button,select { cursor:pointer; }
+  button { color:inherit; }
+  button:disabled { cursor:default; opacity:.45; }
+  :where(a,button,select,input):focus-visible { outline:3px solid #769471; outline-offset:4px; }
+  button { transition:background .16s,color .16s; }
+  .icon { inline-size:18px; block-size:18px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
+  .icon-library { display:none; }
+  .mono { font-family:var(--mono); }
+  ::selection { background:#d9e4cc; }
+}
+@layer layout {
+  .site-header { max-inline-size:1440px; margin-inline:auto; padding:25px 48px; display:flex; align-items:center; justify-content:space-between; border-block-end:1px solid var(--line); }
+  main { max-inline-size:1344px; padding:0 48px; margin-inline:auto; }
+  .intro { display:flex; align-items:flex-end; justify-content:space-between; padding-block:42px 36px; gap:24px; }
+  .workspace { display:grid; grid-template-columns:minmax(0,1fr) 302px; gap:34px; align-items:start; }
+  .render-panel { min-inline-size:0; }
+  .inspector { padding-block-start:2px; }
+  footer { max-inline-size:1248px; margin:0 auto; padding:24px 0 30px; display:flex; justify-content:space-between; gap:16px; border-block-start:1px solid var(--line); color:var(--muted); font-size:11px; }
+}
+@layer components {
+  .brand { display:flex; align-items:center; font-size:27px; font-weight:700; letter-spacing:-1.5px; }
+  .brand-dot { color:var(--green); }
+  .brand-mark { position:relative; display:block; inline-size:29px; block-size:29px; margin-inline-end:10px; border:1.4px solid var(--green); border-radius:50%; transform:rotate(-30deg); overflow:hidden; }
+  .brand-mark i { position:absolute; inset:0 6px; border-inline:1px solid var(--green); border-radius:50%; }
+  .brand-mark i:nth-child(2) { inset:0 11px; }
+  .brand-mark i:nth-child(3) { inset:13px -2px; border-inline:0; border-block-start:1px solid var(--green); border-radius:0; }
+  .header-center { font-family:var(--mono); font-size:9px; letter-spacing:1.8px; color:var(--muted); margin-inline-start:35px; }
+  .source-link { display:flex; align-items:center; gap:10px; font-size:12px; }
+  .source-link .icon { inline-size:14px; }
+  .eyebrow { display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:9px; letter-spacing:1.25px; color:var(--green); }
+  .little-dot { inline-size:5px; block-size:5px; background:var(--green); border-radius:50%; }
+  h1 { margin-block:12px 10px; font-size:clamp(3rem,2rem + 2.9vw,4.5rem); font-weight:500; line-height:1.05; letter-spacing:-3.3px; }
+  h1 em { font-family:'Instrument Serif',Georgia,serif; color:var(--green); font-weight:400; }
+  .intro p { font-size:13px; color:#7a8073; line-height:1.7; }
+  .mobile-break { display:none; }
+  .local-badge { display:flex; align-items:center; gap:7px; border:1px solid var(--line); padding:9px 11px; border-radius:5px; font-size:10px; color:#626b5d; margin-block-end:3px; white-space:nowrap; }
+  .status-dot { display:inline-block; inline-size:6px; block-size:6px; background:#99b78a; border-radius:50%; flex-shrink:0; }
