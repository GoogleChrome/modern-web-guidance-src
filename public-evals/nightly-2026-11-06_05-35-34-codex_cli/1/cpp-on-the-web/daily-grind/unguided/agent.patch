diff --git a/assets/render-worker.js b/assets/render-worker.js
new file mode 100644
index 0000000..d25f693
--- /dev/null
+++ b/assets/render-worker.js
@@ -0,0 +1,36 @@
+importScripts('./smallpt.js');
+self.onmessage = async ({ data: { width, height, samples, seed, colors } }) => {
+  try {
+    const module = await createSmallpt({ locateFile: name => new URL(name, self.location.href).href });
+    module._init_render(width, height, seed);
+    [0, 1, 6, 7].forEach((index, i) => module._set_color(index, ...colors[i]));
+    const passes = samples / 4;
+    const start = performance.now();
+    let lastUpdate = start;
+    for (let pass = 0; pass < passes; pass++) {
+      for (let row = 0; row < height; row += 12) {
+        module._render_rows(row, Math.min(12, height - row), pass);
+        const now = performance.now();
+        const complete = pass === passes - 1 && row + 12 >= height;
+        if (now - lastUpdate > 140 || complete) {
+          const progress = (pass + Math.min(row + 12, height) / height) / passes;
+          // Publish complete passes so the image never contains unrendered rows.
+          const frameReady = row + 12 >= height;
+          let pixels;
+          if (frameReady) {
+            const ptr = module._get_pixels();
+            pixels = module.HEAPU8.slice(ptr, ptr + width * height * 4);
+          }
+          self.postMessage({ progress, elapsed: now - start, samples: (pass + 1) * 4, complete, pixels }, pixels ? [pixels.buffer] : []);
+          lastUpdate = now;
+        } else if (row + 12 >= height) {
+          const ptr = module._get_pixels();
+          const pixels = module.HEAPU8.slice(ptr, ptr + width * height * 4);
+          self.postMessage({ progress: (pass + 1) / passes, elapsed: now - start, samples: (pass + 1) * 4, pixels }, [pixels.buffer]);
+        }
+      }
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
