+(() => {
+  'use strict';
+  const workerURL = new URL('render-worker.js', document.currentScript.src);
+  const $ = id => document.getElementById(id);
+  const canvas = $('render');
+  const context = canvas.getContext('2d');
+  const original = [[.65,.25,.14],[.18,.47,.40],[.91,.94,.88],[.93,.97,.85]];
+  let colors = original.map(color => [...color]);
+  let seed = 1708;
+  let worker;
+  let renderNumber = 0;
+  let hasFrame = false;
+  let quality = 64;
+  const progressBar = document.querySelector('.progress-track');
+  const setProgress = value => {
+    $('progress').style.width = `${value}%`;
+    progressBar.setAttribute('aria-valuenow', String(Math.round(value)));
+  };
+  function updatePalette() {
+    colors.forEach((color, index) => {
+      const rgb = color.map(v => Math.round(Math.pow(v, 1 / 2.2) * 255));
+      const hex = '#' + rgb.map(v => v.toString(16).padStart(2, '0')).join('');
+      $(`swatch-${index}`).style.setProperty('--swatch', hex);
+      $(`swatch-${index}`).title = hex;
+    });
+  }
+  function fail(message) {
+    worker?.terminate();
+    $('status').textContent = message;
+    $('status-orb').classList.remove('busy');
+    document.querySelector('.render-status').classList.add('error');
+    $('stage-label').textContent = 'RENDER UNAVAILABLE';
+  }
+  function render() {
+    worker?.terminate();
+    const thisRender = ++renderNumber;
+    const width = Number($('resolution').value);
+    const height = width * .75;
+    const samples = quality;
+    setProgress(0);
+    $('status').textContent = 'Tracing light…';
+    $('sample-count').textContent = `0 / ${samples} spp`;
+    $('elapsed').textContent = '0.0s';
+    $('status-orb').classList.add('busy');
+    document.querySelector('.render-status').classList.remove('error');
+    $('stage-label').textContent = 'PROGRESSIVE PATH TRACING';
+    if (!('WebAssembly' in window) || !('Worker' in window)) {
+      fail('This browser needs WebAssembly and Web Workers.');
+      return;
+    }
+    try {
+      worker = new Worker(workerURL);
+      worker.onerror = () => fail('Could not load renderer. Please reload to retry.');
+      worker.onmessage = ({ data }) => {
+        if (thisRender !== renderNumber) return;
+        if (data.error) { fail('Rendering failed. Choose a smaller resolution and retry.'); console.error(data.error); return; }
+        if (data.pixels) {
+          if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
+          context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), width, height), 0, 0);
+          canvas.hidden = false;
+          hasFrame = true;
+          $('sample-count').textContent = `${data.samples} / ${samples} spp`;
+        }
+        setProgress(data.progress * 100);
+        $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+        if (data.complete) {
+          $('status').textContent = 'Render complete';
+          $('status-orb').classList.remove('busy');
+          $('stage-label').textContent = 'LIGHT, ONE RAY AT A TIME';
+          worker.terminate();
+        }
+      };
+      worker.postMessage({ width, height, samples, seed, colors });
+    } catch (error) { fail('Could not start renderer. Please reload to retry.'); console.error(error); }
+  }
+  // Muted, complementary wall colors, with lighter tints for the two spheres.
+  function hsv(h, s, v) {
+    const k = n => (n + h * 6) % 6;
+    const f = n => v * (1 - s * Math.max(0, Math.min(k(n), 4 - k(n), 1)));
+    return [f(5), f(3), f(1)];
+  }
+  $('randomize').addEventListener('click', () => {
+    const random = new Uint32Array(4);
+    crypto.getRandomValues(random);
+    seed = random[0];
+    const hue = random[1] / 4294967296;
+    colors = [hsv(hue,.63,.72),hsv((hue+.38+random[2]/4294967296*.2)%1,.54,.65),hsv((hue+.12)%1,.35,.94),hsv((hue+.55)%1,.24,.97)];
+    $('palette-name').textContent = 'PALETTE ' + seed.toString(16).slice(-4).toUpperCase();
+    updatePalette();
+    render();
+  });
+  $('reset').addEventListener('click', () => {
+    colors = original.map(color => [...color]);
+    seed = 1708;
+    $('palette-name').textContent = 'THE ORIGINAL';
+    updatePalette();
+    render();
+  });
+  document.querySelectorAll('[data-samples]').forEach(button => {
+    button.setAttribute('aria-pressed', String(Number(button.dataset.samples) === quality));
+    button.addEventListener('click', () => {
+      quality = Number(button.dataset.samples);
+      $('samples').value = String(quality);
+      document.querySelectorAll('[data-samples]').forEach(option => {
+        const selected = option === button;
+        option.classList.toggle('selected', selected);
+        option.setAttribute('aria-pressed', String(selected));
+      });
+      render();
+    });
+  });
+  $('resolution').addEventListener('change', render);
+  $('download').addEventListener('click', () => {
+    const link = document.createElement('a');
+    link.download = `smallpt-${seed}.png`;
+    if (!hasFrame) {
+      link.href = $('preview').src;
+      link.click();
+      return;
+    }
+    canvas.toBlob(blob => {
+      if (!blob) return;
+      const url = URL.createObjectURL(blob);
+      link.href = url;
+      link.click();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+    }, 'image/png');
+  });
+  $('about-open').addEventListener('click', () => $('about-dialog').showModal());
+  $('about-close').addEventListener('click', () => $('about-dialog').close());
+  $('about-dialog').addEventListener('click', event => { if (event.target === $('about-dialog')) { const rect = event.target.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) event.target.close(); } });
+  window.addEventListener('pagehide', () => worker?.terminate());
+  updatePalette();
+  render();
+})();
