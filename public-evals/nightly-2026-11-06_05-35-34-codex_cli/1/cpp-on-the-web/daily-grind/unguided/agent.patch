+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/smallpt-wasm.cpp -O3 -Wno-c++11-narrowing -Wno-dangling-else -Wno-return-type --no-entry -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=worker,node -s ALLOW_MEMORY_GROWTH=1 -s FILESYSTEM=0 -s EXPORTED_RUNTIME_METHODS=HEAPU8 -s EXPORTED_FUNCTIONS='["_init_render","_set_color","_get_pixels","_render_rows"]' -o assets/smallpt.js
