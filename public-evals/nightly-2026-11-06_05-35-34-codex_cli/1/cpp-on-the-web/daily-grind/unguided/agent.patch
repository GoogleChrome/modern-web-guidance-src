@@ -0,0 +1,39 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const createSmallpt = require('../assets/smallpt.js');
+(async () => {
+  const module = await createSmallpt({ wasmBinary: fs.readFileSync(require.resolve('../assets/smallpt.wasm')) });
+  function render(seed, color) {
+    module._init_render(48, 36, seed);
+    module._set_color(6, ...color);
+    for (let pass = 0; pass < 4; pass++) module._render_rows(0, 36, pass);
+    const ptr = module._get_pixels();
+    return Buffer.from(module.HEAPU8.slice(ptr, ptr + 48 * 36 * 4));
+  }
+  const a = render(42, [.999, .999, .999]);
+  const b = render(42, [.2, .8, .4]);
+  assert.equal(a.length, 48 * 36 * 4);
+  assert(a.some((value, i) => i % 4 !== 3 && value > 0), 'Rendered image must contain light');
+  for (let i = 3; i < a.length; i += 4) assert.equal(a[i], 255);
+  assert(!a.equals(b), 'Changing sphere colors must change the render');
+  assert(a.equals(render(42, [.999, .999, .999])), 'Seeded rendering must be reproducible');
+  const messages = [];
+  const workerContext = {
+    URL, performance,
+    importScripts: () => {},
+    createSmallpt: options => createSmallpt({ ...options, wasmBinary: fs.readFileSync(require.resolve('../assets/smallpt.wasm')) }),
+    self: { location: { href: 'https://example.test/assets/render-worker.js' }, postMessage: message => messages.push(message) }
+  };
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../assets/render-worker.js'), 'utf8'), workerContext);
+  await workerContext.self.onmessage({ data: { width: 48, height: 36, samples: 16, seed: 42, colors: [[.65,.25,.14],[.18,.47,.4],[.91,.94,.88],[.93,.97,.85]] } });
+  assert(messages.every(message => !message.error), 'Worker must not report errors');
+  const last = messages.at(-1);
+  assert.equal(last.complete, true);
+  assert.equal(last.progress, 1);
+  assert.equal(last.samples, 16);
+  assert.equal(last.pixels.length, 48 * 36 * 4);
+  assert(messages.filter(message => message.pixels).length >= 4, 'Worker must publish progressive frames');
+  console.log('WASM and worker checks passed: RGBA frames, color changes, repeatable seeds, progressive updates, and completion.');
+})().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/scripts/render-preview.cjs b/scripts/render-preview.cjs
new file mode 100644
index 0000000..1c91259
--- /dev/null
+++ b/scripts/render-preview.cjs
@@ -0,0 +1,37 @@
+// Render a real smallpt preview through the compiled WASM, without a browser.
+const fs = require('node:fs');
+const zlib = require('node:zlib');
+const path = require('node:path');
+const createSmallpt = require('../assets/smallpt.js');
+function crc32(data) {
+  let crc = 0xffffffff;
+  for (const byte of data) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, data) {
+  const payload = Buffer.concat([Buffer.from(type), data]);
+  const length = Buffer.alloc(4); length.writeUInt32BE(data.length);
+  const crc = Buffer.alloc(4); crc.writeUInt32BE(crc32(payload));
+  return Buffer.concat([length, payload, crc]);
+}
+(async () => {
+  const module = await createSmallpt({ wasmBinary: fs.readFileSync(path.join(__dirname, '../assets/smallpt.wasm')) });
+  const width = 640, height = 480, passes = 64;
+  module._init_render(width, height, 1708);
+  [[.65,.25,.14],[.18,.47,.40],[.91,.94,.88],[.93,.97,.85]].forEach((color,i) => module._set_color([0,1,6,7][i], ...color));
+  for (let pass = 0; pass < passes; pass++) {
+    module._render_rows(0, height, pass);
+    if ((pass + 1) % 16 === 0) console.log(`Preview: ${(pass + 1) * 4} / ${passes * 4} spp`);
+  }
+  const ptr = module._get_pixels();
+  const pixels = module.HEAPU8.slice(ptr, ptr + width * height * 4);
+  const scanlines = Buffer.alloc((width * 4 + 1) * height);
+  for (let y = 0; y < height; y++) scanlines.set(pixels.subarray(y * width * 4, (y + 1) * width * 4), y * (width * 4 + 1) + 1);
+  const header = Buffer.alloc(13);
+  header.writeUInt32BE(width); header.writeUInt32BE(height, 4); header[8] = 8; header[9] = 6;
+  fs.writeFileSync(path.join(__dirname, '../assets/preview.png'), Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',header),chunk('IDAT', zlib.deflateSync(scanlines)),chunk('IEND', Buffer.alloc(0))]));
+  console.log('Wrote assets/preview.png');
+})().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/src/smallpt-wasm.cpp b/src/smallpt-wasm.cpp
new file mode 100644
index 0000000..208030d
--- /dev/null
+++ b/src/smallpt-wasm.cpp
@@ -0,0 +1,50 @@
+// Browser adapter for Kevin Beason's smallpt. See vendor/smallpt/LICENSE.txt.
+// The upstream intersection, materials, and radiance implementation are unchanged.
+#define main smallpt_original_main
+#include "../vendor/smallpt/smallpt.cpp"
+#undef main
+#include <stdint.h>
+#include <string.h>
+
+static int width, height;
+static uint32_t renderSeed;
+static Vec *accumulation = nullptr;
+static unsigned char *pixels = nullptr;
+
+extern "C" {
+void init_render(int w, int h, uint32_t seed) {
+  delete[] accumulation;
+  delete[] pixels;
+  width=w; height=h; renderSeed=seed;
+  accumulation = new Vec[w*h*4]();
+  pixels = new unsigned char[w*h*4]();
+}
+void set_color(int index, double r, double g, double b) {
+  if (index>=0 && index<8) spheres[index].c=Vec(r,g,b);
+}
+unsigned char *get_pixels() { return pixels; }
+// One sample per subpixel per pass: four camera samples per pixel.
+void render_rows(int start, int count, int pass) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int y=start; y<start+count && y<height; ++y) {
+    uint32_t hash=renderSeed ^ ((y+1)*2654435761u) ^ ((pass+1)*2246822519u);
+    unsigned short Xi[3]={(unsigned short)hash,(unsigned short)(hash>>16),(unsigned short)(y*y*y+pass*7919)};
+    for(int x=0; x<width; ++x) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for(int sy=0; sy<2; ++sy) for(int sx=0; sx<2; ++sx) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        Vec &a=accumulation[i*4+sy*2+sx];
+        a=a+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec average=a*(1.0/(pass+1));
+        color=color+Vec(clamp(average.x),clamp(average.y),clamp(average.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z); pixels[i*4+3]=255;
+    }
+  }
+}
+}
