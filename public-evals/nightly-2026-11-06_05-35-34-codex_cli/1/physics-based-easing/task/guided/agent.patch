+    @media (prefers-reduced-motion: no-preference) {
+      .card.spring {
+        /* Damped oscillations overshoot the target, then settle. */
+        --spring-easing: linear(
+          0, 0.12 4%, 0.4 8%, 0.73 12%, 1 16%,
+          1.17 20%, 1.23 24%, 1.21 28%, 1.14 32%,
+          1.06 36%, 1 40%, 0.96 44%, 0.95 48%,
