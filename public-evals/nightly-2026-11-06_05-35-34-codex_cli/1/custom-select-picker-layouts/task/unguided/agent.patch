+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+    let selectedIndex = 1;
+    let activeIndex = selectedIndex;
+
+    function highlight(index) {
+      activeIndex = index;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === index));
+      trigger.setAttribute('aria-activedescendant', options[index].id);
+    }
+
+    function setOpen(open) {
+      menu.hidden = !open;
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) highlight(selectedIndex);
+      else trigger.removeAttribute('aria-activedescendant');
+    }
+
+    function selectRoast(index) {
+      selectedIndex = index;
+      const option = options[index];
+      options.forEach((item, i) => item.setAttribute('aria-selected', String(i === index)));
+      document.getElementById('roast-value').textContent = option.querySelector('strong').textContent;
+      document.getElementById('roast-note').textContent = option.dataset.note;
+      document.getElementById('order-now').href = '/order-online?roast=' + option.dataset.roast;
+      setOpen(false);
+      trigger.focus();
+    }
+
+    trigger.addEventListener('click', () => setOpen(menu.hidden));
+    options.forEach((option, index) => option.addEventListener('click', () => selectRoast(index)));
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') { setOpen(false); return; }
+      if (event.key === 'Tab') { setOpen(false); return; }
+      if (['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        if (menu.hidden) { setOpen(true); return; }
+        if (event.key === 'Home') highlight(0);
+        else if (event.key === 'End') highlight(options.length - 1);
+        else highlight((activeIndex + (['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1) + options.length) % options.length);
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        if (menu.hidden) setOpen(true);
+        else selectRoast(activeIndex);
+      }
+    });
+    document.addEventListener('click', (event) => {
+      if (!picker.contains(event.target)) setOpen(false);
+    });
+    picker.addEventListener('focusout', (event) => {
+      if (!picker.contains(event.relatedTarget)) setOpen(false);
+    });
+  </script>
