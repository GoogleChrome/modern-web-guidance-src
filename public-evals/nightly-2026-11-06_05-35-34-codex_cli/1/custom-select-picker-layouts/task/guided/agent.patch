+  <script>
+    // Preserve the rich three-column menu where customizable selects are unavailable.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('roast');
+      const picker = document.createElement('details');
+      picker.className = 'roast-fallback';
+      const trigger = document.createElement('summary');
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      const options = document.createElement('div');
+      options.className = 'roast-options';
+      options.setAttribute('role', 'radiogroup');
+      options.setAttribute('aria-labelledby', 'roast-label');
+
+      for (const option of select.options) {
+        const card = document.createElement('label');
+        card.className = 'roast-card';
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roast';
+        radio.value = option.value;
+        radio.checked = option.selected;
+        const photo = document.createElement('img');
+        photo.className = 'roast-photo';
+        photo.src = option.dataset.image;
+        photo.alt = '';
+        photo.width = 120;
+        photo.height = 76;
+        const title = document.createElement('span');
+        title.className = 'roast-title';
+        title.textContent = option.dataset.title;
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(photo, title, notes, radio);
+        options.append(card);
+        if (radio.checked) trigger.textContent = title.textContent;
+        radio.addEventListener('change', () => {
+          trigger.textContent = title.textContent;
+          // Keep arrow-key radio navigation open; pointer selection closes below.
+        });
+        radio.addEventListener('click', () => {
+          picker.open = false;
+          trigger.focus();
+        });
+      }
+
+      picker.append(trigger, options);
+      select.replaceWith(picker);
+      document.getElementById('roast-label').removeAttribute('for');
+      picker.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          picker.open = false;
+          trigger.focus();
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!picker.contains(event.target)) picker.open = false;
+      });
+    }
+  </script>
