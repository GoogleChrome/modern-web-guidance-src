+    .customizations {
+      min-width: 0;
+      margin-top: 22px;
+      border: 0;
+      text-align: left;
+    }
+
+    .customizations legend {
+      margin-bottom: 10px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.1em;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .customization {
+      position: relative;
+      display: block;
+      margin-bottom: 8px;
+      cursor: pointer;
+    }
+
+    .customization input {
+      position: absolute;
+      top: 50%;
+      right: 13px;
+      width: 22px;
+      height: 22px;
+      margin: -11px 0 0;
+      opacity: 0;
+      cursor: pointer;
+    }
+
+    .customization-content {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: #fcfaf8;
+      font-size: 0.9rem;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-icon {
+      width: 20px;
+      height: 20px;
+      flex: 0 0 auto;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.6;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .checkbox-mark {
+      display: grid;
+      place-items: center;
+      flex: 0 0 22px;
+      width: 22px;
+      height: 22px;
+      margin-left: auto;
+      border: 2px solid #8b7168;
+      border-radius: 5px;
+      background: white;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .checkbox-mark svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transform: scale(0.7);
+      opacity: 0;
+      transition: stroke-dashoffset 200ms ease, transform 200ms ease, opacity 150ms ease;
+    }
+
+    .customization:hover .customization-content {
+      border-color: #8b7168;
+    }
+
+    .customization input:checked + .customization-content {
+      background: #fff3e0;
+      border-color: #a66a1c;
+    }
+
+    .customization input:checked + .customization-content .checkbox-mark {
+      background: var(--accent);
+      border-color: var(--primary);
+    }
+
+    .customization input:checked + .customization-content .checkbox-mark svg {
+      stroke-dashoffset: 0;
+      transform: scale(1);
+      opacity: 1;
+    }
+
+    .customization input:focus-visible + .customization-content {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization-content,
+      .checkbox-mark,
+      .checkbox-mark svg {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization input {
+        opacity: 1;
+        z-index: 1;
+      }
+
+      .checkbox-mark {
+        visibility: hidden;
+      }
+
+      .customization input:focus-visible + .customization-content {
+        outline-color: Highlight;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
