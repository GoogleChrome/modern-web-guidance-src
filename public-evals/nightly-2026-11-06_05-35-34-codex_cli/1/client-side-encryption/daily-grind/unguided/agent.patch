+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+
+const encoder = new TextEncoder();
+const algorithms = { hybrid: ml_kem768_x25519, pq: ml_kem768 };
+const suiteNames = { hybrid: 'X-Wing/HKDF-SHA-256/AES-256-GCM', pq: 'ML-KEM-768/HKDF-SHA-256/AES-256-GCM' };
+const toBase64 = (bytes) => btoa(String.fromCharCode(...bytes));
+const fromBase64 = (value) => Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
+
+export async function createRecipient(mode) {
+  if (!crypto.subtle || !algorithms[mode]) throw new Error('Encryption requires a secure HTTPS connection and a supported protection mode.');
+  const keys = algorithms[mode].keygen();
+  const keyId = toBase64(new Uint8Array(await crypto.subtle.digest('SHA-256', keys.publicKey)));
+  return { ...keys, keyId, mode };
+}
+
+async function deriveKey(secret, salt, context, usage) {
+  const material = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt, info: encoder.encode(context) },
+    material, { name: 'AES-GCM', length: 256 }, false, [usage],
+  );
+}
+
+export async function encryptNote(note, recipient) {
+  if (!note.trim() || note.length > 500) throw new Error('Please enter a note between 1 and 500 characters.');
+  const { cipherText, sharedSecret } = algorithms[recipient.mode].encapsulate(recipient.publicKey);
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const header = {
+    version: 1,
+    purpose: 'daily-grind/delivery-note',
+    suite: suiteNames[recipient.mode],
+    keyId: recipient.keyId,
+    createdAt: new Date().toISOString(),
+    encapsulation: toBase64(cipherText),
+    salt: toBase64(salt),
+    iv: toBase64(iv),
+  };
+  const additionalData = encoder.encode(JSON.stringify(header));
+  const plaintext = encoder.encode(note);
+  try {
+    const key = await deriveKey(sharedSecret, salt, `${header.purpose}/v1/${header.suite}/${header.keyId}`, 'encrypt');
+    const ciphertext = await crypto.subtle.encrypt({ name: 'AES-GCM', iv, additionalData, tagLength: 128 }, key, plaintext);
+    return { header, ciphertext: toBase64(new Uint8Array(ciphertext)) };
+  } finally {
+    sharedSecret.fill(0);
+    plaintext.fill(0);
+  }
+}
+
+export async function decryptNote(envelope, recipient) {
+  const { header } = envelope;
+  if (header.version !== 1 || header.purpose !== 'daily-grind/delivery-note' || header.suite !== suiteNames[recipient.mode] || header.keyId !== recipient.keyId) {
+    throw new Error('This note does not match the current session.');
+  }
+  const sharedSecret = algorithms[recipient.mode].decapsulate(fromBase64(header.encapsulation), recipient.secretKey);
+  let plaintext;
+  try {
+    const key = await deriveKey(sharedSecret, fromBase64(header.salt), `${header.purpose}/v1/${header.suite}/${header.keyId}`, 'decrypt');
+    plaintext = new Uint8Array(await crypto.subtle.decrypt({
+      name: 'AES-GCM', iv: fromBase64(header.iv),
+      additionalData: encoder.encode(JSON.stringify(header)), tagLength: 128,
+    }, key, fromBase64(envelope.ciphertext)));
+    return new TextDecoder('utf-8', { fatal: true }).decode(plaintext);
+  } finally {
+    sharedSecret.fill(0);
+    plaintext?.fill(0);
+  }
+}
+
+export function destroyRecipient(recipient) {
+  recipient?.secretKey.fill(0);
+}
