+import { createRecipient, encryptNote, decryptNote, destroyRecipient } from './encryption.js';
+
+const $ = (id) => document.getElementById(id);
+const form = $('notes-form');
+const textarea = $('delivery-note');
+const select = $('protection');
+const saveButton = $('save-button');
+const status = $('form-status');
+const revealed = $('revealed-note');
+let recipient = null;
+let envelope = null;
+let busy = false;
+let revealTimer;
+let revision = 0;
+
+function message(text, error = false) {
+  status.textContent = text;
+  status.classList.toggle('error', error);
+}
+function hideNote() {
+  clearTimeout(revealTimer);
+  revealed.textContent = '';
+  revealed.hidden = true;
+  $('reveal-button').textContent = 'Reveal note';
+}
+function deleteNote() {
+  revision++;
+  hideNote();
+  destroyRecipient(recipient);
+  recipient = null;
+  envelope = null;
+  $('saved-note').hidden = true;
+}
+textarea.addEventListener('input', () => {
+  $('note-count').textContent = `${textarea.value.length} / 500`;
+  textarea.removeAttribute('aria-invalid');
+  message('');
+});
+select.addEventListener('change', () => {
+  $('recommended').hidden = select.value !== 'hybrid';
+  message(envelope ? 'The new protection level will apply when you save your next note.' : '');
+});
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  const note = textarea.value;
+  if (!note.trim()) {
+    textarea.setAttribute('aria-invalid', 'true');
+    message('Add a delivery note before encrypting it.', true);
+    textarea.focus();
+    return;
+  }
+  if (!window.isSecureContext || !crypto.subtle) {
+    message('Browser encryption needs HTTPS or localhost. Your note has not been saved.', true);
+    return;
+  }
+  busy = true;
+  const version = revision;
+  saveButton.disabled = true;
+  select.disabled = true;
+  textarea.disabled = true;
+  let nextRecipient;
+  message('Encrypting your note…');
+  try {
+    // Generate a fresh local recipient per save. Never bundle a private key or persist it.
+    nextRecipient = await createRecipient(select.value);
+    const encrypted = await encryptNote(note, nextRecipient);
+    if (version !== revision) return;
+    revision++;
+    destroyRecipient(recipient);
+    recipient = nextRecipient;
+    nextRecipient = null;
+    envelope = encrypted;
+    hideNote();
+    $('saved-note').hidden = false;
+    $('saved-time').textContent = new Date(envelope.header.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+    textarea.value = '';
+    $('note-count').textContent = '0 / 500';
+    message('Your note is encrypted and saved for this tab’s session.');
+  } catch {
+    message('We couldn’t encrypt your note. Nothing new was saved. Please try again on a secure connection.', true);
+  } finally {
+    destroyRecipient(nextRecipient);
+    busy = false;
+    saveButton.disabled = false;
+    select.disabled = false;
+    textarea.disabled = false;
+  }
+});
+$('reveal-button').addEventListener('click', async () => {
+  if (!revealed.hidden) { hideNote(); return; }
+  if (!envelope || !recipient) return;
+  const version = revision;
+  const button = $('reveal-button');
+  button.disabled = true;
+  try {
+    const note = await decryptNote(envelope, recipient);
+    if (version !== revision) return;
+    revealed.textContent = note;
+    revealed.hidden = false;
+    button.textContent = 'Hide note';
+    revealTimer = setTimeout(hideNote, 30000);
+    message('Note revealed. It will hide automatically in 30 seconds.');
+  } catch {
+    hideNote();
+    message('This note could not be authenticated. It may have changed or belong to another session.', true);
+  } finally { button.disabled = false; }
+});
+$('download-button').addEventListener('click', () => {
+  if (!envelope) return;
+  const url = URL.createObjectURL(new Blob([JSON.stringify(envelope, null, 2)], { type: 'application/json' }));
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = 'daily-grind-encrypted-note.json';
+  anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+  message('Encrypted copy downloaded. It cannot be reopened after this tab’s session ends.');
+});
+$('delete-button').addEventListener('click', () => {
+  deleteNote();
+  message('Your encrypted note and its session key have been deleted.');
+});
+const dialog = $('how-dialog');
+$('how-button').addEventListener('click', () => dialog.showModal());
+$('close-dialog').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', (event) => { if (event.target === dialog) {
+  const bounds = dialog.getBoundingClientRect();
+  if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
+} });
+document.addEventListener('visibilitychange', () => { if (document.hidden) hideNote(); });
+window.addEventListener('pagehide', () => {
+  deleteNote();
+  textarea.value = '';
+  $('note-count').textContent = '0 / 500';
+  message('');
+});
