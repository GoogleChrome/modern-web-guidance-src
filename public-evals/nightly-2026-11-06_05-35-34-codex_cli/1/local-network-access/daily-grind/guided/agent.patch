+/* Each card owns its request and permission state. No device requests on load. */
+(() => {
+  function endpointFor(value, device) {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS status URL without credentials or a fragment.');
+    }
+    const host = url.hostname;
+    const octets = host.split('.').map(Number);
+    const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+    const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+    const privateLan = (ipv4 && (octets[0] === 10 || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) || (octets[0] === 192 && octets[1] === 168))) || host.endsWith('.local');
+    if (device === 'helper' ? !loopback : !privateLan) {
+      throw new Error(device === 'helper'
+        ? 'Use a loopback address such as http://127.0.0.1:45678/health or localhost.'
+        : 'Use a private LAN address (192.168.x.x, 10.x.x, 172.16–31.x.x) or a .local hostname.');
+    }
+    return url.href;
+  }
+
+  document.querySelectorAll('[data-device]').forEach(form => {
+    const device = form.dataset.device;
+    const isBrewer = device === 'brewer';
+    const permissionName = isBrewer ? 'local-network' : 'loopback-network';
+    const permissionLabel = isBrewer ? 'Local network' : 'Loopback network';
+    const input = form.querySelector('input');
+    const submit = form.querySelector('[type="submit"]');
+    const disconnect = form.querySelector('[data-disconnect]');
+    const badge = form.querySelector('.connection-badge');
+    const status = form.querySelector('[role="status"]');
+    let permission;
+    let controller;
+    let generation = 0;
+
+    function render(state, message) {
+      form.dataset.state = state;
+      form.setAttribute('aria-busy', String(state === 'connecting'));
+      badge.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Not connected' }[state];
+      status.textContent = message;
+      submit.disabled = state === 'connecting';
+      input.readOnly = state === 'connecting';
+      submit.textContent = state === 'connecting' ? 'Connecting…' : state === 'connected' ? 'Check connection' : `Connect ${device}`;
+      disconnect.hidden = !['connecting', 'connected'].includes(state);
+      disconnect.textContent = state === 'connecting' ? 'Cancel' : 'Disconnect';
+    }
+
+    function reset(message) {
+      generation++;
+      controller?.abort();
+      controller = undefined;
+      render('idle', message);
+    }
+
+    const deniedMessage = () => `${permissionLabel} access is blocked. Open this site’s browser settings, allow ${permissionLabel}, then retry.`;
+
+    // Unsupported permission names must not prevent a user-initiated attempt.
+    async function readPermission() {
+      if (permission) return permission.state;
+      try {
+        permission = await navigator.permissions.query({ name: permissionName });
+        permission.addEventListener('change', () => {
+          if (permission.state === 'denied') {
+            reset(deniedMessage());
+            render('error', deniedMessage());
+          } else if (permission.state === 'prompt') {
+            reset('Network permission changed. Choose Connect to allow access again.');
+          } else if (form.dataset.state !== 'connecting' && form.dataset.state !== 'connected') {
+            render('idle', 'Network access allowed. Choose Connect to check your equipment.');
+          }
+        });
+        return permission.state;
+      } catch {
+        return 'prompt';
+      }
+    }
+
+    disconnect.addEventListener('click', () => reset('Disconnected from this page. Choose Connect whenever you’re ready.'));
+    input.addEventListener('input', () => {
+      input.setCustomValidity('');
+      reset('Address updated. Choose Connect to check this endpoint.');
+    });
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      let endpoint;
+      try {
+        endpoint = endpointFor(input.value.trim(), device);
+      } catch (error) {
+        input.setCustomValidity(error.message);
+        input.reportValidity();
+        return;
+      }
+      if (!window.isSecureContext) {
+        render('error', 'Open this homepage over HTTPS to connect to local equipment.');
+        return;
+      }
+      const attempt = ++generation;
+      controller?.abort();
+      controller = new AbortController();
+      const activeController = controller;
+      render('connecting', `Checking your ${device}… Allow ${permissionLabel} access if your browser asks.`);
+      let timeout;
+      let timedOut = false;
+      try {
+        const state = await readPermission();
+        if (attempt !== generation) return;
+        if (state === 'denied') {
+          render('error', deniedMessage());
+          return;
+        }
+        timeout = setTimeout(() => {
+          timedOut = true;
+          activeController.abort();
+        }, 15000);
+        const response = await fetch(endpoint, {
+          method: 'GET',
+          mode: 'cors',
+          credentials: 'omit',
+          cache: 'no-store',
+          redirect: 'error',
+          referrerPolicy: 'no-referrer',
+          targetAddressSpace: isBrewer ? 'local' : 'loopback',
+          signal: activeController.signal,
+        });
+        if (attempt !== generation) return;
+        // Readability is required; an opaque response cannot confirm a connection.
+        if (!response.ok || response.type === 'opaque') {
+          render('error', `The ${device} returned HTTP ${response.status}. Check the status URL and device configuration, then retry.`);
+          return;
+        }
+        render('connected', `Connection checked at ${new Date().toLocaleTimeString()}. Endpoint responded successfully. Choose Check connection to refresh.`);
+      } catch {
+        if (attempt !== generation) return;
+        const state = await readPermission();
+        if (attempt !== generation) return;
+        render('error', state === 'denied' ? deniedMessage() : `${timedOut ? 'Connection timed out.' : 'Could not connect.'} ${isBrewer ? 'Check that the brewer is on and you’re on the same Wi-Fi.' : 'Check that the helper app is running on this computer and the port is correct.'} Check browser network permissions and endpoint CORS settings; HTTP devices may need a browser with local network support. Then retry.`);
+      } finally {
+        clearTimeout(timeout);
+        if (attempt === generation) controller = undefined;
+      }
+    });
+  });
+})();
