@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { connectionURL, checkConnection } from './connections.mjs';
+
+test('accepts private brewer and loopback helper URLs, including custom ports and paths', () => {
+  for (const address of ['http://192.168.1.100/health', 'https://10.0.0.2:8443/api/health', 'http://172.16.0.2/health', 'http://brewer.local/health', 'http://[fd00::1]/health']) {
+    assert.equal(connectionURL(address, 'brewer').href, new URL(address).href);
+  }
+  for (const address of ['http://127.0.0.1:8080/health', 'http://localhost:3000/health', 'http://[::1]:8080/health']) {
+    assert.equal(connectionURL(address, 'helper').href, new URL(address).href);
+  }
+});
+
+test('rejects public targets, wrong device address spaces, credentials and unsupported schemes', () => {
+  for (const [address, device] of [
+    ['https://example.com/health', 'brewer'], ['http://172.32.0.1/health', 'brewer'],
+    ['http://127.0.0.1/health', 'brewer'], ['http://192.168.1.2/health', 'helper'],
+    ['http://localhost.example.com/health', 'helper'], ['http://user:secret@192.168.1.2/health', 'brewer'],
+    ['ftp://192.168.1.2/health', 'brewer'], ['http://192.168.1.2/health#test', 'brewer'], ['bad URL', 'helper']
+  ]) assert.throws(() => connectionURL(address, device));
+});
+
+test('uses distinct local and loopback fetch options and propagates cancellation', async () => {
+  for (const [device, address, addressSpace] of [
+    ['brewer', 'http://192.168.1.2/health', 'local'],
+    ['helper', 'http://127.0.0.1:8080/health', 'loopback']
+  ]) {
+    const controller = new AbortController();
+    await checkConnection(new URL(address), device, controller.signal, async (url, options) => {
+      assert.equal(url, address);
+      assert.equal(options.targetAddressSpace, addressSpace);
+      assert.equal(options.signal, controller.signal);
+      assert.equal(options.mode, 'cors');
+      assert.equal(options.credentials, 'omit');
+      assert.equal(options.redirect, 'error');
+      assert.equal(options.cache, 'no-store');
+      return new Response('{"status":"ok"}', { status: 200 });
+    });
+  }
+});
+
+test('requires a successful health response rather than any reachable endpoint', async () => {
+  const url = new URL('http://127.0.0.1:8080/health');
+  for (const status of ['ok', 'ready', 'healthy']) {
+    await checkConnection(url, 'helper', undefined, async () => new Response(JSON.stringify({ status })));
+  }
+  for (const [response, error] of [
+    [new Response('', { status: 503 }), /HTTP 503/],
+    [new Response('<html>Not a health endpoint</html>'), /health JSON/],
+    [new Response('{"status":"offline"}'), /not reported ready/],
+    [new Response('null'), /not reported ready/]
+  ]) await assert.rejects(checkConnection(url, 'helper', undefined, async () => response), error);
+  await assert.rejects(checkConnection(url, 'helper', undefined, async () => { throw new TypeError('Network error'); }), /Network error/);
+});
