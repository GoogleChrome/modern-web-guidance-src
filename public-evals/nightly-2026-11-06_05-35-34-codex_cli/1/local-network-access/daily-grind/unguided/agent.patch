+/** Connections are initiated by user gesture; never scan or auto-connect. */
+export function connectionURL(value, device) {
+  let url;
+  try { url = new URL(value); } catch { throw new Error('Enter a complete health URL, including http:// or https://.'); }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without a username, password, or fragment.');
+  }
+  const host = url.hostname;
+  const loopback = host === 'localhost' || host === '[::1]' || /^127\.(\d{1,3}\.){2}\d{1,3}$/.test(host);
+  const parts = host.split('.').map(Number);
+  const privateIPv4 = parts.length === 4 && parts.every(n => Number.isInteger(n) && n >= 0 && n <= 255) &&
+    (parts[0] === 10 || (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) || (parts[0] === 192 && parts[1] === 168));
+  const privateIPv6 = /^\[f[cd][0-9a-f]{2}:/i.test(host);
+  if (device === 'helper' ? !loopback : !(privateIPv4 || privateIPv6 || host.endsWith('.local'))) {
+    throw new Error(device === 'helper'
+      ? 'Use a loopback address such as http://127.0.0.1:8080/health for the helper on this computer.'
+      : 'Use your brewer’s private LAN address, such as http://192.168.1.100/health.');
+  }
+  return url;
+}
+
+export async function checkConnection(url, device, signal, fetcher = fetch) {
+  const response = await fetcher(url.href, {
+    method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+    redirect: 'error', referrerPolicy: 'no-referrer', signal,
+    targetAddressSpace: device === 'helper' ? 'loopback' : 'local'
+  });
+  if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check the health URL and device settings.`);
+  let health;
+  try { health = await response.json(); } catch { throw new Error('The endpoint did not return health JSON. Check the URL and equipment setup below.'); }
+  if (!health || !['ok', 'ready', 'healthy'].includes(health.status)) {
+    throw new Error('The device has not reported ready. Its health response must include status: ok, ready, or healthy.');
+  }
+}
+
+export function setupConnections(root = document) {
+  root.querySelectorAll('[data-device]').forEach(form => {
+    const device = form.dataset.device;
+    const input = form.querySelector('input');
+    const badge = form.querySelector('.status');
+    const message = form.querySelector('.connection-message');
+    const buttonText = form.querySelector('button span');
+    let controller;
+    function render(state, detail) {
+      form.dataset.state = state;
+      input.disabled = state === 'connecting' || state === 'connected';
+      badge.textContent = { disconnected: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection failed' }[state];
+      buttonText.textContent = state === 'connecting' ? 'Cancel connection' : state === 'connected' ? 'Disconnect' : `Connect ${device}`;
+      message.textContent = detail;
+      form.setAttribute('aria-busy', String(state === 'connecting'));
+    }
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (form.dataset.state === 'connecting' || form.dataset.state === 'connected') {
+        controller?.abort();
+        controller = undefined;
+        render('disconnected', 'Disconnected from this page. Connect again whenever you’re ready.');
+        return;
+      }
+      let url;
+      try { url = connectionURL(input.value.trim(), device); }
+      catch (error) { render('error', error.message); input.focus(); return; }
+      if (!globalThis.isSecureContext) {
+        render('error', 'Open this website over HTTPS or localhost to request local device access.');
+        return;
+      }
+      const attempt = new AbortController();
+      controller = attempt;
+      let timedOut = false;
+      const timer = setTimeout(() => { timedOut = true; attempt.abort(); }, 12000);
+      render('connecting', 'Checking availability… Allow local network access if your browser asks.');
+      try {
+        await checkConnection(url, device, attempt.signal);
+        if (controller !== attempt) return;
+        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+        render('connected', `Health verified at ${time}. Disconnect and reconnect to check again.`);
+      } catch (error) {
+        if (controller !== attempt) return;
+        const detail = timedOut
+          ? 'Connection timed out. Check the address, network, and that the device or helper is running.'
+          : error instanceof TypeError
+            ? 'Could not reach the endpoint. Check the address, browser network permissions, and device CORS settings. See setup notes below.'
+            : error.message;
+        render('error', detail);
+      } finally {
+        clearTimeout(timer);
+        if (controller === attempt) controller = undefined;
+      }
+    });
+  });
+}
+
+if (typeof document !== 'undefined') setupConnections();
