@@ -0,0 +1,58 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { diagnosticEndpoint, probeEndpoint } from '../src/utils/diagnostics.ts';
+
+test('accepts private LAN ranges and keeps loopback separate', () => {
+  for (const host of ['192.168.1.42', '10.0.0.2', '172.16.0.1', '172.31.255.254']) {
+    assert.equal(diagnosticEndpoint(`http://${host}:8080/health`, 'local').hostname, host);
+    assert.throws(() => diagnosticEndpoint(`http://${host}/health`, 'loopback'));
+  }
+  for (const host of ['127.0.0.1', 'localhost', '[::1]']) {
+    assert.equal(diagnosticEndpoint(`http://${host}:3001/health`, 'loopback').hostname, host);
+    assert.throws(() => diagnosticEndpoint(`http://${host}/health`, 'local'));
+  }
+});
+
+test('rejects public addresses, invalid URLs, credentials and fragments', () => {
+  for (const value of ['192.168.1.1', 'https://example.com/health', 'http://172.32.0.1/',
+    'http://192.168.1.999/', 'ftp://192.168.1.1/', 'http://user:secret@192.168.1.1/',
+    'http://192.168.1.1/#status']) {
+    assert.throws(() => diagnosticEndpoint(value, 'local'));
+  }
+});
+
+test('checks each address space with readable, credential-free browser requests', async () => {
+  const originalFetch = globalThis.fetch;
+  try {
+    for (const target of ['local', 'loopback']) {
+      const controller = new AbortController();
+      const url = new URL(target === 'local' ? 'http://192.168.1.42/health' : 'http://127.0.0.1:3001/health');
+      globalThis.fetch = async (input, options) => {
+        assert.equal(input, url.href);
+        assert.equal(options.targetAddressSpace, target);
+        assert.equal(options.mode, 'cors');
+        assert.equal(options.method, 'GET');
+        assert.equal(options.credentials, 'omit');
+        assert.equal(options.redirect, 'error');
+        assert.equal(options.signal, controller.signal);
+        return new Response(null, { status: 204 });
+      };
+      assert.equal((await probeEndpoint(url, target, controller.signal)).status, 204);
+    }
+  } finally { globalThis.fetch = originalFetch; }
+});
+
+test('never treats HTTP errors or blocked network requests as a successful connection', async () => {
+  const originalFetch = globalThis.fetch;
+  const url = new URL('http://127.0.0.1:3001/health');
+  try {
+    globalThis.fetch = async () => new Response(null, { status: 503 });
+    await assert.rejects(probeEndpoint(url, 'loopback', new AbortController().signal), /HTTP 503/);
+    globalThis.fetch = async () => { throw new TypeError('Failed to fetch'); };
+    await assert.rejects(probeEndpoint(url, 'loopback', new AbortController().signal), TypeError);
+    globalThis.fetch = async (_url, { signal }) => { signal.throwIfAborted(); };
+    const controller = new AbortController();
+    controller.abort();
+    await assert.rejects(probeEndpoint(url, 'loopback', controller.signal), { name: 'AbortError' });
+  } finally { globalThis.fetch = originalFetch; }
+});
