@@ -0,0 +1,48 @@
+export type ConnectionTarget = 'local' | 'loopback';
+
+/** Keep each connection card scoped to its advertised address space. */
+export function diagnosticEndpoint(value: string, target: ConnectionTarget): URL {
+  let url: URL;
+  try {
+    url = new URL(value.trim());
+  } catch {
+    throw new Error('Enter a complete endpoint URL, including http:// or https://.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname;
+  const octets = host.split('.').map(Number);
+  const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+  const loopback = host === 'localhost' || host === '[::1]' || (ipv4 && octets[0] === 127);
+  const privateLan = ipv4 && (octets[0] === 10 ||
+    (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+    (octets[0] === 192 && octets[1] === 168));
+  if (target === 'loopback' ? !loopback : !privateLan) {
+    throw new Error(target === 'loopback'
+      ? 'Use 127.0.0.1, localhost, or [::1] for the CLI on this machine.'
+      : 'Use a private Wi-Fi IPv4 address: 192.168.x.x, 10.x.x.x, or 172.16–31.x.x.');
+  }
+  return url;
+}
+
+export async function probeEndpoint(url: URL, target: ConnectionTarget, signal: AbortSignal) {
+  // Explicit address spaces let supporting browsers apply Local Network Access
+  // permissions to HTTP endpoints even when this page is served over HTTPS.
+  const options: RequestInit & { targetAddressSpace: ConnectionTarget } = {
+    method: 'GET',
+    mode: 'cors',
+    credentials: 'omit',
+    cache: 'no-store',
+    redirect: 'error',
+    referrerPolicy: 'no-referrer',
+    targetAddressSpace: target,
+    signal,
+  };
+  const start = performance.now();
+  const response = await fetch(url.href, options);
+  // The widget only checks connectivity; never download or render diagnostic data.
+  void response.body?.cancel().catch(() => {});
+  if (!response.ok) throw new Error(`Endpoint responded with HTTP ${response.status}. Check the port and health-check path.`);
+  return { status: response.status, elapsed: Math.round(performance.now() - start) };
+}
