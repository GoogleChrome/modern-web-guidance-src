+import { useEffect, useRef, useState } from 'react';
+import { diagnosticEndpoint, probeEndpoint, type ConnectionTarget } from '../utils/diagnostics';
+
+type State = { phase: 'idle' | 'connecting' | 'success' | 'error'; message: string };
+
+function ConnectionCard({ target, title, description, initialUrl }: {
+  target: ConnectionTarget; title: string; description: string; initialUrl: string;
+}) {
+  const [endpoint, setEndpoint] = useState(initialUrl);
+  const [state, setState] = useState<State>({ phase: 'idle', message: 'Ready when you are.' });
+  const active = useRef<AbortController | null>(null);
+  useEffect(() => () => active.current?.abort(), []);
+  const busy = state.phase === 'connecting';
+
+  async function connect(event: React.FormEvent) {
+    event.preventDefault();
+    if (active.current) return;
+    let url: URL;
+    try {
+      url = diagnosticEndpoint(endpoint, target);
+      if (!window.isSecureContext) throw new Error('Open The DevTools Times over HTTPS (or localhost) to connect to local services.');
+    } catch (error) {
+      setState({ phase: 'error', message: (error as Error).message });
+      return;
+    }
+    const controller = new AbortController();
+    active.current = controller;
+    setState({ phase: 'connecting', message: 'Connecting… Allow browser network access if prompted.' });
+    let timedOut = false;
+    const timeout = window.setTimeout(() => { timedOut = true; controller.abort(); }, 20000);
+    try {
+      const result = await probeEndpoint(url, target, controller.signal);
+      if (active.current === controller) {
+        setState({ phase: 'success', message: `Connection verified · HTTP ${result.status} · ${result.elapsed} ms · ${new Date().toLocaleTimeString()}` });
+      }
+    } catch (error) {
+      if (active.current === controller) {
+        const message = timedOut ? 'Timed out after 20 seconds. Check the service and address, then retry.'
+          : error instanceof TypeError ? 'Could not connect. Check the service, CORS, and browser network permissions. See connection help below.'
+          : error instanceof Error ? error.message : 'Connection failed. Please retry.';
+        setState({ phase: 'error', message });
+      }
+    } finally {
+      window.clearTimeout(timeout);
+      if (active.current === controller) active.current = null;
+    }
+  }
+
+  function cancel() {
+    active.current?.abort();
+    active.current = null;
+    setState({ phase: 'idle', message: 'Connection attempt canceled.' });
+  }
+
+  return (
+    <form onSubmit={connect} className="rounded-lg border border-gray-300 bg-white p-5">
+      <div className="mb-3 flex items-center justify-between gap-3">
+        <h3 className="font-bold text-gray-900">{title}</h3>
+        <span className={`rounded-full px-2.5 py-1 text-xs font-semibold ${state.phase === 'success' ? 'bg-emerald-100 text-emerald-800' : state.phase === 'error' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-600'}`}>
+          {state.phase === 'success' ? 'Verified' : state.phase === 'connecting' ? 'Connecting' : state.phase === 'error' ? 'Needs attention' : 'Not checked'}
+        </span>
+      </div>
+      <p className="mb-4 text-sm text-gray-600">{description}</p>
+      <label htmlFor={`diagnostic-${target}`} className="mb-1.5 block text-xs font-semibold text-gray-700">Health-check endpoint</label>
+      <input id={`diagnostic-${target}`} type="url" required value={endpoint} disabled={busy}
+        onChange={event => { setEndpoint(event.target.value); setState({ phase: 'idle', message: 'Ready when you are.' }); }}
+        spellCheck={false} autoCapitalize="none" autoComplete="off" aria-describedby={`diagnostic-${target}-status`}
+        className="w-full min-w-0 rounded border border-gray-300 bg-gray-50 px-3 py-2.5 font-mono text-sm text-gray-900 outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-200 disabled:opacity-60" />
+      <div className="mt-3 flex gap-2">
+        <button type="submit" disabled={busy} className="rounded bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:opacity-50">
+          {busy ? 'Connecting…' : state.phase === 'success' ? 'Check again' : 'Connect'}
+        </button>
+        {busy && <button type="button" onClick={cancel} className="rounded border border-gray-300 px-4 py-2 text-sm hover:bg-gray-100">Cancel</button>}
+      </div>
+      <p id={`diagnostic-${target}-status`} role="status" aria-live="polite" aria-atomic="true"
+        className={`mt-3 min-h-10 text-xs leading-5 ${state.phase === 'error' ? 'text-red-700' : state.phase === 'success' ? 'text-emerald-800' : 'text-gray-600'}`}>{state.message}</p>
+    </form>
+  );
+}
+
+export default function DiagnosticsConnections() {
+  return (
+    <section aria-labelledby="diagnostics-heading" className="mx-4 my-6 rounded-lg border border-gray-300 bg-gray-50 p-4 sm:mx-6 sm:p-6">
+      <div className="mb-5 border-b border-gray-300 pb-4">
+        <p className="mb-1 text-xs font-bold uppercase tracking-widest text-amber-800">Developer workspace</p>
+        <h2 id="diagnostics-heading" className="font-brand text-3xl text-gray-950">Diagnostics connections</h2>
+        <p className="mt-2 max-w-2xl text-sm leading-6 text-gray-600">Connect your test bench to your browser. Check a device on your Wi-Fi and a companion CLI on this machine, independently.</p>
+      </div>
+      <div className="grid gap-4 md:grid-cols-2">
+        <ConnectionCard target="local" title="Hardware test device" description="Join the same Wi-Fi as your device and enter its private LAN endpoint." initialUrl="http://192.168.1.100:8080/health" />
+        <ConnectionCard target="loopback" title="Local companion CLI" description="Start your companion CLI on this machine and enter its local endpoint." initialUrl="http://127.0.0.1:3001/health" />
+      </div>
+      <p className="mt-4 text-xs leading-5 text-gray-600">Only clicking Connect or Check again sends a request. Each check sends one GET directly from your browser; no credentials are sent and no diagnostic data is stored. A successful check is a snapshot, not a live connection.</p>
+      <details className="mt-4 border-t border-gray-300 pt-3 text-sm text-gray-700">
+        <summary className="cursor-pointer font-semibold hover:text-amber-800">Connection help &amp; service setup</summary>
+        <ul className="mt-3 list-disc space-y-2 pl-5 text-xs leading-5">
+          <li>Replace the example port and /health path with a read-only endpoint that returns HTTP 2xx. Both services can be checked separately.</li>
+          <li>The device must listen on its LAN interface; the CLI should listen on loopback. Check Wi-Fi client isolation, VPN routing, and firewall rules if a service is unreachable.</li>
+          <li>Serve this page over HTTPS. Allow Local network access for the device and Loopback network access for the CLI when your browser prompts. If blocked, update this site’s permissions in browser site settings and retry. Permission names and support vary by browser.</li>
+          <li>Both services must allow this page’s origin with the Access-Control-Allow-Origin response header. Browser permission does not replace CORS. Browsers that block HTTP local endpoints may require a trusted HTTPS endpoint or a browser with Local Network Access support.</li>
+        </ul>
+        <a href="https://developer.chrome.com/docs/modern-web-guidance/guides/security/local-network-access" target="_blank" rel="noreferrer" className="mt-3 inline-block text-xs underline hover:text-amber-800">Browser local-network access guide ↗</a>
+      </details>
+    </section>
+  );
+}
