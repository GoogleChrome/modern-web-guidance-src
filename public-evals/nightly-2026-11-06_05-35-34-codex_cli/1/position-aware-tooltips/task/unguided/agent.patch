@@ -134,8 +134,98 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      anchor-name: --latte-info;
+      display: inline-grid;
+      place-items: center;
+      width: 32px;
+      height: 32px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .latte-tooltip {
+      position: fixed;
+      position-anchor: --latte-info;
+      position-area: top;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      container-name: latte-tooltip;
+      inset: auto;
+      width: min(260px, calc(100vw - 32px));
+      margin: 0;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      font-size: 0.875rem;
+      text-align: left;
+    }
+
+    /* Query descendants: the anchored container cannot query itself. */
+    .tooltip-content {
+      position: relative;
+      display: block;
+      margin: 0 0 12px;
+      padding: 12px 16px;
+      border-radius: 12px 12px 4px 12px;
+      background: var(--primary);
+      box-shadow: 0 4px 12px rgb(0 0 0 / 18%);
+    }
+
+    .tooltip-content::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border: 8px solid transparent;
+      border-bottom: 0;
+      border-top-color: var(--primary);
+    }
+
+    @container latte-tooltip anchored(fallback: flip-block) {
+      .tooltip-content {
+        margin: 12px 0 0;
+        border-radius: 4px 12px 12px 12px;
+      }
+
+      .tooltip-content::after {
+        top: auto;
+        bottom: 100%;
+        border-top: 0;
+        border-bottom: 8px solid var(--primary);
+      }
+    }
+
     footer {
