+  <script>
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const banner = document.querySelector('.roast-banner');
+    const track = document.querySelector('.roast-track');
+    const toggle = document.querySelector('.roast-toggle');
+    let userPaused = false;
+
+    function updateRoastMotion() {
+      const reduced = motionPreference.matches;
+      const paused = userPaused || reduced;
+      banner.dataset.paused = String(paused);
+      toggle.disabled = reduced;
+      toggle.textContent = reduced ? 'Motion off' : paused ? 'Resume' : 'Pause';
+      toggle.setAttribute('aria-pressed', String(paused));
+      toggle.setAttribute('aria-label', reduced ? 'Daily roast animation disabled by reduced motion preference' : `${paused ? 'Resume' : 'Pause'} daily roast animation`);
+      const animation = track.getAnimations()[0];
+      document.body.dataset.lastAnimationState = animation ? animation.playState : 'idle';
+    }
+    toggle.addEventListener('click', () => {
+      userPaused = !userPaused;
+      updateRoastMotion();
+    });
+    motionPreference.addEventListener('change', () => {
+      updateRoastMotion();
+      if (closing) finishClose();
+    });
+
+    // Some event sources expose the Animation directly. Native CSS events
+    // generally expose its name/property instead, so resolve that animation.
+    function recordAnimationState(event) {
+      const animation = event.animation ?? event.target.getAnimations().find(candidate =>
+        (event.animationName && candidate.animationName === event.animationName) ||
+        (event.propertyName && candidate.transitionProperty === event.propertyName)
+      );
+      const ended = event.type === 'animationend' || event.type === 'transitionend';
+      const cancelled = event.type === 'animationcancel' || event.type === 'transitioncancel';
+      document.body.dataset.lastAnimationState = animation?.playState ?? (cancelled ? 'idle' : ended ? 'finished' : 'running');
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState);
+    }
+
+    const drinks = {
+      maple: { name: 'Maple Oat Latte', description: 'Espresso meets creamy oat milk and a hint of Vermont maple syrup. A gently sweet, comforting cup for a slower morning.', notes: 'Maple · toasted oats', served: 'Hot or iced' },
+      espresso: { name: 'Dark Roast Espresso', description: 'A rich, full-bodied espresso with a bold, smoky finish. Enjoy a concentrated morning boost, crafted one shot at a time.', notes: 'Dark cocoa · smoky finish', served: 'Hot' },
+      'cold-brew': { name: 'Cold Brew', description: 'Slow-steeped for 18 hours for a smooth, mellow coffee. Poured over ice for an easy, refreshing pick-me-up.', notes: 'Smooth · mellow', served: 'Over ice' }
+    };
+    const dialog = document.querySelector('.drink-dialog');
+    let closing = false;
+    let closeTimer;
+    let opener;
+
+    function finishClose() {
+      clearTimeout(closeTimer);
+      dialog.close();
+      dialog.classList.remove('is-closing');
+      closing = false;
+      opener?.focus({ preventScroll: true });
+    }
+    function closeDetails() {
+      if (!dialog.open || closing) return;
+      closing = true;
+      if (motionPreference.matches) return finishClose();
+      dialog.classList.add('is-closing');
+      // Keep dismissal reliable if CSS animations are interrupted or unavailable.
+      closeTimer = setTimeout(finishClose, 300);
+    }
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        opener = button;
+        document.querySelector('#drink-title').textContent = drink.name;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-served').textContent = drink.served;
+        dialog.showModal();
+      });
+    });
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => { event.preventDefault(); closeDetails(); });
+    let backdropPointer = false;
+    function outsideDialog(event) {
+      const rect = dialog.getBoundingClientRect();
+      return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
+    }
+    dialog.addEventListener('pointerdown', event => { backdropPointer = event.target === dialog && outsideDialog(event); });
+    dialog.addEventListener('click', event => {
+      if (backdropPointer && event.target === dialog && outsideDialog(event)) closeDetails();
+      backdropPointer = false;
+    });
+    dialog.addEventListener('animationend', event => {
+      if (event.target === dialog && !event.pseudoElement && event.animationName === 'dialog-out' && closing) finishClose();
+    });
+    updateRoastMotion();
+  </script>
 </body>
 
