+<script>
+    // Prefer the exact animation supplied by the event, including pseudo-elements.
+    // Older engines don't expose event.animation; keep lifecycle reporting useful there.
+    function recordAnimationState(event) {
+      const animation = event.animation;
+      const fallbackStates = {
+        animationstart: 'running', animationiteration: 'running', animationend: 'finished', animationcancel: 'idle',
+        transitionrun: 'running', transitionstart: 'running', transitionend: 'finished', transitioncancel: 'idle'
+      };
+      document.body.dataset.lastAnimationState = animation?.playState ?? fallbackStates[event.type];
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState);
+    }
+
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const banner = document.querySelector('.roast-banner');
+    const toggle = document.querySelector('.roast-toggle');
+    let userPaused = false;
+    function updateRoastMotion() {
+      const reduced = motionPreference.matches;
+      const paused = userPaused || reduced;
+      banner.dataset.paused = String(paused);
+      toggle.disabled = reduced;
+      toggle.textContent = reduced ? 'Motion off' : userPaused ? 'Resume' : 'Pause';
+      toggle.setAttribute('aria-pressed', String(paused));
+      toggle.setAttribute('aria-label', reduced ? 'Daily roast animation off: reduced motion preference' :
+        `${userPaused ? 'Resume' : 'Pause'} daily roast animation`);
+      document.body.dataset.lastAnimationState = paused ? 'paused' : 'running';
+    }
+    toggle.addEventListener('click', () => { userPaused = !userPaused; updateRoastMotion(); });
+    motionPreference.addEventListener('change', updateRoastMotion);
+    updateRoastMotion();
+
+    const drinks = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk meets rich espresso and a hint of Vermont maple syrup. A cozy, gently sweet cup for slow mornings.',
+        notes: 'Tasting notes: maple, toasted oats, caramel. Made with oat milk.',
+        href: '/menu/seasonal'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'A concentrated shot of our dark roast: bold, smoky, and full-bodied, with a rich crema and a lingering finish.',
+        notes: 'Tasting notes: dark cocoa, toasted nuts, smoky finish. Served as an espresso.',
+        href: '/menu/espresso'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours to bring out deep coffee flavor with a mellow finish. Smooth, refreshing, and poured over ice.',
+        notes: 'Tasting notes: cocoa, subtle sweetness, smooth finish. Served chilled.',
+        href: '/menu/cold-brew'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    for (const button of document.querySelectorAll('[data-drink]')) {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-menu').href = drink.href;
+        dialog.showModal();
+      });
+    }
+
+    // Hold the native modal in the top layer until exit effects settle. This also
+    // supports engines that parse allow-discrete but cannot transition display/overlay.
+    async function closeDetails() {
+      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+      dialog.setAttribute('data-closing', '');
+      const effects = dialog.getAnimations({ subtree: true });
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(effects.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 800); })
+      ]);
+      clearTimeout(timeout);
+      dialog.close();
+      dialog.removeAttribute('data-closing');
+    }
+    dialog.querySelector('.detail-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => { event.preventDefault(); closeDetails(); });
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = event => {
+        const rect = dialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', event => { pressedOutside = outside(event); });
+      dialog.addEventListener('pointerup', event => {
+        if (pressedOutside && outside(event)) closeDetails();
+        pressedOutside = false;
+      });
+      dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+    }
+  </script>
