diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..bc3528c
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,202 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type TranslationSession = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }) => void;
+  }): Promise<TranslationSession>;
+};
+
+const getAPI = () => (window as Window & { Translator?: TranslatorAPI }).Translator;
+
+// Work on text nodes, never HTML: links, formatting, images and event handlers survive.
+export function getTranslationText(roots: HTMLElement[]) {
+  const entries: { node: Text; original: string }[] = [];
+  for (const root of roots) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        return node.textContent?.trim() && !node.parentElement?.closest('script, style, pre, code, [translate="no"], article-translation')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      },
+    });
+    while (walker.nextNode()) {
+      const node = walker.currentNode as Text;
+      entries.push({ node, original: node.data });
+    }
+  }
+  return entries;
+}
+
+class ArticleTranslation extends HTMLElement {
+  private scope!: HTMLElement;
+  private select!: HTMLSelectElement;
+  private start!: HTMLButtonElement;
+  private restore!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private progress!: HTMLProgressElement;
+  private roots: { element: HTMLElement; lang: string | null; dir: string | null }[] = [];
+  private originals: ReturnType<typeof getTranslationText> = [];
+  private pair?: LanguagePair;
+  private checkVersion = 0;
+  private runVersion = 0;
+  private session?: TranslationSession;
+  private abort?: AbortController;
+  private listeners?: AbortController;
+
+  connectedCallback() {
+    this.scope = this.closest<HTMLElement>('[data-translation-scope]')!;
+    if (!this.scope || this.listeners) return;
+    this.listeners = new AbortController();
+    const options = { signal: this.listeners.signal };
+    this.select = this.querySelector('select')!;
+    this.start = this.querySelector('[data-translate-start]')!;
+    this.restore = this.querySelector('[data-translate-restore]')!;
+    this.status = this.querySelector('[data-translate-status]')!;
+    this.progress = this.querySelector('progress')!;
+    this.querySelector('details')!.addEventListener('toggle', () => {
+      if (this.querySelector('details')!.open && !this.abort) void this.checkAvailability();
+    }, options);
+    this.select.addEventListener('change', () => void this.checkAvailability(), options);
+    this.start.addEventListener('click', () => void this.translateArticle(), options);
+    this.restore.addEventListener('click', () => this.showOriginal(), options);
+    if (!getAPI()) {
+      this.select.disabled = true;
+      this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser. The original English text is available.';
+    }
+  }
+
+  disconnectedCallback() {
+    this.checkVersion++;
+    this.cancel();
+    this.listeners?.abort();
+    this.listeners = undefined;
+  }
+
+  private async checkAvailability() {
+    const api = getAPI();
+    if (!api) return;
+    const version = ++this.checkVersion;
+    this.pair = undefined;
+    this.start.disabled = true;
+    this.status.textContent = 'Checking language pair…';
+    const pair = { sourceLanguage: 'en', targetLanguage: this.select.value };
+    try {
+      const availability = await api.availability(pair);
+      if (version !== this.checkVersion || !this.isConnected) return;
+      if (availability === 'unavailable') {
+        this.status.textContent = 'This language pair is unavailable on your device. Choose another language.';
+        return;
+      }
+      this.pair = pair;
+      this.start.disabled = false;
+      this.status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'Select Translate to download or finish downloading the language pack.';
+    } catch {
+      if (version === this.checkVersion && this.isConnected) {
+        this.status.textContent = 'Unable to check translation support. Choose a language to try again.';
+      }
+    }
+  }
+
+  private async translateArticle() {
+    const api = getAPI();
+    if (!api || !this.pair || this.abort) return;
+    const pair = this.pair;
+    const version = ++this.runVersion;
+    const abort = this.abort = new AbortController();
+    this.start.disabled = true;
+    this.select.disabled = true;
+    this.restore.hidden = false;
+    this.restore.textContent = 'Cancel / Show original';
+    this.scope.setAttribute('aria-busy', 'true');
+    this.status.textContent = 'Preparing on-device translation…';
+    try {
+      // Availability was checked before the click, so create retains user activation.
+      const pending = api.create({
+        ...pair,
+        signal: abort.signal,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (version !== this.runVersion || !this.isConnected) return;
+          this.progress.hidden = false;
+          this.progress.value = event.loaded;
+          this.status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%`;
+        }),
+      });
+      const session = await pending;
+      if (version !== this.runVersion || !this.isConnected) {
+        session.destroy();
+        return;
+      }
+      this.session = session;
+      this.progress.hidden = true;
+      if (!this.originals.length) {
+        const roots = Array.from(this.scope.querySelectorAll<HTMLElement>('[data-translate]'))
+          .filter(root => root.closest('[data-translation-scope]') === this.scope);
+        this.roots = roots.map(element => ({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') }));
+        this.originals = getTranslationText(roots);
+      }
+      const translated: string[] = [];
+      for (const [index, entry] of this.originals.entries()) {
+        this.status.textContent = `Translating ${index + 1} of ${this.originals.length}…`;
+        translated.push(await session.translate(entry.original));
+        if (version !== this.runVersion || !this.isConnected) return;
+      }
+      // Commit only a completed translation; errors leave the current text intact.
+      this.originals.forEach((entry, index) => { entry.node.data = translated[index]; });
+      this.roots.forEach(({ element }) => {
+        element.lang = pair.targetLanguage;
+        element.dir = pair.targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      });
+      const language = this.select.selectedOptions[0].textContent;
+      this.status.textContent = `Translated to ${language} on your device.`;
+    } catch {
+      if (version === this.runVersion && this.isConnected) {
+        this.status.textContent = 'Translation could not finish. Your text has been kept. Check your connection for language pack downloads, then try again.';
+      }
+    } finally {
+      if (version === this.runVersion) {
+        this.session?.destroy();
+        this.session = undefined;
+        this.abort = undefined;
+        this.progress.hidden = true;
+        this.select.disabled = false;
+        this.start.disabled = false;
+        this.restore.textContent = 'Show original';
+        this.scope.removeAttribute('aria-busy');
+      }
+    }
+  }
+
+  private cancel() {
+    this.runVersion++;
+    this.abort?.abort();
+    this.session?.destroy();
+    this.abort = undefined;
+    this.session = undefined;
+    this.scope?.removeAttribute('aria-busy');
+  }
+
+  private showOriginal() {
+    this.cancel();
+    this.originals.forEach(({ node, original }) => { node.data = original; });
+    this.roots.forEach(({ element, lang, dir }) => {
+      if (lang === null) element.removeAttribute('lang'); else element.lang = lang;
+      if (dir === null) element.removeAttribute('dir'); else element.dir = dir;
+    });
+    this.select.disabled = false;
+    this.start.disabled = !this.pair;
+    this.restore.hidden = true;
+    this.progress.hidden = true;
+    this.status.textContent = 'Showing the original English text.';
+  }
+}
+
+if (!customElements.get('article-translation')) {
+  customElements.define('article-translation', ArticleTranslation);
+}
diff --git a/tests/article-translation.test.mjs b/tests/article-translation.test.mjs
new file mode 100644
index 0000000..2614b76
--- /dev/null
+++ b/tests/article-translation.test.mjs
@@ -0,0 +1,166 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { afterEach, test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window();
+for (const key of ['window', 'document', 'HTMLElement', 'NodeFilter', 'customElements']) {
+  globalThis[key] = key === 'window' ? window : window[key];
+}
+await import('../src/scripts/article-translation.ts');
+const markup = (await readFile(new URL('../src/components/TranslationControl.astro', import.meta.url), 'utf8')).split('<script>')[0];
+
+function fixture(api) {
+  window.Translator = api;
+  const scope = document.createElement('article');
+  scope.setAttribute('data-translation-scope', '');
+  scope.innerHTML = `<h1 data-translate>Original title</h1>
+    <div data-translate><p>Read <a href="/article">this story</a>.</p><pre>const x = 1</pre><span translate="no">Brand</span></div>
+    ${markup}`;
+  // Set explicitly: the DOM emulator does not reliably honor parsed selected options.
+  scope.querySelector('select').value = 'es';
+  document.body.append(scope);
+  return scope;
+}
+const flush = () => new Promise(resolve => setImmediate(resolve));
+async function ready(scope) {
+  const details = scope.querySelector('details');
+  details.open = true;
+  details.dispatchEvent(new window.Event('toggle'));
+  await flush();
+}
+function select(scope, value) {
+  const control = scope.querySelector('select');
+  control.value = value;
+  control.dispatchEvent(new window.Event('change'));
+}
+const start = scope => scope.querySelector('[data-translate-start]');
+const restore = scope => scope.querySelector('[data-translate-restore]');
+const status = scope => scope.querySelector('[data-translate-status]').textContent;
+
+afterEach(() => document.body.replaceChildren());
+
+test('unsupported browser and unavailable pairs leave the original readable', async () => {
+  const unsupported = fixture(undefined);
+  assert.equal(start(unsupported).disabled, true);
+  assert.equal(unsupported.querySelector('select').disabled, true);
+  assert.match(status(unsupported), /unavailable in this browser/);
+  const unavailable = fixture({ availability: async () => 'unavailable' });
+  await ready(unavailable);
+  assert.equal(start(unavailable).disabled, true);
+  assert.match(status(unavailable), /language pair is unavailable/);
+  assert.equal(unavailable.querySelector('h1').textContent, 'Original title');
+});
+
+test('translation preserves markup, skips code, restores exactly, and uses English for each target', async () => {
+  const inputs = [];
+  const pairs = [];
+  let destroyed = 0;
+  const scope = fixture({
+    availability: async pair => { pairs.push(pair); return 'downloadable'; },
+    create: async options => {
+      assert.equal(options.sourceLanguage, pairs.at(-1).sourceLanguage);
+      assert.equal(options.targetLanguage, pairs.at(-1).targetLanguage);
+      options.monitor({ addEventListener: (_, listener) => listener({ loaded: 0.5 }) });
+      assert.match(status(scope), /50%/);
+      return {
+        translate: async text => { inputs.push(text); return `${options.targetLanguage}:${text}`; },
+        destroy: () => destroyed++,
+      };
+    },
+  });
+  const original = scope.querySelector('[data-translate] + div').innerHTML;
+  const link = scope.querySelector('a');
+  await ready(scope);
+  start(scope).click();
+  await flush();
+  assert.equal(scope.querySelector('h1').textContent, 'es:Original title');
+  assert.equal(scope.querySelector('a'), link);
+  assert.equal(link.getAttribute('href'), '/article');
+  assert.equal(scope.querySelector('pre').textContent, 'const x = 1');
+  assert.equal(scope.querySelector('[translate="no"]').textContent, 'Brand');
+  select(scope, 'ar');
+  await flush();
+  start(scope).click();
+  await flush();
+  assert.equal(scope.querySelector('h1').textContent, 'ar:Original title');
+  assert.equal(scope.querySelector('h1').dir, 'rtl');
+  assert.ok(!inputs.some(text => text.startsWith('es:')));
+  assert.equal(destroyed, 2);
+  restore(scope).click();
+  assert.equal(scope.querySelector('h1').textContent, 'Original title');
+  assert.equal(scope.querySelector('h1').hasAttribute('lang'), false);
+  assert.equal(scope.querySelector('[data-translate] + div').innerHTML, original);
+});
+
+test('a failure halfway through translation never partially replaces content', async () => {
+  let count = 0;
+  const scope = fixture({
+    availability: async () => 'available',
+    create: async () => ({
+      translate: async () => { if (++count === 2) throw new Error('failed'); return 'Translated'; },
+      destroy() {},
+    }),
+  });
+  await ready(scope);
+  start(scope).click();
+  await flush();
+  assert.equal(scope.querySelector('h1').textContent, 'Original title');
+  assert.match(status(scope), /could not finish/);
+  assert.equal(start(scope).disabled, false);
+  assert.equal(scope.hasAttribute('aria-busy'), false);
+});
+
+test('cancel prevents late translation results from overwriting the original', async () => {
+  let resolve;
+  let destroyed = 0;
+  const scope = fixture({
+    availability: async () => 'available',
+    create: async () => ({
+      translate: () => new Promise(done => { resolve = done; }),
+      destroy: () => destroyed++,
+    }),
+  });
+  await ready(scope);
+  start(scope).click();
+  await flush();
+  restore(scope).click();
+  resolve('Late translation');
+  await flush();
+  assert.equal(scope.querySelector('h1').textContent, 'Original title');
+  assert.equal(scope.hasAttribute('aria-busy'), false);
+  assert.equal(destroyed, 1);
+});
+
+test('stale availability responses cannot enable an unavailable selection', async () => {
+  let resolve;
+  const scope = fixture({
+    availability: pair => pair.targetLanguage === 'es'
+      ? new Promise(done => { resolve = done; }) : Promise.resolve('unavailable'),
+  });
+  await ready(scope);
+  select(scope, 'fr');
+  await flush();
+  resolve('available');
+  await flush();
+  assert.equal(start(scope).disabled, true);
+  assert.match(status(scope), /language pair is unavailable/);
+});
+
+test('navigation aborts pending creation and destroys late sessions', async () => {
+  let resolve;
+  let signal;
+  let destroyed = 0;
+  const scope = fixture({
+    availability: async () => 'available',
+    create: options => { signal = options.signal; return new Promise(done => { resolve = done; }); },
+  });
+  await ready(scope);
+  start(scope).click();
+  scope.remove();
+  assert.equal(signal.aborted, true);
+  resolve({ translate: async () => 'Late', destroy: () => destroyed++ });
+  await flush();
+  assert.equal(destroyed, 1);
+  assert.equal(scope.querySelector('h1').textContent, 'Original title');
+});
