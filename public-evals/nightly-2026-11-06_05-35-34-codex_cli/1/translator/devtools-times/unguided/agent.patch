+---
+const isArticle = Astro.url.pathname.includes('/articles/');
+---
+<aside class="translation-bar" aria-label="Article translation">
+  <div class="translation-intro">
+    <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 8 6 0M8 5v3c0 5-3 8-6 9m2-6c1 3 4 5 7 6m2 2 4-11 4 11m-6.5-4h5"/></svg>
+    <div><strong>Read in your language</strong><span>On-device translation · Your reading stays private</span></div>
+  </div>
+  <form class="translation-actions">
+    <label class="sr-only" for="translation-language">Translate into</label>
+    <select id="translation-language" name="language">
+      <option value="en">English — original</option>
+      <option value="es" selected>Español</option>
+      <option value="fr">Français</option>
+      <option value="de">Deutsch</option>
+      <option value="it">Italiano</option>
+      <option value="pt">Português</option>
+      <option value="nl">Nederlands</option>
