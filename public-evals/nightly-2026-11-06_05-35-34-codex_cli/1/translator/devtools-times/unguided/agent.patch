+  .translation-actions { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
+  select { background:white; border:1px solid #d8d1c0; border-radius:4px; padding:9px 28px 9px 10px; font-size:12px; min-width:132px; }
+  button { font-size:12px; font-weight:600; border-radius:4px; padding:10px 14px; cursor:pointer; }
+  .translation-submit { background:#292b27; color:white; }
+  .translation-submit:hover { background:#505044; }
+  .translation-restore { color:#665126; text-decoration:underline; text-underline-offset:3px; }
+  [hidden] { display:none; }
+  button:disabled, select:disabled { opacity:.55; cursor:default; }
+  :is(button, select):focus-visible { outline:2px solid #94732d; outline-offset:3px; }
+  .translation-status { width:100%; font-size:11px; color:#777363; margin:0; }
+  @media(max-width:640px) { .translation-bar { padding:16px; } .translation-actions { width:100%; } select { flex:1; } }
+</style>
