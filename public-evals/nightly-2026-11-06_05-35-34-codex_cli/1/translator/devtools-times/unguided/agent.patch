diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..1b35bb5
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,178 @@
+type TranslatorSession = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<string>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal: AbortSignal;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<TranslatorSession>;
+};
+
+export function initializeTranslation() {
+  const bar = document.querySelector<HTMLElement>('.translation-bar');
+  if (!bar || bar.dataset.initialized) return;
+  bar.dataset.initialized = 'true';
+  const form = bar.querySelector('form')!;
+  const language = bar.querySelector('select')!;
+  const submit = bar.querySelector<HTMLButtonElement>('.translation-submit')!;
+  const restore = bar.querySelector<HTMLButtonElement>('.translation-restore')!;
+  const status = bar.querySelector<HTMLElement>('.translation-status')!;
+  const defaultLabel = submit.textContent!;
+  const api = window.isSecureContext ? (window as unknown as { Translator?: TranslatorAPI }).Translator : undefined;
+  const regions = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]'));
+  const originals: { node: Text; text: string }[] = [];
+  const attributes = regions.map(element => ({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') }));
+  for (const region of regions) {
+    const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        return node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, [translate="no"]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      },
+    });
+    while (walker.nextNode()) originals.push({ node: walker.currentNode as Text, text: walker.currentNode.textContent! });
+  }
+
+  let revision = 0;
+  let availabilityRevision = 0;
+  let currentLanguage = 'en';
+  let session: TranslatorSession | undefined;
+  let controller: AbortController | undefined;
+  let busy = false;
+
+  function stop() {
+    revision++;
+    controller?.abort();
+    session?.destroy();
+    session = undefined;
+    busy = false;
+    language.disabled = false;
+    submit.disabled = !api;
+    submit.textContent = defaultLabel;
+    regions.forEach(region => region.removeAttribute('aria-busy'));
+  }
+
+  function showOriginal() {
+    stop();
+    originals.forEach(({ node, text }) => { node.textContent = text; });
+    attributes.forEach(({ element, lang, dir }) => {
+      if (lang === null) element.removeAttribute('lang'); else element.lang = lang;
+      if (dir === null) element.removeAttribute('dir'); else element.dir = dir;
+    });
+    currentLanguage = 'en';
+    restore.hidden = true;
+    status.textContent = 'Showing the original English edition.';
+  }
+
+  async function checkAvailability() {
+    const id = ++availabilityRevision;
+    const targetLanguage = language.value;
+    submit.disabled = !api;
+    if (!api || busy) return;
+    if (targetLanguage === 'en') {
+      status.textContent = 'English is the original language. Select Translate to restore it.';
+      return;
+    }
+    try {
+      const availability = await api.availability({ sourceLanguage: 'en', targetLanguage });
+      if (id !== availabilityRevision || busy) return;
+      submit.disabled = availability === 'unavailable';
+      status.textContent = availability === 'unavailable'
+        ? 'This language is not available on your device. Choose another language.'
+        : availability === 'available'
+          ? 'Ready to translate on your device. AI translations can make mistakes.'
+          : 'A language pack will download when you translate. Translation runs on your device.';
+    } catch {
+      // Creation can still succeed if an availability check fails.
+      if (id === availabilityRevision && !busy) status.textContent = 'Select Translate to try this language on your device.';
+    }
+  }
+
+  async function translate(event: SubmitEvent) {
+    event.preventDefault();
+    if (busy) return;
+    if (language.value === 'en') { showOriginal(); return; }
+    if (!api) return;
+    const targetLanguage = language.value;
+    const id = ++revision;
+    ++availabilityRevision;
+    controller = new AbortController();
+    busy = true;
+    language.disabled = true;
+    submit.disabled = true;
+    submit.textContent = 'Translating…';
+    restore.hidden = false;
+    restore.textContent = 'Cancel / show original';
+    regions.forEach(region => region.setAttribute('aria-busy', 'true'));
+    status.textContent = 'Preparing on-device translation…';
+    let translator: TranslatorSession | undefined;
+    try {
+      // Called directly from the submit gesture so the browser can authorize a language download.
+      translator = await api.create({
+        sourceLanguage: 'en', targetLanguage, signal: controller.signal,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (id !== revision) return;
+            const loaded = (event as Event & { loaded: number }).loaded;
+            status.textContent = `Downloading language pack… ${Math.round(loaded * 100)}%`;
+          });
+        },
+      });
+      if (id !== revision) return;
+      session = translator;
+      const translated: string[] = [];
+      // Always translate the English snapshot, preventing quality loss on repeated language changes.
+      for (const { text } of originals) {
+        if (id !== revision) return;
+        const result = await translator.translate(text.trim());
+        translated.push(text.replace(/\S[\s\S]*\S|\S/, () => result));
+        if (id !== revision) return;
+        status.textContent = `Translating… ${Math.round(translated.length / originals.length * 100)}%`;
+      }
+      if (id !== revision) return;
+      originals.forEach(({ node }, index) => { node.textContent = translated[index]; });
+      regions.forEach(region => { region.lang = targetLanguage; region.dir = targetLanguage === 'ar' ? 'rtl' : 'ltr'; });
+      currentLanguage = targetLanguage;
+      status.textContent = `Translated into ${language.selectedOptions[0].textContent} on your device. AI translations can make mistakes.`;
+    } catch (error) {
+      if (id !== revision) return;
+      const name = error instanceof Error ? error.name : '';
+      status.textContent = name === 'NotSupportedError'
+        ? 'This language is not supported on your device. Choose another language.'
+        : 'Translation could not finish. Check your connection for language downloads and try again. Your text has been kept.';
+    } finally {
+      translator?.destroy();
+      if (id === revision) {
+        session = undefined;
+        controller = undefined;
+        busy = false;
+        language.disabled = false;
+        submit.disabled = false;
+        submit.textContent = defaultLabel;
+        restore.textContent = 'Show original';
+        restore.hidden = currentLanguage === 'en';
+        regions.forEach(region => region.removeAttribute('aria-busy'));
+      }
+    }
+  }
+
+  form.addEventListener('submit', translate);
+  restore.addEventListener('click', showOriginal);
+  language.addEventListener('change', checkAvailability);
+  if (!api || !window.isSecureContext) {
+    submit.disabled = true;
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, over HTTPS.';
+  } else {
+    void checkAvailability();
+  }
+  document.addEventListener('astro:before-swap', () => {
+    ++availabilityRevision;
+    stop();
+    form.removeEventListener('submit', translate);
+    restore.removeEventListener('click', showOriginal);
+    language.removeEventListener('change', checkAvailability);
+  }, { once: true });
+}
diff --git a/tests/translation.test.mjs b/tests/translation.test.mjs
new file mode 100644
index 0000000..3a17b30
--- /dev/null
+++ b/tests/translation.test.mjs
@@ -0,0 +1,99 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { initializeTranslation } from '../src/scripts/translation.ts';
+
+class Element extends EventTarget {
+  dataset = {};
+  attributes = new Map();
+  textContent = '';
+  disabled = false;
+  hidden = false;
+  value = 'es';
+  selectedOptions = [{ textContent: 'Español' }];
+  setAttribute(key, value) { this.attributes.set(key, value); }
+  getAttribute(key) { return this.attributes.get(key) ?? null; }
+  removeAttribute(key) { this.attributes.delete(key); }
+  closest() { return null; }
+}
+
+function setup(api) {
+  const bar = new Element();
+  const controls = Object.fromEntries(['form', 'select', '.translation-submit', '.translation-restore', '.translation-status'].map(key => [key, new Element()]));
+  controls['.translation-submit'].textContent = 'Translate teasers';
+  bar.querySelector = key => controls[key];
+  const region = new Element();
+  region.lang = 'en';
+  region.setAttribute('lang', 'en');
+  const nodes = ['  A headline  ', 'An article with a link.'].map(text => ({ textContent: text, parentElement: region }));
+  const doc = new EventTarget();
+  doc.querySelector = () => bar;
+  doc.querySelectorAll = () => [region];
+  doc.createTreeWalker = () => {
+    let index = -1;
+    return { nextNode() { return nodes[++index]; }, get currentNode() { return nodes[index]; } };
+  };
+  globalThis.document = doc;
+  globalThis.window = { Translator: api, isSecureContext: true };
+  globalThis.NodeFilter = { SHOW_TEXT: 4, FILTER_ACCEPT: 1, FILTER_REJECT: 2 };
+  initializeTranslation();
+  return { controls, nodes, region, doc, submit() { controls.form.dispatchEvent(new Event('submit', { cancelable: true })); } };
+}
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const api = translate => ({ availability: async () => 'available', create: async () => ({ translate, destroy() {} }) });
+
+test('unsupported browsers show a useful disabled fallback', () => {
+  const { controls } = setup(undefined);
+  assert.equal(controls['.translation-submit'].disabled, true);
+  assert.match(controls['.translation-status'].textContent, /unavailable in this browser/);
+});
+
+test('translates from the original, preserves whitespace and restores exactly', async () => {
+  const inputs = [];
+  const app = setup(api(async text => { inputs.push(text); return `Translated: ${text}`; }));
+  await tick();
+  app.submit();
+  await tick();
+  assert.equal(app.nodes[0].textContent, '  Translated: A headline  ');
+  assert.equal(app.region.lang, 'es');
+  app.controls.select.value = 'fr';
+  app.submit();
+  await tick();
+  assert.deepEqual(inputs, ['A headline', 'An article with a link.', 'A headline', 'An article with a link.']);
+  app.controls['.translation-restore'].dispatchEvent(new Event('click'));
+  assert.equal(app.nodes[0].textContent, '  A headline  ');
+  assert.equal(app.nodes[1].textContent, 'An article with a link.');
+  assert.equal(app.region.lang, 'en');
+});
+
+test('failure leaves all content intact and permits retry', async () => {
+  let count = 0;
+  const app = setup(api(async () => { if (++count === 2) throw new Error('failed'); return 'partial result'; }));
+  await tick();
+  app.submit();
+  await tick();
+  assert.equal(app.nodes[0].textContent, '  A headline  ');
+  assert.equal(app.controls['.translation-submit'].disabled, false);
+  assert.match(app.controls['.translation-status'].textContent, /could not finish/);
+});
+
+test('cancel and navigation prevent late translations from updating content', async () => {
+  for (const action of ['cancel', 'navigation']) {
+    let finish;
+    const app = setup(api(() => new Promise(resolve => { finish = resolve; })));
+    await tick();
+    app.submit();
+    await tick();
+    if (action === 'cancel') app.controls['.translation-restore'].dispatchEvent(new Event('click'));
+    else app.doc.dispatchEvent(new Event('astro:before-swap'));
+    finish('Late translation');
+    await tick();
+    assert.equal(app.nodes[0].textContent, '  A headline  ');
+  }
+});
+
+test('unavailable language pairs disable translation', async () => {
+  const app = setup({ ...api(async text => text), availability: async () => 'unavailable' });
+  await tick();
+  assert.equal(app.controls['.translation-submit'].disabled, true);
+  assert.match(app.controls['.translation-status'].textContent, /Choose another language/);
+});
