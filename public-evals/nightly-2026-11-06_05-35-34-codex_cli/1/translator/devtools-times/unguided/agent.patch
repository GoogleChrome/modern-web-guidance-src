+      <option value="hi">हिन्दी</option>
+      <option value="ar">العربية</option>
+    </select>
+    <button class="translation-submit" type="submit">Translate {isArticle ? 'article' : 'teasers'}</button>
+    <button class="translation-restore" type="button" hidden>Show original</button>
