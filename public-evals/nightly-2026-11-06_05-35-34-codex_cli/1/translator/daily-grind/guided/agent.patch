diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..47e6687
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,128 @@
+(() => {
+  const selector = document.getElementById('language-select');
+  const button = document.getElementById('translate-button');
+  const status = document.getElementById('translation-status');
+  const progress = document.getElementById('translation-progress');
+  const passages = [...document.querySelectorAll('[data-translate]')];
+  // Always translate the original English, never another AI translation.
+  const originals = passages.map(element => element.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let activeTranslator;
+  let readyOptions;
+
+  function show(texts, language) {
+    passages.forEach((element, index) => {
+      element.textContent = texts[index];
+      element.lang = language;
+      element.dir = language === 'ar' ? 'rtl' : 'ltr';
+    });
+  }
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. You can read the original English below. Try a supported desktop browser, such as Chrome or Edge, over HTTPS.';
+    return;
+  }
+
+  selector.disabled = false;
+  status.textContent = 'Choose a language, then select Translate. Only the descriptions and story will change.';
+
+  selector.addEventListener('change', async () => {
+    const current = ++revision;
+    activeTranslator?.destroy();
+    activeTranslator = undefined;
+    readyOptions = undefined;
+    button.disabled = true;
+    progress.hidden = true;
+    const language = selector.value;
+
+    if (language === 'en') {
+      show(originals, 'en');
+      status.textContent = 'Original English restored.';
+      return;
+    }
+
+    if (cache.has(language)) {
+      button.disabled = false;
+      status.textContent = 'Select Translate to show this language.';
+      return;
+    }
+
+    status.textContent = 'Checking this language on your device…';
+    const options = { sourceLanguage: 'en', targetLanguage: language };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (current !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Choose another language or English. The displayed text has not changed.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready. Select Translate to read this language.'
+        : 'Select Translate to download the language pack and translate on your device. This may take a few minutes.';
+    } catch {
+      if (current !== revision) return;
+      status.textContent = 'Could not check this language. Choose another language or select this one again to retry. The displayed text has not changed.';
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    const language = selector.value;
+    if (button.disabled || language === 'en') return;
+    const current = ++revision;
+    button.disabled = true;
+
+    if (cache.has(language)) {
+      show(cache.get(language), language);
+      status.textContent = 'Translation displayed. Choose English to restore the original.';
+      return;
+    }
+
+    let translator;
+    try {
+      status.textContent = 'Preparing on-device translation…';
+      // Called directly from this click, after availability was checked on selection,
+      // so downloading a language pack retains the required user activation.
+      translator = await window.Translator.create({
+        ...readyOptions,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (current !== revision) return;
+            progress.hidden = false;
+            progress.value = event.loaded;
+            status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. You can choose English to cancel.`;
+          });
+        },
+      });
+      if (current !== revision) return;
+      activeTranslator = translator;
+      progress.hidden = true;
+      const translations = [];
+      for (const original of originals) {
+        status.textContent = `Translating on your device: ${translations.length + 1} of ${originals.length} passages…`;
+        const translated = await translator.translate(original);
+        if (current !== revision) return;
+        if (typeof translated !== 'string' || !translated.trim()) {
+          throw new Error('Empty translation');
+        }
+        translations.push(translated);
+      }
+      // Apply the entire result at once so failures never leave mixed languages.
+      cache.set(language, translations);
+      show(translations, language);
+      status.textContent = 'Translated on your device. Choose English to restore the original.';
+    } catch {
+      if (current !== revision) return;
+      status.textContent = 'Translation could not finish. Check your connection and device storage, then select Translate to retry, or choose English. The displayed text has not changed.';
+      button.disabled = false;
+    } finally {
+      translator?.destroy();
+      if (current === revision) {
+        activeTranslator = undefined;
+        progress.hidden = true;
+      }
+    }
+  });
+})();
