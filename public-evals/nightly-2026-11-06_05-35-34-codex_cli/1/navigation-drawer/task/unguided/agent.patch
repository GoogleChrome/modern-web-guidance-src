+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.navigation-drawer');
+    const panel = drawer.querySelector('.drawer-panel');
+    const closeButton = drawer.querySelector('.close-menu');
+    let closing = false;
+    let gesture = null;
+    let previousOverflow = '';
+
+    function closeMenu() {
+      if (!drawer.open || closing) return;
+      closing = true;
+      gesture = null;
+      panel.classList.remove('is-dragging');
+      panel.style.removeProperty('transform');
+      drawer.classList.remove('is-open');
+      menuButton.setAttribute('aria-expanded', 'false');
+      const delay = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 220;
+      window.setTimeout(() => drawer.close(), delay);
+    }
+
+    menuButton.addEventListener('click', () => {
+      previousOverflow = document.body.style.overflow;
+      document.body.style.overflow = 'hidden';
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Commit the off-screen position before starting the slide-in transition.
+      panel.getBoundingClientRect();
+      drawer.classList.add('is-open');
+    });
+
+    closeButton.addEventListener('click', closeMenu);
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeMenu();
+    });
+    let outsidePress = false;
+    drawer.addEventListener('pointerdown', (event) => {
+      outsidePress = event.target === drawer;
+    });
+    drawer.addEventListener('click', (event) => {
+      if (outsidePress && event.target === drawer) closeMenu();
+      outsidePress = false;
+    });
+    drawer.addEventListener('close', () => {
+      closing = false;
+      drawer.classList.remove('is-open');
+      menuButton.setAttribute('aria-expanded', 'false');
+      document.body.style.overflow = previousOverflow;
+      menuButton.focus();
+    });
+    panel.querySelectorAll('a').forEach((link) => {
+      link.addEventListener('click', closeMenu);
+    });
+
+    panel.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || closing) return;
+      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, dragging: false };
+    });
+    panel.addEventListener('pointermove', (event) => {
+      if (!gesture || event.pointerId !== gesture.id) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.dragging) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
+          gesture = null;
+          return;
+        }
+        if (dx <= 10 || dx <= Math.abs(dy)) return;
+        gesture.dragging = true;
+        panel.setPointerCapture(event.pointerId);
+        panel.classList.add('is-dragging');
+      }
+      panel.style.transform = `translateX(${Math.max(0, dx)}px)`;
+    });
+    function endSwipe(event) {
+      if (!gesture || event.pointerId !== gesture.id) return;
+      const shouldClose = event.type === 'pointerup' && gesture.dragging &&
+        event.clientX - gesture.x > Math.min(80, panel.offsetWidth * 0.25);
+      gesture = null;
+      panel.classList.remove('is-dragging');
+      panel.style.removeProperty('transform');
+      if (panel.hasPointerCapture(event.pointerId)) panel.releasePointerCapture(event.pointerId);
+      if (shouldClose) closeMenu();
+    }
+    panel.addEventListener('pointerup', endSwipe);
+    panel.addEventListener('pointercancel', endSwipe);
+  </script>
