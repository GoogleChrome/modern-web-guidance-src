+    /* Each toast is its own native top-layer element, directly under body.
+       Counting from the last sibling keeps the newest toast at the bottom,
+       regardless of how many page elements precede the notifications. */
+    .toast {
+      position: fixed;
+      inset: auto max(1rem, env(safe-area-inset-right))
+        max(1rem, env(safe-area-inset-bottom)) auto;
+      bottom: calc(max(1rem, env(safe-area-inset-bottom)) +
+        (sibling-count() - sibling-index()) * 5rem);
+      margin: 0;
+      width: min(20rem, calc(100vw - 2rem));
+      height: 4rem;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 0.2);
+      overflow: visible;
+      animation: toast-enter 200ms ease-out both;
+      transition: bottom 200ms ease, display 180ms, overlay 180ms;
+      transition-behavior: allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast[data-closing] {
+      pointer-events: none;
+      animation: toast-exit 180ms ease-in both;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2.5rem;
+      height: 2.5rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 0.15);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @keyframes toast-enter {
+      from { opacity: 0; transform: translateY(0.75rem); }
+      to { opacity: 1; transform: translateY(0); }
+    }
+
+    @keyframes toast-exit {
+      from { opacity: 1; transform: translateY(0); }
+      to { opacity: 0; transform: translateX(0.75rem); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        animation-duration: 1ms;
+        transition-duration: 1ms;
+      }
+
+      .toast[data-closing] {
+        animation-duration: 1ms;
+      }
+
+      @keyframes toast-enter {
+        from { opacity: 0; }
+        to { opacity: 1; }
+      }
+
+      @keyframes toast-exit {
+        from { opacity: 1; }
+        to { opacity: 0; }
+      }
+    }
+
