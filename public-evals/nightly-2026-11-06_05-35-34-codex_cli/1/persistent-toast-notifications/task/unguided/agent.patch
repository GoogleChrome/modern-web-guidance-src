+  <script>
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        // Manual popovers coexist independently in the browser's top layer.
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.setAttribute('role', 'status');
+        message.textContent = 'added to cart!';
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Close notification');
+        close.textContent = '×';
+
+        let dismissed = false;
+        let timer;
+        const dismiss = () => {
+          if (dismissed) return;
+          dismissed = true;
+          clearTimeout(timer);
+          if (document.activeElement === close) trigger.focus({ preventScroll: true });
+          toast.hidePopover();
+          // Preserve the element through its CSS exit transition.
+          setTimeout(() => toast.remove(), 240);
+        };
+
+        close.addEventListener('click', dismiss);
+        toast.append(message, close);
+        document.body.append(toast);
+        toast.showPopover();
+        timer = setTimeout(dismiss, 3000);
+      });
+    });
+  </script>
