+  return encoder.encode(JSON.stringify([DOMAIN, envelope.version, envelope.suite, envelope.publicKey, envelope.payload]));
+}
+export async function signDocument(signer, document) {
+  const envelope = { version: 1, suite: signer.suite, publicKey: signer.publicKey, payload: JSON.stringify(document) };
