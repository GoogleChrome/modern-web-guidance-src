+import { generateSigner, signDocument, verifyDocument, fingerprint, fromBase64, suites } from './signatures.mjs';
+const $ = id => document.getElementById(id);
+let signer, currentEnvelope, importedTrust, database;
+let generation = 0;
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const displayDate = value => new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+function status(message, error = false) { $('status').hidden = false; $('status').className = error ? 'error' : ''; $('status').textContent = message; }
+function resetStatus() { $('status').hidden = true; }
+function readStore() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open('daily-grind-signing', 1);
+    req.onupgradeneeded = () => req.result.createObjectStore('identity');
+    req.onerror = () => reject(new Error('Browser storage is unavailable. Enable site storage to keep your signing identity.'));
+    req.onsuccess = () => {
+      database = req.result;
+      const get = database.transaction('identity').objectStore('identity').get('signer');
+      get.onsuccess = () => resolve(get.result);
+      get.onerror = () => reject(new Error('Could not read your signing identity.'));
+    };
+  });
+}
+function persist(value) {
+  return new Promise((resolve, reject) => {
+    const tx = database.transaction('identity', 'readwrite');
+    tx.objectStore('identity').put(value, 'signer');
+    tx.oncomplete = resolve;
+    tx.onerror = () => reject(new Error('Could not save your signing key. Check your browser storage settings.'));
+    tx.onabort = tx.onerror;
+  });
+}
+function formDocument() {
+  const type = new FormData($('document-form')).get('type');
+  return { issuer: 'The Daily Grind', type, id: 'DG–PREVIEW', customer: $('customer').value.trim() || (type === 'voucher' ? 'Someone special' : 'A fellow coffee lover'), item: type === 'voucher' ? 'A little coffee, a lot of joy' : $('item').value, amountCents: Math.round(Number($('amount').value) * 100), currency: 'USD', message: type === 'voucher' ? $('message').value.trim() : '', issuedAt: new Date().toISOString() };
+}
+function render(doc, state = 'preview') {
+  const voucher = doc.type === 'voucher';
+  $('paper-type').textContent = voucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT';
+  $('preview-label').textContent = `YOUR ${voucher ? 'VOUCHER' : 'RECEIPT'}, AT A GLANCE`;
+  $('paper-id').textContent = 'No. ' + (doc.id === 'DG–PREVIEW' ? doc.id : 'DG-' + doc.id.slice(-8).toUpperCase());
+  $('paper-id').title = doc.id;
+  $('paper-customer').textContent = doc.customer;
+  $('paper-date').textContent = displayDate(doc.issuedAt);
+  $('paper-item').replaceChildren(document.createTextNode(doc.item || (voucher ? 'Gift voucher' : 'Coffee order')));
+  const sub = document.createElement('small');
+  sub.textContent = voucher ? 'A thoughtful little pick-me-up.' : 'Crafted with care, as always.';
+  $('paper-item').append(sub);
+  $('paper-price').textContent = $('paper-total').textContent = money(Number.isFinite(doc.amountCents) ? doc.amountCents : 0);
+  $('paper-message').hidden = !doc.message;
+  $('paper-message').textContent = doc.message || '';
+  $('stamp-title').textContent = state === 'signed' ? 'Digitally signed on this device' : state === 'verified' ? 'Signature verified · details intact' : 'Ready for your signature';
+  $('stamp-detail').textContent = state === 'preview' ? 'A little proof. A lot of peace of mind.' : `Signer ${currentEnvelope?.suite || ''} · ${currentEnvelope ? 'key ' + (signer?.publicKey === currentEnvelope.publicKey ? signer.fingerprint.slice(0, 12) : 'imported') : ''}`;
+  document.querySelector('.preview-live').textContent = state === 'preview' ? '● Live preview' : state === 'signed' ? '✓ Signed document' : '✓ Verified document';
+}
+function updateForm() {
+  generation++;
+  currentEnvelope = undefined;
+  $('download-actions').hidden = true;
+  resetStatus();
+  const voucher = formDocument().type === 'voucher';
+  $('customer-label').replaceChildren(document.createTextNode(voucher ? 'Recipient name ' : 'Customer name '));
+  const optional = document.createElement('span'); optional.textContent = '(optional)'; $('customer-label').append(optional);
+  $('item').closest('.field').hidden = voucher;
+  $('message-field').hidden = !voucher;
+  $('sign-button').firstElementChild.textContent = voucher ? 'Sign gift voucher' : 'Sign coffee receipt';
+  render(formDocument());
+}
+$('document-form').addEventListener('input', updateForm);
+$('item').addEventListener('change', () => { $('amount').value = $('item').selectedOptions[0].dataset.price; updateForm(); });
+document.querySelectorAll('input[name="type"]').forEach(input => input.addEventListener('change', () => { $('amount').value = input.value === 'voucher' ? '25.00' : $('item').selectedOptions[0].dataset.price; updateForm(); }));
+$('document-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!signer) return status('Your signing identity is not ready. Please reload and check the message above.', true);
+  const revision = generation;
+  const doc = formDocument();
+  if (!Number.isSafeInteger(doc.amountCents) || doc.amountCents < 1 || doc.amountCents > 1000000) return status('Enter an amount between $0.01 and $10,000.00.', true);
+  $('sign-button').disabled = true;
+  try {
+    doc.id = 'DG-' + crypto.randomUUID();
+    const envelope = await signDocument(signer, doc);
+    if (revision !== generation) return status('Your details changed while signing. Sign again to seal the latest version.');
+    currentEnvelope = envelope;
+    render(doc, 'signed');
+    $('download-actions').hidden = false;
+    status(`${doc.type === 'voucher' ? 'Gift voucher' : 'Coffee receipt'} signed. Download the document and share your public key separately so the recipient can verify it.`);
+  } catch (error) { status(error.message, true); }
+  finally { $('sign-button').disabled = false; }
+});
+function switchMode(verify) {
+  generation++;
+  $('create-panel').hidden = verify;
+  $('verify-panel').hidden = !verify;
+  for (const [id, active] of [['create-mode', !verify], ['verify-mode', verify]]) { $(id).classList.toggle('selected', active); $(id).setAttribute('aria-pressed', String(active)); }
+  currentEnvelope = undefined;
+  $('download-actions').hidden = true;
+  resetStatus(); render(formDocument());
+}
+$('create-mode').addEventListener('click', () => switchMode(false));
+$('verify-mode').addEventListener('click', () => switchMode(true));
+async function parseFile(file) {
+  if (!file) throw new Error('Choose a JSON file first.');
+  if (file.size > 100000) throw new Error('Choose a document smaller than 100 KB.');
+  try { return JSON.parse(await file.text()); } catch { throw new Error('This file is not valid JSON. Choose a downloaded Daily Grind document.'); }
+}
+$('document-file').addEventListener('change', () => {
+  generation++; resetStatus(); currentEnvelope = undefined;
+  $('download-actions').hidden = true;
+  $('file-name').textContent = $('document-file').files[0]?.name || 'Daily Grind JSON file · up to 100 KB';
+  render(formDocument());
+});
+$('verify-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const button = event.submitter;
+  const revision = generation;
+  button.disabled = true;
+  resetStatus();
+  try {
+    const envelope = await parseFile($('document-file').files[0]);
+    const trusted = signer?.publicKey === envelope.publicKey ? signer : importedTrust;
+    const doc = await verifyDocument(envelope, trusted);
+    if (revision !== generation) return;
+    currentEnvelope = envelope;
+    render(doc, 'verified');
+    status('Signature verified. These details are unchanged and signed by ' + (trusted === signer ? 'your saved browser key.' : 'the public key you explicitly trusted.') + ' This does not confirm payment or voucher redemption status.');
+  } catch (error) { if (revision === generation) { currentEnvelope = undefined; render(formDocument()); status(error.message, true); } }
+  finally { button.disabled = false; }
+});
+$('trusted-key-file').addEventListener('change', async () => {
+  const revision = ++generation; importedTrust = undefined; resetStatus(); render(formDocument());
+  try {
+    const value = await parseFile($('trusted-key-file').files[0]);
