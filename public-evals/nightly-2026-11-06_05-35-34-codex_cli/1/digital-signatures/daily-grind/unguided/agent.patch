new file mode 100644
index 0000000..ec234a8
--- /dev/null
+++ b/tests/signing.test.js
@@ -0,0 +1,43 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { canonicalize, signDocument, verifyDocument } from '../signing.js';
+if (!globalThis.crypto) globalThis.crypto = webcrypto;
+const keys = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign','verify']);
+const base = { id: 'DG-R-test', type: 'receipt', demo: true, issuer: 'The Daily Grind — browser demo', issuedAt: '2026-11-06T12:00:00.000Z', currency: 'USD', items: [{ name: 'Maple Oat Latte', quantity: 2, unitPriceCents: 550 }], totalCents: 1100 };
+test('receipt signs and verifies with a non-exportable private key', async () => {
+  assert.equal(keys.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', keys.privateKey));
+  assert.deepEqual(await verifyDocument(await signDocument(base, keys), keys.publicKey), base);
+});
+test('voucher signs and verifies', async () => {
+  const voucher = { ...base, type: 'voucher', recipient: 'Jamie', amountCents: 2500, message: 'Enjoy your coffee!', redeemable: false };
+  assert.deepEqual(await verifyDocument(await signDocument(voucher, keys), keys.publicKey), voucher);
+});
+test('changing signed order, recipient, date, algorithm, or signature fails', async () => {
+  const signed = await signDocument(base, keys);
+  for (const mutate of [d => d.payload.totalCents++, d => d.payload.items[0].name = 'Espresso', d => d.payload.issuedAt = '2027-01-01', d => d.algorithm = 'none', d => d.signature = 'invalid', d => d.extra = 'untrusted']) {
+    const altered = structuredClone(signed); mutate(altered);
+    await assert.rejects(verifyDocument(altered, keys.publicKey));
+  }
+  const voucher = await signDocument({ ...base, type:'voucher', recipient:'Jamie', amountCents:2500, message:'Enjoy!', redeemable:false }, keys);
+  voucher.payload.recipient = 'Mallory';
+  await assert.rejects(verifyDocument(voucher, keys.publicKey));
+});
+test('untrusted keys and embedded replacement public keys are rejected', async () => {
+  const other = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign','verify']);
+  const foreign = await signDocument(base, other);
+  await assert.rejects(verifyDocument(foreign, keys.publicKey), /Unknown signing key/);
+  foreign.publicKey = await crypto.subtle.exportKey('jwk', other.publicKey);
+  await assert.rejects(verifyDocument(foreign, keys.publicKey), /not a supported/);
+});
+test('property reordering preserves valid signatures', async () => {
+  const signed = await signDocument(base, keys);
+  signed.payload = Object.fromEntries(Object.entries(signed.payload).reverse());
+  assert.deepEqual(await verifyDocument(signed, keys.publicKey), base);
+  assert.equal(canonicalize({b:1,a:{d:2,c:3}}), canonicalize({a:{c:3,d:2},b:1}));
+});
+test('malformed inputs and signed invalid totals are rejected', async () => {
+  for (const value of [null, [], {}, 'receipt']) await assert.rejects(verifyDocument(value, keys.publicKey));
+  await assert.rejects(verifyDocument(await signDocument({...base,totalCents:1}, keys), keys.publicKey), /contents are invalid/);
+});
