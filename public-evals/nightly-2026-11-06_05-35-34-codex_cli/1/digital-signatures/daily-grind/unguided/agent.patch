+export const ALGORITHM = 'ECDSA-P256-SHA256';
+const encoder = new TextEncoder();
+export function canonicalize(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonicalize).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonicalize(value[key])).join(',') + '}';
+}
+function toBase64(bytes) { return btoa(String.fromCharCode(...new Uint8Array(bytes))); }
+export async function keyFingerprint(publicKey) {
+  const raw = await crypto.subtle.exportKey('spki', publicKey);
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', raw)), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function signDocument(payload, keys) {
+  const document = { version: 1, algorithm: ALGORITHM, keyId: await keyFingerprint(keys.publicKey), payload };
+  const signature = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, keys.privateKey, encoder.encode(canonicalize(document)));
+  return { ...document, signature: toBase64(signature) };
+}
+export async function verifyDocument(document, publicKey) {
+  if (!document || typeof document !== 'object' || Array.isArray(document) || Object.keys(document).sort().join(',') !== 'algorithm,keyId,payload,signature,version' || document.version !== 1 || document.algorithm !== ALGORITHM || typeof document.signature !== 'string') throw new Error('This is not a supported Daily Grind signed document.');
+  if (document.keyId !== await keyFingerprint(publicKey)) throw new Error('Unknown signing key. This document was not signed with this browser’s saved key.');
+  const { signature, ...signed } = document;
+  let bytes;
+  try { bytes = Uint8Array.from(atob(signature), char => char.charCodeAt(0)); } catch { throw new Error('The signature is malformed.'); }
+  if (bytes.length !== 64 || !await crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, publicKey, bytes, encoder.encode(canonicalize(signed)))) throw new Error('Signature check failed. The document may have been changed or its signature is invalid.');
+  const p = document.payload;
+  if (!p || !['receipt', 'voucher'].includes(p.type) || p.issuer !== 'The Daily Grind — browser demo' || p.demo !== true || typeof p.id !== 'string' || !Number.isFinite(Date.parse(p.issuedAt)) || p.currency !== 'USD') throw new Error('The signature is valid, but this document’s contents are not supported.');
+  if (p.type === 'receipt' && (!Array.isArray(p.items) || !p.items.length || p.items.some(i => !i || typeof i.name !== 'string' || !Number.isSafeInteger(i.quantity) || i.quantity < 1 || !Number.isSafeInteger(i.unitPriceCents) || i.unitPriceCents < 0) || p.totalCents !== p.items.reduce((sum, i) => sum + i.quantity * i.unitPriceCents, 0))) throw new Error('The receipt contents are invalid.');
+  if (p.type === 'voucher' && (typeof p.recipient !== 'string' || !p.recipient.trim() || ![1000,2500,5000,10000].includes(p.amountCents) || typeof p.message !== 'string' || p.redeemable !== false)) throw new Error('The voucher contents are invalid.');
+  return p;
+}
+export async function loadSigningKeys() {
+  if (!globalThis.isSecureContext || !crypto?.subtle) throw new Error('Signing needs a secure HTTPS connection or localhost and a browser with Web Crypto support.');
+  const db = await new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(new Error('Your browser could not open secure key storage. Enable site storage and try again.'));
+    request.onblocked = () => reject(new Error('Close other Daily Grind tabs to finish preparing your signing key.'));
+  });
+  try {
+    const existing = await new Promise((resolve, reject) => {
+      const request = db.transaction('keys').objectStore('keys').get('identity');
+      request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error);
+    });
+    if (existing) return existing;
+    const candidate = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
