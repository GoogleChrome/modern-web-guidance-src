+import { loadSigningKeys, keyFingerprint, signDocument, verifyDocument } from './signing.js';
+const $ = selector => document.querySelector(selector);
+let keys, keyError, latestDocument, selected = 'maple', toastTimer;
+const products = {
+  maple: { name: 'Maple Oat Latte', price: 550, description: 'Regular · Oat milk · A little maple magic' },
+  espresso: { name: 'Dark Roast Espresso', price: 350, description: 'Double shot · Dark roast · Bold & beautiful' },
+  cold: { name: 'Slow-Steeped Cold Brew', price: 475, description: 'Regular · Over ice · Steeped for 18 hours' }
+};
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+function toast(message, error = false) {
+  clearTimeout(toastTimer); const el = $('#toast'); el.textContent = message; el.classList.toggle('error', error); el.hidden = false;
+  toastTimer = setTimeout(() => el.hidden = true, 6500);
+}
+function openTab(name, focus = false) {
+  document.querySelectorAll('[data-tab]').forEach(tab => { const active = tab.dataset.tab === name; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; if (active && focus) tab.focus(); });
+  document.querySelectorAll('[role="tabpanel"]').forEach(panel => panel.hidden = panel.id !== `panel-${name}`);
+}
+document.querySelectorAll('[data-tab]').forEach(tab => {
+  tab.addEventListener('click', () => openTab(tab.dataset.tab));
+  tab.addEventListener('keydown', event => { const tabs = [...document.querySelectorAll('[data-tab]')]; let index = tabs.indexOf(tab); if (event.key === 'ArrowRight') index = (index + 1) % tabs.length; else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length; else if (event.key === 'Home') index = 0; else if (event.key === 'End') index = tabs.length - 1; else return; event.preventDefault(); openTab(tabs[index].dataset.tab, true); });
+});
+openTab('receipt');
+document.querySelectorAll('[data-open]').forEach(link => link.addEventListener('click', () => openTab(link.dataset.open)));
+function updateOrder() { const p = products[selected]; $('#order-name').textContent = p.name; $('#order-description').textContent = p.description; $('#item-price').textContent = money(p.price); $('#order-total').textContent = money(p.price * Number($('#quantity').value)); }
+$('#quantity').addEventListener('change', updateOrder);
+document.querySelectorAll('[data-order]').forEach(button => button.addEventListener('click', () => { selected = button.dataset.order; updateOrder(); openTab('receipt'); $('#studio').scrollIntoView({ behavior: 'smooth' }); toast(`${products[selected].name} selected for your sample receipt.`); }));
+function download(content, name) { const url = URL.createObjectURL(new Blob([JSON.stringify(content, null, 2)], { type: 'application/json' })); const link = document.createElement('a'); link.href = url; link.download = name; document.body.append(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000); }
+const keyReady = loadSigningKeys().then(async value => { keys = value; $('#key-status').textContent = 'Your browser key is ready'; const fingerprint = await keyFingerprint(keys.publicKey); $('#key-status').title = `SHA-256 key fingerprint: ${fingerprint}`; }).catch(error => { keyError = error; $('#key-status').textContent = 'Key storage unavailable'; toast(error.message, true); });
+async function requireKeys() { await keyReady; if (!keys) throw keyError || new Error('Signing is unavailable in this browser.'); return keys; }
+function payloadBase(type) { return { type, id: `DG-${type === 'receipt' ? 'R' : 'G'}-${crypto.randomUUID()}`, issuer: 'The Daily Grind — browser demo', issuedAt: new Date().toISOString(), currency: 'USD', demo: true }; }
+async function createSigned(button, payloadFactory) {
+  button.disabled = true;
+  try { const identity = await requireKeys(); const payload = payloadFactory(); latestDocument = await signDocument(payload, identity); download(latestDocument, `${payload.id}.json`); latestButton.hidden = false; toast(`Your signed ${payload.type} has been downloaded. Keep the JSON file to verify it later.`); }
+  catch (error) { toast(error.message || 'Unable to sign this document. Please try again.', true); }
+  finally { button.disabled = false; }
+}
+$('#sign-receipt').addEventListener('click', event => createSigned(event.currentTarget, () => { const product = products[selected], quantity = Number($('#quantity').value); return { ...payloadBase('receipt'), items: [{ name: product.name, quantity, unitPriceCents: product.price }], totalCents: product.price * quantity, taxIncluded: true, paymentStatus: 'sample — no payment collected' }; }));
+$('#voucher-form').addEventListener('submit', event => { event.preventDefault(); const recipient = $('#recipient').value.trim(); if (!recipient) { $('#recipient').setCustomValidity('Please enter a recipient’s name.'); $('#recipient').reportValidity(); return; } createSigned(event.submitter, () => ({ ...payloadBase('voucher'), recipient, amountCents: Number($('#amount').value) * 100, message: $('#gift-message').value.trim(), redeemable: false })); });
+$('#recipient').addEventListener('input', () => $('#recipient').setCustomValidity(''));
+function showResult(title, message, error = false) { const result = $('#verification-result'); result.replaceChildren(); const heading = document.createElement('strong'); heading.textContent = title; const body = document.createElement('span'); body.textContent = message; result.append(heading, body); result.classList.toggle('error', error); result.hidden = false; }
+async function verifyText(text) {
+  $('#verification-result').hidden = true;
+  try { const identity = await requireKeys(); if (new TextEncoder().encode(text).length > 1048576) throw new Error('Please choose a JSON document smaller than 1 MB.'); let doc; try { doc = JSON.parse(text); } catch { throw new Error('This file is not valid JSON. Choose the original downloaded receipt or voucher.'); } const payload = await verifyDocument(doc, identity.publicKey); const detail = payload.type === 'receipt' ? `${payload.items.map(i => `${i.quantity} × ${i.name}`).join(', ')} · ${money(payload.totalCents)}` : `For ${payload.recipient} · ${money(payload.amountCents)} · Demo voucher, no redeemable value`; showResult('✓ Signature verified · document unchanged', `${detail}. Signed ${new Date(payload.issuedAt).toLocaleString()} with this browser’s key. This confirms integrity, not merchant issuance.`); }
+  catch (error) { showResult('Unable to verify this document', error.message || 'Verification failed. Please check the document and try again.', true); }
+}
+async function readFile(file) { if (!file) return; if (file.size > 1048576) { showResult('File too large', 'Choose a JSON file smaller than 1 MB.', true); return; } try { const text = await file.text(); $('#verify-json').value = text; await verifyText(text); } catch { showResult('Could not read file', 'Please choose the file again.', true); } }
+$('#verify-file').addEventListener('change', event => readFile(event.target.files[0]));
+$('#verify-button').addEventListener('click', () => verifyText($('#verify-json').value));
+const latestButton = document.createElement('button'); latestButton.className = 'text-link'; latestButton.textContent = 'Verify your latest signed document ↗'; latestButton.hidden = true; $('#panel-verify').insertBefore(latestButton, $('#verification-result')); latestButton.addEventListener('click', () => { $('#verify-json').value = JSON.stringify(latestDocument, null, 2); verifyText($('#verify-json').value); });
+const drop = $('#drop-zone'); ['dragenter','dragover'].forEach(name => drop.addEventListener(name, event => { event.preventDefault(); drop.classList.add('dragover'); })); ['dragleave','drop'].forEach(name => drop.addEventListener(name, event => { event.preventDefault(); drop.classList.remove('dragover'); if (name === 'drop') readFile(event.dataTransfer.files[0]); }));
+function showDialog(title, content) { $('#dialog-title').textContent = title; $('#dialog-content').replaceChildren(); if (typeof content === 'string') $('#dialog-content').textContent = content; else $('#dialog-content').append(...content); $('#info-dialog').showModal(); }
+$('#security-info').addEventListener('click', () => { const p = document.createElement('p'); p.textContent = 'Your browser creates an ECDSA P-256 key pair. The private key cannot be exported and stays in this site’s browser storage. A signature covers the document’s contents, ID, date, algorithm and key fingerprint. Any change makes verification fail.'; const q = document.createElement('p'); q.textContent = 'Verification trusts only this browser’s saved public key. These sample documents are not merchant-issued receipts or redeemable vouchers. Clearing site data removes your key; another device cannot verify these documents here. Merchant authenticity requires a separately trusted merchant key and an authorized signing service.'; const link = document.createElement('a'); link.href = 'https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto/sign'; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = 'Learn about Web Crypto signatures ↗'; showDialog('A little science. A lot of care.', [p,q,link]); });
+$('#view-key').addEventListener('click', async () => { try { const identity = await requireKeys(); const jwk = await crypto.subtle.exportKey('jwk', identity.publicKey); const p = document.createElement('p'); p.textContent = 'This public key identifies signatures made in this browser. It is safe to share. Your private signing key is never included.'; const label = document.createElement('p'); label.textContent = 'SHA-256 fingerprint'; const fingerprint = document.createElement('code'); fingerprint.textContent = await keyFingerprint(identity.publicKey); const code = document.createElement('code'); code.textContent = JSON.stringify(jwk, null, 2); const button = document.createElement('button'); button.className = 'button dark'; button.textContent = 'Download public key ↗'; button.addEventListener('click', () => download(jwk, 'daily-grind-public-key.json')); showDialog('Your public signing key', [p,label,fingerprint,code,button]); } catch (error) { toast(error.message, true); } });
+document.querySelectorAll('.dialog-close,.dialog-done').forEach(button => button.addEventListener('click', () => $('#info-dialog').close()));
