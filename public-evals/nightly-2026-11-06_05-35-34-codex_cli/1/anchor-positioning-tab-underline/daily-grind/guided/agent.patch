@@ -207,6 +239,45 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const navList = document.querySelector('nav ul');
+    const navLinks = [...navList.querySelectorAll('a:not(.logout-link)')];
+    let activeLink = navLinks.find(link => link.pathname === location.pathname) || navLinks[0];
+
+    function positionIndicator() {
+      const listRect = navList.getBoundingClientRect();
+      const linkRect = activeLink.getBoundingClientRect();
+      navList.style.setProperty('--indicator-left', `${linkRect.left - listRect.left}px`);
+      navList.style.setProperty('--indicator-top', `${linkRect.bottom - listRect.top + 4}px`);
+      navList.style.setProperty('--indicator-width', `${linkRect.width}px`);
+    }
+
+    function selectLink(link) {
+      navLinks.forEach(item => item.removeAttribute('aria-current'));
+      activeLink = link;
+      activeLink.setAttribute('aria-current', 'page');
+      positionIndicator();
+    }
+
+    navLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        // Keep ordinary selections on this page so the shared indicator can slide.
+        // Modified clicks retain the link's normal new-tab behavior.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectLink(link);
+      });
+    });
+
+    selectLink(activeLink);
+    requestAnimationFrame(() => {
+      requestAnimationFrame(() => navList.classList.add('indicator-ready'));
+    });
+    const navResizeObserver = new ResizeObserver(positionIndicator);
+    navResizeObserver.observe(navList);
+    navLinks.forEach(link => navResizeObserver.observe(link));
+    document.fonts.ready.then(positionIndicator);
+  </script>
 </body>
 
 </html>
