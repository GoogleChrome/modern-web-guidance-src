+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-email-error');
+    const announcement = document.getElementById('newsletter-announcement');
+
+    function syncEmailError() {
+      // Read the same state that reveals the visual error, rather than :invalid.
+      const showError = email.matches(':user-invalid');
+      email.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        email.setAttribute('aria-describedby', emailError.id);
+      } else {
+        email.removeAttribute('aria-describedby');
+      }
+
+      const message = showError ? emailError.textContent : '';
+      // Avoid announcing the same error again on every interaction.
+      if (announcement.textContent !== message) {
+        announcement.textContent = message;
+      }
+    }
+
+    function syncAfterInteraction() {
+      syncEmailError();
+      // Some native validation flags update after the event's default action.
+      requestAnimationFrame(syncEmailError);
+    }
+
+    for (const event of ['input', 'change', 'blur', 'focus', 'invalid']) {
+      email.addEventListener(event, syncAfterInteraction);
+    }
+    newsletter.addEventListener('reset', syncAfterInteraction);
+    syncEmailError();
+  </script>
+
 </body>
 
