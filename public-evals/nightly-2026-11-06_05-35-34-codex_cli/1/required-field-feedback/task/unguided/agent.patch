@@ -206,7 +277,53 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const signupStatus = document.getElementById('mailing-list-status');
+    let emailTouched = false;
+
+    function updateEmailError() {
+      let message = '';
+      if (emailTouched) {
+        if (!email.value.trim()) {
+          message = 'Please enter your email address.';
+        } else if (!email.validity.valid) {
+          message = 'Please enter a valid email address.';
+        }
+      }
+      emailError.textContent = message;
+      if (message) {
+        email.setAttribute('aria-invalid', 'true');
+      } else {
+        email.removeAttribute('aria-invalid');
+      }
+    }
+
+    email.addEventListener('blur', () => {
+      emailTouched = true;
+      updateEmailError();
+    });
+
+    email.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      updateEmailError();
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      updateEmailError();
+      if (!email.value.trim() || !email.validity.valid) {
+        email.focus();
+        return;
+      }
+      // Connect a mailing service before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
 </html>
