@@ -206,7 +288,41 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingForm = document.getElementById('mailing-list');
+    const mailingEmail = document.getElementById('mailing-email');
+    const emailErrorText = document.getElementById('email-error-text');
+    const mailingStatus = document.getElementById('mailing-list-status');
+
+    const syncEmailError = () => {
+      emailErrorText.textContent = mailingEmail.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address.';
+
+      if (mailingEmail.matches(':user-invalid')) {
+        mailingEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        mailingEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Read the browser's interaction-aware state after it finishes each event.
+    for (const eventName of ['blur', 'focus', 'input', 'invalid']) {
+      mailingEmail.addEventListener(eventName, () => queueMicrotask(syncEmailError));
+    }
+
+    mailingEmail.addEventListener('input', () => {
+      mailingStatus.textContent = '';
+    });
+
+    mailingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing service here before accepting subscriptions.
+      mailingStatus.textContent = 'Online signup is not available yet. Please contact us to join the mailing list.';
+    });
+  </script>
+
 </body>
 
