+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-time');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      const validTime = value => typeof value === 'string' &&
+        /^(?:[01]\d|2[0-3]):[0-5]\d$/.test(value);
+
+      const validDate = value => {
+        if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+        const [year, month, day] = value.split('-').map(Number);
+        const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
+        const days = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+        return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= days[month - 1];
+      };
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (validTime(saved.pickupTime)) pickupTime.value = saved.pickupTime;
+          if (validDate(saved.coffeeAnniversary)) anniversary.value = saved.coffeeAnniversary;
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can select them again below.';
+      }
+
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        if ((pickupTime.value && !validTime(pickupTime.value)) ||
+            (anniversary.value && !validDate(anniversary.value))) {
+          status.textContent = 'Please choose a valid time and date.';
+          return;
+        }
+
+        try {
+          // Keep civil time/date strings exactly as selected. Never convert these
+          // values to Date objects, UTC timestamps, or timezone-dependent formats.
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupTime: pickupTime.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Coffee preferences saved on this browser.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Please allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
