+  <script>
+    /**
+     * Returns total visible time for this page in milliseconds, including the
+     * current visible interval. Call getTotalForegroundTime() when reporting.
+     * Without visibility history support, returns elapsed time since navigation
+     * as an upper bound; this fallback can include time in the background.
+     */
+    function getTotalForegroundTime() {
+      const entries = performance.getEntriesByType('visibility-state');
+      const now = performance.now();
+
+      if (entries.length === 0) {
+        return now;
+      }
+
+      let totalForegroundTime = 0;
+
+      for (let i = 0; i < entries.length; i++) {
+        if (entries[i].name === 'visible') {
+          const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+          totalForegroundTime += end - entries[i].startTime;
+        }
+      }
+
+      return totalForegroundTime;
+    }
+  </script>
+
