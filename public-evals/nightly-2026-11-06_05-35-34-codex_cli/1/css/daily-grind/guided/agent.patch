--- /dev/null
+++ b/styles.css
@@ -0,0 +1,196 @@
+/* Later layers take precedence without escalating selector specificity. */
+@layer reset, tokens, base, layout, components;
+
+@layer reset {
+  html {
+    box-sizing: border-box;
+  }
+
+  :where(body, nav, header, main, section, footer, div, ul, li, h1, h2, h3, p, a) {
+    box-sizing: inherit;
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    --color-primary: #4e342e;
+    --color-secondary: #d7ccc8;
+    --color-accent: #ffab40;
+    --color-text: #3e2723;
+    --color-page: #fafafa;
+    --color-surface: #fff;
+    --color-on-primary: #fff;
+    --color-hero-overlay: rgb(0 0 0 / 50%);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-body: 1.6;
+    --letter-spacing-logo: 1px;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --border-width: 1px;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-interaction: 0.3s;
+
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --page-gutter: 5%;
+    --hero-size: 60vh;
+    --layer-navigation: 1000;
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  /* Shared defaults stay easy to override within component rules. */
+  :where(.site-nav a, .btn, .footer-links a) {
+    text-decoration: none;
+  }
+
+  :where(.hero, .card, .section-title, .site-footer) {
+    text-align: center;
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--space-6);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  .site-nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-navigation);
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding-block: var(--space-5);
+    padding-inline: var(--page-gutter);
+    background: var(--color-primary);
+    color: var(--color-on-primary);
+
+    & :where(ul) {
+      display: flex;
+      gap: var(--space-6);
+      list-style: none;
+    }
+
+    & :where(a) {
+      color: inherit;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+    }
+  }
+
+  .logo {
+    font-size: var(--font-size-logo);
+    font-weight: bold;
+    letter-spacing: var(--letter-spacing-logo);
+  }
+
+  .logout-link {
+    border: var(--border-width) solid var(--color-accent);
+    padding-block: var(--space-1);
+    padding-inline: var(--space-3);
+    border-radius: var(--radius-small);
+  }
+
+  .hero {
+    block-size: var(--hero-size);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    padding-inline: var(--space-6);
+    color: var(--color-on-primary);
+    background:
+      linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80') center / cover;
+
+    & :where(h1) {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .card {
+    background: var(--color-surface);
+    padding: var(--space-6);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+
+    & :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-primary);
+    }
+  }
+
+  .btn {
+    display: inline-block;
+    background: var(--color-primary);
+    color: var(--color-on-primary);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-6);
+    border-radius: var(--radius-button);
+    margin-block-start: var(--space-4);
+    transition: background-color var(--duration-interaction);
+
+    &:is(:hover, :focus-visible) {
+      background-color: var(--color-text);
+    }
+  }
+
+  .site-footer {
+    background: var(--color-secondary);
+    padding-block: var(--space-7);
+    padding-inline: var(--space-6);
+    margin-block-start: var(--space-7);
+  }
+
+  .footer-links {
+    margin-block-end: var(--space-6);
+
+    & :where(a) {
+      margin-inline: var(--space-2);
+      color: inherit;
+      font-size: var(--font-size-small);
+    }
+  }
+}
