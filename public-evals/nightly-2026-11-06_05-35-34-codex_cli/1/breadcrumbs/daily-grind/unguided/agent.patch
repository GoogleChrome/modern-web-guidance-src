+  <script>
+    (() => {
+      const labels = {
+        menu: 'Menu',
+        seasonal: 'Maple Oat Latte',
+        espresso: 'Dark Roast Espresso',
+        'cold-brew': 'Cold Brew',
+        locations: 'Locations',
+        rewards: 'Rewards',
+        account: 'My Account',
+        logout: 'Logout',
+        'order-online': 'Order Online',
+        about: 'Our Story',
+        careers: 'Join the Team',
+        contact: 'Contact Us',
+        'privacy-policy': 'Privacy'
+      };
+      const segments = window.location.pathname.split('/').filter(Boolean);
+      if (segments[segments.length - 1] === 'index.html') segments.pop();
+
+      const crumbs = [{ label: 'Home', href: '/' }];
+      segments.forEach((segment, index) => {
+        let decoded = segment;
+        try { decoded = decodeURIComponent(segment); } catch {}
+        const label = labels[decoded] || decoded.replace(/[-_]/g, ' ')
+          .replace(/\b\w/g, character => character.toUpperCase());
+        crumbs.push({ label, href: '/' + segments.slice(0, index + 1).join('/') });
+      });
+
+      const list = document.getElementById('breadcrumb-list');
+      list.replaceChildren();
+      crumbs.forEach((crumb, index) => {
+        const item = document.createElement('li');
+        if (index > 0) {
+          const separator = document.createElement('span');
+          separator.className = 'separator';
+          separator.setAttribute('aria-hidden', 'true');
+          separator.textContent = '/';
+          item.append(separator);
+        }
+        const isCurrent = index === crumbs.length - 1;
+        const element = document.createElement(isCurrent ? 'span' : 'a');
+        element.textContent = crumb.label;
+        if (isCurrent) element.setAttribute('aria-current', 'page');
+        else element.setAttribute('href', crumb.href);
+        item.append(element);
+        list.append(item);
+      });
+    })();
+  </script>
 </body>
 
