+  <script>
+    const breadcrumbTrail = document.getElementById('breadcrumb-trail');
+    const routeLabels = {
+      '/menu': 'Menu',
+      '/menu/seasonal': 'Maple Oat Latte',
+      '/menu/espresso': 'Dark Roast Espresso',
+      '/menu/cold-brew': 'Cold Brew',
+      '/locations': 'Locations',
+      '/rewards': 'Rewards',
+      '/account': 'My Account',
+      '/logout': 'Logout',
+      '/order-online': 'Order Online',
+      '/about': 'Our Story',
+      '/careers': 'Join the Team',
+      '/contact': 'Contact Us',
+      '/privacy-policy': 'Privacy'
+    };
+    const segments = window.location.pathname.split('/').filter(Boolean);
+    if (segments.at(-1) === 'index.html') segments.pop();
+
+    if (segments.length > 0) {
+      breadcrumbTrail.querySelector('a').removeAttribute('aria-current');
+      let path = '';
+
+      segments.forEach((segment, index) => {
+        path += '/' + segment;
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = path;
+        link.textContent = routeLabels[path] ?? segment.replaceAll('-', ' ');
+        if (index === segments.length - 1) {
+          link.setAttribute('aria-current', 'page');
+        }
+        item.append(link);
+        breadcrumbTrail.append(item);
+      });
+    }
+  </script>
 </body>
 
