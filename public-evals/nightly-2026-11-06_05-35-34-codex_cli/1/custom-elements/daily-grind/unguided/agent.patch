+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    *, *::before, *::after { box-sizing: border-box; }
+    h3, p { margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 2px solid var(--accent, #ffab40); outline-offset: 3px; }
+    .featured { color: var(--primary, #4e342e); font-weight: bold; }
+    .price { margin-top: 10px; }
+    [hidden] { display: none; }
+  </style>
+  <article aria-labelledby="name">
+    <p class="featured" hidden>Seasonal favorite</p>
+    <h3 id="name"></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+/** A self-contained coffee card. See README.md for the reflected API. */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this._name = this.shadowRoot.querySelector('h3');
+    this._description = this.shadowRoot.querySelector('.description');
+    this._price = this.shadowRoot.querySelector('.price');
+    this._featured = this.shadowRoot.querySelector('.featured');
+    this._link = this.shadowRoot.querySelector('a');
+    this._onSelect = () => {
+      this.dispatchEvent(new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        detail: { name: this.name, href: this.href, price: this.price, featured: this.featured },
+      }));
+    };
+  }
+
+  connectedCallback() {
+    // Preserve properties assigned before the custom element was registered.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this._render();
+    this._link.addEventListener('click', this._onSelect);
+  }
+
+  disconnectedCallback() {
+    this._link.removeEventListener('click', this._onSelect);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this._render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this._reflectString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this._reflectString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? '/menu'; }
+  set href(value) { this._reflectString('href', value); }
+
+  get price() {
+    const value = this.getAttribute('price');
+    if (value === null || value.trim() === '') return null;
+    const number = Number(value);
+    return Number.isFinite(number) && number >= 0 ? number : null;
+  }
+
+  set price(value) {
+    if (value === null || value === undefined) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (String(value).trim() === '' || !Number.isFinite(number) || number < 0) {
+      throw new TypeError('price must be a finite, non-negative number');
+    }
+    this.setAttribute('price', String(number));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  _reflectString(attribute, value) {
+    if (value === null || value === undefined) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  _render() {
+    this._name.textContent = this.name;
+    this._description.textContent = this.description;
+    this._featured.hidden = !this.featured;
+    const price = this.price;
+    this._price.hidden = price === null;
+    this._price.textContent = price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(price);
+    // Only allow navigable web URLs; attribute text never becomes markup.
+    try {
+      const url = new URL(this.href, this.baseURI);
+      if (!['http:', 'https:'].includes(url.protocol)) throw new TypeError('Invalid protocol');
+      this._link.setAttribute('href', this.href);
+    } catch {
+      this._link.removeAttribute('href');
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
