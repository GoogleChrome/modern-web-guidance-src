@@ -0,0 +1,182 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { after, test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window({
+  url: 'https://daily-grind.example/',
+  settings: { disableJavaScriptFileLoading: true, disableCSSFileLoading: true },
+});
+for (const key of ['document', 'HTMLElement', 'customElements', 'CustomEvent']) {
+  globalThis[key] = window[key];
+}
+
+// Simulate markup and property assignments arriving before module registration.
+document.body.innerHTML = '<coffee-card name="Markup name"></coffee-card>';
+const pending = document.querySelector('coffee-card');
+pending.name = 'Early property';
+pending.price = 0;
+pending.featured = true;
+const { CoffeeCard } = await import('../coffee-card.js');
+after(() => window.happyDOM.abort());
+
+function createCard() {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  return card;
+}
+
+test('registers an autonomous custom element and replays pre-upgrade properties', () => {
+  const upgraded = document.querySelector('coffee-card');
+  assert.ok(upgraded instanceof CoffeeCard);
+  assert.equal(customElements.get('coffee-card'), CoffeeCard);
+  assert.equal(upgraded.getAttribute('name'), 'Early property');
+  assert.equal(upgraded.price, 0);
+  assert.equal(upgraded.getAttribute('price'), '0');
+  assert.equal(upgraded.featured, true);
+  assert.equal(upgraded.shadowRoot.querySelector('h3').textContent, 'Early property');
+});
+
+test('reflects strings in both directions, removes nulls, and renders text safely', () => {
+  const card = createCard();
+  for (const property of ['name', 'description', 'href']) {
+    card[property] = 'First value';
+    assert.equal(card.getAttribute(property), 'First value');
+    card.setAttribute(property, 'Updated value');
+    assert.equal(card[property], 'Updated value');
+    card[property] = null;
+    assert.equal(card.hasAttribute(property), false);
+  }
+  assert.equal(card.name, '');
+  assert.equal(card.description, '');
+  assert.equal(card.href, '/menu');
+  card.name = '<img src=x onerror=alert(1)>';
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+  assert.equal(card.shadowRoot.querySelector('img'), null);
+  card.description = 'Updated description';
+  assert.equal(card.shadowRoot.querySelector('.description').textContent, card.description);
+});
+
+test('reflects numeric prices, including zero, and hides absent or invalid values', () => {
+  const card = createCard();
+  const price = card.shadowRoot.querySelector('.price');
+  assert.equal(card.price, null);
+  assert.equal(price.hidden, true);
+  card.price = 5.5;
+  assert.equal(card.getAttribute('price'), '5.5');
+  assert.equal(price.textContent, '$5.50');
+  assert.equal(price.hidden, false);
+  card.setAttribute('price', '0');
+  assert.equal(card.price, 0);
+  assert.equal(price.textContent, '$0.00');
+  for (const invalid of ['', ' ', 'NaN', 'Infinity', '-1', 'coffee']) {
+    card.setAttribute('price', invalid);
+    assert.equal(card.price, null);
+    assert.equal(price.hidden, true);
+  }
+  for (const invalid of [NaN, Infinity, -1, '', 'coffee']) {
+    assert.throws(() => { card.price = invalid; }, TypeError);
+  }
+  card.price = '4.25';
+  assert.equal(card.price, 4.25);
+  for (const value of [null, undefined]) {
+    card.price = value;
+    assert.equal(card.hasAttribute('price'), false);
+    assert.equal(price.hidden, true);
+  }
+});
+
+test('uses presence semantics for boolean attributes and reflects boolean properties', () => {
+  const card = createCard();
+  const badge = card.shadowRoot.querySelector('.featured');
+  assert.equal(card.featured, false);
+  assert.equal(badge.hidden, true);
+  card.featured = true;
+  assert.equal(card.getAttribute('featured'), '');
+  assert.equal(badge.hidden, false);
+  card.setAttribute('featured', 'false');
+  assert.equal(card.featured, true);
+  card.featured = false;
+  assert.equal(card.hasAttribute('featured'), false);
+  assert.equal(badge.hidden, true);
+  card.setAttribute('featured', '');
+  card.removeAttribute('featured');
+  assert.equal(card.featured, false);
+  assert.equal(badge.hidden, true);
+});
+
+test('cleans up listeners on disconnect and restores exactly one on reconnect', () => {
+  const card = createCard();
+  card.name = 'Cold Brew';
+  card.href = '/menu/cold-brew';
+  const link = card.shadowRoot.querySelector('a');
+  let selections = 0;
+  card.addEventListener('coffee-select', event => {
+    selections++;
+    assert.deepEqual(event.detail, {
+      name: 'Cold Brew', href: '/menu/cold-brew', price: null, featured: false,
+    });
+    assert.equal(event.bubbles, true);
+    assert.equal(event.composed, true);
+  });
+  // Cancel navigation so the test only exercises event handling.
+  const click = () => link.dispatchEvent(new window.MouseEvent('click', { cancelable: true }));
+  link.addEventListener('click', event => event.preventDefault());
+  click();
+  assert.equal(selections, 1);
+  for (let iteration = 0; iteration < 3; iteration++) {
+    card.remove();
+    click();
+    assert.equal(selections, iteration + 1);
+    document.body.append(card);
+    click();
+    assert.equal(selections, iteration + 2);
+  }
+});
+
+test('updates disconnected cards and keeps existing DOM nodes during rendering', () => {
+  const card = createCard();
+  const link = card.shadowRoot.querySelector('a');
+  card.remove();
+  card.name = 'New name';
+  card.price = 6;
+  document.body.append(card);
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, 'New name');
+  assert.equal(card.shadowRoot.querySelector('.price').textContent, '$6.00');
+  assert.equal(card.shadowRoot.querySelector('a'), link);
+});
+
+test('updates links and rejects non-web URL schemes', () => {
+  const card = createCard();
+  const link = card.shadowRoot.querySelector('a');
+  for (const href of ['/menu/seasonal', 'https://example.com/coffee']) {
+    card.href = href;
+    assert.equal(link.getAttribute('href'), href);
+  }
+  for (const href of ['javascript:alert(1)', 'data:text/html,test', 'http://[invalid']) {
+    card.href = href;
+    assert.equal(link.hasAttribute('href'), false);
+  }
+  card.removeAttribute('href');
+  assert.equal(link.getAttribute('href'), '/menu');
+});
+
+test('the page uses three coffee elements with the original content and links', async () => {
+  const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+  const fixture = document.createElement('div');
+  fixture.innerHTML = html;
+  document.body.append(fixture);
+  const cards = [...fixture.querySelectorAll('coffee-card')];
+  assert.deepEqual(cards.map(card => [card.name, card.href]), [
+    ['Maple Oat Latte', '/menu/seasonal'],
+    ['Dark Roast Espresso', '/menu/espresso'],
+    ['Cold Brew', '/menu/cold-brew'],
+  ]);
+  for (const card of cards) {
+    assert.ok(card.description.length > 0);
+    assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+    assert.equal(card.shadowRoot.querySelector('.price').hidden, true);
+    assert.equal(card.shadowRoot.querySelector('.featured').hidden, true);
+  }
+  assert.match(html, /<script type="module" src="\.\/coffee-card\.js"><\/script>/);
+});
