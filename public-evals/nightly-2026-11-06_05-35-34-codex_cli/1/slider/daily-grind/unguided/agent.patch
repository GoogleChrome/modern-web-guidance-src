+  <script>
+    const brewStrength = document.getElementById('brew-strength');
+    const brewValue = document.getElementById('brew-value');
+    const strengthNames = ['Mild', 'Smooth', 'Balanced', 'Rich', 'Bold'];
+
+    function updateBrewStrength() {
+      const value = Number(brewStrength.value);
+      const min = Number(brewStrength.min);
+      const max = Number(brewStrength.max);
+      const name = strengthNames[value - min];
+      brewStrength.style.setProperty('--fill', `${((value - min) / (max - min)) * 100}%`);
+      brewStrength.setAttribute('aria-valuetext', `${name}, ${value} of ${max}`);
+      brewValue.value = `${name} · ${value}/${max}`;
+    }
+
+    brewStrength.addEventListener('input', updateBrewStrength);
+    window.addEventListener('pageshow', updateBrewStrength);
+    updateBrewStrength();
+  </script>
