+  <script>
+    const brewStrength = document.getElementById('brew-strength');
+    const brewStrengthValue = document.getElementById('brew-strength-value');
+    const strengthLabels = ['Mellow', 'Smooth', 'Balanced', 'Bold', 'Intense'];
+
+    function syncBrewStrength() {
+      const value = brewStrength.valueAsNumber;
+      const label = strengthLabels[value - 1];
+      brewStrength.style.setProperty('--attr-min', brewStrength.min);
+      brewStrength.style.setProperty('--attr-max', brewStrength.max);
+      brewStrength.style.setProperty('--control-value', value);
+      brewStrength.setAttribute('aria-valuetext', `${label}, ${value} of ${brewStrength.max}`);
+      brewStrengthValue.textContent = `${label} · ${value}/${brewStrength.max}`;
+    }
+
+    syncBrewStrength();
+    brewStrength.addEventListener('input', syncBrewStrength);
+    window.addEventListener('pageshow', syncBrewStrength);
+  </script>
