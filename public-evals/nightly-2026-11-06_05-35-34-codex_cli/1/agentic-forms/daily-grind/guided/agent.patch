+(() => {
+  const form = document.getElementById('coffee-finder-form');
+  const resultRegion = document.getElementById('coffee-result');
+  const drinks = [
+    {
+      name: 'Cold Brew',
+      flavors: ['smooth', 'bold'],
+      temperatures: ['iced'],
+      description: 'Steeped for 18 hours for maximum smoothness.',
+    },
+    {
+      name: 'Dark Roast Espresso',
+      flavors: ['bold', 'smooth'],
+      temperatures: ['hot'],
+      description: 'Bold, smoky, and perfect for a morning boost.',
+    },
+    {
+      name: 'Maple Oat Latte',
+      flavors: ['sweet', 'smooth'],
+      temperatures: ['hot', 'iced'],
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    },
+  ];
+
+  function findCoffee() {
+    const data = new FormData(form);
+    const flavor = data.get('flavor');
+    const temperature = data.get('temperature');
+    if (!form.checkValidity() || !['smooth', 'bold', 'sweet'].includes(flavor) ||
+        !['hot', 'iced', 'either'].includes(temperature)) {
+      form.reportValidity();
+      resultRegion.className = 'recommendation';
+      resultRegion.textContent = 'Please choose a flavor and serving temperature from the available options.';
+      return { status: 'error', message: resultRegion.textContent };
+    }
+
+    const candidates = drinks.filter(drink =>
+      temperature === 'either' || drink.temperatures.includes(temperature));
+    const score = drink => drink.flavors[0] === flavor ? 2 : drink.flavors.includes(flavor) ? 1 : 0;
+    const drink = candidates.reduce((best, next) => score(next) > score(best) ? next : best);
+    const servingTemperature = temperature === 'either' ? drink.temperatures[0] : temperature;
+    const message = `${drink.description} Enjoy it ${servingTemperature}.`;
+    const label = document.createElement('p');
+    label.className = 'eyebrow';
+    label.textContent = 'Your coffee match';
+    const heading = document.createElement('h3');
+    heading.textContent = drink.name;
+    const description = document.createElement('p');
+    description.textContent = message;
+    resultRegion.className = 'recommendation';
+    resultRegion.replaceChildren(label, heading, description);
+
+    return {
+      status: 'success',
+      recommendation: drink.name,
+      servingTemperature,
+      description: drink.description,
+      preferences: { flavor, temperature },
+    };
+  }
+
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    const result = findCoffee();
+    // Ordinary submissions use the same handler in browsers without WebMCP.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(JSON.stringify(result)));
+    }
+  });
+
+  form.addEventListener('change', () => {
+    resultRegion.className = '';
+    resultRegion.replaceChildren();
+  });
+  document.getElementById('find-coffee').disabled = false;
+})();
