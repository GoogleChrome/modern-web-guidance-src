+  <script>
+    const finder = document.getElementById('coffee-finder-form');
+    const result = document.getElementById('coffee-result');
+
+    function recommendCoffee({ temperature, flavor, milk }) {
+      const iced = temperature === 'iced';
+      const milkDescription = {
+        none: 'Served black, without milk.',
+        whole: 'Finished with whole milk.',
+        oat: 'Finished with creamy oat milk.'
+      };
+      let name;
+      let description;
+
+      if (flavor === 'sweet') {
+        const base = milk === 'none' ? 'Maple Americano' : milk === 'oat' ? 'Maple Oat Latte' : 'Maple Latte';
+        name = `${iced ? 'Iced ' : ''}${base}`;
+        description = 'Rich espresso with a hint of Vermont maple syrup.';
+      } else if (flavor === 'smooth') {
+        name = iced ? 'Cold Brew' : 'Americano';
+        description = iced
+          ? 'Steeped for 18 hours for a mellow, smooth finish over ice.'
+          : 'Espresso mellowed with hot water for an easy-sipping cup.';
+      } else {
+        name = iced ? 'Iced Dark Roast Espresso' : 'Dark Roast Espresso';
+        description = iced
+          ? 'Bold dark roast espresso poured over ice for a refreshing kick.'
+          : 'A rich, intense dark roast with a smoky finish.';
+      }
+
+      return {
+        name,
+        description: `${description} ${milkDescription[milk]}`,
+        preferences: { temperature, flavor, milk },
+        orderPlaced: false
+      };
+    }
+
+    finder.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const respond = (value) => {
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(value));
+        }
+      };
+      const preferences = Object.fromEntries(new FormData(finder));
+      const allowed = {
+        temperature: ['hot', 'iced'],
+        flavor: ['bold', 'smooth', 'sweet'],
+        milk: ['none', 'whole', 'oat']
+      };
+      if (!finder.checkValidity() || Object.entries(allowed).some(([key, values]) => !values.includes(preferences[key]))) {
+        const error = 'Please choose a temperature, flavor, and milk preference.';
+        result.textContent = error;
+        finder.reportValidity();
+        respond({ error });
+        return;
+      }
+
+      const recommendation = recommendCoffee(preferences);
+      const label = document.createElement('p');
+      label.className = 'eyebrow';
+      label.textContent = 'Your coffee match';
+      const heading = document.createElement('h3');
+      heading.textContent = recommendation.name;
+      const description = document.createElement('p');
+      description.textContent = recommendation.description;
+      result.replaceChildren(label, heading, description);
+      respond(recommendation);
+    });
+
+    // Keep the displayed match in sync with the last submitted preferences.
+    finder.addEventListener('change', () => result.replaceChildren());
+  </script>
+
