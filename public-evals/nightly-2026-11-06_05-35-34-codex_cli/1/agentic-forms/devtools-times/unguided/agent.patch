diff --git a/src/hooks/useAuthForm.ts b/src/hooks/useAuthForm.ts
new file mode 100644
index 0000000..9878c5b
--- /dev/null
+++ b/src/hooks/useAuthForm.ts
@@ -0,0 +1,67 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { getModelContext, registerAuthTool, submitAuth, validateCredentials } from '../utils/auth-tools';
+import type { AuthAction, AuthResult } from '../utils/auth-tools';
+
+export function useAuthForm(action: AuthAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const pending = useRef(false);
+  const activeRequest = useRef<AbortController | null>(null);
+
+  const submit = useCallback(async (input: unknown, signal?: AbortSignal): Promise<AuthResult> => {
+    if (pending.current) return { success: false, message: 'A submission is already in progress.' };
+    signal?.throwIfAborted();
+    pending.current = true;
+    const controller = new AbortController();
+    activeRequest.current = controller;
+    const abort = () => controller.abort();
+    signal?.addEventListener('abort', abort, { once: true });
+    setError(null);
+    setSuccess(null);
+    setLoading(true);
+    if (validateCredentials(input)) {
+      setUsername(input.username);
+      setPassword(input.password);
+    }
+    try {
+      const result = await submitAuth(action, input, controller.signal);
+      if (result.success) {
+        setSuccess(result.message);
+        if (action === 'register') {
+          setUsername('');
+          setPassword('');
+        }
+      } else {
+        setError(result.message);
+      }
+      return result;
+    } finally {
+      signal?.removeEventListener('abort', abort);
+      pending.current = false;
+      activeRequest.current = null;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => {
+    const unregister = registerAuthTool(action, submit, getModelContext());
+    return () => {
+      unregister();
+      activeRequest.current?.abort();
+    };
+  }, [action, submit]);
+
+  const handleSubmit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    try {
+      await submit({ username, password });
+    } catch {
+      // Cancellation is not a failed authentication attempt.
+    }
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/utils/auth-tools.ts b/src/utils/auth-tools.ts
new file mode 100644
index 0000000..65ccc43
--- /dev/null
+++ b/src/utils/auth-tools.ts
@@ -0,0 +1,109 @@
+export type AuthAction = 'login' | 'register';
+export type Credentials = { username: string; password: string };
+export type AuthResult = { success: boolean; message: string };
+
+export function validateCredentials(input: unknown): input is Credentials {
+  if (!input || typeof input !== 'object') return false;
+  const value = input as Record<string, unknown>;
+  return Object.keys(value).every(key => key === 'username' || key === 'password') &&
+    typeof value.username === 'string' && value.username.length > 0 &&
+    typeof value.password === 'string' && value.password.length > 0;
+}
+
+export async function submitAuth(
+  action: AuthAction, input: unknown, signal?: AbortSignal,
+): Promise<AuthResult> {
+  if (!validateCredentials(input)) {
+    return { success: false, message: 'Provide a non-empty username and password.' };
+  }
+  try {
+    const response = await fetch(
+      `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(input),
+        signal,
+      },
+    );
+    const data = await response.json();
+    signal?.throwIfAborted();
+    if (!response.ok) {
+      const detail = typeof data?.error === 'string' ? data.error : 'Unknown error';
+      return { success: false, message: `${action === 'login' ? 'Login' : 'Registration'} failed: ${detail}` };
+    }
+    // Do not expose credentials or authentication tokens in tool results.
+    return {
+      success: true,
+      message: action === 'login' ? 'Login successful!' : 'User registered successfully! You can now sign in.',
+    };
+  } catch (error) {
+    if (signal?.aborted) throw error;
+    return { success: false, message: 'An unexpected error occurred. Please try again later.' };
+  }
+}
+
+type AuthTool = {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown, options?: { signal?: AbortSignal }) => Promise<{
+    content: { type: 'text'; text: string }[];
+    isError: boolean;
+  }>;
+};
+type ModelContext = {
+  registerTool: (tool: AuthTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+};
+
+// Support current WebMCP and older navigator.modelContext preview builds.
+export function registerAuthTool(
+  action: AuthAction,
+  submit: (input: unknown, signal?: AbortSignal) => Promise<AuthResult>,
+  context: ModelContext | undefined,
+): () => void {
+  if (!context) return () => {};
+  const controller = new AbortController();
+  const name = action === 'login' ? 'sign_in' : 'sign_up';
+  const tool: AuthTool = {
+    name,
+    description: action === 'login'
+      ? 'Sign in to The DevTools Times using the sign-in form.'
+      : 'Create a DevTools Times account using the sign-up form. A successful registration does not sign the user in.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        username: { type: 'string', minLength: 1, description: 'Account username.' },
+        password: {
+          type: 'string', minLength: 1,
+          description: action === 'register'
+            ? 'New account password. Must be at least 8 characters and contain a number.'
+            : 'Account password.',
+        },
+      },
+      required: ['username', 'password'],
+      additionalProperties: false,
+    },
+    async execute(input, options) {
+      const result = await submit(input, options?.signal);
+      return { content: [{ type: 'text', text: JSON.stringify(result) }], isError: !result.success };
+    },
+  };
+  try {
+    Promise.resolve(context.registerTool(tool, { signal: controller.signal })).catch(() => {
+      // Tool availability must not break the manual form.
+    });
+  } catch {
+    // Unsupported preview implementations still retain the manual form.
+  }
+  return () => {
+    controller.abort();
+    context.unregisterTool?.(name);
+  };
+}
+
+export function getModelContext(): ModelContext | undefined {
+  return (document as Document & { modelContext?: ModelContext }).modelContext ??
+    (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+}
diff --git a/tests/auth-tools.test.ts b/tests/auth-tools.test.ts
new file mode 100644
index 0000000..42da438
--- /dev/null
+++ b/tests/auth-tools.test.ts
@@ -0,0 +1,75 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { registerAuthTool, submitAuth } from '../src/utils/auth-tools.ts';
+
+test('invalid tool input never sends a request', async () => {
+  for (const input of [null, {}, { username: 'a', password: '' }, { username: 1, password: 'x' }, { username: 'a', password: 'x', extra: true }]) {
+    assert.equal((await submitAuth('login', input)).success, false);
+  }
+});
+
+test('auth actions preserve endpoints, errors, and safe results', async () => {
+  const originalFetch = globalThis.fetch;
+  const credentials = { username: 'reader', password: 'secret123' };
+  try {
+    for (const action of ['login', 'register'] as const) {
+      globalThis.fetch = async (url, options) => {
+        assert.ok(String(url).endsWith(`/api/${action}`));
+        assert.equal(options?.method, 'POST');
+        assert.deepEqual(JSON.parse(String(options?.body)), credentials);
+        return Response.json({ token: 'private-token' });
+      };
+      const result = await submitAuth(action, credentials);
+      assert.equal(result.success, true);
+      assert.ok(!JSON.stringify(result).includes('private-token'));
+      assert.ok(!JSON.stringify(result).includes(credentials.password));
+    }
+    globalThis.fetch = async () => Response.json({ error: 'APP_ERR_2001' }, { status: 401 });
+    assert.deepEqual(await submitAuth('login', credentials), { success: false, message: 'Login failed: APP_ERR_2001' });
+    globalThis.fetch = async () => { throw new TypeError('offline'); };
+    assert.equal((await submitAuth('login', credentials)).success, false);
+    globalThis.fetch = async () => new Response('invalid-json');
+    assert.equal((await submitAuth('register', credentials)).success, false);
+    const controller = new AbortController();
+    controller.abort();
+    globalThis.fetch = async (_url, options) => {
+      assert.equal(options?.signal, controller.signal);
+      options?.signal?.throwIfAborted();
+      return Response.json({});
+    };
+    await assert.rejects(submitAuth('login', credentials, controller.signal), { name: 'AbortError' });
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
+
+test('tools register with schemas, forward execution and cancellation, and clean up', async () => {
+  for (const action of ['login', 'register'] as const) {
+    let registered: any;
+    let registrationSignal: AbortSignal | undefined;
+    let removed: string | undefined;
+    const input = { username: 'reader', password: 'secret123' };
+    const execution = new AbortController();
+    const cleanup = registerAuthTool(action, async (args, signal) => {
+      assert.deepEqual(args, input);
+      assert.equal(signal, execution.signal);
+      return { success: false, message: 'Rejected' };
+    }, {
+      registerTool(tool, options) { registered = tool; registrationSignal = options?.signal; },
+      unregisterTool(name) { removed = name; },
+    });
+    assert.equal(registered.name, action === 'login' ? 'sign_in' : 'sign_up');
+    assert.deepEqual(registered.inputSchema.required, ['username', 'password']);
+    assert.equal(registered.inputSchema.additionalProperties, false);
+    const result = await registered.execute(input, { signal: execution.signal });
+    assert.equal(result.isError, true);
+    assert.deepEqual(JSON.parse(result.content[0].text), { success: false, message: 'Rejected' });
+    cleanup();
+    assert.equal(registrationSignal?.aborted, true);
+    assert.equal(removed, registered.name);
+  }
+  registerAuthTool('login', async () => ({ success: true, message: 'ok' }), undefined)();
+  registerAuthTool('login', async () => ({ success: true, message: 'ok' }), {
+    registerTool() { throw new Error('unsupported'); },
+  })();
+});
