new file mode 100644
index 0000000..933c27d
--- /dev/null
+++ b/media.js
@@ -0,0 +1,58 @@
+// Keep URLs out of fetch-triggering attributes until the player is nearby.
+// preload="none" alone does not prevent a video poster from downloading.
+const players = [...document.querySelectorAll('[data-lazy-media]')];
+
+function loadMedia(player) {
+  if (!player.hasAttribute('data-lazy-media')) return;
+  player.removeAttribute('data-lazy-media');
+
+  if (player.dataset.poster) {
+    player.setAttribute('poster', player.dataset.poster);
+    delete player.dataset.poster;
+  }
+  player.preload = player.dataset.preload || 'metadata';
+  delete player.dataset.preload;
+
+  for (const source of player.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+  player.load();
+}
+
+for (const player of document.querySelectorAll('video, audio')) {
+  player.addEventListener('error', () => {
+    const message = player.closest('figure').querySelector('.media-error');
+    if (message) message.hidden = false;
+  });
+}
+
+if ('IntersectionObserver' in window) {
+  const observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting) continue;
+      loadMedia(entry.target);
+      observer.unobserve(entry.target);
+    }
+  }, { rootMargin: '200px 0px', threshold: 0 });
+  players.forEach((player) => observer.observe(player));
+} else {
+  // Preserve strict deferral in older browsers rather than loading everything.
+  const pending = new Set(players);
+  function loadNearbyMedia() {
+    for (const player of pending) {
+      const rect = player.getBoundingClientRect();
+      if (rect.top <= window.innerHeight + 200 && rect.bottom >= -200) {
+        loadMedia(player);
+        pending.delete(player);
+      }
+    }
+    if (!pending.size) {
+      window.removeEventListener('scroll', loadNearbyMedia);
+      window.removeEventListener('resize', loadNearbyMedia);
+    }
+  }
+  window.addEventListener('scroll', loadNearbyMedia, { passive: true });
+  window.addEventListener('resize', loadNearbyMedia);
+  loadNearbyMedia();
+}
