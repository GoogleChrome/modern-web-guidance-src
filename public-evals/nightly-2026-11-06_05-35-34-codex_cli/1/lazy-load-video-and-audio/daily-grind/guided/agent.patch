diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..842c708
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,95 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const script = readFileSync(new URL('../media.js', `file://${__filename}`), 'utf8');
+
+function player(poster = false) {
+  const attributes = new Set(['data-lazy-media']);
+  const source = { dataset: { src: 'episode.mp4' } };
+  return {
+    dataset: { preload: 'metadata', ...(poster ? { poster: 'poster.jpg' } : {}) },
+    preload: 'none', source, loads: 0,
+    hasAttribute: (name) => attributes.has(name),
+    removeAttribute: (name) => attributes.delete(name),
+    setAttribute(name, value) { this[name] = value; },
+    querySelectorAll: () => [source],
+    addEventListener() {},
+    getBoundingClientRect() { return { top: this.top, bottom: this.top + 300 }; },
+    top: 2000,
+    load() { this.loads++; },
+  };
+}
+
+function run(players, observer) {
+  const listeners = new Map();
+  const window = {
+    innerHeight: 800,
+    addEventListener: (event, callback) => listeners.set(event, callback),
+    removeEventListener: (event) => listeners.delete(event),
+    ...(observer ? { IntersectionObserver: observer } : {}),
+  };
+  vm.runInNewContext(script, {
+    window, IntersectionObserver: observer,
+    document: { querySelectorAll: () => players },
+  });
+  return listeners;
+}
+
+test('offscreen media stays inert until intersection, then loads exactly once', () => {
+  const video = player(true);
+  const audio = player();
+  let notify;
+  const observed = new Set();
+  class Observer {
+    constructor(callback, options) {
+      notify = callback;
+      assert.equal(options.rootMargin, '200px 0px');
+    }
+    observe(element) { observed.add(element); }
+    unobserve(element) { observed.delete(element); }
+  }
+  run([video, audio], Observer);
+  notify([{ target: video, isIntersecting: false }]);
+  for (const item of [video, audio]) {
+    assert.equal(item.loads, 0);
+    assert.equal(item.source.src, undefined);
+    assert.equal(item.poster, undefined);
+    assert.equal(item.preload, 'none');
+  }
+  notify([{ target: video, isIntersecting: true }]);
+  assert.equal(video.poster, 'poster.jpg');
+  assert.equal(video.source.src, 'episode.mp4');
+  assert.equal(video.preload, 'metadata');
+  assert.equal(video.loads, 1);
+  assert.equal(audio.loads, 0);
+  assert.equal(observed.has(video), false);
+  notify([{ target: video, isIntersecting: true }, { target: audio, isIntersecting: true }]);
+  assert.equal(video.loads, 1);
+  assert.equal(audio.loads, 1);
+});
+
+test('fallback defers offscreen players and removes listeners after loading', () => {
+  const video = player(true);
+  const listeners = run([video]);
+  assert.equal(video.loads, 0);
+  video.top = 999;
+  listeners.get('scroll')();
+  assert.equal(video.loads, 1);
+  assert.equal(video.poster, 'poster.jpg');
+  assert.equal(listeners.size, 0);
+});
+
+test('initial HTML has no fetch-triggering URLs on lazy players', () => {
+  const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+  const lazy = [...html.matchAll(/<(video|audio)\b[^>]*data-lazy-media[^>]*>[\s\S]*?<\/\1>/g)];
+  assert.equal(lazy.length, 2);
+  for (const [markup] of lazy) {
+    assert.doesNotMatch(markup, /\s(?:src|poster)\s*=/);
+    assert.match(markup, /loading="lazy"/);
+    assert.match(markup, /preload="none"/);
+    assert.match(markup, /\scontrols\b/);
+    assert.match(markup, /data-src=/);
+  }
+  assert.match(lazy[0][0], /data-poster=/);
+});
