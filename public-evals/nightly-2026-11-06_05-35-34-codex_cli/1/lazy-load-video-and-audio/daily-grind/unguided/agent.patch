diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..258fefd
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,97 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const script = readFileSync(require.resolve('../media.js'), 'utf8');
+
+function player(top, poster = true) {
+  const source = { dataset: { src: 'https://example.com/media.mp4' } };
+  return {
+    dataset: poster ? { poster: 'https://example.com/poster.jpg' } : {},
+    source,
+    loads: 0,
+    top,
+    querySelectorAll: () => [source],
+    load() { this.loads++; },
+    getBoundingClientRect() {
+      return { top: this.top, bottom: this.top + 300, left: 0, right: 600 };
+    },
+  };
+}
+
+test('initial HTML has no fetchable media or poster URLs, preload hints, or hero background image', () => {
+  const html = readFileSync(require.resolve('../index.html'), 'utf8');
+  const players = html.match(/<(video|audio)\b[\s\S]*?<\/\1>/g);
+  assert.equal(players.length, 3);
+  for (const markup of players) {
+    assert.match(markup, /data-lazy-media/);
+    assert.match(markup, /preload="none"/);
+    assert.doesNotMatch(markup, /\s(?:src|poster|autoplay)\s*=/);
+    assert.match(markup, /data-src="https:/);
+  }
+  assert.doesNotMatch(html, /<link[^>]+rel=["'](?:preload|prefetch)/);
+  assert.doesNotMatch(html, /url\(/);
+});
+
+test('observer gates posters and sources and activates each player just once', () => {
+  const hero = player(0);
+  const roast = player(1500);
+  const audio = player(2500, false);
+  const observed = new Set();
+  let notify;
+  let options;
+  class IntersectionObserver {
+    constructor(callback, config) { notify = callback; options = config; }
+    observe(target) { observed.add(target); }
+    unobserve(target) { observed.delete(target); }
+  }
+  vm.runInNewContext(script, {
+    document: { querySelectorAll: () => [hero, roast, audio] },
+    window: { IntersectionObserver }, IntersectionObserver,
+  });
+  assert.equal(options.rootMargin, '200px');
+  for (const target of observed) {
+    assert.equal(target.loads, 0);
+    assert.equal(target.poster, undefined);
+    assert.equal(target.source.src, undefined);
+  }
+  notify([{ target: hero, isIntersecting: true }, { target: roast, isIntersecting: false }]);
+  assert.equal(hero.loads, 1);
+  assert.equal(hero.poster, 'https://example.com/poster.jpg');
+  assert.equal(hero.source.src, 'https://example.com/media.mp4');
+  assert.equal(hero.preload, 'metadata');
+  assert.equal(observed.has(hero), false);
+  assert.equal(roast.loads, 0);
+  assert.equal(audio.loads, 0);
+  notify([{ target: hero, isIntersecting: true }, { target: audio, isIntersecting: true }]);
+  assert.equal(hero.loads, 1);
+  assert.equal(audio.loads, 1);
+  assert.equal(audio.poster, undefined);
+  assert.equal(roast.source.src, undefined);
+});
+
+test('fallback defers distant media and cleans up listeners when all players approach', () => {
+  const hero = player(0);
+  const roast = player(1500);
+  const listeners = new Map();
+  vm.runInNewContext(script, {
+    document: { querySelectorAll: () => [hero, roast] },
+    window: {
+      innerHeight: 800, innerWidth: 1200,
+      addEventListener: (type, fn) => listeners.set(type, fn),
+      removeEventListener: (type) => listeners.delete(type),
+    },
+  });
+  assert.equal(hero.loads, 1);
+  assert.equal(roast.loads, 0);
+  assert.equal(roast.poster, undefined);
+  assert.equal(roast.source.src, undefined);
+  roast.top = 1001;
+  listeners.get('scroll')();
+  assert.equal(roast.loads, 0);
+  roast.top = 1000;
+  listeners.get('resize')();
+  assert.equal(roast.loads, 1);
+  assert.equal(listeners.size, 0);
+});
