diff --git a/media.js b/media.js
new file mode 100644
index 0000000..fae7e74
--- /dev/null
+++ b/media.js
@@ -0,0 +1,50 @@
+(() => {
+  // Keep both posters and media URLs inert until the player is near the viewport.
+  // preload="none" alone does not prevent a video poster from downloading.
+  const pending = new Set(document.querySelectorAll('[data-lazy-media]'));
+  const margin = 200;
+
+  function activate(player) {
+    if (!pending.delete(player)) return;
+    if (player.dataset.poster) {
+      player.poster = player.dataset.poster;
+      delete player.dataset.poster;
+    }
+    player.querySelectorAll('source[data-src]').forEach((source) => {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    });
+    // Metadata is allowed only after activation. Playback always requires a user action.
+    player.preload = 'metadata';
+    player.load();
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver((entries) => {
+      entries.forEach(({ target, isIntersecting }) => {
+        if (!isIntersecting) return;
+        activate(target);
+        observer.unobserve(target);
+      });
+    }, { rootMargin: `${margin}px`, threshold: 0 });
+    pending.forEach((player) => observer.observe(player));
+  } else {
+    // Preserve deferral in older browsers instead of eagerly loading every player.
+    function checkViewport() {
+      pending.forEach((player) => {
+        const rect = player.getBoundingClientRect();
+        if (rect.bottom >= -margin && rect.top <= window.innerHeight + margin &&
+            rect.right >= -margin && rect.left <= window.innerWidth + margin) {
+          activate(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', checkViewport);
+        window.removeEventListener('resize', checkViewport);
+      }
+    }
+    window.addEventListener('scroll', checkViewport, { passive: true });
+    window.addEventListener('resize', checkViewport);
+    checkViewport();
+  }
+})();
