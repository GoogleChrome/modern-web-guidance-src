diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..e87846e
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,73 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Includes the active view. Old views are evicted in least-recently-used order.
+const MAX_VIEWS = 5;
+const VIEW = "[data-route-view]";
+const CACHE = "[data-view-cache]";
+
+export function installViewCache(doc: Document) {
+  const recency = new Map<HTMLElement, number>();
+  let clock = 0;
+
+  const beforeSwap = (event: TransitionBeforeSwapEvent) => {
+    const swap = event.swap;
+    event.swap = () => {
+      // Preparation can be superseded while Astro waits for an animation.
+      if (event.signal.aborted) return;
+
+      const cache = doc.querySelector<HTMLElement>(CACHE);
+      const incomingCache = event.newDocument.querySelector<HTMLElement>(CACHE);
+      const incoming = incomingCache?.querySelector<HTMLElement>(VIEW);
+      if (!cache || !incomingCache || !incoming) {
+        recency.clear();
+        swap();
+        return;
+      }
+
+      const key = event.to.pathname + event.to.search;
+      const views = Array.from(cache.children) as HTMLElement[];
+      const restored = incoming.dataset.cacheView === "true"
+        ? views.find((view) => view.dataset.viewKey === key && view.dataset.cacheView === "true")
+        : undefined;
+
+      // Leave a fresh view in the incoming body until Astro has processed its
+      // scripts and media. The persistent container will replace incomingCache.
+      if (restored) incoming.remove();
+      else incomingCache.before(incoming);
+
+      for (const view of views) {
+        if (view === restored) continue;
+        view.hidden = true;
+        view.inert = true;
+        for (const media of view.querySelectorAll<HTMLMediaElement>("audio, video")) {
+          media.pause();
+        }
+        if (!recency.has(view)) recency.set(view, ++clock);
+        if (view.dataset.cacheView !== "true") {
+          view.remove();
+          recency.delete(view);
+        }
+      }
+
+      swap();
+
+      const active = restored ?? doc.querySelector<HTMLElement>(VIEW + ":not([hidden])");
+      if (!active) return;
+      if (!restored) cache.append(active);
+      active.dataset.viewKey = key;
+      active.hidden = false;
+      active.inert = false;
+      recency.set(active, ++clock);
+
+      // Removal happens before astro:after-swap so evicted islands unmount.
+      while (recency.size > MAX_VIEWS) {
+        const oldest = [...recency].reduce((a, b) => a[1] < b[1] ? a : b)[0];
+        oldest.remove();
+        recency.delete(oldest);
+      }
+    };
+  };
+
+  doc.addEventListener("astro:before-swap", beforeSwap);
+  return () => doc.removeEventListener("astro:before-swap", beforeSwap);
+}
