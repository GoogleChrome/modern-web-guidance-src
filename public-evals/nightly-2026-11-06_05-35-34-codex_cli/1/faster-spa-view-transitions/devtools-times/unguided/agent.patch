diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..0c71080
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Window } from 'happy-dom';
+import { installViewCache } from '../src/scripts/view-cache.ts';
+
+function page(doc, key, cacheable = true) {
+  doc.head.innerHTML = `<title>${key}</title>`;
+  doc.body.innerHTML = `<div data-view-cache data-astro-transition-persist="route-view-cache">
+    <main data-route-view data-view-key="${key}" data-cache-view="${cacheable}">
+      <input value="original"><button>Click</button><script type="application/json">{}</script>
+    </main>
+  </div>`;
+}
+
+function harness(t) {
+  const window = new Window({ url: 'https://example.test/devtools-times/' });
+  t.after(() => window.happyDOM.abort());
+  const doc = window.document;
+  page(doc, '/devtools-times/');
+  installViewCache(doc);
+  const active = () => doc.querySelector('[data-route-view]:not([hidden])');
+  function navigate(key, { cacheable = true, aborted = false, compatible = true } = {}) {
+    const incoming = doc.implementation.createHTMLDocument();
+    page(incoming, key, cacheable);
+    if (!compatible) incoming.body.innerHTML = '<p>Other layout</p>';
+    const event = new window.Event('astro:before-swap');
+    const controller = new AbortController();
+    if (aborted) controller.abort();
+    Object.assign(event, {
+      to: new URL(key, window.location.href),
+      newDocument: incoming,
+      signal: controller.signal,
+      // Model Astro's transition:persist transfer and fresh head/body swap.
+      swap() {
+        const cache = doc.querySelector('[data-view-cache]');
+        const target = incoming.querySelector('[data-view-cache]');
+        doc.head.replaceWith(incoming.head);
+        doc.body.replaceWith(incoming.body);
+        if (cache && target) target.replaceWith(cache);
+      },
+    });
+    doc.dispatchEvent(event);
+    event.swap();
+    doc.dispatchEvent(new window.Event('astro:after-swap'));
+    return active();
+  }
+  return { window, doc, active, navigate };
+}
+
+test('return navigation preserves node identity, input values, and listeners', (t) => {
+  const { window, doc, active, navigate } = harness(t);
+  const home = active();
+  const input = home.querySelector('input');
+  input.value = 'edited';
+  let clicks = 0;
+  home.querySelector('button').addEventListener('click', () => clicks++);
+  const article = navigate('/devtools-times/articles/example');
+  assert.equal(home.isConnected, true);
+  assert.equal(home.hidden, true);
+  assert.equal(home.inert, true);
+  assert.equal(article.hidden, false);
+  assert.equal(navigate('/devtools-times/#section'), home);
+  assert.equal(input.value, 'edited');
+  home.querySelector('button').dispatchEvent(new window.Event('click'));
+  assert.equal(clicks, 1);
+  assert.equal(home.inert, false);
+  assert.equal(doc.title, '/devtools-times/#section');
+  assert.equal(doc.querySelectorAll('[data-route-view]:not([hidden])').length, 1);
+  assert.equal(navigate('/devtools-times/articles/example'), article);
+});
+
+test('query strings select separate views while hash changes reuse a view', (t) => {
+  const { navigate } = harness(t);
+  const first = navigate('/devtools-times/?page=1');
+  const second = navigate('/devtools-times/?page=2');
+  assert.notEqual(first, second);
+  assert.equal(navigate('/devtools-times/?page=1#news'), first);
+});
+
+test('least recently used views are evicted, keeping five mounted views', (t) => {
+  const { doc, active, navigate } = harness(t);
+  const home = active();
+  const first = navigate('/devtools-times/1');
+  for (let i = 2; i <= 4; i++) navigate(`/devtools-times/${i}`);
+  navigate('/devtools-times/');
+  navigate('/devtools-times/5');
+  assert.equal(home.isConnected, true);
+  assert.equal(first.isConnected, false);
+  assert.equal(doc.querySelectorAll('[data-route-view]').length, 5);
+  assert.notEqual(navigate('/devtools-times/1'), first);
+});
+
+test('opted-out forms are removed when leaving and created afresh on return', (t) => {
+  const { navigate } = harness(t);
+  const form = navigate('/devtools-times/signin', { cacheable: false });
+  form.querySelector('input').value = 'secret';
+  navigate('/devtools-times/');
+  assert.equal(form.isConnected, false);
+  const fresh = navigate('/devtools-times/signin', { cacheable: false });
+  assert.notEqual(fresh, form);
+  assert.equal(fresh.querySelector('input').value, 'original');
+});
+
+test('aborted transitions leave the active DOM intact', (t) => {
+  const { doc, active, navigate } = harness(t);
+  const home = active();
+  assert.equal(navigate('/devtools-times/cancelled', { aborted: true }), home);
+  assert.equal(home.hidden, false);
+  assert.equal(doc.title, '/devtools-times/');
+});
+
+test('destinations with another layout use the normal swap', (t) => {
+  const { doc, navigate } = harness(t);
+  navigate('/other', { compatible: false });
+  assert.equal(doc.body.textContent, 'Other layout');
+  assert.equal(doc.querySelector('[data-view-cache]'), null);
+});
