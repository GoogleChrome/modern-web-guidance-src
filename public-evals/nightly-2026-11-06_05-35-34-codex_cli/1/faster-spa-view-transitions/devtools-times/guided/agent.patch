diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..c91faa1
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,72 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Includes the active view. Map insertion order tracks least recent use.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const keyFor = (url: URL) => url.pathname + url.search;
+let activeView: HTMLElement | undefined;
+
+function activate(view: HTMLElement) {
+  delete view.dataset.inactive;
+  view.inert = false;
+  view.removeAttribute("aria-hidden");
+  activeView = view;
+}
+
+function remember(key: string, view: HTMLElement) {
+  views.delete(key);
+  views.set(key, view);
+  while (views.size > MAX_VIEWS) {
+    const oldest = views.keys().next().value!;
+    views.get(oldest)!.remove();
+    views.delete(oldest);
+  }
+}
+
+function initialize() {
+  const host = document.getElementById("spa-view-cache");
+  const view = document.querySelector<HTMLElement>("main > [data-spa-view]");
+  if (!host || !view) return;
+  host.append(view);
+  activate(view);
+  if (view.dataset.cacheView === "true") {
+    remember(keyFor(new URL(location.href)), view);
+  }
+}
+
+initialize();
+
+document.addEventListener("astro:before-swap", (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  const incoming = navigation.newDocument.querySelector<HTMLElement>("main > [data-spa-view]");
+  const incomingHost = navigation.newDocument.getElementById("spa-view-cache");
+  const host = document.getElementById("spa-view-cache");
+  if (!host || !incomingHost || !incoming) return;
+
+  const swap = navigation.swap;
+  navigation.swap = () => {
+    const key = keyFor(navigation.to);
+    const cached = incoming.dataset.cacheView === "true" ? views.get(key) : undefined;
+
+    if (activeView) {
+      // Hidden media must not continue playing in a background view.
+      activeView.querySelectorAll<HTMLMediaElement>("video, audio").forEach((media) => media.pause());
+      activeView.dataset.inactive = "";
+      activeView.inert = true;
+      activeView.setAttribute("aria-hidden", "true");
+      if (activeView.dataset.cacheView !== "true") activeView.remove();
+    }
+
+    // Drop only the newly fetched markup on a cache hit, keeping the live nodes.
+    if (cached) incoming.remove();
+    swap();
+
+    const view = cached ?? incoming;
+    // New views first pass through Astro's normal body swap (including its
+    // media/shadow-root setup); the persistent host carries cached views.
+    if (!cached) host.append(view);
+    activate(view);
+    if (view.dataset.cacheView === "true") remember(key, view);
+    view.focus({ preventScroll: true });
+  };
+});
