+(() => {
+  const views = new Map(
+    [...document.querySelectorAll('[data-view]')].map(view => [view.dataset.view, view])
+  );
+  const links = document.querySelectorAll('[data-view-link]');
+  const scrollPositions = new Map();
+  const titles = { home: 'Artisanal Coffee', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+  let activeView;
+
+  // Hash routes also work on static hosting without a server-side route fallback.
+  function routeFromHash() {
+    const route = window.location.hash.slice(2);
+    return window.location.hash.startsWith('#/') && views.has(route) ? route : 'home';
+  }
+
+  function showView() {
+    const nextView = routeFromHash();
+    if (nextView === activeView) return;
+    if (activeView) scrollPositions.set(activeView, window.scrollY);
+
+    // Never replace, detach, or rebuild a visited view's DOM.
+    for (const [name, view] of views) {
+      const inactive = name !== nextView;
+      view.classList.toggle('inactive', inactive);
+      view.inert = inactive;
+      view.setAttribute('aria-hidden', String(inactive));
+    }
+    for (const link of links) {
+      if (link.dataset.viewLink === nextView) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+    document.title = `The Daily Grind | ${titles[nextView]}`;
+    const navigating = activeView !== undefined;
+    activeView = nextView;
+    if (navigating) {
+      views.get(nextView).focus({ preventScroll: true });
+      window.scrollTo({ top: scrollPositions.get(nextView) || 0, behavior: 'instant' });
+    }
+  }
+
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', showView);
+  // Re-selecting the active route should not jump to the top or add history.
+  for (const link of links) {
+    link.addEventListener('click', event => {
+      if (event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
+          link.dataset.viewLink === activeView) event.preventDefault();
+    });
+  }
+  showView();
+
+  document.getElementById('menu-filter').addEventListener('change', event => {
+    for (const card of document.querySelectorAll('[data-category]')) {
+      card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+    }
+  });
+
+  document.getElementById('location-search').addEventListener('input', event => {
+    const query = event.target.value.trim().toLowerCase();
+    let count = 0;
+    for (const location of document.querySelectorAll('[data-location]')) {
+      location.hidden = !location.dataset.location.includes(query);
+      if (!location.hidden) count++;
+    }
+    document.getElementById('location-count').textContent = count
+      ? `${count} location${count === 1 ? '' : 's'}` : 'No locations match your search.';
+  });
+
+  document.getElementById('account-form').addEventListener('submit', event => {
+    event.preventDefault();
+    document.getElementById('account-status').textContent = 'Preferences saved for this visit.';
+  });
+})();
