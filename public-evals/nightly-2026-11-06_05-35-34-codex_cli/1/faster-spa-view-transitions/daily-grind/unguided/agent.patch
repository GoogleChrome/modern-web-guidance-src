+(() => {
+  const container = document.querySelector('#views');
+  const views = new Map([['home', container.querySelector('[data-view="home"]')]]);
+  const routes = new Set(['home', 'menu', 'locations', 'rewards', 'account']);
+  const scrollPositions = new Map();
+  let activeRoute;
+
+  function initializeView(route, view) {
+    if (route === 'menu') {
+      view.querySelector('#menu-category').addEventListener('change', (event) => {
+        for (const card of view.querySelectorAll('[data-category]')) {
+          card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+        }
+      });
+    }
+
+    if (route === 'locations') {
+      view.querySelector('#location-search').addEventListener('input', (event) => {
+        const query = event.target.value.trim().toLowerCase();
+        let matches = 0;
+        for (const card of view.querySelectorAll('[data-location]')) {
+          card.hidden = !card.textContent.toLowerCase().includes(query);
+          if (!card.hidden) matches++;
+        }
+        view.querySelector('#location-empty').hidden = matches > 0;
+      });
+    }
+
+    const form = view.querySelector('form');
+    if (form) {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        form.querySelector('[role="status"]').textContent = route === 'account'
+          ? 'Preferences saved for this visit.'
+          : 'Your interest has been noted for this demo visit. No email has been sent.';
+      });
+    }
+  }
+
+  function showView() {
+    const requestedRoute = location.hash.replace(/^#\/?/, '').replace(/\/$/, '') || 'home';
+    const route = routes.has(requestedRoute) ? requestedRoute : 'home';
+    if (route === activeRoute) return;
+
+    if (activeRoute) {
+      scrollPositions.set(activeRoute, window.scrollY);
+    }
+    for (const cachedView of views.values()) cachedView.hidden = true;
+
+    // Mount each view once. Keep its DOM and listeners alive between visits.
+    if (!views.has(route)) {
+      const view = document.querySelector(`#${route}-view`).content.firstElementChild.cloneNode(true);
+      container.append(view);
+      initializeView(route, view);
+      views.set(route, view);
+    }
+
+    const view = views.get(route);
+    view.hidden = false;
+    for (const link of document.querySelectorAll('nav a')) {
+      if (link.hash === (route === 'home' ? '#/' : `#/${route}`)) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+
+    const heading = view.querySelector('h1');
+    document.title = route === 'home'
+      ? 'The Daily Grind | Artisanal Coffee'
+      : `${heading.textContent} | The Daily Grind`;
+    if (activeRoute) heading.focus({ preventScroll: true });
+    window.scrollTo(0, scrollPositions.get(route) || 0);
+    activeRoute = route;
+  }
+
+  // Hash URLs support direct links and browser history on a static host.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', showView);
+  showView();
+})();
