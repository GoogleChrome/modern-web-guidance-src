--- /dev/null
+++ b/app.mjs
@@ -0,0 +1,119 @@
+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export const connectionAllowlist = '(response-origin "https://images.unsplash.com")';
+
+// Only this module's handler is imported by tests; it never opens a socket.
+export async function createHandler({
+  signupFile = process.env.NEWSLETTER_FILE || resolve('data/newsletter.jsonl'),
+  saveSignup = async (email) => {
+    await mkdir(dirname(signupFile), { recursive: true, mode: 0o700 });
+    await appendFile(signupFile, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+  },
+} = {}) {
+  const [html, css, js] = await Promise.all([
+    readFile(new URL('./index.html', import.meta.url), 'utf8'),
+    readFile(new URL('./public/styles.css', import.meta.url)),
+    readFile(new URL('./public/newsletter.js', import.meta.url)),
+  ]);
+
+  return async function handler(req, res) {
+    const nonce = randomBytes(18).toString('base64');
+    // Apply to every response, including documents, errors, and potential worker loads.
+    // Defaults intentionally block redirects and WebRTC. No wildcard hosts are trusted.
+    res.setHeader('Connection-Allowlist', connectionAllowlist);
+    res.setHeader('Content-Security-Policy', [
+      "default-src 'none'",
+      `script-src 'nonce-${nonce}'`,
+      "script-src-attr 'none'",
+      "style-src 'self'",
+      "img-src 'self' https://images.unsplash.com",
+      "connect-src 'self'",
+      "form-action 'self'",
+      "worker-src 'none'",
+      "frame-src 'none'",
+      "object-src 'none'",
+      "base-uri 'none'",
+      "frame-ancestors 'none'",
+      "require-trusted-types-for 'script'",
+    ].join('; '));
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('X-DNS-Prefetch-Control', 'off');
+    res.setHeader('Cache-Control', 'no-store');
+
+    function send(code, type, body) {
+      res.statusCode = code;
+      res.setHeader('Content-Type', `${type}; charset=utf-8`);
+      res.end(req.method === 'HEAD' ? undefined : body);
+    }
+
+    const path = req.url?.split('?')[0];
+    if (path === '/api/newsletter') {
+      const wantsJson = req.headers.accept?.includes('application/json');
+      function result(code, message) {
+        if (wantsJson) return send(code, 'application/json', JSON.stringify({ ok: code === 201, message }));
+        return send(code, 'text/html', `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Daily Grind newsletter</title><link rel="stylesheet" href="/styles.css"><main class="container"><h1>Daily Grind newsletter</h1><p>${message}</p><a href="/">Return to the homepage</a></main></html>`);
+      }
+
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return result(405, 'Please use the newsletter signup form.');
+      }
+      // Reject browser cross-origin writes, including other subdomains. Origin's
+      // host comparison also works behind an HTTPS-terminating reverse proxy.
+      const origin = req.headers.origin;
+      let sameOrigin = true;
+      if (origin) {
+        try {
+          const parsed = new URL(origin);
+          sameOrigin = ['http:', 'https:'].includes(parsed.protocol) && parsed.host === req.headers.host;
+        } catch { sameOrigin = false; }
+      }
+      if (!sameOrigin || ['cross-site', 'same-site'].includes(req.headers['sec-fetch-site'])) {
+        return result(403, 'Please sign up from the Daily Grind homepage.');
+      }
+      const type = req.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return result(415, 'Please use the newsletter signup form.');
+      }
+      let email;
+      try {
+        const chunks = [];
+        let size = 0;
+        for await (const chunk of req) {
+          size += Buffer.byteLength(chunk);
+          if (size > 4096) return result(413, 'Your signup is too large. Please enter just your email address.');
+          chunks.push(Buffer.from(chunk));
+        }
+        const raw = Buffer.concat(chunks).toString('utf8');
+        const data = type === 'application/json' ? JSON.parse(raw) : Object.fromEntries(new URLSearchParams(raw));
+        email = typeof data?.email === 'string' ? data.email.trim() : '';
+      } catch {
+        return result(400, 'We couldn’t read your signup. Please try again.');
+      }
+      if (email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+        return result(400, 'Please enter a valid email address.');
+      }
+      try {
+        await saveSignup(email);
+        return result(201, 'Thanks! You’re on the Daily Grind newsletter list.');
+      } catch {
+        return result(503, 'We couldn’t save your signup. Please try again later.');
+      }
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'text/plain', 'Method not allowed');
+    }
+    if (path === '/' || path === '/index.html') {
+      return send(200, 'text/html', html.replace('{{SCRIPT_NONCE}}', nonce));
+    }
+    if (path === '/styles.css') return send(200, 'text/css', css);
+    if (path === '/newsletter.js') return send(200, 'text/javascript', js);
+    return send(404, 'text/plain', 'Page not found');
+  };
+}
