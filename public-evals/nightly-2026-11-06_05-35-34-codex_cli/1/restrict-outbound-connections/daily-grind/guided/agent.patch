+import { createServer } from 'node:http';
+import { createHandler } from './app.mjs';
+
+const handler = await createHandler();
+const server = createServer(handler);
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
diff --git a/test/app.test.mjs b/test/app.test.mjs
new file mode 100644
index 0000000..006bc5a
--- /dev/null
+++ b/test/app.test.mjs
@@ -0,0 +1,77 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHandler } from '../app.mjs';
+
+async function request(handler, { url = '/', method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from(body ? [body] : []);
+  Object.assign(req, { url, method, headers: { host: 'dailygrind.test', ...headers } });
+  const res = { headers: {}, setHeader(name, value) { this.headers[name.toLowerCase()] = value; }, end(body) { this.body = body?.toString() || ''; } };
+  await handler(req, res);
+  return res;
+}
+
+const post = (body, headers = {}) => ({ url: '/api/newsletter', method: 'POST', body, headers: { 'content-type': 'application/json', accept: 'application/json', ...headers } });
+
+test('document enforces exact outbound hosts and authorizes only the intended script', async () => {
+  const handler = await createHandler();
+  const first = await request(handler);
+  const second = await request(handler);
+  assert.equal(first.headers['connection-allowlist'], '(response-origin "https://images.unsplash.com")');
+  const csp = first.headers['content-security-policy'];
+  for (const directive of ["connect-src 'self'", "form-action 'self'", "worker-src 'none'", "img-src 'self' https://images.unsplash.com", "base-uri 'none'"]) assert.ok(csp.includes(directive));
+  assert.ok(!csp.includes('unsafe-inline') && !csp.includes('unsafe-eval'));
+  const nonce = first.body.match(/<script nonce="([^"]+)"/)[1];
+  assert.ok(csp.includes(`script-src 'nonce-${nonce}'`));
+  assert.ok(!second.headers['content-security-policy'].includes(nonce));
+  assert.ok(!first.body.includes('<style>') && !first.body.includes('style="'));
+  for (const url of ['/newsletter.js', '/styles.css', '/missing', '/data/newsletter.jsonl', '/package.json']) {
+    const response = await request(handler, { url });
+    assert.equal(response.headers['connection-allowlist'], first.headers['connection-allowlist']);
+    if (url.startsWith('/data') || url === '/package.json') assert.equal(response.statusCode, 404);
+  }
+});
+
+test('valid submissions are persisted locally and native POST works without JavaScript', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'dailygrind-'));
+  try {
+    const signupFile = join(directory, 'private', 'newsletter.jsonl');
+    const handler = await createHandler({ signupFile });
+    const json = await request(handler, post(JSON.stringify({ email: ' coffee@example.com ' })));
+    assert.equal(json.statusCode, 201);
+    assert.equal(JSON.parse(json.body).ok, true);
+    const native = await request(handler, post('email=reader%40example.com', { 'content-type': 'application/x-www-form-urlencoded', accept: 'text/html' }));
+    assert.equal(native.statusCode, 201);
+    assert.match(native.body, /Thanks!/);
+    const saved = (await readFile(signupFile, 'utf8')).trim().split('\n').map(JSON.parse);
+    assert.deepEqual(saved.map(row => row.email), ['coffee@example.com', 'reader@example.com']);
+  } finally { await rm(directory, { recursive: true, force: true }); }
+});
+
+test('rejects malformed, oversized, cross-origin and unsupported submissions without storing them', async () => {
+  let saves = 0;
+  const handler = await createHandler({ saveSignup: async () => { saves++; } });
+  for (const [options, code] of [
+    [post('{'), 400],
+    [post('{"email":"bad"}'), 400],
+    [post('null'), 400],
+    [post('x'.repeat(4097)), 413],
+    [post('{"email":"ok@example.com"}', { origin: 'https://evil.test' }), 403],
+    [post('{"email":"ok@example.com"}', { 'sec-fetch-site': 'same-site' }), 403],
+    [post('email=x@example.com', { 'content-type': 'text/plain' }), 415],
+    [{ url: '/api/newsletter' }, 405],
+  ]) assert.equal((await request(handler, options)).statusCode, code);
+  assert.equal(saves, 0);
+});
+
+test('storage errors return a retry message instead of claiming success', async () => {
+  const handler = await createHandler({ saveSignup: async () => { throw new Error('disk unavailable'); } });
+  const res = await request(handler, post('{"email":"coffee@example.com"}'));
+  assert.equal(res.statusCode, 503);
+  assert.equal(JSON.parse(res.body).ok, false);
+  assert.match(res.body, /try again later/);
+  assert.ok(!res.body.includes('disk unavailable'));
+});
