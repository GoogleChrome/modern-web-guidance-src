+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+
+const source = await readFile(new URL('../public/newsletter.js', import.meta.url), 'utf8');
+
+async function submit(fetch) {
+  let listener;
+  let cleared = false;
+  const button = { disabled: false };
+  const status = { textContent: '' };
+  const form = { elements: { email: { value: 'coffee@example.com' } }, querySelector: () => button, addEventListener: (_, fn) => { listener = fn; }, reset() { this.resetCalled = true; } };
+  vm.runInNewContext(source, {
+    document: { querySelector: (selector) => selector === '#newsletter-form' ? form : status },
+    fetch, AbortController, setTimeout: () => 1, clearTimeout: () => { cleared = true; },
+  });
+  await listener({ preventDefault() {} });
+  assert.equal(button.disabled, false);
+  assert.equal(cleared, true);
+  return { form, status };
+}
+
+test('signup posts to our server and clears the field only after confirmed success', async () => {
+  const { form, status } = await submit(async (url, options) => {
+    assert.equal(url, '/api/newsletter');
+    assert.equal(options.method, 'POST');
+    assert.equal(options.redirect, 'error');
+    assert.equal(JSON.parse(options.body).email, 'coffee@example.com');
+    return { ok: true, json: async () => ({ ok: true }) };
+  });
+  assert.equal(form.resetCalled, true);
+  assert.match(status.textContent, /Thanks!/);
+});
+
+test('network policy blocks, offline errors, timeouts, HTTP failures and malformed responses show a retry state', async () => {
+  for (const fetch of [
+    async () => { throw new TypeError('network blocked'); },
+    async () => { throw new DOMException('timeout', 'AbortError'); },
+    async () => ({ ok: false }),
+    async () => ({ ok: true, json: async () => { throw new SyntaxError(); } }),
+    async () => ({ ok: true, json: async () => ({ ok: false }) }),
+  ]) {
+    const { form, status } = await submit(fetch);
+    assert.match(status.textContent, /try again/);
+    assert.equal(form.resetCalled, undefined);
+    assert.equal(form.elements.email.value, 'coffee@example.com');
+  }
+});
