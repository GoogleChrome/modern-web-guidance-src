+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+export const contentSecurityPolicy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+export function createHandler({
+  signupFile = process.env.NEWSLETTER_FILE || join(root, 'data', 'newsletter.jsonl'),
+} = {}) {
+  return async (req, res) => {
+    res.setHeader('Content-Security-Policy', contentSecurityPolicy);
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('Cache-Control', 'no-store');
+    const send = (code, message, type = 'application/json; charset=utf-8') => {
+      res.writeHead(code, { 'Content-Type': type });
+      res.end(type.startsWith('application/json') ? JSON.stringify({ message }) : message);
+    };
+    try {
+      const path = new URL(req.url, 'http://localhost').pathname;
+      if (path === '/api/newsletter') {
+        if (req.method !== 'POST') {
+          res.setHeader('Allow', 'POST');
+          return send(405, 'Please submit the signup form.');
+        }
+        // Browsers must submit this form from this site's own origin.
+        if (req.headers['sec-fetch-site'] === 'cross-site') return send(403, 'Request blocked.');
+        const type = (req.headers['content-type'] || '').split(';')[0].trim();
+        if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+          return send(415, 'Unsupported request format.');
+        }
+        let body = '';
+        let size = 0;
+        for await (const chunk of req) {
+          size += Buffer.byteLength(chunk);
+          if (size > 2048) return send(413, 'Signup request is too large.');
+          body += chunk;
+        }
+        let data;
+        try {
+          data = type === 'application/json' ? JSON.parse(body) : Object.fromEntries(new URLSearchParams(body));
+        } catch {
+          return send(400, 'Please provide a valid email address.');
+        }
+        const email = typeof data?.email === 'string' ? data.email.trim() : '';
+        if (email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+          return send(400, 'Please provide a valid email address.');
+        }
+        await mkdir(dirname(signupFile), { recursive: true, mode: 0o700 });
+        await appendFile(signupFile, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+        if (type === 'application/x-www-form-urlencoded') {
+          return send(201, '<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Thanks for signing up</title><p>Thanks! You’re on the Daily Grind newsletter list.</p><a href="/">Back to the homepage</a></html>', 'text/html; charset=utf-8');
+        }
+        return send(201, 'Thanks for signing up!');
+      }
+      const asset = assets.get(path);
+      if (!asset) return send(404, 'Page not found.');
+      if (!['GET', 'HEAD'].includes(req.method)) {
+        res.setHeader('Allow', 'GET, HEAD');
+        return send(405, 'Method not allowed.');
+      }
+      const body = await readFile(join(root, asset[0]));
+      res.writeHead(200, { 'Content-Type': asset[1] });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    } catch {
+      send(500, 'We couldn’t complete your request. Please try again.');
+    }
+  };
+}
