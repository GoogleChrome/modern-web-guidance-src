diff --git a/test/newsletter.test.mjs b/test/newsletter.test.mjs
new file mode 100644
index 0000000..89e60d3
--- /dev/null
+++ b/test/newsletter.test.mjs
@@ -0,0 +1,92 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import vm from 'node:vm';
+import { createHandler } from '../server/app.mjs';
+
+async function request(handler, url, { method = 'GET', body = '', headers = {} } = {}) {
+  const req = Readable.from([Buffer.from(body)]);
+  Object.assign(req, { url, method, headers });
+  const response = { headers: {}, setHeader(k, v) { this.headers[k.toLowerCase()] = v; },
+    writeHead(code, headers) { this.status = code; for (const [k, v] of Object.entries(headers)) this.setHeader(k, v); },
+    end(body) { this.body = body?.toString() || ''; } };
+  await handler(req, response);
+  return response;
+}
+
+test('homepage and errors carry restrictive response headers; private files are not served', async () => {
+  const handler = createHandler();
+  for (const path of ['/', '/missing', '/data/newsletter.jsonl', '/server.mjs']) {
+    const res = await request(handler, path);
+    const csp = res.headers['content-security-policy'];
+    assert.match(csp, /default-src 'none'/);
+    assert.match(csp, /connect-src 'self'/);
+    assert.match(csp, /img-src 'self' https:\/\/images\.unsplash\.com/);
+    assert.match(csp, /form-action 'self'/);
+    assert.match(csp, /base-uri 'none'/);
+    assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|\*/);
+    assert.equal(res.status, path === '/' ? 200 : 404);
+  }
+  const home = await request(handler, '/');
+  assert.doesNotMatch(home.body, /<style|style=|<script(?! src=)/);
+});
+
+test('newsletter persists validated emails and rejects malformed, large and cross-site submissions', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'daily-grind-'));
+  try {
+    const signupFile = join(dir, 'signups.jsonl');
+    const handler = createHandler({ signupFile });
+    const post = (body, headers = {}) => request(handler, '/api/newsletter', {
+      method: 'POST', body, headers: { 'content-type': 'application/json', ...headers },
+    });
+    assert.equal((await post('{')).status, 400);
+    assert.equal((await post('{"email":"invalid"}')).status, 400);
+    assert.equal((await post('x'.repeat(2049))).status, 413);
+    assert.equal((await post('{}', { 'sec-fetch-site': 'cross-site' })).status, 403);
+    assert.equal((await post('{}', { 'content-type': 'text/plain' })).status, 415);
+    assert.equal((await request(handler, '/api/newsletter')).status, 405);
+    assert.equal((await post('{"email":" coffee@example.com "}')).status, 201);
+    const stored = JSON.parse((await readFile(signupFile, 'utf8')).trim());
+    assert.equal(stored.email, 'coffee@example.com');
+    const fallback = await post('email=reader%40example.com', { 'content-type': 'application/x-www-form-urlencoded' });
+    assert.equal(fallback.status, 201);
+    assert.match(fallback.body, /Thanks!/);
+    const failing = createHandler({ signupFile: dir });
+    assert.equal((await request(failing, '/api/newsletter', { method: 'POST', body: '{"email":"a@example.com"}', headers: { 'content-type': 'application/json' } })).status, 500);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test('signup UI handles success, HTTP failures, network failures and CSP blocks', async () => {
+  const source = await readFile(new URL('../newsletter.js', import.meta.url), 'utf8');
+  for (const outcome of ['success', 'http-error', 'network-error']) {
+    const listeners = {};
+    const status = { textContent: '' };
+    const button = { disabled: false };
+    let reset = false;
+    const form = { elements: { email: { value: 'reader@example.com' } }, querySelector: () => button,
+      addEventListener: (name, callback) => { listeners[name] = callback; }, reset: () => { reset = true; } };
+    vm.runInNewContext(source, {
+      document: { querySelector: (selector) => selector === '#request-status' ? status : form,
+        addEventListener: (name, callback) => { listeners[name] = callback; } },
+      AbortSignal,
+      fetch: async (url, options) => {
+        assert.equal(url, '/api/newsletter');
+        assert.equal(options.method, 'POST');
+        assert.equal(options.redirect, 'error');
+        if (outcome === 'network-error') throw new Error('blocked');
+        return { ok: outcome === 'success' };
+      },
+    });
+    await listeners.submit({ preventDefault() {} });
+    assert.equal(button.disabled, false);
+    assert.equal(reset, outcome === 'success');
+    assert.match(status.textContent, outcome === 'success' ? /Thanks!/ : /couldn’t complete/);
+    listeners.securitypolicyviolation({ disposition: 'enforce' });
+    assert.match(status.textContent, /blocked for your privacy/);
+  }
+});
