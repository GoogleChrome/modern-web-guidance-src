+const form = document.querySelector('.newsletter form');
+const status = document.querySelector('#request-status');
+const button = form.querySelector('button');
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (event.disposition === 'enforce') {
+    status.textContent = 'A request was blocked for your privacy. Please try again or contact us if this continues.';
+  }
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  button.disabled = true;
+  status.textContent = 'Signing you up…';
+  try {
+    const response = await fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+      signal: AbortSignal.timeout(10000),
+      redirect: 'error',
+    });
+    if (!response.ok) throw new Error('Signup failed');
+    status.textContent = 'Thanks! You’re on the list for news from the Daily Grind.';
+    form.reset();
+  } catch {
+    status.textContent = 'We couldn’t complete your signup. Please check your connection and try again.';
+  } finally {
+    button.disabled = false;
+  }
+});
