+  <script>
+    (() => {
+      const map = document.getElementById('cafe-map');
+      const pins = [...map.querySelectorAll('.map-pin')];
+      const locations = [
+        ['Old Town', 'Our original coffee house. Come for an espresso, stay for the company.', 'The original'],
+        ['West End', 'A laid-back neighborhood stop for a slow morning and your favorite roast.', 'Neighborhood favorite'],
+        ['Riverside', 'Enjoy a fresh cup and a little quiet beside the river.', 'Coffee with a view'],
+        ['Garden House', 'A cozy retreat beside the gardens, made for your afternoon coffee break.', 'A greener corner'],
+        ['Parkside', 'Pick up your daily brew before a leisurely walk through the park.', 'Walks welcome']
+      ];
+      function resetView() {
+        map.scrollLeft = 880 - map.clientWidth / 2;
+        map.scrollTop = 490 - map.clientHeight / 2;
+      }
+      document.getElementById('map-reset').addEventListener('click', resetView);
+      resetView();
+
+      // Consume both wheel deltas together so trackpads never lock to one axis.
+      map.addEventListener('wheel', (event) => {
+        if (event.ctrlKey) return; // Preserve browser pinch-to-zoom.
+        event.preventDefault();
+        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientHeight : 1;
+        const horizontal = event.shiftKey && event.deltaX === 0;
+        map.scrollLeft += (horizontal ? event.deltaY : event.deltaX) * unit;
+        map.scrollTop += (horizontal ? 0 : event.deltaY) * unit;
+      }, { passive: false });
+
+      let gesture = null;
+      let suppressClick = false;
+      map.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0 || gesture) return;
+        suppressClick = false;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY,
+          left: map.scrollLeft, top: map.scrollTop, dragged: false };
+      });
+      map.addEventListener('pointermove', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragged && Math.hypot(dx, dy) < 4) return;
+        gesture.dragged = true;
+        map.setPointerCapture(event.pointerId);
+        map.classList.add('is-dragging');
+        map.scrollLeft = gesture.left - dx;
+        map.scrollTop = gesture.top - dy;
+        gesture.x = event.clientX;
+        gesture.y = event.clientY;
+        gesture.left = map.scrollLeft;
+        gesture.top = map.scrollTop;
+      });
+      function finishGesture(event) {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        suppressClick = gesture.dragged;
+        gesture = null;
+        map.classList.remove('is-dragging');
+        if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+      }
+      window.addEventListener('pointerup', finishGesture);
+      window.addEventListener('pointercancel', finishGesture);
+      map.addEventListener('lostpointercapture', finishGesture);
+      map.addEventListener('click', (event) => {
+        if (suppressClick && event.detail !== 0) {
+          event.preventDefault();
+          event.stopPropagation();
+          suppressClick = false;
+          return;
+        }
+        const pin = event.target.closest('.map-pin');
+        if (!pin) return;
+        const index = Number(pin.dataset.location);
+        pins.forEach((item) => item.setAttribute('aria-pressed', String(item === pin)));
+        document.getElementById('location-number').textContent = String(index + 1).padStart(2, '0');
+        document.getElementById('location-name').textContent = 'The Daily Grind · ' + locations[index][0];
+        document.getElementById('location-description').textContent = locations[index][1];
+        document.getElementById('location-tag').textContent = locations[index][2];
+      });
+      map.addEventListener('keydown', (event) => {
+        const directions = { ArrowLeft: [-60, 0], ArrowRight: [60, 0], ArrowUp: [0, -60], ArrowDown: [0, 60] };
+        if (!directions[event.key]) return;
+        event.preventDefault();
+        map.scrollLeft += directions[event.key][0];
+        map.scrollTop += directions[event.key][1];
+      });
+    })();
+  </script>
 </body>
 
