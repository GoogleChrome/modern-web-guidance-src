+  <script>
+    const mapViewport = document.querySelector('.map-viewport');
+    const needsPanFallback = !CSS.supports('scroll-axis-lock', 'none');
+    let mapPointer = null;
+
+    // Start near the central café, with room to explore on both axes.
+    mapViewport.scrollLeft = 730 - mapViewport.clientWidth / 2;
+    mapViewport.scrollTop = 590 - mapViewport.clientHeight / 2;
+
+    if (needsPanFallback) {
+      mapViewport.classList.add('has-pan-fallback');
+      mapViewport.addEventListener('wheel', (event) => {
+        // Preserve browser zoom gestures.
+        if (event.ctrlKey || event.metaKey) return;
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? mapViewport.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? mapViewport.clientHeight : 1;
+        mapViewport.scrollLeft += event.deltaX * unitX;
+        mapViewport.scrollTop += event.deltaY * unitY;
+      }, { passive: false });
+    }
+
+    mapViewport.addEventListener('pointerdown', (event) => {
+      // Native touch scrolling remains available where axis unlocking is supported.
+      if (!needsPanFallback && event.pointerType !== 'mouse') return;
+      if (!event.isPrimary || event.button !== 0 || mapPointer) return;
+      const bounds = mapViewport.getBoundingClientRect();
+      const x = event.clientX - bounds.left - mapViewport.clientLeft;
+      const y = event.clientY - bounds.top - mapViewport.clientTop;
+      // Leave native scrollbars draggable.
+      if (x < 0 || y < 0 || x >= mapViewport.clientWidth || y >= mapViewport.clientHeight) return;
+      mapPointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      mapViewport.focus({ preventScroll: true });
+      mapViewport.setPointerCapture(event.pointerId);
+      mapViewport.classList.add('is-panning');
+      event.preventDefault();
+    });
+
+    mapViewport.addEventListener('pointermove', (event) => {
+      if (!mapPointer || event.pointerId !== mapPointer.id) return;
+      // Apply both deltas on every move, including reversals and diagonal movement.
+      mapViewport.scrollLeft -= event.clientX - mapPointer.x;
+      mapViewport.scrollTop -= event.clientY - mapPointer.y;
+      mapPointer.x = event.clientX;
+      mapPointer.y = event.clientY;
+    });
+
+    function endMapPan(event) {
+      if (!mapPointer || event.pointerId !== mapPointer.id) return;
+      mapPointer = null;
+      mapViewport.classList.remove('is-panning');
+      if (mapViewport.hasPointerCapture(event.pointerId)) {
+        mapViewport.releasePointerCapture(event.pointerId);
+      }
+    }
+
+    mapViewport.addEventListener('pointerup', endMapPan);
+    mapViewport.addEventListener('pointercancel', endMapPan);
+    mapViewport.addEventListener('lostpointercapture', endMapPan);
+  </script>
