+  <script>
+    (() => {
+      const definitions = {
+        checkout: { name: 'Checkout', label: 'Urgent', priority: 'user-blocking', rank: 0, steps: 40 },
+        menu: { name: 'Menu update', label: 'Standard', priority: 'user-visible', rank: 1, steps: 65 },
+        telemetry: { name: 'Telemetry log', label: 'Background', priority: 'background', rank: 2, steps: 80 }
+      };
+      // Local postTask polyfill: preserve priority and FIFO order without a dependency.
+      const fallbackTasks = [];
+      let fallbackTimer = null;
+      const fallbackScheduler = {
+        postTask(callback, { priority }) {
+          return new Promise((resolve, reject) => {
+            fallbackTasks.push({ callback, resolve, reject, priority });
+            if (fallbackTimer !== null) return;
+            fallbackTimer = setTimeout(function drain() {
+              const ranks = { 'user-blocking': 0, 'user-visible': 1, background: 2 };
+              fallbackTasks.sort((a, b) => ranks[a.priority] - ranks[b.priority]);
+              const task = fallbackTasks.shift();
+              try { task.resolve(task.callback()); } catch (error) { task.reject(error); }
+              fallbackTimer = fallbackTasks.length ? setTimeout(drain, 0) : null;
+            }, 0);
+          });
+        }
+      };
+      const taskScheduler = typeof globalThis.scheduler?.postTask === 'function'
+        ? globalThis.scheduler : fallbackScheduler;
+      const yieldToBrowser = () => typeof globalThis.scheduler?.yield === 'function'
+        ? globalThis.scheduler.yield() : new Promise(resolve => setTimeout(resolve, 0));
+      const list = document.getElementById('queue-list');
+      const state = document.getElementById('queue-state');
+      const count = document.getElementById('queue-count');
+      const empty = document.getElementById('queue-empty');
+      const pending = [];
+      const history = [];
+      let sequence = 0;
+      let completed = 0;
+      let processing = false;
+
+      function render() {
+        pending.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        count.textContent = `${pending.length} pending · ${completed} completed`;
+        empty.hidden = pending.length + history.length > 0;
+        list.replaceChildren(...pending.map(task => task.row), ...history.map(task => task.row));
+        for (const task of pending) {
+          const percent = Math.floor(task.done / task.steps * 100);
+          task.status.textContent = `${task.label} · ${task === pending[0] ? 'Running' : task.done ? 'Paused' : 'Queued'} · ${percent}%`;
+          task.progress.value = percent;
+        }
+      }
+
+      function enqueue(type) {
+        const task = { ...definitions[type], id: ++sequence, done: 0 };
+        task.row = document.createElement('li');
+        task.row.className = 'queue-task';
+        const heading = document.createElement('div');
+        heading.className = 'task-heading';
+        const name = document.createElement('strong');
+        name.textContent = `${task.name} #${task.id}`;
+        task.status = document.createElement('span');
+        task.status.className = 'task-details';
+        heading.append(name, task.status);
+        task.progress = document.createElement('progress');
+        task.progress.max = 100;
+        task.progress.value = 0;
+        task.progress.setAttribute('aria-label', `${task.name} #${task.id} progress`);
+        task.row.append(heading, task.progress);
+        pending.push(task);
+      }
+
+      async function processQueue() {
+        if (processing) return;
+        processing = true;
+        state.dataset.running = 'true';
+        try {
+          while (pending.length) {
+            render();
+            const task = pending[0];
+            state.textContent = `Working · ${task.name}`;
+            await taskScheduler.postTask(() => {
+              // Recheck after scheduling: a more urgent task may have just arrived.
+              pending.sort((a, b) => a.rank - b.rank || a.id - b.id);
+              if (pending[0] !== task) return;
+              // A bounded CPU workload represents one piece of a longer operation.
+              const deadline = performance.now() + 4;
+              let value = task.done + 1;
+              while (performance.now() < deadline) value = Math.sqrt(value + 12345);
+              task.result = value;
+              task.done++;
+              if (task.done === task.steps) {
+                pending.shift();
+                completed++;
+                task.status.textContent = `${task.label} · Completed ${completed}`;
+                task.progress.value = 100;
+                history.unshift(task);
+                history.length = Math.min(history.length, 12);
+              }
+            }, { priority: task.priority });
+            render();
+            await yieldToBrowser();
+            // Pace the simulation so progress and priority changes are observable.
+            await new Promise(resolve => setTimeout(resolve, 16));
+          }
+          state.textContent = 'All tasks complete';
+        } catch (error) {
+          state.textContent = 'Queue paused. Add a task to retry.';
+          console.error('Operations queue failed:', error);
+        } finally {
+          state.dataset.running = 'false';
+          processing = false;
+        }
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => {
+          enqueue(button.dataset.task);
+          render();
+          void processQueue();
+        });
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        // Intentionally enqueue in reverse priority to demonstrate the sorting.
+        ['telemetry', 'menu', 'checkout'].forEach(enqueue);
+        render();
+        void processQueue();
+      });
+    })();
+  </script>
+
