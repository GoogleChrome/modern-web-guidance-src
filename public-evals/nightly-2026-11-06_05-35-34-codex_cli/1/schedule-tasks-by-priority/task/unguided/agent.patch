+  <script>
+    (() => {
+      const definitions = {
+        checkout: { name: 'Checkout', priority: 'urgent', rank: 0, slices: 45 },
+        menu: { name: 'Menu update', priority: 'standard', rank: 1, slices: 75 },
+        telemetry: { name: 'Telemetry logging', priority: 'background', rank: 2, slices: 100 }
+      };
+      const queue = [];
+      let nextId = 0;
+      let completed = 0;
+      let scheduled = false;
+      let activeId = null;
+      let checksum = 0;
+      const queueView = document.getElementById('ops-queue');
+      const logView = document.getElementById('ops-log');
+      const announcement = document.getElementById('ops-announcement');
+      const order = (a, b) => a.rank - b.rank || a.id - b.id;
+
+      function log(message, success = false) {
+        const line = document.createElement('div');
+        const time = document.createElement('time');
+        time.dateTime = new Date().toISOString();
+        time.textContent = new Date().toLocaleTimeString([], { hour12: false });
+        line.append(time, document.createTextNode(message));
+        if (success) line.className = 'log-success';
+        logView.append(line);
+        while (logView.children.length > 60) logView.firstElementChild.remove();
+        logView.scrollTop = logView.scrollHeight;
+      }
+
+      function render() {
+        document.getElementById('ops-pending').textContent = queue.length;
+        document.getElementById('ops-completed').textContent = completed;
+        if (!queue.length) {
+          queueView.innerHTML = '<div class="ops-empty"><span>All clear at the counter</span>Add a task to see the queue in action.</div>';
+          return;
+        }
+        queueView.innerHTML = queue.slice().sort(order).map(task => {
+          const progress = Math.round(task.done / task.slices * 100);
+          const state = task.id === activeId ? 'Running' : task.done ? 'Paused' : 'Queued';
+          return `<div class="ops-row"><div class="ops-row-label"><span class="priority priority-${task.priority}">${task.priority}</span><strong>${task.name} #${task.id}</strong><span class="ops-row-status">${state} · ${progress}%</span></div><div class="ops-progress" role="progressbar" aria-label="${task.name} #${task.id}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${progress}"><div class="ops-progress-fill" style="width:${progress}%"></div></div></div>`;
+        }).join('');
+      }
+
+      function schedule() {
+        if (scheduled || !queue.length) return;
+        scheduled = true;
+        // A new event-loop turn lets input and rendering run between work slices.
+        window.setTimeout(runSlice, 16);
+      }
+
+      function runSlice() {
+        scheduled = false;
+        queue.sort(order);
+        const task = queue[0];
+        if (!task) return;
+        if (activeId !== task.id) {
+          if (activeId !== null) log(`Paused task #${activeId} for higher-priority work.`);
+          log(`${task.done ? 'Resumed' : 'Started'} ${task.name.toLowerCase()} #${task.id}.`);
+          activeId = task.id;
+          announcement.textContent = `Running ${task.name.toLowerCase()} #${task.id}. ${queue.length} tasks pending.`;
+        }
+        // Bound CPU work to four milliseconds, then reconsider every task's priority.
+        const deadline = performance.now() + 4;
+        do {
+          for (let i = 0; i < 500; i++) checksum = (checksum + Math.sqrt(i + task.id)) % 100000;
+        } while (performance.now() < deadline);
+        task.done++;
+        if (task.done >= task.slices) {
+          queue.shift();
+          completed++;
+          log(`Completed ${task.name.toLowerCase()} #${task.id}.`, true);
+          activeId = null;
+          announcement.textContent = queue.length ? `${task.name} complete. ${queue.length} tasks remaining.` : `Queue complete. ${completed} tasks finished.`;
+        }
+        render();
+        schedule();
+      }
+
+      function enqueue(types) {
+        for (const type of types) {
+          const task = { ...definitions[type], id: ++nextId, done: 0 };
+          queue.push(task);
+          log(`Queued ${task.name.toLowerCase()} #${task.id} · ${task.priority}.`);
+        }
+        announcement.textContent = `${types.length} ${types.length === 1 ? 'task' : 'tasks'} added. ${queue.length} tasks pending.`;
+        render();
+        schedule();
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      document.getElementById('ops-batch').addEventListener('click', () => {
+        log('Mixed batch added · execution follows priority, then arrival order.');
+        // Intentionally enqueue out of priority order to demonstrate scheduling.
+        enqueue(['telemetry', 'menu', 'checkout', 'menu', 'checkout', 'telemetry']);
+      });
+      document.getElementById('ops-clear').addEventListener('click', () => {
+        logView.replaceChildren();
+        log('Activity log cleared.');
+      });
+      render();
+      log('Scheduler ready. Waiting for café tasks.');
+    })();
+  </script>
+
 </body>
 
