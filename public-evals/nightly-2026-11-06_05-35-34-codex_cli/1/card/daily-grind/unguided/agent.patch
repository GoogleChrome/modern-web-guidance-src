+  <script>
+    const menu = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+    const sizes = ['small', 'medium', 'large'];
+    const storageKey = 'daily-grind-order';
+    const status = document.getElementById('order-status');
+    let order = [];
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
+      if (Array.isArray(saved)) {
+        order = saved.filter(item => item && Object.hasOwn(menu, item.drink)
+          && sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+      }
+    } catch {
+      // Ordering still works when browser storage is unavailable.
+    }
+
+    function saveOrder() {
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(order));
+      } catch {
+        status.textContent += ' Your order is available for this visit only.';
+      }
+    }
+
+    function renderOrder() {
+      const list = document.getElementById('order-items');
+      list.replaceChildren();
+      document.getElementById('order-count').textContent = order.reduce((sum, item) => sum + item.quantity, 0);
+      document.getElementById('empty-order').hidden = order.length > 0;
+      order.forEach((item, index) => {
+        const row = document.createElement('li');
+        const label = document.createElement('span');
+        label.textContent = `${item.quantity} × ${menu[item.drink]} · ${item.size}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-item';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${menu[item.drink]} from order`);
+        remove.addEventListener('click', () => {
+          order.splice(index, 1);
+          status.textContent = `Removed ${item.size} ${menu[item.drink]} from your order.`;
+          renderOrder();
+          saveOrder();
+          const nextButton = list.querySelectorAll('button')[Math.min(index, order.length - 1)];
+          (nextButton || document.querySelector('[data-drink] button')).focus();
+        });
+        row.append(label, remove);
+        list.append(row);
+      });
+    }
+
+    document.querySelectorAll('form[data-drink]').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        if (!Object.hasOwn(menu, drink) || !sizes.includes(size)) return;
+        const existing = order.find(item => item.drink === drink && item.size === size);
+        if (existing) existing.quantity += 1;
+        else order.push({ drink, size, quantity: 1 });
+        status.textContent = `Added ${size} ${menu[drink]} to your order.`;
+        renderOrder();
+        saveOrder();
+      });
+    });
+    renderOrder();
+  </script>
 </body>
 
