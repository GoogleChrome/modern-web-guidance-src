+  <script>
+    const order = new Map();
+    const orderItems = document.querySelector('#order-items');
+    const orderCount = document.querySelector('#order-count');
+    const orderEmpty = document.querySelector('#order-empty');
+    const orderStatus = document.querySelector('#order-status');
+
+    function renderOrder() {
+      orderItems.replaceChildren();
+      let count = 0;
+      for (const [key, item] of order) {
+        count += item.quantity;
+        const row = document.createElement('li');
+        const description = document.createElement('span');
+        description.textContent = `${item.quantity} × ${item.size} ${item.drink}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove one ${item.size} ${item.drink}`);
+        remove.addEventListener('click', () => {
+          const rowIndex = [...order.keys()].indexOf(key);
+          item.quantity -= 1;
+          if (item.quantity === 0) order.delete(key);
+          renderOrder();
+          const remainingButtons = orderItems.querySelectorAll('button');
+          const nextButton = remainingButtons[Math.min(rowIndex, remainingButtons.length - 1)];
+          (nextButton || document.querySelector('.order-form button')).focus();
+          orderStatus.textContent = `Removed one ${item.size} ${item.drink}. ${orderCount.textContent} drinks in your order.`;
+        });
+        row.append(description, remove);
+        orderItems.append(row);
+      }
+      orderCount.textContent = count;
+      orderEmpty.hidden = count > 0;
+    }
+
+    document.querySelectorAll('.order-form').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        orderStatus.textContent = `Added ${size} ${drink}. ${orderCount.textContent} drinks in your order.`;
+      });
+    });
+  </script>
