+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = sectionLinks.map(link => document.querySelector(link.hash));
+    let updatePending = false;
+
+    function updateActiveSection() {
+      updatePending = false;
+      const navBottom = navigation.getBoundingClientRect().bottom;
+      let activeSection = null;
+
+      for (const section of sections) {
+        const bounds = section.getBoundingClientRect();
+        if (bounds.top <= navBottom + 24 && bounds.bottom > navBottom) {
+          activeSection = section;
+        }
+      }
+
+      // Pick the first visible section when its heading is below the sticky bar.
+      if (!activeSection) {
+        activeSection = sections.find(section => {
+          const bounds = section.getBoundingClientRect();
+          return bounds.top < window.innerHeight && bounds.bottom > navBottom;
+        });
+      }
+
+      // The last section may be too short to reach the top of the viewport.
+      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+        const lastSection = sections[sections.length - 1];
+        if (lastSection.getBoundingClientRect().bottom > navBottom) {
+          activeSection = lastSection;
+        }
+      }
+
+      sectionLinks.forEach((link, index) => {
+        if (sections[index] === activeSection) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function scheduleUpdate() {
+      if (!updatePending) {
+        updatePending = true;
+        requestAnimationFrame(updateActiveSection);
+      }
+    }
+
+    function updateNavigationHeight() {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      scheduleUpdate();
+    }
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', updateNavigationHeight);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('load', scheduleUpdate);
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    updateNavigationHeight();
+  </script>
