+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeScrollspy = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let frame = 0;
+
+    function updateCurrent() {
+      frame = 0;
+      let current;
+
+      if (nativeScrollspy) {
+        current = links.find(link => link.matches(':target-current'));
+      } else {
+        const top = nav.getBoundingClientRect().bottom;
+        const visible = sections.filter(section => {
+          const rect = section.getBoundingClientRect();
+          return rect.bottom > top && rect.top < window.innerHeight;
+        });
+        // Prefer the section at the reading line, keeping short final sections reachable.
+        const readingLine = top + Math.min(120, (window.innerHeight - top) / 4);
+        const section = visible.findLast(section =>
+          section.getBoundingClientRect().top <= readingLine) || visible[0];
+        const atBottom = window.scrollY + window.innerHeight >=
+          document.documentElement.scrollHeight - 2;
+        const activeSection = atBottom ? visible.at(-1) : section;
+        current = links.find(link => link.hash === `#${activeSection?.id}`);
+      }
+
+      links.forEach(link => {
+        link.classList.toggle('is-active', !nativeScrollspy && link === current);
+        if (link === current) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (!frame) frame = requestAnimationFrame(updateCurrent);
+    }
+
+    // Measure wrapped navigation too, so anchor headings stay below the sticky bar.
+    const resizeObserver = new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${nav.offsetHeight}px`);
+      scheduleUpdate();
+    });
+    resizeObserver.observe(nav);
+
+    if (!nativeScrollspy) {
+      const observer = new IntersectionObserver(scheduleUpdate, {
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    document.addEventListener('scroll', scheduleUpdate, { passive: true });
+    document.addEventListener('scrollend', scheduleUpdate);
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    scheduleUpdate();
+  </script>
+
