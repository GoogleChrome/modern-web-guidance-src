   </footer>
 
+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && window.CSS.supports &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+
+      if (nativeScrollAnimation) return;
+
+      // Older browsers get the same continuous interpolation, with at most
+      // one DOM update per frame. No time-based transition can lag behind scroll.
+      var pending = false;
+      function updateNavigation() {
+        pending = false;
+        if (reducedMotion.matches) {
+          nav.style.paddingTop = '0.25rem';
+          nav.style.paddingBottom = '0.25rem';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, scrollTop / 24));
+        var padding = (1 - 0.75 * progress) + 'rem';
+        nav.style.paddingTop = padding;
+        nav.style.paddingBottom = padding;
+      }
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          window.requestAnimationFrame(updateNavigation);
+        }
+      }
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      updateNavigation();
+    }());
+  </script>
+
 </body>
 
