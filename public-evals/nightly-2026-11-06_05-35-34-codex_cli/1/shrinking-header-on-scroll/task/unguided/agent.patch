+  <script>
+    (function () {
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll(root block)') &&
+        CSS.supports('animation-range', '0px 160px');
+      var pending = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateNavigation() {
+        pending = false;
+        if (nativeScrollAnimation || (reducedMotion && reducedMotion.matches)) {
+          navigation.style.height = '';
+          navigation.style.paddingTop = '';
+          navigation.style.paddingBottom = '';
+          return;
+        }
+
+        // Match the CSS animation, including in browsers without CSS variables.
+        var narrow = window.innerWidth <= 640;
+        var expandedHeight = narrow ? 112 : 72;
+        var compactHeight = narrow ? 88 : 52;
+        var compactPadding = narrow ? 4 : 6;
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 160, 1));
+        var padding = 16 + (compactPadding - 16) * progress;
+
+        navigation.style.height = (expandedHeight + (compactHeight - expandedHeight) * progress) + 'px';
+        navigation.style.paddingTop = padding + 'px';
+        navigation.style.paddingBottom = padding + 'px';
+      }
+
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          requestFrame(updateNavigation);
+        }
+      }
+
+      if (!nativeScrollAnimation) {
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        window.addEventListener('pageshow', scheduleUpdate);
+      }
+      if (reducedMotion) {
+        if (reducedMotion.addEventListener) {
+          reducedMotion.addEventListener('change', scheduleUpdate);
+        } else if (reducedMotion.addListener) {
+          reducedMotion.addListener(scheduleUpdate);
+        }
+      }
+      updateNavigation();
+    }());
+  </script>
