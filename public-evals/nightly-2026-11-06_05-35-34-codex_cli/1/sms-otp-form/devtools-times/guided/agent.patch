new file mode 100644
index 0000000..2e5078a
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,114 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_LIFETIME_MS, RESEND_DELAY_MS, MAX_ATTEMPTS,
+  normalizePhone, createCode, codeDigest, matchesCode, smsMessage,
+} from '../../utils/phone-verification.ts';
+
+const reply = (data: Record<string, unknown>, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // This application disables Astro's global origin check. Protect this mutation explicitly.
+  if (request.headers.get('Origin') !== new URL(request.url).origin) {
+    return reply({ error: 'Please submit this form from the sign-up page.' }, 403);
+  }
+  if (!session) return reply({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let data: Record<string, unknown>;
+  try {
+    data = await request.json();
+    if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error();
+  } catch {
+    return reply({ error: 'Invalid request.' }, 400);
+  }
+
+  const accountSid = process.env.TWILIO_ACCOUNT_SID;
+  const authToken = process.env.TWILIO_AUTH_TOKEN;
+  const from = process.env.TWILIO_FROM_NUMBER;
+  const configuredOrigin = process.env.SMS_ORIGIN;
+  if (!accountSid || !authToken || !from || !configuredOrigin) {
+    return reply({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+  }
+  let smsOrigin: URL;
+  try {
+    smsOrigin = new URL(configuredOrigin);
+    if (smsOrigin.origin !== new URL(request.url).origin) throw new Error();
+  } catch {
+    return reply({ error: 'SMS verification is unavailable on this domain.' }, 503);
+  }
+
+  if (data.action === 'send') {
+    const phone = typeof data.phone === 'string' ? normalizePhone(data.phone) : null;
+    if (!phone) return reply({ error: 'Enter a phone number with its country code, such as +1 202 555 0123.' }, 400);
+
+    const now = Date.now();
+    const lastSentAt = await session.get('smsLastSentAt') ?? 0;
+    if (now - lastSentAt < RESEND_DELAY_MS) {
+      return reply({ error: 'Please wait a minute before requesting another code.' }, 429);
+    }
+    const quota = await session.get('smsQuota');
+    const currentQuota = quota && quota.resetAt > now ? quota : { count: 0, resetAt: now + 60 * 60 * 1000 };
+    if (currentQuota.count >= 5) return reply({ error: 'Too many code requests. Please try again in an hour.' }, 429);
+
+    // Reserve the send before contacting the provider, including failed requests in the quota.
+    await session.set('smsLastSentAt', now);
+    await session.set('smsQuota', { ...currentQuota, count: currentQuota.count + 1 });
+    await session.delete('phoneChallenge');
+    const code = createCode();
+    try {
+      const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(accountSid)}/Messages.json`, {
+        method: 'POST',
+        headers: {
+          Authorization: `Basic ${Buffer.from(`${accountSid}:${authToken}`).toString('base64')}`,
+          'Content-Type': 'application/x-www-form-urlencoded',
+        },
+        body: new URLSearchParams({ To: phone, From: from, Body: smsMessage(smsOrigin.hostname, code) }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) throw new Error();
+      await session.set('phoneChallenge', {
+        phone, digest: codeDigest(code, phone, authToken),
+        expiresAt: Date.now() + CODE_LIFETIME_MS, attempts: 0,
+      });
+      return reply({ phone, expiresIn: CODE_LIFETIME_MS / 1000, retryAfter: RESEND_DELAY_MS / 1000 });
+    } catch {
+      return reply({ error: 'We could not send your code. Check your number and try again in a minute.' }, 502);
+    }
+  }
+
+  if (data.action !== 'register') return reply({ error: 'Invalid request.' }, 400);
+  if (typeof data.username !== 'string' || !data.username.trim() || data.username.length > 100 ||
+      typeof data.password !== 'string' || data.password.length < 8 || data.password.length > 256 || !/\d/.test(data.password)) {
+    return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+  }
+
+  const challenge = await session.get('phoneChallenge');
+  if (!challenge || challenge.expiresAt <= Date.now() || challenge.attempts >= MAX_ATTEMPTS) {
+    await session.delete('phoneChallenge');
+    return reply({ error: 'Your code has expired or has too many attempts. Request a new code.', needsNewCode: true }, 400);
+  }
+  // Consume an attempt even for malformed codes. Never trust a client-side "verified" flag.
+  challenge.attempts += 1;
+  await session.set('phoneChallenge', challenge);
+  if (typeof data.code !== 'string' || !matchesCode(challenge, data.code, authToken)) {
+    const locked = challenge.attempts >= MAX_ATTEMPTS;
+    return reply({ error: locked ? 'Too many attempts. Request a new code.' : 'That code is incorrect. Check your SMS and try again.', needsNewCode: locked }, 400);
+  }
+  // Consume a valid code before registration so it cannot be reused after an upstream failure.
+  await session.delete('phoneChallenge');
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: data.username.trim(), password: data.password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) return reply({ error: 'Registration failed. Check your account details and request a new code to try again.', needsNewCode: true }, 502);
+    return reply({ success: true });
+  } catch {
+    return reply({ error: 'Registration could not be completed. Request a new code and try again.', needsNewCode: true }, 502);
+  }
+};
