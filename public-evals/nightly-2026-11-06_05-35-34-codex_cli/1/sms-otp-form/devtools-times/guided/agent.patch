@@ -0,0 +1,38 @@
+import { createHmac, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LIFETIME_MS = 5 * 60 * 1000;
+export const RESEND_DELAY_MS = 60 * 1000;
+export const MAX_ATTEMPTS = 5;
+
+export interface PhoneChallenge {
+  phone: string;
+  digest: string;
+  expiresAt: number;
+  attempts: number;
+}
+
+export function normalizePhone(value: string): string | null {
+  // Accept familiar formatting, but require an explicit international prefix.
+  if (!/^[+\d\s().-]+$/.test(value)) return null;
+  const phone = value.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(phone) ? phone : null;
+}
+
+export function createCode(): string {
+  return randomInt(0, 1_000_000).toString().padStart(6, '0');
+}
+
+export function codeDigest(code: string, phone: string, secret: string): string {
+  return createHmac('sha256', secret).update(`${phone}:${code}`).digest('hex');
+}
+
+export function matchesCode(challenge: PhoneChallenge, code: string, secret: string): boolean {
+  if (!/^\d{6}$/.test(code)) return false;
+  const expected = Buffer.from(challenge.digest, 'hex');
+  const actual = Buffer.from(codeDigest(code, challenge.phone, secret), 'hex');
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+export function smsMessage(hostname: string, code: string): string {
+  return `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${hostname} #${code}`;
+}
