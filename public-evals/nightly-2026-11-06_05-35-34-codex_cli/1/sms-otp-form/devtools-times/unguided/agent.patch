+.paper-rule{height:4px;border-block:1px solid #a8a695}
+.paper-headline{font-family:Georgia,serif;font-size:25px;line-height:1.1;font-weight:bold;margin:12px 0}
+.paper-columns{display:grid;grid-template-columns:1.2fr 1fr;gap:12px}
+.paper-sun{height:75px;background:#d9decb;position:relative;overflow:hidden}
+.paper-sun:after{content:'';position:absolute;width:180px;height:80px;background:#748465;transform:rotate(-25deg);top:47px;left:-10px}
+.paper-sun:before{content:'';position:absolute;width:130px;height:80px;background:#a6b19a;transform:rotate(30deg);top:42px;left:45px}
+.paper-sun div{width:30px;height:30px;background:#eee6bf;border-radius:50%;margin:12px 0 0 17px}
+.paper-lines{display:flex;flex-direction:column;justify-content:space-between;padding:2px 0}
+.paper-lines span{height:2px;background:#d4d1bf}
+.paper-lines span:nth-child(3n){width:80%}
+.paper-bottom{font-size:5px;letter-spacing:1.2px;border-top:1px solid #aaa896;margin-top:10px;padding-top:7px}
+.paper-stamp{position:absolute;right:-31px;bottom:2px;background:#df724b;width:90px;height:90px;border:4px double #f6cfba;border-radius:50%;display:flex;flex-direction:column;justify-content:center;text-align:center;font:italic 12px Georgia,serif;color:#fff4e2;transform:rotate(17deg)}
+.story-foot{display:flex;gap:12px;align-items:center;margin-top:auto;padding-top:17px}
+.small-star{font-size:31px;color:#7c8b6a}
+.story-foot p{font-size:10px;color:#737969;line-height:1.7}
+.signup-form-side{padding:26px 39px;display:flex;flex-direction:column}
+.signup-existing{font-size:10px;color:#74766f;display:flex;justify-content:flex-end;gap:5px;align-items:center}
+.signup-existing a{display:flex;align-items:center;gap:5px;color:#31382c;font-weight:600}
+.signup-existing svg{width:12px}
+.signup-steps{display:flex;list-style:none;padding:0;margin:39px 0 34px;justify-content:space-between;position:relative;gap:10px}
+.signup-steps:before{content:'';height:1px;background:#e7e8e1;position:absolute;top:12px;left:15px;right:15px}
+.signup-steps li{display:flex;align-items:center;gap:7px;font-size:9px;color:#95968f;background:white;z-index:1;padding-right:5px}
+.signup-steps li>span:first-child{border:1px solid #e0e2da;border-radius:50%;width:25px;height:25px;display:grid;place-items:center;background:#fafbf8;font-size:10px}
+.signup-steps li.active{color:#37402f;font-weight:600}
+.signup-steps li.active>span:first-child{background:#3b4935;border-color:#3b4935;color:white}
+.signup-steps svg{width:12px}
+.signup-step-label{font-size:9px;font-weight:600;letter-spacing:1.6px;color:#828b76;margin-bottom:10px}
+.signup-form-content h2{font-family:Georgia,serif;font-size:27px;font-weight:400;letter-spacing:-.5px;line-height:1.25;margin-bottom:10px}
+.signup-form-content h2:focus{outline:none}
+.signup-intro{font-size:11px;color:#797c72;line-height:1.8;margin-bottom:27px}
+.signup-form-content label{display:block;font-size:11px;font-weight:600;margin:18px 0 8px}
+.signup-form-content input{display:block;width:100%;border:1px solid #dcded5;border-radius:5px;padding:12px 13px;font-size:12px;color:#30372b;background:#fff;height:43px}
+.signup-form-content input::placeholder{color:#a0a298}
+.signup-form-content input:focus{outline:2px solid #82936f;outline-offset:2px}
+.signup-password{position:relative}
+.signup-password input{padding-right:43px}
+.signup-password button{position:absolute;right:0;top:0;height:43px;width:42px;display:grid;place-items:center;color:#919587}
+.signup-password svg{width:16px}
+.signup-hint{font-size:9px;color:#7b8073;margin-top:8px;line-height:1.7}
+.signup-primary{display:flex;align-items:center;justify-content:center;gap:12px;background:#3e4d35;border:1px solid #3e4d35;border-radius:5px;color:#fff;padding:13px 18px;font-size:11px;font-weight:600;width:100%;min-height:43px;margin-top:24px;transition:background .2s}
+.signup-primary:hover{background:#2d3b25}
+.signup-primary svg{width:15px}
+.signup-form-side button{cursor:pointer}
+.signup-form-side button:disabled{opacity:.55;cursor:wait}
+.signup-form-side button:focus-visible,.signup-form-side a:focus-visible{outline:2px solid #728760;outline-offset:4px}
+.signup-terms{font-size:9px;color:#92968a;line-height:1.85;text-align:center;margin:19px 13px 0}
+.signup-terms a{color:#65705a;text-decoration:underline;text-underline-offset:2px}
+.signup-secure{border-top:1px solid #eeeee7;margin-top:26px;padding-top:20px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:7px;letter-spacing:1.1px;color:#929789}
+.signup-secure svg{width:11px}
+.signup-bottom{display:flex;justify-content:space-between;margin-top:21px;font-size:9px;color:#91968a}
+.signup-bottom span:last-child{font-size:7px;letter-spacing:1.5px}
+.signup-phone{position:relative}
+.signup-phone>svg{position:absolute;left:12px;top:12px;width:18px;color:#8b9383}
+.signup-phone input{padding-left:39px}
+.signup-note{display:flex;gap:10px;background:#f5f6f0;border-radius:5px;padding:15px;margin-top:23px}
+.signup-note svg{width:17px;flex-shrink:0;color:#78856b}
+.signup-note p{font-size:10px;line-height:1.8;color:#7c8373}
+.signup-back{display:flex;gap:7px;align-items:center;justify-content:center;margin:16px auto 0;font-size:10px;color:#757f6b}
+.signup-back svg{width:12px}
+.code-label{display:flex;align-items:center;justify-content:space-between}
+.code-label span{font-size:9px;color:#8d9284;margin-top:10px}
+.signup-form-content .signup-code{height:56px;font-size:25px;letter-spacing:13px;padding-left:20px;font-variant-numeric:tabular-nums}
+.signup-resend{font-size:10px;color:#888d80;margin-top:22px}
+.signup-resend button{color:#475a38;font-weight:600;margin-left:5px}
+.signup-error{background:#fff1ec;color:#9d3d26;font-size:11px;padding:10px;border-radius:4px;margin-top:16px;line-height:1.6}
+.signup-status{font-size:10px;color:#5e7550;line-height:1.6}
+.signup-status:not(:empty){margin-top:12px}
+.signup-success{margin:auto 0}
+.signup-success>svg{width:47px;color:#637c51;margin-bottom:23px}
+.signup-success>p{font-size:12px;color:#7b8273;line-height:1.9;margin-top:17px}
+@media(min-width:1100px){.signup-story{padding-left:40px;padding-right:40px}
+.signup-form-side{padding-left:44px;padding-right:44px}
+}
+@media(max-width:700px){.signup-shell{padding:20px 16px 30px}
+.signup-panel{grid-template-columns:1fr}
+.signup-story{padding:27px}
+.signup-story h1{font-size:32px;margin-top:18px}
+.signup-paper,.story-foot{display:none}
+.signup-deck{font-size:11px}
+.signup-form-side{padding:25px}
+.signup-steps{margin:30px 0}
+.signup-bottom{gap:15px;line-height:1.7}
+.signup-bottom span:last-child{text-align:right}
+.signup-form-content input{font-size:16px}
+.signup-form-content .signup-code{letter-spacing:10px}
+.signup-existing{font-size:11px}
+.signup-success{padding:35px 0}
+}
+
