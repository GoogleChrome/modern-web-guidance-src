diff --git a/src/pages/api/signup/[action].ts b/src/pages/api/signup/[action].ts
new file mode 100644
index 0000000..f335f39
--- /dev/null
+++ b/src/pages/api/signup/[action].ts
@@ -0,0 +1,68 @@
+import type { APIRoute } from 'astro';
+
+type Challenge = { phone: string; expires: number; sentAt: number; attempts: number; verified: boolean };
+const reply = (data: object, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, params, session }) => {
+  if (request.headers.get('origin') !== new URL(request.url).origin) return reply({ error: 'Please submit this form from our website.' }, 403);
+  if (!session) return reply({ error: 'Verification is temporarily unavailable.' }, 503);
+  const action = params.action;
+  if (!['send', 'verify', 'register'].includes(action || '')) return reply({ error: 'Not found.' }, 404);
+  let body;
+  try { body = await request.json(); } catch { return reply({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object') return reply({ error: 'Invalid request.' }, 400);
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+  const now = Date.now();
+
+  if (action === 'register') {
+    if (!challenge?.verified || challenge.expires < now) return reply({ error: 'Please verify your phone number again.' }, 403);
+    const { username, password } = body;
+    if (typeof username !== 'string' || !username.trim() || username.length > 100 || typeof password !== 'string' || password.length < 8 || password.length > 128 || !/\d/.test(password)) {
+      return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    }
+    try {
+      const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: username.trim(), password, phoneNumber: challenge.phone }),
+        signal: AbortSignal.timeout(15000),
+      });
+      if (!response.ok) return reply({ error: 'We couldn’t create your account. Try a different username or try again.' }, 400);
+      await session.delete('signupChallenge');
+      return reply({ success: true });
+    } catch { return reply({ error: 'We couldn’t reach the registration service. Please try again.' }, 502); }
+  }
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) return reply({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+  const phone = typeof body.phone === 'string' ? body.phone.replace(/[\s().-]/g, '') : '';
+  if (!/^\+[1-9]\d{7,14}$/.test(phone)) return reply({ error: 'Enter a valid phone number including its country code.' }, 400);
+  const form = new URLSearchParams({ To: phone });
+  if (action === 'send') {
+    if (challenge && now - challenge.sentAt < 60000) return reply({ error: 'Please wait before requesting another code.', retryAfter: Math.ceil((60000 - now + challenge.sentAt) / 1000) }, 429);
+    form.set('Channel', 'sms');
+    // Save the cooldown before contacting the provider, including failed sends.
+    await session.set('signupChallenge', { phone, expires: now + 600000, sentAt: now, attempts: 0, verified: false });
+  } else {
+    if (!challenge || challenge.phone !== phone || challenge.expires < now || challenge.attempts >= 5) return reply({ error: 'This code has expired or reached its attempt limit. Request a new code.' }, 400);
+    if (challenge.verified) return reply({ verified: true });
+    if (typeof body.code !== 'string' || !/^\d{6}$/.test(body.code)) return reply({ error: 'Enter the 6-digit code from your text message.' }, 400);
+    form.set('Code', body.code);
+    await session.set('signupChallenge', { ...challenge, attempts: challenge.attempts + 1 });
+  }
+  try {
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${service}/${action === 'send' ? 'Verifications' : 'VerificationCheck'}`, {
+      method: 'POST', headers: { Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`, 'Content-Type': 'application/x-www-form-urlencoded' },
+      body: form, signal: AbortSignal.timeout(15000),
+    });
+    const result = await response.json();
+    if (!response.ok) return reply({ error: response.status === 429 ? 'Too many requests. Please wait and try again.' : action === 'send' ? 'We couldn’t send a code to this number. Check the number and try again.' : 'This code is invalid or expired. Try again or request a new code.' }, response.status === 429 ? 429 : 400);
+    if (action === 'send') return reply({ sent: true, retryAfter: 60 });
+    if (result.status !== 'approved') return reply({ error: 'That code isn’t correct. Please try again.' }, 400);
+    await session.set('signupChallenge', { ...challenge!, verified: true, expires: now + 600000 });
+    return reply({ verified: true });
+  } catch { return reply({ error: 'The SMS service couldn’t be reached. Please try again.' }, 502); }
+};
