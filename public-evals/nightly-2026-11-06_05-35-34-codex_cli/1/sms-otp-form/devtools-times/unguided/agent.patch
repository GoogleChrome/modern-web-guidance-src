+.signup-breadcrumb span:last-child{color:#343a32}
+.signup-panel{display:grid;grid-template-columns:1fr 1.08fr;border:1px solid #dedfd7;border-radius:12px;overflow:hidden;min-height:652px;background:#fff}
+.signup-story{background:#f1f2e9;padding:43px 35px 26px;position:relative;overflow:hidden;display:flex;flex-direction:column}
+.signup-edition{font-size:8px;font-weight:700;letter-spacing:1.6px;display:flex;align-items:center;gap:8px;color:#58614d}
+.edition-dot{width:6px;height:6px;border-radius:50%;background:#768364}
