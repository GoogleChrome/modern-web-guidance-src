@@ -0,0 +1,268 @@
+/* Default to a clearly labeled local preview. See AUTH_INTEGRATION.md for live setup. */
+(() => {
+  'use strict';
+  const config = window.DAILY_GRIND_AUTH || {};
+  const live = config.mode === 'live';
+  const phoneForm = document.getElementById('phone-form');
+  const otpForm = document.getElementById('otp-form');
+  const phone = document.getElementById('phone');
+  const otp = document.getElementById('otp');
+  const phoneError = document.getElementById('phone-error');
+  const otpError = document.getElementById('otp-error');
+  const status = document.getElementById('auth-status');
+  const resend = document.getElementById('resend');
+  const timerLabel = document.getElementById('resend-timer');
+  const success = document.getElementById('success');
+  const choices = [...document.querySelectorAll('input[name="intent"]')];
+  let destination = 'rewards';
+  let activePhone = '';
+  let challengeId = '';
+  let expiresAt = 0;
+  let cooldownUntil = 0;
+  let timer = null;
+  let smsController = null;
+  let smsTimeout = null;
+  let requestController = null;
+  let busy = false;
+  let demoAttempts = 0;
+  let complete = false;
+
+  if (live) document.querySelector('.preview-note').hidden = true;
+
+  function announce(message) { status.textContent = message; }
+  function error(input, output, message) {
+    input.setAttribute('aria-invalid', 'true');
+    output.textContent = message;
+  }
+  function clearError(input, output) {
+    input.removeAttribute('aria-invalid');
+    input.setCustomValidity('');
+    output.textContent = '';
+  }
+  function normalizePhone(value) {
+    const digits = value.replace(/\D/g, '');
+    if (value.trim().startsWith('+')) return '+' + digits;
+    if (digits.length === 10) return '+1' + digits;
+    if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;
+    return '';
+  }
+  function setBusy(value) {
+    busy = value;
+    phoneForm.setAttribute('aria-busy', String(value));
+    otpForm.setAttribute('aria-busy', String(value));
+    document.querySelectorAll('.primary-button').forEach(button => { button.disabled = value; });
+    document.getElementById('change-number').disabled = value;
+    choices.forEach(choice => { choice.disabled = value || complete; });
+    updateCooldown();
+  }
+  function stopSms() {
+    smsController?.abort();
+    smsController = null;
+    clearTimeout(smsTimeout);
+  }
+  async function listenForSms() {
+    stopSms();
+    if (!live || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials?.get) return;
+    const controller = new AbortController();
+    smsController = controller;
+    smsTimeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+      if (!credential || controller.signal.aborted || otpForm.hidden) return;
+      otp.value = credential.code;
+      clearError(otp, otpError);
+      // Let native validation and the same application submit handler run.
+      if (!busy) otpForm.requestSubmit();
+    } catch {
+      // Permission dismissal, timeout, and unsupported behavior leave manual entry available.
+    } finally {
+      if (smsController === controller) {
+        clearTimeout(smsTimeout);
+        smsController = null;
+      }
+    }
+  }
+  async function post(path, payload) {
+    requestController = new AbortController();
+    const controller = requestController;
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(path, {
+        method: 'POST', credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', ...(config.csrfToken ? { 'X-CSRF-Token': config.csrfToken } : {}) },
+        body: JSON.stringify(payload), signal: controller.signal,
+      });
+      if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+      if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('Sign-in is unavailable right now. Please try again later.');
+      const data = await response.json();
+      if (!response.ok) {
+        if (data.error === 'invalid_code') throw new Error('That code isn’t quite right. Check your text and try again.');
+        if (data.error === 'expired_code') throw new Error('This code has expired. Request a new one below.');
+        throw new Error('We couldn’t complete that request. Please try again.');
+      }
+      return data;
+    } catch (err) {
+      if (err.name === 'AbortError') throw new Error('The request timed out. Please try again.');
+      if (err instanceof TypeError) throw new Error('Unable to connect. Check your connection and try again.');
+      throw err;
+    } finally {
+      clearTimeout(timeout);
+      if (requestController === controller) requestController = null;
+    }
+  }
+  function updateCooldown() {
+    const seconds = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+    resend.disabled = busy || seconds > 0;
+    timerLabel.textContent = seconds ? `(${seconds}s)` : '';
+    if (!seconds && timer) { clearInterval(timer); timer = null; }
+  }
+  function startCooldown() {
+    cooldownUntil = Date.now() + 30000;
+    clearInterval(timer);
+    updateCooldown();
+    timer = setInterval(updateCooldown, 1000);
+  }
+  function setStep(codeActive) {
+    phoneForm.hidden = codeActive;
+    otpForm.hidden = !codeActive;
+    document.getElementById('phone-step').toggleAttribute('aria-current', !codeActive);
+    document.getElementById('code-step').toggleAttribute('aria-current', codeActive);
+    const current = document.getElementById(codeActive ? 'code-step' : 'phone-step');
+    current.setAttribute('aria-current', 'step');
+  }
+  async function sendCode() {
+    if (busy) return;
+    stopSms();
+    setBusy(true);
+    announce(live ? 'Requesting your code…' : 'Preparing your preview code…');
+    clearError(otp, otpError);
+    otp.value = '';
+    const hadChallenge = Boolean(challengeId);
+    let sent = false;
+    try {
+      // Activate WebOTP before asking the server to send the SMS to avoid a delivery race.
+      setStep(true);
+      document.getElementById('sent-to').textContent = `Code for ${activePhone}`;
+      void listenForSms();
+      const data = live ? await post('/api/auth/sms/request', { phone: activePhone, intent: destination }) : { challengeId: 'local-preview', expiresIn: 300 };
+      if (typeof data.challengeId !== 'string' || !data.challengeId) throw new Error('We couldn’t request a code. Please try again.');
+      challengeId = data.challengeId;
+      sent = true;
+      expiresAt = Date.now() + Math.max(1, Number(data.expiresIn) || 300) * 1000;
+      demoAttempts = 0;
+      startCooldown();
+      announce(live ? 'Code sent. Check your text messages.' : 'Preview code: 123456. No SMS was sent. The code expires in 5 minutes.');
+      otp.focus();
+    } catch (err) {
+      stopSms();
+      if (!hadChallenge) setStep(false);
+      announce(err.message);
+      if (!hadChallenge) phone.focus();
+    } finally {
+      setBusy(false);
+      // An SMS can arrive before the send endpoint responds.
+      if (sent && /^[0-9]{6}$/.test(otp.value)) otpForm.requestSubmit();
+    }
+  }
+  function reset() {
+    stopSms();
+    clearInterval(timer);
+    timer = null;
+    cooldownUntil = 0;
+    challengeId = '';
+    expiresAt = 0;
+    complete = false;
+    otp.value = '';
+    clearError(otp, otpError);
+    success.hidden = true;
+    setStep(false);
+    setBusy(false);
+    announce('');
+    phone.focus();
+  }
+  phoneForm.addEventListener('submit', event => {
+    event.preventDefault();
+    if (busy) return;
+    clearError(phone, phoneError);
+    activePhone = normalizePhone(phone.value);
+    if (!/^\+[1-9][0-9]{7,14}$/.test(activePhone)) {
+      error(phone, phoneError, 'Enter a valid mobile number. Outside the US, include + and your country code.');
+      phone.focus();
+      return;
+    }
+    void sendCode();
+  });
+  otpForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    stopSms();
+    if (busy) return;
+    clearError(otp, otpError);
+    if (!challengeId) return;
+    if (Date.now() >= expiresAt) {
+      error(otp, otpError, 'This code has expired. Request a new one below.');
+      return;
+    }
+    setBusy(true);
+    announce('Checking your code…');
+    try {
+      if (live) {
+        const result = await post('/api/auth/sms/verify', { challengeId, code: otp.value, intent: destination });
+        if (result.verified !== true) throw new Error('We couldn’t verify that code. Please try again.');
+        window.location.assign(destination === 'order' ? '/order-online' : '/rewards');
+      } else {
+        if (++demoAttempts > 5) { expiresAt = 0; throw new Error('Too many attempts. Request a new preview code.'); }
+        if (otp.value !== '123456') throw new Error('That code isn’t quite right. Use 123456 for this preview.');
+        complete = true;
+        otpForm.hidden = true;
+        success.hidden = false;
+        document.getElementById('success-title').textContent = 'A little closer to your next cup.';
+        document.getElementById('success-copy').textContent = destination === 'order' ? 'Online order preview complete. Connect the SMS service to sign in and start a real order.' : 'Rewards preview complete. Connect the SMS service to sign in and see your real rewards.';
+        document.getElementById('code-step').removeAttribute('aria-current');
+        announce('Preview complete. No account was signed in.');
+        success.focus();
+      }
+    } catch (err) {
+      announce('');
+      error(otp, otpError, err.message);
+      otp.focus();
+    } finally { setBusy(false); }
+  });
+  phone.addEventListener('input', () => clearError(phone, phoneError));
+  otp.addEventListener('input', () => {
+    clearError(otp, otpError);
+    otp.value = otp.value.replace(/[^0-9]/g, '').slice(0, 6);
+  });
+  otp.addEventListener('paste', event => {
+    const value = event.clipboardData?.getData('text').trim();
+    if (value && /^[0-9\s-]+$/.test(value)) {
+      event.preventDefault();
+      otp.value = value.replace(/[^0-9]/g, '').slice(0, 6);
+      clearError(otp, otpError);
+    }
+  });
+  phone.addEventListener('invalid', () => error(phone, phoneError, 'Enter your mobile number, including your country code outside the US.'));
+  otp.addEventListener('invalid', () => error(otp, otpError, 'Enter all 6 digits from your text message.'));
+  document.getElementById('change-number').addEventListener('click', reset);
+  document.getElementById('start-over').addEventListener('click', reset);
+  resend.addEventListener('click', () => {
+    if (!busy && Date.now() >= cooldownUntil) void sendCode();
+  });
+  choices.forEach(choice => choice.addEventListener('change', () => { destination = choice.value; }));
+  document.querySelectorAll('[data-intent]').forEach(link => link.addEventListener('click', () => {
+    if (busy) return;
+    if (complete) reset();
+    destination = link.dataset.intent;
+    choices.forEach(choice => { choice.checked = choice.value === destination; });
+    (otpForm.hidden ? phone : otp).focus({ preventScroll: true });
+  }));
+  window.addEventListener('pagehide', () => {
+    stopSms();
+    requestController?.abort();
+    clearInterval(timer);
+  });
+  window.addEventListener('pageshow', event => {
+    if (!event.persisted) return;
+    updateCooldown();
+    if (!otpForm.hidden && challengeId && !busy) void listenForSms();
+  });
+})();
