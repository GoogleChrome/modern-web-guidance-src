+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const cards = document.getElementById('favorites-cards');
+    const gridButton = document.getElementById('favorites-grid');
+    const listButton = document.getElementById('favorites-list');
+    const detailsButton = document.getElementById('favorites-details');
+    const filterButton = document.getElementById('favorites-filter-toggle');
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+    const status = document.getElementById('favorites-status');
+    const buttons = [...toolbar.querySelectorAll('button')];
+
+    // Keep one tab stop in the toolbar; arrow keys move between its controls.
+    toolbar.addEventListener('focusin', (event) => {
+      if (!buttons.includes(event.target)) return;
+      buttons.forEach((button) => button.tabIndex = button === event.target ? 0 : -1);
+    });
+    toolbar.addEventListener('keydown', (event) => {
+      const index = buttons.indexOf(document.activeElement);
+      if (index < 0) return;
+      let next;
+      if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
+      if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = buttons.length - 1;
+      if (next === undefined) return;
+      event.preventDefault();
+      buttons[next].focus();
+    });
+
+    function setLayout(list) {
+      cards.classList.toggle('list-view', list);
+      gridButton.setAttribute('aria-pressed', String(!list));
+      listButton.setAttribute('aria-pressed', String(list));
+    }
+    gridButton.addEventListener('click', () => setLayout(false));
+    listButton.addEventListener('click', () => setLayout(true));
+    detailsButton.addEventListener('click', () => {
+      const hidden = cards.classList.toggle('details-hidden');
+      detailsButton.setAttribute('aria-pressed', String(!hidden));
+    });
+
+    function applyFilters() {
+      let count = 0;
+      cards.querySelectorAll('.card').forEach((card) => {
+        card.hidden = !filters.hidden && temperature.value !== 'all' &&
+          card.dataset.temperature !== temperature.value;
+        if (!card.hidden) count++;
+      });
+      status.textContent = `${count} featured drinks shown.`;
+    }
+    filterButton.addEventListener('click', () => {
+      filters.hidden = !filters.hidden;
+      filterButton.setAttribute('aria-pressed', String(!filters.hidden));
+      filterButton.setAttribute('aria-expanded', String(!filters.hidden));
+      applyFilters();
+    });
+    temperature.addEventListener('change', applyFilters);
+
+    document.getElementById('favorites-copy').addEventListener('click', async () => {
+      const drinks = [...cards.querySelectorAll('.card')].map((card) =>
+        `${card.querySelector('h3').textContent} — ${card.querySelector('p').textContent}`
+      );
+      try {
+        await navigator.clipboard.writeText(`Seasonal Favorites\n${drinks.join('\n')}`);
+        status.textContent = 'Featured drinks list copied.';
+      } catch {
+        status.textContent = 'Could not copy the list. Please allow clipboard access and try again.';
+      }
+    });
+  </script>
