+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const cards = document.getElementById('favorites-cards');
+    const buttons = [...toolbar.querySelectorAll('button')];
+    const viewButtons = [...toolbar.querySelectorAll('[data-view]')];
+
+    viewButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        cards.dataset.view = button.dataset.view;
+        viewButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+      });
+    });
+
+    document.getElementById('favorites-details').addEventListener('click', event => {
+      const button = event.currentTarget;
+      const showDetails = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(showDetails));
+      cards.querySelectorAll('.card p, .card .btn').forEach(detail => {
+        detail.hidden = !showDetails;
+      });
+    });
+
+    // Keep a single tab stop on browsers without native focusgroup support.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      buttons.forEach((button, index) => button.tabIndex = index === 0 ? 0 : -1);
+      toolbar.addEventListener('focusin', event => {
+        if (buttons.includes(event.target)) {
+          buttons.forEach(button => button.tabIndex = button === event.target ? 0 : -1);
+        }
+      });
+      toolbar.addEventListener('keydown', event => {
+        const index = buttons.indexOf(event.target);
+        if (index < 0 || event.altKey || event.ctrlKey || event.metaKey) return;
+        const rtl = getComputedStyle(toolbar).direction === 'rtl';
+        const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[event.key];
+        let next;
+        if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = buttons.length - 1;
+        else if (step) next = (index + step + buttons.length) % buttons.length;
+        else return;
+        event.preventDefault();
+        buttons[next].focus();
+      });
+    }
+
+    // Enhance native title tooltips only when both required APIs are supported.
+    if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+      buttons.forEach((button, index) => {
+        const tip = document.createElement('div');
+        tip.id = `favorites-tip-${index}`;
+        tip.className = 'favorites-tooltip';
+        tip.textContent = button.title;
+        tip.setAttribute('popover', 'hint');
+        document.body.append(tip);
+        button.setAttribute('interestfor', tip.id);
+        button.removeAttribute('title');
+      });
+    }
+
+    const status = document.getElementById('favorites-status');
+    let feedbackTimer;
+    let lastMessage = '';
+
+    async function copyFavorites(target) {
+      // Copy every featured drink, even when its details are collapsed.
+      const drinks = [...target.querySelectorAll('.card')].map(card =>
+        `${card.querySelector('h3').textContent.trim()} — ${card.querySelector('p').textContent.trim()}`
+      );
+      let message;
+      try {
+        await navigator.clipboard.writeText(`Seasonal Favorites\n${drinks.join('\n')}`);
+        message = 'Featured drinks copied.';
+      } catch {
+        message = 'Could not copy the drinks. Please select and copy them manually.';
+      }
+      clearTimeout(feedbackTimer);
+      if (message === lastMessage) message += '\u00A0';
+      lastMessage = message;
+      status.textContent = message;
+      feedbackTimer = setTimeout(() => status.textContent = '', 5000);
+    }
+
+    if ('CommandEvent' in window) {
+      cards.addEventListener('command', event => {
+        if (event.command === '--copy' && toolbar.contains(event.source)) copyFavorites(cards);
+      });
+    } else {
+      toolbar.querySelector('[command="--copy"]').addEventListener('click', () => copyFavorites(cards));
+    }
+  </script>
+
