+    /* Keep padding inside the animated wrappers so they collapse fully. */
+    #promo-alert {
+      position: static;
+      width: 100%;
+      max-width: none;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      background: var(--accent);
+      color: var(--text);
+      block-size: 0;
+      overflow: clip;
+      opacity: 0;
+      transition: block-size 400ms ease, opacity 300ms ease,
+        display 400ms allow-discrete;
+    }
+
+    #promo-alert[open] {
+      block-size: auto;
+      opacity: 1;
+    }
+
+    .promo-inner {
+      position: relative;
+      padding: 14px 64px;
+      text-align: center;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      inset-block-start: 50%;
+      inset-inline-end: 12px;
+      transform: translateY(-50%);
+      width: 44px;
+      height: 44px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    #alert-dismiss:hover {
+      background: rgb(78 52 46 / 10%);
+    }
+
+    .faq {
+      margin-top: 48px;
+    }
+
+    .faq h2 {
+      margin-bottom: 20px;
+      text-align: center;
+    }
+
+    .faq details {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+    }
+
+    #faq-trigger {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 20px;
+      padding: 20px;
+      font-weight: 600;
+      cursor: pointer;
+      list-style: none;
+    }
+
+    #faq-trigger::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger::after {
+      content: "";
+      width: 9px;
+      height: 9px;
+      flex-shrink: 0;
+      border-right: 2px solid currentColor;
+      border-bottom: 2px solid currentColor;
+      transform: rotate(45deg);
+      transition: transform 400ms ease;
+    }
+
+    details[open] > #faq-trigger::after {
+      transform: rotate(225deg);
+    }
+
+    #faq-content {
+      padding: 0 20px 20px;
+    }
+
+    /* Native details handles keyboard access and expanded/hidden semantics. */
+    .faq details::details-content {
+      block-size: 0;
+      overflow: clip;
+      transition: block-size 400ms ease,
+        content-visibility 400ms allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      .faq details::details-content,
+      #faq-trigger::after {
+        transition: none;
+      }
+    }
   </style>
 </head>
 
