+  <script>
+    (function () {
+      var progress = document.getElementById('scroll-progress');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeTimeline = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      var frame = null;
+
+      function updateProgress() {
+        frame = null;
+        if (nativeTimeline && !reducedMotion.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        var root = document.scrollingElement || document.documentElement;
+        var distance = root.scrollHeight - root.clientHeight;
+        var fraction = distance > 0 ? root.scrollTop / distance : 0;
+        progress.style.transform = 'scaleX(' + Math.max(0, Math.min(1, fraction)) + ')';
+      }
+
+      function scheduleUpdate() {
+        if (frame === null) frame = window.requestAnimationFrame(updateProgress);
+      }
+
+      // Direct updates also preserve useful progress for reduced-motion users,
+      // without interpolation or a trailing animation.
+      if (!nativeTimeline) {
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      } else {
+        window.addEventListener('scroll', function () {
+          if (reducedMotion.matches) scheduleUpdate();
+        }, { passive: true });
+      }
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      if ('ResizeObserver' in window) {
+        var observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+      }
+      updateProgress();
+    }());
+  </script>
