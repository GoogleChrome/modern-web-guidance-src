+  <script>
+    (() => {
+      const nativePopover = 'popover' in HTMLElement.prototype;
+      const nativeCommands = 'commandForElement' in HTMLButtonElement.prototype;
+      const nativeFocusgroup = 'focusGroup' in HTMLElement.prototype;
+      const anchored = CSS.supports('position-area: block-end');
+      const menus = [];
+      const status = document.getElementById('menu-status');
+      let nextId = 0;
+      let orderCount = 0;
+      let announcementTimer;
+      const announce = message => {
+        clearTimeout(announcementTimer);
+        status.textContent = '';
+        announcementTimer = setTimeout(() => { status.textContent = message; }, 20);
+      };
+      const open = menu => nativePopover ? menu.matches(':popover-open') : menu.hasAttribute('data-open');
+      const items = menu => [...menu.group.querySelectorAll('.menu-item')]
+        .filter(item => item.closest('[focusgroup]') === menu.group && !item.disabled);
+      const rootOf = menu => menu.parentMenu ? rootOf(menu.parentMenu) : menu;
+      const focusItem = (menu, last = false) => {
+        const list = items(menu);
+        (last ? list[list.length - 1] : list[0])?.focus();
+      };
+
+      function position(menu) {
+        if (anchored && nativePopover) return;
+        const trigger = menu.trigger.getBoundingClientRect();
+        const width = document.documentElement.clientWidth;
+        const height = window.innerHeight;
+        menu.style.removeProperty('max-height');
+        const narrow = width < menu.getBoundingClientRect().width * 2 + 40;
+        const below = Math.max(44, height - trigger.bottom - 16);
+        const above = Math.max(44, trigger.top - 16);
+        if (!menu.parentMenu || narrow) {
+          menu.style.maxHeight = `${Math.max(below, above)}px`;
+        }
+        const box = menu.getBoundingClientRect();
+        let x = trigger.left;
+        let y = trigger.bottom + 4;
+        if (menu.parentMenu) {
+          if (width >= box.width * 2 + 40) {
+            x = trigger.right + 4;
+            y = trigger.top;
+            if (x + box.width > width - 12) x = trigger.left - box.width - 4;
+          }
+          // On narrow screens, open below the trigger so it stays reachable.
+        }
+        if (y + box.height > height - 12 && trigger.top - box.height - 4 >= 12) {
+          y = trigger.top - box.height - 4;
+        }
+        x = Math.max(12, Math.min(x, width - box.width - 12));
+        y = Math.max(12, Math.min(y, height - box.height - 12));
+        menu.style.setProperty('--menu-x', `${x}px`);
+        menu.style.setProperty('--menu-y', `${y}px`);
+      }
+
+      function sync(menu) {
+        const expanded = open(menu);
+        menu.trigger.setAttribute('aria-expanded', String(expanded));
+        if (expanded) {
+          position(menu);
+          if (menu.enter) focusItem(menu, menu.enter === 'last');
+        }
+        menu.enter = null;
+      }
+
+      function close(menu, restore = false) {
+        if (restore) menu.trigger.focus();
+        menus.filter(child => child.parentMenu === menu).forEach(child => close(child));
+        if (!open(menu)) return;
+        if (nativePopover) menu.hidePopover();
+        else { menu.removeAttribute('data-open'); sync(menu); }
+      }
+
+      function show(menu, enter = null) {
+        // Close sibling menus while preserving the current ancestor chain.
+        menus.filter(other => other !== menu && other.parentMenu === menu.parentMenu)
+          .forEach(other => close(other));
+        menu.enter = enter;
+        if (open(menu)) {
+          if (enter) focusItem(menu, enter === 'last');
+          menu.enter = null;
+          return;
+        }
+        if (nativePopover) menu.showPopover({ source: menu.trigger });
+        else { menu.setAttribute('data-open', ''); sync(menu); }
+      }
+
+      function makeMenu(trigger, entries, parentMenu = null) {
+        const id = `actions-${++nextId}`;
+        trigger.id = `${id}-trigger`;
+        trigger.type = 'button';
+        trigger.setAttribute('aria-haspopup', 'menu');
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.setAttribute('aria-controls', id);
+        trigger.setAttribute('commandfor', id);
+        trigger.setAttribute('command', 'toggle-popover');
+        const menu = document.createElement('div');
+        menu.id = id;
+        menu.className = 'action-menu';
+        menu.setAttribute('popover', 'auto');
+        const group = document.createElement('div');
+        group.setAttribute('focusgroup', 'menu nomemory');
+        group.setAttribute('aria-labelledby', trigger.id);
+        if (!nativeFocusgroup) group.setAttribute('role', 'menu');
+        menu.append(group);
+        Object.assign(menu, { trigger, group, parentMenu });
+        menus.push(menu);
+        trigger.after(menu);
+        // Explicit anchors also support browsers without showPopover({source}).
+        trigger.style.setProperty('anchor-name', `--${id}`);
+        menu.style.setProperty('position-anchor', `--${id}`);
+
+        for (const entry of entries) {
+          if (entry.separator) { group.append(document.createElement('hr')); continue; }
+          if (entry.caption) {
+            const caption = document.createElement('p');
+            caption.className = 'menu-caption';
+            caption.textContent = entry.caption;
+            group.append(caption);
+            continue;
+          }
+          const item = document.createElement(entry.href ? 'a' : 'button');
+          item.className = 'menu-item';
+          item.textContent = entry.label;
+          if (entry.href) item.href = entry.href;
+          else item.type = 'button';
+          if (!nativeFocusgroup) {
+            item.tabIndex = -1;
+            item.setAttribute('role', 'menuitem');
+          }
+          if (entry.radio) {
+            item.setAttribute('role', 'menuitemradio');
+            item.setAttribute('aria-checked', String(entry.checked));
+          }
+          if (entry.checkbox) {
+            item.setAttribute('role', 'menuitemcheckbox');
+            item.setAttribute('aria-checked', 'false');
+          }
+          group.append(item);
+          if (entry.children) {
+            const arrow = document.createElement('span');
+            arrow.className = 'chevron';
+            arrow.setAttribute('aria-hidden', 'true');
+            arrow.textContent = '›';
+            item.append(arrow);
+            makeMenu(item, entry.children, menu);
+          } else {
+            item.addEventListener('click', () => {
+              if (entry.radio) {
+                // Radio sets may span nested milk-category submenus.
+                const root = rootOf(menu);
+                root.querySelectorAll('[data-radio]').forEach(option => {
+                  if (option.dataset.radio === entry.radio) option.setAttribute('aria-checked', String(option === item));
+                });
+              }
+              if (entry.checkbox) item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+              entry.action?.(item);
+              close(rootOf(menu), true);
+            });
+            if (entry.radio) item.dataset.radio = entry.radio;
+            if (entry.checkbox) {
+              item.addEventListener('keydown', event => {
+                if (event.key !== ' ') return;
+                event.preventDefault();
+                event.stopPropagation();
+                item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+                entry.action?.(item);
+              });
+            }
+          }
+        }
+        if (nativePopover) menu.addEventListener('toggle', () => sync(menu));
+        trigger.addEventListener('click', event => {
+          if (!nativeCommands || !nativePopover) {
+            event.preventDefault();
+            if (open(menu)) close(menu, true);
+            else show(menu, event.detail === 0 ? 'first' : null);
+          } else {
+            menu.enter = event.detail === 0 && !open(menu) ? 'first' : null;
+          }
+        });
+        trigger.addEventListener('keydown', event => {
+          if (!parentMenu && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
+            event.preventDefault();
+            event.stopPropagation();
+            show(menu, event.key === 'ArrowUp' ? 'last' : 'first');
+          }
+        });
+        group.addEventListener('keydown', event => {
+          if (event.target.closest('[focusgroup]') !== group) return;
+          const list = items(menu);
+          const current = list.indexOf(document.activeElement);
+          const key = event.key;
+          if (!nativeFocusgroup && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(key)) {
+            event.preventDefault();
+            event.stopPropagation();
+            const index = key === 'Home' ? 0 : key === 'End' ? list.length - 1 :
+              (current + (key === 'ArrowUp' ? -1 : 1) + list.length) % list.length;
+            list[index]?.focus();
+          } else if (key === 'ArrowRight') {
+            const child = menus.find(candidate => candidate.trigger === event.target);
+            if (child) { event.preventDefault(); event.stopPropagation(); show(child, 'first'); }
+          } else if (key === 'ArrowLeft' && parentMenu) {
+            event.preventDefault(); event.stopPropagation(); close(menu, true);
+          } else if (key.length === 1 && /\S/.test(key) && !event.ctrlKey && !event.metaKey && !event.altKey) {
+            const next = [...list.slice(current + 1), ...list.slice(0, current + 1)]
+              .find(item => item.textContent.trim().toLowerCase().startsWith(key.toLowerCase()));
+            if (next) { event.preventDefault(); next.focus(); }
+          }
+        });
+        return menu;
+      }
+
+      const cards = [...document.querySelectorAll('[data-drink]')];
+      const filter = (key, label) => {
+        cards.forEach(card => { card.hidden = key !== 'all' && card.dataset.drink !== key; });
+        announce(key === 'all' ? 'Showing all seasonal favorites.' : `Showing ${label}. Choose Drink options to customize.`);
+        document.getElementById('favorites-heading').scrollIntoView({ block: 'center' });
+      };
+      const category = (label, key) => ({ label, action: () => filter(key, label) });
+      const navTrigger = document.createElement('button');
+      navTrigger.className = 'nav-trigger';
+      navTrigger.innerHTML = 'Menu <span class="chevron" aria-hidden="true">⌄</span>';
+      document.getElementById('drink-menu-slot').replaceChildren(navTrigger);
+      makeMenu(navTrigger, [
+        { caption: 'Find your daily grind' },
+        { label: 'All seasonal favorites', action: () => filter('all') },
+        { separator: true },
+        { label: 'Drink categories', children: [
+          { label: 'Hot coffee', children: [category('Maple Oat Latte', 'maple'), category('Dark Roast Espresso', 'espresso')] },
+          { label: 'Cold coffee', children: [category('Cold Brew', 'cold-brew')] },
+          { label: 'Seasonal specials', children: [category('Maple Oat Latte', 'maple')] }
+        ] },
+        { separator: true },
+        { label: 'Full café menu', href: '/menu' },
+        { label: 'Order online', href: '/order-online' }
+      ]);
+
+      cards.forEach(card => {
+        const name = card.querySelector('h3').textContent;
+        const state = { size: 'Regular', milk: card.dataset.drink === 'maple' ? 'Oat milk' : 'No milk', temperature: card.dataset.drink === 'cold-brew' ? 'Iced' : 'Hot' };
+        const selection = card.querySelector('.drink-selection');
+        const update = () => { selection.textContent = `${state.size} · ${state.milk} · ${state.temperature}`; };
+        update();
+        const choices = (field, values) => values.map(label => ({
+          label, radio: field, checked: state[field] === label,
+          action: () => { state[field] = label; update(); announce(`${name}: ${label} selected.`); }
+        }));
+        const slot = card.querySelector('.card-menu-slot');
+        const detailsURL = slot.querySelector('a').getAttribute('href');
+        const trigger = document.createElement('button');
+        trigger.className = 'btn';
+        trigger.setAttribute('aria-label', `Drink options for ${name}`);
+        trigger.innerHTML = 'Drink options <span class="chevron" aria-hidden="true">⌄</span>';
+        slot.replaceChildren(trigger);
+        makeMenu(trigger, [
+          { caption: name },
+          { label: 'Add to order', action: () => {
+            orderCount++;
+            announce(`${name} added to your order — ${selection.textContent}. ${orderCount} ${orderCount === 1 ? 'drink' : 'drinks'} in your order.`);
+          } },
+          { label: 'Customize drink', children: [
+            { label: 'Size', children: choices('size', ['Small', 'Regular', 'Large']) },
+            { label: 'Milk', children: [
+              ...choices('milk', ['No milk']),
+              { label: 'Dairy', children: choices('milk', ['Whole milk', 'Skim milk']) },
+              { label: 'Plant-based', children: choices('milk', ['Oat milk', 'Almond milk', 'Soy milk']) }
+            ] },
+            { label: 'Temperature', children: choices('temperature', card.dataset.drink === 'cold-brew' ? ['Iced', 'Light ice', 'No ice'] : ['Hot', 'Extra hot', 'Iced']) }
+          ] },
+          { separator: true },
+          { label: 'Save as a favorite', checkbox: true, action: item => announce(`${name} ${item.getAttribute('aria-checked') === 'true' ? 'saved as a favorite' : 'removed from favorites'}.`) },
+          { label: 'View details', href: detailsURL }
+        ]);
+      });
+
+      document.addEventListener('keydown', event => {
+        const active = document.activeElement;
+        const containing = active.closest('.action-menu');
+        const invoked = menus.find(menu => menu.trigger === active && open(menu));
+        if (event.key === 'Escape' && (containing || invoked)) {
+          event.preventDefault(); event.stopPropagation();
+          close(invoked || containing, true);
+        } else if (event.key === 'Tab' && (containing || invoked)) {
+          // Start native Tab navigation from the root's position in document order.
+          close(rootOf(containing || invoked), true);
+        }
+      }, true);
+      document.addEventListener('focusin', event => {
+        menus.filter(menu => !menu.parentMenu && open(menu)).forEach(menu => {
+          if (event.target !== menu.trigger && !menu.contains(event.target)) close(menu);
+        });
+      });
+      if (!nativePopover) document.addEventListener('pointerdown', event => {
+        menus.filter(menu => !menu.parentMenu && open(menu)).forEach(menu => {
+          if (event.target !== menu.trigger && !menu.trigger.contains(event.target) && !menu.contains(event.target)) close(menu);
+        });
+      });
+      window.addEventListener('resize', () => menus.filter(open).forEach(position));
+      // Dismiss on page scroll rather than leaving a fallback menu detached.
+      window.addEventListener('scroll', event => {
+        if (event.target !== document) return;
+        menus.filter(menu => !menu.parentMenu && open(menu)).forEach(menu => {
+          close(menu, menu.contains(document.activeElement));
+        });
+      }, true);
+    })();
+  </script>
