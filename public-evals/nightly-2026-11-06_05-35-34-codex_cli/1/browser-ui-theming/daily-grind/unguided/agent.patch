+  <script>
+    const form = document.querySelector('#coffee-order');
+    const sweetness = document.querySelector('#sweetness');
+    const summary = document.querySelector('#order-summary');
+    const date = document.querySelector('#pickup-date');
+    const today = new Date();
+    const localDate = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'),
+      String(today.getDate()).padStart(2, '0')].join('-');
+    date.min = localDate;
+    date.value = localDate;
+
+    form.addEventListener('input', () => {
+      document.querySelector('#sweetness-value').value = sweetness.value;
+      summary.textContent = '';
+    });
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const order = new FormData(form);
+      const pickup = new Date(`${order.get('pickup-date')}T${order.get('pickup-time')}`);
+      summary.textContent = `${order.get('size')} ${order.get('drink')} with ${order.get('milk').toLowerCase()}, ` +
+        `sweetness ${order.get('sweetness')}/4${order.has('extra-shot') ? ', plus an extra shot' : ''}. ` +
+        `Pickup: ${pickup.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })}. ` +
