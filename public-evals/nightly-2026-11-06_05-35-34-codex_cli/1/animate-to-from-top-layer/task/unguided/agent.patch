+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation" autofocus>&times;</button>
+    <h2 id="logout-title">Ready to log out?</h2>
+    <p id="logout-description">You’ll need to sign in again to access your account and rewards.</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn">Stay signed in</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="ordering-notice" hidden aria-label="Online ordering information">
+    <div role="status" aria-live="polite" aria-atomic="true">
+      <strong>Ordering update</strong>
+      <p>online ordering is currently offline</p>
+    </div>
+    <button type="button" class="close-button" id="dismiss-notice-btn" aria-label="Dismiss ordering information">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('ordering-notice');
+    const pendingClosures = new WeakMap();
+
+    // Keep each surface visible until its CSS exit animation has finished.
+    async function animateClose(element, finish) {
+      if (pendingClosures.has(element)) return;
+      const closure = {};
+      pendingClosures.set(element, closure);
+      element.classList.add('is-closing');
+      await Promise.allSettled(element.getAnimations().map(animation => animation.finished));
+      if (pendingClosures.get(element) !== closure) return;
+      finish();
+      element.classList.remove('is-closing');
+      pendingClosures.delete(element);
+    }
+
+    function closeDialog() {
+      if (dialog.open) animateClose(dialog, () => dialog.close());
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (
+        event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom
+      )) closeDialog();
+    });
+
+    function dismissNotice() {
+      animateClose(notice, () => {
+        if (notice.contains(document.activeElement)) orderButton.focus();
+        notice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      pendingClosures.delete(notice);
+      notice.classList.remove('is-closing');
+      notice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !dialog.open && !notice.hidden) dismissNotice();
+    });
+  </script>
