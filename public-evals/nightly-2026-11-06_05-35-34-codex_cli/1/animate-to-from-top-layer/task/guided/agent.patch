+  <dialog id="logout-dialog" class="overlay-panel" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <button type="button" id="confirm-logout-btn" class="btn">Log out</button>
+    </div>
+  </dialog>
+
+  <section id="ordering-notice" class="overlay-panel" popover="manual" aria-labelledby="ordering-title" hidden>
+    <button type="button" id="dismiss-notice-btn" class="overlay-close" aria-label="Dismiss ordering notice">&times;</button>
+    <h2 id="ordering-title">Ordering update</h2>
+    <p role="status">online ordering is currently offline</p>
+  </section>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep the element (and the modal backdrop) open until CSS exit transitions
+    // finish, including browsers without discrete display/overlay transitions.
+    async function animateClose(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      await Promise.race([
+        Promise.allSettled(element.getAnimations({ subtree: true }).map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+
+    function dismissLogout() {
+      return animateClose(logoutDialog, () => logoutDialog.close());
+    }
+
+    document.getElementById('close-dialog-btn').addEventListener('click', dismissLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', dismissLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      dismissLogout();
+    });
+    document.getElementById('confirm-logout-btn').addEventListener('click', () => {
+      animateClose(logoutDialog, () => {
+        logoutDialog.close();
+        window.location.assign(logoutLink.href);
+      });
+    });
+
+    function dismissNotice() {
+      const returnFocus = orderingNotice.contains(document.activeElement);
+      return animateClose(orderingNotice, () => {
+        if (supportsPopover) orderingNotice.hidePopover();
+        orderingNotice.hidden = true;
+        orderingNotice.removeAttribute('data-visible');
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (returnFocus) orderButton.focus();
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      if (orderingNotice.hasAttribute('data-visible')) {
+        dismissNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      if (supportsPopover) orderingNotice.showPopover();
+      orderingNotice.setAttribute('data-visible', '');
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open && orderingNotice.hasAttribute('data-visible')) {
+        dismissNotice();
+      }
+    });
+  </script>
