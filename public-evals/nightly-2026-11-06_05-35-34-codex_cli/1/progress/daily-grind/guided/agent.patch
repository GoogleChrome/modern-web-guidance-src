+    /* Rewards and order progress */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: clamp(20px, 4vw, 32px);
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 8px;
+      background: #fff8ef;
+    }
+
+    .progress-eyebrow {
+      margin-bottom: 4px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+    }
+
+    .progress-panel h2 {
+      color: var(--primary);
+      font-size: 1.5rem;
+      line-height: 1.3;
+    }
+
+    .progress-intro {
+      margin-top: 8px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 24px;
+      margin-top: 24px;
+    }
+
+    .progress-heading {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      gap: 4px 16px;
+      margin-bottom: 10px;
+    }
+
+    .progress-heading label {
+      font-weight: 700;
+    }
+
+    .progress-detail {
+      margin-top: 8px;
+      font-size: 0.875rem;
+    }
+
+    .coffee-progress {
+      --progress-duration: 1.8s;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      appearance: none;
+      border: 0 solid;
+      border-radius: 999px;
+      overflow: clip;
+      background: var(--secondary);
+      container-type: inline-size;
+    }
+
+    .coffee-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .coffee-progress::-webkit-progress-value {
+      background: var(--primary);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress::-moz-progress-bar {
+      background: var(--primary);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress:indeterminate {
+      --progress-animation: coffee-loading var(--progress-duration) linear infinite;
+    }
+
+    .coffee-progress:indeterminate:dir(rtl) {
+      --progress-animation: coffee-loading var(--progress-duration) linear infinite reverse;
+    }
+
+    @keyframes coffee-loading {
+      from, to {
+        inline-size: 30%;
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .coffee-progress {
+        --progress-duration: 10s;
+      }
+    }
+
