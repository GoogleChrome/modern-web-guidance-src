+  <script type="module">
+    const triggers = [...document.querySelectorAll('.details-trigger')];
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchors = CSS.supports('position-area: inline-end');
+
+    // Keep overlays beside their own links even without CSS anchor positioning.
+    function positionTooltip(trigger, tooltip) {
+      if (hasAnchors && hasPopover) return;
+      const rect = trigger.getBoundingClientRect();
+      const { width, height } = tooltip.getBoundingClientRect();
+      const gap = 8;
+      let left = rect.right + gap;
+      let top = rect.top + (rect.height - height) / 2;
+      if (left + width > document.documentElement.clientWidth - 12) {
+        left = rect.left - width - gap;
+      }
+      if (left < 12) {
+        left = Math.max(12, Math.min(rect.left, document.documentElement.clientWidth - width - 12));
+        top = rect.top - height - gap;
+        if (top < 12) top = rect.bottom + gap;
+      }
+      tooltip.style.left = `${left}px`;
+      tooltip.style.top = `${Math.max(12, Math.min(top, innerHeight - height - 12))}px`;
+    }
+
+    for (const trigger of triggers) {
+      const tooltip = document.getElementById(trigger.getAttribute('interestfor'));
+      // Explicit anchors also work when the interest invoker is polyfilled.
+      trigger.style.anchorName = `--${tooltip.id}`;
+      tooltip.style.positionAnchor = `--${tooltip.id}`;
+      tooltip.addEventListener('toggle', event => {
+        if (event.newState === 'open') positionTooltip(trigger, tooltip);
+      });
+    }
+
+    function repositionOpenTooltips() {
+      for (const trigger of triggers) {
+        const tooltip = document.getElementById(trigger.getAttribute('interestfor'));
+        if (tooltip.getClientRects().length) positionTooltip(trigger, tooltip);
+      }
+    }
+    window.addEventListener('resize', repositionOpenTooltips);
+    document.addEventListener('scroll', repositionOpenTooltips, true);
+
+    // Use native interest behavior where available; load the shim only as needed.
+    let needsFallback = !hasPopover;
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement') && hasPopover) {
+      try {
+        await import('https://unpkg.com/interestfor@latest');
+      } catch {
+        needsFallback = true;
+      }
+    }
+
+    // Also preserve hover/focus access in older browsers or when the CDN is offline.
+    if (needsFallback) {
+      let closeActive = () => {};
+      for (const trigger of triggers) {
+        const tooltip = document.getElementById(trigger.getAttribute('interestfor'));
+        let timer;
+        tooltip.style.display = 'none';
+        tooltip.setAttribute('role', 'tooltip');
+        trigger.setAttribute('aria-describedby', tooltip.id);
+        const close = () => {
+          clearTimeout(timer);
+          if (hasPopover && tooltip.matches(':popover-open')) tooltip.hidePopover();
+          tooltip.style.display = 'none';
+        };
+        const open = () => {
+          clearTimeout(timer);
+          closeActive();
+          closeActive = close;
+          tooltip.style.display = 'block';
+          if (hasPopover) tooltip.showPopover();
+          positionTooltip(trigger, tooltip);
+        };
+        const scheduleClose = () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => {
+            if (!trigger.matches(':hover, :focus') && !tooltip.matches(':hover')) close();
+          }, 150);
+        };
+        trigger.addEventListener('pointerenter', open);
+        trigger.addEventListener('focus', open);
+        trigger.addEventListener('pointerleave', scheduleClose);
+        trigger.addEventListener('blur', scheduleClose);
+        tooltip.addEventListener('pointerenter', () => clearTimeout(timer));
+        tooltip.addEventListener('pointerleave', scheduleClose);
+      }
+      document.addEventListener('keydown', event => {
+        if (event.key === 'Escape') closeActive();
+      });
+      document.addEventListener('pointerdown', event => {
+        if (!event.target.closest('.details-trigger, .details-tooltip')) closeActive();
+      });
+    }
+  </script>
