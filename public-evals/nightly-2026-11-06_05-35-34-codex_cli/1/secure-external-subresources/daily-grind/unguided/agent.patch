+  <script type="module">
+    // Fonts and images are fetched with SRI before their bytes reach a renderer.
+    // Never fall back to the original URL: changed or unavailable assets stay unused.
+    // Photos use a fixed JPEG format so content negotiation cannot change the digest.
+    const assets = {
+      "font": {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.1.1/files/lora-latin-400-normal.woff2",
+        "integrity": "sha384-l9U4hpuXvD+l+EFv6G1yCdXR5QTgqh3KTS7oWKueUdtbW2OoySBd6//69e9OA7ro"
+      },
+      "hero": {
+        "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+        "integrity": "sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H"
+      },
+      "latte": {
+        "url": "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&q=80",
+        "integrity": "sha384-2WFWQLT/1Eqcaxll4bOFYFCC7h/cBXjjJnnmjOV+LCv2DD2clo3PTPGoTN08yR3F"
+      },
+      "espresso": {
+        "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&q=80",
+        "integrity": "sha384-wqGHChbcB+Va9BNMq8h0BtppueEH5J6RxXVw812ezagRlAVbtRiItVxNYYHsYbP5"
+      },
+      "coldBrew": {
+        "url": "https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=600&q=80",
+        "integrity": "sha384-8KwOXhfBGsorT8gUeIAr+TRIQLjKMcI1EuhN+Z8URvsqDK94JS3Y0VI3jQJgRaGW"
+      }
+    };
+
+    async function verifiedResponse(asset) {
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadFont() {
+      const response = await verifiedResponse(assets.font);
+      const font = new FontFace('Lora', await response.arrayBuffer(), {
+        weight: '400', style: 'normal', display: 'swap'
+      });
+      await font.load();
+      document.fonts.add(font);
+    }
+
+    async function loadImage(name) {
+      const response = await verifiedResponse(assets[name]);
+      const objectURL = URL.createObjectURL(await response.blob());
+      try {
+        if (name === 'hero') {
+          document.querySelector('.hero').style.setProperty('--hero-image', `url("${objectURL}")`);
+        } else {
+          const image = document.getElementById(`${name}-image`);
+          image.src = objectURL;
+          await image.decode();
+          image.hidden = false;
+        }
+        // Keep successful blob URLs alive for the document's lifetime.
+      } catch (error) {
+        URL.revokeObjectURL(objectURL);
+        throw error;
+      }
+    }
+
+    if (window.dayjs) {
+      document.getElementById('copyright-year').textContent = window.dayjs().format('YYYY');
+    }
+
+    // Each asset fails independently, preserving readable text and fallback fonts.
+    const results = await Promise.allSettled([
+      loadFont(),
+      ...['hero', 'latte', 'espresso', 'coldBrew'].map(loadImage)
+    ]);
+    for (const result of results) {
+      if (result.status === 'rejected') console.warn('External asset was not loaded.', result.reason);
+    }
+  </script>
