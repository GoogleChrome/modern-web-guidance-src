+
+      const imageTargets = {
+        hero: '.hero',
+        maple: '.photo-maple',
+        espresso: '.photo-espresso',
+        cold: '.photo-cold'
+      };
+      for (const [name, selector] of Object.entries(imageTargets)) {
+        (async () => {
+          const response = await fetchVerified(verifiedAssets[name]);
+          const objectURL = URL.createObjectURL(await response.blob());
