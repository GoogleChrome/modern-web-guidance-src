+      "url(\"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80\" cross-origin(anonymous) referrer-policy(no-referrer) integrity(\"sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H\"))"
+    );
+
+    if (!nativeIntegrity) {
+      // Fail closed: only verified bytes become fonts or image blob URLs.
+      async function fetchVerified(asset) {
+        const response = await fetch(asset.url, {
+          integrity: asset.integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer'
+        });
+        if (!response.ok) throw new Error('Asset request failed: ' + response.status);
+        return response;
