+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const download = document.getElementById('feedback-download');
+    const modelProgress = document.getElementById('model-progress');
+    const downloadPercent = document.getElementById('download-percent');
+    let detector;
+    let availability;
+    let busy = false;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Built-in language detection is not supported in this browser. Try a supported desktop browser.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          feedbackStatus.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        feedbackStatus.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and detect your message’s language.';
+        detectButton.disabled = false;
+      } catch {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    messageInput.addEventListener('input', () => {
+      messageInput.setCustomValidity('');
+      if (!detectButton.disabled) feedbackStatus.textContent = '';
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || detectButton.disabled) return;
+      const message = messageInput.value.trim();
+      if (!message) {
+        messageInput.setCustomValidity('Please enter a message to detect its language.');
+        messageInput.reportValidity();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      messageInput.readOnly = true;
+      feedbackStatus.textContent = 'Preparing language detection…';
+
+      try {
+        if (!detector) {
+          if (availability !== 'available') {
+            modelProgress.value = 0;
+            downloadPercent.textContent = '0%';
+            download.hidden = false;
+          }
+          // Creation stays inside the submit gesture so the browser can download the model.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.round(Math.max(0, Math.min(1, event.loaded)) * 100);
+                download.hidden = false;
+                modelProgress.value = percent;
+                downloadPercent.textContent = `${percent}%`;
+              });
+            },
+          });
+        }
+
+        download.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const [result] = await detector.detect(message);
+        if (!result || result.detectedLanguage === 'und' || !Number.isFinite(result.confidence)) {
+          feedbackStatus.textContent = 'The language could not be identified. Try a longer message.';
+          return;
+        }
+
+        const languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(result.detectedLanguage);
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(result.confidence);
+        feedbackStatus.textContent = `Language: ${languageName}. AI confidence: ${confidence}.`;
+      } catch {
+        feedbackStatus.textContent = 'Language detection failed. Please try again. If a download was needed, check your connection.';
+      } finally {
+        download.hidden = true;
+        messageInput.readOnly = false;
+        detectButton.disabled = false;
+        busy = false;
+      }
+    });
+
+    checkAvailability();
+  </script>
+
 </body>
 
