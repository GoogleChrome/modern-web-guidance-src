new file mode 100644
index 0000000..4e95b63
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,24 @@
+importScripts('./smallpt.js');
+const moduleReady = createSmallpt();
+self.onmessage = async ({ data }) => {
+  try {
+    const m = await moduleReady;
+    const { width, height, samples, seed, colors } = data;
+    m._setup(width, height, samples, seed);
+    colors.forEach((hex, i) => {
+      const c = hex.match(/[a-f\d]{2}/gi).map(v => parseInt(v, 16) / 255);
+      m._color(i + 6, ...c);
+    });
+    const started = performance.now();
+    for (let y = 0; y < height; y += 4) {
+      const count = Math.min(4, height - y);
+      m._rows(y, count);
+      const start = m._buffer() + y * width * 4;
+      const pixels = m.HEAPU8.slice(start, start + count * width * 4);
+      self.postMessage({ pixels, y, count, progress: (y + count) / height, elapsed: performance.now() - started }, [pixels.buffer]);
+    }
+    self.postMessage({ done: true, elapsed: performance.now() - started });
+  } catch (error) {
+    self.postMessage({ error: String(error) });
+  }
+};
