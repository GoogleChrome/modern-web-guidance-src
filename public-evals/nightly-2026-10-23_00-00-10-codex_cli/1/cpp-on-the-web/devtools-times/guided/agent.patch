--- /dev/null
+++ b/public/render/app.js
@@ -0,0 +1,102 @@
+const $ = id => document.getElementById(id);
+const canvas = $('render-canvas');
+const context = canvas.getContext('2d');
+const preview = new Image();
+let worker, timer, runId = 0, started, samples = 64, hasFrame = false;
+preview.src = new URL('./preview.png', import.meta.url).href;
+preview.onload = () => { if (!hasFrame) context.drawImage(preview, 0, 0, canvas.width, canvas.height); };
+const colors = () => ({ 6: $('mirror-color').value, 7: $('glass-color').value });
+function syncColors() {
+  $('mirror-hex').textContent = $('mirror-color').value.toUpperCase();
+  $('glass-hex').textContent = $('glass-color').value.toUpperCase();
+}
+function stop() { worker?.terminate(); clearInterval(timer); }
+function render() {
+  stop();
+  const id = ++runId;
+  const width = Number($('resolution').value), height = width * 3 / 4;
+  canvas.width = width; canvas.height = height;
+  if (preview.complete && preview.naturalWidth) context.drawImage(preview, 0, 0, width, height);
+  $('canvas-resolution').textContent = `${width} × ${height}`;
+  $('target-spp').textContent = samples;
+  $('spp').textContent = '0';
+  $('progress').style.width = '0%';
+  $('status').textContent = 'Tracing light…';
+  $('status-dot').classList.add('running');
+  $('render').innerHTML = '<span>□</span> Stop rendering';
+  $('download').disabled = true;
+  started = performance.now();
+  timer = setInterval(() => $('elapsed').textContent = `${((performance.now() - started) / 1000).toFixed(1)}s`, 100);
+  function fail(message) {
+    if (id !== runId) return;
+    stop(); $('status').textContent = message;
+    $('status-dot').classList.remove('running');
+    $('render').innerHTML = '<span>▷</span> Retry render'; worker = null;
+  }
+  try {
+    worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => fail('Renderer failed to load. Try again.');
+    worker.onmessage = ({ data }) => {
+      if (id !== runId) return;
+      if (data.error) { fail(`Render error: ${data.error}`); return; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.frame), width, height), 0, 0);
+      hasFrame = true;
+      $('download').disabled = false;
+      $('spp').textContent = data.spp;
+      $('progress').style.width = `${data.spp / samples * 100}%`;
+      if (data.done) {
+        stop(); worker = null;
+        $('elapsed').textContent = `${((performance.now() - started) / 1000).toFixed(1)}s`;
+        $('status').textContent = 'Render complete';
+        $('status-dot').classList.remove('running');
+        $('render').innerHTML = '<span>▷</span> Render scene';
+      }
+    };
+    worker.postMessage({ width, height, samples, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors: colors() });
+  } catch (error) { fail('WebAssembly could not start. Try again.'); }
+}
+function chooseSamples(value) {
+  samples = value;
+  $('samples').value = value;
+  document.querySelectorAll('[data-samples]').forEach(button => {
+    const selected = Number(button.dataset.samples) === value;
+    button.classList.toggle('selected', selected);
+    button.setAttribute('aria-pressed', String(selected));
+  });
+}
+document.querySelectorAll('[data-samples]').forEach(button => button.addEventListener('click', () => chooseSamples(Number(button.dataset.samples))));
+for (const id of ['mirror-color', 'glass-color']) $(id).addEventListener('input', syncColors);
+$('render').addEventListener('click', () => {
+  if (worker) {
+    stop(); worker = null; ++runId;
+    $('status').textContent = 'Render stopped';
+    $('status-dot').classList.remove('running');
+    $('render').innerHTML = '<span>▷</span> Render scene';
+  } else render();
+});
+$('randomize').addEventListener('click', () => {
+  const palette = ['#e9a882','#9ebce8','#bfdf98','#dba1c4','#9ed8c8','#e4cf92','#a8a0dc','#dba897'];
+  const random = crypto.getRandomValues(new Uint32Array(2));
+  const first = random[0] % palette.length;
+  const second = (first + 1 + random[1] % (palette.length - 1)) % palette.length;
+  $('mirror-color').value = palette[first]; $('glass-color').value = palette[second];
+  syncColors(); render();
+});
+$('reset').addEventListener('click', () => {
+  $('mirror-color').value = '#f2f2f2'; $('glass-color').value = '#f2f2f2';
+  $('resolution').value = '640'; chooseSamples(64); syncColors(); render();
+});
+$('download').addEventListener('click', () => canvas.toBlob(blob => {
+  if (!blob) return;
+  const url = URL.createObjectURL(blob), link = document.createElement('a');
+  link.href = url; link.download = `smallpt-${Date.now()}.png`; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}, 'image/png'));
+$('expand').addEventListener('click', () => {
+  const expanded = document.querySelector('.viewport-panel').classList.toggle('expanded');
+  $('expand').setAttribute('aria-label', expanded ? 'Collapse render' : 'Expand render');
+  $('expand').title = expanded ? 'Collapse render' : 'Expand render';
+});
+document.addEventListener('keydown', event => { if (event.key === 'Escape') { document.querySelector('.viewport-panel').classList.remove('expanded'); $('expand').setAttribute('aria-label', 'Expand render'); } });
+window.addEventListener('pagehide', stop);
+chooseSamples(64); syncColors(); render();
