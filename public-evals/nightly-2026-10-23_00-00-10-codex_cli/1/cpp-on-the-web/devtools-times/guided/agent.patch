new file mode 100644
index 0000000..6a96526
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ native/renderer.cpp -O3 -flto -fno-exceptions -Wno-return-type -Wno-c++11-narrowing -Wno-dangling-else --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sENVIRONMENT=worker \
+  -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' -sINCOMING_MODULE_JS_API='["wasmBinary"]' -sSTRICT=1 -sALLOW_MEMORY_GROWTH=1 -sASSERTIONS=1 \
+  -sEXPORTED_FUNCTIONS='["_initialize","_set_color","_image_buffer","_render_pass"]' \
+  -o public/wasm/smallpt.js
+cp native/LICENSE.txt public/wasm/LICENSE.txt
+cp native/smallpt.original.cpp public/wasm/smallpt.cpp
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..1c37b61
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,40 @@
+// Command-line execution of the browser module; no server or browser required.
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+const context = vm.createContext({ console, WebAssembly, TextDecoder, TextEncoder, URL, setTimeout, clearTimeout, WorkerGlobalScope: {} });
+const module = new vm.SourceTextModule(readFileSync('public/wasm/smallpt.js', 'utf8'), {
+  context,
+  initializeImportMeta(meta) { meta.url = 'https://smallpt.test/wasm/smallpt.js'; },
+});
+await module.link(() => { throw new Error('Unexpected dependency'); });
+await module.evaluate();
+const renderer = await module.namespace.default({ wasmBinary: readFileSync('public/wasm/smallpt.wasm') });
+function frame(color) {
+  renderer._initialize(32, 24, 42);
+  renderer._set_color(6, ...color);
+  assert.equal(renderer._render_pass(), 4);
+  assert.equal(renderer._render_pass(), 8);
+  const pixels = renderer.HEAPU8.slice(renderer._image_buffer(), renderer._image_buffer() + 32 * 24 * 4);
+  assert.equal(pixels.length, 32 * 24 * 4);
+  assert.ok(pixels.some((value, index) => index % 4 !== 3 && value > 0), 'Frame contains light');
+  assert.ok(pixels.every((value, index) => index % 4 !== 3 || value === 255), 'Frame is opaque');
+  return pixels;
+}
+const original = frame([.95, .95, .95]);
+const colored = frame([.8, .2, .3]);
+assert.notDeepEqual(original, colored, 'Sphere colors alter the traced image');
+renderer._initialize(800, 600, 42);
+assert.ok(renderer.HEAPU8.length > 16 * 1024 * 1024, 'Heap grows for large renders');
+const messages = [];
+context.self = context;
+context.fetch = async () => new Response(readFileSync('public/wasm/smallpt.wasm'), { headers: { 'Content-Type': 'application/wasm' } });
+context.postMessage = message => messages.push(message);
+const worker = new vm.SourceTextModule(readFileSync('public/render/worker.js', 'utf8'), { context });
+await worker.link(() => module);
+await worker.evaluate();
+await context.onmessage({ data: { width: 32, height: 24, samples: 8, seed: 42, colors: { 6: '#ddaabb', 7: '#aabbdd' } } });
+assert.equal(messages.length, 2, 'Worker publishes each progressive frame');
+assert.equal(messages.at(-1).done, true, JSON.stringify(messages.at(-1)));
+assert.equal(messages.at(-1).frame.length, 32 * 24 * 4);
+console.log('Wasm checks passed: initialization, progressive RGBA frames, color changes, heap growth, and worker integration.');
