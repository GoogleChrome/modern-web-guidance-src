diff --git a/public/render/worker.js b/public/render/worker.js
new file mode 100644
index 0000000..766cded
--- /dev/null
+++ b/public/render/worker.js
@@ -0,0 +1,20 @@
+import createSmallpt from '../wasm/smallpt.js';
+self.onmessage = async ({ data }) => {
+  try {
+    const module = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    module._initialize(width, height, seed);
+    for (const [index, hex] of Object.entries(colors)) {
+      const rgb = hex.match(/[a-f\d]{2}/gi).map(v => parseInt(v, 16) / 255);
+      module._set_color(Number(index), ...rgb);
+    }
+    for (let spp = 0; spp < samples;) {
+      spp = module._render_pass();
+      const pointer = module._image_buffer();
+      const frame = module.HEAPU8.slice(pointer, pointer + width * height * 4);
+      self.postMessage({ frame, spp, done: spp >= samples }, [frame.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || 'The renderer could not start.' });
+  }
+};
