diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100644
index 0000000..ce54cfc
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+mkdir -p public
+em++ src/smallpt.cpp -O3 -flto -fexceptions --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sSTRICT=1 \
+  -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH=1 \
+  -sEXPORTED_FUNCTIONS='["_init_scene","_render_rows","_pixels"]' \
+  -sFILESYSTEM=0 -sASSERTIONS=1 -sSTACK_SIZE=1048576 \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -o public/smallpt.js
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..7faf1ce
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,18 @@
+import { mkdir, copyFile, cp, readFile } from 'node:fs/promises';
+import { execFileSync } from 'node:child_process';
+
+// Validate the emitted binary and client scripts without starting a server.
+const binary = await readFile('public/smallpt.wasm');
+const module = await WebAssembly.compile(binary);
+const exports = WebAssembly.Module.exports(module).map(item => item.name);
+for (const name of ['init_scene', 'render_rows', 'pixels']) {
+  if (!exports.includes(name)) throw new Error('Missing renderer export: ' + name);
+}
+for (const file of ['app.js', 'public/render-worker.js', 'public/smallpt.js']) {
+  execFileSync(process.execPath, ['--check', file], { stdio: 'inherit' });
+}
+await mkdir('dist', { recursive: true });
+for (const name of ['index.html', 'styles.css', 'app.js']) await copyFile(name, 'dist/' + name);
+await cp('public', 'dist/public', { recursive: true });
+await cp('src', 'dist/src', { recursive: true });
+console.log('Built static site in dist/; WebAssembly compilation, renderer exports and JavaScript syntax checks passed.');
