diff --git a/README.md b/README.md
new file mode 100644
index 0000000..ec88722
--- /dev/null
+++ b/README.md
@@ -0,0 +1,24 @@
+# smallpt / light playground
+
+Kevin Beason's MIT-licensed C++ smallpt path tracer, compiled to real WebAssembly
+with Emscripten and rendered in a module Web Worker. All tracing happens locally.
+
+## Build
+Install Emscripten so `em++` is on PATH, then run `npm run build`.
+The static output is in `dist/`. No backend, cross-origin isolation, or shared
+memory is required. Serve the files over HTTP(S); module workers do not work
+from file:// URLs.
+
+The original source is retained in src/smallpt-original.cpp; src/smallpt.cpp
+retains its radiance integrator and adds progressive RGBA rendering and a
+color-setting interface. Randomize changes the mirror and glass reflectance
+colors while preserving their material models. The bundled preview was
+rendered by the same C++ adapter, at 128 samples per pixel.
+
+Each progressive pass traces four samples per pixel with the original 2×2
+subpixel camera sampling. Cancellation terminates the worker; a new worker
+loads the cached module. The UI retains the last frame until a new render's
+first full pass is ready. Resolution and quality changes apply on Re-render.
+
+Source: https://www.kevinbeason.com/smallpt/
+License: src/LICENSE.txt
diff --git a/app.js b/app.js
new file mode 100644
index 0000000..e46f7b1
--- /dev/null
+++ b/app.js
@@ -0,0 +1,145 @@
+const $ = id => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+let worker;
+let hasImage = false;
+let renderNumber = 0;
+let activeSeed = 42;
+const defaultColor = '#ffffff';
+
+const preview = new Image();
+preview.src = './public/preview.png';
+preview.onload = () => {
+  if (!hasImage) {
+    context.drawImage(preview, 0, 0, canvas.width, canvas.height);
+    hasImage = true;
+  }
+};
+const rgb = hex => [1, 3, 5].map(index => Math.min(.999, parseInt(hex.slice(index, index + 2), 16) / 255));
+const quality = () => Number(document.querySelector('input[name="quality"]:checked').value);
+
+function updateOrb(inputId, orbId) {
+  const color = $(inputId).value;
+  $(orbId).style.background = color === defaultColor ? '' :
+    `radial-gradient(circle at 30% 25%, #ffffff 1%, ${color} 40%, #273428 110%)`;
+}
+function fail(message) {
+  worker?.terminate();
+  $('viewer-state').innerHTML = '<span class="status-dot"></span> Unavailable';
+  $('progress-label').textContent = 'Could not render';
+  $('status-message').textContent = message + ' Use Re-render to try again.';
+}
+function render() {
+  worker?.terminate();
+  if (!('WebAssembly' in window) || !('Worker' in window)) {
+    fail('This browser does not support the required WebAssembly and Web Worker features.');
+    return;
+  }
+  const current = ++renderNumber;
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  const samples = quality();
+  $('sample-target').textContent = samples;
+  $('sample-count').textContent = '0';
+  $('elapsed').textContent = '0.0';
+  $('progress').value = 0;
+  $('progress-percent').textContent = '0%';
+  $('render-size').textContent = `${width} × ${height} px`;
+  $('viewer-state').innerHTML = '<span class="status-dot"></span> Rendering';
+  $('progress-label').textContent = 'Tracing a little light…';
+  $('status-message').textContent = 'Rendering locally. You can change colors or start a new render at any time.';
+  worker = new Worker(new URL('./public/render-worker.js', import.meta.url), { type: 'module' });
+  worker.onerror = event => { event.preventDefault(); if (current === renderNumber) fail('The rendering worker could not load.'); };
+  worker.onmessage = ({ data }) => {
+    if (current !== renderNumber) return;
+    if (data.type === 'error') { fail(data.message); return; }
+    // Keep the prior image visible until the first full pass is ready.
+    if (data.samples >= 4) {
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width; canvas.height = height;
+      }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+      hasImage = true;
+    }
+    const percent = Math.floor(data.progress * 100);
+    $('progress').value = percent;
+    $('progress-percent').textContent = percent + '%';
+    $('sample-count').textContent = data.samples;
+    $('elapsed').textContent = (data.elapsed / 1000).toFixed(1);
+    if (data.complete) {
+      $('viewer-state').innerHTML = '<span class="status-dot"></span> Complete';
+      $('progress-label').textContent = 'A little light, fully rendered.';
+      $('status-message').textContent = `Render complete · ${samples} samples per pixel · Seed ${activeSeed.toString(16).toUpperCase()}. Make it different with a new palette.`;
+      worker.terminate();
+    }
+  };
+  worker.postMessage({
+    width, height, samples, seed: activeSeed,
+    colors: [rgb($('mirror-color').value), rgb($('glass-color').value)],
+  });
+}
+
+function randomColor() {
+  // Pastel-biased, bright reflectance keeps mirror and glass interiors visible.
+  const hue = Math.random() * 360;
+  const saturation = 0.3 + Math.random() * 0.4;
+  const lightness = 0.68 + Math.random() * 0.16;
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  return '#' + [0, 8, 4].map(n => {
+    const k = (n + hue / 30) % 12;
+    const channel = lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+    return Math.round(channel * 255).toString(16).padStart(2, '0');
+  }).join('');
+}
+$('randomize').addEventListener('click', () => {
+  $('mirror-color').value = randomColor();
+  $('glass-color').value = randomColor();
+  updateOrb('mirror-color', 'mirror-orb');
+  updateOrb('glass-color', 'glass-orb');
+  activeSeed = crypto.getRandomValues(new Uint32Array(1))[0];
+  render();
+});
+$('rerender').addEventListener('click', render);
+for (const [input, orb] of [['mirror-color', 'mirror-orb'], ['glass-color', 'glass-orb']]) {
+  $(input).addEventListener('input', () => updateOrb(input, orb));
+  $(input).addEventListener('change', render);
+}
+document.querySelectorAll('input[name="quality"]').forEach(input => input.addEventListener('change', () => {
+  $('quality-hint').textContent = quality() + ' samples per pixel';
+  $('status-message').textContent = 'Quality updated. Choose Re-render to apply your settings.';
+}));
+$('resolution').addEventListener('change', () => {
+  $('status-message').textContent = 'Resolution updated. Choose Re-render to apply your settings.';
+});
+$('reset').addEventListener('click', () => {
+  $('resolution').value = '720';
+  document.querySelector('input[name="quality"][value="64"]').checked = true;
+  $('quality-hint').textContent = '64 samples per pixel';
+  $('mirror-color').value = $('glass-color').value = defaultColor;
+  updateOrb('mirror-color', 'mirror-orb');
+  updateOrb('glass-color', 'glass-orb');
+  activeSeed = 42;
+  render();
+});
+$('download').addEventListener('click', () => {
+  if (!hasImage) { $('status-message').textContent = 'Your image is still preparing. Try again in a moment.'; return; }
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url; link.download = `smallpt-${activeSeed.toString(16)}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+    $('status-message').textContent = 'Your current render has been saved as a PNG.';
+  }, 'image/png');
+});
+$('fullscreen').addEventListener('click', async () => {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else if ($('render-panel').requestFullscreen) await $('render-panel').requestFullscreen();
+    else $('status-message').textContent = 'Fullscreen is not available in this browser.';
+  } catch {
+    $('status-message').textContent = 'Fullscreen is not available. You can still save your render below.';
+  }
+});
+render();
