@@ -0,0 +1,99 @@
+const $ = selector => document.querySelector(selector);
+const canvas = $('#render');
+const context = canvas.getContext('2d');
+const inputs = [...document.querySelectorAll('input[type=color]')];
+const defaults = ['#bf4040', '#4040bf', '#ffffff', '#ffffff'];
+inputs.forEach((input, i) => { input.value = defaults[i]; });
+let worker;
+let ready = false;
+let renderId = 0;
+let hasFrame = false;
+let activeSamples = 64;
+const reference = new Image();
+reference.onload = () => { if (!hasFrame) context.drawImage(reference, 0, 0, canvas.width, canvas.height); };
+reference.src = './public/reference.png';
+$('#download').disabled = true;
+const renderButtons = [$('#randomize'), $('#rerender'), $('#reset')];
+renderButtons.forEach(button => { button.disabled = true; });
+function showError(message) {
+  ready = false;
+  $('#status-text').textContent = 'Could not load renderer. Reload to try again.';
+  $('#canvas-status').textContent = hasFrame ? 'RENDER INTERRUPTED' : 'REFERENCE RENDER';
+  $('#render-state .status-dot').style.background = '#d78565';
+  renderButtons.forEach(button => { button.disabled = true; });
+  console.error('smallpt:', message);
+}
+function run() {
+  if (!ready) return;
+  renderId++;
+  const width = Number($('#resolution').value);
+  activeSamples = Number($('#quality').value);
+  $('#status-text').textContent = 'Tracing light…';
+  $('#canvas-status').textContent = 'PATH TRACING';
+  $('#progress-text').textContent = `0 / ${activeSamples} samples`;
+  $('#progress').style.width = '0%';
+  $('#metric-resolution').innerHTML = `${width} × ${width * .75} <span>px</span>`;
+  $('#metric-samples').innerHTML = `${activeSamples} <span>spp</span>`;
+  $('#metric-time').innerHTML = '— <span>seconds</span>';
+  const colors = inputs.map(input => [1, 3, 5].map(offset => Math.min(.999, parseInt(input.value.slice(offset, offset + 2), 16) / 255)));
+  const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  worker.postMessage({ id: renderId, width, height: width * .75, samples: activeSamples, colors, seed });
+}
+try {
+  worker = new Worker(new URL('./public/render-worker.js', import.meta.url), { type: 'module' });
+  worker.onmessage = ({ data }) => {
+    if (data.type === 'ready') {
+      ready = true;
+      renderButtons.forEach(button => { button.disabled = false; });
+      run();
+    } else if (data.type === 'frame' && data.id === renderId) {
+      hasFrame = true;
+      if (canvas.width !== data.width || canvas.height !== data.height) { canvas.width = data.width; canvas.height = data.height; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      $('#download').disabled = false;
+      $('#metric-time').innerHTML = `${(data.elapsed / 1000).toFixed(1)} <span>seconds</span>`;
+      $('#progress-text').textContent = `${data.samples} / ${activeSamples} samples`;
+      $('#progress').style.width = `${data.samples / activeSamples * 100}%`;
+      if (data.done) {
+        $('#status-text').textContent = 'Render complete';
+        $('#canvas-status').textContent = 'RENDER COMPLETE';
+      }
+    } else if (data.type === 'error' && (!data.id || data.id === renderId)) showError(data.message);
+  };
+  worker.onerror = event => showError(event.message);
+} catch (error) { showError(error.message); }
+function randomColor(hue, saturation, lightness) {
+  const chroma = (1 - Math.abs(2 * lightness - 1)) * saturation;
+  const x = chroma * (1 - Math.abs((hue / 60) % 2 - 1));
+  const m = lightness - chroma / 2;
+  const rgb = hue < 60 ? [chroma, x, 0] : hue < 120 ? [x, chroma, 0] : hue < 180 ? [0, chroma, x] : hue < 240 ? [0, x, chroma] : hue < 300 ? [x, 0, chroma] : [chroma, 0, x];
+  return '#' + rgb.map(value => Math.round((value + m) * 255).toString(16).padStart(2, '0')).join('');
+}
+$('#randomize').onclick = () => {
+  const hue = Math.random() * 360;
+  inputs.forEach((input, i) => { input.value = randomColor((hue + [0, 145, 35, 200][i] + Math.random() * 30) % 360, i < 2 ? .45 + Math.random() * .25 : .25 + Math.random() * .25, i < 2 ? .52 : .78); });
+  run();
+};
+$('#rerender').onclick = run;
+$('#reset').onclick = () => {
+  inputs.forEach((input, i) => { input.value = defaults[i]; });
+  $('#quality').value = '64';
+  $('#resolution').value = '640';
+  run();
+};
+[...inputs, $('#quality'), $('#resolution')].forEach(input => input.addEventListener('change', run));
+$('#download').onclick = () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.download = `smallpt-${renderId}.png`;
+    link.href = url;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+};
+const about = $('#about');
+$('#about-button').onclick = () => about.showModal();
+$('#close-about').onclick = () => about.close();
+about.addEventListener('click', event => { if (event.target === about) { const bounds = about.getBoundingClientRect(); if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) about.close(); } });
