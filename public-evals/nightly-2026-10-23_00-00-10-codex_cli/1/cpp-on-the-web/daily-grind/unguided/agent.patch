--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,32 @@
+import createSmallpt from './smallpt.js';
+let engine;
+let generation = 0;
+const ready = createSmallpt().then(module => { engine = module; postMessage({ type: 'ready' }); });
+self.onmessage = async ({ data }) => {
+  const job = ++generation;
+  try {
+    await ready;
+    if (job !== generation) return;
+    const { width, height, samples, colors, seed } = data;
+    if (![480, 640, 800].includes(width) || height !== width * .75 || ![32, 64, 128, 256].includes(samples)) throw new Error('Invalid render settings');
+    colors.forEach((color, i) => engine._set_color([0, 1, 6, 7][i], ...color));
+    engine._init_render(width, height, seed);
+    const start = performance.now();
+    let lastUpdate = 0;
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 12) {
+        if (job !== generation) return;
+        engine._render_rows(row, 12);
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+      const now = performance.now();
+      if (now - lastUpdate > 150 || (pass + 1) * 4 === samples) {
+        const pointer = engine._get_pixels();
+        const pixels = engine.HEAPU8.slice(pointer, pointer + width * height * 4);
+        postMessage({ type: 'frame', id: data.id, pixels, width, height, samples: (pass + 1) * 4, elapsed: now - start, done: (pass + 1) * 4 === samples }, [pixels.buffer]);
+        lastUpdate = now;
+      }
+    }
+  } catch (error) { postMessage({ type: 'error', id: data.id, message: error.message }); }
+};
+ready.catch(error => postMessage({ type: 'error', message: error.message }));
