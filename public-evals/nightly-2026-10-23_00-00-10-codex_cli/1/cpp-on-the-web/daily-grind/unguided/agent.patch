+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/smallpt-wasm.cpp -O3 -Wno-c++11-narrowing -Wno-dangling-else -Wno-return-type --no-entry -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node -s ALLOW_MEMORY_GROWTH=1 -s FILESYSTEM=0 -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s EXPORTED_FUNCTIONS='["_init_render","_render_rows","_get_pixels","_set_color"]' -o public/smallpt.js
diff --git a/scripts/test-wasm.mjs b/scripts/test-wasm.mjs
new file mode 100644
index 0000000..b19b69c
--- /dev/null
+++ b/scripts/test-wasm.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import createSmallpt from '../public/smallpt.js';
+const wasmBinary = await fs.readFile(new URL('../public/smallpt.wasm', import.meta.url));
+assert.equal(WebAssembly.validate(wasmBinary), true);
+const module = await createSmallpt({ wasmBinary });
+function render(color, seed = 42) {
+  module._set_color(6, ...color);
+  module._set_color(7, ...color);
+  module._init_render(48, 36, seed);
+  for (let pass = 0; pass < 8; pass++) for (let row = 0; row < 36; row += 12) module._render_rows(row, 12);
+  const ptr = module._get_pixels();
+  return module.HEAPU8.slice(ptr, ptr + 48 * 36 * 4);
+}
+const neutral = render([.999, .999, .999]);
+assert(neutral.some((value, i) => i % 4 !== 3 && value > 0), 'Image has lit pixels');
+assert(neutral.every((value, i) => i % 4 !== 3 || value === 255), 'All pixels are opaque');
+assert(neutral.some((value, i) => i % 4 !== 3 && value < 100), 'Scene has shadows');
+assert.notDeepEqual(render([.85, .25, .45]), neutral, 'Sphere colors affect rendered pixels');
+assert.deepEqual(render([.999, .999, .999]), neutral, 'Reinitialization produces deterministic output');
+assert.notDeepEqual(render([.999, .999, .999], 123), neutral, 'New random seed creates new paths');
+module._init_render(800, 600, 100);
+module._render_rows(0, 12);
+assert(module._get_pixels() > 0, 'Largest supported image allocates successfully');
+console.log('PASS: valid WASM, real rendered pixels, sphere tint, seed variation, repeatable reset, and 800×600 allocation.');
