+  <script>
+    const dialog = document.querySelector('#feedback-dialog');
+    const form = document.querySelector('#feedback-form');
+    const message = document.querySelector('#feedback-message');
+    const status = document.querySelector('#feedback-status');
+    const success = document.querySelector('#feedback-success');
+    const launcher = document.querySelector('#open-feedback');
+    const hosts = [document.querySelector('#feedback-host-main'), document.querySelector('#feedback-host-footer')];
+    let hostIndex = 0;
+    let returnFocus = launcher;
+    hosts[0].append(dialog);
+
+    function updateCount() {
+      document.querySelector('#feedback-count').textContent = `${message.value.length} / 500`;
+    }
+    function draftData() {
+      return Object.fromEntries(new FormData(form));
+    }
+    try {
+      const draft = JSON.parse(localStorage.getItem('daily-grind-feedback-draft') || 'null');
+      if (draft) {
+        message.value = typeof draft.message === 'string' ? draft.message.slice(0, 500) : '';
+        for (const input of form.querySelectorAll('input[type="radio"]')) {
+          if (draft[input.name] === input.value) input.checked = true;
+        }
+      }
+    } catch { /* The form also works when device storage is unavailable. */ }
+    updateCount();
+    form.addEventListener('input', () => {
+      updateCount();
+      try { localStorage.setItem('daily-grind-feedback-draft', JSON.stringify(draftData())); } catch {}
+    });
+
+    function openFeedback() {
+      if (dialog.open) return;
+      returnFocus = document.activeElement === document.body ? launcher : document.activeElement;
+      dialog.showModal();
+    }
+    launcher.addEventListener('click', openFeedback);
+    document.querySelector('#close-feedback').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      // A fallback move queues a close event, but immediately reopens the dialog.
+      if (!dialog.open && returnFocus?.isConnected) returnFocus.focus({ preventScroll: true });
+    });
+
+    document.querySelector('#move-feedback').addEventListener('click', () => {
+      const destinationIndex = 1 - hostIndex;
+      const destination = hosts[destinationIndex];
+      const activeElement = document.activeElement;
+      const wasOpen = dialog.open;
+      const wasModal = dialog.matches(':modal');
+      const returnValue = dialog.returnValue;
+      const dialogScroll = dialog.scrollTop;
+      const fieldScroll = message.scrollTop;
+      const pageScroll = { x: window.scrollX, y: window.scrollY };
+      const selection = activeElement === message
+        ? [message.selectionStart, message.selectionEnd, message.selectionDirection] : null;
+
+      function fallbackMove() {
+        if (wasOpen) dialog.close();
+        destination.append(dialog);
+        if (wasOpen) {
+          if (wasModal) dialog.showModal();
+          else dialog.show();
+        }
+        dialog.returnValue = returnValue;
+        if (dialog.contains(activeElement)) activeElement.focus({ preventScroll: true });
+        if (selection) message.setSelectionRange(...selection);
+        dialog.scrollTop = dialogScroll;
+        message.scrollTop = fieldScroll;
+        window.scrollTo(pageScroll.x, pageScroll.y);
+      }
+
+      if (typeof destination.moveBefore === 'function') {
+        try {
+          // An atomic DOM move preserves top-layer membership and active focus.
+          destination.moveBefore(dialog, null);
+        } catch {
+          fallbackMove();
+        }
+      } else {
+        fallbackMove();
+      }
+      hostIndex = destinationIndex;
+      dialog.dataset.position = hostIndex === 1 ? 'right' : 'left';
+      status.textContent = `Window moved ${hostIndex === 1 ? 'right' : 'left'}. Your draft is still here.`;
+    });
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-feedback', JSON.stringify({ ...draftData(), savedAt: new Date().toISOString() }));
+        localStorage.removeItem('daily-grind-feedback-draft');
+      } catch {
+        status.textContent = 'Device storage is unavailable. Your feedback is still here; please try again.';
+        return;
+      }
+      form.hidden = true;
+      success.hidden = false;
+      document.querySelector('#feedback-again').focus({ preventScroll: true });
+      status.textContent = 'A little care goes a long way. Thank you.';
+    });
+    document.querySelector('#feedback-again').addEventListener('click', () => {
+      form.reset();
+      updateCount();
+      form.hidden = false;
+      success.hidden = true;
+      status.textContent = 'Make yourself at home. Your draft stays with you.';
+      message.focus({ preventScroll: true });
+    });
+    openFeedback();
+  </script>
+
