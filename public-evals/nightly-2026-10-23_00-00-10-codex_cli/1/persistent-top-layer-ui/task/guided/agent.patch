+  <button type="button" class="btn feedback-launcher" id="feedback-open" aria-haspopup="dialog" aria-controls="feedback-dialog">Give feedback</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackOpen = document.getElementById('feedback-open');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const mainHost = document.getElementById('feedback-main-host');
+    const footerHost = document.getElementById('feedback-footer-host');
+    const draftKey = 'daily-grind-feedback-draft';
+
+    try {
+      feedbackMessage.value = localStorage.getItem(draftKey) || '';
+    } catch {
+      // Storage may be unavailable; the draft still survives moves and closing.
+    }
+
+    feedbackOpen.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+    document.getElementById('feedback-close').addEventListener('click', () => feedbackDialog.close());
+    feedbackDialog.addEventListener('close', () => {
+      // Fallback reparenting queues a close event before reopening the dialog.
+      if (!feedbackDialog.open) feedbackOpen.focus({ preventScroll: true });
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const target = feedbackDialog.parentElement === mainHost ? footerHost : mainHost;
+      if (typeof target.moveBefore === 'function') {
+        // Atomic reparenting preserves the top layer, modal state and focus.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const wasModal = feedbackDialog.matches(':modal');
+        const focused = feedbackDialog.contains(document.activeElement) ? document.activeElement : null;
+        const selection = focused instanceof HTMLTextAreaElement || focused instanceof HTMLInputElement
+          ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection] : null;
+        const dialogScroll = [feedbackDialog.scrollLeft, feedbackDialog.scrollTop];
+        const messageScroll = [feedbackMessage.scrollLeft, feedbackMessage.scrollTop];
+        const returnValue = feedbackDialog.returnValue;
+
+        // Explicitly close first: some engines retain `open` after detaching,
+        // but lose top-layer membership, so showModal() alone cannot restore it.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+        }
+        feedbackDialog.returnValue = returnValue;
+        focused?.focus({ preventScroll: true });
+        if (selection && selection[0] !== null) focused.setSelectionRange(...selection);
+        feedbackDialog.scrollLeft = dialogScroll[0];
+        feedbackDialog.scrollTop = dialogScroll[1];
+        feedbackMessage.scrollLeft = messageScroll[0];
+        feedbackMessage.scrollTop = messageScroll[1];
+      }
+      const inFooter = target === footerHost;
+      feedbackMove.textContent = inFooter ? 'Move to main content' : 'Move to footer';
+      feedbackStatus.textContent = `Moved to ${inFooter ? 'the footer' : 'main content'}. Your feedback is preserved.`;
+    });
+
+    document.getElementById('feedback-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(draftKey, feedbackMessage.value);
+        feedbackStatus.textContent = 'Draft saved on this device. Your feedback has not been sent.';
+      } catch {
+        feedbackStatus.textContent = 'Device storage is unavailable. Your draft will stay here until you reload.';
+      }
+    });
+  </script>
