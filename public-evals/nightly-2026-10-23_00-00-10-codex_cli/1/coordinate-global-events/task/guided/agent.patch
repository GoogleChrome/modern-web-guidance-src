+  <script type="module">
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+    const zones = [
+      { name: 'New York', id: 'America/New_York' },
+      { name: 'London', id: 'Europe/London' },
+      { name: 'Tokyo', id: 'Asia/Tokyo' },
+      { name: 'UTC', id: 'UTC' }
+    ];
+    const timeFormat = { hour: 'numeric', minute: '2-digit', hour12: true };
+    const dateFormat = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+    async function initializePlanner() {
+      // Prefer native Temporal. Load the same API only for unsupported browsers.
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+
+      function updatePlanner() {
+        grid.replaceChildren();
+        hostWarning.textContent = '';
+        if (!dateInput.value || !timeInput.value ||
+            !dateInput.validity.valid || !timeInput.validity.valid) {
+          hostWarning.textContent = 'Choose a valid tasting date and host time to see all four local times.';
+          return;
+        }
+
+        try {
+          const input = `${dateInput.value}T${timeInput.value}[${hostTzSelect.value}]`;
+          // Resolve once. Every timezone conversion returns a new immutable value.
+          const hostTime = Temporal.ZonedDateTime.from(input, { disambiguation: 'compatible' });
+          try {
+            Temporal.ZonedDateTime.from(input, { disambiguation: 'reject' });
+          } catch (error) {
+            if (!(error instanceof RangeError)) throw error;
+            const laterTime = Temporal.ZonedDateTime.from(input, { disambiguation: 'later' });
+            const resolved = `${hostTime.toLocaleString('en-US', timeFormat)} on ${hostTime.toLocaleString('en-US', dateFormat)} (${hostTime.timeZoneId}, UTC${hostTime.offset})`;
+            if (hostTime.epochNanoseconds === laterTime.epochNanoseconds) {
+              hostWarning.textContent = `Daylight saving gap: ${timeInput.value} does not exist on ${dateInput.value} in ${hostTzSelect.value} because the clocks move forward. The tasting has been shifted forward by the clock change to ${resolved}. All cards use this resolved time.`;
+            } else {
+              hostWarning.textContent = `Daylight saving overlap: ${timeInput.value} occurs twice on ${dateInput.value} in ${hostTzSelect.value} because the clocks move back. The tasting uses the first (earlier) occurrence: ${resolved}. The second occurrence has offset UTC${laterTime.offset}. All cards use the earlier occurrence.`;
+            }
+          }
+
+          const cards = zones.map((zone) => {
+            const localTime = hostTime.withTimeZone(zone.id);
+            const card = document.createElement('article');
+            card.className = 'card tasting-card';
+            const heading = document.createElement('h3');
+            heading.textContent = zone.name;
+            const zoneLabel = document.createElement('p');
+            zoneLabel.className = 'tasting-zone';
+            zoneLabel.textContent = zone.id;
+            const time = document.createElement('time');
+            time.className = 'tasting-time';
+            time.dateTime = localTime.toInstant().toString();
+            time.textContent = localTime.toLocaleString('en-US', timeFormat);
+            const date = document.createElement('p');
+            date.className = 'tasting-date';
+            date.textContent = localTime.toLocaleString('en-US', dateFormat);
+            const offset = document.createElement('p');
+            offset.className = 'tasting-offset';
+            offset.textContent = `UTC${localTime.offset}${zone.id === hostTzSelect.value ? ' · Host' : ''}`;
+            card.append(heading, zoneLabel, time, date, offset);
+            return card;
+          });
+          grid.replaceChildren(...cards);
+        } catch (error) {
+          hostWarning.textContent = 'This date and time could not be converted. Please choose a valid date, time, and host timezone.';
+        }
+      }
+
+      dateInput.value = Temporal.Now.zonedDateTimeISO(hostTzSelect.value).toPlainDate().toString();
+      document.getElementById('tastingFields').disabled = false;
+      for (const input of [dateInput, timeInput, hostTzSelect]) {
+        input.addEventListener('input', updatePlanner);
+        input.addEventListener('change', updatePlanner);
+      }
+      updatePlanner();
+    }
+
+    initializePlanner().catch(() => {
+      hostWarning.textContent = 'The timezone planner could not load. Please check your connection and reload, or try a browser with native Temporal support.';
+    });
+  </script>
 </body>
 
