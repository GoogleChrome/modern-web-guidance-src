+  <script>
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        document.querySelectorAll('.details-trigger').forEach((trigger) => {
+          if (trigger.matches(':hover, :focus-within')) {
+            trigger.classList.add('tooltip-dismissed');
+          }
+        });
+      }
+    });
+    document.querySelectorAll('.details-trigger').forEach((trigger) => {
+      const resetTooltip = () => {
+        if (!trigger.matches(':hover') && !trigger.contains(document.activeElement)) {
+          trigger.classList.remove('tooltip-dismissed');
+        }
+      };
+      trigger.addEventListener('mouseleave', resetTooltip);
+      trigger.addEventListener('focusout', resetTooltip);
+    });
+  </script>
