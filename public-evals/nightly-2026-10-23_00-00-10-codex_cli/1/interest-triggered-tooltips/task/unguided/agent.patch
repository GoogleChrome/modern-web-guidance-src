+      left: 50%;
+      transform: translateX(-50%);
+      z-index: 10;
+      width: 230px;
+      padding: 12px 14px;
+      border-radius: 6px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
+      font-size: 0.85rem;
+      line-height: 1.5;
+      text-align: left;
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    .details-tooltip strong {
+      display: block;
+      color: var(--accent);
+    }
+
+    .details-tooltip::before {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: calc(50% - 6px);
+      border: 6px solid transparent;
+      border-top-color: var(--primary);
+    }
+
+    /* Keep the tooltip open while the pointer crosses the gap. */
+    .details-tooltip::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 0;
+      width: 100%;
+      height: 8px;
+    }
+
+    .details-trigger:not(.tooltip-dismissed):hover .details-tooltip,
+    .details-trigger:not(.tooltip-dismissed):focus-within .details-tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .details-trigger .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
