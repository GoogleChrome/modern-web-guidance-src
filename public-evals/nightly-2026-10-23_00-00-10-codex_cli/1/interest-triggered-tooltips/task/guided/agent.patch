+  <script type="module">
+    // Load compatibility support only for browsers that need it.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@1.0.10/src/interestfor.min.js");
+    }
+
+    // Keep each tooltip beside its button when CSS anchors are unavailable.
+    if (!CSS.supports("position-area: right") || !CSS.supports("anchor-name: --details")) {
+      document.querySelectorAll(".card [interestfor]").forEach((trigger) => {
+        const tooltip = document.getElementById(trigger.getAttribute("interestfor"));
+        let open = false;
+        const position = () => {
+          if (!open) return;
+          const button = trigger.getBoundingClientRect();
+          const { width, height } = tooltip.getBoundingClientRect();
+          const gap = 8;
+          const edge = 12;
+          let left = button.right + gap;
+          let top = button.top + (button.height - height) / 2;
+          if (left + width > window.innerWidth - edge) {
+            left = button.left - width - gap;
+          }
+          if (left < edge) {
+            left = button.left + (button.width - width) / 2;
+            top = button.top - height - gap;
+            if (top < edge) top = button.bottom + gap;
+          }
+          tooltip.style.left = `${Math.max(edge, Math.min(left, window.innerWidth - width - edge))}px`;
+          tooltip.style.top = `${Math.max(edge, Math.min(top, window.innerHeight - height - edge))}px`;
+        };
+        tooltip.addEventListener("toggle", (event) => {
+          open = event.newState === "open";
+          position();
+        });
+        window.addEventListener("resize", position);
+        document.addEventListener("scroll", position, { capture: true, passive: true });
+      });
+    }
+  </script>
