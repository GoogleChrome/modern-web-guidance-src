+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const download = document.getElementById('feedback-download');
+    const downloadLabel = document.getElementById('download-label');
+    const modelProgress = document.getElementById('model-progress');
+    let detector;
+    let modelAvailability;
+    let busy = false;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Language detection is not supported in this browser. Try a browser with built-in language detection.';
+        return;
+      }
+
+      try {
+        modelAvailability = await LanguageDetector.availability();
+        if (modelAvailability === 'unavailable') {
+          feedbackStatus.textContent = 'Language detection is unavailable on this device or is blocked by browser settings.';
+          return;
+        }
+        detectButton.disabled = false;
+        feedbackStatus.textContent = modelAvailability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and detect your message’s language.';
+      } catch {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    messageInput.addEventListener('input', () => {
+      messageInput.setCustomValidity('');
+      if (modelAvailability && modelAvailability !== 'unavailable' && !busy) {
+        feedbackStatus.textContent = 'Click Detect to detect your message’s language.';
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (detectButton.disabled || busy) return;
+      const message = messageInput.value.trim();
+      if (!message) {
+        messageInput.setCustomValidity('Please enter a message.');
+        messageInput.reportValidity();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      messageInput.disabled = true;
+      feedbackForm.setAttribute('aria-busy', 'true');
+      feedbackStatus.textContent = 'Preparing language detection…';
+
+      try {
+        if (!detector) {
+          if (modelAvailability !== 'available') {
+            download.hidden = false;
+            modelProgress.value = 0;
+            downloadLabel.textContent = 'Downloading language model: 0%';
+          }
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                download.hidden = false;
+                modelProgress.value = percentage;
+                downloadLabel.textContent = `Downloading language model: ${percentage}%`;
+              });
+            }
+          });
+        }
+
+        download.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const [result] = await detector.detect(message);
+        if (!result || !result.detectedLanguage || result.detectedLanguage === 'und') {
+          feedbackStatus.textContent = 'Could not identify a language. Try a longer message with a full sentence.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        if (typeof Intl.DisplayNames === 'function') {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1
+        }).format(result.confidence);
+        feedbackStatus.textContent = `Language: ${language}. AI confidence: ${confidence}.`;
+      } catch {
+        feedbackStatus.textContent = 'Language detection failed. Check your connection and browser settings, then try Detect again.';
+      } finally {
+        busy = false;
+        download.hidden = true;
+        messageInput.disabled = false;
+        detectButton.disabled = false;
+        feedbackForm.removeAttribute('aria-busy');
+      }
+    });
+
+    checkAvailability();
+  </script>
 </body>
 
