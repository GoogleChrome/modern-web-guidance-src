+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const modelProgress = document.getElementById('model-progress');
+    let detector;
+    let availability;
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Built-in language detection is not supported in this browser. Try a browser with Language Detector support.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          feedbackStatus.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        detectButton.disabled = false;
+        feedbackStatus.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and analyze your message.';
+      } catch (error) {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const message = feedbackMessage.value.trim();
+      if (detectButton.disabled) return;
+      if (!message) {
+        feedbackStatus.textContent = 'Please enter a message first.';
+        feedbackMessage.focus();
+        return;
+      }
+
+      detectButton.disabled = true;
+      feedbackMessage.readOnly = true;
+      feedbackForm.setAttribute('aria-busy', 'true');
+
+      try {
+        if (!detector) {
+          if (availability !== 'available') {
+            modelProgress.value = 0;
+            modelProgress.hidden = false;
+            feedbackStatus.textContent = 'Downloading language model: 0%';
+          } else {
+            feedbackStatus.textContent = 'Preparing language detection…';
+          }
+          // Create directly from the submit gesture so model downloads are allowed.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                modelProgress.hidden = false;
+                modelProgress.value = percentage;
+                feedbackStatus.textContent = `Downloading language model: ${percentage}%`;
+              });
+            }
+          });
+          availability = 'available';
+        }
+
+        modelProgress.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const results = await detector.detect(message);
+        const result = results[0];
+        if (!result || !result.detectedLanguage || result.detectedLanguage === 'und' || !Number.isFinite(result.confidence)) {
+          feedbackStatus.textContent = 'Could not identify a language. Try a longer message.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        try {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        } catch (error) {
+          // Keep the language code if display names are unavailable.
+        }
+        const confidence = new Intl.NumberFormat('en', { style: 'percent', maximumFractionDigits: 1 })
+          .format(Math.min(1, Math.max(0, result.confidence)));
+        feedbackStatus.textContent = `Language: ${language} · AI confidence: ${confidence}`;
+      } catch (error) {
+        if (detector) detector.destroy();
+        detector = undefined;
+        feedbackStatus.textContent = 'Language detection failed. Please check your connection and try again.';
+      } finally {
+        modelProgress.hidden = true;
+        detectButton.disabled = false;
+        feedbackMessage.readOnly = false;
+        feedbackForm.removeAttribute('aria-busy');
+      }
+    });
+
+    feedbackMessage.addEventListener('input', () => {
+      if (availability && availability !== 'unavailable') {
+        feedbackStatus.textContent = 'Click Detect to analyze your message.';
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
 </body>
 
