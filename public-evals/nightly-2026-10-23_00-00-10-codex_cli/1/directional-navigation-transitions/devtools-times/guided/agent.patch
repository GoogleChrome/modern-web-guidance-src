diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..0297445
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,91 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-label="Top stories" aria-roledescription="carousel">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="overflow-hidden">
+            <div class="stories-track flex" data-track>
+                {articles.map((article, index) => (
+                    <div class="w-full shrink-0 min-w-0" data-story role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`} aria-hidden={index !== 0 ? 'true' : 'false'} inert={index !== 0}>
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </div>
+                ))}
+            </div>
+        </div>
+        <div class="mt-3 flex flex-wrap items-center gap-3" data-controls hidden>
+            <button type="button" data-previous disabled class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Previous</button>
+            <span class="text-xs text-gray-500" data-status aria-live="polite" aria-atomic="true">{articles.length ? 1 : 0} of {articles.length}</span>
+            <button type="button" data-next disabled={articles.length < 2} class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Next</button>
+        </div>
+    </div>
+</top-stories-slider>
+
+<style>
+    .stories-track {
+        transform: translateX(calc(var(--story-index, 0) * -100%));
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+        .stories-track {
+            transition: transform 300ms ease-in-out;
+        }
+    }
+
+    [data-controls][hidden] {
+        display: none;
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        private events?: AbortController;
+
+        connectedCallback() {
+            this.events?.abort();
+            this.events = new AbortController();
+            const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const track = this.querySelector<HTMLElement>('[data-track]');
+            const previous = this.querySelector<HTMLButtonElement>('[data-previous]');
+            const next = this.querySelector<HTMLButtonElement>('[data-next]');
+            const status = this.querySelector<HTMLElement>('[data-status]');
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            if (!track || !previous || !next || !status || !controls || !slides.length) return;
+
+            let current = 0;
+            const showStory = (index: number) => {
+                current = Math.max(0, Math.min(index, slides.length - 1));
+                track.style.setProperty('--story-index', String(current));
+                slides.forEach((slide, slideIndex) => {
+                    slide.inert = slideIndex !== current;
+                    slide.setAttribute('aria-hidden', String(slideIndex !== current));
+                });
+                previous.disabled = current === 0;
+                next.disabled = current === slides.length - 1;
+                status.textContent = `${current + 1} of ${slides.length}`;
+            };
+
+            showStory(0);
+            controls.hidden = slides.length < 2;
+            previous.addEventListener('click', () => showStory(current - 1), { signal: this.events.signal });
+            next.addEventListener('click', () => showStory(current + 1), { signal: this.events.signal });
+        }
+
+        disconnectedCallback() {
+            this.events?.abort();
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
