diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..949372b
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,92 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-label="Top stories" aria-roledescription="carousel">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="story-viewport overflow-hidden" aria-live="polite" aria-atomic="true">
+            {articles.map((article, index) => (
+                <div data-story hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                    </a>
+                    <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                </div>
+            ))}
+        </div>
+        <div class="flex items-center gap-3 mt-3" data-controls hidden>
+            <button type="button" data-previous class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Previous</button>
+            <span class="text-xs text-gray-500" data-position aria-hidden="true">1 / {articles.length}</span>
+            <button type="button" data-next class="rounded border border-gray-300 px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Next</button>
+        </div>
+    </div>
+</top-stories-slider>
+
+<style>
+    [hidden] {
+        display: none;
+    }
+
+    [data-story].from-right {
+        animation: slide-from-right 300ms ease-out;
+    }
+
+    [data-story].from-left {
+        animation: slide-from-left 300ms ease-out;
+    }
+
+    @keyframes slide-from-right {
+        from { transform: translateX(100%); }
+        to { transform: translateX(0); }
+    }
+
+    @keyframes slide-from-left {
+        from { transform: translateX(-100%); }
+        to { transform: translateX(0); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        [data-story].from-right,
+        [data-story].from-left {
+            animation: none;
+        }
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            const position = this.querySelector<HTMLElement>('[data-position]');
+            let current = 0;
+
+            if (stories.length < 2 || !controls) return;
+            controls.hidden = false;
+
+            const move = (direction: number) => {
+                stories[current].hidden = true;
+                stories[current].classList.remove('from-right', 'from-left');
+                current = (current + direction + stories.length) % stories.length;
+                const story = stories[current];
+                story.hidden = false;
+                story.classList.add(direction > 0 ? 'from-right' : 'from-left');
+                if (position) position.textContent = `${current + 1} / ${stories.length}`;
+            };
+
+            this.querySelector('[data-previous]')?.addEventListener('click', () => move(-1));
+            this.querySelector('[data-next]')?.addEventListener('click', () => move(1));
+        }
+    }
+
+    customElements.define('top-stories-slider', TopStoriesSlider);
+</script>
