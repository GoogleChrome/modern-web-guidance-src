+  <script>
+    const seasonalCards = Array.from(document.querySelectorAll('#seasonal-items .card'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    let seasonalIndex = 0;
+
+    function showSeasonalItem(direction) {
+      const outgoing = seasonalCards[seasonalIndex];
+      outgoing.hidden = true;
+      outgoing.classList.remove('enter-next', 'enter-previous');
+
+      seasonalIndex = (seasonalIndex + direction + seasonalCards.length) % seasonalCards.length;
+      const incoming = seasonalCards[seasonalIndex];
+      incoming.hidden = false;
+      // Reset the animation even when navigating quickly between items.
+      void incoming.offsetWidth;
+      incoming.classList.add(direction > 0 ? 'enter-next' : 'enter-previous');
+      seasonalStatus.textContent = `${seasonalIndex + 1} of ${seasonalCards.length}: ${incoming.querySelector('h3').textContent}`;
+    }
+
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalItem(1));
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalItem(-1));
+  </script>
