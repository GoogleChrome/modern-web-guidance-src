+  <script>
+    const favorites = Array.from(document.querySelectorAll('#favorites-items .card'));
+    const previousButton = document.querySelector('#favorites-previous');
+    const nextButton = document.querySelector('#favorites-next');
+    const position = document.querySelector('#favorites-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentFavorite = 0;
+    let activeTransition = null;
+
+    async function showFavorite(step) {
+      if (activeTransition) return;
+
+      const update = () => {
+        favorites[currentFavorite].hidden = true;
+        currentFavorite = (currentFavorite + step + favorites.length) % favorites.length;
+        favorites[currentFavorite].hidden = false;
+        position.textContent = `${currentFavorite + 1} of ${favorites.length}`;
+      };
+
+      // Older browsers and reduced-motion users get an immediate content change.
+      if (reducedMotion.matches || !document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))')) {
+        update();
+        return;
+      }
+
+      previousButton.setAttribute('aria-disabled', 'true');
+      nextButton.setAttribute('aria-disabled', 'true');
+      activeTransition = document.startViewTransition({
+        update,
+        types: [step > 0 ? 'forward' : 'backward']
+      });
+
+      try {
+        await activeTransition.finished;
+      } finally {
+        activeTransition = null;
+        previousButton.removeAttribute('aria-disabled');
+        nextButton.removeAttribute('aria-disabled');
+      }
+    }
+
+    previousButton.addEventListener('click', () => showFavorite(-1));
+    nextButton.addEventListener('click', () => showFavorite(1));
+    reducedMotion.addEventListener('change', (event) => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+  </script>
