+    /* Contact Form */
+    .contact {
+      max-width: 640px;
+    }
+
+    .contact h2,
+    .contact > p {
+      text-align: center;
+    }
+
+    .contact-form {
+      display: grid;
+      gap: 16px;
+      margin-top: 20px;
+    }
+
+    .contact-field {
+      padding: 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      color: inherit;
+      background: var(--light);
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+      min-height: 140px;
+    }
+
+    .contact-form :focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .contact-field:has(:user-invalid) {
+      border-color: #b42318;
+    }
+
+    .contact-error {
+      display: none;
+      margin-top: 6px;
+      color: #b42318;
+      font-size: 0.875rem;
+    }
+
+    .contact-field:has(:user-invalid) .contact-error {
+      display: block;
+    }
+
+    .contact-form .btn {
+      justify-self: start;
+      margin-top: 0;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
