--- a/index.html
+++ b/index.html
@@ -134,8 +134,131 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      display: inline-grid;
+      place-items: center;
+      width: 32px;
+      height: 32px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #tooltip {
+      position: fixed;
+      inset: 0;
+      margin: auto;
+      width: min(18rem, calc(100vw - 2rem));
+      height: fit-content;
+      padding: 0;
+      border: 0;
+      background: transparent;
+      color: white;
+      overflow: visible;
+    }
+
+    .tooltip-content {
+      position: relative;
+      margin-block: 0 12px;
+      padding: 12px 16px;
+      border-radius: 10px 10px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 12px rgb(0 0 0 / 18%);
+      font-size: 0.9rem;
+      text-align: left;
+    }
+
+    @supports (position-area: block-start) {
+      #anchor {
+        anchor-name: --latte-info;
+      }
+
+      #tooltip {
+        position-anchor: --latte-info;
+        inset: auto;
+        margin: 0;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+      }
+    }
+
+    @supports (position-area: block-start) and (container-type: anchored) {
+      #tooltip {
+        container-type: anchored;
+      }
+
+      .tooltip-content::before {
+        content: "";
+        position: absolute;
+        inset-block-start: 100%;
+        inset-inline-start: calc(50% - 8px);
+        width: 16px;
+        height: 8px;
+        background: var(--primary);
+        clip-path: polygon(0 0, 100% 0, 50% 100%);
+      }
+
+      /* Query the outer container; style its inner panel and arrow. */
+      @container anchored(fallback: flip-block) {
+        .tooltip-content {
+          margin-block: 12px 0;
+          border-radius: 4px 4px 10px 10px;
+        }
+
+        .tooltip-content::before {
+          inset-block-start: auto;
+          inset-block-end: 100%;
+          clip-path: polygon(50% 0, 100% 100%, 0 100%);
+        }
+      }
+    }
+
+    /* Keep the information available on focus in older browsers. */
+    @supports not selector(:popover-open) {
+      .card-actions {
+        position: relative;
+      }
+
+      #tooltip {
+        display: none;
+        position: absolute;
+        inset: auto auto 100% 50%;
+        margin: 0;
+        transform: translateX(-50%);
+        z-index: 1;
+      }
+
+      .card-actions:focus-within #tooltip {
+        display: block;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
