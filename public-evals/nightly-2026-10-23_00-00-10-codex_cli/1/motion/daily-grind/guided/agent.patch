+  <script>
+    // Observe once per element rather than doing work on every scroll frame.
+    if ('IntersectionObserver' in window && 'matchMedia' in window) {
+      const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+      const revealElements = document.querySelectorAll('[data-reveal]');
+      const revealed = new WeakSet();
+      let observer;
+
+      function reveal(element) {
+        element.classList.remove('is-reveal-pending');
+        element.classList.add('is-revealed');
+        revealed.add(element);
+        observer?.unobserve(element);
+      }
+
+      function syncMotion() {
+        observer?.disconnect();
+        if (!motionPreference.matches) {
+          revealElements.forEach((element) => {
+            element.classList.remove('is-reveal-pending', 'is-revealed');
+            revealed.add(element);
+          });
+          return;
+        }
+
+        observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) reveal(entry.target);
+          });
+        }, { threshold: 0.1 });
+
+        revealElements.forEach((element) => {
+          if (revealed.has(element)) return;
+          element.classList.add('is-reveal-pending');
+          observer.observe(element);
+        });
+      }
+
+      // Keyboard navigation must never land on content waiting to animate.
+      document.addEventListener('focusin', (event) => {
+        const element = event.target.closest('[data-reveal].is-reveal-pending');
+        if (element) reveal(element);
+      });
+      motionPreference.addEventListener('change', syncMotion);
+      syncMotion();
+    }
+  </script>
+
