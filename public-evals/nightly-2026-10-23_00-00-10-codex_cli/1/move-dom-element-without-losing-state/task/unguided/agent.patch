+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const home = document.getElementById('video-home');
+      const slot = document.getElementById('hero-video-slot');
+      const panel = document.getElementById('roasting-video');
+      const toggle = document.getElementById('theater-toggle');
+      let theater = false;
+      const canMove = typeof slot.moveBefore === 'function';
+
+      // Older browsers must never detach the iframe: ordinary DOM moves reload it.
+      // Position the existing panel over a reserved hero slot instead.
+      function positionFallback() {
+        if (!theater || canMove) return;
+        const bounds = slot.getBoundingClientRect();
+        panel.style.width = bounds.width + 'px';
+        panel.style.left = (bounds.left + window.scrollX) + 'px';
+        panel.style.top = (bounds.top + window.scrollY) + 'px';
+        const height = panel.getBoundingClientRect().height + 'px';
+        if (slot.style.height !== height) slot.style.height = height;
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        theater = !theater;
+        hero.classList.toggle('is-theater', theater);
+        home.classList.toggle('is-theater', theater);
+        slot.hidden = !theater;
+        toggle.setAttribute('aria-pressed', String(theater));
+        toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+
+        if (canMove) {
+          // Move the wrapper and its iframe atomically, preserving playback and focus.
+          (theater ? slot : home).moveBefore(panel, null);
+        }
+        if (!canMove) {
+          panel.classList.toggle('is-positioned', theater);
+          if (theater) {
+            positionFallback();
+          } else {
+            panel.style.removeProperty('width');
+            panel.style.removeProperty('left');
+            panel.style.removeProperty('top');
+            slot.style.removeProperty('height');
+          }
+        }
+        // Keep the control in view after either direction of movement.
+        panel.scrollIntoView({ block: 'nearest' });
+      });
+
+      window.addEventListener('resize', positionFallback);
+      window.addEventListener('load', positionFallback);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionFallback);
+        observer.observe(hero);
+        observer.observe(panel);
+      }
+    })();
+  </script>
