+  <script>
+    const hero = document.querySelector('.hero');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const player = document.getElementById('roasting-player');
+    const toggle = document.getElementById('theater-toggle');
+    const exitToggle = hero.querySelector('.theater-toggle');
+    const supportsMove = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionFallback() {
+      if (supportsMove || !theaterMode) return;
+
+      // Older browsers reload even the same iframe on insertBefore/appendChild.
+      // Keep it connected to its original parent and align it with the hero slot.
+      const destination = heroSlot.getBoundingClientRect();
+      const origin = mainSlot.getBoundingClientRect();
+      player.style.top = `${destination.top - origin.top}px`;
+      player.style.left = `${destination.left - origin.left}px`;
+      player.style.width = `${destination.width}px`;
+      player.style.height = `${destination.height}px`;
+    }
+
+    function toggleTheater() {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+      heroSlot.hidden = !theaterMode;
+      exitToggle.hidden = !theaterMode;
+      mainSlot.classList.toggle('is-empty', theaterMode);
+
+      if (supportsMove) {
+        const destination = theaterMode ? heroSlot : mainSlot;
+        // An atomic move preserves the iframe's browsing context and playback.
+        destination.moveBefore(player, null);
+      } else if (theaterMode) {
+        positionFallback();
+      } else {
+        player.style.removeProperty('top');
+        player.style.removeProperty('left');
+        player.style.removeProperty('width');
+        player.style.removeProperty('height');
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      exitToggle.setAttribute('aria-pressed', String(theaterMode));
+      toggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+      const activeToggle = theaterMode ? exitToggle : toggle;
+      activeToggle.focus({ preventScroll: true });
+      (theaterMode ? heroSlot : mainSlot).scrollIntoView({ block: 'center' });
+    }
+
+    toggle.addEventListener('click', toggleTheater);
+    exitToggle.addEventListener('click', toggleTheater);
+    toggle.hidden = false;
+
+    if (!supportsMove) {
+      window.addEventListener('resize', positionFallback);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionFallback);
+        observer.observe(heroSlot);
+        observer.observe(mainSlot);
+        observer.observe(hero);
+      }
+    }
+  </script>
