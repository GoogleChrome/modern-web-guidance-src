+  <script type="module">
+    const storageKey = 'daily-grind-coffee-preferences';
+    const form = document.querySelector('#coffee-preferences-form');
+    const pickupTime = document.querySelector('#pickup-reminder-time');
+    const anniversaryDate = document.querySelector('#coffee-anniversary-date');
+    const status = document.querySelector('#preferences-status');
+
+    let plainTypes = globalThis.Temporal;
+    if (!plainTypes?.PlainTime || !plainTypes?.PlainDate) {
+      // Progressive enhancement for browsers without native Temporal.
+      import('https://esm.sh/temporal-polyfill@0.3.0')
+        .then((module) => { plainTypes = module.Temporal; })
+        .catch(() => {
+          // Native controls also validate plain strings, so saving works offline.
+        });
+    }
+
+    function readPreferences() {
+      // These are a wall-clock time and a calendar date, never UTC instants.
+      // Persist only HH:mm and YYYY-MM-DD; never convert through Date or a zone.
+      return {
+        pickupReminderTime: pickupTime.value && plainTypes?.PlainTime
+          ? plainTypes.PlainTime.from(pickupTime.value).toString({ smallestUnit: 'minute' })
+          : pickupTime.value,
+        coffeeAnniversaryDate: anniversaryDate.value && plainTypes?.PlainDate
+          ? plainTypes.PlainDate.from(anniversaryDate.value).toString()
+          : anniversaryDate.value,
+      };
+    }
+
+    function describePreferences(preferences) {
+      return `Daily pickup reminder: ${preferences.pickupReminderTime || 'not set'}. Coffee anniversary: ${preferences.coffeeAnniversaryDate || 'not set'}.`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        for (const [input, value] of [
+          [pickupTime, saved.pickupReminderTime],
+          [anniversaryDate, saved.coffeeAnniversaryDate],
+        ]) {
+          // Assigning through native inputs rejects malformed stored values.
+          input.value = typeof value === 'string' ? value : '';
+          if (!input.checkValidity()) input.value = '';
+        }
+        status.textContent = describePreferences(readPreferences());
+      }
+    } catch {
+      status.textContent = 'Saved preferences could not be loaded. You can still choose new values.';
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const preferences = readPreferences();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        status.textContent = `Saved. ${describePreferences(preferences)}`;
+      } catch {
+        status.textContent = 'Your selections are shown, but this browser could not save them. Please allow browser storage and try again.';
+      }
+    });
+  </script>
