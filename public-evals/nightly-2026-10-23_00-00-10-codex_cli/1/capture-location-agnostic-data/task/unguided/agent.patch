+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const pickupTime = document.getElementById('pickup-time');
+    const coffeeAnniversary = document.getElementById('coffee-anniversary');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    // Keep wall-clock time and calendar date as literal input strings.
+    // Never convert them to Date objects, UTC, or timezone-dependent timestamps.
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.pickupTime === 'string' && /^(?:[01]\d|2[0-3]):[0-5]\d$/.test(saved.pickupTime)) {
+          pickupTime.value = saved.pickupTime;
+        }
+        if (typeof saved.coffeeAnniversary === 'string' && /^\d{4,}-\d{2}-\d{2}$/.test(saved.coffeeAnniversary)) {
+          // The native date input also rejects invalid calendar dates.
+          coffeeAnniversary.value = saved.coffeeAnniversary;
+        }
+      }
+    } catch {
+      preferencesStatus.textContent = 'Saved preferences could not be loaded. You can select them again below.';
+    }
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          pickupTime: pickupTime.value,
+          coffeeAnniversary: coffeeAnniversary.value
+        }));
+        preferencesStatus.textContent = 'Preferences saved. Your time and date stay exactly as selected, wherever you travel.';
+      } catch {
+        preferencesStatus.textContent = 'Your browser could not save these preferences. Please enable browser storage and try again.';
+      }
+    });
+  </script>
