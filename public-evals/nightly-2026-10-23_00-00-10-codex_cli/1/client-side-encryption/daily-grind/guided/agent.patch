+++ b/tests/encryption.test.mjs
@@ -0,0 +1,57 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, encryptNote, decryptNote, destroyRecipient } from '../src/encryption.mjs';
+
+for (const mode of ['hybrid', 'pq', 'classical']) {
+  test(`${mode}: public-key encryption round trip, fresh randomness, and authenticated metadata`, async () => {
+    const recipient = await createRecipient(mode);
+    const sender = { suite: recipient.suite, keyId: recipient.keyId, publicKey: recipient.publicKey };
+    const message = 'Side entrance, gate 1234. ☕ 静かにお願いします';
+    const a = await encryptNote(sender, message);
+    const b = await encryptNote(sender, message);
+    assert.equal(await decryptNote(recipient, a), message);
+    assert.equal(await decryptNote(recipient, b), message);
+    for (const field of ['iv', 'salt', 'capsule', 'ciphertext', 'id']) assert.notEqual(a[field], b[field]);
+    assert.ok(!JSON.stringify(a).includes('1234'));
+    assert.equal(Buffer.from(a.iv, 'base64').length, 12);
+    for (const field of ['iv', 'salt', 'capsule', 'ciphertext', 'id', 'keyId']) {
+      const bytes = Buffer.from(a[field], 'base64');
+      bytes[0] ^= 1;
+      await assert.rejects(decryptNote(recipient, { ...a, [field]: bytes.toString('base64') }), `${field} tampering must fail`);
+    }
+    await assert.rejects(decryptNote(recipient, { ...a, version: 2 }));
+    await assert.rejects(decryptNote(recipient, { ...a, suite: 'unknown' }));
+    await assert.rejects(decryptNote(recipient, { ...a, cipher: 'AES-CBC' }));
+    const other = await createRecipient(mode);
+    await assert.rejects(decryptNote(other, a));
+    // Even falsely matching the key identifier cannot bypass AEAD validation.
+    await assert.rejects(decryptNote({ ...other, keyId: recipient.keyId }, a));
+    await assert.rejects(encryptNote(sender, '   '));
+    await assert.rejects(encryptNote(sender, 'x'.repeat(1001)));
+    destroyRecipient(recipient);
+    destroyRecipient(other);
+    if (recipient.privateKey instanceof Uint8Array) assert.ok(recipient.privateKey.every(b => b === 0));
+  });
+}
+
+test('older browsers use native P-256 when X25519 is unsupported', async () => {
+  const original = globalThis.crypto;
+  const subtle = new Proxy(original.subtle, {
+    get(target, property) {
+      if (property === 'generateKey') return (algorithm, ...rest) => {
+        if (algorithm.name === 'X25519') throw new DOMException('Unsupported', 'NotSupportedError');
+        return target.generateKey(algorithm, ...rest);
+      };
+      const value = Reflect.get(target, property);
+      return typeof value === 'function' ? value.bind(target) : value;
+    }
+  });
+  Object.defineProperty(globalThis, 'crypto', { configurable: true, value: { subtle, getRandomValues: original.getRandomValues.bind(original) } });
+  try {
+    const recipient = await createRecipient('classical');
+    assert.equal(recipient.suite, 'ECDH-P256');
+    assert.equal(recipient.privateKey.extractable, false);
+    const envelope = await encryptNote(recipient, 'Leave by the green door.');
+    assert.equal(await decryptNote(recipient, envelope), 'Leave by the green door.');
+  } finally { Object.defineProperty(globalThis, 'crypto', { configurable: true, value: original }); }
+});
