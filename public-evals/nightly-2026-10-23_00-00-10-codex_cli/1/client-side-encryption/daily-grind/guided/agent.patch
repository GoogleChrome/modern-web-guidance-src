+window.addEventListener('pagehide', lockNote);
+if (globalThis.isSecureContext && globalThis.crypto?.subtle) {
+  save.disabled = false;
+  status('Ready when you are. Your note stays in this tab.');
+} else {
+  status('Secure notes require HTTPS or localhost and a browser with Web Crypto support.', true);
+}
