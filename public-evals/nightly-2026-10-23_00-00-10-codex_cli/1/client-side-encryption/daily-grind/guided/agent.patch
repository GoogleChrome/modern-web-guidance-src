+  $('note-status').classList.toggle('error', error);
+}
+function lockNote() {
+  clearTimeout(lockTimer);
+  $('decrypted-note').textContent = '';
+  $('decrypted-note').hidden = true;
+  $('unlock-note').textContent = 'Unlock note';
+}
+function setBusy(value) {
+  busy = value;
+  for (const element of [save, protection, input, $('unlock-note'), $('delete-note'), $('download-note')]) element.disabled = value;
+  form.setAttribute('aria-busy', String(value));
+}
+input.addEventListener('input', () => {
+  input.setCustomValidity('');
+  $('note-count').textContent = `${input.value.length.toLocaleString()} / 1,000`;
+});
+protection.addEventListener('change', () => {
+  $('protection-help').textContent = descriptions[protection.value];
+  document.querySelector('.recommended').hidden = protection.value !== 'hybrid';
+});
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (!input.value.trim()) {
+    input.setCustomValidity('Please enter a delivery note.');
+    input.reportValidity();
+    return;
+  }
+  setBusy(true);
+  status('Encrypting your note…');
+  let recipient;
+  try {
+    recipient = await createRecipient(protection.value);
+    const { suite, keyId, publicKey } = recipient;
+    const envelope = await encryptNote({ suite, keyId, publicKey }, input.value);
+    lockNote();
+    destroyRecipient(record?.recipient);
+    record = { recipient, envelope };
+    input.value = '';
+    $('note-count').textContent = '0 / 1,000';
+    $('saved-note').hidden = false;
+    $('saved-time').textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+    const labels = { hybrid: 'ML-KEM-768 + X25519', pq: 'ML-KEM-768', X25519: 'X25519', 'ECDH-P256': 'P-256' };
+    $('saved-summary').textContent = `${labels[suite]} · AES-256-GCM · Stored in this tab only`;
+    status('Your note is encrypted and saved in this tab.');
+    save.lastChild.textContent = ' Replace encrypted note';
+  } catch {
+    destroyRecipient(recipient);
+    status('Your note could not be encrypted. Please try again in a supported browser over HTTPS.', true);
+  } finally { setBusy(false); }
+});
+$('unlock-note').addEventListener('click', async () => {
+  if (!record || busy) return;
+  if (!$('decrypted-note').hidden) { lockNote(); return; }
+  setBusy(true);
+  try {
+    $('decrypted-note').textContent = await decryptNote(record.recipient, record.envelope);
+    $('decrypted-note').hidden = false;
+    $('unlock-note').textContent = 'Lock note';
+    status('Note unlocked. It will lock again in 30 seconds.');
+    lockTimer = setTimeout(lockNote, 30_000);
+  } catch { lockNote(); status('Authentication failed. This note could not be unlocked safely.', true); }
+  finally { setBusy(false); }
+});
+$('delete-note').addEventListener('click', () => {
+  lockNote();
+  destroyRecipient(record?.recipient);
+  record = null;
+  $('saved-note').hidden = true;
+  save.lastChild.textContent = ' Encrypt & save note';
+  status('Your encrypted note and its recipient key have been deleted.');
+  input.focus();
+});
+$('download-note').addEventListener('click', () => {
+  if (!record) return;
+  const url = URL.createObjectURL(new Blob([JSON.stringify(record.envelope, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'daily-grind-encrypted-note.json';
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
