index 0000000..0f84627
--- /dev/null
+++ b/src/encryption.mjs
@@ -0,0 +1,89 @@
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+
+const kemAlgorithms = { hybrid: ml_kem768_x25519, pq: ml_kem768 };
+const encoder = new TextEncoder();
+const b64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+const unb64 = text => Uint8Array.from(atob(text), c => c.charCodeAt(0));
+const random = length => crypto.getRandomValues(new Uint8Array(length));
+const curveParams = suite => suite === 'X25519' ? { name: suite } : { name: 'ECDH', namedCurve: 'P-256' };
+
+export async function createRecipient(mode) {
+  if (!crypto?.subtle) throw new Error('Secure browser encryption requires HTTPS or localhost.');
+  let keys, suite, publicBytes;
+  if (kemAlgorithms[mode]) {
+    suite = mode;
+    keys = kemAlgorithms[mode].keygen();
+    publicBytes = keys.publicKey;
+  } else if (mode === 'classical') {
+    suite = 'X25519';
+    try { keys = await crypto.subtle.generateKey(curveParams(suite), false, ['deriveBits']); }
+    catch (error) {
+      if (error.name !== 'NotSupportedError') throw error;
+      suite = 'ECDH-P256';
+      keys = await crypto.subtle.generateKey(curveParams(suite), false, ['deriveBits']);
+    }
+    publicBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keys.publicKey));
+  } else { throw new Error('Unknown protection level.'); }
+  const keyId = b64(await crypto.subtle.digest('SHA-256', publicBytes));
+  return { suite, keyId, publicKey: keys.publicKey, privateKey: keys.secretKey ?? keys.privateKey };
+}
+
+async function agreement(suite, privateKey, publicKey) {
+  return new Uint8Array(await crypto.subtle.deriveBits({ name: curveParams(suite).name, public: publicKey }, privateKey, 256));
+}
+
+function metadata(envelope) {
+  const { version, id, keyId, suite, cipher, capsule, salt, iv } = envelope;
+  return encoder.encode(JSON.stringify({ version, id, keyId, suite, cipher, capsule, salt, iv }));
+}
+
+async function deriveKey(secret, envelope) {
+  try {
+    const base = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+    return await crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt: unb64(envelope.salt), info: encoder.encode('daily-grind/delivery-notes/v1') }, base, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+  } finally { secret.fill(0); }
+}
+
+// Only the recipient's public key is needed by the sender.
+export async function encryptNote(recipientPublic, plaintext) {
+  if (!plaintext.trim() || plaintext.length > 1000) throw new Error('Enter a note between 1 and 1,000 characters.');
+  const { suite, keyId, publicKey } = recipientPublic;
+  let secret, capsule;
+  if (kemAlgorithms[suite]) {
+    const encapsulated = kemAlgorithms[suite].encapsulate(publicKey);
+    secret = encapsulated.sharedSecret;
+    capsule = encapsulated.cipherText;
+  } else {
+    const ephemeral = await crypto.subtle.generateKey(curveParams(suite), false, ['deriveBits']);
+    capsule = await crypto.subtle.exportKey('raw', ephemeral.publicKey);
+    secret = await agreement(suite, ephemeral.privateKey, publicKey);
+  }
+  const envelope = { version: 1, id: b64(random(16)), keyId, suite, cipher: 'AES-256-GCM', capsule: b64(capsule), salt: b64(random(32)), iv: b64(random(12)) };
+  const key = await deriveKey(secret, envelope);
+  const bytes = encoder.encode(plaintext);
+  try {
+    envelope.ciphertext = b64(await crypto.subtle.encrypt({ name: 'AES-GCM', iv: unb64(envelope.iv), additionalData: metadata(envelope), tagLength: 128 }, key, bytes));
+    return envelope;
+  } finally { bytes.fill(0); }
+}
+
+export async function decryptNote(recipient, envelope) {
+  if (envelope.version !== 1 || envelope.cipher !== 'AES-256-GCM' || envelope.suite !== recipient.suite || envelope.keyId !== recipient.keyId) throw new Error('The note does not match this recipient or protocol.');
+  const iv = unb64(envelope.iv);
+  if (iv.length !== 12 || unb64(envelope.salt).length !== 32) throw new Error('Invalid encrypted note.');
+  let secret;
+  if (kemAlgorithms[envelope.suite]) {
+    secret = kemAlgorithms[envelope.suite].decapsulate(unb64(envelope.capsule), recipient.privateKey);
+  } else {
+    const peer = await crypto.subtle.importKey('raw', unb64(envelope.capsule), curveParams(envelope.suite), false, []);
+    secret = await agreement(envelope.suite, recipient.privateKey, peer);
+  }
+  const key = await deriveKey(secret, envelope);
+  const decrypted = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv, additionalData: metadata(envelope), tagLength: 128 }, key, unb64(envelope.ciphertext)));
+  try { return new TextDecoder().decode(decrypted); } finally { decrypted.fill(0); }
+}
+
+export function destroyRecipient(recipient) {
+  recipient?.privateKey?.fill?.(0);
+}
