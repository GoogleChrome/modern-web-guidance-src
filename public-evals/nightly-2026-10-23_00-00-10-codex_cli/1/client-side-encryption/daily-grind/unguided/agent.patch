+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+
+const encoder = new TextEncoder();
+export const protectionLabels = Object.freeze({
+  classical: 'X25519', hybrid: 'X25519 + ML-KEM-768', quantum: 'ML-KEM-768',
+});
+function validateMode(mode) {
+  if (!Object.hasOwn(protectionLabels, mode)) throw new Error('Unsupported protection mode.');
+}
+function concat(...arrays) {
+  const output = new Uint8Array(arrays.reduce((sum, value) => sum + value.length, 0));
+  let offset = 0;
+  for (const value of arrays) { output.set(value, offset); offset += value.length; }
+  return output;
+}
+// No keys or plaintext are written to storage or sent over the network.
+// Production must supply authenticated recipient public keys from a delivery service.
+export function createRecipient() {
+  if (!globalThis.crypto?.subtle) throw new Error('A secure browser context is required.');
+  return { id: crypto.randomUUID(), classical: x25519.keygen(), quantum: ml_kem768.keygen() };
+}
+export function publicRecipient(recipient) {
+  return { id: recipient.id, classical: recipient.classical.publicKey, quantum: recipient.quantum.publicKey };
+}
+function authenticatedHeader(packet) {
+  return encoder.encode(JSON.stringify({
+    version: packet.version, mode: packet.mode, recipientId: packet.recipientId,
+    id: packet.id, createdAt: packet.createdAt,
+    ephemeralKey: packet.ephemeralKey ? Array.from(packet.ephemeralKey) : null,
+    encapsulation: packet.encapsulation ? Array.from(packet.encapsulation) : null,
+  }));
+}
+async function deriveKey(secret, salt, header, usage) {
+  const material = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt,
+    info: concat(encoder.encode('daily-grind/delivery-note/v1/'), new Uint8Array(await crypto.subtle.digest('SHA-256', header))) },
+    material, { name: 'AES-GCM', length: 256 }, false, [usage]);
+}
+export async function encryptNote(note, mode, recipient) {
+  validateMode(mode);
+  if (typeof note !== 'string' || !note.trim() || note.length > 500) throw new Error('Enter a note of 1–500 characters.');
+  const packet = { version: 1, mode, recipientId: recipient.id, id: crypto.randomUUID(),
+    createdAt: new Date().toISOString(), salt: crypto.getRandomValues(new Uint8Array(32)),
+    iv: crypto.getRandomValues(new Uint8Array(12)), ephemeralKey: null, encapsulation: null };
+  const secrets = [];
+  let combined;
+  try {
+    if (mode !== 'quantum') {
+      const ephemeral = x25519.keygen();
+      try {
+        packet.ephemeralKey = ephemeral.publicKey;
+        secrets.push(x25519.getSharedSecret(ephemeral.secretKey, recipient.classical));
+      } finally { ephemeral.secretKey.fill(0); }
+    }
+    if (mode !== 'classical') {
+      const result = ml_kem768.encapsulate(recipient.quantum);
+      packet.encapsulation = result.cipherText;
+      secrets.push(result.sharedSecret);
+    }
+    combined = concat(...secrets);
+    const header = authenticatedHeader(packet);
+    const key = await deriveKey(combined, packet.salt, header, 'encrypt');
+    const plaintext = encoder.encode(note);
+    try {
+      packet.ciphertext = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM',
+        iv: packet.iv, additionalData: header, tagLength: 128 }, key, plaintext));
+    } finally { plaintext.fill(0); }
+    return packet;
+  } finally { for (const secret of secrets) secret.fill(0); combined?.fill(0); }
+}
+export async function decryptNote(packet, recipient) {
+  validateMode(packet.mode);
+  if (packet.version !== 1 || packet.recipientId !== recipient.id) throw new Error('Invalid note recipient or version.');
+  const secrets = [];
+  let combined;
+  try {
+    if (packet.mode !== 'quantum') secrets.push(x25519.getSharedSecret(recipient.classical.secretKey, packet.ephemeralKey));
+    if (packet.mode !== 'classical') secrets.push(ml_kem768.decapsulate(packet.encapsulation, recipient.quantum.secretKey));
+    combined = concat(...secrets);
+    const header = authenticatedHeader(packet);
+    const key = await deriveKey(combined, packet.salt, header, 'decrypt');
+    const plaintext = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: packet.iv,
+      additionalData: header, tagLength: 128 }, key, packet.ciphertext));
+    try { return new TextDecoder('utf-8', { fatal: true }).decode(plaintext); }
+    finally { plaintext.fill(0); }
+  } finally { for (const secret of secrets) secret.fill(0); combined?.fill(0); }
+}
+export function destroyRecipient(recipient) {
+  recipient?.classical.secretKey.fill(0);
+  recipient?.quantum.secretKey.fill(0);
+}
diff --git a/crypto.test.js b/crypto.test.js
