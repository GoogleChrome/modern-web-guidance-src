@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, publicRecipient, encryptNote, decryptNote, destroyRecipient } from './crypto.js';
+
+for (const mode of ['classical', 'hybrid', 'quantum']) {
+  test(`${mode}: public-key encryption round-trip and fresh randomness`, async () => {
+    const recipient = createRecipient();
+    const publicKeys = publicRecipient(recipient);
+    assert.equal(publicKeys.classical.secretKey, undefined);
+    const text = 'Gate code: 1234. Quiet knock ☕ <script>alert(1)</script>';
+    const first = await encryptNote(text, mode, publicKeys);
+    const second = await encryptNote(text, mode, publicKeys);
+    assert.equal(await decryptNote(first, recipient), text);
+    assert.equal(await decryptNote(second, recipient), text);
+    assert.notDeepEqual(first.iv, second.iv);
+    assert.notDeepEqual(first.salt, second.salt);
+    assert.notDeepEqual(first.ciphertext, second.ciphertext);
+    assert.equal(first.ciphertext.length, new TextEncoder().encode(text).length + 16);
+    destroyRecipient(recipient);
+    assert.ok(recipient.classical.secretKey.every(byte => byte === 0));
+    assert.ok(recipient.quantum.secretKey.every(byte => byte === 0));
+  });
+  test(`${mode}: rejects tampering and incorrect recipient keys`, async () => {
+    const recipient = createRecipient();
+    const packet = await encryptNote('A private delivery detail', mode, publicRecipient(recipient));
+    for (const field of ['ciphertext', 'iv', 'salt', ...(mode !== 'quantum' ? ['ephemeralKey'] : []), ...(mode !== 'classical' ? ['encapsulation'] : [])]) {
+      const altered = structuredClone(packet);
+      altered[field][0] ^= 1;
+      await assert.rejects(() => decryptNote(altered, recipient));
+    }
+    for (const field of ['createdAt', 'id']) {
+      await assert.rejects(() => decryptNote({ ...packet, [field]: 'modified' }, recipient));
+    }
+    const wrongRecipient = createRecipient();
+    wrongRecipient.id = recipient.id;
+    await assert.rejects(() => decryptNote(packet, wrongRecipient));
+    await assert.rejects(() => decryptNote({ ...packet, mode: mode === 'hybrid' ? 'classical' : 'hybrid' }, recipient));
+    await assert.rejects(() => decryptNote({ ...packet, version: 2 }, recipient));
+    destroyRecipient(recipient);
+    destroyRecipient(wrongRecipient);
+  });
+}
+test('rejects invalid notes and unsupported modes', async () => {
+  const recipient = createRecipient();
+  for (const text of ['', '   ', 'a'.repeat(501), null]) await assert.rejects(() => encryptNote(text, 'hybrid', publicRecipient(recipient)));
+  for (const mode of ['invalid', '__proto__']) await assert.rejects(() => encryptNote('valid note', mode, publicRecipient(recipient)));
+  destroyRecipient(recipient);
+});
