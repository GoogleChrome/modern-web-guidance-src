@@ -0,0 +1,124 @@
+import { createRecipient, publicRecipient, encryptNote, decryptNote, destroyRecipient, protectionLabels } from './crypto.js';
+
+const paths = {
+  'coffee': '<path d="M4 8h13v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z"/><path d="M17 9h1a3 3 0 1 1 0 6h-1M7 3v2m4-3v3m4-2v2M2 23h18"/>',
+  'arrow-right': '<path d="M4 12h16m-6-6 6 6-6 6"/>',
+  'arrow-up-right': '<path d="M6 18 18 6M6 6h12v12"/>',
+  'shield-check': '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-6"/>',
+  'key': '<circle cx="8" cy="8" r="5"/><path d="m12 12 9 9m-3-3 3-3m-6 0 3-3"/>',
+  'lock': '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/>',
+  'eye-off': '<path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9 5.5a11 11 0 0 1 3-.5c7 0 10 7 10 7a18 18 0 0 1-3 4M6 6C3 8 2 12 2 12s3 7 10 7a12 12 0 0 0 5-1"/>',
+  'user': '<circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',
+  'leaf': '<path d="M20 3C8 1 2 9 6 16s16 2 14-13Z"/><path d="M3 21 15 9"/>',
+  'heart': '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>',
+  'sparkles': '<path d="m12 3 2.6 6.4L21 12l-6.4 2.6L12 21l-2.6-6.4L3 12l6.4-2.6ZM20 2v4m-2-2h4"/>',
+  'notebook': '<rect x="5" y="3" width="15" height="18" rx="2"/><path d="M9 3v18M3 7h4m-4 5h4m-4 5h4m6-10h4m-4 4h4"/>',
+  'info': '<circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/>',
+  'laptop': '<rect x="4" y="4" width="16" height="12" rx="1"/><path d="m4 16-2 4h20l-2-4M10 20h4"/>',
+  'trash': '<path d="M3 6h18M9 6V3h6v3m-10 0 1 15h12l1-15M10 10v7m4-7v7"/>',
+  'check': '<path d="m5 12 4 4L19 6"/>',
+};
+for (const icon of document.querySelectorAll('[data-icon]')) {
+  icon.outerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${paths[icon.dataset.icon] || ''}</svg>`;
+}
+const form = document.querySelector('#note-form');
+const input = document.querySelector('#delivery-note');
+const count = document.querySelector('#character-count');
+const status = document.querySelector('#form-status');
+const saveButton = document.querySelector('#save-button');
+const savedCard = document.querySelector('#saved-note');
+const revealed = document.querySelector('#revealed-note');
+const revealButton = document.querySelector('#reveal-note');
+const dialog = document.querySelector('#privacy-dialog');
+let recipient;
+let savedPacket;
+let busy = false;
+const setStatus = (message, error = false) => {
+  status.textContent = message;
+  status.classList.toggle('error', error);
+};
+input.addEventListener('input', () => { count.textContent = `${input.value.length} / 500`; setStatus(''); });
+for (const option of document.querySelectorAll('input[name="protection"]')) {
+  option.addEventListener('change', () => {
+    for (const label of document.querySelectorAll('.protection-option')) label.classList.toggle('selected', label.querySelector('input').checked);
+  });
+}
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  const note = input.value;
+  if (!note.trim()) { setStatus('Add a delivery detail before saving your note.', true); input.focus(); return; }
+  busy = true;
+  saveButton.disabled = true;
+  input.disabled = true;
+  document.querySelector('#delete-note').disabled = true;
+  revealButton.disabled = true;
+  setStatus('Giving your details a little extra protection…');
+  try {
+    // Yield for the status update before public-key operations.
+    await new Promise(resolve => requestAnimationFrame(resolve));
+    recipient ??= createRecipient();
+    const mode = new FormData(form).get('protection');
+    const packet = await encryptNote(note, mode, publicRecipient(recipient));
+    savedPacket?.ciphertext.fill(0);
+    savedPacket = packet;
+    revealed.textContent = '';
+    revealed.hidden = true;
+    revealButton.textContent = 'View note';
+    document.querySelector('#saved-meta').textContent = `${protectionLabels[mode]} · AES-256-GCM · Saved in this tab`;
+    savedCard.hidden = false;
+    input.value = '';
+    count.textContent = '0 / 500';
+    setStatus('Your note is encrypted and saved in this tab.');
+  } catch (error) {
+    setStatus(globalThis.crypto?.subtle ? 'We couldn’t encrypt your note. Nothing new was saved. Please try again.' : 'Encryption needs HTTPS or localhost and a browser with Web Crypto support.', true);
+  } finally {
+    busy = false;
+    saveButton.disabled = false;
+    input.disabled = false;
+    document.querySelector('#delete-note').disabled = false;
+    revealButton.disabled = false;
+  }
+});
+revealButton.addEventListener('click', async () => {
+  if (!savedPacket || busy) return;
+  if (!revealed.hidden) {
+    revealed.textContent = '';
+    revealed.hidden = true;
+    revealButton.textContent = 'View note';
+    return;
+  }
+  busy = true;
+  revealButton.disabled = true;
+  saveButton.disabled = true;
+  document.querySelector('#delete-note').disabled = true;
+  try {
+    const note = await decryptNote(savedPacket, recipient);
+    revealed.textContent = note;
+    revealed.hidden = false;
+    revealButton.textContent = 'Hide note';
+  } catch {
+    setStatus('This note couldn’t be authenticated. Its contents have not been displayed.', true);
+  } finally {
+    busy = false;
+    revealButton.disabled = false;
+    saveButton.disabled = false;
+    document.querySelector('#delete-note').disabled = false;
+  }
+});
+document.querySelector('#delete-note').addEventListener('click', () => {
+  if (busy) return;
+  savedPacket?.ciphertext.fill(0);
+  savedPacket = undefined;
+  destroyRecipient(recipient);
+  recipient = undefined;
+  revealed.textContent = '';
+  revealed.hidden = true;
+  savedCard.hidden = true;
+  setStatus('Your encrypted note and its recipient keys have been cleared.');
+});
+for (const id of ['learn-more', 'protection-info']) document.getElementById(id).addEventListener('click', () => dialog.showModal());
+for (const button of dialog.querySelectorAll('button')) button.addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if (event.target === dialog) { const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); } });
+// Hide a revealed note when the tab is backgrounded.
+document.addEventListener('visibilitychange', () => { if (document.hidden) { revealed.textContent = ''; revealed.hidden = true; revealButton.textContent = 'View note'; } });
