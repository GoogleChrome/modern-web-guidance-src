+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const links = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.hash));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function markCurrent(currentLink) {
+      links.forEach(link => {
+        const isCurrent = link === currentLink;
+        link.classList.toggle('is-current', !nativeTracking && isCurrent);
+        if (isCurrent) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncCurrent() {
+      if (nativeTracking) {
+        markCurrent(navigation.querySelector('a:target-current'));
+        return;
+      }
+
+      // Choose the section occupying the most space below the sticky navigation.
+      const top = navigation.getBoundingClientRect().bottom;
+      let currentIndex = -1;
+      let largestVisibleArea = 0;
+      sections.forEach((section, index) => {
+        const rect = section.getBoundingClientRect();
+        const visibleArea = Math.max(0,
+          Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, top));
+        if (visibleArea > largestVisibleArea) {
+          largestVisibleArea = visibleArea;
+          currentIndex = index;
+        }
+      });
+      markCurrent(links[currentIndex]);
+    }
+
+    let pendingFrame = false;
+    function scheduleSync() {
+      if (pendingFrame) return;
+      pendingFrame = true;
+      requestAnimationFrame(() => {
+        pendingFrame = false;
+        syncCurrent();
+      });
+    }
+
+    // Keep anchor targets below the navigation even when its height changes.
+    const resizeObserver = new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height',
+        `${navigation.getBoundingClientRect().height + 16}px`);
+      scheduleSync();
+    });
+    resizeObserver.observe(navigation);
+
+    if (!nativeTracking) {
+      const observer = new IntersectionObserver(scheduleSync, {
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    document.addEventListener('scroll', scheduleSync, { passive: true });
+    document.addEventListener('scrollend', scheduleSync);
+    window.addEventListener('resize', scheduleSync);
+    window.addEventListener('pageshow', scheduleSync);
+    scheduleSync();
+  </script>
