new file mode 100644
index 0000000..c40a1f7
--- /dev/null
+++ b/src/components/SectionNav.tsx
@@ -0,0 +1,78 @@
+import { useEffect, useState } from 'react';
+
+const sections = [
+    { id: 'overview', label: 'Top Stories' },
+    { id: 'top-news', label: 'Top News' },
+    { id: 'world', label: 'World' },
+    { id: 'politics', label: 'Politics' },
+];
+
+export default function SectionNav() {
+    const [activeSection, setActiveSection] = useState('overview');
+
+    useEffect(() => {
+        const nav = document.getElementById('section-navigation');
+        const targets = sections.map(({ id }) => document.getElementById(id));
+        let frame = 0;
+
+        const update = () => {
+            frame = 0;
+            const readingLine = (nav?.getBoundingClientRect().bottom ?? 0) + 24;
+            let current = sections[0].id;
+
+            targets.forEach((target, index) => {
+                if (target && target.getBoundingClientRect().top <= readingLine) {
+                    current = sections[index].id;
+                }
+            });
+
+            setActiveSection(current);
+        };
+
+        const scheduleUpdate = () => {
+            if (!frame) frame = requestAnimationFrame(update);
+        };
+
+        // Also track layout shifts from images, ads, and responsive content.
+        const observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        update();
+
+        return () => {
+            cancelAnimationFrame(frame);
+            observer.disconnect();
+            window.removeEventListener('scroll', scheduleUpdate);
+            window.removeEventListener('resize', scheduleUpdate);
+        };
+    }, []);
+
+    return (
+        <nav
+            id="section-navigation"
+            aria-label="On this page"
+            className="sticky top-0 z-20 border-b border-gray-300 bg-white/95 backdrop-blur-sm"
+        >
+            <div className="flex items-center gap-6 overflow-x-auto px-4 sm:px-6">
+                <span className="shrink-0 text-xs font-semibold uppercase tracking-wide text-gray-500 hidden sm:block">
+                    On this page
+                </span>
+                {sections.map(({ id, label }) => (
+                    <a
+                        key={id}
+                        href={`#${id}`}
+                        aria-current={activeSection === id ? 'location' : undefined}
+                        className={`shrink-0 border-b-2 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 ${
+                            activeSection === id
+                                ? 'border-amber-500 text-amber-800'
+                                : 'border-transparent text-gray-600 hover:border-gray-400 hover:text-gray-900'
+                        }`}
+                    >
+                        {label}
+                    </a>
+                ))}
+            </div>
+        </nav>
+    );
+}
