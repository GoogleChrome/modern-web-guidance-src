diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..e74b000
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,93 @@
+---
+const sections = [
+  { id: 'lead-story', label: 'Lead Story' },
+  { id: 'top-news', label: 'Top News' },
+  { id: 'world', label: 'World' },
+  { id: 'politics', label: 'Politics' },
+];
+---
+
+<nav aria-label="On this page" data-section-nav class="section-nav sticky top-0 z-20 border-b border-gray-300 bg-white">
+  <div class="mx-auto flex max-w-6xl items-center gap-5 overflow-x-auto px-4 sm:px-6">
+    <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-gray-500 hidden sm:block">On this page</span>
+    <div class="section-links flex gap-5">
+      {sections.map(({ id, label }) => (
+        <a href={`#${id}`} class="section-link whitespace-nowrap border-b-3 border-transparent py-3 text-sm font-semibold text-gray-600 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-amber-700">
+          {label}
+        </a>
+      ))}
+    </div>
+  </div>
+</nav>
+
+<style>
+  .section-links {
+    scroll-target-group: auto;
+  }
+
+  .section-link:is(:target-current, [aria-current='location']) {
+    color: #92400e;
+    border-bottom-color: #b45309;
+  }
+</style>
+
+<script>
+  function setupSectionNav() {
+    const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+    if (!nav) return;
+
+    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
+    const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') && CSS.supports('selector(:target-current)');
+    const controller = new AbortController();
+    let frame = 0;
+
+    function updateCurrent() {
+      frame = 0;
+      let current = nativeTracking ? nav!.querySelector<HTMLAnchorElement>('a:target-current') : null;
+
+      if (!nativeTracking) {
+        // Keep the preceding section active through ads and gaps between stories.
+        const readingLine = nav!.getBoundingClientRect().height + 24;
+        let index = 0;
+        targets.forEach((target, targetIndex) => {
+          if (target && target.getBoundingClientRect().top <= readingLine) index = targetIndex;
+        });
+        // Short final sections may never reach the reading line.
+        if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+          index = links.length - 1;
+        }
+        current = links[index];
+      }
+
+      links.forEach(link => {
+        if (link === current) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (!frame) frame = requestAnimationFrame(updateCurrent);
+    }
+
+    // Observe visibility changes as well as scrolling, including image-driven layout shifts.
+    const observer = !nativeTracking && 'IntersectionObserver' in window
+      ? new IntersectionObserver(scheduleUpdate, { threshold: [0, 0.1, 0.5, 1] })
+      : null;
+    targets.forEach(target => { if (target) observer?.observe(target); });
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: controller.signal });
+    window.addEventListener('resize', scheduleUpdate, { signal: controller.signal });
+    window.addEventListener('hashchange', scheduleUpdate, { signal: controller.signal });
+    document.addEventListener('scrollend', scheduleUpdate, { signal: controller.signal });
+    scheduleUpdate();
+
+    document.addEventListener('astro:before-swap', () => {
+      controller.abort();
+      observer?.disconnect();
+      cancelAnimationFrame(frame);
+    }, { once: true });
+  }
+
+  document.addEventListener('astro:page-load', setupSectionNav);
+</script>
