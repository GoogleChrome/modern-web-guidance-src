+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const summaryOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en'
+    };
+
+    async function checkSummarySupport() {
+      if (!window.isSecureContext || !('Summarizer' in self)) {
+        journalStatus.textContent = 'Local AI summaries aren’t supported here. Use a browser with the native Summarizer API on a supported device over HTTPS. The full journal is available above.';
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(summaryOptions);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Your browser’s local AI model is unavailable on this device. You can read the full journal above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Get a few key points using AI on your device.'
+          : 'Your browser needs to download its AI model first. Select Summarize to begin; the first download may take a few minutes.';
+      } catch {
+        journalStatus.textContent = 'Couldn’t check local AI availability. Reload the page to try again, or read the full journal above.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s local AI…';
+      let summarizer;
+
+      try {
+        // Start creation directly in the click handler to preserve user activation.
+        summarizer = await Summarizer.create({
+          ...summaryOptions,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const progress = event.total > 0 ? event.loaded / event.total : event.loaded;
+              journalStatus.textContent = `Downloading the local AI model: ${Math.round(Math.min(1, Math.max(0, progress)) * 100)}%. The first download may take a few minutes.`;
+            });
+          }
+        });
+        journalStatus.textContent = 'Turning the journal into a few key points on your device…';
+        const text = document.getElementById('journal-story').innerText;
+        const summary = await summarizer.summarize(text);
+        const points = summary.split(/\n+/)
+          .map(point => point.replace(/^\s*(?:[-*•–]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map(point => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI-generated summary is ready below. See the full journal above for the details.';
+      } catch {
+        journalStatus.textContent = 'Couldn’t create a local AI summary. Check that your browser’s AI model is available and try again. The full journal is still available above.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summaryPanel.setAttribute('aria-busy', 'false');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkSummarySupport();
+  </script>
+
