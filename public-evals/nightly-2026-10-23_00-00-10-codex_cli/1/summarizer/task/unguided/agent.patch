+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-points');
+    const unsupportedMessage = 'Built-in AI summarization is not available in this browser or on this device. Try a supported desktop Chrome browser; the full journal is available above.';
+
+    if (!window.isSecureContext || !('Summarizer' in window)) {
+      summarizeButton.disabled = true;
+      journalStatus.textContent = unsupportedMessage;
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      let summarizer;
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.hidden = true;
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI…';
+
+      try {
+        // Create directly from the click to preserve user activation for a model download.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading the browser’s AI model: ${Math.round(event.loaded * 100)}%. This can take a few minutes on first use.`;
+            });
+          }
+        });
+        journalStatus.textContent = 'Reading the journal and finding the key points…';
+        const summary = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI summary is ready below. Generated on your device from the journal above.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotSupportedError'
+          ? unsupportedMessage
+          : 'Your browser could not create a summary. Please try again. If a model download was interrupted, check your connection.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summaryPanel.setAttribute('aria-busy', 'false');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+  </script>
+
