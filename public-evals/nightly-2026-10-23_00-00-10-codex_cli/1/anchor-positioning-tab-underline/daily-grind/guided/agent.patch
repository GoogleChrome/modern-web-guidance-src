+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = [...navList.querySelectorAll('[data-nav-item]')];
+    let activeItem = navItems.find(item => item.pathname === window.location.pathname)
+      || navItems[0];
+
+    function positionIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const itemBounds = activeItem.getBoundingClientRect();
+      navList.style.setProperty('--indicator-x', `${itemBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-y', `${itemBounds.bottom - listBounds.top + 4}px`);
+      navList.style.setProperty('--indicator-width', itemBounds.width);
+      navList.dataset.indicatorReady = '';
+    }
+
+    function selectItem(item) {
+      navItems.forEach(link => link.removeAttribute('aria-current'));
+      activeItem = item;
+      activeItem.setAttribute('aria-current', 'true');
+      positionIndicator();
+    }
+
+    navItems.forEach(item => {
+      item.addEventListener('click', event => {
+        // Preserve modified clicks for opening the link in another tab or window.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectItem(item);
+      });
+    });
+
+    selectItem(activeItem);
+    window.addEventListener('resize', positionIndicator);
+    document.fonts.ready.then(positionIndicator);
+  </script>
 </body>
 
