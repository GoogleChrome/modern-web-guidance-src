+<script>
+    // This router restores scroll inside the snapshot update.
+    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const cards = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const descriptions = {
+      'maple-oat-latte': 'Our Maple Oat Latte pairs rich espresso with creamy steamed oat milk and a hint of Vermont maple syrup. A gently sweet, comforting favorite for cooler days.',
+      'dark-roast-espresso': 'A bold, smoky espresso with a rich body and a lingering finish. Our dark roast is served freshly pulled for a warming morning boost.',
+      'cold-brew': 'Steeped slowly for 18 hours, our cold brew is smooth and full of flavor. Served over ice for a refreshing coffee ritual at any time of day.'
+    };
+    let activeCard = null;
+    let listScroll = 0;
+    let pendingRoute;
+    let navigating = false;
+    let activeTransition;
+
+    function routeCard() {
+      return cards.find(card => card.hash === location.hash) || null;
+    }
+
+    function clearTransitionNames() {
+      for (const element of [hero, title, ...cards, ...cards.map(card => card.querySelector('.title'))]) {
+        element.style.removeProperty('view-transition-name');
+      }
+    }
+
+    async function showPage(nextCard, animate = true) {
+      if (nextCard === activeCard) return;
+      const previousCard = activeCard;
+      if (!previousCard) listScroll = window.scrollY;
+      const sharedCard = nextCard || previousCard;
+      const heading = nextCard ? title : document.getElementById('list-heading');
+      let updated = false;
+      const update = () => {
+        if (updated) return;
+        updated = true;
+        if (nextCard) {
+          title.textContent = nextCard.querySelector('.title').textContent;
+          hero.style.backgroundImage = nextCard.style.backgroundImage;
+          document.getElementById('detail-description').textContent = descriptions[nextCard.dataset.favorite];
+        }
+        listPage.hidden = Boolean(nextCard);
+        detailPage.hidden = !nextCard;
+        activeCard = nextCard;
+        document.title = nextCard ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+        window.scrollTo({ top: nextCard ? 0 : listScroll, behavior: 'instant' });
+      };
+
+      try {
+        if (!animate || reducedMotion.matches || !document.startViewTransition) {
+          update();
+        } else {
+          // Only the selected card and the visible hero share these names.
+          sharedCard.style.viewTransitionName = 'hero';
+          sharedCard.querySelector('.title').style.viewTransitionName = 'title';
+          hero.style.viewTransitionName = 'hero';
+          title.style.viewTransitionName = 'title';
+          activeTransition = document.startViewTransition(update);
+          // A skipped visual transition must still finish the navigation.
+          await activeTransition.finished;
+        }
+      } catch (error) {
+        update();
+        console.warn('View transition skipped:', error);
+      } finally {
+        activeTransition = null;
+        clearTransitionNames();
+        heading.focus({ preventScroll: true });
+      }
+    }
+
+    // Serialize navigations; rapid back/forward actions resolve to the latest route.
+    async function navigate() {
+      pendingRoute = routeCard();
+      if (navigating) return;
+      navigating = true;
+      try {
+        while (pendingRoute !== undefined) {
+          const nextCard = pendingRoute;
+          pendingRoute = undefined;
+          await showPage(nextCard);
+        }
+      } finally {
+        navigating = false;
+      }
+    }
+
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+    window.addEventListener('hashchange', navigate);
+    // Deep links render immediately, without animating from an unrelated view.
+    showPage(routeCard(), false);
+  </script>
