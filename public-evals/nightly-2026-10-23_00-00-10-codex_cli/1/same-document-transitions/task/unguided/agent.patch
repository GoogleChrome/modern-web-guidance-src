+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const details = {
+      'maple-oat-latte': 'A little comfort in every cup. Our signature espresso meets creamy oat milk and a touch of Vermont maple syrup for a gently sweet, warming seasonal favorite.',
+      'dark-roast-espresso': 'Rich, bold, and beautifully balanced. Our dark roast brings deep, smoky notes and a velvety crema to a small cup with plenty of character.',
+      'cold-brew': 'Slow mornings start here. Steeped for 18 hours, our cold brew is smooth and refreshing, with a mellow sweetness. Served over ice, just as it should be.'
+    };
+    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+    let activeCard = null;
+    let listScroll = 0;
+    let runningTransition = null;
+    let navigation = Promise.resolve();
+
+    function cardFromLocation() {
+      return thumbnails.find(card => card.hash === location.hash) || null;
+    }
+
+    async function showPage(card) {
+      if (card === activeCard) return;
+      const previousCard = activeCard;
+      if (!previousCard) listScroll = window.scrollY;
+      const sharedCard = card || previousCard;
+      const sharedTitle = sharedCard.querySelector('.title');
+      const temporaryElements = [sharedCard, sharedTitle, hero, title];
+      const clearNames = () => temporaryElements.forEach(element => element.style.removeProperty('view-transition-name'));
+      const namePair = (surface, heading) => {
+        surface.style.viewTransitionName = 'coffee-image';
+        heading.style.viewTransitionName = 'coffee-title';
+      };
+      const update = () => {
+        clearNames();
+        if (card) {
+          hero.style.setProperty('--coffee-image', card.style.getPropertyValue('--coffee-image'));
+          title.textContent = card.querySelector('.title').textContent;
+          hero.setAttribute('aria-label', title.textContent);
+          document.querySelector('#description').textContent = details[card.dataset.coffee];
+        }
+        listPage.hidden = Boolean(card);
+        detailPage.hidden = !card;
+        activeCard = card;
+        document.title = card ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+        window.scrollTo(0, card ? 0 : listScroll);
+        if (runningTransition) namePair(card ? hero : sharedCard, card ? title : sharedTitle);
+      };
+      const focusHeading = () => (card ? title : document.querySelector('#list-heading')).focus({ preventScroll: true });
+
+      try {
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+        } else {
+          namePair(previousCard ? hero : sharedCard, previousCard ? title : sharedTitle);
+          runningTransition = document.startViewTransition(update);
+          // A skipped animation must still finish the DOM update before focus moves.
+          await runningTransition.updateCallbackDone;
+          focusHeading();
+          await runningTransition.finished;
+        }
+      } finally {
+        runningTransition = null;
+        clearNames();
+        focusHeading();
+      }
+    }
+
+    function navigate() {
+      // Serialize rapid clicks and history changes so snapshot names cannot collide.
+      navigation = navigation.then(() => showPage(cardFromLocation())).catch(error => {
+        console.error('Could not complete page transition:', error);
+      });
+    }
+    thumbnails.forEach(card => card.addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      history.pushState({ seasonalDetail: true }, '', card.hash);
+      navigate();
+    }));
+    document.querySelector('#back').addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      if (history.state?.seasonalDetail) history.back();
+      else {
+        history.replaceState(null, '', location.pathname + location.search);
+        navigate();
+      }
+    });
+    window.addEventListener('popstate', navigate);
+    window.addEventListener('hashchange', navigate);
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) runningTransition?.skipTransition();
+    });
+    // Render deep links without an entrance animation.
+    if (cardFromLocation()) {
+      const initialCard = cardFromLocation();
+      hero.style.setProperty('--coffee-image', initialCard.style.getPropertyValue('--coffee-image'));
+      title.textContent = initialCard.querySelector('.title').textContent;
+      hero.setAttribute('aria-label', title.textContent);
+      document.querySelector('#description').textContent = details[initialCard.dataset.coffee];
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      activeCard = initialCard;
+      document.title = `${title.textContent} | The Daily Grind`;
+      title.focus({ preventScroll: true });
+    }
+  </script>
