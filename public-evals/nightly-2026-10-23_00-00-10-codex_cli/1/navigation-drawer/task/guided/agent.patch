+  <script type="module">
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const supportsPopover = typeof drawer.showPopover === 'function';
+    let state = 'closed';
+    let hasEntered = false;
+    let hasFocused = false;
+
+    if (!supportsPopover) {
+      drawer.removeAttribute('popover');
+      drawer.classList.add('no-popover');
+    }
+
+    function finishClosing() {
+      if (state === 'closed') return;
+      state = 'closed';
+      if (supportsPopover) drawer.hidePopover();
+      drawer.classList.remove('is-open');
+      page.inert = false;
+      document.documentElement.classList.remove('drawer-open');
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus();
+    }
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasEntered = false;
+      hasFocused = false;
+      drawer.classList.add('is-open');
+      if (supportsPopover) drawer.showPopover();
+      page.inert = true;
+      document.documentElement.classList.add('drawer-open');
+      openButton.setAttribute('aria-expanded', 'true');
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      }
+      // Commit the initial closed position before starting the slide-in.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    const observer = new IntersectionObserver(entries => {
+      if (state === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRatio > 0) hasEntered = true;
+      // Ignore the initial off-screen frame while opening.
+      if (!entry.isIntersecting || entry.intersectionRatio === 0) {
+        if (hasEntered || state === 'closing') finishClosing();
+      } else if (entry.intersectionRatio >= 0.999 && state !== 'closing') {
+        state = 'open';
+        if (!hasFocused) {
+          hasFocused = true;
+          sheet.focus();
+        }
+      }
+    }, { root: scroller, threshold: [0, 0.001, 0.999, 1] });
+    observer.observe(sheet);
+
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const opacity = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / sheet.offsetWidth));
+        drawer.style.setProperty('--drawer-backdrop', opacity);
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    drawer.querySelector('.drawer-close').addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && state !== 'closed') {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+  </script>
