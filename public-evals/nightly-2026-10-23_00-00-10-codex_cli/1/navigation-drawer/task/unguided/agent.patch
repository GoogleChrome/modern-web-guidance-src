+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('#menu-drawer');
+    const track = drawer.querySelector('.drawer-track');
+    const panel = drawer.querySelector('.drawer-panel');
+
+    menuButton.addEventListener('click', () => {
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Start at the visible panel; swiping right returns to the empty snap point.
+      track.scrollTo({ left: track.scrollWidth - track.clientWidth, behavior: 'instant' });
+    });
+
+    drawer.querySelector('.close-menu').addEventListener('click', () => drawer.close());
+    drawer.addEventListener('click', (event) => {
+      if (!panel.contains(event.target) || event.target.closest('a')) drawer.close();
+    });
+
+    const closeAfterSwipe = () => {
+      if (drawer.open && track.scrollLeft <= 1) drawer.close();
+    };
+
+    if ('onscrollend' in track) {
+      track.addEventListener('scrollend', closeAfterSwipe);
+    } else {
+      // Older browsers still use native scrolling and snapping.
+      let scrollTimer;
+      track.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(closeAfterSwipe, 150);
+      }, { passive: true });
+    }
+
+    // Escape uses the dialog's native cancel behavior, which also fires close.
+    drawer.addEventListener('close', () => {
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+  </script>
