diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..8e9a407
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,120 @@
+(() => {
+  "use strict";
+
+  // Progressive enhancement: links remain usable without WebMCP support.
+  if (!window.isSecureContext ||
+      typeof document.modelContext?.registerTool !== "function") return;
+
+  let registration;
+
+  function getDestinations() {
+    return Array.from(document.querySelectorAll("a[data-page]"), (link) => {
+      const card = link.closest("[data-menu-item]");
+      return {
+        page: link.dataset.page,
+        title: card?.querySelector("h3")?.textContent.trim() || link.textContent.trim(),
+        url: link.href,
+      };
+    }).filter(({ url }) => {
+      const destination = new URL(url);
+      return destination.origin === window.location.origin &&
+        ["https:", "http:"].includes(destination.protocol);
+    });
+  }
+
+  // Schema constraints also need runtime checks: the browser does not enforce them.
+  function validateInput(input, allowedKeys) {
+    if (!input || typeof input !== "object" || Array.isArray(input)) {
+      return { error: "Provide an object containing the tool arguments." };
+    }
+    if (Object.keys(input).some((key) => !allowedKeys.includes(key))) {
+      return { error: "Unexpected argument. Use only the properties in the input schema." };
+    }
+    return null;
+  }
+
+  function createTools() {
+    const pageNames = getDestinations().map(({ page }) => page);
+    const emptySchema = { type: "object", properties: {}, additionalProperties: false };
+
+    return [
+      {
+        name: "get_seasonal_favorites",
+        description: "Read the featured coffee drinks and their descriptions from the current page, with links to details.",
+        inputSchema: emptySchema,
+        execute(input = {}) {
+          const error = validateInput(input, []);
+          if (error) return error;
+          return {
+            items: Array.from(document.querySelectorAll("[data-menu-item]"), (card) => ({
+              name: card.querySelector("h3").textContent.trim(),
+              description: card.querySelector("p").textContent.trim(),
+              detailsUrl: card.querySelector("a[data-page]").href,
+            })),
+          };
+        },
+        annotations: { readOnlyHint: true },
+      },
+      {
+        name: "get_navigation_options",
+        description: "List the available Daily Grind page destinations and their links. Use to find a page before navigating.",
+        inputSchema: emptySchema,
+        execute(input = {}) {
+          return validateInput(input, []) || { destinations: getDestinations() };
+        },
+        annotations: { readOnlyHint: true },
+      },
+      {
+        name: "navigate_to_page",
+        description: "Follow a Daily Grind page link in the current tab. Use to open menu details, ordering, account, or shop information.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            page: {
+              type: "string",
+              enum: pageNames,
+              description: "The destination identifier returned by get_navigation_options.",
+            },
+          },
+          required: ["page"],
+          additionalProperties: false,
+        },
+        execute(input = {}) {
+          const error = validateInput(input, ["page"]);
+          if (error) return error;
+          const destination = getDestinations().find(({ page }) => page === input.page);
+          if (typeof input.page !== "string" || !destination) {
+            return { error: "Choose an available page destination.", availablePages: pageNames };
+          }
+          window.location.assign(destination.url);
+          return { navigatingTo: destination.url };
+        },
+        annotations: { readOnlyHint: false },
+      },
+    ];
+  }
+
+  async function registerTools() {
+    if (registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of createTools()) {
+        await document.modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      const cancelled = controller.signal.aborted;
+      controller.abort(); // Roll back partial registration on failure.
+      if (registration === controller) registration = undefined;
+      if (!cancelled) console.warn("Daily Grind WebMCP registration failed:", error);
+    }
+  }
+
+  window.addEventListener("pagehide", () => {
+    registration?.abort();
+    registration = undefined;
+  });
+  // Restore tools when navigating back from the browser's page cache.
+  window.addEventListener("pageshow", () => void registerTools());
+  void registerTools();
+})();
