diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..7ed97bd
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,116 @@
+(() => {
+  'use strict';
+
+  // The API moved to document; retain support for earlier preview browsers.
+  const context = typeof document.modelContext?.registerTool === 'function'
+    ? document.modelContext
+    : navigator.modelContext;
+  if (typeof context?.registerTool !== 'function') return;
+
+  const destinationLinks = () => Array.from(
+    document.querySelectorAll('a[data-agent-destination]')
+  );
+  const destinations = () => destinationLinks().map(link => ({
+    id: link.dataset.agentDestination,
+    label: link.closest('[data-agent-product]')?.querySelector('h3').textContent.trim()
+      || link.textContent.trim(),
+    path: link.getAttribute('href'),
+  }));
+
+  // Validate at execution time as well: schema enforcement varies by browser.
+  function validateInput(input, allowedKeys = []) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      throw new TypeError('Tool arguments must be an object.');
+    }
+    if (Object.keys(input).some(key => !allowedKeys.includes(key))) {
+      throw new TypeError('Unexpected tool argument.');
+    }
+  }
+
+  const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+  const tools = [
+    {
+      name: 'get_seasonal_favorites',
+      description: 'Read the seasonal coffees displayed on The Daily Grind homepage, including descriptions and detail paths. Prices and availability are not provided on this page.',
+      inputSchema: emptySchema,
+      annotations: { readOnlyHint: true },
+      async execute(input = {}) {
+        validateInput(input);
+        return {
+          products: Array.from(document.querySelectorAll('[data-agent-product]')).map(card => ({
+            id: card.dataset.agentProduct,
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsPath: card.querySelector('a').getAttribute('href'),
+            destination: card.querySelector('a').dataset.agentDestination,
+          })),
+        };
+      },
+    },
+    {
+      name: 'list_destinations',
+      description: 'List the navigation destinations linked on The Daily Grind homepage. Use a returned ID with navigate_to. Ordering opens the ordering page; it does not place an order.',
+      inputSchema: emptySchema,
+      annotations: { readOnlyHint: true },
+      async execute(input = {}) {
+        validateInput(input);
+        return { destinations: destinations() };
+      },
+    },
+    {
+      name: 'navigate_to',
+      description: 'Follow an existing Daily Grind link by destination ID, including coffee details, menu, locations, rewards, account, ordering, or company information. Leaves this page. Does not place orders or log out.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          destination: {
+            type: 'string',
+            description: 'An ID returned by list_destinations or get_seasonal_favorites.',
+            enum: destinations().map(destination => destination.id),
+          },
+        },
+        required: ['destination'],
+        additionalProperties: false,
+      },
+      annotations: { readOnlyHint: false, consequentialHint: false },
+      async execute(input) {
+        validateInput(input, ['destination']);
+        if (typeof input.destination !== 'string') {
+          throw new TypeError('destination must be a string.');
+        }
+        const link = destinationLinks().find(link => link.dataset.agentDestination === input.destination);
+        if (!link) throw new Error('Unknown destination. Call list_destinations for valid IDs.');
+        const url = new URL(link.getAttribute('href'), window.location.href);
+        if (url.origin !== window.location.origin || !['https:', 'http:'].includes(url.protocol)) {
+          throw new Error('Only same-origin HTTP navigation is supported.');
+        }
+        window.location.assign(url.href);
+        return { destination: input.destination, path: url.pathname };
+      },
+    },
+  ];
+
+  // Abort registrations when leaving, and restore them on back/forward cache entry.
+  let controller;
+  async function registerTools() {
+    if (controller) return;
+    const registration = new AbortController();
+    controller = registration;
+    for (const tool of tools) {
+      if (registration.signal.aborted) return;
+      try {
+        await context.registerTool(tool, { signal: registration.signal });
+      } catch (error) {
+        if (!registration.signal.aborted) {
+          console.warn(`WebMCP: could not register ${tool.name}.`, error);
+        }
+      }
+    }
+  }
+  window.addEventListener('pagehide', () => {
+    controller?.abort();
+    controller = undefined;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
