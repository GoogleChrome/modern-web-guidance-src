@@ -0,0 +1,46 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+const baseUrl = import.meta.env.BASE_URL;
+export const readingListChanged = 'devtools-times:reading-list-changed';
+
+async function request<T>(path: string, options?: RequestInit): Promise<T> {
+  const response = await fetch(`${baseUrl}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) =>
+  request<Article[]>('articles.json', { signal });
+
+export function searchArticles(articles: Article[], query: string): Article[] {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleUrl(slug: string): string {
+  return `${baseUrl}articles/${encodeURIComponent(slug)}`;
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  return (await request<{ readingList: string[] }>('reading-list.json', { signal })).readingList;
+}
+
+export async function updateReadingList(
+  slug: string, action: 'add' | 'remove' | 'toggle', signal?: AbortSignal,
+): Promise<string[]> {
+  const { readingList } = await request<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }),
+    signal,
+  });
+  window.dispatchEvent(new CustomEvent(readingListChanged, { detail: readingList }));
+  return readingList;
+}
