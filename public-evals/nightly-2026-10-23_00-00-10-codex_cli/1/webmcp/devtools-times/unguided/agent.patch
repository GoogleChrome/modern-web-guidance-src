diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..f347356
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,132 @@
+import { articleUrl, getArticles, getReadingList, updateReadingList } from '../lib/articles';
+import { getModelContext, type BrowserTool } from '../lib/webmcp';
+
+const slugSchema = {
+  type: 'object',
+  properties: { slug: { type: 'string', minLength: 1, description: 'Article slug returned by list_articles or search_articles.' } },
+  required: ['slug'],
+  additionalProperties: false,
+};
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+
+async function findArticle(input: Record<string, unknown>, signal?: AbortSignal) {
+  if (typeof input.slug !== 'string' || !input.slug.trim()) throw new Error('An article slug is required.');
+  const article = (await getArticles(signal)).find(article => article.slug === input.slug);
+  if (!article) throw new Error('Article not found. Use list_articles to find a valid slug.');
+  return { ...article, url: articleUrl(article.slug) };
+}
+
+const tools: BrowserTool[] = [
+  {
+    name: 'list_articles',
+    description: 'List all DevTools Times articles with their slugs, titles, summaries, and links.',
+    inputSchema: emptySchema,
+    annotations: { readOnlyHint: true },
+    execute: async (_input, { signal } = {}) => ({
+      articles: (await getArticles(signal)).map(article => ({ ...article, url: articleUrl(article.slug) })),
+    }),
+  },
+  {
+    name: 'get_article',
+    description: 'Read an article by slug without navigating. Returns its metadata and plain-text article body.',
+    inputSchema: slugSchema,
+    annotations: { readOnlyHint: true },
+    execute: async (input, { signal } = {}) => {
+      const article = await findArticle(input, signal);
+      const response = await fetch(article.url, { signal });
+      if (!response.ok) throw new Error(`Unable to read article (${response.status}).`);
+      // Parse inert HTML: article scripts, images, and analytics are never executed.
+      const page = new DOMParser().parseFromString(await response.text(), 'text/html');
+      const body = page.querySelector('[data-article-body]');
+      if (!body) throw new Error('Article content is unavailable.');
+      body.querySelectorAll('script, style, noscript').forEach(element => element.remove());
+      return { ...article, text: body.textContent?.trim() ?? '' };
+    },
+  },
+  {
+    name: 'open_article',
+    description: 'Navigate the browser to a DevTools Times article by its slug.',
+    inputSchema: slugSchema,
+    execute: async (input, { signal } = {}) => {
+      const article = await findArticle(input, signal);
+      signal?.throwIfAborted();
+      window.location.assign(article.url);
+      return { url: article.url };
+    },
+  },
+  {
+    name: 'get_reading_list',
+    description: 'Read the current browser session’s saved articles, with titles, summaries, and links.',
+    inputSchema: emptySchema,
+    annotations: { readOnlyHint: true },
+    execute: async (_input, { signal } = {}) => {
+      const [articles, saved] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+      return { readingList: articles.filter(article => saved.includes(article.slug)).map(article => ({ ...article, url: articleUrl(article.slug) })) };
+    },
+  },
+  {
+    name: 'set_article_saved',
+    description: 'Save or remove an article in the current session’s reading list. Repeating the same request keeps the same saved state. Updates visible bookmark controls.',
+    inputSchema: {
+      ...slugSchema,
+      properties: { ...slugSchema.properties, saved: { type: 'boolean', description: 'True to save; false to remove.' } },
+      required: ['slug', 'saved'],
+    },
+    execute: async (input, { signal } = {}) => {
+      if (typeof input.saved !== 'boolean') throw new Error('saved must be a boolean.');
+      const article = await findArticle(input, signal);
+      const readingList = await updateReadingList(article.slug, input.saved ? 'add' : 'remove', signal);
+      return { slug: article.slug, saved: readingList.includes(article.slug), readingList };
+    },
+  },
+];
+
+let controller: AbortController | undefined;
+let registeredNames: string[] = [];
+
+function cleanup() {
+  controller?.abort();
+  const context = getModelContext();
+  // Earlier previews use unregisterTool; current implementations use AbortSignal.
+  for (const name of registeredNames) context?.unregisterTool?.(name);
+  registeredNames = [];
+}
+
+async function registerTools() {
+  cleanup();
+  const context = getModelContext();
+  if (!context) return;
+  const current = new AbortController();
+  controller = current;
+  for (const tool of tools) {
+    if (current.signal.aborted) return;
+    try {
+      await context.registerTool({
+        ...tool,
+        execute: async (input, client = {}) => {
+          try {
+            return await tool.execute(input, client);
+          } catch (error) {
+            return { error: error instanceof Error ? error.message : 'The tool could not complete.' };
+          }
+        },
+      }, { signal: current.signal });
+      if (current.signal.aborted) {
+        context.unregisterTool?.(tool.name);
+        return;
+      }
+      registeredNames.push(tool.name);
+    } catch (error) {
+      if (!current.signal.aborted) console.warn(`Could not register WebMCP tool ${tool.name}:`, error);
+    }
+  }
+}
+
+// Astro keeps this module across client-side navigations.
+// page-load also fires on the initial page, after the DOM is available.
+document.addEventListener('astro:page-load', () => { void registerTools(); });
+document.addEventListener('astro:before-swap', cleanup);
+window.addEventListener('pagehide', cleanup);
+window.addEventListener('pageshow', event => {
+  if (event.persisted) void registerTools();
+});
diff --git a/tests/webmcp.test.mjs b/tests/webmcp.test.mjs
new file mode 100644
index 0000000..78c27f6
--- /dev/null
+++ b/tests/webmcp.test.mjs
@@ -0,0 +1,202 @@
+import { after, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+// Compile only client modules and the API handler. Never import a server entrypoint.
+const directory = await mkdtemp(join(tmpdir(), 'times-webmcp-'));
+after(() => rm(directory, { recursive: true, force: true }));
+async function compile(entry, name, plugins = []) {
+  const outfile = join(directory, `${name}.mjs`);
+  await build({ ...(typeof entry === 'string' ? { entryPoints: [entry] } : { stdin: entry }), outfile, bundle: true, format: 'esm', platform: 'node',
+    banner: { js: "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);" },
+    define: { 'import.meta.env.BASE_URL': '"/devtools-times/"' }, plugins });
+  return import(pathToFileURL(outfile).href);
+}
+
+const documentStub = new EventTarget();
+const windowStub = new EventTarget();
+const registered = new Map();
+const context = new EventTarget();
+context.registerTool = async (tool, { signal }) => {
+  assert.ok(!registered.has(tool.name), `duplicate tool ${tool.name}`);
+  registered.set(tool.name, tool);
+  signal.addEventListener('abort', () => registered.delete(tool.name));
+};
+documentStub.modelContext = context;
+globalThis.document = documentStub;
+globalThis.window = windowStub;
+const articles = [{ slug: 'coffee', title: 'Coffee Alchemy', summary: 'Roasts and brewing' }];
+let saved = [];
+let lastRequest;
+globalThis.fetch = async (url, options = {}) => {
+  lastRequest = { url, options };
+  if (options.signal?.aborted) throw options.signal.reason;
+  if (url.endsWith('articles.json')) return Response.json(articles);
+  if (url.endsWith('reading-list.json')) {
+    if (options.method === 'POST') {
+      const { slug, action } = JSON.parse(options.body);
+      saved = action === 'add' ? [...new Set([...saved, slug])] : saved.filter(item => item !== slug);
+    }
+    return Response.json({ readingList: saved });
+  }
+  return new Response('Article HTML');
+};
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const client = await compile('src/lib/articles.ts', 'articles');
+const helpers = await compile('src/lib/webmcp.ts', 'helpers');
+await compile('src/scripts/webmcp.ts', 'tools');
+
+test('registers five tools and cleans up across Astro navigation', async () => {
+  documentStub.dispatchEvent(new Event('astro:page-load'));
+  await tick();
+  assert.deepEqual([...registered.keys()], ['list_articles', 'get_article', 'open_article', 'get_reading_list', 'set_article_saved']);
+  documentStub.dispatchEvent(new Event('astro:before-swap'));
+  assert.equal(registered.size, 0);
+  documentStub.dispatchEvent(new Event('astro:page-load'));
+  await tick();
+  assert.equal(registered.size, 5);
+});
+
+test('search matches title and summary, trims whitespace and ignores case', () => {
+  assert.equal(client.searchArticles(articles, ' COFFEE ').length, 1);
+  assert.equal(client.searchArticles(articles, 'BREWING').length, 1);
+  assert.deepEqual(client.searchArticles(articles, '   '), []);
+  assert.deepEqual(client.searchArticles(articles, 'missing'), []);
+});
+
+test('list and navigation use base-aware URLs and validate slugs', async () => {
+  const result = await registered.get('list_articles').execute({}, {});
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee');
+  let destination;
+  windowStub.location = { assign: url => { destination = url; } };
+  await registered.get('open_article').execute({ slug: 'coffee' }, {});
+  assert.equal(destination, '/devtools-times/articles/coffee');
+  assert.match((await registered.get('open_article').execute({ slug: '../bad' }, {})).error, /not found/);
+  assert.match((await registered.get('get_article').execute({}, {})).error, /slug is required/);
+});
+
+test('saving is idempotent, returns list state and broadcasts UI updates', async () => {
+  let updates = 0;
+  windowStub.addEventListener(client.readingListChanged, () => updates++);
+  const save = registered.get('set_article_saved');
+  await save.execute({ slug: 'coffee', saved: true }, {});
+  await save.execute({ slug: 'coffee', saved: true }, {});
+  assert.deepEqual(saved, ['coffee']);
+  assert.equal(updates, 2);
+  assert.equal((await registered.get('get_reading_list').execute({}, {})).readingList[0].slug, 'coffee');
+  await save.execute({ slug: 'coffee', saved: false }, {});
+  await save.execute({ slug: 'coffee', saved: false }, {});
+  assert.deepEqual(saved, []);
+  assert.match((await save.execute({ slug: 'coffee', saved: 'yes' }, {})).error, /boolean/);
+});
+
+test('reads inert article content and removes scripts from returned text', async () => {
+  let stripped = false;
+  globalThis.DOMParser = class {
+    parseFromString(_html, type) {
+      assert.equal(type, 'text/html');
+      return { querySelector: selector => {
+        assert.equal(selector, '[data-article-body]');
+        return { querySelectorAll: () => [{ remove: () => { stripped = true; } }], get textContent() { return stripped ? 'Coffee article body' : 'script contents'; } };
+      } };
+    }
+  };
+  const result = await registered.get('get_article').execute({ slug: 'coffee' }, {});
+  assert.equal(result.text, 'Coffee article body');
+  assert.ok(stripped);
+});
+
+test('passes cancellation to fetch and returns request errors', async () => {
+  const controller = new AbortController();
+  controller.abort(new Error('Cancelled'));
+  assert.match((await registered.get('list_articles').execute({}, { signal: controller.signal })).error, /Cancelled/);
+  assert.equal(lastRequest.options.signal, controller.signal);
+  const originalFetch = globalThis.fetch;
+  try {
+    globalThis.fetch = async () => new Response(null, { status: 503 });
+    assert.match((await registered.get('list_articles').execute({}, {})).error, /503/);
+  } finally { globalThis.fetch = originalFetch; }
+});
+
+test('respondWith is used synchronously for agent submissions only', async () => {
+  const result = Promise.resolve({ articles });
+  let response;
+  helpers.respondToAgent({ nativeEvent: { agentInvoked: true, respondWith: value => { response = value; } } }, result);
+  assert.equal(response, result);
+  response = undefined;
+  helpers.respondToAgent({ nativeEvent: { agentInvoked: false, respondWith: value => { response = value; } } }, result);
+  assert.equal(response, undefined);
+});
+
+test('unsupported browsers are a no-op; legacy navigator context is supported', async () => {
+  documentStub.dispatchEvent(new Event('astro:before-swap'));
+  delete documentStub.modelContext;
+  documentStub.dispatchEvent(new Event('astro:page-load'));
+  await tick();
+  assert.equal(registered.size, 0);
+  navigator.modelContext = context;
+  documentStub.dispatchEvent(new Event('astro:page-load'));
+  await tick();
+  assert.equal(registered.size, 5);
+  windowStub.dispatchEvent(new Event('pagehide'));
+  assert.equal(registered.size, 0);
+  delete navigator.modelContext;
+});
+
+const endpoint = await compile('src/pages/api/reading-list.json.ts', 'endpoint', [{
+  name: 'content-fixture',
+  setup(builder) {
+    builder.onResolve({ filter: /^astro:content$/ }, () => ({ path: 'content', namespace: 'fixture' }));
+    builder.onLoad({ filter: /.*/, namespace: 'fixture' }, () => ({ contents: 'export async function getEntry(collection, slug) { return slug === "coffee" ? { id: slug } : undefined; }' }));
+  },
+}]);
+test('reading-list endpoint validates input and preserves legacy toggle behavior', async () => {
+  let list = [];
+  const session = { get: async () => list, set: async (_key, value) => { list = value; } };
+  const post = async input => endpoint.POST({ request: new Request('https://example.com/api/reading-list.json', { method: 'POST', body: JSON.stringify(input) }), session });
+  assert.equal((await post(null)).status, 400);
+  assert.equal((await post({ slug: 5 })).status, 400);
+  assert.equal((await post({ slug: 'coffee', action: 'invalid' })).status, 400);
+  assert.equal((await post({ slug: 'missing' })).status, 404);
+  await post({ slug: 'coffee', action: 'add' });
+  await post({ slug: 'coffee', action: 'add' });
+  assert.deepEqual(list, ['coffee']);
