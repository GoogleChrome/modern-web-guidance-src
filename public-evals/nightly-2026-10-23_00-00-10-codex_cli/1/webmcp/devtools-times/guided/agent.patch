diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..9d65f6e
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,56 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJSON<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, options);
+  if (!response.ok) {
+    throw new Error(`Request failed: ${response.status} ${response.statusText}`);
+  }
+  return response.json();
+}
+
+export const loadArticles = (signal?: AbortSignal) =>
+  requestJSON<Article[]>('articles.json', { signal });
+
+let readingListSnapshot: string[] | undefined;
+export const getReadingListSnapshot = () => readingListSnapshot;
+
+export async function loadReadingList(signal?: AbortSignal) {
+  const data = await requestJSON<{ readingList: string[] }>('reading-list.json', { signal });
+  readingListSnapshot = data.readingList;
+  return data;
+}
+
+export async function updateBookmark(slug: string, action: 'add' | 'remove' | 'toggle' = 'toggle') {
+  const data = await requestJSON<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }),
+  });
+  readingListSnapshot = data.readingList;
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: data.readingList }));
+  return data;
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleResult(article: Article) {
+  return { ...article, url: `${import.meta.env.BASE_URL}articles/${article.slug}` };
+}
+
+// Call during submission, before yielding, so the browser can await the result.
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as SubmitEvent;
+  if (submission.agentInvoked && typeof submission.respondWith === 'function') {
+    submission.respondWith(result);
+  }
+}
