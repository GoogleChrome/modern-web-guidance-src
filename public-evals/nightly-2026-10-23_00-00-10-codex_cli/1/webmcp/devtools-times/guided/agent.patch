diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..e997699
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,109 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { loadArticles, articleResult } from '../lib/articles';
+
+const emptyInput = { type: 'object', properties: {}, additionalProperties: false };
+
+// Keep HTTP failures and redirects visible: these endpoints are DevTools demos.
+async function requestUtility(endpoint: string, signal: AbortSignal) {
+  try {
+    const response = await fetch(`${import.meta.env.BASE_URL}api/${endpoint}`, { signal });
+    const body = await response.text();
+    let data: unknown = body;
+    try { data = JSON.parse(body); } catch { /* Redirect targets may return HTML. */ }
+    return {
+      ok: response.ok,
+      status: response.status,
+      redirected: response.redirected,
+      url: response.url,
+      ...(response.ok ? { data } : { error: `Request failed: ${response.status} ${response.statusText}`, data }),
+    };
+  } catch (error) {
+    if (signal.aborted) throw error;
+    return { error: 'Unable to reach the article utility. Please retry.' };
+  }
+}
+
+export default function ArticleTools({ articleSlug }: { articleSlug?: string }) {
+  useWebMCP({
+    name: 'list_articles',
+    description: 'List available articles with their summaries and links. Use to discover articles and their slugs.',
+    inputSchema: emptyInput,
+    async execute(_input, { signal }) {
+      try {
+        return { articles: (await loadArticles(signal)).map(articleResult) };
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: 'Unable to load articles. Please retry.' };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_current_article',
+    description: 'Read the current article title, summary, body text, and link.',
+    inputSchema: emptyInput,
+    enabled: Boolean(articleSlug),
+    execute() {
+      const article = document.querySelector('main article');
+      const body = document.getElementById('article-body');
+      if (!article || !body) return { error: 'No article is currently available.' };
+      return {
+        slug: articleSlug,
+        title: article.querySelector('h1')?.textContent?.trim(),
+        summary: article.querySelector('p')?.textContent?.trim(),
+        text: body.innerText,
+        url: window.location.href,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_coffee_brew',
+    description: 'Request the coffee article’s brewing utility and report its result or HTTP failure.',
+    inputSchema: emptyInput,
+    enabled: articleSlug === 'coffee-alchemy',
+    execute: (_input, { signal }) => requestUtility('coffee-brew', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_tide_levels',
+    description: 'Request the coastal article’s tide utility and report its result, redirect, or HTTP failure.',
+    inputSchema: emptyInput,
+    enabled: articleSlug === 'coastal-pulse',
+    execute: (_input, { signal }) => requestUtility('tide-levels', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_plant_stats',
+    description: 'Request the plants article’s statistics utility and report its result or HTTP failure.',
+    inputSchema: emptyInput,
+    enabled: articleSlug === 'silent-architects',
+    execute: (_input, { signal }) => requestUtility('plant-stats', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_article_popularity',
+    description: 'Fetch popularity statistics for an article.',
+    inputSchema: {
+      type: 'object',
+      properties: { id: { type: 'string', minLength: 1, description: 'Slug of the article to look up.' } },
+      required: ['id'],
+      additionalProperties: false,
+    },
+    enabled: articleSlug === 'super-bowl-lx',
+    execute(input, { signal }) {
+      if (typeof input.id !== 'string' || !input.id.trim()) {
+        return { error: 'Provide a nonempty article id.' };
+      }
+      return requestUtility(`article-popularity?${new URLSearchParams({ id: input.id.trim() })}`, signal);
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
