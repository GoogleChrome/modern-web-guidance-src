+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Stay logged in</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" aria-label="Online ordering information" hidden>
+    <button type="button" id="close-notice-btn" class="overlay-close" aria-label="Dismiss ordering notice">&times;</button>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+
+    function revealOverlay(element) {
+      // Commit the initial CSS state so entry also animates without @starting-style.
+      element.getBoundingClientRect();
+      element.setAttribute('data-visible', '');
+    }
+
+    async function dismissOverlay(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      element.removeAttribute('data-visible');
+      // Keep the dialog (and its backdrop) rendered until CSS exits finish.
+      // This also covers browsers without discrete display/overlay transitions.
+      await Promise.race([
+        Promise.allSettled(element.getAnimations({ subtree: true }).map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (logoutDialog.open) return;
+      logoutDialog.showModal();
+      revealOverlay(logoutDialog);
+    });
+
+    const closeLogout = () => dismissOverlay(logoutDialog, () => logoutDialog.close());
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogout();
+    });
+
+    function closeNotice() {
+      return dismissOverlay(orderingNotice, () => {
+        const restoreFocus = orderingNotice.contains(document.activeElement);
+        orderingNotice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderButton.focus();
+      });
+    }
+
+    orderButton.addEventListener('click', () => {
+      if (!orderingNotice.hidden) {
+        closeNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      revealOverlay(orderingNotice);
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', closeNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderingNotice.hidden) {
+        event.preventDefault();
+        closeNotice();
+      }
+    });
+  </script>
+
