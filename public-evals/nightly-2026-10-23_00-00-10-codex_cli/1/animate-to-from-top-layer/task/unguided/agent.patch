+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation" autofocus>&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary">Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="order-notice" class="order-notice" aria-label="Online ordering notice" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" id="dismiss-notice-btn" class="close-button" aria-label="Dismiss ordering notice">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderNotice = document.getElementById('order-notice');
+    const dismissNoticeButton = document.getElementById('dismiss-notice-btn');
+
+    function animateClose(element, onClosed) {
+      if (element.classList.contains('is-closing')) return;
+      element.classList.add('is-closing');
+      function finish(event) {
+        if (event.target !== element || event.animationName !== 'panel-out') return;
+        element.removeEventListener('animationend', finish);
+        onClosed();
+        element.classList.remove('is-closing');
+      }
+      element.addEventListener('animationend', finish);
+    }
+
+    function closeLogoutDialog() {
+      animateClose(logoutDialog, () => logoutDialog.close());
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+
+    orderButton.addEventListener('click', () => {
+      orderNotice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+
+    function dismissNotice() {
+      animateClose(orderNotice, () => {
+        if (orderNotice.contains(document.activeElement)) orderButton.focus();
+        orderNotice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+      });
+    }
+
+    dismissNoticeButton.addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderNotice.hidden) dismissNotice();
+    });
+  </script>
