+  <script>
+    (() => {
+      const hourInMs = 60 * 60 * 1000;
+
+      function updatePromotionTimer() {
+        // Component constructors use the visitor's local time zone (months are zero-based).
+        // The start is an explicit assumption until the promotion's actual start is supplied.
+        const start = new Date(2026, 0, 1, 0, 0, 0);
+        const end = new Date(2026, 2, 1, 0, 0, 0);
+        const now = Date.now();
+        const remainingHours = Math.floor(Math.max(0, end.getTime() - now) / hourInMs);
+        const elapsedHours = Math.floor(Math.max(0, now - start.getTime()) / hourInMs);
+        const elapsedDays = Math.floor(elapsedHours / 24);
+        const elapsedRemainder = elapsedHours % 24;
+
+        document.getElementById('promotion-days').textContent = Math.floor(remainingHours / 24);
+        document.getElementById('promotion-hours').textContent = remainingHours % 24;
+        document.getElementById('promotion-status').textContent = now >= end.getTime()
+          ? 'Offer ended'
+          : now < start.getTime() ? 'Promotion has not started' : 'Limited-time seasonal offer';
+        document.getElementById('promotion-elapsed').textContent =
+          `${elapsedDays} ${elapsedDays === 1 ? 'day' : 'days'} and ${elapsedRemainder} ${elapsedRemainder === 1 ? 'hour' : 'hours'} elapsed since promotion start.`;
+        document.getElementById('promotion-values').hidden = false;
+      }
+
+      updatePromotionTimer();
+      // Also refresh when a browser restores this page from its back/forward cache.
+      window.addEventListener('pageshow', updatePromotionTimer);
+    })();
+  </script>
