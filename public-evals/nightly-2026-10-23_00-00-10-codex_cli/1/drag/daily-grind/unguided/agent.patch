@@ -207,6 +258,72 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <aside class="floating-tip" aria-label="Coffee tip">
+    <button class="drag-handle" type="button" aria-label="Move coffee tip. Drag or use arrow keys.">
+      <span>Your daily coffee tip</span>
+      <span aria-hidden="true">⠿</span>
+    </button>
+    <p>Make time for a little coffee break.
+      <small>Drag the handle to move me.</small>
+    </p>
+  </aside>
+
+  <script>
+    const floatingTip = document.querySelector('.floating-tip');
+    const dragHandle = floatingTip.querySelector('.drag-handle');
+    let drag = null;
+
+    function moveTip(left, top) {
+      const maxLeft = Math.max(0, document.documentElement.clientWidth - floatingTip.offsetWidth);
+      const maxTop = Math.max(0, window.innerHeight - floatingTip.offsetHeight);
+      floatingTip.style.left = `${Math.min(Math.max(0, left), maxLeft)}px`;
+      floatingTip.style.top = `${Math.min(Math.max(0, top), maxTop)}px`;
+      floatingTip.style.right = 'auto';
+      floatingTip.style.bottom = 'auto';
+    }
+
+    dragHandle.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || drag) return;
+      const bounds = floatingTip.getBoundingClientRect();
+      drag = { pointerId: event.pointerId, offsetX: event.clientX - bounds.left, offsetY: event.clientY - bounds.top };
+      dragHandle.setPointerCapture(event.pointerId);
+      floatingTip.classList.add('is-dragging');
+    });
+
+    dragHandle.addEventListener('pointermove', (event) => {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      moveTip(event.clientX - drag.offsetX, event.clientY - drag.offsetY);
+    });
+
+    function stopDragging(event) {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      drag = null;
+      floatingTip.classList.remove('is-dragging');
+      if (dragHandle.hasPointerCapture(event.pointerId)) {
+        dragHandle.releasePointerCapture(event.pointerId);
+      }
+    }
+
+    dragHandle.addEventListener('pointerup', stopDragging);
+    dragHandle.addEventListener('pointercancel', stopDragging);
+    dragHandle.addEventListener('lostpointercapture', stopDragging);
+
+    dragHandle.addEventListener('keydown', (event) => {
+      const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+      const direction = directions[event.key];
+      if (!direction) return;
+      event.preventDefault();
+      const bounds = floatingTip.getBoundingClientRect();
+      const step = event.shiftKey ? 40 : 10;
+      moveTip(bounds.left + direction[0] * step, bounds.top + direction[1] * step);
+    });
+
+    window.addEventListener('resize', () => {
+      const bounds = floatingTip.getBoundingClientRect();
+      moveTip(bounds.left, bounds.top);
+    });
+  </script>
+
 </body>
 
