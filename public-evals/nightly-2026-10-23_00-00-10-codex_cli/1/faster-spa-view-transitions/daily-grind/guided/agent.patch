+  <script type="module">
+    const host = document.getElementById('views');
+    const home = document.getElementById('home-view');
+    const cards = [...home.querySelectorAll('.card')];
+    const products = new Map(cards.map(card => [
+      new URL(card.querySelector('a').href).hash.slice(1), card
+    ]));
+    // A fixed set of five routes bounds memory use. Each view is built only once.
+    const views = new Map([['/', home]]);
+    const pageTitle = document.title;
+    let activeView = home;
+
+    function getView(route) {
+      if (views.has(route)) return views.get(route);
+      const view = document.createElement('section');
+      view.className = 'spa-view inactive';
+      view.tabIndex = -1;
+      view.dataset.route = route;
+      view.inert = true;
+      view.setAttribute('aria-hidden', 'true');
+
+      const content = document.createElement('div');
+      content.className = 'container';
+      const heading = document.createElement('h1');
+      heading.textContent = route === '/menu'
+        ? 'Our Menu'
+        : products.get(route).querySelector('h3').textContent;
+      view.setAttribute('aria-label', heading.textContent);
+      content.append(heading);
+
+      if (route === '/menu') {
+        const grid = document.createElement('div');
+        grid.className = 'grid';
+        grid.append(...cards.map(card => card.cloneNode(true)));
+        content.append(grid);
+      } else {
+        content.append(products.get(route).querySelector('p').cloneNode(true));
+      }
+
+      const back = document.createElement('a');
+      back.className = 'btn';
+      back.href = route === '/menu' ? '#/' : '#/menu';
+      back.textContent = route === '/menu' ? 'Back to Home' : 'Back to Menu';
+      content.append(back);
+      view.append(content);
+      host.append(view);
+      views.set(route, view);
+      return view;
+    }
+
+    function navigate({ initial = false } = {}) {
+      const requested = location.hash.slice(1) || '/';
+      const route = requested === '/' || requested === '/menu' || products.has(requested)
+        ? requested : '/';
+      const nextView = getView(route);
+      if (nextView !== activeView) {
+        activeView.classList.add('inactive');
+        activeView.inert = true;
+        activeView.setAttribute('aria-hidden', 'true');
+        nextView.classList.remove('inactive');
+        nextView.inert = false;
+        nextView.removeAttribute('aria-hidden');
+        activeView = nextView;
+        // Focus after revealing the view, including during history navigation.
+        nextView.focus({ preventScroll: true });
+        window.scrollTo(0, 0);
+      } else if (!initial) {
+        nextView.focus({ preventScroll: true });
+      }
+      document.title = route === '/' ? pageTitle : `${nextView.getAttribute('aria-label')} | The Daily Grind`;
+      const menuLink = document.querySelector('nav a[href="#/menu"]');
+      if (route.startsWith('/menu')) menuLink.setAttribute('aria-current', 'page');
+      else menuLink.removeAttribute('aria-current');
+    }
+
+    window.addEventListener('hashchange', () => navigate());
+    navigate({ initial: true });
+  </script>
+
