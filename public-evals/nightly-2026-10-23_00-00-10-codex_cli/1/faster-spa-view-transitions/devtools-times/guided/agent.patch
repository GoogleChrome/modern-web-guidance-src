diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..260e716
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,62 @@
+// Retain live view nodes inside Astro's persistent main element. Keeping them
+// connected also prevents Astro from unmounting their hydrated React islands.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const viewKey = (url: URL) => url.pathname + url.search;
+
+document.addEventListener("astro:before-swap", (event) => {
+  const container = document.querySelector<HTMLElement>("main[data-view-cache]");
+  const incoming = event.newDocument.querySelector<HTMLElement>(
+    "main[data-view-cache] > [data-view]",
+  );
+
+  // Pages outside the shared layout retain Astro's normal navigation behavior.
+  if (!container || !incoming) {
+    views.clear();
+    return;
+  }
+
+  const swap = event.swap;
+  event.swap = () => {
+    if (event.signal.aborted) return;
+
+    const outgoing = container.querySelector<HTMLElement>(
+      ":scope > [data-view]:not([hidden])",
+    );
+    const fromKey = viewKey(event.from);
+    const toKey = viewKey(event.to);
+
+    if (outgoing) {
+      if (outgoing.dataset.cacheable === "true") {
+        views.delete(fromKey);
+        views.set(fromKey, outgoing);
+        outgoing.hidden = true;
+        outgoing.inert = true;
+      } else {
+        outgoing.remove();
+      }
+    }
+
+    // Non-cacheable destinations always use fresh server content.
+    const cached = incoming.dataset.cacheable === "true" ? views.get(toKey) : undefined;
+    const next = cached ?? incoming;
+
+    // Preserve Astro's head/script handling and its feature-detected atomic
+    // moves for transition:persist. Update content before scroll restoration.
+    swap();
+    if (!cached) container.appendChild(next);
+    next.hidden = false;
+    next.inert = false;
+
+    views.delete(toKey);
+    if (next.dataset.cacheable === "true") views.set(toKey, next);
+
+    // Map insertion order provides least-recently-used eviction. Remove nodes
+    // before astro:after-swap so Astro can clean up evicted React islands.
+    while (views.size > MAX_VIEWS) {
+      const oldestKey = views.keys().next().value!;
+      views.get(oldestKey)!.remove();
+      views.delete(oldestKey);
+    }
+  };
+});
