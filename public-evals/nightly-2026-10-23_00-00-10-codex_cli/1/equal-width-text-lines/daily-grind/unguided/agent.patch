+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = heroHeading.querySelectorAll('.hero-heading-line');
+
+    function fitHeroHeading() {
+      const width = heroHeading.clientWidth;
+      if (!width) return;
+
+      headingLines.forEach((line) => {
+        line.style.fontSize = '100px';
+        const measuredWidth = line.getBoundingClientRect().width;
+        if (measuredWidth) {
+          line.style.fontSize = `${100 * width / measuredWidth}px`;
+        }
+      });
+    }
+
+    fitHeroHeading();
+    new ResizeObserver(fitHeroHeading).observe(heroHeading);
+    document.fonts.ready.then(fitHeroHeading);
+  </script>
