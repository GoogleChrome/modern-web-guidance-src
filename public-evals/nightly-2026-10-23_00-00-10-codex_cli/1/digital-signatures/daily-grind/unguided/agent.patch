index 0000000..3b72ef1
--- /dev/null
+++ b/signing.mjs
@@ -0,0 +1,54 @@
+const encoder = new TextEncoder();
+const algorithm = { name: 'ECDSA', namedCurve: 'P-256' };
+const signatureAlgorithm = { name: 'ECDSA', hash: 'SHA-256' };
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+export async function generateKeys() {
+  return crypto.subtle.generateKey(algorithm, false, ['sign', 'verify']);
+}
+export async function publicJwk(key) {
+  const jwk = await crypto.subtle.exportKey('jwk', key);
+  return { kty: jwk.kty, crv: jwk.crv, x: jwk.x, y: jwk.y };
+}
+export async function fingerprint(jwk) {
+  const bytes = await crypto.subtle.digest('SHA-256', encoder.encode(canonical({ kty: jwk.kty, crv: jwk.crv, x: jwk.x, y: jwk.y })));
+  return Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+const toBase64 = buffer => btoa(String.fromCharCode(...new Uint8Array(buffer)));
+function validatePayload(payload) {
+  if (!payload || !['receipt', 'voucher'].includes(payload.type) || payload.issuer !== 'The Daily Grind' || payload.demo !== true || payload.currency !== 'USD') throw new Error('This is not a supported Daily Grind demo document.');
+  for (const key of ['reference', 'customer', 'issuedAt']) {
+    if (typeof payload[key] !== 'string' || !payload[key].trim() || payload[key].length > 100) throw new Error('The document contains invalid details.');
+  }
+  if (!Number.isFinite(Date.parse(payload.issuedAt)) || !Number.isSafeInteger(payload.totalCents) || payload.totalCents <= 0 || payload.totalCents > 1000000) throw new Error('The date or total is invalid.');
+  if (payload.type === 'receipt' && (typeof payload.item !== 'string' || payload.item.length > 100 || !Number.isInteger(payload.quantity) || payload.quantity < 1 || payload.quantity > 99 || !Number.isSafeInteger(payload.unitCents) || payload.unitCents <= 0 || payload.totalCents !== payload.unitCents * payload.quantity)) throw new Error('The receipt line items do not match its total.');
+  if (payload.type === 'voucher' && (typeof payload.sender !== 'string' || payload.sender.length > 80 || typeof payload.message !== 'string' || payload.message.length > 160)) throw new Error('The gift voucher details are invalid.');
+}
+export async function signDocument(payload, keys) {
+  validatePayload(payload);
+  const envelope = { format: 'daily-grind/signed-document', version: 1, algorithm: 'ECDSA-P256-SHA256', publicKey: await publicJwk(keys.publicKey), payload };
+  // Sign the complete envelope, including the version, algorithm, and issuer key.
+  const signature = await crypto.subtle.sign(signatureAlgorithm, keys.privateKey, encoder.encode(canonical(envelope)));
+  return { ...envelope, signature: toBase64(signature) };
+}
+export async function verifyDocument(document, trustedPublicKey) {
+  if (!document || document.format !== 'daily-grind/signed-document' || document.version !== 1 || document.algorithm !== 'ECDSA-P256-SHA256' || typeof document.signature !== 'string') throw new Error('Unsupported signed document. Please upload a Daily Grind signed JSON file.');
+  const expectedKeys = ['algorithm', 'format', 'payload', 'publicKey', 'signature', 'version'];
+  if (Object.keys(document).sort().join() !== expectedKeys.join()) throw new Error('The signed document has unexpected fields.');
+  validatePayload(document.payload);
+  const { signature, ...envelope } = document;
+  const jwk = document.publicKey;
+  if (!jwk || jwk.kty !== 'EC' || jwk.crv !== 'P-256' || typeof jwk.x !== 'string' || typeof jwk.y !== 'string' || 'd' in jwk) throw new Error('Invalid public verification key.');
+  let signatureBytes;
+  try { signatureBytes = Uint8Array.from(atob(signature), char => char.charCodeAt(0)); } catch { throw new Error('The digital signature is malformed.'); }
+  if (signatureBytes.length !== 64) throw new Error('The digital signature is malformed.');
+  const key = await crypto.subtle.importKey('jwk', jwk, algorithm, false, ['verify']);
+  const valid = await crypto.subtle.verify(signatureAlgorithm, key, signatureBytes, encoder.encode(canonical(envelope)));
+  if (!valid) throw new Error('Signature verification failed. This document has been changed or its signature is invalid.');
+  const keyId = await fingerprint(jwk);
+  const trusted = !!trustedPublicKey && keyId === await fingerprint(await publicJwk(trustedPublicKey));
+  return { valid: true, trusted, keyId, payload: document.payload };
+}
