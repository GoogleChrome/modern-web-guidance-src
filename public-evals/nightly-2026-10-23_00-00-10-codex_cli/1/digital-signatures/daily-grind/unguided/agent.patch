+import { generateKeys, publicJwk, fingerprint, signDocument, verifyDocument } from './signing.mjs';
+const $ = id => document.getElementById(id);
+let keys, keyId, signedDocument, type = 'receipt', revision = 0, noticeTimer;
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+function notify(message) {
+  $('toast').textContent = message;
+  $('toast').hidden = false;
+  clearTimeout(noticeTimer);
+  noticeTimer = setTimeout(() => { $('toast').hidden = true; }, 5000);
+}
+function status(signed) {
+  const element = $('receipt-status');
+  element.classList.toggle('signed', signed);
+  element.querySelector('strong').textContent = signed ? 'Digitally signed & sealed' : 'Ready for your signature';
+  element.querySelector('span').textContent = signed ? 'Integrity protected · Signed by this browser' : 'Make it official with a digital signature.';
+  $('receipt-id').textContent = signed ? `KEY ${keyId.slice(0, 24)} · ECDSA P-256` : 'CRAFTED WITH CARE. SIGNED WITH CONFIDENCE.';
+}
+function details() {
+  const quantity = Number($('quantity').value);
+  const unitCents = Math.round(Number($('coffee').value) * 100);
+  const payload = { type, issuer: 'The Daily Grind', demo: true, currency: 'USD', customer: $('customer').value.trim(), reference: $('reference').value.trim(), issuedAt: new Date().toISOString(), totalCents: type === 'receipt' ? unitCents * quantity : Math.round(Number($('gift-value').value) * 100) };
+  if (type === 'receipt') Object.assign(payload, { item: $('coffee').selectedOptions[0].text, quantity, unitCents });
+  else Object.assign(payload, { sender: $('sender').value.trim(), message: $('message').value.trim() });
+  return payload;
+}
+function updatePreview() {
+  revision++;
+  signedDocument = null;
+  $('download-document').disabled = true;
+  $('verify-current').disabled = true;
+  $('verify-result').hidden = true;
+  const payload = details();
+  $('preview-name').textContent = payload.customer || 'Your name';
+  $('preview-ref').textContent = payload.reference || 'Your reference';
+  $('preview-date').textContent = new Date(payload.issuedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
+  $('document-title').textContent = type === 'receipt' ? 'ORDER RECEIPT' : 'GIFT VOUCHER · DEMO';
+  $('preview-item').textContent = type === 'receipt' ? `${payload.item} × ${payload.quantity || 0}` : 'A little coffee, on me';
+  $('preview-price').textContent = money(payload.totalCents || 0);
+  $('preview-total').textContent = money(payload.totalCents || 0);
+  $('total-label').textContent = type === 'receipt' ? 'Total paid' : 'Gift value (demo)';
+  $('preview-time').textContent = type === 'receipt' ? 'Made just for you' : `From ${payload.sender || 'someone special'}`;
+  $('preview-message').hidden = type !== 'voucher' || !payload.message;
+  $('preview-message').textContent = payload.message || '';
+  status(false);
+}
+function setType(next) {
+  type = next;
+  document.querySelectorAll('[data-type]').forEach(button => {
+    const selected = button.dataset.type === type;
+    button.classList.toggle('selected', selected);
+    button.setAttribute('aria-pressed', String(selected));
+  });
+  $('receipt-fields').hidden = type !== 'receipt';
+  $('voucher-fields').hidden = type !== 'voucher';
+  $('quantity').disabled = type !== 'receipt';
+  $('gift-value').disabled = type !== 'voucher';
+  $('gift-value').required = type === 'voucher';
+  $('name-label').textContent = type === 'receipt' ? 'Customer name' : 'Recipient name';
+  $('reference-label').textContent = type === 'receipt' ? 'Order reference' : 'Voucher reference';
+  $('reference').value = type === 'receipt' ? 'DG-1042' : 'GIFT-1042';
+  $('form-heading').textContent = type === 'receipt' ? 'The details of your daily' : 'A little good, for someone else';
+  $('form-description').textContent = type === 'receipt' ? 'A small record of a very good coffee.' : 'Give them a reason to take a coffee break.';
+  $('sign-button').childNodes.forEach(node => { if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) node.textContent = type === 'receipt' ? ' Sign receipt ' : ' Sign gift voucher '; });
+  updatePreview();
+}
+function setTab(next, focus = false) {
+  for (const name of ['create', 'verify']) {
+    const selected = name === next;
+    const tab = $(name + '-tab');
+    tab.classList.toggle('selected', selected);
+    tab.setAttribute('aria-selected', String(selected));
+    tab.tabIndex = selected ? 0 : -1;
+    $(name + '-panel').hidden = !selected;
+  }
+  if (focus) $(next + '-tab').focus();
+}
+for (const name of ['create', 'verify']) {
+  $(name + '-tab').addEventListener('click', () => setTab(name));
+  $(name + '-tab').addEventListener('keydown', event => {
+    if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+      event.preventDefault();
+      setTab(event.key === 'Home' ? 'create' : event.key === 'End' ? 'verify' : name === 'create' ? 'verify' : 'create', true);
+    }
+  });
+}
+document.querySelectorAll('[data-type]').forEach(button => button.addEventListener('click', () => setType(button.dataset.type)));
+$('sign-form').addEventListener('input', updatePreview);
+$('sign-form').addEventListener('change', updatePreview);
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!keys || !$('sign-form').reportValidity()) return;
+  const currentRevision = revision;
+  $('sign-button').disabled = true;
+  $('sign-button').setAttribute('aria-busy', 'true');
+  try {
+    const result = await signDocument(details(), keys);
+    if (currentRevision !== revision) { notify('Details changed while signing. Please sign again.'); return; }
+    signedDocument = result;
+    status(true);
+    $('download-document').disabled = false;
+    $('verify-current').disabled = false;
+    notify(type === 'receipt' ? 'Your receipt is signed and ready to download.' : 'Your demo gift voucher is signed and ready to download.');
+  } catch (error) { notify(error.message || 'Unable to sign this document.'); }
+  finally { $('sign-button').disabled = false; $('sign-button').removeAttribute('aria-busy'); }
+});
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download-document').addEventListener('click', () => {
+  if (signedDocument) download(signedDocument, `daily-grind-${signedDocument.payload.type}-${signedDocument.payload.reference.replace(/[^a-zA-Z0-9_-]/g, '_')}.json`);
+});
+$('export-key').addEventListener('click', async () => {
+  try { download({ format: 'daily-grind/public-key', algorithm: 'ECDSA-P256-SHA256', keyId, publicKey: await publicJwk(keys.publicKey) }, 'daily-grind-public-key.json'); }
+  catch { notify('Unable to export the public key. Please try again.'); }
+});
+let verificationId = 0;
+async function verify(value) {
+  const operation = ++verificationId;
+  const result = $('verify-result');
+  result.hidden = false;
+  result.className = 'verification-result';
+  result.textContent = 'Checking the digital signature…';
+  try {
+    const checked = await verifyDocument(value, keys?.publicKey);
+    if (operation !== verificationId) return;
+    result.className = `verification-result${checked.trusted ? '' : ' warning'}`;
+    result.textContent = checked.trusted ? `Signature verified. ${checked.payload.reference} · ${money(checked.payload.totalCents)}. The document is unchanged and was signed by this browser’s key. This is a local demo, not proof of merchant issuance.` : `Signature valid · issuer untrusted. ${checked.payload.reference} is unchanged, but its signing key is not this browser’s key. Confirm the issuer’s public key through an independent trusted channel before relying on it.`;
+  } catch (error) {
+    if (operation !== verificationId) return;
+    result.className = 'verification-result error';
+    result.textContent = error.message || 'Unable to verify this document. Check the file and try again.';
+  }
+}
+async function verifyFile(file) {
+  if (!file) return;
+  if (file.size > 1024 * 1024) { showFileError('That file is too large. Please choose a signed JSON file under 1 MB.'); return; }
+  try { const value = JSON.parse(await file.text()); await verify(value); }
+  catch { showFileError('We couldn’t read that document. Please choose a valid signed JSON file.'); }
+}
+function showFileError(message) {
+  verificationId++;
+  $('verify-result').hidden = false;
+  $('verify-result').className = 'verification-result error';
+  $('verify-result').textContent = message;
+}
+$('verify-file').addEventListener('change', event => { verifyFile(event.target.files[0]); event.target.value = ''; });
+$('verify-current').addEventListener('click', () => { if (signedDocument) verify(signedDocument); });
+const dropZone = $('drop-zone');
+for (const eventName of ['dragenter', 'dragover']) dropZone.addEventListener(eventName, event => { event.preventDefault(); dropZone.classList.add('dragging'); });
+for (const eventName of ['dragleave', 'drop']) dropZone.addEventListener(eventName, event => { event.preventDefault(); dropZone.classList.remove('dragging'); });
+dropZone.addEventListener('drop', event => verifyFile(event.dataTransfer.files[0]));
+document.querySelectorAll('[data-coffee]').forEach(button => button.addEventListener('click', () => {
+  setTab('create');
+  setType('receipt');
+  $('coffee').value = button.dataset.coffee;
+  updatePreview();
+  $('workspace').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
+  notify('Your coffee is selected. Add your details and sign your receipt.');
+}));
+async function openKeyStore() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Key storage is blocked.'));
+  });
+}
+async function storedKeys(db) {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction('keys', 'readonly');
+    const request = transaction.objectStore('keys').get('ecdsa-p256');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+async function saveKeys(db, pair) {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction('keys', 'readwrite');
+    // Read and write in one transaction so concurrent tabs keep the same issuer.
+    const store = transaction.objectStore('keys');
+    const request = store.get('ecdsa-p256');
+    let chosen = pair;
+    request.onsuccess = () => { if (request.result) chosen = request.result; else store.put(pair, 'ecdsa-p256'); };
+    transaction.oncomplete = () => resolve(chosen);
+    transaction.onerror = () => reject(transaction.error);
+    transaction.onabort = () => reject(transaction.error);
+  });
+}
+async function initialize() {
+  setType('receipt');
+  setTab('create');
+  if (!globalThis.crypto?.subtle) {
+    $('key-status').textContent = 'Signing requires HTTPS and a browser with Web Crypto.';
+    $('verify-current').disabled = true;
+    $('verify-file').disabled = true;
+    return;
+  }
+  let persistent = true;
+  let db;
+  try {
+    db = await openKeyStore();
+    keys = await storedKeys(db);
+    if (!keys) keys = await saveKeys(db, await generateKeys());
+  } catch {
+    persistent = false;
+    try { keys = await generateKeys(); }
+    catch { $('key-status').textContent = 'Unable to create a signing key in this browser.'; return; }
+  } finally { db?.close(); }
+  try {
+    keyId = await fingerprint(await publicJwk(keys.publicKey));
+    $('key-status').textContent = `${persistent ? 'Browser key ready' : 'Session-only key ready'} · ${keyId.slice(0, 8)}…`;
+    $('key-status').title = `Public key SHA-256 fingerprint: ${keyId}. ${persistent ? 'Stored on this device. Clearing site data removes this key.' : 'Storage unavailable. This key will be lost on reload.'}`;
+    if (!persistent) notify('Browser storage is unavailable. Your signing key lasts only for this page session.');
+    $('sign-button').disabled = false;
+    $('export-key').disabled = false;
+  } catch { $('key-status').textContent = 'Unable to prepare the signing key. Try reloading.'; }
+}
+initialize();
