index 0000000..441ef21
--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,61 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeys, signDocument, verifyDocument, canonical, publicJwk } from '../signing.mjs';
+const keys = await generateKeys();
+const otherKeys = await generateKeys();
+const receipt = { type: 'receipt', issuer: 'The Daily Grind', demo: true, currency: 'USD', reference: 'DG-1042', customer: 'Alex Morgan', issuedAt: '2026-10-23T12:00:00.000Z', item: 'Maple Oat Latte', unitCents: 550, quantity: 2, totalCents: 1100 };
+const signed = await signDocument(receipt, keys);
+test('signed receipt verifies against its known browser key', async () => {
+  const result = await verifyDocument(JSON.parse(JSON.stringify(signed)), keys.publicKey);
+  assert.equal(result.valid, true);
+  assert.equal(result.trusted, true);
+  assert.equal(result.payload.totalCents, 1100);
+});
+test('a valid signature from another browser never implies a trusted issuer', async () => {
+  const result = await verifyDocument(signed, otherKeys.publicKey);
+  assert.equal(result.valid, true);
+  assert.equal(result.trusted, false);
+  assert.equal((await verifyDocument(signed)).trusted, false);
+});
+test('changing receipt details invalidates its signature', async () => {
+  const tampered = structuredClone(signed);
+  tampered.payload.customer = 'Someone else';
+  await assert.rejects(verifyDocument(tampered, keys.publicKey), /verification failed/);
+});
+test('changing totals and line items consistently still invalidates the signature', async () => {
+  const tampered = structuredClone(signed);
+  tampered.payload.unitCents = 1;
+  tampered.payload.totalCents = 2;
+  await assert.rejects(verifyDocument(tampered, keys.publicKey), /verification failed/);
+});
+test('replacing the embedded verification key fails', async () => {
+  const tampered = structuredClone(signed);
+  tampered.publicKey = await publicJwk(otherKeys.publicKey);
+  await assert.rejects(verifyDocument(tampered, keys.publicKey), /verification failed/);
+});
+test('private signing key cannot be exported', async () => {
+  assert.equal(keys.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', keys.privateKey));
+  assert.equal('d' in await publicJwk(keys.publicKey), false);
+});
+test('gift vouchers round trip and protect the recipient, message, and value', async () => {
+  const gift = { type: 'voucher', issuer: 'The Daily Grind', demo: true, currency: 'USD', reference: 'GIFT-1042', customer: 'Alex', sender: 'Jamie', message: 'Your next coffee is on me.', totalCents: 2500, issuedAt: receipt.issuedAt };
+  const document = await signDocument(gift, keys);
+  assert.equal((await verifyDocument(document, keys.publicKey)).trusted, true);
+  for (const field of ['customer', 'sender', 'message', 'totalCents']) {
+    const changed = structuredClone(document);
+    changed.payload[field] = field === 'totalCents' ? 5000 : 'Changed';
+    await assert.rejects(verifyDocument(changed, keys.publicKey), /verification failed/);
+  }
+});
+test('JSON property order and whitespace do not break valid signatures', async () => {
+  const reordered = Object.fromEntries(Object.entries(signed).reverse());
+  reordered.payload = Object.fromEntries(Object.entries(signed.payload).reverse());
+  assert.equal((await verifyDocument(reordered, keys.publicKey)).valid, true);
+  assert.equal(canonical({ b: 2, a: 1 }), canonical({ a: 1, b: 2 }));
+});
+test('malformed documents and unsupported versions are rejected', async () => {
+  for (const input of [null, {}, { ...signed, version: 2 }, { ...signed, algorithm: 'RSA' }, { ...signed, signature: 'not a signature' }, { ...signed, unsignedExtra: 'data' }, { ...signed, payload: { ...receipt, totalCents: -1 } }]) {
+    await assert.rejects(verifyDocument(input, keys.publicKey));
+  }
+});
