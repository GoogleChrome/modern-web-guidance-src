+const encoder = new TextEncoder();
+const suites = ['ML-DSA-65', 'Ed25519', 'ECDSA'];
+export const canonical = value => {
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  if (value !== null && typeof value === 'object') return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+  return JSON.stringify(value);
+};
+const base64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+const unbase64 = value => Uint8Array.from(atob(value), char => char.charCodeAt(0));
+const keyAlgorithm = suite => suite === 'ECDSA' ? { name: 'ECDSA', namedCurve: 'P-256' } : suite;
+const operation = suite => suite === 'ECDSA' ? { name: suite, hash: 'SHA-256' } : suite;
+export async function fingerprint(publicKey) {
+  const bytes = await crypto.subtle.exportKey('spki', publicKey);
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function createIdentity(preference = 'auto') {
+  if (!globalThis.crypto?.subtle) throw new Error('Secure signing requires HTTPS or localhost and a browser with Web Crypto support.');
+  const choices = preference === 'auto' ? suites : [preference];
+  for (const suite of choices) {
+    if (!suites.includes(suite)) throw new Error('Unsupported signature algorithm.');
+    if (suite.startsWith('ML-DSA') && !globalThis.SubtleCrypto?.supports?.('sign', suite)) continue;
+    try {
+      const keys = await crypto.subtle.generateKey(keyAlgorithm(suite), false, ['sign', 'verify']);
+      return { ...keys, suite, id: await fingerprint(keys.publicKey) };
+    } catch (error) {
+      if (error.name !== 'NotSupportedError' || preference !== 'auto') throw error;
+    }
+  }
+  throw new Error('This signature algorithm is unavailable in your browser. Choose Automatic or ECDSA P-256.');
+}
+export async function exportVerificationKey(identity) {
+  return { format: 'daily-grind-public-key-v1', algorithm: identity.suite, fingerprint: identity.id, spki: base64(await crypto.subtle.exportKey('spki', identity.publicKey)) };
+}
+export async function importVerificationKey(document) {
+  if (document.format !== 'daily-grind-public-key-v1' || !suites.includes(document.algorithm) || typeof document.spki !== 'string' || document.spki.length > 12000) throw new Error('Invalid verification key file.');
+  const publicKey = await crypto.subtle.importKey('spki', unbase64(document.spki), keyAlgorithm(document.algorithm), true, ['verify']);
+  const id = await fingerprint(publicKey);
+  if (id !== document.fingerprint) throw new Error('The public key fingerprint does not match.');
+  return { publicKey, id, suite: document.algorithm };
+}
+function validatePayload(payload) {
+  if (!payload || !['receipt', 'voucher'].includes(payload.type) || payload.issuer !== 'Daily Grind · browser signing demo' || typeof payload.id !== 'string' || !payload.id || !Number.isFinite(Date.parse(payload.issuedAt)) || payload.currency !== 'USD' || !Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0 || payload.amountCents > 10000000) throw new Error('Invalid receipt or gift voucher details.');
+  if (payload.type === 'receipt' && (typeof payload.item !== 'string' || !payload.item || !Number.isInteger(payload.quantity) || payload.quantity < 1 || payload.quantity > 20)) throw new Error('Invalid order details.');
+  if (payload.type === 'voucher' && (typeof payload.recipient !== 'string' || !payload.recipient.trim() || typeof payload.message !== 'string')) throw new Error('Invalid gift voucher details.');
+}
+function signingBytes(unsigned) {
+  // A length-prefixed application context prevents signatures being reused in another protocol.
+  const context = encoder.encode('daily-grind/' + unsigned.payload.type + '/v1');
+  const payload = encoder.encode(canonical(unsigned));
+  const framed = new Uint8Array(1 + context.length + payload.length);
+  framed[0] = context.length;
+  framed.set(context, 1);
+  framed.set(payload, context.length + 1);
+  return framed;
+}
+export async function signDocument(identity, payload) {
+  validatePayload(payload);
+  const unsigned = { version: 1, algorithm: identity.suite, keyId: identity.id, payload };
+  const signature = await crypto.subtle.sign(operation(identity.suite), identity.privateKey, signingBytes(unsigned));
+  return { ...unsigned, signature: base64(signature) };
+}
+export async function verifyDocument(document, trustedIdentity) {
+  if (!document || canonical(Object.keys(document).sort()) !== canonical(['algorithm', 'keyId', 'payload', 'signature', 'version']) || document.version !== 1 || !suites.includes(document.algorithm) || typeof document.signature !== 'string' || document.signature.length > 12000) throw new Error('Invalid signed document format.');
+  validatePayload(document.payload);
+  if (document.keyId !== trustedIdentity.id || document.algorithm !== trustedIdentity.suite) throw new Error('Unknown signer. Select a separately trusted public key matching this document.');
+  const { signature, ...unsigned } = document;
+  return crypto.subtle.verify(operation(document.algorithm), trustedIdentity.publicKey, unbase64(signature), signingBytes(unsigned));
+}
