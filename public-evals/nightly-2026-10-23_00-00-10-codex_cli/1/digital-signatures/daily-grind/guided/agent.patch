diff --git a/tests/signing.test.mjs b/tests/signing.test.mjs
new file mode 100644
index 0000000..5e75b98
--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,50 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createIdentity, signDocument, verifyDocument, exportVerificationKey, importVerificationKey } from '../signing.mjs';
+const receipt = { type: 'receipt', issuer: 'Daily Grind · browser signing demo', id: 'order-123', issuedAt: new Date().toISOString(), currency: 'USD', amountCents: 650, item: 'Maple Oat Latte', quantity: 1 };
+for (const suite of ['ECDSA', 'Ed25519']) {
+  test(suite + ': receipt and voucher verify using independently exported public keys', async () => {
+    const identity = await createIdentity(suite);
+    assert.equal(identity.privateKey.extractable, false);
+    const publicDocument = await exportVerificationKey(identity);
+    assert.equal('privateKey' in publicDocument, false);
+    const trusted = await importVerificationKey(publicDocument);
+    for (const payload of [receipt, { ...receipt, type: 'voucher', recipient: 'Alex', message: 'Enjoy!', amountCents: 2500 }]) {
+      const signed = await signDocument(identity, payload);
+      assert.equal(await verifyDocument(JSON.parse(JSON.stringify(signed)), trusted), true);
+      const edited = structuredClone(signed);
+      edited.payload.amountCents += 100;
+      assert.equal(await verifyDocument(edited, trusted), false);
+      const reordered = { ...signed, payload: Object.fromEntries(Object.entries(payload).reverse()) };
+      assert.equal(await verifyDocument(reordered, trusted), true);
+      const crossType = structuredClone(signed);
+      crossType.payload.type = payload.type === 'receipt' ? 'voucher' : 'receipt';
+      crossType.payload.recipient = 'Alex';
+      crossType.payload.message = 'Enjoy!';
+      assert.equal(await verifyDocument(crossType, trusted), false);
+    }
+  });
+}
+test('rejects unknown signers, substituted keys, tampered fingerprints and malformed documents', async () => {
+  const identity = await createIdentity('ECDSA');
+  const attacker = await createIdentity('ECDSA');
+  const signed = await signDocument(identity, receipt);
+  await assert.rejects(verifyDocument(signed, attacker), /Unknown signer/);
+  const forged = await signDocument(attacker, receipt);
+  forged.keyId = identity.id;
+  assert.equal(await verifyDocument(forged, identity), false);
+  const publicKey = await exportVerificationKey(identity);
+  publicKey.fingerprint = attacker.id;
+  await assert.rejects(importVerificationKey(publicKey), /fingerprint/);
+  await assert.rejects(verifyDocument({ ...signed, extra: true }, identity), /format/);
+  await assert.rejects(verifyDocument({ ...signed, algorithm: 'HMAC' }, identity), /format/);
+  await assert.rejects(signDocument(identity, { ...receipt, amountCents: -1 }), /Invalid/);
+  await assert.rejects(verifyDocument(null, identity), /format/);
+  const altered = structuredClone(signed);
+  altered.signature = altered.signature.slice(4);
+  assert.equal(await verifyDocument(altered, identity), false);
+});
+test('automatic algorithm selection yields working asymmetric signatures', async () => {
+  const identity = await createIdentity();
+  assert.equal(await verifyDocument(await signDocument(identity, receipt), identity), true);
+});
