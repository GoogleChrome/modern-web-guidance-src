@@ -0,0 +1,157 @@
+import { createIdentity, signDocument, verifyDocument, exportVerificationKey, importVerificationKey } from './signing.mjs';
+const $ = id => document.getElementById(id);
+const coffees = { maple: { name: 'Maple Oat Latte', cents: 650, note: 'Oat milk. Vermont maple. A little magic.' }, espresso: { name: 'Dark Roast Espresso', cents: 350, note: 'Deep, smoky, and ready when you are.' }, cold: { name: 'Cold Brew', cents: 500, note: 'Slow-steeped for 18 hours. Smooth by nature.' } };
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+let identity, trustedIdentity, signed, importedTrust = false, busy = false;
+const type = () => document.querySelector('input[name=type]:checked').value;
+const status = (message, error = false) => { $('status').textContent = message; $('status').classList.toggle('error', error); };
+function invalidate() {
+  signed = undefined;
+  $('download-document').disabled = $('check-document').disabled = true;
+  $('signature-seal').classList.remove('signed');
+  $('seal-title').textContent = 'Ready for your signature';
+  $('seal-subtitle').textContent = 'A little proof that it’s authentically yours.';
+  $('document-id').textContent = 'CRAFTED WITH CARE • THE DAILY GRIND';
+}
+function preview() {
+  invalidate();
+  const voucher = type() === 'voucher';
+  $('receipt-fields').hidden = voucher;
+  $('voucher-fields').hidden = !voucher;
+  $('quantity').required = !voucher;
+  $('recipient').required = voucher;
+  $('amount').required = voucher;
+  ['coffee', 'quantity'].forEach(id => $(id).disabled = voucher);
+  ['recipient', 'amount', 'message'].forEach(id => $(id).disabled = !voucher);
+  const coffee = coffees[$('coffee').value];
+  const quantity = Number($('quantity').value) || 1;
+  const total = voucher ? Number($('amount').value) * 100 : coffee.cents * quantity;
+  $('preview-type').textContent = voucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT';
+  $('preview-item').textContent = voucher ? 'A coffee for ' + ($('recipient').value.trim() || 'someone special') : (quantity > 1 ? quantity + ' × ' : '') + coffee.name;
+  $('preview-note').textContent = voucher ? $('message').value || 'The next coffee is on me.' : coffee.note;
+  $('preview-price').textContent = money(total);
+  $('preview-total').textContent = money(total);
+  $('sign-button').innerHTML = '<span aria-hidden="true">♧</span> Sign ' + (voucher ? 'gift voucher' : 'coffee receipt') + '<span aria-hidden="true">↗</span>';
+  $('preview-date').textContent = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
+}
+function setTrust(key, imported = false) {
+  trustedIdentity = key;
+  importedTrust = imported;
+  $('verification-result').hidden = true;
+  $('verification-source').textContent = imported ? 'Checking against your imported trusted key: ' + key.id : 'Checking against this session’s signing key.';
+  $('trusted-key-info').textContent = (imported ? 'Imported verification key: ' + key.id + '. ' : '') + 'Only use a key obtained directly from a signer you trust. Compare its full fingerprint through a separate trusted channel. A key included with an unknown document does not establish issuer identity.';
+}
+async function setupIdentity() {
+  if (busy) return;
+  busy = true;
+  $('algorithm').disabled = true;
+  identity = undefined;
+  $('sign-button').disabled = $('export-key').disabled = true;
+  invalidate();
+  status('Preparing your secure signing key…');
+  try {
+    identity = await createIdentity($('algorithm').value);
+    if (!importedTrust) setTrust(identity);
+    $('key-fingerprint').textContent = identity.id;
+    $('key-summary').textContent = identity.suite === 'ML-DSA-65' ? 'Quantum-resistant · ML-DSA-65' : 'Classical · ' + (identity.suite === 'ECDSA' ? 'ECDSA P-256' : identity.suite);
+    status('Signing key ready · ' + identity.suite + '. Nothing leaves your browser.');
+    $('sign-button').disabled = $('export-key').disabled = false;
+    $('verify-button').disabled = !trustedIdentity;
+  } catch (error) {
+    $('key-summary').textContent = 'Signing unavailable';
+    $('key-fingerprint').textContent = 'No active signing key';
+    if (!importedTrust) { trustedIdentity = undefined; $('verify-button').disabled = true; }
+    status(error.message, true);
+  } finally { busy = false; $('algorithm').disabled = false; }
+}
+function selectTab(verify) {
+  ['create', 'verify'].forEach(name => {
+    const selected = (name === 'verify') === verify;
+    $(name + '-tab').setAttribute('aria-selected', String(selected));
+    $(name + '-tab').tabIndex = selected ? 0 : -1;
+    $(name + '-panel').hidden = !selected;
+  });
+}
+$('create-tab').onclick = () => selectTab(false);
+$('verify-tab').onclick = () => selectTab(true);
+document.querySelector('.tabs').addEventListener('keydown', event => {
+  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+  event.preventDefault();
+  const verify = event.key === 'End' || (event.key !== 'Home' && $('verify-tab').getAttribute('aria-selected') !== 'true');
+  selectTab(verify);
+  $(verify ? 'verify-tab' : 'create-tab').focus();
+});
+$('sign-form').addEventListener('input', event => { if (event.target.id !== 'algorithm') { preview(); status(identity ? 'Details updated. Sign to seal this version.' : 'Choose a supported signature algorithm.', !identity); } });
+$('algorithm').addEventListener('change', setupIdentity);
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!identity || busy) return;
+  busy = true;
+  const signingIdentity = identity;
+  const controls = [...$('sign-form').elements].filter(control => !control.disabled);
+  controls.forEach(control => control.disabled = true);
+  try {
+    const voucher = type() === 'voucher';
+    const coffee = coffees[$('coffee').value];
+    const payload = { type: type(), issuer: 'Daily Grind · browser signing demo', id: crypto.randomUUID(), issuedAt: new Date().toISOString(), currency: 'USD', amountCents: voucher ? Number($('amount').value) * 100 : coffee.cents * Number($('quantity').value), ...(voucher ? { recipient: $('recipient').value.trim(), message: $('message').value } : { item: coffee.name, quantity: Number($('quantity').value) }) };
+    signed = await signDocument(signingIdentity, payload);
+    $('signature-seal').classList.add('signed');
+    $('seal-title').textContent = 'Digitally signed & sealed';
+    $('seal-subtitle').textContent = signingIdentity.suite + ' · ' + signingIdentity.id.slice(0, 16) + '…';
+    $('document-id').textContent = 'ID ' + payload.id;
+    $('download-document').disabled = $('check-document').disabled = false;
+    status('Document signed. Save your document and public verification key.');
+  } catch (error) { status(error.message, true); }
+  finally { controls.forEach(control => control.disabled = false); busy = false; }
+});
+function download(name, object) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(object, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url; link.download = name; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download-document').onclick = () => { if (signed) download('daily-grind-' + signed.payload.type + '-' + signed.payload.id + '.json', signed); };
+$('export-key').onclick = async () => { try { if (identity) download('daily-grind-public-key-' + identity.id.slice(0, 12) + '.json', await exportVerificationKey(identity)); } catch (error) { status(error.message, true); } };
+async function readFile(file) {
+  if (!file) return null;
+  if (file.size > 100000) throw new Error('Please choose a JSON file smaller than 100 KB.');
+  return file.text();
+}
+$('document-file').onchange = async event => {
+  $('verification-result').hidden = true;
+  try { const value = await readFile(event.target.files[0]); if (value !== null) $('document-json').value = value; }
+  catch (error) { status(error.message, true); }
+};
+$('document-json').oninput = () => $('verification-result').hidden = true;
+$('key-file').onchange = async event => {
+  try {
+    const text = await readFile(event.target.files[0]);
+    if (text === null) return;
+    const key = await importVerificationKey(JSON.parse(text));
+    setTrust(key, true); $('verify-button').disabled = false;
+    status('Public key loaded. Compare the fingerprint with your signer before relying on it.');
+  } catch (error) { status('Could not import key: ' + error.message, true); }
+  event.target.value = '';
+};
+$('reset-key').onclick = () => { if (identity) { setTrust(identity); $('verify-button').disabled = false; status('Verification now uses this session’s key.'); } else status('Choose a supported algorithm to create a session key first.', true); };
+async function verify() {
+  const result = $('verification-result');
+  result.hidden = true;
+  $('verify-button').disabled = true;
+  try {
+    if (!trustedIdentity) throw new Error('Load a separately trusted public verification key first.');
+    const text = $('document-json').value;
+    if (text.length > 100000) throw new Error('The document exceeds the 100 KB limit.');
+    let doc;
+    try { doc = JSON.parse(text); } catch { throw new Error('Choose a signed JSON file or paste valid JSON to continue.'); }
+    if (!await verifyDocument(doc, trustedIdentity)) throw new Error('Signature does not match. This document may have been changed.');
+    result.classList.remove('error');
+    result.textContent = '✓ Signature verified\n' + (doc.payload.type === 'voucher' ? 'Gift voucher' : 'Coffee receipt') + ' · ' + money(doc.payload.amountCents) + '\nAll signed details are intact. Signer key: ' + trustedIdentity.id + '\nBrowser demo only. This is not proof of purchase or voucher redemption eligibility.';
+  } catch (error) { result.classList.add('error'); result.textContent = 'Verification failed\n' + error.message; }
+  finally { result.hidden = false; $('verify-button').disabled = !trustedIdentity; }
+}
+$('verify-button').onclick = verify;
+$('check-document').onclick = () => { if (!signed) return; $('document-json').value = JSON.stringify(signed, null, 2); selectTab(true); verify(); };
+document.querySelectorAll('[data-coffee]').forEach(button => button.onclick = () => { $('coffee').value = button.dataset.coffee; document.querySelector('input[value=receipt]').checked = true; selectTab(false); preview(); $('studio').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' }); });
+preview();
+setupIdentity();
