diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..6e5e5e4
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,42 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** showModal provides background inertness, focus containment and Escape dismissal. */
+export default function Modal({ id, title, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    const trigger = document.activeElement;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (trigger instanceof HTMLElement && trigger.isConnected) trigger.focus();
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} onClose={onClose}
+      className="app-dialog bg-white shadow-xl w-full max-w-2xl p-4"
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const { left, right, top, bottom } = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) {
+          event.currentTarget.close();
+        }
+      }}>
+      <div className="flex justify-between items-center gap-4 mb-4">
+        <h2 tabIndex={-1} id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <button type="button" autoFocus={id !== 'search-dialog'} aria-label={`Close ${title.toLowerCase()}`}
+          onClick={() => ref.current?.close()} className="p-2 text-gray-600 hover:text-amber-800">✕</button>
+      </div>
+      {children}
+    </dialog>
+  );
+}
