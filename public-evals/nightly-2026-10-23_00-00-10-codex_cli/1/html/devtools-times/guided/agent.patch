--- /dev/null
+++ b/src/components/Popover.tsx
@@ -0,0 +1,19 @@
+import { useId, type ReactNode } from 'react';
+
+export default function Popover({ label, children }: { label: string; children: ReactNode }) {
+  const id = useId();
+  return (
+    <>
+      <button type="button" popoverTarget={id} className="flex items-center gap-1 py-3 whitespace-nowrap hover:text-gray-600">
+        {label}<span aria-hidden="true">⌄</span>
+      </button>
+      <section id={id} popover="auto" aria-label={label} className="navigation-popover">
+        <div className="flex justify-between items-center gap-4 p-4 border-b border-gray-200">
+          <p className="font-semibold">{label}</p>
+          <button type="button" popoverTarget={id} popoverTargetAction="hide" className="p-2">Close</button>
+        </div>
+        {children}
+      </section>
+    </>
+  );
+}
