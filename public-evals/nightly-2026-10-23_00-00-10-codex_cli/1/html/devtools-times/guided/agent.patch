diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..5dfcbe9
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,57 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from 'react';
+
+interface Props {
+  label: string;
+  title: string;
+  icon: ReactNode;
+  children: ReactNode;
+}
+
+export default function ModalDialog({ label, title, icon, children }: Props) {
+  const id = useId();
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const [isOpen, setIsOpen] = useState(false);
+
+  useEffect(() => {
+    if (isOpen && dialogRef.current && !dialogRef.current.open) {
+      dialogRef.current.showModal();
+      dialogRef.current.querySelector<HTMLInputElement>('input[data-dialog-focus]')?.focus();
+    }
+  }, [isOpen]);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    return () => { if (dialog?.open) dialog.close(); };
+  }, []);
+
+  return (
+    <>
+      <button ref={triggerRef} type="button" aria-label={label} aria-haspopup="dialog" aria-controls={id}
+        className="p-2 text-gray-700 hover:text-amber-700" onClick={() => setIsOpen(true)}>
+        {icon}
+      </button>
+      <dialog ref={dialogRef} id={id} aria-labelledby={`${id}-title`} closedBy="any"
+        className="overlay-dialog" onClose={() => {
+          setIsOpen(false);
+          triggerRef.current?.focus();
+        }}
+        onClick={event => {
+          // Preserve backdrop dismissal in browsers without closedby support.
+          if ('closedBy' in HTMLDialogElement.prototype || event.target !== event.currentTarget) return;
+          const bounds = event.currentTarget.getBoundingClientRect();
+          if (event.clientX < bounds.left || event.clientX > bounds.right ||
+              event.clientY < bounds.top || event.clientY > bounds.bottom) event.currentTarget.close();
+        }}>
+        <div className="flex items-center justify-between gap-4 border-b border-gray-200 p-4">
+          <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+          <form method="dialog">
+            <button type="submit" aria-label={`Close ${label.toLowerCase()}`}
+              className="p-2 text-gray-700 hover:text-amber-700">Close</button>
+          </form>
+        </div>
+        {isOpen && children}
+      </dialog>
+    </>
+  );
+}
diff --git a/src/components/Popover.tsx b/src/components/Popover.tsx
new file mode 100644
