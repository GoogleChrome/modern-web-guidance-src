diff --git a/script.js b/script.js
new file mode 100644
index 0000000..452bc4f
--- /dev/null
+++ b/script.js
@@ -0,0 +1,15 @@
+const logoutDialog = document.getElementById('logout-dialog');
+const logoutTrigger = document.getElementById('logout-trigger');
+const logoutFallback = document.getElementById('logout-fallback');
+
+// Preserve navigation without JavaScript or native dialog support.
+if (logoutDialog && logoutTrigger && logoutFallback &&
+    typeof logoutDialog.showModal === 'function') {
+  logoutTrigger.addEventListener('click', () => {
+    logoutDialog.showModal();
+  });
+
+  // The browser contains focus and restores it to the trigger on dismissal.
+  logoutFallback.hidden = true;
+  logoutTrigger.hidden = false;
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..88b8497
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,270 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+.site-header {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 12px 24px;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+.primary-nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px 20px;
+  list-style: none;
+}
+
+.site-header a,
+.site-header button {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+.site-header a:hover,
+.site-header button:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  background: transparent;
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 60vh;
+  background: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+  list-style: none;
+}
+
+.card {
+  height: 100%;
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+.site-footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Discover the decorative photo in HTML, without changing the hero layout. */
+.hero-image,
+.hero::after {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: -1;
+}
+
+.hero-image {
+  object-fit: cover;
+}
+
+.hero::after {
+  content: "";
+  background: rgb(0 0 0 / 50%);
+}
+
+.site-header .logo {
+  font-size: 1.5rem;
+}
+
+button {
+  font: inherit;
+  cursor: pointer;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.footer-links ul {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 8px 0;
+  list-style: none;
+}
+
+:focus-visible {
+  outline: 3px solid #a54800;
+  outline-offset: 4px;
+}
+
+.site-header :focus-visible,
+.hero :focus-visible {
+  outline-color: var(--accent);
+}
+
+.skip-link {
+  position: fixed;
+  top: 12px;
+  left: 12px;
+  z-index: 1001;
+  padding: 10px 20px;
+  background: white;
+  color: var(--text);
+  transform: translateY(calc(-100% - 20px));
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+#main-content {
+  scroll-margin-top: 10rem;
+}
+
+/* Native modal dialogs contain focus and make the background inert. */
+dialog {
+  margin: auto;
+  width: min(30rem, calc(100% - 40px));
+  max-height: calc(100% - 40px);
+  overflow: auto;
+  padding: 24px;
+  color: var(--text);
+  background: var(--light);
+  border: 0;
+  border-radius: 8px;
+}
+
+dialog::backdrop {
+  background: rgb(0 0 0 / 60%);
+}
+
+dialog h2 {
+  margin-bottom: 10px;
+}
+
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  align-items: center;
+  gap: 12px;
+  margin-top: 20px;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+}
+
+.cancel-button {
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  padding: 10px 20px;
+  color: var(--primary);
+  background: white;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .site-header a,
+  .site-header button,
+  .btn {
+    transition: none;
+  }
+}
