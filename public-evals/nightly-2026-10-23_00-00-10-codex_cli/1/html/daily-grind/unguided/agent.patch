diff --git a/main.js b/main.js
new file mode 100644
index 0000000..2b2d87c
--- /dev/null
+++ b/main.js
@@ -0,0 +1,25 @@
+// Keep normal navigation available when native dialogs are unsupported.
+if (typeof HTMLDialogElement !== 'undefined' &&
+    typeof HTMLDialogElement.prototype.showModal === 'function') {
+  for (const trigger of document.querySelectorAll('[data-dialog]')) {
+    const dialog = document.getElementById(trigger.dataset.dialog);
+    if (!(dialog instanceof HTMLDialogElement)) continue;
+
+    // Enhanced links behave as buttons; their href remains a no-script fallback.
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = trigger.className;
+    button.textContent = trigger.textContent;
+    if (trigger.hasAttribute('aria-label')) {
+      button.setAttribute('aria-label', trigger.getAttribute('aria-label'));
+    }
+    button.setAttribute('aria-haspopup', 'dialog');
+    button.setAttribute('aria-controls', dialog.id);
+    trigger.replaceWith(button);
+
+    button.addEventListener('click', () => dialog.showModal());
+    // showModal provides focus containment and Escape handling. Restore focus
+    // explicitly for consistent behavior after both cancellation and form close.
+    dialog.addEventListener('close', () => button.focus({ preventScroll: true }));
+  }
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..1a97134
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,297 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+.site-nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+.site-nav ul {
+  display: flex;
+  list-style: none;
+}
+
+.site-nav ul li {
+  margin-left: 20px;
+}
+
+.site-nav a,
+.site-nav button {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+.site-nav a:hover,
+.site-nav button:hover {
+  color: var(--accent);
+}
+
+.site-nav button {
+  background: transparent;
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 60vh;
+  background: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 10;
+}
+
+.logo {
+  color: white;
+  text-decoration: none;
+}
+
+.hero-image,
+.hero::after {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: -1;
+}
+
+.hero-image {
+  object-fit: cover;
+}
+
+.hero::after {
+  content: "";
+  background: rgb(0 0 0 / 50%);
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  list-style: none;
+}
+
+.grid > li {
+  display: flex;
+}
+
+.card {
+  width: 100%;
+}
+
+.card p {
+  flex: 1;
+}
+
+.footer-links ul {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 8px 20px;
+  list-style: none;
+}
+
+.footer-links a {
+  margin: 0;
+}
+
+:focus-visible {
+  outline: 3px solid #b65b00;
+  outline-offset: 4px;
+}
+
+.site-nav :focus-visible,
+.hero :focus-visible {
+  outline-color: var(--accent);
+}
+
+.skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  z-index: 20;
+  padding: 10px 20px;
+  background: white;
+  color: var(--text);
+  transform: translateY(-160%);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+main {
+  scroll-margin-top: 100px;
+}
+
+dialog {
+  margin: auto;
+  width: min(440px, calc(100% - 40px));
+  max-height: calc(100% - 40px);
+  padding: 28px;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text);
+  background: white;
+}
+
+dialog::backdrop {
+  background: rgb(0 0 0 / 60%);
+}
+
+dialog p {
+  margin-top: 12px;
+}
+
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+button {
+  font: inherit;
+  border: 0;
+  cursor: pointer;
+}
+
+@media (max-width: 640px) {
+  .site-nav {
+    flex-direction: column;
+    gap: 16px;
+  }
+
+  .site-nav ul {
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 12px 20px;
+  }
+
+  .site-nav ul li {
+    margin: 0;
+  }
+
+  .hero h1 {
+    font-size: clamp(2rem, 9vw, 3rem);
+  }
+
+  main {
+    scroll-margin-top: 180px;
+  }
+}
