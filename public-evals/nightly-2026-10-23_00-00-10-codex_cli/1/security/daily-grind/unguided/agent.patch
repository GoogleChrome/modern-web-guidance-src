+const fs = require('node:fs');
+const path = require('node:path');
+
+// This site needs no JavaScript, frames, forms, plugins, or network APIs.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'none'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  'img-src https://images.unsplash.com',
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'none'",
+  "frame-ancestors 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+].join('; ');
+
+function createHandler({ cspMode = 'enforce', hsts = false } = {}) {
+  if (!['enforce', 'report-only'].includes(cspMode)) {
+    throw new Error('CSP_MODE must be enforce or report-only');
+  }
+
+  const policyHeader = cspMode === 'report-only'
+    ? 'Content-Security-Policy-Report-Only'
+    : 'Content-Security-Policy';
+  const headers = {
+    [policyHeader]: CONTENT_SECURITY_POLICY,
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'no-referrer',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+    'X-XSS-Protection': '0',
+  };
+  if (hsts) headers['Strict-Transport-Security'] = 'max-age=31536000';
+
+  return (req, res) => {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+
+    const send = (status, body, contentType = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': contentType });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'Method not allowed');
+      return;
+    }
+
+    let pathname;
+    try {
+      // Routing must never depend on the untrusted Host header.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'Bad request');
+      return;
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      send(200, 'Logged out');
+      return;
+    }
+
+    // Explicit assets only: no user-controlled filesystem paths.
+    const stylesheet = pathname === '/styles.css';
+    const filename = stylesheet ? 'styles.css' : 'index.html';
+    fs.readFile(path.join(__dirname, filename), (error, data) => {
+      if (error) {
+        send(500, 'Server error');
+        return;
+      }
+      send(200, data, stylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    });
+  };
+}
+
+module.exports = { createHandler, CONTENT_SECURITY_POLICY };
