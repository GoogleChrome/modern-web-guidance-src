+test('HTTPS configuration uses a trusted report origin and cautious HSTS', async () => {
+  const res = await request({ headers: { host: 'attacker.example', 'x-forwarded-proto': 'https' },
+    options: { publicOrigin: 'https://coffee.example' } });
+  assert.equal(res.headers['reporting-endpoints'], 'security="https://coffee.example/security-reports"');
+  assert.equal(res.headers['strict-transport-security'], 'max-age=300');
+  const local = await request({ headers: { host: 'attacker.example', 'x-forwarded-proto': 'https' } });
+  assert.equal(local.headers['strict-transport-security'], undefined);
+  assert.equal(local.headers['reporting-endpoints'], undefined);
+  for (const publicOrigin of ['http://coffee.example', 'https://user:pass@coffee.example',
+    'https://coffee.example/path', 'https://coffee.example/?secret=1', 'https://coffee.example/#fragment']) {
+    assert.throws(() => securityHeaders({ publicOrigin }));
+  }
+});
