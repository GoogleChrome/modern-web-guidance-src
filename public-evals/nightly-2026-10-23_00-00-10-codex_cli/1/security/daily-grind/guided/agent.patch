@@ -0,0 +1,137 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const fs = require('node:fs/promises');
+const { createHandler } = require('../app');
+const { securityHeaders } = require('../security');
+
+// No network listeners, browser, or server entrypoint imports.
+async function request({ url = '/', method = 'GET', headers = {}, body = '', options = {}, chunks } = {}) {
+  const req = Readable.from(chunks || [Buffer.from(body)]);
+  Object.assign(req, { url, method, headers });
+  const res = {
+    headers: {}, status: 0, body: undefined,
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      for (const [name, value] of Object.entries(headers)) this.setHeader(name, value);
+    },
+    end(body) { this.body = body?.toString() || ''; },
+  };
+  await createHandler(options)(req, res);
+  return res;
+}
+
+test('markup and CSS remain compatible with the script-free policy', async () => {
+  const page = await request();
+  assert.equal(page.status, 200);
+  assert.match(page.body, /<link rel="stylesheet" href="\/styles.css">/);
+  assert.doesNotMatch(page.body, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  const style = await request({ url: '/styles.css' });
+  assert.equal(style.headers['content-type'], 'text/css; charset=utf-8');
+  assert.match(style.body, /\.section-heading\s*\{\s*text-align: center;/);
+  const origins = [...style.body.matchAll(/https:\/\/[^/'"\s)]+/g)].map(([origin]) => origin);
+  assert.deepEqual([...new Set(origins)], ['https://images.unsplash.com']);
+  assert.match(page.headers['content-security-policy'], /img-src 'self' https:\/\/images.unsplash.com/);
+});
+
+test('strict headers cover pages, stylesheet, logout, and error responses', async () => {
+  for (const input of [{}, { url: '/styles.css' }, { url: '/logout/' },
+    { method: 'DELETE' }, { url: 'http://[' }]) {
+    const res = await request(input);
+    const csp = res.headers['content-security-policy'];
+    for (const directive of ["default-src 'none'", "script-src 'none'", "style-src-attr 'none'",
+      "object-src 'none'", "base-uri 'none'", "frame-ancestors 'self'",
+      "require-trusted-types-for 'script'", "trusted-types 'none'", 'report-uri /security-reports']) {
+      assert.ok(csp.includes(directive), directive);
+    }
+    assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'SAMEORIGIN');
+    assert.equal(res.headers['cross-origin-resource-policy'], 'same-origin');
+    assert.equal(res.headers['cross-origin-opener-policy'], 'same-origin-allow-popups');
+    assert.equal(res.headers['referrer-policy'], 'strict-origin-when-cross-origin');
+    assert.match(res.headers['permissions-policy'], /camera=\(\)/);
+    assert.equal(res.headers['cache-control'], 'no-store');
+    assert.equal(res.headers['cross-origin-embedder-policy'], undefined);
+  }
+});
+
+test('report-only rollout preserves baseline clickjacking defenses', () => {
+  const headers = securityHeaders({ mode: 'report-only' });
+  assert.match(headers['Content-Security-Policy-Report-Only'], /require-trusted-types-for 'script'/);
+  assert.doesNotMatch(headers['Content-Security-Policy'], /script-src/);
+  assert.match(headers['Content-Security-Policy'], /frame-ancestors 'self'/);
+  assert.equal(headers['X-Frame-Options'], 'SAMEORIGIN');
+  assert.throws(() => securityHeaders({ mode: 'disabled' }));
+});
