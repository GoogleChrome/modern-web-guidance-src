+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { REPORT_PATH, securityHeaders, allowsRequest, summarizeReports } = require('./security');
+
+// This module has no listener and is safe to exercise with in-memory requests.
+function createHandler(options = {}) {
+  const headers = securityHeaders(options);
+  const logReport = options.logReport || ((report) => console.info(JSON.stringify(report)));
+  return async function handleRequest(req, res) {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, body = '', type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    let pathname;
+    try {
+      // Never use the untrusted Host header to construct URLs or report targets.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return send(400, 'Bad request');
+    }
+    if (!allowsRequest(req)) return send(403, 'Forbidden');
+    if (pathname === REPORT_PATH) {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return send(405, 'Method not allowed');
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+      if (!['application/csp-report', 'application/reports+json'].includes(type)) {
+        return send(415, 'Unsupported media type');
+      }
+      // Bound memory and log volume per request, including chunked uploads.
+      let size = 0;
+      const chunks = [];
+      try {
+        for await (const chunk of req) {
+          size += Buffer.byteLength(chunk);
+          if (size > 16384) return send(413, 'Report too large');
+          chunks.push(Buffer.from(chunk));
+        }
+        const reports = summarizeReports(JSON.parse(Buffer.concat(chunks).toString('utf8')));
+        for (const report of reports) logReport(report);
+      } catch {
+        return send(400, 'Invalid report');
+      }
+      return send(204);
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'Method not allowed');
+    }
+    if (pathname === '/logout' || pathname === '/logout/') {
+      // Existing placeholder only: there is no authentication/session backend.
+      return send(200, 'Logged out');
+    }
+    const isStyle = pathname === '/styles.css';
+    try {
+      // Explicit filenames only: URL paths can never read arbitrary files.
+      const data = await fs.readFile(path.join(__dirname, isStyle ? 'styles.css' : 'index.html'));
+      return send(200, data, isStyle ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      return send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
