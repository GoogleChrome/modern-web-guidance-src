+const REPORT_PATH = '/security-reports';
+
+function securityHeaders({ mode = 'enforce', publicOrigin } = {}) {
+  if (!['enforce', 'report-only'].includes(mode)) {
+    throw new Error('SECURITY_POLICY_MODE must be enforce or report-only');
+  }
+  let origin;
+  if (publicOrigin) {
+    const url = new URL(publicOrigin);
+    if (url.protocol !== 'https:' || url.username || url.password ||
+        url.pathname !== '/' || url.search || url.hash) {
+      throw new Error('PUBLIC_ORIGIN must be an HTTPS origin without credentials, path, query or fragment');
+    }
+    origin = url.origin;
+  }
+  // No executable code is needed. Do not add unsafe-inline/eval or a permissive
+  // Trusted Types default policy when introducing future browser functionality.
+  const policy = [
+    "default-src 'none'", "script-src 'none'", "script-src-attr 'none'",
+    "style-src 'self'", "style-src-attr 'none'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'", "object-src 'none'", "base-uri 'none'",
+    "frame-ancestors 'self'", "form-action 'self'",
+    "require-trusted-types-for 'script'", "trusted-types 'none'",
+    `report-uri ${REPORT_PATH}`, 'report-to security',
+  ].join('; ');
+  const headers = {
+    'Content-Security-Policy': mode === 'enforce' ? policy :
+      "object-src 'none'; base-uri 'none'; frame-ancestors 'self'",
+    'X-Frame-Options': 'SAMEORIGIN',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+    'Cache-Control': 'no-store',
+  };
+  if (mode === 'report-only') headers['Content-Security-Policy-Report-Only'] = policy;
+  if (origin) {
+    headers['Reporting-Endpoints'] = `security="${origin}${REPORT_PATH}"`;
+    // Short initial rollout, deliberately excluding subdomains and preload.
+    headers['Strict-Transport-Security'] = 'max-age=300';
+  }
+  return headers;
+}
+
+function allowsRequest(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (!site || site === 'same-origin' || site === 'none') return true;
+  return ['GET', 'HEAD'].includes(req.method) &&
+    req.headers['sec-fetch-mode'] === 'navigate' &&
+    req.headers['sec-fetch-dest'] === 'document';
+}
+
+// Logs intentionally omit URLs, samples, headers and user-agent strings. Reports
+// are unauthenticated attacker input, not evidence of a confirmed vulnerability.
+function summarizeReports(payload) {
+  const reports = Array.isArray(payload) ? payload : [payload];
+  if (reports.length > 20) throw new Error('Too many reports');
+  return reports.flatMap((report) => {
+    if (!report || typeof report !== 'object') return [];
+    const body = report['csp-report'] || report.body;
+    if (!body || typeof body !== 'object') return [];
+    const directive = body['effective-directive'] || body.effectiveDirective;
+    if (typeof directive !== 'string' || !/^[a-z-]{1,64}$/.test(directive)) return [];
+    return [{ type: 'csp-violation', directive,
+      disposition: body.disposition === 'report' ? 'report' : 'enforce' }];
+  });
+}
+
+module.exports = { REPORT_PATH, securityHeaders, allowsRequest, summarizeReports };
