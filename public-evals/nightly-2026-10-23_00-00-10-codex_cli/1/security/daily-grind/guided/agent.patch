+test('legacy CSP and modern Reporting API payloads log only safe fields', async () => {
+  for (const modern of [false, true]) {
+    const logs = [];
+    const body = modern ? [{ type: 'csp-violation', url: 'https://coffee.example/?token=secret', body: {
+      effectiveDirective: 'script-src-elem', disposition: 'report', sample: 'private code',
+      blockedURL: 'https://user:password@attacker.example/?token=secret' } }] : {
+      'csp-report': { 'effective-directive': 'script-src-elem', disposition: 'report',
+        'document-uri': 'https://coffee.example/?token=secret', 'script-sample': 'private code' } };
+    const res = await request({ url: '/security-reports', method: 'POST',
+      headers: { 'content-type': modern ? 'application/reports+json' : 'application/csp-report' },
+      body: JSON.stringify(body), options: { logReport: report => logs.push(report) } });
+    assert.equal(res.status, 204);
+    assert.deepEqual(logs, [{ type: 'csp-violation', directive: 'script-src-elem', disposition: 'report' }]);
+    assert.doesNotMatch(JSON.stringify(logs), /secret|private|password/);
+  }
+});
