+test('Fetch Metadata blocks cross-origin resource access but permits incoming links', async () => {
+  for (const site of ['cross-site', 'same-site']) {
+    const headers = { 'sec-fetch-site': site, 'sec-fetch-mode': 'no-cors', 'sec-fetch-dest': 'style' };
+    assert.equal((await request({ url: '/styles.css', headers })).status, 403);
+    assert.equal((await request({ headers: { ...headers, 'sec-fetch-mode': 'navigate',
+      'sec-fetch-dest': 'iframe' } })).status, 403);
+    assert.equal((await request({ headers: { ...headers, 'sec-fetch-mode': 'navigate',
+      'sec-fetch-dest': 'document' } })).status, 200);
+  }
+  const own = await request({ headers: { 'sec-fetch-site': 'same-origin' } });
+  assert.equal(own.status, 200);
+  assert.match(own.headers.vary, /Sec-Fetch-Site/);
+});
