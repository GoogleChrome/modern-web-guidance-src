+test('report ingestion rejects bad types, malformed input, and oversized batches/bodies', async () => {
+  const base = { url: '/security-reports', method: 'POST', headers: { 'content-type': 'application/csp-report' } };
+  assert.equal((await request({ ...base, method: 'GET' })).status, 405);
+  assert.equal((await request({ ...base, headers: { 'content-type': 'text/plain' } })).status, 415);
+  assert.equal((await request({ ...base, body: '{' })).status, 400);
+  assert.equal((await request({ ...base, body: JSON.stringify(Array(21).fill({})) })).status, 400);
+  assert.equal((await request({ ...base, chunks: [Buffer.alloc(10000), Buffer.alloc(10000)] })).status, 413);
+  const logs = [];
+  assert.equal((await request({ ...base, body: JSON.stringify({ 'csp-report': {
+    'effective-directive': 'script-src\nforged-log' } }), options: { logReport: r => logs.push(r) } })).status, 204);
+  assert.deepEqual(logs, []);
+});
