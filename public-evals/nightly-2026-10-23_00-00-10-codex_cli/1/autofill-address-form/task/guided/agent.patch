+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingReview = document.getElementById('shipping-review');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      const value = (name) => String(details.get(name) || '').trim();
+      const address = ['name', 'street-address', 'city', 'region', 'postal-code', 'country']
+        .map(value).filter(Boolean).join('\n');
+      shippingReview.textContent = `Review your delivery details:\n${address}\n\nEmail: ${value('email')}\nPhone: ${value('phone')}\n\nThis is an address preview. No order has been placed.`;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingReview.textContent = '';
+    });
+  </script>
