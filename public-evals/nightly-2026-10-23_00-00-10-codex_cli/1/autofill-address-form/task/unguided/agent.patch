+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      shippingStatus.textContent = `Delivery details: ${[
+        details.get('name'),
+        details.get('street-address'),
+        details.get('address-level2'),
+        details.get('address-level1'),
+        details.get('postal-code'),
+        details.get('country-name'),
+        details.get('email'),
+        details.get('tel')
+      ].filter(Boolean).join(', ')}. No order has been placed.`;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingStatus.textContent = '';
+    });
+  </script>
