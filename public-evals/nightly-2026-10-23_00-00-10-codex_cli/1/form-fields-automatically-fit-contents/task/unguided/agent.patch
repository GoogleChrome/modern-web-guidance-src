+  <script>
+    const form = document.querySelector('#brew-form');
+    const fields = [...form.querySelectorAll('.content-sized')];
+    const status = document.querySelector('#save-status');
+    const measure = document.createElement('span');
+    measure.className = 'size-measure';
+    measure.setAttribute('aria-hidden', 'true');
+    document.body.append(measure);
+
+    function fitField(field) {
+      const style = getComputedStyle(field);
+      measure.style.font = style.font;
+      measure.style.letterSpacing = style.letterSpacing;
+      const value = field.tagName === 'SELECT'
+        ? field.selectedOptions[0].textContent
+        : field.value || field.placeholder || ' ';
+      const widest = Math.max(...value.split('\n').map(line => {
+        measure.textContent = line || ' ';
+        return measure.getBoundingClientRect().width;
+      }));
+      const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+      // Leave room for native select arrows and the text cursor.
+      field.style.width = `${Math.ceil(widest + padding + (field.tagName === 'SELECT' ? 30 : 5))}px`;
+      if (field.tagName === 'TEXTAREA') {
+        field.style.height = '0px';
+        field.style.height = `${field.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+      }
+    }
+
+    fields.forEach(field => {
+      field.addEventListener('input', () => {
+        fitField(field);
+        status.textContent = 'Unsaved changes';
+      });
+      field.addEventListener('change', () => fitField(field));
+    });
+    const fitAll = () => fields.forEach(fitField);
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-brew-note'));
+      if (saved) {
+        fields.forEach(field => {
+          if (typeof saved[field.name] === 'string') field.value = saved[field.name];
+        });
+        status.textContent = 'Your saved note, ready for another sip.';
+      }
+    } catch { /* The form remains usable when local storage is unavailable. */ }
+    fitAll();
+    document.fonts.ready.then(fitAll);
+    window.addEventListener('resize', fitAll);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-brew-note', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Note saved on this device. Enjoy your next cup.';
+      } catch {
+        status.textContent = 'Saving is unavailable in this browser. Please copy your note.';
+      }
+    });
+  </script>
+
