+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const preferenceStatus = document.getElementById('preference-status');
+    const preferenceStorageKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(preferenceStorageKey));
+      if (saved && typeof saved === 'object') {
+        for (const name of ['name', 'brew', 'notes']) {
+          if (typeof saved[name] === 'string') {
+            preferencesForm.elements.namedItem(name).value = saved[name];
+          }
+        }
+      }
+    } catch {
+      // The form remains usable when browser storage is unavailable.
+    }
+
+    preferencesForm.addEventListener('input', () => {
+      preferenceStatus.textContent = '';
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(preferenceStorageKey, JSON.stringify(Object.fromEntries(new FormData(preferencesForm))));
+        preferenceStatus.textContent = 'Preferences saved on this device.';
+      } catch {
+        preferenceStatus.textContent = 'Your browser could not save these preferences. Please try again with browser storage enabled.';
+      }
+    });
+  </script>
+
