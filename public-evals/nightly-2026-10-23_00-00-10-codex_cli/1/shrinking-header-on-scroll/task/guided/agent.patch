+  <script>
+    (function () {
+      var supportsScrollAnimation = window.CSS && window.CSS.supports &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsScrollAnimation) return;
+
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var framePending = false;
+
+      function updateNavigation() {
+        framePending = false;
+        if (reducedMotion.matches) {
+          navigation.style.removeProperty('--nav-padding');
+          return;
+        }
+
+        var rootSize = parseFloat(window.getComputedStyle(document.documentElement).fontSize);
+        var scrollPosition = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, scrollPosition / (1.25 * rootSize)));
+        navigation.style.setProperty('--nav-padding', (1 - 0.625 * progress) + 'rem');
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        window.requestAnimationFrame(updateNavigation);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else if (reducedMotion.addListener) {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      updateNavigation();
+    }());
+  </script>
+
