+  <script>
+    (function () {
+      var reducedMotion = window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll()') &&
+        CSS.supports('animation-range', '0px 160px');
+
+      if (nativeScrollAnimation) return;
+
+      // Older browsers get the same continuous, reversible scroll effect.
+      var shell = document.querySelector('.nav-shell');
+      var nav = shell.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var pending = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateNavigation() {
+        pending = false;
+        if (reducedMotion && reducedMotion.matches) {
+          nav.style.height = '';
+          logo.style.fontSize = '';
+          return;
+        }
+
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(1, Math.max(0, scrollTop / 160));
+        nav.style.height = (shell.offsetHeight - 20 * progress) + 'px';
+        logo.style.fontSize = (1.5 - 0.25 * progress) + 'rem';
+      }
+
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          requestFrame(updateNavigation);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('resize', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (reducedMotion) {
+        if (reducedMotion.addEventListener) {
+          reducedMotion.addEventListener('change', scheduleUpdate);
+        } else if (reducedMotion.addListener) {
+          reducedMotion.addListener(scheduleUpdate);
+        }
+      }
+      updateNavigation();
+    }());
+  </script>
+
