--- /dev/null
+++ b/public/signup.js
@@ -0,0 +1,18 @@
+// Keep the browser's native form submission: EVP fills the token at submission.
+const form = document.querySelector('#rewards-form');
+const message = document.querySelector('#form-message');
+if (message?.textContent.trim()) message.focus({ preventScroll: true });
+form?.addEventListener('submit', () => {
+  setTimeout(() => {
+    const button = form.querySelector('button[type="submit"]');
+    button.disabled = true;
+    button.textContent = 'Verifying your email…';
+  }, 0);
+});
+window.addEventListener('pageshow', () => {
+  const button = form?.querySelector('button[type="submit"]');
+  if (button) {
+    button.disabled = false;
+    button.innerHTML = 'Join Grind Rewards <span aria-hidden="true">↗</span>';
+  }
+});
