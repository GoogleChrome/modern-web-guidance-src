+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { SignJWT, generateKeyPair, exportJWK } from 'jose';
+import { normalizeEmail, verifyEmailToken, fetchProviderJson } from '../lib/verification.mjs';
+
+const now=Math.floor(Date.now()/1000);
+const issuer=await generateKeyPair('ES256'), browser=await generateKeyPair('ES256'), other=await generateKeyPair('ES256');
+const issuerJwk=await exportJWK(issuer.publicKey), browserJwk=await exportJWK(browser.publicKey);
+const email='alex@example.com', origin='https://coffee.example', nonce='server-generated-random-nonce';
+async function fixture({evtClaims={},kbClaims={},signer=issuer.privateKey,kbSigner=browser.privateKey,evtAlg='ES256'}={}) {
+  const evt=await new SignJWT({email,email_verified:true,cnf:{jwk:browserJwk},...evtClaims}).setProtectedHeader({alg:evtAlg,typ:'evt+jwt'}).setIssuer('https://issuer.example').setIssuedAt(now).setExpirationTime(now+300).sign(signer);
+  const hash=createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb=await new SignJWT({nonce,sd_hash:hash,...kbClaims}).setProtectedHeader({alg:'ES256',typ:'kb+jwt'}).setAudience(kbClaims.aud||origin).setIssuedAt(kbClaims.iat??now).sign(kbSigner);
+  return `${evt}~${kb}`;
+}
+const verify=async(token,options={})=>verifyEmailToken({token,email,nonce,origin,...options},{now,discover:async()=>[issuerJwk]});
+test('valid signed email and browser binding verify, including keys without kid',async()=>{
+  assert.deepEqual(await verify(await fixture()),{email,issuer:'https://issuer.example'});
+});
+test('missing, malformed, and disclosure tokens fail closed',async()=>{
+  for(const token of ['', 'bad', 'a~b~c', 'a~'])await assert.rejects(verify(token));
+});
+test('forged issuer signature is rejected',async()=>{await assert.rejects(verify(await fixture({signer:other.privateKey})));});
+test('forged browser signature is rejected',async()=>{await assert.rejects(verify(await fixture({kbSigner:other.privateKey})));});
+test('email and verified claim must match',async()=>{
+  for(const evtClaims of [{email:'someone@example.com'},{email_verified:false},{email_verified:'true'}])await assert.rejects(verify(await fixture({evtClaims})));
+});
+test('origin, nonce, digest and old browser proofs are rejected',async()=>{
+  for(const kbClaims of [{aud:'https://evil.example'},{nonce:'another-session'},{sd_hash:'invalid'},{iat:now-301},{iat:now+60}])await assert.rejects(verify(await fixture({kbClaims})));
+});
+test('unsupported SD-JWT digest algorithm is rejected',async()=>{await assert.rejects(verify(await fixture({evtClaims:{_sd_alg:'sha-512'}})));});
+test('expired issuer JWT is rejected',async()=>{
+  const token=await fixture();
+  await assert.rejects(verifyEmailToken({token,email,nonce,origin},{now:now+400,discover:async()=>[issuerJwk]}));
+});
+test('valid signature from an undelegated issuer is rejected',async()=>{
+  await assert.rejects(verifyEmailToken({token:await fixture(),email,nonce,origin},{now,discover:async()=>{throw new Error('Issuer not authorized for email domain');}}));
+});
+test('provider HTTP, credentials and literal private IP URLs are rejected before network access',async()=>{
+  for(const url of ['http://localhost','https://127.0.0.1/','https://[::1]/','https://user:pass@issuer.example/','https://issuer.example:8000/'])await assert.rejects(fetchProviderJson(url));
+});
+test('email normalization rejects invalid values',()=>{
+  assert.equal(normalizeEmail(' Alex@Example.COM '),email);
+  for(const value of [null,'alex','a@localhost','a@b.com\nother@b.com'])assert.throws(()=>normalizeEmail(value));
+});
