@@ -0,0 +1,52 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { verifyEmail } from './lib/verify-email.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.PUBLIC_ORIGIN || `http://localhost:${port}`).origin;
+const secure = origin.startsWith('https:');
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const css = await readFile(new URL('./styles.css', import.meta.url));
+const db = new DatabaseSync(process.env.DATABASE_PATH || 'rewards.sqlite');
+db.exec(`CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, created INTEGER NOT NULL);`);
+const escape = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function render(res, {status=200, message='', success=false, email='', name=''} = {}) {
+  db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+  const id = randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(id, nonce, Date.now()+300000);
+  const html = template.replace('nonce="FORM_NONCE"', `nonce="${nonce}"`).replace('<!--FORM_MESSAGE-->', message ? `<div class="form-message ${success ? 'success' : ''}" role="status">${escape(message)}</div>` : '').replace('id="name"',`id="name" value="${escape(name)}"`).replace('id="email"',`id="email" value="${escape(email)}"`);
+  res.writeHead(status, { 'Content-Type':'text/html; charset=utf-8', 'Cache-Control':'no-store', 'Set-Cookie':`dg_signup=${id}; HttpOnly; SameSite=Lax; Path=/; Max-Age=300${secure ? '; Secure' : ''}`, 'X-Content-Type-Options':'nosniff', 'Referrer-Policy':'same-origin', ...(process.env.ORIGIN_TRIAL_TOKEN ? {'Origin-Trial':process.env.ORIGIN_TRIAL_TOKEN} : {}) });
+  res.end(html);
+}
+createServer(async (req,res) => {
+  try {
+    const path = new URL(req.url, origin).pathname;
+    if (req.method === 'GET' && path === '/styles.css') { res.writeHead(200,{'Content-Type':'text/css'}); return res.end(css); }
+    if (req.method === 'GET' && path === '/') return render(res);
+    if (req.method === 'POST' && path === '/api/verify-email') {
+      if (req.headers.origin !== origin) { res.writeHead(403); return res.end('Please submit from the Daily Grind homepage.'); }
+      const id = /(?:^|;\s*)dg_signup=([\w-]+)/.exec(req.headers.cookie || '')?.[1];
+      // DELETE RETURNING consumes the challenge atomically, before body parsing or verification.
+      const challenge = db.prepare('DELETE FROM challenges WHERE id = ? RETURNING nonce, expires').get(id || '');
+      let body = '';
+      for await (const chunk of req) { body += chunk; if (Buffer.byteLength(body)>30000) { res.writeHead(413); return res.end('Form too large.'); } }
+      if (!req.headers['content-type']?.startsWith('application/x-www-form-urlencoded')) return render(res,{status:415,message:'Please use the sign-up form below.'});
+      const form = new URLSearchParams(body);
+      const email = (form.get('email') || '').trim();
+      const name = (form.get('name') || '').trim();
+      const retry = message => render(res,{status:422,message,email:email.slice(0,254),name:name.slice(0,80)});
+      if (!challenge || challenge.expires < Date.now()) return retry('Your sign-up session expired. Please enter your email again and retry.');
+      if (!name || name.length>80 || email.length>254 || !/^[^\s@]+@[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$/i.test(email) || form.get('terms') !== 'yes') return retry('Please enter your name, a valid email address, and accept the rewards terms.');
+      if (!form.get('token')) return retry('Your browser could not verify this email. Try a participating browser while signed in to your email provider, then select your email again. No email was sent and no account was created.');
+      try { await verifyEmail({token:form.get('token'), email, nonce:challenge.nonce, audience:origin}); }
+      catch { return retry('We could not verify your email securely. Please select your email again and retry. No account was created.'); }
+      const result = db.prepare('INSERT INTO members VALUES (?, ?, ?, ?) ON CONFLICT(email) DO NOTHING').run(randomUUID(),email.toLowerCase(),name,Date.now());
+      return render(res,{success:true,message:result.changes ? `You're in, ${name}! Your email is verified and your Daily Grind rewards account is ready.` : 'Your email is verified. You already have a Daily Grind rewards account.'});
+    }
+    res.writeHead(404,{'Content-Type':'text/plain'}); res.end('Page not found.');
+  } catch { res.writeHead(500,{'Content-Type':'text/plain'}); res.end('Something went wrong. Please return to the homepage and try again.'); }
+}).listen(port, '0.0.0.0');
