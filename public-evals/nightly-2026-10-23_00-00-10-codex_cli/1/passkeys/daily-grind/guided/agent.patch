diff --git a/src/security.mjs b/src/security.mjs
new file mode 100644
index 0000000..eacc565
--- /dev/null
+++ b/src/security.mjs
@@ -0,0 +1,27 @@
+export function fail(status, message) { throw Object.assign(new Error(message), { status }); }
+export function requireUser(session, store) {
+  const user = session.userId && store.user(session.userId);
+  if (!user) fail(401, 'Sign in to continue.');
+  return user;
+}
+export function requireRecent(session) {
+  if (!session.verifiedAt || Date.now() - session.verifiedAt > 300000) fail(403, 'Verify your identity to make this change.');
+}
+export function takeChallenge(session, kind, userId) {
+  const pending = session.pending;
+  delete session.pending;
+  if (!pending || pending.kind !== kind || pending.expires < Date.now() || pending.userId !== userId) fail(400, 'This request expired. Please try again.');
+  return pending;
+}
+export function checkOwnership(credential, userId) {
+  if (!credential || credential.userId !== userId) fail(404, 'Passkey not found.');
+}
+export function text(value, label, max = 80) {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > max) fail(400, `${label} must be between 1 and ${max} characters.`);
+  return value.trim();
+}
+export function profile(body) {
+  const name = text(body.name, 'Username', 40).toLowerCase();
+  if (!/^[a-z0-9._-]+$/.test(name)) fail(400, 'Use letters, numbers, dots, underscores, or hyphens for your username.');
+  return { name, displayName: text(body.displayName, 'Display name') };
+}
diff --git a/src/store.mjs b/src/store.mjs
new file mode 100644
index 0000000..ef2bbb0
--- /dev/null
+++ b/src/store.mjs
@@ -0,0 +1,34 @@
+import { DatabaseSync } from 'node:sqlite';
+
+export function openStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+    CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS credentials (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), data TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, expires INTEGER NOT NULL, data TEXT NOT NULL);`);
+  return {
+    db,
+    user: id => db.prepare('SELECT * FROM users WHERE id=?').get(id),
+    byName: name => db.prepare('SELECT * FROM users WHERE name=?').get(name),
+    credentials: userId => db.prepare('SELECT data FROM credentials WHERE userId=?').all(userId).map(r => JSON.parse(r.data)),
+    credential: id => { const r = db.prepare('SELECT data FROM credentials WHERE id=?').get(id); return r && JSON.parse(r.data); },
+    session: id => { const r = db.prepare('SELECT data FROM sessions WHERE id=? AND expires>?').get(id, Date.now()); return r && JSON.parse(r.data); },
+    saveSession: (id, data) => db.prepare('INSERT OR REPLACE INTO sessions VALUES (?,?,?)').run(id, Date.now() + 86400000, JSON.stringify(data)),
+    deleteSession: id => db.prepare('DELETE FROM sessions WHERE id=?').run(id),
+    prune: () => db.prepare('DELETE FROM sessions WHERE expires<=?').run(Date.now()),
+    register(user, credential, isNew) {
+      db.exec('BEGIN IMMEDIATE');
+      try {
+        if (isNew) db.prepare('INSERT INTO users VALUES (?,?,?)').run(user.id, user.name, user.displayName);
+        db.prepare('INSERT INTO credentials VALUES (?,?,?)').run(credential.id, user.id, JSON.stringify(credential));
+        db.exec('COMMIT');
+      } catch (e) { db.exec('ROLLBACK'); throw e; }
+    },
+    updateCredential: c => db.prepare('UPDATE credentials SET data=? WHERE id=? AND userId=?').run(JSON.stringify(c), c.id, c.userId),
+    deleteCredential(id, userId) {
+      if (this.credentials(userId).length < 2) throw Object.assign(new Error('Add another passkey before removing your last one.'), { status: 409 });
+      db.prepare('DELETE FROM credentials WHERE id=? AND userId=?').run(id, userId);
+    },
+    updateUser: user => db.prepare('UPDATE users SET name=?, displayName=? WHERE id=?').run(user.name, user.displayName, user.id),
+  };
+}
diff --git a/test/passkeys.test.mjs b/test/passkeys.test.mjs
new file mode 100644
index 0000000..35c9492
--- /dev/null
+++ b/test/passkeys.test.mjs
@@ -0,0 +1,153 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPairSync, createHash, sign, randomBytes } from 'node:crypto';
+import { openStore } from '../src/store.mjs';
+import { createApp } from '../src/app.mjs';
+import { requireRecent, takeChallenge, checkOwnership, profile } from '../src/security.mjs';
+
+const origin = 'http://localhost:11222';
+const rpId = 'localhost';
+const user = { id: randomBytes(32).toString('base64url'), name: 'coffee', displayName: 'Coffee Lover' };
+const hash = data => createHash('sha256').update(data).digest();
+const b64 = data => Buffer.from(data).toString('base64url');
+// A software authenticator for signed WebAuthn test data; no browser or network listener.
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const cose = Buffer.concat([Buffer.from('a5010203262001215820', 'hex'), Buffer.from(jwk.x, 'base64url'), Buffer.from('225820', 'hex'), Buffer.from(jwk.y, 'base64url')]);
+  const id = randomBytes(32);
+  const data = (type, challenge, clientOrigin = origin) => Buffer.from(JSON.stringify({ type, challenge, origin: clientOrigin, crossOrigin: false }));
+  const auth = (flags, counter = 0) => { const count = Buffer.alloc(4); count.writeUInt32BE(counter); return Buffer.concat([hash(rpId), Buffer.from([flags]), count]); };
+  return {
+    id: b64(id), cose,
+    registration(challenge) {
+      const client = data('webauthn.create', challenge);
+      const length = Buffer.alloc(2); length.writeUInt16BE(id.length);
+      const bytes = Buffer.concat([auth(0x45), Buffer.alloc(16), length, id, cose]);
+      // CBOR: {fmt:'none', attStmt:{}, authData:bytes}
+      const lengthBytes = Buffer.alloc(3); lengthBytes[0] = 0x59; lengthBytes.writeUInt16BE(bytes.length, 1);
+      const attestation = Buffer.concat([Buffer.from('a363666d74646e6f6e656761747453746d74a0686175746844617461', 'hex'), lengthBytes, bytes]);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(client), attestationObject: b64(attestation), transports: ['internal'] } };
+    },
+    assertion(challenge, { counter = 1, flags = 0x05, clientOrigin = origin, userId = user.id } = {}) {
+      const client = data('webauthn.get', challenge, clientOrigin);
+      const bytes = auth(flags, counter);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(client), authenticatorData: b64(bytes), signature: b64(sign('sha256', Buffer.concat([bytes, hash(client)]), privateKey)), userHandle: userId } };
+    },
+  };
+}
+function fixture(t) {
+  const store = openStore(':memory:');
+  t.after(() => store.db.close());
+  const app = createApp({ store, origin, rpId }); // App factory has no listener and is not the server entrypoint.
+  const req = { sessionId: 'test-session', session: {}, body: {}, params: {} };
+  req.save = () => store.saveSession(req.sessionId, req.session);
+  req.rotate = id => { store.deleteSession(req.sessionId); req.sessionId += '-rotated'; req.session = { userId: id }; req.save(); };
+  async function call(method, path, body = {}) {
+    req.body = body;
+    const layer = app.router.stack.find(l => l.route?.path === path && l.route.methods[method]);
+    assert.ok(layer, `Route ${method} ${path} exists`);
+    let result;
+    await layer.route.stack[0].handle(req, { json: value => { result = value; }, clearCookie() {} });
+    return result;
+  }
+  return { store, req, call };
+}
+async function enroll(f, auth = authenticator()) {
+  const options = await f.call('post', '/api/register/options', { name: user.name, displayName: user.displayName });
+  const state = await f.call('post', '/api/register/verify', { credential: auth.registration(options.challenge), name: 'Everyday key' });
+  return { auth, state };
+}
+
+test('real signed registration, logout, discoverable login, and strict reauthentication', async t => {
+  const f = fixture(t);
+  const { auth, state } = await enroll(f);
+  assert.equal(state.user.name, user.name);
+  assert.equal(state.credentials.length, 1);
+  assert.equal(state.credentials[0].publicKey, undefined);
+  const stored = f.store.credential(auth.id);
+  assert.ok(stored.publicKey);
+  await f.call('post', '/api/logout');
+  f.req.session = {}; f.req.sessionId = 'fresh';
+  const options = await f.call('post', '/api/login/options');
+  assert.deepEqual(options.allowCredentials, []);
+  const signedIn = await f.call('post', '/api/login/verify', auth.assertion(options.challenge, { userId: stored.userId }));
+  assert.equal(signedIn.user.id, stored.userId);
+  const reauth = await f.call('post', '/api/reauth/options');
+  assert.deepEqual(reauth.allowCredentials.map(c => c.id), [auth.id]);
+  assert.equal(reauth.userVerification, 'required');
+  const verified = await f.call('post', '/api/reauth/verify', auth.assertion(reauth.challenge, { counter: 2, userId: stored.userId }));
+  assert.ok(verified.verifiedUntil > Date.now());
+  assert.equal(f.store.credential(auth.id).counter, 2);
+  assert.ok(f.store.credential(auth.id).lastUsedAt);
+});
+
+test('management requires recent verification and preserves the last passkey', async t => {
+  const f = fixture(t);
+  const { auth } = await enroll(f);
+  await assert.rejects(f.call('post', '/api/register/options'), { status: 403 });
+  f.req.params.id = auth.id;
+  const renamed = await f.call('put', '/api/credentials/:id', { name: 'My laptop' });
+  assert.equal(renamed.credentials[0].name, 'My laptop');
+  await assert.rejects(f.call('delete', '/api/credentials/:id'), { status: 403 });
+  f.req.session.verifiedAt = Date.now(); f.req.save();
+  await assert.rejects(f.call('delete', '/api/credentials/:id'), { status: 409 });
+  const second = authenticator();
+  const options = await f.call('post', '/api/register/options');
+  assert.equal(options.excludeCredentials[0].id, auth.id);
+  assert.equal(options.authenticatorSelection.authenticatorAttachment, undefined);
+  await f.call('post', '/api/register/verify', { credential: second.registration(options.challenge) });
+  const deleted = await f.call('delete', '/api/credentials/:id');
+  assert.deepEqual(deleted.credentials.map(c => c.id), [second.id]);
+  const updated = await f.call('put', '/api/user', { name: 'new.coffee', displayName: 'New Name' });
+  assert.equal(updated.user.displayName, 'New Name');
+});
+
+test('challenge replay, wrong origin, wrong user, missing UV, and forged signatures are rejected', async t => {
+  const f = fixture(t);
+  const { auth, state } = await enroll(f);
+  const attempt = async (settings, change) => {
+    const options = await f.call('post', '/api/reauth/options');
+    const assertion = auth.assertion(options.challenge, { ...settings, userId: settings?.userId || state.user.id });
+    change?.(assertion);
+    await assert.rejects(f.call('post', '/api/reauth/verify', assertion));
+    await assert.rejects(f.call('post', '/api/reauth/verify', assertion), { status: 400 });
+  };
+  await attempt({ clientOrigin: 'https://attacker.example' });
+  await attempt({ flags: 0x01 });
+  await attempt({ userId: 'another-user' });
+  await attempt({}, response => { response.response.signature = b64(randomBytes(72)); });
+  const other = authenticator();
+  f.store.register({ id: 'other', name: 'other', displayName: 'Other' }, { id: other.id, userId: 'other', publicKey: b64(other.cose), counter: 0 }, true);
+  const options = await f.call('post', '/api/reauth/options');
+  await assert.rejects(f.call('post', '/api/reauth/verify', other.assertion(options.challenge, { userId: 'other' })), { status: 404 });
+});
+
+test('failed registration creates no account, and existing usernames cannot be claimed', async t => {
+  const f = fixture(t);
+  await f.call('post', '/api/register/options', { name: 'failed', displayName: 'Failed' });
+  await assert.rejects(f.call('post', '/api/register/verify', { credential: {} }), { status: 400 });
+  assert.equal(f.store.byName('failed'), undefined);
+  await enroll(f);
+  f.req.session = {}; f.req.sessionId = 'new-signup';
+  await assert.rejects(f.call('post', '/api/register/options', { name: user.name, displayName: 'Imposter' }), { status: 409 });
+});
+
+test('challenge expiry, ceremony type, ownership, freshness, and profile validation', () => {
+  const challenge = { kind: 'login', userId: undefined, expires: Date.now() - 1 };
+  const session = { pending: challenge };
+  assert.throws(() => takeChallenge(session, 'login'), { status: 400 });
+  assert.equal(session.pending, undefined);
+  assert.throws(() => takeChallenge({ pending: { ...challenge, expires: Date.now() + 10000 } }, 'register'), { status: 400 });
+  assert.throws(() => checkOwnership({ userId: 'a' }, 'b'), { status: 404 });
+  assert.throws(() => requireRecent({ verifiedAt: Date.now() - 300001 }), { status: 403 });
+  assert.throws(() => profile({ name: '<script>', displayName: 'Test' }), { status: 400 });
+});
+
+test('registration transaction rolls back on duplicate credential', t => {
+  const store = openStore(':memory:');
+  t.after(() => store.db.close());
+  store.register(user, { id: 'same-key', userId: user.id }, true);
+  assert.throws(() => store.register({ ...user, id: 'second', name: 'second' }, { id: 'same-key', userId: 'second' }, true));
+  assert.equal(store.user('second'), undefined);
+});
