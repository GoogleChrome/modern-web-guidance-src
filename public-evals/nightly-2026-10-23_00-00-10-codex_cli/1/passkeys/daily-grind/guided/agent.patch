+  if (url.hostname !== rpId && !url.hostname.endsWith(`.${rpId}`)) throw new Error('RP_ID must match the configured origin.');
+  const app = express();
+  const secure = url.protocol === 'https:';
+  const cookieName = secure ? '__Host-grind-session' : 'grind-session';
+  app.disable('x-powered-by');
+  app.use((req, res, next) => {
+    res.set({ 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin', 'Permissions-Policy': 'publickey-credentials-get=(self), publickey-credentials-create=(self)' });
+    next();
+  });
+  app.use('/api', (req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (!['GET', 'HEAD'].includes(req.method) && req.get('origin') !== origin) return res.status(403).json({ error: 'Request origin rejected.' });
+    next();
+  }, express.json({ limit: '32kb' }));
+  // Limit expensive unauthenticated ceremonies. Expired buckets are removed each request.
+  const attempts = new Map();
+  app.use('/api', (req, res, next) => {
+    if (req.method === 'GET') return next();
+    const now = Date.now();
+    for (const [key, bucket] of attempts) if (bucket.until < now) attempts.delete(key);
+    const bucket = attempts.get(req.ip) || { count: 0, until: now + 60000 };
+    attempts.set(req.ip, bucket);
+    if (++bucket.count > 60) return res.status(429).json({ error: 'Too many attempts. Please wait a minute.' });
+    next();
+  });
+  app.use('/api', (req, res, next) => {
+    store.prune();
+    const match = (req.headers.cookie || '').split(';').map(c => c.trim()).find(c => c.startsWith(`${cookieName}=`));
+    const id = match?.slice(cookieName.length + 1);
+    req.sessionId = id && /^[\w-]{43}$/.test(id) && store.session(id) ? id : randomId();
+    req.session = store.session(req.sessionId) || {};
+    // Reloaded by every request; only server-side data is trusted.
+    req.save = () => store.saveSession(req.sessionId, req.session);
+    req.rotate = userId => {
+      store.deleteSession(req.sessionId);
+      req.sessionId = randomId();
+      req.session = { userId };
+      req.save();
+      res.cookie(cookieName, req.sessionId, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 86400000 });
+    };
+    if (!id || id !== req.sessionId) res.cookie(cookieName, req.sessionId, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 86400000 });
+    next();
+  });
+  const state = req => {
+    const user = req.session.userId && store.user(req.session.userId);
+    return { user: user || null, rpId, verifiedUntil: (req.session.verifiedAt || 0) + 300000,
+      credentials: user ? store.credentials(user.id).map(({ publicKey, counter, ...c }) => c) : [] };
+  };
+  const pending = (req, kind, options, extra = {}) => {
+    req.session.pending = { kind, challenge: options.challenge, userId: req.session.userId, uv: options.userVerification || options.authenticatorSelection?.userVerification, expires: Date.now() + 300000, ...extra };
+    req.save();
+    return options;
+  };
+  const consume = (req, kind) => {
+    try { return takeChallenge(req.session, kind, req.session.userId); }
+    finally { req.save(); } // Burn challenge before asynchronous verification, including failures.
+  };
+  app.get('/api/session', (req, res) => res.json(state(req)));
+  app.post('/api/logout', (req, res) => {
+    store.deleteSession(req.sessionId);
+    res.clearCookie(cookieName, { path: '/', secure, httpOnly: true, sameSite: 'lax' });
+    res.json({ success: true });
+  });
+  app.post('/api/register/options', async (req, res) => {
+    let user;
+    if (req.session.userId) {
+      user = requireUser(req.session, store);
+      requireRecent(req.session);
+    } else {
+      const details = profile(req.body);
+      if (store.byName(details.name)) fail(409, 'That username is unavailable. Choose another or sign in.');
+      user = { id: randomId(), ...details };
+    }
+    const options = await generateRegistrationOptions({ rpName: 'The Daily Grind', rpID: rpId,
+      userID: Buffer.from(user.id, 'base64url'), userName: user.name, userDisplayName: user.displayName,
+      attestationType: 'none', excludeCredentials: store.credentials(user.id).map(c => ({ id: c.id, transports: c.transports })),
+      authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' } });
+    res.json(pending(req, 'register', options, { user, isNew: !req.session.userId }));
+  });
+  app.post('/api/register/verify', async (req, res) => {
+    const p = consume(req, 'register');
+    if (!p.isNew) { requireUser(req.session, store); requireRecent(req.session); }
+    let result;
+    try { result = await verifyRegistrationResponse({ response: req.body.credential, expectedChallenge: p.challenge, expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: p.uv === 'required' }); }
+    catch { fail(400, 'Passkey registration could not be verified. Please try again.'); }
+    if (!result.verified) fail(400, 'Passkey registration was not verified.');
+    const { credential, aaguid, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+    const record = { id: credential.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+      transports: credential.transports || [], userId: p.user.id, name: text(req.body.name || 'My passkey', 'Passkey name'),
+      aaguid, credentialType: 'public-key', credentialDeviceType, credentialBackedUp, registeredAt: Date.now(), lastUsedAt: null };
+    if (!store.session(req.sessionId)) fail(401, 'Your session ended. Please try again.');
+    try { store.register(p.user, record, p.isNew); } catch { fail(409, 'This account or passkey already exists. Please sign in or try another.'); }
+    if (p.isNew) req.rotate(p.user.id);
+    res.json(state(req));
+  });
+  for (const kind of ['login', 'reauth']) {
+    app.post(`/api/${kind}/options`, async (req, res) => {
+      if (kind === 'login' && req.session.userId) fail(409, 'Sign out before signing in to another account.');
+      let allowCredentials = [];
+      if (kind === 'reauth') {
+        const user = requireUser(req.session, store);
+        allowCredentials = store.credentials(user.id).map(c => ({ id: c.id, transports: c.transports }));
+        if (!allowCredentials.length) fail(409, 'No passkeys are registered to this account.');
+      }
+      const options = await generateAuthenticationOptions({ rpID: rpId, allowCredentials, userVerification: kind === 'reauth' ? 'required' : 'preferred' });
+      res.json(pending(req, kind, options));
+    });
+    app.post(`/api/${kind}/verify`, async (req, res) => {
+      const p = consume(req, kind);
+      const credential = store.credential(req.body.id);
+      if (!credential) fail(404, 'Passkey not found. Use another passkey or create an account.');
+      if (kind === 'reauth') checkOwnership(credential, requireUser(req.session, store).id);
+      const handle = req.body.response?.userHandle;
+      if ((handle && handle !== credential.userId) || (kind === 'login' && !handle)) fail(400, 'This passkey belongs to a different account.');
+      let result;
+      try { result = await verifyAuthenticationResponse({ response: req.body, expectedChallenge: p.challenge, expectedOrigin: origin, expectedRPID: rpId,
+        credential: { id: credential.id, publicKey: Buffer.from(credential.publicKey, 'base64url'), counter: credential.counter, transports: credential.transports }, requireUserVerification: p.uv === 'required' }); }
+      catch { fail(400, 'Your passkey could not be verified. Please try again.'); }
+      if (!result.verified) fail(400, 'Your passkey was not verified.');
+      if (!store.session(req.sessionId)) fail(401, 'Your session ended. Please sign in again.');
+      const current = store.credential(credential.id);
+      if (!current || current.counter !== credential.counter) fail(409, 'Passkey changed. Please try again.');
+      store.updateCredential({ ...current, counter: result.authenticationInfo.newCounter, lastUsedAt: Date.now(), credentialBackedUp: result.authenticationInfo.credentialBackedUp });
+      if (kind === 'login') req.rotate(credential.userId);
+      else { req.session.verifiedAt = Date.now(); req.save(); }
+      res.json(state(req));
+    });
+  }
+  app.put('/api/credentials/:id', (req, res) => {
+    const user = requireUser(req.session, store);
+    const c = store.credential(req.params.id);
+    checkOwnership(c, user.id);
+    store.updateCredential({ ...c, name: text(req.body.name, 'Passkey name') });
+    res.json(state(req));
+  });
+  app.delete('/api/credentials/:id', (req, res) => {
+    const user = requireUser(req.session, store);
+    requireRecent(req.session);
+    checkOwnership(store.credential(req.params.id), user.id);
+    store.deleteCredential(req.params.id, user.id);
+    res.json(state(req));
+  });
+  app.put('/api/user', (req, res) => {
+    const user = requireUser(req.session, store);
+    requireRecent(req.session);
+    const details = profile(req.body);
+    if (store.byName(details.name)?.id && store.byName(details.name).id !== user.id) fail(409, 'That username is unavailable.');
+    store.updateUser({ ...user, ...details });
+    res.json(state(req));
+  });
+  app.use('/api', (req, res) => res.status(404).json({ error: 'Endpoint not found.' }));
+  app.get(['/account', '/logout'], (req, res) => res.redirect('/#account'));
+  app.get('/', (req, res) => res.sendFile(resolve(root, 'index.html')));
+  app.use('/assets', express.static(resolve(root, 'public/assets')));
+  app.use((error, req, res, next) => {
+    res.status(error.status || 500).json({ error: error.status ? error.message : 'Something went wrong. Please try again.' });
+  });
+  return app;
+}
