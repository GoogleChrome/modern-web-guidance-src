+      if (!body || typeof body !== 'object' || Array.isArray(body)) fail(400, 'Please send a valid request.');
+      // A session-bound limit avoids relying on untrusted proxy headers. Password attempts also use account buckets.
+      if (!session) {
+        if (!['/api/register/options','/api/login/options','/api/login/password'].includes(path)) fail(401, 'Sign in to your account to continue.');
