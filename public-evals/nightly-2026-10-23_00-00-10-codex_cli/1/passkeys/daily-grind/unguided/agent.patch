+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+
+const HOUR = 3600000;
+const hash = value => createHash('sha256').update(value).digest('hex');
+const token = () => randomBytes(32).toString('base64url');
+class HttpError extends Error { constructor(status, message) { super(message); this.status = status; } }
+const fail = (status, message) => { throw new HttpError(status, message); };
+const cleanName = value => { const name = String(value || '').trim(); if (!name || name.length > 80) fail(400, 'Please enter a name between 1 and 80 characters.'); return name; };
+
+export function createAuth({ database = ':memory:', origin = 'http://localhost:11222', now = Date.now } = {}) {
+  const url = new URL(origin);
+  if (url.protocol !== 'https:' && !['localhost', '127.0.0.1'].includes(url.hostname)) throw new Error('Passkeys require HTTPS outside localhost.');
+  const rpID = url.hostname;
+  const db = new DatabaseSync(database);
+  db.exec(`PRAGMA foreign_keys = ON;
+    PRAGMA journal_mode = WAL;
+    CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT UNIQUE NOT NULL, name TEXT NOT NULL, password TEXT, created INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, device_type TEXT, backed_up INTEGER, created INTEGER NOT NULL, last_used INTEGER);
+    CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), expires INTEGER NOT NULL, verified INTEGER NOT NULL DEFAULT 0, credential_id TEXT);
+    CREATE TABLE IF NOT EXISTS challenges (session_id TEXT PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE, challenge TEXT NOT NULL, purpose TEXT NOT NULL, user_data TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), label TEXT NOT NULL, device TEXT NOT NULL, created INTEGER NOT NULL);
+  `);
+  const limits = new Map();
+  const keysFor = id => db.prepare('SELECT * FROM passkeys WHERE user_id = ? ORDER BY created').all(id);
+  const record = (userID, label, request) => {
+    const ua = request.headers.get('user-agent') || '';
+    const device = /iPhone|iPad/.test(ua) ? 'iOS device' : /Android/.test(ua) ? 'Android device' : /Mac/.test(ua) ? 'Mac' : /Windows/.test(ua) ? 'Windows PC' : 'Web browser';
+    db.prepare('INSERT INTO events(user_id,label,device,created) VALUES(?,?,?,?)').run(userID,label,device,now());
+  };
+  const newSession = (headers, userID = null, credentialID = null) => {
+    const raw = token(); const id = hash(raw);
+    db.prepare('INSERT INTO sessions(id,user_id,expires,verified,credential_id) VALUES(?,?,?,?,?)').run(id,userID,now()+24*HOUR,userID ? now() : 0,credentialID);
+    headers.set('Set-Cookie', `grind_session=${raw}; HttpOnly; SameSite=Strict; Path=/; Max-Age=86400${url.protocol === 'https:' ? '; Secure' : ''}`);
+    return db.prepare('SELECT * FROM sessions WHERE id = ?').get(id);
+  };
+  const saveChallenge = (session, challenge, purpose, data = {}) => db.prepare('INSERT OR REPLACE INTO challenges VALUES(?,?,?,?,?)').run(session.id,challenge,purpose,JSON.stringify(data),now()+5*60000);
+  const consumeChallenge = (session, purpose) => {
+    const challenge = db.prepare('SELECT * FROM challenges WHERE session_id = ?').get(session.id);
+    db.prepare('DELETE FROM challenges WHERE session_id = ?').run(session.id);
+    if (!challenge || challenge.expires < now() || challenge.purpose !== purpose) fail(400, 'This request has expired. Please try again.');
+    return { ...challenge, data: JSON.parse(challenge.user_data) };
+  };
+  const requireUser = session => { if (!session?.user_id) fail(401, 'Sign in to your account to continue.'); return db.prepare('SELECT * FROM users WHERE id = ?').get(session.user_id); };
+  const requireRecent = session => { if (session.verified < now()-5*60000) fail(403, 'Please confirm your identity to make this change.'); };
+  const snapshot = session => {
+    if (!session?.user_id) return { user: null };
+    const user = requireUser(session);
+    return { user: { id:user.id, name:user.name, email:user.email, hasPassword:!!user.password, created:user.created },
+      passkeys:keysFor(user.id).map(k => ({ id:k.id, name:k.name, backedUp:!!k.backed_up, deviceType:k.device_type, created:k.created, lastUsed:k.last_used, current:k.id === session.credential_id })),
+      events:db.prepare('SELECT label,device,created FROM events WHERE user_id = ? ORDER BY id DESC LIMIT 20').all(user.id),
+      verifiedUntil:session.verified+5*60000 };
+  };
+  async function handle(request) {
+    const headers = new Headers({ 'Content-Type':'application/json', 'Cache-Control':'no-store', 'X-Content-Type-Options':'nosniff' });
+    try {
+      const path = new URL(request.url).pathname;
+      const method = request.method;
+      if (method !== 'GET') {
+        if (request.headers.get('origin') !== origin) fail(403, 'This request did not come from this application.');
+        if (!request.headers.get('content-type')?.startsWith('application/json')) fail(415, 'JSON is required.');
+      }
+      let session = null;
+      const cookie = request.headers.get('cookie')?.match(/(?:^|;\s*)grind_session=([\w-]+)/)?.[1];
