+};
+const icon=name=>`<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="${paths[name]||paths.shield}"/></svg>`;
+const $=selector=>document.querySelector(selector);
+const escape=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function icons(root=document){root.querySelectorAll('[data-icon]').forEach(el=>{el.outerHTML=icon(el.dataset.icon);});}
+icons();
+let state={user:null,passkeys:[],events:[]};
+let demoKeys=[{id:'example-mac',name:'MacBook Air',deviceType:'multiDevice',backedUp:true,created:Date.now()-86400000*16,lastUsed:Date.now(),current:true},{id:'example-phone',name:'iPhone 15',deviceType:'multiDevice',backedUp:true,created:Date.now()-86400000*12,lastUsed:Date.now()-86400000*2,current:false}];
+let currentSection='security';
+const dialog=$('#modal');
+let modalGeneration=0;
+let toastTimer;
+function toast(message){$('#toast').textContent=message;$('#toast').classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').classList.remove('visible'),4500);}
+function showModal(html){modalGeneration++;$('#modal-content').innerHTML=html;icons(dialog);if(!dialog.open)dialog.showModal();}
+function closeModal(){modalGeneration++;dialog.close();}
+$('#close-modal').onclick=closeModal;
+dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)closeModal();}});
+dialog.addEventListener('cancel',()=>{modalGeneration++;});
+async function api(path,body){
+ let response;
+ try{response=await fetch('/api/'+path,{method:body===undefined?'GET':'POST',headers:body===undefined?{}:{'Content-Type':'application/json'},credentials:'same-origin',...(body!==undefined?{body:JSON.stringify(body)}:{})});}catch{throw new Error('We couldn’t connect. Check your connection and try again.');}
+ let data;try{data=await response.json();}catch{throw new Error('Account services are unavailable on this static preview. Use the included application server to create an account.');}
+ if(!response.ok){if(response.status===401&&state.user){state={user:null,passkeys:[],events:[]};render();}const error=new Error(data.error||'Something went wrong. Please try again.');error.status=response.status;throw error;}return data;
+}
+function date(value){return new Date(value).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});}
+function relative(value){if(!value)return 'Not used yet';const days=Math.floor((Date.now()-value)/86400000);return days===0?'Today':days===1?'Yesterday':`${days} days ago`;}
+function render(){
+ const user=state.user,keys=user?state.passkeys:demoKeys;
+ const name=user?.name||'Alex Morgan';const initials=name.split(/\s+/).slice(0,2).map(s=>s[0]).join('').toUpperCase();
+ document.querySelectorAll('.avatar').forEach(el=>el.textContent=initials);
+ $('.header-name').textContent=user?name.split(' ')[0]:'Alex M.';
+ $('#sidebar-name').textContent=name;$('#account-caption').textContent=user?'Your daily grind':'Example account';
+ $('#sign-out').setAttribute('aria-label',user?'Sign out':'Sign in to your account');
+ $('#passkey-count').textContent=keys.length;
+ $('#passkey-list').innerHTML=keys.length?keys.map(k=>`<div class="device-row"><span class="device-icon">${icon(/phone|android|mobile/i.test(k.name)?'phone':'laptop')}</span><div class="device-details"><div class="device-name"><strong>${escape(k.name)}</strong>${k.current?'<span class="current-badge">This device</span>':''}</div><p>${k.backedUp?'Synced passkey':'Device passkey'}<span>·</span>Added ${user?date(k.created):k.id==='example-mac'?'Oct 7, 2026':'Oct 11, 2026'}</p></div><div class="device-menu"><button class="icon-button" data-menu="${escape(k.id)}" aria-label="Manage ${escape(k.name)}" aria-expanded="false">${icon('more')}</button><div class="menu-popover" data-popover="${escape(k.id)}" hidden><button data-rename="${escape(k.id)}">Rename passkey</button><button data-remove="${escape(k.id)}">Remove passkey</button></div></div></div>`).join(''):'<div class="empty-state">Your next easy sign-in starts here.<br>Add a passkey to securely access your account.</div>';
+ $('#password-badge').textContent=user?.hasPassword?'Backup enabled':'Optional';
+ $('#password-description').textContent=user?.hasPassword?'Your backup way in. Keep it unique.':'A familiar backup, if you need it.';
+ const event=user?state.events[0]:{device:'MacBook Air',label:'Signed in with a passkey',created:Date.now()};
+ $('#activity-preview').innerHTML=event?`${icon('laptop')}<div><strong>${escape(event.device)} <span class="activity-device-info"> · ${user?'Account activity':'Safari'}</span></strong><p>${escape(event.label)}${user?'':' · Example activity'}</p></div><span class="activity-time"><span class="live-dot"></span>${relative(event.created)}</span>`:'<p class="empty-state">Your sign-in activity will appear here.</p>';
