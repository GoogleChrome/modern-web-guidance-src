diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..ef548f8
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,26 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { mkdirSync } from 'node:fs';
+import { createAuth } from './lib/auth.mjs';
+const port = Number(process.env.PORT || 11222);
+mkdirSync('data',{recursive:true,mode:0o700});
+const auth = createAuth({database:process.env.DATABASE_PATH || 'data/grind.sqlite',origin:process.env.APP_ORIGIN || `http://localhost:${port}`});
+const assets = new Map([['/public/app.js',['public/app.js','text/javascript']],['/public/styles.css',['public/styles.css','text/css']],['/',['index.html','text/html']]]);
+createServer(async(req,res)=>{
+  try {
+    const path=new URL(req.url,'http://localhost').pathname;
+    if (path.startsWith('/api/')) {
+      const chunks=[];let size=0;
+      for await (const chunk of req) { size+=chunk.length;if(size>65536){res.writeHead(413);res.end();return;} chunks.push(chunk); }
+      const request=new Request(new URL(req.url,process.env.APP_ORIGIN || `http://localhost:${port}`),{method:req.method,headers:req.headers,...(req.method!=='GET'&&req.method!=='HEAD'?{body:Buffer.concat(chunks)}:{})});
+      const response=await auth.handle(request);res.writeHead(response.status,Object.fromEntries(response.headers));res.end(await response.text());return;
+    }
+    if(req.method!=='GET'&&req.method!=='HEAD'){res.writeHead(405);res.end();return;}
+    if(path==='/favicon.ico'){res.writeHead(204);res.end();return;}
+    const asset=assets.get(path);
+    if(!asset){res.writeHead(404);res.end('Not found');return;}
+    const content=await readFile(new URL(asset[0],import.meta.url));
+    res.writeHead(200,{'Content-Type':`${asset[1]}; charset=utf-8`,'X-Content-Type-Options':'nosniff','Referrer-Policy':'strict-origin-when-cross-origin','Content-Security-Policy':"default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"});
+    res.end(req.method==='HEAD'?undefined:content);
+  }catch(error){console.error(error);res.writeHead(500);res.end('Unable to load the application.');}
+}).listen(port,'0.0.0.0',()=>console.log(`The Daily Grind is listening on port ${port}`));
