+.settings-profile { display: flex; align-items: center; gap: 14px; padding: 21px 23px; border: 1px solid var(--border); border-radius: 5px; }
+.settings-avatar { display: grid; place-items: center; width: 43px; height: 43px; border-radius: 50%; background: #f1eee7; color: #867d66; font: 23px Georgia, serif; flex-shrink: 0; }
+.settings-profile-details { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+.settings-profile h3 { font-size: 13px; margin: 0 0 5px; font-weight: 600; }
+.settings-profile p { color: var(--muted); font-size: 11px; margin: 0; }
+.settings-outline-button { padding: 9px 13px; border: 1px solid #d4dbd2; border-radius: 4px; background: white; color: #4a5c49; font-size: 10px; }
+.settings-outline-button:hover, .settings-signout:hover { background: #f4f6f2; }
+.settings-passkey-banner { display: flex; gap: 17px; align-items: center; background: #f0f4eb; border: 1px solid #e0e7d7; border-radius: 5px 5px 0 0; padding: 24px; }
+.settings-banner-icon { flex-shrink: 0; display: grid; place-items: center; width: 56px; height: 60px; background: #e5eddb; border: 1px solid #d8e2cf; border-radius: 14px; color: #739063; }
+.settings-passkey-banner h3 { font: 19px/1.2 Georgia, serif; margin: 0 0 8px; }
+.settings-passkey-banner p { font-size: 11px; line-height: 1.8; margin: 0 0 9px; color: #75816f; max-width: 360px; }
+.settings-passkey-banner > div > span { display: flex; align-items: center; gap: 5px; font-size: 9px; color: #6e855c; }
+.settings-passkey-banner .auth-button { margin-left: auto; flex-shrink: 0; width: auto; min-height: 38px; font-size: 10px; padding: 10px 13px; }
+.settings-empty { text-align: center; padding: 34px 20px; border: 1px solid var(--border); border-top: 0; }
+.settings-empty-icon { color: #b1bbae; display: inline-block; margin-bottom: 10px; }
+.settings-empty h3 { font-size: 12px; margin: 0 0 9px; font-weight: 600; }
+.settings-empty p { font-size: 11px; color: #90998a; margin: 0; }
+.settings-support-note { font-size: 11px; color: #6d7865; padding: 15px; background: #f8f9f6; border: 1px solid var(--border); border-top: 0; margin: 0; }
+.settings-info { display: flex; gap: 8px; align-items: center; font-size: 10px; color: #8d9688; padding: 14px 17px; border: 1px solid var(--border); border-top: 0; border-radius: 0 0 5px 5px; line-height: 1.6; }
+.settings-info svg { flex-shrink: 0; }
+.settings-info p { margin: 0; }
+.settings-key-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-top: 0; }
+.settings-key-list li { display: flex; align-items: center; gap: 14px; padding: 22px; }
+.settings-key-list li + li { border-top: 1px solid var(--border); }
+.settings-key-icon { padding: 12px; background: #f2f5ed; border-radius: 8px; color: #70826a; }
+.settings-key-details { min-width: 0; flex: 1; }
+.settings-key-details h3 { font-size: 12px; font-weight: 600; margin: 0 0 7px; overflow-wrap: anywhere; }
+.settings-key-details p { font-size: 10px; color: #7d8978; margin: 0; line-height: 1.7; }
+.settings-key-details .settings-key-dates { font-size: 9px; color: #9ba393; margin-top: 4px; }
+.settings-key-dates span { padding: 0 4px; }
+.settings-key-actions { display: flex; gap: 14px; }
+.settings-key-actions button { background: none; border: 0; font-size: 10px; color: #5e7552; padding: 8px 0; }
+.settings-key-actions button:hover { text-decoration: underline; }
+.settings-key-actions .danger { color: #a4665b; }
+.settings-security { display: flex; gap: 15px; align-items: center; border: 1px solid var(--border); border-radius: 5px; padding: 22px; }
+.settings-security > svg { flex-shrink: 0; color: #8b9b7f; }
+.settings-security h3 { font-size: 12px; font-weight: 600; margin: 0 0 7px; }
+.settings-security p { font-size: 10px; color: #87917f; line-height: 1.8; margin: 0; max-width: 490px; }
+.settings-active { font-size: 9px; color: #69825a; background: #f0f5ea; border: 1px solid #e3ebda; border-radius: 20px; padding: 6px 9px; display: flex; align-items: center; gap: 5px; white-space: nowrap; margin-left: auto; }
+.settings-active > span { width: 4px; height: 4px; background: #83a969; border-radius: 50%; }
+.settings-loading { padding: 60px; text-align: center; color: var(--muted); font-size: 13px; }
+.settings-gate { text-align: center; padding: 45px 20px; border: 1px solid var(--border); border-radius: 5px; background: #fafbf8; }
+.settings-gate h2 { font: 29px Georgia, serif; margin: 0 0 14px; }
+.settings-gate p { font-size: 12px; color: var(--muted); margin: 0 0 20px; line-height: 1.7; }
+.settings-gate .auth-button { width: min(100%, 270px); margin: 23px auto; }
+.settings-text-button { background: none; border: none; text-decoration: underline; color: #4b7056; font-size: inherit; }
+.auth-dialog { position: fixed; inset: 0; margin: auto; padding: 31px; width: min(440px, calc(100% - 32px)); max-height: calc(100dvh - 40px); overflow: auto; background: white; color: var(--ink); border: 1px solid #e1e6dc; border-radius: 9px; box-shadow: 0 15px 70px #1d30252b; }
+.auth-dialog::backdrop { background: #1a2c2266; backdrop-filter: blur(3px); }
+.auth-dialog-symbol { width: 48px; height: 48px; border-radius: 11px; background: #eff4e9; color: #6c875a; display: grid; place-items: center; margin-bottom: 20px; }
+.auth-dialog-symbol.danger { color: #a75c4c; background: #faf0ed; }
+.auth-dialog h2 { font: 27px/1.2 Georgia, serif; margin: 0 0 12px; }
+.auth-dialog-description { font-size: 12px; line-height: 1.8; color: var(--muted); margin: 0 0 22px; }
+.auth-verify-heading { border-top: 1px solid var(--border); display: flex; align-items: center; gap: 7px; color: #577149; padding-top: 19px; margin-top: 5px; margin-bottom: 8px; }
+.auth-verify-heading h3 { font-size: 11px; margin: 0; font-weight: 600; }
+.auth-dialog .auth-small { font-size: 11px; margin-bottom: 15px; }
+.auth-verify-options { display: flex; gap: 8px; margin-bottom: 17px; }
+.auth-verify-options button { display: flex; gap: 6px; align-items: center; justify-content: center; flex: 1; padding: 10px 7px; border: 1px solid #dfe4da; color: #7a8572; border-radius: 4px; background: white; font-size: 11px; }
+.auth-verify-options button[aria-pressed="true"] { border-color: #839a74; background: #f1f5eb; color: #466333; }
+@media (min-width: 1200px) { .auth-page { padding-top: 43px; padding-bottom: 35px; } }
+@media (max-width: 800px) {
+  .auth-page { padding: 26px 24px; }
+  .auth-form-panel { padding: 35px 28px 25px; }
+  .auth-story-panel { padding: 27px 25px 24px; }
+  .auth-page h1 { font-size: 35px; }
+  .auth-story-copy h2 { font-size: 27px; }
+  .auth-story-copy p br { display: none; }
+  .settings-page { padding: 27px; }
+  .settings-passkey-banner { flex-wrap: wrap; }
+  .settings-passkey-banner > div { flex: 1; }
+  .settings-passkey-banner .auth-button { margin-left: 73px; }
+}
+@media (max-width: 580px) {
+  .auth-page { padding: 23px 18px; }
+  .auth-back { margin-bottom: 22px; }
+  .auth-layout { grid-template-columns: 1fr; }
+  .auth-form-panel { padding: 31px 26px 25px; }
+  .auth-page h1 { font-size: 37px; }
+  .auth-story-panel { border-left: 0; border-top: 1px solid #e5e9df; padding: 25px 27px; }
+  .auth-fingerprint-art { height: 160px; }
+  .auth-orbit { width: 130px; height: 130px; }
+  .orbit-two { width: 195px; height: 195px; }
+  .orbit-three { width: 260px; height: 260px; }
+  .auth-fingerprint-tile { width: 95px; height: 101px; border-radius: 22px; }
+  .auth-fingerprint-tile > svg { width: 58px; }
+  .auth-story-copy { padding-top: 17px; }
+  .auth-benefits { gap: 18px; }
+  .auth-story-copy h2 { font-size: 31px; }
+  .settings-page { padding: 24px 20px; }
+  .settings-heading h1 { font-size: 31px; }
+  .settings-heading { align-items: start; gap: 10px; }
+  .settings-signout { margin-top: 28px; padding: 9px; white-space: nowrap; }
+  .settings-signout span { margin-left: 5px; }
+  .settings-tabs-note { display: none; }
+  .settings-profile, .settings-security { padding: 17px; }
+  .settings-passkey-banner { padding: 20px; gap: 12px; }
+  .settings-passkey-banner .auth-button { width: 100%; margin: 5px 0 0; }
+  .settings-banner-icon { height: 50px; width: 46px; border-radius: 11px; }
+  .settings-passkey-banner h3 { font-size: 18px; }
+  .settings-passkey-banner p { font-size: 10px; }
+  .settings-key-list li { gap: 10px; padding: 18px 15px; flex-wrap: wrap; }
+  .settings-key-icon { padding: 9px; }
+  .settings-key-details { flex-basis: calc(100% - 60px); }
+  .settings-key-actions { margin-left: 51px; }
+  .settings-security { flex-wrap: wrap; }
+  .settings-security > div { flex: 1; }
+  .settings-active { margin-left: 40px; }
+  .settings-info { align-items: start; }
+  .auth-bottom-note { font-size: 9px; }
+  .auth-dialog { padding: 25px; }
+}
+@media (prefers-reduced-motion: reduce) { .auth-page *, .settings-page * { transition: none; } }
