diff --git a/src/pages/api/auth/[...action].ts b/src/pages/api/auth/[...action].ts
new file mode 100644
index 0000000..b2be676
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,184 @@
+import type { APIContext, APIRoute } from 'astro';
+import { createHash, randomBytes } from 'node:crypto';
+import {
+  generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+import { db, type Account, type AuthSession, type Passkey, type Challenge } from '../../../server/auth-store';
+
+const cookieName = 'times_auth';
+const passwordAPI = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const opaque = () => randomBytes(32).toString('base64url');
+const hash = (s: string) => createHash('sha256').update(s).digest('hex');
+class AuthError extends Error {
+  constructor(message: string, public status = 400) { super(message); }
+}
+function reply(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+}
+function getSession(ctx: APIContext): AuthSession | undefined {
+  const token = ctx.cookies.get(cookieName)?.value;
+  if (!token) return;
+  return db().prepare('SELECT * FROM auth_sessions WHERE token = ? AND expires > ?').get(hash(token), Date.now()) as unknown as AuthSession | undefined;
+}
+function newSession(ctx: APIContext, accountId: string | null, verified = false): AuthSession {
+  const token = opaque();
+  const value = { token: hash(token), account_id: accountId, expires: Date.now() + 7 * 86400000, verified_at: verified ? Date.now() : 0 };
+  db().prepare('INSERT INTO auth_sessions (token, account_id, expires, verified_at) VALUES (?, ?, ?, ?)').run(value.token, value.account_id, value.expires, value.verified_at);
+  ctx.cookies.set(cookieName, token, { path: import.meta.env.BASE_URL, httpOnly: true, sameSite: 'lax', secure: ctx.url.protocol === 'https:', maxAge: 7 * 86400 });
+  return value;
+}
+function requireAccount(session?: AuthSession): Account {
+  if (!session?.account_id) throw new AuthError('Please sign in to continue.', 401);
+  const account = db().prepare('SELECT * FROM accounts WHERE id = ?').get(session.account_id) as unknown as Account | undefined;
+  if (!account) throw new AuthError('Please sign in again.', 401);
+  return account;
+}
+function requireRecent(session: AuthSession) {
+  if (Date.now() - session.verified_at > 5 * 60000) throw new AuthError('Please verify your identity to make this change.', 403);
+}
+function keys(accountId: string, rpId: string) {
+  return db().prepare('SELECT * FROM passkeys WHERE account_id = ? AND rp_id = ? ORDER BY registered_at DESC').all(accountId, rpId) as unknown as Passkey[];
+}
+function accountData(account: Account, rpId: string) {
+  return { user: { id: account.id, username: account.username, displayName: account.display_name }, rpId,
+    passkeys: keys(account.id, rpId).map(k => ({ id: k.id, name: k.name, aaguid: k.aaguid, registeredAt: k.registered_at, lastUsedAt: k.last_used_at, backedUp: !!k.backed_up })) };
+}
+function label(value: unknown) {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > 64) throw new AuthError('Enter a name between 1 and 64 characters.');
+  return value.trim();
+}
+const handler: APIRoute = async ctx => {
+  try {
+    const origin = process.env.AUTH_ORIGIN || ctx.url.origin;
+    const rpId = new URL(origin).hostname;
+    const action = ctx.params.action || '';
