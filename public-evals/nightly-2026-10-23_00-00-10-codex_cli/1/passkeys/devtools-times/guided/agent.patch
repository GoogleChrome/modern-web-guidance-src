@@ -0,0 +1,77 @@
+export interface SavedPasskey { id: string; name: string; aaguid: string; registeredAt: number; lastUsedAt: number | null; backedUp: boolean }
+export interface AccountData { user: { id: string; username: string; displayName: string }; rpId: string; passkeys: SavedPasskey[] }
+export class APIError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+export async function api<T = AccountData>(action: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body), signal,
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new APIError(data.error || 'Something went wrong. Please try again.', response.status);
+  return data as T;
+}
+export async function capabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return null;
+  await import('webauthn-polyfills');
+  return PublicKeyCredential.getClientCapabilities();
+}
+export function authMessage(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was canceled or timed out. You can try again or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection and the correct site address. You can still use your password.';
+    if (error.name === 'AbortError') return '';
+  }
+  return error instanceof APIError ? error.message : 'We couldn’t connect. Please try again.';
+}
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (PublicKeyCredential.signalUnknownCredential) {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }).catch(() => {});
+  }
+}
+export async function authenticate(purpose: 'authenticate' | 'reauth', signal: AbortSignal, conditional = false) {
+  const { options, requestId } = await api<{ options: PublicKeyCredentialRequestOptionsJSON; requestId: string }>(`${purpose}/options`, {}, signal);
+  const credential = await navigator.credentials.get({
+    publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options), signal,
+    ...(conditional ? { mediation: 'conditional' as const } : {}),
+  }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('No credential returned', 'NotAllowedError');
+  try {
+    return await api(`${purpose}/verify`, { credential: credential.toJSON(), requestId }, signal);
+  } catch (error) {
+    if (purpose === 'authenticate' && error instanceof APIError && error.status === 404) {
+      const state = await api<{ user: unknown }>('me').catch(() => null);
+      if (state?.user === null) await signalUnknown(options.rpId!, credential.id);
+    }
+    throw error;
+  }
+}
+export async function registerPasskey(name: string, signal: AbortSignal, promotion = false) {
+  const { options, requestId } = await api<{ options: PublicKeyCredentialCreationOptionsJSON; requestId: string }>('register/options', { promotion }, signal);
+  const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options), signal }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('No credential returned', 'NotAllowedError');
+  try {
+    return await api('register/verify', { credential: credential.toJSON(), requestId, name }, signal);
+  } catch (error) {
+    // A lost verification response can follow a successful write. Check the
+    // authoritative list before telling a password manager to discard anything.
+    const state = await api<AccountData | { user: null }>('me').catch(() => null);
+    if (state?.user && !(state as AccountData).passkeys.some(key => key.id === credential.id)) {
+      await signalUnknown(options.rp.id!, credential.id);
+    }
+    throw error;
+  }
+}
+export async function syncPasskeys(data: AccountData) {
+  if (window.PublicKeyCredential?.signalAllAcceptedCredentials) {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: data.rpId, userId: data.user.id, allAcceptedCredentialIds: data.passkeys.map(k => k.id) }).catch(() => {});
+  }
+}
+export async function syncProfile(data: AccountData) {
+  if (window.PublicKeyCredential?.signalCurrentUserDetails) {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId: data.rpId, userId: data.user.id, name: data.user.username, displayName: data.user.displayName }).catch(() => {});
+  }
+}
