+        rpName: 'The DevTools Times', rpID: rpId, userID: Buffer.from(account!.id, 'base64url'),
+        userName: account!.username, userDisplayName: account!.display_name, attestationType: 'none',
+        excludeCredentials: descriptors, authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred', ...(body.promotion ? { authenticatorAttachment: 'platform' as const } : {}) },
