+    if (action === 'logout') {
+      if (session) db().prepare('DELETE FROM auth_sessions WHERE token = ?').run(session.token);
+      ctx.cookies.delete(cookieName, { path: import.meta.env.BASE_URL });
+      return reply({ success: true });
+    }
+    if (action.endsWith('/options')) {
+      const purpose = action.split('/')[0];
+      if (!['register', 'authenticate', 'reauth'].includes(purpose)) throw new AuthError('Not found.', 404);
+      const account = purpose !== 'authenticate' ? requireAccount(session) : undefined;
