diff --git a/src/server/auth-store.ts b/src/server/auth-store.ts
new file mode 100644
index 0000000..f252036
--- /dev/null
+++ b/src/server/auth-store.ts
@@ -0,0 +1,46 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+
+let database: DatabaseSync;
+export function db() {
+  if (!database) {
+    const path = resolve(process.env.AUTH_DATABASE_PATH || '.data/auth.sqlite');
+    mkdirSync(dirname(path), { recursive: true });
+    database = new DatabaseSync(path);
+    database.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA foreign_keys = ON;
+      CREATE TABLE IF NOT EXISTS accounts (
+        id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE, display_name TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, account_id TEXT NOT NULL REFERENCES accounts(id), rp_id TEXT NOT NULL,
+        public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL,
+        name TEXT NOT NULL, aaguid TEXT NOT NULL, device_type TEXT NOT NULL,
+        backed_up INTEGER NOT NULL, registered_at INTEGER NOT NULL, last_used_at INTEGER
+      );
+      CREATE TABLE IF NOT EXISTS auth_sessions (
+        token TEXT PRIMARY KEY, account_id TEXT REFERENCES accounts(id), expires INTEGER NOT NULL,
+        verified_at INTEGER NOT NULL DEFAULT 0
+      );
+      CREATE TABLE IF NOT EXISTS auth_challenges (
+        id TEXT PRIMARY KEY, session_token TEXT NOT NULL, challenge TEXT NOT NULL,
+        purpose TEXT NOT NULL, expires INTEGER NOT NULL, origin TEXT NOT NULL, rp_id TEXT NOT NULL,
+        account_id TEXT, require_uv INTEGER NOT NULL
+      );
+    `);
+  }
+  return database;
+}
+export interface Account { id: string; username: string; display_name: string }
+export interface AuthSession { token: string; account_id: string | null; expires: number; verified_at: number }
+export interface Passkey {
+  id: string; account_id: string; rp_id: string; public_key: string; counter: number;
+  transports: string; name: string; aaguid: string; device_type: string; backed_up: number;
+  registered_at: number; last_used_at: number | null;
+}
+export interface Challenge {
+  id: string; session_token: string; challenge: string; purpose: string; expires: number;
+  origin: string; rp_id: string; account_id: string | null; require_uv: number;
+}
