index 0000000..0d9c958
--- /dev/null
+++ b/src/lib/auth-client.ts
@@ -0,0 +1,33 @@
+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export interface KeyInfo { id: string; name: string; backed_up: number; created_at: number; last_used: number | null }
+export interface Account { user: { name: string; email: string; hasPassword: boolean }; passkeys: KeyInfo[] }
+export const base = import.meta.env.BASE_URL;
+export async function api<T = Account>(action: string, body?: Record<string, unknown>): Promise<T> {
+  const response = await fetch(`${base}api/auth/${action}`, { method: body ? 'POST' : 'GET', credentials: 'same-origin', headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
+  return data;
+}
+export function supportsPasskeys() { return window.isSecureContext && browserSupportsWebAuthn(); }
+export async function registerPasskey(details: Record<string, unknown>) {
+  const optionsJSON = await api<Parameters<typeof startRegistration>[0]['optionsJSON']>('registration-options', details);
+  const credential = await startRegistration({ optionsJSON });
+  return api('registration-verify', { credential });
+}
+export async function authenticatePasskey(reauth = false) {
+  const optionsJSON = await api<Parameters<typeof startAuthentication>[0]['optionsJSON']>('authentication-options', { reauth });
+  const credential = await startAuthentication({ optionsJSON });
+  return api('authentication-verify', { credential });
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof Error) {
+    const code = 'code' in error ? String(error.code) : '';
+    const causeName = error.cause instanceof Error ? error.cause.name : error.name;
+    if (['NotAllowedError', 'AbortError'].includes(causeName) || code === 'ERROR_CEREMONY_ABORTED') return 'The passkey request was cancelled or timed out. You can try again or use your password.';
+    if (causeName === 'InvalidStateError' || code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') return 'This device already has a passkey for your account. Try signing in with it.';
+    if (causeName === 'SecurityError' || ['ERROR_INVALID_DOMAIN', 'ERROR_INVALID_RP_ID'].includes(code)) return 'Passkeys need a secure connection on this site. Please use HTTPS or try your password.';
+    if (code.includes('MISSING_DISCOVERABLE') || code.includes('MISSING_USER_VERIFICATION')) return 'This authenticator can’t create a passkey. Try another device or use a password.';
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..69dc628
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,33 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes, scryptSync, timingSafeEqual, createHash } from 'node:crypto';
+
+let database: DatabaseSync;
+export function db() {
+  if (!database) {
+    const path = resolve(process.env.AUTH_DATABASE_PATH || '.data/auth.sqlite');
+    mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode = WAL;
+      PRAGMA foreign_keys = ON;
+      CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT UNIQUE NOT NULL, name TEXT NOT NULL, password TEXT);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, backed_up INTEGER NOT NULL, created_at INTEGER NOT NULL, last_used INTEGER);
+      CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), expires INTEGER NOT NULL, verified_at INTEGER NOT NULL DEFAULT 0, challenge TEXT);
+    `);
+  }
+  return database;
+}
+export const randomID = () => randomBytes(32).toString('base64url');
+export const digest = (value: string) => createHash('sha256').update(value).digest('hex');
+export function hashPassword(value: string) {
+  const salt = randomID();
+  return `${salt}:${scryptSync(value, salt, 64).toString('hex')}`;
+}
+export function checkPassword(value: string, stored: string) {
+  const [salt, hash] = stored.split(':');
+  return timingSafeEqual(scryptSync(value, salt, 64), Buffer.from(hash, 'hex'));
+}
+export interface User { id: string; email: string; name: string; password: string | null }
+export interface Session { id: string; user_id: string | null; expires: number; verified_at: number; challenge: string | null }
+export interface Passkey { id: string; user_id: string; name: string; public_key: string; counter: number; transports: string; backed_up: number; created_at: number; last_used: number | null }
