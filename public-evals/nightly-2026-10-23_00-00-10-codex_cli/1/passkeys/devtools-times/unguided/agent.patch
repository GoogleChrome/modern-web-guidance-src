diff --git a/src/pages/api/auth/[action].ts b/src/pages/api/auth/[action].ts
new file mode 100644
index 0000000..c853df9
--- /dev/null
+++ b/src/pages/api/auth/[action].ts
@@ -0,0 +1,186 @@
+import type { APIRoute, APIContext } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse, type AuthenticatorTransport } from '@simplewebauthn/server';
+import { db, randomID, digest, hashPassword, checkPassword, type User, type Session, type Passkey } from '../../../lib/auth-store';
+
+const COOKIE = 'times_session';
+const DAY = 86400000;
+const limits = new Map<string, { count: number; expires: number }>();
+class AuthError extends Error { constructor(message: string, public status = 400) { super(message); } }
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+function session(context: APIContext): Session | undefined {
+  const token = context.cookies.get(COOKIE)?.value;
+  return token ? db().prepare('SELECT * FROM sessions WHERE id = ? AND expires > ?').get(digest(token), Date.now()) as Session | undefined : undefined;
+}
+function newSession(context: APIContext, userID: string | null = null) {
+  const token = randomID();
+  const id = digest(token);
+  db().prepare('DELETE FROM sessions WHERE expires < ?').run(Date.now());
+  db().prepare('INSERT INTO sessions (id, user_id, expires, verified_at) VALUES (?, ?, ?, ?)').run(id, userID, Date.now() + DAY * 7, userID ? Date.now() : 0);
+  context.cookies.set(COOKIE, token, { httpOnly: true, secure: context.url.protocol === 'https:', sameSite: 'lax', path: import.meta.env.BASE_URL, maxAge: DAY * 7 / 1000 });
+  return db().prepare('SELECT * FROM sessions WHERE id = ?').get(id) as unknown as Session;
+}
+function requireUser(s: Session | undefined) {
+  const user = s?.user_id && db().prepare('SELECT * FROM users WHERE id = ?').get(s.user_id) as User | undefined;
+  if (!user) throw new AuthError('Please sign in to manage your account.', 401);
+  return user;
+}
+function requireRecent(s: Session) {
+  if (Date.now() - s.verified_at > 5 * 60000) throw new AuthError('Please verify your identity again to continue.', 403);
+}
+function identity(body: Record<string, any>) {
+  const email = String(body.email || '').trim().toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) throw new AuthError('Enter a valid email address.');
+  const name = String(body.name || email.split('@')[0]).trim().slice(0, 80);
+  return { email, name };
+}
+function password(value: unknown) {
+  if (typeof value !== 'string' || value.length < 8 || value.length > 128 || !/\d/.test(value)) throw new AuthError('Use 8–128 characters, including at least one number.');
+  return value;
+}
+function profile(user: User) {
+  const keys = db().prepare('SELECT id, name, backed_up, created_at, last_used FROM passkeys WHERE user_id = ? ORDER BY created_at').all(user.id);
+  return { user: { name: user.name, email: user.email, hasPassword: !!user.password }, passkeys: keys };
+}
+
+export const GET: APIRoute = async context => {
+  try { return json(profile(requireUser(session(context)))); }
+  catch (error) { return json({ error: (error as Error).message }, 401); }
+};
+
+export const POST: APIRoute = async context => {
+  try {
+    const { request, url, params } = context;
+    // All credential operations are same-origin, including when Astro's global check is disabled.
+    if (request.headers.get('origin') !== url.origin) throw new AuthError('This request could not be verified. Refresh the page and try again.', 403);
+    if (Number(request.headers.get('content-length') || 0) > 32768) throw new AuthError('Request too large.', 413);
+    const rateKey = `${context.clientAddress}:${params.action}`;
+    const now = Date.now();
+    if (limits.size > 10000) for (const [key, value] of limits) if (value.expires < now) limits.delete(key);
+    const limit = limits.get(rateKey);
+    if (limit && limit.expires > now && limit.count >= 20) throw new AuthError('Too many attempts. Please wait a minute and try again.', 429);
+    limits.set(rateKey, { count: limit && limit.expires > now ? limit.count + 1 : 1, expires: limit && limit.expires > now ? limit.expires : now + 60000 });
+    const text = await request.text();
+    if (text.length > 32768) throw new AuthError('Request too large.', 413);
+    const body = JSON.parse(text || '{}');
+    let s = session(context);
+    const rpID = url.hostname;
+    const expectedOrigin = url.origin;
+    const action = params.action;
+
+    if (action === 'logout') {
+      if (s) db().prepare('DELETE FROM sessions WHERE id = ?').run(s.id);
+      context.cookies.delete(COOKIE, { path: import.meta.env.BASE_URL });
+      return json({ ok: true });
+    }
+    if (action === 'signup' || action === 'login') {
+      let user: User | undefined;
+      if (action === 'signup') {
+        const { email, name } = identity(body);
+        const hash = hashPassword(password(body.password));
+        if (db().prepare('SELECT id FROM users WHERE email = ?').get(email)) throw new AuthError('An account with this email already exists. Please sign in.');
+        const id = randomID();
+        db().prepare('INSERT INTO users (id, email, name, password) VALUES (?, ?, ?, ?)').run(id, email, name, hash);
+        user = db().prepare('SELECT * FROM users WHERE id = ?').get(id) as unknown as User;
+      } else {
+        user = db().prepare('SELECT * FROM users WHERE email = ?').get(String(body.email || '').trim().toLowerCase()) as User | undefined;
