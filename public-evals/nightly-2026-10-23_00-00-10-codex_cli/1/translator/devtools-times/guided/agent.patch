+<article-translation class="translation-panel" hidden>
+  <div class="translation-intro">
+    <span class="translation-icon" aria-hidden="true">
+      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5h12M9 3v2M5 5c1 6 5 9 9 11M13 5c-1 6-5 9-10 11M13 21l4-11 4 11M14.5 17h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
+    </span>
+    <div>
+      <div class="translation-heading"><h2>Read in your language</h2><span class="translation-badge">ON DEVICE</span></div>
+      <p>Translate articles and headlines privately in your browser.</p>
+    </div>
+  </div>
+  <form class="translation-form">
+    <span class="translation-source">English <span aria-hidden="true">→</span></span>
+    <label class="sr-only" for="translation-language">Translate stories into</label>
+    <select id="translation-language" name="language" aria-describedby="translation-status">
+      <option value="en">English · Original</option>
+      <option value="ar">العربية · Arabic</option>
+      <option value="zh">中文 · Chinese</option>
+      <option value="nl">Nederlands · Dutch</option>
+      <option value="fr">Français · French</option>
+      <option value="de">Deutsch · German</option>
+      <option value="hi">हिन्दी · Hindi</option>
+      <option value="it">Italiano · Italian</option>
+      <option value="ja">日本語 · Japanese</option>
+      <option value="ko">한국어 · Korean</option>
+      <option value="pl">Polski · Polish</option>
+      <option value="pt">Português · Portuguese</option>
+      <option value="ru">Русский · Russian</option>
+      <option value="es" selected>Español · Spanish</option>
+      <option value="tr">Türkçe · Turkish</option>
+      <option value="uk">Українська · Ukrainian</option>
+      <option value="vi">Tiếng Việt · Vietnamese</option>
+    </select>
+    <button type="submit" class="translation-submit" disabled>Translate stories <span aria-hidden="true">↗</span></button>
+    <button type="button" class="translation-restore" hidden>Show original</button>
+  </form>
+  <p id="translation-status" class="translation-status" role="status" aria-live="polite" aria-atomic="true">Checking browser support…</p>
+  <noscript><p>Enable JavaScript to use on-device translation.</p></noscript>
+</article-translation>
+
+<script>
+  import '../scripts/translation';
+</script>
+
+<style>
+  .translation-panel { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin: 20px 24px 0; padding: 20px 22px 14px; border: 1px solid #e6dfd0; border-top: 3px solid #b88736; background: #fcfaf5; border-radius: 2px; color: #292b2e; }
+  .translation-panel[hidden], [hidden] { display: none; }
+  .translation-intro { display: flex; align-items: center; gap: 12px; flex: 1 1 300px; }
+  .translation-icon { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; border: 1px solid #e4dccb; border-radius: 50%; color: #805c25; }
+  .translation-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
+  h2 { font-family: 'Grenze', serif; font-size: 23px; line-height: 1.2; }
+  .translation-badge { color: #6a633f; background: #eeeddf; border-radius: 3px; padding: 3px 6px; font-size: 9px; font-weight: 700; letter-spacing: .08em; }
+  .translation-intro p { font-size: 12px; color: #69665e; margin-top: 5px; }
+  .translation-form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+  .translation-source { font-size: 12px; color: #69665e; display: flex; gap: 10px; margin-right: 2px; }
+  select { background: white; border: 1px solid #d7d2c7; border-radius: 4px; padding: 10px 24px 10px 10px; max-width: 100%; font-size: 12px; min-height: 40px; }
+  button { cursor: pointer; min-height: 40px; font-size: 12px; font-weight: 600; border-radius: 4px; padding: 10px 13px; }
+  button:disabled, select:disabled { cursor: not-allowed; opacity: .55; }
+  .translation-submit { background: #292e35; color: white; display: flex; align-items: center; gap: 12px; }
+  .translation-submit:hover:enabled { background: #464c54; }
+  .translation-restore { color: #66522e; text-decoration: underline; text-underline-offset: 3px; }
+  :is(select, button):focus-visible { outline: 2px solid #986816; outline-offset: 3px; }
+  .translation-status { width: 100%; border-top: 1px solid #eae5da; padding-top: 10px; color: #716b60; font-size: 11px; line-height: 1.5; }
+  .translation-panel[data-error] .translation-status { color: #974215; }
+  @media (max-width: 640px) {
+    .translation-panel { margin: 16px 16px 0; padding: 16px; gap: 16px; }
+    .translation-form { width: 100%; }
+    .translation-source { width: 100%; }
+    select { flex: 1; min-width: 0; }
+  }
+</style>
