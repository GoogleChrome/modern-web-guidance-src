diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..f672e26
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,144 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type TranslationSession = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslationOptions = { sourceLanguage: string; targetLanguage: string };
+type TranslatorAPI = {
+  availability(options: TranslationOptions): Promise<Availability>;
+  create(options: TranslationOptions & {
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }): void;
+  }): Promise<TranslationSession>;
+};
+
+class ArticleTranslation extends HTMLElement {
+  private controller = new AbortController();
+  private session?: TranslationSession;
+  private originals = new Map<Text, string>();
+  private regions: HTMLElement[] = [];
+  private revision = 0;
+  private busy = false;
+  private availability?: Promise<Availability>;
+
+  connectedCallback() {
+    this.controller = new AbortController();
+    this.regions = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]'));
+    if (!this.regions.length) return;
+    this.hidden = false;
+    const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    const form = this.querySelector('form')!;
+    const select = this.querySelector('select')!;
+    const submit = this.querySelector<HTMLButtonElement>('[type="submit"]')!;
+    const restore = this.querySelector<HTMLButtonElement>('.translation-restore')!;
+    const status = this.querySelector<HTMLElement>('[role="status"]')!;
+    const signal = this.controller.signal;
+    const say = (message: string, error = false) => {
+      status.textContent = message;
+      this.toggleAttribute('data-error', error);
+    };
+    const ready = async () => {
+      const revision = ++this.revision;
+      submit.disabled = true;
+      if (select.value === 'en') {
+        say('Select Translate stories to return to the English original.');
+        submit.disabled = false;
+        this.availability = undefined;
+        return;
+      }
+      if (!api) return;
+      say('Checking this language on your device…');
+      this.availability = api.availability({ sourceLanguage: 'en', targetLanguage: select.value });
+      try {
+        const result = await this.availability;
+        if (revision !== this.revision || signal.aborted) return;
+        submit.disabled = result === 'unavailable';
+        say(result === 'unavailable'
+          ? 'This language pair isn’t available on your device. Try another language.'
+          : result === 'available'
+            ? 'Ready to translate on your device. Article text stays in your browser.'
+            : 'First use downloads a language pack. Translation runs on your device.', result === 'unavailable');
+      } catch {
+        if (revision === this.revision && !signal.aborted) say('Couldn’t check language support. Select a language to try again.', true);
+      }
+    };
+    const showOriginal = () => {
+      for (const [node, original] of this.originals) node.textContent = original;
+      this.regions.forEach(region => { region.lang = 'en'; region.dir = 'auto'; });
+      restore.hidden = true;
+      say('Showing the original English stories.');
+    };
+    restore.addEventListener('click', showOriginal, { signal });
+    select.addEventListener('change', ready, { signal });
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (this.busy || submit.disabled) return;
+      if (select.value === 'en') { showOriginal(); return; }
+      if (!api) return;
+      const targetLanguage = select.value;
+      this.busy = true;
+      select.disabled = submit.disabled = restore.disabled = true;
+      this.setAttribute('aria-busy', 'true');
+      say('Preparing on-device translation…');
+      try {
+        // Availability is checked before the click so create retains user activation.
+        // Always translate the English originals, never a previous translation.
+        this.session = await api.create({
+          sourceLanguage: 'en', targetLanguage, signal,
+          monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+            if (!signal.aborted) say(`Downloading language pack… ${Math.round(event.loaded * 100)}%`);
+          }),
+        });
+        const nodes: Text[] = [];
+        for (const region of this.regions) {
+          const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT, {
+            acceptNode: node => node.textContent?.trim() && !node.parentElement?.closest('script, style, pre, code, [translate="no"]')
+              ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+          });
+          while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+        }
+        const results: [Text, string][] = [];
+        for (const [index, node] of nodes.entries()) {
+          if (signal.aborted) return;
+          const original = this.originals.get(node) ?? node.textContent ?? '';
+          this.originals.set(node, original);
+          say(`Translating stories… ${Math.round(index / nodes.length * 100)}%`);
+          const translated = await this.session.translate(original.trim());
+          results.push([node, original.replace(/\S[\s\S]*\S|\S/, () => translated)]);
+        }
+        if (signal.aborted) return;
+        // Commit together so failures leave the currently displayed stories intact.
+        for (const [node, translated] of results) node.textContent = translated;
+        this.regions.forEach(region => { region.lang = targetLanguage; region.dir = 'auto'; });
+        restore.hidden = false;
+        const language = select.selectedOptions[0].textContent;
+        say(`Translated into ${language}. Machine translations may contain errors.`);
+      } catch {
+        if (!signal.aborted) say('Translation couldn’t finish. Your stories haven’t changed. Please try again or choose another language.', true);
+      } finally {
+        this.session?.destroy();
+        this.session = undefined;
+        this.busy = false;
+        if (!signal.aborted) {
+          select.disabled = submit.disabled = restore.disabled = false;
+          this.removeAttribute('aria-busy');
+        }
+      }
+    }, { signal });
+    if (!api) {
+      select.disabled = true;
+      say('On-device translation isn’t supported in this browser. Try a supported desktop Chrome or Edge browser. You can still read every story in English.');
+    } else {
+      void ready();
+    }
+  }
+
+  disconnectedCallback() {
+    this.revision++;
+    this.controller.abort();
+    this.session?.destroy();
+    this.session = undefined;
+  }
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
