diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..ff5ea68
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,146 @@
+// Native on-device translation. No article text is sent to a translation service.
+type TranslationSession = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<string>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }): void;
+  }): Promise<TranslationSession>;
+};
+
+class ArticleTranslator extends HTMLElement {
+  private originals = new Map<Text, string>();
+  private session?: TranslationSession;
+  private controller?: AbortController;
+  private revision = 0;
+
+  connectedCallback() {
+    const select = this.querySelector<HTMLSelectElement>('[data-language]')!;
+    const translate = this.querySelector<HTMLButtonElement>('[data-translate]')!;
+    const restore = this.querySelector<HTMLButtonElement>('[data-restore]')!;
+    const status = this.querySelector<HTMLElement>('[data-status]')!;
+    const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    const supported = Boolean(api && window.isSecureContext);
+    translate.disabled = !supported;
+    status.textContent = supported
+      ? 'Translate headlines, teasers, and articles. A language pack may download on first use.'
+      : 'Translation requires a desktop browser with the on-device Translator API, such as Chrome, over HTTPS.';
+    try { select.value = sessionStorage.getItem('news-translation-language') || 'es'; } catch { /* Storage is optional. */ }
+    if (!select.value) select.value = 'es';
+
+    restore.onclick = () => {
+      this.cancel();
+      for (const [node, text] of this.originals) node.textContent = text;
+      document.querySelectorAll<HTMLElement>('[data-translatable]').forEach(element => {
+        element.lang = 'en';
+        element.removeAttribute('dir');
+      });
+      translate.disabled = !supported;
+      translate.innerHTML = 'Translate page <span aria-hidden="true">↗</span>';
+      select.disabled = false;
+      restore.disabled = true;
+      this.removeAttribute('aria-busy');
+      status.textContent = 'You’re reading the original English edition.';
+    };
+
+    translate.onclick = async () => {
+      if (!api) return;
+      this.cancel();
+      const revision = this.revision;
+      const controller = new AbortController();
+      this.controller = controller;
+      const current = () => this.isConnected && revision === this.revision;
+      const targetLanguage = select.value;
+      const language = select.selectedOptions[0].textContent!.split(' — ')[1];
+      translate.disabled = true;
+      select.disabled = true;
+      restore.disabled = false;
+      translate.textContent = 'Translating…';
+      this.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing on-device translation…';
+      try {
+        const options = { sourceLanguage: 'en', targetLanguage };
+        const availability = await api.availability(options);
+        if (!current()) return;
+        if (availability === 'unavailable') throw new Error('pair-unavailable');
+        const session = await api.create({
+          ...options,
+          signal: controller.signal,
+          monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+            if (current()) status.textContent = `Downloading language pack… ${Math.round(event.loaded * 100)}%`;
+          }),
+        });
+        if (!current()) { session.destroy(); return; }
+        this.session = session;
+        const elements = [...document.querySelectorAll<HTMLElement>('[data-translatable]')];
+        const nodes: Text[] = [];
+        for (const element of elements) {
+          const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+            acceptNode: node => node.textContent?.trim() && !node.parentElement?.closest('code, pre, script, style, [translate="no"]')
+              ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+          });
+          while (walker.nextNode()) {
+            const node = walker.currentNode as Text;
+            if (!this.originals.has(node)) this.originals.set(node, node.textContent!);
+            nodes.push(node);
+          }
+        }
+        const results = new Map<Text, string>();
+        const cache = new Map<string, string>();
+        for (const node of nodes) {
+          if (!current()) return;
+          const original = this.originals.get(node)!;
+          let result = cache.get(original);
+          if (result === undefined) {
+            result = await session.translate(original.trim());
+            cache.set(original, result);
+          }
+          results.set(node, original.replace(/\S[\s\S]*\S|\S/, () => result!));
+          if (current()) status.textContent = `Translating to ${language}… ${Math.round(results.size / nodes.length * 100)}%`;
+        }
+        if (!current()) return;
+        // Commit only after every translation succeeds, preserving links and formatting.
+        for (const [node, result] of results) node.textContent = result;
+        for (const element of elements) {
+          element.lang = targetLanguage;
+          element.dir = targetLanguage === 'ar' ? 'rtl' : 'ltr';
+        }
+        try { sessionStorage.setItem('news-translation-language', targetLanguage); } catch { /* Storage is optional. */ }
+        status.textContent = `Now reading in ${language}. Translated on your device; translations may vary in accuracy.`;
+      } catch (error) {
+        if (!current()) return;
+        status.textContent = error instanceof Error && error.message === 'pair-unavailable'
+          ? 'This language is unavailable on your device. Choose another language and try again.'
+          : 'Translation couldn’t finish. Check your language pack download or try another language. Your text has been preserved.';
+      } finally {
+        if (current()) {
+          this.session?.destroy();
+          this.session = undefined;
+          translate.disabled = false;
+          translate.innerHTML = 'Translate page <span aria-hidden="true">↗</span>';
+          select.disabled = false;
+          this.removeAttribute('aria-busy');
+        }
+      }
+    };
+  }
+
+  private cancel() {
+    this.revision++;
+    this.controller?.abort();
+    this.session?.destroy();
+    this.session = undefined;
+  }
+
+  disconnectedCallback() {
+    this.cancel();
+    this.originals.clear();
+  }
+}
+
+if (!customElements.get('article-translator')) customElements.define('article-translator', ArticleTranslator);
