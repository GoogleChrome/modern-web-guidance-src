diff --git a/src/components/TranslationControl.astro b/src/components/TranslationControl.astro
new file mode 100644
index 0000000..e84cdb9
--- /dev/null
+++ b/src/components/TranslationControl.astro
@@ -0,0 +1,88 @@
+---
+const languages = [
+  ['es', 'Español', 'Spanish'], ['fr', 'Français', 'French'],
+  ['de', 'Deutsch', 'German'], ['it', 'Italiano', 'Italian'],
+  ['pt', 'Português', 'Portuguese'], ['ja', '日本語', 'Japanese'],
+  ['ko', '한국어', 'Korean'], ['zh', '中文', 'Chinese'],
+  ['ar', 'العربية', 'Arabic'], ['hi', 'हिन्दी', 'Hindi'],
+  ['nl', 'Nederlands', 'Dutch'], ['uk', 'Українська', 'Ukrainian'],
+];
+---
+<article-translator class="translation-control" translate="no">
+  <section aria-labelledby="translation-heading">
+    <div class="translation-intro">
+      <div class="translation-title">
+        <span class="translation-icon" aria-hidden="true">
+          <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6m-7 0 6-6 2-5M2 5h13M8 2v3m6 16 4-10 4 10m-6.5-4h5" /></svg>
+        </span>
+        <div>
+          <div class="translation-eyebrow">A WORLD OF PERSPECTIVES</div>
+          <h2 id="translation-heading" class="font-brand">Read the news in your language.</h2>
+        </div>
+      </div>
+      <span class="translation-local"><span aria-hidden="true"></span> On-device translation</span>
+    </div>
+    <div class="translation-actions">
+      <div class="translation-source"><span class="translation-label">Original language</span><span>English <span class="translation-original">Original</span></span></div>
+      <svg class="translation-arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
+      <label class="translation-target"><span class="translation-label">Translate to</span>
+        <select aria-label="Translation language" data-language>
+          {languages.map(([code, native, english]) => <option value={code}>{native} — {english}</option>)}
+        </select>
+      </label>
+      <button class="translation-submit" data-translate disabled>Translate page <span aria-hidden="true">↗</span></button>
+      <button class="translation-reset" data-restore disabled>Show original</button>
+    </div>
+    <div class="translation-footer">
+      <p data-status role="status" aria-live="polite">Checking on-device translation availability…</p>
+      <span class="translation-privacy"><svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Your reading stays on your device</span>
+    </div>
+    <noscript><p class="translation-noscript">Enable JavaScript to use on-device translation.</p></noscript>
+  </section>
+</article-translator>
+
+<script>
+  import '../scripts/translation';
+</script>
+
+<style>
+  .translation-control { display:block; margin:24px 24px 0; color:#292820; background:#faf9f5; border:1px solid #e8e4d9; border-radius:8px; }
+  section { padding:22px 26px 0; }
+  .translation-intro,.translation-title,.translation-actions,.translation-footer,.translation-privacy { display:flex; align-items:center; }
+  .translation-intro { justify-content:space-between; gap:16px; }
+  .translation-title { gap:14px; }
+  .translation-icon { display:grid; place-items:center; color:#92652c; background:#efe9db; width:46px; height:46px; border-radius:50%; flex-shrink:0; }
+  .translation-eyebrow { font:600 9px/1.5 Arial,sans-serif; letter-spacing:1.7px; color:#8a795d; }
+  h2 { font-size:26px; line-height:1.3; margin-top:2px; }
+  .translation-local { display:flex; align-items:center; gap:7px; font-size:11px; color:#62765d; white-space:nowrap; }
+  .translation-local>span { width:6px; height:6px; border-radius:50%; background:#6b8862; }
+  .translation-actions { gap:16px; margin:20px 0; }
+  .translation-source,.translation-target { display:flex; flex-direction:column; gap:7px; flex:1; min-width:0; }
+  .translation-source>span:last-child { min-height:42px; display:flex; align-items:center; gap:10px; font-size:13px; }
+  .translation-label { color:#807b70; font-size:10px; font-weight:600; letter-spacing:.7px; text-transform:uppercase; }
+  .translation-original { font-size:9px; color:#89847a; background:#eeece5; padding:3px 6px; border-radius:3px; }
+  .translation-arrow { color:#aaa390; margin-top:21px; flex-shrink:0; }
+  select { width:100%; border:1px solid #dcd8cd; border-radius:4px; padding:10px 30px 10px 12px; background:white; color:#37352f; font-size:13px; height:42px; cursor:pointer; }
+  button { font-size:12px; font-weight:600; height:42px; border-radius:4px; cursor:pointer; white-space:nowrap; margin-top:22px; transition:background .15s; }
+  .translation-submit { background:#303c34; color:white; padding:0 20px; display:flex; align-items:center; justify-content:center; gap:23px; }
+  .translation-submit:hover:not(:disabled) { background:#485c4e; }
+  .translation-reset { color:#69675e; padding:0 12px; border:1px solid #dcd8cd; background:transparent; }
+  .translation-reset:hover:not(:disabled) { background:#eeece5; }
+  button:disabled { opacity:.5; cursor:not-allowed; }
+  button:focus-visible,select:focus-visible { outline:2px solid #92652c; outline-offset:3px; }
+  .translation-footer { justify-content:space-between; align-items:flex-start; gap:16px; padding:12px 0; border-top:1px solid #e8e4d9; font-size:10px; line-height:1.6; color:#817c70; }
+  .translation-footer p { margin:0; }
+  .translation-privacy { gap:5px; white-space:nowrap; }
+  .translation-noscript { font-size:12px; padding-bottom:12px; }
+  @media(max-width:760px) {
+    .translation-control { margin:16px 16px 0; }
+    section { padding:18px 18px 0; }
+    .translation-intro { align-items:flex-start; }
+    .translation-local { font-size:0; padding-top:7px; }
+    h2 { font-size:23px; }
+    .translation-actions { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:18px 0; }
+    .translation-arrow { display:none; }
+    button { margin-top:0; }
+    .translation-footer { flex-direction:column; gap:5px; }
+  }
+</style>
