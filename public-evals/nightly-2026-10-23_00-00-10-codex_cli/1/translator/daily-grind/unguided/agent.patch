+// Bundled translations: switching languages never sends text to a service.
+(() => {
+  const translations = {
+    es: {
+      welcome: 'Todos tienen un lugar en nuestra mesa.',
+      privacy: 'Las traducciones se quedan en tu dispositivo.',
+      language: 'Idioma',
+      scope: 'Traduce el menú de café y nuestra historia.',
+      eyebrow: 'Preparado con esmero, disfrutado sin prisa',
+      favorites: 'Favoritos de temporada',
+      latte: 'Latte de avena y arce',
+      latteDescription: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.',
+      espresso: 'Espresso de tueste oscuro',
+      espressoDescription: 'Intenso, ahumado y perfecto para empezar la mañana con energía.',
+      coldBrew: 'Café de extracción en frío',
+      coldBrewDescription: 'Infusionado durante 18 horas para una suavidad excepcional.',
+      details: 'Ver detalles',
+      storyEyebrow: 'Del grano a un lugar para todos',
+      storyHeading: 'Un buen día empieza con una gran taza.',
+      storyOne: 'En The Daily Grind, creemos que el café es un motivo para bajar el ritmo y conectar. En cada taza reunimos granos de origen ético y tueste local.',
+      storyTwo: 'Ya sea para encontrar tu ritmo por la mañana o ponerte al día con un viejo amigo, aquí tienes tu lugar. Ven tal como eres. Nosotros ponemos el café.',
+      storyLink: 'Conócenos →',
+      status: 'El menú y nuestra historia ahora están en español.'
+    },
+    fr: {
+      welcome: 'Tout le monde a sa place à notre table.',
+      privacy: 'Les traductions restent sur votre appareil.',
+      language: 'Langue',
+      scope: 'Traduisez la carte des cafés et notre histoire.',
+      eyebrow: 'Préparé avec soin, savouré sans hâte',
+      favorites: 'Les favoris de saison',
+      latte: 'Latte à l’avoine et à l’érable',
+      latteDescription: 'Du lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      espresso: 'Espresso à torréfaction foncée',
+      espressoDescription: 'Intense, fumé et parfait pour bien démarrer la matinée.',
+      coldBrew: 'Café infusé à froid',
+      coldBrewDescription: 'Infusé pendant 18 heures pour une douceur incomparable.',
+      details: 'Voir les détails',
+      storyEyebrow: 'Du grain au plaisir d’être ensemble',
+      storyHeading: 'Une belle journée commence par un bon café.',
+      storyOne: 'Chez The Daily Grind, nous pensons que le café est une invitation à ralentir et à se retrouver. Chaque tasse réunit des grains issus de sources éthiques et une torréfaction locale.',
+      storyTwo: 'Que vous cherchiez votre rythme du matin ou retrouviez un ami de longue date, vous avez votre place ici. Venez comme vous êtes. On s’occupe du café.',
+      storyLink: 'Faites notre connaissance →',
+      status: 'La carte et notre histoire sont maintenant en français.'
+    },
+    de: {
+      welcome: 'An unserem Tisch sind alle willkommen.',
+      privacy: 'Die Übersetzungen bleiben auf deinem Gerät.',
+      language: 'Sprache',
+      scope: 'Übersetze die Kaffeekarte und unsere Geschichte.',
+      eyebrow: 'Mit Sorgfalt zubereitet, in Ruhe genossen',
+      favorites: 'Unsere saisonalen Favoriten',
+      latte: 'Hafer-Latte mit Ahornsirup',
+      latteDescription: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      espresso: 'Dunkel gerösteter Espresso',
+      espressoDescription: 'Kräftig, rauchig und perfekt für einen schwungvollen Start in den Morgen.',
+      coldBrew: 'Cold Brew',
+      coldBrewDescription: '18 Stunden kalt gezogen für einen besonders milden Geschmack.',
+      details: 'Details ansehen',
+      storyEyebrow: 'Von der Bohne zum Miteinander',
+      storyHeading: 'Ein guter Tag beginnt mit einer großartigen Tasse Kaffee.',
+      storyOne: 'Bei The Daily Grind glauben wir, dass Kaffee ein Anlass ist, innezuhalten und zusammenzukommen. In jeder Tasse vereinen wir ethisch bezogene Bohnen mit lokaler Röstung.',
+      storyTwo: 'Ob du morgens in deinen Rhythmus findest oder dich mit einem alten Freund austauschst: Hier ist Platz für dich. Komm, wie du bist. Wir setzen den Kaffee auf.',
+      storyLink: 'Lerne uns kennen →',
+      status: 'Die Kaffeekarte und unsere Geschichte sind jetzt auf Deutsch.'
+    }
+  };
+
+  const storageKey = 'daily-grind-language';
+  const selector = document.getElementById('language');
+  const status = document.getElementById('translation-status');
+  const elements = [...document.querySelectorAll('[data-i18n]')];
+  // The original HTML is the English source and remains useful without JavaScript.
+  translations.en = Object.fromEntries(elements.map(element => [element.dataset.i18n, element.textContent]));
+  translations.en.status = 'The coffee menu and our story are now in English.';
+
+  function setLanguage(language, announce = false) {
+    const supported = Object.hasOwn(translations, language) ? language : 'en';
+    const copy = translations[supported];
+    elements.forEach(element => {
+      element.textContent = copy[element.dataset.i18n];
+      // Only these regions are translated; navigation and hero remain in English.
+      element.lang = supported;
+    });
+    selector.value = supported;
+    status.lang = supported;
+    if (announce) status.textContent = copy.status;
+    try {
+      localStorage.setItem(storageKey, supported);
+    } catch {
+      // Translation still works when storage is unavailable or disabled.
+    }
+  }
+
+  let savedLanguage = 'en';
+  try {
+    savedLanguage = localStorage.getItem(storageKey) || 'en';
+  } catch {
+    // Use English if the visitor blocks local storage.
+  }
+  setLanguage(savedLanguage);
+  selector.addEventListener('change', () => setLanguage(selector.value, true));
+  document.getElementById('language-tools').hidden = false;
+})();
