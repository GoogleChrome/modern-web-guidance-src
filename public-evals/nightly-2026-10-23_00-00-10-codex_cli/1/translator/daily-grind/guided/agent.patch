diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..16bba84
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,132 @@
+(() => {
+  const form = document.getElementById('language-form');
+  const language = document.getElementById('language');
+  const button = document.getElementById('translate-button');
+  const restore = document.getElementById('restore-button');
+  const status = document.getElementById('translation-status');
+  const passages = Array.from(document.querySelectorAll('[data-translate]'));
+  const originals = passages.map((element) => element.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let readyOptions = null;
+  let controller = null;
+
+  function showPassages(texts, targetLanguage) {
+    passages.forEach((element, index) => {
+      element.textContent = texts[index];
+      element.lang = targetLanguage;
+    });
+    restore.disabled = targetLanguage === 'en';
+  }
+
+  function reset() {
+    revision++;
+    controller?.abort();
+    controller = null;
+    readyOptions = null;
+    language.value = 'en';
+    language.disabled = false;
+    button.disabled = true;
+    form.removeAttribute('aria-busy');
+    showPassages(originals, 'en');
+    status.textContent = 'Showing the original English. Choose a language to translate.';
+  }
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (!readyOptions || button.disabled) return;
+
+    const options = readyOptions;
+    const target = options.targetLanguage;
+    const current = ++revision;
+    const cached = cache.get(target);
+    if (cached) {
+      showPassages(cached, target);
+      status.textContent = 'Coffee descriptions and story translated on your device. Machine translations may contain mistakes.';
+      return;
+    }
+
+    controller = new AbortController();
+    language.disabled = true;
+    button.disabled = true;
+    restore.disabled = false;
+    form.setAttribute('aria-busy', 'true');
+    status.textContent = 'Preparing on-device translation…';
+    let translator;
+    try {
+      // Call create directly during submission to preserve user activation for downloads.
+      translator = await window.Translator.create({
+        ...options,
+        signal: controller.signal,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            if (current !== revision) return;
+            status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. Translation will run on your device.`;
+          });
+        },
+      });
+      if (current !== revision) return;
+      status.textContent = 'Translating coffee descriptions and story on your device…';
+      const translated = [];
+      for (const original of originals) {
+        translated.push(await translator.translate(original));
+        if (current !== revision) return;
+      }
+      // Apply only a complete translation; failures leave the current text intact.
+      cache.set(target, translated);
+      showPassages(translated, target);
+      status.textContent = 'Coffee descriptions and story translated on your device. Machine translations may contain mistakes.';
+    } catch {
+      if (current !== revision) return;
+      status.textContent = 'Translation could not finish. Your current text is unchanged. Check your connection for the language-pack download and try again, or show the original English.';
+    } finally {
+      translator?.destroy();
+      if (current === revision) {
+        controller = null;
+        language.disabled = false;
+        button.disabled = false;
+        form.removeAttribute('aria-busy');
+      }
+    }
+  });
+
+  restore.addEventListener('click', reset);
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, over HTTPS. The original English is shown.';
+    return;
+  }
+
+  language.disabled = false;
+  status.textContent = 'Choose a language, then select Translate. Translation stays on your device.';
+
+  language.addEventListener('change', async () => {
+    const current = ++revision;
+    const target = language.value;
+    readyOptions = null;
+    button.disabled = true;
+    if (target === 'en') {
+      reset();
+      return;
+    }
+
+    const options = { sourceLanguage: 'en', targetLanguage: target };
+    status.textContent = 'Checking on-device language support…';
+    try {
+      const availability = await window.Translator.availability(options);
+      if (current !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Choose another language or show the original English.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device. Select Translate.'
+        : 'Select Translate to download the language pack and translate on your device.';
+    } catch {
+      if (current !== revision) return;
+      status.textContent = 'Could not check language support. Choose another language or try again.';
+    }
+  });
+})();
