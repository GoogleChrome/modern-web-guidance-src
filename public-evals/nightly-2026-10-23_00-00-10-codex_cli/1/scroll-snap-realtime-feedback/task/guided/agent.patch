+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    let feedbackFrame = null;
+    let settleTimeout;
+
+    const closestIndex = () => {
+      let closest = 0;
+      let distance = Infinity;
+      items.forEach((item, index) => {
+        const nextDistance = Math.abs(item.offsetLeft - gallery.scrollLeft);
+        if (nextDistance < distance) {
+          closest = index;
+          distance = nextDistance;
+        }
+      });
+      return closest;
+    };
+
+    const showPending = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    };
+
+    const select = (index) => {
+      if (!thumbnails[index]) return;
+      cancelAnimationFrame(feedbackFrame);
+      feedbackFrame = null;
+      clearTimeout(settleTimeout);
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    };
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      showPending(items.indexOf(event.snapTargetInline));
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      select(items.indexOf(event.snapTargetInline));
+    });
+
+    // Also clean up when a gesture returns to the already-selected slide.
+    gallery.addEventListener('scrollend', () => select(closestIndex()));
+
+    const supportsPending = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    gallery.addEventListener('scroll', () => {
+      if (!supportsPending && feedbackFrame === null) {
+        feedbackFrame = requestAnimationFrame(() => {
+          feedbackFrame = null;
+          showPending(closestIndex());
+        });
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(settleTimeout);
+        settleTimeout = setTimeout(() => select(closestIndex()), 180);
+      }
+    }, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        gallery.scrollTo({
+          left: items[index].offsetLeft,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    // Restore selection after initial layout and back/forward navigation.
+    window.addEventListener('pageshow', () => select(closestIndex()));
+    select(closestIndex());
+  </script>
+
