+  <script>
+    const gallery = document.getElementById('gallery');
+    const galleryItems = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    let previousScrollLeft = gallery.scrollLeft;
+    let settleTimer;
+
+    // Measure relative to the scrollport, including the gap between slides.
+    function slidePositions() {
+      const galleryLeft = gallery.getBoundingClientRect().left;
+      return galleryItems.map(item =>
+        item.getBoundingClientRect().left - galleryLeft + gallery.scrollLeft);
+    }
+
+    function nearestSlide() {
+      const positions = slidePositions();
+      return positions.reduce((nearest, position, index) =>
+        Math.abs(position - gallery.scrollLeft) <
+        Math.abs(positions[nearest] - gallery.scrollLeft) ? index : nearest, 0);
+    }
+
+    function markPending(index) {
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    }
+
+    function commitSelection() {
+      clearTimeout(settleTimer);
+      const selected = nearestSlide();
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', index === selected);
+        if (index === selected) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+      previousScrollLeft = gallery.scrollLeft;
+    }
+
+    gallery.addEventListener('scrollsnapchanging', event => {
+      const index = galleryItems.indexOf(event.snapTargetInline);
+      if (index !== -1) markPending(index);
+    });
+    gallery.addEventListener('scrollsnapchange', commitSelection);
+    gallery.addEventListener('scrollend', commitSelection);
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapChanging) {
+        const positions = slidePositions();
+        const movingForward = gallery.scrollLeft > previousScrollLeft;
+        // Highlight the slide being approached as soon as the swipe moves.
+        let target = movingForward
+          ? positions.findIndex(position => position >= gallery.scrollLeft - 1)
+          : positions.findLastIndex(position => position <= gallery.scrollLeft + 1);
+        if (target === -1) target = nearestSlide();
+        markPending(target);
+      }
+      previousScrollLeft = gallery.scrollLeft;
+      if (!supportsScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(commitSelection, 180);
+      }
+    }, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        markPending(index);
+        const target = slidePositions()[index];
+        if (Math.abs(gallery.scrollLeft - target) < 1) {
+          commitSelection();
+          return;
+        }
+        gallery.scrollTo({
+          left: target,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
