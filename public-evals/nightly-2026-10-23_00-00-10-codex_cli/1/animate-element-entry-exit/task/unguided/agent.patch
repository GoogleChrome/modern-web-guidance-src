+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const promoStatus = document.getElementById('promoStatus');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const removing = new Set();
+    let promoCount = 0;
+
+    function animateCard(card, leaving = false) {
+      // Keep the card in the DOM until its exit animation finishes.
+      card.getAnimations().forEach(animation => animation.cancel());
+      return card.animate([
+        { opacity: 0, transform: 'scale(0.92)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ], {
+        duration: reducedMotion.matches ? 0 : 280,
+        easing: 'ease-in-out',
+        direction: leaving ? 'reverse' : 'normal',
+        fill: 'both'
+      });
+    }
+
+    function updateControls() {
+      removeBtn.disabled = !Array.from(domContainer.children).some(card => !removing.has(card));
+      toggleBtn.disabled = !toggleCard.isConnected || removing.has(toggleCard);
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Explore a new roast and find your next everyday favorite.';
+      card.append(heading, description);
+      domContainer.append(card);
+      animateCard(card);
+      promoStatus.textContent = 'New promo added.';
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = Array.from(domContainer.children).reverse().find(card => !removing.has(card));
+      if (!card) return;
+      removing.add(card);
+      updateControls();
+      if (!card.hidden) await animateCard(card, true).finished;
+      card.remove();
+      removing.delete(card);
+      promoStatus.textContent = 'Last promo removed.';
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      if (!toggleCard.hidden) animateCard(toggleCard);
+      promoStatus.textContent = toggleCard.hidden ? 'Featured promo hidden.' : 'Featured promo shown.';
+    });
+  </script>
+
 </body>
 
