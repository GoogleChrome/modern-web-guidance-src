+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const promoStatus = document.getElementById('promoStatus');
+    let promoNumber = 0;
+    let busy = false;
+
+    function updateControls() {
+      const count = domContainer.querySelectorAll('.card').length;
+      removeBtn.disabled = busy || count === 0;
+      toggleBtn.disabled = busy || !toggleCard.isConnected;
+      toggleBtn.setAttribute('aria-expanded', String(toggleCard.isConnected && !toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+      promoStatus.textContent = `${count} promo${count === 1 ? '' : 's'} available.`;
+    }
+
+    function showCard(card) {
+      // Older browsers need an explicit starting state for entry transitions.
+      if (!('CSSStartingStyleRule' in window)) {
+        card.classList.add('is-entering');
+        card.hidden = false;
+        getComputedStyle(card).opacity;
+        card.classList.remove('is-entering');
+      } else {
+        card.hidden = false;
+      }
+    }
+
+    async function hideCard(card) {
+      if (card.hidden) return;
+      // Keep the card rendered until its exit finishes, including in browsers
+      // that parse allow-discrete but cannot transition display.
+      card.setAttribute('data-closing', '');
+      const animations = card.getAnimations();
+      let timeout;
+      try {
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+        ]);
+      } finally {
+        clearTimeout(timeout);
+        card.hidden = true;
+        card.removeAttribute('data-closing');
+      }
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      card.hidden = true;
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Perk #${++promoNumber}`;
+      const description = document.createElement('p');
+      description.textContent = 'Make it a treat: pair your favorite coffee with a freshly baked pastry.';
+      card.append(heading, description);
+      domContainer.appendChild(card);
+      showCard(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.lastElementChild;
+      if (busy || !card) return;
+      busy = true;
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      busy = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (busy || !toggleCard.isConnected) return;
+      busy = true;
+      updateControls();
+      if (toggleCard.hidden) {
+        showCard(toggleCard);
+      } else {
+        await hideCard(toggleCard);
+      }
+      busy = false;
+      updateControls();
+    });
+  </script>
+
 </body>
 
