+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,126 @@
+import { useEffect, useRef, useState } from 'react';
+import { accountRequest, AccountError, parseAccount, syncAuthenticator, type PasskeyAccount } from '../lib/account';
+
+const button = 'rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed';
+const date = (value?: string | null) => value && !Number.isNaN(Date.parse(value))
+  ? new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not recorded';
+
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<PasskeyAccount | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [signedOut, setSignedOut] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [syncNotice, setSyncNotice] = useState<string | null>(null);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+  const lock = useRef(false);
+  const base = import.meta.env.BASE_URL;
+
+  function handleError(err: unknown) {
+    if (err instanceof AccountError && err.status === 401) {
+      setSignedOut(true);
+      setAccount(null);
+    }
+    setError(err instanceof Error ? err.message : 'Something went wrong. Please try again.');
+  }
+
+  async function load() {
+    setLoading(true);
+    setError('');
+    try {
+      const data = parseAccount(await accountRequest('/passkeys'));
+      setAccount(data);
+      setSignedOut(false);
+      setSyncNotice(await syncAuthenticator(data));
+    } catch (err) { handleError(err); }
+    finally { setLoading(false); }
+  }
+
+  useEffect(() => { void load(); }, []);
+
+  async function mutate(id: string, method: 'PATCH' | 'DELETE') {
+    if (lock.current) return;
+    lock.current = true;
+    setBusy(true);
+    setError('');
+    setNotice('');
+    try {
+      const data = parseAccount(await accountRequest(`/passkeys/${encodeURIComponent(id)}`, {
+        method, ...(method === 'PATCH' ? { body: JSON.stringify({ displayName: name.trim() }) } : {}),
+      }));
+      setAccount(data);
+      setEditing(null);
+      setRemoving(null);
+      setNotice(method === 'DELETE' ? 'Passkey removed. It can no longer be used to sign in.' : 'Passkey name updated.');
+      setSyncNotice(await syncAuthenticator(data));
+    } catch (err) { handleError(err); }
+    finally { setBusy(false); lock.current = false; }
+  }
+
+  return <section aria-labelledby="passkeys-title" className="rounded-lg border border-gray-200 bg-white">
+    <div className="border-b border-gray-200 p-6">
+      <h2 id="passkeys-title" className="text-xl font-bold">Passkeys</h2>
+      <p className="mt-2 text-sm text-gray-600">Manage the passkeys you use to sign in to The DevTools Times. Give each one a name you recognize, or remove one you no longer use.</p>
+    </div>
+    <div className="p-6">
+      {error && <p role="alert" className="mb-4 rounded bg-red-50 p-3 text-sm text-red-800">{error}</p>}
+      {notice && <p role="status" className="mb-4 rounded bg-green-50 p-3 text-sm text-green-800">{notice}</p>}
+      {loading ? <p role="status" className="text-sm text-gray-600">Loading your passkeys…</p> : signedOut ?
+        <a href={`${base}signin`} className={button}>Sign in to manage passkeys</a> : !account ?
+        <button className={button} onClick={() => void load()}>Try again</button> : <>
+          {!account.passkeys.length ? <div className="py-6 text-center">
+            <h3 className="font-semibold">No passkeys registered</h3>
+            <p className="mt-2 text-sm text-gray-600">Passkeys registered to your account will appear here.</p>
+          </div> : <ul className="divide-y divide-gray-200">
+            {account.passkeys.map(key => <li key={key.id} className="py-5 first:pt-0 last:pb-0">
+              {editing === key.id ? <form onSubmit={event => { event.preventDefault(); void mutate(key.id, 'PATCH'); }}>
+                <label htmlFor="passkey-name" className="block text-sm font-semibold">Passkey display name</label>
+                <input id="passkey-name" autoFocus required maxLength={100} value={name} onChange={e => setName(e.target.value)} disabled={busy}
+                  className="mt-2 w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-gray-800" />
+                <p className="mt-2 text-xs text-gray-500">This name helps you identify this passkey in your account.</p>
+                <div className="mt-3 flex gap-2">
+                  <button type="submit" className={button} disabled={busy || !name.trim()}>{busy ? 'Saving…' : 'Save name'}</button>
+                  <button type="button" className={button} disabled={busy} onClick={() => setEditing(null)}>Cancel</button>
+                </div>
+              </form> : <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
+                <div className="min-w-0">
+                  <h3 className="break-words font-semibold">{key.displayName || 'Unnamed passkey'}</h3>
+                  <p className="mt-1 text-xs leading-5 text-gray-500">Added {date(key.createdAt)} · Last used {date(key.lastUsedAt)}</p>
+                </div>
+                <div className="flex shrink-0 gap-2">
+                  <button className={button} disabled={busy || removing !== null} aria-label={`Rename ${key.displayName}`} onClick={() => { setName(key.displayName); setEditing(key.id); }}>Rename</button>
+                  <button className={`${button} text-red-700`} disabled={busy || editing !== null || removing !== null} aria-label={`Remove ${key.displayName}`} onClick={() => setRemoving(key.id)}>Remove</button>
+                </div>
+              </div>}
+              {removing === key.id && <div className="mt-4 rounded border border-red-200 bg-red-50 p-4">
+                <h4 className="font-semibold">Remove “{key.displayName}”?</h4>
+                <p className="mt-2 text-sm">You won’t be able to sign in with this passkey again. Make sure you have another way to access your account.</p>
+                <div className="mt-3 flex gap-2">
+                  <button className={`${button} text-red-700`} disabled={busy} onClick={() => void mutate(key.id, 'DELETE')}>{busy ? 'Removing…' : 'Remove passkey'}</button>
+                  <button className={button} disabled={busy} onClick={() => setRemoving(null)}>Cancel</button>
+                </div>
+              </div>}
+            </li>)}
+          </ul>}
+          <div className="mt-6 border-t border-gray-200 pt-4 text-sm text-gray-600">
+            <p>{syncNotice || 'Automatic updates have been sent to your browser’s passkey provider. Your password manager controls how they are applied.'}</p>
+            {syncNotice && <button className={`${button} mt-3`} disabled={busy} onClick={async () => {
+              if (lock.current) return;
+              lock.current = true;
+              setBusy(true);
+              setError('');
+              try {
+                const latest = parseAccount(await accountRequest('/passkeys'));
+                setAccount(latest);
+                setSyncNotice(await syncAuthenticator(latest));
+              } catch (err) { handleError(err); }
+              finally { setBusy(false); lock.current = false; }
+            }}>Retry browser sync</button>}
+          </div>
+        </>}
+    </div>
+  </section>;
+}
