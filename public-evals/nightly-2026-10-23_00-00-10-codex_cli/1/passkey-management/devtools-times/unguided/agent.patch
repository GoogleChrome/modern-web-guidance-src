+import Layout from '../layouts/Layout.astro';
+import PasskeySettings from '../components/PasskeySettings';
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
+    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">Your account</p>
+    <h1 class="font-brand text-4xl">Account settings</h1>
+    <p class="mb-8 mt-3 text-gray-600">Keep your sign-in details and account access up to date.</p>
+    <PasskeySettings client:load />
+  </div>
+</Layout>
