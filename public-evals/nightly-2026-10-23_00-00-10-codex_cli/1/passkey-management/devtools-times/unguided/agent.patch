diff --git a/src/lib/account.ts b/src/lib/account.ts
new file mode 100644
index 0000000..32e2c49
--- /dev/null
+++ b/src/lib/account.ts
@@ -0,0 +1,89 @@
+// The account service owns authentication and WebAuthn records. Never derive a
+// credential list from browser storage: an incomplete list could hide valid keys.
+export const ACCOUNT_API = (import.meta.env.PUBLIC_ACCOUNT_API_URL ||
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api').replace(/\/$/, '');
+const TOKEN_KEY = 'devtools-times-session';
+
+export function getToken(): string | null {
+  return sessionStorage.getItem(TOKEN_KEY);
+}
+
+export function saveToken(token: string) {
+  sessionStorage.setItem(TOKEN_KEY, token);
+}
+
+export class AccountError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+
+export async function accountRequest(path: string, init: RequestInit = {}) {
+  const token = getToken();
+  if (!token) throw new AccountError('Please sign in to manage your passkeys.', 401);
+  const response = await fetch(`${ACCOUNT_API}${path}`, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init.headers, Authorization: `Bearer ${token}` },
+    cache: 'no-store',
+  });
+  if (response.status === 401) {
+    sessionStorage.removeItem(TOKEN_KEY);
+    throw new AccountError('Your session has expired. Please sign in again.', 401);
+  }
+  if (!response.ok) {
+    throw new AccountError(response.status === 404 || response.status === 501
+      ? 'Passkey management is not available from the account service yet.'
+      : 'We couldn’t update your passkeys. Please try again.', response.status);
+  }
+  return response.json();
+}
+
+export interface Passkey {
+  id: string;
+  displayName: string;
+  createdAt: string;
+  lastUsedAt?: string | null;
+}
+
+export interface PasskeyAccount {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+export function parseAccount(value: unknown): PasskeyAccount {
+  const data = value as PasskeyAccount;
+  const encodedId = (id: unknown): id is string => typeof id === 'string' && /^[A-Za-z0-9_-]+$/.test(id);
+  if (!data || typeof data.rpId !== 'string' || !data.rpId ||
+    !data.user || !encodedId(data.user.id) || typeof data.user.name !== 'string' ||
+    typeof data.user.displayName !== 'string' || !Array.isArray(data.passkeys) ||
+    !data.passkeys.every(key => key && encodedId(key.id) && typeof key.displayName === 'string' &&
+      typeof key.createdAt === 'string' && (key.lastUsedAt == null || typeof key.lastUsedAt === 'string')) || new Set(data.passkeys.map(key => key.id)).size !== data.passkeys.length) {
+    throw new Error('The account service returned invalid passkey information. Please try again.');
+  }
+  return data;
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+export async function syncAuthenticator(account: PasskeyAccount): Promise<string | null> {
+  const api: SignalAPI | undefined = typeof PublicKeyCredential === 'undefined' ? undefined : PublicKeyCredential as unknown as SignalAPI;
+  if (!api) {
+    return 'Your account is up to date. This browser doesn’t support automatic passkey updates; manage saved passkeys in your password manager.';
+  }
+  const results = await Promise.allSettled([
+    api.signalAllAcceptedCredentials?.({ rpId: account.rpId, userId: account.user.id,
+      allAcceptedCredentialIds: account.passkeys.map(key => key.id) }),
+    // This API updates account identity, not individual key nicknames.
+    api.signalCurrentUserDetails?.({ rpId: account.rpId, userId: account.user.id,
+      name: account.user.name, displayName: account.user.displayName }),
+  ]);
+  if (results.some(result => result.status === 'rejected')) {
+    return 'Your account is up to date, but your browser couldn’t update your password manager. Retry sync or manage saved passkeys there.';
+  }
+  if (!api.signalAllAcceptedCredentials || !api.signalCurrentUserDetails) {
+    return 'Your account is up to date. This browser doesn’t support all automatic passkey updates; manage saved passkeys in your password manager.';
+  }
+  return null;
+}
