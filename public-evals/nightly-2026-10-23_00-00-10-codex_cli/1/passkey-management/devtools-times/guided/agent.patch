new file mode 100644
index 0000000..32e88d8
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { accountApi, json, sameOrigin } from '../../../lib/account-server';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sign in is temporarily unavailable.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof body?.username !== 'string' || typeof body?.password !== 'string' || !body.username || !body.password) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+  try {
+    const response = await fetch(`${accountApi()}/login`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username, password: body.password }),
+      signal: AbortSignal.timeout(10000), redirect: 'error',
+    });
+    if (!response.ok) return json({ error: response.status === 401 || response.status === 400 ? 'Incorrect username or password.' : 'Sign in is temporarily unavailable.' }, response.status === 401 || response.status === 400 ? 401 : 503);
+    const data = await response.json();
+    if (typeof data.token !== 'string' || !data.token) return json({ error: 'The account service did not provide a session. Please try again later.' }, 502);
+    await session.regenerate();
+    await session.set('accountToken', data.token);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Sign in is temporarily unavailable. Please try again.' }, 503);
+  }
+};
diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..76cb40a
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { authorizedRequest, json, sameOrigin } from '../../../lib/account-server';
+import { isPasskeyAccount } from '../../../lib/passkeys';
+
+export const GET: APIRoute = async (context) => {
+  const response = await authorizedRequest(context, '/credentials');
+  if (!response.ok) return response;
+  try {
+    const data = await response.json();
+    // Never signal an empty list as a fallback for an incomplete or invalid response.
+    if (!isPasskeyAccount(data)) return json({ error: 'The account service returned an invalid passkey list.' }, 502);
+    return json(data);
+  } catch { return json({ error: 'The account service returned an invalid passkey list.' }, 502); }
+};
+
+export const PATCH: APIRoute = async (context) => mutate(context, 'PUT');
+export const DELETE: APIRoute = async (context) => mutate(context, 'DELETE');
+
+async function mutate(context: Parameters<APIRoute>[0], method: 'PUT' | 'DELETE') {
+  if (!sameOrigin(context.request)) return json({ error: 'Invalid request origin.' }, 403);
+  let body;
+  try { body = await context.request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof body?.id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(body.id)) return json({ error: 'Invalid passkey.' }, 400);
+  if (method === 'PUT' && (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 100)) {
+    return json({ error: 'Enter a passkey name of 1–100 characters.' }, 400);
+  }
+  const response = await authorizedRequest(context, `/credential/${encodeURIComponent(body.id)}`, {
+    method, ...(method === 'PUT' ? { body: JSON.stringify({ name: body.name.trim() }) } : {}),
+  });
+  if (!response.ok) return response;
+  return json({ success: true });
+}
