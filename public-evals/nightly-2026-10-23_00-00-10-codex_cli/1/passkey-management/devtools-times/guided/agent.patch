+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,41 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isPasskeyAccount, syncPasskeys } from '../src/lib/passkeys.ts';
+
+const account = {
+  rpId: 'example.com', userId: 'dXNlcg',
+  credentials: [{ id: 'a2V5', name: 'Laptop', registeredAt: 1700000000000 }],
+};
+
+test('only accepts complete, well-formed credential lists, including an authoritative empty list', () => {
+  assert.equal(isPasskeyAccount(account), true);
+  assert.equal(isPasskeyAccount({ ...account, credentials: [] }), true);
+  for (const invalid of [null, {}, [], { ...account, credentials: null },
+    { ...account, userId: 'not base64!' },
+    { ...account, credentials: [account.credentials[0], account.credentials[0]] },
+    { ...account, credentials: [{ ...account.credentials[0], registeredAt: Infinity }] },
+    { ...account, credentials: [{ ...account.credentials[0], registeredAt: 9e15 }] },
+    { ...account, credentials: [{ ...account.credentials[0], id: 'bad/id' }] },
+  ]) assert.equal(isPasskeyAccount(invalid), false);
+});
+
+test('signals original encoded IDs and includes an empty list after the last removal', async () => {
+  let received;
+  globalThis.isSecureContext = true;
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async data => { received = data; } };
+  await syncPasskeys(account);
+  assert.deepEqual(received, { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] });
