diff --git a/src/lib/account-server.ts b/src/lib/account-server.ts
new file mode 100644
index 0000000..30b7a1b
--- /dev/null
+++ b/src/lib/account-server.ts
@@ -0,0 +1,44 @@
+import type { APIContext } from 'astro';
+import { env } from 'node:process';
+
+const legacyApi = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export function accountApi() {
+  return (env.ACCOUNT_API_URL || legacyApi).replace(/\/$/, '');
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
+
+// The upstream must authorize every operation using this bearer token and scope
+// credential queries/mutations to its owner. No account ID is accepted from clients.
+export async function authorizedRequest(context: APIContext, path: string, init: RequestInit = {}) {
+  const token = await context.session?.get('accountToken');
+  if (typeof token !== 'string' || !token) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  try {
+    const response = await fetch(`${accountApi()}${path}`, {
+      ...init,
+      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+      redirect: 'error',
+      signal: AbortSignal.timeout(10000),
+    });
+    if (response.status === 401) {
+      await context.session?.delete('accountToken');
+      return json({ error: 'Your session has expired. Please sign in again.' }, 401);
+    }
+    if (!response.ok) {
+      const status = [400, 403, 409, 422].includes(response.status) ? response.status : 503;
+      return json({ error: status === 503 ? 'Passkey management is temporarily unavailable. Please try again later.' : 'The change could not be saved. Refresh your passkeys and try again.' }, status);
+    }
+    return response;
+  } catch {
+    return json({ error: 'The account service could not be reached. Please try again.' }, 503);
+  }
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..dbb4db6
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,46 @@
+export interface Passkey {
+  id: string;
+  name: string;
+  provider?: string;
+  registeredAt: number;
+  lastUsedAt?: number | null;
+}
+
+export interface PasskeyAccount {
+  rpId: string;
+  // The original WebAuthn user handle and credential IDs, already base64url encoded.
+  userId: string;
+  credentials: Passkey[];
+}
+
+const encodedId = /^[A-Za-z0-9_-]+$/;
+export function isPasskeyAccount(value: unknown): value is PasskeyAccount {
+  if (!value || typeof value !== 'object') return false;
+  const data = value as PasskeyAccount;
+  return typeof data.rpId === 'string' && data.rpId.length > 0 &&
+    typeof data.userId === 'string' && encodedId.test(data.userId) &&
+    Array.isArray(data.credentials) && data.credentials.every(key =>
+      key && typeof key.id === 'string' && encodedId.test(key.id) &&
+      typeof key.name === 'string' &&
+      (key.provider === undefined || typeof key.provider === 'string') &&
+      Number.isFinite(key.registeredAt) && key.registeredAt > 0 && key.registeredAt <= 8.64e15 &&
+      (key.lastUsedAt == null || (Number.isFinite(key.lastUsedAt) && key.lastUsedAt > 0 && key.lastUsedAt <= 8.64e15))) &&
+    new Set(data.credentials.map(key => key.id)).size === data.credentials.length;
+}
+
+export async function syncPasskeys(account: PasskeyAccount): Promise<string> {
+  if (!globalThis.isSecureContext || typeof PublicKeyCredential === 'undefined' ||
+      typeof PublicKeyCredential.signalAllAcceptedCredentials !== 'function') {
+    return 'Automatic sync is unavailable in this browser. Remove unused passkeys from your password manager as well.';
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.userId,
+      allAcceptedCredentialIds: account.credentials.map(key => key.id),
+    });
+    return 'Your browser has been notified of your current passkeys.';
+  } catch {
+    return 'Your account is up to date, but browser sync failed. Retry sync or update your password manager manually.';
+  }
+}
