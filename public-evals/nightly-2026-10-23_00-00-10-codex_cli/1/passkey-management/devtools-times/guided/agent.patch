+import { useEffect, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import { isPasskeyAccount, syncPasskeys, type PasskeyAccount } from '../lib/passkeys';
+
+const endpoint = `${import.meta.env.BASE_URL}api/account/passkeys`;
+const button = 'rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-not-allowed';
+
+async function request(init?: RequestInit) {
+  const response = await fetch(endpoint, { ...init, headers: { 'Content-Type': 'application/json' }, cache: 'no-store' });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Unable to load passkeys. Please try again.');
+  return data;
+}
+
+function date(value: number) {
+  return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(value);
+}
+
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<PasskeyAccount | null>(null);
+  const [busy, setBusy] = useState(true);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [syncNotice, setSyncNotice] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+
+  async function load() {
+    const data = await request();
+    if (!isPasskeyAccount(data)) throw new Error('An invalid passkey list was returned. Please try again later.');
+    setAccount(data);
+    return data;
+  }
+
+  async function refresh() {
+    setBusy(true);
+    setError('');
+    try {
+      const data = await load();
+      setSyncNotice(await syncPasskeys(data));
+    } catch (err) {
+      setAccount(null);
+      setError(err instanceof Error ? err.message : 'Unable to load passkeys.');
+    } finally { setBusy(false); }
+  }
+
+  useEffect(() => { void refresh(); }, []);
+
+  async function change(id: string, method: 'PATCH' | 'DELETE') {
+    setBusy(true);
+    setError('');
+    setNotice('');
+    let saved = false;
+    try {
+      await request({ method, body: JSON.stringify({ id, ...(method === 'PATCH' ? { name: name.trim() } : {}) }) });
+      saved = true;
+      setEditing(null);
+      setRemoving(null);
+      setNotice(method === 'DELETE' ? 'Passkey removed from your account.' : 'Passkey name updated.');
+      const data = await load();
+      // A nickname is local account metadata; it is not the WebAuthn user profile.
+      if (method === 'DELETE') setSyncNotice(await syncPasskeys(data));
+    } catch (err) {
+      if (saved) {
+        setAccount(null);
+        setSyncNotice('');
+        setError('Your change was saved, but the updated list could not be loaded. Refresh to load and sync your current passkeys.');
+      } else {
+        setError(err instanceof Error ? err.message : 'Your change could not be saved.');
+      }
+    } finally { setBusy(false); }
+  }
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="rounded-lg border border-gray-200 bg-white">
+      <div className="border-b border-gray-200 p-6">
+        <div className="flex items-center gap-3">
+          <KeyIcon className="h-6 w-6" aria-hidden="true" />
+          <h2 id="passkeys-heading" className="text-xl font-semibold">Passkeys</h2>
+        </div>
+        <p className="mt-3 text-sm leading-6 text-gray-600">Manage the passkeys you use to sign in to The DevTools Times. Give each one a recognizable name, or remove a key you no longer use.</p>
+      </div>
+      <div className="p-6">
+        <div role="status" className="text-sm text-gray-700">{busy ? 'Updating passkeys…' : notice}</div>
+        {error && <div role="alert" className="my-3 rounded-md bg-red-50 p-3 text-sm text-red-800"><p>{error}</p><a className="mt-2 inline-block font-semibold underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in again</a></div>}
+        {!account && !busy && <button type="button" className={`${button} mt-3`} onClick={refresh}>Retry loading passkeys</button>}
+        {account && <>
+          {account.credentials.length === 0 ? (
+            <div className="py-6 text-center">
+              <p className="font-semibold">No passkeys registered</p>
+              <p className="mt-2 text-sm text-gray-600">Passkeys registered to this account will appear here. You can continue signing in with your password.</p>
+            </div>
+          ) : (
+            <ul className="divide-y divide-gray-200" aria-label="Registered passkeys" aria-busy={busy}>
+              {account.credentials.map((key, index) => (
+                <li key={key.id} className="py-5 first:pt-2">
+                  <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
+                    <div className="flex min-w-0 gap-3">
+                      <KeyIcon className="mt-1 h-5 w-5 shrink-0 text-gray-500" aria-hidden="true" />
+                      <div className="min-w-0">
+                        <h3 className="break-words font-semibold">{key.name || key.provider || 'Passkey'}</h3>
+                        <p className="mt-1 text-sm text-gray-600">{key.provider || 'Unknown passkey provider'}</p>
+                        <p className="mt-2 text-xs leading-5 text-gray-500">Added <time dateTime={new Date(key.registeredAt).toISOString()}>{date(key.registeredAt)}</time><br />
+                          {key.lastUsedAt ? <>Last used <time dateTime={new Date(key.lastUsedAt).toISOString()}>{date(key.lastUsedAt)}</time></> : 'Last used date unavailable'}
+                        </p>
+                      </div>
+                    </div>
+                    <div className="flex shrink-0 gap-2">
+                      <button type="button" className={button} disabled={busy} aria-label={`Rename ${key.name || 'passkey'}`} onClick={() => { setEditing(key.id); setName(key.name); setRemoving(null); }}>Rename</button>
+                      <button type="button" className={`${button} text-red-700`} disabled={busy} aria-label={`Remove ${key.name || 'passkey'}`} onClick={() => { setRemoving(key.id); setEditing(null); }}>Remove</button>
+                    </div>
+                  </div>
+                  {editing === key.id && <form className="mt-4 rounded-md bg-gray-50 p-4" onSubmit={event => { event.preventDefault(); void change(key.id, 'PATCH'); }}>
+                    <label htmlFor={`passkey-name-${index}`} className="block text-sm font-medium">Passkey display name</label>
+                    <input id={`passkey-name-${index}`} autoFocus required maxLength={100} disabled={busy} value={name} onChange={event => setName(event.target.value)} className="mt-2 w-full rounded-md border border-gray-300 bg-white px-3 py-2 focus-visible:outline-2 focus-visible:outline-gray-900" />
+                    <p className="mt-2 text-xs text-gray-500">This label is saved to your account. Your password manager may use its own label.</p>
+                    <div className="mt-3 flex gap-2">
+                      <button className={`${button} bg-gray-900 text-white hover:bg-gray-700`} disabled={busy || !name.trim()} type="submit">Save name</button>
+                      <button className={button} type="button" disabled={busy} onClick={() => setEditing(null)}>Cancel</button>
+                    </div>
+                  </form>}
+                  {removing === key.id && <div className="mt-4 rounded-md border border-red-200 bg-red-50 p-4" role="group" aria-label="Confirm passkey removal">
+                    <p className="text-sm text-red-900">Remove “{key.name || 'Passkey'}”? You won’t be able to sign in with this key again. Make sure you have another way to sign in.</p>
+                    <div className="mt-3 flex gap-2">
+                      <button className={`${button} bg-white text-red-700`} disabled={busy} onClick={() => change(key.id, 'DELETE')}>Confirm removal</button>
+                      <button autoFocus className={`${button} bg-white`} disabled={busy} onClick={() => setRemoving(null)}>Cancel</button>
+                    </div>
+                  </div>}
+                </li>
+              ))}
+            </ul>
+          )}
+          <div className="mt-4 border-t border-gray-200 pt-4">
+            <p className="text-xs leading-5 text-gray-500" role="status">{syncNotice}</p>
+            <button type="button" className={`${button} mt-3`} disabled={busy} onClick={refresh}>Refresh &amp; sync</button>
+          </div>
+        </>}
+      </div>
+    </section>
+  );
+}
