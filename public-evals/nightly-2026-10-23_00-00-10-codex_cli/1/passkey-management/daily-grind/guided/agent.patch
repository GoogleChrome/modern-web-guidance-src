@@ -0,0 +1,73 @@
+// This module has no server dependencies. Live mode requires a session-authenticated API.
+const demoKeys = [
+  { id: 'demo-macbook', name: 'MacBook Pro', provider: 'iCloud Keychain', device: 'laptop', current: true, registeredAt: Date.UTC(2026, 4, 18), lastUsedAt: Date.UTC(2026, 9, 23) },
+  { id: 'demo-iphone', name: 'iPhone 15', provider: 'iCloud Keychain', device: 'phone', registeredAt: Date.UTC(2026, 4, 18), lastUsedAt: Date.UTC(2026, 9, 22) },
+  { id: 'demo-yubikey', name: 'YubiKey 5 NFC', provider: 'Security key', device: 'usb', registeredAt: Date.UTC(2026, 7, 9), lastUsedAt: Date.UTC(2026, 9, 12) }
+];
+const storageKey = 'daily-grind.preview-passkeys.v1';
+const encoded = value => typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value) && value.length % 4 !== 1;
+
+export function validateSnapshot(data, live = true) {
+  if (!data || !Array.isArray(data.credentials) || data.complete !== true) throw new Error('We couldn’t load the complete passkey list. Please try again.');
+  if (live && (data.authenticated !== true || !encoded(data.user?.id) || typeof data.rpId !== 'string')) throw new Error('Please sign in again to manage your passkeys.');
+  const ids = new Set();
+  for (const key of data.credentials) {
+    if (!key || typeof key.id !== 'string' || !key.id || ids.has(key.id) || (live && !encoded(key.id)) || typeof key.name !== 'string' || !Number.isFinite(key.registeredAt) || (key.lastUsedAt != null && !Number.isFinite(key.lastUsedAt))) throw new Error('The passkey list could not be read. Please try again.');
+    ids.add(key.id);
+  }
+  return data;
+}
+
+export function createPasskeyService({ apiBase, csrfToken, storage, fetcher = globalThis.fetch } = {}) {
+  const demo = !apiBase;
+  let credentials = structuredClone(demoKeys);
+  if (demo && storage) {
+    try {
+      const saved = storage.getItem(storageKey);
+      if (saved) credentials = validateSnapshot({ credentials: JSON.parse(saved), complete: true }, false).credentials;
+    } catch { /* A corrupt preview can safely start with the sample data. */ }
+  }
+  const snapshot = () => ({ credentials: structuredClone(credentials), complete: true, authenticated: false, user: { displayName: 'Jamie Lee', memberSince: 2024 } });
+  async function request(path = '', method = 'GET', body) {
+    const response = await fetcher(`${apiBase}${path}`, {
+      method, credentials: 'same-origin', cache: 'no-store',
+      headers: { Accept: 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}), ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) },
+      ...(body ? { body: JSON.stringify(body) } : {})
+    });
+    if (response.status === 401 || response.status === 403) throw new Error('Please sign in again to manage your passkeys.');
+    if (!response.ok) throw new Error('We couldn’t save this change. Please try again.');
+    return validateSnapshot(await response.json());
+  }
+  async function change(id, name) {
+    if (demo) {
+      if (!credentials.some(key => key.id === id)) throw new Error('This passkey has already been removed.');
+      const next = name === undefined ? credentials.filter(key => key.id !== id) : credentials.map(key => key.id === id ? { ...key, name } : key);
+      // Persist before changing UI state, so a failed save never appears successful.
+      storage?.setItem(storageKey, JSON.stringify(next));
+      credentials = next;
+      return snapshot();
+    }
+    return request(`/${encodeURIComponent(id)}`, name === undefined ? 'DELETE' : 'PUT', name === undefined ? undefined : { name });
+  }
+  return {
+    demo,
+    list: async () => demo ? snapshot() : request(),
+    rename: (id, value) => {
+      const name = value.trim();
+      if (!name || name.length > 60) return Promise.reject(new Error('Enter a name between 1 and 60 characters.'));
+      return change(id, name);
+    },
+    remove: id => change(id)
+  };
+}
+
+export async function syncAcceptedCredentials(snapshot, { demo = false, credentialAPI = globalThis.PublicKeyCredential, hostname = globalThis.location?.hostname, secure = globalThis.isSecureContext } = {}) {
+  // Never signal demo IDs or an incomplete/unauthenticated response to real authenticators.
+  if (demo) return 'demo';
+  validateSnapshot(snapshot);
+  const { rpId, user, credentials } = snapshot;
+  if (!rpId || (rpId !== hostname && !hostname?.endsWith(`.${rpId}`))) throw new Error('The passkey domain could not be verified.');
+  if (!secure || typeof credentialAPI?.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  await credentialAPI.signalAllAcceptedCredentials({ rpId, userId: user.id, allAcceptedCredentialIds: credentials.map(key => key.id) });
+  return 'synced';
+}
diff --git a/tests/passkey-service.test.mjs b/tests/passkey-service.test.mjs
new file mode 100644
index 0000000..bf4d875
--- /dev/null
+++ b/tests/passkey-service.test.mjs
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyService, syncAcceptedCredentials, validateSnapshot } from '../passkey-service.mjs';
+const key = { id: 'Y3JlZGVudGlhbA', name: 'Laptop', registeredAt: 1700000000000 };
+const snapshot = credentials => ({ authenticated: true, complete: true, rpId: 'coffee.example', user: { id: 'dXNlcg', displayName: 'Jamie' }, credentials });
+const memoryStorage = () => {
+  const data = new Map();
+  return { getItem: name => data.get(name) ?? null, setItem: (name, value) => data.set(name, value) };
+};
+
+test('preview renames and deletions persist, including an empty list', async () => {
+  const storage = memoryStorage();
+  const service = createPasskeyService({ storage });
+  let state = await service.list();
+  const first = state.credentials[0].id;
+  state = await service.rename(first, '  My favorite laptop  ');
+  assert.equal(state.credentials[0].name, 'My favorite laptop');
+  assert.equal((await createPasskeyService({ storage }).list()).credentials[0].name, 'My favorite laptop');
+  for (const credential of state.credentials) await service.remove(credential.id);
+  assert.deepEqual((await createPasskeyService({ storage }).list()).credentials, []);
+});
+
+test('failed persistence does not mutate the preview list', async () => {
+  const service = createPasskeyService({ storage: { getItem: () => null, setItem: () => { throw new Error('Storage full'); } } });
+  const before = await service.list();
+  await assert.rejects(service.remove(before.credentials[0].id), /Storage full/);
+  assert.deepEqual(await service.list(), before);
+  await assert.rejects(service.rename(before.credentials[0].id, '   '), /between 1 and 60/);
+});
+
+test('live mutations use the authenticated API and server-confirmed snapshots', async () => {
+  const calls = [];
+  const service = createPasskeyService({ apiBase: '/api/account/passkeys', csrfToken: 'csrf-token', fetcher: async (url, options) => {
+    calls.push({ url, options });
+    return { ok: true, json: async () => snapshot(options.method === 'DELETE' ? [] : [{ ...key, name: 'New name' }]) };
+  } });
+  assert.equal((await service.rename(key.id, ' New name ')).credentials[0].name, 'New name');
+  const removed = await service.remove(key.id);
+  assert.deepEqual(removed.credentials, []);
+  assert.equal(calls[0].options.method, 'PUT');
+  assert.equal(calls[0].options.body, '{"name":"New name"}');
+  assert.equal(calls[0].options.credentials, 'same-origin');
+  assert.equal(calls[0].options.headers['X-CSRF-Token'], 'csrf-token');
+  assert.equal(calls[1].options.method, 'DELETE');
+  assert.equal(calls[1].url, `/api/account/passkeys/${key.id}`);
+});
+
+test('failed live requests never become success or preview data', async () => {
+  for (const status of [401, 403, 500]) {
+    const service = createPasskeyService({ apiBase: '/api/account/passkeys', fetcher: async () => ({ ok: false, status }) });
+    await assert.rejects(service.list());
+    await assert.rejects(service.remove(key.id));
+  }
+});
+
+test('signals the complete confirmed list on supported secure origins, including empty lists', async () => {
+  const signals = [];
+  const options = { hostname: 'www.coffee.example', secure: true, credentialAPI: { signalAllAcceptedCredentials: async signal => signals.push(signal) } };
+  assert.equal(await syncAcceptedCredentials(snapshot([key]), options), 'synced');
+  assert.deepEqual(signals[0], { rpId: 'coffee.example', userId: 'dXNlcg', allAcceptedCredentialIds: [key.id] });
+  await syncAcceptedCredentials(snapshot([]), options);
+  assert.deepEqual(signals[1].allAcceptedCredentialIds, []);
+});
+
+test('never signals demo, unauthenticated, incomplete, duplicated or invalid credentials', async () => {
+  let signals = 0;
+  const options = { hostname: 'coffee.example', secure: true, credentialAPI: { signalAllAcceptedCredentials: async () => { signals++; } } };
+  assert.equal(await syncAcceptedCredentials({}, { ...options, demo: true }), 'demo');
+  for (const data of [
+    { ...snapshot([key]), authenticated: false },
+    { ...snapshot([key]), complete: false },
+    snapshot([{ ...key, id: 'invalid=id' }]),
+    snapshot([key, key]),
+    { ...snapshot([key]), rpId: 'other.example' }
+  ]) await assert.rejects(syncAcceptedCredentials(data, options));
+  assert.equal(signals, 0);
+  assert.throws(() => validateSnapshot({ credentials: [] }));
+});
+
+test('unsupported browsers gracefully skip signals; provider errors remain retryable', async () => {
+  const options = { hostname: 'coffee.example', secure: true, credentialAPI: {} };
+  assert.equal(await syncAcceptedCredentials(snapshot([key]), options), 'unsupported');
+  assert.equal(await syncAcceptedCredentials(snapshot([key]), { ...options, secure: false }), 'unsupported');
+  await assert.rejects(syncAcceptedCredentials(snapshot([key]), { ...options, credentialAPI: { signalAllAcceptedCredentials: async () => { throw new Error('Provider unavailable'); } } }), /Provider unavailable/);
+});
