diff --git a/account.js b/account.js
new file mode 100644
index 0000000..8ce5929
--- /dev/null
+++ b/account.js
@@ -0,0 +1,163 @@
+import { createPasskeyService, syncAcceptedCredentials } from './passkey-service.mjs';
+
+const $ = id => document.getElementById(id);
+let storage;
+try { storage = window.localStorage; } catch { /* Preview still works for this visit. */ }
+const config = window.DAILY_GRIND_ACCOUNT || {};
+const service = createPasskeyService({ ...config, storage });
+let snapshot;
+let selected;
+let busy = false;
+let toastTimer;
+let returnFocus;
+const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+const icon = name => `<svg class="icon" aria-hidden="true"><use href="#i-${name}"/></svg>`;
+const escapeText = value => String(value).replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
+
+// All persisted/server labels are escaped before being included in row markup.
+function render() {
+  $('passkey-count').textContent = snapshot.credentials.length;
+  $('passkey-list').setAttribute('aria-busy', 'false');
+  $('passkey-list').innerHTML = snapshot.credentials.length ? snapshot.credentials.map(key => {
+    const device = ['laptop', 'phone', 'usb'].includes(key.device) ? key.device : 'key';
+    const provider = key.provider || 'Passkey provider';
+    return `<li class="passkey-row"><span class="device-icon ${device}">${icon(device)}</span><div class="passkey-info"><div class="passkey-title"><h3>${escapeText(key.name)}</h3>${key.current ? '<span class="current-badge">Used for this sign-in</span>' : ''}</div><p class="provider">${escapeText(provider)}</p><div class="passkey-dates"><span>Added ${escapeText(dateFormat.format(key.registeredAt))}</span><span class="date-dot" aria-hidden="true"></span><span>${key.lastUsedAt ? `Last used ${escapeText(dateFormat.format(key.lastUsedAt))}` : 'Not used yet'}</span></div></div><div class="row-actions"><button class="rename-button" data-action="rename" data-id="${escapeText(key.id)}" aria-label="Rename ${escapeText(key.name)}">${icon('edit')}<span>Rename</span></button><span class="action-divider" aria-hidden="true"></span><button class="icon-button delete-button" data-action="delete" data-id="${escapeText(key.id)}" aria-label="Remove ${escapeText(key.name)}">${icon('trash')}</button></div></li>`;
+  }).join('') : `<li class="empty-state">${icon('key')}<h3>No passkeys here yet.</h3><p>There are no passkeys registered to your account. Use another available sign-in method for your next visit.</p></li>`;
+}
+function message(text) {
+  $('page-message').textContent = text;
+  $('page-message').hidden = !text;
+}
+function notify(text) {
+  clearTimeout(toastTimer);
+  $('toast-text').textContent = text;
+  $('toast').hidden = false;
+  toastTimer = setTimeout(() => { $('toast').hidden = true; }, 6000);
+}
+function setBusy(form, value) {
+  busy = value;
+  form.setAttribute('aria-busy', String(value));
+  form.querySelectorAll('button, input').forEach(control => { control.disabled = value; });
+}
+async function sync() {
+  $('retry-sync').hidden = true;
+  try {
+    const result = await syncAcceptedCredentials(snapshot, { demo: service.demo });
+    $('sync-description').textContent = {
+      demo: 'In your live account, removing a passkey also tells supported browsers to update your saved sign-in options. Preview changes only affect this device’s demo list.',
+      synced: 'Your accepted passkeys have been shared with your browser. Supported password managers can use this to update your saved sign-in options.',
+      unsupported: 'Your account list is up to date. This browser can’t automatically update saved passkeys; remove any old entries from your password manager manually.'
+    }[result];
+  } catch {
+    $('sync-description').textContent = 'Your account list is saved, but we couldn’t update your browser. Try syncing again or remove the old entry from your password manager.';
+    $('retry-sync').hidden = false;
+  }
+}
+async function load() {
+  message('');
+  $('passkey-list').setAttribute('aria-busy', 'true');
+  try {
+    snapshot = await service.list();
+    $('demo-label').hidden = !service.demo;
+    if (service.demo && !storage) $('demo-label').textContent = 'Preview account · changes last for this visit';
+    document.querySelector('.points').hidden = !service.demo;
+    const name = snapshot.user?.displayName || 'Your account';
+    $('customer-name').textContent = name;
+    $('avatar').textContent = name.split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase();
+    $('customer-since').textContent = snapshot.user?.memberSince ? `A regular since ${snapshot.user.memberSince}` : 'Welcome to your daily ritual';
+    render();
+    await sync();
+  } catch (error) {
+    $('passkey-count').textContent = '—';
+    $('passkey-list').setAttribute('aria-busy', 'false');
+    $('passkey-list').innerHTML = `<li class="empty-state">${icon('shield')}<h3>Let’s try that again.</h3><p>${escapeText(error.message)}</p><button class="retry-button" id="reload-passkeys">Reload passkeys</button></li>`;
+    $('reload-passkeys').addEventListener('click', load);
+  }
+}
+function openDialog(dialog, trigger) {
+  returnFocus = trigger;
+  dialog.showModal();
+}
+document.querySelectorAll('dialog').forEach(dialog => {
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  dialog.addEventListener('close', () => { returnFocus?.focus(); });
+  dialog.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => { if (!busy) dialog.close(); }));
+});
+$('passkey-list').addEventListener('click', event => {
+  const button = event.target.closest('button[data-action]');
+  if (!button || busy) return;
+  selected = snapshot.credentials.find(key => key.id === button.dataset.id);
+  if (!selected) return;
+  if (button.dataset.action === 'rename') {
+    $('edit-error').hidden = true;
+    $('passkey-name').value = selected.name;
+    $('passkey-name').setCustomValidity('');
+    openDialog($('edit-dialog'), button);
+    $('passkey-name').focus();
+    $('passkey-name').select();
+  } else {
+    $('delete-error').hidden = true;
+    $('delete-name').textContent = selected.name;
+    $('delete-warning').textContent = snapshot.credentials.length === 1
+      ? 'This is your last passkey. Make sure you have another way to sign in before removing it.'
+      : selected.current ? 'You used this passkey for your current sign-in. Make sure you can use another passkey on your next visit.' : 'You can still sign in with your other passkeys.';
+    openDialog($('delete-dialog'), button);
+  }
+});
+$('passkey-name').addEventListener('input', () => $('passkey-name').setCustomValidity(''));
+$('edit-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (!$('passkey-name').value.trim()) {
+    $('passkey-name').setCustomValidity('Enter a name for this passkey.');
+    $('passkey-name').reportValidity();
+    return;
+  }
+  const form = event.currentTarget;
+  const id = selected.id;
+  setBusy(form, true);
+  $('edit-error').hidden = true;
+  try {
+    snapshot = await service.rename(id, $('passkey-name').value);
+    render();
+    returnFocus = [...$('passkey-list').querySelectorAll('[data-action="rename"]')].find(button => button.dataset.id === id);
+    $('edit-dialog').close();
+    notify('Passkey name updated. A little more familiar.');
+    // A credential nickname is an account label, not the WebAuthn user's name.
+  } catch (error) {
+    $('edit-error').textContent = error.message;
+    $('edit-error').hidden = false;
+  } finally { setBusy(form, false); }
+});
+$('delete-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const form = event.currentTarget;
+  setBusy(form, true);
+  $('delete-error').hidden = true;
+  try {
+    // DELETE returns the complete accepted list atomically; never sync an optimistic list.
+    snapshot = await service.remove(selected.id);
+    void sync();
+    render();
+    returnFocus = $('passkey-list').querySelector('button') || $('about-passkeys');
+    $('delete-dialog').close();
+    notify(service.demo ? 'Passkey removed from your preview account.' : 'Passkey removed from your account.');
+  } catch (error) {
+    $('delete-error').textContent = error.message;
+    $('delete-error').hidden = false;
+  } finally { setBusy(form, false); }
+});
+for (const id of ['about-passkeys', 'learn-passkeys']) $(id).addEventListener('click', event => openDialog($('about-dialog'), event.currentTarget));
+$('retry-sync').addEventListener('click', async () => {
+  $('retry-sync').disabled = true;
+  try {
+    // Refresh before retrying to include changes made in another tab or device.
+    snapshot = await service.list();
+    render();
+    await sync();
+  } catch (error) { message(error.message); }
+  finally { $('retry-sync').disabled = false; }
+});
+$('close-toast').addEventListener('click', () => { $('toast').hidden = true; clearTimeout(toastTimer); });
+load();
