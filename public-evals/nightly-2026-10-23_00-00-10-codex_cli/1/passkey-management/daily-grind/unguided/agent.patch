+// API contract and security requirements are documented in PASSKEY_API.md.
+const $ = (selector) => document.querySelector(selector);
+const storageKey = 'daily-grind-demo-passkeys-v1';
+const samples = [
+  { id: 'demo-mac', name: 'MacBook Pro', type: 'laptop', provider: 'iCloud Keychain', created: '2026-09-12', lastUsed: 'Today', current: true },
+  { id: 'demo-phone', name: 'iPhone 15', type: 'phone', provider: 'iCloud Keychain', created: '2026-09-12', lastUsed: 'Yesterday' },
+  { id: 'demo-key', name: 'YubiKey 5 NFC', type: 'key', provider: 'Security key', created: '2026-08-28', lastUsed: 'Oct 18, 2026' }
+];
+let keys = [], account = null, demo = true, action = null, toastTimer;
+const icon = (name) => `<svg aria-hidden="true"><use href="#${name}"/></svg>`;
+function notify(message) { $('#toast span').textContent = message; $('#toast').hidden = false; clearTimeout(toastTimer); toastTimer = setTimeout(() => $('#toast').hidden = true, 5500); }
+function render() {
+  $('#key-list').replaceChildren();
+  $('#key-count').textContent = $('#tab-count').textContent = keys.length;
+  if (!keys.length) {
+    const empty = document.createElement('div'); empty.className = 'empty-state';
+    empty.innerHTML = `${icon('key')}<h4>No passkeys registered</h4><p>Your registered passkeys will appear here.</p>`;
+    $('#key-list').append(empty);
+  }
+  keys.forEach(key => {
+    const row = document.createElement('div'); row.className = 'key-row';
+    row.innerHTML = `<div class="device-icon">${icon(['laptop','phone','key'].includes(key.type) ? key.type : 'key')}</div><div class="key-detail"><div class="key-title-line"><h4></h4>${key.current ? '<span class="current-device">This device</span>' : ''}</div><p></p><p></p></div><div class="row-actions"><button class="rename">${icon('edit')} Rename</button><span class="action-separator"></span><button class="delete">${icon('trash')} Delete</button></div>`;
+    row.querySelector('h4').textContent = key.name;
+    const metadata = row.querySelectorAll('.key-detail p');
+    const date = new Date(key.created + 'T12:00:00');
+    const created = Number.isNaN(date.getTime()) ? key.created : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+    metadata[0].textContent = `${key.provider || 'Passkey'} · Added ${created}`;
+    metadata[1].textContent = `Last used: ${key.lastUsed || 'Never'}`;
+    ['rename','delete'].forEach(type => {
+      const button = row.querySelector(`.${type}`); button.setAttribute('aria-label', `${type === 'rename' ? 'Rename' : 'Delete'} ${key.name}`);
+      button.addEventListener('click', () => openAction(type, key));
+    });
+    $('#key-list').append(row);
+  });
+}
+function openAction(type, key) {
+  action = { type, key };
+  const removing = type === 'delete';
+  $('#dialog-title').textContent = removing ? 'Delete this passkey?' : 'Make it your own.';
+  $('#dialog-description').textContent = removing ? `“${key.name}” will no longer be able to sign in to your account.${keys.length === 1 ? ' This is your last passkey. Make sure you have another way to sign in before continuing.' : ' Your other passkeys will still work.'}${demo ? ' This sample action does not affect a real authenticator.' : ''}` : 'Give this passkey a name you’ll recognize. This label is only used in your Daily Grind account.';
+  $('#name-field').hidden = removing; $('#passkey-name').required = !removing;
+  $('#passkey-name').value = key.name; $('#dialog-error').textContent = '';
+  $('#confirm-action').textContent = removing ? 'Delete passkey' : 'Save changes';
+  $('#confirm-action').className = removing ? 'primary danger' : 'primary';
+  $('#action-dialog').showModal();
+  if (!removing) { $('#passkey-name').focus(); $('#passkey-name').select(); }
+}
+async function api(path = '', options = {}) {
+  const response = await fetch(`/api/account/passkeys${path}`, { credentials: 'same-origin', ...options, headers: { 'Content-Type': 'application/json', ...(account?.csrfToken ? { 'X-CSRF-Token': account.csrfToken } : {}), ...options.headers } });
+  if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Sign in again to manage passkeys.' : 'We couldn’t save that change. Please try again.');
+  return response.json();
+}
+async function syncAuthenticator() {
+  if (demo) { $('#sync-message').textContent = 'Sample account · Changes are saved on this browser for this demo.'; return; }
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) {
+    $('#sync-message').textContent = 'Your account is up to date. Remove deleted keys in your passkey manager if needed.'; return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: keys.map(key => key.id) });
+    $('#sync-message').textContent = 'Your account is up to date. Browser authenticator notified.';
+  } catch {
+    $('#sync-message').textContent = 'Account updated. Browser sync is pending — retry when your authenticator is available.';
+  }
+}
+$('#action-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const name = $('#passkey-name').value.trim();
+  if (action.type === 'rename' && !name) { $('#dialog-error').textContent = 'Please enter a passkey name.'; return; }
+  const { type, key } = action;
+  $('#action-form').querySelectorAll('button').forEach(button => button.disabled = true);
+  try {
+    const updated = type === 'delete' ? keys.filter(item => item.id !== key.id) : keys.map(item => item.id === key.id ? { ...item, name } : item);
+    if (demo) {
+      localStorage.setItem(storageKey, JSON.stringify(updated)); keys = updated;
+    } else {
+      const result = await api(`/${encodeURIComponent(key.id)}`, { method: type === 'delete' ? 'DELETE' : 'PATCH', ...(type === 'rename' ? { body: JSON.stringify({ name }) } : {}) });
+      // The server returns the complete authoritative list, including after deletion.
+      validateAccount(result); account = result; keys = result.passkeys;
+    }
+    render(); $('#action-dialog').close();
+    notify(type === 'delete' ? 'Passkey deleted from your account.' : 'Passkey name updated.');
+    await syncAuthenticator();
+  } catch (error) { $('#dialog-error').textContent = error.message; }
+  finally { $('#action-form').querySelectorAll('button').forEach(button => button.disabled = false); }
+});
+$('#action-dialog').querySelectorAll('.close-dialog,.close-action').forEach(button => button.addEventListener('click', () => $('#action-dialog').close()));
+function showInfo(title, paragraphs) {
+  $('#info-title').textContent = title; $('#info-copy').replaceChildren();
+  paragraphs.forEach(text => { const p = document.createElement('p'); p.textContent = text; $('#info-copy').append(p); });
+  $('#info-dialog').showModal();
+}
+$('#info-dialog').querySelectorAll('.close-dialog,.close-info').forEach(button => button.addEventListener('click', () => $('#info-dialog').close()));
+$('#learn-more').addEventListener('click', () => showInfo('Your coffee. Your keys.', ['A passkey uses your device’s fingerprint, face recognition, or screen lock to sign you in. Your biometric information stays on your device.', 'You can give each passkey a recognizable name here. Renaming it changes its Daily Grind label; it doesn’t rename the entry in your password manager.', 'Deleting a passkey removes its access to your account. Supported browsers can also notify your authenticator of the change. Keep another way to sign in before deleting your last passkey.']));
+$('#sync-info').addEventListener('click', async () => {
+  await syncAuthenticator();
+  showInfo('Keeping your keys in sync', demo ? ['You’re viewing a sample account. Renaming and deleting these examples is saved in this browser only. No real passkeys are changed.', 'When connected to your account, the site notifies supported authenticators after a passkey is deleted. If your browser doesn’t support synchronization, you can remove the old entry from your passkey manager.'] : ['Your account’s accepted passkey list is shared with supported browser authenticators after changes. The notification helps your authenticator remove credentials that are no longer accepted.', 'If synchronization isn’t supported or your authenticator isn’t connected, remove deleted entries in your passkey manager. Tap the information icon to retry synchronization.']);
+});
+function selectTab(tab) {
+  document.querySelectorAll('[data-tab]').forEach(button => { const selected = button.dataset.tab === tab; button.classList.toggle('active', selected); button.setAttribute('aria-selected', selected); });
+  $('#passkey-panel').hidden = tab !== 'passkeys'; $('#email-panel').hidden = tab !== 'email';
+}
+document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => selectTab(button.dataset.tab)));
+$('.tabs').addEventListener('keydown', event => { if (['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) { event.preventDefault(); const tab = event.key === 'Home' ? 'email' : event.key === 'End' ? 'passkeys' : $('#passkey-panel').hidden ? 'passkeys' : 'email'; selectTab(tab); document.querySelector(`[data-tab="${tab}"]`).focus(); } });
+$('#back-passkeys').addEventListener('click', () => selectTab('passkeys'));
+document.querySelectorAll('[data-section]').forEach(button => button.addEventListener('click', () => {
+  const section = button.dataset.section, security = section === 'Sign-in & security';
+  document.querySelectorAll('[data-section]').forEach(item => { item.classList.toggle('selected', item === button); item.removeAttribute('aria-current'); });
+  button.setAttribute('aria-current','page'); $('#page-title').textContent = $('#crumb').textContent = section;
+  $('#security-content').hidden = !security; $('#other-section').hidden = security;
+  if (!security) { $('#other-section').replaceChildren(); const title = document.createElement('h2'); title.textContent = section; const text = document.createElement('p'); text.textContent = 'This account preview focuses on sign-in & security. Return to manage your passkeys.'; const back = document.createElement('button'); back.className = 'primary'; back.textContent = 'Back to sign-in & security'; back.onclick = () => document.querySelector('[data-section="Sign-in & security"]').click(); $('#other-section').append(title,text,back); }
+}));
+function validateAccount(data) {
+  if (!data || !Array.isArray(data.passkeys) || typeof data.rpId !== 'string' || typeof data.userId !== 'string' || !data.userId || data.passkeys.some(key => typeof key.id !== 'string' || typeof key.name !== 'string') || !data.csrfToken) throw new Error('Account data could not be loaded safely. Please refresh and try again.');
+}
+async function init() {
+  try {
+    const response = await fetch('/api/account/passkeys', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
+    if (response.ok && response.headers.get('content-type')?.includes('application/json')) {
+      const data = await response.json(); validateAccount(data); account = data; keys = data.passkeys; demo = false;
+      $('#data-mode').textContent = 'Registered devices';
+      if (data.displayName) $('#customer-name').textContent = data.displayName;
+    } else if (![404,405].includes(response.status) && !(response.ok && response.headers.get('content-type')?.includes('text/html'))) {
+      throw new Error(response.status === 401 ? 'Sign in to view your passkeys.' : 'Unable to load your passkeys. Please refresh to try again.');
+    }
+    if (demo) {
+      try { const saved = JSON.parse(localStorage.getItem(storageKey)); keys = Array.isArray(saved) && saved.every(key => samples.some(sample => sample.id === key.id) && typeof key.name === 'string') ? saved : structuredClone(samples); }
+      catch { keys = structuredClone(samples); }
+    }
+    render(); await syncAuthenticator();
+  } catch (error) { $('#key-list').textContent = error.message; $('#key-list').className = 'empty-state'; $('#key-count').textContent = $('#tab-count').textContent = '—'; $('#data-mode').textContent = 'Unavailable'; $('#sync-message').textContent = 'Passkey management is unavailable until your account can be loaded.'; }
+}
+init();
