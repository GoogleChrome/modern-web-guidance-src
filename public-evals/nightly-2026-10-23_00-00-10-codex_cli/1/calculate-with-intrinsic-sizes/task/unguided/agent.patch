+  <script>
+    const sourcingToggle = document.getElementById('accordion-toggle');
+    const sourcingContent = document.getElementById('sourcing-content');
+    const sourcingCopy = sourcingContent.querySelector('.sourcing-copy');
+
+    // Keep the numeric fallback in sync for browsers without calc-size().
+    const sourcingObserver = new ResizeObserver(([entry]) => {
+      const blockSize = entry.borderBoxSize?.[0]?.blockSize ?? entry.contentRect.height;
+      sourcingContent.style.setProperty('--sourcing-content-size', `${blockSize}px`);
+    });
+    sourcingObserver.observe(sourcingCopy);
+
+    sourcingToggle.addEventListener('click', () => {
+      const expanded = sourcingToggle.getAttribute('aria-expanded') !== 'true';
+      sourcingToggle.setAttribute('aria-expanded', String(expanded));
+      sourcingContent.classList.toggle('is-expanded', expanded);
+      sourcingContent.inert = !expanded;
+    });
+  </script>
