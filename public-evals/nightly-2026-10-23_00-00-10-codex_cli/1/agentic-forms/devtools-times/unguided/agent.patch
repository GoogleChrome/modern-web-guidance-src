diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..d738d52
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,17 @@
+interface FormResult {
+  success: boolean;
+  message: string;
+}
+
+interface AgentSubmitEvent extends Event {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<FormResult>) => void;
+}
+
+// Call synchronously during submission; the result settles after the API request.
+export function respondToAgent(event: Event, result: Promise<FormResult>) {
+  const agentEvent = event as AgentSubmitEvent;
+  if (agentEvent.agentInvoked && typeof agentEvent.respondWith === 'function') {
+    agentEvent.respondWith(result);
+  }
+}
