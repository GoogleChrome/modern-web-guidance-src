diff --git a/src/utils/agentForm.ts b/src/utils/agentForm.ts
new file mode 100644
index 0000000..8c5ce80
--- /dev/null
+++ b/src/utils/agentForm.ts
@@ -0,0 +1,21 @@
+import type { FormEvent } from 'react';
+
+type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<string>) => void;
+};
+
+// Both manual and agent submissions use the live form values and the same action.
+export function submitAgentForm(
+  event: FormEvent<HTMLFormElement>,
+  action: (data: FormData) => Promise<string>,
+) {
+  event.preventDefault();
+  const result = action(new FormData(event.currentTarget));
+  const nativeEvent = event.nativeEvent as AgentSubmitEvent;
+
+  // Call synchronously during submission, before the asynchronous action finishes.
+  if (nativeEvent.agentInvoked && typeof nativeEvent.respondWith === 'function') {
+    nativeEvent.respondWith(result);
+  }
+}
