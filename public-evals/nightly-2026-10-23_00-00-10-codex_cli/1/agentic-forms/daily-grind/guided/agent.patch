index 0000000..59b911c
--- /dev/null
+++ b/app.mjs
@@ -0,0 +1,45 @@
+const searchForm = document.querySelector('#menu-search');
+const cards = [...document.querySelectorAll('[data-drink]')];
+const drinks = cards.map(card => ({
+  id: card.dataset.drink,
+  name: card.querySelector('h3').textContent.trim(),
+  description: card.querySelector('p').textContent.trim(),
+  detailsUrl: card.querySelector('form').getAttribute('action'),
+}));
+
+// Native forms remain usable in browsers that ignore the WebMCP attributes.
+// Both people and agents execute these same handlers and update the same UI.
+function respond(event, result) {
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(Promise.resolve(JSON.stringify(result)));
+  }
+}
+
+searchForm.addEventListener('submit', event => {
+  event.preventDefault();
+  if (!searchForm.checkValidity()) {
+    searchForm.reportValidity();
+    respond(event, { error: 'Search must contain at most 100 characters.' });
+    return;
+  }
+
+  const query = new FormData(searchForm).get('query').trim().toLowerCase();
+  const matches = drinks.filter(drink =>
+    `${drink.name} ${drink.description}`.toLowerCase().includes(query));
+  const matchingIds = new Set(matches.map(drink => drink.id));
+  cards.forEach(card => { card.hidden = !matchingIds.has(card.dataset.drink); });
+  document.querySelector('#menu-status').textContent = matches.length
+    ? `${matches.length} ${matches.length === 1 ? 'drink' : 'drinks'} found.`
+    : 'No drinks found. Try another search or leave the field blank to show all drinks.';
+  respond(event, { drinks: matches, count: matches.length });
+});
+
+document.querySelectorAll('[data-drink-details]').forEach(form => {
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    const drink = drinks.find(item => item.id === form.dataset.drinkDetails);
+    const card = form.closest('[data-drink]');
+    card.querySelector('.drink-details').textContent = `${drink.name}: ${drink.description}`;
+    respond(event, { drink });
+  });
+});
