@@ -0,0 +1,149 @@
+(() => {
+  'use strict';
+
+  const drinks = [
+    { id: 'maple-oat-latte', name: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup.', price: 550, milk: 'oat' },
+    { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost.', price: 350, milk: 'none' },
+    { id: 'cold-brew', name: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness.', price: 450, milk: 'none' }
+  ];
+  const sizes = { small: 0, medium: 75, large: 125 };
+  const milks = ['none', 'whole', 'oat', 'almond'];
+  const order = [];
+  let nextId = 1;
+  const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+  const status = message => { document.querySelector('#status').textContent = message; };
+  const quantityValue = value => {
+    const number = Number(value);
+    return Number.isInteger(number) && number >= 1 && number <= 20 ? number : null;
+  };
+
+  document.querySelector('#drink-menu').innerHTML = drinks.map(drink => `
+    <article class="card" data-drink-id="${drink.id}">
+      <h3>${drink.name}</h3>
+      <p>${drink.description}</p>
+      <p class="price">From ${money(drink.price)}</p>
+      <form aria-label="Add ${drink.name} to order" toolname="add_${drink.id.replaceAll('-', '_')}" toolautosubmit tooldescription="Add ${drink.name} with the selected size, milk, and quantity to the local order.">
+        <input type="hidden" name="drink_id" value="${drink.id}">
+        <label for="${drink.id}-size">Size</label>
+        <select id="${drink.id}-size" name="size">
+          <option value="small">Small — ${money(drink.price)}</option>
+          <option value="medium">Medium — ${money(drink.price + sizes.medium)}</option>
+          <option value="large">Large — ${money(drink.price + sizes.large)}</option>
+        </select>
+        <label for="${drink.id}-milk">Milk (included)</label>
+        <select id="${drink.id}-milk" name="milk">
+          ${milks.map(milk => `<option value="${milk}" ${milk === drink.milk ? 'selected' : ''}>${milk === 'none' ? 'No milk' : milk[0].toUpperCase() + milk.slice(1)}</option>`).join('')}
+        </select>
+        <label for="${drink.id}-quantity">Quantity</label>
+        <input id="${drink.id}-quantity" name="quantity" toolparamdescription="Number of drinks, from 1 to 20." type="number" min="1" max="20" value="1" required>
+        <button type="submit" class="btn">Add to order</button>
+      </form>
+    </article>`).join('');
+
+  function renderOrder() {
+    const items = document.querySelector('#order-items');
+    items.replaceChildren();
+    if (!order.length) {
+      const empty = document.createElement('p');
+      empty.textContent = 'Your order is empty. Choose a drink above to get started.';
+      items.append(empty);
+    }
+    for (const item of order) {
+      const drink = drinks.find(drink => drink.id === item.drinkId);
+      const row = document.createElement('div');
+      row.className = 'order-item';
+      // Every interpolated value is from the fixed menu or validated numeric state.
+      row.innerHTML = `
+        <h3>${drink.name}</h3>
+        <p>${item.size[0].toUpperCase() + item.size.slice(1)} · ${item.milk === 'none' ? 'No milk' : item.milk + ' milk'} · ${money(item.unitPrice)} each</p>
+        <p>Subtotal: ${money(item.unitPrice * item.quantity)}</p>
+        `;
+      items.append(row);
+    }
+    const itemSelect = document.querySelector('#order-item-id');
+    itemSelect.replaceChildren();
+    for (const item of order) {
+      const drink = drinks.find(drink => drink.id === item.drinkId);
+      itemSelect.add(new Option(`${drink.name} · ${item.size} · ${item.milk} milk (quantity ${item.quantity})`, item.id));
+    }
+    document.querySelector('#update-order').hidden = order.length === 0;
+    document.querySelector('#order-total').textContent = `Order total: ${money(order.reduce((total, item) => total + item.unitPrice * item.quantity, 0))}`;
+    document.querySelector('#clear-button').disabled = order.length === 0;
+  }
+
+  function result(event, value) {
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(value));
+    }
+  }
+  const orderResult = () => ({ items: order.map(item => ({ ...item })), totalCents: order.reduce((total, item) => total + item.unitPrice * item.quantity, 0), currency: 'USD' });
+
+  document.querySelector('#search-menu').addEventListener('submit', event => {
+    event.preventDefault();
+    const query = new FormData(event.currentTarget).get('query').trim().toLowerCase();
+    let count = 0;
+    for (const drink of drinks) {
+      const matches = `${drink.name} ${drink.description}`.toLowerCase().includes(query);
+      document.querySelector(`[data-drink-id="${drink.id}"]`).hidden = !matches;
+      if (matches) count++;
+    }
+    result(event, { drinks: drinks.filter(drink => `${drink.name} ${drink.description}`.toLowerCase().includes(query)) });
+    document.querySelector('#search-result').textContent = `${count} ${count === 1 ? 'drink' : 'drinks'} found.`;
+  });
+
+  document.querySelector('#drink-menu').addEventListener('submit', event => {
+    event.preventDefault();
+    const form = event.target;
+    if (!form.reportValidity()) return;
+    const data = new FormData(form);
+    const drink = drinks.find(drink => drink.id === data.get('drink_id'));
+    const size = data.get('size');
+    const milk = data.get('milk');
+    const quantity = quantityValue(data.get('quantity'));
+    if (!drink || !Object.hasOwn(sizes, size) || !milks.includes(milk) || quantity === null) {
+      result(event, { error: 'Invalid drink options or quantity.' });
+      status('Choose a valid drink, size, milk, and quantity from 1 to 20.');
+      return;
+    }
+    const existing = order.find(item => item.drinkId === drink.id && item.size === size && item.milk === milk);
+    if (existing && existing.quantity + quantity > 20) {
+      result(event, { error: 'Maximum quantity is 20 per drink combination.' });
+      status('Each drink combination can have up to 20 items. Update its quantity in your order.');
+      return;
+    }
+    if (existing) existing.quantity += quantity;
+    else order.push({ id: nextId++, drinkId: drink.id, size, milk, quantity, unitPrice: drink.price + sizes[size] });
+    result(event, orderResult());
+    renderOrder();
+    status(`Added ${quantity} ${drink.name} to your order.`);
+  });
+
+  document.querySelector('#update-order').addEventListener('submit', event => {
+    event.preventDefault();
+    const data = new FormData(event.target);
+    const index = order.findIndex(item => item.id === Number(data.get('item_id')));
+    if (index < 0) { result(event, { error: 'Order item not found.' }); return; }
+    if (data.get('action') === 'remove') {
+      order.splice(index, 1);
+      status('Item removed from your order.');
+    } else {
+      if (!event.target.reportValidity()) return;
+      const quantity = quantityValue(data.get('quantity'));
+      if (quantity === null) return;
+      order[index].quantity = quantity;
+      status('Order quantity updated.');
+    }
+    result(event, orderResult());
+    renderOrder();
+  });
+
+  document.querySelector('#clear-order').addEventListener('submit', event => {
+    event.preventDefault();
+    order.length = 0;
+    result(event, orderResult());
+    renderOrder();
+    status('Your order has been cleared.');
+  });
+
+  renderOrder();
+})();
