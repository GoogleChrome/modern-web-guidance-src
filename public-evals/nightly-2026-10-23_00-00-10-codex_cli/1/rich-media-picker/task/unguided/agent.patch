+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const listbox = document.getElementById('roast-options');
+    const options = [...listbox.querySelectorAll('[role="option"]')];
+    const value = document.getElementById('roast-value');
+    const orderButton = document.getElementById('order-button');
+    let selected = 0;
+
+    function selectRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      // Copy rich content without duplicating the option's accessible-label IDs.
+      const content = options[index].cloneNode(true);
+      content.querySelectorAll('[id]').forEach(element => element.removeAttribute('id'));
+      value.replaceChildren(...content.childNodes);
+      orderButton.href = '/order-online?roast=' + encodeURIComponent(options[index].dataset.roast);
+    }
+
+    function closeRoasts(returnFocus = false) {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts(index = selected) {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    trigger.addEventListener('click', () => listbox.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => {
+        selectRoast(index);
+        closeRoasts(true);
+      });
+      option.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) {
+          event.preventDefault();
+          options[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(index);
+          closeRoasts(true);
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closeRoasts(true);
+        } else if (event.key.length === 1) {
+          const match = options.findIndex((_, offset) => {
+            const candidate = options[(index + offset + 1) % options.length];
+            return candidate.querySelector('strong').textContent.toLowerCase().startsWith(event.key.toLowerCase());
+          });
+          if (match !== -1) options[(index + match + 1) % options.length].focus();
+        }
+      });
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closeRoasts();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closeRoasts();
+    });
+    selectRoast(selected);
+  </script>
