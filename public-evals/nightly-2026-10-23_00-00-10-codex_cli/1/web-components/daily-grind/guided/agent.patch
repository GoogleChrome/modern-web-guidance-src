new file mode 100644
index 0000000..11272de
--- /dev/null
+++ b/components/site-navigation.js
@@ -0,0 +1,95 @@
+import { baseStyles, createTemplate, mount } from './shared.js';
+
+const template = createTemplate(`
+  <style>
+    ${baseStyles}
+    :host { position: sticky; top: 0; z-index: 1000; }
+    nav {
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 1rem;
+    }
+    ::slotted([slot="brand"]) { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    #links { display: flex; align-items: center; gap: 20px; }
+    ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; }
+    ::slotted(a:hover) { color: var(--accent, #ffab40); }
+    ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+    button { display: none; background: transparent; border: 1px solid currentColor; border-radius: 4px; padding: 6px 12px; cursor: pointer; }
+    button:focus-visible, ::slotted(a:focus-visible) { outline-color: white; }
+    @media (max-width: 48rem) {
+      nav { flex-wrap: wrap; }
+      button { display: inline-block; }
+      #links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 12px; }
+      #links[hidden] { display: none; }
+      ::slotted(a) { padding: 6px 0; }
+    }
+  </style>
+  <nav aria-label="Main navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+    <div id="links" hidden><slot></slot></div>
+  </nav>
+`);
+
+class SiteNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    const root = mount(this, template);
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('#links');
+  }
+
+  connectedCallback() {
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const options = { signal: this.#controller.signal };
+    this.#media = window.matchMedia('(max-width: 48rem)');
+    this.#button.addEventListener('click', () => {
+      this.#setExpanded(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, options);
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        event.preventDefault();
+        this.#button.focus();
+        this.#setExpanded(false);
+      }
+    }, options);
+    this.addEventListener('click', (event) => {
+      if (this.#media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.#button.focus();
+        this.#setExpanded(false);
+      }
+    }, options);
+    this.#media.addEventListener('change', () => this.#syncLayout(), options);
+    this.#syncLayout();
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #setExpanded(expanded) {
+    this.#button.setAttribute('aria-expanded', String(expanded));
+    this.#links.hidden = !expanded;
+  }
+
+  #syncLayout() {
+    // Never hide focused links when a resize switches to the collapsed layout.
+    if (this.#media.matches && this.contains(document.activeElement)) this.#button.focus();
+    if (!this.#media.matches && this.shadowRoot.activeElement === this.#button) {
+      this.querySelector('a')?.focus();
+    }
+    this.#setExpanded(!this.#media.matches);
+  }
+}
+
+if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
