+import { baseStyles, buttonStyles, createTemplate, mount } from './shared.js';
+
+const template = createTemplate(`
+  <style>
+    ${baseStyles}
+    ${buttonStyles}
+    :host { height: 100%; }
+    article {
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      background: var(--card-background, white);
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+    }
+    ::slotted([slot="description"]) { margin: 0 0 auto; }
+  </style>
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </article>
+`);
+
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    mount(this, template);
+  }
+}
