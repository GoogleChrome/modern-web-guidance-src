@@ -0,0 +1,36 @@
+// Parse each component template once, then clone it for every instance.
+export function createTemplate(markup) {
+  const template = document.createElement('template');
+  template.innerHTML = markup;
+  return template;
+}
+
+export function mount(host, template) {
+  const root = host.attachShadow({ mode: 'open', delegatesFocus: true });
+  root.append(template.content.cloneNode(true));
+  return root;
+}
+
+export const baseStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+  button { font: inherit; color: inherit; }
+  button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--primary, #4e342e);
+    outline-offset: 4px;
+  }
+`;
+
+export const buttonStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a:hover) { background: var(--text, #3e2723); }
+`;
