+        nav { max-width: 1280px; margin: auto; padding: 23px 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
+        .brand { text-decoration: none; font-size: 17px; letter-spacing: 1px; font-weight: 800; display: flex; align-items: center; gap: 11px; white-space: nowrap; }
+        .mark { font-size: 33px; line-height: 1; transform: rotate(-40deg); }
+        .links { display: flex; align-items: center; gap: 30px; }
+        .links a { text-decoration: none; font-size: 11px; padding: 9px 0; }
+        .links a:hover { text-decoration: underline; text-underline-offset: 5px; }
+        .links .account { border-left: 1px solid #d3d5c8; padding-left: 25px; }
+        .links .logout { border: 1px solid #c5cbbd; border-radius: 3px; padding: 9px 13px; }
+        button { display: none; background: transparent; border: 1px solid #b9c2b2; border-radius: 3px; padding: 10px 13px; color: inherit; font-size: 12px; }
+        @media(max-width: 1000px) { nav { padding: 20px 32px; } .links { gap: 20px; } }
+        @media(max-width: 760px) { nav { padding: 18px 24px; flex-wrap: wrap; gap: 16px; } .brand { font-size: 14px; } button { display: block; } .links { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-top: 5px; } .links[data-open] { display: flex; } .links a { font-size: 14px; padding: 14px 0; } .links .account { border-left: 0; padding-left: 0; } .links .logout { margin-top: 6px; text-align: center; } }
+      </style>
+      <nav aria-label="Main navigation">
+        <a class="brand" href="#" aria-label="The Daily Grind home"><span class="mark" aria-hidden="true">◒</span> THE DAILY GRIND</a>
+        <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu <span aria-hidden="true">☰</span></button>
+        <div class="links" id="navigation-links"><a href="#menu">Our coffee</a><a href="#visit">Our place</a><a href="#rewards">Rewards</a><a class="account" href="/account">My account</a><a class="logout" href="/logout">Log out</a></div>
+      </nav>`;
+  }
+  connectedCallback() {
+    this.controller = new AbortController();
+    const { signal } = this.controller;
+    const toggle = this.shadowRoot.querySelector('button');
+    const links = this.shadowRoot.querySelector('.links');
+    const close = () => { toggle.setAttribute('aria-expanded', 'false'); links.removeAttribute('data-open'); };
+    toggle.addEventListener('click', () => {
+      const open = toggle.getAttribute('aria-expanded') !== 'true';
+      toggle.setAttribute('aria-expanded', String(open));
+      links.toggleAttribute('data-open', open);
+    }, { signal });
+    links.addEventListener('click', event => {
+      if (event.target.closest('a')) {
+        // Move focus out of the mobile disclosure before it is hidden.
+        toggle.focus();
+        close();
+      }
+    }, { signal });
+    this.shadowRoot.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); }
+    }, { signal });
+  }
+  disconnectedCallback() { this.controller?.abort(); }
+}
