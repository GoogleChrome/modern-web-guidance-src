+      details p { margin-top: 16px; } details a { display: inline-block; margin-top: 12px; font-size: 12px; font-weight: bold; text-underline-offset: 4px; }
+      @media(max-width:1000px) { section { padding: 35px 32px; } } @media(max-width:700px) { section { padding: 30px 24px; flex-wrap: wrap; gap: 18px; } .icon { font-size: 35px; } .copy { flex-basis: 75%; } h2 { font-size: 28px; } details { width: 100%; } }
+    </style><section aria-labelledby="rewards-title"><span class="icon" aria-hidden="true">✳</span><div class="copy"><p class="eyebrow">GOOD DAYS DESERVE GOOD PERKS</p><h2 id="rewards-title">Make it a regular thing.</h2><p>Your daily ritual, with a little extra. Get to know Daily Grind Rewards.</p></div><details><summary>Discover the perks</summary><p>Bring a little more good to your daily coffee ritual. Explore our rewards program and sign in to see your member benefits.</p><a href="/rewards">Explore Daily Grind Rewards ${arrow}</a></details></section>`;
+  }
+}
