+  align-items:center;
+  gap:10px;
+  font-size:10px;
+  color:#6d7469;
+  margin-top:32px
+}
+.sun {
+  color:#7a815b;
+  font-size:25px
+}
+.hero-image {
+  position:relative;
+  min-height:565px
+}
+.hero-image>img {
+  width:100%;
+  height:100%;
+  position:absolute;
+  object-fit:cover;
+  object-position:center 55%
+}
+.image-note {
+  position:absolute;
+  bottom:29px;
+  left:30px;
+  padding:15px 20px;
+  background:#faf8efed;
+  border:1px solid #fff8;
+  display:flex;
+  gap:14px;
+  align-items:center;
+  border-radius:3px;
+  font-size:9px;
+  letter-spacing:1.2px
+}
+.image-note>span {
+  font-size:26px
+}
+.image-note small {
+  display:block;
+  font-family:var(--serif);
+  font-size:17px;
+  letter-spacing:0;
+  margin-top:6px
+}
+.round-stamp {
+  position:absolute;
+  right:24px;
+  top:24px;
+  border-radius:50%;
+  width:103px;
+  height:103px;
