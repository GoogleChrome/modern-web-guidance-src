+/** Native, dependency-free components. Brand tokens inherit through each shadow root. */
+const baseStyles = `
+  :host { font-family: Arial, Helvetica, sans-serif; color: var(--ink, #293d34); }
+  *, *::before, *::after { box-sizing: border-box; }
+  a { color: inherit; }
+  button, a { -webkit-tap-highlight-color: transparent; }
+  button { font: inherit; cursor: pointer; }
+  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #a86c37; outline-offset: 4px; }
+  button:disabled { cursor: default; }
+  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
+`;
+const escapeHTML = (value = '') => value.replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
+const arrow = '<span aria-hidden="true">↗</span>';
+
+class GrindNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
