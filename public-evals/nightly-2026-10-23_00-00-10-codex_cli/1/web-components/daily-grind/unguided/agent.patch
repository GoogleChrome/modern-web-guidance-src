+  display:flex;
+  flex-direction:column;
+  justify-content:center;
+  text-align:center;
+  font-size:8px;
+  letter-spacing:1.4px;
+  line-height:1.15;
+  transform:rotate(12deg);
+  outline:1px dashed #7c8a6c;
+  outline-offset:-7px
+}
+.round-stamp span {
+  font-size:27px;
+  line-height:.7
+}
+.values-strip {
+  display:flex;
+  justify-content:center;
+  align-items:center;
+  gap:48px;
+  padding:25px 25px;
+  background:#eeeee3;
+  border-bottom:1px solid var(--line);
+  font-size:11px;
+  letter-spacing:.2px
+}
+.values-strip i {
+  font-style:normal;
+  font-size:20px;
+  color:#859075
+}
+.favorites {
+  padding-top:70px;
+  padding-bottom:65px;
+  scroll-margin-top:20px
+}
+.section-heading {
+  display:flex;
+  align-items:end;
+  justify-content:space-between;
+  margin-bottom:29px
+}
+.section-heading .eyebrow {
+  margin-bottom:11px
+}
+h2 {
+  font-family:var(--serif);
+  font-weight:400;
+  font-size:42px;
+  letter-spacing:-1.5px;
+  line-height:1.15;
+  margin:0
+}
+.section-heading>p {
+  font-size:12px;
+  color:var(--muted);
+  line-height:1.8;
+  margin:0 0 3px
+}
+.menu-note {
+  text-align:center;
+  color:var(--muted);
+  font-size:11px;
+  margin:29px 0 0
+}
+.story {
+  display:grid;
+  grid-template-columns:1fr 1fr;
+  gap:72px;
+  padding-top:13px;
+  padding-bottom:80px;
+  align-items:center
+}
+.story-image {
+  height:360px;
+  overflow:hidden;
+  border-radius:3px
+}
+.story-image img {
+  width:100%;
+  height:100%;
+  object-fit:cover
+}
+.story-copy .eyebrow {
+  margin-bottom:14px
+}
+.story-copy h2 {
+  margin-bottom:23px
+}
+.story-copy>p:not(.eyebrow) {
+  font-size:13px;
+  line-height:1.9;
+  max-width:365px;
+  color:var(--muted)
+}
+.text-link {
+  font-size:12px;
+  font-weight:bold;
+  display:inline-flex;
+  gap:35px;
+  text-underline-offset:6px;
+  margin-top:12px
+}
+grind-rewards {
+  display:block
+}
+footer {
+  padding-top:49px!important;
+  padding-bottom:22px!important
+}
+.footer-top {
+  display:flex;
+  justify-content:space-between;
+  align-items:center;
+  padding-bottom:38px;
+  gap:30px
+}
+.brand {
+  font-weight:800;
+  font-size:16px;
+  letter-spacing:1px;
+  text-decoration:none;
+  position:relative;
+  padding-left:40px
+}
+.brand-icon {
+  position:absolute;
+  left:0;
+  top:-5px;
+  font-size:34px;
+  transform:rotate(-40deg)
+}
+.brand-sub {
+  display:block;
+  font-size:7px;
+  letter-spacing:1.9px;
+  margin-top:8px;
+  font-weight:500
+}
+.footer-top>p {
+  font-family:var(--serif);
+  font-size:19px;
+  line-height:1.4;
+  margin:0;
+  color:#6b7364
+}
+.footer-top nav {
+  display:flex;
+  gap:26px;
+  font-size:11px
+}
+.footer-top nav a {
+  text-decoration:none
+}
+.footer-top nav a:hover {
+  text-decoration:underline
+}
+.footer-bottom {
+  border-top:1px solid var(--line);
+  padding-top:22px;
+  display:flex;
+  justify-content:space-between;
+  font-size:9px;
+  color:var(--muted)
+}
+.footer-bottom a {
+  text-decoration:none
+}
+@media(min-width:1441px) {
+  .hero-copy {
+    padding-left:144px
+  }
+}
