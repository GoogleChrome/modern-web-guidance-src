+:root {
+  --forest:#29483e;
+  --ink:#293d34;
+  --cream:#f8f6ef;
+  --muted:#6e7469;
+  --line:#dedfd3;
+  --serif:Georgia,'Times New Roman',serif;
+  font-family:Arial,Helvetica,sans-serif;
+  color:var(--ink);
+  background:var(--cream);
+  scroll-behavior:smooth;
+  scroll-padding-top:105px
+}
+* {
+  box-sizing:border-box
+}
+body {
+  margin:0
+}
+a {
+  color:inherit
+}
+button,a {
+  -webkit-tap-highlight-color:transparent
+}
+a:focus-visible,button:focus-visible,summary:focus-visible {
+  outline:3px solid #a86c37;
+  outline-offset:5px
+}
+main:focus {
+  outline:none
+}
+.skip-link {
+  position:fixed;
+  left:15px;
+  top:-100px;
+  padding:12px;
+  background:white;
+  z-index:10
+}
+.skip-link:focus {
+  top:10px
+}
+.announcement {
+  background:var(--forest);
+  color:#fff;
+  text-align:center;
+  font-size:11px;
+  letter-spacing:.4px;
+  padding:11px 16px
+}
+.announcement span {
+  color:#d5ddca;
+  margin-left:9px
+}
+grind-navigation {
+  display:block;
+  position:sticky;
+  top:0;
+  z-index:5
+}
+.section-wrap {
+  max-width:1280px;
+  margin:auto;
+  padding-left:64px;
+  padding-right:64px
+}
+.hero {
+  display:grid;
+  grid-template-columns:1fr 1fr;
+  max-width:1440px;
+  margin:auto;
+  min-height:565px
+}
+.hero-copy {
+  padding:77px 54px 40px max(64px,calc((100vw - 1152px)/2));
+  display:flex;
+  align-items:flex-start;
+  flex-direction:column;
+  justify-content:center
+}
+.eyebrow {
+  font-size:10px;
+  font-weight:700;
+  letter-spacing:1.8px;
+  margin:0 0 21px;
+  line-height:1.7
+}
+.hero .eyebrow {
+  display:flex;
+  gap:12px;
+  align-items:center
+}
+.small-line {
+  width:26px;
+  height:1px;
+  background:var(--forest)
+}
+h1 {
+  font-family:var(--serif);
+  font-size:clamp(46px,5.3vw,78px);
+  letter-spacing:-3px;
+  font-weight:400;
+  line-height:1.06;
+  margin:0 0 24px
+}
+h1 em {
+  font-weight:400;
+  color:#647b57
+}
+.hero-description {
+  font-size:14px;
+  line-height:1.9;
+  color:#677064;
+  max-width:330px;
+  margin:0 0 27px
+}
+.button {
+  display:inline-flex;
+  gap:29px;
+  align-items:center;
+  background:var(--forest);
+  color:white;
+  text-decoration:none;
+  padding:16px 22px;
+  border-radius:3px;
+  font-size:12px;
+  font-weight:600;
+  transition:background .2s
+}
+.button:hover {
+  background:#3d5d4e
+}
+.button span {
+  font-size:19px
+}
+.hero-footnote {
