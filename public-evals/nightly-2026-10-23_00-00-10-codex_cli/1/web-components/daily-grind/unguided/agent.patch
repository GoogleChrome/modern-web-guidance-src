+        .price { font-size: 12px; white-space: nowrap; }
+        .description { font-size: 12px; line-height: 1.9; color: #6e7469; margin: 12px 0 17px; }
+        .notes { font-size: 9px; letter-spacing: .4px; color: #737c65; margin: auto 0 21px; }
+        .details { border: 0; border-top: 1px solid #e0e2d6; padding: 17px 0 0; display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; background: transparent; font-size: 11px; font-weight: bold; color: #29483e; }
+        .details span { font-size: 18px; } .details:hover { color: #7b5834; }
+        dialog { color: #293d34; background: #f8f6ef; border: 1px solid #d0d5c5; border-radius: 8px; max-width: min(460px, calc(100vw - 36px)); padding: 32px; }
+        dialog::backdrop { background: #14291fc0; }
+        dialog h2 { font: 32px var(--serif, Georgia, serif); margin: 15px 0; }
+        dialog p { font-size: 14px; line-height: 1.9; }
+        .close { float: right; border: 1px solid #bdc4b3; background: transparent; padding: 8px 12px; border-radius: 3px; color: inherit; }
+        .order { display: inline-block; padding: 13px 20px; margin-top: 10px; background: #29483e; color: white; border-radius: 3px; text-decoration: none; font-size: 13px; }
+        @media(max-width: 1000px) and (min-width: 701px) { .body { padding: 17px; } h3 { font-size: 21px; } .photo { height: 210px; } .title-row { flex-wrap: wrap; } }
+        @media(max-width: 700px) { .photo { height: 290px; } }
+      </style>
+      <article aria-labelledby="coffee-name"><div class="photo"><img src="${image}" alt="${attr('image-alt')}" loading="lazy" width="800" height="650"><span class="badge">${attr('label')}</span></div>
+      <div class="body"><div class="title-row"><h3 id="coffee-name">${attr('name')}</h3><span class="price">${attr('price')}</span></div><p class="description">${attr('description')}</p><p class="notes">${attr('notes')}</p><button type="button" class="details" aria-haspopup="dialog" aria-label="View details for ${attr('name')}">Explore this coffee ${arrow}</button></div></article>
+      <dialog aria-labelledby="dialog-title" aria-describedby="dialog-description"><button class="close" type="button" aria-label="Close coffee details" autofocus>Close ×</button><div style="clear:both"></div><h2 id="dialog-title">${attr('name')}</h2><p id="dialog-description">${attr('details')}</p><p>${attr('price')} · Made fresh for you.</p><a class="order" href="/order-online">Order online ${arrow}</a></dialog>`;
+    const dialog = this.shadowRoot.querySelector('dialog');
+    this.shadowRoot.querySelector('.details').addEventListener('click', () => dialog.showModal());
+    this.shadowRoot.querySelector('.close').addEventListener('click', () => dialog.close());
+  }
+}
