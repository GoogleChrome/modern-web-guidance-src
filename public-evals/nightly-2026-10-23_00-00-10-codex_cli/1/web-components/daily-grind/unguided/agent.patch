+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'category', 'label', 'price', 'image', 'image-alt', 'description', 'notes', 'details'];
+  constructor() { super(); this.attachShadow({ mode: 'open' }); }
