+class CoffeeMenu extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.filter = 'all';
+    this.shadowRoot.innerHTML = `<style>${baseStyles}
+      :host { display: block; } .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 23px; gap: 15px; }
+      .filters { display: flex; gap: 6px; } button { border: 1px solid transparent; background: transparent; padding: 8px 17px; border-radius: 30px; color: #66705f; font-size: 11px; min-height: 35px; }
+      button[aria-pressed="true"] { background: #29483e; color: white; } button:hover:not([aria-pressed="true"]) { border-color: #b6c0ac; }
+      .season { color: #727b65; font-size: 10px; letter-spacing: .4px; }
+      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
+      @media(max-width:700px) { .grid { grid-template-columns: 1fr; gap: 24px; } .season { display:none; } }
+    </style><div class="toolbar"><div class="filters" role="group" aria-label="Filter coffees by temperature"><button type="button" data-filter="all" aria-pressed="true">All favorites</button><button type="button" data-filter="hot" aria-pressed="false">Hot</button><button type="button" data-filter="iced" aria-pressed="false">Iced</button></div><span class="season">A LITTLE SOMETHING FOR EVERY MOOD</span></div><p class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p><div class="grid"><slot></slot></div>`;
+  }
+  connectedCallback() {
+    this.controller = new AbortController();
+    const { signal } = this.controller;
+    this.shadowRoot.addEventListener('click', event => {
+      const button = event.target.closest('button[data-filter]');
+      if (!button) return;
+      this.filter = button.dataset.filter;
+      this.shadowRoot.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+      this.updateCards(true);
+    }, { signal });
+    this.shadowRoot.querySelector('slot').addEventListener('slotchange', () => this.updateCards(), { signal });
+    this.updateCards();
+  }
+  updateCards(announce = false) {
+    let count = 0;
+    this.querySelectorAll('coffee-card').forEach(card => {
+      card.hidden = this.filter !== 'all' && card.getAttribute('category') !== this.filter;
+      if (!card.hidden) count++;
+    });
+    if (announce) this.shadowRoot.querySelector('[role="status"]').textContent = `${count} ${this.filter === 'all' ? '' : this.filter + ' '}coffee${count === 1 ? '' : 's'} shown.`;
+  }
+  disconnectedCallback() { this.controller?.abort(); }
+}
