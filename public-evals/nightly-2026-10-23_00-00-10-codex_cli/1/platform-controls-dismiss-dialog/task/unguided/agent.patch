+  <script>
+    const dialog = document.getElementById('coffee-details');
+    const title = document.getElementById('coffee-title');
+    const description = document.getElementById('coffee-description');
+    const coffees = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup. A mellow, maple-sweet latte for your seasonal coffee break.'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Enjoy the deep roasted flavor of our dark roast espresso.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. A refreshing coffee with a smooth, slow-steeped finish.'
+      }
+    };
+    // Identify this page's dialog entries without replacing other history state.
+    const historyKey = 'dailyGrindCoffeeDialog';
+    const pageId = Math.random().toString(36).slice(2);
+    let returningToPage = false;
+
+    function showCoffee(coffeeId) {
+      const coffee = coffees[coffeeId];
+      title.textContent = coffee.title;
+      description.textContent = coffee.description;
+      if (!dialog.open) dialog.showModal();
+    }
+
+    document.querySelectorAll('[data-coffee]').forEach((button) => {
+      button.addEventListener('click', () => {
+        if (returningToPage || dialog.open) return;
+        const coffeeId = button.dataset.coffee;
+        history.pushState({
+          ...history.state,
+          [historyKey]: { pageId, coffeeId }
+        }, '');
+        showCoffee(coffeeId);
+      });
+    });
+
+    // Native Escape and the Close button both remove the dialog's history entry.
+    dialog.addEventListener('close', () => {
+      if (history.state?.[historyKey]?.pageId === pageId) {
+        returningToPage = true;
+        history.back();
+      }
+    });
+
+    // Back dismisses the dialog; Forward restores the selected coffee details.
+    window.addEventListener('popstate', () => {
+      returningToPage = false;
+      const entry = history.state?.[historyKey];
+      if (entry?.pageId === pageId && Object.hasOwn(coffees, entry.coffeeId)) {
+        showCoffee(entry.coffeeId);
+      } else if (dialog.open) {
+        dialog.close();
+      }
+    });
+  </script>
+
