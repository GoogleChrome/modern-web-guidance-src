+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menu = document.getElementById('seasonal-menu');
+    const supportsHighlights = Boolean(window.CSS?.highlights && window.Highlight);
+
+    function collectCardTextNodes() {
+      const nodes = [];
+      menu.querySelectorAll('.card').forEach((card) => {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+      });
+      return nodes;
+    }
+
+    const cardTextNodes = collectCardTextNodes();
+
+    searchInput.addEventListener('input', () => {
+      if (supportsHighlights) {
+        CSS.highlights.delete('menu-search');
+      } else {
+        menu.querySelectorAll('mark.menu-match').forEach((mark) => {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        menu.normalize();
+      }
+
+      const query = searchInput.value;
+      if (!query.trim()) return;
+
+      // Escape regex syntax so every search is treated as literal text.
+      const pattern = new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
+      const ranges = [];
+      const nodes = supportsHighlights ? cardTextNodes : collectCardTextNodes();
+
+      nodes.forEach((node) => {
+        const text = node.textContent;
+        const matches = [...text.matchAll(pattern)];
+        if (!matches.length) return;
+
+        if (supportsHighlights) {
+          matches.forEach((match) => {
+            const range = document.createRange();
+            range.setStart(node, match.index);
+            range.setEnd(node, match.index + match[0].length);
+            ranges.push(range);
+          });
+        } else {
+          const fragment = document.createDocumentFragment();
+          let offset = 0;
+          matches.forEach((match) => {
+            fragment.append(text.slice(offset, match.index));
+            const mark = document.createElement('mark');
+            mark.className = 'menu-match';
+            mark.textContent = match[0];
+            fragment.append(mark);
+            offset = match.index + match[0].length;
+          });
+          fragment.append(text.slice(offset));
+          node.replaceWith(fragment);
+        }
+      });
+
+      if (supportsHighlights) {
+        CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+    });
+  </script>
+
 </body>
 
