diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..ab93155
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,223 @@
+/* Later layers win. Keep global defaults low-specificity and components local.
+   Uses native CSS nesting and @scope; no preprocessing is required. */
+@layer reset, tokens, base, layout, components;
+
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    --color-coffee: #4e342e;
+    --color-espresso: #3e2723;
+    --color-oat: #d7ccc8;
+    --color-amber: #ffab40;
+    --color-white: #fff;
+    --color-paper: #fafafa;
+
+    --color-text: var(--color-espresso);
+    --color-text-inverse: var(--color-white);
+    --color-page: var(--color-paper);
+    --color-surface: var(--color-white);
+    --color-brand: var(--color-coffee);
+    --color-action: var(--color-brand);
+    --color-action-hover: var(--color-espresso);
+    --color-highlight: var(--color-amber);
+    --color-footer: var(--color-oat);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-brand: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-body: 1.6;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.9375rem;
+    --space-4: 1rem;
+    --space-5: 1.25rem;
+    --space-6: 2.5rem;
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-interaction: 300ms;
+    --content-width: 68.75rem;
+    --page-gutter: var(--space-5);
+    --layer-sticky: 10;
+  }
+}
+
+@layer base {
+  :where(body) {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a:focus-visible) {
+    outline: 2px solid currentColor;
+    outline-offset: 4px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :root {
+      --duration-interaction: 0s;
+    }
+  }
+}
+
+@layer layout {
+  .container {
+    max-width: var(--content-width);
+    margin: var(--space-6) auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .product-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.625rem), 1fr));
+    gap: var(--space-5);
+    margin-block-start: var(--space-5);
+  }
+}
+
+@layer components {
+  /* Scope element rules to their component rather than the whole document.
+     Shared components (such as .button) remain independently reusable. */
+  @scope (.site-nav) {
+    :scope {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--layer-sticky);
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: var(--space-4) var(--space-5);
+      padding: var(--space-4) 5%;
+      color: var(--color-text-inverse);
+      background: var(--color-brand);
+    }
+
+    .site-nav__brand {
+      font-size: var(--font-size-brand);
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    .site-nav__links {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-2) var(--space-5);
+      list-style: none;
+    }
+
+    a {
+      color: var(--color-text-inverse);
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:hover {
+        color: var(--color-highlight);
+      }
+    }
+
+    .site-nav__logout {
+      border: 1px solid var(--color-highlight);
+      padding: var(--space-1) 0.75rem;
+      border-radius: var(--radius-small);
+    }
+  }
+
+  @scope (.hero) {
+    :scope {
+      --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      --hero-overlay: rgb(0 0 0 / 50%);
+
+      min-height: 60vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      padding: var(--space-6) var(--page-gutter);
+      color: var(--color-text-inverse);
+      text-align: center;
+      background: linear-gradient(var(--hero-overlay), var(--hero-overlay)), var(--hero-image) center / cover;
+    }
+
+    h1 {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-4);
+    }
+  }
+
+  .seasonal__heading {
+    text-align: center;
+  }
+
+  @scope (.product-card) {
+    :scope {
+      padding: var(--space-5);
+      border-radius: var(--radius-card);
+      background: var(--color-surface);
+      box-shadow: var(--shadow-card);
+      text-align: center;
+    }
+
+    h3 {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  .button {
+    display: inline-block;
+    margin-block-start: var(--space-3);
+    padding: var(--space-2) var(--space-5);
+    border-radius: var(--radius-button);
+    background: var(--color-action);
+    color: var(--color-text-inverse);
+    text-decoration: none;
+    transition: background-color var(--duration-interaction);
+
+    &:hover {
+      background-color: var(--color-action-hover);
+    }
+  }
+
+  @scope (.site-footer) {
+    :scope {
+      margin-block-start: var(--space-6);
+      padding: var(--space-6) var(--page-gutter);
+      background: var(--color-footer);
+      text-align: center;
+    }
+
+    .site-footer__links {
+      margin-block-end: var(--space-5);
+
+      & a {
+        margin-inline: var(--space-2);
+        color: var(--color-text);
+        text-decoration: none;
+        font-size: var(--font-size-small);
+
+        &:hover {
+          text-decoration: underline;
+        }
+      }
+    }
+  }
+}
