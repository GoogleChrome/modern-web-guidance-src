new file mode 100644
index 0000000..50a75b0
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,211 @@
+/* Later layers take precedence without increasing selector specificity. */
+@layer tokens, base, layout, components;
+
+@layer tokens {
+  :root {
+    /* Palette and scales: literal values live here. */
+    --color-brown-900: #3e2723;
+    --color-brown-800: #4e342e;
+    --color-brown-100: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-gray-50: #fafafa;
+    --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --text-small: 0.85rem;
+    --text-nav: 0.9rem;
+    --text-logo: 1.5rem;
+    --text-hero: 3rem;
+    --leading-body: 1.6;
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+
+    /* Semantic tokens: change the brand without editing components. */
+    --color-brand: var(--color-brown-800);
+    --color-accent: var(--color-amber-400);
+    --color-text: var(--color-brown-900);
+    --color-text-inverse: var(--color-white);
+    --color-page: var(--color-gray-50);
+    --color-surface: var(--color-white);
+    --color-surface-muted: var(--color-brown-100);
+    --color-action-hover: var(--color-brown-900);
+    --font-body: var(--font-sans);
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --content-max: 68.75rem;
+    --page-gutter: var(--space-6);
+    --layer-sticky: 10;
+    --duration-interaction: 0.3s;
+    --hero-overlay: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%));
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  }
+}
+
+@layer base {
+  /* Target only the elements used by this page, at zero specificity. */
+  :where(body, nav, header, main, section, footer, div, ul, li, h1, h2, h3, p, a) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  body {
+    font-family: var(--font-body);
+    line-height: var(--leading-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a:focus-visible) {
+    outline: 2px solid currentColor;
+    outline-offset: var(--space-1);
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.625rem), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  /* Component roots carry specificity; structural filters do not. */
+  .site-nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-5) var(--space-6);
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    padding-block: var(--space-5);
+    padding-inline: 5%;
+    color: var(--color-text-inverse);
+    background: var(--color-brand);
+
+    & :where(.logo) {
+      font-size: var(--text-logo);
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    & :where(ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-5) var(--space-6);
+      list-style: none;
+    }
+
+    & :where(a) {
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--text-nav);
+      transition: color var(--duration-interaction);
+
+      &:where(:hover) {
+        color: var(--color-accent);
+      }
+    }
+
+    & :where(.logout-link) {
+      border: 1px solid var(--color-accent);
+      padding-block: var(--space-1);
+      padding-inline: var(--space-3);
+      border-radius: var(--radius-small);
+    }
+  }
+
+  .hero {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-block-size: 60vh;
+    padding-inline: var(--page-gutter);
+    color: var(--color-text-inverse);
+    background-image: var(--hero-overlay), var(--hero-image);
+    background-size: cover;
+    background-position: center;
+    text-align: center;
+
+    & :where(h1) {
+      font-size: var(--text-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .section-title {
+    text-align: center;
+  }
+
+  .card {
+    padding: var(--space-6);
+    background: var(--color-surface);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  .btn {
+    /* Local tokens allow variants to customize shared button behavior. */
+    --button-background: var(--color-brand);
+    --button-background-hover: var(--color-action-hover);
+
+    display: inline-block;
+    padding-block: var(--space-2);
+    padding-inline: var(--space-6);
+    margin-block-start: var(--space-4);
+    color: var(--color-text-inverse);
+    background: var(--button-background);
+    text-decoration: none;
+    border-radius: var(--radius-button);
+    transition: background-color var(--duration-interaction);
+
+    &:where(:hover) {
+      background: var(--button-background-hover);
+    }
+  }
+
+  .site-footer {
+    padding-block: var(--space-7);
+    padding-inline: var(--page-gutter);
+    margin-block-start: var(--space-7);
+    background: var(--color-surface-muted);
+    text-align: center;
+
+    & :where(.footer-links) {
+      margin-block-end: var(--space-6);
+
+      & :where(a) {
+        display: inline-block;
+        margin-inline: var(--space-2);
+        color: inherit;
+        text-decoration: none;
+        font-size: var(--text-small);
+      }
+    }
+  }
+}
