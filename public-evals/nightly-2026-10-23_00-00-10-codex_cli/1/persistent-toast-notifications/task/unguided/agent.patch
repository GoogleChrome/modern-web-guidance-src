+  <script>
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        // Manual popovers stay open independently and never make the page inert.
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.setAttribute('role', 'status');
+        message.setAttribute('aria-atomic', 'true');
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Close notification');
+        close.textContent = '×';
+        toast.append(message, close);
+
+        // Keep toasts as the final body children: CSS counts only later siblings
+        // to calculate each offset, with no wrapper or JavaScript layout values.
+        document.body.append(toast);
+        toast.showPopover();
+        message.textContent = 'added to cart!';
+
+        let dismissed = false;
+        const dismiss = () => {
+          if (dismissed) return;
+          dismissed = true;
+          clearTimeout(expiry);
+          if (toast.contains(document.activeElement)) trigger.focus({ preventScroll: true });
+          toast.hidePopover();
+          // Leave the element in the top layer for its CSS exit transition.
+          toast.addEventListener('transitionend', (event) => {
+            if (event.target === toast && event.propertyName === 'opacity') toast.remove();
+          });
+          // Also clean up when motion is reduced or transitions are interrupted.
+          setTimeout(() => toast.remove(), 250);
+        };
+
+        const expiry = setTimeout(dismiss, 3000);
+        close.addEventListener('click', dismiss);
+      });
+    });
+  </script>
