+    /* Each toast is an independent, non-modal top-layer popover. */
+    .toast {
+      --toast-height: 64px;
+      --toast-gap: 12px;
+      position: fixed;
+      inset: auto 16px calc(16px + env(safe-area-inset-bottom) +
+        (sibling-count() - sibling-index()) * (var(--toast-height) + var(--toast-gap))) auto;
+      margin: 0;
+      width: min(320px, calc(100vw - 32px));
+      height: var(--toast-height);
+      padding: 12px 14px 12px 20px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(62 39 35 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      opacity: 0;
+      transform: translateX(24px);
+      transition: opacity 200ms ease, transform 200ms ease, bottom 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      display: grid;
+      place-items: center;
+      flex: 0 0 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font-size: 24px;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(24px);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0s;
+        transform: none;
+      }
+    }
