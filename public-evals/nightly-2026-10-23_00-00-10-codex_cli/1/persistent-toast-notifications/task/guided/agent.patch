+  <script>
+    let toastId = 0;
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.id = `toast-${++toastId}`;
+        toast.setAttribute('popover', 'manual');
+
+        const message = document.createElement('span');
+        message.setAttribute('role', 'status');
+        message.setAttribute('aria-atomic', 'true');
+
+        const closeButton = document.createElement('button');
+        closeButton.type = 'button';
+        closeButton.className = 'toast-close';
+        closeButton.setAttribute('aria-label', 'Close notification');
+        closeButton.setAttribute('popovertarget', toast.id);
+        closeButton.setAttribute('popovertargetaction', 'hide');
+        closeButton.textContent = '×';
+
+        toast.append(message, closeButton);
+        document.body.append(toast);
+        toast.showPopover();
+        message.textContent = 'added to cart!';
+
+        const timeout = setTimeout(dismiss, 3000);
+
+        async function dismiss() {
+          if (toast.hasAttribute('data-closing')) return;
+          clearTimeout(timeout);
+          toast.setAttribute('data-closing', '');
+
+          // Keep the native top layer active throughout exit, including browsers
+          // that cannot transition the display or overlay properties yet.
+          await Promise.allSettled(toast.getAnimations().map((animation) => animation.finished));
+          if (toast.contains(document.activeElement)) {
+            trigger.focus({ preventScroll: true });
+          }
+          toast.hidePopover();
+          toast.remove();
+        }
+
+        closeButton.addEventListener('click', (event) => {
+          // Delay the native hide action until the exit animation has finished.
+          event.preventDefault();
+          dismiss();
+        });
+      });
+    });
+  </script>
+
