+    .toast {
+      position: fixed;
+      inset: auto 16px 16px auto;
+      /* Toasts are the final body children; newer siblings occupy lower slots. */
+      bottom: calc(16px + (sibling-count() - sibling-index()) * 76px);
+      margin: 0;
+      width: min(320px, calc(100vw - 32px));
+      height: 64px;
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 0.2);
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      opacity: 0;
+      transform: translateX(24px);
+      transition: opacity 200ms ease, transform 200ms ease, bottom 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open:not([data-closing]) {
+        opacity: 0;
+        transform: translateX(24px);
+      }
+    }
+
+    .toast::backdrop {
