@@ -0,0 +1,52 @@
+export type LocalAddressSpace = 'local' | 'loopback';
+
+/** Call from a user action, such as a click, after explaining the connection. */
+export async function fetchLocalResource(
+  url: string | URL,
+  addressSpace: LocalAddressSpace,
+  options: Omit<RequestInit, 'mode'> = {},
+): Promise<Response> {
+  if (typeof window === 'undefined' || !window.isSecureContext) {
+    throw new Error('Local connections require a secure browser context. Open this app over HTTPS.');
+  }
+
+  const endpoint = new URL(url);
+  if (!['http:', 'https:'].includes(endpoint.protocol)) {
+    throw new Error('Local resources must use an HTTP or HTTPS URL.');
+  }
+
+  let permission: PermissionState = 'prompt';
+  try {
+    const status = await navigator.permissions.query({
+      name: `${addressSpace === 'local' ? 'local' : 'loopback'}-network` as PermissionName,
+    });
+    permission = status.state;
+  } catch {
+    // Older browsers may not recognize these permissions. Try on user action.
+  }
+
+  if (permission === 'denied') {
+    throw new Error(`Allow ${addressSpace === 'local' ? 'Local network' : 'Loopback network'} access in browser site settings, then try again.`);
+  }
+
+  const requestOptions: RequestInit & { targetAddressSpace: LocalAddressSpace } = {
+    ...options,
+    mode: 'cors',
+    targetAddressSpace: addressSpace,
+  };
+
+  let response: Response;
+  try {
+    response = await fetch(endpoint, requestOptions);
+  } catch (cause) {
+    if (options.signal?.aborted) throw cause;
+    throw new Error(
+      'Could not connect. Check that the device or local service is running, network access is allowed in browser site settings, and the service permits this app’s origin through CORS.',
+      { cause },
+    );
+  }
+  if (!response.ok) {
+    throw new Error(`Local resource returned HTTP ${response.status}.`);
+  }
+  return response;
+}
