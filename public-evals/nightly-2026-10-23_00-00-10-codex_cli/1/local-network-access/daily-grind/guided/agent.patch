diff --git a/local-network.js b/local-network.js
new file mode 100644
index 0000000..026c1bb
--- /dev/null
+++ b/local-network.js
@@ -0,0 +1,112 @@
+(() => {
+  const form = document.getElementById('network-form');
+  const space = document.getElementById('network-space');
+  const input = document.getElementById('network-url');
+  const button = document.getElementById('network-connect');
+  const permission = document.getElementById('network-permission');
+  const status = document.getElementById('network-status');
+  const result = document.getElementById('network-result');
+  const permissions = new Map();
+  const permissionName = () => `${space.value}-network`;
+
+  function showPermission() {
+    const state = permissions.get(permissionName())?.state;
+    permission.textContent = state === 'denied'
+      ? 'Access blocked. Open browser site settings, allow Local network or Loopback network access, then try again.'
+      : state === 'granted'
+        ? 'Network permission granted.'
+        : 'Click Connect to request access to this resource.';
+  }
+
+  async function checkPermission(name) {
+    if (!permissions.has(name)) {
+      try {
+        // Older browsers may not recognize the granular permission names.
+        const state = await navigator.permissions.query({ name });
+        permissions.set(name, state);
+        state.addEventListener('change', showPermission);
+      } catch {
+        // Keep the connection behind a user gesture when querying is unsupported.
+        return 'prompt';
+      }
+    }
+    showPermission();
+    return permissions.get(name).state;
+  }
+
+  space.addEventListener('change', () => {
+    input.placeholder = space.value === 'local'
+      ? 'http://device.local/status'
+      : 'http://localhost:8080/status';
+    showPermission();
+    void checkPermission(permissionName());
+  });
+
+  if (!window.isSecureContext) {
+    status.textContent = 'Open this site over HTTPS to connect to local resources.';
+    button.disabled = true;
+    return;
+  }
+
+  showPermission();
+  void checkPermission(permissionName());
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (button.disabled) return;
+    result.hidden = true;
+    result.textContent = '';
+
+    let url;
+    try {
+      url = new URL(input.value.trim());
+      if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+        throw new Error('Invalid resource URL');
+      }
+    } catch {
+      status.textContent = 'Enter a full HTTP or HTTPS URL without a username or password.';
+      return;
+    }
+
+    const targetAddressSpace = space.value;
+    button.disabled = true;
+    input.disabled = true;
+    space.disabled = true;
+    status.textContent = 'Connecting… Allow access if your browser asks.';
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 30000);
+    try {
+      const state = await checkPermission(`${targetAddressSpace}-network`);
+      if (state === 'denied') {
+        status.textContent = 'Connection blocked. Allow network access in browser site settings and try again.';
+        return;
+      }
+      const response = await fetch(url.href, {
+        method: 'GET',
+        mode: 'cors',
+        credentials: 'omit',
+        redirect: 'error',
+        referrerPolicy: 'no-referrer',
+        targetAddressSpace,
+        signal: controller.signal,
+      });
+      if (!response.ok) {
+        status.textContent = `The resource returned HTTP ${response.status}. Check the resource URL and try again.`;
+        return;
+      }
+      // Display remote content as text, never as executable HTML.
+      result.textContent = await response.text();
+      result.hidden = false;
+      status.textContent = `Connected. Resource loaded (HTTP ${response.status}).`;
+    } catch (error) {
+      status.textContent = error.name === 'AbortError'
+        ? 'Connection timed out. Check that the device or app is running and try again.'
+        : 'Could not load the resource. Check its address, that the device or app is running, and browser network permissions. The service must allow connections from this site (CORS). Your browser may require an HTTPS resource.';
+    } finally {
+      clearTimeout(timeout);
+      button.disabled = false;
+      input.disabled = false;
+      space.disabled = false;
+    }
+  });
+})();
