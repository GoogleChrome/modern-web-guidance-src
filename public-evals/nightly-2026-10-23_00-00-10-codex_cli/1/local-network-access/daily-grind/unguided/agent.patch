new file mode 100644
index 0000000..4582c9e
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,14 @@
+import statikk from 'statikk';
+import { fileURLToPath } from 'node:url';
+
+await statikk({
+  root: fileURLToPath(new URL('.', import.meta.url)),
+  port: process.env.PORT || 11222,
+  setHeaders(response) {
+    // Include the original name for browsers predating the split permissions.
+    response.setHeader(
+      'Permissions-Policy',
+      'local-network=(self), loopback-network=(self), local-network-access=(self)',
+    );
+  },
+});
