der:0;border-radius:20px;position:relative;flex-shrink:0}.toggle[aria-checked=true]{background:#8968d6}.toggle::after{content:'';position:absolute;width:12px;height:12px;top:3px;left:3px;background:white;border-radius:50%;transition:transform .2s}.toggle[aria-checked=true]::after{transform:translateX(12px)}.control-note{font-size:10px;line-height:1.7;color:#a097ac;max-width:185px;margin:9px 0 19px}.reset{border:1px solid #e7e2ed;background:#fff;padding:9px;width:100%;border-radius:6px;color:#8c809d;font-size:10px}.reset:hover{background:#f7f4fc}.lower-grid{display:grid;grid-template-columns:minmax(0,1fr) 285px;gap:22px;margin-top:22px}.theme-preview{background:#252332;color:#f5f0ff;padding:25px 29px;min-height:211px;transition:background .2s,color .2s}#independent-theme-container{font-family:Georgia,serif;font-size-adjust:0.5;isolation:isolate}.theme-head{display:flex;align-items:center;justify-content:space-between}.theme-head .preview-label{color:#afa1c5}.theme-switch{display:flex;border:1px solid #4a435b;border-radius:5px;padding:2px;gap:2px}.theme-switch button{background:none;border:0;border-radius:3px;color:#a59ab7;font-size:12px;padding:2px 7px}.theme-switch button[aria-pressed=true]{background:#514460;color:#e4d7fa}.theme-text{font-size:23px;line-height:1.75;margin:22px 0 17px;letter-spacing:-.3px}.theme-text code{color:#c5a9f5;background:#3c324e;padding:2px 5px;border-radius:4px}.theme-meta{font-family:'DM Sans',sans-serif;color:#a396b4;font-size:9px;display:flex;align-items:center;gap:7px}.theme-meta .dot{width:5px;height:5px;background:#a38bbf;border-radius:50%}.theme-preview.light{background:#f5f0fc;color:#42314f}.theme-preview.light .theme-text code{color:#7951a4;background:#e9dff7}.code-panel{padding:19px 23px 20px;border-top:1px solid #eeeaf3}.code-heading{display:flex;justify-content:space-between;align-items:center;color:#a096ae;font-size:9px;letter-spacing:1px}.copy{border:0;background:transparent;color:#a397b0;display:flex;align-items:center;gap:5px;font-size:9px;padding:0}.code-panel pre{font:10px/1.9 'IBM Plex Mono',monospace;margin:13px 0 0;color:#84798f;white-space:pre-wrap}.syntax-selector{color:#9b75bc}.syntax-value{color:#b08350}.about{padding:22px}.about-icon{width:31px;height:31px;display:grid;place-items:center;background:#f2edf9;color:#9575bc;border-radius:8px;font-family:Georgia,serif;font-size:21px;margin-bottom:17px}.about h2{font-size:13px;font-weight:600;margin:0 0 11px}.about p{font-size:11px;line-height:1.85;color:#98909f;margin:0 0 17px}.about a{font-size:10px;color:#8e6bb9;display:inline-flex;gap:8px}.about-rule{height:1px;background:#eeeaf2;margin:23px 0 17px}.browser-note{display:flex;align-items:center;gap:7px;font-size:9px;color:#a39bab}.browser-note i{height:5px;width:5px;background:#88ad94;border-radius:50%}.footer{display:flex;justify-content:space-between;align-items:center;color:#b0a8b8;font-size:9px;margin-top:27px;padding-bottom:8px}.footer span:last-child{display:flex;align-items:center;gap:6px}.footer b{font-weight:400;color:#9482ac}.empty-nav{opacity:.65;cursor:default}@media(min-width:1450px){.content{padding-top:55px}.preview-area{min-height:295px}#mixed-fonts-container{margin-top:40px}}@media(max-width:1120px){.sidebar{width:195px;padding:30px 15px}main{margin-left:195px}.content{padding:30px 25px}.topbar{padding:0 25px}.workspace-grid,.lower-grid{grid-template-columns:minmax(0,1fr) 240px}.preview-area{padding:25px 22px}#mixed-fonts-container{font-size:23px}.badge{display:none}}@media(max-width:850px){.sidebar{width:74px;padding:25px 10px}.brand{padding:0 10px}.brand-name,.workspace,.nav-item span,.sidebar-bottom,.nav-item .tag{display:none}.nav-item{padding:14px 17px}.sidebar nav{margin-top:35px}main{margin-left:74px}.workspace-grid,.lower-grid{grid-template-columns:1fr}.controls{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.controls h2{grid-column:1/-1}.controls .control-divider{display:none}.controls .toggle-block{grid-column:2;grid-row:2/4}.controls .reset{grid-column:2}.about{display:none}.intro{margin-bottom:25px}h1{font-size:28px}.lower-grid{margin-top:18px}}@media(max-width:500px){.sidebar{display:none}main{margin-left:0}.topbar{height:63px;padding:0 20px}.docs-link{display:none}.content{padding:28px 18px 18px}.breadcrumb{font-size:11px}.subtitle{font-size:12px}.preview-bottom{gap:10px;font-size:9px;padding:13px 15px}.preview-bottom code{font-size:9px}#mixed-fonts-container{font-size:23px}.controls{gap:0 17px;padding:20px}.theme-text{font-size:21px}.footer{font-size:8px}.theme-preview{padding:23px}}
+</style>
+</head>
+<body>
+<aside class="sidebar">
+<a class="brand" href="./" aria-label="Typeform home"><span class="brand-icon">tf</span><span class="brand-name">typeform<span class="brand-dot">.</span></span></a>
+<p class="workspace">WORKSPACE</p>
+<nav aria-label="Workspace"><a class="nav-item active" href="#playground"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>Playground</span></a><a class="nav-item" href="#independent-theme-container"><svg viewBox="0 0 24 24"><path d="m3 8 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 18l9 5 9-5" transform="translate(0 -2)"/></svg><span>Themes</span></a><a class="nav-item" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M4 4h7v16H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm16 0h-7v16h7a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z"/></svg><span>Field notes</span><span class="tag">↗</span></a></nav>
+<div class="sidebar-bottom"><div class="tip"><div class="tip-title"><span style="color:#9d87c3">✧</span> A little type, a lot of harmony.</div><p>Small details make a big difference. Let your fonts find their balance.</p></div><div class="sidebar-footer"><span class="online"></span> All systems in sync <span class="version">v1.0</span></div></div>
+</aside>
+<main id="playground">
+<header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>Typography playground</strong></div><div class="top-actions"><a class="docs-link" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener">Documentation <span style="margin-left:7px">↗</span></a><div class="avatar" aria-label="Personal workspace">JD</div></div></header>
+<div class="content">
+<section class="intro"><div><p class="eyebrow">THE TYPOGRAPHY PLAYGROUND</p><h1>Different fonts. Same rhythm.</h1><p class="subtitle">Bring mixed type into harmony with a little modern CSS.</p></div><div class="badge"><span>✧</span> Powered by font-size-adjust</div></section>
+<div class="workspace-grid">
+<section class="card" aria-label="Mixed font preview"><div class="card-top"><div class="section-title"><span class="small-icon">Aa</span> Mixed fonts</div><span class="pill">AUTO NORMALIZED</span></div><div class="preview-area"><div class="preview-label">THE LIVE PREVIEW <span class="live-label"><i></i> Live</span></div><p id="mixed-fonts-container">Good design speaks a common language.<br>Even when <code>const ideas = [];</code> look a little different, everything should feel in&nbsp;balance.</p><div class="preview-meta"><span><i class="swatch"></i><span id="font-name">DM Sans</span> · Regular</span><span><i class="swatch purple"></i>IBM Plex Mono · Code</span></div></div><div class="preview-bottom"><span><span class="check">✓</span><span id="normalization-status">Matching x-heights, automatically.</span></span><code id="adjust-value">font-size-adjust: from-font;</code></div></section>
+<aside class="card controls" aria-label="Preview settings"><h2>Make it your own</h2><div><label class="field-label" for="font-family">Body font</label><select id="font-family"><option value="'DM Sans', sans-serif">DM Sans</option><option value="Georgia, serif">Georgia</option><option value="Arial, sans-serif">Arial</option><option value="Verdana, sans-serif">Verdana</option></select></div><div><label class="field-label" for="font-size">Font size <output id="size-output" for="font-size">26 px</output></label><input id="font-size" type="range" min="18" max="36" value="26"><div class="range-labels"><span>18 px</span><span>36 px</span></div></div><hr class="control-divider"><div class="toggle-block"><div class="toggle-row"><span class="toggle-title">Normalize font heights</span><button class="toggle" id="normalize" role="switch" aria-checked="true" aria-label="Normalize font heights"></button></div><p class="control-note">One consistent x-height.<br>Every font, in sync.</p></div><button class="reset" id="reset">↺ &nbsp; Reset to defaults</button></aside>
+</div>
+<div class="lower-grid">
+<section class="card" aria-label="Independent theme preview"><div class="card-top"><div class="section-title"><span class="small-icon">◐</span> Independent theme</div><span class="pill">ISOLATED</span></div><div id="independent-theme-container" class="theme-preview"><div class="theme-head"><span class="preview-label" style="font-family:'DM Sans',sans-serif">A WORLD OF ITS OWN</span><div class="theme-switch" aria-label="Theme appearance"><button data-theme="light" aria-label="Light theme" aria-pressed="false">☼</button><button data-theme="dark" aria-label="Dark theme" aria-pressed="true">☾</button></div></div><p class="theme-text">A different mood. The same precision.<br>Where <code>creativity</code> has its own rules.</p><div class="theme-meta"><span class="dot"></span> Fixed x-height ratio <span style="opacity:.4">/</span> 0.5 <span style="opacity:.4">/</span> Independent of the parent</div></div><div class="code-panel"><div class="code-heading">UNDER THE HOOD <button class="copy" id="copy" aria-label="Copy independent theme CSS">▢ &nbsp; Copy CSS</button></div><pre><span class="syntax-selector">#independent-theme-container</span> {
+  font-size-adjust: <span class="syntax-value">0.5</span>;
+}</pre></div></section>
+<aside class="card about"><div class="about-icon">x</div><h2>It's all in the x-height.</h2><p>Fonts can share a size without looking the same size. Their lowercase letters tell a different story.</p><p><code style="font-size:10px;color:#8e74ac">font-size-adjust</code> brings them into balance, preserving visual rhythm across font families.</p><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener">Explore the CSS property <span>↗</span></a><div class="about-rule"></div><div class="browser-note"><i></i> Built for modern browsers</div></aside>
+</div>
+<footer class="footer"><span>A small playground for better typography.</span><span>Made with care <b>✧</b> Set in harmony.</span></footer>
+</div>
+</main>
+<script>
+const preview = document.getElementById('mixed-fonts-container');
+const family = document.getElementById('font-family');
+const size = document.getElementById('font-size');
+const normalize = document.getElementById('normalize');
+const update = () => {
+ const enabled = normalize.getAttribute('aria-checked') === 'true';
+ preview.style.fontFamily = family.value;
+ preview.style.fontSize = `${size.value}px`;
+ preview.style.fontSizeAdjust = enabled ? 'from-font' : 'none';
+ document.getElementById('size-output').value = `${size.value} px`;
+ document.getElementById('font-name').textContent = family.options[family.selectedIndex].text;
+ document.getElementById('adjust-value').textContent = `font-size-adjust: ${enabled ? 'from-font' : 'none'};`;
+ document.getElementById('normalization-status').textContent = enabled ? 'Matching x-heights, automatically.' : 'Original font proportions.';
+ document.querySelector('.workspace-grid .pill').textContent = enabled ? 'AUTO NORMALIZED' : 'ORIGINAL HEIGHTS';
+};
+family.addEventListener('change', update);
+size.addEventListener('input', update);
+normalize.addEventListener('click', () => { normalize.setAttribute('aria-checked', normalize.getAttribute('aria-checked') !== 'true'); update(); });
+document.getElementById('reset').addEventListener('click', () => { family.selectedIndex = 0; size.value = 26; normalize.setAttribute('aria-checked', 'true'); update(); });
+document.querySelectorAll('[data-theme]').forEach(button => button.addEventListener('click', () => {
+ document.getElementById('independent-theme-container').classList.toggle('light', button.dataset.theme === 'light');
+ document.querySelectorAll('[data-theme]').forEach(item => item.setAttribute('aria-pressed', item === button));
+}));
+document.getElementById('copy').addEventListener('click', async (event) => {
+ const button = event.currentTarget;
+ try {
+  await navigator.clipboard.writeText('#independent-theme-container {\n  font-size-adjust: 0.5;\n}');
+  button.textContent = '✓ Copied';
+ } catch { button.textContent = 'Copy unavailable'; }
+ setTimeout(() => { button.textContent = '▢  Copy CSS'; }, 2000);
+});
+</script>
+</body>
+</html>
