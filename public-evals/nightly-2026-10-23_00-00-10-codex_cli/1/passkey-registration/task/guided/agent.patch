+  <script src="./assets/webauthn-polyfills.js"></script>
+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('registration-status');
+      let available = false;
+      let pending = false;
+      let registered = false;
+
+      async function checkAvailability() {
+        try {
+          if (!window.isSecureContext || !window.PublicKeyCredential ||
+              typeof navigator.credentials?.create !== 'function' ||
+              typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+            throw new Error('Passkeys unavailable');
+          }
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          available = Boolean(capabilities.conditionalGet && capabilities.passkeyPlatformAuthenticator);
+          status.textContent = available
+            ? 'Ready to create a passkey.'
+            : 'Passkey creation is unavailable on this device or browser.';
+        } catch {
+          status.textContent = 'Passkey creation requires a supported browser and a secure connection.';
+        }
+        button.disabled = !available;
+      }
+
+      async function postJSON(url, body) {
+        const response = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          mode: 'same-origin',
+          cache: 'no-store',
+          redirect: 'error',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body),
+        });
+        if (!response.ok) throw new Error('Registration request failed');
+        return response.json();
+      }
+
+      async function signalFailedRegistration(publicKey, credential) {
+        if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id || window.location.hostname,
+            credentialId: credential.id,
+          });
+        } catch {
+          // Password manager synchronization is optional; preserve the registration error.
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        if (!available || pending || registered) return;
+        pending = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        status.textContent = 'Follow your device’s instructions to create a passkey.';
+
+        try {
+          const options = await postJSON('/api/register/options', { promotion: true });
+          const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential) throw new DOMException('No credential created', 'NotAllowedError');
+          const encodedResponse = credential.toJSON();
+
+          // Only failed server verification signals an orphaned credential, never a cancelled prompt.
+          try {
+            const result = await postJSON('/api/register/verify', encodedResponse);
+            if (result?.verified !== true) throw new Error('Registration was not verified');
+          } catch (error) {
+            await signalFailedRegistration(publicKey, encodedResponse);
+            throw error;
+          }
+
+          registered = true;
+          status.textContent = 'Your passkey was created successfully.';
+        } catch (error) {
+          const messages = {
+            InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+            NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+            AbortError: 'Passkey creation was interrupted. You can try again.',
+            SecurityError: 'Passkey creation is unavailable because of a secure connection or domain configuration issue.',
+          };
+          status.textContent = messages[error?.name] || 'We could not register your passkey. Please try again.';
+        } finally {
+          pending = false;
+          button.disabled = !available || registered;
+          button.removeAttribute('aria-busy');
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
 </body>
 
