+    .target {
+      display: grid;
+      place-items: center;
+      width: 100px;
+      height: 100px;
+      margin: 24px auto 32px;
+      padding: 12px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      font-size: 0.85rem;
+      font-weight: bold;
+      line-height: 1.3;
+      text-align: center;
+      /* Keep a stacking context before, during, and after hover. */
+      isolation: isolate;
+      scale: 1;
+      transition: scale 0.3s ease;
+      /* Independent transform properties let both animations and hover compose. */
+      animation: promo-spin 8s linear infinite,
+        promo-slide 2.5s ease-in-out infinite alternate;
+    }
+
+    .target:hover {
+      scale: 1.15;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -24px 0; }
+      to { translate: 24px 0; }
+    }
