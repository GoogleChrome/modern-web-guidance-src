+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const cardNumber = document.getElementById('card-number');
+    const cardExpiry = document.getElementById('card-expiry');
+
+    cardNumber.addEventListener('input', () => {
+      const digits = cardNumber.value.replace(/[ -]/g, '');
+      cardNumber.setCustomValidity(/^\d{12,19}$/.test(digits) ? '' : 'Enter a card number with 12 to 19 digits.');
+    });
+
+    cardExpiry.addEventListener('input', () => {
+      cardExpiry.setCustomValidity('');
+      if (/^(0[1-9]|1[0-2])\/\d{2}$/.test(cardExpiry.value)) {
+        const [month, year] = cardExpiry.value.split('/').map(Number);
+        const now = new Date();
+        if (new Date(2000 + year, month) <= now) {
+          cardExpiry.setCustomValidity('Enter an expiry date that has not passed.');
+        }
+      }
+    });
+
+    paymentForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      document.getElementById('payment-status').textContent =
+        'Payment details checked. No payment has been processed; checkout is not connected yet.';
+    });
+  </script>
