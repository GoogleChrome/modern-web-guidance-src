+  <script>
+    // Preserve the branded picker in browsers without customizable selects.
+    if (!CSS.supports('appearance', 'base-select') ||
+        !CSS.supports('selector(select::picker(select))')) {
+      const select = document.querySelector('#coffee-roast');
+      const container = select.parentElement;
+      const label = document.querySelector('#roast-label');
+      const trigger = document.createElement('button');
+      const list = document.createElement('ul');
+      const options = Array.from(select.options);
+      let active = select.selectedIndex;
+      let search = '';
+      let searchTimer;
+
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('role', 'combobox');
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      const arrow = document.createElement('span');
+      arrow.textContent = '⌄';
+      arrow.setAttribute('aria-hidden', 'true');
+      trigger.append(value, arrow);
+      list.id = 'roast-options';
+      list.className = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-labelledby', 'roast-label');
+      list.hidden = true;
+
+      const items = options.map((option, index) => {
+        const item = document.createElement('li');
+        item.id = `roast-option-${index}`;
+        item.setAttribute('role', 'option');
+        item.textContent = option.textContent;
+        item.addEventListener('click', () => choose(index));
+        list.append(item);
+        return item;
+      });
+
+      function render() {
+        value.textContent = options[select.selectedIndex].textContent;
+        items.forEach((item, index) => {
+          item.setAttribute('aria-selected', String(index === select.selectedIndex));
+          item.toggleAttribute('data-active', index === active);
+        });
+        if (!list.hidden) trigger.setAttribute('aria-activedescendant', items[active].id);
+      }
+
+      function setOpen(open) {
+        list.hidden = !open;
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) active = select.selectedIndex;
+        else trigger.removeAttribute('aria-activedescendant');
+        render();
+      }
+
+      function choose(index) {
+        select.selectedIndex = index;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        setOpen(false);
+        trigger.focus();
+      }
+
+      trigger.addEventListener('click', () => setOpen(list.hidden));
+      trigger.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' || event.key === 'Tab') {
+          setOpen(false);
+          return;
+        }
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          if (list.hidden) setOpen(true);
+          else if (event.key === 'ArrowDown') active = (active + 1) % items.length;
+          else if (event.key === 'ArrowUp') active = (active + items.length - 1) % items.length;
+          if (event.key === 'Home') active = 0;
+          if (event.key === 'End') active = items.length - 1;
+          render();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          if (list.hidden) setOpen(true);
+          else choose(active);
+        } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          event.preventDefault();
+          if (list.hidden) setOpen(true);
+          clearTimeout(searchTimer);
+          search += event.key.toLowerCase();
+          const match = options.findIndex(option => option.text.toLowerCase().startsWith(search));
+          if (match !== -1) active = match;
+          render();
+          searchTimer = setTimeout(() => { search = ''; }, 500);
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!container.contains(event.target)) setOpen(false);
+      });
+      container.addEventListener('focusout', (event) => {
+        if (!container.contains(event.relatedTarget)) setOpen(false);
+      });
+      select.addEventListener('change', render);
+      select.hidden = true;
+      label.htmlFor = trigger.id;
+      container.append(trigger, list);
+      render();
+    }
+  </script>
