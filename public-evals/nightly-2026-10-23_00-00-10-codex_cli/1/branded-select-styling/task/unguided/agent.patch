+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = [...list.querySelectorAll('[role="option"]')];
+    const value = document.getElementById('roast-value');
+    const input = document.getElementById('roast-input');
+
+    function closeRoasts(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    trigger.addEventListener('click', () => {
+      if (list.hidden) openRoasts();
+      else closeRoasts();
+    });
+
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach(option => option.addEventListener('click', () => {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      value.textContent = option.textContent.trim();
+      input.value = option.dataset.value;
+      closeRoasts(true);
+    }));
+
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let nextIndex;
+      if (event.key === 'ArrowDown') nextIndex = (index + 1) % options.length;
+      else if (event.key === 'ArrowUp') nextIndex = (index - 1 + options.length) % options.length;
+      else if (event.key === 'Home') nextIndex = 0;
+      else if (event.key === 'End') nextIndex = options.length - 1;
+      else if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        options[index]?.click();
+      } else if (/^[a-z]$/i.test(event.key)) {
+        nextIndex = options.findIndex(option => option.dataset.value.startsWith(event.key.toLowerCase()));
+      }
+      if (nextIndex !== undefined && nextIndex >= 0) {
+        event.preventDefault();
+        options[nextIndex].focus();
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
