+# The Daily Grind
+
+A static, server-delivered coffee shop page. No build step is required.
+
+The seasonal `<coffee-card>` elements are prerendered in `index.html`. Each
+contains a Declarative Shadow DOM template with its own styles, so supporting
+browsers display the complete, styled card before JavaScript loads. Native
+`<details>` keeps the coffee descriptions usable with JavaScript disabled.
+
+The deferred module `coffee-card.js` registers the custom element after parsing.
+It reuses each existing shadow root and attaches a favorite-button listener
+once, including across disconnection and reconnection. It does not replace or
+recreate the server-rendered tree. Favorite selections last for the current page
+session. In browsers without Declarative Shadow DOM, it attaches the existing
+template's content as a fallback; those browsers require JavaScript to show the
+cards and cannot guarantee a styled first paint before it loads.
+
+Favorite buttons remain disabled until their listener is attached. Component
+styles are inline in the declarative templates rather than loaded by JavaScript.
diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..fbd5169
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,57 @@
+/** Upgrade the HTML already delivered by the server; never render a second tree. */
+class CoffeeCard extends HTMLElement {
+  #initialized = false;
+
+  connectedCallback() {
+    if (this.#initialized) return;
+
+    // Older parsers leave the declarative template inert. Reuse its exact nodes
+    // only when the browser has not already attached the server's shadow root.
+    if (!this.shadowRoot) {
+      const template = this.querySelector('template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open' }).append(template.content);
+      template.remove();
+    }
+
+    const button = this.shadowRoot.querySelector('button');
+    const name = this.shadowRoot.getElementById('name')?.textContent;
+    const label = this.shadowRoot.querySelector('.save-label');
+    if (!button || !name || !label) return;
+
+    // The native <details> works even before upgrade or without JavaScript.
+    // Only the favorite interaction needs hydration. Reconnection must not
+    // register this listener a second time or reset the user's selection.
+    button.addEventListener('click', () => {
+      const selected = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(selected));
+      button.setAttribute('aria-label', `${selected ? 'Remove' : 'Save'} ${name} ${selected ? 'from' : 'to'} favorites`);
+      label.textContent = selected ? 'Saved coffee' : 'Save coffee';
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { name, selected },
+      }));
+    });
+    button.disabled = false;
+    this.#initialized = true;
+  }
+}
+
+// Modules run after document parsing, so all declarative roots are available.
+// The status listener is ready before any cards are upgraded.
+const favorites = new Set();
+document.querySelector('main')?.addEventListener('favorite-change', (event) => {
+  const { name, selected } = event.detail;
+  selected ? favorites.add(name) : favorites.delete(name);
+  const status = document.getElementById('favorites-status');
+  if (status) {
+    status.textContent = favorites.size
+      ? `${favorites.size} ${favorites.size === 1 ? 'coffee' : 'coffees'} in your favorites`
+      : 'No coffees in your favorites';
+  }
+});
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
