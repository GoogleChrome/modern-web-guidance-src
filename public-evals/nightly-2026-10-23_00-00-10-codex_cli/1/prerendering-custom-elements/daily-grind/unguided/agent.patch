+// The document already contains the component's complete, styled markup.
+// Upgrading only attaches behavior; it never creates or replaces DOM nodes.
+class CoffeeCard extends HTMLElement {
+  connectedCallback() {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    this.quantity = Number(this.getAttribute('quantity')) || 1;
+    this.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-action]')?.dataset.action;
+      if (action === 'increase') this.setQuantity(this.quantity + 1);
+      if (action === 'decrease') this.setQuantity(this.quantity - 1);
+      if (action === 'add') {
+        this.querySelector('[data-feedback]').textContent = `${this.quantity} ${this.quantity === 1 ? 'bag' : 'bags'} of Morning Ritual added to your bag.`;
+        const button = this.querySelector('[data-action="add"]');
+        button.querySelector('[data-add-label]').textContent = ` ${this.quantity} ${this.quantity === 1 ? 'bag' : 'bags'} added `;
+        clearTimeout(this.feedbackTimer);
+        this.feedbackTimer = setTimeout(() => { button.querySelector('[data-add-label]').textContent = ' Add to bag '; }, 2500);
+      }
+    });
+    this.dataset.hydrated = 'true';
+    document.querySelector('#hydration-state').textContent = 'Hydrated in place';
+  }
+  setQuantity(value) {
+    this.quantity = Math.max(1, Math.min(99, value));
+    this.setAttribute('quantity', String(this.quantity));
+    this.querySelector('[data-quantity]').textContent = this.quantity;
+    this.querySelector('[data-action="decrease"]').disabled = this.quantity === 1;
+    this.querySelector('[data-action="increase"]').disabled = this.quantity === 99;
+  }
+}
+customElements.define('coffee-card', CoffeeCard);
+
+const snippets = {
+  server: { file: 'index.html', label: 'SERVER-RENDERED', code: `<!-- Ready before JavaScript arrives. -->
+<link rel="stylesheet" href="styles.css" />
+
+<coffee-card quantity="1">
+  <div class="product-photo">
+    <img src="coffee.jpg" alt="Fresh coffee" />
+  </div>
+
+  <div class="product-content">
+    <h2>Morning Ritual</h2>
+    <p>A little slower. A little richer.</p>
+
+    <div class="quantity-control">
+      <button data-action="decrease">−</button>
+      <output data-quantity>1</output>
+      <button data-action="increase">+</button>
+    </div>
+
+    <button data-action="add">Add to bag</button>
+  </div>
+</coffee-card>
+
+<script type="module" src="app.js"></script>` },
+  client: { file: 'app.js', label: 'IN-PLACE HYDRATION', code: `// Upgrade the element. Keep the markup.
+class CoffeeCard extends HTMLElement {
+  connectedCallback() {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    this.quantity = 1;
+
+    this.addEventListener('click', (event) => {
+      const action = event.target.closest(
+        'button[data-action]'
+      )?.dataset.action;
+
+      if (action === 'increase') {
+        this.quantity += 1;
+        this.querySelector('[data-quantity]')
+          .textContent = this.quantity;
+      }
+    });
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+// No innerHTML. No DOM replacement.` },
+  styles: { file: 'styles.css', label: 'FIRST-PAINT STYLES', code: `/* Loaded with the initial document. */
+coffee-card {
+  display: block;
+  width: 338px;
+  max-width: 100%;
+  background: #fff;
+  border: 1px solid #e1e3da;
+  border-radius: 9px;
+  overflow: hidden;
+}
+
+coffee-card .product-photo {
+  height: 182px;
+  background: #7b6046;
+}
+
+coffee-card .add-button {
+  background: #3c5d40;
+  color: #fff;
+  border-radius: 4px;
+}
+
+/* Styled before the element is defined. */` }
+};
+let currentTab = 'server';
+const codeContent = document.querySelector('#code-content');
+function renderCode(tab) {
+  currentTab = tab;
+  const snippet = snippets[tab];
+  document.querySelector('#filename').textContent = snippet.file;
+  document.querySelector('.file-label').textContent = snippet.label;
+  codeContent.replaceChildren(...snippet.code.split('\n').map((line, index) => {
+    const row = document.createElement('span');
+    row.className = 'line';
+    const number = document.createElement('span');
+    number.className = 'line-number';
+    number.textContent = index + 1;
+    number.setAttribute('aria-hidden', 'true');
+    row.append(number);
+    const pattern = /(<!--[\s\S]*?-->|\/\/.*|\/\*.*?\*\/)|("[^"]*"|'[^']*')|(<\/?[\w-]+|\/?>)|\b(class|extends|const|if|return|true|this|new)\b|(\b[\w-]+)(?==)/g;
+    let cursor = 0;
+    for (const match of line.matchAll(pattern)) {
+      row.append(document.createTextNode(line.slice(cursor, match.index)));
+      const token = document.createElement('span');
+      token.className = match[1] ? 'comment' : match[2] ? 'string' : match[3] ? 'tag' : match[4] ? 'keyword' : 'attr';
+      token.textContent = match[0];
+      row.append(token);
+      cursor = match.index + match[0].length;
+    }
+    row.append(document.createTextNode(line.slice(cursor)));
+    return row;
+  }));
+  document.querySelectorAll('[data-tab]').forEach(button => {
+    const active = button.dataset.tab === tab;
+    button.classList.toggle('active', active);
+    button.setAttribute('aria-selected', String(active));
+    button.tabIndex = active ? 0 : -1;
+  });
+}
+document.querySelectorAll('[data-tab]').forEach(button => {
+  button.addEventListener('click', () => renderCode(button.dataset.tab));
+  button.addEventListener('keydown', event => {
+    const tabs = Object.keys(snippets);
+    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+      event.preventDefault();
+      const next = (tabs.indexOf(currentTab) + (event.key === 'ArrowRight' ? 1 : 2)) % 3;
+      renderCode(tabs[next]);
+      document.querySelector(`[data-tab="${tabs[next]}"]`).focus();
+    }
+  });
+});
+renderCode('server');
+document.querySelector('#copy').addEventListener('click', async event => {
+  const button = event.currentTarget;
+  try {
+    await navigator.clipboard.writeText(snippets[currentTab].code);
+    button.textContent = '✓';
+    button.setAttribute('aria-label', 'Code copied');
+    setTimeout(() => { button.textContent = '▢'; button.setAttribute('aria-label', 'Copy code'); }, 1800);
+  } catch {
+    const range = document.createRange();
+    range.selectNodeContents(codeContent);
+    window.getSelection().removeAllRanges();
+    window.getSelection().addRange(range);
+    button.setAttribute('aria-label', 'Code selected. Press Control or Command C to copy.');
+  }
+});
+document.querySelectorAll('[data-width]').forEach(button => button.addEventListener('click', () => {
+  document.querySelector('#preview-stage').classList.toggle('mobile', button.dataset.width === 'mobile');
+  document.querySelectorAll('[data-width]').forEach(control => {
+    control.classList.toggle('selected', control === button);
+    control.setAttribute('aria-pressed', String(control === button));
+  });
+}));
+document.querySelector('#reset').addEventListener('click', () => {
+  const card = document.querySelector('coffee-card');
+  card.setQuantity(1);
+  clearTimeout(card.feedbackTimer);
+  card.querySelector('[data-add-label]').textContent = ' Add to bag ';
+  card.querySelector('[data-feedback]').textContent = 'Demo reset. Quantity is one.';
+  renderCode('server');
+  document.querySelector('[data-width="desktop"]').click();
+});
+document.querySelector('a[href="#examples"]').addEventListener('click', () => {
+  document.querySelector('#examples').hidden = false;
+});
+document.querySelectorAll('[data-example]').forEach(button => button.addEventListener('click', () => {
+  document.querySelector('coffee-card').setQuantity(Number(button.dataset.example));
+  document.querySelector('#playground').scrollIntoView({ behavior: 'smooth' });
+}));
