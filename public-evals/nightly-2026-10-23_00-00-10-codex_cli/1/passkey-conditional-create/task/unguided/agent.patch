+  <script>
+    const signinForm = document.getElementById('signin-form');
+    const signinButton = signinForm.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.getElementById('signin-status');
+
+    async function postJSON(url, body) {
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+      if (!response.ok) throw new Error('Request failed');
+      const result = response.status === 204 ? {} : await response.json();
+      if (result.success === false || result.verified === false || result.error) {
+        throw new Error('Request rejected');
+      }
+      return result;
+    }
+
+    function decodeBase64URL(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+      return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+    }
+
+    function encodeBase64URL(value) {
+      const bytes = new Uint8Array(value);
+      let binary = '';
+      for (const byte of bytes) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseCreationOptions(options) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      }
+      return {
+        ...options,
+        challenge: decodeBase64URL(options.challenge),
+        user: { ...options.user, id: decodeBase64URL(options.user.id) },
+        ...(options.excludeCredentials && {
+          excludeCredentials: options.excludeCredentials.map(credential => ({
+            ...credential,
+            id: decodeBase64URL(credential.id),
+          })),
+        }),
+      };
+    }
+
+    function serializeRegistration(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      return {
+        id: credential.id,
+        rawId: encodeBase64URL(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        response: {
+          clientDataJSON: encodeBase64URL(credential.response.clientDataJSON),
+          attestationObject: encodeBase64URL(credential.response.attestationObject),
+          transports: credential.response.getTransports?.() || [],
+        },
+        clientExtensionResults: credential.getClientExtensionResults(),
+      };
+    }
+
+    async function promotePasskey() {
+      try {
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // The authenticated session identifies the existing user on the server.
+        const options = await postJSON('/api/register/options', {});
+        const credential = await navigator.credentials.create({
+          publicKey: parseCreationOptions(options.publicKey ?? options),
+          mediation: 'conditional',
+        });
+        if (!credential) return;
+        await postJSON('/api/register/verify', serializeRegistration(credential));
+      } catch {
+        // Promotion is best effort. Never fall back to an interactive ceremony.
+      }
+    }
+
+    signinForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (signinButton.disabled || !signinForm.reportValidity()) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+      try {
+        await postJSON('/api/login', {
+          username: signinForm.elements.username.value,
+          password: signinForm.elements.password.value,
+        });
+        signinForm.reset();
+        signinForm.hidden = true;
+        signinStatus.textContent = 'You’re signed in.';
+        void promotePasskey();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Please check your details and try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
