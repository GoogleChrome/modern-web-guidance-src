+  <script>
+    const signinForm = document.querySelector('#signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.querySelector('#signin-status');
+
+    async function promotePasskey() {
+      // Optional enhancement: no modal fallback and no passkey error UI.
+      try {
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // Older clients without JSON helpers simply retain password sign-in.
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+            typeof PublicKeyCredential.prototype.toJSON !== 'function') return;
+
+        // The server derives the user from the authenticated session and includes
+        // existing credential IDs in excludeCredentials to prevent duplicates.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const optionsJSON = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const encodedCredential = credential.toJSON();
+        // Only conditional registration verification may relax user presence;
+        // the server must still validate the challenge, origin, RP ID and session.
+        const verification = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ ...encodedCredential, conditional: true })
+        });
+        if (!verification.ok && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id || window.location.hostname,
+            credentialId: encodedCredential.id
+          });
+        }
+      } catch {
+        // Unsupported capabilities, cancellations and service failures are silent.
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+
+      try {
+        // Contract: a successful response establishes a full password session,
+        // including any required second factor. Incomplete sign-ins must not be 2xx.
+        const response = await fetch(signinForm.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+
+        signinForm.elements.password.value = '';
+        signinForm.hidden = true;
+        signinStatus.textContent = 'You are signed in.';
+        // Do not wait for passkey creation or delay the signed-in experience.
+        void promotePasskey();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Please check your details and try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
