+  <script>
+    (() => {
+      const definitions = {
+        checkout: { label: 'Checkout', priority: 0, steps: 40 },
+        menu: { label: 'Menu update', priority: 1, steps: 75 },
+        telemetry: { label: 'Telemetry logging', priority: 2, steps: 110 }
+      };
+      const queue = [];
+      let nextId = 0;
+      let completed = 0;
+      let active = null;
+      let scheduled = false;
+      const el = id => document.getElementById(id);
+      const log = el('activity-log');
+
+      function record(message, completion = false) {
+        const item = document.createElement('li');
+        const time = document.createElement('time');
+        const now = new Date();
+        time.dateTime = now.toISOString();
+        time.textContent = now.toLocaleTimeString([], { hour12: false });
+        item.append(time, document.createTextNode(message));
+        if (completion) item.className = 'completion';
+        log.prepend(item);
+        while (log.children.length > 40) log.lastElementChild.remove();
+      }
+
+      function render() {
+        el('pending-count').textContent = queue.length - (active ? 1 : 0);
+        el('completed-count').textContent = completed;
+        el('active-count').textContent = active ? 1 : 0;
+        el('queue-status').textContent = queue.length ? 'Processing operations' : completed ? 'All operations complete' : 'Ready when you are';
+        const percent = active ? Math.floor(active.done / active.steps * 100) : completed ? 100 : 0;
+        el('current-name').textContent = active ? `${active.label} #${active.id}` : completed ? 'All caught up' : 'Waiting for an operation';
+        el('current-percent').textContent = `${percent}%`;
+        el('task-progress').value = percent;
+      }
+
+      function schedule() {
+        if (scheduled || !queue.length) return;
+        scheduled = true;
+        // Return control to the browser between slices so input and painting stay responsive.
+        setTimeout(runSlice, 16);
+      }
+
+      function runSlice() {
+        scheduled = false;
+        // Reconsider priority each slice, including when urgent work arrives mid-task.
+        queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+        const task = queue[0];
+        if (!task) return;
+        if (active !== task) {
+          if (active) record(`Paused ${active.label.toLowerCase()} #${active.id}`);
+          record(`${task.done ? 'Resumed' : 'Started'} ${task.label.toLowerCase()} #${task.id}`);
+          active = task;
+        }
+        // Simulate CPU work with a small time budget; no single long blocking loop.
+        const deadline = performance.now() + 2;
+        while (performance.now() < deadline) Math.sqrt(Math.random() * 10000);
+        task.done++;
+        if (task.done === task.steps) {
+          queue.shift();
+          completed++;
+          record(`Completed ${task.label.toLowerCase()} #${task.id}`, true);
+          active = null;
+        }
+        render();
+        schedule();
+      }
+
+      function enqueue(types) {
+        types.forEach(type => {
+          const task = { ...definitions[type], id: ++nextId, done: 0 };
+          queue.push(task);
+          record(`Queued ${task.label.toLowerCase()} #${task.id}`);
+        });
+        render();
+        schedule();
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      el('run-batch').addEventListener('click', () => {
+        // Deliberately enqueue mixed priorities; the scheduler chooses execution order.
+        enqueue(['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu']);
+      });
+    })();
+  </script>
+
