+  <script>
+    (() => {
+      const form = document.getElementById('sign-in-form');
+      const username = document.getElementById('username');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      const status = document.querySelector('[data-testid="auth-status"]');
+      let activeRequest = null;
+      let explicitSignIn = false;
+      let verifying = false;
+      let authenticated = false;
+
+      function decodeBase64url(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+        return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+      }
+
+      function encodeBase64url(value) {
+        return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        const response = credential.response;
+        return {
+          id: credential.id,
+          rawId: encodeBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encodeBase64url(response.clientDataJSON),
+            authenticatorData: encodeBase64url(response.authenticatorData),
+            signature: encodeBase64url(response.signature),
+            userHandle: response.userHandle === null ? null : encodeBase64url(response.userHandle)
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+      }
+
+      async function authenticate(conditional, controller) {
+        // The server must issue a fresh challenge bound to this session and return
+        // JSON WebAuthn request options (base64url challenge and credential IDs).
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal: controller.signal
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const json = options.publicKey || options;
+        const publicKey = {
+          ...json,
+          challenge: decodeBase64url(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map(credential => ({
+            ...credential,
+            id: decodeBase64url(credential.id)
+          })),
+          userVerification: 'required'
+        };
+        // Discoverable credentials let the browser offer every registered account.
+        if (conditional) publicKey.allowCredentials = [];
+        if (controller.signal.aborted) return;
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal: controller.signal
+        });
+        if (!credential || controller.signal.aborted) return;
+        verifying = true;
+        button.disabled = true;
+        status.textContent = 'Verifying your passkey…';
+        const verification = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(serializeCredential(credential)),
+          signal: controller.signal
+        });
+        if (!verification.ok) throw new Error('Passkey verification failed. Please try again.');
+        // Accept an empty success response as well as JSON verification results.
+        const body = await verification.text();
+        const result = body ? JSON.parse(body) : {};
+        if (result.verified === false || result.success === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        authenticated = true;
+        status.textContent = 'Successfully signed in with your passkey.';
+      }
+
+      async function startAutofill() {
+        if (authenticated || explicitSignIn || verifying || activeRequest) return;
+        if (typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+        try {
+          if (!await PublicKeyCredential.isConditionalMediationAvailable()) return;
+          // A button click may have started sign-in while capability detection ran.
+          if (authenticated || explicitSignIn || verifying || activeRequest) return;
+          const controller = new AbortController();
+          activeRequest = controller;
+          try {
+            await authenticate(true, controller);
+          } catch (error) {
+            if (!controller.signal.aborted && verifying) status.textContent = error.message;
+          } finally {
+            if (activeRequest === controller) {
+              activeRequest = null;
+              verifying = false;
+              button.disabled = authenticated;
+            }
+          }
+        } catch {
+          // Browsers without conditional UI can still use the explicit button.
+        }
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (authenticated || explicitSignIn || verifying) return;
+        explicitSignIn = true;
+        button.disabled = true;
+        if (activeRequest) activeRequest.abort();
+        const controller = new AbortController();
+        activeRequest = controller;
+        status.textContent = 'Use your device to sign in with a passkey.';
+        try {
+          await authenticate(false, controller);
+        } catch (error) {
+          status.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+            ? 'Passkey sign-in was canceled or timed out. Please try again.'
+            : error.message;
+        } finally {
+          activeRequest = null;
+          verifying = false;
+          explicitSignIn = false;
+          button.disabled = authenticated;
+          if (!authenticated) void startAutofill();
+        }
+      });
+
+      if (!window.PublicKeyCredential || !navigator.credentials || !window.isSecureContext) {
+        button.disabled = true;
+        status.textContent = 'Passkey sign-in requires a supported browser and a secure connection.';
+        return;
+      }
+
+      username.addEventListener('focus', startAutofill);
+      // Arm conditional UI on load so suggestions are ready as soon as the field is focused.
+      void startAutofill();
+    })();
+  </script>
+
