+  <script type="module">
+    import 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+    const form = document.querySelector('#signin-form');
+    const username = document.querySelector('[data-testid="username-field"]');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest = null;
+    let signedIn = false;
+
+    const supported = window.isSecureContext &&
+      'PublicKeyCredential' in window && !!navigator.credentials?.get;
+
+    async function authenticate(conditional = false) {
+      if (signedIn || (conditional && activeRequest)) return;
+
+      // Explicit sign-in supersedes both pending options fetches and autofill.
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      const { signal } = controller;
+      if (!conditional) {
+        button.disabled = true;
+        status.textContent = 'Complete verification on your device…';
+      }
+
+      try {
+        if (conditional) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities.conditionalGet || signal.aborted) return;
+        }
+
+        // The server must store the challenge in the session and return
+        // discoverable request options (allowCredentials: []) as Base64URL JSON.
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { Accept: 'application/json' },
+          signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options.publicKey ?? options);
+        if (!conditional) publicKey.userVerification = 'required';
+        if (signal.aborted) return;
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal,
+        });
+        if (!credential || signal.aborted) return;
+
+        button.disabled = true;
+        status.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encoded),
+          signal,
+        });
+        if (!response.ok) {
+          if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Only an explicit credential-not-found response may remove a suggestion.
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId ?? location.hostname,
+              credentialId: encoded.id,
+            }).catch(() => {});
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        const result = response.status === 204 ? {} : await response.json();
+        if (result.success === false || result.verified === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        if (signal.aborted) return;
+        signedIn = true;
+        status.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (signal.aborted || error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) status.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+        } else {
+          status.textContent = 'Unable to sign in with a passkey. Please try again.';
+        }
+      } finally {
+        // A cancelled autofill request must not overwrite the explicit flow.
+        if (activeRequest === controller) {
+          activeRequest = null;
+          button.disabled = signedIn;
+          if (!conditional && !signedIn) void authenticate(true);
+        }
+      }
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (supported) void authenticate();
+    });
+
+    if (supported) {
+      // Register silently before focus so native autofill can offer saved passkeys.
+      void authenticate(true);
+      username.addEventListener('focus', () => void authenticate(true));
+    } else {
+      button.disabled = true;
+      status.textContent = 'Passkeys require a supported browser and a secure connection (HTTPS).';
+    }
+  </script>
