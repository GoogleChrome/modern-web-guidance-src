+:host{display:block;outline:none}:host([disabled]){opacity:.48}.choices{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}button{position:relative;background:white;border:1px solid #e4e3ed;border-radius:7px;padding:19px 8px 15px;color:#8d8c9e;font-family:'DM Sans',sans-serif;cursor:pointer;transition:border-color .15s,background .15s;min-width:0}button:hover:not(:disabled){border-color:#b7a6eb;background:#fcfaff}button[aria-checked="true"]{background:#f5f1ff;border-color:#9377e1;box-shadow:0 0 0 1px #9377e10a;color:#795bc4}button:focus-visible{outline:3px solid #c5b7ff;outline-offset:3px}button:disabled{cursor:not-allowed}svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;display:block;margin:0 auto 12px}.title{display:block;font-size:11px;font-weight:600;color:#5d5c72}.detail{display:block;font-size:9px;color:#a6a0b4;margin-top:5px}.radio{position:absolute;top:9px;right:9px;width:11px;height:11px;border:1px solid #dddae8;border-radius:50%}[aria-checked="true"] .radio{background:#8363d5;border-color:#8363d5}[aria-checked="true"] .radio:after{content:'';position:absolute;width:3px;height:3px;background:white;left:3px;top:3px;border-radius:50%}.error{font:10px 'DM Sans',sans-serif;color:#c67569;margin:9px 0 0}.error:empty{display:none}:host([data-invalid]) button{border-color:#d49286}@media(max-width:400px){.choices{gap:6px}button{padding:20px 4px 14px}.title{font-size:10px}.detail{font-size:8px}}
+</style><div class="choices" role="radiogroup" aria-label="Delivery preference"><button type="button" role="radio" data-value="standard"><span class="radio"></span><svg viewBox="0 0 24 24"><path d="m3 7 9-4 9 4-9 5-9-5Zm0 0v10l9 5 9-5V7M12 12v10M7 5l10 5"/></svg><span class="title">Standard</span><span class="detail">5–7 business days</span></button><button type="button" role="radio" data-value="express"><span class="radio"></span><svg viewBox="0 0 24 24"><path d="M3 6h12v12H3m12-9h4l3 4v5h-7M1 10h6M1 14h4"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg><span class="title">Express</span><span class="detail">2–3 business days</span></button><button type="button" role="radio" data-value="priority"><span class="radio"></span><svg viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8L20 9h-8l1-7Z"/></svg><span class="title">Priority</span><span class="detail">Next business day</span></button></div><p class="error" aria-live="polite"></p>`;
+class DeliveryPicker extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'disabled', 'value'];
+  #internals; #value = ''; #disabled = false; #showError = false;
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({mode:'open', delegatesFocus:true}).append(pickerTemplate.content.cloneNode(true));
+    this.shadowRoot.addEventListener('click', event => {
+      const button = event.target.closest('button');
+      if (!button || this.#disabled) return;
+      this.value = button.dataset.value;
+      this.dispatchEvent(new Event('input', {bubbles:true, composed:true}));
+      this.dispatchEvent(new Event('change', {bubbles:true}));
+    });
+    this.shadowRoot.addEventListener('keydown', event => {
+      if (!['ArrowRight','ArrowLeft','ArrowDown','ArrowUp','Home','End'].includes(event.key) || this.#disabled) return;
+      event.preventDefault();
+      const buttons = [...this.shadowRoot.querySelectorAll('button')];
+      const current = buttons.indexOf(this.shadowRoot.activeElement);
+      const index = event.key === 'Home' ? 0 : event.key === 'End' ? 2 : (current + (['ArrowRight','ArrowDown'].includes(event.key) ? 1 : -1) + 3) % 3;
