+const form = document.querySelector('#demo-form');
+const picker = document.querySelector('#delivery');
+const log = document.querySelector('#event-log');
+let savedState = 'standard';
+function addLog(message) {
+  const row = document.createElement('div'); row.className = 'event';
+  const time = document.createElement('time'); time.textContent = new Date().toLocaleTimeString('en-GB', {hour12:false});
+  const dot = document.createElement('span'); dot.className='event-dot'; dot.textContent='↳';
+  const text = document.createElement('span'); text.className='event-name'; text.textContent=message;
+  row.append(time, dot, text); log.prepend(row);
+  while(log.children.length > 30) log.lastChild.remove();
+}
+function updateInspector() {
+  if (!customElements.get('delivery-picker')) return;
+  const payload = document.querySelector('#payload');
+  payload.replaceChildren(document.createTextNode('{\n'));
+  const entries = [...new FormData(form).entries()];
+  entries.forEach(([key,value], index) => {
+    const k = document.createElement('span'); k.className='key'; k.textContent='  '+JSON.stringify(key);
+    const v = document.createElement('span'); v.className='val'; v.textContent=JSON.stringify(value);
