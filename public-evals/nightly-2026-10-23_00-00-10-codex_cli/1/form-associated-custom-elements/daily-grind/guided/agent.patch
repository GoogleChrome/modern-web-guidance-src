+  static observedAttributes = ['required', 'disabled', 'value'];
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #customError = '';
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `<style>
+      :host{display:block}*{box-sizing:border-box}.options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}label{display:flex;position:relative;flex-direction:column;align-items:center;border:1px solid #e3e7dc;border-radius:6px;cursor:pointer;padding:17px 3px 13px;background:#fff;transition:border-color .15s,background .15s;min-width:0}label:hover{border-color:#a8b89a;background:#fafbf7}label:has(input:checked){border-color:#718b5c;background:#f5f8ef;box-shadow:0 0 0 .5px #718b5c}label:has(input:focus-visible){outline:3px solid #a1b78f;outline-offset:3px}input{appearance:none;position:absolute;right:8px;top:8px;margin:0;width:11px;height:11px;border:1px solid #d8dfce;border-radius:50%;background:#fff}input:checked{background:#718b5c;border-color:#718b5c}input:checked:after{content:'✓';display:block;color:white;font-size:8px;line-height:9px;text-align:center}svg{width:44px;height:44px;margin-bottom:10px}.title{font-size:10px;font-weight:600;color:#59634e;white-space:nowrap}.note{font-size:7px;color:#9ba28d;margin-top:5px;white-space:nowrap}.intensity{display:flex;gap:3px;margin-top:12px}.intensity i{height:3px;width:12px;background:#e8ecdf;border-radius:2px}.intensity i.filled{background:#aab394}.detail{font-size:6px;color:#b0b69e;margin-top:6px;white-space:nowrap}:host(:disabled) label{opacity:.5;cursor:not-allowed;background:#f5f6f1}:host([data-show-error]:invalid) label{border-color:#c28b71}@media(max-width:400px){.options{gap:5px}.title{font-size:9px}.note{font-size:6px}.detail{font-size:5px}label{padding-top:20px}svg{width:35px;height:35px}}
+    </style><div class="options" role="radiogroup" aria-label="Choose your roast">${ROASTS.map(r => `<label><input type="radio" name="roast-choice" value="${r.value}" aria-label="${r.title}, ${r.note}">${bean(r.color)}<span class="title">${r.title}</span><span class="note">${r.note}</span><span class="intensity" aria-hidden="true">${[1,2,3].map(i=>`<i class="${i<=r.intensity?'filled':''}"></i>`).join('')}</span><span class="detail">${r.detail}</span></label>`).join('')}</div>`;
+    root.addEventListener('change', (event) => {
+      if (event.target instanceof HTMLInputElement && !this.#disabled) {
+        event.stopPropagation();
+        this.value = event.target.value;
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertReplacementText' }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+    });
+    // Internal radio input events are replaced with the host's value event above.
+    root.addEventListener('input', event => event.stopPropagation());
+    this.addEventListener('invalid', () => this.setAttribute('data-show-error', ''));
+  }
+  connectedCallback() {
+    if (!this.#dirty) this.#setValue(this.defaultValue);
+    this.#validate();
+  }
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value' && !this.#dirty) this.#setValue(newValue ?? '');
+    this.#validate();
+  }
+  get value() { return this.#value; }
+  set value(value) { this.#dirty = true; this.#setValue(String(value ?? '')); }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value)); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  get labels() { return this.#internals.labels; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(message) { this.#customError = String(message); this.#validate(); }
