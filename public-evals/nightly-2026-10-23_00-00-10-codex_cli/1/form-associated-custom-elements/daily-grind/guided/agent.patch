+  #setValue(value) {
+    this.#value = ROASTS.some(r => r.value === value) ? value : '';
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    for (const input of this.shadowRoot.querySelectorAll('input')) input.checked = input.value === this.#value;
+    this.#validate();
+  }
+  #validate() {
+    const missing = this.required && !this.#value;
+    const message = this.#customError || (missing ? 'Please choose your roast.' : '');
+    this.#internals.setValidity(this.#customError ? { customError: true } : missing ? { valueMissing: true } : {}, message, this.shadowRoot.querySelector('input'));
