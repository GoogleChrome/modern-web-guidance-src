+  }
+}
+
+const form = document.querySelector('#coffee-form');
+let roast = document.querySelector('roast-selector');
+const fields = document.querySelector('#preferences');
+const nameInput = document.querySelector('#customer-name');
+const sizeInput = document.querySelector('#size');
+const milkInput = form.querySelector('[name=oat_milk]');
+let snapshot = null;
+const events = document.querySelector('#event-list');
+function logEvent(hook, message) {
+  const li = document.createElement('li');
+  const dot = document.createElement('span'); dot.className = 'event-dot';
+  const content = document.createElement('div');
+  const code = document.createElement('code'); code.textContent = hook;
+  const description = document.createElement('p'); description.textContent = message;
+  content.append(code, description);
+  const time = document.createElement('time'); time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
+  li.append(dot, content, time); events.prepend(li);
+  while (events.children.length > 12) events.lastElementChild.remove();
+}
+function updateInspector() {
+  const disabled = fields.disabled || roast.disabled;
+  document.querySelector('#current-value').textContent = roast.value ? `"${roast.value}"` : 'null';
+  document.querySelector('#value-type').textContent = roast.value ? 'String · ready to submit' : 'No roast selected';
+  const validity = document.querySelector('#validity-status');
+  validity.textContent = disabled ? '— Not validated' : roast.validity.valid ? '✓ Valid' : '○ Value missing';
+  validity.className = `status-pill ${disabled ? 'neutral' : roast.validity.valid ? 'green' : 'amber'}`;
+  document.querySelector('#control-status').textContent = disabled ? 'Disabled' : 'Enabled';
+  document.querySelector('#form-data').textContent = JSON.stringify(Object.fromEntries(new FormData(form)), null, 2);
+  document.querySelector('#roast-error').textContent = !disabled && roast.hasAttribute('data-show-error') && !roast.validity.valid ? roast.validationMessage : '';
+}
+function rememberState() {
+  snapshot = { roast: roast.value, name: nameInput.value, size: sizeInput.value, milk: milkInput.checked };
+}
+form.addEventListener('control-lifecycle', event => { logEvent(event.detail.hook, event.detail.message); queueMicrotask(updateInspector); });
+const supportsFACE = 'attachInternals' in HTMLElement.prototype && 'ElementInternals' in window && 'setFormValue' in ElementInternals.prototype;
+if (supportsFACE) {
+  customElements.define('roast-selector', RoastSelector);
+} else {
+  const select = document.createElement('select');
+  select.name = 'roast'; select.required = true; select.setAttribute('aria-label', 'Choose your roast');
+  select.innerHTML = '<option value="">Choose a roast</option>' + ROASTS.map(r=>`<option value="${r.value}">${r.title} · ${r.note}</option>`).join('');
+  roast.replaceWith(select); roast = select;
+  document.querySelector('.element-code').textContent = 'Native select · compatibility mode';
+  document.querySelector('.inspector-bottom').textContent = 'Native select fallback for this browser.';
+  logEvent('native fallback', 'Form-associated custom elements unavailable');
+}
+form.addEventListener('input', event => {
+  rememberState(); updateInspector();
+  document.querySelector('#submission').hidden = true;
+  if (event.target === roast) logEvent('input → setFormValue', `Roast updated to "${roast.value}"`);
+});
+form.addEventListener('invalid', event => {
+  if (event.target === roast) roast.setAttribute('data-show-error', '');
+  updateInspector();
+  logEvent('invalid', event.target === roast ? 'A roast is required before submitting' : 'Please enter your name');
+}, true);
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  const data = Object.fromEntries(new FormData(form));
+  logEvent('submit', `${Object.keys(data).length} fields submitted with native FormData`);
+  const output = document.querySelector('#submission');
+  output.textContent = fields.disabled ? 'Form submitted with an empty payload. Disabled fields are excluded from FormData.' : `Preferences saved for ${data.customer_name}. ${ROASTS.find(r=>r.value===data.roast)?.title ?? 'No roast'} · ${data.size} cup${data.oat_milk ? ' · oat milk' : ''}. This is a local demo; nothing was sent.`;
+  output.hidden = false;
+  rememberState(); updateInspector();
+});
+form.addEventListener('reset', () => {
+  document.querySelector('#submission').hidden = true;
+  roast.removeAttribute('data-show-error');
+  queueMicrotask(updateInspector);
+});
+document.querySelector('#reset-control').addEventListener('click', () => {
+  form.reset();
+  document.querySelector('#lifecycle-hint').textContent = 'Form reset. Defaults are back; your last edited state is available to restore.';
+});
+document.querySelector('#disable-control').addEventListener('click', event => {
+  fields.disabled = !fields.disabled;
+  const button = event.currentTarget;
+  button.setAttribute('aria-pressed', String(fields.disabled));
+  button.innerHTML = fields.disabled ? '<span>⊘</span> Enable fields' : '<span>⊘</span> Disable fields';
+  document.querySelector('#lifecycle-hint').textContent = fields.disabled ? 'The fieldset is disabled. Its controls are excluded from submission and validation.' : 'Fields enabled. The custom control is participating in the form again.';
+  updateInspector();
+});
+document.querySelector('#restore-control').addEventListener('click', () => {
+  if (!snapshot) {
+    document.querySelector('#lifecycle-hint').textContent = 'Choose a roast first. Edit your preferences, reset, then restore the last edited state.';
+    logEvent('restore demo', 'No saved state yet · make a selection first');
+    return;
+  }
+  if (supportsFACE) roast.formStateRestoreCallback(snapshot.roast, 'restore');
+  else { roast.value = snapshot.roast; logEvent('restore demo', 'Native select selection restored'); }
+  nameInput.value = snapshot.name; sizeInput.value = snapshot.size; milkInput.checked = snapshot.milk;
+  document.querySelector('#lifecycle-hint').textContent = 'Last edited preferences restored. This button simulates the browser’s state-restore callback.';
+  document.querySelector('#submission').hidden = true;
+  updateInspector();
+});
+document.querySelector('#clear-events').addEventListener('click', () => { events.replaceChildren(); });
+function showView(view) {
+  if (!['playground', 'implementation'].includes(view)) return;
+  for (const id of ['playground', 'implementation']) {
+    document.querySelector(`#${id}`).hidden = id !== view;
+    const tab = document.querySelector(`#${id}-tab`);
+    tab.setAttribute('aria-selected', String(id === view)); tab.tabIndex = id === view ? 0 : -1;
+  }
+  document.querySelectorAll('.nav-item[data-view]').forEach(link => link.classList.toggle('active', link.dataset.view === view));
+  document.querySelector('.topbar>div>span:last-child').textContent = view === 'playground' ? 'Form playground' : 'Component API';
+}
+document.querySelectorAll('[data-view]').forEach(button => button.addEventListener('click', () => showView(button.dataset.view)));
+document.querySelector('[href="#activity"]').addEventListener('click', () => showView('playground'));
+document.querySelector('.tabbar').addEventListener('keydown', event => {
+  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+  event.preventDefault();
+  const view = event.key === 'Home' ? 'playground' : event.key === 'End' ? 'implementation' : document.querySelector('#playground-tab').getAttribute('aria-selected') === 'true' ? 'implementation' : 'playground';
+  showView(view); document.querySelector(`#${view}-tab`).focus();
+});
+showView(location.hash === '#implementation' ? 'implementation' : 'playground');
+updateInspector();
+logEvent('connectedCallback', 'Custom control is ready to brew');
