+];
+const bean = (color) => `<svg viewBox="0 0 50 46" aria-hidden="true"><g transform="rotate(-34 25 23)"><ellipse cx="25" cy="23" rx="13" ry="19" fill="${color}"/><path d="M27 5c-12 13 8 21-4 36" fill="none" stroke="#fff5df" stroke-opacity=".65" stroke-width="1.5" stroke-linecap="round"/></g></svg>`;
