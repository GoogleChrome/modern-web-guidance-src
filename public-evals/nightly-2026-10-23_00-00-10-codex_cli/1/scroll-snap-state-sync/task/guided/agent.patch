+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = [...panel.querySelectorAll('.drink-section h3')];
+
+    function setCurrentHeader(header) {
+      tocLinks.forEach((link) => {
+        if (link.hash === `#${header.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncCurrentHeader() {
+      const snapTop = panel.getBoundingClientRect().top + panel.clientTop
+        + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      const closest = headers.reduce((nearest, header) =>
+        Math.abs(header.getBoundingClientRect().top - snapTop)
+          < Math.abs(nearest.getBoundingClientRect().top - snapTop) ? header : nearest
+      );
+      setCurrentHeader(closest);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        if (headers.includes(event.snapTargetBlock)) {
+          setCurrentHeader(event.snapTargetBlock);
+        }
+      });
+    } else {
+      // Keep the TOC in sync where native scroll snap events are unavailable.
+      const observer = new IntersectionObserver(syncCurrentHeader, {
+        root: panel,
+        rootMargin: '0px 0px -70% 0px',
+        threshold: [0, 1],
+      });
+      headers.forEach((header) => observer.observe(header));
+      panel.addEventListener('scrollend', syncCurrentHeader);
+    }
+
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        const header = headers.find((item) => `#${item.id}` === link.hash);
+        if (!header) return;
+        event.preventDefault();
+        const top = panel.scrollTop + header.getBoundingClientRect().top
+          - panel.getBoundingClientRect().top - panel.clientTop
+          - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+        panel.scrollTo({ top, behavior: 'auto' });
+        // CSS controls smooth scrolling and respects reduced-motion preferences.
+        header.focus({ preventScroll: true });
+      });
+    });
+
+    requestAnimationFrame(syncCurrentHeader);
+  </script>
