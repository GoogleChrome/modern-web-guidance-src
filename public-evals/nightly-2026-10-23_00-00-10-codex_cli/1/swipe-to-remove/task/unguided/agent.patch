+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const buttonHadFocus = item.contains(document.activeElement);
+      const nextButton = (item.nextElementSibling || item.previousElementSibling)?.querySelector('button');
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-ready', 'is-removing');
+      item.querySelector('button').disabled = true;
+      content.style.transform = `translateX(${direction * item.offsetWidth}px)`;
+      if (buttonHadFocus) {
+        if (nextButton) nextButton.focus();
+        else {
+          const heading = document.getElementById('cart-title');
+          heading.tabIndex = -1;
+          heading.focus();
+        }
+      }
+      const remaining = [...cartList.children].filter(row => !row.classList.contains('is-removing'));
+      document.getElementById('cart-count').textContent = `${remaining.length} ${remaining.length === 1 ? 'item' : 'items'}`;
+      document.getElementById('cart-subtotal').textContent = currency.format(remaining.reduce((sum, row) => sum + Number(row.dataset.price), 0) / 100);
+      document.getElementById('cart-status').textContent = `${item.dataset.name} removed from your cart.`;
+
+      const finish = () => {
+        item.remove();
+        document.querySelector('.cart-empty').hidden = cartList.children.length > 0;
+        document.querySelector('.cart-hint').hidden = cartList.children.length === 0;
+      };
+      if (reducedMotion.matches) { finish(); return; }
+      // Allow the swipe to finish before collapsing the measured row height.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(finish, 300);
+      }, 220);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(120, content.clientWidth * 0.3);
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      };
+      item.querySelector('button').addEventListener('click', () => removeCartItem(item));
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0, horizontal: false };
+        content.setPointerCapture(event.pointerId);
+      });
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { reset(); return; }
+          gesture.horizontal = true;
+          item.classList.add('is-dragging');
+        }
+        gesture.distance = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+      content.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const distance = gesture.distance;
+        const shouldRemove = gesture.horizontal && Math.abs(distance) >= threshold();
+        gesture = null;
+        if (shouldRemove) removeCartItem(item, Math.sign(distance));
+        else reset();
+      });
+      content.addEventListener('pointercancel', reset);
+      content.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+    });
+  </script>
