+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const handles = new WeakMap();
+    const needsScrollFallback = !CSS.supports('scroll-initial-target', 'nearest');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const resizeObserver = needsScrollFallback ? new ResizeObserver(entries => {
+      for (const { target } of entries) {
+        // Resizing can reset the center snap point in Safari.
+        target.scrollLeft = target.clientWidth;
+      }
+    }) : null;
+
+    async function removeItem(item) {
+      if (item.classList.contains('is-removing')) return;
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const name = content.querySelector('h3').textContent;
+      const height = item.getBoundingClientRect().height;
+      const offset = content.getBoundingClientRect().left - track.getBoundingClientRect().left;
+      const remaining = [...list.children].filter(row => row !== item && !row.classList.contains('is-removing'));
+      if (item.contains(document.activeElement)) {
+        const next = remaining.find(row => row.compareDocumentPosition(item) & Node.DOCUMENT_POSITION_PRECEDING) || remaining.at(-1);
+        (next?.querySelector('.cart-remove') || document.querySelector('#cart-title')).focus({ preventScroll: true });
+      }
+      viewportObserver.unobserve(item);
+      handles.get(item)?.disconnect();
+      resizeObserver?.unobserve(track);
+      item.classList.add('is-removing');
+      item.inert = true;
+      document.querySelector('#cart-count').textContent = `${remaining.length} ${remaining.length === 1 ? 'item' : 'items'}`;
+      document.querySelector('#cart-status').textContent = `${name} removed from cart. ${remaining.length} items remaining.`;
+      document.querySelector('.cart-empty').hidden = remaining.length > 0;
+      const duration = reducedMotion.matches ? 0 : 300;
+      const options = { duration, easing: 'ease', fill: 'forwards' };
+      const slide = content.animate([
+        { transform: 'translateX(0)' },
+        { transform: `translateX(${offset > 0 ? track.clientWidth - offset : -track.clientWidth - offset}px)` }
+      ], options);
+      const collapse = item.animate([{ height: `${height}px` }, { height: '0px' }], options);
+      await Promise.allSettled([slide.finished, collapse.finished]);
+      // Let Safari's gesture momentum settle before detaching the row so
+      // the next row cannot inherit the active horizontal scroll gesture.
+      if ('GestureEvent' in window) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      // Center before observing, so initialization cannot count as a swipe.
+      track.scrollLeft = track.clientWidth;
+      resizeObserver?.observe(track);
+      const observer = new IntersectionObserver(entries => {
+        if (item.classList.contains('is-removing')) return;
+        const entry = entries.at(-1);
+        // Measure horizontal exposure only: clipping at the viewport's top
+        // or bottom must never count as a removal gesture.
+        const offset = entry.boundingClientRect.left - entry.rootBounds.left;
+        const visible = Math.max(0, 1 - Math.abs(offset) / entry.boundingClientRect.width);
+        item.classList.toggle('is-activating', visible < 0.8);
+        if (visible < 0.2) removeItem(item);
+      }, { root: track, threshold: Array.from({ length: 101 }, (_, i) => i / 100) });
+      handles.set(item, observer);
+      return observer;
+    }
+
+    const viewportObserver = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (item.classList.contains('is-removing')) continue;
+        if (entry.isIntersecting) {
+          const observer = handles.get(item) || setupItem(item);
+          observer.observe(item.querySelector('.SwipeableList-content'));
+        } else {
+          handles.get(item)?.disconnect();
+        }
+      }
+    });
+
+    list.querySelectorAll('.SwipeableList-item').forEach(item => viewportObserver.observe(item));
+    list.addEventListener('click', event => {
+      const button = event.target.closest('.cart-remove');
+      if (button) removeItem(button.closest('.SwipeableList-item'));
+    });
+  </script>
