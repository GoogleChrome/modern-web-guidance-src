+  <script>
+    // Keep the same directional hints in browsers without scroll-state queries.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.reviews-scroll');
+      const updateIndicators = () => {
+        const remaining = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop;
+        scroller.classList.toggle('scrolled-down', scroller.scrollTop > 0);
+        // Account for fractional scroll positions at the bottom edge.
+        scroller.classList.toggle('can-scroll-down', remaining > 1);
+      };
+
+      scroller.addEventListener('scroll', updateIndicators, { passive: true });
+      const resizeObserver = new ResizeObserver(updateIndicators);
+      resizeObserver.observe(scroller);
+      resizeObserver.observe(scroller.querySelector('.review-list'));
+      updateIndicators();
+    }
+  </script>
+
