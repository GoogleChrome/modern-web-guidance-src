+++ b/tests/contentful-metrics.test.cjs
@@ -0,0 +1,72 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const source = readFileSync(require.resolve('../contentful-metrics.js'), 'utf8');
+
+function setup(types = ['soft-navigation', 'interaction-contentful-paint']) {
+  const callbacks = new Map();
+  const events = [];
+  const options = [];
+  class Observer {
+    static supportedEntryTypes = types;
+    constructor(callback) { this.callback = callback; }
+    observe(option) { options.push(option); callbacks.set(option.type, this.callback); }
+    disconnect() { this.disconnected = true; }
+  }
+  const window = { dispatchEvent: (event) => events.push(event) };
+  runInNewContext(source, { window, PerformanceObserver: Observer,
+    CustomEvent: class { constructor(type, init) { this.type = type; this.detail = init.detail; } } });
+  return { metrics: window.contentfulMetrics, events, options,
+    emit: (type, ...entries) => callbacks.get(type)({ getEntries: () => entries }) };
+}
+
+test('measures actual presentation, including asynchronous content updates', () => {
+  const { metrics, emit, events, options } = setup();
+  emit('interaction-contentful-paint', { startTime: 100, presentationTime: 450,
+    interactionId: 7, navigationId: 'initial' });
+  assert.equal(metrics.getEntries()[0].duration, 350);
+  assert.equal(events[0].type, 'contentful-metric');
+  assert.ok(options.every((option) => option.buffered));
+  events[0].detail.duration = 0;
+  assert.equal(metrics.getEntries()[0].duration, 350);
+});
+
+test('attributes paints that arrive before and after a soft navigation by interaction', () => {
+  const { metrics, emit } = setup();
+  emit('interaction-contentful-paint', { startTime: 100, presentationTime: 150,
+    interactionId: 7, navigationId: 'old' });
+  emit('soft-navigation', { startTime: 100, presentationTime: 160,
+    interactionId: 7, navigationId: 'new', name: 'https://example.com/menu' });
+  emit('interaction-contentful-paint', { startTime: 100, presentationTime: 300,
+    interactionId: 7, navigationId: 'old' });
+  const records = metrics.getEntries();
+  assert.ok(records.every((record) => record.url === 'https://example.com/menu'));
+  assert.ok(records.every((record) => record.navigationId === 'new'));
+  assert.equal(records[1].duration, 60);
+  assert.equal(records[2].duration, 200);
+});
+
+test('does not invent measurements when unsupported or lacking presentation timing', () => {
+  const unsupported = setup([]);
+  assert.equal(unsupported.metrics.support.interaction, false);
+  assert.equal(unsupported.options.length, 0);
+  const { metrics, emit } = setup();
+  emit('interaction-contentful-paint', { startTime: 100, paintTime: 120 });
+  emit('soft-navigation', { startTime: 100, presentationTime: 90 });
+  assert.equal(metrics.getEntries().length, 0);
+});
+
+test('retains a bounded history and exposes defensive copies and clearing', () => {
+  const { metrics, emit } = setup();
+  for (let i = 0; i < 205; i++) {
+    emit('interaction-contentful-paint', { startTime: i, presentationTime: i + 10,
+      interactionId: i });
+  }
+  assert.equal(metrics.getEntries().length, 200);
+  assert.equal(metrics.getEntries()[0].interactionId, 5);
+  metrics.getEntries()[0].duration = -1;
+  assert.equal(metrics.getEntries()[0].duration, 10);
+  metrics.clear();
+  assert.equal(metrics.getEntries().length, 0);
+});
