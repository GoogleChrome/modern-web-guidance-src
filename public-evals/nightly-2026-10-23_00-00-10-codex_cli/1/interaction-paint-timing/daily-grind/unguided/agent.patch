index 0000000..659d547
--- /dev/null
+++ b/contentful-metrics.js
@@ -0,0 +1,84 @@
+(() => {
+  'use strict';
+
+  const limit = 200;
+  const entries = [];
+  const navigations = new Map();
+  const observers = [];
+  const supported = globalThis.PerformanceObserver?.supportedEntryTypes ?? [];
+  const support = {
+    interaction: supported.includes('interaction-contentful-paint'),
+    navigation: supported.includes('soft-navigation'),
+  };
+
+  function publish(record) {
+    entries.push(record);
+    if (entries.length > limit) entries.shift();
+    window.dispatchEvent(new CustomEvent('contentful-metric', {
+      detail: { ...record },
+    }));
+  }
+
+  function observe(type, process) {
+    if (!supported.includes(type)) return;
+    try {
+      const observer = new PerformanceObserver((list) => {
+        for (const entry of list.getEntries()) process(entry);
+      });
+      observer.observe({ type, buffered: true });
+      observers.push(observer);
+    } catch {
+      // Some browsers advertise experimental entry types but reject observation.
+      support[type === 'soft-navigation' ? 'navigation' : 'interaction'] = false;
+    }
+  }
+
+  function timing(entry) {
+    // presentationTime is when pixels reach the screen. Do not substitute a
+    // DOM mutation, requestAnimationFrame callback, or paint-start timestamp.
+    const endTime = entry.presentationTime;
+    if (!Number.isFinite(endTime) || endTime <= 0 || endTime < entry.startTime) {
+      return null;
+    }
+    return { startTime: entry.startTime, presentationTime: endTime,
+      duration: endTime - entry.startTime };
+  }
+
+  observe('soft-navigation', (entry) => {
+    const navigation = { url: entry.name, navigationId: entry.navigationId };
+    navigations.set(entry.interactionId, navigation);
+    if (navigations.size > limit) navigations.delete(navigations.keys().next().value);
+
+    // A contentful paint can arrive before the URL changes. Match by the
+    // initiating interaction, since navigationId may still refer to the old URL.
+    for (const record of entries) {
+      if (record.type === 'interaction-contentful-paint' &&
+          record.interactionId === entry.interactionId) {
+        Object.assign(record, navigation);
+      }
+    }
+    const measured = timing(entry);
+    if (!measured) return;
+    publish({ type: 'soft-navigation', ...measured, ...navigation,
+      interactionId: entry.interactionId });
+  });
+
+  observe('interaction-contentful-paint', (entry) => {
+    const measured = timing(entry);
+    if (!measured) return;
+    const navigation = navigations.get(entry.interactionId);
+    publish({ type: 'interaction-contentful-paint', ...measured,
+      interactionId: entry.interactionId,
+      navigationId: navigation?.navigationId ?? entry.navigationId,
+      // Without a matched soft navigation, a delayed entry cannot reliably be
+      // attributed to the URL visible when the observer callback executes.
+      url: navigation?.url ?? null });
+  });
+
+  window.contentfulMetrics = Object.freeze({
+    get support() { return { ...support }; },
+    getEntries() { return entries.map((entry) => ({ ...entry })); },
+    clear() { entries.length = 0; navigations.clear(); },
+    disconnect() { observers.forEach((observer) => observer.disconnect()); },
+  });
+})();
