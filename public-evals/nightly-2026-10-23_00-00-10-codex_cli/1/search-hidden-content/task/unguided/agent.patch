+  <script>
+    const tabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+    const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));
+
+    function activateTab(index) {
+      tabs.forEach((tab, tabIndex) => {
+        const selected = tabIndex === index;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panels[tabIndex].removeAttribute('hidden');
+        } else {
+          panels[tabIndex].setAttribute('hidden', 'until-found');
+        }
+      });
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => activateTab(index));
+      tab.addEventListener('keydown', event => {
+        let nextIndex;
+        switch (event.key) {
+          case 'ArrowRight': nextIndex = (index + 1) % tabs.length; break;
+          case 'ArrowLeft': nextIndex = (index - 1 + tabs.length) % tabs.length; break;
+          case 'Home': nextIndex = 0; break;
+          case 'End': nextIndex = tabs.length - 1; break;
+          default: return;
+        }
+        event.preventDefault();
+        activateTab(nextIndex);
+        tabs[nextIndex].focus();
+      });
+      // Find-in-page must select the matching panel and close its sibling.
+      panels[index].addEventListener('beforematch', () => activateTab(index));
+    });
+
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'Coupon revealed';
+      // Keep this a one-way action, including when search reveals the code.
+      couponButton.disabled = true;
+    }
+
+    couponButton.addEventListener('click', revealCoupon);
+    couponPanel.addEventListener('beforematch', revealCoupon);
+  </script>
