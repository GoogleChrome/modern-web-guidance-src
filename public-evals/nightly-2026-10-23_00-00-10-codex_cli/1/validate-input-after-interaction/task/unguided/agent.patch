@@ -206,7 +280,47 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.querySelector('#newsletter-form');
+    const newsletterEmail = document.querySelector('#newsletter-email');
+    const newsletterError = document.querySelector('#newsletter-error');
+    const newsletterStatus = document.querySelector('#newsletter-status');
+
+    function clearNewsletterError() {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterError.textContent = '';
+    }
+
+    newsletterEmail.addEventListener('focus', clearNewsletterError);
+    newsletterEmail.addEventListener('input', () => {
+      clearNewsletterError();
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterEmail.addEventListener('blur', () => {
+      newsletterEmail.value = newsletterEmail.value.trim();
+      const valid = newsletterEmail.validity.valid;
+      newsletterEmail.setAttribute('aria-invalid', String(!valid));
+      newsletterError.textContent = valid ? '' : (
+        newsletterEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.'
+      );
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!newsletterEmail.validity.valid) {
+        newsletterEmail.focus();
+        return;
+      }
+
+      // Replace this status with a request when a newsletter service is connected.
+      newsletterStatus.textContent = 'Newsletter signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
