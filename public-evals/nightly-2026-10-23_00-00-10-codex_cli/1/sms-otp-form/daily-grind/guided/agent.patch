--- /dev/null
+++ b/verification.js
@@ -0,0 +1,215 @@
+(() => {
+  const $ = (id) => document.getElementById(id);
+  const apiBase = document.querySelector('meta[name="verification-api-base"]').content.replace(/\/$/, '');
+  const demo = !apiBase;
+  const phoneForm = $('phone-form');
+  const codeForm = $('code-form');
+  let currentPhone = '';
+  let challengeId = '';
+  let otpController;
+  let countdown;
+  let cooldownUntil = 0;
+  let demoExpires = 0;
+  let busy = false;
+  let receivedCode = '';
+  let step = 'phone';
+  $('demo-note').hidden = !demo;
+
+  function stopListener() {
+    otpController?.abort();
+    otpController = undefined;
+  }
+
+  function setStep(next) {
+    step = next;
+    for (const name of ['phone', 'code', 'success']) $(name + '-view').hidden = name !== next;
+    for (const name of ['phone', 'code']) $(name + '-step').removeAttribute('aria-current');
+    if (next !== 'success') $(next + '-step').setAttribute('aria-current', 'step');
+    $('phone-step').classList.toggle('complete', next !== 'phone');
+    $('code-step').classList.toggle('complete', next === 'success');
+  }
+
+  function error(field, message) {
+    $(field + '-error').textContent = message;
+    if (message) $(field).setAttribute('aria-invalid', 'true');
+    else $(field).removeAttribute('aria-invalid');
+  }
+
+  function normalizedPhone() {
+    const raw = $('phone').value.trim();
+    if (!/^[+\d\s().-]+$/.test(raw)) return '';
+    const digits = raw.replace(/\D/g, '');
+    const prefix = $('country').value;
+    const national = prefix === '+1' ? digits : digits.replace(/^0/, '');
+    const result = raw.startsWith('+') ? '+' + digits : prefix + national;
+    if (!/^\+[1-9]\d{7,14}$/.test(result)) return '';
+    if (!raw.startsWith('+') && prefix === '+1' && digits.length !== 10) return '';
+    return result;
+  }
+
+  async function post(path, body) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(apiBase + path, {
+        method: 'POST', credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body), signal: controller.signal,
+      });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+        throw new Error(path === '/send' ? 'We couldn’t send the code. Check your number and try again.' : 'That code is incorrect or expired. Check it or request a new code.');
+      }
+      return result;
+    } catch (e) {
+      if (e.name === 'AbortError' || e instanceof TypeError) throw new Error('We couldn’t connect. Please try again.');
+      throw e;
+    } finally { clearTimeout(timeout); }
+  }
+
+  function updateCooldown() {
+    const remaining = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+    $('resend').disabled = remaining > 0 || busy;
+    $('resend-timer').textContent = remaining ? `in ${remaining}s` : '';
+    if (!remaining) clearInterval(countdown);
+  }
+
+  async function listenForSms() {
+    stopListener();
+    if (demo || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    otpController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+      if (otp && !controller.signal.aborted && step === 'code') {
+        if (busy) { receivedCode = otp.code; return; }
+        $('code').value = otp.code;
+        error('code', '');
+        codeForm.requestSubmit();
+      }
+    } catch { /* Autofill denial, timeout, or unavailable API: manual entry remains available. */ }
+    finally { clearTimeout(timeout); }
+  }
+
+  async function sendCode(resend = false) {
+    if (busy) return;
+    if (resend && Date.now() < cooldownUntil) return;
+    const number = resend ? currentPhone : normalizedPhone();
+    if (!number) {
+      error('phone', 'Enter a valid mobile number, including its area code.');
+      $('phone').focus();
+      return;
+    }
+    busy = true;
+    receivedCode = '';
+    stopListener();
+    const button = resend ? $('resend') : $('send-button');
+    const original = button.innerHTML;
+    button.disabled = true;
+    button.textContent = 'Sending…';
+    error(resend ? 'code' : 'phone', '');
+    // Listen before triggering SMS delivery to avoid missing an immediately delivered code.
+    if (!demo) {
+      currentPhone = number;
+      $('destination').textContent = `We’ll text a 6-digit code to ${number}.`;
+      setStep('code');
+      listenForSms();
+    }
+    try {
+      const result = demo ? { challengeId: 'demo', retryAfter: 30 } : await post('/send', { phone: number });
+      if (!result.challengeId) throw new Error('We couldn’t start verification. Please try again.');
+      currentPhone = number;
+      challengeId = result.challengeId;
+      demoExpires = Date.now() + 300000;
+      $('code').value = '';
+      error('code', '');
+      $('destination').textContent = demo ? `Demo code ready for ${number}. Use 123456 to try it.` : `We sent a 6-digit code to ${number}.`;
+      setStep('code');
+      const retryAfter = Number(result.retryAfter);
+      cooldownUntil = Date.now() + (Number.isFinite(retryAfter) ? Math.max(30, Math.min(retryAfter, 300)) : 30) * 1000;
+      clearInterval(countdown);
+      countdown = setInterval(updateCooldown, 1000);
+      $('status').textContent = demo ? 'Demo code ready. Enter 123456. No SMS was sent.' : 'Verification code sent.';
+      $('code').focus();
+    } catch (e) {
+      stopListener();
+      if (!resend) setStep('phone');
+      error(resend ? 'code' : 'phone', e.message);
+      $(resend ? 'code' : 'phone').focus();
+    } finally {
+      busy = false;
+      button.innerHTML = original;
+      button.disabled = false;
+      updateCooldown();
+      if (receivedCode && step === 'code') {
+        $('code').value = receivedCode;
+        receivedCode = '';
+        codeForm.requestSubmit();
+      }
+    }
+  }
+
+  phoneForm.addEventListener('submit', (event) => { event.preventDefault(); sendCode(); });
+  $('resend').addEventListener('click', () => sendCode(true));
+  codeForm.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    stopListener();
+    if (busy) return;
+    busy = true;
+    const button = $('verify-button');
+    button.disabled = true;
+    button.textContent = 'Verifying…';
+    error('code', '');
+    try {
+      if (demo) {
+        if (Date.now() > demoExpires) throw new Error('This code has expired. Request a new code to try again.');
+        if ($('code').value !== '123456') throw new Error('That code doesn’t match. Use 123456 for this demo.');
+      } else {
+        const result = await post('/check', { challengeId, code: $('code').value });
+        if (result.verified !== true) throw new Error('That code is incorrect or expired. Please try again.');
+      }
+      clearInterval(countdown);
+      $('success-copy').textContent = demo ? `You’ve completed the demo for ${currentPhone}. No real phone verification took place.` : `Your phone number ${currentPhone} is verified. You’re ready for your next Daily Grind moment.`;
+      $('status').textContent = demo ? 'Demo verification completed.' : 'Phone number verified.';
+      setStep('success');
+      $('success-view').focus();
+    } catch (e) {
+      error('code', e.message);
+      $('code').focus();
+    } finally {
+      busy = false;
+      button.disabled = false;
+      button.innerHTML = 'Verify phone number <span aria-hidden="true">→</span>';
+    }
+  });
+
+  function reset() {
+    if (busy) return;
+    stopListener();
+    clearInterval(countdown);
+    challengeId = '';
+    $('code').value = '';
+    error('phone', ''); error('code', '');
+    setStep('phone');
+    $('phone').focus();
+  }
+  $('change-number').addEventListener('click', reset);
+  $('start-over').addEventListener('click', reset);
+  $('phone').addEventListener('input', () => error('phone', ''));
+  $('country').addEventListener('change', () => error('phone', ''));
+  $('code').addEventListener('input', () => error('code', ''));
+  $('code').addEventListener('paste', (event) => {
+    const text = event.clipboardData.getData('text').trim();
+    const match = text.match(/^\d{6}$/) || text.match(/\b\d{6}\b/);
+    if (match) { event.preventDefault(); $('code').value = match[0]; error('code', ''); }
+  });
+  window.addEventListener('pagehide', () => { stopListener(); clearInterval(countdown); });
+  window.addEventListener('pageshow', (event) => {
+    if (event.persisted && step === 'code') {
+      countdown = setInterval(updateCooldown, 1000);
+      updateCooldown(); listenForSms();
+    }
+  });
+})();
