index 0000000..00d474e
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,76 @@
+import type { APIRoute } from 'astro';
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+type Challenge = { phone: string; hash: string; expires: number; attempts: number };
+const digest = (code: string) => createHash('sha256').update(code).digest('hex');
+const reply = (body: object, status = 200) => Response.json(body, { status, headers: { 'Cache-Control': 'no-store' } });
+
+export const POST: APIRoute = async ({ request, session, site }) => {
+  // This application disables Astro's global origin check; enforce it here.
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return reply({ error: 'Please submit this form from this website.' }, 403);
+  }
+  if (!session) return reply({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return reply({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object') return reply({ error: 'Invalid request.' }, 400);
+  const { action, phone, username, password, code } = body;
+  if (typeof phone !== 'string' || !/^\+[1-9][0-9]{7,14}$/.test(phone)) {
+    return reply({ error: 'Enter a phone number with its country code, such as +14155552671.' }, 400);
+  }
+  if (action === 'send-code') {
+    const sid = process.env.TWILIO_ACCOUNT_SID;
+    const token = process.env.TWILIO_AUTH_TOKEN;
+    const from = process.env.TWILIO_FROM_NUMBER;
+    const hostname = process.env.SMS_OTP_HOSTNAME || site?.hostname;
+    if (!sid || !token || !from || !hostname || !/^[a-z0-9.-]+$/i.test(hostname)) {
+      return reply({ error: 'SMS verification is not configured. Please try again later.' }, 503);
+    }
+    const now = Date.now();
+    const rate = await session.get('signupSmsRate') as { next: number; reset: number; count: number } | undefined;
+    if (rate && (rate.next > now || (rate.reset > now && rate.count >= 5))) {
+      return reply({ error: 'Too many requests. Please wait before requesting another code.' }, 429);
+    }
+    await session.set('signupSmsRate', { next: now + 60_000, reset: rate && rate.reset > now ? rate.reset : now + 3_600_000, count: rate && rate.reset > now ? rate.count + 1 : 1 });
+    session.delete('signupChallenge');
+    const otp = randomInt(0, 1_000_000).toString().padStart(6, '0');
+    try {
+      const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+        method: 'POST',
+        headers: { Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`, 'Content-Type': 'application/x-www-form-urlencoded' },
+        body: new URLSearchParams({ To: phone, From: from, Body: `Your DevTools Times verification code is ${otp}. It expires in 5 minutes.\n\n@${hostname} #${otp}` }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) return reply({ error: 'We could not send your code. Check your number and try again in a minute.' }, 502);
+      await session.set('signupChallenge', { phone, hash: digest(otp), expires: Date.now() + 300_000, attempts: 0 });
+      return reply({ message: 'Code sent.', resendAfter: 60 });
+    } catch {
+      return reply({ error: 'SMS delivery is unavailable. Please try again in a minute.' }, 502);
+    }
+  }
+  if (action !== 'register') return reply({ error: 'Invalid request.' }, 400);
+  if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !/^(?=.*[0-9]).{8,}$/s.test(password)) {
+    return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+  }
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+  if (!challenge || challenge.phone !== phone || challenge.expires <= Date.now() || challenge.attempts >= 5) {
+    return reply({ error: 'Your code has expired or is unavailable. Please request a new code.' }, 400);
+  }
+  if (typeof code !== 'string' || !/^[0-9]{6}$/.test(code)) return reply({ error: 'Enter the 6-digit code from your SMS.' }, 400);
+  challenge.attempts += 1;
+  await session.set('signupChallenge', challenge);
+  const valid = timingSafeEqual(Buffer.from(challenge.hash, 'hex'), Buffer.from(digest(code), 'hex'));
+  if (!valid) return reply({ error: 'That code is incorrect. Try again or request a new code.' }, 400);
+  // Consume the code before registration so it cannot be reused for another account.
+  session.delete('signupChallenge');
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone }), signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) return reply({ error: 'Registration failed. Check your account details, then request a new code to try again.' }, 502);
+    return reply({ message: 'Your phone number is verified and your account is ready. You can now sign in.' });
+  } catch {
+    return reply({ error: 'Registration is unavailable. Request a new code before trying again.' }, 502);
+  }
+};
