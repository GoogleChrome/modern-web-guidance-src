+export default function AuthPrivacyNotice() {
+  return (
+    <div id="auth-privacy" className="mb-6 space-y-2 text-sm text-gray-700">
+      <p>We ask only for a username and password to create or access your account. Use a nickname and a password you do not use elsewhere.</p>
+      <p>When you submit, these details are sent over HTTPS to our external authentication service at us-central1-web-devrel-apps.cloudfunctions.net (times_cdn). That service also receives connection information, including your IP address. This form does not send your details to analytics or advertising services.</p>
+      <p>Read our{' '}
+        <a className="underline" href={`${import.meta.env.BASE_URL}legal/privacy#accounts`}>account privacy information</a>{' '}
+        for details and the limits of this demo.
+      </p>
+    </div>
+  );
+}
