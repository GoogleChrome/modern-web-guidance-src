 import { defineMiddleware } from 'astro:middleware';
 
-export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
-    }
+export const onRequest = defineMiddleware(async ({ url }, next) => {
+  // Reading-list endpoints already default to an empty list. Let the first
+  // bookmark write create a session instead of setting a cookie on every visit.
+  const response = await next();
+
+  response.headers.set('Referrer-Policy', 'no-referrer');
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
+
+  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
+  const pathname = url.pathname.replace(/\/$/, '');
+  if (pathname === `${base}/signin` || pathname === `${base}/signup`) {
+    response.headers.set('Cache-Control', 'no-store');
+    response.headers.set('X-Robots-Tag', 'noindex, nofollow');
   }
-  return next();
+
+  return response;
 });
