@@ -0,0 +1,13 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import { auditPrivacy } from './privacy-audit.mjs';
+
+// Publish only public assets, never repository files or operational documents.
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(new URL(path, root), new URL(path, output), { recursive: true });
+}
+await auditPrivacy(output);
+console.log('Built static site in dist/');
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..d99cd8b
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,65 @@
+import assert from 'node:assert/strict';
+import { access, readFile, readdir } from 'node:fs/promises';
+
+// Static regression guard for this deliberately script-free site. No network,
+// browser, user data, or reporting service is involved in the audit.
+export async function auditPrivacy(root) {
+  const headerFile = await readFile(new URL('_headers', root), 'utf8');
+  const headers = Object.fromEntries(headerFile.trim().split('\n').slice(1).map(line => {
+    const colon = line.indexOf(':');
+    return [line.slice(0, colon).trim(), line.slice(colon + 1).trim()];
+  }));
+  const csp = headers['Content-Security-Policy'];
+  for (const directive of [
+    "default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "img-src 'self'", "connect-src 'none'", "frame-src 'none'",
+    "object-src 'none'", "base-uri 'none'", "form-action 'none'",
+    "frame-ancestors 'none'", "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+  ]) {
+    assert(csp.split(';').map(value => value.trim()).includes(directive), `Missing CSP: ${directive}`);
+  }
+  assert(!/unsafe-inline|unsafe-eval|https?:|\*/i.test(csp), 'CSP must not allow broad sources');
+  assert.equal(headers['Referrer-Policy'], 'no-referrer');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.equal(headers['Cross-Origin-Opener-Policy'], 'same-origin-allow-popups');
+  assert.equal(headers['Strict-Transport-Security'], 'max-age=300');
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'usb']) {
+    assert(headers['Permissions-Policy'].split(', ').includes(`${feature}=()`), `${feature} must be disabled`);
+  }
+  assert(!headers['Set-Cookie'], 'Static pages must not set cookies');
+  assert(!headers['Reporting-Endpoints'], 'Do not add telemetry without a privacy review');
+
+  async function auditDirectory(directory) {
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+      const file = new URL(entry.name, directory);
+      if (entry.isDirectory()) {
+        await auditDirectory(new URL(`${entry.name}/`, directory));
+        continue;
+      }
+      assert(!/\.(?:[cm]?js|wasm)$/i.test(entry.name), 'Client-side executable assets require a privacy review');
+      if (!/\.(?:html|css)$/i.test(entry.name)) continue;
+      const source = await readFile(file, 'utf8');
+      assert(!/(?:https?:)?\/\//i.test(source), `${file.pathname}: third-party URL requires review`);
+      assert(!/@import\b/i.test(source), 'Stylesheets must not import other resources');
+      for (const match of source.matchAll(/url\(\s*['"]?([^'"\s)]+)['"]?\s*\)/gi)) {
+        assert(match[1].startsWith('/assets/'), 'CSS resources must be first-party assets');
+        await access(new URL(match[1].slice(1), root));
+      }
+      if (!entry.name.endsWith('.html')) continue;
+      assert(!/<(?:script|iframe|object|embed|form|input|textarea|select|base|style)\b/i.test(source), 'Active content or data collection requires review');
+      assert(!/\s(?:on[\w-]+|style|ping)\s*=/i.test(source), 'Inline code or link tracking is prohibited');
+      assert(!/\b(?:javascript|data):/i.test(source), 'Executable and data URLs are prohibited');
+      assert(source.includes('<meta name="referrer" content="no-referrer">'), 'Missing referrer fallback');
+      const meta = source.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/i)?.[1];
+      assert.equal(meta, csp.replace("; frame-ancestors 'none'", ''), 'Meta and HTTP CSP must match');
+      for (const match of source.matchAll(/(?:src|href)="(\/assets\/[^"?#]+)"/gi)) {
+        await access(new URL(match[1].slice(1), root));
+      }
+    }
+  }
+  await auditDirectory(root);
+  console.log('Privacy audit passed: first-party assets, no client scripts or collection, restrictive headers.');
+}
