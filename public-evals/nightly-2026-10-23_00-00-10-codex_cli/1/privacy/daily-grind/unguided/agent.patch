@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { auditMarkup, auditStyles } from './audit-privacy.mjs';
+
+const meta = '<meta name="referrer" content="no-referrer">';
+test('rejects new collection, script execution, and external requests', () => {
+  for (const html of [
+    '<script src="/assets/analytics.js"></script>',
+    '<img src="https://tracker.example/pixel">',
+    '<link rel="preconnect" href="//tracker.example">',
+    '<a href="/" ping="/events">Home</a>',
+    '<form action="/collect"><input name="email"></form>',
+    '<img src="/assets/coffee.jpg" onerror="alert(1)">',
+    '<meta http-equiv="refresh" content="0;url=https://tracker.example">',
+    '<iframe src="/embed"></iframe>',
+  ]) assert.throws(() => auditMarkup(meta + html, 'fixture.html'));
+  assert.doesNotThrow(() => auditMarkup(meta + '<a href="/privacy-policy/">Privacy</a>', 'fixture.html'));
+});
+test('rejects third-party CSS resources while accepting self-hosted imagery', () => {
+  for (const css of ['@import "https://fonts.example/font.css";', 'a { background: url(//tracker.example/pixel); }', 'a { background: url(data:image/png;base64,abc); }']) {
+    assert.throws(() => auditStyles(css, 'fixture.css'));
+  }
+  assert.doesNotThrow(() => auditStyles('a { background: url(/assets/coffee.jpg); }', 'fixture.css'));
+});
