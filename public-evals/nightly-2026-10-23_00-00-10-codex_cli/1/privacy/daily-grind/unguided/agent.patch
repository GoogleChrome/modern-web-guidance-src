--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, access } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export function auditMarkup(source, name) {
+  assert(!/<\s*(script|style|base|iframe|object|embed|form|input|textarea|select|video|audio)\b/i.test(source), `${name}: active content or data collection requires privacy review`);
+  assert(!/\s(?:on[\w-]+|style|srcdoc|ping)\s*=/i.test(source), `${name}: inline behavior or styling is forbidden`);
+  assert(!/http-equiv\s*=\s*["']?refresh/i.test(source), `${name}: refresh redirects are forbidden`);
+  for (const match of source.matchAll(/\b(?:href|src|srcset|action|poster|data)\s*=\s*(["'])(.*?)\1/gi)) {
+    assert(/^(?:\/(?!\/)|#)/.test(match[2]) && !/[&\\\s]/.test(match[2]), `${name}: only explicit local URLs are allowed: ${match[2]}`);
+  }
+  assert(source.includes('<meta name="referrer" content="no-referrer">'), `${name}: referrer protection missing`);
+}
+
+export function auditStyles(source, name) {
+  assert(!/@import|@font-face|(?:https?:)?\/\//i.test(source), `${name}: third-party CSS or fonts require review`);
+  for (const match of source.matchAll(/url\(\s*['"]?([^'"\s)]+)['"]?\s*\)/gi)) {
+    assert(/^\/assets\/[\w./-]+$/.test(match[1]) && !match[1].includes('..'), `${name}: CSS resources must be local assets`);
+  }
+}
+
+export async function auditPrivacy(root = '.') {
+  const headersText = await readFile(path.join(root, '_headers'), 'utf8');
+  assert(headersText.startsWith('/*\n'), 'Security headers must cover every route');
+  const headers = Object.fromEntries(headersText.trim().split('\n').slice(1).map(line => {
+    const colon = line.indexOf(':');
+    return [line.slice(0, colon).trim(), line.slice(colon + 1).trim()];
+  }));
+  const policy = headers['Content-Security-Policy'];
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'", "img-src 'self'", "font-src 'none'", "connect-src 'none'", "form-action 'none'", "base-uri 'none'", "object-src 'none'", "frame-src 'none'", "worker-src 'none'", "frame-ancestors 'none'", 'upgrade-insecure-requests']) {
+    assert(policy?.split(';').map(s => s.trim()).includes(directive), `Missing CSP protection: ${directive}`);
+  }
+  for (const [key, value] of Object.entries({ 'Referrer-Policy': 'no-referrer', 'X-Content-Type-Options': 'nosniff', 'X-Frame-Options': 'DENY', 'Cache-Control': 'no-store', 'Strict-Transport-Security': 'max-age=31536000', 'Cross-Origin-Opener-Policy': 'same-origin', 'Cross-Origin-Resource-Policy': 'same-origin', 'X-DNS-Prefetch-Control': 'off' })) {
+    assert.equal(headers[key], value, `Missing ${key} protection`);
+  }
+  for (const capability of ['camera', 'microphone', 'geolocation', 'payment', 'usb', 'browsing-topics']) {
+    assert(headers['Permissions-Policy']?.split(', ').includes(`${capability}=()`), `Missing permission restriction: ${capability}`);
+  }
+  // Audit every publishable text file, including newly added pages/assets.
+  const files = [];
+  async function walk(dir) {
+    for (const entry of await readdir(path.join(root, dir), { withFileTypes: true })) {
+      const name = path.join(dir, entry.name);
+      if (entry.isSymbolicLink()) throw new Error(`Symlinks cannot be published: ${name}`);
+      if (entry.isDirectory()) await walk(name);
+      else files.push(name);
+    }
+  }
+  if (root === '.') {
+    for (const entry of await readdir('.', { withFileTypes: true })) {
+      if (entry.isFile() && entry.name.endsWith('.html')) files.push(entry.name);
+    }
+    await walk('assets');
+    await walk('privacy-policy');
+    const config = JSON.parse(await readFile('vercel.json', 'utf8'));
+    assert.equal(config.headers[0].source, '/(.*)');
+    assert.deepEqual(Object.fromEntries(config.headers[0].headers.map(({ key, value }) => [key, value])), headers, 'Deployment header configurations differ');
+  } else {
+    await walk('');
+  }
+  for (const name of files) {
+    if (name === '_headers') continue;
+    assert(/\.(html|css|jpg|png|webp|ico)$/.test(name), `Unreviewed public file type: ${name}`);
+    if (name.endsWith('.html')) {
+      const source = await readFile(path.join(root, name), 'utf8');
+      auditMarkup(source, name);
+      const metaPolicy = source.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/)?.[1];
+      assert.equal(metaPolicy, policy.replace("; frame-ancestors 'none'; upgrade-insecure-requests", ''), `${name}: fallback CSP differs from headers`);
+      for (const match of source.matchAll(/(?:href|src)="(\/assets\/[^"?#]+)"/g)) await access(path.join(root, match[1]));
+    }
+    if (name.endsWith('.css')) {
+      const source = await readFile(path.join(root, name), 'utf8');
+      auditStyles(source, name);
+      for (const match of source.matchAll(/url\(['"]?(\/assets\/[^'"\s)]+)/g)) await access(path.join(root, match[1]));
+    }
+  }
+  console.log(`Privacy audit passed: ${files.length} public files; no client scripts or external resources.`);
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
+  await auditPrivacy();
+}
