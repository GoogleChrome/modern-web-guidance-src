+  <script>
+    /**
+     * Returns total visible time since navigation, in milliseconds.
+     * If visibility history is unavailable, returns elapsed page time as an
+     * upper bound; that fallback may include time spent in the background.
+     */
+    function getTotalForegroundTime() {
+      const entries = performance.getEntriesByType('visibility-state');
+      const now = performance.now();
+
+      if (entries.length === 0) {
+        return now;
+      }
+
+      let total = 0;
+      for (let i = 0; i < entries.length; i++) {
+        if (entries[i].name === 'visible') {
+          const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+          total += end - entries[i].startTime;
+        }
+      }
+
+      return total;
+    }
+  </script>
