+  <script>
+    const form = document.getElementById('subscription-form');
+    const firstName = document.getElementById('subscriber-name');
+    const email = document.getElementById('subscriber-email');
+    const roast = document.getElementById('roast-preference');
+    const progress = document.getElementById('setup-progress');
+    const summary = document.getElementById('plan-summary');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = `${roastName} · ${roast.value} / 5`;
+      roast.setAttribute('aria-valuetext', `${roastName}, ${roast.value} of 5`);
+      roast.style.setProperty('--roast-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const completed = 1 + Number(firstName.value.trim().length > 0)
+        + Number(email.value.length > 0 && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      progress.value = completed;
+      progress.textContent = `${completed * 25}%`;
+      document.getElementById('progress-description').textContent = `${completed} of 4 complete · ${completed * 25}%`;
+      summary.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!firstName.value.trim()) {
+        firstName.setCustomValidity('Please enter your first name.');
+        firstName.reportValidity();
+        return;
+      }
+      const frequency = form.querySelector('input[name="frequency"]:checked').value.toLowerCase();
+      const updates = document.getElementById('email-updates').checked ? 'Email updates selected.' : 'Email updates not selected.';
+      summary.textContent = `${firstName.value.trim()}, your plan is ready to review: ${roastNames[Number(roast.value) - 1].toLowerCase()} roast, delivered ${frequency}. Contact email: ${email.value}. ${updates} No subscription has been placed.`;
+    });
+    firstName.addEventListener('input', () => firstName.setCustomValidity(''));
+    updateSetup();
+  </script>
