+
+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const emails = document.getElementById('coffee-emails');
+    const progress = document.getElementById('setup-progress');
+    const count = document.getElementById('setup-count');
+    const roastDescription = document.getElementById('roast-description');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-subscription-preferences';
+
+    function updateSetup() {
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(frequency)) + Number(roast.validity.valid);
+      const percent = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percent}%`;
+      count.textContent = `${completed} of 3 ready · ${percent}%`;
+      const description = roastNames[Number(roast.value) - 1];
+      roastDescription.value = description;
+      roast.setAttribute('aria-valuetext', description);
+      roast.style.setProperty('--range-fill', `${(Number(roast.value) - 1) / 4 * 100}%`);
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        if (['1', '2', '3', '4', '5'].includes(saved.roast)) roast.value = saved.roast;
+        const frequency = Array.from(form.querySelectorAll('input[name="frequency"]'))
+          .find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        emails.checked = saved.emailUpdates === true;
+        status.textContent = 'Your saved preferences have been restored. You can update them anytime.';
+      }
+    } catch {
+      // The form remains usable when storage is unavailable or saved data is invalid.
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          email: email.value.trim(),
+          frequency: frequency.value,
+          roast: roast.value,
+          emailUpdates: emails.checked
+        }));
+        status.textContent = 'Preferences saved on this device. No order has been placed and no emails have been activated.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow site storage and try again.';
+      }
+    });
+    updateSetup();
+  </script>
+
