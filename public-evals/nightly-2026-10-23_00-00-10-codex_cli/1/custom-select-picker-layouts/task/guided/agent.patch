+  <script>
+    const roastSelect = document.getElementById('roast');
+    const orderLink = document.getElementById('order-now');
+    const roasts = [
+      { value: 'light', name: 'Light roast', notes: 'Bright & delicate', photo: 'photo-1447933601403-0c6688de566e' },
+      { value: 'medium', name: 'Medium roast', notes: 'Smooth & balanced', photo: 'photo-1442512595331-e89e73853f31' },
+      { value: 'dark', name: 'Dark roast', notes: 'Bold & full-bodied', photo: 'photo-1514432324607-a09d9b4aefdd' }
+    ];
+
+    function cardContent(roast) {
+      return `<img src="https://images.unsplash.com/${roast.photo}?auto=format&fit=crop&w=240&q=80" alt="" width="120" height="80"><span class="roast-name">${roast.name}</span><span class="roast-notes">${roast.notes}</span>`;
+    }
+
+    roastSelect.addEventListener('change', () => {
+      orderLink.href = `/order-online?roast=${encodeURIComponent(roastSelect.value)}`;
+    });
+
+    if (CSS.supports('appearance', 'base-select')) {
+      // Keep the closed control concise; rich content belongs to the open picker.
+      const selectedButton = document.createElement('button');
+      selectedButton.type = 'button';
+      selectedButton.append(document.createElement('selectedcontent'));
+      roastSelect.prepend(selectedButton);
+      Array.from(roastSelect.options).forEach((option, index) => {
+        option.className = 'roast-card';
+        option.setAttribute('aria-label', roasts[index].name);
+        option.innerHTML = cardContent(roasts[index]);
+      });
+    } else {
+      // Preserve the three-column media picker where customizable select is unavailable.
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.textContent = 'Medium roast';
+      trigger.setAttribute('role', 'combobox');
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-menu');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.hidden = true;
+      menu.setAttribute('role', 'listbox');
+      menu.setAttribute('aria-labelledby', 'roast-label');
+      menu.setAttribute('aria-orientation', 'horizontal');
+
+      function closePicker(returnFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (returnFocus) trigger.focus();
+      }
+
+      const cards = roasts.map((roast) => {
+        const card = document.createElement('div');
+        card.className = 'roast-card';
+        card.setAttribute('role', 'option');
+        card.setAttribute('aria-label', roast.name);
+        card.setAttribute('aria-selected', String(roast.value === roastSelect.value));
+        card.tabIndex = -1;
+        card.innerHTML = cardContent(roast);
+        card.addEventListener('click', () => {
+          roastSelect.value = roast.value;
+          roastSelect.dispatchEvent(new Event('change', { bubbles: true }));
+          trigger.textContent = roast.name;
+          cards.forEach((item) => item.setAttribute('aria-selected', String(item === card)));
+          closePicker(true);
+        });
+        menu.append(card);
+        return card;
+      });
+
+      function openPicker() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[roasts.findIndex((roast) => roast.value === roastSelect.value)].focus();
+      }
+
+      trigger.addEventListener('click', () => menu.hidden ? openPicker() : closePicker());
+      trigger.addEventListener('keydown', (event) => {
+        if (['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
+          event.preventDefault();
+          openPicker();
+        }
+      });
+      menu.addEventListener('keydown', (event) => {
+        const index = cards.indexOf(document.activeElement);
+        let next = index;
+        if (['ArrowRight', 'ArrowDown'].includes(event.key)) next = (index + 1) % cards.length;
+        else if (['ArrowLeft', 'ArrowUp'].includes(event.key)) next = (index + cards.length - 1) % cards.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = cards.length - 1;
+        else if (event.key === 'Escape') { event.preventDefault(); closePicker(true); return; }
+        else if (['Enter', ' '].includes(event.key)) { event.preventDefault(); cards[index].click(); return; }
+        else if (event.key.length === 1) {
+          const match = roasts.findIndex((roast) => roast.name.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match < 0) return;
+          next = match;
+        } else return;
+        event.preventDefault();
+        cards[next].focus();
+      });
+
+      const picker = roastSelect.parentElement;
+      picker.append(trigger, menu);
+      roastSelect.hidden = true;
+      document.getElementById('roast-label').htmlFor = trigger.id;
+      document.addEventListener('pointerdown', (event) => {
+        if (!picker.contains(event.target)) closePicker();
+      });
+      picker.addEventListener('focusout', (event) => {
+        if (!picker.contains(event.relatedTarget)) closePicker();
+      });
+    }
+  </script>
