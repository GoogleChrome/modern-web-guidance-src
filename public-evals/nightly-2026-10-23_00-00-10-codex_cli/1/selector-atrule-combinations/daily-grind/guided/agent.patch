+const $ = (s) => document.querySelector(s);
+const defaults = ['.card.featured', '@media (min-width: 768px)'];
+let conditions = [...defaults];
+let mode = 'intersection';
+let generated = '';
+let dark = false;
+const initialStyles = 'background: #ede9fe;\nborder-color: #8b5cf6;';
+const samples = [...document.querySelectorAll('.sample-card')];
+function toast(message) {
+  $('#toast').textContent = message; $('#toast').classList.add('visible');
+  clearTimeout(toast.timer); toast.timer = setTimeout(() => $('#toast').classList.remove('visible'), 2600);
+}
+function renderConditions() {
+  const host = $('#conditions'); host.replaceChildren();
+  conditions.forEach((value, i) => {
+    if (i) { const join = document.createElement('div'); join.className = 'condition-join'; join.textContent = mode === 'intersection' ? 'AND' : 'OR'; host.append(join); }
+    const row = document.createElement('div'); row.className = 'condition-row';
+    const type = document.createElement('span'); type.className = 'condition-type'; type.textContent = value.trim().startsWith('@') ? '@' : '.';
+    const input = document.createElement('input'); input.value = value; input.setAttribute('aria-label', `Condition ${i + 1}`); input.spellcheck = false;
+    input.addEventListener('input', () => { conditions[i] = input.value; type.textContent = input.value.trim().startsWith('@') ? '@' : '.'; update(); });
+    const remove = document.createElement('button'); remove.textContent = '×'; remove.setAttribute('aria-label', `Remove condition ${i + 1}`);
+    remove.addEventListener('click', () => { conditions.splice(i, 1); renderConditions(); update(); });
+    row.append(type, input, remove); host.append(row);
+  });
+  $('#condition-count').textContent = `${conditions.length} condition${conditions.length === 1 ? '' : 's'}`;
+}
+function parseCondition(raw) {
+  const value = raw.trim();
+  if (!value) throw new Error('Enter a selector or conditional @-rule.');
+  if (!value.startsWith('@')) {
+    if (!CSS.supports(`selector(${value})`)) throw new Error('Check your CSS selector syntax.');
+    return { type: 'selector', value };
+  }
+  const rule = value.match(/^@(media|supports)\s+(.+)$/s);
+  if (!rule) throw new Error('Use a selector, @media, or @supports condition.');
+  if (/[{};]/.test(rule[2])) throw new Error('Enter a condition without braces or declarations.');
+  if (rule[1] === 'media' && matchMedia(rule[2]).media === 'not all' && rule[2] !== 'not all') throw new Error('Check your media query syntax.');
+  return { type: rule[1], value, query: rule[2] };
+}
+function evaluate(condition, element) {
+  if (condition.type === 'selector') return element.matches(condition.value);
+  if (condition.type === 'supports') return CSS.supports(condition.query);
+  const width = Math.max(320, Math.min(1920, Number($('#viewport').value) || 1024));
+  let query = condition.query.replace(/\((min|max)-width\s*:\s*([\d.]+)(px|em|rem)\s*\)/g, (_, bound, n, unit) => {
+    const size = Number(n) * (unit === 'px' ? 1 : 16);
+    return (bound === 'min' ? width >= size : width <= size) ? '(min-width: 0px)' : '(max-width: 0px)';
+  });
+  query = query.replace(/\(width\s*(>=|<=|>|<|=)\s*([\d.]+)px\)/g, (_, op, n) => {
+    const val = Number(n); const ok = op === '>=' ? width >= val : op === '<=' ? width <= val : op === '>' ? width > val : op === '<' ? width < val : width === val;
+    return ok ? '(min-width: 0px)' : '(max-width: 0px)';
+  });
+  query = query.replace(/\(prefers-color-scheme:\s*(dark|light)\)/g, (_, theme) => (dark === (theme === 'dark') ? '(min-width: 0px)' : '(max-width: 0px)'));
+  return matchMedia(query).matches;
+}
+function compose(parsed, declarations) {
+  const selectors = parsed.filter(x => x.type === 'selector');
+  const atRules = parsed.filter(x => x.type !== 'selector');
+  const styles = declarations.split('\n').filter(x => x.trim()).map(x => x.trim()).join('\n');
+  const indent = (value, n = 1) => value.split('\n').map(line => '  '.repeat(n) + line).join('\n');
+  if (mode === 'intersection') {
+    const selector = selectors.length ? selectors.map(x => `:is(${x.value})`).join('') : '.card';
+    const compact = selectors.length === 1 ? selectors[0].value : selector;
+    let code = `${compact} {\n${indent(styles)}\n}`;
+    atRules.slice().reverse().forEach(rule => { code = `${rule.value} {\n${indent(code)}\n}`; });
+    return code;
+  }
+  if (!atRules.length) return `${selectors.map(x => x.value).join(',\n') || '.card'} {\n${indent(styles)}\n}`;
+  // A union across element selectors and environment conditions must retain per-element matching.
+  // Gate environment branches once; keep selector branches independent.
+  if (selectors.length) {
+    return `/* Selector matches */\n${selectors.map(x => x.value).join(',\n')} {\n${indent(styles)}\n}\n\n/* Environment matches */\n:root { --compound-match: false; }\n${atRules.map(rule => `${rule.value} {\n  :root { --compound-match: true; }\n}`).join('\n')}\n@container style(--compound-match: true) {\n  .card {\n${indent(styles, 2)}\n  }\n}`;
+  }
+  return `:root { --compound-match: false; }\n${atRules.map(rule => `${rule.value} {\n  :root { --compound-match: true; }\n}`).join('\n')}\n\n@container style(--compound-match: true) {\n  .card {\n${indent(styles, 2)}\n  }\n}`;
+}
+function update() {
+  let parsed; let error = '';
+  try { parsed = conditions.map(parseCondition); } catch (e) { error = e.message; }
+  const styles = $('#declarations').value;
+  if (!error && /[{}<>]/.test(styles)) error = 'Use CSS declarations without braces.';
+  if (!error) {
+    const scratch = document.createElement('div'); scratch.style.cssText = styles;
+    if (styles.trim() && !scratch.style.length) error = 'Enter valid CSS declarations.';
+  }
+  $('#valid-status').textContent = error || 'Your rule is ready to go.';
+  $('#valid-status').style.color = error ? '#b86a76' : '';
+  let count = 0;
+  samples.forEach(el => {
+    let matched = false;
+    if (!error) matched = parsed.length === 0 || (mode === 'intersection' ? parsed.every(x => evaluate(x, el)) : parsed.some(x => evaluate(x, el)));
+    el.classList.toggle('matched', matched); el.removeAttribute('style');
+    if (matched) { el.style.cssText = styles; count++; }
+  });
+  $('#match-count').textContent = `${count} of 4`;
+  $('#canvas-width').textContent = `${$('#viewport').value || 1024} × auto`;
+  if (!error) generated = compose(parsed, styles);
+  const code = error ? `/* ${error} */` : generated;
+  $('#generated-code').textContent = code;
+  $('#code-lines').textContent = code.split('\n').map((_, i) => i + 1).join('\n');
+  document.querySelectorAll('[data-width]').forEach(b => b.classList.toggle('active', b.dataset.width === $('#viewport').value));
+}
+document.querySelectorAll('[data-mode]').forEach(button => button.addEventListener('click', () => {
+  mode = button.dataset.mode;
+  document.querySelectorAll('[data-mode]').forEach(b => b.classList.toggle('active', b === button));
+  $('#mode-help').innerHTML = mode === 'intersection' ? 'Match elements that meet <strong>all</strong> of the conditions.' : 'Match elements that meet <strong>any</strong> of the conditions.';
+  renderConditions(); update();
+}));
+$('#add-condition').addEventListener('click', () => { conditions.push('.card'); renderConditions(); update(); $('#conditions').lastElementChild.querySelector('input').focus(); });
+$('#declarations').addEventListener('input', update);
+$('#viewport').addEventListener('input', update);
+$('#viewport').addEventListener('change', () => { $('#viewport').value = Math.max(320, Math.min(1920, Number($('#viewport').value) || 1024)); update(); });
+document.querySelectorAll('[data-width]').forEach(button => button.addEventListener('click', () => { $('#viewport').value = button.dataset.width; update(); }));
+$('#dark-toggle').addEventListener('click', () => { dark = !dark; $('.preview').classList.toggle('dark', dark); $('#dark-toggle').setAttribute('aria-pressed', dark); $('#dark-toggle').textContent = dark ? '☾' : '☼'; update(); });
+$('#reset').addEventListener('click', () => { conditions = [...defaults]; $('#declarations').value = initialStyles; $('#viewport').value = '1024'; if (dark) $('#dark-toggle').click(); showPage('playground'); document.querySelector('[data-mode="intersection"]').click(); toast('Playground reset'); });
+$('#copy').addEventListener('click', async () => {
+  try { await navigator.clipboard.writeText(generated); toast('CSS copied to clipboard'); } catch { const range = document.createRange(); range.selectNodeContents($('#generated-code')); const selection = getSelection(); selection.removeAllRanges(); selection.addRange(range); toast('CSS selected. Press Ctrl/Cmd+C to copy.'); }
+});
+function getSaved() { try { return JSON.parse(localStorage.getItem('compound-snippets') || '[]'); } catch { return []; } }
+$('#save').addEventListener('click', () => {
+  const saved = getSaved(); saved.unshift({ name: `Untitled snippet ${saved.length + 1}`, conditions: [...conditions], mode, styles: $('#declarations').value, code: generated });
+  try { localStorage.setItem('compound-snippets', JSON.stringify(saved)); toast('Snippet saved to your workspace'); } catch { toast('Storage is unavailable. Copy your CSS to keep it.'); }
+});
+const examples = [
+  { name: 'The perfect intersection', description: 'Featured cards, only when there’s room to shine.', symbol: '∩', conditions: [...defaults], mode: 'intersection' },
+  { name: 'A little more inclusive', description: 'One set of styles for featured or default cards.', symbol: '∪', conditions: ['.card.featured', '.card:not(.featured)'], mode: 'union' },
+  { name: 'After dark', description: 'Let featured elements adapt to a dark environment.', symbol: '☾', conditions: ['.card.featured', '@media (prefers-color-scheme: dark)'], mode: 'intersection' }
+];
+function loadExample(example) { conditions = [...example.conditions]; $('#declarations').value = example.styles || initialStyles; showPage('playground'); document.querySelector(`[data-mode="${example.mode}"]`).click(); if (example.name === 'After dark' && !dark) $('#dark-toggle').click(); toast('Example loaded — make it your own'); }
+function showPage(page) {
+  document.querySelectorAll('[data-page]').forEach(b => b.classList.toggle('selected', b.dataset.page === page));
+  $('#breadcrumb').textContent = { playground: 'Playground', saved: 'Saved snippets', examples: 'Examples', guide: 'Quick guide' }[page];
+  $('#playground-view').hidden = page !== 'playground'; $('#secondary-view').hidden = page === 'playground';
+  const host = $('#secondary-view'); host.replaceChildren();
+  if (page === 'examples') {
+    const list = document.createElement('div'); list.className = 'example-list';
+    examples.forEach(ex => { const card = document.createElement('article'); card.className = 'secondary-card example-card'; const symbol = document.createElement('span'); symbol.className = 'example-symbol'; symbol.textContent = ex.symbol; const title = document.createElement('h2'); title.textContent = ex.name; const text = document.createElement('p'); text.textContent = ex.description; const button = document.createElement('button'); button.className = 'button'; button.textContent = 'Open in playground →'; button.onclick = () => loadExample(ex); card.append(symbol, title, text, button); list.append(card); }); host.append(list);
+  }
+  if (page === 'saved') {
+    const saved = getSaved();
+    if (!saved.length) { const card = document.createElement('div'); card.className = 'secondary-card'; card.innerHTML = '<h2>Your next great rule starts here.</h2><p>Save a snippet from the playground and it will appear in this workspace.</p><button class="button">Back to playground →</button>'; card.querySelector('button').onclick = () => showPage('playground'); host.append(card); }
+    saved.forEach((entry, i) => { const card = document.createElement('article'); card.className = 'secondary-card'; const title = document.createElement('h2'); title.textContent = entry.name; const code = document.createElement('pre'); code.className = 'saved-code'; code.textContent = entry.code; const button = document.createElement('button'); button.className = 'button'; button.textContent = 'Load snippet →'; button.onclick = () => loadExample(entry); const remove = document.createElement('button'); remove.className = 'button'; remove.textContent = 'Delete snippet'; remove.style.marginTop = '8px'; remove.onclick = () => { const next = getSaved(); next.splice(i, 1); localStorage.setItem('compound-snippets', JSON.stringify(next)); showPage('saved'); }; card.append(title, code, button, remove); host.append(card); });
+  }
+  if (page === 'guide') {
+    const card = document.createElement('article'); card.className = 'secondary-card'; card.innerHTML = '<h2>A little logic goes a long way.</h2><p><strong>1. Choose your logic.</strong> Intersection requires every condition to match the same element. Union matches when any condition is true.</p><p><strong>2. Add your conditions.</strong> Use CSS selectors such as <code>.card.featured</code>, viewport conditions such as <code>@media (min-width: 768px)</code>, or feature checks such as <code>@supports (display: grid)</code>.</p><p><strong>3. Write styles once.</strong> Enter CSS declarations, then adjust the simulated viewport or color scheme to explore matching elements.</p><p><strong>4. Take your CSS with you.</strong> Copy the generated CSS, or save a snippet locally. Mixed union rules use a custom property on an ancestor and container style queries; use a modern browser supporting style queries. Default card styles remain available as a fallback.</p><p>The preview evaluates selectors against four sample cards. Viewport width and color scheme are simulated; other media features use your current device. Generated CSS runs against the real page environment.</p><button class="button">Start experimenting →</button>'; card.querySelector('button').onclick = () => showPage('playground'); host.append(card);
+  }
+}
+document.querySelectorAll('[data-page]').forEach(b => b.addEventListener('click', () => showPage(b.dataset.page)));
+$('#explore').onclick = () => showPage('examples');
+$('#try-example').onclick = () => loadExample(examples[1]);
