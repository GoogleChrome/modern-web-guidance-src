diff --git a/media.js b/media.js
new file mode 100644
index 0000000..de6bcdf
--- /dev/null
+++ b/media.js
@@ -0,0 +1,67 @@
+// Author offscreen URLs as data attributes so the preload scanner cannot fetch
+// posters or media headers, even in browsers without native media lazy loading.
+const deferredMedia = document.querySelectorAll('[data-deferred-media]');
+
+function activateMedia(media) {
+  if (!media.hasAttribute('data-deferred-media')) return;
+  media.removeAttribute('data-deferred-media');
+
+  if (media.dataset.poster) {
+    media.setAttribute('poster', media.dataset.poster);
+    delete media.dataset.poster;
+  }
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+  media.preload = media.dataset.preload || 'metadata';
+  delete media.dataset.preload;
+  media.load();
+}
+
+if ('IntersectionObserver' in window) {
+  const observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting) continue;
+      activateMedia(entry.target);
+      observer.unobserve(entry.target);
+    }
+  }, { rootMargin: '200px 0px' });
+
+  for (const media of deferredMedia) {
+    observer.observe(media);
+    // Keyboard or pointer intent can also activate a player immediately.
+    media.addEventListener('focusin', () => {
+      activateMedia(media);
+      observer.unobserve(media);
+    }, { once: true });
+  }
+} else {
+  // Older browsers still defer downloads, rather than loading every asset.
+  let scheduled = false;
+  function checkMedia() {
+    scheduled = false;
+    for (const media of deferredMedia) {
+      if (!media.hasAttribute('data-deferred-media')) continue;
+      const bounds = media.getBoundingClientRect();
+      if (bounds.top <= window.innerHeight + 200 && bounds.bottom >= -200) {
+        activateMedia(media);
+      }
+    }
+    if (![...deferredMedia].some(media => media.hasAttribute('data-deferred-media'))) {
+      window.removeEventListener('scroll', scheduleCheck);
+      window.removeEventListener('resize', scheduleCheck);
+    }
+  }
+  function scheduleCheck() {
+    if (scheduled) return;
+    scheduled = true;
+    window.requestAnimationFrame(checkMedia);
+  }
+  window.addEventListener('scroll', scheduleCheck, { passive: true });
+  window.addEventListener('resize', scheduleCheck);
+  for (const media of deferredMedia) {
+    media.addEventListener('focusin', () => activateMedia(media), { once: true });
+  }
+  checkMedia();
+}
