+  <script>
+    (() => {
+      const players = [...document.querySelectorAll('[data-lazy-media]')];
+      const loadPlayer = (player) => {
+        if (!player.hasAttribute('data-lazy-media')) return;
+        player.removeAttribute('data-lazy-media');
+        if (player.dataset.poster) {
+          player.poster = player.dataset.poster;
+          delete player.dataset.poster;
+        }
+        player.querySelectorAll('source[data-src]').forEach((source) => {
+          source.src = source.dataset.src;
+          delete source.dataset.src;
+        });
+        // Metadata is allowed only after the player approaches the viewport.
+        player.preload = 'metadata';
+        player.load();
+      };
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              loadPlayer(entry.target);
+              observer.unobserve(entry.target);
+            }
+          });
+        }, { rootMargin: '200px 0px', threshold: 0 });
+        players.forEach((player) => observer.observe(player));
+      } else {
+        // Retain deferred downloads in browsers without IntersectionObserver.
+        const checkPosition = () => {
+          players.filter((player) => player.hasAttribute('data-lazy-media')).forEach((player) => {
+            const rect = player.getBoundingClientRect();
+            if (rect.bottom >= -200 && rect.top <= window.innerHeight + 200) loadPlayer(player);
+          });
+          if (players.every((player) => !player.hasAttribute('data-lazy-media'))) {
+            window.removeEventListener('scroll', checkPosition);
+            window.removeEventListener('resize', checkPosition);
+          }
+        };
+        window.addEventListener('scroll', checkPosition, { passive: true });
+        window.addEventListener('resize', checkPosition);
+        checkPosition();
+      }
+      // Keyboard users can activate a focused player before its observer fires.
+      players.forEach((player) => player.addEventListener('focus', () => loadPlayer(player), { once: true }));
+    })();
+  </script>
