+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchoring = CSS.supports('anchor-name: --rewards') && CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+
+    // Manual popovers stay open on outside clicks and Escape.
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+
+    // Follow scrolling, resizing, and layout shifts in browsers without CSS anchors.
+    if (!hasAnchoring) {
+      const trackRewards = () => {
+        if (!tourOpen) return;
+        const target = rewardsLink.getBoundingClientRect();
+        const width = tourStep.getBoundingClientRect().width;
+        tourStep.style.top = `${target.bottom + 14}px`;
+        tourStep.style.left = `${Math.max(12, Math.min(target.right - width, document.documentElement.clientWidth - width - 12))}px`;
+        requestAnimationFrame(trackRewards);
+      };
+      trackRewards();
+    }
+
+    closeTour.focus({ preventScroll: true });
+
+    const preventTourNavigation = (event) => {
+      if (tourOpen) event.preventDefault();
+    };
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      if (!hasPopover) tourStep.hidden = true;
+      rewardsLink.removeAttribute('aria-describedby');
+      rewardsLink.focus({ preventScroll: true });
+    });
+  </script>
