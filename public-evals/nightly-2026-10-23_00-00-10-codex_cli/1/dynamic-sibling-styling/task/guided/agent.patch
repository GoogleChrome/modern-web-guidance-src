+  <script>
+    // Older browsers get the same live count/index values; modern browsers use CSS alone.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const groups = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const updateGroup = (group) => {
+        const items = Array.from(group.children);
+        items.forEach((item, index) => {
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      };
+      groups.forEach((group) => {
+        updateGroup(group);
+        new MutationObserver(() => updateGroup(group)).observe(group, { childList: true });
+      });
+    }
+  </script>
