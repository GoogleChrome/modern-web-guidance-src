+<script>
+    // Keep fallback indices current for every group, including runtime edits.
+    // Native sibling functions take precedence wherever they are supported.
+    const groups = [
+      ['.grid', '.spectrum-card'],
+      ['.fan-container', '.fan-card'],
+      ['.circle-container', '.circle-orb']
+    ];
+    function updateCollections() {
+      for (const [containerSelector, itemSelector] of groups) {
+        document.querySelectorAll(containerSelector).forEach(container => {
+          const items = [...container.children].filter(item => item.matches(itemSelector));
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index);
+            item.style.setProperty('--item-count', items.length);
+          });
+        });
+      }
+    }
+    if (!CSS.supports('order', 'sibling-index()')) {
+      updateCollections();
+      new MutationObserver(updateCollections).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true,
+        attributes: true,
+        attributeFilter: ['class']
+      });
+    }
+  </script>
 </body>
 
