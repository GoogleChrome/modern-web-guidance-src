+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Native anchor positioning handles scrolling, resizing, and edge flips.
+    // Older browsers still get a tethered, viewport-constrained popover.
+    if (!CSS.supports("position-area", "block-end span-inline-end") ||
+        !CSS.supports("position-try-fallbacks", "flip-block, flip-inline, flip-block flip-inline")) {
+      const trigger = document.getElementById("trigger-btn");
+      const panel = document.getElementById("action-panel");
+      let open = false;
+
+      function positionPanel() {
+        if (!open) return;
+        const gap = 8;
+        const viewport = window.visualViewport;
+        const x = viewport?.offsetLeft ?? 0;
+        const y = viewport?.offsetTop ?? 0;
+        const right = x + (viewport?.width ?? document.documentElement.clientWidth);
+        const bottom = y + (viewport?.height ?? document.documentElement.clientHeight);
+        const anchor = trigger.getBoundingClientRect();
+        panel.style.margin = "0";
+        panel.style.maxWidth = `${Math.max(0, right - x - gap * 2)}px`;
+        const below = Math.max(0, bottom - anchor.bottom - gap * 2);
+        const above = Math.max(0, anchor.top - y - gap * 2);
+        const goAbove = panel.scrollHeight + 2 > below && above > below;
+        panel.style.maxHeight = `${goAbove ? above : below}px`;
+        const { width, height } = panel.getBoundingClientRect();
+        const left = anchor.left + width > right - gap ? anchor.right - width : anchor.left;
+        const top = goAbove ? anchor.top - gap - height : anchor.bottom + gap;
+        panel.style.left = `${Math.max(x + gap, Math.min(left, right - width - gap))}px`;
+        panel.style.top = `${Math.max(y + gap, Math.min(top, bottom - height - gap))}px`;
+      }
+
+      panel.addEventListener("toggle", (event) => {
+        open = event.newState === "open";
+        positionPanel();
+      });
+      window.addEventListener("resize", positionPanel);
+      document.addEventListener("scroll", positionPanel, true);
+      window.visualViewport?.addEventListener("resize", positionPanel);
+      window.visualViewport?.addEventListener("scroll", positionPanel);
+      const observer = new ResizeObserver(positionPanel);
+      observer.observe(trigger);
+      observer.observe(panel);
+    }
+  </script>
