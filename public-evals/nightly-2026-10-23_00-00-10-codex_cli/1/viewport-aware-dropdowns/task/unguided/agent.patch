+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const supportsAnchors = CSS.supports('top', 'anchor(bottom)') &&
+      CSS.supports('position-try-fallbacks', 'flip-block, flip-inline');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const rect = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? innerWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? innerHeight) - 16;
+      const below = Math.max(0, bottomEdge - rect.bottom);
+      const above = Math.max(0, rect.top - topEdge);
+
+      // Scroll long panels within the larger available side of the trigger.
+      panel.style.setProperty('--available-height', `${Math.max(above, below)}px`);
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+
+      // Native anchors handle normal layout. Use viewport coordinates where
+      // anchors are unavailable or a zoomed visual viewport needs correction.
+      if (!supportsAnchors || (viewport && viewport.scale !== 1)) {
+        const { width, height } = panel.getBoundingClientRect();
+        const flipUp = height > below && above > below;
+        const left = rect.left + width > rightEdge ? rect.right - width : rect.left;
+        const top = flipUp ? rect.top - height : rect.bottom;
+        panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - width))}px`;
+        panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`;
+      } else {
+        panel.style.removeProperty('left');
+        panel.style.removeProperty('top');
+      }
+    }
+
+    let positionFrame;
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('toggle', () => {
+      const open = panel.matches(':popover-open');
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) positionPanel();
+    });
+    window.addEventListener('resize', schedulePosition);
+    document.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const observer = new ResizeObserver(schedulePosition);
+    observer.observe(trigger);
+    observer.observe(panel);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
