+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const origins = Array.from(scroller.querySelectorAll('[data-origin]'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollTimer;
+
+    function onScrollEnd() {
+      if (!scrolling) return;
+
+      // Read geometry only after scrolling settles, before updating the DOM.
+      const bounds = scroller.getBoundingClientRect();
+      const left = bounds.left + scroller.clientLeft;
+      const top = bounds.top + scroller.clientTop;
+      const right = left + scroller.clientWidth;
+      const bottom = top + scroller.clientHeight;
+      let mostVisible = origins[0];
+      let largestArea = -1;
+
+      for (const origin of origins) {
+        const rect = origin.getBoundingClientRect();
+        const width = Math.max(0, Math.min(rect.right, right) - Math.max(rect.left, left));
+        const height = Math.max(0, Math.min(rect.bottom, bottom) - Math.max(rect.top, top));
+        const area = width * height;
+        if (area > largestArea) {
+          largestArea = area;
+          mostVisible = origin;
+        }
+      }
+
+      scrolling = false;
+      status.textContent = `Scroll ended. Visible: ${mostVisible.dataset.origin}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      // One status write per gesture; no layout reads in the active handler.
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(onScrollEnd, 180);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', onScrollEnd);
+    }
+  </script>
+
