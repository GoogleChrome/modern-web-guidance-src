+        reveal();
+      };
+      const reveal = () => {
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', reveal, { once: true });
+          return;
+        }
+        if (finished) return;
+        finished = true;
+        clearTimeout(timer);
+        document.documentElement.classList.remove('experiment-pending');
+      };
+      // SDK integrations dispatch this after their final DOM changes.
+      window.addEventListener('experiment:ready', reveal, { once: true });
+      const loaded = () => {
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', loaded, { once: true });
+          return;
+        }
+        // Synchronous SDKs may finish their DOM changes before the load event.
+        const title = document.querySelector('[data-hero-title]');
+        const cta = document.querySelector('[data-hero-cta] span');
+        if (title && cta && (title.textContent !== 'Good work.Great company.' || cta.textContent !== 'Find your space')) reveal();
+      };
+      window.gatherExperiment = { ready: reveal, fallback, loaded };
+      document.addEventListener('DOMContentLoaded', () => { if (!finished) timer = setTimeout(fallback, 1400); });
+    })();
