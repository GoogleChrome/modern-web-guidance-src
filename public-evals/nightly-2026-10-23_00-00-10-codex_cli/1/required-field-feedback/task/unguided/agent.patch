@@ -197,8 +253,20 @@
     </section>
   </main>
 
   <footer>
+    <form class="mailing-list" id="mailing-list" novalidate>
+      <h2>Join our mailing list</h2>
+      <p>A little coffee news, straight to your inbox.</p>
+      <label for="mailing-list-email">Email address (required)</label>
+      <div class="mailing-list-controls">
+        <input id="mailing-list-email" name="email" type="email" autocomplete="email" required
+          aria-describedby="mailing-list-error">
+        <button class="btn" type="submit">Join mailing list</button>
+      </div>
