@@ -206,7 +281,40 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-email-error');
+    const mailingListStatus = document.getElementById('mailing-list-status');
+
+    function validateEmail() {
+      emailError.textContent = email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address.';
+      if (email.validity.valid) {
+        email.removeAttribute('aria-invalid');
+      } else {
+        email.setAttribute('aria-invalid', 'true');
+      }
+    }
+
+    email.addEventListener('blur', validateEmail);
+    email.addEventListener('input', () => {
+      email.removeAttribute('aria-invalid');
+      mailingListStatus.textContent = '';
+    });
+    email.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      validateEmail();
+      email.focus();
+    });
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      mailingListStatus.textContent = 'Mailing list sign-ups are not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
