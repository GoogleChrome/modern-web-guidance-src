+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsStickyFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let scrollFramePending = false;
+
+    function updateStickyHeaders() {
+      for (const container of stickyContainers) {
+        const bounds = container.getBoundingClientRect();
+        container.classList.toggle('is-stuck', Math.abs(bounds.top - navigationHeight) <= 0.5);
+      }
+      scrollFramePending = false;
+    }
+
+    function updateNavigationHeight() {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      if (needsStickyFallback) updateStickyHeaders();
+    }
+
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    updateNavigationHeight();
+
+    if (needsStickyFallback) {
+      window.addEventListener('scroll', () => {
+        if (!scrollFramePending) {
+          scrollFramePending = true;
+          requestAnimationFrame(updateStickyHeaders);
+        }
+      }, { passive: true });
+      window.addEventListener('resize', updateStickyHeaders);
+    }
+  </script>
+
