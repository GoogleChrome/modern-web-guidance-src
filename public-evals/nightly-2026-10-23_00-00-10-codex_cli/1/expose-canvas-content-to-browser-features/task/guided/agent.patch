+      function schedule() {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(resize);
+      }
+      if (nativeCanvas) canvas.onpaint = paint;
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(schedule);
+        observer.observe(stage);
+        observer.observe(form);
+      }
+      window.addEventListener('resize', schedule);
+      window.addEventListener('beforeprint', () => { useOverlay(); resize(); });
+      // Monitor changes in display density even when CSS dimensions do not change.
+      function watchDensity() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => { schedule(); watchDensity(); }, { once: true });
+      }
+      watchDensity();
+      new MutationObserver(schedule).observe(form, { subtree: true, childList: true, characterData: true, attributes: true });
+      form.addEventListener('input', () => {
+        recipe.textContent = `${milk.selectedOptions[0].textContent} · ${syrup.selectedOptions[0].textContent}`;
+        status.textContent = '';
+        schedule();
+      });
+      form.addEventListener('focusin', schedule);
+      form.addEventListener('focusout', schedule);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.textContent = `Customized for ${form.elements.customerName.value.trim() || 'you'}! Your coffee: ${recipe.textContent}.`;
+        schedule();
+      });
+      schedule();
+    })();
+  </script>
