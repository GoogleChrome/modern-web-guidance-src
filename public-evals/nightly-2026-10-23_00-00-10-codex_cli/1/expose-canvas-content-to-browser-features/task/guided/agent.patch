+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const slot = stage.querySelector('.coffee-slot');
+      const layout = stage.querySelector('.coffee-layout');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const recipe = document.getElementById('coffee-recipe');
+      const status = document.getElementById('coffee-status');
+      const ctx = canvas.getContext('2d');
+      let nativeCanvas = !!ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+      let uiWidth = 0;
+      let uiHeight = 0;
+      let x = 0;
+      let y = 0;
+      let frame;
+
+      function useOverlay() {
+        nativeCanvas = false;
+        canvas.onpaint = null;
+        slot.append(form);
+        stage.classList.remove('native-canvas');
+        canvas.removeAttribute('content');
+        canvas.setAttribute('aria-hidden', 'true');
+      }
+
+      // Keep a single live form: never replace inputs with a bitmap or duplicate controls.
+      if (nativeCanvas) {
+        stage.style.setProperty('--ui-width', `${form.offsetWidth}px`);
+        stage.style.setProperty('--ui-height', `${form.offsetHeight}px`);
+        stage.classList.add('native-canvas');
+        canvas.append(form);
+      } else {
+        useOverlay();
+      }
+
+      function drawCup() {
+        if (!ctx) return;
+        const width = canvas.clientWidth;
+        const height = canvas.clientHeight;
+        if (!width || !height) return;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        const left = x - 18;
+        const right = x + uiWidth + 18;
+        const bottom = y + uiHeight + 25;
+        // Saucer, handle, and cup are decorative; all meaningful text stays in HTML.
+        ctx.fillStyle = '#ded0c1';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, bottom + 14, Math.min(width / 2 - 6, uiWidth / 2 + 50), 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#c2a58d';
+        ctx.lineWidth = 15;
+        ctx.beginPath();
+        ctx.ellipse(right - 2, y + 65, Math.max(12, Math.min(34, width - right - 14)), 48, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        const ceramic = ctx.createLinearGradient(left, 0, right, 0);
+        ceramic.addColorStop(0, '#e6d6c4');
+        ceramic.addColorStop(0.3, '#fffaf2');
+        ceramic.addColorStop(1, '#ebdac5');
+        ctx.fillStyle = ceramic;
+        ctx.strokeStyle = '#c2a58d';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(left, 76);
+        ctx.lineTo(left + 8, bottom - 22);
+        ctx.quadraticCurveTo(left + 8, bottom, left + 30, bottom);
+        ctx.lineTo(right - 30, bottom);
+        ctx.quadraticCurveTo(right - 8, bottom, right - 8, bottom - 22);
+        ctx.lineTo(right, 76);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = '#fdf5e8';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, 76, (right - left) / 2, 21, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = { whole: '#b88a62', oat: '#c49b70', almond: '#cba77e', none: '#593a29' }[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(width / 2, 76, (right - left) / 2 - 9, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#bca18a';
+        ctx.lineWidth = 2;
+        for (const offset of [-25, 0, 25]) {
+          ctx.beginPath();
+          ctx.moveTo(width / 2 + offset, 43);
+          ctx.bezierCurveTo(width / 2 + offset - 12, 30, width / 2 + offset + 12, 22, width / 2 + offset, 10);
+          ctx.stroke();
+        }
+      }
+
+      function paint() {
+        drawCup();
+        if (nativeCanvas) {
+          try {
+            // 2D drawing automatically aligns DOM hit testing and accessibility bounds.
+            ctx.drawElementImage(form, x, y, uiWidth, uiHeight);
+          } catch {
+            // Partial implementations must still expose a usable, searchable form.
+            useOverlay();
+            schedule();
+          }
+        }
+      }
+
+      function resize() {
+        const style = getComputedStyle(layout);
+        x = parseFloat(style.paddingLeft);
+        y = parseFloat(style.paddingTop);
+        uiWidth = layout.clientWidth - x - parseFloat(style.paddingRight);
+        stage.style.setProperty('--ui-width', `${uiWidth}px`);
+        uiHeight = form.offsetHeight;
+        stage.style.setProperty('--ui-height', `${uiHeight}px`);
+        const bounds = canvas.getBoundingClientRect();
+        const ratio = window.devicePixelRatio || 1;
+        const width = Math.max(1, Math.round(bounds.width * ratio));
+        const height = Math.max(1, Math.round(bounds.height * ratio));
+        if (canvas.width !== width) canvas.width = width;
+        if (canvas.height !== height) canvas.height = height;
