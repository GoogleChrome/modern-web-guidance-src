+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('coffee-form');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const name = document.getElementById('coffee-name');
+      const status = document.getElementById('blend-status');
+      const context = canvas.getContext('2d');
+
+      function drawCup() {
+        if (!context) return;
+        const bounds = stage.getBoundingClientRect();
+        const content = form.getBoundingClientRect();
+        if (!bounds.width || !bounds.height) return;
+        const ratio = window.devicePixelRatio || 1;
+        canvas.width = Math.round(bounds.width * ratio);
+        canvas.height = Math.round(bounds.height * ratio);
+        // Keep drawing coordinates in CSS pixels, using the actual backing-store scale.
+        context.setTransform(canvas.width / bounds.width, 0, 0,
+          canvas.height / bounds.height, 0, 0);
+        const x = content.left - bounds.left;
+        const y = content.top - bounds.top;
+        const width = content.width;
+        const height = content.height;
+
+        // All cup geometry comes from the HTML form's live layout, including translations.
+        context.fillStyle = '#ddd0c1';
+        context.beginPath();
+        context.ellipse(x + width / 2, y + height + 26, width / 2 + 18, 13, 0, 0, Math.PI * 2);
+        context.fill();
+
+        context.strokeStyle = '#b59b87';
+        context.lineWidth = 12;
+        context.beginPath();
+        context.ellipse(x + width - 2, y + height * 0.48, 27, 52, 0, 0, Math.PI * 2);
+        context.stroke();
+        context.strokeStyle = '#fffaf3';
+        context.lineWidth = 8;
+        context.stroke();
+
+        context.fillStyle = '#fffaf3';
+        context.strokeStyle = '#b59b87';
+        context.lineWidth = 2;
+        context.beginPath();
+        context.moveTo(x, y);
+        context.lineTo(x, y + height - 28);
+        context.quadraticCurveTo(x, y + height + 12, x + 40, y + height + 12);
+        context.lineTo(x + width - 40, y + height + 12);
+        context.quadraticCurveTo(x + width, y + height + 12, x + width, y + height - 28);
+        context.lineTo(x + width, y);
+        context.closePath();
+        context.fill();
+        context.stroke();
+
+        context.beginPath();
+        context.ellipse(x + width / 2, y, width / 2, 23, 0, 0, Math.PI * 2);
+        context.fill();
+        context.stroke();
+        context.fillStyle = { whole: '#b78c67', oat: '#c59a70', almond: '#bd9067', none: '#503025' }[milk.value];
+        context.beginPath();
+        context.ellipse(x + width / 2, y, Math.max(1, width / 2 - 10), 15, 0, 0, Math.PI * 2);
+        context.fill();
+        if (syrup.value !== 'none') {
+          context.strokeStyle = { vanilla: '#f4dfb1', caramel: '#96511e', maple: '#754125' }[syrup.value];
+          context.lineWidth = 3;
+          context.beginPath();
+          context.ellipse(x + width / 2, y, width / 5, 7, 0, 0, Math.PI * 2);
+          context.stroke();
+        }
+      }
+
+      form.addEventListener('input', () => {
+        document.getElementById('blend-milk').textContent = milk.selectedOptions[0].textContent;
+        document.getElementById('blend-syrup').textContent = syrup.selectedOptions[0].textContent;
+        status.textContent = '';
+        drawCup();
+      });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.replaceChildren();
+        if (name.value.trim()) {
+          const customer = document.createElement('span');
+          customer.translate = false;
+          customer.textContent = name.value.trim();
+          status.append(customer, document.createTextNode(': '));
+        }
+        const message = document.createElement('span');
+        message.textContent = 'Your blend is saved for this visit. No order has been placed.';
+        status.append(message);
+      });
+
+      const observer = new ResizeObserver(drawCup);
+      observer.observe(stage);
+      observer.observe(form);
+      window.addEventListener('resize', drawCup);
+      // Moving between screens can change pixel density without changing CSS dimensions.
+      function watchPixelRatio() {
+        const query = window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          drawCup();
+          watchPixelRatio();
+        }, { once: true });
+      }
+      watchPixelRatio();
+      drawCup();
+    })();
+  </script>
+
 </body>
 
