+  <script>
+    const page = favoritesPage(location.href);
+    if (page === 2) {
+      const favorites = [
+        ['Pumpkin Spice Latte', 'Espresso with warming pumpkin spice and silky steamed milk.', '/menu/seasonal'],
+        ['Cinnamon Mocha', 'Rich chocolate and espresso finished with a touch of cinnamon.', '/menu/mocha'],
+        ['Caramel Apple Cold Brew', 'Smooth cold brew with crisp apple notes and a caramel finish.', '/menu/cold-brew'],
+      ];
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = favorites[index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = href;
+      });
+      document.getElementById('page-number').textContent = 'Page 2 of 2';
+      document.title = 'Seasonal Favorites — Page 2 | The Daily Grind';
+    }
+
+    for (const [id, disabled] of [['previous', page === 1], ['next', page === 2]]) {
+      const link = document.getElementById(id);
+      if (disabled) {
+        link.setAttribute('aria-disabled', 'true');
+        link.setAttribute('tabindex', '-1');
+        link.addEventListener('click', (event) => event.preventDefault());
+      } else {
+        link.removeAttribute('aria-disabled');
+        link.removeAttribute('tabindex');
+      }
+    }
+  </script>
