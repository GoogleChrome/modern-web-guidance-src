+  <script>
+    function favoritesPage(url) {
+      return new URL(url).searchParams.get('page') === '2' ? 2 : 1;
+    }
+
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+
+      function applyTransitionType(transition, from, to) {
+        if (!transition) return;
+        if (!motionPreference.matches) {
+          transition.skipTransition();
+          return;
+        }
+        if (!transition.types || !from || !to) return;
+
+        const source = new URL(from);
+        const destination = new URL(to);
+        if (source.origin !== destination.origin || source.pathname !== destination.pathname) return;
+
+        const difference = favoritesPage(destination) - favoritesPage(source);
+        if (difference !== 0) {
+          transition.types.add(difference > 0 ? 'next' : 'previous');
+        }
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event.viewTransition, location.href, event.activation?.entry?.url);
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        const activation = window.navigation?.activation;
+        applyTransitionType(event.viewTransition, activation?.from?.url, activation?.entry?.url);
+      });
+    }
+  </script>
   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root) {
+        animation: page-out 300ms ease-in-out both;
+      }
+
+      ::view-transition-new(root) {
+        animation: page-in 300ms ease-in-out both;
+      }
+
+      html:active-view-transition-type(next) {
+        --page-exit: -12vw;
+        --page-enter: 12vw;
+      }
+
+      html:active-view-transition-type(previous) {
+        --page-exit: 12vw;
+        --page-enter: -12vw;
+      }
+
+      @keyframes page-out {
+        from { opacity: 1; transform: translateX(0); }
+        to { opacity: 0; transform: translateX(var(--page-exit, 0)); }
+      }
+
+      @keyframes page-in {
+        from { opacity: 0; transform: translateX(var(--page-enter, 0)); }
+        to { opacity: 1; transform: translateX(0); }
+      }
+    }
+
