+++ b/index.html
@@ -176,9 +176,9 @@
 
   <main class="container">
     <section>
       <h2 style="text-align: center;">Seasonal Favorites</h2>
-      <div class="grid">
+      <div class="grid" id="menu-items">
         <div class="card">
           <h3>Maple Oat Latte</h3>
           <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
           <a href="/menu/seasonal" class="btn">View Details</a>
@@ -206,7 +206,75 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Leave the page usable in browsers without WebMCP support.
+      if (typeof document.modelContext?.registerTool !== 'function') return;
+
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+      const lookupTool = {
+        name: 'get_menu_item',
+        description: 'Look up a drink on The Daily Grind menu. Use when someone asks for its description or a link to more details.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item name as shown on the menu. Matching ignores capitalization and extra whitespace.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        execute(input) {
+          if (!input || typeof input.name !== 'string' || !input.name.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          // Read the displayed menu so the tool stays in sync with page content.
+          const items = Array.from(document.querySelectorAll('#menu-items .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find((entry) => normalizeName(entry.name) === normalizeName(input.name));
+
+          return item || {
+            error: `Menu item "${input.name.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      let registrationController;
+
+      async function registerMenuTool() {
+        if (registrationController && !registrationController.signal.aborted) return;
+
+        const controller = new AbortController();
+        registrationController = controller;
+        try {
+          await document.modelContext.registerTool(lookupTool, { signal: controller.signal });
+        } catch (error) {
+          if (!controller.signal.aborted) {
+            controller.abort();
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+        }
+      }
+
+      // AbortSignal unregisters the tool, including on navigation into the back/forward cache.
+      window.addEventListener('pagehide', () => registrationController?.abort());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) void registerMenuTool();
+      });
+      void registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
