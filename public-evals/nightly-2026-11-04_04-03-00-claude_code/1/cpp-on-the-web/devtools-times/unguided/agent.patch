diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..5ffaa31
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Builds wasm/smallpt.cpp into a self-contained (import-free) WebAssembly
+# module at public/smallpt/smallpt.wasm. Requires Emscripten (em++).
+set -e
+cd "$(dirname "$0")/.."
+em++ -O3 -ffast-math -fno-exceptions -fno-rtti \
+  -sSTANDALONE_WASM -sINITIAL_MEMORY=33554432 -sALLOW_MEMORY_GROWTH=0 \
+  -sSTACK_SIZE=1048576 -sERROR_ON_UNDEFINED_SYMBOLS=1 \
+  --no-entry -o public/smallpt/smallpt.wasm wasm/smallpt.cpp
+echo "Built public/smallpt/smallpt.wasm ($(wc -c < public/smallpt/smallpt.wasm) bytes)"
diff --git a/wasm/smallpt.cpp b/wasm/smallpt.cpp
new file mode 100644
index 0000000..6a4c1a0
--- /dev/null
+++ b/wasm/smallpt.cpp
@@ -0,0 +1,172 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// http://www.kevinbeason.com/smallpt/  (MIT-style license, see below)
+//
+// Adapted for WebAssembly: instead of rendering the whole image and writing a
+// PPM file from main(), the renderer is exposed as a handful of exported C
+// functions so a JS host can render progressively, row by row, one 2x2-subpixel
+// pass at a time, and change the sphere colors between runs. The tracing code
+// (Vec, Ray, Sphere, intersect, radiance, tent filter, gamma) is unchanged
+// apart from swapping erand48() for a small self-contained PRNG so that the
+// module has no imports at all.
+//
+// Original license:
+// Copyright (c) 2006-2008 Kevin Beason (kevin.beason@gmail.com)
+// Permission is hereby granted, free of charge, to any person obtaining a copy
+// of this software and associated documentation files (the "Software"), to
+// deal in the Software without restriction, including without limitation the
+// rights to use, copy, modify, merge, publish, distribute, sublicense, and/or
+// sell copies of the Software, and to permit persons to whom the Software is
+// furnished to do so, subject to the following conditions:
+// The above copyright notice and this permission notice shall be included in
+// all copies or substantial portions of the Software.
+// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
+#include <math.h>
+
+#define EXPORT extern "C" __attribute__((used, visibility("default")))
+
+// --- PRNG replacing erand48 (xorshift64*, returns double in [0,1)) ---------
+typedef unsigned long long u64;
+static inline double rnd(u64 &s) {
+  s ^= s >> 12; s ^= s << 25; s ^= s >> 27;
+  return ((s * 2685821657736338717ULL) >> 11) * (1.0 / 9007199254740992.0);
+}
+
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+static const int NUM_SPHERES = 9;
+Sphere spheres[NUM_SPHERES] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const Vec DEFAULT_COLORS[NUM_SPHERES] = {
+  Vec(.75,.25,.25), Vec(.25,.25,.75), Vec(.75,.75,.75), Vec(),
+  Vec(.75,.75,.75), Vec(.75,.75,.75), Vec(1,1,1)*.999, Vec(1,1,1)*.999, Vec()
+};
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, u64 &Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (rnd(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (depth>100) return obj.e; // guard against stack overflow in wasm
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*rnd(Xi), r2=rnd(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (rnd(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// --- WebAssembly host interface --------------------------------------------
+static const int MAX_W = 640, MAX_H = 480;
+static int W = 320, H = 240;
+static u64 seedBase = 1;
+// Per-pixel, per-2x2-subpixel running radiance sums (same structure as the
+// original's `r` accumulator, but persistent across passes).
+static float accum[MAX_W * MAX_H * 4 * 3];
+static unsigned char rgba[MAX_W * MAX_H * 4];
+
+EXPORT int max_width()  { return MAX_W; }
+EXPORT int max_height() { return MAX_H; }
+EXPORT unsigned char* rgba_ptr() { return rgba; }
+EXPORT int num_spheres() { return NUM_SPHERES; }
+
+// Set the surface color of sphere i (0..8; see scene table above).
+EXPORT void set_sphere_color(int i, double r, double g, double b) {
+  if (i >= 0 && i < NUM_SPHERES) spheres[i].c = Vec(r, g, b);
+}
+EXPORT void reset_sphere_colors() {
+  for (int i = 0; i < NUM_SPHERES; i++) spheres[i].c = DEFAULT_COLORS[i];
+}
+
+// Start a new image; clears the accumulation buffer.
+EXPORT int setup(int w, int h, double seed) {
+  if (w < 1 || h < 1 || w > MAX_W || h > MAX_H) return 0;
+  W = w; H = h;
+  seedBase = (u64)seed * 0x9E3779B97F4A7C15ULL + 0x632BE59BD9B4E019ULL;
+  for (int i = 0; i < W * H * 12; i++) accum[i] = 0;
+  for (int i = 0; i < W * H * 4; i++) rgba[i] = (i & 3) == 3 ? 255 : 0;
+  return 1;
+}
+
+// Trace one sample per 2x2 subpixel (4 spp) for every pixel of image row
+// `row` (0 = top), accumulate it, and refresh that row in the RGBA buffer
+// assuming `pass` (0-based) passes have now completed for this row.
+EXPORT void render_row(int row, int pass) {
+  int y = H - 1 - row;  // smallpt's y axis points up
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(W*.5135/H), cy=(cx%cam.d).norm()*.5135;
+  u64 Xi = seedBase ^ ((u64)(pass + 1) * 0xD1B54A32D192ED03ULL)
+                    ^ ((u64)(y + 1) * 0xABC98388FB8FAC03ULL);
+  if (!Xi) Xi = 1;
+  for (int k = 0; k < 4; k++) rnd(Xi);  // decorrelate nearby seeds
+  double invN = 1.0 / (pass + 1);
+  for (unsigned short x=0; x<W; x++) {   // Loop cols
+    float *acc = &accum[(row * W + x) * 12];
+    Vec c;
+    for (int sy=0; sy<2; sy++)            // 2x2 subpixel rows
+      for (int sx=0; sx<2; sx++, acc += 3) { // 2x2 subpixel cols
+        double r1=2*rnd(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+        double r2=2*rnd(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+        Vec d = cx*( ( (sx+.5 + dx)/2 + x)/W - .5) +
+                cy*( ( (sy+.5 + dy)/2 + y)/H - .5) + cam.d;
+        Vec r = radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        acc[0] += (float)r.x; acc[1] += (float)r.y; acc[2] += (float)r.z;
+        c = c + Vec(clamp(acc[0]*invN),clamp(acc[1]*invN),clamp(acc[2]*invN))*.25;
+      }
+    unsigned char *px = &rgba[(row * W + x) * 4];
+    px[0] = toInt(c.x); px[1] = toInt(c.y); px[2] = toInt(c.z); px[3] = 255;
+  }
+}
