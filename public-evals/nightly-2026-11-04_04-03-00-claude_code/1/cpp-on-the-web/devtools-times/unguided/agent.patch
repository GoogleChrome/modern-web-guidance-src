new file mode 100644
index 0000000..1b104fe
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,28 @@
+// Web Worker that drives one instance of smallpt.wasm (see wasm/smallpt.cpp).
+// Message in:  { module: WebAssembly.Module, width, height, seed, passes,
+//                colors: [[r,g,b] x 9], rows: number[] }
+// Messages out: { type: 'pass', pass, rows, pixels: Uint8Array (RGBA rows) }
+//               { type: 'done' } | { type: 'error', message }
+self.onmessage = async ({ data }) => {
+  try {
+    const { module, width, height, seed, passes, colors, rows } = data;
+    const instance = await WebAssembly.instantiate(module, {});
+    const e = instance.exports;
+    if (e._initialize) e._initialize();
+    if (!e.setup(width, height, seed)) throw new Error('Unsupported size');
+    colors.forEach(([r, g, b], i) => e.set_sphere_color(i, r, g, b));
+    const rowBytes = width * 4;
+    for (let pass = 0; pass < passes; pass++) {
+      const pixels = new Uint8Array(rows.length * rowBytes);
+      const rgba = new Uint8Array(e.memory.buffer, e.rgba_ptr(), width * height * 4);
+      rows.forEach((row, i) => {
+        e.render_row(row, pass);
+        pixels.set(rgba.subarray(row * rowBytes, (row + 1) * rowBytes), i * rowBytes);
+      });
+      self.postMessage({ type: 'pass', pass, rows, pixels }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done' });
+  } catch (err) {
+    self.postMessage({ type: 'error', message: String(err && err.message || err) });
+  }
+};
diff --git a/src/components/SmallptRenderer.tsx b/src/components/SmallptRenderer.tsx
new file mode 100644
index 0000000..e0770ef
--- /dev/null
+++ b/src/components/SmallptRenderer.tsx
@@ -0,0 +1,225 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+// Client-side path tracing with Kevin Beason's smallpt compiled to
+// WebAssembly (source: wasm/smallpt.cpp, build: wasm/build.sh). Rendering is
+// split across several Web Workers by interleaved image rows and refined
+// progressively, 4 samples per pixel per pass.
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const PASSES = 64; // 64 passes x 4 spp = 256 samples per pixel
+
+type RGB = [number, number, number];
+
+// Index order matches the `spheres` table in wasm/smallpt.cpp.
+const SPHERE_NAMES = ['Left wall', 'Right wall', 'Back wall', 'Front wall', 'Floor', 'Ceiling', 'Mirror ball', 'Glass ball', 'Light'];
+const CLASSIC_COLORS: RGB[] = [
+  [0.75, 0.25, 0.25],
+  [0.25, 0.25, 0.75],
+  [0.75, 0.75, 0.75],
+  [0, 0, 0],
+  [0.75, 0.75, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+  [0, 0, 0],
+];
+// Spheres worth showing as swatches (front wall is behind the camera, the
+// light has no surface color).
+const VISIBLE = [0, 1, 2, 4, 5, 6, 7];
+
+function hsv(h: number, s: number, v: number): RGB {
+  const f = (n: number) => {
+    const k = (n + h * 6) % 6;
+    return v - v * s * Math.max(0, Math.min(k, 4 - k, 1));
+  };
+  return [f(5), f(3), f(1)];
+}
+
+function randomColors(): RGB[] {
+  const r = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
+  return CLASSIC_COLORS.map((c, i) => {
+    if (i === 3 || i === 8) return c; // front wall & light stay as-is
+    if (i === 6 || i === 7) return hsv(Math.random(), r(0.15, 0.6), 0.999); // tinted mirror/glass
+    return hsv(Math.random(), r(0.3, 0.85), r(0.55, 0.85)); // diffuse walls (albedo < 1)
+  });
+}
+
+const toCss = ([r, g, b]: RGB) =>
+  `rgb(${[r, g, b].map((x) => Math.round(Math.pow(Math.min(1, x), 1 / 2.2) * 255)).join(',')})`;
+
+function assetUrl(path: string) {
+  const base = import.meta.env.BASE_URL;
+  return `${base.endsWith('/') ? base : base + '/'}${path}`;
+}
+
+let modulePromise: Promise<WebAssembly.Module> | null = null;
+function loadModule() {
+  if (!modulePromise) {
+    const url = assetUrl('smallpt/smallpt.wasm');
+    modulePromise = (
+      WebAssembly.compileStreaming
+        ? WebAssembly.compileStreaming(fetch(url))
+        : fetch(url).then((r) => r.arrayBuffer()).then((b) => WebAssembly.compile(b))
+    ).catch((err) => {
+      modulePromise = null;
+      throw err;
+    });
+  }
+  return modulePromise;
+}
+
+export default function SmallptRenderer() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workersRef = useRef<Worker[]>([]);
+  const [colors, setColors] = useState<RGB[]>(CLASSIC_COLORS);
+  const [passesDone, setPassesDone] = useState(0);
+  const [elapsed, setElapsed] = useState(0);
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'done' | 'error'>('loading');
+  const [error, setError] = useState('');
+
+  const stop = useCallback(() => {
+    workersRef.current.forEach((w) => w.terminate());
+    workersRef.current = [];
+  }, []);
+
+  const render = useCallback(
+    async (sceneColors: RGB[]) => {
+      stop();
+      setColors(sceneColors);
+      setPassesDone(0);
+      setElapsed(0);
+      setStatus('loading');
+      let module: WebAssembly.Module;
+      try {
+        module = await loadModule();
+      } catch (err) {
+        setStatus('error');
+        setError(String(err));
+        return;
+      }
+      const ctx = canvasRef.current?.getContext('2d');
+      if (!ctx) return;
+      stop(); // a newer render may have started while compiling
+
+      const image = ctx.createImageData(WIDTH, HEIGHT);
+      const rowBytes = WIDTH * 4;
+      const count = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 8));
+      const progress = new Array(count).fill(0);
+      let finished = 0;
+      let dirty = false;
+      const start = performance.now();
+      const workers: Worker[] = [];
+      setStatus('rendering');
+
+      const flush = () => {
+        if (workersRef.current !== workers) return;
+        if (dirty) {
+          ctx.putImageData(image, 0, 0);
+          dirty = false;
+          setPassesDone(Math.min(...progress));
+          setElapsed(performance.now() - start);
+        }
+        if (finished < count) requestAnimationFrame(flush);
+      };
+
+      const seed = Math.floor(Math.random() * 2 ** 31);
+      for (let k = 0; k < count; k++) {
+        const rows: number[] = [];
+        for (let y = k; y < HEIGHT; y += count) rows.push(y);
+        const worker = new Worker(assetUrl('smallpt/worker.js'));
+        worker.onmessage = ({ data }) => {
+          if (workersRef.current !== workers) return;
+          if (data.type === 'pass') {
+            (data.rows as number[]).forEach((row, i) =>
+              image.data.set(data.pixels.subarray(i * rowBytes, (i + 1) * rowBytes), row * rowBytes),
+            );
+            progress[k] = data.pass + 1;
+            dirty = true;
+          } else if (data.type === 'done') {
+            worker.terminate();
+            if (++finished === count) {
+              ctx.putImageData(image, 0, 0);
+              setPassesDone(PASSES);
+              setElapsed(performance.now() - start);
+              setStatus('done');
+            }
+          } else if (data.type === 'error') {
+            stop();
+            setStatus('error');
+            setError(data.message);
+          }
+        };
+        worker.postMessage({ module, width: WIDTH, height: HEIGHT, seed, passes: PASSES, colors: sceneColors, rows });
+        workers.push(worker);
+      }
+      workersRef.current = workers;
+      requestAnimationFrame(flush);
+    },
+    [stop],
+  );
+
+  useEffect(() => {
+    render(CLASSIC_COLORS);
+    return stop;
+  }, [render, stop]);
+
+  const busy = status === 'loading' || status === 'rendering';
+
+  return (
+    <div className="flex flex-col md:flex-row gap-6 items-start">
+      <div className="w-full md:w-3/5">
+        <canvas
+          ref={canvasRef}
+          width={WIDTH}
+          height={HEIGHT}
+          className="w-full h-auto bg-black border border-gray-300"
+          aria-label="Path-traced Cornell box rendered by smallpt in WebAssembly"
+        />
+        <div className="mt-2 h-1 bg-gray-200">
+          <div className="h-1 bg-amber-400 transition-[width]" style={{ width: `${(passesDone / PASSES) * 100}%` }} />
+        </div>
+        <p className="mt-1 text-xs text-gray-500" aria-live="polite">
+          {status === 'error'
+            ? `Rendering failed: ${error}`
+            : status === 'loading'
+              ? 'Loading WebAssembly…'
+              : `${passesDone * 4} / ${PASSES * 4} samples per pixel · ${(elapsed / 1000).toFixed(1)}s${status === 'done' ? ' · done' : ''}`}
+        </p>
+      </div>
+      <div className="w-full md:w-2/5">
+        <p className="text-gray-700 mb-4">
+          This image is rendered right now, in your browser, by{' '}
+          <a className="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener noreferrer">
+            smallpt
+          </a>
+          , Kevin Beason's 99-line C++ path tracer, compiled to WebAssembly and run across several Web Workers. It keeps adding light paths until each pixel has averaged {PASSES * 4} samples.
+        </p>
+        <ul className="grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-gray-700 mb-4">
+          {VISIBLE.map((i) => (
+            <li key={i} className="flex items-center gap-2">
+              <span className="inline-block w-4 h-4 border border-gray-400" style={{ background: toCss(colors[i]) }} />
+              {SPHERE_NAMES[i]}
+            </li>
+          ))}
+        </ul>
+        <div className="flex flex-wrap gap-2">
+          <button
+            type="button"
+            onClick={() => render(randomColors())}
+            className="px-4 py-2 bg-gray-900 text-white font-semibold hover:bg-amber-400 hover:text-gray-900 transition-colors"
+          >
+            {busy ? 'Restart with random colors' : 'Render again with random colors'}
+          </button>
+          <button
+            type="button"
+            onClick={() => render(CLASSIC_COLORS)}
+            className="px-4 py-2 border border-gray-900 text-gray-900 font-semibold hover:bg-gray-200 transition-colors"
+          >
+            Classic colors
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
