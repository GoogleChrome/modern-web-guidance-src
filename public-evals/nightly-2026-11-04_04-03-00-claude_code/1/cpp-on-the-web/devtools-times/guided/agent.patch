new file mode 100644
index 0000000..020f7d8
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,37 @@
+// Module worker that drives the smallpt WebAssembly build for one band of rows.
+// Messages in:  { type: 'render', job, width, height, y0, y1, colors, maxPasses, seed }
+//               { type: 'stop' }
+// Messages out: { job, y0, y1, passes, pixels }  (pixels: transferred RGBA bytes)
+import createSmallpt from './smallpt.js';
+
+const modulePromise = createSmallpt();
+let currentJob = -1;
+
+const yieldToEventLoop = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+self.onmessage = async ({ data }) => {
+  if (data.type === 'stop') {
+    currentJob = -1;
+    return;
+  }
+  if (data.type !== 'render') return;
+
+  const { job, width, height, y0, y1, colors, maxPasses, seed } = data;
+  currentJob = job;
+  const wasm = await modulePromise;
+  if (currentJob !== job) return;
+
+  const ptr = wasm._smallpt_init(width, height, y0, y1);
+  colors.forEach(([r, g, b], i) => wasm._smallpt_set_color(i, r, g, b));
+  const byteLength = width * (y1 - y0) * 4;
+
+  for (let pass = 0; pass < maxPasses; pass++) {
+    const passes = wasm._smallpt_render_pass(seed);
+    // Read HEAPU8 fresh: memory growth would detach an older view.
+    const pixels = wasm.HEAPU8.slice(ptr, ptr + byteLength);
+    self.postMessage({ job, y0, y1, passes, pixels }, [pixels.buffer]);
+    // Let a newer 'render' or 'stop' message in before tracing the next pass.
+    await yieldToEventLoop();
+    if (currentJob !== job) return;
+  }
+};
diff --git a/src/components/SmallptRenderer.tsx b/src/components/SmallptRenderer.tsx
new file mode 100644
index 0000000..614b02a
--- /dev/null
+++ b/src/components/SmallptRenderer.tsx
@@ -0,0 +1,156 @@
+import { useEffect, useRef, useState } from 'react';
+
+type RGB = [number, number, number];
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const MAX_PASSES = 64; // 4 samples per pixel per pass -> 256 spp
+const MAX_WORKERS = 8;
+
+// Sphere order matches the `spheres[]` array in wasm/smallpt.cpp.
+const SPHERE_NAMES = ['Left wall', 'Right wall', 'Back wall', 'Front', 'Floor', 'Ceiling', 'Mirror ball', 'Glass ball', 'Light'];
+const DEFAULT_COLORS: RGB[] = [
+  [0.75, 0.25, 0.25],
+  [0.25, 0.25, 0.75],
+  [0.75, 0.75, 0.75],
+  [0, 0, 0],
+  [0.75, 0.75, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+  [0, 0, 0],
+];
+// The front wall (behind the camera) and the light keep their colors.
+const SWATCH_INDICES = [0, 1, 2, 4, 5, 6, 7];
+
+function hslToRgb(h: number, s: number, l: number): RGB {
+  const k = (n: number) => (n + h / 30) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+  return [f(0), f(8), f(4)];
+}
+
+function randomColors(): RGB[] {
+  const rand = (min: number, max: number) => min + Math.random() * (max - min);
+  const colors = DEFAULT_COLORS.map((c) => [...c] as RGB);
+  // Walls: saturated diffuse colors, kept below 0.8 albedo like the original.
+  for (const i of [0, 1, 2, 4, 5]) {
+    colors[i] = hslToRgb(rand(0, 360), rand(0.35, 0.85), rand(0.35, 0.6)).map((v) => Math.min(v, 0.8)) as RGB;
+  }
+  // Mirror and glass: bright tints so they still read as metal and glass.
+  for (const i of [6, 7]) {
+    colors[i] = hslToRgb(rand(0, 360), rand(0.5, 1), rand(0.7, 0.85)).map((v) => Math.min(v, 0.999)) as RGB;
+  }
+  return colors;
+}
+
+const toCss = ([r, g, b]: RGB) =>
+  `rgb(${[r, g, b].map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(' ')})`;
+
+export default function SmallptRenderer() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workersRef = useRef<Worker[]>([]);
+  const jobRef = useRef(0);
+  const [colors, setColors] = useState<RGB[]>(DEFAULT_COLORS);
+  const [progress, setProgress] = useState({ passes: 0, ms: 0 });
+  const [error, setError] = useState<string | null>(null);
+
+  // Spawn the worker pool once.
+  useEffect(() => {
+    const count = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, MAX_WORKERS));
+    const url = `${import.meta.env.BASE_URL}smallpt/worker.js`;
+    workersRef.current = Array.from({ length: count }, () => new Worker(url, { type: 'module' }));
+    return () => {
+      workersRef.current.forEach((w) => w.terminate());
+      workersRef.current = [];
+    };
+  }, []);
+
+  // (Re)start a progressive render whenever the colors change.
+  useEffect(() => {
+    const ctx = canvasRef.current?.getContext('2d');
+    const workers = workersRef.current;
+    if (!ctx || workers.length === 0) return;
+
+    const job = ++jobRef.current;
+    const seed = (Math.random() * 0xffffffff) >>> 0;
+    const start = performance.now();
+    const bandPasses = new Array<number>(workers.length).fill(0);
+    setProgress({ passes: 0, ms: 0 });
+    setError(null);
+
+    workers.forEach((worker, i) => {
+      const y0 = Math.floor((i * HEIGHT) / workers.length);
+      const y1 = Math.floor(((i + 1) * HEIGHT) / workers.length);
+      worker.onmessage = ({ data }) => {
+        if (data.job !== jobRef.current) return;
+        const image = new ImageData(new Uint8ClampedArray(data.pixels.buffer), WIDTH, data.y1 - data.y0);
+        ctx.putImageData(image, 0, data.y0);
+        bandPasses[i] = data.passes;
+        // Report the pass count every band has reached.
+        setProgress({ passes: Math.min(...bandPasses), ms: performance.now() - start });
+      };
+      worker.onerror = (e) => {
+        e.preventDefault();
+        setError('The path tracer failed to load. Your browser may not support module workers or WebAssembly.');
+      };
+      worker.postMessage({ type: 'render', job, width: WIDTH, height: HEIGHT, y0, y1, colors, maxPasses: MAX_PASSES, seed });
+    });
+
+    return () => workers.forEach((w) => w.postMessage({ type: 'stop' }));
+  }, [colors]);
+
+  const done = progress.passes >= MAX_PASSES;
+
+  return (
+    <div className="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] items-start">
+      <canvas
+        ref={canvasRef}
+        width={WIDTH}
+        height={HEIGHT}
+        role="img"
+        aria-label="Path-traced Cornell box: colored walls, a mirror ball and a glass ball lit by a ceiling light"
+        className="w-full h-auto aspect-[4/3] bg-gray-900"
+      />
+      <div className="flex flex-col gap-4 text-left">
+        <p className="text-gray-700">
+          This is{' '}
+          <a className="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/">
+            smallpt
+          </a>
+          , Kevin Beason's 99-line C++ global illumination path tracer, compiled to WebAssembly and
+          running in {workersRef.current.length || 'several'} Web Workers right in your browser.
+        </p>
+        <button
+          type="button"
+          onClick={() => setColors(randomColors())}
+          className="self-start rounded bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500"
+        >
+          Render again with random colors
+        </button>
+        <p className="text-sm text-gray-600 tabular-nums" aria-hidden="true">
+          {error ??
+            (done
+              ? `Done: ${MAX_PASSES * 4} samples per pixel in ${(progress.ms / 1000).toFixed(1)} s.`
+              : `Rendering… ${progress.passes * 4} / ${MAX_PASSES * 4} samples per pixel`)}
+        </p>
+        {/* Announce only state changes, not every progressive pass. */}
+        <p className="sr-only" role="status">
+          {error ?? (done ? 'Render complete.' : 'Rendering image.')}
+        </p>
+        <ul className="grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-gray-700" aria-label="Sphere colors">
+          {SWATCH_INDICES.map((i) => (
+            <li key={i} className="flex items-center gap-2">
+              <span
+                className="inline-block size-4 rounded-full border border-gray-300"
+                style={{ backgroundColor: toCss(colors[i]) }}
+                aria-hidden="true"
+              />
+              {SPHERE_NAMES[i]}
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+}
