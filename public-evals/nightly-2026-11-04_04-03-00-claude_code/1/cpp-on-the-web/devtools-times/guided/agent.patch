diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..cbf8d21
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Builds wasm/smallpt.cpp into public/smallpt/smallpt.{js,wasm}.
+# Requires Emscripten (emcc/em++) on PATH.
+# (-flto is omitted: single translation unit, so it gains nothing. Closure is
+# omitted because the glue is already small and closure-compiler is optional.)
+set -eu
+cd "$(dirname "$0")"
+OUT=../public/smallpt
+mkdir -p build "$OUT"
+em++ -c smallpt.cpp -o build/smallpt.o -O3 -Wall -Werror
+em++ build/smallpt.o -o "$OUT/smallpt.js" \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_smallpt_init,_smallpt_set_color,_smallpt_num_spheres,_smallpt_render_pass \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
