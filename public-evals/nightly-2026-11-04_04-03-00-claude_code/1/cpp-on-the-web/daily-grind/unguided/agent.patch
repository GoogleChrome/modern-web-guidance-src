+#!/bin/sh
+# Compile smallpt to WebAssembly (requires Emscripten's em++ on PATH).
+set -e
+cd "$(dirname "$0")"
+mkdir -p wasm
+em++ src/smallpt.cpp -O3 -Wno-dangling-else -o wasm/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH=1 \
+  -sEXPORTED_FUNCTIONS=_init,_render_row,_reset_scene,_set_sphere_color,_sphere_count \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
