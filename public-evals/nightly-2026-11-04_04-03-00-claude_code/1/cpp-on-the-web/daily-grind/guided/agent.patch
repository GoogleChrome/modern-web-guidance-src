+#!/bin/sh
+# Builds wasm/smallpt.cpp into js/smallpt.js + js/smallpt.wasm (ES module for Web Workers).
+set -e
+cd "$(dirname "$0")/.."
+mkdir -p build js
+em++ -c wasm/smallpt.cpp -o build/smallpt.o -O3 -flto -Wall -Werror
+# Link with emcc: the code needs no C++ standard library, so libc++ is not linked.
+emcc build/smallpt.o -o js/smallpt.js \
+  -O3 -flto \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_sp_num_spheres,_sp_set_color,_sp_reset_colors,_sp_init,_sp_render_pass,_sp_get_rgba \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
