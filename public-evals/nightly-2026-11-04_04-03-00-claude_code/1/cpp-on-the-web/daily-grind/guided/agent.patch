index 0000000..1cf794d
--- /dev/null
+++ b/js/smallpt-app.js
@@ -0,0 +1,113 @@
+// Drives a pool of smallpt workers and composites their bands onto the canvas.
+const WIDTH = 400;
+const HEIGHT = 300;
+const PASSES = 64; // 4 samples per pixel per pass → 256 spp
+
+// Sphere indices in the smallpt scene (see wasm/smallpt.cpp).
+const SPHERES = [
+  { index: 0, name: 'Left wall' },
+  { index: 1, name: 'Right wall' },
+  { index: 2, name: 'Back wall' },
+  { index: 4, name: 'Floor' },
+  { index: 6, name: 'Mirror sphere', tint: true },
+  { index: 7, name: 'Glass sphere', tint: true },
+];
+
+const canvas = document.getElementById('smallpt-canvas');
+const status = document.getElementById('smallpt-status');
+const button = document.getElementById('smallpt-randomize');
+const swatches = document.getElementById('smallpt-swatches');
+const ctx = canvas.getContext('2d');
+canvas.width = WIDTH;
+canvas.height = HEIGHT;
+
+const workerCount = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 12));
+const bandHeight = Math.ceil(HEIGHT / workerCount);
+let runId = 0;
+let bandPasses = [];
+let startTime = 0;
+
+const workers = Array.from({ length: workerCount }, (_, i) => {
+  const worker = new Worker(new URL('./smallpt-worker.js', import.meta.url), { type: 'module' });
+  worker.ready = new Promise((resolve) => {
+    worker.onmessage = ({ data }) => {
+      if (data.ready) return resolve();
+      if (data.runId !== runId) return; // stale result from a previous run
+      if (data.error) {
+        status.textContent = `Render failed: ${data.error}`;
+        return;
+      }
+      const rows = data.row1 - data.row0;
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), WIDTH, rows), 0, data.row0);
+      bandPasses[i] = data.pass;
+      updateStatus();
+    };
+  });
+  worker.onerror = (event) => {
+    status.textContent = `Worker error: ${event.message || 'failed to load WebAssembly'}`;
+  };
+  return worker;
+});
+
+function updateStatus() {
+  const minPass = Math.min(...bandPasses);
+  const seconds = ((performance.now() - startTime) / 1000).toFixed(1);
+  status.textContent = minPass >= PASSES
+    ? `Done: ${PASSES * 4} samples per pixel in ${seconds}s on ${workerCount} threads.`
+    : `Rendering… ${minPass * 4} / ${PASSES * 4} samples per pixel (${seconds}s)`;
+}
+
+// Hue-spread random colors; max component < 1 keeps smallpt's Russian roulette sane.
+function randomColor(tint) {
+  const h = Math.random() * 360;
+  const s = tint ? 0.35 + Math.random() * 0.4 : 0.5 + Math.random() * 0.5;
+  const l = tint ? 0.75 + Math.random() * 0.15 : 0.35 + Math.random() * 0.3;
+  const k = (n) => (n + h / 30) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+  return [f(0), f(8), f(4)].map((v) => Math.min(0.999, Math.max(0, v)));
+}
+
+function showSwatches(colors) {
+  swatches.replaceChildren(...colors.map(([index, r, g, b]) => {
+    const li = document.createElement('li');
+    const chip = document.createElement('span');
+    // Display in sRGB (smallpt colors are linear reflectance).
+    const toSrgb = (v) => Math.round(Math.pow(v, 1 / 2.2) * 255);
+    chip.style.backgroundColor = `rgb(${toSrgb(r)} ${toSrgb(g)} ${toSrgb(b)})`;
+    li.append(chip, SPHERES.find((s) => s.index === index).name);
+    return li;
+  }));
+}
+
+async function render(colors) {
+  const id = ++runId;
+  bandPasses = new Array(workerCount).fill(0);
+  startTime = performance.now();
+  status.textContent = 'Loading WebAssembly…';
+  await Promise.all(workers.map((w) => w.ready));
+  if (id !== runId) return;
+  startTime = performance.now();
+  workers.forEach((worker, i) => {
+    const row0 = Math.min(HEIGHT, i * bandHeight);
+    const row1 = Math.min(HEIGHT, row0 + bandHeight);
+    if (row0 >= row1) {
+      bandPasses[i] = PASSES;
+      return;
+    }
+    worker.postMessage({ type: 'render', runId: id, width: WIDTH, height: HEIGHT, row0, row1, passes: PASSES, colors });
+  });
+}
+
+button.addEventListener('click', () => {
+  const colors = SPHERES.map(({ index, tint }) => [index, ...randomColor(tint)]);
+  showSwatches(colors);
+  render(colors);
+});
+
+const DEFAULT_COLORS = [
+  [0, 0.75, 0.25, 0.25], [1, 0.25, 0.25, 0.75], [2, 0.75, 0.75, 0.75],
+  [4, 0.75, 0.75, 0.75], [6, 0.999, 0.999, 0.999], [7, 0.999, 0.999, 0.999],
+];
+showSwatches(DEFAULT_COLORS);
+render(null); // the original Cornell box first
diff --git a/js/smallpt-worker.js b/js/smallpt-worker.js
new file mode 100644
index 0000000..6f4b488
--- /dev/null
+++ b/js/smallpt-worker.js
@@ -0,0 +1,34 @@
+// Runs the smallpt WebAssembly module off the main thread. Each worker renders a
+// horizontal band of the image progressively and posts the band after every pass.
+import createSmallpt from './smallpt.js';
+
+const wasm = await createSmallpt();
+let currentRun = 0;
+
+// Let queued messages (e.g. a newer "render" request) be handled between passes.
+const yieldToEventLoop = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+async function render({ runId, width, height, row0, row1, passes, colors }) {
+  currentRun = runId;
+  wasm._sp_reset_colors();
+  colors?.forEach(([index, r, g, b]) => wasm._sp_set_color(index, r, g, b));
+  if (!wasm._sp_init(width, height, row0, row1)) throw new Error('Out of memory');
+
+  const byteLength = width * (row1 - row0) * 4;
+  for (let pass = 1; pass <= passes; pass++) {
+    wasm._sp_render_pass(pass);
+    const ptr = wasm._sp_get_rgba(pass);
+    // Read HEAPU8 fresh: memory growth detaches old views.
+    const pixels = wasm.HEAPU8.slice(ptr, ptr + byteLength);
+    self.postMessage({ runId, row0, row1, pass, pixels }, [pixels.buffer]);
+    await yieldToEventLoop();
+    if (currentRun !== runId) return; // superseded by a newer run
+  }
+}
+
+self.onmessage = ({ data }) => {
+  if (data.type === 'render') {
+    render(data).catch((error) => self.postMessage({ runId: data.runId, error: String(error) }));
+  }
+};
+self.postMessage({ ready: true });
