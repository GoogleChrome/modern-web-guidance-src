+const crypto = require('node:crypto');
 
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
 
+// Staged rollout controls:
+//   CSP_MODE=report-only  -> send CSP as Content-Security-Policy-Report-Only (dry run)
+//   CSP_MODE=enforce      -> (default) enforce CSP; reporting stays wired up
+//   HSTS_MAX_AGE          -> start short (300s) and ramp up to 31536000 once HTTPS is verified
+const CSP_MODE = process.env.CSP_MODE === 'report-only' ? 'report-only' : 'enforce';
+const HSTS_MAX_AGE = parseInt(process.env.HSTS_MAX_AGE || '300', 10);
+
+const REPORT_PATH = '/csp-reports';
+const REPORT_MAX_BYTES = 64 * 1024;
+const NONCE_PLACEHOLDER = '{{CSP_NONCE}}';
+
+// Load the template once. It contains no user data; the nonce placeholder is only
+// present on developer-authored <script>/<style> tags.
+const TEMPLATE = fs.readFileSync(path.join(WORK_DIR, 'index.html'), 'utf8');
+
+function buildCsp(nonce) {
+  return [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'nonce-${nonce}' 'report-sample'`,
+    "img-src 'self' https://images.unsplash.com",
+    "font-src 'self'",
+    "connect-src 'self'",
+    "manifest-src 'self'",
+    "form-action 'self'",
+    "frame-ancestors 'none'",
+    "base-uri 'none'",
+    "object-src 'none'",
+    "require-trusted-types-for 'script'",
+    // No Trusted Types policies are needed today. Add policy names here when
+    // client-side code legitimately needs one (never a pass-through policy).
+    "trusted-types 'none'",
+    `report-uri ${REPORT_PATH}`, // legacy fallback for browsers without report-to
+    'report-to csp-endpoint',
+  ].join('; ');
+}
+
+function setSecurityHeaders(res, nonce) {
+  res.setHeader('Reporting-Endpoints', `csp-endpoint="${REPORT_PATH}", default="${REPORT_PATH}"`);
+  res.setHeader(
+    CSP_MODE === 'report-only' ? 'Content-Security-Policy-Report-Only' : 'Content-Security-Policy',
+    buildCsp(nonce),
+  );
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), focus-without-user-activation=()',
+  );
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Strict-Transport-Security', `max-age=${HSTS_MAX_AGE}; includeSubDomains`);
+  // Responses carry a per-request nonce and account-related content: never cache.
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+}
+
+// Fetch Metadata resource isolation: reject cross-site requests that are not
+// top-level GET navigations. Runs before any other handling.
+function isAllowedByFetchMetadata(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (!site) return true; // legacy browsers / non-browser clients
+  if (site === 'same-origin' || site === 'none') return true;
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+  return (
+    mode === 'navigate' &&
+    (req.method === 'GET' || req.method === 'HEAD') &&
+    dest !== 'object' &&
+    dest !== 'embed'
+  );
+}
+
+function send(res, status, body, extraHeaders = {}, method = 'GET') {
+  res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8', ...extraHeaders });
+  res.end(method === 'HEAD' ? undefined : body);
+}
+
+// Strip query strings / fragments so tokens or PII never land in logs.
+function scrubUrl(value) {
+  if (typeof value !== 'string') return undefined;
+  try {
+    const u = new URL(value);
+    return `${u.origin}${u.pathname}`;
+  } catch {
+    return value.split(/[?#]/)[0].slice(0, 200);
+  }
+}
+
+function handleReport(req, res) {
+  const type = (req.headers['content-type'] || '').split(';')[0].trim();
+  if (type !== 'application/reports+json' && type !== 'application/csp-report') {
+    return send(res, 415, 'Unsupported Media Type');
+  }
+  let size = 0;
+  const chunks = [];
+  req.on('data', (chunk) => {
+    size += chunk.length;
+    if (size > REPORT_MAX_BYTES) {
+      send(res, 413, 'Payload Too Large');
+      req.destroy();
+      return;
+    }
+    chunks.push(chunk);
+  });
+  req.on('end', () => {
+    if (res.writableEnded) return;
+    try {
+      const parsed = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      const reports = Array.isArray(parsed) ? parsed : [{ type: 'csp-violation', body: parsed['csp-report'] }];
+      for (const r of reports.slice(0, 50)) {
+        const b = (r && r.body) || {};
+        console.warn('[security-report]', JSON.stringify({
+          type: r && r.type,
+          directive: b.effectiveDirective || b['effective-directive'] || b.violatedDirective || b['violated-directive'],
+          blocked: scrubUrl(b.blockedURL || b['blocked-uri']),
+          document: scrubUrl(b.documentURL || b['document-uri']),
+          disposition: b.disposition,
+          sample: typeof (b.sample ?? b['script-sample']) === 'string' ? (b.sample ?? b['script-sample']).slice(0, 40) : undefined,
+        }));
+      }
+    } catch {
+      // Ignore malformed reports.
+    }
+    res.writeHead(204);
+    res.end();
+  });
+}
