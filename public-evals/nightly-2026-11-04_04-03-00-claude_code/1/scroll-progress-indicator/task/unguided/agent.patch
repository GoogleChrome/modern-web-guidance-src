--- a/index.html
+++ b/index.html
@@ -151,13 +151,44 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Scroll progress indicator
+       Baseline: hidden at 0 width (no JS, no scroll-timeline support = no bar, no harm).
+       Enhancement 1: native CSS scroll-driven animation (runs off the main thread).
+       Enhancement 2: JS fallback that drives --scroll-progress for other browsers. */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform-origin: 0 50%;
+      transform: scaleX(var(--scroll-progress, 0));
+      z-index: 1001;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    @keyframes scroll-progress-grow {
+      from { transform: scaleX(0); }
+      to { transform: scaleX(1); }
+    }
+
+    @supports (animation-timeline: scroll()) {
+      .scroll-progress {
+        animation: scroll-progress-grow linear both;
+        animation-timeline: scroll(root block);
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroll-progress" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +237,38 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
+      var bar = document.querySelector('.scroll-progress');
+      if (!bar) return;
+      var root = document.documentElement;
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var max = root.scrollHeight - root.clientHeight;
+        var y = window.pageYOffset || root.scrollTop || 0;
+        var progress = max > 0 ? Math.min(Math.max(y / max, 0), 1) : 0;
+        bar.style.setProperty('--scroll-progress', progress);
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || setTimeout)(update);
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      window.addEventListener('load', requestUpdate);
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
