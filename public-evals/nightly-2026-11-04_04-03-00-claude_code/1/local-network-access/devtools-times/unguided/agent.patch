@@ -0,0 +1,33 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect.tsx';
+---
+<Layout title="Developer Diagnostics | The DevTools Times">
+    <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Developer Diagnostics</h1>
+        <p class="text-gray-700 mb-8">
+            Connect this page to a hardware test device on your private Wi-Fi network and to the companion CLI
+            running on your own machine. Connections are made directly from your browser; nothing is relayed
+            through our servers, and your browser will ask for permission before this site can reach your local network.
+        </p>
+
+        <DiagnosticsConnect client:only="react" />
+
+        <div class="prose max-w-none mt-10">
+            <h2>Setting up your targets</h2>
+            <p>
+                Both the device and the CLI must explicitly allow this site. For every request (including the
+                <code>OPTIONS</code> preflight) they should respond with:
+            </p>
+            <pre><code>Access-Control-Allow-Origin: {Astro.url.origin}
+Access-Control-Allow-Headers: Authorization, Accept
+Access-Control-Allow-Methods: GET
+Access-Control-Allow-Private-Network: true</code></pre>
+            <ul>
+                <li>Only private LAN addresses (<code>10.0.0.0/8</code>, <code>172.16.0.0/12</code>, <code>192.168.0.0/16</code>, <code>*.local</code>) are accepted for the device, and only loopback for the CLI.</li>
+                <li>Do not use <code>Access-Control-Allow-Origin: *</code> on the CLI — allow-list this origin and require the pairing token so other websites cannot drive it.</li>
+                <li>Requests are sent without cookies, never follow redirects, and time out after 5 seconds.</li>
+            </ul>
+        </div>
+    </div>
+</Layout>
