@@ -0,0 +1,39 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
+    <header class="border-b border-gray-300 pb-6 mb-8">
+      <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2">Developer Tools</p>
+      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Diagnostics connection</h1>
+      <p class="text-gray-700 max-w-3xl">
+        Check the connection from your browser to a hardware test device on your home or office network,
+        and to the DevTools Times companion CLI running on your computer. Requests go straight from your
+        browser to your own devices. Nothing is sent through our servers.
+      </p>
+    </header>
+
+    <DiagnosticsConnect client:load />
+
+    <section class="mt-10 prose prose-sm max-w-3xl text-gray-700">
+      <h2>How it works</h2>
+      <p>
+        Your browser treats requests from a public website to your private network or to your own computer
+        as sensitive. The first time you click <strong>Connect</strong>, Chrome and Edge ask you to allow
+        <strong>Local network</strong> access (for the device) or <strong>Loopback network</strong> access
+        (for the CLI). You can change your choice at any time in Site settings.
+      </p>
+      <h2>Requirements for your device or CLI</h2>
+      <ul>
+        <li>It must be reachable over HTTP from this computer, for example on the same Wi‑Fi network. Guest networks often block this.</li>
+        <li>
+          It must answer the status endpoint with an
+          <code>Access-Control-Allow-Origin</code> header that allows this site's origin, so your browser
+          can read the response.
+        </li>
+      </ul>
+    </section>
+  </div>
+</Layout>
