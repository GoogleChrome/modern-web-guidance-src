+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({ code: v.code, client: 'daily-grind-web' }),
+              signal: session.signal
+            });
+            if (res.status === 401 || res.status === 403) throw new Error('Pairing code rejected. Check the code in the Brew Helper.');
+            const data = await readJson(res);
+            if (typeof data.token !== 'string' || !data.token) throw new Error('Brew Helper did not return a session token.');
+            token = data.token;
+            codeInput.value = '';
+            localStorage.setItem('dg.helper.port', String(v.port));
+
+            ui.showInfo([
+              ['App', data.app || 'Brew Helper'],
+              ['Version', data.version],
+              ['Computer', data.hostname],
+              ['Saved recipes', typeof data.recipeCount === 'number' ? data.recipeCount : null]
+            ]);
+            setConnected(true);
+            ui.setStatus('connected', 'Connected');
+            ui.log('Paired with Brew Helper.', 'ok');
+          } catch (err) {
+            ui.log(describeError(err), 'err');
+            disconnect('error', 'Failed', false);
+          }
+        }
+
+        async function disconnect(state = 'idle', label = 'Not connected', notify = true) {
+          const url = baseUrl;
+          const oldToken = token;
+          if (session) session.abort();
+          session = null;
+          token = null;
+          baseUrl = null;
+          setConnected(false);
+          ui.showInfo([]);
+          ui.setStatus(state, label);
+          if (notify && url && oldToken) {
+            // Best effort: tell the helper to revoke the token.
+            deviceFetch(`${url}/unpair`, {
+              addressSpace: 'loopback',
+              method: 'POST',
+              headers: { Authorization: `Bearer ${oldToken}` }
+            }).catch(() => {});
+          }
+        }
+
+        async function syncRecipes() {
+          if (!session) return;
+          const syncBtn = ui.btn('sync');
+          syncBtn.disabled = true;
+          ui.log('Sending house recipes to Brew Helper…');
+          try {
+            const res = await deviceFetch(`${baseUrl}/recipes`, {
+              addressSpace: 'loopback',
+              method: 'PUT',
+              headers: authHeaders({ 'Content-Type': 'application/json' }),
+              body: JSON.stringify({ source: 'The Daily Grind', recipes: RECIPES }),
+              signal: session.signal
+            });
+            if (res.status === 401) {
+              ui.log('Session expired — please pair again.', 'err');
+              disconnect('error', 'Session expired', false);
+              return;
+            }
+            if (!res.ok) throw new Error(`Brew Helper rejected sync (HTTP ${res.status})`);
+            ui.log(`Synced ${RECIPES.length} recipes.`, 'ok');
+          } catch (err) {
+            if (session) ui.log(describeError(err), 'err');
+          } finally {
+            if (session) syncBtn.disabled = false;
+          }
+        }
+
+        ui.btn('connect').addEventListener('click', connect);
+        ui.btn('disconnect').addEventListener('click', () => {
+          disconnect();
+          ui.log('Disconnected.');
+        });
+        ui.btn('sync').addEventListener('click', syncRecipes);
+        ui.form.addEventListener('submit', (e) => { e.preventDefault(); connect(); });
+        codeInput.addEventListener('input', () => {
+          codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
+          ui.markInvalid(codeInput, false);
+        });
+      }
+
+      initBrewer();
+      initHelper();
+    })();
+  </script>
+
 </body>
 
 </html>
