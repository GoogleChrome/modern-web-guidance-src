diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,108 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // WebMCP: expose a read-only "get_menu_item_details" tool to AI agents.
+    // The menu cards in the page are the source of truth, so the tool can
+    // never drift from what the customer actually sees.
+    const normalize = (value) => value.trim().replace(/\s+/g, " ").toLowerCase();
+
+    function getMenuItems() {
+      return [...document.querySelectorAll(".card")].map((card) => {
+        const link = card.querySelector("a[href]");
+        return {
+          name: card.querySelector("h3")?.textContent.trim() ?? "",
+          description: card.querySelector("p")?.textContent.trim() ?? "",
+          detailsUrl: link ? new URL(link.getAttribute("href"), location.href).href : null,
+        };
+      }).filter((item) => item.name);
+    }
+
+    function findMenuItem(itemName) {
+      const items = getMenuItems();
+      const query = normalize(itemName);
+      // Prefer an exact (case/whitespace-insensitive) match, then fall back to
+      // a unique partial match such as "cold brew coffee" or "espresso".
+      const exact = items.find((item) => normalize(item.name) === query);
+      if (exact) return { item: exact, items };
+      const partial = items.filter((item) => {
+        const name = normalize(item.name);
+        return name.includes(query) || query.includes(name);
+      });
+      return { item: partial.length === 1 ? partial[0] : null, matches: partial, items };
+    }
+
+    const menuItemTool = {
+      name: "get_menu_item_details",
+      description:
+        "Looks up a drink on The Daily Grind's menu by name and returns its details, including a description and a link to its full details page. Use when the user asks what a menu item is, what's in it, or wants more information about it.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          itemName: {
+            type: "string",
+            description:
+              "Name of the menu item as the user said it, for example \"maple oat latte\" or \"cold brew\". Matching ignores capitalization.",
+          },
+        },
+        required: ["itemName"],
+      },
+      execute({ itemName } = {}) {
+        // The browser doesn't validate input against inputSchema, so do it here.
+        if (typeof itemName !== "string" || !itemName.trim()) {
+          return {
+            error: "Provide the name of a menu item to look up.",
+            availableItems: getMenuItems().map((item) => item.name),
+          };
+        }
+        const { item, matches = [], items } = findMenuItem(itemName);
+        if (item) return item;
+        // Return errors as values (not throws) so the agent can read them and retry.
+        if (matches.length > 1) {
+          return {
+            error: `"${itemName}" matches more than one menu item. Ask the user which one they mean.`,
+            possibleMatches: matches.map((match) => match.name),
+          };
+        }
+        return {
+          error: `Menu item "${itemName}" was not found.`,
+          availableItems: items.map((entry) => entry.name),
+        };
+      },
+      annotations: { readOnlyHint: true },
+    };
+
+    let registration = null;
+
+    async function registerMenuTools() {
+      if (!("modelContext" in document) || registration) return;
+      const controller = new AbortController();
+      registration = controller;
+      try {
+        await document.modelContext.registerTool(menuItemTool, { signal: controller.signal });
+      } catch (err) {
+        if (registration === controller) registration = null;
+        console.warn("Could not register WebMCP menu tool:", err);
+      }
+    }
+
+    function unregisterMenuTools() {
+      // WebMCP has no unregisterTool(); aborting the signal removes the tool.
+      registration?.abort();
+      registration = null;
+    }
+
+    registerMenuTools();
+
+    // Use pagehide/pageshow rather than unload/beforeunload: they fire reliably
+    // (including on mobile) and keep the page eligible for the back/forward cache.
+    addEventListener("pagehide", unregisterMenuTools);
+    addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
