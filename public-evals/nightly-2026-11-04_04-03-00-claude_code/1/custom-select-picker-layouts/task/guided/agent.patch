+  <script>
+    // Native <select> only maps Up/Down; the picker is a single row of 3, so map Left/Right to prev/next option.
+    const roastPicker = document.getElementById('roast-picker');
+    if (CSS.supports('appearance', 'base-select')) {
+      roastPicker.addEventListener('keydown', (e) => {
+        if (!roastPicker.matches(':open') || !e.target.matches('option')) return;
+        const rtl = getComputedStyle(roastPicker).direction === 'rtl';
+        const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
+        if (!step) return;
+        e.preventDefault();
+        const options = [...roastPicker.options];
+        const next = options[options.indexOf(e.target) + step];
+        next?.focus();
+      });
+    }
+  </script>
