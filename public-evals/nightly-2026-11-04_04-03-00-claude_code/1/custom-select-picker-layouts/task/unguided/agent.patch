+    .roast-option-img,
+    .roast-option-note {
+      display: none;
+    }
+
+    /* Rich 3-column grid picker (customizable <select>) */
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 10px;
+      }
+
+      .roast-select > button {
+        display: contents;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent .roast-option-img {
+        display: block;
+        width: 28px;
+        height: 28px;
+        border-radius: 50%;
+      }
+
+      .roast-select selectedcontent .roast-option-note {
+        display: none;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        display: grid;
+        grid-template-columns: repeat(3, 1fr);
+        gap: 12px;
+        width: min(560px, 92vw);
+        padding: 14px;
+        margin-top: 8px;
+        border: none;
+        border-radius: 12px;
+        background: var(--light);
+        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
+        position-area: bottom;
+        position-try-fallbacks: flip-block;
+      }
+
+      .roast-option {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 4px;
+        padding: 10px;
+        border: 2px solid transparent;
+        border-radius: 10px;
+        background: white;
+        color: var(--text);
+        text-align: center;
+        cursor: pointer;
+        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
+      }
+
+      .roast-option::checkmark {
+        display: none;
+      }
+
+      .roast-option:hover,
+      .roast-option:focus-visible {
+        outline: none;
+        border-color: var(--secondary);
+        transform: translateY(-2px);
+        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
+      }
+
+      .roast-option:checked {
+        border-color: var(--accent);
+        background: #fff8ee;
+      }
+
+      .roast-option-img {
+        display: block;
+        width: 100%;
+        aspect-ratio: 1;
+        object-fit: cover;
+        border-radius: 8px;
+      }
+
+      .roast-option-name {
+        font-weight: bold;
+        color: var(--primary);
+      }
+
+      .roast-option-note {
+        display: block;
+        font-size: 0.75rem;
+        line-height: 1.3;
+        color: #6d4c41;
+      }
+
+      .roast-light .roast-option-img {
+        filter: brightness(1.35) saturate(0.8) sepia(0.35);
+      }
+
+      .roast-dark .roast-option-img {
+        filter: brightness(0.6) contrast(1.15);
+      }
+    }
+
