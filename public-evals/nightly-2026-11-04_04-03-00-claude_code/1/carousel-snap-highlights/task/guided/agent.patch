       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Seasonal Favorites carousel */
+    .seasonal {
+      /* Lets the carousel size its items and edge padding from the section width */
+      container-type: inline-size;
+    }
+
+    .carousel {
+      --item-width: min(280px, 75cqi);
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: contain;
+      /* Room above/below for the 1.15 scale + shadow so it isn't clipped,
+         and inline padding so the first/last cards can reach the center */
+      padding-block: 40px;
+      padding-inline: calc(50cqi - var(--item-width) / 2);
+      margin-top: 10px;
+      border-radius: 8px;
+    }
+
+    .carousel:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      /* Makes this item queryable with @container scroll-state(snapped) */
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+    }
+
+    /* Highlight only for users who haven't asked for reduced motion.
+       With reduced motion, cards stay grey and static: no scale, no color change. */
+    @media (prefers-reduced-motion: no-preference) {
+      .carousel .card {
+        transition:
+          scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+          background-color 0.4s,
+          color 0.4s,
+          box-shadow 0.4s;
+      }
+
+      @container scroll-state(snapped: x) {
+        .card {
+          scale: 1.15;
+          background: #007bff;
+          color: white;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.35);
+        }
+
+        .card h3 {
+          color: white;
+        }
+      }
+
+      /* JS fallback for browsers without scroll-state queries */
+      .carousel-item.is-snapped .card {
+        scale: 1.15;
+        background: #007bff;
+        color: white;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.35);
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: white;
+      }
+    }
+
