+  <script>
+    // Fallback highlight for browsers without CSS scroll-state queries (Firefox, Safari).
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          entry.target.classList.toggle('is-snapped', entry.isIntersecting);
+        });
+      }, {
+        root: carousel,
+        // An item counts as "snapped" when it crosses the middle 2% of the carousel
+        rootMargin: '0px -49%'
+      });
+      carousel.querySelectorAll('.carousel-item').forEach((item) => observer.observe(item));
+    }
+  </script>
