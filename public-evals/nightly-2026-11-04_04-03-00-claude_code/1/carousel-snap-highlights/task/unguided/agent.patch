+    /* Seasonal Favorites Carousel */
+    .carousel {
+      --item-width: 260px;
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      -webkit-overflow-scrolling: touch;
+      /* Vertical room so the 1.15 scaled card + shadow isn't clipped;
+         inline padding lets the first/last cards snap to the center. */
+      padding: 40px max(20px, calc(50% - var(--item-width) / 2));
+      margin-top: 20px;
+    }
+
+    .carousel:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      scroll-snap-stop: always;
+      /* Lets descendants query whether this item is currently snapped */
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      box-shadow: none;
+      transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
+    }
+
+    .carousel .card h3,
+    .carousel .card p {
+      transition: color 0.3s ease;
+    }
+
+    /* Snapped/centered card (native CSS scroll-state queries) */
+    @container scroll-state(snapped: x) {
+      .card {
+        transform: scale(1.15);
+        background: #007bff;
+        color: white;
+        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
+      }
+
+      .card h3 {
+        color: white;
+      }
+    }
+
+    /* Same styles, applied via JS in browsers without scroll-state support */
+    .carousel-item.is-snapped .card {
+      transform: scale(1.15);
+      background: #007bff;
+      color: white;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
+    }
+
+    .carousel-item.is-snapped .card h3 {
+      color: white;
+    }
+
+    /* Reduced motion: no scaling, no animated transitions */
+    @media (prefers-reduced-motion: reduce) {
+      .carousel {
+        scroll-behavior: auto;
+      }
+
+      .carousel .card,
+      .carousel .card h3,
+      .carousel .card p {
+        transition: none !important;
+      }
+
+      .carousel .card,
+      .carousel-item.is-snapped .card {
+        transform: none !important;
+      }
+    }
+
