diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,37 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Scroll-driven reveal: cards grow from half size as they enter the
+       viewport and shrink back as they leave. Pure CSS, applied only when
+       supported and when the user hasn't asked for reduced motion. Otherwise
+       the cards just show at full size. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        @keyframes card-grow {
+          from {
+            scale: 0.5;
+          }
+        }
+
+        @keyframes card-shrink {
+          to {
+            scale: 0.5;
+          }
+        }
+
+        .card {
+          animation:
+            card-grow auto linear backwards,
+            card-shrink auto linear forwards;
+          /* Must come after the `animation` shorthand, which resets it */
+          animation-timeline: view();
+          animation-range: entry, exit;
+        }
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
