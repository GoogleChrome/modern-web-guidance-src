+  <script>
+    // Progressive enhancement: only add scroll animations if aos.js actually
+    // loaded (it won't if its integrity check fails or the CDN is unreachable),
+    // so the cards are never left hidden by aos.css.
+    window.addEventListener('DOMContentLoaded', function () {
+      if (!window.AOS) return;
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+      document.querySelectorAll('.card').forEach(function (card, i) {
+        card.setAttribute('data-aos', 'fade-up');
+        card.setAttribute('data-aos-delay', String(i * 100));
+      });
+      AOS.init({ once: true, duration: 600 });
+    });
+  </script>
