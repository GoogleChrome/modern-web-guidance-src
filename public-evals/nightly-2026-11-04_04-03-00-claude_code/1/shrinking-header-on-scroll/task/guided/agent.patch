+  <script>
+    // Fallback for browsers without scroll-driven animations (Firefox,
+    // older Safari/Chrome, legacy browsers). Written in ES5 so it runs on
+    // old engines too; mirrors the CSS keyframes above.
+    (function () {
+      var supportsSDA = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsSDA) return;
+
+      var reduceMotion = window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (reduceMotion) return;
+
+      var nav = document.querySelector('nav');
+      var logo = nav && nav.querySelector('.logo');
+      if (!nav || !logo) return;
+
+      var START_HEIGHT = 80;
+      var END_HEIGHT = 52;
+      var END_SCALE = 0.8;
+      var SCROLL_DISTANCE = 120;
+      var ticking = false;
+      var raf = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); };
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var p = Math.max(0, Math.min(1, y / SCROLL_DISTANCE));
+        var scale = 1 - (1 - END_SCALE) * p;
+
+        nav.style.height = (START_HEIGHT - (START_HEIGHT - END_HEIGHT) * p) + 'px';
+        nav.style.boxShadow = '0 2px 10px rgba(0, 0, 0, ' + (0.35 * p).toFixed(3) + ')';
+        logo.style.webkitTransform = 'scale(' + scale + ')';
+        logo.style.transform = 'scale(' + scale + ')';
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          raf(update);
+        }
+      }
+
+      var passive = false;
+      try {
+        window.addEventListener('test', null, Object.defineProperty({}, 'passive', {
+          get: function () { passive = { passive: true }; }
+        }));
+      } catch (e) {}
+
+      window.addEventListener('scroll', onScroll, passive);
+      window.addEventListener('resize', onScroll, passive);
+      update();
+    })();
+  </script>
+
