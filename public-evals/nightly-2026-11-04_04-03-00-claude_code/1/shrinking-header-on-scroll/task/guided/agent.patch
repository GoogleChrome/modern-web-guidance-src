     /* Navigation */
+    /* Nav is fixed (out of flow) so shrinking it never changes the
+       document's scroll length; body padding reserves its full height. */
+    html {
+      scroll-padding-top: 80px;
+    }
+
+    body {
+      padding-top: 80px;
+    }
+
     nav {
       background: var(--primary);
       color: white;
-      padding: 1rem 5%;
+      padding: 0 5%;
+      height: 80px;
       display: flex;
       justify-content: space-between;
       align-items: center;
-      position: sticky;
+      position: fixed;
       top: 0;
+      left: 0;
