+  <script>
+    /* Fallback for browsers without CSS scroll-driven animations
+       (e.g. older Safari/Firefox/Chrome, IE11): reproduce the same
+       scroll-linked shrink by interpolating inline styles from scrollY.
+       Written in ES5 with no CSS custom properties so it works everywhere. */
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll()');
+      if (supportsScrollTimeline) return;
+
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+      var logo = nav.querySelector('.logo');
+
+      // Pseudo-elements can't be styled from JS, so use a real element.
+      var shadow = document.createElement('div');
+      shadow.setAttribute('aria-hidden', 'true');
+      var st = shadow.style;
+      st.position = 'absolute';
+      st.left = '0';
+      st.right = '0';
+      st.top = '100%';
+      st.height = '10px';
+      st.pointerEvents = 'none';
+      st.opacity = '0';
+      st.background = 'linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0))';
+      nav.appendChild(shadow);
+      nav.className += ' nav-js-fallback'; // hides the ::after version
+
+      var RANGE = 160;               // px of scroll over which to shrink
+      var MAX_H = 80, MIN_H = 52;    // 5rem -> 3.25rem at 16px root
+      var MIN_SCALE = 0.8;
+
+      var raf = window.requestAnimationFrame ||
+        window.webkitRequestAnimationFrame ||
+        function (cb) { return setTimeout(cb, 16); };
+      var ticking = false;
+      var last = -1;
+
+      function getScrollY() {
+        return window.pageYOffset ||
+          document.documentElement.scrollTop || document.body.scrollTop || 0;
+      }
+
+      function update() {
+        ticking = false;
+        var p = Math.min(Math.max(getScrollY() / RANGE, 0), 1);
+        if (p === last) return;
+        last = p;
+        nav.style.minHeight = (MAX_H - (MAX_H - MIN_H) * p) + 'px';
+        if (logo) {
+          var t = 'scale(' + (1 - (1 - MIN_SCALE) * p) + ')';
+          logo.style.webkitTransform = t;
+          logo.style.msTransform = t;
+          logo.style.transform = t;
+        }
+        shadow.style.opacity = String(p);
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          raf(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, false);
+      window.addEventListener('resize', onScroll, false);
+      update();
+    })();
+  </script>
