diff --git a/config-migration.js b/config-migration.js
new file mode 100644
index 0000000..1bdbe8f
--- /dev/null
+++ b/config-migration.js
@@ -0,0 +1,50 @@
+// Imports user configuration from the legacy origin after the PWA origin
+// migration. Browsers move the installed app (and its OS shortcuts) to the new
+// origin, but NOT localStorage/permissions, so we pull it over once.
+(function () {
+  var LEGACY_ORIGIN = 'https://www.dailygrind.example';
+  var PREFIX = 'dg:';
+  var DONE_KEY = 'dg:configMigrated';
+  var TIMEOUT_MS = 5000;
+
+  try {
+    if (location.origin === LEGACY_ORIGIN || localStorage.getItem(DONE_KEY)) return;
+  } catch (e) { return; }
+
+  var iframe = document.createElement('iframe');
+  iframe.src = LEGACY_ORIGIN + '/config-export.html';
+  iframe.hidden = true;
+  iframe.setAttribute('aria-hidden', 'true');
+  iframe.tabIndex = -1;
+
+  var timer;
+  function cleanup() {
+    clearTimeout(timer);
+    window.removeEventListener('message', onMessage);
+    iframe.remove();
+  }
+
+  function onMessage(event) {
+    if (event.origin !== LEGACY_ORIGIN || event.source !== iframe.contentWindow) return;
+    if (!event.data || event.data.type !== 'dg-config-export') return;
+    var config = event.data.config || {};
+    try {
+      Object.keys(config).forEach(function (key) {
+        // Only accept namespaced keys; never clobber values already set here.
+        if (key.indexOf(PREFIX) !== 0 || typeof config[key] !== 'string') return;
+        if (localStorage.getItem(key) === null) localStorage.setItem(key, config[key]);
+      });
+      localStorage.setItem(DONE_KEY, new Date().toISOString());
+      iframe.contentWindow.postMessage({ type: 'dg-config-imported' }, LEGACY_ORIGIN);
+      document.dispatchEvent(new CustomEvent('dg:config-migrated', { detail: { keys: Object.keys(config) } }));
+    } catch (e) { /* storage unavailable; retry next launch */ }
+    cleanup();
+  }
+
+  window.addEventListener('message', onMessage);
+  iframe.addEventListener('load', function () {
+    iframe.contentWindow.postMessage({ type: 'dg-config-request' }, LEGACY_ORIGIN);
+  });
+  timer = setTimeout(cleanup, TIMEOUT_MS); // legacy origin unreachable: retry next launch
+  (document.body || document.documentElement).appendChild(iframe);
+})();
