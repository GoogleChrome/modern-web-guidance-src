index 0000000..529cdbf
--- /dev/null
+++ b/legacy-origin/README.md
@@ -0,0 +1,22 @@
+# Legacy origin files (https://www.dailygrind.example)
+
+Deploy these to the **old** origin so installed apps move to
+`https://app.dailygrind.example/` (the root of this repo):
+
+| File | Purpose |
+| --- | --- |
+| `.well-known/web-app-origin-association` | Old origin allows the new app id to take over its install (required). Serve as `application/json`. |
+| `manifest.webmanifest` | Legacy manifest with `migrate_to`, so the browser can offer the move without the user visiting the new site first. Its `shortcuts` match the new manifest. |
+| `install.html` | `install_url` named in the new manifest's `migrate_from`. **Must not redirect.** |
+| `config-export.html` | Same-site bridge that hands `dg:*` localStorage settings to the new origin. **Must not redirect.** |
+
+Everything else on the old origin can 301 to the new origin.
+
+Both origins must be same-site (same eTLD+1). The browser moves the install
+itself: OS launcher, dock, and taskbar shortcuts plus the app window. It does
+**not** move storage or permissions, so `/config-migration.js` on the new
+origin imports `dg:*` settings once. It never overwrites values already set on
+the new origin.
+
+To switch to a "force" migration later, set `"behavior": "force"` in
+`migrate_from` in `/manifest.webmanifest`.
diff --git a/legacy-origin/config-export.html b/legacy-origin/config-export.html
new file mode 100644
index 0000000..1502363
--- /dev/null
+++ b/legacy-origin/config-export.html
@@ -0,0 +1,32 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <!-- Must NOT redirect. Loaded in a hidden iframe by the new origin to hand
+       over user configuration, since browsers do not migrate storage. -->
+  <title>Daily Grind config export</title>
+</head>
+<body>
+<script>
+  (function () {
+    var NEW_ORIGIN = 'https://app.dailygrind.example';
+    var PREFIX = 'dg:';
+    window.addEventListener('message', function (event) {
+      if (event.origin !== NEW_ORIGIN || !event.data) return;
+      if (event.data.type === 'dg-config-request') {
+        var config = {};
+        try {
+          for (var i = 0; i < localStorage.length; i++) {
+            var key = localStorage.key(i);
+            if (key && key.indexOf(PREFIX) === 0) config[key] = localStorage.getItem(key);
+          }
+        } catch (e) { /* storage unavailable */ }
+        event.source.postMessage({ type: 'dg-config-export', config: config }, NEW_ORIGIN);
+      } else if (event.data.type === 'dg-config-imported') {
+        try { localStorage.setItem('dg:migratedTo', NEW_ORIGIN); } catch (e) {}
+      }
+    });
+  })();
+</script>
+</body>
+</html>
