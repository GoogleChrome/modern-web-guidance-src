diff --git a/legacy-origin/migration-banner.html b/legacy-origin/migration-banner.html
new file mode 100644
index 0000000..c0ce46f
--- /dev/null
+++ b/legacy-origin/migration-banner.html
@@ -0,0 +1,26 @@
+<!--
+  Fallback for browsers without Web App Origin Migration (Firefox, Safari,
+  Chromium < 149). Paste just before </body> on the OLD origin
+  (https://app.dailygrind.example.com). Only shown to users running the
+  installed app, so regular browser-tab visitors are not nagged.
+-->
+<aside id="move-notice" role="status" hidden
+  style="position:fixed;inset:auto 1rem 1rem;z-index:2000;display:flex;gap:1rem;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-radius:8px;background:#4e342e;color:#fff;box-shadow:0 4px 12px rgb(0 0 0 / .25)">
+  <p style="margin:0">The Daily Grind app has moved. Open it at its new home and reinstall to keep your shortcut working.</p>
+  <span style="display:flex;gap:.5rem;flex-shrink:0">
+    <a href="https://dailygrind.example.com/" style="background:#ffab40;color:#3e2723;padding:.5rem 1rem;border-radius:5px;text-decoration:none;font-weight:600">Go to new app</a>
+    <button type="button" id="move-notice-dismiss" style="background:none;border:1px solid #ffab40;color:#fff;padding:.5rem 1rem;border-radius:5px;cursor:pointer">Later</button>
+  </span>
+</aside>
+<script>
+  (() => {
+    const notice = document.getElementById('move-notice');
+    const installed = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
+    if (!installed || sessionStorage.getItem('move-notice-dismissed')) return;
+    notice.hidden = false;
+    document.getElementById('move-notice-dismiss').addEventListener('click', () => {
+      sessionStorage.setItem('move-notice-dismissed', '1');
+      notice.hidden = true;
+    });
+  })();
+</script>
