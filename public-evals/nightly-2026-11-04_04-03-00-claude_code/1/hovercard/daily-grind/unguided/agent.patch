+    (function () {
+      var OPEN_DELAY = 250;
+      var CLOSE_DELAY = 200;
+      var VIEWPORT_PAD = 12;
+      var current = null;
+
+      function position(wrap) {
+        var card = wrap.querySelector('.hc-card');
+        card.style.setProperty('--hc-shift', '0px');
+        card.classList.remove('hc-above');
+
+        var trigger = wrap.querySelector('.hc-trigger').getBoundingClientRect();
+        var height = card.offsetHeight;
+        var width = card.offsetWidth;
+        var vw = document.documentElement.clientWidth;
+        var vh = window.innerHeight;
+        var navH = (document.querySelector('nav') || { offsetHeight: 0 }).offsetHeight;
+
+        // Flip above the link when there isn't room below but there is above.
+        if (trigger.bottom + height > vh && trigger.top - height > navH) {
+          card.classList.add('hc-above');
+        }
+
+        // Keep the card horizontally inside the viewport.
+        var center = trigger.left + trigger.width / 2;
+        var left = center - width / 2;
+        var shift = 0;
+        if (left < VIEWPORT_PAD) shift = VIEWPORT_PAD - left;
+        else if (left + width > vw - VIEWPORT_PAD) shift = vw - VIEWPORT_PAD - (left + width);
+        card.style.setProperty('--hc-shift', shift + 'px');
+      }
+
+      function open(wrap) {
+        clearTimeout(wrap._hcClose);
+        if (current && current !== wrap) close(current);
+        if (wrap.classList.contains('is-open')) return;
+        position(wrap);
+        wrap.classList.add('is-open');
+        wrap.querySelector('.hc-trigger').setAttribute('aria-expanded', 'true');
+        current = wrap;
+      }
+
+      function close(wrap) {
+        clearTimeout(wrap._hcOpen);
+        clearTimeout(wrap._hcClose);
