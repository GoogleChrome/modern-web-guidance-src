+        wrap.querySelector('.hc-trigger').setAttribute('aria-expanded', 'false');
+        if (current === wrap) current = null;
+      }
+
+      function scheduleOpen(wrap, delay) {
+        clearTimeout(wrap._hcClose);
+        clearTimeout(wrap._hcOpen);
+        wrap._hcOpen = setTimeout(function () { open(wrap); }, delay);
+      }
+
+      function scheduleClose(wrap) {
+        clearTimeout(wrap._hcOpen);
+        clearTimeout(wrap._hcClose);
+        wrap._hcClose = setTimeout(function () { close(wrap); }, CLOSE_DELAY);
+      }
+
+      document.querySelectorAll('[data-hovercard]').forEach(function (wrap) {
