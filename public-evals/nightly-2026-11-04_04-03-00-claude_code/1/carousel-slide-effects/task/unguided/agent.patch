     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product carousel */
+    .carousel {
+      margin: 60px 0 0;
+    }
+
+    .carousel-header {
+      max-width: 1100px;
+      margin: 0 auto;
+      padding: 0 20px;
+      text-align: center;
+    }
+
+    .carousel-header p {
+      color: #6d4c41;
+    }
+
+    .scroller {
+      --card-width: min(260px, 72vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-inline: contain;
+      scroll-snap-type: inline mandatory;
+      /* Let the first and last cards reach the center of the viewport */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .scroller > li {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      /* Each item tracks its own visibility within the scroller */
+      view-timeline: --product-card inline;
+    }
+
+    .product-card {
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      background: white;
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
+      transform-origin: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .card-body {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      padding: 16px 18px 20px;
+      text-align: center;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      color: #6d4c41;
+      margin-bottom: 6px;
+    }
+
+    .product-card .btn {
+      margin-top: auto;
+      align-self: center;
+    }
+
+    .product-card .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /*
+     * Scale cards up as they approach the center of the scroller and down as
+     * they move away, driven purely by CSS scroll-driven animations.
+     * Browsers without support simply show static, full-size cards, and users
+     * who prefer reduced motion never get the effect.
+     */
+    @keyframes card-focus {
+      0%, 100% {
+        transform: scale(0.8);
+        opacity: 0.7;
+      }
+
+      50% {
+        transform: scale(1.08);
+        opacity: 1;
+      }
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: card-focus linear both;
+          animation-timeline: --product-card;
+        }
+      }
+    }
+
