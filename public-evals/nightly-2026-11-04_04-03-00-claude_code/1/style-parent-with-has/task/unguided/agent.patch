diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,77 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact form {
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .field {
+      border: 2px solid transparent;
+      border-radius: 6px;
+      padding: 10px;
+      margin-bottom: 12px;
+      transition: border-color 0.2s;
+    }
+
+    .field label {
+      display: block;
+      font-weight: 600;
+      margin-bottom: 6px;
+      color: var(--primary);
+    }
+
+    .field input,
+    .field textarea {
+      width: 100%;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      color: inherit;
+    }
+
+    .field textarea {
+      min-height: 120px;
+      resize: vertical;
+    }
+
+    .field input:focus,
+    .field textarea:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    /* Red border on the wrapper when its input is invalid.
+       :user-invalid only kicks in after the user has interacted with the
+       field (or tried to submit), so the form isn't red on page load. */
+    .field:has(:user-invalid) {
+      border-color: #d32f2f;
+    }
+
+    .contact .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+      margin-top: 4px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
@@ -196,8 +265,28 @@
       </div>
     </section>
   </main>
 
+  <section class="contact" id="contact">
+    <h2>Get in Touch</h2>
+    <form action="/contact" method="post">
+      <div class="field">
+        <label for="contact-name">Name</label>
+        <input type="text" id="contact-name" name="name" autocomplete="name" required>
+      </div>
+      <div class="field">
+        <label for="contact-email">Email</label>
+        <input type="email" id="contact-email" name="email" autocomplete="email" required
+          pattern="[^@\s]+@[^@\s]+\.[^@\s]+" title="Please enter a valid email address, e.g. you@example.com">
+      </div>
+      <div class="field">
+        <label for="contact-message">Message</label>
+        <textarea id="contact-message" name="message" required></textarea>
+      </div>
+      <button type="submit" class="btn">Send Message</button>
+    </form>
+  </section>
+
   <footer>
     <div class="footer-links">
       <a href="/about">Our Story</a> |
       <a href="/careers">Join the Team</a> |
