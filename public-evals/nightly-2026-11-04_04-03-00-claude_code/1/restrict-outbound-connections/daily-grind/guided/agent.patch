+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="stylesheet" href="/styles.css">
+  <script src="/app.js" defer></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section class="newsletter" aria-labelledby="newsletter-title">
+      <img class="newsletter-photo"
+        src="https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80"
+        alt="Freshly roasted coffee beans" width="800" height="533" loading="lazy" decoding="async">
+      <div class="newsletter-body">
+        <h2 id="newsletter-title">Join the Grind Newsletter</h2>
+        <p>New roasts, seasonal drinks, and member-only offers, delivered once a month.</p>
+        <form id="newsletter-form" class="newsletter-form" action="/api/newsletter" method="post">
+          <label for="newsletter-email">Email address</label>
+          <div class="newsletter-row">
+            <input id="newsletter-email" name="email" type="email" autocomplete="email" required
+              maxlength="254" placeholder="you@example.com">
+            <button type="submit" class="btn">Subscribe</button>
+          </div>
+          <p id="newsletter-status" class="newsletter-status" role="status" aria-live="polite"></p>
+        </form>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..4d8f66e
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,243 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  margin-top: 60px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  overflow: hidden;
+}
+
+.newsletter-photo {
+  width: 100%;
+  height: 100%;
+  min-height: 220px;
+  object-fit: cover;
+  display: block;
+}
+
+.newsletter-body {
+  padding: 30px;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 10px;
+}
+
+.newsletter-body h2 {
+  color: var(--primary);
+}
+
+.newsletter-form label {
+  display: block;
+  font-weight: 600;
+  margin-top: 10px;
+}
+
+.newsletter-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  align-items: center;
+}
+
+.newsletter-row input {
+  flex: 1 1 200px;
+  padding: 10px 12px;
+  font: inherit;
+  border: 1px solid #a1887f;
+  border-radius: 5px;
+}
+
+.newsletter-row input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.newsletter-row input:user-invalid {
+  border-color: #c62828;
+}
+
+.newsletter-form .btn {
+  margin-top: 0;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-form .btn:disabled {
+  opacity: 0.6;
+  cursor: progress;
+}
+
+.newsletter-status:empty {
+  display: none;
+}
+
+.newsletter-status {
+  margin-top: 10px;
+  padding: 10px 12px;
+  border-radius: 5px;
+}
+
+.newsletter-status[data-state="success"] {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.newsletter-status[data-state="error"] {
+  background: #ffebee;
+  color: #b71c1c;
+}
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..a1342f4
--- /dev/null
+++ b/server.js
@@ -0,0 +1,228 @@
+// Small dependency-free Node server for the Daily Grind homepage.
+// It exists so we control response headers: every document is served with a
+// Connection-Allowlist (network-layer allowlist) plus a Content-Security-Policy
+// fallback for browsers that don't support Connection-Allowlist yet. Together
+// they restrict the page to our own origin and the Unsplash image host, so an
+// injected script can't send customer data anywhere else.
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { extname, join, normalize, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const PUBLIC_DIR = join(ROOT, 'public');
+const DATA_DIR = join(ROOT, 'data');
+const PORT = Number(process.env.PORT) || 11222;
+const MAX_BODY_BYTES = 8 * 1024;
+
+// The only third-party host the page may contact.
+const UNSPLASH = 'https://images.unsplash.com';
+
+// Connection-Allowlist is an RFC 9651 Inner List: unquoted `response-origin`
+// token + double-quoted URLPatterns, space-separated, no trailing slash on
+// origins. A malformed value fails closed (blocks everything), so keep it literal.
+// Redirects and WebRTC stay blocked (the defaults).
+const CONNECTION_ALLOWLIST = `(response-origin "${UNSPLASH}"); report-to=security`;
+
+// CSP fallback for browsers without Connection-Allowlist (Firefox, Safari).
+// No 'unsafe-inline': all script/style lives in external same-origin files.
+// form-action must be explicit: it does not fall back to default-src.
+const CSP = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${UNSPLASH}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "media-src 'self'",
+  "frame-src 'none'",
+  "worker-src 'self'",
+  "manifest-src 'self'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+  "require-trusted-types-for 'script'",
+  'report-to security',
+].join('; ');
+
+// Destinations on which browsers honor Connection-Allowlist.
+const POLICY_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.txt': 'text/plain; charset=utf-8',
+};
+
+function setBaseHeaders(req, res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+  res.setHeader('Vary', 'Sec-Fetch-Dest');
+
+  // Browsers only read these on document/worker responses; sending them on every
+  // response from a navigation (or a client without Sec-Fetch-Dest) is harmless.
+  const dest = String(req.headers['sec-fetch-dest'] || 'document').toLowerCase();
+  if (POLICY_DESTS.has(dest)) {
+    res.setHeader('Reporting-Endpoints', 'security="/api/security-reports"');
+    res.setHeader('Connection-Allowlist', CONNECTION_ALLOWLIST);
+    res.setHeader('Content-Security-Policy', CSP);
+  }
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+// Minimal page for the no-JavaScript form submission path. We respond directly
+// rather than redirecting, because Connection-Allowlist blocks redirects.
+function sendHtmlMessage(res, status, title, message) {
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(`<!DOCTYPE html>
+<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>${escapeHtml(title)} | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head>
+<body><main class="container"><h1>${escapeHtml(title)}</h1><p>${escapeHtml(message)}</p>
+<a class="btn" href="/">Back to the homepage</a></main></body></html>`);
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Request body too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+async function handleNewsletter(req, res) {
+  const type = String(req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  const wantsJson = type === 'application/json';
+  const fail = (status, message) =>
+    wantsJson ? sendJson(res, status, { error: message }) : sendHtmlMessage(res, status, 'Signup failed', message);
+
+  // Reject cross-site form posts (CSRF-style abuse of the endpoint).
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') {
+    return fail(403, 'Cross-site requests are not allowed.');
+  }
+
+  let email;
+  try {
+    const raw = await readBody(req);
+    if (wantsJson) email = JSON.parse(raw).email;
+    else if (type === 'application/x-www-form-urlencoded') email = new URLSearchParams(raw).get('email');
+    else return fail(415, 'Unsupported content type.');
+  } catch (err) {
+    return fail(err.status || 400, err.status ? err.message : 'Invalid request.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return fail(422, 'Please enter a valid email address.');
+  }
+
+  try {
+    await mkdir(DATA_DIR, { recursive: true });
+    await appendFile(
+      join(DATA_DIR, 'subscribers.jsonl'),
+      `${JSON.stringify({ email, subscribedAt: new Date().toISOString() })}\n`,
+    );
+  } catch (err) {
+    console.error('Failed to store subscriber:', err);
+    return fail(500, 'Something went wrong on our end. Please try again later.');
+  }
+
+  const message = "Thanks! You're on the list.";
+  return wantsJson ? sendJson(res, 201, { message }) : sendHtmlMessage(res, 201, 'Subscribed', message);
+}
+
+async function handleSecurityReport(req, res) {
+  try {
+    const raw = await readBody(req);
+    console.warn('[security-report]', raw);
+  } catch {
+    // Ignore malformed/oversized reports.
+  }
+  res.writeHead(204).end();
+}
+
+async function serveStatic(req, res, pathname) {
+  if (pathname === '/') pathname = '/index.html';
+  let decoded;
+  try {
+    decoded = decodeURIComponent(pathname);
+  } catch {
+    return sendHtmlMessage(res, 400, 'Bad request', 'The requested URL is invalid.');
+  }
+  const filePath = normalize(join(PUBLIC_DIR, decoded));
+  if (!filePath.startsWith(PUBLIC_DIR + sep)) {
+    return sendHtmlMessage(res, 404, 'Not found', 'That page does not exist.');
+  }
+  try {
+    const body = await readFile(filePath);
+    res.writeHead(200, {
+      'Content-Type': MIME[extname(filePath).toLowerCase()] || 'application/octet-stream',
+      'Cache-Control': extname(filePath) === '.html' ? 'no-cache' : 'public, max-age=3600',
+    });
+    if (req.method === 'HEAD') return res.end();
+    res.end(body);
+  } catch {
+    sendHtmlMessage(res, 404, 'Not found', 'That page does not exist.');
+  }
+}
+
+const server = createServer(async (req, res) => {
+  setBaseHeaders(req, res);
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  try {
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return sendJson(res, 405, { error: 'Method not allowed.' });
+      }
+      return await handleNewsletter(req, res);
+    }
+    if (pathname === '/api/security-reports') {
+      if (req.method !== 'POST') return res.writeHead(405, { Allow: 'POST' }).end();
+      return await handleSecurityReport(req, res);
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', 'GET, HEAD');
+      return sendHtmlMessage(res, 405, 'Method not allowed', 'That request method is not supported.');
+    }
+    return await serveStatic(req, res, pathname);
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendHtmlMessage(res, 500, 'Server error', 'Something went wrong. Please try again.');
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`Daily Grind running at http://localhost:${PORT}`);
+});
