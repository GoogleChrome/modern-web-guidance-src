diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000..19dc653
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,57 @@
+// Newsletter signup. The page is served with Connection-Allowlist + CSP so it can
+// only talk to our own origin (and load images from images.unsplash.com). Any
+// request that fails — offline, server error, or blocked by policy — shows the
+// customer a message instead of failing silently.
+const form = document.getElementById('newsletter-form');
+const status = document.getElementById('newsletter-status');
+
+function showStatus(state, message) {
+  status.dataset.state = state;
+  status.textContent = message;
+}
+
+if (form && status) {
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) return;
+
+    const button = form.querySelector('button[type="submit"]');
+    const email = new FormData(form).get('email');
+    button.disabled = true;
+    showStatus('pending', 'Signing you up…');
+
+    try {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify({ email }),
+        credentials: 'same-origin',
+        redirect: 'error',
+        signal: AbortSignal.timeout(10000),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        throw new Error(data.error || `HTTP ${response.status}`, { cause: 'server' });
+      }
+      form.reset();
+      showStatus('success', data.message || "Thanks! You're on the list.");
+    } catch (error) {
+      if (error.cause === 'server') {
+        showStatus('error', `Sorry, we couldn't sign you up: ${error.message}`);
+      } else if (error.name === 'TimeoutError') {
+        showStatus('error', 'The request timed out. Please check your connection and try again.');
+      } else {
+        // TypeError: offline, or the request was blocked by the page's connection policy.
+        showStatus('error', "We couldn't reach our server, so your signup didn't go through. Please try again in a moment.");
+      }
+    } finally {
+      button.disabled = false;
+    }
+  });
+}
+
+// Surface CSP blocks of connections (e.g. an injected script trying to reach another host)
+// to the console for debugging; the server also receives a violation report.
+document.addEventListener('securitypolicyviolation', (event) => {
+  console.warn(`Blocked ${event.effectiveDirective}: ${event.blockedURI}`);
+});
