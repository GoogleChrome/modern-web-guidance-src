@@ -0,0 +1,393 @@
+'use strict';
+
+/**
+ * Daily Grind homepage server.
+ *
+ * Serves the static files in ./public with strict security headers and
+ * handles newsletter signups at POST /api/newsletter. No dependencies.
+ */
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const HOST = process.env.HOST || '0.0.0.0';
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+
+const UNSPLASH_IMAGES = 'https://images.unsplash.com';
+
+// The page may only load resources from / send data to our own origin, plus
+// photos from Unsplash. No inline scripts or styles, no plugins, no framing,
+// and forms may only submit back to us. Violations are reported to our server.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${UNSPLASH_IMAGES}`,
+  "font-src 'self'",
+  "connect-src 'self'",
+  "manifest-src 'self'",
+  "media-src 'none'",
+  "object-src 'none'",
+  "frame-src 'none'",
+  "worker-src 'none'",
+  "child-src 'none'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  'upgrade-insecure-requests',
+  'report-uri /csp-report',
+  'report-to csp',
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CONTENT_SECURITY_POLICY,
+  'Reporting-Endpoints': 'csp="/csp-report"',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'same-origin',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'X-DNS-Prefetch-Control': 'off',
+  'Permissions-Policy':
+    'camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()',
+};
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.txt': 'text/plain; charset=utf-8',
+};
+
+const MAX_SIGNUP_BODY_BYTES = 1024;
+const MAX_REPORT_BODY_BYTES = 16 * 1024;
+const MAX_EMAIL_LENGTH = 254;
+const EMAIL_PATTERN = /^[^\s@<>"'`]+@[^\s@<>"'`]+\.[^\s@<>"'`]+$/;
+
+const RATE_LIMIT_WINDOW_MS = 60 * 1000;
+const RATE_LIMIT_MAX = 10;
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, payload) {
+  send(res, status, JSON.stringify(payload), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function escapeHtml(value) {
+  return String(value).replace(/[&<>"']/g, (c) => ({
+    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
+  })[c]);
+}
+
+/** Minimal HTML response for the no-JavaScript form fallback. */
+function sendHtmlMessage(res, status, title, message) {
+  const body = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container">
+    <section class="newsletter">
+      <h2>${escapeHtml(title)}</h2>
+      <p>${escapeHtml(message)}</p>
+      <a href="/" class="btn">Back to the homepage</a>
+    </section>
+  </main>
+</body>
+</html>`;
+  send(res, status, body, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function readBody(req, limit) {
+  return new Promise((resolve, reject) => {
+    const declared = Number(req.headers['content-length']);
+    if (declared > limit) {
+      reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+      req.resume();
+      return;
+    }
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > limit) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function mediaType(req) {
+  return String(req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+}
+
+/**
+ * Reject cross-site submissions. Browsers send Sec-Fetch-Site and/or Origin;
+ * if either says the request came from another site, refuse it.
+ */
+function isSameOriginRequest(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') return false;
+  const origin = req.headers.origin;
+  if (origin) {
+    try {
+      return new URL(origin).host === req.headers.host;
+    } catch {
+      return false;
+    }
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Rate limiting (in-memory, per client IP)
+// ---------------------------------------------------------------------------
+
+const rateBuckets = new Map();
+
+function isRateLimited(ip) {
+  const now = Date.now();
+  const bucket = rateBuckets.get(ip);
+  if (!bucket || now - bucket.start > RATE_LIMIT_WINDOW_MS) {
+    rateBuckets.set(ip, { start: now, count: 1 });
+    return false;
+  }
+  bucket.count += 1;
+  return bucket.count > RATE_LIMIT_MAX;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [ip, bucket] of rateBuckets) {
+    if (now - bucket.start > RATE_LIMIT_WINDOW_MS) rateBuckets.delete(ip);
+  }
+}, RATE_LIMIT_WINDOW_MS).unref();
+
+// ---------------------------------------------------------------------------
+// Subscriber storage (append-only JSON lines file)
+// ---------------------------------------------------------------------------
+
+const subscribers = new Set();
+let writeQueue = Promise.resolve();
+
+function loadSubscribers() {
+  try {
+    const lines = fs.readFileSync(SUBSCRIBERS_FILE, 'utf8').split('\n');
+    for (const line of lines) {
+      if (!line.trim()) continue;
+      try {
+        subscribers.add(JSON.parse(line).email);
+      } catch {
+        // Skip malformed lines rather than refusing to start.
+      }
+    }
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+  }
+}
+
+function saveSubscriber(email) {
+  // Serialize writes so concurrent signups never interleave.
+  const task = writeQueue.then(async () => {
+    if (subscribers.has(email)) return false;
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    const record = JSON.stringify({ email, subscribedAt: new Date().toISOString() });
+    await fsp.appendFile(SUBSCRIBERS_FILE, record + '\n', { mode: 0o600 });
+    subscribers.add(email);
+    return true;
+  });
+  writeQueue = task.catch(() => {});
+  return task;
+}
+
+// ---------------------------------------------------------------------------
+// Route handlers
+// ---------------------------------------------------------------------------
+
+async function handleNewsletter(req, res) {
+  const type = mediaType(req);
+  const isJson = type === 'application/json';
+  const isForm = type === 'application/x-www-form-urlencoded';
+
+  const fail = (status, message) =>
+    isForm
+      ? sendHtmlMessage(res, status, 'Signup didn’t go through', message)
+      : sendJson(res, status, { error: message });
+
+  if (!isJson && !isForm) {
+    return sendJson(res, 415, { error: 'Unsupported content type.' });
+  }
+  if (!isSameOriginRequest(req)) {
+    return fail(403, 'This request was not allowed.');
+  }
+  if (isRateLimited(req.socket.remoteAddress || 'unknown')) {
+    return fail(429, 'Too many attempts. Please wait a minute and try again.');
+  }
+
+  let raw;
+  try {
+    raw = await readBody(req, MAX_SIGNUP_BODY_BYTES);
+  } catch (err) {
+    return fail(err.status || 400, 'We couldn’t read your request. Please try again.');
+  }
+
+  let email;
+  try {
+    email = isJson ? JSON.parse(raw).email : new URLSearchParams(raw).get('email');
+  } catch {
+    return fail(400, 'We couldn’t read your request. Please try again.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > MAX_EMAIL_LENGTH || !EMAIL_PATTERN.test(email)) {
+    return fail(400, 'Please enter a valid email address.');
+  }
+
+  try {
+    await saveSubscriber(email);
+  } catch (err) {
+    console.error('Failed to save subscriber:', err);
+    return fail(500, 'Our server had a problem saving your signup. Please try again later.');
+  }
+
+  // Same response whether or not the address was already subscribed, so the
+  // endpoint can't be used to check who is on the list.
+  const message = 'Thanks! You’re on the list. Watch your inbox for our next issue.';
+  return isForm
+    ? sendHtmlMessage(res, 200, 'You’re subscribed', message)
+    : sendJson(res, 200, { ok: true, message });
+}
+
+async function handleCspReport(req, res) {
+  try {
+    const raw = await readBody(req, MAX_REPORT_BODY_BYTES);
+    console.warn('[csp-violation]', raw.slice(0, 2000));
+  } catch {
+    // Ignore malformed or oversized reports.
+  }
+  send(res, 204, '');
+}
+
+async function serveStatic(req, res, pathname) {
+  let decoded;
+  try {
+    decoded = decodeURIComponent(pathname);
+  } catch {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  if (decoded.includes('\0')) {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  const relative = decoded === '/' ? 'index.html' : decoded.replace(/^\/+/, '');
+  const filePath = path.resolve(PUBLIC_DIR, relative);
+  if (filePath !== PUBLIC_DIR && !filePath.startsWith(PUBLIC_DIR + path.sep)) {
+    return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  const contentType = MIME_TYPES[path.extname(filePath).toLowerCase()];
+  let stat;
+  try {
+    stat = await fsp.stat(filePath);
+  } catch {
+    stat = null;
+  }
+  if (!contentType || !stat || !stat.isFile()) {
+    return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  const headers = {
+    'Content-Type': contentType,
+    'Content-Length': stat.size,
+    'Cache-Control': contentType.startsWith('text/html') ? 'no-cache' : 'public, max-age=3600',
+  };
+  if (req.method === 'HEAD') return send(res, 200, undefined, headers);
+
+  res.writeHead(200, { ...SECURITY_HEADERS, ...headers });
+  fs.createReadStream(filePath)
+    .on('error', () => res.destroy())
+    .pipe(res);
+}
+
+// ---------------------------------------------------------------------------
+// Server
+// ---------------------------------------------------------------------------
+
+async function handleRequest(req, res) {
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      return send(res, 405, 'Method not allowed', { Allow: 'POST' });
+    }
+    return handleNewsletter(req, res);
+  }
+
+  if (pathname === '/csp-report') {
+    if (req.method !== 'POST') {
+      return send(res, 405, 'Method not allowed', { Allow: 'POST' });
+    }
+    return handleCspReport(req, res);
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method not allowed', { Allow: 'GET, HEAD' });
+  }
+  return serveStatic(req, res, pathname);
+}
+
+function createServer() {
+  return http.createServer((req, res) => {
+    handleRequest(req, res).catch((err) => {
+      console.error('Unhandled error:', err);
+      if (!res.headersSent) {
+        sendJson(res, 500, { error: 'Something went wrong. Please try again later.' });
+      } else {
+        res.destroy();
+      }
+    });
+  });
+}
+
+if (require.main === module) {
+  loadSubscribers();
+  createServer().listen(PORT, HOST, () => {
+    console.log(`Daily Grind server listening on http://${HOST}:${PORT}`);
+  });
+}
+
+module.exports = { createServer, CONTENT_SECURITY_POLICY };
