new file mode 100644
index 0000000..ac77ad0
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,111 @@
+'use strict';
+
+(function () {
+  var REQUEST_TIMEOUT_MS = 10000;
+  var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+  // ---- Site-wide "request couldn't go through" notice ----------------------
+
+  var notice = document.getElementById('request-notice');
+  var noticeText = document.getElementById('request-notice-text');
+  var noticeClose = document.getElementById('request-notice-close');
+
+  function showNotice(message) {
+    noticeText.textContent = message;
+    notice.hidden = false;
+  }
+
+  noticeClose.addEventListener('click', function () {
+    notice.hidden = true;
+  });
+
+  // The Content-Security-Policy only lets this page talk to our own server and
+  // the Unsplash photo host. If anything tries to reach somewhere else (or a
+  // request is blocked for another policy reason), let the customer know
+  // instead of failing silently.
+  var NETWORK_DIRECTIVES = ['connect-src', 'form-action', 'img-src', 'default-src'];
+  document.addEventListener('securitypolicyviolation', function (event) {
+    if (NETWORK_DIRECTIVES.indexOf(event.effectiveDirective) === -1) return;
+    showNotice(
+      'For your security, part of this page was blocked from contacting an ' +
+      'unapproved site. If something isn’t working, please refresh or try again later.'
+    );
+  });
+
+  // ---- Newsletter signup ---------------------------------------------------
+
+  var form = document.getElementById('newsletter-form');
+  var emailInput = document.getElementById('newsletter-email');
+  var status = document.getElementById('newsletter-status');
+  var submitButton = form.querySelector('button[type="submit"]');
+
+  function setStatus(message, kind) {
+    status.textContent = message;
+    status.classList.toggle('is-success', kind === 'success');
+    status.classList.toggle('is-error', kind === 'error');
+  }
+
+  function postSignup(email) {
+    var controller = typeof AbortController === 'function' ? new AbortController() : null;
+    var timer = controller && setTimeout(function () { controller.abort(); }, REQUEST_TIMEOUT_MS);
+
+    // Relative URL: always goes to our own origin (also enforced by CSP).
+    return fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+      body: JSON.stringify({ email: email }),
+      credentials: 'same-origin',
+      signal: controller ? controller.signal : undefined
+    }).finally(function () {
+      if (timer) clearTimeout(timer);
+    });
+  }
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    var email = emailInput.value.trim();
+    if (!EMAIL_PATTERN.test(email) || email.length > 254) {
+      setStatus('Please enter a valid email address.', 'error');
+      emailInput.focus();
+      return;
+    }
+
+    if (navigator.onLine === false) {
+      setStatus('You appear to be offline. Please check your connection and try again.', 'error');
+      return;
+    }
+
+    submitButton.disabled = true;
+    setStatus('Signing you up…', null);
+
+    postSignup(email)
+      .then(function (response) {
+        return response.json().catch(function () { return {}; }).then(function (data) {
+          if (response.ok) {
+            setStatus(data.message || 'Thanks! You’re on the list.', 'success');
+            form.reset();
+            return;
+          }
+          if (response.status === 429) {
+            setStatus('Too many attempts. Please wait a minute and try again.', 'error');
+          } else if (response.status >= 500) {
+            setStatus('Our server had a problem saving your signup. Please try again later.', 'error');
+          } else {
+            setStatus(data.error || 'We couldn’t sign you up. Please check your email and try again.', 'error');
+          }
+        });
+      })
+      .catch(function (err) {
+        if (err && err.name === 'AbortError') {
+          setStatus('The request timed out. Please check your connection and try again.', 'error');
+        } else {
+          // Network failure, server unreachable, or blocked by the browser.
+          setStatus('We couldn’t reach our server, so your signup didn’t go through. Please try again later.', 'error');
+        }
+      })
+      .finally(function () {
+        submitButton.disabled = false;
+      });
+  });
+})();
diff --git a/public/index.html b/public/index.html
