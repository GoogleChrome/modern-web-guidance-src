@@ -134,8 +134,63 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Vertical media scroller */
+    .media-section {
+      margin-top: 60px;
+    }
+
+    .media-scroller {
+      position: relative; /* makes offsetTop of children relative to the scroller */
+      height: 480px;
+      max-width: 640px;
+      margin: 20px auto 0;
+      padding: 16px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      scroll-snap-type: y proximity;
+      scroll-padding: 16px; /* matches padding, so the snap point equals the script's scrollTop */
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: 0 0 auto;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      scroll-snap-align: start;
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 600 / 400; /* reserves space before the image loads */
+      object-fit: cover;
+      background: #bcaaa4;
+    }
+
+    .media-card .media-body {
+      padding: 12px 16px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      font-size: 1.1rem;
+    }
+
+    /* Native initial scroll target (Chromium 133+); the inline script below covers other browsers */
+    .media-card.target {
+      scroll-initial-target: nearest;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
