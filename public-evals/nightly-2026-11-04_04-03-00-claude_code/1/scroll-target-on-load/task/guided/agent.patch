+    /* Media Feed (vertical scroll container) */
+    .media-feed {
+      position: relative; /* makes card offsetTop relative to the feed for the JS fallback */
+      height: 420px;
+      max-width: 640px;
+      margin: 20px auto 0;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      scroll-snap-type: y proximity;
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: none;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      scroll-snap-align: center;
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 9; /* reserve space before load so the target position never shifts */
+      object-fit: cover;
+      background: var(--secondary);
+    }
+
+    .media-card figcaption {
+      padding: 12px 16px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      font-size: 1.1rem;
+    }
+
+    .media-card.target {
+      scroll-initial-target: nearest;
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
