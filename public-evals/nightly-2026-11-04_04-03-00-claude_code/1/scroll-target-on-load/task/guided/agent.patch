+      <script>
+        // Fallback for browsers without `scroll-initial-target` (Firefox, Safari).
+        // Runs synchronously right after the feed is parsed, before first paint,
+        // so there's no visible jump. Sets scrollTop directly (instead of
+        // scrollIntoView) so the page itself never scrolls.
+        (() => {
