+  <script>
+    // Size each lockup line's font so its rendered text width equals the
+    // container width (the text scales; spacing is never stretched).
+    (function () {
+      var lockups = document.querySelectorAll('.fit-lockup');
+      var BASE = 100; // px, measuring size
+
+      function fit(lockup) {
+        var target = lockup.clientWidth;
+        if (!target) return;
+        if (lockup._fitWidth === target && !lockup._force) return;
+        lockup._fitWidth = target;
+        lockup._force = false;
+        lockup.querySelectorAll('.line').forEach(function (line) {
+          line.style.fontSize = BASE + 'px';
+          var w = line.getBoundingClientRect().width;
+          if (w) line.style.fontSize = (BASE * target / w) + 'px';
+        });
+      }
+
+      function fitAll() { lockups.forEach(fit); }
+
+      fitAll();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () {
+        lockups.forEach(function (el) { el._force = true; });
+        fitAll();
+      });
+      if ('ResizeObserver' in window) {
+        var ro = new ResizeObserver(fitAll);
+        lockups.forEach(function (el) { ro.observe(el); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+    })();
+  </script>
+
