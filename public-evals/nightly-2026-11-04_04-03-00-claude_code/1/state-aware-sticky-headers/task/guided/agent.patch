     }
 
+    /* Sticky section headers */
+    .menu-section {
+      margin-top: 60px;
+      /* Direct parent of the sticky element: prevents scroll-anchoring
+         oscillation when the header's padding shrinks while stuck */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the existing sticky site nav */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so the query never resolves against another container */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s;
+    }
+
+    .sticky-header h2 {
+      font-size: 1.5rem;
+      line-height: 1.3;
+    }
+
+    .sticky-header p {
+      font-size: 0.9rem;
+      opacity: 0.85;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        padding: 0.5rem 1.5rem;
+        box-shadow: 0 4px 12px rgb(0 0 0 / 0.25);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .sticky-header {
+        transition: none;
+      }
+    }
+
+    .section-body {
+      padding: 10px 0 20px;
+    }
+
+    .section-body > p {
+      margin: 20px 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
