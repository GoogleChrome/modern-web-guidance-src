+  <script>
+    // Fallback for browsers without CSS `field-sizing: content` support.
+    (function () {
+      if (CSS.supports('field-sizing', 'content')) return;
+
+      const canvas = document.createElement('canvas');
+      const ctx = canvas.getContext('2d');
+
+      function textWidth(el, text) {
+        const cs = getComputedStyle(el);
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        return ctx.measureText(text).width;
+      }
+
+      function chrome(el) {
+        const cs = getComputedStyle(el);
+        return ['paddingLeft', 'paddingRight', 'borderLeftWidth', 'borderRightWidth']
+          .reduce((sum, p) => sum + parseFloat(cs[p]), 0);
+      }
+
+      function resize(el) {
+        if (el.tagName === 'SELECT') {
+          const label = el.options[el.selectedIndex]?.text || '';
+          // Extra room for the native dropdown arrow
+          el.style.width = Math.ceil(textWidth(el, label) + chrome(el) + 28) + 'px';
+        } else if (el.tagName === 'TEXTAREA') {
+          const lines = (el.value || el.placeholder).split('\n');
+          const widest = Math.max(...lines.map(l => textWidth(el, l)));
+          el.style.width = Math.ceil(widest + chrome(el) + 4) + 'px';
+          el.style.height = 'auto';
+          const cs = getComputedStyle(el);
+          const borders = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
+          el.style.height = el.scrollHeight + borders + 'px';
+        } else {
+          const text = el.value || el.placeholder;
+          el.style.width = Math.ceil(textWidth(el, text) + chrome(el) + 4) + 'px';
+        }
+      }
+
+      document.querySelectorAll('.auto-size').forEach(el => {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => resize(el));
+        resize(el);
+      });
+      document.fonts?.ready.then(() => document.querySelectorAll('.auto-size').forEach(resize));
+    })();
+  </script>
+
