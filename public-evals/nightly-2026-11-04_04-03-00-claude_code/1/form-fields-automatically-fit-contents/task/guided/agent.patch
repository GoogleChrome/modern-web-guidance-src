     }
+    /* Feedback Form */
+    .feedback {
+      margin-top: 60px;
+    }
+
+    .feedback h2 {
+      text-align: center;
+    }
+
+    .feedback-form {
+      max-width: 600px;
+      margin: 20px auto 0;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      flex-direction: column;
+      gap: 1.25rem;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      /* Don't stretch controls to the container width; let them fit their content */
+      align-items: flex-start;
+      gap: 0.35rem;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .hint {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .feedback-form input,
+    .feedback-form textarea,
+    .feedback-form select {
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      padding: 0.6rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #8d6e63;
+      border-radius: 5px;
+      background: white;
+      /* Size each control to its content (progressive enhancement) */
+      field-sizing: content;
+    }
+
+    .feedback-form input:focus-visible,
+    .feedback-form textarea:focus-visible,
+    .feedback-form select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .feedback-form input {
+      width: auto;
+      /* Keep the field clickable when empty, and stop runaway growth */
+      min-inline-size: 15ch;
+      max-inline-size: 100%;
+    }
+
+    .feedback-form textarea {
+      height: auto;
+      /* Fixed width avoids horizontal jumps; height grows with content */
+      width: 100%;
+      min-block-size: 3lh;
+      max-block-size: 12lh;
+      resize: vertical;
+    }
+
+    .feedback-form select {
+      max-inline-size: 100%;
+      cursor: pointer;
+    }
+
+    .feedback-form button {
+      align-self: flex-start;
+      font: inherit;
+      border: none;
+      cursor: pointer;
+      margin-top: 0;
+      min-height: 48px;
+    }
+
   </style>
