+  <script>
+    (() => {
+      const order = [];
+      const countEl = document.getElementById('order-count');
+      const statusEl = document.getElementById('order-status');
+
+      // Hide the media slot if a photo fails to load so the card falls back to its text-only layout
+      document.querySelectorAll('.drink-card__media img').forEach((img) => {
+        const markBroken = () => img.closest('.drink-card__media').classList.add('is-broken');
+        if (img.complete && img.naturalWidth === 0) markBroken();
+        else img.addEventListener('error', markBroken, { once: true });
+      });
+
+      document.querySelectorAll('.drink-card__form').forEach((form) => {
+        const button = form.querySelector('.add-btn');
+        let resetTimer;
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const selected = form.querySelector('input[name="size"]:checked');
+          if (!selected) return;
+
+          const item = {
+            drink: form.dataset.drink,
+            size: selected.value,
+            price: Number(selected.dataset.price),
+          };
+          order.push(item);
+
+          countEl.textContent = order.length;
+          countEl.setAttribute('aria-label', `${order.length} item${order.length === 1 ? '' : 's'} in order`);
+          countEl.classList.remove('bump');
+          void countEl.offsetWidth; // restart animation
+          countEl.classList.add('bump');
+
+          const sizeLabel = item.size.charAt(0).toUpperCase() + item.size.slice(1);
+          statusEl.textContent = `Added ${sizeLabel} ${item.drink} ($${item.price.toFixed(2)}) to your order.`;
+
+          button.dataset.state = 'added';
+          button.textContent = 'Added \u2713';
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(() => {
+            delete button.dataset.state;
+            button.textContent = 'Add to Order';
+          }, 1600);
+        });
+      });
+    })();
+  </script>
+
