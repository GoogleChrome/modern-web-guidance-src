+  <script>
+    (() => {
+      const STORAGE_KEY = 'dailyGrindOrder';
+      const countEl = document.querySelector('.order-count');
+      const statusEl = document.querySelector('.order-status');
+
+      const readOrder = () => {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []; }
+        catch { return []; }
+      };
+      const writeOrder = (order) => {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch { /* storage unavailable */ }
+      };
+      const renderCount = (order) => {
+        countEl.textContent = order.reduce((n, line) => n + line.qty, 0);
+      };
+      const formatPrice = (value) => `$${Number(value).toFixed(2)}`;
+
+      renderCount(readOrder());
+
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const priceEl = form.querySelector('.price');
+        const button = form.querySelector('.add-to-order');
+        const name = form.closest('.product-card').querySelector('h3').textContent.trim();
+        let resetTimer;
+
+        form.addEventListener('change', (event) => {
+          if (event.target.matches('input[type="radio"]')) {
+            priceEl.value = formatPrice(event.target.dataset.price);
+          }
+        });
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const choice = form.querySelector('input[name="size"]:checked');
+          if (!choice) return;
+
+          const item = form.elements.item.value;
+          const size = choice.value;
+          const order = readOrder();
+          const line = order.find((l) => l.item === item && l.size === size);
+          if (line) line.qty += 1;
+          else order.push({ item, name, size, price: Number(choice.dataset.price), qty: 1 });
+          writeOrder(order);
+          renderCount(order);
+
+          const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+          statusEl.textContent = `Added a ${sizeLabel} ${name} (${formatPrice(choice.dataset.price)}) to your order.`;
+
+          button.classList.add('is-added');
+          button.firstChild.textContent = 'Added ✓';
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(() => {
+            button.classList.remove('is-added');
+            button.firstChild.textContent = 'Add to order';
+          }, 1500);
+        });
+      });
+    })();
+  </script>
+
