+  <script>
+    (() => {
+      const toggle = document.querySelector('.menu-toggle');
+      const drawer = document.getElementById('nav-drawer');
+      const scroller = drawer.querySelector('.drawer-scroller');
+      const scrim = drawer.querySelector('.drawer-scrim');
+      const spacer = drawer.querySelector('.drawer-spacer');
+      const closeBtn = drawer.querySelector('.drawer-close');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // 'closed' | 'opening' | 'open' | 'closing'
+      let state = 'closed';
+      let settleTimer;
+
+      const maxScroll = () => scroller.scrollWidth - scroller.clientWidth;
+      const behavior = () => (reduceMotion.matches ? 'auto' : 'smooth');
+
+      function updateProgress() {
+        const max = maxScroll();
+        const progress = max > 0 ? 1 - scroller.scrollLeft / max : 0;
+        scrim.style.setProperty('--drawer-progress', Math.min(1, Math.max(0, progress)).toFixed(3));
+      }
+
+      // Called once scrolling comes to rest (scrollend or debounced scroll).
+      function settle() {
+        clearTimeout(settleTimer);
+        if (state === 'closed') return;
+        const max = maxScroll();
+        const left = scroller.scrollLeft;
+        if (state === 'opening') {
+          if (left <= 1) state = 'open';
+          return;
+        }
+        // Panel has been swiped (or scrolled) fully out of view.
+        if (left >= max - 1) finishClose();
+      }
+
+      function open() {
+        if (state !== 'closed') return;
+        state = 'opening';
+        drawer.showModal();
+        document.documentElement.classList.add('drawer-open');
+        toggle.setAttribute('aria-expanded', 'true');
+        // Start with the panel scrolled off-screen, then slide it in natively.
+        scroller.scrollLeft = maxScroll();
+        updateProgress();
+        requestAnimationFrame(() => {
+          scroller.scrollTo({ left: 0, behavior: behavior() });
+          if (behavior() === 'auto') settle();
+        });
+      }
+
+      function close() {
+        if (state === 'closed' || state === 'closing') return;
+        state = 'closing';
+        scroller.scrollTo({ left: maxScroll(), behavior: behavior() });
+        // Fallback in case no scroll event fires (already at the end, reduced motion, etc.).
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, behavior() === 'auto' ? 0 : 450);
+      }
+
+      function finishClose() {
+        if (drawer.open) drawer.close();
+      }
+
+      scroller.addEventListener('scroll', () => {
+        updateProgress();
+        // A user swipe during the open animation counts as interaction.
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 120);
+      }, { passive: true });
+      scroller.addEventListener('scrollend', settle);
+
+      toggle.addEventListener('click', open);
+      closeBtn.addEventListener('click', close);
+      spacer.addEventListener('click', close);
+
+      // Escape: dialog fires "cancel"; animate the close instead of snapping shut.
+      drawer.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        close();
+      });
+
+      // Runs however the dialog ends up closed.
+      drawer.addEventListener('close', () => {
+        state = 'closed';
+        clearTimeout(settleTimer);
+        document.documentElement.classList.remove('drawer-open');
+        toggle.setAttribute('aria-expanded', 'false');
+        scrim.style.setProperty('--drawer-progress', '0');
+      });
+
+      // Keep the panel aligned if the viewport changes while open.
+      window.addEventListener('resize', () => {
+        if (state === 'open') scroller.scrollLeft = 0;
+        updateProgress();
+      });
+    })();
+  </script>
+
