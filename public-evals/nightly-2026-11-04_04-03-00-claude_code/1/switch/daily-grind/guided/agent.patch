+  <script type="module">
+    // Native switch is Safari-only for now; polyfill elsewhere.
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill');
+    }
+
+    const KEY = 'pref:seasonalOffers';
+    const toggle = document.getElementById('pref-offers');
+    const status = document.getElementById('pref-offers-status');
+
+    const render = () => {
+      status.textContent = toggle.checked
+        ? 'Seasonal offers are on.'
+        : 'Seasonal offers are off.';
+    };
+
+    toggle.checked = localStorage.getItem(KEY) === 'true';
+    render();
+
+    toggle.addEventListener('change', () => {
+      localStorage.setItem(KEY, String(toggle.checked));
+      render();
+    });
+  </script>
+
