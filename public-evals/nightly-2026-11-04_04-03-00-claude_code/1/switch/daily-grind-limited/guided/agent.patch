+  <script>
+    (() => {
+      const KEY = "compact-view";
+      const toggle = document.getElementById("compact-toggle");
+      const root = document.documentElement;
+
+      const apply = (on) => {
+        root.toggleAttribute("data-compact", on);
+        toggle.checked = on;
+      };
+
+      apply(root.hasAttribute("data-compact"));
+
+      toggle.addEventListener("change", () => {
+        apply(toggle.checked);
+        try { localStorage.setItem(KEY, toggle.checked ? "on" : "off"); } catch {}
+      });
+
+      // Keep other open tabs in sync.
+      window.addEventListener("storage", (e) => {
+        if (e.key === KEY) apply(e.newValue === "on");
+      });
+    })();
+  </script>
+
