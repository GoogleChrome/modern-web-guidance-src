+    /* Promo Alert (dismissible, CSS-only) */
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    #promo-alert {
+      /* grid-template-rows 1fr -> 0fr animates to/from the content's
+         intrinsic height without hard-coding a max-height */
+      display: grid;
+      grid-template-rows: 1fr;
+      background: var(--accent);
+      color: var(--text);
+      transition:
+        grid-template-rows 0.4s ease,
+        opacity 0.3s ease,
+        visibility 0s linear 0s;
+    }
+
+    #promo-alert .promo-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    #promo-alert .promo-body {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 1rem;
+      padding: 0.75rem 3.5rem;
+      position: relative;
+      text-align: center;
+      font-size: 0.95rem;
+    }
+
+    #promo-alert a {
+      color: var(--primary);
+      font-weight: bold;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      right: 1rem;
+      top: 50%;
+      transform: translateY(-50%);
+      width: 2rem;
+      height: 2rem;
+      display: grid;
+      place-items: center;
+      border-radius: 50%;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      user-select: none;
+      transition: background 0.2s;
+    }
+
+    #alert-dismiss:hover {
+      background: rgba(0, 0, 0, 0.12);
+    }
+
+    /* Show a focus ring on the visible "button" when the hidden checkbox has keyboard focus */
+    #promo-dismissed:focus-visible + #promo-alert #alert-dismiss {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    /* Dismissed state: collapse to zero height, then hide from AT / tab order */
+    #promo-dismissed:checked + #promo-alert {
+      grid-template-rows: 0fr;
+      opacity: 0;
+      visibility: hidden;
+      transition:
+        grid-template-rows 0.4s ease,
+        opacity 0.3s ease,
+        visibility 0s linear 0.4s;
+    }
+
+    #promo-dismissed:checked {
+      visibility: hidden;
+    }
+
