+      overflow: hidden;
+    }
+
+    #faq-trigger {
+      list-style: none;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 1rem;
+      padding: 1rem 1.25rem;
+      font-weight: bold;
+      font-size: 1.05rem;
+      color: var(--primary);
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    #faq-trigger::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger:hover {
+      background: #f5f0ee;
+    }
+
+    #faq-trigger:focus-visible {
+      outline: 2px solid var(--accent);
