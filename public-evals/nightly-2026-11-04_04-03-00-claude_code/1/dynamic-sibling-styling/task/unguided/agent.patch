+    /* ------------------------------------------------------------------
+       Dynamic sibling indexing
+       --i = 1-based position among siblings, --n = number of siblings.
+       Native sibling-index()/sibling-count() are used where supported;
+       a tiny script at the end of <body> fills them in elsewhere.
+       Registered as non-inheriting integers so each item resolves its
+       own index (children never accidentally inherit a parent's value).
+       ------------------------------------------------------------------ */
+    @property --i {
+      syntax: '<integer>';
+      inherits: false;
+      initial-value: 1;
+    }
