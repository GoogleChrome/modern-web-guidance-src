+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A latte with leaf-shaped latte art in a white cup',
+        description: [
+          'Our autumn signature: a double shot of house espresso poured over velvety steamed oat milk and sweetened with pure Grade A Vermont maple syrup.',
+          'Finished with a dusting of cinnamon, it is cozy, nutty, and completely dairy-free.'
+        ],
+        price: '$5.75',
+        notes: 'Maple, toasted oats, cinnamon'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost.',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A shot of espresso in a small cup',
+        description: [
+          'A concentrated double shot pulled from our darkest small-batch roast, with a thick hazelnut crema.',
+          'Rich and intense with a lingering, bittersweet finish.'
+        ],
+        price: '$3.25',
+        notes: 'Dark chocolate, smoke, molasses'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1600&q=80',
+        alt: 'An iced coffee in a tall glass',
+        description: [
+          'Coarse-ground single-origin beans steeped in cold filtered water for 18 hours, then served over ice.',
+          'Low in acidity and naturally sweet, with an extra kick of caffeine.'
+        ],
+        price: '$4.50',
+        notes: 'Cocoa, caramel, stone fruit'
+      }
+    };
+
+    const BASE_TITLE = document.title;
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('grid');
+    const heroImg = document.getElementById('hero-img');
+    const detailTitle = document.getElementById('title');
+    const detailDescription = document.getElementById('detail-description');
+    const detailPrice = document.getElementById('detail-price');
+    const detailNotes = document.getElementById('detail-notes');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentId = null;      // id of the item shown in the detail view, or null for the list
+    let listScrollY = 0;       // restore the list's scroll position when returning
+    let activeTransition = null;
+    let morphingThumb = null;  // thumbnail carrying the temporary .vt-morph class
+
+    // Build the list view
+    for (const [id, item] of Object.entries(ITEMS)) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = `#/item/${id}`;
+      a.dataset.id = id;
+      a.innerHTML = `
+        <img src="${item.image.replace('w=1600', 'w=800')}" alt="" loading="lazy">
+        <h2 class="title"></h2>
+        <p class="blurb"></p>`;
+      a.querySelector('.title').textContent = item.title;
+      a.querySelector('.blurb').textContent = item.blurb;
+      grid.append(a);
+    }
+
+    function routeFromHash() {
+      const match = location.hash.match(/^#\/item\/([\w-]+)$/);
+      return match && ITEMS[match[1]] ? match[1] : null;
+    }
+
+    // Synchronously swap the DOM to the requested view.
+    function render(id) {
+      if (id) {
+        const item = ITEMS[id];
+        heroImg.src = item.image;
+        heroImg.alt = item.alt;
+        detailTitle.textContent = item.title;
+        detailDescription.replaceChildren(...item.description.map((text) => {
+          const p = document.createElement('p');
+          p.textContent = text;
+          return p;
+        }));
+        detailPrice.textContent = item.price;
+        detailNotes.textContent = item.notes;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        document.title = `${item.title} | The Daily Grind`;
+        window.scrollTo(0, 0);
+      } else {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        document.title = BASE_TITLE;
+        window.scrollTo(0, listScrollY);
+      }
+      currentId = id;
+    }
+
+    function clearMorph() {
+      morphingThumb?.classList.remove('vt-morph');
+      morphingThumb = null;
+    }
+
+    function navigate(id) {
+      if (id === currentId) return;
+      if (currentId === null) listScrollY = window.scrollY;
+
+      const focusTarget = id ? detailTitle : listHeading;
+      const focus = () => focusTarget.focus({ preventScroll: true });
+
+      // Finish any in-flight transition before starting a new one.
+      activeTransition?.skipTransition();
+      clearMorph();
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        render(id);
+        focus();
+        return;
+      }
+
+      // The thumbnail of the item being opened (or closed) pairs with #hero.
+      morphingThumb = grid.querySelector(`.thumbnail[data-id="${id ?? currentId}"]`);
+      morphingThumb?.classList.add('vt-morph');
+
+      const transition = document.startViewTransition(() => render(id));
+      activeTransition = transition;
+
+      transition.finished.finally(() => {
+        if (activeTransition !== transition) return; // superseded by a newer transition
+        activeTransition = null;
+        clearMorph(); // remove the temporary view-transition-names
+        focus();
+      });
+    }
+
+    grid.addEventListener('click', (event) => {
+      const thumb = event.target.closest('.thumbnail');
+      if (!thumb || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      history.pushState({ spa: true }, '', thumb.getAttribute('href'));
+      navigate(thumb.dataset.id);
+    });
+
+    function goToList(event) {
+      if (currentId === null) return; // let the link behave normally on the list view
+      event.preventDefault();
+      if (history.state?.spa) {
+        history.back(); // popstate will run the transition
+      } else {
+        history.pushState(null, '', '#/');
+        navigate(null);
+      }
+    }
+
+    document.getElementById('back-link').addEventListener('click', goToList);
+    document.getElementById('home-link').addEventListener('click', goToList);
+
+    window.addEventListener('popstate', () => navigate(routeFromHash()));
+
+    // Initial render (no transition on page load).
+    render(routeFromHash());
+  </script>
+
 </body>
 
