+  <script>
+    const IMG = (id, w) =>
+      `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&q=80`;
+
+    const ITEMS = [
+      {
+        slug: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        description: 'Our house espresso pulled over velvety steamed oat milk and finished with a drizzle of pure Vermont maple syrup. Warm, nutty, and gently sweet — autumn in a cup.',
+        photo: '1541167760496-1628856ab772',
+        alt: 'A latte with heart-shaped foam art being poured',
+        meta: ['Hot', '12 oz', 'Dairy-free'],
+      },
+      {
+        slug: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost.',
+        description: 'A double shot of our darkest roast with notes of cocoa, toasted walnut, and a whisper of smoke. Thick crema, long finish, zero apologies.',
+        photo: '1510707577719-ae7c14805e3a',
+        alt: 'A cup of espresso with rich crema on a dark table',
+        meta: ['Hot', 'Double shot', 'Dark roast'],
+      },
+      {
+        slug: 'cold-brew',
+        name: 'Cold Brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness.',
+        description: 'Coarse-ground single-origin beans steeped cold for 18 hours, then served over ice. Naturally low in acidity with a chocolatey, silky body.',
+        photo: '1461023058943-07fcbe16d735',
+        alt: 'A tall glass of iced cold brew coffee with cream',
+        meta: ['Iced', '16 oz', '18-hour steep'],
+      },
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('thumbnail-grid');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const heroImg = hero.querySelector('img');
+    const titleEl = document.getElementById('title');
+    const metaEl = document.getElementById('detail-meta');
+    const descEl = document.getElementById('detail-description');
+    const backBtn = document.getElementById('back-btn');
+
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const VT_CLASS = 'vt-morphing';
+
+    let activeTransition = null;
+    let currentSlug = null;
+    let listScrollY = 0;
+
+    // ---------- Render list ----------
+    grid.innerHTML = ITEMS.map((item) => `
+      <a class="thumbnail" href="#/${item.slug}" data-slug="${item.slug}">
+        <img src="${IMG(item.photo, 600)}" alt="" loading="lazy">
+        <div class="thumbnail-body">
+          <h2 class="title">${item.name}</h2>
+          <p>${item.blurb}</p>
+        </div>
+      </a>`).join('');
+
+    const thumbFor = (slug) => grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+
+    // ---------- Transition helpers ----------
+    function setMorphNames(container, title) {
+      container.style.viewTransitionName = 'hero';
+      title.style.viewTransitionName = 'title';
+      container.classList.add(VT_CLASS);
+      title.classList.add(VT_CLASS);
+    }
+
+    function clearMorphNames() {
+      document.querySelectorAll('.' + VT_CLASS).forEach((el) => {
+        el.style.removeProperty('view-transition-name');
+        el.classList.remove(VT_CLASS);
+        if (!el.getAttribute('style')) el.removeAttribute('style');
+        if (!el.getAttribute('class')) el.removeAttribute('class');
+      });
+    }
+
+    /**
+     * Runs `update` (which swaps the DOM) inside a view transition.
+     * `before` tags the outgoing elements; `after` tags the incoming ones.
+     */
+    function morph({ before, update, after, focusTarget }) {
+      // Finish any in-flight transition immediately so state stays consistent.
+      if (activeTransition) activeTransition.skipTransition();
+      clearMorphNames();
+
+      const finish = () => {
+        clearMorphNames();
+        focusTarget().focus({ preventScroll: true });
+      };
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        finish();
+        return;
+      }
+
+      before();
+      const transition = document.startViewTransition(() => {
+        clearMorphNames();
+        update();
+        after();
+      });
+      activeTransition = transition;
+
+      transition.finished.finally(() => {
+        if (activeTransition === transition) activeTransition = null;
+        finish();
+      });
+    }
+
+    // ---------- Views ----------
+    function fillDetail(item) {
+      heroImg.src = IMG(item.photo, 1600);
+      heroImg.alt = item.alt;
+      titleEl.textContent = item.name;
+      metaEl.innerHTML = item.meta.map((m) => `<span>${m}</span>`).join('');
+      descEl.textContent = item.description;
+      document.title = `${item.name} | The Daily Grind`;
+    }
+
+    function showDetail(slug) {
+      const item = ITEMS.find((i) => i.slug === slug);
+      if (!item) return showList();
+      const thumb = thumbFor(slug);
+      const fromList = detailPage.hidden;
+
+      if (fromList) listScrollY = window.scrollY;
+      currentSlug = slug;
+
+      morph({
+        before: () => fromList && setMorphNames(thumb, thumb.querySelector('.title')),
+        update: () => {
+          fillDetail(item);
+          listPage.hidden = true;
+          detailPage.hidden = false;
+          window.scrollTo(0, 0);
+        },
+        after: () => fromList && setMorphNames(hero, titleEl),
+        focusTarget: () => titleEl,
+      });
+    }
+
+    function showList() {
+      const slug = currentSlug;
+      const thumb = slug && thumbFor(slug);
+      const fromDetail = !detailPage.hidden && thumb;
+      currentSlug = null;
+
+      morph({
+        before: () => fromDetail && setMorphNames(hero, titleEl),
+        update: () => {
+          detailPage.hidden = true;
+          listPage.hidden = false;
+          document.title = 'The Daily Grind | Artisanal Coffee';
+          window.scrollTo(0, fromDetail ? listScrollY : 0);
+        },
+        after: () => fromDetail && setMorphNames(thumb, thumb.querySelector('.title')),
+        focusTarget: () => listHeading,
+      });
+    }
+
+    // ---------- Routing (hash-based so it works on any static host) ----------
+    function route() {
+      const slug = location.hash.replace(/^#\/?/, '');
+      if (slug && ITEMS.some((i) => i.slug === slug)) showDetail(slug);
+      else if (!listPage.hidden && detailPage.hidden) return; // already on list
+      else showList();
+    }
+
+    // Keep the browser from jumping to anchors; we restore scroll ourselves.
+    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+    grid.addEventListener('click', (e) => {
+      const thumb = e.target.closest('.thumbnail');
+      if (!thumb || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState({ fromList: true }, '', `#/${thumb.dataset.slug}`);
+      showDetail(thumb.dataset.slug);
+    });
+
+    backBtn.addEventListener('click', () => {
+      // If we navigated here from the list, go back in history; otherwise
+      // (deep link) replace the entry so Back doesn't leave the site.
+      if (history.state && history.state.fromList) history.back();
+      else {
+        history.pushState(null, '', location.pathname + location.search);
+        showList();
+      }
+    });
+
+    window.addEventListener('popstate', route);
+
+    // Initial load: render directly, no animation, no focus steal.
+    (function init() {
+      const slug = location.hash.replace(/^#\/?/, '');
+      const item = ITEMS.find((i) => i.slug === slug);
+      if (item) {
+        currentSlug = slug;
+        fillDetail(item);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+      }
+    })();
+  </script>
+
 </body>
 
