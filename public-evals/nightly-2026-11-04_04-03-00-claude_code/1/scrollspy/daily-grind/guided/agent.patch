+  <script type="module">
+    const navLinks = [...document.querySelectorAll('.section-nav a[href^="#"]')];
+
+    const setActive = (activeLink) => {
+      navLinks.forEach((link) => {
+        const isActive = link === activeLink;
+        link.classList.toggle('target-current', isActive);
+        if (isActive) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      });
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native scrollspy styles via :target-current; mirror state to aria-current.
+      const syncAriaCurrent = () => {
+        const current = document.querySelector('.section-nav a:target-current');
+        navLinks.forEach((link) => {
+          if (link === current) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: track which section crosses the vertical middle of the viewport.
+      let activeId = null;
+      const linkFor = (id) => navLinks.find((link) => link.hash === `#${id}`);
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach(({ target, isIntersecting }) => {
+          if (isIntersecting) activeId = target.id;
+          else if (activeId === target.id) activeId = null;
+        });
+        setActive(activeId ? linkFor(activeId) : null);
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      navLinks.forEach((link) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (section) observer.observe(section);
+      });
+    }
+  </script>
+
