+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var links = Array.prototype.slice.call(nav.querySelectorAll('ul a[href^="#"]'));
+      var sections = links
+        .map(function (link) { return document.getElementById(link.getAttribute('href').slice(1)); })
+        .filter(Boolean);
+      var ticking = false;
+
+      function setNavHeight() {
+        document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
+      }
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          var isActive = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function update() {
+        ticking = false;
+        // A section is "current" once its top passes a line just below the sticky nav.
+        var line = nav.offsetHeight + window.innerHeight * 0.25;
+        var current = null;
+
+        sections.forEach(function (section) {
+          if (section.getBoundingClientRect().top <= line) {
+            current = section.id;
+          }
+        });
+
+        // At the very bottom of the page, the last section may be too short to reach the line.
+        var atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
+        if (atBottom && sections.length) {
+          current = sections[sections.length - 1].id;
+        }
+
+        setActive(current);
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', function () {
+        setNavHeight();
+        onScroll();
+      });
+      window.addEventListener('load', update);
+
+      setNavHeight();
+      update();
+    })();
+  </script>
+
 </body>
 
