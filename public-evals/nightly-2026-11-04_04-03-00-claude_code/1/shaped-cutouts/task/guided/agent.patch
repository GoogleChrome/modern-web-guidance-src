+    /* Shaped sections */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section > h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    /* 1) Featured barista: organic splat mask that scales with the image box */
+    .barista-feature {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 32px;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(280px, 80vw);
+      aspect-ratio: 1;
+      height: auto;
+      object-fit: cover;
+      /* Mask uses objectBoundingBox units, so it tracks the image's dimensions */
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .barista-bio {
+      max-width: 420px;
+    }
+
+    .barista-bio h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    /* 2) Loyalty banner: unmasked text + masked decorative accent, one shadow */
+    .unified-card {
+      display: flex;
+      max-width: 640px;
+      margin: 0 auto;
+      /* drop-shadow follows the masked silhouette (box-shadow would not) */
+      filter: drop-shadow(0 6px 10px rgba(62, 39, 35, 0.25)) drop-shadow(0 2px 3px rgba(62, 39, 35, 0.2));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 28px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-body .btn:hover {
+      background: #ffc174;
+    }
+
+    .card-accent {
+      flex: 0 0 72px;
+      background-color: var(--primary); /* matches .card-body so they merge seamlessly */
+      border-radius: 0 16px 16px 0;
+      -webkit-mask-image: url(#accent-cutout-mask);
+      mask-image: url(#accent-cutout-mask);
+    }
+
+    /* 3) Promo card: circular notch on the top edge via a radial gradient mask */
+    .gradient-masked-card {
+      max-width: 420px;
+      margin: 0 auto;
+      background: linear-gradient(135deg, var(--accent), #ff7043);
+      color: var(--text);
+      padding: 48px 24px 28px; /* extra top padding keeps text clear of the notch */
+      border-radius: 16px;
+      text-align: center;
+      -webkit-mask-image: radial-gradient(circle at 50% 0, transparent 24px, #000 24.5px);
+      mask-image: radial-gradient(circle at 50% 0, transparent 24px, #000 24.5px);
+    }
+
+    .gradient-masked-card h3 {
+      margin-bottom: 8px;
+    }
+
+    @supports (not (mask-image: url(#x))) and (not (-webkit-mask-image: url(#x))) {
+      .shaped-avatar {
+        border-radius: 50%;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
