+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section > h2 {
+      text-align: center;
+      margin-bottom: 30px;
+    }
+
+    /* 1) Barista profile: SVG splat clip in objectBoundingBox units,
+       so the shape scales with whatever size the image renders at */
+    .barista-feature {
+      display: flex;
+      align-items: center;
+      gap: 40px;
+      flex-wrap: wrap;
+      justify-content: center;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(320px, 80vw);
+      aspect-ratio: 1 / 1;
+      object-fit: cover;
+      clip-path: url(#splat-clip);
+    }
+
+    .barista-bio {
+      max-width: 420px;
+    }
+
+    .barista-bio h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .barista-bio .role {
+      color: #8d6e63;
+      font-style: italic;
+      margin-bottom: 12px;
+    }
+
+    /* 2) Loyalty banner: unmasked body + masked accent, shadow via filter on
+       the wrapper so drop-shadow follows the masked silhouette */
+    .unified-card {
+      display: flex;
+      max-width: 760px;
+      margin: 0 auto;
+      filter: drop-shadow(0 10px 18px rgba(62, 39, 35, 0.28));
+    }
+
+    .card-body {
+      flex: 1;
+      background: var(--primary);
+      color: white;
+      padding: 32px 36px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      font-size: 1.6rem;
+      margin-bottom: 8px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-body .btn:hover {
+      background: #ffc277;
+    }
+
+    .card-accent {
+      flex: 0 0 140px;
+      background:
+        repeating-linear-gradient(45deg, rgba(255, 171, 64, 0.22) 0 10px, transparent 10px 20px),
+        var(--primary);
+      border-radius: 0 16px 16px 0;
+      /* Concave curved cutout carved into the accent's outer (right) side */
+      -webkit-mask: radial-gradient(circle 60px at 100% 50%, transparent 98%, #000 100%);
+      mask: radial-gradient(circle 60px at 100% 50%, transparent 98%, #000 100%);
+    }
+
+    /* 3) Promo card: circular notch on top edge via gradient mask.
+       Wrapper carries the shadow since a mask clips the element's own shadow. */
+    .promo-wrap {
+      display: flex;
+      justify-content: center;
+      filter: drop-shadow(0 8px 14px rgba(62, 39, 35, 0.22));
+    }
+
+    .gradient-masked-card {
+      --notch: 34px;
+      width: min(380px, 100%);
+      background: linear-gradient(160deg, #ffe0b2, var(--accent));
+      color: var(--text);
+      text-align: center;
+      padding: calc(var(--notch) + 24px) 28px 30px;
+      border-radius: 18px;
+      -webkit-mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+      mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card h3 {
+      color: var(--primary);
+      font-size: 1.5rem;
+      margin-bottom: 6px;
+    }
+
+    .gradient-masked-card .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 4px 14px;
+      border: 2px dashed var(--primary);
+      border-radius: 6px;
+      font-weight: bold;
+      letter-spacing: 2px;
+    }
+
+    @media (max-width: 560px) {
+      .card-accent {
+        flex-basis: 70px;
+      }
+    }
   </style>
 </head>
 
