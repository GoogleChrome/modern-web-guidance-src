+  <script type="module">
+    // Load the Invoker Commands polyfill only when native support is missing.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      try {
+        await import('https://esm.run/invokers-polyfill');
+      } catch (err) {
+        console.error('Error loading invokers polyfill:', err);
+      }
+    }
+
+    const target = document.getElementById('action-target');
+    const toggles = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    // The `command` event doesn't bubble, so listen on the target itself.
+    target.addEventListener('command', (event) => {
+      const { command, source } = event;
+
+      if (command in toggles) {
+        const isOn = target.classList.toggle(toggles[command]);
+        // Custom commands have no built-in semantics; sync ARIA state manually.
+        source?.setAttribute('aria-pressed', String(isOn));
+      } else if (command === '--reset') {
+        target.classList.remove(...Object.values(toggles));
+        document
+          .querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`)
+          .forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+      }
+    });
+  </script>
+
 </body>
 
