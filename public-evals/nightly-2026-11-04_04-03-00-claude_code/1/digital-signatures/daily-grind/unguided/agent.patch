+      el('label', { class: 'dg-key-main' },
+        radio,
+        el('span', {},
+          el('strong', { text: key.label }),
+          suite.quantumResistant ? el('span', { class: 'dg-badge dg-badge-pq', text: 'Quantum-resistant' }) : el('span', { class: 'dg-badge', text: 'Classical' }),
+          el('br'),
+          el('small', { text: `${suite.label} · ${formatFingerprint(key.keyId)}` }),
+        ),
+      ),
+      el('span', { class: 'dg-key-actions' },
+        el('button', { type: 'button', class: 'dg-link', text: 'Export public key', onclick: () => exportKey(key) }),
+        el('button', { type: 'button', class: 'dg-link dg-danger', text: 'Delete', onclick: () => deleteKey(key) }),
+      ),
+    ));
+  }
+  if (state.activeKeyId) localStorage.setItem(ACTIVE_KEY_STORE, state.activeKeyId);
+  updateSignButton();
+}
+
+function renderTrusted() {
+  const list = $('dg-trusted-list');
+  list.replaceChildren();
+  if (state.trusted.length === 0) {
+    list.append(el('li', { class: 'dg-empty', text: 'No other trusted keys. Your own keys are always trusted.' }));
+  }
+  state.trusted.forEach((t, i) => {
+    list.append(el('li', { class: 'dg-key' },
+      el('span', {},
+        el('strong', { text: String(t.label) }),
+        el('br'),
+        el('small', { text: `${SUITES[t.suite]?.label ?? 'Unknown suite'} · ${safeFingerprint(t.keyId)}` }),
+      ),
+      el('button', {
+        type: 'button', class: 'dg-link dg-danger', text: 'Remove', onclick: () => {
+          state.trusted.splice(i, 1);
+          saveTrusted(state.trusted);
+          renderTrusted();
+        },
+      }),
+    ));
+  });
+}
+
+function safeFingerprint(keyId) {
+  try { return formatFingerprint(keyId); } catch { return 'invalid key ID'; }
+}
+
+async function generateKey() {
+  const status = $('dg-key-status');
+  const btn = $('dg-generate');
+  btn.disabled = true;
+  setStatus(status, 'Generating key…');
+  try {
+    const key = await generateSigningKey($('dg-suite').value, $('dg-key-label').value);
+    await keyDb.put(key);
+    state.keys.push(key);
+    state.activeKeyId = key.keyId;
+    renderKeys();
+    setStatus(status, `Created key ${formatFingerprint(key.keyId)}. It's stored only in this browser.`, 'ok');
+  } catch (e) {
+    setStatus(status, `Could not generate key: ${e.message}`, 'error');
+  } finally {
+    btn.disabled = false;
+  }
+}
+
+function exportKey(key) {
+  const json = JSON.stringify(exportPublicKey(key), null, 2);
+  download(`daily-grind-public-key-${formatFingerprint(key.keyId)}.json`, json);
+  setStatus($('dg-key-status'), 'Public key downloaded. Share it with anyone who needs to verify your documents.', 'ok');
+}
+
+async function deleteKey(key) {
+  if (!confirm(`Delete signing key "${key.label}"? Documents already signed with it can still be verified only if someone keeps its public key.`)) return;
+  await keyDb.remove(key.keyId);
+  state.keys = state.keys.filter((k) => k.keyId !== key.keyId);
+  renderKeys();
+  setStatus($('dg-key-status'), 'Key deleted.', 'info');
+}
+
+async function addTrustedKey(text) {
+  const status = $('dg-trust-status');
+  try {
+    const pub = await parsePublicKey(text);
+    if (!state.trusted.some((t) => t.keyId === pub.keyId) && !state.keys.some((k) => k.keyId === pub.keyId)) {
+      state.trusted.push({ format: 'daily-grind-public-key/v1', ...pub });
+      saveTrusted(state.trusted);
+    }
+    renderTrusted();
+    setStatus(status, `Trusted key ${formatFingerprint(pub.keyId)} (${pub.label}).`, 'ok');
+    return true;
+  } catch (e) {
+    setStatus(status, `Could not add key: ${e.message}`, 'error');
+    return false;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Issuing                                                             */
+/* ------------------------------------------------------------------ */
+
+function initIssueForms() {
+  const items = $('dg-receipt-items');
+  MENU.forEach((m, i) => {
+    items.append(el('label', { class: 'dg-item' },
+      el('span', { text: `${m.name} (${money(m.unitPriceCents)})` }),
+      el('input', { type: 'number', min: '0', max: '99', step: '1', value: i === 0 ? '1' : '0', 'data-index': String(i), 'aria-label': `Quantity of ${m.name}` }),
+    ));
+  });
+  items.addEventListener('input', updateReceiptTotal);
+  updateReceiptTotal();
+
+  const expiry = new Date();
+  expiry.setUTCFullYear(expiry.getUTCFullYear() + 1);
+  $('dg-voucher-expiry').value = expiry.toISOString().slice(0, 10);
+  $('dg-voucher-expiry').min = new Date().toISOString().slice(0, 10);
+
+  for (const tab of document.querySelectorAll('[data-dg-tab]')) {
+    tab.addEventListener('click', () => selectTab(tab.dataset.dgTab));
+  }
+  $('dg-issue-form').addEventListener('submit', (e) => { e.preventDefault(); issue(); });
+  $('dg-copy').addEventListener('click', copySigned);
+  $('dg-download').addEventListener('click', () => {
+    if (state.lastSigned) download(`${state.lastSigned.id}.signed.json`, state.lastSigned.json);
+  });
+  $('dg-send-to-verify').addEventListener('click', () => {
+    if (!state.lastSigned) return;
+    $('dg-verify-input').value = state.lastSigned.json;
+    $('dg-verify-input').scrollIntoView({ behavior: 'smooth', block: 'center' });
+    verify();
+  });
+}
+
+function selectTab(name) {
+  for (const tab of document.querySelectorAll('[data-dg-tab]')) {
+    const active = tab.dataset.dgTab === name;
+    tab.setAttribute('aria-selected', String(active));
+    $(tab.getAttribute('aria-controls')).hidden = !active;
+  }
+}
+
+function receiptItems() {
+  return [...$('dg-receipt-items').querySelectorAll('input')].map((input) => {
+    const qty = Math.trunc(Number(input.value));
+    return { ...MENU[Number(input.dataset.index)], quantity: Number.isFinite(qty) ? Math.min(Math.max(qty, 0), 99) : 0 };
+  });
+}
+
+function updateReceiptTotal() {
+  const subtotal = receiptItems().reduce((n, it) => n + it.unitPriceCents * it.quantity, 0);
+  const tax = Math.round((subtotal * TAX_RATE_BPS) / 10_000);
+  $('dg-receipt-total').textContent = `Subtotal ${money(subtotal)} · Tax ${money(tax)} · Total ${money(subtotal + tax)}`;
+}
+
+function updateSignButton() {
+  const btn = $('dg-sign');
+  btn.disabled = !state.activeKeyId;
+  btn.title = state.activeKeyId ? '' : 'Generate a signing key first';
+}
+
+async function issue() {
+  const status = $('dg-issue-status');
+  const key = state.keys.find((k) => k.keyId === state.activeKeyId);
+  if (!key) return setStatus(status, 'Generate or select a signing key first.', 'error');
+  const isReceipt = $('dg-tab-receipt').getAttribute('aria-selected') === 'true';
+  try {
+    const doc = isReceipt
+      ? buildReceipt({ customer: $('dg-receipt-customer').value, store: $('dg-receipt-store').value, items: receiptItems(), taxRateBps: TAX_RATE_BPS })
+      : buildVoucher({
+        recipient: $('dg-voucher-recipient').value,
+        from: $('dg-voucher-from').value,
+        amountCents: Math.round(Number($('dg-voucher-amount').value) * 100),
+        expiresOn: $('dg-voucher-expiry').value,
+        message: $('dg-voucher-message').value,
+      });
+    setStatus(status, 'Signing…');
+    const envelope = await signDocument(doc, key);
+    const json = JSON.stringify(envelope, null, 2);
+    state.lastSigned = { id: doc.receiptId || doc.voucherCode, json };
+    $('dg-signed-output').value = json;
+    $('dg-signed-block').hidden = false;
+    setStatus(status, `Signed ${isReceipt ? 'receipt' : 'voucher'} ${state.lastSigned.id} with ${SUITES[key.suite].label}.`, 'ok');
+  } catch (e) {
+    setStatus(status, `Could not sign: ${e.message}`, 'error');
+  }
+}
+
+async function copySigned() {
+  if (!state.lastSigned) return;
+  try {
+    await navigator.clipboard.writeText(state.lastSigned.json);
+    setStatus($('dg-issue-status'), 'Signed document copied to clipboard.', 'ok');
+  } catch {
+    $('dg-signed-output').select();
+    setStatus($('dg-issue-status'), 'Clipboard unavailable. The text is selected so you can copy it manually.', 'info');
+  }
+}
+
+function download(filename, text) {
+  const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+  const a = el('a', { href: url, download: filename.replace(/[^A-Za-z0-9._-]/g, '_') });
+  document.body.append(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+/* ------------------------------------------------------------------ */
+/* Verification                                                        */
+/* ------------------------------------------------------------------ */
+
+function initVerify() {
+  $('dg-verify-form').addEventListener('submit', (e) => { e.preventDefault(); verify(); });
+  $('dg-verify-file').addEventListener('change', async (e) => {
+    const file = e.target.files?.[0];
+    if (!file) return;
+    if (file.size > MAX_INPUT_BYTES) {
+      renderVerifyError('File is too large to be a Daily Grind signed document.');
+      return;
+    }
+    $('dg-verify-input').value = await file.text();
+    e.target.value = '';
+    verify();
+  });
+}
+
+function renderVerifyError(message) {
+  const out = $('dg-verify-result');
+  out.hidden = false;
+  out.dataset.status = 'invalid';
+  out.replaceChildren(el('p', { class: 'dg-verdict', text: `✗ ${message}` }));
+}
+
+async function verify() {
+  const out = $('dg-verify-result');
+  const text = $('dg-verify-input').value.trim();
+  if (!text) return renderVerifyError('Paste or upload a signed receipt or voucher first.');
+
+  const result = await verifyDocument(text, { trustedKeyIds: await trustedKeyIds() });
+  out.hidden = false;
+  out.dataset.status = result.status === 'authentic' && result.expired ? 'untrusted' : result.status;
+
+  const verdicts = {
+    authentic: result.expired
+      ? '⚠ Authentic, but this voucher has expired'
+      : '✓ Authentic: signed by a trusted Daily Grind key and unchanged',
+    untrusted: '⚠ Signature valid, but the signer isn\'t trusted. Contents are intact; the issuer is unproven.',
+    invalid: '✗ Invalid: do not accept this document',
+  };
+  const children = [el('p', { class: 'dg-verdict', text: verdicts[result.status] })];
+
+  const checklist = el('ul', { class: 'dg-checks' });
+  for (const c of result.checks) {
+    const icon = c.ok === true ? '✓' : c.ok === false ? '✗' : '?';
+    checklist.append(el('li', { 'data-ok': String(c.ok) },
+      el('span', { class: 'dg-check-icon', text: icon, 'aria-hidden': 'true' }),
+      el('span', { text: c.label + (c.detail ? ` (${c.detail})` : '') }),
+    ));
+  }
+  children.push(checklist);
+
+  if (result.envelope) {
+    children.push(renderDocumentPreview(result.envelope));
+    if (result.status === 'untrusted') {
+      const signer = result.envelope.signer;
+      children.push(el('div', { class: 'dg-trust-prompt' },
+        el('p', { text: `Only trust this key if you've confirmed its fingerprint ${formatFingerprint(signer.keyId)} with The Daily Grind through a separate channel. Anyone can create a key and call it "${signer.label}".` }),
+        el('button', {
+          type: 'button', class: 'btn dg-btn-secondary', text: 'I verified the fingerprint, so trust this signer', onclick: async () => {
+            const ok = await addTrustedKey(JSON.stringify({ format: 'daily-grind-public-key/v1', ...signer }));
+            if (ok) verify();
+          },
+        }),
+      ));
+    }
+  }
+  out.replaceChildren(...children);
+}
+
+function renderDocumentPreview(env) {
+  const d = env.document;
+  const rows = [];
+  const row = (k, v) => rows.push(el('tr', {}, el('th', { scope: 'row', text: k }), el('td', { text: v })));
+  if (d.type === 'receipt') {
+    row('Receipt', d.receiptId);
+    row('Store', d.store);
+    row('Customer', d.customer);
+    row('Issued', new Date(d.issuedAt).toLocaleString());
+    for (const it of d.items) row(`${it.quantity} × ${it.name}`, money(it.unitPriceCents * it.quantity));
+    row('Subtotal', money(d.subtotalCents));
+    row('Tax', money(d.taxCents));
+    row('Total', money(d.totalCents));
+  } else {
+    row('Voucher code', d.voucherCode);
+    row('Value', money(d.amountCents));
+    row('For', d.recipient);
+    row('From', d.from);
+    row('Expires', d.expiresOn);
+    if (d.message) row('Message', d.message);
+    row('Issued', new Date(d.issuedAt).toLocaleString());
+  }
+  row('Signed by', `${env.signer.label} (${formatFingerprint(env.signer.keyId)})`);
+  row('Algorithm', SUITES[env.signer.suite].label);
+  row('Signed at', new Date(env.signedAt).toLocaleString());
+  return el('div', { class: `dg-preview dg-preview-${d.type}` },
+    el('h4', { text: d.type === 'receipt' ? 'Order receipt' : 'Gift voucher' }),
+    el('table', {}, el('tbody', {}, ...rows)),
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Boot                                                                */
+/* ------------------------------------------------------------------ */
+
+async function init() {
+  const root = $('receipts-vouchers');
+  if (!root) return;
+  if (!window.isSecureContext || !crypto?.subtle) {
+    setStatus($('dg-key-status'), 'Signing needs a secure (HTTPS) connection. Signing and verification are disabled.', 'error');
+    root.querySelectorAll('button, input, textarea, select').forEach((n) => { n.disabled = true; });
+    return;
+  }
+
+  initIssueForms();
+  initVerify();
+  $('dg-generate').addEventListener('click', generateKey);
+  $('dg-trust-form').addEventListener('submit', async (e) => {
+    e.preventDefault();
+    if (await addTrustedKey($('dg-trust-input').value.trim())) $('dg-trust-input').value = '';
+  });
+
+  state.trusted = loadTrusted();
+  renderTrusted();
+  try {
+    state.keys = (await keyDb.all()).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+  } catch (e) {
+    setStatus($('dg-key-status'), `Key storage unavailable (${e.message}). Keys won't persist.`, 'error');
+  }
+  renderKeys();
+  await initSuiteSelect();
+}
+
+init();
