diff --git a/tests/dg-crypto.test.mjs b/tests/dg-crypto.test.mjs
new file mode 100644
index 0000000..c481f36
--- /dev/null
+++ b/tests/dg-crypto.test.mjs
@@ -0,0 +1,95 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  SUITES, canonicalize, generateSigningKey, signDocument, verifyDocument,
+  buildReceipt, buildVoucher, exportPublicKey, parsePublicKey, b64urlDecode, b64urlEncode,
+} from '../js/dg-crypto.js';
+
+const receipt = () => buildReceipt({
+  customer: 'Ada', store: 'Daily Grind — Main St',
+  items: [{ name: 'Cold Brew', unitPriceCents: 495, quantity: 2 }, { name: 'Maple Oat Latte', unitPriceCents: 575, quantity: 1 }],
+});
+const voucher = (expiresOn = '2099-12-31') => buildVoucher({ recipient: 'Grace', from: 'Ada', amountCents: 2500, expiresOn, message: 'Enjoy!' });
+
+test('canonicalize sorts keys and rejects floats', () => {
+  assert.equal(canonicalize({ b: 1, a: [true, null, 'x'] }), '{"a":[true,null,"x"],"b":1}');
+  assert.throws(() => canonicalize({ a: 1.5 }));
+  assert.throws(() => canonicalize({ a: NaN }));
+});
+
+test('base64url is strict', () => {
+  const bytes = new Uint8Array([1, 2, 3, 250]);
+  assert.deepEqual(b64urlDecode(b64urlEncode(bytes)), bytes);
+  assert.throws(() => b64urlDecode('AQID+g'));
+  assert.throws(() => b64urlDecode('AQID-h')); // non-canonical trailing bits
+});
+
+test('receipt totals', () => {
+  const r = receipt();
+  assert.equal(r.subtotalCents, 1565);
+  assert.equal(r.taxCents, 129);
+  assert.equal(r.totalCents, 1694);
+});
+
+for (const suiteId of Object.keys(SUITES)) {
+  test(`${suiteId}: sign, verify, trust, tamper`, async () => {
+    const key = await generateSigningKey(suiteId, 'Test key');
+    for (const doc of [receipt(), voucher()]) {
+      const env = await signDocument(doc, key);
+      const json = JSON.stringify(env, null, 2);
+
+      const trusted = await verifyDocument(json, { trustedKeyIds: [key.keyId] });
+      assert.equal(trusted.status, 'authentic', JSON.stringify(trusted.checks));
+      assert.equal((await verifyDocument(json)).status, 'untrusted');
+
+      // Tamper with content (keeping totals self-consistent where relevant)
+      const t1 = structuredClone(env);
+      if (doc.type === 'receipt') { t1.document.customer = 'Mallory'; } else { t1.document.amountCents = 50000; }
+      assert.equal((await verifyDocument(t1, { trustedKeyIds: [key.keyId] })).status, 'invalid');
+
+      // Swap in a different key (re-computing keyId) must fail
+      const other = await generateSigningKey(suiteId, 'Other');
+      const t2 = structuredClone(env);
+      t2.signer.publicKeys = other.publicKeys; t2.signer.keyId = other.keyId;
+      assert.equal((await verifyDocument(t2, { trustedKeyIds: [other.keyId] })).status, 'invalid');
+
+      // Re-signing with an attacker key is valid but untrusted
+      const forged = await signDocument(t1.document, other);
+      assert.equal((await verifyDocument(forged, { trustedKeyIds: [key.keyId] })).status, 'untrusted');
+
+      // Extra field is rejected
+      const t3 = structuredClone(env); t3.document.note = 'x';
+      assert.equal((await verifyDocument(t3, { trustedKeyIds: [key.keyId] })).status, 'invalid');
+
+      // Changing signedAt breaks the signature
+      const t4 = structuredClone(env); t4.signedAt = '2020-01-01T00:00:00.000Z';
+      assert.equal((await verifyDocument(t4, { trustedKeyIds: [key.keyId] })).status, 'invalid');
+    }
+    const pub = await parsePublicKey(JSON.stringify(exportPublicKey(key)));
+    assert.equal(pub.keyId, key.keyId);
+  });
+}
+
+test('hybrid requires both signatures', async () => {
+  const key = await generateSigningKey('hybrid-ed25519-ml-dsa-65', 'Hybrid');
+  const env = await signDocument(receipt(), key);
+  const bad = structuredClone(env);
+  const sig = b64urlDecode(bad.signatures[1]); sig[10] ^= 1; bad.signatures[1] = b64urlEncode(sig);
+  const res = await verifyDocument(bad, { trustedKeyIds: [key.keyId] });
+  assert.equal(res.status, 'invalid');
+  assert.match(res.error, /does not match/);
+});
+
+test('expired voucher is flagged', async () => {
+  const key = await generateSigningKey('ed25519', 'k');
+  const env = await signDocument(voucher('2030-01-01'), key);
+  const res = await verifyDocument(env, { trustedKeyIds: [key.keyId], now: new Date('2031-01-01') });
+  assert.equal(res.status, 'authentic');
+  assert.equal(res.expired, true);
+});
+
+test('public key bundle with mismatched keyId is rejected', async () => {
+  const key = await generateSigningKey('ecdsa-p256', 'k');
+  const pub = exportPublicKey(key); pub.keyId = (await generateSigningKey('ecdsa-p256', 'x')).keyId;
+  await assert.rejects(parsePublicKey(pub), /Key ID/);
+});
