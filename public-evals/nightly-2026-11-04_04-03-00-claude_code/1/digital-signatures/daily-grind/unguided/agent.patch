+  // displayed text, then trim.
+  return String(s ?? '').replace(/[\u0000-\u001f\u007f\u202a-\u202e\u2066-\u2069]/g, '').trim().slice(0, max);
+}
+
+function expectPlainObject(v, what) {
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) throw new Error(`${what} must be an object`);
+}
+function expectExactKeys(obj, keys, what) {
+  const actual = Object.keys(obj).sort();
+  const expected = [...keys].sort();
+  if (actual.length !== expected.length || actual.some((k, i) => k !== expected[i])) {
+    throw new Error(`${what} has unexpected or missing fields`);
+  }
+}
+function expectText(v, what, max, { allowEmpty = false } = {}) {
+  if (typeof v !== 'string' || v.length > max || (!allowEmpty && v.length === 0) || cleanText(v, max) !== v) {
+    throw new Error(`Invalid ${what}`);
+  }
+}
+function expectInt(v, what, min, max) {
+  if (!Number.isSafeInteger(v) || v < min || v > max) throw new Error(`Invalid ${what}`);
+}
+function expectTimestamp(v, what) {
+  if (typeof v !== 'string' || !ISO_TS.test(v) || Number.isNaN(Date.parse(v))) throw new Error(`Invalid ${what}`);
+}
+function expectDate(v, what) {
+  if (typeof v !== 'string' || !ISO_DATE.test(v) || new Date(v + 'T00:00:00Z').toISOString().slice(0, 10) !== v) {
+    throw new Error(`Invalid ${what}`);
+  }
+}
+
+function randomCode(groups) {
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // 32 symbols, no 0/O/1/I
+  const bytes = crypto.getRandomValues(new Uint8Array(groups * 4));
+  const chars = Array.from(bytes, (b) => alphabet[b & 31]).join('');
+  return chars.match(/.{4}/g).join('-');
+}
+
+/** Builds a receipt. Money is integer cents; tax is basis points (825 = 8.25%). */
+export function buildReceipt({ customer, store, items, taxRateBps = 825, currency = 'USD' }) {
+  const lines = (items || [])
+    .filter((it) => it && it.quantity > 0)
+    .map((it) => ({ name: cleanText(it.name, 80), unitPriceCents: it.unitPriceCents, quantity: it.quantity }));
+  if (lines.length === 0) throw new Error('Add at least one item to the order');
+  const subtotalCents = lines.reduce((n, l) => n + l.unitPriceCents * l.quantity, 0);
+  const taxCents = Math.round((subtotalCents * taxRateBps) / 10_000);
+  const receipt = {
+    type: 'receipt',
+    receiptId: 'DG-R-' + randomCode(3),
+    issuedAt: new Date().toISOString(),
+    store: cleanText(store, 80) || 'The Daily Grind',
+    customer: cleanText(customer, 80) || 'Guest',
+    currency,
+    items: lines,
+    subtotalCents,
+    taxCents,
+    totalCents: subtotalCents + taxCents,
+  };
+  validateDocument(receipt);
+  return receipt;
+}
+
+export function buildVoucher({ recipient, from, amountCents, expiresOn, message, currency = 'USD' }) {
+  const voucher = {
+    type: 'voucher',
+    voucherCode: 'DG-V-' + randomCode(4),
+    issuedAt: new Date().toISOString(),
+    recipient: cleanText(recipient, 80),
+    from: cleanText(from, 80),
+    amountCents,
+    currency,
+    expiresOn,
+    message: cleanText(message, 200),
+  };
+  validateDocument(voucher);
+  return voucher;
+}
+
+/** Strict schema validation. Unknown fields are rejected so nothing unsigned-looking can slip in. */
+export function validateDocument(doc) {
+  expectPlainObject(doc, 'Document');
+  if (doc.type === 'receipt') {
+    expectExactKeys(doc, ['type', 'receiptId', 'issuedAt', 'store', 'customer', 'currency', 'items', 'subtotalCents', 'taxCents', 'totalCents'], 'Receipt');
+    if (typeof doc.receiptId !== 'string' || !/^DG-R-[A-Z0-9]{4}(-[A-Z0-9]{4}){2}$/.test(doc.receiptId)) throw new Error('Invalid receipt ID');
+    expectTimestamp(doc.issuedAt, 'issue time');
+    expectText(doc.store, 'store', 80);
+    expectText(doc.customer, 'customer', 80);
+    if (doc.currency !== 'USD') throw new Error('Unsupported currency');
+    if (!Array.isArray(doc.items) || doc.items.length < 1 || doc.items.length > 50) throw new Error('Invalid item list');
+    let sum = 0;
+    for (const it of doc.items) {
+      expectPlainObject(it, 'Item');
+      expectExactKeys(it, ['name', 'unitPriceCents', 'quantity'], 'Item');
+      expectText(it.name, 'item name', 80);
+      expectInt(it.unitPriceCents, 'unit price', 0, 1_000_00);
+      expectInt(it.quantity, 'quantity', 1, 99);
+      sum += it.unitPriceCents * it.quantity;
+    }
+    expectInt(doc.subtotalCents, 'subtotal', 0, MAX_CENTS);
+    expectInt(doc.taxCents, 'tax', 0, MAX_CENTS);
+    expectInt(doc.totalCents, 'total', 0, MAX_CENTS);
+    if (sum !== doc.subtotalCents) throw new Error('Subtotal does not match line items');
+    if (doc.subtotalCents + doc.taxCents !== doc.totalCents) throw new Error('Total does not equal subtotal + tax');
+  } else if (doc.type === 'voucher') {
+    expectExactKeys(doc, ['type', 'voucherCode', 'issuedAt', 'recipient', 'from', 'amountCents', 'currency', 'expiresOn', 'message'], 'Voucher');
+    if (typeof doc.voucherCode !== 'string' || !/^DG-V-[A-Z0-9]{4}(-[A-Z0-9]{4}){3}$/.test(doc.voucherCode)) throw new Error('Invalid voucher code');
+    expectTimestamp(doc.issuedAt, 'issue time');
+    expectText(doc.recipient, 'recipient', 80);
+    expectText(doc.from, 'sender', 80);
+    expectInt(doc.amountCents, 'voucher amount', 100, 500_00);
+    if (doc.currency !== 'USD') throw new Error('Unsupported currency');
+    expectDate(doc.expiresOn, 'expiry date');
+    if (doc.expiresOn < doc.issuedAt.slice(0, 10)) throw new Error('Voucher expires before it was issued');
+    expectText(doc.message, 'message', 200, { allowEmpty: true });
+  } else {
+    throw new Error('Unknown document type');
+  }
+  return doc;
+}
+
+function signingInput(envelopeWithoutSignatures) {
+  return concatBytes(utf8(DOMAIN_TAG), utf8(canonicalize(envelopeWithoutSignatures)));
+}
+
+/** Signs a receipt or voucher, returning a self-contained signed envelope. */
+export async function signDocument(doc, key) {
+  validateDocument(doc);
+  const suite = SUITES[key.suite];
+  if (!suite) throw new Error('Unknown key suite');
+  const unsigned = {
+    format: FORMAT,
+    document: doc,
+    signer: { suite: key.suite, keyId: key.keyId, label: key.label, publicKeys: [...key.publicKeys] },
+    signedAt: new Date().toISOString(),
+  };
+  const msg = signingInput(unsigned);
+  const signatures = [];
+  for (let i = 0; i < suite.algs.length; i++) {
+    signatures.push(b64urlEncode(await ALGS[suite.algs[i]].sign(key.privateKeys[i], msg)));
+  }
+  return { ...unsigned, signatures };
+}
+
+function parseJsonLimited(text) {
+  if (typeof text !== 'string') throw new Error('Expected JSON text');
+  if (utf8(text).length > MAX_INPUT_BYTES) throw new Error('Input is too large');
+  try {
+    return JSON.parse(text);
+  } catch {
+    throw new Error('Input is not valid JSON');
+  }
+}
+
+/**
+ * Verifies a signed envelope.
+ *
+ * @param {string|object} input  Envelope JSON text or parsed object.
+ * @param {object} opts
+ * @param {Iterable<string>} opts.trustedKeyIds  Key IDs the verifier trusts.
+ * @param {Date} [opts.now]
+ * @returns {Promise<{status: 'authentic'|'untrusted'|'invalid', checks: {label:string, ok:boolean|null, detail?:string}[], envelope?:object, error?:string, expired?:boolean}>}
+ *   - authentic:  every signature is valid and the key is trusted
+ *   - untrusted:  every signature is valid but the key isn't trusted, so the
+ *                 contents are intact but the issuer is unproven
+ *   - invalid:    malformed, tampered, or signature mismatch
+ */
+export async function verifyDocument(input, { trustedKeyIds = [], now = new Date() } = {}) {
+  const checks = [];
+  const fail = (label, err) => {
+    checks.push({ label, ok: false, detail: err?.message || String(err) });
+    return { status: 'invalid', checks, error: checks.at(-1).detail };
+  };
+
+  let env;
+  try {
+    env = typeof input === 'string' ? parseJsonLimited(input) : input;
+    expectPlainObject(env, 'Signed document');
+    expectExactKeys(env, ['format', 'document', 'signer', 'signedAt', 'signatures'], 'Signed document');
+    if (env.format !== FORMAT) throw new Error('Unsupported format');
+    expectTimestamp(env.signedAt, 'signing time');
+  } catch (e) {
+    return fail('Well-formed signed document', e);
+  }
+  checks.push({ label: 'Well-formed signed document', ok: true });
+
+  let suite, publicKeys, signatures;
+  try {
+    expectPlainObject(env.signer, 'Signer');
+    expectExactKeys(env.signer, ['suite', 'keyId', 'label', 'publicKeys'], 'Signer');
+    if (typeof env.signer.label !== 'string' || env.signer.label.length > 60) throw new Error('Invalid signer label');
+    publicKeys = checkPublicKeys(env.signer.suite, env.signer.publicKeys);
+    suite = SUITES[env.signer.suite];
+    if (!Array.isArray(env.signatures) || env.signatures.length !== suite.algs.length) throw new Error('Wrong number of signatures');
+    signatures = env.signatures.map((s, i) => {
+      const bytes = b64urlDecode(s);
+      if (bytes.length !== ALGS[suite.algs[i]].signatureBytes) throw new Error(`Bad ${suite.algs[i]} signature length`);
+      return bytes;
+    });
+    if (await computeKeyId(env.signer.suite, env.signer.publicKeys) !== env.signer.keyId) throw new Error('Key ID does not match public key');
+  } catch (e) {
+    return fail('Signer key and signature encoding', e);
+  }
+  checks.push({ label: `Signer key and signature encoding (${suite.label})`, ok: true });
+
+  try {
+    validateDocument(env.document);
+  } catch (e) {
+    return fail('Document contents', e);
+  }
+  checks.push({ label: 'Document contents and totals', ok: true });
+
+  const { signatures: _omit, ...unsigned } = env;
+  const msg = signingInput(unsigned);
+  for (let i = 0; i < suite.algs.length; i++) {
+    const alg = suite.algs[i];
+    let ok = false;
+    try {
+      ok = await ALGS[alg].verify(publicKeys[i], signatures[i], msg);
+    } catch (e) {
+      return fail(`${alg} signature`, new Error(`Cannot verify ${alg} in this browser: ${e.message}`));
+    }
+    if (!ok) return fail(`${alg} signature`, new Error('Signature does not match — the document was altered or signed with a different key'));
+    checks.push({ label: `${alg} signature`, ok: true });
+  }
+
+  const trusted = new Set(trustedKeyIds).has(env.signer.keyId);
+  checks.push({
+    label: 'Signer is a trusted Daily Grind key',
+    ok: trusted ? true : null,
+    detail: trusted ? undefined : `Key ${formatFingerprint(env.signer.keyId)} is not in your trusted keys`,
+  });
+
+  let expired = false;
+  if (env.document.type === 'voucher') {
+    expired = env.document.expiresOn < now.toISOString().slice(0, 10);
+    checks.push({ label: 'Voucher not expired', ok: expired ? false : true, detail: expired ? `Expired on ${env.document.expiresOn}` : undefined });
+  }
+
+  return { status: trusted ? 'authentic' : 'untrusted', checks, envelope: env, expired };
+}
