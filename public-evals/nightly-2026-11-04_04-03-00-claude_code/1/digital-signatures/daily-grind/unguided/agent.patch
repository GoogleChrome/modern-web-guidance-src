+  if (preferred) select.value = preferred;
+}
+
+function renderKeys() {
+  const list = $('dg-key-list');
+  list.replaceChildren();
+  if (state.keys.length === 0) {
+    list.append(el('li', { class: 'dg-empty', text: 'No signing keys yet. Generate one to start issuing signed documents.' }));
+  }
+  if (!state.keys.some((k) => k.keyId === state.activeKeyId)) {
+    state.activeKeyId = state.keys[0]?.keyId ?? null;
+  }
