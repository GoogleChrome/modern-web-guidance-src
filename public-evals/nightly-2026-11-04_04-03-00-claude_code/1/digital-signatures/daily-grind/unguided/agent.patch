+/**
+ * UI for signing and verifying Daily Grind receipts and gift vouchers.
+ *
+ * Storage:
+ *   - Signing keys: IndexedDB. WebCrypto private keys are stored as
+ *     non-extractable CryptoKeys. ML-DSA secret keys are stored as raw bytes
+ *     because browsers don't support ML-DSA natively yet.
+ *   - Trusted public keys: localStorage (public data only).
+ *
+ * All user-controlled text is rendered with textContent, never innerHTML.
+ */
+import {
+  SUITES, isSuiteSupported, generateSigningKey, exportPublicKey, parsePublicKey,
+  formatFingerprint, buildReceipt, buildVoucher, signDocument, verifyDocument, MAX_INPUT_BYTES,
+} from './dg-crypto.js';
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitPriceCents: 575 },
+  { name: 'Dark Roast Espresso', unitPriceCents: 350 },
+  { name: 'Cold Brew', unitPriceCents: 495 },
+  { name: 'Cappuccino', unitPriceCents: 450 },
+  { name: 'Butter Croissant', unitPriceCents: 375 },
+];
+const TAX_RATE_BPS = 825;
+const TRUSTED_KEY_STORE = 'dg-trusted-keys';
+const ACTIVE_KEY_STORE = 'dg-active-key';
+
+const $ = (id) => document.getElementById(id);
+const money = (cents) => `$${(cents / 100).toFixed(2)}`;
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') node.className = v;
+    else if (k === 'text') node.textContent = v;
+    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
+    else node.setAttribute(k, v);
+  }
+  for (const c of children) if (c != null) node.append(c);
+  return node;
+}
+
+function setStatus(target, message, kind = 'info') {
+  target.textContent = message;
+  target.dataset.kind = kind;
+}
+
+/* ------------------------------------------------------------------ */
+/* Key storage                                                         */
+/* ------------------------------------------------------------------ */
+
+const keyDb = {
+  _db: null,
+  open() {
+    this._db ??= new Promise((resolve, reject) => {
+      const req = indexedDB.open('daily-grind-signing', 1);
+      req.onupgradeneeded = () => req.result.createObjectStore('keys', { keyPath: 'keyId' });
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    });
+    return this._db;
+  },
+  async tx(mode, fn) {
+    const db = await this.open();
+    return new Promise((resolve, reject) => {
+      const t = db.transaction('keys', mode);
+      const req = fn(t.objectStore('keys'));
+      t.oncomplete = () => resolve(req?.result);
+      t.onerror = () => reject(t.error);
+      t.onabort = () => reject(t.error);
+    });
+  },
+  all() { return this.tx('readonly', (s) => s.getAll()); },
+  put(key) { return this.tx('readwrite', (s) => s.put(key)); },
+  remove(keyId) { return this.tx('readwrite', (s) => s.delete(keyId)); },
+};
+
+function loadTrusted() {
+  try {
+    const list = JSON.parse(localStorage.getItem(TRUSTED_KEY_STORE) || '[]');
+    return Array.isArray(list) ? list : [];
+  } catch {
+    return [];
+  }
+}
+function saveTrusted(list) {
+  localStorage.setItem(TRUSTED_KEY_STORE, JSON.stringify(list));
+}
+
+/* ------------------------------------------------------------------ */
+/* State                                                               */
+/* ------------------------------------------------------------------ */
+
+const state = {
+  keys: [],
+  trusted: [],
+  activeKeyId: localStorage.getItem(ACTIVE_KEY_STORE),
+  lastSigned: null,
+};
+
+async function trustedKeyIds() {
+  // Your own keys count as trusted. Re-validate pinned bundles in case
+  // localStorage was edited.
+  const ids = new Set(state.keys.map((k) => k.keyId));
+  for (const t of state.trusted) {
+    try { ids.add((await parsePublicKey(t)).keyId); } catch { /* ignore corrupt entry */ }
+  }
+  return ids;
+}
+
+/* ------------------------------------------------------------------ */
+/* Key management UI                                                   */
+/* ------------------------------------------------------------------ */
+
+async function initSuiteSelect() {
+  const select = $('dg-suite');
+  select.replaceChildren();
+  for (const [id, suite] of Object.entries(SUITES)) {
+    const supported = await isSuiteSupported(id);
+    const opt = el('option', { value: id, text: suite.label + (supported ? '' : ' — not supported in this browser') });
+    if (!supported) opt.disabled = true;
+    select.append(opt);
+  }
