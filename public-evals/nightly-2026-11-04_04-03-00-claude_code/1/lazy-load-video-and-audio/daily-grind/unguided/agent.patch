+  <script>
+    (function () {
+      // Hero: honor reduced-motion and offer a pause control (WCAG 2.2.2).
+      var hero = document.querySelector('.hero-video');
+      var toggle = document.querySelector('.hero-toggle');
+      if (hero && toggle) {
+        var setPaused = function (paused) {
+          if (paused) { hero.pause(); } else { hero.play().catch(function () { }); }
+          toggle.textContent = paused ? 'Play video' : 'Pause video';
+          toggle.setAttribute('aria-pressed', String(paused));
+        };
+        toggle.hidden = false;
+        toggle.addEventListener('click', function () { setPaused(!hero.paused); });
+        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          hero.removeAttribute('autoplay');
+          setPaused(true);
+        }
+      }
+
+      // Lazy media: attach poster + source URLs only when the player is close.
+      var lazy = document.querySelectorAll('.lazy-media');
+
+      function hydrate(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          delete el.dataset.poster;
+        }
+        if (el.dataset.src) {
+          el.src = el.dataset.src;
+          delete el.dataset.src;
+        }
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+          source.removeAttribute('data-src');
+        });
+        // Fetch just enough to show duration and the first frame.
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        lazy.forEach(hydrate);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            observer.unobserve(entry.target);
+            hydrate(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      lazy.forEach(function (el) { observer.observe(el); });
+    })();
+  </script>
