+    /* Options dropdown */
+    .options-trigger {
+      anchor-name: --options-trigger;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      background: transparent;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      border-radius: 4px;
+      padding: 5px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .options-trigger .chevron {
+      font-size: 0.7em;
+      transition: rotate 0.2s;
+    }
+
+    .options-trigger[aria-expanded="true"] .chevron {
+      rotate: 180deg;
+    }
+
+    /* Top-layer panel tethered to the trigger via CSS anchor positioning */
+    .action-panel {
+      position-anchor: --options-trigger;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 0;
+      margin-block: 6px;
+      /* Flip vertically, horizontally, or both to stay inside the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      display: block;
+      width: 100%;
+      text-align: start;
+      background: transparent;
+      border: 0;
+      border-radius: 5px;
+      padding: 8px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+      color: var(--primary);
+    }
+
+    .action-item:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: -2px;
+    }
+
