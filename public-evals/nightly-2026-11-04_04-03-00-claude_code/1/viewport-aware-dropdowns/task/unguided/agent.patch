+  <script>
+    (function () {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+      if (!trigger || !panel) return;
+
+      // Keep aria-expanded in sync (some browsers don't expose it automatically).
+      panel.addEventListener('toggle', (event) => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (needsFallback) {
+          open ? startFallback() : stopFallback();
+        }
+      });
+
+      // Action buttons: close the panel, then navigate.
+      panel.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-href]');
+        if (!btn) return;
+        panel.hidePopover();
+        window.location.assign(btn.dataset.href);
+      });
+
+      // ---- Fallback positioning for browsers lacking CSS anchor positioning ----
+      const needsFallback = !(window.CSS && CSS.supports('anchor-name: --a') &&
+        CSS.supports('position-try-fallbacks: flip-block'));
+      const GAP = 6;
+      const EDGE = 8;
+      let frame = 0;
+
+      function place() {
+        frame = 0;
+        const t = trigger.getBoundingClientRect();
+        const pw = panel.offsetWidth;
+        const ph = panel.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        // Default: below the trigger, left edges aligned.
+        let top = t.bottom + GAP;
+        let left = t.left;
+
+        // Flip vertically (above the trigger) if it would overflow the bottom.
+        if (top + ph > vh - EDGE && t.top - GAP - ph >= EDGE) {
+          top = t.top - GAP - ph;
+        }
+        // Flip horizontally (right edges aligned) if it would overflow the right.
+        if (left + pw > vw - EDGE && t.right - pw >= EDGE) {
+          left = t.right - pw;
+        }
+        // Final clamp so the panel is never cut off.
+        top = Math.max(EDGE, Math.min(top, vh - ph - EDGE));
+        left = Math.max(EDGE, Math.min(left, vw - pw - EDGE));
+
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+      }
+
+      function schedule() {
+        if (!frame) frame = requestAnimationFrame(place);
+      }
+
+      function startFallback() {
+        panel.classList.add('js-positioned');
+        place();
+        window.addEventListener('resize', schedule);
+        window.addEventListener('scroll', schedule, { capture: true, passive: true });
+      }
+
+      function stopFallback() {
+        window.removeEventListener('resize', schedule);
+        window.removeEventListener('scroll', schedule, { capture: true });
+        if (frame) cancelAnimationFrame(frame);
+        frame = 0;
+      }
+    })();
+  </script>
