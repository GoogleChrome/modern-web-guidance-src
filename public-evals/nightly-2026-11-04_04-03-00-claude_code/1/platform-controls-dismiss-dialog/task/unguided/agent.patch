+  <script>
+    (function () {
+      var HISTORY_KEY = 'drinkDialog';
+      var openDialog = null;
+      var opener = null;
+
+      function onBackdropClick(event) {
+        // Light dismiss fallback for browsers without closedby="any".
+        if (event.target === event.currentTarget) {
+          event.currentTarget.close();
+        }
+      }
+
+      function show(dialog, trigger) {
+        if (openDialog || typeof dialog.showModal !== 'function') return;
+        opener = trigger;
+        openDialog = dialog;
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+
+        // Add a history entry so the mobile back gesture/button dismisses the
+        // dialog instead of leaving the page (where CloseWatcher isn't available).
+        var state = Object.assign({}, history.state);
+        state[HISTORY_KEY] = dialog.id;
+        history.pushState(state, '');
+      }
+
+      function handleClose(event) {
+        var dialog = event.currentTarget;
+        if (dialog !== openDialog) return;
+        openDialog = null;
+        document.body.classList.remove('dialog-open');
+
+        // Closed via Escape, close button, backdrop, or a CloseWatcher back
+        // gesture: drop the history entry we added so Back works as expected.
+        if (history.state && history.state[HISTORY_KEY] === dialog.id) {
+          history.back();
+        }
+
+        if (opener && document.contains(opener)) {
+          opener.focus();
+        }
+        opener = null;
+      }
+
+      window.addEventListener('popstate', function () {
+        // Back navigation (e.g. iOS swipe or browser Back) while open.
+        if (openDialog && !(history.state && history.state[HISTORY_KEY] === openDialog.id)) {
+          openDialog.close();
+        }
+      });
+
+      document.querySelectorAll('.drink-dialog').forEach(function (dialog) {
+        dialog.addEventListener('close', handleClose);
+        dialog.addEventListener('click', onBackdropClick);
+        dialog.querySelectorAll('[data-dialog-close]').forEach(function (btn) {
+          btn.addEventListener('click', function () { dialog.close(); });
+        });
+      });
+
+      document.querySelectorAll('[data-dialog-target]').forEach(function (trigger) {
+        trigger.addEventListener('click', function () {
+          var dialog = document.getElementById(trigger.getAttribute('data-dialog-target'));
+          if (dialog) show(dialog, trigger);
+        });
+      });
+
+      // If the page was restored with a stale dialog history entry, clean it up.
+      if (history.state && history.state[HISTORY_KEY]) {
+        var cleaned = Object.assign({}, history.state);
+        delete cleaned[HISTORY_KEY];
+        history.replaceState(cleaned, '');
+      }
+    })();
+  </script>
+
