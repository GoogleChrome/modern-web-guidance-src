+  <script>
+    // Apply "next" / "previous" view-transition types on page reveal so the
+    // matching CSS animations run. Only set up when motion is allowed.
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const pageOf = (url) => {
+        try {
+          const u = new URL(url, location.href);
+          if (u.origin !== location.origin || u.pathname !== location.pathname) return null;
+          const n = parseInt(u.searchParams.get('page'), 10);
+          return Number.isFinite(n) && n > 0 ? n : 1;
+        } catch {
+          return null;
+        }
+      };
+
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+
+        let fromUrl = null;
+        let toUrl = location.href;
+        if (window.navigation && navigation.activation) {
+          fromUrl = navigation.activation.from?.url ?? null;
+          toUrl = navigation.activation.entry?.url ?? toUrl;
+        }
+        if (!fromUrl && document.referrer) fromUrl = document.referrer;
+        if (!fromUrl) return;
+
+        const fromPage = pageOf(fromUrl);
+        const toPage = pageOf(toUrl);
+        if (fromPage === null || toPage === null || fromPage === toPage) return;
+
+        e.viewTransition.types.add(toPage > fromPage ? 'next' : 'previous');
+      });
+    }
+  </script>
