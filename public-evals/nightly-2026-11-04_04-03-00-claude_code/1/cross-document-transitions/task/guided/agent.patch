+  <script>
+    // Directional cross-document view transitions. Must be a classic,
+    // render-blocking script in <head> so the pagereveal listener is
+    // registered before the new page's first render.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const DIRECTION_KEY = 'vt-direction';
+      const pageOf = (url) => {
+        try {
+          const n = parseInt(new URL(url).searchParams.get('page'), 10);
+          return Number.isFinite(n) && n > 0 ? n : 1;
+        } catch {
+          return null;
+        }
+      };
+
+      // Remember which pagination link was clicked, as a fallback for
+      // browsers without the Navigation API.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest?.('a#next, a#previous');
+        if (link) sessionStorage.setItem(DIRECTION_KEY, link.id);
+      });
+
+      window.addEventListener('pagereveal', (e) => {
+        const stored = sessionStorage.getItem(DIRECTION_KEY);
+        sessionStorage.removeItem(DIRECTION_KEY);
+        if (!e.viewTransition) return;
+
+        let type = null;
+        const activation = window.navigation?.activation;
+        if (activation?.from?.url && activation.entry?.url) {
+          // Works for link clicks and browser back/forward alike.
+          const from = pageOf(activation.from.url);
+          const to = pageOf(activation.entry.url);
+          if (from !== null && to !== null && from !== to) {
+            type = to > from ? 'next' : 'previous';
+          }
+        } else if (stored === 'next' || stored === 'previous') {
+          type = stored;
+        }
+
+        if (type) e.viewTransition.types.add(type);
+      });
+    }
+  </script>
 </head>
 
