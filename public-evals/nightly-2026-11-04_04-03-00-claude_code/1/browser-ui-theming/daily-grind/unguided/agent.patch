+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const sweetness = document.getElementById('sweetness');
+      const sweetnessOut = document.getElementById('sweetness-out');
+      const shots = document.getElementById('shots');
+      const caffeine = document.getElementById('caffeine');
+      const total = document.getElementById('total');
+      const summary = document.getElementById('summary-text');
+      const status = document.getElementById('form-status');
+      const date = document.getElementById('pickup-date');
+
+      // Pickup date: today through two weeks out
+      const iso = d => {
+        const off = d.getTimezoneOffset() * 60000;
+        return new Date(d - off).toISOString().slice(0, 10);
+      };
+      const today = new Date();
+      const later = new Date(today);
+      later.setDate(today.getDate() + 14);
+      date.min = iso(today);
+      date.max = iso(later);
+      date.value = iso(today);
+
+      const price = el => parseFloat(el?.dataset.price || 0);
+      const selected = sel => sel.options[sel.selectedIndex];
+
+      function update() {
+        const drink = selected(form.drink);
+        const milk = selected(form.milk);
+        const size = form.querySelector('input[name="size"]:checked');
+        const extras = [...form.querySelectorAll('input[name="extras"]:checked')];
+        const shotCount = Math.min(4, Math.max(1, parseInt(shots.value, 10) || 1));
+
+        // Shots beyond 2 are $0.75 each
+        const cost = price(drink) + price(size) + price(milk) +
+          extras.reduce((sum, el) => sum + price(el), 0) +
+          Math.max(0, shotCount - 2) * 0.75;
+
+        sweetnessOut.value = `${sweetness.value}%`;
+        caffeine.value = shotCount;
+        caffeine.textContent = `${shotCount} of 4 shots`;
+        total.value = `$${cost.toFixed(2)}`;
+
+        const drinkName = drink.textContent.split(' — ')[0];
+        const sizeName = size ? size.parentElement.textContent.trim() : '';
+        const milkName = milk.textContent.replace(/\s*\(.*\)/, '').toLowerCase();
+        const extraNames = extras.map(el => el.parentElement.textContent.trim().toLowerCase());
+        summary.textContent = [
+          `${sizeName} ${drinkName}`,
+          milk.value === 'none' ? 'no milk' : `${milkName} milk`,
+          `${shotCount} shot${shotCount > 1 ? 's' : ''}`,
+          ...extraNames
+        ].join(', ');
