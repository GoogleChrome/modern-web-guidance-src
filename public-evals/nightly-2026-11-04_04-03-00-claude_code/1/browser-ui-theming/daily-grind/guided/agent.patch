+  <script>
+    const form = document.querySelector('.order-form');
+    const sweetness = form.elements.sweetness;
+    const sweetnessOut = document.getElementById('sweetness-value');
+    const totalOut = document.getElementById('order-total');
+    const dateInput = form.elements.pickup_date;
+
+    // Default pickup date: today (local), no past dates
+    const now = new Date();
+    const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+    dateInput.min = today;
+    dateInput.value = today;
+
+    const price = (el) => Number(el?.dataset.price ?? 0);
+
+    function update() {
+      sweetnessOut.value = `${sweetness.value}%`;
+      sweetness.style.setProperty('--progress', `${sweetness.value}%`);
+
+      const shots = Math.min(Math.max(Number(form.elements.shots.value) || 0, 0), 4);
+      let total = price(form.elements.drink.selectedOptions[0])
+        + price(form.querySelector('[name="size"]:checked'))
+        + price(form.elements.milk.selectedOptions[0])
+        + shots * 0.75;
+      form.querySelectorAll('[name="extras"]:checked').forEach((el) => { total += price(el); });
+      totalOut.value = `$${total.toFixed(2)}`;
+    }
+
+    form.addEventListener('input', update);
+    form.addEventListener('change', update);
+    update();
+  </script>
