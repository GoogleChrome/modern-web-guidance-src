+  <script type="module">
+    // ---- Sanitization -------------------------------------------------------
+    // Untrusted review markup is ONLY ever inserted through safeSetHTML().
+    // Native Sanitizer API (setHTML) when available, DOMPurify fallback otherwise.
+    const ALLOWED_ELEMENTS = [
+      'p', 'br', 'b', 'strong', 'i', 'em', 'u', 's',
+      'ul', 'ol', 'li', 'blockquote', 'code', 'a'
+    ];
+    const ALLOWED_ATTRIBUTES = ['href'];
+    // Keep the text of common wrapper tags users paste in, but drop the tag itself.
+    const UNWRAP_ELEMENTS = ['div', 'span'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // setHTML() always strips XSS-unsafe content (scripts, on* handlers,
+        // javascript: URLs); our config narrows it further.
+        el.setHTML(html, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES,
+            replaceWithChildrenElements: UNWRAP_ELEMENTS
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        // Parse into DOM nodes (RETURN_DOM_FRAGMENT) and move them in, rather than
+        // assigning a string to innerHTML, to avoid re-parsing (mXSS).
+        const fragment = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, ...UNWRAP_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+          RETURN_DOM_FRAGMENT: true
+        });
+        // DOMPurify has no replaceWithChildrenElements; unwrap manually.
+        fragment.querySelectorAll(UNWRAP_ELEMENTS.join(',')).forEach((node) => node.replaceWith(...node.childNodes));
+        el.replaceChildren(fragment);
+      }
+
+      // Harden any surviving links (href is already restricted to safe schemes).
+      el.querySelectorAll('a[href]').forEach((a) => {
+        a.rel = 'nofollow noopener noreferrer ugc';
+        a.target = '_blank';
+      });
+    }
+
+    // ---- Data ---------------------------------------------------------------
+    const DRINKS = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+    const STORAGE_KEY = 'daily-grind-reviews';
+    const SEED_REVIEWS = [
+      {
+        drink: 'maple-oat-latte', name: 'Priya', rating: 5, date: '2026-10-28',
+        body: '<p><strong>Autumn in a cup.</strong> The maple is subtle, not syrupy.</p><ul><li>Great with an extra shot</li><li>Ask for cinnamon on top</li></ul>'
+      },
+      {
+        drink: 'dark-roast-espresso', name: 'Marcus', rating: 4, date: '2026-10-30',
+        body: '<p>Bold and <em>smoky</em> &mdash; exactly what I need before a 7am meeting.</p><blockquote>Pairs perfectly with the almond croissant.</blockquote>'
+      },
+      {
+        drink: 'cold-brew', name: 'Jo', rating: 5, date: '2026-11-01',
+        body: '<p>Silky smooth, zero bitterness. The <code>18-hour</code> steep is no joke.</p>'
+      }
+    ];
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (Array.isArray(stored)) return stored;
+      } catch { /* fall through to seed data */ }
+      return [...SEED_REVIEWS];
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch { /* storage unavailable; keep in memory only */ }
+    }
+
+    let reviews = loadReviews();
+    let activeFilter = 'all';
+
+    // ---- Rendering ----------------------------------------------------------
+    const list = document.getElementById('review-list');
+    const emptyState = document.getElementById('review-empty');
+
+    async function renderReview(review) {
+      const li = document.createElement('li');
+      li.className = 'review';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const name = document.createElement('strong');
+      name.textContent = review.name; // plain text, never HTML
+
+      const drink = document.createElement('span');
+      drink.className = 'review-drink';
+      drink.textContent = DRINKS[review.drink] ?? 'Seasonal drink';
+
+      const rating = Math.min(5, Math.max(1, Number(review.rating) || 0));
+      const stars = document.createElement('span');
+      stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
+      stars.setAttribute('aria-label', `${rating} out of 5 stars`);
+      stars.setAttribute('role', 'img');
+
+      const time = document.createElement('time');
+      time.dateTime = review.date;
+      time.textContent = new Date(review.date + 'T00:00').toLocaleDateString(undefined, { dateStyle: 'medium' });
+
+      const left = document.createElement('span');
+      left.append(name, ' · ', time);
+      const right = document.createElement('span');
+      right.append(stars, ' ', drink);
+      meta.append(left, right);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, review.body);
+
+      li.append(meta, body);
+      return li;
+    }
+
+    async function renderReviews() {
+      const visible = reviews
+        .filter((r) => activeFilter === 'all' || r.drink === activeFilter)
+        .sort((a, b) => b.date.localeCompare(a.date));
+
+      const items = await Promise.all(visible.map(renderReview));
+      list.replaceChildren(...items);
+      emptyState.hidden = items.length > 0;
+
+      for (const slug of Object.keys(DRINKS)) {
+        const count = reviews.filter((r) => r.drink === slug).length;
+        const el = document.querySelector(`[data-count-for="${slug}"]`);
+        if (el) {
+          el.replaceChildren();
+          const link = document.createElement('a');
+          link.href = '#reviews';
+          link.textContent = `${count} review${count === 1 ? '' : 's'}`;
+          link.style.color = 'inherit';
+          link.addEventListener('click', () => setFilter(slug));
+          el.append(link);
+        }
+      }
+    }
+
+    function setFilter(filter) {
+      activeFilter = filter;
+      document.querySelectorAll('.review-filters button').forEach((btn) => {
+        btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
+      });
+      renderReviews();
+    }
+
+    document.querySelector('.review-filters').addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-filter]');
+      if (btn) setFilter(btn.dataset.filter);
+    });
+
+    // ---- Form ---------------------------------------------------------------
+    const form = document.getElementById('review-form');
+    const bodyInput = document.getElementById('review-body');
+    const preview = document.getElementById('review-preview');
+    const status = document.getElementById('review-status');
+
+    let previewFrame;
+    bodyInput.addEventListener('input', () => {
+      cancelAnimationFrame(previewFrame);
+      previewFrame = requestAnimationFrame(() => safeSetHTML(preview, bodyInput.value));
+    });
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      status.textContent = '';
+
+      if (!form.checkValidity()) {
+        form.reportValidity();
+        return;
+      }
+
+      const data = new FormData(form);
+      const body = String(data.get('body')).trim();
+
+      // Reject reviews that sanitize down to nothing (e.g. only a <script>).
+      const probe = document.createElement('div');
+      await safeSetHTML(probe, body);
+      if (!probe.textContent.trim()) {
+        status.textContent = 'Your review has no displayable content after removing unsupported markup.';
+        bodyInput.focus();
+        return;
+      }
+
+      // Store the raw input; it is re-sanitized every time it is rendered.
+      // A real backend must sanitize/validate server-side as well.
+      reviews.push({
+        drink: data.get('drink') in DRINKS ? data.get('drink') : 'maple-oat-latte',
+        name: String(data.get('name')).trim().slice(0, 60),
+        rating: Number(data.get('rating')),
+        date: new Date().toISOString().slice(0, 10),
+        body: body.slice(0, 2000)
+      });
+      saveReviews(reviews);
+
+      const drink = data.get('drink');
+      form.reset();
+      preview.replaceChildren();
+      status.textContent = 'Thanks! Your review has been posted.';
+      setFilter(activeFilter === 'all' || activeFilter === drink ? activeFilter : drink);
+    });
+
+    renderReviews();
+  </script>
 </body>
 
