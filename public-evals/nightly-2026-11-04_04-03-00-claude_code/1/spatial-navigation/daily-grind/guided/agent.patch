+  <script>
+    // Layout mode switcher for the seasonal grid.
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      document.querySelectorAll('input[name="layout"]').forEach((radio) => {
+        radio.addEventListener('change', () => {
+          if (radio.checked) grid.dataset.layout = radio.value;
+        });
+      });
+    })();
+
+    // Spatial (arrow key) navigation for composite widgets marked with [data-spatial-nav].
+    // Candidates are chosen from live geometry on every keypress, so it works in any
+    // layout mode (grid, list, spanning cards, responsive reflow) without index math.
+    (() => {
+      const CANDIDATE_SELECTOR = 'a[href], button:not([disabled]), [data-spatial-item]';
+      const TOLERANCE = 1; // px, for sub-pixel rounding
+      const WEIGHT = 2; // fallback perpendicular weighting
+      const DIRECTIONS = {
+        ArrowUp: 'up',
+        ArrowDown: 'down',
+        ArrowLeft: 'left',
+        ArrowRight: 'right',
+      };
+
+      const getCandidates = (container) =>
+        [...container.querySelectorAll(CANDIDATE_SELECTOR)].filter((el) =>
+          el.checkVisibility({ visibilityProperty: true, opacityProperty: true })
+        );
+
+      // Returns [gap along nav axis, perpendicular overlap?, perpendicular centre offset]
+      // or null if the candidate is not in the requested direction.
+      function measure(from, to, dir) {
+        const horizontal = dir === 'left' || dir === 'right';
+        let gap;
+        switch (dir) {
+          case 'right': gap = to.left - from.right; break;
+          case 'left': gap = from.left - to.right; break;
+          case 'down': gap = to.top - from.bottom; break;
+          case 'up': gap = from.top - to.bottom; break;
+        }
+        if (gap < -TOLERANCE) return null;
+        gap = Math.max(gap, 0);
+
+        const [fStart, fEnd, tStart, tEnd] = horizontal
+          ? [from.top, from.bottom, to.top, to.bottom]
+          : [from.left, from.right, to.left, to.right];
+        const overlaps = Math.min(fEnd, tEnd) - Math.max(fStart, tStart) > TOLERANCE;
+        const offset = Math.abs((fStart + fEnd) / 2 - (tStart + tEnd) / 2);
+        return { gap, overlaps, offset };
+      }
+
+      function findNext(current, candidates, dir) {
+        const from = current.getBoundingClientRect();
+        let bestAligned = null;
+        let bestFallback = null;
+
+        for (const el of candidates) {
+          if (el === current) continue;
+          const m = measure(from, el.getBoundingClientRect(), dir);
+          if (!m) continue;
+
+          if (m.overlaps) {
+            if (
+              !bestAligned ||
+              m.gap < bestAligned.gap ||
+              (m.gap === bestAligned.gap && m.offset < bestAligned.offset)
+            ) {
+              bestAligned = { el, gap: m.gap, offset: m.offset };
+            }
+          } else {
+            const score = m.gap + WEIGHT * m.offset;
+            if (!bestFallback || score < bestFallback.score) {
+              bestFallback = { el, score };
+            }
+          }
+        }
+        return (bestAligned ?? bestFallback)?.el ?? null;
+      }
+
+      function setActive(candidates, active) {
+        for (const el of candidates) el.tabIndex = el === active ? 0 : -1;
+      }
+
+      function initSpatialNav(container) {
+        // Roving tabindex: only one tab stop for the whole widget.
+        const candidates = getCandidates(container);
+        if (candidates.length) setActive(candidates, candidates[0]);
+
+        // Keep the tab stop on whichever item was last focused (e.g. via mouse click).
+        container.addEventListener('focusin', (e) => {
+          const items = getCandidates(container);
+          if (items.includes(e.target)) setActive(items, e.target);
+        });
+
+        container.addEventListener('keydown', (e) => {
+          const dir = DIRECTIONS[e.key];
+          if (!dir || e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+          const target = e.composedPath()[0];
+          if (
+            target instanceof Element &&
+            target.matches(':read-write, select, input[type="range"], [role="slider"]')
+          ) return;
+
+          const items = getCandidates(container);
+          if (!items.includes(target)) return;
+
+          const next = findNext(target, items, dir);
+          if (!next) return; // let the browser scroll natively
+
+          e.preventDefault();
+          setActive(items, next);
+          next.focus({ preventScroll: true });
+          next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+
+        // If the active item becomes hidden (e.g. layout change), keep a valid tab stop.
+        new ResizeObserver(() => {
+          const items = getCandidates(container);
+          if (items.length && !items.some((el) => el.tabIndex === 0)) {
+            setActive(items, items[0]);
+          }
+        }).observe(container);
+      }
+
+      document.querySelectorAll('[data-spatial-nav]').forEach(initSpatialNav);
+    })();
+  </script>
+
