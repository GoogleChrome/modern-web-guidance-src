+  <script>
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      const status = document.getElementById('layout-status');
+      const toggles = document.querySelectorAll('[data-layout-option]');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Focusable target in each card (the card's primary action).
+      const getItems = () =>
+        Array.from(grid.querySelectorAll('.card .btn')).filter((el) => {
+          const r = el.closest('.card').getBoundingClientRect();
+          return r.width > 0 && r.height > 0; // skip hidden cards
+        });
+
+      // Roving tabindex: only one card action is in the Tab sequence.
+      const setActive = (target, { focus = true } = {}) => {
+        getItems().forEach((el) => { el.tabIndex = el === target ? 0 : -1; });
+        if (focus && target) {
+          target.focus({ preventScroll: true });
+          target.closest('.card').scrollIntoView({
+            block: 'nearest',
+            inline: 'nearest',
+            behavior: reduceMotion.matches ? 'auto' : 'smooth',
+          });
+        }
+      };
+
+      const rectOf = (el) => el.closest('.card').getBoundingClientRect();
+      const center = (r) => ({ x: r.left + r.width / 2, y: r.top + r.height / 2 });
+      const overlap = (a1, a2, b1, b2) => Math.max(0, Math.min(a2, b2) - Math.max(a1, b1));
+
+      /*
+       * Geometry-based spatial navigation. Uses each card's rendered box, so it
+       * works for any column count (responsive auto-fit), list mode, uneven row
+       * heights and RTL — no assumptions about DOM order vs. visual order.
+       */
+      const findInDirection = (current, items, dir) => {
+        const from = rectOf(current);
+        const c = center(from);
+        const horizontal = dir === 'left' || dir === 'right';
+        const sign = dir === 'right' || dir === 'down' ? 1 : -1;
+        const EPS = 1;
+
+        let best = null;
+        let bestScore = Infinity;
+        for (const el of items) {
+          if (el === current) continue;
+          const r = rectOf(el);
+          const rc = center(r);
+
+          // Must lie strictly beyond the current card's edge in the chosen direction.
+          const ahead = horizontal
+            ? (sign > 0 ? r.left >= from.right - EPS : r.right <= from.left + EPS)
+            : (sign > 0 ? r.top >= from.bottom - EPS : r.bottom <= from.top + EPS);
+          if (!ahead) continue;
+
+          const primary = horizontal ? Math.abs(rc.x - c.x) : Math.abs(rc.y - c.y);
+          const secondary = horizontal ? Math.abs(rc.y - c.y) : Math.abs(rc.x - c.x);
+          const shared = horizontal
+            ? overlap(from.top, from.bottom, r.top, r.bottom)
+            : overlap(from.left, from.right, r.left, r.right);
+
+          // Strongly prefer cards that share the same row/column band.
+          const score = primary + secondary * (shared > 0 ? 0.5 : 4) - shared * 0.1;
+          if (score < bestScore) { bestScore = score; best = el; }
+        }
+        return best;
+      };
+
+      // Cards sharing a visual row with `current`, sorted by visual x position.
+      const rowOf = (current, items) => {
+        const from = rectOf(current);
+        return items
+          .filter((el) => {
+            const r = rectOf(el);
+            return overlap(from.top, from.bottom, r.top, r.bottom) > Math.min(from.height, r.height) / 2;
+          })
+          .sort((a, b) => rectOf(a).left - rectOf(b).left);
+      };
+
+      // Reading order: top-to-bottom, then inline-start to inline-end.
+      const visualOrder = (items, rtl) =>
+        items.slice().sort((a, b) => {
+          const ra = rectOf(a), rb = rectOf(b);
+          if (Math.abs(ra.top - rb.top) > 1) return ra.top - rb.top;
+          return rtl ? rb.left - ra.left : ra.left - rb.left;
+        });
+
+      grid.addEventListener('keydown', (e) => {
+        const current = e.target.closest('.card .btn');
+        if (!current || e.altKey || e.metaKey || e.shiftKey) return;
+
+        const items = getItems();
+        const rtl = getComputedStyle(grid).direction === 'rtl';
+        let target = null;
+
+        switch (e.key) {
+          case 'ArrowRight': target = findInDirection(current, items, 'right'); break;
+          case 'ArrowLeft': target = findInDirection(current, items, 'left'); break;
+          case 'ArrowDown': target = findInDirection(current, items, 'down'); break;
+          case 'ArrowUp': target = findInDirection(current, items, 'up'); break;
+          case 'Home':
+          case 'End': {
+            // Logical start/end: respects RTL reading direction.
+            const row = rowOf(current, items);
+            const ordered = e.ctrlKey ? visualOrder(items, rtl) : (rtl ? row.reverse() : row);
+            target = e.key === 'Home' ? ordered[0] : ordered[ordered.length - 1];
+            break;
+          }
+          default:
+            return;
+        }
+
+        // Always consume handled keys so the page doesn't scroll at edges.
+        e.preventDefault();
+        if (target && target !== current) setActive(target);
+      });
+
+      // Keep the roving tabindex in sync if focus arrives by click or other means.
+      grid.addEventListener('focusin', (e) => {
+        const el = e.target.closest('.card .btn');
+        if (el && el.tabIndex !== 0) setActive(el, { focus: false });
+      });
+
+      // Layout mode switching.
+      const applyLayout = (mode) => {
+        grid.dataset.layout = mode;
+        toggles.forEach((btn) => {
+          btn.setAttribute('aria-pressed', String(btn.dataset.layoutOption === mode));
+        });
+        status.textContent = `Showing drinks as a ${mode}.`;
+        try { localStorage.setItem('seasonal-layout', mode); } catch (_) { /* ignore */ }
+      };
+
+      toggles.forEach((btn) => {
+        btn.addEventListener('click', () => applyLayout(btn.dataset.layoutOption));
+      });
+
+      let saved = null;
+      try { saved = localStorage.getItem('seasonal-layout'); } catch (_) { /* ignore */ }
+      if (saved === 'grid' || saved === 'list') {
+        grid.dataset.layout = saved;
+        toggles.forEach((btn) => {
+          btn.setAttribute('aria-pressed', String(btn.dataset.layoutOption === saved));
+        });
+      }
+
+      setActive(getItems()[0], { focus: false });
+    })();
+  </script>
+
