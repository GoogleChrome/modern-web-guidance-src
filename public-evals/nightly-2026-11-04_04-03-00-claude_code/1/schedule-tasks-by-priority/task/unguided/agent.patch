+  <script>
+    (() => {
+      // ---- Task definitions -------------------------------------------------
+      const PRIORITY = {
+        urgent: { rank: 0, label: 'Urgent', steps: [6, 10], names: ['Checkout #', 'Payment auth #', 'Order confirm #'] },
+        standard: { rank: 1, label: 'Standard', steps: [14, 22], names: ['Menu update: ', 'Price sync: '] },
+        background: { rank: 2, label: 'Background', steps: [24, 36], names: ['Telemetry batch #', 'Analytics flush #'] }
+      };
+      const MENU_ITEMS = ['Maple Oat Latte', 'Dark Roast', 'Cold Brew', 'Chai', 'Flat White', 'Mocha'];
+      const STEP_COST_MS = 4;     // simulated CPU work per step
+      const SLICE_BUDGET_MS = 12; // max continuous main-thread time before yielding
+
+      // Burn CPU synchronously to simulate expensive work (parsing, hashing, rendering...).
+      function simulateWork(ms) {
+        const end = performance.now() + ms;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(x + 1);
+        return x;
+      }
+
+      // Yield control so the browser can paint and handle input.
+      const yieldToMain = (() => {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') {
+          return () => scheduler.yield();
+        }
+        const channel = new MessageChannel();
+        const pending = [];
+        channel.port1.onmessage = () => pending.shift()?.();
+        return () => new Promise(resolve => { pending.push(resolve); channel.port2.postMessage(null); });
+      })();
+
+      // ---- Priority scheduler ----------------------------------------------
+      // One FIFO lane per priority. After each time slice we yield and then
+      // re-select the highest-priority task, so urgent work pre-empts in-flight
+      // lower-priority jobs at the next slice boundary.
+      const lanes = [[], [], []];
+      const stats = { completed: 0, longestBlock: 0 };
+      let seq = 0;
+      let pumping = false;
+
+      function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
+
+      function createTask(type) {
+        const def = PRIORITY[type];
+        const id = ++seq;
+        const prefix = def.names[rand(0, def.names.length - 1)];
+        const name = type === 'standard'
+          ? prefix + MENU_ITEMS[rand(0, MENU_ITEMS.length - 1)]
+          : prefix + (1000 + id);
+        return { id, type, name, total: rand(...def.steps), done: 0, status: 'queued', enqueuedAt: performance.now() };
+      }
+
+      function enqueue(type) {
+        const task = createTask(type);
+        lanes[PRIORITY[type].rank].push(task);
+        log(`Queued ${PRIORITY[type].label.toLowerCase()} task "${task.name}" (${task.total} steps)`);
+        render();
+        pump();
+        return task;
+      }
+
+      function nextTask() {
+        for (const lane of lanes) if (lane.length) return lane[0];
+        return null;
+      }
+
+      async function pump() {
+        if (pumping) return;
+        pumping = true;
+        let lastActive = null;
+        try {
+          let task;
+          while ((task = nextTask())) {
+            if (lastActive && lastActive !== task && lastActive.status === 'running') {
+              log(`"${lastActive.name}" paused for higher-priority "${task.name}"`, 'warn');
+            }
+            if (task.status === 'queued') {
+              task.status = 'running';
+              task.startedAt = performance.now();
+              log(`Started "${task.name}"`);
+            }
+            lastActive = task;
+
+            // Run steps until the slice budget is spent or the task finishes.
+            const sliceStart = performance.now();
+            while (task.done < task.total && performance.now() - sliceStart < SLICE_BUDGET_MS) {
+              simulateWork(STEP_COST_MS);
+              task.done++;
+            }
+            stats.longestBlock = Math.max(stats.longestBlock, performance.now() - sliceStart);
+
+            if (task.done >= task.total) {
+              finish(task);
+              lastActive = null;
+            }
+            render();
+
+            // Background work gets an extra macrotask gap so it is maximally polite.
+            if (task.type === 'background') await new Promise(r => setTimeout(r, 0));
+            else await yieldToMain();
+          }
+        } finally {
+          pumping = false;
+        }
+      }
+
+      function finish(task) {
+        task.status = 'done';
+        const lane = lanes[PRIORITY[task.type].rank];
+        lane.splice(lane.indexOf(task), 1);
+        stats.completed++;
+        const waited = Math.round(task.startedAt - task.enqueuedAt);
+        const total = Math.round(performance.now() - task.enqueuedAt);
+        log(`Completed "${task.name}" — waited ${waited} ms, total ${total} ms`, 'ok');
+      }
+
+      function cancelPending() {
+        let count = 0;
+        for (const lane of lanes) {
+          for (let i = lane.length - 1; i >= 0; i--) {
+            if (lane[i].status === 'queued') { lane.splice(i, 1); count++; }
+          }
+        }
+        log(count ? `Cancelled ${count} pending task${count > 1 ? 's' : ''}` : 'No pending tasks to cancel', 'warn');
+        render();
+      }
+
+      function runBatch() {
+        // Deliberately enqueue in a shuffled order; the scheduler still runs them by priority.
+        const mix = ['background', 'standard', 'urgent', 'background', 'standard', 'urgent', 'background', 'standard'];
+        for (let i = mix.length - 1; i > 0; i--) {
+          const j = rand(0, i);
+          [mix[i], mix[j]] = [mix[j], mix[i]];
+        }
+        log(`Batch submitted in order: ${mix.join(', ')}`);
+        mix.forEach(enqueue);
+      }
+
+      // ---- UI ---------------------------------------------------------------
+      const $ = id => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+      const MAX_LOG = 120;
+
+      function log(message, kind = '') {
+        const li = document.createElement('li');
+        const t = document.createElement('span');
+        t.className = 't';
+        t.textContent = new Date().toLocaleTimeString([], { hour12: false });
+        const m = document.createElement('span');
+        if (kind) m.className = kind;
+        m.textContent = message;
+        li.append(t, m);
+        logEl.prepend(li);
+        while (logEl.children.length > MAX_LOG) logEl.lastChild.remove();
+      }
+
+      let renderQueued = false;
+      function render() {
+        if (renderQueued) return;
+        renderQueued = true;
+        requestAnimationFrame(() => {
+          renderQueued = false;
+          const tasks = lanes.flat();
+          $('ops-pending').textContent = tasks.length;
+          $('ops-done').textContent = stats.completed;
+          $('ops-block').textContent = `${stats.longestBlock.toFixed(1)} ms`;
+
+          if (!tasks.length) {
+            queueEl.innerHTML = '<li class="ops-empty">Queue is idle. Add a task above.</li>';
+            return;
+          }
+          const frag = document.createDocumentFragment();
+          for (const task of tasks) {
+            const pct = Math.round((task.done / task.total) * 100);
+            const li = document.createElement('li');
+            li.className = `ops-task p-${task.type}${task.status === 'running' ? ' running' : ''}`;
+            li.innerHTML = `
+              <div class="ops-task-head">
+                <strong></strong>
+                <span class="ops-badge"></span>
+              </div>
+              <div class="ops-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${pct}">
+                <span style="width:${pct}%"></span>
+              </div>`;
+            li.querySelector('strong').textContent = task.name;
+            li.querySelector('.ops-badge').textContent =
+              `${PRIORITY[task.type].label} · ${task.status === 'running' ? pct + '%' : 'queued'}`;
+            frag.append(li);
+          }
+          queueEl.replaceChildren(frag);
+        });
+      }
+
+      // JS-driven heartbeat + FPS meter: visibly stutters if the main thread is blocked.
+      const heart = $('ops-heartbeat');
+      const fpsEl = $('ops-fps');
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      let frames = 0, lastFpsAt = performance.now(), angle = 0, lastFrame = performance.now();
+      (function tick(now) {
+        angle = (angle + (now - lastFrame) * 0.36) % 360;
+        lastFrame = now;
+        if (!reduceMotion) heart.style.transform = `rotate(${angle}deg)`;
+        frames++;
+        if (now - lastFpsAt >= 500) {
+          fpsEl.textContent = `${Math.round((frames * 1000) / (now - lastFpsAt))} fps`;
+          frames = 0;
+          lastFpsAt = now;
+        }
+        requestAnimationFrame(tick);
+      })(performance.now());
+
+      document.querySelectorAll('[data-ops-add]').forEach(btn =>
+        btn.addEventListener('click', () => enqueue(btn.dataset.opsAdd)));
+      $('ops-batch').addEventListener('click', runBatch);
+      $('ops-cancel').addEventListener('click', cancelPending);
+      $('ops-clear').addEventListener('click', () => logEl.replaceChildren());
+
+      render();
+    })();
+  </script>
+
 </body>
 
