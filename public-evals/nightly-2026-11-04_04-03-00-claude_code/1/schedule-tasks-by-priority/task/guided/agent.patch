+  <script>
+    (() => {
+      // Task catalogue: each one simulates CPU-heavy work for `cost` ms.
+      const TASKS = {
+        checkout: { label: 'Checkout: authorize payment', priority: 'user-blocking', cost: 350 },
+        menu: { label: 'Menu: refresh seasonal prices', priority: 'user-visible', cost: 800 },
+        telemetry: { label: 'Telemetry: flush analytics log', priority: 'background', cost: 1400 },
+      };
+      const PRIORITY_RANK = { 'user-blocking': 0, 'user-visible': 1, 'background': 2 };
+      const SLICE_BUDGET = 50; // ms before yielding back to the main thread
+
+      const log = document.getElementById('ops-log');
+      const pendingEl = document.getElementById('ops-pending');
+      const doneEl = document.getElementById('ops-done');
+      const gapEl = document.getElementById('ops-gap');
+
+      let pending = 0;
+      let done = 0;
+      let seq = 0;
+      let controller = new AbortController();
+
+      const hasNativeYield = () => 'scheduler' in window && 'yield' in window.scheduler;
+      const yieldToMain = () => hasNativeYield()
+        ? scheduler.yield()
+        : new Promise((resolve) => setTimeout(resolve, 0));
+
+      // Minimal priority queue used only if neither native scheduler.postTask nor the polyfill is available.
+      const fallbackQueue = [];
+      let fallbackRunning = false;
+      function fallbackPostTask(fn, { priority = 'user-visible', signal } = {}) {
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({ fn, priority, signal, resolve, reject, order: fallbackQueue.length });
+          fallbackQueue.sort((a, b) => PRIORITY_RANK[a.priority] - PRIORITY_RANK[b.priority] || a.order - b.order);
+          if (!fallbackRunning) {
+            fallbackRunning = true;
+            setTimeout(drainFallback, 0);
+          }
+        });
+      }
+      async function drainFallback() {
+        while (fallbackQueue.length) {
+          const job = fallbackQueue.shift();
+          if (job.signal?.aborted) {
+            job.reject(job.signal.reason);
+            continue;
+          }
+          try { job.resolve(await job.fn()); } catch (err) { job.reject(err); }
+          await new Promise((r) => setTimeout(r, 0));
+        }
+        fallbackRunning = false;
+      }
+
+      const postTask = (fn, options) => ('scheduler' in window && 'postTask' in window.scheduler)
+        ? scheduler.postTask(fn, options)
+        : fallbackPostTask(fn, options);
+
+      // Busy-wait to simulate synchronous CPU work (e.g. totals, tax, serialization).
+      function burn(ms) {
+        const end = performance.now() + ms;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(x + 1);
+        return x;
+      }
+
+      function updateCounters() {
+        pendingEl.textContent = pending;
+        doneEl.textContent = done;
+      }
+
+      function createEntry(task) {
+        const li = document.createElement('li');
+        li.dataset.state = 'queued';
+        const badge = document.createElement('span');
+        badge.className = `ops-badge ${task.priority}`;
+        badge.textContent = task.priority;
+        const name = document.createElement('span');
+        name.textContent = `#${++seq} ${task.label}`;
+        const state = document.createElement('span');
+        state.className = 'ops-state';
+        state.textContent = 'queued';
+        const bar = document.createElement('progress');
+        bar.max = task.cost;
+        bar.value = 0;
+        bar.setAttribute('aria-label', `${task.label} progress`);
+        li.append(badge, name, state, bar);
+        log.append(li);
+        li.scrollIntoView({ block: 'nearest' });
+        return { li, state, bar };
+      }
+
+      function enqueue(key) {
+        const task = TASKS[key];
+        const { li, state, bar } = createEntry(task);
+        const { signal } = controller;
+        const queuedAt = performance.now();
+        pending++;
+        updateCounters();
+
+        postTask(async () => {
+          li.dataset.state = 'running';
+          state.textContent = `running (waited ${Math.round(performance.now() - queuedAt)} ms)`;
+          let elapsed = 0;
+          let deadline = performance.now() + SLICE_BUDGET;
+          while (elapsed < task.cost) {
+            const chunk = Math.min(5, task.cost - elapsed);
+            burn(chunk);
+            elapsed += chunk;
+            if (performance.now() >= deadline) {
+              bar.value = elapsed;
+              await yieldToMain();
+              if (signal.aborted) throw signal.reason;
+              deadline = performance.now() + SLICE_BUDGET;
+            }
+          }
+          bar.value = task.cost;
+        }, { priority: task.priority, signal })
+          .then(() => {
+            li.dataset.state = 'done';
+            state.textContent = `done in ${Math.round(performance.now() - queuedAt)} ms`;
+            done++;
+          })
+          .catch(() => {
+            li.dataset.state = 'cancelled';
+            state.textContent = 'cancelled';
+          })
+          .finally(() => {
+            pending--;
+            updateCounters();
+          });
+      }
+
+      function runBatch() {
+        // Deliberately submitted lowest-priority-first; the scheduler still runs them by priority.
+        ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout', 'menu', 'telemetry']
+          .forEach(enqueue);
+      }
+
+      document.querySelectorAll('.ops-controls [data-task]').forEach((btn) => {
+        btn.addEventListener('click', () => enqueue(btn.dataset.task));
+      });
+      document.getElementById('ops-batch').addEventListener('click', runBatch);
+      document.getElementById('ops-cancel').addEventListener('click', () => {
+        controller.abort(new DOMException('Cancelled by user', 'AbortError'));
+        controller = new AbortController();
+      });
+      document.getElementById('ops-clear').addEventListener('click', () => {
+        log.querySelectorAll('li:not([data-state="queued"]):not([data-state="running"])')
+          .forEach((li) => li.remove());
+      });
+
+      // Frame-gap monitor: shows the longest main-thread stall over the last few seconds.
+      let last = performance.now();
+      let worst = 0;
+      let windowStart = last;
+      function frame(now) {
+        worst = Math.max(worst, now - last);
+        last = now;
+        if (now - windowStart > 2000) {
+          gapEl.textContent = `${Math.round(worst)} ms`;
+          worst = 0;
+          windowStart = now;
+        }
+        requestAnimationFrame(frame);
+      }
+      requestAnimationFrame(frame);
+
+      // Load the scheduler polyfill only where the native API is missing (e.g. Safari).
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.async = true;
+        document.head.append(script);
+      }
+    })();
+  </script>
+
