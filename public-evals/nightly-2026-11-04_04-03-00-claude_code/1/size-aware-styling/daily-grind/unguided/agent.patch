+        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+        text-align: left;
+      }
+
+      .card-media {
+        aspect-ratio: auto;
+        min-height: 100%;
+      }
+
+      .card-body {
+        align-items: flex-start;
+        justify-content: center;
+        padding: 24px 28px;
+      }
+
+      .card .btn {
+        margin-top: 0;
+      }
+    }
+
+    /* Extra-wide card: roomier spacing and larger type */
+    @container drink-card (min-width: 700px) {
+      .card-layout {
+        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+      }
+
+      .card-body {
+        padding: 36px 44px;
+      }
+
+      .card h3 {
+        font-size: 1.6rem;
+      }
+
+      .card p {
+        font-size: 1.1rem;
+      }
+    }
