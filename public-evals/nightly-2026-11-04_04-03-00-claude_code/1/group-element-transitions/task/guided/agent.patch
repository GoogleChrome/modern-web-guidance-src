+  <script>
+    const IMG = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=400&q=70`;
+    const beans = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', meta: 'Light roast · Washed', notes: 'Jasmine, bergamot and lemon zest.', img: IMG('1559056199-641a0ac8b55e') },
+      { id: 'colombia', name: 'Colombia Huila', meta: 'Medium roast · Washed', notes: 'Red apple, caramel and milk chocolate.', img: IMG('1447933601403-0c6688de566e') },
+      { id: 'sumatra', name: 'Sumatra Mandheling', meta: 'Dark roast · Wet-hulled', notes: 'Cedar, dark cocoa and earthy spice.', img: IMG('1511920170033-f8396924c348') },
+      { id: 'kenya', name: 'Kenya Nyeri AA', meta: 'Light roast · Washed', notes: 'Blackcurrant, grapefruit and cane sugar.', img: IMG('1514432324607-a09d9b4aefdd') },
+      { id: 'guatemala', name: 'Guatemala Antigua', meta: 'Medium roast · Washed', notes: 'Toffee, almond and soft orange.', img: IMG('1497935586351-b67a49e012bf') },
+      { id: 'brazil', name: 'Brazil Cerrado', meta: 'Medium-dark roast · Natural', notes: 'Hazelnut, brown sugar and cocoa nib.', img: IMG('1509042239860-f550ce710b93') },
+    ];
+
+    const selected = new Set(['colombia']);
+    const catalogEl = document.getElementById('bean-catalog');
+    const selectionEl = document.getElementById('bean-selection');
+    const statusEl = document.getElementById('bean-status');
+
+    // Build each card once; cards are moved between lists so the same
+    // element (and view-transition-name) persists across states.
+    const cards = new Map(beans.map((bean) => {
+      const li = document.createElement('li');
+      li.className = 'bean-card';
+      li.style.viewTransitionName = `bean-${bean.id}`;
+      li.innerHTML = `
+        <img src="${bean.img}" alt="" width="400" height="300" loading="lazy">
+        <div class="bean-body">
+          <div>
+            <h4>${bean.name}</h4>
+            <p class="bean-meta">${bean.meta}</p>
+          </div>
+          <p class="bean-notes">${bean.notes}</p>
+          <button type="button" class="bean-toggle" data-bean="${bean.id}"></button>
+        </div>`;
+      return [bean.id, li];
+    }));
+
+    function render() {
+      for (const bean of beans) {
+        const card = cards.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        const button = card.querySelector('.bean-toggle');
+        button.textContent = isSelected ? 'Remove' : 'Add to box';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+        (isSelected ? selectionEl : catalogEl).append(card);
+      }
+      document.getElementById('catalog-count').textContent = `${beans.length - selected.size} left`;
+      document.getElementById('selection-count').textContent = `${selected.size} selected`;
+    }
+
+    function toggle(id) {
+      const name = beans.find((b) => b.id === id).name;
+      const update = () => {
+        selected.has(id) ? selected.delete(id) : selected.add(id);
+        render();
+        statusEl.textContent = `${name} ${selected.has(id) ? 'added to' : 'removed from'} your box.`;
+        cards.get(id).querySelector('.bean-toggle').focus({ preventScroll: true });
+      };
+
+      if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+    }
+
+    document.querySelector('.beans').addEventListener('click', (event) => {
+      const button = event.target.closest('.bean-toggle');
+      if (button) toggle(button.dataset.bean);
+    });
+
+    render();
+  </script>
+
