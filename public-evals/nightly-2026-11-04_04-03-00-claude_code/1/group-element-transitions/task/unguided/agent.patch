+  <script>
+    (() => {
+      const beans = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral, bergamot, light roast', price: 18, roast: '#a1704a' },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, medium', price: 16, roast: '#7b4a2d' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy, cedar, dark roast', price: 17, roast: '#3e2418' },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Cocoa, spice, medium', price: 16, roast: '#6a3f26' },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, bright, light', price: 19, roast: '#956240' },
+        { id: 'brazil', name: 'Brazil Santos', notes: 'Nutty, chocolate, medium-dark', price: 14, roast: '#553220' },
+      ];
+
+      const catalog = document.getElementById('bean-catalog');
+      const selection = document.getElementById('bean-selection');
+      const status = document.getElementById('bean-status');
+      const selected = new Set();
+      const order = beans.map(b => b.id);
+
+      // Build one card per bean. Each card keeps its element identity as it
+      // moves between lists, and gets a unique view-transition-name so the
+      // browser can track it; the shared `bean` class supplies the animation.
+      const cards = new Map(beans.map(bean => {
+        const li = document.createElement('li');
+        li.className = 'bean-card';
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.innerHTML = `
+          <span class="bean-swatch" style="--roast:${bean.roast}" aria-hidden="true"></span>
+          <span class="bean-info">
+            <strong>${bean.name}</strong>
+            <span>${bean.notes} &middot; $${bean.price}/bag</span>
+          </span>
+          <button type="button" class="bean-toggle"></button>`;
+        li.querySelector('button').addEventListener('click', () => toggle(bean));
+        return [bean.id, li];
+      }));
+
+      function render() {
+        // Catalog keeps the original ordering; selection keeps pick order.
+        catalog.replaceChildren(...order.filter(id => !selected.has(id)).map(id => cards.get(id)));
+        selection.replaceChildren(...[...selected].map(id => cards.get(id)));
+
+        for (const bean of beans) {
+          const btn = cards.get(bean.id).querySelector('button');
+          const inBox = selected.has(bean.id);
+          btn.textContent = inBox ? '−' : '+';
+          btn.setAttribute('aria-label', `${inBox ? 'Remove' : 'Add'} ${bean.name}`);
+        }
+
+        const total = beans.filter(b => selected.has(b.id)).reduce((sum, b) => sum + b.price, 0);
+        document.getElementById('bean-total').textContent = `Total: $${total.toFixed(2)}`;
+        document.getElementById('catalog-count').textContent = `${catalog.children.length} available`;
+        document.getElementById('selection-count').textContent = `${selected.size} selected`;
+        document.getElementById('bean-checkout').disabled = selected.size === 0;
+      }
+
+      function toggle(bean) {
+        const adding = !selected.has(bean.id);
+        const update = () => {
+          adding ? selected.add(bean.id) : selected.delete(bean.id);
+          render();
+          // Re-inserting the card drops focus; restore it for keyboard users.
+          cards.get(bean.id).querySelector('button').focus({ preventScroll: true });
+        };
+
+        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        if (!document.startViewTransition || reduceMotion) {
+          update();
+        } else {
+          // One transition snapshots every card at once, so the moved card and
+          // all the siblings that reflow animate simultaneously.
+          document.startViewTransition(update);
+        }
+
+        status.textContent = `${bean.name} ${adding ? 'added to' : 'removed from'} your box.`;
+      }
+
+      render();
+    })();
+  </script>
