+  <script type="module">
+    const registerButton = document.getElementById('register-button');
+    const statusEl = document.getElementById('passkey-status');
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    // Load the JSON (de)serialization polyfill only for browsers that support
+    // WebAuthn but lack parseCreationOptionsFromJSON / toJSON natively.
+    async function ensureWebAuthnJSONSupport() {
+      if (
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+    }
+
+    // Gate the UI: only enable the button when passkeys are actually usable.
+    async function isPasskeyRegistrationAvailable() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+        return false;
+      }
+      try {
+        await ensureWebAuthnJSONSupport();
+      } catch {
+        return false;
+      }
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet);
+      }
+      // Older browsers: fall back to the individual capability checks.
+      const [platform, conditional] = await Promise.all([
+        PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.() ?? false,
+        PublicKeyCredential.isConditionalMediationAvailable?.() ?? false,
+      ]);
+      return Boolean(platform && conditional);
+    }
+
+    async function signalUnknownCredential(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function registerPasskey() {
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      setStatus('Preparing passkey creation…');
+
+      try {
+        // 1. Fetch creation options (challenge is generated and stored server-side).
+        let creationOptionsJSON;
+        try {
+          const optionsResponse = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({ promotion: true }),
+          });
+          if (!optionsResponse.ok) throw new Error(`HTTP ${optionsResponse.status}`);
+          creationOptionsJSON = await optionsResponse.json();
+        } catch (err) {
+          console.error('Failed to fetch passkey creation options:', err);
+          setStatus('We couldn’t start passkey creation. Please try again later.', 'error');
+          return;
+        }
+
+        const rpId = creationOptionsJSON.rp?.id ?? location.hostname;
+
+        // 2. Create the credential with the native WebAuthn API.
+        let credential;
+        try {
+          const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+          setStatus('Follow your device’s prompt to create a passkey.');
+          credential = await navigator.credentials.create({ publicKey });
+          if (!credential) throw new DOMException('No credential returned', 'NotAllowedError');
+        } catch (err) {
+          switch (err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey for this account already exists on this device or password manager.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled or timed out.');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.');
+              break;
+            case 'SecurityError':
+              console.error('Passkey creation security error (RP ID mismatch or insecure context):', err);
+              setStatus('Passkeys aren’t available on this site right now.', 'error');
+              break;
+            default:
+              console.error('Passkey creation failed:', err);
+              setStatus('Something went wrong while creating your passkey.', 'error');
+          }
+          return; // Standard WebAuthn failures: no credential was stored, nothing to signal.
+        }
+
+        // 3. Verify the registration on the server.
+        const registrationJSON = credential.toJSON();
+        setStatus('Verifying your passkey…');
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify(registrationJSON),
+          });
+          if (!verifyResponse.ok) throw new Error(`HTTP ${verifyResponse.status}`);
+        } catch (err) {
+          console.error('Passkey verification failed:', err);
+          // The authenticator saved a credential the server doesn't know about:
+          // tell the password manager to remove the orphaned passkey.
+          await signalUnknownCredential(rpId, registrationJSON.id);
+          setStatus('We couldn’t verify your passkey. Please try again.', 'error');
+          return;
+        }
+
+        setStatus('Passkey created! Next time, sign in with your passkey.', 'success');
+      } finally {
+        registerButton.removeAttribute('aria-busy');
+        registerButton.disabled = false;
+      }
+    }
+
+    registerButton.addEventListener('click', registerPasskey);
+
+    isPasskeyRegistrationAvailable()
+      .catch(() => false)
+      .then((available) => {
+        registerButton.disabled = !available;
+        if (!available) {
+          setStatus('Passkeys aren’t supported on this device or browser.');
+        }
+      });
+  </script>
+
 </body>
 
