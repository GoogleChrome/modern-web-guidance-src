+    /* Roast Picker (customizable select) */
+    .roast-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 6px;
+      width: min(340px, 100%);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--secondary);
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background-color: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-select::picker-icon {
+      color: var(--primary);
+    }
+
+    .roast-select::picker(select) {
+      width: anchor-size(width);
+      margin-top: 6px;
+      padding: 6px;
+      background-color: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background-color: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      background-color: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked .roast-title {
+      font-weight: 700;
+    }
+
+    .roast-select option svg {
+      flex: none;
+      width: 28px;
+      height: 28px;
+      color: var(--accent);
+    }
+
+    .roast-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-title {
+      font-weight: 600;
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      opacity: 0.8;
+    }
+
+    /* Separator only shows in browsers that flatten options to plain text */
+    .roast-sep {
+      display: none;
+    }
+
+    /* Keep the closed button compact: icon + title only */
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    .roast-select selectedcontent svg {
+      width: 22px;
+      height: 22px;
+      color: var(--primary);
+    }
+
+    .roast-select selectedcontent .roast-desc {
+      display: none;
+    }
   </style>
