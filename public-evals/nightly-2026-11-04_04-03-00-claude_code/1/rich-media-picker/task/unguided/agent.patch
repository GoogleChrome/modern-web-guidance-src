+    /* Roast Picker (customizable select; falls back to native select) */
+    .roast-picker {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1.5px;
+      color: var(--secondary);
+    }
+
+    .roast-select {
+      min-width: 300px;
+      max-width: 90vw;
+      padding: 10px 14px;
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-picker + .btn {
+      margin-top: 1rem;
+    }
+
+    .roast-option .roast-icon,
+    .roast-option .roast-desc {
+      display: none;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 10px;
+        text-align: left;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: none;
+        border-radius: 8px;
+        background: white;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+      }
+
+      .roast-option {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        padding: 10px 12px;
+        border-radius: 6px;
+        color: var(--text);
+        cursor: pointer;
+      }
+
+      .roast-option::checkmark {
+        order: 1;
+        margin-left: auto;
+        color: var(--accent);
+      }
+
+      .roast-option:hover,
+      .roast-option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-option:checked {
+        background: #efebe9;
+      }
+
+      .roast-option .roast-icon {
+        display: block;
+        flex: none;
+        width: 32px;
+        height: 32px;
+        color: var(--primary);
+      }
+
+      .roast-text {
+        display: flex;
+        flex-direction: column;
+        line-height: 1.3;
+      }
+
+      .roast-title {
+        font-weight: 600;
+      }
+
+      .roast-option .roast-desc {
+        display: block;
+        font-size: 0.8rem;
+        color: #6d4c41;
+      }
+
+      .roast-sep {
+        display: none;
+      }
+
+      /* Closed button shows icon + title only */
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent .roast-icon {
+        display: block;
+        width: 24px;
+        height: 24px;
+        color: var(--primary);
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+    }
