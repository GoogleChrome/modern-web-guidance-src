+  <script>
+    (function () {
+      const form = document.getElementById('subscribe-form');
+      const name = document.getElementById('sub-name');
+      const email = document.getElementById('sub-email');
+      const roast = document.getElementById('sub-roast');
+      const roastOut = document.getElementById('sub-roast-output');
+      const progress = document.getElementById('sub-progress');
+      const progressText = document.getElementById('sub-progress-text');
+      const progressStatus = document.getElementById('sub-progress-status');
+      const status = document.getElementById('sub-status');
+      const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastChosen = false;
+
+      function updateRoast() {
+        const label = roastLabels[roast.value - 1];
+        roastOut.value = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      // The email opt-in is optional and intentionally not counted toward completion.
+      function updateProgress() {
+        const steps = [
+          name.value.trim() !== '',
+          email.value.trim() !== '' && email.validity.valid,
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastChosen
+        ];
+        const done = steps.filter(Boolean).length;
+        const pct = Math.round((done / steps.length) * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progressText.textContent = pct + '%';
+        progressStatus.textContent = done + ' of ' + steps.length + ' steps complete';
+        return done === steps.length;
+      }
+
+      roast.addEventListener('input', function () {
+        roastChosen = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!updateProgress()) {
+          status.textContent = 'Please complete all steps — name, a valid email, delivery frequency, and roast preference.';
+          return;
+        }
+        status.textContent = 'Thanks, ' + name.value.trim() + '! Your ' +
+          roastOut.value.toLowerCase() + ' roast subscription is all set.';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
