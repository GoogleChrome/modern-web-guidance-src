+  <script type="module">
+    // Fills gaps for getClientCapabilities / parseRequestOptionsFromJSON / toJSON in older engines.
+    import 'https://esm.sh/webauthn-polyfills';
+
+    const OPTIONS_URL = '/api/login/options';
+    const VERIFY_URL = '/api/login/verify';
+
+    const button = document.getElementById('passkey-button');
+    const statusEl = document.getElementById('auth-status');
+
+    let autofillAbortController = new AbortController();
+    let rpId;
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function fetchLoginOptions() {
+      const res = await fetch(OPTIONS_URL, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+      });
+      if (!res.ok) throw new Error(`Failed to load sign-in options (${res.status})`);
+      const optionsJSON = await res.json();
+      rpId = optionsJSON.rpId ?? location.hostname;
+      return PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+    }
+
+    async function verifyCredential(credential) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch(VERIFY_URL, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Network error while signing in. Please try again.', 'error');
+        return false;
+      }
+
+      if (res.ok) {
+        let name = '';
+        try { name = (await res.json())?.username ?? ''; } catch { /* body optional */ }
+        setStatus(name ? `Signed in as ${name}.` : 'Signed in successfully.', 'success');
+        return true;
+      }
+
+      if (res.status === 404) {
+        setStatus('This passkey is no longer registered. Please use another sign-in method.', 'error');
+        // Pre-authentication path: tell the passkey provider to hide this stale credential.
+        if (PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: encoded.id });
+          } catch (err) {
+            console.warn('signalUnknownCredential failed:', err);
+          }
+        }
+      } else {
+        setStatus('Sign-in failed. Please try again.', 'error');
+      }
+      return false;
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential) return;
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+      if (capabilities.conditionalGet !== true) return;
+
+      try {
+        const publicKey = await fetchLoginOptions();
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+        await verifyCredential(credential);
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      // Cancel the pending autofill request so the two prompts don't collide.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      let credential;
+      try {
+        const publicKey = await fetchLoginOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.');
+        } else if (err.name !== 'AbortError') {
+          console.error('Passkey sign-in error:', err);
+          setStatus('Could not sign in with a passkey.', 'error');
+        }
+        button.disabled = false;
+        // Re-arm autofill suggestions after a cancelled/failed explicit prompt.
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const ok = await verifyCredential(credential);
+      button.disabled = false;
+      if (!ok) initializeConditionalAutofill();
+    }
+
+    button.addEventListener('click', triggerButtonAuthentication);
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
