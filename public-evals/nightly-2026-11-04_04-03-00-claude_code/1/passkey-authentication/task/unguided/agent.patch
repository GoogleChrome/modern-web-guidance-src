+  <script>
+    (() => {
+      const OPTIONS_URL = '/api/login/options';
+      const VERIFY_URL = '/api/login/verify';
+
+      const usernameField = document.getElementById('username');
+      const authButton = document.getElementById('passkey-button');
+      const statusEl = document.getElementById('auth-status');
+
+      let conditionalController = null;
+      let authenticated = false;
+
+      function setStatus(message, type = '') {
+        statusEl.textContent = message;
+        statusEl.className = 'auth-status' + (type ? ' ' + type : '');
+      }
+
+      // ---- base64url helpers ----
+      function bufferToBase64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let str = '';
+        for (const b of bytes) str += String.fromCharCode(b);
+        return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function base64urlToBuffer(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const str = atob(padded);
+        const bytes = new Uint8Array(str.length);
+        for (let i = 0; i < str.length; i++) bytes[i] = str.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function parseRequestOptions(json) {
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        const options = { ...json, challenge: base64urlToBuffer(json.challenge) };
+        if (Array.isArray(json.allowCredentials)) {
+          options.allowCredentials = json.allowCredentials.map((c) => ({
+            ...c,
+            id: base64urlToBuffer(c.id),
+          }));
+        }
+        return options;
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const r = credential.response;
+        return {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults: credential.getClientExtensionResults
+            ? credential.getClientExtensionResults()
+            : {},
+          response: {
+            clientDataJSON: bufferToBase64url(r.clientDataJSON),
+            authenticatorData: bufferToBase64url(r.authenticatorData),
+            signature: bufferToBase64url(r.signature),
+            userHandle: r.userHandle ? bufferToBase64url(r.userHandle) : null,
+          },
+        };
+      }
+
+      // ---- server calls ----
+      async function fetchRequestOptions() {
+        const res = await fetch(OPTIONS_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({}),
+        });
+        if (!res.ok) throw new Error('Could not start passkey sign-in.');
+        const json = await res.json();
+        // Accept either the options object directly or wrapped as { publicKey: {...} }.
+        return parseRequestOptions(json.publicKey || json);
+      }
+
+      async function verifyCredential(credential) {
+        const res = await fetch(VERIFY_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(credentialToJSON(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body */ }
+        if (!res.ok || data.verified === false || data.success === false) {
+          throw new Error(data.error || data.message || 'Passkey verification failed.');
+        }
+        return data;
+      }
+
+      function onSignedIn(data) {
+        authenticated = true;
+        const name = data.username || data.user?.name || data.user?.username || '';
+        setStatus(name ? `Signed in as ${name}` : 'Signed in successfully', 'success');
+        authButton.disabled = true;
+        usernameField.disabled = true;
+      }
+
+      // ---- conditional UI (autofill) ----
+      async function startConditionalUI() {
+        if (authenticated || conditionalController) return;
+        if (!window.PublicKeyCredential ||
+            typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+        if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+        if (authenticated || conditionalController) return;
+
+        const controller = new AbortController();
+        conditionalController = controller;
+        try {
+          const publicKey = await fetchRequestOptions();
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: 'conditional',
+            signal: controller.signal,
+          });
+          if (!credential) return;
+          setStatus('Verifying passkey…');
+          onSignedIn(await verifyCredential(credential));
+        } catch (err) {
+          // AbortError is expected when the explicit button takes over.
+          if (err.name !== 'AbortError' && !controller.signal.aborted) {
+            console.warn('Passkey autofill failed:', err);
+            if (err.name !== 'NotAllowedError') setStatus(err.message, 'error');
+          }
+        } finally {
+          if (conditionalController === controller) conditionalController = null;
+        }
+      }
+
+      function abortConditionalUI() {
+        if (conditionalController) {
+          conditionalController.abort();
+          conditionalController = null;
+        }
+      }
+
+      // ---- explicit button (modal biometric prompt) ----
+      async function signInWithPasskey() {
+        if (!window.PublicKeyCredential || !navigator.credentials) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+        // Only one WebAuthn request may be pending; cancel the autofill one first.
+        abortConditionalUI();
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+        try {
+          const publicKey = await fetchRequestOptions();
+          publicKey.userVerification = 'required';
+          const credential = await navigator.credentials.get({ publicKey });
+          if (!credential) throw new Error('No passkey was selected.');
+          setStatus('Verifying passkey…');
+          onSignedIn(await verifyCredential(credential));
+        } catch (err) {
+          if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+            setStatus('Passkey sign-in was cancelled.', 'error');
+          } else {
+            setStatus(err.message || 'Passkey sign-in failed.', 'error');
+          }
+        } finally {
+          if (!authenticated) {
+            authButton.disabled = false;
+            startConditionalUI();
+          }
+        }
+      }
+
+      authButton.addEventListener('click', signInWithPasskey);
+      document.getElementById('signin-form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        signInWithPasskey();
+      });
+      // Conditional request should be pending before the field is focused so
+      // the browser can offer passkeys in the autofill dropdown; re-arm on focus
+      // in case a previous request ended.
+      usernameField.addEventListener('focus', startConditionalUI);
+      startConditionalUI();
+    })();
+  </script>
+
 </body>
 
