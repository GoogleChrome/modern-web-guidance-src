+        }
+        tpl.remove();
+      }
+
+      document.addEventListener('DOMContentLoaded', function () {
+        document.querySelectorAll('template[for]').forEach(applyTemplatePatch);
+        var grid = document.getElementById('seasonal-grid');
+        if (grid && !grid.querySelector('.placeholder')) grid.removeAttribute('aria-busy');
+      });
+
+      // ---------- Section wiring ----------
+      var controllers = {};
+
+      function load(key, url, onResponse) {
+        if (!url) return Promise.resolve();
+        if (controllers[key]) controllers[key].abort(); // newest menu update wins
+        var ctrl = controllers[key] = new AbortController();
+        return fetch(url, {
