+          return writeResponseSanitized(grid, res, CARD_CONFIG);
+        }).finally(function () { grid.removeAttribute('aria-busy'); });
+      }
+
+      function refreshReviews() {
+        var section = document.getElementById('seasonal');
+        var box = document.getElementById('seasonal-reviews');
+        return load('reviews', section.dataset.reviewsSrc, function (res) {
+          // Untrusted: buffered + strict sanitizer, never setHTMLUnsafe/innerHTML.
+          return res.text().then(function (html) { setSanitizedHTML(box, html, REVIEW_CONFIG); });
+        });
+      }
+
+      function refreshPromo() {
+        var section = document.getElementById('seasonal');
+        var box = document.getElementById('seasonal-promo');
+        var allowedOrigins = new Set(
+          (section.dataset.promoScriptOrigins || '').split(/\s+/).filter(Boolean)
+        );
+
+        return load('promo', section.dataset.promoSrc, function (res) {
+          return res.text().then(function (html) {
+            // Parse inertly; scripts inserted by setHTMLUnsafe/innerHTML never execute.
+            var tpl = document.createElement('template');
+            if (typeof tpl.setHTMLUnsafe === 'function') tpl.setHTMLUnsafe(html);
+            else tpl.innerHTML = html;
+            var frag = tpl.content;
+
+            // Strip inline event handlers and javascript: URLs even from first-party content.
+            frag.querySelectorAll('*').forEach(function (el) {
+              Array.from(el.attributes).forEach(function (a) {
+                var n = a.name.toLowerCase();
+                if (n.startsWith('on') ||
+                    ((n === 'href' || n === 'src' || n === 'action' || n === 'formaction') &&
+                      /^\s*javascript:/i.test(a.value))) {
+                  el.removeAttribute(a.name);
+                }
+              });
+            });
+
+            // Collect the widget scripts we are willing to run, then remove all scripts.
+            var toRun = [];
+            frag.querySelectorAll('script').forEach(function (s) {
+              var src = s.getAttribute('src');
+              if (src) {
+                try {
+                  var url = new URL(src, document.baseURI);
+                  if (url.protocol === 'https:' && allowedOrigins.has(url.origin)) {
+                    toRun.push({ src: url.href, type: s.type, integrity: s.integrity });
+                  } else {
+                    console.warn('[seasonal] blocked promo script from', url.origin);
+                  }
+                } catch (e) { /* invalid URL: drop */ }
+              } else {
+                console.warn('[seasonal] blocked inline promo script');
+              }
+              s.remove();
+            });
+
+            box.replaceChildren(frag);
+
+            toRun.forEach(function (info) {
+              var s = document.createElement('script');
+              s.src = info.src;
+              s.async = true;
+              if (info.type === 'module') s.type = 'module';
+              if (info.integrity) s.integrity = info.integrity;
+              s.crossOrigin = 'anonymous';
+              s.referrerPolicy = 'strict-origin-when-cross-origin';
+              box.appendChild(s);
+            });
+          });
+        });
+      }
+
+      function refreshAll() {
+        return Promise.all([refreshCards(), refreshReviews(), refreshPromo()]);
+      }
+
+      function listenForMenuChanges() {
+        var url = document.getElementById('seasonal').dataset.menuEventsSrc;
+        if (!url || typeof EventSource !== 'function') return;
+        var es = new EventSource(url);
+        es.addEventListener('menu-updated', function () {
+          refreshCards();
+          refreshReviews();
+        });
+        es.addEventListener('promo-updated', refreshPromo);
+        es.onerror = function () {
+          if (es.readyState === EventSource.CLOSED) console.warn('[seasonal] menu event stream closed');
+        };
+      }
+
+      window.addEventListener('load', function () {
+        // Cards already arrived via the streamed template; fetch the rest.
+        refreshReviews();
+        refreshPromo();
+        listenForMenuChanges();
+      });
+
+      window.DailyGrind = Object.freeze({
+        applyTemplatePatch: applyTemplatePatch,
+        refreshCards: refreshCards,
+        refreshReviews: refreshReviews,
+        refreshPromo: refreshPromo,
+        refreshAll: refreshAll
+      });
+    })();
+  </script>
