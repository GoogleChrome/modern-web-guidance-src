+  <script>
+    /*
+     * Seasonal Favorites: in-place updates using native browser HTML APIs.
+     *
+     *  - Out-of-order streaming: <template for="ID"> later in the document
+     *    replaces the children of #ID. Browsers that implement declarative
+     *    partial updates consume the template natively; otherwise the small
+     *    shim below applies it as soon as the template has been parsed.
+     *  - Refreshing cards: Element.streamHTML() / Element.setHTML() (Sanitizer
+     *    API) with an allow-list, falling back to an inert <template>-based
+     *    allow-list sanitizer in browsers without the Sanitizer API.
+     *  - Reviews are untrusted user content: always sanitized with a very strict
+     *    allow-list (no links, images, attributes or scripts).
+     *  - The CMS promo is first-party: parsed with setHTMLUnsafe (which never
+     *    runs scripts), then ONLY external <script src> elements whose origin is
+     *    on the allow-list are re-created so the CMS widget can boot. Inline
+     *    scripts, event-handler attributes and javascript: URLs are dropped.
+     */
+    (function () {
+      'use strict';
+
+      // ---------- Sanitizer configs ----------
+      var CARD_CONFIG = {
+        elements: ['div', 'article', 'h3', 'h4', 'p', 'span', 'strong', 'em', 'b', 'i', 'br', 'ul', 'li', 'a', 'img'],
+        attributes: ['class', 'href', 'src', 'alt', 'width', 'height', 'loading', 'title'],
+        comments: false,
+        dataAttributes: false
+      };
+
+      var REVIEW_CONFIG = {
+        elements: ['div', 'article', 'blockquote', 'p', 'cite', 'footer', 'span', 'strong', 'em', 'b', 'i', 'br'],
+        attributes: [],
+        comments: false,
+        dataAttributes: false
+      };
+
+      var hasNativeSanitizer = typeof Element.prototype.setHTML === 'function';
+
+      // ---------- Fallback allow-list sanitizer (no Sanitizer API) ----------
+      function isSafeUrl(value, attr) {
+        try {
+          var url = new URL(value, document.baseURI);
+          if (url.protocol === 'https:' || url.protocol === 'http:') return true;
+          return attr === 'href' && url.protocol === 'mailto:';
+        } catch (e) {
+          return false;
+        }
+      }
+
+      function fallbackSanitize(html, config) {
+        // <template> content is inert: no scripts run, no resources load.
+        var tpl = document.createElement('template');
+        tpl.innerHTML = html;
+        var allowedEls = new Set(config.elements);
+        var allowedAttrs = new Set(config.attributes);
+
+        (function walk(node) {
+          var child = node.firstChild;
+          while (child) {
+            var next = child.nextSibling;
+            if (child.nodeType === Node.ELEMENT_NODE) {
+              var name = child.localName;
+              if (!allowedEls.has(name) || child.namespaceURI !== 'http://www.w3.org/1999/xhtml') {
+                child.remove(); // drop element and its subtree (script, style, iframe, svg, ...)
+              } else {
+                Array.from(child.attributes).forEach(function (a) {
+                  var n = a.name.toLowerCase();
+                  if (!allowedAttrs.has(n) ||
+                      ((n === 'href' || n === 'src') && !isSafeUrl(a.value, n))) {
+                    child.removeAttribute(a.name);
+                  }
+                });
+                if (name === 'a' && child.hasAttribute('href')) child.setAttribute('rel', 'noopener noreferrer');
+                walk(child);
+              }
+            } else if (child.nodeType !== Node.TEXT_NODE) {
+              child.remove(); // comments, processing instructions, etc.
+            }
+            child = next;
+          }
+        })(tpl.content);
