+        // If the browser handled the template natively it is never left in the DOM.
+        if (!tpl || !tpl.isConnected || tpl.localName !== 'template') return;
+        var id = tpl.getAttribute('for');
+        var target = id && PATCHABLE.has(id) ? document.getElementById(id) : null;
+        if (target) {
