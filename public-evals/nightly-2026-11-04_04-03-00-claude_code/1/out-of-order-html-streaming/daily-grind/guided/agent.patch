+  <!-- Real cards, streamed later in the same HTML response (e.g. once the menu
+       service responds). Replaces the <?start name="seasonal-cards"> range above. -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script type="module">
+    // Server endpoints returning HTML fragments.
+    const ENDPOINTS = {
+      cards: '/partials/seasonal-cards',     // our own menu markup, no scripts
+      reviews: '/partials/seasonal-reviews', // customer-submitted content: UNTRUSTED
+      promo: '/cms/promos/seasonal',         // our CMS, ships its own widget <script>
+      menuEvents: '/api/menu/events',        // Server-Sent Events: "menu-updated"
+    };
+
+    // Allowlists for the safe (sanitizing) setters. Elements not listed are
+    // removed together with their content; script/on* handlers are always stripped.
+    const CARD_SANITIZER = {
+      elements: ['div', 'h3', 'p', 'a', 'img', 'span', 'strong', 'em'],
+      attributes: ['class', 'href', 'src', 'alt', 'width', 'height', 'loading'],
+    };
+    const REVIEW_SANITIZER = {
+      elements: ['article', 'blockquote', 'p', 'footer', 'cite', 'strong', 'em', 'b', 'i', 'br'],
+      attributes: ['class'],
+    };
+
+    const cardsEl = document.getElementById('seasonal-cards');
+    const reviewsEl = document.getElementById('seasonal-reviews');
+    const promoEl = document.getElementById('seasonal-promo');
+
+    // HTML setters (streamHTML, streamHTMLUnsafe, ...) aren't shipped natively yet.
+    if (!('streamHTMLUnsafe' in Element.prototype)) {
+      await import('https://unpkg.com/html-setters-polyfill@0.1.1/index.min.js');
+    }
+
+    let domPurifyPromise;
+    const loadDOMPurify = () =>
+      (domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.6/+esm')
+        .then((mod) => mod.default ?? mod));
+
+    async function fetchHTML(url, signal) {
+      const res = await fetch(url, { signal, headers: { Accept: 'text/html' } });
+      if (!res.ok) throw new Error(`${url} responded ${res.status}`);
+      return res;
+    }
+
+    // Sanitizing insert for anything that must never run script.
+    async function safeStreamInto(el, url, sanitizer, signal) {
+      const res = await fetchHTML(url, signal);
+      if ('streamHTML' in Element.prototype) {
+        await res.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(el.streamHTML({ sanitizer }), { signal });
+      } else {
+        // No native Sanitizer API (e.g. Safari): sanitize with DOMPurify instead.
+        const [html, DOMPurify] = await Promise.all([res.text(), loadDOMPurify()]);
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...sanitizer.elements, '#text'],
+          ALLOWED_ATTR: sanitizer.attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+        });
+      }
+    }
+
+    // Trusted, script-executing insert. ONLY for first-party CMS markup —
+    // never route user-generated content through here.
+    async function trustedStreamInto(el, url, signal) {
+      const res = await fetchHTML(url, signal);
+      await res.body
+        .pipeThrough(new TextDecoderStream())
+        .pipeTo(el.streamHTMLUnsafe({ runScripts: true }), { signal });
+    }
+
+    async function update(el, task) {
+      el.setAttribute('aria-busy', 'true');
+      try {
+        await task();
+      } catch (err) {
+        if (err.name !== 'AbortError') console.error(err);
+      } finally {
+        el.removeAttribute('aria-busy');
+      }
+    }
+
+    let controller;
+    function refresh({ cards = true } = {}) {
+      controller?.abort(); // drop any in-flight refresh superseded by a newer one
+      controller = new AbortController();
+      const { signal } = controller;
+      return Promise.all([
+        cards && update(cardsEl, () => safeStreamInto(cardsEl, ENDPOINTS.cards, CARD_SANITIZER, signal)),
+        update(reviewsEl, () => safeStreamInto(reviewsEl, ENDPOINTS.reviews, REVIEW_SANITIZER, signal)),
+        update(promoEl, () => trustedStreamInto(promoEl, ENDPOINTS.promo, signal)),
+      ]);
+    }
+
+    // Initial load: cards arrive declaratively via <template for>; fetch the rest.
+    refresh({ cards: false });
+
+    // Pull fresh card HTML whenever the server reports a menu change.
+    const menuEvents = new EventSource(ENDPOINTS.menuEvents);
+    menuEvents.addEventListener('menu-updated', () => refresh());
+  </script>
+
