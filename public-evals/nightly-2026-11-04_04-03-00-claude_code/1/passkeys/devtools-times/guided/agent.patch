--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,528 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  canCreatePasskeys,
+  postJson,
+  readError,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+} from '../lib/passkeys-client';
+import { PasskeyIcon } from './SignInForm';
+
+interface Passkey {
+  id: string;
+  name: string;
+  providerName: string;
+  providerIcon?: string;
+  synced: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface Account {
+  rpId: string;
+  user: { id: string; username: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+type Notice = { kind: 'success' | 'error'; text: string } | null;
+
+const BASE = import.meta.env.BASE_URL;
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+const formatDate = (epoch?: number) => (epoch ? dateFormat.format(new Date(epoch)) : 'Never');
+
+const isReauthRequired = async (response: Response) =>
+  response.status === 403 && (await response.clone().json().catch(() => ({}))).code === 'REAUTH_REQUIRED';
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const reauth = useReauthDialog(account);
+
+  /** Apply a fresh server snapshot and keep password managers in sync with it. */
+  const applyAccount = useCallback(async (next: Account, syncCredentials = false) => {
+    setAccount(next);
+    if (syncCredentials) {
+      await signalAllAcceptedCredentials(next.rpId, next.user.id, next.passkeys.map((p) => p.id));
+    }
+  }, []);
+
+  useEffect(() => {
+    canCreatePasskeys().then(setCanCreate);
+    fetch(`${BASE}api/auth/account`)
+      .then(async (response) => {
+        if (response.status === 401) {
+          window.location.assign(`${BASE}signin`);
+          return;
+        }
+        if (!response.ok) throw new Error();
+        // Sync the accepted credential list on load so deleted passkeys disappear from autofill.
+        await applyAccount(await response.json(), true);
+      })
+      .catch(() => setLoadError('We couldn’t load your account. Please refresh the page.'));
+  }, [applyAccount]);
+
+  /** Run a sensitive request; if the server asks for step-up verification, reauthenticate and retry once. */
+  const withReauth = async (reason: string, request: () => Promise<Response>) => {
+    let response = await request();
+    if (await isReauthRequired(response)) {
+      if (!(await reauth.request(reason))) return null;
+      response = await request();
+    }
+    return response;
+  };
+
+  const handleCreatePasskey = async () => {
+    setNotice(null);
+    setCreating(true);
+    try {
+      let result = await registerPasskey('manage');
+      if (result.status === 'reauth-required') {
+        if (!(await reauth.request('Confirm it’s you before adding a new passkey.'))) return;
+        result = await registerPasskey('manage');
+      }
+      if (result.status === 'success') {
+        await applyAccount(result.data);
+        setNotice({ kind: 'success', text: 'Passkey created.' });
+      } else if (result.status === 'error') {
+        setNotice({ kind: 'error', text: result.message });
+      }
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const handleRename = async (passkey: Passkey, name: string) => {
+    const response = await postJson(`passkeys/${encodeURIComponent(passkey.id)}`, { name }, 'PATCH');
+    if (!response.ok) {
+      setNotice({ kind: 'error', text: (await readError(response, 'Could not rename passkey.')).message });
+      return false;
+    }
+    await applyAccount(await response.json());
+    setNotice({ kind: 'success', text: 'Passkey renamed.' });
+    return true;
+  };
+
+  const handleDelete = async (passkey: Passkey) => {
+    setNotice(null);
+    const response = await withReauth(`Confirm it’s you to delete “${passkey.name}”.`, () =>
+      postJson(`passkeys/${encodeURIComponent(passkey.id)}`, undefined, 'DELETE'),
+    );
+    if (!response) return;
+    if (!response.ok) {
+      setNotice({ kind: 'error', text: (await readError(response, 'Could not delete passkey.')).message });
+      return;
+    }
+    // Tell the password manager which passkeys remain valid.
+    await applyAccount(await response.json(), true);
+    setNotice({
+      kind: 'success',
+      text: `“${passkey.name}” was removed. You may also want to delete it from your password manager.`,
+    });
+  };
+
+  const handleDisplayName = async (displayName: string) => {
+    setNotice(null);
+    const response = await withReauth('Confirm it’s you to change your display name.', () =>
+      postJson('account', { displayName }, 'PATCH'),
+    );
+    if (!response) return false;
+    if (!response.ok) {
+      setNotice({ kind: 'error', text: (await readError(response, 'Could not update your profile.')).message });
+      return false;
+    }
+    const next: Account = await response.json();
+    await applyAccount(next);
+    // Update the name shown in passkey account pickers.
+    await signalCurrentUserDetails(next.rpId, next.user.id, next.user.username, next.user.displayName);
+    setNotice({ kind: 'success', text: 'Display name updated.' });
+    return true;
+  };
+
+  const handleSignOut = async () => {
+    await postJson('logout');
+    window.location.assign(BASE);
+  };
+
+  if (loadError) {
+    return (
+      <p className="max-w-2xl mx-auto mt-10 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+        {loadError}
+      </p>
+    );
+  }
+  if (!account) {
+    return <p className="max-w-2xl mx-auto mt-10 text-center text-gray-500" role="status">Loading your account…</p>;
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-center justify-between gap-4">
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="text-sm font-medium text-gray-700 underline hover:text-gray-900"
+        >
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {notice && (
+          <p
+            className={`p-3 text-sm rounded-lg ${
+              notice.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+          >
+            {notice.text}
+          </p>
+        )}
+      </div>
+
+      <ProfileSection account={account} onSave={handleDisplayName} />
+
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">Passkeys</h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Sign in with your fingerprint, face, screen lock or security key instead of a password.
+            </p>
+          </div>
+          {canCreate && (
+            <button
+              type="button"
+              onClick={handleCreatePasskey}
+              disabled={creating}
+              className="flex items-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+            >
+              <PasskeyIcon />
+              {creating ? 'Waiting for passkey…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!canCreate && (
+          <p className="mb-4 p-3 text-sm text-gray-700 bg-gray-100 rounded-lg">
+            This browser or device can’t create passkeys. Keep using a strong, unique password, or add a passkey
+            from a supported device.
+          </p>
+        )}
+
+        {account.passkeys.length === 0 ? (
+          <p className="text-sm text-gray-500 py-6 text-center border border-dashed border-gray-300 rounded-md">
+            No passkeys found.
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {account.passkeys.map((passkey) => (
+              <PasskeyRow key={passkey.id} passkey={passkey} onRename={handleRename} onDelete={handleDelete} />
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {reauth.dialog}
+    </div>
+  );
+}
+
+function ProfileSection({ account, onSave }: { account: Account; onSave: (displayName: string) => Promise<boolean> }) {
+  const [editing, setEditing] = useState(false);
+  const [value, setValue] = useState(account.user.displayName);
+  const [saving, setSaving] = useState(false);
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSaving(true);
+    const ok = await onSave(value);
+    setSaving(false);
+    if (ok) setEditing(false);
+  };
+
+  return (
+    <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 id="profile-heading" className="text-xl font-bold text-gray-800 mb-4">Profile</h2>
+      <dl className="space-y-4 text-sm">
+        <div>
+          <dt className="font-medium text-gray-700">Username</dt>
+          <dd className="text-gray-900">{account.user.username}</dd>
+        </div>
+        <div>
+          <dt className="font-medium text-gray-700">Display name</dt>
+          <dd>
+            {editing ? (
+              <form onSubmit={submit} className="flex flex-wrap gap-2 mt-1">
+                <label htmlFor="display-name" className="sr-only">Display name</label>
+                <input
+                  id="display-name"
+                  value={value}
+                  onChange={(e) => setValue(e.target.value)}
+                  autoComplete="name"
+                  maxLength={64}
+                  required
+                  autoFocus
+                  className="flex-1 min-w-0 px-3 py-1.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                />
+                <button type="submit" disabled={saving} className="px-3 py-1.5 rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75">
+                  {saving ? 'Saving…' : 'Save'}
+                </button>
+                <button
+                  type="button"
+                  onClick={() => {
+                    setValue(account.user.displayName);
+                    setEditing(false);
+                  }}
+                  className="px-3 py-1.5 rounded-md text-gray-700 hover:bg-gray-100"
+                >
+                  Cancel
+                </button>
+              </form>
+            ) : (
+              <div className="flex items-center gap-3">
+                <span className="text-gray-900">{account.user.displayName}</span>
+                <button type="button" onClick={() => setEditing(true)} className="text-gray-700 underline hover:text-gray-900">
+                  Edit
+                </button>
+              </div>
+            )}
+          </dd>
+        </div>
+      </dl>
+    </section>
+  );
+}
+
+function PasskeyRow({
+  passkey,
+  onRename,
+  onDelete,
+}: {
+  passkey: Passkey;
+  onRename: (p: Passkey, name: string) => Promise<boolean>;
+  onDelete: (p: Passkey) => Promise<void>;
+}) {
+  const [mode, setMode] = useState<'view' | 'rename' | 'confirm-delete'>('view');
+  const [name, setName] = useState(passkey.name);
+  const [busy, setBusy] = useState(false);
+  const inputId = `rename-${passkey.id}`;
+
+  const submitRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setBusy(true);
+    if (await onRename(passkey, name)) setMode('view');
+    setBusy(false);
+  };
+
+  const confirmDelete = async () => {
+    setBusy(true);
+    await onDelete(passkey);
+    setBusy(false);
+    setMode('view');
+  };
+
+  return (
+    <li className="flex flex-wrap items-center gap-4 p-4">
+      {passkey.providerIcon ? (
+        <img src={passkey.providerIcon} alt="" width={32} height={32} className="h-8 w-8 rounded" />
+      ) : (
+        <span className="flex h-8 w-8 items-center justify-center rounded bg-gray-100 text-gray-600">
+          <PasskeyIcon />
+        </span>
+      )}
+
+      <div className="flex-1 min-w-48">
+        {mode === 'rename' ? (
+          <form onSubmit={submitRename} className="flex flex-wrap gap-2">
+            <label htmlFor={inputId} className="sr-only">Passkey name</label>
+            <input
+              id={inputId}
+              value={name}
+              onChange={(e) => setName(e.target.value)}
+              maxLength={64}
+              required
+              autoFocus
+              autoComplete="off"
+              className="flex-1 min-w-0 px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button type="submit" disabled={busy} className="px-3 py-1 text-sm rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75">
+              Save
+            </button>
+            <button
+              type="button"
+              onClick={() => {
+                setName(passkey.name);
+                setMode('view');
+              }}
+              className="px-3 py-1 text-sm rounded-md text-gray-700 hover:bg-gray-100"
+            >
+              Cancel
+            </button>
+          </form>
+        ) : (
+          <p className="font-medium text-gray-900">
+            {passkey.name}
+            {passkey.synced && (
+              <span className="ml-2 align-middle text-xs font-normal px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">Synced</span>
+            )}
+          </p>
+        )}
+        <p className="text-xs text-gray-500 mt-1">
+          {passkey.name !== passkey.providerName && <>{passkey.providerName} · </>}
+          Created {formatDate(passkey.registeredAt)} · Last used {formatDate(passkey.lastUsedAt)}
+        </p>
+      </div>
+
+      {mode === 'view' && (
+        <div className="flex gap-2">
+          <button type="button" onClick={() => setMode('rename')} className="px-3 py-1 text-sm rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50">
+            Rename<span className="sr-only"> {passkey.name}</span>
+          </button>
+          <button type="button" onClick={() => setMode('confirm-delete')} className="px-3 py-1 text-sm rounded-md border border-red-200 text-red-700 hover:bg-red-50">
+            Delete<span className="sr-only"> {passkey.name}</span>
+          </button>
+        </div>
+      )}
+
+      {mode === 'confirm-delete' && (
+        <div className="flex flex-wrap items-center gap-2 text-sm" role="group" aria-label={`Delete ${passkey.name}?`}>
+          <span className="text-gray-700">Delete this passkey?</span>
+          <button type="button" onClick={confirmDelete} disabled={busy} autoFocus className="px-3 py-1 rounded-md text-white bg-red-700 hover:bg-red-800 disabled:opacity-75">
+            {busy ? 'Deleting…' : 'Delete'}
+          </button>
+          <button type="button" onClick={() => setMode('view')} disabled={busy} className="px-3 py-1 rounded-md text-gray-700 hover:bg-gray-100">
+            Cancel
+          </button>
+        </div>
+      )}
+    </li>
+  );
+}
+
+/**
+ * Step-up verification modal. Prefers the user's own passkeys and falls back to the
+ * password for accounts that don't have one. `request()` resolves true once verified.
+ */
+function useReauthDialog(account: Account | null) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const resolver = useRef<((ok: boolean) => void) | null>(null);
+  const [reason, setReason] = useState('');
+  const [usePassword, setUsePassword] = useState(false);
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const hasPasskeys = (account?.passkeys.length ?? 0) > 0;
+
+  const settle = (ok: boolean) => {
+    resolver.current?.(ok);
+    resolver.current = null;
+    dialogRef.current?.close();
+  };
+
+  const request = (why: string) =>
+    new Promise<boolean>((resolve) => {
+      resolver.current?.(false);
+      resolver.current = resolve;
+      setReason(why);
+      setUsePassword(false);
+      setPassword('');
+      setError(null);
+      dialogRef.current?.showModal();
+    });
+
+  const verifyWithPasskey = async () => {
+    setError(null);
+    setBusy(true);
+    const result = await reauthenticateWithPasskey();
+    setBusy(false);
+    if (result.status === 'success') settle(true);
+    else if (result.status === 'error') setError(result.message);
+    else if (result.status === 'unsupported') setUsePassword(true);
+  };
+
+  const verifyWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setBusy(true);
+    const response = await postJson('reauth/password', { password });
+    setBusy(false);
+    if (response.ok) settle(true);
+    else setError((await readError(response, 'Verification failed.')).message);
+  };
+
+  const showPassword = usePassword || !hasPasskeys;
+
+  const dialog = (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby="reauth-title"
+      onClose={() => {
+        resolver.current?.(false);
+        resolver.current = null;
+      }}
+      className="m-auto w-full max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+    >
+      <h2 id="reauth-title" className="text-lg font-bold text-gray-900">Confirm it’s you</h2>
+      <p className="mt-1 mb-4 text-sm text-gray-600">{reason}</p>
+
+      {error && (
+        <p className="mb-4 p-2 text-sm text-red-700 bg-red-100 rounded" role="alert">
+          {error}
+        </p>
+      )}
+
+      {showPassword ? (
+        <form onSubmit={verifyWithPassword} className="space-y-3">
+          {/* Hidden username helps password managers pick the right saved password. */}
+          <input type="text" name="username" autoComplete="username" value={account?.user.username ?? ''} readOnly hidden />
+          <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">Password</label>
+          <input
+            id="reauth-password"
+            type="password"
+            autoComplete="current-password"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            required
+            autoFocus
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          <button type="submit" disabled={busy} className="w-full py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75">
+            {busy ? 'Verifying…' : 'Continue'}
+          </button>
+          {hasPasskeys && (
+            <button type="button" onClick={() => setUsePassword(false)} className="w-full text-sm text-gray-700 underline">
+              Use a passkey instead
+            </button>
+          )}
+        </form>
+      ) : (
+        <div className="space-y-3">
+          <button
+            type="button"
+            onClick={verifyWithPasskey}
+            disabled={busy}
+            autoFocus
+            className="w-full flex items-center justify-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+          >
+            <PasskeyIcon />
+            {busy ? 'Waiting for passkey…' : 'Verify with passkey'}
+          </button>
+          <button type="button" onClick={() => setUsePassword(true)} className="w-full text-sm text-gray-700 underline">
+            Use your password instead
+          </button>
+        </div>
+      )}
+
+      <button type="button" onClick={() => settle(false)} className="mt-4 w-full py-2 text-sm text-gray-600 rounded-md hover:bg-gray-100">
+        Cancel
+      </button>
+    </dialog>
+  );
+
+  return { request, dialog };
+}
