@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findCredentialById, findUserById, saveCredential } from '../../../../lib/auth/store';
+import {
+  consumeChallenge,
+  errorResponse,
+  getRelyingParty,
+  getSessionUser,
+  json,
+  markVerified,
+  readJson,
+  signIn,
+} from '../../../../lib/auth/server';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const pending = await consumeChallenge(session, ['authentication', 'reauthentication']);
+  if (!pending) return errorResponse(400, 'CHALLENGE_EXPIRED', 'The passkey request expired. Please try again.');
+
+  const body = (await readJson<AuthenticationResponseJSON>(request)) as AuthenticationResponseJSON;
+  if (!body.id) return errorResponse(400, 'BAD_REQUEST', 'Missing credential.');
+
+  const stored = await findCredentialById(body.id);
+  // Explicit 404 lets the client tell the passkey provider this credential is gone.
+  if (!stored) return errorResponse(404, 'UNKNOWN_CREDENTIAL', 'This passkey is no longer registered with The DevTools Times.');
+
+  if (body.response?.userHandle && body.response.userHandle !== stored.passkeyUserId) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify that passkey.');
+  }
+
+  if (pending.kind === 'reauthentication') {
+    const current = await getSessionUser(session);
+    // Reject a valid passkey that belongs to a *different* account.
+    if (!current || current.id !== pending.userId || stored.passkeyUserId !== current.id) {
+      return errorResponse(403, 'WRONG_ACCOUNT', 'That passkey belongs to a different account.');
+    }
+  }
+
+  const { rpID, origins } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: stored.id,
+        publicKey: isoBase64URL.toBuffer(stored.credentialPublicKey),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    console.warn('Passkey authentication verification failed:', err);
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify that passkey.');
+  }
+  if (!verification.verified) return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify that passkey.');
+
+  const { newCounter, credentialBackedUp, credentialDeviceType } = verification.authenticationInfo;
+  await saveCredential({ ...stored, counter: newCounter, credentialBackedUp, credentialDeviceType, lastUsedAt: Date.now() });
+
+  const user = await findUserById(stored.passkeyUserId);
+  if (!user) return errorResponse(404, 'UNKNOWN_CREDENTIAL', 'This passkey is no longer registered with The DevTools Times.');
+
+  if (pending.kind === 'reauthentication') markVerified(session);
+  else await signIn(session, user);
+
+  return json({ ok: true, user: { username: user.username, displayName: user.displayName } });
+};
diff --git a/src/pages/api/auth/passkeys/registration-options.ts b/src/pages/api/auth/passkeys/registration-options.ts
new file mode 100644
index 0000000..5200119
--- /dev/null
+++ b/src/pages/api/auth/passkeys/registration-options.ts
@@ -0,0 +1,60 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+import {
+  RP_NAME,
+  errorResponse,
+  getRelyingParty,
+  getSessionUser,
+  isRecentlyVerified,
+  json,
+  readJson,
+  reauthRequired,
+  storeChallenge,
+} from '../../../../lib/auth/server';
+
+/**
+ * mode:
+ *  - "promotion":   explicit offer right after sign-up → platform authenticator only
+ *  - "conditional": silent conditional create right after a password sign-in
+ *  - "manage":      account settings → any authenticator, including security keys
+ */
+type Mode = 'promotion' | 'conditional' | 'manage';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+  // Adding a sign-in method is sensitive: require a recent sign-in or reauthentication.
+  if (!(await isRecentlyVerified(session))) return reauthRequired();
+
+  const { mode = 'manage' } = await readJson<{ mode: Mode }>(request);
+  const { rpID } = getRelyingParty(url);
+  const existing = await findCredentialsByUserId(user.id);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: isoBase64URL.toBuffer(user.id),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    // Prevent registering a second passkey with the same provider.
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(mode === 'promotion' && { authenticatorAttachment: 'platform' as const }),
+    },
+  });
+
+  storeChallenge(session, {
+    kind: 'registration',
+    challenge: options.challenge,
+    userVerification: 'preferred',
+    conditional: mode === 'conditional',
+    userId: user.id,
+  });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/registration-verify.ts b/src/pages/api/auth/passkeys/registration-verify.ts
new file mode 100644
index 0000000..e40a2e7
--- /dev/null
+++ b/src/pages/api/auth/passkeys/registration-verify.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { lookupProvider } from '../../../../lib/auth/aaguid';
+import { findCredentialById, saveCredential } from '../../../../lib/auth/store';
+import {
+  accountSummary,
+  consumeChallenge,
+  errorResponse,
+  getRelyingParty,
+  getSessionUser,
+  json,
+  readJson,
+} from '../../../../lib/auth/server';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+
+  const pending = await consumeChallenge(session, 'registration');
+  if (!pending || pending.userId !== user.id) {
+    return errorResponse(400, 'CHALLENGE_EXPIRED', 'The passkey request expired. Please try again.');
+  }
+
+  const body = (await readJson<RegistrationResponseJSON>(request)) as RegistrationResponseJSON;
+  const { rpID, origins } = getRelyingParty(url);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Options requested userVerification "preferred", so don't fail authenticators without UV.
+      requireUserVerification: pending.userVerification === 'required',
+      // Conditional create happens without an explicit gesture, so UP may be false.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (err) {
+    console.warn('Passkey registration verification failed:', err);
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify that passkey.');
+  }
+  if (!verification.verified) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify that passkey.');
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await findCredentialById(credential.id)) {
+    return errorResponse(409, 'ALREADY_REGISTERED', 'This passkey is already registered.');
+  }
+
+  const provider = await lookupProvider(aaguid);
+  await saveCredential({
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerName: provider.name,
+    providerIcon: provider.icon,
+    name: provider.name,
+    transports: credential.transports ?? body.response?.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  });
+
+  return json(await accountSummary(url, user));
+};
