@@ -0,0 +1,21 @@
+import type { APIRoute } from 'astro';
+import { findOrCreateUser } from '../../../lib/auth/store';
+import { errorResponse, json, readJson, signIn, upstreamPasswordCall } from '../../../lib/auth/server';
+
+/** Password sign-in: verified by the upstream Times API, then a local session is created. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await readJson<{ username: string; password: string }>(request);
+  if (!username || !password) return errorResponse(400, 'BAD_REQUEST', 'Username and password are required.');
+
+  let upstream;
+  try {
+    upstream = await upstreamPasswordCall('login', username, password);
+  } catch {
+    return errorResponse(502, 'UPSTREAM_UNAVAILABLE', 'The sign-in service is unavailable. Please try again later.');
+  }
+  if (!upstream.ok) return json(upstream.data, upstream.status);
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user);
+  return json({ ...upstream.data, user: { username: user.username, displayName: user.displayName } });
+};
