@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { updateUser } from '../../../lib/auth/store';
+import {
+  accountSummary,
+  errorResponse,
+  getSessionUser,
+  isRecentlyVerified,
+  json,
+  readJson,
+  reauthRequired,
+} from '../../../lib/auth/server';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+  return json(await accountSummary(url, user));
+};
+
+/** Update the display name. Sensitive: requires a recent sign-in or reauthentication. */
+export const PATCH: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+  if (!(await isRecentlyVerified(session))) return reauthRequired();
+
+  const { displayName } = await readJson<{ displayName: string }>(request);
+  const value = typeof displayName === 'string' ? displayName.trim() : '';
+  if (!value || value.length > 64) {
+    return errorResponse(400, 'BAD_REQUEST', 'Display name must be between 1 and 64 characters.');
+  }
+  const updated = await updateUser(user.id, { displayName: value });
+  return json(await accountSummary(url, updated ?? user));
+};
