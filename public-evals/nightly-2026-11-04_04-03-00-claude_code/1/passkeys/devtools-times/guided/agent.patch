+++ b/src/lib/auth/store.ts
@@ -0,0 +1,137 @@
+/**
+ * Minimal file-backed persistence for local user profiles and passkey credentials.
+ *
+ * Password accounts live in the upstream Times API; this store only keeps the
+ * data needed for passkeys (a stable WebAuthn user handle, display name and the
+ * registered credentials). Swap this module for a real database in production.
+ */
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface StoredUser {
+  /** Base64URL-encoded WebAuthn user handle (never the username). */
+  id: string;
+  username: string;
+  displayName: string;
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID
+  credentialPublicKey: string; // Base64URL-encoded public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string; // UX hint only — never used for security decisions
+  providerIcon?: string;
+  providerName: string; // Provider name derived from the AAGUID registry
+  name: string; // User-facing nickname (defaults to the provider name)
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Database {
+  users: StoredUser[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const DB_PATH = path.resolve(process.env.AUTH_DB_PATH ?? '.data/auth-db.json');
+
+let cache: Database | null = null;
+let writeQueue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DB_PATH, 'utf8')) as Database;
+  } catch {
+    cache = { users: [], credentials: [] };
+  }
+  return cache;
+}
+
+async function persist(db: Database) {
+  await mkdir(path.dirname(DB_PATH), { recursive: true });
+  const tmp = `${DB_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(db, null, 2));
+  await rename(tmp, DB_PATH);
+}
+
+/** Serialise mutations so concurrent requests never clobber each other. */
+function mutate<T>(fn: (db: Database) => T | Promise<T>): Promise<T> {
+  const run = writeQueue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    await persist(db);
+    return result;
+  });
+  writeQueue = run.catch(() => undefined);
+  return run;
+}
+
+const normalise = (username: string) => username.trim().toLowerCase();
+
+export async function findUserById(id: string) {
+  return (await load()).users.find((u) => u.id === id) ?? null;
+}
+
+export async function findUserByUsername(username: string) {
+  const key = normalise(username);
+  return (await load()).users.find((u) => normalise(u.username) === key) ?? null;
+}
+
+export function findOrCreateUser(username: string): Promise<StoredUser> {
+  return mutate((db) => {
+    const key = normalise(username);
+    const existing = db.users.find((u) => normalise(u.username) === key);
+    if (existing) return existing;
+    const user: StoredUser = {
+      id: randomBytes(32).toString('base64url'),
+      username: username.trim(),
+      displayName: username.trim(),
+      createdAt: Date.now(),
+    };
+    db.users.push(user);
+    return user;
+  });
+}
+
+export function updateUser(id: string, patch: Partial<Pick<StoredUser, 'displayName'>>) {
+  return mutate((db) => {
+    const user = db.users.find((u) => u.id === id);
+    if (!user) return null;
+    Object.assign(user, patch);
+    return user;
+  });
+}
+
+export async function findCredentialById(id: string) {
+  return (await load()).credentials.find((c) => c.id === id) ?? null;
+}
+
+export async function findCredentialsByUserId(userId: string) {
+  return (await load()).credentials
+    .filter((c) => c.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export function saveCredential(credential: StoredPasskeyCredential) {
+  return mutate((db) => {
+    const index = db.credentials.findIndex((c) => c.id === credential.id);
+    if (index === -1) db.credentials.push(credential);
+    else db.credentials[index] = credential;
+    return credential;
+  });
+}
+
+export function deleteCredential(id: string) {
+  return mutate((db) => {
+    const before = db.credentials.length;
+    db.credentials = db.credentials.filter((c) => c.id !== id);
+    return db.credentials.length !== before;
+  });
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..6415f31
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,255 @@
+/**
+ * Browser-side passkey helpers built directly on the native WebAuthn APIs.
+ * All binary values travel as Base64URL JSON via parse*FromJSON() / toJSON().
+ */
+
+const BASE = import.meta.env.BASE_URL;
+
+export const apiUrl = (path: string) => `${BASE}api/auth/${path}`;
+
+export async function postJson(path: string, body?: unknown, method = 'POST') {
+  return fetch(apiUrl(path), {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+export async function readError(response: Response, fallback: string) {
+  const data = await response.json().catch(() => ({}));
+  return { code: data.code as string | undefined, message: (data.error as string | undefined) ?? fallback };
+}
+
+// --- Typing for newer static methods not yet in every TS DOM lib -------------
+
+type ClientCapabilities = Partial<Record<
+  'conditionalCreate' | 'conditionalGet' | 'hybridTransport' | 'passkeyPlatformAuthenticator' | 'userVerifyingPlatformAuthenticator',
+  boolean
+>>;
+
+interface PublicKeyCredentialStatics {
+  getClientCapabilities?: () => Promise<ClientCapabilities>;
+  parseCreationOptionsFromJSON: (json: unknown) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON: (json: unknown) => PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+}
+
+type JsonCredential = PublicKeyCredential & { toJSON(): { id: string } & Record<string, unknown> };
+
+const PKC = () => window.PublicKeyCredential as unknown as PublicKeyCredentialStatics;
+
+let ready: Promise<boolean> | null = null;
+
+/**
+ * Resolves true when WebAuthn is available. Loads webauthn-polyfills so the
+ * JSON helpers and getClientCapabilities() exist on browsers that predate them.
+ */
+export function ensureWebAuthn(): Promise<boolean> {
+  ready ??= (async () => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential || !window.isSecureContext) return false;
+    const pkc = PKC();
+    if (!pkc.parseRequestOptionsFromJSON || !pkc.parseCreationOptionsFromJSON || !pkc.getClientCapabilities) {
+      try {
+        await import('webauthn-polyfills');
+      } catch (err) {
+        console.warn('Failed to load WebAuthn polyfills', err);
+      }
+    }
+    return Boolean(PKC().parseRequestOptionsFromJSON);
+  })();
+  return ready;
+}
+
+export async function getCapabilities(): Promise<ClientCapabilities> {
+  if (!(await ensureWebAuthn())) return {};
+  try {
+    return (await PKC().getClientCapabilities?.()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+/** Gate "Create passkey" UI per guidance: needs a platform authenticator and passkey autofill. */
+export async function canCreatePasskeys() {
+  const caps = await getCapabilities();
+  return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+}
+
+// --- Signal API (progressive enhancement; unsupported in some browsers) ------
+
+export async function signalUnknownCredential(rpId: string, credentialId: string) {
+  const pkc = PKC();
+  if (!pkc?.signalUnknownCredential) return;
+  try {
+    await pkc.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential failed', err);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId: string, userId: string, ids: string[]) {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PKC();
+  if (!pkc.signalAllAcceptedCredentials) return;
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: ids });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials failed', err);
+  }
+}
+
+export async function signalCurrentUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PKC();
+  if (!pkc.signalCurrentUserDetails) return;
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails failed', err);
+  }
+}
+
+// --- Registration ------------------------------------------------------------
+
+export type RegistrationMode = 'promotion' | 'conditional' | 'manage';
+
+export type PasskeyResult =
+  | { status: 'success'; data?: any }
+  | { status: 'cancelled' }
+  | { status: 'unsupported' }
+  | { status: 'reauth-required' }
+  | { status: 'error'; message: string };
+
+const rpIdFromCreation = (json: any): string => json?.rp?.id ?? location.hostname;
+
+export async function registerPasskey(
+  mode: RegistrationMode,
+  { signal }: { signal?: AbortSignal } = {},
+): Promise<PasskeyResult> {
+  if (!(await ensureWebAuthn())) return { status: 'unsupported' };
+
+  const optionsResponse = await postJson('passkeys/registration-options', { mode });
+  if (!optionsResponse.ok) {
+    const { code, message } = await readError(optionsResponse, 'Could not start passkey creation.');
+    return code === 'REAUTH_REQUIRED' ? { status: 'reauth-required' } : { status: 'error', message };
+  }
+  const optionsJSON = await optionsResponse.json();
+  const rpId = rpIdFromCreation(optionsJSON);
+
+  let credential: JsonCredential;
+  try {
+    const publicKey = PKC().parseCreationOptionsFromJSON(optionsJSON);
+    credential = (await navigator.credentials.create({
+      publicKey,
+      signal,
+      ...(mode === 'conditional' && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as JsonCredential;
+  } catch (err) {
+    const name = (err as DOMException)?.name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    if (name === 'InvalidStateError') {
+      return { status: 'error', message: 'A passkey for this account already exists in this password manager.' };
+    }
+    if (name === 'SecurityError') {
+      console.error('Passkey RP ID / secure context configuration error', err);
+      return { status: 'error', message: 'Passkeys aren’t available on this site configuration.' };
+    }
+    console.error('Unexpected passkey creation error', err);
+    return { status: 'error', message: 'Something went wrong creating your passkey.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const verifyResponse = await postJson('passkeys/registration-verify', encoded);
+    if (!verifyResponse.ok) {
+      // The server rejected it: remove the orphaned passkey from the provider.
+      await signalUnknownCredential(rpId, encoded.id);
+      const { message } = await readError(verifyResponse, 'We couldn’t save your passkey.');
+      return { status: 'error', message };
+    }
+    return { status: 'success', data: await verifyResponse.json() };
+  } catch (err) {
+    console.error('Passkey verification network failure', err);
+    await signalUnknownCredential(rpId, encoded.id);
+    return { status: 'error', message: 'Network error while saving your passkey.' };
+  }
+}
+
+/**
+ * Silent post-password-sign-in upgrade. Never surfaces errors to the user.
+ * Resolves after at most `timeoutMs` so navigation isn't held up.
+ */
+export async function tryConditionalCreate(timeoutMs = 8000): Promise<boolean> {
+  const caps = await getCapabilities();
+  if (!caps.conditionalCreate) return false;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const result = await registerPasskey('conditional', { signal: controller.signal });
+    return result.status === 'success';
+  } catch {
+    return false;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+// --- Authentication / reauthentication ---------------------------------------
+
+async function getAssertion(
+  reauth: boolean,
+  { signal, mediation }: { signal?: AbortSignal; mediation?: CredentialMediationRequirement },
+): Promise<PasskeyResult> {
+  if (!(await ensureWebAuthn())) return { status: 'unsupported' };
+
+  const optionsResponse = await postJson('passkeys/authentication-options', { reauth });
+  if (!optionsResponse.ok) {
+    const { message } = await readError(optionsResponse, 'Could not start passkey sign-in.');
+    return { status: 'error', message };
+  }
+  const optionsJSON = await optionsResponse.json();
+  const rpId: string = optionsJSON.rpId ?? location.hostname;
+
+  let credential: JsonCredential | null;
+  try {
+    const publicKey = PKC().parseRequestOptionsFromJSON(optionsJSON);
+    credential = (await navigator.credentials.get({ publicKey, signal, mediation })) as JsonCredential | null;
+  } catch (err) {
+    const name = (err as DOMException)?.name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    if (name === 'SecurityError') console.error('Passkey RP ID / secure context configuration error', err);
+    else console.error('Unexpected passkey sign-in error', err);
+    return { status: 'error', message: 'Something went wrong signing in with your passkey.' };
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = credential.toJSON();
+  try {
+    const verifyResponse = await postJson('passkeys/authentication-verify', encoded);
+    if (verifyResponse.ok) return { status: 'success', data: await verifyResponse.json() };
+    if (verifyResponse.status === 404) {
+      // Credential deleted server-side: let the password manager hide it.
+      await signalUnknownCredential(rpId, encoded.id);
+    }
+    const { message } = await readError(verifyResponse, 'We couldn’t verify your passkey.');
+    return { status: 'error', message };
+  } catch (err) {
+    console.error('Passkey verification network failure', err);
+    return { status: 'error', message: 'Network error while verifying your passkey.' };
+  }
+}
+
+/** Passkey autofill on the username field (Conditional UI). */
+export async function startConditionalSignIn(signal: AbortSignal): Promise<PasskeyResult> {
+  const caps = await getCapabilities();
+  if (!caps.conditionalGet) return { status: 'unsupported' };
+  return getAssertion(false, { signal, mediation: 'conditional' });
+}
+
+/** Explicit "Sign in with a passkey" button. */
+export const signInWithPasskey = (signal?: AbortSignal) => getAssertion(false, { signal });
+
+/** Step-up verification restricted to the signed-in user's passkeys. */
+export const reauthenticateWithPasskey = (signal?: AbortSignal) => getAssertion(true, { signal });
