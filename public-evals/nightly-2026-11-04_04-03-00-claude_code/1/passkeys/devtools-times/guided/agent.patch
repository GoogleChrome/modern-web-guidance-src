@@ -0,0 +1,54 @@
+import type { APIRoute, AstroSession } from 'astro';
+import {
+  deleteCredential,
+  findCredentialById,
+  saveCredential,
+  type StoredPasskeyCredential,
+  type StoredUser,
+} from '../../../../lib/auth/store';
+import {
+  accountSummary,
+  errorResponse,
+  getSessionUser,
+  isRecentlyVerified,
+  json,
+  readJson,
+  reauthRequired,
+} from '../../../../lib/auth/server';
+
+type Owned =
+  | { ok: false; response: Response }
+  | { ok: true; user: StoredUser; credential: StoredPasskeyCredential };
+
+async function ownedCredential(session: AstroSession | undefined, id: string | undefined): Promise<Owned> {
+  const user = await getSessionUser(session);
+  if (!user) return { ok: false, response: errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.') };
+  const credential = id ? await findCredentialById(id) : null;
+  if (!credential || credential.passkeyUserId !== user.id) {
+    return { ok: false, response: errorResponse(404, 'NOT_FOUND', 'Passkey not found.') };
+  }
+  return { ok: true, user, credential };
+}
+
+/** Rename a passkey (server-side label only). */
+export const PATCH: APIRoute = async ({ params, request, session, url }) => {
+  const result = await ownedCredential(session, params.id);
+  if (!result.ok) return result.response;
+
+  const { name } = await readJson<{ name: string }>(request);
+  const value = typeof name === 'string' ? name.trim() : '';
+  if (!value || value.length > 64) return errorResponse(400, 'BAD_REQUEST', 'Name must be between 1 and 64 characters.');
+
+  await saveCredential({ ...result.credential, name: value });
+  return json(await accountSummary(url, result.user));
+};
+
+/** Delete a passkey. Sensitive: requires a recent sign-in or reauthentication. */
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const result = await ownedCredential(session, params.id);
+  if (!result.ok) return result.response;
+  if (!(await isRecentlyVerified(session))) return reauthRequired();
+
+  await deleteCredential(result.credential.id);
+  return json(await accountSummary(url, result.user));
+};
diff --git a/src/pages/api/auth/passkeys/authentication-options.ts b/src/pages/api/auth/passkeys/authentication-options.ts
new file mode 100644
index 0000000..1bef866
--- /dev/null
+++ b/src/pages/api/auth/passkeys/authentication-options.ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+import {
+  errorResponse,
+  getRelyingParty,
+  getSessionUser,
+  json,
+  readJson,
+  storeChallenge,
+} from '../../../../lib/auth/server';
+
+/**
+ * Sign-in (discoverable credentials, empty allowCredentials) or, with
+ * `{ reauth: true }`, step-up verification restricted to the signed-in user's passkeys.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { reauth = false } = await readJson<{ reauth: boolean }>(request);
+  const { rpID } = getRelyingParty(url);
+  const userVerification = 'preferred' as const;
+
+  if (reauth) {
+    const user = await getSessionUser(session);
+    if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+    const credentials = await findCredentialsByUserId(user.id);
+    if (credentials.length === 0) {
+      return errorResponse(400, 'NO_PASSKEYS', 'There are no passkeys on this account.');
+    }
+    const options = await generateAuthenticationOptions({
+      rpID,
+      userVerification,
+      allowCredentials: credentials.map((c) => ({ id: c.id, transports: c.transports as never })),
+    });
+    storeChallenge(session, { kind: 'reauthentication', challenge: options.challenge, userVerification, userId: user.id });
+    return json(options);
+  }
+
+  const options = await generateAuthenticationOptions({ rpID, userVerification, allowCredentials: [] });
+  // The expected UV level lives in the session, never in client-provided input.
+  storeChallenge(session, { kind: 'authentication', challenge: options.challenge, userVerification });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/authentication-verify.ts b/src/pages/api/auth/passkeys/authentication-verify.ts
