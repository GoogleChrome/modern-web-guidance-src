+++ b/src/pages/api/auth/reauth/password.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import {
+  errorResponse,
+  getSessionUser,
+  json,
+  markVerified,
+  readJson,
+  upstreamPasswordCall,
+} from '../../../../lib/auth/server';
+
+/** Password-based reauthentication fallback for accounts without passkeys. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errorResponse(401, 'UNAUTHENTICATED', 'Please sign in.');
+
+  const { password } = await readJson<{ password: string }>(request);
+  if (!password) return errorResponse(400, 'BAD_REQUEST', 'Password is required.');
+
+  try {
+    const upstream = await upstreamPasswordCall('login', user.username, password);
+    if (!upstream.ok) return errorResponse(401, 'INVALID_PASSWORD', 'That password is incorrect.');
+  } catch {
+    return errorResponse(502, 'UPSTREAM_UNAVAILABLE', 'The sign-in service is unavailable. Please try again later.');
+  }
+  markVerified(session);
+  return json({ ok: true });
+};
