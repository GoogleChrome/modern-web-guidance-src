diff --git a/src/lib/auth/aaguid.ts b/src/lib/auth/aaguid.ts
new file mode 100644
index 0000000..d624f6a
--- /dev/null
+++ b/src/lib/auth/aaguid.ts
@@ -0,0 +1,40 @@
+/**
+ * Resolve a passkey provider name/icon from its AAGUID using the community
+ * registry. The AAGUID is a UX hint only: it is not attested for platform
+ * passkeys and MUST NOT be used for any security decision.
+ */
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const CACHE_TTL = 24 * 60 * 60 * 1000;
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registry: Registry | null = null;
+let fetchedAt = 0;
+let inflight: Promise<Registry | null> | null = null;
+
+async function getRegistry(): Promise<Registry | null> {
+  if (registry && Date.now() - fetchedAt < CACHE_TTL) return registry;
+  inflight ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then(async (res) => {
+      if (!res.ok) throw new Error(`AAGUID registry responded ${res.status}`);
+      registry = (await res.json()) as Registry;
+      fetchedAt = Date.now();
+      return registry;
+    })
+    .catch((err) => {
+      console.warn('Could not load AAGUID registry:', err);
+      return registry; // keep any stale copy
+    })
+    .finally(() => {
+      inflight = null;
+    });
+  return inflight;
+}
+
+export async function lookupProvider(aaguid: string): Promise<{ name: string; icon?: string }> {
+  if (!aaguid || aaguid === ZERO_AAGUID) return { name: 'Unknown passkey provider' };
+  const entry = (await getRegistry())?.[aaguid];
+  return entry ? { name: entry.name, icon: entry.icon_light } : { name: 'Unknown passkey provider' };
+}
diff --git a/src/lib/auth/server.ts b/src/lib/auth/server.ts
new file mode 100644
index 0000000..a8d6722
--- /dev/null
+++ b/src/lib/auth/server.ts
@@ -0,0 +1,133 @@
+import type { AstroSession } from 'astro';
+import { findCredentialsByUserId, findUserById, type StoredPasskeyCredential, type StoredUser } from './store';
+
+export const UPSTREAM_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export const RP_NAME = 'The DevTools Times';
+
+/** How long a successful sign-in / reauthentication counts as "recent" for sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export type ChallengeKind = 'registration' | 'authentication' | 'reauthentication';
+
+interface PendingChallenge {
+  kind: ChallengeKind;
+  challenge: string;
+  userVerification: 'preferred' | 'required';
+  /** Set for registrations started via conditional create (relaxes the UP check). */
+  conditional?: boolean;
+  userId?: string;
+  expiresAt: number;
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const errorResponse = (status: number, code: string, error: string) => json({ code, error }, status);
+
+/**
+ * The RP ID is fixed via RP_ID in production. When unset (e.g. local dev on
+ * localhost) we fall back to the request host name.
+ */
+export function getRelyingParty(url: URL) {
+  const rpID = process.env.RP_ID ?? url.hostname;
+  const origins = process.env.RP_ORIGINS?.split(',').map((o) => o.trim()).filter(Boolean) ?? [
+    url.origin,
+    // TLS is often terminated by a proxy (e.g. Cloud Run) so the browser origin is https.
+    `https://${url.host}`,
+  ];
+  return { rpID, origins: [...new Set(origins)] };
+}
+
+export async function getSessionUser(session: AstroSession | undefined): Promise<StoredUser | null> {
+  const userId = await session?.get('userId');
+  return typeof userId === 'string' ? findUserById(userId) : null;
+}
+
+export async function signIn(session: AstroSession | undefined, user: StoredUser) {
+  if (!session) throw new Error('Sessions are not configured');
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await session.regenerate();
+  session.set('userId', user.id);
+  session.set('verifiedAt', Date.now());
+  session.delete('webauthnChallenge');
+}
+
+export function signOut(session: AstroSession | undefined) {
+  session?.delete('userId');
+  session?.delete('verifiedAt');
+  session?.delete('webauthnChallenge');
+}
+
+export function markVerified(session: AstroSession | undefined) {
+  session?.set('verifiedAt', Date.now());
+}
+
+export async function isRecentlyVerified(session: AstroSession | undefined) {
+  const verifiedAt = await session?.get('verifiedAt');
+  return typeof verifiedAt === 'number' && Date.now() - verifiedAt < REAUTH_WINDOW_MS;
+}
+
+export const reauthRequired = () =>
+  errorResponse(403, 'REAUTH_REQUIRED', 'Please confirm it’s you before making this change.');
+
+export function storeChallenge(session: AstroSession | undefined, pending: Omit<PendingChallenge, 'expiresAt'>) {
+  session?.set('webauthnChallenge', { ...pending, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+}
+
+/** Read and invalidate the pending challenge so it can only be used once. */
+export async function consumeChallenge(
+  session: AstroSession | undefined,
+  kinds: ChallengeKind | ChallengeKind[],
+): Promise<PendingChallenge | null> {
+  const allowed = Array.isArray(kinds) ? kinds : [kinds];
+  const pending = (await session?.get('webauthnChallenge')) as PendingChallenge | undefined;
+  session?.delete('webauthnChallenge');
+  if (!pending || !allowed.includes(pending.kind) || pending.expiresAt < Date.now()) return null;
+  return pending;
+}
+
+/** Strip the public key and other internals before sending credentials to the browser. */
+export function toPublicCredential(c: StoredPasskeyCredential) {
+  return {
+    id: c.id,
+    name: c.name,
+    providerName: c.providerName,
+    providerIcon: c.providerIcon,
+    synced: c.credentialBackedUp,
+    registeredAt: c.registeredAt,
+    lastUsedAt: c.lastUsedAt,
+  };
+}
+
+export async function accountSummary(url: URL, user: StoredUser) {
+  const credentials = await findCredentialsByUserId(user.id);
+  return {
+    rpId: getRelyingParty(url).rpID,
+    user: { id: user.id, username: user.username, displayName: user.displayName },
+    passkeys: credentials.map(toPublicCredential),
+  };
+}
+
+export async function readJson<T>(request: Request): Promise<Partial<T>> {
+  try {
+    return (await request.json()) as Partial<T>;
+  } catch {
+    return {};
+  }
+}
+
+/** Forward a username/password pair to the upstream Times API. */
+export async function upstreamPasswordCall(endpoint: 'login' | 'register', username: string, password: string) {
+  const response = await fetch(`${UPSTREAM_API}/${endpoint}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, status: response.status, data: data as Record<string, unknown> };
+}
