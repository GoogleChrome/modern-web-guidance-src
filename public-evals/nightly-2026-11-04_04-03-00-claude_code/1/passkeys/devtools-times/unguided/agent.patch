@@ -0,0 +1,497 @@
+import React, { useEffect, useRef, useState } from 'react';
+import {
+  ArrowRightStartOnRectangleIcon,
+  CloudIcon,
+  KeyIcon,
+  PencilIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+} from '@heroicons/react/24/outline';
+import {
+  ApiError,
+  api,
+  createPasskey,
+  describeError,
+  isSilentError,
+  reauthenticateWithPasskey,
+  reauthenticateWithPassword,
+  signalAcceptedCredentials,
+  signalUserDetails,
+  supportsPasskeys,
+} from '../lib/passkeys-client';
+import { WebAuthnError } from '@simplewebauthn/browser';
+import type { AccountSnapshot, PasskeySummary } from '../lib/auth/session';
+
+interface Props {
+  initialAccount: AccountSnapshot;
+  rpID: string;
+}
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+const formatDate = (iso: string | null) => (iso ? dateFormat.format(new Date(iso)) : 'Never');
+
+export default function AccountSettings({ initialAccount, rpID }: Props) {
+  const [account, setAccount] = useState(initialAccount);
+  const [canUsePasskeys, setCanUsePasskeys] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const reauthResolver = useRef<((ok: boolean) => void) | null>(null);
+
+  const { user, passkeys } = account;
+
+  // Keep passkey providers in sync with the server: hide deleted passkeys and show the current username.
+  useEffect(() => {
+    signalAcceptedCredentials(rpID, user.id, passkeys.map((p) => p.id));
+  }, [rpID, user.id, passkeys]);
+  useEffect(() => {
+    signalUserDetails(rpID, user.id, user.username);
+    setCanUsePasskeys(supportsPasskeys());
+  }, [rpID, user.id, user.username]);
+
+  /** Opens the "confirm it's you" dialog and resolves once the user reauthenticates (or cancels). */
+  const requestReauth = () =>
+    new Promise<boolean>((resolve) => {
+      reauthResolver.current = resolve;
+      setReauthOpen(true);
+    });
+
+  const closeReauth = (ok: boolean, reauthUntil?: number) => {
+    if (reauthUntil) setAccount((a) => ({ ...a, reauthUntil }));
+    setReauthOpen(false);
+    reauthResolver.current?.(ok);
+    reauthResolver.current = null;
+  };
+
+  /** Runs a sensitive action, asking the user to reauthenticate first if their last verification is stale. */
+  const withReauth = async <T,>(action: () => Promise<T>): Promise<T | undefined> => {
+    if (Date.now() > account.reauthUntil - 10_000 && !(await requestReauth())) return undefined;
+    try {
+      return await action();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'reauth_required') {
+        if (!(await requestReauth())) return undefined;
+        return action();
+      }
+      throw err;
+    }
+  };
+
+  const run = async (fn: () => Promise<void>) => {
+    setBusy(true);
+    setError(null);
+    setNotice(null);
+    try {
+      await fn();
+    } catch (err) {
+      if (err instanceof WebAuthnError && err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+        setError('You already have a passkey for this account in this password manager or on this device.');
+      } else if (!isSilentError(err)) {
+        setError(describeError(err));
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleAdd = () =>
+    run(async () => {
+      const result = await withReauth(() => createPasskey());
+      if (result) {
+        setAccount(result.account);
+        setNotice(`Passkey “${result.passkey.name}” created.`);
+      }
+    });
+
+  const handleRename = (passkey: PasskeySummary, name: string) =>
+    run(async () => {
+      const next = await api<AccountSnapshot>(`passkeys/${encodeURIComponent(passkey.id)}`, { method: 'PATCH', body: { name } });
+      setAccount(next);
+      setNotice('Passkey renamed.');
+    });
+
+  const handleDelete = (passkey: PasskeySummary) =>
+    run(async () => {
+      const next = await withReauth(() =>
+        api<AccountSnapshot>(`passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' }),
+      );
+      if (next) {
+        setAccount(next);
+        setNotice(
+          `Passkey “${passkey.name}” deleted. It may still appear in your password manager until it syncs; you can remove it there too.`,
+        );
+      }
+    });
+
+  const handleSignOut = () =>
+    run(async () => {
+      await api('signout', { body: {} });
+      window.location.assign(import.meta.env.BASE_URL);
+    });
+
+  const isOnlySignInMethod = !user.hasPassword && passkeys.length === 1;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-start justify-between gap-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <strong className="text-gray-900">{user.username}</strong>
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          disabled={busy}
+          className="inline-flex items-center gap-1.5 py-2 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-400"
+        >
+          <ArrowRightStartOnRectangleIcon className="h-4 w-4" aria-hidden="true" />
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && (
+          <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            {notice}
+          </div>
+        )}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="signin-methods">
+        <h2 id="signin-methods" className="text-lg font-semibold text-gray-900">Sign-in methods</h2>
+        <dl className="mt-4 divide-y divide-gray-100 text-sm">
+          <div className="flex justify-between py-2">
+            <dt className="text-gray-600">Password</dt>
+            <dd className="font-medium text-gray-900">{user.hasPassword ? 'Set' : 'Not set (passkey-only account)'}</dd>
+          </div>
+          <div className="flex justify-between py-2">
+            <dt className="text-gray-600">Passkeys</dt>
+            <dd className="font-medium text-gray-900">{passkeys.length}</dd>
+          </div>
+        </dl>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div className="max-w-md">
+            <h2 id="passkeys-heading" className="text-lg font-semibold text-gray-900">Passkeys</h2>
+            <p className="mt-1 text-sm text-gray-600">
+              Passkeys let you sign in with your fingerprint, face, or screen lock. They’re stored in your
+              password manager or on your device and can’t be phished.
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={handleAdd}
+            disabled={busy || !canUsePasskeys}
+            className="inline-flex items-center gap-1.5 py-2 px-3 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+          >
+            <PlusIcon className="h-4 w-4" aria-hidden="true" />
+            Create a passkey
+          </button>
+        </div>
+
+        {!canUsePasskeys && (
+          <p className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser doesn’t support passkeys. You can still manage existing passkeys here.
+          </p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <div className="mt-6 flex flex-col items-center rounded-lg border border-dashed border-gray-300 p-8 text-center">
+            <KeyIcon className="h-8 w-8 text-gray-400" aria-hidden="true" />
+            <p className="mt-2 text-sm font-medium text-gray-900">No passkeys yet</p>
+            <p className="mt-1 text-sm text-gray-600">Create one to sign in faster without your password.</p>
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {passkeys.map((passkey) => (
+              <PasskeyRow
+                key={passkey.id}
+                passkey={passkey}
+                busy={busy}
+                deletable={!isOnlySignInMethod}
+                onRename={(name) => handleRename(passkey, name)}
+                onDelete={() => handleDelete(passkey)}
+              />
+            ))}
+          </ul>
+        )}
+        {isOnlySignInMethod && (
+          <p className="mt-3 text-xs text-gray-500">
+            This is your only way to sign in. Create another passkey before deleting this one.
+          </p>
+        )}
+      </section>
+
+      <ReauthDialog
+        open={reauthOpen}
+        hasPassword={user.hasPassword}
+        hasPasskeys={passkeys.length > 0 && canUsePasskeys}
+        onSuccess={(until) => closeReauth(true, until)}
+        onCancel={() => closeReauth(false)}
+      />
+    </div>
+  );
+}
+
+function PasskeyRow({
+  passkey,
+  busy,
+  deletable,
+  onRename,
+  onDelete,
+}: {
+  passkey: PasskeySummary;
+  busy: boolean;
+  deletable: boolean;
+  onRename: (name: string) => Promise<void>;
+  onDelete: () => Promise<void>;
+}) {
+  const [editing, setEditing] = useState(false);
+  const [confirmingDelete, setConfirmingDelete] = useState(false);
+  const [name, setName] = useState(passkey.name);
+  const inputId = `passkey-name-${passkey.id}`;
+
+  const submitRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmed = name.trim();
+    if (trimmed && trimmed !== passkey.name) await onRename(trimmed);
+    setEditing(false);
+  };
+
+  return (
+    <li className="py-4">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div className="flex min-w-0 items-start gap-3">
+          <div className="mt-0.5 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-gray-100">
+            <KeyIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+          </div>
+          <div className="min-w-0">
+            {editing ? (
+              <form onSubmit={submitRename} className="flex items-center gap-2">
+                <label htmlFor={inputId} className="sr-only">Passkey name</label>
+                <input
+                  id={inputId}
+                  value={name}
+                  onChange={(e) => setName(e.target.value)}
+                  maxLength={64}
+                  required
+                  autoFocus
+                  className="px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                />
+                <button type="submit" disabled={busy} className="text-sm font-medium text-gray-900 underline">Save</button>
+                <button
+                  type="button"
+                  onClick={() => { setName(passkey.name); setEditing(false); }}
+                  className="text-sm text-gray-600 hover:underline"
+                >
+                  Cancel
+                </button>
+              </form>
+            ) : (
+              <p className="truncate font-medium text-gray-900">{passkey.name}</p>
+            )}
+            <p className="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-600">
+              {passkey.provider && passkey.provider !== passkey.name && <span>{passkey.provider}</span>}
+              {passkey.synced && (
+                <span className="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-blue-800">
+                  <CloudIcon className="h-3 w-3" aria-hidden="true" />
+                  Synced
+                </span>
+              )}
+              <span>Created {formatDate(passkey.createdAt)}</span>
+              <span>Last used {formatDate(passkey.lastUsedAt)}</span>
+            </p>
+          </div>
+        </div>
+
+        {!editing && (
+          <div className="flex items-center gap-1">
+            {confirmingDelete ? (
+              <>
+                <span className="text-sm text-gray-700 mr-1">Delete this passkey?</span>
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={async () => { await onDelete(); setConfirmingDelete(false); }}
+                  className="py-1 px-2 rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500"
+                >
+                  Delete
+                </button>
+                <button
+                  type="button"
+                  onClick={() => setConfirmingDelete(false)}
+                  className="py-1 px-2 rounded-md text-sm text-gray-700 hover:bg-gray-100"
+                >
+                  Cancel
+                </button>
+              </>
+            ) : (
+              <>
+                <button
+                  type="button"
+                  onClick={() => setEditing(true)}
+                  disabled={busy}
+                  className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-400"
+                  aria-label={`Rename ${passkey.name}`}
+                  title="Rename"
+                >
+                  <PencilIcon className="h-4 w-4" aria-hidden="true" />
+                </button>
+                <button
+                  type="button"
+                  onClick={() => setConfirmingDelete(true)}
+                  disabled={busy || !deletable}
+                  className="p-2 rounded-md text-gray-600 hover:bg-red-50 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-red-400 disabled:opacity-40 disabled:cursor-not-allowed"
+                  aria-label={`Delete ${passkey.name}`}
+                  title={deletable ? 'Delete' : 'You can’t delete your only passkey'}
+                >
+                  <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                </button>
+              </>
+            )}
+          </div>
+        )}
+      </div>
+    </li>
+  );
+}
+
+function ReauthDialog({
+  open,
+  hasPassword,
+  hasPasskeys,
+  onSuccess,
+  onCancel,
+}: {
+  open: boolean;
+  hasPassword: boolean;
+  hasPasskeys: boolean;
+  onSuccess: (reauthUntil: number) => void;
+  onCancel: () => void;
+}) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      setPassword('');
+      setError(null);
+      dialog.showModal();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open]);
+
+  const attempt = async (fn: () => Promise<{ reauthUntil: number }>) => {
+    setBusy(true);
+    setError(null);
+    try {
+      const { reauthUntil } = await fn();
+      onSuccess(reauthUntil);
+    } catch (err) {
+      if (!isSilentError(err)) setError(describeError(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      onCancel={(e) => { e.preventDefault(); onCancel(); }}
+      aria-labelledby="reauth-title"
+      className="m-auto w-full max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-gray-900/50"
+    >
+      <div className="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-gray-100">
+        <ShieldCheckIcon className="h-5 w-5 text-gray-800" aria-hidden="true" />
+      </div>
+      <h2 id="reauth-title" className="text-lg font-semibold text-gray-900">Confirm it’s you</h2>
+      <p className="mt-1 text-sm text-gray-600">To keep your account secure, verify your identity before changing your passkeys.</p>
+
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      <div className="mt-5 space-y-4">
+        {hasPasskeys && (
+          <button
+            type="button"
+            disabled={busy}
+            onClick={() => attempt(reauthenticateWithPasskey)}
+            className="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75"
+          >
+            <KeyIcon className="h-4 w-4" aria-hidden="true" />
+            Use your passkey
+          </button>
+        )}
+
+        {hasPasskeys && hasPassword && (
+          <div className="flex items-center gap-3 text-xs uppercase tracking-wider text-gray-500" aria-hidden="true">
+            <span className="h-px flex-1 bg-gray-200" />
+            or
+            <span className="h-px flex-1 bg-gray-200" />
+          </div>
+        )}
+
+        {hasPassword && (
+          <form
+            onSubmit={(e) => { e.preventDefault(); attempt(() => reauthenticateWithPassword(password)); }}
+            className="space-y-3"
+          >
+            <div>
+              <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700 mb-1">Password</label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+              />
+            </div>
+            <button
+              type="submit"
+              disabled={busy}
+              className={`w-full py-2 px-4 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 ${
+                hasPasskeys ? 'border border-gray-300 text-gray-900 hover:bg-gray-50' : 'text-white bg-gray-900 hover:bg-gray-800'
+              }`}
+            >
+              Confirm with password
+            </button>
+          </form>
+        )}
+
+        {!hasPasskeys && !hasPassword && (
+          <p className="text-sm text-gray-600">Passkeys aren’t supported in this browser. Use a device with your passkey to make changes.</p>
+        )}
+
+        <button
+          type="button"
+          onClick={onCancel}
+          disabled={busy}
+          className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+        >
+          Cancel
+        </button>
+      </div>
+    </dialog>
+  );
+}
