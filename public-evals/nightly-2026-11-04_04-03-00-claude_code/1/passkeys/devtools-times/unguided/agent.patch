+import type { APIRoute } from 'astro';
+import { upstreamLogin } from '../../../lib/auth/upstream';
+import { listPasskeys, upsertPasswordUser } from '../../../lib/auth/store';
+import { error, json, readJSON, requireSession, startAuthenticatedSession } from '../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJSON<{ username?: string; password?: string }>(request);
+  const username = body?.username?.trim();
+  const password = body?.password;
+  if (!username || !password) return error(400, 'invalid_request', 'Username and password are required.');
+
+  const result = await upstreamLogin(username, password);
+  if (!result.ok) {
+    return error(result.status === 502 ? 502 : 401, result.error ?? 'login_failed', `Login failed: ${result.error}`);
+  }
+
+  const user = await upsertPasswordUser(username);
+  await startAuthenticatedSession(requireSession(session), user.id);
+  const passkeys = await listPasskeys(user.id);
+  return json({ user: { username: user.username }, hasPasskeys: passkeys.length > 0 });
+};
