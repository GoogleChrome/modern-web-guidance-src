+import type { APIRoute } from 'astro';
+import { listPasskeys } from '../../../../lib/auth/store';
+import { buildRegistrationOptions } from '../../../../lib/auth/webauthn';
+import {
+  getCurrentUser, isRecentlyVerified, json, reauthRequired, requireSession, saveChallenge, unauthenticated,
+} from '../../../../lib/auth/session';
+
+/** Options for adding a passkey to the signed-in account. Requires a recent sign-in or reauth. */
+export const POST: APIRoute = async ({ session, url }) => {
+  const current = await getCurrentUser(session);
+  if (!current) return unauthenticated();
+  if (!isRecentlyVerified(current.auth)) return reauthRequired();
+
+  const options = await buildRegistrationOptions(url, current.user, await listPasskeys(current.user.id));
+  saveChallenge(requireSession(session), { challenge: options.challenge, purpose: 'register' });
+  return json(options);
+};
