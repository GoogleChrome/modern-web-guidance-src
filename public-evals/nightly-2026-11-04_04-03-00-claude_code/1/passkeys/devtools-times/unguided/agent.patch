@@ -0,0 +1,61 @@
+import type { APIRoute } from 'astro';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { findPasskey, findUserById, updatePasskey } from '../../../../lib/auth/store';
+import { verifyAuthentication } from '../../../../lib/auth/webauthn';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import {
+  consumeChallenge, error, getCurrentUser, json, markReauthenticated, readJSON, reauthDeadline,
+  requireSession, startAuthenticatedSession, unauthenticated,
+} from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJSON<{ purpose?: string; response?: AuthenticationResponseJSON }>(request);
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  const response = body?.response;
+  if (!response?.id) return error(400, 'invalid_request', 'Missing passkey response.');
+
+  const s = requireSession(session);
+  const pending = await consumeChallenge(s, purpose);
+  if (!pending) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+
+  const current = purpose === 'reauth' ? await getCurrentUser(session) : null;
+  if (purpose === 'reauth' && !current) return unauthenticated();
+
+  const passkey = await findPasskey(response.id);
+  const user = passkey ? await findUserById(passkey.userId) : null;
+  if (!passkey || !user) {
+    // Let the client tell the passkey provider to hide/remove this stale passkey.
+    return error(404, 'unknown_credential', 'This passkey is no longer registered with The DevTools Times.', {
+      credentialId: response.id,
+      rpID: getRelyingParty(url).rpID,
+    });
+  }
+  if (response.response.userHandle && response.response.userHandle !== user.id) {
+    return error(400, 'user_mismatch', 'This passkey doesn’t match the account.');
+  }
+  if (current && current.user.id !== user.id) {
+    return error(403, 'wrong_account', 'That passkey belongs to a different account.');
+  }
+
+  let info;
+  try {
+    info = await verifyAuthentication(url, response, pending.challenge, passkey);
+  } catch (err) {
+    console.warn('Passkey authentication failed', err);
+  }
+  if (!info) return error(400, 'verification_failed', 'We couldn’t verify that passkey. Please try again.');
+
+  await updatePasskey(passkey.id, user.id, {
+    counter: info.newCounter,
+    backedUp: info.credentialBackedUp,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (purpose === 'reauth') {
+    const auth = markReauthenticated(s, user.id);
+    return json({ reauthUntil: reauthDeadline(auth) });
+  }
+
+  await startAuthenticatedSession(s, user.id);
+  return json({ user: { username: user.username } });
+};
