@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { deletePasskey, listPasskeys, updatePasskey } from '../../../../lib/auth/store';
+import {
+  accountSnapshot, error, getCurrentUser, isRecentlyVerified, json, readJSON, reauthRequired, unauthenticated,
+} from '../../../../lib/auth/session';
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const current = await getCurrentUser(session);
+  if (!current) return unauthenticated();
+
+  const body = await readJSON<{ name?: string }>(request);
+  const name = body?.name?.trim();
+  if (!name || name.length > 64) return error(400, 'invalid_name', 'Passkey names must be 1–64 characters.');
+
+  const updated = await updatePasskey(params.id!, current.user.id, { name });
+  if (!updated) return error(404, 'not_found', 'Passkey not found.');
+  return json(await accountSnapshot(current.user, current.auth));
+};
+
+/** Delete a passkey. Requires a recent sign-in or reauthentication. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const current = await getCurrentUser(session);
+  if (!current) return unauthenticated();
+  if (!isRecentlyVerified(current.auth)) return reauthRequired();
+
+  const passkeys = await listPasskeys(current.user.id);
+  if (!passkeys.some((p) => p.id === params.id)) return error(404, 'not_found', 'Passkey not found.');
+  if (!current.user.hasPassword && passkeys.length === 1) {
+    return error(400, 'last_passkey', 'You can’t delete your only passkey: it’s the only way to sign in to this account. Add another passkey first.');
+  }
+
+  await deletePasskey(params.id!, current.user.id);
+  return json(await accountSnapshot(current.user, current.auth));
+};
