diff --git a/src/components/PasskeyUpgradePrompt.tsx b/src/components/PasskeyUpgradePrompt.tsx
new file mode 100644
index 0000000..03242d9
--- /dev/null
+++ b/src/components/PasskeyUpgradePrompt.tsx
@@ -0,0 +1,80 @@
+import React, { useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import { createPasskey, describeError, isSilentError } from '../lib/passkeys-client';
+import { WebAuthnError } from '@simplewebauthn/browser';
+
+interface Props {
+  username: string;
+  title?: string;
+  onDone: () => void;
+}
+
+/** Offered after a password sign-in / sign-up: create a passkey for faster, phishing-resistant sign-in. */
+export default function PasskeyUpgradePrompt({ username, title = 'Sign in faster next time', onDone }: Props) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [created, setCreated] = useState(false);
+
+  const handleCreate = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      await createPasskey();
+      setCreated(true);
+      setTimeout(onDone, 1200);
+    } catch (err) {
+      if (err instanceof WebAuthnError && err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+        onDone();
+        return;
+      }
+      if (!isSilentError(err)) setError(describeError(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="text-center" aria-live="polite">
+      <div className="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100">
+        <KeyIcon className="h-6 w-6 text-gray-800" aria-hidden="true" />
+      </div>
+      <h2 className="text-2xl font-bold mb-2 text-gray-800">{title}</h2>
+      <p className="text-sm text-gray-600 mb-6">
+        Create a passkey for <strong>{username}</strong> to sign in with your fingerprint, face, or screen lock
+        instead of a password. Passkeys can’t be phished or leaked.
+      </p>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg text-left" role="alert">
+          {error}
+        </div>
+      )}
+
+      {created ? (
+        <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          Passkey created! Next time, just choose your passkey to sign in.
+        </div>
+      ) : (
+        <div className="space-y-3">
+          <button
+            type="button"
+            onClick={handleCreate}
+            disabled={busy}
+            className="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+          >
+            <KeyIcon className="h-4 w-4" aria-hidden="true" />
+            {busy ? 'Creating passkey…' : 'Create a passkey'}
+          </button>
+          <button
+            type="button"
+            onClick={onDone}
+            disabled={busy}
+            className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400"
+          >
+            Not now
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
