@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import type { RegistrationResponseJSON } from '@simplewebauthn/server';
+import { addPasskey } from '../../../../lib/auth/store';
+import { verifyRegistration } from '../../../../lib/auth/webauthn';
+import {
+  accountSnapshot, consumeChallenge, error, getCurrentUser, json, readJSON, requireSession,
+  serializePasskey, unauthenticated,
+} from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const current = await getCurrentUser(session);
+  if (!current) return unauthenticated();
+
+  const body = await readJSON<{ response?: RegistrationResponseJSON }>(request);
+  if (!body?.response?.id) return error(400, 'invalid_request', 'Missing passkey response.');
+
+  const pending = await consumeChallenge(requireSession(session), 'register');
+  if (!pending) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+
+  let passkey;
+  try {
+    passkey = await verifyRegistration(url, body.response, pending.challenge);
+  } catch (err) {
+    console.warn('Passkey registration failed', err);
+  }
+  if (!passkey) return error(400, 'verification_failed', 'We couldn’t verify that passkey. Please try again.');
+
+  try {
+    await addPasskey({ ...passkey, userId: current.user.id });
+  } catch {
+    return error(409, 'credential_exists', 'This passkey is already registered.');
+  }
+
+  return json({ passkey: serializePasskey({ ...passkey, userId: current.user.id }), account: await accountSnapshot(current.user, current.auth) });
+};
