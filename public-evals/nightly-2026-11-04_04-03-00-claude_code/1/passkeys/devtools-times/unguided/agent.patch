+import type { APIRoute } from 'astro';
+import { listPasskeys } from '../../../../lib/auth/store';
+import { buildAuthenticationOptions } from '../../../../lib/auth/webauthn';
+import {
+  error, getCurrentUser, json, readJSON, requireSession, saveChallenge, unauthenticated,
+} from '../../../../lib/auth/session';
+
+/**
+ * Options for a passkey assertion.
+ * - `signin`: discoverable-credential flow (works with autofill / conditional UI).
+ * - `reauth`: limited to the signed-in user's passkeys.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJSON<{ purpose?: string }>(request);
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  const s = requireSession(session);
+
+  if (purpose === 'reauth') {
+    const current = await getCurrentUser(session);
+    if (!current) return unauthenticated();
+    const passkeys = await listPasskeys(current.user.id);
+    if (!passkeys.length) return error(400, 'no_passkeys', 'This account has no passkeys yet.');
+    const options = await buildAuthenticationOptions(url, passkeys);
+    saveChallenge(s, { challenge: options.challenge, purpose });
+    return json(options);
+  }
+
+  const options = await buildAuthenticationOptions(url);
+  saveChallenge(s, { challenge: options.challenge, purpose });
+  return json(options);
+};
