-          {loading ? 'Signing up...' : 'Sign Up'}
+          {!usePassword && <KeyIcon className="h-4 w-4" aria-hidden="true" />}
+          {usePassword
+            ? loading ? 'Signing up...' : 'Sign Up'
+            : loading ? 'Creating your passkey…' : 'Sign up with a passkey'}
         </button>
       </form>
+
+      {passkeysAvailable && (
+        <button
+          type="button"
+          onClick={toggleMethod}
+          className="mt-4 w-full text-center text-sm font-medium text-gray-700 underline hover:text-gray-900"
+        >
+          {usePassword ? 'Sign up with a passkey instead' : 'Use a password instead'}
+        </button>
+      )}
+
+      <p className="mt-6 text-center text-sm text-gray-600">
+        Already have an account?{' '}
+        <a href={`${import.meta.env.BASE_URL}signin`} className="font-medium text-gray-900 underline hover:text-gray-700">
+          Sign in
+        </a>
+      </p>
     </div>
   );
 }
