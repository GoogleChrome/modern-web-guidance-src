@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import type { RegistrationResponseJSON } from '@simplewebauthn/server';
+import { createPasskeyUser, findUserByUsername } from '../../../../lib/auth/store';
+import { reserveUsername } from '../../../../lib/auth/upstream';
+import { verifyRegistration } from '../../../../lib/auth/webauthn';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import {
+  consumeChallenge, error, json, readJSON, requireSession, startAuthenticatedSession,
+} from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJSON<{ response?: RegistrationResponseJSON }>(request);
+  if (!body?.response?.id) return error(400, 'invalid_request', 'Missing passkey response.');
+
+  const s = requireSession(session);
+  const pending = await consumeChallenge(s, 'signup');
+  if (!pending?.pendingUser) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+  const { id, username } = pending.pendingUser;
+
+  let passkey;
+  try {
+    passkey = await verifyRegistration(url, body.response, pending.challenge);
+  } catch (err) {
+    console.warn('Passkey sign-up failed', err);
+  }
+  if (!passkey) return error(400, 'verification_failed', 'We couldn’t verify that passkey. Please try again.');
+
+  // If the account can't be created, the client signals the provider to drop the orphaned passkey.
+  const orphan = { credentialId: passkey.id, rpID: getRelyingParty(url).rpID };
+
+  if (await findUserByUsername(username)) {
+    return error(409, 'username_taken', 'That username is already taken.', orphan);
+  }
+  const reserved = await reserveUsername(username);
+  if (!reserved.ok) {
+    return reserved.status === 502
+      ? error(502, 'upstream_unavailable', 'We couldn’t create your account right now. Please try again later.', orphan)
+      : error(409, reserved.error ?? 'username_taken', `Registration failed: ${reserved.error}`, orphan);
+  }
+
+  try {
+    await createPasskeyUser(id, username, passkey);
+  } catch {
+    return error(409, 'username_taken', 'That username is already taken.', orphan);
+  }
+
+  await startAuthenticatedSession(s, id);
+  return json({ user: { username } });
+};
