+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { accountSnapshot, getCurrentUser } from '../lib/auth/session';
+import { getRelyingParty } from '../lib/auth/config';
+
+const current = await getCurrentUser(Astro.session);
+if (!current) {
+  const next = `${import.meta.env.BASE_URL}account`;
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin?next=${encodeURIComponent(next)}`);
+}
+
+Astro.response.headers.set('Cache-Control', 'no-store');
+const account = await accountSnapshot(current.user, current.auth);
+const { rpID } = getRelyingParty(Astro.url);
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings client:load initialAccount={account} rpID={rpID} />
+  </div>
+</Layout>
