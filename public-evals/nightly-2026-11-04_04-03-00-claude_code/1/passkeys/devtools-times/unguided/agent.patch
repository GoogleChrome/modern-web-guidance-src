@@ -0,0 +1,30 @@
+/**
+ * Relying Party (RP) configuration for WebAuthn / passkeys.
+ *
+ * By default the RP ID and origin are derived from the incoming request URL
+ * (Astro resolves X-Forwarded-* headers against `security.allowedDomains`),
+ * so the app works on localhost and on every allowed production host.
+ * Set `PASSKEY_RP_ID` / `PASSKEY_ORIGIN` to pin them explicitly.
+ */
+export const RP_NAME = 'The DevTools Times';
+
+/** The upstream account service that owns usernames and passwords. */
+export const ACCOUNT_API_BASE =
+  process.env.ACCOUNT_API_BASE ??
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+/** How long a sign-in or reauthentication counts as "recent" for sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export function getRelyingParty(url: URL): { rpID: string; origin: string } {
+  return {
+    rpID: process.env.PASSKEY_RP_ID ?? url.hostname,
+    origin: process.env.PASSKEY_ORIGIN ?? url.origin,
+  };
+}
+
+/** Usernames accepted for passkey-only accounts. */
+export const USERNAME_PATTERN = /^[A-Za-z0-9._-]{3,32}$/;
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..2d4da79
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,114 @@
+import type { AstroSession } from 'astro';
+import { CHALLENGE_TTL_MS, REAUTH_WINDOW_MS } from './config';
+import { findUserById, listPasskeys, type PasskeyRecord, type UserRecord } from './store';
+import { providerName } from './aaguid';
+
+type Session = AstroSession;
+
+export type ChallengePurpose = 'signin' | 'reauth' | 'register' | 'signup';
+
+export interface PendingChallenge {
+  challenge: string;
+  purpose: ChallengePurpose;
+  expiresAt: number;
+  /** For passkey sign-up: the account being created. */
+  pendingUser?: { id: string; username: string };
+}
+
+export interface AuthState {
+  userId: string;
+  /** Last time the user proved possession of a credential (sign-in or reauth). */
+  verifiedAt: number;
+}
+
+export function requireSession(session: AstroSession | undefined): Session {
+  if (!session) throw new Error('Sessions are not configured');
+  return session;
+}
+
+export async function getCurrentUser(session: AstroSession | undefined): Promise<{ user: UserRecord; auth: AuthState } | null> {
+  const auth = (await session?.get('auth')) as AuthState | undefined;
+  if (!auth) return null;
+  const user = await findUserById(auth.userId);
+  return user ? { user, auth } : null;
+}
+
+/** Starts a fresh authenticated session (rotating the session ID to prevent fixation). */
+export async function startAuthenticatedSession(session: Session, userId: string) {
+  await session.regenerate();
+  session.set('auth', { userId, verifiedAt: Date.now() } satisfies AuthState);
+}
+
+export function markReauthenticated(session: Session, userId: string): AuthState {
+  const auth: AuthState = { userId, verifiedAt: Date.now() };
+  session.set('auth', auth);
+  return auth;
+}
+
+export function isRecentlyVerified(auth: AuthState) {
+  return Date.now() - auth.verifiedAt < REAUTH_WINDOW_MS;
+}
+
+export function reauthDeadline(auth: AuthState) {
+  return auth.verifiedAt + REAUTH_WINDOW_MS;
+}
+
+export function saveChallenge(session: Session, data: Omit<PendingChallenge, 'expiresAt'>) {
+  session.set('webauthnChallenge', { ...data, expiresAt: Date.now() + CHALLENGE_TTL_MS } satisfies PendingChallenge);
+}
+
+/** Reads and invalidates the pending challenge; challenges are single use. */
+export async function consumeChallenge(session: Session, purpose: ChallengePurpose): Promise<PendingChallenge | null> {
+  const pending = (await session.get('webauthnChallenge')) as PendingChallenge | undefined;
+  session.delete('webauthnChallenge');
+  if (!pending || pending.purpose !== purpose || pending.expiresAt < Date.now()) return null;
+  return pending;
+}
+
+export function serializePasskey(p: PasskeyRecord) {
+  return {
+    id: p.id,
+    name: p.name,
+    provider: providerName(p.aaguid),
+    synced: p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export type PasskeySummary = ReturnType<typeof serializePasskey>;
+
+export async function accountSnapshot(user: UserRecord, auth: AuthState) {
+  const passkeys = await listPasskeys(user.id);
+  return {
+    user: { id: user.id, username: user.username, hasPassword: user.hasPassword },
+    passkeys: passkeys.map(serializePasskey),
+    reauthUntil: reauthDeadline(auth),
+  };
+}
+
+export type AccountSnapshot = Awaited<ReturnType<typeof accountSnapshot>>;
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function error(status: number, code: string, message: string, extra: Record<string, unknown> = {}) {
+  return json({ error: { code, message, ...extra } }, status);
+}
+
+export const unauthenticated = () => error(401, 'unauthenticated', 'Please sign in to continue.');
+export const reauthRequired = () =>
+  error(403, 'reauth_required', 'Please confirm it’s you before making this change.');
+
+export async function readJSON<T = any>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..e7384e8
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,147 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+/**
+ * Minimal persistent store for local account records and passkeys.
+ *
+ * Usernames and passwords live in the upstream account service; this store
+ * keeps the WebAuthn user handle and the passkeys registered for each user.
+ * Data is written atomically to a JSON file (`PASSKEY_DATA_DIR`, default `.data/`).
+ */
+
+export interface UserRecord {
+  /** Opaque, random WebAuthn user handle (base64url). Never contains PII. */
+  id: string;
+  username: string;
+  /** False for accounts created with a passkey only. */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface PasskeyRecord {
+  /** Credential ID (base64url). */
+  id: string;
+  userId: string;
+  /** COSE public key (base64url). */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  aaguid: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Data {
+  users: UserRecord[];
+  passkeys: PasskeyRecord[];
+}
+
+const DATA_DIR = process.env.PASSKEY_DATA_DIR ?? path.join(process.cwd(), '.data');
+const DATA_FILE = path.join(DATA_DIR, 'accounts.json');
+
+let cache: Data | null = null;
+// Serialise all mutations so concurrent requests never clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Data> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as Data;
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: [], passkeys: [] };
+  }
+  return cache;
+}
+
+async function persist(data: Data) {
+  await mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(data, null, 2));
+  await rename(tmp, DATA_FILE);
+}
+
+function mutate<T>(fn: (data: Data) => T): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await load();
+    const result = fn(data);
+    await persist(data);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export function newUserHandle(): string {
+  return randomBytes(32).toString('base64url');
+}
+
+export async function findUserById(id: string) {
+  return (await load()).users.find((u) => u.id === id) ?? null;
+}
+
+export async function findUserByUsername(username: string) {
+  return (await load()).users.find((u) => u.username === username) ?? null;
+}
+
+/** Returns the local record for an upstream account, creating it on first use. */
+export function upsertPasswordUser(username: string): Promise<UserRecord> {
+  return mutate((data) => {
+    let user = data.users.find((u) => u.username === username);
+    if (!user) {
+      user = { id: newUserHandle(), username, hasPassword: true, createdAt: new Date().toISOString() };
+      data.users.push(user);
+    } else {
+      user.hasPassword = true;
+    }
+    return { ...user };
+  });
+}
+
+export function createPasskeyUser(id: string, username: string, passkey: Omit<PasskeyRecord, 'userId'>) {
+  return mutate((data) => {
+    if (data.users.some((u) => u.username === username || u.id === id)) {
+      throw new Error('USERNAME_TAKEN');
+    }
+    const user: UserRecord = { id, username, hasPassword: false, createdAt: new Date().toISOString() };
+    data.users.push(user);
+    data.passkeys.push({ ...passkey, userId: id });
+    return { ...user };
+  });
+}
+
+export async function listPasskeys(userId: string) {
+  return (await load()).passkeys.filter((p) => p.userId === userId);
+}
+
+export async function findPasskey(id: string) {
+  return (await load()).passkeys.find((p) => p.id === id) ?? null;
+}
+
+export function addPasskey(passkey: PasskeyRecord) {
+  return mutate((data) => {
+    if (data.passkeys.some((p) => p.id === passkey.id)) throw new Error('CREDENTIAL_EXISTS');
+    data.passkeys.push(passkey);
+  });
+}
+
+export function updatePasskey(id: string, userId: string, patch: Partial<Pick<PasskeyRecord, 'name' | 'counter' | 'backedUp' | 'lastUsedAt'>>) {
+  return mutate((data) => {
+    const passkey = data.passkeys.find((p) => p.id === id && p.userId === userId);
+    if (!passkey) return null;
+    Object.assign(passkey, patch);
+    return { ...passkey };
+  });
+}
+
+export function deletePasskey(id: string, userId: string) {
+  return mutate((data) => {
+    const before = data.passkeys.length;
+    data.passkeys = data.passkeys.filter((p) => !(p.id === id && p.userId === userId));
+    return data.passkeys.length !== before;
+  });
+}
diff --git a/src/lib/auth/upstream.ts b/src/lib/auth/upstream.ts
new file mode 100644
index 0000000..38067e6
--- /dev/null
+++ b/src/lib/auth/upstream.ts
@@ -0,0 +1,37 @@
+import { randomBytes } from 'node:crypto';
+import { ACCOUNT_API_BASE } from './config';
+
+export interface UpstreamResult {
+  ok: boolean;
+  status: number;
+  /** Upstream error code (e.g. APP_ERR_2001), if any. */
+  error?: string;
+  data: any;
+}
+
+async function call(endpoint: 'login' | 'register', username: string, password: string): Promise<UpstreamResult> {
+  try {
+    const res = await fetch(`${ACCOUNT_API_BASE}/${endpoint}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(10_000),
+    });
+    const data = await res.json().catch(() => ({}));
+    return { ok: res.ok, status: res.status, error: res.ok ? undefined : data?.error ?? 'Unknown error', data };
+  } catch {
+    return { ok: false, status: 502, error: 'UPSTREAM_UNAVAILABLE', data: null };
+  }
+}
+
+export const upstreamLogin = (username: string, password: string) => call('login', username, password);
+export const upstreamRegister = (username: string, password: string) => call('register', username, password);
+
+/**
+ * Reserves a username in the upstream account service for a passkey-only
+ * account, so usernames stay unique across password and passkey accounts.
+ * The random password is discarded: nobody can sign in with it.
+ */
+export function reserveUsername(username: string) {
+  return upstreamRegister(username, `pk-${randomBytes(24).toString('base64url')}-9`);
+}
diff --git a/src/lib/auth/webauthn.ts b/src/lib/auth/webauthn.ts
new file mode 100644
index 0000000..368e7f4
--- /dev/null
+++ b/src/lib/auth/webauthn.ts
@@ -0,0 +1,95 @@
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+  type AuthenticationResponseJSON,
+  type RegistrationResponseJSON,
+} from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { RP_NAME, getRelyingParty } from './config';
+import { providerName } from './aaguid';
+import type { PasskeyRecord } from './store';
+
+export async function buildRegistrationOptions(
+  url: URL,
+  user: { id: string; username: string },
+  existing: PasskeyRecord[],
+) {
+  const { rpID } = getRelyingParty(url);
+  return generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: isoBase64URL.toBuffer(user.id),
+    userName: user.username,
+    userDisplayName: user.username,
+    attestationType: 'none',
+    // Prevent registering a second passkey for this account in the same provider.
+    excludeCredentials: existing.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+}
+
+/** Verifies an attestation and returns a passkey record ready to store (without userId). */
+export async function verifyRegistration(url: URL, response: RegistrationResponseJSON, expectedChallenge: string) {
+  const { rpID, origin } = getRelyingParty(url);
+  const { verified, registrationInfo } = await verifyRegistrationResponse({
+    response,
+    expectedChallenge,
+    expectedOrigin: origin,
+    expectedRPID: rpID,
+    requireUserVerification: false,
+  });
+  if (!verified) return null;
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = registrationInfo;
+  const now = new Date().toISOString();
+  const passkey: Omit<PasskeyRecord, 'userId'> = {
+    id: credential.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports ?? response.response.transports ?? [],
+    aaguid,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    name: providerName(aaguid) ?? (credentialDeviceType === 'multiDevice' ? 'Synced passkey' : 'Passkey'),
+    createdAt: now,
+    lastUsedAt: now,
+  };
+  return passkey;
+}
+
+export async function buildAuthenticationOptions(url: URL, allow?: PasskeyRecord[]) {
+  const { rpID } = getRelyingParty(url);
+  return generateAuthenticationOptions({
+    rpID,
+    userVerification: 'preferred',
+    allowCredentials: allow?.map((p) => ({ id: p.id, transports: p.transports })),
+  });
+}
+
+export async function verifyAuthentication(
+  url: URL,
+  response: AuthenticationResponseJSON,
+  expectedChallenge: string,
+  passkey: PasskeyRecord,
+) {
+  const { rpID, origin } = getRelyingParty(url);
+  const { verified, authenticationInfo } = await verifyAuthenticationResponse({
+    response,
+    expectedChallenge,
+    expectedOrigin: origin,
+    expectedRPID: rpID,
+    requireUserVerification: false,
+    credential: {
+      id: passkey.id,
+      publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+      counter: passkey.counter,
+      transports: passkey.transports,
+    },
+  });
+  return verified ? authenticationInfo : null;
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..084c9a8
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,169 @@
+/**
+ * Browser-side helpers for passkey ceremonies against the /api/auth endpoints.
+ */
+import {
+  WebAuthnAbortService,
+  WebAuthnError,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  getBrowserCapabilities,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+} from '@simplewebauthn/browser';
+
+const API = `${import.meta.env.BASE_URL}api/auth`;
+
+export class ApiError extends Error {
+  constructor(public status: number, public code: string, message: string, public details: Record<string, any> = {}) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const res = await fetch(`${API}/${path}`, {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: init.body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+    credentials: 'same-origin',
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    const { code = 'unknown_error', message = 'Something went wrong. Please try again.', ...details } = data?.error ?? {};
+    throw new ApiError(res.status, code, message, details);
+  }
+  return data as T;
+}
+
+/** True when the browser can create and use passkeys at all. */
+export function supportsPasskeys() {
+  return typeof window !== 'undefined' && browserSupportsWebAuthn();
+}
+
+export { browserSupportsWebAuthnAutofill as supportsPasskeyAutofill };
+
+export async function supportsConditionalCreate() {
+  if (!supportsPasskeys()) return false;
+  try {
+    return (await getBrowserCapabilities()).conditionalCreate === 'supported';
+  } catch {
+    return false;
+  }
+}
+
+export function cancelPasskeyCeremony() {
+  WebAuthnAbortService.cancelCeremony();
+}
+
+/** True for errors the user caused deliberately (cancel, dismiss) or that we triggered (abort). */
+export function isSilentError(err: unknown) {
+  return (
+    (err instanceof WebAuthnError && err.code === 'ERROR_CEREMONY_ABORTED') ||
+    (err instanceof Error && (err.name === 'AbortError' || err.name === 'NotAllowedError'))
+  );
+}
+
+/** Turns API and WebAuthn errors into a message suitable for the UI. */
+export function describeError(err: unknown): string {
+  if (err instanceof ApiError) return err.message;
+  if (err instanceof WebAuthnError) {
+    switch (err.code) {
+      case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+        return 'You already have a passkey for this account in this password manager or device.';
+      case 'ERROR_CEREMONY_ABORTED':
+        return 'The passkey request was cancelled.';
+      case 'ERROR_INVALID_DOMAIN':
+      case 'ERROR_INVALID_RP_ID':
+        return 'Passkeys aren’t available on this domain.';
+      case 'ERROR_AUTHENTICATOR_MISSING_DISCOVERABLE_CREDENTIAL_SUPPORT':
+        return 'This security key can’t store passkeys. Try another device or password manager.';
+    }
+  }
+  if (err instanceof Error && err.name === 'NotAllowedError') {
+    return 'The passkey request was cancelled or timed out.';
+  }
+  return 'Something went wrong with your passkey. Please try again.';
+}
+
+/** Best-effort WebAuthn Signal API call; silently ignored where unsupported. */
+async function signal(opts: Parameters<typeof sendSignal>[0]) {
+  try {
+    await sendSignal(opts);
+  } catch {
+    /* unsupported or rejected: signals are fire-and-forget */
+  }
+}
+
+/** If the server reports a credential it doesn't know, tell the passkey provider so it stops offering it. */
+async function handleOrphanedCredential(err: unknown) {
+  if (err instanceof ApiError && err.details.credentialId && err.details.rpID) {
+    await signal({ signalName: 'unknownCredential', rpID: err.details.rpID, credentialID: err.details.credentialId });
+  }
+}
+
+export function signalAcceptedCredentials(rpID: string, userID: string, credentialIDs: string[]) {
+  return signal({ signalName: 'allAcceptedCredentials', rpID, userID, allAcceptedCredentialIDs: credentialIDs });
+}
+
+export function signalUserDetails(rpID: string, userID: string, userName: string) {
+  return signal({ signalName: 'currentUserDetails', rpID, userID, userName, userDisplayName: userName });
+}
+
+/** Signs in with a discoverable passkey. Pass `autofill` to use conditional mediation (username field autofill). */
+export async function signInWithPasskey({ autofill = false } = {}) {
+  const optionsJSON = await api('passkey/authenticate-options', { body: { purpose: 'signin' } });
+  const response = await startAuthentication({ optionsJSON, useBrowserAutofill: autofill });
+  try {
+    return await api<{ user: { username: string } }>('passkey/authenticate-verify', { body: { purpose: 'signin', response } });
+  } catch (err) {
+    await handleOrphanedCredential(err);
+    throw err;
+  }
+}
+
+/** Re-verifies the signed-in user with one of their passkeys. Returns the new reauth deadline (ms). */
+export async function reauthenticateWithPasskey() {
+  const optionsJSON = await api('passkey/authenticate-options', { body: { purpose: 'reauth' } });
+  const response = await startAuthentication({ optionsJSON });
+  try {
+    return await api<{ reauthUntil: number }>('passkey/authenticate-verify', { body: { purpose: 'reauth', response } });
+  } catch (err) {
+    await handleOrphanedCredential(err);
+    throw err;
+  }
+}
+
+export function reauthenticateWithPassword(password: string) {
+  return api<{ reauthUntil: number }>('reauth-password', { body: { password } });
+}
+
+/**
+ * Adds a passkey to the signed-in account.
+ * With `automatic`, uses conditional create so the password manager the user
+ * just signed in with can create the passkey without extra UI.
+ */
+export async function createPasskey({ automatic = false } = {}) {
+  const optionsJSON = await api('passkey/register-options', { body: {} });
+  const response = await startRegistration({ optionsJSON, useAutoRegister: automatic });
+  return api('passkey/register-verify', { body: { response } });
+}
+
+/** Creates a new passkey-only account. */
+export async function signUpWithPasskey(username: string) {
+  const optionsJSON = await api('passkey/signup-options', { body: { username } });
+  const response = await startRegistration({ optionsJSON });
+  try {
+    return await api<{ user: { username: string } }>('passkey/signup-verify', { body: { response } });
+  } catch (err) {
+    await handleOrphanedCredential(err);
+    throw err;
+  }
+}
+
+/** Where to go after signing in: a same-site `?next=` path, else the account page. */
+export function postSignInDestination() {
+  const base = import.meta.env.BASE_URL;
+  const next = new URLSearchParams(window.location.search).get('next');
+  if (next && next.startsWith(base) && !next.startsWith('//')) return next;
+  return `${base}account`;
+}
