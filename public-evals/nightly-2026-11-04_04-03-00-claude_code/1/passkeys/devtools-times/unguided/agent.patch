@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { upstreamLogin } from '../../../lib/auth/upstream';
+import {
+  error, getCurrentUser, json, markReauthenticated, readJSON, reauthDeadline, requireSession, unauthenticated,
+} from '../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const current = await getCurrentUser(session);
+  if (!current) return unauthenticated();
+  if (!current.user.hasPassword) return error(400, 'no_password', 'This account doesn’t have a password. Use a passkey instead.');
+
+  const body = await readJSON<{ password?: string }>(request);
+  if (!body?.password) return error(400, 'invalid_request', 'Password is required.');
+
+  const result = await upstreamLogin(current.user.username, body.password);
+  if (!result.ok) return error(result.status === 502 ? 502 : 401, result.error ?? 'login_failed', 'That password is incorrect.');
+
+  const auth = markReauthenticated(requireSession(session), current.user.id);
+  return json({ reauthUntil: reauthDeadline(auth) });
+};
