+import type { APIRoute } from 'astro';
+import { findUserByUsername, newUserHandle } from '../../../../lib/auth/store';
+import { buildRegistrationOptions } from '../../../../lib/auth/webauthn';
+import { error, json, readJSON, requireSession, saveChallenge } from '../../../../lib/auth/session';
+import { USERNAME_PATTERN } from '../../../../lib/auth/config';
+
+/** Options for creating a brand-new account that signs in with a passkey (no password). */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJSON<{ username?: string }>(request);
+  const username = body?.username?.trim() ?? '';
+  if (!USERNAME_PATTERN.test(username)) {
+    return error(400, 'invalid_username', 'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.');
+  }
+  if (await findUserByUsername(username)) return error(409, 'username_taken', 'That username is already taken.');
+
+  const pendingUser = { id: newUserHandle(), username };
+  const options = await buildRegistrationOptions(url, pendingUser, []);
+  saveChallenge(requireSession(session), { challenge: options.challenge, purpose: 'signup', pendingUser });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/signup-verify.ts b/src/pages/api/auth/passkey/signup-verify.ts
