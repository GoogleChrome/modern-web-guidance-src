diff --git a/account.js b/account.js
new file mode 100644
index 0000000..ff2a9cc
--- /dev/null
+++ b/account.js
@@ -0,0 +1,676 @@
+/**
+ * The Daily Grind — "My Account" passkey client.
+ *
+ * Calls the native WebAuthn APIs directly. All options generation and
+ * signature verification happens on the server (use a vetted FIDO2 library,
+ * e.g. SimpleWebAuthn). Server contract expected by this module (JSON bodies,
+ * cookie session, same origin):
+ *
+ *   GET    /api/session                      -> 200 { rpId, user: { id, name, displayName, hasPassword } } | 401
+ *   POST   /api/signup   { name, displayName, password } -> 200 session payload (signs the customer in)
+ *   POST   /api/signin   { name, password }   -> 200 session payload | 401
+ *   POST   /api/signout                       -> 204
+ *
+ *   POST   /api/passkeys/register/options { promotion, conditional } -> PublicKeyCredentialCreationOptionsJSON
+ *          (residentKey "required", excludeCredentials = user's passkeys,
+ *           authenticatorAttachment "platform" only when promotion=true)
+ *   POST   /api/passkeys/register/verify  <RegistrationResponseJSON>  -> 200 | 4xx
+ *          (stores aaguid + AAGUID-registry name/providerIcon; relaxes UP only for conditional=true)
+ *   POST   /api/passkeys/signin/options      -> PublicKeyCredentialRequestOptionsJSON (allowCredentials: [])
+ *   POST   /api/passkeys/signin/verify  <AuthenticationResponseJSON> -> 200 session payload | 404 unknown credential
+ *   POST   /api/passkeys/reauth/options      -> request options, allowCredentials = signed-in user's passkeys
+ *   POST   /api/passkeys/reauth/verify       -> 200 | 404 | 403 (credential belongs to another user)
+ *   POST   /api/reauth/password { password }  -> 200 | 401   (for customers with no passkeys yet)
+ *
+ *   GET    /api/passkeys                     -> [{ id, name, providerIcon?, registeredAt, lastUsedAt?, credentialBackedUp }]
+ *   PATCH  /api/passkeys/:id { name }        -> 200
+ *   DELETE /api/passkeys/:id                 -> 200 (requires a recent reauthentication)
+ *   PUT    /api/user { name, displayName }   -> 200 { id, name, displayName } (requires a recent reauthentication)
+ *
+ * The server MUST enforce the "recent reauthentication" requirement itself;
+ * the client-side prompt is only the UX for obtaining it.
+ */
+
+// ---------------------------------------------------------------------------
+// Feature detection + polyfill
+// ---------------------------------------------------------------------------
+
+const webauthnAvailable = 'PublicKeyCredential' in window;
+
+if (
+  webauthnAvailable &&
+  (!PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.prototype.toJSON)
+) {
+  try {
+    await import('https://unpkg.com/webauthn-polyfills');
+  } catch (e) {
+    console.error('Failed to load webauthn-polyfills:', e);
+  }
+}
+
+if (!('commandForElement' in HTMLButtonElement.prototype)) {
+  import('https://unpkg.com/invokers-polyfill').catch((e) => console.error('Failed to load invokers-polyfill:', e));
+}
+
+const capabilities =
+  webauthnAvailable && PublicKeyCredential.getClientCapabilities
+    ? await PublicKeyCredential.getClientCapabilities().catch(() => ({}))
+    : {};
+
+/** Passkey creation is offered only where platform passkeys + autofill exist. */
+const canCreatePasskeys =
+  capabilities.passkeyPlatformAuthenticator === true && capabilities.conditionalGet === true;
+
+// ---------------------------------------------------------------------------
+// API helpers
+// ---------------------------------------------------------------------------
+
+class ApiError extends Error {
+  constructor(response, body) {
+    super(body?.error || `Request failed (${response.status})`);
+    this.status = response.status;
+  }
+}
+
+async function api(path, { method = 'GET', body } = {}) {
+  const response = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const text = await response.text();
+  const data = text ? JSON.parse(text) : null;
+  if (!response.ok) throw new ApiError(response, data);
+  return data;
+}
+
+// ---------------------------------------------------------------------------
+// State + DOM
+// ---------------------------------------------------------------------------
+
+let session = null; // { rpId, user }
+let passkeys = [];
+let autofillController = new AbortController();
+
+const $ = (id) => document.getElementById(id);
+const accountDialog = $('account-dialog');
+const views = {
+  signin: $('view-signin'),
+  signup: $('view-signup'),
+  promo: $('view-promo'),
+  account: $('view-account'),
+};
+
+const rpId = () => session?.rpId ?? location.hostname;
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+function showView(name) {
+  for (const [key, el] of Object.entries(views)) el.hidden = key !== name;
+  const heading = {
+    signin: 'Sign in',
+    signup: 'Create your account',
+    promo: 'Faster sign-ins with passkeys',
+    account: 'My Account',
+  }[name];
+  $('account-title').textContent = heading;
+}
+
+function setStatus(el, message, tone = 'info') {
+  el.textContent = message;
+  el.dataset.tone = tone;
+}
+
+function setBusy(form, busy) {
+  for (const control of form.querySelectorAll('button, input')) control.disabled = busy;
+}
+
+function webauthnErrorMessage(err, action) {
+  switch (err.name) {
+    case 'NotAllowedError':
+      return `${action} was cancelled.`;
+    case 'InvalidStateError':
+      return 'A passkey for this account already exists in this passkey provider.';
+    case 'SecurityError':
+      return 'Passkeys are misconfigured for this site. Please try again later.';
+    case 'AbortError':
+      return '';
+    default:
+      return err.message || `${action} failed.`;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Signal API helpers (progressive enhancement; Base64URL strings only)
+// ---------------------------------------------------------------------------
+
+async function signalUnknownCredential(credentialId) {
+  if (!webauthnAvailable || !PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId: rpId(), credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed:', e);
+  }
+}
+
+async function signalAllAcceptedCredentials() {
+  if (!session || !webauthnAvailable || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: rpId(),
+      userId: session.user.id,
+      allAcceptedCredentialIds: passkeys.map((p) => p.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+async function signalCurrentUserDetails() {
+  if (!session || !webauthnAvailable || !PublicKeyCredential.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: rpId(),
+      userId: session.user.id,
+      name: session.user.name,
+      displayName: session.user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Session handling
+// ---------------------------------------------------------------------------
+
+function applySession(next) {
+  session = next;
+  document.documentElement.dataset.auth = session ? 'signed-in' : 'signed-out';
+  $('nav-account-label').textContent = session
+    ? `Hi, ${session.user.displayName || session.user.name}`
+    : 'My Account';
+}
+
+async function loadSession() {
+  try {
+    applySession(await api('/api/session'));
+  } catch {
+    applySession(null);
+  }
+}
+
+async function enterAccount(nextSession) {
+  autofillController.abort();
+  applySession(nextSession);
+  showView('account');
+  await renderAccount();
+}
+
+async function signOut() {
+  try {
+    await api('/api/signout', { method: 'POST' });
+  } catch (e) {
+    console.error('Sign out failed:', e);
+  }
+  applySession(null);
+  passkeys = [];
+  showView('signin');
+  startConditionalPasskeySignIn();
+}
+
+// ---------------------------------------------------------------------------
+// Passkey sign-in (conditional mediation + explicit button)
+// ---------------------------------------------------------------------------
+
+async function verifyPasskeySignIn(credential, statusEl) {
+  const encoded = credential.toJSON();
+  try {
+    const nextSession = await api('/api/passkeys/signin/verify', { method: 'POST', body: encoded });
+    await enterAccount(nextSession);
+  } catch (err) {
+    if (err instanceof ApiError && err.status === 404) {
+      // Pre-authentication: the credential is unknown to the server, so ask
+      // the passkey provider to hide/remove it.
+      await signalUnknownCredential(encoded.id);
+      setStatus(statusEl, 'That passkey is no longer registered with The Daily Grind. Sign in with your password instead.', 'error');
+    } else {
+      setStatus(statusEl, 'We couldn’t verify your passkey. Please try again.', 'error');
+    }
+  }
+}
+
+async function startConditionalPasskeySignIn() {
+  if (session || capabilities.conditionalGet !== true) return;
+  autofillController.abort();
+  autofillController = new AbortController();
+  const { signal } = autofillController;
+  try {
+    const optionsJSON = await api('/api/passkeys/signin/options', { method: 'POST' });
+    if (signal.aborted) return;
+    const credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON),
+      mediation: 'conditional',
+      signal,
+    });
+    if (credential) await verifyPasskeySignIn(credential, $('signin-status'));
+  } catch (err) {
+    if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+    console.error('Conditional passkey sign-in failed:', err);
+  }
+}
+
+async function passkeyButtonSignIn() {
+  const statusEl = $('signin-status');
+  autofillController.abort();
+  autofillController = new AbortController();
+  setStatus(statusEl, '');
+
+  let credential;
+  try {
+    const optionsJSON = await api('/api/passkeys/signin/options', { method: 'POST' });
+    credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON),
+      signal: autofillController.signal,
+    });
+  } catch (err) {
+    const message = err instanceof ApiError ? err.message : webauthnErrorMessage(err, 'Passkey sign-in');
+    if (message) setStatus(statusEl, message, err.name === 'NotAllowedError' ? 'info' : 'error');
+    startConditionalPasskeySignIn(); // re-arm autofill after a cancelled prompt
+    return;
+  }
+  await verifyPasskeySignIn(credential, statusEl);
+}
+
+// ---------------------------------------------------------------------------
+// Passkey registration
+// ---------------------------------------------------------------------------
+
+/**
+ * @param {{ promotion?: boolean, conditional?: boolean }} opts
+ * @returns {Promise<{ ok: boolean, message?: string }>}
+ */
+async function registerPasskey({ promotion = false, conditional = false } = {}) {
+  let credential;
+  try {
+    const optionsJSON = await api('/api/passkeys/register/options', {
+      method: 'POST',
+      body: { promotion, conditional },
+    });
+    credential = await navigator.credentials.create({
+      publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON),
+      ...(conditional && { mediation: 'conditional' }),
+    });
+  } catch (err) {
+    if (conditional) return { ok: false }; // silent by design
+    if (err instanceof ApiError) return { ok: false, message: err.message };
+    return { ok: false, message: webauthnErrorMessage(err, 'Passkey creation') };
+  }
+  if (!credential) return { ok: false };
+
+  const encoded = credential.toJSON();
+  try {
+    await api('/api/passkeys/register/verify', { method: 'POST', body: encoded });
+    return { ok: true };
+  } catch (err) {
+    // The provider saved a credential the server rejected — clean up the orphan.
+    await signalUnknownCredential(encoded.id);
+    return { ok: false, message: conditional ? undefined : 'We couldn’t save your passkey. Please try again.' };
+  }
+}
+
+/** Silent post-password-sign-in passkey creation (Conditional Create). */
+async function tryConditionalCreate() {
+  if (capabilities.conditionalCreate !== true) return false;
+  autofillController.abort();
+  const { ok } = await registerPasskey({ promotion: true, conditional: true });
+  return ok;
+}
+
+// ---------------------------------------------------------------------------
+// Reauthentication
+// ---------------------------------------------------------------------------
+
+const reauthDialog = $('reauth-dialog');
+let reauthResolve = null;
+
+/** Prompts the signed-in customer to re-verify. Resolves true on success. */
+function requireReauth(reason) {
+  const usePasskey = passkeys.length > 0 && webauthnAvailable;
+  $('reauth-reason').textContent = reason;
+  $('reauth-passkey').hidden = !usePasskey;
+  $('reauth-password-form').hidden = usePasskey || session?.user.hasPassword === false;
+  $('reauth-use-password').hidden = !usePasskey || session?.user.hasPassword === false;
+  setStatus($('reauth-status'), '');
+  $('reauth-password-form').reset();
+  reauthDialog.returnValue = '';
+  reauthDialog.showModal();
+  return new Promise((resolve) => {
+    reauthResolve = resolve;
+  });
+}
+
+function finishReauth(ok) {
+  reauthDialog.returnValue = ok ? 'verified' : '';
+  reauthDialog.close();
+}
+
+reauthDialog.addEventListener('close', () => {
+  reauthResolve?.(reauthDialog.returnValue === 'verified');
+  reauthResolve = null;
+  reauthDialog.returnValue = '';
+});
+
+$('reauth-passkey-button').addEventListener('click', async () => {
+  const statusEl = $('reauth-status');
+  setStatus(statusEl, '');
+  try {
+    const optionsJSON = await api('/api/passkeys/reauth/options', { method: 'POST' });
+    const credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON),
+    });
+    const encoded = credential.toJSON();
+    try {
+      await api('/api/passkeys/reauth/verify', { method: 'POST', body: encoded });
+      finishReauth(true);
+    } catch (err) {
+      if (err instanceof ApiError && err.status === 404) await signalUnknownCredential(encoded.id);
+      setStatus(statusEl, err.status === 403 ? 'That passkey belongs to a different account.' : 'We couldn’t verify that passkey.', 'error');
+    }
+  } catch (err) {
+    const message = err instanceof ApiError ? err.message : webauthnErrorMessage(err, 'Verification');
+    if (message) setStatus(statusEl, message, err.name === 'NotAllowedError' ? 'info' : 'error');
+  }
+});
+
+$('reauth-use-password').addEventListener('click', () => {
+  $('reauth-password-form').hidden = false;
+  $('reauth-use-password').hidden = true;
+  $('reauth-password').focus();
+});
+
+$('reauth-password-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  setBusy(form, true);
+  try {
+    await api('/api/reauth/password', { method: 'POST', body: { password: form.password.value } });
+    finishReauth(true);
+  } catch {
+    setStatus($('reauth-status'), 'That password isn’t right.', 'error');
+  } finally {
+    setBusy(form, false);
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Account view: profile + passkey management
+// ---------------------------------------------------------------------------
+
+async function renderAccount() {
+  const profileForm = $('profile-form');
+  profileForm.displayName.value = session.user.displayName ?? '';
+  profileForm.name.value = session.user.name ?? '';
+  setStatus($('profile-status'), '');
+  setStatus($('passkeys-status'), '');
+
+  $('create-passkey').hidden = !canCreatePasskeys;
+  $('passkeys-unsupported').hidden = canCreatePasskeys;
+
+  await refreshPasskeys();
+  // Keep password managers in sync with the server's list on every load.
+  await signalAllAcceptedCredentials();
+}
+
+async function refreshPasskeys() {
+  try {
+    passkeys = await api('/api/passkeys');
+  } catch (err) {
+    passkeys = [];
+    setStatus($('passkeys-status'), 'We couldn’t load your passkeys.', 'error');
+  }
+  renderPasskeyList();
+}
+
+function formatDate(epoch) {
+  return epoch ? dateFormat.format(new Date(epoch)) : null;
+}
+
+function renderPasskeyList() {
+  const list = $('passkey-list');
+  const template = $('passkey-row');
+  list.replaceChildren();
+  $('passkeys-empty').hidden = passkeys.length > 0;
+
+  for (const passkey of passkeys) {
+    const row = template.content.firstElementChild.cloneNode(true);
+    const icon = row.querySelector('.passkey-icon');
+    if (passkey.providerIcon) {
+      icon.src = passkey.providerIcon;
+    } else {
+      icon.replaceWith($('generic-key-icon').content.firstElementChild.cloneNode(true));
+    }
+    row.querySelector('.passkey-name').textContent = passkey.name || 'Passkey';
+    const registered = row.querySelector('.passkey-registered');
+    registered.textContent = `Created ${formatDate(passkey.registeredAt)}`;
+    const lastUsed = row.querySelector('.passkey-last-used');
+    if (passkey.lastUsedAt) lastUsed.textContent = `Last used ${formatDate(passkey.lastUsedAt)}`;
+    else lastUsed.remove();
+    if (passkey.credentialBackedUp) row.querySelector('.passkey-synced').hidden = false;
+
+    const label = passkey.name || 'passkey';
+    const renameBtn = row.querySelector('[data-action="rename"]');
+    const deleteBtn = row.querySelector('[data-action="delete"]');
+    renameBtn.setAttribute('aria-label', `Rename ${label}`);
+    deleteBtn.setAttribute('aria-label', `Delete ${label}`);
+    renameBtn.addEventListener('click', () => openRename(passkey));
+    deleteBtn.addEventListener('click', () => deletePasskey(passkey));
+    list.append(row);
+  }
+}
+
+// Rename (server-side label only — no Signal API call needed)
+const renameDialog = $('rename-dialog');
+let renameTarget = null;
+
+function openRename(passkey) {
+  renameTarget = passkey;
+  const form = $('rename-form');
+  form.passkeyName.value = passkey.name ?? '';
+  renameDialog.returnValue = '';
+  renameDialog.showModal();
+}
+
+$('rename-form').addEventListener('submit', async (event) => {
+  if (event.submitter?.value !== 'save') return; // Cancel closes via method=dialog
+  event.preventDefault();
+  const form = event.currentTarget;
+  const name = form.passkeyName.value.trim();
+  setBusy(form, true);
+  try {
+    await api(`/api/passkeys/${encodeURIComponent(renameTarget.id)}`, { method: 'PATCH', body: { name } });
+    renameDialog.close('saved');
+    await refreshPasskeys();
+    setStatus($('passkeys-status'), 'Passkey renamed.', 'success');
+  } catch (err) {
+    setStatus($('passkeys-status'), err.message, 'error');
+    renameDialog.close();
+  } finally {
+    setBusy(form, false);
+  }
+});
+
+async function deletePasskey(passkey) {
+  const statusEl = $('passkeys-status');
+  const verified = await requireReauth(`Confirm it’s you to delete “${passkey.name || 'this passkey'}”.`);
+  if (!verified) return;
+  try {
+    await api(`/api/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+    await refreshPasskeys();
+    await signalAllAcceptedCredentials();
+    setStatus(statusEl, 'Passkey deleted. You may also remove it from your password manager.', 'success');
+  } catch (err) {
+    setStatus(statusEl, err.message, 'error');
+  }
+}
+
+$('create-passkey').addEventListener('click', async (event) => {
+  const button = event.currentTarget;
+  const statusEl = $('passkeys-status');
+  button.disabled = true;
+  setStatus(statusEl, '');
+  // Management flow: no authenticatorAttachment, so security keys work too.
+  const { ok, message } = await registerPasskey({ promotion: false });
+  button.disabled = false;
+  if (ok) {
+    await refreshPasskeys();
+    setStatus(statusEl, 'Passkey created. Next time, just use your fingerprint, face, or screen lock.', 'success');
+  } else if (message) {
+    setStatus(statusEl, message, 'error');
+  }
+});
+
+$('profile-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const statusEl = $('profile-status');
+  const name = form.name.value.trim();
+  const displayName = form.displayName.value.trim();
+  if (name === session.user.name && displayName === session.user.displayName) {
+    setStatus(statusEl, 'No changes to save.');
+    return;
+  }
+  const verified = await requireReauth('Confirm it’s you to update your profile.');
+  if (!verified) return;
+  setBusy(form, true);
+  try {
+    const user = await api('/api/user', { method: 'PUT', body: { name, displayName } });
+    applySession({ ...session, user: { ...session.user, ...user } });
+    await signalCurrentUserDetails();
+    setStatus(statusEl, 'Profile updated.', 'success');
+  } catch (err) {
+    setStatus(statusEl, err.message, 'error');
+  } finally {
+    setBusy(form, false);
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Sign-in / sign-up forms
+// ---------------------------------------------------------------------------
+
+$('signin-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const statusEl = $('signin-status');
+  setBusy(form, true);
+  setStatus(statusEl, '');
+  try {
+    const nextSession = await api('/api/signin', {
+      method: 'POST',
+      body: { name: form.email.value.trim(), password: form.password.value },
+    });
+    form.reset();
+    await enterAccount(nextSession);
+    // Silently upgrade to a passkey right after a successful password sign-in.
+    tryConditionalCreate().then((created) => {
+      if (created) refreshPasskeys();
+    });
+  } catch (err) {
+    setStatus(statusEl, err.status === 401 ? 'Incorrect email or password.' : err.message, 'error');
+  } finally {
+    setBusy(form, false);
+  }
+});
+
+$('signin-passkey').addEventListener('click', passkeyButtonSignIn);
+
+$('signup-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const statusEl = $('signup-status');
+  setBusy(form, true);
+  setStatus(statusEl, '');
+  try {
+    const nextSession = await api('/api/signup', {
+      method: 'POST',
+      body: {
+        name: form.email.value.trim(),
+        displayName: form.fullName.value.trim(),
+        password: form.password.value,
+      },
+    });
+    autofillController.abort();
+    applySession(nextSession);
+    form.reset();
+    if (canCreatePasskeys) {
+      showView('promo');
+      setStatus($('promo-status'), '');
+    } else {
+      await enterAccount(nextSession);
+    }
+  } catch (err) {
+    setStatus(statusEl, err.status === 409 ? 'An account with that email already exists.' : err.message, 'error');
+  } finally {
+    setBusy(form, false);
+  }
+});
+
+$('promo-create').addEventListener('click', async (event) => {
+  const button = event.currentTarget;
+  button.disabled = true;
+  // Promotion flow: platform authenticator only.
+  const { ok, message } = await registerPasskey({ promotion: true });
+  button.disabled = false;
+  if (ok) {
+    await enterAccount(session);
+    setStatus($('passkeys-status'), 'You’re all set — your passkey is ready.', 'success');
+  } else if (message) {
+    setStatus($('promo-status'), message, 'error');
+  }
+});
+
+$('promo-skip').addEventListener('click', () => enterAccount(session));
+
+for (const link of document.querySelectorAll('[data-show-view]')) {
+  link.addEventListener('click', (event) => {
+    event.preventDefault();
+    showView(link.dataset.showView);
+  });
+}
+
+$('signout-button').addEventListener('click', signOut);
+$('nav-logout').addEventListener('click', async (event) => {
+  event.preventDefault();
+  await signOut();
+});
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+
+if (!webauthnAvailable || capabilities.conditionalGet !== true) {
+  // Keep password sign-in; hide the passkey button when WebAuthn is missing entirely.
+  $('signin-passkey').hidden = !webauthnAvailable;
+}
+
+accountDialog.addEventListener('close', () => {
+  accountDialog.returnValue = '';
+});
+
+await loadSession();
+if (session) {
+  showView('account');
+  renderAccount();
+} else {
+  showView('signin');
+  startConditionalPasskeySignIn();
+}
+
+// Open the panel directly when arriving at /account or #account.
+if (location.pathname === '/account' || location.hash === '#account') {
+  accountDialog.showModal();
+}
