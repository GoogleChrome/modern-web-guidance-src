@@ -0,0 +1,24 @@
+// Shows "Sign in" or "Logout" in the site navigation depending on the session.
+(() => {
+  const link = document.querySelector('[data-auth-link]');
+  if (!link) return;
+
+  function update(signedIn) {
+    link.textContent = signedIn ? 'Logout' : 'Sign in';
+    link.href = signedIn ? '/logout' : '/account';
+  }
+
+  link.addEventListener('click', async (event) => {
+    if (link.getAttribute('href') !== '/logout') return;
+    event.preventDefault();
+    await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
+    location.assign(location.pathname === '/account' ? '/account' : '/');
+  });
+
+  document.addEventListener('dg:auth-changed', (event) => update(event.detail.signedIn));
+
+  fetch('/api/session', { credentials: 'same-origin' })
+    .then((res) => (res.ok ? res.json() : null))
+    .then((session) => session && update(Boolean(session.user)))
+    .catch(() => {});
+})();
diff --git a/public/js/webauthn.js b/public/js/webauthn.js
new file mode 100644
index 0000000..b1137bd
--- /dev/null
+++ b/public/js/webauthn.js
@@ -0,0 +1,178 @@
+// Thin wrapper around the browser WebAuthn API: converts the server's JSON options to the
+// binary form navigator.credentials expects (and back), keeps only one ceremony in flight,
+// and exposes the passkey Signal API so password managers stay in sync with the server.
+
+export const passkeysSupported =
+  typeof window.PublicKeyCredential === 'function' &&
+  typeof navigator.credentials?.create === 'function' &&
+  typeof navigator.credentials?.get === 'function';
+
+export async function conditionalMediationAvailable() {
+  try {
+    return passkeysSupported && (await PublicKeyCredential.isConditionalMediationAvailable?.()) === true;
+  } catch {
+    return false;
+  }
+}
+
+// --- base64url <-> ArrayBuffer -------------------------------------------------
+function toBuffer(b64url) {
+  const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(b64url.length / 4) * 4, '=');
+  const bin = atob(b64);
+  const bytes = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+  return bytes.buffer;
+}
+
+function toBase64url(buffer) {
+  const bytes = new Uint8Array(buffer);
+  let bin = '';
+  for (const b of bytes) bin += String.fromCharCode(b);
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+const toDescriptor = (d) => ({ ...d, id: toBuffer(d.id) });
+
+function parseCreationOptions(json) {
+  return {
+    ...json,
+    challenge: toBuffer(json.challenge),
+    user: { ...json.user, id: toBuffer(json.user.id) },
+    excludeCredentials: (json.excludeCredentials ?? []).map(toDescriptor),
+  };
+}
+
+function parseRequestOptions(json) {
+  const options = { ...json, challenge: toBuffer(json.challenge) };
+  if (json.allowCredentials) options.allowCredentials = json.allowCredentials.map(toDescriptor);
+  return options;
+}
+
+function registrationToJSON(cred) {
+  const r = cred.response;
+  return {
+    id: cred.id,
+    rawId: toBase64url(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? undefined,
+    clientExtensionResults: cred.getClientExtensionResults(),
+    response: {
+      clientDataJSON: toBase64url(r.clientDataJSON),
+      attestationObject: toBase64url(r.attestationObject),
+      transports: typeof r.getTransports === 'function' ? r.getTransports() : undefined,
+    },
+  };
+}
+
+function authenticationToJSON(cred) {
+  const r = cred.response;
+  return {
+    id: cred.id,
+    rawId: toBase64url(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? undefined,
+    clientExtensionResults: cred.getClientExtensionResults(),
+    response: {
+      clientDataJSON: toBase64url(r.clientDataJSON),
+      authenticatorData: toBase64url(r.authenticatorData),
+      signature: toBase64url(r.signature),
+      userHandle: r.userHandle ? toBase64url(r.userHandle) : undefined,
+    },
+  };
+}
+
+// --- Ceremonies -----------------------------------------------------------------
+// Browsers only allow one WebAuthn request at a time, so starting a new one cancels the
+// previous (e.g. the background passkey-autofill request when "Sign in" is clicked).
+let pending = null;
+let pendingIsModal = false;
+
+class CeremonyCancelled extends Error {
+  constructor() {
+    super('Cancelled by a newer passkey request.');
+    this.name = 'AbortError';
+  }
+}
+
+function nextSignal({ modal = true } = {}) {
+  // Never let a background autofill request pre-empt a prompt the customer explicitly opened.
+  if (!modal && pending && pendingIsModal && !pending.signal.aborted) throw new CeremonyCancelled();
+  pending?.abort(new CeremonyCancelled());
+  const controller = new AbortController();
+  pending = controller;
+  pendingIsModal = modal;
+  return controller.signal;
+}
+
+export function cancelPendingCeremony() {
+  pending?.abort(new CeremonyCancelled());
+  pending = null;
+}
+
+async function run(signal, fn) {
+  try {
+    return await fn();
+  } finally {
+    if (pending?.signal === signal) pending = null;
+  }
+}
+
+/** Create a passkey from server-generated options; resolves to the JSON to send back. */
+export async function createPasskey(optionsJSON) {
+  const signal = nextSignal();
+  const credential = await run(signal, () =>
+    navigator.credentials.create({ publicKey: parseCreationOptions(optionsJSON), signal }),
+  );
+  return registrationToJSON(credential);
+}
+
+/**
+ * Get an assertion. With `conditional: true` the request waits quietly for the customer to
+ * pick a passkey from the browser's autofill suggestions.
+ */
+export async function getPasskey(optionsJSON, { conditional = false } = {}) {
+  const signal = nextSignal({ modal: !conditional });
+  const request = { publicKey: parseRequestOptions(optionsJSON), signal };
+  if (conditional) request.mediation = 'conditional';
+  const credential = await run(signal, () => navigator.credentials.get(request));
+  return authenticationToJSON(credential);
+}
+
+/** Turn WebAuthn exceptions into messages that make sense to a coffee customer. */
+export function describeWebAuthnError(err, action = 'continue') {
+  switch (err?.name) {
+    case 'AbortError':
+      return null; // superseded by another request; nothing to report
+    case 'NotAllowedError':
+      return `Passkey request was cancelled or timed out. Try again when you’re ready to ${action}.`;
+    case 'InvalidStateError':
+      return 'This device or password manager already has a passkey for your account.';
+    case 'NotSupportedError':
+      return 'This device doesn’t support the kind of passkey we need. Try a different device or password manager.';
+    case 'SecurityError':
+      return 'Passkeys aren’t available on this address. Make sure you’re on the official Daily Grind site.';
+    default:
+      return err?.message || 'Something went wrong with your passkey. Please try again.';
+  }
+}
+
+// --- Signal API (best effort; supported in recent Chromium-based browsers) ---------
+async function signal(method, payload) {
+  try {
+    if (typeof PublicKeyCredential?.[method] === 'function') await PublicKeyCredential[method](payload);
+  } catch (err) {
+    console.debug(`PublicKeyCredential.${method} failed`, err);
+  }
+}
+
+/** Tell the passkey provider a credential no longer exists on the server so it can hide it. */
+export const signalUnknownCredential = (rpId, credentialId) =>
+  signal('signalUnknownCredential', { rpId, credentialId });
+
+/** Tell the passkey provider exactly which of this user's passkeys are still valid. */
+export const signalAllAcceptedCredentials = (rpId, userId, allAcceptedCredentialIds) =>
+  signal('signalAllAcceptedCredentials', { rpId, userId, allAcceptedCredentialIds });
+
+/** Keep the account name shown in passkey pickers up to date after a profile change. */
+export const signalCurrentUserDetails = (rpId, userId, name, displayName) =>
+  signal('signalCurrentUserDetails', { rpId, userId, name, displayName });
