@@ -0,0 +1,188 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/css/styles.css">
+  <script src="/js/nav.js" defer></script>
+  <script type="module" src="/js/account.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link" data-auth-link>Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="page-banner">
+    <h1>My Account</h1>
+    <p>Sign in with a passkey. No passwords to remember.</p>
+  </header>
+
+  <main class="container account">
+    <div id="unsupported" class="notice error" hidden>
+      Your browser doesn’t support passkeys. Please update it, or try a recent version of Chrome, Safari, Edge or
+      Firefox.
+    </div>
+    <div id="status" class="notice" role="status" aria-live="polite" hidden></div>
+
+    <p id="loading" class="muted">Loading your account…</p>
+
+    <!-- Signed out: sign in or register -->
+    <section id="signed-out" hidden>
+      <div class="account-grid">
+        <div class="panel">
+          <h2>Sign in</h2>
+          <p class="muted">Use the passkey saved on your phone, computer, security key or password manager.</p>
+          <form id="signin-form" novalidate>
+            <div class="field">
+              <label for="signin-email">Email</label>
+              <input id="signin-email" name="username" type="email" autocomplete="username webauthn"
+                placeholder="you@example.com" spellcheck="false">
+              <p class="hint">Pick your passkey from the suggestions, or use the button below.</p>
+            </div>
+            <button type="submit" class="btn btn-block" data-requires-passkeys>Sign in with a passkey</button>
+          </form>
+        </div>
+
+        <div class="panel">
+          <h2>New here?</h2>
+          <p class="muted">Create a Daily Grind account in seconds. It’s secured by a passkey, so there’s no password.</p>
+          <form id="register-form">
+            <div class="field">
+              <label for="register-name">Name</label>
+              <input id="register-name" name="displayName" type="text" autocomplete="name" maxlength="64" required>
+            </div>
+            <div class="field">
+              <label for="register-email">Email</label>
+              <input id="register-email" name="email" type="email" autocomplete="username" maxlength="254"
+                spellcheck="false" required>
+            </div>
+            <button type="submit" class="btn btn-block" data-requires-passkeys>Create account with a passkey</button>
+          </form>
+          <ul class="benefits">
+            <li>Sign in with your fingerprint, face or screen lock</li>
+            <li>Phishing-resistant: passkeys only work on our site</li>
+            <li>Synced passkeys follow you to your other devices</li>
+          </ul>
+        </div>
+      </div>
+    </section>
+
+    <!-- Signed in: profile and passkey management -->
+    <section id="signed-in" hidden>
+      <div class="welcome">
+        <h2>Welcome, <span data-user-field="displayName"></span></h2>
+        <button type="button" id="signout-btn" class="btn btn-outline">Sign out</button>
+      </div>
+
+      <div class="panel">
+        <h3>Profile</h3>
+        <form id="profile-form">
+          <div class="field">
+            <label for="profile-name">Name</label>
+            <input id="profile-name" name="displayName" type="text" autocomplete="name" maxlength="64" required>
+          </div>
+          <div class="field">
+            <label for="profile-email">Email</label>
+            <input id="profile-email" name="email" type="email" autocomplete="username" maxlength="254"
+              spellcheck="false" required>
+            <p class="hint">This is your sign-in name. To change it, you’ll need to confirm it’s you with a passkey.</p>
+          </div>
+          <div class="form-actions">
+            <button type="submit" class="btn">Save changes</button>
+            <span class="muted">Member since <span data-user-field="memberSince"></span></span>
+          </div>
+        </form>
+      </div>
+
+      <div class="panel">
+        <div class="panel-head">
+          <h3>Passkeys</h3>
+          <button type="button" id="add-passkey-btn" class="btn" data-requires-passkeys>Add a passkey</button>
+        </div>
+        <p class="muted">
+          Passkeys let you sign in with your device’s fingerprint, face or screen lock. Add one on each device you use,
+          or use a password manager that syncs them for you.
+        </p>
+        <ul id="passkey-list" class="passkey-list" aria-label="Saved passkeys"></ul>
+        <p id="reauth-status" class="hint" hidden></p>
+      </div>
+    </section>
+  </main>
+
+  <!-- Reauthentication prompt shown before sensitive changes -->
+  <dialog id="reauth-dialog" aria-labelledby="reauth-title">
+    <h3 id="reauth-title">Confirm it’s you</h3>
+    <p id="reauth-message"></p>
+    <p class="dialog-error" role="alert" hidden></p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-outline" data-action="cancel">Cancel</button>
+      <button type="button" class="btn" data-action="confirm">Use passkey</button>
+    </div>
+  </dialog>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title">
+    <form id="rename-form">
+      <h3 id="rename-title">Rename passkey</h3>
+      <div class="field">
+        <label for="rename-input">Passkey name</label>
+        <input id="rename-input" type="text" maxlength="48" required autocomplete="off">
+        <p class="hint">Something you’ll recognize, like “Work laptop” or “My phone”.</p>
+      </div>
+      <p class="dialog-error" role="alert" hidden></p>
+      <div class="dialog-actions">
+        <button type="button" class="btn btn-outline" data-action="cancel">Cancel</button>
+        <button type="submit" class="btn">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="remove-dialog" aria-labelledby="remove-title">
+    <h3 id="remove-title">Remove passkey?</h3>
+    <p id="remove-message"></p>
+    <p class="hint">This only removes it from your Daily Grind account. You may also want to delete it from your
+      device or password manager.</p>
+    <p class="dialog-error" role="alert" hidden></p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-outline" data-action="cancel">Cancel</button>
+      <button type="button" class="btn btn-danger" data-action="confirm">Remove</button>
+    </div>
+  </dialog>
+
+  <template id="passkey-item-template">
+    <li class="passkey-item">
+      <div class="passkey-icon" aria-hidden="true">🔑</div>
+      <div class="passkey-meta">
+        <div class="passkey-name"></div>
+        <div class="muted passkey-details"></div>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn btn-outline" data-action="rename">Rename</button>
+        <button type="button" class="btn btn-outline" data-action="remove">Remove</button>
+      </div>
+    </li>
+  </template>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/public/css/styles.css b/public/css/styles.css
new file mode 100644
index 0000000..e42eb29
--- /dev/null
+++ b/public/css/styles.css
@@ -0,0 +1,455 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+/* ------------------------------------------------------------------ */
+/* My Account                                                          */
+/* ------------------------------------------------------------------ */
+.page-banner {
+  background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  color: white;
+  text-align: center;
+  padding: 60px 20px;
+}
+
+.page-banner h1 {
+  font-size: 2.4rem;
+}
+
+.account {
+  max-width: 900px;
+}
+
+.account-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 24px;
+}
+
+.panel {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  padding: 28px;
+  margin-bottom: 24px;
+}
+
+.panel h2,
+.panel h3 {
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.panel-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.panel-head .btn {
+  margin-top: 0;
+}
+
+.muted,
+.hint {
+  color: #6d5d58;
+  font-size: 0.88rem;
+}
+
+form .field {
+  margin: 16px 0;
+}
+
+label {
+  display: block;
+  font-weight: 600;
+  font-size: 0.9rem;
+  margin-bottom: 6px;
+}
+
+input[type="text"],
+input[type="email"] {
+  width: 100%;
+  padding: 10px 12px;
