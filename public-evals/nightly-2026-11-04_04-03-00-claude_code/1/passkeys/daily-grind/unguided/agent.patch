@@ -0,0 +1,345 @@
+// End-to-end tests of the passkey API using a software authenticator.
+// Drives the request handler directly (no network server is started).
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { Readable } from 'node:stream';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+
+const ORIGIN = 'http://localhost:4321';
+const RP_ID = 'localhost';
+const dataDir = mkdtempSync(path.join(tmpdir(), 'daily-grind-test-'));
+process.env.ORIGIN = ORIGIN;
+process.env.RP_ID = RP_ID;
+process.env.DATA_FILE = path.join(dataDir, 'db.json');
+
+let handle;
+before(async () => {
+  ({ handle } = await import('../server/app.js'));
+});
+after(() => rmSync(dataDir, { recursive: true, force: true }));
+
+// --- Tiny HTTP client against the handler -------------------------------------
+class Browser {
+  cookies = new Map();
+
+  async call(method, url, { body, origin = ORIGIN } = {}) {
+    const payload = body === undefined ? [] : [Buffer.from(JSON.stringify(body))];
+    const req = Readable.from(payload);
+    req.method = method;
+    req.url = url;
+    req.headers = {
+      origin,
+      cookie: [...this.cookies].map(([k, v]) => `${k}=${v}`).join('; '),
+      ...(body !== undefined && { 'content-type': 'application/json' }),
+    };
+    const headers = {};
+    let status = 200;
+    let chunks = '';
+    const res = {
+      headersSent: false,
+      setHeader: (k, v) => (headers[k.toLowerCase()] = v),
+      writeHead(s, h = {}) {
+        status = s;
+        for (const [k, v] of Object.entries(h)) headers[k.toLowerCase()] = v;
+        this.headersSent = true;
+      },
+      end: (b) => (chunks += b ?? ''),
+    };
+    await handle(req, res);
+    const cookie = headers['set-cookie'];
+    if (cookie) {
+      const [pair, ...attrs] = cookie.split('; ');
+      const [k, v] = pair.split('=');
+      if (attrs.includes('Max-Age=0')) this.cookies.delete(k);
+      else this.cookies.set(k, v);
+    }
+    let json;
+    try {
+      json = JSON.parse(chunks);
+    } catch {
+      json = undefined;
+    }
+    return { status, json, text: chunks, headers };
+  }
+}
+
+// --- Software passkey authenticator --------------------------------------------
+const b64u = (buf) => Buffer.from(buf).toString('base64url');
+const sha256 = (data) => createHash('sha256').update(data).digest();
+
+class Passkey {
+  constructor({ backedUp = true } = {}) {
+    const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+    this.privateKey = privateKey;
+    this.jwk = publicKey.export({ format: 'jwk' });
+    this.id = randomBytes(16);
+    this.counter = 0;
+    this.backedUp = backedUp;
+    this.aaguid = Buffer.from('fbfc3007154e4ecc8c0b6e020557d7bd', 'hex'); // iCloud Keychain
+  }
+
+  flags({ uv = true, at = false } = {}) {
+    return 0x01 | (uv ? 0x04 : 0) | (this.backedUp ? 0x18 : 0) | (at ? 0x40 : 0);
+  }
+
+  clientData(type, challenge, origin) {
+    return Buffer.from(JSON.stringify({ type, challenge, origin, crossOrigin: false }));
+  }
+
+  create(options, { origin = ORIGIN } = {}) {
+    this.userHandle = options.user.id;
+    const coseKey = new Map([
+      [1, 2],
+      [3, -7],
+      [-1, 1],
+      [-2, Buffer.from(this.jwk.x, 'base64url')],
+      [-3, Buffer.from(this.jwk.y, 'base64url')],
+    ]);
+    const idLen = Buffer.alloc(2);
+    idLen.writeUInt16BE(this.id.length);
+    const authData = Buffer.concat([
+      sha256(options.rp.id),
+      Buffer.from([this.flags({ at: true })]),
+      Buffer.alloc(4),
+      this.aaguid,
+      idLen,
+      this.id,
+      Buffer.from(isoCBOR.encode(coseKey)),
+    ]);
+    const attestationObject = isoCBOR.encode(
+      new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', new Uint8Array(authData)]]),
+    );
+    return {
+      id: b64u(this.id),
+      rawId: b64u(this.id),
+      type: 'public-key',
+      clientExtensionResults: {},
+      response: {
+        clientDataJSON: b64u(this.clientData('webauthn.create', options.challenge, origin)),
+        attestationObject: b64u(attestationObject),
+        transports: ['internal', 'hybrid'],
+      },
+    };
+  }
+
+  get(options, { origin = ORIGIN, uv = true } = {}) {
+    this.counter++;
+    const counter = Buffer.alloc(4);
+    counter.writeUInt32BE(this.counter);
+    const authData = Buffer.concat([sha256(options.rpId), Buffer.from([this.flags({ uv })]), counter]);
+    const clientDataJSON = this.clientData('webauthn.get', options.challenge, origin);
+    const signature = sign('sha256', Buffer.concat([authData, sha256(clientDataJSON)]), this.privateKey);
+    return {
+      id: b64u(this.id),
+      rawId: b64u(this.id),
+      type: 'public-key',
+      clientExtensionResults: {},
+      response: {
+        clientDataJSON: b64u(clientDataJSON),
+        authenticatorData: b64u(authData),
+        signature: b64u(signature),
+        userHandle: this.userHandle,
+      },
+    };
+  }
+}
+
+// Shift the server's clock to simulate the reauthentication window expiring.
+function advanceClock(ms) {
+  const realNow = Date.now;
+  Date.now = () => realNow() + ms;
+  return () => (Date.now = realNow);
+}
