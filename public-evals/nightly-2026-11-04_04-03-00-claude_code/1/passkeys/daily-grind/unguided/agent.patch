diff --git a/public/js/account.js b/public/js/account.js
new file mode 100644
index 0000000..1a70922
--- /dev/null
+++ b/public/js/account.js
@@ -0,0 +1,512 @@
+// "My Account" page: passkey sign-up, sign-in (button + autofill), profile updates,
+// saved passkey management and reauthentication before sensitive changes.
+import {
+  passkeysSupported,
+  conditionalMediationAvailable,
+  createPasskey,
+  getPasskey,
+  cancelPendingCeremony,
+  describeWebAuthnError,
+  signalUnknownCredential,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+} from './webauthn.js';
+
+const $ = (sel, root = document) => root.querySelector(sel);
+
+const els = {
+  loading: $('#loading'),
+  unsupported: $('#unsupported'),
+  status: $('#status'),
+  signedOut: $('#signed-out'),
+  signedIn: $('#signed-in'),
+  signinForm: $('#signin-form'),
+  registerForm: $('#register-form'),
+  profileForm: $('#profile-form'),
+  signoutBtn: $('#signout-btn'),
+  addPasskeyBtn: $('#add-passkey-btn'),
+  passkeyList: $('#passkey-list'),
+  passkeyTemplate: $('#passkey-item-template'),
+  reauthStatus: $('#reauth-status'),
+  reauthDialog: $('#reauth-dialog'),
+  renameDialog: $('#rename-dialog'),
+  removeDialog: $('#remove-dialog'),
+};
+
+const state = {
+  rpId: location.hostname,
+  user: null,
+  passkeys: [],
+  reauthUntil: 0, // local timestamp until which the server will accept sensitive changes without asking again
+};
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const timeFormat = new Intl.DateTimeFormat(undefined, { timeStyle: 'short' });
+const formatDate = (iso) => (iso ? dateFormat.format(new Date(iso)) : '—');
+
+// ---------------------------------------------------------------------------
+// Utilities
+// ---------------------------------------------------------------------------
+async function api(method, url, body) {
+  const init = { method, credentials: 'same-origin', headers: { Accept: 'application/json' } };
+  if (body !== undefined) {
+    init.headers['Content-Type'] = 'application/json';
+    init.body = JSON.stringify(body);
+  }
+  const res = await fetch(url, init);
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    const err = new Error(data.error || `Request failed (${res.status}).`);
+    Object.assign(err, { status: res.status, code: data.code, data });
+    if (data.code === 'not_signed_in' && state.user) {
+      applySession({ user: null, rpId: state.rpId });
+      showStatus('Your session has ended. Please sign in again.', 'info');
+    }
+    throw err;
+  }
+  return data;
+}
+
+let statusTimer;
+function showStatus(message, kind = 'success') {
+  clearTimeout(statusTimer);
+  if (!message) {
+    els.status.hidden = true;
+    return;
+  }
+  els.status.textContent = message;
+  els.status.className = `notice ${kind}`;
+  els.status.hidden = false;
+  if (kind === 'success') statusTimer = setTimeout(() => (els.status.hidden = true), 6000);
+}
+
+function showError(err, action) {
+  const message = describeWebAuthnError(err, action);
+  if (message) showStatus(message, 'error');
+}
+
+/** Disable a button while an async task runs. */
+async function busy(button, task) {
+  if (button) button.disabled = true;
+  try {
+    return await task();
+  } finally {
+    if (button) button.disabled = false;
+  }
+}
+
+function applySession(payload) {
+  if (payload.rpId) state.rpId = payload.rpId;
+  const wasSignedIn = Boolean(state.user);
+  state.user = payload.user;
+  state.reauthUntil = payload.reauthExpiresInMs ? Date.now() + payload.reauthExpiresInMs : 0;
+  if (wasSignedIn !== Boolean(state.user)) {
+    document.dispatchEvent(new CustomEvent('dg:auth-changed', { detail: { signedIn: Boolean(state.user) } }));
+  }
+  render();
+}
+
+const reauthIsFresh = () => Date.now() < state.reauthUntil - 10_000;
+
+// ---------------------------------------------------------------------------
+// Rendering
+// ---------------------------------------------------------------------------
+function render() {
+  els.loading.hidden = true;
+  const signedIn = Boolean(state.user);
+  els.signedIn.hidden = !signedIn;
+  els.signedOut.hidden = signedIn;
+
+  if (signedIn) {
+    cancelPendingCeremony(); // stop passkey autofill
+    for (const node of document.querySelectorAll('[data-user-field="displayName"]')) {
+      node.textContent = state.user.displayName;
+    }
+    $('[data-user-field="memberSince"]').textContent = formatDate(state.user.createdAt);
+    els.profileForm.displayName.value = state.user.displayName;
+    els.profileForm.email.value = state.user.email;
+    renderReauthStatus();
+  } else {
+    state.passkeys = [];
+    els.passkeyList.replaceChildren();
+    startPasskeyAutofill();
+  }
+}
+
+let reauthStatusTimer;
+function renderReauthStatus() {
+  clearTimeout(reauthStatusTimer);
+  const fresh = reauthIsFresh();
+  els.reauthStatus.hidden = !fresh;
+  if (fresh) {
+    els.reauthStatus.textContent =
+      `🔓 You recently confirmed it’s you. Until ${timeFormat.format(new Date(state.reauthUntil))}, ` +
+      'you can make security changes without verifying again.';
+    reauthStatusTimer = setTimeout(renderReauthStatus, state.reauthUntil - 10_000 - Date.now() + 50);
+  }
+}
+
+function renderPasskeys() {
+  const onlyOne = state.passkeys.length <= 1;
+  const items = state.passkeys.map((pk) => {
+    const li = els.passkeyTemplate.content.firstElementChild.cloneNode(true);
+    li.dataset.id = pk.id;
+    const name = $('.passkey-name', li);
+    name.textContent = pk.name;
+    if (pk.synced) name.append(badge('Synced', 'This passkey is backed up and syncs across your devices.'));
+    if (pk.currentSession) name.append(badge('Used to sign in', 'You signed in with this passkey.', 'current'));
+
+    const details = [`Added ${formatDate(pk.createdAt)}`, `Last used ${formatDate(pk.lastUsedAt)}`];
+    if (pk.provider && pk.provider !== pk.name) details.push(pk.provider);
+    $('.passkey-details', li).textContent = details.join(' · ');
+
+    const rename = $('[data-action="rename"]', li);
+    rename.setAttribute('aria-label', `Rename passkey ${pk.name}`);
+    rename.addEventListener('click', () => openRenameDialog(pk));
+
+    const remove = $('[data-action="remove"]', li);
+    remove.setAttribute('aria-label', `Remove passkey ${pk.name}`);
+    if (onlyOne) {
+      remove.disabled = true;
+      remove.title = 'Add another passkey before removing your only one.';
+    }
+    remove.addEventListener('click', () => openRemoveDialog(pk));
+    return li;
+  });
+  els.passkeyList.replaceChildren(...items);
+}
+
+function badge(text, title, extraClass = '') {
+  const span = document.createElement('span');
+  span.className = `badge ${extraClass}`.trim();
+  span.textContent = text;
+  span.title = title;
+  return span;
+}
+
+async function loadPasskeys() {
+  const { passkeys } = await api('GET', '/api/passkeys');
+  state.passkeys = passkeys;
+  renderPasskeys();
+  return passkeys;
+}
+
+// ---------------------------------------------------------------------------
+// Sign in
+// ---------------------------------------------------------------------------
+async function completeSignIn(credentialJSON) {
+  let result;
+  try {
+    result = await api('POST', '/api/login/verify', { response: credentialJSON });
+  } catch (err) {
+    if (err.code === 'unknown_credential' && err.data?.credentialId) {
+      // The passkey was deleted from the account; ask the provider to stop offering it.
+      await signalUnknownCredential(state.rpId, err.data.credentialId);
+    }
+    throw err;
+  }
+  applySession(result);
+  signalAllAcceptedCredentials(state.rpId, result.user.id, result.acceptedCredentialIds);
+  showStatus(`Welcome back, ${result.user.displayName}! ☕`);
+  await loadPasskeys();
+}
+
+/** Passkey autofill: offer passkeys in the email field's suggestions without a modal prompt. */
+let autofillRunning = false;
+let autofillFailures = 0;
+async function startPasskeyAutofill() {
+  if (autofillRunning || state.user || !(await conditionalMediationAvailable())) return;
+  autofillRunning = true;
+  try {
+    const options = await api('POST', '/api/login/options');
+    const credential = await getPasskey(options, { conditional: true });
+    await completeSignIn(credential);
+    autofillFailures = 0;
+    return;
+  } catch (err) {
+    if (err.name === 'AbortError') return; // a modal ceremony took over
+    showError(err, 'sign in');
+    autofillFailures++;
+  } finally {
+    autofillRunning = false;
+  }
+  // Keep autofill available after a failed attempt (backing off if something is persistently wrong).
+  if (!state.user && autofillFailures < 5) setTimeout(startPasskeyAutofill, 500 * autofillFailures);
+}
+
+els.signinForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const button = event.submitter ?? $('button[type="submit"]', els.signinForm);
+  busy(button, async () => {
+    showStatus(null);
+    try {
+      const options = await api('POST', '/api/login/options');
+      const credential = await getPasskey(options);
+      await completeSignIn(credential);
+    } catch (err) {
+      showError(err, 'sign in');
+      if (!state.user) setTimeout(startPasskeyAutofill, 0);
+    }
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Register
+// ---------------------------------------------------------------------------
+els.registerForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const form = els.registerForm;
+  if (!form.reportValidity()) return;
+  const button = event.submitter ?? $('button[type="submit"]', form);
+  busy(button, async () => {
+    showStatus(null);
+    try {
+      const options = await api('POST', '/api/register/options', {
+        displayName: form.displayName.value,
+        email: form.email.value,
+      });
+      const credential = await createPasskey(options);
+      const result = await api('POST', '/api/register/verify', { response: credential });
+      form.reset();
+      applySession(result);
+      showStatus(`Welcome to The Daily Grind, ${result.user.displayName}! Your passkey is saved. Use it to sign in next time.`);
+      await loadPasskeys();
+    } catch (err) {
+      showError(err, 'create your account');
+      if (!state.user) setTimeout(startPasskeyAutofill, 0);
+    }
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Reauthentication
+// ---------------------------------------------------------------------------
+/**
+ * Run a sensitive action, first asking the customer to confirm with a passkey if they
+ * haven't done so in the last few minutes.
+ *
+ * `continueLabel` is for actions that start their own WebAuthn ceremony (adding a passkey):
+ * browsers require a fresh click for that, so the dialog offers a second button after verifying.
+ * Resolves with the action's result, or `undefined` if the customer cancels.
+ */
+async function withReauth(reason, action, { continueLabel } = {}) {
+  if (reauthIsFresh()) {
+    try {
+      return await action();
+    } catch (err) {
+      if (err.code !== 'reauth_required') throw err;
+    }
+  }
+  return reauthDialog(reason, action, continueLabel);
+}
+
+function reauthDialog(reason, action, continueLabel) {
+  const dialog = els.reauthDialog;
+  const message = $('#reauth-message', dialog);
+  const errorEl = $('.dialog-error', dialog);
+  const confirmBtn = $('[data-action="confirm"]', dialog);
+  const cancelBtn = $('[data-action="cancel"]', dialog);
+
+  message.textContent = `For your security, please verify with one of your passkeys before you ${reason}.`;
+  errorEl.hidden = true;
+  confirmBtn.textContent = 'Use passkey';
+  confirmBtn.disabled = false;
+  dialog.showModal();
+
+  return new Promise((resolve, reject) => {
+    const listeners = new AbortController();
+    let verified = false;
+
+    const finish = (fn, value) => {
+      listeners.abort();
+      cancelPendingCeremony();
+      if (dialog.open) dialog.close();
+      fn(value);
+    };
+
+    const runAction = async () => {
+      try {
+        finish(resolve, await action());
+      } catch (err) {
+        finish(reject, err);
+      }
+    };
+
+    confirmBtn.addEventListener('click', async () => {
+      errorEl.hidden = true;
+      confirmBtn.disabled = true;
+      try {
+        if (verified) return await runAction();
+
+        const options = await api('POST', '/api/reauth/options');
+        const credential = await getPasskey(options);
+        applySession(await api('POST', '/api/reauth/verify', { response: credential }));
+        verified = true;
+
+        if (!continueLabel) return await runAction();
+        message.textContent = 'Thanks, you’re verified. You can continue now.';
+        confirmBtn.textContent = continueLabel;
+      } catch (err) {
+        const text = describeWebAuthnError(err, 'confirm it’s you');
+        if (text) {
+          errorEl.textContent = text;
+          errorEl.hidden = false;
+        }
+      } finally {
+        confirmBtn.disabled = false;
+      }
+    }, { signal: listeners.signal });
+
+    cancelBtn.addEventListener('click', () => finish(resolve, undefined), { signal: listeners.signal });
+    dialog.addEventListener('close', () => finish(resolve, undefined), { signal: listeners.signal });
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Profile
+// ---------------------------------------------------------------------------
+els.profileForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const form = els.profileForm;
+  if (!form.reportValidity()) return;
+  const button = event.submitter ?? $('button[type="submit"]', form);
+  const displayName = form.displayName.value.trim();
+  const email = form.email.value.trim().toLowerCase();
+  const emailChanged = email !== state.user.email;
+
+  const save = async () => {
+    const result = await api('PATCH', '/api/profile', { displayName, email });
+    applySession(result);
+    // Update the account name shown in passkey pickers / password managers.
+    signalCurrentUserDetails(state.rpId, result.user.id, result.user.email, result.user.displayName);
+    showStatus('Your profile has been updated.');
+    return result;
+  };
+
+  busy(button, async () => {
+    showStatus(null);
+    try {
+      const result = emailChanged ? await withReauth('change your email address', save) : await save();
+      if (!result) form.email.value = state.user.email; // cancelled: restore
+    } catch (err) {
+      showError(err, 'save your changes');
+    }
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Passkey management
+// ---------------------------------------------------------------------------
+els.addPasskeyBtn.addEventListener('click', () => {
+  const add = async () => {
+    const options = await api('POST', '/api/passkeys/options');
+    const credential = await createPasskey(options);
+    const { passkey } = await api('POST', '/api/passkeys/verify', { response: credential });
+    await loadPasskeys();
+    showStatus(`Passkey “${passkey.name}” added. You can rename it so it’s easy to recognize.`);
+    return passkey;
+  };
+  busy(els.addPasskeyBtn, async () => {
+    showStatus(null);
+    try {
+      await withReauth('add a new passkey', add, { continueLabel: 'Create passkey' });
+    } catch (err) {
+      showError(err, 'add a passkey');
+    }
+  });
+});
+
+function openRenameDialog(passkey) {
+  const dialog = els.renameDialog;
+  const form = $('#rename-form', dialog);
+  const input = $('#rename-input', dialog);
+  const errorEl = $('.dialog-error', dialog);
+  const listeners = new AbortController();
+  input.value = passkey.name;
+  errorEl.hidden = true;
+  dialog.showModal();
+  input.select();
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const button = event.submitter;
+    await busy(button, async () => {
+      try {
+        await api('PATCH', `/api/passkeys/${encodeURIComponent(passkey.id)}`, { name: input.value });
+        await loadPasskeys();
+        dialog.close();
+        showStatus('Passkey renamed.');
+      } catch (err) {
+        errorEl.textContent = err.message;
+        errorEl.hidden = false;
+      }
+    });
+  }, { signal: listeners.signal });
+  $('[data-action="cancel"]', dialog).addEventListener('click', () => dialog.close(), { signal: listeners.signal });
+  dialog.addEventListener('close', () => listeners.abort(), { signal: listeners.signal });
+}
+
+function openRemoveDialog(passkey) {
+  const dialog = els.removeDialog;
+  const listeners = new AbortController();
+  $('#remove-message', dialog).textContent =
+    `You won’t be able to sign in to The Daily Grind with “${passkey.name}” anymore.`;
+  $('.dialog-error', dialog).hidden = true;
+  dialog.showModal();
+
+  const remove = async () => {
+    const { acceptedCredentialIds } = await api('DELETE', `/api/passkeys/${encodeURIComponent(passkey.id)}`);
+    // Let the passkey provider know this credential no longer works here.
+    signalAllAcceptedCredentials(state.rpId, state.user.id, acceptedCredentialIds);
+    await loadPasskeys();
+    showStatus(`Passkey “${passkey.name}” removed.`);
+    return true;
+  };
+
+  $('[data-action="confirm"]', dialog).addEventListener('click', async () => {
+    dialog.close();
+    showStatus(null);
+    try {
+      await withReauth(`remove the passkey “${passkey.name}”`, remove);
+    } catch (err) {
+      showError(err, 'remove the passkey');
+    }
+  }, { signal: listeners.signal });
+  $('[data-action="cancel"]', dialog).addEventListener('click', () => dialog.close(), { signal: listeners.signal });
+  dialog.addEventListener('close', () => listeners.abort(), { signal: listeners.signal });
+}
+
+// ---------------------------------------------------------------------------
+// Sign out
+// ---------------------------------------------------------------------------
+els.signoutBtn.addEventListener('click', () => {
+  busy(els.signoutBtn, async () => {
+    await api('POST', '/api/logout').catch(() => {});
+    applySession({ user: null });
+    showStatus('You’ve been signed out. See you soon!', 'info');
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+async function init() {
+  if (!passkeysSupported) {
+    els.unsupported.hidden = false;
+    for (const el of document.querySelectorAll('[data-requires-passkeys]')) el.disabled = true;
+  }
+  try {
+    const session = await api('GET', '/api/session');
+    applySession(session);
+    if (state.user) {
+      const passkeys = await loadPasskeys();
+      // Keep the customer's password manager in sync with the passkeys we still accept.
+      signalAllAcceptedCredentials(state.rpId, state.user.id, passkeys.map((p) => p.id));
+    }
+  } catch (err) {
+    els.loading.textContent = 'We couldn’t load your account. Please refresh the page.';
+    console.error(err);
+  }
+}
+
+init();
diff --git a/public/js/nav.js b/public/js/nav.js
