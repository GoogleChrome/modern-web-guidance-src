+++ b/server/aaguids.js
@@ -0,0 +1,23 @@
+// Friendly names for common passkey providers, keyed by authenticator AAGUID.
+// Used to give newly created passkeys a recognizable default name.
+// Source: https://github.com/passkeydeveloper/passkey-authenticator-aaguids
+const PROVIDERS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+};
+
+/** @returns {string | null} */
+export function describeAuthenticator(aaguid) {
+  return (aaguid && PROVIDERS[aaguid.toLowerCase()]) || null;
+}
diff --git a/server/app.js b/server/app.js
new file mode 100644
index 0000000..57af39a
--- /dev/null
+++ b/server/app.js
@@ -0,0 +1,656 @@
+// The Daily Grind request handler: serves the static site and the passkey (WebAuthn) account API.
+import { randomBytes, timingSafeEqual } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import { createStore } from './store.js';
+import { describeAuthenticator } from './aaguids.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const PUBLIC_DIR = path.join(ROOT, 'public');
+
+// ---------------------------------------------------------------------------
+// Configuration
+// ---------------------------------------------------------------------------
+const PORT = Number(process.env.PORT || 11222);
+const RP_NAME = 'The Daily Grind';
+// The relying party ID must be the site's registrable domain (or a suffix of it), e.g. "dailygrind.example".
+const RP_ID = process.env.RP_ID || 'localhost';
+// Comma-separated list of origins the site is served from, e.g. "https://dailygrind.example".
+const ORIGINS = (process.env.ORIGIN || `http://localhost:${PORT}`)
+  .split(',')
+  .map((o) => o.trim().replace(/\/$/, ''))
+  .filter(Boolean);
+const SECURE_COOKIES = ORIGINS.every((o) => o.startsWith('https://'));
+const DATA_FILE = process.env.DATA_FILE || path.join(ROOT, 'data', 'db.json');
+
+const SESSION_COOKIE = SECURE_COOKIES ? '__Host-dg_sid' : 'dg_sid';
+const SESSION_IDLE_MS = 24 * 60 * 60 * 1000; // sign out after a day of inactivity
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const MAX_PENDING_CHALLENGES = 10;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000; // sensitive actions need a passkey check within the last 5 minutes
+const WEBAUTHN_TIMEOUT_MS = 5 * 60 * 1000;
+const MAX_BODY_BYTES = 64 * 1024;
+
+const store = createStore(DATA_FILE);
+
+// ---------------------------------------------------------------------------
+// Sessions (in memory; customers simply sign in again after a server restart)
+// ---------------------------------------------------------------------------
+/** @type {Map<string, Session>} */
+const sessions = new Map();
+
+/**
+ * @typedef {{
+ *   id: string,
+ *   userId: string | null,
+ *   authenticatedAt: number,      // last time a passkey was verified (sign-in, sign-up or reauth)
+ *   signInCredentialId: string | null,
+ *   challenges: Map<string, { purpose: string, expires: number, data?: any }>,
+ *   lastSeen: number,
+ * }} Session
+ */
+
+function newSession() {
+  const session = {
+    id: randomBytes(32).toString('base64url'),
+    userId: null,
+    authenticatedAt: 0,
+    signInCredentialId: null,
+    challenges: new Map(),
+    lastSeen: Date.now(),
+  };
+  sessions.set(session.id, session);
+  return session;
+}
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
+  }
+  return out;
+}
+
+function setSessionCookie(res, session) {
+  const attrs = [`${SESSION_COOKIE}=${session.id}`, 'Path=/', 'HttpOnly', 'SameSite=Lax'];
+  if (SECURE_COOKIES) attrs.push('Secure');
+  res.setHeader('Set-Cookie', attrs.join('; '));
+}
+
+function clearSessionCookie(res) {
+  const attrs = [`${SESSION_COOKIE}=`, 'Path=/', 'HttpOnly', 'SameSite=Lax', 'Max-Age=0'];
+  if (SECURE_COOKIES) attrs.push('Secure');
+  res.setHeader('Set-Cookie', attrs.join('; '));
+}
+
+/** Look up the caller's session, optionally creating one (needed to hold WebAuthn challenges). */
+function getSession(req, res, { create = false } = {}) {
+  const id = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  let session = id ? sessions.get(id) : undefined;
+  if (session && Date.now() - session.lastSeen > SESSION_IDLE_MS) {
+    sessions.delete(session.id);
+    session = undefined;
+  }
+  if (!session && create) {
+    session = newSession();
+    setSessionCookie(res, session);
+  }
+  if (session) session.lastSeen = Date.now();
+  return session ?? null;
+}
+
+/** Issue a fresh session ID on sign-in to prevent session fixation. */
+function startAuthenticatedSession(res, oldSession, userId, credentialId) {
+  if (oldSession) sessions.delete(oldSession.id);
+  const session = newSession();
+  session.userId = userId;
+  session.authenticatedAt = Date.now();
+  session.signInCredentialId = credentialId;
+  setSessionCookie(res, session);
+  return session;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, s] of sessions) {
+    if (now - s.lastSeen > SESSION_IDLE_MS) sessions.delete(id);
+    for (const [c, info] of s.challenges) if (info.expires < now) s.challenges.delete(c);
+  }
+}, 10 * 60 * 1000).unref();
+
+// ---------------------------------------------------------------------------
+// Challenge bookkeeping. Several ceremonies can be pending at once (e.g. passkey
+// autofill running in the background while the customer clicks "Sign in"), so
+// challenges are keyed by value and are strictly single-use.
+// ---------------------------------------------------------------------------
+function rememberChallenge(session, challenge, purpose, data) {
+  session.challenges.set(challenge, { purpose, expires: Date.now() + CHALLENGE_TTL_MS, data });
+  while (session.challenges.size > MAX_PENDING_CHALLENGES) {
+    session.challenges.delete(session.challenges.keys().next().value);
+  }
+}
+
+/** Pull the challenge out of the client's response and consume it if it matches the expected purpose. */
+function consumeChallenge(session, credentialResponse, purpose) {
+  let challenge;
+  try {
+    const clientData = JSON.parse(
+      Buffer.from(credentialResponse.response.clientDataJSON, 'base64url').toString('utf8'),
+    );
+    challenge = clientData.challenge;
+  } catch {
+    throw new HttpError(400, 'Malformed passkey response.');
+  }
+  const entry = typeof challenge === 'string' ? session?.challenges.get(challenge) : undefined;
+  if (!entry || entry.purpose !== purpose || entry.expires < Date.now()) {
+    throw new HttpError(400, 'This request has expired. Please try again.', 'challenge_expired');
+  }
+  session.challenges.delete(challenge);
+  return { challenge, data: entry.data };
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+class HttpError extends Error {
+  constructor(status, message, code = undefined, extra = undefined) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.extra = extra;
+  }
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+async function readJson(req) {
+  if (!(req.headers['content-type'] || '').startsWith('application/json')) {
+    throw new HttpError(415, 'Expected a JSON request body.');
+  }
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw new HttpError(413, 'Request body too large.');
+    chunks.push(chunk);
+  }
+  try {
+    const body = JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}');
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+    return body;
+  } catch {
+    throw new HttpError(400, 'Invalid JSON body.');
+  }
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function normalizeEmail(value) {
+  const email = String(value ?? '').trim().toLowerCase();
+  if (!EMAIL_RE.test(email) || email.length > 254) throw new HttpError(400, 'Please enter a valid email address.');
+  return email;
+}
+
+function normalizeDisplayName(value) {
+  const name = String(value ?? '').trim().replace(/\s+/g, ' ');
+  if (!name) throw new HttpError(400, 'Please enter your name.');
+  if (name.length > 64) throw new HttpError(400, 'Names can be at most 64 characters.');
+  return name;
+}
+
+function normalizePasskeyName(value) {
+  const name = String(value ?? '').trim().replace(/\s+/g, ' ');
+  if (!name) throw new HttpError(400, 'Please enter a name for this passkey.');
+  if (name.length > 48) throw new HttpError(400, 'Passkey names can be at most 48 characters.');
+  return name;
+}
+
+function requireUser(session) {
+  const user = session?.userId ? store.getUser(session.userId) : null;
+  if (!user) throw new HttpError(401, 'Please sign in to continue.', 'not_signed_in');
+  return user;
+}
+
+function hasRecentAuth(session) {
+  return Date.now() - session.authenticatedAt < REAUTH_WINDOW_MS;
+}
+
+function requireRecentAuth(session) {
+  if (!hasRecentAuth(session)) {
+    throw new HttpError(403, 'Please confirm it’s you to continue.', 'reauth_required');
+  }
+}
+
+function publicUser(user) {
+  return {
+    id: user.id,
+    email: user.email,
+    displayName: user.displayName,
+    createdAt: user.createdAt,
+  };
+}
+
+function publicPasskey(cred, session) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    provider: describeAuthenticator(cred.aaguid),
+    synced: cred.backedUp,
+    deviceType: cred.deviceType,
+    createdAt: cred.createdAt,
+    lastUsedAt: cred.lastUsedAt,
+    currentSession: cred.id === session?.signInCredentialId,
+  };
+}
+
+function sessionPayload(session) {
+  const user = session?.userId ? store.getUser(session.userId) : null;
+  return {
+    rpId: RP_ID,
+    user: user ? publicUser(user) : null,
+    // Relative, so the browser isn't affected by clock differences between client and server.
+    reauthExpiresInMs: user && hasRecentAuth(session) ? session.authenticatedAt + REAUTH_WINDOW_MS - Date.now() : 0,
+  };
+}
+
+function toWebAuthnCredential(cred) {
+  return {
+    id: cred.id,
+    publicKey: new Uint8Array(Buffer.from(cred.publicKey, 'base64url')),
+    counter: cred.counter,
+    transports: cred.transports,
+  };
+}
+
+function ensureCredentialResponse(body) {
+  const response = body?.response;
+  if (!response || typeof response !== 'object' || typeof response.id !== 'string' || !response.response) {
+    throw new HttpError(400, 'Missing passkey response.');
+  }
+  return response;
+}
+
+async function verifyRegistration(response, challenge) {
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: challenge,
+      expectedOrigin: ORIGINS,
+      expectedRPID: RP_ID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    throw new HttpError(400, `We couldn’t verify that passkey: ${err.message}`);
+  }
+  if (!verification.verified) throw new HttpError(400, 'We couldn’t verify that passkey.');
+  const info = verification.registrationInfo;
+  if (store.getCredential(info.credential.id)) throw new HttpError(409, 'That passkey is already registered.');
+  return info;
+}
+
+function newCredentialRecord(info, userId, transportsFromClient) {
+  const now = new Date().toISOString();
+  const transports = info.credential.transports?.length ? info.credential.transports : transportsFromClient;
+  return {
+    id: info.credential.id,
+    userId,
+    publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+    counter: info.credential.counter,
+    transports: Array.isArray(transports) ? transports.filter((t) => typeof t === 'string') : [],
+    deviceType: info.credentialDeviceType,
+    backedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    name: describeAuthenticator(info.aaguid) ?? 'Passkey',
+    createdAt: now,
+    lastUsedAt: now,
+  };
+}
+
+/** Verify an assertion against a stored credential and record its use. */
+async function verifyAssertion(response, challenge, cred, { requireUserVerification }) {
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: challenge,
+      expectedOrigin: ORIGINS,
+      expectedRPID: RP_ID,
+      credential: toWebAuthnCredential(cred),
+      requireUserVerification,
+    });
+  } catch (err) {
+    throw new HttpError(400, `We couldn’t verify that passkey: ${err.message}`);
+  }
+  if (!verification.verified) throw new HttpError(400, 'We couldn’t verify that passkey.');
+  const info = verification.authenticationInfo;
+  await store.saveCredential({
+    ...cred,
+    counter: info.newCounter,
+    backedUp: info.credentialBackedUp,
+    deviceType: info.credentialDeviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+}
+
+function sameUserHandle(a, b) {
+  const x = Buffer.from(a, 'base64url');
+  const y = Buffer.from(b, 'base64url');
+  return x.length === y.length && timingSafeEqual(x, y);
+}
+
+// ---------------------------------------------------------------------------
+// API routes
+// ---------------------------------------------------------------------------
+const routes = [];
+const route = (method, pattern, handler) => routes.push({ method, pattern, handler });
+
+route('GET', '/api/session', async ({ session }) => sessionPayload(session));
+
+// --- Registration: create a new customer account secured by a passkey -------
+route('POST', '/api/register/options', async ({ req, res, session }) => {
+  if (session?.userId && store.getUser(session.userId)) {
+    throw new HttpError(409, 'You’re already signed in.');
+  }
+  const body = await readJson(req);
+  const email = normalizeEmail(body.email);
+  const displayName = normalizeDisplayName(body.displayName);
+  if (store.findUserByEmail(email)) {
+    throw new HttpError(409, 'An account with that email already exists. Try signing in with your passkey.', 'email_taken');
+  }
+  session = session ?? getSession(req, res, { create: true });
+
+  const userId = randomBytes(16).toString('base64url');
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: new Uint8Array(Buffer.from(userId, 'base64url')),
+    userName: email,
+    userDisplayName: displayName,
+    timeout: WEBAUTHN_TIMEOUT_MS,
+    attestationType: 'none',
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+    extensions: { credProps: true },
+  });
+  rememberChallenge(session, options.challenge, 'register', { userId, email, displayName });
+  return options;
+});
+
+route('POST', '/api/register/verify', async ({ req, res, session }) => {
+  const body = await readJson(req);
+  const response = ensureCredentialResponse(body);
+  const { challenge, data } = consumeChallenge(session, response, 'register');
+
+  const info = await verifyRegistration(response, challenge);
+  // Re-check in case someone else claimed the email while the ceremony was running.
+  if (store.findUserByEmail(data.email)) {
+    throw new HttpError(409, 'An account with that email already exists. Try signing in with your passkey.', 'email_taken');
+  }
+  const now = new Date().toISOString();
+  const user = { id: data.userId, email: data.email, displayName: data.displayName, createdAt: now, updatedAt: now };
+  const cred = newCredentialRecord(info, user.id, response.response.transports);
+  await store.createUserWithCredential(user, cred);
+
+  const newSess = startAuthenticatedSession(res, session, user.id, cred.id);
+  return sessionPayload(newSess);
+});
+
+// --- Sign-in with a discoverable passkey (button or autofill) ----------------
+route('POST', '/api/login/options', async ({ req, res, session }) => {
+  session = session ?? getSession(req, res, { create: true });
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    timeout: WEBAUTHN_TIMEOUT_MS,
+    userVerification: 'preferred',
+  });
+  rememberChallenge(session, options.challenge, 'login');
+  return options;
+});
+
+route('POST', '/api/login/verify', async ({ req, res, session }) => {
+  const body = await readJson(req);
+  const response = ensureCredentialResponse(body);
+  const { challenge } = consumeChallenge(session, response, 'login');
+
+  const cred = store.getCredential(response.id);
+  const user = cred ? store.getUser(cred.userId) : null;
+  if (!cred || !user) {
+    // Lets the browser/password manager hide this stale passkey (Signal API).
+    throw new HttpError(404, 'That passkey isn’t registered with The Daily Grind anymore. Try another one, or create an account.',
+      'unknown_credential', { credentialId: response.id });
+  }
+  const userHandle = response.response.userHandle;
+  if (userHandle && !sameUserHandle(userHandle, user.id)) {
+    throw new HttpError(400, 'That passkey doesn’t match this account.');
+  }
+  await verifyAssertion(response, challenge, cred, { requireUserVerification: false });
+
+  const newSess = startAuthenticatedSession(res, session, user.id, cred.id);
+  return { ...sessionPayload(newSess), acceptedCredentialIds: store.listCredentials(user.id).map((c) => c.id) };
+});
+
+route('POST', '/api/logout', async ({ res, session }) => {
+  if (session) sessions.delete(session.id);
+  clearSessionCookie(res);
+  return { ok: true };
+});
+
+// --- Reauthentication: prove it's still the account holder before sensitive changes
+route('POST', '/api/reauth/options', async ({ session }) => {
+  const user = requireUser(session);
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    timeout: WEBAUTHN_TIMEOUT_MS,
+    userVerification: 'required',
+    allowCredentials: store.listCredentials(user.id).map((c) => ({ id: c.id, transports: c.transports })),
+  });
+  rememberChallenge(session, options.challenge, 'reauth');
+  return options;
+});
+
+route('POST', '/api/reauth/verify', async ({ req, session }) => {
+  const user = requireUser(session);
+  const body = await readJson(req);
+  const response = ensureCredentialResponse(body);
+  const { challenge } = consumeChallenge(session, response, 'reauth');
+
+  const cred = store.getCredential(response.id);
+  if (!cred || cred.userId !== user.id) {
+    throw new HttpError(400, 'Please use a passkey saved to this account.', 'wrong_account');
+  }
+  await verifyAssertion(response, challenge, cred, { requireUserVerification: true });
+  session.authenticatedAt = Date.now();
+  return sessionPayload(session);
+});
+
+// --- Profile -----------------------------------------------------------------
+route('PATCH', '/api/profile', async ({ req, session }) => {
+  const user = requireUser(session);
+  const body = await readJson(req);
+  const updated = { ...user };
+
+  if (body.displayName !== undefined) updated.displayName = normalizeDisplayName(body.displayName);
+  if (body.email !== undefined) {
+    const email = normalizeEmail(body.email);
+    if (email !== user.email) {
+      // Changing the sign-in identifier is sensitive: require a fresh passkey check.
+      requireRecentAuth(session);
+      const other = store.findUserByEmail(email);
+      if (other && other.id !== user.id) throw new HttpError(409, 'Another account already uses that email.');
+      updated.email = email;
+    }
+  }
+  updated.updatedAt = new Date().toISOString();
+  await store.saveUser(updated);
+  return sessionPayload(session);
+});
+
+// --- Saved passkeys ------------------------------------------------------------
+route('GET', '/api/passkeys', async ({ session }) => {
+  const user = requireUser(session);
+  return { passkeys: store.listCredentials(user.id).map((c) => publicPasskey(c, session)) };
+});
+
+route('POST', '/api/passkeys/options', async ({ session }) => {
+  const user = requireUser(session);
+  requireRecentAuth(session);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: new Uint8Array(Buffer.from(user.id, 'base64url')),
+    userName: user.email,
+    userDisplayName: user.displayName,
+    timeout: WEBAUTHN_TIMEOUT_MS,
+    attestationType: 'none',
+    // Prevents creating a second passkey on an authenticator that already has one for this account.
+    excludeCredentials: store.listCredentials(user.id).map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+    extensions: { credProps: true },
+  });
+  rememberChallenge(session, options.challenge, 'add-passkey');
+  return options;
+});
+
+route('POST', '/api/passkeys/verify', async ({ req, session }) => {
+  const user = requireUser(session);
+  requireRecentAuth(session);
+  const body = await readJson(req);
+  const response = ensureCredentialResponse(body);
+  const { challenge } = consumeChallenge(session, response, 'add-passkey');
+
+  const info = await verifyRegistration(response, challenge);
+  const cred = newCredentialRecord(info, user.id, response.response.transports);
+  await store.saveCredential(cred);
+  return { passkey: publicPasskey(cred, session) };
+});
+
+route('PATCH', /^\/api\/passkeys\/([A-Za-z0-9_-]+)$/, async ({ req, session, params }) => {
+  const user = requireUser(session);
+  const cred = store.getCredential(params[0]);
+  if (!cred || cred.userId !== user.id) throw new HttpError(404, 'Passkey not found.');
+  const body = await readJson(req);
+  const saved = await store.saveCredential({ ...cred, name: normalizePasskeyName(body.name) });
+  return { passkey: publicPasskey(saved, session) };
+});
+
+route('DELETE', /^\/api\/passkeys\/([A-Za-z0-9_-]+)$/, async ({ session, params }) => {
+  const user = requireUser(session);
+  const cred = store.getCredential(params[0]);
+  if (!cred || cred.userId !== user.id) throw new HttpError(404, 'Passkey not found.');
+  requireRecentAuth(session);
+  const all = store.listCredentials(user.id);
+  if (all.length <= 1) {
+    throw new HttpError(400, 'You can’t remove your only passkey — add another one first so you don’t get locked out.', 'last_passkey');
+  }
+  await store.deleteCredential(cred.id);
+  if (session.signInCredentialId === cred.id) session.signInCredentialId = null;
+  return { acceptedCredentialIds: all.filter((c) => c.id !== cred.id).map((c) => c.id) };
+});
+
+// ---------------------------------------------------------------------------
+// Static files
+// ---------------------------------------------------------------------------
+const PAGES = { '/': 'index.html', '/index.html': 'index.html', '/account': 'account.html', '/account/': 'account.html' };
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+async function serveStatic(req, res, pathname) {
+  let rel = PAGES[pathname];
+  if (!rel) {
+    if (!/^\/(css|js|img)\/[A-Za-z0-9._/-]+$/.test(pathname) || pathname.includes('..')) return false;
+    rel = pathname.slice(1);
+  }
+  const file = path.join(PUBLIC_DIR, rel);
+  if (!file.startsWith(PUBLIC_DIR + path.sep)) return false;
+  let content;
+  try {
+    content = await readFile(file);
+  } catch {
+    return false;
+  }
+  res.writeHead(200, {
+    'Content-Type': MIME[path.extname(file)] || 'application/octet-stream',
+    'Cache-Control': rel.endsWith('.html') ? 'no-cache' : 'public, max-age=300',
+  });
+  res.end(req.method === 'HEAD' ? undefined : content);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Server
+// ---------------------------------------------------------------------------
+function setSecurityHeaders(res) {
+  res.setHeader(
+    'Content-Security-Policy',
+    "default-src 'self'; img-src 'self' https://images.unsplash.com data:; style-src 'self'; script-src 'self'; " +
+      "connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
+  );
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'same-origin');
+  // WebAuthn is only allowed in this top-level document.
+  res.setHeader('Permissions-Policy', 'publickey-credentials-get=(self), publickey-credentials-create=(self)');
+}
+
+export async function handle(req, res) {
+  setSecurityHeaders(res);
+  const url = new URL(req.url, 'http://internal');
+  const pathname = url.pathname;
+
+  if (pathname.startsWith('/api/')) {
+    try {
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        // CSRF defence in depth (on top of SameSite cookies and JSON-only bodies).
+        if (!ORIGINS.includes(req.headers.origin)) throw new HttpError(403, 'Cross-origin request blocked.');
+      }
+      for (const r of routes) {
+        if (r.method !== req.method) continue;
+        const match = typeof r.pattern === 'string' ? r.pattern === pathname && [] : r.pattern.exec(pathname)?.slice(1);
+        if (!match) continue;
+        const session = getSession(req, res);
+        const result = await r.handler({ req, res, session, params: match });
+        return sendJson(res, 200, result);
+      }
+      throw new HttpError(404, 'Not found.');
+    } catch (err) {
+      if (err instanceof HttpError) {
+        return sendJson(res, err.status, { error: err.message, code: err.code, ...err.extra });
+      }
+      console.error(err);
+      return sendJson(res, 500, { error: 'Something went wrong. Please try again.' });
+    }
+  }
+
+  if (pathname === '/logout' && (req.method === 'GET' || req.method === 'HEAD')) {
+    // Plain-link fallback for the nav "Logout" button when JavaScript is unavailable.
+    const session = getSession(req, res);
+    if (session) sessions.delete(session.id);
+    clearSessionCookie(res);
+    res.writeHead(303, { Location: '/' });
+    return res.end();
+  }
+
+  if ((req.method === 'GET' || req.method === 'HEAD') && (await serveStatic(req, res, pathname))) return;
+
+  res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+  res.end('Not found');
+}
+
+export const config = { PORT, RP_ID, ORIGINS };
