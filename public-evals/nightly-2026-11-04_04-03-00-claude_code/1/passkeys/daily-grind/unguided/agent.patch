@@ -0,0 +1,60 @@
+// Tiny JSON-file persistence layer for customers and their passkeys.
+// Writes are atomic (temp file + rename) and serialized through a promise chain.
+import { mkdirSync, readFileSync, existsSync } from 'node:fs';
+import { writeFile, rename } from 'node:fs/promises';
+import path from 'node:path';
+
+export function createStore(file) {
+  mkdirSync(path.dirname(file), { recursive: true });
+
+  /** @type {{ users: Record<string, any>, credentials: Record<string, any> }} */
+  let db = { users: {}, credentials: {} };
+  if (existsSync(file)) {
+    db = JSON.parse(readFileSync(file, 'utf8'));
+    db.users ??= {};
+    db.credentials ??= {};
+  }
+
+  let writing = Promise.resolve();
+  function persist() {
+    const snapshot = JSON.stringify(db, null, 2);
+    writing = writing.then(async () => {
+      const tmp = `${file}.${process.pid}.tmp`;
+      await writeFile(tmp, snapshot, { mode: 0o600 });
+      await rename(tmp, file);
+    });
+    return writing;
+  }
+
+  return {
+    getUser: (id) => db.users[id] ?? null,
+    findUserByEmail: (email) => Object.values(db.users).find((u) => u.email === email) ?? null,
+    async saveUser(user) {
+      db.users[user.id] = user;
+      await persist();
+      return user;
+    },
+
+    getCredential: (id) => db.credentials[id] ?? null,
+    listCredentials: (userId) =>
+      Object.values(db.credentials)
+        .filter((c) => c.userId === userId)
+        .sort((a, b) => a.createdAt.localeCompare(b.createdAt)),
+    async saveCredential(cred) {
+      db.credentials[cred.id] = cred;
+      await persist();
+      return cred;
+    },
+    async deleteCredential(id) {
+      delete db.credentials[id];
+      await persist();
+    },
+
+    /** Create a user together with their first passkey in one write. */
+    async createUserWithCredential(user, cred) {
+      db.users[user.id] = user;
+      db.credentials[cred.id] = cred;
+      await persist();
+    },
+  };
+}
