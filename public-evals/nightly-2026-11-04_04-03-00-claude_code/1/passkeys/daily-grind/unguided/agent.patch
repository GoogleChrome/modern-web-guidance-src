+// --- Tests ------------------------------------------------------------------------
+test('full passkey account lifecycle', async () => {
+  const browser = new Browser();
+  const laptop = new Passkey();
+  const phone = new Passkey({ backedUp: false });
+
+  // Signed out
+  let r = await browser.call('GET', '/api/session');
+  assert.equal(r.json.user, null);
+  assert.equal(r.json.rpId, RP_ID);
+
+  // Registration
+  r = await browser.call('POST', '/api/register/options', { body: { email: ' Ada@Example.com ', displayName: 'Ada  Lovelace' } });
+  assert.equal(r.status, 200, r.text);
+  assert.equal(r.json.user.name, 'ada@example.com');
+  assert.equal(r.json.authenticatorSelection.residentKey, 'required');
+  const preSignupSid = [...browser.cookies.values()][0];
+  r = await browser.call('POST', '/api/register/verify', { body: { response: laptop.create(r.json) } });
+  assert.equal(r.status, 200, r.text);
+  assert.equal(r.json.user.displayName, 'Ada Lovelace');
+  assert.ok(r.json.reauthExpiresInMs > 0, 'sign-up counts as a fresh authentication');
+  assert.notEqual([...browser.cookies.values()][0], preSignupSid, 'session id rotated on sign-in');
+  const userId = r.json.user.id;
+  assert.equal(userId, laptop.userHandle);
+
+  r = await browser.call('GET', '/api/passkeys');
+  assert.equal(r.json.passkeys.length, 1);
+  assert.equal(r.json.passkeys[0].name, 'iCloud Keychain');
+  assert.equal(r.json.passkeys[0].synced, true);
+  assert.equal(r.json.passkeys[0].currentSession, true);
+
+  // Can't remove the only passkey
+  r = await browser.call('DELETE', `/api/passkeys/${b64u(laptop.id)}`);
+  assert.equal(r.status, 400);
+  assert.equal(r.json.code, 'last_passkey');
+
+  // Add a second passkey (within the reauth window); existing passkey is excluded
+  r = await browser.call('POST', '/api/passkeys/options');
+  assert.equal(r.status, 200, r.text);
+  assert.deepEqual(r.json.excludeCredentials.map((c) => c.id), [b64u(laptop.id)]);
+  assert.equal(r.json.user.id, userId);
+  r = await browser.call('POST', '/api/passkeys/verify', { body: { response: phone.create(r.json) } });
+  assert.equal(r.status, 200, r.text);
+  assert.equal(r.json.passkey.synced, false);
+
+  // Re-registering the same credential is rejected
+  r = await browser.call('POST', '/api/passkeys/options');
+  r = await browser.call('POST', '/api/passkeys/verify', { body: { response: phone.create(r.json) } });
+  assert.equal(r.status, 409);
+
+  // Rename
+  r = await browser.call('PATCH', `/api/passkeys/${b64u(phone.id)}`, { body: { name: '  Ada’s phone ' } });
+  assert.equal(r.status, 200, r.text);
+  assert.equal(r.json.passkey.name, 'Ada’s phone');
+
+  // Reauth window expires
+  const restore = advanceClock(10 * 60 * 1000);
+  try {
+    r = await browser.call('GET', '/api/session');
+    assert.equal(r.json.reauthExpiresInMs, 0);
+
+    r = await browser.call('DELETE', `/api/passkeys/${b64u(phone.id)}`);
+    assert.equal(r.status, 403);
+    assert.equal(r.json.code, 'reauth_required');
+    r = await browser.call('POST', '/api/passkeys/options');
+    assert.equal(r.json.code, 'reauth_required');
+    r = await browser.call('PATCH', '/api/profile', { body: { email: 'ada@newmail.com', displayName: 'Ada' } });
+    assert.equal(r.json.code, 'reauth_required');
+
+    // Name-only changes don't need reauth
+    r = await browser.call('PATCH', '/api/profile', { body: { email: 'ADA@example.com', displayName: 'Countess Ada' } });
+    assert.equal(r.status, 200, r.text);
+    assert.equal(r.json.user.displayName, 'Countess Ada');
+
+    // Reauth requires user verification
+    r = await browser.call('POST', '/api/reauth/options');
+    assert.equal(r.json.userVerification, 'required');
+    assert.equal(r.json.allowCredentials.length, 2);
+    let bad = await browser.call('POST', '/api/reauth/verify', { body: { response: phone.get(r.json, { uv: false }) } });
+    assert.equal(bad.status, 400);
+
+    // A passkey from another account is rejected
+    r = await browser.call('POST', '/api/reauth/options');
+    bad = await browser.call('POST', '/api/reauth/verify', { body: { response: new Passkey().get(r.json) } });
+    assert.equal(bad.json.code, 'wrong_account');
+
+    // Successful reauth unlocks sensitive changes
+    r = await browser.call('POST', '/api/reauth/options');
+    r = await browser.call('POST', '/api/reauth/verify', { body: { response: phone.get(r.json) } });
+    assert.equal(r.status, 200, r.text);
+    assert.ok(r.json.reauthExpiresInMs > 0);
+
+    r = await browser.call('PATCH', '/api/profile', { body: { email: 'ada@newmail.com', displayName: 'Countess Ada' } });
+    assert.equal(r.status, 200, r.text);
+    assert.equal(r.json.user.email, 'ada@newmail.com');
+
+    r = await browser.call('DELETE', `/api/passkeys/${b64u(phone.id)}`);
+    assert.equal(r.status, 200, r.text);
+    assert.deepEqual(r.json.acceptedCredentialIds, [b64u(laptop.id)]);
+  } finally {
+    restore();
+  }
+
+  // Sign out
+  r = await browser.call('POST', '/api/logout');
+  assert.equal(r.status, 200);
+  r = await browser.call('GET', '/api/passkeys');
+  assert.equal(r.status, 401);
+
+  // Sign in with the removed passkey -> unknown credential (client signals the provider)
+  r = await browser.call('POST', '/api/login/options');
+  assert.equal(r.json.allowCredentials, undefined, 'discoverable credential flow');
+  r = await browser.call('POST', '/api/login/verify', { body: { response: phone.get(r.json) } });
+  assert.equal(r.status, 404);
+  assert.equal(r.json.code, 'unknown_credential');
+  assert.equal(r.json.credentialId, b64u(phone.id));
+
+  // Sign in with the remaining passkey
+  r = await browser.call('POST', '/api/login/options');
+  const assertion = laptop.get(r.json);
+  r = await browser.call('POST', '/api/login/verify', { body: { response: assertion } });
+  assert.equal(r.status, 200, r.text);
+  assert.equal(r.json.user.email, 'ada@newmail.com');
+  assert.deepEqual(r.json.acceptedCredentialIds, [b64u(laptop.id)]);
+
+  // Replaying the same assertion fails (single-use challenge)
+  r = await browser.call('POST', '/api/login/verify', { body: { response: assertion } });
+  assert.equal(r.json.code, 'challenge_expired');
+
+  // Data is persisted
+  const db = JSON.parse(readFileSync(process.env.DATA_FILE, 'utf8'));
+  assert.equal(Object.keys(db.credentials).length, 1);
+  assert.equal(db.credentials[b64u(laptop.id)].counter, 1);
+});
+
+test('concurrent sign-in ceremonies (autofill + button) both work', async () => {
+  const browser = new Browser();
+  const key = new Passkey();
+  let r = await browser.call('POST', '/api/register/options', { body: { email: 'grace@example.com', displayName: 'Grace' } });
+  await browser.call('POST', '/api/register/verify', { body: { response: key.create(r.json) } });
+  await browser.call('POST', '/api/logout');
+
+  const autofill = (await browser.call('POST', '/api/login/options')).json;
+  const button = (await browser.call('POST', '/api/login/options')).json;
+  r = await browser.call('POST', '/api/login/verify', { body: { response: key.get(autofill) } });
+  assert.equal(r.status, 200, r.text);
+  assert.ok(button.challenge);
+});
+
+test('rejects duplicate emails, wrong origins, cross-site requests and bad input', async () => {
+  const browser = new Browser();
+  let r = await browser.call('POST', '/api/register/options', { body: { email: 'ada@newmail.com', displayName: 'Imposter' } });
+  assert.equal(r.status, 409);
+  assert.equal(r.json.code, 'email_taken');
+
+  r = await browser.call('POST', '/api/register/options', { body: { email: 'not-an-email', displayName: 'X' } });
+  assert.equal(r.status, 400);
+
+  r = await browser.call('POST', '/api/login/options', { origin: 'https://evil.example' });
+  assert.equal(r.status, 403);
+
+  // Phished assertion: signed for a different origin
+  const key = new Passkey();
+  r = await browser.call('POST', '/api/register/options', { body: { email: 'linus@example.com', displayName: 'Linus' } });
+  r = await browser.call('POST', '/api/register/verify', { body: { response: key.create(r.json, { origin: 'https://evil.example' }) } });
+  assert.equal(r.status, 400);
+
+  r = await browser.call('POST', '/api/register/verify', { body: { response: { id: 'x', response: { clientDataJSON: 'e30' } } } });
+  assert.equal(r.json.code, 'challenge_expired');
+
+  r = await browser.call('PATCH', '/api/profile', { body: { displayName: 'x' } });
+  assert.equal(r.status, 401);
+});
