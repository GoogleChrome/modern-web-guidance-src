+    /* ---------- Toast notifications ----------
+       Each toast is its own popover="manual", so the browser promotes it to
+       the top layer (above everything, no z-index needed).
+
+       Stacking is pure CSS anchor positioning: every toast both *is* an
+       anchor named --toast and *positions against* --toast. When several
+       elements share an anchor name, a positioned element resolves to the
+       last valid one before it — for top-layer elements, the toast opened
+       just before it. So each new toast sits on top of the previous one,
+       and the first toast (no valid anchor) uses the fallback offset. When
+       a toast is removed, the chain re-links automatically. */
+    .toast {
+      /* undo popover UA defaults */
+      inset: auto;
+      margin: 0;
+      border: none;
+      overflow: visible;
+
+      anchor-name: --toast;
+      position-anchor: --toast;
+      position: fixed;
+      right: 1.25rem;
+      bottom: calc(anchor(--toast top, 0.5rem) + 0.75rem);
+
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-width: 220px;
+      max-width: calc(100vw - 2.5rem);
+      padding: 0.85rem 0.85rem 0.85rem 1rem;
+      background: var(--primary);
+      color: white;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      font-size: 0.95rem;
+
+      /* exit / resting state transitions */
+      opacity: 0;
+      translate: 0 1rem;
+      scale: 0.95;
+      transition:
+        opacity 0.3s ease,
+        translate 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
+        scale 0.3s ease,
+        bottom 0.3s ease,
+        overlay 0.3s allow-discrete,
+        display 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      opacity: 1;
+      translate: 0 0;
+      scale: 1;
+    }
+
+    /* entry animation start point */
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        translate: 2rem 0;
+        scale: 0.95;
+      }
+    }
+
+    .toast-icon {
