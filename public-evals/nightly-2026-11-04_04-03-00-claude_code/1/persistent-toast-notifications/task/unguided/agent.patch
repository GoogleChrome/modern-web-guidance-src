+  <script>
+    (() => {
+      const DURATION = 3000;
+
+      function dismiss(toast) {
+        if (toast.dataset.state === 'closing') return;
+        toast.dataset.state = 'closing';
+        clearTimeout(toast._timer);
+
+        const remove = () => toast.remove();
+        if (toast.matches(':popover-open')) {
+          // hidePopover() kicks off the CSS exit transition; remove after it.
+          toast.addEventListener('transitionend', (e) => {
+            if (e.target === toast && e.propertyName === 'opacity') remove();
+          });
+          toast.hidePopover();
+          setTimeout(remove, 600); // safety net if transitionend never fires
+        } else {
+          remove();
+        }
+      }
+
+      function showToast(message) {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.popover = 'manual';
+        toast.setAttribute('role', 'status');
+        toast.setAttribute('aria-live', 'polite');
+
+        const icon = document.createElement('span');
+        icon.className = 'toast-icon';
+        icon.setAttribute('aria-hidden', 'true');
+        icon.textContent = '\u2713';
+
+        const text = document.createElement('span');
+        text.className = 'toast-message';
+        text.textContent = message;
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Close notification');
+        close.innerHTML = '&times;';
+        close.addEventListener('click', () => dismiss(toast));
+
+        toast.append(icon, text, close);
+        document.body.append(toast);
+        if (typeof toast.showPopover === 'function') toast.showPopover();
+
+        toast._timer = setTimeout(() => dismiss(toast), DURATION);
+      }
+
+      document.addEventListener('click', (e) => {
+        if (e.target.closest('.toast-trigger')) showToast('Added to cart!');
+      });
+    })();
+  </script>
+
