+    /* Toast notifications
+       Each toast is its own popover="manual" element, so the browser promotes it
+       to the top layer (above everything, no z-index needed). Toasts are appended
+       as direct children of <body>, after all other content, so
+       sibling-count() - sibling-index() equals the number of newer toasts and
+       drives the vertical offset — no wrapper container, no JS layout math. */
+    .toast {
+      --toast-h: 3.25rem;
+      --toast-gap: 0.75rem;
+      --toast-edge: 1.25rem;
+      --toast-index: 0;
+
+      /* Override the UA popover centering (inset: 0; margin: auto) */
+      position: fixed;
+      inset: auto var(--toast-edge) auto auto;
+      inset-block-end: calc(var(--toast-edge) + var(--toast-index) * (var(--toast-h) + var(--toast-gap)));
+      margin: 0;
+
+      align-items: center;
+      gap: 0.75rem;
+      block-size: var(--toast-h);
+      max-inline-size: calc(100vw - 2 * var(--toast-edge));
+      padding: 0 0.5rem 0 1rem;
+      border: 0;
+      border-inline-start: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+
+      /* Let clicks pass through to the page; only the close button is interactive */
+      pointer-events: none;
+
+      /* Closed / exit state */
+      opacity: 0;
+      translate: calc(100% + var(--toast-edge)) 0;
+
+      transition-property: opacity, translate, inset-block-end, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+      transition-behavior: allow-discrete; /* after the longhands so it isn't reset */
+    }
+
+    /* Keep display while open, including during the data-closing exit fallback */
+    .toast:is(:popover-open, .\:popover-open) {
+      display: flex;
+    }
+
+    /* Open state + entry animation */
+    .toast:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+      opacity: 1;
+      translate: 0 0;
+
+      @starting-style {
+        opacity: 0;
+        translate: calc(100% + var(--toast-edge)) 0;
+      }
+    }
+
+    /* Count newer toasts after this one (they're always the last body children) */
+    @supports (order: calc(sibling-index() - sibling-count())) {
+      .toast {
+        --toast-index: calc(sibling-count() - sibling-index());
+      }
+    }
+
+    /* Fallback without sibling-index(): sibling combinators */
+    @supports not (order: calc(sibling-index() - sibling-count())) {
+      .toast:has(+ .toast) { --toast-index: 1; }
+      .toast:has(+ .toast + .toast) { --toast-index: 2; }
+      .toast:has(+ .toast + .toast + .toast) { --toast-index: 3; }
+      .toast:has(+ .toast + .toast + .toast + .toast) { --toast-index: 4; }
+      .toast:has(+ .toast + .toast + .toast + .toast + .toast) { --toast-index: 5; }
+    }
+
