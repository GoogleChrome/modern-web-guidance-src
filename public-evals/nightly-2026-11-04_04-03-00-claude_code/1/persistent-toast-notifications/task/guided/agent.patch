+  <script type="module">
+    // Load the Popover polyfill only where native support is missing
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    const TOAST_DURATION = 3000;
+
+    // Firefox parses allow-discrete but can't transition `display` (and lacks
+    // `overlay`), so detect real support and fall back to a data-closing exit.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.prepend(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    const supportsTopLayerExit = () =>
+      Boolean(window.CSS?.supports?.('overlay', 'auto')) && canTransitionDisplay();
+
+    async function settle(el) {
+      const animations = el.getAnimations({ subtree: true });
+      if (!animations.length) return;
+      await Promise.race([
+        Promise.allSettled(animations.map((a) => a.finished)),
+        new Promise((r) => setTimeout(r, 1000)),
+      ]);
+    }
+
+    async function closeToast(toast) {
+      if (toast.dataset.state === 'closing') return;
+      toast.dataset.state = 'closing';
+      clearTimeout(toast._timer);
+
+      if (!supportsTopLayerExit()) {
+        // Animate out while still in the top layer, then hide
+        toast.setAttribute('data-closing', '');
+        await settle(toast);
+      }
+
+      toast.hidePopover();
+      await settle(toast);
+      // Removing the node lets the remaining toasts re-stack via sibling-index()
+      toast.remove();
+    }
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.setAttribute('popover', 'manual');
+      toast.setAttribute('role', 'status');
+      toast.setAttribute('aria-atomic', 'true');
+
+      const text = document.createElement('span');
+      text.className = 'toast-message';
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('aria-label', 'Dismiss notification');
+      close.textContent = '\u00d7';
+      close.addEventListener('click', () => closeToast(toast));
+
+      toast.append(text, close);
+      // Must be the last child of <body> so the CSS stacking offset works
+      document.body.append(toast);
+      toast.showPopover();
+
+      toast._timer = setTimeout(() => closeToast(toast), TOAST_DURATION);
+    }
+
+    document.addEventListener('click', (event) => {
+      if (event.target.closest('.toast-trigger')) {
+        showToast('Added to cart!');
+      }
+    });
+  </script>
