@@ -4,4 +4,26 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+/*
+ * Cached, inactive SPA views (see src/scripts/view-cache.ts).
+ * content-visibility: hidden skips layout and paint for the view's contents
+ * but keeps their rendering state, so reactivating a view is nearly instant.
+ * position: absolute takes the (zero-sized, size-contained) box out of flow.
+ */
+[data-spa-view][data-spa-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+}
+
+@supports not (content-visibility: hidden) {
+  [data-spa-view][data-spa-inactive] {
+    display: none;
+  }
+}
+
+/* Views receive programmatic focus on navigation; don't draw a ring around the whole page. */
+[data-spa-view]:focus {
+  outline: none;
+}
