+              </div>`).join('');
+
+            const render = () => {
+              $(el, '[data-points]').textContent = points;
+              const pct = Math.min(100, Math.round((points / GOLD) * 100));
+              progress.firstElementChild.style.width = `${pct}%`;
+              progress.setAttribute('aria-valuenow', pct);
+              $(el, '[data-tier-note]').textContent = points >= GOLD
+                ? 'You have reached Gold tier!'
+                : `${GOLD - points} beans to Gold tier`;
+              $$(grid, '[data-redeem]').forEach((b) => {
+                b.disabled = REWARDS.find((r) => r.id === b.dataset.redeem).cost > points;
+              });
+            };
+
+            grid.addEventListener('click', (e) => {
+              const btn = e.target.closest('[data-redeem]');
+              if (!btn || btn.disabled) return;
+              const r = REWARDS.find((x) => x.id === btn.dataset.redeem);
+              points -= r.cost;
+              status.textContent = `Redeemed: ${r.name}. Show this screen at the counter.`;
+              render();
+            });
+            render();
+          },
+        },
+
+        account: {
+          title: 'My Account',
+          template: 'view-account',
+          setup(el) {
+            const form = $(el, '[data-profile]');
+            const status = $(el, '[data-status]');
+            form.addEventListener('input', () => { status.textContent = 'Unsaved changes'; });
+            form.addEventListener('submit', (e) => {
+              e.preventDefault();
+              status.textContent = 'Profile saved.';
+            });
+          },
+        },
+
+        'not-found': { title: 'Page Not Found', template: 'view-not-found' },
+      };
+
+      // ---------- Router with keep-alive view cache ----------
+      const app = document.getElementById('app');
+      const navLinks = $$(document, 'nav a[data-route]');
+      const cache = new Map(); // name -> { el, hooks, scrollY }
+      let current = null;
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      const parse = () => {
+        const parts = location.hash.replace(/^#\/?/, '').split('/').filter(Boolean);
+        const name = parts[0] || 'home';
+        return { name: VIEWS[name] && name !== 'not-found' ? name : 'not-found', param: parts[1] ? decodeURIComponent(parts[1]) : null };
+      };
+
+      // Build a view once; afterwards it's served from the cache.
+      const getView = (name) => {
+        let entry = cache.get(name);
+        if (entry) return { entry, fresh: false };
+        const def = VIEWS[name];
+        let el = app.querySelector(`[data-view="${name}"]`); // home is pre-rendered
+        if (!el) {
+          el = document.getElementById(def.template).content.firstElementChild.cloneNode(true);
+          el.hidden = true;
+          app.appendChild(el);
+        }
+        entry = { el, hooks: (def.setup && def.setup(el)) || {}, scrollY: 0 };
+        cache.set(name, entry);
+        return { entry, fresh: true };
+      };
+
+      const render = () => {
+        const { name, param } = parse();
+        const { entry, fresh } = getView(name);
+        const switching = current !== entry;
+
+        if (current && switching) {
+          // Park the outgoing view offscreen: DOM, listeners, form input and
+          // internal state all survive; we only remember where the user was.
+          current.scrollY = window.scrollY;
+          current.el.hidden = true;
+          current.hooks.hide && current.hooks.hide();
+        }
+
+        entry.el.hidden = false;
+        current = entry;
+
+        const handledScroll = entry.hooks.show ? entry.hooks.show(param) === true : false;
+        if (!handledScroll && switching) window.scrollTo(0, fresh ? 0 : entry.scrollY);
+
+        navLinks.forEach((a) => {
+          if (a.dataset.route === name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+        document.title = `The Daily Grind | ${VIEWS[name].title}`;
+        if (switching && document.activeElement !== document.body) entry.el.focus({ preventScroll: true });
+      };
+
+      window.addEventListener('hashchange', render);
+
+      // If a stock photo fails to load, keep the tinted placeholder box instead of a broken icon.
+      app.addEventListener('error', (e) => {
+        if (e.target.tagName === 'IMG') e.target.style.visibility = 'hidden';
+      }, true);
+
+      // Prefetch view markup during idle time so first visits are instant too.
+      const warm = () => Object.keys(VIEWS).forEach((n) => { if (n !== 'not-found') getView(n); });
+      render();
+      ('requestIdleCallback' in window ? requestIdleCallback : (cb) => setTimeout(cb, 300))(warm);
+    })();
+  </script>
+
 </body>
 
 </html>
