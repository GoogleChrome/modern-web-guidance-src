+  <script>
+    (() => {
+      const app = document.getElementById('app');
+      const SITE = 'The Daily Grind';
+
+      // Small, fixed set of views -> caching every view is safe (no LRU needed).
+      const ROUTES = {
+        home: { title: `${SITE} | Artisanal Coffee` },
+        menu: { title: `Menu | ${SITE}`, init: initMenu },
+        locations: { title: `Locations | ${SITE}`, init: initLocations },
+        rewards: { title: `Rewards | ${SITE}`, init: initRewards },
+        account: { title: `My Account | ${SITE}`, init: initAccount },
+      };
+
+      /** @type {Map<string, HTMLElement>} cached, already-rendered views */
+      const views = new Map([['home', app.querySelector('[data-view="home"]')]]);
+      /** @type {Map<string, number>} per-view scroll positions */
+      const scrollPositions = new Map();
+      let current = null;
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      function parse(pathname) {
+        const [, first = '', sub = ''] = pathname.replace(/\/+$/, '').split('/');
+        if (first === '') return { name: 'home' };
+        return ROUTES[first] ? { name: first, sub } : null;
+      }
+
+      function getView(name) {
+        let view = views.get(name);
+        if (view) return view;
+        // First visit: build from template once; it is never destroyed afterwards.
+        view = document.createElement('div');
+        view.className = 'spa-view inactive';
+        view.dataset.view = name;
+        view.tabIndex = -1;
+        view.append(document.getElementById(`view-${name}`).content.cloneNode(true));
+        app.append(view);
+        ROUTES[name].init?.(view);
+        views.set(name, view);
+        return view;
+      }
+
+      function render({ name, sub }, { focus = true, scroll = 'restore' } = {}) {
+        const next = getView(name);
+
+        if (current && current !== next) {
+          scrollPositions.set(current.dataset.view, window.scrollY);
+          current.classList.add('inactive');
+          current.setAttribute('aria-hidden', 'true');
+          current.inert = true;
+        }
+
+        next.classList.remove('inactive');
+        next.removeAttribute('aria-hidden');
+        next.inert = false;
+        current = next;
+
+        document.title = ROUTES[name].title;
+        document.querySelectorAll('nav a').forEach((a) => {
+          const match = parse(new URL(a.href).pathname)?.name === name && a.hasAttribute('data-spa');
+          if (match) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        if (focus) next.focus({ preventScroll: true });
+
+        const target = sub && next.querySelector(`#${CSS.escape(`${name}-${sub}`)}`);
+        if (target) {
+          next.querySelectorAll('.highlight').forEach((el) => el.classList.remove('highlight'));
+          target.classList.add('highlight');
+          target.scrollIntoView({ block: 'center' });
+        } else if (scroll === 'restore') {
+          window.scrollTo(0, scrollPositions.get(name) ?? 0);
+        } else {
+          window.scrollTo(0, 0);
+        }
+      }
+
+      function navigate(route, opts) {
+        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+        if (document.startViewTransition && !reduceMotion && current) {
+          document.startViewTransition(() => render(route, opts));
+        } else {
+          render(route, opts);
+        }
+      }
+
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const a = e.target.closest('a[href]');
+        if (!a || a.target || a.hasAttribute('download')) return;
+        const url = new URL(a.href, location.href);
+        if (url.origin !== location.origin) return;
+        const route = parse(url.pathname);
+        if (!route) return; // not an SPA route (e.g. /logout) -> normal navigation
+        e.preventDefault();
+        if (url.pathname === location.pathname) {
+          if (route.sub) render(route, { focus: false });
+          return;
+        }
+        scrollPositions.set(current.dataset.view, window.scrollY);
+        history.pushState(null, '', url.pathname);
+        navigate(route, { scroll: route.sub ? 'restore' : 'top' });
+      });
+
+      // Back/forward: returning to a cached view restores its previous scroll position.
+      window.addEventListener('popstate', () => {
+        const route = parse(location.pathname) ?? { name: 'home' };
+        navigate(route, { scroll: 'restore' });
+      });
+
+      // Initial load (supports deep links when the server falls back to index.html).
+      render(parse(location.pathname) ?? { name: 'home' }, { focus: false });
+
+      // ---------------- View behaviour ----------------
+      function initMenu(view) {
+        const chips = view.querySelectorAll('[data-filter]');
+        const items = view.querySelectorAll('[data-category]');
+        view.querySelector('.filters').addEventListener('click', (e) => {
+          const chip = e.target.closest('[data-filter]');
+          if (!chip) return;
+          const filter = chip.dataset.filter;
+          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
+          items.forEach((item) => {
+            item.hidden = filter !== 'all' && item.dataset.category !== filter;
+          });
+        });
+      }
+
+      function initLocations(view) {
+        const input = view.querySelector('#location-search');
+        const items = view.querySelectorAll('[data-search]');
+        const empty = view.querySelector('[data-empty]');
+        input.addEventListener('input', () => {
+          const q = input.value.trim().toLowerCase();
+          let shown = 0;
+          items.forEach((li) => {
+            li.hidden = !li.dataset.search.includes(q);
+            if (!li.hidden) shown++;
+          });
+          empty.hidden = shown > 0;
+        });
+      }
+
+      function initRewards(view) {
+        const GOAL = 150;
+        let points = 120;
+        const pointsEl = view.querySelector('[data-points]');
+        const meter = view.querySelector('[data-meter]');
+        const remaining = view.querySelector('[data-remaining]');
+        const status = view.querySelector('[data-redeem-status]');
+        const buttons = view.querySelectorAll('[data-redeem]');
+        const update = () => {
+          pointsEl.textContent = points;
+          meter.value = Math.min(points, GOAL);
+          remaining.textContent = Math.max(GOAL - points, 0);
+          buttons.forEach((b) => { b.disabled = Number(b.dataset.redeem) > points; });
+        };
+        view.addEventListener('click', (e) => {
+          const btn = e.target.closest('[data-redeem]');
+          if (!btn) return;
+          const cost = Number(btn.dataset.redeem);
+          points -= cost;
+          status.textContent = `Redeemed ${btn.closest('.card').querySelector('h3').textContent} for ${cost} beans. Show this screen at the counter!`;
+          update();
+        });
+        update();
+      }
+
+      function initAccount(view) {
+        const form = view.querySelector('[data-account-form]');
+        const status = view.querySelector('[data-account-status]');
+        const KEY = 'daily-grind-account';
+        let saved = {};
+        try { saved = JSON.parse(localStorage.getItem(KEY)) ?? {}; } catch {}
+        const defaults = { name: 'Alex Rivera', email: 'alex@example.com', store: 'Downtown', usual: '', newsletter: true };
+        const data = { ...defaults, ...saved };
+        for (const [k, v] of Object.entries(data)) {
+          const field = form.elements[k];
+          if (!field) continue;
+          if (field.type === 'checkbox') field.checked = Boolean(v);
+          else field.value = v;
+        }
+        form.addEventListener('input', () => { status.textContent = 'Unsaved changes'; });
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const fd = new FormData(form);
+          const out = Object.fromEntries(fd);
+          out.newsletter = fd.has('newsletter');
+          try { localStorage.setItem(KEY, JSON.stringify(out)); } catch {}
+          status.textContent = 'Changes saved.';
+        });
+      }
+    })();
