+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var success = document.getElementById('newsletter-success');
+
+      // Errors stay hidden (visually and to AT) until the user has interacted:
+      // leaving the field after editing it, or attempting to submit.
+      var interacted = false;
+
+      function getErrorMessage() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: the visible message text IS the live region
+      // content, so screen readers announce exactly when the error appears and
+      // the announcement clears the moment the error disappears.
+      function render() {
+        var message = interacted ? getErrorMessage() : '';
+        // Only touch the DOM when the message actually changes, so repeated
+        // keystrokes don't re-announce the same error.
+        if (error.textContent !== message) {
+          error.textContent = message;
+        }
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+        return !message;
+      }
+
+      var dirty = false;
+
+      input.addEventListener('input', function () {
+        dirty = true;
+        success.textContent = '';
+        // Before interaction: stay silent. After an error is shown: re-validate
+        // live so the error clears as soon as the email becomes valid.
+        if (interacted) render();
+      });
+
+      input.addEventListener('blur', function () {
+        if (dirty) {
+          interacted = true;
+          render();
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        interacted = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        success.textContent = 'Thanks! You\'re subscribed with ' + input.value.trim() + '.';
+        form.reset();
+        interacted = false;
+        dirty = false;
+        render();
+      });
+    })();
+  </script>
+
