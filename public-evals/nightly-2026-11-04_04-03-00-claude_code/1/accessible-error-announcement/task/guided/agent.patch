+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const status = document.getElementById('newsletter-status');
+
+      const messageFor = (input) =>
+        input.validity.valueMissing
+          ? 'Enter your email address to subscribe.'
+          : 'Enter a valid email address, like name@example.com.';
+
+      // Mirror the browser's interaction-aware :user-invalid state (which drives
+      // the visual error styling) into aria-invalid and the live error region,
+      // so assistive tech hears the error exactly when it becomes visible and
+      // stops hearing it the moment the value becomes valid.
+      const syncError = () => {
+        const isUserInvalid = email.matches(':user-invalid');
+        const message = isUserInvalid ? messageFor(email) : '';
+
+        if (isUserInvalid) {
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+
+        // Only touch the live region when the text actually changes, so it is
+        // not re-announced on every keystroke.
+        if (error.textContent !== message) {
+          error.textContent = message;
+        }
+      };
+
+      // blur: user finished with the field. input: clear (or update) as they type.
+      email.addEventListener('blur', syncError);
+      email.addEventListener('input', () => {
+        status.textContent = '';
+        syncError();
+      });
+
+      // Failed submit attempt: suppress the native tooltip (our inline message
+      // replaces it), sync state, and move focus to the field.
+      email.addEventListener('invalid', (event) => {
+        event.preventDefault();
+        syncError();
+        // Re-check next frame in case the engine flips :user-invalid after
+        // dispatching 'invalid'.
+        requestAnimationFrame(syncError);
+        email.focus();
+      });
+
+      form.addEventListener('submit', (event) => {
+        // Demo only: no backend yet, so confirm inline instead of navigating.
+        event.preventDefault();
+        status.textContent = `Thanks! We'll send the next issue to ${email.value}.`;
+        form.reset();
+      });
+
+      form.addEventListener('reset', () => {
+        // reset clears the browser's user-interacted flag; clear our mirror too.
+        requestAnimationFrame(syncError);
+      });
+    })();
+  </script>
+
 </body>
 
