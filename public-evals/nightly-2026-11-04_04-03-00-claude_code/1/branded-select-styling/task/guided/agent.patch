+        border-radius: 4px;
+        cursor: pointer;
+        font-weight: 600;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background-color: #3e2723;
+        color: var(--accent);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        color: var(--accent);
+      }
+
+      .roast-select option::checkmark {
+        color: var(--accent);
+      }
+    }
