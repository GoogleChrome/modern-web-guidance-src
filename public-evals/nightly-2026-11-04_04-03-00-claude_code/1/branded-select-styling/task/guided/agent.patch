+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        justify-content: space-between;
+        align-items: center;
+        gap: 0.75rem;
+        background-image: none;
+        padding: 0.55rem 1rem;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--accent);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        background-color: var(--primary);
+        color: var(--light);
+        border: 2px solid var(--accent);
+        border-radius: 6px;
+        padding: 0.35rem;
+        margin-top: 0.35rem;
+        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
