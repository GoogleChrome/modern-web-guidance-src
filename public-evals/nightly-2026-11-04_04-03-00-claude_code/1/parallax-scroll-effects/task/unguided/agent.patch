+    /* Parallax Section
+       Pure CSS scroll-driven animations. The section exposes a named view
+       timeline that tracks its progress through the viewport; each layer
+       translates by a different amount over that timeline, so layers appear
+       to move at different speeds. Only `transform` is animated, which keeps
+       the work on the compositor (no layout/paint per frame). */
+    .parallax {
+      position: relative;
+      min-height: 90vh;
+      display: grid;
+      place-items: center;
+      overflow: clip; /* clip, not hidden: avoids creating a scroll container */
+      isolation: isolate;
+      background: var(--primary); /* shown while the photo loads */
+      color: white;
+      view-timeline: --parallax block;
+    }
+
+    .parallax__layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Layer 1 (farthest): photo, oversized so it can drift without gaps */
+    .parallax__layer--back {
+      inset: -20% 0;
+      z-index: -3;
+      background:
+        linear-gradient(rgba(30, 18, 14, 0.55), rgba(30, 18, 14, 0.75)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=80') center / cover no-repeat;
+    }
+
+    /* Layers 2 & 3: decorative coffee beans drawn in CSS */
+    .parallax__layer--mid {
+      z-index: -2;
+      filter: blur(2px);
+      opacity: 0.7;
+    }
+
+    .parallax__layer--near {
+      z-index: -1;
+    }
+
+    .bean {
+      position: absolute;
+      width: var(--size, 48px);
+      aspect-ratio: 3 / 4;
+      border-radius: 50%;
+      background: radial-gradient(ellipse at 35% 30%, #8d6e63, #4e342e 60%, #2d1b16);
+      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45);
+      rotate: var(--rot, 0deg);
+    }
+
+    .bean::after {
+      content: "";
+      position: absolute;
+      inset: 12% 46%;
+      border-radius: 50%;
+      background: #1f120e;
+    }
+
+    /* Layer 4 (closest): the readable content */
+    .parallax__content {
+      position: relative;
+      max-width: 640px;
+      margin: 0 20px;
+      padding: 2.5rem 2rem;
+      text-align: center;
+      background: rgba(30, 18, 14, 0.6);
+      border: 1px solid rgba(255, 171, 64, 0.35);
+      border-radius: 12px;
+      backdrop-filter: blur(4px);
+    }
+
+    .parallax__content h2 {
+      font-size: clamp(1.75rem, 4vw, 2.5rem);
+      margin-bottom: 0.75rem;
+    }
+
+    .parallax__content .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .parallax__content .btn:hover {
+      background: #ffc777;
+    }
+
+    .parallax__content .btn:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 3px;
+    }
+
+    @keyframes parallax-shift {
+      from { transform: translate3d(0, calc(var(--depth) * -1), 0); }
+      to   { transform: translate3d(0, var(--depth), 0); }
+    }
+
+    /* Motion is opt-in: only for users who haven't asked for reduced motion
+       and only in browsers that support scroll-driven animations. Everyone
+       else gets a fully readable, static layered section. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .parallax__layer,
+        .parallax__content {
+          will-change: transform;
+          animation: parallax-shift linear both;
+          animation-timeline: --parallax;
+          animation-range: cover 0% cover 100%;
+        }
+
+        /* Larger --depth = more travel = appears closer / faster */
+        .parallax__layer--back { --depth: 12vh; }
+        .parallax__layer--mid  { --depth: -6vh; }
+        .parallax__layer--near { --depth: -18vh; }
+        .parallax__content     { --depth: -4vh; }
+      }
+    }
+
+    @media (max-width: 600px) {
+      .parallax__layer--mid .bean:nth-child(n + 4),
+      .parallax__layer--near .bean:nth-child(n + 4) {
+        display: none;
+      }
+    }
+
