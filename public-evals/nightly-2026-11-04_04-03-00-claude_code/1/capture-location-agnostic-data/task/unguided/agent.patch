+  <script>
+    /*
+     * Both values are "floating" (location-agnostic) wall-clock values.
+     * They are stored as the raw strings the inputs produce
+     * ("HH:MM" and "YYYY-MM-DD") and are NEVER passed through Date
+     * parsing, toISOString(), or UTC conversion. That way 08:30 stays
+     * 08:30 and March 14 stays March 14 no matter what time zone the
+     * device is in when the page is loaded.
+     */
+    (function () {
+      var STORAGE_KEY = 'dailyGrindPrefs';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      var form = document.getElementById('prefs-form');
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('anniversary-date');
+      var timeDisplay = document.getElementById('pickup-display');
+      var dateDisplay = document.getElementById('anniversary-display');
+      var status = document.getElementById('prefs-status');
+
+      function load() {
+        try {
+          var data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
+          return {
+            pickupTime: TIME_RE.test(data.pickupTime) ? data.pickupTime : '',
+            anniversaryDate: parseDate(data.anniversaryDate) ? data.anniversaryDate : ''
+          };
+        } catch (e) {
+          return { pickupTime: '', anniversaryDate: '' };
+        }
+      }
+
+      function save(prefs) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+          return true;
+        } catch (e) {
+          return false;
+        }
+      }
+
+      function isLeap(y) {
+        return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+      }
+
+      function daysInMonth(y, m) {
+        return [31, isLeap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1];
+      }
+
+      // Parse "YYYY-MM-DD" into plain integers (no Date object involved).
+      function parseDate(str) {
+        var m = DATE_RE.exec(str || '');
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo)) return null;
+        return { y: y, m: mo, d: d };
+      }
+
+      function formatTime(str) {
+        var m = TIME_RE.exec(str || '');
+        if (!m) return '';
+        var h = +m[1];
+        var suffix = h < 12 ? 'AM' : 'PM';
+        var h12 = h % 12 === 0 ? 12 : h % 12;
+        return h12 + ':' + m[2] + ' ' + suffix;
+      }
+
+      function formatDate(p) {
+        return MONTHS[p.m - 1] + ' ' + p.d + ', ' + p.y;
+      }
+
+      // Day number from civil date, pure integer arithmetic (time zone free).
+      function dayNumber(y, m, d) {
+        var a = Math.floor((14 - m) / 12);
+        var yy = y + 4800 - a;
+        var mm = m + 12 * a - 3;
+        return d + Math.floor((153 * mm + 2) / 5) + 365 * yy +
+          Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) - 32045;
+      }
+
+      // Feb 29 anniversaries are observed on Feb 28 in non-leap years.
+      function anniversaryIn(year, p) {
+        var d = Math.min(p.d, daysInMonth(year, p.m));
+        return { y: year, m: p.m, d: d };
+      }
+
+      function describeAnniversary(str) {
+        var p = parseDate(str);
+        if (!p) return '';
+        // "Today" is read from the device's current local calendar day, so the
+        // countdown follows the traveller while the stored date never moves.
+        var now = new Date();
+        var ty = now.getFullYear(), tm = now.getMonth() + 1, td = now.getDate();
+        var today = dayNumber(ty, tm, td);
+        var start = dayNumber(p.y, p.m, p.d);
+        var text = formatDate(p);
+
+        if (start > today) {
+          var until = start - today;
+          return text + ' \u2014 ' + until + (until === 1 ? ' day' : ' days') + ' to go';
+        }
+
+        var next = anniversaryIn(ty, p);
+        if (dayNumber(next.y, next.m, next.d) < today) next = anniversaryIn(ty + 1, p);
+        var diff = dayNumber(next.y, next.m, next.d) - today;
+        var years = next.y - p.y;
+
+        if (diff === 0 && years > 0) {
+          return text + ' \u2014 Happy ' + years + '-year coffee anniversary! \u2615';
+        }
+        if (diff === 0) return text + ' \u2014 your coffee journey starts today!';
+        return text + ' \u2014 ' + years + (years === 1 ? ' year' : ' years') +
+          ' in ' + diff + (diff === 1 ? ' day' : ' days');
+      }
+
+      function render() {
+        timeDisplay.textContent = timeInput.value
+          ? 'Reminder every day at ' + formatTime(timeInput.value) + ' local time'
+          : '';
+        dateDisplay.textContent = describeAnniversary(dateInput.value);
+      }
+
+      var prefs = load();
+      timeInput.value = prefs.pickupTime;
+      dateInput.value = prefs.anniversaryDate;
+      render();
+
+      timeInput.addEventListener('input', render);
+      dateInput.addEventListener('input', render);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var t = timeInput.value;
+        var d = dateInput.value;
+        if (t && !TIME_RE.test(t)) {
+          status.style.color = '#c62828';
+          status.textContent = 'Please enter a valid pickup time.';
+          return;
+        }
+        if (d && !parseDate(d)) {
+          status.style.color = '#c62828';
+          status.textContent = 'Please enter a valid anniversary date.';
+          return;
+        }
+        var ok = save({ pickupTime: t, anniversaryDate: d });
+        status.style.color = ok ? '#2e7d32' : '#c62828';
+        status.textContent = ok ? 'Preferences saved!' : 'Could not save preferences on this device.';
+        render();
+      });
+    })();
+  </script>
+
 </body>
 
