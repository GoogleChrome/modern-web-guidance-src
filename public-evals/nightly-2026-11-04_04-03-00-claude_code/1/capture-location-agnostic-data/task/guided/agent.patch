+  <script type="module">
+    // Pickup time and anniversary are location-agnostic values: stored and handled as
+    // Temporal.PlainTime / Temporal.PlainDate ISO strings (e.g. "08:15", "2021-03-14"),
+    // never as Date instants, so they never shift when the user changes time zones.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrind.coffeePrefs';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const summary = document.getElementById('prefs-summary');
+
+    const today = () => Temporal.Now.plainDateISO();
+
+    function loadPrefs() {
+      try {
+        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (!raw) return null;
+        return {
+          pickupTime: Temporal.PlainTime.from(raw.pickupTime),
+          anniversary: Temporal.PlainDate.from(raw.anniversary),
+        };
+      } catch {
+        return null;
+      }
+    }
+
+    function savePrefs({ pickupTime, anniversary }) {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({
+        pickupTime: pickupTime.toString({ smallestUnit: 'minute' }),
+        anniversary: anniversary.toString(),
+      }));
+    }
+
+    function nextAnniversary(anniversary) {
+      const now = today();
+      const monthDay = anniversary.toPlainMonthDay();
+      // Feb 29 anniversaries are constrained to Feb 28 in non-leap years.
+      let next = monthDay.toPlainDate({ year: now.year });
+      if (Temporal.PlainDate.compare(next, now) < 0) {
+        next = monthDay.toPlainDate({ year: now.year + 1 });
+      }
+      return next;
+    }
+
+    function render(prefs) {
+      if (!prefs) {
+        summary.textContent = '';
+        return;
+      }
+      const { pickupTime, anniversary } = prefs;
+      const timeText = pickupTime.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      const dateText = anniversary.toLocaleString(undefined, { dateStyle: 'long' });
+      const next = nextAnniversary(anniversary);
+      const daysUntil = today().until(next, { largestUnit: 'day' }).days;
+      const years = next.year - anniversary.year;
+
+      let anniversaryText;
+      if (years <= 0) {
+        anniversaryText = `Your coffee journey starts on ${dateText}.`;
+      } else if (daysUntil === 0) {
+        anniversaryText = `Happy ${years}-year coffee anniversary! ☕ Your next drink is on us.`;
+      } else {
+        anniversaryText = `Your ${years}-year coffee anniversary is in ${daysUntil} day${daysUntil === 1 ? '' : 's'} (since ${dateText}).`;
+      }
+
+      summary.replaceChildren();
+      const p1 = document.createElement('p');
+      p1.textContent = `We'll remind you to pick up your coffee every day at ${timeText}, local time wherever you are.`;
+      const p2 = document.createElement('p');
+      p2.textContent = anniversaryText;
+      summary.append(p1, p2);
+    }
+
+    dateInput.max = today().toString();
+
+    const saved = loadPrefs();
+    if (saved) {
+      timeInput.value = saved.pickupTime.toString({ smallestUnit: 'minute' });
+      dateInput.value = saved.anniversary.toString();
+    }
+    render(saved);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!form.reportValidity()) return;
+      // Parse input values directly into Plain types — no Date, no time zone.
+      const prefs = {
+        pickupTime: Temporal.PlainTime.from(timeInput.value),
+        anniversary: Temporal.PlainDate.from(dateInput.value),
+      };
+      savePrefs(prefs);
+      render(prefs);
+    });
+  </script>
