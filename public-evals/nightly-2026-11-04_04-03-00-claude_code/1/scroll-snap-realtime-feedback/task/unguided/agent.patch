+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnails .thumbnail'));
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let pendingIndex = -1;
+
+      // scrollLeft at which an item is centered (clamped to the scrollable range).
+      function targetScrollLeft(item) {
+        const max = gallery.scrollWidth - gallery.clientWidth;
+        const left = item.offsetLeft + item.offsetWidth / 2 - gallery.clientWidth / 2;
+        return Math.max(0, Math.min(max, left));
+      }
+
+      function nearestIndex() {
+        let best = 0;
+        let bestDist = Infinity;
+        items.forEach(function (item, i) {
+          const d = Math.abs(targetScrollLeft(item) - gallery.scrollLeft);
+          if (d < bestDist) { bestDist = d; best = i; }
+        });
+        return best;
+      }
+
+      function setPending(index) {
+        if (index === pendingIndex || index < 0) return;
+        pendingIndex = index;
+        thumbs.forEach(function (t, i) { t.classList.toggle('pending', i === index); });
+      }
+
+      function setActive(index) {
+        pendingIndex = -1;
+        thumbs.forEach(function (t, i) {
+          t.classList.remove('pending');
+          const on = i === index;
+          t.classList.toggle('active', on);
+          if (on) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      // Mid-scroll feedback. Prefer the native snap-changing event, which reports
+      // the exact item the browser is going to snap to (including fling momentum).
+      if ('onscrollsnapchanging' in window) {
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          setPending(items.indexOf(e.snapTargetInline));
+        });
+      } else {
+        gallery.addEventListener('scroll', function () {
+          setPending(nearestIndex());
+        }, { passive: true });
+      }
+
+      // Scroll finished: resolve to the item we actually landed on.
+      function finish() { setActive(nearestIndex()); }
+
+      if ('onscrollend' in window) {
+        gallery.addEventListener('scrollend', finish);
+      } else {
+        let timer;
+        gallery.addEventListener('scroll', function () {
+          clearTimeout(timer);
+          timer = setTimeout(finish, 150);
+        }, { passive: true });
+      }
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          const left = targetScrollLeft(items[i]);
+          if (Math.abs(left - gallery.scrollLeft) < 1) {
+            setActive(i); // already there; no scroll (and no scrollend) will happen
+            return;
+          }
+          setPending(i);
+          gallery.scrollTo({ left: left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        });
+      });
+
+      setActive(nearestIndex());
+    })();
+  </script>
+
