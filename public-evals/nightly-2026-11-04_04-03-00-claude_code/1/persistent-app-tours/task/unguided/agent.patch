+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title" aria-describedby="tour-step-desc">
+    <h4 id="tour-step-title">New: Daily Grind Rewards</h4>
+    <p id="tour-step-desc">Earn points with every purchase and redeem them for free drinks and treats.</p>
+    <button type="button" class="tour-close">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var tip = document.getElementById('tour-step');
+      var closeBtn = tip.querySelector('.tour-close');
+      var supportsPopover = typeof tip.showPopover === 'function';
+      var supportsAnchor = window.CSS && CSS.supports && CSS.supports('anchor-name', '--a');
+      var open = false;
+      var rafId = null;
+
+      function position() {
+        var r = link.getBoundingClientRect();
+        var w = tip.offsetWidth;
+        var left = r.left + r.width / 2 - w / 2;
+        left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
+        tip.style.top = (r.bottom + 12) + 'px';
+        tip.style.left = left + 'px';
+        tip.style.right = 'auto';
+        tip.style.bottom = 'auto';
+      }
+
+      // Fallback tracking loop keeps the step attached to the link through
+      // scroll, resize, font loading and layout shifts.
+      function track() {
+        if (!open) return;
+        position();
+        rafId = requestAnimationFrame(track);
+      }
+
+      function show() {
+        open = true;
+        link.classList.add('tour-highlight');
+        if (supportsPopover) {
+          tip.showPopover();
+        } else {
+          tip.classList.add('tour-open-fallback');
+        }
+        if (!supportsAnchor) {
+          tip.classList.add('js-positioned');
+          track();
+        }
+      }
+
+      function hide() {
+        open = false;
+        link.classList.remove('tour-highlight');
+        if (rafId) cancelAnimationFrame(rafId);
+        if (supportsPopover) {
+          if (tip.matches(':popover-open')) tip.hidePopover();
+        } else {
+          tip.classList.remove('tour-open-fallback');
+        }
+      }
+
+      if (!supportsPopover) {
+        tip.style.display = 'none';
+        var obs = new MutationObserver(function () {
+          tip.style.display = tip.classList.contains('tour-open-fallback') ? 'block' : 'none';
+        });
+        obs.observe(tip, { attributes: true, attributeFilter: ['class'] });
+      }
+
+      // Keep the user on the page while the tour is active.
+      link.addEventListener('click', function (e) {
+        if (open) e.preventDefault();
+      });
+
+      // Only the explicit close button dismisses the step.
+      closeBtn.addEventListener('click', hide);
+
+      show();
+    })();
+  </script>
+
 </body>
 
