+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title">
+    <h2 id="tour-step-title">Earn points with Rewards</h2>
+    <p>Earn points on every order and redeem them for free drinks and treats. Check your balance here anytime.</p>
+    <button type="button" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+  </div>
+
+  <script type="module">
+    // Load polyfills only when native support is missing.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const tourStep = document.getElementById("tour-step");
+    const rewardsLink = document.getElementById("feature");
+    const isOpen = () => {
+      try { return tourStep.matches(":popover-open"); }
+      catch { return tourStep.classList.contains(":popover-open"); }
+    };
+
+    // Keep the rewards link from navigating away while the tour is open.
+    rewardsLink.addEventListener("click", (event) => {
+      if (isOpen()) event.preventDefault();
+    });
+
+    // Open by default (manual popover: stays open until explicitly closed).
+    tourStep.showPopover();
+    tourStep.querySelector("button").focus();
+  </script>
+
