+  <script>
+    (() => {
+      const STORAGE_KEY = 'daily-grind:feedback';
+      const dialog = document.getElementById('feedback-dialog');
+      const form = document.getElementById('feedback-form');
+      const launcher = document.getElementById('fb-launcher');
+      const locationText = document.getElementById('fb-location');
+      const status = document.getElementById('fb-move-hint');
+      const docks = new Map(
+        [...document.querySelectorAll('.fb-dock')].map((el) => [el.dataset.dock, el])
+      );
+
+      // Feature detection. Append ?nomovebefore to the URL to force the fallback path.
+      const forceFallback = new URLSearchParams(location.search).has('nomovebefore');
+      const supportsMoveBefore = !forceFallback && typeof Element.prototype.moveBefore === 'function';
+
+      // Set while the fallback path closes/re-opens the dialog, so that the
+      // transient close doesn't get persisted as "user closed the panel".
+      let relocating = false;
+
+      /* ---------- Persistence ---------- */
+
+      const load = () => {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
+      };
+
+      const save = () => {
+        const data = {
+          open: dialog.open,
+          dock: currentDock(),
+          rating: form.elements.rating.value,
+          message: form.elements.message.value,
+        };
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch { /* storage unavailable */ }
+      };
+
+      /* ---------- Helpers ---------- */
+
+      const currentDock = () => dialog.parentElement?.dataset.dock ?? 'main';
+
+      const syncUi = () => {
+        const dock = docks.get(currentDock());
+        locationText.textContent = `Mounted in: ${dock.dataset.label}`;
+        docks.forEach((el) => el.classList.toggle('is-active', el === dock));
+        dialog.querySelectorAll('[data-fb-move]').forEach((btn) => {
+          const here = btn.dataset.fbMove === currentDock();
+          btn.setAttribute('aria-pressed', String(here));
+        });
+      };
+
+      const open = () => {
+        if (!dialog.open) dialog.showModal();
+        save();
+      };
+
+      /** Snapshot everything a remove+insert would destroy. */
+      const captureState = () => {
+        const active = document.activeElement;
+        const focusInside = dialog.contains(active) ? active : null;
+        const state = {
+          wasOpen: dialog.open,
+          wasModal: dialog.matches(':modal'),
+          focusTarget: focusInside,
+          scrollTop: form.scrollTop,
+          rating: form.elements.rating.value,
+          message: form.elements.message.value,
+          selection: null,
+        };
+        if (focusInside && 'selectionStart' in focusInside && focusInside.selectionStart != null) {
+          state.selection = [focusInside.selectionStart, focusInside.selectionEnd, focusInside.selectionDirection];
+        }
+        return state;
+      };
+
+      /** Re-apply a snapshot after a non-preserving move. */
+      const restoreState = (state) => {
+        form.elements.message.value = state.message;
+        if (state.rating) form.elements.rating.value = state.rating;
+
+        if (state.wasOpen && !dialog.open) {
+          state.wasModal ? dialog.showModal() : dialog.show();
+        }
+        form.scrollTop = state.scrollTop;
+
+        // showModal() runs the dialog focusing steps; override with the element
+        // the user was actually on.
+        if (state.focusTarget && state.focusTarget.isConnected) {
+          state.focusTarget.focus({ preventScroll: true });
+          if (state.selection) {
+            try { state.focusTarget.setSelectionRange(...state.selection); } catch { /* not a text control */ }
+          }
+        }
+      };
+
+      /**
+       * Relocate the dialog into another dock.
+       * Prefer the atomic, state-preserving moveBefore(): the dialog stays in the
+       * top layer, stays modal, and keeps focus. Otherwise fall back to
+       * insertBefore() and manually rebuild open/modal/focus/selection state.
+       */
+      const moveTo = (dockName) => {
+        const target = docks.get(dockName);
+        if (!target || target === dialog.parentElement) return;
+
+        let method = 'moveBefore';
+        if (supportsMoveBefore) {
+          try {
+            target.moveBefore(dialog, null);
+          } catch (err) {
+            // moveBefore throws (e.g. HierarchyRequestError) when a state-preserving
+            // move isn't possible; degrade to the manual path.
+            console.warn('moveBefore failed, falling back:', err);
+            method = null;
+          }
+        } else {
+          method = null;
+        }
+
+        if (!method) {
+          method = 'fallback';
+          const state = captureState();
+          relocating = true;
+          try {
+            // Close explicitly so removal doesn't leave a stale non-modal
+            // [open] dialog behind; we re-open it in restoreState().
+            if (dialog.open) dialog.close();
+            target.insertBefore(dialog, null);
+            restoreState(state);
+          } finally {
+            relocating = false;
+          }
+        }
+
+        syncUi();
+        save();
+        status.textContent = `Moved to ${target.dataset.label} (${method === 'moveBefore' ? 'state preserved natively' : 'state restored manually'}).`;
+      };
+
+      /* ---------- Wiring ---------- */
+
+      launcher.addEventListener('click', open);
+
+      dialog.addEventListener('click', (e) => {
+        const moveBtn = e.target.closest('[data-fb-move]');
+        if (moveBtn) moveTo(moveBtn.dataset.fbMove);
+        if (e.target.closest('[data-fb-close]')) dialog.close('dismiss');
+        // Click on the backdrop (outside the form box) closes the dialog.
+        if (e.target === dialog) dialog.close('dismiss');
+      });
+
+      form.addEventListener('input', save);
+
+      form.addEventListener('submit', (e) => {
+        if (!form.elements.rating.value && !form.elements.message.value.trim()) {
+          e.preventDefault();
+          status.textContent = 'Please pick a rating or leave a comment.';
+          form.elements.message.focus();
+          return;
+        }
+        // method="dialog" closes the dialog after this handler.
+        status.textContent = '';
+        queueMicrotask(() => {
+          form.reset();
+          save();
+          launcher.textContent = 'Thanks! \u2615';
+          setTimeout(() => { launcher.textContent = 'Feedback'; }, 3000);
+        });
+      });
+
+      dialog.addEventListener('close', () => {
+        if (relocating) return;
+        save();
+        launcher.focus({ preventScroll: true });
+      });
+
+      /* ---------- Restore persisted state ---------- */
+
+      const saved = load();
+      if (saved.message) form.elements.message.value = saved.message;
+      if (saved.rating) form.elements.rating.value = saved.rating;
+      if (saved.dock && docks.has(saved.dock) && saved.dock !== currentDock()) {
+        docks.get(saved.dock).appendChild(dialog); // closed at this point, plain move is fine
+      }
+      syncUi();
+      if (saved.open) dialog.showModal();
+
+      status.textContent = supportsMoveBefore
+        ? 'Using native moveBefore() for state-preserving moves.'
+        : 'moveBefore() unavailable; using manual re-open fallback.';
+    })();
+  </script>
+
