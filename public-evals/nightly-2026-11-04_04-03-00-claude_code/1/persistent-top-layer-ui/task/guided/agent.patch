+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const form = document.getElementById('feedback-form');
+      const openBtn = document.getElementById('feedback-open');
+      const moveBtn = document.getElementById('feedback-move');
+      const locationLabel = document.getElementById('feedback-location');
+      const status = document.getElementById('feedback-status');
+      const docks = [...document.querySelectorAll('[data-dock]')];
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      // Set while a fallback relocation closes/re-opens the dialog, so that
+      // transient close events aren't mistaken for the user dismissing it.
+      let relocating = false;
+
+      const announce = (msg) => {
+        status.textContent = '';
+        requestAnimationFrame(() => { status.textContent = msg; });
+      };
+
+      openBtn.addEventListener('click', () => {
+        dialog.returnValue = '';
+        dialog.showModal();
+      });
+
+      dialog.addEventListener('close', () => {
+        if (relocating) return;
+        if (dialog.returnValue === 'send') {
+          form.reset();
+          announce('Thanks! Your feedback has been sent.');
+        }
+        dialog.returnValue = '';
+      });
+
+      // Capture the state that a remove + insert would destroy.
+      function snapshot() {
+        const active = dialog.contains(document.activeElement) ? document.activeElement : null;
+        return {
+          wasOpen: dialog.open,
+          wasModal: dialog.matches(':modal'),
+          active,
+          selection: active && typeof active.selectionStart === 'number'
+            ? [active.selectionStart, active.selectionEnd, active.selectionDirection]
+            : null,
+          scrollTop: dialog.scrollTop,
+        };
+      }
+
+      function restore(state) {
+        if (state.wasOpen) {
+          // Removing a dialog from the document drops it from the top layer
+          // but can leave the `open` attribute behind, which would make
+          // showModal() throw. Clear it before re-opening.
+          if (dialog.open) dialog.removeAttribute('open');
+          state.wasModal ? dialog.showModal() : dialog.show();
+        }
+        dialog.scrollTop = state.scrollTop;
+        if (state.active) {
+          state.active.focus({ preventScroll: true });
+          if (state.selection) {
+            try { state.active.setSelectionRange(...state.selection); } catch { /* not a text control */ }
+          }
+        }
+      }
+
+      function relocate(target) {
+        if (supportsMoveBefore) {
+          // Atomic move: the dialog stays modal, in the top layer, and the
+          // focused element keeps focus.
+          target.moveBefore(dialog, null);
+          return;
+        }
+
+        // Fallback: a classic move closes the dialog and drops focus,
+        // so re-open it and restore focus/selection/scroll by hand.
+        const state = snapshot();
+        relocating = true;
+        target.insertBefore(dialog, null);
+        restore(state);
+        // Any close event queued by the move is dispatched in an earlier task.
+        setTimeout(() => { relocating = false; });
+      }
+
+      moveBtn.addEventListener('click', () => {
+        const current = docks.findIndex((dock) => dock.contains(dialog));
+        const next = docks[(current + 1) % docks.length];
+        relocate(next);
+        locationLabel.textContent = next.dataset.dockLabel;
+        announce(`Feedback dialog moved to the ${next.dataset.dockLabel} section.`);
+      });
+    })();
+  </script>
+
