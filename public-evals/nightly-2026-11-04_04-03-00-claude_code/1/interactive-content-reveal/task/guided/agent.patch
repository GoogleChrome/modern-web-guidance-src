+    /* Spotlight reveal: register the size properties so they can interpolate.
+       The pointer position properties are intentionally left unregistered
+       (and untransitioned) so the spotlight tracks the pointer directly. */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+      /* Only the sizes transition; --mouse-x / --mouse-y never do. */
+      transition: --inner-size 0.3s ease-out, --outer-size 0.3s ease-out;
+
+      @media (prefers-reduced-motion: reduce) {
+        transition-duration: 0s;
+      }
+
+      @media (hover: hover) {
+        &:hover {
+          --inner-size: 70px;
+          --outer-size: 110px;
+        }
+      }
+    }
+
+    .product-card .spotlight {
+      position: absolute;
+      inset: 0;
+      /* Never intercept clicks/hover: text and buttons stay interactive. */
+      pointer-events: none;
+      /* A light warm wash over the photo keeps the dark card text legible. */
+      background-image:
+        linear-gradient(rgb(255 243 224 / 0.6), rgb(255 243 224 / 0.6)),
+        var(--reveal-image);
+      background-size: cover;
+      background-position: center;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    /* Keep the original card content painted above the overlay so the text
+       and buttons stay fully visible (and clickable) at all times. */
+    .product-card > :not(.spotlight) {
+      position: relative;
+    }
+
