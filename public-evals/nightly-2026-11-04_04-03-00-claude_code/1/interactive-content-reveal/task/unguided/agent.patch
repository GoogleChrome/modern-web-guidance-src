+    /* Seasonal product cards: pointer-following spotlight reveal */
+    @property --mouse-x {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --mouse-y {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+      /* Only the size variables animate; position updates instantly. */
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover,
+    .product-card:focus-within {
+      --inner-size: 70px;
+      --outer-size: 130px;
+    }
+
+    .product-card > :not(.spotlight-overlay) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      pointer-events: none;
+      border-radius: inherit;
+      background:
+        linear-gradient(rgba(255, 248, 240, 0.72), rgba(255, 248, 240, 0.72)),
+        var(--spotlight-image) center / cover no-repeat;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
