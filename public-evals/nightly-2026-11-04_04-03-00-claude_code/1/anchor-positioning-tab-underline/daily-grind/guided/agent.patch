+    /* Active nav indicator: an underline tethered to the active item via
+       anchor positioning, so it slides between items when the anchor moves. */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      /* Inset + anchor() (not position-area) so the position can transition. */
+      inset-block-start: calc(anchor(bottom) + .1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 3px;
+      border-radius: 3px;
+      background: var(--accent);
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset .3s ease;
+      }
+    }
+
+    nav ul:not(:has(li.active))::before {
+      display: none;
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+    }
+
+    nav ul li.active a {
+      color: var(--accent);
+    }
+
+    /* Fallback: static underline where anchor positioning is unsupported. */
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        display: none;
+      }
+
+      nav ul li.active {
+        border-bottom: 3px solid var(--accent);
+      }
+    }
+
     .logout-link {
       border: 1px solid var(--accent);
       padding: 5px 12px;
