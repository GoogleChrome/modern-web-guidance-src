@@ -207,6 +252,34 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Move the active state (and its sliding underline) to the clicked nav item.
+    const navItems = document.querySelectorAll('nav ul li:not(:has(.logout-link))');
+
+    function setActive(item) {
+      navItems.forEach((li) => {
+        const isActive = li === item;
+        li.classList.toggle('active', isActive);
+        const link = li.querySelector('a');
+        if (isActive) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    // Reflect the current URL on load, if it matches a nav item.
+    const current = [...navItems].find(
+      (li) => li.querySelector('a').getAttribute('href') === location.pathname
+    );
+    if (current) setActive(current);
+
+    navItems.forEach((li) => {
+      li.querySelector('a').addEventListener('click', (event) => {
+        event.preventDefault();
+        setActive(li);
+      });
+    });
+  </script>
+
 </body>
 
 </html>
