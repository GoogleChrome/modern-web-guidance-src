+  <script>
+    // Theme picker: system default, forced light, or forced dark
+    (function () {
+      var root = document.documentElement;
+      var meta = document.querySelector('meta[name="color-scheme"]');
+      var select = document.getElementById('theme-select');
+
+      function applyTheme(theme) {
+        if (theme === 'light' || theme === 'dark') {
+          root.setAttribute('data-theme', theme);
+          meta.setAttribute('content', theme);
+        } else {
+          theme = 'system';
+          root.removeAttribute('data-theme');
+          meta.setAttribute('content', 'light dark');
+        }
+        try { localStorage.setItem('theme', theme); } catch (e) { }
+        select.value = theme;
+      }
+
+      select.value = root.getAttribute('data-theme') || 'system';
+      select.addEventListener('change', function () {
+        applyTheme(select.value);
+      });
+    })();
+
+    // Late night specials filter
+    (function () {
+      var filter = document.getElementById('late-night-filter');
+      var specials = document.querySelectorAll('.late-night .special');
+
+      filter.addEventListener('change', function () {
+        var value = filter.value;
+        specials.forEach(function (item) {
+          var categories = item.dataset.category.split(' ');
+          item.hidden = value !== 'all' && categories.indexOf(value) === -1;
+        });
+      });
+    })();
+  </script>
+
 </body>
 
