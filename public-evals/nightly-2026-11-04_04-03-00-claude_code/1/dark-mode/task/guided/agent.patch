+  <script>
+    // Theme picker: "system" follows the OS; "light"/"dark" force a scheme on the root element.
+    (() => {
+      const STORAGE_KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const select = document.getElementById("theme-select");
+      const systemOption = select.querySelector('option[value="system"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const normalize = (value) => (value === "light" || value === "dark" ? value : "system");
+
+      function readStored() {
+        try {
+          return localStorage.getItem(STORAGE_KEY);
+        } catch {
+          return null;
+        }
+      }
+
+      // The meta content is mapped to `color-scheme` on :root in CSS, so this drives the whole page.
+      function applyTheme(value) {
+        const theme = normalize(value);
+        meta.content = theme === "system" ? "light dark" : theme;
+        select.value = theme;
+      }
+
+      function updateSystemLabel() {
+        systemOption.textContent = `System default (currently ${systemDark.matches ? "dark" : "light"})`;
+      }
+
+      select.addEventListener("change", () => {
+        const theme = normalize(select.value);
+        try {
+          if (theme === "system") localStorage.removeItem(STORAGE_KEY);
+          else localStorage.setItem(STORAGE_KEY, theme);
+        } catch { /* can't persist; still apply for this page view */ }
+        applyTheme(theme);
+      });
+
+      // Stay in sync when the theme is changed in another tab.
+      addEventListener("storage", (event) => {
+        if (event.key === STORAGE_KEY || event.key === null) applyTheme(readStored());
+      });
+
+      systemDark.addEventListener("change", updateSystemLabel);
+
+      updateSystemLabel();
+      applyTheme(readStored());
+    })();
+
+    // Late night specials filter
+    (() => {
+      const select = document.getElementById("night-select");
+      const specials = document.querySelectorAll(".special");
+      select.addEventListener("change", () => {
+        const night = select.value;
+        specials.forEach((item) => {
+          item.hidden = night !== "all" && !item.dataset.nights.split(" ").includes(night);
+        });
+      });
+    })();
+  </script>
+
