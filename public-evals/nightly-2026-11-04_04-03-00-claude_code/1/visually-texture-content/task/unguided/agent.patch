+    /* Weathered / grunge hero background.
+       The photo lives on a pseudo-element so the mask only distresses the
+       background: holes in grunge-texture.svg's alpha channel make the
+       background transparent, while the heading and button stay crisp. */
+    .weathered-bg {
+      position: relative;
+      isolation: isolate;
+    }
+
+    .weathered-bg::before {
+      content: '';
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      background:
+        linear-gradient(rgba(40, 24, 16, 0.55), rgba(20, 12, 8, 0.6)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      filter: sepia(0.35) contrast(1.05);
+
+      -webkit-mask-image: url('grunge-texture.svg');
+      -webkit-mask-repeat: repeat;
+      -webkit-mask-size: 400px 400px;
+      mask-image: url('grunge-texture.svg');
+      mask-mode: alpha;
+      mask-repeat: repeat;
+      mask-size: 400px 400px;
+    }
+
     .hero h1 {
       font-size: 3rem;
       margin-bottom: 1rem;
     }
