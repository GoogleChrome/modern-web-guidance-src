+    /*
+     * Themed sections
+     * A section declares its context with data-theme="…". Each theme only
+     * sets custom properties; the cards below read those properties, so they
+     * restyle automatically depending on the section they sit in. Cards
+     * outside a themed section use the neutral defaults.
+     */
+    .themed-section {
+      --section-bg: transparent;
+      --section-heading: var(--text);
+      --card-bg: white;
+      --card-text: var(--text);
+      --card-heading: var(--primary);
+      --card-accent: var(--accent);
+      --card-border: transparent;
+      --card-shadow: rgba(0, 0, 0, 0.1);
+      --card-btn-bg: var(--primary);
+      --card-btn-hover: #3e2723;
+      --card-btn-text: white;
+      --theme-icon: none;
+
+      background: var(--section-bg);
+      padding: 30px 20px;
