+/* ------------------------------------------------------------------
+ * Semantic surfaces
+ *
+ * Layouts declare *what kind of place* they are by setting `--surface`.
+ * Components never ask who set it; they opt in to reacting via
+ * `@container style(--surface: …)`. Producers and consumers stay
+ * decoupled, so either side can be extended independently.
+ *
+ *   featured – editorially highlighted content (lead stories, picks)
+ *   archive  – listings already scoped to one category
+ *   related  – secondary "keep reading" suggestions
+ *
+ * The `.surface-*` classes are the public API for setting the context.
+ * Each reaction also ships a `:where(.surface-*)` selector fallback for
+ * browsers without style-query support; the style query (same
+ * specificity, later in source) wins when supported.
+ * ------------------------------------------------------------------ */
+.surface-featured { --surface: featured; }
+.surface-archive  { --surface: archive; }
+.surface-related  { --surface: related; }
+
+/* Shared badge: hidden by default, revealed only on featured surfaces. */
+.surface-badge {
+  display: none;
+  align-items: center;
+  gap: 0.25rem;
+  inline-size: fit-content;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background: var(--color-amber-400);
+  color: var(--color-gray-900);
+  font-size: var(--text-xs);
+  line-height: var(--text-xs--line-height);
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+:where(.surface-featured) .surface-badge {
+  display: inline-flex;
+}
+
+@container style(--surface: featured) {
+  .surface-badge {
+    display: inline-flex;
+  }
+}
