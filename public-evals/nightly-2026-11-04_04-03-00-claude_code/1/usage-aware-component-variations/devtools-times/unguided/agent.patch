diff --git a/src/components/ReadingMeta.astro b/src/components/ReadingMeta.astro
new file mode 100644
index 0000000..67e4232
--- /dev/null
+++ b/src/components/ReadingMeta.astro
@@ -0,0 +1,28 @@
+---
+import type { Semantics } from '../utils/semantics';
+import { BookOpenIcon, BoltIcon, ClockIcon } from '@heroicons/react/24/outline';
+
+/**
+ * Reading-time indicator that communicates commitment, not just minutes:
+ * brief → "Quick read" with a bolt, longform → "Long read" with a clock.
+ */
+export interface Props {
+    semantics: Semantics;
+    size?: 'sm' | 'md';
+}
+
+const { semantics, size = 'sm' } = Astro.props;
+const Icon = semantics.format === 'brief' ? BoltIcon : semantics.format === 'longform' ? ClockIcon : BookOpenIcon;
+const iconSize = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
+const minutes = semantics.readingTime;
+---
+{minutes !== undefined && (
+    <span
+        class:list={['font-medium flex items-center gap-1', size === 'md' ? 'text-sm' : 'text-xs']}
+        aria-label={`${semantics.readLabel}, ${minutes} minutes`}
+    >
+        <Icon className={`${iconSize} -mt-px`} aria-hidden="true" />
+        {semantics.format !== 'standard' && <span>{semantics.readLabel} ·</span>}
+        <span>{minutes} min</span>
+    </span>
+)}
diff --git a/src/components/SemanticKicker.astro b/src/components/SemanticKicker.astro
new file mode 100644
index 0000000..fa07519
--- /dev/null
+++ b/src/components/SemanticKicker.astro
@@ -0,0 +1,32 @@
+---
+import type { Semantics } from '../utils/semantics';
+
+/**
+ * Category label + contextual flag. Styling is driven entirely by the
+ * nearest ancestor's data-tone / data-desk (see global.css → Semantic context),
+ * so the same component reads as a slanted sports tag, an editorial italic
+ * culture label, or a restrained investigation marker.
+ */
+export interface Props {
+    semantics: Semantics;
+    /** Render the category as a link (disable when already inside a link). */
+    link?: boolean;
+    showFlag?: boolean;
+    class?: string;
+}
+
+const { semantics, link = true, showFlag = true, class: className = '' } = Astro.props;
+const Tag = link ? 'a' : 'span';
+---
+<div class:list={['flex flex-wrap items-center gap-2', className]}>
+    <Tag
+        class:list={['semantic-kicker', link && 'hover:underline underline-offset-4']}
+        href={link ? semantics.categoryHref : undefined}
+        title={semantics.categoryLabel !== semantics.deskLabel ? `${semantics.deskLabel} desk` : undefined}
+    >
+        {semantics.categoryLabel}
+    </Tag>
+    {showFlag && semantics.flag && (
+        <span class="semantic-flag" data-flag={semantics.flag.kind}>{semantics.flag.label}</span>
+    )}
+</div>
diff --git a/src/components/SensitivityNotice.astro b/src/components/SensitivityNotice.astro
new file mode 100644
index 0000000..569406c
--- /dev/null
+++ b/src/components/SensitivityNotice.astro
@@ -0,0 +1,16 @@
+---
+import type { Semantics } from '../utils/semantics';
+import { ExclamationTriangleIcon } from '@heroicons/react/24/outline';
+
+/** Shown only when the content's semantics flag it as sensitive. */
+export interface Props {
+    semantics: Semantics;
+}
+const { semantics } = Astro.props;
+---
+{semantics.sensitive && (
+    <aside role="note" class="flex gap-3 items-start bg-gray-100 border-l-4 border-gray-700 text-gray-700 text-sm p-3 mb-5">
+        <ExclamationTriangleIcon className="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true" />
+        <p>This story discusses crime or violence. Some readers may find details distressing.</p>
+    </aside>
+)}
