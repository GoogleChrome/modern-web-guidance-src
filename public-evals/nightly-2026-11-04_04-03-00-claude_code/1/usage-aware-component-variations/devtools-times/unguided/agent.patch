+++ b/src/utils/semantics.ts
@@ -0,0 +1,239 @@
+import { getCollection, type CollectionEntry } from 'astro:content';
+
+/**
+ * Semantic context resolution.
+ *
+ * Components should not hard-code visual decisions (colours, labels, image
+ * treatment, typography) per page. Instead they ask "what *is* this piece of
+ * content?" and derive their presentation from the answer. This module turns
+ * raw article metadata into a small, stable vocabulary that the UI layer
+ * (see `src/styles/global.css` → "Semantic context") maps to visuals via
+ * `data-*` attributes.
+ */
+
+/** Editorial desk the story belongs to. Drives the accent palette. */
+export type Desk = 'news' | 'business' | 'sports' | 'culture' | 'lifestyle' | 'science' | 'tech';
+
+/**
+ * Emotional register of the story. Drives image treatment and kicker styling.
+ * - sober:      crime, crisis, loss – muted imagery, restrained accents
+ * - neutral:    straight reporting
+ * - energetic:  competition, action – punchy imagery, slanted kickers
+ * - expressive: arts & performance – editorial italics
+ * - warm:       everyday life – soft, warm imagery
+ * - playful:    humour, pets – rounded, friendly labels
+ */
+export type Tone = 'sober' | 'neutral' | 'energetic' | 'expressive' | 'warm' | 'playful';
+
+/** Reading commitment, derived from reading time. */
+export type Format = 'brief' | 'standard' | 'longform';
+
+/** Where a component is rendered. Drives density / layout, not colour. */
+export type Placement = 'hero' | 'card' | 'compact';
+
+export type FlagKind = 'fresh' | 'investigation' | 'longread';
+
+export interface Semantics {
+    desk: Desk;
+    deskLabel: string;
+    tone: Tone;
+    format: Format;
+    /** Display label for the original category (properly cased). */
+    categoryLabel: string;
+    categoryHref: string;
+    /** Content warrants a sensitivity notice (violence, crime, death). */
+    sensitive: boolean;
+    /** Published within the freshness window relative to the newest story. */
+    fresh: boolean;
+    /** The single most relevant badge to show alongside the kicker, if any. */
+    flag?: { kind: FlagKind; label: string };
+    /** Human description of the reading commitment, e.g. "Quick read". */
+    readLabel: string;
+    readingTime?: number;
+    /** Spread onto the root element of any semantic component. */
+    attrs: {
+        'data-desk': Desk;
+        'data-tone': Tone;
+        'data-format': Format;
+        'data-sensitive'?: 'true';
+    };
+}
+
+const DESK_BY_CATEGORY: Record<string, Desk> = {
+    news: 'news',
+    national: 'news',
+    politics: 'news',
+    world: 'news',
+    media: 'news',
+    'urban development': 'news',
+    business: 'business',
+    economy: 'business',
+    labor: 'business',
+    sports: 'sports',
+    culture: 'culture',
+    arts: 'culture',
+    lifestyle: 'lifestyle',
+    pets: 'lifestyle',
+    science: 'science',
+    'web development': 'tech',
+    technology: 'tech',
+    tech: 'tech',
+};
+
+const DESK_LABEL: Record<Desk, string> = {
+    news: 'News',
+    business: 'Business',
+    sports: 'Sports',
+    culture: 'Culture',
+    lifestyle: 'Lifestyle',
+    science: 'Science',
+    tech: 'Technology',
+};
+
+const DEFAULT_TONE: Record<Desk, Tone> = {
+    news: 'neutral',
+    business: 'neutral',
+    sports: 'energetic',
+    culture: 'expressive',
+    lifestyle: 'warm',
+    science: 'neutral',
+    tech: 'neutral',
+};
+
+// Content signals. Matched against title, summary and tags.
+const SENSITIVE_SIGNALS = /\b(crime|criminals?|killers?|murder\w*|homicide|forensics?|violen\w*|death|deaths|victims?|fingerprints?)\b/i;
+const SOBER_SIGNALS = /\b(crisis|decay\w*|collapse\w*|strikes?|protests?|shortage|decline|threat\w*)\b/i;
+const PLAYFUL_SIGNALS = /\b(humou?r|pets?|dogs?|cats?|comedy|improv|funny)\b/i;
+
+const FRESH_WINDOW_MS = 48 * 60 * 60 * 1000;
+
+export interface SemanticContext {
+    /** "Now" from the newsroom's point of view: the newest publish date. */
+    referenceDate: Date;
+}
+
+let contextPromise: Promise<SemanticContext> | undefined;
+
+/**
+ * Shared context needed to judge relative properties such as freshness.
+ * Uses the newest article as the reference point so that "fresh" means
+ * "part of the latest news cycle" rather than depending on wall-clock time.
+ */
+export function getSemanticContext(): Promise<SemanticContext> {
+    contextPromise ??= getCollection('articles').then((articles) => {
+        const newest = articles.reduce(
+            (max, a) => Math.max(max, a.data.date.valueOf()),
+            0,
+        );
+        return { referenceDate: new Date(newest || Date.now()) };
+    });
+    return contextPromise;
+}
+
+export function titleCase(value: string): string {
+    return value.replace(/\b\p{L}/gu, (c) => c.toUpperCase());
+}
+
+export function resolveDesk(category: string): Desk {
+    return DESK_BY_CATEGORY[category.trim().toLowerCase()] ?? 'news';
+}
+
+export function resolveFormat(readingTime?: number): Format {
+    if (readingTime === undefined) return 'standard';
+    if (readingTime <= 3) return 'brief';
+    if (readingTime >= 7) return 'longform';
+    return 'standard';
+}
+
+const READ_LABEL: Record<Format, string> = {
+    brief: 'Quick read',
+    standard: 'Read',
+    longform: 'Long read',
+};
+
+export function resolveSemantics(
+    article: CollectionEntry<'articles'>,
+    context?: SemanticContext,
+): Semantics {
+    const { category, title, summary, tags = [], readingTime, date } = article.data;
+    const desk = resolveDesk(category);
+    const format = resolveFormat(readingTime);
+    const haystack = [title, summary, ...tags].join(' ');
+
+    const sensitive = SENSITIVE_SIGNALS.test(haystack);
+    let tone: Tone = DEFAULT_TONE[desk];
+    if (sensitive || SOBER_SIGNALS.test(haystack)) tone = 'sober';
+    else if (PLAYFUL_SIGNALS.test(haystack)) tone = 'playful';
+
+    const fresh = context
+        ? context.referenceDate.valueOf() - date.valueOf() <= FRESH_WINDOW_MS
+        : false;
+
+    // Priority: timeliness > nature of the reporting > reading commitment.
+    let flag: Semantics['flag'];
+    if (fresh) flag = { kind: 'fresh', label: 'New' };
+    else if (sensitive) flag = { kind: 'investigation', label: 'Investigation' };
+    else if (format === 'longform') flag = { kind: 'longread', label: 'Long read' };
+
+    const attrs: Semantics['attrs'] = {
+        'data-desk': desk,
+        'data-tone': tone,
+        'data-format': format,
+    };
+    if (sensitive) attrs['data-sensitive'] = 'true';
+
+    return {
+        desk,
+        deskLabel: DESK_LABEL[desk],
+        tone,
+        format,
+        categoryLabel: titleCase(category),
+        categoryHref: `${import.meta.env.BASE_URL}category/${category.toLowerCase()}`,
+        sensitive,
+        fresh,
+        flag,
+        readLabel: READ_LABEL[format],
+        readingTime,
+        attrs,
+    };
+}
+
+/** Semantics for a bare category (e.g. category landing pages). */
+export function resolveCategorySemantics(category: string) {
+    const desk = resolveDesk(category);
+    return {
+        desk,
+        deskLabel: DESK_LABEL[desk],
+        categoryLabel: titleCase(category),
+        attrs: { 'data-desk': desk, 'data-tone': DEFAULT_TONE[desk] },
+    };
+}
+
+/**
+ * Rank candidates by semantic proximity to `article`: same category first,
+ * then same desk, then shared tags, then recency.
+ */
+export function rankRelated(
+    article: CollectionEntry<'articles'>,
+    candidates: CollectionEntry<'articles'>[],
+    limit = 3,
+): CollectionEntry<'articles'>[] {
+    const category = article.data.category.toLowerCase();
+    const desk = resolveDesk(category);
+    const tags = new Set((article.data.tags ?? []).map((t) => t.toLowerCase()));
+
+    const score = (c: CollectionEntry<'articles'>) => {
+        let s = 0;
+        if (c.data.category.toLowerCase() === category) s += 4;
+        else if (resolveDesk(c.data.category) === desk) s += 2;
+        for (const t of c.data.tags ?? []) if (tags.has(t.toLowerCase())) s += 1;
+        return s;
+    };
+
+    return candidates
+        .filter((c) => c.id !== article.id)
+        .map((c) => ({ c, s: score(c) }))
+        .sort((a, b) => b.s - a.s || b.c.data.date.valueOf() - a.c.data.date.valueOf())
+        .slice(0, limit)
+        .map(({ c }) => c);
+}
