+/* ==========================================================================
+   Semantic context
+   --------------------------------------------------------------------------
+   Components carry data-desk / data-tone / data-format / data-placement
+   attributes (resolved in src/utils/semantics.ts). All visual decisions that
+   depend on *what the content is* live here, so markup stays declarative.
+   ========================================================================== */
+
+@layer components {
+  /* ---- Desk → accent palette (text colours meet WCAG AA on white) ------- */
+  [data-desk] {
+    --desk-accent: #92400e;       /* amber-800: brand default */
+    --desk-accent-soft: #fffbeb;
+    --desk-accent-bright: #f59e0b;
+  }
+  [data-desk="news"]      { --desk-accent: #b91c1c; --desk-accent-soft: #fef2f2; --desk-accent-bright: #ef4444; }
+  [data-desk="business"]  { --desk-accent: #1e40af; --desk-accent-soft: #eff6ff; --desk-accent-bright: #3b82f6; }
+  [data-desk="sports"]    { --desk-accent: #047857; --desk-accent-soft: #ecfdf5; --desk-accent-bright: #10b981; }
+  [data-desk="culture"]   { --desk-accent: #7e22ce; --desk-accent-soft: #faf5ff; --desk-accent-bright: #a855f7; }
+  [data-desk="lifestyle"] { --desk-accent: #c2410c; --desk-accent-soft: #fff7ed; --desk-accent-bright: #f97316; }
+  [data-desk="science"]   { --desk-accent: #0e7490; --desk-accent-soft: #ecfeff; --desk-accent-bright: #06b6d4; }
+  [data-desk="tech"]      { --desk-accent: #4338ca; --desk-accent-soft: #eef2ff; --desk-accent-bright: #6366f1; }
+
+  /* Sober stories mute their desk colour regardless of desk. */
+  [data-tone="sober"] {
+    --desk-accent: #374151;
+    --desk-accent-soft: #f3f4f6;
+    --desk-accent-bright: #6b7280;
+  }
+
+  /* ---- Shared hooks ---------------------------------------------------- */
+  .semantic-link { transition: color 150ms ease; }
+  .semantic-link:hover,
+  .group:hover .semantic-link-group { color: var(--desk-accent); }
+
+  .semantic-rule { border-color: var(--desk-accent); }
+
+  /* ---- Kicker (category label) adapts to tone -------------------------- */
+  .semantic-kicker {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.4em;
+    color: var(--desk-accent);
+    font-family: "Grenze", serif;
+    font-weight: 500;
+    letter-spacing: 0.1em;
+    font-size: 0.875rem;
+    line-height: 1.25rem;
+  }
+  .semantic-kicker::before {
+    content: "";
+    width: 0.5em;
+    height: 0.5em;
+    border-radius: 9999px;
+    background: var(--desk-accent-bright);
+  }
+  [data-tone="sober"] .semantic-kicker {
+    font-family: ui-sans-serif, system-ui, sans-serif;
+    text-transform: uppercase;
+    font-size: 0.75rem;
+    font-weight: 600;
+  }
+  [data-tone="sober"] .semantic-kicker::before {
+    width: 3px; height: 1em; border-radius: 0;
+  }
+  [data-tone="energetic"] .semantic-kicker {
+    font-style: italic;
+    font-weight: 700;
+    text-transform: uppercase;
+    font-family: ui-sans-serif, system-ui, sans-serif;
+    font-size: 0.75rem;
+  }
+  [data-tone="energetic"] .semantic-kicker::before {
+    width: 1em; height: 0.3em; border-radius: 0; transform: skewX(-20deg);
+  }
+  [data-tone="expressive"] .semantic-kicker {
+    font-style: italic;
+    letter-spacing: 0.04em;
+  }
+  [data-tone="expressive"] .semantic-kicker::before { content: none; }
+  [data-tone="playful"] .semantic-kicker {
+    background: var(--desk-accent-soft);
+    padding: 0.05em 0.6em;
+    border-radius: 9999px;
+    letter-spacing: 0.04em;
+  }
+  [data-tone="playful"] .semantic-kicker::before { content: none; }
+
+  /* ---- Flags ----------------------------------------------------------- */
+  .semantic-flag {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    font-size: 0.6875rem;
+    line-height: 1rem;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.06em;
+    padding: 0.05rem 0.4rem;
+    border-radius: 0.25rem;
+    color: var(--desk-accent);
+    background: var(--desk-accent-soft);
+  }
+  .semantic-flag[data-flag="fresh"] { color: #fff; background: #b91c1c; }
+  .semantic-flag[data-flag="fresh"]::before {
+    content: ""; width: 0.4rem; height: 0.4rem; border-radius: 9999px;
+    background: currentColor;
+    animation: semantic-pulse 1.6s ease-in-out infinite;
+  }
+  .semantic-flag[data-flag="investigation"] { color: #f9fafb; background: #1f2937; }
+  .semantic-flag[data-flag="longread"] { border: 1px solid currentColor; background: transparent; }
+
+  @keyframes semantic-pulse { 50% { opacity: 0.3; } }
+  @media (prefers-reduced-motion: reduce) {
+    .semantic-flag[data-flag="fresh"]::before { animation: none; }
+  }
+
+  /* ---- Image treatment by tone ----------------------------------------- */
+  .semantic-media { overflow: hidden; }
+  [data-placement="card"] .semantic-media { border-radius: 0.375rem; }
+  [data-placement="compact"] .semantic-media { border-radius: 0.25rem; }
+  .semantic-media img {
+    transition: filter 400ms ease, transform 600ms ease;
+  }
+  [data-tone="sober"] .semantic-media img { filter: grayscale(0.85) contrast(1.05); }
+  [data-tone="sober"].group:hover .semantic-media img { filter: grayscale(0.3) contrast(1.05); }
+  [data-tone="energetic"] .semantic-media img { filter: saturate(1.2) contrast(1.08); }
+  [data-tone="energetic"].group:hover .semantic-media img { transform: scale(1.04); }
+  [data-tone="warm"] .semantic-media img { filter: sepia(0.15) saturate(1.1); }
+  [data-tone="expressive"] .semantic-media img { filter: contrast(1.1) saturate(0.95); }
+  [data-tone="playful"].group:hover .semantic-media img { transform: scale(1.03) rotate(-0.5deg); }
+  [data-tone="playful"] .semantic-media,
+  [data-tone="playful"] [data-placement] .semantic-media,
+  [data-tone="playful"][data-placement] .semantic-media { border-radius: 1rem; }
+  @media (prefers-reduced-motion: reduce) {
+    .semantic-media img { transition: none; transform: none !important; }
+  }
+
+  /* ---- Headlines by tone ----------------------------------------------- */
+  [data-tone="expressive"] .semantic-headline { font-style: italic; }
+  [data-tone="sober"] .semantic-headline { letter-spacing: -0.005em; }
+
+  /* ---- Format: longform gets an accent edge, brief gets denser --------- */
+  [data-placement="card"][data-format="longform"] { border-top: 3px solid var(--desk-accent); }
+  article[data-placement="card"][data-format="longform"] { padding-top: 0.75rem; }
+  [data-format="brief"] .semantic-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+
+  /* ---- Article page --------------------------------------------------- */
+  .semantic-prose[data-tone="expressive"] > p:first-of-type::first-letter,
+  .semantic-prose[data-format="longform"] > p:first-of-type::first-letter {
+    float: left;
+    font-family: "Grenze", serif;
+    font-size: 4.25rem;
+    line-height: 0.85;
+    padding: 0.35rem 0.5rem 0 0;
+    color: var(--desk-accent);
+  }
+  .semantic-prose a { color: var(--desk-accent); }
+  .semantic-prose blockquote { border-left-color: var(--desk-accent-bright); }
+
+  /* ---- Category hero: desk-tinted overlay ------------------------------ */
+  .semantic-hero-tint {
+    background: linear-gradient(135deg, color-mix(in srgb, var(--desk-accent) 85%, black) 0%, rgb(0 0 0 / 0.55) 70%);
+  }
+}
