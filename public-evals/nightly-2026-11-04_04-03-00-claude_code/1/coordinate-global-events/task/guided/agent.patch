+  <script type="module">
+    // Load the Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const TARGET_ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+    const status = document.getElementById('plannerStatus');
+
+    // Some ICU versions use a narrow no-break space before AM/PM; normalize to a plain space.
+    const clean = (str) => str.replace(/[\u202f\u00a0]/g, ' ');
+    const fmtTime = (zdt) => clean(zdt.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' }));
+    const fmtDate = (zdt) => zdt.toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
+    const fmtWall = (plainTime) => clean(plainTime.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' }));
+
+    /**
+     * Resolve the host's wall-clock time into a ZonedDateTime, detecting DST conflicts.
+     * Every Temporal object here is immutable: derived values come from new objects,
+     * never by mutating the resolved host time.
+     */
+    function resolveHostTime(plainDateTime, timeZone) {
+      try {
+        // 'reject' throws a RangeError when the wall-clock time is skipped or repeated.
+        const exact = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'reject' });
+        return { zdt: exact, conflict: null };
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+      }
+
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      const resolved = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+
+      // In an overlap both candidates keep the requested wall-clock time but differ in offset.
+      // In a gap the candidates are shifted away from the requested (non-existent) time.
+      const isOverlap = earlier.toPlainDateTime().equals(plainDateTime)
+        && later.toPlainDateTime().equals(plainDateTime);
+
+      return {
+        zdt: resolved,
+        conflict: { type: isOverlap ? 'overlap' : 'gap', earlier, later },
+      };
+    }
+
+    function describeConflict(conflict, plainDateTime, timeZone, resolved) {
+      const requested = fmtWall(plainDateTime.toPlainTime());
+      const day = fmtDate(resolved);
+      if (conflict.type === 'gap') {
+        const shift = resolved.toPlainDateTime().since(plainDateTime).round({ largestUnit: 'hour', smallestUnit: 'minute' });
+        const mins = shift.hours * 60 + shift.minutes;
+        return `<strong>Daylight saving gap:</strong> ${requested} does not exist in ${timeZone} on ${day} ` +
+          `because clocks spring forward and skip that hour. We moved the tasting forward by ${mins} minutes to ` +
+          `<strong>${fmtTime(resolved)} (UTC${resolved.offset})</strong>, the same moment in time the skipped wall-clock time would have been.`;
+      }
+      return `<strong>Daylight saving overlap:</strong> ${requested} happens twice in ${timeZone} on ${day} ` +
+        `because clocks fall back and repeat that hour — first at UTC${conflict.earlier.offset}, then again at UTC${conflict.later.offset}. ` +
+        `We chose the <strong>first occurrence (UTC${resolved.offset})</strong>. If you meant the second one, the tasting starts ` +
+        `${conflict.later.since(conflict.earlier).total('minutes')} minutes later in absolute time.`;
+    }
+
+    function renderCard(zone, zdt, isHost) {
+      const card = document.createElement('article');
+      card.className = 'card' + (isHost ? ' is-host' : '');
+      card.dataset.tz = zone.id;
+
+      const h3 = document.createElement('h3');
+      h3.textContent = zone.label;
+
+      const time = document.createElement('div');
+      time.className = 'tz-time';
+      time.textContent = fmtTime(zdt);
+
+      const date = document.createElement('div');
+      date.className = 'tz-meta';
+      date.textContent = fmtDate(zdt);
+
+      const offset = document.createElement('div');
+      offset.className = 'tz-meta';
+      offset.textContent = `${zone.id} · UTC${zdt.offset}`;
+
+      card.append(h3, time, date, offset);
+      if (isHost) {
+        const badge = document.createElement('span');
+        badge.className = 'tz-badge';
+        badge.textContent = 'Host';
+        card.append(badge);
+      }
+      return card;
+    }
+
+    function update() {
+      const hostTz = hostTzSelect.value;
+      hostWarning.hidden = true;
+      hostWarning.innerHTML = '';
+
+      if (!dateInput.value || !timeInput.value) {
+        grid.replaceChildren();
+        status.textContent = 'Choose a date and time to see the schedule.';
+        return;
+      }
+
+      let plainDateTime;
+      try {
+        plainDateTime = Temporal.PlainDate.from(dateInput.value)
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value));
+      } catch {
+        grid.replaceChildren();
+        status.textContent = 'Please enter a valid date and time.';
+        return;
+      }
+
+      const { zdt: hostTime, conflict } = resolveHostTime(plainDateTime, hostTz);
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(conflict, plainDateTime, hostTz, hostTime);
+        hostWarning.hidden = false;
+      }
+
+      // withTimeZone returns a new ZonedDateTime for each target; hostTime is never modified.
+      const cards = TARGET_ZONES.map((zone) =>
+        renderCard(zone, hostTime.withTimeZone(zone.id), zone.id === hostTz));
+      grid.replaceChildren(...cards);
+      status.textContent = `Exact start instant: ${hostTime.toInstant().toString()}`;
+    }
+
+    // Default to today's date in the host zone.
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
 </body>
 
