+  <script type="module">
+    // Global Tasting Coordinator — built on the native Temporal API.
+    // Falls back to the official polyfill only in browsers that haven't shipped Temporal yet.
+    const Temporal = globalThis.Temporal
+      ?? (await import('https://cdn.jsdelivr.net/npm/@js-temporal/polyfill@0.5.1/+esm')).Temporal;
+
+    const TARGET_ZONES = Object.freeze([
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ]);
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+    const status = document.getElementById('plannerStatus');
+
+    // Format from the object's own wall-clock fields (hour/minute/day in its zone),
+    // so the output never depends on the viewer's system time zone.
+    const fmtTime = ({ hour, minute }) =>
+      `${hour % 12 || 12}:${String(minute).padStart(2, '0')} ${hour < 12 ? 'AM' : 'PM'}`;
+    const fmtDate = (zdt) => zdt.toPlainDate()
+      .toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
+    const fmtWall = fmtTime; // works for PlainDateTime too
+
+    /**
+     * Resolve a wall-clock time in the host zone to an exact ZonedDateTime,
+     * detecting DST gaps (non-existent times) and overlaps (ambiguous times).
+     * Temporal objects are immutable: every step below derives a new object
+     * and never mutates the inputs.
+     */
+    function resolveHostTime(plainDateTime, timeZone) {
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      // 'compatible' matches RFC 5545 / legacy behaviour: earlier offset for overlaps, push forward for gaps.
+      const resolved = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+
+      if (Temporal.ZonedDateTime.compare(earlier, later) === 0) {
+        return Object.freeze({ resolved, conflict: null });
+      }
+
+      const isOverlap = earlier.toPlainDateTime().equals(plainDateTime)
+        && later.toPlainDateTime().equals(plainDateTime);
+
+      return Object.freeze({
+        resolved,
+        conflict: Object.freeze({ type: isOverlap ? 'overlap' : 'gap', earlier, later }),
+      });
+    }
+
+    function describeConflict(conflict, plainDateTime, resolved, timeZone) {
+      const wall = fmtWall(plainDateTime);
+      if (conflict.type === 'gap') {
+        const skipped = dstShiftMinutes(conflict);
+        return `⚠️ Daylight saving time gap: ${wall} does not exist in ${timeZone} on this date — clocks spring ` +
+          `forward by ${skipped} minutes and skip right past it. The tasting has been moved forward to ` +
+          `${fmtTime(resolved)} (UTC${resolved.offset}), the first valid moment after the gap.`;
+      }
+      return `⚠️ Daylight saving time overlap: ${wall} happens twice in ${timeZone} on this date because clocks ` +
+        `fall back. It could mean ${fmtTime(conflict.earlier)} UTC${conflict.earlier.offset} (first occurrence) or ` +
+        `${fmtTime(conflict.later)} UTC${conflict.later.offset} (second occurrence). We've resolved it to the ` +
+        `first occurrence (UTC${resolved.offset}) — pick a slightly different time if you meant the second.`;
+    }
+
+    // Minutes between the two candidate instants (size of the DST shift).
+    function dstShiftMinutes({ earlier, later }) {
+      return Math.round(earlier.until(later, { largestUnit: 'second' }).seconds / 60);
+    }
+
+    function card(zone, zdt, isHost) {
+      const el = document.createElement('div');
+      el.className = 'tz-card' + (isHost ? ' is-host' : '');
+      const h3 = document.createElement('h3');
+      h3.textContent = zone.label;
+      const time = document.createElement('div');
+      time.className = 'tz-time';
+      time.textContent = fmtTime(zdt);
+      const date = document.createElement('div');
+      date.className = 'tz-date';
+      date.textContent = fmtDate(zdt);
+      const offset = document.createElement('div');
+      offset.className = 'tz-offset';
+      offset.textContent = `${zone.id} · UTC${zdt.offset}`;
+      el.append(h3, time, date, offset);
+      if (isHost) {
+        const badge = document.createElement('span');
+        badge.className = 'host-badge';
+        badge.textContent = 'Host';
+        el.append(badge);
+      }
+      return el;
+    }
+
+    function update() {
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      hostWarning.textContent = '';
+
+      if (!dateInput.value || !timeInput.value) {
+        status.textContent = 'Choose a date and time to see the schedule around the world.';
+        return;
+      }
+
+      let plainDateTime;
+      try {
+        plainDateTime = Temporal.PlainDate.from(dateInput.value)
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value));
+      } catch {
+        status.textContent = 'That date or time is not valid.';
+        return;
+      }
+
+      const hostTz = hostTzSelect.value;
+      const { resolved, conflict } = resolveHostTime(plainDateTime, hostTz);
+
+      if (conflict) {
+        hostWarning.textContent = describeConflict(conflict, plainDateTime, resolved, hostTz);
+        hostWarning.hidden = false;
+      }
+
+      // withTimeZone returns a new ZonedDateTime for the same exact instant; `resolved` is never modified.
+      for (const zone of TARGET_ZONES) {
+        grid.append(card(zone, resolved.withTimeZone(zone.id), zone.id === hostTz));
+      }
+      status.textContent = `Tasting starts at ${resolved.toInstant().toString({ smallestUnit: 'minute' })} (exact instant).`;
+    }
+
+    // Default to today's date in the host's zone.
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
