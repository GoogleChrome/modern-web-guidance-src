+      inline-size: max-content;
+      min-inline-size: 100px;
+      max-inline-size: 100%;
+      /* 1.2x the max-content size, clamped between 100px and 100% of the parent */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Our Sourcing accordion */
+    .accordion {
+      margin-block-start: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    .accordion h2 {
+      font-size: inherit;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding: 18px 20px;
+      border: 0;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: 600;
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .accordion-icon {
+      transition: rotate 0.3s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      rotate: 45deg;
+    }
+
+    /*
+      NOTE: Directly transitioning between two different intrinsic keyword
+      sizes (e.g. min-content -> max-content, or auto -> fit-content) is NOT
+      supported. One end of the transition must be a fixed length or
+      percentage — here we go from block-size: 0 to an auto-based size.
+    */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      /* visibility hides collapsed content from keyboard + assistive tech;
+         it flips at the start of opening and at the end of closing */
+      visibility: hidden;
+      transition: block-size 0.4s ease, visibility 0.4s;
+    }
+
+    .accordion-content.is-open {
+      visibility: visible;
+      /* Fallback for browsers without calc-size() (instant jump) */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room — calc-size() also makes
+         the value interpolatable on its own */
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    .accordion-inner {
+      padding: 20px 20px 0;
+    }
+
+    .accordion-inner h3 {
+      color: var(--primary);
+      font-size: 1rem;
+      margin-block-end: 4px;
+    }
+
+    .accordion-inner p + h3 {
+      margin-block-start: 16px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        /* No size animation: size snaps instantly, content gently fades */
+        opacity: 0;
+        transition: opacity 0.2s ease, visibility 0.2s;
+      }
+
+      .accordion-content.is-open {
+        opacity: 1;
+      }
+
+      .accordion-icon {
+        transition: none;
+      }
+    }
+
