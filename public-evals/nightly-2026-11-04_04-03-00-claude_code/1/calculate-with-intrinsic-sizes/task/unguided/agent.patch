+
+    /* Sourcing accordion */
+    .accordion {
+      margin-block-start: 50px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding-block: 18px;
+      padding-inline: 20px;
+      background: var(--primary);
+      color: white;
+      border: none;
+      font: inherit;
+      font-size: 1.2rem;
+      font-weight: bold;
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:hover {
+      background: var(--text);
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .accordion-icon {
+      transition: rotate 0.3s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      rotate: 45deg;
+    }
+
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease, visibility 0.4s allow-discrete;
+      visibility: hidden;
+    }
+
+    .accordion-content.is-open {
+      /* Fallback: no animation, just show at natural size */
+      block-size: auto;
+      visibility: visible;
+    }
+
+    @supports (block-size: calc-size(auto, size)) {
+      .accordion-content.is-open {
+        /* Natural height plus 2rem of breathing room */
+        block-size: calc-size(auto, size + 2rem);
+      }
+    }
+
+    .accordion-inner {
+      padding-block: 20px 0;
+      padding-inline: 20px;
+    }
+
+    .accordion-inner h3 {
+      color: var(--primary);
+      margin-block-end: 6px;
+    }
+
+    .accordion-inner p + h3 {
+      margin-block-start: 16px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content,
+      .accordion-icon {
+        transition: none;
+      }
+    }
