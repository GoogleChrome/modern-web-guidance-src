@@ -0,0 +1,91 @@
+import { sharedStyles, css, buttonRules } from './shared-styles.js';
+
+const styles = css(`
+  :host {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-height: var(--dg-hero-height, 60vh);
+    padding: 2rem 20px;
+    text-align: center;
+    color: #fff;
+    background-color: var(--_primary-dark);
+    background-image:
+      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--_hero-image, none);
+    background-size: cover;
+    background-position: center;
+  }
+
+  ::slotted(h1), ::slotted(h2) {
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+    margin: 0 0 1rem;
+  }
+
+  ::slotted(p) {
+    margin: 0;
+    max-width: 40rem;
+  }
+
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 0.75rem;
+    margin-top: 15px;
+  }
+
+  ${buttonRules('::slotted(a)', '::slotted(a:hover)')}
+
+  ::slotted(a:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 2px;
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <slot></slot>
+  <div class="actions" part="actions"><slot name="actions"></slot></div>
+`;
+
+/**
+ * <dg-hero> — full-width banner with a darkened background photo.
+ *
+ *   <dg-hero image="https://…/coffee.jpg">
+ *     <h1>Wake Up Your Senses</h1>
+ *     <p>Ethically sourced, locally roasted.</p>
+ *     <a slot="actions" href="/order-online">Order Now</a>
+ *   </dg-hero>
+ *
+ * Attributes:
+ *   image  Background image URL. It's decorative (CSS background), so the
+ *          heading/text must carry the meaning on their own.
+ *
+ * Custom properties: --dg-hero-height (default 60vh).
+ */
+export class DgHero extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sharedStyles, styles];
+    root.append(template.content.cloneNode(true));
+  }
+
+  attributeChangedCallback(name, _oldValue, newValue) {
+    if (name !== 'image') return;
+    if (newValue) {
+      // Quote and escape so arbitrary URLs can't break out of url("…").
+      const safe = newValue.replace(/["\\\n\r]/g, encodeURIComponent);
+      this.style.setProperty('--_hero-image', `url("${safe}")`);
+    } else {
+      this.style.removeProperty('--_hero-image');
+    }
+  }
+}
+
+customElements.define('dg-hero', DgHero);
diff --git a/components/dg-site-nav.js b/components/dg-site-nav.js
new file mode 100644
index 0000000..7618070
--- /dev/null
+++ b/components/dg-site-nav.js
@@ -0,0 +1,245 @@
+import { sharedStyles, css } from './shared-styles.js';
+
+const MOBILE_QUERY = '(max-width: 720px)';
+
+const styles = css(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--_primary);
+    color: #fff;
+  }
+
+  .bar {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 0.5rem 1rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    color: inherit;
+    text-decoration: none;
+  }
+
+  .menu {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+  }
+
+  .menu ::slotted(a) {
+    color: #fff;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+
+  .menu ::slotted(a:hover) { color: var(--_accent); }
+
+  ::slotted(a:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 3px;
+  }
+
+  .menu ::slotted(a[aria-current="page"]) {
+    color: var(--_accent);
+    text-decoration: underline;
+    text-underline-offset: 4px;
+  }
+
+  .menu ::slotted(a[data-variant="outline"]) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    justify-content: center;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    background: transparent;
+    color: inherit;
+    border: 1px solid rgba(255, 255, 255, 0.4);
+    border-radius: 4px;
+    cursor: pointer;
+  }
+
+  .toggle:hover { border-color: var(--_accent); }
+
+  .icon, .icon::before, .icon::after {
+    display: block;
+    width: 20px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.2s, background-color 0.2s;
+  }
+  .icon { position: relative; }
+  .icon::before, .icon::after { content: ""; position: absolute; left: 0; }
+  .icon::before { top: -6px; }
+  .icon::after { top: 6px; }
+
+  .toggle[aria-expanded="true"] .icon { background: transparent; }
+  .toggle[aria-expanded="true"] .icon::before { transform: translateY(6px) rotate(45deg); }
+  .toggle[aria-expanded="true"] .icon::after { transform: translateY(-6px) rotate(-45deg); }
+
+  @media ${MOBILE_QUERY} {
+    .toggle { display: inline-flex; }
+
+    .menu {
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0;
+      padding-top: 0.5rem;
+    }
+
+    /* Collapsed links are display:none, so they also leave the tab order. */
+    .menu:not(.open) { display: none; }
+
+    .menu ::slotted(a) {
+      display: block;
+      padding: 0.75rem 0;
+      font-size: 1rem;
+      border-top: 1px solid rgba(255, 255, 255, 0.15);
+    }
+
+    .menu ::slotted(a[data-variant="outline"]) {
+      margin-top: 0.75rem;
+      padding: 0.6rem 12px;
+      text-align: center;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="bar" part="bar">
+    <slot name="brand"></slot>
+    <button class="toggle" type="button" part="toggle"
+            aria-expanded="false" aria-controls="menu">
+      <span class="icon" aria-hidden="true"></span>
+      <span class="visually-hidden">Site navigation</span>
+    </button>
+    <nav class="menu" id="menu" part="menu">
+      <slot></slot>
+    </nav>
+  </div>
+`;
+
+/**
+ * <dg-site-nav> — sticky site header with a responsive, accessible menu.
+ *
+ * Content stays in the light DOM so links work (and are crawlable) without JS.
+ *
+ *   <dg-site-nav label="Main">
+ *     <a slot="brand" href="/">THE DAILY GRIND</a>
+ *     <a href="/menu">Menu</a>
+ *     <a href="/logout" data-variant="outline">Logout</a>
+ *   </dg-site-nav>
+ *
+ * Attributes:
+ *   label  Accessible name for the navigation landmark (default "Main").
+ *   open   Reflects whether the mobile menu is expanded.
+ *
+ * Events:
+ *   dg-nav-toggle  { detail: { open } } — fired when the mobile menu opens/closes.
+ *
+ * Keyboard: Escape closes the open menu and returns focus to the toggle.
+ */
+export class DgSiteNav extends HTMLElement {
+  static observedAttributes = ['label', 'open'];
+
+  #toggle;
+  #menu;
+  #mql = window.matchMedia(MOBILE_QUERY);
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sharedStyles, styles];
+    root.append(template.content.cloneNode(true));
+    this.#toggle = root.querySelector('.toggle');
+    this.#menu = root.querySelector('.menu');
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+  }
+
+  connectedCallback() {
+    this.#syncLabel();
+    this.#toggle.addEventListener('click', this.#onToggleClick);
+    this.#menu.addEventListener('click', this.#onMenuClick);
+    this.addEventListener('keydown', this.#onKeydown);
+    document.addEventListener('click', this.#onDocumentClick);
+    this.#mql.addEventListener('change', this.#onBreakpointChange);
+  }
+
+  disconnectedCallback() {
+    this.#toggle.removeEventListener('click', this.#onToggleClick);
+    this.#menu.removeEventListener('click', this.#onMenuClick);
+    this.removeEventListener('keydown', this.#onKeydown);
+    document.removeEventListener('click', this.#onDocumentClick);
+    this.#mql.removeEventListener('change', this.#onBreakpointChange);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'label') this.#syncLabel();
+    if (name === 'open' && (oldValue === null) !== (newValue === null)) {
+      const open = newValue !== null;
+      this.#toggle.setAttribute('aria-expanded', String(open));
+      this.#menu.classList.toggle('open', open);
+      this.dispatchEvent(new CustomEvent('dg-nav-toggle', {
+        bubbles: true,
+        composed: true,
+        detail: { open },
+      }));
+    }
+  }
+
+  #syncLabel() {
+    this.#menu.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+  }
+
+  #onToggleClick = () => {
+    this.open = !this.open;
+  };
+
+  // Following a link on mobile should collapse the menu.
+  #onMenuClick = (event) => {
+    if (this.open && event.target.closest('a')) this.open = false;
+  };
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.open) {
+      this.open = false;
+      this.#toggle.focus();
+    }
+  };
+
+  #onDocumentClick = (event) => {
+    if (this.open && !event.composedPath().includes(this)) this.open = false;
+  };
+
+  // Don't leave a stale "expanded" state behind when resizing to desktop.
+  #onBreakpointChange = (event) => {
+    if (!event.matches) this.open = false;
+  };
+}
+
+customElements.define('dg-site-nav', DgSiteNav);
diff --git a/components/favorites-store.js b/components/favorites-store.js
new file mode 100644
index 0000000..2dccfb5
--- /dev/null
+++ b/components/favorites-store.js
@@ -0,0 +1,57 @@
+/**
+ * Tiny persisted set of favorite item IDs shared by all <dg-coffee-card>s.
+ * Survives reloads via localStorage and syncs across tabs via the
+ * `storage` event. Falls back to in-memory if storage is unavailable.
+ */
+const STORAGE_KEY = 'dg:favorites';
+
+function load() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
+    return new Set(Array.isArray(parsed) ? parsed.map(String) : []);
+  } catch {
+    return new Set();
+  }
+}
+
+let ids = load();
+const listeners = new Map(); // id -> Set<(isFav: boolean) => void>
+
+function notify(id) {
+  const isFav = ids.has(id);
+  listeners.get(id)?.forEach((fn) => fn(isFav));
+}
+
+window.addEventListener('storage', (event) => {
+  if (event.key !== STORAGE_KEY && event.key !== null) return;
+  const previous = ids;
+  ids = load();
+  for (const id of new Set([...previous, ...ids])) {
+    if (previous.has(id) !== ids.has(id)) notify(id);
+  }
+});
+
+export const favorites = {
+  has(id) {
+    return ids.has(id);
+  },
+
+  set(id, isFav) {
+    if (ids.has(id) === isFav) return;
+    if (isFav) ids.add(id);
+    else ids.delete(id);
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify([...ids]));
+    } catch {
+      /* storage full or blocked — keep the in-memory state */
+    }
+    notify(id);
+  },
+
+  /** Returns an unsubscribe function. */
+  subscribe(id, fn) {
+    if (!listeners.has(id)) listeners.set(id, new Set());
+    listeners.get(id).add(fn);
+    return () => listeners.get(id)?.delete(fn);
+  },
+};
