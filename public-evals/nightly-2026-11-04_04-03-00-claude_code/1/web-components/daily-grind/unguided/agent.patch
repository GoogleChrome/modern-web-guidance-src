diff --git a/components/shared-styles.js b/components/shared-styles.js
new file mode 100644
index 0000000..a83692d
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,83 @@
+/**
+ * Button look, reusable for both shadow elements (`.btn`) and slotted
+ * light-DOM links (`::slotted(a)`), which can't be targeted by a class rule.
+ */
+export function buttonRules(selector, hoverSelector) {
+  return `
+    ${selector} {
+      display: inline-block;
+      background: var(--_primary);
+      color: #fff;
+      padding: 10px 20px;
+      border: 0;
+      border-radius: 5px;
+      font: inherit;
+      text-decoration: none;
+      cursor: pointer;
+      transition: background-color 0.3s;
+    }
+    ${hoverSelector} { background: var(--_primary-dark); }
+  `;
+}
+
+/**
+ * Styles shared by every Daily Grind component.
+ * One CSSStyleSheet instance is created and adopted by each shadow root, so
+ * the rules are parsed once and never leak into (or out of) the page.
+ *
+ * Theme tokens are CSS custom properties, which inherit through shadow
