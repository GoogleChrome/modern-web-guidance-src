diff --git a/components/dg-coffee-card.js b/components/dg-coffee-card.js
new file mode 100644
index 0000000..da79252
--- /dev/null
+++ b/components/dg-coffee-card.js
@@ -0,0 +1,269 @@
+import { sharedStyles, css, buttonRules } from './shared-styles.js';
+import { favorites } from './favorites-store.js';
+
+const styles = css(`
+  :host {
+    display: block;
+    height: 100%;
+  }
+
+  article {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    overflow: hidden;
+    background: var(--_surface);
+    border-radius: var(--_radius);
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+    transition: box-shadow 0.3s, transform 0.3s;
+  }
+
+  :host(:hover) article,
+  :host(:focus-within) article {
+    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+    transform: translateY(-2px);
+  }
+
+  .media {
+    aspect-ratio: 3 / 2;
+    width: 100%;
+    background: var(--_secondary);
+  }
+
+  .media img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex-direction: column;
+    flex: 1;
+    padding: 20px;
+  }
+
+  ::slotted([slot="title"]) {
+    margin: 0 0 10px;
+    color: var(--_primary);
+    font-size: 1.25rem;
+  }
+
+  ::slotted(:not([slot])) {
+    margin: 0;
+  }
+
+  .actions {
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    gap: 0.5rem;
+    margin-top: auto;
+    padding-top: 15px;
+  }
+
+  ${buttonRules('::slotted(a)', '::slotted(a:hover)')}
+
+  ::slotted(a:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 2px;
+  }
+
+  .favorite {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    background: transparent;
+    color: var(--_primary);
+    border: 1px solid var(--_secondary);
+    border-radius: 50%;
+    font-size: 1.25rem;
+    line-height: 1;
+    cursor: pointer;
+    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
+  }
+
+  .favorite:hover { border-color: var(--_primary); }
+
+  .favorite[aria-pressed="true"] {
+    background: var(--_accent);
+    border-color: var(--_accent);
+    color: var(--_primary-dark);
+  }
+
+  .favorite .on { display: none; }
+  .favorite[aria-pressed="true"] .on { display: inline; }
+  .favorite[aria-pressed="true"] .off { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article part="card">
+    <div class="media" part="media" hidden>
+      <img loading="lazy" decoding="async" width="600" height="400" alt="">
+    </div>
+    <div class="body" part="body">
+      <slot name="title"></slot>
+      <slot></slot>
+      <div class="actions" part="actions">
+        <slot name="action"></slot>
+        <button class="favorite" type="button" part="favorite" aria-pressed="false" hidden>
+          <span class="off" aria-hidden="true">&#9825;</span>
+          <span class="on" aria-hidden="true">&#9829;</span>
+          <span class="visually-hidden label">Favorite</span>
+        </button>
+      </div>
+    </div>
+  </article>
+`;
+
+let uid = 0;
+
+/**
+ * <dg-coffee-card> — a menu item card with optional photo and favorite toggle.
+ *
+ * Title, description and link live in the light DOM, so the card still reads
+ * (and its link still works) before / without JavaScript.
+ *
+ *   <dg-coffee-card item-id="maple-oat-latte"
+ *                   image="https://…/latte.jpg" image-alt="Latte art being poured">
+ *     <h3 slot="title">Maple Oat Latte</h3>
+ *     <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+ *     <a slot="action" href="/menu/seasonal">View Details</a>
+ *   </dg-coffee-card>
+ *
+ * Attributes:
+ *   image      Photo URL (optional).
+ *   image-alt  Alt text. Omit for a purely decorative photo.
+ *   item-id    Stable ID; enables the favorite toggle (persisted in localStorage).
+ *   favorite   Reflects the favorite state.
+ *
+ * Events:
+ *   dg-favorite-change  { detail: { id, favorite } }
+ *
+ * Accessibility: generic link text like "View Details" is automatically
+ * described by the card title (aria-describedby), and the favorite button is
+ * a toggle (aria-pressed) named "Favorite <title>".
+ */
+export class DgCoffeeCard extends HTMLElement {
+  static observedAttributes = ['image', 'image-alt', 'item-id', 'favorite'];
+
+  #root;
+  #img;
+  #media;
+  #favButton;
+  #favLabel;
+  #titleSlot;
+  #actionSlot;
+  #unsubscribe = null;
+
+  constructor() {
+    super();
+    this.#root = this.attachShadow({ mode: 'open' });
+    this.#root.adoptedStyleSheets = [sharedStyles, styles];
+    this.#root.append(template.content.cloneNode(true));
+
+    this.#img = this.#root.querySelector('img');
+    this.#media = this.#root.querySelector('.media');
+    this.#favButton = this.#root.querySelector('.favorite');
+    this.#favLabel = this.#root.querySelector('.favorite .label');
+    this.#titleSlot = this.#root.querySelector('slot[name="title"]');
+    this.#actionSlot = this.#root.querySelector('slot[name="action"]');
+
+    // Hide the photo area instead of showing a broken-image icon.
+    this.#img.addEventListener('error', () => { this.#media.hidden = true; });
+    this.#favButton.addEventListener('click', () => this.toggleFavorite());
+    this.#titleSlot.addEventListener('slotchange', () => this.#linkTitle());
+    this.#actionSlot.addEventListener('slotchange', () => this.#linkTitle());
+  }
+
+  get itemId() {
+    return this.getAttribute('item-id');
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  toggleFavorite() {
+    this.favorite = !this.favorite;
+  }
+
+  connectedCallback() {
+    this.#subscribe();
+    this.#linkTitle();
+  }
+
+  disconnectedCallback() {
+    this.#unsubscribe?.();
+    this.#unsubscribe = null;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    switch (name) {
+      case 'image':
+        this.#media.hidden = !newValue;
+        if (newValue) this.#img.src = newValue;
+        else this.#img.removeAttribute('src');
+        break;
+      case 'image-alt':
+        this.#img.alt = newValue ?? '';
+        break;
+      case 'item-id':
+        this.#favButton.hidden = !newValue;
+        if (this.isConnected) this.#subscribe();
+        break;
+      case 'favorite': {
+        const isFav = newValue !== null;
+        if ((oldValue !== null) === isFav) return;
+        this.#favButton.setAttribute('aria-pressed', String(isFav));
+        const id = this.itemId;
+        if (id && favorites.has(id) !== isFav) {
+          favorites.set(id, isFav);
+          this.dispatchEvent(new CustomEvent('dg-favorite-change', {
+            bubbles: true,
+            composed: true,
+            detail: { id, favorite: isFav },
+          }));
+        }
+        break;
+      }
+    }
+  }
+
+  // Keep in sync with the store (other cards with the same id, other tabs).
+  #subscribe() {
+    this.#unsubscribe?.();
+    this.#unsubscribe = null;
+    const id = this.itemId;
+    if (!id) return;
+    this.favorite = favorites.has(id);
+    this.#unsubscribe = favorites.subscribe(id, (isFav) => { this.favorite = isFav; });
+  }
+
+  // Give generic links/buttons context from the card title.
+  #linkTitle() {
+    const title = this.#titleSlot.assignedElements()[0];
+    const text = title?.textContent.trim() ?? '';
+    this.#favLabel.textContent = text ? `Favorite ${text}` : 'Favorite';
+
+    if (!title) return;
+    if (!title.id) title.id = `dg-coffee-card-title-${++uid}`;
+    for (const el of this.#actionSlot.assignedElements()) {
+      if (!el.hasAttribute('aria-label') && !el.hasAttribute('aria-describedby')) {
+        el.setAttribute('aria-describedby', title.id);
+      }
+    }
+  }
+}
+
+customElements.define('dg-coffee-card', DgCoffeeCard);
diff --git a/components/dg-hero.js b/components/dg-hero.js
