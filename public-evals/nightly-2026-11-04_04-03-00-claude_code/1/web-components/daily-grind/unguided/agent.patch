+    --_text: var(--dg-text, #3e2723);
+    --_surface: var(--dg-surface, #ffffff);
+    --_radius: var(--dg-radius, 8px);
+    --_focus-ring: 3px solid var(--_accent);
+    box-sizing: border-box;
+  }
