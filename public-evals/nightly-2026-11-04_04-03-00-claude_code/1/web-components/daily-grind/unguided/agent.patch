+  *, *::before, *::after { box-sizing: inherit; }
+
+  [hidden] { display: none !important; }
+
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
