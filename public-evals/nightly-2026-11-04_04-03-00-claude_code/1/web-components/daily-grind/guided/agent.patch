index 0000000..9f79800
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,158 @@
+import { baseSheet } from './shared-styles.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: block;
+    container-type: inline-size;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--_primary);
+    color: #fff;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 0.5rem 1.25rem;
+    padding: 1rem 5%;
+  }
+
+  slot[name="brand"]::slotted(*) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  .toggle {
+    font: inherit;
+    color: inherit;
+    background: transparent;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    padding: 0.35rem 0.75rem;
+    cursor: pointer;
+    display: inline-flex;
+    align-items: center;
+    gap: 0.5rem;
+  }
+  .toggle:focus-visible { outline: var(--_focus-ring); outline-offset: 2px; }
+  .toggle svg { inline-size: 1.1em; block-size: 1.1em; }
+
+  .menu {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+    inline-size: 100%;
+    padding-block: 0.5rem;
+  }
+
+  .menu ::slotted(a) {
+    color: inherit;
+    text-decoration: none;
+    font-size: 0.9rem;
+    padding: 0.5rem 0;
+    transition: color 0.3s;
+  }
+  .menu ::slotted(a:hover) { color: var(--_accent); }
+  .menu ::slotted(a:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 2px;
+    border-radius: 2px;
+  }
+  .menu ::slotted([aria-current="page"]) { color: var(--_accent); }
+  .menu ::slotted([data-variant="outlined"]) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+    align-self: start;
+  }
+
+  /* Wide layout: always show links inline, hide the disclosure button. */
+  @container (min-width: 46rem) {
+    .toggle { display: none; }
+    .menu, .menu[hidden] {
+      display: flex !important;
+      flex-direction: row;
+      align-items: center;
+      gap: 1.25rem;
+      inline-size: auto;
+      padding: 0;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
+        <path d="M4 7h16M4 12h16M4 17h16"/>
+      </svg>
+      <span>Menu</span>
+    </button>
+    <div class="menu" id="menu" part="menu" hidden>
+      <slot></slot>
+    </div>
+  </nav>
+`;
+
+/**
+ * <site-nav label="Main">
+ *   <a slot="brand" href="/">Brand</a>
+ *   <a href="/menu">Menu</a> …
+ * </site-nav>
+ *
+ * Responsive site navigation. Links stay in the light DOM (crawlable, usable
+ * before upgrade); on narrow containers they collapse behind a disclosure
+ * button that supports Escape-to-close.
+ */
+class SiteNav extends HTMLElement {
+  #toggle;
+  #menu;
+  #nav;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseSheet, sheet];
+    root.append(template.content.cloneNode(true));
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#menu = root.querySelector('.menu');
+
+    this.#toggle.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.expanded) {
+        this.toggle(false);
+        this.#toggle.focus();
+      }
+    });
+  }
+
+  static get observedAttributes() { return ['label']; }
+
+  connectedCallback() { this.#syncLabel(); }
+
+  attributeChangedCallback() { this.#syncLabel(); }
+
+  get expanded() { return this.#toggle.getAttribute('aria-expanded') === 'true'; }
+
+  /** Open/close the collapsed menu. Pass a boolean to force a state. */
+  toggle(force = !this.expanded) {
+    this.#toggle.setAttribute('aria-expanded', String(force));
+    this.#menu.hidden = !force;
+  }
+
+  #syncLabel() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+  }
+}
+
+customElements.define('site-nav', SiteNav);
