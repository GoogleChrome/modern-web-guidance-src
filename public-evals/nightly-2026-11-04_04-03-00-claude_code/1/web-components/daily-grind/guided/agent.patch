new file mode 100644
index 0000000..cdada1c
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,43 @@
+/**
+ * Constructable stylesheets shared by every Daily Grind component.
+ * One CSSStyleSheet instance is parsed once and adopted by each shadow root.
+ *
+ * Theming: components read the page's public custom properties
+ * (--primary, --accent, --text, …) with fallbacks, so they work standalone.
+ */
+export const baseSheet = new CSSStyleSheet();
+baseSheet.replaceSync(`
+  :host {
+    --_primary: var(--primary, #4e342e);
+    --_primary-strong: var(--primary-strong, #3e2723);
+    --_accent: var(--accent, #ffab40);
+    --_text: var(--text, #3e2723);
+    --_surface: var(--surface, #fff);
+    --_radius: var(--radius, 8px);
+    --_focus-ring: 3px solid var(--_accent);
+    box-sizing: border-box;
+  }
+  *, *::before, *::after { box-sizing: inherit; }
+
+  [hidden] { display: none !important; }
+
+  /* Button look for slotted call-to-action links. */
+  .btn-slot::slotted(a) {
+    display: inline-block;
+    background: var(--_primary);
+    color: #fff;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    transition: background-color 0.3s;
+  }
+  .btn-slot::slotted(a:hover) { background: var(--_primary-strong); }
+  .btn-slot::slotted(a:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 3px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after, .btn-slot::slotted(a) { transition: none !important; }
+  }
+`);
