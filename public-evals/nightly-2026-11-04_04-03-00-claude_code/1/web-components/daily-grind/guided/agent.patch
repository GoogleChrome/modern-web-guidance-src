diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..471da9d
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,232 @@
+import { baseSheet } from './shared-styles.js';
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* Storage unavailable (private mode, quota): favorite still works for this page view. */
+  }
+}
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: block;
+    container-type: inline-size;
+    block-size: 100%;
+  }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    block-size: 100%;
+    background: var(--_surface);
+    border-radius: var(--_radius);
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.2s, translate 0.2s;
+  }
+  .card:hover,
+  .card:focus-within {
+    box-shadow: 0 6px 16px rgb(0 0 0 / 0.15);
+  }
+  @media (prefers-reduced-motion: no-preference) {
+    .card:hover { translate: 0 -2px; }
+  }
+
+  .media::slotted(img) {
+    display: block;
+    inline-size: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+    block-size: auto;
+  }
+
+  .body {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 10px;
+    flex: 1;
+    padding: 20px;
+  }
+
+  slot[name="heading"]::slotted(*) {
+    margin: 0;
+    color: var(--_primary);
+    font-size: 1.25rem;
+  }
+  .description::slotted(*) { margin: 0; }
+
+  .actions {
+    margin-block-start: auto;
+    padding-block-start: 5px;
+  }
+
+  .favorite {
+    position: absolute;
+    inset-block-start: 10px;
+    inset-inline-end: 10px;
+    display: grid;
+    place-items: center;
+    inline-size: 44px;
+    block-size: 44px;
+    padding: 0;
+    border: 0;
+    border-radius: 50%;
+    background: rgb(255 255 255 / 0.9);
+    color: var(--_primary);
+    cursor: pointer;
+    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
+    transition: scale 0.15s;
+  }
+  .favorite:hover { scale: 1.08; }
+  .favorite:focus-visible { outline: var(--_focus-ring); outline-offset: 2px; }
+  .favorite svg {
+    inline-size: 22px;
+    block-size: 22px;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+  }
+  .favorite[aria-pressed="true"] { color: #c62828; }
+  .favorite[aria-pressed="true"] svg { fill: currentColor; }
+
+  /* Side-by-side layout when a card is given plenty of room. */
+  @container (min-width: 32rem) {
+    .card { flex-direction: row; text-align: start; }
+    .media::slotted(img) { inline-size: 45%; aspect-ratio: auto; block-size: 100%; }
+    .body { align-items: start; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="card" part="card">
+    <slot class="media" name="media"></slot>
+    <div class="body" part="body">
+      <slot name="heading"></slot>
+      <slot class="description"></slot>
+      <div class="actions"><slot class="btn-slot" name="action"></slot></div>
+    </div>
+    <button class="favorite" part="favorite" type="button" aria-pressed="false">
+      <svg viewBox="0 0 24 24" aria-hidden="true">
+        <path d="M12 21s-7.5-4.6-9.5-9.2C1.1 8.4 3.3 5 6.8 5c2 0 3.6 1.1 5.2 3 1.6-1.9 3.2-3 5.2-3 3.5 0 5.7 3.4 4.3 6.8C19.5 16.4 12 21 12 21z"/>
+      </svg>
+    </button>
+  </div>
+`;
+
+let uid = 0;
+
+/**
+ * <coffee-card item="maple-oat-latte">
+ *   <img slot="media" src="…" alt="…" width="400" height="300" loading="lazy">
+ *   <h3 slot="heading">Maple Oat Latte</h3>
+ *   <p>Description…</p>
+ *   <a slot="action" href="/menu/seasonal">View Details</a>
+ * </coffee-card>
+ *
+ * Attributes:  item       – stable id used to persist the favorite (falls back to heading text)
+ *              favorited  – reflected boolean state
+ * Events:      favorite-change  { detail: { item, favorited } }  (bubbles, composed)
+ * Parts:       card, body, favorite
+ * CSS state:   coffee-card:state(favorited)
+ */
+class CoffeeCard extends HTMLElement {
+  #internals = this.attachInternals();
+  #button;
+  #headingSlot;
+  #actionSlot;
+
+  static get observedAttributes() { return ['favorited']; }
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseSheet, sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#button = root.querySelector('.favorite');
+    this.#headingSlot = root.querySelector('slot[name="heading"]');
+    this.#actionSlot = root.querySelector('slot[name="action"]');
+
+    this.#button.addEventListener('click', () => this.toggleFavorite());
+    this.#headingSlot.addEventListener('slotchange', () => this.#syncLabels());
+    this.#actionSlot.addEventListener('slotchange', () => this.#syncLabels());
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('favorited') && readFavorites().has(this.itemId)) {
+      this.favorited = true;
+    }
+    this.#syncLabels();
+    this.#render();
+  }
+
+  attributeChangedCallback() { this.#render(); }
+
+  get itemId() {
+    return this.getAttribute('item') || this.#headingText.toLowerCase().replace(/\W+/g, '-');
+  }
+
+  get favorited() { return this.hasAttribute('favorited'); }
+  set favorited(value) { this.toggleAttribute('favorited', Boolean(value)); }
+
+  toggleFavorite(force = !this.favorited) {
+    this.favorited = force;
+
+    const favorites = readFavorites();
+    force ? favorites.add(this.itemId) : favorites.delete(this.itemId);
+    writeFavorites(favorites);
+
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { item: this.itemId, favorited: force },
+    }));
+  }
+
+  get #heading() { return this.#headingSlot.assignedElements()[0] ?? null; }
+
+  get #headingText() { return this.#heading?.textContent.trim() ?? ''; }
+
+  #render() {
+    const on = this.favorited;
+    this.#button.setAttribute('aria-pressed', String(on));
+    // Custom states give consumers a read-only styling hook; skip where unsupported.
+    try {
+      on ? this.#internals.states.add('favorited') : this.#internals.states.delete('favorited');
+    } catch { /* CustomStateSet unavailable — [favorited] attribute still works. */ }
+  }
+
+  #syncLabels() {
+    const name = this.#headingText;
+    // The button lives in the shadow tree and the heading in the light DOM, so an
+    // id reference can't cross the boundary; use plain label text instead.
+    this.#button.setAttribute('aria-label', name ? `Favorite ${name}` : 'Favorite');
+
+    // Give generic "View Details" links context from the card heading.
+    // Both live in the light DOM, so an id reference works here.
+    const heading = this.#heading;
+    const link = this.#actionSlot.assignedElements()[0];
+    if (heading && link && !link.hasAttribute('aria-describedby')) {
+      heading.id ||= `coffee-card-heading-${++uid}`;
+      link.setAttribute('aria-describedby', heading.id);
+    }
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/components/hero-banner.js b/components/hero-banner.js
new file mode 100644
index 0000000..7fe5dd9
--- /dev/null
+++ b/components/hero-banner.js
@@ -0,0 +1,81 @@
+import { baseSheet } from './shared-styles.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: grid;
+    position: relative;
+    isolation: isolate;
+    min-block-size: var(--hero-height, 60vh);
+    color: #fff;
+    text-align: center;
+    overflow: hidden;
+    background: var(--_primary-strong);
+  }
+
+  /* Media, scrim and content share one grid cell so text overlays the image.
+     (<slot> is display: contents, so the slotted <img> itself is the grid item.) */
+  .content { grid-area: 1 / 1; }
+
+  .media::slotted(img) {
+    grid-area: 1 / 1;
+    inline-size: 100%;
+    block-size: 100%;
+    object-fit: cover;
+    z-index: -2;
+  }
+  .scrim {
+    grid-area: 1 / 1;
+    z-index: -1;
+    background: var(--hero-scrim, rgb(0 0 0 / 0.5));
+  }
+
+  .content {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    gap: 1rem;
+    padding: 2rem 20px;
+  }
+
+  slot[name="heading"]::slotted(*) {
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+    margin: 0;
+  }
+  .lede::slotted(*) { margin: 0; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <slot class="media" name="media"></slot>
+  <div class="scrim" aria-hidden="true"></div>
+  <div class="content">
+    <slot name="heading"></slot>
+    <slot class="lede"></slot>
+    <slot class="btn-slot" name="action"></slot>
+  </div>
+`;
+
+/**
+ * <hero-banner>
+ *   <img slot="media" src="…" alt="" fetchpriority="high">
+ *   <h1 slot="heading">Title</h1>
+ *   <p>Supporting copy</p>
+ *   <a slot="action" href="…">Call to action</a>
+ * </hero-banner>
+ *
+ * The image is a real <img> (not a CSS background) so the browser can discover
+ * and prioritise it as the LCP element.
+ */
+class HeroBanner extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseSheet, sheet];
+    root.append(template.content.cloneNode(true));
+  }
+}
+
+customElements.define('hero-banner', HeroBanner);
