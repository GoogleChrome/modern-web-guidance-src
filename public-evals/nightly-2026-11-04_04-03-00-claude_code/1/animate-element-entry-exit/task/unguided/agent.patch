+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+
+      var promos = [
+        { title: 'Happy Hour', text: 'Half-price cold brew every weekday from 2&ndash;4pm.', code: 'CHILL50' },
+        { title: 'Pastry Pairing', text: 'Add a fresh croissant to any latte for just $1.', code: 'FLAKY1' },
+        { title: 'Double Stamps', text: 'Earn twice the rewards on every order this weekend.', code: 'STAMPX2' },
+        { title: 'Beans to Go', text: '15% off any bag of whole-bean coffee.', code: 'BEANS15' },
+        { title: 'Early Bird', text: 'Free extra shot on orders before 8am.', code: 'SUNRISE' }
+      ];
+      var promoIndex = 0;
+      var LEAVE_FALLBACK_MS = 450;
+
+      // Run `done` once the card's transition finishes (with a timeout fallback
+      // in case transitionend never fires, e.g. reduced motion or display changes).
+      function afterTransition(card, done) {
+        var finished = false;
+        function finish(e) {
+          if (e && (e.target !== card || e.propertyName !== 'opacity')) return;
+          if (finished) return;
+          finished = true;
+          card.removeEventListener('transitionend', finish);
+          clearTimeout(timer);
+          done();
+        }
+        card.addEventListener('transitionend', finish);
+        var timer = setTimeout(finish, LEAVE_FALLBACK_MS);
+      }
+
+      function animateIn(card) {
+        card.classList.remove('card-leave');
+        card.classList.add('card-enter');
+        void card.offsetWidth; // force reflow so the start state is applied
+        card.classList.remove('card-enter');
+      }
+
+      function animateOut(card, done) {
+        card.classList.add('card-leave');
+        afterTransition(card, function () {
+          // Only finish if the leave wasn't cancelled by a newer action.
+          if (card.classList.contains('card-leave')) done();
+        });
+      }
+
+      function createPromoCard() {
+        var promo = promos[promoIndex % promos.length];
+        promoIndex++;
+        var card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML =
+          '<h3>' + promo.title + '</h3>' +
+          '<p>' + promo.text + '</p>' +
+          '<span class="promo-code">' + promo.code + '</span>';
+        return card;
+      }
+
+      addBtn.addEventListener('click', function () {
+        var card = createPromoCard();
+        card.classList.add('card-enter');
+        container.appendChild(card);
+        animateIn(card);
+      });
+
+      removeBtn.addEventListener('click', function () {
+        // Last card that isn't already on its way out.
+        var cards = container.querySelectorAll('.card:not(.card-leave)');
+        var card = cards[cards.length - 1];
+        if (!card) return;
+        if (card.hidden) {
+          card.remove();
+          return;
+        }
+        animateOut(card, function () { card.remove(); });
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        var card = document.getElementById('toggleCard');
+        if (!card) return;
+        var isHiding = !card.hidden && !card.classList.contains('card-leave');
+        toggleBtn.setAttribute('aria-expanded', String(!isHiding));
+        if (isHiding) {
+          animateOut(card, function () {
+            card.hidden = true;
+            card.classList.remove('card-leave');
+          });
+        } else {
+          card.hidden = false;
+          animateIn(card);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
