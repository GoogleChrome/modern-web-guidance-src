+  <script>
+    (() => {
+      const container = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const promos = [
+        { title: 'Pastry Pairing', text: 'Half-price croissant with any large latte.' },
+        { title: 'Happy Hour Cold Brew', text: '2-4pm weekdays: cold brew for just $2.' },
+        { title: 'Double Stamps', text: 'Earn twice the rewards on every order this week.' },
+        { title: 'Bean Bundle', text: 'Take 20% off any two bags of whole beans.' },
+      ];
+      let promoCount = 0;
+
+      // Firefox parses allow-discrete but doesn't transition display (bug 1882408),
+      // so probe real support and fall back to a [data-closing] visual exit state.
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      async function hideElement(el) {
+        if (canTransitionDisplay()) {
+          el.hidden = true;
+        } else {
+          el.setAttribute('data-closing', '');
+        }
+
+        const animations = el.getAnimations();
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+
+        // Skipped if showElement() cancelled the close mid-animation.
+        if (el.hasAttribute('data-closing')) {
+          el.removeAttribute('data-closing');
+          el.hidden = true;
+        }
+      }
+
+      function showElement(el) {
+        el.removeAttribute('data-closing');
+        el.hidden = false;
+      }
+
+      async function removeElement(el) {
+        await hideElement(el);
+        el.remove();
+      }
+
+      function isHidden(el) {
+        return el.hidden || el.hasAttribute('data-closing');
+      }
+
+      function createPromoCard() {
+        const promo = promos[promoCount % promos.length];
+        promoCount += 1;
+
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        const tag = document.createElement('span');
+        tag.className = 'tag';
+        tag.textContent = 'Limited Time';
+
+        const title = document.createElement('h3');
+        title.textContent = promo.title;
+
+        const text = document.createElement('p');
+        text.textContent = promo.text;
+
+        const link = document.createElement('a');
+        link.href = '/rewards';
+        link.className = 'btn';
+        link.textContent = 'Claim Offer';
+
+        card.append(tag, title, text, link);
+        return card;
+      }
+
+      addBtn.addEventListener('click', () => {
+        // @starting-style handles the fade/scale-in on insertion.
+        container.appendChild(createPromoCard());
+      });
+
+      removeBtn.addEventListener('click', () => {
+        // Skip cards already animating out so rapid clicks remove successive cards.
+        const cards = container.querySelectorAll('.card:not([data-removing])');
+        const last = cards[cards.length - 1];
+        if (!last) return;
+
+        last.setAttribute('data-removing', '');
+        removeElement(last).then(() => {
+          if (last === toggleCard) {
+            toggleBtn.disabled = true;
+            toggleBtn.setAttribute('aria-expanded', 'false');
+          }
+        });
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        if (!toggleCard.isConnected || toggleCard.hasAttribute('data-removing')) return;
+
+        if (isHidden(toggleCard)) {
+          showElement(toggleCard);
+          toggleBtn.setAttribute('aria-expanded', 'true');
+        } else {
+          hideElement(toggleCard);
+          toggleBtn.setAttribute('aria-expanded', 'false');
+        }
+      });
+    })();
+  </script>
+
