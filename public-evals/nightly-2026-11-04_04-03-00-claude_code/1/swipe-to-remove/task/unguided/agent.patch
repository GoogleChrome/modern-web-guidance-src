+  <script>
+    (function () {
+      var THRESHOLD_RATIO = 0.4;   // fraction of item width needed to remove
+      var DRAG_START_PX = 8;       // movement before we decide horizontal vs vertical
+
+      var list = document.querySelector('.SwipeableList');
+      if (!list) return;
+      var emptyMsg = document.querySelector('.cart-empty');
+      var status = document.getElementById('cart-status');
+
+      function removeItem(item, direction) {
+        if (item.classList.contains('is-removing')) return;
+        item.classList.add('is-removing', 'is-armed', 'is-settling');
+        var content = item.querySelector('.SwipeableList-content');
+        var name = item.querySelector('h3').textContent;
+
+        // 1) slide the content fully off
+        content.style.transform = 'translateX(' + (direction * 110) + '%)';
+
+        // 2) then collapse the height smoothly
+        setTimeout(function () {
+          item.style.height = item.offsetHeight + 'px';
+          item.offsetHeight; // force reflow so the transition starts from the fixed height
+          item.style.height = '0px';
+          item.style.marginBottom = '0px';
+          item.style.opacity = '0';
+
+          var done = false;
+          function finish() {
+            if (done) return;
+            done = true;
+            var next = item.nextElementSibling || item.previousElementSibling;
+            var hadFocus = item === document.activeElement;
+            item.remove();
+            if (hadFocus && next) next.focus();
+            if (status) status.textContent = name + ' removed from cart.';
+            if (!list.children.length && emptyMsg) emptyMsg.hidden = false;
+          }
+          item.addEventListener('transitionend', function (e) {
+            if (e.target === item && e.propertyName === 'height') finish();
+          });
+          setTimeout(finish, 450); // fallback (e.g. reduced motion)
+        }, 220);
+      }
+
+      function setup(item) {
+        var content = item.querySelector('.SwipeableList-content');
+        var startX = 0, startY = 0, dx = 0;
+        var pointerId = null, mode = null; // null | 'swipe' | 'scroll'
+
+        function reset() {
+          item.classList.remove('is-dragging', 'is-armed');
+          item.classList.add('is-settling');
+          content.style.transform = '';
+          pointerId = null;
+          mode = null;
+          dx = 0;
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || item.classList.contains('is-removing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          mode = null;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var mx = e.clientX - startX;
+          var my = e.clientY - startY;
+
+          if (mode === null) {
+            if (Math.abs(mx) < DRAG_START_PX && Math.abs(my) < DRAG_START_PX) return;
+            if (Math.abs(my) > Math.abs(mx)) { mode = 'scroll'; return; }
+            mode = 'swipe';
+            content.setPointerCapture(pointerId);
+            item.classList.remove('is-settling');
+            item.classList.add('is-dragging');
+          }
+          if (mode !== 'swipe') return;
+
+          dx = mx;
+          content.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-armed', Math.abs(dx) > item.offsetWidth * THRESHOLD_RATIO);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          if (mode === 'swipe' && Math.abs(dx) > item.offsetWidth * THRESHOLD_RATIO) {
+            item.classList.remove('is-dragging');
+            pointerId = null;
+            removeItem(item, dx > 0 ? 1 : -1);
+          } else {
+            reset();
+          }
+        }
+
+        content.addEventListener('pointerup', end);
+        content.addEventListener('pointercancel', function (e) { if (e.pointerId === pointerId) reset(); });
+
+        item.addEventListener('keydown', function (e) {
+          if (e.key === 'Delete' || e.key === 'Backspace') {
+            e.preventDefault();
+            removeItem(item, -1);
+          }
+        });
+      }
+
+      Array.prototype.forEach.call(list.querySelectorAll('.SwipeableList-item'), setup);
+    })();
+  </script>
 </body>
 
