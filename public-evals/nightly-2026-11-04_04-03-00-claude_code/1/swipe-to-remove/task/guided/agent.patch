+  <script>
+    (() => {
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+      const swipeObservers = new WeakMap();
+      const statusEl = document.getElementById('cart-status');
+
+      // Safari resets snap position when the track resizes; re-centre content.
+      const trackResizeObserver = needsScrollWorkaround
+        ? new ResizeObserver((entries) => {
+            for (const entry of entries) {
+              entry.target.scrollLeft = entry.target.clientWidth;
+            }
+          })
+        : null;
+
+      // Lazily wire items as they enter the viewport; pause offscreen ones.
+      const viewportObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          const item = entry.target;
+          if (entry.isIntersecting) {
+            const handle = swipeObservers.get(item) ?? setupItem(item);
+            handle.observer.observe(handle.content);
+          } else {
+            swipeObservers.get(item)?.observer.unobserve(swipeObservers.get(item).content);
+          }
+        }
+      });
+
+      function detachItem(item) {
+        const handle = swipeObservers.get(item);
+        viewportObserver.unobserve(item);
+        if (handle) {
+          handle.observer.disconnect();
+          if (needsScrollWorkaround) trackResizeObserver.unobserve(handle.track);
+        }
+      }
+
+      function setupItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = track.querySelector('.SwipeableList-content');
+
+        // Turns the track into a snap container (CSS is gated on this class).
+        item.classList.add('is-initialized');
+
+        // Must run after .is-initialized and before the inner observer attaches.
+        if (needsScrollWorkaround) {
+          track.scrollLeft = track.clientWidth;
+          trackResizeObserver.observe(track);
+        }
+
+        const activateThreshold = 0.8; // icon pops past this point
+        const commitThreshold = 0.2;   // point of no return
+
+        const observer = new IntersectionObserver((entries) => {
+          const entry = entries.at(-1);
+          const ratio = entry.intersectionRatio;
+          const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+          const direction = offset > 0 ? 'left' : 'right';
+
+          if (ratio < commitThreshold) {
+            detachItem(item);
+            removeItem(item, content, direction, entry.boundingClientRect, offset);
+            return;
+          }
+
+          item.classList.toggle('is-activating', ratio < activateThreshold);
+          if (offset !== 0) item.dataset.swipeDirection = direction;
+        }, {
+          root: track,
+          threshold: [commitThreshold, activateThreshold],
+        });
+
+        // Accessible alternative to the swipe gesture.
+        item.querySelector('.cart-item-remove')?.addEventListener('click', () => {
+          detachItem(item);
+          const rect = content.getBoundingClientRect();
+          const offset = rect.x - track.getBoundingClientRect().x;
+          removeItem(item, content, 'right', rect, offset);
+        }, { once: true });
+
+        const handle = { observer, content, track };
+        swipeObservers.set(item, handle);
+        return handle;
+      }
+
+      async function removeItem(item, content, direction, rect, offset) {
+        const list = item.closest('.SwipeableList');
+        const name = item.querySelector('h3')?.textContent ?? 'Item';
+
+        // Move focus somewhere sensible before the row disappears.
+        if (item.contains(document.activeElement)) {
+          const next = item.nextElementSibling ?? item.previousElementSibling;
+          next?.querySelector('.SwipeableList-track')?.focus();
+        }
+
+        const duration = reduceMotion.matches ? 0 : 300;
+        const opts = { duration, easing: 'ease', fill: 'forwards' };
+        const translate = direction === 'left'
+          ? rect.width - offset
+          : -(offset + rect.width);
+
+        // Shows the action colour, then collapses the row's height.
+        item.classList.add('is-removing');
+        item.animate([{ height: `${rect.height}px` }, { height: '0px' }], opts);
+        content.animate([{ translate: `${translate}px` }], opts);
+        await Promise.allSettled(
+          item.getAnimations({ subtree: true }).map((a) => a.finished),
+        );
+
+        statusEl.textContent = `${name} removed from cart.`;
+
+        const finish = () => {
+          item.remove();
+          if (list && !list.querySelector('.SwipeableList-item')) {
+            list.hidden = true;
+            list.parentElement.querySelector('.cart-empty')?.removeAttribute('hidden');
+            list.parentElement.querySelector('.cart-hint')?.setAttribute('hidden', '');
+          }
+        };
+
+        // Safari scroll-latching bug: defer removal until momentum settles.
+        if (globalThis.GestureEvent) {
+          item.inert = true;
+          setTimeout(finish, 5000);
+        } else {
+          finish();
+        }
+      }
+
+      function setupList(list) {
+        for (const item of list.children) {
+          if (item.matches('.SwipeableList-item')) viewportObserver.observe(item);
+        }
+        new MutationObserver((mutations) => {
+          for (const mutation of mutations) {
+            for (const node of mutation.addedNodes) {
+              if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+                viewportObserver.observe(node);
+              }
+            }
+          }
+        }).observe(list, { childList: true });
+      }
+
+      document.querySelectorAll('.SwipeableList').forEach(setupList);
+    })();
+  </script>
+
