+  <script>
+    (() => {
+      const viewport = document.querySelector('.map-viewport');
+      if (!viewport) return;
+
+      // Start centered on the map
+      viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
+      viewport.scrollTop = (viewport.scrollHeight - viewport.clientHeight) / 2;
+
+      // Native CSS handles unrestricted 2D panning where scroll-axis-lock is supported.
+      if (CSS.supports('scroll-axis-lock', 'none')) return;
+
+      // Fallback: apply raw (unlocked) 2D deltas directly to scrollLeft/scrollTop.
+      viewport.addEventListener('wheel', (e) => {
+        if (e.ctrlKey) return; // leave pinch-zoom / ctrl+wheel to the browser
+        e.preventDefault();
+        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+        viewport.scrollLeft += e.deltaX * unit;
+        viewport.scrollTop += e.deltaY * unit;
+      }, { passive: false });
+
+      const DRAG_THRESHOLD = 5;
+      let start = null;
+      let last = null;
+      let dragging = false;
+      let suppressClick = false;
+
+      viewport.addEventListener('pointerdown', (e) => {
+        const rect = viewport.getBoundingClientRect();
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) return;
+        start = last = { x: e.clientX, y: e.clientY, id: e.pointerId };
+        dragging = false;
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (!last || e.pointerId !== last.id) return;
+        if (!dragging) {
+          if (Math.hypot(e.clientX - start.x, e.clientY - start.y) < DRAG_THRESHOLD) return;
+          // Capture only once a real drag starts so taps on location pins still click.
+          dragging = true;
+          viewport.setPointerCapture(e.pointerId);
+          viewport.classList.add('is-dragging');
+        }
+        viewport.scrollLeft -= e.clientX - last.x;
+        viewport.scrollTop -= e.clientY - last.y;
+        last = { x: e.clientX, y: e.clientY, id: e.pointerId };
+      });
+
+      const endPan = () => {
+        suppressClick = dragging;
+        start = last = null;
+        dragging = false;
+        viewport.classList.remove('is-dragging');
+      };
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+
+      // Don't follow a pin link when the gesture was a drag.
+      viewport.addEventListener('click', (e) => {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+          suppressClick = false;
+        }
+      }, true);
+      viewport.addEventListener('pointerdown', () => { suppressClick = false; }, true);
+      // Prevent native link/image dragging from hijacking the pan.
+      viewport.addEventListener('dragstart', (e) => e.preventDefault());
+    })();
+  </script>
