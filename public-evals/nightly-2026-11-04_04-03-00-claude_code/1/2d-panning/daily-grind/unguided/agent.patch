+        }
+        // Ignore stale velocity if the pointer paused before release
+        if (!wasDragging || performance.now() - lastT > 80 || e.type === 'pointercancel') return;
+        let vx = velX * 16, vy = velY * 16; // px per frame
+        (function step() {
+          vx *= 0.94;
+          vy *= 0.94;
+          if (Math.abs(vx) < 0.3 && Math.abs(vy) < 0.3) { momentumFrame = null; return; }
+          viewport.scrollLeft -= vx;
+          viewport.scrollTop -= vy;
