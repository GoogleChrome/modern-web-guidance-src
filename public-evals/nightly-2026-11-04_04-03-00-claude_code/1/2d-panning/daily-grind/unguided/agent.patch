+      // Keyboard panning, including diagonals when two arrows are held together
+      const held = new Set();
+      let keyFrame = null;
+      const KEY_DIRS = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+      function keyStep() {
+        let x = 0, y = 0;
+        held.forEach(function (k) { x += KEY_DIRS[k][0]; y += KEY_DIRS[k][1]; });
+        if (!held.size) { keyFrame = null; return; }
