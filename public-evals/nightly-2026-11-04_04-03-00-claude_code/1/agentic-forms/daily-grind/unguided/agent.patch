+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const totalEl = document.getElementById('order-total');
+      const statusEl = document.getElementById('order-status');
+      const pickupInput = document.getElementById('pickup-time');
+
+      const SHOT_PRICE = 0.80;
+      const OPEN = '06:00';
+      const CLOSE = '20:00';
+
+      // Default the pickup time to ~15 minutes from now, within opening hours.
+      const soon = new Date(Date.now() + 15 * 60 * 1000);
+      const hhmm = soon.toTimeString().slice(0, 5);
+      pickupInput.value = hhmm < OPEN ? OPEN : hhmm > CLOSE ? CLOSE : hhmm;
+
+      function formatMoney(n) {
+        return '$' + n.toFixed(2);
+      }
+
+      function labelOf(select) {
+        const opt = select.selectedOptions[0];
+        return opt ? opt.textContent.split(' — ')[0].replace(/\s*\(.*\)$/, '') : '';
+      }
+
+      function computeTotal() {
+        const drinkOpt = form.drink.selectedOptions[0];
+        const base = parseFloat(drinkOpt && drinkOpt.dataset.price) || 0;
+        if (!base) return 0;
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const size = parseFloat(sizeInput && sizeInput.dataset.upcharge) || 0;
+        const milk = parseFloat(form.milk.selectedOptions[0].dataset.upcharge) || 0;
+        const shots = Math.min(4, Math.max(0, parseInt(form.extra_shots.value, 10) || 0));
+        return base + size + milk + shots * SHOT_PRICE;
+      }
+
+      function updateTotal() {
+        totalEl.textContent = formatMoney(computeTotal());
+      }
+
+      function validate() {
+        const errors = [];
+        if (!form.drink.value) errors.push('Please choose a drink.');
+        if (!form.querySelector('input[name="size"]:checked')) errors.push('Please choose a size.');
+        const shots = Number(form.extra_shots.value);
+        if (!Number.isInteger(shots) || shots < 0 || shots > 4) errors.push('Extra shots must be a whole number from 0 to 4.');
+        if (!form.location.value) errors.push('Please choose a pickup location.');
+        const t = form.pickup_time.value;
+        if (!/^\d{2}:\d{2}$/.test(t) || t < OPEN || t > CLOSE) errors.push('Pickup time must be between 6:00 AM and 8:00 PM.');
+        if (!form.customer_name.value.trim()) errors.push('Please enter a name for the order.');
+        if (form.drink.value === 'cold-brew' && form.temperature.value === 'hot') {
+          errors.push('Cold Brew is only served iced.');
+        }
+        return errors;
+      }
+
+      function showStatus(html, isError) {
+        statusEl.innerHTML = html;
+        statusEl.classList.toggle('error', !!isError);
+        statusEl.hidden = false;
+      }
+
+      function escapeHtml(str) {
+        const d = document.createElement('div');
+        d.textContent = str;
+        return d.innerHTML;
+      }
+
+      // Cold brew is always iced — keep the UI consistent.
+      form.drink.addEventListener('change', function () {
+        if (form.drink.value === 'cold-brew') form.temperature.value = 'iced';
+      });
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      form.addEventListener('reset', function () {
+        setTimeout(updateTotal);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        const errors = validate();
+        let result;
+
+        if (errors.length) {
+          showStatus('<strong>We couldn’t place that order:</strong><br>' + errors.map(escapeHtml).join('<br>'), true);
+          result = { success: false, errors: errors };
+        } else {
+          const sizeInput = form.querySelector('input[name="size"]:checked');
+          const order = {
+            orderNumber: 'DG-' + Math.random().toString(36).slice(2, 7).toUpperCase(),
+            drink: labelOf(form.drink),
+            size: sizeInput.value,
+            temperature: form.temperature.value,
+            milk: form.milk.value,
+            extraShots: Number(form.extra_shots.value),
+            location: labelOf(form.location),
+            pickupTime: form.pickup_time.value,
+            customerName: form.customer_name.value.trim(),
+            notes: form.notes.value.trim(),
+            total: formatMoney(computeTotal()),
+            payment: 'Pay at pickup'
+          };
+
+          showStatus(
+            '<strong>Order ' + order.orderNumber + ' confirmed!</strong><br>' +
+            escapeHtml(order.customerName) + ', your ' + order.size + ' ' + order.temperature + ' ' +
+            escapeHtml(order.drink) + ' will be ready at the ' + escapeHtml(order.location) +
+            ' café at ' + order.pickupTime + '. Total due at pickup: ' + order.total + '.'
+          );
+          result = { success: true, order: order };
+        }
+
+        // When an AI agent invoked this form as a tool, return a structured result to it.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
 </html>
