+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const totalOutput = document.getElementById('order-total');
+      const status = document.getElementById('order-status');
+      const submitButton = form.querySelector('button[type="submit"]');
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      const PICKUP_LABELS = { asap: 'as soon as possible', '15min': 'in about 15 minutes', '30min': 'in about 30 minutes' };
+
+      const priceOf = (el) => Number(el?.dataset.price ?? 0);
+
+      const calculateTotal = () => {
+        const drink = form.elements.drink.selectedOptions[0];
+        if (!drink || !drink.value) return 0;
+        const size = form.querySelector('input[name="size"]:checked');
+        const milk = form.querySelector('input[name="milk"]:checked');
+        const shots = Math.min(Math.max(Number(form.elements.extra_shots.value) || 0, 0), 4);
+        const quantity = Math.min(Math.max(Number(form.elements.quantity.value) || 1, 1), 10);
+        return (priceOf(drink) + priceOf(size) + priceOf(milk) + shots * 1.0) * quantity;
+      };
+
+      const updateTotal = () => {
+        totalOutput.value = currency.format(calculateTotal());
+      };
+
+      // Keep aria-invalid in sync with the visual :user-invalid state.
+      const syncAria = (el) => {
+        if (!el.matches?.('input, select, textarea') || el.type === 'radio') return;
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      };
+      form.addEventListener('focusout', (e) => syncAria(e.target));
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+        updateTotal();
+      });
+      form.addEventListener('change', updateTotal);
+
+      const collectErrors = () =>
+        [...form.elements]
+          .filter((el) => el.willValidate && !el.checkValidity())
+          .map((el) => {
+            const label = el.labels?.[0]?.textContent.replace('*', '').trim() || el.name;
+            return `${label} (${el.validationMessage})`;
+          });
+
+      // Simulated order submission — replace with a real fetch() to the ordering API.
+      const submitOrder = async (data) => {
+        await new Promise((resolve) => setTimeout(resolve, 600));
+        return {
+          orderNumber: `DG-${Math.floor(1000 + Math.random() * 9000)}`,
+          total: calculateTotal(),
+          data,
+        };
+      };
+
+      const describeOrder = ({ orderNumber, total, data }) => {
+        const drinkLabel = form.elements.drink.selectedOptions[0].textContent.split('—')[0].trim();
+        const locationLabel = form.elements.location.selectedOptions[0].textContent.split('—')[0].trim();
+        const shots = Number(data.get('extra_shots')) || 0;
+        const milk = data.get('milk') === 'none' ? 'no milk' : `${data.get('milk')} milk`;
+        const extras = shots ? `, ${shots} extra shot${shots > 1 ? 's' : ''}` : '';
+        return `Order ${orderNumber} confirmed: ${data.get('quantity')} × ${data.get('size')} ${data.get('temperature')} ` +
+          `${drinkLabel} with ${milk}${extras} for ${data.get('customer_name')}. ` +
+          `Pick up at ${locationLabel} ${PICKUP_LABELS[data.get('pickup_time')]}. Total: ${currency.format(total)}.`;
+      };
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.classList.remove('is-error');
+
+        const errors = collectErrors();
+        if (errors.length > 0) {
+          const message = `Please fix the following: ${errors.join(', ')}`;
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(`Validation failed: ${errors.join(', ')}`));
+          }
+          status.classList.add('is-error');
+          status.textContent = message;
+          form.querySelector(':invalid')?.focus();
+          return;
+        }
+
+        submitButton.disabled = true;
+        status.textContent = 'Placing your order…';
+
+        const resultPromise = submitOrder(new FormData(form))
+          .then((result) => {
+            const summary = describeOrder(result);
+            status.textContent = summary;
+            form.reset();
+            updateTotal();
+            return summary;
+          })
+          .catch(() => {
+            const message = 'Sorry, we could not place your order. Please try again.';
+            status.classList.add('is-error');
+            status.textContent = message;
+            return message;
+          })
+          .finally(() => {
+            submitButton.disabled = false;
+          });
+
+        if (event.agentInvoked) {
+          event.respondWith(resultPromise);
+        }
+      });
+
+      form.addEventListener('reset', () => {
+        for (const el of form.elements) el.removeAttribute('aria-invalid');
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
