diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..e0f2ce0
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,107 @@
+/**
+ * Minimal helpers for exposing client-side functionality to AI agents via
+ * WebMCP (`navigator.modelContext`). All functions are no-ops in browsers that
+ * don't implement the API, so callers don't need to feature-detect.
+ */
+import { useEffect, useRef } from 'react';
+
+export interface ToolTextContent {
+  type: 'text';
+  text: string;
+}
+
+export interface ToolResult {
+  content: ToolTextContent[];
+  isError?: boolean;
+}
+
+export interface JSONSchema {
+  type: string;
+  properties?: Record<string, JSONSchema & { description?: string }>;
+  required?: string[];
+  [key: string]: unknown;
+}
+
+export interface ModelContextTool<Input = Record<string, unknown>> {
+  name: string;
+  description: string;
+  inputSchema: JSONSchema;
+  execute: (input: Input, client?: unknown) => Promise<ToolResult>;
+  annotations?: {
+    readOnlyHint?: boolean;
+    [key: string]: unknown;
+  };
+}
+
+interface ModelContext {
+  registerTool: (
+    tool: ModelContextTool<any>,
+    options?: { signal?: AbortSignal },
+  ) => { unregister?: () => void } | void;
+  unregisterTool?: (name: string) => void;
+}
+
+function getModelContext(): ModelContext | undefined {
+  if (typeof navigator === 'undefined') return undefined;
+  const mc = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  return mc && typeof mc.registerTool === 'function' ? mc : undefined;
+}
+
+export function textResult(text: string, isError = false): ToolResult {
+  return isError ? { content: [{ type: 'text', text }], isError } : { content: [{ type: 'text', text }] };
+}
+
+/**
+ * Registers a tool with the browser's model context. Returns a cleanup
+ * function that unregisters it. Supports both the `{ signal }` option and the
+ * older `unregister()` / `unregisterTool(name)` styles of the API.
+ */
+export function registerTool<Input>(tool: ModelContextTool<Input>): () => void {
+  const mc = getModelContext();
+  if (!mc) return () => {};
+
+  const controller = new AbortController();
+  let registration: { unregister?: () => void } | void;
+  try {
+    registration = mc.registerTool(tool, { signal: controller.signal });
+  } catch (err) {
+    console.warn(`[webmcp] Failed to register tool "${tool.name}":`, err);
+    return () => {};
+  }
+
+  return () => {
+    controller.abort();
+    try {
+      if (registration && typeof registration.unregister === 'function') {
+        registration.unregister();
+      } else if (typeof mc.unregisterTool === 'function') {
+        mc.unregisterTool(tool.name);
+      }
+    } catch {
+      // Already unregistered (e.g. via the abort signal).
+    }
+  };
+}
+
+/**
+ * React hook that registers a tool for the lifetime of the component. The
+ * latest `execute` is always used, so it may safely close over props/state.
+ */
+export function useModelContextTool<Input>(tool: ModelContextTool<Input>): void {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  const { name, description } = tool;
+  const schemaKey = JSON.stringify(tool.inputSchema);
+  const annotationsKey = JSON.stringify(tool.annotations ?? null);
+
+  useEffect(() => {
+    return registerTool<Input>({
+      name,
+      description,
+      inputSchema: JSON.parse(schemaKey),
+      ...(annotationsKey !== 'null' ? { annotations: JSON.parse(annotationsKey) } : {}),
+      execute: (input, client) => executeRef.current(input, client),
+    });
+  }, [name, description, schemaKey, annotationsKey]);
+}
