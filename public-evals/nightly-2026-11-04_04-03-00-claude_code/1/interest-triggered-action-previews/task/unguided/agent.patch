+  <script>
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const DEFAULT_TEXT = 'Select a drink to preview';
+
+      const show = (source) => {
+        preview.textContent = source?.dataset.drink || DEFAULT_TEXT;
+      };
+      const reset = () => {
+        preview.textContent = DEFAULT_TEXT;
+      };
+
+      // Interest Invokers: the browser handles hover/focus/long-press on every
+      // [interestfor] button and fires `interest` / `loseinterest` on the target,
+      // with `event.source` pointing at the button. One listener pair, no per-button handlers.
+      preview.addEventListener('interest', (e) => show(e.source));
+      preview.addEventListener('loseinterest', reset);
+
+      // Progressive enhancement for browsers without Interest Invokers:
+      // a single delegated listener on the section approximates the behavior.
+      const supported = 'interestForElement' in HTMLAnchorElement.prototype;
+      if (supported) return;
+
+      const section = preview.closest('section');
+      const invokerFrom = (el) => el?.closest?.('[interestfor="seasonal-preview"]');
+      const enter = (e) => {
+        const btn = invokerFrom(e.target);
+        if (!btn) return;
+        preview.classList.add('has-interest');
+        show(btn);
+      };
+      const leave = (e) => {
+        const btn = invokerFrom(e.target);
+        if (!btn || btn.contains(e.relatedTarget)) return;
+        preview.classList.remove('has-interest');
+        reset();
+      };
+      section.addEventListener('pointerover', enter);
+      section.addEventListener('pointerout', leave);
+      section.addEventListener('focusin', enter);
+      section.addEventListener('focusout', leave);
+    })();
+  </script>
+
 </body>
 
