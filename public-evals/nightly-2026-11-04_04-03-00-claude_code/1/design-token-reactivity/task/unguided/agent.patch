       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Layout density (style-query driven) */
+    :root {
+      /* Probe flag used to feature-check support for container style queries */
+      --style-queries-probe: on;
+    }
+
+    .density-controls {
+      text-align: center;
+      margin-top: 15px;
+    }
+
+    #toggle-spacious {
+      /* Hidden unless the browser supports container style queries */
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 2px solid var(--primary);
+      padding: 8px 18px;
+      border-radius: 5px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    #toggle-spacious:hover,
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    /* Only browsers that understand style() queries will apply this rule */
+    @container style(--style-queries-probe: on) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    #target-container {
+      --layout-density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s ease;
+    }
+
+    /* The card reacts to its ancestor's custom property — no JS touches it */
+    @container style(--layout-density: spacious) {
+      #target-item {
+        padding: 48px 36px;
+      }
+    }
   </style>
 </head>
 
