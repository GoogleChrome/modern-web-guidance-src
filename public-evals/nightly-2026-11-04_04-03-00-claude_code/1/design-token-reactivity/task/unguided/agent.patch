+  <script>
+    (function () {
+      var toggle = document.getElementById('toggle-spacious');
+      var container = document.getElementById('target-container');
+      if (!toggle || !container) return;
+
+      toggle.addEventListener('click', function () {
+        var spacious = getComputedStyle(container)
+          .getPropertyValue('--layout-density').trim() === 'spacious';
+        var next = spacious ? 'compact' : 'spacious';
+        container.style.setProperty('--layout-density', next);
+        toggle.setAttribute('aria-pressed', String(next === 'spacious'));
+      });
+    })();
+  </script>
