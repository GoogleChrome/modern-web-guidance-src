+  <script>
+    (() => {
+      const form = document.getElementById('payment-form');
+      const messages = {
+        'cc-number': {
+          valueMissing: 'Enter your card number.',
+          invalid: 'Enter a valid card number (12–19 digits).'
+        },
+        'cc-name': {
+          valueMissing: 'Enter the name as it appears on your card.',
+          invalid: 'Use letters, spaces, apostrophes, hyphens or periods only.'
+        },
+        'cc-exp': {
+          valueMissing: 'Enter the expiry date.',
+          invalid: 'Enter the expiry date as MM/YY.',
+          expired: 'This card has expired.'
+        },
+        'cc-csc': {
+          valueMissing: 'Enter the security code.',
+          invalid: 'Enter the 3 or 4 digit security code.'
+        }
+      };
+
+      // Extra checks beyond the native pattern constraints.
+      const customCheck = {
+        'cc-number': (v) => {
+          const digits = v.replace(/\s/g, '');
+          return digits.length >= 12 && digits.length <= 19 ? '' : 'invalid';
+        },
+        'cc-exp': (v) => {
+          const [mm, yy] = v.split('/').map(Number);
+          const now = new Date();
+          const endOfMonth = new Date(2000 + yy, mm, 1); // first day after expiry month
+          return endOfMonth > now ? '' : 'expired';
+        }
+      };
+
+      function validate(input) {
+        const msgs = messages[input.name];
+        const error = document.getElementById(`${input.id}-error`);
+        input.setCustomValidity('');
+        let key = '';
+        if (input.validity.valueMissing) key = 'valueMissing';
+        else if (!input.validity.valid) key = 'invalid';
+        else if (customCheck[input.name]) key = customCheck[input.name](input.value.trim());
+        if (key) input.setCustomValidity(msgs[key]);
+        input.setAttribute('aria-invalid', key ? 'true' : 'false');
+        error.textContent = key ? msgs[key] : '';
+        return !key;
+      }
+
+      for (const input of form.querySelectorAll('input')) {
+        // Validate once the user leaves a field.
+        input.addEventListener('blur', () => {
+          if (input.value) validate(input);
+        });
+        // Clear errors as soon as the user starts correcting.
+        input.addEventListener('input', () => {
+          input.setCustomValidity('');
+          input.removeAttribute('aria-invalid');
+          document.getElementById(`${input.id}-error`).textContent = '';
+        });
+      }
+
+      // Insert the slash in MM/YY automatically while typing forwards.
+      const exp = document.getElementById('cc-exp');
+      exp.addEventListener('input', (e) => {
+        if (e.inputType && e.inputType.startsWith('delete')) return;
+        const digits = exp.value.replace(/\D/g, '').slice(0, 4);
+        exp.value = digits.length > 2 ? `${digits.slice(0, 2)}/${digits.slice(2)}` : digits;
+      });
+
+      form.addEventListener('submit', (e) => {
+        const inputs = [...form.querySelectorAll('input')];
+        const results = inputs.map(validate);
+        const firstInvalid = inputs[results.indexOf(false)];
+        if (firstInvalid) {
+          e.preventDefault();
+          firstInvalid.focus();
+          return;
+        }
+        // Prevent double submission once the form is valid.
+        form.querySelector('button[type="submit"]').disabled = true;
+      });
+    })();
+  </script>
+
 </body>
 
