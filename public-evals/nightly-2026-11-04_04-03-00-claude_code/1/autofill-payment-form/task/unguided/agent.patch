+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('cc-number');
+      const name = document.getElementById('cc-name');
+      const exp = document.getElementById('cc-exp');
+      const csc = document.getElementById('cc-csc');
+      const status = document.getElementById('form-status');
+
+      const digits = (v) => v.replace(/\D/g, '');
+
+      // Format card number in groups of 4
+      number.addEventListener('input', () => {
+        number.value = digits(number.value).slice(0, 19).replace(/(.{4})(?=.)/g, '$1 ');
+      });
+
+      // Format expiry as MM/YY
+      exp.addEventListener('input', (e) => {
+        let d = digits(exp.value).slice(0, 4);
+        if (d.length === 1 && d > '1') d = '0' + d;
+        exp.value = d.length > 2 || (d.length === 2 && e.inputType !== 'deleteContentBackward')
+          ? d.slice(0, 2) + '/' + d.slice(2)
+          : d;
+      });
+
+      csc.addEventListener('input', () => {
+        csc.value = digits(csc.value).slice(0, 4);
+      });
+
+      function luhn(num) {
+        let sum = 0;
+        let dbl = false;
+        for (let i = num.length - 1; i >= 0; i--) {
+          let n = +num[i];
+          if (dbl) { n *= 2; if (n > 9) n -= 9; }
+          sum += n;
+          dbl = !dbl;
+        }
+        return sum % 10 === 0;
+      }
+
+      const validators = {
+        'cc-number': () => {
+          const d = digits(number.value);
+          if (!d) return 'Card number is required.';
+          if (d.length < 12 || d.length > 19 || !luhn(d)) return 'Please enter a valid card number.';
+          return '';
+        },
+        'cc-name': () => name.value.trim().length < 2 ? 'Please enter the name on the card.' : '',
+        'cc-exp': () => {
+          const m = exp.value.match(/^(\d{2})\/(\d{2})$/);
+          if (!m) return 'Use MM/YY format.';
+          const month = +m[1];
+          const year = 2000 + +m[2];
+          if (month < 1 || month > 12) return 'Invalid month.';
+          const now = new Date();
+          if (year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth() + 1)) {
+            return 'This card has expired.';
+          }
+          return '';
+        },
+        'cc-csc': () => {
+          const d = digits(csc.value);
+          const amex = /^3[47]/.test(digits(number.value));
+          const len = amex ? 4 : 3;
+          return d.length === len ? '' : `Security code must be ${len} digits.`;
+        }
+      };
+
+      function validate(input) {
+        const msg = validators[input.id]();
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+        document.getElementById(input.id + '-error').textContent = msg;
+        return !msg;
+      }
+
+      [number, name, exp, csc].forEach((input) => {
+        input.addEventListener('blur', () => validate(input));
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = '';
+        const fields = [number, name, exp, csc];
+        const results = fields.map(validate);
+        const firstInvalid = fields[results.indexOf(false)];
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+        // NOTE: Never send raw card data to your own server. Hand these values to a
+        // PCI-compliant payment provider's SDK (e.g. Stripe Elements, Braintree) to
+        // tokenize them, and submit only the resulting token.
+        status.textContent = 'Payment details look good! Processing your order\u2026';
+        form.reset();
+      });
+    })();
+  </script>
+
 </body>
 
