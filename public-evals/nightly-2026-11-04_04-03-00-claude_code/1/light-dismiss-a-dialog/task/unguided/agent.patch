+  <script>
+    (function () {
+      var trigger = document.querySelector('.test-dialog-trigger');
+      var dialog = document.getElementById('logout-dialog');
+      if (!trigger || !dialog || typeof dialog.showModal !== 'function') return;
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      // Close when clicking the backdrop (anywhere outside the dialog box).
+      // The dialog itself has no padding and its content wrapper fills it, so
+      // a click whose target is the <dialog> element can only be a backdrop
+      // click. Fallback for browsers without closedby="any" support.
+      dialog.addEventListener('click', function (event) {
+        if (event.target === dialog) dialog.close();
+      });
+    })();
+  </script>
