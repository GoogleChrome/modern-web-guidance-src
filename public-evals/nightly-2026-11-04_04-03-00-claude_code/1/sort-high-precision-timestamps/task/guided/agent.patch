+  <script type="module">
+    // Batch of order events as collected from distributed backend services.
+    // Deliberately out of order, with several events landing in the same
+    // millisecond (and one exact duplicate timestamp) so that truncating to
+    // milliseconds via Date would produce ties and an unstable order.
+    const fetchOrderEventBatch = async () => [
+      { service: 'barista-queue', orderId: 'A-1042', event: 'drink.started', ts: '2026-11-04T14:03:12.418903117Z' },
+      { service: 'pos-register', orderId: 'A-1042', event: 'order.placed', ts: '2026-11-04T14:03:07.250000412Z' },
+      { service: 'payments', orderId: 'A-1042', event: 'payment.authorized', ts: '2026-11-04T14:03:07.250731009Z' },
+      { service: 'pickup-shelf', orderId: 'A-1042', event: 'order.ready', ts: '2026-11-04T14:05:48.002117560Z' },
+      { service: 'payments', orderId: 'A-1042', event: 'payment.captured', ts: '2026-11-04T14:03:07.250731954Z' },
+      { service: 'loyalty', orderId: 'A-1042', event: 'points.accrued', ts: '2026-11-04T14:03:07.250731954Z' },
+      { service: 'barista-queue', orderId: 'A-1042', event: 'ticket.queued', ts: '2026-11-04T14:03:07.251004800Z' },
+      { service: 'notifications', orderId: 'A-1042', event: 'sms.sent', ts: '2026-11-04T14:05:48.002118001Z' },
+      { service: 'barista-queue', orderId: 'A-1042', event: 'drink.finished', ts: '2026-11-04T14:05:47.996540230Z' },
+      { service: 'pickup-shelf', orderId: 'A-1042', event: 'order.collected', ts: '2026-11-04T14:09:31.700000000Z' },
+    ];
+
+    // Temporal is not yet available in every browser (e.g. Safari);
+    // load the polyfill only when needed.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+      }
+      return globalThis.Temporal;
+    }
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('timeline-status');
+    const output = document.getElementById('timeline-output');
+    const tbody = document.getElementById('timeline-body');
+
+    function cell(text, className) {
+      const td = document.createElement('td');
+      td.textContent = text;
+      if (className) td.className = className;
+      return td;
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Loading order events…';
+      try {
+        const [Temporal, rawEvents] = await Promise.all([ensureTemporal(), fetchOrderEventBatch()]);
+
+        // Parse with Temporal.Instant (never `new Date(ts)`, which drops
+        // everything below the millisecond), then sort on the full
+        // nanosecond value. Array sort is stable, so exact ties keep
+        // their arrival order.
+        const sorted = rawEvents
+          .map((evt) => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }))
+          .sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+        const rows = sorted.map((evt, i) => {
+          const tr = document.createElement('tr');
+          let gapText = '—';
+          if (i > 0) {
+            const prev = sorted[i - 1].instant;
+            if (evt.instant.equals(prev)) {
+              gapText = 'same instant';
+              tr.className = 'tie';
+            } else {
+              // Duration keeps nanosecond precision; format it for people
+              // instead of collapsing it to a lossy Number.
+              const gap = evt.instant.since(prev, { largestUnit: 'hours' });
+              gapText = gap.toLocaleString(undefined, { style: 'narrow' });
+            }
+          }
+          tr.append(
+            cell(String(i + 1)),
+            cell(evt.instant.toString({ fractionalSecondDigits: 9 }), 'ts'),
+            cell(evt.service),
+            cell(evt.orderId),
+            cell(evt.event),
+            cell(gapText, 'gap'),
+          );
+          return tr;
+        });
+        tbody.replaceChildren(...rows);
+        output.hidden = false;
+
+        const total = sorted.at(-1).instant.since(sorted[0].instant, { largestUnit: 'hours' });
+        status.textContent =
+          `Sequenced ${sorted.length} events from ${new Set(sorted.map((e) => e.service)).size} services ` +
+          `spanning ${total.toLocaleString(undefined, { style: 'narrow' })}.`;
+      } catch (err) {
+        console.error(err);
+        status.textContent = 'Sorry, we could not load the order events. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
