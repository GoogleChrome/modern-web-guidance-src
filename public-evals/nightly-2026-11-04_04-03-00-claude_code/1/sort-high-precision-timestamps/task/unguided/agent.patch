+  <script type="module">
+    import {
+      loadOrderEvents, buildTimeline, formatDurationNs, groupDigits,
+    } from './js/order-timeline.js';
+
+    const button = document.getElementById('load-timeline');
+    const status = document.getElementById('timeline-status');
+    const statsEl = document.getElementById('timeline-stats');
+    const tableWrap = document.getElementById('timeline-table-wrap');
+    const tbody = document.getElementById('timeline-body');
+
+    const cell = (text, className) => {
+      const td = document.createElement('td');
+      td.textContent = text;
+      if (className) td.className = className;
+      return td;
+    };
+
+    const stat = (label, value, title) => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      const l = document.createElement('div');
+      l.className = 'label';
+      l.textContent = label;
+      const v = document.createElement('div');
+      v.className = 'value';
+      v.textContent = value;
+      if (title) v.title = title;
+      card.append(l, v);
+      return card;
+    };
+
+    const dur = (ns) => (ns === null ? '—' : formatDurationNs(ns));
+    const nsTitle = (ns) => (ns === null ? '' : `${groupDigits(ns)} ns`);
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.className = 'timeline-status';
+      status.textContent = 'Loading order events…';
+      try {
+        const { batchId, events } = await loadOrderEvents();
+        const { timeline, rejected, stats } = buildTimeline(events);
+
+        tbody.replaceChildren(...timeline.map((e, i) => {
+          const tr = document.createElement('tr');
+          if (e.deltaNs === 0n) tr.className = 'tie';
+          else if (e.deltaNs !== null && e.deltaNs < 1_000_000n) tr.className = 'subms';
+          tr.append(
+            cell(String(i + 1)),
+            cell(e.utc, 'mono'),
+            cell(dur(e.deltaNs), 'mono num delta'),
+            cell(e.deltaNs === null ? '—' : groupDigits(e.deltaNs), 'mono num delta'),
+            cell(formatDurationNs(e.sinceStartNs), 'mono num'),
+            cell(e.service ?? ''),
+            cell(e.orderId ?? ''),
+            cell(e.type ?? ''),
+            cell(`#${e.index + 1}`, 'num'),
+          );
+          tr.title = `Raw: ${e.timestamp} · epoch ${groupDigits(e.ns)} ns`;
+          return tr;
+        }));
+
+        statsEl.replaceChildren();
+        if (stats) {
+          statsEl.append(
+            stat('Events', String(stats.count)),
+            stat('Total span', dur(stats.spanNs), nsTitle(stats.spanNs)),
+            stat('Shortest gap', dur(stats.minNs), nsTitle(stats.minNs)),
+            stat('Longest gap', dur(stats.maxNs), nsTitle(stats.maxNs)),
+            stat('Mean gap', dur(stats.meanNs), nsTitle(stats.meanNs)),
+            stat('Sub-ms gaps', String(stats.subMs)),
+            stat('Exact ties', String(stats.ties)),
+            stat('Arrived late', String(stats.outOfOrder)),
+          );
+        }
+        statsEl.hidden = !stats;
+        tableWrap.hidden = timeline.length === 0;
+
+        let msg = `Sorted ${timeline.length} event${timeline.length === 1 ? '' : 's'}`
+          + (batchId ? ` from batch ${batchId}` : '') + '.';
+        if (rejected.length) {
+          msg += ` Skipped ${rejected.length} with invalid timestamps: `
+            + rejected.map((r) => `#${r.index + 1} (${r.reason})`).join('; ');
+          status.classList.add('error');
+        }
+        status.textContent = msg;
+        button.textContent = 'Reload Order Events';
+      } catch (err) {
+        status.className = 'timeline-status error';
+        status.textContent = `Could not load order events: ${err.message}`;
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
