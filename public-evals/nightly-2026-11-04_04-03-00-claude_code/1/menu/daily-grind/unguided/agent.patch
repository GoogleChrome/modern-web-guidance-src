+  <script>
+    (() => {
+      'use strict';
+
+      let uidCounter = 0;
+      const uid = (prefix) => `${prefix}-${++uidCounter}`;
+      const ITEM = '[role^="menuitem"]';
+
+      /**
+       * Accessible menu button with arbitrarily nested submenus.
+       * Follows the WAI-ARIA Authoring Practices "Menu Button" pattern:
+       * roving focus, arrow-key navigation, Esc/←/→ for submenus, typeahead,
+       * plus mouse hover/click and click-outside dismissal.
+       *
+       * Emits bubbling events on the wrapper:
+       *   menuchange — a menuitemradio / menuitemcheckbox changed
+       *   menuaction — a plain (non-link) menuitem was activated
+       */
+      class MenuButton {
+        constructor(button) {
+          this.button = button;
+          this.root = document.getElementById(button.getAttribute('aria-controls'));
+          this.wrap = button.closest('.menu-wrap') || button.parentElement;
+          this.search = '';
+          this.searchTimer = null;
+          this.hoverTimer = null;
+          this.setup();
+          this.bind();
+        }
+
+        setup() {
+          if (!this.button.id) this.button.id = uid('menubutton');
+          this.root.setAttribute('aria-labelledby', this.button.id);
+          this.root.hidden = true;
+          this.button.setAttribute('aria-expanded', 'false');
+
+          this.root.querySelectorAll(ITEM).forEach((item) => { item.tabIndex = -1; });
+          this.root.querySelectorAll('[role="menu"]').forEach((menu) => {
+            const trigger = this.triggerOf(menu);
+            if (!menu.id) menu.id = uid('submenu');
+            if (!trigger.id) trigger.id = uid('menuitem');
+            trigger.setAttribute('aria-controls', menu.id);
+            trigger.setAttribute('aria-expanded', 'false');
+            if (!menu.hasAttribute('aria-label')) menu.setAttribute('aria-labelledby', trigger.id);
+            menu.hidden = true;
+          });
+        }
+
+        bind() {
+          this.button.addEventListener('click', () => {
+            if (this.isOpen) this.closeAll(true);
+            else this.open(this.root, 'first');
+          });
+          this.button.addEventListener('keydown', (e) => this.onButtonKeydown(e));
+          this.root.addEventListener('keydown', (e) => this.onMenuKeydown(e));
+          // Some browsers activate buttons on Space keyup; suppress it since keydown handles it.
+          this.wrap.addEventListener('keyup', (e) => { if (e.key === ' ') e.preventDefault(); });
+          this.root.addEventListener('click', (e) => this.onMenuClick(e));
+          this.root.addEventListener('pointerover', (e) => this.onPointerOver(e));
+          this.wrap.addEventListener('focusout', (e) => {
+            if (this.isOpen && e.relatedTarget && !this.wrap.contains(e.relatedTarget)) this.closeAll();
+          });
+          document.addEventListener('pointerdown', (e) => {
+            if (this.isOpen && !this.wrap.contains(e.target)) this.closeAll();
+          });
+          window.addEventListener('resize', () => { if (this.isOpen) this.closeAll(); });
+        }
+
+        get isOpen() { return !this.root.hidden; }
+        triggerOf(menu) { return menu === this.root ? this.button : menu.previousElementSibling; }
+        menuOf(item) { return item.closest('[role="menu"]'); }
+        submenuOf(item) {
+          return item.getAttribute('aria-haspopup') === 'menu' ? item.nextElementSibling : null;
+        }
+        itemsOf(menu) {
+          return [...menu.children]
+            .map((li) => li.firstElementChild)
+            .filter((el) => el && el.matches(ITEM));
+        }
+        labelOf(item) {
+          return (item.querySelector('.item-label') || item).textContent.trim().toLowerCase();
+        }
+
+        open(menu, focus) {
+          if (menu.hidden) {
+            menu.hidden = false;
+            this.triggerOf(menu).setAttribute('aria-expanded', 'true');
+            this.position(menu);
+          }
+          const items = this.itemsOf(menu);
+          if (focus === 'first') this.focusItem(items[0]);
+          else if (focus === 'last') this.focusItem(items[items.length - 1]);
+        }
+
+        close(menu) {
+          if (menu.hidden) return;
+          menu.querySelectorAll('[role="menu"]').forEach((sub) => this.close(sub));
+          menu.hidden = true;
+          menu.classList.remove('flip-x', 'flip-y');
+          this.triggerOf(menu).setAttribute('aria-expanded', 'false');
+        }
+
+        closeAll(returnFocus = false) {
+          clearTimeout(this.hoverTimer);
+          this.close(this.root);
+          if (returnFocus) this.button.focus();
+        }
+
+        position(menu) {
+          menu.classList.remove('flip-x', 'flip-y');
+          if (getComputedStyle(menu).position !== 'absolute') return; // stacked on small screens
+          const rect = menu.getBoundingClientRect();
+          if (rect.right > window.innerWidth - 8) menu.classList.add('flip-x');
+          if (menu !== this.root && rect.bottom > window.innerHeight - 8) menu.classList.add('flip-y');
+        }
+
+        focusItem(item, fromPointer = false) {
+          if (!item) return;
+          // Moving to an item collapses any sibling submenus it doesn't own.
+          this.itemsOf(this.menuOf(item)).forEach((other) => {
+            const sub = this.submenuOf(other);
+            if (other !== item && sub) this.close(sub);
+          });
+          item.focus({ preventScroll: fromPointer });
+        }
+
+        activate(item, viaKeyboard) {
+          const sub = this.submenuOf(item);
+          if (sub) {
+            if (sub.hidden) this.open(sub, viaKeyboard ? 'first' : null);
+            else if (!viaKeyboard) this.close(sub);
+            else this.open(sub, 'first');
+            return;
+          }
+          if (item.getAttribute('aria-disabled') === 'true') return;
+
+          const role = item.getAttribute('role');
+          if (role === 'menuitemcheckbox') {
+            item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+            this.emit('menuchange', item);
+          } else if (role === 'menuitemradio') {
+            const group = item.dataset.group;
+            this.itemsOf(this.menuOf(item))
