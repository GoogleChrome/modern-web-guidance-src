+        }
+
+        onMenuKeydown(e) {
+          const item = e.target.closest(ITEM);
+          if (!item || !this.root.contains(item)) return;
+          const menu = this.menuOf(item);
+          const items = this.itemsOf(menu);
+          const idx = items.indexOf(item);
+          const sub = this.submenuOf(item);
+          let handled = true;
+
+          switch (e.key) {
+            case 'ArrowDown':
+              this.focusItem(items[(idx + 1) % items.length]);
+              break;
+            case 'ArrowUp':
+              this.focusItem(items[(idx - 1 + items.length) % items.length]);
+              break;
+            case 'Home':
+            case 'PageUp':
+              this.focusItem(items[0]);
+              break;
+            case 'End':
+            case 'PageDown':
+              this.focusItem(items[items.length - 1]);
+              break;
+            case 'ArrowRight':
+              if (sub) this.open(sub, 'first');
+              break;
+            case 'ArrowLeft':
+              if (menu !== this.root) {
+                this.close(menu);
+                this.triggerOf(menu).focus();
+              }
+              break;
+            case 'Escape':
+              if (menu !== this.root) {
+                this.close(menu);
+                this.triggerOf(menu).focus();
+              } else {
+                this.closeAll(true);
+              }
+              break;
+            case 'Enter':
+            case ' ':
+              if (item.matches('a[href]')) {
+                if (e.key === ' ') item.click();
+                else handled = false; // native Enter follows the link; click handler closes the menu
+              } else {
+                this.activate(item, true);
+              }
+              break;
+            case 'Tab':
+              // Return focus to the button so Tab continues from there in document order.
+              this.closeAll(true);
+              handled = false;
+              break;
+            default:
+              if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                this.typeahead(e.key, items, idx);
+              } else {
+                handled = false;
+              }
+          }
+
+          if (handled) {
+            e.preventDefault();
+            e.stopPropagation();
+          }
+        }
+
+        onMenuClick(e) {
+          const item = e.target.closest(ITEM);
+          if (!item || !this.root.contains(item)) return;
+          if (item.matches('a[href]')) {
+            this.closeAll();
+            return; // let navigation happen
+          }
+          const sub = this.submenuOf(item);
+          if (sub && e.pointerType === 'mouse') {
+            // Mouse users already get hover-to-open; clicking should never collapse it underneath them.
+            clearTimeout(this.hoverTimer);
+            this.open(sub);
+            return;
+          }
+          this.activate(item, e.detail === 0);
+        }
+
+        onPointerOver(e) {
+          if (e.pointerType !== 'mouse') return;
+          const item = e.target.closest(ITEM);
+          if (!item || !this.root.contains(item)) return;
+          clearTimeout(this.hoverTimer);
+          if (document.activeElement !== item) this.focusItem(item, true);
+          const sub = this.submenuOf(item);
+          if (sub && sub.hidden) {
+            this.hoverTimer = setTimeout(() => this.open(sub), 150);
+          }
+        }
+
+        typeahead(char, items, idx) {
+          clearTimeout(this.searchTimer);
+          this.search += char.toLowerCase();
+          this.searchTimer = setTimeout(() => { this.search = ''; }, 500);
+          const start = this.search.length > 1 ? idx : idx + 1;
+          const ordered = [...items.slice(start), ...items.slice(0, start)];
+          const match = ordered.find((i) => this.labelOf(i).startsWith(this.search));
+          if (match) this.focusItem(match);
+        }
+      }
+
+      /* ---------- Toast ---------- */
+      const toastEl = document.getElementById('toast');
+      let toastTimer;
+      function toast(message) {
+        toastEl.textContent = message;
+        toastEl.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3200);
+      }
+
+      /* ---------- Order count ---------- */
+      const cartCountEl = document.getElementById('cart-count');
+      let cartCount = 0;
+      function addToCart() {
+        cartCount += 1;
+        cartCountEl.textContent = cartCount;
+        cartCountEl.setAttribute('aria-label', `${cartCount} item${cartCount === 1 ? '' : 's'} in order`);
+      }
+
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      /* ---------- Seasonal card customization ---------- */
+      const SUMMARY_ORDER = ['size', 'temp', 'milk', 'shots', 'syrup', 'topping'];
+
+      function initCard(card, template) {
+        const slot = card.querySelector('[data-customize-slot]');
+        slot.append(template.content.cloneNode(true));
+
+        const button = slot.querySelector('.menu-button');
+        const menu = slot.querySelector('[role="menu"]');
+        menu.id = uid('customize-menu');
+        button.setAttribute('aria-controls', menu.id);
+        button.setAttribute('aria-label', `Customize ${card.dataset.drink}`);
+        slot.querySelector('[data-details-link]').href = card.dataset.details;
+
+        const options = [...menu.querySelectorAll('[data-group]')];
+        const defaults = JSON.parse(card.dataset.defaults || '{}');
+        const basePrice = parseFloat(card.dataset.price);
+        const priceEl = card.querySelector('[data-price-display]');
+        const summaryEl = card.querySelector('[data-summary]');
+        const actionPriceEl = menu.querySelector('[data-action-price]');
+
+        (card.dataset.unavailable || '').split(/\s+/).filter(Boolean).forEach((key) => {
+          const [group, value] = key.split(':');
+          const opt = options.find((o) => o.dataset.group === group && o.dataset.value === value);
+          if (opt) {
+            opt.setAttribute('aria-disabled', 'true');
+            opt.insertAdjacentHTML('beforeend', '<span class="item-hint">Unavailable</span>');
+          }
+        });
+
+        const isDefault = (opt) => {
+          const v = defaults[opt.dataset.group];
+          return Array.isArray(v) ? v.includes(opt.dataset.value) : v === opt.dataset.value;
+        };
+        const priceOf = (opt) => parseFloat(opt.dataset.price || '0');
+        const selected = () => options.filter((o) => o.getAttribute('aria-checked') === 'true');
+        // The listed price already includes the default options.
+        const defaultExtras = options.filter(isDefault).reduce((sum, o) => sum + priceOf(o), 0);
+
+        const total = () => basePrice + selected().reduce((sum, o) => sum + priceOf(o), 0) - defaultExtras;
+
+        const summary = () => {
+          const picked = selected();
+          return SUMMARY_ORDER.flatMap((group) => picked
+            .filter((o) => o.dataset.group === group)
+            .map((o) => (o.dataset.summary ?? o.querySelector('.item-label').textContent).trim()))
+            .filter(Boolean)
+            .join(' · ');
+        };
+
+        const render = () => {
+          const price = money(total());
+          priceEl.textContent = price;
+          actionPriceEl.textContent = price;
+          summaryEl.textContent = summary();
+        };
+
+        const reset = () => {
+          options.forEach((o) => o.setAttribute('aria-checked', String(isDefault(o))));
+          render();
+        };
+
+        slot.addEventListener('menuchange', render);
+        slot.addEventListener('menuaction', (e) => {
+          if (e.detail.action === 'add') {
+            addToCart();
+            toast(`Added ${card.dataset.drink} (${summary()}) — ${money(total())}`);
+          } else if (e.detail.action === 'reset') {
+            reset();
+            toast(`${card.dataset.drink} reset to its standard recipe`);
+          }
+        });
+
+        reset();
+        new MenuButton(button);
+      }
+
+      /* ---------- Account preferences (persisted locally) ---------- */
+      const PREFS_KEY = 'dailyGrind.prefs';
+      function initAccountPrefs() {
+        const wrap = document.getElementById('account-wrap');
+        const options = [...wrap.querySelectorAll('[data-group]')];
+        let saved = {};
+        try { saved = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}'); } catch { /* ignore */ }
+        options.forEach((o) => {
+          const key = `${o.dataset.group}:${o.dataset.value}`;
+          if (key in saved) o.setAttribute('aria-checked', String(saved[key]));
+        });
+
+        wrap.addEventListener('menuchange', (e) => {
+          const prefs = {};
+          options.forEach((o) => { prefs[`${o.dataset.group}:${o.dataset.value}`] = o.getAttribute('aria-checked') === 'true'; });
+          try { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); } catch { /* ignore */ }
+          const label = e.detail.item.querySelector('.item-label').textContent;
+          toast(e.detail.item.getAttribute('role') === 'menuitemradio'
+            ? `Pickup method set to ${label}`
+            : `${label} ${e.detail.checked ? 'on' : 'off'}`);
+        });
+      }
+
+      /* ---------- Boot ---------- */
+      const template = document.getElementById('customize-menu-template');
+      document.querySelectorAll('.card[data-drink]').forEach((card) => initCard(card, template));
+      initAccountPrefs();
+      document.querySelectorAll('nav .menu-button[aria-controls]').forEach((btn) => new MenuButton(btn));
+    })();
+  </script>
+
