+  <script>
+    // Keep aria-invalid in sync with the browser's interaction-aware :user-invalid state,
+    // so assistive tech isn't told the field is invalid before the user has touched it.
+    (() => {
+      const form = document.getElementById('order-form');
+      const sync = (el) => {
+        if (!el.matches?.('select, input, textarea')) return;
+        if (el.matches(':user-invalid')) {
+          el.setAttribute('aria-invalid', 'true');
+        } else {
+          el.removeAttribute('aria-invalid');
+        }
+      };
+      form.addEventListener('blur', (e) => sync(e.target), true);
+      form.addEventListener('change', (e) => sync(e.target));
+      // Fires for each failing control when submission is attempted.
+      form.addEventListener('invalid', (e) => sync(e.target), true);
+    })();
+  </script>
