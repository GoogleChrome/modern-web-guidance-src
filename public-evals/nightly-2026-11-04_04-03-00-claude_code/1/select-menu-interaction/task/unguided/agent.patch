+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var select = document.getElementById('shop');
+      var field = document.getElementById('shop-field');
+      var error = document.getElementById('shop-error');
+
+      // JS handles validation display; native bubbles remain as a no-JS fallback.
+      form.noValidate = true;
+
+      var touched = false;
+
+      function update() {
+        if (!touched) return;
+        var invalid = !select.checkValidity();
+        field.classList.add('touched');
+        error.hidden = !invalid;
+        if (invalid) {
+          select.setAttribute('aria-invalid', 'true');
+          select.setAttribute('aria-describedby', 'shop-error');
+        } else {
+          select.removeAttribute('aria-invalid');
+          select.removeAttribute('aria-describedby');
+        }
+      }
+
+      function markTouched() {
+        touched = true;
+        update();
+      }
+
+      select.addEventListener('change', markTouched);
+      select.addEventListener('blur', markTouched);
+
+      form.addEventListener('submit', function (event) {
+        touched = true;
+        update();
+        if (!select.checkValidity()) {
+          event.preventDefault();
+          select.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
