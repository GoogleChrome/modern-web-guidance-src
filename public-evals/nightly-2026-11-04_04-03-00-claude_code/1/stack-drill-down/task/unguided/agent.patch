+      const CHEVRON_RIGHT = '<svg class="chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
+
+      const factsHTML = (facts) => `<dl class="facts">${Object.entries(facts)
+        .map(([k, v]) => `<div class="fact"><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>`;
+
+      function topBar(route, parent) {
+        return `
+          <div class="top-bar">
+            <a class="back-btn" href="${esc(hrefFor(parent.key))}" data-back aria-label="Back to ${esc(parent.label)}">
+              ${CHEVRON_LEFT}<span>${esc(parent.label)}</span>
+            </a>
+            <div class="top-bar-title" aria-hidden="true">${esc(route.label)}</div>
+            <div></div>
+          </div>`;
+      }
+
+      function renderItem(route, parent) {
+        const item = ITEMS[route.id];
+        return `
+          ${topBar(route, parent)}
+          <div class="detail-hero">
+            <img src="${img(item.image)}" alt="${esc(item.name)}" decoding="async">
+          </div>
+          <article class="detail-body">
+            <p class="eyebrow">Seasonal Favorite</p>
+            <div class="detail-head">
+              <h1 tabindex="-1" data-autofocus>${esc(item.name)}</h1>
+              <span class="price">${esc(item.price)}</span>
+            </div>
+            <p class="tagline">${esc(item.tagline)}</p>
+            <p>${esc(item.description)}</p>
+
+            <h2 class="section-title">Tasting notes</h2>
+            <ul class="chips">${item.notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>
+
+            <h2 class="section-title">Details</h2>
+            ${factsHTML(item.facts)}
+
+            <h2 class="section-title">Where it's from</h2>
+            <ul class="drill-list">
+              <li>
+                <a class="drill-row" href="#/${route.key}/origin" data-nav>
+                  <img src="${img(item.origin.image, 120, 120)}" alt="" loading="lazy">
+                  <span class="label">
+                    <strong>${esc(item.origin.name)}</strong>
+                    <small>${esc(item.origin.subtitle)}</small>
+                  </span>
+                  ${CHEVRON_RIGHT}
+                </a>
+              </li>
+            </ul>
+
+            <div class="actions">
+              <a class="btn" href="/order-online?item=${encodeURIComponent(route.id)}">Order ${esc(item.name)}</a>
+            </div>
+          </article>`;
+      }
+
+      function renderOrigin(route, parent) {
+        const item = ITEMS[route.id];
+        const o = item.origin;
+        return `
+          ${topBar(route, parent)}
+          <div class="detail-hero">
+            <img src="${img(o.image)}" alt="${esc(o.name)}" decoding="async">
+          </div>
+          <article class="detail-body">
+            <p class="eyebrow">Bean origin · ${esc(item.name)}</p>
+            <div class="detail-head">
+              <h1 tabindex="-1" data-autofocus>${esc(o.name)}</h1>
+            </div>
+            <p class="tagline">${esc(o.subtitle)}</p>
+
+            <h2 class="section-title">At a glance</h2>
+            ${factsHTML(o.facts)}
+
+            <h2 class="section-title">The story</h2>
+            <div class="story">${o.story.map((p) => `<p>${esc(p)}</p>`).join('')}</div>
+
+            <div class="actions">
+              <a class="btn" href="/order-online?item=${encodeURIComponent(route.id)}">Order ${esc(item.name)}</a>
+            </div>
+          </article>`;
+      }
+
+      function createView(route, parent) {
+        const el = document.createElement('div');
+        el.className = 'view';
+        el.dataset.key = route.key;
+        el.tabIndex = -1;
+        el.setAttribute('role', 'region');
+        el.setAttribute('aria-label', route.label);
+        el.innerHTML = route.type === 'origin' ? renderOrigin(route, parent) : renderItem(route, parent);
+        // Hide broken images gracefully (the hero background colour shows through).
+        el.querySelectorAll('img').forEach((i) => i.addEventListener('error', () => { i.style.visibility = 'hidden'; }, { once: true }));
+        return el;
+      }
+
+      /* ================================================================
+       * Stack state + transitions
+       * ================================================================ */
+      const stackEl = document.getElementById('stack');
+      const homeEl = document.getElementById('view-home');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /** @type {{key:string, route:object, el:HTMLElement, returnFocus:Element|null}[]} */
+      let stack = [{ key: '', route: resolve('')[0], el: homeEl, returnFocus: null }];
+
+      const DURATION = 420;
+      const EASING = 'cubic-bezier(0.32, 0.72, 0, 1)';
+      const POSE = {
+        active: { transform: 'translateX(0px)', filter: 'brightness(1)' },
+        covered: { transform: 'translateX(-30%)', filter: 'brightness(0.82)' },
+        offscreen: { transform: 'translateX(100%)', filter: 'brightness(1)' }
+      };
+
+      const running = new Set();
+      const pendingCleanups = [];
+
+      function setPose(el, pose) {
+        el.style.transform = POSE[pose].transform;
+        el.style.filter = POSE[pose].filter;
+      }
+
+      /** Animate an element from its *current* rendered pose (e.g. mid-swipe) to a target pose. */
+      function animatePose(el, pose, duration) {
+        const cs = getComputedStyle(el);
+        const from = { transform: cs.transform === 'none' ? 'translateX(0px)' : cs.transform, filter: cs.filter === 'none' ? 'brightness(1)' : cs.filter };
+        setPose(el, pose);
+        if (!duration || !el.animate) return Promise.resolve();
+        const anim = el.animate([from, POSE[pose]], { duration, easing: EASING });
+        running.add(anim);
+        return anim.finished.catch(() => { }).finally(() => running.delete(anim));
+      }
+
+      /** Jump any in-flight transition to its end state so a new navigation starts clean. */
+      function settle() {
+        running.forEach((a) => a.finish());
+        running.clear();
+        while (pendingCleanups.length) pendingCleanups.shift()();
+      }
+
+      /** Make only the top view interactive; only the top two are painted. */
+      function syncAccessibility() {
+        const top = stack.length - 1;
+        stack.forEach((v, i) => {
+          v.el.inert = i !== top;
+          if (i === top) v.el.removeAttribute('aria-hidden'); else v.el.setAttribute('aria-hidden', 'true');
+          v.el.classList.toggle('is-buried', i < top - 1);
+        });
+        document.title = stack[top].route.title;
+      }
+
+      function focusView(view, preferred) {
+        const target = (preferred && preferred.isConnected && view.el.contains(preferred))
+          ? preferred
+          : view.el.querySelector('[data-autofocus]') || view.el;
+        try { target.focus({ preventScroll: true }); } catch (_) { target.focus(); }
+      }
+
+      /**
+       * Reconcile the rendered stack with a path. Works out whether that means
+       * popping, pushing, or both (e.g. browser Forward into a different branch).
+       */
+      function syncTo(path, { animate = true } = {}) {
+        settle();
+        const target = resolve(path) || resolve('');
+        const duration = animate && !reduceMotion.matches ? DURATION : 0;
+
+        let common = 0;
+        while (common < stack.length && common < target.length && stack[common].key === target[common].key) common++;
+        if (common === stack.length && common === target.length) return;
+
+        const outgoing = stack[stack.length - 1];
+        const removed = stack.splice(common);
+
+        if (target.length === common) {
+          // ---- Pop: top slides away to the right, parent slides back in ----
+          const revealed = stack[stack.length - 1];
+          removed.forEach((v) => { if (v !== outgoing) v.el.remove(); });
+          revealed.el.classList.remove('is-buried');
+          revealed.el.inert = false;
+          outgoing.el.inert = true;
+          syncAccessibility();
+          focusView(revealed, removed[0].returnFocus);
+
+          const done = () => outgoing.el.remove();
+          pendingCleanups.push(done);
+          Promise.all([
+            animatePose(outgoing.el, 'offscreen', duration),
+            animatePose(revealed.el, 'active', duration)
+          ]).then(() => {
+            const i = pendingCleanups.indexOf(done);
+            if (i >= 0) pendingCleanups.splice(i, 1)[0]();
+          });
+          return;
+        }
+
+        // ---- Push: new view slides in from the right over the current one ----
+        const opener = document.activeElement;
+        const added = target.slice(common).map((route, i, arr) => {
+          const parent = i === 0 ? target[common - 1] : arr[i - 1];
+          const el = createView(route, parent);
+          setPose(el, i === arr.length - 1 ? 'offscreen' : 'covered');
+          stackEl.appendChild(el);
+          return { key: route.key, route, el, returnFocus: null };
+        });
+        // Focus can only be restored to the opener if it's still on the stack.
+        if (!removed.length && opener && outgoing.el.contains(opener)) added[0].returnFocus = opener;
+
+        stack.push(...added);
+        const incoming = added[added.length - 1];
+        syncAccessibility();
+        // Keep the outgoing view painted during the transition even if it's now deeper than top-1.
+        outgoing.el.classList.remove('is-buried');
+        focusView(incoming);
+
+        const done = () => {
+          removed.forEach((v) => v.el.remove());
+          syncAccessibility();
+        };
+        pendingCleanups.push(done);
+        Promise.all([
+          animatePose(incoming.el, 'active', duration),
+          animatePose(outgoing.el, 'covered', duration)
+        ]).then(() => {
+          const i = pendingCleanups.indexOf(done);
+          if (i >= 0) pendingCleanups.splice(i, 1)[0]();
+        });
+      }
+
+      /* ================================================================
+       * History integration
+       * ================================================================ */
+      const currentPath = () => stack[stack.length - 1].key;
+
+      function navigate(path) {
+        if (!resolve(path) || path === currentPath()) return;
+        history.pushState({ dg: true, path, prev: currentPath() }, '', hrefFor(path));
+        syncTo(path);
+      }
+
+      /** Go "up" one level. Uses real history when the previous entry is the parent so Back/Forward stay in sync. */
+      function goBack() {
+        const parent = parentOf(currentPath());
+        if (parent === null) return;
+        const st = history.state;
+        if (st && st.dg && st.path === currentPath() && st.prev === parent) {
+          history.back(); // popstate drives the animation
+        } else {
+          history.replaceState({ dg: true, path: parent, prev: parentOf(parent) }, '', hrefFor(parent));
+          syncTo(parent);
+        }
+      }
+
+      window.addEventListener('popstate', () => {
+        const path = pathFromLocation();
+        if (!resolve(path)) {
+          history.replaceState({ dg: true, path: '', prev: null }, '', hrefFor(''));
+          syncTo('');
+          return;
+        }
+        // A manually-typed hash creates an entry without our state; tag it.
+        if (!history.state || !history.state.dg) {
+          history.replaceState({ dg: true, path, prev: null }, '', hrefFor(path));
+        }
+        syncTo(path);
+      });
+
+      // Initial load / deep link. Seed history with each ancestor so Back walks up the hierarchy.
+      (function boot() {
+        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+        let path = pathFromLocation();
+        const chain = resolve(path);
+        if (!chain) path = '';
+        const st = history.state;
+
+        if (st && st.dg && st.path === path) {
+          // Reload or bfcache-less return to an entry we already own: don't duplicate history.
+        } else {
+          const keys = (resolve(path) || []).map((r) => r.key);
+          history.replaceState({ dg: true, path: '', prev: null }, '', hrefFor(''));
+          for (let i = 1; i < keys.length; i++) {
+            history.pushState({ dg: true, path: keys[i], prev: keys[i - 1] }, '', hrefFor(keys[i]));
+          }
+        }
+        syncTo(path, { animate: false });
+        syncAccessibility();
+      })();
+
+      /* ================================================================
+       * Input: link clicks, keyboard
+       * ================================================================ */
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const a = e.target.closest('a[data-nav], a[data-back]');
+        if (!a || !stackEl.contains(a)) return;
+        e.preventDefault();
+        if (a.hasAttribute('data-back')) goBack();
+        else navigate(new URL(a.href).hash.replace(/^#\/?/, ''));
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && stack.length > 1 && !e.defaultPrevented) {
+          e.preventDefault();
+          goBack();
+        }
+      });
+
+      /* ================================================================
+       * Interactive swipe-back gesture (touch)
+       * ================================================================ */
+      let drag = null;
+
+      stackEl.addEventListener('touchstart', (e) => {
+        if (stack.length < 2 || e.touches.length !== 1) return;
+        settle();
+        const t = e.touches[0];
+        drag = {
+          x0: t.clientX, y0: t.clientY, dx: 0, locked: null,
+          top: stack[stack.length - 1].el, under: stack[stack.length - 2].el,
+          w: stackEl.clientWidth, lastX: t.clientX, lastT: e.timeStamp, v: 0
+        };
+      }, { passive: true });
+
+      stackEl.addEventListener('touchmove', (e) => {
+        if (!drag) return;
+        const t = e.touches[0];
+        const dx = t.clientX - drag.x0;
+        const dy = t.clientY - drag.y0;
+
+        if (!drag.locked) {
+          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
+          drag.locked = dx > 0 && Math.abs(dx) > Math.abs(dy) * 1.2 ? 'x' : 'y';
+          if (drag.locked === 'y') { drag = null; return; }
+          drag.under.classList.remove('is-buried');
+        }
+
+        if (e.cancelable) e.preventDefault();
+        const d = Math.max(0, dx);
+        const p = d / drag.w;
+        drag.dx = d;
+        drag.top.style.transform = `translateX(${d}px)`;
+        drag.under.style.transform = `translateX(${-0.3 * drag.w * (1 - p)}px)`;
+        drag.under.style.filter = `brightness(${0.82 + 0.18 * p})`;
+
+        const dt = e.timeStamp - drag.lastT;
+        if (dt > 0) drag.v = 0.8 * ((t.clientX - drag.lastX) / dt) + 0.2 * drag.v;
+        drag.lastX = t.clientX;
+        drag.lastT = e.timeStamp;
+      }, { passive: false });
+
+      function endDrag(cancelled) {
+        if (!drag) return;
+        const { locked, dx, w, v, top, under } = drag;
+        drag = null;
+        if (locked !== 'x') return;
+
+        const commit = !cancelled && (dx / w > 0.35 || (v > 0.45 && dx > 20));
+        if (commit) {
+          goBack(); // animates from the current finger position
+        } else {
+          const duration = reduceMotion.matches ? 0 : 280;
+          animatePose(top, 'active', duration);
+          animatePose(under, 'covered', duration);
+        }
+      }
+
+      stackEl.addEventListener('touchend', () => endDrag(false));
+      stackEl.addEventListener('touchcancel', () => endDrag(true));
+    })();
+  </script>
