+        price: '$4.50',
+        image: '1461023058943-07fcbe16d735',
+        imageAlt: 'A tall glass of iced cold brew with cream swirling through it',
+        facts: { Sizes: '16 / 24 oz', Caffeine: '200 mg (16 oz)', Origin: 'Huila, Colombia', 'Steep time': '18 hours' },
+        notes: ['Cocoa', 'Caramel', 'Toffee', 'Smooth finish'],
+      },
+    ];
+
+    const ITEMS_BY_PATH = new Map(MENU_ITEMS.map((item) => [item.path, item]));
+    const ROOT_PATH = '/';
+
+    // ---------- Stack state ----------
+
+    const stack = document.querySelector('.Stack');
+    let rootView = null;
+    const returnFocus = new WeakMap();
+    // depth -> {urlPath, view}. history only exposes the *current* entry's
+    // state, so we remember URLs for every depth to rebuild pruned views.
+    const entriesByDepth = new Map();
+    let currentDepth = 0;
+
+    // ---------- App-specific routing and view builders ----------
+
+    function resolveUrl(urlPath) {
+      // Tolerate a trailing slash on deep links (e.g. /menu/espresso/).
+      const normalized = urlPath.length > 1 ? urlPath.replace(/\/+$/, '') : urlPath;
+      return ITEMS_BY_PATH.get(normalized) ?? null;
+    }
+
+    function cloneTemplate(id) {
+      return document.getElementById(id).content.firstElementChild.cloneNode(true);
+    }
+
+    function createRootView() {
+      const view = cloneTemplate('root-view-template');
+      const grid = view.querySelector('[data-seasonal-grid]');
+      for (const item of MENU_ITEMS) {
+        const card = cloneTemplate('card-template');
+        const image = card.querySelector('img');
+        image.src = img(item.image, 600);
+        card.querySelector('h3').textContent = item.name;
+        card.querySelector('p').textContent = item.blurb;
+        const link = card.querySelector('a');
+        link.href = item.path;
+        link.setAttribute('aria-label', `View details for ${item.name}`);
+        grid.append(card);
+      }
+      return view;
+    }
+
+    function createDrillDownView(item) {
+      const view = cloneTemplate('detail-view-template');
+      view.dataset.title = `${item.name} | The Daily Grind`;
+      view.setAttribute('aria-label', item.name);
+
+      view.querySelector('.detail-bar-title').textContent = item.name;
+      const hero = view.querySelector('.detail-hero');
+      hero.src = img(item.image, 1350);
+      hero.alt = item.imageAlt;
+      view.querySelector('h1').textContent = item.name;
+      view.querySelector('.detail-price').textContent = item.price;
+      view.querySelector('.detail-description').textContent = item.description;
+
+      const facts = view.querySelector('.detail-facts');
+      for (const [label, value] of Object.entries(item.facts)) {
+        const row = document.createElement('div');
+        const dt = document.createElement('dt');
+        const dd = document.createElement('dd');
+        dt.textContent = label;
+        dd.textContent = value;
+        row.append(dt, dd);
+        facts.append(row);
+      }
+
+      const notes = view.querySelector('.detail-notes');
+      for (const note of item.notes) {
+        const li = document.createElement('li');
+        li.textContent = note;
+        notes.append(li);
+      }
+
+      // Further drill-down links into the other seasonal favorites.
+      const related = view.querySelector('.related');
+      for (const other of MENU_ITEMS) {
+        if (other === item) continue;
+        const li = document.createElement('li');
+        const a = document.createElement('a');
+        a.href = other.path;
+        const thumb = document.createElement('img');
+        thumb.src = img(other.image, 120);
+        thumb.alt = '';
+        thumb.loading = 'lazy';
+        const text = document.createElement('div');
+        const strong = document.createElement('strong');
+        strong.textContent = other.name;
+        const span = document.createElement('span');
+        span.textContent = other.blurb;
+        text.append(strong, span);
+        a.append(thumb, text);
+        li.append(a);
+        related.append(li);
+      }
+
+      return view;
+    }
+
+    function getCurrentUrlPath() {
+      return location.pathname;
+    }
+
+    // ---------- Drill down ----------
+
+    function drillDown(urlPath) {
+      const item = resolveUrl(urlPath);
+      if (!item) return;
+
+      const newDepth = currentDepth + 1;
+      history.pushState({ depth: newDepth }, '', urlPath);
+
+      // pushState truncates forward history; mirror that here.
+      for (const d of entriesByDepth.keys()) {
+        if (d >= newDepth) entriesByDepth.delete(d);
+      }
+      currentDepth = newDepth;
+
+      const newView = createDrillDownView(item);
+      stack.appendChild(newView);
+      entriesByDepth.set(newDepth, { urlPath, view: newView });
+
+      // 'auto' defers to CSS scroll-behavior (smooth unless reduced motion).
+      stack.scrollBy({ left: stack.clientWidth, behavior: 'auto' });
+    }
+
+    // ---------- Click and back handling ----------
+
+    stack.addEventListener('click', (e) => {
+      if (e.target.closest('.back')) {
+        goBack();
+        return;
+      }
+
+      const link = e.target.closest('a');
+      if (!link || !stack.contains(link)) return;
+      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+
+      const url = new URL(link.href);
+      if (url.origin !== location.origin) return;
+      const parentView = link.closest('.Stack-view');
+      if (!resolveUrl(url.pathname) || !parentView) return;
+
+      e.preventDefault();
+      returnFocus.set(parentView, link);
+      drillDown(url.pathname);
+    });
+
+    // From a deep link there is no in-app entry behind us; history.back()
+    // would leave the site. Synthesize a root entry instead.
+    function goBack() {
+      const atDeepLinkRoot = currentDepth === 0
+        && entriesByDepth.get(0)?.view !== rootView;
+      if (atDeepLinkRoot) {
+        synthesizeRootEntry();
+      } else {
+        history.back();
+      }
+    }
+
+    function synthesizeRootEntry() {
+      const newDepth = currentDepth + 1;
+      history.pushState({ depth: newDepth }, '', ROOT_PATH);
+
+      if (!rootView) {
+        rootView = createRootView();
+        stack.prepend(rootView);
+        stack.scrollLeft += stack.clientWidth;
+      }
+      entriesByDepth.set(newDepth, { urlPath: ROOT_PATH, view: rootView });
+
+      updateFromHistoryState(history.state);
+    }
+
+    // ---------- Sync from history ----------
+
+    window.addEventListener('popstate', (event) => {
+      updateFromHistoryState(event.state);
+    });
+
+    function updateFromHistoryState(state, behaviorOverride) {
+      const newDepth = state?.depth ?? 0;
+      const urlPath = getCurrentUrlPath();
+
+      const entry = entriesByDepth.get(newDepth) ?? { view: null };
+      if (entry.urlPath !== urlPath) {
+        entry.urlPath = urlPath;
+        entry.view = resolveUrl(urlPath) ? null : rootView;
+      }
+      entriesByDepth.set(newDepth, entry);
+
+      // Rebuild views pruned earlier (forward navigation after swipe-back).
+      for (let d = 0; d <= newDepth; d++) {
+        const e = entriesByDepth.get(d);
+        if (!e || e.view) continue;
+        const item = resolveUrl(e.urlPath);
+        if (!item) continue;
+        const rebuilt = createDrillDownView(item);
+        stack.appendChild(rebuilt);
+        e.view = rebuilt;
+      }
+
+      currentDepth = newDepth;
+
+      const targetView = entriesByDepth.get(newDepth)?.view;
+      if (!targetView) return;
+
+      const toIdx = [...stack.children].indexOf(targetView);
+      const fromIdx = Math.round(stack.scrollLeft / stack.clientWidth);
+      if (fromIdx === toIdx) return;
+
+      // Back one step animates; forward and multi-step jumps are instant.
+      const forward = toIdx > fromIdx;
+      const multiStep = Math.abs(toIdx - fromIdx) > 1;
+      const behavior = behaviorOverride ?? (forward || multiStep ? 'instant' : 'auto');
+      stack.scrollTo({ left: toIdx * stack.clientWidth, behavior });
+    }
+
+    // ---------- Active view changed (single source of truth) ----------
+
+    function onActiveViewChanged(currentView) {
+      if (!currentView) return;
+
+      let seenCurrent = false;
+      for (const view of [...stack.children]) {
+        if (seenCurrent) {
+          for (const e of entriesByDepth.values()) {
+            if (e.view === view) e.view = null;
+          }
+          view.remove();
+        } else {
+          view.toggleAttribute('inert', view !== currentView);
+          if (view === currentView) seenCurrent = true;
+        }
+      }
+
+      if (currentView.dataset.title) document.title = currentView.dataset.title;
+
+      // A swipe-back changes the view without touching history; reconcile.
+      let currentViewDepth;
+      for (const [d, e] of entriesByDepth) {
+        if (e.view === currentView) currentViewDepth = d;
+      }
+      if (currentViewDepth !== undefined && currentViewDepth !== currentDepth) {
+        history.go(currentViewDepth - currentDepth);
+      }
+
+      const stored = returnFocus.get(currentView);
+      if (stored) {
+        stored.focus({ preventScroll: true });
+        returnFocus.delete(currentView);
+      } else if (currentView !== rootView) {
+        currentView.querySelector('.back')?.focus({ preventScroll: true });
+      }
+    }
+
+    stack.addEventListener('scrollsnapchange', (event) => {
+      onActiveViewChanged(event.snapTargetInline);
+    });
+
+    // Fallback for browsers without scroll snap events (Firefox, Safari).
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const viewObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.intersectionRatio === 1) onActiveViewChanged(entry.target);
+        }
+      }, { root: stack, threshold: 1 });
+
+      new MutationObserver((mutations) => {
+        for (const m of mutations) {
+          for (const node of m.addedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.observe(node);
+          }
+          for (const node of m.removedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.unobserve(node);
+          }
+        }
+      }).observe(stack, { childList: true });
+
+      for (const view of stack.children) viewObserver.observe(view);
+    }
+
+    // Keep the active view aligned when the viewport is resized/rotated.
+    new ResizeObserver(() => {
+      const target = entriesByDepth.get(currentDepth)?.view;
+      const idx = target ? [...stack.children].indexOf(target) : -1;
+      if (idx >= 0) stack.scrollTo({ left: idx * stack.clientWidth, behavior: 'instant' });
+    }).observe(stack);
+
+    // ---------- Init (handles deep links) ----------
+
+    const initialUrlPath = getCurrentUrlPath();
+    const initialItem = resolveUrl(initialUrlPath);
+
+    let initialView;
+    if (initialItem) {
+      initialView = createDrillDownView(initialItem);
+    } else {
+      rootView = createRootView();
+      initialView = rootView;
+    }
+    stack.appendChild(initialView);
+    if (initialView.dataset.title) document.title = initialView.dataset.title;
+
+    entriesByDepth.set(0, { urlPath: initialUrlPath, view: initialView });
+    history.replaceState({ depth: 0 }, '');
+
+    updateFromHistoryState(history.state, 'instant');
+  </script>
 </body>
 
