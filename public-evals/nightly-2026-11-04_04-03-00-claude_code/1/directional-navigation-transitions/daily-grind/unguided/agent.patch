+    /* Seasonal Favorites carousel */
+    .carousel {
+      max-width: 480px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      overflow: hidden;
+      /* room for the card shadow inside the clipped area */
+      padding: 6px;
+    }
+
+    .carousel-track {
+      display: grid;
+    }
+
+    /* Stack every slide in the same grid cell so the viewport keeps the
+       height of the tallest slide and nothing jumps while stepping. */
+    .carousel-track > .card {
+      grid-area: 1 / 1;
+    }
+
+    .carousel-track > .card:not(.is-active):not(.is-leaving) {
+      visibility: hidden;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 16px;
+      margin-top: 16px;
+    }
+
+    .carousel-btn {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 8px 18px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: #3e2723;
+    }
+
+    .carousel-btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-status {
+      min-width: 4.5em;
+      text-align: center;
+      font-size: 0.9rem;
+    }
+
+    .slide-in-from-right { animation: slide-in-from-right 0.4s ease both; }
+    .slide-in-from-left { animation: slide-in-from-left 0.4s ease both; }
+    .slide-out-to-left { animation: slide-out-to-left 0.4s ease both; }
+    .slide-out-to-right { animation: slide-out-to-right 0.4s ease both; }
+
+    @keyframes slide-in-from-right {
+      from { transform: translateX(100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes slide-in-from-left {
+      from { transform: translateX(-100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes slide-out-to-left {
+      from { transform: translateX(0); opacity: 1; }
+      to { transform: translateX(-100%); opacity: 0; }
+    }
+
+    @keyframes slide-out-to-right {
+      from { transform: translateX(0); opacity: 1; }
+      to { transform: translateX(100%); opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .slide-in-from-right,
+      .slide-in-from-left,
+      .slide-out-to-left,
+      .slide-out-to-right {
+        animation: none;
+      }
+    }
