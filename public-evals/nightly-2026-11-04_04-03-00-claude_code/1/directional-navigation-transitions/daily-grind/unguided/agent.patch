+      <script>
+        // Progressive enhancement: without JS the cards stay in the grid.
+        (function () {
+          var track = document.querySelector('[data-carousel]');
+          if (!track) return;
+          var slides = Array.prototype.slice.call(track.children);
+          if (slides.length < 2) return;
+
+          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+          var ANIM_CLASSES = ['slide-in-from-right', 'slide-in-from-left', 'slide-out-to-left', 'slide-out-to-right'];
+          var current = 0;
+
+          // Build carousel structure around the existing cards.
+          var carousel = document.createElement('div');
+          carousel.className = 'carousel';
+          carousel.setAttribute('role', 'region');
+          carousel.setAttribute('aria-roledescription', 'carousel');
+          carousel.setAttribute('aria-labelledby', 'seasonal-heading');
+
+          var viewport = document.createElement('div');
+          viewport.className = 'carousel-viewport';
+
+          track.parentNode.insertBefore(carousel, track);
+          track.className = 'carousel-track';
+          track.setAttribute('aria-live', 'polite');
+          viewport.appendChild(track);
+          carousel.appendChild(viewport);
+
+          var controls = document.createElement('div');
+          controls.className = 'carousel-controls';
+          controls.innerHTML =
+            '<button type="button" class="carousel-btn" data-dir="prev" aria-label="Previous item">&larr; Previous</button>' +
+            '<span class="carousel-status" aria-hidden="true"></span>' +
+            '<button type="button" class="carousel-btn" data-dir="next" aria-label="Next item">Next &rarr;</button>';
+          carousel.appendChild(controls);
+          var status = controls.querySelector('.carousel-status');
+
+          slides.forEach(function (slide, i) {
+            slide.setAttribute('role', 'group');
+            slide.setAttribute('aria-roledescription', 'slide');
+            slide.setAttribute('aria-label', (i + 1) + ' of ' + slides.length);
+            slide.addEventListener('animationend', function (e) {
+              if (e.target !== slide) return;
+              clearAnimation(slide);
+            });
+          });
+
+          function clearAnimation(slide) {
+            ANIM_CLASSES.forEach(function (c) { slide.classList.remove(c); });
+            slide.classList.remove('is-leaving');
+          }
+
+          function render() {
+            slides.forEach(function (slide, i) {
+              var active = i === current;
+              slide.classList.toggle('is-active', active);
+              slide.inert = !active;
+              slide.setAttribute('aria-hidden', active ? 'false' : 'true');
+            });
+            status.textContent = (current + 1) + ' / ' + slides.length;
+          }
+
+          function go(dir) {
+            var prev = current;
+            current = (current + (dir === 'next' ? 1 : -1) + slides.length) % slides.length;
+
+            // Settle any in-flight animation before starting a new one.
+            slides.forEach(clearAnimation);
+            render();
+
+            if (reduceMotion.matches) return;
+
+            var incoming = slides[current];
+            var outgoing = slides[prev];
+            // Force a reflow so re-adding the same class restarts the animation.
+            void incoming.offsetWidth;
+            outgoing.classList.add('is-leaving', dir === 'next' ? 'slide-out-to-left' : 'slide-out-to-right');
+            incoming.classList.add(dir === 'next' ? 'slide-in-from-right' : 'slide-in-from-left');
+          }
+
+          controls.addEventListener('click', function (e) {
+            var btn = e.target.closest('[data-dir]');
+            if (btn) go(btn.getAttribute('data-dir'));
+          });
+
+          carousel.addEventListener('keydown', function (e) {
+            if (e.key === 'ArrowRight') { go('next'); e.preventDefault(); }
+            else if (e.key === 'ArrowLeft') { go('prev'); e.preventDefault(); }
+          });
+
+          render();
+        })();
+      </script>
