+    /* Seasonal Favorites carousel */
+    .carousel {
+      max-width: 560px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      overflow: hidden;
+      border-radius: 8px;
+      /* room for the card shadow inside the clipped area */
+      padding: 6px;
+    }
+
+    .carousel-slide[hidden] {
+      display: none;
+    }
+
+    .carousel-slide {
+      view-transition-name: seasonal-item;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 1rem;
+      margin-top: 12px;
+    }
+
+    .carousel-btn {
+      font: inherit;
+      background: white;
+      color: var(--primary);
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      padding: 8px 16px;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: var(--primary);
+      color: white;
+    }
+
+    .carousel-btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    /* Directional slide animations */
+    @keyframes slide-to-left {
+      to { transform: translateX(-100%); }
+    }
+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); }
+    }
+
+    ::view-transition-old(seasonal-item),
+    ::view-transition-new(seasonal-item) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    :active-view-transition-type(next)::view-transition-old(seasonal-item) {
+      animation-name: slide-to-left;
+    }
+
+    :active-view-transition-type(next)::view-transition-new(seasonal-item) {
+      animation-name: slide-from-right;
+    }
+
+    :active-view-transition-type(previous)::view-transition-old(seasonal-item) {
+      animation-name: slide-to-right;
+    }
+
+    :active-view-transition-type(previous)::view-transition-new(seasonal-item) {
+      animation-name: slide-from-left;
+    }
+
+    /* Document-level fallback: nest the slide inside the viewport's group and clip it */
+    .carousel-viewport.vt-document {
+      view-transition-name: seasonal-viewport;
+      view-transition-group: contain;
+    }
+
+    ::view-transition-group-children(seasonal-viewport) {
+      overflow: clip;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
