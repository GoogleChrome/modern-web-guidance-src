+  <script>
+    (() => {
+      const carousel = document.getElementById('seasonal-carousel');
+      const viewport = document.getElementById('seasonal-viewport');
+      const slides = [...viewport.querySelectorAll('.carousel-slide')];
+      const status = carousel.querySelector('.carousel-status');
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+      let index = 0;
+      let activeDocTransition = null;
+
+      function show(newIndex) {
+        slides[index].hidden = true;
+        index = (newIndex + slides.length) % slides.length;
+        slides[index].hidden = false;
+        status.textContent = `${index + 1} of ${slides.length}`;
+      }
+
+      function go(direction) {
+        const target = index + (direction === 'next' ? 1 : -1);
+        const update = () => show(target);
+
+        let transition;
+        if (supportsScoped) {
+          // Scoped to the carousel so the rest of the page stays interactive
+          transition = viewport.startViewTransition({ update, types: [direction] });
+        } else if (document.startViewTransition) {
+          viewport.classList.add('vt-document');
+          transition = document.startViewTransition({ update, types: [direction] });
+          const current = transition;
+          transition.finished.catch(() => {}).then(() => {
+            // Only clear the clip if no newer transition replaced this one
+            if (activeDocTransition === current) viewport.classList.remove('vt-document');
+          });
+          activeDocTransition = current;
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the in-flight transition; ignore the rejection
+        transition.ready.catch(() => {});
+      }
+
+      carousel.querySelectorAll('[data-dir]').forEach((btn) => {
+        btn.addEventListener('click', () => go(btn.dataset.dir));
+      });
+    })();
+  </script>
+
