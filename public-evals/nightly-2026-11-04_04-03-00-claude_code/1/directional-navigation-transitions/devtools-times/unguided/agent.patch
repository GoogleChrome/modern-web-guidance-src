+import { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  href: string;
+  date: string;
+  /** Machine-readable date (ISO 8601) */
+  dateTime: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev' | null;
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  const [direction, setDirection] = useState<Direction>(null);
+  // Incremented on every navigation so the slide re-mounts and the animation
+  // replays even when only two stories are cycling.
+  const [step, setStep] = useState(0);
+
+  if (stories.length === 0) return null;
+
+  const count = stories.length;
+  const story = stories[index];
+
+  const go = (dir: Exclude<Direction, null>) => {
+    setDirection(dir);
+    setIndex((i) => (dir === 'next' ? (i + 1) % count : (i - 1 + count) % count));
+    setStep((s) => s + 1);
+  };
+
+  const animationClass =
+    direction === 'next'
+      ? 'top-stories-slide-from-right'
+      : direction === 'prev'
+        ? 'top-stories-slide-from-left'
+        : '';
+
+  return (
+    <section
+      className="flex items-center gap-3"
+      aria-roledescription="carousel"
+      aria-label="Top stories"
+    >
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        disabled={count < 2}
+        className="shrink-0 inline-flex items-center gap-1 rounded-full border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:border-amber-400 hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 disabled:opacity-40 disabled:hover:border-gray-300 disabled:hover:text-gray-700"
+      >
+        <ChevronLeftIcon className="h-4 w-4" aria-hidden="true" />
+        <span>Previous</span>
+      </button>
+
+      <div className="relative min-w-0 flex-1 overflow-hidden" aria-live="polite">
+        <div
+          key={step}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${count}`}
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+              {story.title}
+            </h3>
+          </a>
+          <time className="text-xs text-gray-500" dateTime={story.dateTime}>
+            {story.date}
+          </time>
+        </div>
+      </div>
+
+      <span className="shrink-0 text-xs tabular-nums text-gray-500" aria-hidden="true">
+        {index + 1} / {count}
+      </span>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        disabled={count < 2}
+        className="shrink-0 inline-flex items-center gap-1 rounded-full border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:border-amber-400 hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 disabled:opacity-40 disabled:hover:border-gray-300 disabled:hover:text-gray-700"
+      >
+        <span>Next</span>
+        <ChevronRightIcon className="h-4 w-4" aria-hidden="true" />
+      </button>
+    </section>
+  );
+}
