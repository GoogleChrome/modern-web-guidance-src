+}
+/* Top stories slider */
+@keyframes top-stories-in-from-right {
+  from { transform: translateX(100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+@keyframes top-stories-in-from-left {
+  from { transform: translateX(-100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+.top-stories-slide-from-right {
+  animation: top-stories-in-from-right 350ms ease-out;
+}
+
+.top-stories-slide-from-left {
+  animation: top-stories-in-from-left 350ms ease-out;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .top-stories-slide-from-right,
+  .top-stories-slide-from-left {
+    animation: none;
+  }
+}
