+      /*
+       * Theme selection: the ONLY place that knows how a theme is chosen.
+       * Default follows the OS (prefers-color-scheme); a root attribute,
+       * class, or <meta name="color-scheme"> pins a scheme. Every themed
+       * rule below reads light-dark() tokens, which follow color-scheme,
+       * so no rule is ever duplicated per theme.
+       */
+      color-scheme: light dark;
+
+      &:is([data-theme="dark"], .dark, .theme-dark),
+      &:has(> head > meta[name="color-scheme"][content="dark"]) {
+        color-scheme: dark;
+      }
+
+      &:is([data-theme="light"], .light, .theme-light),
+      &:has(> head > meta[name="color-scheme"][content="light"]) {
+        color-scheme: light;
+      }
+
+      /* Themed tokens: [light value, dark value] */
+      --page-bg: light-dark(var(--light), #1b1412);
