+  <script>
+    (() => {
+      const panel = document.getElementById('coupon-panel');
+      const button = document.getElementById('reveal-coupon');
+
+      // One-way: once revealed, the coupon cannot be hidden again.
+      const markRevealed = () => {
+        button.setAttribute('aria-expanded', 'true');
+        button.disabled = true;
+        button.textContent = 'Coupon Revealed';
+      };
+
+      const reveal = () => {
+        panel.removeAttribute('hidden');
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      };
+
+      button.addEventListener('click', reveal, { once: true });
+
+      // Find in page matched the code: the browser removes hidden itself; sync the button.
+      panel.addEventListener('beforematch', markRevealed, { once: true });
+
+      // Fallback for browsers without hidden="until-found" (e.g. Safari):
+      // show the coupon so its text stays findable.
+      if (!('onbeforematch' in HTMLElement.prototype)) {
+        panel.removeAttribute('hidden');
+        markRevealed();
+      }
+    })();
+  </script>
+
