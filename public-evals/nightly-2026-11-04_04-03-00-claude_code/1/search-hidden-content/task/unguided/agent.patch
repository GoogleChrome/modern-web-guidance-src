+  <script>
+    // Tabs: keep one tab always open (clicking the active tab does nothing).
+    document.querySelectorAll('.wholesale-tab > summary').forEach((summary) => {
+      summary.addEventListener('click', (e) => {
+        if (summary.parentElement.open) e.preventDefault();
+      });
+    });
+
+    // Coupon: reveal once, never hide again.
+    (() => {
+      const panel = document.getElementById('coupon-panel');
+      const button = document.querySelector('.coupon-btn');
+
+      const markRevealed = () => {
+        button.disabled = true;
+        button.setAttribute('aria-expanded', 'true');
+        button.textContent = 'Coupon Revealed';
+      };
+
+      button.addEventListener('click', () => {
+        panel.hidden = false;
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      });
+
+      // Fired when find-in-page reveals the panel; the browser removes
+      // the hidden attribute itself, we just sync the button state.
+      panel.addEventListener('beforematch', markRevealed);
+    })();
+  </script>
+
