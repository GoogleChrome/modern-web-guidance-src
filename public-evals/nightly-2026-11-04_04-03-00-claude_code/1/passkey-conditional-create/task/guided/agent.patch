+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7"
+      }
+    }
+  </script>
+  <script type="module">
+    // Polyfills getClientCapabilities / parseCreationOptionsFromJSON / toJSON
+    // on browsers that have WebAuthn but not these newer helpers. Loaded
+    // dynamically so a CDN failure never breaks password sign-in.
+    const polyfillsReady = window.PublicKeyCredential
+      ? import('webauthn-polyfills').catch(() => {})
+      : Promise.resolve();
+
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+    const button = form.querySelector('[data-testid="signin-button"]');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      status.textContent = '';
+      status.classList.remove('error');
+      button.disabled = true;
+
+      try {
+        const data = new FormData(form);
+        const res = await fetch('/api/signin', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({
+            username: data.get('username'),
+            password: data.get('password'),
+          }),
+        });
+
+        if (!res.ok) {
+          status.textContent = 'Sign-in failed. Check your username and password.';
+          status.classList.add('error');
+          return;
+        }
+
+        status.textContent = 'Signed in. Welcome back!';
+        form.reset();
+
+        // Password sign-in succeeded: silently try to upgrade to a passkey.
+        // Fire-and-forget; never surfaces UI or errors to the user.
+        promotePasskey().catch(() => {});
+      } catch {
+        status.textContent = 'Network error. Please try again.';
+        status.classList.add('error');
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    async function signalUnknown(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch {
+        // Ignore: signaling is a best-effort optimization.
+      }
+    }
+
+    async function promotePasskey() {
+      if (!window.PublicKeyCredential) return;
+      await polyfillsReady;
+      if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return;
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) return;
+
+      const optionsRes = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsRes.ok) return;
+
+      const optionsJSON = await optionsRes.json();
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+      const rpId = optionsJSON.rp?.id ?? location.hostname;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+      } catch (e) {
+        // InvalidStateError (already has a passkey), NotAllowedError
+        // (provider declined), AbortError — all expected; stay silent.
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+          console.error('Unexpected conditional create error:', e);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const credentialJSON = credential.toJSON();
+      try {
+        const verifyRes = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(credentialJSON),
+        });
+        if (!verifyRes.ok) await signalUnknown(rpId, credentialJSON.id);
+      } catch {
+        await signalUnknown(rpId, credentialJSON.id);
+      }
+    }
+  </script>
+
