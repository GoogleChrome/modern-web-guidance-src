+  <script>
+    (() => {
+      const form = document.getElementById('signin-form');
+      const button = form.querySelector('[data-testid="signin-button"]');
+      const message = document.getElementById('signin-message');
+
+      // ---- base64url helpers (fallback when the JSON (de)serialization APIs are unavailable) ----
+      const b64urlToBuffer = (value) => {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      };
+
+      const bufferToB64url = (buffer) => {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const parseCreationOptions = (json) => {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+          excludeCredentials: (json.excludeCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+      };
+
+      const serializeCredential = (credential) => {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        const { response } = credential;
+        return {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(response.clientDataJSON),
+            attestationObject: bufferToB64url(response.attestationObject),
+            transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+          },
+        };
+      };
+
+      // ---- Feature detection for conditional (automatic) passkey creation ----
+      const supportsConditionalCreate = async () => {
+        if (!window.PublicKeyCredential || !navigator.credentials?.create) return false;
+        if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return false;
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          return capabilities?.conditionalCreate === true;
+        } catch {
+          return false;
+        }
+      };
+
+      // ---- Silent post-login passkey promotion ----
+      // Runs in the background after a successful password sign-in. Never shows UI;
+      // any failure (unsupported, declined, already registered, network) is swallowed.
+      const promotePasskey = async () => {
+        try {
+          if (!(await supportsConditionalCreate())) return;
+
+          const optionsRes = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({}),
+          });
+          if (!optionsRes.ok) return;
+          const optionsJSON = await optionsRes.json();
+          const publicKey = parseCreationOptions(optionsJSON.publicKey ?? optionsJSON);
+
+          const credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional',
+          });
+          if (!credential) return;
+
+          await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify(serializeCredential(credential)),
+          });
+        } catch (err) {
+          // Intentionally silent: conditional creation must not interrupt the user.
+          console.debug('Automatic passkey registration skipped:', err?.name || err);
+        }
+      };
+
+      // ---- Password sign-in ----
+      const setMessage = (text, isError = false) => {
+        message.textContent = text;
+        message.classList.toggle('error', isError);
+      };
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const username = form.username.value.trim();
+        const password = form.password.value;
+
+        if (!username || !password) {
+          setMessage('Please enter your username and password.', true);
+          return;
+        }
+
+        button.disabled = true;
+        setMessage('Signing in…');
+
+        let signedIn = false;
+        try {
+          const res = await fetch('/api/signin', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({ username, password }),
+          });
+          signedIn = res.ok;
+          if (!signedIn) {
+            setMessage('Invalid username or password.', true);
+          }
+        } catch {
+          setMessage('Unable to sign in right now. Please try again.', true);
+        } finally {
+          button.disabled = false;
+        }
+
+        if (!signedIn) return;
+
+        form.password.value = '';
+        setMessage(`Welcome back, ${username}!`);
+
+        // Fire-and-forget: silently upgrade the user to a passkey in the background.
+        promotePasskey();
+      });
+    })();
+  </script>
+
 </body>
 
