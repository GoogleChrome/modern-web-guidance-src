+/**
+ * Responsive `widths`/`sizes` props for Astro's <Image>.
+ * Remote images that Astro is not allowed to optimize would get the same URL repeated in
+ * every srcset candidate, so they are only given responsive props when they are local.
+ */
+export function responsiveProps(
+    image: ImageMetadata | string,
+    widths: number[],
+    sizes: string,
+): { widths?: number[]; sizes?: string } {
+    return typeof image === 'string' ? {} : { widths, sizes };
+}
