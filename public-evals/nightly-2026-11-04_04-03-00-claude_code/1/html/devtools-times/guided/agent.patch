diff --git a/src/utils/dialog.ts b/src/utils/dialog.ts
new file mode 100644
index 0000000..0cc95e2
--- /dev/null
+++ b/src/utils/dialog.ts
@@ -0,0 +1,38 @@
+import { useEffect, type RefObject } from 'react';
+
+/**
+ * Keeps a native <dialog> in sync with an `open` flag, opening it as a modal with showModal()
+ * (focus containment, inert page, Esc handling and focus return come from the browser).
+ *
+ * Also provides a light-dismiss fallback for browsers that lack `closedby="any"`.
+ */
+export function useModalDialog(ref: RefObject<HTMLDialogElement | null>, open: boolean) {
+    useEffect(() => {
+        const dialog = ref.current;
+        if (!dialog) return;
+        if (open && !dialog.open) dialog.showModal();
+        else if (!open && dialog.open) dialog.close();
+    }, [ref, open]);
+
+    useEffect(() => {
+        const dialog = ref.current;
+        if (!dialog || 'closedBy' in HTMLDialogElement.prototype) return;
+
+        // Test the pointer position, not event.target: the <dialog> is also the target for its
+        // own padding and the gaps between its children.
+        const isOutside = (e: PointerEvent) => {
+            const r = dialog.getBoundingClientRect();
+            return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        const onDown = (e: PointerEvent) => { pressedOutside = isOutside(e); };
+        // Require press and release outside so a text-selection drag ending on the backdrop doesn't dismiss.
+        const onUp = (e: PointerEvent) => { if (pressedOutside && isOutside(e)) dialog.close(); };
+        dialog.addEventListener('pointerdown', onDown);
+        dialog.addEventListener('pointerup', onUp);
+        return () => {
+            dialog.removeEventListener('pointerdown', onDown);
+            dialog.removeEventListener('pointerup', onUp);
+        };
+    }, [ref]);
+}
