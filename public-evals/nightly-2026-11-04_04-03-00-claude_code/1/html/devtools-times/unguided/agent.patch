diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..4afcd05
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,64 @@
+import React, { useEffect, useRef } from 'react';
+import { XMarkIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  /** Accessible name for the dialog. */
+  label: string;
+  children: React.ReactNode;
+}
+
+/**
+ * Thin wrapper around the native <dialog> element.
+ *
+ * `showModal()` gives us top-layer rendering, an inert background, a focus
+ * trap, Escape-to-close and focus restoration to the opener on close — no
+ * custom key handlers or portals required. Light dismiss is handled natively
+ * by `closedby="any"`, with a backdrop-click fallback for older engines.
+ *
+ * Mark the element that should receive initial focus with `data-autofocus`.
+ */
+export default function Modal({ open, onClose, label, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+
+    if (open && !dialog.open) {
+      dialog.showModal();
+      dialog.querySelector<HTMLElement>('[data-autofocus]')?.focus();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open]);
+
+  // Fallback light dismiss: clicks on the ::backdrop are dispatched to the dialog itself.
+  const handleClick = (event: React.MouseEvent<HTMLDialogElement>) => {
+    if (event.target === event.currentTarget) {
+      event.currentTarget.close();
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-label={label}
+      closedby="any"
+      onClose={onClose}
+      onClick={handleClick}
+      className="modal m-0 mx-auto mt-[15vh] w-[calc(100%-2rem)] max-w-2xl overflow-visible bg-white p-0 shadow-xl backdrop:bg-white/30 backdrop:backdrop-blur-sm"
+    >
+      <button
+        type="button"
+        onClick={() => dialogRef.current?.close()}
+        aria-label="Close"
+        className="absolute -top-2 -right-2 z-10 rounded-full bg-white p-1 text-gray-500 shadow-md transition-transform hover:scale-110 hover:text-amber-400"
+      >
+        <XMarkIcon className="h-6 w-6" strokeWidth={2} />
+      </button>
+      {children}
+    </dialog>
+  );
+}
