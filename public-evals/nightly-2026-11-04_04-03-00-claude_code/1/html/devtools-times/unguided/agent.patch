+}
+
+/* Prevent background scrolling while a modal <dialog> is open. */
+html:has(dialog:modal) {
+  overflow: hidden;
+}
+
+/* --- Section navigation flyout (native popover + CSS anchor positioning) --- */
+.nav-anchor {
+  anchor-name: --section-nav;
+}
+
+.nav-flyout {
+  /* Reset UA popover centering; we position against the nav instead. */
+  margin: 0;
+  padding: 0;
+  border-width: 0 0 1px;
+  inset: auto;
+  max-height: calc(100dvh - 2rem);
+  overflow-y: auto;
+
+  position-anchor: --section-nav;
+  top: anchor(bottom);
+  left: anchor(left);
+  width: anchor-size(width);
+}
+
+@supports not (anchor-name: --a) {
+  .nav-flyout {
+    top: 0;
+    left: 50%;
+    width: min(100%, 72rem);
+    translate: -50% 0;
+  }
+}
+
+/* --- Entry/exit transitions for top-layer overlays --- */
+.nav-flyout,
+dialog.modal,
+dialog.modal::backdrop {
+  transition:
+    opacity 150ms ease-out,
+    translate 150ms ease-out,
+    overlay 150ms allow-discrete,
+    display 150ms allow-discrete;
+  opacity: 0;
+}
+
+.nav-flyout:popover-open,
+dialog.modal[open],
+dialog.modal[open]::backdrop {
+  opacity: 1;
+}
+
+dialog.modal {
+  translate: 0 -0.5rem;
+}
+
+dialog.modal[open] {
+  translate: 0 0;
+}
+
+@starting-style {
+  .nav-flyout:popover-open,
+  dialog.modal[open],
+  dialog.modal[open]::backdrop {
+    opacity: 0;
+  }
+  dialog.modal[open] {
+    translate: 0 -0.5rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .nav-flyout,
+  dialog.modal,
+  dialog.modal::backdrop {
+    transition: none;
+  }
+}
