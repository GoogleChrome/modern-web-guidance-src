 import { getCollection } from 'astro:content';
+import { getImage } from 'astro:assets';
 import type { APIRoute } from 'astro';
+import { getArticleImage } from '../../utils/images';
+
+export interface ArticleSummary {
+    slug: string;
+    title: string;
+    summary: string;
+    image: string;
+    /** Small, optimized rendition for thumbnails (instead of the multi-megapixel original). */
+    thumbnail: { src: string; srcSet: string; width: number; height: number };
+}
+
+const THUMB_WIDTH = 240;
+const THUMB_HEIGHT = 160;
+
+async function getThumbnail(article: Parameters<typeof getArticleImage>[0]): Promise<ArticleSummary['thumbnail']> {
+    const source = await getArticleImage(article);
+    if (typeof source === 'string') {
+        // Remote images are not on the optimizer allow-list; serve them as-is.
+        return { src: source, srcSet: '', width: THUMB_WIDTH, height: THUMB_HEIGHT };
+    }
+    const image = await getImage({
+        src: source,
+        width: THUMB_WIDTH,
+        height: THUMB_HEIGHT,
+        densities: [1, 2],
+        format: 'webp',
+    });
+    return {
+        src: image.src,
+        srcSet: image.srcSet.attribute,
+        width: THUMB_WIDTH,
+        height: THUMB_HEIGHT,
+    };
+}
 
