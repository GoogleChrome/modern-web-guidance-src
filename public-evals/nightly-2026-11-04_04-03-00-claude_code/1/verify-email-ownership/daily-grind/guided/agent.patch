diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..1061e90
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,345 @@
+// The Daily Grind web server.
+//
+//   GET  /                     Homepage with Rewards sign-up form (fresh EVP nonce per render)
+//   POST /api/rewards/signup   Creates a Rewards account; verifies email ownership via the
+//                              Email Verification Protocol, falling back to an emailed code
+//   POST /api/rewards/confirm  Fallback: confirm the emailed one-time code
+//
+// Env:
+//   PORT                 (default 11222)
+//   PUBLIC_ORIGIN        Public origin used as the KB-JWT audience, e.g. https://dailygrind.example
+//   ORIGIN_TRIAL_TOKEN   Origin Trial token for the Email Verification API (sent as a header)
+
+import { createServer } from 'node:http';
+import { readFileSync } from 'node:fs';
+import { randomBytes, randomInt, scrypt, timingSafeEqual, createHash } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './lib/email-verification.mjs';
+
+const scryptAsync = promisify(scrypt);
+
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = (process.env.PUBLIC_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+
+const SESSION_COOKIE = '__Host-dg_sid';
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const CODE_TTL_MS = 10 * 60 * 1000;
+const MAX_CODE_ATTEMPTS = 5;
+const MAX_BODY_BYTES = 32 * 1024;
+
+const INDEX_TEMPLATE = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+
+// ---------------------------------------------------------------------------
+// In-memory stores (swap for Redis / a database in production).
+// ---------------------------------------------------------------------------
+
+/** sid -> { expires, evtNonce?: { value, expires }, pending?: PendingSignup } */
+const sessions = new Map();
+/** lowercased email -> account */
+const accounts = new Map();
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, s] of sessions) if (s.expires < now) sessions.delete(sid);
+}, 60_000).unref();
+
+function getSession(req, res) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  let session = sid && sessions.get(sid);
+  if (session && session.expires > Date.now()) {
+    session.expires = Date.now() + SESSION_TTL_MS;
+    return session;
+  }
+  const newSid = randomBytes(32).toString('base64url');
+  session = { expires: Date.now() + SESSION_TTL_MS };
+  sessions.set(newSid, session);
+  res.setHeader(
+    'Set-Cookie',
+    `${SESSION_COOKIE}=${newSid}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${SESSION_TTL_MS / 1000}`,
+  );
+  return session;
+}
+
+/** Issue a fresh single-use nonce for this form render (overwrites any previous one). */
+function issueNonce(session) {
+  const value = randomBytes(32).toString('base64url');
+  session.evtNonce = { value, expires: Date.now() + NONCE_TTL_MS };
+  return value;
+}
+
+/** Atomically read-and-delete the session's nonce. */
+function consumeNonce(session) {
+  const n = session.evtNonce;
+  delete session.evtNonce;
+  return n && n.expires > Date.now() ? n.value : null;
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = part.slice(i + 1).trim();
+  }
+  return out;
+}
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function readForm(req) {
+  return new Promise((resolve, reject) => {
+    const type = req.headers['content-type'] || '';
+    if (!type.startsWith('application/x-www-form-urlencoded')) {
+      reject(Object.assign(new Error('Unsupported content type'), { status: 415 }));
+      return;
+    }
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(new URLSearchParams(Buffer.concat(chunks).toString('utf8'))));
+    req.on('error', reject);
+  });
+}
+
+function isSameOrigin(req) {
+  // Browsers send Origin on cross-site and same-origin POSTs; reject mismatches (CSRF).
+  return req.headers.origin === RP_ORIGIN;
+}
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const key = await scryptAsync(password.normalize('NFKC'), salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${key.toString('base64url')}`;
+}
+
+const sha256 = (s) => createHash('sha256').update(s).digest();
+
+function baseHeaders(res) {
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('X-Frame-Options', 'DENY');
+}
+
+function sendHtml(res, status, html) {
+  baseHeaders(res);
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8' });
+  res.end(html);
+}
+
+function renderPage({ title, body }) {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #3e2723;
+           background: #fafafa; margin: 0; display: grid; place-items: center; min-height: 100vh; padding: 20px; box-sizing: border-box; }
+    main { background: white; max-width: 480px; width: 100%; padding: 32px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.1); }
+    h1 { color: #4e342e; margin-top: 0; }
+    label { display: block; font-weight: 600; margin: 16px 0 6px; }
+    input { width: 100%; box-sizing: border-box; padding: 12px; font-size: 1.25rem; letter-spacing: .3em;
+            border: 1px solid #bcaaa4; border-radius: 6px; }
+    input:user-invalid { border-color: #c62828; }
+    button, .btn { display: inline-block; margin-top: 20px; background: #4e342e; color: white; border: 0; font: inherit;
+             padding: 12px 22px; border-radius: 6px; text-decoration: none; cursor: pointer; }
+    .badge { display: inline-block; background: #e8f5e9; color: #1b5e20; padding: 4px 10px; border-radius: 999px; font-size: .85rem; font-weight: 600; }
+    .error { color: #c62828; }
+  </style>
+</head>
+<body><main>${body}</main></body>
+</html>`;
+}
+
+function codeEntryPage(email, message = '') {
+  return renderPage({
+    title: 'Check your email',
+    body: `
+      <h1>Check your email</h1>
+      <p>We couldn't confirm <strong>${escapeHtml(email)}</strong> automatically, so we sent a 6-digit code to that address.</p>
+      ${message ? `<p class="error" role="alert">${escapeHtml(message)}</p>` : ''}
+      <form method="POST" action="/api/rewards/confirm">
+        <label for="code">Verification code</label>
+        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
+               pattern="[0-9]{6}" maxlength="6" required enterkeyhint="done">
+        <button type="submit">Verify and join Rewards</button>
+      </form>`,
+  });
+}
+
+function welcomePage(account, viaBrowser) {
+  return renderPage({
+    title: 'Welcome to Rewards',
+    body: `
+      <h1>Welcome, ${escapeHtml(account.name)}!</h1>
+      ${viaBrowser ? '<p><span class="badge">✓ Email verified by your browser</span></p>' : ''}
+      <p>Your Daily Grind Rewards account for <strong>${escapeHtml(account.email)}</strong> is ready.
+         You've earned a free drink on us to start your rewards.</p>
+      <a class="btn" href="/">Back to The Daily Grind</a>`,
+  });
+}
+
+function errorPage(status, message) {
+  return renderPage({
+    title: 'Something went wrong',
+    body: `<h1>Something went wrong</h1><p class="error" role="alert">${escapeHtml(message)}</p>
+           <a class="btn" href="/#join-rewards">Try again</a>`,
+  });
+}
+
+// Stub mailer – replace with your transactional email provider.
+async function sendEmail(to, subject, text) {
+  console.log(`[mail] to=${to} subject=${JSON.stringify(subject)}\n${text}`);
+}
+
+function createAccount({ name, email, passwordHash, verifiedVia }) {
+  const account = {
+    id: randomBytes(16).toString('hex'),
+    name,
+    email,
+    passwordHash,
+    verifiedVia,
+    createdAt: new Date().toISOString(),
+  };
+  accounts.set(email.toLowerCase(), account);
+  return account;
+}
+
+// ---------------------------------------------------------------------------
+// Route handlers
+// ---------------------------------------------------------------------------
+
+function handleHome(req, res) {
+  const session = getSession(req, res);
+  const nonce = issueNonce(session);
+  if (ORIGIN_TRIAL_TOKEN) res.setHeader('Origin-Trial', ORIGIN_TRIAL_TOKEN);
+  sendHtml(res, 200, INDEX_TEMPLATE.replaceAll('__EVT_NONCE__', nonce));
+}
+
+const NAME_RE = /^[\p{L}\p{M}][\p{L}\p{M}\p{Zs}'’.\-]{0,99}$/u;
+const EMAIL_RE = /^[^\s@]{1,64}@[^\s@]+\.[^\s@]{2,}$/;
+
+async function handleSignup(req, res) {
+  if (!isSameOrigin(req)) return sendHtml(res, 403, errorPage(403, 'Invalid request origin.'));
+  const session = getSession(req, res);
+  // Consume the nonce up front so it can never be replayed, whatever happens next.
+  const expectedNonce = consumeNonce(session);
+
+  const form = await readForm(req);
+  const name = String(form.get('name') || '').trim();
+  const email = String(form.get('email') || '').trim();
+  const password = String(form.get('password') || '');
+  const rawToken = String(form.get('token') || '').trim();
+
+  if (!NAME_RE.test(name) || !EMAIL_RE.test(email) || email.length > 254 || password.length < 8 || password.length > 256) {
+    return sendHtml(res, 400, errorPage(400, 'Please provide your name, a valid email address, and a password of at least 8 characters.'));
+  }
+
+  const passwordHash = await hashPassword(password);
+  const existing = accounts.get(email.toLowerCase());
+
+  // Fast path: browser-assisted email ownership verification (EVP).
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: RP_ORIGIN });
+      if (existing) {
+        // Ownership is proven, so it's safe to tell this user they already have an account.
+        return sendHtml(res, 409, errorPage(409, 'You already have a Rewards account with this email. Please sign in instead.'));
+      }
+      const account = createAccount({ name, email, passwordHash, verifiedVia: 'email-verification-protocol' });
+      await sendEmail(email, 'Welcome to Daily Grind Rewards', `Hi ${name}, your Rewards account is ready.`);
+      return sendHtml(res, 201, welcomePage(account, true));
+    } catch (err) {
+      console.warn('[evp] token verification failed, falling back to emailed code:', err?.message ?? err);
+    }
+  }
+
+  // Fallback path: email a one-time code. Respond identically whether or not
+  // the account exists to avoid account enumeration.
+  const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  session.pending = {
+    name,
+    email,
+    passwordHash,
+    codeHash: sha256(code),
+    attempts: 0,
+    expires: Date.now() + CODE_TTL_MS,
+  };
+  if (existing) {
+    delete session.pending.codeHash;
+    await sendEmail(email, 'Your Daily Grind Rewards account', 'Someone tried to create a Rewards account with this email, but you already have one. Sign in or reset your password.');
+  } else {
+    await sendEmail(email, 'Your Daily Grind verification code', `Your code is ${code}. It expires in 10 minutes.`);
+  }
+  return sendHtml(res, 200, codeEntryPage(email));
+}
+
+async function handleConfirm(req, res) {
+  if (!isSameOrigin(req)) return sendHtml(res, 403, errorPage(403, 'Invalid request origin.'));
+  const session = getSession(req, res);
+  const form = await readForm(req);
+  const pending = session.pending;
+
+  if (!pending || pending.expires < Date.now()) {
+    delete session.pending;
+    return sendHtml(res, 400, errorPage(400, 'Your verification code has expired. Please sign up again.'));
+  }
+
+  const code = String(form.get('code') || '').trim();
+  const ok = pending.codeHash && /^\d{6}$/.test(code) && timingSafeEqual(sha256(code), pending.codeHash);
+  if (!ok) {
+    pending.attempts += 1;
+    if (pending.attempts >= MAX_CODE_ATTEMPTS) {
+      delete session.pending;
+      return sendHtml(res, 429, errorPage(429, 'Too many incorrect attempts. Please sign up again.'));
+    }
+    return sendHtml(res, 400, codeEntryPage(pending.email, 'That code is incorrect. Please try again.'));
+  }
+
+  delete session.pending;
+  if (accounts.has(pending.email.toLowerCase())) {
+    return sendHtml(res, 409, errorPage(409, 'You already have a Rewards account with this email. Please sign in instead.'));
+  }
+  const account = createAccount({ ...pending, verifiedVia: 'email-otp' });
+  return sendHtml(res, 201, welcomePage(account, false));
+}
+
+// ---------------------------------------------------------------------------
+// Server
+// ---------------------------------------------------------------------------
+
+const server = createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, RP_ORIGIN);
+  try {
+    if ((req.method === 'GET' || req.method === 'HEAD') && (pathname === '/' || pathname === '/index.html')) {
+      return handleHome(req, res);
+    }
+    if (req.method === 'POST' && pathname === '/api/rewards/signup') return await handleSignup(req, res);
+    if (req.method === 'POST' && pathname === '/api/rewards/confirm') return await handleConfirm(req, res);
+    sendHtml(res, 404, errorPage(404, 'Page not found.'));
+  } catch (err) {
+    const status = err?.status || 500;
+    if (status === 500) console.error(err);
+    if (!res.headersSent) sendHtml(res, status, errorPage(status, status === 500 ? 'Unexpected error.' : err.message));
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on :${PORT} (origin ${RP_ORIGIN})`);
+});
