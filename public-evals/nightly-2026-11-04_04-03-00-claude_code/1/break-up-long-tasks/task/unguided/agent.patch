+  <script>
+    (() => {
+      'use strict';
+
+      // ---------- Yielding helpers ----------
+      // Prefer the native Prioritized Task Scheduling API; fall back to a
+      // MessageChannel macrotask (not clamped like nested setTimeout).
+      const channel = new MessageChannel();
+      const pending = [];
+      channel.port1.onmessage = () => { const r = pending.shift(); if (r) r(); };
+
+      function yieldToMain() {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') {
+          return scheduler.yield();
+        }
+        if (globalThis.scheduler && typeof scheduler.postTask === 'function') {
+          return scheduler.postTask(() => {}, { priority: 'user-visible' });
+        }
+        return new Promise((resolve) => {
+          pending.push(resolve);
+          channel.port2.postMessage(null);
+        });
+      }
+
+      const TIME_BUDGET_MS = 8; // keep each slice well under the 50ms long-task threshold
+
+      function shouldYield(sliceStart) {
+        if (navigator.scheduling && typeof navigator.scheduling.isInputPending === 'function'
+          && navigator.scheduling.isInputPending()) {
+          return true;
+        }
+        return performance.now() - sliceStart >= TIME_BUDGET_MS;
+      }
+
+      // ---------- Simulation model ----------
+      const ATTRS = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+
+      const BEANS = [
+        { name: 'Ethiopia Yirgacheffe', p: [8.5, 4, 6.5, 2.5, 9] },
+        { name: 'Colombia Huila', p: [6, 6, 7, 3.5, 7] },
+        { name: 'Brazil Cerrado', p: [3.5, 7.5, 7.5, 4, 5.5] },
+        { name: 'Sumatra Mandheling', p: [2.5, 9, 5, 5.5, 6.5] },
+        { name: 'Kenya AA', p: [9, 5.5, 6, 3, 8] },
+        { name: 'Guatemala Antigua', p: [6.5, 6.5, 6.5, 4, 7.5] },
+        { name: 'Costa Rica Tarrazú', p: [7.5, 5.5, 7, 3, 7] },
+        { name: 'India Monsooned Malabar', p: [2, 8.5, 4.5, 6, 5] },
+        { name: 'Panama Geisha', p: [8, 4.5, 8, 2, 9.5] },
+        { name: 'Vietnam Robusta', p: [2.5, 9, 3, 8.5, 4.5] },
+      ];
+
+      const ROASTS = [
+        { name: 'Light', d: [1.5, -1, 0.5, -1.5, 1] },
+        { name: 'Medium', d: [0, 0.5, 1, 0, 0.5] },
+        { name: 'Medium-Dark', d: [-1, 1.2, 0.3, 1.2, 0] },
+        { name: 'Dark', d: [-2, 1.8, -0.8, 2.5, -0.5] },
+      ];
+
+      // Small seeded PRNG (mulberry32) so a given batch is reproducible.
+      function mulberry32(seed) {
+        return function () {
+          seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
+          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      const clamp = (v) => (v < 0 ? 0 : v > 10 ? 10 : v);
+      const profile = new Float64Array(5);
+
+      // Simulate one blend: mix beans, apply roast, then iterate a simple
+      // extraction curve. Deliberately CPU-heavy per item.
+      function simulateBlend(rand, target) {
+        const count = 2 + Math.floor(rand() * 3); // 2-4 beans
+        const picks = [];
+        let total = 0;
+        for (let i = 0; i < count; i++) {
+          const w = 0.1 + rand();
+          picks.push({ bean: Math.floor(rand() * BEANS.length), w });
+          total += w;
+        }
+        const roast = Math.floor(rand() * ROASTS.length);
+        const grind = 0.6 + rand() * 0.8;   // fine..coarse
+        const temp = 88 + rand() * 8;       // °C
+
+        profile.fill(0);
+        for (const pk of picks) {
+          const bp = BEANS[pk.bean].p;
+          const share = pk.w / total;
+          for (let a = 0; a < 5; a++) profile[a] += bp[a] * share;
+        }
+        const rd = ROASTS[roast].d;
+        for (let a = 0; a < 5; a++) profile[a] += rd[a];
+
+        // Extraction: acids extract early, bitter compounds late.
+        const rates = [0.09, 0.05, 0.06, 0.025, 0.07];
+        const heat = (temp - 85) / 10;
+        let extracted = [0, 0, 0, 0, 0];
+        for (let step = 0; step < 60; step++) {
+          for (let a = 0; a < 5; a++) {
+            const k = rates[a] * heat / grind;
+            extracted[a] += (1 - extracted[a]) * k * (1 + 0.15 * Math.sin(step * 0.3 + a));
+          }
+        }
+        for (let a = 0; a < 5; a++) {
+          profile[a] = clamp(profile[a] * (0.55 + 0.6 * extracted[a]));
+        }
+
+        let dist = 0;
+        for (let a = 0; a < 5; a++) {
+          const diff = profile[a] - target[a];
+          dist += diff * diff;
+        }
+        const score = 100 * (1 - Math.sqrt(dist) / Math.sqrt(500));
+        return { picks, total, roast, grind, temp, score, profile: Array.from(profile) };
+      }
+
+      // Insert into a small, sorted top-N list.
+      function keepTop(top, item, n) {
+        if (top.length === n && item.score <= top[n - 1].score) return;
+        let i = top.length;
+        while (i > 0 && top[i - 1].score < item.score) i--;
+        top.splice(i, 0, item);
+        if (top.length > n) top.pop();
+      }
+
+      async function runSimulation({ total, target, signal, onProgress }) {
+        const rand = mulberry32(total ^ 0xC0FFEE);
+        const top = [];
+        let done = 0;
+        let slices = 0;
+        const started = performance.now();
+
+        while (done < total) {
+          if (signal.aborted) throw new DOMException('Cancelled', 'AbortError');
+          const sliceStart = performance.now();
+          // Process a chunk until the time budget is spent.
+          do {
+            keepTop(top, simulateBlend(rand, target), 5);
+            done++;
+          } while (done < total && (done & 63 || !shouldYield(sliceStart)));
+          slices++;
+          onProgress(done, total);
+          await yieldToMain();
+        }
+        return { top, elapsed: performance.now() - started, slices };
+      }
+
+      // ---------- UI wiring ----------
+      const form = document.getElementById('sim-form');
+      const runBtn = document.getElementById('sim-run');
+      const cancelBtn = document.getElementById('sim-cancel');
+      const progress = document.getElementById('sim-progress');
+      const bar = document.getElementById('sim-progress-bar');
+      const status = document.getElementById('sim-status');
+      const heartbeat = document.getElementById('sim-heartbeat');
+      const results = document.getElementById('sim-results');
+      const tbody = document.getElementById('sim-results-body');
+
+      form.addEventListener('input', (e) => {
+        if (e.target.type === 'range') {
+          document.getElementById('out-' + e.target.name).textContent = e.target.value;
+        }
+      });
+
+      let controller = null;
+      let lastPaint = 0;
+
+      function setProgress(done, total) {
+        const now = performance.now();
+        if (done !== total && now - lastPaint < 50) return; // throttle DOM writes
+        lastPaint = now;
+        const pct = Math.round((done / total) * 100);
+        bar.style.width = pct + '%';
+        progress.setAttribute('aria-valuenow', String(pct));
+        status.textContent = `Simulating blends… ${done.toLocaleString()} / ${total.toLocaleString()} (${pct}%)`;
+      }
+
+      // Visual proof of responsiveness: a ticker driven by rAF keeps running
+      // during the simulation because we never block for long.
+      let hbFrame = 0;
+      function startHeartbeat() {
+        const cups = ['☕', '☕☕', '☕☕☕'];
+        let i = 0, last = 0;
+        const tick = (t) => {
+          if (t - last > 300) { heartbeat.textContent = 'Brewing ' + cups[i++ % 3]; last = t; }
+          hbFrame = requestAnimationFrame(tick);
+        };
+        hbFrame = requestAnimationFrame(tick);
+      }
+      function stopHeartbeat() {
+        cancelAnimationFrame(hbFrame);
+        heartbeat.textContent = '';
+      }
+
+      function renderResults(top) {
+        tbody.replaceChildren();
+        top.forEach((r, idx) => {
+          const tr = document.createElement('tr');
+
+          const rank = document.createElement('td');
+          rank.textContent = String(idx + 1);
+
+          const blend = document.createElement('td');
+          // Merge duplicate beans for display.
+          const shares = new Map();
+          for (const pk of r.picks) {
+            shares.set(pk.bean, (shares.get(pk.bean) || 0) + pk.w / r.total);
+          }
+          blend.textContent = [...shares]
+            .sort((a, b) => b[1] - a[1])
+            .map(([b, s]) => `${Math.round(s * 100)}% ${BEANS[b].name}`)
+            .join(', ');
+          const meta = document.createElement('div');
+          meta.style.fontSize = '0.8rem';
+          meta.style.color = '#8d6e63';
+          meta.textContent = `Grind ${r.grind < 0.9 ? 'fine' : r.grind < 1.15 ? 'medium' : 'coarse'} · ${r.temp.toFixed(1)}°C`;
+          blend.appendChild(meta);
+
+          const roast = document.createElement('td');
+          roast.textContent = ROASTS[r.roast].name;
+
+          const prof = document.createElement('td');
+          const bars = document.createElement('div');
+          bars.className = 'flavor-bars';
+          ATTRS.forEach((attr, a) => {
+            const label = document.createElement('span');
+            label.textContent = attr[0].toUpperCase() + attr.slice(1);
+            const track = document.createElement('div');
+            track.className = 'flavor-bar';
+            const fill = document.createElement('span');
+            fill.style.width = (r.profile[a] * 10) + '%';
+            track.appendChild(fill);
+            const val = document.createElement('span');
+            val.textContent = r.profile[a].toFixed(1);
+            bars.append(label, track, val);
