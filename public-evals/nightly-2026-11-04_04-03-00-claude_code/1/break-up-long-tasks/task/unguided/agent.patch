+          prof.appendChild(bars);
+
+          const score = document.createElement('td');
+          score.textContent = r.score.toFixed(1) + '%';
+
+          tr.append(rank, blend, roast, prof, score);
+          tbody.appendChild(tr);
+        });
+        results.hidden = false;
+      }
+
+      runBtn.addEventListener('click', async () => {
+        const data = new FormData(form);
+        const target = ATTRS.map((a) => Number(data.get(a)));
+        const total = Number(data.get('batch'));
+
+        controller = new AbortController();
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        form.querySelectorAll('input, select').forEach((el) => { el.disabled = true; });
+        results.hidden = true;
+        lastPaint = 0;
+        setProgress(0, total);
+        startHeartbeat();
+
+        try {
+          const { top, elapsed, slices } = await runSimulation({
+            total, target, signal: controller.signal, onProgress: setProgress,
+          });
+          renderResults(top);
+          status.textContent = `Simulated ${total.toLocaleString()} blends in ${(elapsed / 1000).toFixed(2)}s across ${slices.toLocaleString()} non-blocking slices.`;
+        } catch (err) {
+          if (err.name === 'AbortError') {
+            status.textContent = 'Simulation cancelled.';
+            bar.style.width = '0';
+            progress.setAttribute('aria-valuenow', '0');
+          } else {
+            status.textContent = 'Something went wrong while simulating. Please try again.';
+            console.error(err);
+          }
+        } finally {
+          stopHeartbeat();
+          controller = null;
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+          form.querySelectorAll('input, select').forEach((el) => { el.disabled = false; });
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        if (controller) controller.abort();
+      });
+    })();
+  </script>
