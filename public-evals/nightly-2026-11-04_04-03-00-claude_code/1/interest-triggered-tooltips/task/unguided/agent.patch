+  <script>
+    // Flip a tooltip to the left of its button if it would overflow the viewport on the right.
+    document.querySelectorAll('.tooltip-wrap').forEach(function (wrap) {
+      function place() {
+        var tip = wrap.querySelector('.tooltip');
+        wrap.classList.remove('flip');
+        if (tip.getBoundingClientRect().right > document.documentElement.clientWidth - 8) {
+          wrap.classList.add('flip');
+        }
+      }
+      wrap.addEventListener('mouseenter', place);
+      wrap.addEventListener('focusin', place);
+    });
+  </script>
