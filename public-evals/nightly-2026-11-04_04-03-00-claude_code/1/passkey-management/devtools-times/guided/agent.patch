@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { deleteCredential, renameCredential, toPublicPasskey } from '../../../lib/accountStore';
+import { cleanName, getCurrentUser, json, unauthorized } from '../../../lib/auth';
+
+
+const notFound = () => json({ error: 'Passkey not found.' }, 404);
+
+/** Renames a passkey. This is a server-side label only; providers aren't signalled. */
+export const PUT: APIRoute = async (ctx) => {
+  const user = await getCurrentUser(ctx);
+  if (!user) return unauthorized();
+
+  const { name } = await ctx.request.json().catch(() => ({}));
+  const cleaned = cleanName(name);
+  if (!cleaned) return json({ error: 'Name must be 1–64 characters.' }, 400);
+
+  const updated = await renameCredential(user.passkeyUserId, ctx.params.id!, cleaned);
+  return updated ? json(toPublicPasskey(updated)) : notFound();
+};
+
+export const DELETE: APIRoute = async (ctx) => {
+  const user = await getCurrentUser(ctx);
+  if (!user) return unauthorized();
+
+  const removed = await deleteCredential(user.passkeyUserId, ctx.params.id!);
+  return removed ? json({ success: true }) : notFound();
+};
