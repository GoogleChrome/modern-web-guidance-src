+import type { APIRoute } from 'astro';
+import { updateUserDisplayName } from '../../lib/accountStore';
+import { cleanName, getCurrentUser, json, unauthorized } from '../../lib/auth';
+
+/** Updates the signed-in reader's display name (synced to passkey providers client-side). */
+export const PUT: APIRoute = async (ctx) => {
+  const user = await getCurrentUser(ctx);
+  if (!user) return unauthorized();
+
+  const { displayName } = await ctx.request.json().catch(() => ({}));
+  const name = cleanName(displayName);
+  if (!name) return json({ error: 'Display name must be 1–64 characters.' }, 400);
+
+  const updated = await updateUserDisplayName(user.username, name);
+  return json({ username: updated!.username, displayName: updated!.displayName });
+};
