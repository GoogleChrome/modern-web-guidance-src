diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..5aafdc4
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,471 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import type { PublicPasskey } from '../lib/accountStore';
+
+interface Props {
+  rpId: string;
+  /** Base64URL-encoded WebAuthn user handle. */
+  userId: string;
+  username: string;
+  initialDisplayName: string;
+  initialPasskeys: PublicPasskey[];
+}
+
+type Status = { kind: 'success' | 'error' | 'info'; message: string } | null;
+
+// Signal API + JSON helpers aren't in every TS DOM lib yet.
+type PKC = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON?: (json: unknown) => PublicKeyCredentialCreationOptions;
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+const API = `${import.meta.env.BASE_URL}api`;
+const MAX_NAME_LENGTH = 64;
+
+const getPKC = (): PKC | undefined =>
+  typeof window !== 'undefined' && 'PublicKeyCredential' in window ? (window.PublicKeyCredential as PKC) : undefined;
+
+async function api<T>(path: string, init?: RequestInit): Promise<T> {
+  const res = await fetch(`${API}${path}`, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
+  return data as T;
+}
+
+export default function AccountSettings({ rpId, userId, username, initialDisplayName, initialPasskeys }: Props) {
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [savedDisplayName, setSavedDisplayName] = useState(initialDisplayName);
+  const [status, setStatus] = useState<Status>(null);
+  const [busy, setBusy] = useState(false);
+  const [mounted, setMounted] = useState(false);
+  // null = still checking, false = unsupported
+  const [canCreate, setCanCreate] = useState<boolean | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<PublicPasskey | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const displayNameId = useId();
+
+  /** Tell passkey providers which credentials are still valid so they hide stale ones. */
+  const syncAcceptedCredentials = useCallback(
+    async (list: PublicPasskey[]) => {
+      const PKC = getPKC();
+      if (!PKC?.signalAllAcceptedCredentials) return;
+      try {
+        await PKC.signalAllAcceptedCredentials({
+          rpId,
+          userId,
+          allAcceptedCredentialIds: list.map((p) => p.id),
+        });
+      } catch (err) {
+        console.error('signalAllAcceptedCredentials failed:', err);
+      }
+    },
+    [rpId, userId],
+  );
+
+  const refresh = useCallback(async () => {
+    const list = await api<PublicPasskey[]>('/passkeys');
+    setPasskeys(list);
+    return list;
+  }, []);
+
+  useEffect(() => {
+    setMounted(true);
+    let cancelled = false;
+    (async () => {
+      const PKC = getPKC();
+      if (!PKC) {
+        setCanCreate(false);
+        return;
+      }
+      // Fills in getClientCapabilities / parseCreationOptionsFromJSON / toJSON on older browsers.
+      await import('webauthn-polyfills').catch(() => undefined);
+      // Keep the browser's passkey list in sync with the server on every visit.
+      syncAcceptedCredentials(initialPasskeys);
+      try {
+        const caps = (await PKC.getClientCapabilities?.()) ?? {};
+        if (!cancelled) setCanCreate(Boolean(caps.passkeyPlatformAuthenticator));
+      } catch {
+        if (!cancelled) setCanCreate(false);
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+    // Run once on mount with server-rendered list.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (pendingDelete && !dialog.open) dialog.showModal();
+    if (!pendingDelete && dialog.open) dialog.close();
+  }, [pendingDelete]);
+
+  const formatDate = (ts: number) =>
+    new Intl.DateTimeFormat('en-US', {
+      dateStyle: 'medium',
+      // Server and client may be in different zones; avoid hydration mismatches.
+      ...(mounted ? {} : { timeZone: 'UTC' }),
+    }).format(ts);
+
+  async function handleCreatePasskey() {
+    const PKC = getPKC();
+    if (!PKC?.parseCreationOptionsFromJSON) return;
+    setBusy(true);
+    setStatus(null);
+
+    let credential: PublicKeyCredential;
+    try {
+      const optionsJSON = await api<unknown>('/passkeys/register-options', { method: 'POST' });
+      const publicKey = PKC.parseCreationOptionsFromJSON(optionsJSON);
+      credential = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential;
+    } catch (err: any) {
+      setBusy(false);
+      if (err?.name === 'InvalidStateError') {
+        setStatus({ kind: 'info', message: 'A passkey from this password manager is already registered.' });
+      } else if (err?.name === 'NotAllowedError' || err?.name === 'AbortError') {
+        // User cancelled — nothing to report.
+      } else if (err?.name === 'SecurityError') {
+        setStatus({ kind: 'error', message: 'Passkeys are not available on this site configuration.' });
+      } else {
+        setStatus({ kind: 'error', message: err?.message || 'Could not create a passkey.' });
+      }
+      return;
+    }
+
+    const encoded = (credential as any).toJSON();
+    try {
+      const created = await api<PublicPasskey>('/passkeys/register-verify', {
+        method: 'POST',
+        body: JSON.stringify(encoded),
+      });
+      await refresh().catch(() => setPasskeys((list) => [created, ...list]));
+      setStatus({ kind: 'success', message: `Passkey “${created.name}” added.` });
+    } catch (err: any) {
+      // The authenticator saved a credential the server rejected — tell it to drop it.
+      if (PKC.signalUnknownCredential) {
+        await PKC.signalUnknownCredential({ rpId, credentialId: encoded.id }).catch(() => undefined);
+      }
+      setStatus({ kind: 'error', message: err?.message || 'Could not save the passkey.' });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function handleRename(e: React.FormEvent<HTMLFormElement>, passkey: PublicPasskey) {
+    e.preventDefault();
+    const name = String(new FormData(e.currentTarget).get('name') ?? '').trim();
+    if (!name || name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    setBusy(true);
+    try {
+      // Nickname is a server-side label only; providers don't need a signal.
+      const updated = await api<PublicPasskey>(`/passkeys/${encodeURIComponent(passkey.id)}`, {
+        method: 'PUT',
+        body: JSON.stringify({ name }),
+      });
+      setPasskeys((list) => list.map((p) => (p.id === updated.id ? updated : p)));
+      setEditingId(null);
+      setStatus({ kind: 'success', message: `Passkey renamed to “${updated.name}”.` });
+    } catch (err: any) {
+      setStatus({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function confirmDelete() {
+    if (!pendingDelete) return;
+    const target = pendingDelete;
+    setBusy(true);
+    try {
+      await api(`/passkeys/${encodeURIComponent(target.id)}`, { method: 'DELETE' });
+      const list = await refresh().catch(() => passkeys.filter((p) => p.id !== target.id));
+      setPasskeys(list);
+      // Have the password manager hide the removed passkey.
+      await syncAcceptedCredentials(list);
+      setStatus({ kind: 'success', message: `Passkey “${target.name}” removed.` });
+    } catch (err: any) {
+      setStatus({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(false);
+      setPendingDelete(null);
+    }
+  }
+
+  async function handleDisplayName(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setStatus(null);
+    try {
+      const updated = await api<{ username: string; displayName: string }>('/user', {
+        method: 'PUT',
+        body: JSON.stringify({ displayName }),
+      });
+      setDisplayName(updated.displayName);
+      setSavedDisplayName(updated.displayName);
+      const PKC = getPKC();
+      if (PKC?.signalCurrentUserDetails) {
+        try {
+          await PKC.signalCurrentUserDetails({
+            rpId,
+            userId,
+            name: updated.username,
+            displayName: updated.displayName,
+          });
+        } catch (err) {
+          console.error('signalCurrentUserDetails failed:', err);
+        }
+      }
+      setStatus({ kind: 'success', message: 'Display name updated.' });
+    } catch (err: any) {
+      setStatus({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function handleSignOut() {
+    await fetch(`${API}/auth/logout`, { method: 'POST' }).catch(() => undefined);
+    window.location.href = import.meta.env.BASE_URL;
+  }
+
+  const statusStyles = {
+    success: 'text-green-800 bg-green-100',
+    error: 'text-red-800 bg-red-100',
+    info: 'text-gray-800 bg-gray-100',
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto">
+      <div className="flex items-baseline justify-between mb-8 border-b border-gray-300 pb-4">
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="text-sm font-semibold text-gray-600 hover:text-gray-900 hover:underline"
+        >
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite" className="min-h-0">
+        {status && (
+          <p className={`mb-6 p-3 text-sm rounded-lg ${statusStyles[status.kind]}`}>{status.message}</p>
+        )}
+      </div>
+
+      {/* Profile */}
+      <section aria-labelledby="profile-heading" className="mb-10">
+        <h2 id="profile-heading" className="text-xs font-semibold tracking-wider text-gray-500 uppercase mb-4">
+          Profile
+        </h2>
+        <dl className="mb-4 text-sm">
+          <dt className="font-medium text-gray-700">Username</dt>
+          <dd className="text-gray-900">{username}</dd>
+        </dl>
+        <form onSubmit={handleDisplayName} className="flex flex-col sm:flex-row gap-3 sm:items-end">
+          <div className="flex-1">
+            <label htmlFor={displayNameId} className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id={displayNameId}
+              type="text"
+              name="displayName"
+              autoComplete="nickname"
+              required
+              maxLength={MAX_NAME_LENGTH}
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={busy || displayName.trim() === savedDisplayName}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            Save
+          </button>
+        </form>
+        <p className="text-xs text-gray-500 mt-2">Also updates how your account appears in your password manager.</p>
+      </section>
+
+      {/* Passkeys */}
+      <section aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
+          <h2 id="passkeys-heading" className="text-xs font-semibold tracking-wider text-gray-500 uppercase">
+            Passkeys
+          </h2>
+          {canCreate && (
+            <button
+              type="button"
+              onClick={handleCreatePasskey}
+              disabled={busy}
+              className="inline-flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed"
+            >
+              <KeyIcon className="w-4 h-4" aria-hidden="true" />
+              Create passkey
+            </button>
+          )}
+        </div>
+
+        <p className="text-sm text-gray-600 mb-4">
+          Passkeys let you sign in with your fingerprint, face, screen lock, or security key instead of a password.
+        </p>
+
+        {canCreate === false && (
+          <p className="mb-4 p-3 text-sm rounded-lg text-gray-800 bg-yellow-50 border border-yellow-200">
+            This browser or device can’t create passkeys. You can still manage passkeys registered elsewhere, and keep
+            signing in with your password.
+          </p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <p className="p-6 text-sm text-center text-gray-600 border border-dashed border-gray-300 rounded-lg">
+            No passkeys found.
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="flex items-start gap-4 p-4">
+                {passkey.providerIcon ? (
+                  <img src={passkey.providerIcon} alt="" width={32} height={32} className="w-8 h-8 shrink-0" />
+                ) : (
+                  <span className="w-8 h-8 shrink-0 rounded-full bg-gray-100 flex items-center justify-center">
+                    <KeyIcon className="w-5 h-5 text-gray-600" aria-hidden="true" />
+                  </span>
+                )}
+
+                <div className="flex-1 min-w-0">
+                  {editingId === passkey.id ? (
+                    <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${passkey.id}`}
+                        name="name"
+                        type="text"
+                        autoComplete="off"
+                        required
+                        maxLength={MAX_NAME_LENGTH}
+                        defaultValue={passkey.name}
+                        autoFocus
+                        onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                        className="flex-1 min-w-40 px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        disabled={busy}
+                        className="px-3 py-1 text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50"
+                      >
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="px-3 py-1 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-900 break-words">
+                      {passkey.name}
+                      {passkey.synced && (
+                        <span className="ml-2 align-middle text-xs font-medium text-gray-600 bg-gray-100 rounded px-1.5 py-0.5">
+                          Synced
+                        </span>
+                      )}
+                    </p>
+                  )}
+                  <p className="text-xs text-gray-600 mt-1">
+                    Created <time dateTime={new Date(passkey.registeredAt).toISOString()}>{formatDate(passkey.registeredAt)}</time>
+                    {' · '}
+                    {passkey.lastUsedAt ? (
+                      <>
+                        Last used{' '}
+                        <time dateTime={new Date(passkey.lastUsedAt).toISOString()}>{formatDate(passkey.lastUsedAt)}</time>
+                      </>
+                    ) : (
+                      'Never used'
+                    )}
+                  </p>
+                </div>
+
+                {editingId !== passkey.id && (
+                  <div className="flex shrink-0 gap-1">
+                    <button
+                      type="button"
+                      onClick={() => setEditingId(passkey.id)}
+                      disabled={busy}
+                      aria-label={`Rename ${passkey.name}`}
+                      className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-50"
+                    >
+                      <PencilSquareIcon className="w-5 h-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setPendingDelete(passkey)}
+                      disabled={busy}
+                      aria-label={`Remove ${passkey.name}`}
+                      className="p-2 rounded-md text-gray-600 hover:bg-red-50 hover:text-red-700 disabled:opacity-50"
+                    >
+                      <TrashIcon className="w-5 h-5" aria-hidden="true" />
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        aria-labelledby="delete-passkey-title"
+        onClose={() => setPendingDelete(null)}
+        className="m-auto max-w-sm w-[calc(100%-2rem)] rounded-lg p-6 shadow-xl backdrop:bg-black/40"
+      >
+        <h2 id="delete-passkey-title" className="text-lg font-bold text-gray-900 mb-2">
+          Remove passkey?
+        </h2>
+        <p className="text-sm text-gray-600 mb-6">
+          You won’t be able to sign in with “{pendingDelete?.name}” anymore. Supported password managers will hide it
+          automatically.
+        </p>
+        <div className="flex justify-end gap-2">
+          <button
+            type="button"
+            autoFocus
+            onClick={() => setPendingDelete(null)}
+            className="px-4 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100"
+          >
+            Cancel
+          </button>
+          <button
+            type="button"
+            onClick={confirmDelete}
+            disabled={busy}
+            className="px-4 py-2 text-sm font-medium rounded-md text-white bg-red-700 hover:bg-red-800 disabled:opacity-50"
+          >
+            Remove
+          </button>
+        </div>
+      </dialog>
+    </div>
+  );
+}
