diff --git a/src/lib/aaguid.ts b/src/lib/aaguid.ts
new file mode 100644
index 0000000..646cb33
--- /dev/null
+++ b/src/lib/aaguid.ts
@@ -0,0 +1,37 @@
+/**
+ * Resolves an authenticator AAGUID to a provider name and icon using the
+ * community-maintained passkey AAGUID registry. Used for UX hints only —
+ * never for security decisions, since platform passkeys aren't attested.
+ */
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const FAILURE_RETRY_MS = 10 * 60 * 1000;
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registry: Registry | null = null;
+let lastFailure = 0;
+
+async function loadRegistry(): Promise<Registry | null> {
+  if (registry) return registry;
+  if (Date.now() - lastFailure < FAILURE_RETRY_MS) return null;
+  try {
+    const res = await fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    registry = (await res.json()) as Registry;
+    return registry;
+  } catch (err) {
+    console.warn('Could not load AAGUID registry:', err);
+    lastFailure = Date.now();
+    return null;
+  }
+}
+
+export async function lookupProvider(aaguid: string): Promise<{ name: string; icon?: string }> {
+  const fallback = { name: 'Passkey' };
+  if (!aaguid || aaguid === ZERO_AAGUID) return fallback;
+  const entry = (await loadRegistry())?.[aaguid];
+  return entry ? { name: entry.name, icon: entry.icon_light } : fallback;
+}
diff --git a/src/lib/accountStore.ts b/src/lib/accountStore.ts
new file mode 100644
index 0000000..93f522e
--- /dev/null
+++ b/src/lib/accountStore.ts
@@ -0,0 +1,154 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+/**
+ * Minimal JSON-file backed store for reader accounts and their passkeys.
+ * The upstream login API only verifies username/password; everything that
+ * belongs to the account locally (passkey user handle, display name and
+ * registered credentials) lives here.
+ */
+
+export interface StoredUser {
+  /** Username as accepted by the login API. */
+  username: string;
+  /** Base64URL-encoded WebAuthn user handle (random, never the username). */
+  passkeyUserId: string;
+  displayName: string;
+}
+
+export interface StoredPasskeyCredential {
+  /** Base64URL-encoded credential ID. */
+  id: string;
+  passkeyUserId: string;
+  /** Base64URL-encoded COSE public key. */
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  /** Provider name from the AAGUID registry, or the reader's custom nickname. */
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface StoreData {
+  users: Record<string, StoredUser>;
+  credentials: StoredPasskeyCredential[];
+}
+
+const DATA_DIR = process.env.ACCOUNT_DATA_DIR || path.join(process.cwd(), '.data');
+const DATA_FILE = path.join(DATA_DIR, 'accounts.json');
+
+let cache: StoreData | null = null;
+// Serialise all mutations so concurrent requests can't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await fs.readFile(DATA_FILE, 'utf8')) as StoreData;
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: {}, credentials: [] };
+  }
+  return cache;
+}
+
+async function persist(data: StoreData) {
+  await fs.mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(data, null, 2));
+  await fs.rename(tmp, DATA_FILE);
+}
+
+function mutate<T>(fn: (data: StoreData) => T): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await load();
+    const result = fn(data);
+    await persist(data);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+export async function getUser(username: string): Promise<StoredUser | undefined> {
+  return (await load()).users[username];
+}
+
+export function ensureUser(username: string): Promise<StoredUser> {
+  return mutate((data) => {
+    if (!data.users[username]) {
+      data.users[username] = {
+        username,
+        passkeyUserId: randomBytes(32).toString('base64url'),
+        displayName: username,
+      };
+    }
+    return data.users[username];
+  });
+}
+
+export function updateUserDisplayName(username: string, displayName: string) {
+  return mutate((data) => {
+    const user = data.users[username];
+    if (!user) return undefined;
+    user.displayName = displayName;
+    return user;
+  });
+}
+
+export async function listCredentials(passkeyUserId: string): Promise<StoredPasskeyCredential[]> {
+  return (await load()).credentials
+    .filter((c) => c.passkeyUserId === passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export function addCredential(cred: StoredPasskeyCredential) {
+  return mutate((data) => {
+    if (data.credentials.some((c) => c.id === cred.id)) {
+      throw new Error('Credential already registered');
+    }
+    data.credentials.push(cred);
+    return cred;
+  });
+}
+
+/** Renames a credential owned by `passkeyUserId`. Returns undefined if not found / not owned. */
+export function renameCredential(passkeyUserId: string, id: string, name: string) {
+  return mutate((data) => {
+    const cred = data.credentials.find((c) => c.id === id && c.passkeyUserId === passkeyUserId);
+    if (!cred) return undefined;
+    cred.name = name;
+    return cred;
+  });
+}
+
+/** Deletes a credential owned by `passkeyUserId`. Returns false if not found / not owned. */
+export function deleteCredential(passkeyUserId: string, id: string) {
+  return mutate((data) => {
+    const idx = data.credentials.findIndex((c) => c.id === id && c.passkeyUserId === passkeyUserId);
+    if (idx === -1) return false;
+    data.credentials.splice(idx, 1);
+    return true;
+  });
+}
+
+/** Public view of a stored credential — never expose the public key or counter. */
+export function toPublicPasskey(c: StoredPasskeyCredential) {
+  return {
+    id: c.id,
+    name: c.name,
+    providerIcon: c.providerIcon,
+    registeredAt: c.registeredAt,
+    lastUsedAt: c.lastUsedAt,
+    synced: c.credentialDeviceType === 'multiDevice',
+  };
+}
+
+export type PublicPasskey = ReturnType<typeof toPublicPasskey>;
diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..cb6fc8a
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,43 @@
+import type { APIContext, AstroGlobal } from 'astro';
+import { getUser, type StoredUser } from './accountStore';
+
+export const RP_NAME = 'The DevTools Times';
+export const MAX_NAME_LENGTH = 64;
+
+type Ctx = Pick<APIContext, 'session' | 'url'> | Pick<AstroGlobal, 'session' | 'url'>;
+
+/** Returns the signed-in reader, or undefined. */
+export async function getCurrentUser(ctx: Ctx): Promise<StoredUser | undefined> {
+  const username = await ctx.session?.get('username');
+  if (typeof username !== 'string') return undefined;
+  return getUser(username);
+}
+
+/**
+ * Relying party configuration. Defaults to the host the request came in on;
+ * override with WEBAUTHN_RP_ID / WEBAUTHN_ORIGIN when behind a proxy that
+ * rewrites the Host header.
+ */
+export function getRelyingParty(ctx: Pick<APIContext, 'url'> | Pick<AstroGlobal, 'url'>) {
+  return {
+    rpID: process.env.WEBAUTHN_RP_ID || ctx.url.hostname,
+    origin: process.env.WEBAUTHN_ORIGIN || ctx.url.origin,
+  };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const unauthorized = () => json({ error: 'Not signed in.' }, 401);
+
+/** Trims and validates a user-supplied label. Returns null when invalid. */
+export function cleanName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const name = value.trim();
+  if (!name || name.length > MAX_NAME_LENGTH) return null;
+  return name;
+}
diff --git a/src/pages/account.astro b/src/pages/account.astro
new file mode 100644
index 0000000..0457f31
--- /dev/null
+++ b/src/pages/account.astro
@@ -0,0 +1,28 @@
+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { getCurrentUser, getRelyingParty } from '../lib/auth';
+import { listCredentials, toPublicPasskey } from '../lib/accountStore';
+
+const user = await getCurrentUser(Astro);
+if (!user) {
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin?next=account`);
+}
+
+const { rpID } = getRelyingParty(Astro);
+const passkeys = (await listCredentials(user.passkeyUserId)).map(toPublicPasskey);
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings
+      client:load
+      rpId={rpID}
+      userId={user.passkeyUserId}
+      username={user.username}
+      initialDisplayName={user.displayName}
+      initialPasskeys={passkeys}
+    />
+  </div>
+</Layout>
diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..7a23bbd
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { ensureUser } from '../../../lib/accountStore';
+import { json } from '../../../lib/auth';
+
+const LOGIN_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Verifies credentials against the upstream login API server-side and, on
+ * success, establishes a signed-in session so account pages can be served.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_API, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Login service unavailable.' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data.error || 'Unknown error' }, upstream.status);
+  }
+
+  const user = await ensureUser(username);
+  // Fresh session ID on privilege change to prevent session fixation.
+  await session?.regenerate();
+  session?.set('username', user.username);
+  return json({ username: user.username, displayName: user.displayName });
+};
