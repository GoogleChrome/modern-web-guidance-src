@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { listCredentials } from '../../../lib/accountStore';
+import { getCurrentUser, getRelyingParty, json, RP_NAME, unauthorized } from '../../../lib/auth';
+
+export const POST: APIRoute = async (ctx) => {
+  const user = await getCurrentUser(ctx);
+  if (!user) return unauthorized();
+
+  const { rpID } = getRelyingParty(ctx);
+  const existing = await listCredentials(user.passkeyUserId);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: isoBase64URL.toBuffer(user.passkeyUserId),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    // Prevent registering a second passkey on the same provider account.
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports })),
+    // Management flow: no authenticatorAttachment so security keys are allowed too.
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+  });
+
+  ctx.session?.set('passkeyRegistrationChallenge', options.challenge);
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..7704cf3
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,65 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { addCredential, toPublicPasskey } from '../../../lib/accountStore';
+import { lookupProvider } from '../../../lib/aaguid';
+import { getCurrentUser, getRelyingParty, json, unauthorized } from '../../../lib/auth';
+
+
+export const POST: APIRoute = async (ctx) => {
+  const user = await getCurrentUser(ctx);
+  if (!user) return unauthorized();
+
+  const expectedChallenge = await ctx.session?.get('passkeyRegistrationChallenge');
+  // Challenges are single use.
+  ctx.session?.delete('passkeyRegistrationChallenge');
+  if (typeof expectedChallenge !== 'string') {
+    return json({ error: 'Registration session expired. Please try again.' }, 400);
+  }
+
+  const { rpID, origin } = getRelyingParty(ctx);
+  const body = await ctx.request.json().catch(() => null);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserPresence: true,
+      // Options asked for userVerification: 'preferred'.
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    console.warn('Passkey registration verification failed:', err);
+    return json({ error: 'Passkey could not be verified.' }, 400);
+  }
+
+  if (!verification.verified) {
+    return json({ error: 'Passkey could not be verified.' }, 400);
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const provider = await lookupProvider(aaguid);
+
+  try {
+    const stored = await addCredential({
+      id: credential.id,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: isoBase64URL.fromBuffer(credential.publicKey),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon: provider.icon,
+      name: provider.name,
+      transports: credential.transports ?? [],
+      registeredAt: Date.now(),
+      counter: credential.counter,
+    });
+    return json(toPublicPasskey(stored));
+  } catch {
+    return json({ error: 'This passkey is already registered.' }, 409);
+  }
+};
diff --git a/src/pages/api/user.ts b/src/pages/api/user.ts
