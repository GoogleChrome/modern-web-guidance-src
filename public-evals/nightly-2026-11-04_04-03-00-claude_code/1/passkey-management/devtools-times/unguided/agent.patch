+import React, { useState } from 'react';
+
+export default function SignOutButton({ baseUrl, className }: { baseUrl: string; className?: string }) {
+  const [busy, setBusy] = useState(false);
+
+  const signOut = async () => {
+    setBusy(true);
+    try {
+      await fetch(`${baseUrl}api/auth/logout`, { method: 'POST', credentials: 'same-origin' });
+    } finally {
+      window.location.href = baseUrl;
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={signOut}
+      disabled={busy}
+      className={className ?? 'py-2 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 disabled:opacity-75'}
+    >
+      {busy ? 'Signing out…' : 'Sign out'}
+    </button>
+  );
+}
diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..63a3fb3
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,58 @@
+export interface SessionUser {
+  username: string;
+}
+
+type Session = { get: (key: string) => Promise<any> } | undefined;
+
+/** Returns the signed-in reader for this request, or null. */
+export async function getCurrentUser(session: Session): Promise<SessionUser | null> {
+  const user = await session?.get('user');
+  if (user && typeof user.username === 'string' && user.username.length > 0) {
+    return { username: user.username };
+  }
+  return null;
+}
+
+export function json(body: unknown, init: ResponseInit = {}): Response {
+  return new Response(JSON.stringify(body), {
+    ...init,
+    headers: {
+      'Content-Type': 'application/json',
+      'Cache-Control': 'no-store',
+      ...(init.headers ?? {}),
+    },
+  });
+}
+
+export function unauthorized(): Response {
+  return json({ error: 'AUTH_REQUIRED', message: 'You need to be signed in.' }, { status: 401 });
+}
+
+export function forbidden(): Response {
+  return json({ error: 'FORBIDDEN', message: 'Cross-site requests are not allowed.' }, { status: 403 });
+}
+
+/**
+ * Astro's built-in origin check is disabled for this site, so state-changing
+ * account endpoints verify the request came from our own pages.
+ */
+export function isSameOriginRequest(request: Request, url: URL): boolean {
+  const fetchSite = request.headers.get('sec-fetch-site');
+  if (fetchSite) return fetchSite === 'same-origin' || fetchSite === 'none';
+  const origin = request.headers.get('origin');
+  if (!origin) return true; // Non-browser client; session cookie is still required.
+  try {
+    return new URL(origin).host === url.host;
+  } catch {
+    return false;
+  }
+}
+
+export async function readJson(request: Request): Promise<any | null> {
+  if (!request.headers.get('content-type')?.includes('application/json')) return null;
+  try {
+    return await request.json();
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..f1c9873
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,191 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+/**
+ * A passkey registered to a reader's account. Binary values are stored as
+ * base64url strings so the record can be serialised to JSON as-is.
+ */
+export interface StoredPasskey {
+  /** Credential ID (base64url). */
+  id: string;
+  /** COSE public key (base64url). */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid: string;
+  /** Reader-chosen label shown in account settings. */
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+/** The fields that are safe to send to the browser. */
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface UserRecord {
+  /** Stable WebAuthn user handle (base64url). Must never change once passkeys exist. */
+  webauthnUserId: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreShape {
+  users: Record<string, UserRecord>;
+}
+
+export const PASSKEY_NAME_MAX_LENGTH = 64;
+export const MAX_PASSKEYS_PER_USER = 20;
+
+const STORE_FILE = process.env.PASSKEY_STORE_FILE
+  ?? path.join(process.cwd(), '.data', 'passkeys.json');
+
+let cache: StoreShape | null = null;
+// Serialises all mutations so concurrent requests can't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreShape> {
+  if (cache) return cache;
+  try {
+    const raw = await fs.readFile(STORE_FILE, 'utf8');
+    const parsed = JSON.parse(raw);
+    cache = parsed && typeof parsed === 'object' && parsed.users ? parsed : { users: {} };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: {} };
+  }
+  return cache!;
+}
+
+async function persist(store: StoreShape): Promise<void> {
+  await fs.mkdir(path.dirname(STORE_FILE), { recursive: true });
+  const tmp = `${STORE_FILE}.${process.pid}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(store, null, 2), 'utf8');
+  await fs.rename(tmp, STORE_FILE);
+}
+
+function mutate<T>(fn: (store: StoreShape) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await load();
+    const result = await fn(store);
+    await persist(store);
+    return result;
+  });
+  // Keep the chain alive even if this mutation fails.
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+function ensureUser(store: StoreShape, username: string): UserRecord {
+  let user = store.users[username];
+  if (!user) {
+    user = { webauthnUserId: randomBytes(32).toString('base64url'), passkeys: [] };
+    store.users[username] = user;
+  }
+  return user;
+}
+
+export function toPublic(p: StoredPasskey): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    transports: p.transports,
+    deviceType: p.deviceType,
+    backedUp: p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+/** Trim, collapse whitespace, strip control characters and cap the length. */
+export function sanitizePasskeyName(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const cleaned = input
+    .replace(/[\u0000-\u001f\u007f]/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+  if (cleaned.length === 0 || cleaned.length > PASSKEY_NAME_MAX_LENGTH) return null;
+  return cleaned;
+}
+
+export async function getUserPasskeys(username: string): Promise<{ webauthnUserId: string | null; passkeys: StoredPasskey[] }> {
+  const store = await load();
+  const user = store.users[username];
+  return { webauthnUserId: user?.webauthnUserId ?? null, passkeys: user ? [...user.passkeys] : [] };
+}
+
+/** Returns the user's WebAuthn handle, creating one on first use. */
+export function getOrCreateWebauthnUserId(username: string): Promise<string> {
+  return mutate((store) => ensureUser(store, username).webauthnUserId);
+}
+
+export function addPasskey(username: string, passkey: StoredPasskey): Promise<StoredPasskey[]> {
+  return mutate((store) => {
+    const user = ensureUser(store, username);
+    const taken = Object.values(store.users).some((u) => u.passkeys.some((p) => p.id === passkey.id));
+    if (taken) throw new PasskeyError('ALREADY_REGISTERED', 'This passkey is already registered.', 409);
+    if (user.passkeys.length >= MAX_PASSKEYS_PER_USER) {
+      throw new PasskeyError('LIMIT_REACHED', `You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.`, 400);
+    }
+    user.passkeys.push(passkey);
+    return [...user.passkeys];
+  });
+}
+
+export function renamePasskey(username: string, id: string, name: string): Promise<StoredPasskey> {
+  return mutate((store) => {
+    const passkey = store.users[username]?.passkeys.find((p) => p.id === id);
+    if (!passkey) throw new PasskeyError('NOT_FOUND', 'Passkey not found.', 404);
+    passkey.name = name;
+    return { ...passkey };
+  });
+}
+
+export function deletePasskey(username: string, id: string): Promise<StoredPasskey[]> {
+  return mutate((store) => {
+    const user = store.users[username];
+    const index = user?.passkeys.findIndex((p) => p.id === id) ?? -1;
+    if (!user || index === -1) throw new PasskeyError('NOT_FOUND', 'Passkey not found.', 404);
+    user.passkeys.splice(index, 1);
+    return [...user.passkeys];
+  });
+}
+
+export class PasskeyError extends Error {
+  code: string;
+  status: number;
+  constructor(code: string, message: string, status: number) {
+    super(message);
+    this.code = code;
+    this.status = status;
+  }
+}
+
+/**
+ * Relying party settings. Defaults to the host the request came in on;
+ * override with PASSKEY_RP_ID / PASSKEY_ORIGIN when running behind a proxy.
+ */
+export function getRelyingParty(url: URL): { rpID: string; rpName: string; origins: string[] } {
+  const rpID = process.env.PASSKEY_RP_ID || url.hostname;
+  const configured = process.env.PASSKEY_ORIGIN?.split(',').map((o) => o.trim()).filter(Boolean);
+  const origins = configured?.length
+    ? configured
+    : [...new Set([url.origin, `https://${url.host}`])];
+  return { rpID, rpName: 'The DevTools Times', origins };
+}
+
+/** Payload the browser needs to keep its authenticators in sync via the WebAuthn Signal API. */
+export function syncPayload(rpID: string, username: string, webauthnUserId: string | null, passkeys: StoredPasskey[]) {
+  return webauthnUserId
+    ? { rpID, userID: webauthnUserId, userName: username, credentialIds: passkeys.map((p) => p.id) }
+    : null;
+}
