@@ -0,0 +1,41 @@
+import type { APIRoute } from 'astro';
+import { forbidden, isSameOriginRequest, json, readJson } from '../../../lib/auth';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Proxies the sign-in request to the auth service and, on success, records the
+ * reader in the server-side session so account pages know who is signed in.
+ * The upstream status and body are passed through unchanged.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+
+  const body = await readJson(request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) {
+    return json({ error: 'APP_ERR_2000', message: 'Username and password are required.' }, { status: 400 });
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'APP_ERR_5000', message: 'The sign-in service is unavailable.' }, { status: 502 });
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+
+  if (upstream.ok && session) {
+    // New session ID on privilege change to prevent session fixation.
+    await session.regenerate();
+    session.set('user', { username });
+  }
+
+  return json(data, { status: upstream.status });
+};
