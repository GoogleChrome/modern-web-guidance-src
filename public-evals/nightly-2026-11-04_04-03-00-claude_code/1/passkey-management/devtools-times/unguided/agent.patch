index 0000000..a9959d8
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,476 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { browserSupportsWebAuthn, sendSignal, startRegistration, WebAuthnError } from '@simplewebauthn/browser';
+import {
+  CheckIcon,
+  KeyIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface SyncPayload {
+  rpID: string;
+  userID: string;
+  userName: string;
+  credentialIds: string[];
+}
+
+interface Props {
+  baseUrl: string;
+}
+
+type Notice = { kind: 'success' | 'error' | 'info'; text: string } | null;
+
+const NAME_MAX_LENGTH = 64;
+
+/** Best-effort label for a passkey created on this device, e.g. "Chrome on macOS". */
+function suggestPasskeyName(): string {
+  if (typeof navigator === 'undefined') return 'My passkey';
+  const ua = navigator.userAgent;
+  const browser =
+    /Edg\//.test(ua) ? 'Edge'
+    : /OPR\//.test(ua) ? 'Opera'
+    : /Firefox\//.test(ua) ? 'Firefox'
+    : /Chrome\//.test(ua) ? 'Chrome'
+    : /Safari\//.test(ua) ? 'Safari'
+    : 'Browser';
+  const os =
+    /iPhone|iPad|iPod/.test(ua) ? 'iOS'
+    : /Android/.test(ua) ? 'Android'
+    : /Mac OS X/.test(ua) ? 'macOS'
+    : /Windows/.test(ua) ? 'Windows'
+    : /CrOS/.test(ua) ? 'ChromeOS'
+    : /Linux/.test(ua) ? 'Linux'
+    : '';
+  return os ? `${browser} on ${os}` : browser;
+}
+
+function formatDate(iso: string | null): string {
+  if (!iso) return 'Never';
+  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+function supportsSignal(name: 'signalAllAcceptedCredentials' | 'signalCurrentUserDetails'): boolean {
+  return typeof window !== 'undefined'
+    && typeof (window.PublicKeyCredential as any)?.[name] === 'function';
+}
+
+/**
+ * Tell the browser which passkeys the server still accepts for this account so
+ * its password manager / authenticator can hide or delete stale ones, and
+ * refresh the account name shown in passkey pickers. Fire-and-forget: the
+ * server is the source of truth, so failures here never block the UI.
+ * Returns whether the credential-list signal was delivered to the browser.
+ */
+async function syncAuthenticator(sync: SyncPayload | null): Promise<boolean> {
+  if (!sync) return false;
+  let delivered = false;
+  if (supportsSignal('signalAllAcceptedCredentials')) {
+    try {
+      await sendSignal({
+        signalName: 'allAcceptedCredentials',
+        rpID: sync.rpID,
+        userID: sync.userID,
+        allAcceptedCredentialIDs: sync.credentialIds,
+      });
+      delivered = true;
+    } catch (err) {
+      console.warn('[passkeys] allAcceptedCredentials signal failed', err);
+    }
+  }
+  if (supportsSignal('signalCurrentUserDetails')) {
+    try {
+      await sendSignal({
+        signalName: 'currentUserDetails',
+        rpID: sync.rpID,
+        userID: sync.userID,
+        userName: sync.userName,
+        userDisplayName: sync.userName,
+      });
+    } catch (err) {
+      console.warn('[passkeys] currentUserDetails signal failed', err);
+    }
+  }
+  return delivered;
+}
+
+async function api<T>(url: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(url, {
+    ...init,
+    credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    const error = new Error(data.message || 'Something went wrong. Please try again.') as Error & { status?: number };
+    error.status = response.status;
+    throw error;
+  }
+  return data as T;
+}
+
+export default function PasskeyManager({ baseUrl }: Props) {
+  const apiBase = `${baseUrl}api/passkeys`;
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [webauthnSupported, setWebauthnSupported] = useState(true);
+  const [adding, setAdding] = useState(false);
+  const [newName, setNewName] = useState('');
+  const [registering, setRegistering] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [confirmDelete, setConfirmDelete] = useState<Passkey | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  const handleAuthError = useCallback((err: unknown) => {
+    if ((err as any)?.status === 401) {
+      window.location.href = `${baseUrl}signin?next=${encodeURIComponent(`${baseUrl}account`)}`;
+      return true;
+    }
+    return false;
+  }, [baseUrl]);
+
+  useEffect(() => {
+    setWebauthnSupported(browserSupportsWebAuthn());
+    let cancelled = false;
+    (async () => {
+      try {
+        const data = await api<{ passkeys: Passkey[]; sync: SyncPayload | null }>(apiBase);
+        if (cancelled) return;
+        setPasskeys(data.passkeys);
+        // Reconcile on every visit, so keys removed elsewhere (another device,
+        // another browser) also disappear from this browser's passkey list.
+        void syncAuthenticator(data.sync);
+      } catch (err) {
+        if (!cancelled && !handleAuthError(err)) {
+          setNotice({ kind: 'error', text: (err as Error).message });
+        }
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [apiBase, handleAuthError]);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (confirmDelete && !dialog.open) dialog.showModal();
+    if (!confirmDelete && dialog.open) dialog.close();
+  }, [confirmDelete]);
+
+  const openAddForm = () => {
+    setNotice(null);
+    setNewName(suggestPasskeyName());
+    setAdding(true);
+  };
+
+  const handleRegister = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setNotice(null);
+    setRegistering(true);
+    try {
+      const optionsJSON = await api<any>(`${apiBase}/register-options`, { method: 'POST', body: '{}' });
+      const response = await startRegistration({ optionsJSON });
+      const data = await api<{ passkey: Passkey; passkeys: Passkey[]; sync: SyncPayload | null }>(
+        `${apiBase}/register-verify`,
+        { method: 'POST', body: JSON.stringify({ response, name: newName }) },
+      );
+      setPasskeys(data.passkeys);
+      setAdding(false);
+      setNotice({ kind: 'success', text: `“${data.passkey.name}” was added to your account.` });
+      void syncAuthenticator(data.sync);
+    } catch (err) {
+      if (handleAuthError(err)) return;
+      let text = (err as Error).message;
+      if (err instanceof WebAuthnError) {
+        text = err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED'
+          ? 'This device already has a passkey for your account.'
+          : err.name === 'NotAllowedError'
+            ? 'Passkey creation was cancelled or timed out.'
+            : err.message;
+      } else if ((err as Error)?.name === 'NotAllowedError') {
+        text = 'Passkey creation was cancelled or timed out.';
+      }
+      setNotice({ kind: 'error', text });
+    } finally {
+      setRegistering(false);
+    }
+  };
+
+  const startEditing = (passkey: Passkey) => {
+    setNotice(null);
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    const name = editName.trim();
+    if (!name || name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    setBusyId(passkey.id);
+    setNotice(null);
+    try {
+      const data = await api<{ passkey: Passkey; sync: SyncPayload | null }>(
+        `${apiBase}/${encodeURIComponent(passkey.id)}`,
+        { method: 'PATCH', body: JSON.stringify({ name }) },
+      );
+      setPasskeys((list) => list.map((p) => (p.id === passkey.id ? data.passkey : p)));
+      setEditingId(null);
+      setNotice({ kind: 'success', text: `Passkey renamed to “${data.passkey.name}”.` });
+      void syncAuthenticator(data.sync);
+    } catch (err) {
+      if (!handleAuthError(err)) setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleDelete = async () => {
+    const passkey = confirmDelete;
+    if (!passkey) return;
+    setBusyId(passkey.id);
+    setNotice(null);
+    try {
+      const data = await api<{ passkeys: Passkey[]; sync: SyncPayload | null }>(
+        `${apiBase}/${encodeURIComponent(passkey.id)}`,
+        { method: 'DELETE' },
+      );
+      setPasskeys(data.passkeys);
+      setConfirmDelete(null);
+      // Only signal after the server has committed the removal, using the
+      // server's list — never optimistic client state.
+      const synced = await syncAuthenticator(data.sync);
+      setNotice({
+        kind: 'success',
+        text: synced
+          ? `“${passkey.name}” was removed. Your browser has been asked to remove it from its saved passkeys too.`
+          : `“${passkey.name}” was removed. Your browser can't update its saved passkeys automatically, so you may also want to delete it from your password manager.`,
+      });
+    } catch (err) {
+      setConfirmDelete(null);
+      if (!handleAuthError(err)) setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const noticeStyles = {
+    success: 'text-green-800 bg-green-50 border-green-200',
+    error: 'text-red-800 bg-red-50 border-red-200',
+    info: 'text-gray-800 bg-gray-50 border-gray-200',
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="border border-gray-200 rounded-lg bg-white">
+      <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 p-6 border-b border-gray-200">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">Passkeys</h2>
+          <p className="mt-1 text-sm text-gray-600 max-w-prose">
+            Passkeys let you sign in with your fingerprint, face, screen lock or a security key instead of a password.
+            Give each one a name you'll recognise and remove any you no longer use.
+          </p>
+        </div>
+        {!adding && (
+          <button
+            type="button"
+            onClick={openAddForm}
+            disabled={!webauthnSupported || loading}
+            className="inline-flex items-center justify-center gap-1.5 shrink-0 py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            <PlusIcon className="w-4 h-4" aria-hidden="true" />
+            Add a passkey
+          </button>
+        )}
+      </div>
+
+      <div className="p-6 space-y-4">
+        {!webauthnSupported && (
+          <p className="p-3 text-sm rounded-md border text-amber-800 bg-amber-50 border-amber-200">
+            This browser doesn't support passkeys. You can still rename or remove existing passkeys here.
+          </p>
+        )}
+
+        {notice && (
+          <div
+            role={notice.kind === 'error' ? 'alert' : 'status'}
+            className={`flex items-start justify-between gap-3 p-3 text-sm rounded-md border ${noticeStyles[notice.kind]}`}
+          >
+            <span>{notice.text}</span>
+            <button type="button" onClick={() => setNotice(null)} aria-label="Dismiss message" className="shrink-0">
+              <XMarkIcon className="w-4 h-4" aria-hidden="true" />
+            </button>
+          </div>
+        )}
+
+        {adding && (
+          <form onSubmit={handleRegister} className="p-4 rounded-md border border-gray-200 bg-gray-50 space-y-3">
+            <label htmlFor="new-passkey-name" className="block text-sm font-medium text-gray-700">
+              Passkey name
+            </label>
+            <input
+              id="new-passkey-name"
+              type="text"
+              value={newName}
+              onChange={(e) => setNewName(e.target.value)}
+              maxLength={NAME_MAX_LENGTH}
+              required
+              autoFocus
+              className="w-full px-3 py-2 border border-gray-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <p className="text-xs text-gray-500">
+              Your browser will ask you to confirm with your device's screen lock or a security key.
+            </p>
+            <div className="flex gap-2">
+              <button
+                type="submit"
+                disabled={registering}
+                className="py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75 disabled:cursor-not-allowed"
+              >
+                {registering ? 'Waiting for your device…' : 'Create passkey'}
+              </button>
+              <button
+                type="button"
+                onClick={() => setAdding(false)}
+                disabled={registering}
+                className="py-2 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+            </div>
+          </form>
+        )}
+
+        {loading ? (
+          <p className="text-sm text-gray-500" aria-live="polite">Loading your passkeys…</p>
+        ) : passkeys.length === 0 ? (
+          <div className="text-center py-8 text-gray-500">
+            <KeyIcon className="w-10 h-10 mx-auto mb-2 text-gray-300" aria-hidden="true" />
+            <p className="text-sm">You haven't registered any passkeys yet.</p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {passkeys.map((passkey) => {
+              const isEditing = editingId === passkey.id;
+              const isBusy = busyId === passkey.id;
+              return (
+                <li key={passkey.id} className="flex flex-col sm:flex-row sm:items-center gap-3 p-4">
+                  <KeyIcon className="hidden sm:block w-6 h-6 text-gray-400 shrink-0" aria-hidden="true" />
+                  <div className="flex-1 min-w-0">
+                    {isEditing ? (
+                      <form onSubmit={(e) => handleRename(e, passkey)} className="flex items-center gap-2">
+                        <label htmlFor={`rename-${passkey.id}`} className="sr-only">Passkey name</label>
+                        <input
+                          id={`rename-${passkey.id}`}
+                          type="text"
+                          value={editName}
+                          onChange={(e) => setEditName(e.target.value)}
+                          onKeyDown={(e) => { if (e.key === 'Escape') setEditingId(null); }}
+                          maxLength={NAME_MAX_LENGTH}
+                          required
+                          autoFocus
+                          disabled={isBusy}
+                          className="flex-1 min-w-0 px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                        />
+                        <button type="submit" disabled={isBusy} aria-label="Save name" className="p-1.5 rounded-md text-green-700 hover:bg-green-50">
+                          <CheckIcon className="w-5 h-5" aria-hidden="true" />
+                        </button>
+                        <button type="button" onClick={() => setEditingId(null)} disabled={isBusy} aria-label="Cancel renaming" className="p-1.5 rounded-md text-gray-500 hover:bg-gray-100">
+                          <XMarkIcon className="w-5 h-5" aria-hidden="true" />
+                        </button>
+                      </form>
+                    ) : (
+                      <p className="font-medium text-gray-900 truncate">{passkey.name}</p>
+                    )}
+                    <p className="mt-1 text-xs text-gray-500 flex flex-wrap gap-x-3 gap-y-1">
+                      <span>Added {formatDate(passkey.createdAt)}</span>
+                      <span>Last used {formatDate(passkey.lastUsedAt)}</span>
+                      <span className="inline-flex items-center rounded-full bg-gray-100 px-2 text-gray-700">
+                        {passkey.backedUp ? 'Synced' : passkey.deviceType === 'multiDevice' ? 'Syncable' : 'This device only'}
+                      </span>
+                    </p>
+                  </div>
+                  {!isEditing && (
+                    <div className="flex gap-2 shrink-0">
+                      <button
+                        type="button"
+                        onClick={() => startEditing(passkey)}
+                        disabled={isBusy}
+                        aria-label={`Rename ${passkey.name}`}
+                        className="inline-flex items-center gap-1 py-1.5 px-2.5 rounded-md text-sm text-gray-700 border border-gray-300 hover:bg-gray-50 disabled:opacity-50"
+                      >
+                        <PencilSquareIcon className="w-4 h-4" aria-hidden="true" />
+                        Rename
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => { setNotice(null); setConfirmDelete(passkey); }}
+                        disabled={isBusy}
+                        aria-label={`Remove ${passkey.name}`}
+                        className="inline-flex items-center gap-1 py-1.5 px-2.5 rounded-md text-sm text-red-700 border border-red-200 hover:bg-red-50 disabled:opacity-50"
+                      >
+                        <TrashIcon className="w-4 h-4" aria-hidden="true" />
+                        Remove
+                      </button>
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </div>
+
+      <dialog
+        ref={dialogRef}
+        onClose={() => setConfirmDelete(null)}
+        aria-labelledby="remove-passkey-title"
+        className="m-auto max-w-md w-[calc(100%-2rem)] rounded-lg p-0 backdrop:bg-black/40"
+      >
+        {confirmDelete && (
+          <div className="p-6">
+            <h3 id="remove-passkey-title" className="text-lg font-bold text-gray-900">Remove this passkey?</h3>
+            <p className="mt-2 text-sm text-gray-600">
+              You will no longer be able to sign in with <strong>“{confirmDelete.name}”</strong>.
+              {passkeys.length === 1 && ' This is your last passkey, so you will need your password to sign in.'}
+            </p>
+            <div className="mt-6 flex justify-end gap-2">
+              <button
+                type="button"
+                onClick={() => setConfirmDelete(null)}
+                disabled={busyId === confirmDelete.id}
+                className="py-2 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+              <button
+                type="button"
+                onClick={handleDelete}
+                disabled={busyId === confirmDelete.id}
+                className="py-2 px-3 rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-75"
+              >
+                {busyId === confirmDelete.id ? 'Removing…' : 'Remove passkey'}
+              </button>
+            </div>
+          </div>
+        )}
+      </dialog>
+    </section>
+  );
+}
