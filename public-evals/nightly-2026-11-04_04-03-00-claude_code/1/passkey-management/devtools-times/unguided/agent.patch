+import { forbidden, isSameOriginRequest, json } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+  if (session) {
+    session.delete('user');
+    session.delete('passkeyRegistration');
+    await session.regenerate();
+  }
+  return json({ ok: true });
+};
