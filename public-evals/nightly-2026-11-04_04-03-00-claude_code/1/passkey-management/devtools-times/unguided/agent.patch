@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { forbidden, getCurrentUser, isSameOriginRequest, json, unauthorized } from '../../../lib/auth';
+import {
+  MAX_PASSKEYS_PER_USER,
+  getOrCreateWebauthnUserId,
+  getRelyingParty,
+  getUserPasskeys,
+} from '../../../lib/passkeys';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+  const user = await getCurrentUser(session);
+  if (!user || !session) return unauthorized();
+
+  const { passkeys } = await getUserPasskeys(user.username);
+  if (passkeys.length >= MAX_PASSKEYS_PER_USER) {
+    return json(
+      { error: 'LIMIT_REACHED', message: `You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.` },
+      { status: 400 },
+    );
+  }
+
+  const { rpID, rpName } = getRelyingParty(url);
+  const webauthnUserId = await getOrCreateWebauthnUserId(user.username);
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userName: user.username,
+    userDisplayName: user.username,
+    userID: isoBase64URL.toBuffer(webauthnUserId),
+    attestationType: 'none',
+    // Stops the browser from creating a second passkey on an authenticator that already has one.
+    excludeCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+
+  session.set('passkeyRegistration', {
+    challenge: options.challenge,
+    rpID,
+    expiresAt: Date.now() + CHALLENGE_TTL_MS,
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..2f782ba
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,84 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { forbidden, getCurrentUser, isSameOriginRequest, json, readJson, unauthorized } from '../../../lib/auth';
+import {
+  PasskeyError,
+  addPasskey,
+  getRelyingParty,
+  getUserPasskeys,
+  sanitizePasskeyName,
+  syncPayload,
+  toPublic,
+} from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+  const user = await getCurrentUser(session);
+  if (!user || !session) return unauthorized();
+
+  const body = await readJson(request);
+  if (!body?.response) {
+    return json({ error: 'BAD_REQUEST', message: 'Missing registration response.' }, { status: 400 });
+  }
+
+  // Challenges are single-use: consume it before verifying.
+  const pending = await session.get('passkeyRegistration');
+  session.delete('passkeyRegistration');
+  if (!pending?.challenge || typeof pending.expiresAt !== 'number' || pending.expiresAt < Date.now()) {
+    return json(
+      { error: 'CHALLENGE_EXPIRED', message: 'The registration request expired. Please try again.' },
+      { status: 400 },
+    );
+  }
+
+  const { origins } = getRelyingParty(url);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: pending.rpID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json(
+      { error: 'VERIFICATION_FAILED', message: err instanceof Error ? err.message : 'Passkey verification failed.' },
+      { status: 400 },
+    );
+  }
+
+  if (!verification.verified) {
+    return json({ error: 'VERIFICATION_FAILED', message: 'Passkey verification failed.' }, { status: 400 });
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = verification.registrationInfo;
+  const { passkeys: existing, webauthnUserId } = await getUserPasskeys(user.username);
+  const name = sanitizePasskeyName(body.name) ?? `Passkey ${existing.length + 1}`;
+  const now = new Date().toISOString();
+
+  try {
+    const passkeys = await addPasskey(user.username, {
+      id: credential.id,
+      publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+      counter: credential.counter,
+      transports: credential.transports ?? body.response?.response?.transports ?? [],
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      aaguid,
+      name,
+      createdAt: now,
+      lastUsedAt: null,
+    });
+    return json({
+      passkey: toPublic(passkeys[passkeys.length - 1]),
+      passkeys: passkeys.map(toPublic),
+      sync: syncPayload(pending.rpID, user.username, webauthnUserId, passkeys),
+    });
+  } catch (err) {
+    if (err instanceof PasskeyError) return json({ error: err.code, message: err.message }, { status: err.status });
+    throw err;
+  }
+};
