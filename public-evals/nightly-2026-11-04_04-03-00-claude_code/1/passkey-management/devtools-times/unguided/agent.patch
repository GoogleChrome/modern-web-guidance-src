new file mode 100644
index 0000000..a8b9321
--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,63 @@
+import type { APIRoute } from 'astro';
+import { forbidden, getCurrentUser, isSameOriginRequest, json, readJson, unauthorized } from '../../../lib/auth';
+import {
+  PASSKEY_NAME_MAX_LENGTH,
+  PasskeyError,
+  deletePasskey,
+  getRelyingParty,
+  getUserPasskeys,
+  renamePasskey,
+  sanitizePasskeyName,
+  syncPayload,
+  toPublic,
+} from '../../../lib/passkeys';
+
+function handleError(err: unknown): Response {
+  if (err instanceof PasskeyError) return json({ error: err.code, message: err.message }, { status: err.status });
+  throw err;
+}
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async ({ params, request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  const body = await readJson(request);
+  const name = sanitizePasskeyName(body?.name);
+  if (!name) {
+    return json(
+      { error: 'INVALID_NAME', message: `Name must be 1–${PASSKEY_NAME_MAX_LENGTH} characters.` },
+      { status: 400 },
+    );
+  }
+
+  try {
+    const passkey = await renamePasskey(user.username, params.id!, name);
+    const { rpID } = getRelyingParty(url);
+    const { webauthnUserId, passkeys } = await getUserPasskeys(user.username);
+    return json({ passkey: toPublic(passkey), sync: syncPayload(rpID, user.username, webauthnUserId, passkeys) });
+  } catch (err) {
+    return handleError(err);
+  }
+};
+
+/** Remove a passkey. The response carries the remaining credential IDs so the browser can sync. */
+export const DELETE: APIRoute = async ({ params, request, session, url }) => {
+  if (!isSameOriginRequest(request, url)) return forbidden();
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  try {
+    const passkeys = await deletePasskey(user.username, params.id!);
+    const { rpID } = getRelyingParty(url);
+    const { webauthnUserId } = await getUserPasskeys(user.username);
+    return json({
+      removedId: params.id,
+      passkeys: passkeys.map(toPublic),
+      sync: syncPayload(rpID, user.username, webauthnUserId, passkeys),
+    });
+  } catch (err) {
+    return handleError(err);
+  }
+};
