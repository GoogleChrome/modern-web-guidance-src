+      if (err.status === 404) {
+        await handleVanished(id, els.renameDialog);
+      } else {
+        els.renameError.textContent = err.message;
+        setBusy(els.renameSubmit, false, 'Save');
+      }
+    }
+  });
+
+  // ---------------------------------------------------------------------------
+  // Delete
+  // ---------------------------------------------------------------------------
+
+  function openDelete(id, trigger) {
+    const p = findPasskey(id);
+    if (!p) return;
+    els.deleteName.textContent = p.name || 'This passkey';
+    els.deleteError.textContent = '';
+    els.deleteCurrentWarning.hidden = !p.current;
+    els.deleteLastWarning.hidden = state.passkeys.length !== 1;
+    setBusy(els.deleteSubmit, false, 'Remove passkey');
+    openDialog(els.deleteDialog, id, trigger);
+    // Default focus on the safe action.
+    els.deleteDialog.querySelector('[data-close]').focus();
+  }
+
+  els.deleteForm.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const id = state.activeId;
+    const p = findPasskey(id);
+    if (!p) return closeDialog(els.deleteDialog);
+
+    setBusy(els.deleteSubmit, true, 'Removing…');
+    els.deleteError.textContent = '';
+    try {
+      await api(encodeId(id), { method: 'DELETE' });
+      removeLocal(id);
+      closeDialog(els.deleteDialog);
+      showStatus(`“${p.name || 'Passkey'}” was removed.`);
+    } catch (err) {
+      if (err.status === 404) {
+        await handleVanished(id, els.deleteDialog);
+      } else {
+        els.deleteError.textContent = err.message;
+        setBusy(els.deleteSubmit, false, 'Remove passkey');
+      }
+    }
+  });
+
+  function removeLocal(id) {
+    state.passkeys = state.passkeys.filter((p) => p.id !== id);
+    render();
