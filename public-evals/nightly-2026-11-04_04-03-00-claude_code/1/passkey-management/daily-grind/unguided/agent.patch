index 0000000..d72cf51
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,458 @@
+/*
+ * My Account → Passkey management
+ *
+ * Expected backend contract (all same-origin, cookie-authenticated, JSON):
+ *
+ *   GET    /api/account/passkeys
+ *     200 → {
+ *       rpId: "dailygrind.example",
+ *       user: { id: "<base64url user handle>", name: "jane@example.com", displayName: "Jane" },
+ *       passkeys: [{
+ *         id: "<base64url credential ID>",
+ *         name: "MacBook Air",
+ *         createdAt: "2026-01-02T10:00:00Z",
+ *         lastUsedAt: "2026-10-30T08:12:00Z" | null,
+ *         provider: "iCloud Keychain" | null,   // e.g. resolved from the AAGUID
+ *         backedUp: true,                        // BS flag (synced passkey)
+ *         current: false                         // used for this session's sign-in
+ *       }]
+ *     }
+ *   PATCH  /api/account/passkeys/:id   body { name }  → 200 { passkey }
+ *   DELETE /api/account/passkeys/:id                  → 204
+ *
+ *   401 on any call → user is redirected to /login.
+ *
+ * Browser sync uses the WebAuthn Signal API (where supported) so the user's
+ * authenticator / password manager drops credentials the server no longer
+ * accepts and shows up-to-date account details.
+ */
+(() => {
+  'use strict';
+
+  const API_BASE = '/api/account/passkeys';
+  const MAX_NAME_LENGTH = 64;
+
+  const els = {
+    greeting: document.getElementById('greeting'),
+    region: document.getElementById('passkeys-region'),
+    status: document.getElementById('status'),
+    renameDialog: document.getElementById('rename-dialog'),
+    renameForm: document.getElementById('rename-form'),
+    renameInput: document.getElementById('rename-input'),
+    renameError: document.getElementById('rename-error'),
+    renameSubmit: document.getElementById('rename-submit'),
+    deleteDialog: document.getElementById('delete-dialog'),
+    deleteForm: document.getElementById('delete-form'),
+    deleteName: document.getElementById('delete-name'),
+    deleteError: document.getElementById('delete-error'),
+    deleteSubmit: document.getElementById('delete-submit'),
+    deleteCurrentWarning: document.getElementById('delete-current-warning'),
+    deleteLastWarning: document.getElementById('delete-last-warning'),
+  };
+
+  const state = {
+    rpId: null,
+    user: null,
+    passkeys: [],
+    activeId: null,      // passkey targeted by an open dialog
+    returnFocus: null,   // element to refocus after a dialog closes
+  };
+
+  // ---------------------------------------------------------------------------
+  // API helpers
+  // ---------------------------------------------------------------------------
+
+  class ApiError extends Error {
+    constructor(message, status) {
+      super(message);
+      this.status = status;
+    }
+  }
+
+  function csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]');
+    return meta ? meta.content : null;
+  }
+
+  async function api(path, { method = 'GET', body } = {}) {
+    const headers = { Accept: 'application/json' };
+    if (body !== undefined) headers['Content-Type'] = 'application/json';
+    if (method !== 'GET') {
+      // Custom header forces a CORS preflight for cross-site requests.
+      headers['X-Requested-With'] = 'fetch';
+      const token = csrfToken();
+      if (token) headers['X-CSRF-Token'] = token;
+    }
+
+    let res;
+    try {
+      res = await fetch(API_BASE + path, {
+        method,
+        headers,
+        credentials: 'same-origin',
+        cache: 'no-store',
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+    } catch {
+      throw new ApiError('We couldn’t reach the server. Check your connection and try again.', 0);
+    }
+
+    if (res.status === 401) {
+      window.location.assign('/login?next=' + encodeURIComponent('/account'));
+      throw new ApiError('Your session has expired. Please sign in again.', 401);
+    }
+
+    let data = null;
+    if (res.status !== 204) {
+      try { data = await res.json(); } catch { /* non-JSON body */ }
+    }
+
+    if (!res.ok) {
+      const msg = (data && typeof data.error === 'string' && data.error) ||
+        (res.status === 404 ? 'That passkey no longer exists.' : 'Something went wrong. Please try again.');
+      throw new ApiError(msg, res.status);
+    }
+    return data;
+  }
+
+  const encodeId = (id) => '/' + encodeURIComponent(id);
+
+  // ---------------------------------------------------------------------------
+  // WebAuthn Signal API — keep the browser's authenticator in sync
+  // ---------------------------------------------------------------------------
+
+  const PKC = window.PublicKeyCredential;
+
+  async function signalAcceptedCredentials() {
+    if (!PKC || typeof PKC.signalAllAcceptedCredentials !== 'function') return;
+    if (!state.rpId || !state.user || !state.user.id) return;
+    try {
+      await PKC.signalAllAcceptedCredentials({
+        rpId: state.rpId,
+        userId: state.user.id,
+        allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+      });
+    } catch (err) {
+      // Non-fatal: the server is the source of truth.
+      console.warn('signalAllAcceptedCredentials failed', err);
+    }
+  }
+
+  async function signalUserDetails() {
+    if (!PKC || typeof PKC.signalCurrentUserDetails !== 'function') return;
+    if (!state.rpId || !state.user || !state.user.id || !state.user.name) return;
+    try {
+      await PKC.signalCurrentUserDetails({
+        rpId: state.rpId,
+        userId: state.user.id,
+        name: state.user.name,
+        displayName: state.user.displayName || state.user.name,
+      });
+    } catch (err) {
+      console.warn('signalCurrentUserDetails failed', err);
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Rendering
+  // ---------------------------------------------------------------------------
+
+  const dateFmt = new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+  const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+  function formatDate(iso) {
+    const d = iso ? new Date(iso) : null;
+    return d && !isNaN(d) ? dateFmt.format(d) : null;
+  }
+
+  function formatRelative(iso) {
+    const d = iso ? new Date(iso) : null;
+    if (!d || isNaN(d)) return null;
+    const days = Math.round((d - Date.now()) / 86400000);
+    if (days > -1) return 'today';
+    if (days > -30) return relFmt.format(days, 'day');
+    return formatDate(iso);
+  }
+
+  function el(tag, props = {}, children = []) {
+    const node = document.createElement(tag);
+    for (const [k, v] of Object.entries(props)) {
+      if (k === 'class') node.className = v;
+      else if (k === 'text') node.textContent = v;
+      else if (k === 'dataset') Object.assign(node.dataset, v);
+      else node.setAttribute(k, v);
+    }
+    for (const c of [].concat(children)) if (c) node.append(c);
+    return node;
+  }
+
+  const KEY_ICON_SVG =
+    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' +
+    'stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/>' +
+    '<path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2"/></svg>';
+
+  function renderPasskey(p) {
+    const icon = el('div', { class: 'passkey-icon' });
+    icon.innerHTML = KEY_ICON_SVG; // static, trusted markup
+
+    const nameLine = el('div', { class: 'passkey-name' }, [
+      document.createTextNode(p.name || 'Unnamed passkey'),
+      p.current ? el('span', { class: 'badge badge-current', text: 'This device' }) : null,
+      p.backedUp ? el('span', { class: 'badge badge-synced', text: 'Synced' }) : null,
+    ]);
+
+    const meta = el('div', { class: 'passkey-meta' });
+    if (p.provider) meta.append(el('span', { text: p.provider }));
+    const created = formatDate(p.createdAt);
+    if (created) meta.append(el('span', { text: 'Added ' + created }));
+    const used = formatRelative(p.lastUsedAt);
+    meta.append(el('span', { text: used ? 'Last used ' + used : 'Never used' }));
+
+    const label = p.name || 'Unnamed passkey';
+    const actions = el('div', { class: 'passkey-actions' }, [
+      el('button', {
+        type: 'button', class: 'btn btn-secondary btn-sm',
+        dataset: { action: 'rename', id: p.id }, 'aria-label': 'Rename ' + label,
+      }, 'Rename'),
+      el('button', {
+        type: 'button', class: 'btn btn-danger btn-sm',
