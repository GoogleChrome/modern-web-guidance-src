+      const replacement = target && [...els.region.querySelectorAll('button[data-action]')]
+        .find((b) => b.dataset.action === target.dataset.action && b.dataset.id === target.dataset.id);
+      (replacement || els.region.querySelector('button') || els.status).focus?.();
+    });
+  }
+
+  const findPasskey = (id) => state.passkeys.find((p) => p.id === id);
+
+  // ---------------------------------------------------------------------------
+  // Rename
+  // ---------------------------------------------------------------------------
+
+  function openRename(id, trigger) {
+    const p = findPasskey(id);
+    if (!p) return;
