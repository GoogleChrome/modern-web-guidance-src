+      }, 'Remove'),
+    ]);
+
+    return el('li', { class: 'passkey', dataset: { id: p.id } }, [
+      icon,
+      el('div', { class: 'passkey-body' }, [nameLine, meta]),
+      actions,
+    ]);
+  }
+
+  function render() {
+    els.region.setAttribute('aria-busy', 'false');
+    els.region.replaceChildren();
+
+    if (state.passkeys.length === 0) {
+      els.region.append(el('div', { class: 'state' }, [
+        el('strong', { text: 'No passkeys yet' }),
+        document.createTextNode('You haven’t registered any passkeys for this account.'),
+      ]));
+      return;
+    }
+
+    const list = el('ul', { class: 'passkey-list', 'aria-label': 'Registered passkeys' });
+    // Most recently used first; never-used keys sorted by creation date.
+    const sorted = [...state.passkeys].sort((a, b) =>
+      (Date.parse(b.lastUsedAt || b.createdAt) || 0) - (Date.parse(a.lastUsedAt || a.createdAt) || 0));
+    for (const p of sorted) list.append(renderPasskey(p));
+    els.region.append(list);
+  }
+
+  function renderLoadError(message) {
+    els.region.setAttribute('aria-busy', 'false');
+    const retry = el('button', { type: 'button', class: 'btn btn-secondary' }, 'Try again');
+    retry.addEventListener('click', load);
+    els.region.replaceChildren(el('div', { class: 'state' }, [
+      el('strong', { text: 'We couldn’t load your passkeys' }),
+      document.createTextNode(message),
+      el('div', {}, retry),
+    ]));
+  }
+
+  let statusTimer;
+  function showStatus(message, type = 'success') {
+    clearTimeout(statusTimer);
+    els.status.textContent = message;
+    els.status.className = 'status ' + type;
+    els.status.hidden = false;
+    if (type === 'success') statusTimer = setTimeout(() => { els.status.hidden = true; }, 6000);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Load
+  // ---------------------------------------------------------------------------
+
+  async function load() {
+    els.region.setAttribute('aria-busy', 'true');
+    els.region.replaceChildren(el('div', { class: 'state', text: 'Loading your passkeys…' }));
+    try {
+      const data = await api('');
+      state.rpId = data && data.rpId ? data.rpId : window.location.hostname;
+      state.user = data && data.user ? data.user : null;
+      state.passkeys = Array.isArray(data && data.passkeys) ? data.passkeys : [];
+
+      if (state.user && (state.user.displayName || state.user.name)) {
