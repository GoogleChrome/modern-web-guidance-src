+    // offering it in sign-in prompts.
+    signalAcceptedCredentials();
+  }
+
+  // The passkey was already removed elsewhere (another tab/device).
+  async function handleVanished(id, dialog) {
+    closeDialog(dialog);
+    showStatus('That passkey had already been removed. Your list has been refreshed.', 'error');
+    await load();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Wiring
+  // ---------------------------------------------------------------------------
+
+  function setBusy(button, busy, label) {
+    button.disabled = busy;
+    button.textContent = label;
+  }
+
+  els.region.addEventListener('click', (e) => {
+    const btn = e.target.closest('button[data-action]');
+    if (!btn) return;
+    if (btn.dataset.action === 'rename') openRename(btn.dataset.id, btn);
+    else if (btn.dataset.action === 'delete') openDelete(btn.dataset.id, btn);
+  });
+
+  load();
+})();
