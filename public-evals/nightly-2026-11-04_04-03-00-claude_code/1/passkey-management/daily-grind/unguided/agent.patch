+  }
+
+  function validateName(raw) {
+    const name = raw.replace(/\s+/g, ' ').trim();
+    if (!name) return { error: 'Please enter a name.' };
+    if (name.length > MAX_NAME_LENGTH) return { error: `Use ${MAX_NAME_LENGTH} characters or fewer.` };
+    if (/[\u0000-\u001f\u007f]/.test(name)) return { error: 'The name contains invalid characters.' };
+    return { name };
+  }
+
+  els.renameForm.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const id = state.activeId;
+    const p = findPasskey(id);
+    if (!p) return closeDialog(els.renameDialog);
+
+    const { name, error } = validateName(els.renameInput.value);
+    if (error) {
+      els.renameError.textContent = error;
+      els.renameInput.setAttribute('aria-invalid', 'true');
