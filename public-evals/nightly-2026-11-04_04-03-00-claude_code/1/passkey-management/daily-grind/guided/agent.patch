+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/css/site.css">
+  <link rel="stylesheet" href="/css/account.css">
+  <script type="module" src="/js/passkeys.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="account-hero">
+    <h1>My Account</h1>
+    <p>Manage your profile and how you sign in.</p>
+  </header>
+
+  <main class="container account">
+    <p id="status" class="status" role="status" aria-live="polite"></p>
+
+    <section class="panel" aria-labelledby="profile-heading">
+      <h2 id="profile-heading">Profile</h2>
+      <p class="hint">Changes here are also sent to your password manager so your saved passkeys show the right name.</p>
+      <form id="profile-form" class="profile-form">
+        <label>
+          Email / username
+          <input name="name" type="email" autocomplete="username" required>
+        </label>
+        <label>
+          Display name
+          <input name="displayName" type="text" autocomplete="name" required maxlength="64">
+        </label>
+        <button type="submit" class="btn">Save profile</button>
+      </form>
+    </section>
+
+    <section class="panel" aria-labelledby="passkeys-heading">
+      <div class="panel-header">
+        <h2 id="passkeys-heading">Passkeys</h2>
+        <button type="button" id="create-passkey" class="btn" hidden>Create a passkey</button>
+      </div>
+      <p class="hint">Passkeys let you sign in with your fingerprint, face, screen lock, or a security key — no password needed.</p>
+      <p id="passkey-unsupported" class="notice" hidden>
+        This browser doesn't support passkeys. You can still protect your account by
+        <a href="/account/security">turning on two-step verification</a>.
+      </p>
+
+      <ul id="passkey-list" class="passkey-list" aria-busy="true"></ul>
+      <p id="passkey-empty" class="empty" hidden>No passkeys found. Create one to sign in faster next time.</p>
+    </section>
+  </main>
+
+  <template id="passkey-row">
+    <li class="passkey">
+      <img class="passkey-icon" alt="" width="40" height="40">
+      <div class="passkey-info">
+        <strong class="passkey-name"></strong>
+        <span class="passkey-meta">
+          <span class="passkey-created"></span>
+          <span class="passkey-used"></span>
+          <span class="passkey-synced" hidden>Synced</span>
+        </span>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn-secondary" data-action="rename">Rename</button>
+        <button type="button" class="btn-danger" data-action="delete">Delete</button>
+      </div>
+    </li>
+  </template>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title">
+    <form method="dialog">
+      <h3 id="rename-title">Rename passkey</h3>
+      <label>
+        Passkey name
+        <input name="name" type="text" required maxlength="64" autocomplete="off">
+      </label>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn-secondary" formnovalidate>Cancel</button>
+        <button type="submit" value="save" class="btn">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="delete-dialog" aria-labelledby="delete-title">
+    <form method="dialog">
+      <h3 id="delete-title">Delete passkey?</h3>
+      <p>You won't be able to sign in with <strong class="delete-name"></strong> anymore. We'll also ask your password manager to remove it.</p>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn-secondary">Cancel</button>
+        <button type="submit" value="delete" class="btn-danger">Delete</button>
+      </div>
+    </form>
+  </dialog>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/css/account.css b/css/account.css
new file mode 100644
index 0000000..1233742
--- /dev/null
+++ b/css/account.css
@@ -0,0 +1,259 @@
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.account-hero {
+  background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  color: white;
+  text-align: center;
+  padding: 60px 20px;
+}
+
+.account-hero h1 {
+  font-size: 2.5rem;
+}
+
+.account {
+  max-width: 800px;
+}
+
+.panel {
+  background: white;
+  padding: 24px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-bottom: 24px;
+}
+
+.panel h2 {
+  color: var(--primary);
+}
+
+.panel-header {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+}
+
+.panel-header .btn {
+  margin-top: 0;
+}
+
+.hint {
+  color: #6d4c41;
+  font-size: 0.9rem;
+  margin: 4px 0 16px;
+}
+
+.notice {
+  background: #fff3e0;
+  border-left: 4px solid var(--accent);
+  padding: 12px 16px;
+  border-radius: 4px;
+  margin-bottom: 16px;
+}
+
+.notice a {
+  color: var(--primary);
+}
+
+.status:empty {
+  display: none;
+}
+
+.status {
+  background: var(--secondary);
+  padding: 10px 16px;
+  border-radius: 4px;
+  margin-bottom: 16px;
+}
+
+.status.error {
+  background: #ffebee;
+  color: #b71c1c;
+}
+
+/* Forms */
+label {
+  display: grid;
+  gap: 4px;
+  font-size: 0.9rem;
+  font-weight: 600;
+}
+
+input {
+  font: inherit;
+  font-weight: normal;
+  padding: 8px 10px;
+  border: 1px solid #bcaaa4;
+  border-radius: 4px;
+}
+
+input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.profile-form {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 16px;
+  align-items: end;
+}
+
+.profile-form .btn {
+  margin-top: 0;
+  justify-self: start;
+}
+
+button {
+  font: inherit;
+  cursor: pointer;
+}
+
+button.btn {
+  border: 0;
+}
+
+.btn-secondary,
+.btn-danger {
+  background: transparent;
+  border: 1px solid var(--primary);
+  color: var(--primary);
+  padding: 6px 14px;
+  border-radius: 5px;
+  font-size: 0.9rem;
+}
+
+.btn-secondary:hover {
+  background: var(--secondary);
+}
+
+.btn-danger {
+  border-color: #c62828;
+  color: #c62828;
+}
+
+.btn-danger:hover {
+  background: #c62828;
+  color: white;
+}
+
+dialog .btn-danger {
+  background: #c62828;
+  color: white;
+}
+
+button:disabled {
+  opacity: 0.6;
+  cursor: progress;
+}
+
+/* Passkey list */
+.passkey-list {
+  list-style: none;
+  display: grid;
+  gap: 12px;
+}
+
+.passkey {
+  display: grid;
+  grid-template-columns: 40px 1fr auto;
+  gap: 16px;
+  align-items: center;
+  padding: 14px;
+  border: 1px solid #efebe9;
+  border-radius: 8px;
+}
+
+.passkey-icon {
+  border-radius: 8px;
+  object-fit: contain;
+}
+
+.passkey-info {
+  display: grid;
+  min-width: 0;
+}
+
+.passkey-name {
+  overflow-wrap: anywhere;
+}
+
+.passkey-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 12px;
+  font-size: 0.8rem;
+  color: #6d4c41;
+}
+
+.passkey-synced {
+  background: var(--secondary);
+  padding: 0 8px;
+  border-radius: 999px;
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 8px;
+}
+
+.empty {
+  text-align: center;
+  color: #6d4c41;
+  padding: 24px;
+  border: 1px dashed #bcaaa4;
+  border-radius: 8px;
+}
+
+@media (max-width: 560px) {
+  .passkey {
+    grid-template-columns: 40px 1fr;
+  }
+
+  .passkey-actions {
+    grid-column: 1 / -1;
+    justify-content: flex-end;
+  }
+}
+
+/* Dialogs */
+dialog {
+  margin: auto;
+  border: 0;
+  border-radius: 8px;
+  padding: 24px;
+  width: min(420px, calc(100% - 32px));
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+}
+
+dialog::backdrop {
+  background: rgba(62, 39, 35, 0.6);
+}
+
+dialog h3 {
+  color: var(--primary);
+  margin-bottom: 12px;
+}
+
+dialog p {
+  margin-bottom: 8px;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 20px;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+}
diff --git a/css/site.css b/css/site.css
new file mode 100644
index 0000000..504f745
--- /dev/null
+++ b/css/site.css
@@ -0,0 +1,146 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
