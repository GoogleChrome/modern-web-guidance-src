diff --git a/js/passkeys.js b/js/passkeys.js
new file mode 100644
index 0000000..4c2fb14
--- /dev/null
+++ b/js/passkeys.js
@@ -0,0 +1,298 @@
+/**
+ * My Account — profile + passkey management.
+ *
+ * Expected backend API (all same-origin, cookie-authenticated, JSON):
+ *   GET    /api/user                   -> { id, name, displayName, rpId }   (id is Base64URL)
+ *   PUT    /api/user                   <- { name, displayName }
+ *   GET    /api/credentials            -> StoredPasskeyCredential[]
+ *          ({ id, name, providerIcon?, registeredAt, lastUsedAt?, credentialBackedUp, ... })
+ *   PUT    /api/credential/:id         <- { name }
+ *   DELETE /api/credential/:id
+ *   POST   /api/passkey/register-options  <- { promotion: false } -> PublicKeyCredentialCreationOptionsJSON
+ *   POST   /api/passkey/register-verify   <- RegistrationResponseJSON
+ *
+ * The server must verify that every credential belongs to the signed-in user.
+ */
+
+// Polyfill JSON (de)serialization + getClientCapabilities on older browsers.
+if (window.PublicKeyCredential && !PublicKeyCredential.parseCreationOptionsFromJSON) {
+  try {
+    await import('https://unpkg.com/webauthn-polyfills');
+  } catch (e) {
+    console.warn('Could not load webauthn-polyfills:', e);
+  }
+}
+
+const $ = (sel) => document.querySelector(sel);
+const statusEl = $('#status');
+const listEl = $('#passkey-list');
+const emptyEl = $('#passkey-empty');
+const rowTemplate = $('#passkey-row');
+const renameDialog = $('#rename-dialog');
+const deleteDialog = $('#delete-dialog');
+const createBtn = $('#create-passkey');
+const profileForm = $('#profile-form');
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const DEFAULT_ICON =
+  'data:image/svg+xml,' +
+  encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#4e342e"><path d="M12.65 10A6 6 0 1 0 12.65 14H17v4h4v-4h2v-4zM7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>'
+  );
+
+/** @type {{ id: string, name: string, displayName: string, rpId: string } | null} */
+let user = null;
+
+// ---------- API ----------
+
+async function api(path, { method = 'GET', body } = {}) {
+  const res = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (res.status === 401) {
+    location.href = `/login?next=${encodeURIComponent(location.pathname)}`;
+    throw new Error('Not signed in');
+  }
+  if (!res.ok) throw new Error(`${method} ${path} failed (${res.status})`);
+  return res.status === 204 ? null : res.json();
+}
+
+const fetchCredentials = () => api('/api/credentials');
+
+// ---------- UI helpers ----------
+
+function setStatus(message, isError = false) {
+  statusEl.textContent = message;
+  statusEl.classList.toggle('error', isError);
+}
+
+/** Opens a <dialog> and resolves with the button value used to close it. */
+function ask(dialog) {
+  return new Promise((resolve) => {
+    dialog.returnValue = '';
+    dialog.addEventListener('close', () => resolve(dialog.returnValue), { once: true });
+    dialog.showModal();
+  });
+}
+
+function renderCredentials(credentials) {
+  listEl.replaceChildren(
+    ...credentials.map((cred) => {
+      const row = rowTemplate.content.firstElementChild.cloneNode(true);
+      row.dataset.id = cred.id;
+      row.querySelector('.passkey-icon').src = cred.providerIcon || DEFAULT_ICON;
+      row.querySelector('.passkey-name').textContent = cred.name || 'Unnamed passkey';
+      row.querySelector('.passkey-created').textContent =
+        `Created ${dateFormat.format(new Date(cred.registeredAt))}`;
+      row.querySelector('.passkey-used').textContent = cred.lastUsedAt
+        ? `Last used ${dateFormat.format(new Date(cred.lastUsedAt))}`
+        : 'Never used';
+      row.querySelector('.passkey-synced').hidden = !cred.credentialBackedUp;
+      for (const btn of row.querySelectorAll('button')) {
+        btn.setAttribute('aria-label', `${btn.textContent} ${cred.name || 'passkey'}`);
+      }
+      return row;
+    })
+  );
+  emptyEl.hidden = credentials.length > 0;
+  listEl.setAttribute('aria-busy', 'false');
+}
+
+// ---------- Signal API sync ----------
+
+/** Tell the password manager which credential IDs are still valid so stale ones get hidden/removed. */
+async function signalAcceptedCredentials(credentials) {
+  if (!user || !window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: user.rpId,
+      userId: user.id, // Base64URL
+      allAcceptedCredentialIds: credentials.map((c) => c.id), // Base64URL
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+async function signalUserDetails() {
+  if (!user || !window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: user.rpId,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+async function refreshCredentials() {
+  const credentials = await fetchCredentials();
+  renderCredentials(credentials);
+  return credentials;
+}
+
+// ---------- Actions ----------
+
+async function renamePasskey(id, currentName) {
+  const input = renameDialog.querySelector('input[name="name"]');
+  input.value = currentName;
+  if ((await ask(renameDialog)) !== 'save') return;
+
+  const name = input.value.trim();
+  if (!name || name === currentName) return;
+  try {
+    // Nickname is a server-side label only; no Signal API call needed.
+    await api(`/api/credential/${encodeURIComponent(id)}`, { method: 'PUT', body: { name } });
+    await refreshCredentials();
+    setStatus(`Passkey renamed to “${name}”.`);
+  } catch (e) {
+    console.error(e);
+    setStatus('Could not rename that passkey. Please try again.', true);
+  }
+}
+
+async function deletePasskey(id, name) {
+  deleteDialog.querySelector('.delete-name').textContent = name;
+  if ((await ask(deleteDialog)) !== 'delete') return;
+
+  try {
+    await api(`/api/credential/${encodeURIComponent(id)}`, { method: 'DELETE' });
+    const remaining = await refreshCredentials();
+    await signalAcceptedCredentials(remaining);
+    setStatus(`“${name}” was deleted.`);
+  } catch (e) {
+    console.error(e);
+    setStatus('Could not delete that passkey. Please try again.', true);
+  }
+}
+
+async function createPasskey() {
+  createBtn.disabled = true;
+  try {
+    // Management flow: omit authenticatorAttachment server-side so security keys are allowed too.
+    const optionsJSON = await api('/api/passkey/register-options', {
+      method: 'POST',
+      body: { promotion: false },
+    });
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+    let credential;
+    try {
+      credential = await navigator.credentials.create({ publicKey });
+    } catch (err) {
+      if (err.name === 'InvalidStateError') {
+        setStatus('You already have a passkey for this account on this device or password manager.', true);
+      } else if (err.name === 'SecurityError') {
+        console.error('RP ID / secure context misconfiguration:', err);
+        setStatus('Passkeys are not available on this page right now.', true);
+      } else if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+        console.error(err);
+        setStatus('Something went wrong creating your passkey.', true);
+      }
+      return; // user cancelled / aborted: stay quiet
+    }
+
+    const responseJSON = credential.toJSON();
+    let verified = false;
+    try {
+      await api('/api/passkey/register-verify', { method: 'POST', body: responseJSON });
+      verified = true;
+    } catch (serverErr) {
+      console.error('Passkey verification failed:', serverErr);
+    }
+
+    if (!verified) {
+      // Server rejected it: ask the password manager to drop the orphaned passkey.
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId: user.rpId, credentialId: responseJSON.id });
+        } catch (e) {
+          console.error('signalUnknownCredential failed:', e);
+        }
+      }
+      setStatus('We could not save your passkey. Please try again.', true);
+      return;
+    }
+
+    await refreshCredentials();
+    setStatus('Passkey created. You can now use it to sign in.');
+  } catch (e) {
+    console.error(e);
+    setStatus('Something went wrong creating your passkey.', true);
+  } finally {
+    createBtn.disabled = false;
+  }
+}
+
+async function saveProfile(event) {
+  event.preventDefault();
+  const submit = profileForm.querySelector('button[type="submit"]');
+  const data = new FormData(profileForm);
+  const name = data.get('name').trim();
+  const displayName = data.get('displayName').trim();
+
+  submit.disabled = true;
+  try {
+    const updated = await api('/api/user', { method: 'PUT', body: { name, displayName } });
+    user = { ...user, name, displayName, ...updated };
+    await signalUserDetails();
+    setStatus('Profile saved.');
+  } catch (e) {
+    console.error(e);
+    setStatus('Could not save your profile. Please try again.', true);
+  } finally {
+    submit.disabled = false;
+  }
+}
+
+// ---------- Init ----------
+
+async function setupCreateButton() {
+  let supported = false;
+  if (window.PublicKeyCredential && window.isSecureContext) {
+    try {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      supported = !!caps.passkeyPlatformAuthenticator;
+    } catch (e) {
+      console.warn('getClientCapabilities failed:', e);
+    }
+  }
+  createBtn.hidden = !supported;
+  $('#passkey-unsupported').hidden = supported;
+}
+
+listEl.addEventListener('click', (event) => {
+  const btn = event.target.closest('button[data-action]');
+  if (!btn) return;
+  const row = btn.closest('.passkey');
+  const name = row.querySelector('.passkey-name').textContent;
+  if (btn.dataset.action === 'rename') renamePasskey(row.dataset.id, name);
+  else if (btn.dataset.action === 'delete') deletePasskey(row.dataset.id, name);
+});
+createBtn.addEventListener('click', createPasskey);
+profileForm.addEventListener('submit', saveProfile);
+
+async function init() {
+  setupCreateButton();
+  try {
+    user = await api('/api/user');
+    profileForm.elements.name.value = user.name ?? '';
+    profileForm.elements.displayName.value = user.displayName ?? '';
+
+    const credentials = await refreshCredentials();
+    // Keep the password manager in step with the server on every visit.
+    await signalAcceptedCredentials(credentials);
+  } catch (e) {
+    console.error(e);
+    listEl.setAttribute('aria-busy', 'false');
+    setStatus('We could not load your account details. Please refresh the page.', true);
+  }
+}
+
+init();
