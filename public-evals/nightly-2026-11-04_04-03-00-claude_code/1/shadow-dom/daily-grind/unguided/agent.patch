diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..e40d07c
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,170 @@
+/**
+ * <drink-card> — reusable menu card with encapsulated (Shadow DOM) styles.
+ *
+ * Attributes:
+ *   heading      Drink name (required)
+ *   description  Short blurb
+ *   href         Target URL for the action link
+ *   link-text    Action link label (default: "View Details")
+ *   limited      Boolean; when present shows a badge. An optional value
+ *                overrides the badge text (default: "Limited").
+ *
+ * All attributes are observed, so the page can add/remove `limited`
+ * (or change any other field) at runtime and the card updates in place.
+ *
+ * Theming hooks (optional CSS custom properties set from the page):
+ *   --drink-card-primary, --drink-card-primary-hover,
+ *   --drink-card-accent, --drink-card-text
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      all: initial;
+      display: block;
+      contain: content;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--drink-card-text, #3e2723);
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    .card {
+      position: relative;
+      height: 100%;
+      background: #fff;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    /* Reserve room so the badge never overlaps a long, centered heading. */
+    :host([limited]) .card {
+      padding-top: 40px;
+    }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      right: 12px;
+      background: var(--drink-card-accent, #ffab40);
+      color: var(--drink-card-text, #3e2723);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    h3 {
+      font-size: 1.17em;
+      font-weight: bold;
+      margin-bottom: 10px;
+      color: var(--drink-card-primary, #4e342e);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--drink-card-primary, #4e342e);
+      color: #fff;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover,
+    .btn:focus-visible {
+      background: var(--drink-card-primary-hover, #3e2723);
+    }
+
+    .btn[hidden] {
+      display: none;
+    }
+  </style>
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden></span>
+    <h3 part="heading"></h3>
+    <p part="description"></p>
+    <a class="btn" part="link"></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'description', 'href', 'link-text', 'limited'];
+  }
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this._els = {
+      badge: root.querySelector('.badge'),
+      heading: root.querySelector('h3'),
+      description: root.querySelector('p'),
+      link: root.querySelector('.btn'),
+    };
+  }
+
+  connectedCallback() {
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  get limited() {
+    return this.hasAttribute('limited');
+  }
+
+  set limited(value) {
+    this.toggleAttribute('limited', Boolean(value));
+  }
+
+  _render() {
+    const { badge, heading, description, link } = this._els;
+
+    // textContent only — attribute values are never parsed as HTML.
+    heading.textContent = this.getAttribute('heading') || '';
+    description.textContent = this.getAttribute('description') || '';
+
+    const href = this.getAttribute('href');
+    if (href) {
+      link.setAttribute('href', href);
+      link.hidden = false;
+    } else {
+      link.removeAttribute('href');
+      link.hidden = true;
+    }
+    link.textContent = this.getAttribute('link-text') || 'View Details';
+
+    if (this.limited) {
+      badge.textContent = this.getAttribute('limited') || 'Limited';
+      badge.hidden = false;
+    } else {
+      badge.hidden = true;
+    }
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
