+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const list = document.getElementById('summary');
+      const sourceText = document.getElementById('journal-text').innerText.trim();
+
+      // Same options object must be passed to availability() and create().
+      const options = {
+        sharedContext: "A coffee roaster's journal entry about how they source their beans.",
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      let summarizerPromise = null;
+
+      const unsupported = (message) => {
+        button.disabled = true;
+        status.textContent = message;
+      };
+
+      // Turn markdown bullet output into list items (via textContent, never innerHTML).
+      const renderBullets = (markdown) => {
+        const items = markdown
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[-*\u2022]|\d+\.)\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').trim())
+          .filter(Boolean);
+        list.replaceChildren(...items.map((text) => {
+          const li = document.createElement('li');
+          li.textContent = text;
+          return li;
+        }));
+        list.hidden = items.length === 0;
+      };
+
+      const getSummarizer = () => {
+        summarizerPromise ??= Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading on-device AI model… ${Math.round((e.loaded / (e.total || 1)) * 100)}%`;
+            });
+          },
+        }).catch((err) => {
+          summarizerPromise = null; // allow retry
+          throw err;
+        });
+        return summarizerPromise;
+      };
+
+      if (!('Summarizer' in self)) {
+        unsupported('On-device summarization isn\u2019t supported in this browser.');
+        return;
+      }
+
+      Summarizer.availability(options).then((availability) => {
+        if (availability === 'unavailable') {
+          unsupported('On-device summarization isn\u2019t available on this device.');
+        } else if (availability !== 'available') {
+          status.textContent = 'The first summary will download a small on-device AI model.';
+        }
+      }).catch(() => unsupported('On-device summarization isn\u2019t available right now.'));
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        status.textContent = 'Preparing summarizer…';
+        try {
+          // create() is called inside the click handler so the user gesture can start a model download.
+          const summarizer = await getSummarizer();
+          status.textContent = 'Summarizing…';
+          let output = '';
+          for await (const chunk of summarizer.summarizeStreaming(sourceText)) {
+            output += chunk;
+            renderBullets(output);
+          }
+          status.textContent = 'Summary generated on your device.';
+          button.textContent = 'Summarize again';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, we couldn\u2019t summarize this right now.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
