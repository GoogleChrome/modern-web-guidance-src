+  <script>
+    (() => {
+      const btn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summary-status');
+      const box = document.getElementById('journal-summary');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-text');
+
+      // Chrome's built-in Summarizer API (global `Summarizer`), with fallback to the older `self.ai.summarizer` shape.
+      const api = ('Summarizer' in self) ? self.Summarizer : self.ai?.summarizer;
+
+      if (!api) {
+        btn.disabled = true;
+        btn.style.cursor = 'not-allowed';
+        statusEl.textContent = "Your browser doesn't support built-in AI summaries yet (try a recent version of Chrome).";
+        return;
+      }
+
+      const options = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: "A coffee roaster's blog post about how they source their green coffee beans.",
+      };
+
+      let summarizerPromise = null;
+      let cachedSummary = null;
+
+      async function getAvailability() {
+        if (typeof api.availability === 'function') return api.availability(options);
+        // Legacy API
+        const caps = await api.capabilities();
+        return { readily: 'available', after_download: 'downloadable', no: 'unavailable' }[caps.available] || 'unavailable';
+      }
+
+      function getSummarizer() {
+        if (!summarizerPromise) {
+          summarizerPromise = api.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const pct = Math.round((e.total ? e.loaded / e.total : e.loaded) * 100);
+                statusEl.textContent = `Downloading on-device AI model… ${pct}%`;
+              });
+            },
+          }).catch((err) => {
+            summarizerPromise = null;
+            throw err;
+          });
+        }
+        return summarizerPromise;
+      }
+
+      function renderBullets(markdown) {
+        list.replaceChildren();
+        const lines = markdown
+          .split('\n')
+          .map((l) => l.trim())
+          .filter(Boolean)
+          .map((l) => l.replace(/^([-*•]|\d+[.)])\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*(.+?)\*/g, '$1'));
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line;
+          list.appendChild(li);
+        }
+        box.hidden = false;
+      }
+
+      btn.addEventListener('click', async () => {
+        if (cachedSummary) {
+          box.hidden = !box.hidden;
+          btn.textContent = box.hidden ? 'Show Summary' : 'Hide Summary';
+          return;
+        }
+
+        btn.disabled = true;
+        btn.textContent = 'Summarizing…';
+        statusEl.textContent = '';
+
+        try {
+          const availability = await getAvailability();
+          if (availability === 'unavailable') {
+            throw new Error("Built-in AI summaries aren't available on this device.");
+          }
+          if (availability !== 'available') {
+            statusEl.textContent = 'Preparing on-device AI model…';
+          }
+
+          const summarizer = await getSummarizer();
+          statusEl.textContent = 'Reading the journal…';
+
+          const text = source.innerText.replace(/\s+\n/g, '\n').trim();
+          let result = '';
+
+          if (typeof summarizer.summarizeStreaming === 'function') {
+            const stream = summarizer.summarizeStreaming(text);
+            for await (const chunk of stream) {
+              // Newer Chrome streams deltas; some older builds streamed the cumulative text.
+              result = chunk.startsWith(result) ? chunk : result + chunk;
+              renderBullets(result);
+            }
+          } else {
+            result = await summarizer.summarize(text);
+            renderBullets(result);
+          }
+
+          cachedSummary = result;
+          statusEl.textContent = 'Summary generated on your device.';
+          btn.textContent = 'Hide Summary';
+        } catch (err) {
+          console.error(err);
+          statusEl.textContent = err?.message || 'Sorry, something went wrong while summarizing.';
+          btn.textContent = 'Summarize';
+        } finally {
+          btn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
