@@ -0,0 +1,111 @@
+/**
+ * Security & privacy response headers for The Daily Grind.
+ *
+ * This is the single source of truth. It's used by server.mjs and checked by
+ * scripts/privacy-audit.mjs. If you deploy behind a CDN or reverse proxy,
+ * copy these headers into its config.
+ */
+
+/** Content-Security-Policy: first-party only, no inline code, no third parties. */
+export const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self'",
+  "font-src 'self'",
+  "connect-src 'self'",
+  "manifest-src 'self'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+].join('; ');
+
+/**
+ * Permissions-Policy: turn off powerful or fingerprint-prone features this
+ * site doesn't need. Turn one on deliberately if you need it (e.g.
+ * geolocation=(self) for a store locator), and note it in PRIVACY.md.
+ */
+export const PERMISSIONS_POLICY = [
+  'accelerometer=()',
+  'ambient-light-sensor=()',
+  'autoplay=()',
+  'battery=()',
+  'bluetooth=()',
+  'browsing-topics=()',
+  'camera=()',
+  'display-capture=()',
+  'encrypted-media=()',
+  'gamepad=()',
+  'geolocation=()',
+  'gyroscope=()',
+  'hid=()',
+  'identity-credentials-get=()',
+  'idle-detection=()',
+  'interest-cohort=()',
+  'local-fonts=()',
+  'magnetometer=()',
+  'microphone=()',
+  'midi=()',
+  'payment=()',
+  'publickey-credentials-get=()',
+  'screen-wake-lock=()',
+  'serial=()',
+  'usb=()',
+  'xr-spatial-tracking=()',
+].join(', ');
+
+/** Headers sent on every response. */
+export const BASE_HEADERS = Object.freeze({
+  'Content-Security-Policy': CSP,
+  'Permissions-Policy': PERMISSIONS_POLICY,
+  // Send the referrer only to our own origin; never leak page URLs to others.
+  'Referrer-Policy': 'same-origin',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cross-Origin-Embedder-Policy': 'require-corp',
+  'Origin-Agent-Cluster': '?1',
+  'X-DNS-Prefetch-Control': 'off',
+  'X-Permitted-Cross-Domain-Policies': 'none',
+  // Browsers ignore HSTS over plain HTTP (e.g. localhost), so it's safe to always send.
+  'Strict-Transport-Security': 'max-age=63072000; includeSubDomains; preload',
+});
+
+/**
+ * HTML pages can show account details (there's a logged-in nav), so they must
+ * never be stored by shared caches or kept on disk.
+ */
+export const HTML_HEADERS = Object.freeze({
+  'Cache-Control': 'no-store, private',
+  Pragma: 'no-cache',
+});
+
+/** Fingerprintable static assets (CSS/JS/images) hold no personal data. */
+export const ASSET_HEADERS = Object.freeze({
+  'Cache-Control': 'public, max-age=3600',
+});
+
+/**
+ * Should be sent by the backend's POST /logout handler (not served by this
+ * static server) so HttpOnly cookies, caches and storage are wiped.
+ */
+export const LOGOUT_HEADERS = Object.freeze({
+  'Clear-Site-Data': '"cache", "cookies", "storage"',
+  'Cache-Control': 'no-store',
+});
+
+/** Pick the full header set for a request path. */
+export function headersFor(pathname) {
+  const isHtml = pathname.endsWith('/') || pathname.endsWith('.html') || !/\.[a-z0-9]+$/i.test(pathname);
+  const isWellKnown = pathname.startsWith('/.well-known/');
+  return {
+    ...BASE_HEADERS,
+    ...(isHtml ? HTML_HEADERS : ASSET_HEADERS),
+    // GPC support resource must be readable by any origin per the GPC spec.
+    ...(isWellKnown ? { 'Access-Control-Allow-Origin': '*', 'Cross-Origin-Resource-Policy': 'cross-origin' } : {}),
+  };
+}
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..64a98f5
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,47 @@
+/**
+ * Static server for The Daily Grind. It applies the security and privacy
+ * headers from security-headers.mjs.
+ *
+ * Only ./public is served, so source, config, scripts and docs are never
+ * exposed. Dotfiles are hidden except /.well-known/gpc.json.
+ */
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import serveStatic from 'serve-static';
+import statikk from 'statikk';
+import { BASE_HEADERS, headersFor } from './security-headers.mjs';
+
+const root = path.join(path.dirname(fileURLToPath(import.meta.url)), 'public');
+
+/** serve-static hands us the file path; turn it back into a URL path to classify it. */
+function setHeaders(res, filePath) {
+  const urlPath = '/' + path.relative(root, filePath).split(path.sep).join('/');
+  for (const [name, value] of Object.entries(headersFor(urlPath))) res.setHeader(name, value);
+}
+
+const { app, url } = await statikk({
+  root,
+  port: process.env.PORT || 11222,
+  // 'ignore' (not 'deny') lets dotfile requests fall through to the
+  // allow-listed /.well-known handler below; anything else ends in a 404.
+  dotfiles: 'ignore',
+  setHeaders,
+});
+
+// Serve only the allow-listed GPC resource from /.well-known.
+const serveWellKnown = serveStatic(path.join(root, '.well-known'), { index: false, setHeaders });
+app.use('/.well-known/gpc.json', (req, res, next) => {
+  req.url = '/gpc.json'; // connect strips the mount path
+  serveWellKnown(req, res, next);
+});
+
+// 404s get the hardened headers too, and give away nothing about the server.
+app.use((req, res) => {
+  for (const [name, value] of Object.entries(BASE_HEADERS)) res.setHeader(name, value);
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+  res.statusCode = 404;
+  res.end('Not found');
+});
+
+console.log(`The Daily Grind is being served at ${url}`);
