@@ -0,0 +1,120 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <!--
+    Privacy by design: this page loads NO third-party resources. All styles,
+    scripts, images and the favicon are first-party. The authoritative security
+    headers (CSP, Referrer-Policy, Permissions-Policy, ...) are sent by the
+    server (see security-headers.mjs); the meta tags below are a fallback for
+    hosts that cannot set headers.
+  -->
+  <meta name="referrer" content="same-origin">
+  <meta http-equiv="Content-Security-Policy"
+    content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'">
+  <meta name="color-scheme" content="light">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="/css/styles.css">
+  <script src="/js/privacy.js" defer></script>
+</head>
+
+<body>
+
+  <nav aria-label="Main">
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li>
+        <!-- POST, not GET: logout must be an explicit user action. The server
+             should answer with `Clear-Site-Data: "cache", "cookies", "storage"`. -->
+        <form class="logout-form" method="post" action="/logout" data-privacy-logout>
+          <button type="submit" class="logout-link">Logout</button>
+        </form>
+      </li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a> |
+      <!-- Without JS this falls back to the privacy policy page. -->
+      <a href="/privacy-policy#your-choices" data-privacy-open>Privacy Choices</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <dialog class="privacy-dialog" id="privacy-dialog" aria-labelledby="privacy-dialog-title">
+    <form method="dialog" id="privacy-form">
+      <h2 id="privacy-dialog-title">Your Privacy Choices</h2>
+      <p>
+        This site uses no advertising, no cross-site tracking and no third-party
+        scripts. Your choices are stored only in this browser and are never sent
+        to our servers.
+      </p>
+      <p class="gpc-notice" id="gpc-notice" hidden>
+        Your browser sent a Global Privacy Control / Do Not Track signal. We honour it:
+        optional features below are switched off and can't be turned on from this browser.
+      </p>
+      <fieldset>
+        <legend>What we may use</legend>
+        <label>
+          <input type="checkbox" checked disabled>
+          Strictly necessary
+          <small>Sign-in session and security. Required for the site to work.</small>
+        </label>
+        <label>
+          <input type="checkbox" name="analytics" id="consent-analytics">
+          Anonymous usage statistics
+          <small>Off by default. We don't run analytics today; if we ever do, it will only load when this is on.</small>
+        </label>
+      </fieldset>
+      <p class="status" id="privacy-status" role="status" aria-live="polite"></p>
+      <div class="dialog-actions">
+        <button type="button" id="privacy-clear">Clear data on this device</button>
+        <button type="button" id="privacy-reject">Reject optional</button>
+        <button type="submit" class="primary" id="privacy-save">Save choices</button>
+      </div>
+    </form>
+  </dialog>
+
+</body>
+
+</html>
diff --git a/public/js/privacy.js b/public/js/privacy.js
new file mode 100644
index 0000000..de0cce9
--- /dev/null
+++ b/public/js/privacy.js
@@ -0,0 +1,306 @@
+/*
+ * The Daily Grind: client-side privacy controls.
+ *
+ * Privacy-by-design principles applied here:
+ *  - Opt-in by default: every optional purpose is OFF until the visitor turns it on.
+ *  - Honour browser signals: Global Privacy Control / Do Not Track mean opt-out,
+ *    and the visitor can't override that from the page.
+ *  - Keep data to a minimum: only allow-listed storage keys may exist. Anything else
+ *    is deleted on load. Stored choices hold no identifiers, keep the save date
+ *    only to the day, and expire.
+ *  - Local only: choices never leave the browser (no network calls in this file).
+ *  - Secure handling: no innerHTML/eval (compatible with Trusted Types and a
+ *    strict CSP), strict validation of anything read back from storage.
+ *
+ * Any future optional feature (analytics, personalisation, ...) MUST check
+ * `window.DailyGrindPrivacy.hasConsent('<purpose>')` before loading, and
+ * should listen for the `dg:privacy-change` event on `document`.
+ */
+(() => {
+  'use strict';
+
+  const PREFS_KEY = 'dg_privacy_v1';
+  const PREFS_VERSION = 1;
+  const PREFS_MAX_AGE_DAYS = 180;
+
+  /** Optional purposes the visitor can opt into. All default to false. */
+  const OPTIONAL_PURPOSES = Object.freeze(['analytics']);
+
+  /**
+   * Allow-list of web-storage keys this site may use. Anything not listed is
+   * removed on page load (data minimisation). Add new keys here deliberately
+   * and record them in PRIVACY.md.
+   */
+  const ALLOWED_STORAGE_KEYS = Object.freeze({
+    localStorage: new Set([PREFS_KEY]),
+    sessionStorage: new Set([]),
+  });
+
+  const privacySignal =
+    navigator.globalPrivacyControl === true ||
+    navigator.doNotTrack === '1' ||
+    window.doNotTrack === '1';
+
+  // ---------------------------------------------------------------------------
+  // Storage helpers (storage can throw: private mode, disabled, quota, ...)
+  // ---------------------------------------------------------------------------
+
+  function getStore(name) {
+    try {
+      const store = window[name];
+      const probe = '__dg_probe__';
+      store.setItem(probe, probe);
+      store.removeItem(probe);
+      return store;
+    } catch {
+      return null;
+    }
+  }
+
+  const local = getStore('localStorage');
+  const session = getStore('sessionStorage');
+
+  function minimiseStorage() {
+    for (const [name, store] of [['localStorage', local], ['sessionStorage', session]]) {
+      if (!store) continue;
+      const allowed = ALLOWED_STORAGE_KEYS[name];
+      // Copy keys first; removing while iterating by index skips entries.
+      const keys = [];
+      for (let i = 0; i < store.length; i++) keys.push(store.key(i));
+      for (const key of keys) {
+        if (key !== null && !allowed.has(key)) store.removeItem(key);
+      }
+    }
+  }
+
+  /** Today's date to the day (YYYY-MM-DD). No time, to keep stored data minimal. */
+  function today() {
+    return new Date().toISOString().slice(0, 10);
+  }
+
+  function isExpired(savedOn) {
+    const saved = Date.parse(`${savedOn}T00:00:00Z`);
+    if (Number.isNaN(saved)) return true;
+    const ageDays = (Date.now() - saved) / 86_400_000;
+    return ageDays < 0 || ageDays > PREFS_MAX_AGE_DAYS;
+  }
+
+  function defaultPrefs() {
+    const consents = {};
+    for (const purpose of OPTIONAL_PURPOSES) consents[purpose] = false;
+    return { consents, saved: false };
+  }
+
+  /** Read and strictly validate stored preferences; invalid/expired data is discarded. */
+  function readPrefs() {
+    if (!local) return defaultPrefs();
+    let raw;
+    try {
+      raw = JSON.parse(local.getItem(PREFS_KEY));
+    } catch {
+      raw = null;
+    }
+    const valid =
+      raw !== null &&
+      typeof raw === 'object' &&
+      raw.v === PREFS_VERSION &&
+      typeof raw.savedOn === 'string' &&
+      /^\d{4}-\d{2}-\d{2}$/.test(raw.savedOn) &&
+      !isExpired(raw.savedOn) &&
+      raw.consents !== null &&
+      typeof raw.consents === 'object';
+
+    if (!valid) {
+      if (local.getItem(PREFS_KEY) !== null) local.removeItem(PREFS_KEY);
+      return defaultPrefs();
+    }
+
+    const prefs = defaultPrefs();
+    for (const purpose of OPTIONAL_PURPOSES) {
+      // Only an explicit `true` counts as consent, and never with a privacy signal.
+      prefs.consents[purpose] = raw.consents[purpose] === true && !privacySignal;
+    }
+    prefs.saved = true;
+    return prefs;
+  }
+
+  function writePrefs(consents) {
+    const clean = {};
+    for (const purpose of OPTIONAL_PURPOSES) {
+      clean[purpose] = consents[purpose] === true && !privacySignal;
+    }
+    current = { consents: clean, saved: true };
+    if (local) {
+      try {
+        local.setItem(
+          PREFS_KEY,
+          JSON.stringify({ v: PREFS_VERSION, savedOn: today(), consents: clean }),
+        );
+      } catch {
+        /* Storage full or blocked: the choice still applies for this page view. */
+      }
+    }
+    document.dispatchEvent(
+      new CustomEvent('dg:privacy-change', { detail: Object.freeze({ ...clean }) }),
+    );
+  }
+
+  /** Delete non-HttpOnly cookies visible to this page (HttpOnly ones need the server). */
+  function clearReadableCookies() {
+    const host = location.hostname;
+    const domains = ['', host, `.${host}`];
+    for (const cookie of document.cookie.split(';')) {
+      const name = cookie.split('=')[0].trim();
+      if (!name) continue;
+      for (const domain of domains) {
+        document.cookie =
+          `${name}=; Max-Age=0; Path=/; SameSite=Lax; Secure` + (domain ? `; Domain=${domain}` : '');
+      }
+    }
+  }
+
+  async function clearCaches() {
+    if (!('caches' in window)) return;
+    try {
+      const names = await caches.keys();
+      await Promise.all(names.map((n) => caches.delete(n)));
+    } catch {
+      /* ignore */
+    }
+  }
+
+  /** Remove everything this site stored on the device that client JS can reach. */
+  async function clearDeviceData({ keepPrefs = false } = {}) {
+    const prefsRaw = keepPrefs && local ? local.getItem(PREFS_KEY) : null;
+    try { local && local.clear(); } catch { /* ignore */ }
+    try { session && session.clear(); } catch { /* ignore */ }
+    if (prefsRaw !== null) {
+      try { local.setItem(PREFS_KEY, prefsRaw); } catch { /* ignore */ }
+    }
+    clearReadableCookies();
+    await clearCaches();
+    if (!keepPrefs) current = defaultPrefs();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Initialise state
+  // ---------------------------------------------------------------------------
+
+  minimiseStorage();
+  let current = readPrefs();
+
+  // If a privacy signal arrived after consent was given, persist the opt-out.
+  if (privacySignal && current.saved) writePrefs(current.consents);
+
+  window.DailyGrindPrivacy = Object.freeze({
+    /** True if the browser sent GPC or DNT. */
+    privacySignal,
+    /** Whether a purpose is permitted. 'necessary' is always true. */
+    hasConsent(purpose) {
+      if (purpose === 'necessary') return true;
+      return OPTIONAL_PURPOSES.includes(purpose) && current.consents[purpose] === true;
+    },
+  });
+
+  // ---------------------------------------------------------------------------
+  // UI wiring (runs after DOM is parsed thanks to `defer`)
+  // ---------------------------------------------------------------------------
+
+  function hardenExternalLinks() {
+    for (const a of document.querySelectorAll('a[href]')) {
+      let url;
+      try {
+        url = new URL(a.href, location.href);
+      } catch {
+        continue;
+      }
+      if (url.origin !== location.origin) {
+        const rel = new Set(a.rel.split(/\s+/).filter(Boolean));
+        rel.add('noopener');
+        rel.add('noreferrer');
+        a.rel = [...rel].join(' ');
+        a.referrerPolicy = 'no-referrer';
+      }
+    }
+  }
+
+  function setupLogout() {
+    for (const form of document.querySelectorAll('form[data-privacy-logout]')) {
+      form.addEventListener('submit', () => {
+        // Remove client-side data from the shared device. The device-level
+        // privacy choices are kept so the visitor's opt-outs survive logout.
+        // The server response should add Clear-Site-Data for HttpOnly cookies.
+        clearDeviceData({ keepPrefs: true });
+      });
+    }
+  }
+
+  function setupDialog() {
+    const dialog = document.getElementById('privacy-dialog');
+    const form = document.getElementById('privacy-form');
+    if (!dialog || !form || typeof dialog.showModal !== 'function') return; // fall back to the policy page link
+
+    const status = document.getElementById('privacy-status');
+    const gpcNotice = document.getElementById('gpc-notice');
+    const boxes = {};
+    for (const purpose of OPTIONAL_PURPOSES) {
+      boxes[purpose] = form.elements.namedItem(purpose);
+    }
+
+    const say = (msg) => { if (status) status.textContent = msg; };
+
+    function sync() {
+      if (gpcNotice) gpcNotice.hidden = !privacySignal;
+      for (const purpose of OPTIONAL_PURPOSES) {
+        const box = boxes[purpose];
+        if (!box) continue;
+        box.checked = current.consents[purpose];
+        box.disabled = privacySignal;
+      }
+    }
+
+    function collect() {
+      const consents = {};
+      for (const purpose of OPTIONAL_PURPOSES) consents[purpose] = Boolean(boxes[purpose]?.checked);
+      return consents;
+    }
+
+    for (const opener of document.querySelectorAll('[data-privacy-open]')) {
+      opener.addEventListener('click', (event) => {
+        event.preventDefault();
+        sync();
+        say('');
+        dialog.showModal();
+      });
+    }
+
+    form.addEventListener('submit', () => {
+      // method="dialog" closes the dialog after this runs.
+      writePrefs(collect());
+    });
+
+    document.getElementById('privacy-reject')?.addEventListener('click', () => {
+      writePrefs({});
+      sync();
+      dialog.close();
+    });
+
+    document.getElementById('privacy-clear')?.addEventListener('click', async () => {
+      await clearDeviceData();
+      sync();
+      say('Data stored by this site in your browser has been removed. Log out to also end your session.');
+    });
+  }
+
+  function init() {
+    hardenExternalLinks();
+    setupLogout();
+    setupDialog();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init, { once: true });
+  } else {
+    init();
+  }
+})();
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..eca303b
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,242 @@
+#!/usr/bin/env node
+/**
+ * Privacy & third-party audit for the public site.
+ *
+ *   npm run audit:privacy
+ *
+ * Checks (fails with a non-zero exit code on any error):
+ *  1. Third parties: every external origin in public/ must be in
+ *     third-parties.json, and each entry must be complete and reviewed in the
+ *     last 365 days.
+ *  2. Markup: no inline scripts, styles or event handlers (keeps the strict CSP
+ *     working); no logout over GET; no sensitive fields in GET forms;
+ *     target=_blank links need rel=noopener; a referrer policy is set.
+ *  3. Scripts: no eval/innerHTML/document.write, no tracking beacons, no
+ *     network calls to unregistered origins.
+ *  4. Images: no embedded EXIF/GPS/XMP/text metadata.
+ *  5. Headers: the CSP and other security headers in security-headers.mjs are
+ *     present and strict.
+ */
+import { readFile, readdir } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { BASE_HEADERS, HTML_HEADERS, LOGOUT_HEADERS } from '../security-headers.mjs';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const publicDir = path.join(repoRoot, 'public');
+
+const errors = [];
+const warnings = [];
+const fail = (file, msg) => errors.push(`${file ? path.relative(repoRoot, file) + ': ' : ''}${msg}`);
+const warn = (file, msg) => warnings.push(`${file ? path.relative(repoRoot, file) + ': ' : ''}${msg}`);
+
+/** URLs that are identifiers, not network requests. */
+const NON_FETCHED_URL_PREFIXES = ['http://www.w3.org/'];
+
+async function walk(dir) {
+  const out = [];
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) out.push(...(await walk(full)));
+    else out.push(full);
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------
+// 1. Third-party register
+// ---------------------------------------------------------------------------
+
+const registerPath = path.join(repoRoot, 'third-parties.json');
+const register = JSON.parse(await readFile(registerPath, 'utf8'));
+const REQUIRED_FIELDS = ['host', 'vendor', 'purpose', 'dataShared', 'legalBasis', 'dpaSigned', 'reviewedOn'];
+const allowedHosts = new Set();
+
+for (const [i, entry] of (register.thirdParties ?? []).entries()) {
+  const missing = REQUIRED_FIELDS.filter((f) => entry[f] === undefined || entry[f] === '');
+  if (missing.length) fail(registerPath, `entry #${i} is missing: ${missing.join(', ')}`);
+  if (entry.dpaSigned !== true) fail(registerPath, `${entry.host}: no signed data processing agreement`);
+  const reviewed = Date.parse(entry.reviewedOn);
+  if (Number.isNaN(reviewed) || Date.now() - reviewed > 365 * 86_400_000) {
+    fail(registerPath, `${entry.host}: review is missing or older than 365 days`);
+  }
+  if (entry.host) allowedHosts.add(String(entry.host).toLowerCase());
+}
+
+const usedHosts = new Map(); // host -> Set(files)
+
+function checkExternalUrls(file, text) {
+  const urlPattern = /(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?[^\s"'()<>`]*/gi;
+  for (const match of text.matchAll(urlPattern)) {
+    const raw = match[0];
+    if (NON_FETCHED_URL_PREFIXES.some((p) => raw.startsWith(p))) continue;
+    // Skip protocol-relative false positives such as comments ("// foo.bar").
+    if (raw.startsWith('//') && !/(?:src|href|action|url\(|import|fetch)\s*[=(]?\s*["']?$/i.test(text.slice(Math.max(0, match.index - 12), match.index))) continue;
+    let host;
+    try {
+      host = new URL(raw, 'https://placeholder.invalid').hostname.toLowerCase();
+    } catch {
+      continue;
+    }
+    if (!usedHosts.has(host)) usedHosts.set(host, new Set());
+    usedHosts.get(host).add(path.relative(repoRoot, file));
+    if (raw.startsWith('http://')) fail(file, `insecure (http) URL: ${raw}`);
+    if (!allowedHosts.has(host)) fail(file, `unregistered third-party origin "${host}" (${raw}); add it to third-parties.json after review, or self-host it`);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 2. Markup
+// ---------------------------------------------------------------------------
+
+function checkHtml(file, html) {
+  const withoutComments = html.replace(/<!--[\s\S]*?-->/g, '');
+
+  for (const m of withoutComments.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+    if (!/\bsrc\s*=/.test(m[1]) && m[2].trim()) fail(file, 'inline <script> found; move it to a first-party .js file');
+  }
+  if (/<style\b/i.test(withoutComments)) fail(file, 'inline <style> block found; move it to /css');
+  if (/\sstyle\s*=/i.test(withoutComments)) fail(file, 'style="" attribute found (blocked by the CSP)');
+  if (/\son[a-z]+\s*=/i.test(withoutComments)) fail(file, 'inline event handler (on*="") found');
+  if (/href\s*=\s*["']javascript:/i.test(withoutComments)) fail(file, 'javascript: URL found');
+  if (/<a\b[^>]*href\s*=\s*["'][^"']*\/logout\b/i.test(withoutComments)) {
+    fail(file, 'logout is a GET link; use <form method="post" action="/logout">');
+  }
+  if (!/<meta\s+name=["']referrer["']/i.test(withoutComments)) warn(file, 'no <meta name="referrer"> fallback');
+  if (/<iframe\b/i.test(withoutComments)) warn(file, '<iframe> found; check that it is first-party and needed');
+
+  for (const m of withoutComments.matchAll(/<a\b[^>]*target\s*=\s*["']_blank["'][^>]*>/gi)) {
+    if (!/rel\s*=\s*["'][^"']*noopener/i.test(m[0])) fail(file, `target=_blank without rel="noopener": ${m[0]}`);
+  }
+
+  for (const m of withoutComments.matchAll(/<form\b([^>]*)>([\s\S]*?)<\/form>/gi)) {
+    const method = (/method\s*=\s*["']?(\w+)/i.exec(m[1])?.[1] ?? 'get').toLowerCase();
+    const sensitive = /type\s*=\s*["']?(password|email|tel)|autocomplete\s*=\s*["']?cc-|name\s*=\s*["']?(card|cvv|ssn|dob)/i.test(m[2]);
+    if (method === 'get' && sensitive) fail(file, 'form with personal data uses GET; it would leak into URLs, logs and Referer headers');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 3. Scripts
+// ---------------------------------------------------------------------------
+
+function checkJs(file, js) {
+  const code = js.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '');
+  const banned = [
+    [/\beval\s*\(/, 'eval()'],
+    [/\bnew\s+Function\s*\(/, 'new Function()'],
+    [/\.innerHTML\s*=|\.outerHTML\s*=|insertAdjacentHTML\s*\(/, 'HTML string injection (innerHTML/outerHTML/insertAdjacentHTML)'],
+    [/document\.write\s*\(/, 'document.write()'],
+    [/navigator\.sendBeacon\s*\(/, 'navigator.sendBeacon() (tracking beacon)'],
+    [/\b(gtag|ga|fbq|_paq|dataLayer)\b\s*[.(=[]/, 'known analytics/advertising tag'],
+    [/navigator\.(userAgentData\.getHighEntropyValues|getBattery|deviceMemory|hardwareConcurrency)/, 'fingerprinting-prone API'],
+    [/\bcanvas\b[\s\S]{0,80}toDataURL\s*\(/, 'canvas toDataURL (fingerprinting pattern)'],
+  ];
+  for (const [pattern, label] of banned) {
+    if (pattern.test(code)) fail(file, `${label} found`);
+  }
+  if (/document\.cookie\s*=(?![\s\S]{0,80}Max-Age=0)/.test(code)) warn(file, 'writes a cookie; make sure it is registered in PRIVACY.md');
+}
+
+// ---------------------------------------------------------------------------
+// 4. Image metadata
+// ---------------------------------------------------------------------------
+
+function checkImageMetadata(file, buf) {
+  const ext = path.extname(file).toLowerCase();
+  if (ext === '.jpg' || ext === '.jpeg') {
+    // Walk JPEG segments up to Start-Of-Scan, looking for APP1 (Exif/XMP), APP13 (IPTC) and COM.
+    let i = 2;
+    while (i + 4 <= buf.length && buf[i] === 0xff) {
+      const marker = buf[i + 1];
+      const len = buf.readUInt16BE(i + 2);
+      if (marker === 0xda) break;
+      if (marker === 0xe1) fail(file, 'contains EXIF/XMP metadata (may include GPS/camera serial); strip it');
+      if (marker === 0xed) fail(file, 'contains IPTC metadata; strip it');
+      if (marker === 0xfe) warn(file, 'contains a JPEG comment');
+      i += 2 + len;
+    }
+  } else if (ext === '.png') {
+    let i = 8;
+    while (i + 8 <= buf.length) {
+      const len = buf.readUInt32BE(i);
+      const type = buf.toString('ascii', i + 4, i + 8);
+      if (['eXIf', 'tEXt', 'iTXt', 'zTXt'].includes(type)) fail(file, `contains a ${type} metadata chunk; strip it`);
+      if (type === 'IEND') break;
+      i += 12 + len;
+    }
+  } else if (ext === '.webp' && buf.includes(Buffer.from('EXIF'))) {
+    fail(file, 'contains EXIF metadata; strip it');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 5. Header policy
+// ---------------------------------------------------------------------------
+
+function checkHeaders() {
+  const file = path.join(repoRoot, 'security-headers.mjs');
+  const required = [
+    'Content-Security-Policy', 'Permissions-Policy', 'Referrer-Policy', 'X-Content-Type-Options',
+    'X-Frame-Options', 'Strict-Transport-Security', 'Cross-Origin-Opener-Policy',
+  ];
+  for (const h of required) if (!BASE_HEADERS[h]) fail(file, `missing ${h}`);
+
+  const csp = BASE_HEADERS['Content-Security-Policy'] ?? '';
+  if (/'unsafe-inline'|'unsafe-eval'|'unsafe-hashes'/.test(csp)) fail(file, 'CSP allows unsafe-* sources');
+  if (/(^|\s)(\*|https?:|data:|blob:)(\s|;|$)/.test(csp)) fail(file, 'CSP contains a wildcard, scheme or data:/blob: source');
+  for (const d of ["default-src 'none'", "frame-ancestors 'none'", "base-uri 'none'", "object-src 'none'"]) {
+    if (!csp.includes(d)) fail(file, `CSP is missing ${d}`);
+  }
+  for (const host of allowedHosts) {
+    if (!csp.includes(host)) warn(file, `registered third party ${host} is not allowed by the CSP, so it will be blocked`);
+  }
+
+  const referrer = BASE_HEADERS['Referrer-Policy'];
+  if (!['no-referrer', 'same-origin', 'strict-origin', 'strict-origin-when-cross-origin'].includes(referrer)) {
+    fail(file, `Referrer-Policy "${referrer}" leaks full URLs to third parties`);
+  }
+  for (const feature of ['camera', 'microphone', 'geolocation', 'browsing-topics', 'interest-cohort']) {
+    if (!new RegExp(`${feature}=\\(\\)`).test(BASE_HEADERS['Permissions-Policy'] ?? '')) {
+      warn(file, `Permissions-Policy does not disable ${feature}`);
+    }
+  }
+  if (!/no-store/.test(HTML_HEADERS['Cache-Control'] ?? '')) fail(file, 'HTML responses are cacheable (should be no-store)');
+  if (!/cookies/.test(LOGOUT_HEADERS['Clear-Site-Data'] ?? '')) fail(file, 'logout must send Clear-Site-Data');
+}
+
+// ---------------------------------------------------------------------------
+// Run
+// ---------------------------------------------------------------------------
+
+const files = await walk(publicDir);
+for (const file of files) {
+  const ext = path.extname(file).toLowerCase();
+  if (['.jpg', '.jpeg', '.png', '.webp'].includes(ext)) {
+    checkImageMetadata(file, await readFile(file));
+    continue;
+  }
+  if (!['.html', '.htm', '.css', '.js', '.mjs', '.svg', '.json', '.webmanifest', '.txt'].includes(ext)) continue;
+  const text = await readFile(file, 'utf8');
+  checkExternalUrls(file, text);
+  if (ext === '.html' || ext === '.htm') checkHtml(file, text);
+  if (ext === '.js' || ext === '.mjs') checkJs(file, text);
+}
+checkHeaders();
+
+for (const host of allowedHosts) {
+  if (!usedHosts.has(host)) warn(registerPath, `${host} is registered but no longer used; remove it (data minimisation)`);
+}
+
+console.log('Third-party origins referenced by public/:');
+if (usedHosts.size === 0) console.log('  (none, fully first-party)');
+for (const [host, where] of usedHosts) console.log(`  ${host}  <- ${[...where].join(', ')}`);
+console.log(`Scanned ${files.length} files.\n`);
+
+for (const w of warnings) console.warn(`WARN  ${w}`);
+for (const e of errors) console.error(`FAIL  ${e}`);
+if (errors.length) {
+  console.error(`\nPrivacy audit failed with ${errors.length} error(s).`);
+  process.exit(1);
+}
+console.log(`Privacy audit passed${warnings.length ? ` with ${warnings.length} warning(s)` : ''}.`);
