@@ -0,0 +1,271 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-form {
+  margin: 0;
+}
+
+/* Logout is a POST form (not a GET link) so it can't be triggered by
+   prefetching, link previews, or cross-site <img src="/logout"> tricks. */
+.logout-link {
+  background: none;
+  color: white;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+  transition: color 0.3s;
+}
+
+.logout-link:hover,
+.logout-link:focus-visible {
+  color: var(--accent);
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('/images/hero-800.jpg');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+@media (min-width: 801px) {
+  .hero {
+    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      url('/images/hero-1600.jpg');
+  }
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.link-button {
+  background: none;
+  border: 0;
+  color: var(--text);
+  font: inherit;
+  font-size: 0.85rem;
+  cursor: pointer;
+  margin: 0 10px;
+  padding: 0;
+}
+
+.link-button:hover,
+.footer-links a:hover {
+  text-decoration: underline;
+}
+
+/* Privacy choices dialog */
+.privacy-dialog {
+  max-width: 32rem;
+  margin: auto;
+  padding: 24px;
+  border: 0;
+  border-radius: 8px;
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+}
+
+.privacy-dialog::backdrop {
+  background: rgba(0, 0, 0, 0.5);
+}
+
+.privacy-dialog h2 {
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.privacy-dialog p,
+.privacy-dialog fieldset {
+  margin-bottom: 15px;
+}
+
+.privacy-dialog fieldset {
+  border: 1px solid var(--secondary);
+  border-radius: 6px;
+  padding: 10px 15px;
+}
+
+.privacy-dialog label {
+  display: block;
+  margin: 6px 0;
+}
+
+.privacy-dialog small {
+  display: block;
+  color: #6d4c41;
+  margin-left: 1.5rem;
+}
+
+.privacy-dialog .gpc-notice {
+  background: #e8f5e9;
+  border-radius: 4px;
+  padding: 8px 12px;
+}
+
+.privacy-dialog .status {
+  min-height: 1.6em;
+  font-size: 0.9rem;
+}
+
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  justify-content: flex-end;
+}
+
+.dialog-actions button {
+  font: inherit;
+  cursor: pointer;
+  border-radius: 5px;
+  padding: 8px 16px;
+  border: 1px solid var(--primary);
+  background: white;
+  color: var(--primary);
+}
+
+.dialog-actions button.primary {
+  background: var(--primary);
+  color: white;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none !important;
+  }
+}
