@@ -0,0 +1,47 @@
+# Security & privacy response headers — single source of truth.
+#
+# Format: Netlify / Cloudflare Pages `_headers` (path line, then indented
+# `Name: value` lines). Those hosts apply it natively; `server.mjs` parses this same
+# file for local serving. Rules are applied top to bottom; later rules for a
+# matching path override earlier ones header-by-header.
+#
+# Why each header exists is documented in PRIVACY.md. Keep the
+# <meta http-equiv="Content-Security-Policy"> / <meta name="referrer"> fallbacks in
+# index.html in sync with this file.
+#
+# Not configured on purpose:
+#   - Reporting-Endpoints / report-to: no first-party, PII-scrubbing collector exists
+#     yet. Add one (strip query strings and IPs at the edge) rather than pointing at
+#     a third-party reporting service.
+
+/*
+  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests
+  Referrer-Policy: same-origin
+  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), focus-without-user-activation=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), join-ad-interest-group=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), private-state-token-issuance=(), private-state-token-redemption=(), publickey-credentials-create=(), publickey-credentials-get=(), run-ad-auction=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()
+  Strict-Transport-Security: max-age=31536000; includeSubDomains
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: DENY
+  X-DNS-Prefetch-Control: off
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+  Origin-Agent-Cluster: ?1
+
+# GPC support declaration (https://privacycg.github.io/gpc-spec/) must be readable
+# by browser extensions and auditing tools from any origin.
+/.well-known/gpc.json
+  Cross-Origin-Resource-Policy: cross-origin
+  Access-Control-Allow-Origin: *
+  Content-Type: application/json
+
+# Logout: wipe cookies, storage and cached personalised pages in the browser.
+# Sent on the logout response only (not on the homepage) so it can't block rendering.
+/logout
+  Clear-Site-Data: "cache", "cookies", "storage"
+  Cache-Control: no-store
+
+# Pages showing personal data must never be stored in shared or disk caches.
+/account
+  Cache-Control: no-store
+
+/account/*
+  Cache-Control: no-store
