+// Local static server for The Daily Grind — zero dependencies.
+//
+// Replaces `pnpm dlx statikk`, which downloaded an unpinned third-party package on
+// every start and could not send our privacy/security headers.
+//
+//  - Serves ONLY an explicit allowlist of public files (no repo files, no dotfiles
+//    other than /.well-known/gpc.json, no directory traversal: requests are looked
+//    up in a prebuilt Map, never joined onto a filesystem path).
+//  - Applies the headers declared in ./_headers (same file production hosts use).
+//  - Implements POST /logout with Clear-Site-Data so the logout flow works locally.
+//  - Logs nothing about requests (no IPs, no URLs with query strings).
+
+import { createServer } from 'node:http';
+import { readFile, readdir } from 'node:fs/promises';
+import { extname, join, relative, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+
+/** Public surface of the site. Anything not listed here is a 404. */
+const PUBLIC_FILES = ['index.html', '.well-known/gpc.json'];
+const PUBLIC_DIRS = ['css', 'js', 'images'];
+
+const CONTENT_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.png': 'image/png',
+  '.webp': 'image/webp',
+  '.avif': 'image/avif',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon',
+};
+
+/** Parse a Netlify/Cloudflare-style `_headers` file into [{ pattern, headers }]. */
+function parseHeadersFile(text) {
+  const rules = [];
+  for (const rawLine of text.split(/\r?\n/)) {
+    if (!rawLine.trim() || rawLine.trimStart().startsWith('#')) continue;
+    if (!/^\s/.test(rawLine)) {
+      rules.push({ pattern: rawLine.trim(), headers: [] });
+      continue;
+    }
+    const idx = rawLine.indexOf(':');
+    if (idx === -1 || rules.length === 0) continue;
+    rules.at(-1).headers.push([rawLine.slice(0, idx).trim(), rawLine.slice(idx + 1).trim()]);
+  }
+  return rules;
+}
+
+function matches(pattern, pathname) {
+  return pattern.endsWith('*') ? pathname.startsWith(pattern.slice(0, -1)) : pattern === pathname;
+}
+
+/** Collect headers for a path; later rules override earlier ones per header name. */
+function headersFor(rules, pathname, { secure }) {
+  const out = new Map();
+  for (const rule of rules) {
+    if (!matches(rule.pattern, pathname)) continue;
+    for (const [name, value] of rule.headers) out.set(name.toLowerCase(), [name, value]);
+  }
+  if (!secure) {
+    // Over plain-HTTP localhost, HSTS is ignored and upgrade-insecure-requests
+    // would break same-origin subresources; production (HTTPS) keeps both.
+    out.delete('strict-transport-security');
+    const csp = out.get('content-security-policy');
+    if (csp) csp[1] = csp[1].replace(/;\s*upgrade-insecure-requests/, '');
+  }
+  return [...out.values()];
+}
+
+async function listFiles(dir) {
+  const entries = await readdir(join(ROOT, dir), { withFileTypes: true, recursive: true });
+  return entries
+    .filter((e) => e.isFile() && !e.name.startsWith('.'))
+    .map((e) => relative(ROOT, join(e.parentPath, e.name)).split(sep).join('/'));
+}
+
+async function buildRoutes() {
+  const files = [...PUBLIC_FILES];
+  for (const dir of PUBLIC_DIRS) files.push(...(await listFiles(dir).catch(() => [])));
+  const routes = new Map();
+  for (const file of files) {
+    const type = CONTENT_TYPES[extname(file).toLowerCase()];
+    if (!type) continue; // Unknown types are never served (nosniff-safe).
+    routes.set(`/${file}`, { file: join(ROOT, file), type });
+  }
+  routes.set('/', routes.get('/index.html'));
+  return routes;
+}
+
+const rules = parseHeadersFile(await readFile(join(ROOT, '_headers'), 'utf8'));
+const routes = await buildRoutes();
+
+const server = createServer(async (req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    res.writeHead(400).end();
+    return;
+  }
+  const secure = Boolean(req.socket.encrypted);
+  for (const [name, value] of headersFor(rules, pathname, { secure })) res.setHeader(name, value);
+
+  if (pathname === '/logout') {
+    if (req.method !== 'POST') {
+      res.writeHead(405, { Allow: 'POST' }).end();
+      return;
+    }
+    // A real backend would also destroy the server-side session here.
+    res.writeHead(303, { Location: '/' }).end();
+    return;
+  }
+
+  const route = routes.get(pathname);
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    res.writeHead(route ? 405 : 404, route ? { Allow: 'GET, HEAD' } : {}).end();
+    return;
+  }
+  if (!route) {
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }).end('Not found');
+    return;
+  }
+
+  try {
+    const body = await readFile(route.file);
+    if (!res.hasHeader('Content-Type')) res.setHeader('Content-Type', route.type);
+    if (!res.hasHeader('Cache-Control')) res.setHeader('Cache-Control', 'no-cache');
+    res.writeHead(200, { 'Content-Length': body.length });
+    res.end(req.method === 'HEAD' ? undefined : body);
+  } catch {
+    res.writeHead(404).end();
+  }
+});
+
+// Bind to loopback only so the dev server isn't reachable from the network.
+server.listen(PORT, 'localhost', () => {
+  console.log(`The Daily Grind: http://localhost:${PORT}`);
+});
