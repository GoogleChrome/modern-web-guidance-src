diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..c1aa7cf
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,44 @@
+/*
+ * The Daily Grind — client-side privacy helpers.
+ *
+ * Ground rules for every script on this site (enforced by the CSP in /_headers):
+ *   - First-party only. No analytics, tag managers, pixels or social SDKs.
+ *   - No network requests from script (CSP: connect-src falls back to 'none').
+ *   - Never write PII or tokens to localStorage/sessionStorage/IndexedDB; the
+ *     session lives in an HttpOnly cookie that script cannot read.
+ *   - No HTML string sinks (innerHTML etc.); Trusted Types is enforced with no
+ *     policies allowed, so any such write throws.
+ *   - Feature detection only; no user-agent sniffing or fingerprinting.
+ */
+(() => {
+  'use strict';
+
+  /**
+   * Defense in depth for logout: the server's `Clear-Site-Data` response header
+   * is the primary mechanism, but some browsers support it only partially, so
+   * also wipe any same-origin web storage before the form submits.
+   */
+  function clearClientStorage() {
+    for (const storage of ['localStorage', 'sessionStorage']) {
+      try {
+        window[storage]?.clear();
+      } catch {
+        // Storage can be disabled (e.g. blocked by the user); nothing to clear.
+      }
+    }
+  }
+
+  for (const form of document.querySelectorAll('form[data-logout]')) {
+    form.addEventListener('submit', clearClientStorage);
+  }
+
+  /**
+   * Transparency: when the browser sends a Global Privacy Control signal,
+   * confirm in the UI that we honor it (also declared in /.well-known/gpc.json).
+   */
+  if (navigator.globalPrivacyControl === true) {
+    for (const note of document.querySelectorAll('[data-gpc-note]')) {
+      note.hidden = false;
+    }
+  }
+})();
