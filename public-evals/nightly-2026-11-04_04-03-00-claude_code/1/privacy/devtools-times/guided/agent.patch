+/**
+ * Privacy-preserving response headers applied to every server-rendered
+ * response.
+ *
+ * - Referrer-Policy: cross-origin requests only receive our origin, never the
+ *   path or query string of the article a reader is viewing.
+ * - Permissions-Policy: The DevTools Times uses no powerful browser features,
+ *   so they are disabled for this document and every embedded frame/script.
+ *   `browsing-topics=()` also opts our pages out of interest-based ad topics.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'magnetometer=()',
+    'microphone=()',
+    'midi=()',
+    'payment=()',
+    'serial=()',
+    'usb=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+};
+
