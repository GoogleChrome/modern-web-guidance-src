diff --git a/src/components/ConsentManager.astro b/src/components/ConsentManager.astro
new file mode 100644
index 0000000..95581ef
--- /dev/null
+++ b/src/components/ConsentManager.astro
@@ -0,0 +1,167 @@
+---
+/**
+ * Consent manager.
+ *
+ * Privacy by design: no optional third-party script is loaded until the reader
+ * explicitly opts in. Rejecting is as easy as accepting, the choice can be
+ * changed at any time via any element with `data-privacy-settings`, and the
+ * choice itself is stored only in this browser (localStorage) — never sent to
+ * a server.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<div
+  id="consent-banner"
+  role="dialog"
+  aria-modal="false"
+  aria-labelledby="consent-title"
+  aria-describedby="consent-desc"
+  hidden
+  transition:persist
+  class="fixed inset-x-0 bottom-0 z-[100] border-t border-gray-300 bg-white p-4 shadow-lg md:p-6"
+>
+  <div class="mx-auto flex max-w-5xl flex-col gap-4 md:flex-row md:items-end md:justify-between">
+    <div class="text-sm text-gray-700">
+      <h2 id="consent-title" class="mb-1 text-base font-bold text-gray-900">Your privacy choices</h2>
+      <p id="consent-desc">
+        We use only what is strictly necessary to run this site by default. With your permission,
+        we would also load an <strong>analytics script</strong> from our provider
+        (<code>us-central1-web-devrel-apps.cloudfunctions.net</code>) that records which links and
+        buttons you click (element type, its visible label, and a timestamp) so we can improve the
+        site. No advertising or cross-site tracking is used.
+        <a href={`${baseUrl}legal/privacy`} class="underline" data-skip-tracking>Read our Privacy Policy</a>.
+      </p>
+    </div>
+    <div class="flex shrink-0 gap-2">
+      <button
+        type="button"
+        data-consent="denied"
+        data-skip-tracking
+        class="rounded-md border border-gray-900 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
+      >
+        Reject analytics
+      </button>
+      <button
+        type="button"
+        data-consent="granted"
+        data-skip-tracking
+        class="rounded-md border border-gray-900 bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
+      >
+        Allow analytics
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = 'dt-privacy-consent';
+  const CONSENT_VERSION = 1;
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+  type Choice = 'granted' | 'denied';
+
+  function readChoice(): Choice | null {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw);
+      if (parsed?.v !== CONSENT_VERSION) return null; // re-ask if the disclosure changes
+      return parsed.analytics === 'granted' ? 'granted' : 'denied';
+    } catch {
+      return null;
+    }
+  }
+
+  function saveChoice(choice: Choice) {
+    try {
+      localStorage.setItem(
+        STORAGE_KEY,
+        JSON.stringify({ v: CONSENT_VERSION, analytics: choice, date: new Date().toISOString().slice(0, 10) })
+      );
+    } catch {
+      /* storage unavailable: treat as session-only choice */
+    }
+  }
+
+  function honoursOptOutSignal(): boolean {
+    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+    return nav.globalPrivacyControl === true || navigator.doNotTrack === '1';
+  }
+
+  let analyticsLoaded = false;
+  function loadAnalytics() {
+    if (analyticsLoaded || document.querySelector(`script[src="${ANALYTICS_SRC}"]`)) return;
+    analyticsLoaded = true;
+    const s = document.createElement('script');
+    s.src = ANALYTICS_SRC;
+    s.defer = true;
+    s.referrerPolicy = 'no-referrer';
+    document.head.appendChild(s);
+  }
+
+  function banner() {
+    return document.getElementById('consent-banner');
+  }
+
+  function showBanner() {
+    const el = banner();
+    if (!el) return;
+    el.hidden = false;
+    el.querySelector<HTMLButtonElement>('[data-consent="denied"]')?.focus();
+  }
+
+  function hideBanner() {
+    const el = banner();
+    if (el) el.hidden = true;
+  }
+
+  function apply(choice: Choice | null) {
+    if (choice === 'granted') loadAnalytics();
+  }
+
+  function init() {
+    const choice = readChoice();
+    if (choice === null) {
+      // Respect browser-level opt-out signals without asking.
+      if (honoursOptOutSignal()) {
+        hideBanner();
+        return;
+      }
+      showBanner();
+    } else {
+      hideBanner();
+      apply(choice);
+    }
+  }
+
+  document.addEventListener('click', (event) => {
+    const target = event.target as Element | null;
+    if (!target) return;
+
+    const settings = target.closest('[data-privacy-settings]');
+    if (settings) {
+      event.preventDefault();
+      showBanner();
+      return;
+    }
+
+    const button = target.closest<HTMLButtonElement>('#consent-banner [data-consent]');
+    if (!button) return;
+    const choice = button.dataset.consent as Choice;
+    const previous = readChoice();
+    saveChoice(choice);
+    hideBanner();
+
+    if (choice === 'granted') {
+      loadAnalytics();
+    } else if (previous === 'granted' || analyticsLoaded) {
+      // A loaded third-party script cannot be reliably unloaded; reload so it stops immediately.
+      location.reload();
+    }
+  });
+
+  // Runs on first load and after every client-side navigation (ClientRouter).
+  document.addEventListener('astro:page-load', init);
+</script>
