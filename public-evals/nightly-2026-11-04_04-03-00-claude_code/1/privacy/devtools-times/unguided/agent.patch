diff --git a/src/components/FormPrivacyNotice.tsx b/src/components/FormPrivacyNotice.tsx
new file mode 100644
index 0000000..c2df99e
--- /dev/null
+++ b/src/components/FormPrivacyNotice.tsx
@@ -0,0 +1,57 @@
+import React from 'react';
+
+/**
+ * Just-in-time privacy notice shown where personal data is collected.
+ * Tells the reader, in plain language, what is collected, why, who receives it,
+ * and where to learn more — before they submit anything.
+ */
+export default function FormPrivacyNotice({ variant }: { variant: 'signin' | 'signup' }) {
+  const base = import.meta.env.BASE_URL.endsWith('/')
+    ? import.meta.env.BASE_URL
+    : `${import.meta.env.BASE_URL}/`;
+
+  return (
+    <aside
+      aria-label="How we handle your data"
+      className="mt-6 border-t border-gray-200 pt-4 text-xs leading-relaxed text-gray-600"
+    >
+      <p className="mb-2 font-semibold text-gray-700">How we handle your data</p>
+      <ul className="list-disc space-y-1 pl-4">
+        {variant === 'signup' ? (
+          <>
+            <li>
+              We only collect a <strong>username</strong> and <strong>password</strong>. No email,
+              real name, or phone number is required.
+            </li>
+            <li>They are used solely to create and secure your account — never for advertising.</li>
+          </>
+        ) : (
+          <li>
+            Your username and password are used only to verify your identity and are not used for
+            any other purpose.
+          </li>
+        )}
+        <li>
+          Data is sent over an encrypted connection to our account service (hosted on Google Cloud
+          in the US). Form fields are excluded from analytics.
+        </li>
+        {variant === 'signup' && (
+          <li>
+            You can ask us to delete your account and its data at any time.
+          </li>
+        )}
+      </ul>
+      <p className="mt-2">
+        {variant === 'signup' ? 'By signing up you agree to our ' : 'See our '}
+        <a href={`${base}legal/terms`} className="underline" data-skip-tracking>
+          Terms of Service
+        </a>{' '}
+        and{' '}
+        <a href={`${base}legal/privacy`} className="underline" data-skip-tracking>
+          Privacy Policy
+        </a>
+        .
+      </p>
+    </aside>
+  );
+}
