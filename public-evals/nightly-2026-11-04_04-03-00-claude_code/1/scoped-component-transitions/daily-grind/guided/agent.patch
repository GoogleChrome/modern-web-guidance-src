+
+  <script>
+    // Element-scoped view transitions: each component animates in its own
+    // subtree, so the rest of the page stays interactive and transitions in
+    // different components (e.g. a card and the order panel) run concurrently.
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        // Graceful fallback: apply the update immediately without animation.
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(updateDOM);
+      // Re-triggering on the same scope skips the active transition; swallow that.
+      transition.ready.catch(() => {});
+    }
+
+    const money = (n) => `$${n.toFixed(2)}`;
+    const orderEl = document.getElementById('order');
+    const listEl = document.getElementById('order-list');
+    const emptyEl = document.getElementById('order-empty');
+    const totalEl = document.getElementById('order-total');
+    const sortEl = document.getElementById('order-sort');
+    const cards = new Map(
+      Array.from(document.querySelectorAll('.card'), (card) => [card.dataset.id, card]),
+    );
+    let addedCounter = 0;
+    const quantities = new Map(); // source of truth: id -> qty
+
+    // ----- Card: badge + quick look -----
+    function updateCardBadge(id, qty) {
+      const card = cards.get(id);
+      const badge = card.querySelector('.card-badge');
+      const text = qty > 0 ? `${qty} in order` : '';
+      if (badge.textContent === text && badge.hidden === !qty) return;
+      runScopedTransition(card, () => {
+        badge.textContent = text;
+        badge.hidden = !qty;
+      });
+    }
+
+    function toggleDetails(card, button) {
+      const details = card.querySelector('.card-details');
+      const expand = details.hidden;
+      runScopedTransition(card, () => {
+        details.hidden = !expand;
+        button.setAttribute('aria-expanded', String(expand));
+        button.textContent = expand ? 'Hide details' : 'Quick look';
+      });
+    }
+
+    // ----- Order panel -----
+    function sortedItems(items, mode) {
+      const by = {
+        added: (a, b) => b.dataset.added - a.dataset.added,
+        name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
+        price: (a, b) => b.dataset.price - a.dataset.price,
+      }[mode];
+      return [...items].sort(by);
+    }
+
+    function applySort() {
+      // Move existing nodes (match-element tracks DOM identity).
+      for (const li of sortedItems(listEl.children, sortEl.value)) listEl.append(li);
+    }
+
+    function refreshSummary() {
+      const items = Array.from(listEl.children);
+      const total = items.reduce((sum, li) => sum + li.dataset.price * li.dataset.qty, 0);
+      emptyEl.hidden = items.length > 0;
+      totalEl.hidden = items.length === 0;
+      totalEl.textContent = `Total: ${money(total)}`;
+    }
+
+    function renderQty(li) {
+      const qty = Number(li.dataset.qty);
+      li.querySelector('.qty').textContent = `× ${qty}`;
+      li.querySelector('.line-price').textContent = money(li.dataset.price * qty);
+    }
+
+    function createOrderItem(card) {
+      const { id, name, price } = card.dataset;
+      const li = document.createElement('li');
+      Object.assign(li.dataset, { id, name, price, qty: '0' });
+      li.innerHTML = `
+        <span class="name"></span>
+        <span class="qty"></span>
+        <span class="line-price"></span>
+        <button type="button" class="remove"></button>`;
+      li.querySelector('.name').textContent = name;
+      const remove = li.querySelector('.remove');
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      return li;
+    }
+
+    function addToOrder(card) {
+      const id = card.dataset.id;
+      // The update callback runs asynchronously, so compute the new state now.
+      const qty = (quantities.get(id) ?? 0) + 1;
+      quantities.set(id, qty);
+      const added = ++addedCounter;
+      runScopedTransition(orderEl, () => {
+        // Re-query: an earlier, skipped transition may have already created it.
+        let li = listEl.querySelector(`li[data-id="${id}"]`);
+        if (!li) {
+          li = createOrderItem(card);
+          listEl.append(li);
+        }
+        li.dataset.qty = qty;
+        li.dataset.added = added;
+        renderQty(li);
+        applySort();
+        refreshSummary();
+      });
+      // The card's badge animates in its own scope, concurrently with the panel.
+      updateCardBadge(id, qty);
+    }
+
+    function removeFromOrder(li) {
+      const hadFocus = li.contains(document.activeElement);
+      const nextFocusTarget =
+        li.nextElementSibling?.querySelector('button') ??
+        li.previousElementSibling?.querySelector('button') ??
+        sortEl;
+      quantities.delete(li.dataset.id);
+      runScopedTransition(orderEl, () => {
+        li.remove();
+        refreshSummary();
+        if (hadFocus) nextFocusTarget.focus();
+      });
+      updateCardBadge(li.dataset.id, 0);
+    }
+
+    document.querySelector('.grid').addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+      const card = button.closest('.card');
+      if (button.dataset.action === 'toggle') toggleDetails(card, button);
+      else if (button.dataset.action === 'add') addToOrder(card);
+    });
+
+    listEl.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove');
+      if (button) removeFromOrder(button.closest('li'));
+    });
+
+    sortEl.addEventListener('change', () => runScopedTransition(orderEl, applySort));
+  </script>
 </body>
 
