+  <!--
+    Speculative prefetching: same-origin links are prefetched when the user
+    hovers (desktop) or starts interacting with them (mobile).
+    Never speculate URLs that change state — /logout is excluded by URL and by
+    selector. Add data-no-prefetch to any other link that must not be preloaded.
+  -->
+  <script type="speculationrules">
+    {
+      "prefetch": [{
+        "tag": "site-prefetch",
+        "where": {
+          "and": [
+            { "href_matches": "/*" },
+            { "not": { "href_matches": "/logout" } },
+            { "not": { "href_matches": "/logout/*" } },
+            { "not": { "href_matches": "/logout\\?*" } },
+            { "not": { "selector_matches": "[data-no-prefetch]" } },
+            { "not": { "selector_matches": "[rel~=nofollow]" } }
+          ]
+        },
+        "eagerness": "moderate"
+      }]
+    }
+  </script>
