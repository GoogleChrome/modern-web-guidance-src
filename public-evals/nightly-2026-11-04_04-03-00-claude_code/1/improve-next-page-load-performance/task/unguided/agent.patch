+  <!--
+    Link prefetching: next pages are fetched ahead of time so clicks feel instant.
+    Never-prefetch rules (keep these in sync between the two blocks below):
+      - /logout and anything under it (prefetching a logout URL can end the session)
+      - any link marked with data-no-prefetch, rel="nofollow", or a download attribute
+      - cross-origin links and links that open in a new tab
+  -->
+  <script type="speculationrules">
+  {
+    "prefetch": [{
+      "where": {
+        "and": [
+          { "href_matches": "/*" },
+          { "not": { "href_matches": "/logout" } },
+          { "not": { "href_matches": "/logout/*" } },
+          { "not": { "href_matches": "/logout\\?*" } },
+          { "not": { "selector_matches": "[data-no-prefetch], [rel~=nofollow], [download], [target=_blank]" } }
+        ]
+      },
+      "eagerness": "moderate"
+    }]
+  }
+  </script>
+  <script>
+    // Fallback for browsers without Speculation Rules support (Firefox, Safari):
+    // prefetch a link when the user hovers, focuses, or touches it.
+    (function () {
+      if (HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) return;
+
+      var done = new Set();
+      var EXCLUDED = '[data-no-prefetch], [rel~=nofollow], [download], [target=_blank]';
+
+      function isLogout(path) {
+        return /^\/logout(\/|$)/i.test(path);
+      }
+
+      function maybePrefetch(e) {
+        var a = e.target.closest && e.target.closest('a[href]');
+        if (!a || a.matches(EXCLUDED)) return;
+        var url = new URL(a.href, location.href);
+        if (url.origin !== location.origin) return;
+        if (isLogout(url.pathname)) return;
+        if (url.pathname === location.pathname && url.search === location.search) return;
+        var key = url.pathname + url.search;
+        if (done.has(key)) return;
+        done.add(key);
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = key;
+        document.head.appendChild(link);
+      }
+
+      var timer;
+      document.addEventListener('mouseover', function (e) {
+        clearTimeout(timer);
+        timer = setTimeout(function () { maybePrefetch(e); }, 65);
+      }, { passive: true });
+      document.addEventListener('mouseout', function () { clearTimeout(timer); }, { passive: true });
+      document.addEventListener('touchstart', maybePrefetch, { passive: true });
+      document.addEventListener('focusin', maybePrefetch);
+    })();
+  </script>
