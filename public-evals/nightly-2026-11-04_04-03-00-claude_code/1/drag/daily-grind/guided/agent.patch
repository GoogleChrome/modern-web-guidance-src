+  <script>
+    (() => {
+      const panel = document.getElementById('quick-order');
+      const handle = document.getElementById('qo-handle');
+      const toggle = document.getElementById('qo-toggle');
+      const form = document.getElementById('qo-body');
+      const STORAGE_POS = 'dailyGrind.quickOrder.pos';
+      const STORAGE_CART = 'dailyGrind.quickOrder.cart';
+      const STORAGE_COLLAPSED = 'dailyGrind.quickOrder.collapsed';
+      const KEY_STEP = 15;
+      const fmt = (n) => `$${n.toFixed(2)}`;
+      const read = (key, fallback) => {
+        try { return JSON.parse(localStorage.getItem(key)) ?? fallback; } catch { return fallback; }
+      };
+      const write = (key, value) => {
+        try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage unavailable */ }
+      };
+
+      /* ---------- Dragging ---------- */
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute('aria-label', 'Quick order panel. Use arrow keys to move it.');
+
+      let positioned = false;
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        const x = Math.max(0, Math.min(left, maxLeft));
+        const y = Math.max(0, Math.min(top, maxTop));
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        positioned = true;
+        return { x, y };
+      }
+      const savePos = () => {
+        const r = panel.getBoundingClientRect();
+        write(STORAGE_POS, { x: r.left, y: r.top });
+      };
+
+      let offsetX = 0, offsetY = 0, startX = 0, startY = 0, dragging = false;
+
+      handle.addEventListener('pointerdown', (e) => {
+        if (e.button !== 0 || e.target.closest('button, input, select, textarea, a')) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = e.clientX - rect.left;
+        offsetY = e.clientY - rect.top;
+        startX = e.clientX;
+        startY = e.clientY;
+        dragging = false;
+        handle.setPointerCapture(e.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (e) => {
+        if (!handle.hasPointerCapture(e.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(e.clientX - startX, e.clientY - startY) < 4) return;
+          dragging = true;
+          handle.classList.add('dragging');
+          panel.classList.add('is-dragging');
+        }
+        moveTo(e.clientX - offsetX, e.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        if (dragging) savePos();
+        dragging = false;
+        handle.classList.remove('dragging');
+        panel.classList.remove('is-dragging');
+      });
+
+      handle.addEventListener('keydown', (e) => {
+        if (e.target !== handle) return;
+        const delta = {
+          ArrowLeft: [-KEY_STEP, 0], ArrowRight: [KEY_STEP, 0],
+          ArrowUp: [0, -KEY_STEP], ArrowDown: [0, KEY_STEP],
+        }[e.key];
+        if (!delta) return;
+        e.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+        savePos();
+      });
+
+      // Keep the panel reachable when the viewport or panel size changes.
+      const reclamp = () => {
+        if (!positioned) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      };
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      const saved = read(STORAGE_POS, null);
+      if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) moveTo(saved.x, saved.y);
+
+      /* ---------- Collapse ---------- */
+      function setCollapsed(collapsed) {
+        panel.classList.toggle('collapsed', collapsed);
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', `${collapsed ? 'Expand' : 'Collapse'} quick order panel`);
+        toggle.innerHTML = collapsed ? '+' : '&minus;';
+        write(STORAGE_COLLAPSED, collapsed);
+      }
+      toggle.addEventListener('click', () => setCollapsed(!panel.classList.contains('collapsed')));
+      setCollapsed(read(STORAGE_COLLAPSED, window.matchMedia('(max-width: 600px)').matches));
+
+      /* ---------- Order builder ---------- */
+      const item = document.getElementById('qo-item');
+      const img = document.getElementById('qo-img');
+      const milk = document.getElementById('qo-milk');
+      const qty = document.getElementById('qo-qty');
+      const shot = document.getElementById('qo-shot');
+      const linePrice = document.getElementById('qo-line-price');
+      const status = document.getElementById('qo-status');
+
+      form.querySelectorAll('.stepper button').forEach((btn) => {
+        btn.hidden = false;
+        btn.addEventListener('click', () => {
+          const next = (parseInt(qty.value, 10) || 1) + Number(btn.dataset.step);
+          qty.value = Math.max(Number(qty.min), Math.min(Number(qty.max), next));
+          update();
+        });
+      });
+
+      function currentLine() {
+        const opt = item.selectedOptions[0];
+        const size = form.querySelector('input[name="size"]:checked');
+        const milkOpt = milk.selectedOptions[0];
+        const count = Math.max(1, Math.min(10, parseInt(qty.value, 10) || 1));
+        const unit = Number(opt.dataset.price) + Number(size.dataset.add) +
+          Number(milkOpt.dataset.add) + (shot.checked ? Number(shot.dataset.add) : 0);
+        const name = opt.textContent.split('—')[0].trim();
+        const details = [size.parentElement.textContent.trim(), milkOpt.value === 'whole' ? null : milkOpt.textContent.replace(/\s*\(.*\)/, ''), shot.checked ? 'extra shot' : null]
+          .filter(Boolean).join(', ');
+        return { name, details, unit, count };
+      }
+
+      function update() {
+        img.src = item.selectedOptions[0].dataset.img;
+        const line = currentLine();
+        linePrice.textContent = fmt(line.unit * line.count);
+      }
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+
+      /* ---------- Cart ---------- */
+      const cartEl = document.getElementById('qo-cart');
+      const list = document.getElementById('qo-list');
+      const empty = document.getElementById('qo-empty');
+      const totalEl = document.getElementById('qo-total');
+      const badge = document.getElementById('qo-badge');
+      const checkout = document.getElementById('qo-checkout');
+      let cart = read(STORAGE_CART, []);
+      if (!Array.isArray(cart)) cart = [];
+
+      function renderCart() {
+        cartEl.hidden = false;
+        list.replaceChildren(...cart.map((line, i) => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${line.count}× ${line.name}${line.details ? ` (${line.details})` : ''}`;
+          const price = document.createElement('span');
+          price.textContent = fmt(line.unit * line.count);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${line.name}`);
+          remove.addEventListener('click', () => {
+            cart.splice(i, 1);
+            status.textContent = `Removed ${line.name}.`;
+            persist();
+            (list.querySelector('.remove') ?? form.querySelector('.qo-add')).focus();
+          });
+          li.append(label, price, remove);
+          return li;
+        }));
+        const items = cart.reduce((n, l) => n + l.count, 0);
+        const total = cart.reduce((n, l) => n + l.unit * l.count, 0);
+        empty.hidden = cart.length > 0;
+        totalEl.textContent = fmt(total);
+        badge.textContent = items;
+        badge.setAttribute('aria-label', `${items} item${items === 1 ? '' : 's'} in cart`);
+        checkout.setAttribute('aria-disabled', String(cart.length === 0));
+      }
+      function persist() {
+        write(STORAGE_CART, cart);
+        renderCart();
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const line = currentLine();
+        const existing = cart.find((l) => l.name === line.name && l.details === line.details);
+        if (existing) existing.count = Math.min(99, existing.count + line.count);
+        else cart.push(line);
+        status.textContent = `Added ${line.count} ${line.name} to cart.`;
+        persist();
+      });
+
+      update();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
