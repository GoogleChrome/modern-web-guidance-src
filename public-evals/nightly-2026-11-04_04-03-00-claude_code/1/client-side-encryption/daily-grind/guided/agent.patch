index 0000000..0c13b3d
--- /dev/null
+++ b/delivery-notes.js
@@ -0,0 +1,420 @@
+// Encrypted delivery notes for The Daily Grind.
+//
+// Notes such as gate codes, buzzer numbers or "key is under the mat" are
+// sealed in the browser to the courier's public key before they leave the
+// page. The plaintext never touches the network or storage.
+//
+// Protection suites, chosen by feature detection:
+//   1. Hybrid post-quantum KEM: MLKEM768-X25519 -> ChaCha20-Poly1305 (preferred)
+//   2. Classical fallback: ephemeral-static X25519 -> HKDF-SHA-256 -> AES-GCM
+//
+// Every envelope binds its header (version, suite, courier key ID, timestamp)
+// as AEAD associated data, so tampering with either the ciphertext or the
+// metadata makes decryption fail.
+
+const ENVELOPE_VERSION = 'dg-note-v1';
+const SUITE_PQ = 'MLKEM768-X25519+ChaCha20-Poly1305';
+const SUITE_CLASSICAL = 'X25519+HKDF-SHA256+AES-GCM';
+const SUITE_LABELS = {
+  [SUITE_PQ]: 'Hybrid post-quantum · ML-KEM-768 + X25519 · ChaCha20-Poly1305',
+  [SUITE_CLASSICAL]: 'Classical · X25519 + HKDF-SHA-256 · AES-256-GCM',
+};
+// Public key sizes identify the algorithm when a key is supplied by the server.
+const PUBLIC_KEY_SUITES = { 1216: SUITE_PQ, 32: SUITE_CLASSICAL };
+const PENDING_NOTE_KEY = 'dg:pending-delivery-note';
+const DB_NAME = 'daily-grind-secure';
+const STORE = 'keys';
+const COURIER_KEY_ID = 'courier-recipient-key';
+
+const utf8 = new TextEncoder();
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------
+
+function toBase64(bytes) {
+  if (typeof bytes.toBase64 === 'function') return bytes.toBase64();
+  let binary = '';
+  for (const b of bytes) binary += String.fromCharCode(b);
+  return btoa(binary);
+}
+
+function fromBase64(text) {
+  if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(text);
+  return Uint8Array.from(atob(text), (c) => c.charCodeAt(0));
+}
+
+function concatBytes(...parts) {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.byteLength, 0));
+  let offset = 0;
+  for (const p of parts) {
+    out.set(p, offset);
+    offset += p.byteLength;
+  }
+  return out;
+}
+
+async function keyFingerprint(publicKeyBytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKeyBytes));
+  return Array.from(digest.slice(0, 8), (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+// ---------------------------------------------------------------------------
+// Feature detection
+// ---------------------------------------------------------------------------
+
+function supportsPostQuantum() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') &&
+    SubtleCrypto.supports('decapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+  );
+}
+
+async function supportsX25519() {
+  try {
+    await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// IndexedDB persistence (non-extractable CryptoKeyPairs are structured-cloneable)
+// ---------------------------------------------------------------------------
+
+function withStore(mode, operation) {
+  return new Promise((resolve, reject) => {
+    const open = indexedDB.open(DB_NAME, 1);
+    open.onupgradeneeded = () => open.result.createObjectStore(STORE);
+    open.onerror = () => reject(open.error);
+    open.onsuccess = () => {
+      const db = open.result;
+      const tx = db.transaction(STORE, mode);
+      const request = operation(tx.objectStore(STORE));
+      tx.oncomplete = () => {
+        db.close();
+        resolve(request.result);
+      };
+      tx.onerror = tx.onabort = () => {
+        db.close();
+        reject(tx.error);
+      };
+    };
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Recipient (courier) keys
+// ---------------------------------------------------------------------------
+
+async function generateCourierKeys(suite) {
+  if (suite === SUITE_PQ) {
+    const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, [
+      'encapsulateKey',
+      'decapsulateKey',
+    ]);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return { suite, keyPair, publicKeyBytes };
+  }
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+  return { suite, keyPair, publicKeyBytes };
+}
+
+/**
+ * Production path: the courier's public key is published by the server in
+ * <meta name="dg-courier-public-key" content="BASE64">. Only the courier app
+ * holds the private key, so the page can seal but not open notes.
+ *
+ * Demo path: with no published key, a courier key pair is generated once and
+ * persisted (non-extractable) in IndexedDB so the "courier preview" can open notes.
+ */
+async function loadCourierKeys(bestSuite) {
+  const published = document.querySelector('meta[name="dg-courier-public-key"]')?.content.trim();
+  if (published) {
+    const publicKeyBytes = fromBase64(published);
+    const suite = PUBLIC_KEY_SUITES[publicKeyBytes.byteLength];
+    if (!suite) throw new Error('Unrecognized courier public key.');
+    if (suite === SUITE_PQ && bestSuite !== SUITE_PQ) {
+      throw new Error('This browser cannot seal notes to the post-quantum courier key.');
+    }
+    return { suite, keyPair: null, publicKeyBytes };
+  }
+
+  const stored = await withStore('readonly', (s) => s.get(COURIER_KEY_ID)).catch(() => undefined);
+  if (stored?.suite === bestSuite) {
+    return stored;
+  }
+  const fresh = await generateCourierKeys(bestSuite);
+  await withStore('readwrite', (s) => s.put(fresh, COURIER_KEY_ID)).catch(() => {
+    // Private browsing may block IndexedDB; the key then lives for this session only.
+  });
+  return fresh;
+}
+
+// ---------------------------------------------------------------------------
+// Envelope sealing / opening
+// ---------------------------------------------------------------------------
+
+function classicalInfo(ephemeralPublic, recipientPublic) {
+  // Domain separation: bind the derived key to the protocol and both public keys.
+  return concatBytes(utf8.encode(`${ENVELOPE_VERSION}|${SUITE_CLASSICAL}|`), ephemeralPublic, recipientPublic);
+}
+
+async function deriveClassicalKey(privateKey, peerPublicKey, info, usages) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    usages,
+  );
+}
+
+async function sealNote(courier, plaintext) {
+  const header = {
+    v: ENVELOPE_VERSION,
+    suite: courier.suite,
+    kid: await keyFingerprint(courier.publicKeyBytes),
+    createdAt: new Date().toISOString(),
+  };
+  const additionalData = utf8.encode(JSON.stringify(header));
+
+  let sharedKey;
+  let capsule;
+  if (courier.suite === SUITE_PQ) {
+    const recipientKey = await crypto.subtle.importKey(
+      'raw-public',
+      courier.publicKeyBytes,
+      'MLKEM768-X25519',
+      true,
+      ['encapsulateKey'],
+    );
+    const result = await crypto.subtle.encapsulateKey(
+      'MLKEM768-X25519',
+      recipientKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt'],
+    );
+    sharedKey = result.sharedKey;
+    capsule = new Uint8Array(result.ciphertext);
+  } else {
+    const recipientKey = await crypto.subtle.importKey('raw', courier.publicKeyBytes, 'X25519', true, []);
+    const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+    sharedKey = await deriveClassicalKey(
+      ephemeral.privateKey,
+      recipientKey,
+      classicalInfo(capsule, courier.publicKeyBytes),
+      ['encrypt'],
+    );
+  }
+
+  // Fresh 96-bit IV per message; the one-time key is never reused anyway.
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = new Uint8Array(
+    await crypto.subtle.encrypt(
+      { name: sharedKey.algorithm.name, iv, additionalData },
+      sharedKey,
+      utf8.encode(plaintext),
+    ),
+  );
+
+  return {
+    header,
+    capsule: toBase64(capsule),
+    iv: toBase64(iv),
+    ciphertext: toBase64(ciphertext),
+  };
+}
+
+async function openNote(courier, envelope) {
+  const { header } = envelope;
+  if (header.v !== ENVELOPE_VERSION || header.suite !== courier.suite) {
+    throw new Error('Unsupported envelope.');
+  }
+  if (header.kid !== (await keyFingerprint(courier.publicKeyBytes))) {
+    throw new Error('Envelope was sealed to a different courier key.');
+  }
+  const additionalData = utf8.encode(JSON.stringify(header));
+  const capsule = fromBase64(envelope.capsule);
+
+  let sharedKey;
+  if (courier.suite === SUITE_PQ) {
+    sharedKey = await crypto.subtle.decapsulateKey(
+      'MLKEM768-X25519',
+      courier.keyPair.privateKey,
+      capsule,
+      'ChaCha20-Poly1305',
+      false,
+      ['decrypt'],
+    );
+  } else {
+    const ephemeralPublic = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+    sharedKey = await deriveClassicalKey(
+      courier.keyPair.privateKey,
+      ephemeralPublic,
+      classicalInfo(capsule, courier.publicKeyBytes),
+      ['decrypt'],
+    );
+  }
+
+  const plaintext = await crypto.subtle.decrypt(
+    { name: sharedKey.algorithm.name, iv: fromBase64(envelope.iv), additionalData },
+    sharedKey,
+    fromBase64(envelope.ciphertext),
+  );
+  return new TextDecoder().decode(plaintext);
+}
+
+// ---------------------------------------------------------------------------
+// UI wiring
+// ---------------------------------------------------------------------------
+
+async function init() {
+  const root = document.getElementById('delivery-notes');
+  if (!root) return;
+
+  const form = root.querySelector('#delivery-note-form');
+  const textarea = root.querySelector('#delivery-note');
+  const submitButton = form.querySelector('button[type="submit"]');
+  const status = root.querySelector('#delivery-note-status');
+  const suiteLabel = root.querySelector('#delivery-note-suite');
+  const fingerprint = root.querySelector('#delivery-note-kid');
+  const result = root.querySelector('#delivery-note-result');
+  const envelopeOutput = root.querySelector('#delivery-note-envelope');
+  const sizeOutput = root.querySelector('#delivery-note-size');
+  const copyButton = root.querySelector('#delivery-note-copy');
+  const previewButton = root.querySelector('#delivery-note-preview');
+  const previewOutput = root.querySelector('#delivery-note-plaintext');
+  const discardButton = root.querySelector('#delivery-note-discard');
+
+  const setStatus = (message, tone = 'info') => {
+    status.textContent = message;
+    status.dataset.tone = tone;
+  };
+
+  if (!globalThis.crypto?.subtle) {
+    setStatus('Encrypted notes need a secure (HTTPS) connection and a modern browser.', 'error');
+    form.inert = true;
+    return;
+  }
+
+  let bestSuite;
+  if (supportsPostQuantum()) bestSuite = SUITE_PQ;
+  else if (await supportsX25519()) bestSuite = SUITE_CLASSICAL;
+  else {
+    setStatus('Your browser does not support the encryption needed for secure notes.', 'error');
+    form.inert = true;
+    return;
+  }
+
+  let courier;
+  try {
+    courier = await loadCourierKeys(bestSuite);
+  } catch (error) {
+    setStatus(error.message, 'error');
+    form.inert = true;
+    return;
+  }
+
+  suiteLabel.textContent = SUITE_LABELS[courier.suite];
+  fingerprint.textContent = (await keyFingerprint(courier.publicKeyBytes)).match(/.{4}/g).join(' ');
+  root.dataset.suite = courier.suite === SUITE_PQ ? 'pq' : 'classical';
+  previewButton.hidden = !courier.keyPair;
+
+  const showEnvelope = (envelope) => {
+    const json = JSON.stringify(envelope, null, 2);
+    envelopeOutput.textContent = json;
+    sizeOutput.textContent = `${utf8.encode(json).byteLength.toLocaleString()} bytes`;
+    previewOutput.textContent = '';
+    previewOutput.hidden = true;
+    result.hidden = false;
+  };
+
+  const existing = localStorage.getItem(PENDING_NOTE_KEY);
+  if (existing) {
+    try {
+      showEnvelope(JSON.parse(existing));
+      setStatus('A sealed note is attached to your next order.', 'success');
+    } catch {
+      localStorage.removeItem(PENDING_NOTE_KEY);
+    }
+  }
+
+  textarea.addEventListener('input', () => textarea.setCustomValidity(''));
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const note = textarea.value.trim();
+    if (!note) {
+      textarea.setCustomValidity('Write a note for your courier first.');
+      textarea.reportValidity();
+      return;
+    }
+
+    submitButton.disabled = true;
+    setStatus('Sealing your note…');
+    try {
+      const envelope = await sealNote(courier, note);
+      // Only the sealed envelope is kept; checkout uploads it with the order.
+      localStorage.setItem(PENDING_NOTE_KEY, JSON.stringify(envelope));
+      textarea.value = '';
+      showEnvelope(envelope);
+      setStatus('Note sealed. Only your courier can read it, and it is attached to your next order.', 'success');
+    } catch (error) {
+      console.error(error);
+      setStatus('Something went wrong while encrypting. Your note was not saved.', 'error');
+    } finally {
+      submitButton.disabled = false;
+    }
+  });
+
+  copyButton.addEventListener('click', async () => {
+    try {
+      await navigator.clipboard.writeText(envelopeOutput.textContent);
+      setStatus('Sealed envelope copied to clipboard.', 'success');
+    } catch {
+      setStatus('Copy failed. Select the envelope text to copy it manually.', 'error');
+    }
+  });
+
+  previewButton.addEventListener('click', async () => {
+    try {
+      const envelope = JSON.parse(envelopeOutput.textContent);
+      previewOutput.textContent = await openNote(courier, envelope);
+      previewOutput.hidden = false;
+      setStatus('Decrypted and authenticated with the courier key.', 'success');
+    } catch (error) {
+      previewOutput.hidden = true;
+      setStatus(
+        error.name === 'OperationError'
+          ? 'Authentication failed: the envelope was modified or sealed to another key.'
+          : error.message,
+        'error',
+      );
+    }
+  });
+
+  discardButton.addEventListener('click', () => {
+    localStorage.removeItem(PENDING_NOTE_KEY);
+    envelopeOutput.textContent = '';
+    previewOutput.textContent = '';
+    result.hidden = true;
+    setStatus('Sealed note removed.');
+    textarea.focus();
+  });
+}
+
+init();
