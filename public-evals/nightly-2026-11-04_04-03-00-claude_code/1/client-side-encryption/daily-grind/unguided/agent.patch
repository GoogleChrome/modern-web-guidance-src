@@ -0,0 +1,25 @@
+#!/usr/bin/env node
+// Generates the store's X-Wing (ML-KEM-768 + X25519) delivery-notes key pair.
+//   public key -> keys/delivery-notes.json  (served to browsers)
+//   secret key -> secrets/delivery-notes.secret.json (KEEP OFFLINE / in a secret store, never deploy)
+import { mkdirSync, writeFileSync, existsSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { SUITE, generateRecipientKeys, toB64u } from '../js/delivery-crypto.mjs';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const pubPath = resolve(root, 'keys/delivery-notes.json');
+const secPath = resolve(process.argv[2] ?? resolve(root, 'secrets/delivery-notes.secret.json'));
+
+if (existsSync(secPath) && !process.argv.includes('--force')) {
+  console.error(`Refusing to overwrite ${secPath} (pass --force to rotate).`);
+  process.exit(1);
+}
+
+const { publicKey, secretKey, kid } = await generateRecipientKeys();
+mkdirSync(dirname(pubPath), { recursive: true });
+mkdirSync(dirname(secPath), { recursive: true, mode: 0o700 });
+writeFileSync(pubPath, JSON.stringify({ suite: SUITE, kid, publicKey: toB64u(publicKey) }, null, 2) + '\n');
+writeFileSync(secPath, JSON.stringify({ suite: SUITE, kid, secretKey: toB64u(secretKey) }) + '\n', { mode: 0o600 });
+secretKey.fill(0);
+console.log(`Generated delivery key ${kid}\n  public: ${pubPath}\n  secret: ${secPath}`);
