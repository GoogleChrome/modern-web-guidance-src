@@ -0,0 +1,23 @@
+#!/usr/bin/env node
+// Store-side: decrypt an encrypted_note envelope.
+//   node scripts/decrypt-note.mjs <secret.json> < envelope.json
+import { readFileSync } from 'node:fs';
+import { SUITE, fromB64u, openNote } from '../js/delivery-crypto.mjs';
+
+const [secPath] = process.argv.slice(2);
+if (!secPath) {
+  console.error('usage: decrypt-note.mjs <secret.json> < envelope.json');
+  process.exit(2);
+}
+const sec = JSON.parse(readFileSync(secPath, 'utf8'));
+if (sec.suite !== SUITE) throw new Error('Secret key suite mismatch.');
+const secretKey = fromB64u(sec.secretKey);
+const envelope = JSON.parse(readFileSync(0, 'utf8'));
+try {
+  console.log(await openNote(envelope, secretKey));
+} catch (err) {
+  console.error(err.message);
+  process.exitCode = 1;
+} finally {
+  secretKey.fill(0);
+}
