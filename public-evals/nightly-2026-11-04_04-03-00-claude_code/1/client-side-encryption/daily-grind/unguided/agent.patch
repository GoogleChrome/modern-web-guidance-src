+++ b/scripts/test-delivery-crypto.mjs
@@ -0,0 +1,34 @@
+#!/usr/bin/env node
+import assert from 'node:assert/strict';
+import { generateRecipientKeys, importRecipientKey, openNote, sealNote, toB64u, fromB64u, SUITE } from '../js/delivery-crypto.mjs';
+
+const r = await generateRecipientKeys();
+const pub = await importRecipientKey({ suite: SUITE, kid: r.kid, publicKey: toB64u(r.publicKey) });
+const note = 'Gate code 4821 — leave at side door. Nut allergy ☕';
+const env = await sealNote(note, 'DG-10482', pub);
+assert.equal(await openNote(env, r.secretKey), note);
+
+// Fresh encapsulation + IV each time
+const env2 = await sealNote(note, 'DG-10482', pub);
+assert.notEqual(env.enc, env2.enc);
+assert.notEqual(env.ct, env2.ct);
+
+// Header (AAD) tampering is detected
+await assert.rejects(openNote({ ...env, orderId: 'DG-99999' }, r.secretKey), /Authentication failed/);
+// Ciphertext tampering is detected
+const ct = fromB64u(env.ct); ct[0] ^= 1;
+await assert.rejects(openNote({ ...env, ct: toB64u(ct) }, r.secretKey), /Authentication failed/);
+// KEM ciphertext tampering is detected (implicit rejection -> wrong key)
+const enc = fromB64u(env.enc); enc[5] ^= 1;
+await assert.rejects(openNote({ ...env, enc: toB64u(enc) }, r.secretKey), /Authentication failed/);
+// Wrong recipient key
+const other = await generateRecipientKeys();
