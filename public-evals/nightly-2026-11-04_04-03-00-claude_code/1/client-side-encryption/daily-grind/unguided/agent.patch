@@ -0,0 +1,131 @@
+// Homepage UI for encrypted delivery notes.
+// The plaintext note never leaves the browser. Only the sealed envelope goes
+// into the form's hidden field. The textarea deliberately has no `name`, so it
+// is never submitted.
+
+import {
+  MAX_NOTE_CHARS,
+  SUITE,
+  generateRecipientKeys,
+  importRecipientKey,
+  openNote,
+  sealNote,
+} from './delivery-crypto.mjs';
+
+const KEY_URL = '/keys/delivery-notes.json';
+
+const $ = (id) => document.getElementById(id);
+const form = $('dn-form');
+const noteEl = $('dn-note');
+const orderEl = $('dn-order');
+const countEl = $('dn-count');
+const statusEl = $('dn-status');
+const keyInfoEl = $('dn-keyinfo');
+const outWrap = $('dn-output');
+const outEl = $('dn-envelope');
+const hiddenEl = $('dn-encrypted');
+const sealBtn = $('dn-seal');
+const submitBtn = $('dn-submit');
+const demoWrap = $('dn-demo');
+const demoBtn = $('dn-demo-decrypt');
+const demoOut = $('dn-demo-result');
+
+let recipient = null;
+let demoSecretKey = null; // only set in demo mode (no published store key)
+let envelope = null;
+
+function setStatus(msg, kind = 'info') {
+  statusEl.textContent = msg;
+  statusEl.dataset.kind = kind;
+}
+
+function resetSealed() {
+  envelope = null;
+  hiddenEl.value = '';
+  outWrap.hidden = true;
+  submitBtn.disabled = true;
+  demoOut.textContent = '';
+}
+
+async function loadRecipient() {
+  try {
+    const res = await fetch(KEY_URL, { cache: 'no-cache', credentials: 'same-origin' });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    recipient = await importRecipientKey(await res.json());
+    keyInfoEl.textContent = `Store key ${recipient.kid} · ${SUITE}`;
+    demoWrap.hidden = true;
+  } catch (err) {
+    // No published store key. Fall back to a throwaway in-browser key pair so
+    // the flow can still be demonstrated. Notes sealed this way can only be
+    // opened on this page, so submitting them to the store is disabled.
+    const keys = await generateRecipientKeys();
+    recipient = { publicKey: keys.publicKey, kid: keys.kid };
+    demoSecretKey = keys.secretKey;
+    keyInfoEl.textContent = `Demo mode: no store key found at ${KEY_URL}, so a temporary key ${keys.kid} was generated in this tab.`;
+    demoWrap.hidden = false;
+    console.warn('Delivery notes: falling back to demo key:', err);
+  }
+}
+
+noteEl.maxLength = MAX_NOTE_CHARS;
+noteEl.addEventListener('input', () => {
+  countEl.textContent = `${noteEl.value.length} / ${MAX_NOTE_CHARS}`;
+  resetSealed();
+});
+orderEl.addEventListener('input', resetSealed);
+
+sealBtn.addEventListener('click', async () => {
+  resetSealed();
+  if (!recipient) return setStatus('The encryption key is still loading. Try again in a moment.', 'error');
+  sealBtn.disabled = true;
+  try {
+    envelope = await sealNote(noteEl.value, orderEl.value.trim(), recipient);
+    const json = JSON.stringify(envelope);
+    hiddenEl.value = json;
+    outEl.textContent = JSON.stringify(envelope, null, 2);
+    outWrap.hidden = false;
+    submitBtn.disabled = Boolean(demoSecretKey);
+    setStatus(
+      demoSecretKey
+        ? 'Your note is encrypted (demo key). You can test decryption below.'
+        : 'Your note is encrypted. Only the store can read it.',
+      'ok',
+    );
+  } catch (err) {
+    setStatus(err.message, 'error');
+  } finally {
+    sealBtn.disabled = false;
+  }
+});
+
+demoBtn.addEventListener('click', async () => {
+  if (!envelope || !demoSecretKey) return;
+  try {
+    demoOut.textContent = `Decrypted: ${await openNote(envelope, demoSecretKey)}`;
+  } catch (err) {
+    demoOut.textContent = err.message;
+  }
+});
+
+form.addEventListener('submit', (e) => {
+  // Never submit unless a sealed envelope matches the current input.
+  if (!envelope || demoSecretKey) {
+    e.preventDefault();
+    setStatus('Encrypt your note before sending it.', 'error');
+    return;
+  }
+  // Clear the plaintext from the page once the encrypted version is sent.
+  noteEl.value = '';
+});
+
+(async () => {
+  if (!globalThis.crypto?.subtle) {
+    sealBtn.disabled = true;
+    setStatus('Encrypted notes need a secure (https) connection.', 'error');
+    return;
+  }
+  setStatus('Loading encryption key…');
+  await loadRecipient();
+  setStatus('Ready. Your note is encrypted on this device before it is sent.');
+  sealBtn.disabled = false;
+})();
