index 0000000..4e07398
--- /dev/null
+++ b/js/delivery-crypto.mjs
@@ -0,0 +1,173 @@
+// Delivery-note envelope encryption.
+//
+// Runs both in the browser and in Node (>= 20) via the standard WebCrypto API,
+// so the customer-facing page and the store's decryption tooling share one
+// implementation.
+//
+// Construction (HPKE-style "KEM + KDF + AEAD"):
+//   KEM  : X-Wing (ML-KEM-768 + X25519 hybrid, draft-connolly-cfrg-xwing-kem).
+//          The shared secret stays safe as long as EITHER the classical (X25519)
+//          OR the post-quantum (ML-KEM-768, FIPS 203) component is unbroken.
+//   KDF  : HKDF-SHA-256, salted with the KEM ciphertext, bound to the
+//          suite id and recipient key id.
+//   AEAD : AES-256-GCM, with the envelope header as associated data, so the
+//          order id, key id, version and algorithm can't be swapped or edited
+//          without decryption failing.
+//
+// Every note gets a fresh encapsulation, which means a fresh one-time AES key.
+
+import { ml_kem768_x25519 as xwing } from '../vendor/noble-post-quantum-0.7.1-hybrid.mjs';
+
+export const SUITE = 'DG-NOTES-v1/X-Wing/HKDF-SHA256/AES-256-GCM';
+export const VERSION = 1;
+export const MAX_NOTE_CHARS = 1000;
+
+const PUBLIC_KEY_LEN = 1216;
+const KEM_CT_LEN = 1120;
+const IV_LEN = 12;
+
+const subtle = globalThis.crypto?.subtle;
+const te = new TextEncoder();
+const td = new TextDecoder('utf-8', { fatal: true });
+
+function requireWebCrypto() {
+  if (!subtle) {
+    throw new Error('WebCrypto is unavailable (a secure https:// context is required).');
+  }
+}
+
+// ---------- base64url ----------
+export function toB64u(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function fromB64u(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url data.');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+// ---------- helpers ----------
+async function sha256(bytes) {
+  return new Uint8Array(await subtle.digest('SHA-256', bytes));
+}
+
+/** Short, stable id for a public key: base64url(SHA-256(pk))[0..16]. */
+export async function keyIdFor(publicKey) {
+  requireWebCrypto();
+  return toB64u(await sha256(publicKey)).slice(0, 16);
+}
+
+/** Canonical associated data: fixed field order, so sender and receiver agree on the exact bytes. */
+function headerAad(h) {
+  return te.encode(JSON.stringify([h.v, h.suite, h.kid, h.orderId]));
+}
+
+async function deriveAeadKey(sharedSecret, kemCt, kid, usage) {
+  const ikm = await subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: await sha256(kemCt), info: te.encode(`${SUITE}|${kid}`) },
+    ikm,
+    { name: 'AES-GCM', length: 256 },
+    false, // non-extractable
+    [usage],
+  );
+}
+
+function validateOrderId(orderId) {
+  if (typeof orderId !== 'string' || !/^[A-Za-z0-9-]{1,40}$/.test(orderId)) {
+    throw new Error('Order reference must be 1–40 letters, digits or dashes.');
+  }
+}
+
+// ---------- key management ----------
+/** Generate a recipient (store) key pair. The secret key must never ship to the browser. */
+export async function generateRecipientKeys() {
+  const { publicKey, secretKey } = xwing.keygen();
+  return { publicKey, secretKey, kid: await keyIdFor(publicKey) };
+}
+
+/**
+ * Parse and check a published recipient key document:
+ *   { "suite": SUITE, "kid": "...", "publicKey": "<base64url>" }
+ * The kid is recomputed from the key bytes, so a mismatched document is rejected.
+ */
+export async function importRecipientKey(doc) {
+  if (!doc || doc.suite !== SUITE) throw new Error('Unsupported delivery key suite.');
+  const publicKey = fromB64u(doc.publicKey);
+  if (publicKey.length !== PUBLIC_KEY_LEN) throw new Error('Delivery key has the wrong length.');
+  const kid = await keyIdFor(publicKey);
+  if (doc.kid !== kid) throw new Error('Delivery key id does not match the key bytes.');
+  return { publicKey, kid };
+}
+
+// ---------- seal / open ----------
+/** Encrypt a delivery note for the recipient key. Returns a JSON-serialisable envelope. */
+export async function sealNote(note, orderId, recipient) {
+  requireWebCrypto();
+  validateOrderId(orderId);
+  if (typeof note !== 'string' || note.trim() === '') throw new Error('Note is empty.');
+  if (note.length > MAX_NOTE_CHARS) throw new Error(`Note exceeds ${MAX_NOTE_CHARS} characters.`);
+
+  // Fresh hybrid encapsulation for every note.
+  const { cipherText: kemCt, sharedSecret } = xwing.encapsulate(recipient.publicKey);
+  let key;
+  try {
+    key = await deriveAeadKey(sharedSecret, kemCt, recipient.kid, 'encrypt');
+  } finally {
+    sharedSecret.fill(0);
+  }
+
+  const header = { v: VERSION, suite: SUITE, kid: recipient.kid, orderId };
+  const iv = crypto.getRandomValues(new Uint8Array(IV_LEN));
+  const plaintext = te.encode(note);
+  const ct = new Uint8Array(
+    await subtle.encrypt({ name: 'AES-GCM', iv, additionalData: headerAad(header), tagLength: 128 }, key, plaintext),
+  );
+  plaintext.fill(0);
+
+  return { ...header, enc: toB64u(kemCt), iv: toB64u(iv), ct: toB64u(ct) };
+}
+
+/** Decrypt an envelope with the recipient secret key (store side / demo only). */
+export async function openNote(envelope, secretKey) {
+  requireWebCrypto();
+  if (!envelope || envelope.v !== VERSION || envelope.suite !== SUITE) {
+    throw new Error('Unsupported envelope version or suite.');
+  }
+  validateOrderId(envelope.orderId);
+  const kemCt = fromB64u(envelope.enc);
+  const iv = fromB64u(envelope.iv);
+  const ct = fromB64u(envelope.ct);
+  if (kemCt.length !== KEM_CT_LEN || iv.length !== IV_LEN || ct.length < 16) {
+    throw new Error('Malformed envelope.');
+  }
+
+  // Make sure the envelope is addressed to this key before doing any work.
+  const kid = await keyIdFor(xwing.getPublicKey(secretKey));
+  if (envelope.kid !== kid) throw new Error('Envelope was sealed for a different key.');
+
+  const sharedSecret = xwing.decapsulate(kemCt, secretKey);
+  let key;
+  try {
+    key = await deriveAeadKey(sharedSecret, kemCt, kid, 'decrypt');
+  } finally {
+    sharedSecret.fill(0);
+  }
+
+  const header = { v: envelope.v, suite: envelope.suite, kid: envelope.kid, orderId: envelope.orderId };
+  let pt;
+  try {
+    pt = await subtle.decrypt({ name: 'AES-GCM', iv, additionalData: headerAad(header), tagLength: 128 }, key, ct);
+  } catch {
+    throw new Error('Authentication failed: the note was tampered with or the wrong key was used.');
+  }
+  return td.decode(pt);
+}
