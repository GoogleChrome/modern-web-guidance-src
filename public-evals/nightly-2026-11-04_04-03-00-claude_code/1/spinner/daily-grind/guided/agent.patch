+  <p id="loading-status" class="visually-hidden" role="status"></p>
+
+  <script>
+    (() => {
+      const status = document.getElementById('loading-status');
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[data-loading-label]');
+        if (!link) return;
+        // Let modified clicks (new tab/window, downloads) behave normally.
+        if (event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        const label = link.dataset.loadingLabel;
+        const region = link.closest('.card, .hero');
+        const spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', label);
+
+        link.setAttribute('aria-disabled', 'true');
+        region?.setAttribute('aria-busy', 'true');
+        link.prepend(spinner);
+        status.textContent = `${label}\u2026`;
+      });
+
+      // Reset if the page is restored from the back/forward cache.
+      window.addEventListener('pageshow', (event) => {
+        if (!event.persisted) return;
+        document.querySelectorAll('a[data-loading-label] .loading-spinner').forEach((el) => el.remove());
+        document.querySelectorAll('a[data-loading-label][aria-disabled]').forEach((el) => el.removeAttribute('aria-disabled'));
+        document.querySelectorAll('[aria-busy]').forEach((el) => el.removeAttribute('aria-busy'));
+        status.textContent = '';
+      });
+    })();
+  </script>
+
