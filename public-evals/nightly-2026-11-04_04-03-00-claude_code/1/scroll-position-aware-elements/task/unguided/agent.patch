+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var sentinel = scroller && scroller.querySelector('.scroll-sentinel');
+      var button = scroller && scroller.querySelector('.back-to-top');
+      if (!scroller || !sentinel || !button || !('IntersectionObserver' in window)) return;
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Fires only when the sentinel crosses the scroller's edge, not on
+      // every scroll frame.
+      var observer = new IntersectionObserver(function (entries) {
+        var entry = entries[entries.length - 1];
+        button.classList.toggle('is-visible', !entry.isIntersecting);
+      }, { root: scroller });
+      observer.observe(sentinel);
+
+      button.addEventListener('click', function () {
+        scroller.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // The button is about to hide; move focus to the top of the content
+        // so keyboard users aren't left on a hidden element.
+        scroller.focus({ preventScroll: true });
+      });
+    })();
+  </script>
