+  <script>
+    (() => {
+      const navLinks = document.querySelectorAll('nav a[href^="#"]');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let currentScrollId = 0;
+
+      // Resolve once a programmatic scroll has finished. Uses the Promise returned
+      // by scrollIntoView() where supported, otherwise falls back to `scrollend`
+      // plus an idle timeout (covers "already in view" and no-scrollend browsers).
+      function scrollIntoViewAsync(element, options, scroller = window) {
+        const result = element.scrollIntoView(options);
+        if (result instanceof Promise) return result;
+
+        return new Promise((resolve) => {
+          let timeoutId;
+
+          const finish = () => {
+            clearTimeout(timeoutId);
+            scroller.removeEventListener('scrollend', finish);
+            scroller.removeEventListener('scroll', onScroll);
+            resolve();
+          };
+
+          const onScroll = () => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(finish, 100);
+          };
+
+          scroller.addEventListener('scrollend', finish, { once: true });
+          scroller.addEventListener('scroll', onScroll, { passive: true });
+          timeoutId = setTimeout(finish, 100);
+        });
+      }
+
+      async function navigateTo(section, link) {
+        const scrollId = ++currentScrollId;
+
+        document.querySelectorAll('main section.is-arrived')
+          .forEach((sec) => sec.classList.remove('is-arrived'));
+        navLinks.forEach((a) => a.removeAttribute('aria-current'));
+        link?.setAttribute('aria-current', 'true');
+
+        await scrollIntoViewAsync(section, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        // A newer navigation superseded this one while we were scrolling.
+        if (scrollId !== currentScrollId) return;
+
+        // Effects run only after the scroll has settled.
+        section.classList.add('is-arrived');
+        const heading = section.querySelector('h2[tabindex="-1"]') || section;
+        heading.focus({ preventScroll: true });
+      }
+
+      document.querySelectorAll('main section').forEach((sec) => {
+        sec.addEventListener('animationend', (event) => {
+          if (event.target === sec) sec.classList.remove('is-arrived');
+        });
+      });
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const section = document.getElementById(link.hash.slice(1));
+          if (!section) return;
+          event.preventDefault();
+          if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+          navigateTo(section, link);
+        });
+      });
+    })();
+  </script>
+
