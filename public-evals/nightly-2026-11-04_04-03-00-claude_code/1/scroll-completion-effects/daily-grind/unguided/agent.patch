+  <script>
+    (function () {
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var supportsScrollEnd = 'onscrollend' in window;
+      var pending = null; // cleanup for the in-flight navigation
+
+      // Calls onDone once the smooth scroll has stopped. Uses the native
+      // `scrollend` event where supported; otherwise waits for the scroll
+      // position to stay unchanged for several frames. Polling also catches the
+      // case where no scroll happens at all (already at the target), and a
+      // timeout acts as a safety net. Returns a cancel function.
+      function waitForScrollEnd(onDone) {
+        var done = false;
+        var moved = false;
+        var lastY = window.scrollY;
+        var stillFrames = 0;
+        var rafId, timeoutId;
+
+        function stop() {
+          done = true;
+          cancelAnimationFrame(rafId);
+          clearTimeout(timeoutId);
+          window.removeEventListener('scrollend', finish);
+        }
+
+        function finish() {
+          if (done) return;
+          stop();
+          onDone();
+        }
+
+        function tick() {
+          var y = window.scrollY;
+          if (y !== lastY) {
+            moved = true;
+            stillFrames = 0;
+            lastY = y;
+          } else {
+            stillFrames++;
+          }
+          var ended = supportsScrollEnd
+            ? (!moved && stillFrames >= 10)            // never started scrolling
+            : stillFrames >= (moved ? 5 : 10);         // settled, or never moved
+          if (ended) return finish();
+          rafId = requestAnimationFrame(tick);
+        }
+
+        if (supportsScrollEnd) window.addEventListener('scrollend', finish);
+        rafId = requestAnimationFrame(tick);
+        timeoutId = setTimeout(finish, 3000);
+        return stop;
+      }
+
+      function activate(target, link) {
+        // Restart the animation even if this section was the previous target.
+        target.classList.remove('is-arrived');
+        void target.offsetWidth;
+        target.classList.add('is-arrived');
+
+        // Move focus for keyboard / screen-reader users without re-scrolling.
+        target.focus({ preventScroll: true });
+
+        document.querySelectorAll('nav a.is-active').forEach(function (a) {
+          a.classList.remove('is-active');
+        });
+        if (link && link.closest('nav')) link.classList.add('is-active');
+      }
+
+      function navigateTo(target, link, pushHistory) {
+        if (pending) pending();
+        pending = null;
+
+        document.querySelectorAll('.nav-target.is-arrived').forEach(function (el) {
+          if (el !== target) el.classList.remove('is-arrived');
+        });
+
+        if (pushHistory && location.hash !== '#' + target.id) {
+          history.pushState(null, '', '#' + target.id);
+        }
+
+        var smooth = !reduceMotion.matches;
+        if (!smooth) {
+          target.scrollIntoView({ behavior: 'auto', block: 'start' });
+          activate(target, link);
+          return;
+        }
+
+        // Start listening before scrolling so we never miss the end event.
+        pending = waitForScrollEnd(function () {
+          pending = null;
+          activate(target, link);
+        });
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      }
+
+      document.addEventListener('click', function (e) {
+        if (e.defaultPrevented || e.button !== 0 ||
+            e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        var link = e.target.closest('a[href^="#"]');
+        if (!link) return;
+        var id = decodeURIComponent(link.getAttribute('href').slice(1));
+        var target = id && document.getElementById(id);
+        if (!target) return;
+        e.preventDefault();
+        navigateTo(target, link, true);
+      });
+
+      // Back/forward between hashes: smooth scroll, then highlight.
+      window.addEventListener('popstate', function () {
