+      height: 1.1em;
+      background-color: currentColor;
+      mask: var(--btn-icon) no-repeat center / contain;
+      pointer-events: none;
+      forced-color-adjust: none;
+    }
+
+    .btn--order {
+      --btn-icon: var(--icon-cup);
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+      box-shadow: 0 4px 14px rgba(255, 171, 64, 0.4);
