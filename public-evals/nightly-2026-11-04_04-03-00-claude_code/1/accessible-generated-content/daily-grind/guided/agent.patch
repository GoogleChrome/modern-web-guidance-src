+
+    .btn--order:hover {
+      background: #ffc370;
+    }
+
+    .btn--details {
+      --btn-icon: var(--icon-arrow);
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .btn--details::after {
