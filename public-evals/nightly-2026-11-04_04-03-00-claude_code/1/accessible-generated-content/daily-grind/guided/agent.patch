+      content: "\1F341";
+      content: "\1F341" / "";
+    }
+
+    .card h3.drink--cold-brew::before {
+      content: "\1F9CA";
+      content: "\1F9CA" / "";
+    }
+
+    /* Buttons: masked SVG icons that follow currentColor */
+    .btn--icon {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5em;
+    }
+
+    .btn--order::before,
+    .btn--details::after {
