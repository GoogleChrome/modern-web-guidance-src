+
+    .card h3::before {
+      content: "\2615";
+      content: "\2615" / "";
+      display: grid;
+      place-items: center;
+      width: 2.75rem;
+      height: 2.75rem;
+      margin: 0 auto 0.5rem;
+      border-radius: 50%;
+      background: var(--secondary);
+      box-shadow: 0 0 0 4px white, 0 0 0 6px var(--accent);
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .card h3::after {
+      content: "";
+      position: absolute;
+      inset-inline: 35%;
+      bottom: 0;
+      height: 3px;
+      border-radius: 3px;
+      background: linear-gradient(to right, transparent, var(--accent), transparent);
+    }
+
+    /* Per-drink badge glyphs (espresso uses the default cup) */
