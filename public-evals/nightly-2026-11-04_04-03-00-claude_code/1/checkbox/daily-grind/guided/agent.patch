+        transition: scale 0.12s ease-in;
+      }
+
+      .checkbox-custom:is(:checked, :indeterminate)::before {
+        transition: scale 0.3s cubic-bezier(0.34, 1.8, 0.64, 1);
+      }
+
+      .option:has(:checked) .option-icon {
+        rotate: -12deg;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .checkbox-custom {
+        border-color: CanvasText;
+      }
+
+      .checkbox-custom::before {
+        background-color: CanvasText;
+      }
+    }
+
+    .card .btn {
