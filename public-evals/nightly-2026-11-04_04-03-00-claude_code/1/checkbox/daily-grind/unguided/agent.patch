+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    /* Seasonal cards: stack content so buttons line up across cards */
+    .drink-card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .drink-card .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    /* Customization checkboxes */
+    .customize {
+      border: none;
+      margin: 18px 0 20px;
+      padding: 14px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+      min-width: 0;
+    }
+
+    .customize legend {
+      padding: 0 8px;
+      margin: 0 auto;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 1.5px;
+      text-transform: uppercase;
+      color: #8d6e63;
+    }
+
+    .customize ul {
+      list-style: none;
+      display: grid;
+      gap: 8px;
+      margin-top: 6px;
+    }
+
+    .option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 9px 12px;
+      border: 2px solid var(--secondary);
+      border-radius: 10px;
+      background: #fffaf5;
+      cursor: pointer;
+      transition: border-color 0.25s, background-color 0.25s, box-shadow 0.25s, transform 0.15s;
+    }
+
+    /*
+     * The real checkbox stays in the DOM, keyboard-focusable, and announced
+     * by screen readers. It is made transparent and stretched over the whole
+     * option, so clicks/taps (and touch exploration) hit the native control.
+     */
+    .option input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .option-icon {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 34px;
+      height: 34px;
+      border-radius: 50%;
+      background: var(--secondary);
+      color: var(--primary);
+      transition: background-color 0.3s, color 0.3s, transform 0.4s cubic-bezier(.34, 1.56, .64, 1);
+    }
+
+    .option-icon svg {
+      width: 20px;
+      height: 20px;
+    }
+
+    .option-text {
+      flex: 1;
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 8px;
+      font-size: 0.92rem;
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .option-price {
+      font-size: 0.8rem;
+      font-weight: 500;
+      color: #8d6e63;
+      white-space: nowrap;
+    }
+
+    /* Custom check box */
+    .option-box {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      border: 2px solid #a1887f;
+      border-radius: 6px;
+      background: white;
+      transition: background-color 0.25s, border-color 0.25s, transform 0.3s cubic-bezier(.34, 1.56, .64, 1);
+    }
+
+    .option-box svg {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: white;
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.3s ease 0.05s;
+    }
+
+    /* Hover */
+    .option:hover {
+      border-color: #bcaaa4;
+      box-shadow: 0 2px 8px rgba(78, 52, 46, 0.12);
+    }
+
+    .option:active {
+      transform: scale(0.98);
+    }
+
+    /* Checked */
+    .option input:checked ~ .option-box {
+      background: var(--primary);
+      border-color: var(--primary);
+      animation: box-pop 0.35s cubic-bezier(.34, 1.56, .64, 1);
+    }
+
+    .option input:checked ~ .option-box svg {
+      stroke-dashoffset: 0;
+    }
+
+    .option input:checked ~ .option-icon {
+      background: var(--accent);
+      color: var(--text);
+      transform: rotate(-12deg) scale(1.08);
+    }
+
+    .option:has(input:checked) {
+      border-color: var(--primary);
+      background: #fff3e0;
+    }
+
+    /* Keyboard focus ring (native input is focused; ring drawn on the row) */
+    .option:has(input:focus-visible) {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Fallback for browsers without :has() */
+    .option input:focus-visible ~ .option-box {
+      box-shadow: 0 0 0 3px var(--accent);
+    }
+
+    /* Disabled */
+    .option:has(input:disabled) {
+      opacity: 0.55;
+      cursor: not-allowed;
+    }
+
+    .option input:disabled {
+      cursor: not-allowed;
+    }
+
+    @keyframes box-pop {
+      0% { transform: scale(0.7); }
+      60% { transform: scale(1.15); }
+      100% { transform: scale(1); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option-icon,
+      .option-box,
+      .option-box svg {
+        transition: none;
+        animation: none !important;
+      }
+
+      .option input:checked ~ .option-icon {
+        transform: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep state visible */
+    @media (forced-colors: active) {
+      .option {
+        border-color: CanvasText;
+      }
+
+      .option-box {
+        border-color: CanvasText;
+      }
+
+      .option input:checked ~ .option-box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option-box svg {
+        stroke: HighlightText;
+      }
+
+      .option:has(input:focus-visible) {
+        outline-color: Highlight;
+      }
+    }
+
