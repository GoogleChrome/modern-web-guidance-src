+  <script>
+    (() => {
+      const player = document.getElementById('video-player');
+      const iframe = document.getElementById('roast-video');
+      const toggle = document.getElementById('theater-toggle');
+      const status = document.getElementById('video-status');
+      const hero = document.querySelector('.hero');
+      const heroSlot = document.getElementById('hero-video-slot');
+      const homeSection = document.getElementById('video-section');
+      // Original spot: the player returns right before the placeholder.
+      const homeAnchor = homeSection.querySelector('.video-placeholder');
+
+      // moveBefore() relocates a node atomically, so the iframe keeps its
+      // browsing context (no reload, playback continues uninterrupted).
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      // Fallback for browsers without moveBefore(): a normal DOM move reloads
+      // the iframe, so track playback via the YouTube IFrame API and resume
+      // from the same position after the move.
+      let ytPlayer = null;
+      if (!supportsMoveBefore) {
+        const prevReady = window.onYouTubeIframeAPIReady;
+        window.onYouTubeIframeAPIReady = () => {
+          prevReady?.();
+          ytPlayer = new YT.Player(iframe);
+        };
+        const script = document.createElement('script');
+        script.src = 'https://www.youtube.com/iframe_api';
+        script.async = true;
+        document.head.append(script);
+      }
+
+      function fallbackMove(parent, before) {
+        let resumeSrc = null;
+        if (ytPlayer && typeof ytPlayer.getCurrentTime === 'function') {
+          const time = Math.floor(ytPlayer.getCurrentTime() || 0);
+          const state = ytPlayer.getPlayerState();
+          const playing = state === YT.PlayerState.PLAYING || state === YT.PlayerState.BUFFERING;
+          if (time > 0 || playing) {
+            const url = new URL(iframe.src);
+            url.searchParams.set('start', String(time));
+            url.searchParams.set('autoplay', playing ? '1' : '0');
+            resumeSrc = url.href;
+          }
+        }
+
+        // Update src before re-inserting so the iframe only loads once.
+        if (resumeSrc) iframe.src = resumeSrc;
+        parent.insertBefore(player, before);
+
+        // The reload severed the API connection; re-attach to the new document.
+        if (ytPlayer) ytPlayer = new YT.Player(iframe);
+
+        // A traditional move drops focus to <body>; put it back on the toggle.
+        toggle.focus();
+      }
+
+      function movePlayer(parent, before = null) {
+        if (supportsMoveBefore) {
+          parent.moveBefore(player, before);
+        } else {
+          fallbackMove(parent, before);
+        }
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = !hero.classList.contains('theater');
+
+        if (entering) {
+          movePlayer(heroSlot);
+        } else {
+          movePlayer(homeSection, homeAnchor);
+        }
+
+        hero.classList.toggle('theater', entering);
+        homeSection.classList.toggle('is-empty', entering);
+        toggle.textContent = entering ? 'Exit theater mode' : 'Theater mode';
+        status.textContent = entering
+          ? 'Video moved to theater mode at the top of the page.'
+          : 'Video returned to its original position.';
+        player.scrollIntoView({ block: 'nearest' });
+      });
+    })();
+  </script>
+
