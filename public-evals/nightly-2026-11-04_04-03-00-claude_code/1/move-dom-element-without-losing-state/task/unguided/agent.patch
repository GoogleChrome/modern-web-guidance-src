+  <script>
+    (function () {
+      var player = document.getElementById('video-player');
+      var iframe = document.getElementById('roast-video');
+      var toggle = document.getElementById('theater-toggle');
+      var homeSlot = document.getElementById('video-home');
+      var theaterSlot = document.getElementById('theater-slot');
+      var hero = document.querySelector('.hero');
+      var section = document.getElementById('video-section');
+      var inTheater = false;
+
+      // Element.prototype.moveBefore (Chrome 133+) performs an "atomic move":
+      // the iframe keeps its browsing context, so playback continues uninterrupted.
+      // With insertBefore/appendChild the iframe is removed and re-inserted,
+      // which reloads it from scratch.
+      var supportsAtomicMove = typeof Element.prototype.moveBefore === 'function';
+
+      // ---- Fallback: YouTube IFrame API used to snapshot & restore playback ----
+      var ytPlayer = null;
+      var ytReady = false;
+
+      function bindYouTubePlayer(onReady) {
+        if (!window.YT || !window.YT.Player) return;
+        ytReady = false;
+        ytPlayer = new YT.Player(iframe, {
+          events: {
+            onReady: function () {
+              ytReady = true;
+              if (onReady) onReady();
+            }
+          }
+        });
+      }
+
+      function loadYouTubeApi() {
+        if (window.YT && window.YT.Player) {
+          bindYouTubePlayer();
+          return;
+        }
+        var prev = window.onYouTubeIframeAPIReady;
+        window.onYouTubeIframeAPIReady = function () {
+          if (typeof prev === 'function') prev();
+          bindYouTubePlayer();
+        };
+        var tag = document.createElement('script');
+        tag.src = 'https://www.youtube.com/iframe_api';
+        tag.async = true;
+        document.head.appendChild(tag);
+      }
+
+      function snapshotPlayback() {
+        if (!ytPlayer || !ytReady) return null;
+        try {
+          var state = ytPlayer.getPlayerState();
+          return {
+            time: ytPlayer.getCurrentTime() || 0,
+            playing: state === YT.PlayerState.PLAYING || state === YT.PlayerState.BUFFERING
+          };
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function withParams(src, params) {
+        var parts = src.split('#')[0].split('?');
+        var query = (parts[1] || '').split('&').filter(function (pair) {
+          var key = pair.split('=')[0];
+          return pair && !Object.prototype.hasOwnProperty.call(params, key);
+        });
+        for (var key in params) {
+          if (Object.prototype.hasOwnProperty.call(params, key)) {
+            query.push(key + '=' + encodeURIComponent(params[key]));
+          }
+        }
+        return parts[0] + '?' + query.join('&');
+      }
+
+      // Fallback move: the iframe will reload no matter what, so detach it first,
+      // point its src at the current timestamp, then reinsert it once (single
+      // reload) and seek/resume via the API when the new player is ready.
+      function fallbackMove(node, newParent) {
+        var snap = snapshotPlayback();
+        var frameBox = iframe.parentNode;
+
+        if (snap) {
+          frameBox.removeChild(iframe);
+          iframe.src = withParams(iframe.src, {
+            start: Math.floor(snap.time),
+            autoplay: snap.playing ? 1 : 0
+          });
+        }
+
+        newParent.appendChild(node);
+
+        if (snap) {
+          frameBox.appendChild(iframe);
+          bindYouTubePlayer(function () {
+            try {
+              ytPlayer.seekTo(snap.time, true);
+              if (snap.playing) {
+                ytPlayer.playVideo();
+              } else {
+                ytPlayer.pauseVideo();
+              }
+            } catch (e) { /* best effort */ }
+          });
+        }
+      }
+
+      function moveNode(node, newParent) {
+        if (supportsAtomicMove) {
+          try {
+            newParent.moveBefore(node, null);
+            return;
+          } catch (e) {
+            // moveBefore can throw (e.g. across documents); fall through.
+          }
+        }
+        fallbackMove(node, newParent);
+      }
+
+      function setTheater(on) {
+        if (on === inTheater) return;
+        inTheater = on;
+
+        moveNode(player, on ? theaterSlot : homeSlot);
+
+        hero.classList.toggle('theater-active', on);
+        section.classList.toggle('theater-active', on);
+        toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
+        toggle.textContent = on ? 'Exit theater mode' : 'Theater mode';
+        toggle.focus();
+
+        var target = on ? hero : section;
+        if (target.scrollIntoView) {
+          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        }
+      }
+
+      toggle.addEventListener('click', function () {
+        setTheater(!inTheater);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (inTheater && (e.key === 'Escape' || e.key === 'Esc')) {
+          setTheater(false);
+        }
+      });
+
+      // Only pay for the IFrame API when the fallback path is needed.
+      if (!supportsAtomicMove) {
+        loadYouTubeApi();
+      }
+    })();
+  </script>
