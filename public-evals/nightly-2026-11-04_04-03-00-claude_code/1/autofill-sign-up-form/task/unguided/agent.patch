+  <script>
+    document.getElementById('signup-form').addEventListener('submit', function (e) {
+      var form = this;
+      var error = document.getElementById('signup-error');
+      var password = form.password.value;
+      var message = '';
+
+      if (!form.first_name.value.trim() || !form.last_name.value.trim()) {
+        message = 'Please enter your first and last name.';
+      } else if (!form.email.validity.valid) {
+        message = 'Please enter a valid email address.';
+      } else if (password.length < 8) {
+        message = 'Password must be at least 8 characters.';
+      } else if (password !== form.confirm_password.value) {
+        message = 'Passwords do not match.';
+      } else if (!form.terms.checked) {
+        message = 'Please agree to the Terms of Service to continue.';
+      }
+
+      error.textContent = message;
+      if (message) e.preventDefault();
+    });
+  </script>
