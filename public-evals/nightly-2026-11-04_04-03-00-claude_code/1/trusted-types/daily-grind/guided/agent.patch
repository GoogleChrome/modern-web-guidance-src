+  <script type="module">
+    // Seasonal Favorites arrive as HTML strings (e.g. from a CMS/API). Treat
+    // them as untrusted: never assign them to innerHTML directly.
+    const seasonalFavorites = [
+      `<article class="card">
+        <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80"
+          alt="Latte with foam art in a ceramic cup" width="600" height="400" loading="lazy">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </article>`,
+      `<article class="card">
+        <img src="https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80"
+          alt="Espresso shot in a small cup" width="600" height="400" loading="lazy">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </article>`,
+      `<article class="card">
+        <img src="https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80"
+          alt="Iced cold brew coffee in a glass" width="600" height="400" loading="lazy">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </article>`,
+    ];
+
+    // Allowlist only what a card needs. Everything else (scripts, iframes,
+    // event handlers, style, javascript: URLs, ...) is stripped.
+    const ALLOWED_ELEMENTS = ['article', 'img', 'h3', 'p', 'a', 'strong', 'em'];
+    const ALLOWED_ATTRIBUTES = ['class', 'href', 'src', 'alt', 'width', 'height', 'loading'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      // Only downloaded in browsers without the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.4.17/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // Native Sanitizer API: parses, sanitizes and inserts in one step.
+        // Always XSS-safe, so it needs no Trusted Types policy.
+        el.setHTML(html, {
+          sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES },
+        });
+        return;
+      }
+
+      const DOMPurify = await loadDOMPurify();
+      // RETURN_TRUSTED_TYPE yields TrustedHTML via DOMPurify's "dompurify"
+      // policy, which the CSP above allows; a raw string would throw.
+      el.innerHTML = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+        ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+        // Match native Sanitizer behaviour.
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false,
+        KEEP_CONTENT: false,
+        RETURN_TRUSTED_TYPE: true,
+      });
+    }
+
+    const grid = document.getElementById('seasonal-favorites');
+    try {
+      await safeSetHTML(grid, seasonalFavorites.join(''));
+    } catch (err) {
+      console.error('Unable to render seasonal favorites:', err);
+      grid.textContent = 'Seasonal favorites are unavailable right now.';
+    }
+  </script>
+
