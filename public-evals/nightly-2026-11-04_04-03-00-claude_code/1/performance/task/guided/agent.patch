+  <!-- Speculatively prefetch likely next pages on hover/pointerdown (progressive enhancement;
+       ignored by browsers without Speculation Rules support). State-changing and private
+       URLs are excluded so speculation never logs the user out or caches account data. -->
+  <script type="speculationrules">
+    {
+      "prefetch": [{
+        "tag": "daily-grind-prefetch",
+        "where": {
