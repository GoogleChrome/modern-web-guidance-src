+            { "not": { "href_matches": "/logout" } },
+            { "not": { "href_matches": "/logout/*" } },
+            { "not": { "href_matches": "/account" } },
+            { "not": { "href_matches": "/account/*" } },
+            { "not": { "selector_matches": "[rel~=nofollow], .no-prefetch" } }
