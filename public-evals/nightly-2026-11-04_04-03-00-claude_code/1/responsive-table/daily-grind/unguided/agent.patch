+    /* Nutrition & Pricing Table */
+    .nutrition {
+      margin-top: 40px;
+    }
+
+    .nutrition h3 {
+      color: var(--primary);
+      margin-bottom: 5px;
+    }
+
+    .nutrition .table-note {
+      font-size: 0.85rem;
+      margin-bottom: 10px;
+    }
+
+    /* Scroll container: keeps the table intact on narrow screens instead of
+       squashing columns. Focusable so keyboard users can scroll it. */
+    .table-scroll {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-scroll:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition table {
+      width: 100%;
+      min-width: 600px;
+      border-collapse: separate;
+      border-spacing: 0;
+      font-size: 0.95rem;
+    }
+
+    .nutrition caption {
+      text-align: left;
+      padding: 12px 16px;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .nutrition th,
+    .nutrition td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    .nutrition thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+      vertical-align: bottom;
+    }
+
+    .nutrition th[scope="row"],
+    .nutrition thead th:first-child {
+      text-align: left;
+    }
+
+    /* Keep the drink name visible while scrolling horizontally */
+    .nutrition th[scope="row"] {
+      position: sticky;
+      left: 0;
+      background: white;
+      color: var(--primary);
+      box-shadow: 2px 0 0 var(--secondary);
+    }
+
+    .nutrition thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 1;
+    }
+
+    .nutrition tbody tr:nth-child(even) td,
+    .nutrition tbody tr:nth-child(even) th[scope="row"] {
+      background: #f5efed;
+    }
+
+    .nutrition tbody tr:last-child th,
+    .nutrition tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .nutrition .unit {
+      display: block;
+      font-weight: normal;
+      font-size: 0.8rem;
+      opacity: 0.85;
+    }
+
+    @media (max-width: 600px) {
+      .nutrition table {
+        font-size: 0.85rem;
+      }
+
+      .nutrition th,
+      .nutrition td {
+        padding: 10px 12px;
+      }
+    }
+
