+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var sections = links.map(function (link) {
+        return document.getElementById(link.getAttribute('href').slice(1));
+      });
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeIndex = -1;
+      var programmaticTarget = -1;
+      var settleTimer = null;
+      var ticking = false;
+
+      function setActive(index) {
+        if (index === activeIndex || index < 0) return;
+        activeIndex = index;
+        links.forEach(function (link, i) {
+          var on = i === index;
+          link.classList.toggle('is-active', on);
+          if (on) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Offset of a section's header (its snap point) within the panel's scroll area.
+      function snapOffset(section) {
+        var header = section.querySelector('header') || section;
+        return header.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      }
+
+      function computeActive() {
+        var maxScroll = panel.scrollHeight - panel.clientHeight;
+        if (panel.scrollTop >= maxScroll - 2) return sections.length - 1;
+        var threshold = panel.scrollTop + panel.clientHeight * 0.4;
+        var index = 0;
+        for (var i = 0; i < sections.length; i++) {
+          if (snapOffset(sections[i]) <= threshold) index = i;
+        }
+        return index;
+      }
+
+      function endProgrammaticScroll() {
+        programmaticTarget = -1;
+        clearTimeout(settleTimer);
+        setActive(computeActive());
+      }
+
+      panel.addEventListener('scroll', function () {
+        if (programmaticTarget !== -1) {
+          // Smooth scroll in progress: keep the clicked link highlighted, and
+          // release the lock once scrolling settles (fallback for no 'scrollend').
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(endProgrammaticScroll, 150);
+          return;
+        }
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(function () {
+          ticking = false;
+          setActive(computeActive());
+        });
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', function () {
+        if (programmaticTarget !== -1) endProgrammaticScroll();
+        else setActive(computeActive());
+      });
+
+      function scrollToSection(index, smooth) {
+        var section = sections[index];
+        if (!section) return;
+        var top = snapOffset(section);
+        setActive(index);
+        if (Math.abs(panel.scrollTop - top) < 1) return;
+        programmaticTarget = index;
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(endProgrammaticScroll, 1000);
+        panel.scrollTo({ top: top, behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
+      }
+
+      links.forEach(function (link, index) {
+        link.addEventListener('click', function (event) {
+          if (!sections[index]) return;
+          event.preventDefault();
+          scrollToSection(index, true);
+          if (history.replaceState) history.replaceState(null, '', link.getAttribute('href'));
+          // Move focus into the section for keyboard/screen-reader users without a page jump.
+          var heading = sections[index].querySelector('h3');
+          if (heading) heading.focus({ preventScroll: true });
+        });
+      });
+
+      // Initial state: honor a matching URL hash, otherwise highlight the first drink.
+      var hashIndex = sections.findIndex(function (s) {
+        return s && '#' + s.id === location.hash;
+      });
+      if (hashIndex > -1) {
+        scrollToSection(hashIndex, false);
+      } else {
+        setActive(computeActive());
+      }
+    })();
+  </script>
+
