+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const links = [...document.querySelectorAll('.toc-sidebar a[href^="#"]')];
+      const sections = [...panel.querySelectorAll('.drink-section')];
+      const headers = sections.map((section) => section.querySelector(':scope > header'));
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setActive(id) {
+        for (const link of links) {
+          if (link.hash === `#${id}`) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        }
+      }
+
+      // Smoothly scroll only the panel (not the page) to the chosen section.
+      for (const link of links) {
+        link.addEventListener('click', (event) => {
+          const section = document.getElementById(link.hash.slice(1));
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          const header = section.querySelector(':scope > header');
+          const top = header.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+          panel.scrollTo({ top, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+          // Move focus into the section for keyboard/AT users without causing a jump.
+          section.querySelector('h3')?.focus({ preventScroll: true });
+          history.replaceState(null, '', link.hash);
+          setActive(section.id);
+        });
+      }
+
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        // Fires once the panel settles on a new snap target (the article header).
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const section = event.snapTargetBlock?.closest('.drink-section');
+          if (section) setActive(section.id);
+        });
+      } else {
+        // Fallback: track the top-most visible header inside the panel.
+        const observer = new IntersectionObserver(() => {
+          const panelTop = panel.getBoundingClientRect().top;
+          let best;
+          for (const header of headers) {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) continue;
+            if (!best || bottom < best.getBoundingClientRect().bottom) best = header;
+          }
+          if (best) setActive(best.closest('.drink-section').id);
+        }, { root: panel, threshold: [0, 0.9, 1] });
+        headers.forEach((header) => observer.observe(header));
+      }
+
+      // Honor a deep link like #cold-brew on load.
+      const initial = location.hash && sections.find((s) => `#${s.id}` === location.hash);
+      if (initial) {
+        const header = initial.querySelector(':scope > header');
+        panel.scrollTo({ top: header.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop, behavior: 'auto' });
+        setActive(initial.id);
+      }
+    })();
+  </script>
+
