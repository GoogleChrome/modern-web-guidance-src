+  <script>
+    (function () {
+      var card = document.getElementById('loyalty');
+      if (!card) return;
+      var goal = Math.max(1, parseInt(card.dataset.goal, 10) || 10);
+      var stamps = Math.min(goal, Math.max(0, parseInt(card.dataset.stamps, 10) || 0));
+      var remaining = goal - stamps;
+      var percent = Math.round((stamps / goal) * 100);
+
+      var fill = card.querySelector('.ring-fill');
+      var circumference = 2 * Math.PI * fill.r.baseVal.value;
+      fill.style.strokeDasharray = circumference;
+      fill.style.strokeDashoffset = circumference;
+      // Trigger on next frame so the fill animates in
+      requestAnimationFrame(function () {
+        requestAnimationFrame(function () {
+          fill.style.strokeDashoffset = circumference * (1 - stamps / goal);
+        });
+      });
+
+      var ring = card.querySelector('.progress-ring');
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-valuenow', stamps);
+      ring.setAttribute('aria-valuetext', stamps + ' of ' + goal + ' beans earned');
+
+      card.querySelector('.js-stamps').textContent = stamps;
+      card.querySelector('.js-goal').textContent = goal;
+      card.querySelector('.js-percent').textContent = percent;
+      card.querySelector('.js-headline').textContent = remaining === 0
+        ? 'Your free drink is ready!'
+        : 'Only ' + remaining + ' more drink' + (remaining === 1 ? '' : 's') + ' to go!';
+
+      var row = card.querySelector('.js-stamp-row');
+      for (var i = 0; i < goal; i++) {
+        var li = document.createElement('li');
+        li.className = 'stamp' + (i < stamps ? ' earned' : '') + (i === goal - 1 ? ' reward' : '');
+        row.appendChild(li);
+      }
+    })();
+  </script>
+
