+  <script>
+    // Keeps the loyalty ring, center text, and summary in sync with the <progress> value.
+    (() => {
+      const progress = document.getElementById('loyalty-progress');
+      const count = document.getElementById('loyalty-count');
+      const maxEl = document.getElementById('loyalty-max');
+      const remaining = document.getElementById('loyalty-remaining');
+      const supportsAttr = CSS.supports('width: attr(value type(<number>))');
+
+      const sync = () => {
+        const value = Number(progress.getAttribute('value')) || 0;
+        const max = Number(progress.getAttribute('max')) || 1;
+        const left = Math.max(max - value, 0);
+
+        // Fallback for browsers without typed attr(): mirror attributes into CSS.
+        if (!supportsAttr) {
+          progress.style.setProperty('--value', value);
+          progress.style.setProperty('--max', max);
+        }
+
+        progress.classList.toggle('is-complete', left === 0);
+        count.textContent = Math.min(value, max);
+        maxEl.textContent = max;
+        remaining.innerHTML = left === 0
+          ? '<strong>You\'ve earned a free drink!</strong> Redeem it on your next order.'
+          : `Only <strong>${left} more drink${left === 1 ? '' : 's'}</strong> until your free drink!`;
+      };
+
+      sync();
+      new MutationObserver(sync).observe(progress, {
+        attributes: true,
+        attributeFilter: ['value', 'max'],
+      });
+    })();
+  </script>
+
