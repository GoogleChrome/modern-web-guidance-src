     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase Section */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 40px;
+      align-items: start;
+      margin-bottom: 60px;
+    }
+
+    .showcase h2 {
+      grid-column: 1 / -1;
+      text-align: center;
+    }
+
+    /* Card wrapper: children are clipped at the inner content box, so their
+       corners follow the concentric inner curve automatically. */
+    .nested-curve-parent {
+      --outer-radius: 28px;
+      --card-padding: 14px;
+      background: var(--primary);
+      padding: var(--card-padding);
+      border-radius: var(--outer-radius);
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      /* Fallback: clips at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--secondary);
+      color: var(--text);
+      padding: 16px 20px;
+    }
+
+    .nested-curve-footer h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* overflow: clip is required for overflow-clip-margin to apply */
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports not (overflow-clip-margin: content-box) {
+      /* Fallback only: approximate the concentric inner curves by hand */
+      .nested-curve-parent > :first-child {
+        border-radius: calc(var(--outer-radius) - var(--card-padding)) calc(var(--outer-radius) - var(--card-padding)) 0 0;
+      }
+
+      .nested-curve-parent > :last-child {
+        border-radius: 0 0 calc(var(--outer-radius) - var(--card-padding)) calc(var(--outer-radius) - var(--card-padding));
+      }
+    }
+
+    /* Promos block: clips overflowing text but leaves a 15px safety zone
+       so the button's glow can bleed past the edge. */
+    .safety-zone-parent {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      padding: 24px;
+      height: 340px;
+      /* Fallback: clips overflowing text (and, unavoidably, the glow) */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .promo-glow-btn {
+      display: block;
+      width: 100%;
+      margin: 20px 0;
+      padding: 14px 20px;
+      font: inherit;
+      font-weight: bold;
+      color: var(--text);
+      background: var(--accent);
+      border: none;
+      border-radius: 8px;
+      cursor: pointer;
+      box-shadow: 0 0 24px 6px rgba(255, 171, 64, 0.75);
+    }
+
+    .promo-fine-print {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
     footer {
