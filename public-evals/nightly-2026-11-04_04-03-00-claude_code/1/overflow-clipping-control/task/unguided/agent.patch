+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 50px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 40px;
+      align-items: start;
+    }
+
+    .showcase h2 {
+      grid-column: 1 / -1;
+      text-align: center;
+    }
+
+    /* Card wrapper: children are clipped at the inner content box.
+       overflow-clip-margin: content-box makes the clip edge follow the
+       content box, and the browser derives the concentric inner radius
+       (outer radius minus border + padding) automatically. */
+    .nested-curve-parent {
+      padding: 14px;
+      border: 2px solid var(--secondary);
+      border-radius: 32px;
+      background: var(--primary);
+      box-shadow: 0 10px 30px rgba(62, 39, 35, 0.25);
+      overflow: hidden; /* fallback: clips at padding box */
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .showcase-body {
+      background: white;
+      padding: 18px 20px;
+    }
+
+    .nested-curve-parent .showcase-body h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .nested-curve-parent .showcase-footer {
+      display: flex;
