+      align-items: center;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      padding: 12px 20px;
+    }
+
+    /* Promos block: overflowing text is clipped, but anything painted
+       within 15px outside the padding box (e.g. the button glow) stays visible. */
+    .safety-zone-parent {
+      position: relative;
+      padding: 24px;
+      border-radius: 16px;
+      background: linear-gradient(135deg, #3e2723, #6d4c41);
+      color: white;
+      overflow: hidden; /* fallback */
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent .promo-ticker {
