+  <script>
+    (function () {
+      var input = document.getElementById('search-input');
+      var grid = document.getElementById('menu-grid');
+      if (!input || !grid) return;
+
+      function clearHighlights() {
+        var marks = grid.querySelectorAll('mark.search-highlight');
+        var parents = new Set();
+        marks.forEach(function (mark) {
+          var parent = mark.parentNode;
+          parent.replaceChild(document.createTextNode(mark.textContent), mark);
+          parents.add(parent);
+        });
+        // Merge adjacent text nodes back together so future searches can match across them.
+        parents.forEach(function (parent) { parent.normalize(); });
+      }
+
+      function highlight(term) {
+        var needle = term.toLowerCase();
+        var walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: function (node) {
+            return node.nodeValue.toLowerCase().indexOf(needle) !== -1
+              ? NodeFilter.FILTER_ACCEPT
+              : NodeFilter.FILTER_REJECT;
+          }
+        });
+
+        // Collect first; mutating the DOM while walking would disrupt the walker.
+        var nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+
+        nodes.forEach(function (node) {
+          var text = node.nodeValue;
+          var lower = text.toLowerCase();
+          var frag = document.createDocumentFragment();
+          var pos = 0;
+          var idx;
+          while ((idx = lower.indexOf(needle, pos)) !== -1) {
+            if (idx > pos) frag.appendChild(document.createTextNode(text.slice(pos, idx)));
+            var mark = document.createElement('mark');
+            mark.className = 'search-highlight';
+            mark.textContent = text.slice(idx, idx + needle.length);
+            frag.appendChild(mark);
+            pos = idx + needle.length;
+          }
+          if (pos < text.length) frag.appendChild(document.createTextNode(text.slice(pos)));
+          node.parentNode.replaceChild(frag, node);
+        });
+      }
+
+      input.addEventListener('input', function () {
+        clearHighlights();
+        var term = input.value.trim();
+        if (term) highlight(term);
+      });
+    })();
+  </script>
+
 </body>
 
