+  <script>
+    (() => {
+      const input = document.getElementById("search-input");
+      const grid = document.getElementById("menu-grid");
+      const HIGHLIGHT_NAME = "menu-search";
+      const supportsHighlights = typeof CSS !== "undefined" && "highlights" in CSS;
+
+      // Collect text nodes inside the menu cards (cached; menu content is static).
+      const getTextNodes = () => {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: (node) => node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+        });
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      };
+
+      let textNodes = getTextNodes();
+
+      const highlightWithApi = (term) => {
+        CSS.highlights.delete(HIGHLIGHT_NAME);
+        if (!term) return;
+        const ranges = [];
+        for (const node of textNodes) {
+          const text = node.nodeValue.toLowerCase();
+          let pos = text.indexOf(term);
+          while (pos !== -1) {
+            const range = new Range();
+            range.setStart(node, pos);
+            range.setEnd(node, pos + term.length);
+            ranges.push(range);
+            pos = text.indexOf(term, pos + term.length);
+          }
+        }
+        if (ranges.length) CSS.highlights.set(HIGHLIGHT_NAME, new Highlight(...ranges));
+      };
+
+      const clearMarks = () => {
+        const marks = grid.querySelectorAll("mark.menu-search-mark");
+        if (!marks.length) return;
+        const parents = new Set();
+        for (const mark of marks) {
+          parents.add(mark.parentNode);
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        }
+        // Merge adjacent text nodes back together.
+        for (const parent of parents) parent.normalize();
+      };
+
+      const highlightWithMarks = (term) => {
+        clearMarks();
+        if (!term) return;
+        for (const node of getTextNodes()) {
+          const text = node.nodeValue;
+          const lower = text.toLowerCase();
+          let pos = lower.indexOf(term);
+          if (pos === -1) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          while (pos !== -1) {
+            frag.append(text.slice(last, pos));
+            const mark = document.createElement("mark");
+            mark.className = "menu-search-mark";
+            mark.textContent = text.slice(pos, pos + term.length);
+            frag.append(mark);
+            last = pos + term.length;
+            pos = lower.indexOf(term, last);
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      };
+
+      input.addEventListener("input", () => {
+        const term = input.value.trim().toLowerCase();
+        if (supportsHighlights) highlightWithApi(term);
+        else highlightWithMarks(term);
+      });
+    })();
+  </script>
+
 </body>
 
