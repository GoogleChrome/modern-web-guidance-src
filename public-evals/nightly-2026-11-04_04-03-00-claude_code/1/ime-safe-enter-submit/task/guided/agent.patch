@@ -206,7 +283,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const feedbackButton = feedbackForm.querySelector('button[type="submit"]');
+
+    // Enter sends; Shift+Enter inserts a newline. Skip while an IME is composing
+    // (keyCode 229 covers Safari, which resets isComposing before keydown fires).
+    feedbackMessage.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        if (event.isComposing || event.keyCode === 229) return;
+        feedbackForm.requestSubmit();
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      feedbackButton.disabled = true;
+      feedbackStatus.textContent = '';
+      try {
+        const response = await fetch(feedbackForm.action, {
+          method: 'POST',
+          body: new FormData(feedbackForm),
+        });
+        if (!response.ok) throw new Error(response.statusText);
+        feedbackForm.reset();
+        feedbackStatus.textContent = 'Thanks for your feedback!';
+      } catch {
+        feedbackStatus.textContent = 'Sorry, something went wrong. Please try again.';
+      } finally {
+        feedbackButton.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
