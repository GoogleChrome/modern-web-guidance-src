diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,80 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Mixed Fonts &amp; font-size-adjust</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+    }
+
+    body {
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.125rem;
+      line-height: 1.6;
+      max-width: 48rem;
+      margin: 2rem auto;
+      padding: 0 1rem;
+    }
+
+    /*
+     * Mixed fonts: serif body text + monospace inline code.
+     * `font-size-adjust: from-font` reads the x-height (ex-height aspect)
+     * from the primary font and scales every fallback / mixed font so
+     * their x-heights visually match automatically.
+     */
+    #mixed-fonts-container {
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+      /* Inherits the computed aspect value from the paragraph, so the code
+         font is scaled to the same x-height as the surrounding text. */
+      font-size-adjust: inherit;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /*
+     * Independent theme: does not inherit the surrounding font metrics.
+     * A fixed numeric aspect value locks the x-height to 0.5 × font-size
+     * for every font used inside this container.
+     */
+    #independent-theme-container {
+      font-family: Verdana, Arial, sans-serif;
+      font-size-adjust: ex-height 0.5;
+      margin-top: 2rem;
+      padding: 1.5rem;
+      border: 2px solid currentColor;
+      border-radius: 0.75rem;
+      background: color-mix(in srgb, Canvas 85%, #4f46e5);
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+    }
+  </style>
+</head>
+<body>
+  <h1>Normalizing Mixed Fonts</h1>
+
+  <p id="mixed-fonts-container">
+    This paragraph mixes a serif typeface with inline code such as
+    <code>const total = items.reduce(sum, 0);</code> and
+    <code>font-size-adjust</code>. Thanks to <code>font-size-adjust: from-font</code>,
+    the monospace text is scaled so its x-height matches the surrounding prose.
+  </p>
+
+  <div id="independent-theme-container">
+    <h2>Independent Theme</h2>
+    <p>
+      This container uses its own sans-serif theme and locks its visual
+      proportions with <code>font-size-adjust: ex-height 0.5</code>, so every
+      font inside renders with an x-height of exactly half the font size.
+    </p>
+  </div>
+</body>
+</html>
