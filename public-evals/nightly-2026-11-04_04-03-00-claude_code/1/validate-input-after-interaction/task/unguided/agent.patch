+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-error');
+
+      function message() {
+        if (input.validity.valueMissing) return 'Please enter your email address.';
+        if (input.validity.typeMismatch) return 'Please enter a valid email address.';
+        return '';
+      }
+
+      function showError() {
+        input.classList.add('touched');
+        const msg = message();
+        error.textContent = msg;
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+      }
+
+      // Validate only once the user leaves the field (and it has something in it)
+      input.addEventListener('blur', function () {
+        if (input.value.trim() !== '' || input.classList.contains('touched')) showError();
+      });
+
+      // While typing: never add an error, but clear one as soon as the input becomes valid
+      input.addEventListener('input', function () {
+        if (input.classList.contains('touched') && input.validity.valid) {
+          error.textContent = '';
+          input.setAttribute('aria-invalid', 'false');
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        showError();
+        if (!input.validity.valid) {
+          input.focus();
+          return;
+        }
+        // TODO: send input.value to the newsletter provider/backend
+        form.outerHTML = '<p class="newsletter-success" role="status">Thanks for subscribing! Check your inbox soon.</p>';
+      });
+    })();
+  </script>
+
 </body>
 
