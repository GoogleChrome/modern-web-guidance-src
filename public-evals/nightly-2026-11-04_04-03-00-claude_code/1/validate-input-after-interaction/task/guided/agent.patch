+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state,
+    // so screen readers don't announce an error mid-typing either.
+    (() => {
+      const input = document.getElementById('newsletter-email');
+      const sync = () => {
+        if (input.matches(':user-invalid')) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      };
+      input.addEventListener('blur', sync);
+      input.addEventListener('invalid', sync);
+      // Clear the error as soon as it's fixed (only once an error is showing)
+      input.addEventListener('input', () => {
+        if (input.getAttribute('aria-invalid') === 'true') sync();
+      });
+    })();
+  </script>
+
