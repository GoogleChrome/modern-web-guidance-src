+
+  <script>
+    (() => {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneStatus = document.getElementById('phone-status');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpStatus = document.getElementById('otp-status');
+      const otpPhone = document.getElementById('otp-phone');
+      const otpPurpose = document.getElementById('otp-purpose');
+      const otpPhoneDisplay = document.getElementById('otp-phone-display');
+      const resendButton = document.getElementById('resend-code');
+      const changeNumberButton = document.getElementById('change-number');
+
+      const REDIRECTS = { rewards: '/rewards', order: '/order-online' };
+
+      // SMS sent by the backend must end with the origin-bound line, e.g.:
+      //   Your Daily Grind code is 123456.
+      //
+      //   @dailygrind.example #123456
+      // so WebOTP and Safari's one-time-code autofill only offer the code on this domain.
+
+      let otpAbortController = null;
+
+      function setStatus(el, message, state) {
+        el.textContent = message;
+        if (state) el.dataset.state = state;
+        else delete el.dataset.state;
+      }
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return;
+
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          otpForm.requestSubmit();
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP verification error:', err);
+        }
+      }
+
+      async function postForm(form, body) {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          body,
+          headers: { Accept: 'application/json' },
+          credentials: 'same-origin',
+        });
+        let data = {};
+        try { data = await response.json(); } catch { /* non-JSON response */ }
+        if (!response.ok) {
+          throw new Error(data.message || 'Something went wrong. Please try again.');
+        }
+        return data;
+      }
+
+      async function requestCode(submitter) {
+        const body = new FormData(phoneForm);
+        if (submitter) submitter.disabled = true;
+        try {
+          await postForm(phoneForm, body);
+          return true;
+        } finally {
+          if (submitter) submitter.disabled = false;
+        }
+      }
+
+      function showOtpStep() {
+        const data = new FormData(phoneForm);
+        otpPhone.value = data.get('phone');
+        otpPurpose.value = data.get('purpose');
+        otpPhoneDisplay.textContent = data.get('phone');
+        otpInput.value = '';
+        setStatus(otpStatus, '');
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.focus();
+        startSmsOtpListener();
+      }
+
+      function showPhoneStep() {
+        stopSmsOtpListener();
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus(phoneStatus, '');
+        phoneInput.focus();
+      }
+
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        setStatus(phoneStatus, 'Sending your code…');
+        try {
+          await requestCode(event.submitter);
+          setStatus(phoneStatus, '');
+          showOtpStep();
+        } catch (err) {
+          setStatus(phoneStatus, err.message || 'We couldn\u2019t send a code. Please try again.', 'error');
+        }
+      });
+
+      otpInput.addEventListener('input', () => {
+        // Keep only digits (handles pasted codes like "123 456")
+        const digits = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (digits !== otpInput.value) otpInput.value = digits;
+        if (otpStatus.dataset.state === 'error') setStatus(otpStatus, '');
+      });
+
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        // Abort any pending WebOTP request on every submission path
+        stopSmsOtpListener();
+
+        const submitButton = otpForm.querySelector('button[type="submit"]');
+        submitButton.disabled = true;
+        setStatus(otpStatus, 'Verifying…');
+
+        try {
+          const data = await postForm(otpForm, new FormData(otpForm));
+          setStatus(otpStatus, 'Verified! Redirecting…', 'success');
+          const purpose = otpPurpose.value;
+          window.location.assign(data.redirect || REDIRECTS[purpose] || '/');
+        } catch (err) {
+          submitButton.disabled = false;
+          setStatus(otpStatus, err.message || 'That code didn\u2019t work. Please try again.', 'error');
+          otpInput.select();
+          otpInput.focus();
+          // Keep listening in case a fresh SMS arrives
+          startSmsOtpListener();
+        }
+      });
+
+      resendButton.addEventListener('click', async () => {
+        stopSmsOtpListener();
+        setStatus(otpStatus, 'Sending a new code…');
+        try {
+          await requestCode(resendButton);
+          otpInput.value = '';
+          setStatus(otpStatus, 'A new code is on its way.', 'success');
+          otpInput.focus();
+          startSmsOtpListener();
+        } catch (err) {
+          setStatus(otpStatus, err.message || 'We couldn\u2019t resend the code. Please try again.', 'error');
+        }
+      });
+
+      changeNumberButton.addEventListener('click', showPhoneStep);
+
+      window.addEventListener('pagehide', stopSmsOtpListener);
+    })();
+  </script>
 </body>
 
 </html>
