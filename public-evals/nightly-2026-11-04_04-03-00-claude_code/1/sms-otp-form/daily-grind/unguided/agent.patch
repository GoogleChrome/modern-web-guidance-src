+
+  <script>
+    /*
+     * SMS one-time passcode flow.
+     *
+     * Backend contract (JSON in, JSON out):
+     *   POST /api/otp/send   { phone, purpose }        -> 2xx on success
+     *   POST /api/otp/verify { phone, code, purpose }  -> 2xx { redirect? } on success
+     *
+     * For WebOTP auto-fill (Chrome on Android), the SMS's final line must be:
+     *   @<this site's host> #<code>
+     * e.g. "Your Daily Grind code is 482913.\n\n@dailygrind.com #482913"
+     * iOS/macOS Safari picks up the code via autocomplete="one-time-code".
+     */
+    (function () {
+      const CODE_LENGTH = 6;
+      const RESEND_SECONDS = 30;
+      const REDIRECTS = { rewards: '/rewards', order: '/order-online' };
+
+      const phoneForm = document.getElementById('phone-form');
+      const otpForm = document.getElementById('otp-form');
+      const phoneInput = document.getElementById('phone');
+      const phoneError = document.getElementById('phone-error');
+      const codeInput = document.getElementById('otp-code');
+      const codeError = document.getElementById('otp-error');
+      const sendBtn = document.getElementById('send-btn');
+      const verifyBtn = document.getElementById('verify-btn');
+      const resendBtn = document.getElementById('resend-btn');
+      const resendTimer = document.getElementById('resend-timer');
+      const changePhoneBtn = document.getElementById('change-phone-btn');
+      const status = document.getElementById('verify-status');
+
+      let phone = '';
+      let purpose = 'rewards';
+      let timerId = null;
+      let webOtpAbort = null;
+      let verifying = false;
+
+      // Deep-link support: /#verify?for=order or ?for=order preselects the purpose.
+      const preset = new URLSearchParams(location.search).get('for');
+      if (preset && REDIRECTS[preset]) {
+        phoneForm.querySelector(`input[name="purpose"][value="${preset}"]`).checked = true;
+      }
+
+      function setStatus(msg, success) {
+        status.textContent = msg;
+        status.classList.toggle('success', !!success);
+      }
+
+      function setError(input, el, msg) {
+        el.textContent = msg;
+        if (msg) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      }
+
+      function normalizePhone(raw) {
+        const digits = raw.replace(/\D/g, '');
+        if (digits.length === 10) return '+1' + digits;
+        if (digits.length === 11 && digits[0] === '1') return '+' + digits;
+        if (raw.trim().startsWith('+') && digits.length >= 8 && digits.length <= 15) return '+' + digits;
+        return null;
+      }
+
+      function maskPhone(e164) {
+        return '•••-•••-' + e164.slice(-4);
+      }
+
+      async function postJSON(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(body)
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body */ }
+        if (!res.ok) {
+          const err = new Error(data.message || 'Request failed');
+          err.status = res.status;
+          throw err;
+        }
+        return data;
+      }
+
+      function startResendCountdown() {
+        clearInterval(timerId);
+        let remaining = RESEND_SECONDS;
+        resendBtn.disabled = true;
+        const tick = () => {
+          if (remaining <= 0) {
+            clearInterval(timerId);
+            resendBtn.disabled = false;
+            resendTimer.textContent = '';
+            return;
+          }
+          resendTimer.textContent = `Available in ${remaining}s`;
+          remaining--;
+        };
+        tick();
+        timerId = setInterval(tick, 1000);
+      }
+
+      function stopWebOtp() {
+        if (webOtpAbort) {
+          webOtpAbort.abort();
+          webOtpAbort = null;
+        }
+      }
+
+      // WebOTP API: read the code straight from the incoming SMS where supported.
+      function listenForSmsCode() {
+        stopWebOtp();
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        webOtpAbort = new AbortController();
+        navigator.credentials
+          .get({ otp: { transport: ['sms'] }, signal: webOtpAbort.signal })
+          .then(otp => {
+            if (!otp || !otp.code) return;
+            codeInput.value = otp.code.replace(/\D/g, '').slice(0, CODE_LENGTH);
+            setStatus('Code received from your text message.');
+            if (codeInput.value.length === CODE_LENGTH) otpForm.requestSubmit();
+          })
+          .catch(() => { /* aborted, dismissed, or unsupported — manual entry still works */ });
+      }
+
+      async function sendCode() {
+        await postJSON(phoneForm.action, { phone, purpose });
+        document.getElementById('otp-sent-to').textContent = maskPhone(phone);
+        document.getElementById('otp-phone').value = phone;
+        document.getElementById('otp-purpose').value = purpose;
+        startResendCountdown();
+        listenForSmsCode();
+      }
+
+      phoneForm.addEventListener('submit', async e => {
+        e.preventDefault();
+        setStatus('');
+        purpose = new FormData(phoneForm).get('purpose') || 'rewards';
+        const normalized = normalizePhone(phoneInput.value);
+        if (!normalized) {
+          setError(phoneInput, phoneError, 'Enter a valid mobile number, like (555) 123-4567.');
+          phoneInput.focus();
+          return;
+        }
+        setError(phoneInput, phoneError, '');
+        phone = normalized;
+
+        sendBtn.disabled = true;
+        sendBtn.textContent = 'Sending…';
+        try {
+          await sendCode();
+          phoneForm.hidden = true;
+          otpForm.hidden = false;
+          codeInput.value = '';
+          setError(codeInput, codeError, '');
+          setStatus(`Code sent to ${maskPhone(phone)}.`);
+          codeInput.focus();
+        } catch (err) {
+          setError(phoneInput, phoneError, err.status === 429
+            ? 'Too many attempts. Please wait a few minutes and try again.'
+            : 'We couldn’t send a code right now. Please try again.');
+          phoneInput.focus();
+        } finally {
+          sendBtn.disabled = false;
+          sendBtn.textContent = 'Text me a code';
+        }
+      });
+
+      // Keep the field digits-only (handles paste of "123 456" or "Code: 123456").
+      codeInput.addEventListener('input', () => {
+        const digits = codeInput.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (codeInput.value !== digits) codeInput.value = digits;
+        if (codeError.textContent) setError(codeInput, codeError, '');
+        // Auto-submit once complete (covers iOS keyboard suggestion and paste).
+        if (digits.length === CODE_LENGTH && !verifying) otpForm.requestSubmit();
+      });
+
+      otpForm.addEventListener('submit', async e => {
+        e.preventDefault();
+        if (verifying) return;
+        const code = codeInput.value;
+        if (!new RegExp(`^\\d{${CODE_LENGTH}}$`).test(code)) {
+          setError(codeInput, codeError, `Enter all ${CODE_LENGTH} digits of your code.`);
+          codeInput.focus();
+          return;
+        }
+
+        verifying = true;
+        verifyBtn.disabled = true;
+        verifyBtn.textContent = 'Verifying…';
+        setStatus('');
+        try {
+          const data = await postJSON(otpForm.action, { phone, code, purpose });
+          stopWebOtp();
+          clearInterval(timerId);
+          setStatus('Verified! Redirecting…', true);
+          location.assign(data.redirect || REDIRECTS[purpose] || '/');
+        } catch (err) {
+          const msg = err.status === 429
+            ? 'Too many attempts. Please request a new code.'
+            : err.status === 410
+              ? 'That code has expired. Please request a new one.'
+              : 'That code didn’t match. Check your text and try again.';
+          setError(codeInput, codeError, msg);
+          codeInput.select();
+          codeInput.focus();
+          verifyBtn.disabled = false;
+          verifyBtn.textContent = 'Verify & continue';
+        } finally {
+          verifying = false;
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        resendBtn.disabled = true;
+        setError(codeInput, codeError, '');
+        codeInput.value = '';
+        try {
+          await sendCode();
+          setStatus(`A new code was sent to ${maskPhone(phone)}.`);
+        } catch (_) {
+          setStatus('We couldn’t resend the code. Please try again shortly.');
+          resendBtn.disabled = false;
+        }
+        codeInput.focus();
+      });
+
+      changePhoneBtn.addEventListener('click', () => {
+        stopWebOtp();
+        clearInterval(timerId);
+        resendTimer.textContent = '';
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus('');
+        phoneInput.focus();
+        phoneInput.select();
+      });
+    })();
+  </script>
 </body>
 
