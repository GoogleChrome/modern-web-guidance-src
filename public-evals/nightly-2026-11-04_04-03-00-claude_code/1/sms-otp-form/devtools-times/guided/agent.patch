+import type { APIRoute } from 'astro';
+import {
+  OTP_TTL_MS,
+  PENDING_KEY,
+  RESEND_COOLDOWN_MS,
+  VERIFIED_KEY,
+  buildSmsBody,
+  generateCode,
+  hashCode,
+  json,
+  normalizePhone,
+  sendSms,
+  type PendingOtp,
+} from '../../../lib/smsOtp';
+
+export const POST: APIRoute = async ({ request, session, site, url }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json(
+      { error: 'Enter a valid phone number, including the country code (for example +1 555 555 0100).' },
+      400,
+    );
+  }
+
+  const now = Date.now();
+  const existing = (await session.get(PENDING_KEY)) as PendingOtp | undefined;
+  if (existing && existing.phone === phone && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return json(
+      { error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter },
+      429,
+      { 'Retry-After': String(retryAfter) },
+    );
+  }
+
+  const code = generateCode();
+  const pending: PendingOtp = {
+    phone,
+    codeHash: hashCode(code, phone),
+    expiresAt: now + OTP_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  };
+  await session.set(PENDING_KEY, pending);
+  session.delete(VERIFIED_KEY);
+
+  // Host only — no scheme, port, or path — as required by the origin-bound SMS format.
+  const host = (site ?? url).hostname;
+  try {
+    await sendSms(phone, buildSmsBody(code, host));
+  } catch (err) {
+    console.error('[sms-otp] Failed to send SMS', err);
+    session.delete(PENDING_KEY);
+    return json({ error: 'We could not send a text message right now. Please try again.' }, 502);
+  }
+
+  return json({
+    phone,
+    expiresIn: Math.round(OTP_TTL_MS / 1000),
+    resendIn: Math.round(RESEND_COOLDOWN_MS / 1000),
+  });
+};
diff --git a/src/pages/api/phone-verification/verify.ts b/src/pages/api/phone-verification/verify.ts
new file mode 100644
index 0000000..17f752f
--- /dev/null
+++ b/src/pages/api/phone-verification/verify.ts
@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+import {
+  MAX_ATTEMPTS,
+  OTP_LENGTH,
+  PENDING_KEY,
+  VERIFIED_KEY,
+  codesMatch,
+  json,
+  type PendingOtp,
+} from '../../../lib/smsOtp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\s/g, '') : '';
+  if (!new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code from the text message.` }, 400);
+  }
+
+  const pending = (await session.get(PENDING_KEY)) as PendingOtp | undefined;
+  if (!pending) {
+    return json({ error: 'No verification is in progress. Request a new code.', expired: true }, 400);
+  }
+  if (Date.now() > pending.expiresAt) {
+    session.delete(PENDING_KEY);
+    return json({ error: 'This code has expired. Request a new code.', expired: true }, 400);
+  }
+  if (pending.attempts >= MAX_ATTEMPTS) {
+    session.delete(PENDING_KEY);
+    return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 429);
+  }
+
+  if (!codesMatch(code, pending)) {
+    const attempts = pending.attempts + 1;
+    const remaining = MAX_ATTEMPTS - attempts;
+    if (remaining <= 0) {
+      session.delete(PENDING_KEY);
+      return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 429);
+    }
+    await session.set(PENDING_KEY, { ...pending, attempts });
+    return json(
+      { error: `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} left.` },
+      400,
+    );
+  }
+
+  session.delete(PENDING_KEY);
+  await session.set(VERIFIED_KEY, { phone: pending.phone, verifiedAt: Date.now() });
+  return json({ verified: true, phone: pending.phone });
+};
