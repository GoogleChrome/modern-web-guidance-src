+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export { normalizePhone } from './phone';
+
+export const OTP_LENGTH = 6;
+export const OTP_TTL_MS = 5 * 60 * 1000;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+export const MAX_ATTEMPTS = 5;
+
+/** Session-stored state for a pending phone verification. */
+export interface PendingOtp {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+export const PENDING_KEY = 'phoneOtpPending';
+export const VERIFIED_KEY = 'phoneVerified';
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+}
+
+export function hashCode(code: string, phone: string): string {
+  return createHash('sha256').update(`${phone}:${code}`).digest('hex');
+}
+
+export function codesMatch(code: string, pending: PendingOtp): boolean {
+  const a = Buffer.from(hashCode(code, pending.phone), 'hex');
+  const b = Buffer.from(pending.codeHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Builds an origin-bound SMS body. The final line `@<host> #<code>` lets the
+ * WebOTP API and `autocomplete="one-time-code"` autofill verify the domain
+ * before offering the code. It must be the last line with no trailing text.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+/**
+ * Sends the SMS. Wire this up to your SMS provider (Twilio, Vonage, SNS, …).
+ * Until a provider is configured, the message is logged on the server so the
+ * flow can be exercised in development.
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  // TODO: replace with a real SMS provider integration.
+  console.info(`[sms-otp] To ${to}:\n${body}`);
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
