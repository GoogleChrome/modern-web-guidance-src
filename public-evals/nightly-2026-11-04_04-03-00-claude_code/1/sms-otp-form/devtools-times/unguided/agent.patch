@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { json, normalizePhone, readJsonBody, sendVerificationCode } from '../../../lib/phone-verification';
+
+export const prerender = false;
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are not available.', code: 'NO_SESSION' }, 500);
+
+  const body = await readJsonBody(request);
+  if (!body) return json({ error: 'Invalid request.', code: 'BAD_REQUEST' }, 400);
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json(
+      { error: 'Enter a valid mobile number including the country code, for example +1 555 123 4567.', code: 'INVALID_PHONE' },
+      400,
+    );
+  }
+
+  const result = await sendVerificationCode(session, phone, url.hostname);
+  if (!result.ok) {
+    const { status, retryAfter, ...rest } = result;
+    return json({ ...rest, retryAfter }, status, retryAfter ? { 'Retry-After': String(retryAfter) } : {});
+  }
+  const { ok, ...data } = result;
+  return json(data);
+};
