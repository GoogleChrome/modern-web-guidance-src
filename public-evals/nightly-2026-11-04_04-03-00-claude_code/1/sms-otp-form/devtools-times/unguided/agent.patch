@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { json, maskPhone, readJsonBody, verifyCode } from '../../../lib/phone-verification';
+
+export const prerender = false;
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.', code: 'NO_SESSION' }, 500);
+
+  const body = await readJsonBody(request);
+  if (!body) return json({ error: 'Invalid request.', code: 'BAD_REQUEST' }, 400);
+
+  const result = await verifyCode(session, body.code);
+  if (!result.ok) {
+    const { status, ...rest } = result;
+    return json(rest, status);
+  }
+  return json({ verified: true, maskedPhone: maskPhone(result.phone) });
+};
