+import type { APIRoute } from 'astro';
+import { clearVerifiedPhone, getVerifiedPhone, json, readJsonBody } from '../../lib/phone-verification';
+
+export const prerender = false;
+
+const UPSTREAM_REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+/**
+ * Registration is only allowed once the session holds a freshly verified phone
+ * number. Credentials are then forwarded to the upstream account service and its
+ * response (including APP_ERR_* codes) is passed through unchanged.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.', code: 'NO_SESSION' }, 500);
+
+  const body = await readJsonBody(request);
+  if (!body || typeof body.username !== 'string' || typeof body.password !== 'string') {
+    return json({ error: 'Invalid request.', code: 'BAD_REQUEST' }, 400);
+  }
+
+  const phone = await getVerifiedPhone(session);
+  if (!phone) {
+    return json({ error: 'Please verify your phone number before signing up.', code: 'PHONE_NOT_VERIFIED' }, 403);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM_REGISTER_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username, password: body.password }),
+    });
+  } catch {
+    return json({ error: 'The registration service is unavailable.', code: 'UPSTREAM_UNAVAILABLE' }, 502);
+  }
+
+  const text = await upstream.text();
+  if (upstream.ok) clearVerifiedPhone(session);
+  return new Response(text, {
+    status: upstream.status,
+    headers: { 'Content-Type': upstream.headers.get('content-type') ?? 'application/json', 'Cache-Control': 'no-store' },
+  });
+};
