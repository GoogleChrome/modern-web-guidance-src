+import { createHmac, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+import type { AstroSession } from 'astro';
+
+/** Server-only helpers for SMS one-time-passcode phone verification. */
+
+export const CODE_LENGTH = 6;
+export const CODE_TTL_MS = 5 * 60 * 1000; // a code is valid for 5 minutes
+export const RESEND_COOLDOWN_MS = 30 * 1000; // wait 30s between sends
+export const MAX_VERIFY_ATTEMPTS = 5; // wrong guesses allowed per code
+export const MAX_SENDS_PER_WINDOW = 5; // SMS per phone number / session...
+export const SEND_WINDOW_MS = 60 * 60 * 1000; // ...per hour
+export const VERIFIED_TTL_MS = 15 * 60 * 1000; // finish sign-up within 15 minutes of verifying
+
+const CHALLENGE_KEY = 'phoneChallenge';
+const VERIFIED_KEY = 'phoneVerified';
+
+interface PhoneChallenge {
+  phone: string;
+  salt: string;
+  codeHash: string;
+  expiresAt: number;
+  attempts: number;
+  lastSentAt: number;
+  sendTimestamps: number[];
+}
+
+interface PhoneVerified {
+  phone: string;
+  verifiedAt: number;
+}
+
+export function json(body: unknown, status = 200, headers: Record<string, string> = {}) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
+
+/**
+ * Only accept JSON bodies. A cross-origin page cannot send `application/json`
+ * without a CORS preflight, so this blocks simple form-based CSRF (Astro's
+ * origin check is disabled in this project).
+ */
+export async function readJsonBody(request: Request): Promise<Record<string, unknown> | null> {
+  if (!request.headers.get('content-type')?.toLowerCase().startsWith('application/json')) return null;
+  try {
+    const body = await request.json();
+    return body && typeof body === 'object' ? (body as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Normalise user input to E.164 (`+15551234567`). Returns null if invalid. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  let value = input.trim().replace(/[\s().\- ]/g, '');
+  if (value.startsWith('00')) value = `+${value.slice(2)}`;
+  return /^\+[1-9]\d{7,14}$/.test(value) ? value : null;
+}
+
+/** `+15551234567` -> `+1 •••• ••67` style mask for display. */
+export function maskPhone(phone: string): string {
+  return `${phone.slice(0, Math.min(3, phone.length - 4))}${'•'.repeat(Math.max(phone.length - 5, 0))}${phone.slice(-2)}`;
+}
+
+function hashCode(code: string, salt: string) {
+  const secret = process.env.OTP_SECRET ?? PROCESS_SECRET;
+  return createHmac('sha256', secret).update(`${salt}:${code}`).digest('hex');
+}
+// Fallback secret for when OTP_SECRET is unset; codes are short-lived so a per-process key is fine.
+const PROCESS_SECRET = randomBytes(32).toString('hex');
+
+function generateCode() {
+  return randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+}
+
+// --- Per-number rate limiting -------------------------------------------------
+// Session-based limits can be reset by clearing cookies, so also limit by phone
+// number to prevent SMS flooding of a victim's number. In-memory: use a shared
+// store (e.g. Redis) when running more than one instance.
+const sendsByPhone = new Map<string, number[]>();
+
+function recentSends(timestamps: number[], now: number) {
+  return timestamps.filter((t) => now - t < SEND_WINDOW_MS);
+}
+
+function pruneLimiter(now: number) {
+  if (sendsByPhone.size < 1000) return;
+  for (const [phone, ts] of sendsByPhone) {
+    if (recentSends(ts, now).length === 0) sendsByPhone.delete(phone);
+  }
+}
+
+// --- SMS delivery --------------------------------------------------------------
+
+/**
+ * Message body follows the WebOTP origin-bound format so supporting browsers can
+ * read the code automatically; the last line must be `@<host> #<code>`.
+ */
+export function buildSmsBody(code: string, host: string) {
+  return `${code} is your DevTools Times verification code. It expires in ${CODE_TTL_MS / 60000} minutes.\n\n@${host} #${code}`;
+}
+
+export class SmsDeliveryError extends Error {}
+
+async function deliverSms(to: string, body: string) {
+  const sid = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const from = process.env.TWILIO_FROM_NUMBER;
+  const messagingServiceSid = process.env.TWILIO_MESSAGING_SERVICE_SID;
+
+  if (sid && token && (from || messagingServiceSid)) {
+    const params = new URLSearchParams({ To: to, Body: body });
+    if (messagingServiceSid) params.set('MessagingServiceSid', messagingServiceSid);
+    else params.set('From', from!);
+    const res = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: params,
+    });
+    if (!res.ok) {
+      console.error('[phone-verification] SMS provider error', res.status, await res.text().catch(() => ''));
+      throw new SmsDeliveryError('SMS provider rejected the message');
+    }
+    return;
+  }
+
+  if (process.env.SMS_DELIVERY === 'console' || import.meta.env.DEV) {
+    console.info(`[phone-verification] SMS to ${to}:\n${body}`);
+    return;
+  }
+
+  throw new SmsDeliveryError('No SMS provider configured');
+}
+
+// --- Flow ------------------------------------------------------------------------
+
+export type SendResult =
+  | { ok: true; maskedPhone: string; expiresIn: number; resendIn: number }
+  | { ok: false; status: number; error: string; code: string; retryAfter?: number };
+
+export async function sendVerificationCode(session: AstroSession, phone: string, host: string): Promise<SendResult> {
+  const now = Date.now();
+  const existing = (await session.get(CHALLENGE_KEY)) as PhoneChallenge | undefined;
+
+  if (existing && now - existing.lastSentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.lastSentAt)) / 1000);
+    return { ok: false, status: 429, code: 'RESEND_TOO_SOON', error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter };
+  }
+
+  const sessionSends = recentSends(existing?.sendTimestamps ?? [], now);
+  pruneLimiter(now);
+  const phoneSends = recentSends(sendsByPhone.get(phone) ?? [], now);
+  if (sessionSends.length >= MAX_SENDS_PER_WINDOW || phoneSends.length >= MAX_SENDS_PER_WINDOW) {
+    const oldest = Math.min(...(sessionSends.length >= MAX_SENDS_PER_WINDOW ? sessionSends : phoneSends));
+    const retryAfter = Math.ceil((SEND_WINDOW_MS - (now - oldest)) / 1000);
+    return { ok: false, status: 429, code: 'TOO_MANY_CODES', error: 'Too many codes requested. Please try again later.', retryAfter };
+  }
+
+  const code = generateCode();
+  const salt = randomBytes(16).toString('hex');
+  const smsHost = process.env.SMS_OTP_DOMAIN || host;
+
+  try {
+    await deliverSms(phone, buildSmsBody(code, smsHost));
+  } catch (err) {
+    if (!(err instanceof SmsDeliveryError)) console.error('[phone-verification]', err);
+    return { ok: false, status: 503, code: 'SMS_UNAVAILABLE', error: "We couldn't send a text message right now. Please try again later." };
+  }
+
+  sendsByPhone.set(phone, [...phoneSends, now]);
+  const challenge: PhoneChallenge = {
+    phone,
+    salt,
+    codeHash: hashCode(code, salt),
+    expiresAt: now + CODE_TTL_MS,
+    attempts: 0,
+    lastSentAt: now,
+    sendTimestamps: [...sessionSends, now],
+  };
+  await session.set(CHALLENGE_KEY, challenge);
+  session.delete(VERIFIED_KEY);
+
+  return { ok: true, maskedPhone: maskPhone(phone), expiresIn: CODE_TTL_MS / 1000, resendIn: RESEND_COOLDOWN_MS / 1000 };
+}
+
+export type VerifyResult =
+  | { ok: true; phone: string }
+  | { ok: false; status: number; error: string; code: string; attemptsRemaining?: number };
+
+export async function verifyCode(session: AstroSession, rawCode: unknown): Promise<VerifyResult> {
+  const code = typeof rawCode === 'string' ? rawCode.replace(/\D/g, '') : '';
+  if (code.length !== CODE_LENGTH) {
+    return { ok: false, status: 400, code: 'INVALID_FORMAT', error: `Enter the ${CODE_LENGTH}-digit code.` };
+  }
+
+  const challenge = (await session.get(CHALLENGE_KEY)) as PhoneChallenge | undefined;
+  if (!challenge || challenge.attempts >= MAX_VERIFY_ATTEMPTS) {
+    return { ok: false, status: 400, code: 'NO_ACTIVE_CODE', error: 'This code is no longer valid. Request a new code.' };
+  }
+  if (Date.now() > challenge.expiresAt) {
+    return { ok: false, status: 400, code: 'CODE_EXPIRED', error: 'This code has expired. Request a new code.' };
+  }
+
+  const expected = Buffer.from(challenge.codeHash, 'hex');
+  const actual = Buffer.from(hashCode(code, challenge.salt), 'hex');
+  if (!timingSafeEqual(expected, actual)) {
+    const attempts = challenge.attempts + 1;
+    await session.set(CHALLENGE_KEY, { ...challenge, attempts });
+    const attemptsRemaining = MAX_VERIFY_ATTEMPTS - attempts;
+    return attemptsRemaining > 0
+      ? { ok: false, status: 400, code: 'INCORRECT_CODE', error: `That code is incorrect. ${attemptsRemaining} ${attemptsRemaining === 1 ? 'attempt' : 'attempts'} remaining.`, attemptsRemaining }
+      : { ok: false, status: 400, code: 'NO_ACTIVE_CODE', error: 'Too many incorrect attempts. Request a new code.', attemptsRemaining: 0 };
+  }
+
+  // Single use: drop the challenge but keep the send history for rate limiting.
+  await session.set(CHALLENGE_KEY, { ...challenge, codeHash: '', expiresAt: 0, attempts: MAX_VERIFY_ATTEMPTS });
+  await session.set(VERIFIED_KEY, { phone: challenge.phone, verifiedAt: Date.now() } satisfies PhoneVerified);
+  // Rotate the session id after a privilege change.
+  await session.regenerate();
+  return { ok: true, phone: challenge.phone };
+}
+
+/** Returns the verified phone number if verification is still fresh. */
+export async function getVerifiedPhone(session: AstroSession): Promise<string | null> {
+  const verified = (await session.get(VERIFIED_KEY)) as PhoneVerified | undefined;
+  if (!verified || Date.now() - verified.verifiedAt > VERIFIED_TTL_MS) return null;
+  return verified.phone;
+}
+
+export function clearVerifiedPhone(session: AstroSession) {
+  session.delete(VERIFIED_KEY);
+}
