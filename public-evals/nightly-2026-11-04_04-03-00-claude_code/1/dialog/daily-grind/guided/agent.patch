+  <script type="module">
+    // Load the Invoker Commands polyfill only where command/commandfor are not supported natively.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch((err) => console.error('Invokers polyfill failed to load:', err));
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+        price: 4.75,
+        caffeine: 'Medium',
+        calories: '190 (12 oz)',
+        milk: 'oat',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1120&h=630&q=80',
+        alt: 'Latte art being poured into a white cup',
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. A rich double shot pulled from our signature dark roast.',
+        price: 3.25,
+        caffeine: 'High',
+        calories: '5 (double shot)',
+        milk: 'none',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1120&h=630&q=80',
+        alt: 'A cup of espresso with golden crema, seen from above',
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. Low acidity with notes of chocolate and toasted nuts.',
+        price: 4.25,
+        caffeine: 'High',
+        calories: '15 (16 oz)',
+        milk: 'none',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1120&h=630&q=80',
+        alt: 'A tall glass of iced cold brew with cream swirling in',
+      },
+    };
+    const SIZE_UPCHARGE = { small: 0, medium: 0.5, large: 1 };
+    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-form');
+    const $ = (id) => document.getElementById(id);
+
+    function updateTotal() {
+      const drink = DRINKS[form.drink.value];
+      const qty = Math.min(10, Math.max(1, Number.parseInt(form.quantity.value, 10) || 1));
+      const total = (drink.price + SIZE_UPCHARGE[form.size.value]) * qty;
+      $('order-total').value = `Total: ${money.format(total)}`;
+    }
+
+    function showDrink(key) {
+      const drink = DRINKS[key] ?? DRINKS['maple-oat-latte'];
+      form.drink.value = key in DRINKS ? key : 'maple-oat-latte';
+      $('drink-title').textContent = drink.name;
+      $('drink-description').textContent = drink.description;
+      $('drink-price').textContent = money.format(drink.price);
+      $('drink-caffeine').textContent = drink.caffeine;
+      $('drink-calories').textContent = drink.calories;
+      $('drink-image').src = drink.image;
+      $('drink-image').alt = drink.alt;
+      form.milk.value = drink.milk;
+      updateTotal();
+    }
+
+    // Populate the dialog from the invoking button before it opens. `command` fires on the
+    // target (it does not bubble) ahead of the default show-modal action.
+    dialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      form.reset();
+      showDrink(event.source?.dataset.drink ?? 'maple-oat-latte');
+    });
+
+    form.drink.addEventListener('change', () => showDrink(form.drink.value));
+    form.addEventListener('input', (event) => {
+      if (event.target !== form.drink) updateTotal();
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'order') {
+        const drink = DRINKS[form.drink.value];
+        const qty = Math.max(1, Number.parseInt(form.quantity.value, 10) || 1);
+        $('order-status').textContent =
+          `Added ${qty} × ${form.size.value} ${drink.name} to your order.`;
+      }
+      // Esc / light dismiss set no returnValue; reset so a stale value can't leak into the next close.
+      dialog.returnValue = '';
+    });
+
+    // Light-dismiss fallback where <dialog closedby> is unsupported (e.g. Safari).
+    // Esc and the back gesture already close modal dialogs everywhere.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e)) dialog.close();
+        pressedOutside = false;
+      });
+    }
+  </script>
