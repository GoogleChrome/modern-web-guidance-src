+    /* ==========================================================
+       Icon system
+       - Icons are inline SVG data URIs applied as CSS masks: no extra
+         HTTP requests, vector-sharp at any pixel density, and painted
+         with `currentColor` so they follow the surrounding text color.
+       - Assign an icon purely in CSS by setting `--icon` (e.g. via an
+         `.icon--name` modifier or any selector of your own).
+       - Customize per instance with `--icon-size` and `color`.
+       - Icon elements are decorative: mark them `aria-hidden="true"` and
+         let the adjacent text carry the meaning. When text is hidden
+         visually, keep it available with `.visually-hidden`.
+       ========================================================== */
+    .icon {
+      --icon-size: 1.15em;
+      display: inline-block;
+      flex-shrink: 0;
+      width: var(--icon-size);
+      height: var(--icon-size);
+      vertical-align: -0.2em;
+      background-color: currentColor;
+      -webkit-mask: var(--icon) center / contain no-repeat;
+      mask: var(--icon) center / contain no-repeat;
+    }
+
+    /* Keep icons visible in Windows High Contrast / forced-colors mode */
+    @media (forced-colors: active) {
