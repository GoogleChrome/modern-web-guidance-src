+// Hydrates server-rendered <drink-card> elements in place.
+// The shadow tree (markup + styles) ships in the HTML via Declarative Shadow DOM,
+// so this script only attaches behavior — it never re-renders.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(favorites) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+  } catch {
+    // Storage unavailable (private mode, quota); state stays in-memory only.
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  #button;
+
+  constructor() {
+    super();
+
+    // Fallback for engines that don't parse `shadowrootmode`: attach the shadow
+    // root imperatively from the same server-rendered template.
+    if (!this.shadowRoot) {
+      const template = this.querySelector(':scope > template[shadowrootmode]');
+      if (template) {
+        this.attachShadow({ mode: 'open' }).append(template.content);
+        template.remove();
+      }
+    }
+
+    // Hydrate: wire up the existing button once (constructor runs once per element,
+    // unlike connectedCallback which re-runs when the element is moved).
+    this.#button = this.shadowRoot?.querySelector('.fav');
+    this.#button?.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#button) return;
+    this.#setPressed(readFavorites().has(this.drinkId));
+    this.#button.disabled = false;
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id');
+  }
+
+  get favorite() {
+    return this.#button?.getAttribute('aria-pressed') === 'true';
+  }
+
+  set favorite(value) {
+    const on = Boolean(value);
+    this.#setPressed(on);
+
+    const favorites = readFavorites();
+    if (on) favorites.add(this.drinkId);
+    else favorites.delete(this.drinkId);
+    writeFavorites(favorites);
+
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkId: this.drinkId, favorite: on },
+      }),
+    );
+  }
+
+  #setPressed(on) {
+    this.#button?.setAttribute('aria-pressed', String(on));
+    this.toggleAttribute('favorite', on);
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
