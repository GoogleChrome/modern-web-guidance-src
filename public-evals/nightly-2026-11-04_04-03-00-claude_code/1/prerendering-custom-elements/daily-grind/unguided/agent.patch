diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..0c5ddde
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,95 @@
+// <drink-card> — hydrates a server-rendered (Declarative Shadow DOM) drink card.
+//
+// The shadow tree, styles and button already exist in the HTML, so this
+// module never re-renders: it reuses the existing shadow root and only
+// attaches behaviour (favorite toggle persisted to localStorage).
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
+    return new Set(Array.isArray(parsed) ? parsed : []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    // Storage unavailable (private mode, quota) — toggle still works for this page view.
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  #internals = this.attachInternals();
+  #button = null;
+
+  connectedCallback() {
+    const root = this.#ensureShadowRoot();
+    if (!root || this.#button) return;
+
+    this.#button = root.querySelector('.fav');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', this.#onToggle);
+    this.#applyState(readFavorites().has(this.drinkId));
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#onToggle);
+    this.#button = null;
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id') || '';
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+
+  // Reuse the shadow root the parser created from <template shadowrootmode>.
+  // Only browsers without Declarative Shadow DOM fall through to the manual path.
+  #ensureShadowRoot() {
+    const existing = this.#internals.shadowRoot;
+    if (existing) return existing;
+
+    const template = this.querySelector(':scope > template[shadowrootmode]');
+    if (!template) return null;
+    const root = this.attachShadow({ mode: template.getAttribute('shadowrootmode') || 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    template.remove();
+    return root;
+  }
+
+  #onToggle = () => {
+    const next = !this.favorited;
+    const favorites = readFavorites();
+    if (next) favorites.add(this.drinkId);
+    else favorites.delete(this.drinkId);
+    writeFavorites(favorites);
+
+    this.#applyState(next);
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkId: this.drinkId, favorited: next },
+      }),
+    );
+  };
+
+  #applyState(on) {
+    this.toggleAttribute('favorited', on);
+    const name = this.querySelector('[slot="title"]')?.textContent.trim() || 'drink';
+    this.#button.setAttribute('aria-pressed', String(on));
+    this.#button.setAttribute('aria-label', `${on ? 'Remove' : 'Add'} ${name} ${on ? 'from' : 'to'} favorites`);
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
