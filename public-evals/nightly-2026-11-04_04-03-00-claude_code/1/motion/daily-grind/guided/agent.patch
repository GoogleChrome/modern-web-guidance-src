+          alt: 'A tall glass of iced coffee with cream swirling through it',
+          href: '/menu/cold-brew'
+        }
+      };
+
+      const dialog = document.getElementById('drink-dialog');
+      const closeBtn = dialog.querySelector('.dialog-close');
+      const fields = {
+        img: document.getElementById('drink-dialog-img'),
+        title: document.getElementById('drink-dialog-title'),
+        desc: document.getElementById('drink-dialog-desc'),
+        notes: document.getElementById('drink-dialog-notes'),
+        sizes: document.getElementById('drink-dialog-sizes'),
+        caffeine: document.getElementById('drink-dialog-caffeine'),
+        link: document.getElementById('drink-dialog-link')
+      };
+
+      // Detect whether display/overlay can be transitioned (exit animation in pure CSS).
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+          return (supportsDisplayTransition = false);
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      const supportsTopLayerExit = () =>
+        Boolean(window.CSS?.supports?.('overlay', 'auto')) && canTransitionDisplay();
+
+      async function closeDialog() {
+        if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+        if (!supportsTopLayerExit()) {
+          // Run the exit transition while still in the top layer, then close.
+          dialog.setAttribute('data-closing', '');
+          const animations = dialog.getAnimations({ subtree: true });
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 1000))
+            ]);
+          }
+          if (!dialog.hasAttribute('data-closing')) return;
+          dialog.removeAttribute('data-closing');
+        }
+        dialog.close();
+      }
+
+      function openDrink(id) {
+        const drink = drinks[id];
+        if (!drink) return false;
+        fields.img.src = drink.img;
+        fields.img.alt = drink.alt;
+        fields.title.textContent = drink.name;
+        fields.desc.textContent = drink.desc;
+        fields.notes.textContent = drink.notes;
+        fields.sizes.textContent = drink.sizes;
+        fields.caffeine.textContent = drink.caffeine;
+        fields.link.href = drink.href;
+        dialog.removeAttribute('data-closing');
+        dialog.showModal();
+        return true;
+      }
+
+      // Progressive enhancement: links still navigate without JS.
+      document.querySelectorAll('.card [data-drink]').forEach((link) => {
+        link.setAttribute('aria-haspopup', 'dialog');
+        link.addEventListener('click', (event) => {
+          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          if (openDrink(link.dataset.drink)) event.preventDefault();
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDialog);
+
+      // Route Esc / close requests / light dismiss through the animated close.
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        closeDialog();
+      });
+
+      // Light-dismiss fallback where closedby isn't supported.
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) closeDialog();
+        });
+      }
+    })();
+  </script>
