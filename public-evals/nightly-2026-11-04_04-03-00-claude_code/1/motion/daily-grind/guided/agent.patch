+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          desc: 'A double shot of our darkest small-batch roast with a thick, hazelnut-coloured crema.',
+          notes: 'Smoke, dark chocolate, molasses',
+          sizes: 'Single $2.75 · Double $3.50',
+          caffeine: 'High',
+          img: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1040&q=75',
+          alt: 'An espresso with golden crema in a white cup on a dark table',
+          href: '/menu/espresso'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          desc: 'Coarse-ground beans steeped in cold water for 18 hours, then served over ice for a naturally sweet, low-acid cup.',
+          notes: 'Milk chocolate, cherry, toffee',
+          sizes: '16 oz $4.75 · 24 oz $5.50',
