+      background: linear-gradient(to top, rgba(62, 39, 35, 0.25), transparent);
+    }
+
+    /* Show the top indicator only once the user has scrolled down */
+    @container scroll-state(scrollable: top) {
+      .indicator-top {
+        opacity: 1;
+      }
+    }
+
+    /* Show the bottom indicator only while there is more content below */
+    @container scroll-state(scrollable: bottom) {
+      .indicator-bottom {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback state classes set by IntersectionObserver in browsers without scroll-state queries */
+    .reviews-scroller.scrolled-down .indicator-top,
+    .reviews-scroller.can-scroll-down .indicator-bottom {
+      opacity: 1;
+    }
+
