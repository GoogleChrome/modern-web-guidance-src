diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,8 +151,42 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Autofill highlight: green border + light green tint so the state
+       isn't conveyed by color alone. box-shadow is used for the tint because
+       browsers don't let you override background-color on autofilled fields.
+       Standard and -webkit- selectors are kept in separate rules so a browser
+       that doesn't recognize one doesn't drop the whole rule. */
+    input:autofill,
+    select:autofill,
+    textarea:autofill {
+      border: 2px solid #2e7d32;
+      box-shadow: 0 0 0 100vmax #e8f5e9 inset;
+    }
+
+    input:-webkit-autofill,
+    select:-webkit-autofill,
+    textarea:-webkit-autofill {
+      border: 2px solid #2e7d32;
+      box-shadow: 0 0 0 100vmax #e8f5e9 inset;
+    }
+
+    /* Keep a clear focus indicator on autofilled fields */
+    input:autofill:focus-visible,
+    select:autofill:focus-visible,
+    textarea:autofill:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: 2px;
+    }
+
+    input:-webkit-autofill:focus-visible,
+    select:-webkit-autofill:focus-visible,
+    textarea:-webkit-autofill:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: 2px;
+    }
   </style>
 </head>
 
 <body>
