diff --git a/locations/index.html b/locations/index.html
new file mode 100644
index 0000000..55222e4
--- /dev/null
+++ b/locations/index.html
@@ -0,0 +1,84 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <!--
+    Head order matters for smooth page transitions. A cross-document view
+    transition starts at the new page's first render, so everything that
+    shapes the first frame has to block rendering:
+      1. the stylesheet (header styles and the @view-transition opt-in) blocks render;
+      2. the inline theme/layout script is parser-blocking, so it runs before first paint;
+      3. rel="expect" holds render until #locations-list (above the fold) is fully parsed.
+         The footer comes after that element, so the transition doesn't wait for it.
+  -->
+  <link rel="stylesheet" href="/css/site.css">
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var saved = null;
+      try { saved = localStorage.getItem('dg-theme'); } catch (e) {}
+      var theme = saved || (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+      root.dataset.theme = theme;
+      root.classList.add('js');
+    })();
+  </script>
+  <link rel="expect" href="#locations-list" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short" style="--hero-img: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80');">
+    <h1>Find Your Grind</h1>
+    <p>Neighborhood cafés with plenty of room to linger.</p>
+  </header>
+
+  <main class="container">
+    <section id="locations-list">
+      <h2 style="text-align: center;">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>120 Main Street</p>
+          <p>Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>48 Water Lane</p>
+          <p>Daily 7am–8pm</p>
+        </div>
+        <div class="card">
+          <h3>University District</h3>
+          <p>905 College Ave</p>
+          <p>Daily 6:30am–10pm</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
