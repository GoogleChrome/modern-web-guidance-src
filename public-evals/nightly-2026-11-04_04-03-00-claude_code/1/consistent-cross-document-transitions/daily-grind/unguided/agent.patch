+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+  <!--
+    Head order matters for smooth page transitions. A cross-document view
+    transition starts at the new page's first render, so everything that
+    shapes the first frame has to block rendering:
+      1. the stylesheet (header styles and the @view-transition opt-in) blocks render;
+      2. the inline theme/layout script is parser-blocking, so it runs before first paint;
+      3. rel="expect" holds render until #menu-content (above the fold) is fully parsed.
+         The footer comes after that element, so the transition doesn't wait for it.
+  -->
+  <link rel="stylesheet" href="/css/site.css">
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var saved = null;
+      try { saved = localStorage.getItem('dg-theme'); } catch (e) {}
+      var theme = saved || (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+      root.dataset.theme = theme;
+      root.classList.add('js');
+    })();
+  </script>
+  <link rel="expect" href="#menu-content" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu/" aria-current="page">Menu</a></li>
+      <li><a href="/locations/">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short" style="--hero-img: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80');">
+    <h1>Our Menu</h1>
+    <p>Small-batch roasts and house-made syrups, pulled fresh every morning.</p>
+  </header>
+
+  <main class="container" id="menu-content">
+    <h2 class="section-title" id="seasonal">Seasonal</h2>
+    <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <span class="price">$5.75</span>
+        </div>
+        <div class="card">
+          <h3>Pumpkin Chai</h3>
+          <p>Spiced black tea, steamed milk, and real roasted pumpkin.</p>
+          <span class="price">$5.50</span>
+        </div>
+    </div>
+
+    <h2 class="section-title" id="espresso">Espresso</h2>
+    <div class="grid">
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <span class="price">$3.25</span>
+        </div>
+        <div class="card">
+          <h3>Cortado</h3>
+          <p>Equal parts espresso and silky steamed milk.</p>
+          <span class="price">$4.25</span>
+        </div>
+        <div class="card">
+          <h3>Flat White</h3>
+          <p>A double ristretto with velvety microfoam.</p>
+          <span class="price">$4.75</span>
+        </div>
+    </div>
+
+    <h2 class="section-title" id="cold-brew">Cold Brew</h2>
+    <div class="grid">
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <span class="price">$4.50</span>
+        </div>
+        <div class="card">
+          <h3>Vanilla Sweet Cream Cold Brew</h3>
+          <p>Our cold brew topped with house vanilla cream.</p>
+          <span class="price">$5.25</span>
+        </div>
+    </div>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
