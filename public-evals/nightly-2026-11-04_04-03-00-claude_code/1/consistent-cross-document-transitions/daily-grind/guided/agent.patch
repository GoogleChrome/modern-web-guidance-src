+  <title>Locations | The Daily Grind</title>
+
+  <!-- Header + layout styles: render-blocking by default in <head>. -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!-- Initial theme script: must run before first paint / transition snapshot. -->
+  <script async blocking="render" src="/js/theme.js"></script>
+
+  <!-- Fetch the hero image early so it is ready for the transition snapshot. -->
