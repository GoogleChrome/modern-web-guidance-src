+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>120 Main Street<br>Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>48 Mill Road<br>Daily 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>University District</h3>
+          <p>9 College Avenue<br>Daily 6am–10pm</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
