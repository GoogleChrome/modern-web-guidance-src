diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..bfaf603
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,480 @@
+/**
+ * On-device page translation built on the browser's built-in AI APIs
+ * (`Translator` and `LanguageDetector`, shipped in Chrome 138+).
+ *
+ * Everything runs locally: language models are downloaded once by the browser
+ * and article text never leaves the device.
+ *
+ * Any static element marked with `data-translatable` is translated. Text nodes
+ * are translated individually so inline markup (links, bold, etc.) survives,
+ * and the original text is kept so the page can be restored at any time.
+ */
+
+// ---------------------------------------------------------------------------
+// Minimal typings for the built-in AI APIs (not yet part of lib.dom).
+// ---------------------------------------------------------------------------
+
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface DownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface CreateMonitor extends EventTarget {}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<Availability>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal?: AbortSignal;
+    monitor?: (m: CreateMonitor) => void;
+  }): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string): Promise<{ detectedLanguage: string; confidence: number }[]>;
+}
+
+interface LanguageDetectorStatic {
+  availability(): Promise<Availability>;
+  create(options?: { monitor?: (m: CreateMonitor) => void }): Promise<LanguageDetectorInstance>;
+}
+
+const getTranslatorApi = (): TranslatorStatic | undefined =>
+  typeof self !== 'undefined' ? (self as any).Translator : undefined;
+
+const getDetectorApi = (): LanguageDetectorStatic | undefined =>
+  typeof self !== 'undefined' ? (self as any).LanguageDetector : undefined;
+
+export const isTranslationSupported = () => !!getTranslatorApi();
+
+// ---------------------------------------------------------------------------
+// Languages
+// ---------------------------------------------------------------------------
+
+export const LANGUAGE_CODES = [
+  'ar', 'bg', 'bn', 'cs', 'da', 'de', 'el', 'en', 'es', 'fi', 'fr', 'hi', 'hr',
+  'hu', 'id', 'it', 'iw', 'ja', 'kn', 'ko', 'lt', 'mr', 'nl', 'no', 'pl', 'pt',
+  'ro', 'ru', 'sk', 'sl', 'sv', 'ta', 'te', 'th', 'tr', 'uk', 'vi', 'zh', 'zh-Hant',
+] as const;
+
+let displayNames: Intl.DisplayNames | undefined;
+export function languageName(code: string): string {
+  try {
+    displayNames ??= new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+    // `iw` is the legacy code for Hebrew used by the translation models.
+    return displayNames.of(code === 'iw' ? 'he' : code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+export const LANGUAGES = () =>
+  LANGUAGE_CODES.map(code => ({ code, name: languageName(code) })).sort((a, b) =>
+    a.name.localeCompare(b.name),
+  );
+
+/** Normalises BCP 47 tags to the codes used by the translation models. */
+function normalizeLang(tag: string | null | undefined): string | undefined {
+  if (!tag) return undefined;
+  const lower = tag.toLowerCase();
+  if (lower === 'und') return undefined;
+  if (lower.startsWith('zh-hant') || lower === 'zh-tw' || lower === 'zh-hk') return 'zh-Hant';
+  const primary = lower.split('-')[0];
+  if (primary === 'he') return 'iw';
+  if (primary === 'nb' || primary === 'nn') return 'no';
+  return primary;
+}
+
+export function defaultTargetLanguage(): string {
+  const stored = readPrefs()?.targetLang;
+  if (stored) return stored;
+  const preferred = normalizeLang(typeof navigator !== 'undefined' ? navigator.language : 'en');
+  return preferred && preferred !== 'en' && (LANGUAGE_CODES as readonly string[]).includes(preferred)
+    ? preferred
+    : 'es';
+}
+
+// ---------------------------------------------------------------------------
+// Store
+// ---------------------------------------------------------------------------
+
+export type TranslationStatus =
+  | 'idle'
+  | 'preparing'
+  | 'downloading'
+  | 'translating'
+  | 'translated'
+  | 'error';
+
+export interface TranslationState {
+  status: TranslationStatus;
+  /** `'auto'` means detect the source language per element. */
+  sourceLang: string;
+  targetLang: string;
+  /** 0..1 – model download or translation progress. */
+  progress: number;
+  /** Source languages that were actually translated from. */
+  detectedLangs: string[];
+  message?: string;
+}
+
+const PREFS_KEY = 'devtools-times:translation';
+
+interface Prefs {
+  sourceLang: string;
+  targetLang: string;
+  /** Whether the reader wants pages translated automatically while browsing. */
+  active: boolean;
+}
+
+function readPrefs(): Prefs | undefined {
+  try {
+    const raw = localStorage.getItem(PREFS_KEY);
+    return raw ? (JSON.parse(raw) as Prefs) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function writePrefs(prefs: Prefs) {
+  try {
+    localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
+  } catch {
+    /* storage unavailable – ignore */
+  }
+}
+
+let state: TranslationState = {
+  status: 'idle',
+  sourceLang: 'auto',
+  targetLang: 'es',
+  progress: 0,
+  detectedLangs: [],
+};
+let initialised = false;
+const listeners = new Set<() => void>();
+
+function setState(patch: Partial<TranslationState>) {
+  state = { ...state, ...patch };
+  listeners.forEach(l => l());
+}
+
+export function getState() {
+  ensureInit();
+  return state;
+}
+
+export function subscribe(listener: () => void) {
+  ensureInit();
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+const SERVER_STATE = state;
+export const getServerState = () => SERVER_STATE;
+
+export function setLanguages(patch: { sourceLang?: string; targetLang?: string }) {
+  setState(patch);
+  writePrefs({ sourceLang: state.sourceLang, targetLang: state.targetLang, active: !!readPrefs()?.active });
+}
+
+// ---------------------------------------------------------------------------
+// Translation engine
+// ---------------------------------------------------------------------------
+
+const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'CODE', 'PRE', 'KBD', 'SAMP', 'NOSCRIPT', 'TEXTAREA']);
+
+/** Original text of every text node we have changed on the current page. */
+let originals = new Map<Text, string>();
+/** Elements whose `lang` attribute we changed, with their previous value. */
+let langChanges = new Map<HTMLElement, string | null>();
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+let detectorPromise: Promise<LanguageDetectorInstance | undefined> | undefined;
+let runId = 0;
+let abortController: AbortController | undefined;
+
+function collectElements(root: ParentNode = document): HTMLElement[] {
+  const all = Array.from(root.querySelectorAll<HTMLElement>('[data-translatable]'));
+  // Avoid translating nested translatable elements twice.
+  return all.filter(el => !el.parentElement?.closest('[data-translatable]'));
+}
+
+function collectTextNodes(el: HTMLElement): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      if (SKIP_TAGS.has(parent.tagName) || parent.closest('[translate="no"], astro-island')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      // Only translate nodes containing actual letters.
+      return /\p{L}/u.test(node.data) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function getDetector() {
+  const api = getDetectorApi();
+  if (!api) return Promise.resolve(undefined);
+  detectorPromise ??= (async () => {
+    try {
+      const availability = await api.availability();
+      if (availability === 'unavailable') return undefined;
+      return await api.create();
+    } catch {
+      return undefined;
+    }
+  })();
+  return detectorPromise;
+}
+
+async function detectLanguage(text: string, fallback: string): Promise<string> {
+  const detector = await getDetector();
+  if (!detector) return fallback;
+  try {
+    const [top] = await detector.detect(text.slice(0, 2000));
+    return (top && top.confidence >= 0.5 && normalizeLang(top.detectedLanguage)) || fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress: (loaded: number) => void,
+  signal: AbortSignal,
+): Promise<TranslatorInstance> {
+  const key = `${sourceLanguage}→${targetLanguage}`;
+  let promise = translators.get(key);
+  if (!promise) {
+    const api = getTranslatorApi()!;
+    promise = api.create({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor(m) {
+        m.addEventListener('downloadprogress', e => onProgress((e as DownloadProgressEvent).loaded));
+      },
+    });
+    translators.set(key, promise);
+    promise.catch(() => translators.delete(key));
+  }
+  return promise;
+}
+
+/** Translates text while keeping the node's leading/trailing whitespace. */
+async function translatePreservingWhitespace(t: TranslatorInstance, text: string, signal: AbortSignal) {
+  const match = text.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+  const translated = await t.translate(match[2], { signal });
+  return match[1] + translated + match[3];
+}
+
+async function runPool<T>(items: T[], limit: number, worker: (item: T) => Promise<void>) {
+  let index = 0;
+  const runners = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (index < items.length) await worker(items[index++]);
+  });
+  await Promise.all(runners);
+}
+
+function restoreDom() {
+  originals.forEach((text, node) => {
+    node.data = text;
+  });
+  langChanges.forEach((prev, el) => {
+    if (prev === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', prev);
+    el.removeAttribute('data-translated');
+  });
+  originals = new Map();
+  langChanges = new Map();
+}
+
+export interface TranslateOptions {
+  /** True when not triggered by a user gesture (e.g. on page navigation). */
+  automatic?: boolean;
+}
+
+export async function translatePage(options: TranslateOptions = {}): Promise<void> {
+  const api = getTranslatorApi();
+  if (!api) {
+    setState({ status: 'error', message: 'On-device translation is not supported in this browser.' });
+    return;
+  }
+
+  // Cancel any in-flight run and start from the original text.
+  abortController?.abort();
+  const controller = new AbortController();
+  abortController = controller;
+  const { signal } = controller;
+  const id = ++runId;
+  const isCurrent = () => id === runId;
+
+  restoreDom();
+  const { sourceLang, targetLang } = state;
+  setState({ status: 'preparing', progress: 0, detectedLangs: [], message: undefined });
+
+  try {
+    const pageLang = normalizeLang(document.documentElement.lang) ?? 'en';
+    const elements = collectElements();
+
+    // Group the text nodes to translate by their source language.
+    const groups = new Map<string, { el: HTMLElement; nodes: Text[] }[]>();
+    for (const el of elements) {
+      const nodes = collectTextNodes(el);
+      if (!nodes.length) continue;
+      const lang =
+        sourceLang === 'auto'
+          ? await detectLanguage(el.textContent ?? '', normalizeLang(el.closest<HTMLElement>('[lang]')?.lang) ?? pageLang)
+          : sourceLang;
+      if (!isCurrent()) return;
+      if (lang === targetLang) continue;
+      if (!groups.has(lang)) groups.set(lang, []);
+      groups.get(lang)!.push({ el, nodes });
+    }
+
+    if (!groups.size) {
+      setState({
+        status: 'idle',
+        message: `This page is already in ${languageName(targetLang)}.`,
+      });
+      return;
+    }
+
+    // Check model availability up front so we can report problems clearly.
+    const unsupported: string[] = [];
+    for (const lang of groups.keys()) {
+      const availability = await api.availability({ sourceLanguage: lang, targetLanguage: targetLang });
+      if (availability === 'unavailable') unsupported.push(lang);
+      else if (options.automatic && availability !== 'available') {
+        // Downloading a model requires a user gesture; let the reader opt in again.
+        if (isCurrent()) setState({ status: 'idle', message: undefined });
+        return;
+      }
+    }
+    unsupported.forEach(lang => groups.delete(lang));
+    if (!isCurrent()) return;
+    if (!groups.size) {
+      setState({
+        status: 'error',
+        message: `Translating ${unsupported.map(languageName).join(', ')} to ${languageName(targetLang)} isn't available on this device.`,
+      });
+      return;
+    }
+
+    // Create (and if needed download) all translators.
+    const ready = new Map<string, TranslatorInstance>();
+    for (const lang of groups.keys()) {
+      const translator = await getTranslator(
+        lang,
+        targetLang,
+        loaded => {
+          if (isCurrent() && loaded < 1) setState({ status: 'downloading', progress: loaded });
+        },
+        signal,
+      );
+      ready.set(lang, translator);
+    }
+    if (!isCurrent()) return;
+
+    const total = [...groups.values()].reduce((sum, g) => sum + g.reduce((s, e) => s + e.nodes.length, 0), 0);
+    let done = 0;
+    setState({ status: 'translating', progress: 0 });
+
+    for (const [lang, entries] of groups) {
+      const translator = ready.get(lang)!;
+      for (const { el, nodes } of entries) {
+        await runPool(nodes, 4, async node => {
+          const original = node.data;
+          const translated = await translatePreservingWhitespace(translator, original, signal);
+          if (!isCurrent()) return;
+          if (!originals.has(node)) originals.set(node, original);
+          node.data = translated;
+          done++;
+          setState({ progress: done / total });
+        });
+        if (!isCurrent()) return;
+        if (!langChanges.has(el)) langChanges.set(el, el.getAttribute('lang'));
+        el.setAttribute('lang', targetLang === 'iw' ? 'he' : targetLang);
+        el.setAttribute('data-translated', '');
+      }
+    }
+
+    writePrefs({ sourceLang, targetLang, active: true });
+    setState({
+      status: 'translated',
+      progress: 1,
+      detectedLangs: [...groups.keys()],
+      message: unsupported.length
+        ? `Some text in ${unsupported.map(languageName).join(', ')} couldn't be translated.`
+        : undefined,
+    });
+  } catch (err) {
+    if (!isCurrent() || signal.aborted) return;
+    console.error('[translation]', err);
+    restoreDom();
+    const name = (err as DOMException)?.name;
+    setState({
+      status: 'error',
+      progress: 0,
+      message:
+        name === 'NotAllowedError'
+          ? 'Click "Translate" to allow the translation model to download.'
+          : 'Translation failed. Please try again.',
+    });
+  }
+}
+
+export function showOriginal() {
+  abortController?.abort();
+  runId++;
+  restoreDom();
+  writePrefs({ sourceLang: state.sourceLang, targetLang: state.targetLang, active: false });
+  setState({ status: 'idle', progress: 0, detectedLangs: [], message: undefined });
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle: keep translating while the reader browses (Astro view transitions).
+// ---------------------------------------------------------------------------
+
+function ensureInit() {
+  if (initialised || typeof window === 'undefined') return;
+  initialised = true;
+
+  const prefs = readPrefs();
+  state = {
+    ...state,
+    sourceLang: prefs?.sourceLang ?? 'auto',
+    targetLang: defaultTargetLanguage(),
+  };
+
+  const autoTranslate = () => {
+    if (state.status !== 'idle' || !readPrefs()?.active || !isTranslationSupported()) return;
+    translatePage({ automatic: true });
+  };
+
+  // The old page's nodes are gone after a client-side navigation.
+  document.addEventListener('astro:after-swap', () => {
+    abortController?.abort();
+    runId++;
+    originals = new Map();
+    langChanges = new Map();
+    setState({ status: 'idle', progress: 0, detectedLangs: [], message: undefined });
+  });
+  document.addEventListener('astro:page-load', autoTranslate);
+
+  // `astro:page-load` for the initial page may already have fired.
+  if (document.readyState !== 'loading') queueMicrotask(autoTranslate);
+}
