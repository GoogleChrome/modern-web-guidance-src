diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..89fb4f0
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,279 @@
+import React, { useEffect, useId, useRef, useState, useSyncExternalStore } from 'react';
+import { LanguageIcon, XMarkIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  getServerState,
+  getState,
+  isTranslationSupported,
+  languageName,
+  setLanguages,
+  showOriginal,
+  subscribe,
+  translatePage,
+  type TranslationState,
+} from '../utils/translation';
+
+interface Props {
+  /** `header`: compact icon button with a popover. `inline`: bar shown above an article. */
+  variant?: 'header' | 'inline';
+}
+
+function useTranslationState() {
+  return useSyncExternalStore(subscribe, getState, getServerState);
+}
+
+function useSupported() {
+  // Feature detection must wait until after hydration to avoid mismatches.
+  const [supported, setSupported] = useState<boolean | null>(null);
+  useEffect(() => setSupported(isTranslationSupported()), []);
+  return supported;
+}
+
+const isBusy = (s: TranslationState) =>
+  s.status === 'preparing' || s.status === 'downloading' || s.status === 'translating';
+
+function statusText(s: TranslationState): string | undefined {
+  switch (s.status) {
+    case 'preparing':
+      return 'Preparing translation…';
+    case 'downloading':
+      return `Downloading language model… ${Math.round(s.progress * 100)}%`;
+    case 'translating':
+      return `Translating… ${Math.round(s.progress * 100)}%`;
+    case 'translated': {
+      const from = s.detectedLangs.map(languageName).join(', ');
+      return `Translated${from ? ` from ${from}` : ''} to ${languageName(s.targetLang)}.${s.message ? ` ${s.message}` : ''}`;
+    }
+    default:
+      return s.message;
+  }
+}
+
+function ProgressBar({ state }: { state: TranslationState }) {
+  if (!isBusy(state)) return null;
+  const indeterminate = state.status === 'preparing';
+  return (
+    <div
+      className="h-1 w-full bg-gray-200 rounded overflow-hidden"
+      role="progressbar"
+      aria-valuemin={0}
+      aria-valuemax={100}
+      aria-valuenow={indeterminate ? undefined : Math.round(state.progress * 100)}
+    >
+      <div
+        className={`h-full bg-amber-400 transition-all ${indeterminate ? 'w-1/3 animate-pulse' : ''}`}
+        style={indeterminate ? undefined : { width: `${Math.max(4, state.progress * 100)}%` }}
+      />
+    </div>
+  );
+}
+
+function LanguageSelect({
+  id,
+  value,
+  onChange,
+  includeAuto = false,
+  disabled,
+}: {
+  id: string;
+  value: string;
+  onChange: (value: string) => void;
+  includeAuto?: boolean;
+  disabled?: boolean;
+}) {
+  const languages = LANGUAGES();
+  return (
+    <select
+      id={id}
+      value={value}
+      disabled={disabled}
+      onChange={e => onChange(e.target.value)}
+      className="border border-gray-300 rounded bg-white text-sm py-1 px-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+    >
+      {includeAuto && <option value="auto">Detect language</option>}
+      {languages.map(l => (
+        <option key={l.code} value={l.code}>
+          {l.name}
+        </option>
+      ))}
+    </select>
+  );
+}
+
+function Controls({ state, compact }: { state: TranslationState; compact?: boolean }) {
+  const id = useId();
+  const busy = isBusy(state);
+  const translated = state.status === 'translated';
+
+  return (
+    <div className={`flex ${compact ? 'flex-col items-stretch gap-3' : 'flex-wrap items-center gap-2'}`}>
+      <div className={`flex items-center gap-2 ${compact ? 'justify-between' : ''}`}>
+        <label htmlFor={`${id}-from`} className="text-sm text-gray-600">
+          From
+        </label>
+        <LanguageSelect
+          id={`${id}-from`}
+          value={state.sourceLang}
+          includeAuto
+          disabled={busy}
+          onChange={sourceLang => setLanguages({ sourceLang })}
+        />
+      </div>
+      <div className={`flex items-center gap-2 ${compact ? 'justify-between' : ''}`}>
+        <label htmlFor={`${id}-to`} className="text-sm text-gray-600">
+          To
+        </label>
+        <LanguageSelect
+          id={`${id}-to`}
+          value={state.targetLang}
+          disabled={busy}
+          onChange={targetLang => setLanguages({ targetLang })}
+        />
+      </div>
+      <div className="flex items-center gap-2">
+        <button
+          type="button"
+          onClick={() => translatePage()}
+          disabled={busy || (state.sourceLang !== 'auto' && state.sourceLang === state.targetLang)}
+          className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
+        >
+          {busy ? 'Translating…' : translated ? 'Translate again' : 'Translate'}
+        </button>
+        {(translated || busy) && (
+          <button
+            type="button"
+            onClick={showOriginal}
+            className="text-xs font-semibold py-2 px-3 rounded border border-gray-300 text-gray-700 hover:bg-gray-100 whitespace-nowrap"
+          >
+            {busy ? 'Cancel' : 'Show original'}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function UnsupportedNote() {
+  return (
+    <p className="text-sm text-gray-600">
+      On-device translation needs a browser with the built-in Translator API, such as Chrome 138 or newer on desktop.
+    </p>
+  );
+}
+
+function StatusLine({ state }: { state: TranslationState }) {
+  const text = statusText(state);
+  return (
+    <>
+      <ProgressBar state={state} />
+      <p
+        aria-live="polite"
+        className={`text-xs ${state.status === 'error' ? 'text-red-700' : 'text-gray-500'} ${text ? '' : 'sr-only'}`}
+      >
+        {text}
+      </p>
+    </>
+  );
+}
+
+function HeaderControl() {
+  const state = useTranslationState();
+  const supported = useSupported();
+  const [open, setOpen] = useState(false);
+  const containerRef = useRef<HTMLDivElement>(null);
+  const panelId = useId();
+  const active = state.status === 'translated' || isBusy(state);
+
+  useEffect(() => {
+    if (!open) return;
+    const onPointerDown = (e: PointerEvent) => {
+      if (!containerRef.current?.contains(e.target as Node)) setOpen(false);
+    };
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') setOpen(false);
+    };
+    document.addEventListener('pointerdown', onPointerDown);
+    document.addEventListener('keydown', onKeyDown);
+    return () => {
+      document.removeEventListener('pointerdown', onPointerDown);
+      document.removeEventListener('keydown', onKeyDown);
+    };
+  }, [open]);
+
+  return (
+    <div ref={containerRef} className="relative" translate="no">
+      <button
+        type="button"
+        onClick={() => setOpen(o => !o)}
+        aria-expanded={open}
+        aria-controls={panelId}
+        aria-label="Translate this page"
+        title="Translate this page"
+        className="p-1 relative"
+      >
+        <LanguageIcon className={`h-6 w-6 ${active ? 'text-amber-500' : 'text-gray-600'}`} />
+        {active && (
+          <span className="absolute -bottom-0.5 -right-1 bg-amber-400 text-[9px] font-bold uppercase leading-none text-gray-900 rounded px-0.5 py-px">
+            {state.targetLang.slice(0, 2)}
+          </span>
+        )}
+      </button>
+      {open && (
+        <div
+          id={panelId}
+          role="dialog"
+          aria-label="Translate this page"
+          className="absolute left-0 top-full mt-2 z-50 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 flex flex-col gap-3"
+        >
+          <div className="flex items-start justify-between">
+            <div>
+              <h2 className="font-semibold text-gray-900">Translate this page</h2>
+              <p className="text-xs text-gray-500">Runs privately on your device.</p>
+            </div>
+            <button type="button" onClick={() => setOpen(false)} aria-label="Close" className="p-1 -m-1">
+              <XMarkIcon className="h-5 w-5 text-gray-500" />
+            </button>
+          </div>
+          {supported === false ? (
+            <UnsupportedNote />
+          ) : (
+            <>
+              <Controls state={state} compact />
+              <StatusLine state={state} />
+            </>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function InlineControl() {
+  const state = useTranslationState();
+  const supported = useSupported();
+
+  // Don't advertise a feature the browser can't provide.
+  if (!supported) return null;
+
+  return (
+    <section
+      aria-label="Translate article"
+      translate="no"
+      className="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 flex flex-col gap-2"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2 text-sm font-semibold text-gray-800">
+          <LanguageIcon className="h-5 w-5 text-amber-700" />
+          Read this article in another language
+        </div>
+        <Controls state={state} />
+      </div>
+      <StatusLine state={state} />
+      <p className="text-xs text-gray-500">Translated on your device by your browser's built-in AI. Machine translations may contain errors.</p>
+    </section>
+  );
+}
+
+export default function TranslateControl({ variant = 'header' }: Props) {
+  return variant === 'inline' ? <InlineControl /> : <HeaderControl />;
+}
