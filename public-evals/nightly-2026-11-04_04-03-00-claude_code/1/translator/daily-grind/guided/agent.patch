+  <script type="module">
+    // On-device translation using the built-in Translator API (Chrome/Edge desktop).
+    const SOURCE_LANG = 'en';
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('lang-status');
+    const progress = document.getElementById('lang-progress');
+    const targets = [...document.querySelectorAll('[data-translate]')];
+
+    // Remember the original English text so every translation starts from the source.
+    const originals = new Map(targets.map((el) => [el, el.textContent.trim()]));
+    const translators = new Map(); // targetLanguage -> Translator instance
+    let requestId = 0;
+
+    const setStatus = (msg) => { status.textContent = msg; };
+
+    function restoreOriginal() {
+      for (const el of targets) {
+        el.textContent = originals.get(el);
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+
+      if (availability !== 'available') {
+        progress.value = 0;
+        progress.hidden = false;
+        setStatus('Downloading language pack…');
+      }
+
+      // Called synchronously from the change event so the user gesture is still active.
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            progress.value = e.loaded;
+            setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+          });
+        },
+      });
+      progress.hidden = true;
+      translators.set(targetLanguage, translator);
+      return translator;
+    }
+
+    async function translatePage(targetLanguage) {
+      const id = ++requestId;
+      const label = select.selectedOptions[0].textContent;
+
+      if (targetLanguage === SOURCE_LANG) {
+        restoreOriginal();
+        setStatus('Showing original English text.');
+        return;
+      }
+
+      try {
+        setStatus(`Preparing ${label}…`);
+        const translator = await getTranslator(targetLanguage);
+        if (id !== requestId) return; // a newer selection superseded this one
+
+        if (!translator) {
+          setStatus(`${label} isn't available for on-device translation on this device.`);
+          return;
+        }
+
+        setStatus(`Translating to ${label}…`);
+        targets.forEach((el) => el.classList.add('is-translating'));
+        const dir = ['ar', 'he'].includes(targetLanguage) ? 'rtl' : 'ltr';
+
+        await Promise.all(targets.map(async (el) => {
+          const text = await translator.translate(originals.get(el));
+          if (id !== requestId) return;
+          el.textContent = text;
+          el.lang = targetLanguage;
+          el.dir = dir;
+          el.classList.remove('is-translating');
+        }));
+
+        if (id === requestId) setStatus(`Translated on your device to ${label}.`);
+      } catch (err) {
+        console.error(err);
+        if (id !== requestId) return;
+        progress.hidden = true;
+        restoreOriginal();
+        setStatus(err.name === 'NotAllowedError'
+          ? 'Please choose the language again to start the download.'
+          : 'Translation failed. Showing original English text.');
+      } finally {
+        if (id === requestId) targets.forEach((el) => el.classList.remove('is-translating'));
+      }
+    }
+
+    if ('Translator' in self) {
+      select.disabled = false;
+      setStatus('Translation happens privately on your device.');
+      select.addEventListener('change', () => translatePage(select.value));
+    } else {
+      setStatus('On-device translation is not supported in this browser.');
+    }
+  </script>
+
 </body>
 
