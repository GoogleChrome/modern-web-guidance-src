+  <script>
+    // On-device translation using the browser's built-in Translator API
+    // (https://developer.chrome.com/docs/ai/translator-api). Text never leaves the device.
+    (() => {
+      const SOURCE = 'en';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('translate-status');
+      const nodes = [...document.querySelectorAll('[data-i18n]')];
+      const translators = new Map(); // target language -> Promise<Translator>
+      let requestId = 0;
+
+      nodes.forEach((el) => { el.dataset.i18nSource = el.textContent.trim(); });
+
+      const setStatus = (msg) => { status.textContent = msg; };
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser';
+        setStatus('On-device translation isn\u2019t supported in this browser. Try a recent version of Chrome on desktop.');
+        return;
+      }
+
+      function getTranslator(target) {
+        if (!translators.has(target)) {
+          const promise = Translator.create({
+            sourceLanguage: SOURCE,
+            targetLanguage: target,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                setStatus(`Downloading language pack\u2026 ${Math.round(e.loaded * 100)}%`);
+              });
+            },
+          });
+          // Don't cache failures so the user can retry.
+          promise.catch(() => translators.delete(target));
+          translators.set(target, promise);
+        }
+        return translators.get(target);
+      }
+
+      function restoreOriginal() {
+        nodes.forEach((el) => {
+          el.textContent = el.dataset.i18nSource;
+          el.removeAttribute('lang');
+          el.classList.remove('is-translating');
+        });
+        document.documentElement.lang = SOURCE;
+      }
+
+      select.addEventListener('change', async () => {
+        const target = select.value;
+        const id = ++requestId;
+
+        if (target === SOURCE) {
+          restoreOriginal();
+          setStatus('');
+          return;
+        }
+
+        const label = select.selectedOptions[0].textContent;
+        try {
+          const availability = await Translator.availability({ sourceLanguage: SOURCE, targetLanguage: target });
+          if (id !== requestId) return;
+          if (availability === 'unavailable') {
+            setStatus(`${label} isn\u2019t available for on-device translation on this device.`);
+            return;
+          }
+
+          setStatus(availability === 'available' ? `Translating to ${label}\u2026` : `Preparing ${label}\u2026`);
+          nodes.forEach((el) => el.classList.add('is-translating'));
+
+          const translator = await getTranslator(target);
+          if (id !== requestId) return;
+
+          const results = await Promise.all(nodes.map((el) => translator.translate(el.dataset.i18nSource)));
+          if (id !== requestId) return;
+
+          nodes.forEach((el, i) => {
+            el.textContent = results[i];
+            el.lang = target;
+            el.classList.remove('is-translating');
+          });
+          document.documentElement.lang = target;
+          setStatus(`Translated on your device to ${label}.`);
+        } catch (err) {
+          if (id !== requestId) return;
+          console.error('Translation failed:', err);
+          restoreOriginal();
+          setStatus(`Couldn\u2019t translate to ${label}. Please try again.`);
+        }
+      });
+    })();
+  </script>
+
