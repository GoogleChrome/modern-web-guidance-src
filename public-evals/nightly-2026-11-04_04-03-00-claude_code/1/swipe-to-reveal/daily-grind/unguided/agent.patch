+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.swipe-card'));
+      const status = document.querySelector('.action-status');
+      const DRAG_THRESHOLD = 8;   // px of movement before we decide a gesture direction
+      const FAVORITES_KEY = 'dg-favorite-drinks';
+
+      let favorites = [];
+      try { favorites = JSON.parse(localStorage.getItem(FAVORITES_KEY)) || []; } catch (e) { favorites = []; }
+
+      function actionsWidth(card) {
+        return card.querySelector('.card-actions').offsetWidth;
+      }
+
+      function setOpen(card, open) {
+        const content = card.querySelector('.card-content');
+        const actions = card.querySelector('.card-actions');
+        const toggle = card.querySelector('.actions-toggle');
+        card.classList.toggle('open', open);
+        content.style.transform = '';
+        actions.inert = !open;
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.setAttribute('aria-label', (open ? 'Hide' : 'Show') + ' actions for ' + card.dataset.drinkName);
+      }
+
+      function closeOthers(except) {
+        cards.forEach(c => { if (c !== except && c.classList.contains('open')) setOpen(c, false); });
+      }
+
+      function syncFavorite(card) {
+        const btn = card.querySelector('[data-action="favorite"]');
+        const on = favorites.includes(card.dataset.drink);
+        btn.setAttribute('aria-pressed', String(on));
+        btn.querySelector('.label').textContent = on ? 'Favorited' : 'Favorite';
+      }
+
+      cards.forEach(card => {
+        const content = card.querySelector('.card-content');
+        const toggle = card.querySelector('.actions-toggle');
+        let startX = 0, startY = 0, baseOffset = 0, offset = 0;
+        let pointerId = null, mode = null; // mode: null | 'swipe' | 'scroll'
+        let suppressClick = false;
+
+        syncFavorite(card);
+
+        content.addEventListener('pointerdown', e => {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          if (e.target.closest('.actions-toggle')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseOffset = card.classList.contains('open') ? -actionsWidth(card) : 0;
+          offset = baseOffset;
+          mode = null;
+          suppressClick = false;
+        });
+
+        content.addEventListener('pointermove', e => {
+          if (e.pointerId !== pointerId) return;
+          const dx = e.clientX - startX;
+          const dy = e.clientY - startY;
+
+          if (mode === null) {
+            if (Math.abs(dx) < DRAG_THRESHOLD && Math.abs(dy) < DRAG_THRESHOLD) return;
+            mode = Math.abs(dx) > Math.abs(dy) ? 'swipe' : 'scroll';
+            if (mode === 'swipe') {
+              content.setPointerCapture(pointerId);
+              card.classList.add('dragging');
+              closeOthers(card);
+            }
+          }
+          if (mode !== 'swipe') return;
+
+          const max = actionsWidth(card);
+          offset = Math.min(0, Math.max(-max, baseOffset + dx));
+          content.style.transform = 'translateX(' + offset + 'px)';
+        });
+
+        function endGesture(e) {
+          if (e.pointerId !== pointerId) return;
+          if (mode === 'swipe') {
+            card.classList.remove('dragging');
+            // Snap open or closed based on how far it travelled. Never trigger an action here.
+            setOpen(card, offset < -actionsWidth(card) / 2);
+            suppressClick = true;
+          }
+          pointerId = null;
+          mode = null;
+        }
+        content.addEventListener('pointerup', endGesture);
+        content.addEventListener('pointercancel', e => {
+          if (e.pointerId !== pointerId) return;
+          card.classList.remove('dragging');
+          setOpen(card, card.classList.contains('open'));
+          pointerId = null;
+          mode = null;
+        });
+
+        // A swipe should never count as a click on "View Details" or anything else in the card.
+        content.addEventListener('click', e => {
+          if (suppressClick) {
+            e.preventDefault();
+            e.stopPropagation();
+            suppressClick = false;
+            return;
+          }
+          // Tapping an open card's face closes the tray instead of navigating.
+          if (card.classList.contains('open') && !e.target.closest('.actions-toggle')) {
+            e.preventDefault();
+            setOpen(card, false);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', e => e.preventDefault());
+
+        toggle.addEventListener('click', () => {
+          const open = !card.classList.contains('open');
+          closeOthers(card);
+          setOpen(card, open);
+          if (open) card.querySelector('.card-action').focus();
+        });
+
+        // Actions only run when a button is explicitly tapped/clicked.
+        card.querySelector('.card-actions').addEventListener('click', e => {
+          const btn = e.target.closest('.card-action');
+          if (!btn) return;
+          const name = card.dataset.drinkName;
+          const slug = card.dataset.drink;
+
+          switch (btn.dataset.action) {
+            case 'order':
+              window.location.href = '/order-online?item=' + encodeURIComponent(slug);
+              break;
+            case 'customize':
+              window.location.href = '/order-online?item=' + encodeURIComponent(slug) + '&customize=1';
+              break;
+            case 'favorite': {
+              const idx = favorites.indexOf(slug);
+              if (idx === -1) favorites.push(slug); else favorites.splice(idx, 1);
+              try { localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites)); } catch (err) { /* ignore */ }
+              syncFavorite(card);
+              status.textContent = name + (idx === -1 ? ' added to' : ' removed from') + ' your favorites.';
+              break;
+            }
+          }
+        });
+
+        card.addEventListener('keydown', e => {
+          if (e.key === 'Escape' && card.classList.contains('open')) {
+            setOpen(card, false);
+            toggle.focus();
+          }
+        });
+      });
+
+      // Tapping/clicking anywhere outside an open card closes it.
+      document.addEventListener('pointerdown', e => {
+        if (!e.target.closest('.swipe-card')) closeOthers(null);
+      });
+    })();
+  </script>
+
