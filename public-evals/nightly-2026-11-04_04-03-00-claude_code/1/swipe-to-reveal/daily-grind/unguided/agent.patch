+    /* Swipeable drink cards */
+    .swipe-card {
+      position: relative;
+      padding: 0;
+      overflow: hidden;
+      --actions-width: 216px;
+    }
+
+    .card-actions {
+      position: absolute;
+      top: 0;
+      right: 0;
+      bottom: 0;
+      width: var(--actions-width);
+      display: flex;
+      align-items: stretch;
+      background: var(--secondary);
+    }
+
+    .card-action {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 6px;
+      border: none;
+      background: none;
+      color: white;
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      cursor: pointer;
+      transition: filter 0.2s;
+    }
+
+    .card-action:hover,
+    .card-action:focus-visible {
+      filter: brightness(1.15);
+    }
+
+    .card-action:focus-visible {
+      outline: 3px solid white;
+      outline-offset: -5px;
+    }
+
+    .card-action .icon {
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .card-action.order { background: var(--primary); }
+    .card-action.customize { background: #8d6e63; }
+    .card-action.favorite { background: var(--accent); color: var(--text); }
+    .card-action.favorite[aria-pressed="true"] { background: #e65100; color: white; }
+
+    .card-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      padding: 20px;
+      background: white;
+      border-radius: inherit;
+      touch-action: pan-y;
+      user-select: none;
+      -webkit-user-select: none;
+      transition: transform 0.25s ease;
+      will-change: transform;
+    }
+
+    .swipe-card.dragging .card-content {
+      transition: none;
+      cursor: grabbing;
+    }
+
+    .swipe-card.open .card-content {
+      transform: translateX(calc(-1 * var(--actions-width)));
+      box-shadow: 4px 0 10px rgba(0, 0, 0, 0.15);
+    }
+
+    .actions-toggle {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      width: 32px;
+      height: 32px;
+      border: none;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .actions-toggle:hover,
+    .actions-toggle:focus-visible {
+      background: var(--secondary);
+    }
+
+    .swipe-hint {
+      text-align: center;
+      font-size: 0.85rem;
+      color: #795548;
+      margin-top: 4px;
+    }
+
+    .action-status {
+      text-align: center;
+      min-height: 1.6em;
+      margin-top: 12px;
+      font-size: 0.9rem;
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card-content { transition: none; }
+    }
