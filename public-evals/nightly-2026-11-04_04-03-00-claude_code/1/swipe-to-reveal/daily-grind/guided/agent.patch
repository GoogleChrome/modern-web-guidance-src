+    /* Swipe-to-reveal drink cards */
+    .SwipeReveal {
+      /* Column 1: full-width card content. Column 2: auto-sized actions. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: chain;
+      padding: 0;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel > * {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      min-inline-size: 5.5rem;
+      padding: 0 12px;
+      border: 0;
+      font: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: white;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel > *:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: -3px;
+    }
+
+    .action-order {
+      background: var(--primary);
+    }
+
+    .action-customize {
+      background: #8d6e63;
+    }
+
+    .action-save {
+      background: var(--accent);
+      color: var(--text) !important;
+    }
+
+    .action-save[aria-pressed="true"]::before {
+      content: "\2605\00a0";
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
   </style>
