+    /* ------------------------------------------------------------------
+       Reusable CSS custom functions (CSS Functions & Mixins spec).
+       Each usage below is preceded by a plain-CSS fallback declaration so
+       browsers without @function support still render correctly. Unknown
+       dashed functions are invalid at parse time, so the fallback wins.
+       NOTE: call sites must not pass var() as arguments, or unsupported
+       browsers would treat the declaration as invalid-at-computed-time and
+       discard the fallback. Defaults below reference the theme variables.
+       ------------------------------------------------------------------ */
+
+    /* Linear gradient generator: angle + start/end colors. */
+    @function --brew-gradient(--angle <angle>: 135deg,
+                              --from <color>: var(--primary),
+                              --to <color>: var(--accent)) {
+      result: linear-gradient(var(--angle), var(--from), var(--to));
+    }
+
+    /* N equal-width columns; minmax(0, 1fr) prevents content blowout. */
+    @function --equal-columns(--count <integer>: 1) {
+      result: repeat(var(--count), minmax(0, 1fr));
+    }
+
+    /* Single column on small screens, N equal columns on wider ones. */
+    @function --responsive-columns(--wide <integer>: 2) {
+      result: --equal-columns(1);
+      @media (min-width: 768px) {
+        result: --equal-columns(var(--wide));
+      }
+    }
+
