       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    /* Hero content sits above the decorative shape */
+    .hero {
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+    }
+
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative organic "coffee splash" block.
+       Absolutely positioned, so it never affects the hero's flex layout.
+       Layered fallbacks:
+         1. Background: warm gradient always paints even if the photo fails.
+         2. Shape: an organic border-radius blob is the baseline, so it still
+            looks hand-made if the SVG clip-path is unsupported or missing.
+         3. The SVG clip-path then refines it into a splash with droplets. */
+    .shaped-element {
+      position: absolute;
+      z-index: 0;
+      right: -4%;
+      bottom: -10%;
+      width: clamp(180px, 34vw, 460px);
+      aspect-ratio: 1 / 1;
+      pointer-events: none;
+      opacity: 0.85;
+      background-color: var(--primary);
+      background-image:
+        linear-gradient(135deg, rgba(255, 171, 64, 0.35), rgba(78, 52, 46, 0.25)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80'),
+        radial-gradient(circle at 30% 30%, var(--accent), var(--primary) 70%);
+      background-size: cover;
+      background-position: center;
+      /* Baseline organic blob; the splash path below is drawn to sit inside it,
+         so the two can coexist and no @supports switch is needed. */
+      border-radius: 52% 48% 50% 50% / 48% 52% 50% 50%;
+      clip-path: url(#coffee-splash);
+      transform: rotate(-8deg);
+    }
+
+    @media (max-width: 600px) {
+      .shaped-element {
+        opacity: 0.45;
+        right: -20%;
+        bottom: -15%;
+      }
+    }
+
