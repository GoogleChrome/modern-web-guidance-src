diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..afb2417
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,300 @@
+/**
+ * <star-rating> — a form-associated star rating control.
+ *
+ * Participates natively in forms via ElementInternals:
+ *   - submits its value under its `name` (no hidden input)
+ *   - `required` constraint validation (valueMissing), blocks submission
+ *   - form reset returns to the `value` attribute (its default value)
+ *   - disabled by its own `disabled` attribute or an ancestor <fieldset disabled>
+ *   - restores its value on back/forward navigation and autofill
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled
+ * Events: `input` (while choosing) and `change` (on commit), dispatched from the host.
+ */
+
+const STAR_PATH =
+  'M12 2.5l2.9 6.06 6.6.8-4.87 4.6 1.24 6.54L12 17.3l-5.87 3.2 1.24-6.54L2.5 9.36l6.6-.8z';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: inline-block;
+    --star-size: 2.25rem;
+    --star-empty: #c9bcb6;
+    --star-filled: #ffab40;
+    --star-hover: #ffc677;
+    --star-outline: #4e342e;
+  }
+  :host([hidden]) { display: none; }
+
+  .stars {
+    display: inline-flex;
+    gap: 0.25rem;
+  }
+
+  label {
+    position: relative;
+    display: grid;
+    place-items: center;
+    /* 48px minimum tap target */
+    min-inline-size: 48px;
+    min-block-size: 48px;
+    color: var(--star-empty);
+    cursor: pointer;
+    transition: color 0.15s, transform 0.15s;
+  }
+  label.filled { color: var(--star-filled); }
+
+  /* Hover preview: fill up to the hovered star (only when interactive). */
+  :host(:not(:disabled)) .stars:hover label { color: var(--star-hover); }
+  :host(:not(:disabled)) .stars:hover label:hover ~ label { color: var(--star-empty); }
+  :host(:not(:disabled)) label:hover { transform: scale(1.1); }
+
+  svg {
+    inline-size: var(--star-size);
+    block-size: var(--star-size);
+    fill: currentColor;
+    stroke: var(--star-outline);
+    stroke-width: 1;
+    stroke-linejoin: round;
+    border-radius: 6px;
+  }
+
+  input {
+    /* Visually hidden but still focusable and exposed to assistive tech. */
+    position: absolute;
+    clip-path: inset(50%);
+    overflow: hidden;
+    inline-size: 1px;
+    block-size: 1px;
+    margin: -1px;
+    padding: 0;
+    border: 0;
+    white-space: nowrap;
+    appearance: none;
+  }
+
+  input:focus-visible + svg {
+    outline: 3px solid var(--star-outline);
+    outline-offset: 2px;
+  }
+
+  .vh {
+    position: absolute;
+    clip-path: inset(50%);
+    overflow: hidden;
+    inline-size: 1px;
+    block-size: 1px;
+    white-space: nowrap;
+  }
+
+  :host(:disabled) label { cursor: not-allowed; }
+  :host(:disabled) .stars { opacity: 0.45; }
+
+  @media (prefers-reduced-motion: reduce) {
+    label { transition: none; }
+    :host(:not(:disabled)) label:hover { transform: none; }
+  }
+
+  @media (forced-colors: active) {
+    label, label.filled { color: CanvasText; }
+    label:not(.filled) svg { fill: Canvas; }
+    svg { stroke: CanvasText; }
+  }
+`);
+
+export class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['max', 'value', 'required'];
+
+  #internals;
+  #stars;
+  #radios = [];
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    // The host groups the inner radios; its accessible name comes from the
+    // consumer (<label for>, aria-labelledby, …), so we don't set one here.
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.adoptedStyleSheets = [sheet];
+    this.#stars = document.createElement('div');
+    this.#stars.className = 'stars';
+    this.#stars.part = 'stars';
+    root.append(this.#stars);
+
+    // Native radio `input` events are composed and already reach the host
+    // (retargeted), so just sync our value before light-DOM listeners run.
+    root.addEventListener('input', (e) => {
+      this.#dirty = true;
+      this.#setValue(e.target.value);
+    });
+    // `change` is not composed, so re-dispatch it from the host.
+    root.addEventListener('change', (e) => {
+      e.stopPropagation();
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+  }
+
+  connectedCallback() {
+    this.#render();
+    this.#validate();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    switch (name) {
+      case 'max':
+        if (this.#radios.length) this.#render();
+        break;
+      case 'value':
+        // Like native inputs: the attribute is the default value and only
+        // drives the current value until the user interacts.
+        if (!this.#dirty) this.#setValue(newValue ?? '');
+        break;
+      case 'required':
+        this.#validate();
+        break;
+    }
+  }
+
+  // ---- Public API (mirrors native form controls) ----
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get valueAsNumber() { return this.#value === '' ? NaN : Number(this.#value); }
+
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n > 0 ? Math.min(n, 10) : 5;
+  }
+  set max(n) { this.setAttribute('max', n); }
+
+  get name() { return this.getAttribute('name'); }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get type() { return this.localName; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  // ---- Form-associated lifecycle ----
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable the inner controls only. Never toggle `disabled` on the host
+    // here, or re-enabling an ancestor <fieldset> would leave it stuck.
+    this.#disabled = disabled;
+    for (const radio of this.#radios) radio.disabled = disabled;
+  }
+
+  formStateRestoreCallback(state) {
+    // Covers both back/forward restore and autofill (mode argument).
+    this.#dirty = true;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  // ---- Internals ----
+
+  #setValue(raw) {
+    const n = parseInt(raw, 10);
+    const v = Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+    this.#value = v;
+    // Second argument is the state the browser saves for restoration.
+    this.#internals.setFormValue(v || null, v);
+    this.#syncView();
+    this.#validate();
+  }
+
+  #render() {
+    const max = this.max;
+    if (this.#radios.length === max) return;
+
+    const groupName = 'star';
+    const frag = document.createDocumentFragment();
+    this.#radios = [];
+
+    for (let i = 1; i <= max; i++) {
+      const label = document.createElement('label');
+      label.part = 'star';
+
+      const radio = document.createElement('input');
+      radio.type = 'radio';
+      radio.name = groupName; // scoped to this shadow root
+      radio.value = String(i);
+      radio.disabled = this.#disabled;
+
+      const svgNS = 'http://www.w3.org/2000/svg';
+      const svg = document.createElementNS(svgNS, 'svg');
+      svg.setAttribute('viewBox', '0 0 24 24');
+      svg.setAttribute('aria-hidden', 'true');
+      const path = document.createElementNS(svgNS, 'path');
+      path.setAttribute('d', STAR_PATH);
+      svg.append(path);
+
+      const text = document.createElement('span');
+      text.className = 'vh';
+      text.textContent = `${i} ${i === 1 ? 'star' : 'stars'}`;
+
+      label.append(radio, svg, text);
+      frag.append(label);
+      this.#radios.push(radio);
+    }
+
+    this.#stars.replaceChildren(frag);
+    // Clamp any value that no longer fits the new max.
+    if (this.#value && Number(this.#value) > max) this.#setValue('');
+    this.#syncView();
+  }
+
+  #syncView() {
+    const current = Number(this.#value) || 0;
+    for (const radio of this.#radios) {
+      const n = Number(radio.value);
+      radio.checked = n === current;
+      radio.parentElement.classList.toggle('filled', n <= current);
+    }
+  }
+
+  #validate() {
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        this.#radios[0], // focused when the browser reports the error
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+}
+
+if (!customElements.get('star-rating')) {
+  customElements.define('star-rating', StarRating);
+}
