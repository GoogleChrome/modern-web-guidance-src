+  <script type="module" src="/star-rating.js"></script>
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const skip = document.getElementById('skip-rating');
+    const ratingFieldset = document.getElementById('rating-fieldset');
+    const taste = document.getElementById('taste-rating');
+    const tasteError = document.getElementById('taste-error');
+    const status = document.getElementById('feedback-status');
+
+    // A disabled fieldset bars its controls (including <star-rating>) from
+    // submission and constraint validation, natively.
+    const syncSkip = () => {
+      ratingFieldset.disabled = skip.checked;
+      if (skip.checked) tasteError.textContent = '';
+    };
+    skip.addEventListener('change', syncSkip);
+    syncSkip(); // honour a checkbox state restored on back/forward navigation
+
+    // Show an inline error only after a submit attempt, clear it on correction.
+    taste.addEventListener('invalid', () => {
+      tasteError.textContent = taste.validationMessage;
+    });
+    taste.addEventListener('change', () => {
+      if (taste.validity.valid) tasteError.textContent = '';
+    });
+
+    // The reset event fires before controls are reset; resync afterwards.
+    form.addEventListener('reset', () => {
+      status.textContent = '';
+      tasteError.textContent = '';
+      setTimeout(syncSkip);
+    });
+
+    form.addEventListener('submit', (event) => {
+      // No backend yet: handle the submission client-side.
+      event.preventDefault();
+      const data = new FormData(form);
+      const parts = [];
+      if (data.has('taste')) parts.push(`taste ${data.get('taste')}/5`);
+      if (data.has('presentation')) parts.push(`presentation ${data.get('presentation')}/5`);
+      status.textContent = parts.length
+        ? `Thanks! We recorded your rating (${parts.join(', ')}).`
+        : 'Thanks! Your comment has been sent to our baristas.';
+      const message = status.textContent;
+      form.reset();
+      setTimeout(() => { status.textContent = message; });
+    });
+  </script>
+
