+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const inStore = document.getElementById('in-store');
+    const serviceFieldset = document.getElementById('service-fieldset');
+    const result = document.getElementById('feedback-result');
+
+    // The "Your visit" fieldset is only enabled for in-store visitors. While
+    // disabled, its ratings are barred from validation and omitted from submission.
+    const syncVisitFieldset = () => { serviceFieldset.disabled = !inStore.checked; };
+    inStore.addEventListener('change', syncVisitFieldset);
+    // Re-sync after the browser restores form state (back/forward, reload).
+    addEventListener('pageshow', syncVisitFieldset);
+    syncVisitFieldset();
+
+    // The reset event fires before controls are reset, so sync afterwards.
+    form.addEventListener('reset', () => setTimeout(() => {
+      syncVisitFieldset();
+      result.replaceChildren();
+    }));
+
+    form.addEventListener('submit', (event) => {
+      // There is no feedback backend on this static site yet, so show what
+      // would be sent. Remove this handler to post to the form's action.
+      event.preventDefault();
+      const data = new FormData(form);
+      const stars = (n) => n ? `${'★'.repeat(n)}${'☆'.repeat(5 - n)}` : 'not rated';
+
+      const box = document.createElement('div');
+      box.className = 'thanks';
+      const heading = document.createElement('strong');
+      heading.textContent = `Thanks for your feedback on the ${data.get('drink')}!`;
+      const list = document.createElement('ul');
+      list.style.margin = '6px 0 0 18px';
+      for (const key of ['taste', 'aroma', 'service', 'ambience']) {
+        // Ratings in the disabled "Your visit" fieldset aren't submitted.
+        if (['service', 'ambience'].includes(key) && !data.has('in_store')) continue;
+        const li = document.createElement('li');
+        li.textContent = `${key[0].toUpperCase()}${key.slice(1)}: ${stars(Number(data.get(key)))}`;
+        list.append(li);
+      }
+      box.append(heading, list);
+
+      form.reset();
+      // Show the summary after the reset handler clears the previous one.
+      setTimeout(() => result.replaceChildren(box));
+    });
+  </script>
