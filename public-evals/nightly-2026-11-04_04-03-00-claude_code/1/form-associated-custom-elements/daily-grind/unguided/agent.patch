diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..c04bf42
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,354 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Behaves like a native form control:
+ *   - Submits `name=value` with its form (nothing when no rating is chosen).
+ *   - Supports `required` constraint validation (valueMissing), :invalid/:valid,
+ *     checkValidity()/reportValidity() and the browser's validation bubble.
+ *   - Restores its `value` attribute (the default value) on form reset.
+ *   - Disables itself via its own `disabled` attribute or an ancestor
+ *     <fieldset disabled>; disabled ratings are skipped by validation and submission.
+ *   - Participates in browser state restoration (back/forward, session restore).
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled, readonly
+ * Custom states: :state(touched) — set once the user has interacted.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      gap: 0.15em;
+      font-size: 2rem;
+      line-height: 1;
+      outline: none;
+      -webkit-tap-highlight-color: transparent;
+    }
+    :host([hidden]) { display: none; }
+
+    .star {
+      cursor: pointer;
+      color: var(--star-empty, #d7ccc8);
+      transition: color 0.15s, transform 0.15s;
+      border-radius: 4px;
+      padding: 0 0.05em;
+      user-select: none;
+    }
+    .star.filled { color: var(--star-filled, #ffab40); }
+    .star.preview { color: var(--star-preview, #ffcc80); }
+    .star:hover { transform: scale(1.12); }
+    .star:focus-visible {
+      outline: 2px solid var(--star-focus, #4e342e);
+      outline-offset: 2px;
+    }
+
+    .stars.disabled .star {
+      cursor: not-allowed;
+      opacity: 0.45;
+      transform: none;
+    }
+    .stars.readonly .star {
+      cursor: default;
+      transform: none;
+    }
+  </style>
+  <div part="stars" class="stars"></div>
+`;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'max', 'required', 'disabled', 'readonly'];
+
+  #internals;
+  #container;
+  #value = '';
+  #dirty = false; // true once the value diverges from the `value` attribute
+  #disabled = false; // tracks formDisabledCallback (own attr OR fieldset)
+  #preview = 0;
+  #customError = '';
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#container = root.querySelector('.stars');
+
+    this.#container.addEventListener('click', (e) => this.#onClick(e));
+    this.#container.addEventListener('keydown', (e) => this.#onKeyDown(e));
+    this.#container.addEventListener('pointerover', (e) => this.#onPointerOver(e));
+    this.#container.addEventListener('pointerleave', () => this.#setPreview(0));
+    this.#container.addEventListener('focusout', () => this.#markTouched());
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#sanitize(this.getAttribute('value'));
+    this.#renderStars();
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    switch (name) {
+      case 'value':
+        // Like <input>, the attribute is the default value; it only drives the
+        // current value until the user (or script) has changed it.
+        if (!this.#dirty) this.#value = this.#sanitize(newValue);
+        break;
+      case 'max':
+        this.#renderStars();
+        this.#value = this.#sanitize(this.#value);
+        break;
+    }
+    this.#sync();
+  }
+
+  /* ---------- Form lifecycle callbacks ---------- */
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#sanitize(this.getAttribute('value'));
+    this.#setState('touched', false);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    this.#setPreview(0);
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state, mode) {
+    // `state` is whatever we passed as the second argument to setFormValue().
+    if (typeof state !== 'string') return;
+    this.#dirty = true;
+    this.#value = this.#sanitize(state);
+    if (mode === 'restore') this.#setState('touched', true);
+    this.#sync();
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#value = this.#sanitize(v == null ? '' : String(v));
+    this.#sync();
+  }
+
+  get valueAsNumber() { return this.#value === '' ? NaN : Number(this.#value); }
+  set valueAsNumber(n) { this.value = Number.isFinite(n) ? String(n) : ''; }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n > 0 && n <= 10 ? n : 5;
+  }
+  set max(n) { this.setAttribute('max', String(n)); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get readOnly() { return this.hasAttribute('readonly'); }
+  set readOnly(v) { this.toggleAttribute('readonly', Boolean(v)); }
+
+  get type() { return this.localName; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  setCustomValidity(message) {
+    this.#customError = String(message ?? '');
+    this.#updateValidity();
+  }
+
+  /* ---------- Internals ---------- */
+
+  #sanitize(raw) {
+    if (raw == null || raw === '') return '';
+    const n = Number(raw);
+    if (!Number.isInteger(n) || n < 1) return '';
+    return String(Math.min(n, this.max));
+  }
+
+  get #interactive() {
+    return !this.#disabled && !this.readOnly;
+  }
+
+  #renderStars() {
+    const max = this.max;
+    if (this.#container.childElementCount === max) return;
+    this.#container.replaceChildren();
+    for (let i = 1; i <= max; i++) {
+      const star = document.createElement('span');
+      star.className = 'star';
+      star.part = 'star';
+      star.dataset.value = String(i);
+      star.setAttribute('role', 'radio');
+      star.setAttribute('aria-label', `${i} star${i === 1 ? '' : 's'}`);
+      star.textContent = '★';
+      this.#container.append(star);
+    }
+  }
+
+  #sync() {
+    if (!this.#container) return;
+    const current = Number(this.#value) || 0;
+    const interactive = this.#interactive;
+    const stars = this.#container.children;
+    // Roving tabindex: the checked star, or the first star when unrated.
+    const tabbable = current || 1;
+
+    for (const star of stars) {
+      const v = Number(star.dataset.value);
+      star.classList.toggle('filled', v <= current && !this.#preview);
+      star.classList.toggle('preview', this.#preview > 0 && v <= this.#preview);
+      star.setAttribute('aria-checked', String(v === current));
+      star.setAttribute('aria-disabled', String(this.#disabled));
+      star.tabIndex = this.#disabled ? -1 : v === tabbable ? 0 : -1;
+    }
+
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(this.#disabled);
+    this.#internals.ariaReadOnly = String(this.readOnly);
+    this.#container.classList.toggle('disabled', this.#disabled);
+    this.#container.classList.toggle('readonly', this.readOnly);
+    this.#setState('disabled', this.#disabled);
+    this.#setState('readonly', this.readOnly);
+    this.#setState('rated', current > 0);
+
+    // Submission value is null (omitted) when unrated, just like an
+    // unchecked radio group. The state string is used for restoration.
+    this.#internals.setFormValue(this.#value === '' ? null : this.#value, this.#value);
+    this.#updateValidity();
+  }
+
+  #updateValidity() {
+    const anchor = this.#container?.querySelector('[tabindex="0"]') ?? undefined;
+    if (this.required && this.#value === '') {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        this.getAttribute('data-required-message') || 'Please select a rating.',
+        anchor
+      );
+    } else if (this.#customError) {
+      this.#internals.setValidity({ customError: true }, this.#customError, anchor);
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #setState(state, on) {
+    const states = this.#internals.states;
+    if (!states) return;
+    try {
+      on ? states.add(state) : states.delete(state);
+    } catch {
+      // Older Chromium only accepted the legacy `--state` syntax.
+      try { on ? states.add(`--${state}`) : states.delete(`--${state}`); } catch { /* unsupported */ }
+    }
+  }
+
+  #markTouched() {
+    this.#setState('touched', true);
+  }
+
+  #commit(newValue) {
+    const sanitized = this.#sanitize(String(newValue));
+    if (sanitized === this.#value) return;
+    this.#dirty = true;
+    this.#value = sanitized;
+    this.#markTouched();
+    this.#sync();
+    this.#container.querySelector('[tabindex="0"]')?.focus();
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #setPreview(n) {
+    if (this.#preview === n) return;
+    this.#preview = n;
+    this.#sync();
+  }
+
+  #onPointerOver(e) {
+    if (!this.#interactive || e.pointerType === 'touch') return;
+    const star = e.target.closest('.star');
+    if (star) this.#setPreview(Number(star.dataset.value));
+  }
+
+  #onClick(e) {
+    if (!this.#interactive) return;
+    const star = e.target.closest('.star');
+    if (!star) return;
+    const v = Number(star.dataset.value);
+    // Clicking the current rating clears it (only when a rating isn't required).
+    if (String(v) === this.#value && !this.required) this.#commit('');
+    else this.#commit(v);
+  }
+
+  #onKeyDown(e) {
+    if (!this.#interactive) return;
+    const current = Number(this.#value) || 0;
+    let next;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = Math.min(current + 1, this.max);
+        break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = Math.max(current - 1, 1);
+        break;
+      case 'Home':
+        next = 1;
+        break;
+      case 'End':
+        next = this.max;
+        break;
+      case ' ':
+      case 'Enter': {
+        const focused = this.shadowRoot.activeElement;
+        if (e.key === 'Enter' && this.#value !== '') {
+          // Let Enter submit the form, as in native controls.
+          this.form?.requestSubmit();
+          e.preventDefault();
+          return;
+        }
+        next = focused ? Number(focused.dataset.value) : 1;
+        break;
+      }
+      case 'Backspace':
+      case 'Delete':
+        if (this.required) return;
+        next = '';
+        break;
+      default:
+        if (/^[1-9]$/.test(e.key) && Number(e.key) <= this.max) next = Number(e.key);
+        else return;
+    }
+    e.preventDefault();
+    this.#commit(next);
+  }
+}
+
+if (!customElements.get('star-rating')) {
+  customElements.define('star-rating', StarRating);
+}
+
+export { StarRating };
