+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const origins = scroller.querySelectorAll('.origin');
+      let isScrolling = false;
+
+      // Lightweight: no layout reads, and the DOM is only written once per scroll gesture.
+      scroller.addEventListener('scroll', () => {
+        if (isScrolling) return;
+        isScrolling = true;
+        status.textContent = 'Scrolling...';
+      }, { passive: true });
+
+      // Heavier work (layout reads) deferred until scrolling has fully settled.
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        const view = scroller.getBoundingClientRect();
+        let best = null;
+        let bestVisible = -1;
+        for (const el of origins) {
+          const r = el.getBoundingClientRect();
+          const visible = Math.min(r.bottom, view.bottom) - Math.max(r.top, view.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = el;
+          }
+        }
+        status.textContent = `Scroll ended. Visible: ${best ? best.dataset.origin : 'None'}`;
+      });
+
+      // Fallback for browsers without native scrollend support.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 100);
+        }, { passive: true });
+      }
+    })();
+  </script>
+
