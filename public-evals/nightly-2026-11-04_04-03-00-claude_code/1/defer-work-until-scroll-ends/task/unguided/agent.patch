+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var origins = scroller.querySelectorAll('.origin');
+      var isScrolling = false;
+      var fallbackTimer = 0;
+      var supportsScrollEnd = 'onscrollend' in window;
+
+      // Runs once, after scrolling stops: find the origin with the most visible area.
+      function onScrollEnd() {
+        clearTimeout(fallbackTimer);
+        if (!isScrolling) return;
+        isScrolling = false;
+
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestVisible = -1;
+        for (var i = 0; i < origins.length; i++) {
+          var r = origins[i].getBoundingClientRect();
+          var visible = Math.max(0, Math.min(r.right, box.right) - Math.max(r.left, box.left)) *
+            Math.max(0, Math.min(r.bottom, box.bottom) - Math.max(r.top, box.top));
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = origins[i];
+          }
+        }
+
+        status.classList.remove('is-scrolling');
+        status.textContent = 'Scroll ended. Visible: ' + (best ? best.dataset.origin : 'None');
+      }
+
+      // Hot path: no layout reads, and the DOM is only touched on the first event of a gesture.
+      function onScroll() {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.classList.add('is-scrolling');
+          status.textContent = 'Scrolling...';
+        }
+        if (!supportsScrollEnd) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = setTimeout(onScrollEnd, 150);
+        }
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      if (supportsScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
+
