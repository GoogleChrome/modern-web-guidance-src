+  <script>
+    (function () {
+      var root = document.documentElement;
+      var toggle = document.getElementById('theme-toggle');
+      var icon = toggle.querySelector('.theme-toggle-icon');
+      var label = toggle.querySelector('.theme-toggle-text');
+      var systemDark = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function currentTheme() {
+        var explicit = root.getAttribute('data-theme');
+        if (explicit === 'light' || explicit === 'dark') return explicit;
+        return systemDark.matches ? 'dark' : 'light';
+      }
+
+      function render() {
+        var isDark = currentTheme() === 'dark';
+        toggle.setAttribute('aria-pressed', String(isDark));
+        toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
+        // Show the theme the button will switch to
+        icon.innerHTML = isDark ? '&#9728;' : '&#9790;';
+        label.textContent = isDark ? 'Light' : 'Dark';
+      }
+
+      toggle.addEventListener('click', function () {
+        var next = currentTheme() === 'dark' ? 'light' : 'dark';
+        root.setAttribute('data-theme', next);
+        try { localStorage.setItem('theme', next); } catch (e) { }
+        render();
+      });
+
+      // Keep the button label in sync if the OS theme changes while no override is set
+      if (systemDark.addEventListener) {
+        systemDark.addEventListener('change', render);
+      } else if (systemDark.addListener) {
+        systemDark.addListener(render);
+      }
+
+      render();
+    })();
+  </script>
+
