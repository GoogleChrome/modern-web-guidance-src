+  <script>
+    (() => {
+      const KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const getStored = () => {
+        try { return localStorage.getItem(KEY); } catch (e) { return null; }
+      };
+      const setStored = (value) => {
+        try {
+          value ? localStorage.setItem(KEY, value) : localStorage.removeItem(KEY);
+        } catch (e) { /* storage unavailable: still apply theme for this page */ }
+      };
+      const apply = (value) => { meta.content = value ?? "light dark"; };
+
+      document.getElementById("theme-toggle").addEventListener("click", () => {
+        const system = systemDark.matches ? "dark" : "light";
+        const current = meta.content === "light" || meta.content === "dark" ? meta.content : system;
+        const target = current === "dark" ? "light" : "dark";
+        // Matching the system preference means "undo my override": go back to following the system.
+        const override = target === system ? null : target;
+        setStored(override);
+        apply(override);
+      });
+
+      // Keep multiple open tabs in sync.
+      addEventListener("storage", (e) => {
+        if (e.key === KEY || e.key === null) apply(getStored());
+      });
+    })();
+  </script>
+
