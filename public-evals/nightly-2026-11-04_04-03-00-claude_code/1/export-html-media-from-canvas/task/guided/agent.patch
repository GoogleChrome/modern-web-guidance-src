+  <script type="module">
+    const canvas = document.getElementById('gift_canvas');
+    const card = document.getElementById('export_element');
+    const form = document.getElementById('gift_form');
+    const nameInput = document.getElementById('gift_name');
+    const messageInput = document.getElementById('gift_message');
+    const nameOut = document.getElementById('gc_name');
+    const messageOut = document.getElementById('gc_message');
+    const exportBtn = document.getElementById('gift_export');
+    const status = document.getElementById('gift_status');
+
+    // Feature detection for the HTML-in-Canvas API.
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+    let ctx = null;
+
+    if (supportsHtmlInCanvas) {
+      ctx = canvas.getContext('2d');
+
+      // Draw the drawable card into the canvas whenever the browser paints it.
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+      };
+
+      // Keep the canvas grid at device-pixel resolution (crisp output) and the
+      // card laid out at exactly the canvas's CSS size.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        card.style.width = `${entry.contentRect.width}px`;
+        card.style.height = `${entry.contentRect.height}px`;
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+    } else {
+      // Fallback: canvas children aren't rendered without HTML-in-Canvas, so
+      // show the card as regular HTML in place of the canvas.
+      canvas.replaceWith(card);
+    }
+
+    // Live-update the card from the form (textContent: user input is never parsed as HTML).
+    function updateText() {
+      nameOut.textContent = nameInput.value.trim() || 'Someone Special';
+      messageOut.textContent = messageInput.value.trim();
+      if (supportsHtmlInCanvas) canvas.requestPaint();
+    }
+
+    function updateColor() {
+      const selected = form.querySelector('input[name="color"]:checked');
+      card.style.setProperty('--card-bg', selected.value);
+      card.style.setProperty('--card-ink', selected.dataset.ink);
+      if (supportsHtmlInCanvas) canvas.requestPaint();
+    }
+
+    nameInput.addEventListener('input', updateText);
+    messageInput.addEventListener('input', updateText);
+    form.addEventListener('change', (e) => {
+      if (e.target.name === 'color') updateColor();
+    });
+    updateText();
+    updateColor();
+
+    // Resolve after the next paint event, once onpaint has drawn the latest card.
+    function nextPaint() {
+      return new Promise((resolve) => {
+        canvas.addEventListener('paint', resolve, { once: true });
+        canvas.requestPaint();
+      });
+    }
+
+    async function renderCardCanvas() {
+      if (supportsHtmlInCanvas) {
+        await nextPaint();
+        return canvas;
+      }
+      // Fallback for browsers without HTML-in-Canvas: rasterize the DOM with html2canvas.
+      const { default: html2canvas } = await import('https://esm.sh/html2canvas@1.4.1');
+      return html2canvas(card, { backgroundColor: null, scale: window.devicePixelRatio || 1 });
+    }
+
+    function downloadCanvas(source, filename) {
+      return new Promise((resolve, reject) => {
+        source.toBlob((blob) => {
+          if (!blob) return reject(new Error('Could not encode image'));
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = filename;
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url), 0);
+          resolve();
+        }, 'image/png');
+      });
+    }
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      exportBtn.disabled = true;
+      status.textContent = 'Preparing your card…';
+      try {
+        const source = await renderCardCanvas();
+        const slug = nameOut.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'gift';
+        await downloadCanvas(source, `daily-grind-gift-card-${slug}.png`);
+        status.textContent = 'Your gift card has been downloaded.';
+      } catch (err) {
+        console.error(err);
+        status.textContent = 'Sorry, image export isn’t supported in this browser.';
+      } finally {
+        exportBtn.disabled = false;
+      }
+    });
+  </script>
+
