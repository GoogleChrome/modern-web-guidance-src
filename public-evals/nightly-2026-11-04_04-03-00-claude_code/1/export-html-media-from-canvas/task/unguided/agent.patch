+  <script>
+    (() => {
+      const canvas = document.getElementById('gift-canvas');
+      const card = document.getElementById('export_element');
+      const stage = document.getElementById('card-stage');
+      const form = document.getElementById('gift-form');
+      const nameInput = document.getElementById('gift-name');
+      const messageInput = document.getElementById('gift-message');
+      const messageCount = document.getElementById('gift-message-count');
+      const nameOut = document.getElementById('card-name');
+      const messageOut = document.getElementById('card-message');
+      const exportBtn = document.getElementById('gift-export');
+      const status = document.getElementById('export-status');
+
+      const DEFAULT_NAME = 'A Coffee Lover';
+      const DEFAULT_MESSAGE = 'Enjoy a cup on me!';
+      const MIN_EXPORT_SCALE = 2; // export at >= 2x for crisp images
+
+      const ctx = canvas.getContext('2d');
+
+      // Feature detection for the HTML-in-Canvas API
+      // (canvas[layoutsubtree] + ctx.drawElementImage + canvas paint event).
+      const supportsHTMLInCanvas =
+        !!ctx &&
+        typeof ctx.drawElementImage === 'function' &&
+        'onpaint' in HTMLCanvasElement.prototype;
+
+      const requestPaint = () => {
+        if (typeof canvas.requestPaint === 'function') canvas.requestPaint();
+      };
+
+      // ---- Card content updates (textContent only: user input is never parsed as HTML) ----
+      function updateCard() {
+        nameOut.textContent = nameInput.value.trim() || DEFAULT_NAME;
+        messageOut.textContent = messageInput.value.trim() || DEFAULT_MESSAGE;
+        messageCount.textContent = `${messageInput.value.length} / ${messageInput.maxLength}`;
+
+        const selected = form.querySelector('input[name="gift-bg"]:checked');
+        card.style.setProperty('--card-bg', selected.value);
+        card.style.setProperty('--card-fg', selected.dataset.fg);
+
+        // Child rendering changes trigger a paint event automatically;
+        // requesting one explicitly keeps us in sync if the UA batches.
+        requestPaint();
+      }
+
+      nameInput.addEventListener('input', updateCard);
+      messageInput.addEventListener('input', updateCard);
+      form.addEventListener('change', updateCard);
+
+      // ---- HTML-in-Canvas rendering path ----
+      let paintWaiters = [];
+
+      function waitForPaint(timeout = 1000) {
+        return new Promise((resolve) => {
+          const timer = setTimeout(() => {
+            paintWaiters = paintWaiters.filter((w) => w !== done);
+            resolve();
+          }, timeout);
+          const done = () => { clearTimeout(timer); resolve(); };
+          paintWaiters.push(done);
+          requestPaint();
+        });
+      }
+
+      function setupHTMLInCanvas() {
+        // Keep the canvas backing store matched to its rendered size so the
+        // drawn element is pixel-perfect (and at least 2x for export).
+        const resize = (cssW, cssH, devW, devH) => {
+          const scale = Math.max(devW / cssW || 1, MIN_EXPORT_SCALE);
+          const w = Math.round(Math.max(devW, cssW * scale));
+          const h = Math.round(Math.max(devH, cssH * scale));
+          if (canvas.width !== w || canvas.height !== h) {
+            canvas.width = w; // resizing clears the canvas...
+            canvas.height = h;
+            requestPaint(); // ...so repaint
+          }
+        };
+
+        const ro = new ResizeObserver(([entry]) => {
+          const css = entry.contentBoxSize?.[0];
+          const dev = entry.devicePixelContentBoxSize?.[0];
+          const cssW = css ? css.inlineSize : entry.contentRect.width;
+          const cssH = css ? css.blockSize : entry.contentRect.height;
+          if (!cssW || !cssH) return;
+          const dpr = window.devicePixelRatio || 1;
+          resize(cssW, cssH, dev ? dev.inlineSize : cssW * dpr, dev ? dev.blockSize : cssH * dpr);
+        });
+        try {
+          ro.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch {
+          ro.observe(canvas); // device-pixel-content-box unsupported
+        }
+
+        // Draw inside the paint event: it fires after layout/style of the
+        // canvas children is up to date, right before the canvas is presented.
+        canvas.addEventListener('paint', () => {
+          ctx.reset();
+          const transform = ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+          // Keep the element's hit-testing / a11y box aligned with where it was drawn.
+          if (transform) card.style.transform = transform.toString();
+
+          const waiters = paintWaiters;
+          paintWaiters = [];
+          waiters.forEach((fn) => fn());
+        });
+
+        requestPaint();
+      }
+
+      // ---- Fallback path: show the card as normal HTML, rasterize with 2D API on export ----
+      function setupFallback() {
+        // Canvas children are fallback content and wouldn't render, so move the card out.
+        stage.classList.add('is-fallback');
+        stage.appendChild(card);
+        canvas.remove();
+      }
+
+      function wrapLines(c, text, maxWidth, maxLines) {
+        const words = text.split(/\s+/).filter(Boolean);
+        const lines = [];
+        let line = '';
+        const pushBroken = (word) => {
+          // Break overly long words character-by-character
+          let chunk = '';
+          for (const ch of word) {
+            if (c.measureText(chunk + ch).width > maxWidth && chunk) { lines.push(chunk); chunk = ch; }
+            else chunk += ch;
+          }
+          return chunk;
+        };
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (c.measureText(test).width <= maxWidth) { line = test; continue; }
+          if (line) lines.push(line);
+          line = c.measureText(word).width > maxWidth ? pushBroken(word) : word;
+        }
+        if (line) lines.push(line);
+        if (lines.length > maxLines) {
+          lines.length = maxLines;
+          let last = lines[maxLines - 1];
+          while (last && c.measureText(`${last}…`).width > maxWidth) last = last.slice(0, -1);
+          lines[maxLines - 1] = `${last}…`;
+        }
+        return lines;
+      }
+
+      async function renderFallbackCanvas() {
+        await document.fonts?.ready;
+        const rect = card.getBoundingClientRect();
+        const W = rect.width, H = rect.height;
+        const scale = Math.max(window.devicePixelRatio || 1, MIN_EXPORT_SCALE);
+        const out = document.createElement('canvas');
+        out.width = Math.round(W * scale);
+        out.height = Math.round(H * scale);
+        const c = out.getContext('2d');
+        c.scale(scale, scale);
+
+        const styles = getComputedStyle(card);
+        const bg = styles.getPropertyValue('--card-bg').trim();
+        const fg = styles.getPropertyValue('--card-fg').trim();
+        const font = styles.fontFamily;
+        const pad = 27;
+
+        // Card shape + background
+        c.beginPath();
+        c.roundRect(0, 0, W, H, 16);
+        c.clip();
+        c.fillStyle = bg;
+        c.fillRect(0, 0, W, H);
+        c.fillStyle = 'rgba(255,255,255,0.18)';
+        c.beginPath(); c.arc(W * 0.88, H * 0.18, 70, 0, Math.PI * 2); c.fill();
+        c.fillStyle = 'rgba(255,171,64,0.35)';
+        c.beginPath(); c.arc(W, H, 110, 0, Math.PI * 2); c.fill();
+
+        // Header
+        c.fillStyle = fg;
+        c.textBaseline = 'top';
+        c.font = `bold 15px ${font}`;
+        c.letterSpacing = '2px';
+        c.fillText('THE DAILY GRIND', pad, pad);
+        c.globalAlpha = 0.85;
+        c.font = `11px ${font}`;
+        c.letterSpacing = '3px';
+        c.fillText('GIFT CARD', pad, pad + 22);
+        c.globalAlpha = 1;
+        c.letterSpacing = '0px';
+        c.font = `35px ${font}`;
+        c.textAlign = 'right';
+        c.fillText('☕', W - pad, pad - 4);
+        c.textAlign = 'left';
+
+        // Body, laid out bottom-up
+        const maxW = W - pad * 2;
+        c.font = `italic 16px Georgia, 'Times New Roman', serif`;
+        const msgLines = wrapLines(c, messageOut.textContent, maxW, 3);
+        c.font = `bold 27px ${font}`;
+        const nameLines = wrapLines(c, nameOut.textContent, maxW, 2);
+
+        let y = H - pad - msgLines.length * 22;
+        c.font = `italic 16px Georgia, 'Times New Roman', serif`;
+        msgLines.forEach((l, i) => c.fillText(l, pad, y + i * 22));
+        y -= 6 + nameLines.length * 32;
+        c.font = `bold 27px ${font}`;
+        nameLines.forEach((l, i) => c.fillText(l, pad, y + i * 32));
+        y -= 20;
+        c.globalAlpha = 0.85;
+        c.font = `13px ${font}`;
+        c.letterSpacing = '1px';
+        c.fillText('FOR', pad, y);
+        return out;
+      }
+
+      // ---- Export ----
+      function canvasToBlob(source) {
+        return new Promise((resolve, reject) => {
+          source.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Could not encode image'))), 'image/png');
+        });
+      }
+
+      function fileName() {
+        const slug = (nameInput.value.trim() || 'gift')
+          .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30) || 'gift';
+        return `daily-grind-gift-card-${slug}.png`;
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        exportBtn.disabled = true;
+        status.textContent = 'Preparing your gift card…';
+        try {
+          let source;
+          if (supportsHTMLInCanvas) {
+            // Make sure the canvas reflects the latest DOM state before reading pixels.
+            await waitForPaint();
+            source = canvas;
+          } else {
+            source = await renderFallbackCanvas();
+          }
+          const blob = await canvasToBlob(source);
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = fileName();
+          document.body.appendChild(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Your gift card has been downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, the gift card could not be exported. Please try again.';
+        } finally {
+          exportBtn.disabled = false;
+        }
+      });
+
+      if (supportsHTMLInCanvas) setupHTMLInCanvas();
+      else setupFallback();
+      updateCard();
+    })();
+  </script>
