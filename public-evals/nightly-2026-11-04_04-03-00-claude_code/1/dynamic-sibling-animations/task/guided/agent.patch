diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,27 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Staggered entrance: each card starts 100ms after the previous one */
+    .grid > .card {
+      --stagger-time: 100ms;
+
+      @media (prefers-reduced-motion: no-preference) {
+        animation: card-in 0.5s ease-out both;
+        /* Fallback for browsers without sibling-index() (set via JS below) */
+        animation-delay: calc(var(--sibling-index, 0) * var(--stagger-time));
+        animation-delay: calc((sibling-index() - 1) * var(--stagger-time));
+      }
+    }
+
+    @keyframes card-in {
+      from {
+        opacity: 0;
+        translate: 0 20px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
@@ -196,8 +215,17 @@
       </div>
     </section>
   </main>
 
+  <script>
+    // Fallback stagger index for browsers without CSS sibling-index()
+    if (!CSS.supports('animation-delay: calc(sibling-index() * 0.1s)')) {
+      document.querySelectorAll('.grid').forEach((grid) => {
+        [...grid.children].forEach((el, index) => el.style.setProperty('--sibling-index', index));
+      });
+    }
+  </script>
