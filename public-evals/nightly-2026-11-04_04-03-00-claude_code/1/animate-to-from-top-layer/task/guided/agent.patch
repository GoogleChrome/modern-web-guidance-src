+  <script type="module">
+    // Load the Popover polyfill only where native support is missing.
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+  </script>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('logout-dialog');
+      const openBtn = document.getElementById('open-dialog-btn');
+      const notice = document.getElementById('ordering-notice');
+
+      // Firefox parses allow-discrete but doesn't transition display, so probe it.
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+          return (supportsDisplayTransition = false);
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      function supportsTopLayerExit() {
+        return !!window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+      }
+
+      // Play the exit transition before removing the element from the top layer
+      // in browsers that can't animate display/overlay natively.
+      async function closeTopLayer(el, close) {
+        if (!supportsTopLayerExit()) {
+          if (el.hasAttribute('data-closing')) return;
+          el.setAttribute('data-closing', '');
+          const animations = el.getAnimations({ subtree: true });
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 2000)),
+            ]);
+          }
+          if (!el.hasAttribute('data-closing')) return;
+          el.removeAttribute('data-closing');
+        }
+        close();
+      }
+
+      const closeDialog = () => closeTopLayer(dialog, () => dialog.close());
+      const closeNotice = () => closeTopLayer(notice, () => notice.hidePopover());
+
+      // Logout modal
+      openBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        dialog.removeAttribute('data-closing');
+        dialog.showModal();
+      });
+
+      dialog.querySelectorAll('#close-dialog-btn, [data-close-dialog]').forEach((btn) =>
+        btn.addEventListener('click', closeDialog)
+      );
+
+      // Route Esc / light dismiss through the animated close where needed.
+      dialog.addEventListener('cancel', (event) => {
+        if (supportsTopLayerExit()) return;
+        event.preventDefault();
+        closeDialog();
+      });
+
+      // Light-dismiss fallback for browsers without <dialog closedby>.
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) closeDialog();
+        });
+      }
+
+      // Floating notice
+      notice.querySelector('[data-close-notice]').addEventListener('click', closeNotice);
+      notice.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') notice.removeAttribute('data-closing');
+      });
+    })();
+  </script>
+
