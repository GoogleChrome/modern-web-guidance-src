+  <script>
+    (function () {
+      // Runs `done` once the element's animation/transition finishes,
+      // or immediately if no animation is active (e.g. reduced motion).
+      function afterMotion(el, type, done) {
+        var style = getComputedStyle(el);
+        var duration = type === 'animation'
+          ? style.animationName !== 'none' && parseFloat(style.animationDuration)
+          : parseFloat(style.transitionDuration);
+        if (!duration) { done(); return; }
+        var finished = false;
+        function finish(e) {
+          if (e && e.target !== el) return;
+          if (finished) return;
+          finished = true;
+          el.removeEventListener(type + 'end', finish);
+          clearTimeout(timer);
+          done();
+        }
+        el.addEventListener(type + 'end', finish);
+        var timer = setTimeout(finish, 600); // safety fallback
+      }
+
+      /* ---- Logout confirmation modal ---- */
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+
+      function openDialog() {
+        if (dialog.open) return;
+        dialog.classList.remove('is-closing');
+        dialog.showModal();
+      }
+
+      function closeDialog() {
+        if (!dialog.open || dialog.classList.contains('is-closing')) return;
+        dialog.classList.add('is-closing');
+        afterMotion(dialog, 'animation', function () {
+          dialog.classList.remove('is-closing');
+          dialog.close();
+          openBtn.focus();
+        });
+      }
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        openDialog();
+      });
+      closeBtn.addEventListener('click', closeDialog);
+
+      // Escape key: animate out instead of closing instantly.
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDialog();
+      });
+
+      // Click on the backdrop closes the dialog.
+      dialog.addEventListener('click', function (e) {
+        if (e.target !== dialog) return;
+        var r = dialog.getBoundingClientRect();
+        var inside = e.clientX >= r.left && e.clientX <= r.right &&
+          e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDialog();
+      });
+
+      /* ---- Informational floating overlay ---- */
+      var overlay = document.getElementById('info-overlay');
+      var overlayTrigger = document.getElementById('foobar');
+      var overlayClose = document.getElementById('info-overlay-close');
+      var hideToken = 0;
+
+      function showOverlay() {
+        hideToken++; // cancel any pending hide
+        overlay.hidden = false;
+        void overlay.offsetWidth; // force reflow so the transition runs
+        overlay.classList.add('is-visible');
+      }
+
+      function hideOverlay() {
+        if (overlay.hidden || !overlay.classList.contains('is-visible')) return;
+        var token = ++hideToken;
+        overlay.classList.remove('is-visible');
+        afterMotion(overlay, 'transition', function () {
+          if (token === hideToken) overlay.hidden = true;
+        });
+      }
+
+      overlayTrigger.addEventListener('click', showOverlay);
+      overlayClose.addEventListener('click', hideOverlay);
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && !dialog.open) hideOverlay();
+      });
+    })();
+  </script>
