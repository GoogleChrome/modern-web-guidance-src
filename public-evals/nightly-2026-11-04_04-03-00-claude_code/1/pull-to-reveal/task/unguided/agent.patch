       margin: 0;
       padding: 0;
     }
 
+    html {
+      /* Proximity snapping: the search bar snaps fully open or fully closed
+         near the top, without interfering with free scrolling further down. */
+      scroll-snap-type: y proximity;
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-down search bar (sits above the nav, hidden on load) */
+    .search-bar {
+      background: var(--text);
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 8px;
+      max-width: 700px;
+      margin: 0 auto;
+    }
+
+    .search-bar input[type="search"] {
+      flex: 1;
+      padding: 8px 12px;
+      border: none;
+      border-radius: 4px;
+      font: inherit;
+      font-size: 0.95rem;
+    }
+
+    .search-bar input[type="search"]:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .search-bar button {
+      background: var(--accent);
+      color: var(--text);
+      border: none;
+      border-radius: 4px;
+      padding: 8px 16px;
+      font: inherit;
+      font-size: 0.9rem;
+      font-weight: bold;
+      cursor: pointer;
+    }
+
+    /* Zero-height, non-sticky marker at the nav's resting position, used as
+       the "closed" snap point (the sticky nav itself moves, so it can't be). */
+    .search-snap-point {
+      height: 0;
+      scroll-snap-align: start;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
