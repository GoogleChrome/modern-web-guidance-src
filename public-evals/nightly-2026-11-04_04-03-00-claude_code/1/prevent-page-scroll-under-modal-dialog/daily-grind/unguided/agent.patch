@@ -230,10 +239,20 @@
 
   <script>
     const noticeDialog = document.getElementById("notice-dialog");
+    const closeNotice = document.getElementById("close-notice");
+
     if (noticeDialog) {
-      noticeDialog.show();
-      document.body.classList.add("modal-open");
-      document.body.style.overflow = "hidden";
+      // Release the scroll lock however the dialog closes (button, Esc, form).
