+    /* Offscreen cards skip layout/paint until scrolled near the viewport.
+       `auto` remembers the real size once a card has been rendered, so the
+       scrollbar stays stable. --card-height is measured from the first card. */
+    .off-screen-card {
+      content-visibility: auto;
+      contain-intrinsic-size: auto var(--card-height, 340px);
+    }
+
+    /* Debug panel: hidden via content-visibility so the browser keeps its
