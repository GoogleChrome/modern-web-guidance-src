       margin: 2rem auto;
       text-align: center;
       color: #64748b;
     }
+    /* Cards below the initial viewport: skip layout/paint until scrolled near. */
+    .off-screen-card {
+      content-visibility: auto;
+      /* Estimated card height; 'auto' remembers the real size once rendered. */
+      contain-intrinsic-size: auto none auto 366px;
+    }
+
+    /* Debug panel: hidden by default. content-visibility: hidden keeps the
+       rendering state cached so toggling is instant (vs. display: none). */
+    .debug-panel {
+      max-width: 800px;
+      margin: 0 auto 2rem;
+      padding: 0 1rem;
+      display: none;
+    }
+
+    @supports (content-visibility: hidden) {
+      .debug-panel {
+        display: block;
+        content-visibility: hidden;
+      }
+    }
+
+    .debug-panel.is-active {
+      display: block;
+      content-visibility: visible;
+    }
+
+    .debug-panel-inner {
