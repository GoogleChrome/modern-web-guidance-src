+  <script>
+    (() => {
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-value');
+      const suggestion = document.getElementById('brew-strength-suggestion');
+      const levels = [
+        { label: 'Extra mild', brew: 'Maple Oat Latte' },
+        { label: 'Mild', brew: 'Light Roast pour-over' },
+        { label: 'Medium', brew: 'House Blend drip' },
+        { label: 'Strong', brew: 'Cold Brew' },
+        { label: 'Extra bold', brew: 'Dark Roast Espresso' },
+      ];
+
+      function syncSlider() {
+        // Feed min/max/value to CSS for the WebKit fill (also covers browsers without typed attr()).
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+
+        const level = levels[Number(slider.value) - Number(slider.min)] ?? levels[2];
+        output.value = level.label;
+        slider.setAttribute('aria-valuetext', level.label);
+        suggestion.textContent = `Suggested: ${level.brew}`;
+      }
+
+      syncSlider();
+      slider.addEventListener('input', syncSlider);
+    })();
+  </script>
+
