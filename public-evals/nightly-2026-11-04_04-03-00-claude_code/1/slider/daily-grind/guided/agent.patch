+    .brew-slider {
+      --slider-track-size: 0.5rem;
+      --slider-thumb-size: 1.5rem;
+      --slider-track-radius: 999px;
+      --slider-thumb-radius: 50%;
+      --slider-track-color: #a1887f;
+      --slider-fill-color: var(--primary);
+      --slider-thumb-color: var(--primary);
+      --slider-thumb-border: 3px solid white;
+      --slider-thumb-shadow: 0 0 0 1px var(--primary), 0 2px 4px rgba(0, 0, 0, 0.3);
+      --slider-direction: to right;
+
+      /* Read min/max/value from attributes; script keeps these in sync (and covers browsers without typed attr()). */
+      --attr-min: attr(min type(<number>), 0);
+      --attr-max: attr(max type(<number>), 100);
+      --control-value: attr(value type(<number>), 50);
+      --slider-progress: calc(progress(var(--control-value), var(--attr-min), var(--attr-max)) * 100%);
+
+      appearance: none;
+      display: block;
+      inline-size: 100%;
+      block-size: 2.75rem; /* generous touch target */
+      margin: 0;
+      padding: 0;
+      border: 0;
+      border-radius: 0;
+      background: transparent;
+      cursor: pointer;
+    }
+
+    .brew-slider:dir(rtl) {
+      --slider-direction: to left;
+    }
+
+    @supports not (opacity: progress(1, 0, 100)) {
+      .brew-slider {
+        --slider-progress: calc((var(--control-value) - var(--attr-min)) / (var(--attr-max) - var(--attr-min)) * 100%);
+      }
+    }
+
+    .brew-slider:hover,
+    .brew-slider:active {
