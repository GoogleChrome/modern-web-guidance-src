+
+    /* WebKit / Blink track (fill painted via gradient + --fill) */
+    .brew-slider::-webkit-slider-runnable-track {
+      height: var(--track-height);
+      border-radius: 999px;
+      background:
+        linear-gradient(to right, var(--fill-start), var(--fill-end)) 0 / var(--fill) 100% no-repeat,
+        var(--track-bg);
+      box-shadow: inset 0 1px 2px rgba(62, 39, 35, 0.25);
+    }
+
+    .brew-slider::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb-size);
+      height: var(--thumb-size);
+      margin-top: calc((var(--track-height) - var(--thumb-size)) / 2);
+      border-radius: 50%;
+      background: radial-gradient(circle at 35% 35%, #8d6e63, var(--primary) 70%);
+      border: 3px solid white;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s ease, box-shadow 0.15s ease;
