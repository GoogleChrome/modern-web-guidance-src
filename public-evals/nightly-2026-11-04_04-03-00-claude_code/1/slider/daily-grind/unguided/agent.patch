+    .brew-slider {
+      --track-height: 10px;
+      --thumb-size: 26px;
+      --track-bg: var(--secondary);
+      --fill-start: #a1887f;
+      --fill-end: var(--primary);
+      --fill: 50%;
+
+      -webkit-appearance: none;
+      appearance: none;
+      display: block;
