+  <script>
+    (function () {
+      var slider = document.getElementById('brew-strength');
+      var output = document.getElementById('brew-strength-output');
+      var note = document.getElementById('brew-strength-note');
+      if (!slider) return;
+
+      var levels = {
+        1: { label: 'Extra Mild', note: 'Light and delicate — try our Breakfast Blonde.' },
+        2: { label: 'Mild', note: 'Gentle and bright — try our Colombian Light Roast.' },
+        3: { label: 'Medium', note: 'Balanced and smooth — try our House Blend.' },
+        4: { label: 'Strong', note: 'Rich and full-bodied — try our French Roast.' },
+        5: { label: 'Extra Bold', note: 'Intense and smokey — try our Dark Roast Espresso.' }
+      };
+
+      function update() {
+        var min = Number(slider.min) || 0;
+        var max = Number(slider.max) || 100;
+        var val = Number(slider.value);
+        var pct = ((val - min) / (max - min)) * 100;
+        // Offset so the fill ends at the thumb's centre rather than its edge
+        var thumb = 26;
+        slider.style.setProperty('--fill', 'calc(' + pct + '% + ' + (thumb / 2 - (pct / 100) * thumb) + 'px)');
+
+        var level = levels[val] || { label: String(val), note: '' };
+        output.textContent = level.label;
+        slider.setAttribute('aria-valuetext', level.label + ' (' + val + ' of ' + max + ')');
+        note.textContent = level.note;
+      }
+
+      slider.addEventListener('input', update);
+      update();
+    })();
+  </script>
+
