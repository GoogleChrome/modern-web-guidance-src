@@ -0,0 +1,31 @@
+export interface SearchableArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  category?: string;
+  author?: string;
+  tags?: string[];
+}
+
+/**
+ * Case-insensitive search over article title, summary, author and tags,
+ * optionally restricted to a single category. Shared by the server-rendered
+ * /search page and the client-side agent tools so both return identical results.
+ */
+export function searchArticles<T extends SearchableArticle>(
+  articles: T[],
+  query: string,
+  category?: string,
+): T[] {
+  const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+  const cat = category?.toLowerCase().trim();
+
+  return articles.filter((article) => {
+    if (cat && article.category?.toLowerCase() !== cat) return false;
+    if (terms.length === 0) return Boolean(cat);
+    const haystack = [article.title, article.summary, article.author ?? '', ...(article.tags ?? [])]
+      .join(' ')
+      .toLowerCase();
+    return terms.every((term) => haystack.includes(term));
+  });
+}
