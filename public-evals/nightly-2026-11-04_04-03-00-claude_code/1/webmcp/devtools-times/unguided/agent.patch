diff --git a/src/components/AgentToolForms.astro b/src/components/AgentToolForms.astro
new file mode 100644
index 0000000..b39e8b5
--- /dev/null
+++ b/src/components/AgentToolForms.astro
@@ -0,0 +1,92 @@
+---
+/**
+ * Declarative WebMCP form tools.
+ *
+ * These forms are mounted on every page (via the Header) so that in-browser AI
+ * agents can discover them as tools. The `toolname` / `tooldescription` /
+ * `toolparamdescription` attributes describe the tool; `<select>` options become
+ * enums in the generated input schema. When an agent submits a form, the
+ * handler in `src/scripts/webmcp.ts` intercepts it and replies with structured
+ * data via `SubmitEvent.respondWith()`. Without JS (or for people using
+ * assistive tech) the forms still work as regular forms.
+ *
+ * Visible to screen readers, visually hidden for sighted users who already
+ * have the search / reading-list flyouts.
+ */
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+  articles: CollectionEntry<'articles'>[];
+  categories: string[];
+}
+
+const { articles, categories } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+const sortedArticles = [...articles].sort((a, b) => a.data.title.localeCompare(b.data.title));
+const sortedCategories = [...new Set(categories.map((c) => c.toLowerCase()))].sort();
+---
+
+<div class="sr-only" data-agent-tool-forms>
+  <form
+    role="search"
+    action={`${baseUrl}search`}
+    method="get"
+    data-agent-form="search"
+    toolname="search_articles"
+    tooldescription="Search The DevTools Times articles by keyword. Matches article titles, summaries, authors and tags, optionally limited to one news category. Returns matching articles with slug, title, summary, category, author, date and URL."
+    toolautosubmit
+  >
+    <label for="agent-search-q">Search articles</label>
+    <input
+      id="agent-search-q"
+      type="search"
+      name="q"
+      required
+      toolparamtitle="Search query"
+      toolparamdescription="Keywords to search for, e.g. 'cycling' or 'housing crisis'. All words must match."
+    />
+    <label for="agent-search-category">Category</label>
+    <select
+      id="agent-search-category"
+      name="category"
+      toolparamtitle="Category"
+      toolparamdescription="Optional news category to restrict results to. Leave empty to search all categories."
+    >
+      <option value="">All categories</option>
+      {sortedCategories.map((c) => <option value={c}>{c.charAt(0).toUpperCase() + c.slice(1)}</option>)}
+    </select>
+    <button type="submit">Search</button>
+  </form>
+
+  <form
+    action={`${baseUrl}api/reading-list.json`}
+    method="post"
+    data-agent-form="reading-list"
+    toolname="update_reading_list"
+    tooldescription="Add an article to, or remove an article from, the reader's saved reading list on The DevTools Times. Returns the updated reading list."
+    toolautosubmit
+  >
+    <label for="agent-reading-list-action">Reading list action</label>
+    <select
+      id="agent-reading-list-action"
+      name="action"
+      required
+      toolparamtitle="Action"
+      toolparamdescription="'add' saves the article to the reading list, 'remove' deletes it from the reading list."
+    >
+      <option value="add">Add to reading list</option>
+      <option value="remove">Remove from reading list</option>
+    </select>
+    <label for="agent-reading-list-slug">Article</label>
+    <select
+      id="agent-reading-list-slug"
+      name="slug"
+      required
+      toolparamtitle="Article"
+      toolparamdescription="Slug of the article to add or remove. Use search_articles or list_articles to find slugs."
+    >
+      {sortedArticles.map((a) => <option value={a.id}>{a.data.title}</option>)}
+    </select>
+    <button type="submit">Update reading list</button>
+  </form>
+</div>
