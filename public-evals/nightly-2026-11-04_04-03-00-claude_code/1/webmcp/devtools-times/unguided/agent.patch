diff --git a/src/pages/search.astro b/src/pages/search.astro
new file mode 100644
index 0000000..cecb38d
--- /dev/null
+++ b/src/pages/search.astro
@@ -0,0 +1,47 @@
+---
+import Layout from '../layouts/Layout.astro';
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import { getCollection } from 'astro:content';
+import { searchArticles } from '../utils/articleSearch';
+
+const query = Astro.url.searchParams.get('q')?.trim() ?? '';
+const category = Astro.url.searchParams.get('category')?.trim() ?? '';
+
+const articles = await getCollection('articles');
+const results =
+  query || category
+    ? searchArticles(
+        articles.map((entry) => ({
+          entry,
+          slug: entry.id,
+          title: entry.data.title,
+          summary: entry.data.summary,
+          category: entry.data.category,
+          author: entry.data.author,
+          tags: entry.data.tags,
+        })),
+        query,
+        category,
+      ).map((r) => r.entry)
+    : [];
+
+const heading = query ? `Search results for “${query}”` : 'Search';
+---
+
+<Layout title={`${heading} | The DevTools Times`}>
+  <section class="max-w-6xl mx-auto p-4 md:p-6">
+    <h1 class="text-3xl font-brand text-gray-900 mb-2">{heading}</h1>
+    {category && <p class="text-sm text-gray-600 mb-4">Category: {category}</p>}
+    {(query || category) && results.length === 0 && (
+      <p class="text-gray-500 py-8">No articles matched your search.</p>
+    )}
+    {results.length > 0 && (
+      <>
+        <p class="text-sm text-gray-600 mb-6">{results.length} article{results.length === 1 ? '' : 's'} found</p>
+        <div class="grid md:grid-cols-3 gap-6">
+          {results.map((article) => <ArticleTeaser article={article} />)}
+        </div>
+      </>
+    )}
+  </section>
+</Layout>
diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..c6ac4b0
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,542 @@
+/**
+ * WebMCP integration for The DevTools Times.
+ *
+ * Lets AI agents running in the browser discover and call the site's features
+ * as tools:
+ *
+ *  - Declarative form tools (`search_articles`, `update_reading_list`) are
+ *    defined in `src/components/AgentToolForms.astro`. This script handles
+ *    agent-invoked submissions and returns structured results.
+ *  - Imperative tools are registered through `navigator.modelContext`:
+ *      • site-wide: list_articles, get_reading_list, open_article
+ *      • on article pages only: get_current_article, get_article_outline,
+ *        scroll_to_article_section, find_in_article, get_article_share_links,
+ *        set_article_bookmark
+ *
+ * The site uses Astro's <ClientRouter />, so this module runs once and
+ * article tools are re-registered on every `astro:page-load` and removed
+ * before the next page swap.
+ */
+import { navigate } from 'astro:transitions/client';
+import { searchArticles } from '../utils/articleSearch';
+
+const BASE_URL = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+export const READING_LIST_EVENT = 'readinglistchange';
+
+interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+  category: string;
+  author: string;
+  date: string;
+  readingTime?: number;
+  tags: string[];
+}
+
+// ---------------------------------------------------------------------------
+// Data helpers
+// ---------------------------------------------------------------------------
+
+let articlesPromise: Promise<ArticleSummary[]> | null = null;
+
+function getArticles(): Promise<ArticleSummary[]> {
+  if (!articlesPromise) {
+    articlesPromise = fetch(`${BASE_URL}api/articles.json`)
+      .then((res) => {
+        if (!res.ok) throw new Error(`Failed to load articles (HTTP ${res.status})`);
+        return res.json() as Promise<ArticleSummary[]>;
+      })
+      .catch((err) => {
+        articlesPromise = null; // allow a retry on the next call
+        throw err;
+      });
+  }
+  return articlesPromise;
+}
+
+function articleUrl(slug: string): string {
+  return new URL(`${BASE_URL}articles/${slug}`, location.origin).href;
+}
+
+function toResult(article: ArticleSummary) {
+  return {
+    slug: article.slug,
+    title: article.title,
+    summary: article.summary,
+    category: article.category,
+    author: article.author,
+    date: article.date,
+    readingTimeMinutes: article.readingTime,
+    url: articleUrl(article.slug),
+  };
+}
+
+async function fetchReadingList(): Promise<string[]> {
+  const res = await fetch(`${BASE_URL}api/reading-list.json`);
+  if (!res.ok) throw new Error(`Failed to load reading list (HTTP ${res.status})`);
+  const data = await res.json();
+  return data.readingList ?? [];
+}
+
+async function updateReadingList(slug: string, action: 'add' | 'remove'): Promise<string[]> {
+  const res = await fetch(`${BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }),
+  });
+  const data = await res.json();
+  if (!res.ok) throw new Error(data.error ?? `Failed to update reading list (HTTP ${res.status})`);
+  const readingList: string[] = data.readingList ?? [];
+  // Keep bookmark buttons and the reading-list flyout in sync.
+  window.dispatchEvent(new CustomEvent(READING_LIST_EVENT, { detail: { readingList } }));
+  return readingList;
+}
+
+async function describeReadingList(readingList: string[]) {
+  const articles = await getArticles();
+  const bySlug = new Map(articles.map((a) => [a.slug, a]));
+  return readingList.map((slug) => {
+    const article = bySlug.get(slug);
+    return article ? toResult(article) : { slug, url: articleUrl(slug) };
+  });
+}
+
+async function assertKnownSlug(slug: unknown): Promise<string> {
+  if (typeof slug !== 'string' || !slug.trim()) throw new Error('An article slug is required.');
+  const articles = await getArticles();
+  if (!articles.some((a) => a.slug === slug)) {
+    throw new Error(`Unknown article slug "${slug}". Use search_articles or list_articles to find valid slugs.`);
+  }
+  return slug;
+}
+
+/** Wraps a value in the MCP tool-result shape. */
+function textResult(value: unknown) {
+  return {
+    content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value, null, 2) }],
+  };
+}
+
+function errorResult(err: unknown) {
+  const message = err instanceof Error ? err.message : String(err);
+  return { content: [{ type: 'text', text: `Error: ${message}` }], isError: true };
+}
+
+// ---------------------------------------------------------------------------
+// Tool registration helpers
+// ---------------------------------------------------------------------------
+
+function registerTool(tool: ModelContextTool, signal?: AbortSignal) {
+  const modelContext = navigator.modelContext;
+  if (!modelContext?.registerTool) return;
+
+  const wrapped: ModelContextTool = {
+    ...tool,
+    async execute(input, client) {
+      try {
+        return textResult(await tool.execute(input ?? {}, client));
+      } catch (err) {
+        return errorResult(err);
+      }
+    },
+  };
+
+  let registration: { unregister?: () => void } | void;
+  try {
+    registration = modelContext.registerTool(wrapped, signal ? { signal } : undefined);
+  } catch (err) {
+    console.warn(`[webmcp] Could not register tool "${tool.name}":`, err);
+    return;
+  }
+
+  signal?.addEventListener(
+    'abort',
+    () => {
+      try {
+        if (registration && typeof registration.unregister === 'function') registration.unregister();
+        else modelContext.unregisterTool?.(tool.name);
+      } catch {
+        // Already removed (e.g. by the AbortSignal itself).
+      }
+    },
+    { once: true },
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Declarative form tools
+// ---------------------------------------------------------------------------
+
+async function handleSearchForm(form: HTMLFormElement) {
+  const data = new FormData(form);
+  const query = String(data.get('q') ?? '').trim();
+  const category = String(data.get('category') ?? '').trim();
+  if (!query && !category) throw new Error('Provide a search query.');
+
+  const results = searchArticles(await getArticles(), query, category || undefined);
+  const searchUrl = new URL(`${BASE_URL}search`, location.origin);
+  if (query) searchUrl.searchParams.set('q', query);
+  if (category) searchUrl.searchParams.set('category', category);
+
+  return {
+    query,
+    category: category || null,
+    total: results.length,
+    results: results.map(toResult),
+    searchPageUrl: searchUrl.href,
+  };
+}
+
+async function handleReadingListForm(form: HTMLFormElement) {
+  const data = new FormData(form);
+  const action = data.get('action') === 'remove' ? 'remove' : 'add';
+  const slug = await assertKnownSlug(data.get('slug'));
+  const readingList = await updateReadingList(slug, action);
+  return {
+    action,
+    slug,
+    saved: readingList.includes(slug),
+    readingList: await describeReadingList(readingList),
+  };
+}
+
+const formHandlers: Record<string, (form: HTMLFormElement) => Promise<unknown>> = {
+  search: handleSearchForm,
+  'reading-list': handleReadingListForm,
+};
+
+// Capture phase on window so we run before Astro's ClientRouter form handling.
+window.addEventListener(
+  'submit',
+  (event) => {
+    const form = event.target;
+    if (!(form instanceof HTMLFormElement)) return;
+    const handler = formHandlers[form.dataset.agentForm ?? ''];
+    if (!handler || !event.agentInvoked || typeof event.respondWith !== 'function') return;
+
+    event.preventDefault();
+    event.respondWith(
+      handler(form).catch((err) => ({ error: err instanceof Error ? err.message : String(err) })),
+    );
+  },
+  true,
+);
+
+// ---------------------------------------------------------------------------
+// Site-wide imperative tools
+// ---------------------------------------------------------------------------
+
+function registerSiteTools() {
+  registerTool({
+    name: 'list_articles',
+    description:
+      'List articles published on The DevTools Times, newest first. Optionally filter by category. Returns slug, title, summary, category, author, date and URL for each article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: {
+          type: 'string',
+          description: 'Optional category to filter by (case-insensitive), e.g. "sports" or "lifestyle".',
+        },
+        limit: {
+          type: 'integer',
+          minimum: 1,
+          maximum: 100,
+          description: 'Maximum number of articles to return. Defaults to 20.',
+        },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ category, limit }: { category?: string; limit?: number }) {
+      const all = await getArticles();
+      const cat = category?.toLowerCase().trim();
+      const filtered = (cat ? all.filter((a) => a.category === cat) : all)
+        .slice()
+        .sort((a, b) => b.date.localeCompare(a.date));
+      const max = Math.min(Math.max(Number(limit) || 20, 1), 100);
+      return {
+        categories: [...new Set(all.map((a) => a.category))].sort(),
+        total: filtered.length,
+        articles: filtered.slice(0, max).map(toResult),
+      };
+    },
+  });
+
+  registerTool({
+    name: 'get_reading_list',
+    description: "Get the articles currently saved in the reader's reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const readingList = await fetchReadingList();
+      return { total: readingList.length, articles: await describeReadingList(readingList) };
+    },
+  });
+
+  registerTool({
+    name: 'open_article',
+    description: 'Navigate the browser to an article on The DevTools Times so the reader can read it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Slug of the article to open (from search_articles or list_articles).' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }: { slug: string }) {
+      const valid = await assertKnownSlug(slug);
+      const url = `${BASE_URL}articles/${valid}`;
+      // Navigate after returning so the response reaches the agent before the page swaps.
+      setTimeout(() => navigate(url), 0);
+      return { navigatingTo: articleUrl(valid) };
+    },
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Article-page imperative tools
+// ---------------------------------------------------------------------------
+
+const FIND_HIGHLIGHT = 'agent-find';
+
+function clearFindHighlight() {
+  (CSS as any).highlights?.delete(FIND_HIGHLIGHT);
+}
+
+function getHeadings(body: HTMLElement) {
+  return [...body.querySelectorAll<HTMLHeadingElement>('h1, h2, h3, h4, h5, h6')].map((el) => ({
+    el,
+    level: Number(el.tagName[1]),
+    text: el.textContent?.trim() ?? '',
+    id: el.id || null,
+  }));
+}
+
+function registerArticleTools(root: HTMLElement, signal: AbortSignal) {
+  const body = root.querySelector<HTMLElement>('[data-article-body]');
+  if (!body) return;
+  const ds = root.dataset;
+  const slug = ds.articleSlug!;
+
+  const metadata = () => ({
+    slug,
+    title: ds.articleTitle,
+    summary: ds.articleSummary,
+    author: ds.articleAuthor,
+    date: ds.articleDate,
+    category: ds.articleCategory,
+    url: articleUrl(slug),
+  });
+
+  registerTool(
+    {
+      name: 'get_current_article',
+      description:
+        'Get the article currently open in the browser: metadata (title, author, date, category, URL), word count, estimated reading time, and optionally the full plain-text body.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          includeBody: {
+            type: 'boolean',
+            description: 'Include the full article text. Defaults to true.',
+          },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      async execute({ includeBody = true }: { includeBody?: boolean }) {
+        const text = body.innerText.trim();
+        const wordCount = text.split(/\s+/).filter(Boolean).length;
+        const readingList = await fetchReadingList().catch(() => null);
+        return {
+          ...metadata(),
+          wordCount,
+          estimatedReadingTimeMinutes: Math.max(1, Math.round(wordCount / 230)),
+          savedToReadingList: readingList ? readingList.includes(slug) : null,
+          ...(includeBody ? { body: text } : {}),
+        };
+      },
+    },
+    signal,
+  );
+
+  registerTool(
+    {
+      name: 'get_article_outline',
+      description: 'Get the section headings of the article currently open in the browser, in reading order.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        return {
+          title: ds.articleTitle,
+          sections: getHeadings(body).map(({ level, text, id }) => ({ level, heading: text, id })),
+        };
+      },
+    },
+    signal,
+  );
+
+  registerTool(
+    {
+      name: 'scroll_to_article_section',
+      description:
+        'Scroll the article currently open in the browser to a section. Matches the heading text case-insensitively (partial matches allowed). Use get_article_outline to see available sections.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          heading: { type: 'string', description: 'Heading text (or part of it) of the section to scroll to.' },
+        },
+        required: ['heading'],
+      },
+      execute({ heading }: { heading: string }) {
+        const needle = String(heading ?? '').toLowerCase().trim();
+        if (!needle) throw new Error('A heading is required.');
+        const headings = getHeadings(body);
+        const match =
+          headings.find((h) => h.text.toLowerCase() === needle) ??
+          headings.find((h) => h.text.toLowerCase().includes(needle));
+        if (!match) {
+          throw new Error(
+            `No section matching "${heading}". Available sections: ${headings.map((h) => h.text).join('; ') || 'none'}.`,
+          );
+        }
+        match.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        if (match.id) history.replaceState(history.state, '', `#${match.id}`);
+        return { scrolledTo: match.text, id: match.id };
+      },
+    },
+    signal,
+  );
+
+  registerTool(
+    {
+      name: 'find_in_article',
+      description:
+        'Find text in the article currently open in the browser. Returns surrounding snippets for each match, highlights all matches on the page and scrolls to the first one.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          text: { type: 'string', description: 'Text to find (case-insensitive).' },
+          maxResults: {
+            type: 'integer',
+            minimum: 1,
+            maximum: 50,
+            description: 'Maximum number of snippets to return. Defaults to 10.',
+          },
+        },
+        required: ['text'],
+      },
+      execute({ text, maxResults }: { text: string; maxResults?: number }) {
+        const needle = String(text ?? '').toLowerCase();
+        if (!needle.trim()) throw new Error('Search text is required.');
+        const max = Math.min(Math.max(Number(maxResults) || 10, 1), 50);
+
+        const ranges: Range[] = [];
+        const snippets: string[] = [];
+        const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
+        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+          const value = node.nodeValue ?? '';
+          const lower = value.toLowerCase();
+          for (let i = lower.indexOf(needle); i !== -1; i = lower.indexOf(needle, i + needle.length)) {
+            const range = document.createRange();
+            range.setStart(node, i);
+            range.setEnd(node, i + needle.length);
+            ranges.push(range);
+            if (snippets.length < max) {
+              const context = (node.parentElement?.closest('p, li, h1, h2, h3, h4, h5, h6, blockquote') ??
+                node.parentElement)?.textContent?.trim() ?? value;
+              const at = context.toLowerCase().indexOf(needle);
+              const start = Math.max(0, at - 80);
+              const end = Math.min(context.length, at + needle.length + 80);
+              snippets.push(`${start > 0 ? '…' : ''}${context.slice(start, end)}${end < context.length ? '…' : ''}`);
+            }
+          }
+        }
+
+        clearFindHighlight();
+        if (ranges.length) {
+          const HighlightCtor = (window as any).Highlight;
+          if (HighlightCtor && (CSS as any).highlights) {
+            (CSS as any).highlights.set(FIND_HIGHLIGHT, new HighlightCtor(...ranges));
+          }
+          ranges[0].startContainer.parentElement?.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+        return { query: text, totalMatches: ranges.length, snippets };
+      },
+    },
+    signal,
+  );
+
+  registerTool(
+    {
+      name: 'get_article_share_links',
+      description:
+        'Get ready-to-use share links (direct link, Facebook, X, email) for the article currently open in the browser.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        const url = articleUrl(slug);
+        const title = ds.articleTitle ?? document.title;
+        const enc = encodeURIComponent;
+        return {
+          url,
+          facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
+          x: `https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}`,
+          email: `mailto:?subject=${enc(title)}&body=${enc(`${ds.articleSummary ?? ''}\n\n${url}`)}`,
+        };
+      },
+    },
+    signal,
+  );
+
+  registerTool(
+    {
+      name: 'set_article_bookmark',
+      description:
+        "Save the article currently open in the browser to the reader's reading list, or remove it from the reading list.",
+      inputSchema: {
+        type: 'object',
+        properties: {
+          saved: {
+            type: 'boolean',
+            description: 'true to add the article to the reading list, false to remove it.',
+          },
+        },
+        required: ['saved'],
+      },
+      async execute({ saved }: { saved: boolean }) {
+        const readingList = await updateReadingList(slug, saved === false ? 'remove' : 'add');
+        return { slug, title: ds.articleTitle, saved: readingList.includes(slug), readingListSize: readingList.length };
+      },
+    },
+    signal,
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle
+// ---------------------------------------------------------------------------
+
+registerSiteTools();
+
+let pageController: AbortController | null = null;
+
+function teardownPageTools() {
+  pageController?.abort();
+  pageController = null;
+  clearFindHighlight();
+}
+
+document.addEventListener('astro:page-load', () => {
+  teardownPageTools();
+  const root = document.querySelector<HTMLElement>('[data-article-root]');
+  if (!root?.dataset.articleSlug) return;
+  pageController = new AbortController();
+  registerArticleTools(root, pageController.signal);
+});
+
+document.addEventListener('astro:before-swap', teardownPageTools);
