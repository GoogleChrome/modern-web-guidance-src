@@ -0,0 +1,26 @@
+const READING_LIST_URL = `${import.meta.env.BASE_URL}api/reading-list.json`;
+
+/** Fired on `window` whenever the reading list changes, so every island stays in sync. */
+export const READING_LIST_CHANGE_EVENT = 'readinglistchange';
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(READING_LIST_URL, { signal });
+  if (!response.ok) throw new Error(`Reading list request failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** Adds the article if it is missing, removes it if it is saved. Returns the updated list. */
+export async function toggleReadingListItem(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(READING_LIST_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Reading list update failed with status ${response.status}`);
+  const data = await response.json();
+  const readingList: string[] = data.readingList ?? [];
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGE_EVENT, { detail: readingList }));
+  return readingList;
+}
