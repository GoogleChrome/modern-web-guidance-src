@@ -0,0 +1,19 @@
+type ToolLifecycleEvent = Event & { readonly toolName?: string };
+
+/**
+ * Calls `callback` when an agent starts using one of the named WebMCP tools.
+ * Chrome 156+ dispatches `toolactivated` on `document.modelContext`; older
+ * versions dispatch it on `window`, so feature-detect the handler property.
+ */
+export function onToolActivated(toolNames: string[], callback: (toolName: string) => void, signal: AbortSignal) {
+  const modelContext = document.modelContext;
+  const target: EventTarget = modelContext && 'ontoolactivated' in modelContext ? modelContext : window;
+  target.addEventListener(
+    'toolactivated',
+    (event) => {
+      const { toolName } = event as ToolLifecycleEvent;
+      if (toolName && toolNames.includes(toolName)) callback(toolName);
+    },
+    { signal },
+  );
+}
