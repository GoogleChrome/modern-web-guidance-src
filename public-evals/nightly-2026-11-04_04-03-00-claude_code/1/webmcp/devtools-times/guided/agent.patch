diff --git a/src/components/ArticleAgentTools.tsx b/src/components/ArticleAgentTools.tsx
new file mode 100644
index 0000000..3e94827
--- /dev/null
+++ b/src/components/ArticleAgentTools.tsx
@@ -0,0 +1,126 @@
+import { useWebMCP } from 'use-webmcp-tool';
+
+/**
+ * Article-page WebMCP tools for in-browser AI agents. Renders nothing; the
+ * tools exist only while an article is on screen and are unregistered (via
+ * the hook's AbortSignal) when the reader navigates away.
+ */
+
+interface RelatedArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+}
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  tags: string[];
+  readingTime?: number;
+  imageCaption?: string;
+  related: RelatedArticle[];
+}
+
+/** Matches the `data-article-body` wrapper around the rendered Markdown on the article page. */
+const BODY_SELECTOR = '[data-article-body]';
+const WORDS_PER_MINUTE = 230;
+const MAX_MATCHES = 10;
+
+const absoluteUrl = (path: string) => new URL(path, location.origin).href;
+const articleUrl = (slug: string) => absoluteUrl(`${import.meta.env.BASE_URL}articles/${slug}`);
+
+const getBody = () => document.querySelector<HTMLElement>(BODY_SELECTOR);
+
+/** Text blocks of the article body, in reading order. */
+const getBlocks = (body: HTMLElement) =>
+  Array.from(body.querySelectorAll<HTMLElement>('p, li, blockquote, h2, h3, h4, figcaption, td'))
+    .map(element => ({ element, text: element.innerText.trim() }))
+    .filter(block => block.text.length > 0);
+
+export default function ArticleAgentTools(props: Props) {
+  const { slug, title, summary, author, date, category, tags, readingTime, imageCaption, related } = props;
+
+  useWebMCP({
+    name: 'get_current_article',
+    description: 'Returns the article the reader is viewing: headline, byline, section, full body text and an estimated reading time. Use it to summarize, explain or answer questions about this article.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const body = getBody();
+      if (!body) {
+        return { error: 'The article body is not on the page yet. Try again in a moment.' };
+      }
+      const text = body.innerText.trim();
+      const wordCount = text ? text.split(/\s+/).length : 0;
+      return {
+        slug,
+        url: articleUrl(slug),
+        title,
+        summary,
+        author,
+        date,
+        category,
+        tags,
+        imageCaption,
+        wordCount,
+        readingTimeMinutes: readingTime ?? Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        sections: Array.from(body.querySelectorAll<HTMLElement>('h2, h3')).map(h => h.innerText.trim()).filter(Boolean),
+        body: text,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ query?: string }>({
+    name: 'find_in_article',
+    description: 'Finds the passages of the current article that mention a word or phrase and scrolls the first one into view. Use it to quote or point the reader to a specific part of the article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Word or phrase to look for, matched without regard to case.' },
+      },
+      required: ['query'],
+    },
+    execute({ query }) {
+      const needle = typeof query === 'string' ? query.trim().toLowerCase() : '';
+      if (!needle) {
+        return { error: 'Pass a word or phrase to look for.' };
+      }
+      const body = getBody();
+      if (!body) {
+        return { error: 'The article body is not on the page yet. Try again in a moment.' };
+      }
+      const blocks = getBlocks(body);
+      const matches = blocks
+        .map((block, index) => ({ ...block, position: index + 1 }))
+        .filter(block => block.text.toLowerCase().includes(needle));
+      if (matches.length === 0) {
+        return { query, totalMatches: 0, matches: [] };
+      }
+      matches[0].element.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      return {
+        query,
+        totalMatches: matches.length,
+        totalPassages: blocks.length,
+        matches: matches.slice(0, MAX_MATCHES).map(({ position, text }) => ({ position, text })),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_related_articles',
+    description: 'Returns other articles recommended alongside the one the reader is viewing. Use it to suggest what to read next.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      return related.map(article => ({ ...article, url: articleUrl(article.slug) }));
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
