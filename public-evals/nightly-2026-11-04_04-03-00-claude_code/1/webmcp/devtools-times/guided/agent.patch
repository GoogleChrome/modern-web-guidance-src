@@ -0,0 +1,127 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { navigate } from 'astro:transitions/client';
+import { fetchReadingList } from '../utils/readingList';
+
+/**
+ * Site-wide WebMCP tools for in-browser AI agents. Renders nothing; the
+ * use-webmcp-tool hook handles feature detection and unregisters each tool
+ * (via AbortSignal) when this island unmounts on page navigation.
+ */
+
+interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+  author: string;
+  date: string;
+}
+
+interface Props {
+  categories: string[];
+}
+
+const BASE_URL = import.meta.env.BASE_URL;
+const DEFAULT_LIMIT = 10;
+const MAX_LIMIT = 50;
+
+const articleUrl = (slug: string) => new URL(`${BASE_URL}articles/${slug}`, location.origin).href;
+
+async function loadArticles(signal: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`The article index returned status ${response.status}. Try again.`);
+  return response.json();
+}
+
+/** Re-throw cancellations so the agent sees them as cancelled, not as a failure message. */
+function errorResult(error: unknown, signal: AbortSignal) {
+  if (signal.aborted) throw error;
+  return { error: error instanceof Error ? error.message : String(error) };
+}
+
+export default function SiteAgentTools({ categories }: Props) {
+  useWebMCP<{ category?: string; limit?: number }>({
+    name: 'list_articles',
+    description: 'Lists the latest articles published in The DevTools Times, newest first, optionally narrowed to one section. Use it to browse what is available or to get article slugs.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: { type: 'string', enum: categories, description: 'Newspaper section to list. Omit to list every section.' },
+        limit: { type: 'integer', minimum: 1, maximum: MAX_LIMIT, default: DEFAULT_LIMIT, description: 'How many articles to return.' },
+      },
+    },
+    async execute({ category, limit = DEFAULT_LIMIT }, { signal }) {
+      if (category !== undefined && !categories.some(c => c.toLowerCase() === String(category).toLowerCase())) {
+        return { error: `Unknown category "${category}".`, categories };
+      }
+      if (!Number.isInteger(limit) || limit < 1 || limit > MAX_LIMIT) {
+        return { error: `limit must be a whole number from 1 to ${MAX_LIMIT}.` };
+      }
+      try {
+        const articles = (await loadArticles(signal))
+          .filter(a => !category || a.category.toLowerCase() === category.toLowerCase())
+          .sort((a, b) => b.date.localeCompare(a.date));
+        return {
+          totalResults: articles.length,
+          articles: articles.slice(0, limit).map(a => ({ ...a, url: articleUrl(a.slug) })),
+        };
+      } catch (error) {
+        return errorResult(error, signal);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: "Returns the articles the reader has saved to their reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_args, { signal }) {
+      try {
+        const [slugs, articles] = await Promise.all([fetchReadingList(signal), loadArticles(signal)]);
+        const saved = slugs.map(slug => {
+          const article = articles.find(a => a.slug === slug);
+          return article
+            ? { slug, title: article.title, summary: article.summary, url: articleUrl(slug) }
+            : { slug, url: articleUrl(slug) };
+        });
+        return { count: saved.length, articles: saved };
+      } catch (error) {
+        return errorResult(error, signal);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ slug?: string }>({
+    name: 'open_article',
+    description: 'Opens an article in the current tab so the reader can read it. Use after finding the article with search or list_articles.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: "The article's slug, as returned by list_articles or search-articles." },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) {
+        return { error: 'Pass the slug of the article to open.' };
+      }
+      try {
+        const articles = await loadArticles(signal);
+        const article = articles.find(a => a.slug === slug.trim());
+        if (!article) {
+          return { error: `No article with slug "${slug}".`, availableSlugs: articles.map(a => a.slug) };
+        }
+        const url = articleUrl(article.slug);
+        // Resolve only after the new page is in place, so the agent sees the updated UI.
+        await navigate(url);
+        return { opened: article.title, url };
+      } catch (error) {
+        return errorResult(error, signal);
+      }
+    },
+  });
+
+  return null;
+}
