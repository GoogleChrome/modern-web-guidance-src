+  <script>
+    // Keep aria-invalid in sync with the browser's interaction-aware
+    // :user-invalid state so screen readers aren't told about errors early.
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const sync = (input) => {
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+      form.addEventListener('blur', (e) => {
+        if (e.target.matches('input')) sync(e.target);
+      }, true);
+      // Fires on each failing control when submission is attempted
+      form.addEventListener('invalid', (e) => sync(e.target), true);
+      // Clear the error as soon as it's corrected
+      form.addEventListener('input', (e) => {
+        if (e.target.getAttribute('aria-invalid') === 'true') sync(e.target);
+      });
+    })();
+  </script>
+
