+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-error');
+      const success = document.getElementById('newsletter-success');
+      let touched = false;
+
+      function validate() {
+        let message = '';
+        if (input.validity.valueMissing) {
+          message = 'Please enter your email address.';
+        } else if (input.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        }
+        // Only reveal the error once the user has interacted with the field.
+        const show = touched && message !== '';
+        error.textContent = show ? message : '';
+        error.hidden = !show;
+        input.setAttribute('aria-invalid', show ? 'true' : 'false');
+        return message === '';
+      }
+
+      // Mark as touched when the user leaves the field.
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+
+      // Once touched, update live so the error clears as soon as it's fixed.
+      input.addEventListener('input', function () {
+        success.hidden = true;
+        if (touched) validate();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        touched = true;
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        // TODO: send to your email provider here.
+        success.textContent = "Thanks! You're on the list.";
+        success.hidden = false;
+        form.reset();
+        touched = false;
+        validate();
+      });
+    })();
+  </script>
 </body>
 
