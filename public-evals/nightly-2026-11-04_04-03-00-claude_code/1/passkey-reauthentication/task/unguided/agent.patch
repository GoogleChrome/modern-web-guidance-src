+        // 3. Send the signed assertion to the server for verification.
+        var verifyRes = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
