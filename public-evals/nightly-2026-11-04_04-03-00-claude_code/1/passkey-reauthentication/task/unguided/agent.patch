+      async function reauthenticate() {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.get) {
+          throw new Error('This browser does not support passkeys / security keys.');
+        }
+
+        // 1. Fetch a fresh, server-generated challenge scoped to the signed-in user.
+        var optRes = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: '{}'
+        });
+        if (!optRes.ok) throw new Error(await readError(optRes));
+        var optJson = await optRes.json();
+        var pkJson = optJson.publicKey || optJson.options || optJson;
+
+        if (!pkJson || !pkJson.challenge) {
+          throw new Error('Server did not return a valid challenge.');
+        }
+        // Re-auth must be bound to the current user's registered credentials;
+        // never fall back to an unscoped (discoverable / any-account) ceremony.
+        if (!Array.isArray(pkJson.allowCredentials) || pkJson.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key found for your account.');
+        }
+
+        var publicKey = toRequestOptions(pkJson);
+        // Require user verification (PIN / biometric) so possession alone is not enough.
+        publicKey.userVerification = 'required';
