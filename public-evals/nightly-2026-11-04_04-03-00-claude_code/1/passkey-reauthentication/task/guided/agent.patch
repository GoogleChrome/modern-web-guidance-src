+  <script type="module">
+    // Fills in parseRequestOptionsFromJSON / toJSON / getClientCapabilities on
+    // browsers that support WebAuthn but not these newer helpers.
+    import 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+    const button = document.querySelector('[data-testid="reauth-button"]');
+    const status = button.parentElement.querySelector('.reauth-status');
+
+    let reauthAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      status.textContent = message;
+      status.dataset.state = state;
+    }
+
+    async function reauthenticate() {
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        setStatus('This browser does not support passkeys, so your identity cannot be confirmed here.', 'error');
+        return;
+      }
+
+      // Cancel any in-flight WebAuthn request so prompts don't collide.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      try {
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Could not start verification (HTTP ${optionsResponse.status}).`);
+        }
+        const optionsJSON = await optionsResponse.json();
+
+        // Reauthentication must be scoped to the signed-in user's own
+        // credentials. An empty allowCredentials list would fall back to
+        // discoverable credentials and allow any account's passkey.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          throw new Error('No passkeys are registered for this account. Add a passkey before making sensitive changes.');
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON({
+          userVerification: 'required',
+          ...optionsJSON,
+        });
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          throw new Error('No passkey was provided.');
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now update your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+          return;
+        }
+
+        // The server no longer recognises this passkey: tell the password
+        // manager so it can hide or remove the stale credential.
+        if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: optionsJSON.rpId ?? location.hostname,
+            credentialId: encodedCredential.id,
+          }).catch(() => {});
+        }
+        throw new Error('We couldn\'t verify that passkey. Please try again.');
+      } catch (err) {
+        if (err.name === 'AbortError') return; // superseded by a newer attempt
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+        } else {
+          setStatus(err.message || 'Verification failed. Please try again.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', reauthenticate);
+  </script>
+
