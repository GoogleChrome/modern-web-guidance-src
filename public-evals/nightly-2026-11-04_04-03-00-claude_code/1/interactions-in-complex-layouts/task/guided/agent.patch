+  <script>
+    (() => {
+      const board = document.getElementById('board');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const statusEl = document.getElementById('board-status');
+      const hint = 'board-hint';
+      let nextId = 104;
+
+      // moveBefore() keeps focus/state of moved nodes; fall back to insertBefore.
+      const place = (parent, node, ref = null) =>
+        parent.moveBefore ? parent.moveBefore(node, ref) : parent.insertBefore(node, ref);
+
+      const listOf = (col) => col.querySelector('.card-list');
+      const label = (col) => col.dataset.status;
+      const nameOf = (card) => card.querySelector('h4').textContent;
+
+      // childElementCount is a DOM read only: no layout is forced.
+      const updateCount = (col) => {
+        col.querySelector('.column-count').textContent = listOf(col).childElementCount;
+      };
+
+      const announce = (msg) => { statusEl.textContent = msg; };
+
+      function createCard(drink, customer) {
+        const li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.tabIndex = 0;
+        li.setAttribute('aria-describedby', hint);
+        const h = document.createElement('h4');
+        h.textContent = drink;
+        const p = document.createElement('p');
+        p.textContent = `#${nextId++}${customer ? ' · ' + customer : ''}`;
+        li.append(h, p);
+        return li;
+      }
+
+      function moveCard(card, toCol, ref = null) {
+        const fromCol = card.closest('.board-column');
+        place(listOf(toCol), card, ref);
+        updateCount(toCol);
+        if (fromCol !== toCol) {
+          updateCount(fromCol);
+          announce(`${nameOf(card)} moved to ${label(toCol)}.`);
+        }
+      }
+
+      /* ---------- Drag & drop (delegated, rAF-coalesced) ---------- */
+      let dragged = null;
+      let overCol = null;
+      let markedCard = null;
+      let markedPos = null; // 'before' | 'after'
+      let pending = null;
+      let rafId = 0;
+
+      function clearMarkers() {
+        markedCard?.classList.remove('drop-before', 'drop-after');
+        overCol?.classList.remove('is-over');
+        markedCard = overCol = markedPos = null;
+      }
+
+      function applyHover() {
+        rafId = 0;
+        if (!pending || !dragged) return;
+        const { target, y } = pending;
+        pending = null;
+
+        const col = target.closest('.board-column');
+        if (col !== overCol) {
+          overCol?.classList.remove('is-over');
+          col?.classList.add('is-over');
+          overCol = col;
+        }
+
+        let card = target.closest('.card');
+        if (card === dragged || (card && !board.contains(card))) card = null;
+        let pos = null;
+        if (card) {
+          // Single rect read per frame; nothing has been mutated yet so layout is clean.
+          const r = card.getBoundingClientRect();
+          pos = y < r.top + r.height / 2 ? 'before' : 'after';
+        }
+        if (card !== markedCard || pos !== markedPos) {
+          markedCard?.classList.remove('drop-before', 'drop-after');
+          card?.classList.add(`drop-${pos}`);
+          markedCard = card;
+          markedPos = pos;
+        }
+      }
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest?.('.card');
+        if (!card) return;
+        dragged = card;
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', nameOf(card));
+        // Fade after the browser snapshots the drag image.
+        requestAnimationFrame(() => card.classList.add('is-dragging'));
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!dragged || !e.target.closest?.('.board-column')) return;
+        e.preventDefault();
+        e.dataTransfer.dropEffect = 'move';
+        pending = { target: e.target, y: e.clientY };
+        if (!rafId) rafId = requestAnimationFrame(applyHover);
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        if (!dragged) return;
+        // Left the board entirely.
+        if (!e.relatedTarget || !board.contains(e.relatedTarget)) {
+          pending = null;
+          clearMarkers();
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        if (!dragged) return;
+        e.preventDefault();
+        if (rafId) { cancelAnimationFrame(rafId); applyHover(); }
+        const col = overCol || e.target.closest('.board-column');
+        if (col) {
+          let ref = null;
+          if (markedCard && markedCard.closest('.board-column') === col) {
+            ref = markedPos === 'before' ? markedCard : markedCard.nextElementSibling;
+          }
+          if (ref !== dragged) moveCard(dragged, col, ref);
+        }
+        clearMarkers();
+      });
+
+      board.addEventListener('dragend', () => {
+        if (rafId) cancelAnimationFrame(rafId);
+        rafId = 0;
+        pending = null;
+        dragged?.classList.remove('is-dragging');
+        dragged = null;
+        clearMarkers();
+      });
+
+      /* ---------- Keyboard support ---------- */
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest?.('.card');
+        if (!card || e.target !== card) return;
+        const col = card.closest('.board-column');
+        const i = columns.indexOf(col);
+        let moved = true;
+
+        switch (e.key) {
+          case 'ArrowLeft':
+            if (i > 0) moveCard(card, columns[i - 1]); else moved = false;
+            break;
+          case 'ArrowRight':
+            if (i < columns.length - 1) moveCard(card, columns[i + 1]); else moved = false;
+            break;
+          case 'ArrowUp':
+            if (card.previousElementSibling) {
+              place(card.parentElement, card, card.previousElementSibling);
+              announce(`${nameOf(card)} moved up.`);
+            } else moved = false;
+            break;
+          case 'ArrowDown':
+            if (card.nextElementSibling) {
+              place(card.parentElement, card, card.nextElementSibling.nextElementSibling);
+              announce(`${nameOf(card)} moved down.`);
+            } else moved = false;
+            break;
+          default:
+            return;
+        }
+        e.preventDefault();
+        if (moved && document.activeElement !== card) card.focus();
+      });
+
+      /* ---------- Adding orders ---------- */
+      const queued = columns[0];
+      const form = document.getElementById('order-form');
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const drink = form.drink.value.trim();
+        if (!drink) return;
+        listOf(queued).append(createCard(drink, form.customer.value.trim()));
+        updateCount(queued);
+        announce(`${drink} added to queued.`);
+        form.reset();
+        form.drink.focus();
+      });
+
+      const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Flat White',
+        'Cortado', 'Chai Latte', 'Mocha', 'Americano', 'Cappuccino', 'Matcha Latte'];
+      const names = ['Ava', 'Ben', 'Chloe', 'Dev', 'Emma', 'Finn', 'Grace', 'Hiro', 'Isla', 'Jae'];
+
+      document.getElementById('rush-btn').addEventListener('click', () => {
+        // Batch into one fragment per column => one contained layout per column.
+        const frags = columns.map(() => document.createDocumentFragment());
+        for (let n = 0; n < 200; n++) {
+          frags[n % 3].append(createCard(drinks[n % drinks.length], names[(n * 7) % names.length]));
+        }
+        columns.forEach((col, k) => { listOf(col).append(frags[k]); updateCount(col); });
+        announce('200 orders added.');
+      });
+    })();
+  </script>
+
 </body>
 
