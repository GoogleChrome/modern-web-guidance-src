+  <script>
+    (() => {
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('detect-status');
+      const languageNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      let detectorPromise = null;
+
+      const setStatus = (message, isError = false) => {
+        status.textContent = message;
+        status.classList.toggle('error', isError);
+      };
+
+      const showProgress = (fraction) => {
+        const percent = Math.round(fraction * 100);
+        progress.hidden = false;
+        progress.value = percent;
+        setStatus(`Downloading language model… ${percent}%`);
+      };
+
+      if (!('LanguageDetector' in self)) {
+        button.disabled = true;
+        setStatus('Language detection is not supported in this browser.', true);
+        return;
+      }
+
+      async function getDetector() {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          throw new Error('Language detection is unavailable on this device.');
+        }
+        if (availability !== 'available') {
+          showProgress(0);
+        }
+        return LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => showProgress(e.loaded));
+          },
+        });
+      }
+
+      button.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          setStatus('Please enter a message first.', true);
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Detecting…');
+        try {
+          // Reuse the detector across clicks; retry creation if a previous attempt failed.
+          detectorPromise ??= getDetector();
+          const detector = await detectorPromise.catch((err) => {
+            detectorPromise = null;
+            throw err;
+          });
+          progress.hidden = true;
+
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            setStatus('Could not determine the language.', true);
+            return;
+          }
+          const name = languageNames.of(top.detectedLanguage) || top.detectedLanguage;
+          const confidence = (top.confidence * 100).toFixed(1);
+          setStatus(`Detected language: ${name} (${confidence}% confidence)`);
+        } catch (err) {
+          progress.hidden = true;
+          setStatus(`Detection failed: ${err.message}`, true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
