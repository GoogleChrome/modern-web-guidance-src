+  <script>
+    (async () => {
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('detect-status');
+
+      const disable = (message) => {
+        button.disabled = true;
+        status.textContent = message;
+      };
+
+      if (!('LanguageDetector' in self)) {
+        disable('Language detection is not supported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await LanguageDetector.availability();
+      } catch {
+        availability = 'unavailable';
+      }
+      if (availability === 'unavailable') {
+        disable('Language detection is unavailable on this device.');
+        return;
+      }
+
+      const displayNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      const languageName = (code) => {
+        try {
+          return displayNames.of(code) || code;
+        } catch {
+          return code;
+        }
+      };
+
+      let detectorPromise;
+      // Must be called from a user gesture: create() may trigger a model download.
+      const getDetector = () => {
+        detectorPromise ??= LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round(e.loaded * 100);
+              progress.hidden = false;
+              progress.value = percent;
+              status.textContent = `Downloading language model… ${percent}%`;
+            });
+          },
+        }).catch((err) => {
+          detectorPromise = undefined;
+          throw err;
+        });
+        return detectorPromise;
+      };
+
+      button.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          status.textContent = 'Please enter a message first.';
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        status.textContent = availability === 'available' ? 'Detecting…' : 'Preparing language model…';
+        try {
+          const detector = await getDetector();
+          availability = 'available';
+          progress.hidden = true;
+          status.textContent = 'Detecting…';
+
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            status.textContent = 'Could not determine the language. Try writing a longer message.';
+          } else {
+            const confidence = (top.confidence * 100).toFixed(1);
+            status.textContent = `Language: ${languageName(top.detectedLanguage)} (${confidence}% confidence)`;
+          }
+        } catch (err) {
+          progress.hidden = true;
+          status.textContent = `Language detection failed: ${err.message}`;
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
