+          ['Mobile', textOf('phone'), 1],
+          ['ZIP or postal code', textOf('postal-code'), 1],
+          ['Birthday', birthday, 1],
+          ['Home store', textOf('home-store'), 2],
+          ['Favorite drink', drink ? labelFor(drink) : '', 2],
