+      toggleBtn.hidden = false;
+      reviewList.hidden = false;
+
+      const controlsIn = (root) =>
+        [...root.querySelectorAll('input, select')].filter((el) => el.willValidate);
+
+      const labelFor = (el) => {
+        const label = form.querySelector(`label[for="${el.id}"]`);
