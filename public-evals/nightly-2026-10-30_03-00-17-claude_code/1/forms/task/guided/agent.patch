+        trackerItems.forEach((li, i) => {
+          li.classList.toggle('step-done', i < index);
+          if (i === index) {
+            li.setAttribute('aria-current', 'step');
+          } else {
+            li.removeAttribute('aria-current');
+          }
+          const label = steps[i].dataset.title;
+          li.textContent = i < index ? `${label} (completed)` : label;
+        });
+        backBtn.hidden = index === 0;
+        submitBtn.textContent = index === lastStep
+          ? 'Join Rewards'
+          : `Next: ${steps[index + 1].dataset.title}`;
+        if (index === lastStep) buildReview();
+        if (moveFocus) steps[index].querySelector('h3').focus();
+      };
+
+      const submitForm = async () => {
+        // Final gate: every step must be valid (the user may have edited an earlier step)
+        for (let i = 0; i < steps.length; i++) {
+          const invalid = controlsIn(steps[i]).filter((el) => !el.checkValidity());
+          if (invalid.length) {
+            showStep(i, false);
+            showErrors(steps[i], invalid);
+            return;
+          }
+        }
+
+        // Prevent double submissions
+        submitBtn.disabled = true;
+        backBtn.disabled = true;
+        submitBtn.textContent = 'Creating your account…';
+        statusEl.textContent = 'Creating your account…';
+        alertEl.textContent = '';
+
+        try {
+          const response = await fetch(form.action, {
+            method: 'POST',
+            body: new FormData(form),
+            credentials: 'same-origin',
+            headers: { Accept: 'application/json' },
+          });
+          if (!response.ok) throw new Error(`HTTP ${response.status}`);
+
+          form.hidden = true;
+          document.getElementById('rewards-progress').hidden = true;
+          document.querySelector('.form-note').hidden = true;
+          statusEl.textContent = '';
+          const result = document.getElementById('form-result');
+          result.hidden = false;
+          result.focus();
+        } catch {
+          statusEl.textContent = '';
+          alertEl.textContent = "We couldn't create your account right now. Please try again in a moment.";
+          submitBtn.disabled = false;
+          backBtn.disabled = false;
+          submitBtn.textContent = 'Join Rewards';
+        }
+      };
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (submitBtn.disabled) return;
+        if (current < lastStep) {
+          if (validateStep(current)) showStep(current + 1);
+        } else {
+          submitForm();
+        }
+      });
+
+      backBtn.addEventListener('click', () => {
+        if (current > 0) showStep(current - 1);
+      });
+
+      reviewList.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-goto]');
+        if (btn) showStep(Number(btn.dataset.goto));
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        const show = passwordInput.type === 'password';
+        passwordInput.type = show ? 'text' : 'password';
+        toggleBtn.setAttribute('aria-pressed', String(show));
+        toggleBtn.textContent = show ? 'Hide' : 'Show';
+      });
+
+      // Keep aria-invalid in step with the visible error state:
+      // set it when leaving a field, clear it as soon as the value is corrected.
+      form.addEventListener('focusout', (e) => {
+        if (e.target.willValidate) syncAria(e.target);
+      });
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+      });
+      form.addEventListener('change', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+      });
+
+      showStep(0, false);
+    })();
+  </script>
