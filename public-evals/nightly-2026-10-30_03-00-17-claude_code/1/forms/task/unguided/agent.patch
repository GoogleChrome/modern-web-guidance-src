+    (function () {
+      'use strict';
+
+      var form = document.getElementById('rewards-form');
+      if (!form || !('querySelector' in document)) return;
+
+      var steps = Array.prototype.slice.call(form.querySelectorAll('.reg-step[data-step]'));
+      var progressItems = Array.prototype.slice.call(document.querySelectorAll('#reg-progress li'));
+      var summary = document.getElementById('reg-error-summary');
+      var summaryList = document.getElementById('reg-error-list');
+      var backBtn = document.getElementById('reg-back');
+      var submitBtn = document.getElementById('reg-submit');
+      var status = document.getElementById('reg-status');
+      var review = document.getElementById('reg-review');
+      var lastStep = steps.length - 1;
+      var current = 0;
+      var submitting = false;
+      var submitLabel = submitBtn.textContent;
+
+      function $(id) { return document.getElementById(id); }
+      function val(id) { return $(id).value.trim(); }
+
+      // Each rule returns an error message, or '' when valid. `focus` is the
+      // control an error summary link should move to.
+      var rules = {
+        email: {
+          step: 0, fields: ['reg-email'], error: 'reg-email-error',
+          check: function () {
+            var el = $('reg-email');
+            if (!val('reg-email')) return 'Enter your email address';
+            if (el.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('reg-email'))) {
+              return 'Enter an email address in the correct format, like name@example.com';
+            }
+            return '';
+          }
+        },
+        password: {
+          step: 0, fields: ['reg-password'], error: 'reg-password-error',
+          check: function () {
+            var pw = $('reg-password').value;
+            if (!pw) return 'Create a password';
+            if (pw.length < 12) return 'Password must be at least 12 characters';
+            if (pw.length > 128) return 'Password must be 128 characters or fewer';
+            var localPart = val('reg-email').toLowerCase().split('@')[0];
+            if (localPart.length > 3 && pw.toLowerCase().indexOf(localPart) !== -1) {
+              return 'Password must not contain your email address';
+            }
+            return '';
+          }
+        },
+        name: {
+          step: 1, fields: ['reg-name'], error: 'reg-name-error',
+          check: function () {
+            return val('reg-name') ? '' : 'Enter your full name';
+          }
+        },
+        birthday: {
+          step: 1, fields: ['reg-bday-month', 'reg-bday-day'], error: 'reg-bday-error',
+          check: function () {
+            var m = val('reg-bday-month');
+            var d = val('reg-bday-day');
+            if (!m && !d) return '';
+            if (!m) return 'Select the month of your birthday';
+            if (!d) return 'Enter the day of your birthday';
+            var maxDay = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][Number(m) - 1];
+            if (!/^\d{1,2}$/.test(d) || Number(d) < 1 || Number(d) > maxDay) {
+              return 'Enter a day between 1 and ' + maxDay;
+            }
+            return '';
+          },
+          focus: function () { return val('reg-bday-month') ? 'reg-bday-day' : 'reg-bday-month'; }
+        },
+        phone: {
+          step: 1, fields: ['reg-phone'], error: 'reg-phone-error',
+          check: function () {
+            var p = val('reg-phone');
+            if (!p) return '';
+            var digits = p.replace(/[\s().\-]/g, '');
+            if (!/^\+?\d{10,15}$/.test(digits)) return 'Enter a mobile number, like 555 123 4567 or +44 7700 900123';
+            return '';
+          }
+        },
+        postal: {
+          step: 1, fields: ['reg-postal'], error: 'reg-postal-error',
+          check: function () {
+            var z = val('reg-postal');
+            if (z && !/^[A-Za-z0-9][A-Za-z0-9 \-]{1,8}[A-Za-z0-9]$/.test(z)) return 'Enter a valid ZIP or postal code';
+            return '';
+          }
+        },
+        sms: {
+          step: 2, fields: ['reg-optin-sms'], error: 'reg-comms-error',
+          check: function () {
+            return $('reg-optin-sms').checked && !val('reg-phone')
+              ? 'To get text messages, add a mobile number in the "About you" step' : '';
+          }
+        },
+        terms: {
+          step: 2, fields: ['reg-terms'], error: 'reg-terms-error',
+          check: function () {
+            return $('reg-terms').checked ? '' : 'You must agree to the Rewards Terms to join';
+          }
+        }
+      };
+
+      function setError(rule, message) {
+        $(rule.error).textContent = message;
+        rule.fields.forEach(function (id) {
+          if (message) $(id).setAttribute('aria-invalid', 'true');
+          else $(id).removeAttribute('aria-invalid');
+        });
+      }
+
+      function rulesFor(step) {
+        return Object.keys(rules).map(function (k) { return rules[k]; })
+          .filter(function (r) { return step === 'all' || r.step === step; });
+      }
+
+      function validate(step) {
+        var errors = [];
+        rulesFor(step).forEach(function (rule) {
+          var msg = rule.check();
+          setError(rule, msg);
+          if (msg) errors.push({ rule: rule, message: msg });
+        });
+        return errors;
+      }
+
+      function hideSummary() {
+        summary.hidden = true;
+        summaryList.textContent = '';
+      }
+
+      function showSummary(errors) {
+        summaryList.textContent = '';
+        errors.forEach(function (e) {
+          var target = e.rule.focus ? e.rule.focus() : e.rule.fields[0];
+          var li = document.createElement('li');
+          var a = document.createElement('a');
+          a.href = '#' + target;
+          a.textContent = e.message;
+          a.addEventListener('click', function (ev) {
+            ev.preventDefault();
+            if (e.rule.step !== current) goTo(e.rule.step, false);
+            $(target).focus();
+          });
+          li.appendChild(a);
+          summaryList.appendChild(li);
+        });
+        summary.hidden = false;
+        summary.focus();
+      }
+
+      // Validate a field once the user leaves it, then re-check as they type so
+      // errors clear as soon as they're fixed (but don't nag before that).
+      rulesFor('all').forEach(function (rule) {
+        rule.fields.forEach(function (id) {
+          var el = $(id);
+          var touched = false;
+          el.addEventListener('blur', function () {
+            if (el.value || touched) {
+              touched = true;
+              setError(rule, rule.check());
+            }
+          });
+          el.addEventListener(el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'input', function () {
+            if (el.getAttribute('aria-invalid') === 'true') setError(rule, rule.check());
+          });
+        });
+      });
+
+      // Show / hide password
+      var pwToggle = $('reg-password-toggle');
+      var pwInput = $('reg-password');
+      pwToggle.hidden = false;
+      pwToggle.addEventListener('click', function () {
+        var show = pwInput.type === 'password';
+        pwInput.type = show ? 'text' : 'password';
+        pwToggle.setAttribute('aria-pressed', String(show));
+        pwToggle.firstChild.nodeValue = show ? 'Hide' : 'Show';
+        status.textContent = show ? 'Your password is visible' : 'Your password is hidden';
+      });
+
+      function buildReview() {
+        var month = $('reg-bday-month');
+        var optins = [];
+        if ($('reg-optin-email').checked) optins.push('Email');
+        if ($('reg-optin-sms').checked) optins.push('Text message');
+        var rows = [
+          ['Email', val('reg-email'), 0, 'reg-email'],
+          ['Full name', val('reg-name'), 1, 'reg-name'],
+          ['Called', val('reg-nickname'), 1, 'reg-nickname'],
+          ['Birthday', month.value ? month.options[month.selectedIndex].text + ' ' + val('reg-bday-day') : '', 1, 'reg-bday-month'],
+          ['Mobile', val('reg-phone'), 1, 'reg-phone'],
+          ['ZIP / postal code', val('reg-postal').toUpperCase(), 1, 'reg-postal'],
+          ['Offers by', optins.join(', '), 2, 'reg-optin-email']
+        ];
+        review.textContent = '';
+        rows.forEach(function (row) {
+          var wrap = document.createElement('div');
+          var dt = document.createElement('dt');
+          var dd = document.createElement('dd');
+          var ddAction = document.createElement('dd');
+          var btn = document.createElement('button');
+          dt.textContent = row[0];
+          dd.textContent = row[1] || 'Not provided'; // textContent: user input is never parsed as HTML
+          btn.type = 'button';
+          btn.className = 'reg-link-btn';
+          var hidden = document.createElement('span');
+          hidden.className = 'visually-hidden';
+          hidden.textContent = ' ' + row[0].toLowerCase();
+          btn.textContent = 'Change';
+          btn.appendChild(hidden);
+          btn.addEventListener('click', function () {
+            goTo(row[2], false);
+            $(row[3]).focus();
+          });
+          ddAction.appendChild(btn);
+          wrap.appendChild(dt);
+          wrap.appendChild(dd);
+          wrap.appendChild(ddAction);
+          review.appendChild(wrap);
+        });
+      }
+
+      function goTo(index, moveFocus) {
+        current = index;
+        hideSummary();
+        steps.forEach(function (s, i) { s.hidden = i !== index; });
+        progressItems.forEach(function (li, i) {
+          li.classList.toggle('is-complete', i < index);
+          if (i === index) li.setAttribute('aria-current', 'step');
+          else li.removeAttribute('aria-current');
+        });
+        if (index === lastStep) buildReview();
+        backBtn.hidden = index === 0;
+        submitBtn.textContent = index === lastStep ? submitLabel : 'Continue';
+        if (moveFocus) {
+          // Moving focus to the new step's legend announces it to screen readers.
+          steps[index].querySelector('legend').focus({ preventScroll: true });
+          form.scrollIntoView({ block: 'start' });
+        }
+      }
+
+      // Enhance: turn the long form into steps.
+      form.noValidate = true; // custom accessible messages replace native bubbles
+      form.classList.add('js-enabled');
+      $('reg-progress').hidden = false;
+      steps.forEach(function (s, i) {
+        s.querySelector('.reg-step-count').textContent = 'Step ' + (i + 1) + ' of ' + steps.length + ': ';
+      });
+      goTo(0, false);
+
+      backBtn.addEventListener('click', function () {
+        if (current > 0) goTo(current - 1, true);
+      });
+
+      // A single submit button means pressing Enter in any field advances the
+      // current step, and only the final step actually posts the form.
+      form.addEventListener('submit', function (ev) {
+        if (submitting) { ev.preventDefault(); return; }
+
+        if (current < lastStep) {
+          ev.preventDefault();
+          var stepErrors = validate(current);
+          if (stepErrors.length) showSummary(stepErrors);
+          else goTo(current + 1, true);
+          return;
+        }
+
+        var allErrors = validate('all');
+        if (allErrors.length) {
+          ev.preventDefault();
+          goTo(allErrors[0].rule.step, false);
+          showSummary(allErrors);
+          return;
+        }
+
+        // Normalise before sending; the server must still validate everything.
+        $('reg-email').value = val('reg-email');
+        $('reg-postal').value = val('reg-postal').toUpperCase();
+        pwInput.type = 'password';
+
+        submitting = true;
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Creating your account…';
+        form.setAttribute('aria-busy', 'true');
+        status.textContent = 'Creating your account, please wait.';
+      });
+
+      // Re-enable if the user navigates back to a cached copy of the page.
+      window.addEventListener('pageshow', function (ev) {
+        if (ev.persisted && submitting) {
+          submitting = false;
+          submitBtn.disabled = false;
+          form.removeAttribute('aria-busy');
+          goTo(lastStep, false);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
