+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count():
+    // expose 1-based index and count as custom properties, and keep them
+    // in sync when items are added or removed.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const update = () => {
+        const parents = new Set([...document.querySelectorAll(selector)].map((el) => el.parentElement));
+        parents.forEach((parent) => {
+          const siblings = [...parent.children];
+          siblings.forEach((el, i) => {
+            el.style.setProperty('--sibling-index', i + 1);
+            el.style.setProperty('--sibling-count', siblings.length);
+          });
+        });
+      };
+      update();
+      new MutationObserver(update).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
