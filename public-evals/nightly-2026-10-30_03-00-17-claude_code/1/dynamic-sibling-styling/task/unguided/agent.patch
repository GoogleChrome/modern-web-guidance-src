+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count():
+    // expose each item's position and group size as --i / --n, and keep
+    // them in sync if items are added or removed later.
+    if (!CSS.supports('z-index', 'sibling-index()')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const index = () => {
+        document.querySelectorAll(selector).forEach((el) => {
+          const siblings = el.parentElement.children;
+          el.style.setProperty('--i', Array.prototype.indexOf.call(siblings, el) + 1);
+          el.style.setProperty('--n', siblings.length);
+        });
+      };
+      index();
+      new MutationObserver(index).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
+
