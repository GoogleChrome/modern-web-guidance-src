+    /* ---------------------------------------------------------------
+       Index-aware layouts
+       Every item reads its position (--i, 1-based) and the size of its
+       group (--n) from sibling-index() / sibling-count(), so adding or
+       removing items in the markup re-flows colors, fan angles and
+       circle positions automatically. A tiny script below supplies the
+       same variables in browsers that don't support these functions yet.
+       --------------------------------------------------------------- */
+    @supports (z-index: sibling-index()) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        --i: sibling-index();
+        --n: sibling-count();
+      }
+    }
+
+    /* Spectrum cards: hues spread evenly around the color wheel */
+    .spectrum-card {
+      --hue: calc((var(--i) - 1) / var(--n) * 360deg + 30deg);
