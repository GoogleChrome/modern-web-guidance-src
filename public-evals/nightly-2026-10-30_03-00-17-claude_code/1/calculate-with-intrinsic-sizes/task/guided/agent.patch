@@ -134,8 +136,108 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Promo Badge */
+    .promo-badge {
+      display: block;
+      margin: 0 auto 10px;
+      padding: 4px 12px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      text-align: center;
+      white-space: nowrap;
+      border-radius: 999px;
+      /* Fallback for browsers without calc-size() */
+      inline-size: max-content;
+      min-inline-size: 100px;
+      max-inline-size: 100%;
+      /* 1.2x the max-content size, clamped between 100px and the parent's full width */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Sourcing Accordion */
+    .accordion {
+      margin-top: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding: 20px;
+      background: none;
+      border: 0;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+      transition: rotate 0.3s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::after {
+      rotate: 45deg;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    /*
+      Note: directly transitioning between two different intrinsic keyword sizes
+      (e.g. min-content -> max-content, or auto -> fit-content) isn't supported.
+      One end of the transition must be a fixed length or percentage, which is
+      why the collapsed state uses block-size: 0.
+    */
+    .accordion-content {
+      overflow: hidden;
+      block-size: 0;
+      visibility: hidden;
+      /* visibility flips discretely at the end when collapsing, so content stays visible while it animates closed */
+      transition: block-size 0.4s ease, visibility 0.4s;
+    }
+
+    .accordion-content.open {
+      visibility: visible;
+      /* Fallback for browsers without calc-size() */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    .accordion-inner {
+      padding: 0 20px;
+    }
+
+    .accordion-inner p+p {
+      margin-top: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .accordion-content,
+      #accordion-toggle::after {
+        transition: none;
+      }
+    }
+
