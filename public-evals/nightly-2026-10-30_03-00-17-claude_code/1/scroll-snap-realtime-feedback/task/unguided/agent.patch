+  <script>
+    (function () {
+      var gallery = document.getElementById('gallery');
+      var items = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-item'));
+      var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumbnail'));
+      var supportsSnapChanging = 'onscrollsnapchanging' in window;
+      var supportsScrollEnd = 'onscrollend' in window;
+      var activeIndex = 0;
+      var pendingIndex = -1;
+      var clickTarget = -1; // locks the pending thumbnail during a thumbnail-initiated scroll
+      var rafId = 0;
+      var endTimer = 0;
+
+      // Index of the item whose center is closest to the gallery's center.
+      function nearestIndex() {
+        var rect = gallery.getBoundingClientRect();
+        var center = rect.left + rect.width / 2;
+        var best = 0;
+        var bestDist = Infinity;
+        items.forEach(function (item, i) {
+          var r = item.getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = i;
+          }
+        });
+        return best;
+      }
+
+      function setPending(i) {
+        if (i < 0 || i === pendingIndex) return;
+        if (pendingIndex >= 0) thumbs[pendingIndex].classList.remove('pending');
+        thumbs[i].classList.add('pending');
+        pendingIndex = i;
+      }
+
+      function commit() {
+        var i = nearestIndex();
+        clickTarget = -1;
+        if (pendingIndex >= 0) thumbs[pendingIndex].classList.remove('pending');
+        pendingIndex = -1;
+        thumbs[activeIndex].classList.remove('active');
+        thumbs[activeIndex].removeAttribute('aria-current');
+        thumbs[i].classList.add('active');
+        thumbs[i].setAttribute('aria-current', 'true');
+        activeIndex = i;
+      }
+
+      // Native snap-target prediction where supported (accounts for fling velocity).
+      if (supportsSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          if (clickTarget >= 0) return;
+          setPending(items.indexOf(e.snapTargetInline));
+        });
+      }
+
+      gallery.addEventListener('scroll', function () {
+        if (!supportsSnapChanging && clickTarget < 0 && !rafId) {
+          rafId = requestAnimationFrame(function () {
+            rafId = 0;
+            if (clickTarget < 0) setPending(nearestIndex());
+          });
+        }
+        if (!supportsScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(commit, 150);
+        }
+      }, { passive: true });
+
+      if (supportsScrollEnd) gallery.addEventListener('scrollend', commit);
+
+      // A user gesture overrides an in-flight thumbnail scroll.
+      ['pointerdown', 'wheel', 'touchstart'].forEach(function (type) {
+        gallery.addEventListener(type, function () { clickTarget = -1; }, { passive: true });
+      });
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          var left = items[i].offsetLeft - (gallery.clientWidth - items[i].offsetWidth) / 2;
+          if (Math.abs(gallery.scrollLeft - left) < 1) {
+            commit();
+            return;
+          }
+          clickTarget = i;
+          setPending(i);
+          gallery.scrollTo({ left: left });
+        });
+      });
+    })();
+  </script>
+
