+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Highlight the thumbnail the user is swiping towards.
+    const setPending = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+      thumbnails[index].classList.add('pending');
+    };
+
+    // Promote the settled item's thumbnail to active and clear pending.
+    const setActive = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumb) => {
+        thumb.classList.remove('pending', 'active');
+        thumb.removeAttribute('aria-current');
+      });
+      thumbnails[index].classList.add('active');
+      thumbnails[index].setAttribute('aria-current', 'true');
+    };
+
+    // Items snap to center, so pick the item whose center is nearest the scrollport's center.
+    // #gallery is position: relative, which makes it the items' offsetParent.
+    const findClosestItemIndex = () => {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      let closestIndex = 0;
+      let minDistance = Infinity;
+      items.forEach((item, index) => {
+        const distance = Math.abs(center - (item.offsetLeft + item.offsetWidth / 2));
+        if (distance < minDistance) {
+          minDistance = distance;
+          closestIndex = index;
+        }
+      });
+      return closestIndex;
+    };
+
+    if ('onscrollsnapchanging' in Element.prototype) {
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        setPending(items.indexOf(event.snapTargetInline));
+      });
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        setActive(items.indexOf(event.snapTargetInline));
+      });
+    } else {
+      // Fallback: emulate snap prediction with scroll + rAF, settle on scrollend (or a debounce).
+      let rafId = null;
+      let scrollTimeout;
+      const settle = () => setActive(findClosestItemIndex());
+
+      gallery.addEventListener('scroll', () => {
+        if (!rafId) {
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            setPending(findClosestItemIndex());
+          });
+        }
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(settle, 100);
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', () => {
+        clearTimeout(scrollTimeout);
+        settle();
+      });
+    }
+
+    thumbnails.forEach((thumb, index) => {
+      thumb.addEventListener('click', () => {
+        const item = items[index];
+        // Scroll only the gallery (scrollIntoView would also scroll the page vertically).
+        gallery.scrollTo({
+          left: item.offsetLeft - (gallery.clientWidth - item.offsetWidth) / 2,
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+        });
+      });
+    });
+
+    // Sync with any restored scroll position; no snap/scroll event fires for it.
+    if (document.readyState === 'complete') {
+      setActive(findClosestItemIndex());
+    } else {
+      window.addEventListener('load', () => setActive(findClosestItemIndex()), { once: true });
+    }
+  </script>
+
