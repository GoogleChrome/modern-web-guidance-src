+      <div class="dialog-actions">
+        <button type="submit" class="btn btn-small btn-outline" value="cancel" autofocus>Cancel</button>
+        <button type="submit" class="btn btn-small btn-danger" value="delete">Delete</button>
+      </div>
+    </form>
+  </dialog>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/account/passkeys.js b/account/passkeys.js
new file mode 100644
index 0000000..28e5ba7
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,299 @@
+// Passkey + profile management for the My Account page.
+//
+// Expected backend API (all endpoints require a signed-in session cookie):
+//   GET    /api/user                           -> { id, name, displayName }  (id is the Base64URL WebAuthn user handle)
+//   PUT    /api/user                { name, displayName }
+//   GET    /api/credentials                    -> [{ id, name, aaguid, providerIcon?, registeredAt, lastUsedAt? }]
+//   PUT    /api/credential/:id      { name }
+//   DELETE /api/credential/:id
+//   POST   /api/passkey/registration-options  -> PublicKeyCredentialCreationOptionsJSON
+//   POST   /api/passkey/registration-verify   <- credential.toJSON()
+
+// Must match the RP ID the server uses when generating WebAuthn options.
+const RP_ID = location.hostname;
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const DEFAULT_ICON = 'data:image/svg+xml,' + encodeURIComponent(
+  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#4e342e">' +
+  '<path d="M12.65 10A6 6 0 1 0 12.65 14H17v4h4v-4h2v-4H12.65zM7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>'
+);
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+const $ = (selector) => document.querySelector(selector);
+const list = $('#passkey-list');
+const rowTemplate = $('#passkey-row');
+const passkeyStatus = $('#passkey-status');
+const profileStatus = $('#profile-status');
+const profileForm = $('#profile-form');
+const createButton = $('#create-passkey');
+const renameDialog = $('#rename-dialog');
+const deleteDialog = $('#delete-dialog');
+
+let currentUser = null;
+let credentials = [];
+
+const webauthnSupported = 'PublicKeyCredential' in window;
+
+// Older browsers that have WebAuthn but lack the JSON helpers / getClientCapabilities.
+if (webauthnSupported && !PublicKeyCredential.parseCreationOptionsFromJSON) {
+  await import('https://unpkg.com/webauthn-polyfills');
+}
+
+async function api(path, { method = 'GET', body } = {}) {
+  const response = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (response.status === 401) {
+    location.assign(`/login?next=${encodeURIComponent(location.pathname)}`);
+    throw new Error('Not signed in');
+  }
+  if (!response.ok) {
+    throw new Error(`${method} ${path} failed with ${response.status}`);
+  }
+  return response.status === 204 ? null : response.json();
+}
+
+function setStatus(element, message, tone = 'info') {
+  element.textContent = message;
+  element.dataset.tone = tone;
+}
+
+// Resolves with the dialog's returnValue once it closes (Esc resolves with '').
+function openDialog(dialog) {
+  dialog.returnValue = '';
+  dialog.showModal();
+  return new Promise((resolve) => {
+    dialog.addEventListener('close', () => resolve(dialog.returnValue), { once: true });
+  });
+}
+
+// --- Signal API: keep the user's passkey provider in sync with the server ---
+
+async function signalAcceptedCredentials() {
+  if (!webauthnSupported || !PublicKeyCredential.signalAllAcceptedCredentials || !currentUser) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: RP_ID,
+      userId: currentUser.id,
+      allAcceptedCredentialIds: credentials.map((c) => c.id),
+    });
+  } catch (err) {
+    console.error('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+async function signalUserDetails() {
+  if (!webauthnSupported || !PublicKeyCredential.signalCurrentUserDetails || !currentUser) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: RP_ID,
+      userId: currentUser.id,
+      name: currentUser.name,
+      displayName: currentUser.displayName,
+    });
+  } catch (err) {
+    console.error('signalCurrentUserDetails failed:', err);
+  }
+}
+
+async function signalUnknownCredential(credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId: RP_ID, credentialId });
+  } catch (err) {
+    console.error('signalUnknownCredential failed:', err);
+  }
+}
+
+// --- Rendering ---
+
+function safeIcon(src) {
+  return typeof src === 'string' && /^(data:image\/|https:\/\/)/.test(src) ? src : DEFAULT_ICON;
+}
+
+function credentialLabel(credential) {
+  if (credential.name) return credential.name;
+  return credential.aaguid === ZERO_AAGUID ? 'Unknown passkey provider' : 'Passkey';
+}
+
+function renderCredentials() {
+  list.setAttribute('aria-busy', 'false');
+  if (credentials.length === 0) {
+    const empty = document.createElement('li');
+    empty.className = 'empty-state';
+    empty.textContent = 'No passkeys found. Create one to sign in faster next time.';
+    list.replaceChildren(empty);
+    return;
+  }
+
+  list.replaceChildren(...credentials.map((credential) => {
+    const row = rowTemplate.content.firstElementChild.cloneNode(true);
+    const name = credentialLabel(credential);
+    row.dataset.id = credential.id;
+    row.querySelector('.passkey-icon').src = safeIcon(credential.providerIcon);
+    row.querySelector('.passkey-name').textContent = name;
+    row.querySelector('.passkey-created').textContent =
+      `Created ${dateFormat.format(new Date(credential.registeredAt))}`;
+    row.querySelector('.passkey-used').textContent = credential.lastUsedAt
+      ? `Last used ${dateFormat.format(new Date(credential.lastUsedAt))}`
+      : 'Never used';
+    row.querySelector('[data-action="rename"]').setAttribute('aria-label', `Rename ${name}`);
+    row.querySelector('[data-action="delete"]').setAttribute('aria-label', `Delete ${name}`);
+    return row;
+  }));
+}
+
+async function loadCredentials() {
+  credentials = await api('/api/credentials');
+  renderCredentials();
+}
+
+// --- Passkey actions ---
+
+async function renameCredential(credential) {
+  const input = renameDialog.querySelector('input[name="name"]');
+  input.value = credentialLabel(credential);
+  if (await openDialog(renameDialog) !== 'save') return;
+
+  const newName = input.value.trim();
+  if (!newName || newName === credential.name) return;
+  try {
+    // Nicknames are a server-side label only; nothing to signal to the provider.
+    await api(`/api/credential/${encodeURIComponent(credential.id)}`, { method: 'PUT', body: { name: newName } });
+    await loadCredentials();
+    setStatus(passkeyStatus, `Passkey renamed to “${newName}”.`);
+  } catch (err) {
+    console.error(err);
+    setStatus(passkeyStatus, 'Could not rename that passkey. Please try again.', 'error');
+  }
+}
+
+async function deleteCredential(credential) {
+  const name = credentialLabel(credential);
+  deleteDialog.querySelector('.delete-name').textContent = name;
+  if (await openDialog(deleteDialog) !== 'delete') return;
+
+  try {
+    await api(`/api/credential/${encodeURIComponent(credential.id)}`, { method: 'DELETE' });
+    await loadCredentials();
+    setStatus(passkeyStatus, `“${name}” was deleted.`);
+  } catch (err) {
+    console.error(err);
+    setStatus(passkeyStatus, 'Could not delete that passkey. Please try again.', 'error');
+    return;
+  }
+  // Tell the provider which credentials are still valid so the deleted one disappears from its UI.
+  await signalAcceptedCredentials();
+}
+
+async function createPasskey() {
+  createButton.disabled = true;
+  try {
+    const optionsJSON = await api('/api/passkey/registration-options', { method: 'POST', body: { promotion: false } });
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+    let credential;
+    try {
+      credential = await navigator.credentials.create({ publicKey });
+    } catch (err) {
+      if (err.name === 'InvalidStateError') {
+        setStatus(passkeyStatus, 'You already have a passkey for this account on that device.', 'error');
+      } else if (err.name === 'SecurityError') {
+        console.error('RP ID or secure context misconfiguration:', err);
+        setStatus(passkeyStatus, 'Passkeys are unavailable on this page right now.', 'error');
+      } else if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+        throw err;
+      }
+      return;
+    }
+
+    const encoded = credential.toJSON();
+    try {
+      await api('/api/passkey/registration-verify', { method: 'POST', body: encoded });
+    } catch (err) {
+      // The authenticator saved a credential the server rejected; ask the provider to drop it.
+      console.error(err);
+      await signalUnknownCredential(encoded.id);
+      setStatus(passkeyStatus, 'Could not save your new passkey. Please try again.', 'error');
+      return;
+    }
+    await loadCredentials();
+    setStatus(passkeyStatus, 'Passkey created.');
+  } catch (err) {
+    console.error(err);
+    setStatus(passkeyStatus, 'Something went wrong creating your passkey.', 'error');
+  } finally {
+    createButton.disabled = false;
+  }
+}
+
+list.addEventListener('click', (event) => {
+  const button = event.target.closest('button[data-action]');
+  if (!button) return;
+  const credential = credentials.find((c) => c.id === button.closest('.passkey').dataset.id);
+  if (!credential) return;
+  if (button.dataset.action === 'rename') renameCredential(credential);
+  else deleteCredential(credential);
+});
+
+createButton.addEventListener('click', createPasskey);
+
+// --- Profile ---
+
+profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const data = new FormData(profileForm);
+  const name = data.get('name').trim();
+  const displayName = data.get('displayName').trim();
+  const submit = profileForm.querySelector('button[type="submit"]');
+  submit.disabled = true;
+  try {
+    currentUser = { ...currentUser, ...await api('/api/user', { method: 'PUT', body: { name, displayName } }) };
+    setStatus(profileStatus, 'Profile saved.');
+  } catch (err) {
+    console.error(err);
+    setStatus(profileStatus, 'Could not save your profile. Please try again.', 'error');
+    return;
+  } finally {
+    submit.disabled = false;
+  }
+  await signalUserDetails();
+});
+
+// --- Init ---
+
+async function setUpCreateButton() {
+  if (!webauthnSupported) {
+    $('#passkeys-unsupported').hidden = false;
+    return;
+  }
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  if (capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet) {
+    createButton.hidden = false;
+  } else {
+    $('#passkeys-unsupported').hidden = false;
+  }
+}
+
+async function init() {
+  setUpCreateButton().catch((err) => console.error(err));
+  try {
+    currentUser = await api('/api/user');
+    profileForm.elements.name.value = currentUser.name ?? '';
+    profileForm.elements.displayName.value = currentUser.displayName ?? '';
+    await loadCredentials();
+  } catch (err) {
+    console.error(err);
+    list.setAttribute('aria-busy', 'false');
+    setStatus(passkeyStatus, 'We couldn’t load your passkeys. Please refresh the page.', 'error');
+    return;
+  }
+  // Remove any passkeys the provider still holds that the server no longer accepts.
+  await signalAcceptedCredentials();
+}
+
+init();
diff --git a/css/site.css b/css/site.css
new file mode 100644
