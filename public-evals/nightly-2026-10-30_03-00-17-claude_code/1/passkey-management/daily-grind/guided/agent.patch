+    .panel-head {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: flex-start;
+      gap: 12px;
+    }
+
+    button.btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    button.btn:disabled {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+
+    .btn-small {
+      padding: 6px 14px;
+      margin-top: 0;
+      font-size: 0.85rem;
