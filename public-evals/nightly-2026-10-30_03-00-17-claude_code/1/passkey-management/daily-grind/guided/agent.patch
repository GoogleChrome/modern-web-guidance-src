+      </p>
+      <ul id="passkey-list" class="passkey-list" aria-busy="true"></ul>
+      <p id="passkey-status" class="status" role="status"></p>
+    </section>
+  </main>
+
+  <template id="passkey-row">
+    <li class="passkey">
+      <img class="passkey-icon" alt="" width="40" height="40">
+      <div>
+        <div class="passkey-name"></div>
+        <div class="passkey-meta passkey-created"></div>
+        <div class="passkey-meta passkey-used"></div>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn btn-small btn-outline" data-action="rename">Rename</button>
+        <button type="button" class="btn btn-small btn-danger" data-action="delete">Delete</button>
+      </div>
+    </li>
+  </template>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-heading">
+    <form method="dialog">
+      <h3 id="rename-heading">Rename passkey</h3>
+      <label>
+        Passkey name
+        <input name="name" required maxlength="64" autocomplete="off">
+      </label>
+      <div class="dialog-actions">
+        <button type="submit" class="btn btn-small btn-outline" value="cancel" formnovalidate>Cancel</button>
+        <button type="submit" class="btn btn-small" value="save">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="delete-dialog" aria-labelledby="delete-heading">
+    <form method="dialog">
+      <h3 id="delete-heading">Delete passkey?</h3>
