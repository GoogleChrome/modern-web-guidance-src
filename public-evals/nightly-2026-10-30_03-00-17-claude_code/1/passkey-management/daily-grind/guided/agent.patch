+
+    .btn-outline:hover {
+      background: var(--secondary);
+    }
+
+    .btn-danger {
+      background: #b3261e;
+    }
+
+    .btn-danger:hover {
+      background: #8c1d18;
+    }
+
+    :is(.btn, input):focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .passkey-list {
+      list-style: none;
+      border-top: 1px solid var(--secondary);
+    }
+
+    .passkey {
+      display: grid;
+      grid-template-columns: 40px 1fr auto;
+      align-items: center;
+      gap: 16px;
+      padding: 16px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .passkey-icon {
+      width: 40px;
+      height: 40px;
+      object-fit: contain;
+    }
