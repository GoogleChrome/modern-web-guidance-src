+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty, isJsonRequest, json } from '../../../lib/auth';
+
+// Discoverable-credential sign in: the authenticator tells us who the user is.
+export const POST: APIRoute = async (context) => {
+  if (!isJsonRequest(context.request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const options = await generateAuthenticationOptions({
+    rpID: getRelyingParty(context.url).rpID,
+    userVerification: 'preferred',
+  });
+
+  context.session?.set('passkeyChallenge', { challenge: options.challenge, purpose: 'authentication' });
+  return json(options);
+};
