@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { json, readJson, signIn } from '../../../lib/auth';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Verifies credentials against the accounts service server-side so the
+// session can be trusted by account settings.
+export const POST: APIRoute = async (context) => {
+  const body = await readJson(context.request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let response: Response;
+  try {
+    response = await fetch(LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Accounts service unavailable' }, 502);
+  }
+
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    return json({ error: data.error || 'Unknown error', message: data.message }, response.status);
+  }
+
+  await signIn(context, username);
+  return json({ username });
+};
