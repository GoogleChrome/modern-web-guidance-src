diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..4e77a2c
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,329 @@
+import React, { useEffect, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon, CloudIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+import { browserSupportsWebAuthn, startRegistration } from '@simplewebauthn/browser';
+import { syncAuthenticator } from '../lib/passkeySignals';
+
+interface Passkey {
+  id: string;
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Account {
+  rpID: string;
+  userID: string;
+  username: string;
+}
+
+const MAX_NAME_LENGTH = 64;
+const api = `${import.meta.env.BASE_URL}api/passkeys`;
+const jsonHeaders = { 'Content-Type': 'application/json' };
+
+function formatDate(iso: string | null) {
+  if (!iso) return 'Never';
+  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+}
+
+async function readError(response: Response) {
+  const data = await response.json().catch(() => ({}));
+  return data.error || `Request failed (${response.status})`;
+}
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [supported, setSupported] = useState(true);
+  const [adding, setAdding] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+
+  const sync = (acct: Account, credentialIDs: string[]) =>
+    syncAuthenticator({ ...acct, credentialIDs });
+
+  useEffect(() => {
+    setSupported(browserSupportsWebAuthn());
+    (async () => {
+      try {
+        const response = await fetch(api);
+        if (!response.ok) throw new Error(await readError(response));
+        const data = await response.json();
+        const acct = { rpID: data.rpID, userID: data.userID, username: data.username };
+        setAccount(acct);
+        setPasskeys(data.passkeys);
+        // Clean up passkeys removed elsewhere (e.g. on another device).
+        sync(acct, data.passkeys.map((p: Passkey) => p.id));
+      } catch (err) {
+        setError((err as Error).message);
+      } finally {
+        setLoading(false);
+      }
+    })();
+  }, []);
+
+  const resetMessages = () => {
+    setError(null);
+    setSuccess(null);
+  };
+
+  const handleAdd = async () => {
+    if (!account) return;
+    resetMessages();
+    setAdding(true);
+    try {
+      const optionsResponse = await fetch(`${api}/register-options`, { method: 'POST', headers: jsonHeaders, body: '{}' });
+      if (!optionsResponse.ok) throw new Error(await readError(optionsResponse));
+      const optionsJSON = await optionsResponse.json();
+
+      let registration;
+      try {
+        registration = await startRegistration({ optionsJSON });
+      } catch (err) {
+        const name = (err as Error).name;
+        if (name === 'NotAllowedError') return; // user dismissed the prompt
+        if (name === 'InvalidStateError') throw new Error('This authenticator already has a passkey for your account.');
+        throw err;
+      }
+
+      const verifyResponse = await fetch(`${api}/register-verify`, {
+        method: 'POST',
+        headers: jsonHeaders,
+        body: JSON.stringify({ response: registration }),
+      });
+      if (!verifyResponse.ok) throw new Error(await readError(verifyResponse));
+      const data = await verifyResponse.json();
+      setPasskeys((prev) => [...prev, data.passkey]);
+      sync(account, data.allAcceptedCredentialIDs);
+      setSuccess('Passkey added. Give it a name so you can recognize it later.');
+      setEditingId(data.passkey.id);
+      setDraftName(data.passkey.name);
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const startEditing = (passkey: Passkey) => {
+    resetMessages();
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    resetMessages();
+    const name = draftName.trim();
+    if (!name) {
+      setError('Passkey name cannot be empty.');
+      return;
+    }
+    if (name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    setBusyId(passkey.id);
+    try {
+      const response = await fetch(`${api}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PATCH',
+        headers: jsonHeaders,
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) throw new Error(await readError(response));
+      const data = await response.json();
+      setPasskeys((prev) => prev.map((p) => (p.id === passkey.id ? data.passkey : p)));
+      setEditingId(null);
+      setSuccess('Passkey renamed.');
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleDelete = async (passkey: Passkey) => {
+    if (!account) return;
+    resetMessages();
+    setBusyId(passkey.id);
+    try {
+      const response = await fetch(`${api}/${encodeURIComponent(passkey.id)}`, {
+        method: 'DELETE',
+        headers: jsonHeaders,
+      });
+      if (!response.ok) throw new Error(await readError(response));
+      const data = await response.json();
+      setPasskeys((prev) => prev.filter((p) => p.id !== passkey.id));
+      setConfirmDeleteId(null);
+      // Ask the authenticator to stop offering the removed passkey.
+      await sync(account, data.allAcceptedCredentialIDs);
+      setSuccess(`"${passkey.name}" was removed. You may also delete it from your password manager.`);
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">Passkeys</h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Sign in with your fingerprint, face, screen lock or security key instead of a password.
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleAdd}
+          disabled={!supported || adding || loading || !account}
+          className="inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed whitespace-nowrap"
+        >
+          <KeyIcon className="h-4 w-4" />
+          {adding ? 'Waiting for passkey...' : 'Add a passkey'}
+        </button>
+      </div>
+
+      {!supported && (
+        <div className="mb-4 p-3 text-sm text-amber-800 bg-amber-100 rounded-lg" role="status">
+          This browser doesn't support passkeys. You can still rename or remove existing ones.
+        </div>
+      )}
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {success && (
+        <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {success}
+        </div>
+      )}
+
+      {loading ? (
+        <p className="text-sm text-gray-500">Loading passkeys...</p>
+      ) : passkeys.length === 0 ? (
+        <div className="py-8 text-center border border-dashed border-gray-300 rounded-lg">
+          <KeyIcon className="h-8 w-8 mx-auto text-gray-400" />
+          <p className="mt-2 text-sm text-gray-600">You haven't added any passkeys yet.</p>
+        </div>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+          {passkeys.map((passkey) => {
+            const busy = busyId === passkey.id;
+            const SyncIcon = passkey.backedUp ? CloudIcon : DevicePhoneMobileIcon;
+            return (
+              <li key={passkey.id} className="p-4">
+                {editingId === passkey.id ? (
+                  <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-col sm:flex-row gap-2">
+                    <label htmlFor={`passkey-name-${passkey.id}`} className="sr-only">
+                      Passkey name
+                    </label>
+                    <input
+                      id={`passkey-name-${passkey.id}`}
+                      type="text"
+                      value={draftName}
+                      onChange={(e) => setDraftName(e.target.value)}
+                      maxLength={MAX_NAME_LENGTH}
+                      required
+                      autoFocus
+                      onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                      className="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                    />
+                    <div className="flex gap-2">
+                      <button
+                        type="submit"
+                        disabled={busy}
+                        className="py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+                      >
+                        {busy ? 'Saving...' : 'Save'}
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="py-2 px-3 rounded-md text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200"
+                      >
+                        Cancel
+                      </button>
+                    </div>
+                  </form>
+                ) : (
+                  <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
+                    <div className="flex items-start gap-3 min-w-0">
+                      <KeyIcon className="h-6 w-6 text-gray-500 shrink-0 mt-0.5" />
+                      <div className="min-w-0">
+                        <p className="font-semibold text-gray-900 break-words">{passkey.name}</p>
+                        <p className="text-xs text-gray-500 mt-0.5">
+                          Added {formatDate(passkey.createdAt)} · Last used {formatDate(passkey.lastUsedAt)}
+                        </p>
+                        <p className="text-xs text-gray-500 mt-0.5 inline-flex items-center gap-1">
+                          <SyncIcon className="h-3.5 w-3.5" />
+                          {passkey.backedUp ? 'Synced across your devices' : 'Stored on a single device'}
+                        </p>
+                      </div>
+                    </div>
+
+                    {confirmDeleteId === passkey.id ? (
+                      <div className="flex items-center gap-2 text-sm" role="group" aria-label={`Confirm removing ${passkey.name}`}>
+                        <span className="text-gray-700">Remove this passkey?</span>
+                        <button
+                          type="button"
+                          onClick={() => handleDelete(passkey)}
+                          disabled={busy}
+                          className="py-1.5 px-3 rounded-md font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-60"
+                        >
+                          {busy ? 'Removing...' : 'Remove'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setConfirmDeleteId(null)}
+                          disabled={busy}
+                          className="py-1.5 px-3 rounded-md font-medium text-gray-700 bg-gray-100 hover:bg-gray-200"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    ) : (
+                      <div className="flex items-center gap-1 shrink-0">
+                        <button
+                          type="button"
+                          onClick={() => startEditing(passkey)}
+                          className="inline-flex items-center gap-1 py-1.5 px-2 rounded-md text-sm text-gray-700 hover:bg-gray-100"
+                        >
+                          <PencilSquareIcon className="h-4 w-4" />
+                          Rename<span className="sr-only"> {passkey.name}</span>
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            resetMessages();
+                            setEditingId(null);
+                            setConfirmDeleteId(passkey.id);
+                          }}
+                          className="inline-flex items-center gap-1 py-1.5 px-2 rounded-md text-sm text-red-600 hover:bg-red-50"
+                        >
+                          <TrashIcon className="h-4 w-4" />
+                          Remove<span className="sr-only"> {passkey.name}</span>
+                        </button>
+                      </div>
+                    )}
+                  </div>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+}
