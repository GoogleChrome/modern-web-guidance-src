new file mode 100644
index 0000000..4c26369
--- /dev/null
+++ b/src/pages/api/passkeys/login-verify.ts
@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { getRelyingParty, json, readJson, signIn } from '../../../lib/auth';
+import { findPasskeyByCredentialID, recordPasskeyUse } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async (context) => {
+  const body = await readJson(context.request);
+  const response = body?.response as any;
+  const expected = await context.session?.get('passkeyChallenge');
+  context.session?.delete('passkeyChallenge');
+  if (typeof response?.id !== 'string' || expected?.purpose !== 'authentication') {
+    return json({ error: 'No passkey sign in in progress' }, 400);
+  }
+
+  const { rpID, origin } = getRelyingParty(context.url);
+  const match = await findPasskeyByCredentialID(response.id);
+  if (!match) {
+    // Lets the client ask the authenticator to hide this orphaned passkey.
+    return json({ error: 'This passkey is no longer registered', unknownCredential: true, rpID }, 404);
+  }
+  const userHandle = response.response?.userHandle;
+  if (userHandle && userHandle !== match.user.userID) {
+    return json({ error: 'Passkey could not be verified' }, 400);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: expected.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: match.passkey.id,
+        publicKey: Buffer.from(match.passkey.publicKey, 'base64url'),
+        counter: match.passkey.counter,
+        transports: match.passkey.transports,
+      },
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey could not be verified' }, 400);
+
+  await recordPasskeyUse(match.username, match.passkey.id, verification.authenticationInfo.newCounter);
+  await signIn(context, match.username);
+  return json({ username: match.username });
+};
