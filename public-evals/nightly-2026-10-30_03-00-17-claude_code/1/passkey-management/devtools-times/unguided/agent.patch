+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { RP_NAME, getRelyingParty, getSignedInUser, isJsonRequest, json } from '../../../lib/auth';
+import { getUser } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async (context) => {
+  const signedIn = await getSignedInUser(context);
+  if (!signedIn) return json({ error: 'Not signed in' }, 401);
+  if (!isJsonRequest(context.request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const user = await getUser(signedIn.username);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRelyingParty(context.url).rpID,
+    userName: signedIn.username,
+    userDisplayName: signedIn.username,
+    userID: Buffer.from(user.userID, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  context.session?.set('passkeyChallenge', { challenge: options.challenge, purpose: 'registration' });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..7ded910
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { getRelyingParty, getSignedInUser, json, readJson } from '../../../lib/auth';
+import { addPasskey, normalizePasskeyName, toPasskeySummary } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async (context) => {
+  const signedIn = await getSignedInUser(context);
+  if (!signedIn) return json({ error: 'Not signed in' }, 401);
+
+  const body = await readJson(context.request);
+  const expected = await context.session?.get('passkeyChallenge');
+  context.session?.delete('passkeyChallenge');
+  if (!body?.response || expected?.purpose !== 'registration') {
+    return json({ error: 'No passkey registration in progress' }, 400);
+  }
+
+  const { rpID, origin } = getRelyingParty(context.url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response as any,
+      expectedChallenge: expected.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey could not be verified' }, 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const now = new Date();
+  const passkey = {
+    id: credential.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    name:
+      normalizePasskeyName(body.name) ??
+      `Passkey added ${now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: now.toISOString(),
+    lastUsedAt: null,
+  };
+  const user = await addPasskey(signedIn.username, passkey);
+
+  return json({
+    passkey: toPasskeySummary(passkey),
+    allAcceptedCredentialIDs: user.passkeys.map((p) => p.id),
+  });
+};
