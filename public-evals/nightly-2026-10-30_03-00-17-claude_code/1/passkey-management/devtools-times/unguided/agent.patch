@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { getSignedInUser, isJsonRequest, json, readJson } from '../../../lib/auth';
+import {
+  MAX_PASSKEY_NAME_LENGTH,
+  deletePasskey,
+  normalizePasskeyName,
+  renamePasskey,
+  toPasskeySummary,
+} from '../../../lib/passkeys';
+
+export const PATCH: APIRoute = async (context) => {
+  const signedIn = await getSignedInUser(context);
+  if (!signedIn) return json({ error: 'Not signed in' }, 401);
+
+  const body = await readJson(context.request);
+  const name = normalizePasskeyName(body?.name);
+  if (!name) {
+    return json({ error: `Name must be 1-${MAX_PASSKEY_NAME_LENGTH} characters` }, 400);
+  }
+
+  const passkey = await renamePasskey(signedIn.username, context.params.id!, name);
+  if (!passkey) return json({ error: 'Passkey not found' }, 404);
+  return json({ passkey: toPasskeySummary(passkey) });
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const signedIn = await getSignedInUser(context);
+  if (!signedIn) return json({ error: 'Not signed in' }, 401);
+  if (!isJsonRequest(context.request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const user = await deletePasskey(signedIn.username, context.params.id!);
+  if (!user) return json({ error: 'Passkey not found' }, 404);
+  // The remaining IDs let the client tell the authenticator which passkeys are still valid.
+  return json({ allAcceptedCredentialIDs: user.passkeys.map((p) => p.id) });
+};
