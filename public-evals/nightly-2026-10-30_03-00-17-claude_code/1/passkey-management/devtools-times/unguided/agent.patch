+++ b/src/lib/passkeySignals.ts
@@ -0,0 +1,39 @@
+import { sendSignal } from '@simplewebauthn/browser';
+
+// Signals are best-effort: unsupported browsers throw, and that's fine.
+async function trySignal(opts: Parameters<typeof sendSignal>[0]) {
+  try {
+    await sendSignal(opts);
+  } catch {
+    // Ignore: the server remains the source of truth.
+  }
+}
+
+// Tell the browser's authenticator which passkeys are still valid for this account so
+// removed ones stop being offered, and refresh the account name shown on each passkey.
+export async function syncAuthenticator(opts: {
+  rpID: string;
+  userID: string;
+  username: string;
+  credentialIDs: string[];
+}) {
+  await Promise.all([
+    trySignal({
+      signalName: 'allAcceptedCredentials',
+      rpID: opts.rpID,
+      userID: opts.userID,
+      allAcceptedCredentialIDs: opts.credentialIDs,
+    }),
+    trySignal({
+      signalName: 'currentUserDetails',
+      rpID: opts.rpID,
+      userID: opts.userID,
+      userName: opts.username,
+      userDisplayName: opts.username,
+    }),
+  ]);
+}
+
+export function signalUnknownCredential(rpID: string, credentialID: string) {
+  return trySignal({ signalName: 'unknownCredential', rpID, credentialID });
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..f0f4673
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,137 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url COSE public key
+  counter: number;
+  transports?: string[];
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface StoredUser {
+  // base64url WebAuthn user handle, shared by every passkey of this user
+  userID: string;
+  passkeys: StoredPasskey[];
+}
+
+interface Store {
+  users: Record<string, StoredUser>;
+}
+
+export const MAX_PASSKEY_NAME_LENGTH = 64;
+
+const STORE_PATH = resolve(process.env.PASSKEY_STORE_PATH ?? '.data/passkeys.json');
+
+let queue: Promise<unknown> = Promise.resolve();
+
+// Serialize every read-modify-write so concurrent requests can't clobber each other.
+function withStore<T>(fn: (store: Store) => T | Promise<T>, write = false): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await load();
+    const result = await fn(store);
+    if (write) await save(store);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+async function load(): Promise<Store> {
+  try {
+    return JSON.parse(await readFile(STORE_PATH, 'utf8')) as Store;
+  } catch (err: any) {
+    if (err?.code === 'ENOENT') return { users: {} };
+    throw err;
+  }
+}
+
+async function save(store: Store) {
+  await mkdir(dirname(STORE_PATH), { recursive: true });
+  const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(store, null, 2));
+  await rename(tmp, STORE_PATH);
+}
+
+function ensureUser(store: Store, username: string): StoredUser {
+  return (store.users[username] ??= {
+    userID: randomBytes(32).toString('base64url'),
+    passkeys: [],
+  });
+}
+
+export function normalizePasskeyName(name: unknown): string | null {
+  if (typeof name !== 'string') return null;
+  const trimmed = name.trim().replace(/\s+/g, ' ');
+  if (!trimmed || trimmed.length > MAX_PASSKEY_NAME_LENGTH) return null;
+  return trimmed;
+}
+
+export function getUser(username: string) {
+  return withStore((store) => ensureUser(store, username), true);
+}
+
+export function addPasskey(username: string, passkey: StoredPasskey) {
+  return withStore((store) => {
+    const user = ensureUser(store, username);
+    user.passkeys.push(passkey);
+    return user;
+  }, true);
+}
+
+export function renamePasskey(username: string, id: string, name: string) {
+  return withStore((store) => {
+    const passkey = store.users[username]?.passkeys.find((p) => p.id === id);
+    if (passkey) passkey.name = name;
+    return passkey ?? null;
+  }, true);
+}
+
+export function deletePasskey(username: string, id: string) {
+  return withStore((store) => {
+    const user = store.users[username];
+    const index = user?.passkeys.findIndex((p) => p.id === id) ?? -1;
+    if (!user || index === -1) return null;
+    user.passkeys.splice(index, 1);
+    return user;
+  }, true);
+}
+
+export function findPasskeyByCredentialID(id: string) {
+  return withStore((store) => {
+    for (const [username, user] of Object.entries(store.users)) {
+      const passkey = user.passkeys.find((p) => p.id === id);
+      if (passkey) return { username, user, passkey };
+    }
+    return null;
+  });
+}
+
+export function recordPasskeyUse(username: string, id: string, counter: number) {
+  return withStore((store) => {
+    const passkey = store.users[username]?.passkeys.find((p) => p.id === id);
+    if (passkey) {
+      passkey.counter = counter;
+      passkey.lastUsedAt = new Date().toISOString();
+    }
+  }, true);
+}
+
+// Public shape sent to the browser (no key material).
+export function toPasskeySummary(p: StoredPasskey) {
+  return {
+    id: p.id,
+    name: p.name,
+    deviceType: p.deviceType,
+    backedUp: p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export type PasskeySummary = ReturnType<typeof toPasskeySummary>;
