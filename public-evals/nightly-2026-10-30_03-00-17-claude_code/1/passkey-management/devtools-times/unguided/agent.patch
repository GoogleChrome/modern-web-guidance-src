index 0000000..8d126f3
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,41 @@
+import type { APIContext } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+// WebAuthn is bound to the origin the reader is actually on.
+export function getRelyingParty(url: URL) {
+  return { rpID: url.hostname, origin: url.origin };
+}
+
+export async function getSignedInUser(context: Pick<APIContext, 'session'>) {
+  return (await context.session?.get('user')) ?? null;
+}
+
+// Requiring a JSON content type forces a CORS preflight for cross-site requests,
+// which blocks form-based CSRF against these cookie-authenticated endpoints.
+export function isJsonRequest(request: Request) {
+  return request.headers.get('content-type')?.split(';')[0].trim() === 'application/json';
+}
+
+export async function readJson(request: Request): Promise<Record<string, unknown> | null> {
+  if (!isJsonRequest(request)) return null;
+  try {
+    const body = await request.json();
+    return body && typeof body === 'object' ? body : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function signIn(context: Pick<APIContext, 'session'>, username: string) {
+  // Fresh session ID on privilege change to prevent session fixation.
+  await context.session?.regenerate();
+  context.session?.set('user', { username });
+}
