+import type { APIRoute } from 'astro';
+import { updateDisplayName } from '../../../lib/account-store';
+import { DISPLAY_NAME_MAX_LENGTH, getSignedInAccount, json, unauthorized } from '../../../lib/auth';
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const account = await getSignedInAccount(session);
+  if (!account) return unauthorized();
+
+  const { displayName } = await request.json().catch(() => ({}));
+  const trimmed = typeof displayName === 'string' ? displayName.trim() : '';
+  if (!trimmed || trimmed.length > DISPLAY_NAME_MAX_LENGTH) {
+    return json({ error: `Display name must be 1–${DISPLAY_NAME_MAX_LENGTH} characters.` }, 400);
+  }
+
+  const updated = await updateDisplayName(account.id, trimmed);
+  return json(updated);
+};
