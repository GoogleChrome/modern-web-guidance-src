diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..dac4cd9
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,355 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, PlusIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  canCreatePasskeys,
+  createPasskey,
+  signalAcceptedCredentials,
+  signalUnknownCredential,
+  type PasskeyJSON,
+} from '../lib/webauthn-client';
+
+interface Props {
+  rpId: string;
+  userId: string; // Base64URL-encoded user handle
+  initialPasskeys: PasskeyJSON[];
+  nameMaxLength: number;
+}
+
+type Status = { type: 'success' | 'error'; message: string } | null;
+
+const apiBase = `${import.meta.env.BASE_URL}api/passkeys`;
+const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+
+async function fetchPasskeys(): Promise<PasskeyJSON[]> {
+  const response = await fetch(apiBase);
+  if (!response.ok) throw new Error(`Failed to load passkeys (${response.status})`);
+  return response.json();
+}
+
+async function errorMessage(response: Response, fallback: string): Promise<string> {
+  const data = await response.json().catch(() => ({}));
+  return data.error || fallback;
+}
+
+export default function PasskeyManager({ rpId, userId, initialPasskeys, nameMaxLength }: Props) {
+  const [passkeys, setPasskeys] = useState<PasskeyJSON[]>(initialPasskeys);
+  const [canCreate, setCanCreate] = useState<boolean | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [savingId, setSavingId] = useState<string | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<PasskeyJSON | null>(null);
+  const [status, setStatus] = useState<Status>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  // Refresh from the server on mount and tell the password manager which passkeys are still valid,
+  // so keys removed elsewhere (e.g. another device) disappear from the browser too.
+  useEffect(() => {
+    let cancelled = false;
+    canCreatePasskeys().then((supported) => !cancelled && setCanCreate(supported));
+    fetchPasskeys()
+      .then((list) => {
+        if (cancelled) return;
+        setPasskeys(list);
+        return signalAcceptedCredentials(rpId, userId, list);
+      })
+      .catch((err) => console.error(err));
+    return () => {
+      cancelled = true;
+    };
+  }, [rpId, userId]);
+
+  const handleCreate = async () => {
+    setStatus(null);
+    setCreating(true);
+    try {
+      const optionsResponse = await fetch(`${apiBase}/register-options`, { method: 'POST' });
+      if (!optionsResponse.ok) {
+        setStatus({ type: 'error', message: await errorMessage(optionsResponse, 'Could not start passkey creation.') });
+        return;
+      }
+
+      let credential: PublicKeyCredential;
+      try {
+        credential = await createPasskey(await optionsResponse.json());
+      } catch (err) {
+        const name = (err as DOMException).name;
+        if (name === 'InvalidStateError') {
+          setStatus({ type: 'error', message: 'A passkey from this provider is already registered to your account.' });
+        } else if (name === 'SecurityError') {
+          setStatus({ type: 'error', message: 'Passkeys are not available on this site configuration.' });
+        } else if (name !== 'NotAllowedError' && name !== 'AbortError') {
+          setStatus({ type: 'error', message: 'Passkey creation failed. Please try again.' });
+        }
+        return;
+      }
+
+      const encoded = credential.toJSON();
+      try {
+        const verifyResponse = await fetch(`${apiBase}/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+        if (!verifyResponse.ok) {
+          await signalUnknownCredential(rpId, encoded.id);
+          setStatus({ type: 'error', message: await errorMessage(verifyResponse, 'Passkey could not be saved.') });
+          return;
+        }
+        const created: PasskeyJSON = await verifyResponse.json();
+        setPasskeys((list) => [...list, created]);
+        setStatus({ type: 'success', message: `Passkey “${created.name}” added.` });
+      } catch {
+        await signalUnknownCredential(rpId, encoded.id);
+        setStatus({ type: 'error', message: 'Passkey could not be saved. Please try again.' });
+      }
+    } catch {
+      setStatus({ type: 'error', message: 'An unexpected error occurred. Please try again later.' });
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const startEditing = (passkey: PasskeyJSON) => {
+    setStatus(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: PasskeyJSON) => {
+    e.preventDefault();
+    const name = draftName.trim();
+    if (name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    setSavingId(passkey.id);
+    try {
+      const response = await fetch(`${apiBase}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) {
+        setStatus({ type: 'error', message: await errorMessage(response, 'Could not rename passkey.') });
+        return;
+      }
+      const updated: PasskeyJSON = await response.json();
+      setPasskeys((list) => list.map((p) => (p.id === updated.id ? updated : p)));
+      setEditingId(null);
+      setStatus({ type: 'success', message: `Passkey renamed to “${updated.name}”.` });
+    } catch {
+      setStatus({ type: 'error', message: 'An unexpected error occurred. Please try again later.' });
+    } finally {
+      setSavingId(null);
+    }
+  };
+
+  const confirmDelete = (passkey: PasskeyJSON) => {
+    setStatus(null);
+    setPendingDelete(passkey);
+    dialogRef.current?.showModal();
+  };
+
+  const handleDialogClose = async () => {
+    const dialog = dialogRef.current!;
+    const choice = dialog.returnValue;
+    dialog.returnValue = '';
+    const passkey = pendingDelete;
+    setPendingDelete(null);
+    if (choice !== 'delete' || !passkey) return;
+
+    setSavingId(passkey.id);
+    try {
+      const response = await fetch(`${apiBase}/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+      if (!response.ok) {
+        setStatus({ type: 'error', message: await errorMessage(response, 'Could not remove passkey.') });
+        return;
+      }
+      const remaining = await fetchPasskeys().catch(() => passkeys.filter((p) => p.id !== passkey.id));
+      setPasskeys(remaining);
+      await signalAcceptedCredentials(rpId, userId, remaining);
+      setStatus({ type: 'success', message: `Passkey “${passkey.name}” removed.` });
+    } catch {
+      setStatus({ type: 'error', message: 'An unexpected error occurred. Please try again later.' });
+    } finally {
+      setSavingId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="border border-gray-200 rounded-lg p-6">
+      <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">Passkeys</h2>
+          <p className="mt-1 text-sm text-gray-600 max-w-prose">
+            Passkeys let you sign in with your fingerprint, face, screen lock, or a security key instead of a password.
+          </p>
+        </div>
+        {canCreate && (
+          <button
+            type="button"
+            onClick={handleCreate}
+            disabled={creating}
+            className="inline-flex items-center gap-1.5 bg-gray-900 text-white text-sm font-medium py-2 px-3 rounded-md hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+          >
+            <PlusIcon className="size-4" aria-hidden="true" />
+            {creating ? 'Creating…' : 'Create passkey'}
+          </button>
+        )}
+      </div>
+
+      {canCreate === false && (
+        <p className="mb-4 p-3 text-sm text-gray-700 bg-gray-100 rounded-lg">
+          This browser or device can’t create passkeys. You can still manage the passkeys already on your account,
+          and keep signing in with your password.
+        </p>
+      )}
+
+      <div aria-live="polite">
+        {status && (
+          <p
+            className={`mb-4 p-3 text-sm rounded-lg ${
+              status.type === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+          >
+            {status.message}
+          </p>
+        )}
+      </div>
+
+      {passkeys.length === 0 ? (
+        <p className="py-6 text-center text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg">
+          No passkeys found. Create one to sign in faster next time.
+        </p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+          {passkeys.map((passkey) => {
+            const busy = savingId === passkey.id;
+            const inputId = `passkey-name-${passkey.id}`;
+            return (
+              <li key={passkey.id} className="flex flex-wrap items-center gap-4 p-4">
+                {passkey.providerIcon ? (
+                  <img src={passkey.providerIcon} alt="" width={32} height={32} className="size-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="size-8 shrink-0 text-gray-500 p-1" aria-hidden="true" />
+                )}
+
+                <div className="min-w-0 flex-1">
+                  {editingId === passkey.id ? (
+                    <form
+                      onSubmit={(e) => handleRename(e, passkey)}
+                      onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                      className="flex flex-wrap items-center gap-2"
+                    >
+                      <label htmlFor={inputId} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={inputId}
+                        type="text"
+                        value={draftName}
+                        onChange={(e) => setDraftName(e.target.value)}
+                        required
+                        maxLength={nameMaxLength}
+                        autoFocus
+                        autoComplete="off"
+                        className="flex-1 min-w-40 px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        disabled={busy || !draftName.trim()}
+                        className="text-sm font-medium py-1.5 px-3 rounded-md bg-gray-900 text-white hover:bg-gray-800 disabled:opacity-75"
+                      >
+                        {busy ? 'Saving…' : 'Save'}
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="text-sm font-medium py-1.5 px-3 rounded-md border border-gray-300 hover:bg-gray-50"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                      <p className="text-xs text-gray-500" suppressHydrationWarning>
+                        Created{' '}
+                        <time dateTime={new Date(passkey.registeredAt).toISOString()}>
+                          {dateFormat.format(passkey.registeredAt)}
+                        </time>
+                        {' · '}
+                        {passkey.lastUsedAt ? (
+                          <>
+                            Last used{' '}
+                            <time dateTime={new Date(passkey.lastUsedAt).toISOString()}>
+                              {dateFormat.format(passkey.lastUsedAt)}
+                            </time>
+                          </>
+                        ) : (
+                          'Not used yet'
+                        )}
+                        {passkey.credentialBackedUp && ' · Synced'}
+                      </p>
+                    </>
+                  )}
+                </div>
+
+                {editingId !== passkey.id && (
+                  <div className="flex items-center gap-1">
+                    <button
+                      type="button"
+                      onClick={() => startEditing(passkey)}
+                      disabled={busy}
+                      aria-label={`Rename ${passkey.name}`}
+                      className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900"
+                    >
+                      <PencilSquareIcon className="size-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => confirmDelete(passkey)}
+                      disabled={busy}
+                      aria-label={`Remove ${passkey.name}`}
+                      className="p-2 rounded-md text-red-600 hover:bg-red-50 hover:text-red-700"
+                    >
+                      <TrashIcon className="size-5" aria-hidden="true" />
+                    </button>
+                  </div>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      <dialog
+        ref={dialogRef}
+        onClose={handleDialogClose}
+        aria-labelledby="delete-passkey-title"
+        className="passkey-dialog m-auto max-w-md w-[calc(100%-2rem)] rounded-lg p-6 shadow-xl"
+      >
+        <h3 id="delete-passkey-title" className="text-lg font-bold text-gray-900">
+          Remove “{pendingDelete?.name}”?
+        </h3>
+        <p className="mt-2 text-sm text-gray-600">
+          You won’t be able to sign in with this passkey anymore. Where supported, your browser’s password manager
+          will also be told to remove it.
+        </p>
+        <form method="dialog" className="mt-6 flex justify-end gap-2">
+          <button
+            value="cancel"
+            autoFocus
+            className="text-sm font-medium py-2 px-3 rounded-md border border-gray-300 hover:bg-gray-50"
+          >
+            Cancel
+          </button>
+          <button value="delete" className="text-sm font-medium py-2 px-3 rounded-md bg-red-600 text-white hover:bg-red-700">
+            Remove passkey
+          </button>
+        </form>
+      </dialog>
+    </section>
+  );
+}
