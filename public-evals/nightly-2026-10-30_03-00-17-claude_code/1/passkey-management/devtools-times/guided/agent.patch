@@ -0,0 +1,33 @@
+import type { APIContext } from 'astro';
+import { getAccountById, type Account } from './account-store';
+
+export const RP_NAME = 'The DevTools Times';
+export const PASSKEY_NAME_MAX_LENGTH = 64;
+export const DISPLAY_NAME_MAX_LENGTH = 64;
+
+export async function getSignedInAccount(session: APIContext['session']): Promise<Account | undefined> {
+  const userId = await session?.get('userId');
+  return typeof userId === 'string' ? getAccountById(userId) : undefined;
+}
+
+// The RP ID and origin are derived from the incoming request so the same build works on
+// localhost and behind the Cloud Run proxy (which terminates TLS and forwards the protocol).
+export function getRelyingParty(request: Request): { rpID: string; origin: string } {
+  const url = new URL(request.url);
+  const forwardedProto = request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim();
+  const forwardedHost = request.headers.get('x-forwarded-host')?.split(',')[0]?.trim();
+  const host = forwardedHost || url.host;
+  const protocol = forwardedProto ? `${forwardedProto}:` : url.protocol;
+  return { rpID: host.replace(/:\d+$/, ''), origin: `${protocol}//${host}` };
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export function unauthorized(): Response {
+  return json({ error: 'You need to be signed in.' }, 401);
+}
diff --git a/src/lib/webauthn-client.ts b/src/lib/webauthn-client.ts
new file mode 100644
index 0000000..fd05921
--- /dev/null
+++ b/src/lib/webauthn-client.ts
@@ -0,0 +1,100 @@
+// Browser-only helpers for WebAuthn and the Signal API. Every call is feature-detected so
+// unsupported browsers (e.g. Firefox lacks the Signal API) degrade silently.
+
+export interface PasskeyJSON {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+type PKC = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON?: (options: unknown) => PublicKeyCredentialCreationOptions;
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+function pkc(): PKC | undefined {
+  return typeof window !== 'undefined' && window.PublicKeyCredential
+    ? (window.PublicKeyCredential as PKC)
+    : undefined;
+}
+
+let polyfilled: Promise<unknown> | null = null;
+
+// Load the JSON-serialization / client-capabilities polyfills only where they're missing.
+async function ensurePolyfills(): Promise<void> {
+  const api = pkc();
+  if (!api) return;
+  if (!api.getClientCapabilities || !api.parseCreationOptionsFromJSON || !('toJSON' in api.prototype)) {
+    polyfilled ??= import('webauthn-polyfills');
+    await polyfilled;
+  }
+}
+
+export async function canCreatePasskeys(): Promise<boolean> {
+  const api = pkc();
+  if (!api) return false;
+  try {
+    await ensurePolyfills();
+    const capabilities = (await api.getClientCapabilities?.()) ?? {};
+    return Boolean(capabilities.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+export async function createPasskey(optionsJSON: unknown): Promise<PublicKeyCredential> {
+  await ensurePolyfills();
+  const publicKey = pkc()!.parseCreationOptionsFromJSON!(optionsJSON);
+  return (await navigator.credentials.create({ publicKey })) as PublicKeyCredential;
+}
+
+export async function signalAcceptedCredentials(rpId: string, userId: string, passkeys: PasskeyJSON[]) {
+  const api = pkc();
+  if (!api?.signalAllAcceptedCredentials) return;
+  try {
+    await api.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: passkeys.map((p) => p.id),
+    });
+  } catch (err) {
+    console.error('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  const api = pkc();
+  if (!api?.signalCurrentUserDetails) return;
+  try {
+    await api.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.error('signalCurrentUserDetails failed:', err);
+  }
+}
+
+export async function signalUnknownCredential(rpId: string, credentialId: string) {
+  const api = pkc();
+  if (!api?.signalUnknownCredential) return;
+  try {
+    await api.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.error('signalUnknownCredential failed:', err);
+  }
+}
