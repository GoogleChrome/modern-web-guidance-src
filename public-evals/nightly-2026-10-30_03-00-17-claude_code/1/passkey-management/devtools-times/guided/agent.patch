@@ -0,0 +1,36 @@
+import type { APIRoute } from 'astro';
+import { findOrCreateAccount } from '../../../lib/account-store';
+import { json } from '../../../lib/auth';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Verifies credentials against the Times login service and, on success, signs the reader
+// into this site's session so account pages (like passkey management) know who they are.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Login service unavailable' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json(data, upstream.status);
+  }
+
+  const account = await findOrCreateAccount(username.trim());
+  session?.regenerate();
+  session?.set('userId', account.id);
+
+  return json({ ...data, user: { name: account.name, displayName: account.displayName } });
+};
