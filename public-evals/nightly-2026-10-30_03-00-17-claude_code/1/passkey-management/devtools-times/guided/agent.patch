diff --git a/src/lib/aaguid.ts b/src/lib/aaguid.ts
new file mode 100644
index 0000000..629a665
--- /dev/null
+++ b/src/lib/aaguid.ts
@@ -0,0 +1,33 @@
+// Maps an authenticator's AAGUID to a provider name and icon using the community registry.
+// AAGUIDs are only used as a UX hint in the passkey list, never for security decisions.
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+let registry: Promise<Record<string, AaguidEntry>> | null = null;
+
+function loadRegistry(): Promise<Record<string, AaguidEntry>> {
+  registry ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then((res) => (res.ok ? res.json() : Promise.reject(new Error(`HTTP ${res.status}`))))
+    .catch((err) => {
+      console.error('Failed to load AAGUID registry:', err);
+      registry = null; // retry on the next registration
+      return {};
+    });
+  return registry;
+}
+
+export async function lookupProvider(aaguid: string): Promise<{ name: string; icon?: string }> {
+  if (aaguid === ZERO_AAGUID) {
+    return { name: 'Unknown passkey provider' };
+  }
+  const entry = (await loadRegistry())[aaguid];
+  return { name: entry?.name ?? 'Unknown passkey provider', icon: entry?.icon_light };
+}
diff --git a/src/lib/account-store.ts b/src/lib/account-store.ts
new file mode 100644
index 0000000..a9e85a8
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,122 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+// Small JSON-file backed store for reader accounts and their passkeys.
+// Credentials are kept server-side only; use `toPublicPasskey` before sending them to the client.
+
+export interface Account {
+  id: string; // Base64URL-encoded WebAuthn user handle
+  name: string; // Username used to sign in
+  displayName: string;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL-encoded
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export type PublicPasskey = Omit<StoredPasskeyCredential, 'credentialPublicKey' | 'counter'>;
+
+interface StoreData {
+  accounts: Record<string, Account>; // keyed by username
+  credentials: StoredPasskeyCredential[];
+}
+
+const STORE_PATH = resolve(process.env.ACCOUNT_STORE_PATH ?? '.data/accounts.json');
+
+let cache: StoreData | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(STORE_PATH, 'utf8')) as StoreData;
+  } catch {
+    cache = { accounts: {}, credentials: [] };
+  }
+  return cache;
+}
+
+function persist(data: StoreData): Promise<void> {
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(dirname(STORE_PATH), { recursive: true });
+    await writeFile(STORE_PATH, JSON.stringify(data, null, 2));
+  });
+  return writeQueue;
+}
+
+export async function findOrCreateAccount(name: string): Promise<Account> {
+  const data = await load();
+  let account = data.accounts[name];
+  if (!account) {
+    account = { id: randomBytes(16).toString('base64url'), name, displayName: name };
+    data.accounts[name] = account;
+    await persist(data);
+  }
+  return account;
+}
+
+export async function getAccountById(id: string): Promise<Account | undefined> {
+  const data = await load();
+  return Object.values(data.accounts).find((account) => account.id === id);
+}
+
+export async function updateDisplayName(id: string, displayName: string): Promise<Account | undefined> {
+  const data = await load();
+  const account = Object.values(data.accounts).find((a) => a.id === id);
+  if (!account) return undefined;
+  account.displayName = displayName;
+  await persist(data);
+  return account;
+}
+
+export async function listCredentials(userId: string): Promise<StoredPasskeyCredential[]> {
+  const data = await load();
+  return data.credentials
+    .filter((cred) => cred.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export async function addCredential(credential: StoredPasskeyCredential): Promise<void> {
+  const data = await load();
+  data.credentials.push(credential);
+  await persist(data);
+}
+
+export async function renameCredential(
+  userId: string,
+  id: string,
+  name: string,
+): Promise<StoredPasskeyCredential | undefined> {
+  const data = await load();
+  const cred = data.credentials.find((c) => c.id === id && c.passkeyUserId === userId);
+  if (!cred) return undefined;
+  cred.name = name;
+  await persist(data);
+  return cred;
+}
+
+export async function deleteCredential(userId: string, id: string): Promise<boolean> {
+  const data = await load();
+  const index = data.credentials.findIndex((c) => c.id === id && c.passkeyUserId === userId);
+  if (index === -1) return false;
+  data.credentials.splice(index, 1);
+  await persist(data);
+  return true;
+}
+
+export function toPublicPasskey({ credentialPublicKey, counter, ...rest }: StoredPasskeyCredential): PublicPasskey {
+  return rest;
+}
