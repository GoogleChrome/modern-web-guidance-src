@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { listCredentials } from '../../../lib/account-store';
+import { getRelyingParty, getSignedInAccount, json, RP_NAME, unauthorized } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const account = await getSignedInAccount(session);
+  if (!account) return unauthorized();
+
+  const { rpID } = getRelyingParty(request);
+  const existing = await listCredentials(account.id);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: isoBase64URL.toBuffer(account.id),
+    userName: account.name,
+    userDisplayName: account.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map((cred) => ({ id: cred.id, transports: cred.transports })),
+    // Management flow: no authenticatorAttachment, so security keys are allowed too.
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+  });
+
+  session?.set('registrationChallenge', options.challenge);
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..3a35983
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,60 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { lookupProvider } from '../../../lib/aaguid';
+import { addCredential, toPublicPasskey, type StoredPasskeyCredential } from '../../../lib/account-store';
+import { getRelyingParty, getSignedInAccount, json, unauthorized } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const account = await getSignedInAccount(session);
+  if (!account) return unauthorized();
+
+  const expectedChallenge = await session?.get('registrationChallenge');
+  session?.delete('registrationChallenge');
+  if (typeof expectedChallenge !== 'string') {
+    return json({ error: 'Registration session expired. Please try again.' }, 400);
+  }
+
+  const { rpID, origin } = getRelyingParty(request);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: await request.json(),
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserPresence: true,
+      // Options requested userVerification: 'preferred'.
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    console.error('Passkey registration verification failed:', err);
+    return json({ error: 'Passkey could not be verified.' }, 400);
+  }
+
+  if (!verification.verified) {
+    return json({ error: 'Passkey could not be verified.' }, 400);
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = verification.registrationInfo;
+  const provider = await lookupProvider(aaguid);
+
+  const stored: StoredPasskeyCredential = {
+    id: credential.id,
+    passkeyUserId: account.id,
+    credentialPublicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.icon,
+    name: provider.name,
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await addCredential(stored);
+
+  return json(toPublicPasskey(stored));
+};
