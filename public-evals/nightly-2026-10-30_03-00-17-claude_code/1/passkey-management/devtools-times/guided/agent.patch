diff --git a/src/components/AccountProfileForm.tsx b/src/components/AccountProfileForm.tsx
new file mode 100644
index 0000000..63537fe
--- /dev/null
+++ b/src/components/AccountProfileForm.tsx
@@ -0,0 +1,90 @@
+import React, { useState } from 'react';
+import { signalUserDetails } from '../lib/webauthn-client';
+
+interface Props {
+  rpId: string;
+  userId: string; // Base64URL-encoded user handle
+  userName: string;
+  initialDisplayName: string;
+  maxLength: number;
+}
+
+export default function AccountProfileForm({ rpId, userId, userName, initialDisplayName, maxLength }: Props) {
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [saved, setSaved] = useState(initialDisplayName);
+  const [status, setStatus] = useState<{ type: 'success' | 'error'; message: string } | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setStatus(null);
+    setLoading(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/account/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        setStatus({ type: 'error', message: data.error || 'Could not update your display name.' });
+        return;
+      }
+      setDisplayName(data.displayName);
+      setSaved(data.displayName);
+      // Update the name shown for this account in the browser's passkey prompts.
+      await signalUserDetails(rpId, userId, data.name, data.displayName);
+      setStatus({ type: 'success', message: 'Display name updated.' });
+    } catch {
+      setStatus({ type: 'error', message: 'An unexpected error occurred. Please try again later.' });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <section aria-labelledby="profile-heading" className="border border-gray-200 rounded-lg p-6">
+      <h2 id="profile-heading" className="text-xl font-bold text-gray-900">Profile</h2>
+      <p className="mt-1 mb-4 text-sm text-gray-600">
+        Signed in as <span className="font-semibold">{userName}</span>
+      </p>
+
+      <div aria-live="polite">
+        {status && (
+          <p
+            className={`mb-4 p-3 text-sm rounded-lg ${
+              status.type === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+          >
+            {status.message}
+          </p>
+        )}
+      </div>
+
+      <form onSubmit={handleSubmit} className="flex flex-wrap items-end gap-3">
+        <div className="flex-1 min-w-56">
+          <label htmlFor="display-name" className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            type="text"
+            id="display-name"
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            required
+            maxLength={maxLength}
+            autoComplete="name"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+        <button
+          type="submit"
+          disabled={loading || !displayName.trim() || displayName.trim() === saved}
+          className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+        >
+          {loading ? 'Saving…' : 'Save'}
+        </button>
+      </form>
+    </section>
+  );
+}
