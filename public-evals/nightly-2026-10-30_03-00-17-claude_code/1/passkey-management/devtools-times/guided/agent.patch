+import type { APIRoute } from 'astro';
+import { deleteCredential, renameCredential, toPublicPasskey } from '../../../lib/account-store';
+import { getSignedInAccount, json, PASSKEY_NAME_MAX_LENGTH, unauthorized } from '../../../lib/auth';
+
+// Renaming only changes the label stored on our server; it doesn't touch the authenticator.
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const account = await getSignedInAccount(session);
+  if (!account) return unauthorized();
+
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > PASSKEY_NAME_MAX_LENGTH) {
+    return json({ error: `Passkey name must be 1–${PASSKEY_NAME_MAX_LENGTH} characters.` }, 400);
+  }
+
+  const cred = await renameCredential(account.id, params.id!, trimmed);
+  if (!cred) return json({ error: 'Passkey not found.' }, 404);
+  return json(toPublicPasskey(cred));
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const account = await getSignedInAccount(session);
+  if (!account) return unauthorized();
+
+  const deleted = await deleteCredential(account.id, params.id!);
+  if (!deleted) return json({ error: 'Passkey not found.' }, 404);
+  return json({ success: true });
+};
