+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+      const KEY = "color-scheme";
+
+      document.getElementById("theme-toggle").addEventListener("click", () => {
+        const system = systemDark.matches ? "dark" : "light";
+        const rendered = meta.content === "light dark" ? system : meta.content;
+        const target = rendered === "dark" ? "light" : "dark";
+
+        // Toggling back to the system scheme clears the override instead of pinning it
+        const stored = target === system ? null : target;
+        meta.content = stored ?? "light dark";
+        try {
+          if (stored) localStorage.setItem(KEY, stored);
+          else localStorage.removeItem(KEY);
+        } catch {}
+      });
+
+      // Keep in sync with changes made in other tabs
+      addEventListener("storage", (e) => {
+        if (e.key === KEY || e.key === null) meta.content = e.newValue ?? "light dark";
+      });
+    })();
+  </script>
+
