+    .sticky-container {
+      /* Stick just below the site nav (document is the scroll root) */
+      position: sticky;
+      top: var(--nav-height);
+      z-index: 900;
+      /* Named scroll-state container so queries never match the site nav */
+      container-type: scroll-state;
+      container-name: section-header;
