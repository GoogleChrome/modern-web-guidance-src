+  <section id="roasting-widget" aria-label="Live roasting simulator">
+    <div class="roast-panel">
+      <canvas id="roast-canvas" aria-hidden="true"></canvas>
+      <div class="roast-readout" aria-live="off">
+        <h3>LIVE ROAST</h3>
+        <div class="roast-temp"><span id="roast-temp-value">--</span>&deg;F</div>
+        <div class="roast-stage" id="roast-stage">Charging drum&hellip;</div>
+      </div>
+    </div>
+  </section>
+
+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      if (!widget || !canvas || !canvas.getContext) return;
+
+      var ctx = canvas.getContext('2d');
+      var raf = window.requestAnimationFrame ||
+        window.webkitRequestAnimationFrame ||
+        function (cb) { return window.setTimeout(function () { cb(Date.now()); }, 1000 / 60); };
+      var caf = window.cancelAnimationFrame ||
+        window.webkitCancelAnimationFrame ||
+        window.clearTimeout;
+
+      var BEAN_COUNT = 60;
+      var TEMP_MIN = 200, TEMP_MAX = 445;
+      var beans = [];
+      var width = 0, height = 0, dpr = 1;
+      var temp = TEMP_MIN;
+      var frameId = null, tempTimer = null, lastTime = null;
+      var running = false, inView = false;
+
+      function resize() {
+        dpr = window.devicePixelRatio || 1;
+        width = canvas.clientWidth;
+        height = canvas.clientHeight;
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        if (!running) draw(0);
+      }
+
+      function makeBean() {
+        return {
+          angle: Math.random() * Math.PI * 2,
+          radius: 0.25 + Math.random() * 0.7,
+          speed: 0.6 + Math.random() * 0.8,
+          spin: Math.random() * Math.PI * 2,
+          spinSpeed: (Math.random() - 0.5) * 6,
+          size: 9 + Math.random() * 5
+        };
+      }
+
+      for (var i = 0; i < BEAN_COUNT; i++) beans.push(makeBean());
+
+      // Bean colour moves from green to dark brown as the roast heats up.
+      function beanColor(progress) {
+        var stops = [[134, 160, 90], [196, 160, 90], [140, 84, 44], [70, 38, 22]];
+        var p = Math.min(Math.max(progress, 0), 1) * (stops.length - 1);
+        var idx = Math.min(Math.floor(p), stops.length - 2);
+        var t = p - idx, a = stops[idx], b = stops[idx + 1];
+        return 'rgb(' +
+          Math.round(a[0] + (b[0] - a[0]) * t) + ',' +
+          Math.round(a[1] + (b[1] - a[1]) * t) + ',' +
+          Math.round(a[2] + (b[2] - a[2]) * t) + ')';
+      }
+
+      function stageFor(t) {
+        if (t < 300) return 'Drying phase';
+        if (t < 385) return 'Maillard reaction';
+        if (t < 410) return 'First crack';
+        if (t < 435) return 'Development';
+        return 'Second crack — dropping soon';
+      }
+
+      function draw(dt) {
+        var cx = width / 2, cy = height / 2;
+        var drum = Math.min(width, height) * 0.42;
+        var progress = (temp - TEMP_MIN) / (TEMP_MAX - TEMP_MIN);
+
+        ctx.clearRect(0, 0, width, height);
+
+        var glow = ctx.createRadialGradient(cx, cy, drum * 0.2, cx, cy, drum * 1.3);
+        glow.addColorStop(0, 'rgba(255, 140, 50, ' + (0.15 + progress * 0.35) + ')');
+        glow.addColorStop(1, 'rgba(43, 29, 24, 0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, width, height);
+
+        ctx.beginPath();
+        ctx.arc(cx, cy, drum, 0, Math.PI * 2);
+        ctx.strokeStyle = '#8d6e63';
+        ctx.lineWidth = 6;
+        ctx.stroke();
+
+        var color = beanColor(progress);
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.angle += b.speed * dt;
+          b.spin += b.spinSpeed * dt;
+          var r = drum * b.radius * 0.85;
+          var x = cx + Math.cos(b.angle) * r;
+          var y = cy + Math.sin(b.angle) * r;
+
+          ctx.save();
+          ctx.translate(x, y);
+          ctx.rotate(b.spin);
+          ctx.beginPath();
+          ctx.ellipse
+            ? ctx.ellipse(0, 0, b.size, b.size * 0.68, 0, 0, Math.PI * 2)
+            : ctx.arc(0, 0, b.size * 0.8, 0, Math.PI * 2);
+          ctx.fillStyle = color;
+          ctx.fill();
+          ctx.beginPath();
+          ctx.moveTo(-b.size * 0.75, 0);
+          ctx.quadraticCurveTo(0, b.size * 0.25, b.size * 0.75, 0);
+          ctx.strokeStyle = 'rgba(0, 0, 0, 0.45)';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      function frame(now) {
+        if (!running) return;
+        var dt = lastTime === null ? 0 : Math.min((now - lastTime) / 1000, 0.1);
+        lastTime = now;
+        draw(dt);
+        frameId = raf(frame);
+      }
+
+      function tickTemp() {
+        temp += 2 + Math.random() * 3;
+        if (temp >= TEMP_MAX) temp = TEMP_MIN; // drop the batch, charge a new one
+        tempEl.textContent = Math.round(temp);
+        stageEl.textContent = stageFor(temp);
+      }
+
+      function start() {
+        if (running) return;
+        running = true;
+        lastTime = null;
+        tickTemp();
+        tempTimer = window.setInterval(tickTemp, 1000);
+        frameId = raf(frame);
+      }
+
+      function stop() {
+        if (!running) return;
+        running = false;
+        if (frameId !== null) caf(frameId);
+        if (tempTimer !== null) window.clearInterval(tempTimer);
+        frameId = tempTimer = null;
+      }
+
+      // Only run while the widget is on screen and the tab is visible.
+      function pageHidden() {
+        return !!(document.hidden || document.webkitHidden);
+      }
+
+      function update() {
+        if (inView && !pageHidden()) start(); else stop();
+      }
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          var entry = entries[entries.length - 1];
+          inView = entry.isIntersecting || entry.intersectionRatio > 0;
+          update();
+        }, { threshold: 0 }).observe(widget);
+      } else {
+        // Fallback: check bounding box on scroll/resize, throttled.
+        var pending = false;
+        var check = function () {
+          pending = false;
+          var rect = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          var vw = window.innerWidth || document.documentElement.clientWidth;
+          inView = rect.bottom > 0 && rect.top < vh && rect.right > 0 && rect.left < vw;
+          update();
+        };
+        var schedule = function () {
+          if (pending) return;
+          pending = true;
+          window.setTimeout(check, 100);
+        };
+        window.addEventListener('scroll', schedule, false);
+        window.addEventListener('resize', schedule, false);
+        window.addEventListener('orientationchange', schedule, false);
+        check();
+      }
+
+      if ('hidden' in document) {
+        document.addEventListener('visibilitychange', update, false);
+      } else if ('webkitHidden' in document) {
+        document.addEventListener('webkitvisibilitychange', update, false);
+      } else {
+        // Fallback for browsers without the Page Visibility API.
+        window.addEventListener('blur', function () { stop(); }, false);
+        window.addEventListener('focus', update, false);
+      }
+      window.addEventListener('pagehide', stop, false);
+      window.addEventListener('pageshow', update, false);
+
+      window.addEventListener('resize', resize, false);
+      resize();
+    })();
+  </script>
+
