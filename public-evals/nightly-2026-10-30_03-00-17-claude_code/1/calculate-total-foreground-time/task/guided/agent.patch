+  <script>
+    // Fallback for browsers without VisibilityStateEntry (Firefox, Safari):
+    // accumulate visible time ourselves via visibilitychange. This assumes the
+    // state seen when this script runs held since navigation start.
+    const fallbackVisibility = {
+      visibleMs: 0,
+      visibleSince: document.visibilityState === 'visible' ? 0 : null,
+    };
+
+    if (!('VisibilityStateEntry' in window)) {
+      document.addEventListener('visibilitychange', () => {
+        const now = performance.now();
+        if (document.visibilityState === 'visible') {
+          fallbackVisibility.visibleSince ??= now;
+        } else if (fallbackVisibility.visibleSince !== null) {
+          fallbackVisibility.visibleMs += now - fallbackVisibility.visibleSince;
+          fallbackVisibility.visibleSince = null;
+        }
+      });
+    }
+
+    /**
+     * Calculates total time the page was in the visible (foreground) state.
+     *
+     * @returns {number} Total foreground time in milliseconds.
+     */
+    function getTotalForegroundTime() {
+      const entries = performance.getEntriesByType('visibility-state');
+
+      if (entries.length === 0) {
+        const { visibleMs, visibleSince } = fallbackVisibility;
+        return visibleMs + (visibleSince !== null ? performance.now() - visibleSince : 0);
+      }
+
+      let total = 0;
+      for (let i = 0; i < entries.length; i++) {
+        if (entries[i].name !== 'visible') continue;
+        // A visible period ends at the next state change, or now if still visible.
+        const end = i + 1 < entries.length ? entries[i + 1].startTime : performance.now();
+        total += end - entries[i].startTime;
+      }
+      return total;
+    }
+  </script>
