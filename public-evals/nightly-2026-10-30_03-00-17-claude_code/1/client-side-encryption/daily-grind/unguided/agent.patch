+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  MAX_NOTE_CHARS, fromBase64, generateKeyPair, openNote, parsePublicKey, sealNote, toBase64,
+} from '../js/delivery-notes.js';
+
+const store = await generateKeyPair();
+
+test('round-trips a note, including non-ASCII text', async () => {
+  const note = 'Gate code 4821 — leave with Zoë at the desk ☕';
+  const env = await sealNote(store, note, { orderRef: 'DG-1' });
+  assert.equal(await openNote(store.secretKey, env), note);
+  assert.ok(!JSON.stringify(env).includes('4821'));
+});
+
+test('every note uses a fresh encapsulation and IV', async () => {
+  const a = await sealNote(store, 'same');
+  const b = await sealNote(store, 'same');
+  assert.notEqual(a.enc, b.enc);
+  assert.notEqual(a.iv, b.iv);
+  assert.notEqual(a.ct, b.ct);
+});
+
+test('rejects tampering with ciphertext or any authenticated header field', async () => {
+  const env = await sealNote(store, 'Severe nut allergy', { orderRef: 'DG-2' });
+  const ct = fromBase64(env.ct);
+  ct[0] ^= 1;
+  const kem = fromBase64(env.enc);
+  kem[5] ^= 1;
+  for (const bad of [
+    { ...env, ct: toBase64(ct) },
+    { ...env, enc: toBase64(kem) },
+    { ...env, orderRef: 'DG-3' },
+    { ...env, createdAt: '2000-01-01T00:00:00.000Z' },
+    { ...env, kid: 'ffffffffffffffff' },
+  ]) {
+    await assert.rejects(openNote(store.secretKey, bad), /Authentication failed/);
+  }
+});
+
+test('a different store key cannot open the note', async () => {
+  const other = await generateKeyPair();
+  const env = await sealNote(store, 'secret');
+  await assert.rejects(openNote(other.secretKey, env), /Authentication failed/);
+});
+
+test('padding hides exact note length', async () => {
+  const short = await sealNote(store, 'a');
+  const longer = await sealNote(store, 'a'.repeat(100));
+  assert.equal(short.ct.length, longer.ct.length);
+});
+
+test('validates input and key documents', async () => {
+  await assert.rejects(sealNote(store, '   '), /empty/);
+  await assert.rejects(sealNote(store, 'x'.repeat(MAX_NOTE_CHARS + 1)), /limited/);
+  assert.throws(() => parsePublicKey({ suite: 'nope' }), /Unrecognised/);
+  const env = await sealNote(store, 'hi');
+  await assert.rejects(openNote(store.secretKey, { ...env, v: 2 }), /Unsupported/);
+});
+
+test('published public key parses', () => {
+  const doc = JSON.parse(readFileSync(new URL('../keys/delivery-notes.pub.json', import.meta.url), 'utf8'));
+  assert.equal(parsePublicKey(doc).publicKey.length, 1216);
+});
+
+test('open-note CLI decrypts an envelope', async () => {
+  const env = await sealNote(store, 'Ring twice', { orderRef: 'DG-9' });
+  const dir = mkdtempSync(join(tmpdir(), 'dg-notes-'));
+  const file = join(dir, 'env.json');
+  writeFileSync(file, JSON.stringify(env));
+  const out = execFileSync(process.execPath, [fileURLToPath(new URL('../scripts/open-note.mjs', import.meta.url)), file], {
+    env: { ...process.env, DELIVERY_NOTES_SECRET_KEY: toBase64(store.secretKey) },
+    encoding: 'utf8',
+  });
+  assert.match(out, /note:\s+Ring twice/);
+  assert.match(out, /order:\s+DG-9/);
+});
