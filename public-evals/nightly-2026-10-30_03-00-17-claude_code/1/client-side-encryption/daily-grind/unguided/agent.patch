diff --git a/scripts/build-vendor.sh b/scripts/build-vendor.sh
new file mode 100755
index 0000000..9d1ceb8
--- /dev/null
+++ b/scripts/build-vendor.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Rebuilds vendor/xwing.min.js from pinned npm packages in a throwaway directory.
+set -eu
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+cd "$WORK"
+echo '{"name":"xwing-vendor","private":true}' > package.json
+pnpm add --ignore-scripts @noble/post-quantum@0.7.1 esbuild@0.28.2 >/dev/null
+echo "export { ml_kem768_x25519 as xwing } from '@noble/post-quantum/hybrid.js';" > entry.js
+pnpm approve-builds --all >/dev/null 2>&1 || true
+node node_modules/esbuild/bin/esbuild entry.js --bundle --format=esm --minify --legal-comments=none --outfile=out.js
+{
+  echo "/*! X-Wing hybrid KEM (ML-KEM-768 + X25519) bundled from @noble/post-quantum@0.7.1"
+  echo " * (deps @noble/curves@2.4.0, @noble/hashes@2.4.0). MIT License, (c) Paul Miller (https://paulmillr.com)."
+  echo " * Rebuild: see scripts/build-vendor.sh */"
+  cat out.js
+} > "$ROOT/vendor/xwing.min.js"
+echo "Wrote vendor/xwing.min.js"
diff --git a/scripts/keygen.mjs b/scripts/keygen.mjs
new file mode 100644
index 0000000..bbac752
--- /dev/null
+++ b/scripts/keygen.mjs
@@ -0,0 +1,36 @@
+#!/usr/bin/env node
+// Generates the store's delivery-notes key pair.
+//   Public key  -> keys/delivery-notes.pub.json (served to browsers, safe to commit)
+//   Secret key  -> ~/.config/daily-grind/delivery-notes.secret.json, or --out <path>.
+//                  Never write it inside this directory: the whole site root is served statically.
+import { existsSync, mkdirSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { SUITE, fingerprint, generateKeyPair, toBase64 } from '../js/delivery-notes.js';
+
+const outIdx = process.argv.indexOf('--out');
+const pubPath = fileURLToPath(new URL('../keys/delivery-notes.pub.json', import.meta.url));
+const secretPath = outIdx > -1 ? process.argv[outIdx + 1] : join(homedir(), '.config', 'daily-grind', 'delivery-notes.secret.json');
+if (!secretPath) {
+  console.error('Usage: node scripts/keygen.mjs [--out <secret-key-path>] [--force]');
+  process.exit(1);
+}
+
+if (existsSync(secretPath) && !process.argv.includes('--force')) {
+  console.error(`${secretPath} already exists. Re-run with --force to rotate keys.`);
+  process.exit(1);
+}
+
+const { kid, publicKey, secretKey } = await generateKeyPair();
+const createdAt = new Date().toISOString();
+
+mkdirSync(dirname(secretPath), { recursive: true, mode: 0o700 });
+
+writeFileSync(pubPath, JSON.stringify({ suite: SUITE, kid, createdAt, publicKey: toBase64(publicKey) }, null, 2) + '\n');
+writeFileSync(secretPath, JSON.stringify({ suite: SUITE, kid, createdAt, secretKey: toBase64(secretKey) }, null, 2) + '\n', { mode: 0o600 });
+
+console.log(`kid:         ${kid}`);
+console.log(`fingerprint: ${await fingerprint(publicKey)}`);
+console.log(`public key:  ${pubPath}`);
+console.log(`secret key:  ${secretPath}  (keep private)`);
diff --git a/scripts/open-note.mjs b/scripts/open-note.mjs
new file mode 100644
index 0000000..e90e30a
--- /dev/null
+++ b/scripts/open-note.mjs
@@ -0,0 +1,30 @@
+#!/usr/bin/env node
+// Decrypts a sealed delivery note for store staff.
+//   node scripts/open-note.mjs envelope.json        (or pipe the envelope JSON on stdin)
+// Secret key is read from $DELIVERY_NOTES_SECRET_KEY (base64), else the file at
+// $DELIVERY_NOTES_SECRET_PATH, else ~/.config/daily-grind/delivery-notes.secret.json.
+import { readFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+import { fromBase64, openNote } from '../js/delivery-notes.js';
+
+function loadSecret() {
+  if (process.env.DELIVERY_NOTES_SECRET_KEY) return { secretKey: process.env.DELIVERY_NOTES_SECRET_KEY };
+  const path = process.env.DELIVERY_NOTES_SECRET_PATH ?? join(homedir(), '.config', 'daily-grind', 'delivery-notes.secret.json');
+  return JSON.parse(readFileSync(path, 'utf8'));
+}
+
+try {
+  const envelope = JSON.parse(readFileSync(process.argv[2] ?? 0, 'utf8'));
+  const secret = loadSecret();
+  if (secret.kid && secret.kid !== envelope.kid) {
+    throw new Error(`Envelope was sealed to key ${envelope.kid}, but loaded secret key is ${secret.kid}.`);
+  }
+  const note = await openNote(fromBase64(secret.secretKey), envelope);
+  console.log(`order:   ${envelope.orderRef || '(none)'}`);
+  console.log(`created: ${envelope.createdAt}`);
+  console.log(`note:    ${note}`);
+} catch (err) {
+  console.error(`Could not open note: ${err.message}`);
+  process.exit(1);
+}
