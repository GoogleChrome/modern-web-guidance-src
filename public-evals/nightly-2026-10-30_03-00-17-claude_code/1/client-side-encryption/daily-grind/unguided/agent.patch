diff --git a/js/delivery-notes-ui.js b/js/delivery-notes-ui.js
new file mode 100644
index 0000000..8e37f46
--- /dev/null
+++ b/js/delivery-notes-ui.js
@@ -0,0 +1,91 @@
+import { MAX_NOTE_CHARS, fingerprint, parsePublicKey, sealNote } from './delivery-notes.js';
+
+// Sealed envelopes wait here for checkout to submit with the order. Plaintext is never stored.
+const STORAGE_KEY = 'dailyGrind.deliveryNote';
+const PUBLIC_KEY_URL = new URL('../keys/delivery-notes.pub.json', import.meta.url);
+
+const form = document.getElementById('secure-note-form');
+const noteInput = document.getElementById('secure-note-text');
+const orderInput = document.getElementById('secure-note-order');
+const counter = document.getElementById('secure-note-count');
+const status = document.getElementById('secure-note-status');
+const keyInfo = document.getElementById('secure-note-key');
+const result = document.getElementById('secure-note-result');
+const output = document.getElementById('secure-note-envelope');
+const copyBtn = document.getElementById('secure-note-copy');
+const clearBtn = document.getElementById('secure-note-clear');
+const submitBtn = form.querySelector('button[type="submit"]');
+
+let storeKey = null;
+
+function setStatus(message, kind = '') {
+  status.textContent = message;
+  status.dataset.kind = kind;
+}
+
+function showEnvelope(envelope) {
+  output.value = JSON.stringify(envelope, null, 2);
+  result.hidden = false;
+}
+
+async function loadStoreKey() {
+  const res = await fetch(PUBLIC_KEY_URL, { cache: 'no-cache' });
+  if (!res.ok) throw new Error(`Could not load the store's encryption key (HTTP ${res.status}).`);
+  storeKey = parsePublicKey(await res.json());
+  keyInfo.textContent = `Store key ${await fingerprint(storeKey.publicKey)}`;
+  submitBtn.disabled = false;
+}
+
+noteInput.maxLength = MAX_NOTE_CHARS;
+const updateCount = () => (counter.textContent = `${noteInput.value.length}/${MAX_NOTE_CHARS}`);
+noteInput.addEventListener('input', updateCount);
+updateCount();
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!storeKey) return;
+  submitBtn.disabled = true;
+  setStatus('Encrypting on this device…');
+  try {
+    const envelope = await sealNote(storeKey, noteInput.value, { orderRef: orderInput.value.trim() });
+    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(envelope));
+    noteInput.value = '';
+    updateCount();
+    showEnvelope(envelope);
+    setStatus('Sealed. Only the Daily Grind delivery team can read this note, and it will be attached to your next order.', 'ok');
+  } catch (err) {
+    setStatus(err.message, 'error');
+  } finally {
+    submitBtn.disabled = false;
+  }
+});
+
+copyBtn.addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(output.value);
+    setStatus('Encrypted envelope copied.', 'ok');
+  } catch {
+    output.select();
+  }
+});
+
+clearBtn.addEventListener('click', () => {
+  sessionStorage.removeItem(STORAGE_KEY);
+  output.value = '';
+  result.hidden = true;
+  setStatus('Sealed note removed from this session.');
+});
+
+const pending = sessionStorage.getItem(STORAGE_KEY);
+if (pending) {
+  try {
+    showEnvelope(JSON.parse(pending));
+  } catch {
+    sessionStorage.removeItem(STORAGE_KEY);
+  }
+}
+
+loadStoreKey().catch((err) => {
+  keyInfo.textContent = 'Store key unavailable';
+  setStatus(err.message, 'error');
+});
diff --git a/js/delivery-notes.js b/js/delivery-notes.js
new file mode 100644
index 0000000..290205e
--- /dev/null
+++ b/js/delivery-notes.js
@@ -0,0 +1,155 @@
+// Encrypted delivery notes: shared between the browser (sealing) and staff tooling (opening).
+//
+// Construction (one fresh KEM encapsulation per note):
+//   1. X-Wing hybrid KEM (ML-KEM-768 + X25519) encapsulates to the store's public key, producing a
+//      32-byte shared secret that stays safe as long as EITHER the post-quantum or the classical
+//      component holds.
+//   2. HKDF-SHA-256 turns that secret into a single-use AES-256-GCM key, domain-separated by suite
+//      and key id.
+//   3. AES-256-GCM encrypts the padded note; the whole header (suite, kid, KEM ciphertext, order
+//      reference, timestamp) is bound in as additional authenticated data, so any tampering with
+//      the envelope makes decryption fail.
+
+import { xwing } from '../vendor/xwing.min.js';
+
+export const VERSION = 1;
+export const SUITE = 'X-Wing/HKDF-SHA-256/AES-256-GCM';
+export const MAX_NOTE_CHARS = 500;
+
+const HKDF_INFO = 'daily-grind/delivery-notes/v1';
+const PAD_BLOCK = 128;
+const IV_BYTES = 12;
+
+const enc = new TextEncoder();
+const dec = new TextDecoder('utf-8', { fatal: true });
+
+export function toBase64(bytes) {
+  let bin = '';
+  for (const b of bytes) bin += String.fromCharCode(b);
+  return btoa(bin);
+}
+
+export function fromBase64(str) {
+  const bin = atob(str);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+function requireSubtle() {
+  if (!globalThis.crypto?.subtle) {
+    throw new Error('Web Crypto is unavailable. Encrypted notes require HTTPS (a secure context).');
+  }
+  return globalThis.crypto.subtle;
+}
+
+/** Short, human-comparable SHA-256 fingerprint of a public key. */
+export async function fingerprint(publicKey) {
+  const digest = new Uint8Array(await requireSubtle().digest('SHA-256', publicKey));
+  return Array.from(digest.slice(0, 16), (b) => b.toString(16).padStart(2, '0'))
+    .join('')
+    .match(/.{4}/g)
+    .join(':');
+}
+
+/** Validates a published key document ({ suite, kid, publicKey }) and returns raw key bytes. */
+export function parsePublicKey(doc) {
+  if (!doc || doc.suite !== SUITE || typeof doc.kid !== 'string' || typeof doc.publicKey !== 'string') {
+    throw new Error('Unrecognised delivery-notes public key document.');
+  }
+  const publicKey = fromBase64(doc.publicKey);
+  if (publicKey.length !== xwing.lengths.publicKey) {
+    throw new Error('Delivery-notes public key has the wrong length.');
+  }
+  return { kid: doc.kid, publicKey };
+}
+
+/** Generates a new store key pair. The secret key is the 32-byte X-Wing seed. */
+export async function generateKeyPair() {
+  const { publicKey, secretKey } = xwing.keygen();
+  const kid = (await fingerprint(publicKey)).replaceAll(':', '').slice(0, 16);
+  return { kid, publicKey, secretKey };
+}
+
+// Canonical encoding of everything that must be authenticated alongside the ciphertext.
+function headerAad(h) {
+  return enc.encode(JSON.stringify([h.v, h.suite, h.kid, h.enc, h.orderRef, h.createdAt]));
+}
+
+async function deriveAesKey(sharedSecret, kid, usage) {
+  const subtle = requireSubtle();
+  const ikm = await subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(0), info: enc.encode(`${HKDF_INFO}|${SUITE}|${kid}`) },
+    ikm,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    [usage],
+  );
+}
+
+// Length-prefixed and zero-padded to a fixed block size so ciphertext length only leaks a coarse bucket.
+function pad(text) {
+  const body = enc.encode(text);
+  if (body.length > 0xffff) throw new Error('Note is too long.');
+  const out = new Uint8Array(Math.ceil((body.length + 2) / PAD_BLOCK) * PAD_BLOCK);
+  out[0] = body.length >> 8;
+  out[1] = body.length & 0xff;
+  out.set(body, 2);
+  return out;
+}
+
+function unpad(bytes) {
+  const len = (bytes[0] << 8) | bytes[1];
+  if (len + 2 > bytes.length) throw new Error('Malformed note padding.');
+  return dec.decode(bytes.subarray(2, 2 + len));
+}
+
+/**
+ * Encrypts a note to the store's public key. Returns a JSON-serialisable envelope; the plaintext
+ * and shared secret never leave this function.
+ */
+export async function sealNote({ kid, publicKey }, note, { orderRef = '', createdAt = new Date().toISOString() } = {}) {
+  const text = String(note).trim();
+  if (!text) throw new Error('Note is empty.');
+  if (text.length > MAX_NOTE_CHARS) throw new Error(`Notes are limited to ${MAX_NOTE_CHARS} characters.`);
+
+  const { cipherText, sharedSecret } = xwing.encapsulate(publicKey);
+  try {
+    const key = await deriveAesKey(sharedSecret, kid, 'encrypt');
+    const header = { v: VERSION, suite: SUITE, kid, enc: toBase64(cipherText), orderRef: String(orderRef), createdAt };
+    const iv = crypto.getRandomValues(new Uint8Array(IV_BYTES));
+    const ct = await requireSubtle().encrypt(
+      { name: 'AES-GCM', iv, additionalData: headerAad(header), tagLength: 128 },
+      key,
+      pad(text),
+    );
+    return { ...header, iv: toBase64(iv), ct: toBase64(new Uint8Array(ct)) };
+  } finally {
+    sharedSecret.fill(0);
+  }
+}
+
+/** Decrypts an envelope with the store's secret key. Throws if anything was modified. */
+export async function openNote(secretKey, envelope) {
+  if (envelope?.v !== VERSION || envelope.suite !== SUITE) throw new Error('Unsupported envelope version or suite.');
+  const kemCt = fromBase64(envelope.enc);
+  const iv = fromBase64(envelope.iv);
+  if (kemCt.length !== xwing.lengths.cipherText || iv.length !== IV_BYTES) throw new Error('Malformed envelope.');
+
+  const sharedSecret = xwing.decapsulate(kemCt, secretKey);
+  try {
+    const key = await deriveAesKey(sharedSecret, envelope.kid, 'decrypt');
+    const pt = await requireSubtle().decrypt(
+      { name: 'AES-GCM', iv, additionalData: headerAad(envelope), tagLength: 128 },
+      key,
+      fromBase64(envelope.ct),
+    );
+    return unpad(new Uint8Array(pt));
+  } catch (err) {
+    if (err?.name === 'OperationError') throw new Error('Authentication failed: wrong key or tampered envelope.');
+    throw err;
+  } finally {
+    sharedSecret.fill(0);
+  }
+}
