+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    function handleCommand(command) {
+      if (command === '--reset') {
+        actionTarget.classList.remove(...Object.values(commandClasses));
+      } else if (commandClasses[command]) {
+        actionTarget.classList.toggle(commandClasses[command]);
+      }
+    }
+
+    // Declarative Invoker Commands: buttons with commandfor/command dispatch a "command" event on the target.
+    actionTarget.addEventListener('command', (event) => handleCommand(event.command));
+
+    // Fallback for browsers without Invoker Commands support.
+    if (!('command' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[commandfor="action-target"]');
+        if (button) handleCommand(button.getAttribute('command'));
+      });
+    }
+  </script>
+
 </body>
 
