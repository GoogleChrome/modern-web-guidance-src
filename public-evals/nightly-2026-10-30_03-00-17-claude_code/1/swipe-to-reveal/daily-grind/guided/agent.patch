+    /* Swipe-to-reveal drink actions */
+    .card.SwipeReveal {
+      /* Column 1: full-width drink info. Column 2: auto-sized actions. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      padding: 0;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      /* Chain excess scroll to the page without the action strip bouncing. */
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .card.SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      padding: 20px;
+      background: white;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .swipe-hint {
+      margin-top: 10px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel > * {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      width: 84px;
+      border: 0;
+      font: inherit;
+      font-size: 0.8rem;
+      color: white;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel > *:focus-visible {
+      outline: 2px solid white;
+      outline-offset: -4px;
+    }
+
+    .action-order {
+      background: var(--primary);
+    }
+
+    .action-customize {
+      background: #8d6e63;
+    }
+
+    .action-favorite {
+      background: #c77700;
+    }
+
+    .action-favorite[aria-pressed="true"] {
+      background: #b71c1c;
+    }
+
+    .action-icon {
+      font-size: 1.25rem;
+      line-height: 1;
+    }
+
