+    /* Swipeable drink cards */
+    .swipe-card {
+      position: relative;
+      padding: 0;
+      overflow: hidden;
+      touch-action: pan-y;
+    }
+
+    .swipe-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      padding: 20px;
+      background: white;
+      border-radius: 8px;
+      transition: transform 0.25s ease;
+      user-select: none;
+    }
+
+    .swipe-card.dragging .swipe-content {
+      transition: none;
+    }
+
+    .swipe-actions {
+      position: absolute;
+      top: 0;
+      right: 0;
+      bottom: 0;
+      display: flex;
+    }
+
+    .swipe-action {
+      width: 76px;
+      border: none;
+      display: flex;
+      flex-direction: column;
