+  <script>
+    (function () {
+      var cards = Array.prototype.slice.call(document.querySelectorAll('.swipe-card'));
+      var SWIPE_THRESHOLD = 10; // px of horizontal movement before we treat it as a swipe
+
+      function actionsWidth(card) {
+        return card.querySelector('.swipe-actions').offsetWidth;
+      }
+
+      function setOpen(card, open) {
+        var content = card.querySelector('.swipe-content');
+        var actions = card.querySelector('.swipe-actions');
+        var toggle = card.querySelector('.swipe-toggle');
+        card.classList.toggle('open', open);
+        content.style.transform = open ? 'translateX(' + -actionsWidth(card) + 'px)' : '';
+        toggle.setAttribute('aria-expanded', String(open));
+        if (open) {
+          actions.removeAttribute('inert');
+          cards.forEach(function (other) {
+            if (other !== card && other.classList.contains('open')) setOpen(other, false);
+          });
+        } else {
+          if (actions.contains(document.activeElement)) toggle.focus();
+          actions.setAttribute('inert', '');
+        }
+      }
+
+      function showStatus(card, message) {
+        var status = card.querySelector('.swipe-status');
+        status.textContent = message;
+        clearTimeout(status._timer);
+        status._timer = setTimeout(function () { status.textContent = ''; }, 2500);
+      }
+
+      cards.forEach(function (card) {
+        var content = card.querySelector('.swipe-content');
+        var startX = 0, startY = 0, baseOffset = 0, offset = 0;
+        var tracking = false, swiping = false, suppressClick = false;
+
+        content.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          tracking = true;
+          swiping = false;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseOffset = card.classList.contains('open') ? -actionsWidth(card) : 0;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (!tracking) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+          if (!swiping) {
+            if (Math.abs(dy) > SWIPE_THRESHOLD && Math.abs(dy) > Math.abs(dx)) {
+              tracking = false; // vertical scroll, let the browser handle it
+              return;
+            }
+            if (Math.abs(dx) < SWIPE_THRESHOLD) return;
+            swiping = true;
+            card.classList.add('dragging');
+            content.setPointerCapture(e.pointerId);
+          }
+          var max = actionsWidth(card);
+          offset = Math.min(0, Math.max(-max, baseOffset + dx));
+          content.style.transform = 'translateX(' + offset + 'px)';
+        });
+
+        function endSwipe() {
+          if (!tracking) return;
+          tracking = false;
+          if (!swiping) return;
+          swiping = false;
+          suppressClick = true;
+          card.classList.remove('dragging');
+          // Snap open or closed; a swipe only reveals actions, it never runs one.
+          setOpen(card, offset < -actionsWidth(card) / 2);
+        }
+
+        content.addEventListener('pointerup', endSwipe);
+        content.addEventListener('pointercancel', endSwipe);
+
+        // Prevent the click that follows a drag from following links or toggling.
+        content.addEventListener('click', function (e) {
+          if (suppressClick) {
+            suppressClick = false;
+            e.preventDefault();
+            e.stopPropagation();
+            return;
+          }
+          if (card.classList.contains('open') && !e.target.closest('.swipe-toggle')) {
+            e.preventDefault();
+            setOpen(card, false);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        card.querySelector('.swipe-toggle').addEventListener('click', function () {
+          setOpen(card, !card.classList.contains('open'));
+        });
+
+        card.querySelector('[data-action="favorite"]').addEventListener('click', function () {
+          var pressed = this.getAttribute('aria-pressed') !== 'true';
+          this.setAttribute('aria-pressed', String(pressed));
+          showStatus(card, pressed ? 'Added to favorites' : 'Removed from favorites');
+        });
+
+        card.querySelector('[data-action="share"]').addEventListener('click', function () {
+          var url = new URL(this.dataset.url, location.href).href;
+          var title = card.dataset.drink;
+          if (navigator.share) {
+            navigator.share({ title: title, url: url }).catch(function () {});
+          } else if (navigator.clipboard) {
+            navigator.clipboard.writeText(url).then(function () {
+              showStatus(card, 'Link copied');
+            }, function () {
+              showStatus(card, 'Could not copy link');
+            });
+          }
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.classList.contains('open')) setOpen(card, false);
+        });
+      });
+
+      document.addEventListener('pointerdown', function (e) {
+        cards.forEach(function (card) {
+          if (card.classList.contains('open') && !card.contains(e.target)) setOpen(card, false);
+        });
+      });
+
+      window.addEventListener('resize', function () {
+        cards.forEach(function (card) {
+          if (card.classList.contains('open')) setOpen(card, true);
+        });
+      });
+    })();
+  </script>
+
