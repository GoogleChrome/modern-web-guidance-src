+    /* Scrollytelling: Bean to Cup */
+    .story {
+      margin-top: 80px;
+    }
+
+    .story > h2 {
+      text-align: center;
+    }
+
+    .scrolly {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+      margin-top: 20px;
+    }
+
+    #tracked section {
+      min-height: 80vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    #tracked .step {
+      font-size: 0.8rem;
+      font-weight: bold;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      color: var(--accent);
+    }
+
+    #tracked h3 {
+      font-size: 1.8rem;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    /* Fallback (no scroll-driven animation support): images stay in normal flow */
+    #animated {
+      display: grid;
+      align-content: space-around;
+      gap: 20px;
+    }
+
+    #animated section {
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      aspect-ratio: 4 / 5;
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry) and (timeline-scope: none)) {
+      /* Hoist the timeline names so #animated (a different DOM branch) can see them */
+      .scrolly {
+        timeline-scope: --step-1, --step-2, --step-3, --step-4;
+      }
+
+      #tracked section:nth-child(1) { view-timeline-name: --step-1; }
+      #tracked section:nth-child(2) { view-timeline-name: --step-2; }
+      #tracked section:nth-child(3) { view-timeline-name: --step-3; }
+      #tracked section:nth-child(4) { view-timeline-name: --step-4; }
+
+      #animated {
+        position: sticky;
+        top: max(6rem, 15vh);
+        align-self: start;
+        display: grid;
+        height: 70vh;
+      }
+
+      /* Stack all images in the same cell */
+      #animated section {
+        grid-area: 1 / 1;
+        animation: reveal linear both;
+        animation-range: cover;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --step-1; }
+      #animated section:nth-child(2) { animation-timeline: --step-2; }
+      #animated section:nth-child(3) { animation-timeline: --step-3; }
+      #animated section:nth-child(4) { animation-timeline: --step-4; }
+
+      #animated img {
+        aspect-ratio: auto;
+      }
+
+      /* Visible while its text section passes through the middle of the viewport */
+      @keyframes reveal {
+        0%, 20% { opacity: 0; }
+        35%, 65% { opacity: 1; }
+        80%, 100% { opacity: 0; }
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        @keyframes reveal {
+          0%, 20% { opacity: 0; scale: 0.9; translate: 0 40px; }
+          35%, 65% { opacity: 1; scale: 1; translate: 0 0; }
+          80%, 100% { opacity: 0; scale: 1.05; translate: 0 -40px; }
+        }
+      }
+    }
+
+    @media (max-width: 700px) {
+      .scrolly {
+        grid-template-columns: 1fr;
+      }
+
+      #tracked section {
+        min-height: 0;
+        padding: 20px 0;
+      }
+
+      @supports ((animation-timeline: view()) and (animation-range: entry) and (timeline-scope: none)) {
+        /* Overlay text cards on top of the sticky image stack */
+        #tracked,
+        #animated {
+          grid-area: 1 / 1;
+        }
+
+        #tracked {
+          position: relative;
+          z-index: 1;
+        }
+
+        #tracked section {
+          min-height: 100vh;
+        }
+
+        #tracked .copy {
+          background: rgba(255, 255, 255, 0.92);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        }
+      }
+    }
+
