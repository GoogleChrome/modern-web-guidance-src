+  <script>
+    // Apply a "next" / "previous" view transition type based on the pagination
+    // direction. Only set up when the user hasn't asked for reduced motion.
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const pageOf = (url) => {
+        const page = parseInt(new URL(url).searchParams.get('page'), 10);
+        return Number.isInteger(page) && page > 0 ? page : 1;
+      };
+
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition || !window.navigation || !navigation.activation) return;
+
+        const { from, entry } = navigation.activation;
+        if (!from || !entry) return;
+
+        const fromUrl = new URL(from.url);
+        const toUrl = new URL(entry.url);
+        if (fromUrl.pathname !== toUrl.pathname) return;
+
+        const fromPage = pageOf(from.url);
+        const toPage = pageOf(entry.url);
+        if (toPage > fromPage) {
+          e.viewTransition.types.add('next');
+        } else if (toPage < fromPage) {
+          e.viewTransition.types.add('previous');
+        }
+      });
+    }
+  </script>
 </head>
 
