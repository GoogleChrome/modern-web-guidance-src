+    /* Page transitions (cross-document View Transitions) */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      /* Default: simple cross-fade for regular navigations */
+      ::view-transition-old(root),
+      ::view-transition-new(root) {
+        animation-duration: 0.35s;
+        animation-timing-function: ease-in-out;
+      }
+
+      /* Next: old page slides out to the left, new page slides in from the right */
+      html:active-view-transition-type(next)::view-transition-old(root) {
+        animation: 0.4s ease-in both slide-out-to-left;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(root) {
+        animation: 0.4s ease-out both slide-in-from-right;
+      }
+
+      /* Previous: old page slides out to the right, new page slides in from the left */
+      html:active-view-transition-type(previous)::view-transition-old(root) {
+        animation: 0.4s ease-in both slide-out-to-right;
+      }
+
+      html:active-view-transition-type(previous)::view-transition-new(root) {
+        animation: 0.4s ease-out both slide-in-from-left;
+      }
+    }
+
+    @keyframes slide-out-to-left {
