+  <link rel="expect" href="#main-content" blocking="render">
+  <script>
+    // Register before first render so the listener catches the pagereveal event.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const pageOf = (url) => Number(new URL(url).searchParams.get('page')) || 1;
+
+      // Fallback for browsers without the Navigation API: remember which link was clicked.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('#next, #previous');
+        if (link) sessionStorage.setItem('transition-type', link.id);
+      });
+
+      window.addEventListener('pagereveal', (e) => {
+        const storedType = sessionStorage.getItem('transition-type');
+        sessionStorage.removeItem('transition-type');
+        if (!e.viewTransition) return;
+
+        let type = storedType;
+        const activation = window.navigation?.activation;
+        if (activation?.from && activation.entry) {
+          const from = pageOf(activation.from.url);
+          const to = pageOf(activation.entry.url);
+          type = to > from ? 'next' : to < from ? 'previous' : null;
+        }
+        if (type) e.viewTransition.types.add(type);
+      });
+    }
+  </script>
