diff --git a/server.js b/server.js
new file mode 100644
index 0000000..e2b03f2
--- /dev/null
+++ b/server.js
@@ -0,0 +1,290 @@
+// The Daily Grind web server: serves the homepage and the rewards sign-up
+// endpoint that verifies email ownership with the browser-assisted Email
+// Verification Protocol (no one-time passcodes or magic links).
+
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { verifyEmailVerificationToken, EvpVerificationError } from './lib/evp-verify.js';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+// The exact origin customers load the site from. The browser binds the token
+// to this value (KB-JWT `aud`), so it must be configured explicitly in
+// production rather than derived from the spoofable Host header.
+const RP_ORIGIN = (process.env.RP_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const SECURE_COOKIES = RP_ORIGIN.startsWith('https://');
+const ACCOUNTS_FILE = process.env.REWARDS_ACCOUNTS_FILE || path.join(ROOT, 'data', 'rewards-accounts.json');
+
+const SESSION_COOKIE = 'dg_signup';
+const NONCE_TTL_MS = 15 * 60 * 1000;
+const MAX_SESSIONS = 50_000;
+const MAX_BODY_BYTES = 16 * 1024;
+
+// ---------------------------------------------------------------------------
+// Sign-up sessions: one live nonce per browser session, single use.
+// ---------------------------------------------------------------------------
+
+const sessions = new Map(); // sessionId -> { nonce, expires }
+
+function issueNonce(sessionId) {
+  if (!sessions.has(sessionId) && sessions.size >= MAX_SESSIONS) {
+    sessions.delete(sessions.keys().next().value);
+  }
+  const nonce = crypto.randomBytes(32).toString('base64url');
+  sessions.set(sessionId, { nonce, expires: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+function takeNonce(sessionId) {
+  const entry = sessionId && sessions.get(sessionId);
+  if (!entry) return null;
+  sessions.delete(sessionId);
+  return entry.expires > Date.now() ? entry.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, entry] of sessions) if (entry.expires <= now) sessions.delete(id);
+}, 60_000).unref();
+
+function getSessionId(req) {
+  const match = /(?:^|;\s*)dg_signup=([A-Za-z0-9_-]{43})(?:;|$)/.exec(req.headers.cookie || '');
+  return match ? match[1] : null;
+}
+
+function ensureSession(req, res) {
+  let id = getSessionId(req);
+  if (!id) {
+    id = crypto.randomBytes(32).toString('base64url');
+    const attrs = [`${SESSION_COOKIE}=${id}`, 'Path=/', 'HttpOnly', 'SameSite=Lax', 'Max-Age=86400'];
+    if (SECURE_COOKIES) attrs.push('Secure');
+    res.setHeader('Set-Cookie', attrs.join('; '));
+  }
+  return id;
+}
+
+// ---------------------------------------------------------------------------
+// Rewards accounts (JSON file store)
+// ---------------------------------------------------------------------------
+
+let accounts = null;
+let writeQueue = Promise.resolve();
+
+async function loadAccounts() {
+  if (accounts) return accounts;
+  try {
+    accounts = JSON.parse(await fs.readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+    accounts = [];
+  }
+  return accounts;
+}
+
+function persistAccounts() {
+  writeQueue = writeQueue.then(async () => {
+    await fs.mkdir(path.dirname(ACCOUNTS_FILE), { recursive: true });
+    const tmp = `${ACCOUNTS_FILE}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(accounts, null, 2));
+    await fs.rename(tmp, ACCOUNTS_FILE);
+  });
+  return writeQueue;
+}
+
+// ---------------------------------------------------------------------------
+// HTTP helpers
+// ---------------------------------------------------------------------------
+
+const SECURITY_HEADERS = {
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-Frame-Options': 'DENY',
+};
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, data) {
+  send(res, status, JSON.stringify(data), { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+}
+
+function readForm(req) {
+  return new Promise((resolve, reject) => {
+    const type = (req.headers['content-type'] || '').split(';')[0].trim();
+    if (type !== 'application/x-www-form-urlencoded') {
+      reject(Object.assign(new Error('Unsupported content type'), { status: 415 }));
+      req.resume();
+      return;
+    }
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(new URLSearchParams(Buffer.concat(chunks).toString('utf8'))));
+    req.on('error', reject);
+  });
+}
+
+const escapeAttr = (s) => s.replace(/[&"<>]/g, (c) => ({ '&': '&amp;', '"': '&quot;', '<': '&lt;', '>': '&gt;' })[c]);
+
+// ---------------------------------------------------------------------------
+// Routes
+// ---------------------------------------------------------------------------
+
+let indexTemplate = null;
+
+async function serveHome(req, res) {
+  indexTemplate ??= await fs.readFile(path.join(ROOT, 'index.html'), 'utf8');
+  const nonce = issueNonce(ensureSession(req, res));
+  const html = indexTemplate.replaceAll('{{EVP_NONCE}}', escapeAttr(nonce));
+  send(res, 200, req.method === 'HEAD' ? undefined : html, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function serveNonce(req, res) {
+  sendJson(res, 200, { nonce: issueNonce(ensureSession(req, res)) });
+}
+
+const FRIENDLY_ERRORS = {
+  missing_token:
+    "We couldn't verify your email automatically. Please choose your email from your browser's autofill suggestions. If none appear, your browser or email provider doesn't support instant verification yet.",
+  issuer_not_found: "Your email provider doesn't support instant browser verification yet.",
+  issuer_unavailable: "We couldn't reach your email provider to confirm your address. Please try again in a moment.",
+  token_expired: 'Your verification expired. Please submit the form again.',
+  wrong_nonce: 'Your sign-up session expired. Please submit the form again.',
+  nonce_expired: 'Your sign-up session expired. Please submit the form again.',
+  email_mismatch: "The email you entered doesn't match the one your browser verified.",
+  account_exists: 'A rewards account already exists for this email. Try signing in instead.',
+  invalid_input: 'Please fill in your name, email, and accept the rewards terms.',
+};
+const GENERIC_ERROR = "We couldn't verify that you own this email address.";
+
+class SignupError extends Error {
+  constructor(status, code) {
+    super(code);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+async function handleSignup(req, res) {
+  const wantsJson = (req.headers.accept || '').includes('application/json');
+  const sessionId = getSessionId(req);
+
+  const respond = (status, payload) => {
+    if (wantsJson) {
+      // On failure hand back a fresh nonce so the page can retry without reloading.
+      if (!payload.ok && sessionId) payload.nonce = issueNonce(sessionId);
+      return sendJson(res, status, payload);
+    }
+    const query = payload.ok ? 'rewards=welcome' : `rewards=error&reason=${encodeURIComponent(payload.error)}`;
+    send(res, 303, undefined, { Location: `/?${query}#rewards`, 'Cache-Control': 'no-store' });
+  };
+
+  try {
+    // Cross-site form posts can't produce a valid token for our origin, but
+    // reject them up front anyway.
+    const origin = req.headers.origin;
+    if (origin && origin !== RP_ORIGIN) throw new SignupError(403, 'bad_origin');
+
+    const form = await readForm(req);
+    const name = (form.get('name') || '').trim();
+    const email = (form.get('email') || '').trim();
+    const token = (form.get('email_verification_token') || '').trim();
+    const birthdayMonth = form.get('birthday_month') || '';
+    const agreed = form.get('terms') === 'on';
+
+    if (!name || name.length > 80 || !email || email.length > 254 || !agreed) {
+      throw new SignupError(400, 'invalid_input');
+    }
+    if (birthdayMonth && !/^(?:[1-9]|1[0-2])$/.test(birthdayMonth)) {
+      throw new SignupError(400, 'invalid_input');
+    }
+    if (!token) throw new SignupError(400, 'missing_token');
+
+    const nonce = takeNonce(sessionId);
+    if (!nonce) throw new SignupError(400, 'nonce_expired');
+
+    const verified = await verifyEmailVerificationToken(token, { audience: RP_ORIGIN, nonce });
+
+    // The verified address is authoritative; it must be the one the customer typed.
+    if (verified.email.toLowerCase() !== email.toLowerCase()) {
+      throw new SignupError(400, 'email_mismatch');
+    }
+
+    const list = await loadAccounts();
+    const normalized = verified.email.toLowerCase();
+    if (list.some((a) => a.email.toLowerCase() === normalized)) {
+      throw new SignupError(409, 'account_exists');
+    }
+    const account = {
+      id: crypto.randomUUID(),
+      name,
+      email: verified.email,
+      emailVerified: true,
+      emailVerification: {
+        method: 'browser-evp',
+        issuer: verified.issuer,
+        isPrivateEmail: verified.isPrivateEmail,
+        verifiedAt: new Date().toISOString(),
+      },
+      birthdayMonth: birthdayMonth ? Number(birthdayMonth) : null,
+      points: 50, // welcome bonus
+      createdAt: new Date().toISOString(),
+    };
+    list.push(account);
+    await persistAccounts();
+
+    respond(201, {
+      ok: true,
+      account: { name: account.name, email: account.email, points: account.points },
+    });
+  } catch (err) {
+    if (err instanceof EvpVerificationError || err instanceof SignupError) {
+      const status = err instanceof SignupError ? err.status : 400;
+      if (err instanceof EvpVerificationError) console.warn(`[rewards] verification failed: ${err.code}: ${err.message}`);
+      return respond(status, { ok: false, error: err.code, message: FRIENDLY_ERRORS[err.code] || GENERIC_ERROR });
+    }
+    if (err.status === 413 || err.status === 415) {
+      return respond(err.status, { ok: false, error: 'invalid_input', message: FRIENDLY_ERRORS.invalid_input });
+    }
+    console.error('[rewards] sign-up error', err);
+    respond(500, { ok: false, error: 'server_error', message: 'Something went wrong. Please try again.' });
+  }
+}
+
+const server = http.createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, 'http://localhost');
+  try {
+    if ((pathname === '/' || pathname === '/index.html') && (req.method === 'GET' || req.method === 'HEAD')) {
+      return await serveHome(req, res);
+    }
+    if (pathname === '/api/rewards/nonce' && req.method === 'GET') return serveNonce(req, res);
+    if (pathname === '/api/rewards/signup') {
+      if (req.method !== 'POST') return send(res, 405, 'Method Not Allowed', { Allow: 'POST' });
+      return await handleSignup(req, res);
+    }
+    send(res, 404, 'Not Found', { 'Content-Type': 'text/plain' });
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) send(res, 500, 'Internal Server Error');
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on :${PORT} (RP origin ${RP_ORIGIN})`);
+});
diff --git a/test/evp-verify.test.js b/test/evp-verify.test.js
new file mode 100644
index 0000000..41dbb23
--- /dev/null
+++ b/test/evp-verify.test.js
@@ -0,0 +1,148 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { verifyEmailVerificationToken, createDiscovery, emailDomain } from '../lib/evp-verify.js';
+import { isPublicAddress } from '../lib/safe-fetch.js';
+
+const AUD = 'https://dailygrind.example';
+const NONCE = 'n-0S6_WzA2Mj';
+const ISSUER = 'https://issuer.example';
+
+const issuerKeys = crypto.generateKeyPairSync('ed25519');
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', alg: 'Ed25519' };
+const browserKeys = crypto.generateKeyPairSync('ed25519');
+const browserJwk = { ...browserKeys.publicKey.export({ format: 'jwk' }), alg: 'Ed25519' };
+
+const b64 = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');
+function sign(header, payload, privateKey) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  return `${input}.${crypto.sign(null, Buffer.from(input), privateKey).toString('base64url')}`;
+}
+
+function makeToken({ evtHeader = {}, evtClaims = {}, kbHeader = {}, kbClaims = {}, issuerKey = issuerKeys.privateKey, browserKey = browserKeys.privateKey } = {}) {
+  const now = Math.floor(Date.now() / 1000);
+  const evt = sign(
+    { alg: 'Ed25519', kid: 'k1', typ: 'evt+jwt', ...evtHeader },
+    { iss: ISSUER, iat: now, cnf: { jwk: browserJwk }, email: 'barista@mail.example', email_verified: true, ...evtClaims },
+    issuerKey,
+  );
+  const sdHash = crypto.createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = sign(
+    { alg: 'Ed25519', typ: 'kb+jwt', ...kbHeader },
+    { aud: AUD, nonce: NONCE, iat: now, sd_hash: sdHash, ...kbClaims },
+    browserKey,
+  );
+  return `${evt}~${kb}`;
+}
+
+function discovery({ txt = [['iss=issuer.example']], metadata, jwks } = {}) {
+  const docs = {
+    [`${ISSUER}/.well-known/email-verification`]: metadata ?? {
+      issuer: ISSUER,
+      issuance_endpoint: `${ISSUER}/issue`,
+      jwks_uri: `${ISSUER}/jwks.json`,
+    },
+    [`${ISSUER}/jwks.json`]: jwks ?? { keys: [issuerJwk] },
+  };
+  return createDiscovery({
+    resolveTxt: async (name) => {
+      assert.equal(name, '_email-verification.mail.example');
+      return txt;
+    },
+    fetchJson: async (url) => {
+      if (!(url in docs)) throw new Error(`unexpected fetch ${url}`);
+      return docs[url];
+    },
+  });
+}
+
+const verify = (token, opts = {}) =>
+  verifyEmailVerificationToken(token, { audience: AUD, nonce: NONCE, discovery: discovery(), ...opts });
+
+const rejectsWith = (promise, code) => assert.rejects(promise, (err) => err.code === code);
+
+test('accepts a valid EVT+KB token', async () => {
+  const result = await verify(makeToken());
+  assert.deepEqual(result, { email: 'barista@mail.example', issuer: ISSUER, isPrivateEmail: false });
+});
+
+test('accepts legacy evp-sd-jwt typ with EdDSA alg on Ed25519 keys', async () => {
+  const legacyBrowserJwk = { ...browserJwk };
+  delete legacyBrowserJwk.alg;
+  const token = makeToken({
+    evtHeader: { alg: 'EdDSA', typ: 'evp-sd-jwt' },
+    evtClaims: { cnf: { jwk: legacyBrowserJwk } },
+    kbHeader: { alg: 'EdDSA' },
+  });
+  const jwk = { ...issuerJwk };
+  delete jwk.alg;
+  const d = discovery({
+    metadata: { issuer: ISSUER, jwks_uri: `${ISSUER}/jwks.json`, signing_alg_values_supported: ['EdDSA'] },
+    jwks: { keys: [jwk] },
+  });
+  assert.equal((await verify(token, { discovery: d })).email, 'barista@mail.example');
+});
+
+test('rejects a token minted for another site', () => rejectsWith(verify(makeToken({ kbClaims: { aud: 'https://evil.example' } })), 'wrong_audience'));
+
+test('rejects a token bound to a different nonce', () => rejectsWith(verify(makeToken({ kbClaims: { nonce: 'other' } })), 'wrong_nonce'));
+
+test('rejects stale tokens', () => {
+  const old = Math.floor(Date.now() / 1000) - 3600;
+  return rejectsWith(verify(makeToken({ kbClaims: { iat: old } })), 'token_expired');
+});
+
+test('rejects KB-JWT signed by a key other than cnf.jwk', () =>
+  rejectsWith(verify(makeToken({ browserKey: crypto.generateKeyPairSync('ed25519').privateKey })), 'bad_signature'));
+
+test('rejects EVT forged with a key the issuer does not publish', () =>
+  rejectsWith(verify(makeToken({ issuerKey: crypto.generateKeyPairSync('ed25519').privateKey })), 'bad_signature'));
+
+test('rejects EVT whose iss is not the DNS-designated issuer', () =>
+  rejectsWith(verify(makeToken({ evtClaims: { iss: 'https://attacker.example' } })), 'issuer_mismatch'));
+
+test('rejects when the email domain publishes no issuer', () =>
+  rejectsWith(verify(makeToken(), { discovery: discovery({ txt: [] }) }), 'issuer_not_found'));
+
+test('rejects issuer records with paths or ports', () =>
+  rejectsWith(verify(makeToken(), { discovery: discovery({ txt: [['iss=issuer.example:8443']] }) }), 'issuer_not_found'));
+
+test('rejects metadata that claims a different issuer', () =>
+  rejectsWith(
+    verify(makeToken(), { discovery: discovery({ metadata: { issuer: 'https://other.example', jwks_uri: `${ISSUER}/jwks.json` } }) }),
+    'issuer_mismatch',
+  ));
+
+test('rejects email_verified false', () => rejectsWith(verify(makeToken({ evtClaims: { email_verified: false } })), 'email_not_verified'));
+
+test('rejects tampered EVT (sd_hash mismatch)', async () => {
+  const token = makeToken();
+  const otherEvt = makeToken({ evtClaims: { email: 'victim@mail.example' } }).split('~')[0];
+  await rejectsWith(verify(`${otherEvt}~${token.split('~')[1]}`), 'malformed_token');
+});
+
+test('rejects alg none and MAC algorithms', async () => {
+  await rejectsWith(verify(makeToken({ evtHeader: { alg: 'none' } })), 'unsupported_alg');
+  await rejectsWith(verify(makeToken({ kbHeader: { alg: 'HS256' } })), 'unsupported_alg');
+});
+
+test('rejects malformed input', async () => {
+  await rejectsWith(verify(''), 'missing_token');
+  await rejectsWith(verify('abc'), 'malformed_token');
+  await rejectsWith(verify('a.b.c~d.e.f~g'), 'malformed_token');
+});
+
+test('emailDomain normalizes and validates', () => {
+  assert.equal(emailDomain('a@Mail.Example'), 'mail.example');
+  assert.equal(emailDomain('a@localhost'), null);
+  assert.equal(emailDomain('a@10.0.0.1:80'), null);
+});
+
+test('safe fetch blocks private addresses', () => {
+  assert.equal(isPublicAddress('127.0.0.1', 4), false);
+  assert.equal(isPublicAddress('169.254.169.254', 4), false);
+  assert.equal(isPublicAddress('::1', 6), false);
+  assert.equal(isPublicAddress('fd00::1', 6), false);
+  assert.equal(isPublicAddress('::ffff:10.0.0.1', 6), false);
+  assert.equal(isPublicAddress('93.184.216.34', 4), true);
+});
