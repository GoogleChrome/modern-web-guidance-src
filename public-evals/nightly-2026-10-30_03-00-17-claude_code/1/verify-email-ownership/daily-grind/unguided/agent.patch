diff --git a/lib/evp-verify.js b/lib/evp-verify.js
new file mode 100644
index 0000000..2c02542
--- /dev/null
+++ b/lib/evp-verify.js
@@ -0,0 +1,296 @@
+// Server-side verification of browser-assisted email verification tokens
+// (WICG Email Verification Protocol, draft-hardt-email-verification-02).
+//
+// When the customer picks their address from the browser's autofill, the
+// browser fetches a signed Email Verification Token (EVT) from the email
+// domain's issuer, binds it to our origin + nonce with a Key Binding JWT, and
+// drops the result into the hidden `autocomplete="email-verification-token"`
+// field on submit. The token looks like:
+//
+//   <EVT JWT>~<KB-JWT>
+//
+// We must check both halves and discover the issuer ourselves via DNS so the
+// customer never has to receive a one-time code or magic link.
+
+import crypto from 'node:crypto';
+import dns from 'node:dns/promises';
+import { domainToASCII } from 'node:url';
+import { safeFetchJson } from './safe-fetch.js';
+
+const MAX_TOKEN_LENGTH = 8192;
+const MAX_AGE_SECONDS = 300;
+const CLOCK_SKEW_SECONDS = 60;
+const DISCOVERY_CACHE_MS = 10 * 60 * 1000;
+
+// draft-02 uses `evt+jwt`; the explainer's earlier examples use `evp-sd-jwt`.
+const EVT_TYPES = new Set(['evt+jwt', 'evp-sd-jwt']);
+const KB_TYPE = 'kb+jwt';
+const DEFAULT_ISSUER_ALGS = ['Ed25519'];
+
+// Fully-specified algorithms we accept, mapped to the only key shape each may
+// be used with. `EdDSA` is accepted solely as a legacy alias for Ed25519 keys
+// (earlier drafts / browser builds emitted it); the key type pins the curve so
+// this doesn't open up algorithm confusion.
+const ALGORITHMS = {
+  Ed25519: { kty: 'OKP', crv: 'Ed25519', hash: null, dsaEncoding: undefined },
+  EdDSA: { kty: 'OKP', crv: 'Ed25519', hash: null, dsaEncoding: undefined },
+  ES256: { kty: 'EC', crv: 'P-256', hash: 'sha256', dsaEncoding: 'ieee-p1363' },
+};
+
+export class EvpVerificationError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.name = 'EvpVerificationError';
+    this.code = code;
+  }
+}
+
+const fail = (code, message) => {
+  throw new EvpVerificationError(code, message);
+};
+
+const B64URL = /^[A-Za-z0-9_-]+$/;
+
+function b64urlJson(segment, what) {
+  if (!B64URL.test(segment)) fail('malformed_token', `${what} is not base64url`);
+  try {
+    const value = JSON.parse(Buffer.from(segment, 'base64url').toString('utf8'));
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error();
+    return value;
+  } catch {
+    fail('malformed_token', `${what} is not a JSON object`);
+  }
+}
+
+function parseJwt(jwt, what) {
+  const parts = jwt.split('.');
+  if (parts.length !== 3 || parts.some((p) => !B64URL.test(p))) {
+    fail('malformed_token', `${what} is not a compact JWS`);
+  }
+  return {
+    header: b64urlJson(parts[0], `${what} header`),
+    payload: b64urlJson(parts[1], `${what} payload`),
+    signingInput: Buffer.from(`${parts[0]}.${parts[1]}`, 'ascii'),
+    signature: Buffer.from(parts[2], 'base64url'),
+  };
+}
+
+function importPublicJwk(jwk, alg, what) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) fail('unsupported_alg', `${what} uses unsupported alg ${JSON.stringify(alg)}`);
+  if (!jwk || typeof jwk !== 'object') fail('invalid_key', `${what} key missing`);
+  if ('d' in jwk) fail('invalid_key', `${what} key must not contain private material`);
+  if (jwk.kty !== spec.kty || jwk.crv !== spec.crv) {
+    fail('invalid_key', `${what} key type does not match alg ${alg}`);
+  }
+  const publicParts = spec.kty === 'OKP'
+    ? { kty: jwk.kty, crv: jwk.crv, x: jwk.x }
+    : { kty: jwk.kty, crv: jwk.crv, x: jwk.x, y: jwk.y };
+  try {
+    return crypto.createPublicKey({ key: publicParts, format: 'jwk' });
+  } catch {
+    fail('invalid_key', `${what} key could not be imported`);
+  }
+}
+
+function verifySignature(parsed, key, alg) {
+  const spec = ALGORITHMS[alg];
+  const keyObject = spec.dsaEncoding ? { key, dsaEncoding: spec.dsaEncoding } : key;
+  try {
+    return crypto.verify(spec.hash, parsed.signingInput, keyObject, parsed.signature);
+  } catch {
+    return false;
+  }
+}
+
+function checkIat(iat, nowSeconds, what) {
+  if (!Number.isInteger(iat)) fail('invalid_claims', `${what} iat missing`);
+  if (iat > nowSeconds + CLOCK_SKEW_SECONDS) fail('token_expired', `${what} iat is in the future`);
+  if (nowSeconds - iat > MAX_AGE_SECONDS) fail('token_expired', `${what} is too old`);
+}
+
+function safeEqual(a, b) {
+  if (typeof a !== 'string' || typeof b !== 'string') return false;
+  const ab = Buffer.from(a);
+  const bb = Buffer.from(b);
+  return ab.length === bb.length && crypto.timingSafeEqual(ab, bb);
+}
+
+// Hostnames only: lowercase LDH labels, no port, path, or trailing dot.
+const HOSTNAME = /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/;
+
+export function emailDomain(email) {
+  if (typeof email !== 'string' || email.length > 254) return null;
+  const at = email.lastIndexOf('@');
+  if (at < 1 || at === email.length - 1) return null;
+  const ascii = domainToASCII(email.slice(at + 1).toLowerCase());
+  return HOSTNAME.test(ascii) ? ascii : null;
+}
+
+// ---------------------------------------------------------------------------
+// Issuer discovery: DNS TXT -> /.well-known/email-verification -> jwks_uri
+// ---------------------------------------------------------------------------
+
+export function createDiscovery({
+  resolveTxt = (name) => dns.resolveTxt(name),
+  fetchJson = safeFetchJson,
+  cacheMs = DISCOVERY_CACHE_MS,
+} = {}) {
+  const cache = new Map();
+
+  async function cached(key, load) {
+    const hit = cache.get(key);
+    if (hit && hit.expires > Date.now()) return hit.value;
+    const value = await load();
+    cache.set(key, { value, expires: Date.now() + cacheMs });
+    return value;
+  }
+
+  async function issuerForDomain(domain) {
+    let records;
+    try {
+      records = await resolveTxt(`_email-verification.${domain}`);
+    } catch {
+      fail('issuer_not_found', `No email verification issuer published for ${domain}`);
+    }
+    const issRecords = records
+      .map((chunks) => (Array.isArray(chunks) ? chunks.join('') : String(chunks)))
+      .filter((txt) => txt.startsWith('iss='));
+    if (issRecords.length !== 1) {
+      fail('issuer_not_found', `Expected exactly one issuer record for ${domain}`);
+    }
+    const host = issRecords[0].slice(4).trim();
+    if (!HOSTNAME.test(host)) fail('issuer_not_found', `Invalid issuer host for ${domain}`);
+    return `https://${host}`;
+  }
+
+  async function issuerMetadata(issuer) {
+    return cached(`meta:${issuer}`, async () => {
+      let metadata;
+      try {
+        metadata = await fetchJson(`${issuer}/.well-known/email-verification`);
+      } catch (err) {
+        fail('issuer_unavailable', `Could not load issuer metadata: ${err.message}`);
+      }
+      if (!metadata || metadata.issuer !== issuer) {
+        fail('issuer_mismatch', 'Issuer metadata does not match issuer identifier');
+      }
+      let jwksUrl;
+      try {
+        jwksUrl = new URL(metadata.jwks_uri);
+      } catch {
+        fail('issuer_unavailable', 'Issuer metadata has no valid jwks_uri');
+      }
+      if (jwksUrl.protocol !== 'https:') fail('issuer_unavailable', 'jwks_uri must be https');
+      const algs = Array.isArray(metadata.signing_alg_values_supported)
+        ? metadata.signing_alg_values_supported
+        : DEFAULT_ISSUER_ALGS;
+      return { jwksUri: jwksUrl.href, algs };
+    });
+  }
+
+  async function issuerKey(jwksUri, kid) {
+    const load = async () => {
+      let jwks;
+      try {
+        jwks = await fetchJson(jwksUri);
+      } catch (err) {
+        fail('issuer_unavailable', `Could not load issuer keys: ${err.message}`);
+      }
+      if (!jwks || !Array.isArray(jwks.keys)) fail('issuer_unavailable', 'Issuer JWKS is malformed');
+      return jwks.keys;
+    };
+    let keys = await cached(`jwks:${jwksUri}`, load);
+    let jwk = keys.find((k) => k && k.kid === kid);
+    if (!jwk) {
+      // Issuer may have rotated keys since we cached; refetch once.
+      cache.delete(`jwks:${jwksUri}`);
+      keys = await cached(`jwks:${jwksUri}`, load);
+      jwk = keys.find((k) => k && k.kid === kid);
+    }
+    if (!jwk) fail('invalid_key', 'Issuer signing key not found');
+    return jwk;
+  }
+
+  return { issuerForDomain, issuerMetadata, issuerKey };
+}
+
+const defaultDiscovery = createDiscovery();
+
+// ---------------------------------------------------------------------------
+// Token verification
+// ---------------------------------------------------------------------------
+
+/**
+ * Verify an EVT+KB presentation token.
+ *
+ * @param {string} token              Value of the email-verification-token field.
+ * @param {object} opts
+ * @param {string} opts.audience      Our exact origin, e.g. "https://dailygrind.example".
+ * @param {string} opts.nonce         The nonce we issued for this session.
+ * @param {object} [opts.discovery]   Override issuer discovery (tests).
+ * @param {number} [opts.now]         Override current time in ms (tests).
+ * @returns {Promise<{email: string, issuer: string, isPrivateEmail: boolean}>}
+ */
+export async function verifyEmailVerificationToken(token, { audience, nonce, discovery = defaultDiscovery, now = Date.now() }) {
+  if (!audience || !nonce) throw new Error('audience and nonce are required');
+  if (typeof token !== 'string' || token.length === 0) {
+    fail('missing_token', 'No email verification token was provided');
+  }
+  if (token.length > MAX_TOKEN_LENGTH) fail('malformed_token', 'Token too large');
+
+  const nowSeconds = Math.floor(now / 1000);
+
+  // EVT+KB is an SD-JWT with no disclosures: "<jwt>~<kb-jwt>".
+  const segments = token.split('~');
+  if (segments.length !== 2 || !segments[0] || !segments[1]) {
+    fail('malformed_token', 'Token must be <EVT>~<KB-JWT>');
+  }
+  const [evtJwt, kbJwt] = segments;
+  const evt = parseJwt(evtJwt, 'EVT');
+  const kb = parseJwt(kbJwt, 'KB-JWT');
+
+  // --- EVT structure & claims (§5.3) ---
+  const { header: evtHeader, payload: claims } = evt;
+  if (!EVT_TYPES.has(evtHeader.typ)) fail('malformed_token', 'EVT has wrong typ');
+  if (!ALGORITHMS[evtHeader.alg]) fail('unsupported_alg', 'EVT alg is not supported');
+  if (typeof evtHeader.kid !== 'string' || !evtHeader.kid) fail('malformed_token', 'EVT kid missing');
+  if (typeof claims.iss !== 'string') fail('invalid_claims', 'EVT iss missing');
+  if (typeof claims.email !== 'string') fail('invalid_claims', 'EVT email missing');
+  if (claims.email_verified !== true) fail('email_not_verified', 'Issuer did not assert email_verified');
+  if (!claims.cnf || typeof claims.cnf.jwk !== 'object') fail('invalid_claims', 'EVT cnf.jwk missing');
+  checkIat(claims.iat, nowSeconds, 'EVT');
+
+  // --- KB-JWT structure & claims (§6.5) ---
+  const { header: kbHeader, payload: kbClaims } = kb;
+  const cnfJwk = claims.cnf.jwk;
+  if (kbHeader.typ !== KB_TYPE) fail('malformed_token', 'KB-JWT has wrong typ');
+  if (cnfJwk.alg !== undefined && kbHeader.alg !== cnfJwk.alg) {
+    fail('unsupported_alg', 'KB-JWT alg does not match cnf.jwk alg');
+  }
+  if (!safeEqual(kbClaims.aud, audience)) fail('wrong_audience', 'Token was not issued for this site');
+  if (!safeEqual(kbClaims.nonce, nonce)) fail('wrong_nonce', 'Token nonce does not match this session');
+  checkIat(kbClaims.iat, nowSeconds, 'KB-JWT');
+  const expectedSdHash = crypto.createHash('sha256').update(`${evtJwt}~`, 'ascii').digest('base64url');
+  if (!safeEqual(kbClaims.sd_hash, expectedSdHash)) fail('malformed_token', 'KB-JWT sd_hash mismatch');
+
+  const holderKey = importPublicJwk(cnfJwk, kbHeader.alg, 'cnf.jwk');
+  if (!verifySignature(kb, holderKey, kbHeader.alg)) fail('bad_signature', 'KB-JWT signature is invalid');
+
+  // --- Issuer discovery & EVT signature ---
+  const domain = emailDomain(claims.email);
+  if (!domain) fail('invalid_claims', 'EVT email is not a valid address');
+  const issuer = await discovery.issuerForDomain(domain);
+  if (claims.iss !== issuer) fail('issuer_mismatch', 'EVT iss is not the issuer for this email domain');
+
+  const { jwksUri, algs } = await discovery.issuerMetadata(issuer);
+  if (!algs.includes(evtHeader.alg)) fail('unsupported_alg', 'Issuer does not advertise EVT alg');
+  const issuerJwk = await discovery.issuerKey(jwksUri, evtHeader.kid);
+  if (issuerJwk.alg !== undefined && issuerJwk.alg !== evtHeader.alg) {
+    fail('invalid_key', 'Issuer key alg does not match EVT alg');
+  }
+  const issuerKey = importPublicJwk(issuerJwk, evtHeader.alg, 'issuer');
+  if (!verifySignature(evt, issuerKey, evtHeader.alg)) fail('bad_signature', 'EVT signature is invalid');
+
+  return { email: claims.email, issuer, isPrivateEmail: claims.is_private_email === true };
+}
diff --git a/lib/safe-fetch.js b/lib/safe-fetch.js
new file mode 100644
index 0000000..7291e52
--- /dev/null
+++ b/lib/safe-fetch.js
@@ -0,0 +1,103 @@
+// Minimal hardened HTTPS JSON fetcher used for issuer discovery.
+//
+// The issuer host comes from a DNS record controlled by whoever owns the
+// email domain the customer typed, so every request here is effectively
+// attacker-directed. To avoid SSRF we only speak HTTPS, refuse to connect to
+// private / loopback / link-local addresses (checked at connect time, so DNS
+// rebinding can't sneak past), never follow redirects, and cap both the
+// response size and the time we're willing to wait.
+
+import https from 'node:https';
+import dns from 'node:dns';
+import net from 'node:net';
+
+const TIMEOUT_MS = 5000;
+const MAX_BYTES = 64 * 1024;
+
+const blocked = new net.BlockList();
+// IPv4
+blocked.addSubnet('0.0.0.0', 8, 'ipv4');
+blocked.addSubnet('10.0.0.0', 8, 'ipv4');
+blocked.addSubnet('100.64.0.0', 10, 'ipv4');
+blocked.addSubnet('127.0.0.0', 8, 'ipv4');
+blocked.addSubnet('169.254.0.0', 16, 'ipv4');
+blocked.addSubnet('172.16.0.0', 12, 'ipv4');
+blocked.addSubnet('192.0.0.0', 24, 'ipv4');
+blocked.addSubnet('192.168.0.0', 16, 'ipv4');
+blocked.addSubnet('198.18.0.0', 15, 'ipv4');
+blocked.addSubnet('224.0.0.0', 3, 'ipv4');
+// IPv6
+blocked.addAddress('::', 'ipv6');
+blocked.addAddress('::1', 'ipv6');
+// IPv4-mapped IPv6 (::ffff:a.b.c.d) is matched against the IPv4 rules by BlockList.
+blocked.addSubnet('64:ff9b::', 96, 'ipv6');
+blocked.addSubnet('fc00::', 7, 'ipv6');
+blocked.addSubnet('fe80::', 10, 'ipv6');
+blocked.addSubnet('ff00::', 8, 'ipv6');
+
+export function isPublicAddress(address, family) {
+  const type = family === 6 || family === 'IPv6' ? 'ipv6' : 'ipv4';
+  return !blocked.check(address, type);
+}
+
+function publicOnlyLookup(hostname, options, callback) {
+  dns.lookup(hostname, { ...options, all: true }, (err, addresses) => {
+    if (err) return callback(err);
+    const list = Array.isArray(addresses) ? addresses : [{ address: addresses, family: options.family }];
+    const bad = list.find((a) => !isPublicAddress(a.address, a.family));
+    if (bad || list.length === 0) {
+      return callback(new Error(`Refusing to connect to non-public address for ${hostname}`));
+    }
+    if (options.all) return callback(null, list);
+    callback(null, list[0].address, list[0].family);
+  });
+}
+
+export function safeFetchJson(urlString) {
+  return new Promise((resolve, reject) => {
+    let url;
+    try {
+      url = new URL(urlString);
+    } catch {
+      return reject(new Error('Invalid URL'));
+    }
+    if (url.protocol !== 'https:' || url.username || url.password) {
+      return reject(new Error('Only plain https:// URLs are allowed'));
+    }
+
+    const req = https.get(
+      url,
+      {
+        lookup: publicOnlyLookup,
+        timeout: TIMEOUT_MS,
+        headers: { accept: 'application/json', 'user-agent': 'DailyGrind-Rewards/1.0' },
+      },
+      (res) => {
+        if (res.statusCode !== 200) {
+          res.resume();
+          return reject(new Error(`Unexpected HTTP ${res.statusCode} from ${url.origin}`));
+        }
+        let size = 0;
+        const chunks = [];
+        res.on('data', (chunk) => {
+          size += chunk.length;
+          if (size > MAX_BYTES) {
+            req.destroy(new Error('Response too large'));
+            return;
+          }
+          chunks.push(chunk);
+        });
+        res.on('end', () => {
+          try {
+            resolve(JSON.parse(Buffer.concat(chunks).toString('utf8')));
+          } catch {
+            reject(new Error(`Invalid JSON from ${url.href}`));
+          }
+        });
+        res.on('error', reject);
+      },
+    );
+    req.on('timeout', () => req.destroy(new Error('Request timed out')));
+    req.on('error', reject);
+  });
+}
