--- /dev/null
+++ b/server/server.js
@@ -0,0 +1,241 @@
+// The Daily Grind web server: renders the homepage with a fresh per-render
+// email-verification nonce and handles Grind Rewards sign-ups.
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { verifyEmailVerificationToken } from './email-verification.js';
+import {
+  consumeSignupChallenge,
+  createAccount,
+  createSession,
+  findAccount,
+  getSession,
+  issueMagicLink,
+  randomToken,
+  redeemMagicLink,
+  safeEqual,
+  takeFlash,
+} from './store.js';
+
+const PORT = Number(process.env.PORT ?? 11222);
+// Must be the exact public origin the browser sees; it is the KB-JWT audience.
+const RP_ORIGIN = (process.env.PUBLIC_ORIGIN ?? `http://localhost:${PORT}`).replace(/\/$/, '');
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN ?? '';
+const SECURE_COOKIES = RP_ORIGIN.startsWith('https://');
+const SESSION_COOKIE = SECURE_COOKIES ? '__Host-dg_sid' : 'dg_sid';
+const MAX_BODY_BYTES = 32 * 1024;
+
+const templateUrl = new URL('../index.html', import.meta.url);
+const template = await readFile(fileURLToPath(templateUrl), 'utf8');
+
+const FLASH_MESSAGES = {
+  verified: {
+    tone: 'success',
+    text: 'Welcome to Grind Rewards! Your email was verified instantly, so your account is ready to use. Your first drink star is on us.',
+  },
+  'already-member': {
+    tone: 'info',
+    text: 'You already have a Grind Rewards account with that email. Sign in from My Account to see your stars.',
+  },
+  'check-email': {
+    tone: 'info',
+    text: "Almost there! We couldn't confirm your email automatically, so we sent you a link. Open it to activate your rewards account.",
+  },
+  confirmed: { tone: 'success', text: 'Your email is confirmed and your Grind Rewards account is active. Enjoy!' },
+  'link-expired': { tone: 'error', text: 'That confirmation link is invalid or has expired. Please sign up again.' },
+  expired: { tone: 'error', text: 'Your sign-up form expired. Please try again.' },
+  invalid: { tone: 'error', text: 'Please check your details: we need your name, a valid email address, and a password of at least 8 characters.' },
+};
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function parseCookies(header = '') {
+  return Object.fromEntries(
+    header.split(';').map((part) => {
+      const i = part.indexOf('=');
+      return i < 0 ? [part.trim(), ''] : [part.slice(0, i).trim(), decodeURIComponent(part.slice(i + 1).trim())];
+    }),
+  );
+}
+
+function loadSession(req, res) {
+  let session = getSession(parseCookies(req.headers.cookie)[SESSION_COOKIE]);
+  if (!session) {
+    session = createSession();
+    res.setHeader(
+      'Set-Cookie',
+      `${SESSION_COOKIE}=${session.id}; Path=/; HttpOnly; SameSite=Lax${SECURE_COOKIES ? '; Secure' : ''}`,
+    );
+  }
+  return session;
+}
+
+function readForm(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+      } else {
+        chunks.push(chunk);
+      }
+    });
+    req.on('end', () => resolve(new URLSearchParams(Buffer.concat(chunks).toString('utf8'))));
+    req.on('error', reject);
+  });
+}
+
+function redirect(res, location) {
+  res.writeHead(303, { Location: location, 'Cache-Control': 'no-store' });
+  res.end();
+}
+
+function renderStatus(flashKey) {
+  const flash = FLASH_MESSAGES[flashKey];
+  if (!flash) return '';
+  return `<p class="signup-status signup-status--${flash.tone}">${escapeHtml(flash.text)}</p>`;
+}
+
+function renderHome(req, res) {
+  const session = loadSession(req, res);
+  // Fresh single-use challenge on every render; any previous one is discarded.
+  session.signup = { nonce: randomToken(), csrf: randomToken() };
+  const html = template
+    .replaceAll('{{EVT_NONCE}}', session.signup.nonce)
+    .replaceAll('{{CSRF_TOKEN}}', session.signup.csrf)
+    .replace('{{SIGNUP_STATUS}}', renderStatus(takeFlash(session)));
+
+  const headers = {
+    'Content-Type': 'text/html; charset=utf-8',
+    // A cached page would replay an already-consumed nonce.
+    'Cache-Control': 'no-store',
+    'Referrer-Policy': 'same-origin',
+    'X-Content-Type-Options': 'nosniff',
+  };
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(req.method === 'HEAD' ? undefined : html);
+}
+
+// Stand-in for a transactional email provider.
+async function sendEmail({ to, subject, text }) {
+  console.info(`[mailer] To: ${to}\n[mailer] Subject: ${subject}\n${text}\n`);
+}
+
+async function handleSignup(req, res) {
+  const session = loadSession(req, res);
+  const challenge = consumeSignupChallenge(session);
+  const form = await readForm(req);
+
+  if (!challenge || !safeEqual(form.get('csrf_token') ?? '', challenge.csrf)) {
+    session.flash = 'expired';
+    return redirect(res, '/#rewards');
+  }
+
+  const name = (form.get('name') ?? '').trim();
+  const email = (form.get('email') ?? '').trim();
+  const password = form.get('password') ?? '';
+  const rawToken = (form.get('email_verification_token') ?? '').trim();
+  const marketingOptIn = form.get('offers') === 'yes';
+
+  if (
+    !name ||
+    name.length > 100 ||
+    email.length > 254 ||
+    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
+    password.length < 8 ||
+    password.length > 256
+  ) {
+    session.flash = 'invalid';
+    return redirect(res, '/#rewards');
+  }
+
+  let emailVerifiedVia = null;
+  if (rawToken) {
+    try {
+      const { issuer } = await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: email,
+        expectedNonce: challenge.nonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      emailVerifiedVia = `evp:${issuer}`;
+    } catch (err) {
+      console.warn('Email verification token check failed:', err?.message ?? err);
+    }
+  }
+
+  const existing = findAccount(email);
+  if (existing) {
+    if (emailVerifiedVia) {
+      // The user proved they own this address, so it's safe to say it's taken.
+      session.flash = 'already-member';
+    } else {
+      // Don't reveal account existence to someone who hasn't proven ownership.
+      await sendEmail({
+        to: existing.email,
+        subject: 'You already have a Grind Rewards account',
+        text: `Someone tried to sign up with this address. Sign in at ${RP_ORIGIN}/account or reset your password there.`,
+      });
+      session.flash = 'check-email';
+    }
+    return redirect(res, '/#rewards');
+  }
+
+  const account = await createAccount({ name, email, password, marketingOptIn, emailVerifiedVia });
+
+  if (emailVerifiedVia) {
+    // Fast path: ownership is cryptographically proven, no verification email.
+    // EVP doesn't prove deliverability, so still send a normal welcome email.
+    await sendEmail({ to: account.email, subject: 'Welcome to Grind Rewards', text: `Hi ${name}, thanks for joining!` });
+    session.flash = 'verified';
+  } else {
+    // Fallback: unsupported browser, non-participating provider, or failed check.
+    const token = issueMagicLink(account);
+    await sendEmail({
+      to: account.email,
+      subject: 'Confirm your Grind Rewards account',
+      text: `Hi ${name}, confirm your email: ${RP_ORIGIN}/api/rewards/confirm?token=${encodeURIComponent(token)}`,
+    });
+    session.flash = 'check-email';
+  }
+  return redirect(res, '/#rewards');
+}
+
+function handleConfirm(req, res, url) {
+  const session = loadSession(req, res);
+  const account = redeemMagicLink(url.searchParams.get('token') ?? '');
+  session.flash = account ? 'confirmed' : 'link-expired';
+  redirect(res, '/#rewards');
+}
+
+const server = createServer(async (req, res) => {
+  const url = new URL(req.url, RP_ORIGIN);
+  try {
+    if ((req.method === 'GET' || req.method === 'HEAD') && (url.pathname === '/' || url.pathname === '/index.html')) {
+      return renderHome(req, res);
+    }
+    if (url.pathname === '/api/rewards/signup') {
+      if (req.method !== 'POST') {
+        res.writeHead(405, { Allow: 'POST' });
+        return res.end();
+      }
+      return await handleSignup(req, res);
+    }
+    if (req.method === 'GET' && url.pathname === '/api/rewards/confirm') {
+      return handleConfirm(req, res, url);
+    }
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) res.writeHead(err.status ?? 500, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end(err.status === 413 ? 'Payload too large' : 'Something went wrong');
+  }
+});
+
+server.listen(PORT, () => console.info(`The Daily Grind listening on ${RP_ORIGIN} (port ${PORT})`));
diff --git a/server/store.js b/server/store.js
new file mode 100644
index 0000000..120e761
--- /dev/null
+++ b/server/store.js
@@ -0,0 +1,98 @@
+// In-memory session and rewards-account storage. Swap for Redis/a database in
+// production; the important property is that nonces live server-side only.
+import { randomBytes, randomUUID, scrypt, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+
+const scryptAsync = promisify(scrypt);
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const MAGIC_LINK_TTL_MS = 15 * 60 * 1000;
+
+export const randomToken = () => randomBytes(32).toString('base64url');
+
+export function safeEqual(a, b) {
+  const bufA = Buffer.from(String(a));
+  const bufB = Buffer.from(String(b));
+  return bufA.length === bufB.length && timingSafeEqual(bufA, bufB);
+}
+
+// --- Sessions -------------------------------------------------------------
+
+const sessions = new Map();
+
+export function getSession(id) {
+  const session = id && sessions.get(id);
+  if (!session || session.expiresAt < Date.now()) {
+    if (id) sessions.delete(id);
+    return null;
+  }
+  session.expiresAt = Date.now() + SESSION_TTL_MS;
+  return session;
+}
+
+export function createSession() {
+  const session = { id: randomToken(), expiresAt: Date.now() + SESSION_TTL_MS, signup: null, flash: null };
+  sessions.set(session.id, session);
+  return session;
+}
+
+/** Atomically read and delete the single-use sign-up nonce + CSRF token. */
+export function consumeSignupChallenge(session) {
+  const challenge = session?.signup ?? null;
+  if (session) session.signup = null;
+  return challenge;
+}
+
+/** Read and clear the one-shot status message shown after a redirect. */
+export function takeFlash(session) {
+  const flash = session?.flash ?? null;
+  if (session) session.flash = null;
+  return flash;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, session] of sessions) if (session.expiresAt < now) sessions.delete(id);
+  for (const [token, link] of magicLinks) if (link.expiresAt < now) magicLinks.delete(token);
+}, 60_000).unref();
+
+// --- Rewards accounts -----------------------------------------------------
+
+const accounts = new Map(); // keyed by lower-cased email
+const magicLinks = new Map();
+
+export const findAccount = (email) => accounts.get(email.toLowerCase()) ?? null;
+
+export async function createAccount({ name, email, password, marketingOptIn, emailVerifiedVia }) {
+  const salt = randomBytes(16);
+  const hash = await scryptAsync(password, salt, 64);
+  const account = {
+    id: randomUUID(),
+    name,
+    email, // preserve the address as submitted
+    passwordHash: `scrypt$${salt.toString('base64url')}$${hash.toString('base64url')}`,
+    marketingOptIn,
+    emailVerified: Boolean(emailVerifiedVia),
+    emailVerifiedVia: emailVerifiedVia ?? null,
+    createdAt: new Date().toISOString(),
+  };
+  accounts.set(email.toLowerCase(), account);
+  return account;
+}
+
+export function issueMagicLink(account) {
+  const token = randomToken();
+  magicLinks.set(token, { accountId: account.id, email: account.email, expiresAt: Date.now() + MAGIC_LINK_TTL_MS });
+  return token;
+}
+
+/** Single-use: returns the verified account, or null if the link is invalid/expired. */
+export function redeemMagicLink(token) {
+  const link = magicLinks.get(token);
+  magicLinks.delete(token);
+  if (!link || link.expiresAt < Date.now()) return null;
+  const account = findAccount(link.email);
+  if (!account || account.id !== link.accountId) return null;
+  account.emailVerified = true;
+  account.emailVerifiedVia ??= 'magic-link';
+  return account;
+}
diff --git a/test/email-verification.test.js b/test/email-verification.test.js
new file mode 100644
index 0000000..a41f61e
--- /dev/null
+++ b/test/email-verification.test.js
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { exportJWK, generateKeyPair, SignJWT } from 'jose';
+import { verifyEmailVerificationToken } from '../server/email-verification.js';
+
+const ISS = 'https://issuer.example';
+const RP = 'https://dailygrind.example';
+const NONCE = 'test-nonce-0123456789abcdef';
+
+const issuer = await generateKeyPair('EdDSA', { crv: 'Ed25519' });
+const browser = await generateKeyPair('ES256');
+const browserJwk = { ...(await exportJWK(browser.publicKey)), alg: 'ES256' };
+
+async function makeToken({ email = 'Barista@Example.com', nonce = NONCE, aud = RP, iss = ISS, signer = issuer.privateKey } = {}) {
+  const evt = await new SignJWT({ email, email_verified: true, cnf: { jwk: browserJwk }, _sd_alg: 'sha-256' })
+    .setProtectedHeader({ alg: 'EdDSA', typ: 'ev+sd-jwt' })
+    .setIssuer(iss)
+    .setIssuedAt()
+    .sign(signer);
+  const presented = `${evt}~`;
+  const sdHash = createHash('sha256').update(presented).digest('base64url');
+  const kb = await new SignJWT({ nonce, aud, sd_hash: sdHash })
+    .setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' })
+    .setIssuedAt()
+    .sign(browser.privateKey);
+  return presented + kb;
+}
+
+const verify = (rawToken, overrides = {}) =>
+  verifyEmailVerificationToken({
+    rawToken,
+    submittedEmail: 'barista@example.com',
+    expectedNonce: NONCE,
+    expectedAudience: RP,
+    resolveTxt: async (name) => (name === '_email-verification.example.com' ? [['iss=issuer.example']] : []),
+    getIssuerKeys: async () => issuer.publicKey,
+    ...overrides,
+  });
+
+test('accepts a valid EVT + KB-JWT, matching email case-insensitively', async () => {
+  const result = await verify(await makeToken());
+  assert.deepEqual(result, { email: 'Barista@Example.com', issuer: ISS });
+});
+
+test('rejects a mismatched email', async () => {
+  await assert.rejects(verify(await makeToken({ email: 'someone@example.com' })), /does not match/);
+});
+
+test('rejects a wrong or missing nonce', async () => {
+  await assert.rejects(verify(await makeToken({ nonce: 'other' })));
+  await assert.rejects(verify(await makeToken(), { expectedNonce: null }), /Missing nonce/);
+});
+
+test('rejects a KB-JWT bound to another origin', async () => {
+  await assert.rejects(verify(await makeToken({ aud: 'https://evil.example' })));
+});
+
+test('rejects an issuer not delegated via DNS', async () => {
+  await assert.rejects(verify(await makeToken({ iss: 'https://rogue.example' })), /not delegated/);
+});
+
+test('rejects an EVT not signed by the issuer', async () => {
+  const forger = await generateKeyPair('EdDSA', { crv: 'Ed25519' });
+  await assert.rejects(verify(await makeToken({ signer: forger.privateKey })));
+});
+
+test('rejects a token without key binding', async () => {
+  const token = await makeToken();
+  await assert.rejects(verify(token.slice(0, token.lastIndexOf('~') + 1)), /KB-JWT/);
+});
