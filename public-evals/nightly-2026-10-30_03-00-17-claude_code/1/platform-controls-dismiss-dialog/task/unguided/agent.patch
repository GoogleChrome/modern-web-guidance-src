+  <script>
+    (() => {
+      const triggers = document.querySelectorAll('[data-dialog]');
+      let openDialog = null;
+      let lastTrigger = null;
+      // True while a history entry we pushed for the open dialog is on the stack.
+      let hasHistoryEntry = false;
+      // Resolves once a history.back() we initiated has finished traversing.
+      let pendingBack = null;
+
+      function goBack() {
+        pendingBack = new Promise((resolve) => {
+          window.addEventListener('popstate', () => {
+            pendingBack = null;
+            resolve();
+          }, { once: true });
+        });
+        history.back();
+      }
+
+      async function open(dialog, trigger) {
+        if (openDialog) return;
+        if (pendingBack) await pendingBack;
+        lastTrigger = trigger;
+        openDialog = dialog;
+        dialog.showModal();
+        // Push a history entry so the browser/OS back gesture closes the dialog
+        // instead of leaving the page.
+        history.pushState({ coffeeDialog: dialog.id }, '');
+        hasHistoryEntry = true;
+      }
+
+      triggers.forEach((trigger) => {
+        const dialog = document.getElementById(trigger.dataset.dialog);
+        if (!dialog || typeof dialog.showModal !== 'function') {
+          // No <dialog> support: fall back to the full menu page.
+          trigger.addEventListener('click', () => { location.href = trigger.dataset.href; });
+          return;
+        }
+        trigger.addEventListener('click', () => open(dialog, trigger));
+      });
+
+      document.querySelectorAll('.coffee-dialog').forEach((dialog) => {
+        dialog.querySelectorAll('[data-close]').forEach((btn) => {
+          btn.addEventListener('click', () => dialog.close());
+        });
+
+        // Clicking the backdrop (outside the dialog box) dismisses it.
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          const rect = dialog.getBoundingClientRect();
+          const inside = event.clientX >= rect.left && event.clientX <= rect.right &&
+            event.clientY >= rect.top && event.clientY <= rect.bottom;
+          if (!inside) dialog.close();
+        });
+
+        // Fires for every dismissal path: Escape, Android back (CloseWatcher),
+        // close button, backdrop click, or the popstate handler below.
+        dialog.addEventListener('close', () => {
+          if (openDialog !== dialog) return;
+          openDialog = null;
+          if (hasHistoryEntry) {
+            hasHistoryEntry = false;
+            goBack();
+          }
+          if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
+          lastTrigger = null;
+        });
+      });
+
+      // Back button / swipe-back gesture pops our entry: close the dialog.
+      window.addEventListener('popstate', () => {
+        if (pendingBack || !openDialog) return;
+        hasHistoryEntry = false;
+        openDialog.close();
+      });
+    })();
+  </script>
