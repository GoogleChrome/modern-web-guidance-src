+    .promo-track {
+      display: flex;
+      justify-content: center;
+      margin-top: 20px;
+    }
+
+    .target {
+      display: grid;
+      place-items: center;
+      width: 96px;
+      aspect-ratio: 1;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
+      font-size: 0.75rem;
+      font-weight: bold;
+      line-height: 1.2;
+      text-align: center;
+      text-transform: uppercase;
+      cursor: default;
+      /* Identity values keep the stacking context stable before, during and after hover */
+      translate: 0;
+      rotate: 0deg;
+      scale: 1;
+      /* Spin (rotate) and slide (translate) run independently of the hover scale */
+      animation:
+        promo-spin 6s linear infinite,
+        promo-slide 4s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+
+      @media (prefers-reduced-motion: reduce) {
+        animation: none;
+      }
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes promo-spin {
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes promo-slide {
+      from {
+        translate: -80px 0;
+      }
+
+      to {
+        translate: 80px 0;
+      }
+    }
