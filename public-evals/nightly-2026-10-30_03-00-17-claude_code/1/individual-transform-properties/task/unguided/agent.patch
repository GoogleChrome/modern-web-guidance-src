       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Featured promo badge */
+    .promo-track {
+      display: flex;
+      justify-content: center;
+      margin-top: 20px;
+    }
+
+    .target {
+      /* Stable stacking context in the base state, so hover never creates
+         or tears one down mid-animation (no will-change needed). */
+      position: relative;
+      z-index: 1;
+      isolation: isolate;
+
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      width: 110px;
+      height: 110px;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
+      font-weight: bold;
+      text-align: center;
+      line-height: 1.2;
+      text-decoration: none;
+      cursor: pointer;
+
+      /* Spin, slide and hover-scale each drive a separate individual
+         transform property (rotate / translate / scale), so they compose
+         instead of overriding one another via the shared `transform`. */
+      scale: 1;
+      animation:
+        badge-spin 6s linear infinite,
+        badge-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      scale: 1.2;
+    }
+
+    .target small {
+      font-size: 0.7rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+    }
+
+    @keyframes badge-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: -60px 0; }
+      to { translate: 60px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+      }
+    }
   </style>
 </head>
 
