+  <script>
+    (() => {
+      const form = document.getElementById('quick-order-form');
+      const totalOutput = document.getElementById('order-total');
+      const status = document.getElementById('order-status');
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      function calculateTotal() {
+        const drink = form.elements.drink.selectedOptions[0];
+        const base = Number(drink?.dataset.price ?? 0);
+        if (!base) return 0;
+        const upcharges = [...form.querySelectorAll('input[data-upcharge]:checked')]
+          .reduce((sum, input) => sum + Number(input.dataset.upcharge), 0);
+        const quantity = Math.max(1, Math.min(10, Number(form.elements.quantity.value) || 1));
+        return (base + upcharges) * quantity;
+      }
+
+      function updateTotal() {
+        totalOutput.value = currency.format(calculateTotal());
+      }
+
+      function describeOrder(data) {
+        const drink = form.elements.drink.selectedOptions[0].textContent.split(' — ')[0];
+        const location = form.elements.location.selectedOptions[0].textContent.split(' — ')[0];
+        const time = form.elements['pickup-time'].selectedOptions[0].textContent;
+        const extras = [
+          data.get('extra-shot') && 'extra shot',
+          data.get('decaf') && 'decaf',
+          data.get('iced') && 'iced',
+        ].filter(Boolean);
+        const milk = data.get('milk') === 'none' ? 'no milk' : `${data.get('milk')} milk`;
+        return `${data.get('quantity')} × ${data.get('size')} ${drink} (${[milk, ...extras].join(', ')}) ` +
+          `for ${data.get('customer-name').trim()} at our ${location} café, ${time.toLowerCase()}. ` +
+          `Estimated total ${currency.format(calculateTotal())}.`;
+      }
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        // Agents can bypass interactive validation, so check constraints explicitly.
+        const invalid = [...form.elements].filter((el) => el.willValidate && !el.checkValidity());
+        if (invalid.length > 0) {
+          const message = 'Order not placed. Please fix: ' + invalid
+            .map((el) => `${el.labels?.[0]?.textContent.replace('*', '').trim() || el.name} (${el.validationMessage})`)
+            .filter((v, i, all) => all.indexOf(v) === i)
+            .join(', ');
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(message));
+          } else {
+            form.reportValidity();
+          }
+          return;
+        }
+
+        const submitButton = form.querySelector('button[type="submit"]');
+        submitButton.disabled = true;
+
+        const data = new FormData(form);
+        const orderNumber = `DG-${Math.floor(1000 + Math.random() * 9000)}`;
+        const summary = describeOrder(data);
+
+        // No ordering backend yet — confirm on the client.
+        const result = new Promise((resolve) => setTimeout(resolve, 400)).then(() => {
+          status.textContent = `Order ${orderNumber} confirmed: ${summary}`;
+          form.reset();
+          updateTotal();
+          submitButton.disabled = false;
+          return `Order ${orderNumber} placed successfully: ${summary}`;
+        });
+
+        if (event.agentInvoked) {
+          event.respondWith(result);
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
