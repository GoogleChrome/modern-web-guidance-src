+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const totalEl = document.getElementById('order-total');
+      const confirmation = document.getElementById('order-confirmation');
+
+      const SIZE_UPCHARGE = { small: 0, medium: 0.5, large: 1 };
+      const MILK_UPCHARGE = { oat: 0.75, almond: 0.75 };
+      const SHOT_PRICE = 0.8;
+      const PICKUP_LABELS = { asap: 'as soon as possible', '15min': 'in 15 minutes', '30min': 'in 30 minutes', '60min': 'in 1 hour' };
+
+      function calculateTotal() {
+        const drink = form.elements.drink.selectedOptions[0];
+        const shots = Math.min(4, Math.max(0, parseInt(form.elements.extra_shots.value, 10) || 0));
+        return parseFloat(drink.dataset.price) +
+          (SIZE_UPCHARGE[form.elements.size.value] || 0) +
+          (MILK_UPCHARGE[form.elements.milk.value] || 0) +
+          shots * SHOT_PRICE;
+      }
+
+      function updateTotal() {
+        totalEl.value = '$' + calculateTotal().toFixed(2);
+      }
+
+      function validate() {
+        const name = form.elements.customer_name;
+        name.value = name.value.trim();
+        const shots = form.elements.extra_shots;
+        if (!form.elements.size.value) return 'Please choose a size.';
+        if (!name.value) return 'Please enter a name for the order.';
+        if (!shots.checkValidity()) return 'Extra espresso shots must be a whole number from 0 to 4.';
+        return null;
+      }
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      form.addEventListener('reset', () => setTimeout(updateTotal));
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        updateTotal();
+
+        const error = validate();
+        let message;
+        if (error) {
+          message = error;
+          confirmation.textContent = error;
+          confirmation.hidden = false;
+          if (!event.agentInvoked) form.reportValidity();
+        } else {
+          const drinkLabel = form.elements.drink.selectedOptions[0].textContent.split(' \u2014 ')[0];
+          const locationLabel = form.elements.location.selectedOptions[0].textContent.split(' \u2014 ')[0];
+          const orderNumber = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+          const pickup = PICKUP_LABELS[form.elements.pickup_time.value];
+          const name = form.elements.customer_name.value;
+          const total = totalEl.value;
+
+          message = `Order ${orderNumber} confirmed for ${name}: ${form.elements.size.value} ${drinkLabel}, ` +
+            `ready ${pickup} at our ${locationLabel} shop. Total ${total}.`;
+
+          confirmation.replaceChildren();
+          const heading = document.createElement('strong');
+          heading.textContent = `Thanks, ${name}! Order ${orderNumber} is in.`;
+          const details = document.createElement('p');
+          details.textContent = `Your ${form.elements.size.value} ${drinkLabel} will be ready ${pickup} at our ${locationLabel} shop. Total: ${total}.`;
+          confirmation.append(heading, details);
+          confirmation.hidden = false;
+        }
+
+        // When an AI agent submitted the form via its declarative tool, return the result to the agent.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(error ? { error: message } : { message }));
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
