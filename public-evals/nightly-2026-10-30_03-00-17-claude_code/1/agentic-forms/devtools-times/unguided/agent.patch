diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..72e4dbd
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,62 @@
+import { useEffect, useRef } from 'react';
+
+// Minimal typings for the WebMCP imperative API (navigator.modelContext).
+// See https://github.com/webmachinelearning/webmcp
+
+export interface ToolResult {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+}
+
+export interface ModelContextTool<Input = any> {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: Input) => Promise<ToolResult>;
+}
+
+interface ModelContext {
+  registerTool: (tool: ModelContextTool, options?: { signal?: AbortSignal }) => void;
+  unregisterTool?: (name: string) => void;
+}
+
+declare global {
+  interface Navigator {
+    modelContext?: ModelContext;
+  }
+}
+
+export const textResult = (text: string, isError = false): ToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError ? { isError } : {}),
+});
+
+/**
+ * Registers a WebMCP tool for as long as the calling component is mounted.
+ * The latest `execute` is always used, so it may close over component state.
+ */
+export function useWebMcpTool<Input>(tool: ModelContextTool<Input>) {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = navigator.modelContext;
+    if (!modelContext) return;
+
+    const controller = new AbortController();
+    modelContext.registerTool(
+      { ...tool, execute: (input: Input) => executeRef.current(input) },
+      { signal: controller.signal },
+    );
+
+    return () => {
+      controller.abort();
+      try {
+        modelContext.unregisterTool?.(tool.name);
+      } catch {
+        // Already unregistered via the abort signal.
+      }
+    };
+  }, [tool.name]);
+}
