+  <button type="button" class="btn feedback-launcher" command="show-modal" commandfor="feedback-dialog">
+    Give feedback
+  </button>
+
+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://unpkg.com/invokers-polyfill@1/invoker.min.js');
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const form = dialog.querySelector('form');
+    const status = dialog.querySelector('.dock-status');
+    const thanks = document.querySelector('.feedback-thanks');
+    const moveButtons = dialog.querySelectorAll('[data-move-to]');
+    const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+    function syncDockUi() {
+      const dock = dialog.parentElement;
+      for (const button of moveButtons) {
+        button.setAttribute('aria-pressed', String(button.dataset.moveTo === dock.dataset.dock));
+      }
+      return dock.dataset.dockLabel;
+    }
+
+    function moveDialog(target) {
+      if (supportsMoveBefore) {
+        // Atomic move: the dialog stays modal and keeps focus, selection and form state.
+        target.moveBefore(dialog, null);
+        return;
+      }
+
+      // Fallback: a classic remove + insert drops the dialog out of the top layer
+      // and blurs the focused control, so capture that state and restore it afterwards.
+      const wasOpen = dialog.open;
+      const focused = dialog.contains(document.activeElement) ? document.activeElement : null;
+      const selection = focused && typeof focused.selectionStart === 'number'
+        ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection]
+        : null;
+      const scrollTop = focused ? focused.scrollTop : 0;
+
+      target.insertBefore(dialog, null);
+
+      if (wasOpen && !dialog.matches(':modal')) {
+        // Removal leaves the `open` attribute set but non-modal, and showModal() throws on that state.
+        if (dialog.open) dialog.close();
+        dialog.showModal();
+      }
+      if (focused) {
+        focused.focus({ preventScroll: true });
+        focused.scrollTop = scrollTop;
+        if (selection) focused.setSelectionRange(...selection);
+      }
+    }
+
+    for (const button of moveButtons) {
+      button.addEventListener('click', () => {
+        const target = document.querySelector(`.dock[data-dock="${button.dataset.moveTo}"]`);
+        if (!target || target === dialog.parentElement) return;
+
+        moveDialog(target);
+        const label = syncDockUi();
+        status.textContent = `Panel moved to ${label}${supportsMoveBefore ? '' : ' (restored)'}.`;
+        target.scrollIntoView({ block: 'center', behavior: 'smooth' });
+      });
+    }
+
+    dialog.addEventListener('close', () => {
+      // The fallback's internal close() is followed by showModal(), so ignore it.
+      if (dialog.open) return;
+      if (dialog.returnValue === 'send') {
+        thanks.textContent = 'Thanks! Your feedback is on its way to our baristas.';
+        form.reset();
+      }
+      dialog.returnValue = '';
+      status.textContent = '';
+    });
+
+    syncDockUi();
+  </script>
+
