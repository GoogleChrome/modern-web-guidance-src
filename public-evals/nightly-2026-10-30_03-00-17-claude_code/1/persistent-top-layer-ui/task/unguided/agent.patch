+  <button type="button" class="feedback-launcher" id="feedback-launcher" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    Feedback
+  </button>
+
+  <script>
+    (() => {
+      const STORAGE_KEY = 'daily-grind-feedback';
+      const dialog = document.getElementById('feedback-dialog');
+      const form = document.getElementById('feedback-form');
+      const launcher = document.getElementById('feedback-launcher');
+      const locationLabel = document.getElementById('feedback-location');
+      const status = document.getElementById('feedback-status');
+      const moveButtons = dialog.querySelectorAll('[data-move-to]');
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      // Set while the fallback path closes/re-opens the dialog so the
+      // close handler doesn't treat it as the user dismissing the panel.
+      let relocating = false;
+
+      const loadState = () => {
+        try {
+          return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
+        } catch {
+          return {};
+        }
+      };
+
+      const saveState = () => {
+        const data = new FormData(form);
+        localStorage.setItem(STORAGE_KEY, JSON.stringify({
+          open: dialog.open,
+          dock: dialog.dataset.dock,
+          rating: data.get('rating'),
+          comments: data.get('comments')
+        }));
+      };
+
+      const syncDockUi = (dock) => {
+        dialog.dataset.dock = dock.dataset.dock;
+        locationLabel.textContent = dock.dataset.dockLabel;
+        moveButtons.forEach((btn) => {
+          btn.setAttribute('aria-pressed', String(btn.dataset.moveTo === dock.dataset.dock));
+        });
+      };
+
+      // Snapshot everything a remove + insert would destroy.
+      const captureState = () => {
+        const active = dialog.contains(document.activeElement) ? document.activeElement : null;
+        const hasSelection = active && typeof active.selectionStart === 'number';
+        return {
+          open: dialog.open,
+          modal: dialog.matches(':modal'),
+          active,
+          selection: hasSelection ? [active.selectionStart, active.selectionEnd, active.selectionDirection] : null,
+          scrollTops: [...dialog.querySelectorAll('textarea'), dialog].map((el) => [el, el.scrollTop])
+        };
+      };
+
+      const restoreState = (state) => {
+        if (state.open && !dialog.open) {
+          state.modal ? dialog.showModal() : dialog.show();
+        }
+        if (state.active && state.active.isConnected) {
+          state.active.focus({ preventScroll: true });
+          if (state.selection) {
+            state.active.setSelectionRange(...state.selection);
+          }
+        }
+        state.scrollTops.forEach(([el, top]) => { el.scrollTop = top; });
+      };
+
+      const moveDialog = (dockName) => {
+        const dock = document.querySelector(`.feedback-dock[data-dock="${dockName}"]`);
+        if (!dock || dock === dialog.parentElement) return;
+
+        if (supportsMoveBefore) {
+          try {
+            // State-preserving move: dialog stays open/in the top layer and
+            // keeps focus, selection and form state.
+            dock.moveBefore(dialog, null);
+            syncDockUi(dock);
+            saveState();
+            return;
+          } catch (err) {
+            // moveBefore throws for some cross-document/disconnected cases;
+            // fall through to the manual path.
+            console.warn('moveBefore failed, using fallback', err);
+          }
+        }
+
+        const state = captureState();
+        relocating = true;
+        try {
+          if (dialog.open) dialog.close();
+          dock.insertBefore(dialog, null);
+          restoreState(state);
+        } finally {
+          relocating = false;
+        }
+        syncDockUi(dock);
+        saveState();
+      };
+
+      const openDialog = () => {
+        if (!dialog.open) dialog.showModal();
+        saveState();
+      };
+
+      launcher.addEventListener('click', openDialog);
+
+      moveButtons.forEach((btn) => {
+        btn.addEventListener('click', () => moveDialog(btn.dataset.moveTo));
+      });
+
+      form.addEventListener('input', saveState);
+
+      dialog.addEventListener('close', () => {
+        if (relocating) return;
+        if (dialog.returnValue === 'send') {
+          form.reset();
+          status.textContent = '';
+          launcher.textContent = 'Thanks! ☕';
+          setTimeout(() => { launcher.textContent = 'Feedback'; }, 3000);
+        }
+        dialog.returnValue = '';
+        saveState();
+        launcher.focus();
+      });
+
+      form.addEventListener('submit', (event) => {
+        if (event.submitter?.value === 'send' && !new FormData(form).get('rating')) {
+          event.preventDefault();
+          status.textContent = 'Please pick a rating before sending.';
+        }
+      });
+
+      // Restore persisted draft, dock and open state.
+      const saved = loadState();
+      if (saved.rating) {
+        const radio = form.querySelector(`input[name="rating"][value="${saved.rating}"]`);
+        if (radio) radio.checked = true;
+      }
+      if (saved.comments) form.elements.comments.value = saved.comments;
+      const savedDock = saved.dock && document.querySelector(`.feedback-dock[data-dock="${saved.dock}"]`);
+      if (savedDock && savedDock !== dialog.parentElement) savedDock.appendChild(dialog);
+      syncDockUi(dialog.parentElement);
+      if (saved.open) dialog.showModal();
+    })();
+  </script>
+
 </body>
 
