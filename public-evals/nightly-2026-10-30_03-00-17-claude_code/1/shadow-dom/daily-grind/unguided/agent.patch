+/**
+ * <drink-card> — a menu card whose layout and styles live in Shadow DOM,
+ * isolated from page CSS.
+ *
+ * Attributes:
+ *   href     URL for the action link.
+ *   limited  Boolean; shows the "Limited" badge. Can be toggled at any time.
+ *
+ * Slots:
+ *   title        Drink name.
+ *   (default)    Description.
+ *   action       Link label (defaults to "View Details").
+ *   badge        Badge label (defaults to "Limited").
+ *
+ * Theming hooks: --drink-card-color, --drink-card-accent.
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      all: initial;
+      display: block;
+      font-family: inherit;
+      --_color: var(--drink-card-color, #4e342e);
+      --_accent: var(--drink-card-accent, #ffab40);
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    .card {
+      position: relative;
+      box-sizing: border-box;
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      color: #3e2723;
+      line-height: 1.6;
+    }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      right: 12px;
+      background: var(--_accent);
+      color: var(--_color);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      font-size: 1.17em;
+      color: var(--_color);
+    }
+
+    p {
+      margin: 0;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--_color);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+  </style>
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden><slot name="badge">Limited</slot></span>
+    <h3 part="title"><slot name="title"></slot></h3>
+    <p part="description"><slot></slot></p>
+    <a class="btn" part="action"><slot name="action">View Details</slot></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href', 'limited'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this._badge = root.querySelector('.badge');
+    this._link = root.querySelector('.btn');
+  }
+
+  connectedCallback() {
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  get limited() {
+    return this.hasAttribute('limited');
+  }
+
+  set limited(value) {
+    this.toggleAttribute('limited', Boolean(value));
+  }
+
+  _render() {
+    this._badge.hidden = !this.limited;
+    const href = this.getAttribute('href');
+    if (href) {
+      this._link.setAttribute('href', href);
+    } else {
+      this._link.removeAttribute('href');
+    }
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
