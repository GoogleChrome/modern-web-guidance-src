@@ -134,8 +134,57 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Interactive card motion */
+    .card.spring,
+    .card.bounce {
+      will-change: transform;
+      transition-property: transform, box-shadow;
+    }
+
+    /* Spring: overshoots the target scale, rebounds, then settles */
+    .card.spring {
+      transition-duration: 0.7s;
+      /* Fallback for browsers without linear() easing */
+      transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
+      /* Damped spring curve (~23% overshoot, gentle undershoot, settle) */
+      transition-timing-function: linear(0, 0.045, 0.162, 0.323, 0.506, 0.688, 0.856, 0.996,
+          1.105, 1.179, 1.221, 1.234, 1.224, 1.197, 1.159, 1.116, 1.074, 1.034, 1.001,
+          0.976, 0.958, 0.949, 0.945, 0.948, 0.954, 0.963, 0.973, 0.983, 0.992, 1,
+          1.006, 1.01, 1.012, 1.013, 1.012, 1.011, 1.009, 1.006, 1.004, 1.002, 1);
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within {
+      transform: scale(1.06);
+      box-shadow: 0 12px 24px rgba(78, 52, 46, 0.18);
+    }
+
+    /* Bounce: lifts and bounces against its target like a dropped ball */
+    .card.bounce {
+      transition-duration: 0.8s;
+      transition-timing-function: cubic-bezier(0.68, -0.55, 0.27, 1.55);
+      /* Bounce-out curve: three diminishing rebounds */
+      transition-timing-function: linear(0, 0.019, 0.076, 0.17, 0.303, 0.473, 0.681, 0.926,
+          1 36.4%, 0.879, 0.811, 0.773, 0.75 54.5%, 0.772, 0.833, 0.931, 1 72.7%,
+          0.952, 0.938 81.8%, 0.962, 1 90.9%, 0.988 95.5%, 1);
+    }
+
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      transform: translateY(-12px) scale(1.03);
+      box-shadow: 0 16px 24px rgba(78, 52, 46, 0.2);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+        will-change: auto;
+      }
+    }
+
