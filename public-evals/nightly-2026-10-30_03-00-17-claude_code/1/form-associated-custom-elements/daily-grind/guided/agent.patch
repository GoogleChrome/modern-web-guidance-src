+  <script>
+    const form = document.getElementById('feedback-form');
+    const skip = document.getElementById('skip-rating');
+    const ratingFieldset = document.getElementById('rating-fieldset');
+    const rating = ratingFieldset.querySelector('star-rating');
+    const hint = document.getElementById('rating-hint');
+    const status = document.getElementById('feedback-status');
+    const hintText = hint.textContent;
+
+    // A disabled fieldset disables the rating natively: it is skipped by
+    // validation and omitted from the submitted FormData.
+    const syncSkip = () => { ratingFieldset.disabled = skip.checked; };
+    skip.addEventListener('change', syncSkip);
+    // The checkbox may be restored by the browser on back/forward navigation.
+    window.addEventListener('pageshow', syncSkip);
+    syncSkip();
+
+    const syncHint = () => {
+      hint.textContent = rating.value ? `${rating.value} of ${rating.max} stars` : hintText;
+    };
+    rating.addEventListener('input', syncHint);
+    window.addEventListener('pageshow', syncHint);
+
+    form.addEventListener('reset', () => {
+      // Reset updates control values after this event; resync on the next task.
+      setTimeout(() => {
+        syncSkip();
+        syncHint();
+        status.value = '';
+      });
+    });
+
+    form.addEventListener('submit', (event) => {
+      // No feedback backend yet: show what the form would submit natively.
+      event.preventDefault();
+      const data = new FormData(form);
+      const stars = data.get('rating');
+      status.value = stars
+        ? `Thanks! You rated your ${data.get('drink')} ${stars} of ${rating.max} stars.`
+        : `Thanks for your feedback on the ${data.get('drink')}!`;
+    });
+  </script>
