index 0000000..ec25893
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,271 @@
+/**
+ * <star-rating> — a form-associated star rating control.
+ *
+ * Attributes: name, value (default value used on reset), max (default 5),
+ * required, disabled, label (accessible name for the star group).
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-block;
+      --star-size: 2rem;
+      --star-empty: #d7ccc8;
+      --star-filled: #ffab40;
+      --star-focus: #4e342e;
+      --star-invalid: #c62828;
+    }
+
+    .stars {
+      display: inline-flex;
+      border-radius: 6px;
+      outline: 2px solid transparent;
+      outline-offset: 2px;
+    }
+
+    button {
+      all: unset;
+      cursor: pointer;
+      font-size: var(--star-size);
+      line-height: 1;
+      padding: 0 0.1em;
+      color: var(--star-empty);
+      transition: color 0.15s, transform 0.15s;
+    }
+
+    button[data-on] { color: var(--star-filled); }
+
+    /* Hover preview: fill every star, then empty those after the hovered one. */
+    .stars:hover button { color: var(--star-filled); }
+    .stars:hover button:hover ~ button { color: var(--star-empty); }
+    button:hover { transform: scale(1.15); }
+
+    button:focus-visible {
+      outline: 2px solid var(--star-focus);
+      outline-offset: 2px;
+      border-radius: 4px;
+    }
+
+    :host(:state(touched):invalid) .stars { outline-color: var(--star-invalid); }
+
+    :host(:disabled) button {
+      cursor: not-allowed;
+      opacity: 0.45;
+      transform: none;
+    }
+    :host(:disabled) .stars:hover button { color: var(--star-empty); }
+    :host(:disabled) .stars:hover button[data-on] { color: var(--star-filled); }
+
+    @media (prefers-reduced-motion: reduce) {
+      button { transition: none; }
+      button:hover { transform: none; }
+    }
+  </style>
+  <div class="stars" role="radiogroup" part="stars"></div>
+`;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['max', 'value', 'required', 'label'];
+
+  #internals;
+  #group;
+  #value = '';
+  #dirty = false; // true once the value diverges from the `value` attribute
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#group = root.querySelector('.stars');
+    this.#group.addEventListener('click', (e) => this.#onClick(e));
+    this.#group.addEventListener('keydown', (e) => this.#onKeydown(e));
+    // A failed submit or checkValidity() fires `invalid`; reveal the error styling.
+    this.addEventListener('invalid', () => this.#markTouched());
+    this.#render();
+  }
+
+  connectedCallback() {
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'max') this.#render();
+    else if (name === 'value' && !this.#dirty) this.#setValue(this.defaultValue);
+    else this.#update();
+  }
+
+  // ---- Public API mirroring native controls ----
+
+  get max() {
+    const max = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(max) && max > 0 ? max : 5;
+  }
+  set max(v) { this.setAttribute('max', v); }
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get name() { return this.getAttribute('name'); }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get type() { return this.localName; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() {
+    this.#markTouched();
+    return this.#internals.reportValidity();
+  }
+
+  // ---- Form-associated lifecycle ----
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#internals.states?.delete('touched');
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable the inner buttons only; never set `disabled` on the host here,
+    // or re-enabling an ancestor <fieldset> would leave the host stuck.
+    for (const star of this.#stars()) star.disabled = disabled;
+    this.#update();
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#setValue(state ?? '');
+  }
+
+  // ---- Internals ----
+
+  #stars() {
+    return this.#group.querySelectorAll('button');
+  }
+
+  #render() {
+    const stars = [];
+    for (let i = 1; i <= this.max; i++) {
+      const star = document.createElement('button');
+      star.type = 'button';
+      star.role = 'radio';
+      star.value = String(i);
+      star.ariaLabel = `${i} star${i === 1 ? '' : 's'}`;
+      star.textContent = '★';
+      star.disabled = this.matches(':disabled');
+      stars.push(star);
+    }
+    this.#group.replaceChildren(...stars);
+    // Drop a value that no longer fits the new range.
+    if (Number(this.#value) > this.max) this.#value = '';
+    this.#update();
+  }
+
+  #setValue(v) {
+    const n = parseInt(v, 10);
+    this.#value = Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+    this.#update();
+  }
+
+  #update() {
+    const current = Number(this.#value);
+    const stars = [...this.#stars()];
+    for (const star of stars) {
+      const n = Number(star.value);
+      star.toggleAttribute('data-on', n <= current);
+      star.ariaChecked = String(n === current);
+      star.tabIndex = -1;
+    }
+    // Roving tabindex: the checked star, or the first one when empty.
+    const focusTarget = stars[current ? current - 1 : 0];
+    if (focusTarget) focusTarget.tabIndex = 0;
+
+    this.#group.ariaRequired = String(this.required);
+    this.#group.ariaLabel = this.getAttribute('label') || 'Rating';
+
+    // Omit the entry entirely when empty, like an unchecked radio group.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        focusTarget,
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #markTouched() {
+    try {
+      this.#internals.states?.add('touched');
+    } catch {
+      // Older CustomStateSet implementations only accept `--` prefixed names.
+    }
+  }
+
+  #commit(v, { focus = false } = {}) {
+    if (this.matches(':disabled')) return;
+    const previous = this.#value;
+    this.value = v;
+    this.#markTouched();
+    if (focus) this.#stars()[Number(this.#value) - 1]?.focus();
+    if (this.#value !== previous) {
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+  }
+
+  #onClick(e) {
+    const star = e.target.closest('button');
+    if (star) this.#commit(star.value);
+  }
+
+  #onKeydown(e) {
+    const current = Number(this.#value) || 0;
+    let next;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = Math.min(current + 1, this.max);
+        break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = Math.max(current - 1, 1);
+        break;
+      case 'Home':
+        next = 1;
+        break;
+      case 'End':
+        next = this.max;
+        break;
+      case ' ':
+        next = Number(e.target.closest('button')?.value) || 1;
+        break;
+      default:
+        return;
+    }
+    e.preventDefault();
+    this.#commit(next, { focus: true });
+  }
+}
+
+customElements.define('star-rating', StarRating);
