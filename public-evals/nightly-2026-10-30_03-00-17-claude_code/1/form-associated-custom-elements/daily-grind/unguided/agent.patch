+  <script type="module">
+    import './star-rating.js';
+
+    const form = document.getElementById('feedback-form');
+    const inStore = document.getElementById('in-store');
+    const serviceFieldset = document.getElementById('service-fieldset');
+    const thanks = document.getElementById('feedback-thanks');
+
+    // The service rating only participates (submission + validation) when its fieldset is enabled.
+    const syncServiceFieldset = () => { serviceFieldset.disabled = !inStore.checked; };
+    inStore.addEventListener('change', syncServiceFieldset);
+    // Re-sync after the browser restores the checkbox (initial load and back/forward cache).
+    syncServiceFieldset();
+    window.addEventListener('pageshow', syncServiceFieldset);
+
+    for (const rating of form.querySelectorAll('star-rating')) {
+      const error = document.getElementById(rating.getAttribute('aria-describedby'));
+      rating.addEventListener('invalid', () => { error.textContent = rating.validationMessage; });
+      rating.addEventListener('change', () => { if (rating.validity.valid) error.textContent = ''; });
+    }
+
+    form.addEventListener('reset', () => {
+      form.querySelectorAll('.field-error').forEach((el) => { el.textContent = ''; });
+      thanks.hidden = true;
+      // Reset restores the checkbox after this event fires, so sync on the next task.
+      setTimeout(syncServiceFieldset);
+    });
+
+    form.addEventListener('submit', (event) => {
+      // No feedback backend yet: show what would be submitted instead of navigating.
+      event.preventDefault();
+      const data = new FormData(form);
+      const stars = (n) => `${n} star${n === '1' ? '' : 's'}`;
+      let message = `Thanks! You gave the ${data.get('drink')} ${stars(data.get('rating'))}`;
+      if (data.has('service')) message += ` and our service ${stars(data.get('service'))}`;
+      thanks.textContent = `${message}.`;
+      thanks.hidden = false;
+    });
+  </script>
