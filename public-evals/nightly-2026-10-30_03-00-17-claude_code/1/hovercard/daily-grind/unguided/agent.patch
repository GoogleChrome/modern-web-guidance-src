+  <script>
+    (function () {
+      // Preview data for each drink page linked from Seasonal Favorites
+      var DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          badge: 'Seasonal',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=640&q=70',
+          description: 'Double espresso, steamed oat milk and pure Vermont maple syrup, finished with a dusting of cinnamon.',
+          calories: '190',
+          caffeine: '150mg',
+          roast: 'Medium',
+          sizes: [['Small', 4.75], ['Medium', 5.25], ['Large', 5.95]]
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          badge: 'House Favorite',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=640&q=70',
+          description: 'Our signature Sumatra blend pulled short for notes of dark chocolate, cedar and a smokey finish.',
+          calories: '5',
+          caffeine: '130mg',
+          roast: 'Dark',
+          sizes: [['Single', 2.95], ['Double', 3.75], ['Triple', 4.45]]
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          badge: 'Small Batch',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=640&q=70',
+          description: 'Coarse-ground Colombian beans steeped for 18 hours, served over ice for a naturally sweet, low-acid cup.',
+          calories: '10',
+          caffeine: '205mg',
+          roast: 'Medium-Dark',
+          sizes: [['Small', 4.25], ['Medium', 4.75], ['Large', 5.45]]
+        }
+      };
+
+      var SHOW_DELAY = 300;
+      var HIDE_DELAY = 200;
+      var GAP = 8;
+
+      var card = document.getElementById('drink-hovercard');
+      var field = function (name) { return card.querySelector('[data-field="' + name + '"]'); };
+      var activeLink = null;
+      var showTimer = null;
+      var hideTimer = null;
+      var suppressFocusShow = false;
+
+      function clearTimers() {
+        clearTimeout(showTimer);
+        clearTimeout(hideTimer);
+      }
+
+      function selectSize(slug, index) {
+        var drink = DRINKS[slug];
+        var size = drink.sizes[index];
+        field('price').textContent = '$' + size[1].toFixed(2);
+        field('order').href = '/order-online?item=' + slug + '&size=' + encodeURIComponent(size[0].toLowerCase());
+        field('sizes').querySelectorAll('button').forEach(function (btn, i) {
+          btn.setAttribute('aria-pressed', String(i === index));
+        });
+      }
+
+      function render(link) {
+        var slug = link.dataset.hovercard;
+        var drink = DRINKS[slug];
+        var img = field('image');
+
+        img.style.display = '';
+        img.onerror = function () { img.style.display = 'none'; };
+        img.src = drink.image;
+        img.alt = drink.name;
+        field('badge').textContent = drink.badge;
+        field('url').textContent = location.host + link.getAttribute('href');
+        field('name').textContent = drink.name;
+        field('description').textContent = drink.description;
+        field('calories').textContent = drink.calories;
+        field('caffeine').textContent = drink.caffeine;
+        field('roast').textContent = drink.roast;
+        field('details').href = link.href;
+
+        var sizes = field('sizes');
+        sizes.textContent = '';
+        drink.sizes.forEach(function (size, i) {
+          var btn = document.createElement('button');
+          btn.type = 'button';
+          btn.textContent = size[0];
+          btn.addEventListener('click', function () { selectSize(slug, i); });
+          sizes.appendChild(btn);
+        });
+        selectSize(slug, Math.min(1, drink.sizes.length - 1));
+      }
+
+      function position() {
+        if (!activeLink) return;
+        var rect = activeLink.getBoundingClientRect();
+        var w = card.offsetWidth;
+        var h = card.offsetHeight;
+        var top = rect.bottom + GAP;
+        // Flip above the link when there isn't room below
+        if (top + h > window.innerHeight && rect.top - GAP - h > 0) {
+          top = rect.top - GAP - h;
+        }
+        var left = rect.left + rect.width / 2 - w / 2;
+        left = Math.max(GAP, Math.min(left, window.innerWidth - w - GAP));
+        card.style.top = top + 'px';
+        card.style.left = left + 'px';
+      }
+
+      function show(link) {
+        clearTimers();
+        if (activeLink && activeLink !== link) {
+          activeLink.setAttribute('aria-expanded', 'false');
+        }
+        if (activeLink !== link || !card.classList.contains('is-open')) {
+          activeLink = link;
+          render(link);
+          link.insertAdjacentElement('afterend', card);
+        }
+        link.setAttribute('aria-expanded', 'true');
+        card.hidden = false;
+        position();
+        card.classList.add('is-open');
+      }
+
+      function hide() {
+        clearTimers();
+        if (!activeLink) return;
+        activeLink.setAttribute('aria-expanded', 'false');
+        card.classList.remove('is-open');
+        activeLink = null;
+      }
+
+      function scheduleShow(link) {
+        clearTimers();
+        showTimer = setTimeout(function () { show(link); }, activeLink ? 0 : SHOW_DELAY);
+      }
+
+      function scheduleHide() {
+        clearTimeout(showTimer);
+        clearTimeout(hideTimer);
+        hideTimer = setTimeout(hide, HIDE_DELAY);
+      }
+
+      function within(node) {
+        return node && activeLink && (activeLink.contains(node) || card.contains(node));
+      }
+
+      document.querySelectorAll('a[data-hovercard]').forEach(function (link) {
+        if (!DRINKS[link.dataset.hovercard]) return;
+        link.setAttribute('aria-haspopup', 'dialog');
+        link.setAttribute('aria-expanded', 'false');
+        link.setAttribute('aria-controls', card.id);
+
+        // Hover previews are mouse/pen only; touch taps navigate as usual
+        link.addEventListener('pointerenter', function (e) {
+          if (e.pointerType !== 'touch') scheduleShow(link);
+        });
+        link.addEventListener('pointerleave', function (e) {
+          if (e.pointerType !== 'touch') scheduleHide();
+        });
+        link.addEventListener('focus', function () {
+          if (!suppressFocusShow && link.matches(':focus-visible')) show(link);
+        });
+        link.addEventListener('focusout', function (e) {
+          if (!within(e.relatedTarget)) scheduleHide();
+        });
+      });
+
+      card.addEventListener('pointerenter', function () { clearTimeout(hideTimer); });
+      card.addEventListener('pointerleave', function (e) {
+        if (e.pointerType !== 'touch') scheduleHide();
+      });
+      card.addEventListener('focusin', function () { clearTimeout(hideTimer); });
+      card.addEventListener('focusout', function (e) {
+        if (!within(e.relatedTarget)) scheduleHide();
+      });
+      card.addEventListener('transitionend', function () {
+        if (!card.classList.contains('is-open')) card.hidden = true;
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape' || !activeLink) return;
+        var link = activeLink;
+        var focusInside = card.contains(document.activeElement);
+        hide();
+        if (focusInside) {
+          suppressFocusShow = true;
+          link.focus({ preventScroll: true });
+          suppressFocusShow = false;
+        }
+      });
+
+      window.addEventListener('scroll', position, { passive: true });
+      window.addEventListener('resize', position);
+    })();
+  </script>
+
