+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...document.querySelectorAll('nav a.section-link')];
+
+    // Keep anchor jumps clear of the sticky nav
+    const setNavHeight = () =>
+      document.documentElement.style.setProperty('--nav-height', `${nav.offsetHeight}px`);
+    setNavHeight();
+    new ResizeObserver(setNavHeight).observe(nav);
+
+    const setCurrent = (currentLink) => {
+      links.forEach((link) => {
+        if (link === currentLink) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      });
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native :target-current handles the visuals; mirror it for assistive tech
+      const sync = () => setCurrent(document.querySelector('nav a.section-link:target-current'));
+      sync();
+      document.addEventListener('scrollend', sync);
+    } else {
+      // Fallback: track sections crossing the middle of the viewport
+      const visible = new Set();
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (entry.isIntersecting) visible.add(entry.target.id);
+          else visible.delete(entry.target.id);
+        });
+        const current = links.find((link) => visible.has(link.hash.slice(1)));
+        links.forEach((link) => link.classList.toggle('target-current', link === current));
+        setCurrent(current);
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      links.forEach((link) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (section) observer.observe(section);
+      });
+    }
+  </script>
+
 </body>
 
