diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..73c78f6
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,87 @@
+---
+export interface Props {
+    sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+<nav
+    data-section-nav
+    aria-label="Page sections"
+    class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-300"
+>
+    <ul class="relative max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-6 h-12 overflow-x-auto text-sm font-semibold">
+        {sections.map(section => (
+            <li>
+                <a
+                    href={`#${section.id}`}
+                    data-section-link={section.id}
+                    class="block py-3 border-b-2 border-transparent text-gray-600 hover:text-gray-900 whitespace-nowrap transition-colors aria-[current=true]:text-amber-500 aria-[current=true]:border-amber-400"
+                >
+                    {section.label}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<script>
+    // Highlights the nav link of the section currently in view. Uses document-level
+    // listeners registered once, since <ClientRouter /> swaps pages without reloading.
+    let links: HTMLAnchorElement[] = [];
+    let sections: HTMLElement[] = [];
+    let frame = 0;
+    let activeId: string | null = null;
+
+    function update() {
+        frame = 0;
+        if (!sections.length) return;
+
+        const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+        // A section counts as current once its top passes just below the sticky nav.
+        const threshold = (nav?.offsetHeight ?? 0) + 16;
+        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
+
+        let current: HTMLElement | undefined;
+        if (atBottom) {
+            current = sections[sections.length - 1];
+        } else {
+            for (const section of sections) {
+                if (section.getBoundingClientRect().top <= threshold) current = section;
+            }
+        }
+        current ??= sections[0];
+        if (current.id === activeId) return;
+        activeId = current.id;
+
+        for (const link of links) {
+            const active = link.dataset.sectionLink === current.id;
+            link.setAttribute('aria-current', String(active));
+            // Keep the active link visible when the nav overflows horizontally on small screens.
+            const list = link.closest('ul');
+            if (active && list) {
+                const { offsetLeft, offsetWidth } = link;
+                if (offsetLeft < list.scrollLeft || offsetLeft + offsetWidth > list.scrollLeft + list.clientWidth) {
+                    list.scrollTo({ left: offsetLeft - 16, behavior: 'smooth' });
+                }
+            }
+        }
+    }
+
+    function scheduleUpdate() {
+        if (!frame) frame = requestAnimationFrame(update);
+    }
+
+    function init() {
+        links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
+        sections = links
+            .map(link => document.getElementById(link.dataset.sectionLink!))
+            .filter((el): el is HTMLElement => el !== null);
+        activeId = null;
+        scheduleUpdate();
+    }
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    document.addEventListener('astro:page-load', init);
+</script>
