 </Layout>
+
+<style>
+    .toc {
+        /* Lets the browser track which linked section is currently in view (:target-current). */
+        scroll-target-group: auto;
+    }
+    /* :is() keeps the rule valid in browsers that don't know :target-current; .target-current is the JS fallback. */
+    .toc a:is(:target-current, .target-current) {
+        color: var(--color-gray-900);
+        font-weight: 600;
+        border-left-color: var(--color-amber-400);
+    }
+</style>
+
+<script>
+    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
+
+    if (links.length) {
+        if (CSS.supports('scroll-target-group: auto')) {
+            // :target-current handles the visuals; mirror it to aria-current for assistive tech.
+            const syncAriaCurrent = () => {
+                const current = document.querySelector('.toc a:target-current');
+                links.forEach((link) => link.setAttribute('aria-current', String(link === current)));
+            };
+            syncAriaCurrent();
+            document.addEventListener('scrollend', syncAriaCurrent);
+        } else {
+            const setCurrent = (id: string) => {
+                links.forEach((link) => {
+                    const isCurrent = link.hash === `#${id}`;
+                    link.classList.toggle('target-current', isCurrent);
+                    link.setAttribute('aria-current', String(isCurrent));
+                });
+            };
+            const observer = new IntersectionObserver((entries) => {
+                entries.forEach((entry) => {
+                    if (entry.isIntersecting) setCurrent(entry.target.id);
+                });
+            }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+            links.forEach((link) => {
+                const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
+                if (section) observer.observe(section);
+            });
+        }
+    }
+</script>
