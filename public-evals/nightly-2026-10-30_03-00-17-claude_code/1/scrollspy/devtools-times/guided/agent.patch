 const { title } = Astro.props;
+
+const slugify = (text: string) =>
+	text.toLowerCase().replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+
+// Split the content at each <h2> and wrap every chunk in a <section id="…"> so the
+// "On this page" navigation can link to (and track) each section.
+const html = await Astro.slots.render('default');
+const [intro, ...chunks] = html.split(/(?=<h2[\s>])/);
+const sections = chunks.map((chunk) => {
+	const heading = chunk.match(/<h2[^>]*>([\s\S]*?)<\/h2>/)?.[1] ?? '';
+	const label = heading.replace(/<[^>]+>/g, '').trim();
+	return { id: slugify(label), label, html: chunk };
+});
