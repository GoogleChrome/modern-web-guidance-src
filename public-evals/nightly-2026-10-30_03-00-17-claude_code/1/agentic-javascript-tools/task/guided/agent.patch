diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,101 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        detailsUrl: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        detailsUrl: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        detailsUrl: "/menu/cold-brew",
+      },
+    ];
+
+    const normalizeName = (value) =>
+      value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
+
+    function findMenuItem(itemName) {
+      const query = normalizeName(itemName);
+      return (
+        MENU_ITEMS.find((item) => normalizeName(item.name) === query) ??
+        MENU_ITEMS.find((item) => normalizeName(item.name).includes(query))
+      );
+    }
+
+    const getMenuItemDetailsTool = {
+      name: "get_menu_item_details",
+      description:
+        "Looks up a Daily Grind menu item by name and returns its details. Use when the user asks what a drink is, what's in it, or where to learn more about it.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          itemName: {
+            type: "string",
+            description: "Name of the menu item as the user said it, e.g. \"maple oat latte\" or \"cold brew\".",
+          },
+        },
+        required: ["itemName"],
+      },
+      execute({ itemName }) {
+        // The browser doesn't validate input against inputSchema, so check it here.
+        if (typeof itemName !== "string" || !normalizeName(itemName)) {
+          return {
+            error: "Pass the name of a menu item.",
+            availableItems: MENU_ITEMS.map((item) => item.name),
+          };
+        }
+        const item = findMenuItem(itemName);
+        if (!item) {
+          return {
+            error: `Menu item "${itemName}" not found.`,
+            availableItems: MENU_ITEMS.map((item) => item.name),
+          };
+        }
+        return { ...item, detailsUrl: new URL(item.detailsUrl, location.origin).href };
+      },
+      annotations: { readOnlyHint: true },
+    };
+
+    let toolRegistration = null;
+
+    function registerMenuTools() {
+      if (!("modelContext" in document) || toolRegistration) return;
+      toolRegistration = new AbortController();
+      document.modelContext
+        .registerTool(getMenuItemDetailsTool, { signal: toolRegistration.signal })
+        .catch((err) => {
+          toolRegistration = null;
+          console.error("Failed to register WebMCP menu tool:", err);
+        });
+    }
+
+    function unregisterMenuTools() {
+      toolRegistration?.abort();
+      toolRegistration = null;
+    }
+
+    registerMenuTools();
+    // Use pagehide/pageshow instead of unload so the page stays bfcache-eligible
+    // and the tool comes back when the page is restored from the cache.
+    addEventListener("pagehide", unregisterMenuTools);
+    addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
