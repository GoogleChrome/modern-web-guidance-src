+  <script>
+    (function () {
+      var range = document.getElementById('brew-strength');
+      var output = document.getElementById('brew-strength-value');
+      var note = document.getElementById('brew-strength-note');
+      var levels = [
+        { label: 'Mild', note: 'Try a Cold Brew for a gentle, smooth sip.' },
+        { label: 'Smooth', note: 'Try a light roast pour-over with bright, fruity notes.' },
+        { label: 'Balanced', note: 'Try our Maple Oat Latte with a medium roast.' },
+        { label: 'Bold', note: 'Try a dark roast drip for a rich, full body.' },
+        { label: 'Intense', note: 'Try our Dark Roast Espresso for maximum kick.' }
+      ];
+
+      function update() {
+        var min = Number(range.min);
+        var max = Number(range.max);
+        var value = Number(range.value);
+        var level = levels[value - min];
+        range.style.setProperty('--ratio', (value - min) / (max - min));
+        range.setAttribute('aria-valuetext', value + ' of ' + max + ', ' + level.label);
+        output.value = level.label;
+        note.textContent = level.note;
+      }
+
+      range.addEventListener('input', update);
+      update();
+    })();
+  </script>
+
