+    /* Brew Strength Slider */
+    .brew-strength {
+      --thumb-size: 26px;
+      --track-height: 10px;
+      --track-bg: var(--secondary);
+      --fill: var(--accent);
+      --ratio: 0.5;
+      max-width: 640px;
+      margin: 60px auto 0;
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .brew-strength h2 {
+      text-align: center;
+      margin-bottom: 5px;
+    }
+
+    .brew-strength-intro {
+      text-align: center;
+      margin-bottom: 25px;
+    }
+
+    .strength-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 12px;
+    }
+
+    .strength-header label {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .strength-value {
+      font-weight: bold;
+      color: var(--primary);
+      background: #fff3e0;
+      padding: 2px 12px;
+      border-radius: 999px;
+      font-size: 0.9rem;
+    }
+
+    .strength-range {
+      -webkit-appearance: none;
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: var(--thumb-size);
+      background: transparent;
+      cursor: pointer;
+      margin: 0;
+    }
+
+    .strength-range:focus {
+      outline: none;
+    }
+
+    /* Track (WebKit/Blink) - fill is drawn as a gradient stop that follows the thumb center */
+    .strength-range::-webkit-slider-runnable-track {
+      height: var(--track-height);
+      border-radius: var(--track-height);
+      background: linear-gradient(to right,
+          var(--fill) 0,
+          var(--fill) calc(var(--thumb-size) / 2 + (100% - var(--thumb-size)) * var(--ratio)),
+          var(--track-bg) calc(var(--thumb-size) / 2 + (100% - var(--thumb-size)) * var(--ratio)));
+      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15);
+    }
+
+    .strength-range::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb-size);
+      height: var(--thumb-size);
+      margin-top: calc((var(--track-height) - var(--thumb-size)) / 2);
+      border-radius: 50%;
+      background: var(--primary);
+      border: 4px solid white;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Track (Firefox) - native progress pseudo-element handles the fill */
+    .strength-range::-moz-range-track {
+      height: var(--track-height);
+      border-radius: var(--track-height);
+      background: var(--track-bg);
+      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15);
+    }
+
+    .strength-range::-moz-range-progress {
+      height: var(--track-height);
+      border-radius: var(--track-height);
+      background: var(--fill);
+    }
+
+    .strength-range::-moz-range-thumb {
+      width: var(--thumb-size);
+      height: var(--thumb-size);
+      box-sizing: border-box;
+      border-radius: 50%;
+      background: var(--primary);
+      border: 4px solid white;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Hover / active */
+    .strength-range:hover::-webkit-slider-thumb {
+      transform: scale(1.1);
+    }
+
+    .strength-range:hover::-moz-range-thumb {
+      transform: scale(1.1);
+    }
+
+    .strength-range:active {
+      cursor: grabbing;
+    }
+
+    .strength-range:active::-webkit-slider-thumb {
+      background: var(--text);
+      transform: scale(1.15);
+    }
+
+    .strength-range:active::-moz-range-thumb {
+      background: var(--text);
+      transform: scale(1.15);
+    }
+
+    /* Keyboard focus ring on the thumb */
+    .strength-range:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 3px white, 0 0 0 6px var(--primary), 0 2px 6px rgba(0, 0, 0, 0.3);
+    }
+
+    .strength-range:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 3px white, 0 0 0 6px var(--primary), 0 2px 6px rgba(0, 0, 0, 0.3);
+    }
+
+    .strength-ticks {
+      position: relative;
+      height: 1.5em;
+      margin: 8px calc(var(--thumb-size) / 2) 0;
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .strength-ticks span {
+      position: absolute;
+      transform: translateX(-50%);
+      white-space: nowrap;
+    }
+
+    .strength-note {
+      margin-top: 20px;
+      text-align: center;
+      font-style: italic;
+    }
+
+    /* Let the OS draw the control in high-contrast modes */
+    @media (forced-colors: active) {
+      .strength-range {
+        -webkit-appearance: auto;
+        appearance: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .strength-range::-webkit-slider-thumb {
+        transition: none;
+      }
+
+      .strength-range::-moz-range-thumb {
+        transition: none;
+      }
+    }
+
