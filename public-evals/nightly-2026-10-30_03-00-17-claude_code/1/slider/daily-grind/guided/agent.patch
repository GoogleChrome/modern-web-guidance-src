+  <script>
+    const brewSlider = document.querySelector('#brew-strength');
+    const brewOutput = document.querySelector('#brew-strength-value');
+    const brewLabels = ['Mild', 'Smooth', 'Balanced', 'Bold', 'Extra Bold'];
+
+    function syncBrewStrength() {
+      const label = brewLabels[brewSlider.value - brewSlider.min];
+      brewSlider.style.setProperty('--attr-min', brewSlider.min || 0);
+      brewSlider.style.setProperty('--attr-max', brewSlider.max || 100);
+      brewSlider.style.setProperty('--control-value', brewSlider.value);
+      brewSlider.setAttribute('aria-valuetext', label);
+      brewOutput.textContent = label;
+    }
+
+    syncBrewStrength();
+    brewSlider.addEventListener('input', syncBrewStrength);
+  </script>
+
