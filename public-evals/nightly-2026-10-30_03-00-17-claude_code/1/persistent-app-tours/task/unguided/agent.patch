+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+      var closeBtn = document.getElementById('tour-step-close');
+      var supportsAnchor = window.CSS && CSS.supports('anchor-name: --a');
+      var supportsPopover = typeof step.showPopover === 'function';
+      var open = false;
+      var frame = null;
+
+      // Fallback for browsers without CSS anchor positioning: follow the link every frame.
+      function track() {
+        var r = link.getBoundingClientRect();
+        var w = step.offsetWidth;
+        var left = Math.min(Math.max(r.left + r.width / 2 - w / 2, 12), window.innerWidth - w - 12);
+        step.style.top = r.bottom + 'px';
+        step.style.left = left + 'px';
+        frame = requestAnimationFrame(track);
+      }
+
+      function show() {
+        open = true;
+        link.classList.add('tour-active');
+        if (supportsPopover) {
+          step.showPopover();
+        } else {
+          step.style.display = 'block';
+          step.style.zIndex = '2000';
+        }
+        if (!supportsAnchor) track();
+      }
+
+      function hide() {
+        open = false;
+        link.classList.remove('tour-active');
+        if (supportsPopover) {
+          step.hidePopover();
+        } else {
+          step.style.display = 'none';
+        }
+        if (frame) cancelAnimationFrame(frame);
+        frame = null;
+      }
+
+      // Keep the user on the page while the tour is showing.
+      link.addEventListener('click', function (e) {
+        if (open) e.preventDefault();
+      });
+
+      closeBtn.addEventListener('click', hide);
+
+      show();
+    })();
+  </script>
+
