+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var toggle = document.getElementById('theater-toggle');
+      var hero = document.querySelector('.hero');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var containerSlot = document.getElementById('container-video-slot');
+
+      // moveBefore() performs an atomic move that keeps the iframe's browsing
+      // context alive, so the video keeps playing without reloading.
+      var supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      // Legacy fallback: removing an iframe from the DOM reloads it, so track the
+      // player's position via the YouTube embed postMessage protocol and resume
+      // from there after the move.
+      var player = { time: 0, playing: false };
+
+      function listenToPlayer() {
+        if (!iframe.contentWindow) return;
+        iframe.contentWindow.postMessage(
+          JSON.stringify({ event: 'listening', id: iframe.id, channel: 'widget' }),
+          'https://www.youtube.com'
+        );
+      }
+
+      if (!supportsMoveBefore) {
+        iframe.addEventListener('load', listenToPlayer);
+        listenToPlayer();
+
+        window.addEventListener('message', function (e) {
+          if (e.source !== iframe.contentWindow || e.origin !== 'https://www.youtube.com') return;
+          var data;
+          try {
+            data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
+          } catch (err) {
+            return;
+          }
+          var info = data && data.info;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') player.time = info.currentTime;
+          // 1 = playing, 3 = buffering
+          if (typeof info.playerState === 'number') {
+            player.playing = info.playerState === 1 || info.playerState === 3;
+          }
+        });
+      }
+
+      function legacyMove(slot) {
+        var url = new URL(iframe.src);
+        url.searchParams.set('start', String(Math.floor(player.time)));
+        url.searchParams.set('autoplay', player.playing ? '1' : '0');
+        iframe.src = url.toString();
+        slot.appendChild(iframe);
+      }
+
+      function moveVideo(slot) {
+        if (supportsMoveBefore) {
+          try {
+            slot.moveBefore(iframe, null);
+            return;
+          } catch (err) {
+            // Fall through to the legacy path if the move is rejected.
+          }
+        }
+        legacyMove(slot);
+      }
+
+      toggle.addEventListener('click', function () {
+        var entering = !hero.classList.contains('theater');
+        hero.classList.toggle('theater', entering);
+        containerSlot.classList.toggle('is-empty', entering);
+        moveVideo(entering ? heroSlot : containerSlot);
+        toggle.textContent = entering ? 'Exit Theater Mode' : 'Theater Mode';
+        toggle.setAttribute('aria-pressed', String(entering));
+        if (entering) hero.scrollIntoView({ behavior: 'smooth' });
+      });
+    })();
+  </script>
