+  <script>
+    (() => {
+      const video = document.getElementById('roast-video');
+      const hero = document.getElementById('hero');
+      const heroSlot = document.getElementById('theater-slot');
+      const inlineSlot = document.getElementById('video-slot');
+      const toggle = document.getElementById('theater-toggle');
+      const canMoveAtomically = 'moveBefore' in Element.prototype;
+
+      // Fallback only: without moveBefore() the iframe reloads when it moves, so
+      // keep track of playback via the YouTube embed's postMessage API and
+      // resume from the same spot after the move.
+      const player = { time: 0, playing: false };
+
+      if (!canMoveAtomically) {
+        const listen = () => video.contentWindow.postMessage(
+          JSON.stringify({ event: 'listening', id: video.id, channel: 'widget' }), '*');
+        video.addEventListener('load', listen);
+
+        window.addEventListener('message', (event) => {
+          if (event.source !== video.contentWindow) return;
+          let data;
+          try { data = JSON.parse(event.data); } catch { return; }
+          const info = data && data.info;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') player.time = info.currentTime;
+          // playerState: 1 = playing, 3 = buffering
+          if (typeof info.playerState === 'number') player.playing = info.playerState === 1 || info.playerState === 3;
+        });
+      }
+
+      function moveVideo(target) {
+        if (canMoveAtomically) {
+          target.moveBefore(video, null);
+          return;
+        }
+        const url = new URL(video.src);
+        url.searchParams.set('start', Math.floor(player.time));
+        url.searchParams.set('autoplay', player.playing ? '1' : '0');
+        // Detach before swapping src so the iframe only loads once, in its new home.
+        video.remove();
+        video.src = url.href;
+        target.insertBefore(video, null);
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+        moveVideo(entering ? heroSlot : inlineSlot);
+        hero.classList.toggle('theater', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit Theater Mode' : 'Theater Mode';
+        if (entering) hero.scrollIntoView({ behavior: 'smooth' });
+      });
+    })();
+  </script>
+
