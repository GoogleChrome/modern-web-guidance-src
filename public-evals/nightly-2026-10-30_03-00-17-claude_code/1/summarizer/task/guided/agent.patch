+  <script type="module">
+    const button = document.getElementById('summarize-btn');
+    const status = document.getElementById('summary-status');
+    const list = document.getElementById('summary');
+    const journal = document.getElementById('journal-body');
+
+    const options = {
+      sharedContext: "A coffee roaster's journal entry about how they source their beans",
+      type: 'key-points',
+      format: 'markdown',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    let summarizer;
+
+    function unsupported(message) {
+      button.disabled = true;
+      status.textContent = message;
+    }
+
+    // Render markdown bullet lines as list items using textContent (never innerHTML).
+    function renderBullets(markdown) {
+      const items = markdown
+        .split('\n')
+        .map((line) => line.replace(/^\s*(?:[-*•]|\d+\.)\s+/, '').replace(/\*\*/g, '').trim())
+        .filter(Boolean);
+      list.replaceChildren(...items.map((text) => {
+        const li = document.createElement('li');
+        li.textContent = text;
+        return li;
+      }));
+      list.hidden = items.length === 0;
+    }
+
+    async function getSummarizer() {
+      if (summarizer) return summarizer;
+      summarizer = await Summarizer.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            status.textContent = `Downloading on-device AI model… ${Math.round((e.loaded / e.total) * 100)}%`;
+          });
+        },
+      });
+      return summarizer;
+    }
+
+    if (!('Summarizer' in self)) {
+      unsupported('On-device summarization is not supported in this browser.');
+    } else {
+      const availability = await Summarizer.availability(options);
+      if (availability === 'unavailable') {
+        unsupported('On-device summarization is unavailable on this device.');
+      } else {
+        if (availability !== 'available') {
+          status.textContent = 'The first summary will download an on-device AI model.';
+        }
+
+        button.addEventListener('click', async () => {
+          button.disabled = true;
+          status.textContent = 'Preparing summarizer…';
+          try {
+            // Create within the click handler: model download requires a user gesture.
+            const s = await getSummarizer();
+            status.textContent = 'Summarizing…';
+            let output = '';
+            for await (const chunk of s.summarizeStreaming(journal.innerText)) {
+              output += chunk;
+              renderBullets(output);
+            }
+            status.textContent = 'Summary generated on your device.';
+          } catch (err) {
+            console.error(err);
+            status.textContent = 'Sorry, we couldn\'t summarize the journal right now.';
+          } finally {
+            button.disabled = false;
+          }
+        });
+      }
+    }
+  </script>
+
 </body>
 
