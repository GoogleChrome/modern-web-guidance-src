+  <script>
+    // Summarize the Roaster's Journal with the browser's built-in Summarizer API (Chrome's on-device AI).
+    (async () => {
+      const btn = document.getElementById('summarize-btn');
+      const summaryBox = document.getElementById('journal-summary');
+      const statusEl = document.getElementById('journal-status');
+      const list = document.getElementById('journal-summary-list');
+      const body = document.getElementById('journal-body');
+
+      const options = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        sharedContext: "A coffee roaster's blog post about how they source their beans.",
+      };
+
+      if (!('Summarizer' in self)) return;
+
+      let availability;
+      try {
+        availability = await Summarizer.availability(options);
+      } catch {
+        return;
+      }
+      if (availability === 'unavailable') return;
+
+      btn.hidden = false;
+      let summarizer = null;
+
+      const setStatus = (text) => {
+        statusEl.textContent = text;
+        statusEl.hidden = !text;
+      };
+
+      const renderBullets = (markdown) => {
+        list.replaceChildren();
+        markdown
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[-*+]|\d+\.)\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').trim())
+          .filter(Boolean)
+          .forEach((text) => {
+            const li = document.createElement('li');
+            li.textContent = text;
+            list.appendChild(li);
+          });
+      };
+
+      btn.addEventListener('click', async () => {
+        btn.disabled = true;
+        summaryBox.hidden = false;
+        list.replaceChildren();
+
+        try {
+          if (!summarizer) {
+            setStatus('Preparing on-device AI\u2026');
+            summarizer = await Summarizer.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  setStatus(`Downloading AI model\u2026 ${Math.round(e.loaded * 100)}%`);
+                });
+              },
+            });
+          }
+
+          setStatus('Summarizing\u2026');
+          const text = body.innerText.trim();
+          let output = '';
+          for await (const chunk of summarizer.summarizeStreaming(text)) {
+            output += chunk;
+            renderBullets(output);
+          }
+          setStatus('');
+        } catch (err) {
+          console.error(err);
+          setStatus("Sorry, we couldn't summarize this right now. Please try again.");
+        } finally {
+          btn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
