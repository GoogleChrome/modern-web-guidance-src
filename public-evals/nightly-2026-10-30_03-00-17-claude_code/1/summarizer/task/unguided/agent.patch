+  <section class="container" id="roasters-journal">
+    <article class="journal">
+      <div class="journal-header">
+        <div>
+          <h2>Roaster's Journal</h2>
+          <p class="journal-meta">From the Roastery &middot; How our beans find their way to your cup</p>
