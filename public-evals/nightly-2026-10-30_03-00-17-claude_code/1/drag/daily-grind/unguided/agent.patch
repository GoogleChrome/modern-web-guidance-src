+  <aside class="quick-order" id="quick-order" aria-label="Quick order">
+    <div class="qo-header" id="qo-handle" tabindex="0" role="toolbar"
+      aria-label="Quick order panel. Drag, or use arrow keys, to move.">
+      <span class="qo-title"><span class="qo-grip" aria-hidden="true">⋮⋮</span> Quick Order
+        <span class="qo-badge" id="qo-count" aria-label="items in cart">0</span></span>
+      <button type="button" class="qo-toggle" id="qo-toggle" aria-expanded="true"
+        aria-controls="qo-body" aria-label="Minimize quick order">&minus;</button>
+    </div>
+    <div class="qo-body" id="qo-body">
+      <div class="qo-field">
+        <label for="qo-drink">Drink</label>
+        <select id="qo-drink">
+          <option value="Maple Oat Latte" data-price="5.25">Maple Oat Latte — $5.25</option>
+          <option value="Dark Roast Espresso" data-price="3.50">Dark Roast Espresso — $3.50</option>
+          <option value="Cold Brew" data-price="4.75">Cold Brew — $4.75</option>
+          <option value="Cappuccino" data-price="4.50">Cappuccino — $4.50</option>
+        </select>
+      </div>
+      <div class="qo-field">
+        <fieldset>
+          <legend>Size</legend>
+          <div class="qo-sizes">
+            <label><input type="radio" name="qo-size" value="Small" data-extra="0"><span>S</span></label>
+            <label><input type="radio" name="qo-size" value="Medium" data-extra="0.50" checked><span>M</span></label>
+            <label><input type="radio" name="qo-size" value="Large" data-extra="1.00"><span>L</span></label>
+          </div>
+        </fieldset>
+      </div>
+      <div class="qo-row">
+        <div class="qo-stepper" role="group" aria-label="Quantity">
+          <button type="button" id="qo-minus" aria-label="Decrease quantity">&minus;</button>
+          <output id="qo-qty" aria-live="polite">1</output>
+          <button type="button" id="qo-plus" aria-label="Increase quantity">+</button>
+        </div>
+        <button type="button" class="qo-add" id="qo-add">Add to Cart</button>
+      </div>
+      <ul class="qo-cart" id="qo-cart" aria-live="polite"></ul>
+      <div class="qo-total">Total: <span id="qo-total">$0.00</span></div>
+      <a href="/order-online" class="qo-checkout" id="qo-checkout">Checkout</a>
+    </div>
+  </aside>
+
+  <script>
+    (function () {
+      var panel = document.getElementById('quick-order');
+      var handle = document.getElementById('qo-handle');
+      var toggle = document.getElementById('qo-toggle');
+      var POS_KEY = 'dailyGrind.quickOrder.pos';
+      var MARGIN = 8;
+
+      /* ---- Dragging ---- */
+      function clamp(x, y) {
+        var maxX = window.innerWidth - panel.offsetWidth - MARGIN;
+        var maxY = window.innerHeight - panel.offsetHeight - MARGIN;
+        return {
+          x: Math.min(Math.max(MARGIN, x), Math.max(MARGIN, maxX)),
+          y: Math.min(Math.max(MARGIN, y), Math.max(MARGIN, maxY))
+        };
+      }
+
+      function moveTo(x, y, save) {
+        var p = clamp(x, y);
+        panel.style.left = p.x + 'px';
+        panel.style.top = p.y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        if (save) {
+          try { localStorage.setItem(POS_KEY, JSON.stringify(p)); } catch (e) { }
+        }
+      }
+
+      var drag = null;
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.button !== 0 || e.target.closest('button')) return;
+        var rect = panel.getBoundingClientRect();
+        drag = { id: e.pointerId, dx: e.clientX - rect.left, dy: e.clientY - rect.top };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        moveTo(e.clientX - drag.dx, e.clientY - drag.dy, false);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('dragging');
+        var rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top, true);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      // Keyboard moving: arrow keys (Shift for bigger steps)
+      handle.addEventListener('keydown', function (e) {
+        if (e.target !== handle) return;
+        var step = e.shiftKey ? 50 : 10;
+        var d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
+        if (!d) return;
+        e.preventDefault();
+        var rect = panel.getBoundingClientRect();
+        moveTo(rect.left + d[0], rect.top + d[1], true);
+      });
+
+      // Keep the panel on-screen after viewport changes or collapse/expand
+      function reclamp() {
+        if (panel.style.left) {
+          var rect = panel.getBoundingClientRect();
+          moveTo(rect.left, rect.top, false);
+        }
+      }
+      window.addEventListener('resize', reclamp);
+
+      try {
+        var saved = JSON.parse(localStorage.getItem(POS_KEY));
+        if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') moveTo(saved.x, saved.y, false);
+      } catch (e) { }
+
+      toggle.addEventListener('click', function () {
+        var collapsed = panel.classList.toggle('collapsed');
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Expand' : 'Minimize') + ' quick order');
+        toggle.innerHTML = collapsed ? '+' : '&minus;';
+        reclamp();
+      });
+
+      /* ---- Order controls ---- */
+      var drinkEl = document.getElementById('qo-drink');
+      var qtyEl = document.getElementById('qo-qty');
+      var cartEl = document.getElementById('qo-cart');
+      var totalEl = document.getElementById('qo-total');
+      var countEl = document.getElementById('qo-count');
+      var checkoutEl = document.getElementById('qo-checkout');
+      var qty = 1;
+      var cart = [];
+
+      function money(n) { return '$' + n.toFixed(2); }
+
+      function setQty(n) {
+        qty = Math.min(10, Math.max(1, n));
+        qtyEl.textContent = qty;
+      }
+      document.getElementById('qo-minus').addEventListener('click', function () { setQty(qty - 1); });
+      document.getElementById('qo-plus').addEventListener('click', function () { setQty(qty + 1); });
+
+      function render() {
+        cartEl.innerHTML = '';
+        var total = 0, count = 0;
+        if (!cart.length) {
+          var empty = document.createElement('li');
+          empty.className = 'qo-empty';
+          empty.textContent = 'Your cart is empty';
+          cartEl.appendChild(empty);
+        }
+        cart.forEach(function (item, i) {
+          var line = item.price * item.qty;
+          total += line;
+          count += item.qty;
+          var li = document.createElement('li');
+          var label = document.createElement('span');
+          label.textContent = item.qty + '× ' + item.size + ' ' + item.name;
+          var right = document.createElement('span');
+          right.textContent = money(line);
+          var rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'qo-remove';
+          rm.setAttribute('aria-label', 'Remove ' + item.size + ' ' + item.name);
+          rm.textContent = '×';
+          rm.addEventListener('click', function () { cart.splice(i, 1); render(); });
+          right.appendChild(rm);
+          li.appendChild(label);
+          li.appendChild(right);
+          cartEl.appendChild(li);
+        });
+        totalEl.textContent = money(total);
+        countEl.textContent = count;
+        checkoutEl.setAttribute('aria-disabled', String(!cart.length));
+        checkoutEl.tabIndex = cart.length ? 0 : -1;
+        reclamp();
+      }
+
+      document.getElementById('qo-add').addEventListener('click', function () {
+        var opt = drinkEl.options[drinkEl.selectedIndex];
+        var sizeEl = document.querySelector('input[name="qo-size"]:checked');
+        var price = parseFloat(opt.dataset.price) + parseFloat(sizeEl.dataset.extra);
+        var existing = cart.find(function (it) { return it.name === opt.value && it.size === sizeEl.value; });
+        if (existing) existing.qty += qty;
+        else cart.push({ name: opt.value, size: sizeEl.value, price: price, qty: qty });
+        setQty(1);
+        render();
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
