+  <aside class="quick-order" id="quick-order" aria-labelledby="quick-order-title">
+    <div class="quick-order-header">
+      <span class="drag-grip" aria-hidden="true">&#x283F;</span>
+      <h2 id="quick-order-title">Quick Order</h2>
+      <button type="button" class="quick-order-toggle" aria-expanded="true" aria-controls="quick-order-body"
+        aria-label="Collapse quick order">&minus;</button>
+    </div>
+    <div class="quick-order-body" id="quick-order-body">
+      <form id="quick-order-form">
+        <label for="qo-drink">Drink</label>
+        <select id="qo-drink" name="drink">
+          <option value="Maple Oat Latte" data-price="5.25">Maple Oat Latte — $5.25</option>
+          <option value="Dark Roast Espresso" data-price="3.50">Dark Roast Espresso — $3.50</option>
+          <option value="Cold Brew" data-price="4.75">Cold Brew — $4.75</option>
+          <option value="Cappuccino" data-price="4.50">Cappuccino — $4.50</option>
+        </select>
+
+        <fieldset>
+          <legend>Size</legend>
+          <div class="size-options">
+            <label><input type="radio" name="size" value="Small" data-extra="0"> Small</label>
+            <label><input type="radio" name="size" value="Medium" data-extra="0.50" checked> Medium</label>
+            <label><input type="radio" name="size" value="Large" data-extra="1.00"> Large</label>
+          </div>
+        </fieldset>
+
+        <div class="order-row">
+          <div class="stepper" role="group" aria-label="Quantity">
+            <button type="button" data-step="-1" aria-label="Decrease quantity">&minus;</button>
+            <output id="qo-qty" aria-live="polite">1</output>
+            <button type="button" data-step="1" aria-label="Increase quantity">+</button>
+          </div>
+          <button type="submit" class="btn">Add to Cart</button>
+        </div>
+      </form>
+
+      <section class="cart" aria-labelledby="cart-title">
+        <h3 id="cart-title">Your Cart</h3>
+        <p class="cart-empty" id="cart-empty">Your cart is empty.</p>
+        <ul id="cart-items"></ul>
+        <div class="cart-total"><span>Total</span><span id="cart-total" aria-live="polite">$0.00</span></div>
+        <a href="/order-online" class="btn">Checkout</a>
+      </section>
+    </div>
+  </aside>
+
+  <script>
+    (() => {
+      const panel = document.getElementById('quick-order');
+      const handle = panel.querySelector('.quick-order-header');
+      const toggle = panel.querySelector('.quick-order-toggle');
+      const form = document.getElementById('quick-order-form');
+      const qtyOutput = document.getElementById('qo-qty');
+      const cartList = document.getElementById('cart-items');
+      const cartEmpty = document.getElementById('cart-empty');
+      const cartTotal = document.getElementById('cart-total');
+      const KEY_STEP = 15;
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      /* ---- Dragging ---- */
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute('aria-label', 'Quick order panel. Use arrow keys to move.');
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let moved = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      }
+
+      function savePosition() {
+        try {
+          localStorage.setItem('dg-quick-order-pos', JSON.stringify({ left: panel.offsetLeft, top: panel.offsetTop }));
+        } catch { }
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        moved = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!moved && Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
+        moved = true;
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+        if (moved) savePosition();
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const delta = {
+          ArrowLeft: [-KEY_STEP, 0],
+          ArrowRight: [KEY_STEP, 0],
+          ArrowUp: [0, -KEY_STEP],
+          ArrowDown: [0, KEY_STEP],
+        }[event.key];
+        if (!delta) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+        savePosition();
+      });
+
+      // Keep the panel reachable when the viewport or panel size changes.
+      function reclamp() {
+        if (panel.style.left) moveTo(panel.offsetLeft, panel.offsetTop);
+      }
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      try {
+        const saved = JSON.parse(localStorage.getItem('dg-quick-order-pos'));
+        if (saved) moveTo(saved.left, saved.top);
+      } catch { }
+
+      /* ---- Collapse ---- */
+      toggle.addEventListener('click', () => {
+        const collapsed = panel.classList.toggle('collapsed');
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', collapsed ? 'Expand quick order' : 'Collapse quick order');
+        toggle.innerHTML = collapsed ? '+' : '&minus;';
+      });
+
+      /* ---- Quantity ---- */
+      let qty = 1;
+      form.querySelectorAll('[data-step]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          qty = Math.max(1, Math.min(10, qty + Number(btn.dataset.step)));
+          qtyOutput.textContent = qty;
+        });
+      });
+
+      /* ---- Cart ---- */
+      const cart = [];
+
+      function renderCart() {
+        cartList.replaceChildren(...cart.map((item, i) => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.qty} × ${item.size} ${item.drink}`;
+          const price = document.createElement('span');
+          price.textContent = money(item.qty * item.price);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'cart-remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${item.size} ${item.drink}`);
+          remove.addEventListener('click', () => {
+            cart.splice(i, 1);
+            renderCart();
+          });
+          li.append(label, price, remove);
+          return li;
+        }));
+        cartEmpty.hidden = cart.length > 0;
+        cartTotal.textContent = money(cart.reduce((sum, item) => sum + item.qty * item.price, 0));
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const option = form.drink.selectedOptions[0];
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const drink = option.value;
+        const size = sizeInput.value;
+        const price = Number(option.dataset.price) + Number(sizeInput.dataset.extra);
+        const existing = cart.find((item) => item.drink === drink && item.size === size);
+        if (existing) existing.qty += qty;
+        else cart.push({ drink, size, price, qty });
+        qty = 1;
+        qtyOutput.textContent = qty;
+        renderCart();
+      });
+    })();
+  </script>
+
 </body>
 
