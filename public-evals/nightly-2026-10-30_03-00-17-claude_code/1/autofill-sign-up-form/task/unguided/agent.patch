+  <script>
+    const signupForm = document.querySelector('.signup-form');
+    const signupMessage = signupForm.querySelector('.form-message');
+
+    signupForm.addEventListener('submit', (event) => {
+      const name = signupForm.elements.name.value.trim();
+      const email = signupForm.elements.email;
+      const password = signupForm.elements.password.value;
+      const confirm = signupForm.elements.confirm_password.value;
+      let error = '';
+
+      if (!name) error = 'Please enter your name.';
+      else if (!email.value || !email.validity.valid) error = 'Please enter a valid email address.';
+      else if (password.length < 8) error = 'Password must be at least 8 characters.';
+      else if (password !== confirm) error = 'Passwords do not match.';
+      else if (!signupForm.elements.terms.checked) error = 'Please accept the Terms of Service.';
+
+      if (error) {
+        event.preventDefault();
+        signupMessage.textContent = error;
+        signupMessage.className = 'form-message error';
+      }
+    });
+  </script>
+
