+    /* View transitions */
+    ::view-transition-group(*) {
+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
+    }
+
+    /* Thumbnail -> hero: the two boxes have different aspect ratios, so
+       crop the snapshots to the animating box instead of stretching them. */
+    ::view-transition-group(hero) {
+      overflow: clip;
+      border-radius: 12px;
+    }
+
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    /* Title: scale uniformly by height (width follows the snapshot's own
+       aspect ratio) so the text grows/shrinks without being squashed. */
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: auto;
+      height: 100%;
+      object-fit: contain;
+      object-position: left center;
+    }
+
+    /* Keep the morphing elements above the cross-fading page. */
+    ::view-transition-group(hero),
+    ::view-transition-group(title) {
+      z-index: 1;
+    }
+
+    ::view-transition-group(title) {
+      z-index: 2;
+    }
+
+    /* Direction-specific page cross-fade (classes are set only while a
+       transition runs). */
+    @keyframes vt-rise {
+      from {
+        opacity: 0;
+        transform: translateY(16px);
+      }
+    }
+
+    @keyframes vt-fade-out {
+      to {
+        opacity: 0;
+      }
+    }
+
+    html.vt-forward::view-transition-new(root) {
+      animation: vt-rise 0.45s cubic-bezier(0.2, 0, 0, 1) both;
+    }
+
+    html.vt-forward::view-transition-old(root),
+    html.vt-back::view-transition-old(root) {
+      animation: vt-fade-out 0.2s ease-out both;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      *,
+      *::before,
+      *::after {
+        transition: none !important;
+        animation: none !important;
+      }
+
+      ::view-transition-group(*),
+      ::view-transition-image-pair(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
