+  <script>
+    const FAVORITES = [
+      {
+        id: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        tagline: 'Autumn in a cup.',
+        description: 'A double shot of our house espresso, steamed oat milk, and a drizzle of pure Vermont maple syrup, finished with a dusting of cinnamon. Smooth, cozy, and naturally dairy-free.',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A latte with leaf-shaped latte art in a white cup',
+        facts: { Size: '12 oz / 16 oz', Caffeine: 'Medium', Milk: 'Oat (dairy-free)' },
+      },
+      {
+        id: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost.',
+        tagline: 'Short, strong, and unapologetic.',
+        description: 'Our darkest roast, pulled as a rich double shot with a thick hazelnut crema. Notes of cocoa, toasted walnut, and a gentle smokiness that lingers.',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1600&q=80',
+        alt: 'Espresso pouring from a machine into a small glass',
+        facts: { Size: 'Double shot', Caffeine: 'High', Origin: 'Sumatra & Brazil blend' },
+      },
+      {
+        id: 'cold-brew',
+        name: 'Cold Brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness.',
+        tagline: 'Slow-steeped. Never bitter.',
+        description: 'Coarse-ground beans steeped in cold, filtered water for 18 hours, then served over ice. Low in acidity with a naturally sweet, chocolatey finish.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1600&q=80',
+        alt: 'Iced coffee in a glass with a straw',
+        facts: { Size: '16 oz / 24 oz', Caffeine: 'High', Steep: '18 hours' },
+      },
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const thumbnails = document.getElementById('thumbnails');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const backLink = document.getElementById('back-link');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentId = null;
+    let cameFromList = false;
+    let listScrollY = 0;
+    let activeTransition = null;
+
+    // --- Rendering -------------------------------------------------------
+
+    thumbnails.innerHTML = FAVORITES.map((item) => `
+      <li>
+        <a class="thumbnail" href="#/menu/${item.id}" data-id="${item.id}">
+          <img src="${item.image.replace('w=1600', 'w=700')}" alt="" loading="lazy">
+          <div class="thumbnail-text">
+            <h2 class="title">${item.name}</h2>
+            <p>${item.blurb}</p>
+          </div>
+        </a>
+      </li>
+    `).join('');
+
+    function renderDetail(item) {
+      hero.src = item.image;
+      hero.alt = item.alt;
+      title.textContent = item.name;
+      document.getElementById('detail-tagline').textContent = item.tagline;
+      document.getElementById('detail-description').textContent = item.description;
+      document.getElementById('detail-facts').innerHTML = Object.entries(item.facts)
+        .map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('');
+    }
+
+    function getThumbnail(id) {
+      return thumbnails.querySelector(`.thumbnail[data-id="${id}"]`);
+    }
+
+    // --- View transition naming -----------------------------------------
+    // Names are only set for the duration of a transition so that exactly
+    // one element owns "hero" and "title" at a time.
+
+    function setNames(card, heading, cardName = 'hero', headingName = 'title') {
+      if (card) card.style.viewTransitionName = cardName;
+      if (heading) heading.style.viewTransitionName = headingName;
+    }
+
+    function clearNames() {
+      document.querySelectorAll('.thumbnail, .thumbnail .title, #hero, #title').forEach((el) => {
+        el.style.removeProperty('view-transition-name');
+      });
+    }
+
+    function cleanupTransition() {
+      clearNames();
+      document.documentElement.classList.remove('vt-forward', 'vt-back');
+    }
+
+    // --- Navigation ------------------------------------------------------
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      document.title = 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function showDetail(item) {
+      renderDetail(item);
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      document.title = `${item.name} | The Daily Grind`;
+    }
+
+    function navigate(nextId) {
+      const prevId = currentId;
+      if (nextId === prevId) return;
+      const item = nextId && FAVORITES.find((f) => f.id === nextId);
+      if (nextId && !item) {
+        // Unknown item: fall back to the list.
+        history.replaceState(null, '', '#/');
+        return navigate(null);
+      }
+
+      const goingToDetail = Boolean(item);
+      if (goingToDetail && !prevId) listScrollY = window.scrollY;
+
+      const update = () => {
+        clearNames();
+        if (goingToDetail) {
+          showDetail(item);
+          window.scrollTo(0, 0);
+          setNames(hero, title);
+        } else {
+          showList();
+          window.scrollTo(0, listScrollY);
+          const card = getThumbnail(prevId);
+          setNames(card, card?.querySelector('.title'));
+        }
+        currentId = nextId;
+      };
+
+      const focusHeading = () => {
+        (goingToDetail ? title : listHeading).focus({ preventScroll: true });
+      };
+
+      const canAnimate = document.startViewTransition && !reducedMotion.matches;
+
+      if (!canAnimate) {
+        update();
+        cleanupTransition();
+        focusHeading();
+        return;
+      }
+
+      // Name the outgoing elements so they are captured in the "old" state.
+      cleanupTransition();
+      if (goingToDetail) {
+        const card = getThumbnail(nextId);
+        setNames(card, card?.querySelector('.title'));
+      } else {
+        setNames(hero, title);
+      }
+      document.documentElement.classList.add(goingToDetail ? 'vt-forward' : 'vt-back');
+
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+
+      transition.updateCallbackDone.then(focusHeading, focusHeading);
+      transition.finished.finally(() => {
+        // A newer transition may have started; leave its names alone.
+        if (activeTransition === transition) {
+          cleanupTransition();
+          activeTransition = null;
+        }
+      });
+    }
+
+    function idFromHash() {
+      const match = location.hash.match(/^#\/menu\/([\w-]+)/);
+      return match ? match[1] : null;
+    }
+
+    thumbnails.addEventListener('click', (event) => {
+      if (event.target.closest('.thumbnail')) cameFromList = true;
+    });
+
+    backLink.addEventListener('click', (event) => {
+      // Return to the list entry in history rather than stacking a new one.
+      if (cameFromList) {
+        event.preventDefault();
+        history.back();
+      }
+    });
+
+    window.addEventListener('hashchange', () => {
+      const id = idFromHash();
+      if (!id) cameFromList = false;
+      navigate(id);
+    });
+
+    // Initial render (no animation).
+    (function init() {
+      const id = idFromHash();
+      const item = id && FAVORITES.find((f) => f.id === id);
+      if (item) {
+        showDetail(item);
+        currentId = id;
+      } else {
+        if (id) history.replaceState(null, '', '#/');
+        showList();
+        currentId = null;
+      }
+    })();
+  </script>
+
 </body>
 
