+  <script>
+    const DRINKS = {
+      "maple-oat-latte": {
+        tagline: "Creamy oat milk with a hint of Vermont maple syrup.",
+        body: "A double shot of our house espresso, steamed oat milk, and a drizzle of pure Vermont maple syrup, finished with a dusting of cinnamon. Cozy, nutty, and just sweet enough."
+      },
+      "dark-roast-espresso": {
+        tagline: "Bold, smokey, and perfect for a morning boost.",
+        body: "Our darkest roast, pulled as a rich double shot. Expect notes of cocoa, toasted walnut, and a lingering smoky finish under a thick hazelnut crema."
+      },
+      "cold-brew": {
+        tagline: "Steeped for 18 hours for maximum smoothness.",
+        body: "Coarse-ground single-origin beans steeped cold for 18 hours, then served over ice. Low in acidity with a naturally sweet, chocolatey body. Add a splash of cream if you like."
+      }
+    };
+
+    const banner = document.querySelector(".banner");
+    const listPage = document.getElementById("list-page");
+    const detailPage = document.getElementById("detail-page");
+    const listHeading = document.getElementById("list-heading");
+    const hero = document.getElementById("hero");
+    const title = document.getElementById("title");
+    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
+
+    let currentDrink = null;
+    let listScrollY = 0;
+    let openedFromList = false;
+
+    history.scrollRestoration = "manual";
+
+    function drinkFromHash() {
+      const slug = location.hash.replace(/^#\/?/, "");
+      return slug in DRINKS ? slug : null;
+    }
+
+    function thumbnailFor(slug) {
+      return document.querySelector(`.thumbnail[data-drink="${slug}"]`);
+    }
+
+    function clearSelected() {
+      document.querySelectorAll(".thumbnail.selected").forEach((el) => el.classList.remove("selected"));
+    }
+
+    function transition(update) {
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        return Promise.resolve();
+      }
+      return document.startViewTransition(update).finished;
+    }
+
+    function showDetail(slug, { animate = true } = {}) {
+      const thumb = thumbnailFor(slug);
+      const img = thumb.querySelector("img");
+
+      // Prepare the old state: only the clicked thumbnail carries the shared names
+      clearSelected();
+      thumb.classList.add("selected");
+      if (!listPage.hidden) listScrollY = scrollY;
+
+      const update = () => {
+        hero.src = img.currentSrc || img.src;
+        hero.alt = img.alt;
+        title.textContent = thumb.querySelector(".title").textContent;
+        detailPage.querySelector(".detail-tagline").textContent = DRINKS[slug].tagline;
+        detailPage.querySelector(".detail-body").textContent = DRINKS[slug].body;
+        banner.hidden = true;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        scrollTo(0, 0);
+      };
+      currentDrink = slug;
+
+      if (!animate) {
+        update();
+        return;
+      }
+      transition(update).finally(() => {
+        if (currentDrink === slug) title.focus({ preventScroll: true });
+      });
+    }
+
+    function showList({ animate = true } = {}) {
+      const thumb = currentDrink && thumbnailFor(currentDrink);
+      currentDrink = null;
+
+      const update = () => {
+        detailPage.hidden = true;
+        banner.hidden = false;
+        listPage.hidden = false;
+        if (listScrollY) {
+          scrollTo(0, listScrollY);
+        } else if (thumb) {
+          thumb.scrollIntoView({ block: "center" });
+        }
+      };
+
+      if (!animate) {
+        update();
+        clearSelected();
+        return;
+      }
+      transition(update).finally(() => {
+        // Skip cleanup if the user already opened another drink mid-transition
+        if (currentDrink) return;
+        clearSelected();
+        listHeading.focus({ preventScroll: true });
+      });
+    }
+
+    function route({ animate = true } = {}) {
+      const slug = drinkFromHash();
+      if (slug === currentDrink) return;
+      if (slug) {
+        showDetail(slug, { animate });
+      } else {
+        showList({ animate });
+      }
+    }
+
+    document.querySelectorAll(".thumbnail").forEach((thumb) => {
+      thumb.addEventListener("click", () => {
+        openedFromList = true;
+      });
+    });
+
+    detailPage.querySelector(".back-btn").addEventListener("click", () => {
+      if (openedFromList) {
+        openedFromList = false;
+        history.back();
+      } else {
+        history.pushState(null, "", location.pathname + location.search);
+        route();
+      }
+    });
+
+    addEventListener("hashchange", () => route());
+    route({ animate: false });
+  </script>
+
