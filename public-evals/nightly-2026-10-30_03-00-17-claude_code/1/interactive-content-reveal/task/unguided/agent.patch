     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product card spotlight reveal */
+    @property --mouse-x {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --mouse-y {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      overflow: hidden;
+      padding-bottom: 56px;
+      /* Only the spotlight size animates; the position follows the pointer directly */
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 140px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
+    /* Keep the original content above the overlay */
+    .product-card > :not(.spotlight-overlay) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      pointer-events: none;
+      background:
+        linear-gradient(rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.8)),
+        var(--card-image) center / cover no-repeat;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    .spotlight-details {
+      position: absolute;
+      left: 0;
+      right: 0;
+      bottom: 16px;
+      display: flex;
+      justify-content: center;
+      gap: 8px;
+      list-style: none;
+      font-size: 0.75rem;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .spotlight-details li {
+      background: var(--secondary);
+      padding: 2px 10px;
+      border-radius: 999px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
