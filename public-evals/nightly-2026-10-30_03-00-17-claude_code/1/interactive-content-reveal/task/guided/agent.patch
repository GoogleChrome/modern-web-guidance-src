@@ -119,8 +119,60 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Spotlight reveal on seasonal product cards */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      /* Only the spotlight size transitions; position updates are instant */
+      transition: --inner-size 0.3s ease-out, --outer-size 0.3s ease-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 120px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      background: var(--spotlight-image) center / cover no-repeat;
+      opacity: 0.45;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0px),
+          transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
