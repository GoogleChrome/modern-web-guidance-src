+    /* Customer Feedback Log */
+    .feedback-section {
+      margin-top: 50px;
+    }
+
+    .feedback-log {
+      --scrollbar-thumb: var(--accent);
+      --scrollbar-track: var(--primary);
+
+      max-height: 320px;
+      overflow-y: auto;
+      margin-top: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border: 2px solid var(--primary);
+      border-radius: 8px;
+      list-style: none;
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      scrollbar-gutter: stable;
+    }
+
+    .feedback-log:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Legacy fallback for older WebKit/Blink browsers */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        width: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 4px;
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
+    .feedback-entry {
+      background: white;
+      padding: 15px 20px;
+      border-left: 4px solid var(--accent);
+      border-radius: 6px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .feedback-entry + .feedback-entry {
+      margin-top: 15px;
+    }
+
+    .feedback-entry blockquote {
+      font-style: italic;
+    }
+
+    .feedback-entry figcaption {
+      margin-top: 8px;
+      font-size: 0.85rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
