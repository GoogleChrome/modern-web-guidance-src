+
+    .feedback-log {
+      max-height: 320px;
+      overflow-y: auto;
+      margin-top: 20px;
+      padding: 15px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      /* Firefox */
+      scrollbar-width: thin;
+      scrollbar-color: var(--accent) var(--primary);
+    }
+
+    /* WebKit / Blink */
+    .feedback-log::-webkit-scrollbar {
+      width: 8px;
+    }
+
+    .feedback-log::-webkit-scrollbar-track {
+      background: var(--primary);
+      border-radius: 4px;
+    }
+
+    .feedback-log::-webkit-scrollbar-thumb {
+      background: var(--accent);
+      border-radius: 4px;
+    }
+
+    .testimonial {
+      padding: 15px;
+      border-left: 4px solid var(--accent);
+      background: #f5f0ee;
+      border-radius: 4px;
+      margin-bottom: 15px;
+    }
+
+    .testimonial:last-child {
+      margin-bottom: 0;
+    }
+
+    .testimonial p {
+      font-style: italic;
+    }
+
+    .testimonial .author {
+      display: block;
+      margin-top: 8px;
+      font-size: 0.85rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
