+  <script>
+    // Fallback for browsers without CSS scroll-driven animations: map the
+    // scroll position to --nav-progress (0 → 1), which the nav styles read.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('animation-timeline', 'scroll()')) return;
+
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var shadow = null;
+      var hasVars = !!(window.CSS && CSS.supports && CSS.supports('--a', '0'));
+      var distance = hasVars && parseFloat(getComputedStyle(document.documentElement)
+        .getPropertyValue('--nav-shrink-distance')) || 160;
+
+      // Browsers without custom properties ignore the calc() rules, so set the
+      // interpolated values directly (mirrors the defaults in :root).
+      if (!hasVars) {
+        shadow = document.createElement('div');
+        shadow.style.cssText = 'position:absolute;left:0;right:0;top:100%;height:8px;' +
+          'pointer-events:none;opacity:0;filter:alpha(opacity=0);' +
+          'background:linear-gradient(rgba(0,0,0,.25),rgba(0,0,0,0));';
+        nav.appendChild(shadow);
+      }
+
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(y / distance, 0), 1);
+        if (hasVars) {
+          nav.style.setProperty('--nav-progress', progress.toFixed(3));
+        } else {
+          nav.style.minHeight = (80 - 28 * progress) + 'px';
+          logo.style.fontSize = (1.5 - 0.35 * progress) + 'em';
+          shadow.style.opacity = progress;
+          shadow.style.filter = 'alpha(opacity=' + Math.round(progress * 100) + ')';
+        }
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          if (window.requestAnimationFrame) {
+            window.requestAnimationFrame(update);
+          } else {
+            setTimeout(update, 16);
+          }
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
