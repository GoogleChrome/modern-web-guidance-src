+  <script>
+    // Fallback for browsers without scroll-driven animations: mirror the
+    // CSS effect with a scroll listener (keep ES5 for older browsers).
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      var reducedMotion = window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (supportsScrollTimeline || reducedMotion) return;
+
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var initialHeight = 96;
+      var finalHeight = 56;
+      var scrollDistance = initialHeight - finalHeight;
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var scrollY = window.pageYOffset || document.documentElement.scrollTop;
+        var progress = Math.max(0, Math.min(1, scrollY / scrollDistance));
+        var scale = 1 - 0.2 * progress;
+
+        nav.style.height = (initialHeight - scrollDistance * progress) + 'px';
+        nav.style.boxShadow = '0 2px 8px rgba(0, 0, 0, ' + (0.3 * progress) + ')';
+        logo.style.webkitTransform = 'scale(' + scale + ')';
+        logo.style.transform = 'scale(' + scale + ')';
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || setTimeout)(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll);
+      update();
+    })();
+  </script>
