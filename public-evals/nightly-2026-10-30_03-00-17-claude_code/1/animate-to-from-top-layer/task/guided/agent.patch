+  <dialog id="logout-dialog" class="modal" aria-labelledby="logout-dialog-title">
+    <h2 id="logout-dialog-title">Log out?</h2>
+    <p>You'll need to sign in again to place orders or check your rewards.</p>
+    <div class="modal-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log Out</a>
+    </div>
+  </dialog>
+
+  <div id="order-notice" class="notice" popover role="status">
+    <p>online ordering is currently offline</p>
+    <button type="button" class="notice-close" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script type="module">
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    // Firefox parses allow-discrete without actually transitioning display, so probe it
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    // Plays the exit transition before leaving the top layer where CSS alone can't
+    async function closeTopLayer(element, close) {
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+      close();
+    }
+
+    const dialog = document.getElementById('logout-dialog');
+    const closeDialog = () => closeTopLayer(dialog, () => dialog.close());
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (event) => {
+      event.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDialog();
+    });
+
+    const notice = document.getElementById('order-notice');
+    notice.querySelector('.notice-close').addEventListener('click', () => {
+      closeTopLayer(notice, () => notice.hidePopover());
+    });
+  </script>
+
