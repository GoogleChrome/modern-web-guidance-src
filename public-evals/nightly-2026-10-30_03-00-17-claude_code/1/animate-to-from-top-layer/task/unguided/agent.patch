+  <script>
+    // Runs `done` once the element's exit animation finishes (or immediately if there is none).
+    function afterAnimation(el, done) {
+      const name = getComputedStyle(el).animationName;
+      if (!name || name === 'none') return done();
+      function handler(e) {
+        if (e.target !== el) return;
+        el.removeEventListener('animationend', handler);
+        el.removeEventListener('animationcancel', handler);
+        // Skip if the exit was interrupted (e.g. reopened mid-animation)
+        if (e.type === 'animationend' && e.animationName === name) done();
+      }
+      el.addEventListener('animationend', handler);
+      el.addEventListener('animationcancel', handler);
+    }
+
+    // Logout confirmation modal
+    const dialog = document.getElementById('logout-dialog');
+
+    function closeDialog() {
+      if (!dialog.open || dialog.classList.contains('is-closing')) return;
+      dialog.classList.add('is-closing');
+      afterAnimation(dialog, () => {
+        dialog.classList.remove('is-closing');
+        dialog.close();
+      });
+    }
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.classList.remove('is-closing');
+      if (!dialog.open) dialog.showModal();
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+
+    // Animate Escape-key dismissal instead of closing instantly
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+
+    // Clicking the backdrop (outside the content box) dismisses the modal
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) closeDialog();
+    });
+
+    // Ordering status overlay
+    const overlay = document.getElementById('ordering-overlay');
+    const overlayTrigger = document.getElementById('foobar');
+
+    function hideOverlay() {
+      if (overlay.hidden || overlay.classList.contains('is-closing')) return;
+      overlay.classList.remove('is-open');
+      overlay.classList.add('is-closing');
+      overlayTrigger.setAttribute('aria-expanded', 'false');
+      afterAnimation(overlay, () => {
+        overlay.classList.remove('is-closing');
+        overlay.hidden = true;
+      });
+    }
+
+    overlayTrigger.setAttribute('aria-expanded', 'false');
+    overlayTrigger.addEventListener('click', () => {
+      if (!overlay.hidden && !overlay.classList.contains('is-closing')) return hideOverlay();
+      overlay.classList.remove('is-closing');
+      overlay.hidden = false;
+      overlay.classList.add('is-open');
+      overlayTrigger.setAttribute('aria-expanded', 'true');
+    });
+
+    overlay.querySelector('.info-overlay-close').addEventListener('click', hideOverlay);
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && !dialog.open) hideOverlay();
+    });
+  </script>
