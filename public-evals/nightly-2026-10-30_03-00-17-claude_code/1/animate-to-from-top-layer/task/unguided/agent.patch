+  <dialog class="modal" id="logout-dialog" aria-labelledby="logout-dialog-title">
+    <div class="modal-content">
+      <h2 id="logout-dialog-title">Log out?</h2>
+      <p>Are you sure you want to log out of your account?</p>
+      <div class="modal-actions">
+        <button type="button" class="btn btn-secondary" id="close-dialog-btn">Cancel</button>
+        <a href="/logout" class="btn">Log Out</a>
+      </div>
+    </div>
+  </dialog>
+
+  <div class="info-overlay" id="ordering-overlay" role="status" hidden>
+    <p>Online ordering is currently offline.</p>
+    <button type="button" class="info-overlay-close" aria-label="Dismiss">&times;</button>
+  </div>
