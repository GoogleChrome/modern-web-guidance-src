+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const origins = scroller.querySelectorAll('.origin');
+      let scrolling = false;
+
+      // Keep scroll-time work minimal: write the status once per scroll gesture.
+      scroller.addEventListener('scroll', () => {
+        if (scrolling) return;
+        scrolling = true;
+        status.textContent = 'Scrolling...';
+      }, { passive: true });
+
+      // Layout reads happen only once scrolling has fully settled.
+      scroller.addEventListener('scrollend', () => {
+        scrolling = false;
+        const view = scroller.getBoundingClientRect();
+        let best = null;
+        let bestVisible = 0;
+        for (const origin of origins) {
+          const rect = origin.getBoundingClientRect();
+          const visible = Math.min(rect.bottom, view.bottom) - Math.max(rect.top, view.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = origin;
+          }
+        }
+        status.textContent = best
+          ? `Scroll ended. Visible: ${best.querySelector('h3').textContent}`
+          : 'Scroll ended.';
+      });
+
+      // Fallback for browsers without scrollend: dispatch it after scrolling goes idle.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 100);
+        }, { passive: true });
+      }
+    })();
+  </script>
+
