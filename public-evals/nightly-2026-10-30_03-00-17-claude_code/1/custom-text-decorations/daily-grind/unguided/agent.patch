+    /* Decorative text lines
+       Shared base: lines start transparent and pushed away from the text,
+       then slide into place on interaction. Skip-ink keeps underlines and
+       overlines from colliding with descenders (y, p, g, j). */
+    .deco {
+      --deco-color: var(--accent);
+      --deco-duration: 0.35s;
+      --deco-ease: cubic-bezier(0.22, 1, 0.36, 1);
+      text-decoration-line: underline;
+      text-decoration-style: solid;
+      text-decoration-color: transparent;
+      text-decoration-thickness: 0.08em;
+      text-underline-offset: 0.55em;
+      text-decoration-skip-ink: auto;
+      transition:
+        color 0.3s,
+        text-decoration-color var(--deco-duration) var(--deco-ease),
+        text-decoration-thickness var(--deco-duration) var(--deco-ease),
+        text-underline-offset var(--deco-duration) var(--deco-ease),
+        text-decoration-inset var(--deco-duration) var(--deco-ease);
+    }
+
+    /* Horizontal end insets: where supported, lines also grow outward
+       from the centre as they reveal. */
+    @supports (text-decoration-inset: 0) {
+      .deco {
+        text-decoration-inset: 1.5em;
+      }
+    }
+
+    /* Nav links: underline rises from below and settles just under the baseline */
+    nav a.deco:hover,
+    nav a.deco:focus-visible {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: 0.25em;
+      text-decoration-thickness: 0.1em;
+      text-decoration-inset: 0.1em;
+    }
+
+    /* Logout: a playful strikethrough that "crosses out" the session */
+    nav a.deco.logout-link {
+      text-decoration-line: line-through;
+      text-decoration-thickness: 0;
+    }
+
+    nav a.deco.logout-link:hover,
+    nav a.deco.logout-link:focus-visible {
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.12em;
+      text-decoration-inset: -0.2em;
+    }
+
+    /* Section heading: wavy accent line that draws itself in on load */
+    .deco-heading {
+      --deco-duration: 0.9s;
+      text-decoration-style: wavy;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.06em;
+      text-underline-offset: 0.3em;
+      text-decoration-inset: 0.15em -0.15em;
+      animation: deco-heading-reveal 1.2s var(--deco-ease) 0.2s both;
+    }
+
+    @keyframes deco-heading-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-underline-offset: 0.9em;
+        text-decoration-thickness: 0;
+        text-decoration-inset: 4em;
+      }
+    }
+
+    /* Card titles: double underline revealed when the card is hovered */
+    .card .deco {
+      --deco-color: var(--primary);
+      text-decoration-style: double;
+      text-decoration-thickness: 0.05em;
+    }
+
+    .card:hover .deco,
+    .card:focus-within .deco {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: 0.2em;
+      text-decoration-inset: 0;
+    }
+
+    /* Footer links: dotted overline + underline pair closing in from both sides */
+    .footer-links a.deco {
+      --deco-color: var(--primary);
+      text-decoration-line: underline overline;
+      text-decoration-style: dotted;
+      text-decoration-thickness: 0.12em;
+      text-underline-offset: 0.6em;
+    }
+
+    .footer-links a.deco:hover,
+    .footer-links a.deco:focus-visible {
+      text-decoration-color: var(--deco-color);
+      text-underline-offset: 0.2em;
+      text-decoration-inset: 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .deco {
+        transition: color 0.3s, text-decoration-color 0.2s linear;
+        animation: none;
+      }
+    }
+
     nav a:hover {
       color: var(--accent);
     }
