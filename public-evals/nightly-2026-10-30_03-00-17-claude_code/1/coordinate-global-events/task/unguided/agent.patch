+  <script type="module">
+    // Use the native Temporal API; fall back to the reference polyfill only in browsers that lack it.
+    const Temporal = globalThis.Temporal
+      ?? (await import('https://cdn.jsdelivr.net/npm/@js-temporal/polyfill@0.5.1/+esm')).Temporal;
+
+    const TARGET_ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dateFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+    const offsetFormat = { timeZoneName: 'shortOffset' };
+
+    function formatPart(zdt, options) {
+      // ZonedDateTime formats in its own zone; passing a timeZone option would throw.
+      return zdt.toLocaleString('en-US', options);
+    }
+
+    // Resolve a wall-clock time in the host zone, detecting DST gaps and overlaps.
+    // Temporal objects are immutable: every step below returns a new instance.
+    function resolveHostTime(plain, tz) {
+      const earlier = plain.toZonedDateTime(tz, { disambiguation: 'earlier' });
+      const later = plain.toZonedDateTime(tz, { disambiguation: 'later' });
+
+      if (earlier.epochNanoseconds === later.epochNanoseconds) {
+        return { zdt: earlier, conflict: null };
+      }
+
+      // 'compatible' matches legacy behaviour: skip forward in a gap, take the earlier instant in an overlap.
+      const resolved = plain.toZonedDateTime(tz, { disambiguation: 'compatible' });
+      const isGap = !resolved.toPlainDateTime().equals(plain);
+      return { zdt: resolved, conflict: { type: isGap ? 'gap' : 'overlap', earlier, later } };
+    }
+
+    function describeConflict(plain, tz, { type, earlier, later }, resolved) {
+      const requested = plain.toLocaleString('en-US', timeFormat);
+      const shownTime = formatPart(resolved, timeFormat);
+      const shownOffset = formatPart(resolved, offsetFormat).split(' ').pop();
+
+      if (type === 'gap') {
+        const skipped = later.offsetNanoseconds - earlier.offsetNanoseconds;
+        const minutes = Math.abs(skipped) / 6e10;
+        return `<strong>Daylight saving gap:</strong> ${requested} does not exist in ${tz} on this date ` +
+          `because clocks spring forward by ${minutes} minutes. The time was moved forward to ` +
+          `${shownTime} (${shownOffset}), which is the same elapsed moment you'd reach if the clocks hadn't jumped.`;
+      }
+
+      const otherOffset = formatPart(later, offsetFormat).split(' ').pop();
+      return `<strong>Daylight saving overlap:</strong> ${requested} occurs twice in ${tz} on this date ` +
+        `because clocks fall back. The first occurrence (${shownOffset}) was used; the second ` +
+        `occurrence would be at ${otherOffset}, one repeated hour later.`;
+    }
+
+    function render() {
+      const tz = hostTzSelect.value;
+      let plain;
+      try {
+        plain = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      } catch {
+        grid.innerHTML = '<div class="card"><p>Choose a valid date and time to see the schedule.</p></div>';
+        hostWarning.hidden = true;
+        return;
+      }
+
+      const { zdt: hostZdt, conflict } = resolveHostTime(plain, tz);
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(plain, tz, conflict, hostZdt);
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      const hostDate = hostZdt.toPlainDate();
