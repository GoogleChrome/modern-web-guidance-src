+        const local = hostZdt.withTimeZone(id);
+        const dayDiff = hostDate.until(local.toPlainDate()).days;
+        const dayNote = dayDiff === 0 ? '' : ` (${dayDiff > 0 ? '+' : ''}${dayDiff} day${Math.abs(dayDiff) === 1 ? '' : 's'})`;
+
+        const card = document.createElement('div');
+        card.className = 'card' + (id === tz ? ' is-host' : '');
+        card.innerHTML = `
+          <h3>${label}${id === tz ? ' &middot; Host' : ''}</h3>
+          <div class="tz-time">${formatPart(local, timeFormat)}</div>
+          <div class="tz-date">${formatPart(local, dateFormat)}${dayNote}</div>
+          <div class="tz-zone">${id} &middot; ${formatPart(local, offsetFormat).split(' ').pop()}</div>`;
+        return card;
+      }));
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+    [dateInput, timeInput, hostTzSelect].forEach((el) => {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    });
+    render();
+  </script>
