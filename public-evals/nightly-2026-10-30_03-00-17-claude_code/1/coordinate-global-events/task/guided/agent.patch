+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    const timeFmt = { hour: 'numeric', minute: '2-digit' };
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Returns a description of the DST conflict (if any) for a wall-clock time in a zone.
+    function describeConflict(plain, timeZone, resolved) {
+      try {
+        plain.toZonedDateTime(timeZone, { disambiguation: 'reject' });
+        return null;
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+      }
+
+      const earlier = plain.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plain.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      const requested = plain.toPlainTime().toLocaleString('en-US', timeFmt);
+      const resolvedTime = resolved.toLocaleString('en-US', timeFmt);
+
+      // In an overlap both candidates keep the requested wall-clock time but differ in offset.
+      if (Temporal.PlainTime.compare(earlier.toPlainTime(), later.toPlainTime()) === 0) {
+        return `${requested} happens twice in ${timeZone} on this date because clocks fall back ` +
+          `(once at UTC${earlier.offset}, again at UTC${later.offset}). ` +
+          `We've scheduled the first occurrence (UTC${resolved.offset}).`;
+      }
+      return `${requested} doesn't exist in ${timeZone} on this date because clocks spring forward ` +
+        `and skip that hour. We've moved the tasting forward to ${resolvedTime} (UTC${resolved.offset}).`;
+    }
+
+    function render() {
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      if (!dateInput.value || !timeInput.value) return;
+
+      const hostTz = hostTzSelect.value;
+      let plain;
+      try {
+        plain = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      } catch {
+        return;
+      }
+
+      // Immutable host event; 'compatible' moves skipped times forward and picks the earlier repeated time.
+      const hostEvent = plain.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+      const conflict = describeConflict(plain, hostTz, hostEvent);
+      if (conflict) {
+        hostWarning.textContent = `Daylight saving time conflict: ${conflict}`;
+        hostWarning.hidden = false;
+      }
+
+      for (const zone of ZONES) {
+        // withTimeZone returns a new object; hostEvent is never mutated.
+        const local = hostEvent.withTimeZone(zone.id);
+        const card = document.createElement('div');
+        card.className = 'card tz-card';
+        card.classList.toggle('is-host', zone.id === hostTz);
+
+        const heading = document.createElement('h3');
+        heading.textContent = zone.id === hostTz ? `${zone.label} (host)` : zone.label;
+
+        const time = document.createElement('p');
+        time.className = 'tz-time';
+        time.textContent = local.toLocaleString('en-US', timeFmt);
+
+        const meta = document.createElement('p');
+        meta.className = 'tz-meta';
+        meta.textContent = `${local.toLocaleString('en-US', dateFmt)} · UTC${local.offset}`;
+
+        card.append(heading, time, meta);
+        grid.append(card);
+      }
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    }
+    document.getElementById('tastingForm').addEventListener('submit', (e) => e.preventDefault());
+    render();
+  </script>
+
