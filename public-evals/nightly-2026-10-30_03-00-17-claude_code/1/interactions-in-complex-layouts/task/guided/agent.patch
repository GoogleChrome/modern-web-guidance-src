+  <script>
+    (() => {
+      const board = document.querySelector('.board');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const statusEl = document.getElementById('board-status');
+      const form = document.querySelector('.order-form');
+      let nextId = 104;
+
+      let dragged = null;
+      let origin = null; // { list, next } to restore on cancelled drags
+      let dropped = false;
+      let overColumn = null;
+      let pending = null;
+      let rafId = 0;
+
+      const listOf = (column) => column.querySelector('.column-list');
+      const titleOf = (column) => column.querySelector('h3').textContent;
+
+      // Counts are batched per frame; each update is confined to its own column.
+      const dirtyColumns = new Set();
+      let countRaf = 0;
+      function updateCounts(...cols) {
+        cols.forEach((c) => c && dirtyColumns.add(c));
+        if (countRaf) return;
+        countRaf = requestAnimationFrame(() => {
+          countRaf = 0;
+          for (const column of dirtyColumns) {
+            const count = listOf(column).childElementCount;
+            const badge = column.querySelector('.column-count');
+            badge.textContent = count;
+            badge.setAttribute('aria-label', `${count} orders`);
+          }
+          dirtyColumns.clear();
+        });
+      }
+
+      function setOverColumn(column) {
+        if (column === overColumn) return;
+        overColumn?.classList.remove('is-over');
+        column?.classList.add('is-over');
+        overColumn = column;
+      }
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        dragged = card;
+        dropped = false;
+        origin = { list: card.parentElement, next: card.nextElementSibling };
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', card.dataset.id);
+        // Defer so the browser snapshots the drag image before we fade the card.
+        requestAnimationFrame(() => card.classList.add('is-dragging'));
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!dragged) return;
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        e.dataTransfer.dropEffect = 'move';
+        setOverColumn(column);
+        // dragover fires continuously; only do DOM work once per frame.
+        pending = { list: listOf(column), card: e.target.closest('.card'), y: e.clientY };
+        if (!rafId) rafId = requestAnimationFrame(applyMove);
+      });
+
+      function applyMove() {
+        rafId = 0;
+        if (!dragged || !pending) return;
+        const { list, card, y } = pending;
+        let ref;
+        if (card === dragged) return;
+        if (card) {
+          const r = card.getBoundingClientRect();
+          ref = y < r.top + r.height / 2 ? card : card.nextElementSibling;
+        } else {
+          // Hovering a gap or empty space: only append when below the last card.
+          const last = list.lastElementChild;
+          if (last && last !== dragged && y < last.getBoundingClientRect().bottom) return;
+          ref = null;
+        }
+        if (ref === dragged || (dragged.parentElement === list && dragged.nextElementSibling === ref)) return;
+        list.insertBefore(dragged, ref);
+      }
+
+      board.addEventListener('dragleave', (e) => {
+        if (overColumn && !board.contains(e.relatedTarget)) setOverColumn(null);
+      });
+
+      board.addEventListener('drop', (e) => {
+        if (!dragged) return;
+        e.preventDefault();
+        dropped = true;
+      });
+
+      board.addEventListener('dragend', () => {
+        if (!dragged) return;
+        cancelAnimationFrame(rafId);
+        rafId = 0;
+        pending = null;
+        const card = dragged;
+        if (!dropped) origin.list.insertBefore(card, origin.next);
+        card.classList.remove('is-dragging');
+        setOverColumn(null);
+        const from = origin.list.closest('.board-column');
+        const to = card.closest('.board-column');
+        updateCounts(from, to);
+        if (dropped && from !== to) announce(card, to);
+        dragged = origin = null;
+      });
+
+      // Keyboard: Left/Right move between columns, Up/Down reorder within a column.
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || dragged) return;
+        const column = card.closest('.board-column');
+        const list = card.parentElement;
+        const idx = columns.indexOf(column);
+        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
+          const target = columns[idx + (e.key === 'ArrowLeft' ? -1 : 1)];
+          if (!target) return;
+          listOf(target).append(card);
+          updateCounts(column, target);
+          announce(card, target);
+        } else if (e.key === 'ArrowUp' && card.previousElementSibling) {
+          list.insertBefore(card, card.previousElementSibling);
+        } else if (e.key === 'ArrowDown' && card.nextElementSibling) {
+          list.insertBefore(card.nextElementSibling, card);
+        } else {
+          return;
+        }
+        e.preventDefault();
+        card.focus();
+        card.scrollIntoView({ block: 'nearest' });
+      });
+
+      function announce(card, column) {
+        statusEl.textContent = `${card.querySelector('h4').textContent} moved to ${titleOf(column)}.`;
+      }
+
+      function createCard(name) {
+        const id = nextId++;
+        const li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.tabIndex = 0;
+        li.dataset.id = id;
+        li.setAttribute('aria-describedby', 'board-help');
+        const h4 = document.createElement('h4');
+        h4.textContent = name;
+        const meta = document.createElement('p');
+        meta.className = 'card-meta';
+        meta.textContent = `#${id} · ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
+        li.append(h4, meta);
+        return li;
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const name = form.elements.drink.value.trim();
+        if (!name) return;
+        const queued = columns[0];
+        listOf(queued).append(createCard(name));
+        updateCounts(queued);
+        form.reset();
+      });
+    })();
+  </script>
+
