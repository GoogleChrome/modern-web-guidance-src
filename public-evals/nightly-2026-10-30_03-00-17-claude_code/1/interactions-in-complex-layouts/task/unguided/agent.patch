+  <script>
+    (() => {
+      const board = document.getElementById('board');
+      const bodies = Array.from(board.querySelectorAll('.column-body'));
+      const dragLayer = document.getElementById('drag-layer');
+      const statusEl = document.getElementById('board-status');
+      const template = document.getElementById('order-card-template');
+      const form = document.getElementById('order-form');
+
+      const DRAG_THRESHOLD = 4;
+      const EDGE = 48;
+      const MAX_SCROLL_SPEED = 16;
+
+      // Per-column cached scroll offsets so the drag loop never reads layout.
+      const scrollTops = new WeakMap();
+      let metrics = null;
+      let pending = null;
+      let drag = null;
+      let nextId = 104;
+
+      const columnName = body => body.parentElement.querySelector('h3').textContent;
+      const updateCount = body => {
+        body.parentElement.querySelector('.column-count').textContent = body.childElementCount;
+      };
+      const announce = msg => { statusEl.textContent = msg; };
+      const cardTitle = card => card.querySelector('.card-title').textContent;
+
+      function readMetrics() {
+        const cs = getComputedStyle(board);
+        const cardH = parseFloat(cs.getPropertyValue('--card-h'));
+        const gap = parseFloat(cs.getPropertyValue('--card-gap'));
+        metrics = { cardH, gap, slot: cardH + gap, pad: parseFloat(cs.getPropertyValue('--column-pad')) };
+      }
+
+      board.addEventListener('scroll', e => {
+        if (e.target.classList && e.target.classList.contains('column-body')) {
+          scrollTops.set(e.target, e.target.scrollTop);
+        }
+      }, { capture: true, passive: true });
+
+      board.addEventListener('dragstart', e => e.preventDefault());
+
+      board.addEventListener('pointerdown', e => {
+        if (drag || e.button !== 0) return;
+        const card = e.target.closest('.order-card');
+        if (!card) return;
+        // Touch/pen drags start from the handle so the column can still be scrolled.
+        if (e.pointerType !== 'mouse' && !e.target.closest('.drag-handle')) return;
+        pending = { card, pointerId: e.pointerId, x: e.clientX, y: e.clientY };
+      });
+
+      window.addEventListener('pointermove', e => {
+        if (drag) {
+          if (e.pointerId !== drag.pointerId) return;
+          drag.x = e.clientX;
+          drag.y = e.clientY;
+          schedule();
+          return;
+        }
+        if (!pending || e.pointerId !== pending.pointerId) return;
+        if (Math.abs(e.clientX - pending.x) + Math.abs(e.clientY - pending.y) < DRAG_THRESHOLD) return;
+        startDrag(pending, e);
+        pending = null;
+      }, { passive: true });
+
+      window.addEventListener('pointerup', e => {
+        if (drag && e.pointerId === drag.pointerId) endDrag(false);
+        pending = null;
+      });
+
+      window.addEventListener('pointercancel', e => {
+        if (drag && e.pointerId === drag.pointerId) endDrag(true);
+        pending = null;
+      });
+
+      window.addEventListener('scroll', () => {
+        if (drag) { drag.rectsDirty = true; schedule(); }
+      }, { passive: true });
+
+      window.addEventListener('resize', () => {
+        metrics = null;
+        if (drag) { drag.rectsDirty = true; schedule(); }
+      });
+
+      function startDrag(p, e) {
+        if (!metrics) readMetrics();
+        const { card } = p;
+        const body = card.parentElement;
+
+        // All layout reads happen once, up front.
+        const rect = card.getBoundingClientRect();
+        const rects = bodies.map(b => b.getBoundingClientRect());
+
+        const ghost = card.cloneNode(true);
+        ghost.classList.add('drag-ghost');
+        ghost.removeAttribute('tabindex');
+        ghost.removeAttribute('role');
+        ghost.style.width = rect.width + 'px';
+        ghost.style.setProperty('--col-accent', getComputedStyle(body.parentElement).getPropertyValue('--col-accent'));
+
+        drag = {
+          card,
+          ghost,
+          pointerId: p.pointerId,
+          offX: p.x - rect.left,
+          offY: p.y - rect.top,
+          x: e.clientX,
+          y: e.clientY,
+          body,
+          index: Array.prototype.indexOf.call(body.children, card),
+          originBody: body,
+          originNext: card.nextElementSibling,
+          rects,
+          rectsDirty: false,
+          frame: 0,
+        };
+
+        dragLayer.appendChild(ghost);
+        card.classList.add('is-dragging');
+        document.body.classList.add('is-board-dragging');
+        try { board.setPointerCapture(p.pointerId); } catch (_) { /* pointer already released */ }
+        schedule();
+      }
+
+      function schedule() {
+        if (drag && !drag.frame) drag.frame = requestAnimationFrame(frame);
+      }
+
+      function frame() {
+        const d = drag;
+        if (!d) return;
+        d.frame = 0;
+        if (d.rectsDirty) {
+          d.rects = bodies.map(b => b.getBoundingClientRect());
+          d.rectsDirty = false;
+        }
+
+        // Compositor-only movement of the floating card.
+        d.ghost.style.transform = `translate3d(${d.x - d.offX}px, ${d.y - d.offY}px, 0) rotate(2deg)`;
+
+        const i = d.rects.findIndex(r => d.x >= r.left && d.x <= r.right && d.y >= r.top && d.y <= r.bottom);
+        if (i === -1) return;
+        const target = bodies[i];
+        const r = d.rects[i];
+        const { cardH, slot, pad } = metrics;
+        let st = scrollTops.get(target) || 0;
+
+        // Auto-scroll the hovered column when near its edges.
+        let dy = 0;
+        if (d.y < r.top + EDGE) dy = -Math.ceil(MAX_SCROLL_SPEED * (1 - (d.y - r.top) / EDGE));
+        else if (d.y > r.bottom - EDGE) dy = Math.ceil(MAX_SCROLL_SPEED * (1 - (r.bottom - d.y) / EDGE));
+        if (dy) {
+          const count = target.childElementCount + (target === d.body ? 0 : 1);
+          const max = Math.max(0, pad * 2 + count * slot - metrics.gap - r.height);
+          const next = Math.min(max, Math.max(0, st + dy));
+          if (next !== st) {
+            target.scrollTop = next;
+            scrollTops.set(target, next);
+            st = next;
+            schedule();
+          }
+        }
+
+        // Drop slot from the ghost's vertical center: pure arithmetic on fixed card heights.
+        const sameColumn = target === d.body;
+        const n = target.childElementCount - (sameColumn ? 1 : 0);
+        const centerY = d.y - d.offY + cardH / 2 - r.top + st - pad;
+        const index = Math.min(n, Math.max(0, Math.floor(centerY / slot)));
+        if (sameColumn && index === d.index) return;
+
+        const ref = sameColumn && index >= d.index ? target.children[index + 1] : target.children[index];
+        target.insertBefore(d.card, ref || null);
+        d.body = target;
+        d.index = index;
+      }
+
+      function endDrag(cancelled) {
+        const d = drag;
+        drag = null;
+        if (d.frame) cancelAnimationFrame(d.frame);
+
+        if (cancelled) {
+          const next = d.originNext && d.originNext.parentElement === d.originBody ? d.originNext : null;
+          d.originBody.insertBefore(d.card, next);
+          d.body = d.originBody;
+        }
+
+        d.ghost.remove();
+        d.card.classList.remove('is-dragging');
+        document.body.classList.remove('is-board-dragging');
+        try { board.releasePointerCapture(d.pointerId); } catch (_) { /* already released */ }
+
+        if (d.body !== d.originBody) {
+          updateCount(d.originBody);
+          updateCount(d.body);
+          d.card.dataset.status = d.body.parentElement.dataset.status;
+          announce(`${cardTitle(d.card)} moved to ${columnName(d.body)}.`);
+        }
+      }
+
+      board.addEventListener('keydown', e => {
+        if (drag && e.key === 'Escape') {
+          endDrag(true);
+          return;
+        }
+        const card = e.target.closest('.order-card');
+        if (!card || drag) return;
+        const body = card.parentElement;
+        const col = bodies.indexOf(body);
+
+        if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && !e.altKey) {
+          const target = bodies[col + (e.key === 'ArrowLeft' ? -1 : 1)];
+          if (!target) return;
+          e.preventDefault();
+          target.appendChild(card);
+          updateCount(body);
+          updateCount(target);
+          card.dataset.status = target.parentElement.dataset.status;
+          card.focus();
+          announce(`${cardTitle(card)} moved to ${columnName(target)}.`);
+        } else if (e.altKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
+          const sibling = e.key === 'ArrowUp' ? card.previousElementSibling : card.nextElementSibling;
+          if (!sibling) return;
+          e.preventDefault();
+          body.insertBefore(card, e.key === 'ArrowUp' ? sibling : sibling.nextElementSibling);
+          card.focus();
+          announce(`${cardTitle(card)} moved ${e.key === 'ArrowUp' ? 'up' : 'down'}.`);
+        }
+      });
+
+      form.addEventListener('submit', e => {
+        e.preventDefault();
+        const drink = form.elements.drink.value.trim();
+        const customer = form.elements.customer.value.trim();
+        if (!drink || !customer) return;
+
+        const id = nextId++;
+        const card = template.content.firstElementChild.cloneNode(true);
+        const time = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+        card.dataset.id = id;
+        card.querySelector('.card-title').textContent = drink;
+        card.querySelector('.card-meta').textContent = `#${id} · ${customer} · ${time}`;
+
+        const queued = bodies[0];
+        queued.appendChild(card);
+        updateCount(queued);
+        announce(`${drink} for ${customer} added to Queued.`);
+        form.reset();
+        form.elements.drink.focus();
+      });
+    })();
+  </script>
