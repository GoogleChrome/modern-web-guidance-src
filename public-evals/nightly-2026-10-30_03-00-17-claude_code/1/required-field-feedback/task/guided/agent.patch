+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state so screen
+    // readers also only hear about the error after the user leaves the field.
+    const newsletterEmail = document.getElementById('newsletter-email');
+
+    const syncNewsletterAria = (event) => {
+      // On a submit attempt the 'invalid' event can fire before :user-invalid matches.
+      if (event.type === 'invalid' || newsletterEmail.matches(':user-invalid')) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+        newsletterEmail.setAttribute('aria-errormessage',
+          newsletterEmail.validity.valueMissing ? 'newsletter-email-required' : 'newsletter-email-format');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    newsletterEmail.addEventListener('blur', syncNewsletterAria);
+    newsletterEmail.addEventListener('invalid', syncNewsletterAria);
+    newsletterEmail.addEventListener('input', (event) => {
+      if (newsletterEmail.hasAttribute('aria-invalid')) syncNewsletterAria(event);
+    });
+  </script>
+
 </body>
 
