 <body>
@@ -197,8 +262,18 @@
     </section>
   </main>
 
   <footer>
+    <form class="newsletter" id="newsletter-form" action="/subscribe" method="post" novalidate>
+      <h3>Join Our Mailing List</h3>
+      <div class="newsletter-row">
+        <label for="newsletter-email" class="sr-only">Email address</label>
+        <input type="email" id="newsletter-email" name="email" placeholder="you@example.com"
+          autocomplete="email" required aria-describedby="newsletter-error">
