+    /* Order Form */
+    .order-section {
+      margin-top: 60px;
+    }
+
+    .order-form {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      max-width: 640px;
+      margin: 20px auto 0;
+      display: flex;
+      flex-direction: column;
+      /* Keep flex from stretching auto-sized fields to full width */
+      align-items: start;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      align-items: start;
+      gap: 4px;
+      margin-bottom: 1.5rem;
+      inline-size: 100%;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .hint {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .order-form input,
+    .order-form textarea,
+    .order-form select {
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      padding: 0.6rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #8d6e63;
+      border-radius: 5px;
+      background: var(--light);
+      /* Grow and shrink to fit the content */
+      field-sizing: content;
+    }
+
+    .order-form input {
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 100%;
+    }
+
+    .order-form textarea {
+      height: auto;
+      /* Stable width; height follows the content */
+      width: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+      resize: vertical;
+    }
+
+    .order-form select {
+      max-inline-size: 100%;
+    }
+
+    .order-form input:focus-visible,
+    .order-form textarea:focus-visible,
+    .order-form select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .order-form .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
     footer {
