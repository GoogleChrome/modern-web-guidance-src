+  <script>
+    // Fallback for browsers without `field-sizing: content` support
+    if (!CSS.supports('field-sizing', 'content')) {
+      const ruler = document.createElement('span');
+      ruler.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
+      document.body.appendChild(ruler);
+
+      const textWidth = (el, text) => {
+        const cs = getComputedStyle(el);
+        ruler.style.font = cs.font;
+        ruler.style.letterSpacing = cs.letterSpacing;
+        ruler.textContent = text || ' ';
+        return ruler.getBoundingClientRect().width;
+      };
+
+      const chrome = (el) => {
+        const cs = getComputedStyle(el);
+        return ['paddingLeft', 'paddingRight', 'borderLeftWidth', 'borderRightWidth']
+          .reduce((sum, p) => sum + parseFloat(cs[p]), 0);
+      };
+
+      const resize = (el) => {
+        if (el.tagName === 'SELECT') {
+          const option = el.options[el.selectedIndex];
+          // Extra room for the dropdown arrow
+          el.style.width = `${textWidth(el, option ? option.text : '') + chrome(el) + 28}px`;
+        } else if (el.tagName === 'TEXTAREA') {
+          const lines = (el.value || el.placeholder).split('\n');
+          const widest = Math.max(...lines.map((line) => textWidth(el, line)));
+          el.style.width = `${Math.ceil(widest + chrome(el)) + 2}px`;
+          el.style.height = 'auto';
+          el.style.height = `${el.scrollHeight + el.offsetHeight - el.clientHeight}px`;
+        } else {
+          el.style.width = `${Math.ceil(textWidth(el, el.value || el.placeholder) + chrome(el)) + 2}px`;
+        }
+      };
+
+      document.querySelectorAll('.autosize').forEach((el) => {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => resize(el));
+        resize(el);
+      });
+      window.addEventListener('resize', () => document.querySelectorAll('.autosize').forEach(resize));
+    }
+  </script>
+
