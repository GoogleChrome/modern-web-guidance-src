@@ -0,0 +1,305 @@
+/**
+ * <coffee-card> — an autonomous custom element for menu items.
+ *
+ * Attributes (all reflected to/from same-named camelCase properties):
+ *   name        string   Drink name (heading)
+ *   description string   Short blurb
+ *   href        string   Link for the "View Details" button
+ *   image       string   Photo URL
+ *   price       number   Price in USD; omitted/invalid hides the price
+ *   rating      number   0–5, clamped; omitted hides the rating
+ *   featured    boolean  Shows a "Featured" badge and accent border
+ *   sold-out    boolean  Dims the card and disables the button
+ *
+ * Events:
+ *   coffee-card:select  Fired (cancelable, bubbles, composed) when the
+ *                       button is activated. detail: { name, href, price }
+ */
+
+const STRING_ATTRS = ['name', 'description', 'href', 'image'];
+const NUMBER_ATTRS = ['price', 'rating'];
+const BOOLEAN_ATTRS = ['featured', 'sold-out'];
+
+const toProp = (attr) => attr.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
+
+const priceFormat = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      overflow: hidden;
+      position: relative;
+      border: 2px solid transparent;
+      transition: transform 0.2s, box-shadow 0.2s;
+    }
+    :host(:hover) {
+      transform: translateY(-2px);
+      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
+    }
+    :host([hidden]) { display: none; }
+    :host([featured]) { border-color: var(--accent, #ffab40); }
+    :host([sold-out]) { opacity: 0.6; }
+
+    .media {
+      aspect-ratio: 3 / 2;
+      background: var(--secondary, #d7ccc8);
+    }
+    .media img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+    .media[hidden] { display: none; }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      left: 12px;
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.75rem;
+      font-weight: bold;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      padding: 2px 10px;
+      border-radius: 999px;
+    }
+    .badge[hidden] { display: none; }
+    :host([sold-out]) .badge { background: var(--text, #3e2723); color: white; }
+
+    .body { padding: 20px; }
+
+    h3 {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+    }
+    p { margin: 0; }
+
+    .meta {
+      display: flex;
+      justify-content: center;
+      gap: 12px;
+      margin-top: 10px;
+      font-size: 0.9rem;
+    }
+    .meta [hidden] { display: none; }
+    .price { font-weight: bold; color: var(--primary, #4e342e); }
+    .rating { color: var(--accent, #ffab40); letter-spacing: 1px; }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    .btn:hover { background: var(--text, #3e2723); }
+    .btn[aria-disabled="true"] {
+      background: #9e9e9e;
+      cursor: not-allowed;
+      pointer-events: none;
+    }
+  </style>
+  <div class="media" part="media"><img alt="" loading="lazy" decoding="async"></div>
+  <span class="badge" part="badge" hidden></span>
+  <div class="body" part="body">
+    <h3 part="name"></h3>
+    <p part="description"></p>
+    <div class="meta">
+      <span class="price" part="price"></span>
+      <span class="rating" part="rating" role="img"></span>
+    </div>
+    <a class="btn" part="button">View Details</a>
+  </div>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [...STRING_ATTRS, ...NUMBER_ATTRS, ...BOOLEAN_ATTRS];
+  }
+
+  #els;
+  #abort = null;
+  #renderQueued = false;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this.#els = {
+      media: root.querySelector('.media'),
+      img: root.querySelector('img'),
+      badge: root.querySelector('.badge'),
+      name: root.querySelector('h3'),
+      description: root.querySelector('p'),
+      price: root.querySelector('.price'),
+      rating: root.querySelector('.rating'),
+      button: root.querySelector('.btn'),
+    };
+  }
+
+  connectedCallback() {
+    // Properties set on the instance before the element was upgraded would
+    // shadow our accessors; re-route them through the setters.
+    for (const attr of CoffeeCard.observedAttributes) this.#upgradeProperty(toProp(attr));
+
+    if (!this.hasAttribute('role')) this.setAttribute('role', 'article');
+
+    this.#abort = new AbortController();
+    this.#els.button.addEventListener('click', this.#onSelect, { signal: this.#abort.signal });
+
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#abort?.abort();
+    this.#abort = null;
+  }
+
+  adoptedCallback() {
+    // Moved to another document (e.g. an iframe); re-render with fresh state.
+    this.#render();
+  }
+
+  attributeChangedCallback(_name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this.#scheduleRender();
+  }
+
+  // --- Reflected properties ----------------------------------------------
+
+  get name() { return this.#getString('name'); }
+  set name(v) { this.#setString('name', v); }
+
+  get description() { return this.#getString('description'); }
+  set description(v) { this.#setString('description', v); }
+
+  get href() { return this.#getString('href'); }
+  set href(v) { this.#setString('href', v); }
+
+  get image() { return this.#getString('image'); }
+  set image(v) { this.#setString('image', v); }
+
+  get price() { return this.#getNumber('price'); }
+  set price(v) { this.#setNumber('price', v); }
+
+  get rating() {
+    const n = this.#getNumber('rating');
+    return n === null ? null : Math.min(5, Math.max(0, n));
+  }
+  set rating(v) { this.#setNumber('rating', v); }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(v) { this.toggleAttribute('featured', Boolean(v)); }
+
+  get soldOut() { return this.hasAttribute('sold-out'); }
+  set soldOut(v) { this.toggleAttribute('sold-out', Boolean(v)); }
+
+  // --- Reflection helpers ------------------------------------------------
+
+  #getString(attr) {
+    return this.getAttribute(attr) ?? '';
+  }
+
+  #setString(attr, value) {
+    if (value === null || value === undefined) this.removeAttribute(attr);
+    else this.setAttribute(attr, String(value));
+  }
+
+  #getNumber(attr) {
+    const raw = this.getAttribute(attr);
+    if (raw === null || raw.trim() === '') return null;
+    const n = Number(raw);
+    return Number.isFinite(n) ? n : null;
+  }
+
+  #setNumber(attr, value) {
+    const n = value === null || value === undefined || value === '' ? NaN : Number(value);
+    if (Number.isFinite(n)) this.setAttribute(attr, String(n));
+    else this.removeAttribute(attr);
+  }
+
+  #upgradeProperty(prop) {
+    if (Object.prototype.hasOwnProperty.call(this, prop)) {
+      const value = this[prop];
+      delete this[prop];
+      this[prop] = value;
+    }
+  }
+
+  // --- Rendering ---------------------------------------------------------
+
+  // Batch multiple attribute changes in the same task into a single render.
+  #scheduleRender() {
+    if (this.#renderQueued) return;
+    this.#renderQueued = true;
+    queueMicrotask(() => {
+      this.#renderQueued = false;
+      if (this.isConnected) this.#render();
+    });
+  }
+
+  #render() {
+    const els = this.#els;
+    const { name, description, href, image, price, rating, featured, soldOut } = this;
+
+    els.name.textContent = name;
+    els.description.textContent = description;
+
+    if (image) {
+      if (els.img.getAttribute('src') !== image) els.img.src = image;
+      els.img.alt = name;
+      els.media.hidden = false;
+    } else {
+      els.img.removeAttribute('src');
+      els.media.hidden = true;
+    }
+
+    els.price.hidden = price === null;
+    els.price.textContent = price === null ? '' : priceFormat.format(price);
+
+    els.rating.hidden = rating === null;
+    if (rating !== null) {
+      const stars = Math.round(rating);
+      els.rating.textContent = '★'.repeat(stars) + '☆'.repeat(5 - stars);
+      els.rating.setAttribute('aria-label', `Rated ${rating} out of 5`);
+    }
+
+    els.badge.hidden = !(featured || soldOut);
+    els.badge.textContent = soldOut ? 'Sold Out' : 'Featured';
+
+    if (href && !soldOut) els.button.setAttribute('href', href);
+    else els.button.removeAttribute('href');
+    els.button.setAttribute('aria-disabled', String(soldOut || !href));
+    els.button.textContent = soldOut ? 'Unavailable' : 'View Details';
+    if (name) els.button.setAttribute('aria-label', `${els.button.textContent}: ${name}`);
+  }
+
+  #onSelect = (event) => {
+    if (this.soldOut) {
+      event.preventDefault();
+      return;
+    }
+    const proceed = this.dispatchEvent(new CustomEvent('coffee-card:select', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: { name: this.name, href: this.href, price: this.price },
+    }));
+    if (!proceed) event.preventDefault();
+  };
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
