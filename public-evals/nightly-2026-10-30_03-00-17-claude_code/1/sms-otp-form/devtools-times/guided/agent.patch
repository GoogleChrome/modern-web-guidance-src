--- /dev/null
+++ b/src/pages/api/phone-verification/verify.ts
@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { checkVerification } from '../../../utils/phoneVerification';
+
+const json = (body: unknown, status = 200) =>
+    new Response(JSON.stringify(body), {
+        status,
+        headers: { 'Content-Type': 'application/json' },
+    });
+
+const messages = {
+    invalid: 'That code is incorrect. Check the SMS and try again.',
+    expired: 'That code has expired. Request a new one.',
+    too_many_attempts: 'Too many incorrect attempts. Request a new code.',
+} as const;
+
+export const POST: APIRoute = async ({ request }) => {
+    let verificationId: unknown, code: unknown;
+    try {
+        ({ verificationId, code } = await request.json());
+    } catch {
+        return json({ error: 'Invalid request body.' }, 400);
+    }
+
+    if (typeof verificationId !== 'string' || typeof code !== 'string' || !/^\d{6}$/.test(code)) {
+        return json({ error: 'Enter the 6-digit code sent to your phone.' }, 400);
+    }
+
+    const result = checkVerification(verificationId, code);
+    if (result !== 'ok') {
+        return json({ error: messages[result], reason: result }, result === 'invalid' ? 400 : 410);
+    }
+    return json({ verified: true });
+};
diff --git a/src/utils/phoneVerification.ts b/src/utils/phoneVerification.ts
new file mode 100644
index 0000000..7ab43c7
--- /dev/null
+++ b/src/utils/phoneVerification.ts
@@ -0,0 +1,72 @@
+import { createHash, randomInt, randomUUID, timingSafeEqual } from 'node:crypto';
+
+const CODE_LENGTH = 6;
+const CODE_TTL_MS = 5 * 60 * 1000;
+const MAX_ATTEMPTS = 5;
+
+interface PendingVerification {
+  phone: string;
+  codeHash: Buffer;
+  expiresAt: number;
+  attempts: number;
+}
+
+// In-memory store; swap for a shared store (e.g. Redis) when running multiple instances.
+const pending = new Map<string, PendingVerification>();
+
+const hashCode = (code: string) => createHash('sha256').update(code).digest();
+
+function pruneExpired() {
+  const now = Date.now();
+  for (const [id, entry] of pending) {
+    if (entry.expiresAt <= now) pending.delete(id);
+  }
+}
+
+// E.164: leading "+", country code, up to 15 digits total.
+export function normalizePhone(input: string): string | null {
+  const stripped = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{6,14}$/.test(stripped) ? stripped : null;
+}
+
+export function createVerification(phone: string) {
+  pruneExpired();
+  const id = randomUUID();
+  const code = randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+  pending.set(id, {
+    phone,
+    codeHash: hashCode(code),
+    expiresAt: Date.now() + CODE_TTL_MS,
+    attempts: 0,
+  });
+  return { id, code };
+}
+
+export type VerifyResult = 'ok' | 'invalid' | 'expired' | 'too_many_attempts';
+
+export function checkVerification(id: string, code: string): VerifyResult {
+  const entry = pending.get(id);
+  if (!entry || entry.expiresAt <= Date.now()) {
+    pending.delete(id);
+    return 'expired';
+  }
+  if (entry.attempts >= MAX_ATTEMPTS) {
+    pending.delete(id);
+    return 'too_many_attempts';
+  }
+  entry.attempts++;
+  if (!timingSafeEqual(hashCode(code), entry.codeHash)) return 'invalid';
+  pending.delete(id);
+  return 'ok';
+}
+
+// The last line must be "@<host> #<code>" so WebOTP and Safari's
+// autocomplete="one-time-code" can bind the code to this origin.
+export function buildOtpMessage(code: string, host: string) {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+export async function sendSms(to: string, body: string) {
+  // TODO: Replace with a real SMS provider (Twilio, Vonage, etc.).
+  console.info(`[sms] to=${to}\n${body}`);
+}
