diff --git a/src/pages/api/phone-verification/send.ts b/src/pages/api/phone-verification/send.ts
new file mode 100644
index 0000000..8952d9b
--- /dev/null
+++ b/src/pages/api/phone-verification/send.ts
@@ -0,0 +1,28 @@
+import type { APIRoute } from 'astro';
+import { buildOtpMessage, createVerification, normalizePhone, sendSms } from '../../../utils/phoneVerification';
+
+const json = (body: unknown, status = 200) =>
+    new Response(JSON.stringify(body), {
+        status,
+        headers: { 'Content-Type': 'application/json' },
+    });
+
+export const POST: APIRoute = async ({ request, url }) => {
+    let phoneInput: unknown;
+    try {
+        ({ phone: phoneInput } = await request.json());
+    } catch {
+        return json({ error: 'Invalid request body.' }, 400);
+    }
+
+    const phone = typeof phoneInput === 'string' ? normalizePhone(phoneInput) : null;
+    if (!phone) {
+        return json({ error: 'Enter a phone number including the country code, e.g. +1 555 123 4567.' }, 400);
+    }
+
+    const { id, code } = createVerification(phone);
+    // Host only (no scheme/port), as required by the origin-bound SMS format.
+    await sendSms(phone, buildOtpMessage(code, url.hostname));
+
+    return json({ verificationId: id });
+};
