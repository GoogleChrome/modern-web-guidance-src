@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import {
+  RESEND_COOLDOWN_MS,
+  buildSmsBody,
+  createPendingVerification,
+  generateCode,
+  json,
+  normalizePhone,
+  recordSendAttempt,
+  sendSms,
+  type PendingVerification,
+} from '../../../lib/phone-verification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  let body: { phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json(
+      { error: 'Enter a valid phone number including the country code, for example +1 415 555 0100.', field: 'phone' },
+      400,
+    );
+  }
+
+  const now = Date.now();
+  const existing = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  if (existing && existing.phone === phone && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return json({ error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter }, 429, {
+      'Retry-After': String(retryAfter),
+    });
+  }
+
+  if (!recordSendAttempt(phone, now)) {
+    return json({ error: 'Too many codes were requested for this number. Please try again later.' }, 429);
+  }
+
+  const code = generateCode();
+  try {
+    await sendSms(phone, buildSmsBody(code, url.hostname));
+  } catch (err) {
+    console.error('Failed to send verification SMS', err);
+    return json({ error: 'We could not send a text message to this number. Please try again later.' }, 502);
+  }
+
+  await session.set('phoneVerification', createPendingVerification(phone, code, now));
+  await session.delete('verifiedPhone');
+
+  return json({ phone, resendAfter: Math.ceil(RESEND_COOLDOWN_MS / 1000) });
+};
