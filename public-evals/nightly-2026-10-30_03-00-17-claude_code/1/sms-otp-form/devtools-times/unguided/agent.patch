@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_LENGTH,
+  MAX_VERIFY_ATTEMPTS,
+  codeMatches,
+  json,
+  type PendingVerification,
+  type VerifiedPhone,
+} from '../../../lib/phone-verification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.' }, 500);
+  }
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== CODE_LENGTH) {
+    return json({ error: `Enter the ${CODE_LENGTH}-digit code we sent you.`, field: 'code' }, 400);
+  }
+
+  const pending = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  if (!pending || Date.now() > pending.expiresAt) {
+    await session.delete('phoneVerification');
+    return json({ error: 'This code has expired. Request a new code.', expired: true }, 410);
+  }
+
+  if (!codeMatches(pending, code)) {
+    pending.attempts += 1;
+    const remaining = MAX_VERIFY_ATTEMPTS - pending.attempts;
+    if (remaining <= 0) {
+      await session.delete('phoneVerification');
+      return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 429);
+    }
+    await session.set('phoneVerification', pending);
+    return json(
+      {
+        error: `That code is incorrect. ${remaining} ${remaining === 1 ? 'attempt' : 'attempts'} remaining.`,
+        field: 'code',
+        remaining,
+      },
+      400,
+    );
+  }
+
+  await session.delete('phoneVerification');
+  const verified: VerifiedPhone = { phone: pending.phone, verifiedAt: Date.now() };
+  await session.set('verifiedPhone', verified);
+
+  return json({ phone: pending.phone, verified: true });
+};
