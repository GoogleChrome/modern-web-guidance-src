+++ b/src/lib/phone-verification.ts
@@ -0,0 +1,119 @@
+import { createHmac, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LENGTH = 6;
+export const CODE_TTL_MS = 5 * 60 * 1000;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+export const MAX_VERIFY_ATTEMPTS = 5;
+export const MAX_SENDS_PER_HOUR = 5;
+
+export interface PendingVerification {
+  phone: string;
+  codeHash: string;
+  salt: string;
+  expiresAt: number;
+  attempts: number;
+  sentAt: number;
+}
+
+export interface VerifiedPhone {
+  phone: string;
+  verifiedAt: number;
+}
+
+// Per-number send log, so clearing the session cookie can't be used to spam a number.
+const sendLog = new Map<string, number[]>();
+
+export function recordSendAttempt(phone: string, now = Date.now()): boolean {
+  const recent = (sendLog.get(phone) ?? []).filter((t) => now - t < 60 * 60 * 1000);
+  if (recent.length >= MAX_SENDS_PER_HOUR) {
+    sendLog.set(phone, recent);
+    return false;
+  }
+  recent.push(now);
+  sendLog.set(phone, recent);
+  return true;
+}
+
+/**
+ * Normalizes user input to E.164 (e.g. "+1 (415) 555-0100" -> "+14155550100").
+ * Requires an explicit country code. Returns null if the number is not plausible.
+ */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  const digits = trimmed.replace(/[\s().-]/g, '');
+  const withPlus = digits.startsWith('00') ? `+${digits.slice(2)}` : digits;
+  return /^\+[1-9]\d{7,14}$/.test(withPlus) ? withPlus : null;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+}
+
+export function hashCode(code: string, salt: string): string {
+  return createHmac('sha256', salt).update(code).digest('hex');
+}
+
+export function createPendingVerification(phone: string, code: string, now = Date.now()): PendingVerification {
+  const salt = randomBytes(16).toString('hex');
+  return {
+    phone,
+    codeHash: hashCode(code, salt),
+    salt,
+    expiresAt: now + CODE_TTL_MS,
+    attempts: 0,
+    sentAt: now,
+  };
+}
+
+export function codeMatches(pending: PendingVerification, code: string): boolean {
+  const a = Buffer.from(hashCode(code, pending.salt), 'hex');
+  const b = Buffer.from(pending.codeHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Builds the SMS body. The last line follows the WebOTP / origin-bound one-time code
+ * format ("@host #code") so supporting browsers can autofill the code and only for this site.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `${code} is your DevTools Times verification code. It expires in 5 minutes.\n\n@${host} #${code}`;
+}
+
+/**
+ * Sends an SMS via Twilio when TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM_NUMBER
+ * are configured. In development without credentials, the message is logged instead.
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const sid = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const from = process.env.TWILIO_FROM_NUMBER;
+
+  if (!sid || !token || !from) {
+    if (import.meta.env.DEV) {
+      console.info(`[sms:dev] to=${to}\n${body}`);
+      return;
+    }
+    throw new Error('SMS provider is not configured');
+  }
+
+  const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: to, From: from, Body: body }),
+  });
+
+  if (!response.ok) {
+    throw new Error(`SMS provider responded with ${response.status}`);
+  }
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
