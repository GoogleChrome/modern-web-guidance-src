+  <script>
+    /*
+     * SMS OTP verification.
+     * The /send-otp backend must end each SMS with an origin-bound line so WebOTP
+     * and iOS/macOS autofill only offer the code on our domain, e.g.:
+     *
+     *   Your Daily Grind code is 123456.
+     *
+     *   @dailygrind.example #123456
+     */
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const phoneError = document.getElementById('phone-error');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const resendBtn = document.getElementById('resend-otp');
+    const statusEl = document.getElementById('verify-status');
+
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err && err.name === 'AbortError') return;
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    function showError(input, errorEl, message) {
+      errorEl.textContent = message;
+      input.setAttribute('aria-invalid', 'true');
+      input.focus();
+    }
+
+    function clearError(input, errorEl) {
+      errorEl.textContent = '';
+      input.removeAttribute('aria-invalid');
+    }
+
+    async function post(form) {
+      return fetch(form.action, { method: 'POST', body: new FormData(form) });
+    }
+
+    async function sendCode() {
+      const response = await post(phoneForm);
+      if (!response.ok) throw new Error(`Send failed: ${response.status}`);
+    }
+
+    phoneInput.addEventListener('input', () => clearError(phoneInput, phoneError));
+    otpInput.addEventListener('input', () => clearError(otpInput, otpError));
+
+    phoneForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const submitBtn = phoneForm.querySelector('[type="submit"]');
+      submitBtn.disabled = true;
+      statusEl.textContent = 'Sending your code…';
+
+      try {
+        await sendCode();
+      } catch (err) {
+        statusEl.textContent = '';
+        showError(phoneInput, phoneError, "We couldn't text that number. Check it and try again.");
+        return;
+      } finally {
+        submitBtn.disabled = false;
+      }
+
+      const data = new FormData(phoneForm);
+      document.getElementById('otp-phone').value = data.get('phone');
+      document.getElementById('otp-purpose').value = data.get('purpose');
+      document.getElementById('otp-phone-display').textContent = data.get('phone');
+
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      otpInput.value = '';
+      clearError(otpInput, otpError);
+      statusEl.textContent = 'Code sent. Check your text messages.';
+      otpInput.focus();
+      startSmsOtpListener();
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      stopSmsOtpListener();
+      const submitBtn = otpForm.querySelector('[type="submit"]');
+      submitBtn.disabled = true;
+      statusEl.textContent = 'Verifying…';
+
+      try {
+        const response = await post(otpForm);
+        if (!response.ok) throw new Error(`Verify failed: ${response.status}`);
+      } catch (err) {
+        submitBtn.disabled = false;
+        statusEl.textContent = '';
+        showError(otpInput, otpError, "That code didn't work. Check it or request a new one.");
+        return;
+      }
+
+      const purpose = new FormData(otpForm).get('purpose');
+      statusEl.textContent = 'Verified! Redirecting…';
+      window.location.assign(purpose === 'order' ? '/order-online' : '/rewards');
+    });
+
+    resendBtn.addEventListener('click', async () => {
+      resendBtn.disabled = true;
+      statusEl.textContent = 'Sending a new code…';
+      try {
+        await sendCode();
+        otpInput.value = '';
+        clearError(otpInput, otpError);
+        statusEl.textContent = 'New code sent.';
+        otpInput.focus();
+        startSmsOtpListener();
+      } catch (err) {
+        statusEl.textContent = "We couldn't send a new code. Please try again.";
+      } finally {
+        resendBtn.disabled = false;
+      }
+    });
+
+    document.getElementById('change-phone').addEventListener('click', () => {
+      stopSmsOtpListener();
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      statusEl.textContent = '';
+      phoneInput.focus();
+    });
+  </script>
+
 </body>
 
