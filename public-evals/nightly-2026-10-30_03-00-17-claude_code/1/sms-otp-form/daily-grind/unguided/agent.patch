+  <script>
+    (function () {
+      var CODE_LENGTH = 6;
+      var RESEND_COOLDOWN = 30;
+
+      var form = document.getElementById('otp-form');
+      var input = document.getElementById('otp-code');
+      var error = document.getElementById('otp-error');
+      var status = document.getElementById('otp-status');
+      var resend = document.getElementById('otp-resend');
+      var submit = form.querySelector('button[type="submit"]');
+      var otpAbort = null;
+
+      // Optional: show the masked phone if the page was given one, e.g. ?phone=5551234
+      var phone = new URLSearchParams(location.search).get('phone');
+      if (phone && /\d{4}$/.test(phone)) {
+        document.getElementById('phone-last4').textContent = phone.slice(-4);
+      }
+
+      function setError(message) {
+        error.textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+      }
+
+      function announce(message) {
+        // Clear first so repeated identical messages are still announced
+        status.textContent = '';
+        setTimeout(function () { status.textContent = message; }, 50);
+      }
+
+      function fillCode(code) {
+        input.value = code.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        setError('');
+      }
+
+      // Keep only digits so pasted values like "123 456" or "Code: 123456" work
+      input.addEventListener('input', function () {
+        var digits = input.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (digits !== input.value) input.value = digits;
+        if (input.getAttribute('aria-invalid') === 'true' && digits.length === CODE_LENGTH) {
+          setError('');
+        }
+      });
+
+      input.addEventListener('paste', function (event) {
+        var text = (event.clipboardData || window.clipboardData).getData('text');
+        var match = text && text.match(/\d{6}/);
+        if (match) {
+          event.preventDefault();
+          fillCode(match[0]);
+        }
+      });
+
+      // WebOTP API: read the code from an incoming SMS on supported browsers.
+      // The SMS must end with a line like: @dailygrind.com #123456
+      function listenForSms() {
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        if (otpAbort) otpAbort.abort();
+        otpAbort = new AbortController();
+
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: otpAbort.signal
+        }).then(function (otp) {
+          if (!otp || !otp.code) return;
+          fillCode(otp.code);
+          announce('Code filled in from your text message. Review it, then select Verify & Continue.');
+          submit.focus();
+        }).catch(function () {
+          // Aborted, timed out, or denied: manual entry still works
+        });
+      }
+
+      function startCooldown() {
+        var remaining = RESEND_COOLDOWN;
+        resend.disabled = true;
+        resend.textContent = 'Resend code (' + remaining + 's)';
+        var timer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(timer);
+            resend.disabled = false;
+            resend.textContent = 'Resend code';
+          } else {
+            resend.textContent = 'Resend code (' + remaining + 's)';
+          }
+        }, 1000);
+      }
+
+      resend.addEventListener('click', function () {
+        var purpose = form.querySelector('input[name="purpose"]:checked').value;
+        fetch('/resend-otp', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ purpose: purpose })
+        }).catch(function () {});
+        input.value = '';
+        setError('');
+        announce('A new code is on its way. It may take up to a minute to arrive.');
+        startCooldown();
+        listenForSms();
+        input.focus();
+      });
+
+      form.addEventListener('submit', function (event) {
+        var code = input.value.trim();
+        if (!code) {
+          setError('Please enter the 6-digit code from your text message.');
+        } else if (!new RegExp('^\\d{' + CODE_LENGTH + '}$').test(code)) {
+          setError('The code must be exactly 6 digits. You entered ' + code.length + '.');
+        } else {
+          setError('');
+          if (otpAbort) otpAbort.abort();
+          submit.disabled = true;
+          announce('Verifying your code…');
+          return;
+        }
+        event.preventDefault();
+        input.focus();
+      });
+
+      // Re-enable the button if the user comes back via the back/forward cache
+      window.addEventListener('pageshow', function () { submit.disabled = false; });
+
+      startCooldown();
+      listenForSms();
+    })();
+  </script>
+
 </body>
 
