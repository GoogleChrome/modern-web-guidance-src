+  <script type="module">
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    const readFavorites = () => {
+      try {
+        return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+      } catch {
+        return new Set();
+      }
+    };
+
+    const writeFavorites = (favorites) => {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota); keep the in-memory state.
+      }
+    };
+
+    class DrinkCard extends HTMLElement {
+      #internals = this.attachInternals();
+      #button;
+      #favorited = false;
+
+      constructor() {
+        super();
+        // Engines without Declarative Shadow DOM leave the template inert;
+        // attach the same server markup imperatively instead.
+        if (!this.shadowRoot) {
+          const template = this.querySelector(':scope > template[shadowrootmode]');
+          if (template) {
+            this.attachShadow({ mode: 'open' }).append(template.content);
+            template.remove();
+          }
+        }
+        // Hydrate in place: wire up the server-rendered button, don't re-render.
+        this.#button = this.shadowRoot?.querySelector('.fav');
+        this.#button?.addEventListener('click', () => this.toggle());
+      }
+
+      connectedCallback() {
+        this.#sync(readFavorites().has(this.drinkId));
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id') ?? '';
+      }
+
+      get favorited() {
+        return this.#favorited;
+      }
+
+      toggle(force = !this.favorited) {
+        if (force === this.favorited) return;
+        const favorites = readFavorites();
+        force ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+        writeFavorites(favorites);
+        this.#sync(force);
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+
+      #sync(on) {
+        this.#favorited = on;
+        // Expose a read-only `drink-card:state(favorited)` styling hook where supported.
+        const states = this.#internals.states;
+        if (states) on ? states.add('favorited') : states.delete('favorited');
+        this.#button?.setAttribute('aria-pressed', String(on));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
