@@ -0,0 +1,88 @@
+// <drink-card> hydrates a server-rendered declarative shadow root in place.
+// The markup and styles already exist when this runs; we only attach behavior.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) || []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(favorites) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+  } catch {
+    // Storage unavailable (private mode, quota); the toggle still works for this page view.
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #button = null;
+
+  connectedCallback() {
+    if (this.#button) return;
+
+    // Declarative shadow DOM gives us a ready-made root. Only browsers without
+    // DSD support leave the <template> inert, in which case we promote it once.
+    let root = this.shadowRoot;
+    if (!root) {
+      const template = this.querySelector(':scope > template[shadowrootmode]');
+      if (!template) return;
+      root = this.attachShadow({ mode: template.getAttribute('shadowrootmode') });
+      root.append(template.content);
+      template.remove();
+    }
+
+    // Restore saved state before wiring up, so it isn't treated as a user change.
+    if (this.drinkId && readFavorites().has(this.drinkId)) {
+      this.setAttribute('favorite', '');
+    }
+
+    this.#button = root.querySelector('.fav');
+    this.#button.addEventListener('click', () => this.toggleAttribute('favorite'));
+    this.#sync();
+  }
+
+  attributeChangedCallback() {
+    if (!this.#button) return;
+    this.#sync();
+    this.#persist();
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        detail: { id: this.drinkId, favorite: this.favorite },
+      }),
+    );
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id');
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  #sync() {
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+  }
+
+  #persist() {
+    if (!this.drinkId) return;
+    const favorites = readFavorites();
+    if (this.favorite) favorites.add(this.drinkId);
+    else favorites.delete(this.drinkId);
+    writeFavorites(favorites);
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
