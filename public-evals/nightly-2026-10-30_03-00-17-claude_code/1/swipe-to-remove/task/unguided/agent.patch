+  <script>
+    (function () {
+      // Fraction of the item's width a swipe must pass to trigger removal
+      var THRESHOLD = 0.4;
+      // Pixels of movement before deciding whether a gesture is horizontal
+      var DRAG_SLOP = 8;
+
+      var list = document.querySelector('.SwipeableList');
+      var emptyMessage = document.querySelector('.cart-empty');
+      if (!list) return;
+
+      function updateEmptyState() {
+        emptyMessage.hidden = list.querySelector('.SwipeableList-item') !== null;
+      }
+
+      function collapse(item) {
+        if (item.classList.contains('is-collapsing')) return;
+        // Pin the current height so the transition has a start value
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow
+        item.classList.add('is-collapsing');
+        item.style.height = '0px';
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          var next = item.nextElementSibling || item.previousElementSibling;
+          item.remove();
+          updateEmptyState();
+          if (next) next.focus();
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 500); // fallback if transitionend never fires
+      }
+
+      function removeWithSwipe(item, content, direction) {
+        var track = item.querySelector('.SwipeableList-track');
+        track.dataset.direction = direction;
+        item.classList.add('is-past-threshold');
+        content.classList.add('is-animating');
+        content.style.transform = 'translateX(' + (direction === 'left' ? '-' : '') + '100%)';
+        setTimeout(function () { collapse(item); }, 250);
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(function (item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var content = item.querySelector('.SwipeableList-content');
+        var startX = 0, startY = 0, dx = 0;
+        var pointerId = null;
+        var dragging = false;
+
+        function reset() {
+          pointerId = null;
+          dragging = false;
+          item.classList.remove('is-dragging');
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || item.classList.contains('is-collapsing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          content.classList.remove('is-animating');
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var moveX = e.clientX - startX;
+          var moveY = e.clientY - startY;
+
+          if (!dragging) {
+            if (Math.abs(moveX) < DRAG_SLOP && Math.abs(moveY) < DRAG_SLOP) return;
+            if (Math.abs(moveY) > Math.abs(moveX)) {
+              // Vertical gesture: let the page scroll
+              reset();
+              return;
+            }
+            dragging = true;
+            item.classList.add('is-dragging');
+            content.setPointerCapture(e.pointerId);
+          }
+
+          dx = moveX;
+          content.style.transform = 'translateX(' + dx + 'px)';
+          track.dataset.direction = dx < 0 ? 'left' : 'right';
+          item.classList.toggle('is-past-threshold', Math.abs(dx) > item.offsetWidth * THRESHOLD);
+        });
+
+        function endDrag(e) {
+          if (e.pointerId !== pointerId) return;
+          var wasDragging = dragging;
+          reset();
+          if (!wasDragging) return;
+
+          if (e.type !== 'pointercancel' && Math.abs(dx) > item.offsetWidth * THRESHOLD) {
+            removeWithSwipe(item, content, dx < 0 ? 'left' : 'right');
+          } else {
+            // Snap back
+            item.classList.remove('is-past-threshold');
+            content.classList.add('is-animating');
+            content.style.transform = '';
+          }
+        }
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+
+        item.addEventListener('keydown', function (e) {
+          if (e.target !== item) return;
+          if (e.key === 'Delete' || e.key === 'Backspace') {
+            e.preventDefault();
+            removeWithSwipe(item, content, 'left');
+          }
+        });
+      });
+    })();
+  </script>
+
