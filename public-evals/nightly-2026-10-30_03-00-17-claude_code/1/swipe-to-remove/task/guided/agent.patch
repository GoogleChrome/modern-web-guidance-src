+  <script>
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Per-item handles, created lazily the first time an item scrolls into view.
+    const swipeObservers = new WeakMap();
+
+    // Safari resets snap-container scroll on resize; re-center the content.
+    const trackResizeObserver = needsScrollWorkaround
+      ? new ResizeObserver((entries) => {
+          for (const entry of entries) {
+            entry.target.scrollLeft = entry.target.clientWidth;
+          }
+        })
+      : null;
+
+    // Wires items up on first view and pauses their swipe observer while offscreen.
+    const viewportObserver = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (entry.isIntersecting) {
+          const handle = swipeObservers.get(item) ?? setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          const handle = swipeObservers.get(item);
+          if (handle) handle.observer.unobserve(handle.content);
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = track.querySelector('.SwipeableList-content');
+
+      // Turns the track into a snap container; must happen before observing.
+      item.classList.add('is-initialized');
+
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        trackResizeObserver.observe(track);
+      }
+
+      // Below activateThreshold the action icon pops; below commitThreshold the item is removed.
+      const activateThreshold = 0.8;
+      const commitThreshold = 0.2;
+
+      const observer = new IntersectionObserver((entries) => {
+        const entry = entries.at(-1);
+        const ratio = entry.intersectionRatio;
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        const direction = offset > 0 ? 'left' : 'right';
+
+        if (ratio < commitThreshold) {
+          const rect = entry.boundingClientRect;
+          const translate = direction === 'left' ? rect.width - offset : -(offset + rect.width);
+          removeItem(item, translate, rect.height);
+          return;
+        }
+
+        item.classList.toggle('is-activating', ratio < activateThreshold);
+        if (offset !== 0) item.dataset.swipeDirection = direction;
+      }, {
+        root: track,
+        threshold: [commitThreshold, activateThreshold],
+      });
+
+      const handle = { observer, content, track };
+      swipeObservers.set(item, handle);
+      return handle;
+    }
+
+    async function removeItem(item, translate, height) {
+      if (item.classList.contains('is-removing')) return;
+
+      const handle = swipeObservers.get(item);
+      const list = item.parentElement;
+      const hadFocus = item.contains(document.activeElement);
+      const next = item.nextElementSibling ?? item.previousElementSibling;
+
+      viewportObserver.unobserve(item);
+      if (handle) {
+        handle.observer.disconnect();
+        trackResizeObserver?.unobserve(handle.track);
+      }
+
+      // Show the action color behind the row, then slide the content off and collapse the height.
+      const content = item.querySelector('.SwipeableList-content');
+      const opts = { duration: reduceMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+      item.classList.add('is-removing');
+      item.style.backgroundColor = 'var(--action-color)';
+      item.animate([{ height: `${height}px` }, { height: '0px' }], opts);
+      content.animate([{ translate: `${translate}px` }], opts);
+      await Promise.allSettled(item.getAnimations({ subtree: true }).map((a) => a.finished));
+
+      const finish = () => {
+        item.remove();
+        updateEmptyState(list);
+      };
+
+      // Safari: removing the node while swipe momentum is resolving makes the
+      // next item inherit the scroll, so defer the actual removal.
+      if (globalThis.GestureEvent) {
+        item.inert = true;
+        setTimeout(finish, 5000);
+      } else {
+        finish();
+      }
+
+      if (hadFocus) {
+        const target = next?.querySelector('.SwipeableList-track') ?? document.getElementById('cart-heading');
+        target.focus();
+      }
+    }
+
+    function updateEmptyState(list) {
+      const empty = list.parentElement.querySelector('.cart-empty');
+      const hasItems = list.querySelector('.SwipeableList-item:not([inert])');
+      list.hidden = !hasItems;
+      if (empty) empty.hidden = !!hasItems;
+    }
+
+    function setupList(list) {
+      for (const item of list.children) {
+        if (item.matches('.SwipeableList-item')) viewportObserver.observe(item);
+      }
+
+      // Pick up items added later.
+      new MutationObserver((mutations) => {
+        for (const mutation of mutations) {
+          for (const node of mutation.addedNodes) {
+            if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+              viewportObserver.observe(node);
+            }
+          }
+        }
+      }).observe(list, { childList: true });
+
+      // Accessible alternative to the swipe gesture.
+      list.addEventListener('click', (event) => {
+        const button = event.target.closest('.cart-item-remove');
+        if (!button) return;
+        const item = button.closest('.SwipeableList-item');
+        removeItem(item, -item.offsetWidth, item.offsetHeight);
+      });
+    }
+
+    document.querySelectorAll('.SwipeableList').forEach(setupList);
+  </script>
+
