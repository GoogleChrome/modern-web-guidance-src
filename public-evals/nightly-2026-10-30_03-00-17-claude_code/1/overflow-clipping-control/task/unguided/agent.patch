+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+      align-items: start;
+    }
+
+    /* Children are clipped at the inner content box; the clip edge follows
+       the concentric inner radius (border-radius minus padding) automatically. */
+    .nested-curve-parent {
+      background: var(--primary);
+      color: white;
+      padding: 16px;
+      border-radius: 28px;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .showcase-body {
+      background: white;
+      color: var(--text);
+      padding: 20px;
+    }
+
+    .nested-curve-parent .showcase-body h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .nested-curve-parent .showcase-footer {
+      background: var(--accent);
+      color: var(--text);
+      padding: 12px 20px;
+      font-weight: bold;
+      font-size: 0.9rem;
+    }
+
+    /* Overflowing text is clipped, but paint may extend 15px past the
+       padding box so the button's glow isn't cut off. */
+    .safety-zone-parent {
+      background: var(--secondary);
+      padding: 24px;
+      border-radius: 12px;
+      max-height: 260px;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent p {
+      margin-bottom: 4px;
+    }
+
+    .glow-btn {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      padding: 12px 28px;
+      border: none;
+      border-radius: 999px;
+      cursor: pointer;
+      margin-bottom: 16px;
+      box-shadow: 0 0 15px 6px rgba(255, 171, 64, 0.75);
+    }
   </style>
