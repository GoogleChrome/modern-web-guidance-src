+    /* Menus: popovers anchored to their trigger (the implicit anchor comes from the invoker or source) */
+    .menu {
+      position-area: block-end span-inline-end;
+      inset: auto;
+      margin: 0.25rem 0 0;
+      min-inline-size: 13rem;
+      padding: 0.375rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(62, 39, 35, 0.18);
+      text-align: start;
+    }
+
+    /* A popover nested in another popover is a submenu: beside its parent item, flipping when it would overflow. */
+    .menu .menu {
+      position-area: inline-end span-block-end;
+      position-try-fallbacks: flip-inline, flip-block, --below;
+      margin: 0;
+      margin-inline-start: 0.25rem;
+      overflow: visible;
+    }
+
+    /* Last resort for narrow viewports: directly below the trigger, indented, so the submenu never covers its trigger. */
+    @position-try --below {
+      position-area: block-end span-inline-end;
+      margin-block-start: 0.25rem;
+      margin-inline-start: 1rem;
+      min-inline-size: 0;
+      max-inline-size: calc(100% - 1rem);
+    }
+
+    /* Without anchor positioning, script places menus with viewport coordinates. */
+    @supports not (position-area: block-end) {
+      .menu,
+      .menu .menu {
+        position: fixed;
+        inset: auto;
+        margin: 0;
+      }
+    }
+
+    /* Safe triangle: covers sibling items on the pointer's path to an open submenu. */
+    .menu .menu[data-bridge]::before {
+      content: "";
+      position: absolute;
+      inset: -100vh -100vw;
+      clip-path: polygon(calc(100vw + var(--bridge-x)) calc(100vh + var(--bridge-y)),
+          calc(100vw + var(--bridge-edge)) 100vh,
+          calc(100vw + var(--bridge-edge)) calc(100vh + var(--bridge-height)));
+    }
+
