+  <script>
+    (() => {
+      'use strict';
+
+      /* ---------- Menu component (WAI-ARIA menu button pattern) ---------- */
+
+      const ITEM = '[role="menuitem"], [role="menuitemcheckbox"], [role="menuitemradio"]';
+      const HOVER_DELAY = 150;
+      const EDGE = 8;
+      const stacked = window.matchMedia('(max-width: 700px)');
+      let openMenu = null;
+
+      const itemsOf = menu => [...menu.children]
+        .map(li => [...li.children].find(el => el.matches(ITEM)))
+        .filter(Boolean);
+      const submenuOf = item => item.getAttribute('aria-haspopup') === 'menu' ? item.nextElementSibling : null;
+      const parentItemOf = menu => {
+        const prev = menu.previousElementSibling;
+        return prev && prev.matches(ITEM) ? prev : null;
+      };
+
+      function focusItem(menu, which) {
+        const items = itemsOf(menu);
+        const target = which === 'last' ? items[items.length - 1] : which === 'first' ? items[0] : which;
+        if (target) target.focus();
+      }
+
+      function closeSubmenus(menu, except) {
+        itemsOf(menu).forEach(item => {
+          const sub = submenuOf(item);
+          if (!sub || item === except || sub.hidden) return;
+          closeSubmenus(sub);
+          sub.hidden = true;
+          item.setAttribute('aria-expanded', 'false');
+        });
+      }
+
+      function positionRoot(menu) {
+        menu.classList.remove('align-end', 'align-start', 'open-up');
+        const r = menu.getBoundingClientRect();
+        const vw = document.documentElement.clientWidth;
+        if (r.right > vw - EDGE) menu.classList.add('align-end');
+        else if (r.left < EDGE) menu.classList.add('align-start');
+        const anchor = menu.parentElement.getBoundingClientRect();
+        if (r.bottom > window.innerHeight - EDGE && anchor.top - EDGE > r.height) menu.classList.add('open-up');
+      }
+
+      function positionSubmenu(sub) {
+        if (stacked.matches) return;
+        const vw = document.documentElement.clientWidth;
+        const preferLeft = sub.parentElement.closest('[role="menu"]').classList.contains('flip-x');
+        sub.style.top = '';
+        sub.classList.toggle('flip-x', preferLeft);
+        const r = sub.getBoundingClientRect();
+        if (preferLeft && r.left < EDGE) sub.classList.remove('flip-x');
+        else if (!preferLeft && r.right > vw - EDGE) sub.classList.add('flip-x');
+        const overflow = r.bottom - (window.innerHeight - EDGE);
+        if (overflow > 0) sub.style.top = `${-6 - Math.min(overflow, r.top - EDGE)}px`;
+      }
+
+      class MenuButton {
+        constructor(wrap) {
+          this.wrap = wrap;
+          this.trigger = wrap.querySelector(':scope > .menu-trigger');
+          this.menu = wrap.querySelector(':scope > [role="menu"]');
+          this.hovered = null;
+          this.hoverTimer = null;
+          this.search = { text: '', timer: null };
+
+          this.trigger.addEventListener('click', () => (this.isOpen ? this.close() : this.open('first')));
+          this.trigger.addEventListener('keydown', e => {
+            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+              e.preventDefault();
+              this.open(e.key === 'ArrowDown' ? 'first' : 'last');
+            }
+          });
+          this.menu.addEventListener('keydown', e => this.onKeydown(e));
+          this.menu.addEventListener('click', e => this.onClick(e));
+          this.menu.addEventListener('pointerover', e => this.onPointerOver(e));
+        }
+
+        get isOpen() {
+          return !this.menu.hidden;
+        }
+
+        open(focus) {
+          if (openMenu && openMenu !== this) openMenu.close(false);
+          this.menu.hidden = false;
+          this.trigger.setAttribute('aria-expanded', 'true');
+          positionRoot(this.menu);
+          openMenu = this;
+          if (focus) focusItem(this.menu, focus);
+        }
+
+        close(returnFocus = true) {
+          clearTimeout(this.hoverTimer);
+          closeSubmenus(this.menu);
+          this.menu.hidden = true;
+          this.trigger.setAttribute('aria-expanded', 'false');
+          this.hovered = null;
+          if (openMenu === this) openMenu = null;
+          if (returnFocus) this.trigger.focus();
+        }
+
+        openSubmenu(item, focus) {
+          const sub = submenuOf(item);
+          closeSubmenus(item.closest('[role="menu"]'), item);
+          sub.hidden = false;
+          item.setAttribute('aria-expanded', 'true');
+          positionSubmenu(sub);
+          if (focus) focusItem(sub, focus);
+        }
+
+        closeSubmenu(item) {
+          const sub = submenuOf(item);
+          closeSubmenus(sub);
+          sub.hidden = true;
+          item.setAttribute('aria-expanded', 'false');
+        }
+
+        onKeydown(e) {
+          const item = e.target.closest(ITEM);
+          if (!item) return;
+          const menu = item.closest('[role="menu"]');
+          const items = itemsOf(menu);
+          const i = items.indexOf(item);
+          const parentItem = parentItemOf(menu);
+
+          switch (e.key) {
+            case 'ArrowDown':
+              items[(i + 1) % items.length].focus();
+              break;
+            case 'ArrowUp':
+              items[(i - 1 + items.length) % items.length].focus();
+              break;
+            case 'Home':
+            case 'PageUp':
+              focusItem(menu, 'first');
+              break;
+            case 'End':
+            case 'PageDown':
+              focusItem(menu, 'last');
+              break;
+            case 'ArrowRight':
+              if (submenuOf(item)) this.openSubmenu(item, 'first');
+              break;
+            case 'ArrowLeft':
+              if (parentItem) {
+                this.closeSubmenu(parentItem);
+                parentItem.focus();
+              }
+              break;
+            case 'Escape':
+              if (parentItem) {
+                this.closeSubmenu(parentItem);
+                parentItem.focus();
+              } else {
+                this.close();
+              }
+              break;
+            case 'Enter':
+            case ' ':
+              // Route through click so links navigate natively and pointer/keyboard share one path
+              item.click();
+              break;
+            case 'Tab':
+              // Let focus move on naturally from the trigger's position in the tab order
+              this.trigger.focus();
+              this.close(false);
+              return;
+            default:
+              if (e.key.length !== 1 || e.ctrlKey || e.metaKey || e.altKey) return;
+              this.typeahead(items, item, e.key);
+          }
+          e.preventDefault();
+          e.stopPropagation();
+        }
+
+        typeahead(items, current, char) {
+          clearTimeout(this.search.timer);
+          this.search.text += char.toLowerCase();
+          this.search.timer = setTimeout(() => (this.search.text = ''), 500);
+          const start = items.indexOf(current) + (this.search.text.length === 1 ? 1 : 0);
+          const ordered = [...items.slice(start), ...items.slice(0, start)];
+          const match = ordered.find(el => el.textContent.trim().toLowerCase().startsWith(this.search.text));
+          if (match) match.focus();
+        }
+
+        onClick(e) {
+          const item = e.target.closest(ITEM);
+          if (!item) return;
+          // detail === 0 means the click came from the keyboard (or item.click())
+          const viaKeyboard = e.detail === 0;
+
+          if (item.getAttribute('aria-disabled') === 'true') {
+            e.preventDefault();
+            return;
+          }
+
+          const sub = submenuOf(item);
+          if (sub) {
+            clearTimeout(this.hoverTimer);
+            if (sub.hidden) this.openSubmenu(item, viaKeyboard ? 'first' : null);
+            else if (viaKeyboard) focusItem(sub, 'first');
+            // Flyouts may already be open from hover, so a click only collapses inline (stacked) submenus
+            else if (stacked.matches) this.closeSubmenu(item);
+            return;
+          }
+
+          const role = item.getAttribute('role');
+          if (role === 'menuitemcheckbox') {
+            item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+            this.emit('menuchange', item);
+            return;
+          }
+          if (role === 'menuitemradio') {
+            if (item.getAttribute('aria-checked') === 'true') return;
+            const group = item.dataset.group;
+            const peers = group
+              ? this.menu.querySelectorAll(`[role="menuitemradio"][data-group="${group}"]`)
+              : itemsOf(item.closest('[role="menu"]')).filter(el => el.getAttribute('role') === 'menuitemradio');
+            peers.forEach(el => el.setAttribute('aria-checked', String(el === item)));
+            this.emit('menuchange', item);
+            return;
+          }
+
+          this.emit('menuselect', item);
+          this.close();
+        }
+
+        onPointerOver(e) {
+          if (e.pointerType !== 'mouse' || stacked.matches) return;
+          const item = e.target.closest(ITEM);
+          if (!item || item === this.hovered) return;
+          this.hovered = item;
+          item.focus({ preventScroll: true });
+          clearTimeout(this.hoverTimer);
+          // Short delay so moving diagonally toward an open submenu doesn't collapse it
+          this.hoverTimer = setTimeout(() => {
+            closeSubmenus(item.closest('[role="menu"]'), item);
+            const sub = submenuOf(item);
+            if (sub && sub.hidden && item.getAttribute('aria-disabled') !== 'true') this.openSubmenu(item, null);
+          }, HOVER_DELAY);
+        }
+
+        emit(type, item) {
+          this.wrap.dispatchEvent(new CustomEvent(type, {
+            bubbles: true,
+            detail: {
+              item,
+              action: item.dataset.action,
+              value: item.dataset.value,
+              group: item.dataset.group,
+              checked: item.getAttribute('aria-checked') === 'true',
+            },
+          }));
+        }
+      }
+
+      document.addEventListener('pointerdown', e => {
+        if (openMenu && !openMenu.wrap.contains(e.target)) openMenu.close(false);
+      });
+      window.addEventListener('resize', () => openMenu && openMenu.close(false));
+
+      /* ---------- Seasonal favorite order menus ---------- */
+
+      const SIZES = {
+        cup: [['small', 'Small', '12 oz', -0.5], ['medium', 'Medium', '16 oz', 0], ['large', 'Large', '20 oz', 0.7]],
+        shots: [['single', 'Single', '1 shot', 0], ['double', 'Double', '2 shots', 1], ['triple', 'Triple', '3 shots', 1.75]],
+      };
+      const DAIRY = [['whole', 'Whole milk', 0], ['two-percent', '2% milk', 0], ['skim', 'Skim milk', 0], ['half-half', 'Half &amp; half', 0]];
+      const PLANT = [['oat', 'Oat milk', 0.7], ['almond', 'Almond milk', 0.7], ['soy', 'Soy milk', 0.7], ['coconut', 'Coconut milk', 0.7]];
+      const TEMPS = [['hot', 'Hot'], ['extra-hot', 'Extra hot'], ['iced', 'Iced']];
+      const SWEETNESS = [['unsweetened', 'Unsweetened'], ['light', 'Lightly sweet'], ['regular', 'Regular'], ['extra', 'Extra sweet']];
+      const SYRUPS = [['vanilla', 'Vanilla'], ['caramel', 'Caramel'], ['maple', 'Maple'], ['hazelnut', 'Hazelnut'], ['pumpkin', 'Pumpkin spice']];
+      const TOPPINGS = [['whip', 'Whipped cream', 0.5], ['cinnamon', 'Cinnamon dust', 0], ['drizzle', 'Caramel drizzle', 0.5], ['cold-foam', 'Cold foam', 1.25]];
+
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte', base: 5.25, sizes: 'cup', noMilk: false, temps: ['hot', 'extra-hot', 'iced'],
+          defaults: { size: 'medium', milk: 'oat', temp: 'hot', sweet: 'regular', addins: ['maple'] },
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso', base: 2.75, sizes: 'shots', noMilk: true, temps: ['hot'],
+          defaults: { size: 'double', milk: 'none', temp: 'hot', sweet: 'unsweetened', addins: [] },
+        },
+        'cold-brew': {
+          name: 'Cold Brew', base: 4.45, sizes: 'cup', noMilk: true, temps: ['iced'],
+          defaults: { size: 'medium', milk: 'none', temp: 'iced', sweet: 'unsweetened', addins: [] },
+        },
+      };
+
+      const money = n => `$${n.toFixed(2)}`;
+      const delta = n => (n > 0 ? `+${money(n)}` : n < 0 ? `−${money(-n)}` : '');
+      const hint = text => (text ? `<span class="mi-hint">${text}</span>` : '');
+      const SEP = '<li role="separator"></li>';
+
+      const action = (act, label, extra = '') =>
+        `<li role="none"><button type="button" role="menuitem" tabindex="-1" data-action="${act}"><span class="mi-label">${label}</span>${extra}</button></li>`;
+      const submenu = (label, items) =>
+        `<li role="none"><button type="button" role="menuitem" tabindex="-1" aria-haspopup="menu" aria-expanded="false"><span class="mi-label">${label}</span></button>` +
+        `<ul class="menu" role="menu" aria-label="${label}" hidden>${items.join('')}</ul></li>`;
+      // A selectable option; `checked` doubles as its default so "Reset" can restore it
+      const option = (role, { group, value, label, summary = label, price = 0, hintText = delta(price), checked = false, disabled = false }) =>
+        `<li role="none"><button type="button" role="${role}" tabindex="-1" aria-checked="${checked}"` +
+        ` data-group="${group}" data-value="${value}" data-summary="${summary}" data-price="${price}" data-default="${checked}"` +
+        `${disabled ? ' aria-disabled="true"' : ''}><span class="mi-label">${label}</span>${hint(disabled ? 'Not available' : hintText)}</button></li>`;
+      const radio = opts => option('menuitemradio', opts);
+      const checkbox = opts => option('menuitemcheckbox', opts);
+
+      function buildMenu(key, drink) {
+        const d = drink.defaults;
+        const addin = (value, label, price) =>
+          checkbox({ group: 'addin', value, label, price, checked: d.addins.includes(value) });
+
+        const customize = [
+          submenu('Size', SIZES[drink.sizes].map(([value, label, oz, price]) =>
+            radio({ group: 'size', value, label, summary: label, price, hintText: [oz, delta(price)].filter(Boolean).join(' · '), checked: d.size === value }))),
+          submenu('Milk', [
+            ...(drink.noMilk ? [radio({ group: 'milk', value: 'none', label: 'No milk', summary: '', checked: d.milk === 'none' })] : []),
+            submenu('Dairy', DAIRY.map(([value, label, price]) => radio({ group: 'milk', value, label, price, checked: d.milk === value }))),
+            submenu('Plant-based', PLANT.map(([value, label, price]) => radio({ group: 'milk', value, label, price, checked: d.milk === value }))),
+          ]),
+          submenu('Temperature', TEMPS.map(([value, label]) =>
+            radio({ group: 'temp', value, label, checked: d.temp === value, disabled: !drink.temps.includes(value) }))),
+          submenu('Sweetness', SWEETNESS.map(([value, label]) =>
+            radio({ group: 'sweet', value, label, summary: value === 'regular' ? '' : label, checked: d.sweet === value }))),
+          submenu('Add-ins', [
+            addin('shot', 'Extra espresso shot', 1),
+            submenu('Syrups', SYRUPS.map(([value, label]) => addin(value, `${label} syrup`, 0.6))),
+            submenu('Toppings', TOPPINGS.map(([value, label, price]) => addin(value, label, price))),
+          ]),
+          SEP,
+          action('reset', 'Reset to default'),
+        ];
+
+        const items = [
+          submenu('Customize', customize),
+          submenu('Quantity', [1, 2, 3, 4].map(n =>
+            radio({ group: 'qty', value: n, label: String(n), summary: '', hintText: '', checked: n === 1 }))),
+          SEP,
+          action('add', 'Add to order', '<span class="mi-hint" data-total></span>'),
+          `<li role="none"><button type="button" role="menuitemcheckbox" tabindex="-1" aria-checked="false" data-action="favorite"><span class="mi-label">Save as favorite</span></button></li>`,
+          submenu('Share', [action('copy-link', 'Copy link'), action('email', 'Email a friend'), action('sms', 'Text a friend')]),
+          SEP,
+          `<li role="none"><a role="menuitem" tabindex="-1" href="/menu/${key}"><span class="mi-label">View details</span></a></li>`,
+        ];
+
+        return `<div class="menu-wrap" data-menu>
+          <button type="button" class="btn menu-trigger" id="${key}-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="${key}-menu">
+            Customize &amp; Order <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
+          </button>
+          <ul class="menu" role="menu" id="${key}-menu" aria-labelledby="${key}-btn" hidden>${items.join('')}</ul>
+        </div>`;
+      }
+
+      const toastEl = document.getElementById('toast');
+      let toastTimer;
+      function toast(message) {
+        toastEl.textContent = message;
+        toastEl.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3000);
+      }
+
+      const cartCountEl = document.getElementById('cart-count');
+      let cartCount = 0;
+
+      function readOrder(card, drink) {
+        const checked = [...card.querySelectorAll('[data-group][aria-checked="true"]')];
+        const qty = Number(checked.find(el => el.dataset.group === 'qty').dataset.value);
+        const each = checked.reduce((sum, el) => sum + Number(el.dataset.price), drink.base);
+        const options = checked.map(el => el.dataset.summary).filter(Boolean);
+        return { qty, total: each * qty, options };
+      }
+
+      function render(card, drink) {
+        const { qty, total, options } = readOrder(card, drink);
+        card.querySelector('.card-options').textContent = options.join(' · ');
+        card.querySelector('.card-price').textContent = `${qty > 1 ? `${qty} × ` : ''}${money(total)}`;
+        card.querySelector('[data-total]').textContent = money(total);
+      }
+
+      document.querySelectorAll('.card[data-drink]').forEach(card => {
+        const key = card.dataset.drink;
+        const drink = DRINKS[key];
+        card.querySelector('.card-actions').innerHTML = buildMenu(key, drink);
+        render(card, drink);
+
+        card.addEventListener('menuchange', e => {
+          if (e.detail.action === 'favorite') {
+            toast(e.detail.checked ? `${drink.name} saved to your favorites` : `${drink.name} removed from favorites`);
+          }
+          render(card, drink);
+        });
+
+        card.addEventListener('menuselect', e => {
+          const { qty, total, options } = readOrder(card, drink);
+          const description = `${drink.name}${options.length ? ` (${options.join(', ')})` : ''}`;
+          const url = new URL(`/menu/${key}`, location.href).href;
+          switch (e.detail.action) {
+            case 'add':
+              cartCount += qty;
+              cartCountEl.textContent = cartCount;
+              toast(`Added ${qty} × ${description} — ${money(total)}`);
+              break;
+            case 'reset':
+              card.querySelectorAll('[data-group]:not([data-group="qty"])').forEach(el =>
+                el.setAttribute('aria-checked', el.dataset.default));
+              render(card, drink);
+              toast(`${drink.name} reset to the house recipe`);
+              break;
+            case 'copy-link':
+              (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
+                .then(() => toast('Link copied to clipboard'), () => toast(`Copy this link: ${url}`));
+              break;
+            case 'email':
+              location.href = `mailto:?subject=${encodeURIComponent(`Try the ${drink.name}`)}&body=${encodeURIComponent(`${description}\n${url}`)}`;
+              break;
+            case 'sms':
+              location.href = `sms:?&body=${encodeURIComponent(`Try the ${description} at The Daily Grind: ${url}`)}`;
+              break;
+          }
+        });
+      });
+
+      document.getElementById('account-menu').parentElement.addEventListener('menuchange', e => {
+        const label = e.detail.item.querySelector('.mi-label').textContent;
+        toast(`${label} ${e.detail.checked ? 'turned on' : 'turned off'}`);
+      });
+
+      document.querySelectorAll('[data-menu]').forEach(wrap => new MenuButton(wrap));
+    })();
+  </script>
+
 </body>
 
