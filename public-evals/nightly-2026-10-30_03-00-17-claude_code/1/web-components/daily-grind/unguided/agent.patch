+import { baseStyles, createSheet } from './shared-styles.js';
+
+const styles = createSheet(`
+  :host {
+    display: block;
+    margin-top: 40px;
+    padding: 40px 20px;
+    background: var(--_secondary);
+    color: var(--_text);
+    text-align: center;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 0.5rem 20px;
+    margin-bottom: 20px;
+  }
+
+  ::slotted(a) {
+    color: var(--_text);
+    font-size: 0.85rem;
+    text-decoration: none;
+  }
+
+  ::slotted(a:hover) {
+    text-decoration: underline;
+  }
+
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--_primary);
+    outline-offset: 3px;
+  }
+
+  ::slotted([slot="legal"]) {
+    margin: 0;
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="links"><slot></slot></nav>
+  <slot name="legal"></slot>
+`;
+
+/**
+ * <site-footer> — page footer with a secondary link list.
+ *
+ * Give it role="contentinfo" to keep the footer landmark.
+ *
+ * Attributes:
+ *   label — accessible name for the links <nav> (default "Footer")
+ *
+ * Slots:
+ *   (default) — footer links
+ *   legal     — copyright / legal text
+ *
+ * Parts: links
+ */
+export class SiteFooter extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.append(template.content.cloneNode(true));
+    this.#nav = root.querySelector('nav');
+    this.#nav.setAttribute('aria-label', 'Footer');
+  }
+
+  attributeChangedCallback(_name, _oldValue, newValue) {
+    this.#nav.setAttribute('aria-label', newValue || 'Footer');
+  }
+}
+
+if (!customElements.get('site-footer')) {
+  customElements.define('site-footer', SiteFooter);
+}
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..a19c735
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,294 @@
+import { baseStyles, createSheet } from './shared-styles.js';
+
+const styles = createSheet(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--_primary);
+    color: #fff;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 0.5rem 1rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  .menu {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+  }
+
+  ::slotted(a:not([slot="brand"])) {
+    color: #fff;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+
+  ::slotted(a:hover),
+  ::slotted(a[aria-current="page"]) {
+    color: var(--_accent);
+  }
+
+  ::slotted(a[aria-current="page"]) {
+    text-decoration: underline;
+    text-underline-offset: 4px;
+  }
+
+  ::slotted([slot="actions"]) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  ::slotted(a:focus-visible),
+  .toggle:focus-visible {
+    outline: var(--_focus-ring);
+    outline-offset: 3px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 6px 12px;
+    font: inherit;
+    font-size: 0.9rem;
+    color: inherit;
+    background: transparent;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    cursor: pointer;
+  }
+
+  .toggle-icon,
+  .toggle-icon::before,
+  .toggle-icon::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.2s ease;
+  }
+
+  .toggle-icon {
+    position: relative;
+  }
+
+  .toggle-icon::before,
+  .toggle-icon::after {
+    content: "";
+    position: absolute;
+    left: 0;
+  }
+
+  .toggle-icon::before { top: -6px; }
+  .toggle-icon::after { top: 6px; }
+
+  :host([open]) .toggle-icon { background: transparent; }
+  :host([open]) .toggle-icon::before { transform: translateY(6px) rotate(45deg); }
+  :host([open]) .toggle-icon::after { transform: translateY(-6px) rotate(-45deg); }
+
+  @media (max-width: 720px) {
+    .toggle {
+      display: inline-flex;
+    }
+
+    .menu {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0;
+      padding-top: 0.5rem;
+    }
+
+    :host([open]) .menu {
+      display: flex;
+    }
+
+    ::slotted(a:not([slot="brand"])) {
+      display: block;
+      padding: 0.6rem 0;
+      font-size: 1rem;
+    }
+
+    ::slotted([slot="actions"]) {
+      margin-top: 0.5rem;
+      padding: 0.4rem 12px;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    ::slotted(a:not([slot="brand"])),
+    .toggle-icon,
+    .toggle-icon::before,
+    .toggle-icon::after {
+      transition: none;
+    }
+  }
+
+  @media (forced-colors: active) {
+    .toggle-icon,
+    .toggle-icon::before,
+    .toggle-icon::after {
+      background: ButtonText;
+    }
+
+    :host([open]) .toggle-icon {
+      background: transparent;
+    }
+  }
+`);
+
+const MOBILE_QUERY = '(max-width: 720px)';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button"
+            aria-expanded="false" aria-controls="menu">
+      <span class="toggle-icon" aria-hidden="true"></span>
+      <span>Menu</span>
+    </button>
+    <div class="menu" id="menu" part="menu">
+      <slot></slot>
+      <slot name="actions"></slot>
+    </div>
+  </nav>
+`;
+
+/**
+ * <site-nav> — sticky primary navigation with a collapsible mobile menu.
+ *
+ * The toggle is a real <button> with aria-expanded/aria-controls. On small
+ * screens the menu closes on Escape (returning focus to the toggle), when
+ * focus or a click leaves the navigation, and after a link is chosen.
+ *
+ * Attributes:
+ *   label — accessible name for the <nav> landmark (default "Main")
+ *   open  — reflects whether the mobile menu is expanded
+ *
+ * Slots:
+ *   brand     — site logo / home link
+ *   (default) — navigation links
+ *   actions   — trailing links rendered as outlined buttons (e.g. Logout)
+ *
+ * Parts: nav, toggle, menu
+ *
+ * Events:
+ *   toggle — fired when the mobile menu opens or closes; detail: { open }
+ */
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['open', 'label'];
+
+  #nav;
+  #toggle;
+  #mobile = window.matchMedia(MOBILE_QUERY);
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.append(template.content.cloneNode(true));
+
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+
+    this.#toggle.addEventListener('click', () => {
+      this.open = !this.open;
+    });
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('focusout', this.#onFocusOut);
+    this.addEventListener('click', this.#onLinkClick);
+  }
+
+  connectedCallback() {
+    this.#mobile.addEventListener('change', this.#onBreakpointChange);
+    document.addEventListener('click', this.#onDocumentClick);
+  }
+
+  disconnectedCallback() {
+    this.#mobile.removeEventListener('change', this.#onBreakpointChange);
+    document.removeEventListener('click', this.#onDocumentClick);
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'label') {
+      this.#nav?.setAttribute('aria-label', newValue || 'Main');
+      return;
+    }
+
+    const isOpen = newValue !== null;
+    if ((oldValue !== null) === isOpen) return;
+    this.#toggle?.setAttribute('aria-expanded', String(isOpen));
+    this.dispatchEvent(new CustomEvent('toggle', { detail: { open: isOpen } }));
+  }
+
+  #close({ restoreFocus = false } = {}) {
+    if (!this.open) return;
+    this.open = false;
+    if (restoreFocus) this.#toggle.focus();
+  }
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.open) {
+      event.preventDefault();
+      this.#close({ restoreFocus: true });
+    }
+  };
+
+  #onFocusOut = (event) => {
+    // A null relatedTarget means focus left the page (e.g. a tab switch);
+    // outside clicks are handled separately by #onDocumentClick.
+    const next = event.relatedTarget;
+    if (this.#mobile.matches && next && !this.contains(next)) {
+      this.#close();
+    }
+  };
+
+  #onLinkClick = (event) => {
+    if (this.#mobile.matches && event.target.closest('a')) {
+      this.#close();
+    }
+  };
+
+  #onDocumentClick = (event) => {
+    if (this.open && !event.composedPath().includes(this)) {
+      this.#close();
+    }
+  };
+
+  #onBreakpointChange = (event) => {
+    if (!event.matches) this.#close();
+  };
+}
+
+if (!customElements.get('site-nav')) {
+  customElements.define('site-nav', SiteNav);
+}
