new file mode 100644
index 0000000..acb93ed
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,69 @@
+/**
+ * Shared constructable stylesheets for Daily Grind components.
+ *
+ * Theme tokens are read from CSS custom properties, which inherit through
+ * shadow roots, so pages can re-theme every component from :root.
+ */
+
+export function createSheet(cssText) {
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(cssText);
+  return sheet;
+}
+
+export const baseStyles = createSheet(`
+  :host {
+    --_primary: var(--primary, #4e342e);
+    --_primary-dark: var(--primary-dark, #3e2723);
+    --_secondary: var(--secondary, #d7ccc8);
+    --_accent: var(--accent, #ffab40);
+    --_text: var(--text, #3e2723);
+    --_surface: var(--surface, #ffffff);
+    --_focus-ring: 3px solid var(--_accent);
+    box-sizing: border-box;
+  }
+
+  *, *::before, *::after {
+    box-sizing: inherit;
+  }
+
+  [hidden] {
+    display: none !important;
+  }
+`);
+
+/** Styles any slotted link with slot="action" as the brand button. */
+export const actionStyles = createSheet(`
+  ::slotted([slot="action"]) {
+    display: inline-block;
+    background: var(--_primary);
+    color: #fff;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    border: 2px solid transparent;
+    font-weight: 600;
+    transition: background-color 0.3s;
+  }
+
+  ::slotted([slot="action"]:hover) {
+    background: var(--_primary-dark);
+  }
+
+  ::slotted([slot="action"]:focus-visible) {
+    outline: var(--_focus-ring);
+    outline-offset: 3px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    ::slotted([slot="action"]) {
+      transition: none;
+    }
+  }
+
+  @media (forced-colors: active) {
+    ::slotted([slot="action"]) {
+      border-color: ButtonText;
+    }
+  }
+`);
