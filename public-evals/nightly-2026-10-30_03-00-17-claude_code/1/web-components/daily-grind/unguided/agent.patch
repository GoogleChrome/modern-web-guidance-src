new file mode 100644
index 0000000..7629d03
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,152 @@
+import { baseStyles, actionStyles, createSheet } from './shared-styles.js';
+
+const styles = createSheet(`
+  :host {
+    display: block;
+    /* The amber accent lacks 3:1 contrast on the white card surface. */
+    --_focus-ring: 3px solid var(--_primary);
+  }
+
+  article {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    background: var(--_surface);
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    overflow: hidden;
+    text-align: center;
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+  }
+
+  /* Lift the card when it is hovered or contains keyboard focus. */
+  article:hover,
+  article:focus-within {
+    transform: translateY(-4px);
+    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
+  }
+
+  .media {
+    aspect-ratio: 4 / 3;
+    background: var(--_secondary);
+  }
+
+  .media:not(.has-media) {
+    display: none;
+  }
+
+  ::slotted([slot="media"]) {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    align-items: center;
+    padding: 20px;
+  }
+
+  ::slotted([slot="title"]) {
+    margin: 0 0 10px;
+    font-size: 1.17rem;
+    color: var(--_primary);
+  }
+
+  ::slotted(:not([slot])) {
+    margin: 0;
+  }
+
+  .actions {
+    margin-top: auto;
+    padding-top: 15px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    article {
+      transition: none;
+    }
+
+    article:hover,
+    article:focus-within {
+      transform: none;
+    }
+  }
+
+  @media (forced-colors: active) {
+    article {
+      border: 1px solid CanvasText;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article part="card">
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="body" part="body">
+      <slot name="title"></slot>
+      <slot></slot>
+      <div class="actions" part="actions"><slot name="action"></slot></div>
+    </div>
+  </article>
+`;
+
+/**
+ * <coffee-card> — a menu item card.
+ *
+ * Content stays in the light DOM so the heading level, description and link
+ * remain fully accessible (and visible without JavaScript).
+ *
+ * Slots:
+ *   media  — optional <img> (include alt text, or alt="" if decorative)
+ *   title  — the item heading, e.g. <h3 slot="title">
+ *   (default) — description content
+ *   action — call-to-action link, rendered as a button
+ *
+ * Parts: card, media, body, actions
+ */
+export class CoffeeCard extends HTMLElement {
+  #article;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, actionStyles, styles];
+    root.append(template.content.cloneNode(true));
+
+    this.#article = root.querySelector('article');
+    const mediaSlot = root.querySelector('slot[name="media"]');
+    const titleSlot = root.querySelector('slot[name="title"]');
+
+    mediaSlot.addEventListener('slotchange', () => {
+      mediaSlot.parentElement.classList.toggle(
+        'has-media',
+        mediaSlot.assignedElements().length > 0,
+      );
+    });
+    titleSlot.addEventListener('slotchange', () => this.#labelFromTitle());
+  }
+
+  connectedCallback() {
+    this.#labelFromTitle();
+  }
+
+  /** Name the <article> landmark after the card's title. */
+  #labelFromTitle() {
+    const title = this.querySelector(':scope > [slot="title"]');
+    const name = title?.textContent.trim();
+    if (name) {
+      this.#article.setAttribute('aria-label', name);
+    } else {
+      this.#article.removeAttribute('aria-label');
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
