     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var message = document.getElementById('newsletter-message');
+
+      function setMessage(text, type) {
+        message.textContent = text;
+        message.className = 'newsletter-message' + (type ? ' ' + type : '');
+      }
+
+      function showError() {
+        input.classList.add('is-invalid');
+        input.setAttribute('aria-invalid', 'true');
+        setMessage(input.value.trim() === ''
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.', 'error');
+      }
+
+      function clearError() {
+        input.classList.remove('is-invalid');
+        input.removeAttribute('aria-invalid');
+        setMessage('');
+      }
+
+      // Only validate once the user leaves the field. Leaving an empty,
+      // untouched field alone doesn't count as a mistake.
+      input.addEventListener('blur', function () {
+        if (input.value === '') return clearError();
+        input.checkValidity() ? clearError() : showError();
+      });
+
+      // While typing, never add an error -- only remove one once it's fixed.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('is-invalid') && input.checkValidity()) clearError();
+        else if (message.classList.contains('success')) setMessage('');
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!input.checkValidity()) {
+          showError();
+          input.focus();
+          return;
+        }
+        clearError();
+        setMessage('Thanks for signing up! Check your inbox soon.', 'success');
+        form.reset();
+      });
+    })();
+  </script>
 </body>
 
 </html>
