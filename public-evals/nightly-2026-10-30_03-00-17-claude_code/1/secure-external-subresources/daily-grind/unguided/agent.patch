+  <script>
+    // Images and @font-face files can't carry an integrity attribute, so fetch them with
+    // fetch()'s `integrity` option instead: the browser rejects the response if its SHA-384
+    // digest doesn't match, and only verified bytes are ever handed to the page.
+    (function () {
+      var FETCH_OPTIONS = { mode: 'cors', credentials: 'omit', referrerPolicy: 'no-referrer' };
+
+      var FONTS = [
+        {
+          family: 'Playfair Display',
+          descriptors: { weight: '700', style: 'normal', display: 'swap' },
+          url: 'https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.1.0/files/playfair-display-latin-700-normal.woff2',
+          integrity: 'sha384-2OUMztuc2Uvfq3n8w2APnig7JM4X9miM/re2XmGSZqKU6gdoOGFHDSiACwWV1wfK'
+        },
+        {
+          family: 'Lato',
+          descriptors: { weight: '400', style: 'normal', display: 'swap' },
+          url: 'https://cdn.jsdelivr.net/npm/@fontsource/lato@5.1.0/files/lato-latin-400-normal.woff2',
+          integrity: 'sha384-+chn3xqCWRPSXDBtVEFQn+0J9Gb0SYR2FO1WrXo+L/arnyr8lXLVX2p0BqZIUemc'
+        }
+      ];
+
+      function fetchVerified(url, integrity) {
+        var options = Object.assign({ integrity: integrity }, FETCH_OPTIONS);
+        return fetch(url, options).then(function (response) {
+          if (!response.ok) throw new Error('HTTP ' + response.status + ' for ' + url);
+          return response;
+        });
+      }
+
+      function warn(error) {
+        console.warn('[verified-assets] Skipped asset that failed to load or verify:', error);
+      }
+
+      if (window.FontFace && document.fonts) {
+        FONTS.forEach(function (font) {
+          fetchVerified(font.url, font.integrity)
+            .then(function (response) { return response.arrayBuffer(); })
+            .then(function (data) { return new FontFace(font.family, data, font.descriptors).load(); })
+            .then(function (face) { document.fonts.add(face); })
+            .catch(warn);
+        });
+      }
+
+      function loadVerifiedImage(url, integrity) {
+        return fetchVerified(url, integrity)
+          .then(function (response) { return response.blob(); })
+          .then(function (blob) { return URL.createObjectURL(blob); });
+      }
+
+      document.querySelectorAll('[data-verified-bg]').forEach(function (el) {
+        loadVerifiedImage(el.dataset.verifiedBg, el.dataset.integrity)
+          .then(function (objectUrl) { el.style.setProperty('--hero-image', 'url("' + objectUrl + '")'); })
+          .catch(warn);
+      });
+
+      document.querySelectorAll('img[data-verified-src]').forEach(function (img) {
+        loadVerifiedImage(img.dataset.verifiedSrc, img.dataset.integrity)
+          .then(function (objectUrl) {
+            img.addEventListener('load', function () { URL.revokeObjectURL(objectUrl); }, { once: true });
+            img.src = objectUrl;
+          })
+          .catch(warn);
+      });
+
+      // AOS hides [data-aos] elements until it initializes, so only opt the cards in once the
+      // SRI-verified script has actually run; if it's blocked, the cards simply render statically.
+      window.addEventListener('DOMContentLoaded', function () {
+        if (!window.AOS) return;
+        document.querySelectorAll('.card').forEach(function (card, i) {
+          card.setAttribute('data-aos', 'fade-up');
+          card.setAttribute('data-aos-delay', String(i * 100));
+        });
+        window.AOS.init({ once: true, duration: 600 });
+      });
+    })();
+  </script>
+
