+    /* Seasonal Favorites Carousel */
+    .carousel {
+      --item-width: min(280px, 75%);
+      display: flex;
+      gap: 30px;
+      margin-top: 20px;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      -webkit-overflow-scrolling: touch;
+      /* Side padding lets the first/last items reach the center; vertical
+         padding leaves room for the scaled-up card and its shadow. */
+      padding: 40px calc(50% - var(--item-width) / 2);
+    }
+
+    .carousel:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      transition: transform 0.3s ease, background-color 0.3s ease,
+        box-shadow 0.3s ease, color 0.3s ease;
+    }
+
+    /* Snapped card: native scroll-state queries, with a JS class fallback */
+    .carousel-item.is-snapped .card {
+      transform: scale(1.15);
+      background-color: #007bff;
+      color: white;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
+    }
+
+    .carousel-item.is-snapped .card h3 {
+      color: white;
+    }
+
+    @container scroll-state(snapped: x) {
+      .card {
+        transform: scale(1.15);
+        background-color: #007bff;
+        color: white;
+        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
+      }
+
+      .card h3 {
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card,
+      .carousel-item.is-snapped .card {
+        transition: none;
+        transform: none;
+        background-color: #e0e0e0;
+        color: var(--text);
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: var(--primary);
+      }
+
+      @container scroll-state(snapped: x) {
+        .card {
+          transition: none;
+          transform: none;
+          background-color: #e0e0e0;
+          color: var(--text);
+        }
+
+        .card h3 {
+          color: var(--primary);
+        }
+      }
+    }
