+    /* Toast notifications
+       Each toast is its own manual popover, so it is promoted to the browser's
+       top layer (above everything, no z-index needed). All visible toasts share
+       one anchor-name; each toast anchors to the most recent toast shown before
+       it, so they stack upward in pure CSS with no wrapper or JS positioning. */
+    .toast {
+      position: fixed;
+      inset: auto;
+      right: 1rem;
+      bottom: 1rem;
+      bottom: calc(anchor(top, 0.25rem) + 0.75rem);
+      margin: 0;
+      anchor-name: --toast;
+      position-anchor: --toast;
+
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-width: 220px;
+      padding: 0.75rem 0.75rem 0.75rem 1rem;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 6px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
+
+      opacity: 0;
+      transform: translateX(110%);
+      transition:
+        opacity 0.3s ease,
+        transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
+        overlay 0.3s allow-discrete,
+        display 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(110%);
+      }
+    }
+
+    .toast-message {
+      flex: 1;
+      font-weight: 600;
+    }
+
+    .toast-close {
+      background: none;
+      border: none;
+      color: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      padding: 0.25rem 0.4rem;
+      border-radius: 4px;
+      cursor: pointer;
+      opacity: 0.8;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      opacity: 1;
+      background: rgba(255, 255, 255, 0.15);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transform: none;
+        transition-duration: 0.01s;
+      }
+
+      @starting-style {
+        .toast:popover-open {
+          transform: none;
+        }
+      }
+    }
   </style>
