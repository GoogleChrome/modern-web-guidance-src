+    /* Toast Notifications
+       Each toast is its own popover="manual" element appended directly to <body>,
+       so it renders in the top layer (no z-index needed) and never light-dismisses. */
+    .toast {
+      --toast-height: 3.5rem;
+      --toast-gap: 0.75rem;
+      --toast-index: 0; /* 0 = newest; each newer toast pushes this one up a slot */
+      position: fixed;
+      inset: auto 1.5rem 1.5rem auto;
+      margin: 0;
+      width: min(20rem, calc(100vw - 3rem));
+      height: var(--toast-height);
+      padding: 0 0.5rem 0 1rem;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      background: var(--primary);
+      color: white;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 6px;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+      /* Closed / exit state */
+      opacity: 0;
+      transform: translateX(calc(100% + 1.5rem));
+      translate: 0 calc(var(--toast-index) * -1 * (var(--toast-height) + var(--toast-gap)));
+      transition-property: opacity, transform, translate, display, overlay;
+      transition-duration: 0.35s;
+      transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+      transition-behavior: allow-discrete;
+    }
+
+    /* Stack offset: toasts are always the last children of <body>, so the number
+       of toasts after this one is sibling-count() - sibling-index(). */
+    @supports (order: sibling-index()) {
+      .toast {
+        --toast-index: calc(sibling-count() - sibling-index());
+      }
+    }
+
+    @supports not (order: sibling-index()) {
+      .toast:has(~ .toast) { --toast-index: 1; }
+      .toast:has(~ .toast ~ .toast) { --toast-index: 2; }
+      .toast:has(~ .toast ~ .toast ~ .toast) { --toast-index: 3; }
+      .toast:has(~ .toast ~ .toast ~ .toast ~ .toast) { --toast-index: 4; }
+      .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --toast-index: 5; }
+    }
+
+    .toast:is(:popover-open, .\:popover-open) {
+      display: flex;
+    }
+
+    /* [data-closing] lets browsers without display/overlay transitions run the exit animation */
+    .toast:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+      opacity: 1;
+      transform: none;
+    }
+
+    @starting-style {
+      .toast:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+        opacity: 0;
+        transform: translateX(calc(100% + 1.5rem));
+      }
+    }
+
+    .toast-close {
