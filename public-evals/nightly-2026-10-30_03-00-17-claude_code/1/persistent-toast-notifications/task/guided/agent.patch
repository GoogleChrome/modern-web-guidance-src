+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+  </script>
+
+  <script>
+    const TOAST_DURATION = 3000;
+    let toastCount = 0;
+    let supportsDisplayTransition;
+
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    function animationsSettled(element) {
+      const animations = element.getAnimations({ subtree: true });
+      if (animations.length === 0) return Promise.resolve();
+      return Promise.race([
+        Promise.allSettled(animations.map((a) => a.finished)),
+        new Promise((resolve) => setTimeout(resolve, 2000)),
+      ]);
+    }
+
+    async function closeToast(toast) {
+      if (toast.closing) return;
+      toast.closing = true;
+      clearTimeout(toast.timer);
+      if (!supportsTopLayerExit()) {
+        // Run the exit transition while the toast is still in the top layer
+        toast.setAttribute('data-closing', '');
+        await animationsSettled(toast);
+      }
+      toast.hidePopover();
+    }
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.id = `toast-${++toastCount}`;
+      toast.className = 'toast';
+      toast.setAttribute('popover', 'manual');
+      toast.setAttribute('role', 'status');
+
+      const text = document.createElement('span');
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('popovertarget', toast.id);
+      close.setAttribute('popovertargetaction', 'hide');
+      close.setAttribute('aria-label', 'Close notification');
+      close.textContent = '×';
+      close.addEventListener('click', (event) => {
+        // Native hide skips the exit animation in browsers that need the fallback
+        if (!supportsTopLayerExit()) {
+          event.preventDefault();
+          closeToast(toast);
+        }
+      });
+
+      toast.append(text, close);
+      toast.addEventListener('toggle', async (event) => {
+        if (event.newState !== 'closed') return;
+        toast.closing = true;
+        clearTimeout(toast.timer);
+        await animationsSettled(toast);
+        toast.remove();
+      });
+
+      // Appended last so toasts stay the final children of <body> for sibling-index() stacking
+      document.body.append(toast);
+      toast.showPopover();
+      toast.timer = setTimeout(() => closeToast(toast), TOAST_DURATION);
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach((button) => {
+      button.addEventListener('click', () => showToast('Added to cart!'));
+    });
+  </script>
