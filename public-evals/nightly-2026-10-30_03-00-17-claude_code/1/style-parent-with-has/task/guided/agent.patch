+  <section class="contact" aria-labelledby="contact-heading">
+    <h2 id="contact-heading">Get in Touch</h2>
+    <form action="/contact" method="post">
+      <div class="field">
+        <label for="contact-name">Name *</label>
+        <input type="text" id="contact-name" name="name" autocomplete="name" required
+          aria-errormessage="contact-name-error">
+        <div id="contact-name-error" class="error-msg">
+          <span aria-hidden="true">&#10060;</span> Please enter your name.
+        </div>
+      </div>
+      <div class="field">
+        <label for="contact-email">Email *</label>
+        <input type="email" id="contact-email" name="email" autocomplete="email" required
+          aria-errormessage="contact-email-error">
+        <div id="contact-email-error" class="error-msg">
+          <span aria-hidden="true">&#10060;</span> Please enter a valid email address.
+        </div>
+      </div>
+      <div class="field">
+        <label for="contact-message">Message *</label>
+        <textarea id="contact-message" name="message" rows="5" required
+          aria-errormessage="contact-message-error"></textarea>
+        <div id="contact-message-error" class="error-msg">
+          <span aria-hidden="true">&#10060;</span> Please enter a message.
+        </div>
+      </div>
+      <button type="submit" class="btn">Send Message</button>
+    </form>
+  </section>
+
+  <script>
+    // Visual error state is pure CSS; this only mirrors it to aria-invalid for screen readers.
+    const contactForm = document.querySelector('.contact form');
+    const syncAria = (el) => {
+      if (el.matches?.('input, textarea')) {
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      }
+    };
+    contactForm.addEventListener('blur', (e) => syncAria(e.target), true);
+    contactForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    // A failed submit marks every invalid field as user-invalid
+    contactForm.addEventListener('invalid', (e) => e.target.setAttribute('aria-invalid', 'true'), true);
+  </script>
+
