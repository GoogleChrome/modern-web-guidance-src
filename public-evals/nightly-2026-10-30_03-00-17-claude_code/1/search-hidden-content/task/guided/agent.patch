+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const revealBtn = document.getElementById('reveal-coupon');
+
+    function markCouponRevealed() {
+      revealBtn.setAttribute('aria-expanded', 'true');
+      revealBtn.disabled = true;
+      revealBtn.textContent = 'Coupon Revealed';
+    }
+
+    revealBtn.addEventListener('click', () => {
+      couponPanel.hidden = false;
+      markCouponRevealed();
+      couponPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    });
+
+    // Find-in-page reveals the panel natively; keep the button in sync.
+    couponPanel.addEventListener('beforematch', markCouponRevealed);
+
+    // Browsers without hidden="until-found" would hide the code from search, so show it up front.
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      couponPanel.removeAttribute('hidden');
+      markCouponRevealed();
+    }
+  </script>
