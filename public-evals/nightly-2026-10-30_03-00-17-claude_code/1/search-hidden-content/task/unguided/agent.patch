+  <script>
+    // Coupon: once revealed (by click or by find-in-page), it stays revealed.
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponBtn = document.querySelector('.coupon-btn');
+
+    function markCouponRevealed() {
+      couponBtn.disabled = true;
+      couponBtn.textContent = 'Coupon Revealed';
+      couponBtn.setAttribute('aria-expanded', 'true');
+    }
+
+    couponBtn.addEventListener('click', () => {
+      couponPanel.hidden = false;
+      markCouponRevealed();
+      couponPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    });
+
+    // Fired when find-in-page reveals the panel (the browser removes `hidden` itself).
+    couponPanel.addEventListener('beforematch', markCouponRevealed);
+
+    // Tabs: keep one tab open at all times (clicking the active tab won't close it).
+    document.querySelectorAll('.wholesale-tab summary').forEach((summary) => {
+      summary.addEventListener('click', (event) => {
+        if (summary.parentElement.open) event.preventDefault();
+      });
+    });
+  </script>
+
