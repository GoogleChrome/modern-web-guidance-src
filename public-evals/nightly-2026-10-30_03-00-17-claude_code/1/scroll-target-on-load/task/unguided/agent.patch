+    /* Vertical media scroller */
+    .media-scroller {
+      position: relative; /* makes card offsetTop relative to the scroller */
+      height: 420px;
+      max-width: 640px;
+      margin: 20px auto 0;
+      padding: 16px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: none;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 640 / 400; /* reserve space so layout is stable before images load */
+      object-fit: cover;
+      background: #efebe9;
+    }
+
+    .media-card .media-body {
+      padding: 12px 16px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
