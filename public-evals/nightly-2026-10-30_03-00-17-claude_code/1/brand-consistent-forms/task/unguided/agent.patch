+  <script>
+    (function () {
+      const form = document.getElementById('subscribe-form');
+      const name = document.getElementById('sub-name');
+      const email = document.getElementById('sub-email');
+      const roast = document.getElementById('sub-roast');
+      const roastValue = document.getElementById('roast-value');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const status = document.getElementById('form-status');
+      const roastLabels = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      let roastTouched = false;
+
+      function updateRoast() {
+        const label = roastLabels[roast.value - 1];
+        roastValue.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = (roast.value - roast.min) / (roast.max - roast.min) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        const steps = [
+          name.value.trim() !== '',
+          email.validity.valid && email.value !== '',
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastTouched
+        ];
+        const done = steps.filter(Boolean).length;
+        progress.value = done;
+        progress.textContent = progressText.textContent = done + ' of ' + steps.length + ' steps';
+        return done === steps.length;
+      }
+
+      roast.addEventListener('input', function () {
+        roastTouched = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        roastTouched = true;
+        if (updateProgress()) {
+          status.textContent = 'Thanks, ' + name.value.trim() + '! Your subscription is set up.';
+        } else {
+          status.textContent = 'Please enter your name, a valid email, and a delivery frequency.';
+        }
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
