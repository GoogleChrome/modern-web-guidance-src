+<!doctype html>
+<html lang="en" class="exp-pending">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>Launchpad — Ship faster with less effort</title>
+  <meta name="description" content="Launchpad helps teams plan, build and ship products faster." />
+
+  <!-- Open the connection to the experiment CDN as early as possible. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="dns-prefetch" href="https://cdn.example.com" />
+
+  <!--
+    Anti-flicker guard.
+    This must stay inline and come before any content renders. While <html>
+    has the "exp-pending" class, every element marked [data-experiment] is
+    hidden so the original content never flashes before a variant is applied.
+    Only experiment regions are hidden (not the whole page), and the guard is
+    always removed after a timeout so a slow or failed CDN never leaves the
+    page blank.
+  -->
+  <style>
+    .exp-pending [data-experiment] { opacity: 0 !important; }
+    [data-experiment] { transition: opacity 150ms ease-out; }
+  </style>
+  <script>
+    (function (w, d) {
+      var TIMEOUT_MS = 2500;
+      var root = d.documentElement;
+      var revealed = false;
+
+      function reveal() {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(timer);
+        root.classList.remove('exp-pending');
+      }
+
+      // Safety net: never hide content longer than TIMEOUT_MS.
+      var timer = setTimeout(reveal, TIMEOUT_MS);
+
+      // The SDK (or its config) can call this once variants are applied.
+      // It is idempotent, so calling it more than once is harmless.
+      w.revealExperiment = reveal;
+
+      var s = d.createElement('script');
+      s.src = 'https://cdn.example.com/experiment-sdk.js';
+      s.async = true;
+      s.crossOrigin = 'anonymous';
+      s.onload = function () {
+        // If the SDK exposes a readiness promise, wait for it; otherwise its
+        // synchronous DOM changes are already done when onload fires.
+        var sdk = w.ExperimentSDK || w.experimentSDK;
+        var ready = sdk && sdk.ready;
+        if (typeof ready === 'function') ready = ready.call(sdk);
+        if (ready && typeof ready.then === 'function') {
+          ready.then(reveal, reveal);
+        } else {
+          // Let any DOM mutations queued by the SDK flush before revealing.
+          w.requestAnimationFrame(reveal);
+        }
+      };
+      s.onerror = reveal;
+      d.head.appendChild(s);
+    })(window, document);
+  </script>
+  <noscript>
+    <style>.exp-pending [data-experiment] { opacity: 1 !important; }</style>
+  </noscript>
+
+  <style>
