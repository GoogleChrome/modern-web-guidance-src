+  <script>
+    (function () {
+      var map = document.getElementById('cafe-map');
+      if (!map) return;
+
+      var DRAG_THRESHOLD = 5;
+      var pointerId = null;
+      var startX = 0, startY = 0, lastX = 0, lastY = 0, lastT = 0;
+      var velX = 0, velY = 0;
+      var dragging = false;
+      var suppressClick = false;
+      var inertiaFrame = null;
+
+      // Start centered on the surface
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+
+      function stopInertia() {
+        if (inertiaFrame !== null) {
+          cancelAnimationFrame(inertiaFrame);
+          inertiaFrame = null;
+        }
+      }
+
+      map.addEventListener('pointerdown', function (e) {
+        if (pointerId !== null || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        stopInertia();
+        pointerId = e.pointerId;
+        startX = lastX = e.clientX;
+        startY = lastY = e.clientY;
+        lastT = e.timeStamp;
+        velX = velY = 0;
+        dragging = false;
+        suppressClick = false;
+      });
+
+      map.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== pointerId) return;
+
+        if (!dragging) {
+          if (Math.hypot(e.clientX - startX, e.clientY - startY) < DRAG_THRESHOLD) return;
+          // Capture only once a drag starts so taps on pins still register as clicks
+          dragging = true;
+          suppressClick = true;
+          map.classList.add('dragging');
+          map.setPointerCapture(pointerId);
+        }
+
+        var dx = e.clientX - lastX;
+        var dy = e.clientY - lastY;
+        var dt = Math.max(e.timeStamp - lastT, 1);
+
+        // Move both axes together so diagonal and direction changes are followed exactly
+        map.scrollLeft -= dx;
+        map.scrollTop -= dy;
+
+        velX = 0.8 * (dx / dt) + 0.2 * velX;
+        velY = 0.8 * (dy / dt) + 0.2 * velY;
+        lastX = e.clientX;
+        lastY = e.clientY;
+        lastT = e.timeStamp;
+      });
+
+      function endDrag(e) {
+        if (e.pointerId !== pointerId) return;
+        pointerId = null;
+        if (!dragging) return;
+        dragging = false;
+        map.classList.remove('dragging');
+
+        // Ignore stale velocity if the pointer paused before release
+        if (e.timeStamp - lastT > 80) return;
+
+        var vx = velX * 16, vy = velY * 16;
+        (function step() {
+          vx *= 0.94;
+          vy *= 0.94;
+          if (Math.abs(vx) < 0.3 && Math.abs(vy) < 0.3) {
+            inertiaFrame = null;
+            return;
+          }
+          map.scrollLeft -= vx;
+          map.scrollTop -= vy;
+          inertiaFrame = requestAnimationFrame(step);
+        })();
+      }
+
+      map.addEventListener('pointerup', endDrag);
+      map.addEventListener('pointercancel', endDrag);
+      map.addEventListener('wheel', stopInertia, { passive: true });
+
+      // Don't follow a pin link when the gesture was a drag
+      map.addEventListener('click', function (e) {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+          suppressClick = false;
+        }
+      }, true);
+
+      map.addEventListener('dragstart', function (e) {
+        e.preventDefault();
+      });
+    })();
+  </script>
+
