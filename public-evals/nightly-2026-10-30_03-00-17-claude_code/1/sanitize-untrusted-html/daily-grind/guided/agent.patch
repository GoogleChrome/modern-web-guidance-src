+  <script type="module">
+    // Formatting-only allowlist shared by the native Sanitizer and the DOMPurify fallback.
+    const REVIEW_ELEMENTS = ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'ul', 'ol', 'li', 'blockquote'];
+    const STORAGE_KEY = 'daily-grind-reviews';
+    const DOMPURIFY_URL = 'https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.es.mjs';
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      // Only browsers without the native Sanitizer API download DOMPurify.
+      domPurifyPromise ??= import(DOMPURIFY_URL).then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // setHTML() always strips XSS-unsafe markup; the config narrows it further.
+        el.setHTML(html, { sanitizer: { elements: REVIEW_ELEMENTS, attributes: [] } });
+        return;
+      }
+      try {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+          ALLOWED_ATTR: [],
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      } catch {
+        // No sanitizer available: show the raw markup as plain text rather than risk XSS.
+        el.textContent = html;
+      }
+    }
+
+    const seedReviews = [
+      { drink: 'maple-oat-latte', name: 'Priya', html: 'The <strong>perfect</strong> autumn drink. Not too sweet!' },
+      { drink: 'dark-roast-espresso', name: 'Marcus', html: '<p>Rich and <em>intense</em>.</p><ul><li>Great crema</li><li>Smoky finish</li></ul>' },
+      { drink: 'cold-brew', name: 'Jen', html: '<blockquote>Smoothest cold brew in town.</blockquote>' }
+    ];
+
+    function loadReviews() {
+      try {
+        return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? seedReviews;
+      } catch {
+        return seedReviews;
+      }
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch {
+        // Storage unavailable (e.g. private mode); reviews last for this page view only.
+      }
+    }
+
+    let reviews = loadReviews();
+
+    async function renderReviews() {
+      for (const list of document.querySelectorAll('.review-list')) {
+        const items = reviews.filter((r) => r.drink === list.dataset.drink);
+        const nodes = await Promise.all(items.map(async (review) => {
+          const li = document.createElement('li');
+          li.className = 'review';
+          const author = document.createElement('span');
+          author.className = 'review-author';
+          author.textContent = review.name;
+          const body = document.createElement('div');
+          body.className = 'review-body';
+          // Raw input is stored as-is and sanitized every time it is rendered.
+          await safeSetHTML(body, review.html);
+          li.append(author, body);
+          return li;
+        }));
+
+        if (nodes.length === 0) {
+          const empty = document.createElement('li');
+          empty.className = 'review-empty';
+          empty.textContent = 'No reviews yet. Be the first!';
+          nodes.push(empty);
+        }
+        list.replaceChildren(...nodes);
+      }
+    }
+
+    const form = document.getElementById('review-form');
+    const status = document.getElementById('review-status');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const review = {
+        drink: data.get('drink'),
+        name: data.get('name').trim(),
+        html: data.get('review').trim()
+      };
+      if (!review.name || !review.html) {
+        status.textContent = 'Please enter your name and a review.';
+        return;
+      }
+
+      reviews = [...reviews, review];
+      saveReviews(reviews);
+      await renderReviews();
+      form.reset();
+      status.textContent = 'Thanks! Your review has been posted.';
+    });
+
+    renderReviews();
+  </script>
+
 </body>
 
