diff --git a/reviews.js b/reviews.js
new file mode 100644
index 0000000..2c48067
--- /dev/null
+++ b/reviews.js
@@ -0,0 +1,261 @@
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'dailyGrindReviews';
+  var DRINKS = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'];
+  var MAX_BODY_LENGTH = 2000;
+
+  /* ---------- Sanitizer ----------
+   * Untrusted markup is parsed with DOMParser into an inert document: scripts
+   * never run, event handlers never fire, and resources never load there.
+   * We then walk that tree and *rebuild* a brand-new fragment in the live
+   * document using only allowlisted elements and attributes. The result is
+   * inserted as DOM nodes, never re-serialized to a string, so there is no
+   * second parse that could be exploited (mutation XSS).
+   */
+
+  // Elements that are kept (with their allowed attributes).
+  var ALLOWED_ELEMENTS = {
+    p: [], br: [], strong: [], b: [], em: [], i: [], u: [], s: [],
+    ul: [], ol: [], li: [], blockquote: [], code: [],
+    a: ['href', 'title']
+  };
+
+  // Elements dropped together with everything inside them. Any other
+  // non-allowlisted element (e.g. <div>, <span>, <font>) is unwrapped:
+  // the tag is removed but its sanitized children are kept.
+  var DROP_WITH_CONTENT = {
+    script: 1, style: 1, iframe: 1, frame: 1, frameset: 1, object: 1,
+    embed: 1, applet: 1, noscript: 1, noembed: 1, noframes: 1, template: 1,
+    svg: 1, math: 1, form: 1, input: 1, button: 1, select: 1, textarea: 1,
+    option: 1, link: 1, meta: 1, base: 1, title: 1, head: 1, img: 1,
+    video: 1, audio: 1, source: 1, track: 1, picture: 1, canvas: 1,
+    xmp: 1, plaintext: 1, dialog: 1, portal: 1
+  };
+
+  var SAFE_URL_PROTOCOLS = { 'http:': 1, 'https:': 1, 'mailto:': 1 };
+  var MAX_DEPTH = 20;
+
+  function safeUrl(value) {
+    try {
+      var url = new URL(value.trim(), window.location.href);
+      return SAFE_URL_PROTOCOLS[url.protocol] ? url.href : null;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  function sanitizeChildren(source, target, depth) {
+    for (var node = source.firstChild; node; node = node.nextSibling) {
+      if (node.nodeType === Node.TEXT_NODE) {
+        target.appendChild(document.createTextNode(node.nodeValue));
+        continue;
+      }
+      // Comments, processing instructions, etc. are discarded.
+      if (node.nodeType !== Node.ELEMENT_NODE) continue;
+
+      // Only HTML-namespace elements are considered; anything foreign is dropped.
+      if (node.namespaceURI !== 'http://www.w3.org/1999/xhtml') continue;
+
+      var tag = node.localName;
+      if (DROP_WITH_CONTENT[tag]) continue;
+
+      if (depth >= MAX_DEPTH) {
+        target.appendChild(document.createTextNode(node.textContent));
+        continue;
+      }
+
+      if (!Object.prototype.hasOwnProperty.call(ALLOWED_ELEMENTS, tag)) {
+        sanitizeChildren(node, target, depth + 1);
+        continue;
+      }
+
+      var clean = document.createElement(tag);
+      var allowedAttrs = ALLOWED_ELEMENTS[tag];
+      for (var i = 0; i < allowedAttrs.length; i++) {
+        var name = allowedAttrs[i];
+        if (!node.hasAttribute(name)) continue;
+        var value = node.getAttribute(name);
+        if (name === 'href') {
+          value = safeUrl(value);
+          if (value === null) continue;
+        }
+        clean.setAttribute(name, value);
+      }
+      if (tag === 'a') {
+        clean.setAttribute('rel', 'noopener noreferrer nofollow ugc');
+        clean.setAttribute('target', '_blank');
+      }
+
+      sanitizeChildren(node, clean, depth + 1);
+      target.appendChild(clean);
+    }
+  }
+
+  function sanitizeHtml(untrusted) {
+    var doc = new DOMParser().parseFromString(String(untrusted), 'text/html');
+    var fragment = document.createDocumentFragment();
+    sanitizeChildren(doc.body, fragment, 0);
+    return fragment;
+  }
+
+  function renderSafe(container, untrusted) {
+    container.replaceChildren(sanitizeHtml(untrusted));
+  }
+
+  /* ---------- Storage ---------- */
+
+  var SEED_REVIEWS = [
+    {
+      drink: 'Maple Oat Latte', name: 'Priya S.', rating: 5, date: '2026-10-21',
+      body: '<p>Perfectly <strong>cozy</strong>. The maple is subtle, not syrupy.</p><ul><li>Great with extra foam</li><li>Ask for it extra hot</li></ul>'
+    },
+    {
+      drink: 'Dark Roast Espresso', name: 'Marco D.', rating: 4, date: '2026-10-18',
+      body: '<p>Bold and <em>smoky</em> as advertised.</p><blockquote>Best shot on this side of town.</blockquote>'
+    },
+    {
+      drink: 'Cold Brew', name: 'Alex K.', rating: 5, date: '2026-10-12',
+      body: '<p>So smooth I skipped the milk. The <code>18 hour</code> steep really shows.</p>'
+    }
+  ];
+
+  function isValidReview(r) {
+    return r && typeof r === 'object' &&
+      DRINKS.indexOf(r.drink) !== -1 &&
+      typeof r.name === 'string' &&
+      typeof r.body === 'string' &&
+      typeof r.date === 'string' &&
+      r.rating >= 1 && r.rating <= 5;
+  }
+
+  function loadReviews() {
+    try {
+      var stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+      if (Array.isArray(stored)) return stored.filter(isValidReview);
+    } catch (e) { /* fall through to seed data */ }
+    return SEED_REVIEWS.slice();
+  }
+
+  function saveReviews(reviews) {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+    } catch (e) { /* storage unavailable; keep in memory only */ }
+  }
+
+  /* ---------- Rendering ---------- */
+
+  var reviews = loadReviews();
+  var activeDrink = '';
+
+  var form = document.getElementById('review-form');
+  var bodyInput = document.getElementById('review-body');
+  var preview = document.getElementById('review-preview');
+  var list = document.getElementById('review-list');
+  var filter = document.getElementById('review-filter');
+
+  function stars(rating) {
+    var n = Math.max(1, Math.min(5, Math.round(rating)));
+    return '★'.repeat(n) + '☆'.repeat(5 - n);
+  }
+
+  function renderReview(review) {
+    var item = document.createElement('li');
+    item.className = 'review';
+
+    var meta = document.createElement('div');
+    meta.className = 'review-meta';
+
+    var who = document.createElement('span');
+    var name = document.createElement('strong');
+    name.textContent = review.name;
+    who.append(name, ' on ' + review.drink);
+
+    var right = document.createElement('span');
+    var starEl = document.createElement('span');
+    starEl.className = 'review-stars';
+    starEl.textContent = stars(review.rating);
+    starEl.setAttribute('aria-label', review.rating + ' out of 5 stars');
+    right.append(starEl, ' · ' + review.date);
+
+    meta.append(who, right);
+
+    var body = document.createElement('div');
+    body.className = 'review-body';
+    renderSafe(body, review.body);
+
+    item.append(meta, body);
+    return item;
+  }
+
+  function renderList() {
+    var visible = reviews.filter(function (r) {
+      return !activeDrink || r.drink === activeDrink;
+    });
+
+    if (visible.length === 0) {
+      var empty = document.createElement('li');
+      empty.className = 'review-empty';
+      empty.textContent = 'No reviews yet. Be the first!';
+      list.replaceChildren(empty);
+    } else {
+      list.replaceChildren.apply(list, visible.map(renderReview));
+    }
+
+    document.querySelectorAll('[data-review-count]').forEach(function (el) {
+      var drink = el.getAttribute('data-review-count');
+      var count = reviews.filter(function (r) { return r.drink === drink; }).length;
+      el.textContent = count + (count === 1 ? ' review' : ' reviews');
+    });
+  }
+
+  function updatePreview() {
+    renderSafe(preview, bodyInput.value);
+  }
+
+  /* ---------- Events ---------- */
+
+  bodyInput.addEventListener('input', updatePreview);
+
+  filter.addEventListener('click', function (event) {
+    var button = event.target.closest('button[data-drink]');
+    if (!button) return;
+    activeDrink = button.getAttribute('data-drink');
+    filter.querySelectorAll('button').forEach(function (b) {
+      b.setAttribute('aria-pressed', String(b === button));
+    });
+    renderList();
+  });
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    var drink = form.elements.drink.value;
+    var name = form.elements.name.value.trim().slice(0, 40);
+    var rating = parseInt(form.elements.rating.value, 10);
+    var body = bodyInput.value.slice(0, MAX_BODY_LENGTH);
+
+    // Require some visible text after sanitization.
+    if (!name || !sanitizeHtml(body).textContent.trim()) {
+      (name ? bodyInput : form.elements.name).focus();
+      return;
+    }
+
+    // The raw markup is stored and re-sanitized on every render, so any
+    // future tightening of the allowlist also applies to existing reviews.
+    reviews.unshift({
+      drink: drink,
+      name: name,
+      rating: rating,
+      body: body,
+      date: new Date().toISOString().slice(0, 10)
+    });
+    saveReviews(reviews);
+
+    form.reset();
+    updatePreview();
+    renderList();
+  });
+
+  renderList();
+})();
