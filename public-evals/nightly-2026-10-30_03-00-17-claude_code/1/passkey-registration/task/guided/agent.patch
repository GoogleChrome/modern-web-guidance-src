+  <script type="module">
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusEl = document.querySelector('.passkey-status');
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    // Older browsers lack the WebAuthn JSON helpers; load the polyfill only when needed.
+    async function ensureWebAuthnJSONSupport() {
+      if (
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+    }
+
+    async function isPasskeyCreationSupported() {
+      if (!window.isSecureContext || typeof window.PublicKeyCredential === 'undefined') {
+        return false;
+      }
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet);
+      }
+      // Fallback for browsers without getClientCapabilities()
+      const [platform, conditional] = await Promise.all([
+        PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.() ?? false,
+        PublicKeyCredential.isConditionalMediationAvailable?.() ?? false,
+      ]);
+      return Boolean(platform && conditional);
+    }
+
+    async function signalUnknownCredential(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function registerPasskey() {
+      registerButton.disabled = true;
+      setStatus('');
+
+      try {
+        await ensureWebAuthnJSONSupport();
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ promotion: true }),
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Failed to fetch registration options (${optionsResponse.status})`);
+        }
+        const creationOptionsJSON = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+        const rpId = creationOptionsJSON.rp?.id ?? location.hostname;
+
+        let credential;
+        try {
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (err) {
+          switch (err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey already exists for this account on this device.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled.');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.');
+              break;
+            case 'SecurityError':
+              console.error('Passkey RP ID or secure context misconfiguration:', err);
+              setStatus('Passkeys are not available on this site right now.', 'error');
+              break;
+            default:
+              console.error('Passkey creation failed:', err);
+              setStatus('Something went wrong while creating your passkey.', 'error');
+          }
+          // Standard WebAuthn failures: no credential was created, so nothing to signal.
+          return;
+        }
+
+        const encodedCredential = credential.toJSON();
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'same-origin',
+            body: JSON.stringify(encodedCredential),
+          });
+          if (!verifyResponse.ok) {
+            throw new Error(`Registration verification failed (${verifyResponse.status})`);
+          }
+        } catch (err) {
+          console.error('Passkey verification failed:', err);
+          // The passkey exists in the provider but not on the server; ask the provider to remove it.
+          await signalUnknownCredential(rpId, encodedCredential.id);
+          setStatus('We couldn’t save your passkey. Please try again.', 'error');
+          return;
+        }
+
+        setStatus('Your passkey has been created. You can now use it to sign in.', 'success');
+      } catch (err) {
+        console.error('Passkey registration failed:', err);
+        setStatus('Something went wrong while creating your passkey.', 'error');
+      } finally {
+        registerButton.disabled = false;
+      }
+    }
+
+    if (await isPasskeyCreationSupported().catch(() => false)) {
+      registerButton.disabled = false;
+      registerButton.addEventListener('click', registerPasskey);
+    } else {
+      registerButton.closest('.passkey-promo').hidden = true;
+    }
+  </script>
+
 </body>
 
