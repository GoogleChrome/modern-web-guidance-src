diff --git a/js/site.js b/js/site.js
new file mode 100644
index 0000000..878b58e
--- /dev/null
+++ b/js/site.js
@@ -0,0 +1,23 @@
+// Non-critical behaviour, loaded with `defer` so it never delays first render
+// or a view transition. The initial theme is applied by the inline script in
+// each page's <head>.
+(function () {
+  var root = document.documentElement;
+  var toggle = document.querySelector('.theme-toggle');
+
+  function label() {
+    toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
+  }
+
+  if (toggle) {
+    label();
+    toggle.addEventListener('click', function () {
+      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
+      root.dataset.theme = next;
+      try {
+        localStorage.setItem('dg-theme', next);
+      } catch (e) {}
+      label();
+    });
+  }
+})();
