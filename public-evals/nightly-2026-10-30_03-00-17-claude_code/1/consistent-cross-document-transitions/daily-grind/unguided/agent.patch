+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Initial theme: runs synchronously before first paint so the page (and any
+       incoming view transition snapshot) never flashes the wrong theme. -->
+  <script>
+    (function () {
+      var theme;
+      try { theme = localStorage.getItem('dg-theme'); } catch (e) {}
+      if (theme !== 'light' && theme !== 'dark') {
+        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+      document.documentElement.dataset.theme = theme;
+    })();
+  </script>
+
+  <!-- Critical styles (render-blocking), including the @view-transition opt-in. -->
+  <link rel="stylesheet" href="/css/site.css">
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80">
+
+  <!-- Hold first render (and thus the view transition) until everything up to
+       #location-list has been parsed. Content after it, like the footer, is not waited on. -->
+  <link rel="expect" href="#location-list" blocking="render">
+
+  <script src="/js/site.js" defer></script>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--compact" style="--hero-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80')">
+    <h1>Find Your Daily Grind</h1>
+    <p>Neighborhood cafés with the same great roast.</p>
+  </header>
+
+  <main class="container page-content">
+    <section id="location-list" aria-labelledby="location-list-title">
+      <h2 id="location-list-title" class="section-title">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p><address>120 Main Street<br>Burlington, VT</address></p>
+          <p class="hours">Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>Old North End</h3>
+          <p><address>48 North Avenue<br>Burlington, VT</address></p>
+          <p class="hours">Daily 6:30am–5pm</p>
+        </div>
+        <div class="card">
+          <h3>South End Roastery</h3>
+          <p><address>305 Pine Street<br>Burlington, VT</address></p>
+          <p class="hours">Mon–Sat 7am–4pm · Roastery tours Sat 10am</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
