+  <script>
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const defaultText = 'Select a drink to preview';
+
+      const show = (source) => {
+        const drink = source?.dataset.drink;
+        if (!drink) return;
+        preview.textContent = drink;
+        preview.classList.add('is-previewing');
+      };
+
+      const reset = () => {
+        preview.textContent = defaultText;
+        preview.classList.remove('is-previewing');
+      };
+
+      if ('interestForElement' in HTMLAnchorElement.prototype) {
+        // Interest invokers: the browser handles hover/focus/long-press on every
+        // [interestfor] link and fires these events on the shared target.
+        preview.addEventListener('interest', (e) => show(e.source));
+        preview.addEventListener('loseinterest', reset);
+      } else {
+        // Fallback for browsers without interestfor: one delegated set of listeners.
+        const sel = '[interestfor="seasonal-preview"]';
+        const grid = preview.previousElementSibling;
+        const enter = (e) => show(e.target.closest(sel));
+        const leave = (e) => {
+          const from = e.target.closest(sel);
+          if (from && !from.contains(e.relatedTarget)) reset();
+        };
+        grid.addEventListener('mouseover', enter);
+        grid.addEventListener('mouseout', leave);
+        grid.addEventListener('focusin', enter);
+        grid.addEventListener('focusout', leave);
+      }
+    })();
+  </script>
+
 </body>
 
