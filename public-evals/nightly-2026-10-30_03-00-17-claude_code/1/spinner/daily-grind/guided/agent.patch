+  <div id="loading-status" class="visually-hidden" role="status"></div>
+
+  <script>
+    const loadingStatus = document.getElementById('loading-status');
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-loading-label]');
+      // Let modified clicks (new tab/window) through without a busy state
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      if (link.getAttribute('aria-disabled') === 'true') {
+        event.preventDefault();
+        return;
+      }
+
+      const label = link.dataset.loadingLabel;
+      const spinner = document.createElement('progress');
+      spinner.className = 'loading-spinner';
+      spinner.setAttribute('aria-label', label);
+
+      link.setAttribute('aria-disabled', 'true');
+      link.classList.add('is-loading');
+      link.prepend(spinner);
+      loadingStatus.textContent = `${label}…`;
+    });
+
+    // Reset busy state when the page is restored from the back/forward cache
+    window.addEventListener('pageshow', (event) => {
+      if (!event.persisted) return;
+      for (const link of document.querySelectorAll('a.is-loading')) {
+        link.querySelector('.loading-spinner')?.remove();
+        link.classList.remove('is-loading');
+        link.removeAttribute('aria-disabled');
+      }
+      loadingStatus.textContent = '';
+    });
+  </script>
+
 </body>
 
