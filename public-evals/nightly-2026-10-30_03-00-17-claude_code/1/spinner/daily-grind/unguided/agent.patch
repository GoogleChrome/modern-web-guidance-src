+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var buttons = document.querySelectorAll('.btn[data-loading-label]');
+
+      function setLoading(btn) {
+        btn.dataset.originalLabel = btn.textContent;
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.textContent = '';
+        var spinner = document.createElement('span');
+        spinner.className = 'spinner';
+        spinner.setAttribute('aria-hidden', 'true');
+        btn.append(spinner, btn.dataset.loadingLabel);
+        status.textContent = btn.dataset.loadingMessage;
+      }
+
+      function reset(btn) {
+        if (btn.getAttribute('aria-busy') !== 'true') return;
+        btn.removeAttribute('aria-busy');
+        btn.removeAttribute('aria-disabled');
+        btn.textContent = btn.dataset.originalLabel;
+      }
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          // Let modified clicks open new tabs/windows without a busy state
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (btn.getAttribute('aria-busy') === 'true') {
+            e.preventDefault();
+            return;
+          }
+          setLoading(btn);
+        });
+      });
+
+      // Clear the busy state when returning via the back/forward cache
+      window.addEventListener('pageshow', function (e) {
+        if (!e.persisted) return;
+        buttons.forEach(reset);
+        status.textContent = '';
+      });
+    })();
+  </script>
