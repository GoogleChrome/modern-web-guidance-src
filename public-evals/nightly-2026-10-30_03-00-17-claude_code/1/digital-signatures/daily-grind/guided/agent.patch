+  <script type="module">
+    // Signed receipts & gift vouchers.
+    // Prefers post-quantum ML-DSA-65; falls back to Ed25519, then ECDSA P-256.
+    const TOKEN_PREFIX = 'DG1';
+    const VOUCHER_VALIDITY_DAYS = 365;
+    const DB_NAME = 'daily-grind-signing';
+    const STORE = 'keys';
+    const KEY_ID = 'store-signing-key';
+
+    const SUITES = {
+      'ML-DSA-65': {
+        generate: 'ML-DSA-65',
+        publicFormat: 'raw-public',
+        label: 'ML-DSA-65 (post-quantum, FIPS 204)',
+      },
+      Ed25519: {
+        generate: 'Ed25519',
+        sign: 'Ed25519',
+        publicFormat: 'raw',
+        label: 'Ed25519 (classical)',
+      },
+      'ECDSA-P256': {
+        generate: { name: 'ECDSA', namedCurve: 'P-256' },
+        sign: { name: 'ECDSA', hash: 'SHA-256' },
+        publicFormat: 'raw',
+        label: 'ECDSA P-256 / SHA-256 (classical)',
+      },
+    };
+
+    const encoder = new TextEncoder();
+    const decoder = new TextDecoder();
+    const $ = (id) => document.getElementById(id);
+
+    // --- Encoding helpers ---------------------------------------------------
+    function toBase64Url(bytes) {
+      let binary = '';
+      for (const b of bytes) binary += String.fromCharCode(b);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function fromBase64Url(text) {
+      if (!/^[A-Za-z0-9_-]+$/.test(text)) throw new Error('Invalid base64url');
+      const b64 = text.replace(/-/g, '+').replace(/_/g, '/');
+      const binary = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+      return Uint8Array.from(binary, (c) => c.charCodeAt(0));
+    }
+
+    const contextFor = (type) => encoder.encode(`daily-grind/${type}/v1`);
+
+    // --- Key management -----------------------------------------------------
+    function supportsPostQuantumSignatures() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('sign', 'ML-DSA-65') &&
+        SubtleCrypto.supports('generateKey', 'ML-DSA-65')
+      );
+    }
+
+    async function generateSigningKeyPair() {
+      const candidates = supportsPostQuantumSignatures()
+        ? ['ML-DSA-65', 'Ed25519', 'ECDSA-P256']
+        : ['Ed25519', 'ECDSA-P256'];
+      for (const suite of candidates) {
+        try {
+          // Private key is non-extractable; it can sign but never leave the browser.
+          const keyPair = await crypto.subtle.generateKey(SUITES[suite].generate, false, ['sign', 'verify']);
+          return { suite, ...keyPair };
+        } catch {
+          // Try the next suite.
+        }
+      }
+      throw new Error('This browser supports none of ML-DSA-65, Ed25519 or ECDSA P-256.');
+    }
+
+    function openDb() {
+      return new Promise((resolve, reject) => {
+        const req = indexedDB.open(DB_NAME, 1);
+        req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+
+    function idb(mode, op) {
+      return openDb().then((db) => new Promise((resolve, reject) => {
+        const req = op(db.transaction(STORE, mode).objectStore(STORE));
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      }).finally(() => db.close()));
+    }
+
+    async function fingerprint(suite, publicKey) {
+      const raw = await crypto.subtle.exportKey(SUITES[suite].publicFormat, publicKey);
+      const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', raw));
+      return toBase64Url(digest.slice(0, 12));
+    }
+
+    // CryptoKeys are structured-cloneable, so the non-extractable key pair
+    // persists in IndexedDB without its private bytes ever being exposed.
+    async function loadOrCreateStoreKey() {
+      let record = null;
+      try {
+        record = await idb('readonly', (s) => s.get(KEY_ID));
+      } catch {
+        // IndexedDB unavailable (e.g. private mode); use a session-only key.
+      }
+      if (!record || !SUITES[record.suite]) {
+        record = await generateSigningKeyPair();
+        try {
+          await idb('readwrite', (s) => s.put(record, KEY_ID));
+        } catch {
+          // Keep the in-memory key.
+        }
+      }
+      return { ...record, kid: await fingerprint(record.suite, record.publicKey) };
+    }
+
+    // --- Sign / verify ------------------------------------------------------
+    // Classical algorithms ignore `context`, so frame it into the message instead.
+    function frameFallbackInput(payloadBytes, contextBytes) {
+      if (contextBytes.byteLength > 255) {
+        throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+      }
+      const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+      framed[0] = contextBytes.byteLength;
+      framed.set(contextBytes, 1);
+      framed.set(payloadBytes, 1 + contextBytes.byteLength);
+      return framed;
+    }
+
+    async function signPayload(key, payloadBytes, contextBytes) {
+      const sig = key.suite.startsWith('ML-DSA')
+        ? await crypto.subtle.sign({ name: key.suite, context: contextBytes }, key.privateKey, payloadBytes)
+        : await crypto.subtle.sign(SUITES[key.suite].sign, key.privateKey, frameFallbackInput(payloadBytes, contextBytes));
+      return new Uint8Array(sig);
+    }
+
+    function verifyPayload(key, signatureBytes, payloadBytes, contextBytes) {
+      return key.suite.startsWith('ML-DSA')
+        ? crypto.subtle.verify({ name: key.suite, context: contextBytes }, key.publicKey, signatureBytes, payloadBytes)
+        : crypto.subtle.verify(SUITES[key.suite].sign, key.publicKey, signatureBytes, frameFallbackInput(payloadBytes, contextBytes));
+    }
+
+    async function issueDocument(key, { type, name, details, amount }) {
+      const issuedAt = new Date();
+      const payload = {
+        v: 1,
+        type,
+        id: crypto.randomUUID(),
+        name,
+        details,
+        amount: Number(amount).toFixed(2),
+        currency: 'USD',
+        issuedAt: issuedAt.toISOString(),
+        alg: key.suite,
+        kid: key.kid,
+      };
+      if (type === 'voucher') {
+        payload.expiresAt = new Date(issuedAt.getTime() + VOUCHER_VALIDITY_DAYS * 864e5).toISOString();
+      }
+      // Sign the exact serialized bytes so no JSON canonicalization is needed.
+      const payloadBytes = encoder.encode(JSON.stringify(payload));
+      const signature = await signPayload(key, payloadBytes, contextFor(type));
+      return { payload, token: `${TOKEN_PREFIX}.${toBase64Url(payloadBytes)}.${toBase64Url(signature)}` };
+    }
+
+    async function verifyDocument(key, token) {
+      const parts = token.replace(/\s+/g, '').split('.');
+      if (parts.length !== 3 || parts[0] !== TOKEN_PREFIX) {
+        return { status: 'invalid', message: 'This isn’t a Daily Grind document code.' };
+      }
+
+      let payloadBytes, signature, payload;
+      try {
+        payloadBytes = fromBase64Url(parts[1]);
+        signature = fromBase64Url(parts[2]);
+        payload = JSON.parse(decoder.decode(payloadBytes));
+      } catch {
+        return { status: 'invalid', message: 'The code is damaged or incomplete.' };
+      }
+
+      if (payload?.v !== 1 || !['receipt', 'voucher'].includes(payload.type)) {
+        return { status: 'invalid', message: 'Unsupported document format.' };
+      }
+      // Only trust our own key. A key embedded in the code would let anyone forge a document.
+      if (payload.kid !== key.kid || payload.alg !== key.suite) {
+        return { status: 'invalid', message: 'Not signed with The Daily Grind’s signing key.' };
+      }
+
+      let valid = false;
+      try {
+        valid = await verifyPayload(key, signature, payloadBytes, contextFor(payload.type));
+      } catch {
+        valid = false;
+      }
+      if (!valid) {
+        return { status: 'invalid', message: 'Signature check failed. This document has been altered or forged.' };
+      }
+
+      if (payload.type === 'voucher' && Date.parse(payload.expiresAt) < Date.now()) {
+        return { status: 'warning', message: 'Genuine voucher, but it has expired.', payload };
+      }
+      const label = payload.type === 'voucher' ? 'gift voucher' : 'receipt';
+      return { status: 'valid', message: `Genuine ${label}. The signature is valid and the contents are unaltered.`, payload };
+    }
+
+    // --- UI -----------------------------------------------------------------
+    const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+    const money = new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' });
+
+    function renderResult({ status, message, payload }) {
+      const out = $('verify-result');
+      out.className = `verify-result ${status}`;
+      const heading = document.createElement('strong');
+      heading.textContent = `${status === 'valid' ? '✔' : status === 'warning' ? '⚠' : '✘'} ${message}`;
+      out.replaceChildren(heading);
+      if (!payload) return;
+
+      const isVoucher = payload.type === 'voucher';
+      const rows = [
+        ['Document', isVoucher ? 'Gift voucher' : 'Order receipt'],
+        ['ID', payload.id],
+        [isVoucher ? 'Recipient' : 'Customer', payload.name],
+        [isVoucher ? 'Message' : 'Items', payload.details],
+        ['Amount', money.format(Number(payload.amount))],
+        ['Issued', dateFmt.format(new Date(payload.issuedAt))],
+      ];
+      if (isVoucher) rows.push(['Expires', dateFmt.format(new Date(payload.expiresAt))]);
+      rows.push(['Algorithm', SUITES[payload.alg].label]);
+
+      const dl = document.createElement('dl');
+      for (const [term, value] of rows) {
+        const dt = document.createElement('dt');
+        const dd = document.createElement('dd');
+        dt.textContent = term;
+        dd.textContent = value;
+        dl.append(dt, dd);
+      }
+      out.append(dl);
+    }
+
+    function syncTypeLabels() {
+      const isVoucher = $('sign-form').elements.type.value === 'voucher';
+      $('sign-name-label').textContent = isVoucher ? 'Recipient name' : 'Customer name';
+      $('sign-details-label').textContent = isVoucher ? 'Gift message' : 'Items ordered';
+      $('sign-details-hint').textContent = isVoucher
+        ? `For example: Happy birthday! Valid for ${VOUCHER_VALIDITY_DAYS} days.`
+        : 'For example: 1× Maple Oat Latte, 1× Cold Brew';
+    }
+
+    async function init() {
+      const status = $('key-status');
+      const signForm = $('sign-form');
+      const verifyForm = $('verify-form');
+      const submitButtons = [signForm, verifyForm].map((f) => f.querySelector('[type="submit"]'));
+
+      if (!globalThis.isSecureContext || !crypto?.subtle) {
+        status.textContent = 'You need a secure (HTTPS) connection to sign or verify documents.';
+        submitButtons.forEach((b) => (b.disabled = true));
+        return;
+      }
+
+      let key;
+      try {
+        key = await loadOrCreateStoreKey();
+      } catch (err) {
+        status.textContent = `Signing isn’t available: ${err.message}`;
+        submitButtons.forEach((b) => (b.disabled = true));
+        return;
+      }
+      status.textContent = `Signing key: ${SUITES[key.suite].label}. Key fingerprint: ${key.kid}`;
+
+      signForm.addEventListener('change', (e) => {
+        if (e.target.name === 'type') syncTypeLabels();
+      });
+
+      signForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const data = Object.fromEntries(new FormData(signForm));
+        const { payload, token } = await issueDocument(key, {
+          type: data.type,
+          name: data.name.trim(),
+          details: data.details.trim(),
+          amount: data.amount,
+        });
+        $('signed-token').value = token;
+        $('signed-summary').textContent =
+          `${payload.type === 'voucher' ? 'Gift voucher' : 'Receipt'} ${payload.id} signed with ${SUITES[payload.alg].label}. Signed code size: ${token.length} characters.`;
+        $('signed-output').hidden = false;
+        $('signed-token').focus();
+      });
+
+      $('copy-token').addEventListener('click', async (e) => {
+        try {
+          await navigator.clipboard.writeText($('signed-token').value);
+          e.target.textContent = 'Copied!';
+        } catch {
+          $('signed-token').select();
+          e.target.textContent = 'Press Ctrl+C to copy';
+        }
+        setTimeout(() => (e.target.textContent = 'Copy code'), 2000);
+      });
+
+      $('send-to-verify').addEventListener('click', () => {
+        $('verify-token').value = $('signed-token').value;
+        $('verify-result').replaceChildren();
+        $('verify-token').focus();
+      });
+
+      verifyForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        renderResult(await verifyDocument(key, $('verify-token').value));
+      });
+
+      $('verify-token').addEventListener('input', () => $('verify-result').replaceChildren());
+    }
+
+    init();
+  </script>
+
 </body>
 
