diff --git a/tests/signing.test.mjs b/tests/signing.test.mjs
new file mode 100644
index 0000000..4e7975e
--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  ALGORITHMS,
+  canonicalize,
+  exportPublicKey,
+  generateIssuerKey,
+  parsePublicKey,
+  signDocument,
+  verifyDocument,
+} from '../js/signing.js';
+
+const receipt = {
+  receiptNo: 'DG-20261030-ABC123',
+  issuedAt: '2026-10-30T09:00:00.000Z',
+  location: 'Downtown Roastery',
+  customer: 'Sam',
+  items: [{ name: 'Cold Brew', qty: 2, unitCents: 495 }],
+  subtotalCents: 990,
+  taxCents: 88,
+  totalCents: 1078,
+  currency: 'USD',
+};
+
+test('canonicalize sorts keys and rejects unsignable values', () => {
+  assert.equal(canonicalize({ b: 1, a: [true, null, 'x'] }), '{"a":[true,null,"x"],"b":1}');
+  assert.throws(() => canonicalize({ a: NaN }));
+  assert.throws(() => canonicalize({ a: undefined }));
+});
+
+for (const alg of Object.keys(ALGORITHMS)) {
+  test(`${alg}: sign, verify, and detect tampering`, async () => {
+    const key = await generateIssuerKey(alg);
+    const doc = await signDocument(key, 'receipt', receipt);
+
+    // Survives a JSON round trip with different key order / formatting.
+    const roundTripped = JSON.parse(JSON.stringify({ ...doc, payload: { ...receipt, currency: 'USD' } }, null, 2));
+    const ok = await verifyDocument(roundTripped);
+    assert.equal(ok.valid, true, ok.reason);
+    assert.equal(ok.keyId, key.keyId);
+    assert.equal(ok.components.length, ALGORITHMS[alg].components.length);
+
+    const tampered = structuredClone(doc);
+    tampered.payload.totalCents = 1;
+    assert.equal((await verifyDocument(tampered)).valid, false);
+
+    const retyped = { ...doc, type: 'voucher' };
+    assert.equal((await verifyDocument(retyped)).valid, false);
+
+    // Swapping in another key (with matching key ID) must not verify.
+    const other = await generateIssuerKey(alg);
+    const swapped = { ...doc, signer: (await signDocument(other, 'receipt', receipt)).signer };
+    assert.equal((await verifyDocument(swapped)).valid, false);
+  });
+}
+
+test('hybrid: stripping or corrupting one component fails', async () => {
+  const key = await generateIssuerKey('Ed25519+ML-DSA-65');
+  const doc = await signDocument(key, 'voucher', { voucherCode: 'AAAA-BBBB', amountCents: 2500 });
+
+  const downgraded = {
+    ...doc,
+    signer: { alg: 'Ed25519', keyId: doc.signer.keyId, publicKeys: [doc.signer.publicKeys[0]] },
+    signatures: [doc.signatures[0]],
+  };
+  assert.equal((await verifyDocument(downgraded)).valid, false);
+
+  const sig = Buffer.from(doc.signatures[1], 'base64');
+  sig[10] ^= 1;
+  const corrupted = { ...doc, signatures: [doc.signatures[0], sig.toString('base64')] };
+  const result = await verifyDocument(corrupted);
+  assert.equal(result.valid, false);
+  assert.deepEqual(result.components.map((c) => c.valid), [true, false]);
+});
+
+test('rejects malformed documents and unsigned extra fields', async () => {
+  const key = await generateIssuerKey('Ed25519');
+  const doc = await signDocument(key, 'receipt', receipt);
+  for (const bad of [null, 'x', {}, { ...doc, note: 'paid in full' }, { ...doc, signatures: ['!!'] }, { ...doc, signer: { ...doc.signer, alg: 'RSA' } }]) {
+    assert.equal((await verifyDocument(bad)).valid, false);
+  }
+});
+
+test('public key export/import round trip validates key ID', async () => {
+  const key = await generateIssuerKey('ML-DSA-65');
+  const bundle = JSON.parse(JSON.stringify(exportPublicKey(key, 'Shop')));
+  const parsed = await parsePublicKey(bundle);
+  assert.equal(parsed.keyId, key.keyId);
+  await assert.rejects(parsePublicKey({ ...bundle, keyId: '00'.repeat(16) }));
+  await assert.rejects(parsePublicKey({ ...bundle, publicKeys: ['AAAA'] }));
+});
