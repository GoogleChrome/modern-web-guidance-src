+// Homepage UI for issuing and verifying signed receipts and gift vouchers.
+
+import {
+  ALGORITHMS,
+  exportPublicKey,
+  formatFingerprint,
+  generateIssuerKey,
+  isAlgorithmSupported,
+  parsePublicKey,
+  signDocument,
+  toBase64,
+  verifyDocument,
+} from './signing.js';
+import {
+  deleteIssuerKey,
+  findTrustedSigner,
+  loadIssuerKey,
+  loadTrustedSigners,
+  saveIssuerKey,
+  trustSigner,
+  untrustSigner,
+} from './keystore.js';
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitCents: 575 },
+  { name: 'Dark Roast Espresso', unitCents: 350 },
+  { name: 'Cold Brew', unitCents: 495 },
+  { name: 'Butter Croissant', unitCents: 325 },
+];
+const LOCATIONS = ['Downtown Roastery', 'Riverside Kiosk', 'University Ave'];
+const TAX_RATE = 0.08875;
+const MAX_IMPORT_BYTES = 256 * 1024;
+const ALG_PREF_KEY = 'dailyGrind.signingAlg';
+
+const $ = (id) => document.getElementById(id);
+
+function el(tag, attrs = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (k === 'class') node.className = v;
+    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
+    else if (v === true) node.setAttribute(k, '');
+    else if (v !== false && v != null) node.setAttribute(k, v);
+  }
+  node.append(...children.flat().filter((c) => c != null && c !== false));
+  return node;
+}
+
+// Rendering may be fed untrusted, attacker-shaped payloads, so coerce everything.
+const text = (v) => (typeof v === 'string' || typeof v === 'number' ? String(v) : '');
+const money = (cents) => (Number.isSafeInteger(cents) ? `$${(cents / 100).toFixed(2)}` : '—');
+const formatDate = (iso) => {
+  const d = new Date(text(iso));
+  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleString();
+};
+
+function randomCode(groups, size) {
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+  const bytes = crypto.getRandomValues(new Uint8Array(groups * size));
+  const chars = Array.from(bytes, (b) => alphabet[b % alphabet.length]).join('');
+  return chars.match(new RegExp(`.{${size}}`, 'g')).join('-');
+}
+
+const state = {
+  alg: localStorage.getItem(ALG_PREF_KEY) || 'Ed25519+ML-DSA-65',
+  issuerKey: null,
+  lastIssued: null,
+};
+
+// ---------------------------------------------------------------------------
+// Signing key panel
+
+async function renderAlgorithmOptions() {
+  const container = $('alg-options');
+  const supported = Object.fromEntries(
+    await Promise.all(Object.keys(ALGORITHMS).map(async (alg) => [alg, await isAlgorithmSupported(alg)])),
+  );
+  if (!supported[state.alg]) state.alg = Object.keys(ALGORITHMS).find((a) => supported[a]);
+
+  container.replaceChildren(
+    el('legend', {}, 'Signature algorithm'),
+    ...Object.entries(ALGORITHMS).map(([alg, spec]) =>
+      el(
+        'label',
+        { class: `alg-option${supported[alg] ? '' : ' unsupported'}` },
+        el('input', {
+          type: 'radio',
+          name: 'alg',
+          value: alg,
+          checked: alg === state.alg,
+          disabled: !supported[alg],
+          onchange: () => selectAlgorithm(alg),
+        }),
+        el(
+          'span',
+          {},
+          el('strong', {}, spec.label),
+          el('span', { class: `tag tag-${spec.family.toLowerCase()}` }, spec.family),
+          el('small', {}, supported[alg] ? spec.description : 'Not supported by this browser.'),
+        ),
+      ),
+    ),
+  );
+}
+
+async function selectAlgorithm(alg) {
+  state.alg = alg;
+  localStorage.setItem(ALG_PREF_KEY, alg);
+  state.issuerKey = (await loadIssuerKey(alg)) || null;
+  renderKeyStatus();
+}
+
+function renderKeyStatus() {
+  const key = state.issuerKey;
+  const status = $('key-status');
+  $('export-key').disabled = $('delete-key').disabled = !key;
+  $('generate-key').textContent = key ? 'Rotate key' : 'Generate key';
+  for (const btn of document.querySelectorAll('.sign-submit')) btn.disabled = !key;
+
+  if (!key) {
+    status.replaceChildren(
+      el('p', {}, `No ${ALGORITHMS[state.alg].label} signing key on this device yet. Generate one to start issuing.`),
+    );
+    return;
+  }
+  const pkBytes = key.publicKeys.reduce((n, pk) => n + pk.length, 0);
+  const nonExtractable = key.privateKeys.every((k) => k instanceof CryptoKey);
+  status.replaceChildren(
+    el(
+      'dl',
+      {},
+      el('dt', {}, 'Fingerprint'),
+      el('dd', { class: 'mono' }, formatFingerprint(key.keyId)),
+      el('dt', {}, 'Created'),
+      el('dd', {}, formatDate(key.createdAt)),
+      el('dt', {}, 'Public key'),
+      el('dd', {}, `${pkBytes.toLocaleString()} bytes`),
+      el('dt', {}, 'Private key'),
+      el(
+        'dd',
+        {},
+        nonExtractable
+          ? 'Non-extractable WebCrypto key in this browser'
+          : 'Stored in this browser (IndexedDB); never leaves the device',
+      ),
+    ),
+  );
+}
+
+async function generateKey() {
+  const btn = $('generate-key');
+  const previous = state.issuerKey;
+  if (previous && !confirm('Rotate the signing key? Documents signed with the old key will still verify as a retired key.')) {
+    return;
+  }
+  btn.disabled = true;
+  btn.textContent = 'Generating…';
+  try {
+    const key = await generateIssuerKey(state.alg);
+    await saveIssuerKey(key);
+    if (previous) {
+      const old = findTrustedSigner(previous.keyId);
+      if (old) trustSigner({ ...old, label: `${old.label} (retired)` });
+    }
+    trustSigner({
+      alg: key.alg,
+      keyId: key.keyId,
+      publicKeys: key.publicKeys.map(toBase64),
+      label: `The Daily Grind (this device, ${ALGORITHMS[key.alg].label})`,
+    });
+    state.issuerKey = key;
+  } catch (err) {
+    alert(`Could not generate key: ${err.message}`);
+  } finally {
+    btn.disabled = false;
+    renderKeyStatus();
+    renderTrustedSigners();
+  }
+}
+
+async function deleteKey() {
+  if (!state.issuerKey) return;
+  if (!confirm('Delete this signing key? You will no longer be able to issue documents with it. It stays trusted for verification unless you remove it below.')) {
+    return;
+  }
+  await deleteIssuerKey(state.alg);
+  state.issuerKey = null;
+  renderKeyStatus();
+}
+
+function exportKey() {
+  const key = state.issuerKey;
+  const bundle = exportPublicKey(key, findTrustedSigner(key.keyId)?.label || 'The Daily Grind');
+  download(`daily-grind-${key.alg}-${key.keyId.slice(0, 8)}.pub.json`, bundle);
+}
+
+function renderTrustedSigners() {
+  const list = loadTrustedSigners();
+  $('trusted-count').textContent = list.length;
+  $('trusted-list').replaceChildren(
+    ...(list.length
+      ? list.map((t) =>
+          el(
+            'li',
+            {},
+            el(
+              'div',
+              {},
+              el('strong', {}, text(t.label) || 'Unnamed signer'),
+              el('small', {}, `${ALGORITHMS[t.alg]?.label ?? t.alg} · `, el('span', { class: 'mono' }, formatFingerprint(t.keyId))),
+            ),
+            el(
+              'button',
+              {
+                type: 'button',
+                class: 'link-btn',
+                'aria-label': `Stop trusting ${text(t.label)}`,
+                onclick: () => {
+                  if (confirm('Stop trusting this signer?')) {
+                    untrustSigner(t.keyId);
+                    renderTrustedSigners();
+                  }
+                },
+              },
+              'Remove',
+            ),
+          ),
+        )
+      : [el('li', { class: 'muted' }, 'No trusted signers yet.')]),
+  );
+}
+
+async function importTrustedKey() {
+  const input = $('import-key-input');
+  const msg = $('import-key-msg');
+  try {
+    const record = await parsePublicKey(JSON.parse(input.value));
+    trustSigner({ ...record, label: record.label || 'Imported signer' });
+    msg.className = 'form-msg ok';
+    msg.textContent = `Trusted ${record.label || 'signer'} (${formatFingerprint(record.keyId)}).`;
+    input.value = '';
+    renderTrustedSigners();
+  } catch (err) {
+    msg.className = 'form-msg error';
+    msg.textContent = err instanceof SyntaxError ? 'That is not valid JSON.' : err.message;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Issuing
+
+function receiptTotals() {
+  const items = MENU.map((m, i) => ({ ...m, qty: Math.max(0, Math.min(99, parseInt($(`qty-${i}`).value, 10) || 0)) }))
+    .filter((i) => i.qty > 0)
+    .map(({ name, qty, unitCents }) => ({ name, qty, unitCents }));
+  const subtotalCents = items.reduce((n, i) => n + i.qty * i.unitCents, 0);
+  const taxCents = Math.round(subtotalCents * TAX_RATE);
+  return { items, subtotalCents, taxCents, totalCents: subtotalCents + taxCents };
+}
+
+function updateReceiptTotal() {
+  $('receipt-total').textContent = money(receiptTotals().totalCents);
+}
+
+function buildReceipt() {
+  const totals = receiptTotals();
+  if (!totals.items.length) throw new Error('Add at least one item to the order.');
+  const now = new Date();
+  return {
+    receiptNo: `DG-${now.toISOString().slice(0, 10).replaceAll('-', '')}-${randomCode(1, 6)}`,
+    issuedAt: now.toISOString(),
+    location: $('receipt-location').value,
+    customer: $('receipt-customer').value.trim(),
+    ...totals,
+    currency: 'USD',
+  };
+}
+
+function buildVoucher() {
+  const amount = Number($('voucher-amount').value);
+  if (!Number.isFinite(amount) || amount < 5 || amount > 500) throw new Error('Voucher amount must be between $5 and $500.');
+  const recipient = $('voucher-recipient').value.trim();
+  if (!recipient) throw new Error('Enter who the voucher is for.');
+  const expiresOn = $('voucher-expiry').value;
+  if (!expiresOn || new Date(`${expiresOn}T23:59:59`) < new Date()) throw new Error('Choose an expiry date in the future.');
+  return {
+    voucherCode: randomCode(4, 4),
+    issuedAt: new Date().toISOString(),
+    amountCents: Math.round(amount * 100),
+    currency: 'USD',
+    recipient,
+    from: $('voucher-from').value.trim(),
+    message: $('voucher-message').value.trim(),
+    expiresOn,
+  };
+}
+
+async function issue(type, event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const btn = form.querySelector('.sign-submit');
+  const msg = form.querySelector('.form-msg');
+  msg.textContent = '';
+  try {
+    if (!state.issuerKey) throw new Error('Generate a signing key first.');
+    const payload = type === 'receipt' ? buildReceipt() : buildVoucher();
+    btn.disabled = true;
+    btn.textContent = 'Signing…';
+    const doc = await signDocument(state.issuerKey, type, payload);
+    state.lastIssued = doc;
+    showIssued(doc);
+  } catch (err) {
+    msg.className = 'form-msg error';
+    msg.textContent = err.message;
+  } finally {
+    btn.disabled = !state.issuerKey;
+    btn.textContent = type === 'receipt' ? 'Sign receipt' : 'Sign voucher';
+  }
+}
+
+function showIssued(doc) {
+  $('issued-output').hidden = false;
+  $('issued-preview').replaceChildren(renderDocument(doc.type, doc.payload));
+  $('issued-json').value = JSON.stringify(doc, null, 2);
+  const sigBytes = doc.signatures.reduce((n, s) => n + Math.floor((s.length * 3) / 4), 0);
+  $('issued-meta').textContent = `Signed with ${ALGORITHMS[doc.signer.alg].label} · ${sigBytes.toLocaleString()}-byte signature`;
+}
+
+function documentFilename(doc) {
+  const id = text(doc.payload.receiptNo || doc.payload.voucherCode) || 'document';
+  return `${doc.type}-${id}.dgsig.json`;
+}
+
+function download(filename, data) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const a = el('a', { href: url, download: filename });
+  document.body.append(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+async function copyIssued() {
+  const btn = $('copy-issued');
+  try {
+    await navigator.clipboard.writeText($('issued-json').value);
+    btn.textContent = 'Copied!';
+  } catch {
+    $('issued-json').select();
+    btn.textContent = 'Press Ctrl+C';
+  }
+  setTimeout(() => (btn.textContent = 'Copy'), 1500);
+}
+
+function sendToVerifier(tamper) {
+  const doc = structuredClone(state.lastIssued);
+  if (tamper) {
+    // Simulate a forger editing the amount after signing.
+    if (doc.type === 'receipt') doc.payload.totalCents -= Math.min(doc.payload.totalCents, 500);
+    else doc.payload.amountCents *= 10;
+  }
+  $('verify-input').value = JSON.stringify(doc, null, 2);
+  $('verify-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
+  verify();
+}
+
+// ---------------------------------------------------------------------------
+// Document rendering
+
+function renderDocument(type, p) {
+  return type === 'receipt' ? renderReceipt(p) : renderVoucher(p);
+}
+
+function renderReceipt(p) {
+  const items = Array.isArray(p.items) ? p.items : [];
+  return el(
+    'div',
+    { class: 'receipt' },
+    el('div', { class: 'receipt-head' }, el('strong', {}, 'THE DAILY GRIND'), el('span', {}, text(p.location))),
+    el('div', { class: 'receipt-row' }, el('span', {}, `No. ${text(p.receiptNo)}`), el('span', {}, formatDate(p.issuedAt))),
+    p.customer ? el('div', { class: 'receipt-row' }, el('span', {}, `Customer: ${text(p.customer)}`)) : null,
+    el('hr'),
+    items.map((i) =>
+      el(
+        'div',
+        { class: 'receipt-row' },
+        el('span', {}, `${text(i?.qty)} × ${text(i?.name)}`),
+        el('span', {}, money(Number.isSafeInteger(i?.qty) && Number.isSafeInteger(i?.unitCents) ? i.qty * i.unitCents : NaN)),
+      ),
+    ),
+    el('hr'),
+    el('div', { class: 'receipt-row' }, el('span', {}, 'Subtotal'), el('span', {}, money(p.subtotalCents))),
+    el('div', { class: 'receipt-row' }, el('span', {}, 'Tax'), el('span', {}, money(p.taxCents))),
+    el('div', { class: 'receipt-row receipt-total' }, el('span', {}, 'TOTAL'), el('span', {}, money(p.totalCents))),
+  );
+}
+
+function renderVoucher(p) {
+  return el(
+    'div',
+    { class: 'voucher' },
+    el('div', { class: 'voucher-brand' }, 'THE DAILY GRIND · GIFT VOUCHER'),
+    el('div', { class: 'voucher-amount' }, money(p.amountCents)),
+    el('div', {}, `For ${text(p.recipient)}`, p.from ? ` · from ${text(p.from)}` : ''),
+    p.message ? el('p', { class: 'voucher-message' }, `“${text(p.message)}”`) : null,
+    el(
+      'div',
+      { class: 'voucher-foot' },
+      el('span', { class: 'mono' }, text(p.voucherCode)),
+      el('span', {}, `Valid until ${text(p.expiresOn) || '—'}`),
+    ),
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Verification
+
+async function verify() {
+  const out = $('verify-result');
+  const raw = $('verify-input').value.trim();
+  if (!raw) {
+    out.replaceChildren(el('div', { class: 'verdict verdict-bad' }, el('strong', {}, 'Paste or upload a signed document first.')));
+    return;
+  }
+  let doc;
+  try {
+    doc = JSON.parse(raw);
+  } catch {
+    out.replaceChildren(verdict('bad', 'Not a valid document', 'The text is not valid JSON.'));
+    return;
+  }
+  out.replaceChildren(el('p', { class: 'muted' }, 'Verifying…'));
+  const result = await verifyDocument(doc);
+
+  if (!result.valid) {
+    out.replaceChildren(verdict('bad', '✗ Not authentic', result.reason), result.keyId ? details(doc, result) : null);
+    return;
+  }
+
+  const trusted = findTrustedSigner(result.keyId);
+  const warnings = [];
+  if (doc.type === 'voucher') {
+    const expiry = new Date(`${text(doc.payload.expiresOn)}T23:59:59`);
+    if (!(expiry >= new Date())) warnings.push('This voucher has expired.');
+  }
+  const head = trusted
+    ? verdict('ok', '✓ Authentic', `Signed by ${text(trusted.label)}. The contents have not been changed since signing.`)
+    : verdict(
+        'warn',
+        '⚠ Valid signature, unknown signer',
+        'The contents have not been changed since signing, but the signing key is not on your trusted list. Anyone can create a key, so only trust it if you have confirmed the fingerprint with the issuer.',
+        el(
+          'button',
+          {
+            type: 'button',
+            class: 'btn btn-secondary',
+            onclick: () => {
+              const label = prompt(`Name this signer (fingerprint ${formatFingerprint(result.keyId)}):`, 'Trusted signer');
+              if (label === null) return;
+              trustSigner({ alg: result.alg, keyId: result.keyId, publicKeys: doc.signer.publicKeys, label: label.trim().slice(0, 80) || 'Trusted signer' });
+              renderTrustedSigners();
+              verify();
+            },
+          },
+          'Trust this signer',
+        ),
+      );
+  out.replaceChildren(
+    head,
+    ...warnings.map((w) => el('div', { class: 'verdict verdict-warn' }, w)),
+    details(doc, result),
+    renderDocument(doc.type, doc.payload),
+  );
+}
+
+function verdict(kind, title, body, ...extra) {
+  return el('div', { class: `verdict verdict-${kind}`, role: 'status' }, el('strong', {}, title), el('p', {}, body), ...extra);
+}
+
+function details(doc, result) {
+  return el(
+    'dl',
+    { class: 'verify-details' },
+    el('dt', {}, 'Document'),
+    el('dd', {}, doc.type === 'receipt' ? 'Order receipt' : 'Gift voucher'),
+    el('dt', {}, 'Algorithm'),
+    el('dd', {}, ALGORITHMS[result.alg]?.label ?? text(result.alg)),
+    el('dt', {}, 'Signer key'),
+    el('dd', { class: 'mono' }, formatFingerprint(result.keyId)),
+    result.components.length > 1 || !result.valid
+      ? [
+          el('dt', {}, 'Checks'),
+          el('dd', {}, result.components.map((c) => `${c.valid ? '✓' : '✗'} ${c.alg}`).join('  ') || '—'),
+        ]
+      : null,
+  );
+}
+
+function readFileInto(fileInput, textarea, then) {
+  const file = fileInput.files[0];
+  if (!file) return;
+  if (file.size > MAX_IMPORT_BYTES) {
+    alert('That file is too large to be a Daily Grind document.');
+    return;
+  }
+  file.text().then((t) => {
+    textarea.value = t;
+    fileInput.value = '';
+    then?.();
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Wiring
+
+function setupForms() {
+  $('receipt-location').replaceChildren(...LOCATIONS.map((l) => el('option', {}, l)));
+  $('receipt-items').replaceChildren(
+    ...MENU.map((m, i) =>
+      el(
+        'div',
+        { class: 'item-row' },
+        el('label', { for: `qty-${i}` }, m.name, el('small', {}, money(m.unitCents))),
+        el('input', { id: `qty-${i}`, type: 'number', min: '0', max: '99', value: i === 0 ? '1' : '0', oninput: updateReceiptTotal }),
+      ),
+    ),
+  );
+  updateReceiptTotal();
+
+  const nextYear = new Date();
+  nextYear.setFullYear(nextYear.getFullYear() + 1);
+  $('voucher-expiry').value = nextYear.toISOString().slice(0, 10);
+  $('voucher-expiry').min = new Date().toISOString().slice(0, 10);
+
+  for (const tab of document.querySelectorAll('[data-doc-tab]')) {
+    tab.addEventListener('click', () => {
+      for (const t of document.querySelectorAll('[data-doc-tab]')) {
+        const active = t === tab;
+        t.setAttribute('aria-selected', active);
+        $(t.getAttribute('aria-controls')).hidden = !active;
+      }
+    });
+  }
+
+  $('receipt-form').addEventListener('submit', (e) => issue('receipt', e));
+  $('voucher-form').addEventListener('submit', (e) => issue('voucher', e));
+  $('copy-issued').addEventListener('click', copyIssued);
+  $('download-issued').addEventListener('click', () => download(documentFilename(state.lastIssued), state.lastIssued));
+  $('send-to-verify').addEventListener('click', () => sendToVerifier(false));
+  $('tamper-test').addEventListener('click', () => sendToVerifier(true));
+
+  $('generate-key').addEventListener('click', generateKey);
+  $('delete-key').addEventListener('click', deleteKey);
+  $('export-key').addEventListener('click', exportKey);
+  $('import-key').addEventListener('click', importTrustedKey);
+  $('import-key-file').addEventListener('change', (e) => readFileInto(e.target, $('import-key-input')));
+
+  $('verify-btn').addEventListener('click', verify);
+  $('verify-file').addEventListener('change', (e) => readFileInto(e.target, $('verify-input'), verify));
+}
+
+async function init() {
+  setupForms();
+  renderTrustedSigners();
+  try {
+    await renderAlgorithmOptions();
+    await selectAlgorithm(state.alg);
+  } catch (err) {
+    $('key-status').replaceChildren(el('p', { class: 'form-msg error' }, `Signing is unavailable in this browser: ${err.message}`));
+  }
+}
+
+init();
