+// Digital signatures for Daily Grind receipts and gift vouchers.
+//
+// Classical algorithms use the browser's WebCrypto API (private keys are
+// non-extractable). ML-DSA-65 (FIPS 204) is a quantum-resistant scheme provided
+// by the vendored, audited @noble/post-quantum library. The hybrid mode signs
+// with both Ed25519 and ML-DSA-65 and only verifies if *both* signatures hold.
+//
+// No DOM or storage access here so the module can be unit-tested under Node.
+
+import { ml_dsa65 } from '../vendor/noble-ml-dsa65-0.7.1.min.js';
+
+export const FORMAT = 'daily-grind/signed-document@1';
+export const PUBLIC_KEY_FORMAT = 'daily-grind/public-key@1';
+export const DOC_TYPES = ['receipt', 'voucher'];
+
+// Prepended to every signed message so these signatures can never be replayed
+// as signatures over some other protocol's data (and vice versa).
+const DOMAIN = 'DailyGrind signed document v1\n';
+
+const subtle = globalThis.crypto.subtle;
+
+const PRIMITIVES = {
+  'ECDSA-P256': {
+    publicKeyLength: 65,
+    signatureLength: 64,
+    async generate() {
+      const kp = await subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+      return { publicKey: new Uint8Array(await subtle.exportKey('raw', kp.publicKey)), privateKey: kp.privateKey };
+    },
+    async sign(privateKey, msg) {
+      return new Uint8Array(await subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, privateKey, msg));
+    },
+    async verify(publicKey, sig, msg) {
+      const key = await subtle.importKey('raw', publicKey, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+      return subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, sig, msg);
+    },
+  },
+  Ed25519: {
+    publicKeyLength: 32,
+    signatureLength: 64,
+    async generate() {
+      const kp = await subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+      return { publicKey: new Uint8Array(await subtle.exportKey('raw', kp.publicKey)), privateKey: kp.privateKey };
+    },
+    async sign(privateKey, msg) {
+      return new Uint8Array(await subtle.sign({ name: 'Ed25519' }, privateKey, msg));
+    },
+    async verify(publicKey, sig, msg) {
+      const key = await subtle.importKey('raw', publicKey, { name: 'Ed25519' }, false, ['verify']);
+      return subtle.verify({ name: 'Ed25519' }, key, sig, msg);
+    },
+  },
+  'ML-DSA-65': {
+    publicKeyLength: 1952,
+    signatureLength: 3309,
+    async generate() {
+      const { publicKey, secretKey } = ml_dsa65.keygen();
+      return { publicKey, privateKey: secretKey };
+    },
+    async sign(secretKey, msg) {
+      return ml_dsa65.sign(msg, secretKey);
+    },
+    async verify(publicKey, sig, msg) {
+      return ml_dsa65.verify(sig, msg, publicKey);
+    },
+  },
+};
+
+export const ALGORITHMS = {
+  'ECDSA-P256': {
+    label: 'ECDSA P-256',
+    family: 'Classical',
+    description: 'NIST curve, supported everywhere. Not quantum-resistant.',
+    components: ['ECDSA-P256'],
+  },
+  Ed25519: {
+    label: 'Ed25519',
+    family: 'Classical',
+    description: 'Fast, compact modern signatures. Not quantum-resistant.',
+    components: ['Ed25519'],
+  },
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 (FIPS 204)',
+    family: 'Quantum-resistant',
+    description: 'NIST post-quantum lattice signature. Larger keys and signatures.',
+    components: ['ML-DSA-65'],
+  },
+  'Ed25519+ML-DSA-65': {
+    label: 'Hybrid Ed25519 + ML-DSA-65',
+    family: 'Hybrid',
+    description: 'Both signatures must verify, so it stays secure if either scheme is broken.',
+    components: ['Ed25519', 'ML-DSA-65'],
+  },
+};
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+
+const encoder = new TextEncoder();
+export const utf8 = (s) => encoder.encode(s);
+
+export function toBase64(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin);
+}
+
+export function fromBase64(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9+/]*={0,2}$/.test(str)) throw new Error('Invalid base64 data');
+  const bin = atob(str);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+const toHex = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+// Deterministic JSON: object keys sorted, no whitespace. Signer and verifier
+// must produce byte-identical input, regardless of how the JSON was formatted
+// or which order fields were written in.
+export function canonicalize(value) {
+  if (value === null) return 'null';
+  switch (typeof value) {
+    case 'boolean':
+      return String(value);
+    case 'string':
+      return JSON.stringify(value);
+    case 'number':
+      if (!Number.isFinite(value)) throw new Error('Non-finite numbers cannot be signed');
+      return JSON.stringify(value);
+    case 'object':
+      if (Array.isArray(value)) return `[${value.map(canonicalize).join(',')}]`;
+      return `{${Object.keys(value)
+        .sort()
+        .map((k) => {
+          if (value[k] === undefined) throw new Error(`Field "${k}" is undefined`);
+          return `${JSON.stringify(k)}:${canonicalize(value[k])}`;
+        })
+        .join(',')}}`;
+    default:
+      throw new Error(`Unsupported value of type ${typeof value}`);
+  }
+}
+
+const isPlainObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
+
+// ---------------------------------------------------------------------------
+// Keys
+
+// Key ID binds the algorithm and every component public key, so a hybrid key
+// can't be downgraded to one of its components without changing its identity.
+export async function computeKeyId(alg, publicKeys) {
+  const digest = await subtle.digest('SHA-256', utf8(canonicalize({ alg, publicKeys: publicKeys.map(toBase64) })));
+  return toHex(new Uint8Array(digest).subarray(0, 16));
