+const supportCache = new Map();
+
+export function isAlgorithmSupported(alg) {
+  if (!supportCache.has(alg)) {
+    supportCache.set(
+      alg,
+      Promise.all(ALGORITHMS[alg].components.map((c) => PRIMITIVES[c].generate())).then(
+        () => true,
+        () => false,
+      ),
+    );
+  }
+  return supportCache.get(alg);
+}
+
+export async function generateIssuerKey(alg) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) throw new Error(`Unknown algorithm ${alg}`);
+  const pairs = await Promise.all(spec.components.map((c) => PRIMITIVES[c].generate()));
+  const publicKeys = pairs.map((p) => p.publicKey);
+  return {
+    alg,
+    keyId: await computeKeyId(alg, publicKeys),
+    publicKeys,
