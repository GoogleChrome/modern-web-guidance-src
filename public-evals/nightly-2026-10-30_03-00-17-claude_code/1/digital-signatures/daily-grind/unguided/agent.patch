+
+export async function signDocument(issuerKey, type, payload) {
+  if (!DOC_TYPES.includes(type)) throw new Error(`Unknown document type ${type}`);
+  const spec = ALGORITHMS[issuerKey.alg];
+  const signer = { alg: issuerKey.alg, keyId: issuerKey.keyId, publicKeys: issuerKey.publicKeys.map(toBase64) };
+  const msg = signingInput({ type, payload, signer });
+  const sigs = await Promise.all(spec.components.map((c, i) => PRIMITIVES[c].sign(issuerKey.privateKeys[i], msg)));
