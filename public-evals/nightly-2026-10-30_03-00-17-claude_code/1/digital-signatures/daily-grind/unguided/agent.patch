+  return {
+    format: PUBLIC_KEY_FORMAT,
+    label,
+    alg: issuerKey.alg,
+    keyId: issuerKey.keyId,
+    publicKeys: issuerKey.publicKeys.map(toBase64),
+  };
+}
+
+// Validates a shared public key bundle and returns a normalised record.
+export async function parsePublicKey(bundle) {
+  if (!isPlainObject(bundle) || bundle.format !== PUBLIC_KEY_FORMAT) throw new Error('Not a Daily Grind public key');
+  const publicKeys = decodePublicKeys(bundle.alg, bundle.publicKeys);
+  const keyId = await computeKeyId(bundle.alg, publicKeys);
+  if (bundle.keyId !== undefined && bundle.keyId !== keyId) throw new Error('Key ID does not match the public key');
