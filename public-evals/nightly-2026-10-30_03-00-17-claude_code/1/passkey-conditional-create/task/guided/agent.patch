+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+    const button = form.querySelector('[data-testid="signin-button"]');
+
+    // Load WebAuthn polyfills (getClientCapabilities, JSON helpers) without
+    // blocking the page if the CDN is unreachable.
+    const polyfills = import('https://esm.sh/webauthn-polyfills').catch(() => {});
+
+    async function signalUnknown(rpId, credentialId) {
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        } catch {}
+      }
+    }
+
+    // Silently create a passkey after a successful password sign-in.
+    // Never surfaces UI; every failure is swallowed.
+    async function promotePasskey() {
+      if (!window.PublicKeyCredential) return;
+      await polyfills;
+      if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return;
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) return;
+
+      const optionsRes = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsRes.ok) return;
+      const optionsJSON = await optionsRes.json();
+      // Server should populate excludeCredentials with the user's existing passkeys.
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+      const rpId = optionsJSON.rp?.id ?? location.hostname;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+      } catch (e) {
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+          console.error('Unexpected conditional create error:', e);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const credentialJSON = credential.toJSON();
+      try {
+        const verifyRes = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(credentialJSON),
+        });
+        if (!verifyRes.ok) await signalUnknown(rpId, credentialJSON.id);
+      } catch (e) {
+        console.error('Passkey verification network failure:', e);
+        await signalUnknown(rpId, credentialJSON.id);
+      }
+    }
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      status.textContent = '';
+      status.classList.remove('error');
+      button.disabled = true;
+
+      const { username, password } = Object.fromEntries(new FormData(form));
+      try {
+        const res = await fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }),
+        });
+        if (!res.ok) throw new Error('Sign-in failed');
+
+        form.reset();
+        status.textContent = `Signed in as ${username}.`;
+
+        // Fire-and-forget: the passkey upgrade must never affect the sign-in UX.
+        promotePasskey().catch(() => {});
+      } catch {
+        status.textContent = 'Incorrect username or password. Please try again.';
+        status.classList.add('error');
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
