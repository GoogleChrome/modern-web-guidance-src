+    /* Roast Picker */
+    .order-form {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      width: min(100%, 340px);
+      margin-top: 1.5rem;
+    }
+
+    .order-form label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      margin-bottom: 0.5rem;
+    }
+
+    .roast-select {
+      width: 100%;
+      font: inherit;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select {
+        display: flex;
+        align-items: center;
+        padding: 10px 14px;
+        background: rgba(250, 250, 250, 0.95);
+        color: var(--text);
+        border: 2px solid var(--accent);
+        border-radius: 8px;
+        cursor: pointer;
+        text-align: left;
+      }
+
+      .roast-select:focus-visible {
+        outline: 3px solid var(--accent);
+        outline-offset: 2px;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+      }
+
+      .roast-select::picker(select) {
+        background: var(--light);
+        color: var(--text);
+        border: 1px solid var(--secondary);
+        border-radius: 8px;
+        padding: 6px;
+        margin-top: 6px;
+        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
+        width: anchor-size(width);
+      }
+
+      .roast-select option {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        padding: 10px;
+        border-radius: 6px;
+        cursor: pointer;
+      }
+
+      .roast-select option::checkmark {
+        display: none;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .roast-select option:checked {
+        background: var(--primary);
+        color: white;
+      }
+
+      .roast-select option:checked .roast-title {
+        font-weight: 700;
+      }
+
+      .roast-select svg {
+        flex-shrink: 0;
+        width: 28px;
+        height: 28px;
+        color: var(--accent);
+      }
+
+      .roast-text {
+        display: flex;
+        flex-direction: column;
+        line-height: 1.3;
+      }
+
+      .roast-title {
+        font-weight: 600;
+      }
+
+      .roast-desc {
+        font-size: 0.8rem;
+        opacity: 0.8;
+      }
+
+      /* Separator only exists for the plain-text fallback */
+      .roast-sep,
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+      }
+    }
+
+    .order-form .btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
