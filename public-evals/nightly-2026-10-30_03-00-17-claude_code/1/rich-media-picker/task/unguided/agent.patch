+        gap: 10px;
+        width: 320px;
+        text-align: left;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: none;
+        border-radius: 8px;
+        background: white;
+        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      }
+
+      .roast-select option {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        padding: 10px 12px;
+        border-radius: 6px;
+        color: var(--text);
+        text-align: left;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        background: #efebe9;
+      }
+
+      .roast-select option::checkmark {
+        order: 1;
+        margin-left: auto;
+        color: var(--primary);
+      }
+
+      .roast-icon {
+        flex-shrink: 0;
+        width: 32px;
+        height: 32px;
+        color: var(--primary);
+      }
+
+      .roast-text {
+        display: flex;
+        flex-direction: column;
+        line-height: 1.3;
+      }
+
+      .roast-title {
+        font-weight: bold;
+        color: var(--primary);
+      }
+
+      .roast-desc {
+        font-size: 0.8rem;
+        color: #6d4c41;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent .roast-icon {
+        width: 24px;
+        height: 24px;
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+    }
