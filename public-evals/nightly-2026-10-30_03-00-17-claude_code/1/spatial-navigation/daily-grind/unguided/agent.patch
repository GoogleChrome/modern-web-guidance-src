+  <script>
+    (function () {
+      const grid = document.querySelector('.grid');
+      const toggleButtons = document.querySelectorAll('[data-layout-option]');
+      const LAYOUT_KEY = 'daily-grind:card-layout';
+
+      // Focus targets are the card links; only one is in the tab order at a time (roving tabindex).
+      const getItems = () =>
+        Array.from(grid.querySelectorAll('.card .btn')).filter((el) => el.getClientRects().length > 0);
+
+      function setActive(target) {
+        getItems().forEach((el) => el.setAttribute('tabindex', el === target ? '0' : '-1'));
+      }
+
+      function center(rect) {
+        return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
+      }
+
+      // Find the nearest item in the given direction based on the rendered geometry of each card,
+      // so navigation follows whatever layout (columns, list, RTL) is currently on screen.
+      function findSpatial(current, items, direction) {
+        const from = current.closest('.card').getBoundingClientRect();
+        const fromCenter = center(from);
+        const horizontal = direction === 'left' || direction === 'right';
+        const sign = direction === 'right' || direction === 'down' ? 1 : -1;
+        let best = null;
+        let bestScore = Infinity;
+
+        for (const item of items) {
+          if (item === current) continue;
+          const rect = item.closest('.card').getBoundingClientRect();
+          const c = center(rect);
+          const primary = (horizontal ? c.x - fromCenter.x : c.y - fromCenter.y) * sign;
+          if (primary <= 1) continue; // not in the requested direction
+
+          // Prefer items that share the current row (or column) over diagonal ones.
+          const overlaps = horizontal
+            ? rect.top < from.bottom && rect.bottom > from.top
+            : rect.left < from.right && rect.right > from.left;
+          const cross = Math.abs(horizontal ? c.y - fromCenter.y : c.x - fromCenter.x);
+          const score = (overlaps ? 0 : 1e6) + primary + cross * 2;
+          if (score < bestScore) {
+            bestScore = score;
+            best = item;
+          }
+        }
+        return best;
+      }
+
+      function move(current, direction) {
+        const items = getItems();
+        let next = findSpatial(current, items, direction);
+
+        // At the end of a row (or in single-column list mode), Left/Right fall back to reading order.
+        if (!next && (direction === 'left' || direction === 'right')) {
+          const rtl = getComputedStyle(grid).direction === 'rtl';
+          const step = (direction === 'right') !== rtl ? 1 : -1;
+          next = items[items.indexOf(current) + step] || null;
+        }
+        return next;
+      }
+
+      const DIRECTIONS = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' };
+
+      grid.addEventListener('keydown', (event) => {
+        const current = event.target.closest('.card .btn');
+        if (!current || event.altKey || event.metaKey || event.shiftKey) return;
+
+        const items = getItems();
+        let next = null;
+        if (DIRECTIONS[event.key] && !event.ctrlKey) {
+          next = move(current, DIRECTIONS[event.key]);
+        } else if (event.key === 'Home') {
+          next = items[0];
+        } else if (event.key === 'End') {
+          next = items[items.length - 1];
+        } else {
+          return;
+        }
+
+        // Always swallow handled keys so the page doesn't scroll when there's nowhere to go.
+        event.preventDefault();
+        if (next && next !== current) {
+          setActive(next);
+          next.focus();
+        }
+      });
+
+      // Keep the roving tabindex in sync when focus arrives by mouse or other means.
+      grid.addEventListener('focusin', (event) => {
+        const item = event.target.closest('.card .btn');
+        if (item) setActive(item);
+      });
+
+      function applyLayout(layout) {
+        grid.dataset.layout = layout;
+        toggleButtons.forEach((btn) =>
+          btn.setAttribute('aria-pressed', String(btn.dataset.layoutOption === layout))
+        );
+        try { localStorage.setItem(LAYOUT_KEY, layout); } catch (e) { /* storage unavailable */ }
+      }
+
+      toggleButtons.forEach((btn) =>
+        btn.addEventListener('click', () => applyLayout(btn.dataset.layoutOption))
+      );
+
+      let saved = null;
+      try { saved = localStorage.getItem(LAYOUT_KEY); } catch (e) { /* storage unavailable */ }
+      if (saved === 'grid' || saved === 'list') applyLayout(saved);
+
+      setActive(getItems()[0]);
+    })();
+  </script>
+
