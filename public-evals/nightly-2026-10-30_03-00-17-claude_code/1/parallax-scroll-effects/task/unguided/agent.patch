+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      min-height: 90vh;
+      display: grid;
+      place-items: center;
+      padding: 80px 20px;
+      overflow: hidden;
+      isolation: isolate;
+      background: var(--primary);
+      color: white;
+      view-timeline: --parallax block;
+    }
+
+    .parallax__layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    .parallax__layer--back {
+      /* Taller than the section so it never reveals an edge while moving */
+      inset: -20% 0;
+      z-index: -3;
+    }
+
+    .parallax__layer--back img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .parallax__layer--back::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(rgba(30, 18, 15, 0.55), rgba(30, 18, 15, 0.75));
+    }
+
+    .parallax__layer--mid {
+      z-index: -2;
+    }
+
+    .parallax__layer--front {
+      z-index: 1;
+    }
+
+    .bean {
+      position: absolute;
+      left: var(--x);
+      top: var(--y);
+      width: calc(var(--size) * 1px);
+      aspect-ratio: 3 / 4;
+      border-radius: 50%;
+      background: radial-gradient(circle at 35% 30%, #8d6e63, var(--primary) 55%, #2b1b17);
+      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
+      transform: rotate(var(--rotate, 0deg));
+    }
+
+    .bean::after {
+      content: "";
+      position: absolute;
+      inset: 12% 30% 12% 46%;
+      border-left: 3px solid #1e120f;
+      border-radius: 50%;
+    }
+
+    .parallax__layer--mid .bean {
+      opacity: 0.7;
+    }
+
+    .parallax__content {
+      max-width: 600px;
+      padding: 40px 30px;
+      text-align: center;
+      background: rgba(30, 18, 15, 0.6);
+      border-radius: 8px;
+    }
+
+    .parallax__content h2 {
+      font-size: 2.25rem;
+      margin-bottom: 1rem;
+    }
+
+    .btn--accent {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .btn--accent:hover {
+      background: #ffc77a;
+    }
+
+    /* Scroll-driven parallax: only where supported and motion is welcome */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .parallax__layer--back,
+        .parallax__layer--mid,
+        .parallax__layer--front {
+          animation: linear both;
+          animation-timeline: --parallax;
+          will-change: transform;
+        }
+
+        .parallax__layer--back {
+          animation-name: parallax-back;
+        }
+
+        .parallax__layer--mid {
+          animation-name: parallax-mid;
+        }
+
+        .parallax__layer--front {
+          animation-name: parallax-front;
+        }
+      }
+    }
+
+    /* Layers drifting with the scroll appear farther away; against it, closer */
+    @keyframes parallax-back {
+      from {
+        transform: translate3d(0, -12%, 0);
+      }
+
+      to {
+        transform: translate3d(0, 12%, 0);
+      }
+    }
+
+    @keyframes parallax-mid {
+      from {
+        transform: translate3d(0, -60px, 0);
+      }
+
+      to {
+        transform: translate3d(0, 60px, 0);
+      }
+    }
+
+    @keyframes parallax-front {
+      from {
+        transform: translate3d(0, 160px, 0);
+      }
+
+      to {
+        transform: translate3d(0, -160px, 0);
+      }
+    }
+
