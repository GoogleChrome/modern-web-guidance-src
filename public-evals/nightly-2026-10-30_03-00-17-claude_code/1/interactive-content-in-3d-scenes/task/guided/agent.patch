+      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
+
+      gl.enable(gl.DEPTH_TEST);
+      gl.enable(gl.CULL_FACE);
+      gl.useProgram(program);
+
+      // Box dimensions in model units (front face matches the 360x468 form).
+      const W = 1, H = 1.3, D = 0.6;
+      const kraft = [0.78, 0.6, 0.42];
+      const dark = [0.55, 0.38, 0.27];
+      const faces = [
+        { matrix: new DOMMatrix().translate(0, 0, D / 2).scale(W, H, 1), element: form, color: kraft },
+        { matrix: new DOMMatrix().translate(0, 0, -D / 2).rotate(0, 180, 0).scale(W, H, 1), element: label, color: kraft },
+        { matrix: new DOMMatrix().translate(W / 2, 0, 0).rotate(0, 90, 0).scale(D, H, 1), color: kraft },
+        { matrix: new DOMMatrix().translate(-W / 2, 0, 0).rotate(0, -90, 0).scale(D, H, 1), color: kraft },
+        { matrix: new DOMMatrix().translate(0, H / 2, 0).rotate(-90, 0, 0).scale(W, D, 1), color: dark },
+        { matrix: new DOMMatrix().translate(0, -H / 2, 0).rotate(90, 0, 0).scale(W, D, 1), color: dark },
+      ];
+      for (const face of faces) {
