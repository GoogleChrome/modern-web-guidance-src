+    function perspective(fovDegrees, aspect, near, far) {
+      const f = 1 / Math.tan((fovDegrees * Math.PI) / 360);
+      const nf = 1 / (near - far);
+      return new DOMMatrix([
+        f / aspect, 0, 0, 0,
+        0, f, 0, 0,
+        0, 0, (far + near) * nf, -1,
+        0, 0, 2 * far * near * nf, 0,
+      ]);
+    }
