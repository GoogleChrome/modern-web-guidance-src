+  <script type="module">
+    const stage = document.querySelector('.box-stage');
+    const canvas = document.getElementById('box-canvas');
+    const form = document.getElementById('box-form');
+    const label = document.getElementById('box-label');
+    const qtyOutput = document.getElementById('qty');
+    const status = document.getElementById('box-status');
+
+    // --- Form behavior ---
+    let qty = 1;
+    form.addEventListener('click', (event) => {
+      const step = event.target.closest('[data-step]')?.dataset.step;
+      if (!step) return;
+      qty = Math.min(12, Math.max(1, qty + Number(step)));
+      qtyOutput.value = qty;
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
