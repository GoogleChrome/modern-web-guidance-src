+    });
+
+    // --- 3D scene ---
+    const gl = canvas.getContext('webgl2');
+    const htmlInCanvas = 'content' in HTMLCanvasElement.prototype && gl !== null;
+
+    if (!htmlInCanvas) {
+      // Fallback: render the form on top of the canvas with CSS.
+      stage.classList.add('fallback');
+      stage.append(form);
+    }
+
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+    });
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+    if (gl) {
+      const program = createProgram(`#version 300 es
+        in vec2 aPos;
+        uniform mat4 uMVP;
+        uniform mat4 uModel;
+        out vec2 vUV;
+        out vec3 vNormal;
+        void main() {
+          // Element textures are uploaded top row first, so flip V.
+          vUV = vec2(aPos.x + 0.5, 0.5 - aPos.y);
+          vNormal = mat3(uModel) * vec3(0.0, 0.0, 1.0);
+          gl_Position = uMVP * vec4(aPos, 0.0, 1.0);
+        }`, `#version 300 es
+        precision highp float;
+        in vec2 vUV;
+        in vec3 vNormal;
+        uniform sampler2D uTex;
+        uniform bool uUseTex;
+        uniform vec3 uColor;
+        out vec4 outColor;
+        void main() {
+          float diffuse = max(dot(normalize(vNormal), normalize(vec3(0.4, 0.6, 1.0))), 0.0);
+          vec3 color;
+          float light;
+          if (uUseTex) {
+            color = texture(uTex, vUV).rgb;
+            light = mix(1.0, 0.6 + 0.4 * diffuse, 0.35); // Keep the form readable.
+          } else {
+            color = uColor;
+            // Accent band printed around the box.
+            if (vUV.y > 0.12 && vUV.y < 0.2) color = vec3(1.0, 0.67, 0.25);
+            light = 0.45 + 0.55 * diffuse;
+          }
+          outColor = vec4(color * light, 1.0);
+        }`);
+
+      const aPos = gl.getAttribLocation(program, 'aPos');
+      const uMVP = gl.getUniformLocation(program, 'uMVP');
+      const uModel = gl.getUniformLocation(program, 'uModel');
+      const uUseTex = gl.getUniformLocation(program, 'uUseTex');
+      const uColor = gl.getUniformLocation(program, 'uColor');
+
+      // Unit quad spanning -0.5..0.5, counter-clockwise when facing +Z.
+      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([
+        -0.5, -0.5, 0.5, -0.5, 0.5, 0.5,
+        -0.5, -0.5, 0.5, 0.5, -0.5, 0.5,
