+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+        const projection = perspective(35, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
+        const view = new DOMMatrix().translate(0, 0, -2.9);
+        const model = new DOMMatrix()
+          .translate(0, Math.sin(now / 1200) * 0.03, 0)
+          .rotate(-8, 0, 0)
+          .rotate(0, angle, 0);
+
+        for (const face of faces) {
+          const faceModel = model.multiply(face.matrix);
+          const modelView = view.multiply(faceModel);
+          const mvp = projection.multiply(modelView);
+          gl.uniformMatrix4fv(uMVP, false, mvp.toFloat32Array());
+          gl.uniformMatrix4fv(uModel, false, faceModel.toFloat32Array());
+
+          const textured = face.texture && face.textureState.width > 0;
+          gl.uniform1i(uUseTex, textured ? 1 : 0);
+          gl.uniform3fv(uColor, face.color);
+          if (textured) gl.bindTexture(gl.TEXTURE_2D, face.texture);
+          gl.drawArrays(gl.TRIANGLES, 0, 6);
+
+          if (face.texture) syncGeometry(face, modelView, mvp);
+        }
+      }
+
+      // Keep the real element on top of its rendered pixels while it faces the viewer,
+      // and remove it from hit testing when it turns away.
+      function syncGeometry(face, modelView, mvp) {
+        const normal = modelView.transformPoint(new DOMPoint(0, 0, 1, 0));
+        const center = modelView.transformPoint(new DOMPoint(0, 0, 0, 1));
+        const toEye = Math.hypot(center.x, center.y, center.z);
+        const facing = -(normal.x * center.x + normal.y * center.y + normal.z * center.z) /
+          (Math.hypot(normal.x, normal.y, normal.z) * toEye);
+
+        if (facing > 0.15) {
+          canvas.updateElementGeometry(face.element, {
+            canvasTransform: computeCanvasTransform(canvas, face.element, mvp),
+            preserveHitTestOrder: true,
+          });
+          face.interactive = true;
+        } else if (face.interactive) {
+          canvas.clearElementGeometry(face.element);
+          face.interactive = false;
+        }
+      }
+
+      if (htmlInCanvas) {
+        canvas.onpaint = (event) => {
+          const changed = Array.from(event.changedElements ?? []);
+          for (const face of faces) {
+            if (!face.texture) continue;
+            if (face.textureState.width && !changed.includes(face.element)) continue;
+            try {
+              uploadElementWebGL(gl, canvas, face.texture, face.element, face.textureState);
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+          draw();
+        };
+      }
+
+      // Only animate while the box is on screen.
+      let frameId = 0;
+      function frame() {
+        if (htmlInCanvas) canvas.requestPaint();
+        else draw();
+        frameId = requestAnimationFrame(frame);
+      }
+      new IntersectionObserver(([entry]) => {
+        cancelAnimationFrame(frameId);
+        if (entry.isIntersecting) {
+          lastTime = performance.now();
+          frameId = requestAnimationFrame(frame);
