+          face.texture = gl.createTexture();
+          face.textureState = { width: 0, height: 0 };
+          face.interactive = false;
+        }
+      }
+
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let hovering = false;
+      form.addEventListener('pointerenter', () => { hovering = true; });
+      form.addEventListener('pointerleave', () => { hovering = false; });
+
+      let angle = 0;
+      let lastTime = performance.now();
+
+      function draw() {
+        const now = performance.now();
+        const dt = Math.min((now - lastTime) / 1000, 0.1);
+        lastTime = now;
+
+        if (form.matches(':focus-within')) {
+          // Settle the form face toward the viewer while the user is typing.
+          const target = Math.round(angle / 360) * 360;
+          angle += (target - angle) * Math.min(1, dt * 4);
+        } else if (reducedMotion.matches) {
+          angle = 20 * Math.sin(now / 4000);
+        } else {
+          angle += dt * (hovering ? 10 : 30); // Slow down (but keep spinning) under the pointer.
+        }
