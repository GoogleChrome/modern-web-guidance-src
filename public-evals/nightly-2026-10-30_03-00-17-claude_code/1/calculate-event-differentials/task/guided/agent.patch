+  <script type="module">
+    // Maple Oat Latte promotion window, as wall-clock times in the visitor's own time zone.
+    const PROMO_START = { date: '2025-11-01', time: '00:00' };
+    const PROMO_END = { date: '2026-03-01', time: '00:00' };
+
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const timer = document.getElementById('maple-promo');
+    const remainingLabel = timer.querySelector('[data-remaining-label]');
+    const remainingEl = timer.querySelector('[data-remaining]');
+    const elapsedEl = timer.querySelector('[data-elapsed]');
+
+    const timeZone = Temporal.Now.timeZoneId();
+    const toZoned = ({ date, time }) =>
+      Temporal.PlainDate.from(date).toZonedDateTime({ timeZone, plainTime: time });
+
+    const start = toZoned(PROMO_START);
+    const end = toZoned(PROMO_END);
+    const now = Temporal.Now.zonedDateTimeISO(timeZone);
+    const units = { largestUnit: 'day', smallestUnit: 'hour' };
+
+    const remaining = now.until(end, units);
+    const elapsed = now.since(start, units);
+
+    if (remaining.sign > 0) {
+      remainingEl.dateTime = remaining.toString();
+      remainingEl.textContent = remaining.toLocaleString(undefined, { style: 'long' });
+    } else {
+      remainingEl.dateTime = end.toPlainDate().toString();
+      remainingEl.textContent = end.toPlainDate().toLocaleString(undefined, { dateStyle: 'long' });
+      remainingLabel.firstChild.textContent = 'Offer ended on ';
+    }
+
+    elapsedEl.dateTime = elapsed.toString();
+    elapsedEl.textContent = elapsed.toLocaleString(undefined, { style: 'long' });
+
+    timer.hidden = false;
+  </script>
+
 </body>
 
