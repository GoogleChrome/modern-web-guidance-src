+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const paymentForm = document.querySelector('.payment-form');
+    const syncAria = (el) => {
+      if (el.matches?.('input')) {
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      }
+    };
+    paymentForm.addEventListener('blur', (e) => syncAria(e.target), true);
+    paymentForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    paymentForm.addEventListener('invalid', (e) => syncAria(e.target), true);
+  </script>
+
