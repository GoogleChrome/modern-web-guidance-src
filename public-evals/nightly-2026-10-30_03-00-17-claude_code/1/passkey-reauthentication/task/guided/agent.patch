+  <script type="module">
+    const button = document.getElementById('reauth-btn');
+    const status = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    // Load the JSON (de)serialization polyfills only on browsers that lack them.
+    async function ensureWebAuthnJSON() {
+      if (
+        typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        await import('https://esm.sh/webauthn-polyfills');
+      }
+    }
+
+    async function triggerButtonReauth() {
+      if (!window.PublicKeyCredential || !navigator.credentials) {
+        status.textContent = 'Your browser does not support passkeys.';
+        return;
+      }
+
+      // Abort any in-flight WebAuthn request to avoid prompt collisions.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      status.textContent = 'Waiting for passkey verification…';
+
+      try {
+        await ensureWebAuthnJSON();
+
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Failed to fetch challenge (${optionsResponse.status})`);
+        }
+        const optionsJSON = await optionsResponse.json();
+
+        // Reauth must be restricted to the signed-in user's own credentials.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          status.textContent = 'No passkey is registered for this account.';
+          return;
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          status.textContent = 'Verification was not completed.';
+          return;
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          status.textContent = 'Identity confirmed. You can now update your account.';
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+        } else {
+          if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Let the passkey provider remove a credential the server no longer recognises.
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: optionsJSON.rpId ?? location.hostname,
+              credentialId: encodedCredential.id,
+            }).catch(() => {});
+          }
+          status.textContent = 'We could not verify your identity. Please try again.';
+        }
+      } catch (err) {
+        if (err.name === 'AbortError') return;
+        status.textContent = err.name === 'NotAllowedError'
+          ? 'Verification was cancelled.'
+          : 'Something went wrong during verification. Please try again.';
+        console.error(err);
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerButtonReauth);
+  </script>
+
