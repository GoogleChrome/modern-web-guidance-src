+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('gift_form');
+      const nameInput = document.getElementById('gift_name');
+      const textInput = document.getElementById('gift_text');
+      const nameOut = document.getElementById('card_name');
+      const messageOut = document.getElementById('card_message');
+      const note = document.getElementById('designer_note');
+      const ctx = canvas.getContext('2d');
+
+      // HTML-in-Canvas (WICG): <canvas layoutsubtree> + ctx.drawElementImage() + "paint" event.
+      const supportsHtmlInCanvas =
+        typeof CanvasRenderingContext2D !== 'undefined' &&
+        typeof CanvasRenderingContext2D.prototype.drawElementImage === 'function';
+
+      // --- Card content -----------------------------------------------------
+      function updateCard() {
+        nameOut.textContent = nameInput.value.trim() || 'You';
+        messageOut.textContent = textInput.value.trim() || 'Enjoy a cup on me!';
+        const selected = form.querySelector('input[name="bg"]:checked');
+        card.style.setProperty('--card-bg', selected.value);
+        card.classList.toggle('light-text', selected.hasAttribute('data-light'));
+        // DOM changes to canvas children fire "paint" automatically; the fallback must redraw itself.
+        if (!supportsHtmlInCanvas) drawFallback();
+      }
+
+      form.addEventListener('input', updateCard);
+
+      // --- Rendering --------------------------------------------------------
+      if (supportsHtmlInCanvas) {
+        canvas.addEventListener('paint', () => {
+          ctx.reset();
+          const transform = ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+          // Keep the DOM box aligned with its drawn position for hit testing & accessibility.
+          card.style.transform = transform.toString();
+        });
+      } else {
+        // Without support, canvas children are inert fallback content: show the card as
+        // regular DOM for the live preview and keep the canvas offscreen for exporting.
+        canvas.removeAttribute('layoutsubtree');
+        canvas.before(card);
+        canvas.hidden = true;
+        note.hidden = false;
+        note.textContent = 'Your browser does not support HTML-in-Canvas yet, so the download uses a simplified rendering.';
+      }
+
+      // Size the backing store in device pixels so the export is crisp.
+      function resizeCanvas(width, height) {
+        if (canvas.width === width && canvas.height === height) return;
+        canvas.width = width;
+        canvas.height = height;
+        if (supportsHtmlInCanvas) canvas.requestPaint?.();
+      }
+
+      if (supportsHtmlInCanvas) {
+        const observer = new ResizeObserver(([entry]) => {
+          const dpBox = entry.devicePixelContentBoxSize?.[0];
+          if (dpBox) {
+            resizeCanvas(dpBox.inlineSize, dpBox.blockSize);
+          } else {
+            const box = entry.contentBoxSize[0];
+            resizeCanvas(Math.round(box.inlineSize * devicePixelRatio), Math.round(box.blockSize * devicePixelRatio));
+          }
+        });
+        try {
+          observer.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch {
+          observer.observe(canvas);
+        }
+      } else {
+        resizeCanvas(1000, 600);
+      }
+
+      // Resolves after the canvas has painted the current state of its children.
+      function nextPaint() {
+        return new Promise((resolve) => {
+          if (typeof canvas.requestPaint === 'function') {
+            // Registered after the drawing listener, so it runs once the frame is drawn.
+            canvas.addEventListener('paint', () => resolve(), { once: true });
+            canvas.requestPaint();
+          } else {
+            requestAnimationFrame(() => requestAnimationFrame(resolve));
+          }
+        });
+      }
+
+      // --- Fallback 2D rendering -------------------------------------------
+      function wrapLines(text, maxWidth) {
+        const words = text.split(/\s+/);
+        const lines = [];
+        let line = '';
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (ctx.measureText(test).width > maxWidth && line) {
+            lines.push(line);
+            line = word;
+          } else {
+            line = test;
+          }
+        }
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      function drawFallback() {
+        const { width: w, height: h } = canvas;
+        const styles = getComputedStyle(card);
+        const bg = styles.getPropertyValue('--card-bg').trim();
+        const fg = styles.color;
+        const pad = w * 0.08;
+        const sans = getComputedStyle(document.body).fontFamily;
+
+        ctx.reset();
+        ctx.beginPath();
+        ctx.roundRect(0, 0, w, h, w * 0.025);
+        ctx.clip();
+
+        // Base color, then a darkening sheen and a highlight circle to echo the CSS gradients.
+        ctx.fillStyle = bg;
+        ctx.fillRect(0, 0, w, h);
+        const shade = ctx.createLinearGradient(0, 0, w, h);
+        shade.addColorStop(0, 'rgba(0, 0, 0, 0)');
+        shade.addColorStop(1, 'rgba(0, 0, 0, 0.3)');
+        ctx.fillStyle = shade;
+        ctx.fillRect(0, 0, w, h);
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
+        ctx.beginPath();
+        ctx.arc(w * 0.85, h * 0.15, w * 0.11, 0, Math.PI * 2);
+        ctx.fill();
+
+        ctx.fillStyle = fg;
+        ctx.textBaseline = 'top';
+        ctx.font = `bold ${h * 0.045}px ${sans}`;
+        ctx.letterSpacing = `${h * 0.01}px`;
+        ctx.fillText('\u2615 THE DAILY GRIND', pad, h * 0.08);
+        ctx.letterSpacing = '0px';
+
+        ctx.font = `${h * 0.1}px Georgia, 'Times New Roman', serif`;
+        ctx.fillText(`For ${nameOut.textContent}`, pad, h * 0.3, w - pad * 2);
+
+        ctx.font = `italic ${h * 0.055}px ${sans}`;
+        wrapLines(messageOut.textContent, w - pad * 2).slice(0, 3).forEach((line, i) => {
+          ctx.fillText(line, pad, h * 0.46 + i * h * 0.075);
+        });
+
+        ctx.textBaseline = 'alphabetic';
+        ctx.font = `${h * 0.045}px ${sans}`;
+        ctx.fillText('Redeemable at any location', pad, h - h * 0.09);
+        ctx.font = `bold ${h * 0.08}px ${sans}`;
+        ctx.fillStyle = '#ffab40';
+        ctx.textAlign = 'right';
+        ctx.fillText('Gift Card', w - pad, h - h * 0.09);
+      }
+
+      // --- Export -----------------------------------------------------------
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const button = document.getElementById('export_btn');
+        button.disabled = true;
+        try {
+          await document.fonts.ready;
+          if (supportsHtmlInCanvas) {
+            await nextPaint();
+          } else {
+            drawFallback();
+          }
+          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Canvas export produced no data');
+
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          const slug = nameOut.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'card';
+          link.href = url;
+          link.download = `daily-grind-gift-card-${slug}.png`;
+          document.body.append(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 0);
+        } catch (err) {
+          console.error(err);
+          note.hidden = false;
+          note.textContent = 'Sorry, the card could not be exported. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      updateCard();
+    })();
+  </script>
+
 </body>
 
