+  <script type="module">
+    const canvas = document.getElementById('gift_canvas');
+    const card = document.getElementById('export_element');
+    const form = document.getElementById('gift_form');
+    const messageInput = document.getElementById('gift_message');
+    const nameInput = document.getElementById('gift_name');
+    const exportButton = document.getElementById('gift_export');
+    const status = document.getElementById('gift_status');
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function syncCard() {
+      document.getElementById('gift_card_message').textContent = messageInput.value;
+      document.getElementById('gift_card_name').textContent = nameInput.value;
+      card.style.setProperty('--card-bg', form.elements.gift_bg.value);
+    }
+    form.addEventListener('input', syncCard);
+    syncCard();
+
+    function downloadBlob(blob) {
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = 'daily-grind-gift-card.png';
+      link.click();
+      setTimeout(() => URL.revokeObjectURL(url));
+    }
+
+    if (supportsHtmlInCanvas) {
+      const ctx = canvas.getContext('2d');
+
+      // Card edits change the drawable subtree, which fires a paint event.
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+      };
+
+      // Match the canvas grid to device pixels so the card and export stay crisp.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Wait for a fresh paint so the export always reflects the latest edits.
+      function nextPaint() {
+        return new Promise((resolve) => {
+          canvas.addEventListener('paint', resolve, { once: true });
+          canvas.requestPaint();
+        });
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        exportButton.disabled = true;
+        try {
+          await nextPaint();
+          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Canvas export failed');
+          downloadBlob(blob);
+          status.textContent = 'Your gift card has been downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, we couldn’t export your card. Please try again.';
+        } finally {
+          exportButton.disabled = false;
+        }
+      });
+    } else {
+      // Without HTML-in-Canvas, canvas children aren't rendered: show the card
+      // directly and export it with a DOM snapshot library instead.
+      canvas.replaceWith(card);
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        exportButton.disabled = true;
+        try {
+          const { snapdom } = await import('https://esm.sh/@zumer/snapdom@1');
+          const result = await snapdom(card, { scale: devicePixelRatio });
+          await result.download({ format: 'png', filename: 'daily-grind-gift-card' });
+          status.textContent = 'Your gift card has been downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, your browser can’t export this card.';
+        } finally {
+          exportButton.disabled = false;
+        }
+      });
+    }
+  </script>
