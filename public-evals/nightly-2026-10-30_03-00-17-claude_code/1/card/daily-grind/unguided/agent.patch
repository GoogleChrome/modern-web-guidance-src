+  <script>
+    (() => {
+      const STORAGE_KEY = 'dailyGrindOrder';
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const countEl = document.querySelector('[data-order-count]');
+      const statusEl = document.querySelector('[data-order-status]');
+
+      const loadOrder = () => {
+        try {
+          return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
+        } catch {
+          return [];
+        }
+      };
+
+      let order = loadOrder();
+
+      const renderCount = () => {
+        countEl.textContent = order.length;
+      };
+
+      document.querySelectorAll('form[data-product]').forEach((form) => {
+        const priceEl = form.querySelector('.product-card__price');
+        const button = form.querySelector('.product-card__add');
+        let resetTimer;
+
+        const selectedSize = () => form.querySelector('input[name="size"]:checked');
+
+        form.addEventListener('change', () => {
+          priceEl.textContent = currency.format(selectedSize().dataset.price);
+        });
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const size = selectedSize();
+          const name = form.dataset.product;
+
+          order.push({ item: form.elements.item.value, size: size.value, price: Number(size.dataset.price) });
+          try {
+            localStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+          } catch {
+            // Storage unavailable; keep the in-memory order.
+          }
+          renderCount();
+
+          statusEl.textContent = `Added a ${size.value} ${name} to your order. ${order.length} item${order.length === 1 ? '' : 's'} in your order.`;
+          form.classList.add('is-added');
+          button.textContent = 'Added ✓';
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(() => {
+            form.classList.remove('is-added');
+            button.textContent = 'Add to Order';
+          }, 1500);
+        });
+      });
+
+      renderCount();
+    })();
+  </script>
+
 </body>
 
 </html>
