+  <script>
+    const orderCount = document.querySelector('.order-count');
+    const order = JSON.parse(sessionStorage.getItem('order') || '[]');
+
+    function renderOrderCount() {
+      orderCount.textContent = order.length || '';
+    }
+
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        const size = form.querySelector('input[name="size"]:checked');
+        const name = form.closest('.card').querySelector('h3').textContent;
+
+        order.push({ item: data.get('item'), size: data.get('size'), price: Number(size.dataset.price) });
+        sessionStorage.setItem('order', JSON.stringify(order));
+        renderOrderCount();
+
+        form.querySelector('.order-status').textContent =
+          `Added a ${data.get('size')} ${name} to your order.`;
+      });
+    });
+
+    renderOrderCount();
+  </script>
