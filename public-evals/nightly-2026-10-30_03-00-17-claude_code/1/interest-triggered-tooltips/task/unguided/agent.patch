+  <script>
+    // Keep each tooltip beside its button, flipping left (or above) if it would overflow the viewport.
+    document.querySelectorAll('.tooltip-wrap').forEach((wrap) => {
+      const tip = wrap.querySelector('.tooltip');
+      const place = () => {
+        wrap.classList.remove('tooltip--left', 'tooltip--top');
+        const btn = wrap.getBoundingClientRect();
+        const width = tip.offsetWidth + 12;
+        const viewport = document.documentElement.clientWidth;
+        if (btn.right + width > viewport) {
+          wrap.classList.add(btn.left - width >= 0 ? 'tooltip--left' : 'tooltip--top');
+        }
+      };
+      wrap.addEventListener('mouseenter', place);
+      wrap.addEventListener('focusin', place);
+    });
+  </script>
+
