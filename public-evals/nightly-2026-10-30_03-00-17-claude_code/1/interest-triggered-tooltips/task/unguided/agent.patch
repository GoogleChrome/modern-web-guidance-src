+
+    .tooltip-wrap:hover .tooltip,
+    .tooltip-wrap:focus-within .tooltip {
+      opacity: 1;
+      visibility: visible;
+    }
+
+    /* Flipped placements when there isn't room on the right */
+    .tooltip-wrap.tooltip--left .tooltip {
+      left: auto;
+      right: calc(100% + 12px);
