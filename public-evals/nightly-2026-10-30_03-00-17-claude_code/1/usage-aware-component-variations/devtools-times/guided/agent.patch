+}
+
+/*
+ * Semantic surface contexts.
+ * Layout regions declare what kind of surface they are; components decide
+ * on their own how to present themselves there via container style queries.
+ * Neither side names the other, so both can grow independently.
+ */
+.surface-featured {
+  --surface: featured;
+}
+
+.surface-compact {
+  --surface: compact;
+}
+
+@layer components {
+  /* Editor's pick badge: only revealed on featured surfaces */
+  .pick-badge {
+    display: none;
+    padding-block: 0.125rem;
+    padding-inline: 0.5rem;
+    border-radius: var(--radius-sm);
+    background: var(--color-amber-800);
+    color: var(--color-white);
+    font-size: var(--text-xs);
+    font-weight: 600;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+
+  /* Article teaser card */
+  .teaser {
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+    block-size: 100%;
+
+    & .teaser-media img {
+      inline-size: 100%;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+      border-radius: var(--radius-md);
+    }
+
+    & .teaser-body {
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+    }
+
+    & .teaser-title {
+      font-size: var(--text-lg);
+      line-height: var(--text-lg--line-height);
+
+      @media (width >= 48rem) {
+        font-size: var(--text-xl);
+        line-height: var(--text-xl--line-height);
+      }
+    }
+  }
+
+  /* Bookmark button: icon-only by default */
+  .bookmark-button {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.375rem;
+    padding: 0.25rem;
+    border-radius: 9999px;
+    cursor: pointer;
+  }
+
+  .bookmark-label {
+    display: none;
+  }
+
+  /* Selector-based fallback for browsers without container style queries */
+  :where(.surface-featured) .pick-badge {
+    display: inline-block;
+  }
+
+  :where(.surface-featured) .bookmark-button {
+    padding-inline: 0.75rem;
+    border: 1px solid currentColor;
+    color: var(--color-amber-800);
+    font-size: var(--text-sm);
+    font-weight: 600;
+
+    &:hover {
+      background: var(--color-amber-50);
+    }
+
+    & .bookmark-label {
+      display: inline;
+    }
+  }
+
+  :where(.surface-compact) .teaser {
+    display: grid;
+    grid-template-columns: 6rem 1fr;
+    align-items: start;
+    gap: 1rem;
+
+    & .teaser-media img {
+      aspect-ratio: 1;
+    }
+
+    & .teaser-title {
+      font-size: var(--text-base);
+      line-height: var(--text-base--line-height);
+    }
+
+    & .teaser-summary {
+      display: none;
+    }
+  }
+
+  /* Progressive enhancement: style queries override when supported */
+  @container style(--surface: featured) {
+    .pick-badge {
+      display: inline-block;
+    }
+
+    .bookmark-button {
+      padding-inline: 0.75rem;
+      border: 1px solid currentColor;
+      color: var(--color-amber-800);
+      font-size: var(--text-sm);
+      font-weight: 600;
+
+      &:hover {
+        background: var(--color-amber-50);
+      }
+    }
+
+    .bookmark-label {
+      display: inline;
+    }
+  }
+
+  @container style(--surface: compact) {
+    .teaser {
+      display: grid;
+      grid-template-columns: 6rem 1fr;
+      align-items: start;
+      gap: 1rem;
+
+      & .teaser-media img {
+        aspect-ratio: 1;
+      }
+
+      & .teaser-title {
+        font-size: var(--text-base);
+        line-height: var(--text-base--line-height);
+      }
+
+      & .teaser-summary {
+        display: none;
+      }
+    }
+  }
+}
