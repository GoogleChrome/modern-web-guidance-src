new file mode 100644
index 0000000..62f8fb4
--- /dev/null
+++ b/src/components/ArticleSignals.astro
@@ -0,0 +1,43 @@
+---
+import type { ArticleContext } from '../utils/articleContext';
+import { BoltIcon, BookOpenIcon, ClockIcon } from '@heroicons/react/24/outline';
+
+export interface Props {
+    context: ArticleContext;
+    readingTime?: number;
+    size?: 'sm' | 'md';
+}
+
+const { context, readingTime, size = 'sm' } = Astro.props;
+const { length, freshness, tone, desk } = context;
+
+const icon = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
+const text = size === 'md' ? 'text-sm' : 'text-xs';
+
+// The reading-time cue changes with article length: quick reads get a bolt,
+// long reads are called out explicitly so readers can plan for them.
+const lengthLabel = {
+    quick: 'Quick read',
+    standard: 'Read',
+    longform: 'Long read',
+}[length];
+const LengthIcon = { quick: BoltIcon, standard: BookOpenIcon, longform: ClockIcon }[length];
+const lengthClass = length === 'longform' && tone !== 'sober' ? desk.accent : '';
+
+// Fresh stories get a badge; light-hearted ones may animate, sober ones never do.
+const freshClass = tone === 'sober' ? 'bg-gray-100 text-gray-700' : desk.soft;
+const freshLabel = tone === 'sober' ? 'Latest' : 'New';
+---
+<span class={`${text} font-medium flex items-center gap-2`}>
+    {freshness === 'new' && (
+        <span class={`inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 uppercase tracking-wider text-[0.65rem] font-bold ${freshClass}`}>
+            {tone === 'light' && <span class="w-1.5 h-1.5 rounded-full bg-current motion-safe:animate-pulse" aria-hidden="true"></span>}
+            {freshLabel}
+        </span>
+    )}
+    <span class={`flex items-center ${lengthClass}`} title={lengthLabel}>
+        <LengthIcon className={`${icon} inline-block mr-1 -mt-px`} />
+        {length !== 'standard' && <span class="mr-1">{lengthLabel} ·</span>}
+        {readingTime} Min.
+    </span>
+</span>
