diff --git a/src/components/CategoryLabel.astro b/src/components/CategoryLabel.astro
new file mode 100644
index 0000000..3cdc49d
--- /dev/null
+++ b/src/components/CategoryLabel.astro
@@ -0,0 +1,40 @@
+---
+import type { Tone } from '../utils/articleContext';
+import { getDesk, formatCategory } from '../utils/articleContext';
+
+export interface Props {
+    category: string;
+    tone?: Tone;
+    /** Render as a link to the category page. */
+    link?: boolean;
+    /** `inverse` is used on top of dark imagery. */
+    variant?: 'default' | 'inverse';
+    class?: string;
+}
+
+const { category, tone = 'neutral', link = true, variant = 'default', class: className = '' } = Astro.props;
+const desk = getDesk(category);
+
+// Sober stories keep the desk's typography but drop the colour, so a crime
+// story doesn't shout in the same voice as a festival review.
+const color = variant === 'inverse'
+    ? 'text-white/90'
+    : tone === 'sober' ? 'text-gray-600' : desk.accent;
+
+const classes = [
+    'inline-flex items-center gap-1.5',
+    desk.label,
+    color,
+    link && 'hover:underline underline-offset-2',
+    className,
+].filter(Boolean).join(' ');
+
+const Tag = link ? 'a' : 'span';
+const href = link ? `${import.meta.env.BASE_URL}category/${category.toLowerCase()}` : undefined;
+---
+<Tag href={href} class={classes} data-desk={desk.id} data-tone={tone}>
+    {desk.id === 'news' && tone !== 'sober' && variant === 'default' && (
+        <span class="inline-block w-1.5 h-1.5 bg-red-700 rounded-full" aria-hidden="true"></span>
+    )}
+    {formatCategory(category)}
+</Tag>
