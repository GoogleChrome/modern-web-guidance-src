new file mode 100644
index 0000000..08a6433
--- /dev/null
+++ b/src/utils/articleContext.ts
@@ -0,0 +1,204 @@
+import { getCollection, type CollectionEntry } from 'astro:content';
+
+/**
+ * Semantic context for an article: which editorial desk it belongs to, how
+ * serious its subject is, how fresh it is and how long it takes to read.
+ * Components use this to adapt their visual treatment instead of hard-coding
+ * a single look for every story.
+ */
+
+export type DeskId = 'news' | 'business' | 'sports' | 'culture' | 'science' | 'lifestyle' | 'general';
+export type Tone = 'sober' | 'neutral' | 'light';
+export type Freshness = 'new' | 'recent' | 'archive';
+export type Length = 'quick' | 'standard' | 'longform';
+
+export interface DeskTheme {
+    id: DeskId;
+    name: string;
+    /** Accent text color, e.g. for category labels. */
+    accent: string;
+    /** Headline color on hover; applied inside a `group`. */
+    hover: string;
+    /** Soft background for badges and chips. */
+    soft: string;
+    /** Solid border/bar color. */
+    bar: string;
+    /** Color tint for overlays on top of imagery. */
+    overlay: string;
+    /** Typographic treatment of the category label. */
+    label: string;
+}
+
+// Class strings are spelled out in full so Tailwind can detect them.
+const DESKS: Record<DeskId, DeskTheme> = {
+    news: {
+        id: 'news',
+        name: 'News',
+        accent: 'text-red-700',
+        hover: 'group-hover:text-red-700',
+        soft: 'bg-red-50 text-red-800',
+        bar: 'border-red-700',
+        overlay: 'bg-red-950/60',
+        label: 'uppercase font-bold tracking-wider text-xs',
+    },
+    business: {
+        id: 'business',
+        name: 'Business',
+        accent: 'text-sky-800',
+        hover: 'group-hover:text-sky-800',
+        soft: 'bg-sky-50 text-sky-900',
+        bar: 'border-sky-800',
+        overlay: 'bg-sky-950/60',
+        label: 'uppercase font-semibold tracking-widest text-xs tabular-nums',
+    },
+    sports: {
+        id: 'sports',
+        name: 'Sports',
+        accent: 'text-emerald-700',
+        hover: 'group-hover:text-emerald-700',
+        soft: 'bg-emerald-50 text-emerald-800',
+        bar: 'border-emerald-600',
+        overlay: 'bg-emerald-950/55',
+        label: 'uppercase font-extrabold italic tracking-tight text-sm',
+    },
+    culture: {
+        id: 'culture',
+        name: 'Culture',
+        accent: 'text-fuchsia-800',
+        hover: 'group-hover:text-fuchsia-700',
+        soft: 'bg-fuchsia-50 text-fuchsia-900',
+        bar: 'border-fuchsia-700',
+        overlay: 'bg-fuchsia-950/55',
+        label: 'font-brand italic tracking-wide text-base',
+    },
+    science: {
+        id: 'science',
+        name: 'Science',
+        accent: 'text-indigo-700',
+        hover: 'group-hover:text-indigo-700',
+        soft: 'bg-indigo-50 text-indigo-800',
+        bar: 'border-indigo-600',
+        overlay: 'bg-indigo-950/60',
+        label: 'font-mono uppercase tracking-tight text-xs',
+    },
+    lifestyle: {
+        id: 'lifestyle',
+        name: 'Lifestyle',
+        accent: 'text-teal-700',
+        hover: 'group-hover:text-teal-600',
+        soft: 'bg-teal-50 text-teal-800',
+        bar: 'border-teal-500',
+        overlay: 'bg-teal-950/50',
+        label: 'font-brand lowercase tracking-wide text-base',
+    },
+    general: {
+        id: 'general',
+        name: 'General',
+        accent: 'text-amber-800',
+        hover: 'group-hover:text-amber-400',
+        soft: 'bg-amber-50 text-amber-900',
+        bar: 'border-amber-400',
+        overlay: 'bg-black/50',
+        label: 'font-brand tracking-widest text-sm',
+    },
+};
+
+const CATEGORY_TO_DESK: Record<string, DeskId> = {
+    news: 'news',
+    national: 'news',
+    politics: 'news',
+    labor: 'news',
+    media: 'news',
+    business: 'business',
+    economy: 'business',
+    'urban development': 'business',
+    sports: 'sports',
+    culture: 'culture',
+    science: 'science',
+    lifestyle: 'lifestyle',
+    pets: 'lifestyle',
+};
+
+// Words that signal a heavy subject. Such stories get a restrained treatment.
+const SOBER_TERMS = ['crime', 'criminal', 'killer', 'death', 'murder', 'crisis', 'decay', 'crumbling', 'strike', 'forensic', 'war', 'disaster'];
+// Words that signal a light-hearted story.
+const LIGHT_TERMS = ['humor', 'pets', 'dogs', 'festival', 'comedy', 'coffee', 'improv'];
+
+export function getDesk(category: string): DeskTheme {
+    return DESKS[CATEGORY_TO_DESK[category.trim().toLowerCase()] ?? 'general'];
+}
+
+export function formatCategory(category: string): string {
+    return category.charAt(0).toUpperCase() + category.slice(1);
+}
+
+function containsAny(haystack: string, terms: string[]): boolean {
+    return terms.some(term => new RegExp(`\\b${term}s?\\b`, 'i').test(haystack));
+}
+
+export function getTone(data: Pick<CollectionEntry<'articles'>['data'], 'title' | 'category' | 'tags'>): Tone {
+    const text = [data.title, data.category, ...(data.tags ?? [])].join(' ');
+    if (containsAny(text, SOBER_TERMS)) return 'sober';
+    if (containsAny(text, LIGHT_TERMS)) return 'light';
+    return 'neutral';
+}
+
+export function getLength(readingTime: number | undefined): Length {
+    if (!readingTime || readingTime <= 3) return 'quick';
+    if (readingTime >= 6) return 'longform';
+    return 'standard';
+}
+
+const DAY = 24 * 60 * 60 * 1000;
+
+let editionDatePromise: Promise<Date> | undefined;
+
+/**
+ * The date of the newest article. Freshness is measured against the latest
+ * edition rather than the wall clock, so the site keeps a sense of "what's new"
+ * even when content isn't published daily.
+ */
+export function getEditionDate(): Promise<Date> {
+    editionDatePromise ??= getCollection('articles').then(articles =>
+        new Date(Math.max(...articles.map(a => a.data.date.valueOf())))
+    );
+    return editionDatePromise;
+}
+
+export function getFreshness(date: Date, editionDate: Date): Freshness {
+    const age = editionDate.valueOf() - date.valueOf();
+    if (age < DAY) return 'new';
+    if (age < 7 * DAY) return 'recent';
+    return 'archive';
+}
+
+export interface ArticleContext {
+    desk: DeskTheme;
+    tone: Tone;
+    length: Length;
+    freshness: Freshness;
+    categoryLabel: string;
+}
+
+export async function getArticleContext(article: CollectionEntry<'articles'>): Promise<ArticleContext> {
+    const editionDate = await getEditionDate();
+    return {
+        desk: getDesk(article.data.category),
+        tone: getTone(article.data),
+        length: getLength(article.data.readingTime),
+        freshness: getFreshness(article.data.date, editionDate),
+        categoryLabel: formatCategory(article.data.category),
+    };
+}
+
+/** Headline hover color. Sober stories avoid flashy accent shifts. */
+export function headlineHover(ctx: ArticleContext): string {
+    return ctx.tone === 'sober' ? 'group-hover:underline decoration-1 underline-offset-4' : `${ctx.desk.hover} transition-colors`;
+}
+
+/** Image treatment. Sober stories are desaturated until the reader engages. */
+export function imageTreatment(ctx: ArticleContext): string {
+    if (ctx.tone === 'sober') return 'grayscale-[60%] group-hover:grayscale-0 transition duration-300';
+    if (ctx.tone === 'light') return 'group-hover:scale-[1.02] transition-transform duration-300';
+    return '';
+}
