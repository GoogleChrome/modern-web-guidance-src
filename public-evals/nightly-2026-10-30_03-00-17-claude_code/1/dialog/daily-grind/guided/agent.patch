+  <script type="module">
+    // Invoker Commands (command/commandfor) open and close the dialogs; polyfill only where missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch((err) => console.error('Error loading invokers polyfill:', err));
+    }
+
+    const dialogs = document.querySelectorAll('.drink-dialog');
+
+    // Light dismiss fallback where <dialog closedby> is unsupported (Esc and back gesture work natively)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of dialogs) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+      }
+    }
+
+    const status = document.querySelector('.order-status');
+    let statusTimer;
+
+    for (const dialog of dialogs) {
+      const form = dialog.querySelector('form');
+      dialog.addEventListener('close', () => {
+        // '' means dismissed without choosing (Esc, backdrop, Cancel)
+        if (dialog.returnValue) {
+          const data = new FormData(form);
+          const item = `${data.get('quantity')} × ${data.get('size')} ${data.get('drink')}`;
+          status.textContent = dialog.returnValue === 'order'
+            ? `Order placed: ${item} for ${data.get('fulfillment')}.`
+            : `Added ${item} to your order.`;
+          clearTimeout(statusTimer);
+          statusTimer = setTimeout(() => { status.textContent = ''; }, 6000);
+        }
+        dialog.returnValue = '';
+        form.reset();
+      });
+    }
+  </script>
+
