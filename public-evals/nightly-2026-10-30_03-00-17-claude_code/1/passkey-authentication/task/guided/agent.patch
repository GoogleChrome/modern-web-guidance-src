+  <script type="module">
+    import 'https://esm.sh/webauthn-polyfills';
+
+    const form = document.getElementById('signin-form');
+    const passkeyButton = document.getElementById('passkey-button');
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+
+    let autofillAbortController = new AbortController();
+
+    async function optionsFetch() {
+      const response = await fetch('/api/login/options', { method: 'POST' });
+      if (!response.ok) throw new Error(`Options request failed: ${response.status}`);
+      return response.json();
+    }
+
+    function loginVerifyFetch(encoded) {
+      return fetch('/api/login/verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+      });
+    }
+
+    // Sends the assertion to the server and reports the outcome in the status element
+    async function verifyCredential(credential, rpId) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          const result = await response.json().catch(() => ({}));
+          const name = result.displayName || result.username;
+          statusEl.textContent = name ? `Signed in as ${name}.` : 'Signed in successfully.';
+          return;
+        }
+        if (response.status === 404) {
+          statusEl.textContent = 'This passkey is no longer registered. Please choose another sign-in method.';
+          // Runs pre-authentication, satisfying the unauthenticated precondition
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: encoded.id });
+          }
+          return;
+        }
+        statusEl.textContent = 'Sign-in failed. Please try again.';
+      } catch (serverErr) {
+        console.error('Verification request error:', serverErr);
+        statusEl.textContent = 'Could not reach the server. Please try again.';
+      }
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential) return;
+      // Feature detect Conditional Get autofill support
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet !== true) return;
+
+      let credential;
+      let rpId;
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        rpId = loginOptionsJSON.rpId ?? location.hostname;
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+        // Registers passkeys as autofill suggestions on the username field without showing a dialog
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        // Silently swallow expected client WebAuthn exceptions
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+        return;
+      }
+
+      await verifyCredential(credential, rpId);
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        statusEl.textContent = 'Passkeys are not supported in this browser.';
+        return;
+      }
+
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let credential;
+      let rpId;
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        rpId = loginOptionsJSON.rpId ?? location.hostname;
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+        // Explicit passkey prompt (biometrics / screen lock)
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          statusEl.textContent = 'Passkey sign-in was cancelled.';
+        } else if (err.name !== 'AbortError') {
+          console.error('Passkey sign-in error:', err);
+          statusEl.textContent = 'Passkey sign-in failed. Please try again.';
+        }
+        // Re-arm conditional autofill suggestions after a cancelled explicit prompt
+        initializeConditionalAutofill();
+        return;
+      }
+
+      await verifyCredential(credential, rpId);
+    }
+
+    passkeyButton.addEventListener('click', triggerButtonAuthentication);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      triggerButtonAuthentication();
+    });
+
+    // Module scripts are deferred, so the DOM is ready here
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
