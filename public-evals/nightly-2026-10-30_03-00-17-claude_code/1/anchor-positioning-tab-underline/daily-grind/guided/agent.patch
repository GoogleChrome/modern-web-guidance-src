     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
+    }
+
+    /* Active nav indicator: tethered to the active item and slides between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      inset-block-start: calc(anchor(bottom) + 4px);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 3px;
+      border-radius: 3px;
+      background: var(--accent);
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+    }
+
+    nav ul li.active a {
+      color: var(--accent);
+    }
+
+    @supports not (position-anchor: auto) {
+      nav ul li.active {
+        border-bottom: 3px solid var(--accent);
+      }
     }
 
