+  <script>
+    const img = (id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=160&h=160&q=70`;
+
+    const beans = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral, bergamot, lemon', price: 18, image: img('photo-1559056199-641a0ac8b55e') },
+      { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, cocoa', price: 16, image: img('photo-1447933601403-0c6688de566e') },
+      { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy, cedar, dark chocolate', price: 17, image: img('photo-1611854779393-1b2da9d400fe') },
+      { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Toffee, spice, orange peel', price: 17, image: img('photo-1587734195503-904fca47e0e9') },
+      { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, grapefruit, wine', price: 20, image: img('photo-1442512595331-e89e73853f31') },
+      { id: 'brazil', name: 'Brazil Santos', notes: 'Nutty, milk chocolate, low acid', price: 15, image: img('photo-1610632380989-680fe40816c6') },
+    ];
+
+    const selected = new Set(['colombia']);
+
+    const availableList = document.getElementById('available-beans');
+    const selectedList = document.getElementById('selected-beans');
+
+    // Build each card once so the same element moves between lists
+    const cards = new Map(beans.map((bean) => {
+      const li = document.createElement('li');
+      li.className = 'bean';
+      // Each card needs a unique name; shared animation comes from view-transition-class
+      li.style.viewTransitionName = `bean-${bean.id}`;
+      li.innerHTML = `
+        <img src="${bean.image}" alt="" width="64" height="64" loading="lazy">
+        <div>
+          <h4>${bean.name}</h4>
+          <p>${bean.notes} &middot; $${bean.price}/bag</p>
+        </div>
+        <button type="button" data-id="${bean.id}"></button>`;
+      return [bean.id, li];
+    }));
+
+    function render() {
+      let total = 0;
+      for (const bean of beans) {
+        const card = cards.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        const button = card.querySelector('button');
+        button.textContent = isSelected ? 'Remove' : 'Add';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+        (isSelected ? selectedList : availableList).append(card);
+        if (isSelected) total += bean.price;
+      }
+      document.getElementById('available-count').textContent = `${beans.length - selected.size} left`;
+      document.getElementById('selected-count').textContent = `${selected.size} selected`;
+      document.getElementById('bean-total').textContent = selected.size ? `Total: $${total}` : '';
+    }
+
+    function toggleBean(id) {
+      const update = () => {
+        selected.has(id) ? selected.delete(id) : selected.add(id);
+        render();
+        // Moving the card drops focus; restore it on the card's button
+        cards.get(id).querySelector('button').focus();
+      };
+      if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+    }
+
+    document.querySelector('.bean-columns').addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-id]');
+      if (!button) return;
+      toggleBean(button.dataset.id);
+    });
+
+    render();
+  </script>
+
 </body>
 
