+
+    /* Shared transition logic for the whole group of beans */
+    ::view-transition-group(*.bean) {
+      animation-duration: 450ms;
+      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+    }
+
+    ::view-transition-old(*.bean),
+    ::view-transition-new(*.bean) {
+      height: 100%;
+    }
+
+    ::view-transition-new(*.bean):only-child {
+      animation: bean-in 450ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
+    }
+
+    ::view-transition-old(*.bean):only-child {
+      animation: bean-out 300ms ease-in both;
+    }
+
+    @keyframes bean-in {
+      from {
+        opacity: 0;
+        transform: scale(0.85);
+      }
+    }
+
+    @keyframes bean-out {
+      to {
+        opacity: 0;
+        transform: scale(0.85);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
