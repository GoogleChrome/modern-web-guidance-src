+  <script>
+    const beans = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral, bergamot, light roast', img: 'photo-1559056199-641a0ac8b55e' },
+      { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, medium roast', img: 'photo-1447933601403-0c6688de566e' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy, cedar, dark roast', img: 'photo-1611854779393-1b2da9d400fe' },
+      { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Cocoa, spice, medium roast', img: 'photo-1587734195503-904fca47e0e9' },
+      { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, citrus, light roast', img: 'photo-1514432324607-a09d9b4aefdd' },
+      { id: 'house', name: 'Daily Grind House Blend', notes: 'Chocolate, toasted nut, espresso roast', img: 'photo-1509042239860-f550ce710b93' }
+    ];
+
+    const selected = new Set(['colombia', 'house']);
+
+    const availableList = document.getElementById('available-beans');
+    const selectedList = document.getElementById('selected-beans');
+    const availableCount = document.getElementById('available-count');
+    const selectedCount = document.getElementById('selected-count');
+    const status = document.getElementById('bean-status');
+
+    function renderBean(bean, isSelected) {
+      const li = document.createElement('li');
+      li.className = 'bean-item';
+      // Same name in either list, so a bean morphs from one column to the other
+      li.style.viewTransitionName = `bean-${bean.id}`;
+      li.innerHTML = `
+        <img src="https://images.unsplash.com/${bean.img}?auto=format&fit=crop&w=128&h=128&q=70" alt="" loading="lazy">
+        <div class="bean-info">
+          <strong>${bean.name}</strong>
+          <span>${bean.notes}</span>
+        </div>
+        <button type="button" class="bean-toggle" data-id="${bean.id}"
+          aria-label="${isSelected ? 'Remove' : 'Add'} ${bean.name}">
+          ${isSelected ? 'Remove' : 'Add'}
+        </button>`;
+      return li;
+    }
+
+    function renderEmpty(text) {
+      const li = document.createElement('li');
+      li.className = 'bean-empty';
+      li.textContent = text;
+      return li;
+    }
+
+    function render() {
+      const available = beans.filter(b => !selected.has(b.id));
+      const chosen = beans.filter(b => selected.has(b.id));
+
+      availableList.replaceChildren(...(available.length
+        ? available.map(b => renderBean(b, false))
+        : [renderEmpty("You've picked every bean we roast!")]));
+      selectedList.replaceChildren(...(chosen.length
+        ? chosen.map(b => renderBean(b, true))
+        : [renderEmpty('Your box is empty. Add some beans to get started.')]));
+
+      availableCount.textContent = `${available.length} left`;
+      selectedCount.textContent = `${chosen.length} selected`;
+    }
+
+    function toggleBean(id) {
+      const bean = beans.find(b => b.id === id);
+      const adding = !selected.has(id);
+      const update = () => {
+        adding ? selected.add(id) : selected.delete(id);
+        render();
+        // Keep keyboard focus on the moved bean's button
+        document.querySelector(`.bean-toggle[data-id="${id}"]`)?.focus({ preventScroll: true });
+      };
+
+      if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+      status.textContent = `${bean.name} ${adding ? 'added to' : 'removed from'} your selection.`;
+    }
+
+    document.querySelector('.bean-picker').addEventListener('click', e => {
+      const button = e.target.closest('.bean-toggle');
+      if (button) toggleBean(button.dataset.id);
+    });
+
+    render();
+  </script>
+
