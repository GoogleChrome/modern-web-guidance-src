+        }
+
+        .tooltip-content::before {
+          inset-block-start: auto;
+          inset-block-end: 100%;
+          /* Points up, toward the anchor above */
+          clip-path: polygon(50% 0, 100% 100%, 0 100%);
+        }
+      }
+    }
