+    }
+
+    /* Arrow is a progressive enhancement: only shown where its direction can follow the flip */
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        content: "";
+        position: absolute;
+        inset-inline-start: 50%;
+        inset-block-start: 100%;
+        translate: -50% 0;
+        inline-size: calc(var(--arrow-size) * 2);
+        block-size: var(--arrow-size);
+        background: inherit;
+        /* Points down, toward the anchor below */
+        clip-path: polygon(0 0, 100% 0, 50% 100%);
+      }
+
+      @container anchored(fallback: flip-block) {
