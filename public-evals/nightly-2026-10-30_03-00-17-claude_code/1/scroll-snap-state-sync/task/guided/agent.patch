+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+
+    function setActive(id) {
+      for (const link of links) {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    // Scroll only the panel (not the page); CSS scroll-behavior makes it smooth
+    // unless the user prefers reduced motion.
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (!section) return;
+        event.preventDefault();
+        const top = panel.scrollTop + section.getBoundingClientRect().top - panel.getBoundingClientRect().top;
+        panel.scrollTo({ top });
+        setActive(section.id);
+        section.focus({ preventScroll: true });
+      });
+    }
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      // Fires once the panel settles on a new snapped header
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) setActive(section.id);
+      });
+    } else {
+      // Fallback: track which sections touch the top 10% of the panel and
+      // pick the lowest one, which is the section snapped to the top.
+      const visible = new Set();
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.isIntersecting) visible.add(entry.target);
+          else visible.delete(entry.target);
+        }
+        const current = sections.findLast((section) => visible.has(section));
+        if (current) setActive(current.id);
+      }, { root: panel, rootMargin: '0px 0px -90% 0px' });
+      sections.forEach((section) => observer.observe(section));
+    }
+  </script>
