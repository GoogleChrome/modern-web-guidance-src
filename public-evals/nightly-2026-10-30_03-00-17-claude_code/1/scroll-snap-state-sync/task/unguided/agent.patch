+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      const links = Array.from(toc.querySelectorAll('a[href^="#"]'));
+      const sections = Array.from(panel.querySelectorAll('.drink-section'));
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          const isActive = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // The section whose header sits closest to the top of the panel is the current one.
+      function currentSection() {
+        const panelTop = panel.getBoundingClientRect().top;
+        let closest = sections[0];
+        let minDistance = Infinity;
+        sections.forEach(function (section) {
+          const distance = Math.abs(section.getBoundingClientRect().top - panelTop);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closest = section;
+          }
+        });
+        return closest;
+      }
+
+      let ticking = false;
+      panel.addEventListener('scroll', function () {
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(function () {
+          setActive(currentSection().id);
+          ticking = false;
+        });
+      }, { passive: true });
+
+      function scrollToSection(section, smooth) {
+        const offset = section.getBoundingClientRect().top - panel.getBoundingClientRect().top;
+        panel.scrollTo({
+          top: panel.scrollTop + offset,
+          behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto'
+        });
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          const section = document.getElementById(link.getAttribute('href').slice(1));
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          setActive(section.id);
+          scrollToSection(section, true);
+          section.focus({ preventScroll: true });
+          history.replaceState(null, '', '#' + section.id);
+        });
+      });
+
+      const initial = location.hash && document.getElementById(location.hash.slice(1));
+      if (initial && panel.contains(initial)) {
+        scrollToSection(initial, false);
+        setActive(initial.id);
+      } else {
+        setActive(currentSection().id);
+      }
+    })();
+  </script>
+
