+  <script>
+    // Theme picker: "system" follows the OS; "light"/"dark" force the scheme on the root element.
+    const STORAGE_KEY = "color-scheme";
+    const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeSelect = document.getElementById("theme-select");
+    const systemOption = themeSelect.querySelector('option[value="system"]');
+    const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+    function readStoredTheme() {
+      try {
+        const stored = localStorage.getItem(STORAGE_KEY);
+        return stored === "light" || stored === "dark" ? stored : "system";
+      } catch {
+        return "system";
+      }
+    }
+
+    function applyTheme(theme) {
+      colorSchemeMeta.content = theme === "system" ? "light dark" : theme;
+      themeSelect.value = theme;
+    }
+
+    function updateSystemLabel() {
+      systemOption.textContent = `System default (currently ${systemDark.matches ? "dark" : "light"})`;
+    }
+
+    themeSelect.addEventListener("change", () => {
+      const theme = themeSelect.value;
+      applyTheme(theme);
+      try {
+        if (theme === "system") {
+          localStorage.removeItem(STORAGE_KEY);
+        } else {
+          localStorage.setItem(STORAGE_KEY, theme);
+        }
+      } catch {}
+    });
+
+    // Keep in sync with changes made in other tabs.
+    window.addEventListener("storage", (event) => {
+      if (event.key === STORAGE_KEY || event.key === null) applyTheme(readStoredTheme());
+    });
+
+    systemDark.addEventListener("change", updateSystemLabel);
+
+    updateSystemLabel();
+    applyTheme(readStoredTheme());
+
+    // Late night specials filter
+    const lateNightSelect = document.getElementById("late-night-select");
+    const specials = document.querySelectorAll(".special");
+
+    lateNightSelect.addEventListener("change", () => {
+      const category = lateNightSelect.value;
+      for (const special of specials) {
+        special.hidden = category !== "all" && special.dataset.category !== category;
+      }
+    });
+  </script>
+
 </body>
 
