+  <script>
+    (function () {
+      var root = document.documentElement;
+      var meta = document.querySelector('meta[name="color-scheme"]');
+      var themeSelect = document.getElementById('theme-select');
+
+      function applyTheme(theme) {
+        if (theme === 'light' || theme === 'dark') {
+          root.setAttribute('data-theme', theme);
+          meta.setAttribute('content', theme);
+          localStorage.setItem('theme', theme);
+        } else {
+          root.removeAttribute('data-theme');
+          meta.setAttribute('content', 'light dark');
+          localStorage.removeItem('theme');
+        }
+      }
+
+      themeSelect.value = root.getAttribute('data-theme') || 'system';
+      themeSelect.addEventListener('change', function () {
+        applyTheme(themeSelect.value);
+      });
+
+      var filter = document.getElementById('late-night-filter');
+      var specials = document.querySelectorAll('.late-night .special');
+      filter.addEventListener('change', function () {
+        specials.forEach(function (item) {
+          item.hidden = filter.value !== 'all' && item.dataset.category !== filter.value;
+        });
+      });
+    })();
+  </script>
+
