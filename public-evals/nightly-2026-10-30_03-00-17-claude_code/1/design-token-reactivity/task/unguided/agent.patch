+  <script>
+    // Only flips the density custom property on the container; CSS style
+    // queries take care of restyling the card.
+    const densityToggle = document.getElementById('toggle-spacious');
+    const densityContainer = document.getElementById('target-container');
+
+    densityToggle.addEventListener('click', () => {
+      const isSpacious = densityContainer.style.getPropertyValue('--layout-density') === 'spacious';
+      if (isSpacious) {
+        densityContainer.style.removeProperty('--layout-density');
+      } else {
+        densityContainer.style.setProperty('--layout-density', 'spacious');
+      }
+      densityToggle.setAttribute('aria-pressed', String(!isSpacious));
+    });
+  </script>
