     .btn:hover {
       background: #3e2723;
     }
 
+    /* Layout density toggle */
+    .density-controls {
+      text-align: center;
+      margin-top: 15px;
+    }
+
+    #toggle-spacious {
+      /* Hidden unless the browser supports container style queries */
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      padding: 6px 14px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    #toggle-spacious:hover,
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    /* Feature check: only browsers that understand style queries match this */
+    @container style(--style-queries-probe: on) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    #target-container {
+      --layout-density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s ease;
+    }
+
+    /* The card reacts to the density property inherited from #target-container */
+    @container style(--layout-density: spacious) {
+      #target-item {
+        padding: 40px;
+      }
+    }
+
