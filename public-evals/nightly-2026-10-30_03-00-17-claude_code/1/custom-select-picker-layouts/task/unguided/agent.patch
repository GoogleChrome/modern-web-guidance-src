+  <script>
+    // Enhance the native roast <select> into a 3-column image grid picker.
+    (function () {
+      var picker = document.querySelector('.roast-picker');
+      var select = document.getElementById('roast');
+      var orderLink = document.getElementById('order-now');
+      var options = Array.prototype.slice.call(select.options);
+      var activeIndex = select.selectedIndex;
+
+      var trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.className = 'roast-trigger';
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-grid');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      var triggerImg = document.createElement('img');
+      triggerImg.alt = '';
+      var triggerLabel = document.createElement('span');
+      triggerLabel.className = 'roast-trigger-label';
+      trigger.append(triggerImg, triggerLabel);
+
+      var grid = document.createElement('ul');
+      grid.className = 'roast-grid';
+      grid.id = 'roast-grid';
+      grid.setAttribute('role', 'listbox');
+      grid.setAttribute('aria-labelledby', 'roast-label');
+      grid.tabIndex = -1;
+      grid.hidden = true;
+
+      var items = options.map(function (opt, i) {
+        var li = document.createElement('li');
+        li.className = 'roast-option';
+        li.id = 'roast-option-' + opt.value;
+        li.setAttribute('role', 'option');
+        li.innerHTML =
+          '<img src="' + opt.dataset.img + '" alt="" loading="lazy">' +
+          '<div class="roast-option-body">' +
+          '<div class="roast-option-name"></div>' +
+          '<div class="roast-option-notes"></div>' +
+          '</div>';
+        li.querySelector('.roast-option-name').textContent = opt.text;
+        li.querySelector('.roast-option-notes').textContent = opt.dataset.notes;
+        li.addEventListener('click', function () { choose(i); close(); });
+        li.addEventListener('mousemove', function () { setActive(i); });
+        grid.appendChild(li);
+        return li;
+      });
+
+      var label = picker.querySelector('label');
+      label.id = 'roast-label';
+      label.htmlFor = 'roast-trigger';
+      select.tabIndex = -1;
+      select.setAttribute('aria-hidden', 'true');
+      picker.classList.add('enhanced');
+      picker.append(trigger, grid);
+
+      function render() {
+        var opt = options[select.selectedIndex];
+        triggerImg.src = opt.dataset.img;
+        triggerLabel.textContent = opt.text;
+        items.forEach(function (li, i) {
+          li.setAttribute('aria-selected', i === select.selectedIndex ? 'true' : 'false');
+        });
+        orderLink.href = '/order-online?roast=' + encodeURIComponent(opt.value);
+      }
+
+      function setActive(i) {
+        activeIndex = (i + items.length) % items.length;
+        items.forEach(function (li, j) { li.classList.toggle('active', j === activeIndex); });
+        grid.setAttribute('aria-activedescendant', items[activeIndex].id);
+      }
+
+      function choose(i) {
+        if (select.selectedIndex !== i) {
+          select.selectedIndex = i;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+        render();
+      }
+
+      function open() {
+        grid.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(select.selectedIndex);
+        grid.focus();
+      }
+
+      function close(restoreFocus) {
+        if (grid.hidden) return;
+        grid.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus !== false) trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () {
+        grid.hidden ? open() : close();
+      });
+
+      trigger.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          open();
+        }
+      });
+
+      grid.addEventListener('keydown', function (e) {
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowDown': setActive(activeIndex + 1); break;
+          case 'ArrowLeft': case 'ArrowUp': setActive(activeIndex - 1); break;
+          case 'Home': setActive(0); break;
+          case 'End': setActive(items.length - 1); break;
+          case 'Enter': case ' ': choose(activeIndex); close(); break;
+          case 'Escape': close(); break;
+          case 'Tab': close(false); return;
+          default: return;
+        }
+        e.preventDefault();
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) close(false);
+      });
+
+      select.addEventListener('change', render);
+      render();
+    })();
+  </script>
+
 </body>
 
