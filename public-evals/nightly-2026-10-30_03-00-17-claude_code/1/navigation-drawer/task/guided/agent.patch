+  <script>
+    const drawer = document.getElementById('drawer');
+    const openBtn = document.getElementById('drawer-open');
+    const closeBtn = document.getElementById('drawer-close');
+    const scroller = drawer.querySelector('.Drawer-scroller');
+    const sheet = drawer.querySelector('.Drawer-sheet');
+    // Everything outside the drawer is made inert while it is open.
+    const pageContent = [...document.body.children].filter(
+      (el) => el !== drawer && el.tagName !== 'SCRIPT'
+    );
+
+    const isOpen = () => drawer.matches(':popover-open');
+
+    async function openDrawer() {
+      drawer.showPopover();
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        // Jump to the closed stop so the scroll below animates the sheet in.
+        scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'instant' });
+        // Two frames are needed for the jump to commit before scrolling again.
+        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+      }
+
+      // 'auto' defers to CSS scroll-behavior (smooth unless reduced motion).
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      // Don't hide the popover here; the observer does that once the sheet
+      // has actually left the viewport so the slide-out stays visible.
+      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
+    }
+
+    function onDrawerOpened() {
+      pageContent.forEach((el) => (el.inert = true));
+      openBtn.setAttribute('aria-expanded', 'true');
+      sheet.focus();
+    }
+
+    function onDrawerClosed() {
+      if (!isOpen()) return;
+      const hadFocus = drawer.contains(document.activeElement);
+      drawer.hidePopover();
+      pageContent.forEach((el) => (el.inert = false));
+      openBtn.setAttribute('aria-expanded', 'false');
+      if (hadFocus) openBtn.focus();
+    }
+
+    // The sheet's visibility is the source of truth for open/closed state,
+    // so swipes, programmatic scrolls and snap settling all converge here.
+    const visibleThreshold = 1 / window.innerWidth;
+    const observer = new IntersectionObserver(
+      (entries) => {
+        const entry = entries.at(-1);
+        if (entry.intersectionRatio < visibleThreshold) onDrawerClosed();
+        if (entry.intersectionRatio === 1) onDrawerOpened();
+      },
+      { root: drawer, threshold: [visibleThreshold, 1] }
+    );
+    observer.observe(sheet);
+
+    openBtn.addEventListener('click', openDrawer);
+    closeBtn.addEventListener('click', closeDrawer);
+
+    // Tapping the backdrop (inside the popover but outside the sheet).
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && isOpen()) closeDrawer();
+    });
+
+    // Backdrop fade fallback where scroll-driven animations are unsupported.
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      scroller.addEventListener('scroll', () => {
+        const ratio = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.min(Math.max(ratio, 0), 1));
+      });
+    }
+  </script>
+
