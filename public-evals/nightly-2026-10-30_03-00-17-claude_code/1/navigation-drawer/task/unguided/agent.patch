+  <script>
+    (() => {
+      const drawer = document.getElementById('nav-drawer');
+      const panel = drawer.querySelector('.drawer-panel');
+
+      // Fallback for browsers without Invoker Commands (command/commandfor).
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        document.querySelectorAll('[commandfor="nav-drawer"]').forEach((button) => {
+          button.addEventListener('click', () => {
+            if (button.getAttribute('command') === 'show-modal') drawer.showModal();
+            else drawer.close();
+          });
+        });
+      }
+
+      // Always reopen with the panel fully in view.
+      drawer.addEventListener('toggle', (event) => {
+        if (event.newState === 'open') drawer.scrollTo({ left: 0, behavior: 'instant' });
+      });
+
+      // Tapping outside the panel (the backdrop area) closes the drawer.
+      drawer.addEventListener('click', (event) => {
+        if (!panel.contains(event.target)) drawer.close();
+      });
+
+      // Close once the panel has been swiped fully out of view.
+      const closeIfSwipedAway = () => {
+        if (drawer.open && drawer.scrollLeft >= panel.offsetWidth - 1) drawer.close();
+      };
+      if ('onscrollend' in window) {
+        drawer.addEventListener('scrollend', closeIfSwipedAway);
+      } else {
+        let timer;
+        drawer.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(closeIfSwipedAway, 100);
+        }, { passive: true });
+      }
+    })();
+  </script>
+
