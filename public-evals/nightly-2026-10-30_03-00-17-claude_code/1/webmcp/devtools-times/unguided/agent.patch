+// Window events that WebMCP tools dispatch to open the header flyouts, which
+// host the declarative search_articles and update_reading_list forms.
+export const OPEN_SEARCH_EVENT = 'devtools-times:open-search';
+export const OPEN_READING_LIST_EVENT = 'devtools-times:open-reading-list';
diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..f5b7d3e
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,208 @@
+// Imperative WebMCP tools for The DevTools Times.
+// The search and reading-list forms are exposed declaratively in SearchFlyout and
+// ReadingListFlyout; the tools below cover client-side article utilities.
+import { navigate } from 'astro:transitions/client';
+import { OPEN_SEARCH_EVENT, OPEN_READING_LIST_EVENT } from './webmcp-events';
+
+interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+  category: string;
+  author: string;
+  date: string;
+  readingTime?: number;
+  tags?: string[];
+}
+
+const BASE_URL = import.meta.env.BASE_URL;
+const SLUG_PATTERN = /^[a-z0-9-]+$/;
+
+const articleUrl = (slug: string) => new URL(`${BASE_URL}articles/${slug}`, location.origin).href;
+
+const textResult = (data: unknown) => ({
+  content: [{ type: 'text', text: JSON.stringify(data, null, 2) }],
+});
+
+let articlesPromise: Promise<ArticleSummary[]> | undefined;
+const fetchArticles = () => {
+  articlesPromise ??= fetch(`${BASE_URL}api/articles.json`)
+    .then(response => {
+      if (!response.ok) throw new Error(`Failed to load articles (${response.status})`);
+      return response.json();
+    })
+    .catch(error => {
+      articlesPromise = undefined;
+      throw error;
+    });
+  return articlesPromise;
+};
+
+const findArticle = async (slug: string) => {
+  if (!SLUG_PATTERN.test(slug)) throw new Error(`Invalid article slug: "${slug}"`);
+  const article = (await fetchArticles()).find(a => a.slug === slug);
+  if (!article) throw new Error(`No article found with slug "${slug}". Use list_articles to find valid slugs.`);
+  return article;
+};
+
+// Reads an article page rendered by pages/articles/[slug].astro.
+const extractArticle = (root: ParentNode) => {
+  const article = root.querySelector<HTMLElement>('[data-article-slug]');
+  if (!article) return null;
+  const body = article.querySelector('[data-article-body]');
+  const text = body
+    ? Array.from(body.querySelectorAll('h1, h2, h3, h4, p, li, blockquote'))
+        .map(el => el.textContent?.trim())
+        .filter(Boolean)
+        .join('\n\n')
+    : '';
+  return {
+    slug: article.dataset.articleSlug!,
+    title: article.querySelector('h1')?.textContent?.trim() ?? '',
+    body: text,
+  };
+};
+
+const getArticleContent = async (slug?: string) => {
+  const current = extractArticle(document);
+  if (current && (!slug || slug === current.slug)) {
+    return { ...current, url: articleUrl(current.slug) };
+  }
+  if (!slug) throw new Error('Not on an article page; provide a slug.');
+
+  await findArticle(slug);
+  const response = await fetch(`${BASE_URL}articles/${slug}`);
+  if (!response.ok) throw new Error(`Failed to load article "${slug}" (${response.status})`);
+  const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
+  const parsed = extractArticle(doc);
+  if (!parsed) throw new Error(`Could not read content of article "${slug}".`);
+  return { ...parsed, url: articleUrl(slug) };
+};
+
+const tools: ModelContextTool[] = [
+  {
+    name: 'list_articles',
+    title: 'List articles',
+    description:
+      'List articles published on The DevTools Times, newest first. Optionally filter by category, author or tag. Returns slugs, titles, summaries, categories, authors, dates and reading times.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: { type: 'string', description: "Case-insensitive category name, e.g. 'sports', 'science', 'Politics'." },
+        author: { type: 'string', description: 'Case-insensitive substring of the author name.' },
+        tag: { type: 'string', description: 'Case-insensitive tag the article must have.' },
+        limit: { type: 'integer', minimum: 1, maximum: 100, description: 'Maximum number of articles to return.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ category, author, tag, limit }: { category?: string; author?: string; tag?: string; limit?: number }) {
+      let articles = [...(await fetchArticles())].sort((a, b) => b.date.localeCompare(a.date));
+      if (category) articles = articles.filter(a => a.category.toLowerCase() === category.toLowerCase());
+      if (author) articles = articles.filter(a => a.author.toLowerCase().includes(author.toLowerCase()));
+      if (tag) articles = articles.filter(a => a.tags?.some(t => t.toLowerCase() === tag.toLowerCase()));
+      if (limit) articles = articles.slice(0, limit);
+      return textResult({
+        count: articles.length,
+        articles: articles.map(({ image, ...rest }) => ({ ...rest, url: articleUrl(rest.slug) })),
+      });
+    },
+  },
+  {
+    name: 'list_categories',
+    title: 'List categories',
+    description: 'List the article categories on The DevTools Times with the number of articles in each.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const counts: Record<string, number> = {};
+      for (const { category } of await fetchArticles()) counts[category] = (counts[category] ?? 0) + 1;
+      return textResult(Object.entries(counts).map(([category, count]) => ({ category, count })));
+    },
+  },
+  {
+    name: 'get_article',
+    title: 'Get article',
+    description:
+      'Get the metadata and full body text of an article. Omit the slug to read the article currently open in the page.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Article slug, e.g. "urban-cycling". Optional when an article page is open.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ slug }: { slug?: string }) {
+      const content = await getArticleContent(slug);
+      const metadata = await findArticle(content.slug).catch(() => undefined);
+      const { image, ...rest } = metadata ?? ({} as Partial<ArticleSummary>);
+      return textResult({ ...rest, ...content });
+    },
+  },
+  {
+    name: 'get_reading_list',
+    title: 'Get reading list',
+    description: "Get the articles saved in the reader's reading list. Use the update_reading_list tool (in the reading list panel) to change it.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const [response, articles] = await Promise.all([fetch(`${BASE_URL}api/reading-list.json`), fetchArticles()]);
+      if (!response.ok) throw new Error(`Failed to load reading list (${response.status})`);
+      const { readingList } = (await response.json()) as { readingList: string[] };
+      return textResult(
+        readingList.map(slug => {
+          const article = articles.find(a => a.slug === slug);
+          return { slug, title: article?.title, url: articleUrl(slug) };
+        })
+      );
+    },
+  },
+  {
+    name: 'open_article',
+    title: 'Open article',
+    description: 'Navigate the page to an article so the reader can see it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Slug of the article to open.' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }: { slug: string }) {
+      const article = await findArticle(slug);
+      await navigate(`${BASE_URL}articles/${slug}`);
+      return textResult({ opened: article.title, url: articleUrl(slug) });
+    },
+  },
+  {
+    name: 'open_search',
+    title: 'Open search panel',
+    description: 'Open the search panel. This makes the search_articles tool available.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_SEARCH_EVENT));
+      return textResult({ opened: 'search' });
+    },
+  },
+  {
+    name: 'open_reading_list',
+    title: 'Open reading list panel',
+    description: 'Open the reading list panel. This makes the update_reading_list tool available.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_READING_LIST_EVENT));
+      return textResult({ opened: 'reading list' });
+    },
+  },
+];
+
+const modelContext = navigator.modelContext;
+if (modelContext) {
+  for (const tool of tools) {
+    try {
+      modelContext.registerTool(tool);
+    } catch (error) {
+      console.warn(`WebMCP: failed to register tool "${tool.name}"`, error);
+    }
+  }
+}
