+++ b/src/pages/api/search.json.ts
@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { searchArticles, toArticleSummary } from '../../utils/articles';
+
+export const GET: APIRoute = async ({ url }) => {
+    const query = url.searchParams.get('q')?.trim() ?? '';
+    const category = url.searchParams.get('category')?.trim() || undefined;
+
+    if (!query && !category) {
+        return new Response(JSON.stringify({ error: 'Provide a search query (q) or a category.' }), {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+        });
+    }
+
+    const results = (await searchArticles(query, category)).map(toArticleSummary);
+
+    return new Response(JSON.stringify({ query, category, results }), {
+        headers: { 'Content-Type': 'application/json' },
+    });
+};
