diff --git a/src/pages/search.astro b/src/pages/search.astro
new file mode 100644
index 0000000..5b59325
--- /dev/null
+++ b/src/pages/search.astro
@@ -0,0 +1,28 @@
+---
+import Layout from '../layouts/Layout.astro';
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import { searchArticles } from '../utils/articles';
+
+const query = Astro.url.searchParams.get('q')?.trim() ?? '';
+const results = query ? await searchArticles(query) : [];
+---
+
+<Layout title={query ? `Search: ${query} | The DevTools Times` : 'Search | The DevTools Times'}>
+    <section class="p-4 md:p-6">
+        <h1 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+            {query ? `Results for “${query}”` : 'Search'}
+        </h1>
+
+        {!query && (
+            <p class="text-gray-500 py-8">Use the search box at the top of the page to find articles.</p>
+        )}
+        {query && results.length === 0 && (
+            <p class="text-gray-500 py-8">No results found for “{query}”.</p>
+        )}
+        {results.length > 0 && (
+            <div class="grid md:grid-cols-3 gap-6">
+                {results.map(article => <ArticleTeaser article={article} />)}
+            </div>
+        )}
+    </section>
+</Layout>
diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..99a20f5
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,344 @@
+import { navigate } from 'astro:transitions/client';
+import { READING_LIST_CHANGE } from '../utils/readingListEvents';
+
+// WebMCP integration for The DevTools Times.
+//
+// Declarative tools: the header search form (`search_articles`) and the reading-list
+// page form (`update_reading_list`) are annotated with `toolname` in their templates.
+// The submit handler below answers agent-invoked submissions with structured results.
+//
+// Imperative tools: article utilities registered through `document.modelContext`,
+// re-registered on every ClientRouter page load and unregistered before each swap.
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+interface ArticleSummary {
+    slug: string;
+    title: string;
+    summary: string;
+    author: string;
+    category: string;
+    date: string;
+    readingTime?: number;
+    tags?: string[];
+}
+
+const articleUrl = (slug: string) => new URL(`${BASE_URL}articles/${slug}`, location.origin).href;
+
+const describeArticle = ({ slug, title, summary, author, category, date, readingTime }: ArticleSummary) => ({
+    slug,
+    title,
+    summary,
+    author,
+    category,
+    date,
+    readingTimeMinutes: readingTime,
+    url: articleUrl(slug),
+});
+
+async function fetchJson<T>(path: string, init?: RequestInit): Promise<{ ok: boolean; status: number; data: T }> {
+    const response = await fetch(`${BASE_URL}${path}`, init);
+    const data = await response.json().catch(() => ({}));
+    return { ok: response.ok, status: response.status, data };
+}
+
+const fetchArticles = async (signal?: AbortSignal) =>
+    (await fetchJson<ArticleSummary[]>('api/articles.json', { signal })).data;
+
+async function updateReadingList(slug: string, action: 'add' | 'remove', signal?: AbortSignal) {
+    const { ok, data } = await fetchJson<{ readingList?: string[]; error?: string }>('api/reading-list.json', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug, action }),
+        signal,
+    });
+    if (ok && data.readingList) {
+        window.dispatchEvent(new CustomEvent(READING_LIST_CHANGE, { detail: { readingList: data.readingList } }));
+    }
+    return { ok, readingList: data.readingList ?? [], error: data.error };
+}
+
+// Returns the error message for the agent instead of throwing, unless the execution was cancelled.
+function toolError(error: unknown, signal: AbortSignal) {
+    if (signal.aborted) throw error;
+    return { error: error instanceof Error ? error.message : String(error) };
+}
+
+// ---------------------------------------------------------------------------
+// Declarative form tools
+// ---------------------------------------------------------------------------
+
+async function respondToSearch(form: HTMLFormElement) {
+    const query = String(new FormData(form).get('q') ?? '').trim();
+    if (!query) {
+        return JSON.stringify({ error: 'Search failed: enter at least one search term.' });
+    }
+
+    const { ok, data } = await fetchJson<{ results?: ArticleSummary[]; error?: string }>(
+        `api/search.json?${new URLSearchParams({ q: query })}`
+    );
+    if (!ok) {
+        return JSON.stringify({ error: data.error ?? 'Search failed, try again.' });
+    }
+
+    const searchUrl = `${BASE_URL}search?${new URLSearchParams({ q: query })}`;
+    return JSON.stringify({
+        query,
+        resultCount: data.results?.length ?? 0,
+        results: (data.results ?? []).map(describeArticle),
+        searchPageUrl: new URL(searchUrl, location.origin).href,
+    });
+}
+
+async function respondToReadingListUpdate(form: HTMLFormElement) {
+    const formData = new FormData(form);
+    const slug = String(formData.get('slug') ?? '');
+    const action = formData.get('action') === 'remove' ? 'remove' : 'add';
+
+    const { ok, readingList, error } = await updateReadingList(slug, action);
+    if (!ok) {
+        return JSON.stringify({ error: `Could not update the reading list: ${error ?? 'unknown error'}` });
+    }
+
+    const articles = await fetchArticles();
+    return JSON.stringify({
+        updated: { slug, action },
+        readingList: readingList
+            .map(saved => articles.find(article => article.slug === saved))
+            .filter(article => article !== undefined)
+            .map(describeArticle),
+    });
+}
+
+// Capture phase so this runs before the ClientRouter's own submit listener,
+// which skips submissions that have already been prevented.
+document.addEventListener('submit', (event) => {
+    const form = event.target;
+    if (!event.agentInvoked || !(form instanceof HTMLFormElement)) return;
+
+    switch (form.getAttribute('toolname')) {
+        case 'search_articles': {
+            event.preventDefault();
+            const result = respondToSearch(form);
+            event.respondWith(result);
+            // Show the same results to the user once the agent has its answer.
+            result.then(() => {
+                const query = String(new FormData(form).get('q') ?? '').trim();
+                if (query) navigate(`${BASE_URL}search?${new URLSearchParams({ q: query })}`);
+            });
+            break;
+        }
+        case 'update_reading_list': {
+            event.preventDefault();
+            const result = respondToReadingListUpdate(form);
+            event.respondWith(result);
+            // Re-render the saved list on the reading-list page.
+            result.then(() => navigate(location.href, { history: 'replace' }));
+            break;
+        }
+    }
+}, { capture: true });
+
+// ---------------------------------------------------------------------------
+// Imperative article utilities
+// ---------------------------------------------------------------------------
+
+function registerSiteTools(modelContext: WebMCP.ModelContext, signal: AbortSignal) {
+    return [
+        modelContext.registerTool({
+            name: 'list_articles',
+            title: 'List articles',
+            description: 'Lists the latest articles published on The DevTools Times, newest first. Use to browse what is available, optionally within one section.',
+            inputSchema: {
+                type: 'object',
+                properties: {
+                    category: { type: 'string', description: 'Section to browse, e.g. sports, science, culture. Leave out to list every section.' },
+                    limit: { type: 'integer', minimum: 1, maximum: 50, default: 10, description: 'How many articles to return.' },
+                },
+            },
+            async execute({ category, limit = 10 }, { signal }) {
+                if (!Number.isInteger(limit) || limit < 1 || limit > 50) {
+                    return { error: 'limit must be a whole number from 1 to 50.' };
+                }
+                try {
+                    const articles = (await fetchArticles(signal)).sort((a, b) => b.date.localeCompare(a.date));
+                    const categories = [...new Set(articles.map(article => article.category))];
+                    const filtered = category
+                        ? articles.filter(article => article.category === category.trim().toLowerCase())
+                        : articles;
+                    if (category && filtered.length === 0) {
+                        return { error: `No articles in category "${category}".`, availableCategories: categories };
+                    }
+                    return { total: filtered.length, articles: filtered.slice(0, limit).map(describeArticle) };
+                } catch (error) {
+                    return toolError(error, signal);
+                }
+            },
+            annotations: { readOnlyHint: true },
+        }, { signal }),
+
+        modelContext.registerTool({
+            name: 'get_reading_list',
+            title: 'Get reading list',
+            description: "Returns the articles the reader has saved to their reading list.",
+            inputSchema: { type: 'object', properties: {} },
+            async execute(_input, { signal }) {
+                try {
+                    const [{ data }, articles] = await Promise.all([
+                        fetchJson<{ readingList: string[] }>('api/reading-list.json', { signal }),
+                        fetchArticles(signal),
+                    ]);
+                    const saved = data.readingList
+                        .map(slug => articles.find(article => article.slug === slug))
+                        .filter(article => article !== undefined);
+                    return { count: saved.length, articles: saved.map(describeArticle) };
+                } catch (error) {
+                    return toolError(error, signal);
+                }
+            },
+            annotations: { readOnlyHint: true },
+        }, { signal }),
+
+        modelContext.registerTool({
+            name: 'open_article',
+            title: 'Open article',
+            description: 'Opens an article in the current tab so the reader can read it.',
+            inputSchema: {
+                type: 'object',
+                properties: {
+                    slug: { type: 'string', description: 'The article slug, as returned by list_articles, get_reading_list or search_articles.' },
+                },
+                required: ['slug'],
+            },
+            async execute({ slug }, { signal }) {
+                try {
+                    const article = (await fetchArticles(signal)).find(article => article.slug === slug);
+                    if (!article) {
+                        return { error: `No article with slug "${slug}". Use list_articles or search_articles to find valid slugs.` };
+                    }
+                    signal.throwIfAborted();
+                    await navigate(articleUrl(article.slug));
+                    return { opened: describeArticle(article) };
+                } catch (error) {
+                    return toolError(error, signal);
+                }
+            },
+        }, { signal }),
+    ];
+}
+
+function registerArticleTools(modelContext: WebMCP.ModelContext, signal: AbortSignal, articleElement: HTMLElement) {
+    const { articleSlug: slug = '', articleReadingTime } = articleElement.dataset;
+    const body = articleElement.querySelector<HTMLElement>('[data-article-body]');
+    const passages = () =>
+        [...(body?.querySelectorAll<HTMLElement>('p, li, h2, h3, h4, blockquote') ?? [])]
+            .filter(element => element.textContent?.trim());
+
+    return [
+        modelContext.registerTool({
+            name: 'get_article_content',
+            title: 'Get current article',
+            description: 'Returns the full text and details of the article open on this page. Use to read, summarize or answer questions about it.',
+            inputSchema: { type: 'object', properties: {} },
+            execute() {
+                const text = body?.innerText.trim() ?? '';
+                const wordCount = text.split(/\s+/).filter(Boolean).length;
+                return {
+                    slug,
+                    url: articleUrl(slug),
+                    title: articleElement.querySelector('h1')?.textContent?.trim(),
+                    summary: articleElement.dataset.articleSummary,
+                    author: articleElement.dataset.articleAuthor,
+                    category: articleElement.dataset.articleCategory,
+                    date: articleElement.dataset.articleDate,
+                    wordCount,
+                    readingTimeMinutes: Number(articleReadingTime) || Math.max(1, Math.round(wordCount / 230)),
+                    sections: [...(body?.querySelectorAll('h2, h3') ?? [])].map(heading => heading.textContent?.trim()),
+                    text,
+                };
+            },
+            annotations: { readOnlyHint: true },
+        }, { signal }),
+
+        modelContext.registerTool({
+            name: 'find_in_article',
+            title: 'Find in article',
+            description: 'Finds passages in the open article that mention a word or phrase, and scrolls the first match into view.',
+            inputSchema: {
+                type: 'object',
+                properties: {
+                    query: { type: 'string', description: 'Word or phrase to look for, e.g. Maillard reaction.' },
+                },
+                required: ['query'],
+            },
+            execute({ query }) {
+                const needle = typeof query === 'string' ? query.trim().toLowerCase() : '';
+                if (!needle) {
+                    return { error: 'Pass a word or phrase to look for.' };
+                }
+                const matches = passages().filter(element => element.textContent!.toLowerCase().includes(needle));
+                if (matches.length === 0) {
+                    return { query, matchCount: 0, passages: [] };
+                }
+                matches[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
+                return {
+                    query,
+                    matchCount: matches.length,
+                    passages: matches.slice(0, 10).map(element => element.textContent!.trim()),
+                };
+            },
+            annotations: { readOnlyHint: true },
+        }, { signal }),
+
+        modelContext.registerTool({
+            name: 'bookmark_current_article',
+            title: 'Bookmark current article',
+            description: "Saves the article open on this page to the reader's reading list, or removes it.",
+            inputSchema: {
+                type: 'object',
+                properties: {
+                    action: { type: 'string', enum: ['add', 'remove'], default: 'add', description: 'Whether to save the article or take it off the reading list.' },
+                },
+            },
+            async execute({ action = 'add' }, { signal }) {
+                if (action !== 'add' && action !== 'remove') {
+                    return { error: 'action must be "add" or "remove".' };
+                }
+                try {
+                    const { ok, readingList, error } = await updateReadingList(slug, action, signal);
+                    if (!ok) {
+                        return { error: `Could not update the reading list: ${error ?? 'unknown error'}` };
+                    }
+                    return { slug, bookmarked: readingList.includes(slug), readingListSize: readingList.length };
+                } catch (error) {
+                    return toolError(error, signal);
+                }
+            },
+        }, { signal }),
+    ];
+}
+
+let registration: AbortController | undefined;
+
+function registerTools() {
+    registration?.abort();
+    const modelContext = document.modelContext;
+    if (!modelContext) return;
+
+    registration = new AbortController();
+    const { signal } = registration;
+    const articleElement = document.querySelector<HTMLElement>('[data-article-slug]');
+
+    const pending = [
+        ...registerSiteTools(modelContext, signal),
+        ...(articleElement ? registerArticleTools(modelContext, signal, articleElement) : []),
+    ];
+    Promise.allSettled(pending).then(results => {
+        for (const result of results) {
+            if (result.status === 'rejected') console.warn('WebMCP tool registration failed:', result.reason);
+        }
+    });
+}
+
+document.addEventListener('astro:page-load', registerTools);
+document.addEventListener('astro:before-swap', () => registration?.abort());
