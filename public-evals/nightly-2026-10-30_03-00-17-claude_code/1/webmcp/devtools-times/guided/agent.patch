+---
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+
+const baseUrl = import.meta.env.BASE_URL;
+const articles = (await getCollection('articles')).sort((a, b) => a.data.title.localeCompare(b.data.title));
+const readingList: string[] = await Astro.session?.get('readingList') || [];
+const savedArticles = readingList
+    .map(slug => articles.find(article => article.id === slug))
+    .filter(article => article !== undefined);
+---
+
+<Layout title="Reading List | The DevTools Times">
+    <section class="p-4 md:p-6 max-w-3xl">
+        <h1 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Your Reading List</h1>
+
+        {savedArticles.length === 0 && (
+            <p class="text-gray-500 py-4">Your reading list is empty.</p>
+        )}
+        <ul class="space-y-2 mb-10">
+            {savedArticles.map(article => (
+                <li class="flex items-center gap-2">
+                    <a href={`${baseUrl}articles/${article.id}`} class="block hover:bg-gray-100 p-4 rounded-md transition-colors flex-grow">
+                        <h2 class="font-bold text-lg text-gray-800">{article.data.title}</h2>
+                        <p class="text-sm text-gray-600">{article.data.summary}</p>
+                    </a>
+                    <form method="post" action={`${baseUrl}api/reading-list.json`}>
+                        <input type="hidden" name="slug" value={article.id} />
+                        <input type="hidden" name="action" value="remove" />
+                        <button type="submit" class="p-2 text-sm text-gray-500 hover:text-amber-700">Remove</button>
+                    </form>
+                </li>
+            ))}
+        </ul>
+
+        <h2 class="text-xl font-bold mb-4">Update your reading list</h2>
+        <form
+            method="post"
+            action={`${baseUrl}api/reading-list.json`}
+            class="webmcp-reading-list-form space-y-4 p-4 border border-gray-200 rounded-md"
+            toolname="update_reading_list"
+            tooldescription="Save an article to the reader's reading list or remove one from it. Use when the user wants to bookmark an article to read later or clean up saved articles."
+            toolautosubmit
+        >
+            <div>
+                <label for="reading-list-article" class="block text-sm font-semibold text-gray-700 mb-1">Article</label>
+                <select
+                    id="reading-list-article"
+                    name="slug"
+                    required
+                    class="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+                >
+                    {articles.map(article => (
+                        <option value={article.id} selected={article.id === Astro.url.searchParams.get('slug')}>{article.data.title}</option>
+                    ))}
+                </select>
+            </div>
+
+            <fieldset toolparamdescription="Whether to save the article or take it off the reading list">
+                <legend class="text-sm font-semibold text-gray-700 mb-1">Action</legend>
+                <div class="flex gap-6">
+                    <label class="flex items-center gap-2">
+                        <input type="radio" name="action" value="add" checked /> Save
+                    </label>
+                    <label class="flex items-center gap-2">
+                        <input type="radio" name="action" value="remove" /> Remove
+                    </label>
+                </div>
+            </fieldset>
+
+            <button type="submit" class="bg-gray-800 text-white text-sm font-semibold py-2 px-4 rounded hover:bg-gray-700">
+                Update reading list
+            </button>
+        </form>
+    </section>
