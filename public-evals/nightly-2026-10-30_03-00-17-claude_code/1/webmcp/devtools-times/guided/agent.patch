+import { getCollection, type CollectionEntry } from 'astro:content';
+
+export interface ArticleSummary {
+    slug: string;
+    title: string;
+    summary: string;
+    author: string;
+    category: string;
+    date: string;
+    image: string;
+    readingTime?: number;
+    tags?: string[];
+}
+
+export function toArticleSummary(article: CollectionEntry<'articles'>): ArticleSummary {
+    return {
+        slug: article.id,
+        title: article.data.title,
+        summary: article.data.summary,
+        author: article.data.author,
+        category: article.data.category.toLowerCase(),
+        date: article.data.date.toISOString().slice(0, 10),
+        image: article.data.image,
+        readingTime: article.data.readingTime,
+        tags: article.data.tags,
+    };
+}
+
+// Matches every whitespace-separated term against title, summary, category, author and tags.
+export async function searchArticles(query: string, category?: string) {
+    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+    const articles = await getCollection('articles', ({ data }) =>
+        !category || data.category.toLowerCase() === category.toLowerCase()
+    );
+
+    return articles
+        .filter(({ data }) => {
+            const haystack = [data.title, data.summary, data.category, data.author, ...(data.tags ?? [])]
+                .join(' ')
+                .toLowerCase();
+            return terms.every(term => haystack.includes(term));
+        })
+        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+}
