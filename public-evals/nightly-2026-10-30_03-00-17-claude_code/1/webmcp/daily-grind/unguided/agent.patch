diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..c9c9565
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,542 @@
+/*
+ * The Daily Grind — Seasonal Favorites menu, order panel, and WebMCP tools.
+ *
+ * WebMCP (navigator.modelContext) lets in-browser AI agents call these tools
+ * directly. Every tool drives the same UI code paths a human uses, so the page
+ * always reflects what the agent did. If the browser has no WebMCP support the
+ * page still works normally; the tools just aren't registered.
+ */
+(function () {
+  'use strict';
+
+  // ---------------------------------------------------------------------------
+  // Menu data
+  // ---------------------------------------------------------------------------
+
+  var SIZES = { small: 0, medium: 0.5, large: 1.0 };
+  var MILKS = { whole: 0, skim: 0, oat: 0.75, almond: 0.75, none: 0 };
+  var EXTRA_SHOT_PRICE = 0.9;
+  var MAX_QUANTITY = 10;
+  var MAX_EXTRA_SHOTS = 4;
+
+  var SEASONAL_MENU = [
+    {
+      id: 'maple-oat-latte',
+      name: 'Maple Oat Latte',
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      basePrice: 5.25,
+      temperatures: ['hot', 'iced'],
+      defaultMilk: 'oat',
+      milkOptions: ['oat', 'almond', 'whole', 'skim'],
+      caffeineMg: 150,
+      tags: ['dairy-free', 'seasonal', 'sweet'],
+      detailsUrl: '/menu/seasonal'
+    },
+    {
+      id: 'dark-roast-espresso',
+      name: 'Dark Roast Espresso',
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      basePrice: 3.25,
+      temperatures: ['hot'],
+      defaultMilk: 'none',
+      milkOptions: ['none'],
+      caffeineMg: 130,
+      tags: ['dairy-free', 'strong'],
+      detailsUrl: '/menu/espresso'
+    },
+    {
+      id: 'cold-brew',
+      name: 'Cold Brew',
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      basePrice: 4.5,
+      temperatures: ['iced'],
+      defaultMilk: 'none',
+      milkOptions: ['none', 'oat', 'almond', 'whole', 'skim'],
+      caffeineMg: 200,
+      tags: ['dairy-free', 'smooth'],
+      detailsUrl: '/menu/cold-brew'
+    }
+  ];
+
+  var FILTERS = ['all', 'hot', 'iced', 'dairy-free'];
+
+  function findDrink(id) {
+    for (var i = 0; i < SEASONAL_MENU.length; i++) {
+      if (SEASONAL_MENU[i].id === id) return SEASONAL_MENU[i];
+    }
+    return null;
+  }
+
+  function matchesFilter(drink, filter) {
+    if (filter === 'all') return true;
+    if (filter === 'hot' || filter === 'iced') return drink.temperatures.indexOf(filter) !== -1;
+    return drink.tags.indexOf(filter) !== -1;
+  }
+
+  function money(n) {
+    return '$' + n.toFixed(2);
+  }
+
+  function round2(n) {
+    return Math.round(n * 100) / 100;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Page state & rendering
+  // ---------------------------------------------------------------------------
+
+  var state = {
+    filter: 'all',
+    order: [], // { lineId, drinkId, name, size, milk, temperature, extraShots, quantity, unitPrice }
+    nextLineId: 1,
+    lastPlacedOrder: null
+  };
+
+  var els = {
+    grid: document.getElementById('seasonal-grid'),
+    filters: document.getElementById('menu-filters'),
+    items: document.getElementById('order-items'),
+    empty: document.getElementById('order-empty'),
+    total: document.getElementById('order-total'),
+    placeBtn: document.getElementById('place-order-btn'),
+    status: document.getElementById('order-status'),
+    panel: document.getElementById('order-panel'),
+    toast: document.getElementById('toast')
+  };
+
+  function el(tag, className, text) {
+    var node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text != null) node.textContent = text;
+    return node;
+  }
+
+  function renderMenu() {
+    els.grid.textContent = '';
+    SEASONAL_MENU.forEach(function (drink) {
+      var card = el('div', 'card');
+      card.id = 'drink-' + drink.id;
+      card.dataset.drinkId = drink.id;
+
+      card.appendChild(el('h3', null, drink.name));
+      card.appendChild(el('p', null, drink.description));
+      card.appendChild(el('p', 'meta',
+        'From ' + money(drink.basePrice) + ' · ' + drink.temperatures.join(' / ') + ' · ' + drink.caffeineMg + 'mg caffeine'));
+
+      var tags = el('div', 'tags');
+      drink.tags.forEach(function (t) { tags.appendChild(el('span', 'tag', t)); });
+      card.appendChild(tags);
+
+      var actions = el('div', 'card-actions');
+      var details = el('a', 'btn', 'View Details');
+      details.href = drink.detailsUrl;
+      var add = el('button', 'btn btn-accent', 'Add to Order');
+      add.type = 'button';
+      add.addEventListener('click', function () {
+        addToOrder({ drinkId: drink.id });
+      });
+      actions.appendChild(details);
+      actions.appendChild(add);
+      card.appendChild(actions);
+
+      els.grid.appendChild(card);
+    });
+    applyFilter(state.filter);
+  }
+
+  function applyFilter(filter) {
+    state.filter = filter;
+    Array.prototype.forEach.call(els.grid.children, function (card) {
+      card.hidden = !matchesFilter(findDrink(card.dataset.drinkId), filter);
+    });
+    Array.prototype.forEach.call(els.filters.querySelectorAll('button'), function (btn) {
+      btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
+    });
+    return SEASONAL_MENU.filter(function (d) { return matchesFilter(d, filter); });
+  }
+
+  function orderTotal() {
+    return round2(state.order.reduce(function (sum, line) {
+      return sum + line.unitPrice * line.quantity;
+    }, 0));
+  }
+
+  function describeLine(line) {
+    var parts = [line.size, line.temperature, line.name];
+    var extras = [];
+    if (line.milk !== 'none') extras.push(line.milk + ' milk');
+    if (line.extraShots) extras.push('+' + line.extraShots + ' shot' + (line.extraShots > 1 ? 's' : ''));
+    return line.quantity + '× ' + parts.join(' ') + (extras.length ? ' (' + extras.join(', ') + ')' : '');
+  }
+
+  function renderOrder() {
+    els.items.textContent = '';
+    state.order.forEach(function (line) {
+      var li = el('li');
+      li.appendChild(el('span', null, describeLine(line)));
+      var right = el('span');
+      right.appendChild(document.createTextNode(money(line.unitPrice * line.quantity) + ' '));
+      var remove = el('button', 'remove', 'Remove');
+      remove.type = 'button';
+      remove.setAttribute('aria-label', 'Remove ' + line.name);
+      remove.addEventListener('click', function () { removeFromOrder(line.lineId); });
+      right.appendChild(remove);
+      li.appendChild(right);
+      els.items.appendChild(li);
+    });
+
+    var hasItems = state.order.length > 0;
+    els.empty.hidden = hasItems;
+    els.total.hidden = !hasItems;
+    els.placeBtn.hidden = !hasItems;
+    els.total.textContent = 'Total: ' + money(orderTotal());
+  }
+
+  var toastTimer = null;
+  function showToast(message) {
+    els.toast.textContent = message;
+    els.toast.classList.add('show');
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(function () { els.toast.classList.remove('show'); }, 3000);
+  }
+
+  function highlightDrink(drinkId) {
+    var card = document.getElementById('drink-' + drinkId);
+    if (!card) return false;
+    if (card.hidden) applyFilter('all');
+    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    card.classList.add('highlight');
+    setTimeout(function () { card.classList.remove('highlight'); }, 2500);
+    return true;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Order actions (shared by UI and WebMCP tools)
+  // ---------------------------------------------------------------------------
+
+  function OrderError(message) {
+    this.message = message;
+  }
+
+  function addToOrder(opts) {
+    var drink = findDrink(opts.drinkId);
+    if (!drink) throw new OrderError('Unknown drink "' + opts.drinkId + '". Call get_seasonal_menu for valid ids.');
+
+    var size = opts.size || 'medium';
+    if (!(size in SIZES)) throw new OrderError('Invalid size "' + size + '". Choose one of: ' + Object.keys(SIZES).join(', ') + '.');
+
+    var temperature = opts.temperature || drink.temperatures[0];
+    if (drink.temperatures.indexOf(temperature) === -1) {
+      throw new OrderError(drink.name + ' is only available ' + drink.temperatures.join(' or ') + '.');
+    }
+
+    var milk = opts.milk || drink.defaultMilk;
+    if (drink.milkOptions.indexOf(milk) === -1) {
+      throw new OrderError(drink.name + ' milk options are: ' + drink.milkOptions.join(', ') + '.');
+    }
+
+    var extraShots = opts.extraShots == null ? 0 : opts.extraShots;
+    if (!Number.isInteger(extraShots) || extraShots < 0 || extraShots > MAX_EXTRA_SHOTS) {
+      throw new OrderError('extraShots must be an integer from 0 to ' + MAX_EXTRA_SHOTS + '.');
+    }
+
+    var quantity = opts.quantity == null ? 1 : opts.quantity;
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) {
+      throw new OrderError('quantity must be an integer from 1 to ' + MAX_QUANTITY + '.');
+    }
+
+    var line = {
+      lineId: state.nextLineId++,
+      drinkId: drink.id,
+      name: drink.name,
+      size: size,
+      temperature: temperature,
+      milk: milk,
+      extraShots: extraShots,
+      quantity: quantity,
+      unitPrice: round2(drink.basePrice + SIZES[size] + MILKS[milk] + extraShots * EXTRA_SHOT_PRICE)
+    };
+    state.order.push(line);
+    state.lastPlacedOrder = null;
+    els.status.hidden = true;
+    renderOrder();
+    highlightDrink(drink.id);
+    showToast('Added ' + describeLine(line));
+    return line;
+  }
+
+  function removeFromOrder(lineId) {
+    var idx = -1;
+    for (var i = 0; i < state.order.length; i++) {
+      if (state.order[i].lineId === lineId) idx = i;
+    }
+    if (idx === -1) throw new OrderError('No order line with lineId ' + lineId + '. Call get_current_order to see lines.');
+    var removed = state.order.splice(idx, 1)[0];
+    renderOrder();
+    showToast('Removed ' + removed.name);
+    return removed;
+  }
+
+  function clearOrder() {
+    state.order = [];
+    renderOrder();
+  }
+
+  // Orders are fulfilled in-store; this confirms the order on the page and
+  // issues a pickup number.
+  function placeOrder() {
+    if (!state.order.length) throw new OrderError('The order is empty. Add drinks before placing it.');
+    var placed = {
+      orderNumber: 'DG-' + String(Date.now()).slice(-6),
+      items: summarizeOrder().items,
+      total: orderTotal(),
+      estimatedReadyMinutes: 5 + state.order.reduce(function (n, l) { return n + l.quantity; }, 0) * 2
+    };
+    state.lastPlacedOrder = placed;
+    clearOrder();
+    els.status.textContent = 'Order ' + placed.orderNumber + ' placed! Ready for pickup in about ' +
+      placed.estimatedReadyMinutes + ' minutes.';
+    els.status.hidden = false;
+    els.panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    showToast('Order ' + placed.orderNumber + ' placed');
+    return placed;
+  }
+
+  function summarizeOrder() {
+    return {
+      items: state.order.map(function (line) {
+        return {
+          lineId: line.lineId,
+          drinkId: line.drinkId,
+          description: describeLine(line),
+          size: line.size,
+          temperature: line.temperature,
+          milk: line.milk,
+          extraShots: line.extraShots,
+          quantity: line.quantity,
+          unitPrice: line.unitPrice,
+          lineTotal: round2(line.unitPrice * line.quantity)
+        };
+      }),
+      total: orderTotal()
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // UI wiring
+  // ---------------------------------------------------------------------------
+
+  els.filters.addEventListener('click', function (e) {
+    var btn = e.target.closest('button[data-filter]');
+    if (btn) applyFilter(btn.dataset.filter);
+  });
+
+  els.placeBtn.addEventListener('click', function () {
+    placeOrder();
+  });
+
+  renderMenu();
+  renderOrder();
+
+  // ---------------------------------------------------------------------------
+  // WebMCP tools
+  // ---------------------------------------------------------------------------
+
+  var modelContext = navigator.modelContext;
+  if (!modelContext || typeof modelContext.registerTool !== 'function') return;
+
+  function textResult(data) {
+    return {
+      content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }]
+    };
+  }
+
+  function errorResult(message) {
+    return { content: [{ type: 'text', text: message }], isError: true };
+  }
+
+  // Wraps an execute function so validation errors come back to the agent as
+  // tool errors instead of rejected promises.
+  function safe(fn) {
+    return async function (input, client) {
+      try {
+        return await fn(input || {}, client);
+      } catch (err) {
+        if (err instanceof OrderError) return errorResult(err.message);
+        throw err;
+      }
+    };
+  }
+
+  function publicDrink(drink) {
+    return {
+      id: drink.id,
+      name: drink.name,
+      description: drink.description,
+      basePrice: drink.basePrice,
+      temperatures: drink.temperatures,
+      defaultMilk: drink.defaultMilk,
+      milkOptions: drink.milkOptions,
+      caffeineMg: drink.caffeineMg,
+      tags: drink.tags
+    };
+  }
+
+  var drinkIds = SEASONAL_MENU.map(function (d) { return d.id; });
+
+  var tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'List the Daily Grind "Seasonal Favorites" drinks with ids, prices, available temperatures, ' +
+        'milk options, caffeine, and tags. Also returns size and add-on pricing. Optionally filter by temperature, ' +
+        'tag, or maximum base price.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          temperature: { type: 'string', enum: ['hot', 'iced'], description: 'Only drinks available at this temperature.' },
+          tag: { type: 'string', description: 'Only drinks with this tag, e.g. "dairy-free", "strong", "sweet".' },
+          maxPrice: { type: 'number', minimum: 0, description: 'Only drinks with a base price at or below this (USD).' }
+        }
+      },
+      annotations: { readOnlyHint: true },
+      execute: safe(function (input) {
+        var drinks = SEASONAL_MENU.filter(function (d) {
+          if (input.temperature && d.temperatures.indexOf(input.temperature) === -1) return false;
+          if (input.tag && d.tags.indexOf(String(input.tag).toLowerCase()) === -1) return false;
+          if (typeof input.maxPrice === 'number' && d.basePrice > input.maxPrice) return false;
+          return true;
+        });
+        return textResult({
+          currency: 'USD',
+          drinks: drinks.map(publicDrink),
+          pricing: {
+            sizeSurcharge: SIZES,
+            milkSurcharge: MILKS,
+            extraShot: EXTRA_SHOT_PRICE,
+            maxExtraShots: MAX_EXTRA_SHOTS,
+            maxQuantityPerLine: MAX_QUANTITY
+          }
+        });
+      })
+    },
+    {
+      name: 'show_drink',
+      description: 'Scroll the page to a Seasonal Favorites drink and briefly highlight its card so the user can see it.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          drinkId: { type: 'string', enum: drinkIds, description: 'Drink id from get_seasonal_menu.' }
+        },
+        required: ['drinkId']
+      },
+      execute: safe(function (input) {
+        if (!highlightDrink(input.drinkId)) throw new OrderError('Unknown drink "' + input.drinkId + '".');
+        return textResult('Highlighted ' + findDrink(input.drinkId).name + ' on the page.');
+      })
+    },
+    {
+      name: 'filter_seasonal_menu',
+      description: 'Change which Seasonal Favorites cards are visible on the page. Returns the drinks now shown.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          filter: { type: 'string', enum: FILTERS, description: '"all" shows every drink.' }
+        },
+        required: ['filter']
+      },
+      execute: safe(function (input) {
+        if (FILTERS.indexOf(input.filter) === -1) {
+          throw new OrderError('Invalid filter. Choose one of: ' + FILTERS.join(', ') + '.');
+        }
+        var shown = applyFilter(input.filter);
+        return textResult({ filter: input.filter, visibleDrinks: shown.map(function (d) { return d.name; }) });
+      })
+    },
+    {
+      name: 'add_drink_to_order',
+      description: 'Add a Seasonal Favorites drink to the order panel on the page. Unspecified options use defaults ' +
+        '(medium, first available temperature, the drink\'s default milk, no extra shots, quantity 1). ' +
+        'Returns the added line and the updated order.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          drinkId: { type: 'string', enum: drinkIds, description: 'Drink id from get_seasonal_menu.' },
+          size: { type: 'string', enum: Object.keys(SIZES) },
