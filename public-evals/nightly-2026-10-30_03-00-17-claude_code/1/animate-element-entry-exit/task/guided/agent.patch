+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const toggleBtn = document.getElementById('toggleBtn');
+
+    const promos = [
+      { tag: 'Limited Time', title: 'Buy One, Get One Cold Brew', text: 'Bring a friend &mdash; the second cold brew is on us.' },
+      { tag: 'Rewards', title: 'Double Stars Weekend', text: 'Earn 2x rewards stars on every order, Saturday and Sunday.' },
+      { tag: 'New', title: 'Pumpkin Spice Is Back', text: 'Our house-made pumpkin syrup returns for the season.' },
+      { tag: 'Bundle', title: 'Beans &amp; Mug Combo', text: 'Take home a bag of our house roast plus a ceramic mug for $25.' },
+    ];
+    let promoIndex = 0;
+
+    // Firefox parses allow-discrete but doesn't transition `display` yet,
+    // so probe for real support before relying on it for exit animations.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+
+      // Skipped if showElement() cancelled the close mid-animation.
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      el.setAttribute('data-removing', '');
+      await hideElement(el);
+      el.remove();
+    }
+
+    function createPromoCard({ tag, title, text }) {
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <span class="promo-tag">${tag}</span>
+        <h3>${title}</h3>
+        <p>${text}</p>
+        <a href="/promotions" class="btn">View Details</a>
+      `;
+      return card;
+    }
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      domContainer.appendChild(createPromoCard(promos[promoIndex % promos.length]));
+      promoIndex++;
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      // Skip cards that are already animating out
+      const cards = domContainer.querySelectorAll(':scope > .card:not([data-removing])');
+      const last = cards[cards.length - 1];
+      if (last) removeElement(last);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const card = document.getElementById('toggleCard');
+      if (!card || card.hasAttribute('data-removing')) return;
+      const isHidden = card.hidden || card.hasAttribute('data-closing');
+      if (isHidden) {
+        showElement(card);
+      } else {
+        hideElement(card);
+      }
+      toggleBtn.setAttribute('aria-expanded', String(isHidden));
+    });
+  </script>
+
