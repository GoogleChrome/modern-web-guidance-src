+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var toggleCard = document.getElementById('toggleCard');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var promos = [
+        { title: 'Buy One, Get One Cold Brew', text: 'Bring a friend &mdash; the second cold brew is on us.', img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Iced coffee in a glass' },
+        { title: 'Double Rewards Weekend', text: 'Earn 2x stars on every purchase this Saturday and Sunday.', img: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80', alt: 'Cozy coffee shop interior' },
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink before 10 AM.', img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80', alt: 'Fresh croissants' },
+        { title: 'Beans to Go', text: '20% off all 12oz bags of house-roasted whole beans.', img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' }
+      ];
+      var count = 0;
+
+      function createCard() {
+        var promo = promos[count % promos.length];
+        count++;
+        var card = document.createElement('div');
+        card.className = 'card promo-card';
+        card.innerHTML =
+          '<img src="' + promo.img + '" alt="' + promo.alt + '" loading="lazy">' +
+          '<span class="promo-badge">Promo #' + count + '</span>' +
+          '<h3>' + promo.title + '</h3>' +
+          '<p>' + promo.text + '</p>';
+        return card;
+      }
+
+      function removeWithAnimation(card) {
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          card.remove();
+        }
+        card.classList.add('is-leaving');
+        card.addEventListener('animationend', finish, { once: true });
+        // Fallback in case animationend never fires (e.g. card is hidden)
+        setTimeout(finish, 500);
+      }
+
+      document.getElementById('addBtn').addEventListener('click', function () {
+        container.appendChild(createCard());
+      });
+
+      document.getElementById('removeBtn').addEventListener('click', function () {
+        // Skip cards already animating out so repeated clicks remove distinct cards
+        var cards = container.querySelectorAll('.card:not(.is-leaving)');
+        if (cards.length) removeWithAnimation(cards[cards.length - 1]);
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        if (!toggleCard.isConnected) return;
+        toggleCard.hidden = !toggleCard.hidden;
+        toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      });
+    })();
+  </script>
+
