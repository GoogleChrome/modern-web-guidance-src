+    .promo-card {
+      padding: 0 0 20px;
+      overflow: hidden;
+      transform-origin: center;
+      animation: promo-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+      /* Lets the hidden attribute fade/scale out before display: none applies */
+      transition: opacity 0.35s ease, transform 0.35s ease, display 0.35s allow-discrete;
