+  const response = await next();
+  try {
+    response.headers.set('Permissions-Policy', PERMISSIONS_POLICY);
+    return response;
+  } catch {
+    // Some responses (e.g. Response.redirect) have immutable headers
+    const headers = new Headers(response.headers);
