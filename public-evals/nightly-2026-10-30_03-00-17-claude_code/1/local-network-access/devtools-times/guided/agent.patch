diff --git a/src/components/LocalDeviceConnect.tsx b/src/components/LocalDeviceConnect.tsx
new file mode 100644
index 0000000..7533a2d
--- /dev/null
+++ b/src/components/LocalDeviceConnect.tsx
@@ -0,0 +1,164 @@
+import React, { useEffect, useState } from 'react';
+import {
+  fetchLocal,
+  inferAddressSpace,
+  permissionForAddressSpace,
+  queryLnaPermission,
+  type LnaPermissionState,
+} from '../utils/localNetwork';
+
+const STORAGE_KEY = 'localDeviceUrl';
+const DEFAULT_URL = 'http://127.0.0.1:45678/health';
+
+export default function LocalDeviceConnect() {
+  const [url, setUrl] = useState(DEFAULT_URL);
+  const [permission, setPermission] = useState<LnaPermissionState | null>(null);
+  const [secure, setSecure] = useState(true);
+  const [result, setResult] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  let space: ReturnType<typeof inferAddressSpace> | null = null;
+  try {
+    space = inferAddressSpace(url);
+  } catch {
+    space = null;
+  }
+  const permissionName = space ? permissionForAddressSpace(space) : null;
+
+  const connect = async (targetUrl = url) => {
+    setError(null);
+    setResult(null);
+    setLoading(true);
+
+    try {
+      const response = await fetchLocal(targetUrl);
+      if (!response.ok) {
+        throw new Error(`Device responded with HTTP ${response.status}`);
+      }
+      const text = await response.text();
+      setResult(text);
+      localStorage.setItem(STORAGE_KEY, targetUrl);
+    } catch (err) {
+      // fetch() rejects with a TypeError when the permission is denied, the device
+      // is unreachable, CORS fails, or the host didn't resolve to the declared space.
+      setError(err instanceof Error && !(err instanceof TypeError)
+        ? err.message
+        : 'Could not reach the device. Make sure it is powered on, on the same network, allows this site via CORS, and that local network access is allowed for this site.');
+    } finally {
+      setLoading(false);
+      if (permissionName) {
+        setPermission(await queryLnaPermission(permissionName));
+      }
+    }
+  };
+
+  // Restore the last used device URL
+  useEffect(() => {
+    setSecure(window.isSecureContext);
+    const saved = localStorage.getItem(STORAGE_KEY);
+    if (saved) {
+      setUrl(saved);
+    }
+  }, []);
+
+  // Track permission state for the target address space; only connect
+  // automatically if access was already granted (never prompt on load).
+  useEffect(() => {
+    if (!permissionName) {
+      return;
+    }
+    let active = true;
+    queryLnaPermission(permissionName, (state) => active && setPermission(state)).then((state) => {
+      if (!active) return;
+      setPermission(state);
+      if (state === 'granted' && localStorage.getItem(STORAGE_KEY) === url) {
+        connect(url);
+      }
+    });
+    return () => {
+      active = false;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [permissionName]);
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    connect();
+  };
+
+  const settingName = space === 'loopback' ? 'Loopback network' : 'Local network';
+
+  return (
+    <div className="max-w-xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 className="text-2xl font-bold mb-2 text-gray-800">Connect a Local Device</h2>
+      <p className="text-sm text-gray-600 mb-6">
+        Connect The DevTools Times to a device on your home network (such as a smart display or printer)
+        or to a companion app running on this computer. Your browser will ask for permission before
+        this site can reach your local network.
+      </p>
+
+      {!secure && (
+        <div className="mb-4 p-3 text-sm text-yellow-800 bg-yellow-100 rounded-lg" role="alert">
+          Local network access requires a secure (HTTPS) connection. Please reload this page over HTTPS.
+        </div>
+      )}
+
+      {permission === 'denied' && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          Access to your {space === 'loopback' ? 'device’s local apps' : 'local network'} is blocked.
+          To re-enable it, click the site settings icon next to the address bar and set
+          {' '}<strong>{settingName}</strong> to <strong>Allow</strong>, then try again.
+        </div>
+      )}
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      <form onSubmit={handleSubmit} className="space-y-4">
+        <div>
+          <label htmlFor="device-url" className="block text-sm font-medium text-gray-700 mb-1">
+            Device address
+          </label>
+          <input
+            type="url"
+            id="device-url"
+            value={url}
+            onChange={(e) => setUrl(e.target.value)}
+            placeholder="http://192.168.1.100:8080/api/status"
+            required
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          {space && (
+            <p className="mt-1 text-xs text-gray-500">
+              Target: {space === 'loopback' ? 'this computer (loopback)' : 'local network'}
+              {permission && permission !== 'unsupported' && <> &middot; Permission: {permission}</>}
+            </p>
+          )}
+        </div>
+
+        <button
+          type="submit"
+          disabled={loading || !space}
+          className={`w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            loading || !space ? 'opacity-75 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Connecting...' : 'Connect'}
+        </button>
+      </form>
+
+      {result !== null && (
+        <div className="mt-6">
+          <div className="mb-2 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            Connected!
+          </div>
+          <pre className="p-3 text-xs bg-gray-50 border border-gray-200 rounded-md overflow-auto max-h-64">{result}</pre>
+        </div>
+      )}
+    </div>
+  );
+}
