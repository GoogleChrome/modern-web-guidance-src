diff --git a/src/utils/localNetwork.ts b/src/utils/localNetwork.ts
new file mode 100644
index 0000000..a02cd11
--- /dev/null
+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,69 @@
+// Helpers for Local Network Access (LNA): requests from this public origin to a
+// user's private network (LAN devices) or loopback interface (local companion apps).
+// Browsers gate these behind the 'local-network' / 'loopback-network' permissions.
+
+export type TargetAddressSpace = 'local' | 'loopback';
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type LnaPermissionState = PermissionState | 'unsupported';
+
+export const permissionForAddressSpace = (space: TargetAddressSpace): LnaPermissionName =>
+  space === 'loopback' ? 'loopback-network' : 'local-network';
+
+/**
+ * Infers the target address space from a URL's host. Unknown hostnames (custom DNS
+ * names resolving to a LAN IP) default to 'local'; the browser verifies after DNS.
+ */
+export function inferAddressSpace(url: string): TargetAddressSpace {
+  const host = new URL(url).hostname.replace(/^\[|\]$/g, '').toLowerCase();
+  if (host === 'localhost' || host.endsWith('.localhost') || host === '::1' || /^127\./.test(host)) {
+    return 'loopback';
+  }
+  return 'local';
+}
+
+/**
+ * Queries the granular LNA permission. Never falls back to the legacy combined
+ * 'local-network-access' name, which crashes the renderer in older Chrome versions.
+ */
+export async function queryLnaPermission(
+  name: LnaPermissionName,
+  onChange?: (state: PermissionState) => void,
+): Promise<LnaPermissionState> {
+  if (!navigator.permissions?.query) {
+    return 'unsupported';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: name as PermissionName });
+    if (onChange) {
+      // Keep UI in sync if the user changes the permission in site settings
+      status.addEventListener('change', () => onChange(status.state));
+    }
+    return status.state;
+  } catch {
+    // Unrecognized permission name: the browser doesn't implement LNA.
+    // Requests may still work; trigger them from a user gesture only.
+    return 'unsupported';
+  }
+}
+
+/**
+ * fetch() wrapper that declares targetAddressSpace so http:// endpoints on the
+ * LAN/loopback are exempt from Mixed Content blocking once permission is granted.
+ * Call the first request from a user gesture (not on load, not from a worker).
+ */
+export function fetchLocal(
+  url: string,
+  init: RequestInit = {},
+  targetAddressSpace: TargetAddressSpace = inferAddressSpace(url),
+): Promise<Response> {
+  return fetch(url, { mode: 'cors', ...init, targetAddressSpace });
+}
+
+/**
+ * Opens a WebSocket to a local/loopback endpoint. WebSocket has no targetAddressSpace
+ * option; ws:// is only exempt from Mixed Content when the host is a private/loopback
+ * IP literal, localhost or a .local hostname. Use wss:// for other hostnames.
+ */
+export function openLocalWebSocket(url: string, protocols?: string | string[]): WebSocket {
+  return new WebSocket(url, protocols);
+}
