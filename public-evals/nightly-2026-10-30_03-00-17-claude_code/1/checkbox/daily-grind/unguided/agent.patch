+    /* Drink Customization Checkboxes */
+    .customize {
+      border: none;
+      border-top: 1px dashed var(--secondary);
+      margin-top: 15px;
+      padding-top: 12px;
+      text-align: left;
+    }
+
+    .customize legend {
+      padding: 0 8px;
+      margin: 0 auto;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .option {
+      position: relative;
+      margin-top: 8px;
+    }
+
+    /* The native checkbox stays in the DOM, focusable and clickable; it is
+       stretched invisibly over the custom row so every click and tap hits it. */
+    .option-input {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .option-label {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      padding: 8px 10px;
+      border: 2px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      font-size: 0.9rem;
+      transition: background-color 0.25s, border-color 0.25s, box-shadow 0.25s;
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      width: 22px;
+      height: 22px;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 1.75;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      transition: stroke 0.25s, transform 0.25s;
+    }
+
+    .option-text {
+      flex-grow: 1;
+    }
+
+    .option-price {
+      font-size: 0.8rem;
+      color: #795548;
+    }
+
+    .option-box {
+      flex-shrink: 0;
+      position: relative;
+      width: 22px;
+      height: 22px;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      transition: border-color 0.25s;
+    }
+
+    /* Accent "fill" that pours in on check and drains on uncheck */
+    .option-box::before {
+      content: "";
+      position: absolute;
+      inset: 2px;
+      border-radius: 50%;
+      background: var(--accent);
+      transform: scale(0);
+      transition: transform 0.25s ease-in;
+    }
+
+    .option-box svg {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .option-box path {
+      stroke-dasharray: 16;
+      stroke-dashoffset: 16;
+      transition: stroke-dashoffset 0.15s ease-in;
+    }
+
+    /* Hover */
+    .option-input:hover+.option-label {
+      border-color: var(--accent);
+    }
+
+    /* Keyboard focus */
+    .option-input:focus-visible+.option-label {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Checked */
+    .option-input:checked+.option-label {
+      background: #fff3e0;
+      border-color: var(--accent);
+      box-shadow: 0 2px 6px rgba(78, 52, 46, 0.15);
+    }
+
+    .option-input:checked+.option-label .option-icon {
+      stroke: var(--text);
+      animation: icon-wiggle 0.45s ease-out;
+    }
+
+    .option-input:checked+.option-label .option-box {
+      animation: box-pop 0.35s ease-out;
+    }
+
+    .option-input:checked+.option-label .option-box::before {
+      transform: scale(1);
+      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-input:checked+.option-label .option-box path {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.25s ease-out 0.12s;
+    }
+
+    /* Disabled */
+    .option-input:disabled {
+      cursor: not-allowed;
+    }
+
+    .option-input:disabled+.option-label {
+      opacity: 0.5;
+    }
+
+    @keyframes box-pop {
+      50% {
+        transform: scale(1.2);
+      }
+    }
+
+    @keyframes icon-wiggle {
+      25% {
+        transform: rotate(-12deg) scale(1.1);
+      }
+
+      60% {
+        transform: rotate(8deg) scale(1.1);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .option-label,
+      .option-icon,
+      .option-box,
+      .option-box::before,
+      .option-box path,
+      .option-input:checked+.option-label .option-box::before,
+      .option-input:checked+.option-label .option-box path {
+        transition: none;
+      }
+
+      .option-input:checked+.option-label .option-icon,
+      .option-input:checked+.option-label .option-box {
+        animation: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep the state visible */
+    @media (forced-colors: active) {
+      .option-label {
+        border-color: CanvasText;
+      }
+
+      .option-box {
+        border-color: CanvasText;
+      }
+
+      .option-input:checked+.option-label {
+        border-color: Highlight;
+      }
+
+      .option-input:checked+.option-label .option-box::before {
+        background: Highlight;
+      }
+
+      .option-input:checked+.option-label .option-box svg {
+        stroke: HighlightText;
+      }
+
+      .option-icon {
+        stroke: CanvasText;
+      }
+    }
+
