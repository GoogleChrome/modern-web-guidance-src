+      font-size: 0.8rem;
+      color: #795548;
+    }
+
+    .checkbox {
+      --checkbox-size: 1.25em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      flex-shrink: 0;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      background-color: white;
+      color: white;
+      cursor: pointer;
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon, var(--icon-check)) no-repeat center / contain;
+        scale: 0;
+        rotate: -45deg;
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:is(:checked, :indeterminate) {
+        background-color: var(--primary);
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        scale: 1;
+        rotate: 0deg;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--accent);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 150ms ease;
+
+        &::before {
+          /* Slight overshoot gives the check a springy "pop" */
+          transition: scale 200ms cubic-bezier(0.34, 1.56, 0.64, 1), rotate 200ms ease;
+        }
+
+        &:checked {
+          animation: checkbox-pop 250ms ease;
+        }
+      }
+    }
+
+    @keyframes checkbox-pop {
+      50% {
+        scale: 1.2;
+      }
+    }
+
+    .option:has(.checkbox:disabled) {
+      cursor: not-allowed;
+    }
   </style>
