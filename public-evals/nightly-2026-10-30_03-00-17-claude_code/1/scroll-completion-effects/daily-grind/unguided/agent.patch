+  <script>
+    (function () {
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var navLinks = document.querySelectorAll('nav a[href^="#"]');
+      var pending = null; // cancels the in-flight navigation, if any
+
+      // Resolve once scrolling has actually stopped. Uses the native
+      // `scrollend` event where supported, with a fallback that watches for
+      // the scroll position to stay put across several frames (this also
+      // covers the case where no scroll is needed at all).
+      function waitForScrollEnd(onDone) {
+        var done = false;
+        var lastY = window.scrollY;
+        var stableFrames = 0;
+        var rafId;
+
+        function finish() {
+          if (done) return;
+          done = true;
+          cancelAnimationFrame(rafId);
+          window.removeEventListener('scrollend', finish);
+          onDone();
+        }
+
+        function check() {
+          var y = window.scrollY;
+          stableFrames = y === lastY ? stableFrames + 1 : 0;
+          lastY = y;
+          // ~100ms without movement means the scroll is done (or never began)
+          if (stableFrames >= 6) finish();
+          else rafId = requestAnimationFrame(check);
+        }
+
+        window.addEventListener('scrollend', finish);
+        rafId = requestAnimationFrame(check);
+
+        return function cancel() {
+          done = true;
+          cancelAnimationFrame(rafId);
+          window.removeEventListener('scrollend', finish);
+        };
+      }
+
+      function setActive(hash) {
+        navLinks.forEach(function (link) {
+          link.classList.toggle('active', link.getAttribute('href') === hash);
+        });
+      }
+
+      function onArrive(target) {
+        target.focus({ preventScroll: true });
+        target.classList.remove('arrived');
+        void target.offsetWidth; // restart the animation on repeat visits
+        target.classList.add('arrived');
+      }
+
+      function navigateTo(target, hash) {
+        if (pending) pending();
+        document.querySelectorAll('.scroll-target.arrived').forEach(function (el) {
+          el.classList.remove('arrived');
+        });
+
+        setActive(hash);
+        if (location.hash !== hash) history.pushState(null, '', hash);
+
+        target.scrollIntoView({
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start'
+        });
+
+        pending = waitForScrollEnd(function () {
+          pending = null;
+          onArrive(target);
+        });
+      }
+
+      navLinks.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var hash = link.getAttribute('href');
+          var target = document.getElementById(hash.slice(1));
+          if (!target) return;
+          event.preventDefault();
+          navigateTo(target, hash);
+        });
+      });
+
+      window.addEventListener('popstate', function () {
+        var target = location.hash && document.getElementById(location.hash.slice(1));
+        if (target) navigateTo(target, location.hash);
+      });
+
+      document.addEventListener('animationend', function (event) {
+        if (event.animationName === 'arrive-glow') {
+          event.target.classList.remove('arrived');
+        }
+      });
+    })();
+  </script>
