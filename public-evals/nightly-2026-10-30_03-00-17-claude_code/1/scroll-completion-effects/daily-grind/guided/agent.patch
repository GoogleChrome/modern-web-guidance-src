+  <script>
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let currentScrollId = 0;
+
+    // Resolves once the scroll has finished. Uses the Promise returned by
+    // scrollIntoView() where supported, otherwise falls back to scrollend
+    // with an idle timeout (covers targets already in view).
+    function scrollIntoViewAsync(element, options, scroller = window) {
+      const result = element.scrollIntoView(options);
+
+      if (result instanceof Promise) {
+        return result;
+      }
+
+      return new Promise((resolve) => {
+        let timeoutId;
+
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    async function navigateTo(target) {
+      const scrollId = ++currentScrollId;
+      document.querySelectorAll('.nav-target.arrived')
+        .forEach((el) => el.classList.remove('arrived'));
+
+      await scrollIntoViewAsync(target, {
+        behavior: reducedMotion.matches ? 'auto' : 'smooth',
+        block: 'start'
+      });
+
+      // A newer navigation superseded this one while scrolling
+      if (scrollId !== currentScrollId) return;
+
+      target.querySelector('h2')?.focus({ preventScroll: true });
+      // Force a reflow so the animation restarts on repeat visits
+      void target.offsetWidth;
+      target.classList.add('arrived');
+    }
+
+    document.querySelectorAll('a[href^="#"]').forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const target = document.getElementById(link.hash.slice(1));
+        if (!target) return;
+
+        event.preventDefault();
+        if (location.hash !== link.hash) {
+          history.pushState(null, '', link.hash);
+        }
+        navigateTo(target);
+      });
+    });
+
+    window.addEventListener('popstate', () => {
+      const target = location.hash && document.getElementById(location.hash.slice(1));
+      if (target) navigateTo(target);
+    });
+
+    document.querySelectorAll('.nav-target').forEach((section) => {
+      section.addEventListener('animationend', (event) => {
+        if (event.target === section) section.classList.remove('arrived');
+      });
+    });
+  </script>
+
