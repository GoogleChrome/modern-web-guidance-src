+    /* Options dropdown */
+    .options-trigger {
+      anchor-name: --options-anchor;
+      background: none;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      border-radius: 4px;
+      padding: 5px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger[aria-expanded="true"] {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger:focus-visible,
+    .action-item:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .action-panel {
+      /* Explicit anchor + inset-based anchor() so the polyfill can handle it too */
+      position-anchor: --options-anchor;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 6px 0;
+      /* Flip vertically, horizontally, or both when the panel would be clipped */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      background: none;
+      border: 0;
+      border-radius: 5px;
+      padding: 8px 12px;
+      text-align: start;
+      font: inherit;
+      font-size: 0.9rem;
+      color: inherit;
+      cursor: pointer;
+    }
+
+    .action-item:hover {
+      background: var(--secondary);
+    }
+
