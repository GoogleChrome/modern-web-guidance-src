+  <script>
+    (function () {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+
+      panel.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-href]');
+        if (!btn) return;
+        panel.hidePopover();
+        window.location.href = btn.dataset.href;
+      });
+
+      // Keep aria-expanded in sync (popovertarget sets it in most browsers, this covers the rest)
+      panel.addEventListener('toggle', (e) => {
+        trigger.setAttribute('aria-expanded', String(e.newState === 'open'));
+      });
+
+      // JS fallback positioning for browsers without CSS anchor positioning
+      if (CSS.supports('anchor-name: --a') && CSS.supports('position-try-fallbacks: flip-block')) return;
+
+      const GAP = 6;
+      const EDGE = 8;
+
+      function place() {
+        if (!panel.matches(':popover-open')) return;
+        const t = trigger.getBoundingClientRect();
+        const pw = panel.offsetWidth;
+        const ph = panel.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        // Vertical: below by default, flip above if it overflows and there's more room above
+        let top = t.bottom + GAP;
+        if (top + ph > vh - EDGE && t.top > vh - t.bottom) top = t.top - GAP - ph;
+        top = Math.max(EDGE, Math.min(top, vh - ph - EDGE));
+
+        // Horizontal: align to left edge, flip to align right edges if it overflows
+        let left = t.left;
+        if (left + pw > vw - EDGE) left = t.right - pw;
+        left = Math.max(EDGE, Math.min(left, vw - pw - EDGE));
+
+        panel.style.margin = '0';
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+      }
+
+      panel.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') place();
+      });
+      window.addEventListener('resize', place);
+      window.addEventListener('scroll', place, { passive: true });
+    })();
+  </script>
+
