+  <script>
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    // Animate DOM updates within a single component subtree, leaving the rest of the page interactive
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(updateDOM);
+      // Re-triggering on the same scope skips the active transition and rejects `ready`
+      transition.ready.catch(() => {});
+    }
+
+    const SIZE_UPCHARGE = { S: 0, M: 0.75, L: 1.5 };
+    const SIZE_LABEL = { S: 'Small', M: 'Medium', L: 'Large' };
+    const formatPrice = (n) => `$${n.toFixed(2)}`;
+
+    const panel = document.getElementById('order-panel');
+    const list = document.getElementById('order-list');
+    const emptyMsg = panel.querySelector('.order-empty');
+    const totalEl = document.getElementById('order-total');
+
+    function selectedSize(card) {
+      return card.querySelector('.sizes [aria-pressed="true"]').dataset.size;
+    }
+
+    function unitPrice(card, size) {
+      return Number(card.dataset.basePrice) + SIZE_UPCHARGE[size];
+    }
+
+    function refreshOrderSummary() {
+      let total = 0;
+      for (const li of list.children) {
+        total += Number(li.dataset.unitPrice) * Number(li.dataset.qty);
+      }
+      totalEl.textContent = formatPrice(total);
+      emptyMsg.hidden = list.children.length > 0;
+    }
+
+    function renderLine(li) {
+      const qty = Number(li.dataset.qty);
+      li.querySelector('.item-qty').textContent = `×${qty}`;
+      li.querySelector('.item-price').textContent = formatPrice(Number(li.dataset.unitPrice) * qty);
+    }
+
+    function createLine(name, size, price) {
+      const li = document.createElement('li');
+      li.dataset.id = `${name}|${size}`;
+      li.dataset.name = name;
+      li.dataset.unitPrice = price;
+      li.dataset.qty = 0;
+      li.innerHTML = `
+        <span class="item-name"></span>
+        <span class="item-qty"></span>
+        <span class="item-price"></span>
+        <button type="button" class="remove-btn"></button>`;
+      li.querySelector('.item-name').append(name, ' ', Object.assign(document.createElement('small'), { textContent: SIZE_LABEL[size] }));
+      li.querySelector('.remove-btn').setAttribute('aria-label', `Remove ${SIZE_LABEL[size]} ${name}`);
+      li.querySelector('.remove-btn').textContent = '×';
+      return li;
+    }
+
+    // Menu cards: each card is its own scope, so several can animate at once
+    document.querySelector('.grid').addEventListener('click', (event) => {
+      const button = event.target.closest('button');
+      if (!button) return;
+      const card = button.closest('.card');
+
+      if (button.dataset.size) {
+        runScopedTransition(card, () => {
+          for (const b of card.querySelectorAll('.sizes button')) {
+            b.setAttribute('aria-pressed', String(b === button));
+          }
+          card.querySelector('.price').textContent = formatPrice(unitPrice(card, button.dataset.size));
+        });
+      } else if (button.dataset.action === 'toggle-details') {
+        const details = document.getElementById(button.getAttribute('aria-controls'));
+        const expand = details.hidden;
+        runScopedTransition(card, () => {
+          details.hidden = !expand;
+          button.setAttribute('aria-expanded', String(expand));
+        });
+      } else if (button.dataset.action === 'add') {
+        const name = card.dataset.name;
+        const size = selectedSize(card);
+        // Scope to the whole panel: the empty message, list height and total all change
+        runScopedTransition(panel, () => {
+          let li = list.querySelector(`li[data-id="${CSS.escape(`${name}|${size}`)}"]`);
+          if (!li) {
+            li = createLine(name, size, unitPrice(card, size));
+            list.append(li);
+          }
+          li.dataset.qty = Number(li.dataset.qty) + 1;
+          renderLine(li);
+          refreshOrderSummary();
+        });
+      }
+    });
+
+    panel.addEventListener('click', (event) => {
+      const button = event.target.closest('button');
+      if (!button) return;
+
+      if (button.dataset.sort) {
+        const key = button.dataset.sort;
+        const sorted = [...list.children].sort((a, b) => key === 'price'
+          ? Number(a.dataset.unitPrice) * a.dataset.qty - Number(b.dataset.unitPrice) * b.dataset.qty
+          : a.dataset.name.localeCompare(b.dataset.name));
+        // Only the order changes, so scope to the list; move existing nodes to keep `match-element` identity
+        runScopedTransition(list, () => list.append(...sorted));
+      } else if (button.classList.contains('remove-btn')) {
+        const li = button.closest('li');
+        const hadFocus = li.contains(document.activeElement);
+        const nextFocusTarget =
+          li.nextElementSibling?.querySelector('button') ??
+          li.previousElementSibling?.querySelector('button') ??
+          panel.querySelector('.order-sort button');
+        runScopedTransition(panel, () => {
+          li.remove();
+          refreshOrderSummary();
+          if (hadFocus) nextFocusTarget?.focus();
+        });
+      }
+    });
+  </script>
+
