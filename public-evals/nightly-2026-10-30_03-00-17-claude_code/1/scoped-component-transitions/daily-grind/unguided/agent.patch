+
+    /*
+     * Element-scoped view transitions.
+     * Each [data-vt-scope] element runs its own transition via
+     * element.startViewTransition(), so the pseudo-element tree is attached to
+     * that subtree only: the rest of the page stays live, and several scopes
+     * can animate at the same time.
+     */
+    [data-vt-scope] {
+      contain: layout;
+    }
+
+    [data-vt-scope]::view-transition {
+      pointer-events: none;
+    }
+
+    ::view-transition-group(*) {
+      animation-duration: 320ms;
+      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+    }
+
+    /* Rolling numbers / labels */
+    .price,
+    .total,
+    .item-count,
+    .cart-num,
+    .add-label {
+      view-transition-class: ticker;
+    }
+
+    ::view-transition-group(*.ticker) {
+      overflow: clip;
+    }
+
+    ::view-transition-old(*.ticker),
+    ::view-transition-new(*.ticker) {
+      width: auto;
+      height: 100%;
+      left: 50%;
+      translate: -50% 0;
+      mix-blend-mode: normal;
+    }
+
+    ::view-transition-old(*.ticker) {
+      animation: 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both vt-out-up;
+    }
+
+    ::view-transition-new(*.ticker) {
+      animation: 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both vt-in-up;
+    }
+
+    :active-view-transition-type(decrease)::view-transition-old(*.ticker) {
+      animation-name: vt-out-down;
+    }
+
+    :active-view-transition-type(decrease)::view-transition-new(*.ticker) {
+      animation-name: vt-in-down;
+    }
+
+    /* Size picker pill slides between options */
+    .size-indicator {
+      view-transition-class: indicator;
+    }
+
+    ::view-transition-group(*.indicator) {
+      animation-duration: 380ms;
+      animation-timing-function: cubic-bezier(0.34, 1.4, 0.64, 1);
+    }
+
+    .size-badge {
+      view-transition-class: badge;
+    }
+
+    ::view-transition-new(*.badge) {
+      animation: 380ms cubic-bezier(0.34, 1.56, 0.64, 1) both vt-pop;
+    }
+
+    ::view-transition-old(*.badge) {
+      animation: 120ms ease-out both vt-fade-out;
+    }
+
+    /* Card faces slide like pages */
+    .face {
+      view-transition-class: face;
+    }
+
+    ::view-transition-old(*.face) {
+      animation: 260ms ease-in both vt-face-out-left;
+    }
+
+    ::view-transition-new(*.face) {
+      animation: 320ms cubic-bezier(0.2, 0.8, 0.2, 1) 60ms both vt-face-in-right;
+    }
+
+    :active-view-transition-type(to-front)::view-transition-old(*.face) {
+      animation-name: vt-face-out-right;
+    }
+
+    :active-view-transition-type(to-front)::view-transition-new(*.face) {
+      animation-name: vt-face-in-left;
+    }
+
+    /* Order list */
+    .line-item {
+      view-transition-class: line-item;
+    }
+
+    ::view-transition-new(*.line-item):only-child {
+      animation: 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both vt-line-in;
+    }
+
+    ::view-transition-old(*.line-item):only-child {
+      animation: 220ms ease-in both vt-line-out;
+    }
+
+    @keyframes vt-out-up {
+      to { transform: translateY(-100%); opacity: 0; }
+    }
+
+    @keyframes vt-in-up {
+      from { transform: translateY(100%); opacity: 0; }
+    }
+
+    @keyframes vt-out-down {
+      to { transform: translateY(100%); opacity: 0; }
+    }
+
+    @keyframes vt-in-down {
+      from { transform: translateY(-100%); opacity: 0; }
+    }
+
+    @keyframes vt-pop {
+      from { transform: scale(0.4); opacity: 0; }
+    }
+
+    @keyframes vt-fade-out {
+      to { opacity: 0; }
+    }
+
+    @keyframes vt-face-out-left {
+      to { transform: translateX(-24px); opacity: 0; }
+    }
+
+    @keyframes vt-face-in-right {
+      from { transform: translateX(24px); opacity: 0; }
+    }
+
+    @keyframes vt-face-out-right {
+      to { transform: translateX(24px); opacity: 0; }
+    }
+
+    @keyframes vt-face-in-left {
+      from { transform: translateX(-24px); opacity: 0; }
+    }
+
+    @keyframes vt-line-in {
+      from { transform: translateX(24px) scale(0.96); opacity: 0; }
+    }
+
+    @keyframes vt-line-out {
+      to { transform: scale(0.9); opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
