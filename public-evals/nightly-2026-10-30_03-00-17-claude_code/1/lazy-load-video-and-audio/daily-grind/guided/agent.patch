+  <script>
+    // Lazy media: native loading="lazy" on <video>/<audio> defers poster + preload until near
+    // the viewport. Poster/preload live in data-* so browsers without support can't fetch them
+    // during parsing; there, IntersectionObserver applies them instead.
+    (() => {
+      const lazyMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+
+      const activate = (media) => {
+        if (media.dataset.poster) {
+          media.poster = media.dataset.poster;
+          delete media.dataset.poster;
+        }
+        if (media.dataset.preload) {
+          media.preload = media.dataset.preload;
+          delete media.dataset.preload;
+        }
+      };
+
+      if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+        lazyMedia.forEach(activate);
+      } else {
+        const observer = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            if (!entry.isIntersecting) continue;
+            activate(entry.target);
+            observer.unobserve(entry.target);
+          }
+        }, { rootMargin: '200px 0px' });
+        lazyMedia.forEach((media) => observer.observe(media));
+      }
+
+      // Respect reduced-motion preferences for the autoplaying hero video
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const syncReducedMotion = () => {
+        for (const video of document.querySelectorAll('.hero-video')) {
+          if (reducedMotion.matches) {
+            video.removeAttribute('autoplay');
+            video.pause();
+          } else {
+            video.play().catch(() => {});
+          }
+        }
+      };
+      syncReducedMotion();
+      reducedMotion.addEventListener('change', syncReducedMotion);
+    })();
+  </script>
