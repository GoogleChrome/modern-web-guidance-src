diff --git a/src/components/TranslateButton.tsx b/src/components/TranslateButton.tsx
new file mode 100644
index 0000000..62d7749
--- /dev/null
+++ b/src/components/TranslateButton.tsx
@@ -0,0 +1,327 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+// Languages supported by Chrome's on-device Translator API.
+const LANGUAGE_CODES = [
+  'ar', 'bg', 'bn', 'cs', 'da', 'de', 'el', 'en', 'es', 'fi', 'fr', 'he', 'hi', 'hr', 'hu',
+  'id', 'it', 'ja', 'kn', 'ko', 'lt', 'mr', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'sk', 'sl',
+  'sv', 'ta', 'te', 'th', 'tr', 'uk', 'vi', 'zh', 'zh-Hant',
+];
+const STORAGE_KEY = 'devtools-times:translation';
+const TRANSLATABLE_SELECTOR = '[data-translatable]';
+const SKIPPED_SELECTOR = 'script, style, noscript, code, pre, [translate="no"]';
+
+const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+const languageName = (code: string) => displayNames.of(code) ?? code;
+const LANGUAGES = LANGUAGE_CODES
+  .map((code) => ({ code, name: languageName(code) }))
+  .sort((a, b) => a.name.localeCompare(b.name));
+
+// Original text of every text node we've replaced, so we can always translate
+// from (and revert to) the source text instead of chaining translations.
+const originals = new WeakMap<Text, string>();
+
+interface Status {
+  kind: 'idle' | 'working' | 'translated' | 'error' | 'unsupported';
+  message: string;
+}
+
+interface Preference {
+  source: string;
+  target: string;
+}
+
+function collectTextNodes(): Text[] {
+  const nodes = new Set<Text>();
+  for (const root of document.querySelectorAll(TRANSLATABLE_SELECTOR)) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode: (node) =>
+        node.parentElement?.closest(SKIPPED_SELECTOR) || !node.nodeValue?.trim()
+          ? NodeFilter.FILTER_REJECT
+          : NodeFilter.FILTER_ACCEPT,
+    });
+    while (walker.nextNode()) nodes.add(walker.currentNode as Text);
+  }
+  return [...nodes];
+}
+
+function originalText(node: Text) {
+  return originals.get(node) ?? node.nodeValue ?? '';
+}
+
+function setTranslatedText(node: Text, text: string) {
+  if (!originals.has(node)) originals.set(node, node.nodeValue ?? '');
+  node.nodeValue = text;
+}
+
+function restoreOriginals() {
+  for (const node of collectTextNodes()) {
+    const original = originals.get(node);
+    if (original !== undefined) {
+      node.nodeValue = original;
+      originals.delete(node);
+    }
+  }
+  for (const root of document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR)) {
+    root.removeAttribute('lang');
+  }
+}
+
+function normalizeLanguage(code: string) {
+  if (/^zh-(hant|tw|hk|mo)/i.test(code)) return 'zh-Hant';
+  return code.split('-')[0].toLowerCase();
+}
+
+function readPreference(): Preference | null {
+  try {
+    return JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? 'null');
+  } catch {
+    return null;
+  }
+}
+
+function defaultTarget() {
+  const browserLanguage = normalizeLanguage(navigator.language || 'en');
+  return browserLanguage !== 'en' && LANGUAGE_CODES.includes(browserLanguage) ? browserLanguage : 'es';
+}
+
+export default function TranslateButton() {
+  const panelId = useId();
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [source, setSource] = useState('auto');
+  const [target, setTarget] = useState('es');
+  const [status, setStatus] = useState<Status>({ kind: 'idle', message: '' });
+  const [progress, setProgress] = useState<number | null>(null);
+  const [isTranslated, setIsTranslated] = useState(false);
+  const runRef = useRef(0);
+
+  const monitor = (label: string) => (m: AICreateMonitor) => {
+    m.addEventListener('downloadprogress', (e) => {
+      setStatus({ kind: 'working', message: `Downloading ${label}… ${Math.round(e.loaded * 100)}%` });
+    });
+  };
+
+  async function resolveSourceLanguage(sourceSetting: string, sample: string) {
+    if (sourceSetting !== 'auto') return sourceSetting;
+    const fallback = normalizeLanguage(document.documentElement.lang || 'en');
+    const Detector = globalThis.LanguageDetector;
+    if (!Detector || sample.length < 20) return fallback;
+    try {
+      if ((await Detector.availability()) === 'unavailable') return fallback;
+      const detector = await Detector.create({ monitor: monitor('language detection model') });
+      const [best] = await detector.detect(sample);
+      detector.destroy();
+      return best && best.detectedLanguage !== 'und' && best.confidence >= 0.5
+        ? normalizeLanguage(best.detectedLanguage)
+        : fallback;
+    } catch {
+      return fallback;
+    }
+  }
+
+  async function translatePage(pref: Preference, userInitiated: boolean) {
+    const run = ++runRef.current;
+    const isCurrent = () => run === runRef.current;
+    const Translator = globalThis.Translator;
+    if (!Translator) return;
+
+    const nodes = collectTextNodes();
+    if (nodes.length === 0) {
+      if (userInitiated) setStatus({ kind: 'error', message: 'There is no article text on this page to translate.' });
+      return;
+    }
+
+    setProgress(null);
+    setStatus({ kind: 'working', message: 'Detecting language…' });
+    const sample = nodes.map(originalText).join(' ').slice(0, 2000);
+    const sourceLanguage = await resolveSourceLanguage(pref.source, sample);
+    if (!isCurrent()) return;
+
+    if (sourceLanguage === pref.target) {
+      restoreOriginals();
+      setIsTranslated(false);
+      setStatus({ kind: 'idle', message: `This page is already in ${languageName(pref.target)}.` });
+      return;
+    }
+
+    const options = { sourceLanguage, targetLanguage: pref.target };
+    const pairLabel = `${languageName(sourceLanguage)} → ${languageName(pref.target)}`;
+    let translator: TranslatorInstance | undefined;
+    try {
+      const availability = await Translator.availability(options);
+      if (!isCurrent()) return;
+      if (availability === 'unavailable') {
+        setStatus({ kind: 'error', message: `${pairLabel} isn't available on this device.` });
+        return;
+      }
+      // Re-applying a remembered preference after navigation has no user gesture,
+      // so only proceed when the language pack is already on the device.
+      if (!userInitiated && availability !== 'available') {
+        setStatus({ kind: 'idle', message: '' });
+        return;
+      }
+
+      setStatus({ kind: 'working', message: `Preparing ${pairLabel}…` });
+      translator = await Translator.create({ ...options, monitor: monitor('language pack') });
+
+      const cache = new Map<string, Promise<string>>();
+      for (let i = 0; i < nodes.length; i++) {
+        if (!isCurrent()) return;
+        const node = nodes[i];
+        const [, leading, text, trailing] = originalText(node).match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+        if (!cache.has(text)) cache.set(text, translator.translate(text));
+        const translated = await cache.get(text)!;
+        if (!isCurrent()) return;
+        setTranslatedText(node, leading + translated + trailing);
+        setProgress((i + 1) / nodes.length);
+        setStatus({ kind: 'working', message: `Translating ${pairLabel}…` });
+      }
+
+      for (const root of document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR)) {
+        root.lang = pref.target;
+      }
+      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(pref));
+      setIsTranslated(true);
+      setStatus({ kind: 'translated', message: `Translated ${pairLabel} on your device.` });
+    } catch (error) {
+      if (!isCurrent()) return;
+      const message =
+        error instanceof DOMException && error.name === 'NotAllowedError'
+          ? 'Click "Translate" to download the language pack.'
+          : 'Translation failed. Please try again.';
+      setStatus({ kind: 'error', message });
+    } finally {
+      translator?.destroy();
+      if (isCurrent()) setProgress(null);
+    }
+  }
+
+  function showOriginal() {
+    runRef.current++;
+    restoreOriginals();
+    sessionStorage.removeItem(STORAGE_KEY);
+    setIsTranslated(false);
+    setProgress(null);
+    setStatus({ kind: 'idle', message: 'Showing the original text.' });
+  }
+
+  useEffect(() => {
+    const isSupported = 'Translator' in self;
+    setSupported(isSupported);
+    if (!isSupported) {
+      setStatus({
+        kind: 'unsupported',
+        message: 'On-device translation is currently unsupported in this browser. Try a recent desktop version of Chrome or Edge.',
+      });
+      return;
+    }
+
+    const pref = readPreference();
+    if (pref) {
+      setSource(pref.source);
+      setTarget(pref.target);
+      translatePage(pref, false);
+    } else {
+      setTarget(defaultTarget());
+    }
+    return () => {
+      runRef.current++;
+    };
+  }, []);
+
+  const disabled = !supported;
+  const working = status.kind === 'working';
+
+  return (
+    <>
+      <button
+        type="button"
+        popoverTarget={panelId}
+        className="p-1"
+        aria-label="Translate articles"
+        title="Translate articles"
+      >
+        <LanguageIcon className={`h-6 w-6 ${isTranslated ? 'text-amber-400' : 'text-gray-600'}`} />
+      </button>
+
+      <div
+        id={panelId}
+        popover="auto"
+        aria-label="Translate articles"
+        className="fixed inset-auto top-12 left-4 m-0 w-80 max-w-[calc(100vw-2rem)] rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-800 shadow-lg"
+      >
+        <h2 className="font-brand text-xl text-gray-900">Translate</h2>
+        <p className="mt-1 text-xs text-gray-500">
+          Articles and teasers are translated privately on your device.
+        </p>
+
+        <form
+          className="mt-3 grid gap-3"
+          onSubmit={(e) => {
+            e.preventDefault();
+            translatePage({ source, target }, true);
+          }}
+        >
+          <label className="grid gap-1">
+            <span className="text-xs font-semibold text-gray-600">From</span>
+            <select
+              value={source}
+              onChange={(e) => setSource(e.target.value)}
+              disabled={disabled}
+              className="rounded border border-gray-300 px-2 py-1.5 disabled:bg-gray-100"
+            >
+              <option value="auto">Detect language</option>
+              {LANGUAGES.map(({ code, name }) => (
+                <option key={code} value={code}>{name}</option>
+              ))}
+            </select>
+          </label>
+
+          <label className="grid gap-1">
+            <span className="text-xs font-semibold text-gray-600">To</span>
+            <select
+              value={target}
+              onChange={(e) => setTarget(e.target.value)}
+              disabled={disabled}
+              className="rounded border border-gray-300 px-2 py-1.5 disabled:bg-gray-100"
+            >
+              {LANGUAGES.map(({ code, name }) => (
+                <option key={code} value={code}>{name}</option>
+              ))}
+            </select>
+          </label>
+
+          <div className="flex gap-2">
+            <button
+              type="submit"
+              disabled={disabled || working}
+              className="flex-1 rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:bg-gray-400"
+            >
+              Translate
+            </button>
+            <button
+              type="button"
+              onClick={showOriginal}
+              disabled={disabled || (!isTranslated && !working)}
+              className="flex-1 rounded bg-gray-500 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-400 disabled:cursor-not-allowed disabled:bg-gray-300"
+            >
+              Show original
+            </button>
+          </div>
+        </form>
+
+        {progress !== null && (
+          <progress value={progress} max={1} className="mt-3 h-1.5 w-full accent-amber-400">
+            {Math.round(progress * 100)}%
+          </progress>
+        )}
+        <p
+          role="status"
+          className={`mt-2 min-h-5 text-xs ${status.kind === 'error' ? 'text-red-700' : 'text-gray-600'}`}
+        >
+          {status.message}
+        </p>
+      </div>
+    </>
+  );
+}
