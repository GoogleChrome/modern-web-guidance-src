diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..0fa6ce7
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,286 @@
+// On-device translation helpers built on Chrome's built-in AI APIs
+// (Translator + LanguageDetector). Everything runs locally in the browser;
+// no article text is sent to a server.
+//
+// Markup contract:
+//   - `data-translate-root` marks a self-contained unit (an article or a teaser).
+//   - `data-translate` marks elements inside a root whose text should be translated.
+//   - `data-translate-skip` / `translate="no"` exclude a subtree.
+
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface DownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface CreateMonitor {
+  addEventListener(type: 'downloadprogress', listener: (e: DownloadProgressEvent) => void): void;
+}
+
+interface CreateOptions {
+  monitor?: (m: CreateMonitor) => void;
+  signal?: AbortSignal;
+}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string, options?: { signal?: AbortSignal }): Promise<{ detectedLanguage: string; confidence: number }[]>;
+}
+
+declare global {
+  // eslint-disable-next-line no-var
+  var Translator: {
+    availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<Availability>;
+    create(options: { sourceLanguage: string; targetLanguage: string } & CreateOptions): Promise<TranslatorInstance>;
+  } | undefined;
+  // eslint-disable-next-line no-var
+  var LanguageDetector: {
+    availability(): Promise<Availability>;
+    create(options?: CreateOptions): Promise<LanguageDetectorInstance>;
+  } | undefined;
+}
+
+export const LANGUAGES = [
+  'ar', 'bg', 'bn', 'cs', 'da', 'de', 'el', 'en', 'es', 'fi', 'fr', 'he', 'hi', 'hr', 'hu', 'id',
+  'it', 'ja', 'kn', 'ko', 'lt', 'mr', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'sk', 'sl', 'sv', 'ta',
+  'te', 'th', 'tr', 'uk', 'vi', 'zh', 'zh-Hant',
+];
+
+const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+export function languageName(code: string): string {
+  try {
+    return displayNames.of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+/** The language's own name for itself, e.g. "Deutsch" for "de". */
+export function nativeLanguageName(code: string): string {
+  try {
+    return new Intl.DisplayNames([code], { type: 'language' }).of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+export function isTranslationSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+const PREFERRED_TARGET_KEY = 'devtools-times:translate-target';
+
+export function getPreferredTarget(source: string): string {
+  const stored = safeStorage(() => localStorage.getItem(PREFERRED_TARGET_KEY));
+  if (stored && stored !== source) return stored;
+  const browser = navigator.languages
+    ?.map((l) => normalizeLanguage(l))
+    .find((l) => l !== source && LANGUAGES.includes(l));
+  return browser ?? (source === 'es' ? 'en' : 'es');
+}
+
+export function setPreferredTarget(lang: string) {
+  safeStorage(() => localStorage.setItem(PREFERRED_TARGET_KEY, lang));
+}
+
+function safeStorage<T>(fn: () => T): T | null {
+  try {
+    return fn();
+  } catch {
+    return null;
+  }
+}
+
+function normalizeLanguage(tag: string): string {
+  const lower = tag.toLowerCase();
+  if (lower === 'zh-tw' || lower === 'zh-hk' || lower.startsWith('zh-hant')) return 'zh-Hant';
+  const base = lower.split('-')[0];
+  if (base === 'iw') return 'he';
+  if (base === 'nb' || base === 'nn') return 'no';
+  return base;
+}
+
+// --- Model management -------------------------------------------------------
+
+export type ProgressCallback = (fraction: number) => void;
+
+// Translators are shared across all controls on the page, so a page full of
+// teasers only loads each language pair once.
+const translators = new Map<string, Promise<TranslatorInstance>>();
+
+export class TranslationUnavailableError extends Error {}
+
+async function getTranslator(source: string, target: string, onProgress?: ProgressCallback): Promise<TranslatorInstance> {
+  const key = `${source}->${target}`;
+  let pending = translators.get(key);
+  if (!pending) {
+    pending = (async () => {
+      const api = globalThis.Translator;
+      if (!api) throw new TranslationUnavailableError('On-device translation is not supported in this browser.');
+      const availability = await api.availability({ sourceLanguage: source, targetLanguage: target });
+      if (availability === 'unavailable') {
+        throw new TranslationUnavailableError(
+          `Translating from ${languageName(source)} to ${languageName(target)} isn't available on this device.`,
+        );
+      }
+      return api.create({
+        sourceLanguage: source,
+        targetLanguage: target,
+        monitor: (m) => m.addEventListener('downloadprogress', (e) => onProgress?.(e.loaded)),
+      });
+    })();
+    translators.set(key, pending);
+    // Don't cache failures (e.g. missing user activation), so a retry can succeed.
+    pending.catch(() => translators.delete(key));
+  }
+  return pending;
+}
+
+let detectorPromise: Promise<LanguageDetectorInstance | null> | null = null;
+
+function getDetector(): Promise<LanguageDetectorInstance | null> {
+  detectorPromise ??= (async () => {
+    const api = globalThis.LanguageDetector;
+    if (!api) return null;
+    try {
+      if ((await api.availability()) === 'unavailable') return null;
+      return await api.create();
+    } catch {
+      return null;
+    }
+  })();
+  detectorPromise.then((d) => {
+    if (!d) detectorPromise = null;
+  });
+  return detectorPromise;
+}
+
+// --- DOM handling -----------------------------------------------------------
+
+const SKIP_SELECTOR = 'script, style, noscript, code, pre, kbd, samp, svg, astro-island, [translate="no"], [data-translate-skip]';
+
+interface RootState {
+  /** Original text of every translatable text node, captured on first use. */
+  originals: Map<Text, string>;
+  /** Original `lang` attribute of each `data-translate` element (null = absent). */
+  langAttrs: Map<HTMLElement, string | null>;
+  current: string | null;
+}
+
+const rootStates = new WeakMap<HTMLElement, RootState>();
+
+function getRootState(root: HTMLElement): RootState {
+  let state = rootStates.get(root);
+  if (!state) {
+    state = { originals: new Map(), langAttrs: new Map(), current: null };
+    const elements = root.querySelectorAll<HTMLElement>('[data-translate]');
+    for (const el of elements) {
+      state.langAttrs.set(el, el.getAttribute('lang'));
+      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+        acceptNode: (node) =>
+          node.nodeValue?.trim() && !node.parentElement?.closest(SKIP_SELECTOR)
+            ? NodeFilter.FILTER_ACCEPT
+            : NodeFilter.FILTER_REJECT,
+      });
+      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        state.originals.set(node as Text, node.nodeValue!);
+      }
+    }
+    rootStates.set(root, state);
+  }
+  return state;
+}
+
+export function getOriginalText(root: HTMLElement, maxLength = 2000): string {
+  let text = '';
+  for (const original of getRootState(root).originals.values()) {
+    text += original + ' ';
+    if (text.length >= maxLength) break;
+  }
+  return text.slice(0, maxLength);
+}
+
+export function getDeclaredLanguage(root: HTMLElement): string {
+  const lang = root.closest('[lang]')?.getAttribute('lang') || document.documentElement.lang || 'en';
+  return normalizeLanguage(lang);
+}
+
+/**
+ * Detects the language of the root's original (untranslated) text, falling back
+ * to the declared `lang` when no detector is available or it isn't confident.
+ */
+export async function detectSourceLanguage(root: HTMLElement): Promise<string> {
+  const fallback = getDeclaredLanguage(root);
+  const detector = await getDetector();
+  if (!detector) return fallback;
+  try {
+    const [best] = await detector.detect(getOriginalText(root));
+    if (best && best.detectedLanguage !== 'und' && best.confidence >= 0.5) {
+      return normalizeLanguage(best.detectedLanguage);
+    }
+  } catch {
+    // Fall through to the declared language.
+  }
+  return fallback;
+}
+
+export interface TranslateOptions {
+  source: string;
+  target: string;
+  signal?: AbortSignal;
+  onDownloadProgress?: ProgressCallback;
+  onProgress?: (done: number, total: number) => void;
+}
+
+/**
+ * Translates all `data-translate` text inside `root` from the original text
+ * (never from a previous translation), so switching languages doesn't compound
+ * translation errors. Inline markup such as links and emphasis is preserved
+ * because each text node is translated in place.
+ */
+export async function translateRoot(root: HTMLElement, { source, target, signal, onDownloadProgress, onProgress }: TranslateOptions) {
+  const state = getRootState(root);
+  if (source === target) {
+    restoreRoot(root);
+    return;
+  }
+
+  const translator = await getTranslator(source, target, onDownloadProgress);
+  signal?.throwIfAborted();
+
+  const entries = [...state.originals];
+  const cache = new Map<string, string>();
+  let done = 0;
+  onProgress?.(0, entries.length);
+
+  for (const [node, original] of entries) {
+    const [, leading, core, trailing] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+    let translated = cache.get(core);
+    if (translated === undefined) {
+      translated = await translator.translate(core, { signal });
+      cache.set(core, translated);
+    }
+    signal?.throwIfAborted();
+    node.nodeValue = leading + translated + trailing;
+    onProgress?.(++done, entries.length);
+  }
+
+  for (const el of state.langAttrs.keys()) el.setAttribute('lang', target);
+  state.current = target;
+}
+
+export function restoreRoot(root: HTMLElement) {
+  const state = rootStates.get(root);
+  if (!state) return;
+  for (const [node, original] of state.originals) node.nodeValue = original;
+  for (const [el, lang] of state.langAttrs) {
+    if (lang === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', lang);
+  }
+  state.current = null;
+}
