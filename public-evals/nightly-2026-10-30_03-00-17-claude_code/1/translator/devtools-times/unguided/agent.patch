diff --git a/src/components/TranslateButton.tsx b/src/components/TranslateButton.tsx
new file mode 100644
index 0000000..85cb95b
--- /dev/null
+++ b/src/components/TranslateButton.tsx
@@ -0,0 +1,296 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  TranslationUnavailableError,
+  detectSourceLanguage,
+  getDeclaredLanguage,
+  getPreferredTarget,
+  isTranslationSupported,
+  languageName,
+  nativeLanguageName,
+  restoreRoot,
+  setPreferredTarget,
+  translateRoot,
+} from '../utils/translation';
+
+interface Props {
+  /** `compact` renders an icon-only trigger for teasers. */
+  variant?: 'full' | 'compact';
+}
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'detecting' }
+  | { kind: 'downloading'; progress: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; source: string; target: string }
+  | { kind: 'error'; message: string };
+
+const AUTO = 'auto';
+const POPOVER_WIDTH = 288;
+
+export default function TranslateButton({ variant = 'full' }: Props) {
+  const popoverId = `translate-${useId().replace(/:/g, '')}`;
+  const buttonRef = useRef<HTMLButtonElement>(null);
+  const popoverRef = useRef<HTMLDivElement>(null);
+  const abortRef = useRef<AbortController | null>(null);
+
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [source, setSource] = useState(AUTO);
+  const [target, setTarget] = useState('es');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+
+  const getRoot = () => buttonRef.current?.closest<HTMLElement>('[data-translate-root]') ?? null;
+
+  useEffect(() => {
+    setSupported(isTranslationSupported());
+    const root = getRoot();
+    setTarget(getPreferredTarget(root ? getDeclaredLanguage(root) : 'en'));
+    return () => abortRef.current?.abort();
+  }, []);
+
+  const positionPopover = () => {
+    const button = buttonRef.current;
+    const popover = popoverRef.current;
+    if (!button || !popover) return;
+    const rect = button.getBoundingClientRect();
+    const left = Math.min(Math.max(8, rect.right - POPOVER_WIDTH), window.innerWidth - POPOVER_WIDTH - 8);
+    const height = popover.offsetHeight;
+    const fitsBelow = rect.bottom + 8 + height <= window.innerHeight;
+    const top = fitsBelow || rect.top - 8 - height < 0 ? rect.bottom + 8 : rect.top - 8 - height;
+    popover.style.left = `${Math.max(8, left)}px`;
+    popover.style.top = `${top}px`;
+  };
+
+  // The popover lives in the top layer with fixed positioning so it isn't
+  // clipped by `overflow-hidden` teaser cards; keep it pinned to the trigger.
+  const handleToggle = (event: React.ToggleEvent<HTMLDivElement>) => {
+    if (event.newState !== 'open') {
+      window.removeEventListener('scroll', positionPopover, true);
+      window.removeEventListener('resize', positionPopover);
+      return;
+    }
+    positionPopover();
+    window.addEventListener('scroll', positionPopover, true);
+    window.addEventListener('resize', positionPopover);
+  };
+
+  useEffect(() => {
+    if (popoverRef.current?.matches(':popover-open')) positionPopover();
+  }, [status, supported]);
+
+  useEffect(
+    () => () => {
+      window.removeEventListener('scroll', positionPopover, true);
+      window.removeEventListener('resize', positionPopover);
+    },
+    [],
+  );
+
+  const translate = async () => {
+    const root = getRoot();
+    if (!root) return;
+
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+    const { signal } = controller;
+
+    setPreferredTarget(target);
+    try {
+      let from = source;
+      if (from === AUTO) {
+        setStatus({ kind: 'detecting' });
+        from = await detectSourceLanguage(root);
+        signal.throwIfAborted();
+      }
+      if (from === target) {
+        restoreRoot(root);
+        setStatus({ kind: 'error', message: `This text already appears to be in ${languageName(target)}.` });
+        return;
+      }
+      setStatus({ kind: 'translating', done: 0, total: 0 });
+      await translateRoot(root, {
+        source: from,
+        target,
+        signal,
+        onDownloadProgress: (progress) => {
+          if (!signal.aborted) setStatus({ kind: 'downloading', progress });
+        },
+        onProgress: (done, total) => {
+          if (!signal.aborted) setStatus({ kind: 'translating', done, total });
+        },
+      });
+      setStatus({ kind: 'translated', source: from, target });
+    } catch (error) {
+      if (signal.aborted) return;
+      restoreRoot(root);
+      setStatus({ kind: 'error', message: describeError(error) });
+    }
+  };
+
+  const showOriginal = () => {
+    abortRef.current?.abort();
+    const root = getRoot();
+    if (root) restoreRoot(root);
+    setStatus({ kind: 'idle' });
+  };
+
+  const busy = status.kind === 'detecting' || status.kind === 'downloading' || status.kind === 'translating';
+  const translated = status.kind === 'translated';
+  const label = translated ? `Translated to ${languageName(status.target)}` : 'Translate';
+
+  return (
+    <>
+      <button
+        ref={buttonRef}
+        type="button"
+        popoverTarget={popoverId}
+        aria-label={variant === 'compact' ? `${label}: translate this teaser` : undefined}
+        title={variant === 'compact' ? label : undefined}
+        className={
+          variant === 'compact'
+            ? `p-1 ${translated ? 'text-amber-500' : 'text-gray-400 hover:text-gray-600'}`
+            : `inline-flex items-center gap-1.5 rounded-full border px-3 h-8 text-sm font-semibold transition-colors ${
+                translated
+                  ? 'border-amber-400 bg-amber-50 text-amber-800'
+                  : 'border-gray-300 text-gray-700 hover:border-gray-400 hover:bg-gray-50'
+              }`
+        }
+      >
+        <LanguageIcon className={`h-5 w-5 ${busy ? 'animate-pulse' : ''}`} aria-hidden="true" />
+        {variant === 'full' && <span>{label}</span>}
+      </button>
+
+      <div
+        ref={popoverRef}
+        id={popoverId}
+        popover="auto"
+        onToggle={handleToggle}
+        role="dialog"
+        aria-label="Translate article"
+        className="fixed inset-auto m-0 w-72 rounded-lg border border-gray-200 bg-white p-4 text-left text-sm text-gray-700 shadow-lg"
+      >
+        <div className="mb-3 flex items-center gap-2">
+          <LanguageIcon className="h-5 w-5 text-amber-500" aria-hidden="true" />
+          <h2 className="font-semibold text-gray-900">Translate</h2>
+          <span className="ml-auto rounded bg-gray-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-gray-500">
+            On-device
+          </span>
+        </div>
+
+        {supported === false ? (
+          <p className="text-gray-600">
+            On-device translation isn't available in this browser. It requires a recent desktop version of Chrome with
+            the built-in Translator API.
+          </p>
+        ) : (
+          <>
+            <label className="mb-2 block">
+              <span className="mb-1 block text-xs font-semibold text-gray-500">From</span>
+              <select
+                value={source}
+                onChange={(e) => setSource(e.target.value)}
+                disabled={busy}
+                className="w-full rounded border border-gray-300 bg-white px-2 py-1.5"
+              >
+                <option value={AUTO}>Detect language</option>
+                <LanguageOptions />
+              </select>
+            </label>
+            <label className="mb-3 block">
+              <span className="mb-1 block text-xs font-semibold text-gray-500">To</span>
+              <select
+                value={target}
+                onChange={(e) => setTarget(e.target.value)}
+                disabled={busy}
+                className="w-full rounded border border-gray-300 bg-white px-2 py-1.5"
+              >
+                <LanguageOptions />
+              </select>
+            </label>
+
+            <div className="flex gap-2">
+              <button
+                type="button"
+                onClick={translate}
+                disabled={busy || (translated && status.target === target && (source === AUTO || source === status.source))}
+                className="flex-1 rounded bg-gray-900 px-3 py-1.5 font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                Translate
+              </button>
+              {(translated || busy) && (
+                <button
+                  type="button"
+                  onClick={showOriginal}
+                  className="flex-1 rounded border border-gray-300 px-3 py-1.5 font-semibold hover:bg-gray-50"
+                >
+                  {busy ? 'Cancel' : 'Show original'}
+                </button>
+              )}
+            </div>
+
+            <p role="status" aria-live="polite" className="mt-3 min-h-5 text-xs text-gray-500">
+              <StatusMessage status={status} />
+            </p>
+            {status.kind === 'downloading' && (
+              <div className="mt-1 h-1 overflow-hidden rounded bg-gray-100" aria-hidden="true">
+                <div className="h-full bg-amber-400 transition-all" style={{ width: `${Math.round(status.progress * 100)}%` }} />
+              </div>
+            )}
+          </>
+        )}
+      </div>
+    </>
+  );
+}
+
+function LanguageOptions() {
+  return (
+    <>
+      {LANGUAGES.map((code) => {
+        const english = languageName(code);
+        const native = nativeLanguageName(code);
+        return (
+          <option key={code} value={code}>
+            {english === native ? english : `${english} — ${native}`}
+          </option>
+        );
+      })}
+    </>
+  );
+}
+
+function StatusMessage({ status }: { status: Status }) {
+  switch (status.kind) {
+    case 'idle':
+      return <>Translation runs locally in your browser. Article text never leaves your device.</>;
+    case 'detecting':
+      return <>Detecting language…</>;
+    case 'downloading':
+      return <>Downloading language model… {Math.round(status.progress * 100)}%</>;
+    case 'translating':
+      return status.total ? <>Translating… {status.done}/{status.total}</> : <>Preparing translation…</>;
+    case 'translated':
+      return (
+        <>
+          Translated from {languageName(status.source)} to {languageName(status.target)}. Machine translations may
+          contain errors.
+        </>
+      );
+    case 'error':
+      return <span className="text-red-700">{status.message}</span>;
+  }
+}
+
+function describeError(error: unknown): string {
+  if (error instanceof TranslationUnavailableError) return error.message;
+  if (error instanceof DOMException && error.name === 'NotAllowedError') {
+    return 'The language model needs to be downloaded. Click Translate again to start the download.';
+  }
+  if (error instanceof DOMException && error.name === 'QuotaExceededError') {
+    return 'There is not enough free disk space to download the language model.';
+  }
+  return 'Something went wrong while translating. Please try again.';
+}
