+  <script>
+    // On-device translation via the browser's built-in Translator API
+    // (no text leaves the device). Originals are kept so every switch
+    // translates from the English source rather than chaining translations.
+    (() => {
+      const SOURCE = 'en';
+      const STORAGE_KEY = 'daily-grind-lang';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = [...document.querySelectorAll('[data-i18n]')];
+      const originals = new Map(nodes.map(el => [el, el.textContent]));
+      const translators = new Map();
+      let requestId = 0;
+
+      const setStatus = msg => { status.textContent = msg; };
+
+      const restore = () => {
+        for (const [el, text] of originals) {
+          el.textContent = text;
+          el.removeAttribute('lang');
+        }
+      };
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser.';
+        setStatus('Translation unavailable');
+        return;
+      }
+
+      async function getTranslator(target) {
+        if (translators.has(target)) return translators.get(target);
+        const opts = { sourceLanguage: SOURCE, targetLanguage: target };
+        const availability = await Translator.availability(opts);
+        if (availability === 'unavailable') return null;
+        const promise = Translator.create({
+          ...opts,
+          monitor(m) {
+            m.addEventListener('downloadprogress', e => {
+              setStatus(`Downloading language… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        translators.set(target, promise);
+        try {
+          return await promise;
+        } catch (err) {
+          translators.delete(target);
+          throw err;
+        }
+      }
+
+      async function applyLanguage(target) {
+        const id = ++requestId;
+        if (target === SOURCE) {
+          restore();
+          setStatus('');
+          return;
+        }
+        setStatus('Translating…');
+        nodes.forEach(el => el.setAttribute('data-translating', ''));
+        try {
+          const translator = await getTranslator(target);
+          if (id !== requestId) return;
+          if (!translator) {
+            restore();
+            setStatus('Language not supported');
+            return;
+          }
+          const results = await Promise.all(
+            nodes.map(el => translator.translate(originals.get(el)))
+          );
+          if (id !== requestId) return;
+          nodes.forEach((el, i) => {
+            el.textContent = results[i];
+            el.setAttribute('lang', target);
+          });
+          setStatus('');
+        } catch (err) {
+          if (id !== requestId) return;
+          console.error('Translation failed:', err);
+          restore();
+          setStatus('Translation failed');
+        } finally {
+          if (id === requestId) {
+            nodes.forEach(el => el.removeAttribute('data-translating'));
+          }
+        }
+      }
+
+      select.addEventListener('change', () => {
+        const target = select.value;
+        localStorage.setItem(STORAGE_KEY, target);
+        applyLanguage(target);
+      });
+
+      // Restore a saved choice on load, but only if the model is already on
+      // the device: downloading a new model requires a user gesture.
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved && saved !== SOURCE && select.querySelector(`option[value="${saved}"]`)) {
+        Translator.availability({ sourceLanguage: SOURCE, targetLanguage: saved })
+          .then(a => {
+            if (a === 'available') {
+              select.value = saved;
+              applyLanguage(saved);
+            }
+          })
+          .catch(() => {});
+      }
+    })();
+  </script>
+
 </body>
 
