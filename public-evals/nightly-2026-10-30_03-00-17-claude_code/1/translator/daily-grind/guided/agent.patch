+  <script type="module">
+    // On-device translation of menu descriptions and story text via the built-in Translator API.
+    const SOURCE = 'en';
+    const TARGETS = ['es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'tr', 'ru', 'uk', 'ar', 'he', 'hi', 'ja', 'ko', 'zh', 'zh-Hant', 'vi', 'th', 'id'];
+    const STORAGE_KEY = 'dailygrind-lang';
+
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('lang-status');
+    const elements = [...document.querySelectorAll('[data-translate]')];
+    const originals = new Map(elements.map((el) => [el, el.textContent.trim().replace(/\s+/g, ' ')]));
+    const translators = new Map();
+    let requestId = 0;
+
+    for (const code of TARGETS) {
+      const label = new Intl.DisplayNames([code], { type: 'language' }).of(code);
+      select.add(new Option(label, code));
+    }
+
+    function restoreOriginals() {
+      for (const el of elements) {
+        el.textContent = originals.get(el);
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+      const options = { sourceLanguage: SOURCE, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round(e.loaded * 100);
+            status.innerHTML = `Downloading <progress max="100" value="${pct}"></progress> ${pct}%`;
+          });
+        },
+      });
+      translators.set(targetLanguage, translator);
+      return translator;
+    }
+
+    async function applyLanguage(lang) {
+      const id = ++requestId;
+      localStorage.setItem(STORAGE_KEY, lang);
+      if (lang === SOURCE) {
+        restoreOriginals();
+        status.textContent = '';
+        return;
+      }
+      status.textContent = 'Translating…';
+      try {
+        const translator = await getTranslator(lang);
+        if (id !== requestId) return;
+        if (!translator) {
+          status.textContent = 'This language isn’t available on your device.';
+          return;
+        }
+        const results = await Promise.all(elements.map((el) => translator.translate(originals.get(el))));
+        if (id !== requestId) return;
+        const dir = new Intl.Locale(lang).getTextInfo?.().direction ?? (['ar', 'he'].includes(lang) ? 'rtl' : 'ltr');
+        elements.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = lang;
+          el.dir = dir;
+        });
+        status.textContent = '';
+      } catch (err) {
+        if (id !== requestId) return;
+        console.error(err);
+        status.textContent = err.name === 'NotAllowedError'
+          ? 'Select the language again to start the download.'
+          : 'Translation failed. Please try again.';
+      }
+    }
+
+    if ('Translator' in self) {
+      select.disabled = false;
+      select.addEventListener('change', () => applyLanguage(select.value));
+
+      // Restore a saved choice only if its model is already on-device (downloads need a user gesture).
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved && saved !== SOURCE && TARGETS.includes(saved)) {
+        Translator.availability({ sourceLanguage: SOURCE, targetLanguage: saved }).then((availability) => {
+          if (availability === 'available' && select.value === SOURCE) {
+            select.value = saved;
+            applyLanguage(saved);
+          }
+        }).catch(() => {});
+      }
+    } else {
+      select.title = 'On-device translation is currently unsupported in this browser';
+      status.textContent = 'Translation unsupported in this browser';
+    }
+  </script>
+
 </body>
 
