+  <script>
+    (() => {
+      const message = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('detect-status');
+      const displayNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      let detectorPromise = null;
+
+      function setStatus(text, isError = false) {
+        status.textContent = text;
+        status.classList.toggle('error', isError);
+      }
+
+      function languageName(code) {
+        try {
+          return displayNames.of(code) || code;
+        } catch {
+          return code;
+        }
+      }
+
+      async function getDetector() {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          throw new Error('Language detection is not available on this device.');
+        }
+
+        const needsDownload = availability === 'downloadable' || availability === 'downloading';
+        return LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round(e.loaded * 100);
+              progress.hidden = false;
+              progress.value = percent;
+              setStatus(`Downloading language model... ${percent}%`);
+            });
+          }
+        }).finally(() => {
+          if (needsDownload) progress.hidden = true;
+        });
+      }
+
+      if (!('LanguageDetector' in self)) {
+        button.disabled = true;
+        setStatus('Language detection is not supported in this browser.', true);
+        return;
+      }
+
+      button.addEventListener('click', async () => {
+        const text = message.value.trim();
+        if (!text) {
+          setStatus('Please enter a message first.', true);
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Detecting language...');
+        try {
+          detectorPromise ??= getDetector();
+          const detector = await detectorPromise;
+          const [top] = await detector.detect(text);
+
+          if (!top || top.detectedLanguage === 'und') {
+            setStatus('Could not determine the language.', true);
+          } else {
+            const confidence = (top.confidence * 100).toFixed(1);
+            setStatus(`Detected language: ${languageName(top.detectedLanguage)} (${confidence}% confidence)`);
+          }
+        } catch (err) {
+          detectorPromise = null;
+          progress.hidden = true;
+          setStatus(err.message || 'Language detection failed.', true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
