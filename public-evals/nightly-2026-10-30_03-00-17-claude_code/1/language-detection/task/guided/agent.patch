+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const message = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('feedback-status');
+      const languageNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      let detectorPromise = null;
+
+      const unsupported = (text) => {
+        button.disabled = true;
+        status.textContent = text;
+      };
+
+      if (!('LanguageDetector' in self)) {
+        unsupported('Language detection is not supported in this browser.');
+        return;
+      }
+
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          unsupported('Language detection is unavailable on this device.');
+        } else if (availability !== 'available') {
+          status.textContent = 'The language model will be downloaded the first time you click Detect.';
+        }
+      }).catch(() => unsupported('Language detection is unavailable on this device.'));
+
+      // create() must run from a user gesture when the model needs downloading.
+      const getDetector = () => {
+        detectorPromise ??= LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round(e.loaded * 100);
+              progress.hidden = false;
+              progress.value = percent;
+              status.textContent = `Downloading language model: ${percent}%`;
+            });
+          },
+        }).catch((err) => {
+          detectorPromise = null;
+          throw err;
+        });
+        return detectorPromise;
+      };
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const text = message.value.trim();
+        if (!text) {
+          status.textContent = 'Please enter a message first.';
+          message.focus();
+          return;
+        }
+
+        button.disabled = true;
+        status.textContent = 'Detecting…';
+        try {
+          const detector = await getDetector();
+          progress.hidden = true;
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            status.textContent = 'Could not determine the language. Try writing a longer message.';
+            return;
+          }
+          const name = languageNames.of(top.detectedLanguage) ?? top.detectedLanguage;
+          const confidence = (top.confidence * 100).toFixed(1);
+          status.replaceChildren(
+            'Detected language: ', Object.assign(document.createElement('strong'), { textContent: name }),
+            ` (${confidence}% confident)`
+          );
+        } catch (err) {
+          progress.hidden = true;
+          status.textContent = `Language detection failed: ${err.message}`;
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
