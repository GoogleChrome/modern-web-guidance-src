+  <script>
+    (() => {
+      const form = document.querySelector('.order-form');
+      const sweetness = form.elements.sweetness;
+      const sweetnessOut = document.getElementById('sweetness-out');
+      const shots = form.elements.shots;
+      const strength = document.getElementById('strength');
+      const pickupDate = form.elements['pickup-date'];
+
+      const sync = () => {
+        sweetnessOut.value = `${sweetness.value}%`;
+        strength.value = shots.value;
+        strength.textContent = `${shots.value} of 4`;
+      };
+
+      const today = new Date();
+      today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
+      pickupDate.min = today.toISOString().slice(0, 10);
+      pickupDate.value = pickupDate.min;
+
+      form.addEventListener('input', sync);
+      form.addEventListener('reset', () => setTimeout(() => {
+        pickupDate.value = pickupDate.min;
+        sync();
+      }));
+    })();
+  </script>
