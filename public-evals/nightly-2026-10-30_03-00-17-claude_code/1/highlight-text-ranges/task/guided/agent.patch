+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('menu-grid');
+      const supportsHighlights = 'highlights' in CSS;
+
+      function getTextNodes() {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+          if (n.textContent.trim()) nodes.push(n);
+        }
+        return nodes;
+      }
+
+      // Yields [node, start, end] for each case-insensitive match.
+      function* findMatches(nodes, term) {
+        for (const node of nodes) {
+          const text = node.textContent.toLowerCase();
+          let pos = text.indexOf(term);
+          while (pos !== -1) {
+            yield [node, pos, pos + term.length];
+            pos = text.indexOf(term, pos + term.length);
+          }
+        }
+      }
+
+      // Menu content is static, so the text node list can be cached.
+      const textNodes = supportsHighlights ? getTextNodes() : null;
+
+      function highlightWithApi(term) {
+        CSS.highlights.delete('menu-search');
+        if (!term) return;
+        const ranges = [];
+        for (const [node, start, end] of findMatches(textNodes, term)) {
+          const range = new Range();
+          range.setStart(node, start);
+          range.setEnd(node, end);
+          ranges.push(range);
+        }
+        if (ranges.length) CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+
+      function highlightWithMarks(term) {
+        for (const mark of grid.querySelectorAll('mark.search-match')) {
+          const parent = mark.parentNode;
+          mark.replaceWith(mark.textContent);
+          parent.normalize();
+        }
+        if (!term) return;
+        // Wrap from the end so earlier offsets in the same node stay valid.
+        for (const [node, start, end] of [...findMatches(getTextNodes(), term)].reverse()) {
+          const range = new Range();
+          range.setStart(node, start);
+          range.setEnd(node, end);
+          const mark = document.createElement('mark');
+          mark.className = 'search-match';
+          range.surroundContents(mark);
+        }
+      }
+
+      input.addEventListener('input', () => {
+        const term = input.value.trim().toLowerCase();
+        if (supportsHighlights) highlightWithApi(term);
+        else highlightWithMarks(term);
+      });
+    })();
+  </script>
+
