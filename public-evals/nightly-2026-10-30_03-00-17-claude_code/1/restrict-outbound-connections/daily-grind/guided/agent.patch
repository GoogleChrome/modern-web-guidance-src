+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section class="newsletter" aria-labelledby="newsletter-title">
+      <h2 id="newsletter-title">Join the Grind Gazette</h2>
+      <p>New roasts, seasonal drinks, and member-only offers, straight to your inbox.</p>
+      <form id="newsletter-form" class="newsletter-form" action="/api/newsletter" method="POST">
+        <div class="field">
+          <label for="newsletter-email">Email address <span aria-hidden="true">*</span></label>
+          <input type="email" id="newsletter-email" name="email" autocomplete="email" required maxlength="254"
+            autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="send"
+            aria-describedby="newsletter-email-error">
+          <p id="newsletter-email-error" class="error-msg">
+            <span aria-hidden="true">⚠</span> Please enter a valid email address.
+          </p>
+        </div>
+        <!-- Honeypot: hidden from people, often filled by bots -->
+        <div class="visually-hidden" aria-hidden="true">
