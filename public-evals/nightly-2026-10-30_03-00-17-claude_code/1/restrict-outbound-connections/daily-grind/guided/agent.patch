index 0000000..7bc306e
--- /dev/null
+++ b/public/newsletter.js
@@ -0,0 +1,62 @@
+// Newsletter signup: submits to our own server and tells the customer when
+// a request can't go through (offline, server error, or blocked by the
+// page's outbound connection policy).
+(() => {
+  const form = document.getElementById('newsletter-form');
+  if (!form) return;
+
+  const email = form.elements.email;
+  const button = form.querySelector('button[type="submit"]');
+  const status = document.getElementById('newsletter-status');
+
+  const showStatus = (state, message) => {
+    status.dataset.state = state;
+    status.textContent = message;
+  };
+
+  const syncAriaInvalid = () => {
+    if (email.matches(':user-invalid')) {
+      email.setAttribute('aria-invalid', 'true');
+    } else {
+      email.removeAttribute('aria-invalid');
+    }
+  };
+
+  email.addEventListener('blur', syncAriaInvalid);
+  email.addEventListener('input', () => {
+    if (email.hasAttribute('aria-invalid')) syncAriaInvalid();
+  });
+  email.addEventListener('invalid', () => email.setAttribute('aria-invalid', 'true'));
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (button.disabled) return;
+
+    button.disabled = true;
+    showStatus('pending', 'Signing you up…');
+
+    try {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { Accept: 'application/json' },
+        body: new URLSearchParams(new FormData(form)),
+      });
+      const result = await response.json().catch(() => ({}));
+
+      if (!response.ok) {
+        showStatus('error', result.error || 'Sorry, we couldn’t sign you up right now. Please try again in a moment.');
+        return;
+      }
+
+      form.reset();
+      email.removeAttribute('aria-invalid');
+      showStatus('success', result.message || 'Thanks! You’re on the list.');
+    } catch {
+      // fetch() rejects with a TypeError when the request never reached the
+      // server: no connection, or blocked by Connection-Allowlist / CSP.
+      showStatus('error', 'We couldn’t reach our server, so your signup didn’t go through. Please check your connection and try again.');
+    } finally {
+      button.disabled = false;
+    }
+  });
+})();
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..d5e5291
