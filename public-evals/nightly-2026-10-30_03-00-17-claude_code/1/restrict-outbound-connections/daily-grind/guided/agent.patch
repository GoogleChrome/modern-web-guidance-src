+// Minimal Node server for the Daily Grind homepage.
+// Serves the static site with strict outbound-connection headers and accepts
+// newsletter signups at POST /api/newsletter.
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { existsSync, readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PUBLIC_DIR = path.join(ROOT, 'public');
+const DATA_DIR = path.join(ROOT, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const PORT = Number(process.env.PORT) || 11222;
+const MAX_BODY_BYTES = 10 * 1024;
+
+// The only third-party origin the page may talk to.
+const PHOTO_HOST = 'https://images.unsplash.com';
+
+// Explicit list of files we serve; nothing else on disk is reachable.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/newsletter.js': { file: 'newsletter.js', type: 'text/javascript; charset=utf-8' },
+};
+
+// Connection-Allowlist (Chrome/Edge 152+) restricts every outbound connection
+// the page can make: fetch, subresources, navigations, beacons, resource hints,
+// WebSocket and WebRTC. Must be an RFC 9651 inner list; a malformed value
+// makes the browser block everything.
+const CONNECTION_ALLOWLIST = `(response-origin "${PHOTO_HOST}"); report-to=security-reports`;
+
+// CSP is the fallback for browsers without Connection-Allowlist. default-src
+// does not cover form-action, frame-ancestors or base-uri, so set them too.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${PHOTO_HOST}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "form-action 'self'",
+  "worker-src 'self'",
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  'report-to security-reports',
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Connection-Allowlist': CONNECTION_ALLOWLIST,
+  'Content-Security-Policy': CONTENT_SECURITY_POLICY,
+  'Reporting-Endpoints': 'security-reports="/api/security-reports"',
+  'Referrer-Policy': 'no-referrer',
+  'X-Content-Type-Options': 'nosniff',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+};
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+const subscribers = new Set(
+  existsSync(SUBSCRIBERS_FILE)
+    ? readFileSync(SUBSCRIBERS_FILE, 'utf8')
+        .split('\n')
+        .filter(Boolean)
+        .map((line) => JSON.parse(line).email)
+    : [],
+);
+
+function send(res, status, type, body, extraHeaders = {}) {
+  res.writeHead(status, {
+    ...SECURITY_HEADERS,
+    'Content-Type': type,
+    'Content-Length': Buffer.byteLength(body),
+    ...extraHeaders,
+  });
+  res.end(body);
+}
+
+function escapeHtml(text) {
+  return text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+}
+
+// Plain HTML response for form posts made without JavaScript. We don't
+// redirect because Connection-Allowlist blocks 3xx redirects by default.
+function sendFormResult(res, status, message) {
+  const html = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Newsletter | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container newsletter">
+    <h2>${status < 400 ? 'Thanks!' : 'Something went wrong'}</h2>
+    <p>${escapeHtml(message)}</p>
+    <a href="/" class="btn">Back to the homepage</a>
+  </main>
+</body>
+</html>`;
+  send(res, status, 'text/html; charset=utf-8', html);
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function isCrossSite(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') return true;
+  const origin = req.headers.origin;
+  if (origin && origin !== 'null') {
+    try {
+      return new URL(origin).host !== req.headers.host;
+    } catch {
+      return true;
+    }
+  }
+  return false;
+}
+
+async function handleNewsletter(req, res) {
+  const wantsJson = (req.headers.accept || '').includes('application/json');
+  const reply = (status, message) =>
+    wantsJson
+      ? send(res, status, 'application/json; charset=utf-8',
+          JSON.stringify(status < 400 ? { message } : { error: message }))
+      : sendFormResult(res, status, message);
+
+  if (isCrossSite(req)) {
+    return reply(403, 'Signups must come from our website.');
+  }
+
+  let fields;
+  try {
+    const body = await readBody(req);
+    const type = (req.headers['content-type'] || '').split(';')[0].trim();
+    if (type === 'application/x-www-form-urlencoded') {
+      fields = Object.fromEntries(new URLSearchParams(body));
+    } else if (type === 'application/json') {
+      fields = JSON.parse(body);
+    } else {
+      return reply(415, 'Unsupported request format.');
+    }
+  } catch (error) {
+    return reply(error.status || 400, 'We couldn’t read your signup. Please try again.');
+  }
+
+  // Honeypot filled in: pretend success so bots don't retry.
+  if (fields.website) {
+    return reply(200, 'Thanks! You’re on the list.');
+  }
+
+  const email = String(fields.email || '').trim().toLowerCase();
+  if (email.length > 254 || !EMAIL_PATTERN.test(email)) {
+    return reply(422, 'Please enter a valid email address.');
+  }
+
+  if (!subscribers.has(email)) {
+    try {
+      await mkdir(DATA_DIR, { recursive: true });
+      await appendFile(SUBSCRIBERS_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n');
+      subscribers.add(email);
+    } catch (error) {
+      console.error('Failed to save subscriber:', error);
+      return reply(500, 'Sorry, we couldn’t sign you up right now. Please try again in a moment.');
+    }
+  }
+
+  return reply(200, 'Thanks! You’re on the list. Watch your inbox for the next Grind Gazette.');
+}
+
+async function handleSecurityReport(req, res) {
+  try {
+    const body = await readBody(req);
+    console.warn('Security policy report:', body);
+  } catch {
+    // Ignore malformed or oversized reports.
+  }
+  res.writeHead(204, SECURITY_HEADERS);
+  res.end();
+}
+
+async function handleStatic(req, res, pathname) {
+  const entry = STATIC_FILES[pathname];
+  if (!entry) {
+    return send(res, 404, 'text/plain; charset=utf-8', 'Not found');
+  }
+  const body = await readFile(path.join(PUBLIC_DIR, entry.file));
+  res.writeHead(200, {
+    ...SECURITY_HEADERS,
+    'Content-Type': entry.type,
+    'Content-Length': body.length,
+    'Cache-Control': 'no-cache',
+  });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        return send(res, 405, 'text/plain; charset=utf-8', 'Method not allowed', { Allow: 'POST' });
+      }
+      return await handleNewsletter(req, res);
+    }
+
+    if (pathname === '/api/security-reports') {
+      if (req.method !== 'POST') {
+        return send(res, 405, 'text/plain; charset=utf-8', 'Method not allowed', { Allow: 'POST' });
+      }
+      return await handleSecurityReport(req, res);
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      return send(res, 405, 'text/plain; charset=utf-8', 'Method not allowed', { Allow: 'GET, HEAD' });
+    }
+    return await handleStatic(req, res, pathname);
+  } catch (error) {
+    console.error(error);
+    if (!res.headersSent) {
+      send(res, 500, 'text/plain; charset=utf-8', 'Internal server error');
+    } else {
+      res.end();
+    }
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind is serving on http://localhost:${PORT}`);
+});
