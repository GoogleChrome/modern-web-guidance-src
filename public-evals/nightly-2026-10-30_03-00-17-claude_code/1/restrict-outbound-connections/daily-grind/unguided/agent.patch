+++ b/server.js
@@ -0,0 +1,213 @@
+'use strict';
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.ndjson');
+const MAX_BODY_BYTES = 2 * 1024;
+
+// The page may only talk to this server, plus load photos from Unsplash.
+// No inline scripts/styles are allowed, so an injected <script> or handler
+// attribute can't run, and anything that does run can't send data elsewhere.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "font-src 'self'",
+  "manifest-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  "object-src 'none'",
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CONTENT_SECURITY_POLICY,
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=()',
+};
+
+// Only these files are served; nothing else under public/ (or elsewhere) is reachable.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/newsletter.js': { file: 'newsletter.js', type: 'text/javascript; charset=utf-8' },
+};
+
+const EMAIL_PATTERN = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;
+
+function send(res, status, headers, body) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, payload) {
+  send(res, status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' }, JSON.stringify(payload));
+}
+
+function redirect(res, location) {
+  send(res, 303, { Location: location, 'Cache-Control': 'no-store' }, '');
+}
+
+async function serveStatic(req, res, entry) {
+  try {
+    const body = await fsp.readFile(path.join(PUBLIC_DIR, entry.file));
+    send(res, 200, { 'Content-Type': entry.type, 'Content-Length': body.length, 'Cache-Control': 'no-cache' },
+      req.method === 'HEAD' ? undefined : body);
+  } catch (err) {
+    console.error('Failed to read static file', entry.file, err);
+    send(res, 500, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Internal Server Error');
+  }
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Body too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function parseEmail(contentType, raw) {
+  if (contentType.startsWith('application/json')) {
+    const data = JSON.parse(raw);
+    return typeof data?.email === 'string' ? data.email : '';
+  }
+  if (contentType.startsWith('application/x-www-form-urlencoded')) {
+    return new URLSearchParams(raw).get('email') || '';
+  }
+  return null;
+}
+
+let subscribers = null;
+let writeQueue = Promise.resolve();
+
+async function loadSubscribers() {
+  const set = new Set();
+  try {
+    const contents = await fsp.readFile(SUBSCRIBERS_FILE, 'utf8');
+    for (const line of contents.split('\n')) {
+      if (!line.trim()) continue;
+      try {
+        set.add(JSON.parse(line).email);
+      } catch {
+        // Skip malformed lines rather than refusing to start.
+      }
+    }
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+  }
+  return set;
+}
+
+function addSubscriber(email) {
+  // Serialize writes so concurrent signups can't interleave or double-add.
+  const task = writeQueue.then(async () => {
+    if (!subscribers) subscribers = await loadSubscribers();
+    if (subscribers.has(email)) return;
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    await fsp.appendFile(SUBSCRIBERS_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n');
+    subscribers.add(email);
+  });
+  writeQueue = task.catch(() => {});
+  return task;
+}
+
+async function handleNewsletter(req, res) {
+  const contentType = (req.headers['content-type'] || '').toLowerCase();
+  const wantsJson = contentType.startsWith('application/json');
+  const respond = (status, result, error) => {
+    if (wantsJson) {
+      sendJson(res, status, status < 300 ? { ok: true } : { ok: false, error });
+    } else {
+      redirect(res, `/?newsletter=${result}#newsletter-title`);
+    }
+  };
+
+  // Reject signups submitted from other sites.
+  if (req.headers['sec-fetch-site'] === 'cross-site') {
+    return respond(403, 'error', 'Cross-site requests are not allowed.');
+  }
+
+  let email;
+  try {
+    email = parseEmail(contentType, await readBody(req));
+  } catch (err) {
+    if (err.status === 413) return respond(413, 'invalid', 'Request too large.');
+    return respond(400, 'invalid', 'Please enter a valid email address.');
+  }
+  if (email === null) {
+    return respond(415, 'error', 'Unsupported content type.');
+  }
+
+  email = email.trim().toLowerCase();
+  if (email.length > 254 || !EMAIL_PATTERN.test(email)) {
+    return respond(400, 'invalid', 'Please enter a valid email address.');
+  }
+
+  try {
+    await addSubscriber(email);
+  } catch (err) {
+    console.error('Failed to save subscriber', err);
+    return respond(500, 'error', 'Something went wrong. Please try again later.');
+  }
+  return respond(201, 'ok');
+}
+
+const server = http.createServer((req, res) => {
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      return send(res, 405, { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' }, 'Method Not Allowed');
+    }
+    handleNewsletter(req, res).catch((err) => {
+      console.error('Newsletter handler error', err);
+      if (!res.headersSent) sendJson(res, 500, { ok: false, error: 'Something went wrong. Please try again later.' });
+    });
+    return;
+  }
+
+  const entry = STATIC_FILES[pathname];
+  if (entry) {
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      return send(res, 405, { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' }, 'Method Not Allowed');
+    }
+    return serveStatic(req, res, entry);
+  }
+
+  send(res, 404, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Not Found');
+});
+
+if (require.main === module) {
+  if (!fs.existsSync(path.join(PUBLIC_DIR, 'index.html'))) {
+    console.error(`Missing ${path.join(PUBLIC_DIR, 'index.html')}`);
+    process.exit(1);
+  }
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind is brewing on http://localhost:${PORT}`);
+  });
+}
+
+module.exports = { server, CONTENT_SECURITY_POLICY };
