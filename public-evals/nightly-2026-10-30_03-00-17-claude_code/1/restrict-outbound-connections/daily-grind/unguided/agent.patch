--- /dev/null
+++ b/public/newsletter.js
@@ -0,0 +1,92 @@
+(function () {
+  'use strict';
+
+  var MESSAGES = {
+    ok: "Thanks for subscribing! Watch your inbox for our next brew.",
+    invalid: 'Please enter a valid email address.',
+    error: "Sorry, we couldn't sign you up right now. Please try again in a moment.",
+    blocked: "Sorry, that request couldn't go through. Please refresh the page and try again.",
+    offline: "You appear to be offline. Check your connection and try again."
+  };
+
+  var form, input, button, status;
+
+  function showStatus(kind, text) {
+    status.textContent = text;
+    status.className = 'newsletter-status ' + (kind === 'ok' ? 'is-success' : 'is-error');
+    status.hidden = false;
+  }
+
+  function setBusy(busy) {
+    button.disabled = busy;
+    button.textContent = busy ? 'Subscribing…' : 'Subscribe';
+  }
+
+  // Fired when the Content-Security-Policy blocks something the page tried to
+  // load or send (e.g. a request to a host other than ours or Unsplash).
+  document.addEventListener('securitypolicyviolation', function (event) {
+    if (!status) return;
+    var directive = event.effectiveDirective || event.violatedDirective || '';
+    if (directive.indexOf('connect-src') === 0 || directive.indexOf('form-action') === 0) {
+      showStatus('error', MESSAGES.blocked);
+    }
+  });
+
+  document.addEventListener('DOMContentLoaded', function () {
+    form = document.getElementById('newsletter-form');
+    input = document.getElementById('newsletter-email');
+    status = document.getElementById('newsletter-status');
+    if (!form || !input || !status) return;
+    button = form.querySelector('button[type="submit"]');
+
+    // Result of a non-JS form post, which the server redirects back with ?newsletter=...
+    var params = new URLSearchParams(window.location.search);
+    var result = params.get('newsletter');
+    if (result && Object.prototype.hasOwnProperty.call(MESSAGES, result)) {
+      showStatus(result, MESSAGES[result]);
+      params.delete('newsletter');
+      var query = params.toString();
+      history.replaceState(null, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
+    }
+
+    form.addEventListener('submit', function (event) {
+      event.preventDefault();
+
+      var email = input.value.trim();
+      if (!email || !input.checkValidity()) {
+        showStatus('error', MESSAGES.invalid);
+        input.focus();
+        return;
+      }
+
+      setBusy(true);
+      status.hidden = true;
+
+      fetch('/api/newsletter', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ email: email })
+      })
+        .then(function (response) {
+          return response.json().catch(function () { return {}; }).then(function (data) {
+            if (response.ok) {
+              showStatus('ok', MESSAGES.ok);
+              form.reset();
+            } else if (response.status === 400) {
+              showStatus('error', data.error || MESSAGES.invalid);
+            } else {
+              showStatus('error', MESSAGES.error);
+            }
+          });
+        })
+        .catch(function () {
+          // fetch rejects on network failure or when CSP blocks the request.
+          showStatus('error', navigator.onLine === false ? MESSAGES.offline : MESSAGES.blocked);
+        })
+        .then(function () {
+          setBusy(false);
+        });
+    });
+  });
+})();
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..deb5bbd
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,225 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  margin-top: 50px;
+  padding: 40px 20px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 10px;
+  margin-top: 15px;
+}
+
+.newsletter-form input {
+  flex: 1 1 260px;
+  max-width: 360px;
+  padding: 10px 14px;
+  font: inherit;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+}
+
+.newsletter-form input:focus {
+  outline: 2px solid var(--accent);
+  border-color: var(--accent);
+}
+
+.newsletter-form .btn {
+  margin-top: 0;
+  border: none;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-form .btn:disabled {
+  opacity: 0.6;
+  cursor: wait;
+}
+
+.newsletter-status {
+  margin-top: 15px;
+  padding: 10px 14px;
+  border-radius: 5px;
+  display: inline-block;
+}
+
+.newsletter-status.is-success {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.newsletter-status.is-error {
+  background: #ffebee;
+  color: #b71c1c;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
