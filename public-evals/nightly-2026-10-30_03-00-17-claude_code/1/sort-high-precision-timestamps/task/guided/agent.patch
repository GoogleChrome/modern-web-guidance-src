+  <!-- Batch of out-of-order order events, as collected from backend services. -->
+  <script type="application/json" id="order-events">
+    [
+      { "service": "barista-queue", "event": "drink.started", "orderId": "A-1042", "ts": "2026-10-30T08:15:02.418000250Z" },
+      { "service": "order-api", "event": "order.received", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.000123456Z" },
+      { "service": "payments", "event": "payment.authorized", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.734567001Z" },
+      { "service": "order-api", "event": "order.validated", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.000123789Z" },
+      { "service": "notifications", "event": "customer.notified", "orderId": "A-1042", "ts": "2026-10-30T08:18:47.002999999Z" },
+      { "service": "payments", "event": "payment.requested", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.000124001Z" },
+      { "service": "barista-queue", "event": "drink.completed", "orderId": "A-1042", "ts": "2026-10-30T08:18:47.002000000Z" },
+      { "service": "inventory", "event": "stock.reserved", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.734567001Z" },
+      { "service": "barista-queue", "event": "drink.queued", "orderId": "A-1042", "ts": "2026-10-30T08:15:00.735000000Z" }
+    ]
+  </script>
+
+  <script type="module">
+    // Temporal isn't available in every browser yet; load the polyfill only when needed.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('timeline-status');
+    const output = document.getElementById('timeline-output');
+    const tbody = document.getElementById('timeline-body');
+
+    function loadEvents() {
+      const raw = JSON.parse(document.getElementById('order-events').textContent);
+      // Temporal.Instant keeps all nine fractional digits; new Date() would truncate to milliseconds.
+      return raw.map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }));
+    }
+
+    function cell(row, text, tag = 'td') {
+      const el = document.createElement(tag);
+      el.textContent = text;
+      row.append(el);
+      return el;
+    }
+
+    button.addEventListener('click', () => {
+      const sorted = loadEvents().toSorted((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+      const rows = sorted.map((evt, i) => {
+        const row = document.createElement('tr');
+        cell(row, i + 1, 'th').scope = 'row';
+
+        const tsCell = cell(row, '');
+        const time = document.createElement('time');
+        time.dateTime = evt.instant.toString();
+        const code = document.createElement('code');
+        code.textContent = evt.instant.toString({ fractionalSecondDigits: 9 });
+        time.append(code);
+        tsCell.append(time);
+
+        cell(row, evt.service);
+        cell(row, evt.event);
+        cell(row, evt.orderId);
+
+        if (i === 0) {
+          cell(row, '—');
+        } else {
+          const prev = sorted[i - 1].instant;
+          if (evt.instant.equals(prev)) {
+            cell(row, 'Same instant').className = 'tie';
+          } else {
+            // Keep the gap as a Duration so sub-millisecond units survive formatting.
+            const gap = evt.instant.since(prev, { largestUnit: 'hour' });
+            cell(row, gap.toLocaleString(undefined, { style: 'narrow' })).title = gap.toString();
+          }
+        }
+        return row;
+      });
+
+      tbody.replaceChildren(...rows);
+      output.hidden = false;
+
+      const total = sorted.at(-1).instant.since(sorted[0].instant, { largestUnit: 'hour' });
+      status.textContent = `Sorted ${sorted.length} events spanning ${total.toLocaleString(undefined, { style: 'long' })}.`;
+    });
+
+    button.disabled = false;
+  </script>
+
 </body>
 
