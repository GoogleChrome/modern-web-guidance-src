+  <script>
+    (function () {
+      // Timestamps are handled as BigInt nanoseconds since the Unix epoch.
+      // Date/Number only hold millisecond precision, so they are never used
+      // for parsing or arithmetic here.
+      var NS_PER_US = 1000n;
+      var NS_PER_MS = 1000000n;
+      var NS_PER_S = 1000000000n;
+      var NS_PER_DAY = 86400n * NS_PER_S;
+
+      var TS_RE = /^(\d{4})-(\d{2})-(\d{2})[Tt ](\d{2}):(\d{2}):(\d{2})(?:\.(\d{1,9}))?([Zz]|[+-]\d{2}:\d{2})$/;
+
+      function floorDiv(a, b) {
+        var q = a / b;
+        return (a % b !== 0n && (a < 0n) !== (b < 0n)) ? q - 1n : q;
+      }
+
+      // Days since 1970-01-01 for a proleptic Gregorian date (H. Hinnant's algorithm).
+      function daysFromCivil(y, m, d) {
+        y -= m <= 2n ? 1n : 0n;
+        var era = floorDiv(y, 400n);
+        var yoe = y - era * 400n;
+        var mp = (m + 9n) % 12n;
+        var doy = (153n * mp + 2n) / 5n + d - 1n;
+        var doe = yoe * 365n + yoe / 4n - yoe / 100n + doy;
+        return era * 146097n + doe - 719468n;
+      }
+
+      function civilFromDays(z) {
+        z += 719468n;
+        var era = floorDiv(z, 146097n);
+        var doe = z - era * 146097n;
+        var yoe = (doe - doe / 1460n + doe / 36524n - doe / 146096n) / 365n;
+        var doy = doe - (365n * yoe + yoe / 4n - yoe / 100n);
+        var mp = (5n * doy + 2n) / 153n;
+        var d = doy - (153n * mp + 2n) / 5n + 1n;
+        var m = mp < 10n ? mp + 3n : mp - 9n;
+        var y = yoe + era * 400n + (m <= 2n ? 1n : 0n);
+        return { y: y, m: m, d: d };
+      }
+
+      function daysInMonth(y, m) {
+        if (m === 2n) {
+          var leap = (y % 4n === 0n && y % 100n !== 0n) || y % 400n === 0n;
+          return leap ? 29n : 28n;
+        }
+        return [4n, 6n, 9n, 11n].indexOf(m) >= 0 ? 30n : 31n;
+      }
+
+      function parseTimestampNs(str) {
+        var match = TS_RE.exec(String(str).trim());
+        if (!match) throw new Error('Unrecognized timestamp: ' + str);
+        var y = BigInt(match[1]), mo = BigInt(match[2]), d = BigInt(match[3]);
+        var h = BigInt(match[4]), mi = BigInt(match[5]), s = BigInt(match[6]);
+        if (mo < 1n || mo > 12n || d < 1n || d > daysInMonth(y, mo) ||
+          h > 23n || mi > 59n || s > 59n) {
+          throw new Error('Out-of-range timestamp: ' + str);
+        }
+        // Right-pad the fraction to 9 digits so ".4187729" means 418772900 ns.
+        var frac = BigInt(((match[7] || '') + '000000000').slice(0, 9));
+        var offsetNs = 0n;
+        var tz = match[8];
+        if (tz !== 'Z' && tz !== 'z') {
+          var sign = tz[0] === '-' ? -1n : 1n;
+          var oh = BigInt(tz.slice(1, 3)), om = BigInt(tz.slice(4, 6));
+          if (oh > 23n || om > 59n) throw new Error('Bad UTC offset: ' + str);
+          offsetNs = sign * (oh * 3600n + om * 60n) * NS_PER_S;
+        }
+        return daysFromCivil(y, mo, d) * NS_PER_DAY +
+          (h * 3600n + mi * 60n + s) * NS_PER_S + frac - offsetNs;
+      }
+
+      function pad(n, width) {
+        return String(n).padStart(width, '0');
+      }
+
+      function formatTimestampNs(ns) {
+        var days = floorDiv(ns, NS_PER_DAY);
+        var rem = ns - days * NS_PER_DAY;
+        var date = civilFromDays(days);
+        var secs = rem / NS_PER_S;
+        var frac = rem % NS_PER_S;
+        return pad(date.y, 4) + '-' + pad(date.m, 2) + '-' + pad(date.d, 2) + 'T' +
+          pad(secs / 3600n, 2) + ':' + pad((secs % 3600n) / 60n, 2) + ':' + pad(secs % 60n, 2) +
+          '.' + pad(frac, 9) + 'Z';
+      }
+
+      // Exact, human-readable duration, e.g. "2.000 000 001 s", "702 ns", "1.250 ms".
+      function formatDurationNs(ns) {
+        var neg = ns < 0n;
+        var abs = neg ? -ns : ns;
+        var out;
+        if (abs < NS_PER_US) {
+          out = abs + ' ns';
+        } else if (abs < NS_PER_MS) {
+          out = (abs / NS_PER_US) + '.' + pad(abs % NS_PER_US, 3) + ' µs';
+        } else if (abs < NS_PER_S) {
+          var us = pad(abs % NS_PER_MS, 6);
+          out = (abs / NS_PER_MS) + '.' + us.slice(0, 3) + ' ' + us.slice(3) + ' ms';
+        } else {
+          var f = pad(abs % NS_PER_S, 9);
+          out = (abs / NS_PER_S) + '.' + f.slice(0, 3) + ' ' + f.slice(3, 6) + ' ' + f.slice(6) + ' s';
+        }
+        return (neg ? '−' : '') + out;
+      }
+
+      function compareBigInt(a, b) {
+        return a < b ? -1 : a > b ? 1 : 0;
+      }
+
+      function sortEvents(rawEvents) {
+        var events = rawEvents.map(function (e, i) {
+          return Object.assign({}, e, { ns: parseTimestampNs(e.timestamp), arrival: i });
+        });
+        // Exact chronological order; identical timestamps keep their arrival order.
+        events.sort(function (a, b) {
+          return compareBigInt(a.ns, b.ns) || a.arrival - b.arrival;
+        });
+        var intervals = [];
+        events.forEach(function (e, i) {
+          e.delta = i === 0 ? null : e.ns - events[i - 1].ns;
+          if (e.delta !== null) intervals.push(e.delta);
+        });
+        return { events: events, intervals: intervals };
+      }
+
+      function summarize(result) {
+        var iv = result.intervals;
+        var ev = result.events;
+        if (!iv.length) return null;
+        var min = iv[0], max = iv[0], sum = 0n;
+        iv.forEach(function (d) {
+          if (d < min) min = d;
+          if (d > max) max = d;
+          sum += d;
+        });
+        var span = ev[ev.length - 1].ns - ev[0].ns;
+        return {
+          span: span,
+          min: min,
+          max: max,
+          mean: sum / BigInt(iv.length),
+          subMs: iv.filter(function (d) { return d > 0n && d < NS_PER_MS; }).length,
+          ties: iv.filter(function (d) { return d === 0n; }).length
+        };
+      }
+
+      var btn = document.getElementById('load-events-btn');
+      var statusEl = document.getElementById('timeline-status');
+      var summaryEl = document.getElementById('timeline-summary');
+      var table = document.getElementById('timeline-table');
+      var tbody = table.querySelector('tbody');
+
+      function cell(text, className) {
+        var td = document.createElement('td');
+        td.textContent = text;
+        if (className) td.className = className;
+        return td;
+      }
+
+      function render(batch, result) {
+        tbody.textContent = '';
+        result.events.forEach(function (e, i) {
+          var tr = document.createElement('tr');
+          if (e.delta === 0n) tr.className = 'tie';
+          else if (e.delta !== null && e.delta < NS_PER_MS) tr.className = 'submilli';
+          tr.appendChild(cell(String(i + 1)));
+          tr.appendChild(cell(formatTimestampNs(e.ns), 'mono'));
+          tr.appendChild(cell(e.service || '—'));
+          tr.appendChild(cell(e.type || '—'));
+          tr.appendChild(cell(e.orderId || '—'));
+          tr.appendChild(cell(e.delta === null ? '—' : formatDurationNs(e.delta), 'mono num delta'));
+          tbody.appendChild(tr);
+        });
+        table.hidden = false;
+
+        var stats = summarize(result);
+        summaryEl.textContent = '';
+        if (stats) {
+          [
+            ['Total span', formatDurationNs(stats.span)],
+            ['Shortest gap', formatDurationNs(stats.min)],
+            ['Longest gap', formatDurationNs(stats.max)],
+            ['Mean gap', formatDurationNs(stats.mean)]
+          ].forEach(function (item) {
+            var card = document.createElement('div');
+            card.className = 'card';
+            var h3 = document.createElement('h3');
+            h3.textContent = item[0];
+            var p = document.createElement('p');
+            p.textContent = item[1];
+            card.appendChild(h3);
+            card.appendChild(p);
+            summaryEl.appendChild(card);
+          });
+          summaryEl.hidden = false;
+        } else {
+          summaryEl.hidden = true;
+        }
+
+        statusEl.className = 'timeline-status';
+        statusEl.textContent = 'Batch ' + (batch.batchId || '(unnamed)') + ': sorted ' +
+          result.events.length + ' events' +
+          (stats ? ' — ' + stats.subMs + ' sub-millisecond gap(s), ' + stats.ties + ' exact tie(s).' : '.');
+      }
+
+      btn.addEventListener('click', function () {
+        btn.disabled = true;
+        statusEl.className = 'timeline-status';
+        statusEl.textContent = 'Loading order events…';
+        fetch('data/order-events.json', { cache: 'no-store' })
+          .then(function (res) {
+            if (!res.ok) throw new Error('HTTP ' + res.status + ' loading events');
+            return res.json();
+          })
+          .then(function (batch) {
+            var raw = Array.isArray(batch) ? batch : batch.events;
+            if (!Array.isArray(raw)) throw new Error('Batch has no events array');
+            render(Array.isArray(batch) ? {} : batch, sortEvents(raw));
+          })
+          .catch(function (err) {
+            table.hidden = true;
+            summaryEl.hidden = true;
+            statusEl.className = 'timeline-status error';
+            statusEl.textContent = 'Could not load order events: ' + err.message;
+          })
+          .finally(function () {
+            btn.disabled = false;
+          });
+      });
+
+      window.DailyGrindTimeline = {
+        parseTimestampNs: parseTimestampNs,
+        formatTimestampNs: formatTimestampNs,
+        formatDurationNs: formatDurationNs,
+        sortEvents: sortEvents
+      };
+    })();
+  </script>
+
