+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const status = document.getElementById('newsletter-status');
+      // Errors only surface after the user has left the field or tried to submit.
+      let interacted = false;
+
+      function getErrorMessage() {
+        if (input.validity.valueMissing) return 'Please enter your email address.';
+        if (!input.validity.valid) return 'Please enter a valid email address, like name@example.com.';
+        return '';
+      }
+
+      // Single source of truth: the visual message, aria-invalid, and the live region change together.
+      function render() {
+        const message = interacted ? getErrorMessage() : '';
+        if (error.textContent !== message) error.textContent = message;
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+          input.setAttribute('aria-describedby', error.id);
+        } else {
+          input.removeAttribute('aria-invalid');
+          input.removeAttribute('aria-describedby');
+        }
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        if (input.value !== '') interacted = true;
+        render();
+      });
+
+      input.addEventListener('input', function () {
+        status.textContent = '';
+        render();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        interacted = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        status.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        interacted = false;
+        render();
+      });
+    })();
+  </script>
+
