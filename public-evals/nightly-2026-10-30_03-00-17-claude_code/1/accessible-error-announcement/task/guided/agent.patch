   </footer>
 
+  <script>
+    // Keep aria-invalid and the live error text in lockstep with the visual :user-invalid state,
+    // so screen readers announce the error only when it appears and stop as soon as it's fixed.
+    const newsletterForm = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-error');
+
+    const syncEmailError = (isInvalid = emailInput.matches(':user-invalid')) => {
+      if (isInvalid) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+      // Only touch the live region when the state changes to avoid repeat announcements
+      const text = isInvalid ? emailError.dataset.message : '';
+      if (emailError.textContent !== text) emailError.textContent = text;
+    };
+
+    emailInput.addEventListener('blur', () => syncEmailError());
+    emailInput.addEventListener('input', () => syncEmailError());
+
+    // A submit attempt makes :user-invalid match; show our inline message instead of the native bubble
+    emailInput.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      syncEmailError(true);
+      emailInput.focus();
+    });
+
+    newsletterForm.addEventListener('reset', () => syncEmailError(false));
+  </script>
+
 </body>
 
