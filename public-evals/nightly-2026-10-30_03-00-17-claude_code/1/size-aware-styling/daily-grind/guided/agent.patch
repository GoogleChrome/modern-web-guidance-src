+    /* Stacked (default): every region spans the full width in source order */
+    .card > * {
+      grid-column: 1 / -1;
+    }
+
+    .card > img {
+      width: 100%;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 15px;
+    }
+
