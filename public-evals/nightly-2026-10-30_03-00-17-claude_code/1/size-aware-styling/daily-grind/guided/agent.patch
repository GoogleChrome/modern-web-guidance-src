       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .card .btn {
+      justify-self: center;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Side-by-side: only for cards with media, once the card itself is wide */
+    @container (min-width: 26rem) {
+      /* A container can't query itself, so these target the card's children */
+      .card:has(> img) > * {
+        grid-column: 2;
+        text-align: start;
+      }
+
+      .card:has(> img) > img {
+        grid-column: 1;
+        grid-row: 1 / span 3;
+        width: 40cqi;
+        height: 100%;
+        min-height: 140px;
+        aspect-ratio: auto;
+        margin: 0 20px 0 0;
+      }
+
+      .card:has(> img) > h3 {
+        align-self: end;
+        font-size: 1.4rem;
+      }
+
+      .card:has(> img) .btn {
+        justify-self: start;
+        align-self: start;
+      }
+    }
+
