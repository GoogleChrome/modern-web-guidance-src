       color: var(--primary);
     }
 
+    /* Seasonal drink cards: layout responds to the card's own width */
+    .drink-card {
+      container: drink-card / inline-size;
+      padding: 0;
+      overflow: hidden;
+    }
+
+    .drink-card-inner {
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+    }
+
+    .drink-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 16 / 10;
+      object-fit: cover;
+    }
+
+    .drink-card-body {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 20px;
+    }
+
+    .drink-card-body p {
+      flex: 1;
+    }
+
+    @container drink-card (min-width: 480px) {
+      .drink-card-inner {
+        flex-direction: row;
+      }
+
+      .drink-card img {
+        flex: 0 0 40%;
+        width: 40%;
+        aspect-ratio: 4 / 3;
+        align-self: stretch;
+      }
+
+      .drink-card-body {
+        align-items: flex-start;
+        justify-content: center;
+        text-align: left;
+        padding: 24px 28px;
+      }
+
+      .drink-card-body h3 {
+        font-size: 1.4rem;
+      }
+
+      .drink-card-body p {
+        flex: 0 1 auto;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
