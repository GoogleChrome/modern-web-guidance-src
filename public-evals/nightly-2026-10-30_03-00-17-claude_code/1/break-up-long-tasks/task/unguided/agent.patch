+  <script>
+    (() => {
+      const ORIGINS = [
+        { name: 'Ethiopia Yirgacheffe', acidity: 0.9, body: 0.35, sweetness: 0.7, bitterness: 0.2, aroma: 0.95 },
+        { name: 'Colombia Huila', acidity: 0.65, body: 0.6, sweetness: 0.75, bitterness: 0.35, aroma: 0.7 },
+        { name: 'Brazil Cerrado', acidity: 0.3, body: 0.8, sweetness: 0.8, bitterness: 0.45, aroma: 0.5 },
+        { name: 'Sumatra Mandheling', acidity: 0.2, body: 0.95, sweetness: 0.45, bitterness: 0.65, aroma: 0.6 },
+        { name: 'Kenya AA', acidity: 0.95, body: 0.55, sweetness: 0.6, bitterness: 0.3, aroma: 0.85 },
+        { name: 'Guatemala Antigua', acidity: 0.6, body: 0.7, sweetness: 0.65, bitterness: 0.4, aroma: 0.75 },
+        { name: 'Costa Rica Tarrazú', acidity: 0.8, body: 0.5, sweetness: 0.7, bitterness: 0.25, aroma: 0.7 }
+      ];
+      const ROASTS = [
+        { name: 'Light', level: 0.2 },
+        { name: 'Medium', level: 0.5 },
+        { name: 'Medium-Dark', level: 0.7 },
+        { name: 'Dark', level: 0.9 }
+      ];
+      const METHODS = {
+        espresso: { name: 'Espresso', temp: 93, time: 28, ratio: 2, pressure: 1.0 },
+        pourover: { name: 'Pour Over', temp: 94, time: 210, ratio: 16, pressure: 0.1 },
+        frenchpress: { name: 'French Press', temp: 95, time: 240, ratio: 15, pressure: 0.05 },
+        coldbrew: { name: 'Cold Brew', temp: 4, time: 64800, ratio: 8, pressure: 0 }
+      };
+      const ATTRIBUTES = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+      const NOTES = [
+        { name: 'Citrus & Berry', test: p => p.acidity > 0.6 && p.aroma > 0.6 },
+        { name: 'Chocolate & Nut', test: p => p.body > 0.6 && p.sweetness > 0.55 },
+        { name: 'Caramel & Toffee', test: p => p.sweetness > 0.65 },
+        { name: 'Smoky & Earthy', test: p => p.bitterness > 0.55 },
+        { name: 'Floral & Tea-like', test: p => p.aroma > 0.7 && p.body < 0.5 }
+      ];
+      const EXTRACTION_STEPS = 60;
+      const FRAME_BUDGET_MS = 8;
+
+      // Small deterministic PRNG so a given seed always yields the same batch.
+      function mulberry32(seed) {
+        let a = seed >>> 0;
+        return () => {
+          a = (a + 0x6D2B79F5) >>> 0;
+          let t = a;
+          t = Math.imul(t ^ (t >>> 15), t | 1);
+          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      function yieldToMain() {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') {
+          return scheduler.yield();
+        }
+        return new Promise(resolve => {
+          const channel = new MessageChannel();
+          channel.port1.onmessage = () => {
+            channel.port1.close();
+            resolve();
+          };
+          channel.port2.postMessage(null);
+        });
+      }
+
+      function createBlend(rand, methodKey) {
+        const count = 1 + Math.floor(rand() * 3);
+        const components = [];
+        let total = 0;
+        for (let i = 0; i < count; i++) {
+          const weight = 0.2 + rand();
+          components.push({ origin: ORIGINS[Math.floor(rand() * ORIGINS.length)], weight });
+          total += weight;
+        }
+        components.forEach(c => { c.weight /= total; });
+        const keys = Object.keys(METHODS);
+        return {
+          components,
+          roast: ROASTS[Math.floor(rand() * ROASTS.length)],
+          method: METHODS[methodKey === 'any' ? keys[Math.floor(rand() * keys.length)] : methodKey],
+          grind: 0.2 + rand() * 0.8
+        };
+      }
+
+      // Simulates extraction over time: acids dissolve first, sugars next, bitter compounds last.
+      function simulateBlend(blend) {
+        const base = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+        for (const { origin, weight } of blend.components) {
+          for (const attr of ATTRIBUTES) base[attr] += origin[attr] * weight;
+        }
+
+        const roast = blend.roast.level;
+        const { temp, time, ratio, pressure } = blend.method;
+        const heat = Math.max(0.15, temp / 95);
+        const strength = Math.min(1.4, 6 / Math.sqrt(ratio));
+        const dt = Math.log10(time + 1) / EXTRACTION_STEPS;
+
+        let acids = 0, sugars = 0, bitters = 0, oils = 0;
+        for (let step = 0; step < EXTRACTION_STEPS; step++) {
+          const rate = heat * (0.5 + blend.grind) * (1 + pressure) * dt;
+          acids += (1 - acids) * rate * 2.2;
+          sugars += (1 - sugars) * rate * 1.3 * (acids > 0.3 ? 1 : 0.5);
+          bitters += (1 - bitters) * rate * 0.6 * (sugars > 0.4 ? 1.5 : 0.4);
+          oils += (1 - oils) * rate * (0.4 + pressure);
+        }
+
+        const clamp = v => Math.max(0, Math.min(1, v));
+        const profile = {
+          acidity: clamp(base.acidity * (1.2 - roast) * (0.4 + acids * 0.8) * strength),
+          body: clamp(base.body * (0.6 + roast * 0.5) * (0.5 + oils * 0.7) * strength),
+          sweetness: clamp(base.sweetness * (1 - Math.abs(roast - 0.5)) * (0.5 + sugars * 0.8) * strength),
+          bitterness: clamp(base.bitterness * (0.5 + roast) * (0.3 + bitters * 1.2) * strength),
+          aroma: clamp(base.aroma * (1.1 - roast * 0.5) * heat * (0.6 + acids * 0.4))
+        };
+
+        // Balance rewards high sweetness/aroma and penalizes uneven profiles.
+        const values = ATTRIBUTES.map(a => profile[a]);
+        const mean = values.reduce((s, v) => s + v, 0) / values.length;
+        const variance = values.reduce((s, v) => s + (v - mean) ** 2, 0) / values.length;
+        const balance = (mean + profile.sweetness * 0.5 + profile.aroma * 0.3 - profile.bitterness * 0.4 - Math.sqrt(variance)) * 100;
+
+        return { profile, balance };
+      }
+
+      function insertTop(top, entry, limit) {
+        if (top.length === limit && entry.balance <= top[top.length - 1].balance) return;
+        let i = top.length;
+        while (i > 0 && top[i - 1].balance < entry.balance) i--;
+        top.splice(i, 0, entry);
+        if (top.length > limit) top.pop();
+      }
+
+      async function runSimulation({ size, methodKey, seed, signal, onProgress }) {
+        const rand = mulberry32(seed);
+        const totals = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+        const noteCounts = Object.fromEntries(NOTES.map(n => [n.name, 0]));
+        const top = [];
+        let processed = 0;
+
+        while (processed < size) {
+          if (signal.aborted) return null;
+
+          const sliceStart = performance.now();
+          // Process blends until this slice's time budget is spent, then yield.
+          do {
+            const blend = createBlend(rand, methodKey);
+            const { profile, balance } = simulateBlend(blend);
+            for (const attr of ATTRIBUTES) totals[attr] += profile[attr];
+            for (const note of NOTES) if (note.test(profile)) noteCounts[note.name]++;
+            insertTop(top, { blend, profile, balance, id: processed + 1 }, 5);
+            processed++;
+          } while (processed < size && performance.now() - sliceStart < FRAME_BUDGET_MS);
+
+          onProgress(processed, size);
+          await yieldToMain();
+        }
+
+        const average = {};
+        for (const attr of ATTRIBUTES) average[attr] = totals[attr] / size;
+        return { average, top, noteCounts, size };
+      }
+
+      const form = document.getElementById('sim-form');
+      const runBtn = document.getElementById('sim-run');
+      const cancelBtn = document.getElementById('sim-cancel');
+      const progressEl = document.getElementById('sim-progress');
+      const statusEl = document.getElementById('sim-status');
+      const resultsEl = document.getElementById('sim-results');
+      const profileEl = document.getElementById('sim-profile');
+      const topEl = document.getElementById('sim-top');
+      const notesEl = document.getElementById('sim-notes');
+      const fmt = new Intl.NumberFormat();
+      let controller = null;
+
+      function barRow(label, value, max, display) {
+        const row = document.createElement('div');
+        row.className = 'bar-row';
+        const name = document.createElement('span');
+        name.textContent = label;
+        const track = document.createElement('div');
+        track.className = 'bar-track';
+        const fill = document.createElement('div');
+        fill.className = 'bar-fill';
+        track.appendChild(fill);
+        const val = document.createElement('span');
+        val.className = 'bar-value';
+        val.textContent = display;
+        row.append(name, track, val);
+        requestAnimationFrame(() => { fill.style.width = `${max ? (value / max) * 100 : 0}%`; });
+        return row;
+      }
+
+      function renderResults({ average, top, noteCounts, size }) {
+        profileEl.replaceChildren(...ATTRIBUTES.map(attr =>
+          barRow(attr[0].toUpperCase() + attr.slice(1), average[attr], 1, (average[attr] * 10).toFixed(1))
+        ));
+
+        topEl.replaceChildren(...top.map(({ blend, balance, id }) => {
+          const li = document.createElement('li');
+          const title = document.createElement('strong');
+          title.textContent = `Blend #${fmt.format(id)} — score ${balance.toFixed(1)}`;
+          const meta = document.createElement('span');
+          meta.className = 'meta';
+          const mix = blend.components
+            .map(c => `${Math.round(c.weight * 100)}% ${c.origin.name}`)
+            .join(', ');
+          meta.textContent = `${mix} · ${blend.roast.name} roast · ${blend.method.name}`;
+          li.append(title, meta);
+          return li;
+        }));
+
+        const maxNote = Math.max(...Object.values(noteCounts));
+        notesEl.replaceChildren(...Object.entries(noteCounts)
+          .sort((a, b) => b[1] - a[1])
+          .map(([name, count]) => barRow(name, count, maxNote, `${Math.round((count / size) * 100)}%`)));
+
+        resultsEl.hidden = false;
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (controller) return;
+
+        const size = parseInt(document.getElementById('sim-size').value, 10);
+        const methodKey = document.getElementById('sim-method').value;
+        const seed = Math.max(1, parseInt(document.getElementById('sim-seed').value, 10) || 1);
+
+        controller = new AbortController();
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        progressEl.value = 0;
+        statusEl.textContent = `Brewing ${fmt.format(size)} blends…`;
+        const started = performance.now();
+
+        try {
+          const result = await runSimulation({
+            size,
+            methodKey,
+            seed,
+            signal: controller.signal,
+            onProgress: (done, total) => {
+              progressEl.value = (done / total) * 100;
+              statusEl.textContent = `Simulated ${fmt.format(done)} of ${fmt.format(total)} blends…`;
+            }
+          });
+
+          if (result) {
+            const seconds = ((performance.now() - started) / 1000).toFixed(2);
+            statusEl.textContent = `Done! Simulated ${fmt.format(size)} blends in ${seconds}s.`;
+            renderResults(result);
+          } else {
+            statusEl.textContent = 'Simulation cancelled.';
+          }
+        } finally {
+          controller = null;
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        if (controller) controller.abort();
+      });
+    })();
+  </script>
