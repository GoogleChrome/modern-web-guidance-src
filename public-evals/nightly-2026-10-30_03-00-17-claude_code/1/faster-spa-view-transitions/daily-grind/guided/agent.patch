+  <script>
+    const routes = {
+      '/': 'home',
+      '/menu': 'menu',
+      '/locations': 'locations',
+      '/rewards': 'rewards',
+      '/account': 'account',
+    };
+
+    const app = document.getElementById('app');
+    // Rendered views stay in the DOM once visited; the set is small and fixed, so no eviction is needed.
+    const views = new Map();
+    const scrollPositions = new Map();
+    let activeName = null;
+
+    function setUpView(name, view) {
+      if (name === 'menu') {
+        const buttons = view.querySelectorAll('[data-filter]');
+        view.querySelector('.filters').addEventListener('click', (event) => {
+          const button = event.target.closest('[data-filter]');
+          if (!button) return;
+          const filter = button.dataset.filter;
+          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
+          view.querySelectorAll('[data-kind]').forEach((card) => {
+            card.hidden = filter !== 'all' && card.dataset.kind !== filter;
+          });
+        });
+      } else if (name === 'account') {
+        const form = view.querySelector('form');
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          form.querySelector('.form-status').textContent = 'Changes saved.';
+        });
+      }
+    }
+
+    function getView(name) {
+      let view = views.get(name);
+      if (!view) {
+        const template = document.getElementById(`view-${name}`);
+        view = document.createElement('div');
+        view.className = 'spa-view inactive';
+        view.tabIndex = -1;
+        view.dataset.title = template.dataset.title;
+        view.inert = true;
+        view.append(template.content.cloneNode(true));
+        setUpView(name, view);
+        app.append(view);
+        views.set(name, view);
+      }
+      return view;
+    }
+
+    function render() {
+      const path = location.hash.replace(/^#/, '') || '/';
+      const name = routes[path] ?? 'home';
+      if (name === activeName) return;
+
+      const isInitial = activeName === null;
+      if (!isInitial) {
+        scrollPositions.set(activeName, scrollY);
+        const previous = views.get(activeName);
+        previous.classList.add('inactive');
+        previous.inert = true;
+      }
+
+      const view = getView(name);
+      view.classList.remove('inactive');
+      view.inert = false;
+      activeName = name;
+      document.title = view.dataset.title;
+
+      document.querySelectorAll('nav a[href^="#/"]').forEach((link) => {
+        if (link.getAttribute('href') === `#${path}` && link.closest('ul')) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      if (!isInitial) {
+        view.focus({ preventScroll: true });
+        scrollTo(0, scrollPositions.get(name) ?? 0);
+      }
+    }
+
+    addEventListener('hashchange', render);
+    render();
+  </script>
