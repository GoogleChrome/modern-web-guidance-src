+  <script>
+    (function () {
+      const app = document.getElementById('app');
+      const titles = {
+        home: 'The Daily Grind | Artisanal Coffee',
+        menu: 'Menu | The Daily Grind',
+        locations: 'Locations | The Daily Grind',
+        rewards: 'Rewards | The Daily Grind',
+        account: 'My Account | The Daily Grind'
+      };
+
+      // One-time setup per view, run when the view is first mounted.
+      // State created here lives as long as the view's DOM, which is never torn down.
+      const setup = {
+        menu(el) {
+          const tabs = el.querySelectorAll('.tab');
+          const cards = el.querySelectorAll('.card');
+          el.querySelector('.tabs').addEventListener('click', (e) => {
+            const tab = e.target.closest('.tab');
+            if (!tab) return;
+            tabs.forEach((t) => t.classList.toggle('active', t === tab));
+            const f = tab.dataset.filter;
+            cards.forEach((c) => { c.hidden = f !== 'all' && c.dataset.cat !== f; });
+          });
+        },
+
+        locations(el) {
+          const cards = [...el.querySelectorAll('.card')];
+          const empty = el.querySelector('.empty');
+          el.querySelector('.search').addEventListener('input', (e) => {
+            const q = e.target.value.trim().toLowerCase();
+            let shown = 0;
+            cards.forEach((c) => {
+              const match = c.textContent.toLowerCase().includes(q);
+              c.hidden = !match;
+              shown += match;
+            });
+            empty.hidden = shown > 0;
+          });
+        },
+
+        rewards(el) {
+          let points = 340;
+          const NEXT_TIER = 500;
+          const pointsEl = el.querySelector('[data-points]');
+          const progress = el.querySelector('[data-progress]');
+          const next = el.querySelector('[data-next]');
+          const buttons = el.querySelectorAll('[data-cost]');
+          const render = () => {
+            pointsEl.textContent = points;
+            progress.style.width = Math.min(100, (points / NEXT_TIER) * 100) + '%';
+            next.textContent = points >= NEXT_TIER
+              ? 'You can redeem any reward!'
+              : `${NEXT_TIER - points} beans until a free bag of beans.`;
+            buttons.forEach((b) => { b.disabled = points < +b.dataset.cost; });
+          };
+          el.addEventListener('click', (e) => {
+            const b = e.target.closest('[data-cost]');
+            if (!b || b.disabled) return;
+            points -= +b.dataset.cost;
+            b.textContent = 'Redeemed!';
+            setTimeout(() => { b.textContent = b.dataset.cost + ' beans'; }, 1500);
+            render();
+          });
+          render();
+        },
+
+        account(el) {
+          const form = el.querySelector('form');
+          const status = el.querySelector('[data-status]');
+          form.addEventListener('submit', (e) => {
+            e.preventDefault();
+            status.textContent = 'Saved ✓';
+          });
+          form.addEventListener('input', () => { status.textContent = ''; });
+        }
+      };
+
+      // Mounted views, keyed by name. Views are created lazily and then kept
+      // in the DOM (just deactivated) so revisits skip parsing, setup and
+      // image loading, and keep user state like filters, form input and scroll.
+      const views = { home: app.querySelector('[data-view="home"]') };
+      const scrollPos = {};
+      let current = 'home';
+
+      function mount(name) {
+        const tpl = document.getElementById('view-' + name);
+        if (!tpl) return null;
+        const el = document.createElement('div');
+        el.className = 'view';
+        el.dataset.view = name;
+        el.appendChild(tpl.content.cloneNode(true));
+        app.appendChild(el);
+        setup[name]?.(el);
+        return el;
+      }
+
+      function parse() {
+        const [name, sub] = location.hash.replace(/^#\/?/, '').split('/');
+        return { name: name || 'home', sub };
+      }
+
+      function show() {
+        let { name, sub } = parse();
+        if (!views[name]) {
+          const el = mount(name);
+          if (el) views[name] = el;
+          else name = 'home';
+        }
+
+        if (name !== current) {
+          scrollPos[current] = window.scrollY;
+          const prev = views[current];
+          prev.classList.remove('active');
+          prev.inert = true;
+          const next = views[name];
+          next.inert = false;
+          next.classList.add('active');
+          current = name;
+        }
+
+        document.title = titles[name];
+        document.querySelectorAll('nav a[href^="#/"]').forEach((a) => {
+          const target = a.getAttribute('href').slice(2) || 'home';
+          if (target === name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        // Deep link to a menu item, e.g. #/menu/cold-brew
+        const item = sub && views[name].querySelector('#' + CSS.escape(sub));
+        if (item) {
+          views[name].querySelectorAll('.card.highlight').forEach((c) => c.classList.remove('highlight'));
+          item.hidden = false;
+          item.classList.add('highlight');
+          item.scrollIntoView({ block: 'center' });
+        } else {
+          window.scrollTo(0, scrollPos[name] || 0);
+        }
+      }
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+      window.addEventListener('hashchange', show);
+      show();
+    })();
+  </script>
+
