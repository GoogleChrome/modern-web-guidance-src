+}
+/* Cached SPA views: keep inactive views in the DOM but skip their layout and
+   paint, so returning to them reuses the retained rendering state. */
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view[data-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view[data-inactive] {
+    display: none;
+  }
+}
