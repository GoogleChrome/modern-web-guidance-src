index 0000000..164ced1
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,145 @@
+/**
+ * View cache for the ClientRouter.
+ *
+ * By default every ClientRouter navigation fetches and parses the target page,
+ * replaces <body> and unmounts all islands of the previous page. This module
+ * keeps the live <body> of recently left pages around instead. When the user
+ * navigates back (or forward) to one of them, the preserved DOM tree — with its
+ * still-mounted framework islands — is swapped back in without any network
+ * request, HTML parsing or re-hydration.
+ */
+import {
+  swapFunctions,
+  type TransitionBeforePreparationEvent,
+  type TransitionBeforeSwapEvent,
+} from "astro:transitions/client";
+
+/** Maximum number of views kept in memory. */
+const MAX_ENTRIES = 8;
+/**
+ * Navigation types that may be served from the cache. Only history traversals
+ * (back/forward) are restored, so following a link always shows fresh content.
+ */
+const CACHEABLE_NAVIGATION_TYPES = new Set(["traverse"]);
+/** Attributes the router manages on <html> itself; never restore them. */
+const ROUTER_ROOT_ATTRS = new Set([
+  "data-astro-transition",
+  "data-astro-transition-fallback",
+]);
+
+interface CachedView {
+  body: HTMLElement;
+  head: Element[];
+  rootAttributes: [string, string][];
+}
+
+const cache = new Map<string, CachedView>();
+// Documents handed to the router by our loader, mapped to the view they restore.
+const restoreDocuments = new WeakMap<Document, CachedView>();
+
+const keyFor = (url: URL) => url.pathname + url.search;
+
+// Islands dispatch `astro:unmount` on themselves once they have been removed
+// from the document. Stopping it on the cached body keeps their framework roots
+// (and component state) alive while the view is detached.
+const keepIslandsMounted = (event: Event) => event.stopImmediatePropagation();
+
+function snapshot(): CachedView {
+  const body = document.body;
+  body.querySelectorAll(".astro-route-announcer").forEach((el) => el.remove());
+  body.addEventListener("astro:unmount", keepIslandsMounted, { capture: true });
+
+  const head = Array.from(document.head.children, (el) => {
+    const clone = el.cloneNode(true) as Element;
+    // Everything in the current head has already run on this view.
+    if (clone instanceof HTMLScriptElement) clone.dataset.astroExec = "";
+    return clone;
+  });
+  const rootAttributes = Array.from(
+    document.documentElement.attributes,
+    ({ name, value }): [string, string] => [name, value],
+  ).filter(([name]) => !ROUTER_ROOT_ATTRS.has(name));
+
+  return { body, head, rootAttributes };
+}
+
+function store(key: string, view: CachedView) {
+  cache.delete(key);
+  cache.set(key, view);
+  while (cache.size > MAX_ENTRIES) {
+    const [oldestKey, oldest] = cache.entries().next().value!;
+    cache.delete(oldestKey);
+    evict(oldest);
+  }
+}
+
+function evict(view: CachedView) {
+  view.body.removeEventListener("astro:unmount", keepIslandsMounted, {
+    capture: true,
+  });
+  view.body
+    .querySelectorAll("astro-island")
+    .forEach((island) => island.dispatchEvent(new CustomEvent("astro:unmount")));
+}
+
+// Build a lightweight document carrying the cached head and <html> attributes.
+// The body is swapped in separately so the live nodes are never adopted into
+// another document.
+function toDocument(view: CachedView): Document {
+  const doc = document.implementation.createHTMLDocument();
+  for (const [name, value] of view.rootAttributes) {
+    doc.documentElement.setAttribute(name, value);
+  }
+  doc.head.replaceChildren(...view.head.map((el) => el.cloneNode(true)));
+  return doc;
+}
+
+function isCacheable(body: HTMLElement) {
+  // Persisted elements move to the next page; the view would be incomplete.
+  return !body.querySelector("[data-astro-transition-persist]");
+}
+
+document.addEventListener("astro:before-preparation", (event) => {
+  const prep = event as TransitionBeforePreparationEvent;
+  if (prep.formData || !CACHEABLE_NAVIGATION_TYPES.has(prep.navigationType)) {
+    return;
+  }
+  const view = cache.get(keyFor(prep.to));
+  if (!view) return;
+
+  prep.loader = async () => {
+    const doc = toDocument(view);
+    restoreDocuments.set(doc, view);
+    prep.newDocument = doc;
+  };
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const swap = event as TransitionBeforeSwapEvent;
+  const fromKey = keyFor(swap.from);
+  const view = restoreDocuments.get(swap.newDocument);
+
+  if (view) {
+    cache.delete(keyFor(swap.to));
+    view.body.removeEventListener("astro:unmount", keepIslandsMounted, {
+      capture: true,
+    });
+    swap.swap = () => {
+      const doc = swap.newDocument;
+      swapFunctions.deselectScripts(doc);
+      swapFunctions.swapRootAttributes(doc);
+      swapFunctions.swapHeadElements(doc);
+      // The cached body holds no persisted elements and its media elements are
+      // already live, so a plain replacement is all the body swap needs.
+      document.body.replaceWith(view.body);
+    };
+  }
+
+  if (isCacheable(document.body)) {
+    store(fromKey, snapshot());
+  } else {
+    const stale = cache.get(fromKey);
+    cache.delete(fromKey);
+    if (stale) evict(stale);
+  }
+});
