diff --git a/src/hooks/useResetOnNavigation.ts b/src/hooks/useResetOnNavigation.ts
new file mode 100644
index 0000000..5c608ab
--- /dev/null
+++ b/src/hooks/useResetOnNavigation.ts
@@ -0,0 +1,17 @@
+import { useEffect, useRef } from 'react';
+
+/**
+ * Runs `reset` whenever the ClientRouter swaps the page. Views can be kept
+ * alive in the view cache and restored later, so transient UI such as open
+ * flyouts must be closed when the user navigates away.
+ */
+export function useResetOnNavigation(reset: () => void) {
+  const resetRef = useRef(reset);
+  resetRef.current = reset;
+
+  useEffect(() => {
+    const onSwap = () => resetRef.current();
+    document.addEventListener('astro:after-swap', onSwap);
+    return () => document.removeEventListener('astro:after-swap', onSwap);
+  }, []);
+}
