+  <script>
+    // Size each lockup line's text so its width matches the heading's width.
+    (function () {
+      const lockup = document.querySelector('.lockup');
+      if (!lockup) return;
+      const lines = lockup.querySelectorAll('.line');
+      const REF = 100;
+
+      function fit() {
+        const target = lockup.clientWidth;
+        lines.forEach(function (line) {
+          line.style.fontSize = REF + 'px';
+          const natural = line.getBoundingClientRect().width;
+          if (natural > 0) line.style.fontSize = (REF * target / natural) + 'px';
+        });
+      }
+
+      fit();
+      if (document.fonts) document.fonts.ready.then(fit);
+      new ResizeObserver(fit).observe(lockup);
+    })();
+  </script>
