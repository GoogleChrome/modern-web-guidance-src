diff --git a/src/components/PrivacyConsent.tsx b/src/components/PrivacyConsent.tsx
new file mode 100644
index 0000000..19eb51d
--- /dev/null
+++ b/src/components/PrivacyConsent.tsx
@@ -0,0 +1,145 @@
+import React, { useEffect, useState } from 'react';
+
+const ANALYTICS_SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+const STORAGE_KEY = 'dt-privacy-consent';
+// Bump when the set of optional purposes changes so visitors are asked again.
+const CONSENT_VERSION = 1;
+
+type Consent = { version: number; analytics: boolean; updatedAt: string };
+
+function readConsent(): Consent | null {
+  try {
+    const consent = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+    return consent?.version === CONSENT_VERSION ? consent : null;
+  } catch {
+    return null;
+  }
+}
+
+function hasGlobalPrivacyControl() {
+  return (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
+}
+
+function loadAnalytics() {
+  if (window.__dtAnalyticsLoaded) return;
+  window.__dtAnalyticsLoaded = true;
+  const script = document.createElement('script');
+  script.src = ANALYTICS_SRC;
+  script.defer = true;
+  document.body.appendChild(script);
+}
+
+export default function PrivacyConsent() {
+  const [open, setOpen] = useState(false);
+  const [analytics, setAnalytics] = useState(false);
+  const [gpc, setGpc] = useState(false);
+
+  useEffect(() => {
+    const consent = readConsent();
+    const gpcEnabled = hasGlobalPrivacyControl();
+    setGpc(gpcEnabled);
+
+    if (consent) {
+      setAnalytics(consent.analytics);
+      if (consent.analytics) loadAnalytics();
+    } else if (!gpcEnabled) {
+      // A Global Privacy Control signal counts as a refusal, so only ask visitors without one.
+      setOpen(true);
+    }
+
+    const openPreferences = (event: MouseEvent) => {
+      if (!(event.target as Element).closest?.('[data-privacy-preferences]')) return;
+      event.preventDefault();
+      setAnalytics(readConsent()?.analytics ?? false);
+      setOpen(true);
+    };
+    document.addEventListener('click', openPreferences);
+    return () => document.removeEventListener('click', openPreferences);
+  }, []);
+
+  const save = (allowAnalytics: boolean) => {
+    const wasLoaded = window.__dtAnalyticsLoaded;
+    const consent: Consent = { version: CONSENT_VERSION, analytics: allowAnalytics, updatedAt: new Date().toISOString() };
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
+    setAnalytics(allowAnalytics);
+    setOpen(false);
+
+    if (allowAnalytics) {
+      loadAnalytics();
+    } else if (wasLoaded) {
+      // A loaded script can't be unloaded, so reload to stop it immediately.
+      window.location.reload();
+    }
+  };
+
+  if (!open) return null;
+
+  return (
+    <div
+      role="dialog"
+      aria-modal="false"
+      aria-labelledby="privacy-consent-title"
+      className="fixed inset-x-0 bottom-0 z-[100] p-4"
+    >
+      <div className="max-w-3xl mx-auto bg-white border border-gray-300 rounded-lg shadow-lg p-5 text-sm text-gray-700">
+        <h2 id="privacy-consent-title" className="text-base font-bold text-gray-900 mb-2">
+          Your privacy choices
+        </h2>
+        <p className="mb-3">
+          We only use what's needed to run the site: a session cookie that keeps your reading list, and a
+          saved record of the choice you make here. With your permission we'd also like to use{' '}
+          <strong>optional analytics</strong>. When you click a link or button, the analytics records the
+          element type, its visible text and the time, and sends them to our analytics service. It doesn't
+          collect anything you type into forms, and it never runs on the sign-in and sign-up buttons.
+        </p>
+        {gpc && (
+          <p className="mb-3 text-gray-600">
+            Your browser is sending a Global Privacy Control signal, so analytics is off unless you turn it on here.
+          </p>
+        )}
+        <label className="flex items-start gap-2 mb-4">
+          <input
+            type="checkbox"
+            checked={analytics}
+            onChange={(e) => setAnalytics(e.target.checked)}
+            className="mt-1"
+          />
+          <span>Allow optional analytics</span>
+        </label>
+        <div className="flex flex-wrap items-center gap-2">
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => save(false)}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+          >
+            Reject optional
+          </button>
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => save(true)}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+          >
+            Accept all
+          </button>
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => save(analytics)}
+            className="py-2 px-4 rounded-md text-sm font-medium text-gray-900 border border-gray-300 hover:bg-gray-100"
+          >
+            Save choices
+          </button>
+          <a
+            href={`${import.meta.env.BASE_URL}legal/privacy`}
+            data-skip-tracking="true"
+            className="ml-auto text-gray-600 underline hover:text-gray-900"
+          >
+            Privacy Policy
+          </a>
+        </div>
+      </div>
+    </div>
+  );
+}
