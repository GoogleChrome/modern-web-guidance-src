 import { defineMiddleware } from 'astro:middleware';
 
+// Privacy-preserving defaults applied to every response.
+const PRIVACY_HEADERS: Record<string, string> = {
+  // Never leak full article paths or query strings to other origins.
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  // The site uses none of these features; deny them for us and any embedded third party.
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'ambient-light-sensor=()',
+    'autoplay=()',
+    'bluetooth=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'hid=()',
+    'idle-detection=()',
+    'magnetometer=()',
+    'microphone=()',
+    'midi=()',
+    'payment=()',
+    'serial=()',
+    'usb=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+};
+
+// Pages that handle credentials must not be stored in shared or browser caches.
+const SENSITIVE_PATHS = ['/signin', '/signup'];
+
 export const onRequest = defineMiddleware(async (context, next) => {
   if (context.session) {
     // Initialize the reading list if it doesn't exist
@@ -9,5 +39,19 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+
+  const response = await next();
+
+  for (const [name, value] of Object.entries(PRIVACY_HEADERS)) {
+    if (!response.headers.has(name)) {
+      response.headers.set(name, value);
+    }
+  }
+
+  const path = context.url.pathname.replace(/\/$/, '');
+  if (SENSITIVE_PATHS.some((p) => path.endsWith(p))) {
+    response.headers.set('Cache-Control', 'no-store');
+  }
+
+  return response;
 });
