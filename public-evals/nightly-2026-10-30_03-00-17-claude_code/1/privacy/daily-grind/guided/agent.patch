@@ -0,0 +1,26 @@
+# Security and privacy response headers (Netlify / Cloudflare Pages format).
+# Port these to whatever server or CDN fronts the site; index.html carries a
+# <meta> fallback for the CSP and referrer policy only.
+
+/*
+  Content-Security-Policy: default-src 'none'; script-src 'self' 'report-sample'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), focus-without-user-activation=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: DENY
+  Cross-Origin-Opener-Policy: same-origin
+  Cross-Origin-Resource-Policy: same-origin
+  # Start lower (e.g. max-age=300) on first rollout, then raise to a year.
+  Strict-Transport-Security: max-age=31536000; includeSubDomains
+
+# Wipe cookies, storage, and cached pages when a user signs out so nothing
+# from their session lingers on a shared device.
+/logout
+  Clear-Site-Data: "cache", "cookies", "storage"
+  Cache-Control: no-store
+
+/account*
+  Cache-Control: no-store
+
+/.well-known/gpc.json
+  Content-Type: application/json
