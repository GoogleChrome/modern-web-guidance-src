diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..4b295ab
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,12 @@
+// Strips ad/campaign click identifiers from the address bar so they don't end up
+// in browser history, bookmarks, or links visitors share. Nothing is read from
+// or written to storage, and nothing is sent anywhere.
+const TRACKING_PARAM = /^(utm_\w+|fbclid|gclid|gbraid|wbraid|dclid|msclkid|yclid|ttclid|twclid|igshid|mc_cid|mc_eid|_hsenc|_hsmi|li_fat_id)$/i;
+
+const url = new URL(location.href);
+const tracked = [...url.searchParams.keys()].filter((key) => TRACKING_PARAM.test(key));
+
+if (tracked.length > 0) {
+  for (const key of tracked) url.searchParams.delete(key);
+  history.replaceState(history.state, '', url);
+}
