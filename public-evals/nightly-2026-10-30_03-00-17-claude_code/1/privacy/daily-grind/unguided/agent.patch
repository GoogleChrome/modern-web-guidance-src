@@ -0,0 +1,61 @@
+// Client-side privacy safeguards. Collects nothing and makes no network requests.
+(function () {
+  'use strict';
+
+  // Campaign/click identifiers that link a visit to an ad profile. Strip them from the
+  // address bar so they don't end up in bookmarks, shared links, or the Referer of later requests.
+  var TRACKING_PARAMS = /^(utm_\w+|gclid|gbraid|wbraid|dclid|fbclid|msclkid|ttclid|twclid|li_fat_id|igshid|mc_cid|mc_eid|_hsenc|_hsmi|mkt_tok|yclid|oly_\w+|vero_\w+)$/i;
+
+  function stripTrackingParams() {
+    if (!window.history || !window.URL) return;
+    var url = new URL(window.location.href);
+    var keys = [];
+    url.searchParams.forEach(function (_, key) {
+      if (TRACKING_PARAMS.test(key)) keys.push(key);
+    });
+    if (!keys.length) return;
+    keys.forEach(function (key) { url.searchParams.delete(key); });
+    window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
+  }
+
+  function showGpcStatus() {
+    var status = document.getElementById('gpc-status');
+    if (status && navigator.globalPrivacyControl === true) status.hidden = false;
+  }
+
+  // Links leaving the site must not expose the opener window or the page URL.
+  function hardenExternalLinks() {
+    var links = document.querySelectorAll('a[href]');
+    for (var i = 0; i < links.length; i++) {
+      var link = links[i];
+      if (link.origin === window.location.origin) continue;
+      var rel = (link.getAttribute('rel') || '').split(/\s+/);
+      ['noopener', 'noreferrer'].forEach(function (value) {
+        if (rel.indexOf(value) === -1) rel.push(value);
+      });
+      link.setAttribute('rel', rel.join(' ').trim());
+      link.referrerPolicy = 'no-referrer';
+    }
+  }
+
+  // The server also sends Clear-Site-Data on logout; this covers browsers that ignore it.
+  function clearStorageOnLogout() {
+    var forms = document.querySelectorAll('form[action="/logout"]');
+    for (var i = 0; i < forms.length; i++) {
+      forms[i].addEventListener('submit', function () {
+        try {
+          window.sessionStorage.clear();
+          window.localStorage.clear();
+        } catch (e) {
+          // Storage may be disabled by the user; nothing to clear.
+        }
+      });
+    }
+  }
+
+  // Loaded with `defer`, so the document is already parsed.
+  stripTrackingParams();
+  showGpcStatus();
+  hardenExternalLinks();
+  clearStorageOnLogout();
+})();
