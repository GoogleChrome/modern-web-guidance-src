+// Zero-dependency static server for The Daily Grind.
+// Serves only an explicit allowlist of files and attaches privacy/security headers to every response.
+// Deliberately keeps no request logs: no IP addresses, user agents, or query strings are recorded.
+import { createServer } from 'node:http';
+import { readFile, readdir } from 'node:fs/promises';
+import { join, extname, relative, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+// Match statikk's previous default of only listening on localhost; set HOST=0.0.0.0 to expose.
+const HOST = process.env.HOST || 'localhost';
+// HSTS and upgrade-insecure-requests are only meaningful once the site is served over TLS.
+const HTTPS_ONLY = process.env.NODE_ENV === 'production';
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.jpg': 'image/jpeg',
+  '.png': 'image/png',
+  '.svg': 'image/svg+xml',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+};
+
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self'",
+  "connect-src 'none'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+  "base-uri 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+  ...(HTTPS_ONLY ? ['upgrade-insecure-requests'] : []),
+].join('; ');
+
+// Deny every powerful feature and opt out of browser ad-targeting APIs.
+const PERMISSIONS_POLICY = [
+  'accelerometer=()',
+  'ambient-light-sensor=()',
+  'autoplay=()',
+  'bluetooth=()',
+  'browsing-topics=()',
+  'camera=()',
+  'display-capture=()',
+  'geolocation=()',
+  'gyroscope=()',
+  'hid=()',
+  'identity-credentials-get=()',
+  'interest-cohort=()',
+  'magnetometer=()',
+  'microphone=()',
+  'midi=()',
+  'payment=()',
+  'publickey-credentials-get=()',
+  'serial=()',
+  'usb=()',
+  'xr-spatial-tracking=()',
+].join(', ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP,
+  'Permissions-Policy': PERMISSIONS_POLICY,
+  'Referrer-Policy': 'same-origin',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cross-Origin-Embedder-Policy': 'require-corp',
+  'Origin-Agent-Cluster': '?1',
+  'X-DNS-Prefetch-Control': 'off',
+  'X-Permitted-Cross-Domain-Policies': 'none',
+  ...(HTTPS_ONLY ? { 'Strict-Transport-Security': 'max-age=63072000; includeSubDomains' } : {}),
+};
+
+// Pages show signed-in navigation, so never let shared caches or the back/forward cache keep them.
+const HTML_CACHE = 'no-store';
+const ASSET_CACHE = 'public, max-age=86400';
+
+async function listFiles(dir) {
+  const entries = await readdir(dir, { withFileTypes: true });
+  const files = await Promise.all(entries.map((entry) => {
+    const path = join(dir, entry.name);
+    return entry.isDirectory() ? listFiles(path) : [path];
+  }));
+  return files.flat();
+}
+
+// Build the route table once at startup. Requests are looked up by exact path, so traversal
+// tricks, dotfiles, and source files (server.mjs, package.json, .git) can never be served.
+async function buildRoutes() {
+  const routes = new Map();
+  const add = async (urlPath, filePath) => {
+    const type = MIME_TYPES[extname(filePath)];
+    if (!type) return;
+    routes.set(urlPath, { body: await readFile(filePath), type });
+  };
+
+  await add('/', join(ROOT, 'index.html'));
+  await add('/index.html', join(ROOT, 'index.html'));
+  await add('/.well-known/gpc.json', join(ROOT, '.well-known', 'gpc.json'));
+  for (const file of await listFiles(join(ROOT, 'assets'))) {
+    await add('/' + relative(ROOT, file).split(sep).join('/'), file);
+  }
+  return routes;
+}
+
+function send(res, status, headers, body = '') {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+// Reject cross-site form posts. Sec-Fetch-Site is sent by all current browsers; fall back to Origin.
+function isSameOrigin(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (site) return site === 'same-origin';
+  const origin = req.headers.origin;
+  return !origin || origin === `http://${req.headers.host}` || origin === `https://${req.headers.host}`;
+}
+
+function handleLogout(req, res) {
+  // Discard the body unread; logout needs no input.
+  req.resume();
+  if (!isSameOrigin(req)) {
+    send(res, 403, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Forbidden');
+    return;
+  }
+  send(res, 303, {
+    Location: '/',
+    'Cache-Control': 'no-store',
+    // Wipe cookies, storage, and cached pages for this origin so nothing personal outlives the session.
+    'Clear-Site-Data': '"cache", "cookies", "storage"',
+  });
+}
+
+const routes = await buildRoutes();
+
+const server = createServer((req, res) => {
+  // Only the path matters; query strings (often carrying tracking IDs) are ignored, never stored.
+  let pathname;
+  try {
+    ({ pathname } = new URL(req.url, 'http://localhost'));
+  } catch {
+    return send(res, 400, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Bad Request');
+  }
+
+  if (pathname === '/logout') {
+    if (req.method === 'POST') return handleLogout(req, res);
+    return send(res, 405, { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' }, 'Method Not Allowed');
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' }, 'Method Not Allowed');
+  }
+
+  const route = routes.get(pathname);
+  if (!route) {
+    return send(res, 404, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Not Found');
+  }
+
+  const isHtml = route.type.startsWith('text/html');
+  send(res, 200, {
+    'Content-Type': route.type,
+    'Content-Length': route.body.length,
+    'Cache-Control': isHtml ? HTML_CACHE : ASSET_CACHE,
+  }, req.method === 'HEAD' ? undefined : route.body);
+});
+
+server.listen(PORT, HOST, () => {
+  console.log(`The Daily Grind listening on http://${HOST}:${PORT}`);
+});
