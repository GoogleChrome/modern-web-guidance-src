+      // JSON.stringify escapes control characters, preventing log injection.
+      console.warn('CSP violation:', JSON.stringify(report));
+    } catch {
+      // Ignore malformed reports.
+    }
+    res.writeHead(204, securityHeaders());
+    res.end();
+  });
+}
