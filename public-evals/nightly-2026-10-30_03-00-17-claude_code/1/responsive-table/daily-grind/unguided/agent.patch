+    /* Nutrition & Pricing Table */
+    .table-section {
+      margin-top: 40px;
+    }
+
+    .table-wrapper {
+      overflow-x: auto;
+      margin-top: 20px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      min-width: 640px;
+      border-collapse: collapse;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      caption-side: top;
+      text-align: left;
+      padding: 15px 15px 0;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 15px;
+      text-align: right;
+      border-bottom: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    .nutrition-table th[scope="row"] {
+      text-align: left;
+      color: var(--primary);
+    }
+
+    /* Keep the drink name column visible while scrolling horizontally */
+    .nutrition-table th:first-child {
+      position: sticky;
+      left: 0;
+      text-align: left;
+      background: white;
+    }
+
+    .nutrition-table thead th:first-child {
+      background: var(--primary);
+    }
+
+    .nutrition-table tbody tr:nth-child(even) th,
+    .nutrition-table tbody tr:nth-child(even) td {
+      background: #f5f0ee;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .table-note {
+      margin-top: 10px;
+      font-size: 0.85rem;
+    }
+
+    .scroll-hint {
+      display: none;
+    }
+
+    @media (max-width: 600px) {
+      .scroll-hint {
+        display: block;
+      }
+    }
+
