+  <script>
+    (function () {
+      var form = document.querySelector('.order-form');
+      var shop = document.getElementById('local-shop');
+      var error = document.getElementById('local-shop-error');
+
+      function validate() {
+        var valid = shop.checkValidity();
+        if (valid) {
+          shop.removeAttribute('aria-invalid');
+          shop.removeAttribute('aria-describedby');
+          error.textContent = '';
+          error.hidden = true;
+        } else {
+          shop.setAttribute('aria-invalid', 'true');
+          shop.setAttribute('aria-describedby', 'local-shop-error');
+          error.textContent = 'Please select a local shop.';
+          error.hidden = false;
+        }
+        return valid;
+      }
+
+      // Errors stay hidden until the user interacts with the menu or submits.
+      shop.addEventListener('change', validate);
+      shop.addEventListener('blur', validate);
+
+      form.addEventListener('submit', function (event) {
+        if (!validate()) {
+          event.preventDefault();
+          shop.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
