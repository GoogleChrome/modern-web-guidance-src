diff --git a/index.html b/index.html
index 1bacf96..e4f7fa3 100644
--- a/index.html
+++ b/index.html
@@ -12,6 +12,35 @@
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Derived colors. Fallbacks for browsers without relative color support. */
+      --primary-hover: #3e2723;
+      --on-primary: #ffffff;
+      --on-primary-hover: #ffffff;
+      --on-secondary: #000000;
+    }
+
+    /*
+     * Auto-contrast text: pick black or white based on the background's
+     * perceptual lightness (OKLCH L), so text stays readable whenever
+     * --primary or --secondary is changed.
+     */
+    @supports (color: oklch(from red l c h)) {
+      :root {
+        --primary-hover: oklch(from var(--primary) calc(l * 0.8) c h);
+        --on-primary: oklch(from var(--primary) clamp(0, (0.62 - l) * infinity, 1) 0 0);
+        --on-primary-hover: oklch(from var(--primary-hover) clamp(0, (0.62 - l) * infinity, 1) 0 0);
+        --on-secondary: oklch(from var(--secondary) clamp(0, (0.62 - l) * infinity, 1) 0 0);
+      }
+    }
+
+    /* Prefer the native WCAG-based function where available. */
+    @supports (color: contrast-color(red)) {
+      :root {
+        --on-primary: contrast-color(var(--primary));
+        --on-primary-hover: contrast-color(var(--primary-hover));
+        --on-secondary: contrast-color(var(--secondary));
+      }
     }
 
     * {
@@ -30,7 +59,7 @@
     /* Navigation */
     nav {
       background: var(--primary);
-      color: white;
+      color: var(--on-primary);
       padding: 1rem 5%;
       display: flex;
       justify-content: space-between;
@@ -56,14 +85,18 @@
     }
 
