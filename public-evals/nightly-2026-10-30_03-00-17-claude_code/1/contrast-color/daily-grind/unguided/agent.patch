       padding: 10px 20px;
       text-decoration: none;
       border-radius: 5px;
       margin-top: 15px;
-      transition: background 0.3s;
+      transition: background 0.3s, color 0.3s;
     }
 
     .btn:hover {
-      background: #3e2723;
+      background: var(--primary-hover);
+      color: var(--on-primary-hover);
     }
 
     footer {
       background: var(--secondary);
