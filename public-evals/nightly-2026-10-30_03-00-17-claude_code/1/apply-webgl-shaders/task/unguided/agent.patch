+  <script>
+    // Hero ripple effect: the hero (background + text + button) is rasterised into a
+    // texture that mirrors the live DOM layout, then distorted by a fragment shader.
+    // The DOM content stays on top with transparent text, so it remains selectable,
+    // focusable and clickable. Falls back to the plain hero if anything is unavailable.
+    (function () {
+      const hero = document.querySelector('.hero');
+      const canvas = hero && hero.querySelector('.hero-gl');
+      if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      const gl = canvas.getContext('webgl', { alpha: false, antialias: false, premultipliedAlpha: false });
+      if (!gl) return;
+
+      const BG_URL = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+      const MAX_RIPPLES = 12;
+      const RIPPLE_LIFE = 2.4;
+
+      const vertSrc = `
+        attribute vec2 a_pos;
+        varying vec2 v_uv;
+        void main() {
+          v_uv = a_pos * 0.5 + 0.5;
+          gl_Position = vec4(a_pos, 0.0, 1.0);
+        }`;
+
+      const fragSrc = `
+        precision mediump float;
+        #define MAX_RIPPLES ${MAX_RIPPLES}
+        #define LIFE ${RIPPLE_LIFE.toFixed(2)}
+        uniform sampler2D u_tex;
+        uniform vec2 u_res;
+        uniform float u_time;
+        uniform vec4 u_ripples[MAX_RIPPLES]; // xy: uv origin, z: start time, w: strength
+        varying vec2 v_uv;
+
+        void main() {
+          float aspect = u_res.x / u_res.y;
+          vec2 offset = vec2(0.0);
+          float shade = 0.0;
+
+          for (int i = 0; i < MAX_RIPPLES; i++) {
+            vec4 r = u_ripples[i];
+            float age = u_time - r.z;
+            if (r.w <= 0.0 || age < 0.0 || age > LIFE) continue;
+
+            vec2 d = v_uv - r.xy;
+            d.x *= aspect;
+            float dist = length(d);
+            float band = dist - age * 0.35;
+            float fade = 1.0 - age / LIFE;
+            float env = exp(-band * band * 60.0) * fade * fade * r.w;
+            float wave = sin(band * 70.0) * env;
+
+            vec2 dir = dist > 0.0001 ? d / dist : vec2(0.0);
+            dir.x /= aspect;
+            offset += dir * wave * 0.018;
+            shade += wave;
+          }
+
+          // Gentle ambient shimmer, kept to ~1px so text stays aligned with the DOM.
+          offset += vec2(
+            sin(v_uv.y * 14.0 + u_time * 0.9),
+            cos(v_uv.x * 11.0 + u_time * 0.7)
+          ) * (0.8 / u_res);
+
+          vec4 color = texture2D(u_tex, clamp(v_uv + offset, 0.0, 1.0));
+          color.rgb += shade * 0.07;
+          gl_FragColor = vec4(color.rgb, 1.0);
+        }`;
+
+      function compile(type, src) {
+        const sh = gl.createShader(type);
+        gl.shaderSource(sh, src);
+        gl.compileShader(sh);
+        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh));
+        return sh;
+      }
+
+      let program;
+      try {
+        program = gl.createProgram();
+        gl.attachShader(program, compile(gl.VERTEX_SHADER, vertSrc));
+        gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragSrc));
+        gl.linkProgram(program);
+        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program));
+      } catch (err) {
+        console.warn('Hero ripple disabled:', err);
+        return;
+      }
+      gl.useProgram(program);
+
+      const buf = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const aPos = gl.getAttribLocation(program, 'a_pos');
+      gl.enableVertexAttribArray(aPos);
+      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
+
+      const uRes = gl.getUniformLocation(program, 'u_res');
+      const uTime = gl.getUniformLocation(program, 'u_time');
+      const uRipples = gl.getUniformLocation(program, 'u_ripples');
+
+      const tex = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, tex);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
+
+      const ripples = new Float32Array(MAX_RIPPLES * 4);
+      let rippleIndex = 0;
+
+      const source = document.createElement('canvas');
+      const sctx = source.getContext('2d');
+      const textEls = hero.querySelectorAll('h1, p, .btn');
+      const btns = hero.querySelectorAll('.btn');
+      const bgImage = new Image();
+      bgImage.crossOrigin = 'anonymous';
+
+      // Draw every word of an element's text at the exact spot the browser laid it out.
+      function drawText(el, origin) {
+        const cs = getComputedStyle(el);
+        sctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        sctx.fillStyle = '#fff';
+        const metrics = sctx.measureText('Hg');
+        const asc = metrics.fontBoundingBoxAscent;
+        const desc = metrics.fontBoundingBoxDescent;
+        const range = document.createRange();
+        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+          const text = node.textContent;
+          const re = /\S+/g;
+          let m;
+          while ((m = re.exec(text))) {
+            range.setStart(node, m.index);
+            range.setEnd(node, m.index + m[0].length);
+            const r = range.getBoundingClientRect();
+            if (!r.width) continue;
+            const x = r.left - origin.left;
+            let y;
+            if (asc !== undefined) {
+              y = r.top - origin.top + (r.height - (asc + desc)) / 2 + asc;
+              sctx.textBaseline = 'alphabetic';
+            } else {
+              y = r.top - origin.top + r.height / 2;
+              sctx.textBaseline = 'middle';
+            }
+            sctx.fillText(m[0], x, y);
+          }
+        }
+      }
+
+      function drawButton(btn, origin) {
+        const cs = getComputedStyle(btn);
+        const r = btn.getBoundingClientRect();
+        const radius = parseFloat(cs.borderTopLeftRadius) || 0;
+        sctx.fillStyle = cs.getPropertyValue('--btn-bg').trim() || '#4e342e';
+        sctx.beginPath();
+        if (sctx.roundRect) sctx.roundRect(r.left - origin.left, r.top - origin.top, r.width, r.height, radius);
+        else sctx.rect(r.left - origin.left, r.top - origin.top, r.width, r.height);
+        sctx.fill();
+      }
+
+      function snapshot() {
+        const w = hero.clientWidth;
+        const h = hero.clientHeight;
+        if (!w || !h) return;
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const pw = Math.round(w * dpr);
+        const ph = Math.round(h * dpr);
+        if (source.width !== pw || source.height !== ph) {
+          source.width = canvas.width = pw;
+          source.height = canvas.height = ph;
+        }
+        sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+        // background-size: cover; background-position: center
+        const scale = Math.max(w / bgImage.naturalWidth, h / bgImage.naturalHeight);
+        const iw = bgImage.naturalWidth * scale;
+        const ih = bgImage.naturalHeight * scale;
+        sctx.drawImage(bgImage, (w - iw) / 2, (h - ih) / 2, iw, ih);
+        sctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
+        sctx.fillRect(0, 0, w, h);
+
+        const origin = hero.getBoundingClientRect();
+        btns.forEach((b) => drawButton(b, origin));
+        textEls.forEach((el) => drawText(el, origin));
+
+        gl.bindTexture(gl.TEXTURE_2D, tex);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, source);
+        gl.viewport(0, 0, pw, ph);
+        gl.uniform2f(uRes, w, h);
+      }
+
+      let snapshotQueued = false;
+      function queueSnapshot() {
+        if (snapshotQueued) return;
+        snapshotQueued = true;
+        requestAnimationFrame(() => {
+          snapshotQueued = false;
+          snapshot();
+        });
+      }
+
+      const start = performance.now();
+      const now = () => (performance.now() - start) / 1000;
+
+      function addRipple(clientX, clientY, strength) {
+        const r = hero.getBoundingClientRect();
+        const i = rippleIndex * 4;
+        ripples[i] = (clientX - r.left) / r.width;
+        ripples[i + 1] = 1 - (clientY - r.top) / r.height;
+        ripples[i + 2] = now();
+        ripples[i + 3] = strength;
+        rippleIndex = (rippleIndex + 1) % MAX_RIPPLES;
+      }
+
+      let visible = true;
+      let rafId = 0;
+      function frame() {
+        rafId = 0;
+        if (!visible || document.hidden) return;
+        gl.uniform1f(uTime, now());
+        gl.uniform4fv(uRipples, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        rafId = requestAnimationFrame(frame);
+      }
+      function startLoop() {
+        if (!rafId) rafId = requestAnimationFrame(frame);
+      }
+
+      let last = null;
+      hero.addEventListener('pointermove', (e) => {
+        const t = performance.now();
+        if (last) {
+          const dist = Math.hypot(e.clientX - last.x, e.clientY - last.y);
+          if (t - last.t < 70 || dist < 18) return;
+          addRipple(e.clientX, e.clientY, Math.min(0.25 + dist / 220, 0.7));
+        }
+        last = { x: e.clientX, y: e.clientY, t };
+      });
+      hero.addEventListener('pointerleave', () => { last = null; });
+      hero.addEventListener('pointerdown', (e) => addRipple(e.clientX, e.clientY, 1));
+
+      // Re-rasterise when the button's visual state changes.
+      btns.forEach((b) => {
+        ['pointerenter', 'pointerleave', 'focus', 'blur'].forEach((type) => b.addEventListener(type, queueSnapshot));
+      });
+
+      canvas.addEventListener('webglcontextlost', (e) => {
+        e.preventDefault();
+        hero.classList.remove('hero--gl');
+        visible = false;
+      });
+
+      function init() {
+        snapshot();
+        hero.classList.add('hero--gl');
+        new ResizeObserver(queueSnapshot).observe(hero);
+        new IntersectionObserver((entries) => {
+          visible = entries[0].isIntersecting;
+          if (visible) startLoop();
+        }).observe(hero);
+        document.addEventListener('visibilitychange', () => { if (!document.hidden) startLoop(); });
+        if (document.fonts) document.fonts.addEventListener('loadingdone', queueSnapshot);
+        startLoop();
+      }
+
+      bgImage.onload = () => {
+        (document.fonts ? document.fonts.ready : Promise.resolve()).then(init);
+      };
+      bgImage.onerror = () => console.warn('Hero ripple disabled: background image unavailable');
+      bgImage.src = BG_URL;
+    })();
+  </script>
+
 </body>
 
