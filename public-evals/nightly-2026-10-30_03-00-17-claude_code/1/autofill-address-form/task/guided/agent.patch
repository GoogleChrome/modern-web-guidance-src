+    /* Shipping Address Form */
+    .shipping {
+      max-width: 640px;
+      margin: 60px auto 0;
+      background: white;
+      padding: 32px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .shipping h2 {
+      color: var(--primary);
+      margin-bottom: 0.25rem;
+    }
+
+    .shipping-intro {
+      margin-bottom: 1.5rem;
+    }
+
+    .shipping fieldset {
+      border: none;
+      margin-block-end: 1rem;
+    }
+
+    .shipping legend {
+      font-weight: bold;
+      color: var(--primary);
+      margin-block-end: 0.75rem;
+    }
+
+    .form-group {
+      margin-block-end: 1.25rem;
+    }
+
+    .form-row {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+      column-gap: 16px;
+    }
+
+    .shipping label {
+      display: block;
+      font-weight: 600;
+      margin-block-end: 0.25rem;
+    }
+
+    .optional {
+      font-weight: normal;
+      color: #6d4c41;
+    }
+
+    .hint {
+      display: block;
+      font-size: 0.85rem;
+      color: #6d4c41;
+      margin-block-start: 0.25rem;
+    }
+
+    .shipping input,
+    .shipping select,
+    .shipping textarea {
+      width: 100%;
+      font: inherit;
+      font-size: 1rem;
+      padding: 0.75rem;
+      min-height: 48px;
+      color: var(--text);
+      background: white;
+      border: 1px solid #8d6e63;
+      border-radius: 5px;
+    }
+
+    .shipping textarea {
+      resize: vertical;
+      min-height: 5.5rem;
+    }
+
+    .shipping input:focus-visible,
+    .shipping select:focus-visible,
+    .shipping textarea:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .shipping :is(input, select, textarea):user-invalid {
+      border: 2px solid #c62828;
+    }
+
+    /* Highlight browser-autofilled fields (separate rules so an unsupported selector can't drop the other) */
+    .shipping :is(input, select, textarea):autofill {
+      border: 2px solid #6d4c41;
+      box-shadow: 0 0 0 100vmax #fff3e0 inset;
+    }
+
+    .shipping :is(input, select, textarea):-webkit-autofill {
+      border: 2px solid #6d4c41;
+      box-shadow: 0 0 0 100vmax #fff3e0 inset;
+    }
+
+    .shipping button {
+      font: inherit;
+      font-size: 1rem;
+      min-height: 48px;
+      width: 100%;
+      background: var(--primary);
+      color: white;
+      border: none;
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .shipping button:hover {
+      background: #3e2723;
+    }
+
+    .shipping button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @media (pointer: coarse) {
+      .shipping input,
+      .shipping select,
+      .shipping button {
+        min-height: 52px;
+      }
+    }
+
     footer {
