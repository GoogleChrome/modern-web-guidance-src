+      margin-bottom: 4px;
+    }
+
+    .form-field .optional {
+      font-weight: normal;
+      color: #8d6e63;
+    }
+
+    .form-field input,
+    .form-field select {
+      font: inherit;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      background: var(--light);
+      color: var(--text);
+    }
+
+    .form-field input:focus,
+    .form-field select:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+      border-color: var(--accent);
+    }
+
+    .shipping button.btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .form-actions {
+      text-align: center;
+    }
+
+    @media (max-width: 600px) {
+      .form-grid {
+        grid-template-columns: 1fr;
+      }
+    }
+
