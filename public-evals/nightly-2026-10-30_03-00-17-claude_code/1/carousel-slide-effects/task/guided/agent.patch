@@ -134,8 +134,113 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Product Carousel */
+    .carousel-section {
+      margin-top: 60px;
+      text-align: center;
+    }
+
+    .carousel-hint {
+      font-size: 0.9rem;
+      color: #6d4c41;
+    }
+
+    .scroller {
+      --card-width: min(260px, 70vw);
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      margin-top: 20px;
+      border-radius: 8px;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .scroller ul {
+      display: flex;
+      gap: 20px;
+      width: max-content;
+      list-style: none;
+      /* Lets the first and last cards reach the center of the scroller */
+      padding: 24px calc(50% - var(--card-width) / 2);
+    }
+
+    .product-card {
+      width: var(--card-width);
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+      scroll-snap-align: center;
+      text-align: center;
+      /* Identity value so the animation doesn't change the stacking context mid-scroll */
+      scale: 1;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .card-body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      color: var(--text);
+    }
+
+    .product-card .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @keyframes card-focus {
+      0% {
+        scale: 0.8;
+      }
+
+      50% {
+        scale: 1;
+      }
+
+      100% {
+        scale: 0.8;
+      }
+    }
+
+    /* Progressive enhancement: unsupported browsers and reduced-motion users get static, full-size cards */
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: card-focus auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
