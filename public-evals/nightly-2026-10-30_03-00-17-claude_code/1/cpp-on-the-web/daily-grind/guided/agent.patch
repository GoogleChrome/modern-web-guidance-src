diff --git a/js/smallpt-demo.js b/js/smallpt-demo.js
new file mode 100644
index 0000000..5d4200f
--- /dev/null
+++ b/js/smallpt-demo.js
@@ -0,0 +1,114 @@
+// Drives a pool of smallpt workers and progressively draws the result.
+const WIDTH = 512;
+const HEIGHT = 384;
+const PASSES = 64; // 4 spp per pass -> 256 spp total
+const WORKERS = Math.min(navigator.hardwareConcurrency || 4, 8);
+
+// Sphere indices in smallpt's scene[] (the front wall is black, the light is
+// emissive, so those two are left alone).
+const SPHERES = [
+  { index: 0, name: 'Left wall', color: [0.75, 0.25, 0.25] },
+  { index: 1, name: 'Right wall', color: [0.25, 0.25, 0.75] },
+  { index: 2, name: 'Back wall', color: [0.75, 0.75, 0.75] },
+  { index: 4, name: 'Floor', color: [0.75, 0.75, 0.75] },
+  { index: 5, name: 'Ceiling', color: [0.75, 0.75, 0.75] },
+  { index: 6, name: 'Mirror', color: [0.999, 0.999, 0.999] },
+  { index: 7, name: 'Glass', color: [0.999, 0.999, 0.999] },
+];
+
+const canvas = document.getElementById('pt-canvas');
+const status = document.getElementById('pt-status');
+const swatches = document.getElementById('pt-swatches');
+const ctx = canvas.getContext('2d');
+const image = ctx.createImageData(WIDTH, HEIGHT);
+let workers = [];
+let drawPending = false;
+
+function hslToRgb(h, s, l) {
+  const f = (n) => {
+    const k = (n + h / 30) % 12;
+    return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+  };
+  return [f(0), f(8), f(4)];
+}
+
+function randomColors() {
+  return SPHERES.map((sphere) => {
+    // Mirror and glass get pale tints so they still read as mirror and glass;
+    // everything stays below 1 so the scene doesn't gain energy.
+    const pale = sphere.index >= 6;
+    const rgb = hslToRgb(
+      Math.random() * 360,
+      pale ? 0.6 : 0.4 + Math.random() * 0.5,
+      pale ? 0.8 : 0.35 + Math.random() * 0.3,
+    ).map((c) => Math.min(c, 0.999));
+    return { ...sphere, color: rgb };
+  });
+}
+
+function showSwatches(spheres) {
+  swatches.replaceChildren(...spheres.map(({ name, color }) => {
+    const li = document.createElement('li');
+    const chip = document.createElement('span');
+    // Display with the same gamma smallpt applies to its output.
+    chip.style.backgroundColor = `rgb(${color.map((c) => Math.round(c ** (1 / 2.2) * 255)).join(' ')})`;
+    li.append(chip, name);
+    return li;
+  }));
+}
+
+function render(spheres) {
+  workers.forEach((w) => w.terminate());
+  showSwatches(spheres);
+  const colors = spheres.map(({ index, color }) => [index, ...color]);
+  const passesDone = new Array(WORKERS).fill(0);
+  const start = performance.now();
+
+  workers = Array.from({ length: WORKERS }, (_, k) => {
+    const rows = [];
+    for (let y = k; y < HEIGHT; y += WORKERS) rows.push(y);
+
+    const worker = new Worker(new URL('./smallpt-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data: { pass, accum } }) => {
+      const px = image.data;
+      rows.forEach((y, j) => {
+        // smallpt's y=0 is the bottom row.
+        let o = (HEIGHT - 1 - y) * WIDTH * 4;
+        for (let x = 0, i = j * WIDTH * 3; x < WIDTH; x++, i += 3, o += 4) {
+          px[o] = toByte(accum[i] / pass);
+          px[o + 1] = toByte(accum[i + 1] / pass);
+          px[o + 2] = toByte(accum[i + 2] / pass);
+          px[o + 3] = 255;
+        }
+      });
+      passesDone[k] = pass;
+      const spp = Math.min(...passesDone) * 4;
+      const seconds = ((performance.now() - start) / 1000).toFixed(1);
+      status.textContent = spp === PASSES * 4
+        ? `Done: ${spp} samples per pixel in ${seconds}s on ${WORKERS} threads.`
+        : `Rendering… ${spp} / ${PASSES * 4} samples per pixel (${seconds}s)`;
+      scheduleDraw();
+    };
+    worker.onerror = (e) => { status.textContent = `Renderer failed: ${e.message}`; };
+    worker.postMessage({ width: WIDTH, height: HEIGHT, rows, colors, passes: PASSES });
+    return worker;
+  });
+}
+
+// Same tone mapping as smallpt's toInt(): clamp, gamma 2.2 (the
+// Uint8ClampedArray store does the rounding).
+function toByte(v) {
+  return Math.pow(Math.min(Math.max(v, 0), 1), 1 / 2.2) * 255;
+}
+
+function scheduleDraw() {
+  if (drawPending) return;
+  drawPending = true;
+  requestAnimationFrame(() => {
+    drawPending = false;
+    ctx.putImageData(image, 0, 0);
+  });
+}
+
+document.getElementById('pt-randomize').addEventListener('click', () => render(randomColors()));
+render(SPHERES);
diff --git a/js/smallpt-worker.js b/js/smallpt-worker.js
new file mode 100644
index 0000000..b353aff
--- /dev/null
+++ b/js/smallpt-worker.js
@@ -0,0 +1,21 @@
+// Runs the smallpt WebAssembly module off the main thread. Each worker renders
+// an interleaved subset of rows and posts its accumulated radiance after every
+// pass (4 samples per pixel).
+import initSmallpt from '../wasm/smallpt.js';
+
+self.onmessage = async ({ data: { width, height, rows, colors, passes } }) => {
+  const wasm = await initSmallpt();
+  for (const [i, r, g, b] of colors) wasm._set_color(i, r, g, b);
+
+  const rowFloats = width * 3;
+  const ptr = wasm._malloc(rows.length * rowFloats * 4);
+  wasm.HEAPF32.fill(0, ptr >> 2, (ptr >> 2) + rows.length * rowFloats);
+
+  for (let pass = 0; pass < passes; pass++) {
+    rows.forEach((y, j) => wasm._render_row(width, height, y, pass, ptr + j * rowFloats * 4));
+    // Re-read HEAPF32 after the calls: memory growth would detach the old view.
+    const accum = wasm.HEAPF32.slice(ptr >> 2, (ptr >> 2) + rows.length * rowFloats);
+    self.postMessage({ pass: pass + 1, accum }, [accum.buffer]);
+  }
+  wasm._free(ptr);
+};
