+// Runs the smallpt WebAssembly build off the main thread and streams back
+// progressively refined rows of the image.
+import createSmallpt from './smallpt.js';
+
+const ROWS_PER_CHUNK = 16;
+
+self.onmessage = async ({ data: { width, height, colors, maxPasses } }) => {
+  const m = await createSmallpt();
+  const ptr = m._init(width, height);
+  colors.forEach(([i, r, g, b]) => m._set_sphere_color(i, r, g, b));
+
+  for (let pass = 1; pass <= maxPasses; pass++) {
+    for (let row = 0; row < height; row += ROWS_PER_CHUNK) {
+      const end = Math.min(row + ROWS_PER_CHUNK, height);
+      m._render_rows(row, end);
+      // HEAPU8 is re-read each time since memory growth can replace it.
+      const pixels = m.HEAPU8.slice(ptr + row * width * 4, ptr + end * width * 4);
+      self.postMessage({ type: 'rows', row, rows: end - row, pixels, pass }, [pixels.buffer]);
+    }
+    m._end_pass();
+    self.postMessage({ type: 'pass', pass });
+  }
+  self.postMessage({ type: 'done' });
+};
