+  <script type="module">
+    const WIDTH = 512, HEIGHT = 384, MAX_PASSES = 64; // 4 samples per pixel per pass
+
+    // smallpt's scene array indices and the original colors of the spheres we recolor.
+    const DEFAULT_COLORS = [
+      { index: 0, name: 'Left wall', rgb: [0.75, 0.25, 0.25] },
+      { index: 1, name: 'Right wall', rgb: [0.25, 0.25, 0.75] },
+      { index: 6, name: 'Mirror sphere', rgb: [0.999, 0.999, 0.999] },
+      { index: 7, name: 'Glass sphere', rgb: [0.999, 0.999, 0.999] },
+    ];
+
+    const canvas = document.getElementById('smallpt-canvas');
+    const ctx = canvas.getContext('2d');
+    const button = document.getElementById('smallpt-rerender');
+    const swatches = document.getElementById('smallpt-swatches');
+    const status = document.getElementById('smallpt-status');
+    let worker;
+
+    function hslToRgb(h, s, l) {
+      const f = (n) => {
+        const k = (n + h / 30) % 12;
+        return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+      };
+      return [f(0), f(8), f(4)];
+    }
+
+    function randomColors() {
+      return DEFAULT_COLORS.map(({ index, name }) => {
+        // Walls get saturated albedos; the mirror and glass get a lighter tint
+        // so they still read as mirror and glass. Albedo must stay below 1.
+        const wall = index < 6;
+        const rgb = hslToRgb(Math.random() * 360,
+          wall ? 0.5 + Math.random() * 0.4 : 0.6 + Math.random() * 0.4,
+          wall ? 0.35 + Math.random() * 0.2 : 0.75 + Math.random() * 0.15);
+        return { index, name, rgb: rgb.map((c) => Math.min(c, 0.999)) };
+      });
+    }
+
+    function showSwatches(colors) {
+      swatches.replaceChildren(...colors.map(({ name, rgb }) => {
+        const el = document.createElement('span');
+        el.className = 'swatch';
+        el.title = name;
+        el.style.background = `rgb(${rgb.map((c) => Math.round(c ** (1 / 2.2) * 255)).join(',')})`;
+        return el;
+      }));
+    }
+
+    function render(colors) {
+      worker?.terminate(); // abandon any render still in progress
+      worker = new Worker(new URL('smallpt/worker.js', import.meta.url), { type: 'module' });
+      showSwatches(colors);
+      ctx.fillStyle = '#111';
+      ctx.fillRect(0, 0, WIDTH, HEIGHT);
+
+      const start = performance.now();
+      const elapsed = () => ((performance.now() - start) / 1000).toFixed(1);
+      status.textContent = 'Rendering pass 1…';
+
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'rows') {
+          ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), WIDTH, data.rows), 0, data.row);
+        } else if (data.type === 'pass') {
+          status.textContent = data.pass < MAX_PASSES
+            ? `Pass ${data.pass + 1}/${MAX_PASSES} · ${data.pass * 4} spp · ${elapsed()}s`
+            : '';
+        } else if (data.type === 'done') {
+          status.textContent = `Done · ${MAX_PASSES * 4} spp · ${elapsed()}s`;
+        }
+      };
+      worker.onerror = (e) => {
+        status.textContent = 'Could not run the path tracer in this browser.';
+        console.error(e);
+      };
+      worker.postMessage({
+        width: WIDTH,
+        height: HEIGHT,
+        maxPasses: MAX_PASSES,
+        colors: colors.map(({ index, rgb }) => [index, ...rgb]),
+      });
+    }
+
+    button.addEventListener('click', () => render(randomColors()));
+    render(DEFAULT_COLORS);
+  </script>
+
