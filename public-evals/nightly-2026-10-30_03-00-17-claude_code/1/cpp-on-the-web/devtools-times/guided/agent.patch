new file mode 100644
index 0000000..30a6e99
--- /dev/null
+++ b/src/components/smallpt.worker.ts
@@ -0,0 +1,40 @@
+/// <reference lib="webworker" />
+import initSmallpt from '../wasm/smallpt.js';
+
+export type RGB = [number, number, number];
+
+export interface RenderRequest {
+  job: number;
+  width: number;
+  height: number;
+  samples: number;
+  colors: RGB[];
+  row0: number;
+  row1: number;
+}
+
+export interface RenderResult {
+  job: number;
+  row0: number;
+  row1: number;
+  pixels: Uint8ClampedArray<ArrayBuffer>;
+}
+
+const wasmReady = initSmallpt();
+
+self.onmessage = async ({ data }: MessageEvent<RenderRequest>) => {
+  const wasm = await wasmReady;
+  const { job, width, height, samples, colors, row0, row1 } = data;
+  colors.forEach(([r, g, b], i) => wasm._set_sphere_color(i, r, g, b));
+
+  const byteLength = (row1 - row0) * width * 4;
+  const ptr = wasm._malloc(byteLength);
+  try {
+    wasm._render_rows(ptr, width, height, samples, row0, row1);
+    // Read HEAPU8 after the call: memory growth replaces the buffer.
+    const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, ptr, byteLength).slice();
+    self.postMessage({ job, row0, row1, pixels } satisfies RenderResult, [pixels.buffer]);
+  } finally {
+    wasm._free(ptr);
+  }
+};
