@@ -0,0 +1,18 @@
+#!/bin/sh
+# Compiles smallpt to an ES6 WebAssembly module used by the homepage worker.
+# Requires Emscripten (emcc/em++) on PATH. Linked with emcc since the code
+# needs no C++ standard library.
+set -e
+cd "$(dirname "$0")"
+mkdir -p ../src/wasm
+em++ -c smallpt.cpp -o smallpt.o -O3 -flto -Werror -Wall
+emcc smallpt.o -o ../src/wasm/smallpt.js \
+  -O3 -flto \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_render_rows,_set_sphere_color,_sphere_count,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+rm smallpt.o
