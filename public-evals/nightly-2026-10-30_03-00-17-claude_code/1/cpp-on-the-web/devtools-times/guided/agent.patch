diff --git a/src/components/PathTracer.tsx b/src/components/PathTracer.tsx
new file mode 100644
index 0000000..ee675bb
--- /dev/null
+++ b/src/components/PathTracer.tsx
@@ -0,0 +1,149 @@
+import React, { useEffect, useRef, useState } from 'react';
+import type { RGB, RenderRequest, RenderResult } from './smallpt.worker';
+
+const WIDTH = 480;
+const HEIGHT = 360;
+const SAMPLES = 4; // per 2x2 subpixel, i.e. 16 samples per pixel
+const BAND_ROWS = 8;
+
+// smallpt's sphere order: left, right, back, front, bottom, top, mirror, glass, light.
+const ORIGINAL_COLORS: RGB[] = [
+  [0.75, 0.25, 0.25],
+  [0.25, 0.25, 0.75],
+  [0.75, 0.75, 0.75],
+  [0, 0, 0],
+  [0.75, 0.75, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+  [0, 0, 0],
+];
+
+function hsv(h: number, s: number, v: number): RGB {
+  const f = (n: number) => {
+    const k = (n + h * 6) % 6;
+    return v - v * s * Math.max(0, Math.min(k, 4 - k, 1));
+  };
+  return [f(5), f(3), f(1)];
+}
+
+function randomColors(): RGB[] {
+  const wall = () => hsv(Math.random(), 0.2 + Math.random() * 0.6, 0.75);
+  // Mirror and glass stay near-white so they still reflect/refract clearly.
+  const tint = () => hsv(Math.random(), Math.random() * 0.5, 0.999);
+  return [wall(), wall(), wall(), [0, 0, 0], wall(), wall(), tint(), tint(), [0, 0, 0]];
+}
+
+function toCss([r, g, b]: RGB) {
+  return `rgb(${Math.round(r * 255)} ${Math.round(g * 255)} ${Math.round(b * 255)})`;
+}
+
+export default function PathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workersRef = useRef<Worker[]>([]);
+  const idleRef = useRef(new Set<Worker>());
+  const jobRef = useRef(0);
+  const [colors, setColors] = useState(ORIGINAL_COLORS);
+  const [progress, setProgress] = useState(0);
+  const [elapsed, setElapsed] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const count = Math.min(navigator.hardwareConcurrency || 4, 8);
+    workersRef.current = Array.from({ length: count }, () =>
+      new Worker(new URL('./smallpt.worker.ts', import.meta.url), { type: 'module' }));
+    idleRef.current = new Set(workersRef.current);
+    return () => workersRef.current.forEach((w) => w.terminate());
+  }, []);
+
+  useEffect(() => {
+    const ctx = canvasRef.current?.getContext('2d');
+    if (!ctx) return;
+    const job = ++jobRef.current;
+    const start = performance.now();
+    const bands = Math.ceil(HEIGHT / BAND_ROWS);
+    let nextBand = 0;
+    let doneBands = 0;
+    setProgress(0);
+    setElapsed(null);
+    setError(null);
+
+    const idle = idleRef.current;
+    const dispatch = (worker: Worker) => {
+      if (nextBand >= bands) {
+        idle.add(worker);
+        return;
+      }
+      idle.delete(worker);
+      const row0 = nextBand++ * BAND_ROWS;
+      const row1 = Math.min(row0 + BAND_ROWS, HEIGHT);
+      worker.postMessage({ job, width: WIDTH, height: HEIGHT, samples: SAMPLES, colors, row0, row1 } satisfies RenderRequest);
+    };
+
+    for (const worker of workersRef.current) {
+      worker.onmessage = ({ data }: MessageEvent<RenderResult>) => {
+        // Bands from an older job may still arrive after a re-run; drop them
+        // but use the now-idle worker for the current job.
+        if (data.job === job) {
+          ctx.putImageData(new ImageData(data.pixels, WIDTH, data.row1 - data.row0), 0, data.row0);
+          doneBands++;
+          setProgress(doneBands / bands);
+          if (doneBands === bands) setElapsed(performance.now() - start);
+        }
+        dispatch(worker);
+      };
+      worker.onerror = (e) => setError(e.message || 'The path tracer failed to load.');
+    }
+
+    // Busy workers pick up the new job from onmessage once their band is done.
+    [...idle].forEach(dispatch);
+  }, [colors]);
+
+  const rendering = elapsed === null && !error;
+
+  return (
+    <figure className="flex flex-col md:flex-row gap-6 items-start">
+      <div className="relative w-full md:w-auto">
+        <canvas
+          ref={canvasRef}
+          width={WIDTH}
+          height={HEIGHT}
+          className="block w-full md:w-[480px] aspect-[4/3] bg-gray-900"
+          role="img"
+          aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere"
+        />
+        <progress
+          className="absolute inset-x-0 bottom-0 w-full h-1 accent-amber-400"
+          value={progress}
+          hidden={!rendering}
+          aria-label="Render progress"
+        />
+      </div>
+      <figcaption className="flex-1 space-y-4">
+        <p className="text-gray-700">
+          This Cornell box is rendered live in your browser by{' '}
+          <a className="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+          Kevin Beason's 99-line C++ path tracer, compiled to WebAssembly and run across{' '}
+          {workersRef.current.length || 'several'} Web Workers at {SAMPLES * 4} samples per pixel.
+        </p>
+        <div className="flex gap-1" aria-hidden="true">
+          {colors.slice(0, 8).filter((_, i) => i !== 3).map((c, i) => (
+            <span key={i} className="size-5 rounded-full border border-gray-300" style={{ background: toCss(c) }} />
+          ))}
+        </div>
+        <button
+          type="button"
+          onClick={() => setColors(randomColors())}
+          className="bg-gray-900 text-white font-bold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 transition-colors"
+        >
+          Render with random colors
+        </button>
+        <p className="text-sm text-gray-500" aria-live="polite">
+          {error ?? (rendering
+            ? `Rendering… ${Math.round(progress * 100)}%`
+            : `Rendered ${WIDTH}×${HEIGHT} in ${(elapsed! / 1000).toFixed(1)} s`)}
+        </p>
+      </figcaption>
+    </figure>
+  );
+}
