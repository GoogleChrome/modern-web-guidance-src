new file mode 100644
index 0000000..d72bea9
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,26 @@
+// Runs the smallpt WebAssembly build off the main thread.
+// Message in:  { width, height, passes, colors: [[index, r, g, b], ...] }
+// Messages out: { type: 'progress', pixels, pass, passes, row } and { type: 'done', ms }
+importScripts('smallpt.js');
+
+const ROWS_PER_CHUNK = 16;
+const modulePromise = createSmallpt();
+
+self.onmessage = async ({ data }) => {
+  const m = await modulePromise;
+  const { width, height, passes, colors } = data;
+
+  m._reset_sphere_colors();
+  for (const [i, r, g, b] of colors) m._set_sphere_color(i, r, g, b);
+
+  const ptr = m._init(width, height);
+  const start = performance.now();
+  for (let pass = 0; pass < passes; pass++) {
+    for (let y = 0; y < height; y += ROWS_PER_CHUNK) {
+      m._render_rows(y, y + ROWS_PER_CHUNK, pass);
+      const pixels = m.HEAPU8.slice(ptr, ptr + width * height * 4);
+      self.postMessage({ type: 'progress', pixels, pass, passes, row: Math.min(y + ROWS_PER_CHUNK, height) }, [pixels.buffer]);
+    }
+  }
+  self.postMessage({ type: 'done', ms: performance.now() - start });
+};
diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..8bc3109
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,93 @@
+---
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+const width = 400;
+const height = 300;
+---
+<section class="p-4 md:p-6" id="smallpt">
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        Rendered In Your Browser
+    </h2>
+
+    <div class="grid md:grid-cols-3 gap-6">
+        <figure class="md:col-span-2">
+            <canvas
+                data-smallpt-canvas
+                data-worker-url={`${base}smallpt/worker.js`}
+                width={width}
+                height={height}
+                class="w-full h-auto bg-black [image-rendering:auto]"
+                aria-label="Path-traced image of spheres in a box, rendered by smallpt"
+            ></canvas>
+            <figcaption class="text-xs text-gray-500 mt-2" data-smallpt-status>Starting renderer…</figcaption>
+        </figure>
+
+        <div class="flex flex-col gap-4">
+            <p class="text-gray-700">
+                This image is path traced live on your device by
+                <a href="http://www.kevinbeason.com/smallpt/" class="underline hover:text-amber-400" target="_blank" rel="noopener">smallpt</a>,
+                Kevin Beason's 99-line C++ global illumination renderer, compiled to WebAssembly.
+                It refines progressively as more samples per pixel are added.
+            </p>
+            <button
+                type="button"
+                data-smallpt-button
+                class="self-start bg-gray-900 text-white font-bold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 transition-colors"
+            >
+                Render with random colors
+            </button>
+        </div>
+    </div>
+</section>
+
+<script>
+    // smallpt scene indices: 0 left, 1 right, 2 back, 3 front, 4 bottom, 5 top, 6 mirror, 7 glass, 8 light
+    const DIFFUSE_SPHERES = [0, 1, 2, 4, 5];
+    const SHINY_SPHERES = [6, 7];
+    const PASSES = 64; // 4 samples per pixel per pass
+
+    const canvas = document.querySelector<HTMLCanvasElement>('[data-smallpt-canvas]');
+    const status = document.querySelector<HTMLElement>('[data-smallpt-status]');
+    const button = document.querySelector<HTMLButtonElement>('[data-smallpt-button]');
+
+    if (canvas && status && button) {
+        const ctx = canvas.getContext('2d')!;
+        const { width, height } = canvas;
+        let worker: Worker | null = null;
+
+        const randomColor = (min: number, max: number) =>
+            [0, 0, 0].map(() => min + Math.random() * (max - min));
+
+        const render = (colors: number[][]) => {
+            worker?.terminate();
+            worker = new Worker(canvas.dataset.workerUrl!);
+            status.textContent = 'Loading WebAssembly…';
+            worker.onmessage = ({ data }) => {
+                if (data.type === 'progress') {
+                    ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), width, height), 0, 0);
+                    status.textContent = `Rendering… ${(data.pass + 1) * 4} of ${data.passes * 4} samples per pixel`;
+                } else if (data.type === 'done') {
+                    status.textContent = `Done: ${PASSES * 4} samples per pixel in ${(data.ms / 1000).toFixed(1)}s`;
+                }
+            };
+            worker.onerror = () => {
+                status.textContent = 'The renderer failed to load.';
+            };
+            worker.postMessage({ width, height, passes: PASSES, colors });
+        };
+
+        button.addEventListener('click', () => {
+            render([
+                ...DIFFUSE_SPHERES.map(i => [i, ...randomColor(0.05, 0.85)]),
+                ...SHINY_SPHERES.map(i => [i, ...randomColor(0.4, 0.999)]),
+            ]);
+        });
+
+        // Start with smallpt's original scene once the section scrolls into view.
+        new IntersectionObserver((entries, observer) => {
+            if (entries.some(e => e.isIntersecting)) {
+                observer.disconnect();
+                render([]);
+            }
+        }).observe(canvas);
+    }
+</script>
