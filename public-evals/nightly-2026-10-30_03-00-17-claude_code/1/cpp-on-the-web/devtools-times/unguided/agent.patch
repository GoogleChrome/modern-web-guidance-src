diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..309dd37
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Compiles smallpt to WebAssembly. Output goes to public/smallpt/ and is
+# committed, so the regular site build does not need Emscripten installed.
+set -e
+cd "$(dirname "$0")/.."
+mkdir -p public/smallpt
+em++ wasm/smallpt.cpp -O3 -Wno-dangling-else \
+  -o public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1MB \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  --no-entry
