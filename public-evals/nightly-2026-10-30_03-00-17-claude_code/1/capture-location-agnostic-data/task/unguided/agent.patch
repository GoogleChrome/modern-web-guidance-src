+  <script>
+    // Both values are stored as plain, zone-less strings ("HH:MM" and "YYYY-MM-DD")
+    // exactly as the inputs report them. They are never turned into timestamps,
+    // so a change of device time zone (travel, DST) cannot shift them.
+    (function () {
+      var PICKUP_KEY = 'dailyGrind.pickupTime';
+      var ANNIV_KEY = 'dailyGrind.anniversaryDate';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      function read(key) {
+        try { return localStorage.getItem(key); } catch (e) { return null; }
+      }
+
+      function write(key, value) {
+        try { localStorage.setItem(key, value); } catch (e) { /* storage unavailable */ }
+      }
+
+      function isValidDate(value) {
+        var m = DATE_RE.exec(value);
+        if (!m) return false;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1) return false;
+        // Day count of the month, computed in UTC so no local offset is involved.
+        return d <= new Date(Date.UTC(y, mo, 0)).getUTCDate();
+      }
+
+      function formatTime(value) {
+        var m = TIME_RE.exec(value);
+        var h = +m[1];
+        var suffix = h < 12 ? 'AM' : 'PM';
+        return (h % 12 || 12) + ':' + m[2] + ' ' + suffix;
+      }
+
+      function formatDate(value) {
+        var m = DATE_RE.exec(value);
+        return MONTHS[+m[2] - 1] + ' ' + +m[3] + ', ' + m[1];
+      }
+
+      var pickupForm = document.getElementById('pickup-form');
+      var pickupInput = document.getElementById('pickup-time');
+      var pickupDisplay = document.getElementById('pickup-display');
+      var annivForm = document.getElementById('anniversary-form');
+      var annivInput = document.getElementById('anniversary-date');
+      var annivDisplay = document.getElementById('anniversary-display');
+
+      function showPickup(value) {
+        pickupDisplay.textContent = value ? 'Reminder set for ' + formatTime(value) + ' daily' : '';
+      }
+
+      function showAnniversary(value) {
+        annivDisplay.textContent = value ? 'Anniversary: ' + formatDate(value) : '';
+      }
+
+      var savedTime = read(PICKUP_KEY);
+      if (savedTime && TIME_RE.test(savedTime)) {
+        pickupInput.value = savedTime;
+        showPickup(savedTime);
+      }
+
+      var savedDate = read(ANNIV_KEY);
+      if (savedDate && isValidDate(savedDate)) {
+        annivInput.value = savedDate;
+        showAnniversary(savedDate);
+      }
+
+      pickupForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        // Some browsers report seconds ("HH:MM:SS"); keep only hours and minutes.
+        var value = pickupInput.value.slice(0, 5);
+        if (!TIME_RE.test(value)) return;
+        write(PICKUP_KEY, value);
+        showPickup(value);
+      });
+
+      annivForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var value = annivInput.value;
+        if (!isValidDate(value)) return;
+        write(ANNIV_KEY, value);
+        showAnniversary(value);
+      });
+    })();
+  </script>
+
