+  <script type="module">
+    // Pickup time and anniversary are wall-clock/calendar values, not instants.
+    // They are stored as Temporal Plain ISO strings ("08:30", "2024-10-30") with
+    // no time zone, so they never shift when the user travels.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrind.prefs';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const pickupSummary = document.getElementById('pickup-summary');
+    const anniversarySummary = document.getElementById('anniversary-summary');
+    const status = document.getElementById('prefs-status');
+
+    function loadPrefs() {
+      try {
+        const { pickupTime, anniversaryDate } = JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? {};
+        return {
+          pickupTime: pickupTime ? Temporal.PlainTime.from(pickupTime) : null,
+          anniversaryDate: anniversaryDate ? Temporal.PlainDate.from(anniversaryDate) : null,
+        };
+      } catch {
+        return { pickupTime: null, anniversaryDate: null };
+      }
+    }
+
+    function nextAnniversary(anniversaryDate) {
+      const today = Temporal.Now.plainDateISO();
+      const monthDay = anniversaryDate.toPlainMonthDay();
+      // toPlainDate constrains Feb 29 to Feb 28 in non-leap years.
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      return { next, daysAway: today.until(next).days };
+    }
+
+    function render({ pickupTime, anniversaryDate }) {
+      if (pickupTime) {
+        timeInput.value = pickupTime.toString({ smallestUnit: 'minute' });
+        pickupSummary.textContent = `We'll remind you every day at ${pickupTime.toLocaleString(undefined, { timeStyle: 'short' })}, local time.`;
+      }
+      if (anniversaryDate) {
+        dateInput.value = anniversaryDate.toString();
+        const { next, daysAway } = nextAnniversary(anniversaryDate);
+        const when = daysAway === 0 ? 'today! ☕' : `in ${daysAway} day${daysAway === 1 ? '' : 's'}`;
+        anniversarySummary.textContent = `Since ${anniversaryDate.toLocaleString(undefined, { dateStyle: 'long' })}. Next anniversary (${next.toLocaleString(undefined, { dateStyle: 'medium' })}) is ${when}`;
+      }
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const prefs = {
+        pickupTime: Temporal.PlainTime.from(timeInput.value),
+        anniversaryDate: Temporal.PlainDate.from(dateInput.value),
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({
+        pickupTime: prefs.pickupTime.toString({ smallestUnit: 'minute' }),
+        anniversaryDate: prefs.anniversaryDate.toString(),
+      }));
+      render(prefs);
+      status.textContent = 'Saved!';
+    });
+
+    render(loadPrefs());
+  </script>
+
 </body>
 
