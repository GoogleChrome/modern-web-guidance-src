+  <script>
+    (() => {
+      const PRIORITIES = ['urgent', 'standard', 'background'];
+      const SLICE_BUDGET_MS = 8;
+
+      const TASK_TYPES = {
+        checkout: { priority: 'urgent', label: 'Checkout', units: 40, names: ['Process card payment', 'Confirm mobile order', 'Apply rewards at checkout'] },
+        menu: { priority: 'standard', label: 'Menu update', units: 120, names: ['Sync seasonal menu', 'Update espresso prices', 'Refresh pastry stock'] },
+        telemetry: { priority: 'background', label: 'Telemetry', units: 200, names: ['Upload POS metrics', 'Log grinder diagnostics', 'Archive footfall stats'] }
+      };
+
+      const queueEl = document.getElementById('ops-queue');
+      const logEl = document.getElementById('ops-log');
+      const pendingEl = document.getElementById('ops-pending');
+      const doneEl = document.getElementById('ops-done');
+      const jankEl = document.getElementById('ops-jank');
+      const modeEl = document.getElementById('ops-mode');
+
+      const queues = { urgent: [], standard: [], background: [] };
+      let nextId = 1;
+      let completed = 0;
+      let running = false;
+
+      // Yield control back to the browser so input and rendering can happen.
+      const hasSchedulerYield = typeof globalThis.scheduler?.yield === 'function';
+      const channel = new MessageChannel();
+      const pendingResolves = [];
+      channel.port1.onmessage = () => pendingResolves.shift()?.();
+      const yieldToMain = hasSchedulerYield
+        ? () => globalThis.scheduler.yield()
+        : () => new Promise(resolve => { pendingResolves.push(resolve); channel.port2.postMessage(null); });
+      modeEl.textContent = hasSchedulerYield ? 'scheduler.yield()' : 'MessageChannel';
+
+      // One unit of simulated CPU-bound work (~1ms).
+      function doWorkUnit() {
+        const end = performance.now() + 1;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(Math.random());
+        return x;
+      }
+
+      function nextTask() {
+        for (const p of PRIORITIES) {
+          if (queues[p].length) return queues[p][0];
+        }
+        return null;
+      }
+
+      function pendingCount() {
+        return PRIORITIES.reduce((n, p) => n + queues[p].length, 0);
+      }
+
+      function log(message) {
+        const li = document.createElement('li');
+        const time = document.createElement('time');
+        time.textContent = new Date().toLocaleTimeString([], { hour12: false });
+        li.append(time, message);
+        logEl.prepend(li);
+        while (logEl.children.length > 100) logEl.lastChild.remove();
+      }
+
+      function renderQueue() {
+        queueEl.replaceChildren();
+        const all = PRIORITIES.flatMap(p => queues[p]);
+        if (!all.length) {
+          const li = document.createElement('li');
+          li.className = 'ops-empty';
+          li.textContent = 'Queue is empty';
+          queueEl.append(li);
+        }
+        for (const task of all) {
+          const li = document.createElement('li');
+          li.className = task.priority;
+          const head = document.createElement('div');
+          head.className = 'task-head';
+          const name = document.createElement('span');
+          name.textContent = `#${task.id} ${task.name}`;
+          const state = document.createElement('span');
+          state.className = 'task-state';
+          state.textContent = `${task.priority} · ${task.started ? `${Math.round(task.done / task.units * 100)}%` : 'waiting'}`;
+          head.append(name, state);
+          const bar = document.createElement('progress');
+          bar.max = task.units;
+          bar.value = task.done;
+          task.bar = bar;
+          task.stateEl = state;
+          li.append(head, bar);
+          queueEl.append(li);
+        }
+        pendingEl.textContent = pendingCount();
+        doneEl.textContent = completed;
+      }
+
+      function updateProgress(task) {
+        if (!task.bar) return;
+        task.bar.value = task.done;
+        task.stateEl.textContent = `${task.priority} · ${Math.round(task.done / task.units * 100)}%`;
+      }
+
+      function enqueue(type) {
+        const def = TASK_TYPES[type];
+        const task = {
+          id: nextId++,
+          type,
+          priority: def.priority,
+          name: def.names[Math.floor(Math.random() * def.names.length)],
+          units: def.units,
+          done: 0,
+          started: false,
+          queuedAt: performance.now()
+        };
+        queues[task.priority].push(task);
+        log(`Queued #${task.id} ${task.name} [${task.priority}]`);
+        renderQueue();
+        run();
+        return task;
+      }
+
+      // Cooperative scheduler: always works on the highest-priority task, in time-boxed
+      // slices, yielding between slices so newly queued urgent tasks preempt lower ones.
+      async function run() {
+        if (running) return;
+        running = true;
+        let current = null;
+        try {
+          while (true) {
+            const task = nextTask();
+            if (!task) break;
+
+            if (current && current !== task && current.done < current.units) {
+              log(`Paused #${current.id} for higher-priority #${task.id}`);
+            }
+            if (!task.started) {
+              task.started = true;
+              task.startedAt = performance.now();
+              log(`Started #${task.id} ${task.name} (waited ${Math.round(task.startedAt - task.queuedAt)} ms)`);
+              renderQueue();
+            } else if (current !== task) {
+              log(`Resumed #${task.id} ${task.name}`);
+            }
+            current = task;
+
+            const sliceEnd = performance.now() + SLICE_BUDGET_MS;
+            while (task.done < task.units && performance.now() < sliceEnd) {
+              doWorkUnit();
+              task.done++;
+            }
+            updateProgress(task);
+
+            if (task.done >= task.units) {
+              queues[task.priority].shift();
+              completed++;
+              log(`Completed #${task.id} ${task.name} in ${Math.round(performance.now() - task.startedAt)} ms`);
+              renderQueue();
+              current = null;
+            }
+
+            await yieldToMain();
+          }
+        } finally {
+          running = false;
+        }
+      }
+
+      // Mixed batch queued in a jumbled order; the scheduler executes it by priority.
+      function runBatch() {
+        const batch = ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout', 'menu', 'telemetry', 'checkout'];
+        log(`Batch submitted: ${batch.length} mixed tasks`);
+        batch.forEach(enqueue);
+      }
+
+      document.querySelectorAll('.ops-controls [data-task]').forEach(btn => {
+        btn.addEventListener('click', () => enqueue(btn.dataset.task));
+      });
+      document.getElementById('ops-batch').addEventListener('click', runBatch);
+      document.getElementById('ops-clear').addEventListener('click', () => logEl.replaceChildren());
+
+      // Track main-thread responsiveness via the longest gap between animation frames.
+      let lastFrame = performance.now();
+      let worstGap = 0;
+      let windowStart = lastFrame;
+      function frame(now) {
+        worstGap = Math.max(worstGap, now - lastFrame);
+        lastFrame = now;
+        if (now - windowStart > 1000) {
+          jankEl.textContent = `${Math.round(worstGap)} ms`;
+          worstGap = 0;
+          windowStart = now;
+        }
+        requestAnimationFrame(frame);
+      }
+      requestAnimationFrame(frame);
+
+      renderQueue();
+    })();
+  </script>
+
 </body>
 
