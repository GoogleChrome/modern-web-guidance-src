+  <script>
+    (() => {
+      const TASKS = {
+        checkout: { label: 'Checkout payment', priority: 'user-blocking', units: 120 },
+        menu: { label: 'Menu update', priority: 'user-visible', units: 200 },
+        telemetry: { label: 'Telemetry log', priority: 'background', units: 300 },
+      };
+      const PRIORITY_LABEL = {
+        'user-blocking': 'Urgent',
+        'user-visible': 'Standard',
+        'background': 'Background',
+      };
+      // Submitted lowest-priority first to show the scheduler reordering them.
+      const BATCH = ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout'];
+      const CHUNK_BUDGET_MS = 50;
+
+      const log = document.getElementById('ops-log');
+      const empty = document.getElementById('ops-empty');
+      const counts = document.getElementById('ops-counts');
+      const stats = { queued: 0, running: 0, done: 0 };
+      let nextId = 1;
+      let completionOrder = 0;
+
+      const hasPostTask = () => 'scheduler' in window && 'postTask' in window.scheduler;
+
+      function yieldToMain() {
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          return scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function updateCounts() {
+        counts.textContent = `Queued: ${stats.queued} · Running: ${stats.running} · Done: ${stats.done}`;
+      }
+
+      // Simulates one unit of CPU-heavy work (~1ms).
+      function doUnitOfWork() {
+        const end = performance.now() + 1;
+        while (performance.now() < end) { /* busy */ }
+      }
+
+      function addLogEntry(type) {
+        const { label, priority, units } = TASKS[type];
+        empty?.remove();
+        const item = document.createElement('li');
+        const title = document.createElement('span');
+        const badge = document.createElement('span');
+        const state = document.createElement('span');
+        const progress = document.createElement('progress');
+        badge.className = `ops-badge ${priority}`;
+        badge.textContent = PRIORITY_LABEL[priority];
+        title.append(badge, `${label} #${nextId++}`);
+        state.className = 'ops-state';
+        state.textContent = 'Queued';
+        progress.max = units;
+        progress.value = 0;
+        progress.setAttribute('aria-label', `${label} progress`);
+        item.append(title, state, progress);
+        log.append(item);
+        return { state, progress };
+      }
+
+      async function runTask(type, entry) {
+        const { units } = TASKS[type];
+        stats.queued--;
+        stats.running++;
+        updateCounts();
+        entry.state.textContent = 'Running';
+
+        let deadline = performance.now() + CHUNK_BUDGET_MS;
+        for (let i = 0; i < units; i++) {
+          doUnitOfWork();
+          if (performance.now() >= deadline) {
+            entry.progress.value = i + 1;
+            await yieldToMain();
+            deadline = performance.now() + CHUNK_BUDGET_MS;
+          }
+        }
+
+        entry.progress.value = units;
+        entry.state.textContent = `Done (finished ${++completionOrder}${ordinalSuffix(completionOrder)})`;
+        stats.running--;
+        stats.done++;
+        updateCounts();
+      }
+
+      function ordinalSuffix(n) {
+        const rem100 = n % 100;
+        if (rem100 >= 11 && rem100 <= 13) return 'th';
+        return { 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th';
+      }
+
+      function enqueue(type) {
+        const entry = addLogEntry(type);
+        stats.queued++;
+        updateCounts();
+        const { priority } = TASKS[type];
+        scheduler.postTask(() => runTask(type, entry), { priority })
+          .catch((err) => { entry.state.textContent = `Failed: ${err.message}`; });
+      }
+
+      function init(engine) {
+        document.getElementById('ops-engine').textContent = `Engine: ${engine}`;
+        document.querySelectorAll('.ops-controls [data-task]').forEach((button) => {
+          button.addEventListener('click', () => enqueue(button.dataset.task));
+        });
+        document.getElementById('ops-batch').addEventListener('click', () => {
+          BATCH.forEach(enqueue);
+        });
+      }
+
+      if (hasPostTask()) {
+        init('native scheduler');
+      } else {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => init('scheduler polyfill');
+        script.onerror = () => {
+          document.getElementById('ops-engine').textContent = 'Engine unavailable: could not load scheduler polyfill';
+        };
+        document.head.appendChild(script);
+      }
+    })();
+  </script>
+
 </body>
 
