+      color: #8d6e63;
+      margin-top: 6px;
+    }
+
+    /* Scroll indicators: sticky so they stay pinned to the scrollport edges,
+       negative margins so they overlay content instead of taking up space */
+    .indicator-top,
+    .indicator-bottom {
+      position: sticky;
+      left: 0;
+      right: 0;
+      z-index: 1;
+      height: 40px;
+      opacity: 0;
+      transition: opacity 0.2s;
+      pointer-events: none;
+    }
+
+    .indicator-top {
+      top: 0;
+      margin-bottom: -40px;
+      background: linear-gradient(to bottom, rgba(78, 52, 46, 0.25), transparent);
+    }
+
+    .indicator-bottom {
+      bottom: 0;
+      margin-top: -40px;
+      background: linear-gradient(to top, rgba(78, 52, 46, 0.25), transparent);
+    }
+
+    @container scroll-state(scrollable: top) {
+      .indicator-top {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: bottom) {
+      .indicator-bottom {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback for browsers without scroll-state queries (toggled via JS) */
+    .reviews-scroller.scrolled-down .indicator-top,
+    .reviews-scroller.can-scroll-down .indicator-bottom {
+      opacity: 1;
+    }
+
+    .sentinel-top,
+    .sentinel-bottom {
+      height: 1px;
+      visibility: hidden;
+    }
+
