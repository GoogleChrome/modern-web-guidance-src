+  <script>
+    (function () {
+      var scroller = document.querySelector('.reviews-scroll');
+      var top = document.querySelector('.indicator-top');
+      var bottom = document.querySelector('.indicator-bottom');
+
+      function updateIndicators() {
+        var maxScroll = scroller.scrollHeight - scroller.clientHeight;
+        // 1px tolerance for fractional scroll positions
+        top.classList.toggle('visible', scroller.scrollTop > 1);
+        bottom.classList.toggle('visible', scroller.scrollTop < maxScroll - 1);
+      }
+
+      scroller.addEventListener('scroll', updateIndicators, { passive: true });
+      window.addEventListener('resize', updateIndicators);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(updateIndicators).observe(scroller);
+      }
+      updateIndicators();
+    })();
+  </script>
