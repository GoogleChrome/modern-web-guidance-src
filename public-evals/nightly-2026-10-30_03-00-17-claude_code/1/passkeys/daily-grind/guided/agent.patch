index 0000000..ca95785
--- /dev/null
+++ b/account.js
@@ -0,0 +1,601 @@
+/*
+ * My Account: passkey sign-up, sign-in, management, profile updates and
+ * reauthentication, using the native WebAuthn browser APIs.
+ *
+ * Server contract (same-origin JSON, cookie session). Options generation and
+ * verification must use a vetted FIDO2 library (e.g. SimpleWebAuthn server).
+ *
+ *   GET    /api/session               -> 200 { rpId, user: { id, name, displayName } } | 401
+ *                                        user.id is the Base64URL WebAuthn user handle
+ *   POST   /api/auth/signin/options   -> PublicKeyCredentialRequestOptionsJSON (allowCredentials: [])
+ *   POST   /api/auth/signin/verify    <- credential.toJSON()   -> 200 | 404 unknown credential
+ *   POST   /api/auth/password         <- { username, password } -> 200
+ *   POST   /api/auth/signup/options   <- { name, displayName }  -> PublicKeyCredentialCreationOptionsJSON | 409 taken
+ *   POST   /api/auth/signup/verify    <- credential.toJSON()   -> 200 (account created + signed in)
+ *   POST   /api/auth/signup           <- { name, displayName, password } -> 200 (no-passkey fallback)
+ *   POST   /api/auth/signout
+ *   POST   /api/auth/reauth/options   -> request options, allowCredentials = the user's passkeys
+ *   POST   /api/auth/reauth/verify    <- credential.toJSON()   -> 200 (credential must belong to session user)
+ *   POST   /api/auth/reauth/password  <- { password }          -> 200
+ *   GET    /api/passkeys              -> [{ id, name, providerIcon?, registeredAt, lastUsedAt?, credentialBackedUp }]
+ *   POST   /api/passkeys/options      <- { conditional? }      -> creation options (excludeCredentials populated;
+ *                                        conditional => relax user presence check at verify)
+ *   POST   /api/passkeys/verify       <- credential.toJSON()   -> 200
+ *   PATCH  /api/passkeys/:id          <- { name }              -> 200
+ *   DELETE /api/passkeys/:id          (requires recent reauth) -> 200
+ *   PUT    /api/account               <- { name, displayName } (requires recent reauth) -> 200 { user }
+ */
+
+// JSON (de)serialization and getClientCapabilities() polyfills for older browsers.
+if (
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.getClientCapabilities)
+) {
+  try {
+    await import('https://esm.sh/webauthn-polyfills@0.1.7');
+  } catch (err) {
+    console.error('Failed to load WebAuthn polyfills:', err);
+  }
+}
+
+const DEFAULT_PASSKEY_ICON =
+  'data:image/svg+xml,' +
+  encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#4e342e"><path d="M12.65 10A6 6 0 1 0 12.65 14H17v4h4v-4h2v-4H12.65zM7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>'
+  );
+
+const $ = (id) => document.getElementById(id);
+const dialog = $('account-dialog');
+const accountLink = $('account-link');
+const logoutLink = $('logout-link');
+const statusEl = $('account-status');
+const signedOutView = $('signed-out-view');
+const signedInView = $('signed-in-view');
+const signinTab = $('signin-tab');
+const signupTab = $('signup-tab');
+const signinPanel = $('signin-panel');
+const signupPanel = $('signup-panel');
+const signinForm = $('signin-form');
+const signupForm = $('signup-form');
+const profileForm = $('profile-form');
+const passkeyList = $('passkey-list');
+const passkeyTemplate = $('passkey-item-template');
+const createPasskeyBtn = $('create-passkey-btn');
+const passkeySigninBtn = $('passkey-signin-btn');
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+let session = null; // { rpId, user: { id, name, displayName } }
+let passkeys = [];
+let conditionalAbort = new AbortController();
+
+class ApiError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function api(path, { method = 'POST', body } = {}) {
+  return fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : {},
+    body: body ? JSON.stringify(body) : undefined,
+  });
+}
+
+async function apiJSON(path, options) {
+  const response = await api(path, options);
+  if (!response.ok) {
+    const { error } = await response.json().catch(() => ({}));
+    throw new ApiError(response.status, error || `Request failed (${response.status}).`);
+  }
+  return response.status === 204 ? null : response.json();
+}
+
+function setStatus(message = '', type = 'info') {
+  statusEl.textContent = message;
+  statusEl.dataset.type = type;
+}
+
+async function withBusy(button, fn) {
+  button.disabled = true;
+  try {
+    return await fn();
+  } catch (err) {
+    console.error(err);
+    setStatus(err instanceof ApiError ? err.message : 'Something went wrong. Please try again.', 'error');
+  } finally {
+    button.disabled = false;
+  }
+}
+
+/* ---------- Capabilities ---------- */
+
+async function getCapabilities() {
+  if (!window.PublicKeyCredential?.getClientCapabilities) return {};
+  try {
+    return await PublicKeyCredential.getClientCapabilities();
+  } catch {
+    return {};
+  }
+}
+
+const capabilities = await getCapabilities();
+const passkeysSupported =
+  capabilities.passkeyPlatformAuthenticator === true && capabilities.conditionalGet === true;
+
+/* ---------- Signal API helpers (feature-detected, never throw) ---------- */
+
+async function signalUnknownCredential(rpId, credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.error('signalUnknownCredential failed:', err);
+  }
+}
+
+async function signalAllAcceptedCredentials() {
+  if (!session || !window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: session.rpId,
+      userId: session.user.id,
+      allAcceptedCredentialIds: passkeys.map((p) => p.id),
+    });
+  } catch (err) {
+    console.error('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+async function signalCurrentUserDetails() {
+  if (!session || !window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: session.rpId,
+      userId: session.user.id,
+      name: session.user.name,
+      displayName: session.user.displayName,
+    });
+  } catch (err) {
+    console.error('signalCurrentUserDetails failed:', err);
+  }
+}
+
+/* ---------- Registration ---------- */
+
+// Returns true when the passkey was created and verified by the server.
+async function registerPasskey(optionsJSON, verifyPath, { conditional = false } = {}) {
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+  const rpId = optionsJSON.rp?.id ?? location.hostname;
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      ...(conditional && { mediation: 'conditional' }),
+    });
+  } catch (err) {
+    if (conditional) {
+      if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(err.name)) {
+        console.error('Unexpected conditional create error:', err);
+      }
+    } else if (err.name === 'InvalidStateError') {
+      setStatus('A passkey for this account already exists in this password manager.', 'error');
+    } else if (err.name === 'SecurityError') {
+      console.error('RP ID or secure context misconfiguration:', err);
+      setStatus("Passkeys aren't available on this site right now.", 'error');
+    } else if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+      setStatus('Passkey creation was cancelled.');
+    } else {
+      throw err;
+    }
+    return false;
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const response = await api(verifyPath, { body: encoded });
+    if (response.ok) return true;
+    // The server rejected the credential: remove the orphan from the password manager.
+    await signalUnknownCredential(rpId, encoded.id);
+  } catch (err) {
+    console.error('Registration verification failed:', err);
+    await signalUnknownCredential(rpId, encoded.id);
+  }
+  if (!conditional) setStatus("We couldn't save your passkey. Please try again.", 'error');
+  return false;
+}
+
+/* ---------- Sign-in ---------- */
+
+function abortConditionalGet() {
+  conditionalAbort.abort();
+  conditionalAbort = new AbortController();
+}
+
+async function verifySignin(credential, rpId) {
+  const encoded = credential.toJSON();
+  const response = await api('/api/auth/signin/verify', { body: encoded });
+  if (response.ok) {
+    await onSignedIn();
+    return;
+  }
+  if (response.status === 404) {
+    // Still unauthenticated here, so it is safe to tell the provider to drop it.
+    await signalUnknownCredential(rpId, encoded.id);
+    setStatus("This passkey is no longer registered with The Daily Grind. Sign in another way.", 'error');
+  } else {
+    setStatus("We couldn't sign you in with that passkey.", 'error');
+  }
+}
+
+// Offer passkeys in the email field's autofill suggestions.
+async function startConditionalGet() {
+  if (capabilities.conditionalGet !== true || session) return;
+  abortConditionalGet();
+  const { signal } = conditionalAbort;
+
+  try {
+    const optionsJSON = await apiJSON('/api/auth/signin/options');
+    if (signal.aborted) return;
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+    const credential = await navigator.credentials.get({ publicKey, signal, mediation: 'conditional' });
+    await verifySignin(credential, optionsJSON.rpId ?? location.hostname);
+  } catch (err) {
+    if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+    console.error('Conditional get failed:', err);
+  }
+}
+
+async function signinWithPasskeyButton() {
+  abortConditionalGet();
+  setStatus();
+
+  const optionsJSON = await apiJSON('/api/auth/signin/options');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal: conditionalAbort.signal });
+  } catch (err) {
+    if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') throw err;
+    // Re-arm autofill suggestions after the prompt is dismissed.
+    startConditionalGet();
+    return;
+  }
+  await verifySignin(credential, optionsJSON.rpId ?? location.hostname);
+}
+
+async function signinWithPassword(form) {
+  abortConditionalGet();
+  setStatus();
+  const data = new FormData(form);
+  try {
+    await apiJSON('/api/auth/password', {
+      body: { username: data.get('username'), password: data.get('password') },
+    });
+  } catch (err) {
+    startConditionalGet();
+    throw err;
+  }
+  form.reset();
+  await onSignedIn();
+
+  // Quietly offer to upgrade password users to a passkey.
+  if (capabilities.conditionalCreate === true) {
+    try {
+      const optionsJSON = await apiJSON('/api/passkeys/options', { body: { conditional: true } });
+      if (await registerPasskey(optionsJSON, '/api/passkeys/verify', { conditional: true })) {
+        await loadPasskeys();
+      }
+    } catch (err) {
+      console.error('Conditional create failed:', err);
+    }
+  }
+}
+
+/* ---------- Sign-up ---------- */
+
+async function signup(form) {
+  abortConditionalGet();
+  setStatus();
+  const data = new FormData(form);
+  const name = data.get('name').trim();
+  const displayName = data.get('displayName').trim();
+
+  if (!passkeysSupported) {
+    await apiJSON('/api/auth/signup', { body: { name, displayName, password: data.get('password') } });
+  } else {
+    const optionsJSON = await apiJSON('/api/auth/signup/options', { body: { name, displayName } });
+    if (!(await registerPasskey(optionsJSON, '/api/auth/signup/verify'))) return;
+  }
+  form.reset();
+  await onSignedIn();
+  setStatus(`Welcome to The Daily Grind, ${displayName}!`);
+}
+
+/* ---------- Reauthentication ---------- */
+
+function reauthWithPassword() {
+  const reauthDialog = $('reauth-dialog');
+  const form = $('reauth-form');
+  form.reset();
+  form.elements.username.value = session.user.name;
+  reauthDialog.returnValue = '';
+  reauthDialog.showModal();
+
+  return new Promise((resolve) => {
+    reauthDialog.addEventListener(
+      'close',
+      async () => {
+        if (reauthDialog.returnValue !== 'confirm') return resolve(false);
+        try {
+          await apiJSON('/api/auth/reauth/password', { body: { password: form.elements.password.value } });
+          resolve(true);
+        } catch (err) {
+          setStatus(err instanceof ApiError && err.status === 401 ? 'Incorrect password.' : err.message, 'error');
+          resolve(false);
+        } finally {
+          form.reset();
+        }
+      },
+      { once: true }
+    );
+  });
+}
+
+// Confirms the signed-in user's identity before a sensitive change.
+async function reauthenticate() {
+  if (passkeys.length === 0) return reauthWithPassword();
+
+  abortConditionalGet();
+  const optionsJSON = await apiJSON('/api/auth/reauth/options');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal: conditionalAbort.signal });
+  } catch (err) {
+    if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') throw err;
+    setStatus('Verification was cancelled.');
+    return false;
+  }
+
+  const encoded = credential.toJSON();
+  const response = await api('/api/auth/reauth/verify', { body: encoded });
+  if (response.ok) return true;
+  if (response.status === 404) {
+    await signalUnknownCredential(optionsJSON.rpId ?? session.rpId, encoded.id);
+  }
+  setStatus("We couldn't verify it's you.", 'error');
+  return false;
+}
+
+/* ---------- Passkey management ---------- */
+
+function renderPasskeys() {
+  passkeyList.replaceChildren(
+    ...passkeys.map((passkey) => {
+      const item = passkeyTemplate.content.firstElementChild.cloneNode(true);
+      item.querySelector('img').src = passkey.providerIcon || DEFAULT_PASSKEY_ICON;
+      item.querySelector('.passkey-name').textContent = passkey.name;
+
+      const meta = [`Created ${dateFormat.format(passkey.registeredAt)}`];
+      if (passkey.lastUsedAt) meta.push(`Last used ${dateFormat.format(passkey.lastUsedAt)}`);
+      if (passkey.credentialBackedUp) meta.push('Synced');
+      item.querySelector('.passkey-meta').textContent = meta.join(' · ');
+
+      const renameBtn = item.querySelector('[data-action="rename"]');
+      const deleteBtn = item.querySelector('[data-action="delete"]');
+      renameBtn.setAttribute('aria-label', `Rename ${passkey.name}`);
+      deleteBtn.setAttribute('aria-label', `Delete ${passkey.name}`);
+      renameBtn.addEventListener('click', () => withBusy(renameBtn, () => renamePasskey(passkey)));
+      deleteBtn.addEventListener('click', () => withBusy(deleteBtn, () => deletePasskey(passkey)));
+      return item;
+    })
+  );
+  $('passkey-empty').hidden = passkeys.length > 0;
+}
+
+async function loadPasskeys() {
+  passkeys = await apiJSON('/api/passkeys', { method: 'GET' });
+  renderPasskeys();
+  await signalAllAcceptedCredentials();
+}
+
+function renamePasskey(passkey) {
+  const renameDialog = $('rename-dialog');
+  const form = $('rename-form');
+  form.elements.name.value = passkey.name;
+  renameDialog.returnValue = '';
+  renameDialog.showModal();
+
+  return new Promise((resolve, reject) => {
+    renameDialog.addEventListener(
+      'close',
+      async () => {
+        const name = form.elements.name.value.trim();
+        if (renameDialog.returnValue !== 'save' || !name || name === passkey.name) return resolve();
+        try {
+          await apiJSON(`/api/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'PATCH', body: { name } });
+          // A nickname is a server-side label only; no Signal API call needed.
+          passkeys = await apiJSON('/api/passkeys', { method: 'GET' });
+          renderPasskeys();
+          setStatus('Passkey renamed.');
+          resolve();
+        } catch (err) {
+          reject(err);
+        }
+      },
+      { once: true }
+    );
+  });
+}
+
+async function deletePasskey(passkey) {
+  setStatus();
+  if (!confirm(`Delete the passkey "${passkey.name}"? You won't be able to sign in with it anymore.`)) return;
+  if (!(await reauthenticate())) return;
+
+  await apiJSON(`/api/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+  await loadPasskeys();
+  setStatus('Passkey deleted. You can also remove it from your password manager.');
+}
+
+async function createPasskey() {
+  setStatus();
+  const optionsJSON = await apiJSON('/api/passkeys/options', { body: {} });
+  if (await registerPasskey(optionsJSON, '/api/passkeys/verify')) {
+    await loadPasskeys();
+    setStatus('Passkey created.');
+  }
+}
+
+/* ---------- Profile ---------- */
+
+function fillProfileForm() {
+  profileForm.elements.name.value = session.user.name;
+  profileForm.elements.displayName.value = session.user.displayName;
+}
+
+async function updateProfile(form) {
+  setStatus();
+  const name = form.elements.name.value.trim();
+  const displayName = form.elements.displayName.value.trim();
+  if (name === session.user.name && displayName === session.user.displayName) {
+    setStatus('No changes to save.');
+    return;
+  }
+  if (!(await reauthenticate())) return;
+
+  const { user } = await apiJSON('/api/account', { method: 'PUT', body: { name, displayName } });
+  session.user = user;
+  fillProfileForm();
+  await signalCurrentUserDetails();
+  setStatus('Profile updated.');
+}
+
+/* ---------- Views ---------- */
+
+function selectTab(tab) {
+  const signin = tab === signinTab;
+  signinTab.setAttribute('aria-selected', String(signin));
+  signupTab.setAttribute('aria-selected', String(!signin));
+  signinTab.tabIndex = signin ? 0 : -1;
+  signupTab.tabIndex = signin ? -1 : 0;
+  signinPanel.hidden = !signin;
+  signupPanel.hidden = signin;
+  setStatus();
+  if (signin) startConditionalGet();
+  else abortConditionalGet();
+}
+
+async function renderView() {
+  logoutLink.hidden = !session;
+  signedOutView.hidden = !!session;
+  signedInView.hidden = !session;
+
+  if (session) {
+    fillProfileForm();
+    createPasskeyBtn.hidden = !passkeysSupported;
+    $('passkey-unsupported').hidden = passkeysSupported;
+    if (dialog.open) await loadPasskeys();
+  }
+}
+
+async function loadSession() {
+  try {
+    const response = await api('/api/session', { method: 'GET' });
+    session = response.ok ? await response.json() : null;
+  } catch {
+    session = null;
+  }
+}
+
+async function onSignedIn() {
+  await loadSession();
+  await renderView();
+}
+
+async function openAccount() {
+  setStatus();
+  await renderView();
+  if (!session) {
+    selectTab(signinTab); // Starts conditional get before the email field gets focus.
+  }
+  if (!dialog.open) dialog.showModal();
+}
+
+/* ---------- Wiring ---------- */
+
+$('passkey-signin').hidden = !window.PublicKeyCredential;
+
+if (!passkeysSupported) {
+  const passwordField = $('signup-password');
+  passwordField.hidden = false;
+  passwordField.querySelector('input').disabled = false;
+  passwordField.querySelector('input').required = true;
+  $('signup-submit').textContent = 'Create account';
+  $('signup-hint').hidden = true;
+}
+
+accountLink.addEventListener('click', (event) => {
+  event.preventDefault();
+  openAccount().catch((err) => console.error(err));
+});
+
+logoutLink.addEventListener('click', async (event) => {
+  event.preventDefault();
+  try {
+    await api('/api/auth/signout');
+  } finally {
+    session = null;
+    passkeys = [];
+    await renderView();
+    if (dialog.open) selectTab(signinTab);
+  }
+});
+
+$('account-close').addEventListener('click', () => dialog.close());
+dialog.addEventListener('close', () => {
+  abortConditionalGet();
+  setStatus();
+});
+
+signinTab.addEventListener('click', () => selectTab(signinTab));
+signupTab.addEventListener('click', () => selectTab(signupTab));
+for (const tab of [signinTab, signupTab]) {
+  tab.addEventListener('keydown', (event) => {
+    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+    const other = tab === signinTab ? signupTab : signinTab;
+    selectTab(other);
+    other.focus();
+  });
+}
+
+signinForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  withBusy(event.submitter, () => signinWithPassword(signinForm));
+});
+
+passkeySigninBtn.addEventListener('click', () => withBusy(passkeySigninBtn, signinWithPasskeyButton));
+
+signupForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  withBusy(event.submitter, () => signup(signupForm));
+});
+
+profileForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  withBusy(event.submitter, () => updateProfile(profileForm));
+});
+
+createPasskeyBtn.addEventListener('click', () => withBusy(createPasskeyBtn, createPasskey));
+
+await loadSession();
+await renderView();
