+import type { APIRoute } from 'astro';
+import { errorResponse, json, requireUser } from '../../../../lib/auth/session';
+import { deletePasskey, updatePasskey } from '../../../../lib/auth/store';
+import { toPublicPasskey } from '../../../../lib/auth/webauthn';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const auth = await requireUser(session);
+  if ('response' in auth) return auth.response;
+
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return errorResponse(400, 'INVALID_NAME', 'Passkey names must be between 1 and 64 characters.');
+  }
+
+  const passkey = await updatePasskey(params.id!, auth.user.username, { name: trimmed });
+  if (!passkey) return errorResponse(404, 'NOT_FOUND', 'Passkey not found.');
+  return json({ passkey: toPublicPasskey(passkey) });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  // Removing a sign-in method is sensitive, so require a recent sign-in.
+  const auth = await requireUser(session, { recent: true });
+  if ('response' in auth) return auth.response;
+
+  const deleted = await deletePasskey(params.id!, auth.user.username);
+  if (!deleted) return errorResponse(404, 'NOT_FOUND', 'Passkey not found.');
+  return json({ ok: true });
+};
