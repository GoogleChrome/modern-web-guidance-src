+import type { APIRoute } from 'astro';
+import { json, requireUser } from '../../../../lib/auth/session';
+import { getUser, listPasskeys } from '../../../../lib/auth/store';
+import { toPublicPasskey } from '../../../../lib/auth/webauthn';
+
+export const GET: APIRoute = async ({ session }) => {
+  const auth = await requireUser(session);
