+/**
+ * Friendly names for common passkey providers, keyed by AAGUID.
+ * Source: https://github.com/passkeydeveloper/passkey-authenticator-aaguids
+ */
+const PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+};
+
+export function providerName(aaguid: string): string | null {
+  return PROVIDERS[aaguid] ?? null;
+}
diff --git a/src/lib/auth/client.ts b/src/lib/auth/client.ts
new file mode 100644
index 0000000..0cf76f7
--- /dev/null
+++ b/src/lib/auth/client.ts
@@ -0,0 +1,134 @@
+import {
+  WebAuthnAbortService,
+  WebAuthnError,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+} from '@simplewebauthn/browser';
+import type { PublicPasskey } from './webauthn';
+
+export type { PublicPasskey };
+
+const API = `${import.meta.env.BASE_URL}api/auth`;
+
+export class ApiError extends Error {
+  constructor(message: string, public code: string | undefined, public status: number) {
+    super(message);
+  }
+}
+
+/** Thrown when the user dismisses the browser's passkey dialog. Callers usually ignore it. */
+export class PasskeyCancelledError extends Error {}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(`${API}/${path}`, {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: init.body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ApiError(data.error || 'Unknown error', data.code, response.status);
+  }
+  return data as T;
+}
+
+export const isReauthRequired = (err: unknown) => err instanceof ApiError && err.code === 'REAUTH_REQUIRED';
+
+export function passkeysSupported(): boolean {
+  return typeof window !== 'undefined' && browserSupportsWebAuthn();
+}
+
+/** Whether the browser can silently create a passkey right after a password sign-in. */
+export async function conditionalCreateSupported(): Promise<boolean> {
+  const PKC = window.PublicKeyCredential as any;
+  if (!PKC?.getClientCapabilities) return false;
+  const capabilities = await PKC.getClientCapabilities().catch(() => ({}));
+  return capabilities.conditionalCreate === true;
+}
+
+function translateWebAuthnError(err: unknown): never {
+  if (err instanceof Error && (err.name === 'NotAllowedError' || err.name === 'AbortError')) {
+    throw new PasskeyCancelledError(err.message);
+  }
+  if (err instanceof WebAuthnError) {
+    if (err.code === 'ERROR_CEREMONY_ABORTED') throw new PasskeyCancelledError(err.message);
+    if (err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+      throw new Error('This device already has a passkey for your account.');
+    }
+  }
+  throw err;
+}
+
+/**
+ * Creates a passkey for the signed-in user. With `auto: true` the browser
+ * creates it without UI if the user just signed in with a saved password,
+ * and rejects otherwise.
+ */
+export async function createPasskey({ auto = false } = {}): Promise<PublicPasskey> {
+  const optionsJSON = await api('passkeys/register-options', { body: {} });
+  let response;
+  try {
+    response = await startRegistration({ optionsJSON, useAutoRegister: auto });
+  } catch (err) {
+    translateWebAuthnError(err);
+  }
+  const { passkey } = await api<{ passkey: PublicPasskey }>('passkeys/register-verify', { body: { response } });
+  return passkey;
+}
+
+async function authenticate(purpose: 'signin' | 'reauth', useBrowserAutofill: boolean) {
+  const optionsJSON = await api('passkeys/authenticate-options', { body: { purpose } });
+  let response;
+  try {
+    response = await startAuthentication({ optionsJSON, useBrowserAutofill });
+  } catch (err) {
+    translateWebAuthnError(err);
+  }
+  try {
+    return await api<{ username: string }>('passkeys/authenticate-verify', { body: { purpose, response } });
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'UNKNOWN_CREDENTIAL') {
+      // Let the passkey provider know so it can hide the stale passkey next time.
+      sendSignal({ signalName: 'unknownCredential', rpID: optionsJSON.rpId, credentialID: response.id }).catch(() => {});
+    }
+    throw err;
+  }
+}
+
+/** Signs in with any passkey via the browser's passkey dialog. */
+export const signInWithPasskey = () => authenticate('signin', false);
+
+/**
+ * Offers passkeys in the username field's autofill menu. Resolves once the user
+ * picks one; is aborted automatically when another WebAuthn ceremony starts.
+ */
+export async function signInWithPasskeyAutofill() {
+  if (!(await browserSupportsWebAuthnAutofill())) return null;
+  return authenticate('signin', true);
+}
+
+export const cancelPendingPasskeyRequest = () => WebAuthnAbortService.cancelCeremony();
+
+/** Confirms the signed-in user's identity with one of their passkeys. */
+export const reauthenticateWithPasskey = () => authenticate('reauth', false);
+
+export const reauthenticateWithPassword = (password: string) => api('reauth', { body: { password } });
+
+/**
+ * Keeps passkey providers in sync with the server: hides deleted passkeys and
+ * updates the account name shown in the passkey picker.
+ */
+export function syncPasskeySignals(rpID: string, webauthnUserId: string, username: string, passkeyIds: string[]) {
+  sendSignal({ signalName: 'allAcceptedCredentials', rpID, userID: webauthnUserId, allAcceptedCredentialIDs: passkeyIds }).catch(() => {});
+  sendSignal({ signalName: 'currentUserDetails', rpID, userID: webauthnUserId, userName: username, userDisplayName: username }).catch(() => {});
+}
+
+/** Where to go after signing in: the `next` query param if it's a same-site path, otherwise home. */
+export function postSignInDestination(): string {
+  const base = import.meta.env.BASE_URL;
+  const next = new URLSearchParams(window.location.search).get('next');
+  return next && next.startsWith(base) && !next.startsWith('//') ? next : base;
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..1c15808
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,69 @@
+import type { APIContext } from 'astro';
+
+type Session = NonNullable<APIContext['session']>;
+
+export type AuthMethod = 'password' | 'passkey';
+
+export interface SessionUser {
+  username: string;
+  /** Epoch ms of the most recent sign-in or reauthentication. */
+  authenticatedAt: number;
+  method: AuthMethod;
+}
+
+/** How long a sign-in counts as "recent" for sensitive account changes. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export function json(data: unknown, status = 200): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function errorResponse(status: number, code: string, message: string): Response {
+  return json({ error: message, code }, status);
+}
+
+export async function getSessionUser(session: APIContext['session']): Promise<SessionUser | null> {
+  return ((await session?.get('user')) as SessionUser | undefined) ?? null;
+}
+
+export async function signIn(session: Session, username: string, method: AuthMethod): Promise<SessionUser> {
+  // New session ID on every privilege change to prevent session fixation.
+  await session.regenerate();
+  const user: SessionUser = { username, method, authenticatedAt: Date.now() };
+  session.set('user', user);
+  return user;
+}
+
+export function markReauthenticated(session: Session, user: SessionUser, method: AuthMethod) {
+  session.set('user', { ...user, method, authenticatedAt: Date.now() });
+}
+
+export function isRecentlyAuthenticated(user: SessionUser): boolean {
+  return Date.now() - user.authenticatedAt < REAUTH_WINDOW_MS;
+}
+
+export function signOut(session: Session) {
+  session.destroy();
+}
+
+/**
+ * Resolves the signed-in user, or returns an error response. With `recent: true`,
+ * also demands that the user authenticated within REAUTH_WINDOW_MS; clients react
+ * to the REAUTH_REQUIRED code by prompting for a passkey or password.
+ */
+export async function requireUser(
+  session: APIContext['session'],
+  { recent = false } = {},
+): Promise<{ user: SessionUser; session: Session } | { response: Response }> {
+  const user = await getSessionUser(session);
+  if (!session || !user) {
+    return { response: errorResponse(401, 'UNAUTHENTICATED', 'You need to sign in first.') };
+  }
+  if (recent && !isRecentlyAuthenticated(user)) {
+    return { response: errorResponse(401, 'REAUTH_REQUIRED', 'Please confirm it’s you to continue.') };
+  }
+  return { user, session };
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..5a11e0b
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,130 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+/**
+ * Minimal file-backed store for passkey data. Account credentials (username +
+ * password) live in the external Times API; this store only links usernames to
+ * a WebAuthn user handle and the passkeys registered for it.
+ *
+ * Set PASSKEY_DATA_DIR to point at persistent storage in production.
+ */
+
+export interface PasskeyUser {
+  username: string;
+  /** WebAuthn user handle (base64url). Random, never derived from the username. */
+  webauthnUserId: string;
+  createdAt: string;
+}
+
+export interface StoredPasskey {
+  /** Credential ID (base64url). */
+  id: string;
+  username: string;
+  webauthnUserId: string;
+  /** COSE public key (base64url). */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  aaguid: string;
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface StoreData {
+  users: Record<string, PasskeyUser>;
+  passkeys: Record<string, StoredPasskey>;
+}
+
+const DATA_DIR = process.env.PASSKEY_DATA_DIR || path.join(process.cwd(), '.data');
+const DATA_FILE = path.join(DATA_DIR, 'passkeys.json');
+
+let cache: StoreData | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as StoreData;
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: {}, passkeys: {} };
+  }
+  return cache;
+}
+
+async function persist(data: StoreData) {
+  await mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(data, null, 2));
+  await rename(tmp, DATA_FILE);
+}
+
+/** Serializes read-modify-write operations so concurrent requests can't clobber each other. */
+function mutate<T>(fn: (data: StoreData) => T): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await load();
+    const result = fn(data);
+    await persist(data);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export async function getUser(username: string): Promise<PasskeyUser | undefined> {
+  return (await load()).users[username];
+}
+
+export function getOrCreateUser(username: string): Promise<PasskeyUser> {
+  return mutate((data) => {
+    data.users[username] ??= {
+      username,
+      webauthnUserId: randomBytes(32).toString('base64url'),
+      createdAt: new Date().toISOString(),
+    };
+    return data.users[username];
+  });
+}
+
+export async function getPasskey(id: string): Promise<StoredPasskey | undefined> {
+  return (await load()).passkeys[id];
+}
+
+export async function listPasskeys(username: string): Promise<StoredPasskey[]> {
+  const data = await load();
+  return Object.values(data.passkeys)
+    .filter((p) => p.username === username)
+    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+}
+
+export function addPasskey(passkey: StoredPasskey): Promise<void> {
+  return mutate((data) => {
+    data.passkeys[passkey.id] = passkey;
+  });
+}
+
+export function updatePasskey(
+  id: string,
+  username: string,
+  changes: Partial<Pick<StoredPasskey, 'name' | 'counter' | 'backedUp' | 'deviceType' | 'lastUsedAt'>>,
+): Promise<StoredPasskey | undefined> {
+  return mutate((data) => {
+    const passkey = data.passkeys[id];
+    if (!passkey || passkey.username !== username) return undefined;
+    Object.assign(passkey, changes);
+    return passkey;
+  });
+}
+
+export function deletePasskey(id: string, username: string): Promise<boolean> {
+  return mutate((data) => {
+    const passkey = data.passkeys[id];
+    if (!passkey || passkey.username !== username) return false;
+    delete data.passkeys[id];
+    return true;
+  });
+}
