+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { getSessionUser } from '../lib/auth/session';
+import { getUser, listPasskeys } from '../lib/auth/store';
+import { relyingParty, toPublicPasskey } from '../lib/auth/webauthn';
+
+const baseUrl = import.meta.env.BASE_URL;
+const sessionUser = await getSessionUser(Astro.session);
+if (!sessionUser) {
+  return Astro.redirect(`${baseUrl}signin?next=${encodeURIComponent(`${baseUrl}account`)}`);
+}
+
+const user = await getUser(sessionUser.username);
+const passkeys = (await listPasskeys(sessionUser.username)).map(toPublicPasskey);
+const { rpID } = relyingParty(Astro.url);
+---
+
+<Layout title="Account | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings
+      client:load
+      username={sessionUser.username}
+      rpID={rpID}
+      webauthnUserId={user?.webauthnUserId ?? null}
+      passkeys={passkeys}
+    />
+  </div>
+</Layout>
