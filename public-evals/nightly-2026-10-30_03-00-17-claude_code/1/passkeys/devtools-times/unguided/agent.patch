@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { errorResponse, json, requireUser } from '../../../../lib/auth/session';
+import { listPasskeys } from '../../../../lib/auth/store';
+import { relyingParty, saveChallenge } from '../../../../lib/auth/webauthn';
+
+/**
+ * Options for a passkey assertion. `purpose: 'signin'` asks for any discoverable
+ * passkey (button or autofill); `purpose: 'reauth'` limits the prompt to the
+ * signed-in user's passkeys.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const { purpose = 'signin' } = await request.json().catch(() => ({}));
+  if (purpose !== 'signin' && purpose !== 'reauth') {
+    return errorResponse(400, 'INVALID_REQUEST', 'Unknown purpose.');
+  }
+  if (!session) return errorResponse(500, 'NO_SESSION', 'Sessions are not available.');
+
+  const { rpID } = relyingParty(url);
+  let allowCredentials: { id: string; transports?: string[] }[] | undefined;
+
+  if (purpose === 'reauth') {
+    const auth = await requireUser(session);
+    if ('response' in auth) return auth.response;
+    const passkeys = await listPasskeys(auth.user.username);
+    if (passkeys.length === 0) {
+      return errorResponse(400, 'NO_PASSKEYS', 'You don’t have any passkeys yet.');
+    }
+    allowCredentials = passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials,
+    userVerification: purpose === 'reauth' ? 'required' : 'preferred',
+  });
+
+  saveChallenge(session, options.challenge, purpose);
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/authenticate-verify.ts b/src/pages/api/auth/passkeys/authenticate-verify.ts
new file mode 100644
index 0000000..8daf31e
--- /dev/null
+++ b/src/pages/api/auth/passkeys/authenticate-verify.ts
@@ -0,0 +1,69 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { errorResponse, json, markReauthenticated, requireUser, signIn } from '../../../../lib/auth/session';
+import { getPasskey, updatePasskey } from '../../../../lib/auth/store';
+import { consumeChallenge, relyingParty, toWebAuthnCredential } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return errorResponse(500, 'NO_SESSION', 'Sessions are not available.');
+
+  const body = await request.json().catch(() => null);
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  const expectedChallenge = await consumeChallenge(session, purpose);
+  if (!body?.response || !expectedChallenge) {
+    return errorResponse(400, 'CHALLENGE_EXPIRED', 'The passkey request expired. Please try again.');
+  }
+
+  const passkey = await getPasskey(body.response.id);
+  if (!passkey) {
+    // The client uses this code to signal the authenticator to hide the stale passkey.
+    return errorResponse(404, 'UNKNOWN_CREDENTIAL', 'This passkey isn’t registered with The DevTools Times anymore.');
+  }
+  const userHandle = body.response.response?.userHandle;
+  if (userHandle && userHandle !== passkey.webauthnUserId) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'Passkey could not be verified.');
+  }
+
+  let currentUser = null;
+  if (purpose === 'reauth') {
+    const auth = await requireUser(session);
+    if ('response' in auth) return auth.response;
+    if (passkey.username !== auth.user.username) {
+      return errorResponse(403, 'WRONG_ACCOUNT', 'That passkey belongs to a different account.');
+    }
+    currentUser = auth.user;
+  }
+
+  const { rpID, origin } = relyingParty(url);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body.response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: toWebAuthnCredential(passkey),
+      requireUserVerification: purpose === 'reauth',
+    });
+  } catch (err) {
+    return errorResponse(400, 'VERIFICATION_FAILED', `Passkey could not be verified: ${(err as Error).message}`);
+  }
+  if (!verification.verified) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'Passkey could not be verified.');
+  }
+
+  const { newCounter, credentialBackedUp, credentialDeviceType } = verification.authenticationInfo;
+  await updatePasskey(passkey.id, passkey.username, {
+    counter: newCounter,
+    backedUp: credentialBackedUp,
+    deviceType: credentialDeviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (currentUser) {
+    markReauthenticated(session, currentUser, 'passkey');
+  } else {
+    await signIn(session, passkey.username, 'passkey');
+  }
+  return json({ username: passkey.username });
+};
