@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { json, requireUser } from '../../../../lib/auth/session';
+import { getOrCreateUser, listPasskeys } from '../../../../lib/auth/store';
+import { RP_NAME, relyingParty, saveChallenge } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  // Adding a sign-in method is sensitive, so require a recent sign-in.
+  const auth = await requireUser(session, { recent: true });
+  if ('response' in auth) return auth.response;
+
+  const { rpID } = relyingParty(url);
+  const user = await getOrCreateUser(auth.user.username);
+  const existing = await listPasskeys(user.username);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: user.username,
+    userDisplayName: user.username,
+    userID: new Uint8Array(Buffer.from(user.webauthnUserId, 'base64url')),
+    attestationType: 'none',
+    // Stop the same authenticator from registering twice.
+    excludeCredentials: existing.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+
+  saveChallenge(auth.session, options.challenge, 'register');
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/register-verify.ts b/src/pages/api/auth/passkeys/register-verify.ts
new file mode 100644
index 0000000..7790795
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register-verify.ts
@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { errorResponse, json, requireUser } from '../../../../lib/auth/session';
+import { addPasskey, getPasskey, getUser } from '../../../../lib/auth/store';
+import { consumeChallenge, defaultPasskeyName, relyingParty, toPublicPasskey } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const auth = await requireUser(session, { recent: true });
+  if ('response' in auth) return auth.response;
+
+  const body = await request.json().catch(() => null);
+  const expectedChallenge = await consumeChallenge(auth.session, 'register');
+  const user = await getUser(auth.user.username);
+  if (!body?.response || !expectedChallenge || !user) {
+    return errorResponse(400, 'CHALLENGE_EXPIRED', 'The passkey request expired. Please try again.');
+  }
+
+  const { rpID, origin } = relyingParty(url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return errorResponse(400, 'VERIFICATION_FAILED', `Passkey could not be verified: ${(err as Error).message}`);
+  }
+  if (!verification.verified) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'Passkey could not be verified.');
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await getPasskey(credential.id)) {
+    return errorResponse(409, 'ALREADY_REGISTERED', 'This passkey is already registered.');
+  }
+
+  const passkey = {
+    id: credential.id,
+    username: user.username,
+    webauthnUserId: user.webauthnUserId,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    aaguid,
+    name: defaultPasskeyName(aaguid, credentialDeviceType),
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+  await addPasskey(passkey);
+
+  return json({ passkey: toPublicPasskey(passkey) });
+};
diff --git a/src/pages/api/auth/reauth.ts b/src/pages/api/auth/reauth.ts
new file mode 100644
index 0000000..40dca1e
--- /dev/null
+++ b/src/pages/api/auth/reauth.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { errorResponse, json, markReauthenticated, requireUser } from '../../../lib/auth/session';
+import { verifyPassword } from '../../../lib/auth/times-api';
+
+/** Password fallback for reauthentication. Passkey reauth goes through passkeys/authenticate-*. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const auth = await requireUser(session);
+  if ('response' in auth) return auth.response;
+
+  const { password } = await request.json().catch(() => ({}));
+  if (typeof password !== 'string' || !password) {
+    return errorResponse(400, 'INVALID_REQUEST', 'Password is required.');
+  }
+
+  const result = await verifyPassword(auth.user.username, password);
+  if (!result.ok) {
+    return errorResponse(401, 'INVALID_PASSWORD', `Verification failed: ${result.data.error || 'Unknown error'}`);
+  }
+
+  markReauthenticated(auth.session, auth.user, 'password');
+  return json({ ok: true });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
