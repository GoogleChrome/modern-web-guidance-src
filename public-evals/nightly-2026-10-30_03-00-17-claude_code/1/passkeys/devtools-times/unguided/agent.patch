+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,326 @@
+import React, { useEffect, useRef, useState } from 'react';
+import {
+  ArrowRightStartOnRectangleIcon,
+  CheckIcon,
+  CloudIcon,
+  KeyIcon,
+  PencilIcon,
+  PlusIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import ReauthDialog from './ReauthDialog';
+import {
+  PasskeyCancelledError,
+  api,
+  createPasskey,
+  isReauthRequired,
+  passkeysSupported,
+  syncPasskeySignals,
+  type PublicPasskey,
+} from '../lib/auth/client';
+
+interface Props {
+  username: string;
+  rpID: string;
+  webauthnUserId: string | null;
+  passkeys: PublicPasskey[];
+}
+
+const formatDate = (iso: string) =>
+  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function AccountSettings({ username, rpID, ...initial }: Props) {
+  const [passkeys, setPasskeys] = useState(initial.passkeys);
+  const [webauthnUserId, setWebauthnUserId] = useState(initial.webauthnUserId);
+  const [supportsPasskeys, setSupportsPasskeys] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const pendingAction = useRef<(() => Promise<void>) | null>(null);
+
+  useEffect(() => {
+    setSupportsPasskeys(passkeysSupported());
+  }, []);
+
+  // Tell passkey providers which passkeys are still valid and the current account name.
+  useEffect(() => {
+    if (webauthnUserId && passkeysSupported()) {
+      syncPasskeySignals(rpID, webauthnUserId, username, passkeys.map((p) => p.id));
+    }
+  }, [webauthnUserId, passkeys]);
+
+  const showError = (err: unknown, prefix: string) => {
+    if (err instanceof PasskeyCancelledError) return;
+    setError(`${prefix}: ${(err as Error).message}`);
+  };
+
+  /** Runs a sensitive action, asking the user to reauthenticate first if the server requires it. */
+  const withReauth = async (action: () => Promise<void>, errorPrefix: string) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await action();
+    } catch (err) {
+      if (isReauthRequired(err)) {
+        pendingAction.current = async () => {
+          try {
+            await action();
+          } catch (retryErr) {
+            showError(retryErr, errorPrefix);
+          }
+        };
+        setReauthOpen(true);
+      } else {
+        showError(err, errorPrefix);
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleReauthSuccess = async () => {
+    setReauthOpen(false);
+    const action = pendingAction.current;
+    pendingAction.current = null;
+    if (action) {
+      setBusy(true);
+      await action();
+      setBusy(false);
+    }
+  };
+
+  const handleReauthCancel = () => {
+    setReauthOpen(false);
+    pendingAction.current = null;
+  };
+
+  const handleCreate = () =>
+    withReauth(async () => {
+      const passkey = await createPasskey();
+      if (!webauthnUserId) {
+        // The user handle is assigned with the first passkey.
+        const data = await api<{ webauthnUserId: string }>('passkeys');
+        setWebauthnUserId(data.webauthnUserId);
+      }
+      setPasskeys((current) => [...current, passkey]);
+      setNotice(`Passkey “${passkey.name}” created.`);
+    }, 'Couldn’t create a passkey');
+
+  const handleDelete = (passkey: PublicPasskey) =>
+    withReauth(async () => {
+      await api(`passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+      setPasskeys((current) => current.filter((p) => p.id !== passkey.id));
+      setConfirmDeleteId(null);
+      setNotice(`Passkey “${passkey.name}” deleted.`);
+    }, 'Couldn’t delete the passkey');
+
+  const startRename = (passkey: PublicPasskey) => {
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    setError(null);
+    setNotice(null);
+    try {
+      const { passkey } = await api<{ passkey: PublicPasskey }>(`passkeys/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        body: { name: editName },
+      });
+      setPasskeys((current) => current.map((p) => (p.id === id ? passkey : p)));
+      setEditingId(null);
+    } catch (err) {
+      showError(err, 'Couldn’t rename the passkey');
+    }
+  };
+
+  const handleSignOut = async () => {
+    await api('logout', { body: {} }).catch(() => {});
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-center justify-between gap-4">
+          <div>
+            <h2 className="text-2xl font-bold text-gray-800">Account</h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Signed in as <span className="font-semibold text-gray-900">{username}</span>
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={handleSignOut}
+            className="flex items-center gap-2 py-2 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-300"
+          >
+            <ArrowRightStartOnRectangleIcon className="h-5 w-5" aria-hidden="true" />
+            Sign out
+          </button>
+        </div>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <div className="flex items-start justify-between gap-4 mb-2">
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+            Passkeys
+          </h2>
+          {supportsPasskeys && (
+            <button
+              type="button"
+              onClick={handleCreate}
+              disabled={busy}
+              className={`flex items-center gap-2 py-2 px-3 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+                busy ? 'opacity-75 cursor-not-allowed' : ''
+              }`}
+            >
+              <PlusIcon className="h-5 w-5" aria-hidden="true" />
+              Create a passkey
+            </button>
+          )}
+        </div>
+        <p className="text-sm text-gray-600 mb-6">
+          Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password. You can still
+          sign in with your password at any time.
+        </p>
+
+        {!supportsPasskeys && (
+          <div className="mb-4 p-3 text-sm text-yellow-800 bg-yellow-100 rounded-lg" role="status">
+            This browser doesn’t support passkeys.
+          </div>
+        )}
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {notice && (
+          <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            {notice}
+          </div>
+        )}
+
+        {passkeys.length === 0 ? (
+          <div className="py-8 text-center border border-dashed border-gray-300 rounded-lg">
+            <KeyIcon className="h-8 w-8 mx-auto text-gray-400 mb-2" aria-hidden="true" />
+            <p className="text-sm text-gray-600">You haven’t created any passkeys yet.</p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="p-4">
+                {editingId === passkey.id ? (
+                  <form onSubmit={(e) => handleRename(e, passkey.id)} className="flex items-center gap-2">
+                    <label htmlFor={`name-${passkey.id}`} className="sr-only">
+                      Passkey name
+                    </label>
+                    <input
+                      id={`name-${passkey.id}`}
+                      value={editName}
+                      onChange={(e) => setEditName(e.target.value)}
+                      maxLength={64}
+                      required
+                      autoFocus
+                      className="flex-grow px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                    />
+                    <button type="submit" className="p-2 rounded-md text-gray-700 hover:bg-gray-100" aria-label="Save name">
+                      <CheckIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setEditingId(null)}
+                      className="p-2 rounded-md text-gray-700 hover:bg-gray-100"
+                      aria-label="Cancel renaming"
+                    >
+                      <XMarkIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                  </form>
+                ) : (
+                  <div className="flex items-center gap-4">
+                    <KeyIcon className="h-6 w-6 flex-shrink-0 text-gray-500" aria-hidden="true" />
+                    <div className="flex-grow min-w-0">
+                      <p className="font-medium text-gray-900 truncate">
+                        {passkey.name}
+                        {passkey.synced && (
+                          <span className="ml-2 inline-flex items-center gap-1 align-middle rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
+                            <CloudIcon className="h-3.5 w-3.5" aria-hidden="true" />
+                            Synced
+                          </span>
+                        )}
+                      </p>
+                      <p className="text-xs text-gray-500 mt-0.5">
+                        {passkey.provider && passkey.provider !== passkey.name && `${passkey.provider} · `}
+                        Created {formatDate(passkey.createdAt)} ·{' '}
+                        {passkey.lastUsedAt ? `Last used ${formatDate(passkey.lastUsedAt)}` : 'Never used'}
+                      </p>
+                    </div>
+                    {confirmDeleteId === passkey.id ? (
+                      <div className="flex items-center gap-2">
+                        <button
+                          type="button"
+                          onClick={() => handleDelete(passkey)}
+                          disabled={busy}
+                          className="py-1.5 px-3 rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600"
+                        >
+                          Delete
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setConfirmDeleteId(null)}
+                          className="py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    ) : (
+                      <div className="flex items-center gap-1">
+                        <button
+                          type="button"
+                          onClick={() => startRename(passkey)}
+                          className="p-2 rounded-md text-gray-600 hover:bg-gray-100"
+                          aria-label={`Rename ${passkey.name}`}
+                        >
+                          <PencilIcon className="h-5 w-5" aria-hidden="true" />
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            setEditingId(null);
+                            setConfirmDeleteId(passkey.id);
+                          }}
+                          className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-red-600"
+                          aria-label={`Delete ${passkey.name}`}
+                        >
+                          <TrashIcon className="h-5 w-5" aria-hidden="true" />
+                        </button>
+                      </div>
+                    )}
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {reauthOpen && (
+        <ReauthDialog
+          username={username}
+          hasPasskeys={supportsPasskeys && passkeys.length > 0}
+          onSuccess={handleReauthSuccess}
+          onCancel={handleReauthCancel}
+        />
+      )}
+    </div>
+  );
+}
