+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,21 @@
+import type { APIRoute } from 'astro';
+import { errorResponse, json, signIn } from '../../../lib/auth/session';
+import { registerAccount } from '../../../lib/auth/times-api';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return errorResponse(400, 'INVALID_REQUEST', 'Username and password are required.');
+  }
+  if (!session) return errorResponse(500, 'NO_SESSION', 'Sessions are not available.');
+
+  const result = await registerAccount(username, password);
+  if (!result.ok) {
+    // Pass the Times API error (e.g. APP_ERR_1001) straight through.
+    return json(result.data, result.status);
+  }
+
+  // Sign the new user in right away so they can add a passkey without re-entering their password.
+  await signIn(session, username, 'password');
+  return json({ username });
+};
