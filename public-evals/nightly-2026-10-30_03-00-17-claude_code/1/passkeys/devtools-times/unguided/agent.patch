@@ -0,0 +1,21 @@
+const TIMES_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface TimesApiResult {
+  ok: boolean;
+  status: number;
+  data: { error?: string; [key: string]: unknown };
+}
+
+/** Calls the external Times account API, which remains the source of truth for passwords. */
+async function call(endpoint: 'login' | 'register', username: string, password: string): Promise<TimesApiResult> {
+  const response = await fetch(`${TIMES_API}/${endpoint}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, status: response.status, data };
+}
+
+export const verifyPassword = (username: string, password: string) => call('login', username, password);
+export const registerAccount = (username: string, password: string) => call('register', username, password);
diff --git a/src/lib/auth/webauthn.ts b/src/lib/auth/webauthn.ts
new file mode 100644
index 0000000..21075da
--- /dev/null
+++ b/src/lib/auth/webauthn.ts
@@ -0,0 +1,65 @@
+import type { APIContext } from 'astro';
+import type { StoredPasskey } from './store';
+import { providerName } from './aaguids';
+
+export const RP_NAME = 'The DevTools Times';
+
+type Session = NonNullable<APIContext['session']>;
+
+export type CeremonyPurpose = 'register' | 'signin' | 'reauth';
+
+interface PendingChallenge {
+  challenge: string;
+  purpose: CeremonyPurpose;
+  expiresAt: number;
+}
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+/** The RP ID and origin default to the host serving the request; override via env for proxied deployments. */
+export function relyingParty(url: URL) {
+  return {
+    rpID: process.env.WEBAUTHN_RP_ID || url.hostname,
+    origin: process.env.WEBAUTHN_ORIGIN || url.origin,
+  };
+}
+
+export function saveChallenge(session: Session, challenge: string, purpose: CeremonyPurpose) {
+  const pending: PendingChallenge = { challenge, purpose, expiresAt: Date.now() + CHALLENGE_TTL_MS };
+  session.set('webauthnChallenge', pending);
+}
+
+/** Returns the pending challenge for `purpose` and clears it so it can only be used once. */
+export async function consumeChallenge(session: Session, purpose: CeremonyPurpose): Promise<string | null> {
+  const pending = (await session.get('webauthnChallenge')) as PendingChallenge | undefined;
+  session.delete('webauthnChallenge');
+  if (!pending || pending.purpose !== purpose || pending.expiresAt < Date.now()) return null;
+  return pending.challenge;
+}
+
+export function toWebAuthnCredential(passkey: StoredPasskey) {
+  return {
+    id: passkey.id,
+    publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64url')),
+    counter: passkey.counter,
+    transports: passkey.transports,
+  };
+}
+
+export function defaultPasskeyName(aaguid: string, deviceType: StoredPasskey['deviceType']): string {
+  return providerName(aaguid) ?? (deviceType === 'multiDevice' ? 'Synced passkey' : 'Passkey');
+}
+
+/** The subset of passkey data that is safe to send to the browser. */
+export function toPublicPasskey(passkey: StoredPasskey) {
+  return {
+    id: passkey.id,
+    name: passkey.name,
+    provider: providerName(passkey.aaguid),
+    synced: passkey.backedUp,
+    createdAt: passkey.createdAt,
+    lastUsedAt: passkey.lastUsedAt,
+  };
+}
+
+export type PublicPasskey = ReturnType<typeof toPublicPasskey>;
