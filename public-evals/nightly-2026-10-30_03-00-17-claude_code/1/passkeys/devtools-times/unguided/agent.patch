new file mode 100644
index 0000000..bbaafc3
--- /dev/null
+++ b/src/components/PasskeyUpsell.tsx
@@ -0,0 +1,89 @@
+import React, { useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import { PasskeyCancelledError, createPasskey } from '../lib/auth/client';
+
+interface Props {
+  title: string;
+  description?: string;
+  onDone: () => void;
+  /** Skip straight to the confirmation, e.g. after the browser created a passkey automatically. */
+  initiallyCreated?: boolean;
+}
+
+/** Offers to create a passkey right after a password sign-in or sign-up. */
+export default function PasskeyUpsell({ title, description, onDone, initiallyCreated = false }: Props) {
+  const [error, setError] = useState<string | null>(null);
+  const [created, setCreated] = useState(initiallyCreated);
+  const [loading, setLoading] = useState(false);
+
+  const handleCreate = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      await createPasskey();
+      setCreated(true);
+    } catch (err) {
+      if (!(err instanceof PasskeyCancelledError)) {
+        setError(`Couldn’t create a passkey: ${(err as Error).message}`);
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  if (created) {
+    return (
+      <div className="text-center">
+        <KeyIcon className="h-10 w-10 mx-auto text-green-700 mb-3" aria-hidden="true" />
+        <h3 className="text-lg font-semibold text-gray-800 mb-2">Passkey created</h3>
+        <p className="text-sm text-gray-600 mb-6">
+          {(initiallyCreated && description) || 'Next time, sign in with your fingerprint, face, or screen lock.'}
+        </p>
+        <button
+          type="button"
+          onClick={onDone}
+          className="w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+        >
+          Continue
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="text-center">
+      <KeyIcon className="h-10 w-10 mx-auto text-gray-700 mb-3" aria-hidden="true" />
+      <h3 className="text-lg font-semibold text-gray-800 mb-2">{title}</h3>
+      <p className="text-sm text-gray-600 mb-6">
+        {description ??
+          'Passkeys let you sign in with your fingerprint, face, or screen lock. They’re safer than passwords and can’t be phished.'}
+      </p>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg text-left" role="alert">
+          {error}
+        </div>
+      )}
+
+      <div className="space-y-2">
+        <button
+          type="button"
+          onClick={handleCreate}
+          disabled={loading}
+          className={`w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            loading ? 'opacity-75 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Creating passkey...' : 'Create a passkey'}
+        </button>
+        <button
+          type="button"
+          onClick={onDone}
+          className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-300"
+        >
+          Not now
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
