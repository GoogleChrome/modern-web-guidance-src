+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import { errors, json, storeChallenge } from '../../../../lib/auth/session';
+
+// Discoverable sign-in: no allowCredentials, the passkey provider offers the accounts.
+export const POST: APIRoute = async ({ session, url }) => {
+  const rp = getRelyingParty(url);
+  if (!rp) return errors.unsupportedHost();
+  if (!session) return errors.badRequest('Sessions are unavailable.');
+
+  const options = await generateAuthenticationOptions({
+    rpID: rp.rpID,
+    allowCredentials: [],
+    userVerification: 'preferred',
+  });
+  storeChallenge(session, 'login', { challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
