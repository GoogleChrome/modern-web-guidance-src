diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
new file mode 100644
index 0000000..75a525c
--- /dev/null
+++ b/src/components/ReauthDialog.tsx
@@ -0,0 +1,161 @@
+import React, { forwardRef, useId, useImperativeHandle, useRef, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import { api, ApiError, getPasskey } from '../lib/passkeys-client';
+
+export interface ReauthDialogHandle {
+  // Opens the dialog and resolves to true once the user has re-verified, false if dismissed.
+  verify(): Promise<boolean>;
+}
+
+interface Props {
+  username: string;
+  hasPasskeys: boolean;
+}
+
+// Asks a signed-in user to confirm their identity before a sensitive change, using one of
+// their passkeys or, if they have none (or prefer it), their password.
+const ReauthDialog = forwardRef<ReauthDialogHandle, Props>(function ReauthDialog({ username, hasPasskeys }, ref) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const resolver = useRef<((verified: boolean) => void) | null>(null);
+  const [usePassword, setUsePassword] = useState(false);
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const titleId = useId();
+  const passwordId = useId();
+
+  const showPasswordForm = usePassword || !hasPasskeys;
+
+  useImperativeHandle(ref, () => ({
+    verify() {
+      setError(null);
+      setPassword('');
+      setUsePassword(false);
+      dialogRef.current?.showModal();
+      return new Promise<boolean>((resolve) => {
+        resolver.current = resolve;
+      });
+    },
+  }));
+
+  const finish = (verified: boolean) => {
+    resolver.current?.(verified);
+    resolver.current = null;
+    dialogRef.current?.close();
+  };
+
+  const handlePasskey = async () => {
+    setError(null);
+    setLoading(true);
+    const result = await getPasskey('reauth');
+    setLoading(false);
+    if (result.status === 'ok') finish(true);
+    else if (result.status === 'error') setError(result.message);
+  };
+
+  const handlePassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      await api('auth/reauth/password', { body: { password } });
+      finish(true);
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'Something went wrong. Please try again.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={titleId}
+      // Escape key or the Cancel button both land here.
+      onClose={() => finish(false)}
+      className="m-auto w-full max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+    >
+      <h2 id={titleId} className="text-lg font-bold text-gray-800">
+        Confirm it’s you
+      </h2>
+      <p className="mt-2 text-sm text-gray-600">
+        For your security, please verify your identity before making this change.
+      </p>
+
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {showPasswordForm ? (
+        <form onSubmit={handlePassword} className="mt-4 space-y-4">
+          {/* Lets password managers match the saved credential for this account. */}
+          <input type="text" name="username" autoComplete="username" value={username} hidden readOnly />
+          <div>
+            <label htmlFor={passwordId} className="block text-sm font-medium text-gray-700 mb-1">
+              Password
+            </label>
+            <input
+              type="password"
+              id={passwordId}
+              name="password"
+              autoComplete="current-password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+              autoFocus
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={loading}
+            className="w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+          >
+            {loading ? 'Verifying...' : 'Verify with password'}
+          </button>
