diff --git a/src/pages/api/auth/credentials/[id].ts b/src/pages/api/auth/credentials/[id].ts
new file mode 100644
index 0000000..eef15c7
--- /dev/null
+++ b/src/pages/api/auth/credentials/[id].ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { errors, getSessionUser, isRecentlyVerified, json, readJson, toPasskeySummary } from '../../../../lib/auth/session';
+import { deleteCredential, findCredentialById, findCredentialsByUserId, saveCredential } from '../../../../lib/auth/store';
+
+async function findOwnCredential(id: string | undefined, userId: string) {
+  const credential = id ? await findCredentialById(id) : undefined;
+  return credential?.passkeyUserId === userId ? credential : undefined;
+}
+
+const notFound = () => json({ error: 'Passkey not found.', code: 'not_found' }, 404);
+
+// Renaming is a server-side label only; it isn't synced to passkey providers.
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errors.unauthenticated();
+  const credential = await findOwnCredential(params.id, user.id);
+  if (!credential) return notFound();
+
+  const body = await readJson<{ name?: unknown }>(request);
+  const name = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (!name || name.length > 64) return errors.badRequest('Name must be between 1 and 64 characters.');
+
+  credential.name = name;
+  await saveCredential(credential);
+  return json(toPasskeySummary(credential));
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errors.unauthenticated();
+  if (!(await isRecentlyVerified(session))) return errors.reauthRequired();
+  const credential = await findOwnCredential(params.id, user.id);
+  if (!credential) return notFound();
+
+  await deleteCredential(credential.id);
+  const remaining = await findCredentialsByUserId(user.id);
+  return json({ credentials: remaining.map(toPasskeySummary) });
+};
diff --git a/src/pages/api/auth/credentials/index.ts b/src/pages/api/auth/credentials/index.ts
