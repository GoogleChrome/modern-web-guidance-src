@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { getRelyingParty, RP_NAME } from '../../../../lib/auth/config';
+import { errors, getSessionUser, isRecentlyVerified, json, readJson, storeChallenge } from '../../../../lib/auth/session';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+
+// `promotion`: offered after sign-in/sign-up, so restrict to the platform authenticator.
+// `conditional`: silent creation right after a password sign-in (Conditional Create).
+// Neither: the account settings page, where security keys are allowed too.
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return errors.unauthenticated();
+  const rp = getRelyingParty(url);
+  if (!rp) return errors.unsupportedHost();
+  if (!(await isRecentlyVerified(session))) return errors.reauthRequired();
+
+  const body = (await readJson<{ promotion?: boolean; conditional?: boolean }>(request)) ?? {};
+  const conditional = body.conditional === true;
+  const platformOnly = conditional || body.promotion === true;
+
+  const existing = await findCredentialsByUserId(user.id);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: rp.rpID,
+    userID: new Uint8Array(Buffer.from(user.id, 'base64url')),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map((cred) => ({ id: cred.id, transports: cred.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(platformOnly && { authenticatorAttachment: 'platform' }),
+    },
+  });
+
+  storeChallenge(session, 'register', {
+    challenge: options.challenge,
+    userVerification: 'preferred',
+    conditional,
+  });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/register-verify.ts b/src/pages/api/auth/passkey/register-verify.ts
new file mode 100644
index 0000000..f3259ab
--- /dev/null
+++ b/src/pages/api/auth/passkey/register-verify.ts
@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { describeAuthenticator } from '../../../../lib/auth/aaguid';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import { consumeChallenge, errors, getSessionUser, json, readJson, toPasskeySummary } from '../../../../lib/auth/session';
+import { findCredentialById, saveCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errors.unauthenticated();
+  const rp = getRelyingParty(url);
+  if (!rp) return errors.unsupportedHost();
+
+  const response = await readJson<RegistrationResponseJSON>(request);
+  const pending = await consumeChallenge(session, 'register');
+  if (!response?.id || !pending) return errors.badRequest('Passkey registration expired. Please try again.');
+
+  let registrationInfo;
+  try {
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: rp.origins,
+      expectedRPID: rp.rpID,
+      // Options asked for UV as "preferred", so authenticators without UV must still pass.
+      requireUserVerification: false,
+      // Conditional Create happens without a user gesture; explicit creation must prove presence.
+      requireUserPresence: !pending.conditional,
+    });
+    if (!verification.verified) throw new Error('Attestation could not be verified');
+    registrationInfo = verification.registrationInfo;
+  } catch (err) {
+    console.error('Passkey registration verification failed:', err);
+    return json({ error: 'We couldn’t verify your new passkey.', code: 'verification_failed' }, 400);
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = registrationInfo;
+  if (await findCredentialById(credential.id)) {
+    return json({ error: 'This passkey is already registered.', code: 'duplicate_credential' }, 409);
+  }
+
+  const provider = await describeAuthenticator(aaguid, request.headers.get('User-Agent'));
+  const stored = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key' as const,
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: credential.transports ?? response.response.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await saveCredential(stored);
+  return json(toPasskeySummary(stored));
+};
