@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import { verifyPasskeyAssertion } from '../../../../lib/auth/passkeys';
+import { consumeChallenge, errors, getSessionUser, json, markVerified, readJson } from '../../../../lib/auth/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return errors.unauthenticated();
+  const rp = getRelyingParty(url);
+  if (!rp) return errors.unsupportedHost();
+
+  const response = await readJson<AuthenticationResponseJSON>(request);
+  const pending = await consumeChallenge(session, 'reauth');
+  if (!response?.id || !pending) return errors.badRequest('Verification expired. Please try again.');
+
+  const result = await verifyPasskeyAssertion(response, pending, rp);
+  if (!result.ok) return json({ error: result.error, code: result.code }, result.status);
+
+  // A valid passkey that belongs to someone else must never verify this session.
+  if (result.credential.passkeyUserId !== user.id) {
+    return json({ error: 'That passkey belongs to a different account.', code: 'wrong_account' }, 403);
+  }
+
+  markVerified(session);
+  return json({ ok: true });
+};
