diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..02e2a1e
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,370 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { navigate } from 'astro:transitions/client';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import ReauthDialog, { type ReauthDialogHandle } from './ReauthDialog';
+import {
+  api,
+  ApiError,
+  canCreatePasskeys,
+  createPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  type PasskeySummary,
+} from '../lib/passkeys-client';
+
+interface Props {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+interface CredentialList {
+  rpId: string | null;
+  userId: string;
+  credentials: PasskeySummary[];
+}
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const formatDate = (epoch: number) => dateFormat.format(new Date(epoch));
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+const primaryButton =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const secondaryButton =
+  'inline-flex items-center justify-center gap-1 py-1.5 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-75';
+
+export default function AccountSettings({ userId, username, displayName: initialDisplayName }: Props) {
+  const [rpId, setRpId] = useState<string | null>(null);
+  const [passkeys, setPasskeys] = useState<PasskeySummary[] | null>(null);
+  const [canCreate, setCanCreate] = useState<boolean | null>(null);
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [savedDisplayName, setSavedDisplayName] = useState(initialDisplayName);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editingName, setEditingName] = useState('');
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const reauthDialog = useRef<ReauthDialogHandle>(null);
+
+  // Keeps the user's password managers in step with the passkeys the server still accepts.
+  const applyCredentialList = (list: PasskeySummary[], signalRpId = rpId) => {
+    setPasskeys(list);
+    signalAllAcceptedCredentials(signalRpId, userId, list.map((p) => p.id));
+  };
+
+  useEffect(() => {
+    api<CredentialList>('auth/credentials')
+      .then((data) => {
+        setRpId(data.rpId);
+        applyCredentialList(data.credentials, data.rpId);
+      })
+      .catch((err) => setError(err instanceof ApiError ? err.message : 'Couldn’t load your passkeys.'));
+    canCreatePasskeys().then(setCanCreate);
+  }, []);
+
+  const startAction = (name: string) => {
+    setBusy(name);
+    setError(null);
+    setNotice(null);
+  };
+
+  // Runs a sensitive action; if the server wants fresh verification, asks for it and retries once.
+  async function withReauth<T>(action: () => Promise<T>): Promise<T | undefined> {
+    try {
+      return await action();
+    } catch (err) {
+      if (!(err instanceof ApiError && err.code === 'reauth_required')) throw err;
+      if (!(await reauthDialog.current?.verify())) return undefined;
+      return action();
+    }
+  }
+
+  const reportError = (err: unknown) =>
+    setError(err instanceof ApiError ? err.message : 'Something went wrong. Please try again.');
+
+  const handleCreatePasskey = async () => {
+    startAction('create');
+    try {
+      // createPasskey reports failures as results; rethrow reauth so withReauth can handle it.
+      const result = await withReauth(async () => {
+        const result = await createPasskey();
+        if (result.status === 'error' && result.code === 'reauth_required') {
+          throw new ApiError(result.message, 403, result.code);
+        }
+        return result;
+      });
+      if (result?.status === 'ok') {
+        setPasskeys((list) => [result.value, ...(list ?? [])]);
+        setNotice(`Passkey “${result.value.name}” created.`);
+      } else if (result?.status === 'error') {
+        setError(result.message);
+      }
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleRename = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    startAction(`rename:${id}`);
+    try {
+      const updated = await api<PasskeySummary>(`auth/credentials/${encodeURIComponent(id)}`, {
+        method: 'PUT',
+        body: { name: editingName },
+      });
+      setPasskeys((list) => list?.map((p) => (p.id === id ? updated : p)) ?? null);
+      setEditingId(null);
+      setNotice('Passkey renamed.');
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleDelete = async (passkey: PasskeySummary) => {
+    startAction(`delete:${passkey.id}`);
+    try {
+      const result = await withReauth(() =>
+        api<{ credentials: PasskeySummary[] }>(`auth/credentials/${encodeURIComponent(passkey.id)}`, {
+          method: 'DELETE',
+        }),
+      );
+      if (result) {
+        applyCredentialList(result.credentials);
+        setConfirmDeleteId(null);
+        setNotice(
+          `Passkey “${passkey.name}” deleted. You may also want to remove it from your password manager.`,
+        );
+      }
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleProfileSave = async (e: React.FormEvent) => {
+    e.preventDefault();
+    startAction('profile');
+    try {
+      const result = await withReauth(() =>
+        api<{ displayName: string }>('auth/user', { method: 'PUT', body: { displayName } }),
+      );
+      if (result) {
+        setDisplayName(result.displayName);
+        setSavedDisplayName(result.displayName);
+        // Updates the name shown for this account in passkey pickers.
+        signalCurrentUserDetails(rpId, { userId, name: username, displayName: result.displayName });
+        setNotice('Display name updated.');
+      }
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleSignOut = async () => {
+    startAction('signout');
+    try {
+      await api('auth/logout', { body: {} });
+      navigate(import.meta.env.BASE_URL);
+    } catch (err) {
+      reportError(err);
+      setBusy(null);
+    }
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-center justify-between gap-4">
+        <h1 className="text-3xl font-bold text-gray-800">Account settings</h1>
+        <button type="button" onClick={handleSignOut} disabled={busy === 'signout'} className={secondaryButton}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && (
+          <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            {notice}
+          </div>
+        )}
+      </div>
+
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-800">
+          Profile
+        </h2>
+        <form onSubmit={handleProfileSave} className="mt-4 space-y-4">
+          <div>
+            <span className="block text-sm font-medium text-gray-700 mb-1">Username</span>
+            <p className="text-gray-900">{username}</p>
+          </div>
+          <div>
+            <label htmlFor="display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="display-name"
+              name="display-name"
+              autoComplete="nickname"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              className={inputClass}
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={busy === 'profile' || displayName.trim() === savedDisplayName}
+            className={primaryButton}
+          >
+            {busy === 'profile' ? 'Saving...' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+              Passkeys
+            </h2>
+            <p className="mt-1 text-sm text-gray-600">
+              Sign in with your fingerprint, face, screen lock, or security key instead of your password.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreatePasskey} disabled={busy === 'create'} className={primaryButton}>
+              <KeyIcon className="h-5 w-5" aria-hidden="true" />
+              {busy === 'create' ? 'Creating...' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {canCreate === false && (
+          <p className="mt-4 p-3 text-sm text-gray-700 bg-gray-100 rounded-lg">
+            This browser or device can’t create passkeys. You can keep signing in with your password, or add a
+            passkey from another device.
+          </p>
+        )}
+
+        {passkeys === null ? (
+          <p className="mt-6 text-sm text-gray-500">Loading passkeys...</p>
+        ) : passkeys.length === 0 ? (
+          <p className="mt-6 text-sm text-gray-500">No passkeys found. Create one to sign in without a password.</p>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-y border-gray-200">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="py-4 flex flex-wrap items-center gap-4">
+                {passkey.providerIcon?.light ? (
+                  <img src={passkey.providerIcon.light} alt="" width={32} height={32} className="h-8 w-8" />
+                ) : (
+                  <KeyIcon className="h-8 w-8 text-gray-500" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-48">
+                  {editingId === passkey.id ? (
+                    <form onSubmit={(e) => handleRename(e, passkey.id)} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${passkey.id}`}
+                        value={editingName}
+                        onChange={(e) => setEditingName(e.target.value)}
+                        required
+                        maxLength={64}
+                        autoFocus
+                        autoComplete="off"
+                        className={`${inputClass} flex-1 min-w-40`}
+                      />
+                      <button type="submit" disabled={busy === `rename:${passkey.id}`} className={primaryButton}>
+                        Save
+                      </button>
+                      <button type="button" onClick={() => setEditingId(null)} className={secondaryButton}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900">
+                        {passkey.name}
+                        {passkey.backedUp && (
+                          <span className="ml-2 align-middle rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-600">
+                            Synced
+                          </span>
+                        )}
+                      </p>
+                      <p className="text-xs text-gray-500">
+                        Created {formatDate(passkey.registeredAt)}
+                        {' · '}
+                        {passkey.lastUsedAt ? `Last used ${formatDate(passkey.lastUsedAt)}` : 'Never used'}
+                      </p>
+                    </>
+                  )}
+                </div>
+
+                {editingId !== passkey.id &&
+                  (confirmDeleteId === passkey.id ? (
+                    <div className="flex items-center gap-2" role="group" aria-label={`Delete ${passkey.name}?`}>
+                      <span className="text-sm text-gray-700">Delete this passkey?</span>
+                      <button
+                        type="button"
+                        onClick={() => handleDelete(passkey)}
+                        disabled={busy === `delete:${passkey.id}`}
+                        className="inline-flex items-center py-1.5 px-3 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-red-700 disabled:opacity-75"
+                      >
+                        {busy === `delete:${passkey.id}` ? 'Deleting...' : 'Delete'}
+                      </button>
+                      <button type="button" onClick={() => setConfirmDeleteId(null)} className={secondaryButton}>
+                        Cancel
+                      </button>
+                    </div>
+                  ) : (
+                    <div className="flex items-center gap-2">
+                      <button
+                        type="button"
+                        onClick={() => {
+                          setEditingId(passkey.id);
+                          setEditingName(passkey.name);
+                        }}
+                        className={secondaryButton}
+                        aria-label={`Rename ${passkey.name}`}
+                      >
+                        <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                        Rename
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setConfirmDeleteId(passkey.id)}
+                        className={secondaryButton}
+                        aria-label={`Delete ${passkey.name}`}
+                      >
+                        <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                        Delete
+                      </button>
+                    </div>
+                  ))}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <ReauthDialog ref={reauthDialog} username={username} hasPasskeys={(passkeys?.length ?? 0) > 0} />
+    </div>
+  );
+}
