@@ -0,0 +1,19 @@
+import type { APIRoute } from 'astro';
+import { callAccountApi } from '../../../../lib/auth/accounts';
+import { errors, getSessionUser, json, markVerified, readJson } from '../../../../lib/auth/session';
+
+// Password fallback for re-verification, for accounts without passkeys.
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return errors.unauthenticated();
+
+  const body = await readJson<{ password?: unknown }>(request);
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!password) return errors.badRequest('Password is required.');
+
+  const result = await callAccountApi('login', user.username, password);
+  if (!result.ok) return json({ error: result.error ?? 'Incorrect password.' }, result.status);
+
+  markVerified(session);
+  return json({ ok: true });
+};
