--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,95 @@
+import type { AstroSession } from 'astro';
+import { REAUTH_WINDOW_MS } from './config';
+import { findUserById, type StoredPasskeyCredential, type StoredUser } from './store';
+
+type ChallengePurpose = 'login' | 'register' | 'reauth';
+
+interface PendingChallenge {
+  challenge: string;
+  expiresAt: number;
+  userVerification: UserVerificationRequirement;
+  conditional?: boolean;
+}
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const errors = {
+  unauthenticated: () => json({ error: 'Please sign in to continue.', code: 'unauthenticated' }, 401),
+  reauthRequired: () =>
+    json({ error: 'Please confirm it’s you to continue.', code: 'reauth_required' }, 403),
+  unsupportedHost: () =>
+    json({ error: 'Passkeys are not available on this domain.', code: 'unsupported_host' }, 400),
+  badRequest: (error: string) => json({ error, code: 'bad_request' }, 400),
+};
+
+export async function getSessionUser(session: AstroSession | undefined): Promise<StoredUser | undefined> {
+  const userId = await session?.get('userId');
+  return userId ? findUserById(userId) : undefined;
+}
+
+// Starts a fresh session for the user so a pre-login session ID can't be reused.
+export async function signIn(session: AstroSession, user: StoredUser) {
+  await session.regenerate();
+  session.set('userId', user.id);
+  session.set('verifiedAt', Date.now());
+}
+
+export function markVerified(session: AstroSession) {
+  session.set('verifiedAt', Date.now());
+}
+
+export async function isRecentlyVerified(session: AstroSession | undefined) {
+  const verifiedAt = await session?.get('verifiedAt');
+  return typeof verifiedAt === 'number' && Date.now() - verifiedAt < REAUTH_WINDOW_MS;
+}
+
+export function storeChallenge(
+  session: AstroSession,
+  purpose: ChallengePurpose,
+  challenge: Omit<PendingChallenge, 'expiresAt'>,
+) {
+  session.set(`challenge:${purpose}`, { ...challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+}
+
+// Returns the pending challenge once; it's removed so a response can't be replayed.
+export async function consumeChallenge(
+  session: AstroSession | undefined,
+  purpose: ChallengePurpose,
+): Promise<PendingChallenge | undefined> {
+  if (!session) return undefined;
+  const pending = (await session.get(`challenge:${purpose}`)) as PendingChallenge | undefined;
+  session.delete(`challenge:${purpose}`);
+  return pending && pending.expiresAt > Date.now() ? pending : undefined;
+}
+
+// The client-facing shape of a stored passkey.
+export function toPasskeySummary(credential: StoredPasskeyCredential) {
+  return {
+    id: credential.id,
+    name: credential.name,
+    providerIcon: credential.providerIcon,
+    backedUp: credential.credentialBackedUp,
+    deviceType: credential.credentialDeviceType,
+    registeredAt: credential.registeredAt,
+    lastUsedAt: credential.lastUsedAt,
+  };
+}
+
+export type PasskeySummary = ReturnType<typeof toPasskeySummary>;
+
+// Only accept JSON bodies: cross-site forms can't send them without a CORS preflight.
+export async function readJson<T>(request: Request): Promise<T | undefined> {
+  if (!request.headers.get('Content-Type')?.includes('application/json')) return undefined;
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return undefined;
+  }
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..de3c32b
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,118 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+// A small JSON-file store for local account profiles and passkey credentials.
+// Passwords stay with the upstream account service; this only keeps the data
+// needed for WebAuthn.
+
+export interface StoredUser {
+  id: string; // Base64URL WebAuthn user handle
+  username: string;
+  displayName: string;
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL-encoded public key
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Data {
+  users: StoredUser[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const DATA_FILE = resolve(process.env.AUTH_DATA_FILE ?? '.data/auth.json');
+
+let cache: Data | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<Data> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as Data;
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err;
+    cache = { users: [], credentials: [] };
+  }
+  return cache;
+}
+
+// Serializes writes and swaps the file atomically so concurrent requests can't corrupt it.
+function persist(data: Data): Promise<void> {
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(dirname(DATA_FILE), { recursive: true });
+    const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(data, null, 2));
+    await rename(tmp, DATA_FILE);
+  });
+  return writeQueue;
+}
+
+export async function findUserById(id: string) {
+  const data = await load();
+  return data.users.find((u) => u.id === id);
+}
+
+export async function findOrCreateUser(username: string): Promise<StoredUser> {
+  const data = await load();
+  let user = data.users.find((u) => u.username === username);
+  if (!user) {
+    user = {
+      id: randomBytes(32).toString('base64url'),
+      username,
+      displayName: username,
+      createdAt: Date.now(),
+    };
+    data.users.push(user);
+    await persist(data);
+  }
+  return user;
+}
+
+export async function updateUser(id: string, changes: Pick<StoredUser, 'displayName'>) {
+  const data = await load();
+  const user = data.users.find((u) => u.id === id);
+  if (!user) return undefined;
+  Object.assign(user, changes);
+  await persist(data);
+  return user;
+}
+
+export async function findCredentialsByUserId(userId: string) {
+  const data = await load();
+  return data.credentials
+    .filter((c) => c.passkeyUserId === userId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export async function findCredentialById(id: string) {
+  const data = await load();
+  return data.credentials.find((c) => c.id === id);
+}
+
+export async function saveCredential(credential: StoredPasskeyCredential) {
+  const data = await load();
+  const index = data.credentials.findIndex((c) => c.id === credential.id);
+  if (index === -1) data.credentials.push(credential);
+  else data.credentials[index] = credential;
+  await persist(data);
+}
+
+export async function deleteCredential(id: string) {
+  const data = await load();
+  data.credentials = data.credentials.filter((c) => c.id !== id);
+  await persist(data);
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..889eb01
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,240 @@
+// Browser-side helpers for passkeys. Uses the native WebAuthn APIs directly; the
+// `webauthn-polyfills` package fills in JSON (de)serialization and
+// getClientCapabilities() on browsers that predate them.
+
+import type { PasskeySummary } from './auth/session';
+
+export type { PasskeySummary };
+
+export type ClientCapabilities = Partial<
+  Record<
+    | 'conditionalCreate'
+    | 'conditionalGet'
+    | 'passkeyPlatformAuthenticator'
+    | 'signalAllAcceptedCredentials'
+    | 'signalCurrentUserDetails'
+    | 'signalUnknownCredential',
+    boolean
+  >
+>;
+
+// Newer WebAuthn statics that TypeScript's DOM lib may not describe yet.
+interface PublicKeyCredentialStatics {
+  getClientCapabilities(): Promise<ClientCapabilities>;
+  parseCreationOptionsFromJSON(json: unknown): PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON(json: unknown): PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?(options: { rpId: string; credentialId: string }): Promise<void>;
+  signalAllAcceptedCredentials?(options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }): Promise<void>;
+  signalCurrentUserDetails?(options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }): Promise<void>;
+}
+
+type SerializableCredential = PublicKeyCredential & { toJSON(): { id: string } & Record<string, unknown> };
+
+const PKC = () => window.PublicKeyCredential as unknown as PublicKeyCredentialStatics;
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    readonly status: number,
+    readonly code?: string,
+  ) {
+    super(message);
+  }
+}
+
+export async function api<T>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: { 'Content-Type': 'application/json' },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ApiError(data.error ?? 'Something went wrong. Please try again.', response.status, data.code);
+  }
+  return data as T;
+}
+
+let loading: Promise<boolean> | null = null;
+
+// Loads the polyfills on the client only and reports whether WebAuthn exists at all.
+export function loadWebAuthn(): Promise<boolean> {
+  loading ??= (async () => {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+    await import('webauthn-polyfills');
+    return true;
+  })();
+  return loading;
+}
+
+export async function getCapabilities(): Promise<ClientCapabilities> {
+  if (!(await loadWebAuthn())) return {};
+  try {
+    return await PKC().getClientCapabilities();
+  } catch {
+    return {};
+  }
+}
+
+// Passkey creation buttons are only offered where a platform passkey and autofill sign-in both work.
+export async function canCreatePasskeys() {
+  const capabilities = await getCapabilities();
+  return capabilities.passkeyPlatformAuthenticator === true && capabilities.conditionalGet === true;
+}
+
+async function signalUnknownCredential(rpId: string | undefined, credentialId: string) {
+  if (!rpId || !PKC().signalUnknownCredential) return;
+  try {
+    await PKC().signalUnknownCredential!({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential failed:', err);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId: string | null, userId: string, credentialIds: string[]) {
+  if (!rpId || !(await loadWebAuthn()) || !PKC().signalAllAcceptedCredentials) return;
+  try {
+    await PKC().signalAllAcceptedCredentials!({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+export async function signalCurrentUserDetails(
+  rpId: string | null,
+  details: { userId: string; name: string; displayName: string },
+) {
+  if (!rpId || !(await loadWebAuthn()) || !PKC().signalCurrentUserDetails) return;
+  try {
+    await PKC().signalCurrentUserDetails!({ rpId, ...details });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails failed:', err);
+  }
+}
+
+export type PasskeyResult<T> =
+  | { status: 'ok'; value: T }
+  // The user dismissed the dialog or the request was aborted; show nothing.
+  | { status: 'cancelled' }
+  | { status: 'error'; message: string; code?: string };
+
+const failure = (err: unknown): { status: 'error'; message: string; code?: string } =>
+  err instanceof ApiError
+    ? { status: 'error', message: err.message, code: err.code }
+    : { status: 'error', message: 'Something went wrong. Please try again.' };
+
+/**
+ * Creates a passkey for the signed-in user.
+ * - `promotion`: suggested after sign-in/sign-up, limited to the platform authenticator.
+ * - `conditional`: Conditional Create right after a password sign-in. Fails silently.
+ */
+export async function createPasskey(
+  opts: { promotion?: boolean; conditional?: boolean; signal?: AbortSignal } = {},
+): Promise<PasskeyResult<PasskeySummary>> {
+  if (!(await loadWebAuthn())) return { status: 'error', message: 'Passkeys aren’t supported in this browser.' };
+
+  let publicKey: PublicKeyCredentialCreationOptions;
+  try {
+    const optionsJSON = await api('auth/passkey/register-options', {
+      body: { promotion: opts.promotion, conditional: opts.conditional },
+    });
+    publicKey = PKC().parseCreationOptionsFromJSON(optionsJSON);
+  } catch (err) {
+    return failure(err);
+  }
+
+  let credential: SerializableCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      signal: opts.signal,
+      ...(opts.conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as SerializableCredential;
+  } catch (err) {
+    const name = (err as DOMException).name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    if (name === 'InvalidStateError') {
+      return { status: 'error', code: 'exists', message: 'You already have a passkey for this account in this password manager.' };
+    }
+    if (name === 'SecurityError') {
+      return { status: 'error', message: 'Passkeys can’t be created on this site’s current address.' };
+    }
+    console.error('Passkey creation failed:', err);
+    return { status: 'error', message: 'Your passkey couldn’t be created. Please try again.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const summary = await api<PasskeySummary>('auth/passkey/register-verify', { body: encoded });
+    return { status: 'ok', value: summary };
+  } catch (err) {
+    // The provider saved a passkey that the server rejected; ask it to remove the orphan.
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    return failure(err);
+  }
+}
+
+const ASSERTION_ENDPOINTS = {
+  login: ['auth/passkey/login-options', 'auth/passkey/login-verify'],
+  reauth: ['auth/reauth/options', 'auth/reauth/verify'],
+} as const;
+
+/**
+ * Requests a passkey assertion and verifies it on the server.
+ * - `login`: discoverable sign-in, either via a button or form autofill (`conditional`).
+ * - `reauth`: step-up verification limited to the signed-in user's passkeys.
+ */
+export async function getPasskey<T>(
+  purpose: 'login' | 'reauth',
+  opts: { conditional?: boolean; signal?: AbortSignal } = {},
+): Promise<PasskeyResult<T>> {
+  if (!(await loadWebAuthn())) return { status: 'error', message: 'Passkeys aren’t supported in this browser.' };
+
+  const [optionsPath, verifyPath] = ASSERTION_ENDPOINTS[purpose];
+
+  let publicKey: PublicKeyCredentialRequestOptions;
+  try {
+    publicKey = PKC().parseRequestOptionsFromJSON(await api(optionsPath, { body: {} }));
+  } catch (err) {
+    return failure(err);
+  }
+
+  let credential: SerializableCredential;
+  try {
+    credential = (await navigator.credentials.get({
+      publicKey,
+      signal: opts.signal,
+      ...(opts.conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as SerializableCredential;
+  } catch (err) {
+    const name = (err as DOMException).name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    console.error('Passkey request failed:', err);
+    return { status: 'error', message: 'We couldn’t use your passkey. Please try again.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    return { status: 'ok', value: await api<T>(verifyPath, { body: encoded }) };
+  } catch (err) {
+    // Only an explicit "not found" means the provider holds a passkey the server deleted.
+    if (err instanceof ApiError && err.status === 404 && err.code === 'unknown_credential') {
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+      return {
+        status: 'error',
+        code: err.code,
+        message: 'That passkey was removed from your account. Please choose another or use your password.',
+      };
+    }
+    return failure(err);
+  }
+}
