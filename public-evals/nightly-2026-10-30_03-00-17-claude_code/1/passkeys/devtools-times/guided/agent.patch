diff --git a/src/lib/auth/aaguid.ts b/src/lib/auth/aaguid.ts
new file mode 100644
index 0000000..84023e3
--- /dev/null
+++ b/src/lib/auth/aaguid.ts
@@ -0,0 +1,49 @@
+// Maps an authenticator's AAGUID to a provider name and icon for display only.
+// AAGUIDs are not attested for platform passkeys, so never use them for access decisions.
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registry: Promise<Registry> | null = null;
+
+function loadRegistry(): Promise<Registry> {
+  registry ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then((res) => {
+      if (!res.ok) throw new Error(`AAGUID registry responded ${res.status}`);
+      return res.json() as Promise<Registry>;
+    })
+    .catch((err) => {
+      console.error('Failed to load AAGUID registry:', err);
+      registry = null; // Retry on the next registration
+      return {};
+    });
+  return registry;
+}
+
+function deviceNameFromUserAgent(userAgent: string | null) {
+  if (!userAgent) return 'Unknown passkey provider';
+  const platforms: [RegExp, string][] = [
+    [/Android/i, 'Android'],
+    [/iPhone|iPad|iPod/i, 'iOS'],
+    [/Mac OS X|Macintosh/i, 'macOS'],
+    [/Windows/i, 'Windows'],
+    [/CrOS/i, 'ChromeOS'],
+    [/Linux/i, 'Linux'],
+  ];
+  const platform = platforms.find(([pattern]) => pattern.test(userAgent))?.[1];
+  return platform ? `Passkey on ${platform}` : 'Unknown passkey provider';
+}
+
+export async function describeAuthenticator(aaguid: string, userAgent: string | null) {
+  if (aaguid === ZERO_AAGUID) {
+    return { name: deviceNameFromUserAgent(userAgent), providerIcon: undefined };
+  }
+  const provider = (await loadRegistry())[aaguid];
+  return {
+    name: provider?.name ?? 'Unknown passkey provider',
+    providerIcon: provider ? { light: provider.icon_light, dark: provider.icon_dark } : undefined,
+  };
+}
diff --git a/src/lib/auth/accounts.ts b/src/lib/auth/accounts.ts
new file mode 100644
index 0000000..385b4f2
--- /dev/null
+++ b/src/lib/auth/accounts.ts
@@ -0,0 +1,22 @@
+import { ACCOUNT_API } from './config';
+
+// Forwards a username/password check to the upstream account service.
+export async function callAccountApi(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<{ ok: boolean; status: number; error?: string }> {
+  try {
+    const response = await fetch(`${ACCOUNT_API}/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(10000),
+    });
+    const data = await response.json().catch(() => ({}));
+    return { ok: response.ok, status: response.status, error: data.error };
+  } catch (err) {
+    console.error(`Account service ${action} request failed:`, err);
+    return { ok: false, status: 502, error: 'The account service is unavailable.' };
+  }
+}
diff --git a/src/lib/auth/config.ts b/src/lib/auth/config.ts
new file mode 100644
index 0000000..df18eec
--- /dev/null
+++ b/src/lib/auth/config.ts
@@ -0,0 +1,42 @@
+// Relying Party configuration for passkeys (WebAuthn).
+//
+// Credentials are bound to an RP ID, so it must be one of the hostnames this app
+// is actually served from. The list mirrors `security.allowedDomains` in
+// astro.config.mjs, plus localhost for local development. Override with a
+// comma-separated `PASSKEY_RP_IDS` environment variable if the app moves.
+const DEFAULT_RP_IDS = [
+  'astro-news-pytrpecapa-uc.a.run.app',
+  'astro-news-1026410574114.us-central1.run.app',
+  'chrome.dev',
+  'localhost',
+];
+
+const RP_IDS = (process.env.PASSKEY_RP_IDS?.split(',') ?? DEFAULT_RP_IDS)
+  .map((id) => id.trim())
+  .filter(Boolean);
+
+export const RP_NAME = 'The DevTools Times';
+
+export interface RelyingParty {
+  rpID: string;
+  origins: string[];
+}
+
+// Resolves the RP ID and the origins we accept in clientDataJSON for this request.
+// Returns null when the request arrives on a hostname we don't serve passkeys for.
+export function getRelyingParty(url: URL): RelyingParty | null {
+  const rpID = url.hostname;
+  if (!RP_IDS.includes(rpID)) return null;
+
+  const origins =
+    rpID === 'localhost'
+      ? [`http://${url.host}`, `https://${url.host}`]
+      : [`https://${url.host}`];
+  return { rpID, origins };
+}
+
+// Sensitive account changes require the user to have signed in or re-verified recently.
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+// Upstream account service that owns usernames and passwords.
+export const ACCOUNT_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
