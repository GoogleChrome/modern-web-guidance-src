+import type { APIRoute } from 'astro';
+import { callAccountApi } from '../../../lib/auth/accounts';
+import { errors, json, readJson, signIn } from '../../../lib/auth/session';
+import { findOrCreateUser } from '../../../lib/auth/store';
+
+// Creates an account with the upstream account service.
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: unknown; password?: unknown }>(request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password || !session) return errors.badRequest('Username and password are required.');
+
+  const result = await callAccountApi('register', username, password);
+  if (!result.ok) return json({ error: result.error ?? 'Unknown error' }, result.status);
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user);
+  return json({ username: user.username, displayName: user.displayName });
+};
