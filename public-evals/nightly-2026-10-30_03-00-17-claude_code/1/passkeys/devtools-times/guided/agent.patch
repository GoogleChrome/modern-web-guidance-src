@@ -0,0 +1,51 @@
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import type { RelyingParty } from './config';
+import { findCredentialById, findUserById, saveCredential } from './store';
+
+type PendingChallenge = { challenge: string; userVerification: UserVerificationRequirement };
+
+// Verifies a passkey assertion against a stored credential and updates its counter.
+// Unknown credentials produce a 404 so the client can tell the passkey provider to forget them.
+export async function verifyPasskeyAssertion(
+  response: AuthenticationResponseJSON,
+  pending: PendingChallenge,
+  rp: RelyingParty,
+) {
+  const credential = await findCredentialById(response.id);
+  const user = credential && (await findUserById(credential.passkeyUserId));
+  if (!credential || !user) {
+    return { ok: false as const, status: 404, error: 'This passkey is no longer registered.', code: 'unknown_credential' };
+  }
+
+  if (response.response.userHandle && response.response.userHandle !== user.id) {
+    return { ok: false as const, status: 400, error: 'This passkey does not match its account.', code: 'verification_failed' };
+  }
+
+  try {
+    const { verified, authenticationInfo } = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: rp.origins,
+      expectedRPID: rp.rpID,
+      credential: {
+        id: credential.id,
+        publicKey: new Uint8Array(Buffer.from(credential.credentialPublicKey, 'base64url')),
+        counter: credential.counter,
+        transports: credential.transports,
+      },
+      // Matches the UV level requested in the options, which is kept server-side in the session.
+      requireUserVerification: pending.userVerification === 'required',
+    });
+    if (!verified) throw new Error('Assertion could not be verified');
+
+    credential.counter = authenticationInfo.newCounter;
+    credential.credentialBackedUp = authenticationInfo.credentialBackedUp;
+    credential.lastUsedAt = Date.now();
+    await saveCredential(credential);
+  } catch (err) {
+    console.error('Passkey assertion verification failed:', err);
+    return { ok: false as const, status: 400, error: 'We couldn’t verify your passkey.', code: 'verification_failed' };
+  }
+
+  return { ok: true as const, credential, user };
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
