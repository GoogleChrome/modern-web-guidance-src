@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import { errors, getSessionUser, json, storeChallenge } from '../../../../lib/auth/session';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+
+// Step-up verification: only the signed-in user's own passkeys may answer.
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return errors.unauthenticated();
+  const rp = getRelyingParty(url);
+  if (!rp) return errors.unsupportedHost();
+
+  const credentials = await findCredentialsByUserId(user.id);
+  if (credentials.length === 0) {
+    return json({ error: 'You don’t have any passkeys yet.', code: 'no_passkeys' }, 400);
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID: rp.rpID,
+    allowCredentials: credentials.map((cred) => ({ id: cred.id, transports: cred.transports })),
+    userVerification: 'preferred',
+  });
+  storeChallenge(session, 'reauth', { challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
