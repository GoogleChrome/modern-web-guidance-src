@@ -0,0 +1,16 @@
+import type { APIRoute } from 'astro';
+import { getRelyingParty } from '../../../../lib/auth/config';
+import { errors, getSessionUser, json, toPasskeySummary } from '../../../../lib/auth/session';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errors.unauthenticated();
+
+  const credentials = await findCredentialsByUserId(user.id);
+  return json({
+    rpId: getRelyingParty(url)?.rpID ?? null,
+    userId: user.id,
+    credentials: credentials.map(toPasskeySummary),
+  });
+};
diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..1edea56
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,19 @@
+import type { APIRoute } from 'astro';
+import { callAccountApi } from '../../../lib/auth/accounts';
+import { errors, json, readJson, signIn } from '../../../lib/auth/session';
+import { findOrCreateUser } from '../../../lib/auth/store';
+
+// Password sign-in, verified by the upstream account service.
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: unknown; password?: unknown }>(request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password || !session) return errors.badRequest('Username and password are required.');
+
