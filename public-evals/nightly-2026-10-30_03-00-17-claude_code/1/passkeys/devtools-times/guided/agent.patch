+++ b/src/pages/api/auth/user.ts
@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { errors, getSessionUser, isRecentlyVerified, json, readJson } from '../../../lib/auth/session';
+import { updateUser } from '../../../lib/auth/store';
+
+// Updates the signed-in user's display name. The client then syncs it to passkey
+// providers with PublicKeyCredential.signalCurrentUserDetails().
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return errors.unauthenticated();
+  if (!(await isRecentlyVerified(session))) return errors.reauthRequired();
+
+  const body = await readJson<{ displayName?: unknown }>(request);
+  const displayName = typeof body?.displayName === 'string' ? body.displayName.trim() : '';
+  if (!displayName || displayName.length > 64) {
+    return errors.badRequest('Display name must be between 1 and 64 characters.');
+  }
+
+  const updated = await updateUser(user.id, { displayName });
+  return json({ userId: user.id, username: user.username, displayName: updated?.displayName });
+};
