+    /* Weathered grunge effect: the background moves to a pseudo-element so the
+       distress mask eats into its transparency while the text stays crisp. */
+    .weathered-bg {
+      position: relative;
+      isolation: isolate;
+      background: none;
+    }
+
+    .weathered-bg::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      -webkit-mask-image: url('grunge-texture.svg');
+      -webkit-mask-repeat: repeat;
+      -webkit-mask-size: 400px;
+      mask-image: url('grunge-texture.svg');
+      mask-repeat: repeat;
+      mask-size: 400px;
+      mask-mode: alpha;
+    }
+
