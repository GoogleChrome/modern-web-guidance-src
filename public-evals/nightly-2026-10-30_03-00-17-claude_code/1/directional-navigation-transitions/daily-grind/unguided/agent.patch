+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+
+      var viewport = carousel.querySelector('.carousel-viewport');
+      var slides = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-slide'));
+      var controls = carousel.querySelector('.carousel-controls');
+      var status = carousel.querySelector('.carousel-status');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var animationClasses = ['slide-in-from-right', 'slide-in-from-left', 'slide-out-to-left', 'slide-out-to-right'];
+      var current = 0;
+
+      function clearAnimation(slide) {
+        slide.classList.remove.apply(slide.classList, animationClasses);
+      }
+
+      function updateStatus() {
+        status.textContent = (current + 1) + ' of ' + slides.length + ': ' + slides[current].querySelector('h3').textContent;
+      }
+
+      // Finish any in-flight transition immediately so rapid clicks stay consistent.
+      function settle() {
+        slides.forEach(function (slide, i) {
+          clearAnimation(slide);
+          slide.hidden = i !== current;
+        });
+      }
+
+      function go(step) {
+        settle();
+        var previous = slides[current];
+        current = (current + step + slides.length) % slides.length;
+        var next = slides[current];
+        next.hidden = false;
+        updateStatus();
+
+        if (reducedMotion.matches) {
+          previous.hidden = true;
+          return;
+        }
+
+        var forward = step > 0;
+        previous.classList.add(forward ? 'slide-out-to-left' : 'slide-out-to-right');
+        next.classList.add(forward ? 'slide-in-from-right' : 'slide-in-from-left');
+
+        previous.addEventListener('animationend', function onEnd() {
+          previous.removeEventListener('animationend', onEnd);
+          if (previous !== slides[current]) {
+            clearAnimation(previous);
+            previous.hidden = true;
+          }
+        });
+        next.addEventListener('animationend', function onEnd() {
+          next.removeEventListener('animationend', onEnd);
+          if (next === slides[current]) clearAnimation(next);
+        });
+      }
+
+      viewport.classList.add('is-enhanced');
+      settle();
+      updateStatus();
+      controls.hidden = false;
+
+      carousel.querySelector('[data-carousel-prev]').addEventListener('click', function () { go(-1); });
+      carousel.querySelector('[data-carousel-next]').addEventListener('click', function () { go(1); });
+    })();
+  </script>
