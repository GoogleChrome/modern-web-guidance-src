+    /* Seasonal Favorites carousel */
+    .carousel {
+      max-width: 520px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      display: grid;
+      overflow: hidden;
+      padding: 6px;
+    }
+
+    /* Without JS every item is listed; once enhanced they stack so the
+       outgoing and incoming items can overlap while animating. */
+    .carousel-viewport:not(.is-enhanced) {
+      gap: 20px;
+    }
+
+    .carousel-viewport.is-enhanced .carousel-slide {
+      grid-area: 1 / 1;
+    }
+
+    .carousel-slide[hidden] {
+      display: none;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-top: 15px;
+    }
+
+    .carousel-controls[hidden] {
+      display: none;
+    }
+
+    .carousel-btn {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 10px 20px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: #3e2723;
+    }
+
+    .carousel-btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    .slide-in-from-right {
+      animation: slide-in-from-right 0.4s ease both;
+    }
+
+    .slide-in-from-left {
+      animation: slide-in-from-left 0.4s ease both;
+    }
+
+    .slide-out-to-left {
+      animation: slide-out-to-left 0.4s ease both;
+    }
+
+    .slide-out-to-right {
+      animation: slide-out-to-right 0.4s ease both;
+    }
+
+    @keyframes slide-in-from-right {
+      from { transform: translateX(100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes slide-in-from-left {
+      from { transform: translateX(-100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes slide-out-to-left {
+      from { transform: translateX(0); opacity: 1; }
+      to { transform: translateX(-100%); opacity: 0; }
+    }
+
+    @keyframes slide-out-to-right {
+      from { transform: translateX(0); opacity: 1; }
+      to { transform: translateX(100%); opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .slide-in-from-right,
+      .slide-in-from-left,
+      .slide-out-to-left,
+      .slide-out-to-right {
+        animation: none;
+      }
+    }
