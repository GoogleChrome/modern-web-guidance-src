diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..6a04d0a
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,158 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+<top-stories-slider class="block bg-white border-b border-gray-300">
+    <section
+        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-4"
+        aria-roledescription="carousel"
+        aria-label="Top stories"
+    >
+        <button
+            type="button"
+            data-prev
+            aria-controls="top-stories-viewport"
+            class="shrink-0 px-3 py-1 text-sm font-semibold border border-gray-300 text-gray-700 hover:border-amber-400 hover:text-amber-400 transition-colors"
+        >
+            Previous
+        </button>
+
+        <div id="top-stories-viewport" data-viewport class="top-stories-viewport relative flex-1 overflow-hidden" aria-live="polite">
+            {articles.map((article, index) => (
+                <div
+                    data-slide
+                    role="group"
+                    aria-roledescription="slide"
+                    aria-label={`${index + 1} of ${articles.length}`}
+                    hidden={index !== 0}
+                >
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                    </a>
+                    <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                </div>
+            ))}
+        </div>
+
+        <button
+            type="button"
+            data-next
+            aria-controls="top-stories-viewport"
+            class="shrink-0 px-3 py-1 text-sm font-semibold border border-gray-300 text-gray-700 hover:border-amber-400 hover:text-amber-400 transition-colors"
+        >
+            Next
+        </button>
+    </section>
+</top-stories-slider>
+
+<script>
+    type Direction = 'next' | 'previous';
+    type ScopedTransitionElement = HTMLElement & {
+        startViewTransition(options: { update: () => void; types: string[] }): ViewTransition;
+    };
+
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    class TopStoriesSlider extends HTMLElement {
+        #index = 0;
+        #viewport!: HTMLElement;
+        #slides: HTMLElement[] = [];
+
+        connectedCallback() {
+            this.#viewport = this.querySelector<HTMLElement>('[data-viewport]')!;
+            this.#slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
+            this.querySelector('[data-prev]')!.addEventListener('click', () => this.#go('previous'));
+            this.querySelector('[data-next]')!.addEventListener('click', () => this.#go('next'));
+        }
+
+        #go(direction: Direction) {
+            const count = this.#slides.length;
+            const nextIndex = (this.#index + (direction === 'next' ? 1 : -1) + count) % count;
+            const update = () => {
+                this.#slides[this.#index].hidden = true;
+                this.#slides[nextIndex].hidden = false;
+                this.#index = nextIndex;
+            };
+
+            if (reducedMotion.matches) {
+                update();
+                return;
+            }
+
+            if (supportsScopedTransition) {
+                // Scope the transition to the viewport so the rest of the page stays interactive
+                const transition = (this.#viewport as ScopedTransitionElement).startViewTransition({
+                    update,
+                    types: [direction],
+                });
+                // Rapid clicks skip the running transition and reject `ready`
+                transition.ready.catch(() => {});
+                return;
+            }
+
+            // Fallback for browsers without element-scoped view transitions: slide the new story in
+            update();
+            this.#slides[nextIndex].animate(
+                { translate: [direction === 'next' ? '100% 0' : '-100% 0', '0 0'] },
+                { duration: 400, easing: 'ease-in-out' },
+            );
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
+
+<style is:global>
+    @keyframes top-stories-slide-to-left {
+        to { transform: translateX(-100%); }
+    }
+    @keyframes top-stories-slide-from-right {
+        from { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-to-right {
+        to { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-from-left {
+        from { transform: translateX(-100%); }
+    }
+
+    .top-stories-viewport::view-transition-group(root) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+    }
+    .top-stories-viewport::view-transition-old(root),
+    .top-stories-viewport::view-transition-new(root) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+    }
+
+    .top-stories-viewport:active-view-transition-type(next)::view-transition-old(root) {
+        animation-name: top-stories-slide-to-left;
+    }
+    .top-stories-viewport:active-view-transition-type(next)::view-transition-new(root) {
+        animation-name: top-stories-slide-from-right;
+    }
+    .top-stories-viewport:active-view-transition-type(previous)::view-transition-old(root) {
+        animation-name: top-stories-slide-to-right;
+    }
+    .top-stories-viewport:active-view-transition-type(previous)::view-transition-new(root) {
+        animation-name: top-stories-slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .top-stories-viewport::view-transition-group(*),
+        .top-stories-viewport::view-transition-old(*),
+        .top-stories-viewport::view-transition-new(*) {
+            animation: none !important;
+        }
+    }
+</style>
