diff --git a/migrate-settings.js b/migrate-settings.js
new file mode 100644
index 0000000..d62c6a5
--- /dev/null
+++ b/migrate-settings.js
@@ -0,0 +1,41 @@
+// One-time import of user settings from the legacy origin. Origin migration
+// only moves the installation (shortcuts, icons); localStorage stays behind,
+// so we read it through a same-site bridge iframe on the old origin.
+(() => {
+  const LEGACY_ORIGIN = 'https://dailygrind.example.com';
+  const DONE_KEY = 'dg:settings-migrated';
+
+  if (localStorage.getItem(DONE_KEY)) return;
+
+  const frame = document.createElement('iframe');
+  frame.src = `${LEGACY_ORIGIN}/migrate-bridge.html`;
+  frame.hidden = true;
+
+  const finish = () => {
+    window.removeEventListener('message', onMessage);
+    frame.remove();
+  };
+
+  const onMessage = (event) => {
+    if (event.origin !== LEGACY_ORIGIN || event.source !== frame.contentWindow) return;
+    const { type, entries } = event.data ?? {};
+    if (type !== 'dg:settings' || typeof entries !== 'object' || entries === null) return;
+
+    for (const [key, value] of Object.entries(entries)) {
+      // Never clobber settings the user already changed on the new origin.
+      if (typeof value === 'string' && localStorage.getItem(key) === null) {
+        localStorage.setItem(key, value);
+      }
+    }
+    localStorage.setItem(DONE_KEY, new Date().toISOString());
+    finish();
+  };
+
+  window.addEventListener('message', onMessage);
+  frame.addEventListener('load', () => {
+    frame.contentWindow.postMessage({ type: 'dg:request-settings' }, LEGACY_ORIGIN);
+  });
+  // Give up quietly if the legacy origin is unreachable; retry on next visit.
+  setTimeout(finish, 10000);
+  document.body.append(frame);
+})();
