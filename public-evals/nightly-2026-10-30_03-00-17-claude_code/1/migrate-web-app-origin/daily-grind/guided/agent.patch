diff --git a/old-origin/migrate-bridge.html b/old-origin/migrate-bridge.html
new file mode 100644
index 0000000..b178243
--- /dev/null
+++ b/old-origin/migrate-bridge.html
@@ -0,0 +1,25 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Settings bridge</title>
+</head>
+<body>
+  <script>
+    // Hands this origin's localStorage to the new origin, and only to it.
+    const NEW_ORIGIN = 'https://app.dailygrind.example.com';
+
+    window.addEventListener('message', (event) => {
+      if (event.origin !== NEW_ORIGIN || event.source !== window.parent) return;
+      if (event.data?.type !== 'dg:request-settings') return;
+
+      const entries = {};
+      for (let i = 0; i < localStorage.length; i++) {
+        const key = localStorage.key(i);
+        entries[key] = localStorage.getItem(key);
+      }
+      event.source.postMessage({ type: 'dg:settings', entries }, NEW_ORIGIN);
+    });
+  </script>
+</body>
+</html>
diff --git a/old-origin/migration-banner.js b/old-origin/migration-banner.js
new file mode 100644
index 0000000..2eef4ad
--- /dev/null
+++ b/old-origin/migration-banner.js
@@ -0,0 +1,22 @@
+// Fallback for browsers without web app origin migration (Firefox, Safari):
+// point users at the new origin so they can reinstall from there.
+(() => {
+  const NEW_ORIGIN = 'https://app.dailygrind.example.com';
+
+  const banner = document.createElement('div');
+  banner.setAttribute('role', 'status');
+  banner.style.cssText =
+    'position:sticky;top:0;z-index:1001;display:flex;gap:1rem;justify-content:center;' +
+    'align-items:center;flex-wrap:wrap;padding:.75rem 1rem;background:#ffab40;color:#3e2723;' +
+    'font:inherit;text-align:center';
+  banner.innerHTML =
+    '<span>The Daily Grind has moved. If you installed our app, please reinstall it from the new address.</span>';
+
+  const link = document.createElement('a');
+  link.href = NEW_ORIGIN + location.pathname + location.search;
+  link.textContent = 'Go to the new site';
+  link.style.cssText = 'color:inherit;font-weight:bold';
+  banner.append(link);
+
+  document.body.prepend(banner);
+})();
