+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('order-form');
+      const summary = document.getElementById('order-summary');
+      const ctx = canvas.getContext('2d');
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      // Without HTML-in-Canvas, canvas children are never rendered, so overlay
+      // the real form on top of the canvas instead.
+      if (!supportsHtmlInCanvas) stage.append(form);
+
+      const MILK_COLORS = { whole: '#c69c72', oat: '#d4b48c', almond: '#b98a5e', none: '#3b2417' };
+
+      // Cup geometry in CSS pixels, derived from the canvas width and the
+      // form's laid-out height so the cup always wraps the form.
+      function getLayout() {
+        const width = canvas.clientWidth;
+        const cupX = width * 0.06;
+        const cupW = width * 0.72;
+        const taper = cupW * 0.07;
+        const rimY = 70;
+        const formW = cupW - 2 * taper - 40;
+        const formX = cupX + (cupW - formW) / 2;
+        const formY = rimY + 30;
+        const formH = form.offsetHeight;
+        const cupBottom = formY + formH + 28;
+        return { cupX, cupW, taper, rimY, formX, formY, formW, formH, cupBottom, height: cupBottom + 40 };
+      }
+
+      function drawCup(l) {
+        const cx = l.cupX + l.cupW / 2;
+        const right = l.cupX + l.cupW;
+
+        // Steam
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 4;
+        ctx.lineCap = 'round';
+        for (const dx of [-0.2, 0, 0.2]) {
+          const x = cx + dx * l.cupW;
+          ctx.beginPath();
+          ctx.moveTo(x, l.rimY - 18);
+          ctx.bezierCurveTo(x - 14, l.rimY - 34, x + 14, l.rimY - 46, x, l.rimY - 62);
+          ctx.stroke();
+        }
+
+        // Saucer
+        ctx.save();
+        ctx.shadowColor = 'rgba(0, 0, 0, 0.15)';
+        ctx.shadowBlur = 12;
+        ctx.shadowOffsetY = 4;
+        ctx.fillStyle = '#efebe9';
+        ctx.beginPath();
+        ctx.ellipse(cx, l.cupBottom + 4, l.cupW * 0.62, 20, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        // Handle
+        ctx.strokeStyle = '#e0d6d2';
+        ctx.lineWidth = Math.max(14, l.cupW * 0.06);
+        ctx.beginPath();
+        ctx.ellipse(right - l.taper, l.formY + l.formH * 0.4, l.cupW * 0.16, l.formH * 0.22, 0, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+
+        // Body
+        const body = ctx.createLinearGradient(l.cupX, 0, right, 0);
+        body.addColorStop(0, '#ffffff');
+        body.addColorStop(0.7, '#f7f3f1');
+        body.addColorStop(1, '#e8e0dc');
+        ctx.fillStyle = body;
+        ctx.strokeStyle = '#d7ccc8';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(l.cupX, l.rimY);
+        ctx.lineTo(right, l.rimY);
+        ctx.lineTo(right - l.taper, l.cupBottom - 24);
+        ctx.quadraticCurveTo(right - l.taper, l.cupBottom, right - l.taper - 24, l.cupBottom);
+        ctx.lineTo(l.cupX + l.taper + 24, l.cupBottom);
+        ctx.quadraticCurveTo(l.cupX + l.taper, l.cupBottom, l.cupX + l.taper, l.cupBottom - 24);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Rim and coffee surface, tinted by the chosen milk
+        ctx.fillStyle = '#ffffff';
+        ctx.beginPath();
+        ctx.ellipse(cx, l.rimY, l.cupW / 2, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = MILK_COLORS[form.elements.milk.value] ?? MILK_COLORS.whole;
+        ctx.beginPath();
+        ctx.ellipse(cx, l.rimY + 1, l.cupW / 2 - 10, 11, 0, 0, Math.PI * 2);
+        ctx.fill();
+      }
+
+      function draw() {
+        const l = getLayout();
+        ctx.reset();
+        // Draw in CSS pixels; the backing store is sized in device pixels.
+        const scale = canvas.width / canvas.clientWidth;
+        ctx.scale(scale, scale);
+        drawCup(l);
+        if (supportsHtmlInCanvas) {
+          // Also syncs hit testing and accessibility bounds to these coordinates.
+          ctx.drawElementImage(form, l.formX, l.formY, l.formW, l.formH);
+        }
+      }
+
+      // Size the form and canvas from the cup geometry before painting.
+      function applyLayout() {
+        const l = getLayout();
+        form.style.width = `${l.formW}px`;
+        if (!supportsHtmlInCanvas) form.style.translate = `${l.formX}px ${l.formY}px`;
+        const { height } = getLayout();
+        if (canvas.style.height !== `${height}px`) canvas.style.height = `${height}px`;
+      }
+
+      function requestDraw() {
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+        else draw();
+      }
+
+      if (supportsHtmlInCanvas) canvas.onpaint = draw;
+
+      // Match the backing store to device pixels to avoid blurriness.
+      const canvasObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        applyLayout();
+        requestDraw();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      canvasObserver.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Grow the cup when the form's content wraps or changes height.
+      new ResizeObserver(() => {
+        applyLayout();
+        requestDraw();
+      }).observe(form);
+
+      form.addEventListener('input', requestDraw);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const { name, milk, syrup } = form.elements;
+        const milkText = milk.value === 'none' ? 'black coffee' : `${milk.value} milk latte`;
+        const syrupText = syrup.value === 'none' ? '' : ` with ${syrup.value} syrup`;
+        summary.textContent = `Thanks, ${name.value.trim()}! One ${milkText}${syrupText} coming up.`;
+      });
+    })();
+  </script>
+
 </body>
 
