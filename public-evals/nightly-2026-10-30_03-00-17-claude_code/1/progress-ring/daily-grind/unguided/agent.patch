+    /* Loyalty Rewards */
+    .rewards {
+      margin-top: 60px;
+    }
+
+    .rewards h2 {
+      text-align: center;
+    }
+
+    .rewards-card {
+      display: flex;
+      align-items: center;
+      gap: 40px;
+      margin-top: 20px;
+      padding: 40px;
+      background: var(--primary);
+      color: var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .progress-ring {
+      position: relative;
+      flex-shrink: 0;
+      width: 200px;
+      height: 200px;
+    }
+
+    .progress-ring svg {
+      width: 100%;
+      height: 100%;
+      transform: rotate(-90deg);
+    }
+
+    .progress-ring circle {
+      fill: none;
+      stroke-width: 12;
+    }
+
+    .progress-ring .ring-track {
+      stroke: rgba(215, 204, 200, 0.2);
+    }
+
+    /* pathLength="100" on the circle lets --progress map directly to percent */
+    .progress-ring .ring-fill {
+      stroke: var(--accent);
+      stroke-linecap: round;
+      stroke-dasharray: 100;
+      stroke-dashoffset: calc(100 - var(--progress));
+      animation: ring-fill 1.2s ease-out;
+    }
+
+    @keyframes ring-fill {
+      from {
+        stroke-dashoffset: 100;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-ring .ring-fill {
+        animation: none;
+      }
+    }
+
+    .ring-label {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+      line-height: 1.2;
+    }
+
+    .ring-count {
+      font-size: 2.75rem;
+      font-weight: bold;
+      color: white;
+    }
+
+    .ring-count span {
+      font-size: 1.25rem;
+      color: var(--secondary);
+    }
+
+    .ring-caption {
+      font-size: 0.8rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+    }
+
+    .rewards-details h3 {
+      color: white;
+      font-size: 1.5rem;
+      margin-bottom: 10px;
+    }
+
+    .rewards-details strong {
+      color: var(--accent);
+    }
+
+    .rewards-details .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+    }
+
+    .rewards-details .btn:hover {
+      background: #ff9100;
+    }
+
+    @media (max-width: 640px) {
+      .rewards-card {
+        flex-direction: column;
+        text-align: center;
+        padding: 30px 20px;
+      }
+    }
+
