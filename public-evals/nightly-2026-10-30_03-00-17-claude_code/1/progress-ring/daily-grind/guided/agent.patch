+  <script>
+    // Sync the ring's value/max to CSS where attr() typing isn't supported
+    if (!CSS.supports('width: attr(value type(<number>))')) {
+      document.querySelectorAll('progress.progress-ring').forEach((ring) => {
+        const sync = () => {
+          ring.style.setProperty('--value', ring.getAttribute('value'));
+          ring.style.setProperty('--max', ring.getAttribute('max'));
+        };
+        sync();
+        new MutationObserver(sync).observe(ring, { attributes: true, attributeFilter: ['value', 'max'] });
+      });
+    }
+  </script>
