+    /* Loyalty Rewards */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .rewards {
+      margin-top: 50px;
+    }
+
+    .rewards h2 {
+      text-align: center;
+    }
+
+    .rewards-card {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      margin-top: 20px;
+      padding: 40px 30px;
+      background: var(--primary);
+      color: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+    }
+
+    progress.progress-ring {
+      --size: 200px;
+      --thickness: 18px;
+      --track-color: rgba(255, 255, 255, 0.15);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      --max: attr(max type(<number>));
+      appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      background: conic-gradient(var(--fill-color) calc(var(--value) / var(--max) * 100%),
+          var(--track-color) 0);
+      background-clip: border-area;
+      background-origin: border-box;
+      border: var(--thickness) solid transparent;
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.6s;
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        mask-image: radial-gradient(transparent calc(50% - var(--thickness)),
+            black calc(50% - var(--thickness) + 0.5px));
+        border: 0;
+      }
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    .ring-content {
