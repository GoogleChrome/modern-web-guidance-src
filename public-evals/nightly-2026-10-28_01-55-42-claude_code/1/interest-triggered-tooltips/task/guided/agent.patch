     .btn:hover {
       background: #3e2723;
     }
 
+    /* Seasonal Favorites: "View Details" info tooltips */
+    .btn[interestfor] {
+      /* Short hover delay before the tooltip opens; the polyfill reads the variables. */
+      --interest-delay-start: 0.15s;
+      interest-delay-start: var(--interest-delay-start);
+      --interest-delay-end: 0.2s;
+      interest-delay-end: var(--interest-delay-end);
+    }
+
+    .btn[interestfor]:is(:interest-source, .interest-source) {
+      background: #3e2723;
+    }
+
+    /* Visual indicator that more info is available */
+    .info-icon {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 1.1em;
+      height: 1.1em;
+      margin-left: 8px;
+      border: 1.5px solid currentColor;
+      border-radius: 50%;
+      font-size: 0.75em;
+      font-weight: bold;
+      font-style: normal;
+      line-height: 1;
+      vertical-align: 0.1em;
+    }
+
+    /* Each trigger/tooltip pair gets a unique anchor name so the
+       anchor-positioning polyfill can tether them explicitly. */
+    #details-maple { anchor-name: --details-maple; }
+    #details-espresso { anchor-name: --details-espresso; }
+    #details-cold-brew { anchor-name: --details-cold-brew; }
+    #tip-maple { position-anchor: --details-maple; }
+    #tip-espresso { position-anchor: --details-espresso; }
+    #tip-cold-brew { position-anchor: --details-cold-brew; }
+
+    .nutrition-tip {
+      /* Reset UA popover centering, then tether to the button:
+         centred above it, flipping below when there is no room. */
+      inset: auto;
+      bottom: anchor(top);
+      left: anchor(center);
+      translate: -50% 0;
+      margin: 0 0 10px;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+
+      width: max-content;
+      max-width: min(260px, 90vw);
+      padding: 0;
+      border: 0;
+      border-radius: 8px;
+      background: transparent;
+      color: var(--text);
+      font-size: 0.85rem;
+      line-height: 1.4;
+      text-align: left;
+      overflow: visible;
+    }
+
+    .nutrition-tip-content {
+      position: relative;
+      padding: 12px 14px;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
+    }
+
+    .nutrition-tip-content h4 {
+      margin-bottom: 6px;
+      font-size: 0.8rem;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      color: var(--accent);
+    }
+
+    .nutrition-tip-content dl {
+      display: grid;
+      grid-template-columns: auto auto;
+      gap: 2px 14px;
+    }
+
+    .nutrition-tip-content dt {
+      color: var(--secondary);
+    }
+
+    .nutrition-tip-content dd {
+      font-weight: 600;
+      text-align: right;
+    }
+
+    /* Arrow pointing at the button; only shown where the browser can tell
+       us which side the tooltip actually landed on. */
+    @supports (container-type: anchored) {
+      .nutrition-tip-content::after {
+        content: "";
+        position: absolute;
+        top: 100%;
+        left: 50%;
+        translate: -50% 0;
+        border: 7px solid transparent;
+        border-top-color: var(--primary);
+      }
+
+      @container anchored(fallback: flip-block) {
+        .nutrition-tip-content::after {
+          top: auto;
+          bottom: 100%;
+          border-top-color: transparent;
+          border-bottom-color: var(--primary);
+        }
+      }
+    }
+
     footer {
