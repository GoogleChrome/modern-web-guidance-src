+  <script>
+    (function () {
+      var root = document.documentElement;
+      var switchEl = document.getElementById('theme-switch');
+      if (!switchEl) return;
+
+      function render() {
+        var isDark = root.getAttribute('data-theme') === 'dark';
+        // aria-checked is the single source of truth screen readers announce
+        switchEl.setAttribute('aria-checked', String(isDark));
+      }
+
+      function setTheme(theme) {
+        root.setAttribute('data-theme', theme);
+        try {
+          localStorage.setItem('theme', theme);
+        } catch (e) {
+          /* storage unavailable (private mode, quota); theme still applies for this page */
+        }
+        render();
+      }
+
+      // Native <button> already handles Enter and Space, so one click handler covers
+      // mouse, touch, keyboard and assistive-technology activation.
+      switchEl.addEventListener('click', function () {
+        var isDark = switchEl.getAttribute('aria-checked') === 'true';
+        setTheme(isDark ? 'light' : 'dark');
+      });
+
+      // Keep multiple open tabs in sync
+      window.addEventListener('storage', function (event) {
+        if (event.key === 'theme' && (event.newValue === 'dark' || event.newValue === 'light')) {
+          root.setAttribute('data-theme', event.newValue);
+          render();
+        }
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
