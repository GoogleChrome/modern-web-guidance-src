+    /*
+     * WebGL ripple layer.
+     * The canvas sits underneath the real DOM content and draws a GPU-distorted
+     * copy of it. The real elements stay in the document (accessible, selectable,
+     * clickable) but their glyph fill / button background are made transparent
+     * once the shader is confirmed to be running (.gl-on). Without WebGL, or with
+     * prefers-reduced-motion, the hero renders exactly as before.
+     */
+    .hero-gl {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      display: block;
+      pointer-events: none;
+      z-index: 0;
