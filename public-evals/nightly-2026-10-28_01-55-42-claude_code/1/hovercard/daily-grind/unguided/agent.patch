+  <!-- Hovercard: shared preview panel for the Seasonal Favorites "View Details" links -->
+  <div class="hovercard" id="drink-hovercard" role="dialog" aria-labelledby="drink-hovercard-title" data-open="false" data-placement="bottom" hidden>
+    <span class="hovercard__arrow" aria-hidden="true"></span>
+    <img class="hovercard__image" id="drink-hovercard-image" src="" alt="" width="320" height="150" loading="lazy">
+    <div class="hovercard__body">
+      <p class="hovercard__eyebrow" id="drink-hovercard-eyebrow"></p>
+      <div class="hovercard__header">
+        <h4 class="hovercard__title" id="drink-hovercard-title"></h4>
+        <span class="hovercard__price" id="drink-hovercard-price"></span>
+      </div>
+      <p class="hovercard__desc" id="drink-hovercard-desc"></p>
+      <ul class="hovercard__tags" id="drink-hovercard-tags" aria-label="Highlights"></ul>
+      <dl class="hovercard__facts" id="drink-hovercard-facts"></dl>
+      <div class="hovercard__sizes" id="drink-hovercard-sizes" role="group" aria-label="Size"></div>
+      <div class="hovercard__actions">
+        <a class="btn" id="drink-hovercard-link" href="#">Open page</a>
+        <span class="hovercard__url" id="drink-hovercard-url"></span>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      var DRINKS = {
+        'maple-oat-latte': {
+          eyebrow: 'Seasonal · Hot or Iced',
+          title: 'Maple Oat Latte',
+          description: 'Double shot of our house espresso, steamed oat milk, and real Vermont maple syrup, finished with a dusting of cinnamon.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=640&q=70',
+          alt: 'Latte with leaf-shaped foam art in a white ceramic cup',
+          tags: ['Dairy-free', 'Limited time', 'Fan favorite'],
+          facts: { Calories: '210', Caffeine: '150 mg', Roast: 'Medium' },
+          sizes: [['Small', 4.75], ['Medium', 5.25], ['Large', 5.75]]
+        },
+        'dark-roast-espresso': {
+          eyebrow: 'Espresso Bar · Always available',
+          title: 'Dark Roast Espresso',
+          description: 'Single-origin Sumatran beans roasted dark for a bold, smoky shot with notes of cocoa and toasted walnut.',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=640&q=70',
+          alt: 'Espresso shot being pulled into a small cup',
+          tags: ['Vegan', 'Single origin', 'Bold'],
+          facts: { Calories: '5', Caffeine: '75 mg / shot', Roast: 'Dark' },
+          sizes: [['Single', 2.50], ['Double', 3.25], ['Triple', 3.95]]
+        },
+        'cold-brew': {
+          eyebrow: 'Cold Drinks · Brewed daily',
+          title: 'Cold Brew',
+          description: 'Coarse-ground Colombian beans steeped for 18 hours in filtered water for a naturally sweet, low-acid cup served over ice.',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=640&q=70',
+          alt: 'Glass of iced cold brew coffee on a wooden table',
+          tags: ['Vegan', 'Low acid', 'Smooth'],
+          facts: { Calories: '15', Caffeine: '200 mg', Roast: 'Medium' },
+          sizes: [['Small', 3.95], ['Medium', 4.50], ['Large', 4.95]]
+        }
+      };
+
+      var card = document.getElementById('drink-hovercard');
+      if (!card) return;
+
+      var el = {
+        image: document.getElementById('drink-hovercard-image'),
+        eyebrow: document.getElementById('drink-hovercard-eyebrow'),
+        title: document.getElementById('drink-hovercard-title'),
+        price: document.getElementById('drink-hovercard-price'),
+        desc: document.getElementById('drink-hovercard-desc'),
+        tags: document.getElementById('drink-hovercard-tags'),
+        facts: document.getElementById('drink-hovercard-facts'),
+        sizes: document.getElementById('drink-hovercard-sizes'),
+        link: document.getElementById('drink-hovercard-link'),
+        url: document.getElementById('drink-hovercard-url')
+      };
+
+      var OPEN_DELAY = 250;
+      var CLOSE_DELAY = 200;
+      var GAP = 12;
+      var openTimer = null;
+      var closeTimer = null;
+      var activeTrigger = null;
+
+      function formatPrice(n) {
+        return '$' + n.toFixed(2);
+      }
+
+      function clearTimers() {
+        clearTimeout(openTimer);
+        clearTimeout(closeTimer);
+        openTimer = closeTimer = null;
+      }
+
+      function render(trigger) {
+        var drink = DRINKS[trigger.getAttribute('data-hovercard')];
+        if (!drink) return false;
+
+        el.image.src = drink.image;
+        el.image.alt = drink.alt;
+        el.eyebrow.textContent = drink.eyebrow;
+        el.title.textContent = drink.title;
+        el.desc.textContent = drink.description;
+
+        el.tags.innerHTML = '';
+        drink.tags.forEach(function (t) {
+          var li = document.createElement('li');
+          li.textContent = t;
+          el.tags.appendChild(li);
+        });
+
+        el.facts.innerHTML = '';
+        Object.keys(drink.facts).forEach(function (k) {
+          var wrap = document.createElement('div');
+          var dt = document.createElement('dt');
+          var dd = document.createElement('dd');
+          dt.textContent = k;
+          dd.textContent = drink.facts[k];
+          wrap.appendChild(dt);
+          wrap.appendChild(dd);
+          el.facts.appendChild(wrap);
+        });
+
+        el.sizes.innerHTML = '';
+        drink.sizes.forEach(function (size, i) {
+          var b = document.createElement('button');
+          b.type = 'button';
+          b.className = 'hovercard__size';
+          b.textContent = size[0];
+          b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
+          b.addEventListener('click', function () {
+            Array.prototype.forEach.call(el.sizes.children, function (c) {
+              c.setAttribute('aria-pressed', 'false');
+            });
+            b.setAttribute('aria-pressed', 'true');
+            el.price.textContent = formatPrice(size[1]);
+          });
+          el.sizes.appendChild(b);
+        });
+        el.price.textContent = formatPrice(drink.sizes[0][1]);
+
+        var href = trigger.getAttribute('href');
+        el.link.href = href;
+        el.link.textContent = 'Open ' + drink.title;
+        el.url.textContent = location.host + href;
+        el.url.title = href;
+        return true;
+      }
+
+      function position(trigger) {
+        var r = trigger.getBoundingClientRect();
+        var cw = card.offsetWidth;
+        var ch = card.offsetHeight;
+        var vw = document.documentElement.clientWidth;
+        var vh = window.innerHeight;
+        var scrollX = window.pageXOffset;
+        var scrollY = window.pageYOffset;
+
+        var placement = 'bottom';
+        if (r.bottom + GAP + ch > vh && r.top - GAP - ch > 0) placement = 'top';
+
+        var left = r.left + r.width / 2 - cw / 2;
+        left = Math.max(12, Math.min(left, vw - cw - 12));
+        var top = placement === 'bottom' ? r.bottom + GAP : r.top - GAP - ch;
+
+        var arrowLeft = r.left + r.width / 2 - left;
+        arrowLeft = Math.max(16, Math.min(arrowLeft, cw - 16));
+
+        card.setAttribute('data-placement', placement);
+        card.style.setProperty('--arrow-left', arrowLeft + 'px');
+        card.style.left = (left + scrollX) + 'px';
+        card.style.top = (top + scrollY) + 'px';
+      }
+
+      function open(trigger) {
+        if (activeTrigger === trigger && card.getAttribute('data-open') === 'true') return;
+        if (!render(trigger)) return;
+        activeTrigger = trigger;
+        trigger.setAttribute('aria-expanded', 'true');
+        card.hidden = false;
+        position(trigger);
+        // Force a frame so the transition plays from the hidden state.
+        card.getBoundingClientRect();
+        card.setAttribute('data-open', 'true');
+      }
+
+      function close() {
+        clearTimers();
+        if (activeTrigger) activeTrigger.setAttribute('aria-expanded', 'false');
+        activeTrigger = null;
+        card.setAttribute('data-open', 'false');
+        var onEnd = function () {
+          if (card.getAttribute('data-open') === 'false') card.hidden = true;
+          card.removeEventListener('transitionend', onEnd);
+        };
+        card.addEventListener('transitionend', onEnd);
+      }
+
+      function scheduleOpen(trigger) {
+        clearTimers();
+        openTimer = setTimeout(function () { open(trigger); }, OPEN_DELAY);
+      }
+
+      function scheduleClose() {
+        clearTimers();
+        closeTimer = setTimeout(close, CLOSE_DELAY);
+      }
+
+      var triggers = document.querySelectorAll('[data-hovercard]');
+      Array.prototype.forEach.call(triggers, function (trigger) {
+        trigger.setAttribute('aria-haspopup', 'dialog');
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.setAttribute('aria-controls', card.id);
+
+        trigger.addEventListener('mouseenter', function () { scheduleOpen(trigger); });
+        trigger.addEventListener('mouseleave', scheduleClose);
+        trigger.addEventListener('focus', function () { scheduleOpen(trigger); });
+        trigger.addEventListener('blur', scheduleClose);
+      });
+
+      // Keep the card open while the pointer or focus is inside it (it's interactive).
+      card.addEventListener('mouseenter', clearTimers);
+      card.addEventListener('mouseleave', scheduleClose);
+      card.addEventListener('focusin', clearTimers);
+      card.addEventListener('focusout', function (e) {
+        if (!card.contains(e.relatedTarget)) scheduleClose();
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && activeTrigger) {
+          var t = activeTrigger;
+          close();
+          t.focus();
+        }
+      });
+
+      window.addEventListener('scroll', function () {
+        if (activeTrigger) position(activeTrigger);
+      }, { passive: true });
+      window.addEventListener('resize', function () {
+        if (activeTrigger) position(activeTrigger);
+      });
+    })();
+  </script>
+
