+  <script type="module">
+    // Hovercard progressive enhancement: load each polyfill only where the native API
+    // is missing. Order matters, as the interest invoker polyfill builds on popovers.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+    }
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@1.0.10/src/interestfor.min.js");
+    }
+    if (!("anchorName" in document.documentElement.style)) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning@0.10.2/dist/css-anchor-positioning.js");
+    }
+  </script>
+
