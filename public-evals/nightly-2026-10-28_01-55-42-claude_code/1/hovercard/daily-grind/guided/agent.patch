+
+    [popover].hovercard {
+      /* Reset the UA popover defaults (inset: 0; margin: auto) so the anchor insets apply.
+         Without anchor positioning support, the card falls back to centered on screen. */
+      inset: auto;
+      margin: 0;
+      padding: 0;
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      width: 20rem;
+      max-width: calc(100vw - 2rem);
+      overflow: hidden;
+      background: white;
+      color: var(--text);
+      text-align: left;
+      font-size: 0.9rem;
+      box-shadow: 0 12px 32px rgba(62, 39, 35, 0.25);
+
+      /* Sit just below the trigger, aligned to its left edge. Insets (not position-area)
