+      top: anchor(bottom);
+      left: anchor(left);
+      margin-top: 0.5rem;
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      opacity: 0;
+      transform: translateY(-8px) scale(0.97);
+      transform-origin: top;
+    }
+
+    /* `.\:popover-open` is the class the popover polyfill applies in place of :popover-open. */
