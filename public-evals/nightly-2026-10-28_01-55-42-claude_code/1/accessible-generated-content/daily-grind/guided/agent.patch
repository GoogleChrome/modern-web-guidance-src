+    /* Section title: decorative sparkle glyphs on either side plus an accent underline.
+       The glyphs are text, so the `/ ""` alt argument hides them from screen readers. */
+    .section-title {
+      text-align: center;
+      color: var(--primary);
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 2px;
+      text-underline-offset: 0.35em;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      /* Fallback for browsers without the `/` alt syntax (glyph still renders there) */
+      content: "\2726";
+      content: "\2726" / "";
+      color: var(--accent);
+      font-size: 0.6em;
+      vertical-align: 0.25em;
+      margin-inline: 0.75em;
+      pointer-events: none;
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Drink heading icon: an empty-string pseudo-element carrying a masked SVG.
+       Empty `content` exposes nothing to assistive technology; the heading text
+       in the DOM remains the only thing announced. */
+    .card h3::before {
+      content: "";
+      display: inline-block;
+      width: 1em;
+      height: 1em;
+      background-color: var(--accent);
+      mask: var(--icon-coffee) no-repeat center / contain;
+      /* Center on the cap height, nudged slightly up for optical balance */
