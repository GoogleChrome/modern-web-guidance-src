+    /* ------------------------------------------------------------------
+       Decorative icons & flourishes
+       ------------------------------------------------------------------
+       Every icon below is drawn with CSS only (gradients, borders,
+       transforms). Accessibility rules applied throughout:
+
+       - Pseudo-elements use an empty string for `content`, and also the
+         newer `content: "" / ""` form, which explicitly declares empty
+         alternative text. Either way assistive tech has nothing to read.
+         No glyphs or emoji are placed in `content`, since several screen
+         readers announce generated text.
+       - Real elements used purely for decoration (ornaments, drink icons)
+         are empty and carry aria-hidden="true", so they are removed from
+         the accessibility tree while the heading/link text stays intact.
+       - Buttons keep their visible text as the accessible name; the
+         "View Details" links also get a visually hidden drink name so
+         screen-reader users can tell the three identical links apart.
+       - Hover motion is disabled under prefers-reduced-motion, and
+         background-drawn icons are hidden in forced-colors (high
+         contrast) mode, where backgrounds are stripped and they would
+         otherwise render as broken fragments.
+       ------------------------------------------------------------------ */
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    /* Section heading: fading rules on each side plus diamond ornaments */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 14px;
+      text-align: center;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      content: "";
+      content: "" / "";
+      flex: 0 1 110px;
+      height: 2px;
+      border-radius: 1px;
+      background: linear-gradient(to right, transparent, var(--accent));
+    }
+
+    .section-title::after {
+      background: linear-gradient(to left, transparent, var(--accent));
+    }
+
+    .ornament {
+      display: inline-block;
+      position: relative;
+      width: 12px;
+      height: 12px;
+      flex: none;
+      border: 2px solid var(--accent);
+      transform: rotate(45deg);
+    }
+
+    .ornament::before {
+      content: "";
+      content: "" / "";
+      position: absolute;
+      inset: 2px;
+      background: var(--primary);
+    }
+
+    /* Drink icons: a round badge with a CSS-drawn motif inside */
+    .drink-icon {
+      display: block;
+      position: relative;
+      width: 60px;
+      height: 60px;
+      margin: 0 auto 12px;
+      border-radius: 50%;
+      background: var(--secondary);
+      box-shadow: inset 0 0 0 3px white, 0 0 0 2px var(--accent);
+    }
+
+    .drink-icon::before,
+    .drink-icon::after {
+      content: "";
+      content: "" / "";
+      position: absolute;
+    }
+
+    /* Latte: steaming mug. Steam = three bars in the badge background,
+       mug body = ::before, handle = ::after tucked behind the body. */
+    .drink-icon--latte {
+      background:
+        linear-gradient(rgba(78, 52, 46, 0.55), rgba(78, 52, 46, 0.55)) 22px 12px / 3px 10px no-repeat,
+        linear-gradient(rgba(78, 52, 46, 0.55), rgba(78, 52, 46, 0.55)) 28px 9px / 3px 13px no-repeat,
+        linear-gradient(rgba(78, 52, 46, 0.55), rgba(78, 52, 46, 0.55)) 34px 12px / 3px 10px no-repeat,
+        var(--secondary);
+    }
+
+    .drink-icon--latte::before {
+      left: 17px;
+      top: 27px;
+      width: 24px;
+      height: 18px;
+      background: var(--primary);
+      border-radius: 2px 2px 10px 10px;
+      z-index: 1;
+    }
+
+    .drink-icon--latte::after {
+      left: 36px;
+      top: 29px;
+      width: 12px;
+      height: 12px;
+      border: 3px solid var(--primary);
+      border-radius: 50%;
+    }
+
+    /* Espresso: a coffee bean with its centre crease */
+    .drink-icon--bean::before {
+      left: 21px;
+      top: 15px;
+      width: 18px;
+      height: 30px;
+      background: var(--primary);
+      border-radius: 50%;
+      transform: rotate(-30deg);
+    }
+
+    .drink-icon--bean::after {
+      left: 26px;
+      top: 17px;
+      width: 9px;
+      height: 26px;
+      border-left: 3px solid var(--secondary);
+      border-radius: 50%;
+      transform: rotate(-30deg);
+    }
+
+    /* Cold brew: tall glass with ice. Straw = diagonal stripe in the
+       badge background, glass = ::before, ice cube = ::after. */
+    .drink-icon--cold {
+      background:
+        linear-gradient(115deg, transparent 44%, var(--accent) 44%, var(--accent) 56%, transparent 56%) 30px 9px / 14px 18px no-repeat,
+        var(--secondary);
+    }
+
+    .drink-icon--cold::before {
+      left: 20px;
+      top: 17px;
+      width: 20px;
+      height: 28px;
+      border: 3px solid var(--primary);
+      border-radius: 2px 2px 7px 7px;
+      background: linear-gradient(transparent 35%, rgba(78, 52, 46, 0.4) 35%);
+    }
+
+    .drink-icon--cold::after {
+      left: 26px;
+      top: 29px;
+      width: 8px;
+      height: 8px;
+      border: 2px solid var(--primary);
+      border-radius: 1px;
+      background: white;
+      transform: rotate(15deg);
+    }
+
+    /* Buttons: trailing chevron that nudges right on hover/focus */
+    .btn::after {
+      content: "";
+      content: "" / "";
+      flex: none;
+      width: 8px;
+      height: 8px;
+      border-top: 2px solid currentColor;
+      border-right: 2px solid currentColor;
+      transform: rotate(45deg);
+      transition: transform 0.3s;
+    }
+
+    .btn:hover::after,
+    .btn:focus-visible::after {
+      transform: translateX(4px) rotate(45deg);
+    }
+
+    /* Hero call to action: leading accent bean */
+    .btn--hero::before {
+      content: "";
+      content: "" / "";
+      flex: none;
+      width: 9px;
+      height: 14px;
+      border-radius: 50%;
+      background: var(--accent);
+      box-shadow: inset 2px 0 0 var(--primary);
+      transform: rotate(-30deg);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn,
+      .btn::after {
+        transition: none;
+      }
+
+      .btn:hover::after,
+      .btn:focus-visible::after {
+        transform: rotate(45deg);
+      }
+    }
+
+    @media (forced-colors: active) {
+      .drink-icon,
+      .ornament,
+      .section-title::before,
+      .section-title::after,
+      .btn--hero::before {
+        display: none;
+      }
+    }
   </style>
