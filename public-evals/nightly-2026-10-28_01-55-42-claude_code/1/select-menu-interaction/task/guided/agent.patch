+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const select = document.getElementById('shop');
+      if (!form || !select) return;
+
+      const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+      let hasInteracted = false;
+      let submitAttempted = false;
+
+      // Mirror the visual error state onto aria-invalid so assistive tech
+      // learns about the error at the same moment it becomes visible.
+      // In browsers without :user-invalid, also toggle the fallback classes.
+      const syncState = () => {
+        let showError;
+        if (supportsUserInvalid) {
+          showError = select.matches(':user-invalid');
+        } else {
+          const valid = select.checkValidity();
+          const touched = hasInteracted || submitAttempted;
+          showError = !valid && touched;
+          select.classList.toggle('user-invalid-fallback', showError);
+          select.classList.toggle('user-valid-fallback', valid && touched);
+        }
+        if (showError) {
+          select.setAttribute('aria-invalid', 'true');
+        } else {
+          select.removeAttribute('aria-invalid');
+        }
+      };
+
+      select.addEventListener('change', () => {
+        hasInteracted = true;
+        syncState();
+      });
+      select.addEventListener('blur', syncState);
+
+      // A submit attempt on an empty required select fires "invalid" (and the
+      // browser marks the field as user-interacted). Show the inline message
+      // in place of the browser's default bubble.
+      select.addEventListener('invalid', (event) => {
+        event.preventDefault();
+        submitAttempted = true;
+        syncState();
+        select.focus();
+      });
+
+      form.addEventListener('reset', () => {
+        hasInteracted = false;
+        submitAttempted = false;
+        select.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+        select.removeAttribute('aria-invalid');
+      });
+    })();
+  </script>
+
