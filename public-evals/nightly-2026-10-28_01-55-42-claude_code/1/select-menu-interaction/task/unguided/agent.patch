+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var shopField = document.getElementById('shop-field');
+      var shop = document.getElementById('shop');
+      var shopError = document.getElementById('shop-error');
+
+      // Show or hide the shop error. Only called after the user has interacted
+      // with the select or attempted to submit, so nothing appears on page load.
+      function validateShop() {
+        var valid = shop.value !== '';
+        shop.setAttribute('aria-invalid', valid ? 'false' : 'true');
+        shopError.hidden = valid;
+        return valid;
+      }
+
+      function markTouched() {
+        shopField.classList.add('touched');
+        validateShop();
+      }
+
+      shop.addEventListener('change', markTouched);
+      shop.addEventListener('blur', markTouched);
+
+      form.addEventListener('submit', function (event) {
+        form.classList.add('submitted');
+        if (!validateShop()) {
+          event.preventDefault();
+          shop.focus();
+        }
+      });
+    })();
+  </script>
+
