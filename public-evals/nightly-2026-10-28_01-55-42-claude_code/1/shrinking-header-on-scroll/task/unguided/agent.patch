+  <script>
+    /* Shrinking-nav fallbacks. Written in ES5 so it also runs in old
+       browsers. Modern browsers with CSS scroll-driven animations get the
+       effect from CSS alone and this script exits immediately. */
+    (function () {
+      var nav = document.querySelector('nav');
+      if (!nav) { return; }
+
+      var supports = function (condition) {
+        try {
+          return !!(window.CSS && CSS.supports && CSS.supports(condition));
+        } catch (e) { return false; }
+      };
+
+      /* Tier 1: CSS handles everything. */
+      if (supports('(animation-timeline: scroll())')) { return; }
+
+      var SHRINK_DISTANCE = 160;
+      var html = document.documentElement;
+      var progressMode = supports('(--a: 0)');
+      var ticking = false;
+      var lastValue = null;
+
+      var raf = window.requestAnimationFrame || function (cb) { return window.setTimeout(cb, 16); };
+
+      function scrollTop() {
+        return window.pageYOffset || html.scrollTop || document.body.scrollTop || 0;
+      }
+
+      function update() {
+        ticking = false;
+        var y = scrollTop();
+
+        if (progressMode) {
+          /* Tier 2: continuous value tied to scroll position. */
+          var progress = y / SHRINK_DISTANCE;
+          if (progress < 0) { progress = 0; }
+          if (progress > 1) { progress = 1; }
+          progress = Math.round(progress * 1000) / 1000;
+          if (progress !== lastValue) {
+            lastValue = progress;
+            html.style.setProperty('--nav-progress', progress);
+          }
+        } else {
+          /* Tier 3: threshold class toggle, CSS transitions do the easing. */
+          var compact = y > SHRINK_DISTANCE / 2;
+          if (compact !== lastValue) {
+            lastValue = compact;
+            if (compact) { nav.classList.add('nav--compact'); }
+            else { nav.classList.remove('nav--compact'); }
+          }
+        }
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          raf(update);
+        }
+      }
+
+      if (progressMode) { html.className += ' nav-progress-mode'; }
+
+      var listenerOptions = false;
+      try {
+        /* Passive listeners keep scrolling smooth where supported. */
+        var opts = Object.defineProperty({}, 'passive', {
+          get: function () { listenerOptions = { passive: true }; return true; }
+        });
+        window.addEventListener('test', null, opts);
+        window.removeEventListener('test', null, opts);
+      } catch (e) { listenerOptions = false; }
+
+      window.addEventListener('scroll', onScroll, listenerOptions);
+      window.addEventListener('resize', onScroll, listenerOptions);
+      update();
+    })();
+  </script>
