+  <script>
+    // Fallback for browsers without CSS scroll-driven animations (e.g. Firefox,
+    // Safari < 26, Chrome < 115). Recreates the shrink with a scroll listener,
+    // throttled to one update per frame. Written in ES5 so it also runs in
+    // older engines.
+    (function () {
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsScrollTimeline) return;
+
+      var reduceMotion =
+        typeof window.matchMedia === 'function' &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (reduceMotion) return; // CSS already renders the static compact bar
+
+      var nav = document.querySelector('nav');
+      var logo = nav && nav.querySelector('.logo');
+      if (!nav || !logo) return;
+
+      // Read the same values the CSS uses, with defaults for very old browsers
+      // that lack custom properties.
+      var rootStyle = window.getComputedStyle(document.documentElement);
+      function readPx(name, fallback) {
+        var v = parseFloat(rootStyle.getPropertyValue(name));
+        return isNaN(v) ? fallback : v;
+      }
+      var startHeight = readPx('--nav-h-start', 72);
+      var endHeight = readPx('--nav-h-end', 48);
+      var distance = readPx('--nav-shrink-distance', 120);
+      var logoScaleEnd = readPx('--logo-scale-end', 0.8);
+
+      var ticking = false;
+      var raf = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); };
+
+      function update() {
+        ticking = false;
+        var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(1, Math.max(0, scrollY / distance));
+        nav.style.height = (startHeight - (startHeight - endHeight) * progress) + 'px';
+        nav.style.boxShadow = '0 2px 8px rgba(0, 0, 0, ' + (0.35 * progress).toFixed(3) + ')';
+        logo.style.transform = 'scale(' + (1 - (1 - logoScaleEnd) * progress).toFixed(4) + ')';
+      }
+
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        raf(update);
+      }
+
+      // Passive listener where supported; falls back to the boolean form.
+      var passive = false;
+      try {
+        window.addEventListener('test', null, Object.defineProperty({}, 'passive', {
+          get: function () { passive = { passive: true }; }
+        }));
+      } catch (e) {}
+      window.addEventListener('scroll', onScroll, passive);
+      window.addEventListener('resize', onScroll, passive);
+
+      update(); // Apply the correct state if the page loads already scrolled
+    })();
+  </script>
