+  <script>
+    (function () {
+      var list = document.getElementById('cart-list');
+      if (!list) return;
+
+      var emptyMsg = document.getElementById('cart-empty');
+      var summary = document.getElementById('cart-summary');
+      var subtotalEl = document.getElementById('cart-subtotal');
+
+      // Fraction of the item's width the user must swipe before release removes it.
+      var THRESHOLD_RATIO = 0.4;
+      // Ignore tiny movements so taps/clicks don't register as swipes.
+      var DRAG_SLOP = 6;
+
+      var reduceMotion = window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      function updateSubtotal() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (li) {
+          total += parseFloat(li.getAttribute('data-price')) || 0;
+        });
+        subtotalEl.textContent = '$' + total.toFixed(2);
+        var isEmpty = items.length === 0;
+        emptyMsg.hidden = !isEmpty;
+        summary.hidden = isEmpty;
+      }
+
+      function collapseAndRemove(li) {
+        if (li.classList.contains('is-removing')) return;
+        // Lock in the current height so the transition to 0 has a start value.
+        li.style.height = li.offsetHeight + 'px';
+        // Force a reflow so the explicit height is applied before we change it.
+        void li.offsetHeight;
+        li.classList.add('is-removing');
+        updateSubtotal();
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          li.remove();
+        }
+        if (reduceMotion) {
+          finish();
+          return;
+        }
+        li.addEventListener('transitionend', function (e) {
+          if (e.propertyName === 'height') finish();
+        });
+        // Safety net in case transitionend never fires.
+        setTimeout(finish, 400);
+      }
+
+      function removeItem(li, content, track) {
+        // Slide the content fully off-screen, then collapse the row.
+        content.classList.add('is-settling');
+        content.style.transform = 'translateX(-100%)';
+        track.classList.add('is-past-threshold');
+        track.style.setProperty('--swipe-progress', '1');
+        if (reduceMotion) {
+          collapseAndRemove(li);
+          return;
+        }
+        var fired = false;
+        function onSlideOut() {
+          if (fired) return;
+          fired = true;
+          collapseAndRemove(li);
+        }
+        content.addEventListener('transitionend', onSlideOut, { once: true });
+        setTimeout(onSlideOut, 300);
+      }
+
+      function attachSwipe(li) {
+        var track = li.querySelector('.SwipeableList-track');
+        var content = li.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        var startX = 0;
+        var startY = 0;
+        var currentX = 0;
+        var pointerId = null;
+        var dragging = false;
+        var axisLocked = false;
+
+        function setOffset(dx) {
+          currentX = dx;
+          content.style.transform = 'translateX(' + dx + 'px)';
+          var progress = Math.min(1, Math.abs(dx) / (content.offsetWidth * THRESHOLD_RATIO));
+          track.style.setProperty('--swipe-progress', progress.toFixed(3));
+          track.classList.toggle('is-past-threshold', progress >= 1);
+        }
+
+        function reset() {
+          content.classList.add('is-settling');
+          content.style.transform = '';
+          track.style.setProperty('--swipe-progress', '0');
+          track.classList.remove('is-past-threshold');
+        }
+
+        function endDrag(e) {
+          if (pointerId === null || e.pointerId !== pointerId) return;
+          if (content.hasPointerCapture && content.hasPointerCapture(pointerId)) {
+            content.releasePointerCapture(pointerId);
+          }
+          pointerId = null;
+          content.classList.remove('is-dragging');
+
+          var wasDragging = dragging;
+          dragging = false;
+          axisLocked = false;
+          if (!wasDragging) return;
+
+          var threshold = content.offsetWidth * THRESHOLD_RATIO;
+          if (e.type !== 'pointercancel' && -currentX >= threshold) {
+            removeItem(li, content, track);
+          } else {
+            reset();
+          }
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (li.classList.contains('is-removing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          // Let the fallback button behave normally.
+          if (e.target.closest('.SwipeableList-remove')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          currentX = 0;
+          dragging = false;
+          axisLocked = false;
+          content.classList.remove('is-settling');
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (pointerId === null || e.pointerId !== pointerId) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+
+          if (!axisLocked) {
+            if (Math.abs(dx) < DRAG_SLOP && Math.abs(dy) < DRAG_SLOP) return;
+            axisLocked = true;
+            // Mostly vertical: this is a scroll, not a swipe.
+            if (Math.abs(dy) > Math.abs(dx)) {
+              pointerId = null;
+              return;
+            }
+            dragging = true;
+            content.classList.add('is-dragging');
+            content.setPointerCapture && content.setPointerCapture(pointerId);
+          }
+
+          if (!dragging) return;
+          // Only allow swiping left; apply resistance when pulling right.
+          if (dx > 0) dx = dx * 0.15;
+          setOffset(dx);
+        });
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+        content.addEventListener('lostpointercapture', function () {
+          if (pointerId !== null) {
+            // Capture was lost without pointerup (e.g. element detached). Snap back.
+            pointerId = null;
+            dragging = false;
+            axisLocked = false;
+            content.classList.remove('is-dragging');
+            reset();
+          }
+        });
+
+        content.addEventListener('transitionend', function (e) {
+          if (e.propertyName === 'transform' && !li.classList.contains('is-removing') &&
+              content.style.transform === '') {
+            content.classList.remove('is-settling');
+          }
+        });
+
+        var btn = li.querySelector('.SwipeableList-remove');
+        if (btn) {
+          btn.addEventListener('click', function () {
+            removeItem(li, content, track);
+          });
+        }
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(attachSwipe);
+      updateSubtotal();
+    })();
+  </script>
+
