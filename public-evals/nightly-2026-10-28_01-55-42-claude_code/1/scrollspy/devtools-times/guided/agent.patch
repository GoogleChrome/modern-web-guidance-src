new file mode 100644
index 0000000..f647f1d
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,133 @@
+---
+/**
+ * In-page section navigation that highlights the section currently in view.
+ *
+ * Uses the native CSS `scroll-target-group` / `:target-current` scrollspy where
+ * supported, with an IntersectionObserver fallback elsewhere. The visual state
+ * is mirrored to `aria-current` for assistive technologies in both paths.
+ */
+export interface Props {
+  sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+
+<nav
+  aria-label="On this page"
+  data-section-nav
+  class="section-nav sticky top-0 z-5 bg-white/95 backdrop-blur border-b border-gray-200"
+>
+  <ul class="container mx-auto px-4 flex items-center gap-x-6 h-10 text-sm font-semibold overflow-x-auto">
+    {sections.map(({ id, label }) => (
+      <li class="h-full flex items-center">
+        <a
+          href={`#${id}`}
+          class="flex items-center h-full border-b-2 border-transparent text-gray-600 hover:text-gray-900 whitespace-nowrap transition-colors"
+        >
+          {label}
+        </a>
+      </li>
+    ))}
+  </ul>
+</nav>
+
+<style>
+  /* Enables native tracking of the fragment links inside this container. */
+  .section-nav ul {
+    scroll-target-group: auto;
+  }
+
+  /*
+   * `:is()` keeps the rule valid in browsers that don't know `:target-current`;
+   * the escaped `.\:target-current` class is applied by the JS fallback.
+   * Colour is paired with weight and an underline so the state does not rely on colour alone.
+   */
+  .section-nav a:is(:target-current, .\:target-current) {
+    color: var(--color-amber-500);
+    border-bottom-color: var(--color-amber-400);
+    font-weight: 700;
+  }
+</style>
+
+<script>
+  const ACTIVE_CLASS = ':target-current';
+  let observer: IntersectionObserver | null = null;
+
+  function setActive(links: HTMLAnchorElement[], current: HTMLAnchorElement | null) {
+    for (const link of links) {
+      const isActive = link === current;
+      link.classList.toggle(ACTIVE_CLASS, isActive);
+      if (isActive) {
+        link.setAttribute('aria-current', 'true');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+  }
+
+  function getLinks(nav: Element): HTMLAnchorElement[] {
+    return Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+  }
+
+  function initNative(nav: Element) {
+    const links = getLinks(nav);
+    const sync = () => {
+      const current = nav.querySelector<HTMLAnchorElement>('a:target-current');
+      for (const link of links) {
+        if (link === current) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    };
+    sync();
+    document.addEventListener('scrollend', sync);
+    return () => document.removeEventListener('scrollend', sync);
+  }
+
+  function initFallback(nav: Element) {
+    const links = getLinks(nav);
+    const sections = links
+      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
+      .filter((el): el is HTMLElement => el !== null);
+
+    observer = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const current = links.find((link) => link.hash === `#${entry.target.id}`) ?? null;
+          setActive(links, current);
+        }
+      },
+      // Only the section crossing the vertical centre of the viewport counts as "current".
+      { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
+    );
+    sections.forEach((section) => observer!.observe(section));
+
+    return () => {
+      observer?.disconnect();
+      observer = null;
+    };
+  }
+
+  let cleanup: (() => void) | null = null;
+
+  function init() {
+    cleanup?.();
+    cleanup = null;
+
+    const nav = document.querySelector('[data-section-nav]');
+    if (!nav) return;
+
+    cleanup = CSS.supports('scroll-target-group: auto') ? initNative(nav) : initFallback(nav);
+  }
+
+  // Re-initialise after each client-side navigation (ClientRouter) and tear down before swap.
+  document.addEventListener('astro:page-load', init);
+  document.addEventListener('astro:before-swap', () => {
+    cleanup?.();
+    cleanup = null;
+  });
+</script>
