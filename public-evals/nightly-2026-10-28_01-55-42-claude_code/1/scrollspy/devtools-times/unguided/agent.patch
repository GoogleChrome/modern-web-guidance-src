+import React, { useCallback, useEffect, useRef, useState } from 'react';
+
+export interface SectionNavItem {
+    /** The `id` of the section element on the page. */
+    id: string;
+    /** Label shown in the navigation menu. */
+    label: string;
+}
+
+interface SectionNavProps {
+    sections: SectionNavItem[];
+}
+
+/**
+ * Sticky in-page navigation that highlights the section currently in view.
+ *
+ * The active section is the last one whose top edge has scrolled past the
+ * bottom edge of this nav bar. Once the page is scrolled to the very bottom the
+ * final section is marked active, even if it is too short to ever reach the
+ * probe line.
+ */
+const SectionNav: React.FC<SectionNavProps> = ({ sections }) => {
+    const navRef = useRef<HTMLElement>(null);
+    const [activeId, setActiveId] = useState<string | null>(null);
+
+    const updateActive = useCallback(() => {
+        const nav = navRef.current;
+        if (!nav || sections.length === 0) return;
+
+        const doc = document.documentElement;
+        const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 2;
+        if (atBottom) {
+            setActiveId(sections[sections.length - 1].id);
+            return;
+        }
+
+        // A small margin below the nav so a section counts as "visible" as soon
+        // as its heading has settled underneath the bar.
+        const probeLine = nav.getBoundingClientRect().bottom + 8;
+
+        let current: string | null = null;
+        for (const { id } of sections) {
+            const el = document.getElementById(id);
+            if (!el) continue;
+            if (el.getBoundingClientRect().top <= probeLine) {
+                current = id;
+            } else {
+                break;
+            }
+        }
+
+        setActiveId(current ?? sections[0].id);
+    }, [sections]);
+
+    useEffect(() => {
+        let frame = 0;
+        const schedule = () => {
+            if (frame) return;
+            frame = window.requestAnimationFrame(() => {
+                frame = 0;
+                updateActive();
+            });
+        };
+
+        updateActive();
+        window.addEventListener('scroll', schedule, { passive: true });
+        window.addEventListener('resize', schedule);
+
+        return () => {
+            if (frame) window.cancelAnimationFrame(frame);
+            window.removeEventListener('scroll', schedule);
+            window.removeEventListener('resize', schedule);
+        };
+    }, [updateActive]);
+
+    const handleClick = (event: React.MouseEvent<HTMLAnchorElement>, id: string) => {
+        const target = document.getElementById(id);
+        if (!target) return;
+        event.preventDefault();
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        history.replaceState(null, '', `#${id}`);
+        setActiveId(id);
+    };
+
+    return (
+        <nav
+            ref={navRef}
+            aria-label="Page sections"
+            className="sticky top-[100px] z-[5] bg-white/95 backdrop-blur border-b border-gray-300"
+        >
+            <ul className="max-w-6xl mx-auto px-4 sm:px-6 flex justify-center items-center space-x-6 text-sm font-semibold overflow-x-auto">
+                {sections.map(({ id, label }) => {
+                    const isActive = id === activeId;
+                    return (
+                        <li key={id} className="shrink-0">
+                            <a
+                                href={`#${id}`}
+                                onClick={(event) => handleClick(event, id)}
+                                aria-current={isActive ? 'location' : undefined}
+                                data-active={isActive ? 'true' : undefined}
+                                className={`block py-3 border-b-2 whitespace-nowrap transition-colors ${
+                                    isActive
+                                        ? 'text-gray-900 border-amber-400'
+                                        : 'text-gray-500 border-transparent hover:text-gray-900'
+                                }`}
+                            >
+                                {label}
+                            </a>
+                        </li>
+                    );
+                })}
+            </ul>
+        </nav>
+    );
+};
+
+export default SectionNav;
