+  <script type="module">
+    const navLinks = [...document.querySelectorAll('nav ul a[href^="#"]')];
+    const sections = navLinks
+      .map(link => document.getElementById(link.hash.slice(1)))
+      .filter(Boolean);
+
+    const setActive = (activeLink) => {
+      for (const link of navLinks) {
+        const isActive = link === activeLink;
+        link.classList.toggle('\:target-current', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // The browser handles the visual highlight via :target-current;
+      // mirror that state to aria-current for assistive technology.
+      const syncAriaCurrent = () => {
+        const current = document.querySelector('nav ul a:target-current');
+        for (const link of navLinks) {
+          if (link === current) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        }
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+      window.addEventListener('resize', syncAriaCurrent);
+    } else {
+      // Fallback: a section is active while it crosses the vertical centre of the viewport.
+      const linkFor = new Map(sections.map((section, i) => [section, navLinks[i]]));
+      const visible = new Set();
+
+      const update = () => {
+        // When several sections straddle the centre line, prefer the one lowest on the page.
+        const active = sections.filter(s => visible.has(s)).at(-1);
+        setActive(active ? linkFor.get(active) : null);
+      };
+
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.isIntersecting) {
+            visible.add(entry.target);
+          } else {
+            visible.delete(entry.target);
+          }
+        }
+        update();
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      sections.forEach(section => observer.observe(section));
+    }
+  </script>
+
