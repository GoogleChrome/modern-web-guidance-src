diff --git a/src/scripts/webmcp-tools.ts b/src/scripts/webmcp-tools.ts
new file mode 100644
index 0000000..5bb1c8c
--- /dev/null
+++ b/src/scripts/webmcp-tools.ts
@@ -0,0 +1,330 @@
+/**
+ * WebMCP Imperative API tools for The DevTools Times.
+ *
+ * Registered from the main layout on every page. Site-wide tools are always
+ * available; article utilities are added only while an article page is open.
+ * Registrations are torn down on Astro view-transition swaps so tools never
+ * leak across pages or collide on re-registration.
+ */
+import { navigate } from 'astro:transitions/client';
+import {
+  TOOL_NAMES,
+  describeReadingList,
+  type ArticleSummary,
+  type ReadingListResponse,
+} from '../utils/webmcp';
+
+const BASE_URL = import.meta.env.BASE_URL;
+const ARTICLES_ENDPOINT = `${BASE_URL}api/articles.json`;
+const READING_LIST_ENDPOINT = `${BASE_URL}api/reading-list.json`;
+const POPULARITY_ENDPOINT = `${BASE_URL}api/article-popularity`;
+
+type ToolInput = Record<string, unknown>;
+type ToolResult = Record<string, unknown>;
+
+/** Returns errors as values so the agent can read them and self-correct. */
+const toErrorResult = (error: unknown, signal: AbortSignal): ToolResult => {
+  if (signal.aborted) throw error;
+  return { error: error instanceof Error ? error.message : String(error) };
+};
+
+async function fetchJson<T>(url: string, signal: AbortSignal, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(url, { ...init, signal });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new Error(
+      typeof body?.error === 'string' ? body.error : `Request to ${url} failed with status ${response.status}`,
+    );
+  }
+  return body as T;
+}
+
+let articleIndex: ArticleSummary[] | null = null;
+async function getArticleIndex(signal: AbortSignal): Promise<ArticleSummary[]> {
+  if (!articleIndex) {
+    articleIndex = await fetchJson<ArticleSummary[]>(ARTICLES_ENDPOINT, signal);
+  }
+  return articleIndex;
+}
+
+const toPublicArticle = ({ slug, title, summary, author, category, date, readingTime, url }: ArticleSummary) => ({
+  slug,
+  title,
+  summary,
+  author,
+  category,
+  date,
+  readingTime,
+  url,
+});
+
+/* ------------------------------------------------------------------------- */
+/* Site-wide tools                                                            */
+/* ------------------------------------------------------------------------- */
+
+const listArticlesTool = {
+  name: TOOL_NAMES.listArticles,
+  description:
+    'Lists the articles published on The DevTools Times, newest first, with their slug, title, summary, author, category and date. Use it to browse the site or to find an article slug before opening or saving one.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      category: {
+        type: 'string',
+        description: 'Only include articles from this section, e.g. "science" or "sports". Matching is case-insensitive.',
+      },
+      limit: {
+        type: 'integer',
+        minimum: 1,
+        maximum: 100,
+        default: 100,
+        description: 'Maximum number of articles to return.',
+      },
+    },
+  },
+  // The browser does not validate input against `inputSchema` or apply defaults, so do both here.
+  async execute(input: ToolInput, { signal }: WebMCP.ToolExecuteCallbackOptions) {
+    const category = typeof input.category === 'string' ? input.category.trim() : '';
+    const limit = typeof input.limit === 'number' && Number.isInteger(input.limit) && input.limit > 0 ? Math.min(input.limit, 100) : 100;
+    try {
+      const articles = await getArticleIndex(signal);
+      const categories = [...new Set(articles.map((article) => article.category))];
+      let results = articles;
+      if (category) {
+        const wanted = category.toLowerCase();
+        results = results.filter((article) => article.category.toLowerCase() === wanted);
+        if (results.length === 0) {
+          return { error: `No articles in category "${category}".`, categories };
+        }
+      }
+      return {
+        total: results.length,
+        categories,
+        articles: results.slice(0, limit).map(toPublicArticle),
+      };
+    } catch (error) {
+      return toErrorResult(error, signal);
+    }
+  },
+  annotations: { readOnlyHint: true },
+} satisfies WebMCP.ModelContextTool;
+
+const getReadingListTool = {
+  name: TOOL_NAMES.getReadingList,
+  description:
+    "Returns the articles currently saved in the reader's reading list. Use it to check what the user has bookmarked before saving or removing articles.",
+  inputSchema: { type: 'object', properties: {} },
+  async execute(_input: ToolInput, { signal }: WebMCP.ToolExecuteCallbackOptions) {
+    try {
+      const [{ readingList }, articles] = await Promise.all([
+        fetchJson<ReadingListResponse>(READING_LIST_ENDPOINT, signal),
+        getArticleIndex(signal),
+      ]);
+      return {
+        count: readingList.length,
+        articles: describeReadingList(readingList, articles),
+      };
+    } catch (error) {
+      return toErrorResult(error, signal);
+    }
+  },
+  annotations: { readOnlyHint: true },
+} satisfies WebMCP.ModelContextTool;
+
+const openArticleTool = {
+  name: TOOL_NAMES.openArticle,
+  description:
+    'Navigates the current tab to the full page of an article so the user can read it. Use it after finding the article slug with the search or list tools.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      slug: {
+        type: 'string',
+        description: 'Slug identifying the article, e.g. "urban-cycling".',
+      },
+    },
+    required: ['slug'],
+  },
+  async execute(input: ToolInput, { signal }: WebMCP.ToolExecuteCallbackOptions) {
+    const slug = typeof input.slug === 'string' ? input.slug.trim() : '';
+    try {
+      const articles = await getArticleIndex(signal);
+      const article = slug ? articles.find((entry) => entry.slug === slug) : undefined;
+      if (!article) {
+        return { error: `No article with slug "${slug}".`, availableSlugs: articles.map((entry) => entry.slug) };
+      }
+      signal.throwIfAborted();
+      void navigate(article.url);
+      return { opened: toPublicArticle(article) };
+    } catch (error) {
+      return toErrorResult(error, signal);
+    }
+  },
+  annotations: { readOnlyHint: false },
+} satisfies WebMCP.ModelContextTool;
+
+/* ------------------------------------------------------------------------- */
+/* Article page utilities                                                     */
+/* ------------------------------------------------------------------------- */
+
+interface ArticlePageContext {
+  root: HTMLElement;
+  slug: string;
+  title: string;
+  author: string;
+  date: string;
+  category: string;
+  summary: string;
+  readingTime: number | null;
+}
+
+function readArticlePage(): ArticlePageContext | null {
+  const root = document.querySelector<HTMLElement>('[data-webmcp-article]');
+  if (!root?.dataset.articleSlug) return null;
+  const { articleSlug, articleTitle, articleAuthor, articleDate, articleCategory, articleSummary, articleReadingTime } =
+    root.dataset;
+  return {
+    root,
+    slug: articleSlug,
+    title: articleTitle ?? document.title,
+    author: articleAuthor ?? '',
+    date: articleDate ?? '',
+    category: articleCategory ?? '',
+    summary: articleSummary ?? '',
+    readingTime: articleReadingTime ? Number(articleReadingTime) : null,
+  };
+}
+
+const normalizeText = (text: string | null | undefined) => (text ?? '').replace(/\s+/g, ' ').trim();
+
+function getBodyHeadings(root: HTMLElement) {
+  return Array.from(root.querySelectorAll<HTMLHeadingElement>('[data-article-body] h2, [data-article-body] h3, [data-article-body] h4'))
+    .map((heading) => ({ level: Number(heading.tagName.slice(1)), text: normalizeText(heading.textContent), element: heading }))
+    .filter((heading) => heading.text.length > 0);
+}
+
+function createArticleTools(page: ArticlePageContext): WebMCP.ModelContextTool[] {
+  const { root, ...meta } = page;
+
+  const getCurrentArticleTool = {
+    name: TOOL_NAMES.getCurrentArticle,
+    description:
+      'Returns the article currently open on the page: its metadata, section headings, full body text, word count and the related articles shown beneath it. Use it to summarize, quote or answer questions about what the user is reading.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        includeBody: {
+          type: 'boolean',
+          default: true,
+          description: 'Whether to include the full article text. Set to false for a lightweight metadata-only response.',
+        },
+      },
+    },
+    execute(input: ToolInput) {
+      const includeBody = input.includeBody !== false;
+      const bodyText = normalizeText(root.querySelector('[data-article-body]')?.textContent);
+      const related = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-article-related] a[href*="/articles/"]'))
+        .map((link) => ({ title: normalizeText(link.querySelector('h3')?.textContent), url: link.href }))
+        .filter((link, index, all) => link.title && all.findIndex((other) => other.url === link.url) === index);
+      return {
+        ...meta,
+        url: location.href,
+        wordCount: bodyText ? bodyText.split(' ').length : 0,
+        headings: getBodyHeadings(root).map(({ level, text }) => ({ level, text })),
+        ...(includeBody ? { body: bodyText } : {}),
+        relatedArticles: related,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  } satisfies WebMCP.ModelContextTool;
+
+  const getArticlePopularityTool = {
+    name: TOOL_NAMES.getArticlePopularity,
+    description:
+      'Fetches live popularity statistics (view count and trending status) for the article currently open on the page.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input: ToolInput, { signal }: WebMCP.ToolExecuteCallbackOptions) {
+      try {
+        const stats = await fetchJson<{ id: string; views: number; trending: boolean }>(
+          `${POPULARITY_ENDPOINT}?id=${encodeURIComponent(meta.slug)}`,
+          signal,
+        );
+        return { slug: meta.slug, title: meta.title, views: stats.views, trending: stats.trending };
+      } catch (error) {
+        return toErrorResult(error, signal);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  } satisfies WebMCP.ModelContextTool;
+
+  const jumpToSectionTool = {
+    name: TOOL_NAMES.jumpToArticleSection,
+    description:
+      'Scrolls the page to a section of the article currently open, identified by its heading text. Use it to take the user to the part of the article they asked about.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        heading: {
+          type: 'string',
+          description: 'Heading text (or a distinctive part of it) of the section to scroll to. Matching is case-insensitive.',
+        },
+      },
+      required: ['heading'],
+    },
+    execute(input: ToolInput) {
+      const heading = typeof input.heading === 'string' ? input.heading : '';
+      const headings = getBodyHeadings(root);
+      const wanted = normalizeText(heading).toLowerCase();
+      const match =
+        headings.find((entry) => entry.text.toLowerCase() === wanted) ??
+        headings.find((entry) => wanted && entry.text.toLowerCase().includes(wanted));
+      if (!match) {
+        return {
+          error: `No section heading matches "${heading}".`,
+          availableHeadings: headings.map((entry) => entry.text),
+        };
+      }
+      match.element.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      return { scrolledTo: match.text, level: match.level };
+    },
+    annotations: { readOnlyHint: false },
+  } satisfies WebMCP.ModelContextTool;
+
+  return [getCurrentArticleTool, getArticlePopularityTool, jumpToSectionTool];
+}
+
+/* ------------------------------------------------------------------------- */
+/* Lifecycle                                                                  */
+/* ------------------------------------------------------------------------- */
+
+let registration: AbortController | null = null;
+
+function unregisterTools() {
+  registration?.abort();
+  registration = null;
+}
+
+function registerTools() {
+  unregisterTools();
+  const modelContext = document.modelContext;
+  if (!modelContext) return;
+
+  registration = new AbortController();
+  const options: WebMCP.ModelContextRegisterToolOptions = { signal: registration.signal };
+
+  const tools: WebMCP.ModelContextTool[] = [listArticlesTool, getReadingListTool, openArticleTool];
+  const articlePage = readArticlePage();
+  if (articlePage) tools.push(...createArticleTools(articlePage));
+
+  for (const tool of tools) {
+    modelContext.registerTool(tool, options).catch((error) => {
+      if (!options.signal?.aborted) console.warn(`WebMCP: could not register tool "${tool.name}"`, error);
+    });
+  }
+}
+
+// Module scripts run after parsing, so the DOM is ready on first evaluation.
+registerTools();
+// With Astro's <ClientRouter>, re-register per page and drop tools before the swap.
+document.addEventListener('astro:page-load', registerTools);
+document.addEventListener('astro:before-swap', unregisterTools);
