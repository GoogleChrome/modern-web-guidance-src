+import type React from 'react';
+
+/**
+ * Shared WebMCP helpers for The DevTools Times.
+ *
+ * Declarative tools (HTML forms with `toolname`) live in the React flyouts.
+ * Imperative tools (`document.modelContext.registerTool`) live in
+ * `src/scripts/webmcp-tools.ts` and are wired up from the main layout.
+ */
+
+export const TOOL_NAMES = {
+  /** Declarative form tools */
+  searchArticles: 'search-articles',
+  saveToReadingList: 'save-article-to-reading-list',
+  removeFromReadingList: 'remove-article-from-reading-list',
+  /** Imperative site-wide tools */
+  listArticles: 'list-articles',
+  getReadingList: 'get-reading-list',
+  openArticle: 'open-article',
+  /** Imperative article-page tools */
+  getCurrentArticle: 'get-current-article',
+  getArticlePopularity: 'get-article-popularity',
+  jumpToArticleSection: 'jump-to-article-section',
+} as const;
+
+export type ToolName = (typeof TOOL_NAMES)[keyof typeof TOOL_NAMES];
+
+/** Shape returned by `GET /api/articles.json`. */
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+  author: string;
+  category: string;
+  date: string;
+  readingTime?: number;
+  tags?: string[];
+  url: string;
+}
+
+/** Shape returned by `GET`/`POST /api/reading-list.json`. */
+export interface ReadingListResponse {
+  readingList: string[];
+  slug?: string;
+  saved?: boolean;
+  error?: string;
+}
+
+export type ReadingListAction = 'add' | 'remove' | 'toggle';
+
+interface WebmcpFormOptions {
+  name: ToolName;
+  description: string;
+  /** Let the agent submit without the browser pausing for user review. */
+  autosubmit?: boolean;
+}
+
+/**
+ * Attributes that turn a `<form>` into a WebMCP declarative tool.
+ * React 19 forwards unknown lowercase attributes to the DOM, but `@types/react`
+ * does not know them yet, hence the cast.
+ */
+export function webmcpFormAttrs({ name, description, autosubmit = false }: WebmcpFormOptions) {
+  const attrs: Record<string, string> = {
+    toolname: name,
+    tooldescription: description,
+  };
+  if (autosubmit) attrs.toolautosubmit = '';
+  return attrs as unknown as React.FormHTMLAttributes<HTMLFormElement>;
+}
+
+/** `toolparamdescription` for an individual form control. */
+export function toolParamAttrs(description: string) {
+  return { toolparamdescription: description } as unknown as React.HTMLAttributes<HTMLElement>;
+}
+
+export interface AgentSubmission {
+  agentInvoked: boolean;
+  respondWith: (result: Promise<unknown>) => void;
+}
+
+/**
+ * Reads the WebMCP submission context off a (native) submit event.
+ * For user-initiated submissions `agentInvoked` is false and `respondWith` is a no-op.
+ */
+export function agentSubmission(nativeEvent: Event): AgentSubmission {
+  const event = nativeEvent as SubmitEvent;
+  const agentInvoked = event.agentInvoked === true && typeof event.respondWith === 'function';
+  return {
+    agentInvoked,
+    respondWith: (result) => {
+      if (agentInvoked) event.respondWith!(result);
+    },
+  };
+}
+
+/**
+ * Calls `callback` whenever an agent starts executing one of `toolNames`.
+ * Chrome 156+ dispatches `toolactivated` on `document.modelContext`; earlier
+ * versions dispatch it on `window`. Returns a cleanup function.
+ */
+export function onToolActivated(
+  toolNames: readonly string[],
+  callback: (toolName: string) => void,
+): () => void {
+  if (typeof document === 'undefined') return () => {};
+  const modelContext = document.modelContext;
+  if (!modelContext) return () => {};
+
+  const target: EventTarget = 'ontoolactivated' in modelContext ? modelContext : window;
+  const controller = new AbortController();
+  target.addEventListener(
+    'toolactivated',
+    (event) => {
+      const { toolName } = event as ToolActivatedEvent;
+      if (toolNames.includes(toolName)) callback(toolName);
+    },
+    { signal: controller.signal },
+  );
+  return () => controller.abort();
+}
+
+/** Turns a slug list into agent-friendly entries using the already-loaded article index. */
+export function describeReadingList(readingList: string[], articles: Pick<ArticleSummary, 'slug' | 'title'>[]) {
+  return readingList.map((slug) => ({
+    slug,
+    title: articles.find((article) => article.slug === slug)?.title ?? null,
+    url: `${import.meta.env.BASE_URL}articles/${slug}`,
+  }));
+}
