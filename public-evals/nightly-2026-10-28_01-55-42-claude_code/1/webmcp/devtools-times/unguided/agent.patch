   }
+
+  // WebMCP (https://github.com/webmachinelearning/webmcp)
+  interface Document {
+    readonly modelContext?: ModelContext;
+  }
+
+  /** Older Chrome prototype location of the API. */
+  interface Navigator {
+    readonly modelContext?: ModelContext;
+  }
+
+  interface SubmitEvent {
+    /** True when the form was submitted by an AI agent through a declarative WebMCP tool. */
+    readonly agentInvoked?: boolean;
+    /** Hands a result back to the agent that invoked the declarative tool. */
+    respondWith?(response: Promise<unknown>): void;
+  }
+}
