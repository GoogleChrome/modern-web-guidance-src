diff --git a/src/scripts/webmcp-page-tools.ts b/src/scripts/webmcp-page-tools.ts
new file mode 100644
index 0000000..05d26ae
--- /dev/null
+++ b/src/scripts/webmcp-page-tools.ts
@@ -0,0 +1,158 @@
+/**
+ * Imperative WebMCP tools that are available on every page (reading list
+ * lookup) and on article pages (the article itself plus the client-side
+ * utilities that article scripts call: popularity, coffee-brew, tide-levels
+ * and plant-stats). Registered once per page and re-registered after every
+ * Astro client-side navigation.
+ */
+import {
+  NO_INPUT_SCHEMA,
+  articleUrl,
+  callApi,
+  fetchArticleIndex,
+  fetchReadingList,
+  registerTools,
+  toArticleResult,
+  type ModelContextTool,
+} from '../lib/webmcp';
+
+function siteTools(): ModelContextTool[] {
+  return [
+    {
+      name: 'get_reading_list',
+      description:
+        "Returns the articles saved in the reader's reading list (slug, title, summary and URL). " +
+        'To change the list, use toggle_article_bookmark on an article page or the remove_from_reading_list form ' +
+        'in the reading list panel (open it with open_reading_list_panel).',
+      inputSchema: NO_INPUT_SCHEMA,
+      annotations: { readOnlyHint: true },
+      async execute(_input, { signal }) {
+        const [slugs, index] = await Promise.all([fetchReadingList(signal), fetchArticleIndex(signal)]);
+        const bySlug = new Map(index.map((article) => [article.slug, article]));
+        const articles = slugs.map((slug) => {
+          const article = bySlug.get(slug);
+          return article ? toArticleResult(article) : { slug, url: articleUrl(slug) };
+        });
+        return { count: articles.length, articles };
+      },
+    },
+  ];
+}
+
+/** Tools for the client-side utilities that individual articles ship with, keyed by API route. */
+const ARTICLE_UTILITY_TOOLS: Record<string, ModelContextTool> = {
+  'coffee-brew': {
+    name: 'brew_coffee',
+    description:
+      "Runs this article's coffee-brew utility, which requests brewing statistics from the coffee-brew API. " +
+      'Returns the HTTP status and response body, including any error message the API reports.',
+    inputSchema: NO_INPUT_SCHEMA,
+    annotations: { readOnlyHint: true },
+    execute: (_input, { signal }) => callApi('coffee-brew', signal),
+  },
+  'tide-levels': {
+    name: 'get_tide_levels',
+    description:
+      "Runs this article's tide-levels utility, which fetches current tide levels from the tide-levels API. " +
+      'Returns the HTTP status, whether the request was redirected, the final URL and the response body.',
+    inputSchema: NO_INPUT_SCHEMA,
+    annotations: { readOnlyHint: true },
+    execute: (_input, { signal }) => callApi('tide-levels', signal),
+  },
+  'plant-stats': {
+    name: 'get_plant_stats',
+    description:
+      "Runs this article's plant-stats utility, which fetches plant statistics (species, carbon offset, status) " +
+      'from the plant-stats API. Returns the HTTP status and response body; the API rejects requests whose ' +
+      'cookie header is larger than 4 KB with status 431.',
+    inputSchema: NO_INPUT_SCHEMA,
+    annotations: { readOnlyHint: true },
+    execute: (_input, { signal }) => callApi('plant-stats', signal),
+  },
+};
+
+function articleTools(article: HTMLElement): ModelContextTool[] {
+  const {
+    slug = '',
+    title = '',
+    author = '',
+    category = '',
+    date = '',
+    summary = '',
+    readingTime = '',
+    utilities = '',
+  } = article.dataset;
+
+  const tools: ModelContextTool[] = [
+    {
+      name: 'get_current_article',
+      description:
+        'Returns the article open on this page: slug, URL, title, author, publication date, category, summary, ' +
+        'full body text and whether it is bookmarked in the reading list.',
+      inputSchema: NO_INPUT_SCHEMA,
+      annotations: { readOnlyHint: true },
+      async execute(_input, { signal }) {
+        const body = article.querySelector<HTMLElement>('[data-article-body]')?.innerText.trim() ?? '';
+        let bookmarked: boolean | undefined;
+        try {
+          bookmarked = (await fetchReadingList(signal)).includes(slug);
+        } catch {
+          bookmarked = undefined;
+        }
+        return {
+          slug,
+          url: articleUrl(slug),
+          title,
+          author,
+          date,
+          category,
+          summary,
+          readingTimeMinutes: readingTime ? Number(readingTime) : undefined,
+          body,
+          bookmarked,
+        };
+      },
+    },
+    {
+      name: 'get_article_popularity',
+      description:
+        'Fetches popularity statistics (view count and whether it is trending) for the article open on this page ' +
+        'from the article-popularity API. Returns the HTTP status and response body.',
+      inputSchema: NO_INPUT_SCHEMA,
+      annotations: { readOnlyHint: true },
+      execute: (_input, { signal }) => callApi(`article-popularity?id=${encodeURIComponent(slug)}`, signal),
+    },
+  ];
+
+  for (const api of utilities.split(',')) {
+    const tool = ARTICLE_UTILITY_TOOLS[api.trim()];
+    if (tool) tools.push(tool);
+  }
+
+  return tools;
+}
+
+let unregister: (() => void) | null = null;
+
+function teardown() {
+  unregister?.();
+  unregister = null;
+}
+
+function setup() {
+  if (unregister) return; // already registered for the current page
+  const tools = siteTools();
+  const article = document.querySelector<HTMLElement>('[data-webmcp-article]');
+  if (article) tools.push(...articleTools(article));
+  unregister = registerTools(tools);
+}
+
+// Initial load…
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', setup, { once: true });
+} else {
+  setup();
+}
+// …and every client-side navigation performed by Astro's <ClientRouter />.
+document.addEventListener('astro:before-swap', teardown);
+document.addEventListener('astro:page-load', setup);
