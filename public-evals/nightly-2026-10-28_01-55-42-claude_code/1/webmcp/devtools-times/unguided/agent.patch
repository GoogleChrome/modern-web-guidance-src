@@ -0,0 +1,10 @@
+import { useEffect, type DependencyList } from 'react';
+import { registerTools, type ModelContextTool } from './webmcp';
+
+/**
+ * Registers WebMCP tools for the lifetime of a React component. The tools are
+ * unregistered when the component unmounts or when `deps` change.
+ */
+export function useWebMCPTools(createTools: () => ModelContextTool<any>[], deps: DependencyList = []) {
+  useEffect(() => registerTools(createTools()), deps);
+}
