@@ -0,0 +1,238 @@
+/**
+ * Small helper layer over WebMCP (https://github.com/webmachinelearning/webmcp).
+ *
+ * WebMCP exposes `document.modelContext` (an older Chrome prototype used
+ * `navigator.modelContext`). Pages register tools imperatively with
+ * `registerTool()` and unregister them by aborting the AbortSignal passed at
+ * registration time. HTML forms can also become tools declaratively via the
+ * `toolname` / `tooldescription` / `toolautosubmit` attributes; the page hands
+ * a result back to the agent through `SubmitEvent.respondWith()`.
+ */
+
+export interface ToolAnnotations {
+  /** The tool only reads state and has no side effects. */
+  readOnlyHint?: boolean;
+  /** The tool triggers real-world or hard-to-undo effects. */
+  consequentialHint?: boolean;
+  /** The output may contain untrusted / user-generated content. */
+  untrustedContentHint?: boolean;
+  /** The tool is meant for developer tooling rather than end-user agents. */
+  debugging?: boolean;
+}
+
+export interface ToolExecuteOptions {
+  signal: AbortSignal;
+}
+
+export interface ModelContextTool<Input = Record<string, unknown>> {
+  name: string;
+  title?: string;
+  description: string;
+  inputSchema?: Record<string, unknown>;
+  annotations?: ToolAnnotations;
+  execute: (input: Input, options: ToolExecuteOptions) => unknown | Promise<unknown>;
+}
+
+export interface RegisterToolOptions {
+  signal?: AbortSignal;
+  exposedTo?: string[];
+}
+
+export interface RegisteredTool {
+  name: string;
+  title?: string;
+  description: string;
+  inputSchema?: Record<string, unknown>;
+  annotations?: ToolAnnotations;
+  origin: string;
+  window: Window;
+}
+
+export interface ModelContext extends EventTarget {
+  registerTool(tool: ModelContextTool<any>, options?: RegisterToolOptions): Promise<void> | void;
+  getTools?(options?: { fromOrigins?: string[] }): Promise<RegisteredTool[]>;
+  executeTool?(
+    tool: RegisteredTool,
+    input?: Record<string, unknown>,
+    options?: { signal?: AbortSignal },
+  ): Promise<unknown>;
+  /** Only present on the legacy `navigator.modelContext` prototype. */
+  unregisterTool?(name: string): void;
+}
+
+/** An empty JSON Schema object for tools that take no parameters. */
+export const NO_INPUT_SCHEMA = { type: 'object', properties: {} } as const;
+
+/** Returns the page's ModelContext, or null when the browser lacks WebMCP. */
+export function getModelContext(): ModelContext | null {
+  if (typeof document === 'undefined') return null;
+  return document.modelContext ?? navigator.modelContext ?? null;
+}
+
+export function isWebMCPSupported(): boolean {
+  return getModelContext() !== null;
+}
+
+/**
+ * Registers a set of tools and returns a function that unregisters them again.
+ * A no-op in browsers without WebMCP, so callers never need to feature-detect.
+ */
+export function registerTools(tools: ModelContextTool<any>[]): () => void {
+  const context = getModelContext();
+  if (!context || tools.length === 0) return () => {};
+
+  const controller = new AbortController();
+  for (const tool of tools) {
+    try {
+      Promise.resolve(context.registerTool(tool, { signal: controller.signal })).catch((error) => {
+        console.warn(`[webmcp] Failed to register tool "${tool.name}":`, error);
+      });
+    } catch (error) {
+      console.warn(`[webmcp] Failed to register tool "${tool.name}":`, error);
+    }
+  }
+
+  return () => {
+    controller.abort();
+    // The legacy prototype has no AbortSignal support; fall back to unregisterTool().
+    if (typeof context.unregisterTool === 'function') {
+      for (const tool of tools) {
+        try {
+          context.unregisterTool(tool.name);
+        } catch {
+          // Already gone — nothing to do.
+        }
+      }
+    }
+  };
+}
+
+/**
+ * Hands the result of a declarative (form) tool back to the agent that
+ * submitted the form. Returns false when the submission came from a human, in
+ * which case the caller should carry on with its normal UI behaviour only.
+ */
+export function respondToAgent(event: Event | undefined, result: unknown): boolean {
+  const submitEvent = event as SubmitEvent | undefined;
+  if (!submitEvent?.agentInvoked || typeof submitEvent.respondWith !== 'function') {
+    return false;
+  }
+  submitEvent.respondWith(Promise.resolve(result));
+  return true;
+}
+
+/** Absolute (base-path aware) URL for one of the site's API routes. */
+export function apiUrl(path: string): string {
+  return `${import.meta.env.BASE_URL}api/${path}`;
+}
+
+/** Absolute (base-path aware) URL for an article page. */
+export function articleUrl(slug: string): string {
+  return new URL(`${import.meta.env.BASE_URL}articles/${slug}`, location.origin).href;
+}
+
+export interface ApiCallResult {
+  ok: boolean;
+  status?: number;
+  statusText?: string;
+  redirected?: boolean;
+  url: string;
+  durationMs: number;
+  body?: unknown;
+  error?: string;
+}
+
+/**
+ * Calls one of the site's API routes and describes the outcome instead of
+ * throwing, so agents (and anyone watching the Network panel) can see exactly
+ * how the request behaved — status codes, redirects and bodies included.
+ */
+export async function callApi(path: string, signal?: AbortSignal): Promise<ApiCallResult> {
+  const url = apiUrl(path);
+  const started = performance.now();
+  try {
+    const response = await fetch(url, { signal, headers: { accept: 'application/json' } });
+    const text = await response.text();
+    let body: unknown = text;
+    try {
+      body = text ? JSON.parse(text) : null;
+    } catch {
+      // Not JSON — return the raw text.
+    }
+    return {
+      ok: response.ok,
+      status: response.status,
+      statusText: response.statusText,
+      redirected: response.redirected,
+      url: response.url || url,
+      durationMs: Math.round(performance.now() - started),
+      body,
+    };
+  } catch (error) {
+    return {
+      ok: false,
+      url,
+      durationMs: Math.round(performance.now() - started),
+      error: error instanceof Error ? `${error.name}: ${error.message}` : String(error),
+    };
+  }
+}
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+/** Fetches the lightweight article index used by search and the reading list. */
+export async function fetchArticleIndex(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(apiUrl('articles.json'), { signal });
+  if (!response.ok) throw new Error(`articles.json responded with ${response.status}`);
+  return response.json();
+}
+
+/** Fetches the slugs currently saved in the session's reading list. */
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(apiUrl('reading-list.json'), { signal });
+  if (!response.ok) throw new Error(`reading-list.json responded with ${response.status}`);
+  const data = await response.json();
+  return Array.isArray(data.readingList) ? data.readingList : [];
+}
+
+/** Adds the slug to the reading list if absent, removes it if present. */
+export async function toggleReadingList(slug: string): Promise<string[]> {
+  const response = await fetch(apiUrl('reading-list.json'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  if (!response.ok) throw new Error(`reading-list.json responded with ${response.status}`);
+  const data = await response.json();
+  return Array.isArray(data.readingList) ? data.readingList : [];
+}
+
+/** Case-insensitive match against article titles and summaries. */
+export function searchArticles<T extends ArticleSummary>(articles: T[], query: string): T[] {
+  const term = query.trim().toLowerCase();
+  if (!term) return [];
+  return articles.filter(
+    (article) =>
+      article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term),
+  );
+}
+
+/** Shape returned to agents for an article hit. */
+export function toArticleResult(article: ArticleSummary) {
+  return {
+    slug: article.slug,
+    title: article.title,
+    summary: article.summary,
+    url: articleUrl(article.slug),
+  };
+}
+
+/** Resolves after the browser has had a chance to render pending React updates. */
+export function nextPaint(): Promise<void> {
+  return new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve, 0)));
+}
