+/**
+ * Seasonal Favorites menu data and pure order logic for The Daily Grind.
+ *
+ * This module has no DOM dependencies so it can be unit-tested in Node and
+ * shared between the page UI and the WebMCP tools in ./webmcp-tools.js.
+ */
+
+export const TAX_RATE = 0.08;
+export const MAX_QUANTITY_PER_LINE = 12;
+
+export const SIZES = ['small', 'medium', 'large'];
+export const DEFAULT_SIZE_SURCHARGE = { small: 0, medium: 0.5, large: 1.0 };
+
+export const MILKS = ['none', 'whole', 'skim', 'oat', 'almond'];
+export const MILK_SURCHARGE = { none: 0, whole: 0, skim: 0, oat: 0.75, almond: 0.75 };
+
+export const TEMPERATURES = ['hot', 'iced'];
+
+export const SEASONAL_FAVORITES = Object.freeze([
+  {
+    id: 'maple-oat-latte',
+    name: 'Maple Oat Latte',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    basePrice: 5.25,
+    temperatures: ['hot', 'iced'],
+    sizeLabels: { small: '12 oz', medium: '16 oz', large: '20 oz' },
+    milkOptions: ['oat', 'almond', 'whole', 'skim'],
+    defaultMilk: 'oat',
+    includedMilk: 'oat',
+    caffeineMg: 150,
+    tags: ['seasonal', 'sweet', 'dairy-free', 'vegan'],
+    allergens: ['oats'],
+    detailsUrl: '/menu/seasonal',
+  },
+  {
+    id: 'dark-roast-espresso',
+    name: 'Dark Roast Espresso',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    basePrice: 3.0,
+    temperatures: ['hot'],
+    sizeLabels: { small: 'single shot', medium: 'double shot', large: 'triple shot' },
+    sizeSurcharge: { small: 0, medium: 1.0, large: 2.0 },
+    milkOptions: ['none', 'whole', 'skim', 'oat', 'almond'],
+    defaultMilk: 'none',
+    includedMilk: 'none',
+    caffeineMg: 75,
+    tags: ['bold', 'low-calorie', 'dairy-free', 'vegan'],
+    allergens: [],
+    detailsUrl: '/menu/espresso',
+  },
+  {
+    id: 'cold-brew',
+    name: 'Cold Brew',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    basePrice: 4.5,
+    temperatures: ['iced'],
+    sizeLabels: { small: '12 oz', medium: '16 oz', large: '24 oz' },
+    milkOptions: ['none', 'whole', 'skim', 'oat', 'almond'],
+    defaultMilk: 'none',
+    includedMilk: 'none',
+    caffeineMg: 200,
+    tags: ['smooth', 'low-calorie', 'dairy-free', 'vegan'],
+    allergens: [],
+    detailsUrl: '/menu/cold-brew',
+  },
+]);
+
+export class MenuError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'MenuError';
+  }
+}
+
+const round2 = (n) => Math.round(n * 100) / 100;
+
+export function formatMoney(amount) {
+  return `$${Number(amount).toFixed(2)}`;
+}
+
+export function drinkNames() {
+  return SEASONAL_FAVORITES.map((d) => `${d.name} (${d.id})`).join(', ');
+}
+
+/** Resolve a drink by id, exact name, or a case-insensitive partial match. */
+export function findDrink(query) {
+  if (query == null) return null;
+  const q = String(query).trim().toLowerCase();
+  if (!q) return null;
+  const slug = q.replace(/\s+/g, '-');
+  return (
+    SEASONAL_FAVORITES.find((d) => d.id === q || d.id === slug) ??
+    SEASONAL_FAVORITES.find((d) => d.name.toLowerCase() === q) ??
+    SEASONAL_FAVORITES.find((d) => d.name.toLowerCase().includes(q) || d.id.includes(slug)) ??
+    null
+  );
+}
+
+export function sizeSurchargeFor(drink, size) {
+  return (drink.sizeSurcharge ?? DEFAULT_SIZE_SURCHARGE)[size];
+}
+
+export function milkSurchargeFor(drink, milk) {
+  return milk === drink.includedMilk ? 0 : MILK_SURCHARGE[milk];
+}
+
+/** Price of one drink with the given size and milk. */
+export function unitPrice(drink, size, milk) {
+  return round2(drink.basePrice + sizeSurchargeFor(drink, size) + milkSurchargeFor(drink, milk));
+}
+
+/** Agent-friendly description of one drink, including the full price matrix. */
+export function describeDrink(drink) {
+  return {
+    id: drink.id,
+    name: drink.name,
+    description: drink.description,
+    priceFrom: drink.basePrice,
+    temperatures: drink.temperatures,
+    sizes: SIZES.map((size) => ({
+      size,
+      label: drink.sizeLabels[size],
+      price: unitPrice(drink, size, drink.defaultMilk),
+    })),
+    milkOptions: drink.milkOptions.map((milk) => ({
+      milk,
+      surcharge: milkSurchargeFor(drink, milk),
+      default: milk === drink.defaultMilk,
+    })),
+    caffeineMg: drink.caffeineMg,
+    tags: drink.tags,
+    allergens: drink.allergens,
+    detailsUrl: drink.detailsUrl,
+  };
+}
+
+/**
+ * Filter the menu. All criteria are optional and combined with AND.
+ * @param {{search?: string, tag?: string, temperature?: string, maxPrice?: number, maxCaffeineMg?: number}} criteria
+ */
+export function filterMenu(criteria = {}) {
+  const search = criteria.search ? String(criteria.search).trim().toLowerCase() : '';
+  const tag = criteria.tag ? String(criteria.tag).trim().toLowerCase() : '';
+  const temperature = criteria.temperature ? String(criteria.temperature).trim().toLowerCase() : '';
+  const maxPrice = toOptionalNumber(criteria.maxPrice, 'maxPrice');
+  const maxCaffeineMg = toOptionalNumber(criteria.maxCaffeineMg, 'maxCaffeineMg');
+
+  if (temperature && !TEMPERATURES.includes(temperature)) {
+    throw new MenuError(`Unknown temperature "${criteria.temperature}". Use one of: ${TEMPERATURES.join(', ')}.`);
+  }
+
+  return SEASONAL_FAVORITES.filter((d) => {
+    if (tag && !d.tags.includes(tag)) return false;
+    if (temperature && !d.temperatures.includes(temperature)) return false;
+    if (maxPrice != null && d.basePrice > maxPrice) return false;
+    if (maxCaffeineMg != null && d.caffeineMg > maxCaffeineMg) return false;
+    if (search) {
+      const haystack = [d.id, d.name, d.description, ...d.tags].join(' ').toLowerCase();
+      if (!haystack.includes(search)) return false;
+    }
+    return true;
+  });
+}
+
+/** Human-readable summary of the criteria passed to filterMenu, e.g. "dairy-free · under $5.00". */
+export function describeCriteria(criteria = {}) {
+  const parts = [];
+  if (criteria.search) parts.push(`“${criteria.search}”`);
+  if (criteria.tag) parts.push(String(criteria.tag).toLowerCase());
+  if (criteria.temperature) parts.push(String(criteria.temperature).toLowerCase());
+  if (criteria.maxPrice != null) parts.push(`under ${formatMoney(criteria.maxPrice)}`);
+  if (criteria.maxCaffeineMg != null) parts.push(`≤ ${criteria.maxCaffeineMg} mg caffeine`);
+  return parts.join(' · ');
+}
+
+function toOptionalNumber(value, label) {
+  if (value == null || value === '') return null;
+  const n = Number(value);
+  if (!Number.isFinite(n) || n < 0) throw new MenuError(`${label} must be a non-negative number.`);
+  return n;
+}
+
+/**
+ * Validate a requested drink configuration and compute its price.
+ * Throws MenuError with an agent-readable message on invalid input.
+ */
+export function buildLine(drinkQuery, options = {}) {
+  const drink = typeof drinkQuery === 'object' && drinkQuery ? drinkQuery : findDrink(drinkQuery);
+  if (!drink) {
+    throw new MenuError(`Unknown drink "${drinkQuery}". Seasonal Favorites are: ${drinkNames()}.`);
+  }
+
+  const size = String(options.size ?? 'medium').trim().toLowerCase();
+  if (!SIZES.includes(size)) {
+    throw new MenuError(`Unknown size "${options.size}". Use one of: ${SIZES.join(', ')}.`);
+  }
+
+  const milk = String(options.milk ?? drink.defaultMilk).trim().toLowerCase();
+  if (!MILKS.includes(milk)) {
+    throw new MenuError(`Unknown milk "${options.milk}". Use one of: ${MILKS.join(', ')}.`);
+  }
+  if (!drink.milkOptions.includes(milk)) {
+    throw new MenuError(
+      `${drink.name} is not available with ${milk} milk. Options: ${drink.milkOptions.join(', ')}.`,
+    );
+  }
+
+  const quantity = options.quantity == null || options.quantity === '' ? 1 : Number(options.quantity);
+  if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY_PER_LINE) {
+    throw new MenuError(`quantity must be a whole number from 1 to ${MAX_QUANTITY_PER_LINE}.`);
+  }
+
+  const notes = String(options.notes ?? '').trim().slice(0, 140);
+  const price = unitPrice(drink, size, milk);
+
+  return {
+    drinkId: drink.id,
+    name: drink.name,
+    size,
+    sizeLabel: drink.sizeLabels[size],
+    milk,
+    quantity,
+    notes,
+    unitPrice: price,
+    lineTotal: round2(price * quantity),
+  };
+}
+
+export function orderTotals(lines) {
+  const subtotal = round2(lines.reduce((sum, l) => sum + l.lineTotal, 0));
+  const tax = round2(subtotal * TAX_RATE);
+  return {
+    itemCount: lines.reduce((sum, l) => sum + l.quantity, 0),
+    subtotal,
+    tax,
+    total: round2(subtotal + tax),
+  };
+}
+
+/**
+ * In-memory order (cart). Identical configurations are merged into one line.
+ * `subscribe` lets the UI re-render on every change.
+ */
+export function createOrder(initialLines = []) {
+  let lines = [];
+  let nextId = 1;
+  const listeners = new Set();
+
+  const sameConfig = (a, b) =>
+    a.drinkId === b.drinkId && a.size === b.size && a.milk === b.milk && a.notes === b.notes;
+
+  const emit = () => listeners.forEach((fn) => fn(snapshot()));
+
+  function snapshot() {
+    return { lines: lines.map((l) => ({ ...l })), ...orderTotals(lines) };
+  }
+
+  function add(drinkQuery, options) {
+    const line = buildLine(drinkQuery, options);
+    const existing = lines.find((l) => sameConfig(l, line));
+    let result;
+    if (existing) {
+      const quantity = existing.quantity + line.quantity;
+      if (quantity > MAX_QUANTITY_PER_LINE) {
+        throw new MenuError(
+          `That would make ${quantity} of the same drink; the limit is ${MAX_QUANTITY_PER_LINE} per line.`,
+        );
+      }
+      existing.quantity = quantity;
+      existing.lineTotal = round2(existing.unitPrice * quantity);
+      result = existing;
+    } else {
+      result = { lineId: `line-${nextId++}`, ...line };
+      lines.push(result);
+    }
+    emit();
+    return { ...result };
+  }
+
+  function update(lineId, quantity) {
+    const line = lines.find((l) => l.lineId === lineId);
+    if (!line) {
+      throw new MenuError(`No order line "${lineId}". Call get_order to see current line ids.`);
+    }
+    const q = Number(quantity);
+    if (!Number.isInteger(q) || q < 0 || q > MAX_QUANTITY_PER_LINE) {
+      throw new MenuError(`quantity must be a whole number from 0 to ${MAX_QUANTITY_PER_LINE} (0 removes the line).`);
+    }
+    if (q === 0) {
+      lines = lines.filter((l) => l !== line);
+      emit();
+      return null;
+    }
+    line.quantity = q;
+    line.lineTotal = round2(line.unitPrice * q);
+    emit();
+    return { ...line };
+  }
+
+  function clear() {
+    const removed = lines.length;
+    lines = [];
+    emit();
+    return removed;
+  }
+
+  function subscribe(fn) {
+    listeners.add(fn);
+    return () => listeners.delete(fn);
+  }
+
+  for (const l of initialLines) {
+    try {
+      add(l.drinkId, l);
+    } catch {
+      // Ignore stale or invalid persisted lines.
+    }
+  }
+
+  return { add, update, clear, snapshot, subscribe };
+}
