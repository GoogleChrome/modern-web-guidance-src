+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+import {
+  SEASONAL_FAVORITES,
+  MenuError,
+  buildLine,
+  createOrder,
+  describeDrink,
+  filterMenu,
+  findDrink,
+  orderTotals,
+  unitPrice,
+} from '../assets/menu.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const indexHtml = readFileSync(path.join(here, '..', 'index.html'), 'utf8');
+
+test('findDrink resolves ids, names, and partial matches', () => {
+  assert.equal(findDrink('cold-brew')?.id, 'cold-brew');
+  assert.equal(findDrink('Cold Brew')?.id, 'cold-brew');
+  assert.equal(findDrink('  maple oat LATTE ')?.id, 'maple-oat-latte');
+  assert.equal(findDrink('espresso')?.id, 'dark-roast-espresso');
+  assert.equal(findDrink('matcha'), null);
+  assert.equal(findDrink(''), null);
+  assert.equal(findDrink(undefined), null);
+});
+
+test('filterMenu combines criteria with AND', () => {
+  assert.equal(filterMenu().length, 3);
+  assert.deepEqual(filterMenu({ temperature: 'iced' }).map((d) => d.id), ['maple-oat-latte', 'cold-brew']);
+  assert.deepEqual(filterMenu({ tag: 'sweet' }).map((d) => d.id), ['maple-oat-latte']);
+  assert.deepEqual(filterMenu({ maxPrice: 4.5 }).map((d) => d.id), ['dark-roast-espresso', 'cold-brew']);
+  assert.deepEqual(filterMenu({ maxCaffeineMg: 100 }).map((d) => d.id), ['dark-roast-espresso']);
+  assert.deepEqual(filterMenu({ search: 'smooth' }).map((d) => d.id), ['cold-brew']);
+  assert.deepEqual(filterMenu({ temperature: 'iced', maxPrice: 5 }).map((d) => d.id), ['cold-brew']);
+  assert.throws(() => filterMenu({ temperature: 'lukewarm' }), MenuError);
+  assert.throws(() => filterMenu({ maxPrice: -1 }), MenuError);
+});
+
+test('unitPrice applies size and milk surcharges, with included milk free', () => {
+  const latte = findDrink('maple-oat-latte');
+  assert.equal(unitPrice(latte, 'small', 'oat'), 5.25);
+  assert.equal(unitPrice(latte, 'large', 'oat'), 6.25);
+  assert.equal(unitPrice(latte, 'medium', 'almond'), 6.5);
+  const espresso = findDrink('dark-roast-espresso');
+  assert.equal(unitPrice(espresso, 'large', 'none'), 5.0);
+  assert.equal(unitPrice(espresso, 'small', 'oat'), 3.75);
+});
+
+test('buildLine validates and defaults', () => {
+  const line = buildLine('Cold Brew');
+  assert.equal(line.size, 'medium');
+  assert.equal(line.milk, 'none');
+  assert.equal(line.quantity, 1);
+  assert.equal(line.unitPrice, 5.0);
+
+  const custom = buildLine('cold-brew', { size: 'LARGE', milk: 'oat', quantity: 2, notes: 'light ice' });
+  assert.equal(custom.unitPrice, 6.25);
+  assert.equal(custom.lineTotal, 12.5);
+  assert.equal(custom.notes, 'light ice');
+
+  assert.throws(() => buildLine('matcha'), /Unknown drink/);
+  assert.throws(() => buildLine('cold-brew', { size: 'venti' }), /Unknown size/);
+  assert.throws(() => buildLine('cold-brew', { milk: 'soy' }), /Unknown milk/);
+  assert.throws(() => buildLine('cold-brew', { quantity: 0 }), /quantity/);
+  assert.throws(() => buildLine('cold-brew', { quantity: 2.5 }), /quantity/);
+  assert.throws(() => buildLine('cold-brew', { quantity: 13 }), /quantity/);
+});
+
+test('createOrder merges identical lines and tracks totals', () => {
+  const order = createOrder();
+  const events = [];
+  order.subscribe((s) => events.push(s.itemCount));
+
+  const a = order.add('cold-brew', { size: 'large' });
+  const b = order.add('Cold Brew', { size: 'large' });
+  assert.equal(a.lineId, b.lineId);
+  assert.equal(b.quantity, 2);
+
+  const c = order.add('cold-brew', { size: 'small' });
+  assert.notEqual(c.lineId, a.lineId);
+
+  let snap = order.snapshot();
+  assert.equal(snap.lines.length, 2);
+  assert.equal(snap.itemCount, 3);
+  assert.equal(snap.subtotal, 15.5);
+  assert.equal(snap.tax, 1.24);
+  assert.equal(snap.total, 16.74);
+
+  assert.equal(order.update(c.lineId, 3).quantity, 3);
+  assert.equal(order.update(c.lineId, 0), null);
+  assert.equal(order.snapshot().lines.length, 1);
+  assert.throws(() => order.update('line-999', 1), /No order line/);
+  assert.throws(() => order.update(a.lineId, 99), /quantity/);
+
+  assert.equal(order.clear(), 1);
+  snap = order.snapshot();
+  assert.deepEqual(snap.lines, []);
+  assert.equal(snap.total, 0);
+  assert.deepEqual(events, [1, 2, 3, 5, 2, 0]);
+});
+
+test('createOrder enforces the per-line limit when merging', () => {
+  const order = createOrder();
+  order.add('cold-brew', { quantity: 10 });
+  assert.throws(() => order.add('cold-brew', { quantity: 5 }), /limit/);
+});
+
+test('createOrder rehydrates persisted lines and ignores junk', () => {
+  const order = createOrder([
+    { drinkId: 'maple-oat-latte', size: 'large', milk: 'oat', quantity: 2, notes: '' },
+    { drinkId: 'not-a-drink', size: 'large' },
+  ]);
+  assert.equal(order.snapshot().lines.length, 1);
+  assert.equal(order.snapshot().itemCount, 2);
+});
+
+test('orderTotals handles the empty order', () => {
+  assert.deepEqual(orderTotals([]), { itemCount: 0, subtotal: 0, tax: 0, total: 0 });
+});
+
+test('describeDrink exposes the price matrix agents need', () => {
+  const d = describeDrink(findDrink('dark-roast-espresso'));
+  assert.deepEqual(d.sizes.map((s) => s.price), [3.0, 4.0, 5.0]);
+  assert.equal(d.milkOptions.find((m) => m.milk === 'oat').surcharge, 0.75);
+  assert.equal(d.milkOptions.find((m) => m.default).milk, 'none');
+});
+
+test('index.html has a card for every menu item and the declarative checkout tool', () => {
+  for (const drink of SEASONAL_FAVORITES) {
+    assert.match(indexHtml, new RegExp(`data-drink-id="${drink.id}"`), `card for ${drink.id}`);
+    assert.ok(indexHtml.includes(`from $${drink.basePrice.toFixed(2)}`), `price for ${drink.id}`);
+  }
+  assert.match(indexHtml, /<form[^>]*toolname="checkout_order"/);
+  assert.match(indexHtml, /<form[^>]*tooldescription="/);
+  assert.match(indexHtml, /<form[^>]*toolautosubmit/);
+  assert.match(indexHtml, /name="name"[^>]*toolparamdescription=/);
+  assert.match(indexHtml, /name="pickupTime"[^>]*toolparamdescription=/);
+  assert.match(indexHtml, /<script type="module" src="\/assets\/webmcp-tools.js">/);
+});
