@@ -0,0 +1,574 @@
+/**
+ * WebMCP integration for The Daily Grind homepage.
+ *
+ * Registers client-side tools on `document.modelContext` (falling back to the
+ * earlier `navigator.modelContext` preview name) so browser-based AI agents can:
+ *   - query the Seasonal Favorites menu,
+ *   - build a pickup order in the on-page order panel,
+ *   - update what the page shows (highlight a drink, filter the menu).
+ *
+ * Checkout is deliberately a declarative WebMCP form (<form toolname=...>) so
+ * the consequential step stays visible and reviewable by the person browsing.
+ *
+ * Everything degrades gracefully: without WebMCP the page is a normal,
+ * fully manual menu + order form.
+ */
+
+import {
+  SEASONAL_FAVORITES,
+  SIZES,
+  MILKS,
+  TEMPERATURES,
+  MAX_QUANTITY_PER_LINE,
+  MenuError,
+  createOrder,
+  describeCriteria,
+  describeDrink,
+  filterMenu,
+  findDrink,
+  formatMoney,
+} from './menu.js';
+
+const STORAGE_KEY = 'daily-grind:order';
+const CHECKOUT_TOOL_NAME = 'checkout_order';
+const PICKUP_LABELS = { asap: 'as soon as possible (about 10 minutes)', '15': 'in 15 minutes', '30': 'in 30 minutes', '60': 'in 1 hour' };
+
+const $ = (selector) => document.querySelector(selector);
+const $$ = (selector) => Array.from(document.querySelectorAll(selector));
+
+// ---------------------------------------------------------------------------
+// State
+// ---------------------------------------------------------------------------
+
+const order = createOrder(loadPersistedLines());
+let lastOrderConfirmation = null;
+let activeFilter = null; // { criteria, matchedIds }
+
+function loadPersistedLines() {
+  try {
+    const raw = sessionStorage.getItem(STORAGE_KEY);
+    const parsed = raw ? JSON.parse(raw) : [];
+    return Array.isArray(parsed) ? parsed : [];
+  } catch {
+    return [];
+  }
+}
+
+order.subscribe((snapshot) => {
+  try {
+    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot.lines));
+  } catch {
+    // Storage may be unavailable (private mode, quota); the in-memory order still works.
+  }
+  renderOrder(snapshot);
+});
+
+// ---------------------------------------------------------------------------
+// UI helpers
+// ---------------------------------------------------------------------------
+
+function cardFor(drinkId) {
+  return document.querySelector(`.card[data-drink-id="${drinkId}"]`);
+}
+
+let toastTimer;
+function announce(message, { tone = 'info' } = {}) {
+  const toast = $('#agent-toast');
+  if (!toast) return;
+  toast.textContent = message;
+  toast.dataset.tone = tone;
+  toast.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => {
+    toast.hidden = true;
+  }, 6000);
+}
+
+function highlightCard(drinkId, { note = '', scroll = true } = {}) {
+  const card = cardFor(drinkId);
+  if (!card) return false;
+
+  $$('.card.is-highlighted').forEach((c) => c.classList.remove('is-highlighted'));
+  card.classList.add('is-highlighted');
+
+  const callout = card.querySelector('.card-callout');
+  if (callout) {
+    callout.textContent = note;
+    callout.hidden = !note;
+  }
+
+  if (scroll) {
+    card.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block: 'center' });
+  }
+  return true;
+}
+
+function clearHighlights() {
+  $$('.card.is-highlighted').forEach((c) => c.classList.remove('is-highlighted'));
+  $$('.card-callout').forEach((el) => {
+    el.hidden = true;
+    el.textContent = '';
+  });
+}
+
+function applyMenuFilter(criteria) {
+  const matches = filterMenu(criteria);
+  const matchedIds = new Set(matches.map((d) => d.id));
+  $$('.card[data-drink-id]').forEach((card) => {
+    card.classList.toggle('is-filtered-out', !matchedIds.has(card.dataset.drinkId));
+  });
+
+  const bar = $('#menu-filter-bar');
+  const label = $('#menu-filter-label');
+  const empty = $('#menu-empty');
+  const summary = describeCriteria(criteria) || 'all drinks';
+  if (bar && label) {
+    label.textContent = `Showing ${matches.length} of ${SEASONAL_FAVORITES.length}: ${summary}`;
+    bar.hidden = false;
+  }
+  if (empty) empty.hidden = matches.length > 0;
+
+  activeFilter = { criteria, matchedIds: [...matchedIds] };
+  return matches;
+}
+
+function resetMenuFilter() {
+  $$('.card.is-filtered-out').forEach((card) => card.classList.remove('is-filtered-out'));
+  const bar = $('#menu-filter-bar');
+  const empty = $('#menu-empty');
+  if (bar) bar.hidden = true;
+  if (empty) empty.hidden = true;
+  activeFilter = null;
+}
+
+function renderOrder(snapshot = order.snapshot()) {
+  const list = $('#order-lines');
+  const emptyMsg = $('#order-empty');
+  const totals = $('#order-totals');
+  const submit = $('#checkout-submit');
+  if (!list) return;
+
+  list.innerHTML = '';
+  for (const line of snapshot.lines) {
+    const li = document.createElement('li');
+    li.className = 'order-line';
+    li.dataset.lineId = line.lineId;
+
+    const main = document.createElement('div');
+    main.className = 'order-line-main';
+    const title = document.createElement('strong');
+    title.textContent = `${line.quantity} × ${line.name}`;
+    const meta = document.createElement('span');
+    meta.className = 'order-line-meta';
+    const milk = line.milk === 'none' ? 'no milk' : `${line.milk} milk`;
+    meta.textContent = `${line.size} (${line.sizeLabel}), ${milk}${line.notes ? ` — ${line.notes}` : ''}`;
+    main.append(title, meta);
+
+    const price = document.createElement('span');
+    price.className = 'order-line-price';
+    price.textContent = formatMoney(line.lineTotal);
+
+    const remove = document.createElement('button');
+    remove.type = 'button';
+    remove.className = 'order-line-remove';
+    remove.setAttribute('aria-label', `Remove ${line.name} from order`);
+    remove.textContent = '×';
+    remove.addEventListener('click', () => order.update(line.lineId, 0));
+
+    li.append(main, price, remove);
+    list.append(li);
+  }
+
+  const hasItems = snapshot.lines.length > 0;
+  if (emptyMsg) emptyMsg.hidden = hasItems;
+  if (totals) {
+    totals.hidden = !hasItems;
+    $('#order-subtotal').textContent = formatMoney(snapshot.subtotal);
+    $('#order-tax').textContent = formatMoney(snapshot.tax);
+    $('#order-total').textContent = formatMoney(snapshot.total);
+  }
+  if (submit) submit.disabled = !hasItems;
+
+  const badge = $('#order-count');
+  if (badge) {
+    badge.textContent = String(snapshot.itemCount);
+    badge.hidden = snapshot.itemCount === 0;
+  }
+}
+
+function prefersReducedMotion() {
+  return window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
+}
+
+// ---------------------------------------------------------------------------
+// Order actions shared by the UI and the tools
+// ---------------------------------------------------------------------------
+
+function addToOrder(drinkQuery, options = {}) {
+  const line = order.add(drinkQuery, options);
+  highlightCard(line.drinkId, { note: `Added to your order: ${line.quantity} × ${line.size}`, scroll: false });
+  announce(`Added ${line.quantity} × ${line.name} (${line.size}) to your order.`, { tone: 'success' });
+  return line;
+}
+
+/**
+ * Place the current order from the checkout form values.
+ * Returns an agent-friendly result; never throws.
+ */
+function placeOrder(formData) {
+  const snapshot = order.snapshot();
+  const name = String(formData.get('name') ?? '').trim();
+  const pickup = String(formData.get('pickupTime') ?? 'asap');
+  const notes = String(formData.get('notes') ?? '').trim().slice(0, 200);
+
+  if (snapshot.lines.length === 0) {
+    return {
+      ok: false,
+      error: 'The order is empty. Add drinks with add_drink_to_order before checking out.',
+    };
+  }
+  if (!name) {
+    return { ok: false, error: 'A pickup name is required.' };
+  }
+  if (!(pickup in PICKUP_LABELS)) {
+    return { ok: false, error: `Unknown pickupTime "${pickup}". Use one of: ${Object.keys(PICKUP_LABELS).join(', ')}.` };
+  }
+
+  const confirmation = {
+    confirmationNumber: `DG-${Date.now().toString(36).toUpperCase().slice(-6)}`,
+    pickupName: name,
+    pickupTime: PICKUP_LABELS[pickup],
+    notes,
+    lines: snapshot.lines,
+    subtotal: snapshot.subtotal,
+    tax: snapshot.tax,
+    total: snapshot.total,
+    placedAt: new Date().toISOString(),
+  };
+  lastOrderConfirmation = confirmation;
+
+  order.clear();
+  $('#checkout-form')?.reset();
+  showConfirmation(confirmation);
+  announce(`Order ${confirmation.confirmationNumber} placed for ${name}.`, { tone: 'success' });
+
+  return {
+    ok: true,
+    ...confirmation,
+    note: 'Demo storefront: the order is recorded on this page only and no payment was charged.',
+  };
+}
+
+function showConfirmation(confirmation) {
+  const panel = $('#order-confirmation');
+  if (!panel) return;
+  $('#confirmation-number').textContent = confirmation.confirmationNumber;
+  $('#confirmation-summary').textContent =
+    `${confirmation.lines.reduce((n, l) => n + l.quantity, 0)} drink(s), ${formatMoney(confirmation.total)} total. ` +
+    `Ready for ${confirmation.pickupName} ${confirmation.pickupTime}.`;
+  panel.hidden = false;
+  panel.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block: 'nearest' });
+}
+
+// ---------------------------------------------------------------------------
+// WebMCP tool definitions (imperative API)
+// ---------------------------------------------------------------------------
+
+const DRINK_PARAM = {
+  type: 'string',
+  description: `Drink id or name. Seasonal Favorites: ${SEASONAL_FAVORITES.map((d) => `"${d.id}" (${d.name})`).join(', ')}.`,
+};
+
+const FILTER_PROPERTIES = {
+  search: { type: 'string', description: 'Free-text match against name, description, and tags (e.g. "maple", "smooth").' },
+  tag: {
+    type: 'string',
+    description: 'Only drinks with this tag.',
+    enum: [...new Set(SEASONAL_FAVORITES.flatMap((d) => d.tags))].sort(),
+  },
+  temperature: { type: 'string', enum: TEMPERATURES, description: 'Only drinks served at this temperature.' },
+  maxPrice: { type: 'number', minimum: 0, description: 'Only drinks whose starting price (USD) is at or below this.' },
+  maxCaffeineMg: { type: 'number', minimum: 0, description: 'Only drinks with at most this much caffeine (mg, medium size).' },
+};
+
+const ok = (data) => JSON.stringify({ ok: true, ...data }, null, 2);
+const fail = (error) => JSON.stringify({ ok: false, error: error instanceof Error ? error.message : String(error) }, null, 2);
+
+/** Wrap a tool body so validation problems come back as readable results instead of opaque rejections. */
+function guarded(fn) {
+  return async (input = {}, context = {}) => {
+    try {
+      return await fn(input ?? {}, context);
+    } catch (err) {
+      if (err instanceof MenuError) return fail(err);
+      console.error('[WebMCP] tool failed', err);
+      return fail(`Unexpected error: ${err?.message ?? err}`);
+    }
+  };
+}
+
+const TOOLS = [
+  {
+    name: 'list_seasonal_favorites',
+    description:
+      'List the Seasonal Favorites coffee menu shown on The Daily Grind homepage, with prices, sizes, milk options, caffeine, tags, and allergens. Optional filters narrow the results. Read-only: does not change the page (use filter_menu_display for that).',
+    inputSchema: { type: 'object', properties: FILTER_PROPERTIES },
+    annotations: { readOnlyHint: true, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded((input) => {
+      const drinks = filterMenu(input).map(describeDrink);
+      return ok({
+        count: drinks.length,
+        criteria: describeCriteria(input) || 'none',
+        currency: 'USD',
+        drinks,
+      });
+    }),
+  },
+  {
+    name: 'get_drink_details',
+    description:
+      'Get full details for one Seasonal Favorites drink: description, price for every size, milk options and surcharges, caffeine, tags, and allergens.',
+    inputSchema: { type: 'object', properties: { drink: DRINK_PARAM }, required: ['drink'] },
+    annotations: { readOnlyHint: true, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded(({ drink }) => {
+      const found = findDrink(drink);
+      if (!found) throw new MenuError(`Unknown drink "${drink}". Call list_seasonal_favorites to see the menu.`);
+      return ok({ drink: describeDrink(found), currency: 'USD' });
+    }),
+  },
+  {
+    name: 'add_drink_to_order',
+    description:
+      "Add a Seasonal Favorites drink to the customer's pickup order in the on-page order panel. Nothing is purchased until checkout_order is submitted. Returns the added line and the updated order totals.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        drink: DRINK_PARAM,
+        size: { type: 'string', enum: SIZES, description: 'Cup size. Defaults to medium.' },
+        milk: {
+          type: 'string',
+          enum: MILKS,
+          description: 'Milk choice. Defaults to the drink\'s standard milk (oat for the Maple Oat Latte, none for espresso and cold brew). Oat and almond add $0.75 unless included.',
+        },
+        quantity: { type: 'integer', minimum: 1, maximum: MAX_QUANTITY_PER_LINE, description: 'How many. Defaults to 1.' },
+        notes: { type: 'string', maxLength: 140, description: 'Optional preparation note, e.g. "extra hot" or "light ice".' },
+      },
+      required: ['drink'],
+    },
+    annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded((input) => {
+      const line = addToOrder(input.drink, input);
+      return ok({ added: line, order: order.snapshot(), nextStep: `Submit ${CHECKOUT_TOOL_NAME} to place the order.` });
+    }),
+  },
+  {
+    name: 'update_order_line',
+    description:
+      'Change the quantity of an existing order line, or remove it by setting quantity to 0. Use get_order to find line ids.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        lineId: { type: 'string', description: 'The lineId from get_order or add_drink_to_order, e.g. "line-1".' },
+        quantity: { type: 'integer', minimum: 0, maximum: MAX_QUANTITY_PER_LINE, description: 'New quantity; 0 removes the line.' },
+      },
+      required: ['lineId', 'quantity'],
+    },
+    annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded(({ lineId, quantity }) => {
+      const line = order.update(lineId, quantity);
+      announce(line ? `Updated ${line.name} to ${line.quantity}.` : 'Removed an item from your order.');
+      return ok({ line, removed: line === null, order: order.snapshot() });
+    }),
+  },
+  {
+    name: 'clear_order',
+    description: 'Remove every drink from the on-page order. Does not affect orders that were already placed.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded(() => {
+      const removed = order.clear();
+      announce('Your order was cleared.');
+      return ok({ removedLines: removed, order: order.snapshot() });
+    }),
+  },
+  {
+    name: 'get_order',
+    description:
+      'Read the current on-page pickup order: lines with ids, quantities, prices, tax, total, and the most recently placed order confirmation if any.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded(() =>
+      ok({
+        order: order.snapshot(),
+        lastPlacedOrder: lastOrderConfirmation,
+        checkout: `Use the ${CHECKOUT_TOOL_NAME} tool (pickup name, pickup time, optional notes) to place the order.`,
+      }),
+    ),
+  },
+  {
+    name: 'highlight_drink',
+    description:
+      'Scroll the page to a Seasonal Favorites drink card and visually highlight it, optionally showing a short note on the card (for example why it was recommended). Purely a UI update.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        drink: DRINK_PARAM,
+        note: { type: 'string', maxLength: 120, description: 'Short note to display on the card, e.g. "Our pick for a sweet, dairy-free latte".' },
+      },
+      required: ['drink'],
+    },
+    annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded(({ drink, note }) => {
+      const found = findDrink(drink);
+      if (!found) throw new MenuError(`Unknown drink "${drink}". Call list_seasonal_favorites to see the menu.`);
+      if (activeFilter && !activeFilter.matchedIds.includes(found.id)) resetMenuFilter();
+      highlightCard(found.id, { note: String(note ?? '').trim() });
+      return ok({ highlighted: found.id, name: found.name, note: note ?? '' });
+    }),
+  },
+  {
+    name: 'filter_menu_display',
+    description:
+      'Update the Seasonal Favorites section on the page to show only drinks matching the given criteria (hides the rest and shows a filter banner). Pass reset=true to show every drink again.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        ...FILTER_PROPERTIES,
+        reset: { type: 'boolean', description: 'When true, clear any active filter and show all drinks.' },
+      },
+    },
+    annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
+    execute: guarded((input) => {
+      if (input.reset) {
+        resetMenuFilter();
+        announce('Showing all Seasonal Favorites.');
+        return ok({ showing: SEASONAL_FAVORITES.map((d) => d.id), criteria: 'none' });
+      }
+      const matches = applyMenuFilter(input);
+      clearHighlights();
+      announce(`Menu filtered: ${describeCriteria(input) || 'all drinks'}.`);
+      return ok({
+        showing: matches.map((d) => ({ id: d.id, name: d.name })),
+        hidden: SEASONAL_FAVORITES.filter((d) => !matches.includes(d)).map((d) => d.id),
+        criteria: describeCriteria(input) || 'none',
+      });
+    }),
+  },
+];
+
+// ---------------------------------------------------------------------------
+// Registration and page wiring
+// ---------------------------------------------------------------------------
+
+function getModelContext() {
+  return document.modelContext ?? navigator.modelContext ?? null;
+}
+
+function setAgentStatus(message, state) {
+  const el = $('#agent-status');
+  if (!el) return;
+  el.textContent = message;
+  el.dataset.state = state;
+}
+
+async function registerTools() {
+  const modelContext = getModelContext();
+  if (!modelContext || typeof modelContext.registerTool !== 'function') {
+    setAgentStatus('WebMCP agent tools are not available in this browser. The menu and order panel still work manually.', 'unavailable');
+    return [];
+  }
+
+  const controller = new AbortController();
+  const registered = [];
+  for (const tool of TOOLS) {
+    try {
+      await modelContext.registerTool(tool, { signal: controller.signal });
+      registered.push(tool.name);
+    } catch (err) {
+      console.error(`[WebMCP] failed to register ${tool.name}`, err);
+    }
+  }
+
+  if (typeof modelContext.addEventListener === 'function') {
+    modelContext.addEventListener('toolactivated', (event) => {
+      if (event.toolName === CHECKOUT_TOOL_NAME) {
+        $('#checkout-form')?.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block: 'center' });
+        announce('An assistant is filling in your pickup details. Review them, then place the order.');
+      }
+    });
+    modelContext.addEventListener('toolcancel', (event) => {
+      if (event.toolName === CHECKOUT_TOOL_NAME) announce('Checkout was cancelled.');
+    });
+  }
+
+  window.addEventListener('pagehide', () => controller.abort(), { once: true });
+
+  const declarative = $('#checkout-form')?.hasAttribute('toolname') ? 1 : 0;
+  const total = registered.length + declarative;
+  setAgentStatus(
+    `${total} WebMCP tools are available to AI agents on this page: ${[...registered, CHECKOUT_TOOL_NAME].join(', ')}.`,
+    'ready',
+  );
+  return registered;
+}
+
+function wireManualUI() {
+  // "Add to Order" buttons on each card.
+  $$('button.add-to-order[data-drink-id]').forEach((button) => {
+    button.addEventListener('click', () => {
+      try {
+        addToOrder(button.dataset.drinkId);
+      } catch (err) {
+        announce(err.message, { tone: 'error' });
+      }
+    });
+  });
+
+  $('#clear-order')?.addEventListener('click', () => {
+    order.clear();
+    announce('Your order was cleared.');
+  });
+
+  $('#menu-filter-clear')?.addEventListener('click', () => {
+    resetMenuFilter();
+    announce('Showing all Seasonal Favorites.');
+  });
+
+  $('#confirmation-dismiss')?.addEventListener('click', () => {
+    const panel = $('#order-confirmation');
+    if (panel) panel.hidden = true;
+  });
+
+  // Checkout form: works for people and, via the declarative WebMCP API, for agents.
+  const form = $('#checkout-form');
+  if (form) {
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const result = placeOrder(new FormData(form));
+      const feedback = $('#checkout-feedback');
+      if (feedback) {
+        feedback.textContent = result.ok ? '' : result.error;
+        feedback.hidden = result.ok;
+      }
+      // When an agent invoked the declarative tool, hand the outcome back to it.
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(JSON.stringify(result, null, 2)));
+      }
+    });
+  }
+
+  renderOrder();
+}
+
+function init() {
+  wireManualUI();
+  registerTools();
+  // Handy for DevTools / the Model Context Tool Inspector: window.dailyGrind.tools
+  window.dailyGrind = Object.freeze({ tools: TOOLS, order, menu: SEASONAL_FAVORITES });
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', init, { once: true });
+} else {
+  init();
+}
