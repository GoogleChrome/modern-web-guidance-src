+// ---------------------------------------------------------------------------
+// WebMCP tool registration (feature-detected; Chromium early preview only)
+// ---------------------------------------------------------------------------
+
+async function registerWebMcpTools() {
+  if (!("modelContext" in document)) return;
+
+  const controller = new AbortController();
+  // Unregister everything if the page is torn down (bfcache / SPA transitions).
+  window.addEventListener("pagehide", () => controller.abort(), { once: true });
+  const opts = { signal: controller.signal };
+  const mc = document.modelContext;
+
+  // Give a visible cue while an agent is driving the page.
+  const eventTarget = "ontoolactivated" in mc ? mc : window;
+  eventTarget.addEventListener("toolactivated", ({ toolName }) => {
+    document.body.classList.add("agent-active");
+    announce(`Assistant is using "${toolName}"…`);
+  }, opts);
+  eventTarget.addEventListener("toolcancel", () => {
+    document.body.classList.remove("agent-active");
+  }, opts);
+
+  const withAgentCue = (fn) => async (input, ctx) => {
+    try {
+      return await fn(input ?? {}, ctx ?? {});
+    } finally {
+      document.body.classList.remove("agent-active");
+    }
+  };
+
+  await Promise.all([
+    mc.registerTool({
+      name: "list_seasonal_favorites",
+      description:
+        "Lists every drink in the Seasonal Favorites section with prices per size, dietary tags, caffeine, and availability. Use this first when the user asks what's on the seasonal menu or wants a recommendation.",
+      inputSchema: { type: "object", properties: {} },
+      execute: withAgentCue(() => ({
+        drinks: MENU.map(publicDrink),
+        sizes: SIZES,
+        milks: MILKS,
+        milkUpcharge: MILK_UPCHARGE,
+        currency: "USD",
+      })),
+      annotations: { readOnlyHint: true },
+    }, opts),
+
+    mc.registerTool({
+      name: "get_drink_details",
+      description:
+        "Returns full details and the exact price of a single seasonal drink for a given size and milk. Use it to answer questions about one drink or to quote a price before ordering.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          drink: { type: "string", description: "The drink's id or name as shown on the menu." },
+          size: { type: "string", enum: SIZES, default: "medium", description: "Cup size to quote." },
+          milk: { type: "string", enum: MILKS, description: "Milk to quote; defaults to the drink's standard milk." },
+        },
+        required: ["drink"],
+      },
+      execute: withAgentCue(({ drink, size = "medium", milk }) => {
+        const found = findDrink(drink);
+        if (!found) return notFound(drink);
+        if (!SIZES.includes(size)) return { error: `Unknown size "${size}".`, sizes: SIZES };
+        milk = milk ?? found.defaultMilk;
+        if (!MILKS.includes(milk)) return { error: `Unknown milk "${milk}".`, milks: MILKS };
+        return { ...publicDrink(found), quote: { size, milk, price: priceFor(found, size, milk) } };
+      }),
+      annotations: { readOnlyHint: true },
+    }, opts),
+
+    mc.registerTool({
+      name: "filter_seasonal_favorites",
+      description:
+        "Changes which seasonal drinks are shown on the page and in what order, so the user can see only drinks matching their preferences. Call with no arguments to show the full menu again.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          tags: {
+            type: "array",
+            items: { type: "string", enum: TAGS },
+            description: "Only show drinks that carry every one of these tags.",
+          },
+          maxPrice: { type: "number", minimum: 0, description: "Hide drinks whose medium price is above this amount in USD." },
+          sortBy: { type: "string", enum: SORT_OPTIONS, default: "featured", description: "Display order of the cards." },
+        },
+      },
+      execute: withAgentCue(({ tags = [], maxPrice = null, sortBy = "featured" }) => {
+        if (!Array.isArray(tags) || !tags.every((t) => TAGS.includes(t))) {
+          return { error: "Unknown tag.", tags: TAGS };
+        }
+        if (maxPrice != null && !(Number(maxPrice) >= 0)) {
+          return { error: "maxPrice must be a non-negative number." };
+        }
+        if (!SORT_OPTIONS.includes(sortBy)) {
+          return { error: `Unknown sort "${sortBy}".`, sortOptions: SORT_OPTIONS };
+        }
+        state.filter = { tags, maxPrice: maxPrice == null ? null : Number(maxPrice), sortBy };
+        renderMenu();
+        $("#seasonal").scrollIntoView({ behavior: "smooth", block: "start" });
+        const shown = visibleDrinks();
+        return { ok: true, shown: shown.map((d) => ({ id: d.id, name: d.name, mediumPrice: priceFor(d) })), hiddenCount: MENU.length - shown.length };
+      }),
+      annotations: { readOnlyHint: false },
+    }, opts),
+
+    mc.registerTool({
+      name: "highlight_drink",
+      description:
+        "Scrolls the page to a seasonal drink and visually highlights its card for a few seconds. Use it to point the user at the drink you are talking about.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          drink: { type: "string", description: "The drink's id or name as shown on the menu." },
+        },
+        required: ["drink"],
+      },
+      execute: withAgentCue(({ drink }) => {
+        const found = findDrink(drink);
+        if (!found) return notFound(drink);
+        if (!visibleDrinks().some((d) => d.id === found.id)) {
+          state.filter = { tags: [], maxPrice: null, sortBy: "featured" };
+        }
+        highlight(found.id);
+        return { ok: true, highlighted: { id: found.id, name: found.name } };
+      }),
+      annotations: { readOnlyHint: false },
+    }, opts),
+
+    mc.registerTool({
+      name: "add_drink_to_order",
+      description:
+        "Adds a seasonal drink to the customer's order tray on this page. The tray is editable and nothing is charged until the order is placed.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          drinkId: { type: "string", description: "The drink's id or name as shown on the menu." },
+          size: { type: "string", enum: SIZES, default: "medium", description: "Cup size." },
+          milk: { type: "string", enum: MILKS, description: "Milk choice; defaults to the drink's standard milk." },
+          quantity: { type: "integer", minimum: 1, maximum: 12, default: 1, description: "How many of this exact drink." },
+          notes: { type: "string", maxLength: 140, description: "Barista instructions in the customer's own words, e.g. “extra hot” or “decaf”." },
+        },
+        required: ["drinkId"],
+      },
+      execute: withAgentCue((input) => {
+        const result = addToOrder(input);
+        if (result.ok) {
+          announce(`Assistant added ${result.added.drinkName} to your order.`);
+          $("#order").scrollIntoView({ behavior: "smooth", block: "nearest" });
+        }
+        return result;
+      }),
+      annotations: { readOnlyHint: false },
+    }, opts),
+
+    mc.registerTool({
+      name: "remove_drink_from_order",
+      description: "Removes one line from the order tray. Use get_current_order to find the line id.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          lineId: { type: "integer", description: "The line id of the entry to remove." },
+        },
+        required: ["lineId"],
+      },
+      execute: withAgentCue(({ lineId }) => removeFromOrder({ lineId })),
+      annotations: { readOnlyHint: false },
+    }, opts),
+
+    mc.registerTool({
+      name: "get_current_order",
+      description: "Returns the drinks currently in the order tray with line ids, prices and the running total.",
+      inputSchema: { type: "object", properties: {} },
+      execute: withAgentCue(() => orderSnapshot()),
+      annotations: { readOnlyHint: true },
+    }, opts),
+
+    mc.registerTool({
+      name: "place_order",
+      description:
+        "Submits the drinks in the order tray. The page shows the customer a confirmation dialog, and the order is only placed once they click Confirm themselves.",
+      inputSchema: { type: "object", properties: {} },
+      execute: withAgentCue(async (_input, { signal }) => {
+        try {
+          return await placeOrder(signal);
+        } catch (err) {
+          if (signal?.aborted) throw err; // cancelled: re-throw rather than return
+          return { error: err instanceof Error ? err.message : String(err) };
+        }
+      }),
+      annotations: { readOnlyHint: false, consequentialHint: true },
+    }, opts),
+  ]);
+}
+
+registerWebMcpTools().catch((err) => console.warn("WebMCP registration failed:", err));
