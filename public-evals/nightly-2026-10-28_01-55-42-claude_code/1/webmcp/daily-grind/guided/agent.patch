+// UI wiring
+// ---------------------------------------------------------------------------
+
+grid.addEventListener("click", (e) => {
+  const btn = e.target.closest('[data-action="add"]');
+  if (!btn) return;
+  const id = btn.closest("[data-drink-id]").dataset.drinkId;
+  const result = addToOrder({ drinkId: id });
+  if (result.ok) announce(`${result.added.drinkName} added to your order.`);
+});
+
+orderList.addEventListener("click", (e) => {
+  const btn = e.target.closest('[data-action="remove"]');
+  if (!btn) return;
+  removeFromOrder({ lineId: btn.closest("[data-line-id]").dataset.lineId });
+});
+
+clearBtn.addEventListener("click", clearOrder);
+placeBtn.addEventListener("click", () => placeOrder());
+$("#reset-filter-btn").addEventListener("click", () => {
+  state.filter = { tags: [], maxPrice: null, sortBy: "featured" };
+  renderMenu();
+});
+
+renderMenu();
+renderOrder();
