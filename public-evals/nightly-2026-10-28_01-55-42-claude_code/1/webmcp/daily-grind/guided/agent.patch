diff --git a/webmcp-tools.js b/webmcp-tools.js
new file mode 100644
index 0000000..cffffc3
--- /dev/null
+++ b/webmcp-tools.js
@@ -0,0 +1,591 @@
+/**
+ * The Daily Grind — WebMCP tools for the homepage.
+ *
+ * Exposes the "Seasonal Favorites" menu and an in-page order tray to AI agents
+ * through the WebMCP Imperative API (document.modelContext.registerTool).
+ * Everything here runs client-side in the tab; there is no backend. Placing an
+ * order is simulated and always requires the user to confirm in a <dialog>.
+ *
+ * Browsers without WebMCP still get the rendered menu and order tray — the
+ * tool registration is simply skipped.
+ */
+
+// ---------------------------------------------------------------------------
+// Menu data (single source of truth for both the rendered cards and the tools)
+// ---------------------------------------------------------------------------
+
+const SIZES = ["small", "medium", "large"];
+const MILKS = ["whole", "skim", "oat", "almond", "none"];
+const TAGS = ["hot", "iced", "dairy-free", "decaf-available", "signature"];
+const SORT_OPTIONS = ["featured", "price_low_to_high", "price_high_to_low", "name"];
+
+const SIZE_UPCHARGE = { small: 0, medium: 0.6, large: 1.1 };
+const MILK_UPCHARGE = { whole: 0, skim: 0, oat: 0.75, almond: 0.75, none: 0 };
+
+const MENU = [
+  {
+    id: "maple-oat-latte",
+    name: "Maple Oat Latte",
+    description: "Creamy oat milk with a hint of Vermont maple syrup.",
+    basePrice: 5.25,
+    tags: ["hot", "dairy-free", "signature"],
+    defaultMilk: "oat",
+    caffeineMg: 150,
+    available: true,
+    detailsUrl: "/menu/seasonal",
+    image: "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=70",
+  },
+  {
+    id: "dark-roast-espresso",
+    name: "Dark Roast Espresso",
+    description: "Bold, smokey, and perfect for a morning boost.",
+    basePrice: 3.5,
+    tags: ["hot", "dairy-free"],
+    defaultMilk: "none",
+    caffeineMg: 130,
+    available: true,
+    detailsUrl: "/menu/espresso",
+    image: "https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=70",
+  },
+  {
+    id: "cold-brew",
+    name: "Cold Brew",
+    description: "Steeped for 18 hours for maximum smoothness.",
+    basePrice: 4.75,
+    tags: ["iced", "dairy-free", "signature"],
+    defaultMilk: "none",
+    caffeineMg: 200,
+    available: true,
+    detailsUrl: "/menu/cold-brew",
+    image: "https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=70",
+  },
+  {
+    id: "pumpkin-spice-chai",
+    name: "Pumpkin Spice Chai",
+    description: "House chai with pumpkin purée, cinnamon, and nutmeg. Decaf on request.",
+    basePrice: 5.0,
+    tags: ["hot", "decaf-available"],
+    defaultMilk: "whole",
+    caffeineMg: 70,
+    available: true,
+    detailsUrl: "/menu/seasonal",
+    image: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=600&q=70",
+  },
+];
+
+const money = (n) => `$${n.toFixed(2)}`;
+
+function priceFor(drink, size = "medium", milk = drink.defaultMilk) {
+  // Milk is only an upcharge when it differs from the drink's standard milk.
+  const milkUpcharge = milk === drink.defaultMilk ? 0 : MILK_UPCHARGE[milk];
+  return Math.round((drink.basePrice + SIZE_UPCHARGE[size] + milkUpcharge) * 100) / 100;
+}
+
+function publicDrink(drink) {
+  return {
+    id: drink.id,
+    name: drink.name,
+    description: drink.description,
+    tags: drink.tags,
+    available: drink.available,
+    caffeineMg: drink.caffeineMg,
+    defaultMilk: drink.defaultMilk,
+    prices: Object.fromEntries(SIZES.map((s) => [s, priceFor(drink, s)])),
+    detailsUrl: drink.detailsUrl,
+  };
+}
+
+/** Find a drink by id or (case-insensitive) name. */
+function findDrink(idOrName) {
+  if (typeof idOrName !== "string") return null;
+  const needle = idOrName.trim().toLowerCase();
+  return (
+    MENU.find((d) => d.id === needle) ||
+    MENU.find((d) => d.name.toLowerCase() === needle) ||
+    MENU.find((d) => d.name.toLowerCase().includes(needle)) ||
+    null
+  );
+}
+
+function notFound(idOrName) {
+  return {
+    error: `No seasonal favorite matches "${idOrName}".`,
+    availableDrinks: MENU.map((d) => ({ id: d.id, name: d.name })),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Page state + rendering
+// ---------------------------------------------------------------------------
+
+const state = {
+  filter: { tags: [], maxPrice: null, sortBy: "featured" },
+  order: [], // { lineId, drinkId, size, milk, quantity, notes, unitPrice }
+  nextLineId: 1,
+  highlightedId: null,
+};
+
+const $ = (sel) => document.querySelector(sel);
+const grid = $("#seasonal-grid");
+const emptyMsg = $("#seasonal-empty");
+const filterStatus = $("#seasonal-filter-status");
+const orderList = $("#order-items");
+const orderTotal = $("#order-total");
+const orderEmpty = $("#order-empty");
+const placeBtn = $("#place-order-btn");
+const clearBtn = $("#clear-order-btn");
+const toast = $("#agent-toast");
+const dialog = $("#confirm-order-dialog");
+const dialogSummary = $("#confirm-order-summary");
+
+function visibleDrinks() {
+  const { tags, maxPrice, sortBy } = state.filter;
+  let list = MENU.filter(
+    (d) =>
+      tags.every((t) => d.tags.includes(t)) &&
+      (maxPrice == null || priceFor(d) <= maxPrice)
+  );
+  const sorters = {
+    featured: () => 0,
+    price_low_to_high: (a, b) => priceFor(a) - priceFor(b),
+    price_high_to_low: (a, b) => priceFor(b) - priceFor(a),
+    name: (a, b) => a.name.localeCompare(b.name),
+  };
+  return [...list].sort(sorters[sortBy]);
+}
+
+function renderMenu() {
+  const drinks = visibleDrinks();
+  grid.replaceChildren(
+    ...drinks.map((d) => {
+      const card = document.createElement("article");
+      card.className = "card";
+      card.dataset.drinkId = d.id;
+      if (d.id === state.highlightedId) card.classList.add("is-highlighted");
+      card.innerHTML = `
+        <img src="${d.image}" alt="" width="600" height="400" loading="lazy" decoding="async">
+        <h3></h3>
+        <p class="card-desc"></p>
+        <p class="card-price"></p>
+        <ul class="tag-list"></ul>
+        <div class="card-actions">
+          <a class="btn btn-secondary" href="${d.detailsUrl}">View Details</a>
+          <button type="button" class="btn" data-action="add">Add to Order</button>
+        </div>`;
+      card.querySelector("h3").textContent = d.name;
+      card.querySelector(".card-desc").textContent = d.description;
+      card.querySelector(".card-price").textContent = `from ${money(priceFor(d, "small"))}`;
+      card.querySelector(".tag-list").replaceChildren(
+        ...d.tags.map((t) => Object.assign(document.createElement("li"), { textContent: t }))
+      );
+      return card;
+    })
+  );
+  emptyMsg.hidden = drinks.length > 0;
+
+  const parts = [];
+  if (state.filter.tags.length) parts.push(`tags: ${state.filter.tags.join(", ")}`);
+  if (state.filter.maxPrice != null) parts.push(`under ${money(state.filter.maxPrice)}`);
+  if (state.filter.sortBy !== "featured") parts.push(`sorted by ${state.filter.sortBy.replaceAll("_", " ")}`);
+  filterStatus.textContent = parts.length ? `Showing ${drinks.length} of ${MENU.length} · ${parts.join(" · ")}` : "";
+  $("#reset-filter-btn").hidden = parts.length === 0;
+}
+
+function orderTotals() {
+  const subtotal = state.order.reduce((sum, l) => sum + l.unitPrice * l.quantity, 0);
+  const itemCount = state.order.reduce((n, l) => n + l.quantity, 0);
+  return { itemCount, subtotal: Math.round(subtotal * 100) / 100 };
+}
+
+function describeLine(l) {
+  const drink = MENU.find((d) => d.id === l.drinkId);
+  const milk = l.milk === "none" ? "no milk" : `${l.milk} milk`;
+  return `${l.quantity} × ${l.size} ${drink.name} (${milk})${l.notes ? ` — ${l.notes}` : ""}`;
+}
+
+function renderOrder() {
+  orderList.replaceChildren(
+    ...state.order.map((l) => {
+      const li = document.createElement("li");
+      li.dataset.lineId = l.lineId;
+      const text = document.createElement("span");
+      text.textContent = describeLine(l);
+      const price = document.createElement("strong");
+      price.textContent = money(l.unitPrice * l.quantity);
+      const remove = document.createElement("button");
+      remove.type = "button";
+      remove.className = "link-btn";
+      remove.dataset.action = "remove";
+      remove.setAttribute("aria-label", `Remove ${describeLine(l)}`);
+      remove.textContent = "Remove";
+      li.append(text, price, remove);
+      return li;
+    })
+  );
+  const { itemCount, subtotal } = orderTotals();
+  orderEmpty.hidden = itemCount > 0;
+  orderTotal.textContent = money(subtotal);
+  placeBtn.disabled = itemCount === 0;
+  clearBtn.disabled = itemCount === 0;
+  $("#order-count").textContent = itemCount ? `(${itemCount})` : "";
+}
+
+let toastTimer;
+function announce(message) {
+  toast.textContent = message;
+  toast.classList.add("is-visible");
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 4000);
+}
+
+function highlight(drinkId) {
+  state.highlightedId = drinkId;
+  renderMenu();
+  const card = grid.querySelector(`[data-drink-id="${drinkId}"]`);
+  card?.scrollIntoView({ behavior: "smooth", block: "center" });
+  setTimeout(() => {
+    if (state.highlightedId === drinkId) {
+      state.highlightedId = null;
+      grid.querySelector(`[data-drink-id="${drinkId}"]`)?.classList.remove("is-highlighted");
+    }
+  }, 4000);
+}
+
+// ---------------------------------------------------------------------------
+// Order operations (shared by the UI buttons and the agent tools)
+// ---------------------------------------------------------------------------
+
+function addToOrder({ drinkId, size = "medium", milk, quantity = 1, notes = "" }) {
+  const drink = findDrink(drinkId);
+  if (!drink) return notFound(drinkId);
+  if (!drink.available) return { error: `${drink.name} is sold out right now.` };
+  if (!SIZES.includes(size)) return { error: `Unknown size "${size}".`, sizes: SIZES };
+  milk = milk ?? drink.defaultMilk;
+  if (!MILKS.includes(milk)) return { error: `Unknown milk "${milk}".`, milks: MILKS };
+  quantity = Number(quantity);
+  if (!Number.isInteger(quantity) || quantity < 1 || quantity > 12) {
+    return { error: "Quantity must be a whole number between 1 and 12." };
+  }
+  if (typeof notes !== "string" || notes.length > 140) {
+    return { error: "Notes must be text of 140 characters or fewer." };
+  }
+
+  const line = {
+    lineId: state.nextLineId++,
+    drinkId: drink.id,
+    size,
+    milk,
+    quantity,
+    notes: notes.trim(),
+    unitPrice: priceFor(drink, size, milk),
+  };
+  state.order.push(line);
+  renderOrder();
+  return { ok: true, added: { ...line, drinkName: drink.name }, order: orderSnapshot() };
+}
+
+function removeFromOrder({ lineId }) {
+  const idx = state.order.findIndex((l) => l.lineId === Number(lineId));
+  if (idx === -1) {
+    return { error: `No order line with id ${lineId}.`, order: orderSnapshot() };
+  }
+  const [removed] = state.order.splice(idx, 1);
+  renderOrder();
+  return { ok: true, removed: describeLine(removed), order: orderSnapshot() };
+}
+
+function clearOrder() {
+  state.order = [];
+  renderOrder();
+}
+
+function orderSnapshot() {
+  return {
+    lines: state.order.map((l) => ({
+      lineId: l.lineId,
+      drinkId: l.drinkId,
+      drinkName: MENU.find((d) => d.id === l.drinkId).name,
+      size: l.size,
+      milk: l.milk,
+      quantity: l.quantity,
+      notes: l.notes,
+      unitPrice: l.unitPrice,
+      lineTotal: Math.round(l.unitPrice * l.quantity * 100) / 100,
+    })),
+    ...orderTotals(),
+  };
+}
+
+/**
+ * Opens the confirmation dialog and resolves with the user's decision.
+ * The optional AbortSignal closes the dialog if the caller cancels.
+ */
+function confirmOrder(signal) {
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) return reject(signal.reason);
+    const { subtotal } = orderTotals();
+    dialogSummary.replaceChildren(
+      ...state.order.map((l) => Object.assign(document.createElement("li"), { textContent: describeLine(l) })),
+      Object.assign(document.createElement("li"), { textContent: `Total: ${money(subtotal)}`, className: "summary-total" })
+    );
+    const onClose = () => {
+      cleanup();
+      resolve(dialog.returnValue === "confirm");
+    };
+    const onAbort = () => {
+      cleanup();
+      dialog.close("cancel");
+      reject(signal.reason);
+    };
+    const cleanup = () => {
+      dialog.removeEventListener("close", onClose);
+      signal?.removeEventListener("abort", onAbort);
+    };
+    dialog.addEventListener("close", onClose);
+    signal?.addEventListener("abort", onAbort);
+    dialog.showModal();
+  });
+}
+
+async function placeOrder(signal) {
+  if (state.order.length === 0) {
+    return { error: "The order is empty. Add a drink first." };
+  }
+  const confirmed = await confirmOrder(signal);
+  if (!confirmed) {
+    return { ok: false, status: "cancelled_by_user", message: "The customer declined to place the order." };
+  }
+  const receipt = {
+    orderNumber: `DG-${Date.now().toString(36).toUpperCase().slice(-6)}`,
+    placedAt: new Date().toISOString(),
+    ...orderSnapshot(),
+  };
+  clearOrder();
+  announce(`Order ${receipt.orderNumber} placed. Total ${money(receipt.subtotal)}.`);
+  return { ok: true, status: "placed", receipt };
+}
