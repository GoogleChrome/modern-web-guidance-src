--- /dev/null
+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,131 @@
+/**
+ * Helpers for reaching resources on the user's local network (LAN devices
+ * such as printers, routers or IoT hubs) or loopback interface (companion
+ * services on 127.0.0.1 / [::1] / localhost) from this public web app.
+ *
+ * Browsers gate such requests behind the granular Local Network Access (LNA)
+ * permissions `local-network` and `loopback-network`. Requests must be made
+ * from a secure context and should be triggered by an explicit user gesture
+ * whenever the permission state is still `prompt`.
+ */
+
+export type LocalAddressSpace = 'local' | 'loopback';
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+
+export type LnaPermissionState = PermissionState | 'unsupported';
+
+export const PERMISSION_FOR_SPACE: Record<LocalAddressSpace, LnaPermissionName> = {
+  local: 'local-network',
+  loopback: 'loopback-network',
+};
+
+/**
+ * Safely queries one of the granular LNA permissions.
+ *
+ * Returns `'prompt'` when the Permissions API or the permission name is not
+ * recognised, so callers still attempt the request on a user gesture (the
+ * connection attempt itself triggers the browser prompt where LNA exists).
+ *
+ * Never queries the legacy combined name `'local-network-access'`: in older
+ * Chrome versions that query crashes the renderer and cannot be caught.
+ */
+export async function queryLnaPermission(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void,
+): Promise<LnaPermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'unsupported';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    if (onChange) {
+      // Keep callers in sync if the user flips the permission in site settings.
+      status.addEventListener('change', () => onChange(status.state));
+    }
+    return status.state;
+  } catch {
+    // Unrecognised permission name in this browser; proceed on user gesture.
+    return 'prompt';
+  }
+}
+
+/**
+ * Heuristically picks the address space for a URL so the right permission is
+ * queried and the right `targetAddressSpace` is declared. Hostnames that are
+ * not syntactically recognisable as loopback default to `local`.
+ */
+export function guessAddressSpace(url: URL): LocalAddressSpace {
+  const host = url.hostname.replace(/^\[|\]$/g, '').toLowerCase();
+  if (
+    host === 'localhost' ||
+    host.endsWith('.localhost') ||
+    host === '::1' ||
+    /^127(?:\.\d{1,3}){3}$/.test(host)
+  ) {
+    return 'loopback';
+  }
+  return 'local';
+}
+
+export interface LocalFetchResult {
+  status: number;
+  statusText: string;
+  contentType: string | null;
+  body: string;
+}
+
+/**
+ * Fetches a resource on the local network or loopback interface.
+ *
+ * Declaring `targetAddressSpace` is mandatory for http:// endpoints reached
+ * from an https:// page: it exempts the request from Mixed Content blocking
+ * once the permission is granted, and makes the browser verify after DNS
+ * resolution that the host really lives in the declared address space.
+ */
+export async function fetchLocalResource(
+  url: string | URL,
+  space: LocalAddressSpace,
+  init: Omit<RequestInit, 'targetAddressSpace'> = {},
+): Promise<LocalFetchResult> {
+  const request = new Request(url, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    targetAddressSpace: space,
+  });
+
+  const response = await fetch(request);
+  const body = await response.text();
+
+  return {
+    status: response.status,
+    statusText: response.statusText,
+    contentType: response.headers.get('content-type'),
+    body,
+  };
+}
+
+/**
+ * Translates a failed local request into actionable remediation text.
+ */
+export function describeLocalFetchError(err: unknown, space: LocalAddressSpace): string {
+  const target = space === 'loopback' ? 'companion service' : 'device';
+  const permission = space === 'loopback' ? 'Loopback network' : 'Local network';
+
+  if (typeof window !== 'undefined' && !window.isSecureContext) {
+    return `This page is not served over HTTPS. Browsers deny ${permission.toLowerCase()} access in insecure contexts.`;
+  }
+
+  if (err instanceof TypeError) {
+    return (
+      `Could not reach the ${target}. Check that it is powered on and reachable from this computer, ` +
+      `that the address really is a ${space} address, that it sends CORS headers (Access-Control-Allow-Origin), ` +
+      `and that "${permission}" is allowed for this site in your browser's site settings.`
+    );
+  }
+
+  return err instanceof Error ? err.message : 'Unknown error while contacting the local endpoint.';
+}
