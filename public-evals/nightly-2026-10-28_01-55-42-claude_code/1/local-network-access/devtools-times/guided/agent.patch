+++ b/src/components/LocalNetworkPanel.tsx
@@ -0,0 +1,234 @@
+import React, { useEffect, useState, useId } from 'react';
+import {
+  PERMISSION_FOR_SPACE,
+  describeLocalFetchError,
+  fetchLocalResource,
+  guessAddressSpace,
+  queryLnaPermission,
+  type LnaPermissionState,
+  type LocalAddressSpace,
+  type LocalFetchResult,
+} from '../utils/localNetwork';
+
+interface SectionConfig {
+  space: LocalAddressSpace;
+  heading: string;
+  description: string;
+  defaultUrl: string;
+  settingsLabel: string;
+}
+
+const SECTIONS: SectionConfig[] = [
+  {
+    space: 'local',
+    heading: 'Local network device',
+    description:
+      'Reach a device on your LAN, such as a router, printer or smart-home hub (10.x.x.x, 172.16–31.x.x, 192.168.x.x or a .local hostname).',
+    defaultUrl: 'http://192.168.1.1/',
+    settingsLabel: 'Local network',
+  },
+  {
+    space: 'loopback',
+    heading: 'Loopback companion service',
+    description:
+      'Reach a service running on this computer, such as a local dev server or companion app (127.0.0.1, [::1] or localhost).',
+    defaultUrl: 'http://localhost:11224/devtools-times/api/plant-stats',
+    settingsLabel: 'Loopback network',
+  },
+];
+
+const STATE_STYLES: Record<LnaPermissionState, string> = {
+  granted: 'bg-green-100 text-green-800',
+  prompt: 'bg-amber-100 text-amber-800',
+  denied: 'bg-red-100 text-red-800',
+  unsupported: 'bg-gray-100 text-gray-700',
+};
+
+const STATE_LABELS: Record<LnaPermissionState, string> = {
+  granted: 'Allowed',
+  prompt: 'Will ask',
+  denied: 'Blocked',
+  unsupported: 'Not supported',
+};
+
+function LocalNetworkSection({ space, heading, description, defaultUrl, settingsLabel }: SectionConfig) {
+  const inputId = useId();
+  const permissionName = PERMISSION_FOR_SPACE[space];
+
+  const [permission, setPermission] = useState<LnaPermissionState>('prompt');
+  const [url, setUrl] = useState(defaultUrl);
+  const [loading, setLoading] = useState(false);
+  const [result, setResult] = useState<LocalFetchResult | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [mismatch, setMismatch] = useState<string | null>(null);
+
+  // Pre-check the granular permission on mount and keep the badge in sync
+  // when the user changes it in site settings. Nothing is fetched here.
+  useEffect(() => {
+    let cancelled = false;
+    queryLnaPermission(permissionName, (next) => {
+      if (!cancelled) setPermission(next);
+    }).then((state) => {
+      if (!cancelled) setPermission(state);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [permissionName]);
+
+  // Warn (without blocking) when the entered host does not look like the
+  // address space this section declares; the browser will reject mismatches.
+  useEffect(() => {
+    try {
+      const parsed = new URL(url);
+      const guessed = guessAddressSpace(parsed);
+      setMismatch(
+        guessed === space
+          ? null
+          : `"${parsed.hostname}" looks like a ${guessed} address, but this request will be declared as ${space}. The browser aborts requests whose resolved address does not match.`,
+      );
+    } catch {
+      setMismatch(null);
+    }
+  }, [url, space]);
+
+  // Only ever runs from an explicit user gesture (the form submit button).
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setResult(null);
+    setLoading(true);
+    try {
+      const data = await fetchLocalResource(url, space);
+      setResult(data);
+      // A successful request implies the permission is now granted.
+      setPermission((prev) => (prev === 'prompt' ? 'granted' : prev));
+    } catch (err) {
+      setError(describeLocalFetchError(err, space));
+      // Re-read the state: the user may have just dismissed or denied the prompt.
+      queryLnaPermission(permissionName).then(setPermission);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const disabled = loading || permission === 'denied';
+
+  return (
+    <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby={`${inputId}-heading`}>
+      <div className="flex items-start justify-between gap-4 mb-2">
+        <h2 id={`${inputId}-heading`} className="text-xl font-bold text-gray-900">
+          {heading}
+        </h2>
+        <span
+          className={`shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${STATE_STYLES[permission]}`}
+          data-permission-status={permissionName}
+          title={`Browser permission "${permissionName}": ${permission}`}
+        >
+          {STATE_LABELS[permission]}
+        </span>
+      </div>
+      <p className="text-sm text-gray-600 mb-4">{description}</p>
+
+      {permission === 'prompt' && (
+        <p className="mb-4 p-3 text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg">
+          Your browser will ask for permission before this site can contact the {settingsLabel.toLowerCase()}.
+          Nothing is sent until you press <strong>Connect</strong>.
+        </p>
+      )}
+
+      {permission === 'denied' && (
+        <div
+          className="mb-4 p-3 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg"
+          role="alert"
+          data-remediation={permissionName}
+        >
+          <p className="font-semibold mb-1">{settingsLabel} access is blocked for this site.</p>
+          <p>
+            To re-enable it, open the lock / tune icon in the address bar, choose <em>Site settings</em>, set{' '}
+            <em>{settingsLabel}</em> to <em>Allow</em> or <em>Ask</em>, then reload this page.
+          </p>
+        </div>
+      )}
+
+      {permission === 'unsupported' && (
+        <p className="mb-4 p-3 text-sm text-gray-700 bg-gray-50 border border-gray-200 rounded-lg">
+          This browser does not expose the <code>{permissionName}</code> permission. The request will still be
+          attempted; it may be blocked as mixed content or by a firewall.
+        </p>
+      )}
+
+      <form onSubmit={handleSubmit} className="space-y-3">
+        <div>
+          <label htmlFor={inputId} className="block text-sm font-medium text-gray-700 mb-1">
+            Endpoint URL
+          </label>
+          <input
+            id={inputId}
+            type="url"
+            inputMode="url"
+            autoComplete="off"
+            spellCheck={false}
+            required
+            value={url}
+            onChange={(e) => setUrl(e.target.value)}
+            className="w-full px-3 py-2 font-mono text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          {mismatch && <p className="mt-1 text-xs text-amber-700">{mismatch}</p>}
+        </div>
+
+        <button
+          type="submit"
+          disabled={disabled}
+          className={`py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            disabled ? 'opacity-60 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Connecting…' : 'Connect'}
+        </button>
+      </form>
+
+      <div aria-live="polite" className="mt-4 space-y-3">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {result && (
+          <div className="text-sm">
+            <p className="text-green-700 bg-green-100 rounded-lg p-3 mb-2">
+              Response received: HTTP {result.status} {result.statusText}
+              {result.contentType ? ` · ${result.contentType}` : ''}
+            </p>
+            <pre className="max-h-64 overflow-auto p-3 bg-gray-900 text-gray-100 text-xs rounded-lg whitespace-pre-wrap break-all">
+              {result.body.length > 4000 ? `${result.body.slice(0, 4000)}\n… (truncated)` : result.body || '(empty body)'}
+            </pre>
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
+
+export default function LocalNetworkPanel() {
+  const [secure, setSecure] = useState(true);
+
+  useEffect(() => {
+    setSecure(window.isSecureContext);
+  }, []);
+
+  return (
+    <div className="space-y-6">
+      {!secure && (
+        <div className="p-3 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg" role="alert">
+          This page is not a secure context. Browsers automatically deny Local Network Access from plain{' '}
+          <code>http://</code> pages, so the requests below will fail until the site is served over HTTPS.
+        </div>
+      )}
+      {SECTIONS.map((section) => (
+        <LocalNetworkSection key={section.space} {...section} />
+      ))}
+    </div>
+  );
+}
