@@ -0,0 +1,85 @@
+/**
+ * Helpers for Chrome's Local Network Access (LNA) feature.
+ *
+ * LNA splits the network into three IP address spaces. A secure, public page
+ * that wants to reach a less-public space must declare the target space on
+ * the request so the browser can prompt the user for permission and relax
+ * mixed-content blocking for plain `http://` local targets.
+ *
+ * See https://github.com/explainers-by-googlers/local-network-access
+ */
+export type TargetAddressSpace = 'loopback' | 'local' | 'public';
+
+/** `fetch()` init options extended with the LNA `targetAddressSpace` member. */
+export interface LocalNetworkRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+const LOOPBACK_HOSTS = new Set(['localhost', '127.0.0.1', '::1', '[::1]', '0.0.0.0']);
+
+/** Best-effort guess of the address space a hostname belongs to. */
+export function inferAddressSpace(hostname: string): TargetAddressSpace {
+  const host = hostname.toLowerCase().replace(/\.$/, '');
+
+  if (LOOPBACK_HOSTS.has(host) || host.endsWith('.localhost') || /^127\.\d+\.\d+\.\d+$/.test(host)) {
+    return 'loopback';
+  }
+
+  if (host.endsWith('.local') || host.endsWith('.internal') || host.endsWith('.home.arpa')) {
+    return 'local';
+  }
+
+  const ipv4 = host.match(/^(\d+)\.(\d+)\.(\d+)\.(\d+)$/);
+  if (ipv4) {
+    const [a, b] = [Number(ipv4[1]), Number(ipv4[2])];
+    if (a === 10) return 'local'; // 10.0.0.0/8
+    if (a === 172 && b >= 16 && b <= 31) return 'local'; // 172.16.0.0/12
+    if (a === 192 && b === 168) return 'local'; // 192.168.0.0/16
+    if (a === 169 && b === 254) return 'local'; // link-local
+    if (a === 100 && b >= 64 && b <= 127) return 'local'; // CGNAT 100.64.0.0/10
+    return 'public';
+  }
+
+  const ipv6 = host.replace(/^\[|\]$/g, '');
+  if (/^f[cd][0-9a-f]{2}:/i.test(ipv6)) return 'local'; // unique local fc00::/7
+  if (/^fe[89ab][0-9a-f]:/i.test(ipv6)) return 'local'; // link-local fe80::/10
+
+  return 'public';
+}
+
+export type PermissionStatusName = PermissionState | 'unsupported';
+
+/** Query the current state of the `local-network-access` permission. */
+export async function queryLocalNetworkPermission(): Promise<{
+  state: PermissionStatusName;
+  status?: PermissionStatus;
+}> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return { state: 'unsupported' };
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: 'local-network-access' as PermissionName,
+    });
+    return { state: status.state, status };
+  } catch {
+    // Browsers without LNA reject unknown permission names with a TypeError.
+    return { state: 'unsupported' };
+  }
+}
+
+/**
+ * Fetch a resource on the user's local network or loopback interface.
+ *
+ * `targetAddressSpace` is required so Chrome can show the Local Network
+ * Access permission prompt and allow an `http://` target from an `https://`
+ * page. When omitted it is inferred from the URL's hostname.
+ */
+export function fetchLocalNetwork(
+  url: string | URL,
+  init: LocalNetworkRequestInit = {},
+): Promise<Response> {
+  const target = new URL(url, typeof location !== 'undefined' ? location.href : undefined);
+  const targetAddressSpace = init.targetAddressSpace ?? inferAddressSpace(target.hostname);
+  return fetch(target, { ...init, targetAddressSpace } as RequestInit);
+}
