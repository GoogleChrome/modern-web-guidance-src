+++ b/src/components/LocalNetworkAccess.tsx
@@ -0,0 +1,226 @@
+import React, { useEffect, useState } from 'react';
+import {
+  fetchLocalNetwork,
+  inferAddressSpace,
+  queryLocalNetworkPermission,
+  type PermissionStatusName,
+  type TargetAddressSpace,
+} from '../utils/localNetwork';
+
+type AddressSpaceChoice = TargetAddressSpace | 'auto';
+
+interface FetchResult {
+  ok: boolean;
+  status: number;
+  statusText: string;
+  type: ResponseType;
+  contentType: string | null;
+  body: string;
+  durationMs: number;
+}
+
+const PERMISSION_LABELS: Record<PermissionStatusName, { label: string; className: string }> = {
+  granted: { label: 'Granted', className: 'bg-green-100 text-green-800' },
+  denied: { label: 'Denied', className: 'bg-red-100 text-red-800' },
+  prompt: { label: 'Will prompt', className: 'bg-yellow-100 text-yellow-800' },
+  unsupported: { label: 'Not supported in this browser', className: 'bg-gray-200 text-gray-700' },
+};
+
+const MAX_BODY_PREVIEW = 2000;
+
+export default function LocalNetworkAccess() {
+  const [url, setUrl] = useState('http://localhost:8080/');
+  const [addressSpace, setAddressSpace] = useState<AddressSpaceChoice>('auto');
+  const [noCors, setNoCors] = useState(false);
+  const [permission, setPermission] = useState<PermissionStatusName>('unsupported');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [result, setResult] = useState<FetchResult | null>(null);
+
+  useEffect(() => {
+    let status: PermissionStatus | undefined;
+    const onChange = () => status && setPermission(status.state);
+
+    queryLocalNetworkPermission().then((res) => {
+      setPermission(res.state);
+      status = res.status;
+      status?.addEventListener('change', onChange);
+    });
+
+    return () => status?.removeEventListener('change', onChange);
+  }, []);
+
+  let inferredSpace: TargetAddressSpace | null = null;
+  try {
+    inferredSpace = inferAddressSpace(new URL(url).hostname);
+  } catch {
+    inferredSpace = null;
+  }
+  const effectiveSpace = addressSpace === 'auto' ? inferredSpace : addressSpace;
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setResult(null);
+    setLoading(true);
+
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 10_000);
+    const started = performance.now();
+
+    try {
+      const response = await fetchLocalNetwork(url, {
+        method: 'GET',
+        mode: noCors ? 'no-cors' : 'cors',
+        cache: 'no-store',
+        signal: controller.signal,
+        ...(addressSpace !== 'auto' ? { targetAddressSpace: addressSpace } : {}),
+      });
+
+      const text = response.type === 'opaque' ? '' : await response.text();
+      setResult({
+        ok: response.ok,
+        status: response.status,
+        statusText: response.statusText,
+        type: response.type,
+        contentType: response.headers.get('content-type'),
+        body: text.slice(0, MAX_BODY_PREVIEW),
+        durationMs: Math.round(performance.now() - started),
+      });
+    } catch (err) {
+      if (err instanceof DOMException && err.name === 'AbortError') {
+        setError('The request timed out after 10 seconds.');
+      } else {
+        setError(
+          `${err instanceof Error ? err.message : String(err)}. ` +
+            'If you denied the permission prompt, the browser blocks the request. ' +
+            'Open DevTools > Network and inspect the failed request for details.',
+        );
+      }
+    } finally {
+      clearTimeout(timeout);
+      setLoading(false);
+      queryLocalNetworkPermission().then((res) => setPermission(res.state));
+    }
+  };
+
+  const badge = PERMISSION_LABELS[permission];
+
+  return (
+    <div className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <h2 className="text-xl font-bold text-gray-800">Request a local resource</h2>
+        <span
+          className={`text-xs font-semibold px-2 py-1 rounded ${badge.className}`}
+          data-testid="lna-permission-state"
+        >
+          Permission: {badge.label}
+        </span>
+      </div>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      <form onSubmit={handleSubmit} className="space-y-4">
+        <div>
+          <label htmlFor="lna-url" className="block text-sm font-medium text-gray-700 mb-1">
+            Resource URL
+          </label>
+          <input
+            type="url"
+            id="lna-url"
+            value={url}
+            onChange={(e) => setUrl(e.target.value)}
+            placeholder="http://192.168.1.50/status"
+            required
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          <p className="mt-1 text-xs text-gray-500">
+            Examples: <code>http://localhost:3000/</code>, <code>http://127.0.0.1:8000/api</code>,{' '}
+            <code>http://192.168.1.1/</code>, <code>http://printer.local/</code>
+          </p>
+        </div>
+
+        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+          <div>
+            <label htmlFor="lna-space" className="block text-sm font-medium text-gray-700 mb-1">
+              Target address space
+            </label>
+            <select
+              id="lna-space"
+              value={addressSpace}
+              onChange={(e) => setAddressSpace(e.target.value as AddressSpaceChoice)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
+            >
+              <option value="auto">
+                Auto{inferredSpace ? ` (${inferredSpace})` : ''}
+              </option>
+              <option value="loopback">loopback (localhost, 127.0.0.0/8, ::1)</option>
+              <option value="local">local (private IPs, .local hosts)</option>
+              <option value="public">public (no local network access)</option>
+            </select>
+          </div>
+
+          <div className="flex items-end">
+            <label className="flex items-center text-sm text-gray-700 pb-2">
+              <input
+                type="checkbox"
+                checked={noCors}
+                onChange={(e) => setNoCors(e.target.checked)}
+                className="mr-2 h-4 w-4"
+              />
+              Use <code className="mx-1">no-cors</code> (opaque response)
+            </label>
+          </div>
+        </div>
+
+        <button
+          type="submit"
+          disabled={loading}
+          className={`w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+            loading ? 'opacity-75 cursor-not-allowed' : ''
+          }`}
+        >
+          {loading ? 'Requesting…' : 'Fetch resource'}
+        </button>
+      </form>
+
+      <pre className="mt-4 p-3 text-xs bg-gray-100 rounded overflow-x-auto">
+        {`fetch(${JSON.stringify(url)}, {\n  mode: ${JSON.stringify(noCors ? 'no-cors' : 'cors')},\n  targetAddressSpace: ${JSON.stringify(effectiveSpace ?? 'public')},\n});`}
+      </pre>
+
+      {result && (
+        <div className="mt-6" data-testid="lna-result">
+          <h3 className="text-sm font-bold text-gray-800 mb-2">Response</h3>
+          <dl className="grid grid-cols-3 gap-y-1 text-sm">
+            <dt className="text-gray-500">Status</dt>
+            <dd className="col-span-2">
+              {result.type === 'opaque' ? (
+                <span>opaque (status hidden by no-cors)</span>
+              ) : (
+                <span className={result.ok ? 'text-green-700' : 'text-red-700'}>
+                  {result.status} {result.statusText}
+                </span>
+              )}
+            </dd>
+            <dt className="text-gray-500">Response type</dt>
+            <dd className="col-span-2">{result.type}</dd>
+            <dt className="text-gray-500">Content-Type</dt>
+            <dd className="col-span-2">{result.contentType ?? '—'}</dd>
+            <dt className="text-gray-500">Duration</dt>
+            <dd className="col-span-2">{result.durationMs} ms</dd>
+          </dl>
+          {result.body && (
+            <pre className="mt-3 p-3 text-xs bg-gray-100 rounded overflow-x-auto max-h-64">
+              {result.body}
+              {result.body.length >= MAX_BODY_PREVIEW ? '\n…' : ''}
+            </pre>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
