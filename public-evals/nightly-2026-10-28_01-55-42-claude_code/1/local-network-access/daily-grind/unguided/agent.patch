+            return 'Your browser blocked the request: local network access is turned off for this site. Allow it in site settings, then try again.';
+          }
+          if (!window.isSecureContext) {
+            return 'Your browser blocked the request because this page isn’t loaded over HTTPS. Reload the site over https:// and try again.';
+          }
+          if (permissionState === 'prompt') {
+            return 'The request didn’t go through. If your browser asked for local network access, choose Allow and press Connect again. Otherwise: ' + device.offlineHint;
+          }
+          return 'Couldn’t reach ' + host + '. ' + device.offlineHint +
+            ' The device must also allow cross-origin requests from ' + location.origin + '.';
+        }
+        return 'Unexpected problem: ' + (err && err.message ? err.message : String(err));
+      }
+
+      /* ---------- Device cards ---------- */
+
+      function humanizeKey(key) {
+        return key.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[_-]+/g, ' ')
+          .replace(/^./, function (c) { return c.toUpperCase(); });
+      }
+
+      function renderReadout(container, data) {
+        container.textContent = '';
+        if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+        var shown = 0;
+        Object.keys(data).forEach(function (key) {
+          var value = data[key];
+          var type = typeof value;
+          if (shown >= MAX_READOUT_FIELDS) return;
+          if (type !== 'string' && type !== 'number' && type !== 'boolean') return;
+          var chip = document.createElement('span');
+          var label = document.createElement('b');
+          label.textContent = humanizeKey(key) + ': ';
+          chip.appendChild(label);
+          chip.appendChild(document.createTextNode(String(value)));
+          container.appendChild(chip);
+          shown++;
+        });
+      }
+
+      function setupDevice(root) {
+        var key = root.getAttribute('data-device');
+        var device = DEVICE_CONFIG[key];
+        var els = {
+          pill: root.querySelector('[data-role="pill"]'),
+          address: root.querySelector('[data-role="address"]'),
+          connect: root.querySelector('[data-role="connect"]'),
+          disconnect: root.querySelector('[data-role="disconnect"]'),
+          message: root.querySelector('[data-role="message"]'),
+          readout: root.querySelector('[data-role="readout"]'),
+          meta: root.querySelector('[data-role="meta"]')
+        };
+        var current = { controller: null, timer: null, timedOut: false, seq: 0 };
+
+        els.address.value = loadSavedAddresses()[key] || device.defaultAddress;
+
+        function setState(state, pillText) {
+          root.setAttribute('data-state', state);
+          els.pill.className = 'pill is-' + state;
+          els.pill.textContent = pillText;
+          els.message.className = 'status-msg' + (state === 'error' || state === 'connected' ? ' is-' + state : '');
+          els.connect.disabled = state === 'connecting';
+          els.connect.textContent = state === 'connected' ? 'Refresh' : 'Connect';
+          els.disconnect.hidden = state === 'idle';
+          els.disconnect.textContent = state === 'connecting' ? 'Cancel' : state === 'error' ? 'Reset' : 'Disconnect';
+        }
+
+        function cancelInFlight() {
+          if (current.timer) clearTimeout(current.timer);
+          if (current.controller) current.controller.abort();
+          current.timer = null;
+          current.controller = null;
+          current.seq++;
+        }
+
+        function connect() {
+          var url;
+          els.address.removeAttribute('aria-invalid');
+          try {
+            url = device.validate(parseAddress(els.address.value));
+          } catch (err) {
+            els.address.setAttribute('aria-invalid', 'true');
+            setState('error', 'Invalid address');
+            els.message.textContent = describeFailure(err, device, null);
+            els.readout.textContent = '';
+            log(device.label + ': rejected address “' + els.address.value.trim() + '”.');
+            els.address.focus();
+            return;
+          }
+
+          saveAddress(key, els.address.value.trim());
+          cancelInFlight();
+          var seq = current.seq;
+          var controller = new AbortController();
+          current.controller = controller;
+          current.timedOut = false;
+          current.timer = setTimeout(function () {
+            current.timedOut = true;
+            controller.abort();
+          }, TIMEOUT_MS);
+
+          setState('connecting', 'Connecting…');
+          els.message.textContent = 'Contacting ' + url.host + '… If the browser asks for local network access, choose Allow.';
+          log(device.label + ': connecting to ' + url.host + '.');
+
+          var startedAt = Date.now();
+          var endpoint = new URL(STATUS_PATH, url.origin).href;
+          var usedSpace = null;
+
+          fetchWithAddressSpace(endpoint, device.addressSpaces, controller.signal)
+            .then(function (result) {
+              usedSpace = result.addressSpace;
+              if (!result.response.ok) throw new HttpError(result.response);
+              return readBody(result.response);
+            })
+            .then(function (data) {
+              if (seq !== current.seq) return;
+              clearTimeout(current.timer);
+              current.timer = null;
+              current.controller = null;
+              var elapsed = Date.now() - startedAt;
+              setState('connected', 'Connected');
+              els.message.textContent = 'Connected to ' + device.label + ' at ' + url.host + '.';
+              renderReadout(els.readout, data);
+              els.meta.textContent = 'Last checked ' + new Date().toLocaleTimeString() + ' · ' + elapsed + ' ms' +
+                (usedSpace ? ' · ' + usedSpace + ' address space' : '');
+              log(device.label + ': connected to ' + url.host + ' in ' + elapsed + ' ms.');
+              queryPermission();
+            })
+            .catch(function (err) {
+              if (seq !== current.seq) return;
+              clearTimeout(current.timer);
+              current.timer = null;
+              current.controller = null;
+              if (!current.timedOut && err && err.name === 'AbortError') return; // cancelled by the user
+              if (current.timedOut && err && err.name === 'AbortError') {
+                err = { name: 'TimeoutError', message: 'Timed out' };
+              }
+              queryPermission().then(function () {
+                if (seq !== current.seq) return;
+                var text = describeFailure(err, device, url);
+                setState('error', 'Error');
+                els.message.textContent = text;
+                els.readout.textContent = '';
+                els.meta.textContent = 'Last attempt ' + new Date().toLocaleTimeString();
+                log(device.label + ': ' + text);
+              });
+            });
+        }
+
+        function disconnect() {
+          var wasConnecting = root.getAttribute('data-state') === 'connecting';
+          cancelInFlight();
+          setState('idle', 'Not connected');
+          els.message.textContent = wasConnecting ? 'Connection attempt cancelled.' : 'Disconnected from ' + device.label + '.';
+          els.readout.textContent = '';
+          els.meta.textContent = '';
+          log(device.label + ': ' + (wasConnecting ? 'connection cancelled.' : 'disconnected.'));
+        }
+
+        els.connect.addEventListener('click', connect);
+        els.disconnect.addEventListener('click', disconnect);
+        els.address.addEventListener('keydown', function (event) {
+          if (event.key === 'Enter') {
+            event.preventDefault();
+            connect();
+          }
+        });
+        els.address.addEventListener('input', function () {
+          els.address.removeAttribute('aria-invalid');
+        });
+
+        setState('idle', 'Not connected');
+      }
+
+      /* ---------- Boot ---------- */
+
+      if (!window.isSecureContext) {
+        document.getElementById('secure-context-notice').hidden = false;
+      }
+      if (typeof fetch !== 'function' || typeof AbortController !== 'function' || typeof URL !== 'function') {
+        setPermission('unsupported');
+        permissionHint.textContent = 'This browser is too old to connect to local equipment from a web page.';
+        Array.prototype.forEach.call(document.querySelectorAll('.device [data-role="connect"]'), function (button) {
+          button.disabled = true;
+        });
+        return;
+      }
+
+      Array.prototype.forEach.call(document.querySelectorAll('.device[data-device]'), setupDevice);
+      queryPermission().then(function (state) {
+        log('Local network permission: ' + state + '.');
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
