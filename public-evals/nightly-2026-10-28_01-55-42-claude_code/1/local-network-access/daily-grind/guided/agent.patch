+
+    function renderResult(container, device, result, url) {
+      container.replaceChildren();
+      container.className = 'device-result notice notice-ok';
+
+      const title = document.createElement('strong');
+      title.textContent = `✓ Connected to ${device.label}`;
+      container.append(title);
+
+      const where = document.createElement('div');
+      where.textContent = `${url.host} answered with HTTP ${result.status}.`;
+      container.append(where);
+
+      if (result.kind === 'json' && result.data && typeof result.data === 'object' && !Array.isArray(result.data)) {
+        const dl = document.createElement('dl');
+        for (const [key, value] of Object.entries(result.data).slice(0, 12)) {
+          const dt = document.createElement('dt');
+          dt.textContent = key.replaceAll(/[_-]+/g, ' ');
+          const dd = document.createElement('dd');
+          dd.textContent = typeof value === 'object' ? JSON.stringify(value) : String(value);
+          dl.append(dt, dd);
+        }
+        container.append(dl);
+      } else if (result.data !== '' && result.data != null) {
+        const pre = document.createElement('pre');
+        pre.textContent = typeof result.data === 'string' ? result.data : JSON.stringify(result.data, null, 2);
+        container.append(pre);
+      }
+
+      container.hidden = false;
+    }
+
+    function renderError(container, { title, detail }) {
+      container.replaceChildren();
+      const strong = document.createElement('strong');
+      strong.textContent = `✕ ${title}`;
+      const p = document.createElement('span');
+      p.textContent = detail;
+      container.append(strong, p);
+      container.hidden = false;
+    }
+
+    // ---------------------------------------------------------------------
+    // Wire up each device card
+    // ---------------------------------------------------------------------
+
+    function setupCard(card) {
+      const device = DEVICES[card.dataset.device];
+      const form = card.querySelector('.device-form');
+      const input = form.querySelector('input');
+      const fieldError = form.querySelector('.field-error');
+      const button = form.querySelector('button[type="submit"]');
+      const progress = card.querySelector('.connect-progress');
+      const result = card.querySelector('.device-result');
+      const errorBox = card.querySelector('.device-error');
+
+      const showFieldError = (message) => {
+        input.setCustomValidity(message);
+        fieldError.textContent = message;
+        fieldError.hidden = false;
+      };
+      const clearFieldError = () => {
+        input.setCustomValidity('');
+        fieldError.textContent = '';
+        fieldError.hidden = true;
+      };
+
+      // Validate on blur, clear while typing (never nag mid-edit).
+      input.addEventListener('input', clearFieldError);
+      input.addEventListener('blur', () => {
+        const parsed = parseAddress(input.value, device);
+        if ('error' in parsed) showFieldError(parsed.error);
+      });
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        clearFieldError();
+        errorBox.hidden = true;
+
+        const parsed = parseAddress(input.value, device);
+        if ('error' in parsed) {
+          showFieldError(parsed.error);
+          input.reportValidity();
+          input.focus();
+          return;
+        }
+
+        if (permissionState.get(device.permission) === 'denied') {
+          const failure = describeFailure(new TypeError('blocked'), device);
+          renderError(errorBox, failure);
+          announce(`${failure.title} ${failure.detail}`, { urgent: true });
+          return;
+        }
+
+        // Disable only after a valid submission, to prevent double-connects while in flight.
+        button.disabled = true;
+        progress.hidden = false;
+        result.hidden = true;
+
+        try {
+          const outcome = await connectToDevice(device, parsed.url);
+          renderResult(result, device, outcome, parsed.url);
+          announce(`Connected to ${device.label}. ${parsed.url.host} answered with HTTP ${outcome.status}.`);
+        } catch (error) {
+          const failure = describeFailure(error, device);
+          renderError(errorBox, failure);
+          announce(`${failure.title} ${failure.detail}`, { urgent: true });
+        } finally {
+          progress.hidden = true;
+          button.disabled = false;
+        }
+      });
+
+      watchPermission(device.permission).then(() => {
+        if (permissionState.get(device.permission) === 'unsupported') {
+          document.getElementById('lna-support-note').hidden = false;
+        }
+      });
+    }
+
+    if (!window.isSecureContext) {
+      document.getElementById('secure-context-warning').hidden = false;
+    }
+
+    document.querySelectorAll('.device-card[data-device]').forEach(setupCard);
+  </script>
+
 </body>
 
 </html>
