+  <script type="module">
+    import { analyzeEvents, formatNanoTimestamp, formatDuration } from './js/order-events.js';
+
+    const button = document.getElementById('load-events-btn');
+    const status = document.getElementById('timeline-status');
+    const results = document.getElementById('timeline-results');
+    const tbody = document.getElementById('timeline-body');
+    const NS_PER_MS = 1_000_000n;
+
+    const setStatus = (message, isError = false) => {
+      status.textContent = message;
+      status.classList.toggle('error', isError);
+    };
+
+    const cell = (text, className) => {
+      const td = document.createElement('td');
+      td.textContent = text;
+      if (className) td.className = className;
+      return td;
+    };
+
+    const render = ({ sorted, intervals, stats }) => {
+      document.getElementById('stat-count').textContent = String(stats.count);
+      document.getElementById('stat-span').textContent = formatDuration(stats.spanNs);
+      document.getElementById('stat-min').textContent =
+        stats.minIntervalNs === null ? 'n/a' : formatDuration(stats.minIntervalNs);
+      document.getElementById('stat-max').textContent =
+        stats.maxIntervalNs === null ? 'n/a' : formatDuration(stats.maxIntervalNs);
+      document.getElementById('stat-mean').textContent =
+        stats.meanIntervalNs === null ? 'n/a' : formatDuration(stats.meanIntervalNs);
+      document.getElementById('stat-subms').textContent =
+        `${stats.subMillisecondIntervals} of ${intervals.length}`;
+
+      tbody.replaceChildren();
+      sorted.forEach((event, index) => {
+        const tr = document.createElement('tr');
+        const interval = index === 0 ? null : intervals[index - 1];
+        const subMs = interval !== null && interval.deltaNs < NS_PER_MS;
+        const movedBy = event.receivedIndex - index;
+        const receivedLabel =
+          movedBy === 0 ? `#${event.receivedIndex + 1}` : `#${event.receivedIndex + 1} (${movedBy > 0 ? '+' : ''}${movedBy})`;
+
+        tr.append(
+          cell(String(index + 1)),
+          cell(receivedLabel, movedBy === 0 ? '' : 'moved'),
+          cell(event.type),
+          cell(event.orderId),
+          cell(event.service),
+          cell(formatNanoTimestamp(event.ns), 'mono'),
+          cell(interval === null ? '—' : formatDuration(interval.deltaNs), `num mono${subMs ? ' sub-ms' : ''}`),
+          cell(interval === null ? '—' : interval.deltaNs.toLocaleString('en-US'), `num mono${subMs ? ' sub-ms' : ''}`),
+        );
+        tbody.append(tr);
+      });
+      results.classList.remove('hidden');
+    };
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      setStatus('Loading events…');
+      try {
+        const response = await fetch('./data/order-events.json', { cache: 'no-store' });
+        if (!response.ok) throw new Error(`HTTP ${response.status} while fetching events`);
+        const payload = await response.json();
+        const received = payload.events.map((event, receivedIndex) => ({ ...event, receivedIndex }));
+        const analysis = analyzeEvents(received);
+        render(analysis);
+        const reordered = analysis.sorted.filter((e, i) => e.receivedIndex !== i).length;
+        setStatus(`Sorted ${analysis.stats.count} events; ${reordered} arrived out of order.`);
+      } catch (error) {
+        console.error(error);
+        setStatus(`Could not load events: ${error.message}`, true);
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
