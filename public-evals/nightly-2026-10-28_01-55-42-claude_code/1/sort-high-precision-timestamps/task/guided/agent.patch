+  <script type="module">
+    import { buildTimeline, formatInstant, formatDuration } from './js/order-timeline.js';
+
+    const button = document.getElementById('load-events-btn');
+    const status = document.getElementById('telemetry-status');
+    const results = document.getElementById('telemetry-results');
+    const statRow = document.getElementById('stat-row');
+    const tbody = document.getElementById('event-table-body');
+
+    // Temporal is native in Chrome/Edge 144+ and Firefox 139+; load the
+    // polyfill on demand elsewhere (Safari) and assign it to the global.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return;
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    function el(tag, props = {}, children = []) {
+      const node = document.createElement(tag);
+      for (const [k, v] of Object.entries(props)) {
+        if (k === 'class') node.className = v;
+        else if (k === 'text') node.textContent = v;
+        else if (k.startsWith('data-')) node.setAttribute(k, v);
+        else node[k] = v;
+      }
+      for (const c of children) node.append(c);
+      return node;
+    }
+
+    /** Timestamp with the nanosecond digits highlighted: ...07.004812|334Z */
+    function timestampCell(instant) {
+      const iso = formatInstant(instant); // always 9 fractional digits + Z
+      const head = iso.slice(0, -4);
+      const nanos = iso.slice(-4, -1);
+      return el('time', { dateTime: iso, class: 'num' }, [
+        head,
+        el('span', { class: 'ns', text: nanos }),
+        'Z',
+      ]);
+    }
+
+    function statTile(label, value, note) {
+      const kids = [
+        el('span', { class: 'stat-label', text: label }),
+        el('span', { class: 'stat-value', text: value }),
+      ];
+      if (note) kids.push(el('span', { class: 'stat-note', text: note }));
+      return el('div', { class: 'stat-tile' }, kids);
+    }
+
+    function render({ timeline, summary }, batch) {
+      statRow.replaceChildren(
+        statTile('Events in batch', String(summary.count), batch.batchId),
+        statTile('Batch span', formatDuration(summary.span), 'first event to last'),
+        statTile('Shortest gap', formatDuration(summary.shortestGap), 'between distinct instants'),
+        statTile('Longest gap', formatDuration(summary.longestGap)),
+        statTile(
+          'Share a millisecond',
+          `${summary.msCollisions} of ${summary.count}`,
+          'would tie under a millisecond clock'
+        ),
+        statTile('Identical instants', String(summary.simultaneousPairs), 'consecutive pairs with equal timestamps'),
+      );
+
+      const labels = ['Seq', 'Batch pos.', 'Timestamp (UTC)', 'Service / host', 'Order', 'Since previous'];
+      const positionOf = new Map(batch.events.map((e, i) => [e.id, i + 1]));
+
+      tbody.replaceChildren(...timeline.map((e, i) => {
+        const gapText = e.gap === null
+          ? 'first event'
+          : e.simultaneous ? 'simultaneous (0 ns)' : `+${formatDuration(e.gap)}`;
+        const gapCell = el('td', { class: 'gap' });
+        gapCell.style.setProperty('--label', JSON.stringify(labels[5]));
+        if (e.gap === null || e.simultaneous) {
+          gapCell.append(el('span', { class: 'muted', text: gapText }));
+        } else {
+          gapCell.append(el('time', { dateTime: e.gap.toString(), class: 'num', text: gapText }));
+        }
+
+        const cells = [
+          el('td', { class: 'num', text: String(i + 1) }),
+          el('td', { class: 'num', text: `#${positionOf.get(e.id)}` }),
+          el('td', {}, [timestampCell(e.instant)]),
+          el('td', {}, [e.service, el('br'), el('span', { class: 'muted', text: e.host })]),
+          el('td', {}, [el('span', { class: 'order-tag', text: e.order })]),
+          gapCell,
+        ];
+        cells.forEach((td, idx) => td.style.setProperty('--label', JSON.stringify(labels[idx])));
+
+        return el('tr', { 'data-simultaneous': String(e.simultaneous) }, [
+          el('th', { scope: 'row', text: e.event }),
+          ...cells,
+        ]);
+      }));
+
+      results.hidden = false;
+    }
+
+    async function loadBatch() {
+      button.disabled = true;
+      button.setAttribute('aria-busy', 'true');
+      status.dataset.state = 'loading';
+      status.textContent = 'Loading event batch…';
+      try {
+        const [response] = await Promise.all([
+          fetch('./data/order-events.json', { headers: { Accept: 'application/json' } }),
+          ensureTemporal(),
+        ]);
+        if (!response.ok) throw new Error(`HTTP ${response.status} fetching event batch`);
+        const batch = await response.json();
+        const result = buildTimeline(batch.events);
+        render(result, batch);
+        status.dataset.state = 'done';
+        status.textContent =
+          `Sequenced ${result.summary.count} events from ${new Set(batch.events.map((e) => e.service)).size} services ` +
+          `spanning ${formatDuration(result.summary.span)}.`;
+        button.textContent = 'Reload Order Event Batch';
+      } catch (err) {
+        console.error(err);
+        status.dataset.state = 'error';
+        status.textContent = `Could not load the event batch: ${err.message}`;
+      } finally {
+        button.disabled = false;
+        button.removeAttribute('aria-busy');
+      }
+    }
+
+    button.addEventListener('click', loadBatch);
+  </script>
+
