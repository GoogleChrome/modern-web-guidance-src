+    <section class="telemetry" aria-labelledby="telemetry-heading">
+      <h2 id="telemetry-heading">Order Pipeline Telemetry</h2>
+      <p class="lede">
+        Load a batch of order events collected from our backend services. Each service stamps
+        events with nanosecond UTC clocks, and the batch arrives out of order. We sequence it
+        without dropping a single nanosecond and measure the gap between consecutive events.
+      </p>
+      <div class="telemetry-controls">
+        <button type="button" class="btn" id="load-events-btn">Load Order Event Batch</button>
+      </div>
+      <p class="telemetry-status" id="telemetry-status" role="status" aria-live="polite"></p>
+      <div id="telemetry-results" hidden>
+        <div class="stat-row" id="stat-row"></div>
