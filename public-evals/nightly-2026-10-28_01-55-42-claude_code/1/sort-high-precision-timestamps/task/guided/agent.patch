+              <tr>
+                <th scope="col">Event</th>
+                <th scope="col">Seq</th>
+                <th scope="col">Batch pos.</th>
+                <th scope="col">Timestamp (UTC)</th>
+                <th scope="col">Service / host</th>
+                <th scope="col">Order</th>
+                <th scope="col">Since previous</th>
+              </tr>
