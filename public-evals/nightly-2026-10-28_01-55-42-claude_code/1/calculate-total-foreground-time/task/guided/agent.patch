+  <script>
+    /**
+     * Foreground time tracking.
+     *
+     * Preferred source: 'visibility-state' performance entries
+     * (VisibilityStateEntry, Chrome/Edge 115+). These record the full
+     * visibility history on the performance timeline, so the result is
+     * accurate even if this script runs after the user has already
+     * switched tabs.
+     *
+     * Fallback (Firefox/Safari): accumulate visible time from
+     * `visibilitychange` events starting from when this script runs.
+     */
+    const foregroundTracker = (() => {
+      let accumulated = 0;
+      let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      document.addEventListener('visibilitychange', () => {
+        const now = performance.now();
+        if (document.visibilityState === 'visible') {
+          if (visibleSince === null) visibleSince = now;
+        } else if (visibleSince !== null) {
+          accumulated += now - visibleSince;
+          visibleSince = null;
+        }
+      });
+
+      return {
+        /** Foreground time (ms) accumulated via visibilitychange events. */
+        get total() {
+          return accumulated + (visibleSince !== null ? performance.now() - visibleSince : 0);
+        },
+      };
+    })();
+
+    /**
+     * Calculates the total time the page has been in the foreground
+     * (document.visibilityState === 'visible') since navigation start.
+     *
+     * @returns {number} Total foreground time in milliseconds.
+     */
+    function getTotalForegroundTime() {
+      const entries = performance.getEntriesByType('visibility-state');
+
+      // Empty array means VisibilityStateEntry is unsupported; use the
+      // event-based tracker instead.
+      if (entries.length === 0) {
+        return foregroundTracker.total;
+      }
+
+      let totalForegroundTime = 0;
+      for (let i = 0; i < entries.length; i++) {
+        if (entries[i].name !== 'visible') continue;
+        const start = entries[i].startTime;
+        // Ends at the next state change, or now if this is the latest state.
+        const end = i + 1 < entries.length ? entries[i + 1].startTime : performance.now();
+        totalForegroundTime += end - start;
+      }
+      return totalForegroundTime;
+    }
+
+    // Report foreground time when the user leaves the page. `pagehide`
+    // fires reliably on mobile and when the page enters the bfcache,
+    // unlike `unload`/`beforeunload`.
+    window.addEventListener('pagehide', () => {
+      const foregroundMs = Math.round(getTotalForegroundTime());
+      // Replace with navigator.sendBeacon('/analytics', ...) when an
+      // endpoint exists.
+      console.log('[analytics] foreground time (ms):', foregroundMs);
+    });
+  </script>
+
