+  <script>
+    (function () {
+      /* ---------- Wholesale & catering tabs ---------- */
+      var tabs = Array.prototype.slice.call(document.querySelectorAll('.tablist [role="tab"]'));
+      var panels = Array.prototype.slice.call(document.querySelectorAll('.wholesale-tab'));
+
+      function activateTab(tab, focusTab) {
+        tabs.forEach(function (t) {
+          var selected = t === tab;
+          t.setAttribute('aria-selected', selected ? 'true' : 'false');
+          t.tabIndex = selected ? 0 : -1;
+        });
+        panels.forEach(function (p) {
+          if (p.id === tab.getAttribute('aria-controls')) {
+            p.removeAttribute('hidden');
+          } else {
+            // until-found, not plain hidden: keeps the panel text searchable.
+            p.setAttribute('hidden', 'until-found');
+          }
+        });
+        if (focusTab) tab.focus();
+      }
+
+      tabs.forEach(function (tab, index) {
+        tab.addEventListener('click', function () {
+          activateTab(tab, false);
+        });
+        tab.addEventListener('keydown', function (event) {
+          var next;
+          if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
+          else if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
+          else if (event.key === 'Home') next = tabs[0];
+          else if (event.key === 'End') next = tabs[tabs.length - 1];
+          if (next) {
+            event.preventDefault();
+            activateTab(next, true);
+          }
+        });
+      });
+
+      panels.forEach(function (panel) {
+        // Fired by find-in-page (or a fragment navigation) when the match is
+        // inside this panel. The browser then removes the hidden attribute;
+        // we also hide the sibling panel so the tabs stay mutually exclusive.
+        panel.addEventListener('beforematch', function () {
+          var tab = document.getElementById(panel.getAttribute('aria-labelledby'));
+          if (tab) activateTab(tab, false);
+        });
+      });
+
+      /* ---------- Reveal coupon ---------- */
+      var couponButton = document.getElementById('reveal-coupon');
+      var couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        // One-way: the attribute is only ever removed, never added back.
+        couponPanel.removeAttribute('hidden');
+        couponButton.setAttribute('aria-expanded', 'true');
+        couponButton.textContent = 'Coupon Revealed';
+        couponButton.disabled = true;
+      }
+
+      couponButton.addEventListener('click', function () {
+        revealCoupon();
+        couponPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      });
+
+      // Keep the button state in sync if find-in-page reveals the panel first.
+      couponPanel.addEventListener('beforematch', revealCoupon);
+    })();
+  </script>
+
