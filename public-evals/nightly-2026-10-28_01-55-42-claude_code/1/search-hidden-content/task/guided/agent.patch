+  <script>
+    (function () {
+      var panel = document.getElementById('coupon-panel');
+      var button = document.getElementById('reveal-coupon-btn');
+
+      function revealCoupon() {
+        panel.removeAttribute('hidden');
+        button.setAttribute('aria-expanded', 'true');
+        button.textContent = 'Coupon Revealed';
+        button.disabled = true;
+      }
+
+      // Clicking the sidebar button reveals the panel. There is intentionally
+      // no way to hide it again.
+      button.addEventListener('click', function () {
+        revealCoupon();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      });
+
+      // If find-in-page matches text inside the panel, the browser removes the
+      // hidden attribute itself; keep the button state in sync.
+      panel.addEventListener('beforematch', revealCoupon);
+
+      // Fallback for browsers without hidden="until-found" (e.g. Safari): show
+      // the content so it remains searchable and accessible.
+      if (!('onbeforematch' in HTMLElement.prototype)) {
+        revealCoupon();
+      }
+    })();
+  </script>
