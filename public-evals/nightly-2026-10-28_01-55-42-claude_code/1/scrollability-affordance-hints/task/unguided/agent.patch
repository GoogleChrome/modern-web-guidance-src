+  <script>
+    (function () {
+      var scroller = document.getElementById('reviews-scroll');
+      if (!scroller) return;
+
+      var wrapper = scroller.parentElement;
+      var topIndicator = wrapper.querySelector('.indicator-top');
+      var bottomIndicator = wrapper.querySelector('.indicator-bottom');
+
+      function updateIndicators() {
+        var scrollTop = scroller.scrollTop;
+        var maxScroll = scroller.scrollHeight - scroller.clientHeight;
+
+        // Top indicator: only once the user has scrolled down from the top.
+        topIndicator.classList.toggle('visible', scrollTop > 1);
+
+        // Bottom indicator: only while there is more content below.
+        bottomIndicator.classList.toggle('visible', maxScroll - scrollTop > 1);
+      }
+
+      scroller.addEventListener('scroll', updateIndicators, { passive: true });
+      window.addEventListener('resize', updateIndicators);
+
+      // Re-evaluate if the content size changes (e.g. fonts load, reviews added).
+      if (typeof ResizeObserver !== 'undefined') {
+        var observer = new ResizeObserver(updateIndicators);
+        observer.observe(scroller);
+        Array.prototype.forEach.call(scroller.children, function (child) {
+          observer.observe(child);
+        });
+      }
+
+      updateIndicators();
+    })();
+  </script>
