+    /* Scroll indicators: sticky overlays inside the scroller.
+       Negative margins keep them out of the layout flow so they
+       sit on top of the content instead of pushing it. */
+    .indicator-top,
+    .indicator-bottom {
+      position: sticky;
+      left: 0;
+      right: 0;
+      z-index: 1;
+      height: 32px;
+      opacity: 0;
+      transition: opacity 0.2s;
+      pointer-events: none; /* never block clicks on content underneath */
+    }
+
+    .indicator-top {
+      top: 0;
+      margin-bottom: -32px;
+      background: linear-gradient(to bottom, white, rgba(255, 255, 255, 0));
+    }
+
+    .indicator-bottom {
+      bottom: 0;
+      margin-top: -32px;
+      background: linear-gradient(to top, white, rgba(255, 255, 255, 0));
+    }
+
+    /* Modern path: container scroll-state queries (Chrome/Edge 133+) */
+    @container scroll-state(scrollable: top) {
+      .indicator-top {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: bottom) {
+      .indicator-bottom {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback path: classes toggled by IntersectionObserver */
+    .reviews-scroller.scrolled-down .indicator-top,
+    .reviews-scroller.can-scroll-down .indicator-bottom {
+      opacity: 1;
+    }
+
+    .sentinel-top,
+    .sentinel-bottom {
+      height: 1px;
+      width: 1px;
+      visibility: hidden;
+    }
+
+    .sentinel-top {
+      margin-bottom: -1px;
+    }
+
+    .sentinel-bottom {
+      margin-top: -1px;
+    }
