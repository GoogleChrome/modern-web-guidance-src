     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Spotlight reveal (seasonal product cards) */
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: false;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: false;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      /* Only the size variables animate; --mouse-x / --mouse-y update instantly. */
+      transition-property: --inner-size, --outer-size;
+      transition-duration: 0.4s;
+      transition-timing-function: ease-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 70px;
+      --outer-size: 150px;
+    }
+
+    .product-card > * {
+      position: relative;
+      z-index: 1;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 2;
+      pointer-events: none;
+      user-select: none;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      gap: 6px;
+      padding: 20px;
+      color: var(--light);
+      text-align: center;
+      background:
+        linear-gradient(rgba(62, 39, 35, 0.82), rgba(62, 39, 35, 0.82)),
+        var(--spotlight-image, none) center / cover no-repeat,
+        var(--primary);
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    .spotlight-overlay strong {
+      color: var(--accent);
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      font-size: 0.75rem;
+    }
+
+    .spotlight-overlay p {
+      font-size: 0.9rem;
+      line-height: 1.4;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     footer {
