+      max-width: 600px;
+      margin: 10px auto 25px;
+    }
+
+    .shipping-form {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      max-width: 720px;
+      margin: 0 auto;
+    }
+
+    .shipping-form fieldset {
+      border: 0;
+      padding: 0;
+      margin: 0 0 20px;
+      min-width: 0;
+    }
+
+    .shipping-form legend {
+      font-weight: bold;
+      color: var(--primary);
+      margin-bottom: 12px;
+      font-size: 1.05rem;
+    }
+
+    .form-row {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+      gap: 15px;
+    }
+
+    .form-field {
+      display: flex;
+      flex-direction: column;
+      margin-bottom: 15px;
+    }
+
+    .form-field.full {
+      grid-column: 1 / -1;
+    }
+
+    .form-field label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      margin-bottom: 5px;
+    }
+
+    .form-field input,
+    .form-field select {
+      font: inherit;
+      padding: 10px 12px;
+      border: 1px solid #bcaaa4;
+      border-radius: 5px;
+      background: var(--light);
+      color: var(--text);
+    }
+
+    .form-field input:focus,
+    .form-field select:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+      border-color: var(--primary);
+    }
+
+    .form-field .hint {
+      font-size: 0.8rem;
+      color: #6d4c41;
+      margin-top: 4px;
+    }
+
+    .shipping-form .btn {
+      border: 0;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 5px;
+    }
+
