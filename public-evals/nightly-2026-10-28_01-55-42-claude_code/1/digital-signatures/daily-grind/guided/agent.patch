--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,216 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  SUITES,
+  canonicalJson,
+  detectBestSuite,
+  fromBase64Url,
+  generateSigningKeyPair,
+  issueDocument,
+  parseDocument,
+  shortKeyId,
+  supportsPostQuantumSignatures,
+  toBase64Url,
+  verifyDocument,
+} from '../js/signing.js';
+
+const te = new TextEncoder();
+const td = new TextDecoder();
+
+const receipt = {
+  kind: 'receipt',
+  id: '0f1a6a4e-2f6c-4b9d-9f3e-7a1f3f6d2c11',
+  issuedAt: '2026-10-28T09:15:00.000Z',
+  items: [{ sku: 'maple-oat-latte', name: 'Maple Oat Latte', qty: 2, unitCents: 550 }],
+  totalCents: 1100,
+  currency: 'USD',
+};
+const voucher = {
+  kind: 'voucher',
+  id: 'b2c3d4e5-0000-4000-8000-000000000001',
+  code: 'DG-7H2K-9QXD',
+  amountCents: 5000,
+  currency: 'USD',
+  recipient: 'Sam',
+  expiresAt: '2027-10-28',
+};
+
+function swapPart(token, index, mutate) {
+  const parts = token.split('.');
+  parts[index] = mutate(parts[index]);
+  return parts.join('.');
+}
+
+function tamperPayload(token, edit) {
+  return swapPart(token, 2, (part) => {
+    const payload = JSON.parse(td.decode(fromBase64Url(part)));
+    edit(payload);
+    return toBase64Url(te.encode(canonicalJson(payload)));
+  });
+}
+
+describe('encoding helpers', () => {
+  test('base64url round-trips arbitrary bytes', () => {
+    const bytes = crypto.getRandomValues(new Uint8Array(1000));
+    assert.deepEqual(fromBase64Url(toBase64Url(bytes)), bytes);
+    assert.doesNotMatch(toBase64Url(bytes), /[+/=]/);
+  });
+
+  test('fromBase64Url rejects non-alphabet characters', () => {
+    assert.throws(() => fromBase64Url('abc+def'), TypeError);
+  });
+
+  test('canonicalJson sorts keys and drops undefined', () => {
+    assert.equal(canonicalJson({ b: 1, a: [{ z: 1, y: undefined }], c: undefined }), '{"a":[{"z":1}],"b":1}');
+  });
+
+  test('shortKeyId formats the first 64 bits', () => {
+    assert.equal(shortKeyId('0123456789abcdef' + 'f'.repeat(48)), '0123:4567:89ab:cdef');
+  });
+});
+
+describe('suite detection', () => {
+  test('prefers ML-DSA-65 when the runtime supports it', async () => {
+    const best = await detectBestSuite();
+    if (supportsPostQuantumSignatures()) assert.equal(best, 'ML-DSA-65');
+    else assert.ok(['Ed25519', 'ECDSA-P256'].includes(best));
+  });
+});
+
+for (const suite of ['ML-DSA-65', 'Ed25519', 'ECDSA-P256']) {
+  describe(`suite ${suite}`, () => {
+    test('generates a non-extractable key with the expected public key size', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      assert.equal(signer.suite, suite);
+      assert.equal(signer.keyPair.privateKey.extractable, false);
+      assert.equal(signer.publicKeyBytes.byteLength, SUITES[suite].publicKeyLength);
+      assert.match(signer.keyId, /^[0-9a-f]{64}$/);
+    });
+
+    test('issues a receipt that verifies and is trusted', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      const token = await issueDocument('receipt', receipt, signer);
+      assert.ok(token.startsWith('DG1.'));
+
+      const parsed = parseDocument(token);
+      assert.equal(parsed.signatureBytes.byteLength, SUITES[suite].signatureLength);
+
+      const result = await verifyDocument(token, {
+        trustedKeys: [{ keyId: signer.keyId, publicKeyBytes: signer.publicKeyBytes, status: 'active' }],
+      });
+      assert.equal(result.status, 'valid');
+      assert.equal(result.issuerTrust, 'trusted');
+      assert.equal(result.suite, suite);
+      assert.deepEqual(result.payload, receipt);
+    });
+
+    test('verifies even when whitespace was added by copy/paste', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      const token = await issueDocument('voucher', voucher, signer);
+      const wrapped = token.replace(/(.{60})/g, '$1\n') + '\n';
+      const result = await verifyDocument(wrapped);
+      assert.equal(result.status, 'valid');
+    });
+
+    test('detects a tampered amount', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      const token = await issueDocument('voucher', voucher, signer);
+      const forged = tamperPayload(token, (p) => { p.amountCents = 50000; });
+      const result = await verifyDocument(forged);
+      assert.equal(result.status, 'invalid');
+      assert.equal(result.payload, undefined);
+    });
+
+    test('detects a single flipped bit in the signature', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      const token = await issueDocument('receipt', receipt, signer);
+      const forged = swapPart(token, 3, (part) => {
+        const sig = fromBase64Url(part);
+        sig[sig.length - 1] ^= 0x01;
+        return toBase64Url(sig);
+      });
+      assert.equal((await verifyDocument(forged)).status, 'invalid');
+    });
+
+    test('rejects a receipt replayed as a voucher (domain separation)', async () => {
+      const signer = await generateSigningKeyPair(suite);
+      const payload = { ...receipt, amountCents: 1100 };
+      const token = await issueDocument('receipt', payload, signer);
+      const replayed = swapPart(
+        swapPart(token, 1, (part) => {
+          const header = JSON.parse(td.decode(fromBase64Url(part)));
+          header.kind = 'voucher';
+          return toBase64Url(te.encode(canonicalJson(header)));
+        }),
+        2,
+        (part) => {
+          const p = JSON.parse(td.decode(fromBase64Url(part)));
+          p.kind = 'voucher';
+          return toBase64Url(te.encode(canonicalJson(p)));
+        },
+      );
+      const result = await verifyDocument(replayed);
+      assert.equal(result.status, 'invalid');
+    });
+
+    test('flags an unknown issuer and a retired key', async () => {
+      const store = await generateSigningKeyPair(suite);
+      const rogue = await generateSigningKeyPair(suite);
+      const token = await issueDocument('receipt', receipt, rogue);
+
+      const unknown = await verifyDocument(token, {
+        trustedKeys: [{ keyId: store.keyId, publicKeyBytes: store.publicKeyBytes, status: 'active' }],
+      });
+      assert.equal(unknown.status, 'valid');
+      assert.equal(unknown.issuerTrust, 'unknown');
+
+      const retired = await verifyDocument(token, {
+        trustedKeys: [{ keyId: rogue.keyId, publicKeyBytes: rogue.publicKeyBytes, status: 'retired' }],
+      });
+      assert.equal(retired.issuerTrust, 'retired');
+    });
+
+    test('rejects a swapped public key with a forged key id', async () => {
+      const store = await generateSigningKeyPair(suite);
+      const rogue = await generateSigningKeyPair(suite);
+      const token = await issueDocument('receipt', receipt, store);
+      const swapped = swapPart(token, 1, (part) => {
+        const header = JSON.parse(td.decode(fromBase64Url(part)));
+        header.pk = toBase64Url(rogue.publicKeyBytes);
+        header.kid = rogue.keyId;
+        return toBase64Url(te.encode(canonicalJson(header)));
+      });
+      assert.equal((await verifyDocument(swapped)).status, 'invalid');
+    });
+  });
+}
+
+describe('malformed input', () => {
+  test('rejects junk, wrong prefix, bad kind, and mismatched lengths', async () => {
+    const signer = await generateSigningKeyPair('Ed25519');
+    const token = await issueDocument('receipt', receipt, signer);
+
+    for (const bad of ['', 'hello', 'JWT.a.b.c', token.replace(/^DG1/, 'DG2'), token + '.extra']) {
+      assert.equal((await verifyDocument(bad)).status, 'malformed', bad.slice(0, 20));
+    }
+    const badKind = swapPart(token, 1, (part) => {
+      const header = JSON.parse(td.decode(fromBase64Url(part)));
+      header.kind = 'refund';
+      return toBase64Url(te.encode(canonicalJson(header)));
+    });
+    assert.equal((await verifyDocument(badKind)).status, 'malformed');
+
+    const claimsMlDsa = swapPart(token, 1, (part) => {
+      const header = JSON.parse(td.decode(fromBase64Url(part)));
+      header.suite = 'ML-DSA-65';
+      return toBase64Url(te.encode(canonicalJson(header)));
+    });
+    assert.equal((await verifyDocument(claimsMlDsa)).status, 'malformed');
+  });
+
+  test('issueDocument refuses mismatched kinds', async () => {
+    const signer = await generateSigningKeyPair('Ed25519');
+    await assert.rejects(issueDocument('voucher', receipt, signer), TypeError);
+    await assert.rejects(issueDocument('refund', receipt, signer), RangeError);
+  });
+});
