+  if (suite.startsWith('ML-DSA')) return suite;
+  if (suite === 'Ed25519') return 'Ed25519';
+  if (suite === 'ECDSA-P256') return { name: 'ECDSA', namedCurve: 'P-256' };
+  throw new RangeError(`Unknown signature suite: ${suite}`);
+}
+
+function signAlgorithm(suite, contextBytes) {
+  if (suite.startsWith('ML-DSA')) return { name: suite, context: contextBytes };
+  if (suite === 'Ed25519') return 'Ed25519';
+  if (suite === 'ECDSA-P256') return { name: 'ECDSA', hash: 'SHA-256' };
+  throw new RangeError(`Unknown signature suite: ${suite}`);
+}
+
+export function suiteOfKey(key) {
+  const { name, namedCurve } = key.algorithm;
+  if (name.startsWith('ML-DSA') || name === 'Ed25519') return name;
+  if (name === 'ECDSA' && namedCurve === 'P-256') return 'ECDSA-P256';
+  throw new RangeError(`Unsupported key algorithm: ${name}`);
+}
+
+// ---------------------------------------------------------------------------
+// Keys
+// ---------------------------------------------------------------------------
+
+/**
+ * Generate a non-extractable signing key pair.
+ * @returns {Promise<{suite: string, keyPair: CryptoKeyPair, publicKeyBytes: Uint8Array, keyId: string}>}
+ */
+export async function generateSigningKeyPair(suite) {
+  const chosen = suite ?? (await detectBestSuite());
+  const keyPair = await crypto.subtle.generateKey(keyAlgorithm(chosen), false, ['sign', 'verify']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey(SUITES[chosen].publicKeyFormat, keyPair.publicKey),
+  );
+  return { suite: chosen, keyPair, publicKeyBytes, keyId: await fingerprint(publicKeyBytes) };
+}
+
+/** Import raw public key bytes. The suite is inferred from the key length. */
+export async function importPublicKey(publicKeyBytes) {
+  const suite = SUITE_BY_PUBLIC_KEY_LENGTH[publicKeyBytes.byteLength];
+  if (!suite) throw new RangeError(`Unrecognised public key length: ${publicKeyBytes.byteLength}`);
+  return crypto.subtle.importKey(SUITES[suite].publicKeyFormat, publicKeyBytes, keyAlgorithm(suite), true, ['verify']);
+}
+
+// ---------------------------------------------------------------------------
+// Sign / verify raw bytes with domain separation
+// ---------------------------------------------------------------------------
+
+function assertContext(contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+}
+
+/**
+ * Classical suites ignore `context`, so emulate ML-DSA's domain separation by
+ * length-prefixing the context in front of the payload.
+ */
+function frameClassicalInput(payloadBytes, contextBytes) {
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+export async function signBytes(privateKey, payloadBytes, contextBytes = new Uint8Array(0)) {
+  assertContext(contextBytes);
+  const suite = suiteOfKey(privateKey);
+  const input = suite.startsWith('ML-DSA') ? payloadBytes : frameClassicalInput(payloadBytes, contextBytes);
+  const signature = await crypto.subtle.sign(signAlgorithm(suite, contextBytes), privateKey, input);
+  return new Uint8Array(signature);
+}
+
+export async function verifyBytes(publicKeyOrBytes, signatureBytes, payloadBytes, contextBytes = new Uint8Array(0)) {
+  assertContext(contextBytes);
+  const publicKey = publicKeyOrBytes instanceof CryptoKey ? publicKeyOrBytes : await importPublicKey(publicKeyOrBytes);
+  const suite = suiteOfKey(publicKey);
+  const input = suite.startsWith('ML-DSA') ? payloadBytes : frameClassicalInput(payloadBytes, contextBytes);
+  return crypto.subtle.verify(signAlgorithm(suite, contextBytes), publicKey, signatureBytes, input);
+}
+
+// ---------------------------------------------------------------------------
+// Signed documents (receipts and vouchers)
+// ---------------------------------------------------------------------------
+
+/**
+ * Sign a receipt or voucher payload and return a portable token string.
+ * @param {'receipt'|'voucher'} kind
+ * @param {object} payload   Plain JSON-serialisable object. `payload.kind` must equal `kind`.
+ * @param {{suite: string, keyPair: CryptoKeyPair, publicKeyBytes: Uint8Array, keyId: string}} signer
+ */
+export async function issueDocument(kind, payload, signer) {
+  const kindInfo = DOCUMENT_KINDS[kind];
+  if (!kindInfo) throw new RangeError(`Unknown document kind: ${kind}`);
+  if (payload?.kind !== kind) throw new TypeError('payload.kind must match the document kind');
+
+  const payloadBytes = textEncoder.encode(canonicalJson(payload));
+  const contextBytes = textEncoder.encode(kindInfo.context);
+  const signature = await signBytes(signer.keyPair.privateKey, payloadBytes, contextBytes);
+
+  const header = { kind, suite: signer.suite, kid: signer.keyId, pk: toBase64Url(signer.publicKeyBytes) };
+  return [
+    TOKEN_PREFIX,
+    toBase64Url(textEncoder.encode(canonicalJson(header))),
+    toBase64Url(payloadBytes),
+    toBase64Url(signature),
+  ].join('.');
+}
+
+class MalformedTokenError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'MalformedTokenError';
+  }
+}
+
+/** Parse and structurally validate a token without verifying the signature. */
+export function parseDocument(token) {
+  if (typeof token !== 'string') throw new MalformedTokenError('Token must be a string');
+  const parts = token.replace(/\s+/g, '').split('.');
+  if (parts.length !== 4 || parts[0] !== TOKEN_PREFIX) {
+    throw new MalformedTokenError('Not a Daily Grind signed document');
+  }
+
+  let header;
+  try {
+    header = JSON.parse(textDecoder.decode(fromBase64Url(parts[1])));
+  } catch {
+    throw new MalformedTokenError('Header is not valid JSON');
+  }
+  if (!header || typeof header !== 'object') throw new MalformedTokenError('Header must be an object');
+  const { kind, suite, kid, pk } = header;
+  if (!DOCUMENT_KINDS[kind]) throw new MalformedTokenError('Unknown document kind');
+  if (!SUITES[suite]) throw new MalformedTokenError('Unknown signature suite');
+  if (typeof kid !== 'string' || !/^[0-9a-f]{64}$/.test(kid)) throw new MalformedTokenError('Bad key id');
+
+  let publicKeyBytes, payloadBytes, signatureBytes;
+  try {
+    publicKeyBytes = fromBase64Url(pk);
+    payloadBytes = fromBase64Url(parts[2]);
+    signatureBytes = fromBase64Url(parts[3]);
+  } catch {
+    throw new MalformedTokenError('Token contains invalid base64url data');
+  }
+  if (publicKeyBytes.byteLength !== SUITES[suite].publicKeyLength) {
+    throw new MalformedTokenError('Public key length does not match the suite');
+  }
+  if (signatureBytes.byteLength !== SUITES[suite].signatureLength) {
+    throw new MalformedTokenError('Signature length does not match the suite');
+  }
+
+  let payload;
+  try {
+    payload = JSON.parse(textDecoder.decode(payloadBytes));
+  } catch {
+    throw new MalformedTokenError('Payload is not valid JSON');
+  }
+  if (!payload || typeof payload !== 'object' || payload.kind !== kind) {
+    throw new MalformedTokenError('Payload kind does not match the header');
+  }
+
+  return { kind, suite, keyId: kid, publicKeyBytes, payloadBytes, signatureBytes, payload };
+}
+
+/**
+ * Verify a token.
+ *
+ * @param {string} token
+ * @param {{trustedKeys?: Array<{keyId: string, publicKeyBytes: Uint8Array, status?: 'active'|'retired'}>}} [options]
+ * @returns {Promise<{
+ *   status: 'valid'|'invalid'|'malformed'|'unsupported',
+ *   reason: string,
+ *   kind?: string, suite?: string, keyId?: string,
+ *   issuerTrust?: 'trusted'|'retired'|'unknown',
+ *   payload?: object,
+ * }>}
+ *   `payload` is only returned when the signature verified, so callers never
+ *   render data from a document that failed verification.
+ */
+export async function verifyDocument(token, { trustedKeys = [] } = {}) {
+  let parsed;
+  try {
+    parsed = parseDocument(token);
+  } catch (error) {
+    if (error instanceof MalformedTokenError) return { status: 'malformed', reason: error.message };
+    throw error;
+  }
+  const { kind, suite, keyId, publicKeyBytes, payloadBytes, signatureBytes, payload } = parsed;
+  const base = { kind, suite, keyId };
+
+  if ((await fingerprint(publicKeyBytes)) !== keyId) {
+    return { ...base, status: 'invalid', reason: 'Key id does not match the embedded public key' };
+  }
+
+  let publicKey;
+  try {
+    publicKey = await importPublicKey(publicKeyBytes);
+  } catch (error) {
+    if (error?.name === 'NotSupportedError') {
+      return { ...base, status: 'unsupported', reason: `This browser cannot verify ${SUITES[suite].label} signatures` };
+    }
+    return { ...base, status: 'invalid', reason: 'Embedded public key could not be imported' };
+  }
+  if (suiteOfKey(publicKey) !== suite) {
+    return { ...base, status: 'invalid', reason: 'Claimed suite does not match the public key' };
+  }
+
+  const contextBytes = textEncoder.encode(DOCUMENT_KINDS[kind].context);
+  let ok = false;
+  try {
+    ok = await verifyBytes(publicKey, signatureBytes, payloadBytes, contextBytes);
+  } catch {
+    ok = false;
+  }
+  if (!ok) {
+    return { ...base, status: 'invalid', reason: 'Signature does not match the document. It was altered or forged.' };
+  }
+
+  const match = trustedKeys.find((k) => bytesEqual(k.publicKeyBytes, publicKeyBytes));
+  const issuerTrust = !match ? 'unknown' : match.status === 'retired' ? 'retired' : 'trusted';
+  return { ...base, status: 'valid', reason: 'Signature verified', issuerTrust, payload };
+}
