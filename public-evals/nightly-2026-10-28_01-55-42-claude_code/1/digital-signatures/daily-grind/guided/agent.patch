+/**
+ * Homepage UI for signed receipts and gift vouchers.
+ *
+ * - Keeps the store's issuer key pair in IndexedDB. The private key is a
+ *   non-extractable CryptoKey, so page scripts can sign with it but never read it.
+ * - Retired keys stay in the keyring (public half only) so older documents still
+ *   verify, flagged as "retired".
+ * - Never injects untrusted token data with innerHTML; everything rendered from a
+ *   verified payload goes through textContent.
+ */
+import {
+  DOCUMENT_KINDS,
+  ISSUER_NAME,
+  SUITES,
+  canonicalJson,
+  fromBase64Url,
+  generateSigningKeyPair,
+  issueDocument,
+  shortKeyId,
+  supportsPostQuantumSignatures,
+  toBase64Url,
+  verifyDocument,
+} from './signing.js';
+
+const MENU = [
+  { sku: 'maple-oat-latte', name: 'Maple Oat Latte', unitCents: 550 },
+  { sku: 'dark-roast-espresso', name: 'Dark Roast Espresso', unitCents: 325 },
+  { sku: 'cold-brew', name: 'Cold Brew', unitCents: 475 },
+  { sku: 'almond-croissant', name: 'Almond Croissant', unitCents: 395 },
+];
+const TAX_RATE = 0.0825;
+const VOUCHER_VALIDITY_DAYS = 365;
+
+const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+const dateTime = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' });
+const dateOnly = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
+const fmtCents = (cents) => money.format(cents / 100);
+
+// ---------------------------------------------------------------------------
+// Keyring (IndexedDB)
+// ---------------------------------------------------------------------------
+
+const DB_NAME = 'daily-grind-signing';
+const STORE = 'keyring';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => request.result.createObjectStore(STORE, { keyPath: 'keyId' });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+function tx(db, mode, run) {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction(STORE, mode);
+    const request = run(transaction.objectStore(STORE));
+    transaction.oncomplete = () => resolve(request?.result);
+    transaction.onerror = () => reject(transaction.error);
+    transaction.onabort = () => reject(transaction.error);
+  });
+}
+
+async function loadKeyring() {
+  const db = await openDb();
+  try {
+    return (await tx(db, 'readonly', (store) => store.getAll())) ?? [];
+  } finally {
+    db.close();
+  }
+}
+
+async function saveRecord(record) {
+  const db = await openDb();
+  try {
+    await tx(db, 'readwrite', (store) => store.put(record));
+  } finally {
+    db.close();
+  }
+}
+
+async function createActiveRecord() {
+  const signer = await generateSigningKeyPair();
+  const record = { ...signer, status: 'active', createdAt: new Date().toISOString() };
+  await saveRecord(record);
+  return record;
+}
+
+async function ensureKeyring() {
+  const keyring = await loadKeyring();
+  const active = keyring.find((k) => k.status === 'active' && k.keyPair?.privateKey);
+  if (active) return { active, keyring };
+  const created = await createActiveRecord();
+  return { active: created, keyring: [...keyring, created] };
+}
+
+async function rotateKeyring(current) {
+  // Keep only the public half of the retired key.
+  const retired = {
+    keyId: current.keyId,
+    suite: current.suite,
+    publicKeyBytes: current.publicKeyBytes,
+    status: 'retired',
+    createdAt: current.createdAt,
+    retiredAt: new Date().toISOString(),
+  };
+  await saveRecord(retired);
+  const created = await createActiveRecord();
