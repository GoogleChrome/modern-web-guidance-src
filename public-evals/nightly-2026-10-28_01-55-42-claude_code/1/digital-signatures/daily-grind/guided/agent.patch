+  'ML-DSA-65': Object.freeze({
+    label: 'ML-DSA-65',
+    description: 'Quantum-resistant lattice signatures (NIST FIPS 204, Category 3)',
+    postQuantum: true,
+    publicKeyFormat: 'raw-public',
+    publicKeyLength: 1952,
+    signatureLength: 3309,
+  }),
+  'ML-DSA-44': Object.freeze({
+    label: 'ML-DSA-44',
+    description: 'Quantum-resistant lattice signatures (NIST FIPS 204, Category 2)',
+    postQuantum: true,
+    publicKeyFormat: 'raw-public',
+    publicKeyLength: 1312,
+    signatureLength: 2420,
+  }),
+  'ML-DSA-87': Object.freeze({
+    label: 'ML-DSA-87',
+    description: 'Quantum-resistant lattice signatures (NIST FIPS 204, Category 5)',
+    postQuantum: true,
+    publicKeyFormat: 'raw-public',
+    publicKeyLength: 2592,
+    signatureLength: 4627,
+  }),
+  'Ed25519': Object.freeze({
