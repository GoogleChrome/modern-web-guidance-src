diff --git a/js/dg-keystore.js b/js/dg-keystore.js
new file mode 100644
index 0000000..a80e129
--- /dev/null
+++ b/js/dg-keystore.js
@@ -0,0 +1,82 @@
+/**
+ * Persists the issuer key pair in IndexedDB. CryptoKey objects are structured-
+ * cloneable, so the NON-extractable private key is stored as an opaque handle:
+ * it survives reloads but its raw bytes are never exposed to JavaScript.
+ */
+
+const DB_NAME = 'daily-grind-signing';
+const DB_VERSION = 1;
+const STORE = 'issuer';
+const RECORD_ID = 'current';
+const MAX_RETIRED = 10;
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    if (!globalThis.indexedDB) return reject(new Error('IndexedDB unavailable'));
+    const req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = () => {
+      if (!req.result.objectStoreNames.contains(STORE)) req.result.createObjectStore(STORE);
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error ?? new Error('Failed to open IndexedDB'));
+    req.onblocked = () => reject(new Error('IndexedDB open blocked'));
+  });
+}
+
+function requestToPromise(req) {
+  return new Promise((resolve, reject) => {
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error ?? new Error('IndexedDB request failed'));
+  });
+}
+
+async function withStore(mode, fn) {
+  const db = await openDb();
+  try {
+    const tx = db.transaction(STORE, mode);
+    const result = await fn(tx.objectStore(STORE));
+    await new Promise((resolve, reject) => {
+      tx.oncomplete = resolve;
+      tx.onerror = () => reject(tx.error ?? new Error('IndexedDB transaction failed'));
+      tx.onabort = () => reject(tx.error ?? new Error('IndexedDB transaction aborted'));
+    });
+    return result;
+  } finally {
+    db.close();
+  }
+}
+
+/**
+ * @typedef {object} IssuerRecord
+ * @property {string} alg
+ * @property {string} kid
+ * @property {CryptoKey} privateKey
+ * @property {object} publicJwk
+ * @property {string} createdAt
+ * @property {object[]} retiredPublicKeys  previous public JWKs, newest first
+ */
+
+/** @returns {Promise<IssuerRecord|null>} */
+export async function loadIssuer() {
+  const rec = await withStore('readonly', (store) => requestToPromise(store.get(RECORD_ID)));
+  if (!rec || typeof rec !== 'object' || !rec.privateKey || !rec.publicJwk || !rec.kid || !rec.alg) return null;
+  return { retiredPublicKeys: [], ...rec };
+}
+
+/** @param {IssuerRecord} rec */
+export async function saveIssuer(rec) {
+  const toStore = {
+    alg: rec.alg,
+    kid: rec.kid,
+    privateKey: rec.privateKey,
+    publicJwk: rec.publicJwk,
+    createdAt: rec.createdAt,
+    retiredPublicKeys: (rec.retiredPublicKeys ?? []).slice(0, MAX_RETIRED),
+  };
+  await withStore('readwrite', (store) => requestToPromise(store.put(toStore, RECORD_ID)));
+  return toStore;
+}
+
+export async function clearIssuer() {
+  await withStore('readwrite', (store) => requestToPromise(store.delete(RECORD_ID)));
+}
