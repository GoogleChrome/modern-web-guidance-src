+
+    test('key rotation: old tokens fail against the new key alone, pass with both', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      const rotated = await generateIssuerKey([algId]);
+      const onlyNew = [await importPublicJwk(rotated.publicJwk)];
+      assert.equal((await verifyToken(token, onlyNew)).ok, false);
+      assert.equal((await verifyToken(token, [...onlyNew, ...trusted])).ok, true);
