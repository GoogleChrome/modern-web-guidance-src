index 0000000..d879f7c
--- /dev/null
+++ b/js/dg-sign.js
@@ -0,0 +1,463 @@
+/**
+ * The Daily Grind – receipt & voucher signing library.
+ *
+ * Pure crypto/encoding logic built only on the Web Crypto API, so it runs
+ * unchanged in browsers and in Node (for tests). No DOM, no storage here.
+ *
+ * Tokens are JWS Compact Serialization (RFC 7515):
+ *     base64url(header) "." base64url(payload) "." base64url(signature)
+ *
+ * Supported algorithms (JWS "alg" values):
+ *   - "ML-DSA-65"  FIPS 204 module-lattice signatures (quantum-resistant),
+ *                  JWK kty "AKP" per draft-ietf-cose-dilithium.
+ *   - "ES256"      ECDSA over P-256 with SHA-256 (classical fallback).
+ *
+ * The verifier only ever uses the algorithm named by the *trusted key*, never
+ * one chosen by the token, which rules out algorithm-confusion attacks.
+ */
+
+const subtle = globalThis.crypto?.subtle;
+
+export const ISSUER = 'the-daily-grind';
+export const TOKEN_TYPES = Object.freeze({
+  receipt: 'dg-receipt+jws',
+  voucher: 'dg-voucher+jws',
+});
+
+export const ALGORITHMS = Object.freeze({
+  'ML-DSA-65': Object.freeze({
+    jws: 'ML-DSA-65',
+    kty: 'AKP',
+    keyGen: { name: 'ML-DSA-65' },
+    importParams: { name: 'ML-DSA-65' },
+    signParams: { name: 'ML-DSA-65' },
+    label: 'ML-DSA-65 (FIPS 204)',
+    quantumResistant: true,
+  }),
+  ES256: Object.freeze({
+    jws: 'ES256',
+    kty: 'EC',
+    keyGen: { name: 'ECDSA', namedCurve: 'P-256' },
+    importParams: { name: 'ECDSA', namedCurve: 'P-256' },
+    signParams: { name: 'ECDSA', hash: 'SHA-256' },
+    label: 'ECDSA P-256 / SHA-256',
+    quantumResistant: false,
+  }),
+});
+
+/** Most preferred first. */
+export const PREFERRED_ALGORITHMS = Object.freeze(['ML-DSA-65', 'ES256']);
+
+const VOUCHER_CODE_RE = /^DG-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$/;
+const CURRENCY_RE = /^[A-Z]{3}$/;
+
+// ---------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------
+
+const textEncoder = new TextEncoder();
+const textDecoder = new TextDecoder('utf-8', { fatal: true });
+const B64URL_RE = /^[A-Za-z0-9_-]*$/;
+
+export function bytesToBase64Url(bytes) {
+  let binary = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlToBytes(str) {
+  if (typeof str !== 'string' || !B64URL_RE.test(str)) {
+    throw new Error('Invalid base64url input');
+  }
+  if (str.length % 4 === 1) throw new Error('Invalid base64url length');
+  const padded = str.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (str.length % 4)) % 4);
+  const binary = atob(padded);
+  const out = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i);
+  return out;
+}
+
+export function utf8ToBase64Url(text) {
+  return bytesToBase64Url(textEncoder.encode(text));
+}
+
+export function base64UrlToUtf8(str) {
+  return textDecoder.decode(base64UrlToBytes(str));
+}
+
+/** Deterministic JSON: object keys sorted recursively, no whitespace. */
+export function stableStringify(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(stableStringify).join(',') + ']';
+  const keys = Object.keys(value).filter((k) => value[k] !== undefined).sort();
+  return '{' + keys.map((k) => JSON.stringify(k) + ':' + stableStringify(value[k])).join(',') + '}';
+}
+
+// ---------------------------------------------------------------------------
+// Keys
+// ---------------------------------------------------------------------------
+
+/** Required JWK members for thumbprint computation (RFC 7638 §3.2 + AKP draft). */
+const THUMBPRINT_MEMBERS = {
+  EC: ['crv', 'kty', 'x', 'y'],
+  RSA: ['e', 'kty', 'n'],
+  OKP: ['crv', 'kty', 'x'],
+  AKP: ['alg', 'kty', 'pub'],
+};
+
+/** RFC 7638 JWK thumbprint, base64url(SHA-256(canonical required members)). */
+export async function jwkThumbprint(jwk) {
+  const members = THUMBPRINT_MEMBERS[jwk?.kty];
+  if (!members) throw new Error(`Unsupported key type for thumbprint: ${jwk?.kty}`);
+  const subset = {};
+  for (const m of members) {
+    if (typeof jwk[m] !== 'string' || jwk[m] === '') throw new Error(`JWK missing member "${m}"`);
+    subset[m] = jwk[m];
+  }
+  const digest = await subtle.digest('SHA-256', textEncoder.encode(stableStringify(subset)));
+  return bytesToBase64Url(new Uint8Array(digest));
+}
+
+/** Human-friendly fingerprint like "a1b2:c3d4:..." from a kid. */
+export function shortFingerprint(kid, groups = 4) {
+  const hex = Array.from(base64UrlToBytes(kid), (b) => b.toString(16).padStart(2, '0')).join('');
+  return hex.slice(0, groups * 4).match(/.{4}/g).join(':');
+}
+
+/** Which of our algorithms does this JWK belong to? Returns alg id or null. */
+export function algorithmForJwk(jwk) {
+  if (!jwk || typeof jwk !== 'object') return null;
+  if (jwk.kty === 'EC' && jwk.crv === 'P-256' && (!jwk.alg || jwk.alg === 'ES256')) return 'ES256';
+  if (jwk.kty === 'AKP' && jwk.alg === 'ML-DSA-65') return 'ML-DSA-65';
+  return null;
+}
+
+/** Is the given algorithm usable with this runtime's Web Crypto? */
+export async function isAlgorithmSupported(algId) {
+  const spec = ALGORITHMS[algId];
+  if (!spec || !subtle) return false;
+  try {
+    const pair = await subtle.generateKey(spec.keyGen, false, ['sign', 'verify']);
+    const jwk = await subtle.exportKey('jwk', pair.publicKey);
+    return algorithmForJwk(jwk) === algId;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Generate a fresh issuer key pair. The private key is NON-extractable: it can
+ * be used to sign but its bytes can never be read out of the CryptoKey object,
+ * even by script running on the page.
+ *
+ * @param {string[]} [preference] algorithm ids to try in order.
+ * @returns {Promise<{alg:string, kid:string, privateKey:CryptoKey, publicKey:CryptoKey, publicJwk:object, createdAt:string}>}
+ */
+export async function generateIssuerKey(preference = PREFERRED_ALGORITHMS) {
+  if (!subtle) throw new Error('Web Crypto is unavailable (page must be served from a secure context).');
+  let lastError;
+  for (const algId of preference) {
+    const spec = ALGORITHMS[algId];
+    if (!spec) continue;
+    try {
+      const pair = await subtle.generateKey(spec.keyGen, false, ['sign', 'verify']);
+      const exported = await subtle.exportKey('jwk', pair.publicKey);
+      if (algorithmForJwk(exported) !== algId) throw new Error('Unexpected JWK shape from runtime');
+      const publicJwk = publicJwkOnly(exported, algId);
+      const kid = await jwkThumbprint(publicJwk);
+      publicJwk.kid = kid;
+      return {
+        alg: algId,
+        kid,
+        privateKey: pair.privateKey,
+        publicKey: pair.publicKey,
+        publicJwk,
+        createdAt: new Date().toISOString(),
+      };
+    } catch (err) {
+      lastError = err;
+    }
+  }
+  throw new Error(`No supported signature algorithm available: ${lastError?.message ?? 'unknown'}`);
+}
+
+/** Strip runtime-specific members and pin alg/use so the JWK is self-describing. */
+function publicJwkOnly(jwk, algId) {
+  const spec = ALGORITHMS[algId];
+  const out = { kty: spec.kty, alg: spec.jws, use: 'sig' };
+  for (const m of THUMBPRINT_MEMBERS[spec.kty]) if (m !== 'kty' && m !== 'alg') out[m] = jwk[m];
+  return out;
+}
+
+/** Import a public JWK for verification; returns {alg, kid, key, jwk}. */
+export async function importPublicJwk(jwk) {
+  const algId = algorithmForJwk(jwk);
+  if (!algId) throw new Error('Unsupported or malformed public key JWK');
+  if ('d' in jwk || 'priv' in jwk) throw new Error('Refusing to import a private key as a trusted public key');
+  const spec = ALGORITHMS[algId];
+  const clean = publicJwkOnly(jwk, algId);
+  const key = await subtle.importKey('jwk', clean, spec.importParams, true, ['verify']);
+  const kid = await jwkThumbprint(clean);
+  clean.kid = kid;
+  return { alg: algId, kid, key, jwk: clean };
+}
+
+/**
+ * Accepts a JWK, an array of JWKs, or a JWK Set ({keys:[...]}), either as an
+ * object or JSON text. Returns imported trusted keys.
+ */
+export async function parseTrustedKeys(input) {
+  let value = input;
+  if (typeof value === 'string') {
+    if (!value.trim()) return [];
+    value = JSON.parse(value);
+  }
+  let list;
+  if (Array.isArray(value)) list = value;
+  else if (value && Array.isArray(value.keys)) list = value.keys;
+  else if (value && typeof value === 'object') list = [value];
+  else throw new Error('Trusted keys must be a JWK, an array of JWKs, or a JWK Set');
+  return Promise.all(list.map(importPublicJwk));
+}
+
+// ---------------------------------------------------------------------------
+// Documents
+// ---------------------------------------------------------------------------
+
+const VOUCHER_ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // 32 symbols → 5 unbiased bits each
+
+export function generateVoucherCode() {
+  const bytes = crypto.getRandomValues(new Uint8Array(12));
+  const chars = Array.from(bytes, (b) => VOUCHER_ALPHABET[b & 31]);
+  return `DG-${chars.slice(0, 4).join('')}-${chars.slice(4, 8).join('')}-${chars.slice(8, 12).join('')}`;
+}
+
+export function generateOrderId(date = new Date()) {
+  const ymd = date.toISOString().slice(0, 10).replace(/-/g, '');
+  const rand = crypto.getRandomValues(new Uint8Array(3));
+  const suffix = Array.from(rand, (b) => b.toString(16).padStart(2, '0')).join('').toUpperCase();
+  return `DG-${ymd}-${suffix}`;
+}
+
+function isPositiveInt(n) {
+  return Number.isInteger(n) && n > 0;
+}
+function isNonNegativeInt(n) {
+  return Number.isInteger(n) && n >= 0;
+}
+function isIsoDate(s) {
+  return typeof s === 'string' && !Number.isNaN(Date.parse(s));
+}
+
+/**
+ * Build a receipt payload. Money is in integer minor units (cents).
+ * @param {{orderId?:string, store:string, items:{name:string, qty:number, unitPrice:number}[], currency?:string, issuedAt?:string, customer?:string}} input
+ */
+export function buildReceipt(input) {
+  const items = (input.items ?? []).map((it) => ({
+    name: String(it.name ?? '').trim(),
+    qty: Number(it.qty),
+    unitPrice: Number(it.unitPrice),
+  }));
+  const payload = {
+    type: 'receipt',
+    iss: ISSUER,
+    orderId: input.orderId ?? generateOrderId(),
+    store: String(input.store ?? '').trim(),
+    currency: input.currency ?? 'USD',
+    items,
+    total: items.reduce((sum, it) => sum + it.qty * it.unitPrice, 0),
+    issuedAt: input.issuedAt ?? new Date().toISOString(),
+  };
+  if (input.customer) payload.customer = String(input.customer).trim();
+  const problem = validateReceiptPayload(payload);
+  if (problem) throw new Error(problem);
+  return payload;
+}
+
+/**
+ * Build a gift voucher payload.
+ * @param {{code?:string, amount:number, currency?:string, recipient?:string, validDays?:number, issuedAt?:string, expiresAt?:string}} input
+ */
+export function buildVoucher(input) {
+  const issuedAt = input.issuedAt ?? new Date().toISOString();
+  const expiresAt =
+    input.expiresAt ??
+    new Date(Date.parse(issuedAt) + (input.validDays ?? 365) * 86_400_000).toISOString();
+  const payload = {
+    type: 'voucher',
+    iss: ISSUER,
+    code: input.code ?? generateVoucherCode(),
+    amount: Number(input.amount),
+    currency: input.currency ?? 'USD',
+    issuedAt,
+    expiresAt,
+  };
+  if (input.recipient) payload.recipient = String(input.recipient).trim();
+  if (input.message) payload.message = String(input.message).trim();
+  const problem = validateVoucherPayload(payload);
+  if (problem) throw new Error(problem);
+  return payload;
+}
+
+/** Returns an error string or null. */
+export function validateReceiptPayload(p) {
+  if (!p || typeof p !== 'object' || Array.isArray(p)) return 'Receipt payload is not an object';
+  if (p.type !== 'receipt') return 'Payload type is not "receipt"';
+  if (p.iss !== ISSUER) return 'Unexpected issuer';
+  if (typeof p.orderId !== 'string' || !/^[A-Z0-9-]{6,40}$/.test(p.orderId)) return 'Invalid order id';
+  if (typeof p.store !== 'string' || !p.store) return 'Missing store';
+  if (!CURRENCY_RE.test(p.currency ?? '')) return 'Invalid currency';
+  if (!Array.isArray(p.items) || p.items.length === 0) return 'Receipt has no items';
+  let sum = 0;
+  for (const it of p.items) {
+    if (!it || typeof it.name !== 'string' || !it.name) return 'Item missing name';
+    if (!isPositiveInt(it.qty)) return `Invalid quantity for "${it.name}"`;
+    if (!isNonNegativeInt(it.unitPrice)) return `Invalid price for "${it.name}"`;
+    sum += it.qty * it.unitPrice;
+  }
+  if (!isNonNegativeInt(p.total) || p.total !== sum) return 'Receipt total does not match line items';
+  if (!isIsoDate(p.issuedAt)) return 'Invalid issue date';
+  if (p.customer !== undefined && typeof p.customer !== 'string') return 'Invalid customer';
+  return null;
+}
+
+/** Returns an error string or null. */
+export function validateVoucherPayload(p) {
+  if (!p || typeof p !== 'object' || Array.isArray(p)) return 'Voucher payload is not an object';
+  if (p.type !== 'voucher') return 'Payload type is not "voucher"';
+  if (p.iss !== ISSUER) return 'Unexpected issuer';
+  if (!VOUCHER_CODE_RE.test(p.code ?? '')) return 'Invalid voucher code';
+  if (!isPositiveInt(p.amount)) return 'Voucher amount must be a positive whole number of cents';
+  if (!CURRENCY_RE.test(p.currency ?? '')) return 'Invalid currency';
+  if (!isIsoDate(p.issuedAt)) return 'Invalid issue date';
+  if (!isIsoDate(p.expiresAt)) return 'Invalid expiry date';
+  if (Date.parse(p.expiresAt) <= Date.parse(p.issuedAt)) return 'Voucher expires before it is issued';
+  if (p.recipient !== undefined && typeof p.recipient !== 'string') return 'Invalid recipient';
+  if (p.message !== undefined && typeof p.message !== 'string') return 'Invalid message';
+  return null;
+}
+
+// ---------------------------------------------------------------------------
+// Sign / verify
+// ---------------------------------------------------------------------------
+
+/**
+ * Sign a receipt or voucher payload and return a JWS compact token.
+ * @param {{alg:string, kid:string, privateKey:CryptoKey}} issuer
+ * @param {object} payload built by buildReceipt/buildVoucher
+ */
+export async function signDocument(issuer, payload) {
+  const spec = ALGORITHMS[issuer?.alg];
+  if (!spec) throw new Error(`Unknown signing algorithm: ${issuer?.alg}`);
+  const typ = TOKEN_TYPES[payload?.type];
+  if (!typ) throw new Error(`Unknown document type: ${payload?.type}`);
+  const problem = payload.type === 'receipt' ? validateReceiptPayload(payload) : validateVoucherPayload(payload);
+  if (problem) throw new Error(problem);
+
+  const header = { alg: spec.jws, typ, kid: issuer.kid };
+  const signingInput = `${utf8ToBase64Url(stableStringify(header))}.${utf8ToBase64Url(stableStringify(payload))}`;
+  const sig = await subtle.sign(spec.signParams, issuer.privateKey, textEncoder.encode(signingInput));
+  return `${signingInput}.${bytesToBase64Url(new Uint8Array(sig))}`;
+}
+
+/** Split and decode a token without verifying it. Throws on malformed input. */
+export function decodeToken(token) {
+  if (typeof token !== 'string') throw new Error('Token must be a string');
+  const parts = token.trim().split('.');
+  if (parts.length !== 3) throw new Error('Token must have exactly three dot-separated parts');
+  const [h, p, s] = parts;
+  if (!h || !p || !s) throw new Error('Token has an empty segment');
+  let header, payload;
+  try {
+    header = JSON.parse(base64UrlToUtf8(h));
+  } catch {
+    throw new Error('Token header is not valid base64url JSON');
+  }
+  try {
+    payload = JSON.parse(base64UrlToUtf8(p));
+  } catch {
+    throw new Error('Token payload is not valid base64url JSON');
+  }
+  if (!header || typeof header !== 'object' || Array.isArray(header)) throw new Error('Token header is not an object');
+  const signature = base64UrlToBytes(s);
+  return { header, payload, signature, signingInput: `${h}.${p}` };
+}
+
+/**
+ * Verify a token against a set of trusted issuer public keys.
+ *
+ * @param {string} token
+ * @param {Array<{alg:string, kid:string, key:CryptoKey}>} trustedKeys from parseTrustedKeys/importPublicJwk
+ * @param {{now?:Date}} [options]
+ * @returns {Promise<{ok:boolean, status:'valid'|'expired'|'invalid', reason:string, header?:object, payload?:object, alg?:string, kid?:string, signatureValid:boolean}>}
+ */
+export async function verifyToken(token, trustedKeys, options = {}) {
+  const now = options.now ?? new Date();
+  const fail = (reason, extra = {}) => ({ ok: false, status: 'invalid', signatureValid: false, reason, ...extra });
+
+  let decoded;
+  try {
+    decoded = decodeToken(token);
+  } catch (err) {
+    return fail(err.message);
+  }
+  const { header, payload, signature, signingInput } = decoded;
+  const context = { header, payload, alg: header.alg, kid: header.kid };
+
+  if (typeof header.alg !== 'string' || !ALGORITHMS[header.alg]) return fail(`Unsupported algorithm "${header.alg}"`, context);
+  if (header.crit !== undefined) return fail('Unsupported critical header parameters', context);
+  const docType = Object.keys(TOKEN_TYPES).find((k) => TOKEN_TYPES[k] === header.typ);
+  if (!docType) return fail(`Unknown token type "${header.typ}"`, context);
+  if (typeof header.kid !== 'string' || !header.kid) return fail('Token does not name a signing key (kid)', context);
+
+  if (!Array.isArray(trustedKeys) || trustedKeys.length === 0) return fail('No trusted issuer keys provided', context);
+  const trusted = trustedKeys.find((k) => k.kid === header.kid);
+  if (!trusted) return fail('Signed by an unknown key – not issued by The Daily Grind', context);
+  // Use the algorithm bound to the trusted key, never the one the token claims.
+  if (trusted.alg !== header.alg) return fail('Token algorithm does not match the trusted key', context);
+  const spec = ALGORITHMS[trusted.alg];
+
+  let signatureValid = false;
+  try {
+    signatureValid = await subtle.verify(spec.signParams, trusted.key, signature, textEncoder.encode(signingInput));
+  } catch {
+    signatureValid = false;
+  }
+  if (!signatureValid) return fail('Signature does not match – this document has been altered or forged', context);
+
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload) || payload.type !== docType) {
+    return { ...fail('Payload type does not match token type', context), signatureValid: true };
+  }
+  const problem = docType === 'receipt' ? validateReceiptPayload(payload) : validateVoucherPayload(payload);
+  if (problem) return { ...fail(problem, context), signatureValid: true };
+
+  if (docType === 'voucher' && Date.parse(payload.expiresAt) <= now.getTime()) {
+    return {
+      ok: false,
+      status: 'expired',
+      signatureValid: true,
+      reason: `Genuine voucher, but it expired on ${new Date(payload.expiresAt).toUTCString()}`,
+      ...context,
+    };
+  }
+
+  return {
+    ok: true,
+    status: 'valid',
+    signatureValid: true,
+    reason: docType === 'receipt' ? 'Authentic receipt – signature verified' : 'Authentic voucher – signature verified',
+    ...context,
+  };
+}
+
+/** Format integer cents as a currency string (presentation helper). */
+export function formatMoney(cents, currency = 'USD', locale = 'en-US') {
+  try {
+    return new Intl.NumberFormat(locale, { style: 'currency', currency }).format(cents / 100);
+  } catch {
+    return `${(cents / 100).toFixed(2)} ${currency}`;
+  }
+}
diff --git a/js/dg-ui.js b/js/dg-ui.js
new file mode 100644
index 0000000..2c0c31a
--- /dev/null
+++ b/js/dg-ui.js
@@ -0,0 +1,405 @@
+/**
+ * Homepage wiring for signed receipts & gift vouchers.
+ * All untrusted strings (token payloads, pasted keys) are rendered with
+ * textContent – never innerHTML – so a crafted token cannot inject markup.
+ */
+import {
+  ALGORITHMS,
+  generateIssuerKey,
+  parseTrustedKeys,
+  shortFingerprint,
+  buildReceipt,
+  buildVoucher,
+  signDocument,
+  verifyToken,
+  decodeToken,
+  utf8ToBase64Url,
+  formatMoney,
+} from './dg-sign.js';
+import { loadIssuer, saveIssuer } from './dg-keystore.js';
+
+const $ = (sel, root = document) => root.querySelector(sel);
+const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
+
+const state = {
+  issuer: null, // { alg, kid, privateKey, publicJwk, createdAt, retiredPublicKeys }
+  persistent: true,
+};
+
+// ---------------------------------------------------------------------------
+// Small DOM helpers
+// ---------------------------------------------------------------------------
+
+function el(tag, attrs = {}, children = []) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (k === 'class') node.className = v;
+    else if (k === 'text') node.textContent = v;
+    else if (v !== undefined && v !== null && v !== false) node.setAttribute(k, v === true ? '' : v);
+  }
+  for (const child of [].concat(children)) {
+    if (child == null) continue;
+    node.append(typeof child === 'string' ? document.createTextNode(child) : child);
+  }
+  return node;
+}
+
+function setStatus(node, message, kind = 'info') {
+  node.textContent = message;
+  node.dataset.kind = kind;
+}
+
+async function copyText(text, statusNode) {
+  try {
+    await navigator.clipboard.writeText(text);
+    setStatus(statusNode, 'Copied to clipboard.', 'ok');
+  } catch {
+    setStatus(statusNode, 'Clipboard unavailable – select the text and copy it manually.', 'warn');
+  }
+}
+
+function downloadText(filename, text, mime = 'text/plain') {
+  const url = URL.createObjectURL(new Blob([text], { type: mime }));
+  const a = el('a', { href: url, download: filename });
+  document.body.append(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+function formatDate(iso) {
+  const d = new Date(iso);
+  return Number.isNaN(d.getTime()) ? String(iso) : d.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+}
+
+// ---------------------------------------------------------------------------
+// Issuer key
+// ---------------------------------------------------------------------------
+
+function trustedKeySetJson() {
+  const keys = [state.issuer.publicJwk, ...(state.issuer.retiredPublicKeys ?? [])];
+  return JSON.stringify({ keys }, null, 2);
+}
+
+function renderKeyPanel() {
+  const { issuer } = state;
+  const spec = ALGORITHMS[issuer.alg];
+  $('#key-alg').textContent = spec.label;
+  const pq = $('#key-pq');
+  pq.textContent = spec.quantumResistant ? 'Quantum-resistant' : 'Classical';
+  pq.className = 'badge ' + (spec.quantumResistant ? 'badge-pq' : 'badge-classical');
+  $('#key-fp').textContent = shortFingerprint(issuer.kid, 8);
+  $('#key-fp').title = `kid: ${issuer.kid}`;
+  $('#key-created').textContent = formatDate(issuer.createdAt);
+  $('#verify-keys').value = trustedKeySetJson();
+  const note = spec.quantumResistant
+    ? 'This browser supports ML-DSA-65 (FIPS 204), so signatures are secure against both classical and quantum attackers.'
+    : 'This browser does not yet expose ML-DSA in Web Crypto, so signatures use ECDSA P-256. They will upgrade to ML-DSA-65 automatically when the browser does (rotate the key to re-check).';
+  setStatus($('#key-status'), note + (state.persistent ? '' : ' Key storage is unavailable, so this key lives only until the page is closed.'), state.persistent ? 'info' : 'warn');
+}
+
+async function ensureIssuer() {
+  let record = null;
+  try {
+    record = await loadIssuer();
+  } catch {
+    state.persistent = false;
+  }
+  if (!record) {
+    record = { ...(await generateIssuerKey()), retiredPublicKeys: [] };
+    if (state.persistent) {
+      try {
+        await saveIssuer(record);
+      } catch {
+        state.persistent = false;
+      }
+    }
+  }
+  state.issuer = record;
+  renderKeyPanel();
+}
+
+async function rotateKey() {
+  const ok = window.confirm(
+    'Rotate the issuer key?\n\nA new key pair will be generated. Documents signed with the old key will still verify here because its public key is kept in the trusted list, but anyone else verifying must be given the new public key.'
+  );
+  if (!ok) return;
+  const fresh = await generateIssuerKey();
+  const retired = [state.issuer.publicJwk, ...(state.issuer.retiredPublicKeys ?? [])].slice(0, 10);
+  const record = { ...fresh, retiredPublicKeys: retired };
+  if (state.persistent) {
+    try {
+      await saveIssuer(record);
+    } catch {
+      state.persistent = false;
+    }
+  }
+  state.issuer = record;
+  renderKeyPanel();
+  setStatus($('#key-status'), `Issuer key rotated. New fingerprint ${shortFingerprint(record.kid)}.`, 'ok');
+}
+
+// ---------------------------------------------------------------------------
+// Signing forms
+// ---------------------------------------------------------------------------
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitPrice: 575 },
+  { name: 'Dark Roast Espresso', unitPrice: 350 },
+  { name: 'Cold Brew', unitPrice: 450 },
+  { name: 'Blueberry Scone', unitPrice: 325 },
+];
+
+function renderMenuRows() {
+  const tbody = $('#receipt-items');
+  tbody.replaceChildren(
+    ...MENU.map((item, i) =>
+      el('tr', {}, [
+        el('td', { text: item.name }),
+        el('td', { class: 'num', text: formatMoney(item.unitPrice) }),
+        el('td', { class: 'num' }, [
+          el('input', {
+            type: 'number',
+            min: '0',
+            max: '20',
+            step: '1',
+            value: i === 0 ? '1' : '0',
+            name: `qty-${i}`,
+            'aria-label': `Quantity of ${item.name}`,
+            'data-index': String(i),
+          }),
+        ]),
+      ])
+    )
+  );
+}
+
+function receiptItemsFromForm() {
+  return $$('#receipt-items input')
+    .map((input) => ({ ...MENU[Number(input.dataset.index)], qty: Number(input.value) }))
+    .filter((it) => it.qty > 0);
+}
+
+function updateReceiptTotal() {
+  const total = receiptItemsFromForm().reduce((s, it) => s + it.qty * it.unitPrice, 0);
+  $('#receipt-total').textContent = formatMoney(total);
+}
+
+function showOutput(form, token, filename) {
+  const out = $('.output', form);
+  out.hidden = false;
+  $('textarea', out).value = token;
+  out.dataset.filename = filename;
+  setStatus($('.output-status', out), `Signed with ${ALGORITHMS[state.issuer.alg].label}. Token length ${token.length} characters.`, 'ok');
+}
+
+async function onSignReceipt(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const status = $('.form-status', form);
+  try {
+    const payload = buildReceipt({
+      store: form.elements.store.value,
+      customer: form.elements.customer.value,
+      items: receiptItemsFromForm(),
+    });
+    const token = await signDocument(state.issuer, payload);
+    setStatus(status, '', 'info');
+    showOutput(form, token, `receipt-${payload.orderId}.jws`);
+  } catch (err) {
+    setStatus(status, err.message, 'error');
+  }
+}
+
+async function onIssueVoucher(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const status = $('.form-status', form);
+  try {
+    const payload = buildVoucher({
+      amount: Number(form.elements.amount.value),
+      recipient: form.elements.recipient.value,
+      message: form.elements.message.value,
+      validDays: Number(form.elements.validity.value),
+    });
+    const token = await signDocument(state.issuer, payload);
+    setStatus(status, '', 'info');
+    showOutput(form, token, `voucher-${payload.code}.jws`);
+  } catch (err) {
+    setStatus(status, err.message, 'error');
+  }
+}
+
+/** Produce a plausible-looking forgery of a token to demonstrate tamper detection. */
+function tamperedCopy(token) {
+  const { payload } = decodeToken(token);
+  const [h, , s] = token.trim().split('.');
+  if (payload.type === 'voucher') payload.amount = payload.amount * 10;
+  else {
+    payload.total = Math.max(0, payload.total - 100);
+    if (payload.items?.[0]) payload.items[0].unitPrice = Math.max(0, payload.items[0].unitPrice - 100);
+  }
+  return `${h}.${utf8ToBase64Url(JSON.stringify(payload))}.${s}`;
+}
+
+function onOutputAction(event) {
+  const button = event.target.closest('button[data-action]');
+  if (!button) return;
+  const out = button.closest('.output');
+  const token = $('textarea', out).value;
+  const status = $('.output-status', out);
+  switch (button.dataset.action) {
+    case 'copy':
+      copyText(token, status);
+      break;
+    case 'download':
+      downloadText(out.dataset.filename || 'document.jws', token);
+      break;
+    case 'verify':
+      $('#verify-token').value = token;
+      runVerify();
+      break;
+    case 'tamper':
+      $('#verify-token').value = tamperedCopy(token);
+      setStatus(status, 'A forged copy (with the amount changed) was sent to the verifier below.', 'warn');
+      runVerify();
+      break;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Verification
+// ---------------------------------------------------------------------------
+
+function detailRow(label, value) {
+  return el('div', { class: 'detail' }, [el('dt', { text: label }), el('dd', { text: value })]);
+}
+
+function renderPayloadDetails(result) {
+  const { payload, alg, kid } = result;
+  const dl = el('dl', { class: 'details' });
+  if (payload.type === 'receipt') {
+    dl.append(
+      ...[
+        detailRow('Order', payload.orderId),
+        detailRow('Store', payload.store),
+        detailRow('Issued', formatDate(payload.issuedAt)),
+        payload.customer ? detailRow('Customer', payload.customer) : null,
+        detailRow('Total', formatMoney(payload.total, payload.currency)),
+      ].filter(Boolean)
+    );
+    const table = el('table', { class: 'items-table' }, [
+      el('thead', {}, el('tr', {}, [el('th', { text: 'Item' }), el('th', { class: 'num', text: 'Qty' }), el('th', { class: 'num', text: 'Price' })])),
+      el(
+        'tbody',
+        {},
+        payload.items.map((it) =>
+          el('tr', {}, [
+            el('td', { text: it.name }),
+            el('td', { class: 'num', text: String(it.qty) }),
+            el('td', { class: 'num', text: formatMoney(it.qty * it.unitPrice, payload.currency) }),
+          ])
+        )
+      ),
+    ]);
+    return [dl, table, signerRow(alg, kid)];
+  }
+  dl.append(
+    ...[
+      detailRow('Voucher code', payload.code),
+      detailRow('Value', formatMoney(payload.amount, payload.currency)),
+      payload.recipient ? detailRow('Recipient', payload.recipient) : null,
+      payload.message ? detailRow('Message', payload.message) : null,
+      detailRow('Issued', formatDate(payload.issuedAt)),
+      detailRow('Expires', formatDate(payload.expiresAt)),
+    ].filter(Boolean)
+  );
+  return [dl, signerRow(alg, kid)];
+}
+
+function signerRow(alg, kid) {
+  const spec = ALGORITHMS[alg];
+  let fp = kid;
+  try {
+    fp = shortFingerprint(kid, 8);
+  } catch {
+    /* keep raw kid */
+  }
+  return el('p', { class: 'signer muted' }, [`Signed with ${spec?.label ?? alg} · key `, el('code', { text: fp })]);
+}
+
+function renderVerifyResult(result) {
+  const box = $('#verify-result');
+  box.hidden = false;
+  box.dataset.status = result.status;
+  const icon = { valid: '✔', expired: '⏳', invalid: '✖' }[result.status];
+  const title = { valid: 'Authentic', expired: 'Authentic but expired', invalid: 'Not valid' }[result.status];
+  const children = [el('p', { class: 'verdict' }, [el('span', { class: 'icon', 'aria-hidden': 'true', text: icon }), ` ${title}`]), el('p', { class: 'reason', text: result.reason })];
+  if (result.signatureValid && result.payload) children.push(...renderPayloadDetails(result));
+  else if (result.header && typeof result.header === 'object') {
+    children.push(el('p', { class: 'muted', text: 'Untrusted content is not shown because the signature could not be verified.' }));
+  }
+  box.replaceChildren(...children);
+}
+
+async function runVerify() {
+  const token = $('#verify-token').value;
+  const box = $('#verify-result');
+  let trusted;
+  try {
+    trusted = await parseTrustedKeys($('#verify-keys').value);
+  } catch (err) {
+    renderVerifyResult({ ok: false, status: 'invalid', signatureValid: false, reason: `Trusted keys could not be read: ${err.message}` });
+    return;
+  }
+  if (!token.trim()) {
+    renderVerifyResult({ ok: false, status: 'invalid', signatureValid: false, reason: 'Paste a receipt or voucher token first.' });
+    return;
+  }
+  const result = await verifyToken(token, trusted);
+  renderVerifyResult(result);
+  box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+}
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+
+function disableSection(message) {
+  setStatus($('#key-status'), message, 'error');
+  for (const node of $$('#receipts button, #receipts input, #receipts select, #receipts textarea')) node.disabled = true;
+}
+
+async function init() {
+  renderMenuRows();
+  updateReceiptTotal();
+  $('#receipt-items').addEventListener('input', updateReceiptTotal);
+  $('#receipt-form').addEventListener('submit', onSignReceipt);
+  $('#voucher-form').addEventListener('submit', onIssueVoucher);
+  for (const out of $$('#receipts .output')) out.addEventListener('click', onOutputAction);
+  $('#verify-btn').addEventListener('click', runVerify);
+  $('#verify-token').addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) runVerify();
+  });
+  $('#rotate-key').addEventListener('click', () => rotateKey().catch((err) => setStatus($('#key-status'), err.message, 'error')));
+  $('#copy-pubkey').addEventListener('click', () => copyText(JSON.stringify(state.issuer.publicJwk, null, 2), $('#key-status')));
+  $('#download-pubkey').addEventListener('click', () =>
+    downloadText(`daily-grind-issuer-${shortFingerprint(state.issuer.kid, 2).replace(':', '')}.jwk.json`, trustedKeySetJson(), 'application/json')
+  );
+  $('#reset-keys').addEventListener('click', () => {
+    $('#verify-keys').value = trustedKeySetJson();
+    setStatus($('#verify-keys-status'), 'Reset to this browser’s issuer keys.', 'ok');
+  });
+
+  if (!globalThis.crypto?.subtle) {
+    disableSection('Web Crypto is unavailable. Open this page over HTTPS (or localhost) to sign and verify documents.');
+    return;
+  }
+  try {
+    await ensureIssuer();
+  } catch (err) {
+    disableSection(`Could not set up the issuer key: ${err.message}`);
+  }
+}
+
+init();
