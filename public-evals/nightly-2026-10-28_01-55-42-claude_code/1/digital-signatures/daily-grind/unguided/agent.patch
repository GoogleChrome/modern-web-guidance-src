+import { test, describe, before } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  ALGORITHMS,
+  PREFERRED_ALGORITHMS,
+  TOKEN_TYPES,
+  generateIssuerKey,
+  isAlgorithmSupported,
+  importPublicJwk,
+  parseTrustedKeys,
+  jwkThumbprint,
+  shortFingerprint,
+  buildReceipt,
+  buildVoucher,
+  generateVoucherCode,
+  generateOrderId,
+  signDocument,
+  verifyToken,
+  decodeToken,
+  stableStringify,
+  bytesToBase64Url,
+  base64UrlToBytes,
+  utf8ToBase64Url,
+} from '../js/dg-sign.js';
+
+const RECEIPT_INPUT = {
+  store: 'Main St. Roastery',
+  items: [
+    { name: 'Maple Oat Latte', qty: 2, unitPrice: 575 },
+    { name: 'Cold Brew', qty: 1, unitPrice: 450 },
+  ],
+};
+
+function swapPayload(token, mutate) {
+  const [h, p, s] = token.split('.');
+  const payload = JSON.parse(Buffer.from(p, 'base64url').toString());
+  mutate(payload);
+  return `${h}.${utf8ToBase64Url(JSON.stringify(payload))}.${s}`;
+}
+
+function swapHeader(token, mutate) {
+  const [h, p, s] = token.split('.');
+  const header = JSON.parse(Buffer.from(h, 'base64url').toString());
+  mutate(header);
+  return `${utf8ToBase64Url(JSON.stringify(header))}.${p}.${s}`;
+}
+
+describe('encoding helpers', () => {
+  test('base64url round-trips arbitrary bytes', () => {
+    const bytes = crypto.getRandomValues(new Uint8Array(1000));
+    const enc = bytesToBase64Url(bytes);
+    assert.match(enc, /^[A-Za-z0-9_-]+$/);
+    assert.deepEqual(base64UrlToBytes(enc), bytes);
+  });
+
+  test('base64url decoder rejects standard-alphabet and padded input', () => {
+    assert.throws(() => base64UrlToBytes('ab+/'));
+    assert.throws(() => base64UrlToBytes('abcd=='));
+    assert.throws(() => base64UrlToBytes('abcde'));
+  });
+
+  test('stableStringify sorts keys recursively and drops undefined', () => {
+    assert.equal(stableStringify({ b: 1, a: { d: [3, { z: 1, y: 2 }], c: undefined } }), '{"a":{"d":[3,{"y":2,"z":1}]},"b":1}');
+  });
+
+  test('RFC 7638 thumbprint known-answer vector', async () => {
+    const rsa = {
+      kty: 'RSA',
+      n: '0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw',
+      e: 'AQAB',
+      alg: 'RS256',
+      kid: '2011-04-29',
+    };
+    assert.equal(await jwkThumbprint(rsa), 'NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs');
+    assert.equal(shortFingerprint('NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs'), '3736:cbb1:787c:b830');
+  });
+
+  test('thumbprint ignores optional members', async () => {
+    const a = { kty: 'EC', crv: 'P-256', x: 'AQ', y: 'Ag' };
+    const b = { ...a, kid: 'foo', use: 'sig', alg: 'ES256' };
+    assert.equal(await jwkThumbprint(a), await jwkThumbprint(b));
+  });
+});
+
+describe('document builders', () => {
+  test('voucher codes use the unambiguous alphabet and are unique', () => {
+    const codes = new Set(Array.from({ length: 200 }, generateVoucherCode));
+    assert.equal(codes.size, 200);
+    for (const c of codes) assert.match(c, /^DG-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$/);
+  });
+
+  test('order ids embed the date', () => {
+    assert.match(generateOrderId(new Date('2026-10-28T12:00:00Z')), /^DG-20261028-[0-9A-F]{6}$/);
+  });
+
+  test('buildReceipt totals line items in cents', () => {
+    const r = buildReceipt(RECEIPT_INPUT);
+    assert.equal(r.total, 1600);
+    assert.equal(r.type, 'receipt');
+    assert.equal(r.iss, 'the-daily-grind');
+    assert.ok(!Number.isNaN(Date.parse(r.issuedAt)));
+  });
+
+  test('buildReceipt rejects fractional / zero quantities and empty carts', () => {
+    assert.throws(() => buildReceipt({ ...RECEIPT_INPUT, items: [] }), /no items/);
+    assert.throws(() => buildReceipt({ ...RECEIPT_INPUT, items: [{ name: 'X', qty: 1.5, unitPrice: 100 }] }), /quantity/);
+    assert.throws(() => buildReceipt({ ...RECEIPT_INPUT, items: [{ name: 'X', qty: 1, unitPrice: 1.5 }] }), /price/);
+    assert.throws(() => buildReceipt({ ...RECEIPT_INPUT, store: '' }), /store/);
+  });
+
+  test('buildVoucher derives expiry from validDays and validates', () => {
+    const v = buildVoucher({ amount: 2500, validDays: 30, recipient: 'Sam', issuedAt: '2026-01-01T00:00:00.000Z' });
+    assert.equal(v.expiresAt, '2026-01-31T00:00:00.000Z');
+    assert.equal(v.recipient, 'Sam');
+    assert.throws(() => buildVoucher({ amount: 0 }), /amount/);
+    assert.throws(() => buildVoucher({ amount: 12.5 }), /amount/);
+    assert.throws(() => buildVoucher({ amount: 100, currency: 'usd' }), /currency/);
+    assert.throws(() => buildVoucher({ amount: 100, validDays: -1 }), /expires before/);
+  });
+});
+
+for (const algId of PREFERRED_ALGORITHMS) {
+  describe(`sign & verify with ${algId}`, () => {
+    let issuer, trusted, otherIssuer;
+
+    before(async () => {
+      assert.ok(await isAlgorithmSupported(algId), `${algId} should be supported by this Node runtime`);
+      issuer = await generateIssuerKey([algId]);
+      otherIssuer = await generateIssuerKey([algId]);
+      trusted = [await importPublicJwk(issuer.publicJwk)];
+    });
+
+    test('generated private key is non-extractable and public JWK is clean', async () => {
+      assert.equal(issuer.alg, algId);
+      assert.equal(issuer.privateKey.extractable, false);
+      assert.equal(issuer.publicJwk.kty, ALGORITHMS[algId].kty);
+      assert.equal(issuer.publicJwk.alg, algId);
+      assert.equal(issuer.publicJwk.use, 'sig');
+      assert.equal(issuer.publicJwk.kid, issuer.kid);
+      assert.ok(!('d' in issuer.publicJwk) && !('priv' in issuer.publicJwk));
+      assert.equal(trusted[0].kid, issuer.kid);
+    });
+
+    test('receipt round-trip verifies and yields the payload', async () => {
+      const payload = buildReceipt(RECEIPT_INPUT);
+      const token = await signDocument(issuer, payload);
+      assert.equal(token.split('.').length, 3);
+      const { header } = decodeToken(token);
+      assert.deepEqual(header, { alg: algId, typ: TOKEN_TYPES.receipt, kid: issuer.kid });
+
+      const result = await verifyToken(token, trusted);
+      assert.equal(result.ok, true, result.reason);
+      assert.equal(result.status, 'valid');
+      assert.equal(result.signatureValid, true);
+      assert.deepEqual(result.payload, payload);
+      assert.equal(result.alg, algId);
+    });
+
+    test('voucher round-trip verifies; expiry is enforced', async () => {
+      const payload = buildVoucher({ amount: 5000, validDays: 10 });
+      const token = await signDocument(issuer, payload);
+      const fresh = await verifyToken(token, trusted);
+      assert.equal(fresh.ok, true, fresh.reason);
+
+      const later = await verifyToken(token, trusted, { now: new Date(Date.now() + 11 * 86_400_000) });
+      assert.equal(later.ok, false);
+      assert.equal(later.status, 'expired');
+      assert.equal(later.signatureValid, true, 'expired voucher is still authentic');
+    });
+
+    test('signing is deterministic in structure (header/payload) and tokens from same payload verify', async () => {
+      const payload = buildReceipt({ ...RECEIPT_INPUT, orderId: 'DG-20261028-ABCDEF', issuedAt: '2026-10-28T10:00:00.000Z' });
+      const t1 = await signDocument(issuer, payload);
+      const t2 = await signDocument(issuer, payload);
+      assert.equal(t1.split('.').slice(0, 2).join('.'), t2.split('.').slice(0, 2).join('.'));
+      assert.equal((await verifyToken(t2, trusted)).ok, true);
+    });
+
+    test('tampered payload (changing the total) is rejected', async () => {
+      const token = await signDocument(issuer, buildReceipt(RECEIPT_INPUT));
+      const forged = swapPayload(token, (p) => {
+        p.items[0].unitPrice = 1;
+        p.total = 452;
+      });
+      const result = await verifyToken(forged, trusted);
+      assert.equal(result.ok, false);
+      assert.equal(result.signatureValid, false);
+      assert.match(result.reason, /altered or forged/);
+    });
+
+    test('tampered voucher amount is rejected', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      const forged = swapPayload(token, (p) => {
+        p.amount = 100000;
+      });
+      assert.equal((await verifyToken(forged, trusted)).ok, false);
+    });
+
+    test('a single flipped bit in the signature is rejected', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      const [h, p, s] = token.split('.');
+      const sig = base64UrlToBytes(s);
+      sig[sig.length >> 1] ^= 0x01;
+      const result = await verifyToken(`${h}.${p}.${bytesToBase64Url(sig)}`, trusted);
+      assert.equal(result.ok, false);
+      assert.equal(result.signatureValid, false);
+    });
+
+    test('token signed by a different key is rejected as unknown issuer', async () => {
+      const token = await signDocument(otherIssuer, buildVoucher({ amount: 1000 }));
+      const result = await verifyToken(token, trusted);
+      assert.equal(result.ok, false);
+      assert.match(result.reason, /unknown key/);
+    });
+
+    test('a token with a known kid but a signature from another key fails', async () => {
+      const token = await signDocument(otherIssuer, buildVoucher({ amount: 1000 }));
+      const relabelled = swapHeader(token, (h) => {
+        h.kid = issuer.kid;
+      });
+      const result = await verifyToken(relabelled, trusted);
+      assert.equal(result.ok, false);
+      assert.equal(result.signatureValid, false);
+    });
+
+    test('algorithm confusion: header alg swapped is rejected before verification', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      for (const alg of ['none', 'HS256', algId === 'ES256' ? 'ML-DSA-65' : 'ES256']) {
+        const swapped = swapHeader(token, (h) => {
+          h.alg = alg;
+        });
+        const result = await verifyToken(swapped, trusted);
+        assert.equal(result.ok, false, `alg=${alg}`);
+        assert.equal(result.signatureValid, false);
+      }
+    });
+
+    test('voucher token re-labelled as a receipt is rejected', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      const swapped = swapHeader(token, (h) => {
+        h.typ = TOKEN_TYPES.receipt;
+      });
+      const result = await verifyToken(swapped, trusted);
+      assert.equal(result.ok, false);
+    });
+
+    test('crit header parameter is rejected', async () => {
+      const token = await signDocument(issuer, buildVoucher({ amount: 1000 }));
+      const swapped = swapHeader(token, (h) => {
+        h.crit = ['b64'];
+      });
+      assert.equal((await verifyToken(swapped, trusted)).ok, false);
+    });
+
+    test('verifies with a public key pasted from another device (JWK, array, JWK Set as JSON text)', async () => {
+      const token = await signDocument(issuer, buildReceipt(RECEIPT_INPUT));
+      const jwkText = JSON.stringify(issuer.publicJwk);
+      for (const text of [jwkText, `[${jwkText}]`, `{"keys":[${jwkText}]}`]) {
+        const keys = await parseTrustedKeys(text);
+        assert.equal((await verifyToken(token, keys)).ok, true);
+      }
+      // Trailing whitespace / pretty printing around the token is tolerated.
+      assert.equal((await verifyToken(`  ${token}\n`, trusted)).ok, true);
