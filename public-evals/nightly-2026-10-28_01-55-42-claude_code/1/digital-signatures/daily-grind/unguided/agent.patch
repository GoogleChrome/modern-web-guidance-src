+describe('verifier input hardening', () => {
+  let trusted;
+  before(async () => {
+    const issuer = await generateIssuerKey(['ES256']);
+    trusted = [await importPublicJwk(issuer.publicJwk)];
+  });
+
+  test('malformed tokens produce invalid results, not exceptions', async () => {
+    for (const bad of ['', 'abc', 'a.b', 'a.b.c.d', '..', '!!.!!.!!', `${utf8ToBase64Url('{}')}.${utf8ToBase64Url('{}')}.AA`, `${utf8ToBase64Url('[]')}.${utf8ToBase64Url('{}')}.AA`, 42, null]) {
+      const result = await verifyToken(bad, trusted);
+      assert.equal(result.ok, false, JSON.stringify(bad));
+      assert.equal(result.status, 'invalid');
+      assert.equal(typeof result.reason, 'string');
+    }
+  });
+
+  test('empty trusted key list never validates', async () => {
+    const issuer = await generateIssuerKey(['ES256']);
+    const token = await signDocument(issuer, buildVoucher({ amount: 100 }));
+    assert.equal((await verifyToken(token, [])).ok, false);
+    assert.equal((await verifyToken(token, undefined)).ok, false);
+  });
+
+  test('importPublicJwk refuses private keys and unknown key types', async () => {
+    const issuer = await generateIssuerKey(['ES256']);
+    await assert.rejects(importPublicJwk({ ...issuer.publicJwk, d: 'AQ' }), /private key/);
+    await assert.rejects(importPublicJwk({ kty: 'oct', k: 'AQ' }), /Unsupported/);
+    await assert.rejects(importPublicJwk({ kty: 'EC', crv: 'P-384', x: 'AQ', y: 'Ag' }), /Unsupported/);
+    await assert.rejects(importPublicJwk({ kty: 'AKP', alg: 'ML-DSA-44', pub: 'AQ' }), /Unsupported/);
+  });
+
+  test('parseTrustedKeys handles empty input and rejects garbage', async () => {
+    assert.deepEqual(await parseTrustedKeys('   '), []);
+    await assert.rejects(parseTrustedKeys('"a string"'), /must be a JWK/);
+    await assert.rejects(parseTrustedKeys('not json'));
+  });
