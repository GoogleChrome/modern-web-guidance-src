+  <script>
+    (function () {
+      'use strict';
+
+      var form = document.getElementById('rewards-form');
+      if (!form || !form.querySelectorAll) { return; }
+
+      var $ = function (id) { return document.getElementById(id); };
+      var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
+      var progress = document.querySelector('.progress');
+      var progressItems = Array.prototype.slice.call(progress.querySelectorAll('li'));
+      var backBtn = $('back-btn');
+      var nextBtn = $('next-btn');
+      var submitBtn = $('submit-btn');
+      var summary = $('error-summary');
+      var summaryList = $('error-summary-list');
+      var successPanel = $('form-success');
+      var failurePanel = $('form-failure');
+      var current = 0;
+      var submitting = false;
+
+      /* ---------- CSRF token (double-submit cookie) ---------- */
+      (function setCsrfToken() {
+        var field = $('csrf-token');
+        var match = document.cookie.match(/(?:^|;\s*)dg_csrf=([a-f0-9]{64})/);
+        var token = match ? match[1] : '';
+        if (!token && window.crypto && window.crypto.getRandomValues) {
+          var bytes = new Uint8Array(32);
+          window.crypto.getRandomValues(bytes);
+          token = Array.prototype.map.call(bytes, function (b) {
+            return ('0' + b.toString(16)).slice(-2);
+          }).join('');
+          document.cookie = 'dg_csrf=' + token + '; Path=/; SameSite=Strict' +
+            (location.protocol === 'https:' ? '; Secure' : '');
+        }
+        field.value = token;
+      })();
+
+      /* ---------- Progressive enhancement switches ---------- */
+      document.documentElement.classList.add('js');
+      form.setAttribute('novalidate', '');   // JS owns validation messaging from here on
+      progress.hidden = false;
+      backBtn.hidden = false;
+      nextBtn.hidden = false;
+      $('toggle-password').hidden = false;
+
+      /* ---------- Validation messages ---------- */
+      var messages = {
+        firstName: { valueMissing: 'Enter your first name.' },
+        lastName: { valueMissing: 'Enter your last name.' },
+        email: {
+          valueMissing: 'Enter your email address.',
+          typeMismatch: 'Enter an email address in the format name@example.com.'
+        },
+        phone: { patternMismatch: 'Enter a phone number using only digits, spaces, and the characters + ( ) . -' },
+        birthDay: { patternMismatch: 'Enter a day between 1 and 31.' },
+        password: {
+          valueMissing: 'Create a password.',
+          tooShort: 'Your password must be at least {min} characters. You entered {n}.'
+        },
+        homeCafe: { valueMissing: 'Choose your home café.' },
+        acceptTerms: { valueMissing: 'You need to agree to the Rewards Terms to join.' }
+      };
+
+      function messageFor(field) {
+        var v = field.validity;
+        var m = messages[field.name] || {};
+        if (v.customError) { return field.validationMessage; }
+        if (v.valueMissing) { return m.valueMissing || 'This field is required.'; }
+        if (v.typeMismatch) { return m.typeMismatch || 'Enter a valid value.'; }
+        if (v.tooShort) {
+          return (m.tooShort || 'Enter at least {min} characters.')
+            .replace('{min}', field.minLength).replace('{n}', field.value.length);
+        }
+        if (v.tooLong) { return 'Enter no more than ' + field.maxLength + ' characters.'; }
+        if (v.patternMismatch) { return m.patternMismatch || 'Enter a valid value.'; }
+        return field.validationMessage || 'Enter a valid value.';
+      }
+
+      /* ---------- Cross-field rules (set as custom validity so native checks stay in sync) ---------- */
+      var daysInMonth = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+      function applyCustomRules(field) {
+        var month = $('bday-month');
+        var day = $('bday-day');
+        if (field === month || field === day) {
+          month.setCustomValidity('');
+          day.setCustomValidity('');
+          var m = parseInt(month.value, 10);
+          var d = parseInt(day.value, 10);
+          if (month.value && !day.value) {
+            day.setCustomValidity('Enter the day of your birthday, or clear the month.');
+          } else if (day.value && !month.value) {
+            month.setCustomValidity('Select the month of your birthday, or clear the day.');
+          } else if (m && d && !day.validity.patternMismatch && d > daysInMonth[m - 1]) {
+            day.setCustomValidity(month.options[month.selectedIndex].text + ' has only ' + daysInMonth[m - 1] + ' days.');
+          }
+        }
+        if (field.name === 'password') {
+          var email = $('email').value.trim().toLowerCase();
+          var pw = field.value.toLowerCase();
+          field.setCustomValidity(pw && email && pw === email ? 'Your password can\'t be the same as your email address.' : '');
+        }
+      }
+
+      /* ---------- Per-field error display ---------- */
+      function errorElementFor(field) {
+        var ids = (field.getAttribute('aria-describedby') || '').split(/\s+/);
+        for (var i = 0; i < ids.length; i++) {
+          if (/-error$/.test(ids[i])) { return $(ids[i]); }
+        }
+        return null;
+      }
+
+      function setFieldError(field, message) {
+        var el = errorElementFor(field);
+        if (message) {
+          field.setAttribute('aria-invalid', 'true');
+          if (el) { el.textContent = message; }
+        } else {
+          field.removeAttribute('aria-invalid');
+          // Shared error elements (birthday) are only cleared when every field using them is valid.
+          if (el && !form.querySelector('[aria-invalid="true"][aria-describedby~="' + el.id + '"]')) {
+            el.textContent = '';
+          }
+        }
+      }
+
+      function validateField(field) {
+        applyCustomRules(field);
+        var valid = field.checkValidity();
+        setFieldError(field, valid ? '' : messageFor(field));
+        return valid;
+      }
+
+      function fieldsIn(step) {
+        return Array.prototype.slice.call(step.querySelectorAll('input, select, textarea'));
+      }
+
+      function validateStep(index, options) {
+        options = options || {};
+        var invalid = [];
+        fieldsIn(steps[index]).forEach(function (field) {
+          if (!validateField(field)) { invalid.push(field); }
+        });
+        if (invalid.length && !options.silent) { showSummary(invalid); }
+        return invalid.length === 0;
+      }
+
+      /* ---------- Error summary ---------- */
+      function showSummary(fields) {
+        summaryList.textContent = '';
+        fields.forEach(function (field) {
+          var li = document.createElement('li');
+          var a = document.createElement('a');
+          a.href = '#' + field.id;
+          a.textContent = errorElementFor(field) ? errorElementFor(field).textContent : messageFor(field);
+          a.addEventListener('click', function (e) {
+            e.preventDefault();
+            field.focus();
+            if (field.scrollIntoView) { field.scrollIntoView({ block: 'center' }); }
+          });
+          li.appendChild(a);
+          summaryList.appendChild(li);
+        });
+        summary.hidden = false;
+        summary.focus();
+      }
+
+      function hideSummary() {
+        summary.hidden = true;
+        summaryList.textContent = '';
+      }
+
+      /* ---------- Step navigation ---------- */
+      function showStep(index, moveFocus) {
+        current = index;
+        steps.forEach(function (step, i) { step.hidden = i !== index; });
+        progressItems.forEach(function (li, i) {
+          if (i === index) { li.setAttribute('aria-current', 'step'); } else { li.removeAttribute('aria-current'); }
+          li.classList.toggle('is-complete', i < index);
+        });
+        var last = index === steps.length - 1;
+        backBtn.hidden = index === 0;
+        nextBtn.hidden = last;
+        submitBtn.hidden = !last;
+        hideSummary();
+        if (last) { fillReview(); }
+        if (moveFocus) { steps[index].querySelector('legend').focus(); }
+      }
+
+      function fillReview() {
+        $('review-name').textContent = ($('first-name').value + ' ' + $('last-name').value).trim();
+        $('review-email').textContent = $('email').value.trim();
+        $('review').hidden = false;
+      }
+
+      nextBtn.addEventListener('click', function () {
+        if (validateStep(current)) { showStep(current + 1, true); }
+      });
+
+      backBtn.addEventListener('click', function () {
+        showStep(current - 1, true);
+      });
+
+      form.addEventListener('click', function (e) {
+        var target = e.target.closest ? e.target.closest('[data-goto]') : null;
+        if (target) { showStep(parseInt(target.getAttribute('data-goto'), 10), true); }
+      });
+
+      /* ---------- Inline validation timing: check on blur, re-check live once a field is flagged ---------- */
+      form.addEventListener('focusout', function (e) {
+        var field = e.target;
+        if (!field.name || field.type === 'hidden' || field.closest('.hp')) { return; }
+        var hasValue = field.type === 'checkbox' ? field.checked : field.value;
+        if (hasValue || field.getAttribute('aria-invalid') === 'true') { validateField(field); }
+      });
+
+      form.addEventListener('input', function (e) {
+        var field = e.target;
+        if (field.getAttribute('aria-invalid') === 'true') { validateField(field); }
+      });
+
+      form.addEventListener('change', function (e) {
+        var field = e.target;
+        if (field.type === 'checkbox' || field.tagName === 'SELECT') { validateField(field); }
+      });
+
+      /* ---------- Show / hide password ---------- */
+      $('toggle-password').addEventListener('click', function () {
+        var pw = $('password');
+        var show = pw.type === 'password';
+        pw.type = show ? 'text' : 'password';
+        this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
+        this.textContent = show ? 'Hide' : 'Show';
+      });
+
+      /* ---------- Submission ---------- */
+      form.addEventListener('submit', function (e) {
+        // Pressing Enter on an earlier step advances instead of submitting.
+        if (current < steps.length - 1) {
+          e.preventDefault();
+          if (validateStep(current)) { showStep(current + 1, true); }
+          return;
+        }
+
+        // Final guard: every step must be valid, including ones that are hidden right now.
+        for (var i = 0; i < steps.length; i++) {
+          if (!validateStep(i, { silent: true })) {
+            e.preventDefault();
+            if (i !== current) { showStep(i, false); }
+            validateStep(i);
+            return;
+          }
+        }
+
+        if (!window.fetch || !window.URLSearchParams) { return; } // fall back to a normal POST
+        e.preventDefault();
+        if (submitting) { return; }                                // block double submission
+        submitting = true;
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Creating your account…';
+        form.setAttribute('aria-busy', 'true');
+        failurePanel.hidden = true;
+
+        fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: {
+            'Accept': 'application/json',
+            'X-CSRF-Token': $('csrf-token').value,
+            'X-Requested-With': 'XMLHttpRequest'
+          },
+          body: new URLSearchParams(new FormData(form))
+        }).then(function (response) {
+          if (!response.ok) { throw new Error('Request failed with status ' + response.status); }
+          $('form-success-text').textContent = 'We sent a confirmation link to ' + $('email').value.trim() +
+            '. Open it to activate your card and claim your welcome drink.';
+          form.hidden = true;
+          progress.hidden = true;
+          successPanel.hidden = false;
+          successPanel.focus();
+        }).catch(function () {
+          failurePanel.hidden = false;
+          failurePanel.focus();
+        }).then(function () {
+          submitting = false;
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Create my account';
+          form.removeAttribute('aria-busy');
+        });
+      });
+
+      showStep(0, false);
+    })();
+  </script>
 </body>
 
 </html>
