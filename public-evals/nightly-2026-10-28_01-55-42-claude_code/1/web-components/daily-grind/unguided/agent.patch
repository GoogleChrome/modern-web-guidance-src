+import { adoptStyles, assignLinkSlots, baseStyles, define, renderLinkList } from './shared.js';
+
+const styles = `
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: var(--dg-nav-z, 1000);
+  }
+  .nav {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem 1.25rem;
+    padding: 1rem 5%;
+    background: var(--dg-primary, #4e342e);
+    color: var(--dg-on-primary, #fff);
+  }
+  :focus-visible,
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--dg-accent, #ffab40);
+    outline-offset: 2px;
+  }
+  .brand {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: 700;
+    letter-spacing: 1px;
+    text-decoration: none;
+    text-transform: uppercase;
+  }
+  .toggle {
+    display: none;
+    align-items: center;
+    justify-content: center;
+    min-width: 44px;
+    min-height: 44px;
+    padding: 0.5rem;
+    border: 2px solid transparent;
+    border-radius: 4px;
+    background: none;
+    color: inherit;
+    cursor: pointer;
+  }
+  .toggle:hover {
+    border-color: var(--dg-accent, #ffab40);
+  }
+  .icon {
+    width: 24px;
+    height: 24px;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+    stroke-linecap: round;
+  }
+  .icon-close {
+    display: none;
+  }
+  :host([open]) .icon-open {
+    display: none;
+  }
+  :host([open]) .icon-close {
+    display: block;
+  }
+  .menu {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+  }
+  ::slotted(a) {
+    display: inline-block;
+    padding: 0.25rem 0;
+    color: inherit !important;
+    font-size: 0.9rem;
+    text-decoration: none !important;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover),
+  ::slotted(a:focus-visible) {
+    color: var(--dg-accent, #ffab40) !important;
+  }
+  ::slotted(a[aria-current="page"]) {
+    text-decoration: underline !important;
+    text-underline-offset: 0.3em;
+  }
+  ::slotted(a[data-variant="outline"]) {
+    padding: 5px 12px;
+    border: 1px solid var(--dg-accent, #ffab40);
+    border-radius: 4px;
+  }
+  @media (max-width: 47.99em) {
+    .toggle {
+      display: inline-flex;
+    }
+    .menu {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0;
+      margin-top: 0.5rem;
+      padding-top: 0.5rem;
+      border-top: 1px solid rgba(255, 255, 255, 0.2);
+    }
+    :host([open]) .menu {
+      display: flex;
+    }
+    ::slotted(a) {
+      display: block;
+      padding: 0.75rem 0;
+      font-size: 1rem;
+    }
+    ::slotted(a[data-variant="outline"]) {
+      margin-top: 0.5rem;
+      text-align: center;
+    }
+  }
+`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav class="nav" part="nav">
+    <a class="brand" part="brand" href="/"></a>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <span class="visually-hidden">Menu</span>
+      <svg class="icon icon-open" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
+      <svg class="icon icon-close" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
+    </button>
+    <ul class="menu" id="menu" part="menu"></ul>
+  </nav>
+`;
+
+const DESKTOP_QUERY = '(min-width: 48em)';
+
+/**
+ * <dg-site-nav>
+ *
+ * Sticky primary navigation. Authors pass plain <a> children; the component
+ * wraps them in a list and, below 48em, collapses them behind a disclosure
+ * button (aria-expanded / aria-controls, Escape to close, click-outside to
+ * close, focus returned to the toggle).
+ *
+ * Attributes: brand, brand-href (default "/"), label (nav name, default "Primary"),
+ *             open (reflects the disclosure state)
+ * Slots:      direct <a> children — nav links. Use aria-current="page" on the
+ *             current link and data-variant="outline" for an outlined link.
+ * Parts:      nav, brand, toggle, menu
+ * Events:     dg-nav-toggle { detail: { open } }
+ */
+class DgSiteNav extends HTMLElement {
+  static observedAttributes = ['brand', 'brand-href', 'label', 'open'];
+
+  #els;
+  #observer = null;
+  #mediaQuery = null;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    adoptStyles(root, baseStyles, styles);
+    root.append(template.content.cloneNode(true));
+    this.#els = {
+      nav: root.querySelector('.nav'),
+      brand: root.querySelector('.brand'),
+      toggle: root.querySelector('.toggle'),
+      menu: root.querySelector('.menu'),
+    };
+    this.#els.toggle.addEventListener('click', () => {
+      this.open = !this.open;
+    });
+  }
+
+  connectedCallback() {
+    this.#update();
+    this.#renderLinks();
+
+    if (typeof MutationObserver === 'function') {
+      this.#observer = new MutationObserver(() => this.#renderLinks());
+      this.#observer.observe(this, { childList: true });
+    }
+    if (typeof matchMedia === 'function') {
+      this.#mediaQuery = matchMedia(DESKTOP_QUERY);
+      this.#mediaQuery.addEventListener('change', this.#onMediaChange);
+    }
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onLinkClick);
+    document.addEventListener('click', this.#onDocumentClick);
+  }
+
+  disconnectedCallback() {
+    this.#observer?.disconnect();
+    this.#observer = null;
+    this.#mediaQuery?.removeEventListener('change', this.#onMediaChange);
+    this.#mediaQuery = null;
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.removeEventListener('click', this.#onLinkClick);
+    document.removeEventListener('click', this.#onDocumentClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'open') {
+      const open = newValue !== null;
+      this.#els.toggle.setAttribute('aria-expanded', String(open));
+      this.dispatchEvent(new CustomEvent('dg-nav-toggle', { bubbles: true, composed: true, detail: { open } }));
+      return;
+    }
+    this.#update();
+  }
+
+  /** Whether the collapsed menu is currently expanded. */
+  get open() {
+    return this.hasAttribute('open');
+  }
+
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+  }
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.open) {
+      event.preventDefault();
+      this.open = false;
+      this.#els.toggle.focus();
+    }
+  };
+
+  #onLinkClick = (event) => {
+    // Activating a slotted link (e.g. an in-page anchor) should dismiss the menu.
+    if (this.open && event.target instanceof Element && event.target.closest('a')) this.open = false;
+  };
+
+  #onDocumentClick = (event) => {
+    if (this.open && !event.composedPath().includes(this)) this.open = false;
+  };
+
+  #onMediaChange = (event) => {
+    if (event.matches) this.open = false;
+  };
+
+  #update() {
+    const { nav, brand } = this.#els;
+    brand.textContent = this.getAttribute('brand') ?? '';
+    brand.setAttribute('href', this.getAttribute('brand-href') ?? '/');
+    nav.setAttribute('aria-label', this.getAttribute('label') ?? 'Primary');
+  }
+
+  #renderLinks() {
+    const links = assignLinkSlots(this, 'link');
+    renderLinkList(this.#els.menu, links, 'link');
+  }
+}
+
+define('dg-site-nav', DgSiteNav);
+
+export { DgSiteNav };
