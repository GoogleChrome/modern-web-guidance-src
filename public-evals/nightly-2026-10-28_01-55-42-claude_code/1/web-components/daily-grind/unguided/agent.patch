+import { before, describe, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { JSDOM, VirtualConsole } from 'jsdom';
+
+let window;
+let document;
+
+before(async () => {
+  const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+  const virtualConsole = new VirtualConsole();
+  virtualConsole.on('jsdomError', (error) => {
+    // jsdom's CSS parser does not understand some modern CSS; that is not a failure.
+    if (!/Could not parse CSS stylesheet/.test(error.message)) console.error(error);
+  });
+  const dom = new JSDOM(html, { url: 'http://localhost/', pretendToBeVisual: true, virtualConsole });
+  window = dom.window;
+  document = window.document;
+
+  for (const key of ['window', 'document', 'customElements', 'HTMLElement', 'Element', 'Node', 'ShadowRoot',
+    'CSSStyleSheet', 'MutationObserver', 'CustomEvent', 'Event', 'KeyboardEvent', 'MouseEvent']) {
+    globalThis[key] = window[key];
+  }
+  await import('../components/index.js');
+});
+
+describe('registration', () => {
+  test('every element on the homepage is upgraded with a shadow root', () => {
+    for (const name of ['dg-site-nav', 'dg-hero', 'dg-card-grid', 'dg-coffee-card', 'dg-button', 'dg-site-footer']) {
+      assert.ok(window.customElements.get(name), `${name} is defined`);
+      for (const el of document.querySelectorAll(name)) {
+        assert.ok(el.shadowRoot, `${name} has a shadow root`);
+      }
+    }
+  });
+});
+
+describe('dg-site-nav', () => {
+  test('renders the brand, a labelled nav landmark and the slotted links as a list', () => {
+    const nav = document.querySelector('dg-site-nav');
+    const root = nav.shadowRoot;
+    assert.equal(root.querySelector('nav').getAttribute('aria-label'), 'Primary');
+    assert.equal(root.querySelector('.brand').textContent, 'The Daily Grind');
+    const items = root.querySelectorAll('ul > li');
+    assert.equal(items.length, 5);
+    const assigned = [...items].map((li) => li.querySelector('slot').assignedElements()[0]);
+    assert.deepEqual(assigned.map((a) => a.textContent), ['Menu', 'Locations', 'Rewards', 'My Account', 'Logout']);
+  });
+
+  test('toggle button manages aria-expanded, Escape closes and restores focus', () => {
+    const nav = document.querySelector('dg-site-nav');
+    const toggle = nav.shadowRoot.querySelector('.toggle');
+    assert.equal(toggle.getAttribute('aria-expanded'), 'false');
+    assert.equal(toggle.getAttribute('aria-controls'), 'menu');
+    assert.ok(nav.shadowRoot.getElementById('menu'));
+
+    const events = [];
+    nav.addEventListener('dg-nav-toggle', (e) => events.push(e.detail.open));
+
+    toggle.click();
+    assert.equal(nav.open, true);
+    assert.equal(toggle.getAttribute('aria-expanded'), 'true');
+
+    nav.querySelector('a').dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+    assert.equal(nav.open, false);
+    assert.equal(toggle.getAttribute('aria-expanded'), 'false');
+    assert.equal(nav.shadowRoot.activeElement, toggle);
+    assert.deepEqual(events, [true, false]);
+  });
+
+  test('clicking outside closes the menu', () => {
+    const nav = document.querySelector('dg-site-nav');
+    nav.open = true;
+    document.body.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    assert.equal(nav.open, false);
+  });
+
+  test('re-slots links added later', () => {
+    const nav = document.createElement('dg-site-nav');
+    document.body.append(nav);
+    const link = document.createElement('a');
+    link.href = '/new';
+    link.textContent = 'New';
+    nav.append(link);
+    return new Promise((resolve) => setTimeout(resolve, 0)).then(() => {
+      assert.equal(nav.shadowRoot.querySelectorAll('li').length, 1);
+      assert.equal(link.slot, 'link-0');
+      nav.remove();
+    });
+  });
+});
+
+describe('dg-hero', () => {
+  test('is a region labelled by its slotted heading and shows the actions row', () => {
+    const hero = document.querySelector('dg-hero');
+    const heading = hero.querySelector('[slot="heading"]');
+    assert.equal(hero.getAttribute('role'), 'region');
+    assert.ok(heading.id);
+    assert.equal(hero.getAttribute('aria-labelledby'), heading.id);
+    assert.equal(hero.shadowRoot.querySelector('.actions').hidden, false);
+    assert.match(hero.shadowRoot.querySelector('.hero').style.getPropertyValue('--_image'), /^url\("https:\/\/images\.unsplash\.com/);
+  });
+
+  test('rejects unsafe overlay and height values', () => {
+    const hero = document.createElement('dg-hero');
+    hero.setAttribute('overlay', '0.3');
+    hero.setAttribute('height', '50vh');
+    document.body.append(hero);
+    const inner = hero.shadowRoot.querySelector('.hero');
+    assert.equal(inner.style.getPropertyValue('--_overlay'), '0.3');
+    assert.equal(inner.style.getPropertyValue('--_height'), '50vh');
+    hero.setAttribute('overlay', 'red; background: url(x)');
+    hero.setAttribute('height', 'calc(1px)');
+    assert.equal(inner.style.getPropertyValue('--_overlay'), '');
+    assert.equal(inner.style.getPropertyValue('--_height'), '');
+    hero.remove();
+  });
+});
+
+describe('dg-card-grid', () => {
+  test('renders a section labelled by its heading', () => {
+    const grid = document.querySelector('dg-card-grid');
+    const section = grid.shadowRoot.querySelector('section');
+    const heading = grid.shadowRoot.querySelector('#heading');
+    assert.equal(heading.localName, 'h2');
+    assert.equal(heading.textContent, 'Seasonal Favorites');
+    assert.equal(heading.hidden, false);
+    assert.equal(section.getAttribute('aria-labelledby'), 'heading');
+  });
+
+  test('falls back to aria-label without a heading and honours heading-level', () => {
+    const grid = document.createElement('dg-card-grid');
+    grid.setAttribute('label', 'Drinks');
+    grid.setAttribute('heading-level', '4');
+    document.body.append(grid);
+    const section = grid.shadowRoot.querySelector('section');
+    assert.equal(section.getAttribute('aria-label'), 'Drinks');
+    assert.equal(section.hasAttribute('aria-labelledby'), false);
+    grid.setAttribute('heading', 'More');
+    assert.equal(grid.shadowRoot.querySelector('#heading').localName, 'h4');
+    assert.equal(section.getAttribute('aria-labelledby'), 'heading');
+    assert.equal(section.hasAttribute('aria-label'), false);
+    grid.remove();
+  });
+});
+
+describe('dg-coffee-card', () => {
+  test('renders an article with an h3 title, image and a descriptive call to action', () => {
+    const card = document.querySelector('dg-coffee-card');
+    const root = card.shadowRoot;
+    const article = root.querySelector('article');
+    assert.equal(article.getAttribute('aria-labelledby'), 'title');
+
+    const title = root.querySelector('#title');
+    assert.equal(title.localName, 'h3');
+    assert.equal(title.querySelector('slot').assignedElements()[0].textContent, 'Maple Oat Latte');
+
+    const img = root.querySelector('img');
+    assert.match(img.getAttribute('src'), /^https:\/\/images\.unsplash\.com/);
+    assert.match(img.getAttribute('alt'), /latte/i);
+    assert.equal(img.getAttribute('loading'), 'lazy');
+
+    const cta = root.querySelector('.cta');
+    assert.equal(cta.getAttribute('href'), '/menu/seasonal');
+    assert.equal(cta.getAttribute('aria-labelledby'), 'cta-text title');
+    assert.equal(root.querySelector('#cta-text').textContent, 'View Details');
+    assert.equal(root.querySelector('.badge').textContent, 'Seasonal');
+    assert.ok(root.querySelector('.badge').classList.contains('show'));
+    assert.equal(root.querySelector('.price').classList.contains('show'), false);
+  });
+
+  test('reflects attribute changes and heading level', () => {
+    const card = document.createElement('dg-coffee-card');
+    card.setAttribute('name', 'House Blend');
+    card.setAttribute('heading-level', '4');
+    card.setAttribute('price', '$3.00');
+    document.body.append(card);
+    const root = card.shadowRoot;
+    assert.equal(root.querySelector('#title').localName, 'h4');
+    assert.equal(root.querySelector('#title slot').textContent, 'House Blend');
+    assert.equal(root.querySelector('.price-value').textContent, '$3.00');
+    assert.equal(root.querySelector('.cta').classList.contains('show'), false);
+    assert.equal(root.querySelector('.media').classList.contains('has-image'), false);
+
+    card.setAttribute('href', '/menu/house');
+    card.setAttribute('cta-label', 'Order');
+    assert.equal(root.querySelector('.cta').getAttribute('href'), '/menu/house');
+    assert.equal(root.querySelector('#cta-text').textContent, 'Order');
+    card.remove();
+  });
+});
+
+describe('dg-button', () => {
+  test('renders a link when href is set', () => {
+    const button = document.querySelector('dg-button');
+    const control = button.shadowRoot.querySelector('.btn');
+    assert.equal(control.localName, 'a');
+    assert.equal(control.getAttribute('href'), '/order-online');
+    assert.equal(control.getAttribute('part'), 'button');
+  });
+
+  test('renders a native button otherwise and respects disabled/variant', () => {
+    const button = document.createElement('dg-button');
+    button.textContent = 'Add to order';
+    document.body.append(button);
+    let control = button.shadowRoot.querySelector('.btn');
+    assert.equal(control.localName, 'button');
+    assert.equal(control.type, 'button');
+
+    button.setAttribute('variant', 'outline');
+    button.disabled = true;
+    control = button.shadowRoot.querySelector('.btn');
+    assert.ok(control.classList.contains('outline'));
+    assert.equal(control.disabled, true);
+    assert.equal(control.getAttribute('aria-disabled'), 'true');
+
+    button.setAttribute('href', '/x');
+    assert.equal(button.shadowRoot.querySelector('.btn').localName, 'button', 'disabled links stay non-navigable');
+    button.disabled = false;
+    control = button.shadowRoot.querySelector('.btn');
+    assert.equal(control.localName, 'a');
+    assert.equal(control.getAttribute('href'), '/x');
+    button.remove();
+  });
+
+  test('adds rel=noopener for target=_blank links', () => {
+    const button = document.createElement('dg-button');
+    button.setAttribute('href', 'https://example.com');
+    button.setAttribute('target', '_blank');
+    document.body.append(button);
+    assert.equal(button.shadowRoot.querySelector('a').getAttribute('rel'), 'noopener');
+    button.remove();
+  });
+});
+
+describe('dg-site-footer', () => {
+  test('renders the footer nav list and copyright', () => {
+    const footer = document.querySelector('dg-site-footer');
+    const root = footer.shadowRoot;
+    assert.equal(root.querySelector('nav').getAttribute('aria-label'), 'Footer');
+    assert.equal(root.querySelector('nav').hidden, false);
+    assert.equal(root.querySelectorAll('li').length, 4);
+    assert.equal(root.querySelector('.year').textContent, '2026');
+    assert.equal(root.querySelector('.company').textContent, 'The Daily Grind Coffee Co.');
+    assert.equal(root.querySelector('.copyright').textContent.trim(), '© 2026 The Daily Grind Coffee Co. All rights reserved.');
+  });
+
+  test('hides the nav when there are no links and defaults the year', () => {
+    const footer = document.createElement('dg-site-footer');
+    document.body.append(footer);
+    assert.equal(footer.shadowRoot.querySelector('nav').hidden, true);
+    assert.equal(footer.shadowRoot.querySelector('.year').textContent, String(new Date().getFullYear()));
+    assert.equal(footer.shadowRoot.querySelector('.company').textContent, 'The Daily Grind.');
+    footer.remove();
+  });
+
+  test('supports a custom notice', () => {
+    const footer = document.createElement('dg-site-footer');
+    footer.setAttribute('company', 'Acme');
+    footer.setAttribute('year', '2030');
+    footer.setAttribute('notice', 'Some rights reserved.');
+    document.body.append(footer);
+    assert.equal(footer.shadowRoot.querySelector('.copyright').textContent.trim(), '© 2030 Acme. Some rights reserved.');
+    footer.remove();
+  });
+});
