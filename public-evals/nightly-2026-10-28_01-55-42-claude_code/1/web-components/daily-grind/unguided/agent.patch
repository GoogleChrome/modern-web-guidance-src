+  .links[hidden] {
+    display: none;
+  }
+  .list {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    margin: 0 0 20px;
+    padding: 0;
+    list-style: none;
+  }
+  .list li {
+    display: flex;
+    align-items: center;
+  }
+  /* Visual-only separators; a border never reaches the accessibility tree. */
+  .list li + li::before {
+    content: "";
+    display: inline-block;
+    height: 1em;
+    margin: 0 10px;
+    border-left: 1px solid currentColor;
+    opacity: 0.6;
+  }
+  ::slotted(a) {
+    display: inline-block;
+    padding: 0.5rem 0.25rem;
+    color: inherit !important;
+    font-size: 0.85rem;
+    text-decoration: none !important;
+  }
+  ::slotted(a:hover),
+  ::slotted(a:focus-visible) {
+    text-decoration: underline !important;
+    text-underline-offset: 0.2em;
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--dg-focus, #4e342e);
+    outline-offset: 2px;
+  }
+  .copyright {
+    margin: 0;
+  }
+`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <footer class="footer" part="footer">
+    <nav class="links" part="links" hidden>
+      <ul class="list"></ul>
+    </nav>
+    <p class="copyright" part="copyright">&copy; <span class="year"></span> <span class="company"></span> <span class="notice"></span></p>
+    <slot></slot>
+  </footer>
+`;
+
+/**
+ * <dg-site-footer>
+ *
+ * Site footer with a secondary navigation and a copyright line.
+ *
+ * Attributes: company (default "The Daily Grind"), year (default: current year),
+ *             notice (default "All rights reserved."), label (footer nav name, default "Footer")
+ * Slots:      direct <a> children — footer links; default — any extra content
+ * Parts:      footer, links, copyright
+ */
+class DgSiteFooter extends HTMLElement {
+  static observedAttributes = ['company', 'year', 'notice', 'label'];
+
+  #els;
+  #observer = null;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    adoptStyles(root, baseStyles, styles);
+    root.append(template.content.cloneNode(true));
+    this.#els = {
+      nav: root.querySelector('.links'),
+      list: root.querySelector('.list'),
+      year: root.querySelector('.year'),
+      company: root.querySelector('.company'),
+      notice: root.querySelector('.notice'),
+    };
+  }
+
+  connectedCallback() {
+    this.#update();
+    this.#renderLinks();
+    if (typeof MutationObserver === 'function') {
+      this.#observer = new MutationObserver(() => this.#renderLinks());
+      this.#observer.observe(this, { childList: true });
+    }
+  }
+
+  disconnectedCallback() {
+    this.#observer?.disconnect();
+    this.#observer = null;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#update();
+  }
+
+  #update() {
+    const { nav, year, company, notice } = this.#els;
+    year.textContent = this.getAttribute('year') ?? String(new Date().getFullYear());
+    // End the company name with a full stop unless it already carries punctuation ("… Co.").
+    const name = this.getAttribute('company') ?? 'The Daily Grind';
+    company.textContent = /[.!?]$/.test(name) ? name : `${name}.`;
+    notice.textContent = this.getAttribute('notice') ?? 'All rights reserved.';
