@@ -0,0 +1,193 @@
+import { adoptStyles, baseStyles, buttonStyles, define, headingTag } from './shared.js';
+
+const styles = `
+  :host {
+    display: block;
+  }
+  .card {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    overflow: hidden;
+    border-radius: var(--dg-radius, 8px);
+    background: var(--dg-surface, #fff);
+    color: var(--dg-text, #3e2723);
+    box-shadow: var(--dg-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+    text-align: center;
+    transition: transform 0.3s, box-shadow 0.3s;
+  }
+  :host(:hover) .card,
+  :host(:focus-within) .card {
+    transform: translateY(-2px);
+    box-shadow: var(--dg-shadow-raised, 0 6px 16px rgba(0, 0, 0, 0.15));
+  }
+  .media {
+    display: none;
+    aspect-ratio: 16 / 10;
+    overflow: hidden;
+    background: var(--dg-secondary, #d7ccc8);
+  }
+  .media.has-image {
+    display: block;
+  }
+  .media img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+  .body {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    gap: 0.625rem;
+    padding: 1.25rem;
+  }
+  .badge {
+    display: none;
+    align-self: center;
+    padding: 0.2em 0.75em;
+    border-radius: 999px;
+    background: var(--dg-accent, #ffab40);
+    color: var(--dg-text, #3e2723);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+  .badge.show {
+    display: inline-block;
+  }
+  .title {
+    margin: 0;
+    color: var(--dg-primary, #4e342e);
+    font-size: 1.17rem;
+    line-height: 1.3;
+  }
+  .description {
+    flex: 1;
+    margin: 0;
+  }
+  .price {
+    display: none;
+    margin: 0;
+    color: var(--dg-primary, #4e342e);
+    font-weight: 700;
+  }
+  .price.show {
+    display: block;
+  }
+  .cta {
+    display: none;
+    align-self: center;
+    margin-top: 0.25rem;
+  }
+  .cta.show {
+    display: inline-flex;
+  }
+`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card" aria-labelledby="title">
+    <div class="media" part="media">
+      <img alt="" loading="lazy" decoding="async">
+    </div>
+    <div class="body" part="body">
+      <span class="badge" part="badge"></span>
+      <h3 class="title" id="title" part="title"><slot name="title"></slot></h3>
+      <div class="description" part="description"><slot></slot></div>
+      <p class="price" part="price"><span class="visually-hidden">Price: </span><span class="price-value"></span></p>
+      <a class="btn cta" part="cta" aria-labelledby="cta-text title"><span id="cta-text"></span></a>
+    </div>
+  </article>
+`;
+
+/**
+ * <dg-coffee-card>
+ *
+ * A product card for a drink. Content lives in the light DOM so it stays
+ * indexable and readable without JavaScript; presentation is encapsulated.
+ *
+ * Attributes: href, cta-label (default "View Details"), image, image-alt,
+ *             badge, price, name (fallback title when no slot is given),
+ *             heading-level (1-6, default 3)
+ * Slots:      title — the drink name; default — the description
+ * Parts:      card, media, body, badge, title, description, price, cta
+ */
+class DgCoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'cta-label', 'image', 'image-alt', 'badge', 'price', 'name', 'heading-level'];
+
+  #els;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    adoptStyles(root, baseStyles, buttonStyles, styles);
+    root.append(template.content.cloneNode(true));
+    this.#els = {
+      media: root.querySelector('.media'),
+      img: root.querySelector('img'),
+      badge: root.querySelector('.badge'),
+      heading: root.querySelector('.title'),
+      price: root.querySelector('.price'),
+      priceValue: root.querySelector('.price-value'),
+      cta: root.querySelector('.cta'),
+      ctaText: root.querySelector('#cta-text'),
+    };
+  }
+
+  connectedCallback() {
+    this.#update();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#update();
+  }
+
+  #update() {
+    const els = this.#els;
+
+    // Heading level follows the surrounding document outline.
+    const tag = headingTag(this.getAttribute('heading-level'), 3);
+    if (els.heading.localName !== tag) {
+      const heading = document.createElement(tag);
+      heading.className = 'title';
+      heading.id = 'title';
+      heading.setAttribute('part', 'title');
+      heading.append(...els.heading.childNodes);
+      els.heading.replaceWith(heading);
+      els.heading = heading;
+    }
+    // Slot fallback content shows the `name` attribute when nothing is slotted.
+    els.heading.querySelector('slot').textContent = this.getAttribute('name') ?? '';
+
+    const image = this.getAttribute('image');
+    els.media.classList.toggle('has-image', Boolean(image));
+    if (image) {
+      els.img.setAttribute('src', image);
+      els.img.setAttribute('alt', this.getAttribute('image-alt') ?? '');
+    } else {
+      els.img.removeAttribute('src');
+      els.img.setAttribute('alt', '');
+    }
+
+    const badge = this.getAttribute('badge');
+    els.badge.textContent = badge ?? '';
+    els.badge.classList.toggle('show', Boolean(badge));
+
+    const price = this.getAttribute('price');
+    els.priceValue.textContent = price ?? '';
+    els.price.classList.toggle('show', Boolean(price));
+
+    const href = this.getAttribute('href');
+    els.cta.classList.toggle('show', Boolean(href));
+    if (href) els.cta.setAttribute('href', href);
+    else els.cta.removeAttribute('href');
+    els.ctaText.textContent = this.getAttribute('cta-label') || 'View Details';
+  }
+}
+
+define('dg-coffee-card', DgCoffeeCard);
+
+export { DgCoffeeCard };
diff --git a/components/dg-hero.js b/components/dg-hero.js
