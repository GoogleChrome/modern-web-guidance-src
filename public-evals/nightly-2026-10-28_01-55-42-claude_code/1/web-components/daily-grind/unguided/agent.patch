+import { adoptStyles, assignLinkSlots, baseStyles, define, renderLinkList } from './shared.js';
+
+const styles = `
+  :host {
+    display: block;
+  }
+  .footer {
+    padding: 40px 20px;
+    background: var(--dg-secondary, #d7ccc8);
+    color: var(--dg-text, #3e2723);
