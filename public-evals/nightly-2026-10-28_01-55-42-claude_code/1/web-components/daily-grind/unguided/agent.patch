+# Daily Grind components
+
+Dependency-free Web Components used by the Daily Grind site. Each element
+attaches an open shadow root, so its CSS cannot leak out and page CSS cannot
+accidentally restyle it. Theming goes through the custom properties in
+`tokens.css`; targeted overrides go through the exposed `::part()` names.
+
+```html
+<link rel="stylesheet" href="/components/tokens.css">
+<script type="module" src="/components/index.js"></script>
+```
+
+| Element | Purpose |
+| --- | --- |
+| `<dg-site-nav>` | Sticky primary nav with an accessible mobile disclosure menu |
+| `<dg-hero>` | Photo banner with overlay; becomes a region named by its heading |
+| `<dg-card-grid>` | Labelled section with a responsive auto-fit grid |
+| `<dg-coffee-card>` | Product card: image, badge, title, copy, price, call to action |
+| `<dg-button>` | Brand button rendering a real `<a>` or `<button>` |
+| `<dg-site-footer>` | Footer nav plus copyright line |
+
+## `<dg-site-nav>`
+
+```html
+<dg-site-nav brand="The Daily Grind" brand-href="/">
+  <a href="/menu" aria-current="page">Menu</a>
+  <a href="/logout" data-variant="outline">Logout</a>
+</dg-site-nav>
+```
+
+- Attributes: `brand`, `brand-href` (default `/`), `label` (nav landmark name, default `Primary`), `open` (reflected state).
+- Children: plain `<a>` elements. The component assigns each a slot and renders it inside a `<ul>`.
+- Behaviour: below `48em` the links collapse behind a toggle button with `aria-expanded` and `aria-controls`. Escape closes the menu and returns focus to the toggle. Clicking outside or activating a link also closes it. Resizing to desktop resets the state.
+- Events: `dg-nav-toggle` with `detail.open`.
+- Parts: `nav`, `brand`, `toggle`, `menu`.
+
+## `<dg-hero>`
+
+```html
+<dg-hero image="https://…" overlay="0.5" height="60vh">
+  <h1 slot="heading">Wake Up Your Senses</h1>
+  <p>Ethically sourced, locally roasted.</p>
+  <dg-button slot="actions" href="/order-online">Order Now</dg-button>
+</dg-hero>
+```
+
+- Attributes: `image`, `overlay` (0 to 1), `height` (CSS length).
+- The host receives `role="region"` and `aria-labelledby` pointing at the slotted heading, unless you set `role` yourself.
+- Parts: `hero`, `content`, `heading`, `text`, `actions`.
+
+## `<dg-card-grid>`
+
+- Attributes: `heading`, `heading-level` (1 to 6, default 2), `label` (used when there is no visible heading), `min-column` (default `250px`).
+- Parts: `section`, `heading`, `grid`.
+
+## `<dg-coffee-card>`
+
+```html
+<dg-coffee-card href="/menu/seasonal" badge="Seasonal" price="$5.50"
+  image="https://…" image-alt="Latte with leaf art">
+  <span slot="title">Maple Oat Latte</span>
+  <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+</dg-coffee-card>
+```
+
+- Attributes: `href`, `cta-label` (default `View Details`), `image`, `image-alt`, `badge`, `price`, `name` (fallback title), `heading-level` (default 3).
+- The call to action is named "View Details, Maple Oat Latte" via `aria-labelledby`, so repeated links stay distinguishable for screen-reader users.
+- Images are lazy-loaded. Omit `image-alt` for decorative photos.
+- Parts: `card`, `media`, `body`, `badge`, `title`, `description`, `price`, `cta`.
+
+## `<dg-button>`
+
+- Attributes: `href`, `target`, `rel`, `download`, `type`, `disabled`, `variant="outline"`, `block`.
+- Renders an `<a>` when `href` is present, otherwise a `<button>`. It is form-associated, so `type="submit"` submits the surrounding form.
+- Parts: `button`.
+
+## `<dg-site-footer>`
+
+- Attributes: `company`, `year` (defaults to the current year), `notice` (default `All rights reserved.`), `label` (default `Footer`).
+- Children: plain `<a>` elements for the footer nav; any other content goes after the copyright line.
+- Parts: `footer`, `links`, `copyright`.
+
+## Theming
+
+Override any token on `:root` or on a single element:
+
+```css
+dg-coffee-card.featured { --dg-primary: #8d6e63; }
+dg-site-nav::part(nav) { padding-inline: 2rem; }
+```
+
+## Tests
+
+`npm test` runs a jsdom smoke test in `tests/components.test.mjs` that loads
+`index.html`, upgrades the elements and checks the rendered shadow trees and
+ARIA wiring.
diff --git a/components/dg-button.js b/components/dg-button.js
new file mode 100644
index 0000000..5353b59
--- /dev/null
+++ b/components/dg-button.js
@@ -0,0 +1,118 @@
+import { adoptStyles, baseStyles, buttonStyles, define } from './shared.js';
+
+const hostStyles = `
+  :host {
+    display: inline-block;
+  }
+  :host([block]) {
+    display: block;
+  }
+  :host([block]) .btn {
+    width: 100%;
+  }
+`;
+
+/**
+ * <dg-button>
+ *
+ * A brand button that renders a real <a> when `href` is set and a real
+ * <button> otherwise, so native keyboard and screen-reader behaviour is
+ * preserved. Form-associated: a `type="submit"` button submits the form it
+ * is placed in even though the control lives in the shadow tree.
+ *
+ * Attributes: href, target, rel, download, type (button|submit|reset),
+ *             disabled, variant (solid|outline), block
+ * Slots:      default — the label
+ * Parts:      button
+ */
+class DgButton extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['href', 'target', 'rel', 'download', 'type', 'disabled', 'variant'];
+
+  #control = null;
+  #internals = null;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    adoptStyles(root, baseStyles, buttonStyles, hostStyles);
+    if (typeof this.attachInternals === 'function') {
+      try {
+        this.#internals = this.attachInternals();
+      } catch {
+        this.#internals = null;
+      }
+    }
+    this.addEventListener('click', this.#onClick);
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(value) {
+    this.toggleAttribute('disabled', Boolean(value));
+  }
+
+  #onClick = (event) => {
+    if (this.disabled) {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      return;
+    }
+    if (this.#control?.localName !== 'button') return;
+    const form = this.#internals?.form;
+    if (!form) return;
+    const type = this.getAttribute('type') || 'button';
+    if (type === 'submit') form.requestSubmit();
+    else if (type === 'reset') form.reset();
+  };
+
+  #render() {
+    const href = this.getAttribute('href');
+    const isLink = href !== null && !this.disabled;
+    const tag = isLink ? 'a' : 'button';
+
+    if (!this.#control || this.#control.localName !== tag) {
+      this.#control?.remove();
+      const control = document.createElement(tag);
+      control.className = 'btn';
+      control.setAttribute('part', 'button');
+      control.append(document.createElement('slot'));
+      this.shadowRoot.append(control);
+      this.#control = control;
+    }
+
+    const control = this.#control;
+    control.classList.toggle('outline', this.getAttribute('variant') === 'outline');
+
+    if (isLink) {
+      control.setAttribute('href', href);
+      for (const attr of ['target', 'download']) {
+        const value = this.getAttribute(attr);
+        if (value === null) control.removeAttribute(attr);
+        else control.setAttribute(attr, value);
+      }
+      const rel = this.getAttribute('rel') ?? (this.getAttribute('target') === '_blank' ? 'noopener' : null);
+      if (rel === null) control.removeAttribute('rel');
+      else control.setAttribute('rel', rel);
+    } else {
+      control.type = this.getAttribute('type') || 'button';
+      control.disabled = this.disabled;
+      if (this.disabled) control.setAttribute('aria-disabled', 'true');
+      else control.removeAttribute('aria-disabled');
+    }
+  }
+}
+
+define('dg-button', DgButton);
+
+export { DgButton };
diff --git a/components/dg-card-grid.js b/components/dg-card-grid.js
new file mode 100644
index 0000000..f1561cd
--- /dev/null
+++ b/components/dg-card-grid.js
@@ -0,0 +1,105 @@
+import { adoptStyles, baseStyles, define, headingTag } from './shared.js';
+
+const styles = `
+  :host {
+    display: block;
+  }
+  .heading {
+    margin: 0 0 1.25rem;
+    color: var(--dg-text, #3e2723);
+    font-size: 1.5rem;
+    text-align: center;
+  }
+  .heading[hidden] {
+    display: none;
+  }
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(var(--_min, 250px), 100%), 1fr));
+    gap: var(--dg-gap, 20px);
+  }
+`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <section class="section" part="section">
+    <h2 class="heading" id="heading" part="heading" hidden></h2>
+    <div class="grid" part="grid"><slot></slot></div>
+  </section>
+`;
+
+const LENGTH_PATTERN = /^\d+(\.\d+)?(px|rem|em|ch|vw|%)$/;
+
+/**
+ * <dg-card-grid>
+ *
+ * A labelled section that lays its children out in a responsive grid.
+ *
+ * Attributes: heading (section title, also labels the region),
+ *             heading-level (1-6, default 2),
+ *             label (aria-label used when there is no visible heading),
+ *             min-column (CSS length for the minimum column width, default 250px)
+ * Slots:      default — the cards
+ * Parts:      section, heading, grid
+ */
+class DgCardGrid extends HTMLElement {
+  static observedAttributes = ['heading', 'heading-level', 'label', 'min-column'];
+
+  #els;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    adoptStyles(root, baseStyles, styles);
+    root.append(template.content.cloneNode(true));
+    this.#els = {
+      section: root.querySelector('.section'),
+      heading: root.querySelector('.heading'),
+      grid: root.querySelector('.grid'),
+    };
+  }
+
+  connectedCallback() {
+    this.#update();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#update();
+  }
+
+  #update() {
+    const els = this.#els;
+
+    const tag = headingTag(this.getAttribute('heading-level'), 2);
+    if (els.heading.localName !== tag) {
+      const heading = document.createElement(tag);
+      heading.className = 'heading';
+      heading.id = 'heading';
+      heading.setAttribute('part', 'heading');
+      els.heading.replaceWith(heading);
+      els.heading = heading;
+    }
+
+    const text = this.getAttribute('heading');
+    els.heading.textContent = text ?? '';
+    els.heading.hidden = !text;
+
+    const label = this.getAttribute('label');
+    if (text) {
+      els.section.setAttribute('aria-labelledby', 'heading');
+      els.section.removeAttribute('aria-label');
+    } else {
+      els.section.removeAttribute('aria-labelledby');
+      if (label) els.section.setAttribute('aria-label', label);
+      else els.section.removeAttribute('aria-label');
+    }
+
+    const min = this.getAttribute('min-column');
+    if (min && LENGTH_PATTERN.test(min)) els.grid.style.setProperty('--_min', min);
+    else els.grid.style.removeProperty('--_min');
+  }
+}
+
+define('dg-card-grid', DgCardGrid);
+
+export { DgCardGrid };
diff --git a/components/dg-coffee-card.js b/components/dg-coffee-card.js
