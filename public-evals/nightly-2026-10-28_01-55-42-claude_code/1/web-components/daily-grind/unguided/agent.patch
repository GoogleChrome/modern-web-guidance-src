+/**
+ * Shared helpers and style fragments for the Daily Grind web components.
+ *
+ * Every component attaches an open shadow root and adopts `baseStyles`
+ * so that focus rings, reduced-motion handling and the visually-hidden
+ * utility behave identically across the library.
+ */
+
+const sheetCache = new Map();
+const supportsAdoptedSheets =
+  typeof CSSStyleSheet !== 'undefined' &&
+  'replaceSync' in CSSStyleSheet.prototype &&
+  typeof ShadowRoot !== 'undefined' &&
+  'adoptedStyleSheets' in ShadowRoot.prototype;
+
+/**
+ * Attach one or more CSS strings to a shadow root. Uses constructable
+ * stylesheets (shared across instances) when available and falls back to
+ * inline <style> elements otherwise.
+ */
+export function adoptStyles(root, ...cssTexts) {
+  if (supportsAdoptedSheets) {
+    root.adoptedStyleSheets = cssTexts.map((css) => {
+      let sheet = sheetCache.get(css);
+      if (!sheet) {
+        sheet = new CSSStyleSheet();
+        sheet.replaceSync(css);
+        sheetCache.set(css, sheet);
+      }
+      return sheet;
+    });
+    return;
+  }
+  for (const css of cssTexts) {
+    const style = document.createElement('style');
+    style.textContent = css;
+    root.append(style);
+  }
+}
+
+/** Register a custom element once, tolerating repeated module evaluation. */
+export function define(name, ctor) {
+  if (!customElements.get(name)) customElements.define(name, ctor);
+}
+
+let uid = 0;
+/** Generate a document-unique id with the given prefix. */
+export function nextId(prefix) {
+  uid += 1;
+  return `${prefix}-${uid}`;
+}
+
+/** Clamp a heading-level attribute to h1..h6, falling back when invalid. */
+export function headingTag(value, fallback) {
+  const level = Number.parseInt(value, 10);
+  const ok = Number.isInteger(level) && level >= 1 && level <= 6;
+  return `h${ok ? level : fallback}`;
+}
+
+/** Quote a URL for use inside a CSS url() function. */
+export function cssUrl(url) {
+  return `url("${String(url).replace(/["\\\n]/g, encodeURIComponent)}")`;
+}
+
+/**
+ * Give each direct light-DOM link a unique slot name so the component can
+ * place it inside its own list markup while the author keeps plain <a>s.
+ * Returns the matched elements in document order.
+ */
+export function assignLinkSlots(host, prefix = 'link') {
+  const links = [...host.children].filter((el) => el.matches('a, button'));
+  links.forEach((el, index) => {
+    const name = `${prefix}-${index}`;
+    if (el.slot !== name) el.slot = name;
+  });
+  return links;
+}
+
+/** Build a <ul> of <li><slot name=…></slot></li> for the given links. */
+export function renderLinkList(listEl, links, prefix = 'link') {
+  const items = links.map((_, index) => {
+    const li = document.createElement('li');
+    const slot = document.createElement('slot');
+    slot.name = `${prefix}-${index}`;
+    li.append(slot);
+    return li;
+  });
+  listEl.replaceChildren(...items);
+}
+
+export const baseStyles = `
+  :host {
+    box-sizing: border-box;
+  }
+  :host([hidden]) {
+    display: none !important;
+  }
+  *, *::before, *::after {
+    box-sizing: inherit;
+  }
+  .visually-hidden {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    clip-path: inset(50%);
+    white-space: nowrap;
+    border: 0;
+  }
+  :focus-visible {
+    outline: 3px solid var(--dg-focus, #4e342e);
+    outline-offset: 2px;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition-duration: 0.01ms !important;
+      animation-duration: 0.01ms !important;
+    }
+  }
+`;
+
+export const buttonStyles = `
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5em;
+    min-height: 44px;
+    padding: 0.625rem 1.25rem;
+    border: 2px solid transparent;
+    border-radius: var(--dg-radius-sm, 5px);
+    background: var(--dg-primary, #4e342e);
+    color: var(--dg-on-primary, #fff);
+    font: inherit;
+    font-weight: 600;
+    line-height: 1.2;
+    text-decoration: none;
+    cursor: pointer;
+    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
+  }
+  .btn:hover {
+    background: var(--dg-primary-dark, #3e2723);
+  }
+  .btn.outline {
+    background: transparent;
+    color: inherit;
+    border-color: var(--dg-accent, #ffab40);
+  }
+  .btn.outline:hover {
+    background: var(--dg-accent, #ffab40);
+    color: var(--dg-text, #3e2723);
+  }
+  .btn:disabled,
+  .btn[aria-disabled="true"] {
+    opacity: 0.6;
+    cursor: not-allowed;
+  }
+  @media (forced-colors: active) {
+    .btn {
+      border-color: ButtonText;
+    }
+  }
+`;
