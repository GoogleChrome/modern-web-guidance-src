index 0000000..8b5be66
--- /dev/null
+++ b/components/dg-hero.js
@@ -0,0 +1,149 @@
+import { adoptStyles, baseStyles, cssUrl, define, nextId } from './shared.js';
+
+const styles = `
+  :host {
+    display: block;
+  }
+  .hero {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    min-height: var(--_height, 60vh);
+    padding: 3rem 1.25rem;
+    background-color: var(--dg-primary, #4e342e);
+    background-image:
+      linear-gradient(rgba(0, 0, 0, var(--_overlay, 0.5)), rgba(0, 0, 0, var(--_overlay, 0.5))),
+      var(--_image, none);
+    background-position: center;
+    background-size: cover;
+    color: #fff;
+    text-align: center;
+  }
+  .content {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    max-width: 60ch;
+  }
+  .heading {
+    margin-bottom: 1rem;
+  }
+  ::slotted(h1),
+  ::slotted(h2) {
+    font-size: clamp(2rem, 5vw, 3rem);
+    line-height: 1.15;
+  }
+  ::slotted(p) {
+    font-size: 1.125rem;
+  }
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 1rem;
+    margin-top: 1.5rem;
+  }
+  .actions[hidden] {
+    display: none;
+  }
+  /* Focus rings need to read against the dark photo. */
+  ::slotted(*) {
+    --dg-focus: #fff;
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid #fff;
+    outline-offset: 2px;
+  }
+`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="hero" part="hero">
+    <div class="content" part="content">
+      <div class="heading" part="heading"><slot name="heading"></slot></div>
+      <div class="text" part="text"><slot></slot></div>
+      <div class="actions" part="actions" hidden><slot name="actions"></slot></div>
+    </div>
+  </div>
+`;
+
+const NUMBER_PATTERN = /^(0|1|0?\.\d+)$/;
+const LENGTH_PATTERN = /^\d+(\.\d+)?(px|rem|em|vh|svh|dvh|lvh|vw|%)$/;
+
+/**
+ * <dg-hero>
+ *
+ * A full-width banner with a background photo and a dark overlay for
+ * contrast. The host becomes a named region labelled by the slotted heading.
+ *
+ * Attributes: image (URL), overlay (0-1, default 0.5), height (CSS length, default 60vh)
+ * Slots:      heading — an <h1>/<h2>; default — supporting copy;
+ *             actions — calls to action such as <dg-button>
+ * Parts:      hero, content, heading, text, actions
+ */
+class DgHero extends HTMLElement {
+  static observedAttributes = ['image', 'overlay', 'height'];
+
+  #hero;
+  #actions;
+  #observer = null;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    adoptStyles(root, baseStyles, styles);
+    root.append(template.content.cloneNode(true));
+    this.#hero = root.querySelector('.hero');
+    this.#actions = root.querySelector('.actions');
+  }
+
+  connectedCallback() {
+    this.#update();
+    this.#syncLightDom();
+    if (typeof MutationObserver === 'function') {
+      this.#observer = new MutationObserver(() => this.#syncLightDom());
+      this.#observer.observe(this, { childList: true, attributes: true, attributeFilter: ['slot', 'id'], subtree: true });
+    }
+  }
+
+  disconnectedCallback() {
+    this.#observer?.disconnect();
+    this.#observer = null;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#update();
+  }
+
+  #update() {
+    const image = this.getAttribute('image');
+    if (image) this.#hero.style.setProperty('--_image', cssUrl(image));
+    else this.#hero.style.removeProperty('--_image');
+
+    const overlay = this.getAttribute('overlay');
+    if (overlay && NUMBER_PATTERN.test(overlay)) this.#hero.style.setProperty('--_overlay', overlay);
+    else this.#hero.style.removeProperty('--_overlay');
+
+    const height = this.getAttribute('height');
+    if (height && LENGTH_PATTERN.test(height)) this.#hero.style.setProperty('--_height', height);
+    else this.#hero.style.removeProperty('--_height');
+  }
+
+  /** Name the region after the slotted heading and hide empty action rows. */
