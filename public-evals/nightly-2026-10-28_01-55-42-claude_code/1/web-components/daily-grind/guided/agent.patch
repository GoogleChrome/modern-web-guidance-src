+/**
+ * <brew-tabs> - an accessible tab interface built from plain sections.
+ *
+ *   <brew-tabs label="Brewing methods" selected="0">
+ *     <section data-label="Pour Over">...</section>
+ *     <section data-label="French Press">...</section>
+ *   </brew-tabs>
+ *
+ * Every element child becomes a panel. Its tab label comes from `data-label`,
+ * falling back to the first heading inside it. Tabs, panels and the ARIA
+ * relationships between them are rendered inside the shadow tree (id references
+ * cannot cross the shadow boundary); the panel content itself stays in light DOM
+ * and is projected through a slot.
+ *
+ * Attributes / properties:
+ *   label      accessible name for the tablist (default "Tabs")
+ *   selected   zero-based index of the active tab, reflected  (property: selectedIndex)
+ *   panels     (read-only property) the light-DOM panel elements
+ *
+ * Keyboard: Left/Right move between tabs (direction-aware), Home/End jump.
+ * Hidden panels use hidden="until-found" where supported, so find-in-page and
+ * URL fragments inside a panel still reveal it.
+ *
+ * Events:  change { detail: { index, panel } } (bubbles) when the user picks a tab
+ *
+ * Styling hooks:
+ *   --brew-tabs-fg, --brew-tabs-accent, --brew-tabs-border, --brew-tabs-panel-bg, --brew-tabs-radius
+ *   ::part(tablist | tab | panel | panel-body)
+ */
+import { defineOnce, ensureShadow, fragmentTargetWithin } from './utils.js';
+
+const SUPPORTS_UNTIL_FOUND = 'onbeforematch' in HTMLElement.prototype;
+
+const TEMPLATE = /* html */ `
+  <div class="tablist" role="tablist" part="tablist" aria-label="Tabs"></div>
+  <div class="panels"></div>
+`;
+
+const STYLES = /* css */ `
+  :host {
+    display: block;
+    --_fg: var(--brew-tabs-fg, inherit);
+    --_accent: var(--brew-tabs-accent, #ffab40);
+    --_border: var(--brew-tabs-border, #d7ccc8);
+    --_panel-bg: var(--brew-tabs-panel-bg, #fff);
+    --_radius: var(--brew-tabs-radius, 8px);
+  }
+
+  :host([hidden]) { display: none; }
+
+  .tablist {
+    display: flex;
+    gap: 0.25rem;
+    overflow-x: auto;
+    scrollbar-width: thin;
+    border-block-end: 2px solid var(--_border);
+  }
+
+  [role="tab"] {
+    flex: none;
+    min-block-size: 44px;
+    margin-block-end: -2px;
+    padding: 0.75rem 1.25rem;
+    border: 0;
+    border-block-end: 3px solid transparent;
+    border-start-start-radius: var(--_radius);
+    border-start-end-radius: var(--_radius);
+    background: transparent;
+    color: var(--_fg);
+    font: inherit;
+    font-weight: 600;
+    white-space: nowrap;
+    cursor: pointer;
+    transition: background-color 0.2s, border-color 0.2s;
+  }
+
+  [role="tab"]:hover { background: color-mix(in srgb, var(--_accent) 15%, transparent); }
+
+  [role="tab"][aria-selected="true"] {
+    border-block-end-color: var(--_accent);
+    background: color-mix(in srgb, var(--_accent) 22%, transparent);
+  }
+
+  [role="tab"]:focus-visible {
+    outline: 2px solid var(--_accent);
+    outline-offset: -2px;
+  }
+
+  /* No display rules on the panel itself: hidden="until-found" must keep
+     rendering (content-visibility: hidden) so the browser can search it.
+     Visual chrome lives on the inner wrapper instead. */
+  [role="tabpanel"]:focus-visible {
+    outline: 2px solid var(--_accent);
+    outline-offset: 2px;
+  }
+
+  .panel-body {
+    padding: 1.5rem;
+    background: var(--_panel-bg);
+    border: 1px solid var(--_border);
+    border-block-start: 0;
+    border-end-start-radius: var(--_radius);
+    border-end-end-radius: var(--_radius);
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    [role="tab"] { transition: none; }
+  }
+`;
+
+export class BrewTabs extends HTMLElement {
+  static observedAttributes = ['selected', 'label'];
+
+  #tablist;
+  #panelsHost;
+  #tabs = [];
+  #panels = [];
+  #current = 0;
+  #observer;
+  #onHashChange = () => this.#revealFragment();
+
+  constructor() {
+    super();
+    const root = ensureShadow(this, TEMPLATE, STYLES);
+    this.#tablist = root.querySelector('[role="tablist"]');
+    this.#panelsHost = root.querySelector('.panels');
+
+    this.#tablist.addEventListener('click', (event) => {
+      const tab = event.target.closest('[role="tab"]');
+      if (tab) this.#select(this.#tabs.indexOf(tab), { focus: true, user: true });
+    });
+    this.#tablist.addEventListener('keydown', (event) => this.#onKeydown(event));
+
+    // Find-in-page revealed a hidden panel: make the tab state agree with it.
+    this.#panelsHost.addEventListener('beforematch', (event) => {
+      const panel = event.target.closest('[role="tabpanel"]');
+      const index = this.#panels.indexOf(panel);
+      if (index > -1) this.#select(index, { user: true });
+    });
+
+    this.#observer = new MutationObserver(() => this.#build());
+  }
+
+  connectedCallback() {
+    this.#tablist.setAttribute('aria-label', this.label || 'Tabs');
+    this.#build();
+    this.#observer.observe(this, { childList: true });
+    window.addEventListener('hashchange', this.#onHashChange);
+    this.#revealFragment();
+  }
+
+  disconnectedCallback() {
+    this.#observer.disconnect();
+    window.removeEventListener('hashchange', this.#onHashChange);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'label') {
+      this.#tablist.setAttribute('aria-label', newValue || 'Tabs');
+    } else if (name === 'selected' && this.#tabs.length) {
+      this.#select(this.selectedIndex);
+    }
+  }
+
+  /* ---- Public API ---- */
+
+  get selectedIndex() {
+    const n = Number.parseInt(this.getAttribute('selected') ?? '', 10);
+    if (!Number.isInteger(n) || n < 0) return 0;
+    return this.#tabs.length ? Math.min(n, this.#tabs.length - 1) : n;
+  }
+  set selectedIndex(index) { this.setAttribute('selected', String(index)); }
+
+  get label() { return this.getAttribute('label') ?? ''; }
+  set label(value) {
+    if (value) this.setAttribute('label', value);
+    else this.removeAttribute('label');
+  }
+
+  /** The light-DOM elements acting as panels, in tab order. */
+  get panels() { return [...this.children]; }
+
+  /* ---- Internals ---- */
+
+  #build() {
+    const children = this.panels;
+    this.#tabs = [];
+    this.#panels = [];
+    const tabFragment = document.createDocumentFragment();
+    const panelFragment = document.createDocumentFragment();
+
+    children.forEach((child, index) => {
+      // Assign each child to its own slot; attribute changes don't retrigger the childList observer.
+      if (child.slot !== `panel-${index}`) child.slot = `panel-${index}`;
+
+      const label =
+        child.dataset.label?.trim() ||
+        child.querySelector('h1, h2, h3, h4, h5, h6')?.textContent.trim() ||
+        `Tab ${index + 1}`;
+
+      const tab = document.createElement('button');
+      tab.type = 'button';
+      tab.id = `tab-${index}`;
+      tab.setAttribute('role', 'tab');
+      tab.setAttribute('part', 'tab');
+      tab.setAttribute('aria-controls', `panel-${index}`);
+      tab.textContent = label;
+
+      const panel = document.createElement('div');
+      panel.id = `panel-${index}`;
+      panel.setAttribute('role', 'tabpanel');
+      panel.setAttribute('part', 'panel');
+      panel.setAttribute('aria-labelledby', `tab-${index}`);
+      panel.tabIndex = 0;
+      const body = document.createElement('div');
+      body.className = 'panel-body';
+      body.setAttribute('part', 'panel-body');
+      const slot = document.createElement('slot');
+      slot.name = `panel-${index}`;
+      body.append(slot);
+      panel.append(body);
+
+      this.#tabs.push(tab);
+      this.#panels.push(panel);
+      tabFragment.append(tab);
+      panelFragment.append(panel);
+    });
+
+    this.#tablist.replaceChildren(tabFragment);
+    this.#panelsHost.replaceChildren(panelFragment);
+    this.#applySelection(this.selectedIndex);
+  }
+
+  #applySelection(index) {
+    this.#current = index;
+    this.#tabs.forEach((tab, i) => {
+      const active = i === index;
+      tab.setAttribute('aria-selected', String(active));
+      tab.tabIndex = active ? 0 : -1;
+      const panel = this.#panels[i];
+      if (active) panel.removeAttribute('hidden');
+      else panel.setAttribute('hidden', SUPPORTS_UNTIL_FOUND ? 'until-found' : '');
+    });
+  }
+
+  #select(index, { focus = false, user = false } = {}) {
+    if (!this.#tabs.length || index < 0 || index >= this.#tabs.length) return;
+    const changed = index !== this.#current;
+    this.#applySelection(index);
+    if (this.getAttribute('selected') !== String(index)) {
+      this.setAttribute('selected', String(index));
+    }
+    if (focus) this.#tabs[index].focus();
+    if (changed && user) {
+      this.dispatchEvent(
+        new CustomEvent('change', {
+          bubbles: true,
+          detail: { index, panel: this.panels[index] ?? null },
+        }),
+      );
+    }
+  }
+
+  #onKeydown(event) {
+    const count = this.#tabs.length;
+    if (!count) return;
+    let next;
+    switch (event.key) {
+      case 'ArrowRight':
+      case 'ArrowLeft': {
+        const rtl = getComputedStyle(this).direction === 'rtl';
+        const step = (event.key === 'ArrowRight' ? 1 : -1) * (rtl ? -1 : 1);
+        next = (this.#current + step + count) % count;
+        break;
+      }
+      case 'Home':
+        next = 0;
+        break;
+      case 'End':
+        next = count - 1;
+        break;
+      default:
+        return;
+    }
+    event.preventDefault();
+    this.#select(next, { focus: true, user: true });
+  }
+
+  /** If the URL fragment points inside a panel, show that panel and scroll to it. */
+  #revealFragment() {
+    const target = fragmentTargetWithin(this);
+    if (!target || target === this) return;
+    const index = this.panels.findIndex((panel) => panel === target || panel.contains(target));
+    if (index === -1) return;
+    const wasHidden = index !== this.#current;
+    this.#select(index);
+    if (wasHidden) target.scrollIntoView({ block: 'start' });
+  }
+}
+
+defineOnce('brew-tabs', BrewTabs);
