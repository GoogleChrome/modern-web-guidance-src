+/**
+ * <coffee-card> - a menu item card with media, title, price and a favorite toggle.
+ *
+ * Light DOM (slots), in source order:
+ *   [slot="media"]    optional <img>/<picture> shown first
+ *   [slot="title"]    the heading; the page picks the level (<h3>, <h2>, ...)
+ *   (default)         supporting content such as a <p>
+ *   [slot="actions"]  native links/buttons for independent actions
+ *
+ * Attributes / properties:
+ *   name       accessible name used by the favorite toggle (defaults to the slotted title text)
+ *   price      numeric price, formatted with `currency` (default "USD") in the page language
+ *   currency   ISO 4217 code
+ *   badge      short label such as "Seasonal"
+ *   favorited  boolean, reflected; persisted in localStorage when the card has an `id`
+ *
+ * Events:
+ *   favoritechange  { detail: { favorited, id } }  bubbles + composed, fired on user toggles
+ *
+ * Styling hooks:
+ *   --coffee-card-bg, --coffee-card-fg, --coffee-card-heading, --coffee-card-accent,
+ *   --coffee-card-favorite, --coffee-card-radius, --coffee-card-shadow
+ *   ::part(card | header | badge | price | content | footer | favorite)
+ *   :state(favorited), :state(has-media)
+ */
+import {
+  attachInternalsSafe,
+  defineOnce,
+  ensureShadow,
+  setState,
+} from './utils.js';
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
+    return new Set(Array.isArray(parsed) ? parsed : []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) - favorites stay in-memory */
+  }
+}
+
+const TEMPLATE = /* html */ `
+  <article part="card">
+    <slot name="media"></slot>
+    <header part="header">
+      <slot name="title"></slot>
+      <p class="meta" hidden>
+        <span class="badge" part="badge" hidden></span>
+        <data class="price" part="price" hidden></data>
+      </p>
+    </header>
+    <div class="content" part="content"><slot></slot></div>
+    <footer part="footer">
+      <slot name="actions"></slot>
+      <button type="button" class="favorite" part="favorite" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+          <path d="M12 20.5s-7.4-4.6-9.4-9.1C1.2 8.1 3.1 4.5 6.7 4.5c2 0 3.3 1 4.3 2.6 1-1.6 2.3-2.6 4.3-2.6 3.6 0 5.5 3.6 4.1 6.9-2 4.5-9.4 9.1-9.4 9.1z"/>
+        </svg>
+      </button>
+    </footer>
+  </article>
+`;
+
+const STYLES = /* css */ `
+  :host {
+    display: block;
+    container-type: inline-size;
+    --_bg: var(--coffee-card-bg, #fff);
+    --_fg: var(--coffee-card-fg, inherit);
+    --_heading: var(--coffee-card-heading, #4e342e);
+    --_accent: var(--coffee-card-accent, #ffab40);
+    --_favorite: var(--coffee-card-favorite, #c62828);
+    --_radius: var(--coffee-card-radius, 8px);
+    --_shadow: var(--coffee-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+  }
+
+  :host([hidden]) { display: none; }
+  [hidden] { display: none !important; }
+
+  article {
+    box-sizing: border-box;
+    block-size: 100%;
+    display: grid;
+    grid-template-rows: auto 1fr auto;
+    row-gap: 0.75rem;
+    background: var(--_bg);
+    color: var(--_fg);
+    border-radius: var(--_radius);
+    box-shadow: var(--_shadow);
+    overflow: clip;
+    text-align: center;
+  }
+
+  article.has-media { grid-template-rows: auto auto 1fr auto; }
+
+  /* Media fills a fixed-ratio area; cropping is preferable to distortion. */
+  slot[name="media"]::slotted(*) {
+    display: block;
+    inline-size: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+  }
+
+  header,
+  .content,
+  footer {
+    padding-inline: 1.25rem;
+  }
+
+  header {
+    display: grid;
+    gap: 0.25rem;
+    justify-items: center;
+    padding-block-start: 1.25rem;
+  }
+
+  slot[name="title"]::slotted(*) {
+    margin: 0;
+    color: var(--_heading);
+    font-size: 1.25rem;
+    line-height: 1.3;
+  }
+
+  .meta {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem;
+    margin: 0;
+  }
+
+  .badge {
+    display: inline-block;
+    padding: 0.1rem 0.6rem;
+    border-radius: 999px;
+    background: var(--_accent);
+    color: #3e2723;
+    font-size: 0.75rem;
+    font-weight: 600;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+  }
+
+  .price {
+    font-weight: 600;
+    font-variant-numeric: tabular-nums;
+  }
+
+  footer {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    gap: 0.75rem;
+    padding-block-end: 1.25rem;
+  }
+
+  .favorite {
+    display: inline-grid;
+    place-items: center;
+    inline-size: 2.75rem;
+    block-size: 2.75rem;
+    padding: 0;
+    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
+    border-radius: 50%;
+    background: transparent;
+    color: inherit;
+    font: inherit;
+    cursor: pointer;
+    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
+  }
+
+  .favorite:hover { background: color-mix(in srgb, var(--_accent) 20%, transparent); }
+
+  .favorite:focus-visible {
+    outline: 2px solid var(--_accent);
+    outline-offset: 2px;
+  }
+
+  .favorite svg {
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+    stroke-linejoin: round;
+    transition: fill 0.2s, transform 0.2s;
+  }
+
+  .favorite[aria-pressed="true"] {
+    color: var(--_favorite);
+    border-color: currentColor;
+  }
+
+  .favorite[aria-pressed="true"] svg { fill: currentColor; }
+
+  .favorite:active svg { transform: scale(0.85); }
+
+  /* Wide container: media moves beside the text, only for cards that have media. */
+  @container (min-width: 34rem) {
+    article.has-media {
+      grid-template-columns: minmax(10rem, 2fr) 3fr;
+      grid-template-rows: auto 1fr auto;
+      text-align: start;
+    }
+
+    article.has-media slot[name="media"]::slotted(*) {
+      grid-row: 1 / -1;
+      block-size: 100%;
+      aspect-ratio: auto;
+    }
+
+    article.has-media header { justify-items: start; }
+    article.has-media .meta,
+    article.has-media footer { justify-content: flex-start; }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .favorite,
+    .favorite svg { transition: none; }
+  }
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'price', 'currency', 'badge', 'favorited'];
+
+  #internals;
+  #article;
+  #meta;
+  #badge;
+  #price;
+  #favorite;
+  #mediaSlot;
+  #titleSlot;
+
+  constructor() {
+    super();
+    this.#internals = attachInternalsSafe(this);
+    const root = ensureShadow(this, TEMPLATE, STYLES);
+
+    this.#article = root.querySelector('article');
+    this.#meta = root.querySelector('.meta');
+    this.#badge = root.querySelector('.badge');
+    this.#price = root.querySelector('.price');
+    this.#favorite = root.querySelector('.favorite');
+    this.#mediaSlot = root.querySelector('slot[name="media"]');
+    this.#titleSlot = root.querySelector('slot[name="title"]');
+
+    // Listeners are attached once here (not in connectedCallback, which re-runs on moves).
+    this.#favorite.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(
+        new CustomEvent('favoritechange', {
+          bubbles: true,
+          composed: true,
+          detail: { favorited: this.favorited, id: this.id || null },
+        }),
+      );
+    });
+    this.#mediaSlot.addEventListener('slotchange', () => this.#syncMedia());
+    this.#titleSlot.addEventListener('slotchange', () => this.#syncFavoriteLabel());
+  }
+
+  connectedCallback() {
+    // Restore a persisted favorite unless markup already decided.
+    if (this.id && !this.hasAttribute('favorited') && readFavorites().has(this.id)) {
+      this.toggleAttribute('favorited', true);
+    }
+    this.#syncMedia();
+    this.#syncFavoriteLabel();
+    this.#syncFavorite();
+    this.#renderMeta();
+    // Children may not be parsed yet when this runs; slotchange covers that in
+    // browsers, and this microtask covers environments that don't fire it.
+    queueMicrotask(() => {
+      if (this.isConnected) {
+        this.#syncMedia();
+        this.#syncFavoriteLabel();
+      }
+    });
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    switch (name) {
+      case 'favorited':
+        this.#syncFavorite();
+        break;
+      case 'name':
+        this.#syncFavoriteLabel();
+        break;
+      default:
+        this.#renderMeta();
+    }
+  }
+
+  /* ---- Reflected properties ---- */
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) {
+    if (value) this.setAttribute('name', value);
+    else this.removeAttribute('name');
+  }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const n = Number(raw);
+    return Number.isFinite(n) ? n : null;
+  }
+  set price(value) {
+    if (value === null || value === undefined || value === '') this.removeAttribute('price');
+    else this.setAttribute('price', String(value));
+  }
+
+  get currency() { return this.getAttribute('currency') || 'USD'; }
+  set currency(value) {
+    if (value) this.setAttribute('currency', value);
+    else this.removeAttribute('currency');
+  }
+
+  get badge() { return this.getAttribute('badge') ?? ''; }
+  set badge(value) {
+    if (value) this.setAttribute('badge', value);
+    else this.removeAttribute('badge');
+  }
+
+  get favorited() { return this.hasAttribute('favorited'); }
+  set favorited(on) { this.toggleAttribute('favorited', Boolean(on)); }
+
+  /* ---- Internals ---- */
+
+  /** Slotted children for a slot name, falling back to a light-DOM query if assignment hasn't run yet. */
+  #slotted(slot) {
+    const assigned = slot.assignedElements();
+    return assigned.length ? assigned : [...this.querySelectorAll(`:scope > [slot="${slot.name}"]`)];
+  }
+
+  #syncMedia() {
+    const hasMedia = this.#slotted(this.#mediaSlot).length > 0;
+    this.#article.classList.toggle('has-media', hasMedia);
+    setState(this.#internals, 'has-media', hasMedia);
+  }
+
+  #syncFavoriteLabel() {
+    const title = this.#slotted(this.#titleSlot)[0]?.textContent.trim();
+    const name = this.name || title || 'this item';
+    this.#favorite.setAttribute('aria-label', `Save ${name} to favorites`);
+  }
+
+  #syncFavorite() {
+    const on = this.favorited;
+    this.#favorite.setAttribute('aria-pressed', String(on));
+    setState(this.#internals, 'favorited', on);
+    if (this.id) {
+      const favorites = readFavorites();
+      if (favorites.has(this.id) !== on) {
+        if (on) favorites.add(this.id);
+        else favorites.delete(this.id);
+        writeFavorites(favorites);
+      }
+    }
+  }
+
+  #renderMeta() {
+    const price = this.price;
+    if (price === null) {
+      this.#price.hidden = true;
+    } else {
+      const lang = this.closest('[lang]')?.lang || document.documentElement.lang || undefined;
+      let text;
+      try {
+        text = new Intl.NumberFormat(lang, { style: 'currency', currency: this.currency }).format(price);
+      } catch {
+        text = `${this.currency} ${price.toFixed(2)}`;
+      }
+      this.#price.textContent = text;
+      this.#price.value = String(price);
+      this.#price.hidden = false;
+    }
+
+    const badge = this.badge;
+    this.#badge.textContent = badge;
+    this.#badge.hidden = !badge;
+
+    this.#meta.hidden = this.#price.hidden && this.#badge.hidden;
+  }
+}
+
+defineOnce('coffee-card', CoffeeCard);
