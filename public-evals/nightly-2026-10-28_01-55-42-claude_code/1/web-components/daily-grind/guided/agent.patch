+/**
+ * Small helpers shared by the Daily Grind components.
+ */
+
+/** cssText -> CSSStyleSheet, so every instance of a component shares one parsed sheet. */
+const sheetCache = new Map();
+
+/**
+ * Attach encapsulated CSS to a shadow root. Uses a shared constructable
+ * stylesheet when available and falls back to an inline <style> for engines
+ * without adoptedStyleSheets.
+ */
+export function adoptStyles(root, cssText) {
+  if ('adoptedStyleSheets' in root && typeof CSSStyleSheet === 'function') {
+    try {
+      let sheet = sheetCache.get(cssText);
+      if (!sheet) {
+        sheet = new CSSStyleSheet();
+        sheet.replaceSync(cssText);
+        sheetCache.set(cssText, sheet);
+      }
+      if (!root.adoptedStyleSheets.includes(sheet)) {
+        root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
+      }
+      return;
+    } catch {
+      /* fall through to <style> */
+    }
+  }
+  const style = document.createElement('style');
+  style.textContent = cssText;
+  root.prepend(style);
+}
+
+/**
+ * Create a shadow root and populate it from a template string, or reuse a
+ * Declarative Shadow DOM root if the server already rendered one (hydrating in
+ * place avoids a flash of re-rendered content).
+ */
+export function ensureShadow(host, html, cssText, init = { mode: 'open' }) {
+  let root = host.shadowRoot;
+  if (!root) {
+    root = host.attachShadow(init);
+    const template = document.createElement('template');
+    template.innerHTML = html;
+    root.append(template.content.cloneNode(true));
+  }
+  adoptStyles(root, cssText);
+  return root;
+}
+
+/** Register a custom element unless the tag name is already taken. */
+export function defineOnce(tagName, ctor) {
+  if (!customElements.get(tagName)) customElements.define(tagName, ctor);
+}
+
+/** Attach ElementInternals, returning null where the API is unavailable. */
+export function attachInternalsSafe(host) {
+  try {
+    return host.attachInternals();
+  } catch {
+    return null;
+  }
+}
+
+/** Toggle a custom state (matched with :state(name)) when CustomStateSet exists. */
+export function setState(internals, name, on) {
+  const states = internals?.states;
+  if (!states) return;
+  if (on) states.add(name);
+  else states.delete(name);
+}
+
+/** Find the element a URL fragment points at, if it lives inside `scope`. */
+export function fragmentTargetWithin(scope) {
+  const id = decodeURIComponent(location.hash.slice(1));
+  if (!id) return null;
+  if (scope.id === id) return scope;
+  return scope.querySelector(`#${CSS.escape(id)}`);
+}
