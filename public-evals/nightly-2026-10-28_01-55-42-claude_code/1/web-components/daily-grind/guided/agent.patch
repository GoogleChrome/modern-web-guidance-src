@@ -0,0 +1,212 @@
+/**
+ * <grind-disclosure> - a styled, groupable disclosure built on a native <details>.
+ *
+ *   <grind-disclosure group="faq" open>
+ *     <h3 slot="summary">Do you offer decaf?</h3>
+ *     <p>Yes, ...</p>
+ *   </grind-disclosure>
+ *
+ * The <details>/<summary> pair lives in the shadow tree, so the toggle is a
+ * real native control (keyboard, find-in-page auto-expand, screen reader
+ * "expanded/collapsed" announcements) while the question and answer stay in
+ * light DOM for search engines and heading structure.
+ *
+ * Attributes / properties:
+ *   open   boolean, reflected; mirrors the inner <details>
+ *   group  string; opening one disclosure closes the others with the same group.
+ *          (Unlike <details name>, this works across shadow roots.)
+ *
+ * Methods: show(), hide(), toggle(force?)
+ * Events:  toggle (bubbles; a ToggleEvent with oldState/newState where supported)
+ *
+ * Styling hooks:
+ *   --grind-disclosure-fg, --grind-disclosure-accent, --grind-disclosure-border,
+ *   --grind-disclosure-bg, --grind-disclosure-radius
+ *   ::part(details | summary | content), :state(open)
+ */
+import {
+  attachInternalsSafe,
+  defineOnce,
+  ensureShadow,
+  fragmentTargetWithin,
+  setState,
+} from './utils.js';
+
+const TEMPLATE = /* html */ `
+  <details part="details">
+    <summary part="summary">
+      <slot name="summary">Details</slot>
+      <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <path d="M6 9l6 6 6-6"/>
+      </svg>
+    </summary>
+    <div class="content" part="content"><slot></slot></div>
+  </details>
+`;
+
+const STYLES = /* css */ `
+  :host {
+    display: block;
+    --_fg: var(--grind-disclosure-fg, inherit);
+    --_accent: var(--grind-disclosure-accent, #ffab40);
+    --_border: var(--grind-disclosure-border, #d7ccc8);
+    --_bg: var(--grind-disclosure-bg, #fff);
+    --_radius: var(--grind-disclosure-radius, 8px);
+  }
+
+  :host([hidden]) { display: none; }
+
+  details {
+    background: var(--_bg);
+    border: 1px solid var(--_border);
+    border-radius: var(--_radius);
+    overflow: clip;
+    /* Lets block-size animate to "auto" in engines that support it. */
+    interpolate-size: allow-keywords;
+  }
+
+  summary {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    min-block-size: 44px;
+    padding: 1rem 1.25rem;
+    color: var(--_fg);
+    font-weight: 600;
+    list-style: none;
+    cursor: pointer;
+    transition: background-color 0.2s;
+  }
+
+  summary::-webkit-details-marker { display: none; }
+  summary::marker { content: ""; }
+
+  summary:hover { background: color-mix(in srgb, var(--_accent) 12%, transparent); }
+
+  summary:focus-visible {
+    outline: 2px solid var(--_accent);
+    outline-offset: -2px;
+  }
+
+  slot[name="summary"]::slotted(*) {
+    margin: 0;
+    font: inherit;
+  }
+
+  .chevron {
+    flex: none;
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+    transition: rotate 0.25s ease;
+  }
+
+  details[open] .chevron { rotate: 180deg; }
+
+  .content { padding: 0 1.25rem 1.25rem; }
+
+  /* Smooth open/close where ::details-content and interpolate-size exist;
+     other engines simply toggle instantly. */
+  details::details-content {
+    block-size: 0;
+    overflow: clip;
+    transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
+  }
+
+  details[open]::details-content { block-size: auto; }
+
+  @media (prefers-reduced-motion: reduce) {
+    summary,
+    .chevron,
+    details::details-content { transition: none; }
+  }
+`;
+
+export class GrindDisclosure extends HTMLElement {
+  static observedAttributes = ['open'];
+
+  #internals;
+  #details;
+  #onHashChange = () => this.#revealFragment();
+
+  constructor() {
+    super();
+    this.#internals = attachInternalsSafe(this);
+    const root = ensureShadow(this, TEMPLATE, STYLES);
+    this.#details = root.querySelector('details');
+    this.#details.addEventListener('toggle', () => this.#onDetailsToggle());
+  }
+
+  connectedCallback() {
+    this.#details.open = this.open;
+    setState(this.#internals, 'open', this.open);
+    window.addEventListener('hashchange', this.#onHashChange);
+    this.#revealFragment();
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('hashchange', this.#onHashChange);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'open' && oldValue !== newValue && this.#details.open !== this.open) {
+      this.#details.open = this.open;
+    }
+  }
+
+  /* ---- Public API ---- */
+
+  get open() { return this.hasAttribute('open'); }
+  set open(on) { this.toggleAttribute('open', Boolean(on)); }
+
+  get group() { return this.getAttribute('group') ?? ''; }
+  set group(value) {
+    if (value) this.setAttribute('group', value);
+    else this.removeAttribute('group');
+  }
+
+  show() { this.open = true; }
+  hide() { this.open = false; }
+  toggle(force) { this.open = force ?? !this.open; }
+
+  /* ---- Internals ---- */
+
+  #onDetailsToggle() {
+    const open = this.#details.open;
+    const oldState = open ? 'closed' : 'open';
+    if (this.open !== open) this.toggleAttribute('open', open);
+    setState(this.#internals, 'open', open);
+
+    if (open && this.group) this.#closeSiblings();
+
+    const event =
+      typeof ToggleEvent === 'function'
+        ? new ToggleEvent('toggle', { bubbles: true, oldState, newState: open ? 'open' : 'closed' })
+        : new Event('toggle', { bubbles: true });
+    this.dispatchEvent(event);
+  }
+
+  #closeSiblings() {
+    const root = this.getRootNode();
+    if (typeof root.querySelectorAll !== 'function') return;
+    for (const other of root.querySelectorAll('grind-disclosure[group]')) {
+      if (other !== this && other.group === this.group) other.open = false;
+    }
+  }
+
+  /** Open when the URL fragment points at this disclosure or something inside it. */
+  #revealFragment() {
+    const target = fragmentTargetWithin(this);
+    if (!target) return;
+    const wasClosed = !this.open;
+    this.open = true;
+    if (wasClosed) target.scrollIntoView({ block: 'start' });
+  }
+}
+
+defineOnce('grind-disclosure', GrindDisclosure);
