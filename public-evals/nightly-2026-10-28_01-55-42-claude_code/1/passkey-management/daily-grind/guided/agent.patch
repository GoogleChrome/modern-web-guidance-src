diff --git a/account/account.css b/account/account.css
new file mode 100644
index 0000000..fc58316
--- /dev/null
+++ b/account/account.css
@@ -0,0 +1,437 @@
+/* My Account page */
+
+.account-banner {
+  min-height: 34vh;
+  background: linear-gradient(rgba(62, 39, 35, 0.72), rgba(62, 39, 35, 0.72)),
+    url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1600&q=80');
+  background-size: cover;
+  background-position: center;
+  color: white;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  padding: 48px 5%;
+}
+
+.account-banner .eyebrow {
+  text-transform: uppercase;
+  letter-spacing: 2px;
+  font-size: 0.8rem;
+  color: var(--accent);
+}
+
+.account-banner h1 {
+  font-size: clamp(1.8rem, 4vw, 2.6rem);
+  margin: 4px 0;
+}
+
+.account-layout {
+  display: grid;
+  grid-template-columns: 220px minmax(0, 1fr);
+  gap: 32px;
+  align-items: start;
+}
+
+@media (max-width: 760px) {
+  .account-layout {
+    grid-template-columns: 1fr;
+  }
+}
+
+.account-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  position: sticky;
+  top: 90px;
+}
+
+.account-nav a {
+  color: var(--text);
+  text-decoration: none;
+  padding: 10px 14px;
+  border-radius: 6px;
+  font-size: 0.95rem;
+}
+
+.account-nav a:hover,
+.account-nav a:focus-visible {
+  background: var(--secondary);
+}
+
+@media (max-width: 760px) {
+  .account-nav {
+    position: static;
+    flex-direction: row;
+    flex-wrap: wrap;
+  }
+}
+
+.account-content {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+}
+
+.panel {
+  background: white;
+  border-radius: 10px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
+  padding: 28px;
+}
+
+.panel--muted {
+  background: #fff8f0;
+  box-shadow: none;
+  border: 1px solid #f3e3cc;
+}
+
+.panel h2 {
+  color: var(--primary);
+  font-size: 1.35rem;
+  margin-bottom: 4px;
+}
+
+.panel h2:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 4px;
+}
+
+.panel-header {
+  margin-bottom: 20px;
+}
+
+.panel-header p {
+  color: var(--muted);
+  font-size: 0.95rem;
+  max-width: 60ch;
+}
+
+.panel-header--split {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: 20px;
+  flex-wrap: wrap;
+}
+
+.panel-header--split .btn {
+  margin-top: 0;
+  flex-shrink: 0;
+}
+
+/* Buttons */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.btn:disabled {
+  opacity: 0.6;
+  cursor: progress;
+}
+
+.btn--accent {
+  background: var(--accent);
+  color: var(--text);
+  font-weight: 600;
+}
+
+.btn--accent:hover {
+  background: #ff9800;
+}
+
+.btn--ghost {
+  background: transparent;
+  color: var(--primary);
+  border: 1px solid var(--border);
+}
+
+.btn--ghost:hover {
+  background: var(--light);
+}
+
+.btn--danger {
+  background: var(--danger);
+}
+
+.btn--danger:hover {
+  background: #8c1d18;
+}
+
+.btn-link {
+  background: none;
+  border: 0;
+  font: inherit;
+  font-size: 0.9rem;
+  color: var(--primary);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  cursor: pointer;
+  padding: 6px 8px;
+  border-radius: 4px;
+}
+
+.btn-link:hover,
+.btn-link:focus-visible {
+  background: var(--light);
+}
+
+.btn-link--danger {
+  color: var(--danger);
+}
+
+/* Forms */
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin-bottom: 16px;
+}
+
+.field label {
+  font-weight: 600;
+  font-size: 0.9rem;
+}
+
+.field input {
+  font: inherit;
+  padding: 10px 12px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: white;
+  color: var(--text);
+}
+
+.field input:read-only {
+  background: #f5f1ef;
+  color: var(--muted);
+}
+
+.field input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.field input:user-invalid {
+  border-color: var(--danger);
+}
+
+.field-error {
+  color: var(--danger);
+  font-size: 0.85rem;
+  min-height: 1.3em;
+}
+
+.profile-form {
+  max-width: 440px;
+}
+
+.form-actions .btn {
+  margin-top: 4px;
+}
+
+/* Status messages */
+.status {
+  margin-top: 14px;
+  padding: 10px 14px;
+  border-radius: 6px;
+  font-size: 0.92rem;
+  background: #eef3f8;
+  border-left: 4px solid #5c7fa3;
+}
+
+.status[data-tone="success"] {
+  background: #edf7ee;
+  border-left-color: var(--success);
+}
+
+.status[data-tone="error"] {
+  background: #fbeeed;
+  border-left-color: var(--danger);
+}
+
+.note {
+  font-size: 0.9rem;
+  color: var(--muted);
+  background: #fff8f0;
+  border: 1px dashed #e4c9a5;
+  border-radius: 6px;
+  padding: 10px 14px;
+  margin-bottom: 16px;
+}
+
+/* Passkey list */
+.passkey-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin-top: 8px;
+}
+
+.passkey-list[aria-busy="true"]::after {
+  content: 'Loading your passkeys…';
+  display: block;
+  color: var(--muted);
+  padding: 20px 0;
+}
+
+.passkey-row {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  gap: 16px;
+  align-items: center;
+  padding: 16px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--light);
+}
+
+@media (max-width: 560px) {
+  .passkey-row {
+    grid-template-columns: auto minmax(0, 1fr);
+  }
+
+  .passkey-actions {
+    grid-column: 2;
+  }
+}
+
+.passkey-icon {
+  width: 44px;
+  height: 44px;
+  border-radius: 10px;
+  background: white;
+  border: 1px solid var(--border);
+  display: grid;
+  place-items: center;
+  color: var(--primary);
+  overflow: hidden;
+}
+
+.passkey-icon img {
+  width: 32px;
+  height: 32px;
+  object-fit: contain;
+}
+
+.passkey-title {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+
+.passkey-name {
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+
+.passkey-badge {
+  font-size: 0.72rem;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+  padding: 2px 8px;
+  border-radius: 999px;
+  background: var(--secondary);
+  color: var(--text);
+}
+
+.passkey-provider,
+.passkey-meta {
+  font-size: 0.85rem;
+  color: var(--muted);
+}
+
+.passkey-meta {
+  display: flex;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 4px;
+}
+
+.empty-state {
+  text-align: center;
+  padding: 36px 20px;
+  color: var(--muted);
+  border: 1px dashed var(--border);
+  border-radius: 8px;
+}
+
+.empty-state h3 {
+  color: var(--primary);
+  margin: 8px 0 4px;
+}
+
+.tips {
+  padding-left: 20px;
+  color: var(--muted);
+  font-size: 0.93rem;
+}
+
+.tips li+li {
+  margin-top: 6px;
+}
+
+/* Dialogs */
+dialog {
+  border: 0;
+  border-radius: 12px;
+  padding: 0;
+  max-width: min(92vw, 440px);
+  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+}
+
+dialog form {
+  padding: 28px;
+}
+
+dialog h2 {
+  color: var(--primary);
+  font-size: 1.25rem;
+  margin-bottom: 8px;
+}
+
+dialog p {
+  color: var(--muted);
+  font-size: 0.95rem;
+  margin-bottom: 16px;
+}
+
+dialog .field {
+  margin-bottom: 8px;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 8px;
+}
+
+.dialog-actions--reverse {
+  flex-direction: row-reverse;
+  justify-content: flex-start;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+}
+
+/* Keep scroll gestures inside the modal from scrolling the page behind it. */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background: rgba(62, 39, 35, 0.55);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
diff --git a/account/api.js b/account/api.js
new file mode 100644
index 0000000..458f757
--- /dev/null
+++ b/account/api.js
@@ -0,0 +1,80 @@
+/**
+ * HTTP client for the account / passkey endpoints.
+ *
+ * Every method resolves with parsed JSON or rejects with an ApiError carrying
+ * the HTTP status. The shape mirrors the backend contract expected by
+ * passkeys.js; local-store.js implements the same interface in the browser for
+ * the static demo build.
+ *
+ *   GET    /api/user                          -> { id, name, displayName, rpId? }
+ *   PUT    /api/user                          <- { name, displayName }
+ *   GET    /api/credentials                   -> StoredPasskeyCredential[]
+ *   PUT    /api/credential/:id                <- { name }
+ *   DELETE /api/credential/:id
+ *   POST   /api/passkeys/register/options     -> PublicKeyCredentialCreationOptionsJSON
+ *   POST   /api/passkeys/register/verify      <- RegistrationResponseJSON
+ */
+
+export class ApiError extends Error {
+  constructor(message, { status = 0, contentType = '' } = {}) {
+    super(message);
+    this.name = 'ApiError';
+    this.status = status;
+    this.contentType = contentType;
+  }
+}
+
+async function request(url, { method = 'GET', body } = {}) {
+  let response;
+  try {
+    response = await fetch(url, {
+      method,
+      credentials: 'same-origin',
+      headers: {
+        Accept: 'application/json',
+        ...(body !== undefined && { 'Content-Type': 'application/json' }),
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch (err) {
+    throw new ApiError(`Network error calling ${method} ${url}: ${err.message}`);
+  }
+
+  const contentType = response.headers.get('content-type') || '';
+  if (!response.ok) {
+    let detail = '';
+    if (contentType.includes('application/json')) {
+      detail = (await response.json().catch(() => ({})))?.error || '';
+    }
+    throw new ApiError(detail || `${method} ${url} failed with ${response.status}`, {
+      status: response.status,
+      contentType,
+    });
+  }
+  if (response.status === 204) return null;
+  if (!contentType.includes("application/json")) {
+    // A static host serving index.html for unknown routes, or a proxy error page.
+    throw new ApiError(`${method} ${url} returned ${contentType || "an unknown content type"} instead of JSON`, {
+      status: response.status,
+      contentType,
+    });
+  }
+  return response.json();
+}
+
+export function createRemoteApi(base = '') {
+  return {
+    kind: 'remote',
+    getUser: () => request(`${base}/api/user`),
+    updateUser: (fields) => request(`${base}/api/user`, { method: 'PUT', body: fields }),
+    listCredentials: () => request(`${base}/api/credentials`),
+    renameCredential: (id, name) =>
+      request(`${base}/api/credential/${encodeURIComponent(id)}`, { method: 'PUT', body: { name } }),
+    deleteCredential: (id) =>
+      request(`${base}/api/credential/${encodeURIComponent(id)}`, { method: 'DELETE' }),
+    registrationOptions: () =>
+      request(`${base}/api/passkeys/register/options`, { method: 'POST', body: { promotion: false } }),
+    verifyRegistration: (registrationResponse) =>
+      request(`${base}/api/passkeys/register/verify`, { method: 'POST', body: registrationResponse }),
+  };
+}
