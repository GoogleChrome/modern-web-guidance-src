+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/css/site.css">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account/" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="page-header">
+    <div class="container">
+      <h1>My Account</h1>
+      <p>Manage your profile and how you sign in.</p>
+    </div>
+  </header>
+
+  <main class="container account-layout">
+    <aside class="account-nav" aria-label="Account sections">
+      <ul>
+        <li><a href="#profile">Profile</a></li>
+        <li><a href="#passkeys" aria-current="page">Sign-in &amp; security</a></li>
+        <li><a href="/orders">Order history</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+      </ul>
+    </aside>
+
+    <div class="account-content">
+      <section class="panel" id="profile" aria-labelledby="profile-heading">
+        <h2 id="profile-heading">Profile</h2>
+        <dl class="profile-details">
+          <div>
+            <dt>Name</dt>
+            <dd data-field="displayName">…</dd>
+          </div>
+          <div>
+            <dt>Email</dt>
+            <dd data-field="name">…</dd>
+          </div>
+          <div>
+            <dt>Member since</dt>
+            <dd data-field="memberSince">…</dd>
+          </div>
+        </dl>
+      </section>
+
+      <section class="panel" id="passkeys" aria-labelledby="passkeys-heading">
+        <div class="panel-header">
+          <div>
+            <h2 id="passkeys-heading">Passkeys</h2>
+            <p class="panel-subtitle">Sign in with your face, fingerprint, or device PIN. No password needed.</p>
+          </div>
+          <button type="button" class="btn" id="add-passkey">Add a passkey</button>
+        </div>
+
+        <div id="support-notice" class="notice notice-warn" hidden></div>
+        <div id="passkey-notice" class="notice" role="status" aria-live="polite" hidden></div>
+
+        <ul class="passkey-list" id="passkey-list" aria-label="Your passkeys" aria-busy="true"></ul>
+
+        <div class="empty-state" id="passkey-empty" hidden>
+          <h3>No passkeys yet</h3>
+          <p>Add one to sign in faster and more securely on this device.</p>
+          <button type="button" class="btn" id="add-passkey-empty">Add a passkey</button>
+        </div>
+
+        <p class="panel-footnote" id="sync-footnote"></p>
+      </section>
+    </div>
+  </main>
+
+  <dialog id="delete-dialog" aria-labelledby="delete-title" aria-describedby="delete-message">
+    <form method="dialog">
+      <h3 id="delete-title">Delete this passkey?</h3>
+      <p id="delete-message"></p>
+      <p class="notice notice-warn" id="delete-last-warning" hidden>
+        This is the only passkey on your account. Without it you will need another way to sign in.
+      </p>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn btn-secondary">Cancel</button>
+        <button type="submit" value="confirm" class="btn btn-danger-solid">Delete passkey</button>
+      </div>
+    </form>
+  </dialog>
+
+  <template id="passkey-item-template">
+    <li class="passkey">
+      <div class="passkey-icon" aria-hidden="true">
+        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
+          <circle cx="8" cy="12" r="4.5"></circle>
+          <path d="M12.5 12H21"></path>
+          <path d="M18 12v3"></path>
+          <path d="M21 12v2"></path>
+        </svg>
+      </div>
+      <div class="passkey-body">
+        <div class="passkey-title">
+          <span class="passkey-name"></span>
+          <span class="badge badge-synced" data-badge="synced" hidden title="Backed up by your passkey provider and available on your other devices">Synced</span>
+          <span class="badge" data-badge="device" hidden title="Stored only on the device where it was created">This device only</span>
+          <span class="badge" data-badge="security-key" hidden title="Stored on a hardware security key">Security key</span>
+        </div>
+        <div class="passkey-meta">
+          <span class="passkey-provider"></span>
+          <span class="passkey-created"></span>
+          <span class="passkey-used"></span>
+        </div>
+        <form class="rename-form" hidden>
+          <label class="sr-only">New name for this passkey</label>
+          <input type="text" name="name" maxlength="64" required autocomplete="off">
+          <button type="submit" class="btn btn-sm">Save</button>
+          <button type="button" class="btn btn-sm btn-secondary" data-action="cancel-rename">Cancel</button>
+          <p class="form-error" role="alert" hidden></p>
+          <p class="form-hint">Nicknames are kept on your Daily Grind account. Your passkey provider lists the passkey under your account name.</p>
+        </form>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn btn-sm btn-secondary" data-action="rename">Rename</button>
+        <button type="button" class="btn btn-sm btn-danger" data-action="delete">Delete</button>
+      </div>
+    </li>
+  </template>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script type="module" src="/assets/js/passkeys.js"></script>
+
+</body>
+
+</html>
