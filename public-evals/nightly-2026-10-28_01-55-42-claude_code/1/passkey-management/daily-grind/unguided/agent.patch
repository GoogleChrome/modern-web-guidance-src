+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --muted: #6d4c41;
+  --danger: #b3261e;
+  --success: #2e7d32;
+  --border: #e7dfdc;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
