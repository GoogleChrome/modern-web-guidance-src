+
+[hidden] {
+  display: none !important;
+}
+
+@media (max-width: 760px) {
+  .account-layout {
+    grid-template-columns: 1fr;
+  }
+
+  .passkey {
+    grid-template-columns: auto minmax(0, 1fr);
+  }
+
+  .passkey-actions {
+    grid-column: 2;
+    justify-content: flex-start;
+  }
+}
diff --git a/assets/js/passkey-store.js b/assets/js/passkey-store.js
new file mode 100644
index 0000000..fa23e93
--- /dev/null
+++ b/assets/js/passkey-store.js
@@ -0,0 +1,126 @@
+/**
+ * Account data layer for the "My Account" pages.
+ *
+ * The Daily Grind site is served statically, so this module stands in for the
+ * account API. Every method is async and returns plain objects, which keeps the
+ * UI identical whether the data comes from here or from real endpoints such as
+ *   GET    /api/account/passkeys
+ *   POST   /api/account/passkeys        (server verifies the attestation + challenge)
+ *   PATCH  /api/account/passkeys/:id    { name }
+ *   DELETE /api/account/passkeys/:id
+ * Swap the bodies below for fetch() calls and nothing else needs to change.
+ *
+ * Records are kept in localStorage under STORAGE_KEY.
+ */
+
+import { bufferToBase64Url, randomBytes } from './webauthn.js';
+
+const STORAGE_KEY = 'dailygrind.account.v1';
+const LATENCY_MS = 120; // small delay so loading states behave like a network round-trip
+export const MAX_NAME_LENGTH = 64;
+
+function createDefaultAccount() {
+  return {
+    user: {
+      // Opaque, stable user handle (WebAuthn user.id). Never personal data.
+      id: bufferToBase64Url(randomBytes(16)),
+      name: 'sam.rivera@example.com',
+      displayName: 'Sam Rivera',
+      memberSince: '2024-03-12',
+    },
+    passkeys: [],
+  };
+}
+
+function load() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      if (parsed && parsed.user && Array.isArray(parsed.passkeys)) return parsed;
+    }
+  } catch (error) {
+    console.warn('Account store was unreadable; starting fresh', error);
+  }
+  const account = createDefaultAccount();
+  save(account);
+  return account;
+}
+
+function save(account) {
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(account));
+}
+
+const wait = () => new Promise((resolve) => setTimeout(resolve, LATENCY_MS));
+const clone = (value) => JSON.parse(JSON.stringify(value));
+
+export class PasskeyStoreError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.name = 'PasskeyStoreError';
+    this.code = code;
+  }
+}
+
+export function normaliseName(name) {
+  const trimmed = String(name ?? '').replace(/\s+/g, ' ').trim();
+  if (!trimmed) throw new PasskeyStoreError('empty-name', 'Give the passkey a name.');
+  if (trimmed.length > MAX_NAME_LENGTH) {
+    throw new PasskeyStoreError('name-too-long', `Names can be at most ${MAX_NAME_LENGTH} characters.`);
+  }
+  return trimmed;
+}
+
+export const accountApi = {
+  async getCurrentUser() {
+    await wait();
+    return clone(load().user);
+  },
+
+  async listPasskeys() {
+    await wait();
+    return clone(load().passkeys);
+  },
+
+  async addPasskey(passkey) {
+    await wait();
+    const account = load();
+    if (account.passkeys.some((p) => p.id === passkey.id)) {
+      throw new PasskeyStoreError('duplicate', 'That passkey is already on your account.');
+    }
+    const record = { ...clone(passkey), name: normaliseName(passkey.name) };
+    account.passkeys.push(record);
+    save(account);
+    return clone(record);
+  },
+
+  async renamePasskey(id, name) {
+    await wait();
+    const account = load();
+    const record = account.passkeys.find((p) => p.id === id);
+    if (!record) throw new PasskeyStoreError('not-found', 'That passkey no longer exists.');
+    record.name = normaliseName(name);
+    save(account);
+    return clone(record);
+  },
+
+  async deletePasskey(id) {
+    await wait();
+    const account = load();
+    const before = account.passkeys.length;
+    account.passkeys = account.passkeys.filter((p) => p.id !== id);
+    if (account.passkeys.length === before) {
+      throw new PasskeyStoreError('not-found', 'That passkey no longer exists.');
+    }
+    save(account);
+  },
+
+  /** Notify when another tab changes the account (mirrors a server push / refetch). */
+  onChange(callback) {
+    const handler = (event) => {
+      if (event.key === STORAGE_KEY) callback();
+    };
+    window.addEventListener('storage', handler);
+    return () => window.removeEventListener('storage', handler);
+  },
+};
diff --git a/assets/js/passkeys.js b/assets/js/passkeys.js
new file mode 100644
index 0000000..b6de531
--- /dev/null
+++ b/assets/js/passkeys.js
@@ -0,0 +1,498 @@
+/**
+ * Passkey management UI for /account/.
+ *
+ * Responsibilities:
+ *  - list the passkeys on the signed-in customer's account,
+ *  - register a new passkey (so there is something to manage),
+ *  - rename passkeys (nickname is stored on the account),
+ *  - delete passkeys, and keep the browser / password manager in sync through
+ *    the WebAuthn Signal API:
+ *      * signalAllAcceptedCredentials on load and after every change, so the
+ *        authenticator drops passkeys the account no longer accepts (for
+ *        example ones deleted from another device);
+ *      * signalUnknownCredential right after a delete, so the just-removed
+ *        passkey disappears from the provider immediately.
+ */
+
+import { accountApi, PasskeyStoreError, MAX_NAME_LENGTH } from './passkey-store.js';
+import {
+  base64UrlToBuffer,
+  bufferToBase64Url,
+  parseAuthenticatorData,
+  providerName,
+  randomBytes,
+  rpId,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  signalSupport,
+  signalUnknownCredential,
+} from './webauthn.js';
+
+const RP_NAME = 'The Daily Grind';
+
+const els = {
+  profile: document.getElementById('profile'),
+  addButton: document.getElementById('add-passkey'),
+  addButtonEmpty: document.getElementById('add-passkey-empty'),
+  list: document.getElementById('passkey-list'),
+  empty: document.getElementById('passkey-empty'),
+  notice: document.getElementById('passkey-notice'),
+  supportNotice: document.getElementById('support-notice'),
+  footnote: document.getElementById('sync-footnote'),
+  template: document.getElementById('passkey-item-template'),
+  dialog: document.getElementById('delete-dialog'),
+  dialogMessage: document.getElementById('delete-message'),
+  dialogLastWarning: document.getElementById('delete-last-warning'),
+};
+
+const state = {
+  user: null,
+  passkeys: [],
+  busy: false,
+  canRegister: false,
+};
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+const dateTimeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+init();
+
+async function init() {
+  detectSupport();
+  els.addButton.addEventListener('click', handleAdd);
+  els.addButtonEmpty.addEventListener('click', handleAdd);
+
+  try {
+    const [user, passkeys] = await Promise.all([accountApi.getCurrentUser(), accountApi.listPasskeys()]);
+    state.user = user;
+    state.passkeys = passkeys;
+  } catch (error) {
+    console.error(error);
+    els.list.setAttribute('aria-busy', 'false');
+    showNotice('error', 'We could not load your passkeys. Refresh the page to try again.');
+    return;
+  }
+
+  renderProfile();
+  renderPasskeys();
+  syncAuthenticator();
+
+  // Another tab (or, with a real backend, a server push) changed the account.
+  accountApi.onChange(async () => {
+    try {
+      state.passkeys = await accountApi.listPasskeys();
+      renderPasskeys();
+      syncAuthenticator();
+    } catch (error) {
+      console.error(error);
+    }
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Capability detection                                                */
+/* ------------------------------------------------------------------ */
+
+function detectSupport() {
+  const hasWebAuthn = typeof globalThis.PublicKeyCredential === 'function';
+  const support = signalSupport();
+
+  if (!window.isSecureContext) {
+    showSupportNotice('Passkeys only work over a secure (HTTPS) connection. You can still review and delete the passkeys on your account, but adding one is disabled here.');
+  } else if (!hasWebAuthn) {
+    showSupportNotice('This browser does not support passkeys. You can still review and delete the passkeys on your account from here.');
+  } else {
+    state.canRegister = true;
+  }
+
+  if (!state.canRegister) {
+    els.addButton.disabled = true;
+    els.addButtonEmpty.disabled = true;
+  }
+
+  if (support.unknownCredential && support.allAcceptedCredentials) {
+    els.footnote.textContent = 'When you delete a passkey here, we also ask your browser or password manager to remove its copy, so the two stay in sync.';
+  } else {
+    els.footnote.textContent = 'This browser cannot automatically remove deleted passkeys from your password manager. After deleting a passkey here, delete it from your password manager as well.';
+  }
+}
+
+function showSupportNotice(message) {
+  els.supportNotice.textContent = message;
+  els.supportNotice.hidden = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+function renderProfile() {
+  const { displayName, name, memberSince } = state.user;
+  setField('displayName', displayName);
+  setField('name', name);
+  setField('memberSince', memberSince ? dateFormat.format(new Date(memberSince)) : '');
+}
+
+function setField(field, value) {
+  const target = els.profile.querySelector(`[data-field="${field}"]`);
+  if (target) target.textContent = value || '—';
+}
+
+function renderPasskeys() {
+  els.list.replaceChildren();
+  els.list.setAttribute('aria-busy', 'false');
+
+  const sorted = [...state.passkeys].sort((a, b) => (b.createdAt ?? '').localeCompare(a.createdAt ?? ''));
+  for (const passkey of sorted) {
+    els.list.append(renderPasskeyItem(passkey));
+  }
+
+  const isEmpty = sorted.length === 0;
+  els.empty.hidden = !isEmpty;
+  els.list.hidden = isEmpty;
+}
+
+function renderPasskeyItem(passkey) {
+  const fragment = els.template.content.cloneNode(true);
+  const item = fragment.querySelector('.passkey');
+  item.dataset.id = passkey.id;
+
+  item.querySelector('.passkey-name').textContent = passkey.name;
+
+  const badge = (key) => item.querySelector(`[data-badge="${key}"]`);
+  if (passkey.backedUp) {
+    badge('synced').hidden = false;
+  } else if (passkey.attachment === 'cross-platform' && !passkey.backupEligible) {
+    badge('security-key').hidden = false;
+  } else if (passkey.backupEligible === false) {
+    badge('device').hidden = false;
+  }
+
+  item.querySelector('.passkey-provider').textContent = passkey.provider || 'Passkey provider not identified';
+  item.querySelector('.passkey-created').textContent = passkey.createdAt
+    ? `Added ${dateFormat.format(new Date(passkey.createdAt))}`
+    : 'Added date unknown';
+  item.querySelector('.passkey-used').textContent = passkey.lastUsedAt
+    ? `Last used ${dateTimeFormat.format(new Date(passkey.lastUsedAt))}`
+    : 'Not used yet';
+
+  const renameButton = item.querySelector('[data-action="rename"]');
+  const deleteButton = item.querySelector('[data-action="delete"]');
+  const actions = item.querySelector('.passkey-actions');
+  const form = item.querySelector('.rename-form');
+  const input = form.querySelector('input[name="name"]');
+  const formError = form.querySelector('.form-error');
+  const label = form.querySelector('label');
+
+  const inputId = `rename-${cssSafe(passkey.id)}`;
+  input.id = inputId;
+  label.htmlFor = inputId;
+  input.maxLength = MAX_NAME_LENGTH;
+
+  renameButton.setAttribute('aria-label', `Rename passkey ${passkey.name}`);
+  deleteButton.setAttribute('aria-label', `Delete passkey ${passkey.name}`);
+
+  const closeRename = () => {
+    form.hidden = true;
+    formError.hidden = true;
+    actions.hidden = false;
+    renameButton.focus();
+  };
+
+  renameButton.addEventListener('click', () => {
+    input.value = passkey.name;
+    form.hidden = false;
+    actions.hidden = true;
+    input.focus();
+    input.select();
+  });
+
+  form.querySelector('[data-action="cancel-rename"]').addEventListener('click', closeRename);
+  input.addEventListener('keydown', (event) => {
+    if (event.key === 'Escape') {
+      event.preventDefault();
+      closeRename();
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const nextName = input.value.replace(/\s+/g, ' ').trim();
+    if (nextName === passkey.name) {
+      closeRename();
+      return;
+    }
+    const submit = form.querySelector('button[type="submit"]');
+    submit.disabled = true;
+    formError.hidden = true;
+    try {
+      const updated = await accountApi.renamePasskey(passkey.id, nextName);
+      replaceInState(updated);
+      renderPasskeys();
+      showNotice('success', `Renamed to “${updated.name}”.`);
+      focusActionFor(updated.id, 'rename');
+    } catch (error) {
+      formError.textContent = error instanceof PasskeyStoreError
+        ? error.message
+        : 'We could not rename that passkey. Please try again.';
+      formError.hidden = false;
+      input.focus();
+      if (!(error instanceof PasskeyStoreError)) console.error(error);
+    } finally {
+      submit.disabled = false;
+    }
+  });
+
+  deleteButton.addEventListener('click', () => handleDelete(passkey));
+
+  return fragment;
+}
+
+function replaceInState(updated) {
+  state.passkeys = state.passkeys.map((p) => (p.id === updated.id ? updated : p));
+}
+
+function focusActionFor(id, action) {
+  const item = [...els.list.children].find((li) => li.dataset.id === id);
+  item?.querySelector(`[data-action="${action}"]`)?.focus();
+}
+
+function cssSafe(value) {
+  return value.replace(/[^a-zA-Z0-9_-]/g, '_');
+}
+
+/* ------------------------------------------------------------------ */
+/* Add                                                                 */
+/* ------------------------------------------------------------------ */
+
+async function handleAdd() {
+  if (state.busy || !state.canRegister || !state.user) return;
+  setBusy(true);
+  clearNotice();
+
+  try {
+    const credential = await navigator.credentials.create({
+      publicKey: {
+        // With a real backend the challenge is issued by the server and the
+        // attestation response is verified there before the passkey is stored.
+        challenge: randomBytes(32),
+        rp: { id: rpId(), name: RP_NAME },
+        user: {
+          id: base64UrlToBuffer(state.user.id),
+          name: state.user.name,
+          displayName: state.user.displayName,
+        },
+        pubKeyCredParams: [
+          { type: 'public-key', alg: -7 }, // ES256
+          { type: 'public-key', alg: -257 }, // RS256
+        ],
+        authenticatorSelection: {
+          residentKey: 'required',
+          userVerification: 'preferred',
+        },
+        // Stops the same authenticator registering a second passkey for this account.
+        excludeCredentials: state.passkeys.map((p) => ({
+          type: 'public-key',
+          id: base64UrlToBuffer(p.id),
+          transports: p.transports?.length ? p.transports : undefined,
+        })),
+        attestation: 'none',
+        timeout: 120_000,
+      },
+    });
+
+    const record = describeCredential(credential);
+    record.name = uniqueName(defaultName(record));
+
+    const saved = await accountApi.addPasskey(record);
+    state.passkeys.push(saved);
+    renderPasskeys();
+    syncAuthenticator();
+    showNotice('success', `Added “${saved.name}”. Rename it to something you will recognise later, like “Work laptop”.`);
+    focusActionFor(saved.id, 'rename');
+  } catch (error) {
+    showNotice('error', describeCreateError(error));
+    if (!(error instanceof DOMException && error.name === 'NotAllowedError')) console.error(error);
+  } finally {
+    setBusy(false);
+  }
+}
+
+/** Turn a PublicKeyCredential into the plain record the account stores. */
+function describeCredential(credential) {
+  const response = credential.response;
+  let authData = {};
+  if (typeof response.getAuthenticatorData === 'function') {
+    try {
+      authData = parseAuthenticatorData(response.getAuthenticatorData());
+    } catch (error) {
+      console.warn('Could not parse authenticator data', error);
+    }
+  }
+  const transports = typeof response.getTransports === 'function' ? response.getTransports() : [];
+  const publicKey = typeof response.getPublicKey === 'function' ? response.getPublicKey() : null;
+
+  return {
+    id: credential.id, // base64url, as the spec defines PublicKeyCredential.id
+    aaguid: authData.aaguid ?? null,
+    provider: providerName(authData.aaguid),
+    transports,
+    attachment: credential.authenticatorAttachment ?? null,
+    backupEligible: authData.backupEligible ?? null,
+    backedUp: authData.backedUp ?? null,
+    publicKey: publicKey ? bufferToBase64Url(publicKey) : null,
+    publicKeyAlgorithm: typeof response.getPublicKeyAlgorithm === 'function' ? response.getPublicKeyAlgorithm() : null,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+}
+
+function defaultName(record) {
+  if (record.provider) return record.provider;
+  if (record.attachment === 'cross-platform') return 'Security key';
+  return `Passkey on ${platformLabel()}`;
+}
+
+function platformLabel() {
+  const hint = navigator.userAgentData?.platform || navigator.platform || '';
+  const ua = navigator.userAgent || '';
+  if (/iPhone/i.test(ua)) return 'iPhone';
+  if (/iPad/i.test(ua) || (/Mac/i.test(hint) && navigator.maxTouchPoints > 1)) return 'iPad';
+  if (/Android/i.test(ua) || /Android/i.test(hint)) return 'Android';
+  if (/Win/i.test(hint)) return 'Windows';
+  if (/Mac/i.test(hint)) return 'Mac';
+  if (/CrOS/i.test(ua)) return 'Chromebook';
+  if (/Linux/i.test(hint)) return 'Linux';
+  return 'this device';
+}
+
+function uniqueName(base) {
+  const taken = new Set(state.passkeys.map((p) => p.name.toLowerCase()));
+  if (!taken.has(base.toLowerCase())) return base;
+  let n = 2;
+  while (taken.has(`${base} (${n})`.toLowerCase())) n += 1;
+  return `${base} (${n})`;
+}
+
+function describeCreateError(error) {
+  if (error instanceof PasskeyStoreError) return error.message;
+  switch (error?.name) {
+    case 'NotAllowedError':
+      return 'Passkey setup was cancelled or timed out. Nothing was changed.';
+    case 'InvalidStateError':
+      return 'This device or password manager already holds a passkey for your account. Use that one, or delete it first.';
+    case 'SecurityError':
+      return 'Passkeys can only be created over HTTPS on the Daily Grind site.';
+    case 'NotSupportedError':
+      return 'This browser or device cannot create the kind of passkey we need.';
+    case 'ConstraintError':
+      return 'Your device could not meet the security requirements for a passkey.';
+    default:
+      return 'Something went wrong while creating your passkey. Please try again.';
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Delete                                                              */
+/* ------------------------------------------------------------------ */
+
+async function handleDelete(passkey) {
+  if (state.busy) return;
+
+  els.dialogMessage.textContent = `“${passkey.name}” will no longer sign you in to The Daily Grind.`;
+  els.dialogLastWarning.hidden = state.passkeys.length > 1;
+
+  const choice = await confirmDialog();
+  if (choice !== 'confirm') {
+    focusActionFor(passkey.id, 'delete');
+    return;
+  }
+
+  setBusy(true);
+  clearNotice();
+  try {
+    await accountApi.deletePasskey(passkey.id);
+    state.passkeys = state.passkeys.filter((p) => p.id !== passkey.id);
+    renderPasskeys();
+
+    // 1. Tell the authenticator this exact credential is gone.
+    const signalled = await signalUnknownCredential(passkey.id);
+    // 2. Re-send the full accepted list so anything else stale is pruned too.
+    await syncAuthenticator();
+
+    showNotice(
+      'success',
+      signalled
+        ? `Deleted “${passkey.name}”. Your browser or password manager has been asked to remove its copy too.`
+        : `Deleted “${passkey.name}” from your account. This browser could not remove it from your password manager automatically, so delete it there as well.`,
+    );
+  } catch (error) {
+    console.error(error);
+    showNotice('error', error instanceof PasskeyStoreError
+      ? error.message
+      : 'We could not delete that passkey. Please try again.');
+    if (error instanceof PasskeyStoreError && error.code === 'not-found') {
+      state.passkeys = state.passkeys.filter((p) => p.id !== passkey.id);
+      renderPasskeys();
+    }
+  } finally {
+    setBusy(false);
+    (state.passkeys.length ? els.addButton : els.addButtonEmpty).focus();
+  }
+}
+
+function confirmDialog() {
+  const { dialog } = els;
+  if (typeof dialog.showModal !== 'function') {
+    return Promise.resolve(window.confirm(els.dialogMessage.textContent) ? 'confirm' : 'cancel');
+  }
+  return new Promise((resolve) => {
+    dialog.returnValue = '';
+    dialog.addEventListener('close', () => resolve(dialog.returnValue || 'cancel'), { once: true });
+    dialog.showModal();
+    dialog.querySelector('button[value="cancel"]').focus();
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticator sync                                                  */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Push the account's current view of the world to the browser / password
+ * manager: the accepted credential list and the user's display details.
+ */
+async function syncAuthenticator() {
+  if (!state.user) return;
+  const ids = state.passkeys.map((p) => p.id);
+  await Promise.all([
+    signalAllAcceptedCredentials(state.user.id, ids),
+    ids.length ? signalCurrentUserDetails(state.user.id, state.user.name, state.user.displayName) : Promise.resolve(false),
+  ]);
+}
+
+/* ------------------------------------------------------------------ */
+/* Small UI helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+function setBusy(busy) {
+  state.busy = busy;
+  for (const button of [els.addButton, els.addButtonEmpty]) {
+    button.disabled = busy || !state.canRegister;
+    button.textContent = busy ? 'Waiting for your device…' : 'Add a passkey';
+  }
+  for (const button of els.list.querySelectorAll('.passkey-actions button')) {
+    button.disabled = busy;
+  }
+}
+
+function showNotice(type, message) {
+  els.notice.className = `notice${type === 'info' ? '' : ` notice-${type}`}`;
+  els.notice.textContent = message;
+  els.notice.hidden = false;
+}
+
+function clearNotice() {
+  els.notice.hidden = true;
+  els.notice.textContent = '';
+}
diff --git a/assets/js/webauthn.js b/assets/js/webauthn.js
new file mode 100644
index 0000000..2dc6a8b
--- /dev/null
+++ b/assets/js/webauthn.js
@@ -0,0 +1,165 @@
+/**
+ * WebAuthn helpers shared by the account pages.
+ *
+ * Covers the three things the passkey UI needs beyond navigator.credentials:
+ *  - base64url <-> ArrayBuffer conversion (credential and user IDs travel as base64url),
+ *  - parsing the authenticator data returned at registration (AAGUID, backup flags),
+ *  - thin wrappers around the WebAuthn Signal API, which lets the site tell the
+ *    browser / password manager which passkeys still exist so stale ones are pruned.
+ */
+
+export function bufferToBase64Url(buffer) {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlToBuffer(value) {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+}
+
+export function randomBytes(length) {
+  const bytes = new Uint8Array(length);
+  crypto.getRandomValues(bytes);
+  return bytes;
+}
+
+/** The relying party ID is the site's registrable domain. */
+export function rpId() {
+  return location.hostname;
+}
+
+/**
+ * Parse the authenticator data structure (WebAuthn §6.1).
+ * Layout: rpIdHash(32) | flags(1) | signCount(4) | [aaguid(16) | credIdLen(2) | credId | pubKey]
+ */
+export function parseAuthenticatorData(authData) {
+  const data = new Uint8Array(authData);
+  if (data.length < 37) throw new Error('Authenticator data is too short');
+  const flags = data[32];
+  const result = {
+    userPresent: Boolean(flags & 0x01),
+    userVerified: Boolean(flags & 0x04),
+    backupEligible: Boolean(flags & 0x08),
+    backedUp: Boolean(flags & 0x10),
+    signCount: new DataView(data.buffer, data.byteOffset + 33, 4).getUint32(0),
+    aaguid: null,
+  };
+  const hasAttestedCredentialData = Boolean(flags & 0x40);
+  if (hasAttestedCredentialData && data.length >= 55) {
+    result.aaguid = formatAaguid(data.subarray(37, 53));
+  }
+  return result;
+}
+
+function formatAaguid(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+/**
+ * Friendly names for common passkey providers, keyed by AAGUID.
+ * Source: the community-maintained passkey-authenticator-aaguids list.
+ */
+const AAGUID_NAMES = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b35a26b2-8f6e-4697-ab1d-d44db4da28c6': 'Zoho Vault',
+  'bfc748bb-3429-4faa-b9f9-7cfa9f3b76d0': 'iPasswords',
+  '891494da-2c90-4d31-a9cd-4eab0aed1309': 'Sésame',
+  'cc45f64e-52a2-451b-831a-4edd8022a202': 'ToothPic Passkey Provider',
+  '39a5647e-1b94-4156-9766-2a4ad7a44e4b': 'IDmelon',
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': 'YubiKey 5 NFC',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey 5 Series',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey 5 NFC',
+  'c5ef55ff-ad9a-4b9f-b580-adebafe026d0': 'YubiKey 5Ci',
+  '73bb0cd4-e502-49b8-9c6f-b59445bf720b': 'YubiKey 5 FIPS',
+  'd8522d9f-575b-4866-88a9-ba99fa02f35b': 'YubiKey Bio',
+};
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/** Returns a provider name, or null when the AAGUID is missing, zeroed, or unknown. */
+export function providerName(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return null;
+  return AAGUID_NAMES[aaguid.toLowerCase()] ?? null;
+}
+
+/** Feature-detect the WebAuthn Signal API methods individually. */
+export function signalSupport() {
+  const pkc = globalThis.PublicKeyCredential;
+  return {
+    unknownCredential: typeof pkc?.signalUnknownCredential === 'function',
+    allAcceptedCredentials: typeof pkc?.signalAllAcceptedCredentials === 'function',
+    currentUserDetails: typeof pkc?.signalCurrentUserDetails === 'function',
+  };
+}
+
+/**
+ * Tell the browser/password manager that a credential no longer exists on the
+ * account, so it can delete its copy. Resolves true when the signal was sent.
+ */
+export async function signalUnknownCredential(credentialId) {
+  if (!signalSupport().unknownCredential) return false;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId: rpId(), credentialId });
+    return true;
+  } catch (error) {
+    console.warn('signalUnknownCredential failed', error);
+    return false;
+  }
+}
+
+/**
+ * Give the authenticator the full list of credential IDs the account accepts.
+ * Any passkey it holds for this user that is not in the list gets removed.
+ */
+export async function signalAllAcceptedCredentials(userId, credentialIds) {
+  if (!signalSupport().allAcceptedCredentials) return false;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: rpId(),
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+    return true;
+  } catch (error) {
+    console.warn('signalAllAcceptedCredentials failed', error);
+    return false;
+  }
+}
+
+/** Keep the name shown next to the passkey in the provider's UI current. */
+export async function signalCurrentUserDetails(userId, name, displayName) {
+  if (!signalSupport().currentUserDetails) return false;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId: rpId(), userId, name, displayName });
+    return true;
+  } catch (error) {
+    console.warn('signalCurrentUserDetails failed', error);
+    return false;
+  }
+}
