+import type { APIRoute } from 'astro';
+import { getCurrentUser, json, unauthorized } from '../../../lib/auth';
+import { listPasskeys, toPublicPasskey } from '../../../lib/passkey-store';
+
+/** All passkeys registered to the signed-in reader. */
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  const passkeys = await listPasskeys(user.id);
+  return json({ passkeys: passkeys.map(toPublicPasskey) });
+};
