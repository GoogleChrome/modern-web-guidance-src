diff --git a/src/lib/aaguid.ts b/src/lib/aaguid.ts
new file mode 100644
index 0000000..cba9361
--- /dev/null
+++ b/src/lib/aaguid.ts
@@ -0,0 +1,80 @@
+/**
+ * Resolve a passkey provider name and icon from an authenticator AAGUID.
+ *
+ * The AAGUID is a UX hint only (platform passkeys do not attest it), so it is used purely to label
+ * passkeys in the management UI. The community registry is fetched lazily and cached in memory; a
+ * small built-in table covers the most common providers if the network is unavailable.
+ */
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const REGISTRY_TTL_MS = 24 * 60 * 60 * 1000;
+
+interface RegistryEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+export interface PasskeyProvider {
+  name: string;
+  icon?: string;
+}
+
+const FALLBACK_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+};
+
+let registryCache: { loadedAt: number; entries: Record<string, RegistryEntry> } | null = null;
+let registryInFlight: Promise<Record<string, RegistryEntry>> | null = null;
+
+async function loadRegistry(): Promise<Record<string, RegistryEntry>> {
+  if (registryCache && Date.now() - registryCache.loadedAt < REGISTRY_TTL_MS) {
+    return registryCache.entries;
+  }
+  if (!registryInFlight) {
+    registryInFlight = fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+      .then(async (response) => {
+        if (!response.ok) throw new Error(`Registry responded with ${response.status}`);
+        const entries = (await response.json()) as Record<string, RegistryEntry>;
+        registryCache = { loadedAt: Date.now(), entries };
+        return entries;
+      })
+      .catch((error) => {
+        console.warn('[aaguid] Could not load AAGUID registry, using built-in fallback:', error);
+        return registryCache?.entries ?? {};
+      })
+      .finally(() => {
+        registryInFlight = null;
+      });
+  }
+  return registryInFlight;
+}
+
+export async function lookupPasskeyProvider(aaguid: string): Promise<PasskeyProvider> {
+  const normalized = aaguid.toLowerCase();
+  if (normalized === ZERO_AAGUID) {
+    return { name: 'Unknown passkey provider' };
+  }
+  const registry = await loadRegistry();
+  const entry = registry[normalized];
+  if (entry?.name) {
+    return { name: entry.name, icon: entry.icon_light };
+  }
+  return { name: FALLBACK_PROVIDERS[normalized] ?? 'Unknown passkey provider' };
+}
diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..0483439
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,59 @@
+import type { AstroSession } from 'astro';
+import { getOrCreateUser, type StoredUser } from './passkey-store';
+
+/** What we keep in the session cookie-backed store for a signed-in reader. */
+export interface SessionUser {
+  username: string;
+  signedInAt: number;
+}
+
+/** Shape of the account record that is safe to send to the browser. */
+export interface PublicUser {
+  /** Base64URL-encoded WebAuthn user handle. */
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+export function toPublicUser(user: StoredUser): PublicUser {
+  return { id: user.id, name: user.username, displayName: user.displayName };
+}
+
+export function normalizeUsername(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const username = value.trim();
+  if (username.length < 1 || username.length > 64) return null;
+  return username;
+}
+
+/** Returns the signed-in reader's account record, or null when nobody is signed in. */
+export async function getCurrentUser(session: AstroSession | undefined): Promise<StoredUser | null> {
+  const sessionUser = await session?.get('user');
+  if (!sessionUser?.username) return null;
+  return getOrCreateUser(sessionUser.username);
+}
+
+export function json(body: unknown, init: ResponseInit = {}): Response {
+  return new Response(JSON.stringify(body), {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+  });
+}
+
+export function unauthorized(): Response {
+  return json({ error: 'You need to sign in first.' }, { status: 401 });
+}
+
+export async function readJsonBody<T = Record<string, unknown>>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+/** The WebAuthn relying party ID and origin for the current request. */
+export function getRelyingParty(request: Request): { rpId: string; origin: string; rpName: string } {
+  const url = new URL(request.url);
+  return { rpId: url.hostname, origin: url.origin, rpName: 'The DevTools Times' };
+}
diff --git a/src/lib/passkey-store.ts b/src/lib/passkey-store.ts
new file mode 100644
index 0000000..91a1a10
--- /dev/null
+++ b/src/lib/passkey-store.ts
@@ -0,0 +1,165 @@
+/**
+ * A tiny file-backed store for reader accounts and their passkeys.
+ *
+ * The DevTools Times has no real database (sign-in is delegated to an external demo API), so this
+ * module keeps a JSON document in memory and flushes it to disk after every change. Set
+ * `PASSKEY_STORE_PATH` to control where it lives; it defaults to `.data/passkeys.json`.
+ */
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+
+export interface StoredUser {
+  /** Base64URL-encoded random 16-byte WebAuthn user handle (never PII). */
+  id: string;
+  username: string;
+  displayName: string;
+  createdAt: number;
+}
+
+export interface StoredPasskey {
+  /** Base64URL-encoded credential ID. */
+  id: string;
+  /** `StoredUser.id` this credential belongs to. */
+  userId: string;
+  /** Base64URL-encoded COSE public key. */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  aaguid: string;
+  /** Provider name resolved from the AAGUID registry at registration time. */
+  providerName: string;
+  /** Data URI for the provider icon, when the registry knows it. */
+  providerIcon?: string;
+  /** User-editable nickname. Defaults to the provider name. */
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+/** The passkey fields that are safe to send to the browser. */
+export type PublicPasskey = Omit<StoredPasskey, 'publicKey' | 'counter' | 'userId'>;
+
+interface StoreDocument {
+  users: Record<string, StoredUser>;
+  passkeys: Record<string, StoredPasskey>;
+}
+
+const STORE_PATH = process.env.PASSKEY_STORE_PATH ?? join(process.cwd(), '.data', 'passkeys.json');
+
+// Keep a single instance across dev-server module reloads.
+const globalStore = globalThis as typeof globalThis & {
+  __devtoolsTimesPasskeyStore?: Promise<StoreDocument>;
+  __devtoolsTimesPasskeyWrite?: Promise<void>;
+};
+
+async function loadDocument(): Promise<StoreDocument> {
+  try {
+    const raw = await readFile(STORE_PATH, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<StoreDocument>;
+    return { users: parsed.users ?? {}, passkeys: parsed.passkeys ?? {} };
+  } catch {
+    return { users: {}, passkeys: {} };
+  }
+}
+
+function getDocument(): Promise<StoreDocument> {
+  if (!globalStore.__devtoolsTimesPasskeyStore) {
+    globalStore.__devtoolsTimesPasskeyStore = loadDocument();
+  }
+  return globalStore.__devtoolsTimesPasskeyStore;
+}
+
+async function persist(doc: StoreDocument): Promise<void> {
+  const previous = globalStore.__devtoolsTimesPasskeyWrite ?? Promise.resolve();
+  const next = previous
+    .catch(() => undefined)
+    .then(async () => {
+      await mkdir(dirname(STORE_PATH), { recursive: true });
+      await writeFile(STORE_PATH, JSON.stringify(doc, null, 2), 'utf8');
+    });
+  globalStore.__devtoolsTimesPasskeyWrite = next;
+  try {
+    await next;
+  } catch (error) {
+    console.error('[passkey-store] Could not persist store:', error);
+  }
+}
+
+function toBase64Url(bytes: Uint8Array): string {
+  return Buffer.from(bytes).toString('base64url');
+}
+
+export function toPublicPasskey(passkey: StoredPasskey): PublicPasskey {
+  const { publicKey: _publicKey, counter: _counter, userId: _userId, ...rest } = passkey;
+  return rest;
+}
+
+export async function getUserByUsername(username: string): Promise<StoredUser | null> {
+  const doc = await getDocument();
+  return doc.users[username] ?? null;
+}
+
+export async function getOrCreateUser(username: string): Promise<StoredUser> {
+  const doc = await getDocument();
+  const existing = doc.users[username];
+  if (existing) return existing;
+
+  const user: StoredUser = {
+    id: toBase64Url(crypto.getRandomValues(new Uint8Array(16))),
+    username,
+    displayName: username,
+    createdAt: Date.now(),
+  };
+  doc.users[username] = user;
+  await persist(doc);
+  return user;
+}
+
+export async function updateUserDisplayName(username: string, displayName: string): Promise<StoredUser | null> {
+  const doc = await getDocument();
+  const user = doc.users[username];
+  if (!user) return null;
+  user.displayName = displayName;
+  await persist(doc);
+  return user;
+}
+
+export async function listPasskeys(userId: string): Promise<StoredPasskey[]> {
+  const doc = await getDocument();
+  return Object.values(doc.passkeys)
+    .filter((passkey) => passkey.userId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export async function getPasskey(userId: string, credentialId: string): Promise<StoredPasskey | null> {
+  const doc = await getDocument();
+  const passkey = doc.passkeys[credentialId];
+  return passkey && passkey.userId === userId ? passkey : null;
+}
+
+export async function addPasskey(passkey: StoredPasskey): Promise<StoredPasskey> {
+  const doc = await getDocument();
+  doc.passkeys[passkey.id] = passkey;
+  await persist(doc);
+  return passkey;
+}
+
+export async function renamePasskey(userId: string, credentialId: string, name: string): Promise<StoredPasskey | null> {
+  const doc = await getDocument();
+  const passkey = doc.passkeys[credentialId];
+  if (!passkey || passkey.userId !== userId) return null;
+  passkey.name = name;
+  await persist(doc);
+  return passkey;
+}
+
+export async function deletePasskey(userId: string, credentialId: string): Promise<boolean> {
+  const doc = await getDocument();
+  const passkey = doc.passkeys[credentialId];
+  if (!passkey || passkey.userId !== userId) return false;
+  delete doc.passkeys[credentialId];
+  await persist(doc);
+  return true;
+}
diff --git a/src/lib/webauthn-client.ts b/src/lib/webauthn-client.ts
new file mode 100644
index 0000000..7c3f6a9
--- /dev/null
+++ b/src/lib/webauthn-client.ts
@@ -0,0 +1,180 @@
+/**
+ * Browser-side helpers for passkey management.
+ *
+ * Everything here is feature-detected: the Signal API (signalAllAcceptedCredentials and
+ * signalCurrentUserDetails) is still limited availability, and the JSON helpers plus
+ * getClientCapabilities() are polyfilled on older browsers via `webauthn-polyfills`.
+ */
+
+export interface PasskeyRecord {
+  id: string;
+  aaguid: string;
+  providerName: string;
+  providerIcon?: string;
+  name: string;
+  transports?: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface PasskeySupport {
+  /** WebAuthn exists at all in this browser. */
+  webauthn: boolean;
+  /** A platform authenticator that can create passkeys is available. */
+  platformAuthenticator: boolean;
+  /** The browser can mirror credential changes to the passkey provider. */
+  signalApi: boolean;
+}
+
+interface ClientCapabilities {
+  passkeyPlatformAuthenticator?: boolean;
+  userVerifyingPlatformAuthenticator?: boolean;
+  signalAllAcceptedCredentials?: boolean;
+  signalCurrentUserDetails?: boolean;
+  [capability: string]: boolean | undefined;
+}
+
+/** WebAuthn Level 3 statics that may be missing from the TypeScript DOM lib or the browser. */
+interface PublicKeyCredentialStatics {
+  parseCreationOptionsFromJSON?: (options: unknown) => PublicKeyCredentialCreationOptions;
+  getClientCapabilities?: () => Promise<ClientCapabilities>;
+  isUserVerifyingPlatformAuthenticatorAvailable?: () => Promise<boolean>;
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+}
+
+function statics(): PublicKeyCredentialStatics | null {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) return null;
+  return window.PublicKeyCredential as unknown as PublicKeyCredentialStatics;
+}
+
+let polyfillPromise: Promise<void> | null = null;
+
+/** Load `webauthn-polyfills` once if the browser lacks the JSON helpers or getClientCapabilities(). */
+export function ensureWebAuthnPolyfills(): Promise<void> {
+  const pkc = statics();
+  if (!pkc) return Promise.resolve();
+  if (pkc.parseCreationOptionsFromJSON && pkc.getClientCapabilities) return Promise.resolve();
+  if (!polyfillPromise) {
+    polyfillPromise = import('webauthn-polyfills').then(
+      () => undefined,
+      (error) => console.warn('[passkeys] Could not load WebAuthn polyfills:', error),
+    );
+  }
+  return polyfillPromise;
+}
+
+export async function detectPasskeySupport(): Promise<PasskeySupport> {
+  await ensureWebAuthnPolyfills();
+  const pkc = statics();
+  if (!pkc) return { webauthn: false, platformAuthenticator: false, signalApi: false };
+
+  let capabilities: ClientCapabilities = {};
+  try {
+    capabilities = (await pkc.getClientCapabilities?.()) ?? {};
+  } catch {
+    capabilities = {};
+  }
+
+  let platformAuthenticator = capabilities.passkeyPlatformAuthenticator;
+  if (platformAuthenticator === undefined) {
+    platformAuthenticator =
+      capabilities.userVerifyingPlatformAuthenticator ??
+      (await pkc.isUserVerifyingPlatformAuthenticatorAvailable?.().catch(() => false)) ??
+      false;
+  }
+
+  return {
+    webauthn: true,
+    platformAuthenticator: platformAuthenticator === true,
+    signalApi: typeof pkc.signalAllAcceptedCredentials === 'function',
+  };
+}
+
+/** Create a passkey from server-issued options and return the JSON-serialised attestation. */
+export async function createPasskey(optionsJSON: unknown): Promise<unknown> {
+  await ensureWebAuthnPolyfills();
+  const pkc = statics();
+  if (!pkc?.parseCreationOptionsFromJSON) {
+    throw new Error('This browser cannot create passkeys.');
+  }
+  const publicKey = pkc.parseCreationOptionsFromJSON(optionsJSON);
+  const credential = (await navigator.credentials.create({ publicKey })) as
+    | (PublicKeyCredential & { toJSON?: () => unknown })
+    | null;
+  if (!credential) {
+    throw new Error('No passkey was created.');
+  }
+  if (typeof credential.toJSON !== 'function') {
+    throw new Error('This browser cannot serialise the new passkey.');
+  }
+  return credential.toJSON();
+}
+
+/**
+ * Tell the passkey provider which credential IDs the server still accepts so it can hide or remove
+ * passkeys that were deleted here (or on another device).
+ */
+export async function syncAcceptedPasskeys(rpId: string, userId: string, passkeys: Pick<PasskeyRecord, 'id'>[]): Promise<void> {
+  const pkc = statics();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  try {
+    await pkc.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: passkeys.map((passkey) => passkey.id),
+    });
+  } catch (error) {
+    console.warn('[passkeys] signalAllAcceptedCredentials failed:', error);
+  }
+}
+
+/** Push an updated username / display name to the passkey provider. */
+export async function syncUserDetails(rpId: string, userId: string, name: string, displayName: string): Promise<void> {
+  const pkc = statics();
+  if (!pkc?.signalCurrentUserDetails) return;
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (error) {
+    console.warn('[passkeys] signalCurrentUserDetails failed:', error);
+  }
+}
+
+export function describeWebAuthnError(error: unknown): string {
+  if (error instanceof DOMException) {
+    switch (error.name) {
+      case 'NotAllowedError':
+        return 'The passkey request was cancelled or timed out.';
+      case 'InvalidStateError':
+        return 'This authenticator already holds a passkey for your account.';
+      case 'SecurityError':
+        return 'Passkeys need a secure (https) connection or localhost.';
+      case 'NotSupportedError':
+        return 'This authenticator does not support the requested passkey options.';
+      default:
+        return error.message || 'The passkey request failed.';
+    }
+  }
+  if (error instanceof Error) return error.message;
+  return 'Something went wrong. Please try again.';
+}
+
+export async function readError(response: Response, fallback: string): Promise<string> {
+  try {
+    const data = (await response.json()) as { error?: string };
+    return data.error || fallback;
+  } catch {
+    return fallback;
+  }
+}
diff --git a/src/pages/api/account.ts b/src/pages/api/account.ts
new file mode 100644
index 0000000..27039dc
--- /dev/null
+++ b/src/pages/api/account.ts
@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { getCurrentUser, json, readJsonBody, toPublicUser, unauthorized } from '../../lib/auth';
+import { updateUserDisplayName } from '../../lib/passkey-store';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+  return json({ user: toPublicUser(user) });
+};
+
+/** Update the reader's display name. The client mirrors the change to passkey providers afterwards. */
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  const body = await readJsonBody<{ displayName?: unknown }>(request);
+  const displayName = typeof body?.displayName === 'string' ? body.displayName.trim() : '';
+  if (displayName.length < 1 || displayName.length > 64) {
+    return json({ error: 'Display name must be between 1 and 64 characters.' }, { status: 400 });
+  }
+
+  const updated = await updateUserDisplayName(user.username, displayName);
+  if (!updated) return unauthorized();
+  return json({ user: toPublicUser(updated) });
+};
diff --git a/src/pages/api/auth/session.ts b/src/pages/api/auth/session.ts
new file mode 100644
index 0000000..23d4df7
--- /dev/null
+++ b/src/pages/api/auth/session.ts
@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { getCurrentUser, json, normalizeUsername, readJsonBody, toPublicUser } from '../../../lib/auth';
+
+/** Who is signed in right now (if anyone). */
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getCurrentUser(session);
+  return json({ user: user ? toPublicUser(user) : null });
+};
+
+/**
+ * Establish a local reader session after the external demo sign-in API accepted the credentials.
+ * The DevTools Times delegates password checks to that API, so this endpoint only records who the
+ * browser says signed in; it is what makes account settings and passkeys available.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are not available.' }, { status: 500 });
+  }
+  const body = await readJsonBody<{ username?: unknown }>(request);
+  const username = normalizeUsername(body?.username);
+  if (!username) {
+    return json({ error: 'A username is required.' }, { status: 400 });
+  }
+
+  await session.regenerate();
+  await session.set('user', { username, signedInAt: Date.now() });
+  const user = await getCurrentUser(session);
+  return json({ user: user ? toPublicUser(user) : null });
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  session?.destroy();
+  return new Response(null, { status: 204 });
+};
diff --git a/src/pages/api/auth/signout.ts b/src/pages/api/auth/signout.ts
