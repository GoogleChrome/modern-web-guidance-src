diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..a6aaaef
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,333 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, PlusIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  createPasskey,
+  describeWebAuthnError,
+  detectPasskeySupport,
+  readError,
+  syncAcceptedPasskeys,
+  type PasskeyRecord,
+  type PasskeySupport,
+} from '../lib/webauthn-client';
+
+interface Props {
+  /** Relying party ID the server issues credentials for (the site hostname). */
+  rpId: string;
+  /** Base64URL-encoded WebAuthn user handle of the signed-in reader. */
+  userId: string;
+}
+
+const api = (path: string) => `${import.meta.env.BASE_URL}api/${path}`;
+const JSON_HEADERS = { 'Content-Type': 'application/json' };
+
+function formatDate(timestamp: number): string {
+  return new Date(timestamp).toLocaleDateString(undefined, { dateStyle: 'medium' });
+}
+
+async function fetchPasskeys(): Promise<PasskeyRecord[]> {
+  const response = await fetch(api('passkeys'));
+  if (!response.ok) throw new Error(await readError(response, 'Could not load your passkeys.'));
+  const data = (await response.json()) as { passkeys: PasskeyRecord[] };
+  return data.passkeys;
+}
+
+export default function PasskeyManager({ rpId, userId }: Props) {
+  const [passkeys, setPasskeys] = useState<PasskeyRecord[] | null>(null);
+  const [support, setSupport] = useState<PasskeySupport | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmingId, setConfirmingId] = useState<string | null>(null);
+  const [busyId, setBusyId] = useState<string | null>(null);
+
+  /** Reload the list from the server and tell the passkey provider which IDs are still valid. */
+  const refreshAndSync = useCallback(async () => {
+    const list = await fetchPasskeys();
+    setPasskeys(list);
+    await syncAcceptedPasskeys(rpId, userId, list);
+    return list;
+  }, [rpId, userId]);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const [detected] = await Promise.all([detectPasskeySupport(), refreshAndSync()]);
+        if (!cancelled) setSupport(detected);
+      } catch (err) {
+        if (!cancelled) {
+          setError(err instanceof Error ? err.message : 'Could not load your passkeys.');
+          setPasskeys([]);
+        }
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [refreshAndSync]);
+
+  const handleCreate = async () => {
+    setError(null);
+    setNotice(null);
+    setCreating(true);
+    try {
+      const optionsResponse = await fetch(api('passkeys/register/options'), { method: 'POST' });
+      if (!optionsResponse.ok) {
+        throw new Error(await readError(optionsResponse, 'Could not start passkey registration.'));
+      }
+      const attestation = await createPasskey(await optionsResponse.json());
+      const verifyResponse = await fetch(api('passkeys/register/verify'), {
+        method: 'POST',
+        headers: JSON_HEADERS,
+        body: JSON.stringify(attestation),
+      });
+      if (!verifyResponse.ok) {
+        throw new Error(await readError(verifyResponse, 'The passkey could not be saved.'));
+      }
+      const { passkey } = (await verifyResponse.json()) as { passkey: PasskeyRecord };
+      await refreshAndSync();
+      setNotice(`Added a passkey from ${passkey.providerName}.`);
+    } catch (err) {
+      setError(describeWebAuthnError(err));
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const startRename = (passkey: PasskeyRecord) => {
+    setConfirmingId(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+    setError(null);
+    setNotice(null);
+  };
+
+  const submitRename = async (event: React.FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!editingId) return;
+    const name = draftName.trim();
+    if (!name) {
+      setError('Give the passkey a name.');
+      return;
+    }
+    setBusyId(editingId);
+    try {
+      const response = await fetch(api(`passkeys/${editingId}`), {
+        method: 'PATCH',
+        headers: JSON_HEADERS,
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) throw new Error(await readError(response, 'Could not rename the passkey.'));
+      const { passkey } = (await response.json()) as { passkey: PasskeyRecord };
+      // A nickname lives only on our server, so no Signal API call is needed here.
+      setPasskeys((current) => current?.map((item) => (item.id === passkey.id ? passkey : item)) ?? null);
+      setEditingId(null);
+      setNotice('Passkey renamed.');
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Could not rename the passkey.');
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleRemove = async (passkey: PasskeyRecord) => {
+    setBusyId(passkey.id);
+    setError(null);
+    setNotice(null);
+    try {
+      const response = await fetch(api(`passkeys/${passkey.id}`), { method: 'DELETE' });
+      if (!response.ok && response.status !== 404) {
+        throw new Error(await readError(response, 'Could not remove the passkey.'));
+      }
+      await refreshAndSync();
+      setConfirmingId(null);
+      setNotice(
+        support?.signalApi
+          ? `Removed "${passkey.name}". Your passkey provider has been told it is no longer accepted.`
+          : `Removed "${passkey.name}". You may also want to delete it from your password manager.`,
+      );
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Could not remove the passkey.');
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const loading = passkeys === null;
+  const canCreate = support?.webauthn && support.platformAuthenticator;
+
+  return (
+    <div className="space-y-4">
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <div role="status" aria-live="polite">
+        {notice && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      {loading ? (
+        <p className="text-sm text-gray-500 py-6 text-center">Loading your passkeys…</p>
+      ) : passkeys.length === 0 ? (
+        <div className="text-center py-8 px-4 border border-dashed border-gray-300 rounded-lg">
+          <KeyIcon aria-hidden="true" className="h-10 w-10 mx-auto text-gray-400" />
+          <p className="mt-3 font-semibold text-gray-800">No passkeys yet</p>
+          <p className="mt-1 text-sm text-gray-600">
+            Add one to sign in with your fingerprint, face, or device PIN instead of a password.
+          </p>
+        </div>
+      ) : (
+        <ul className="divide-y divide-gray-200 border-y border-gray-200">
+          {passkeys.map((passkey) => {
+            const isEditing = editingId === passkey.id;
+            const isConfirming = confirmingId === passkey.id;
+            const isBusy = busyId === passkey.id;
+            return (
+              <li key={passkey.id} className="flex flex-col sm:flex-row sm:items-start gap-4 py-4">
+                <div className="h-10 w-10 flex-shrink-0 rounded bg-gray-100 flex items-center justify-center overflow-hidden">
+                  {passkey.providerIcon ? (
+                    <img src={passkey.providerIcon} alt="" width={32} height={32} className="h-8 w-8 object-contain" />
+                  ) : (
+                    <KeyIcon aria-hidden="true" className="h-6 w-6 text-gray-500" />
+                  )}
+                </div>
+
+                <div className="flex-1 min-w-0">
+                  {isEditing ? (
+                    <form onSubmit={submitRename} className="flex flex-wrap items-center gap-2">
+                      <label htmlFor={`passkey-name-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`passkey-name-${passkey.id}`}
+                        type="text"
+                        value={draftName}
+                        onChange={(e) => setDraftName(e.target.value)}
+                        maxLength={64}
+                        required
+                        autoFocus
+                        className="flex-1 min-w-[12rem] px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        disabled={isBusy}
+                        className="px-3 py-1.5 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800 disabled:opacity-60"
+                      >
+                        {isBusy ? 'Saving…' : 'Save'}
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-gray-900"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                  )}
+                  <p className="text-sm text-gray-600">
+                    {passkey.providerName}
+                    {' · '}
+                    {passkey.backedUp ? 'Synced across your devices' : 'Stored on one device'}
+                  </p>
+                  <p className="text-xs text-gray-500 mt-1">
+                    Added <time dateTime={new Date(passkey.registeredAt).toISOString()}>{formatDate(passkey.registeredAt)}</time>
+                    {' · '}
+                    {passkey.lastUsedAt ? (
+                      <>
+                        Last used{' '}
+                        <time dateTime={new Date(passkey.lastUsedAt).toISOString()}>{formatDate(passkey.lastUsedAt)}</time>
+                      </>
+                    ) : (
+                      'Not used yet'
+                    )}
+                  </p>
+                </div>
+
+                <div className="flex items-center gap-2 sm:self-center">
+                  {isConfirming ? (
+                    <div className="flex items-center gap-2 text-sm">
+                      <span className="text-gray-700">Remove this passkey?</span>
+                      <button
+                        type="button"
+                        onClick={() => handleRemove(passkey)}
+                        disabled={isBusy}
+                        className="px-3 py-1.5 font-medium text-white bg-red-600 rounded-md hover:bg-red-700 disabled:opacity-60"
+                      >
+                        {isBusy ? 'Removing…' : 'Remove'}
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setConfirmingId(null)}
+                        disabled={isBusy}
+                        className="px-3 py-1.5 font-medium text-gray-700 hover:text-gray-900"
+                      >
+                        Keep
+                      </button>
+                    </div>
+                  ) : (
+                    <>
+                      <button
+                        type="button"
+                        onClick={() => startRename(passkey)}
+                        disabled={isEditing || isBusy}
+                        aria-label={`Rename ${passkey.name}`}
+                        className="p-2 text-gray-500 hover:text-amber-500 disabled:opacity-40"
+                      >
+                        <PencilSquareIcon aria-hidden="true" className="h-5 w-5" />
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => {
+                          setEditingId(null);
+                          setConfirmingId(passkey.id);
+                        }}
+                        disabled={isBusy}
+                        aria-label={`Remove ${passkey.name}`}
+                        className="p-2 text-gray-500 hover:text-red-600 disabled:opacity-40"
+                      >
+                        <TrashIcon aria-hidden="true" className="h-5 w-5" />
+                      </button>
+                    </>
+                  )}
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      {support && (
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
+          {canCreate ? (
+            <button
+              type="button"
+              onClick={handleCreate}
+              disabled={creating || loading}
+              className="inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+            >
+              <PlusIcon aria-hidden="true" className="h-4 w-4" />
+              {creating ? 'Follow the prompts…' : 'Create a passkey'}
+            </button>
+          ) : (
+            <p className="text-sm text-gray-600">
+              {support.webauthn
+                ? 'This browser has no passkey-capable authenticator, so new passkeys cannot be created here. You can still manage the ones you have and keep signing in with your password.'
+                : 'This browser does not support passkeys. Keep signing in with your password.'}
+            </p>
+          )}
+          {support.webauthn && !support.signalApi && (
+            <p className="text-xs text-gray-500 sm:max-w-xs">
+              This browser cannot notify your password manager about removed passkeys, so you may need to delete
+              them there as well.
+            </p>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
