+++ b/src/pages/settings.astro
@@ -0,0 +1,41 @@
+---
+import Layout from '../layouts/Layout.astro';
+import AccountProfileForm from '../components/AccountProfileForm';
+import PasskeyManager from '../components/PasskeyManager';
+import { getCurrentUser, toPublicUser } from '../lib/auth';
+
+const baseUrl = import.meta.env.BASE_URL;
+const user = await getCurrentUser(Astro.session);
+if (!user) {
+  return Astro.redirect(`${baseUrl}signin?next=settings`);
+}
+
+const publicUser = toPublicUser(user);
+// The relying party ID must match what the registration endpoints use: the site hostname.
+const rpId = Astro.url.hostname;
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Account settings</h1>
+    <p class="text-sm text-gray-600 mb-8">
+      Signed in as <span class="font-semibold text-gray-800">{user.username}</span>.
+    </p>
+
+    <section aria-labelledby="profile-heading" class="mb-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 id="profile-heading" class="text-xl font-bold text-gray-900 mb-1">Profile</h2>
+      <p class="text-sm text-gray-600 mb-5">How your account appears to you and to your passkey provider.</p>
+      <AccountProfileForm client:load rpId={rpId} user={publicUser} />
+    </section>
+
+    <section aria-labelledby="passkeys-heading" class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 id="passkeys-heading" class="text-xl font-bold text-gray-900 mb-1">Passkeys</h2>
+      <p class="text-sm text-gray-600 mb-5">
+        Passkeys registered here are saved by your password manager or security key. Rename them to tell your
+        devices apart, or remove the ones you no longer use. Removals are passed on to your passkey provider so it
+        can tidy up too.
+      </p>
+      <PasskeyManager client:load rpId={rpId} userId={publicUser.id} />
+    </section>
+  </div>
+</Layout>
