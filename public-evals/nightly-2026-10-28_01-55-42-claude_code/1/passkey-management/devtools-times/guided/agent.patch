diff --git a/src/pages/api/passkeys/[id].ts b/src/pages/api/passkeys/[id].ts
new file mode 100644
index 0000000..ba59feb
--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { getCurrentUser, json, readJsonBody, unauthorized } from '../../../lib/auth';
+import { deletePasskey, renamePasskey, toPublicPasskey } from '../../../lib/passkey-store';
+
+const BASE64URL = /^[A-Za-z0-9_-]{16,1024}$/;
+
+function credentialIdFrom(params: Record<string, string | undefined>): string | null {
+  const id = params.id ?? '';
+  return BASE64URL.test(id) ? id : null;
+}
+
+/** Rename a passkey. This is a server-side label only; nothing is signalled to the authenticator. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  const credentialId = credentialIdFrom(params);
+  if (!credentialId) return json({ error: 'Invalid passkey ID.' }, { status: 400 });
+
+  const body = await readJsonBody<{ name?: unknown }>(request);
+  const name = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (name.length < 1 || name.length > 64) {
+    return json({ error: 'Passkey name must be between 1 and 64 characters.' }, { status: 400 });
+  }
+
+  const updated = await renamePasskey(user.id, credentialId, name);
+  if (!updated) return json({ error: 'Passkey not found.' }, { status: 404 });
+  return json({ passkey: toPublicPasskey(updated) });
+};
+
+/** Remove a passkey. The client then calls signalAllAcceptedCredentials() with what remains. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return unauthorized();
+
+  const credentialId = credentialIdFrom(params);
+  if (!credentialId) return json({ error: 'Invalid passkey ID.' }, { status: 400 });
+
+  const removed = await deletePasskey(user.id, credentialId);
+  if (!removed) return json({ error: 'Passkey not found.' }, { status: 404 });
+  return new Response(null, { status: 204 });
+};
