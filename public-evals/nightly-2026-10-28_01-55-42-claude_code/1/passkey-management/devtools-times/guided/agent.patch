diff --git a/src/components/AccountProfileForm.tsx b/src/components/AccountProfileForm.tsx
new file mode 100644
index 0000000..fbefeb2
--- /dev/null
+++ b/src/components/AccountProfileForm.tsx
@@ -0,0 +1,99 @@
+import React, { useState } from 'react';
+import { readError, syncUserDetails } from '../lib/webauthn-client';
+
+interface Props {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+}
+
+export default function AccountProfileForm({ rpId, user }: Props) {
+  const [displayName, setDisplayName] = useState(user.displayName);
+  const [savedDisplayName, setSavedDisplayName] = useState(user.displayName);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+
+  const handleSubmit = async (event: React.FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const trimmed = displayName.trim();
+    if (!trimmed) {
+      setError('Enter a display name.');
+      return;
+    }
+    setError(null);
+    setNotice(null);
+    setSaving(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/account`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName: trimmed }),
+      });
+      if (!response.ok) throw new Error(await readError(response, 'Could not update your display name.'));
+      const data = (await response.json()) as { user: { id: string; name: string; displayName: string } };
+      setDisplayName(data.user.displayName);
+      setSavedDisplayName(data.user.displayName);
+      // Keep the name shown by passkey providers in step with the account.
+      await syncUserDetails(rpId, data.user.id, data.user.name, data.user.displayName);
+      setNotice('Display name updated. Your passkeys will show the new name.');
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Could not update your display name.');
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const unchanged = displayName.trim() === savedDisplayName;
+
+  return (
+    <form onSubmit={handleSubmit} className="space-y-4">
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <div role="status" aria-live="polite">
+        {notice && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      <div className="grid gap-4 sm:grid-cols-2">
+        <div>
+          <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+            Username
+          </label>
+          <input
+            id="account-username"
+            type="text"
+            value={user.name}
+            readOnly
+            className="w-full px-3 py-2 border border-gray-200 bg-gray-50 text-gray-600 rounded-md"
+          />
+        </div>
+        <div>
+          <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            id="account-display-name"
+            type="text"
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            maxLength={64}
+            required
+            autoComplete="name"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          <p className="text-xs text-gray-500 mt-1">Shown alongside your passkeys in your password manager.</p>
+        </div>
+      </div>
+
+      <button
+        type="submit"
+        disabled={saving || unchanged}
+        className="py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+      >
+        {saving ? 'Saving…' : 'Save display name'}
+      </button>
+    </form>
+  );
+}
