+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getCurrentUser, getRelyingParty, json, unauthorized } from '../../../../lib/auth';
+import { listPasskeys } from '../../../../lib/passkey-store';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+/** Step 1 of registering a new passkey: hand the browser creation options with a fresh challenge. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user || !session) return unauthorized();
+
+  const { rpId, rpName } = getRelyingParty(request);
+  const existing = await listPasskeys(user.id);
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID: rpId,
+    userName: user.username,
+    userID: isoBase64URL.toBuffer(user.id),
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    // Stop the authenticator from creating a duplicate for a passkey we already know about.
+    excludeCredentials: existing.map((passkey) => ({ id: passkey.id, transports: passkey.transports })),
+    // No authenticatorAttachment: readers may use the platform authenticator or a security key.
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  await session.set('passkeyRegistration', {
+    challenge: options.challenge,
+    expiresAt: Date.now() + CHALLENGE_TTL_MS,
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..fd02f02
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,66 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { lookupPasskeyProvider } from '../../../../lib/aaguid';
+import { getCurrentUser, getRelyingParty, json, readJsonBody, unauthorized } from '../../../../lib/auth';
+import { addPasskey, getPasskey, toPublicPasskey, type StoredPasskey } from '../../../../lib/passkey-store';
+
+/** Step 2 of registering a new passkey: verify the attestation and store the credential. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user || !session) return unauthorized();
+
+  const pending = await session.get('passkeyRegistration');
+  await session.delete('passkeyRegistration');
+  if (!pending || pending.expiresAt < Date.now()) {
+    return json({ error: 'The passkey request expired. Please try again.' }, { status: 400 });
+  }
+
+  const body = await readJsonBody<RegistrationResponseJSON>(request);
+  if (!body?.id || !body.response?.attestationObject) {
+    return json({ error: 'Malformed passkey response.' }, { status: 400 });
+  }
+
+  const { rpId, origin } = getRelyingParty(request);
+  let verification: Awaited<ReturnType<typeof verifyRegistrationResponse>>;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpId,
+      requireUserVerification: false,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Verification failed.';
+    return json({ error: message }, { status: 400 });
+  }
+
+  if (!verification.verified) {
+    return json({ error: 'The passkey could not be verified.' }, { status: 400 });
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await getPasskey(user.id, credential.id)) {
+    return json({ error: 'This passkey is already registered.' }, { status: 409 });
+  }
+
+  const provider = await lookupPasskeyProvider(aaguid);
+  const passkey: StoredPasskey = {
+    id: credential.id,
+    userId: user.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports,
+    aaguid,
+    providerName: provider.name,
+    providerIcon: provider.icon,
+    name: provider.name,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    registeredAt: Date.now(),
+  };
+  await addPasskey(passkey);
+
+  return json({ passkey: toPublicPasskey(passkey) }, { status: 201 });
+};
