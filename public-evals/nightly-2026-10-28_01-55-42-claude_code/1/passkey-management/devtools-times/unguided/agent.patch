index 0000000..2bce770
--- /dev/null
+++ b/src/lib/session.ts
@@ -0,0 +1,61 @@
+import type { APIContext } from 'astro';
+
+export type Session = NonNullable<APIContext['session']>;
+
+export interface SessionUser {
+  username: string;
+  /** base64url-encoded WebAuthn user handle, stable per account. */
+  userId: string;
+}
+
+export interface PasskeyChallenge {
+  kind: 'registration' | 'authentication';
+  challenge: string;
+  /** Only set for registration ceremonies, which are bound to the signed-in user. */
+  username?: string;
+  expiresAt: number;
+}
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export async function getSessionUser(session: APIContext['session']): Promise<SessionUser | null> {
+  if (!session) return null;
+  const user = await session.get('user');
+  if (!user || typeof user.username !== 'string' || typeof user.userId !== 'string') {
+    return null;
+  }
+  return user;
+}
+
+/** Establish a signed-in session. Rotates the session ID but keeps data such as the reading list. */
+export async function signInSession(session: Session, user: SessionUser): Promise<void> {
+  await session.regenerate();
+  session.set('user', user);
+}
+
+export function signOutSession(session: Session): void {
+  session.destroy();
+}
+
+export async function storeChallenge(
+  session: Session,
+  challenge: Omit<PasskeyChallenge, 'expiresAt'>,
+): Promise<void> {
+  session.set('passkeyChallenge', { ...challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+}
+
+/**
+ * Read and clear the pending challenge. Returns null when there is none, it expired,
+ * or it was issued for a different kind of ceremony.
+ */
+export async function consumeChallenge(
+  session: Session,
+  kind: PasskeyChallenge['kind'],
+): Promise<PasskeyChallenge | null> {
+  const pending = await session.get('passkeyChallenge');
+  session.delete('passkeyChallenge');
+  if (!pending || pending.kind !== kind || pending.expiresAt < Date.now()) {
+    return null;
+  }
+  return pending;
+}
diff --git a/src/lib/webauthn.ts b/src/lib/webauthn.ts
new file mode 100644
index 0000000..9897f0e
--- /dev/null
+++ b/src/lib/webauthn.ts
@@ -0,0 +1,72 @@
+import type { StoredPasskey, StoredUser } from './passkey-store';
+
+export const RP_NAME = 'The DevTools Times';
+
+export interface RelyingParty {
+  rpID: string;
+  origin: string;
+}
+
+/**
+ * Resolve the WebAuthn Relying Party ID and expected origin for this request.
+ * Astro already honours trusted `X-Forwarded-*` headers (see `security.allowedDomains`),
+ * so the request URL is correct behind the Cloud Run proxy. Override with
+ * `WEBAUTHN_RP_ID` / `WEBAUTHN_ORIGIN` when serving from several hostnames.
+ */
+export function getRelyingParty(request: Request): RelyingParty {
+  const url = new URL(request.url);
+  return {
+    rpID: process.env.WEBAUTHN_RP_ID || url.hostname,
+    origin: process.env.WEBAUTHN_ORIGIN || url.origin,
+  };
+}
+
+/** The subset of a stored passkey that is safe to send to the browser. */
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  deviceType: StoredPasskey['deviceType'];
+  backedUp: boolean;
+  transports: string[];
+}
+
+export function toPasskeySummary(passkey: StoredPasskey): PasskeySummary {
+  return {
+    id: passkey.id,
+    name: passkey.name,
+    createdAt: passkey.createdAt,
+    lastUsedAt: passkey.lastUsedAt,
+    deviceType: passkey.deviceType,
+    backedUp: passkey.backedUp,
+    transports: passkey.transports,
+  };
+}
+
+/** Payload returned by every passkey management endpoint so the client can re-sync the authenticator. */
+export interface PasskeyListPayload {
+  username: string;
+  userId: string;
+  rpId: string;
+  passkeys: PasskeySummary[];
+}
+
+export function toPasskeyListPayload(user: StoredUser, rp: RelyingParty): PasskeyListPayload {
+  return {
+    username: user.username,
+    userId: user.userId,
+    rpId: rp.rpID,
+    passkeys: user.passkeys.map(toPasskeySummary),
+  };
+}
+
+export const PASSKEY_NAME_MAX_LENGTH = 64;
+
+/** Trim and collapse whitespace; returns null when nothing usable remains. */
+export function normalizePasskeyName(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const name = input.replace(/\s+/g, ' ').trim();
+  if (!name || name.length > PASSKEY_NAME_MAX_LENGTH) return null;
+  return name;
+}
