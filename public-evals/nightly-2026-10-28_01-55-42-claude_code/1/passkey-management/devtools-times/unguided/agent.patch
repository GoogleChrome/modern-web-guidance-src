+import { useState } from 'react';
+import { apiFetch } from '../lib/passkey-client';
+
+interface Props {
+  className?: string;
+}
+
+export default function SignOutButton({ className }: Props) {
+  const [busy, setBusy] = useState(false);
+
+  const handleClick = async () => {
+    setBusy(true);
+    try {
+      await apiFetch('auth/signout', { method: 'POST', body: {} });
+    } catch {
+      // Even if the request fails, send the reader home; the cookie may already be gone.
+    } finally {
+      window.location.assign(import.meta.env.BASE_URL);
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={handleClick}
+      disabled={busy}
+      data-skip-tracking="true"
+      className={
+        className ??
+        'bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400 disabled:opacity-60 disabled:cursor-not-allowed'
+      }
+    >
+      {busy ? 'Signing out…' : 'Sign out'}
+    </button>
+  );
+}
