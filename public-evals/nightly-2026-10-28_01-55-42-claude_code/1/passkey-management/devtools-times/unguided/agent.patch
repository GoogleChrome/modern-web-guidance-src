diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..ed82ab8
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,478 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { browserSupportsWebAuthn, startRegistration } from '@simplewebauthn/browser';
+import type { PublicKeyCredentialCreationOptionsJSON } from '@simplewebauthn/browser';
+import {
+  ArrowPathIcon,
+  CheckIcon,
+  CloudIcon,
+  ExclamationTriangleIcon,
+  KeyIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import type { PasskeyListPayload, PasskeySummary } from '../lib/webauthn';
+import {
+  ApiError,
+  apiFetch,
+  describeTransports,
+  describeWebAuthnError,
+  detectSignalSupport,
+  formatDate,
+  formatTime,
+  isCeremonyCancelled,
+  signalAcceptedCredentials,
+  signalUserDetails,
+  suggestPasskeyName,
+  type SignalSupport,
+} from '../lib/passkey-client';
+
+interface Props {
+  username: string;
+  /** base64url WebAuthn user handle; needed for `signalAllAcceptedCredentials`. */
+  userId: string;
+  rpId: string;
+  initialPasskeys: PasskeySummary[];
+}
+
+type SyncState =
+  | { status: 'pending' }
+  | { status: 'unsupported' }
+  | { status: 'synced'; at: Date }
+  | { status: 'failed'; at: Date };
+
+type Pending = { kind: 'add' } | { kind: 'rename'; id: string } | { kind: 'remove'; id: string } | null;
+
+const PASSKEY_NAME_MAX_LENGTH = 64;
+
+export default function PasskeyManager({ username, userId, rpId, initialPasskeys }: Props) {
+  const [passkeys, setPasskeys] = useState<PasskeySummary[]>(initialPasskeys);
+  const [webauthnSupported, setWebauthnSupported] = useState(true);
+  const [signals, setSignals] = useState<SignalSupport | null>(null);
+  const [sync, setSync] = useState<SyncState>({ status: 'pending' });
+  const [pending, setPending] = useState<Pending>(null);
+  const [editing, setEditing] = useState<{ id: string; draft: string } | null>(null);
+  const [confirmingRemoval, setConfirmingRemoval] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const editInputRef = useRef<HTMLInputElement>(null);
+
+  /**
+   * Push the server's view of this account to the browser: the accepted credential IDs
+   * (so removed passkeys disappear from the authenticator) and the current user name.
+   */
+  const syncAuthenticator = useCallback(
+    async (list: PasskeySummary[]) => {
+      const support = detectSignalSupport();
+      setSignals(support);
+      if (!support.allAcceptedCredentials && !support.currentUserDetails) {
+        setSync({ status: 'unsupported' });
+        return;
+      }
+      const results = await Promise.all([
+        support.allAcceptedCredentials
+          ? signalAcceptedCredentials({ rpId, userId, credentialIds: list.map((p) => p.id) })
+          : Promise.resolve(true),
+        support.currentUserDetails ? signalUserDetails({ rpId, userId, username }) : Promise.resolve(true),
+      ]);
+      setSync({ status: results.every(Boolean) ? 'synced' : 'failed', at: new Date() });
+    },
+    [rpId, userId, username],
+  );
+
+  useEffect(() => {
+    if (!browserSupportsWebAuthn()) {
+      setWebauthnSupported(false);
+      setSync({ status: 'unsupported' });
+      return;
+    }
+    void syncAuthenticator(initialPasskeys);
+    // Only on mount: later syncs are triggered by the actions below.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    if (editing) editInputRef.current?.select();
+  }, [editing?.id]);
+
+  const applyPayload = async (payload: PasskeyListPayload) => {
+    setPasskeys(payload.passkeys);
+    await syncAuthenticator(payload.passkeys);
+  };
+
+  const reportError = (err: unknown, fallback: string) => {
+    if (err instanceof ApiError && err.status === 401) {
+      setError('Your session has expired. Sign in again to manage passkeys.');
+      return;
+    }
+    setError(describeWebAuthnError(err, fallback));
+  };
+
+  const handleAdd = async () => {
+    setError(null);
+    setNotice(null);
+    setPending({ kind: 'add' });
+    try {
+      const options = await apiFetch<PublicKeyCredentialCreationOptionsJSON>('passkeys/register-options', {
+        method: 'POST',
+        body: {},
+      });
+      const attestation = await startRegistration({ optionsJSON: options });
+      const payload = await apiFetch<PasskeyListPayload & { passkey: PasskeySummary }>('passkeys/register-verify', {
+        method: 'POST',
+        body: { response: attestation, name: suggestPasskeyName() },
+      });
+      await applyPayload(payload);
+      setNotice(`Added “${payload.passkey.name}”. You can rename it at any time.`);
+    } catch (err) {
+      if (isCeremonyCancelled(err)) {
+        setNotice('Passkey setup was cancelled.');
+      } else {
+        reportError(err, 'The passkey could not be created.');
+      }
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const startRename = (passkey: PasskeySummary) => {
+    setError(null);
+    setNotice(null);
+    setConfirmingRemoval(null);
+    setEditing({ id: passkey.id, draft: passkey.name });
+  };
+
+  const submitRename = async (event: React.FormEvent) => {
+    event.preventDefault();
+    if (!editing) return;
+    const name = editing.draft.replace(/\s+/g, ' ').trim();
+    const current = passkeys.find((p) => p.id === editing.id);
+    if (!name || name.length > PASSKEY_NAME_MAX_LENGTH) {
+      setError(`Give the passkey a name between 1 and ${PASSKEY_NAME_MAX_LENGTH} characters.`);
+      return;
+    }
+    if (current && current.name === name) {
+      setEditing(null);
+      return;
+    }
+    setError(null);
+    setPending({ kind: 'rename', id: editing.id });
+    try {
+      const payload = await apiFetch<PasskeyListPayload>(`passkeys/${encodeURIComponent(editing.id)}`, {
+        method: 'PATCH',
+        body: { name },
+      });
+      await applyPayload(payload);
+      setEditing(null);
+      setNotice(`Renamed “${current?.name ?? 'passkey'}” to “${name}”.`);
+    } catch (err) {
+      reportError(err, 'The passkey could not be renamed.');
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const handleRemove = async (passkey: PasskeySummary) => {
+    setError(null);
+    setNotice(null);
+    setPending({ kind: 'remove', id: passkey.id });
+    try {
+      const payload = await apiFetch<PasskeyListPayload>(`passkeys/${encodeURIComponent(passkey.id)}`, {
+        method: 'DELETE',
+      });
+      setConfirmingRemoval(null);
+      await applyPayload(payload);
+      const support = detectSignalSupport();
+      setNotice(
+        support.allAcceptedCredentials
+          ? `Removed “${passkey.name}”. Your browser was asked to delete it from this device's authenticator too.`
+          : `Removed “${passkey.name}”. It may still appear in your device's passkey list until you delete it there.`,
+      );
+    } catch (err) {
+      if (err instanceof ApiError && err.status === 404) {
+        // Already gone server-side (another tab, perhaps); refresh the list.
+        try {
+          await applyPayload(await apiFetch<PasskeyListPayload>('passkeys'));
+          setConfirmingRemoval(null);
+          setNotice(`“${passkey.name}” had already been removed.`);
+          return;
+        } catch (refreshErr) {
+          reportError(refreshErr, 'The passkey list could not be refreshed.');
+          return;
+        }
+      }
+      reportError(err, 'The passkey could not be removed.');
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const busy = pending !== null;
+
+  return (
+    <section
+      id="passkeys"
+      aria-labelledby="passkeys-heading"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm"
+    >
+      <div className="flex flex-col gap-4 p-6 border-b border-gray-200 sm:flex-row sm:items-start sm:justify-between">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+            Passkeys
+          </h2>
+          <p className="mt-1 text-sm text-gray-600 max-w-prose">
+            Sign in with your fingerprint, face, or device PIN instead of a password. Passkeys you
+            remove here are also removed from this browser's authenticator.
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleAdd}
+          disabled={busy || !webauthnSupported}
+          data-skip-tracking="true"
+          className="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
+        >
+          {pending?.kind === 'add' ? (
+            <ArrowPathIcon className="h-4 w-4 animate-spin" aria-hidden="true" />
+          ) : (
+            <PlusIcon className="h-4 w-4" aria-hidden="true" />
+          )}
+          {pending?.kind === 'add' ? 'Waiting for your device…' : 'Add a passkey'}
+        </button>
+      </div>
+
+      <div aria-live="polite" className="px-6">
+        {!webauthnSupported && (
+          <p className="mt-4 flex items-start gap-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-800" role="status">
+            <ExclamationTriangleIcon className="mt-0.5 h-4 w-4 flex-shrink-0" aria-hidden="true" />
+            This browser does not support passkeys. You can still review and remove the ones registered to your account.
+          </p>
+        )}
+        {error && (
+          <p className="mt-4 rounded-lg bg-red-100 p-3 text-sm text-red-700" role="alert">
+            {error}
+          </p>
+        )}
+        {notice && (
+          <p className="mt-4 rounded-lg bg-green-100 p-3 text-sm text-green-700" role="status">
+            {notice}
+          </p>
+        )}
+      </div>
+
+      {passkeys.length === 0 ? (
+        <div className="px-6 py-10 text-center">
+          <KeyIcon className="mx-auto h-10 w-10 text-gray-300" aria-hidden="true" />
+          <p className="mt-3 text-sm font-semibold text-gray-800">No passkeys yet</p>
+          <p className="mt-1 text-sm text-gray-500">
+            Add one to sign in to The DevTools Times without typing your password.
+          </p>
+        </div>
+      ) : (
+        <ul className="divide-y divide-gray-200">
+          {passkeys.map((passkey) => {
+            const isEditing = editing?.id === passkey.id;
+            const isConfirming = confirmingRemoval === passkey.id;
+            const rowBusy = pending !== null && pending.kind !== 'add' && pending.id === passkey.id;
+            const synced = passkey.deviceType === 'multiDevice';
+            const transports = describeTransports(passkey.transports);
+            return (
+              <li key={passkey.id} className="px-6 py-4">
+                <div className="flex items-start gap-4">
+                  <span
+                    className={`mt-0.5 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full ${
+                      synced ? 'bg-blue-50 text-blue-700' : 'bg-amber-50 text-amber-700'
+                    }`}
+                    title={synced ? 'Synced passkey' : 'Device-bound passkey'}
+                  >
+                    {synced ? (
+                      <CloudIcon className="h-5 w-5" aria-hidden="true" />
+                    ) : (
+                      <KeyIcon className="h-5 w-5" aria-hidden="true" />
+                    )}
+                  </span>
+
+                  <div className="min-w-0 flex-grow">
+                    {isEditing ? (
+                      <form onSubmit={submitRename} className="flex flex-wrap items-center gap-2">
+                        <label htmlFor={`passkey-name-${passkey.id}`} className="sr-only">
+                          Passkey name
+                        </label>
+                        <input
+                          ref={editInputRef}
+                          id={`passkey-name-${passkey.id}`}
+                          type="text"
+                          value={editing.draft}
+                          maxLength={PASSKEY_NAME_MAX_LENGTH}
+                          onChange={(e) => setEditing({ id: passkey.id, draft: e.target.value })}
+                          onKeyDown={(e) => {
+                            if (e.key === 'Escape') setEditing(null);
+                          }}
+                          disabled={rowBusy}
+                          className="w-full max-w-xs rounded-md border border-gray-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                        />
+                        <button
+                          type="submit"
+                          disabled={rowBusy}
+                          className="inline-flex items-center gap-1 rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-60"
+                        >
+                          {rowBusy ? (
+                            <ArrowPathIcon className="h-4 w-4 animate-spin" aria-hidden="true" />
+                          ) : (
+                            <CheckIcon className="h-4 w-4" aria-hidden="true" />
+                          )}
+                          Save
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setEditing(null)}
+                          disabled={rowBusy}
+                          className="inline-flex items-center gap-1 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-60"
+                        >
+                          <XMarkIcon className="h-4 w-4" aria-hidden="true" />
+                          Cancel
+                        </button>
+                      </form>
+                    ) : (
+                      <p className="truncate font-semibold text-gray-900">{passkey.name}</p>
+                    )}
+
+                    <p className="mt-1 text-xs text-gray-500" suppressHydrationWarning>
+                      Added {formatDate(passkey.createdAt)}
+                      {' · '}
+                      {passkey.lastUsedAt ? `Last used ${formatDate(passkey.lastUsedAt)}` : 'Not used yet'}
+                      {transports && ` · ${transports}`}
+                    </p>
+                    <div className="mt-2 flex flex-wrap gap-1.5">
+                      <span
+                        className={`inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${
+                          synced ? 'bg-blue-50 text-blue-700' : 'bg-amber-50 text-amber-800'
+                        }`}
+                      >
+                        {synced ? 'Synced across devices' : 'Bound to one device'}
+                      </span>
+                      {synced && (
+                        <span
+                          className={`inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${
+                            passkey.backedUp ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-600'
+                          }`}
+                        >
+                          {passkey.backedUp ? 'Backed up' : 'Not backed up'}
+                        </span>
+                      )}
+                    </div>
+
+                    {isConfirming && (
+                      <div className="mt-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">
+                        <p>
+                          Remove <strong>{passkey.name}</strong>? You will no longer be able to sign in with it
+                          {passkeys.length === 1 && ', and you will need your password to sign in'}.
+                        </p>
+                        <div className="mt-2 flex gap-2">
+                          <button
+                            type="button"
+                            onClick={() => handleRemove(passkey)}
+                            disabled={rowBusy}
+                            className="inline-flex items-center gap-1 rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-60"
+                          >
+                            {rowBusy ? (
+                              <ArrowPathIcon className="h-4 w-4 animate-spin" aria-hidden="true" />
+                            ) : (
+                              <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                            )}
+                            Remove passkey
+                          </button>
+                          <button
