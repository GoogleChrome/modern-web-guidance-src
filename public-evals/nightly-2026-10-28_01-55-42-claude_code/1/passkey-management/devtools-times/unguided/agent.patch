+
+                  {!isEditing && !isConfirming && (
+                    <div className="flex flex-shrink-0 items-center gap-1">
+                      <button
+                        type="button"
+                        onClick={() => startRename(passkey)}
+                        disabled={busy}
+                        aria-label={`Rename ${passkey.name}`}
+                        title="Rename"
+                        className="rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-50"
+                      >
+                        <PencilSquareIcon className="h-5 w-5" aria-hidden="true" />
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => {
+                          setError(null);
+                          setNotice(null);
+                          setEditing(null);
+                          setConfirmingRemoval(passkey.id);
+                        }}
+                        disabled={busy}
+                        aria-label={`Remove ${passkey.name}`}
+                        title="Remove"
+                        className="rounded-md p-2 text-gray-500 hover:bg-red-50 hover:text-red-700 disabled:opacity-50"
