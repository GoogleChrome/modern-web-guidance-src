--- /dev/null
+++ b/src/lib/api.ts
@@ -0,0 +1,40 @@
+import type { APIContext } from 'astro';
+import { getSessionUser, type SessionUser } from './session';
+
+export function json(data: unknown, init: ResponseInit = {}): Response {
+  const headers = new Headers(init.headers);
+  headers.set('Content-Type', 'application/json');
+  headers.set('Cache-Control', 'no-store');
+  return new Response(JSON.stringify(data), { ...init, headers });
+}
+
+export function jsonError(status: number, error: string, message: string, extra: Record<string, unknown> = {}): Response {
+  return json({ error, message, ...extra }, { status });
+}
+
+/**
+ * Parse a JSON request body. Rejects requests without a JSON content type so that
+ * cross-site HTML forms (which can only send form encodings) cannot drive these endpoints.
+ */
+export async function readJsonBody<T>(request: Request): Promise<T | null> {
+  const contentType = request.headers.get('content-type') ?? '';
+  if (!contentType.toLowerCase().includes('application/json')) return null;
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+type AuthedContext = Pick<APIContext, 'session'>;
+
+/** Resolve the signed-in reader or produce the 401 response to return instead. */
+export async function requireUser(
+  context: AuthedContext,
+): Promise<{ user: SessionUser; response?: undefined } | { user?: undefined; response: Response }> {
+  const user = await getSessionUser(context.session);
+  if (!user) {
+    return { response: jsonError(401, 'AUTH_REQUIRED', 'Sign in to manage your passkeys.') };
+  }
+  return { user };
+}
diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..8219b86
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,189 @@
+/**
+ * Browser-side helpers shared by the sign-in form and the passkey manager.
+ * Everything here runs in React islands, never on the server.
+ */
+import { sendSignal } from '@simplewebauthn/browser';
+
+export class ApiError extends Error {
+  constructor(
+    public status: number,
+    public code: string,
+    message: string,
+    public data: Record<string, unknown> = {},
+  ) {
+    super(message);
+    this.name = 'ApiError';
+  }
+}
+
+export function apiUrl(path: string): string {
+  return `${import.meta.env.BASE_URL}api/${path}`;
+}
+
+/** Fetch a JSON API route; throws `ApiError` with the server's error code on non-2xx. */
+export async function apiFetch<T>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const hasBody = init.body !== undefined;
+  const response = await fetch(apiUrl(path), {
+    method: init.method ?? 'GET',
+    headers: hasBody ? { 'Content-Type': 'application/json' } : undefined,
+    body: hasBody ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  const data = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!response.ok) {
+    throw new ApiError(
+      response.status,
+      typeof data.error === 'string' ? data.error : 'REQUEST_FAILED',
+      typeof data.message === 'string' ? data.message : `Request failed (${response.status}).`,
+      data,
+    );
+  }
+  return data as T;
+}
+
+/* ---------- WebAuthn Signal API ---------- */
+
+export interface SignalSupport {
+  allAcceptedCredentials: boolean;
+  currentUserDetails: boolean;
+  unknownCredential: boolean;
+}
+
+/** Feature-detect `PublicKeyCredential.signal*()` (the WebAuthn Signal API). */
+export function detectSignalSupport(): SignalSupport {
+  const pkc = (globalThis as unknown as { PublicKeyCredential?: Record<string, unknown> }).PublicKeyCredential;
+  return {
+    allAcceptedCredentials: typeof pkc?.signalAllAcceptedCredentials === 'function',
+    currentUserDetails: typeof pkc?.signalCurrentUserDetails === 'function',
+    unknownCredential: typeof pkc?.signalUnknownCredential === 'function',
+  };
+}
+
+/**
+ * Tell the browser which passkeys the server still accepts for this user, so it can hide or
+ * delete stale ones from the authenticator. Returns false when unsupported or rejected.
+ */
+export async function signalAcceptedCredentials(opts: {
+  rpId: string;
+  userId: string;
+  credentialIds: string[];
+}): Promise<boolean> {
+  if (!detectSignalSupport().allAcceptedCredentials) return false;
+  try {
+    await sendSignal({
+      signalName: 'allAcceptedCredentials',
+      rpID: opts.rpId,
+      userID: opts.userId,
+      allAcceptedCredentialIDs: opts.credentialIds,
+    });
+    return true;
+  } catch (error) {
+    console.warn('[passkeys] signalAllAcceptedCredentials failed:', error);
+    return false;
+  }
+}
+
+/** Refresh the user name shown by the authenticator next to this account's passkeys. */
+export async function signalUserDetails(opts: {
+  rpId: string;
+  userId: string;
+  username: string;
+  displayName?: string;
+}): Promise<boolean> {
+  if (!detectSignalSupport().currentUserDetails) return false;
+  try {
+    await sendSignal({
+      signalName: 'currentUserDetails',
+      rpID: opts.rpId,
+      userID: opts.userId,
+      userName: opts.username,
+      userDisplayName: opts.displayName ?? opts.username,
+    });
+    return true;
+  } catch (error) {
+    console.warn('[passkeys] signalCurrentUserDetails failed:', error);
+    return false;
+  }
+}
+
+/** Tell the browser a credential it offered is unknown to the server, so it can be removed. */
+export async function signalUnknownCredential(opts: { rpId: string; credentialId: string }): Promise<boolean> {
+  if (!detectSignalSupport().unknownCredential) return false;
+  try {
+    await sendSignal({ signalName: 'unknownCredential', rpID: opts.rpId, credentialID: opts.credentialId });
+    return true;
+  } catch (error) {
+    console.warn('[passkeys] signalUnknownCredential failed:', error);
+    return false;
+  }
+}
+
+/* ---------- Presentation helpers ---------- */
+
+/** Was this a user cancellation / timeout rather than a real failure? */
+export function isCeremonyCancelled(error: unknown): boolean {
+  if (!(error instanceof Error)) return false;
+  const code = (error as { code?: string }).code;
+  return error.name === 'NotAllowedError' || error.name === 'AbortError' || code === 'ERROR_CEREMONY_ABORTED';
+}
+
+export function describeWebAuthnError(error: unknown, fallback: string): string {
+  if (error instanceof ApiError) return error.message;
+  if (!(error instanceof Error)) return fallback;
+  const code = (error as { code?: string }).code;
+  switch (code) {
+    case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+      return 'This authenticator already holds a passkey for your account.';
+    case 'ERROR_INVALID_RP_ID':
+    case 'ERROR_INVALID_DOMAIN':
+      return 'Passkeys are not available on this address. Open the site over HTTPS or on localhost.';
+    case 'ERROR_AUTHENTICATOR_MISSING_DISCOVERABLE_CREDENTIAL_SUPPORT':
+      return 'This authenticator cannot store passkeys. Try a different device or security key.';
+  }
+  if (error.name === 'SecurityError') {
+    return 'Passkeys are not available on this address. Open the site over HTTPS or on localhost.';
+  }
+  return error.message || fallback;
+}
+
+/** A sensible default name for a freshly created passkey, based on the current platform. */
+export function suggestPasskeyName(): string {
+  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
+  const platform = nav.userAgentData?.platform || '';
+  const ua = navigator.userAgent;
+  const os =
+    platform ||
+    (/iPhone|iPad/.test(ua) && 'iOS') ||
+    (/Android/.test(ua) && 'Android') ||
+    (/Mac/.test(ua) && 'macOS') ||
+    (/Windows/.test(ua) && 'Windows') ||
+    (/CrOS/.test(ua) && 'ChromeOS') ||
+    (/Linux/.test(ua) && 'Linux') ||
+    '';
+  return os ? `Passkey on ${os}` : 'New passkey';
+}
+
+export function formatDate(iso: string | null): string {
+  if (!iso) return '';
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return '';
+  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+}
+
+export function formatTime(date: Date): string {
+  return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
+}
+
+const TRANSPORT_LABELS: Record<string, string> = {
+  internal: 'This device',
+  hybrid: 'Phone or tablet',
+  usb: 'USB security key',
+  nfc: 'NFC',
+  ble: 'Bluetooth',
+  'smart-card': 'Smart card',
+};
+
+export function describeTransports(transports: string[]): string {
+  const labels = transports.map((t) => TRANSPORT_LABELS[t]).filter((label): label is string => Boolean(label));
+  return [...new Set(labels)].join(' · ');
+}
diff --git a/src/lib/passkey-store.ts b/src/lib/passkey-store.ts
