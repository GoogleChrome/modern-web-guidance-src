+      <div className="flex flex-wrap items-center justify-between gap-2 border-t border-gray-200 bg-gray-50 px-6 py-3 text-xs text-gray-500 rounded-b-lg">
+        <SyncStatus sync={sync} signals={signals} />
+        <button
+          type="button"
+          onClick={() => void syncAuthenticator(passkeys)}
+          disabled={busy || sync.status === 'unsupported' || sync.status === 'pending'}
+          className="inline-flex items-center gap-1 font-semibold text-gray-700 hover:text-gray-900 disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          <ArrowPathIcon className="h-3.5 w-3.5" aria-hidden="true" />
+          Sync again
+        </button>
+      </div>
+    </section>
+  );
+}
+
+function SyncStatus({ sync, signals }: { sync: SyncState; signals: SignalSupport | null }) {
+  switch (sync.status) {
+    case 'pending':
+      return <span>Checking browser authenticator…</span>;
+    case 'unsupported':
+      return (
+        <span>
+          This browser cannot be told about passkey changes automatically. Passkeys removed here may linger in
+          your device's passkey list.
+        </span>
+      );
+    case 'synced':
+      return (
+        <span className="inline-flex items-center gap-1 text-green-700">
+          <CheckIcon className="h-3.5 w-3.5" aria-hidden="true" />
+          Browser authenticator synced at {formatTime(sync.at)}
+          {signals && !signals.currentUserDetails && ' (credential list only)'}
+        </span>
+      );
+    case 'failed':
+      return (
+        <span className="inline-flex items-center gap-1 text-amber-700">
+          <ExclamationTriangleIcon className="h-3.5 w-3.5" aria-hidden="true" />
+          The browser rejected the last sync at {formatTime(sync.at)}. Try again.
+        </span>
+      );
+  }
+}
