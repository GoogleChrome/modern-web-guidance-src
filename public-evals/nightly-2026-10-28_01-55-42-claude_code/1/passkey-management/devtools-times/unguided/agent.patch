index 0000000..699325e
--- /dev/null
+++ b/src/lib/passkey-store.ts
@@ -0,0 +1,174 @@
+/**
+ * A small file-backed store for passkeys (WebAuthn credentials).
+ *
+ * The DevTools Times verifies passwords against an external demo service that does not
+ * expose user records, so passkey material lives here, keyed by username. The store is a
+ * single JSON document; writes are serialised and performed atomically.
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { generateUserID, isoBase64URL } from '@simplewebauthn/server/helpers';
+
+export type PasskeyDeviceType = 'singleDevice' | 'multiDevice';
+
+export interface StoredPasskey {
+  /** base64url credential ID. */
+  id: string;
+  /** Reader-chosen display name. */
+  name: string;
+  /** base64url-encoded COSE public key. */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: PasskeyDeviceType;
+  backedUp: boolean;
+  aaguid: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface StoredUser {
+  username: string;
+  /** base64url-encoded WebAuthn user handle. */
+  userId: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreFile {
+  version: 1;
+  users: Record<string, StoredUser>;
+}
+
+const EMPTY_STORE: StoreFile = { version: 1, users: {} };
+
+function storePath(): string {
+  return process.env.PASSKEY_STORE_PATH || path.join(process.cwd(), 'data', 'passkeys.json');
+}
+
+async function load(): Promise<StoreFile> {
+  try {
+    const raw = await fs.readFile(storePath(), 'utf8');
+    const parsed = JSON.parse(raw) as Partial<StoreFile>;
+    if (parsed && parsed.version === 1 && parsed.users && typeof parsed.users === 'object') {
+      return parsed as StoreFile;
+    }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {
+      console.error('[passkey-store] Could not read store, starting empty:', error);
+    }
+  }
+  return structuredClone(EMPTY_STORE);
+}
+
+async function persist(store: StoreFile): Promise<void> {
+  const file = storePath();
+  await fs.mkdir(path.dirname(file), { recursive: true });
+  const tmp = `${file}.${process.pid}.${Date.now()}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(store, null, 2), 'utf8');
+  await fs.rename(tmp, file);
+}
+
+// Serialise read-modify-write cycles so concurrent requests cannot clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+function mutate<T>(fn: (store: StoreFile) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await load();
+    const result = await fn(store);
+    await persist(store);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+function normalizeUsername(username: string): string {
+  return username.trim();
+}
+
+export async function getUser(username: string): Promise<StoredUser | null> {
+  const store = await load();
+  return store.users[normalizeUsername(username)] ?? null;
+}
+
+export async function getOrCreateUser(username: string): Promise<StoredUser> {
+  const key = normalizeUsername(username);
+  const existing = await getUser(key);
+  if (existing) return existing;
+  const userId = isoBase64URL.fromBuffer(await generateUserID());
+  return mutate((store) => {
+    store.users[key] ??= { username: key, userId, passkeys: [] };
+    return store.users[key];
+  });
+}
+
+export async function findUserByCredentialId(
+  credentialId: string,
+): Promise<{ user: StoredUser; passkey: StoredPasskey } | null> {
+  const store = await load();
+  for (const user of Object.values(store.users)) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) return { user, passkey };
+  }
+  return null;
+}
+
+export class DuplicatePasskeyError extends Error {
+  constructor() {
+    super('This passkey is already registered.');
+    this.name = 'DuplicatePasskeyError';
+  }
+}
+
+export async function addPasskey(username: string, passkey: StoredPasskey): Promise<StoredUser> {
+  const key = normalizeUsername(username);
+  return mutate((store) => {
+    const taken = Object.values(store.users).some((u) => u.passkeys.some((p) => p.id === passkey.id));
+    if (taken) throw new DuplicatePasskeyError();
+    const user = store.users[key];
+    if (!user) throw new Error(`Unknown user "${key}"`);
+    user.passkeys.push(passkey);
+    return user;
+  });
+}
+
+export async function renamePasskey(
+  username: string,
+  credentialId: string,
+  name: string,
+): Promise<StoredUser | null> {
+  const key = normalizeUsername(username);
+  return mutate((store) => {
+    const user = store.users[key];
+    const passkey = user?.passkeys.find((p) => p.id === credentialId);
+    if (!user || !passkey) return null;
+    passkey.name = name;
+    return user;
+  });
+}
+
+export async function removePasskey(username: string, credentialId: string): Promise<StoredUser | null> {
+  const key = normalizeUsername(username);
+  return mutate((store) => {
+    const user = store.users[key];
+    if (!user) return null;
+    const before = user.passkeys.length;
+    user.passkeys = user.passkeys.filter((p) => p.id !== credentialId);
+    return user.passkeys.length === before ? null : user;
+  });
+}
+
+export async function recordPasskeyUse(
+  username: string,
+  credentialId: string,
+  update: { counter: number; backedUp: boolean },
+): Promise<void> {
+  const key = normalizeUsername(username);
+  await mutate((store) => {
+    const passkey = store.users[key]?.passkeys.find((p) => p.id === credentialId);
+    if (!passkey) return;
+    passkey.counter = update.counter;
+    passkey.backedUp = update.backedUp;
+    passkey.lastUsedAt = new Date().toISOString();
+  });
+}
diff --git a/src/lib/session.ts b/src/lib/session.ts
