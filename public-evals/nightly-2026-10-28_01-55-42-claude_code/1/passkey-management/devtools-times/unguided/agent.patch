@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import { json, jsonError, readJsonBody, requireUser } from '../../../lib/api';
+import { removePasskey, renamePasskey } from '../../../lib/passkey-store';
+import {
+  PASSKEY_NAME_MAX_LENGTH,
+  getRelyingParty,
+  normalizePasskeyName,
+  toPasskeyListPayload,
+} from '../../../lib/webauthn';
+
+/** Rename one of the signed-in reader's passkeys. */
+export const PATCH: APIRoute = async (context) => {
+  const auth = await requireUser(context);
+  if (auth.response) return auth.response;
+
+  const body = await readJsonBody<{ name?: unknown }>(context.request);
+  const name = normalizePasskeyName(body?.name);
+  if (!name) {
+    return jsonError(
+      400,
+      'PASSKEY_NAME_INVALID',
+      `Give the passkey a name between 1 and ${PASSKEY_NAME_MAX_LENGTH} characters.`,
+    );
+  }
+
+  const user = await renamePasskey(auth.user.username, context.params.id ?? '', name);
+  if (!user) {
+    return jsonError(404, 'PASSKEY_NOT_FOUND', 'That passkey is not registered to your account.');
+  }
+  return json(toPasskeyListPayload(user, getRelyingParty(context.request)));
+};
+
+/** Remove one of the signed-in reader's passkeys. */
+export const DELETE: APIRoute = async (context) => {
+  const auth = await requireUser(context);
+  if (auth.response) return auth.response;
+
+  const user = await removePasskey(auth.user.username, context.params.id ?? '');
+  if (!user) {
+    return jsonError(404, 'PASSKEY_NOT_FOUND', 'That passkey is not registered to your account.');
+  }
+  return json(toPasskeyListPayload(user, getRelyingParty(context.request)));
+};
diff --git a/src/pages/api/passkeys/authenticate-options.ts b/src/pages/api/passkeys/authenticate-options.ts
new file mode 100644
index 0000000..bb9d99b
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate-options.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { json, jsonError } from '../../../lib/api';
+import { storeChallenge } from '../../../lib/session';
+import { getRelyingParty } from '../../../lib/webauthn';
+
+/** Step 1 of passkey sign-in: produce `navigator.credentials.get()` options for a discoverable credential. */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return jsonError(500, 'SESSION_UNAVAILABLE', 'Sessions are not available on this server.');
+  }
+
+  const { rpID } = getRelyingParty(request);
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials: [],
+    userVerification: 'preferred',
+  });
+
+  await storeChallenge(session, { kind: 'authentication', challenge: options.challenge });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/authenticate-verify.ts b/src/pages/api/passkeys/authenticate-verify.ts
new file mode 100644
index 0000000..2912c06
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate-verify.ts
@@ -0,0 +1,84 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { json, jsonError, readJsonBody } from '../../../lib/api';
+import { findUserByCredentialId, recordPasskeyUse } from '../../../lib/passkey-store';
+import { consumeChallenge, signInSession } from '../../../lib/session';
+import { getRelyingParty } from '../../../lib/webauthn';
+
+/**
+ * Step 2 of passkey sign-in: verify the assertion and establish a session.
+ *
+ * When the browser presents a credential this server no longer knows about (for example a
+ * passkey removed from account settings on another device) the response carries
+ * `PASSKEY_UNKNOWN_CREDENTIAL` plus the credential ID so the client can ask the browser to
+ * forget it via `PublicKeyCredential.signalUnknownCredential()`.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return jsonError(500, 'SESSION_UNAVAILABLE', 'Sessions are not available on this server.');
+  }
+
+  const body = await readJsonBody<{ response?: AuthenticationResponseJSON }>(request);
+  const response = body?.response;
+  if (!response?.id || !response.response) {
+    return jsonError(400, 'PASSKEY_RESPONSE_INVALID', 'Missing authentication response.');
+  }
+
+  const pending = await consumeChallenge(session, 'authentication');
+  if (!pending) {
+    return jsonError(400, 'PASSKEY_CHALLENGE_EXPIRED', 'This sign-in attempt expired. Please try again.');
+  }
+
+  const rp = getRelyingParty(request);
+  const match = await findUserByCredentialId(response.id);
+  if (!match) {
+    return jsonError(404, 'PASSKEY_UNKNOWN_CREDENTIAL', 'This passkey is no longer registered with The DevTools Times.', {
+      credentialId: response.id,
+      rpId: rp.rpID,
+    });
+  }
+  const { user, passkey } = match;
+
+  // A discoverable credential reports the user handle it was created with; it must be ours.
+  if (response.response.userHandle && response.response.userHandle !== user.userId) {
+    return jsonError(400, 'PASSKEY_USER_MISMATCH', 'This passkey does not belong to the expected account.');
+  }
+
+  let verification: Awaited<ReturnType<typeof verifyAuthenticationResponse>>;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: rp.origin,
+      expectedRPID: rp.rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: false,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Sign-in could not be verified.';
+    return jsonError(400, 'PASSKEY_VERIFICATION_FAILED', message);
+  }
+  if (!verification.verified) {
+    return jsonError(401, 'PASSKEY_VERIFICATION_FAILED', 'Sign-in could not be verified.');
+  }
+
+  await recordPasskeyUse(user.username, passkey.id, {
+    counter: verification.authenticationInfo.newCounter,
+    backedUp: verification.authenticationInfo.credentialBackedUp,
+  });
+  await signInSession(session, { username: user.username, userId: user.userId });
+
+  return json({
+    ok: true,
+    user: { username: user.username },
+    rpId: rp.rpID,
+    userId: user.userId,
+    allAcceptedCredentialIds: user.passkeys.map((p) => p.id),
+  });
+};
