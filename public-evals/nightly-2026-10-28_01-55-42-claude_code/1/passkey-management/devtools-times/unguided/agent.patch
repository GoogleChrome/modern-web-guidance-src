@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { json, jsonError, requireUser } from '../../../lib/api';
+import { getOrCreateUser } from '../../../lib/passkey-store';
+import { storeChallenge } from '../../../lib/session';
+import { RP_NAME, getRelyingParty } from '../../../lib/webauthn';
+
+/** Step 1 of adding a passkey: produce `navigator.credentials.create()` options. */
+export const POST: APIRoute = async (context) => {
+  const auth = await requireUser(context);
+  if (auth.response) return auth.response;
+  if (!context.session) {
+    return jsonError(500, 'SESSION_UNAVAILABLE', 'Sessions are not available on this server.');
+  }
+
+  const user = await getOrCreateUser(auth.user.username);
+  const { rpID } = getRelyingParty(context.request);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: user.username,
+    userDisplayName: user.username,
+    userID: isoBase64URL.toBuffer(user.userId),
+    attestationType: 'none',
+    // Stop the authenticator from creating a second credential for one it already holds.
+    excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+
+  await storeChallenge(context.session, {
+    kind: 'registration',
+    challenge: options.challenge,
+    username: user.username,
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..92195bf
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,76 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { json, jsonError, readJsonBody, requireUser } from '../../../lib/api';
+import { DuplicatePasskeyError, addPasskey, getOrCreateUser, type StoredPasskey } from '../../../lib/passkey-store';
+import { consumeChallenge } from '../../../lib/session';
+import {
+  getRelyingParty,
+  normalizePasskeyName,
+  toPasskeyListPayload,
+  toPasskeySummary,
+} from '../../../lib/webauthn';
+
+/** Step 2 of adding a passkey: verify the attestation and store the new credential. */
+export const POST: APIRoute = async (context) => {
+  const auth = await requireUser(context);
+  if (auth.response) return auth.response;
+  if (!context.session) {
+    return jsonError(500, 'SESSION_UNAVAILABLE', 'Sessions are not available on this server.');
+  }
+
+  const body = await readJsonBody<{ response?: RegistrationResponseJSON; name?: unknown }>(context.request);
+  if (!body?.response?.id || !body.response.response) {
+    return jsonError(400, 'PASSKEY_RESPONSE_INVALID', 'Missing registration response.');
+  }
+
+  const pending = await consumeChallenge(context.session, 'registration');
+  if (!pending || pending.username !== auth.user.username) {
+    return jsonError(400, 'PASSKEY_CHALLENGE_EXPIRED', 'This registration attempt expired. Please try again.');
+  }
+
+  const rp = getRelyingParty(context.request);
+  let verification: Awaited<ReturnType<typeof verifyRegistrationResponse>>;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: rp.origin,
+      expectedRPID: rp.rpID,
+      requireUserVerification: false,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Registration could not be verified.';
+    return jsonError(400, 'PASSKEY_VERIFICATION_FAILED', message);
+  }
+  if (!verification.verified) {
+    return jsonError(400, 'PASSKEY_VERIFICATION_FAILED', 'Registration could not be verified.');
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = verification.registrationInfo;
+  const passkey: StoredPasskey = {
+    id: credential.id,
+    name: normalizePasskeyName(body.name) ?? 'New passkey',
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports ?? body.response.response.transports ?? [],
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    aaguid,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+
+  await getOrCreateUser(auth.user.username);
+  let user;
+  try {
+    user = await addPasskey(auth.user.username, passkey);
+  } catch (error) {
+    if (error instanceof DuplicatePasskeyError) {
+      return jsonError(409, 'PASSKEY_DUPLICATE', error.message);
+    }
+    throw error;
+  }
+
+  return json({ passkey: toPasskeySummary(passkey), ...toPasskeyListPayload(user, rp) }, { status: 201 });
+};
