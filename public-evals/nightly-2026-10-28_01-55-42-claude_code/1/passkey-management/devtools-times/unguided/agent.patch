--- /dev/null
+++ b/src/pages/api/auth/signin.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import { json, jsonError, readJsonBody } from '../../../lib/api';
+import { getOrCreateUser } from '../../../lib/passkey-store';
+import { signInSession } from '../../../lib/session';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+const UPSTREAM_TIMEOUT_MS = 10_000;
+
+/**
+ * Password sign-in. Credentials are checked against the Times account service on the
+ * server so that a session is only ever established after a successful verification.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJsonBody<{ username?: unknown; password?: unknown }>(request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) {
+    return jsonError(400, 'APP_ERR_2000', 'Username and password are required.');
+  }
+  if (!session) {
+    return jsonError(500, 'SESSION_UNAVAILABLE', 'Sessions are not available on this server.');
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(UPSTREAM_TIMEOUT_MS),
+    });
+  } catch {
+    return jsonError(502, 'AUTH_UPSTREAM_UNAVAILABLE', 'The sign-in service is unreachable. Please try again later.');
+  }
+
+  const data = (await upstream.json().catch(() => ({}))) as { error?: string; message?: string };
+  if (!upstream.ok) {
+    if (upstream.status >= 500) {
+      return jsonError(502, 'AUTH_UPSTREAM_ERROR', 'The sign-in service returned an error. Please try again later.');
+    }
+    // Pass the service's own error codes (APP_ERR_2001, APP_ERR_2002, ...) through unchanged.
+    return jsonError(upstream.status, data.error ?? 'AUTH_FAILED', data.message ?? 'Sign-in failed.');
+  }
+
+  const user = await getOrCreateUser(username);
+  await signInSession(session, { username: user.username, userId: user.userId });
+  return json({ ok: true, user: { username: user.username } });
+};
diff --git a/src/pages/api/auth/signout.ts b/src/pages/api/auth/signout.ts
