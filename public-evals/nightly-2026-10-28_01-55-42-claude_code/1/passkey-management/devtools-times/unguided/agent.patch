+++ b/src/pages/api/auth/signout.ts
@@ -0,0 +1,12 @@
+import type { APIRoute } from 'astro';
+import { json, jsonError } from '../../../lib/api';
+import { signOutSession } from '../../../lib/session';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // Only accept JSON requests so a cross-site HTML form cannot sign readers out.
+  if (!(request.headers.get('content-type') ?? '').toLowerCase().includes('application/json')) {
+    return jsonError(415, 'UNSUPPORTED_MEDIA_TYPE', 'Send a JSON request.');
+  }
+  if (session) signOutSession(session);
+  return json({ ok: true });
+};
