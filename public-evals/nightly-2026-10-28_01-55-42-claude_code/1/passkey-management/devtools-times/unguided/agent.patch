+---
+import Layout from '../layouts/Layout.astro';
+import PasskeyManager from '../components/PasskeyManager';
+import SignOutButton from '../components/SignOutButton';
+import { getSessionUser } from '../lib/session';
+import { getOrCreateUser } from '../lib/passkey-store';
+import { getRelyingParty, toPasskeySummary } from '../lib/webauthn';
+
+const baseUrl = import.meta.env.BASE_URL;
+
+const sessionUser = await getSessionUser(Astro.session);
+if (!sessionUser) {
+  return Astro.redirect(`${baseUrl}signin?next=account`);
+}
+
+const user = await getOrCreateUser(sessionUser.username);
+const { rpID } = getRelyingParty(Astro.request);
+const passkeys = user.passkeys.map(toPasskeySummary);
+const initial = user.username.charAt(0).toUpperCase();
+
+Astro.response.headers.set('Cache-Control', 'private, no-store');
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+    <div class="flex flex-col gap-4 border-b-2 border-gray-900 pb-4 mb-8 sm:flex-row sm:items-end sm:justify-between">
+      <div>
+        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Your account</p>
+        <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Account settings</h1>
+      </div>
+      <nav aria-label="Account sections" class="flex gap-4 text-sm font-semibold text-gray-600">
+        <a href="#profile" class="hover:text-amber-500">Profile</a>
+        <a href="#passkeys" class="hover:text-amber-500">Passkeys</a>
+        <a href="#session" class="hover:text-amber-500">Session</a>
+      </nav>
+    </div>
+
+    <div class="space-y-8">
+      <!-- Profile -->
+      <section id="profile" aria-labelledby="profile-heading" class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <h2 id="profile-heading" class="text-xl font-bold text-gray-900">Profile</h2>
+        <div class="mt-4 flex items-center gap-4">
+          <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-amber-400 text-2xl font-bold text-white font-brand" aria-hidden="true">
+            {initial}
+          </span>
+          <dl class="grid grid-cols-1 gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
+            <div>
+              <dt class="text-gray-500">Username</dt>
+              <dd class="font-semibold text-gray-900">{user.username}</dd>
+            </div>
+            <div>
+              <dt class="text-gray-500">Sign-in methods</dt>
+              <dd class="font-semibold text-gray-900">
+                Password{passkeys.length > 0 && ` · ${passkeys.length} passkey${passkeys.length === 1 ? '' : 's'}`}
+              </dd>
+            </div>
+          </dl>
+        </div>
+      </section>
+
+      <!-- Passkeys -->
+      <PasskeyManager
+        client:load
+        username={user.username}
+        userId={user.userId}
+        rpId={rpID}
+        initialPasskeys={passkeys}
+      />
+
+      <!-- Session -->
+      <section id="session" aria-labelledby="session-heading" class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
+          <div>
+            <h2 id="session-heading" class="text-xl font-bold text-gray-900">Session</h2>
+            <p class="mt-1 text-sm text-gray-600">Sign out of The DevTools Times on this browser. Your reading list stays saved.</p>
+          </div>
+          <SignOutButton client:load className="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-800 shadow-sm hover:bg-gray-50 disabled:opacity-60" />
+        </div>
+      </section>
+    </div>
+  </div>
+</Layout>
