+    }
+
+    .strength-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 12px;
+      margin-bottom: 14px;
+    }
+
+    .strength-header label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .strength-header output {
+      font-weight: 700;
+      color: var(--accent);
+      background: var(--primary);
+      padding: 3px 12px;
+      border-radius: 999px;
+      font-size: 0.9rem;
+      font-variant-numeric: tabular-nums;
+    }
+
+    /* The native range input: we only reset its box and paint the parts.
+       --fill is the current value as a percentage, kept in sync by the
+       script below and seeded inline so the track is right before JS runs. */
+    .strength-slider {
+      --track-h: 8px;
+      --thumb-s: 24px;
+      --fill: 50%;
+      -webkit-appearance: none;
+      appearance: none;
+      width: 100%;
+      height: var(--thumb-s);
+      margin: 0;
+      background: transparent;
+      cursor: pointer;
+      touch-action: pan-y;
+    }
+
+    /* Track (WebKit/Blink) with the fill painted as a hard-stop gradient */
+    .strength-slider::-webkit-slider-runnable-track {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: linear-gradient(to right,
+          var(--accent) 0 var(--fill),
+          var(--secondary) var(--fill) 100%);
+    }
+
+    /* Track + separate progress part (Firefox) */
+    .strength-slider::-moz-range-track {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: var(--secondary);
+    }
+
+    .strength-slider::-moz-range-progress {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: var(--accent);
+    }
+
+    /* Thumb */
+    .strength-slider::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb-s);
+      height: var(--thumb-s);
+      /* Centre the thumb on the thinner track */
+      margin-top: calc((var(--track-h) - var(--thumb-s)) / 2);
+      border-radius: 50%;
+      background: var(--primary);
+      border: 3px solid white;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
+      transition: transform 0.15s ease, box-shadow 0.15s ease;
+    }
+
+    .strength-slider::-moz-range-thumb {
+      width: var(--thumb-s);
+      height: var(--thumb-s);
+      border-radius: 50%;
+      background: var(--primary);
+      border: 3px solid white;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
+      transition: transform 0.15s ease, box-shadow 0.15s ease;
+    }
+
+    /* Hover / active feedback */
+    .strength-slider:hover::-webkit-slider-thumb,
+    .strength-slider:active::-webkit-slider-thumb {
+      transform: scale(1.12);
+    }
+
+    .strength-slider:hover::-moz-range-thumb,
+    .strength-slider:active::-moz-range-thumb {
+      transform: scale(1.12);
+    }
+
+    /* Focus: drop the default outline on the input box and draw a clear
+       ring around the thumb instead, so keyboard users can see it. */
+    .strength-slider:focus {
+      outline: none;
+    }
+
+    .strength-slider:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 4px white, 0 0 0 7px var(--accent);
+    }
+
+    .strength-slider:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 4px white, 0 0 0 7px var(--accent);
+    }
+
+    /* Forced-colors / high-contrast mode: let the system paint it */
+    @media (forced-colors: active) {
+      .strength-slider {
+        -webkit-appearance: auto;
+        appearance: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .strength-slider::-webkit-slider-thumb,
+      .strength-slider::-moz-range-thumb {
+        transition: none;
+      }
+    }
