+  <script>
+    (function () {
+      var slider = document.getElementById('brew-strength');
+      var output = document.getElementById('brew-strength-output');
+      var note = document.getElementById('brew-strength-note');
+      if (!slider || !output || !note) return;
+
+      var levels = {
+        1: ['Mild', 'A light roast with bright, tea-like notes and gentle acidity.'],
+        2: ['Smooth', 'A light-medium roast with honey sweetness and a soft body.'],
+        3: ['Balanced', 'A medium roast with caramel sweetness and a clean finish.'],
+        4: ['Bold', 'A medium-dark roast with cocoa depth and a lingering finish.'],
+        5: ['Intense', 'A dark roast: smoky, full-bodied, and built for espresso.']
+      };
+
+      function update() {
+        var min = Number(slider.min) || 0;
+        var max = Number(slider.max) || 100;
+        var val = Number(slider.value);
+        var pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
+        var level = levels[val] || ['Level ' + val, ''];
+
+        slider.style.setProperty('--fill', pct + '%');
+        slider.setAttribute('aria-valuetext', level[0] + ', ' + val + ' of ' + max);
+        output.value = level[0] + ' · ' + val + ' of ' + max;
+        note.textContent = level[1];
+      }
+
+      slider.addEventListener('input', update);
+      slider.addEventListener('change', update);
+      update();
+    })();
+  </script>
+
 </body>
 
