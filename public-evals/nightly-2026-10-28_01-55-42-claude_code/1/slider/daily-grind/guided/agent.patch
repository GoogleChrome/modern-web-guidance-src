+  <script>
+    (function () {
+      var slider = document.getElementById('brew-strength');
+      var valueOut = document.getElementById('brew-strength-value');
+      if (!slider || !valueOut) return;
+
+      var labels = { 1: 'Light', 2: 'Mild', 3: 'Medium', 4: 'Bold', 5: 'Extra Bold' };
+
+      function syncSliderValue() {
+        var text = labels[slider.value] || slider.value;
+        // Keep fill progress in sync for WebKit/Blink and browsers without typed attr().
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+        slider.setAttribute('aria-valuetext', text);
+        valueOut.textContent = text;
+      }
+
+      syncSliderValue();
+      slider.addEventListener('input', syncSliderValue);
+    })();
+  </script>
