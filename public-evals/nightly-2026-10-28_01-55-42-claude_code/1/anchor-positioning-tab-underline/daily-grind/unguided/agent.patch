+  <script>
+    (function () {
+      var list = document.getElementById('nav-links');
+      var indicator = list.querySelector('.nav-indicator');
+      var links = Array.prototype.slice.call(list.querySelectorAll('.nav-link'));
+
+      function moveIndicator(link) {
+        var listRect = list.getBoundingClientRect();
+        var linkRect = link.getBoundingClientRect();
+        indicator.style.width = linkRect.width + 'px';
+        indicator.style.transform = 'translateX(' + (linkRect.left - listRect.left) + 'px)';
+      }
+
+      function setActive(link) {
+        links.forEach(function (l) {
+          l.classList.toggle('active', l === link);
+          if (l === link) {
+            l.setAttribute('aria-current', 'page');
+          } else {
+            l.removeAttribute('aria-current');
+          }
+        });
+        moveIndicator(link);
+      }
+
+      function currentActive() {
+        return list.querySelector('.nav-link.active') || links[0];
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          // Single-page demo: keep the user here so the underline can slide.
+          event.preventDefault();
+          setActive(link);
+        });
+      });
+
+      // Place the underline under the initial item without animating, then enable transitions.
+      moveIndicator(currentActive());
+      requestAnimationFrame(function () {
+        indicator.classList.add('ready');
+      });
+
+      window.addEventListener('resize', function () {
+        moveIndicator(currentActive());
+      });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () {
+          moveIndicator(currentActive());
+        });
+      }
+    })();
+  </script>
+
 </body>
 
