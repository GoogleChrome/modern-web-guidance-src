+  <script>
+    (() => {
+      const list = document.querySelector('nav ul');
+      const items = [...list.querySelectorAll('li.nav-item')];
+      const supportsAnchor = CSS.supports('position-anchor: auto');
+
+      // Fallback path only: expose the active item's geometry to CSS so the
+      // indicator can transition via translate/inline-size.
+      const measure = () => {
+        const active = list.querySelector('li.active');
+        if (!active) return;
+        list.style.setProperty('--nav-indicator-x', `${active.offsetLeft}px`);
+        list.style.setProperty('--nav-indicator-w', `${active.offsetWidth}px`);
+      };
+
+      const activate = (item) => {
+        for (const li of items) {
+          const isActive = li === item;
+          li.classList.toggle('active', isActive);
+          const link = li.querySelector('a');
+          if (isActive) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        }
+        if (!supportsAnchor) measure();
+      };
+
+      list.addEventListener('click', (event) => {
+        const link = event.target.closest('li.nav-item > a');
+        if (!link) return;
+        // Let modified clicks (new tab, etc.) behave like normal links.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        // Single-page demo: stay on this page so the indicator can slide.
+        event.preventDefault();
+        activate(link.parentElement);
+      });
+
+      if (!supportsAnchor) {
+        // Fires on observe and whenever the list resizes (e.g. web fonts load).
+        new ResizeObserver(measure).observe(list);
+      }
+    })();
+  </script>
+
 </body>
 
