+    /* Active nav indicator: one decorative bar on the list that slides
+       between items. The active <li> is the anchor it follows. */
+    nav ul li.active {
+      anchor-name: --active-nav-item;
+    }
+
+    nav ul::before {
+      content: '';
+      position: absolute;
+      block-size: 2px;
+      border-radius: 1px;
+      background: var(--accent);
+      pointer-events: none;
+    }
+
+    @supports (position-anchor: auto) {
+      nav ul::before {
+        position-anchor: --active-nav-item;
+        inset-block-start: calc(anchor(bottom) + 0.1lh);
+        inset-inline-start: anchor(left);
+        inset-inline-end: anchor(right);
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: inset 0.3s ease;
+        }
+      }
+    }
+
+    @supports not (position-anchor: auto) {
+      /* Fallback: the script measures the active item into
+         --nav-indicator-x / --nav-indicator-w on the <ul>. */
+      nav ul::before {
+        inset-block-start: calc(100% + 0.1lh);
+        inset-inline-start: 0;
+        inline-size: var(--nav-indicator-w, 0px);
+        translate: var(--nav-indicator-x, 0px) 0;
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: translate 0.3s ease, inline-size 0.3s ease;
+        }
+      }
+    }
