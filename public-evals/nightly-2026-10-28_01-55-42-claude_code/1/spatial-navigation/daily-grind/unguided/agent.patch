+  <script>
+    /**
+     * Accessible spatial (arrow-key) navigation for card grids.
+     *
+     * Pattern: roving tabindex over each card's primary action (the link), so
+     * the grid is a single Tab stop and arrow keys move focus between cards.
+     *
+     * Rows and columns are not hard-coded. On every key press the cards are
+     * grouped into rows by their rendered position, so navigation stays correct
+     * when the CSS grid reflows (3 / 2 / 1 columns), in list layout, when cards
+     * are hidden, and in right-to-left writing modes.
+     */
+    (function () {
+      'use strict';
+
+      var ROW_TOLERANCE = 4; // px; cards whose tops differ by less than this share a row
+
+      function initSpatialNav(grid) {
+        function getActions() {
+          var all = grid.querySelectorAll('[data-card-action]');
+          var visible = [];
+          for (var i = 0; i < all.length; i++) {
+            var el = all[i];
+            // Skip cards that are display:none or otherwise not rendered.
+            if (el.offsetParent !== null || el.getClientRects().length > 0) {
+              visible.push(el);
+            }
+          }
+          return visible;
+        }
+
+        function setActive(target, focus) {
+          var actions = getActions();
+          for (var i = 0; i < actions.length; i++) {
+            actions[i].tabIndex = actions[i] === target ? 0 : -1;
+          }
+          if (focus && target) {
+            target.focus();
+            if (typeof target.scrollIntoView === 'function') {
+              target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+            }
+          }
+        }
+
+        /**
+         * Group the visible actions into rows based on the rendered top edge of
+         * their containing card, then sort each row in reading order by x
+         * position (left-to-right, or right-to-left when the grid is RTL), so
+         * column 0 is always the logical start of the row.
+         * Returns { rows: Element[][], pos: Map<Element, {row, col}> }.
+         */
+        function computeLayout(actions, rtl) {
+          var items = actions.map(function (el) {
+            var card = el.closest('.card') || el;
+            var r = card.getBoundingClientRect();
+            return { el: el, top: r.top, left: r.left };
+          });
+          items.sort(function (a, b) { return a.top - b.top || a.left - b.left; });
+
+          var rows = [];
+          var current = null;
+          var currentTop = null;
+          items.forEach(function (item) {
+            if (current === null || Math.abs(item.top - currentTop) > ROW_TOLERANCE) {
+              current = [];
+              currentTop = item.top;
+              rows.push(current);
+            }
+            current.push(item);
+          });
+
+          var pos = new Map();
+          rows.forEach(function (row, rowIndex) {
+            row.sort(function (a, b) { return rtl ? b.left - a.left : a.left - b.left; });
+            row.forEach(function (item, colIndex) {
+              pos.set(item.el, { row: rowIndex, col: colIndex });
+            });
+          });
+
+          return {
+            rows: rows.map(function (row) { return row.map(function (i) { return i.el; }); }),
+            pos: pos
+          };
+        }
+
+        function isRtl() {
+          return getComputedStyle(grid).direction === 'rtl';
+        }
+
+        function onKeyDown(event) {
+          var current = event.target.closest('[data-card-action]');
+          if (!current || !grid.contains(current)) return;
+          if (event.altKey || event.metaKey) return;
+
+          var actions = getActions();
+          if (actions.length === 0) return;
+
+          var rtl = isRtl();
+          var layout = computeLayout(actions, rtl);
+          var rows = layout.rows;
+          var here = layout.pos.get(current);
+          if (!here) return;
+
+          var row = rows[here.row];
+          var next = null;
+
+          // Columns are in reading order, so "forward" is the key that points
+          // in the reading direction: Right in LTR, Left in RTL.
+          var forwardKey = rtl ? 'ArrowLeft' : 'ArrowRight';
+          var backwardKey = rtl ? 'ArrowRight' : 'ArrowLeft';
+
+          switch (event.key) {
+            case forwardKey:
+              if (here.col < row.length - 1) {
+                next = row[here.col + 1];
+              } else if (here.row < rows.length - 1) {
+                next = rows[here.row + 1][0]; // wrap to start of next row
+              }
+              break;
+
+            case backwardKey:
+              if (here.col > 0) {
+                next = row[here.col - 1];
+              } else if (here.row > 0) {
+                var prevRow = rows[here.row - 1];
+                next = prevRow[prevRow.length - 1]; // wrap to end of previous row
+              }
+              break;
+
+            case 'ArrowDown':
+              if (here.row < rows.length - 1) {
+                var below = rows[here.row + 1];
+                next = below[Math.min(here.col, below.length - 1)];
+              }
+              break;
+
+            case 'ArrowUp':
+              if (here.row > 0) {
+                var above = rows[here.row - 1];
+                next = above[Math.min(here.col, above.length - 1)];
+              }
+              break;
+
+            case 'Home':
+              next = event.ctrlKey ? rows[0][0] : row[0];
+              break;
+
+            case 'End':
+              next = event.ctrlKey ? rows[rows.length - 1][rows[rows.length - 1].length - 1]
+                                   : row[row.length - 1];
+              break;
+
+            default:
+              return; // not a navigation key; let it through
+          }
+
+          // Always consume navigation keys so the page doesn't scroll, even at an edge.
+          event.preventDefault();
+          if (next && next !== current) {
+            setActive(next, true);
+          }
+        }
+
+        function onFocusIn(event) {
+          var action = event.target.closest('[data-card-action]');
+          if (action && grid.contains(action)) {
+            setActive(action, false); // keep the roving tabindex on the last focused card
+          }
+        }
+
+        grid.addEventListener('keydown', onKeyDown);
+        grid.addEventListener('focusin', onFocusIn);
+
+        // Initial state: first visible card is the single Tab stop.
+        var initial = getActions();
+        setActive(initial[0] || null, false);
+      }
+
+      function initLayoutToggle() {
+        var grid = document.querySelector('[data-spatial-nav]');
+        var buttons = document.querySelectorAll('[data-layout-option]');
+        if (!grid || buttons.length === 0) return;
+
+        function apply(mode) {
+          grid.setAttribute('data-layout', mode);
+          for (var i = 0; i < buttons.length; i++) {
+            var b = buttons[i];
+            b.setAttribute('aria-pressed', String(b.getAttribute('data-layout-option') === mode));
+          }
+        }
+
+        for (var i = 0; i < buttons.length; i++) {
+          buttons[i].addEventListener('click', function () {
+            apply(this.getAttribute('data-layout-option'));
+          });
+        }
+      }
+
+      function init() {
+        var grids = document.querySelectorAll('[data-spatial-nav]');
+        for (var i = 0; i < grids.length; i++) initSpatialNav(grids[i]);
+        initLayoutToggle();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+
