+  <script>
+    // Keep aria-invalid in step with the visual :user-invalid state so screen
+    // readers only hear an error when the inline message is actually visible,
+    // and hear it clear the moment the email becomes valid.
+    (function () {
+      var form = document.querySelector('.newsletter-form');
+      var email = document.getElementById('newsletter-email');
+      if (!form || !email) return;
+
+      function syncAria() {
+        if (email.matches(':user-invalid')) {
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+      }
+
+      // Leaving the field is when :user-invalid first starts matching.
+      email.addEventListener('blur', syncAria);
+
+      // A submit attempt flags the field as user-interacted and fires
+      // 'invalid' on it before the browser focuses it.
+      email.addEventListener('invalid', function () {
+        // Styles update after this event; defer so matches() sees the new state.
+        setTimeout(syncAria, 0);
+      });
+
+      // Once an error is showing, clear it as soon as the value becomes valid.
+      email.addEventListener('input', function () {
+        if (email.hasAttribute('aria-invalid')) syncAria();
+      });
+
+      form.addEventListener('reset', function () {
+        email.removeAttribute('aria-invalid');
+      });
+    })();
+  </script>
+
