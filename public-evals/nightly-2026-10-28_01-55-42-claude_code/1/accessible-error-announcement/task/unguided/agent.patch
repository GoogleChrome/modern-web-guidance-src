+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var email = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var status = document.getElementById('newsletter-status');
+      var errorId = error.id;
+
+      // True once the user has blurred the field or attempted to submit.
+      // Errors are never shown (visually or to AT) before that point.
+      var interacted = false;
+
+      function messageFor(input) {
+        if (input.validity.valueMissing) {
+          return 'Please enter your email address.';
+        }
+        if (input.validity.typeMismatch) {
+          return 'Please enter a valid email address, like you@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: showing the visual message and flipping the
+      // accessible state happen together, so screen readers only announce an
+      // error when the message appears on screen.
+      function showError(message) {
+        if (error.textContent !== message) {
+          error.textContent = message;
+        }
+        email.setAttribute('aria-invalid', 'true');
+        email.setAttribute('aria-describedby', errorId);
+      }
+
+      function clearError() {
+        if (error.textContent !== '') {
+          error.textContent = '';
+        }
+        email.removeAttribute('aria-invalid');
+        email.removeAttribute('aria-describedby');
+      }
+
+      function sync() {
+        if (!interacted) {
+          return;
+        }
+        var message = messageFor(email);
+        if (message) {
+          showError(message);
+        } else {
+          clearError();
+        }
+      }
+
+      // First opportunity to surface an error: the user leaves the field.
+      email.addEventListener('blur', function () {
+        interacted = true;
+        sync();
+      });
+
+      // While typing: clear the error the moment the value becomes valid, and
+      // keep the message accurate if it is already visible. Before the first
+      // blur/submit this is a no-op, so no premature errors are announced.
+      email.addEventListener('input', function () {
+        if (status.textContent) {
+          status.textContent = '';
+        }
+        sync();
+      });
+
+      form.addEventListener('submit', function (event) {
+        interacted = true;
+        sync();
+        if (!email.validity.valid) {
+          event.preventDefault();
+          email.focus();
+          return;
+        }
+        // No backend in this static demo; acknowledge the subscription inline.
+        event.preventDefault();
+        status.textContent = 'Thanks! Check ' + email.value.trim() + ' to confirm your subscription.';
+        form.reset();
+        interacted = false;
+        clearError();
+      });
+    })();
+  </script>
+
