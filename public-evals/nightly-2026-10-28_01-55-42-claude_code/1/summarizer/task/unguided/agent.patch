+  <script>
+    (function () {
+      var button = document.getElementById('summarize-btn');
+      var status = document.getElementById('summary-status');
+      var list = document.getElementById('summary-list');
+      var article = document.getElementById('journal-text');
+      var summarizer = null;
+
+      function setStatus(message, isError) {
+        status.textContent = message;
+        status.classList.toggle('error', Boolean(isError));
+      }
+
+      function renderBullets(markdown) {
+        var items = markdown
+          .split(/\r?\n/)
+          .map(function (line) { return line.replace(/^\s*(?:[-*\u2022]|\d+[.)])\s*/, '').trim(); })
+          .filter(Boolean);
+        list.innerHTML = '';
+        items.forEach(function (text) {
+          var li = document.createElement('li');
+          li.textContent = text;
+          list.appendChild(li);
+        });
+        list.style.display = items.length ? 'block' : 'none';
+      }
+
+      function journalText() {
+        var clone = article.cloneNode(true);
+        var byline = clone.querySelector('.byline');
+        var title = clone.querySelector('h2');
+        if (byline) byline.remove();
+        if (title) title.remove();
+        return clone.textContent.replace(/\s+/g, ' ').trim();
+      }
+
+      async function getSummarizer() {
+        if (summarizer) return summarizer;
+
+        var availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          throw new Error('unsupported');
+        }
+        if (availability !== 'available') {
+          setStatus('Downloading the on-device model (one-time)\u2026');
+        }
+
+        summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'A specialty coffee roaster\'s blog post explaining how the company sources, evaluates, and roasts its coffee beans.',
+          monitor: function (m) {
+            m.addEventListener('downloadprogress', function (e) {
+              var pct = Math.round((e.loaded / (e.total || 1)) * 100);
+              setStatus('Downloading the on-device model\u2026 ' + pct + '%');
+            });
+          }
+        });
+        return summarizer;
+      }
+
+      async function summarize() {
+        if (!('Summarizer' in self)) {
+          setStatus('Built-in AI summarization is not available in this browser. Try a recent version of Chrome.', true);
+          return;
+        }
+
+        button.disabled = true;
+        list.style.display = 'none';
+        setStatus('Summarizing\u2026');
+
+        try {
+          var instance = await getSummarizer();
+          setStatus('Summarizing\u2026');
+          var result = await instance.summarize(journalText());
+          renderBullets(result);
+          setStatus('Summarized on your device.');
+          button.textContent = 'Summarize again';
+        } catch (err) {
+          if (err && err.message === 'unsupported') {
+            setStatus('Your browser does not support on-device summarization right now.', true);
+          } else if (err && err.name === 'NotAllowedError') {
+            setStatus('Model download was blocked. Check your browser\'s AI settings and try again.', true);
+          } else {
+            setStatus('Sorry, something went wrong while summarizing. Please try again.', true);
+            console.error('Summarizer error:', err);
+          }
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', summarize);
+    })();
+  </script>
+
