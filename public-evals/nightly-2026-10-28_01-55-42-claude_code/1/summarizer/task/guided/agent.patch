+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const output = document.getElementById('summary-output');
+      const article = document.getElementById('journal-text');
+
+      // The same options object must be passed to availability() and create().
+      const options = {
+        sharedContext: 'A coffee roaster\'s blog post about how they source green coffee beans.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+      };
+
+      const setStatus = (text) => { status.textContent = text; };
+
+      if (!('Summarizer' in self)) {
+        button.disabled = true;
+        setStatus('On-device summarization is not supported in this browser.');
+        return;
+      }
+
+      const renderBullets = (text) => {
+        output.replaceChildren();
+        let lines = text
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*\u2022]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+        if (lines.length <= 1) {
+          lines = text.split(/(?<=[.!?])\s+/).map((l) => l.trim()).filter(Boolean);
+        }
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line;
+          output.append(li);
+        }
+      };
+
+      let summarizer = null;
+
+      // Creating the summarizer (and any model download) must happen inside a user gesture.
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        output.replaceChildren();
+        output.setAttribute('aria-busy', 'true');
+
+        try {
+          const availability = await Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            setStatus('On-device summarization is unavailable on this device.');
+            return;
+          }
+
+          if (!summarizer) {
+            setStatus(availability === 'available'
+              ? 'Preparing summarizer\u2026'
+              : 'Downloading the on-device model\u2026 0%');
+            summarizer = await Summarizer.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+                  setStatus(`Downloading the on-device model\u2026 ${pct}%`);
+                });
+              },
+            });
+          }
+
+          setStatus('Summarizing\u2026');
+          const summary = await summarizer.summarize(article.innerText);
+          renderBullets(summary);
+          setStatus('Summary generated on your device. No text left your browser.');
+        } catch (err) {
+          console.error(err);
+          setStatus(err && err.name === 'NotAllowedError'
+            ? 'The browser blocked the model download. Please click the button again.'
+            : 'Sorry, we could not generate a summary right now.');
+        } finally {
+          output.removeAttribute('aria-busy');
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
