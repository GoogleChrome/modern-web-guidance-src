+          imageAlt: 'A shot of espresso with thick crema in a small cup',
+          sizes: [
+            { id: 'single', label: 'Single shot', price: 2.75 },
+            { id: 'double', label: 'Double shot', price: 3.25 },
+            { id: 'triple', label: 'Triple shot', price: 3.95 }
+          ],
+          defaultSize: 'double',
+          milks: ['None', 'Splash of whole milk', 'Splash of oat milk']
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Coarse-ground single-origin beans steeped in cold water for 18 hours for maximum smoothness. Served over ice.',
+          roast: 'Medium-dark',
+          caffeine: '200 mg (16 oz)',
+          notes: 'Cocoa, caramel, low acidity',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'A tall glass of iced cold brew coffee',
+          sizes: [
+            { id: 'small', label: 'Small (12 oz)', price: 4.25 },
+            { id: 'medium', label: 'Medium (16 oz)', price: 4.75 },
+            { id: 'large', label: 'Large (24 oz)', price: 5.50 }
+          ],
+          defaultSize: 'medium',
+          milks: ['None', 'Oat milk', 'Whole milk', 'Sweet cream']
+        }
+      };
+      const defaultDrink = 'maple-oat-latte';
+
+      const dialog = document.getElementById('drink-dialog');
+      const form = document.getElementById('drink-order-form');
+      const drinkSelect = document.getElementById('drink-select');
+      const sizeOptions = document.getElementById('size-options');
+      const milkSelect = document.getElementById('milk-select');
+      const quantityInput = document.getElementById('quantity-input');
+      const totalEl = document.getElementById('order-total');
+      const statusEl = document.getElementById('order-status');
+      const image = document.getElementById('drink-dialog-image');
+
+      const money = (n) => '$' + n.toFixed(2);
+
+      // Populate the drink chooser once.
+      for (const [id, drink] of Object.entries(drinks)) {
+        const option = document.createElement('option');
+        option.value = id;
+        option.textContent = drink.name;
+        drinkSelect.append(option);
+      }
+
+      function renderDrink(id) {
+        const drink = drinks[id];
+        image.src = drink.image;
+        image.alt = drink.imageAlt;
+        document.getElementById('drink-dialog-title').textContent = drink.name;
+        document.getElementById('drink-dialog-description').textContent = drink.description;
+        document.getElementById('drink-fact-roast').textContent = drink.roast;
+        document.getElementById('drink-fact-caffeine').textContent = drink.caffeine;
+        document.getElementById('drink-fact-notes').textContent = drink.notes;
+
+        sizeOptions.replaceChildren();
+        for (const size of drink.sizes) {
+          const label = document.createElement('label');
+          const input = document.createElement('input');
+          input.type = 'radio';
+          input.name = 'size';
+          input.value = size.id;
+          input.required = true;
+          input.checked = size.id === drink.defaultSize;
+          label.append(input, ' ' + size.label + ' · ' + money(size.price));
+          sizeOptions.append(label);
+        }
+
+        milkSelect.replaceChildren();
+        for (const milk of drink.milks) {
+          const option = document.createElement('option');
+          option.value = milk;
+          option.textContent = milk;
+          milkSelect.append(option);
+        }
+
+        updateTotal();
+      }
+
+      function currentSelection() {
+        const drink = drinks[drinkSelect.value];
+        const sizeId = new FormData(form).get('size');
+        const size = drink.sizes.find((s) => s.id === sizeId) || drink.sizes[0];
+        const quantity = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        return { drink, size, milk: milkSelect.value, quantity };
+      }
+
+      function updateTotal() {
+        const { size, quantity } = currentSelection();
+        totalEl.textContent = money(size.price * quantity);
+      }
+
+      function openDrinkDialog(drinkId) {
+        const id = drinks[drinkId] ? drinkId : defaultDrink;
+        drinkSelect.value = id;
+        quantityInput.value = 1;
+        renderDrink(id);
+        dialog.returnValue = '';
+        dialog.showModal();
+      }
+
+      for (const button of document.querySelectorAll('[data-open-drink-dialog]')) {
+        button.addEventListener('click', () => openDrinkDialog(button.dataset.drink));
+      }
+
+      drinkSelect.addEventListener('change', () => renderDrink(drinkSelect.value));
+      form.addEventListener('input', updateTotal);
+
+      // Read which button closed the dialog. Esc / back gesture / light dismiss
+      // leave returnValue empty, which we treat as "dismissed without ordering".
+      dialog.addEventListener('close', () => {
+        if (dialog.returnValue === 'order') {
+          const { drink, size, milk, quantity } = currentSelection();
+          const milkText = milk && milk !== 'None' ? ' with ' + milk.toLowerCase() : '';
+          statusEl.textContent =
+            'Added ' + quantity + ' × ' + size.label.replace(/\s*\(.*\)$/, '') + ' ' + drink.name +
+            milkText + ' to your order (' + money(size.price * quantity) + ').';
+          clearTimeout(statusEl._timer);
+          statusEl._timer = setTimeout(() => { statusEl.textContent = ''; }, 6000);
+        }
+        dialog.returnValue = '';
+      });
+
+      // Light-dismiss fallback for browsers without `closedby` support (e.g. Safari).
+      // Test pointer position rather than event.target: the <dialog> is also the
+      // target for clicks on its own padding and gaps between children.
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        // Require both press and release outside so a text-selection drag that
+        // ends on the backdrop does not dismiss the dialog.
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) dialog.close();
+          pressedOutside = false;
+        });
+      }
+    })();
+  </script>
+
