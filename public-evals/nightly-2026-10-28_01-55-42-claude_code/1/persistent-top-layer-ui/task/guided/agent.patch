+  <script type="module">
+    const dialog = document.getElementById('feedback-dialog');
+    const thanks = document.querySelector('.feedback-thanks');
+    const locationOut = document.getElementById('move-location');
+    const methodOut = document.getElementById('move-method');
+    const moveButtons = [...dialog.querySelectorAll('[data-move-to]')];
+
+    // Invoker commands (command/commandfor) are Baseline newly available; this is the
+    // minimal fallback for browsers that predate them.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      for (const button of document.querySelectorAll('button[commandfor]')) {
+        button.addEventListener('click', () => {
+          const target = document.getElementById(button.getAttribute('commandfor'));
+          const command = button.getAttribute('command');
+          if (command === 'show-modal' && !target.open) target.showModal();
+          if (command === 'close') target.close(button.value);
+        });
+      }
+    }
+
+    const supportsMoveBefore = 'moveBefore' in Element.prototype;
+    methodOut.textContent = supportsMoveBefore
+      ? '(native moveBefore)'
+      : '(fallback: re-open after move)';
+
+    /**
+     * Snapshot the bits of state a remove+insert would destroy, so the fallback can put them back.
+     */
+    function captureState() {
+      const active = document.activeElement;
+      const focusedInside = dialog.contains(active) ? active : null;
+      const selection =
+        focusedInside && 'selectionStart' in focusedInside && focusedInside.selectionStart !== null
+          ? { start: focusedInside.selectionStart, end: focusedInside.selectionEnd, dir: focusedInside.selectionDirection }
+          : null;
+      return {
+        wasModal: dialog.matches(':modal'),
+        wasOpen: dialog.open,
+        returnValue: dialog.returnValue,
+        scrollTop: dialog.scrollTop,
+        focusedInside,
+        selection,
+      };
+    }
+
+    function restoreState(state) {
+      if (state.wasOpen && !dialog.open) {
+        if (state.wasModal) dialog.showModal();
+        else dialog.show();
+      }
+      dialog.returnValue = state.returnValue;
+      dialog.scrollTop = state.scrollTop;
+      if (state.focusedInside && state.focusedInside.isConnected) {
+        // showModal() moved focus to the autofocus field; hand it back to where it was.
+        state.focusedInside.focus({ preventScroll: true });
+        if (state.selection) {
+          try {
+            state.focusedInside.setSelectionRange(state.selection.start, state.selection.end, state.selection.dir);
+          } catch { /* element type does not support selection ranges */ }
+        }
+      }
+    }
+
+    /**
+     * Relocate the open dialog into `host`, keeping it open and keeping focus where it was.
+     * Returns the strategy that was used.
+     */
+    function relocateDialog(host) {
+      if (dialog.parentNode === host && dialog === host.lastElementChild) return 'noop';
+
+      if (supportsMoveBefore) {
+        try {
+          // Atomic move: no remove/insert, so the dialog stays in the top layer,
+          // stays modal, and the focused control inside it keeps focus.
+          host.moveBefore(dialog, null);
+          return 'moveBefore';
+        } catch (error) {
+          // moveBefore can throw (e.g. HierarchyRequestError) in edge cases; degrade gracefully.
+          console.warn('moveBefore failed, using fallback', error);
+        }
+      }
+
+      // Fallback: a traditional move removes the node, which kicks it out of the top layer.
+      // Close it cleanly first so showModal() cannot throw on a half-open dialog, then restore.
+      const state = captureState();
+      if (dialog.open) dialog.close();
+      host.insertBefore(dialog, null);
+      restoreState(state);
+      return 'fallback';
+    }
+
+    function updateLocationUI(host, strategy) {
+      locationOut.textContent = host.dataset.hostLabel || host.tagName.toLowerCase();
+      for (const button of moveButtons) {
+        button.setAttribute('aria-pressed', String(host.matches(button.dataset.moveTo)));
+      }
+      if (strategy !== 'noop') {
+        methodOut.textContent = strategy === 'moveBefore'
+          ? '(moved with native moveBefore)'
+          : '(moved with fallback: re-opened and focus restored)';
+      }
+    }
+
+    for (const button of moveButtons) {
+      button.addEventListener('click', () => {
+        const host = document.querySelector(button.dataset.moveTo);
+        if (!host) return;
+        const strategy = relocateDialog(host);
+        updateLocationUI(host, strategy);
+      });
+    }
+
+    dialog.addEventListener('close', () => {
+      // The close event is dispatched asynchronously. If the dialog is already open again by the
+      // time it arrives, this was the fallback re-homing the node, not the user dismissing it.
+      if (dialog.open) return;
+      const result = dialog.returnValue;
+      dialog.returnValue = '';
+      if (result === 'send') {
+        thanks.textContent = 'Thanks for your feedback!';
+        dialog.querySelector('form').reset();
+        setTimeout(() => { thanks.textContent = ''; }, 4000);
+      }
+    });
+
+    // Small hook for debugging/testing from the console.
+    window.feedbackDialog = { relocateDialog, supportsMoveBefore };
+  </script>
