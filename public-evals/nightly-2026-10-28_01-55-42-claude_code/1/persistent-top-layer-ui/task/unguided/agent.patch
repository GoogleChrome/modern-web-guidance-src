+  <button type="button" class="feedback-fab" id="open-feedback" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    💬 Feedback
+  </button>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const openBtn = document.getElementById('open-feedback');
+      const closeBtn = document.getElementById('close-feedback');
+      const dismissBtn = document.getElementById('dismiss-feedback');
+      const form = document.getElementById('feedback-form');
+      const message = document.getElementById('feedback-message');
+      const locationOut = document.getElementById('feedback-location');
+      const methodOut = document.getElementById('feedback-method');
+      const supportOut = document.getElementById('feedback-support');
+      const timerOut = document.getElementById('feedback-timer');
+      const moveButtons = Array.from(dialog.querySelectorAll('[data-move]'));
+
+      const STORAGE_KEY = 'daily-grind:feedback-overlay';
+
+      // DOM slots the dialog can live in. moveBefore(node, null) appends to the end of the parent.
+      const slots = {
+        header: document.querySelector('header.hero'),
+        main: document.querySelector('main.container'),
+        footer: document.querySelector('footer'),
+      };
+
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+      supportOut.textContent = supportsMoveBefore
+        ? 'This browser supports moveBefore(): moves preserve open state, focus and animations natively.'
+        : 'This browser lacks moveBefore(): moves use insertBefore() and manually re-open and refocus.';
+
+      // We track modality ourselves rather than relying on the :modal pseudo-class,
+      // which older browsers do not parse.
+      let isModal = false;
+      // Number of close events we triggered ourselves (fallback move) and must ignore.
+      // The `close` event is dispatched asynchronously, so a synchronous flag is not enough.
+      let pendingSyntheticCloses = 0;
+      let openedAt = null;
+
+      /* ---------- helpers ---------- */
+
+      function slotNameFor(parent) {
+        for (const [name, el] of Object.entries(slots)) {
+          if (el === parent) return name;
+        }
+        return null;
+      }
+
+      function describeElement(el) {
+        if (!el) return 'detached';
+        const cls = el.className ? '.' + String(el.className).trim().split(/\s+/).join('.') : '';
+        return '<' + el.tagName.toLowerCase() + cls + '>';
+      }
+
+      function renderLocation() {
+        const parent = dialog.parentElement;
+        locationOut.textContent = describeElement(parent);
+        const current = slotNameFor(parent);
+        for (const btn of moveButtons) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.move === current));
+        }
+      }
+
+      function readStorage() {
+        try {
+          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
+        } catch {
+          return {};
+        }
+      }
+
+      function persist(patch) {
+        try {
+          const next = Object.assign(readStorage(), patch);
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+        } catch {
+          /* storage unavailable (private mode, quota) - overlay still works for this page load */
+        }
+      }
+
+      function persistDraft() {
+        const rating = form.elements.rating.value || '';
+        persist({ message: message.value, rating });
+      }
+
+      /* ---------- open / close ---------- */
+
+      function openDialog({ modal = true } = {}) {
+        if (dialog.open) return;
+        if (modal) dialog.showModal(); else dialog.show();
+        isModal = modal;
+        openedAt = openedAt || Date.now();
+        persist({ open: true });
+        renderLocation();
+      }
+
+      function closeDialog(returnValue) {
+        if (!dialog.open) return;
+        dialog.close(returnValue);
+      }
+
+      dialog.addEventListener('close', () => {
+        if (pendingSyntheticCloses > 0) {
+          pendingSyntheticCloses -= 1;
+          return; // a close we caused during a fallback move, not a user action
+        }
+        if (dialog.open) return; // already re-opened synchronously, nothing to tear down
+        isModal = false;
+        openedAt = null;
+        timerOut.textContent = '0';
+        if (dialog.returnValue === 'sent') {
+          message.value = '';
+          for (const r of form.elements.rating) r.checked = false;
+          persist({ open: false, message: '', rating: '' });
+          openBtn.textContent = '✅ Thanks!';
+          setTimeout(() => { openBtn.textContent = '💬 Feedback'; }, 2500);
+        } else {
+          persist({ open: false });
+        }
+        dialog.returnValue = '';
+      });
+
+      /* ---------- state capture / restore (fallback path) ---------- */
+
+      function captureState() {
+        const active = document.activeElement;
+        const focused = active && dialog.contains(active) ? active : null;
+        const hasSelection = focused && typeof focused.selectionStart === 'number';
+        return {
+          open: dialog.open,
+          modal: isModal,
+          returnValue: dialog.returnValue,
+          focused,
+          selection: hasSelection
+            ? { start: focused.selectionStart, end: focused.selectionEnd, direction: focused.selectionDirection }
+            : null,
+          dialogScroll: dialog.scrollTop,
+          messageScroll: message.scrollTop,
+        };
+      }
+
+      function restoreState(state) {
+        // The fallback path closes the dialog before detaching it (removing an open
+        // <dialog> drops it from the top layer, and a stale `open` attribute would make
+        // showModal() throw InvalidStateError), so here we re-open it in the mode it had.
+        if (state.open && !dialog.open) {
+          if (state.modal) dialog.showModal(); else dialog.show();
+          isModal = state.modal;
+        }
+        dialog.returnValue = state.returnValue;
+        dialog.scrollTop = state.dialogScroll;
+        message.scrollTop = state.messageScroll;
+
+        if (state.focused && state.focused.isConnected) {
+          state.focused.focus({ preventScroll: true });
+          if (state.selection && typeof state.focused.setSelectionRange === 'function') {
+            try {
+              state.focused.setSelectionRange(
+                state.selection.start,
+                state.selection.end,
+                state.selection.direction || 'none'
+              );
+            } catch {
+              /* some input types reject setSelectionRange */
+            }
+          }
+        }
+      }
+
+      /* ---------- the move itself ---------- */
+
+      function moveDialogTo(slotName) {
+        const target = slots[slotName];
+        if (!target) return;
+        if (target === dialog.parentElement) {
+          methodOut.textContent = 'already in ' + slotName;
+          return;
+        }
+
+        const before = captureState();
+        let method = null;
+
+        if (supportsMoveBefore) {
+          try {
+            // Native state-preserving move: no removal/insertion steps run, so the dialog
+            // stays open, stays in the top layer, keeps focus and keeps running animations.
+            target.moveBefore(dialog, null);
+            method = 'moveBefore()';
+          } catch (err) {
+            // HierarchyRequestError etc. (e.g. target not connected) - fall through to the manual path.
+            console.warn('moveBefore failed, falling back to insertBefore', err);
+          }
+        }
+
+        if (!method) {
+          // Close explicitly before detaching so every engine ends up in the same state.
+          if (dialog.open) {
+            pendingSyntheticCloses += 1;
+            dialog.close();
+          }
+          target.insertBefore(dialog, null);
+          restoreState(before);
+          method = 'insertBefore() fallback (re-opened, focus restored)';
+        } else {
+          // Belt and braces: if an engine's moveBefore did not keep the dialog open or
+          // focused as expected, repair it the same way the fallback does.
+          const lostOpen = before.open && !dialog.open;
+          const lostFocus = before.focused && document.activeElement !== before.focused;
+          if (lostOpen || lostFocus) {
+            restoreState(before);
+            method += ' + manual restore';
+          }
+        }
+
+        methodOut.textContent = method + ' → ' + slotName;
+        renderLocation();
+        persist({ slot: slotName });
+      }
+
+      /* ---------- wiring ---------- */
+
+      openBtn.addEventListener('click', () => openDialog({ modal: true }));
+      closeBtn.addEventListener('click', () => closeDialog('dismissed'));
+      dismissBtn.addEventListener('click', () => closeDialog('dismissed'));
+
+      for (const btn of moveButtons) {
+        btn.addEventListener('click', () => moveDialogTo(btn.dataset.move));
+      }
+
+      form.addEventListener('input', persistDraft);
+      form.addEventListener('change', persistDraft);
+      form.addEventListener('submit', (event) => {
+        if (!message.value.trim()) {
+          event.preventDefault();
+          message.focus();
+          message.setAttribute('aria-invalid', 'true');
+          return;
+        }
+        message.removeAttribute('aria-invalid');
+      });
+
+      // Elapsed-time counter: plain JS state, survives both move strategies.
+      setInterval(() => {
+        if (dialog.open && openedAt) {
+          timerOut.textContent = String(Math.floor((Date.now() - openedAt) / 1000));
+        }
+      }, 1000);
+
+      /* ---------- restore persisted overlay on load ---------- */
+
+      const saved = readStorage();
+      if (typeof saved.message === 'string') message.value = saved.message;
+      if (saved.rating) {
+        const radio = form.querySelector('input[name="rating"][value="' + saved.rating + '"]');
+        if (radio) radio.checked = true;
+      }
+      if (saved.slot && slots[saved.slot] && slots[saved.slot] !== dialog.parentElement) {
+        // Dialog is closed at this point, so a plain append is state-safe.
+        slots[saved.slot].appendChild(dialog);
+      }
+      renderLocation();
+      if (saved.open) openDialog({ modal: true });
+    })();
+  </script>
+
 </body>
 
