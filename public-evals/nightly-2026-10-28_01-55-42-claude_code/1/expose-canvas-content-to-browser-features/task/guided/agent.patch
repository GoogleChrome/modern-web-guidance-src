+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('order-form');
+      const summary = document.getElementById('order-summary');
+      const status = document.getElementById('order-status');
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+
+      // Feature-detect HTML-in-Canvas (Chrome 157+). Without it, the form is
+      // layered over the canvas with CSS so it stays interactive and accessible.
+      const nativeHtmlInCanvas =
+        'content' in HTMLCanvasElement.prototype && typeof ctx.drawElementImage === 'function';
+
+      let overlay = null;
+      if (!nativeHtmlInCanvas) {
+        overlay = document.createElement('div');
+        overlay.className = 'cup-overlay';
+        overlay.appendChild(form);
+        stage.appendChild(overlay);
+        canvas.setAttribute('aria-hidden', 'true'); // purely decorative in fallback mode
+      }
+
+      // All geometry below is in CSS pixels. The cup is sized around the form,
+      // so the form always sits inside the cup body regardless of its height.
+      const PAD = 18;          // space between cup wall and form
+      const STEAM_H = 64;      // room above the rim for steam
+      const RIM_RY = 16;       // vertical radius of the rim ellipse
+      const SAUCER_H = 44;
+      const BOTTOM_GAP = 8;
+
+      function layout(width, formHeight) {
+        const bodyX = Math.round(width * 0.04);
+        const bodyW = Math.round(width * 0.76);
+        const bodyY = STEAM_H;
+        const bodyH = RIM_RY + PAD + formHeight + PAD + 24;
+        return {
+          width,
+          height: bodyY + bodyH + SAUCER_H + BOTTOM_GAP,
+          body: { x: bodyX, y: bodyY, w: bodyW, h: bodyH },
+          form: { x: bodyX + PAD, y: bodyY + RIM_RY + PAD, w: bodyW - PAD * 2 },
+          handle: { x: bodyX + bodyW, y: bodyY + bodyH * 0.42, rx: Math.round(width * 0.13), ry: bodyH * 0.2 },
+          saucer: { cx: bodyX + bodyW / 2, cy: bodyY + bodyH + 14, rx: bodyW * 0.62, ry: 14 },
+        };
+      }
+
+      const COFFEE = {
+        'Whole milk': '#a9795a',
+        'Oat milk': '#b98b6b',
+        'Almond milk': '#8f6244',
+        'No milk': '#3b2314',
+      };
+
+      function selected(name) {
+        const el = form.elements[name];
+        return el && el.value ? el.value : '';
+      }
+
+      function roundedTrapezoid(c, x, y, w, h, taper, r) {
+        const bl = x + taper, br = x + w - taper, bottom = y + h;
+        c.beginPath();
+        c.moveTo(x, y);
+        c.lineTo(x + w, y);
+        c.lineTo(br, bottom - r);
+        c.quadraticCurveTo(br, bottom, br - r, bottom);
+        c.lineTo(bl + r, bottom);
+        c.quadraticCurveTo(bl, bottom, bl, bottom - r);
+        c.closePath();
+      }
+
+      function drawCup(c, L) {
+        const { body, handle, saucer } = L;
+        const cx = body.x + body.w / 2;
+
+        // Steam
+        c.save();
+        c.strokeStyle = 'rgba(78, 52, 46, 0.35)';
+        c.lineWidth = 3;
+        c.lineCap = 'round';
+        [-0.22, 0, 0.22].forEach((offset, i) => {
+          const sx = cx + body.w * offset;
+          const top = body.y - STEAM_H + 14 + (i === 1 ? 0 : 10);
+          c.beginPath();
+          c.moveTo(sx, body.y - 8);
+          c.bezierCurveTo(sx - 12, body.y - 24, sx + 12, body.y - 36, sx, top);
+          c.stroke();
+        });
+        c.restore();
+
+        // Saucer
+        c.beginPath();
+        c.ellipse(saucer.cx, saucer.cy, saucer.rx, saucer.ry, 0, 0, Math.PI * 2);
+        c.fillStyle = '#d7ccc8';
+        c.fill();
+        c.lineWidth = 3;
+        c.strokeStyle = '#4e342e';
+        c.stroke();
+
+        // Handle (drawn first so the body covers its inner half)
+        c.beginPath();
+        c.ellipse(handle.x, handle.y, handle.rx, handle.ry, 0, 0, Math.PI * 2);
+        c.lineWidth = 16;
+        c.strokeStyle = '#4e342e';
+        c.stroke();
+        c.lineWidth = 8;
+        c.strokeStyle = '#fff8f0';
+        c.stroke();
+
+        // Body
+        roundedTrapezoid(c, body.x, body.y, body.w, body.h, body.w * 0.08, 22);
+        const grad = c.createLinearGradient(body.x, 0, body.x + body.w, 0);
+        grad.addColorStop(0, '#fff8f0');
+        grad.addColorStop(0.5, '#ffffff');
+        grad.addColorStop(1, '#efe3dc');
+        c.fillStyle = grad;
+        c.fill();
+        c.lineWidth = 3;
+        c.strokeStyle = '#4e342e';
+        c.stroke();
+
+        // Accent band near the base
+        c.save();
+        c.clip();
+        c.fillStyle = '#ffab40';
+        c.fillRect(body.x, body.y + body.h - 22, body.w, 10);
+        c.restore();
+
+        // Rim and coffee surface
+        c.beginPath();
+        c.ellipse(cx, body.y, body.w / 2, RIM_RY, 0, 0, Math.PI * 2);
+        c.fillStyle = COFFEE[selected('milk')] || COFFEE['Whole milk'];
+        c.fill();
+        c.lineWidth = 3;
+        c.strokeStyle = '#4e342e';
+        c.stroke();
+        c.beginPath();
+        c.ellipse(cx - body.w * 0.1, body.y - 2, body.w * 0.22, RIM_RY * 0.4, 0, 0, Math.PI * 2);
+        c.fillStyle = 'rgba(255, 255, 255, 0.28)';
+        c.fill();
+      }
+
+      let lastFormHeight = form.offsetHeight || 500;
+      let L = layout(canvas.clientWidth || 420, lastFormHeight);
+
+      function paint() {
+        const cssW = canvas.clientWidth;
+        if (!cssW || !canvas.width) return;
+        // Backing-store pixels per CSS pixel (equals devicePixelRatio when the
+        // observer below sizes the canvas from device-pixel-content-box).
+        const scale = canvas.width / cssW;
+        if (typeof ctx.reset === 'function') ctx.reset();
+        else { ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, canvas.width, canvas.height); }
+
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+        drawCup(ctx, L);
+
+        if (nativeHtmlInCanvas) {
+          // Draw the live form into the cup. drawElementImage() paints the element's
+          // latest snapshot and syncs its DOM hit-test bounds and accessibility
+          // geometry to exactly where it is drawn.
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.drawElementImage(form, L.form.x * scale, L.form.y * scale);
+        }
+      }
+
+      function requestPaint() {
+        if (nativeHtmlInCanvas) canvas.requestPaint();
+        else paint();
+      }
+
+      if (nativeHtmlInCanvas) canvas.onpaint = paint;
+
+      // Keep the form's width and the fallback overlay aligned with the cup interior.
+      function applyLayout() {
+        const width = canvas.clientWidth;
+        if (!width) return;
+        lastFormHeight = form.offsetHeight || lastFormHeight;
+        L = layout(width, lastFormHeight);
+        form.style.width = L.form.w + 'px';
+        canvas.style.height = L.height + 'px';
+        if (overlay) {
+          overlay.style.left = L.form.x + 'px';
+          overlay.style.top = L.form.y + 'px';
+          overlay.style.width = L.form.w + 'px';
+        }
+      }
+
+      // Match the canvas grid to device pixels so lines and text stay crisp on
+      // high-DPI displays, and re-run layout/paint when the element resizes.
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+
+      const canvasObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        applyLayout();
+        requestPaint();
+      });
+      canvasObserver.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // The cup grows or shrinks with the form (e.g. after text wraps or the
+      // confirmation message appears).
+      new ResizeObserver(() => {
+        applyLayout();
+        requestPaint();
+      }).observe(form);
+
+      // Live summary and repaint on interaction.
+      function updateSummary() {
+        const name = form.elements.name.value.trim();
+        const milk = selected('milk').toLowerCase();
+        const syrup = selected('syrup').toLowerCase();
+        summary.textContent = (name ? name + "'s drink: " : 'Your drink: ') + milk + ', ' + syrup + '.';
+      }
+
+      form.addEventListener('input', () => { status.textContent = ''; updateSummary(); requestPaint(); });
+      form.addEventListener('change', () => { updateSummary(); requestPaint(); });
+      form.addEventListener('focusin', requestPaint);
+      form.addEventListener('focusout', requestPaint);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const name = form.elements.name.value.trim();
+        status.textContent = (name ? 'Thanks, ' + name + '! ' : 'Thanks! ') +
+          'Your ' + selected('milk').toLowerCase() + ' with ' + selected('syrup').toLowerCase() +
+          ' has been added to your order.';
+        requestPaint();
+      });
+
+      updateSummary();
+    })();
+  </script>
+
 </body>
 
