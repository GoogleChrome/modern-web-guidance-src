+  <script>
+    (function () {
+      var gallery = document.getElementById('gallery');
+      if (!gallery) return;
+      var items = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-item'));
+      var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumbnail'));
+      if (!items.length || !thumbs.length) return;
+
+      var activeIndex = 0;
+      var pendingIndex = -1;
+      var lastScrollLeft = gallery.scrollLeft;
+      var settleTimer = null;
+      var supportsScrollEnd = 'onscrollend' in window;
+
+      // Index of the item the scroll is heading towards. Items snap to the
+      // center of the container, so measure each item's center against the
+      // viewport center. When two items are close, lean in the direction of
+      // travel so the thumbnail reflects where the swipe is going.
+      function targetIndex(direction) {
+        var viewCenter = gallery.scrollLeft + gallery.clientWidth / 2;
+        var best = 0;
+        var bestDist = Infinity;
+        for (var i = 0; i < items.length; i++) {
+          var el = items[i];
+          var center = el.offsetLeft + el.offsetWidth / 2;
+          var dist = Math.abs(center - viewCenter);
+          // Bias towards the item in the direction of travel.
+          if (direction > 0 && center > viewCenter) dist *= 0.75;
+          if (direction < 0 && center < viewCenter) dist *= 0.75;
+          if (dist < bestDist) { bestDist = dist; best = i; }
+        }
+        return best;
+      }
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        thumbs.forEach(function (t) { t.classList.remove('pending'); });
+        if (index >= 0 && thumbs[index]) thumbs[index].classList.add('pending');
+        pendingIndex = index;
+      }
+
+      function setActive(index) {
+        thumbs.forEach(function (t, i) {
+          var isActive = i === index;
+          t.classList.remove('pending');
+          t.classList.toggle('active', isActive);
+          if (isActive) {
+            t.setAttribute('aria-current', 'true');
+          } else {
+            t.removeAttribute('aria-current');
+          }
+        });
+        pendingIndex = -1;
+        activeIndex = index;
+      }
+
+      function onScroll() {
+        var current = gallery.scrollLeft;
+        var direction = current > lastScrollLeft ? 1 : current < lastScrollLeft ? -1 : 0;
+        lastScrollLeft = current;
+        setPending(targetIndex(direction));
+
+        if (!supportsScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(onScrollEnd, 120);
+        }
+      }
+
+      function onScrollEnd() {
+        clearTimeout(settleTimer);
+        lastScrollLeft = gallery.scrollLeft;
+        setActive(targetIndex(0));
+      }
+
+      function scrollToIndex(index) {
+        var el = items[index];
+        if (!el) return;
+        var left = el.offsetLeft + el.offsetWidth / 2 - gallery.clientWidth / 2;
+        gallery.scrollTo({ left: left, behavior: 'smooth' });
+      }
+
+      gallery.addEventListener('scroll', onScroll, { passive: true });
+      if (supportsScrollEnd) gallery.addEventListener('scrollend', onScrollEnd);
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          if (i === activeIndex) return;
+          setPending(i);
+          scrollToIndex(i);
+        });
+      });
+
+      gallery.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowRight') { e.preventDefault(); scrollToIndex(Math.min(activeIndex + 1, items.length - 1)); }
+        if (e.key === 'ArrowLeft') { e.preventDefault(); scrollToIndex(Math.max(activeIndex - 1, 0)); }
+      });
+
+      window.addEventListener('resize', function () {
+        // Keep the active item centered after layout changes.
+        gallery.scrollTo({ left: items[activeIndex].offsetLeft + items[activeIndex].offsetWidth / 2 - gallery.clientWidth / 2 });
+      });
+
+      setActive(0);
+    })();
+  </script>
