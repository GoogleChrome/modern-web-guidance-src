+  <script>
+    (() => {
+      const container = document.getElementById('gallery');
+      if (!container) return;
+      const items = [...container.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('.thumbnail')];
+      if (!items.length || !thumbnails.length) return;
+
+      // Mark the thumbnail the scroller is heading toward (mid-scroll feedback).
+      const setPending = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+        thumbnails[index].classList.add('pending');
+      };
+
+      // Promote to the settled state once the scroll has finished.
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => {
+          thumb.classList.remove('pending', 'active');
+          thumb.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      };
+
+      // Items use scroll-snap-align: center, so compare centers.
+      // #gallery is position: relative, so item.offsetLeft is container-relative.
+      const findClosestItemIndex = () => {
+        const containerCenter = container.scrollLeft + container.clientWidth / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+        items.forEach((item, index) => {
+          const itemCenter = item.offsetLeft + item.offsetWidth / 2;
+          const distance = Math.abs(containerCenter - itemCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      };
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        // Native scroll snap events (horizontal scroller -> snapTargetInline).
+        container.addEventListener('scrollsnapchanging', (event) => {
+          setPending(items.indexOf(event.snapTargetInline));
+        });
+        container.addEventListener('scrollsnapchange', (event) => {
+          setActive(items.indexOf(event.snapTargetInline));
+        });
+      } else {
+        // Fallback: scroll + requestAnimationFrame for eager feedback,
+        // scrollend (or a debounce) to settle.
+        let rafId = null;
+        let scrollTimeout;
+        const settle = () => setActive(findClosestItemIndex());
+
+        container.addEventListener('scroll', () => {
+          if (rafId === null) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(findClosestItemIndex());
+            });
+          }
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(settle, 100);
+        }, { passive: true });
+
+        container.addEventListener('scrollend', () => {
+          clearTimeout(scrollTimeout);
+          settle();
+        });
+      }
+
+      // Thumbnail click -> scroll the matching item into view.
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          items[index].scrollIntoView({
+            behavior: reduceMotion.matches ? 'auto' : 'smooth',
+            block: 'nearest',
+            inline: 'center'
+          });
+        });
+      });
+
+      // Sync the initial state (restored scroll positions fire no snap events).
+      const init = () => setActive(findClosestItemIndex());
+      if (document.readyState === 'complete') {
+        init();
+      } else {
+        window.addEventListener('load', init, { once: true });
+      }
+    })();
+  </script>
