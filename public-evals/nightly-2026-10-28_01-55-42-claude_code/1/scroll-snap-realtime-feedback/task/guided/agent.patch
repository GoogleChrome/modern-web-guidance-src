+      height: 48px;
+      object-fit: cover;
+      border-radius: 3px;
+    }
+
+    .thumbnail:hover,
+    .thumbnail:focus-visible {
+      opacity: 1;
+    }
+
+    .thumbnail:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Real-time feedback: the item the scroller is heading toward */
+    .thumbnail.pending {
+      opacity: 1;
+      border-color: var(--accent);
+      transform: scale(1.08);
+    }
+
+    /* Settled state */
