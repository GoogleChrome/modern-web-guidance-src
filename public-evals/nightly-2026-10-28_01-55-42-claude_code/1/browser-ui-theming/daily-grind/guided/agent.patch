+  <script>
+    const sweetness = document.getElementById('sweetness');
+    const sweetnessOutput = document.getElementById('sweetness-output');
+    const supportsAccent = CSS.supports('accent-color', '#000');
+
+    function syncSweetness() {
+      sweetnessOutput.value = sweetness.value;
+      if (!supportsAccent) {
+        const pct = ((sweetness.value - sweetness.min) / (sweetness.max - sweetness.min)) * 100;
+        sweetness.style.setProperty('--progress', pct + '%');
+      }
+    }
+
+    sweetness.addEventListener('input', syncSweetness);
+    syncSweetness();
+  </script>
