+      /* Space lines with gap, not line-height, so gaps stay uniform across font sizes */
+      gap: 0.75rem;
+      /* Base size is the minimum; each line grows from here to fill the width */
+      font-size: clamp(1.75rem, 1rem + 3vw, 3rem);
