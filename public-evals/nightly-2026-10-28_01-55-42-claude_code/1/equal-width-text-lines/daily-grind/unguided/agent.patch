+  <script>
+    // Fit each lockup line to the lockup width by scaling the font-size,
+    // so glyph shapes and spacing stay true and only the size changes.
+    (function () {
+      var lockup = document.querySelector('.hero-lockup');
+      if (!lockup) return;
+      var lines = lockup.querySelectorAll('.lockup-line');
+      var PROBE = 100; // px: measure every line at the same reference size
+
+      function fit() {
+        var target = lockup.getBoundingClientRect().width;
+        if (!target) return;
+        lockup.classList.remove('is-fitted');
+        for (var i = 0; i < lines.length; i++) {
+          lines[i].style.fontSize = PROBE + 'px';
+        }
+        var sizes = [];
+        for (var j = 0; j < lines.length; j++) {
+          var natural = lines[j].getBoundingClientRect().width;
+          sizes.push(natural ? (PROBE * target / natural) : PROBE);
+        }
+        for (var k = 0; k < lines.length; k++) {
+          lines[k].style.fontSize = sizes[k].toFixed(3) + 'px';
+        }
+        lockup.classList.add('is-fitted');
+      }
+
+      fit();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
+      if (window.ResizeObserver) {
+        new ResizeObserver(fit).observe(lockup);
+      } else {
+        window.addEventListener('resize', fit);
+      }
+    })();
+  </script>
+
 </body>
 
