+  <script>
+    (function () {
+      'use strict';
+
+      var OPTIONS_URL = '/api/register/options';
+      var VERIFY_URL = '/api/register/verify';
+
+      var button = document.getElementById('register-button');
+      var status = document.getElementById('passkey-status');
+      if (!button || !status) return;
+
+      var inFlight = false;
+
+      function setStatus(message, state) {
+        // textContent only: never interpret server or error strings as HTML.
+        status.textContent = message || '';
+        if (state) {
+          status.setAttribute('data-state', state);
+        } else {
+          status.removeAttribute('data-state');
+        }
+      }
+
+      function isWebAuthnSupported() {
+        return window.isSecureContext &&
+          typeof window.PublicKeyCredential === 'function' &&
+          navigator.credentials &&
+          typeof navigator.credentials.create === 'function';
+      }
+
+      // ---- base64url helpers (fallback when the browser lacks the JSON APIs) ----
+      function base64UrlToBuffer(value) {
+        if (typeof value !== 'string') {
+          throw new TypeError('Expected a base64url string');
+        }
+        var base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        var pad = base64.length % 4;
+        if (pad) base64 += '===='.slice(pad);
+        var binary = atob(base64);
+        var bytes = new Uint8Array(binary.length);
+        for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToBase64Url(buffer) {
+        var bytes = new Uint8Array(buffer);
+        var binary = '';
+        for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseCreationOptions(json) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        var options = Object.assign({}, json);
+        options.challenge = base64UrlToBuffer(json.challenge);
+        options.user = Object.assign({}, json.user, { id: base64UrlToBuffer(json.user.id) });
+        if (Array.isArray(json.excludeCredentials)) {
+          options.excludeCredentials = json.excludeCredentials.map(function (cred) {
+            return Object.assign({}, cred, { id: base64UrlToBuffer(cred.id) });
+          });
+        }
+        return options;
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        var response = credential.response;
+        var out = {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults: typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {},
+          response: {
+            clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+            attestationObject: bufferToBase64Url(response.attestationObject)
+          }
+        };
+        if (typeof response.getTransports === 'function') {
+          out.response.transports = response.getTransports();
+        }
+        if (typeof response.getPublicKey === 'function') {
+          var pk = response.getPublicKey();
+          if (pk) out.response.publicKey = bufferToBase64Url(pk);
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          out.response.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          out.response.authenticatorData = bufferToBase64Url(response.getAuthenticatorData());
+        }
+        return out;
+      }
+
+      function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          redirect: 'error',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+            'X-Requested-With': 'fetch'
+          },
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          return res.json().catch(function () { return null; }).then(function (data) {
+            if (!res.ok) {
+              var err = new Error('Request to ' + url + ' failed with status ' + res.status);
+              err.status = res.status;
+              err.data = data;
+              throw err;
+            }
+            return data;
+          });
+        });
+      }
+
+      function friendlyError(err) {
+        if (!err) return 'Something went wrong. Please try again.';
+        switch (err.name) {
+          case 'NotAllowedError':
+            return 'Passkey creation was cancelled or timed out. Please try again.';
+          case 'InvalidStateError':
+            return 'A passkey for this account already exists on this device.';
+          case 'NotSupportedError':
+            return 'Your device does not support the requested passkey settings.';
+          case 'SecurityError':
+            return 'Passkeys can only be created from a secure (HTTPS) origin that matches this site.';
+          case 'AbortError':
+            return 'Passkey creation was interrupted. Please try again.';
+        }
+        if (err.status === 401 || err.status === 403) {
+          return 'Please sign in before creating a passkey.';
+        }
+        if (typeof err.status === 'number') {
+          return 'The server could not complete passkey registration. Please try again later.';
+        }
+        return 'Something went wrong. Please try again.';
+      }
+
+      async function registerPasskey() {
+        if (inFlight) return;
+        if (!isWebAuthnSupported()) {
+          setStatus('Passkeys are not supported in this browser or context.', 'error');
+          return;
+        }
+
+        inFlight = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        setStatus('Preparing your passkey\u2026');
+
+        try {
+          // 1. Fetch creation options (challenge, rp, user, etc.) from the server.
+          var optionsJSON = await postJSON(OPTIONS_URL, { promotion: true });
+          if (!optionsJSON || typeof optionsJSON !== 'object') {
+            throw new Error('Invalid options response');
+          }
+          // Accept either bare options or { publicKey: ... } wrappers.
+          var creationJSON = optionsJSON.publicKey || optionsJSON.options || optionsJSON;
+          if (!creationJSON.challenge || !creationJSON.user || !creationJSON.rp) {
+            throw new Error('Incomplete options response');
+          }
+          var publicKey = parseCreationOptions(creationJSON);
+
+          // 2. Ask the authenticator to create the credential.
+          setStatus('Follow the prompt from your browser or device\u2026');
+          var credential = await navigator.credentials.create({ publicKey: publicKey });
+          if (!credential) {
+            throw new Error('No credential returned');
+          }
+
+          // 3. Send the attestation back to the server for verification.
+          setStatus('Verifying your passkey\u2026');
+          var verification = await postJSON(VERIFY_URL, credentialToJSON(credential));
+          if (verification && verification.verified === false) {
+            throw new Error('Server rejected the passkey');
+          }
+
+          setStatus('Passkey created! You can now use it to sign in.', 'success');
+          button.textContent = 'Passkey Created';
+        } catch (err) {
+          // Avoid leaking credential material into logs; only report the error type.
+          if (window.console && console.warn) {
+            console.warn('Passkey registration failed:', err && err.name ? err.name : 'Error');
+          }
+          setStatus(friendlyError(err), 'error');
+          button.disabled = false;
+        } finally {
+          inFlight = false;
+          button.removeAttribute('aria-busy');
+        }
+      }
+
+      button.addEventListener('click', registerPasskey);
+
+      if (!isWebAuthnSupported()) {
+        setStatus('Passkeys are not supported in this browser or context.', 'error');
+      }
+    })();
+  </script>
+
