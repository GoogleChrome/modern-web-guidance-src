+  <script type="module">
+    const registerButton = document.getElementById('register-button');
+    const statusEl = document.getElementById('passkey-status');
+
+    const OPTIONS_URL = '/api/register/options';
+    const VERIFY_URL = '/api/register/verify';
+    // Pinned version. Loaded only when the browser lacks the WebAuthn JSON helpers.
+    const POLYFILL_URL = 'https://cdn.jsdelivr.net/npm/webauthn-polyfills@0.1.7/+esm';
+
+    function setStatus(message, state = 'info') {
+      // textContent only: never inject server or error strings as HTML.
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        cache: 'no-store',
+        headers: {
+          'Content-Type': 'application/json',
+          'Accept': 'application/json',
+        },
+        body: JSON.stringify(body),
+      });
+    }
+
+    async function ensureJsonHelpers() {
+      if (
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function' &&
+        typeof PublicKeyCredential.prototype.toJSON === 'function'
+      ) {
+        return;
+      }
+      await import(POLYFILL_URL);
+    }
+
+    async function passkeysSupported() {
+      if (!window.isSecureContext || !('PublicKeyCredential' in window)) {
+        return false;
+      }
+      try {
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+        }
+        // Older browsers: fall back to the legacy capability checks.
+        const [platform, conditional] = await Promise.all([
+          PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable(),
+          PublicKeyCredential.isConditionalMediationAvailable?.() ?? false,
+        ]);
+        return Boolean(platform && conditional);
+      } catch {
+        return false;
+      }
+    }
+
+    async function signalUnknownCredential(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function registerPasskey() {
+      await ensureJsonHelpers();
+
+      // 1. Fetch creation options (challenge, RP, user, excludeCredentials) from the server.
+      const optionsResponse = await postJSON(OPTIONS_URL, { promotion: true });
+      if (!optionsResponse.ok) {
+        throw new Error(`Could not start passkey setup (HTTP ${optionsResponse.status}).`);
+      }
+      const creationOptionsJSON = await optionsResponse.json();
+      const rpId = creationOptionsJSON?.rp?.id ?? location.hostname;
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      // 2. Ask the authenticator to create the credential.
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        switch (err?.name) {
+          case 'InvalidStateError':
+            setStatus('A passkey for this account already exists on this device.', 'info');
+            break;
+          case 'NotAllowedError':
+            setStatus('Passkey setup was cancelled.', 'info');
+            break;
+          case 'AbortError':
+            setStatus('Passkey setup was interrupted. Please try again.', 'info');
+            break;
+          case 'SecurityError':
+            console.error('WebAuthn configuration error (RP ID or secure context).', err);
+            setStatus('Passkeys are not available on this site right now.', 'error');
+            break;
+          default:
+            console.error('Unexpected WebAuthn error:', err);
+            setStatus('Something went wrong while creating your passkey.', 'error');
+        }
+        return;
+      }
+
+      // 3. Send the attestation to the server for verification.
+      const encodedResponse = credential.toJSON();
+      let verifyResponse;
+      try {
+        verifyResponse = await postJSON(VERIFY_URL, encodedResponse);
+      } catch (networkErr) {
+        console.error('Passkey verification request failed:', networkErr);
+        await signalUnknownCredential(rpId, encodedResponse.id);
+        setStatus('We could not reach the server to finish setup. Please try again.', 'error');
+        return;
+      }
+
+      if (!verifyResponse.ok) {
+        // The server rejected the credential, so tell the passkey provider it is orphaned.
+        await signalUnknownCredential(rpId, encodedResponse.id);
+        setStatus('We could not verify your new passkey. Please try again.', 'error');
+        return;
+      }
+
+      setStatus('Passkey created. You can use it the next time you sign in.', 'success');
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled) return;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      setStatus('Follow the prompt from your browser or device…');
+      try {
+        await registerPasskey();
+      } catch (err) {
+        console.error('Passkey registration failed:', err);
+        setStatus('Something went wrong while creating your passkey.', 'error');
+      } finally {
+        registerButton.removeAttribute('aria-busy');
+        registerButton.disabled = false;
+      }
+    });
+
+    // Gate the button on page load: only enable when a platform passkey can be created.
+    if (await passkeysSupported()) {
+      registerButton.disabled = false;
+    } else {
+      setStatus('Passkeys are not supported in this browser or on this connection.');
+    }
+  </script>
+
 </body>
 
