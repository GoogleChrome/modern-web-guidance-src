+  <script type="module">
+    // Polyfills getClientCapabilities / parseRequestOptionsFromJSON / toJSON on older browsers.
+    // Loaded best-effort so an offline CDN never breaks the page.
+    try {
+      await import('https://esm.sh/webauthn-polyfills');
+    } catch { /* native APIs are feature-detected below */ }
+
+    const OPTIONS_URL = '/api/login/options';
+    const VERIFY_URL = '/api/login/verify';
+
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const passkeyButton = document.querySelector('[data-testid="auth-button"]');
+
+    let autofillAbortController = new AbortController();
+    let rpId = location.hostname;
+
+    function setStatus(message, state) {
+      statusEl.textContent = message;
+      if (state) statusEl.dataset.state = state;
+      else delete statusEl.dataset.state;
+    }
+
+    async function fetchRequestOptions() {
+      const res = await fetch(OPTIONS_URL, { method: 'POST', credentials: 'same-origin' });
+      if (!res.ok) throw new Error(`Options request failed (${res.status})`);
+      const json = await res.json();
+      if (json.rpId) rpId = json.rpId;
+      return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+    }
+
+    // Sends the assertion to the server; returns true once the user is signed in.
+    async function verifyCredential(credential) {
+      const encoded = credential.toJSON();
+      const res = await fetch(VERIFY_URL, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+      });
+
+      if (res.ok) {
+        let user = null;
+        try { user = await res.json(); } catch { /* empty body is fine */ }
+        const name = user?.username || user?.name || user?.displayName;
+        setStatus(name ? `Signed in as ${name}.` : 'Signed in successfully.', 'success');
+        return true;
+      }
+
+      if (res.status === 404) {
+        // Credential unknown to the server: tell the password manager to drop it.
+        if (PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: encoded.id });
+          } catch { /* best-effort sync */ }
+        }
+        setStatus('That passkey is no longer registered. Please sign in another way.', 'error');
+        return false;
+      }
+
+      setStatus('Sign-in could not be verified. Please try again.', 'error');
+      return false;
+    }
+
+    async function supportsConditionalGet() {
+      if (!window.PublicKeyCredential?.getClientCapabilities) return false;
+      try {
+        const caps = await PublicKeyCredential.getClientCapabilities();
+        return caps.conditionalGet === true;
+      } catch {
+        return false;
+      }
+    }
+
+    // Conditional UI: registers passkeys as autofill suggestions for the username field.
+    async function initializeConditionalAutofill() {
+      if (!(await supportsConditionalGet())) return;
+
+      let credential;
+      try {
+        const publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err?.name === 'NotAllowedError' || err?.name === 'AbortError') return;
+        console.error('Conditional passkey autofill failed:', err);
+        return;
+      }
+
+      try {
+        await verifyCredential(credential);
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+      }
+    }
+
+    // Explicit button: shows the passkey prompt (biometrics / PIN) directly.
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      // Abort the pending conditional request so the two prompts don't collide.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      passkeyButton.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      let credential;
+      try {
+        const publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err?.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.', 'error');
+        } else if (err?.name === 'AbortError') {
+          setStatus('');
+        } else {
+          console.error('Passkey sign-in failed:', err);
+          setStatus('Passkey sign-in failed. Please try again.', 'error');
+        }
+        passkeyButton.disabled = false;
+        // Re-arm autofill suggestions for the username field.
+        initializeConditionalAutofill();
+        return;
+      }
+
+      try {
+        const ok = await verifyCredential(credential);
+        if (!ok) initializeConditionalAutofill();
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+        initializeConditionalAutofill();
+      } finally {
+        passkeyButton.disabled = false;
+      }
+    }
+
+    passkeyButton.addEventListener('click', triggerButtonAuthentication);
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
