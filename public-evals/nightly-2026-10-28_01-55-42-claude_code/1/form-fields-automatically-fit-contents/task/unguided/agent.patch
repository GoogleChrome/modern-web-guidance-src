+  <script>
+    // Fallback for browsers without CSS `field-sizing: content`:
+    // measure each control's text and set its width/height to match.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('field-sizing', 'content')) return;
+
+      var probe = document.createElement('span');
+      probe.className = 'size-probe';
+      document.body.appendChild(probe);
+
+      function textWidth(el, text) {
+        var cs = getComputedStyle(el);
+        probe.style.font = cs.font;
+        probe.style.letterSpacing = cs.letterSpacing;
+        probe.textContent = text || '';
+        return probe.getBoundingClientRect().width;
+      }
+
+      function fitInput(el) {
+        var text = el.value || el.placeholder || '';
+        el.style.width = Math.ceil(textWidth(el, text)) + 'px';
+      }
+
+      function fitTextarea(el) {
+        var text = el.value || el.placeholder || '';
+        var longest = text.split('\n').reduce(function (a, b) {
+          return textWidth(el, b) > textWidth(el, a) ? b : a;
+        }, '');
+        el.style.width = Math.ceil(textWidth(el, longest)) + 'px';
+        el.style.height = 'auto';
+        el.style.height = el.scrollHeight + 'px';
+      }
+
+      function fitSelect(el) {
+        var opt = el.options[el.selectedIndex];
+        var text = opt ? opt.textContent : '';
+        // Leave room for the native dropdown arrow.
+        el.style.width = Math.ceil(textWidth(el, text)) + 28 + 'px';
+      }
+
+      document.querySelectorAll('.order-form input[type="text"]').forEach(function (el) {
+        fitInput(el);
+        el.addEventListener('input', function () { fitInput(el); });
+      });
+      document.querySelectorAll('.order-form textarea').forEach(function (el) {
+        fitTextarea(el);
+        el.addEventListener('input', function () { fitTextarea(el); });
+      });
+      document.querySelectorAll('.order-form select').forEach(function (el) {
+        fitSelect(el);
+        el.addEventListener('change', function () { fitSelect(el); });
+      });
+    })();
+  </script>
+
