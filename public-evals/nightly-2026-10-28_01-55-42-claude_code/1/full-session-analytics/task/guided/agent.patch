+  <!--
+    Core Web Vitals monitoring.
+
+    Metrics are collected with the `web-vitals` library and delivered to the
+    analytics endpoint with `fetchLater()`, which queues a request that the
+    browser sends on its own when the page is unloaded or enters the bfcache.
+    This avoids `unload`/`beforeunload` handlers (unreliable, break bfcache)
+    and guarantees the beacon carries the *final* metric values, since
+    `web-vitals` finalizes CLS and INP when the page is hidden.
+
+    Loaded as an isolated module script so it never blocks the page's own
+    scripts. Pinned to an exact version for reproducible payloads.
+  -->
+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'https://unpkg.com/web-vitals@6.2.3/dist/web-vitals.js';
+
+    // Minimal fetchLater() polyfill for browsers without native support
+    // (Firefox, Safari). It mirrors the native API, sending the queued
+    // request via fetch({keepalive}) / sendBeacon when the page is hidden.
+    globalThis.fetchLater ??= function fetchLater(url, init = {}) {
+      let timeoutHandle;
+      let activated = false;
+
+      function sendNow() {
+        if (!(init.signal && init.signal.aborted)) {
+          // Use fetch keepalive if the browser supports it or if custom fetch
+          // parameters are specified (e.g. custom headers or methods).
+          // Otherwise fall back to `navigator.sendBeacon()`.
+          if (
+            'keepalive' in Request.prototype ||
+            init.method !== 'POST' ||
+            init.headers
+          ) {
+            fetch(url, Object.assign({}, init, { keepalive: true }));
+            activated = true;
+          } else {
+            activated = navigator.sendBeacon(url, init.body);
+          }
+        }
+        destroy();
+      }
+
+      function destroy() {
+        document.removeEventListener('visibilitychange', sendNow);
+        clearTimeout(timeoutHandle);
+      }
+
+      if (document.visibilityState === 'hidden') {
+        // If the beacon was created while the page is already hidden, send data
+        // ASAP but wait until the next microtask to allow all sync code to run.
+        queueMicrotask(sendNow);
+      } else {
+        document.addEventListener('visibilitychange', sendNow);
+
+        if (typeof init.activateAfter === 'number' && init.activateAfter >= 0) {
+          timeoutHandle = setTimeout(sendNow, init.activateAfter);
+        }
+      }
+
+      if (init.signal) {
+        init.signal.addEventListener('abort', destroy);
+      }
+
+      return {
+        get activated() {
+          return activated;
+        },
+      };
+    };
+
+    const ANALYTICS_ENDPOINT = '/path/to/analytics/endpoint';
+
+    // Snapshot of every metric reported so far, keyed by the metric's unique
+    // id. (After a bfcache restore, web-vitals reports a fresh set of metrics
+    // with new ids, so keying by id keeps those instances distinct.)
+    const metrics = new Map();
+    let fetchLaterController = null;
+    let fetchLaterResult = null;
+
+    function queueBeacon(metric) {
+      // If the browser already delivered the previously queued snapshot
+      // (e.g. the page was hidden and later restored), start a fresh batch
+      // so metrics are never reported twice.
+      if (fetchLaterResult?.activated) {
+        metrics.clear();
+        fetchLaterController = null;
+        fetchLaterResult = null;
+      }
+
+      // Keep the payload small: skip `entries` and other debug-only fields so
+      // the beacon stays well within the fetchLater() per-origin quota (~64KB).
+      metrics.set(metric.id, {
+        name: metric.name,
+        value: metric.value,
+        rating: metric.rating,
+        delta: metric.delta,
+        id: metric.id,
+        navigationType: metric.navigationType,
+      });
+
+      // Replace the pending beacon with one containing the full, updated
+      // snapshot. Only the most recent fetchLater() call is ever sent.
+      if (fetchLaterController) {
+        fetchLaterController.abort();
+      }
+      fetchLaterController = new AbortController();
+
+      try {
+        fetchLaterResult = fetchLater(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json' },
+          body: JSON.stringify({
+            page: location.href,
+            timestamp: Date.now(),
+            metrics: [...metrics.values()],
+          }),
+          signal: fetchLaterController.signal,
+        });
+      } catch (error) {
+        // fetchLater() throws if the per-origin quota is exceeded. Analytics
+        // are best-effort, so drop this snapshot rather than surface an error.
+        fetchLaterResult = null;
+      }
+    }
+
+    // Register the Core Web Vitals. Each callback fires once the metric's
+    // value is final for the current page view (LCP after first interaction
+    // or hide; CLS and INP when the page is hidden), so the queued beacon
+    // always reflects finalized values by the time the user leaves.
+    onLCP(queueBeacon);
+    onINP(queueBeacon);
+    onCLS(queueBeacon);
+  </script>
+
 </body>
 
