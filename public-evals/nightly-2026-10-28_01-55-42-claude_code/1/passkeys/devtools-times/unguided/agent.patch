+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import {
+  CheckIcon,
+  CloudIcon,
+  ComputerDesktopIcon,
+  DevicePhoneMobileIcon,
+  KeyIcon,
+  PencilSquareIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import {
+  ApiError,
+  deletePasskey,
+  describeAuthError,
+  detectPasskeySupport,
+  getMe,
+  isCeremonyCancelled,
+  listPasskeys,
+  registerPasskey,
+  renamePasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  signalUnknownCredential,
+  updateProfile,
+  type AuthUser,
+  type MeResponse,
+  type Passkey,
+  type PasskeySupport,
+} from '../lib/auth/client';
+import { formatDate, formatRelativeTime } from '../lib/auth/navigation';
+import PasskeyIcon from './PasskeyIcon';
+import ReauthDialog from './ReauthDialog';
+import SignOutButton from './SignOutButton';
+
+interface Props {
+  initialUser: AuthUser;
+}
+
+interface Notice {
+  kind: 'success' | 'error' | 'info';
+  text: string;
+}
+
+type PendingAction = { reason: string; run: () => Promise<void> } | null;
+
+const sectionClass = 'bg-white border border-gray-200 rounded-lg shadow-sm';
+const primaryButtonClass =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const secondaryButtonClass =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const inputClass =
+  'px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:bg-gray-50 text-sm';
+
+function transportIcon(passkey: Passkey) {
+  const t = new Set(passkey.transports);
+  if (t.has('usb') || t.has('nfc') || t.has('ble')) return <KeyIcon className="h-6 w-6" />;
+  if (t.has('hybrid') && !t.has('internal')) return <DevicePhoneMobileIcon className="h-6 w-6" />;
+  if (passkey.deviceType === 'multiDevice') return <CloudIcon className="h-6 w-6" />;
+  return <ComputerDesktopIcon className="h-6 w-6" />;
+}
+
+export default function AccountSettings({ initialUser }: Props) {
+  const [user, setUser] = useState<AuthUser>(initialUser);
+  const [me, setMe] = useState<MeResponse | null>(null);
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [signalContext, setSignalContext] = useState<{ rpId: string; userId: string } | null>(null);
+  const [support, setSupport] = useState<PasskeySupport | null>(null);
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [editingName, setEditingName] = useState(false);
+  const [displayNameDraft, setDisplayNameDraft] = useState(initialUser.displayName);
+  const [savingName, setSavingName] = useState(false);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameDraft, setRenameDraft] = useState('');
+  const [deletingId, setDeletingId] = useState<string | null>(null);
+  const [pendingAction, setPendingAction] = useState<PendingAction>(null);
+  const [now, setNow] = useState(() => Date.now());
+  const baseUrl = import.meta.env.BASE_URL;
+
+  const refresh = useCallback(async () => {
+    try {
+      const [meResponse, list] = await Promise.all([getMe(), listPasskeys()]);
+      if (!meResponse.user) {
+        window.location.assign(`${baseUrl}signin?next=${encodeURIComponent(`${baseUrl}account`)}`);
+        return;
+      }
+      setMe(meResponse);
+      setUser(meResponse.user);
+      setPasskeys(list.passkeys);
+      setSignalContext({ rpId: list.rpId, userId: list.userId });
+      // Tell the browser which passkeys are still valid so stale ones can be hidden.
+      void signalAllAcceptedCredentials(list.rpId, list.userId, list.passkeys.map((p) => p.id));
+    } catch (err) {
+      if (err instanceof ApiError && err.status === 401) {
+        window.location.assign(`${baseUrl}signin?next=${encodeURIComponent(`${baseUrl}account`)}`);
+        return;
+      }
+      setNotice({ kind: 'error', text: describeAuthError(err, 'Could not load your account.') });
+    }
+  }, [baseUrl]);
+
+  useEffect(() => {
+    void refresh();
+    detectPasskeySupport().then(setSupport);
+    const timer = window.setInterval(() => setNow(Date.now()), 30_000);
+    return () => window.clearInterval(timer);
+  }, [refresh]);
+
+  const reauthFresh = useMemo(() => {
+    const at = me?.reauthenticatedAt;
+    return typeof at === 'number' && now - at < 5 * 60 * 1000;
+  }, [me, now]);
+
+  const canUsePasskey = (support?.webauthn ?? false) && (passkeys?.length ?? 0) > 0;
+  const canUsePassword = user.hasPassword;
+
+  /** Run a sensitive action, asking the user to reauthenticate first if their session is stale. */
+  const withReauth = (reason: string, run: () => Promise<void>) => {
+    if (reauthFresh) {
+      void run();
+    } else {
+      setPendingAction({ reason, run });
+    }
+  };
+
+  const handleReauthSuccess = async (method: 'passkey' | 'password') => {
+    const action = pendingAction;
+    setPendingAction(null);
+    setMe((prev) => (prev ? { ...prev, reauthenticatedAt: Date.now(), reauthFresh: true, reauthMethod: method } : prev));
+    setNow(Date.now());
+    if (action) await action.run();
+  };
+
+  // --- Profile -------------------------------------------------------------
+
+  const saveDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSavingName(true);
+    setNotice(null);
+    try {
+      const result = await updateProfile(displayNameDraft);
+      setUser(result.user);
+      setEditingName(false);
+      setNotice({ kind: 'success', text: 'Display name updated.' });
+      if (signalContext) {
+        void signalCurrentUserDetails(signalContext.rpId, signalContext.userId, result.user.username, result.user.displayName);
+      }
+    } catch (err) {
+      setNotice({ kind: 'error', text: describeAuthError(err) });
+    } finally {
+      setSavingName(false);
+    }
+  };
+
+  // --- Passkeys ------------------------------------------------------------
+
+  const handleAddPasskey = async () => {
+    setAdding(true);
+    setNotice(null);
+    try {
+      const result = await registerPasskey();
+      setPasskeys((prev) => [...(prev ?? []), result.passkey]);
+      setNotice({ kind: 'success', text: `Passkey "${result.passkey.name}" added. You can rename it below.` });
+      setRenamingId(result.passkey.id);
+      setRenameDraft(result.passkey.name);
+      void refresh();
+    } catch (err) {
+      if (isCeremonyCancelled(err)) {
+        setNotice({ kind: 'info', text: 'Passkey creation was cancelled.' });
+      } else {
+        setNotice({ kind: 'error', text: describeAuthError(err, 'Could not add a passkey.') });
+      }
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const startRename = (passkey: Passkey) => {
+    setRenamingId(passkey.id);
+    setRenameDraft(passkey.name);
+  };
+
+  const submitRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!renamingId) return;
+    const id = renamingId;
+    try {
+      const result = await renamePasskey(id, renameDraft);
+      setPasskeys((prev) => (prev ?? []).map((p) => (p.id === id ? result.passkey : p)));
+      setRenamingId(null);
+      setNotice({ kind: 'success', text: 'Passkey renamed.' });
+    } catch (err) {
+      setNotice({ kind: 'error', text: describeAuthError(err) });
+    }
+  };
+
+  const performDelete = async (passkey: Passkey) => {
+    setDeletingId(passkey.id);
+    setNotice(null);
+    try {
+      const result = await deletePasskey(passkey.id);
+      setPasskeys(result.passkeys);
+      setNotice({ kind: 'success', text: `Passkey "${passkey.name}" removed.` });
+      // Ask the authenticator to forget it too, so it is no longer offered at sign-in.
+      void signalUnknownCredential(result.removed.rpId, result.removed.credentialId);
+      if (signalContext) {
+        void signalAllAcceptedCredentials(signalContext.rpId, signalContext.userId, result.passkeys.map((p) => p.id));
+      }
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'REAUTH_REQUIRED') {
+        // Server-side freshness check disagreed with ours; ask and retry.
+        setMe((prev) => (prev ? { ...prev, reauthenticatedAt: null, reauthFresh: false } : prev));
+        setPendingAction({ reason: `remove the passkey “${passkey.name}”`, run: () => performDelete(passkey) });
+      } else {
+        setNotice({ kind: 'error', text: describeAuthError(err, 'Could not remove the passkey.') });
+      }
+    } finally {
+      setDeletingId(null);
+    }
+  };
+
+  const handleDelete = (passkey: Passkey) => {
+    const isLast = !user.hasPassword && (passkeys?.length ?? 0) <= 1;
+    if (isLast) {
+      setNotice({
+        kind: 'error',
+        text: 'This is the only way to sign in to your account. Add another passkey before removing it.',
+      });
+      return;
+    }
+    if (!window.confirm(`Remove the passkey “${passkey.name}”? You will no longer be able to sign in with it.`)) return;
+    withReauth(`remove the passkey “${passkey.name}”`, () => performDelete(passkey));
+  };
+
+  // --- Render --------------------------------------------------------------
+
+  const noticeClass =
+    notice?.kind === 'error'
+      ? 'text-red-700 bg-red-100'
+      : notice?.kind === 'success'
+        ? 'text-green-700 bg-green-100'
+        : 'text-blue-700 bg-blue-100';
+
+  return (
+    <div className="max-w-3xl mx-auto space-y-6">
+      <div className="flex flex-wrap items-end justify-between gap-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <span className="font-semibold text-gray-900">@{user.username}</span>
+          </p>
+        </div>
+        <SignOutButton className={secondaryButtonClass} />
+      </div>
+
+      {notice && (
+        <div className={`p-3 text-sm rounded-lg flex items-start justify-between gap-3 ${noticeClass}`} role={notice.kind === 'error' ? 'alert' : 'status'}>
+          <span>{notice.text}</span>
+          <button type="button" onClick={() => setNotice(null)} aria-label="Dismiss" className="opacity-70 hover:opacity-100">
+            <XMarkIcon className="h-4 w-4" />
+          </button>
+        </div>
+      )}
+
+      {/* Profile */}
+      <section className={sectionClass} aria-labelledby="profile-heading">
+        <div className="p-6 border-b border-gray-200">
+          <h2 id="profile-heading" className="text-lg font-bold text-gray-900">
+            Profile
+          </h2>
+        </div>
+        <dl className="divide-y divide-gray-200">
+          <div className="px-6 py-4 grid grid-cols-3 gap-4 text-sm">
+            <dt className="font-medium text-gray-500">Username</dt>
+            <dd className="col-span-2 text-gray-900">@{user.username}</dd>
+          </div>
+          <div className="px-6 py-4 grid grid-cols-3 gap-4 text-sm">
+            <dt className="font-medium text-gray-500">Display name</dt>
+            <dd className="col-span-2 text-gray-900">
+              {editingName ? (
+                <form onSubmit={saveDisplayName} className="flex flex-wrap items-center gap-2">
+                  <label htmlFor="displayName" className="sr-only">
+                    Display name
+                  </label>
+                  <input
+                    id="displayName"
+                    value={displayNameDraft}
+                    onChange={(e) => setDisplayNameDraft(e.target.value)}
+                    maxLength={64}
+                    required
+                    autoFocus
+                    disabled={savingName}
+                    className={`${inputClass} flex-1 min-w-40`}
+                  />
+                  <button type="submit" disabled={savingName} className={primaryButtonClass}>
+                    <CheckIcon className="h-4 w-4" /> Save
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => {
+                      setEditingName(false);
+                      setDisplayNameDraft(user.displayName);
+                    }}
+                    className={secondaryButtonClass}
+                  >
+                    Cancel
+                  </button>
+                </form>
+              ) : (
+                <div className="flex items-center justify-between gap-3">
+                  <span>{user.displayName}</span>
+                  <button
+                    type="button"
+                    onClick={() => setEditingName(true)}
+                    className="inline-flex items-center gap-1 text-gray-500 hover:text-amber-500 text-xs font-medium"
+                  >
+                    <PencilSquareIcon className="h-4 w-4" /> Edit
+                  </button>
+                </div>
+              )}
+            </dd>
+          </div>
+          <div className="px-6 py-4 grid grid-cols-3 gap-4 text-sm">
+            <dt className="font-medium text-gray-500">Member since</dt>
+            <dd className="col-span-2 text-gray-900">{formatDate(user.createdAt)}</dd>
+          </div>
+        </dl>
+      </section>
+
+      {/* Sign-in & security */}
+      <section className={sectionClass} aria-labelledby="security-heading">
+        <div className="p-6 border-b border-gray-200 flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <h2 id="security-heading" className="text-lg font-bold text-gray-900">
+              Sign-in & security
+            </h2>
+            <p className="mt-1 text-sm text-gray-600">
+              Passkeys replace passwords with your device’s fingerprint, face, PIN or a security key. They can’t be
+              phished, guessed or reused.
+            </p>
+          </div>
+        </div>
+
+        <div className="px-6 py-4 border-b border-gray-200 text-sm flex flex-wrap items-center justify-between gap-3">
+          <div className="flex items-center gap-2 text-gray-700">
+            <ShieldCheckIcon className={`h-5 w-5 ${reauthFresh ? 'text-green-600' : 'text-gray-400'}`} />
+            {me?.reauthenticatedAt ? (
+              <span>
+                Identity last verified {formatRelativeTime(me.reauthenticatedAt, now)}
+                {me.reauthMethod ? ` with a ${me.reauthMethod}` : ''}.
+                {reauthFresh ? '' : ' You’ll be asked to verify again before making security changes.'}
+              </span>
+            ) : (
+              <span>Loading security status…</span>
+            )}
+          </div>
+          {!reauthFresh && (canUsePasskey || canUsePassword) && (
+            <button
+              type="button"
+              onClick={() => setPendingAction({ reason: 'manage your sign-in methods', run: async () => {} })}
+              className="text-xs font-medium text-gray-900 underline hover:text-amber-500"
+            >
+              Verify now
+            </button>
+          )}
+        </div>
+
+        <div className="px-6 py-4 border-b border-gray-200 grid grid-cols-3 gap-4 text-sm">
+          <dt className="font-medium text-gray-500">Password</dt>
+          <dd className="col-span-2 text-gray-900">
+            {user.hasPassword ? (
+              'Set'
+            ) : (
+              <span>
+                Not set <span className="text-gray-500">— this account signs in with passkeys only.</span>
+              </span>
+            )}
+          </dd>
+        </div>
+
+        <div className="px-6 py-5">
+          <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
+            <h3 className="font-semibold text-gray-900 flex items-center gap-2">
+              <PasskeyIcon className="h-5 w-5 text-gray-700" />
+              Passkeys
+              {passkeys && (
+                <span className="text-xs font-medium text-gray-500 bg-gray-100 rounded-full px-2 py-0.5">{passkeys.length}</span>
+              )}
+            </h3>
+            {support?.webauthn ? (
+              <button type="button" onClick={handleAddPasskey} disabled={adding} className={primaryButtonClass}>
+                <PasskeyIcon className="h-4 w-4" />
+                {adding ? 'Waiting for your device…' : 'Add a passkey'}
+              </button>
+            ) : support ? (
+              <span className="text-xs text-gray-500">This browser doesn’t support passkeys.</span>
+            ) : null}
+          </div>
+
+          {passkeys === null && <p className="text-sm text-gray-500">Loading passkeys…</p>}
+
+          {passkeys && passkeys.length === 0 && (
+            <div className="rounded-lg border border-dashed border-gray-300 p-6 text-center">
+              <PasskeyIcon className="h-10 w-10 mx-auto text-gray-300" />
+              <p className="mt-3 text-sm font-medium text-gray-900">No passkeys yet</p>
+              <p className="mt-1 text-sm text-gray-500">
+                Add one to sign in without a password next time. You can register several, for example one per device.
+              </p>
+            </div>
+          )}
+
+          {passkeys && passkeys.length > 0 && (
+            <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+              {passkeys.map((passkey) => (
+                <li key={passkey.id} className="p-4 flex items-start gap-4">
+                  <div className="shrink-0 h-10 w-10 rounded-lg bg-gray-100 text-gray-700 flex items-center justify-center">
+                    {transportIcon(passkey)}
+                  </div>
+                  <div className="flex-1 min-w-0">
+                    {renamingId === passkey.id ? (
+                      <form onSubmit={submitRename} className="flex flex-wrap items-center gap-2">
+                        <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                          Passkey name
+                        </label>
+                        <input
+                          id={`rename-${passkey.id}`}
+                          value={renameDraft}
+                          onChange={(e) => setRenameDraft(e.target.value)}
+                          maxLength={64}
+                          required
+                          autoFocus
+                          className={`${inputClass} flex-1 min-w-40`}
+                        />
+                        <button type="submit" className={primaryButtonClass}>
+                          <CheckIcon className="h-4 w-4" /> Save
+                        </button>
+                        <button type="button" onClick={() => setRenamingId(null)} className={secondaryButtonClass}>
+                          Cancel
+                        </button>
+                      </form>
+                    ) : (
+                      <div className="flex flex-wrap items-center gap-2">
+                        <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                        {passkey.deviceType === 'multiDevice' ? (
+                          <span className="inline-flex items-center gap-1 text-[11px] font-medium uppercase tracking-wide text-blue-700 bg-blue-50 rounded px-1.5 py-0.5">
+                            <CloudIcon className="h-3 w-3" /> Synced
+                          </span>
+                        ) : (
+                          <span className="text-[11px] font-medium uppercase tracking-wide text-gray-600 bg-gray-100 rounded px-1.5 py-0.5">
+                            Device-bound
+                          </span>
+                        )}
+                        {passkey.backedUp && (
+                          <span className="text-[11px] font-medium uppercase tracking-wide text-green-700 bg-green-50 rounded px-1.5 py-0.5">
+                            Backed up
+                          </span>
+                        )}
+                      </div>
+                    )}
+                    <p className="mt-1 text-xs text-gray-500">
+                      {passkey.provider && passkey.provider !== passkey.name ? `${passkey.provider} · ` : ''}
+                      Created {formatDate(passkey.createdAt)} · Last used {formatRelativeTime(passkey.lastUsedAt, now)}
+                    </p>
+                  </div>
+                  {renamingId !== passkey.id && (
+                    <div className="shrink-0 flex items-center gap-1">
+                      <button
+                        type="button"
+                        onClick={() => startRename(passkey)}
+                        aria-label={`Rename ${passkey.name}`}
+                        title="Rename"
+                        className="p-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-100"
+                      >
+                        <PencilSquareIcon className="h-5 w-5" />
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => handleDelete(passkey)}
+                        disabled={deletingId === passkey.id}
+                        aria-label={`Remove ${passkey.name}`}
+                        title="Remove"
+                        className="p-2 rounded-md text-gray-500 hover:text-red-600 hover:bg-red-50 disabled:opacity-50"
+                      >
+                        <TrashIcon className="h-5 w-5" />
+                      </button>
+                    </div>
+                  )}
+                </li>
+              ))}
+            </ul>
+          )}
+
+          <p className="mt-4 text-xs text-gray-500">
+            Removing a passkey requires a recent sign-in. Removing it here does not delete it from your device’s
+            password manager, though supporting browsers will be told it is no longer valid.
+          </p>
+        </div>
+      </section>
+
+      <ReauthDialog
+        open={pendingAction !== null}
+        reason={pendingAction?.reason ?? 'continue'}
+        canUsePasskey={canUsePasskey}
+        canUsePassword={canUsePassword}
+        onSuccess={handleReauthSuccess}
+        onCancel={() => setPendingAction(null)}
+      />
+    </div>
+  );
+}
