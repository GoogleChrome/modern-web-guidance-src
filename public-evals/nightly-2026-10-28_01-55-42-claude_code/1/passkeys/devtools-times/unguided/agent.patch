+  'cc45f64e-52a2-451b-831a-4edd8022a202': 'ToothPic Passkey Provider',
+  'bfc748bb-3429-4faa-b9f9-7cfa9f3b76d0': 'iPasswords',
+  'b35a26b2-8f6e-4697-ab1d-d44db4da28c6': 'Zoho Vault',
+  'b78a0a55-6ef8-d246-a042-ba0f6d55050c': 'LastPass',
+  'de503f9c-21a4-4f76-b4b7-558eb55c6f89': 'Devolutions',
+  '22248c4c-7a12-46e2-9a41-44291b373a4d': 'LogMeOnce',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'fbbd8b3f-3a6e-4d45-a8f5-5ea1f9a0f4b2': 'Samsung Pass',
+  '891494da-2c90-4d31-a9cd-4eab0aed1309': 'Sésame',
+  'f3f8d4a3-e2d7-4ef6-b8c7-7c7a7a8a6b4f': 'Keychainx',
+  // A handful of popular hardware security keys.
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': 'YubiKey 5 NFC',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey 5 Series',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey 5 NFC',
+  'c5ef55ff-ad9a-4b9f-b580-adebafe026d0': 'YubiKey 5Ci',
+  '73bb0cd4-e502-49b8-9c6f-b59445bf720b': 'YubiKey 5 FIPS',
+  '149a2021-8ef6-4133-96b8-81f8d5b7f1f5': 'Security Key by Yubico',
+  'b92c3f9a-c014-4056-887f-140a2501163b': 'Security Key by Yubico',
+  '9c835346-796b-4c27-8898-d6032f515cc5': 'Google Titan Security Key',
+  '42b4fb4a-2866-43b2-9bf7-6c6669c2e5d3': 'Google Titan Security Key',
+};
+
+const EMPTY_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export function providerForAaguid(aaguid: string): string | null {
+  if (!aaguid || aaguid === EMPTY_AAGUID) return null;
+  return KNOWN_PROVIDERS[aaguid.toLowerCase()] ?? null;
+}
+
+function platformFromUserAgent(userAgent: string | null): string | null {
+  if (!userAgent) return null;
+  if (/iPhone|iPad/.test(userAgent)) return 'iPhone or iPad';
+  if (/Android/.test(userAgent)) return 'Android device';
+  if (/Macintosh/.test(userAgent)) return 'Mac';
+  if (/Windows/.test(userAgent)) return 'Windows PC';
+  if (/CrOS/.test(userAgent)) return 'Chromebook';
+  if (/Linux/.test(userAgent)) return 'Linux PC';
+  return null;
+}
+
+/** Produce a sensible default nickname for a freshly registered passkey. */
+export function describeAuthenticator(input: {
+  aaguid: string;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  userAgent: string | null;
+}): string {
+  const provider = providerForAaguid(input.aaguid);
+  if (provider) return provider;
+
+  const transports = new Set(input.transports);
+  if (transports.has('usb') || transports.has('nfc')) return 'Security key';
+  if (transports.has('hybrid') && !transports.has('internal')) return 'Passkey from another device';
+
+  const platform = platformFromUserAgent(input.userAgent);
+  if (platform) return input.deviceType === 'multiDevice' ? `Passkey on ${platform}` : `${platform} passkey`;
+  return 'Passkey';
+}
+
+export function serializeCredential(credential: StoredCredential): PasskeySummary {
+  return {
+    id: credential.id,
+    name: credential.name,
+    createdAt: credential.createdAt,
+    lastUsedAt: credential.lastUsedAt,
+    deviceType: credential.deviceType,
+    backedUp: credential.backedUp,
+    transports: credential.transports,
+    aaguid: credential.aaguid,
+    provider: providerForAaguid(credential.aaguid),
+  };
+}
