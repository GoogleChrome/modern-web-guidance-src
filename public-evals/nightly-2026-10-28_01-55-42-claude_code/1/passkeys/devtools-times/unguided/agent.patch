diff --git a/src/pages/api/auth/passkeys/register/options.ts b/src/pages/api/auth/passkeys/register/options.ts
new file mode 100644
index 0000000..9e5cbfd
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register/options.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { RP_NAME, getRelyingParty } from '../../../../../lib/auth/rp';
+import { apiError, getSessionUser, json, readJson, storeChallenge } from '../../../../../lib/auth/session';
+import { USERNAME_PATTERN, findUserByUsername, listCredentials, normalizeUsername } from '../../../../../lib/auth/store';
+import { randomUUID } from 'node:crypto';
+
+export const prerender = false;
+
+/**
+ * Step 1 of passkey registration.
+ *
+ * - Signed-in users add a passkey to their existing account.
+ * - Anonymous visitors may create a brand-new, passkey-only account by
+ *   supplying a username. The user record is only written once the
+ *   authenticator response verifies.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return apiError(500, 'NO_SESSION', 'Sessions are not configured.');
+  const { rpID } = getRelyingParty(request);
+  const body = await readJson<{ username?: unknown; displayName?: unknown }>(request);
+
+  const currentUser = await getSessionUser(session);
+
+  let userId: string;
+  let userName: string;
+  let userDisplayName: string;
+  let newUser: { username: string; displayName: string } | undefined;
+
+  if (currentUser) {
+    userId = currentUser.id;
+    userName = currentUser.username;
+    userDisplayName = currentUser.displayName;
+  } else {
+    const username = typeof body.username === 'string' ? body.username.trim() : '';
+    if (!USERNAME_PATTERN.test(username)) {
+      return apiError(400, 'INVALID_USERNAME', 'Usernames are 3-32 characters: letters, numbers, dots, dashes or underscores.');
+    }
+    const existing = findUserByUsername(username);
+    if (existing) {
+      return apiError(409, 'USERNAME_TAKEN', 'That username is already taken. Sign in instead.');
+    }
+    const displayName = typeof body.displayName === 'string' && body.displayName.trim() ? body.displayName.trim().slice(0, 64) : username;
+    userId = randomUUID();
+    userName = normalizeUsername(username);
+    userDisplayName = displayName;
+    newUser = { username, displayName };
+  }
+
+  const existingCredentials = currentUser ? listCredentials(currentUser.id) : [];
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: new TextEncoder().encode(userId),
+    userName,
+    userDisplayName,
+    attestationType: 'none',
+    // Prevent registering the same authenticator twice.
+    excludeCredentials: existingCredentials.map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      // Discoverable credentials make username-less sign-in and autofill work.
+      residentKey: 'required',
+      userVerification: 'preferred',
+    },
+  });
+
+  await storeChallenge(session, { type: 'registration', challenge: options.challenge, userId, newUser });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/register/verify.ts b/src/pages/api/auth/passkeys/register/verify.ts
new file mode 100644
index 0000000..a88cbe9
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register/verify.ts
@@ -0,0 +1,105 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getRelyingParty } from '../../../../../lib/auth/rp';
+import { apiError, getSessionUser, json, publicUser, readJson, signIn, takeChallenge } from '../../../../../lib/auth/session';
+import {
+  addCredential,
+  createUser,
+  findCredential,
+  findUserById,
+  findUserByUsername,
+  listCredentials,
+  type StoredCredential,
+} from '../../../../../lib/auth/store';
+import { describeAuthenticator, serializeCredential } from '../../../../../lib/auth/describe';
+
+export const prerender = false;
+
+/** Step 2 of passkey registration: verify the attestation and save the credential. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID, origin } = getRelyingParty(request);
+  const body = await readJson<{ response?: RegistrationResponseJSON; name?: unknown }>(request);
+  if (!body.response?.id || !body.response.response?.clientDataJSON) {
+    return apiError(400, 'INVALID_RESPONSE', 'Missing registration response.');
+  }
+
+  const pending = await takeChallenge(session, 'registration');
+  if (!pending) {
+    return apiError(400, 'CHALLENGE_EXPIRED', 'Your passkey request expired. Please try again.');
+  }
+
+  const currentUser = await getSessionUser(session);
+  if (currentUser && pending.userId !== currentUser.id) {
+    return apiError(400, 'CHALLENGE_MISMATCH', 'This passkey request belongs to a different session.');
+  }
+  if (!currentUser && !pending.newUser) {
+    return apiError(401, 'UNAUTHENTICATED', 'You need to sign in before adding a passkey.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (error) {
+    console.error('[passkeys] Registration verification failed', error);
+    return apiError(400, 'VERIFICATION_FAILED', error instanceof Error ? error.message : 'Passkey could not be verified.');
+  }
+
+  if (!verification.verified) {
+    return apiError(400, 'VERIFICATION_FAILED', 'Passkey could not be verified.');
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp, aaguid } = verification.registrationInfo;
+
+  if (findCredential(credential.id)) {
+    return apiError(409, 'CREDENTIAL_EXISTS', 'This passkey is already registered.');
+  }
+
+  // Resolve (or create) the account the passkey belongs to.
+  let user = currentUser ?? (pending.userId ? findUserById(pending.userId) : undefined);
+  if (!user && pending.newUser) {
+    if (findUserByUsername(pending.newUser.username)) {
+      return apiError(409, 'USERNAME_TAKEN', 'That username was just taken. Please choose another.');
+    }
+    // Reuse the ID the authenticator was told about so user.id and the credential's userHandle agree.
+    user = createUser({ id: pending.userId, ...pending.newUser, hasPassword: false });
+  }
+  if (!user) return apiError(400, 'UNKNOWN_USER', 'Could not determine which account to attach the passkey to.');
+
+  const requestedName = typeof body.name === 'string' ? body.name.trim().slice(0, 64) : '';
+  const stored: StoredCredential = {
+    id: credential.id,
+    userId: user.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports ?? body.response.response.transports ?? [],
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    aaguid,
+    name: requestedName || describeAuthenticator({ aaguid, transports: credential.transports ?? [], deviceType: credentialDeviceType, userAgent: request.headers.get('user-agent') }),
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+  addCredential(stored);
+
+  if (!currentUser) {
+    // Passkey-only sign-up: this ceremony also proves possession, so sign the user in.
+    await signIn(session, user, 'passkey');
+  }
+
+  return json(
+    {
+      verified: true,
+      user: publicUser(user),
+      passkey: serializeCredential(stored),
+      passkeyCount: listCredentials(user.id).length,
+    },
+    { status: 201 },
+  );
+};
