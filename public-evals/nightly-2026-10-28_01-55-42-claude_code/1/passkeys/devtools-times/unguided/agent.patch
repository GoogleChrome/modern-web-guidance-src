diff --git a/src/pages/api/auth/me.ts b/src/pages/api/auth/me.ts
new file mode 100644
index 0000000..1414131
--- /dev/null
+++ b/src/pages/api/auth/me.ts
@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { apiError, getReauthState, getSessionUser, json, publicUser, readJson } from '../../../lib/auth/session';
+import { listCredentials, updateUser } from '../../../lib/auth/store';
+
+export const prerender = false;
+
+/** Who is signed in, how fresh their authentication is, and how many passkeys they have. */
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ user: null });
+  const { reauthenticatedAt, fresh } = await getReauthState(session);
+  return json({
+    user: publicUser(user),
+    passkeyCount: listCredentials(user.id).length,
+    reauthenticatedAt,
+    reauthFresh: fresh,
+    reauthMethod: (await session?.get('reauthMethod')) ?? null,
+  });
+};
+
+/** Update profile details (currently just the display name). */
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return apiError(401, 'UNAUTHENTICATED', 'You need to sign in first.');
+
+  const body = await readJson<{ displayName?: unknown }>(request);
+  const displayName = typeof body.displayName === 'string' ? body.displayName.trim() : '';
+  if (displayName.length < 1 || displayName.length > 64) {
+    return apiError(400, 'INVALID_DISPLAY_NAME', 'Display name must be between 1 and 64 characters.');
+  }
+
+  const updated = updateUser(user.id, { displayName })!;
+  session?.set('user', { id: updated.id, username: updated.username, displayName: updated.displayName });
+  return json({ user: publicUser(updated) });
+};
