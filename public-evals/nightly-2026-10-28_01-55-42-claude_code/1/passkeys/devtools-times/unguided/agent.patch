@@ -0,0 +1,28 @@
+import type { APIRoute } from 'astro';
+import { verifyPassword } from '../../../../lib/auth/external';
+import { apiError, json, publicUser, readJson, signIn } from '../../../../lib/auth/session';
+import { ensurePasswordUser, listCredentials } from '../../../../lib/auth/store';
+
+export const prerender = false;
+
+/**
+ * Password sign-in. The password itself is checked by the external DevTools
+ * Times API; on success a local session is established so passkeys can be
+ * managed for the account.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await readJson<{ username?: unknown; password?: unknown }>(request);
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return apiError(400, 'MISSING_CREDENTIALS', 'Username and password are required.');
+  }
+
+  const result = await verifyPassword(username.trim(), password);
+  if (!result.ok) {
+    return apiError(result.status === 502 ? 502 : 401, result.error ?? 'LOGIN_FAILED', result.message ?? 'Login failed.');
+  }
+
+  const user = ensurePasswordUser(username);
+  await signIn(session, user, 'password');
+
+  return json({ user: publicUser(user), passkeyCount: listCredentials(user.id).length });
+};
diff --git a/src/pages/api/auth/password/register.ts b/src/pages/api/auth/password/register.ts
new file mode 100644
index 0000000..4d011a2
--- /dev/null
+++ b/src/pages/api/auth/password/register.ts
@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { registerPassword } from '../../../../lib/auth/external';
+import { apiError, json, publicUser, readJson, signIn } from '../../../../lib/auth/session';
+import { USERNAME_PATTERN, ensurePasswordUser, findUserByUsername, listCredentials } from '../../../../lib/auth/store';
+
+export const prerender = false;
+
+/**
+ * Password sign-up. Registration is performed by the external DevTools Times
+ * API; on success the new user is signed in locally so they can immediately
+ * add a passkey.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await readJson<{ username?: unknown; password?: unknown }>(request);
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return apiError(400, 'MISSING_CREDENTIALS', 'Username and password are required.');
+  }
+  if (!USERNAME_PATTERN.test(username.trim())) {
+    return apiError(400, 'INVALID_USERNAME', 'Usernames are 3-32 characters: letters, numbers, dots, dashes or underscores.');
+  }
+
+  // A passkey-only account already owns this username locally.
+  const local = findUserByUsername(username);
+  if (local && listCredentials(local.id).length > 0 && !local.hasPassword) {
+    return apiError(409, 'USERNAME_TAKEN', 'That username is already registered with a passkey. Sign in instead.');
+  }
+
+  const result = await registerPassword(username.trim(), password);
+  if (!result.ok) {
+    return apiError(result.status >= 500 ? 502 : result.status, result.error ?? 'REGISTRATION_FAILED', result.message ?? 'Registration failed.');
+  }
+
+  const user = ensurePasswordUser(username);
+  await signIn(session, user, 'password');
+
+  return json({ user: publicUser(user), passkeyCount: listCredentials(user.id).length }, { status: 201 });
+};
diff --git a/src/pages/api/auth/reauth/password.ts b/src/pages/api/auth/reauth/password.ts
