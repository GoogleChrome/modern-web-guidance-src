new file mode 100644
index 0000000..a7a24e9
--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,63 @@
+import type { APIRoute } from 'astro';
+import { getRelyingParty } from '../../../../lib/auth/rp';
+import { REAUTH_MAX_AGE_MS, apiError, getReauthState, getSessionUser, json, readJson } from '../../../../lib/auth/session';
+import { deleteCredential, findCredential, listCredentials, updateCredential } from '../../../../lib/auth/store';
+import { serializeCredential } from '../../../../lib/auth/describe';
+
+export const prerender = false;
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return apiError(401, 'UNAUTHENTICATED', 'You need to sign in first.');
+
+  const credential = params.id ? findCredential(params.id) : undefined;
+  if (!credential || credential.userId !== user.id) {
+    return apiError(404, 'NOT_FOUND', 'Passkey not found.');
+  }
+
+  const body = await readJson<{ name?: unknown }>(request);
+  const name = typeof body.name === 'string' ? body.name.trim() : '';
+  if (name.length < 1 || name.length > 64) {
+    return apiError(400, 'INVALID_NAME', 'Passkey names must be between 1 and 64 characters.');
+  }
+
+  return json({ passkey: serializeCredential(updateCredential(credential.id, { name })!) });
+};
+
+/**
+ * Remove a passkey. This is a sensitive action: the user must have
+ * authenticated within the last few minutes, otherwise the client is asked
+ * to reauthenticate and retry.
+ */
+export const DELETE: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return apiError(401, 'UNAUTHENTICATED', 'You need to sign in first.');
+
+  const { fresh } = await getReauthState(session);
+  if (!fresh) {
+    return apiError(403, 'REAUTH_REQUIRED', 'Please confirm it is you before removing a passkey.', {
+      maxAgeMs: REAUTH_MAX_AGE_MS,
+    });
+  }
+
+  const credential = params.id ? findCredential(params.id) : undefined;
+  if (!credential || credential.userId !== user.id) {
+    return apiError(404, 'NOT_FOUND', 'Passkey not found.');
+  }
+
+  // Never let a passkey-only account lock itself out.
+  if (!user.hasPassword && listCredentials(user.id).length <= 1) {
+    return apiError(409, 'LAST_CREDENTIAL', 'This is the only way to sign in to your account. Add another passkey before removing it.');
+  }
+
+  deleteCredential(credential.id, user.id);
+  const { rpID } = getRelyingParty(request);
+
+  return json({
+    ok: true,
+    // Lets the client call PublicKeyCredential.signalUnknownCredential().
+    removed: { credentialId: credential.id, rpId: rpID },
+    passkeys: listCredentials(user.id).map(serializeCredential),
+  });
+};
