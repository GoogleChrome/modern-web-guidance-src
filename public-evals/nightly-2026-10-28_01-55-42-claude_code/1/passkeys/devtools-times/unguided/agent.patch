index 0000000..d23f88d
--- /dev/null
+++ b/src/pages/api/auth/reauth/password.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { verifyPassword } from '../../../../lib/auth/external';
+import { apiError, getSessionUser, json, markReauthenticated, readJson } from '../../../../lib/auth/session';
+
+export const prerender = false;
+
+/** Re-verify the signed-in user's password before a sensitive action. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return apiError(401, 'UNAUTHENTICATED', 'You need to sign in first.');
+  if (!user.hasPassword) {
+    return apiError(400, 'NO_PASSWORD', 'This account signs in with a passkey only. Use your passkey to confirm it is you.');
+  }
+
+  const { password } = await readJson<{ password?: unknown }>(request);
+  if (typeof password !== 'string' || !password) {
+    return apiError(400, 'MISSING_PASSWORD', 'Enter your password to continue.');
+  }
+
+  const result = await verifyPassword(user.username, password);
+  if (!result.ok) {
+    return apiError(result.status === 502 ? 502 : 401, result.error ?? 'REAUTH_FAILED', result.message ?? 'That password is not correct.');
+  }
+
+  await markReauthenticated(session, 'password');
+  return json({ ok: true, reauthenticatedAt: Date.now() });
