--- /dev/null
+++ b/src/lib/auth/client.ts
@@ -0,0 +1,259 @@
+/**
+ * Browser-side helpers for The DevTools Times authentication API, including
+ * the full passkey (WebAuthn) registration and authentication ceremonies.
+ */
+import {
+  WebAuthnError,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  platformAuthenticatorIsAvailable,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  type PublicKeyCredentialCreationOptionsJSON,
+  type PublicKeyCredentialRequestOptionsJSON,
+} from '@simplewebauthn/browser';
+
+const API_BASE = `${import.meta.env.BASE_URL}api/auth/`;
+
+export interface AuthUser {
+  id: string;
+  username: string;
+  displayName: string;
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface Passkey {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  transports: string[];
+  aaguid: string;
+  provider: string | null;
+}
+
+export interface MeResponse {
+  user: AuthUser | null;
+  passkeyCount?: number;
+  reauthenticatedAt?: number | null;
+  reauthFresh?: boolean;
+  reauthMethod?: 'password' | 'passkey' | null;
+}
+
+export class ApiError extends Error {
+  constructor(
+    public status: number,
+    public code: string,
+    message: string,
+    public data: Record<string, unknown> = {},
+  ) {
+    super(message);
+    this.name = 'ApiError';
+  }
+}
+
+export async function api<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${API_BASE}${path}`, {
+    credentials: 'same-origin',
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+  });
+  let data: any = null;
+  try {
+    data = await response.json();
+  } catch {
+    // Empty body.
+  }
+  if (!response.ok) {
+    throw new ApiError(
+      response.status,
+      data?.error ?? `HTTP_${response.status}`,
+      data?.message ?? `Request failed with status ${response.status}.`,
+      data ?? {},
+    );
+  }
+  return data as T;
+}
+
+const post = <T>(path: string, body?: unknown) => api<T>(path, { method: 'POST', body: body === undefined ? undefined : JSON.stringify(body) });
+
+// ---------------------------------------------------------------------------
+// Session & password
+// ---------------------------------------------------------------------------
+
+export const getMe = () => api<MeResponse>('me');
+export const updateProfile = (displayName: string) => api<{ user: AuthUser }>('me', { method: 'PATCH', body: JSON.stringify({ displayName }) });
+export const logout = () => post<{ ok: true }>('logout');
+export const passwordLogin = (username: string, password: string) =>
+  post<{ user: AuthUser; passkeyCount: number }>('password/login', { username, password });
+export const passwordRegister = (username: string, password: string) =>
+  post<{ user: AuthUser; passkeyCount: number }>('password/register', { username, password });
+export const passwordReauth = (password: string) => post<{ ok: true; reauthenticatedAt: number }>('reauth/password', { password });
+
+// ---------------------------------------------------------------------------
+// Passkeys
+// ---------------------------------------------------------------------------
+
+export interface PasskeySupport {
+  webauthn: boolean;
+  platformAuthenticator: boolean;
+  autofill: boolean;
+}
+
+export async function detectPasskeySupport(): Promise<PasskeySupport> {
+  if (typeof window === 'undefined' || !browserSupportsWebAuthn()) {
+    return { webauthn: false, platformAuthenticator: false, autofill: false };
+  }
+  const [platformAuthenticator, autofill] = await Promise.all([
+    platformAuthenticatorIsAvailable().catch(() => false),
+    browserSupportsWebAuthnAutofill().catch(() => false),
+  ]);
+  return { webauthn: true, platformAuthenticator, autofill };
+}
+
+export interface RegisterPasskeyInput {
+  /** Only for passkey-only sign-up (no session yet). */
+  username?: string;
+  displayName?: string;
+  /** Optional nickname; the server picks a sensible default otherwise. */
+  name?: string;
+}
+
+export interface RegisterPasskeyResult {
+  verified: true;
+  user: AuthUser;
+  passkey: Passkey;
+  passkeyCount: number;
+}
+
+/** Full registration ceremony: fetch options, prompt the authenticator, verify on the server. */
+export async function registerPasskey(input: RegisterPasskeyInput = {}): Promise<RegisterPasskeyResult> {
+  const optionsJSON = await post<PublicKeyCredentialCreationOptionsJSON>('passkeys/register/options', {
+    username: input.username,
+    displayName: input.displayName,
+  });
+  const response = await startRegistration({ optionsJSON });
+  return post<RegisterPasskeyResult>('passkeys/register/verify', { response, name: input.name });
+}
+
+export interface AuthenticatePasskeyInput {
+  username?: string;
+  purpose?: 'signin' | 'reauth';
+  /** Start conditional UI so passkeys show up in the username field's autofill. */
+  useBrowserAutofill?: boolean;
+}
+
+export interface AuthenticatePasskeyResult {
+  verified: true;
+  purpose: 'signin' | 'reauth';
+  user: AuthUser;
+  passkey: Passkey;
+  passkeyCount: number;
+  reauthenticatedAt: number;
+}
+
+/** Full authentication ceremony: fetch options, prompt the authenticator, verify on the server. */
+export async function authenticateWithPasskey(input: AuthenticatePasskeyInput = {}): Promise<AuthenticatePasskeyResult> {
+  const optionsJSON = await post<PublicKeyCredentialRequestOptionsJSON>('passkeys/authenticate/options', {
+    username: input.username,
+    purpose: input.purpose ?? 'signin',
+  });
+  const response = await startAuthentication({ optionsJSON, useBrowserAutofill: input.useBrowserAutofill ?? false });
+  try {
+    return await post<AuthenticatePasskeyResult>('passkeys/authenticate/verify', { response });
+  } catch (error) {
+    if (error instanceof ApiError && error.code === 'UNKNOWN_CREDENTIAL') {
+      // Best effort: ask the authenticator to hide a passkey the server no longer knows about.
+      void signalUnknownCredential(String(error.data.rpId ?? ''), String(error.data.credentialId ?? ''));
+    }
+    throw error;
+  }
+}
+
+export const listPasskeys = () => api<{ passkeys: Passkey[]; rpId: string; userId: string }>('passkeys');
+export const renamePasskey = (id: string, name: string) =>
+  api<{ passkey: Passkey }>(`passkeys/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ name }) });
+export const deletePasskey = (id: string) =>
+  api<{ ok: true; removed: { credentialId: string; rpId: string }; passkeys: Passkey[] }>(`passkeys/${encodeURIComponent(id)}`, { method: 'DELETE' });
+
+// ---------------------------------------------------------------------------
+// Signal API (best effort, silently ignored where unsupported)
+// ---------------------------------------------------------------------------
+
+export async function signalUnknownCredential(rpId: string, credentialId: string): Promise<void> {
+  if (!rpId || !credentialId) return;
+  try {
+    await sendSignal({ signalName: 'unknownCredential', rpID: rpId, credentialID: credentialId });
+  } catch {
+    // Unsupported browser or invalid input; nothing to do.
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId: string, userId: string, allAcceptedCredentialIds: string[]): Promise<void> {
+  if (!rpId || !userId) return;
+  try {
+    await sendSignal({ signalName: 'allAcceptedCredentials', rpID: rpId, userID: userId, allAcceptedCredentialIDs: allAcceptedCredentialIds });
+  } catch {
+    // Unsupported browser; nothing to do.
+  }
+}
+
+export async function signalCurrentUserDetails(rpId: string, userId: string, name: string, displayName: string): Promise<void> {
+  if (!rpId || !userId) return;
+  try {
+    await sendSignal({ signalName: 'currentUserDetails', rpID: rpId, userID: userId, userName: name, userDisplayName: displayName });
+  } catch {
+    // Unsupported browser; nothing to do.
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Error messages
+// ---------------------------------------------------------------------------
+
+/** True when the user simply dismissed the browser's passkey prompt. */
+export function isCeremonyCancelled(error: unknown): boolean {
+  if (error instanceof WebAuthnError) {
+    return error.code === 'ERROR_CEREMONY_ABORTED' || (error.code === 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY' && (error.cause as any)?.name === 'NotAllowedError');
+  }
+  return error instanceof DOMException && (error.name === 'NotAllowedError' || error.name === 'AbortError');
+}
+
+/** Convert any error from the auth flows into something readable. */
+export function describeAuthError(error: unknown, fallback = 'Something went wrong. Please try again.'): string {
+  if (error instanceof ApiError) return error.message;
+  if (error instanceof WebAuthnError) {
+    switch (error.code) {
+      case 'ERROR_CEREMONY_ABORTED':
+        return 'The passkey prompt was cancelled.';
+      case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+        return 'This device already has a passkey for your account.';
+      case 'ERROR_AUTHENTICATOR_MISSING_DISCOVERABLE_CREDENTIAL_SUPPORT':
+        return 'This authenticator cannot store passkeys. Try a different device or security key.';
+      case 'ERROR_AUTHENTICATOR_MISSING_USER_VERIFICATION_SUPPORT':
+        return 'This authenticator cannot verify you with a PIN or biometric.';
+      case 'ERROR_INVALID_DOMAIN':
+      case 'ERROR_INVALID_RP_ID':
+        return 'Passkeys are only available over HTTPS on a valid domain.';
+      case 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY': {
+        const cause = error.cause as any;
+        if (cause?.name === 'NotAllowedError') return 'The passkey prompt was cancelled or timed out.';
+        if (cause?.name === 'SecurityError') return 'Passkeys are only available over HTTPS on a valid domain.';
+        return cause?.message || error.message || fallback;
+      }
+      default:
+        return error.message || fallback;
+    }
+  }
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey prompt was cancelled or timed out.';
+    if (error.name === 'InvalidStateError') return 'This device already has a passkey for your account.';
+    return error.message || fallback;
+  }
+  if (error instanceof Error) return error.message || fallback;
+  return fallback;
+}
