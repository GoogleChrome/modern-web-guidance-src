+/// <reference types="astro/client" />
+
+declare namespace App {
+  interface SessionData {
+    /** The currently signed-in user, if any. */
+    user: import('./lib/auth/store').SessionUser;
+    /** Unix epoch (ms) of the last time the user proved their identity in this session. */
+    reauthenticatedAt: number;
+    /** How the user last proved their identity. */
+    reauthMethod: 'password' | 'passkey';
+    /** In-flight WebAuthn challenge for the current session. */
+    passkeyChallenge: import('./lib/auth/store').PendingChallenge;
+    readingList: string[];
+  }
+}
