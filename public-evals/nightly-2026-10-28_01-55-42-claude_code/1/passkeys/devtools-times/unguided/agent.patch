--- /dev/null
+++ b/src/lib/auth/rp.ts
@@ -0,0 +1,29 @@
+/**
+ * Relying Party configuration for WebAuthn ceremonies.
+ *
+ * The RP ID and expected origin are derived from the incoming request so the
+ * same build works on localhost and behind the Cloud Run proxy. Both can be
+ * pinned explicitly with the PASSKEY_RP_ID / PASSKEY_ORIGIN environment variables.
+ */
+
+export const RP_NAME = 'The DevTools Times';
+
+export interface RelyingParty {
+  rpID: string;
+  origin: string;
+}
+
+export function getRelyingParty(request: Request): RelyingParty {
+  const url = new URL(request.url);
+  const forwardedHost = request.headers.get('x-forwarded-host')?.split(',')[0]?.trim();
+  const forwardedProto = request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim();
+
+  const host = forwardedHost || request.headers.get('host') || url.host;
+  const protocol = forwardedProto ? `${forwardedProto}:` : url.protocol;
+  const hostname = host.replace(/:\d+$/, '').replace(/^\[(.*)\]$/, '$1');
+
+  const rpID = process.env.PASSKEY_RP_ID || hostname;
+  const origin = process.env.PASSKEY_ORIGIN || `${protocol}//${host}`;
+
+  return { rpID, origin };
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..60dcb70
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,89 @@
+import type { APIContext } from 'astro';
+import { findUserById, toSessionUser, type PendingChallenge, type SessionUser, type User } from './store';
+
+/** How long a successful sign-in or reauthentication counts as "fresh" for sensitive actions. */
+export const REAUTH_MAX_AGE_MS = 5 * 60 * 1000;
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export type Session = APIContext['session'];
+
+export function json(body: unknown, init: ResponseInit = {}): Response {
+  return new Response(JSON.stringify(body), {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+  });
+}
+
+export function apiError(status: number, error: string, message: string, extra: Record<string, unknown> = {}): Response {
+  return json({ error, message, ...extra }, { status });
+}
+
+/**
+ * Parse a JSON request body. Bodies without a JSON content type are ignored:
+ * browsers only let cross-site pages send "simple" content types without a
+ * CORS preflight, so insisting on application/json keeps these endpoints from
+ * being driven by a third-party form or fetch.
+ */
+export async function readJson<T = Record<string, unknown>>(request: Request): Promise<T> {
+  const contentType = request.headers.get('content-type') ?? '';
+  if (!contentType.toLowerCase().includes('application/json')) return {} as T;
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return {} as T;
+  }
+}
+
+/** Resolve the signed-in user for this session, dropping stale sessions whose user no longer exists. */
+export async function getSessionUser(session: Session): Promise<User | null> {
+  if (!session) return null;
+  const sessionUser = await session.get('user');
+  if (!sessionUser) return null;
+  const user = findUserById(sessionUser.id);
+  if (!user) {
+    session.delete('user');
+    return null;
+  }
+  return user;
+}
+
+export async function signIn(session: Session, user: User, method: 'password' | 'passkey'): Promise<void> {
+  if (!session) throw new Error('Sessions are not available');
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await session.regenerate();
+  session.set('user', toSessionUser(user));
+  session.set('reauthenticatedAt', Date.now());
+  session.set('reauthMethod', method);
+  session.delete('passkeyChallenge');
+}
+
+export async function markReauthenticated(session: Session, method: 'password' | 'passkey'): Promise<void> {
+  if (!session) return;
+  session.set('reauthenticatedAt', Date.now());
+  session.set('reauthMethod', method);
+}
+
+export async function getReauthState(session: Session): Promise<{ reauthenticatedAt: number | null; fresh: boolean }> {
+  const reauthenticatedAt = (await session?.get('reauthenticatedAt')) ?? null;
+  const fresh = reauthenticatedAt !== null && Date.now() - reauthenticatedAt < REAUTH_MAX_AGE_MS;
+  return { reauthenticatedAt, fresh };
+}
+
+export async function storeChallenge(session: Session, challenge: Omit<PendingChallenge, 'expiresAt'>): Promise<void> {
+  if (!session) throw new Error('Sessions are not available');
+  session.set('passkeyChallenge', { ...challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+}
+
+/** Read and consume the pending challenge. Challenges are single-use. */
+export async function takeChallenge(session: Session, type: PendingChallenge['type']): Promise<PendingChallenge | null> {
+  if (!session) return null;
+  const pending = await session.get('passkeyChallenge');
+  session.delete('passkeyChallenge');
+  if (!pending || pending.type !== type || pending.expiresAt < Date.now()) return null;
+  return pending;
+}
+
+export function publicUser(user: User): SessionUser & { hasPassword: boolean; createdAt: string } {
+  return { ...toSessionUser(user), hasPassword: user.hasPassword, createdAt: user.createdAt };
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..43642a2
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,182 @@
+/**
+ * A tiny JSON-file backed user + passkey credential store.
+ *
+ * The DevTools Times is a demo application, so a durable database is overkill.
+ * Records are kept in memory and flushed to `data/passkeys.json` (override with
+ * the PASSKEY_DB_PATH environment variable) so that passkeys survive restarts.
+ */
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+export interface User {
+  id: string;
+  username: string;
+  displayName: string;
+  /** True once the user has signed in or registered with a password at least once. */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface SessionUser {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+export interface StoredCredential {
+  /** Base64URL credential ID. */
+  id: string;
+  userId: string;
+  /** Base64URL-encoded COSE public key. */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid: string;
+  /** User-facing nickname, e.g. "MacBook Pro Touch ID". */
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface PendingChallenge {
+  type: 'registration' | 'authentication';
+  challenge: string;
+  /** Registration: the user the credential will belong to. Authentication: expected user (reauth) or undefined. */
+  userId?: string;
+  /** Registration of a brand-new, passkey-only account: the user record is only created on success. */
+  newUser?: { username: string; displayName: string };
+  /** Authentication started as a reauthentication of the current session user. */
+  purpose?: 'signin' | 'reauth';
+  expiresAt: number;
+}
+
+interface Database {
+  users: User[];
+  credentials: StoredCredential[];
+}
+
+const DB_PATH = process.env.PASSKEY_DB_PATH ?? join(process.cwd(), 'data', 'passkeys.json');
+
+let db: Database | null = null;
+
+function load(): Database {
+  if (db) return db;
+  if (existsSync(DB_PATH)) {
+    try {
+      const parsed = JSON.parse(readFileSync(DB_PATH, 'utf8')) as Partial<Database>;
+      db = { users: parsed.users ?? [], credentials: parsed.credentials ?? [] };
+      return db;
+    } catch (error) {
+      console.error(`[passkeys] Could not read ${DB_PATH}, starting with an empty store.`, error);
+    }
+  }
+  db = { users: [], credentials: [] };
+  return db;
+}
+
+function persist(): void {
+  if (!db) return;
+  try {
+    mkdirSync(dirname(DB_PATH), { recursive: true });
+    const tmp = `${DB_PATH}.${process.pid}.tmp`;
+    writeFileSync(tmp, JSON.stringify(db, null, 2));
+    renameSync(tmp, DB_PATH);
+  } catch (error) {
+    console.error(`[passkeys] Could not persist ${DB_PATH}.`, error);
+  }
+}
+
+export const USERNAME_PATTERN = /^[a-zA-Z0-9._-]{3,32}$/;
+
+export function normalizeUsername(username: string): string {
+  return username.trim().toLowerCase();
+}
+
+export function toSessionUser(user: User): SessionUser {
+  return { id: user.id, username: user.username, displayName: user.displayName };
+}
+
+export function findUserById(id: string): User | undefined {
+  return load().users.find((u) => u.id === id);
+}
+
+export function findUserByUsername(username: string): User | undefined {
+  const normalized = normalizeUsername(username);
+  return load().users.find((u) => u.username === normalized);
+}
+
+export function createUser(input: { id?: string; username: string; displayName?: string; hasPassword: boolean }): User {
+  const data = load();
+  const username = normalizeUsername(input.username);
+  const user: User = {
+    id: input.id ?? randomUUID(),
+    username,
+    displayName: input.displayName?.trim() || input.username.trim(),
+    hasPassword: input.hasPassword,
+    createdAt: new Date().toISOString(),
+  };
+  data.users.push(user);
+  persist();
+  return user;
+}
+
+/** Find or create the local account that mirrors a username verified by the password API. */
+export function ensurePasswordUser(username: string): User {
+  const existing = findUserByUsername(username);
+  if (existing) {
+    if (!existing.hasPassword) {
+      existing.hasPassword = true;
+      persist();
+    }
+    return existing;
+  }
+  return createUser({ username, hasPassword: true });
+}
+
+export function updateUser(id: string, patch: Partial<Pick<User, 'displayName'>>): User | undefined {
+  const user = findUserById(id);
+  if (!user) return undefined;
+  if (patch.displayName !== undefined) user.displayName = patch.displayName;
+  persist();
+  return user;
+}
+
+export function listCredentials(userId: string): StoredCredential[] {
+  return load()
+    .credentials.filter((c) => c.userId === userId)
+    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+}
+
+export function findCredential(id: string): StoredCredential | undefined {
+  return load().credentials.find((c) => c.id === id);
+}
+
+export function addCredential(credential: StoredCredential): StoredCredential {
+  const data = load();
+  data.credentials.push(credential);
+  persist();
+  return credential;
+}
+
+export function updateCredential(
+  id: string,
+  patch: Partial<Pick<StoredCredential, 'name' | 'counter' | 'lastUsedAt' | 'backedUp'>>,
+): StoredCredential | undefined {
+  const credential = findCredential(id);
+  if (!credential) return undefined;
+  Object.assign(credential, patch);
+  persist();
+  return credential;
+}
+
+export function deleteCredential(id: string, userId: string): boolean {
+  const data = load();
+  const before = data.credentials.length;
+  data.credentials = data.credentials.filter((c) => !(c.id === id && c.userId === userId));
+  const removed = data.credentials.length !== before;
+  if (removed) persist();
+  return removed;
+}
