+/**
+ * Thin proxy around the external password API that The DevTools Times has
+ * always used. Password verification stays with that service; this app only
+ * mirrors the username locally so passkeys can be attached to it.
+ */
+const EXTERNAL_API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface ExternalAuthResult {
+  ok: boolean;
+  status: number;
+  /** Error code such as APP_ERR_2001, present on failure. */
+  error?: string;
+  message?: string;
+  token?: string;
+}
+
+async function call(path: 'login' | 'register', username: string, password: string): Promise<ExternalAuthResult> {
+  try {
+    const response = await fetch(`${EXTERNAL_API_BASE}/${path}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    let data: Record<string, unknown> = {};
+    try {
+      data = (await response.json()) as Record<string, unknown>;
+    } catch {
+      // Non-JSON body; fall through with status only.
+    }
+    return {
+      ok: response.ok,
+      status: response.status,
+      error: typeof data.error === 'string' ? data.error : undefined,
+      message: typeof data.message === 'string' ? data.message : undefined,
+      token: typeof data.token === 'string' ? data.token : undefined,
+    };
+  } catch (error) {
+    console.error(`[auth] External ${path} call failed`, error);
+    return { ok: false, status: 502, error: 'UPSTREAM_UNAVAILABLE', message: 'The sign-in service is unreachable. Please try again later.' };
+  }
+}
+
+export const verifyPassword = (username: string, password: string) => call('login', username, password);
+export const registerPassword = (username: string, password: string) => call('register', username, password);
