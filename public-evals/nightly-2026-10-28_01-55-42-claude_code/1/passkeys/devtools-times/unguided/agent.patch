index 0000000..04b4200
--- /dev/null
+++ b/src/pages/api/auth/passkeys/authenticate/options.ts
@@ -0,0 +1,56 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../../lib/auth/rp';
+import { apiError, getSessionUser, json, readJson, storeChallenge } from '../../../../../lib/auth/session';
+import { findUserByUsername, listCredentials } from '../../../../../lib/auth/store';
+
+export const prerender = false;
+
+/**
+ * Step 1 of passkey authentication.
+ *
+ * - `purpose: "signin"` (default): username-less, discoverable-credential sign-in.
+ *   If a username is supplied the request is narrowed to that account's passkeys.
+ * - `purpose: "reauth"`: the signed-in user confirms it is still them; only
+ *   their own passkeys are allowed.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return apiError(500, 'NO_SESSION', 'Sessions are not configured.');
+  const { rpID } = getRelyingParty(request);
+  const body = await readJson<{ username?: unknown; purpose?: unknown }>(request);
+  const purpose = body.purpose === 'reauth' ? 'reauth' : 'signin';
+
+  let allowCredentials: { id: string; transports?: string[] }[] | undefined;
+  let userId: string | undefined;
+
+  if (purpose === 'reauth') {
+    const user = await getSessionUser(session);
+    if (!user) return apiError(401, 'UNAUTHENTICATED', 'You need to sign in first.');
+    const credentials = listCredentials(user.id);
+    if (credentials.length === 0) {
+      return apiError(400, 'NO_PASSKEYS', 'This account has no passkeys yet.');
+    }
+    userId = user.id;
+    allowCredentials = credentials.map((c) => ({ id: c.id, transports: c.transports }));
+  } else if (typeof body.username === 'string' && body.username.trim()) {
+    const user = findUserByUsername(body.username);
+    const credentials = user ? listCredentials(user.id) : [];
+    if (!user || credentials.length === 0) {
+      // Do not reveal whether the account exists; fall back to a discoverable request.
+      allowCredentials = undefined;
+    } else {
+      userId = user.id;
+      allowCredentials = credentials.map((c) => ({ id: c.id, transports: c.transports }));
+    }
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials,
+    userVerification: 'preferred',
+  });
+
+  await storeChallenge(session, { type: 'authentication', challenge: options.challenge, userId, purpose });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/authenticate/verify.ts b/src/pages/api/auth/passkeys/authenticate/verify.ts
new file mode 100644
index 0000000..e6809e3
--- /dev/null
+++ b/src/pages/api/auth/passkeys/authenticate/verify.ts
@@ -0,0 +1,108 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getRelyingParty } from '../../../../../lib/auth/rp';
+import {
+  apiError,
+  getSessionUser,
+  json,
+  markReauthenticated,
+  publicUser,
+  readJson,
+  signIn,
+  takeChallenge,
+} from '../../../../../lib/auth/session';
+import { findCredential, findUserById, listCredentials, updateCredential } from '../../../../../lib/auth/store';
+import { serializeCredential } from '../../../../../lib/auth/describe';
+
+export const prerender = false;
+
+/** Step 2 of passkey authentication: verify the assertion and sign in (or reauthenticate). */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID, origin } = getRelyingParty(request);
+  const body = await readJson<{ response?: AuthenticationResponseJSON }>(request);
+  if (!body.response?.id || !body.response.response?.clientDataJSON) {
+    return apiError(400, 'INVALID_RESPONSE', 'Missing authentication response.');
+  }
+
+  const pending = await takeChallenge(session, 'authentication');
+  if (!pending) {
+    return apiError(400, 'CHALLENGE_EXPIRED', 'Your sign-in request expired. Please try again.');
+  }
+
+  const credential = findCredential(body.response.id);
+  if (!credential) {
+    // Tell the browser so it can offer to clean up the orphaned passkey.
+    return apiError(404, 'UNKNOWN_CREDENTIAL', 'This passkey is not registered with The DevTools Times.', {
+      credentialId: body.response.id,
+      rpId: rpID,
+    });
+  }
+
+  if (pending.userId && pending.userId !== credential.userId) {
+    return apiError(403, 'WRONG_ACCOUNT', 'That passkey belongs to a different account.');
+  }
+
+  const user = findUserById(credential.userId);
+  if (!user) {
+    return apiError(404, 'UNKNOWN_CREDENTIAL', 'The account for this passkey no longer exists.', {
+      credentialId: body.response.id,
+      rpId: rpID,
+    });
+  }
+
+  // The userHandle, when present, must match the account the credential is bound to.
+  const userHandle = body.response.response.userHandle;
+  if (userHandle && isoBase64URL.toUTF8String(userHandle) !== user.id) {
+    return apiError(400, 'USER_HANDLE_MISMATCH', 'This passkey does not match its account.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: credential.id,
+        publicKey: isoBase64URL.toBuffer(credential.publicKey),
+        counter: credential.counter,
+        transports: credential.transports,
+      },
+      requireUserVerification: false,
+    });
+  } catch (error) {
+    console.error('[passkeys] Authentication verification failed', error);
+    return apiError(400, 'VERIFICATION_FAILED', error instanceof Error ? error.message : 'Passkey could not be verified.');
+  }
+
+  if (!verification.verified) {
+    return apiError(401, 'VERIFICATION_FAILED', 'Passkey could not be verified.');
+  }
+
+  updateCredential(credential.id, {
+    counter: verification.authenticationInfo.newCounter,
+    lastUsedAt: new Date().toISOString(),
+    backedUp: verification.authenticationInfo.credentialBackedUp,
+  });
+
+  if (pending.purpose === 'reauth') {
+    const current = await getSessionUser(session);
+    if (!current || current.id !== user.id) {
+      return apiError(403, 'WRONG_ACCOUNT', 'That passkey belongs to a different account.');
+    }
+    await markReauthenticated(session, 'passkey');
+  } else {
+    await signIn(session, user, 'passkey');
+  }
+
+  return json({
+    verified: true,
+    purpose: pending.purpose ?? 'signin',
+    user: publicUser(user),
+    passkey: serializeCredential(findCredential(credential.id)!),
+    passkeyCount: listCredentials(user.id).length,
+    reauthenticatedAt: Date.now(),
+  });
+};
