diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
new file mode 100644
index 0000000..fb54c21
--- /dev/null
+++ b/src/components/ReauthDialog.tsx
@@ -0,0 +1,171 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { XMarkIcon } from '@heroicons/react/24/outline';
+import { authenticateWithPasskey, describeAuthError, isCeremonyCancelled, passwordReauth } from '../lib/auth/client';
+import PasskeyIcon from './PasskeyIcon';
+
+export interface ReauthDialogProps {
+  open: boolean;
+  /** What the user is about to do, shown as context. */
+  reason: string;
+  canUsePasskey: boolean;
+  canUsePassword: boolean;
+  onSuccess: (method: 'passkey' | 'password') => void;
+  onCancel: () => void;
+}
+
+/**
+ * "Confirm it's you" modal shown before sensitive account actions.
+ * Offers whichever of passkey / password the account actually has.
+ */
+export default function ReauthDialog({ open, reason, canUsePasskey, canUsePassword, onSuccess, onCancel }: ReauthDialogProps) {
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState<'passkey' | 'password' | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (!open) {
+      setPassword('');
+      setBusy(null);
+      setError(null);
+      return;
+    }
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') onCancel();
+    };
+    window.addEventListener('keydown', onKey);
+    // Move focus into the dialog so keyboard users land in the right place.
+    const focusable = dialogRef.current?.querySelector<HTMLElement>('button, input');
+    focusable?.focus();
+    return () => window.removeEventListener('keydown', onKey);
+  }, [open, onCancel]);
+
+  if (!open) return null;
+
+  const handlePasskey = async () => {
+    setError(null);
+    setBusy('passkey');
+    try {
+      await authenticateWithPasskey({ purpose: 'reauth' });
+      onSuccess('passkey');
+    } catch (err) {
+      if (!isCeremonyCancelled(err)) setError(describeAuthError(err, 'Passkey verification failed.'));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handlePassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setBusy('password');
+    try {
+      await passwordReauth(password);
+      onSuccess('password');
+    } catch (err) {
+      setError(describeAuthError(err, 'That password is not correct.'));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[99999] flex justify-center items-start p-4 pt-[15vh]"
+      onClick={onCancel}
+      role="presentation"
+    >
+      <div
+        ref={dialogRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="reauth-title"
+        className="bg-white shadow-xl rounded-lg w-full max-w-md relative p-6"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <button
+          type="button"
+          onClick={onCancel}
+          aria-label="Close"
+          className="absolute top-3 right-3 p-1 rounded-full text-gray-400 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900"
+        >
+          <XMarkIcon className="h-5 w-5" />
+        </button>
+
+        <h3 id="reauth-title" className="text-lg font-bold text-gray-900">
+          Confirm it’s you
+        </h3>
+        <p className="mt-1 text-sm text-gray-600">
+          For your security, please verify your identity before you {reason}. This keeps your account safe if someone
+          else picks up your device while you’re signed in.
+        </p>
+
+        {error && (
+          <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        <div className="mt-5 space-y-4">
+          {canUsePasskey && (
+            <button
+              type="button"
+              onClick={handlePasskey}
+              disabled={busy !== null}
+              className="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+            >
+              <PasskeyIcon className="h-5 w-5" />
+              {busy === 'passkey' ? 'Waiting for your passkey…' : 'Verify with a passkey'}
+            </button>
+          )}
+
+          {canUsePasskey && canUsePassword && (
+            <div className="relative">
+              <div className="absolute inset-0 flex items-center" aria-hidden="true">
+                <div className="w-full border-t border-gray-200" />
+              </div>
+              <div className="relative flex justify-center text-xs uppercase tracking-wider">
+                <span className="bg-white px-2 text-gray-400">or</span>
+              </div>
+            </div>
+          )}
+
+          {canUsePassword && (
+            <form onSubmit={handlePassword} className="space-y-3">
+              <div>
+                <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700 mb-1">
+                  Password
+                </label>
+                <input
+                  id="reauth-password"
+                  type="password"
+                  value={password}
+                  onChange={(e) => setPassword(e.target.value)}
+                  required
+                  autoComplete="current-password"
+                  disabled={busy !== null}
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:bg-gray-50"
+                />
+              </div>
+              <button
+                type="submit"
+                disabled={busy !== null || !password}
+                className={`w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed ${
+                  canUsePasskey
+                    ? 'border border-gray-300 text-gray-800 bg-white hover:bg-gray-50'
+                    : 'border border-transparent text-white bg-gray-900 hover:bg-gray-800'
+                }`}
+              >
+                {busy === 'password' ? 'Verifying…' : 'Verify with password'}
+              </button>
+            </form>
+          )}
+
+          {!canUsePasskey && !canUsePassword && (
+            <p className="text-sm text-red-700">This account has no usable sign-in method on this device.</p>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
