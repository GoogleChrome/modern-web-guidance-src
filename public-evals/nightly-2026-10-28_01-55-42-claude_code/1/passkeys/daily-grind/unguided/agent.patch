+/**
+ * Shared navigation: swaps the "Sign In" / "Logout" control based on the
+ * passkey session and keeps it in sync across tabs.
+ */
+import { getCurrentUser, signOut, onChange } from '/assets/passkeys.js';
+
+function render() {
+  const slot = document.querySelector('[data-nav-auth]');
+  if (!slot) return;
+  const user = getCurrentUser();
+  slot.replaceChildren();
+
+  if (user) {
+    const greeting = document.createElement('span');
+    greeting.className = 'nav-user';
+    greeting.append('Hi, ');
+    const strong = document.createElement('strong');
+    strong.textContent = user.name.split(' ')[0];
+    greeting.append(strong);
+
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'logout-link';
+    button.textContent = 'Logout';
+    button.style.marginLeft = '20px';
+    button.addEventListener('click', () => signOut());
+
+    slot.append(greeting, button);
+  } else {
+    const link = document.createElement('a');
+    link.href = '/account/';
+    link.className = 'logout-link';
+    link.textContent = 'Sign In';
+    slot.append(link);
+  }
+}
+
+onChange(render);
+render();
diff --git a/assets/passkeys.js b/assets/passkeys.js
new file mode 100644
index 0000000..b5658e5
--- /dev/null
+++ b/assets/passkeys.js
@@ -0,0 +1,935 @@
+/**
+ * The Daily Grind – passkey relying party (browser-side).
+ *
+ * This site is served statically, so the "server" half of WebAuthn lives in
+ * the browser: challenges are issued and consumed here, attestation and
+ * assertion responses are parsed and verified with WebCrypto, and accounts +
+ * public keys are persisted in localStorage. The verification steps mirror
+ * what a real server would do (type/challenge/origin checks, rpIdHash, flags,
+ * signature over authenticatorData || SHA-256(clientDataJSON), counter check)
+ * so swapping in a real backend later only means moving these functions.
+ */
+
+const DB_KEY = 'dailygrind.passkeys.db.v1';
+const SESSION_KEY = 'dailygrind.passkeys.session.v1';
+const RP_NAME = 'The Daily Grind';
+const RP_ID = location.hostname;
+const ORIGIN = location.origin;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;      // how long a verification stays "fresh"
+const CHALLENGE_TTL_MS = 2 * 60 * 1000;      // modal ceremonies
+const CONDITIONAL_TTL_MS = 15 * 60 * 1000;   // autofill ceremonies can sit idle a while
+
+/* ------------------------------------------------------------------ */
+/* Encoding helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+export const b64u = {
+  encode(buf) {
+    const bytes = buf instanceof Uint8Array ? buf : new Uint8Array(buf);
+    let s = '';
+    for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
+    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  decode(str) {
+    const norm = String(str).replace(/-/g, '+').replace(/_/g, '/');
+    const pad = norm.length % 4 ? '='.repeat(4 - (norm.length % 4)) : '';
+    const bin = atob(norm + pad);
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+    return out;
+  },
+};
+
+function concat(...parts) {
+  const total = parts.reduce((n, p) => n + p.byteLength, 0);
+  const out = new Uint8Array(total);
+  let off = 0;
+  for (const p of parts) {
+    out.set(p instanceof Uint8Array ? p : new Uint8Array(p), off);
+    off += p.byteLength;
+  }
+  return out;
+}
+
+function bytesEqual(a, b) {
+  if (a.byteLength !== b.byteLength) return false;
+  for (let i = 0; i < a.byteLength; i++) if (a[i] !== b[i]) return false;
+  return true;
+}
+
+async function sha256(data) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', data));
+}
+
+function randomBytes(n) {
+  return crypto.getRandomValues(new Uint8Array(n));
+}
+
+function uuidFromBytes(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Minimal CBOR decoder (enough for attestationObject + COSE keys)     */
+/* ------------------------------------------------------------------ */
+
+export function cborDecode(input) {
+  const bytes = input instanceof Uint8Array ? input : new Uint8Array(input);
+  const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let off = 0;
+
+  const readLength = (ai) => {
+    if (ai < 24) return ai;
+    if (ai === 24) return dv.getUint8(off++);
+    if (ai === 25) { const v = dv.getUint16(off); off += 2; return v; }
+    if (ai === 26) { const v = dv.getUint32(off); off += 4; return v; }
+    if (ai === 27) { const v = Number(dv.getBigUint64(off)); off += 8; return v; }
+    throw new Error('CBOR: indefinite lengths are not supported');
+  };
+
+  const item = () => {
+    const head = dv.getUint8(off++);
+    const major = head >> 5;
+    const ai = head & 0x1f;
+    switch (major) {
+      case 0: return readLength(ai);
+      case 1: return -1 - readLength(ai);
+      case 2: { const n = readLength(ai); const v = bytes.slice(off, off + n); off += n; return v; }
+      case 3: { const n = readLength(ai); const v = new TextDecoder().decode(bytes.subarray(off, off + n)); off += n; return v; }
+      case 4: { const n = readLength(ai); const arr = []; for (let i = 0; i < n; i++) arr.push(item()); return arr; }
+      case 5: { const n = readLength(ai); const map = new Map(); for (let i = 0; i < n; i++) { const k = item(); map.set(k, item()); } return map; }
+      case 6: { readLength(ai); return item(); } // tag: ignore and return content
+      case 7: {
+        if (ai === 20) return false;
+        if (ai === 21) return true;
+        if (ai === 22) return null;
+        if (ai === 23) return undefined;
+        if (ai === 25) { off += 2; return NaN; } // half floats unused here
+        if (ai === 26) { const v = dv.getFloat32(off); off += 4; return v; }
+        if (ai === 27) { const v = dv.getFloat64(off); off += 8; return v; }
+        throw new Error('CBOR: unsupported simple value');
+      }
+      default: throw new Error('CBOR: unsupported major type');
+    }
+  };
+
+  const value = item();
+  return { value, bytesRead: off };
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticator data + COSE parsing                                   */
+/* ------------------------------------------------------------------ */
+
+export function parseAuthenticatorData(bytes) {
+  if (bytes.byteLength < 37) throw new Error('Authenticator data is too short');
+  const flagsByte = bytes[32];
+  const out = {
+    rpIdHash: bytes.slice(0, 32),
+    flags: {
+      userPresent: !!(flagsByte & 0x01),
+      userVerified: !!(flagsByte & 0x04),
+      backupEligible: !!(flagsByte & 0x08),
+      backedUp: !!(flagsByte & 0x10),
+      attestedCredentialData: !!(flagsByte & 0x40),
+      extensionData: !!(flagsByte & 0x80),
+    },
+    counter: new DataView(bytes.buffer, bytes.byteOffset + 33, 4).getUint32(0),
+  };
+  let off = 37;
+  if (out.flags.attestedCredentialData) {
+    out.aaguid = uuidFromBytes(bytes.slice(off, off + 16));
+    off += 16;
+    const len = (bytes[off] << 8) | bytes[off + 1];
+    off += 2;
+    out.credentialId = bytes.slice(off, off + len);
+    off += len;
+    const { value, bytesRead } = cborDecode(bytes.subarray(off));
+    out.cosePublicKey = value;
+    off += bytesRead;
+  }
+  if (out.flags.extensionData && off < bytes.byteLength) {
+    try { out.extensions = cborDecode(bytes.subarray(off)).value; } catch { /* ignore */ }
+  }
+  return out;
+}
+
+/** Convert a COSE_Key map into a JWK we can persist and import into WebCrypto. */
+export function coseToJwk(cose) {
+  if (!(cose instanceof Map)) throw new Error('Invalid COSE key');
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  if (kty === 2 && alg === -7) {
+    if (cose.get(-1) !== 1) throw new Error('Unsupported EC curve');
+    return { kty: 'EC', crv: 'P-256', x: b64u.encode(cose.get(-2)), y: b64u.encode(cose.get(-3)), ext: true };
+  }
+  if (kty === 3 && alg === -257) {
+    return { kty: 'RSA', n: b64u.encode(cose.get(-1)), e: b64u.encode(cose.get(-2)), alg: 'RS256', ext: true };
+  }
+  throw new Error(`Unsupported public key algorithm (${alg})`);
+}
+
+function algorithmParams(alg) {
+  if (alg === -7) return { import: { name: 'ECDSA', namedCurve: 'P-256' }, verify: { name: 'ECDSA', hash: 'SHA-256' } };
+  if (alg === -257) return { import: { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, verify: { name: 'RSASSA-PKCS1-v1_5' } };
+  throw new Error(`Unsupported algorithm ${alg}`);
+}
+
+/** WebAuthn ECDSA signatures are ASN.1 DER; WebCrypto wants raw r||s. */
+function derEcdsaToRaw(der, size = 32) {
+  let off = 0;
+  if (der[off++] !== 0x30) throw new Error('Malformed signature');
+  if (der[off] & 0x80) off += 1 + (der[off] & 0x7f); else off += 1;
+  const readInt = () => {
+    if (der[off++] !== 0x02) throw new Error('Malformed signature');
+    let len = der[off++];
+    if (len & 0x80) { const n = len & 0x7f; len = 0; for (let i = 0; i < n; i++) len = (len << 8) | der[off++]; }
+    let v = der.slice(off, off + len);
+    off += len;
+    if (v.length > size) v = v.slice(v.length - size);
+    const out = new Uint8Array(size);
+    out.set(v, size - v.length);
+    return out;
+  };
+  const r = readInt();
+  const s = readInt();
+  return concat(r, s);
+}
+
+async function verifySignature({ jwk, alg, authenticatorData, clientDataJSON, signature }) {
+  const params = algorithmParams(alg);
+  const key = await crypto.subtle.importKey('jwk', jwk, params.import, false, ['verify']);
+  const signed = concat(authenticatorData, await sha256(clientDataJSON));
+  const sig = alg === -7 ? derEcdsaToRaw(signature) : signature;
+  return crypto.subtle.verify(params.verify, key, sig, signed);
+}
+
+function parseClientData(clientDataJSON) {
+  return JSON.parse(new TextDecoder().decode(clientDataJSON));
+}
+
+/* ------------------------------------------------------------------ */
+/* Storage                                                             */
+/* ------------------------------------------------------------------ */
+
+function loadDb() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(DB_KEY) || 'null');
+    if (parsed && typeof parsed === 'object' && parsed.users) return parsed;
+  } catch { /* corrupt → start fresh */ }
+  return { users: {} };
+}
+
+function saveDb(db) {
+  localStorage.setItem(DB_KEY, JSON.stringify(db));
+}
+
+function loadSession() {
+  try { return JSON.parse(localStorage.getItem(SESSION_KEY) || 'null'); } catch { return null; }
+}
+
+function saveSession(session) {
+  if (session) localStorage.setItem(SESSION_KEY, JSON.stringify(session));
+  else localStorage.removeItem(SESSION_KEY);
+  notify();
+}
+
+function findUserByEmail(db, email) {
+  const needle = normalizeEmail(email);
+  return Object.values(db.users).find((u) => normalizeEmail(u.email) === needle) || null;
+}
+
+function findByCredentialId(db, credentialId) {
+  for (const user of Object.values(db.users)) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) return { user, passkey };
+  }
+  return null;
+}
+
+function logActivity(user, type, detail) {
+  user.activity = user.activity || [];
+  user.activity.unshift({ at: new Date().toISOString(), type, detail });
+  user.activity = user.activity.slice(0, 25);
+}
+
+export function normalizeEmail(email) {
+  return String(email || '').trim().toLowerCase();
+}
+
+export function isValidEmail(email) {
+  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim());
