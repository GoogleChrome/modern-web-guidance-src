+/**
+ * My Account page controller: registration, passkey sign-in (modal +
+ * autofill), passkey management, profile updates and re-authentication.
+ */
+import * as pk from '/assets/passkeys.js';
+
+const $ = (id) => document.getElementById(id);
+
+const ui = {
+  unsupported: $('unsupported-notice'),
+  signedOut: $('view-signed-out'),
+  signedIn: $('view-signed-in'),
+  // sign-in
+  signinForm: $('signin-form'),
+  signinEmail: $('signin-email'),
+  signinBtn: $('signin-btn'),
+  signinStatus: $('signin-status'),
+  supportLine: $('support-line'),
+  // register
+  registerForm: $('register-form'),
+  registerName: $('register-name'),
+  registerEmail: $('register-email'),
+  registerBtn: $('register-btn'),
+  registerStatus: $('register-status'),
+  // profile
+  avatar: $('profile-avatar'),
+  nameDisplay: $('profile-name-display'),
+  emailDisplay: $('profile-email-display'),
+  since: $('profile-since'),
+  statPoints: $('stat-points'),
+  statPasskeys: $('stat-passkeys'),
+  statLastSignin: $('stat-last-signin'),
+  profileForm: $('profile-form'),
+  profileName: $('profile-name'),
+  profileEmail: $('profile-email'),
+  profileSave: $('profile-save'),
+  profileReset: $('profile-reset'),
+  profileStatus: $('profile-status'),
+  // security
+  freshness: $('freshness'),
+  freshnessText: $('freshness-text'),
+  reauthBtn: $('reauth-btn'),
+  signoutBtn: $('signout-btn'),
+  deleteAccountBtn: $('delete-account-btn'),
+  securityStatus: $('security-status'),
+  // passkeys
+  addPasskeyBtn: $('add-passkey-btn'),
+  passkeysStatus: $('passkeys-status'),
+  passkeyList: $('passkey-list'),
+  // activity
+  activityList: $('activity-list'),
+  // dialogs
+  reauthDialog: $('reauth-dialog'),
+  reauthReason: $('reauth-reason'),
+  reauthStatus: $('reauth-status'),
+  reauthConfirm: $('reauth-confirm'),
+  addPasskeyDialog: $('add-passkey-dialog'),
+  addPasskeyForm: $('add-passkey-form'),
+  addPasskeyName: $('add-passkey-name'),
+  addPasskeyStatus: $('add-passkey-status'),
+  addPasskeyConfirm: $('add-passkey-confirm'),
+  confirmDialog: $('confirm-dialog'),
+  confirmTitle: $('confirm-title'),
+  confirmMessage: $('confirm-message'),
+  confirmOk: $('confirm-ok'),
+  toasts: $('toasts'),
+};
+
+const state = {
+  caps: null,
+  conditionalAbort: null,
+  conditionalRestarts: 0,
+  editingPasskeyId: null,
+  freshnessTimer: null,
+};
+
+/* ------------------------------------------------------------------ */
+/* Small UI helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+function setStatus(el, message, kind = 'info') {
+  if (!el) return;
+  el.className = 'notice' + (kind !== 'info' ? ` notice--${kind}` : '');
+  el.textContent = message || '';
+}
+
+function toast(message, kind = 'info') {
+  if (!message) return;
+  const el = document.createElement('div');
+  el.className = 'toast' + (kind !== 'info' ? ` toast--${kind}` : '');
+  el.textContent = message;
+  ui.toasts.append(el);
+  setTimeout(() => el.remove(), 4500);
+}
+
+function busy(button, isBusy, label) {
+  if (!button) return;
+  if (isBusy) {
+    button.dataset.label = button.innerHTML;
+    button.disabled = true;
+    button.innerHTML = `<span class="spinner" aria-hidden="true"></span>${label || 'Waiting for your passkey…'}`;
+  } else {
+    button.disabled = false;
+    if (button.dataset.label) button.innerHTML = button.dataset.label;
+    delete button.dataset.label;
+  }
+}
+
+function initials(name) {
+  return String(name || '?')
+    .split(/\s+/)
+    .filter(Boolean)
+    .slice(0, 2)
+    .map((part) => part[0].toUpperCase())
+    .join('') || '?';
+}
+
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text != null) node.textContent = text;
+  return node;
+}
+
+function errorMessage(err) {
+  console.warn('[passkeys]', err);
+  return pk.describeError(err);
+}
+
+/* ------------------------------------------------------------------ */
+/* Dialog plumbing                                                     */
+/* ------------------------------------------------------------------ */
+
+for (const dialog of document.querySelectorAll('dialog')) {
+  dialog.querySelectorAll('[data-close]').forEach((btn) => btn.addEventListener('click', () => dialog.close('cancel')));
+  dialog.addEventListener('click', (event) => {
+    // click on backdrop closes
+    if (event.target === dialog) dialog.close('cancel');
+  });
+}
+
+function openDialog(dialog) {
+  if (typeof dialog.showModal === 'function') dialog.showModal();
+  else dialog.setAttribute('open', '');
+}
+
+/** Generic confirmation. Resolves true when the user confirms. */
+function confirmAction({ title, message, confirmLabel = 'Confirm', danger = true }) {
+  return new Promise((resolve) => {
+    ui.confirmTitle.textContent = title;
+    ui.confirmMessage.textContent = message;
+    ui.confirmOk.textContent = confirmLabel;
+    ui.confirmOk.className = `btn ${danger ? 'btn--danger' : 'btn--accent'}`;
+    const onOk = () => { cleanup(); ui.confirmDialog.close('ok'); resolve(true); };
+    const onClose = () => { cleanup(); resolve(ui.confirmDialog.returnValue === 'ok'); };
+    const cleanup = () => {
+      ui.confirmOk.removeEventListener('click', onOk);
+      ui.confirmDialog.removeEventListener('close', onClose);
+    };
+    ui.confirmOk.addEventListener('click', onOk);
+    ui.confirmDialog.addEventListener('close', onClose);
+    openDialog(ui.confirmDialog);
+  });
+}
+
+/**
+ * Step-up authentication. Resolves true if the session is fresh or the user
+ * just re-verified with a passkey; false if they cancelled.
+ */
+function ensureFresh(reason) {
+  if (pk.isRecentlyVerified()) return Promise.resolve(true);
+  return new Promise((resolve) => {
+    ui.reauthReason.textContent = `To ${reason}, please confirm it's you with your passkey. You won't be asked again for a few minutes.`;
+    setStatus(ui.reauthStatus, '');
+    let settled = false;
+
+    const onConfirm = async () => {
+      busy(ui.reauthConfirm, true, 'Verifying…');
+      setStatus(ui.reauthStatus, '');
+      try {
+        await pk.reauthenticate();
+        settled = true;
+        cleanup();
+        ui.reauthDialog.close('ok');
+        toast('Identity verified', 'success');
+        renderFreshness();
+        resolve(true);
+      } catch (err) {
+        setStatus(ui.reauthStatus, errorMessage(err), 'error');
+      } finally {
+        busy(ui.reauthConfirm, false);
+      }
+    };
+    const onClose = () => { if (!settled) { cleanup(); resolve(false); } };
+    const cleanup = () => {
+      ui.reauthConfirm.removeEventListener('click', onConfirm);
+      ui.reauthDialog.removeEventListener('close', onClose);
+    };
+    ui.reauthConfirm.addEventListener('click', onConfirm);
+    ui.reauthDialog.addEventListener('close', onClose);
+    openDialog(ui.reauthDialog);
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+function render() {
+  const user = pk.getCurrentUser();
+  if (user) {
+    ui.signedOut.hidden = true;
+    ui.signedIn.hidden = false;
+    stopConditionalUI();
+    renderProfile(user);
+    renderPasskeys(user);
+    renderFreshness();
+    renderActivity(user);
+  } else {
+    ui.signedIn.hidden = true;
+    ui.signedOut.hidden = false;
+    state.editingPasskeyId = null;
+    startConditionalUI();
+  }
+}
+
+function renderSupport(caps) {
+  ui.supportLine.replaceChildren();
+  const dot = el('span', 'dot');
+  const text = el('span');
+  if (!caps.supported) {
+    dot.classList.add('bad');
+    text.textContent = caps.secureContext
+      ? 'This browser does not support passkeys.'
+      : 'Passkeys require HTTPS or localhost.';
+  } else {
+    dot.classList.add('ok');
+    const bits = [];
+    bits.push(caps.platformAuthenticator ? 'Built-in authenticator ready' : 'Use a phone or security key');
+    if (caps.conditionalMediation) bits.push('passkey autofill on');
+    if (caps.signalApi) bits.push('provider sync on');
+    text.textContent = bits.join(' · ') + '.';
+  }
+  ui.supportLine.append(dot, text);
+}
+
+function renderProfile(user) {
+  ui.avatar.textContent = initials(user.name);
+  ui.nameDisplay.textContent = user.name;
+  ui.emailDisplay.textContent = user.email;
+  ui.since.textContent = `Member since ${pk.formatDate(user.createdAt)}`;
+  ui.statPoints.textContent = String(user.rewardsPoints);
+  ui.statPasskeys.textContent = String(user.passkeys.length);
+  const session = pk.getSession();
+  ui.statLastSignin.textContent = session ? pk.formatRelative(session.signedInAt) : '—';
+
+  // Don't clobber in-progress edits.
+  if (document.activeElement !== ui.profileName && document.activeElement !== ui.profileEmail) {
+    ui.profileName.value = user.name;
+    ui.profileEmail.value = user.email;
+  }
+}
+
+function renderFreshness() {
+  const age = pk.verificationAgeMs();
+  const fresh = age < pk.reauthWindowMs;
+  ui.freshness.classList.toggle('is-fresh', fresh);
+  ui.freshness.classList.toggle('is-stale', !fresh);
+  if (fresh) {
+    const remaining = Math.max(1, Math.ceil((pk.reauthWindowMs - age) / 60000));
+    ui.freshnessText.textContent = `Verified ${pk.formatRelative(Date.now() - age)} · sensitive changes allowed for ${remaining} more min`;
+  } else {
+    ui.freshnessText.textContent = 'Not recently verified · you’ll be asked for your passkey before sensitive changes';
+  }
+}
+
+const ICONS = {
+  'security-key': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="13" height="8" rx="2"/><path d="M15 10h5a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-5"/><circle cx="7" cy="12" r="1.5"/></svg>',
+  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>',
+  synced: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a6 6 0 1 1 1.3-11.9A5.5 5.5 0 0 1 21 9.5c0 .5-.1 1-.2 1.5A4 4 0 0 1 17.5 19z"/><path d="M12 12v5"/><path d="m9.5 14.5 2.5-2.5 2.5 2.5"/></svg>',
+  device: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8"/><path d="M12 16v4"/></svg>',
+};
+
+function renderPasskeys(user) {
+  const session = pk.getSession();
+  ui.passkeyList.replaceChildren();
+
+  if (!user.passkeys.length) {
+    ui.passkeyList.append(el('li', 'empty-state', 'No passkeys yet. Add one to keep signing in.'));
+    return;
+  }
+
+  const onlyOne = user.passkeys.length === 1;
+
+  for (const passkey of user.passkeys) {
+    const li = el('li', 'passkey');
+    li.dataset.id = passkey.id;
+    const isCurrent = session && session.credentialId === passkey.id;
+    if (isCurrent) li.classList.add('is-current');
+
+    const icon = el('div', 'passkey__icon');
+    icon.innerHTML = ICONS[pk.passkeyKind(passkey)] || ICONS.device;
+    icon.setAttribute('aria-hidden', 'true');
+
+    const body = el('div', 'passkey__body');
+    const nameRow = el('div', 'passkey__name');
+
+    if (state.editingPasskeyId === passkey.id) {
+      const form = el('form', 'rename-form');
+      const input = el('input');
+      input.type = 'text';
+      input.value = passkey.nickname;
+      input.maxLength = 60;
+      input.setAttribute('aria-label', 'Passkey name');
+      const save = el('button', 'btn btn--sm', 'Save');
+      save.type = 'submit';
+      const cancel = el('button', 'btn btn--ghost btn--sm', 'Cancel');
+      cancel.type = 'button';
+      cancel.addEventListener('click', () => { state.editingPasskeyId = null; render(); });
+      form.append(input, save, cancel);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          pk.renamePasskey(passkey.id, input.value);
+          state.editingPasskeyId = null;
+          toast('Passkey renamed', 'success');
+          render();
+        } catch (err) {
+          setStatus(ui.passkeysStatus, errorMessage(err), 'error');
+        }
+      });
+      nameRow.append(form);
+      setTimeout(() => { input.focus(); input.select(); }, 0);
+    } else {
+      nameRow.append(el('span', null, passkey.nickname));
+      if (isCurrent) nameRow.append(el('span', 'badge badge--accent', 'Used this session'));
+      if (passkey.backedUp) nameRow.append(el('span', 'badge badge--success', 'Synced'));
+      else if (!passkey.backupEligible) nameRow.append(el('span', 'badge', 'Device-bound'));
+      if (passkey.userVerified) nameRow.append(el('span', 'badge', 'Biometric / PIN'));
+    }
+
+    const meta = el('div', 'passkey__meta');
+    meta.append(el('span', null, pk.describeAuthenticator(passkey)));
+    meta.append(el('span', null, `Added ${pk.formatDate(passkey.createdAt)}`));
+    meta.append(el('span', null, `Last used ${pk.formatRelative(passkey.lastUsedAt)}`));
+    if (passkey.transports && passkey.transports.length) meta.append(el('span', null, passkey.transports.join(', ')));
+    meta.append(el('span', null, passkey.algorithmName));
+    body.append(nameRow, meta);
+
+    const actions = el('div', 'passkey__actions');
+    const renameBtn = el('button', 'btn btn--ghost btn--sm', 'Rename');
+    renameBtn.type = 'button';
+    renameBtn.addEventListener('click', () => { state.editingPasskeyId = passkey.id; render(); });
+    const removeBtn = el('button', 'btn btn--ghost btn--sm is-danger', 'Remove');
+    removeBtn.type = 'button';
+    if (onlyOne) {
+      removeBtn.disabled = true;
+      removeBtn.title = 'Add another passkey before removing this one, or you would be locked out.';
+    }
+    removeBtn.addEventListener('click', () => handleRemovePasskey(passkey));
+    actions.append(renameBtn, removeBtn);
+
+    li.append(icon, body, actions);
+    ui.passkeyList.append(li);
+  }
+}
+
+const ACTIVITY_LABELS = {
+  'register': 'Account created',
+  'sign-in': 'Signed in',
+  'sign-out': 'Signed out',
+  'reauth': 'Identity verified',
+  'passkey-added': 'Passkey added',
+  'passkey-removed': 'Passkey removed',
+  'passkey-renamed': 'Passkey renamed',
+  'profile-updated': 'Profile updated',
+  'warning': 'Security warning',
+};
+
+function renderActivity(user) {
+  ui.activityList.replaceChildren();
+  if (!user.activity.length) {
+    ui.activityList.append(el('li', 'empty-state', 'Nothing yet.'));
+    return;
+  }
+  for (const entry of user.activity.slice(0, 12)) {
+    const li = el('li');
+    const left = el('div');
+    left.append(el('strong', null, ACTIVITY_LABELS[entry.type] || entry.type));
+    left.append(el('div', null, entry.detail));
+    left.querySelector('div').style.color = 'var(--muted)';
+    const time = el('time', null, pk.formatRelative(entry.at));
+    time.dateTime = entry.at;
+    time.title = new Date(entry.at).toLocaleString();
+    li.append(left, time);
+    ui.activityList.append(li);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Conditional UI (passkey autofill)                                   */
+/* ------------------------------------------------------------------ */
+
+async function startConditionalUI() {
+  if (!state.caps || !state.caps.supported || !state.caps.conditionalMediation) return;
+  if (state.conditionalAbort || pk.getCurrentUser()) return;
+
+  const controller = new AbortController();
+  state.conditionalAbort = controller;
+  try {
+    const user = await pk.signIn({ conditional: true, signal: controller.signal });
+    toast(`Welcome back, ${user.name.split(' ')[0]}!`, 'success');
+    render();
+  } catch (err) {
+    if (controller.signal.aborted || err.name === 'AbortError') return;
+    const message = errorMessage(err);
+    if (message) setStatus(ui.signinStatus, message, 'error');
+    // Timeouts/expired challenges are routine for an idle page: start a new request.
+    const retryable = err.name === 'NotAllowedError' || (err instanceof pk.PasskeyError && err.code === 'challenge');
+    if (retryable && state.conditionalRestarts < 5) {
+      state.conditionalRestarts += 1;
+      setTimeout(() => { if (!pk.getCurrentUser()) startConditionalUI(); }, 300);
+    }
+  } finally {
+    if (state.conditionalAbort === controller) state.conditionalAbort = null;
+  }
+}
+
+function stopConditionalUI() {
+  if (state.conditionalAbort) {
+    state.conditionalAbort.abort();
+    state.conditionalAbort = null;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Handlers                                                            */
+/* ------------------------------------------------------------------ */
+
+ui.signinForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  setStatus(ui.signinStatus, '');
+  stopConditionalUI();
+  busy(ui.signinBtn, true);
+  try {
+    const user = await pk.signIn({ email: ui.signinEmail.value });
+    toast(`Welcome back, ${user.name.split(' ')[0]}!`, 'success');
+    ui.signinEmail.value = '';
+    render();
+  } catch (err) {
+    const message = errorMessage(err);
+    if (message) setStatus(ui.signinStatus, message, 'error');
+  } finally {
+    busy(ui.signinBtn, false);
+    if (!pk.getCurrentUser()) { state.conditionalRestarts = 0; startConditionalUI(); }
+  }
+});
+
+ui.registerForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  setStatus(ui.registerStatus, '');
+  stopConditionalUI();
+  busy(ui.registerBtn, true, 'Creating your passkey…');
+  try {
+    const user = await pk.register({ name: ui.registerName.value, email: ui.registerEmail.value });
+    ui.registerForm.reset();
+    toast(`Welcome to The Daily Grind, ${user.name.split(' ')[0]}! Your passkey is ready.`, 'success');
+    render();
+  } catch (err) {
+    const message = errorMessage(err);
+    if (message) setStatus(ui.registerStatus, message, 'error');
+  } finally {
+    busy(ui.registerBtn, false);
+    if (!pk.getCurrentUser()) { state.conditionalRestarts = 0; startConditionalUI(); }
+  }
+});
+
+ui.profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  setStatus(ui.profileStatus, '');
+  const current = pk.getCurrentUser();
+  if (!current) return;
+  const name = ui.profileName.value.trim();
+  const email = ui.profileEmail.value.trim();
+
+  if (name.length < 2) return setStatus(ui.profileStatus, 'Please enter your name.', 'error');
+  if (!pk.isValidEmail(email)) return setStatus(ui.profileStatus, 'Please enter a valid email address.', 'error');
+
+  const emailChanged = pk.normalizeEmail(email) !== pk.normalizeEmail(current.email);
+  if (emailChanged && !(await ensureFresh('change your email address'))) {
+    setStatus(ui.profileStatus, 'Email change cancelled — verification is required.', 'warning');
+    return;
+  }
+
+  busy(ui.profileSave, true, 'Saving…');
+  try {
+    const { changed } = await pk.updateProfile({ name, email });
+    setStatus(ui.profileStatus, changed ? 'Profile updated.' : 'No changes to save.', changed ? 'success' : 'info');
+    if (changed) toast('Profile updated', 'success');
+    render();
+  } catch (err) {
+    setStatus(ui.profileStatus, errorMessage(err), 'error');
+  } finally {
+    busy(ui.profileSave, false);
+  }
+});
+
+ui.profileReset.addEventListener('click', () => {
+  const user = pk.getCurrentUser();
+  if (!user) return;
+  ui.profileName.value = user.name;
+  ui.profileEmail.value = user.email;
+  setStatus(ui.profileStatus, '');
+});
+
+ui.reauthBtn.addEventListener('click', async () => {
+  setStatus(ui.securityStatus, '');
+  busy(ui.reauthBtn, true, 'Verifying…');
+  try {
+    await pk.reauthenticate();
+    toast('Identity verified', 'success');
+    render();
+  } catch (err) {
+    const message = errorMessage(err);
+    if (message) setStatus(ui.securityStatus, message, 'error');
+  } finally {
+    busy(ui.reauthBtn, false);
+  }
+});
+
+ui.signoutBtn.addEventListener('click', () => {
+  pk.signOut();
+  toast('You have been signed out.');
+  render();
+});
+
+ui.deleteAccountBtn.addEventListener('click', async () => {
+  setStatus(ui.securityStatus, '');
+  const ok = await confirmAction({
+    title: 'Delete your account?',
+    message: 'This permanently removes your profile, rewards balance and every passkey registered with The Daily Grind. Your passkey provider will be asked to clean up its copies too.',
+    confirmLabel: 'Delete account',
+  });
+  if (!ok) return;
+  if (!(await ensureFresh('delete your account'))) return;
+  try {
+    await pk.deleteAccount();
+    toast('Your account has been deleted. We’ll miss you!', 'success');
+    render();
+  } catch (err) {
+    setStatus(ui.securityStatus, errorMessage(err), 'error');
+  }
+});
+
+ui.addPasskeyBtn.addEventListener('click', async () => {
+  setStatus(ui.passkeysStatus, '');
+  if (!(await ensureFresh('add a new passkey'))) return;
+  ui.addPasskeyName.value = '';
+  setStatus(ui.addPasskeyStatus, '');
+  openDialog(ui.addPasskeyDialog);
+  setTimeout(() => ui.addPasskeyName.focus(), 0);
+});
+
+ui.addPasskeyForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  setStatus(ui.addPasskeyStatus, '');
+  busy(ui.addPasskeyConfirm, true, 'Creating…');
+  try {
+    const passkey = await pk.addPasskey({ nickname: ui.addPasskeyName.value });
+    ui.addPasskeyDialog.close('ok');
+    toast(`Passkey “${passkey.nickname}” added`, 'success');
+    render();
+  } catch (err) {
+    if (err instanceof pk.PasskeyError && err.code === 'reauth-required') {
+      ui.addPasskeyDialog.close('cancel');
+      setStatus(ui.passkeysStatus, err.message, 'warning');
+    } else {
+      setStatus(ui.addPasskeyStatus, errorMessage(err), 'error');
+    }
+  } finally {
+    busy(ui.addPasskeyConfirm, false);
+  }
+});
+
+async function handleRemovePasskey(passkey) {
+  setStatus(ui.passkeysStatus, '');
+  const ok = await confirmAction({
+    title: `Remove “${passkey.nickname}”?`,
+    message: 'You will no longer be able to sign in with this passkey. You may also want to delete it from your device or password manager.',
+    confirmLabel: 'Remove passkey',
+  });
+  if (!ok) return;
+  if (!(await ensureFresh('remove a passkey'))) return;
+  try {
+    await pk.removePasskey(passkey.id);
+    toast(`Passkey “${passkey.nickname}” removed`, 'success');
+    render();
+  } catch (err) {
+    setStatus(ui.passkeysStatus, errorMessage(err), 'error');
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Boot                                                                */
+/* ------------------------------------------------------------------ */
+
+async function init() {
+  state.caps = await pk.getCapabilities();
+  renderSupport(state.caps);
+
+  if (!state.caps.supported) {
+    ui.unsupported.hidden = false;
+    ui.unsupported.textContent = state.caps.secureContext
+      ? 'This browser does not support passkeys (WebAuthn). Please use a current version of Chrome, Edge, Safari or Firefox.'
+      : 'Passkeys only work over HTTPS or on localhost. Please open this page from a secure origin.';
+    for (const btn of [ui.signinBtn, ui.registerBtn, ui.addPasskeyBtn, ui.reauthBtn]) btn.disabled = true;
+  }
+
+  pk.onChange(render);
+  render();
+
+  // Keep "verified N minutes ago" and relative times ticking.
+  state.freshnessTimer = setInterval(() => {
+    if (pk.getCurrentUser()) {
+      renderFreshness();
+      const user = pk.getCurrentUser();
+      if (user) renderActivity(user);
+    }
+  }, 30000);
+
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') render();
+  });
+}
+
+init().catch((err) => {
+  console.error(err);
+  ui.unsupported.hidden = false;
+  ui.unsupported.textContent = `Could not initialise the account page: ${err.message}`;
+});
