+
+.security-row:last-child {
+  border-bottom: 0;
+}
+
+.security-row .title {
+  font-weight: 600;
+  color: var(--primary-dark);
+}
+
+.security-row .desc {
+  font-size: 0.82rem;
+  color: var(--muted);
+}
+
+.security-row .btn {
+  margin-top: 0;
+}
+
+.freshness {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.82rem;
+}
+
+.freshness .dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: #bbb;
+}
+
+.freshness.is-fresh .dot {
+  background: var(--success);
+}
+
+.freshness.is-stale .dot {
+  background: var(--accent-dark);
+}
+
+/* Activity */
+.activity {
+  list-style: none;
+  font-size: 0.86rem;
+}
+
+.activity li {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 8px 0;
+  border-bottom: 1px solid var(--border);
+}
+
+.activity li:last-child {
+  border-bottom: 0;
+}
+
+.activity time {
+  color: var(--muted);
+  white-space: nowrap;
+  font-size: 0.78rem;
+}
+
+/* Dialogs */
+dialog {
+  border: 0;
+  border-radius: var(--radius);
+  padding: 0;
+  max-width: 440px;
+  width: calc(100% - 32px);
+  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+}
+
+dialog::backdrop {
+  background: rgba(62, 39, 35, 0.55);
+}
+
+.dialog__body {
+  padding: 24px;
+}
+
+.dialog__body h3 {
+  color: var(--primary);
+  margin-bottom: 8px;
+  font-size: 1.15rem;
+}
+
+.dialog__body p {
+  font-size: 0.92rem;
+  color: var(--muted);
+  margin-bottom: 14px;
+}
+
+.dialog__actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 18px;
+  flex-wrap: wrap;
+}
+
+.dialog__actions .btn {
+  margin-top: 0;
+}
+
+.dialog__icon {
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  background: var(--info-bg);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 14px;
+  color: var(--primary);
+}
+
+.dialog__icon svg {
+  width: 28px;
+  height: 28px;
+}
+
+/* Toasts */
+.toast-region {
+  position: fixed;
+  bottom: 20px;
+  right: 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  z-index: 2000;
+  max-width: min(360px, calc(100vw - 40px));
+}
+
+.toast {
+  background: var(--primary-dark);
+  color: white;
+  padding: 12px 16px;
+  border-radius: 6px;
+  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
+  font-size: 0.9rem;
+  border-left: 4px solid var(--accent);
+  animation: toast-in 0.25s ease-out;
+}
+
+.toast--error {
+  border-left-color: #ff6f60;
+}
+
+.toast--success {
+  border-left-color: #81c784;
+}
+
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+@media (max-width: 600px) {
+  .passkey {
+    grid-template-columns: auto 1fr;
+  }
+
+  .passkey__actions {
+    grid-column: 1 / -1;
+    justify-content: flex-start;
+  }
+
+  .hero h1 {
+    font-size: 2.2rem;
+  }
+}
