+
+/* Change notifications so the nav + page can re-render */
+const listeners = new Set();
+function notify() { for (const fn of listeners) { try { fn(); } catch { /* ignore */ } } }
+export function onChange(fn) { listeners.add(fn); return () => listeners.delete(fn); }
+window.addEventListener('storage', (e) => { if (e.key === DB_KEY || e.key === SESSION_KEY) notify(); });
+
+/* ------------------------------------------------------------------ */
+/* Challenge store (what a server would keep in the session)           */
+/* ------------------------------------------------------------------ */
+
+const pendingChallenges = new Map();
+
+function issueChallenge(type, meta = {}, ttl = CHALLENGE_TTL_MS) {
+  const bytes = randomBytes(32);
+  const key = b64u.encode(bytes);
+  pendingChallenges.set(key, { type, ...meta, key, expires: Date.now() + ttl });
+  return { bytes, key };
+}
+
+function consumeChallenge(key, type) {
+  const entry = pendingChallenges.get(key);
+  pendingChallenges.delete(key);
+  if (!entry) throw new PasskeyError('Unknown challenge. Please try again.', 'challenge');
+  if (entry.type !== type) throw new PasskeyError('Challenge was issued for a different ceremony.', 'challenge');
+  if (entry.expires < Date.now()) throw new PasskeyError('That request expired. Please try again.', 'challenge');
+  return entry;
+}
+
+/* ------------------------------------------------------------------ */
+/* Errors                                                              */
+/* ------------------------------------------------------------------ */
+
+export class PasskeyError extends Error {
+  constructor(message, code = 'error', cause) {
+    super(message);
+    this.name = 'PasskeyError';
+    this.code = code;
+    if (cause) this.cause = cause;
+  }
+}
+
+/** Translate DOMExceptions from navigator.credentials into friendly messages. */
+export function describeError(err) {
+  if (!err) return 'Something went wrong.';
+  if (err instanceof PasskeyError) return err.message;
+  switch (err.name) {
+    case 'AbortError':
+      return '';
+    case 'NotAllowedError':
+      return 'The passkey request was cancelled or timed out. Please try again.';
+    case 'InvalidStateError':
+      return 'This device already has a passkey for your account. Try signing in instead, or use a different device.';
+    case 'SecurityError':
+      return 'Passkeys need a secure context (HTTPS or localhost) and a matching domain.';
+    case 'NotSupportedError':
+      return 'Your browser or authenticator does not support the requested passkey options.';
+    case 'ConstraintError':
+      return 'Your authenticator could not satisfy the requested requirements (e.g. user verification).';
+    default:
+      return err.message || 'Something went wrong.';
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Capability detection                                                */
+/* ------------------------------------------------------------------ */
+
+export function isSupported() {
+  return typeof window !== 'undefined' && !!window.PublicKeyCredential && !!navigator.credentials && window.isSecureContext;
+}
+
+export async function getCapabilities() {
+  const caps = {
+    supported: isSupported(),
+    secureContext: window.isSecureContext,
+    platformAuthenticator: false,
+    conditionalMediation: false,
+    signalApi: typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+    relatedOrigins: false,
+    hybridTransport: false,
+  };
+  if (!caps.supported) return caps;
+  try { caps.platformAuthenticator = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable(); } catch { /* ignore */ }
+  try {
+    if (PublicKeyCredential.isConditionalMediationAvailable) {
+      caps.conditionalMediation = await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch { /* ignore */ }
+  try {
+    if (PublicKeyCredential.getClientCapabilities) {
+      const c = await PublicKeyCredential.getClientCapabilities();
+      caps.conditionalMediation = caps.conditionalMediation || !!c.conditionalGet;
+      caps.platformAuthenticator = caps.platformAuthenticator || !!c.userVerifyingPlatformAuthenticator;
+      caps.hybridTransport = !!c.hybridTransport;
+      caps.relatedOrigins = !!c.relatedOrigins;
+      caps.signalApi = caps.signalApi || !!c.signalAllAcceptedCredentials;
+    }
+  } catch { /* ignore */ }
+  return caps;
+}
+
+/* ------------------------------------------------------------------ */
+/* Session / current user                                              */
+/* ------------------------------------------------------------------ */
+
+export function getSession() {
+  const session = loadSession();
+  if (!session) return null;
+  const db = loadDb();
+  if (!db.users[session.userId]) { saveSession(null); return null; }
+  return session;
+}
+
+export function getCurrentUser() {
+  const session = getSession();
+  if (!session) return null;
+  return publicUser(loadDb().users[session.userId]);
+}
+
+function publicUser(user) {
+  if (!user) return null;
+  return {
+    id: user.id,
+    email: user.email,
+    name: user.name,
+    createdAt: user.createdAt,
+    updatedAt: user.updatedAt,
+    rewardsPoints: user.rewardsPoints || 0,
+    passkeys: user.passkeys.map(publicPasskey),
+    activity: user.activity || [],
+  };
+}
+
+function publicPasskey(p) {
+  // Never hand the UI the key material it does not need.
+  const { publicKeyJwk, ...rest } = p;
+  return { ...rest, algorithmName: rest.alg === -7 ? 'ES256' : rest.alg === -257 ? 'RS256' : String(rest.alg) };
+}
+
+export function isRecentlyVerified() {
+  const session = getSession();
+  return !!session && Date.now() - session.lastVerifiedAt < REAUTH_WINDOW_MS;
+}
+
+export function verificationAgeMs() {
+  const session = getSession();
+  return session ? Date.now() - session.lastVerifiedAt : Infinity;
+}
+
+export const reauthWindowMs = REAUTH_WINDOW_MS;
+
+export function signOut() {
+  const session = loadSession();
+  if (session) {
+    const db = loadDb();
+    const user = db.users[session.userId];
+    if (user) { logActivity(user, 'sign-out', 'Signed out'); saveDb(db); }
+  }
+  saveSession(null);
+}
+
+function requireUser() {
+  const session = getSession();
+  if (!session) throw new PasskeyError('You need to be signed in to do that.', 'unauthenticated');
+  const db = loadDb();
+  const user = db.users[session.userId];
+  if (!user) throw new PasskeyError('Account not found.', 'unauthenticated');
+  return { db, user, session };
+}
+
+function requireFresh(session) {
+  if (Date.now() - session.lastVerifiedAt >= REAUTH_WINDOW_MS) {
+    throw new PasskeyError('Please verify it is you before making this change.', 'reauth-required');
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Registration                                                        */
+/* ------------------------------------------------------------------ */
+
+function buildCreationOptions({ user, excludeIds, challenge }) {
+  return {
+    publicKey: {
+      rp: { name: RP_NAME, id: RP_ID },
+      user: {
+        id: b64u.decode(user.id),
+        name: user.email,
+        displayName: user.name,
+      },
+      challenge,
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -7 },   // ES256
+        { type: 'public-key', alg: -257 }, // RS256
+      ],
+      timeout: CHALLENGE_TTL_MS,
+      excludeCredentials: excludeIds.map((id) => ({ type: 'public-key', id: b64u.decode(id) })),
+      authenticatorSelection: {
+        residentKey: 'required',          // discoverable, so sign-in works without typing an email
+        requireResidentKey: true,
+        userVerification: 'preferred',
+      },
+      attestation: 'none',
+      extensions: { credProps: true },
+    },
+  };
+}
+
+/** Parse + verify a navigator.credentials.create() result. Returns a passkey record. */
+async function verifyRegistration(credential, { challengeKey, expectedType }) {
+  if (!credential || credential.type !== 'public-key') throw new PasskeyError('Unexpected credential type.');
+  const response = credential.response;
+
+  const clientData = parseClientData(response.clientDataJSON);
+  if (clientData.type !== 'webauthn.create') throw new PasskeyError('Unexpected ceremony type.');
+  if (clientData.origin !== ORIGIN) throw new PasskeyError(`Origin mismatch (${clientData.origin}).`);
+  const challenge = consumeChallenge(clientData.challenge, expectedType);
+  if (challenge.key !== challengeKey) throw new PasskeyError('Challenge mismatch.');
+
+  const { value: attestation } = cborDecode(new Uint8Array(response.attestationObject));
+  const authData = parseAuthenticatorData(attestation.get('authData'));
+  if (!bytesEqual(authData.rpIdHash, await sha256(new TextEncoder().encode(RP_ID)))) {
+    throw new PasskeyError('Relying party ID mismatch.');
+  }
+  if (!authData.flags.userPresent) throw new PasskeyError('User presence was not confirmed.');
+  if (!authData.flags.attestedCredentialData) throw new PasskeyError('Attested credential data missing.');
+
+  const credentialId = b64u.encode(authData.credentialId);
+  if (credentialId !== credential.id) throw new PasskeyError('Credential ID mismatch.');
+
+  const alg = typeof response.getPublicKeyAlgorithm === 'function' ? response.getPublicKeyAlgorithm() : authData.cosePublicKey.get(3);
+  const jwk = coseToJwk(authData.cosePublicKey);
+  const transports = typeof response.getTransports === 'function' ? response.getTransports() : [];
+  const ext = typeof credential.getClientExtensionResults === 'function' ? credential.getClientExtensionResults() : {};
+
+  return {
+    id: credentialId,
+    publicKeyJwk: jwk,
+    alg,
+    counter: authData.counter,
+    transports,
+    aaguid: authData.aaguid,
+    attestationFormat: attestation.get('fmt'),
+    discoverable: ext?.credProps?.rk ?? true,
+    userVerified: authData.flags.userVerified,
+    backupEligible: authData.flags.backupEligible,
+    backedUp: authData.flags.backedUp,
+    authenticatorAttachment: credential.authenticatorAttachment || null,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+}
+
+/** Create a new customer account secured by a brand-new passkey. */
+export async function register({ email, name }) {
+  if (!isSupported()) throw new PasskeyError('Passkeys are not supported in this browser.', 'unsupported');
+  const cleanEmail = String(email || '').trim();
+  const cleanName = String(name || '').trim();
+  if (!isValidEmail(cleanEmail)) throw new PasskeyError('Please enter a valid email address.', 'validation');
+  if (cleanName.length < 2) throw new PasskeyError('Please tell us your name.', 'validation');
+
+  let db = loadDb();
+  if (findUserByEmail(db, cleanEmail)) {
+    throw new PasskeyError('An account with that email already exists. Try signing in with your passkey.', 'exists');
+  }
+
+  const user = {
+    id: b64u.encode(randomBytes(16)),
+    email: cleanEmail,
+    name: cleanName,
+    createdAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+    rewardsPoints: 50, // welcome bonus
+    passkeys: [],
+    activity: [],
+  };
+
+  const { bytes, key } = issueChallenge('register', { userId: user.id });
+  const options = buildCreationOptions({ user, excludeIds: [], challenge: bytes });
+  const credential = await navigator.credentials.create(options);
+  const passkey = await verifyRegistration(credential, { challengeKey: key, expectedType: 'register' });
+
+  // Re-read in case another tab registered while the prompt was open.
+  db = loadDb();
+  if (findUserByEmail(db, cleanEmail)) throw new PasskeyError('That email was just registered elsewhere.', 'exists');
+  passkey.nickname = defaultNickname(passkey);
+  passkey.lastUsedAt = new Date().toISOString();
+  user.passkeys.push(passkey);
+  logActivity(user, 'register', `Account created with passkey “${passkey.nickname}”`);
+  db.users[user.id] = user;
+  saveDb(db);
+
+  saveSession({ userId: user.id, credentialId: passkey.id, signedInAt: Date.now(), lastVerifiedAt: Date.now() });
+  return publicUser(user);
+}
+
+/** Add another passkey to the signed-in account (requires fresh verification). */
+export async function addPasskey({ nickname } = {}) {
+  if (!isSupported()) throw new PasskeyError('Passkeys are not supported in this browser.', 'unsupported');
+  const { user, session } = requireUser();
+  requireFresh(session);
+
+  const { bytes, key } = issueChallenge('add-passkey', { userId: user.id });
+  const options = buildCreationOptions({ user, excludeIds: user.passkeys.map((p) => p.id), challenge: bytes });
+  const credential = await navigator.credentials.create(options);
+  const passkey = await verifyRegistration(credential, { challengeKey: key, expectedType: 'add-passkey' });
+
+  const db = loadDb();
+  const fresh = db.users[user.id];
+  if (!fresh) throw new PasskeyError('Account not found.', 'unauthenticated');
+  if (findByCredentialId(db, passkey.id)) throw new PasskeyError('That passkey is already registered.', 'exists');
+  passkey.nickname = String(nickname || '').trim().slice(0, 60) || defaultNickname(passkey, fresh.passkeys);
+  fresh.passkeys.push(passkey);
+  logActivity(fresh, 'passkey-added', `Added passkey “${passkey.nickname}”`);
+  saveDb(db);
+  await signalAcceptedCredentials(fresh);
+  return publicPasskey(passkey);
+}
+
+/* ------------------------------------------------------------------ */
+/* Authentication                                                      */
+/* ------------------------------------------------------------------ */
+
+function buildRequestOptions({ challenge, allowIds = [], userVerification = 'preferred', mediation, signal }) {
+  const opts = {
+    publicKey: {
+      rpId: RP_ID,
+      challenge,
+      timeout: mediation === 'conditional' ? CONDITIONAL_TTL_MS : CHALLENGE_TTL_MS,
+      userVerification,
+      allowCredentials: allowIds.map((id) => ({ type: 'public-key', id: b64u.decode(id) })),
+    },
+  };
+  if (mediation) opts.mediation = mediation;
+  if (signal) opts.signal = signal;
+  return opts;
+}
+
+/** Parse + verify a navigator.credentials.get() result against the stored passkey. */
+async function verifyAssertion(credential, { expectedType, requireUV, expectedUserId }) {
+  if (!credential || credential.type !== 'public-key') throw new PasskeyError('Unexpected credential type.');
+  const response = credential.response;
+
+  const clientData = parseClientData(response.clientDataJSON);
+  if (clientData.type !== 'webauthn.get') throw new PasskeyError('Unexpected ceremony type.');
+  if (clientData.origin !== ORIGIN) throw new PasskeyError(`Origin mismatch (${clientData.origin}).`);
+  consumeChallenge(clientData.challenge, expectedType);
+
+  const db = loadDb();
+  const match = findByCredentialId(db, credential.id);
+  if (!match) {
+    // Tell the credential provider this passkey is stale so it can offer to remove it.
+    await signalUnknownCredential(credential.id);
+    throw new PasskeyError('That passkey is not registered with The Daily Grind. It may have been removed from your account.', 'unknown-credential');
+  }
+  const { user, passkey } = match;
+
+  if (expectedUserId && user.id !== expectedUserId) {
+    throw new PasskeyError('That passkey belongs to a different account.', 'wrong-user');
+  }
+  if (response.userHandle) {
+    const handle = b64u.encode(new Uint8Array(response.userHandle));
+    if (handle !== user.id) throw new PasskeyError('User handle does not match this passkey.', 'wrong-user');
+  }
+
+  const authenticatorData = new Uint8Array(response.authenticatorData);
+  const authData = parseAuthenticatorData(authenticatorData);
+  if (!bytesEqual(authData.rpIdHash, await sha256(new TextEncoder().encode(RP_ID)))) {
+    throw new PasskeyError('Relying party ID mismatch.');
+  }
+  if (!authData.flags.userPresent) throw new PasskeyError('User presence was not confirmed.');
+  if (requireUV && !authData.flags.userVerified) {
+    throw new PasskeyError('User verification (biometric, PIN or device unlock) is required for this action.', 'uv-required');
+  }
+
+  const ok = await verifySignature({
+    jwk: passkey.publicKeyJwk,
+    alg: passkey.alg,
+    authenticatorData,
+    clientDataJSON: new Uint8Array(response.clientDataJSON),
+    signature: new Uint8Array(response.signature),
+  });
+  if (!ok) throw new PasskeyError('Signature verification failed.', 'bad-signature');
+
+  // Signature counter: authenticators that use one must always increase it.
+  if ((authData.counter !== 0 || passkey.counter !== 0) && authData.counter <= passkey.counter) {
+    logActivity(user, 'warning', `Possible cloned authenticator detected for “${passkey.nickname}”`);
+    saveDb(db);
+    throw new PasskeyError('This passkey returned an unexpected signature counter and was rejected.', 'counter');
+  }
+
+  passkey.counter = authData.counter;
+  passkey.lastUsedAt = new Date().toISOString();
+  passkey.backedUp = authData.flags.backedUp;
+  passkey.backupEligible = authData.flags.backupEligible;
+  passkey.userVerified = authData.flags.userVerified;
+  if (credential.authenticatorAttachment) passkey.authenticatorAttachment = credential.authenticatorAttachment;
+
+  return { db, user, passkey, userVerified: authData.flags.userVerified };
+}
+
+/**
+ * Sign in with a discoverable passkey.
+ * Pass { conditional: true, signal } to run as an autofill (conditional UI) request.
+ */
+export async function signIn({ conditional = false, signal, email } = {}) {
+  if (!isSupported()) throw new PasskeyError('Passkeys are not supported in this browser.', 'unsupported');
+
+  // If the customer typed an email, narrow the request to that account's passkeys
+  // (helps non-discoverable credentials and gives a clearer "no account" message).
+  let allowIds = [];
+  let expectedUserId;
+  if (email && String(email).trim()) {
+    if (!isValidEmail(email)) throw new PasskeyError('Please enter a valid email address, or leave it blank to pick a passkey.', 'validation');
+    const known = findUserByEmail(loadDb(), email);
+    if (!known) throw new PasskeyError('We couldn’t find an account for that email. Create one below, or leave the field blank to choose a saved passkey.', 'no-account');
+    allowIds = known.passkeys.map((p) => p.id);
+    expectedUserId = known.id;
+  }
+
+  const { bytes } = issueChallenge('sign-in', {}, conditional ? CONDITIONAL_TTL_MS : CHALLENGE_TTL_MS);
+  const options = buildRequestOptions({ challenge: bytes, allowIds, mediation: conditional ? 'conditional' : undefined, signal });
+  const credential = await navigator.credentials.get(options);
+  const { db, user, passkey, userVerified } = await verifyAssertion(credential, { expectedType: 'sign-in', expectedUserId });
+
+  logActivity(user, 'sign-in', `Signed in with passkey “${passkey.nickname}”${conditional ? ' (autofill)' : ''}`);
+  saveDb(db);
+  const now = Date.now();
+  saveSession({ userId: user.id, credentialId: passkey.id, signedInAt: now, lastVerifiedAt: userVerified ? now : 0 });
+  await signalAcceptedCredentials(user);
+  return publicUser(user);
+}
+
+/** Re-prove possession of one of the signed-in user's passkeys (with user verification). */
+export async function reauthenticate() {
+  if (!isSupported()) throw new PasskeyError('Passkeys are not supported in this browser.', 'unsupported');
+  const { user, session } = requireUser();
+  const { bytes } = issueChallenge('reauth', { userId: user.id });
+  const options = buildRequestOptions({
+    challenge: bytes,
+    allowIds: user.passkeys.map((p) => p.id),
+    userVerification: 'required',
+  });
+  const credential = await navigator.credentials.get(options);
+  const { db, user: fresh, passkey } = await verifyAssertion(credential, {
+    expectedType: 'reauth',
+    requireUV: true,
+    expectedUserId: user.id,
+  });
+  logActivity(fresh, 'reauth', `Verified identity with passkey “${passkey.nickname}”`);
+  saveDb(db);
+  saveSession({ ...session, credentialId: passkey.id, lastVerifiedAt: Date.now() });
+  return publicUser(fresh);
+}
+
+/* ------------------------------------------------------------------ */
+/* Passkey management                                                  */
+/* ------------------------------------------------------------------ */
+
+export function listPasskeys() {
+  const { user } = requireUser();
+  return user.passkeys.map(publicPasskey);
+}
+
+export function renamePasskey(credentialId, nickname) {
+  const { db, user } = requireUser();
+  const passkey = user.passkeys.find((p) => p.id === credentialId);
+  if (!passkey) throw new PasskeyError('Passkey not found.', 'not-found');
+  const clean = String(nickname || '').trim().slice(0, 60);
+  if (!clean) throw new PasskeyError('Please enter a name for this passkey.', 'validation');
+  const previous = passkey.nickname;
+  passkey.nickname = clean;
+  logActivity(user, 'passkey-renamed', `Renamed passkey “${previous}” to “${clean}”`);
+  saveDb(db);
+  notify();
+  return publicPasskey(passkey);
+}
+
+export async function removePasskey(credentialId) {
+  const { db, user, session } = requireUser();
+  requireFresh(session);
+  const index = user.passkeys.findIndex((p) => p.id === credentialId);
+  if (index === -1) throw new PasskeyError('Passkey not found.', 'not-found');
+  if (user.passkeys.length === 1) {
+    throw new PasskeyError('You cannot remove your only passkey — you would be locked out. Add another passkey first, or delete your account.', 'last-passkey');
+  }
+  const [removed] = user.passkeys.splice(index, 1);
+  logActivity(user, 'passkey-removed', `Removed passkey “${removed.nickname}”`);
+  saveDb(db);
+  notify();
+  await signalAcceptedCredentials(user);
+  return publicPasskey(removed);
+}
+
+/* ------------------------------------------------------------------ */
+/* Profile                                                             */
+/* ------------------------------------------------------------------ */
+
+export async function updateProfile({ name, email }) {
+  const { db, user, session } = requireUser();
+  const cleanName = String(name ?? user.name).trim();
+  const cleanEmail = String(email ?? user.email).trim();
+  if (cleanName.length < 2) throw new PasskeyError('Please enter your name.', 'validation');
+  if (!isValidEmail(cleanEmail)) throw new PasskeyError('Please enter a valid email address.', 'validation');
+
+  const emailChanged = normalizeEmail(cleanEmail) !== normalizeEmail(user.email);
+  const nameChanged = cleanName !== user.name;
+  if (!emailChanged && !nameChanged) return { user: publicUser(user), changed: false };
+
+  if (emailChanged) {
+    requireFresh(session); // changing the sign-in identifier is sensitive
+    const other = findUserByEmail(db, cleanEmail);
+    if (other && other.id !== user.id) throw new PasskeyError('That email is already in use by another account.', 'exists');
+  }
+
+  const changes = [];
+  if (nameChanged) { changes.push(`name → ${cleanName}`); user.name = cleanName; }
+  if (emailChanged) { changes.push(`email → ${cleanEmail}`); user.email = cleanEmail; }
+  user.updatedAt = new Date().toISOString();
+  logActivity(user, 'profile-updated', `Updated profile (${changes.join(', ')})`);
+  saveDb(db);
+  notify();
+
+  // Keep the names shown in the passkey provider's UI in sync with the account.
+  await signalCurrentUserDetails(user);
+  return { user: publicUser(user), changed: true };
+}
+
+export async function deleteAccount() {
+  const { db, user, session } = requireUser();
+  requireFresh(session);
+  delete db.users[user.id];
+  saveDb(db);
+  saveSession(null);
+  // All credentials are now unknown; let providers clean up their copies.
+  try {
+    if (PublicKeyCredential.signalAllAcceptedCredentials) {
+      await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: RP_ID, userId: user.id, allAcceptedCredentialIds: [] });
+    }
+  } catch { /* best-effort */ }
+}
+
+/* ------------------------------------------------------------------ */
+/* WebAuthn Signal API (best effort; silently ignored if unsupported)  */
+/* ------------------------------------------------------------------ */
+
+async function signalAcceptedCredentials(user) {
+  try {
+    if (PublicKeyCredential.signalAllAcceptedCredentials) {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: RP_ID,
+        userId: user.id,
+        allAcceptedCredentialIds: user.passkeys.map((p) => p.id),
+      });
+    }
+  } catch { /* best-effort */ }
+}
+
+async function signalUnknownCredential(credentialId) {
+  try {
+    if (PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({ rpId: RP_ID, credentialId });
+    }
+  } catch { /* best-effort */ }
+}
+
+async function signalCurrentUserDetails(user) {
+  try {
+    if (PublicKeyCredential.signalCurrentUserDetails) {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId: RP_ID,
+        userId: user.id,
+        name: user.email,
+        displayName: user.name,
+      });
+    }
+  } catch { /* best-effort */ }
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticator metadata (friendly names for well-known AAGUIDs)      */
+/* ------------------------------------------------------------------ */
+
+const AAGUIDS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  '891494da-2c90-4d31-a9cd-4eab0aed1309': 'Sésame',
+  'bfc748bb-3429-4faa-b9f9-7cfa9f3b76d0': 'iPasswords',
+  'b35a26b2-8f6e-4697-ab1d-d44db4da28c6': 'Zoho Vault',
+  '39a5647e-1b86-4e66-ba10-f0fc5bf7a5a5': 'IDmelon',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey 5',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey 5 NFC',
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': 'YubiKey 5 NFC',
+  'c5ef55ff-ad9a-4b9f-b580-adebafe026d0': 'YubiKey 5Ci',
+  '73bb0cd4-e502-49b8-9c6f-b59445bf720b': 'YubiKey 5 FIPS',
+  'd8522d9f-575b-4866-88a9-ba99fa02f35b': 'YubiKey Bio',
+};
+
+export function describeAuthenticator(passkey) {
+  const known = passkey.aaguid && AAGUIDS[passkey.aaguid];
+  if (known) return known;
+  const transports = passkey.transports || [];
+  if (transports.includes('usb') || transports.includes('nfc') || transports.includes('ble')) return 'Security key';
+  if (transports.includes('hybrid')) return 'Phone or tablet';
+  if (passkey.authenticatorAttachment === 'platform' || transports.includes('internal')) {
+    return passkey.backupEligible ? 'Synced passkey' : 'This device';
+  }
+  return 'Passkey provider';
+}
+
+export function passkeyKind(passkey) {
+  const transports = passkey.transports || [];
+  if (transports.includes('usb') || transports.includes('nfc') || transports.includes('ble')) return 'security-key';
+  if (transports.includes('hybrid') && !transports.includes('internal')) return 'phone';
+  if (passkey.backupEligible) return 'synced';
+  return 'device';
+}
+
+function defaultNickname(passkey, existing = []) {
+  const base = describeAuthenticator(passkey);
+  const taken = new Set(existing.map((p) => p.nickname));
+  if (!taken.has(base)) return base;
+  let n = 2;
+  while (taken.has(`${base} (${n})`)) n += 1;
+  return `${base} (${n})`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Formatting helpers for the UI                                       */
+/* ------------------------------------------------------------------ */
+
+export function formatRelative(iso) {
+  if (!iso) return 'never';
+  const then = typeof iso === 'number' ? iso : Date.parse(iso);
+  const diff = Date.now() - then;
+  const abs = Math.abs(diff);
+  const units = [
+    ['year', 365 * 24 * 3600e3],
+    ['month', 30 * 24 * 3600e3],
+    ['week', 7 * 24 * 3600e3],
+    ['day', 24 * 3600e3],
+    ['hour', 3600e3],
+    ['minute', 60e3],
+  ];
+  if (abs < 45e3) return 'just now';
+  const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+  for (const [unit, ms] of units) {
+    if (abs >= ms) return rtf.format(-Math.round(diff / ms), unit);
+  }
+  return 'just now';
+}
+
+export function formatDate(iso) {
+  if (!iso) return '—';
+  return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
